    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小扁豆与大米分别淘洗干净，扁豆提前用清水浸泡二十分钟后沥干。",
      "time_min": 22,
      "heat": "无火",
      "tip": "扁豆提前浸泡二十分钟，煮得更快也更容易煮稠。",
      "visual_cue": "豆子略微膨胀，水微微发浑"
    },
    {
      "n": 2,
      "text": "洋葱切成小丁，胡萝卜切成细丁，番茄切块，全部装盘备用。",
      "time_min": 9,
      "heat": "无火",
      "tip": "胡萝卜切小一点，煮软后汤才顺滑。",
      "visual_cue": "各料切好分装，丁块均匀"
    },
    {
      "n": 3,
      "text": "汤锅放黄油小火化开，下洋葱丁炒五分钟至软塌微黄。",
      "time_min": 6,
      "heat": "小火",
      "tip": "黄油别烧到变色，小火化开炒香即可。",
      "visual_cue": "洋葱软塌透明，黄油香气浓"
    },
    {
      "n": 4,
      "text": "加番茄膏和红椒粉小火炒两分钟，炒到油色变红。",
      "time_min": 3,
      "heat": "小火",
      "tip": "番茄膏一定要炒出红油，汤色才亮。",
      "visual_cue": "锅底油色橘红，闻到焦甜香"
    },
    {
      "n": 5,
      "text": "下番茄块炒三分钟出汁，再倒入小扁豆、大米、胡萝卜和清水。",
      "time_min": 5,
      "heat": "中火",
      "tip": "水一次加足，中途加水汤会变稀薄。",
      "visual_cue": "汤面翻起红泡，豆子沉在锅底"
    },
    {
      "n": 6,
      "text": "大火烧开转小火煮三十五分钟，煮到扁豆完全开花、米粒软烂。",
      "time_min": 40,
      "heat": "小火",
      "tip": "小火慢煮到豆子开花，汤自然就稠了。",
      "visual_cue": "豆子散开成糊，汤体浓稠"
    },
    {
      "n": 7,
      "text": "用搅拌机打成顺滑的浓汤，倒回锅里加盐调味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "分两次打，热汤一次打太多容易溢出。",
      "visual_cue": "汤体细腻无颗粒，呈橙红色"
    },
    {
      "n": 8,
      "text": "小火加热至微沸，撒薄荷碎，挤入柠檬汁搅匀后盛碗。",
      "time_min": 5,
      "heat": "小火",
      "tip": "薄荷和柠檬最后放，香气才清亮不闷。",
      "visual_cue": "汤面浮着绿色薄荷，酸香扑鼻"
    }
  ],
  "tips": [
    "扁豆提前浸泡二十分钟，煮得更快汤也更容易稠。",
    "番茄膏必须炒出红油，汤色才有那种亮橘红。",
    "煮到豆子开花再打糊，汤体自然浓稠不用勾芡。",
    "薄荷和柠檬都最后放，香气保留最完整。"
  ],
  "common_mistakes": [
    "扁豆不泡直接煮，四十分钟还有硬芯。",
    "番茄膏没炒透就加水，汤色发暗还有生酱味。",
    "大火滚煮，汤溅得到处都是还糊底。",
    "柠檬早放一起煮，酸味变得闷钝不清爽。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "30克:30毫升",
      "note": "口感更清爽，奶香减弱。"
    },
    {
      "original": "小扁豆",
      "substitute": "红腰豆",
      "ratio": "180克:180克",
      "note": "需多煮十五分钟至软烂。"
    }
  ],
  "variations": [
    "喜欢更辣的可以在炒番茄膏时加一勺辣椒粉。",
    "出锅前撒一把干薄荷碎，清凉香气更明显。",
    "配几块烤面包丁同吃，口感更有层次。"
  ],
  "serving_suggestion": "盛进汤碗，配一角柠檬和两张烤饼，饭前喝一碗，酸香开胃又暖胃。",
  "storage": "冷藏可放三天，复热须小火加热并不断搅动，防止糊底。",
