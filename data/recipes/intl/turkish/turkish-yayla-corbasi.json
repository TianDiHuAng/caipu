  "equipment": [
    "锅",
    "打蛋器",
    "碗",
    "木勺",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米洗净，用清水泡十分钟。，全程留意火候，别贪快。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡过更容易煮开花。，火大了就离锅远一点。",
      "visual_cue": "米粒洁白，水微浑，这是关键点。"
    },
    {
      "n": 2,
      "text": "锅里放清水和米，中火煮十五分钟到米软。，火别开太大，稳着来。",
      "time_min": 17,
      "heat": "中火",
      "tip": "米要煮到开花，汤才有稠度。，锅温要匀，别忽高忽低。",
      "visual_cue": "米粒开花，汤色发白"
    },
    {
      "n": 3,
      "text": "蛋黄加面粉搅成顺滑的糊。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "搅到无颗粒，汤才不结块。，火候宁小勿大，慢慢推进。",
      "visual_cue": "蛋糊顺滑，无干粉，别嫌麻烦，做完它。"
    },
    {
      "n": 4,
      "text": "蛋糊里分次加室温酸奶，搅匀。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酸奶一定要回温，否则会凝絮。，始终中小火，别心急。",
      "visual_cue": "糊体稀滑，颜色米白"
    },
    {
      "n": 5,
      "text": "舀一勺热汤慢慢倒进蛋糊里，边倒边搅。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先调温，直接倒锅里就成蛋花。，看住火，别让它失控。",
      "visual_cue": "蛋糊变温，无絮状，这一步别省。"
    },
    {
      "n": 6,
      "text": "把蛋糊倒回锅里，小火搅五分钟。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "小火",
      "tip": "全程小火，别让汤沸腾。，火大了就离锅远一点。",
      "visual_cue": "汤体微稠，表面无气泡"
    },
    {
      "n": 7,
      "text": "加盐调味，煮到微微冒气就关火。，火别开太大，稳着来。",
      "time_min": 3,
      "heat": "小火",
      "tip": "一沸酸奶就散，看到小泡就停。，锅温要匀，别忽高忽低。",
      "visual_cue": "汤面平静，勺背挂汤"
    },
    {
      "n": 8,
      "text": "黄油化开加薄荷碎，淋在汤面上。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "小火",
      "tip": "薄荷遇热就香，别炒久。，火候宁小勿大，慢慢推进。",
      "visual_cue": "油花浮动，香气清冽"
    }
  ],
  "tips": [
    "酸奶回温再用，汤才不结絮。，别跳过这步。",
    "先舀热汤调温，再倒回锅里。，这步最关键。",
    "全程小火，别让汤沸腾。，很多人在这里出错。"
  ],
  "common_mistakes": [
    "冷酸奶直接下锅，汤成絮状。，这里最容易翻车。",
    "大火煮开，酸奶全散。，别小看这一步。",
    "蛋糊没搅匀，汤里有面疙瘩。，成败就在这一步。"
  ],
  "substitutions": [
    {
      "original": "大米",
      "substitute": "面粉",
      "ratio": "60 克:40 克",
      "note": "汤更稠，煮的时间减半。"
    },
    {
      "original": "薄荷",
      "substitute": "莳萝",
      "ratio": "8 克:8 克",
      "note": "香气更柔，用量相同。"
    }
  ],
  "variations": [
    "加一勺柠檬汁，酸味更清。，这点要注意。",
    "撒一点红椒粉，颜色更暖。，这是关键点。"
  ],
  "serving_suggestion": "热汤配烤饼，冬天最合适。，别嫌麻烦，做完它。",
  "storage": "冷藏两天，复热须小火。，这一步别省。",
