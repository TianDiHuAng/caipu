  "equipment": [
    "面盆",
    "擀面杖",
    "平底锅或烤箱",
    "料理机",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母与白糖用温水化开，倒入面粉和五克盐揉成柔软面团，盖布发酵一小时。",
      "time_min": 70,
      "heat": "无火",
      "tip": "面团要揉到比饺子面软，擀得薄才不破。",
      "visual_cue": "面团体积膨胀一倍，手指按坑缓慢回弹"
    },
    {
      "n": 2,
      "text": "羊肉碎与洋葱碎、番茄碎、甜椒块、欧芹、蒜末一起用料理机打成细腻肉泥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "馅要打成泥状才能薄薄抹开，颗粒太粗擀不薄。",
      "visual_cue": "羊肉糜呈红褐色膏状，能抹开成薄层"
    },
    {
      "n": 3,
      "text": "羊肉糜拌入辣椒粉、孜然粉、三克盐和橄榄油，顺一个方向搅到起黏。",
      "time_min": 4,
      "heat": "无火",
      "tip": "孜然与辣椒粉先拌进油里更易均匀。",
      "visual_cue": "馅料油润发亮，能粘住勺子"
    },
    {
      "n": 4,
      "text": "面团分成八份，擀成直径约二十五厘米的薄圆片，越薄越好。",
      "time_min": 15,
      "heat": "无火",
      "tip": "擀的时候撒干粉防粘，擀到能透光最佳。",
      "visual_cue": "面片薄可透光，边缘略厚"
    },
    {
      "n": 5,
      "text": "把羊肉糜薄薄抹满面片，边缘留一厘米，平底锅大火烙四分钟至边缘焦脆。",
      "time_min": 6,
      "heat": "大火",
      "tip": "馅只抹一层，太厚会把饼压塌、中心不熟。",
      "visual_cue": "饼边鼓起小泡，底面出现焦斑"
    },
    {
      "n": 6,
      "text": "出锅后铺香菜与洋葱丝，挤柠檬汁，卷起来趁热吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "卷之前挤柠檬是灵魂，酸味能压住羊肉的膻香。",
      "visual_cue": "饼皮柔软可卷，馅料香气扑鼻"
    }
  ],
  "tips": [
    "面团发酵到位，饼皮才柔软可卷而不裂。",
    "想要更脆的口感，可把平底锅烧更热、烙制时间缩短。",
    "馅料可提前拌好冷藏，现擀现烙。"
  ],
  "common_mistakes": [
    "面片擀太厚，烙出来像饼不像薄脆。",
    "羊肉糜水分太多，抹上去饼底湿软，烙的时候粘锅破皮。",
    "火太小烙，饼皮发白发硬、没有焦香。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "300 克:300 克",
      "note": "牛肉需带一点肥膘，否则口感发干。"
    },
    {
      "original": "酵母",
      "substitute": "泡打粉",
      "ratio": "5 克:6 克",
      "note": "免发酵版本，面团需醒二十分钟再擀。"
    }
  ],
  "variations": [
    "把馅料换成奶酪与菠菜，可做土耳其常见的素食薄饼。"
  ],
  "serving_suggestion": "卷上欧芹、洋葱丝与柠檬汁，配酸奶饮料一起食用。",
  "storage": "饼皮可冷冻生坯一个月；熟饼冷藏一天，复热用干锅烙热。",
