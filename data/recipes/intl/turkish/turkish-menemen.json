  "equipment": [
    "不粘平底锅",
    "刀",
    "砧板",
    "木铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字用开水烫三十秒去皮，切成半厘米小丁备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "去皮后口感才顺滑，不去皮会在锅里卷成薄片影响卖相。",
      "visual_cue": "番茄丁红亮，盘中无积水"
    },
    {
      "n": 2,
      "text": "平底锅下橄榄油与黄油，小火把洋葱丁炒到透明发甜。",
      "time_min": 5,
      "heat": "小火",
      "tip": "黄油和橄榄油同用，奶香托底又不至于焦黑。",
      "visual_cue": "洋葱透明，油脂泛奶黄"
    },
    {
      "n": 3,
      "text": "下青椒圈与辣椒粉，中火翻炒两分钟炒出辛香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "辣椒粉在油里只需三十秒出香，久炒会发苦。",
      "visual_cue": "辣香扑鼻，青椒变亮绿"
    },
    {
      "n": 4,
      "text": "倒入番茄丁，加盐与黑胡椒，中火煮六分钟至番茄完全化开出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "用铲背压番茄帮助出汁，汤汁收浓一点蛋才不水。",
      "visual_cue": "锅底番茄化成浓稠红酱"
    },
    {
      "n": 5,
      "text": "转小火，把蛋液沿锅边缓缓淋入，静置三十秒再轻轻推拌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "不要一倒就搅，先让底部定型再推，蛋块才成大朵。",
      "visual_cue": "蛋液半凝，成大片软块"
    },
    {
      "n": 6,
      "text": "蛋液还有少许流动时立刻关火，撒欧芹碎连锅上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "余温会继续把蛋焖熟，关火晚了就变老。",
      "visual_cue": "蛋面湿润发亮，没有干边"
    }
  ],
  "tips": [
    "全程小火到中火，蛋才会嫩得像云一样软。",
    "喜欢辣可以在最后淋一点辣油，风味更直接。",
    "配烤面包或皮塔饼蘸汁吃最地道。"
  ],
  "common_mistakes": [
    "大火炒蛋，蛋液瞬间结块变干硬。",
    "番茄没煮出汁就下蛋液，成品水塌塌的。",
    "不停猛搅，蛋被搅成碎末失去大块口感。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "20 克:20 毫升",
      "note": "奶香变淡，风味更清爽。"
    },
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "150 克:150 克",
      "note": "辣度降低，甜味更明显。"
    }
  ],
  "variations": [
    "加五十克碎奶酪同炒，可做更浓的早餐版。",
    "放一小撮孜然粉，风味偏东南部风格。"
  ],
  "serving_suggestion": "连锅直接端上桌，配厚切烤面包和一杯红茶。",
  "storage": "现做现吃最佳，冷藏不超过一天，复热易出水。",
