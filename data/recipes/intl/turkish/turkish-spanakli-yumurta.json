  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "打蛋器",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜摘去老根洗净，切成五厘米长的段，沥干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "菠菜洗净后要沥干，带水下锅会出汤。",
      "visual_cue": "菠菜段干净无泥，水基本沥干"
    },
    {
      "n": 2,
      "text": "洋葱切小丁，大蒜切末，鸡蛋磕进碗里加一克盐打散。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蛋液打匀就够，不用打到起泡。",
      "visual_cue": "蛋液均匀，洋葱丁细小"
    },
    {
      "n": 3,
      "text": "炒锅倒橄榄油下洋葱丁中火炒四分钟至软塌透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒软出甜，能压住菠菜的涩味。",
      "visual_cue": "洋葱透明软塌，锅底泛油"
    },
    {
      "n": 4,
      "text": "加蒜末炒香，倒入菠菜段大火翻炒两分钟至完全塌软。",
      "time_min": 3,
      "heat": "大火",
      "tip": "菠菜一塌软就够，炒久了出水发黄。",
      "visual_cue": "菠菜体积缩小，颜色深绿"
    },
    {
      "n": 5,
      "text": "加盐、黑胡椒与红椒粉翻匀，把菠菜在锅底摊平。",
      "time_min": 2,
      "heat": "中火",
      "tip": "摊平再倒蛋液，蛋液分布才均匀。",
      "visual_cue": "菠菜平铺锅底，调料拌匀"
    },
    {
      "n": 6,
      "text": "沿锅边倒入蛋液，静置二十秒后翻炒成松散蛋块，出锅装盘。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先静置再炒，蛋块才成块不碎。",
      "visual_cue": "蛋块包裹菠菜，松散不粘连"
    }
  ],
  "tips": [
    "菠菜一定沥干水，否则炒完变一锅汤。",
    "洋葱先炒软，能压住菠菜的涩口。",
    "菠菜要大火快炒，炒久了会出水并且颜色发黄。",
    "蛋液倒进锅先静置再炒，蛋块才成型。"
  ],
  "common_mistakes": [
    "菠菜带水下锅，最后炒成一锅绿汤。",
    "小火慢炒菠菜，出水后颜色发暗发黄。",
    "蛋液一倒就猛翻，蛋和菠菜糊成一团。",
    "盐放太早，菠菜出水太多，口感寡淡。"
  ],
  "substitutions": [
    {
      "original": "菠菜",
      "substitute": "嫩菠菜苗",
      "ratio": "400克:400克",
      "note": "涩味更轻，炒的时间减半分钟。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "25毫升:25克",
      "note": "奶香更浓，火要调小。"
    }
  ],
  "variations": [
    "加一小勺番茄膏同炒，颜色更红亮。",
    "撒一点辣椒粉同炒，做成微辣版本更下饭。",
    "配一勺酸奶同吃，酸味能解掉油腻感。"
  ],
  "serving_suggestion": "装盘趁热吃，配面包或烤饼，菠菜嫩、蛋块滑，一顿简单的午饭就好了。",
  "storage": "冷藏不超过一天，复热用小火快炒两分钟，久加热菠菜会出水发黄。",
