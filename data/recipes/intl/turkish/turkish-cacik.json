 "equipment": [
  "碗",
  "刨丝器",
  "刀",
  "蒜臼"
 ],
 "steps": [
  {
   "n": 1,
   "text": "黄瓜去皮刨成细丝，撒一点盐抓匀。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "无火",
   "tip": "加盐逼水，成品才不稀。，火候要稳，别忽大忽小。",
   "visual_cue": "瓜丝出水，体积缩小"
  },
  {
   "n": 2,
   "text": "用手把瓜丝的水挤干，留在一旁。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "水挤得越干越好。，火候要稳，别忽大忽小。",
   "visual_cue": "瓜丝成团，掌心不出水"
  },
  {
   "n": 3,
   "text": "大蒜加一点盐捣成细泥。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "盐粒帮忙，蒜才捣得细。，火候要稳，别忽大忽小。",
   "visual_cue": "蒜泥发白，无颗粒，这一点很关键。"
  },
  {
   "n": 4,
   "text": "酸奶搅散，加蒜泥和盐拌匀。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "酸奶先搅顺，拌起来才匀。，火候要稳，别忽大忽小。",
   "visual_cue": "酱体顺滑，无结块，这一点很关键。"
  },
  {
   "n": 5,
   "text": "加清水调到能流动的稠度。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "稠了像糊，稀了挂不住黄瓜。，火候要稳，别忽大忽小。",
   "visual_cue": "酱体流动，勺子划过留痕"
  },
  {
   "n": 6,
   "text": "拌入黄瓜丝，冷藏二十分钟。，火候要稳，别忽大忽小。",
   "time_min": 22,
   "heat": "无火",
   "tip": "冷藏后味道才融合。，火候要稳，别忽大忽小。",
   "visual_cue": "成品冰凉，瓜丝悬浮"
  },
  {
   "n": 7,
   "text": "上桌淋橄榄油，撒薄荷碎。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "油和薄荷最后放，颜色才鲜。，火候要稳，别忽大忽小。",
   "visual_cue": "油珠浮面，绿叶点散"
  }
 ],
 "tips": [
  "黄瓜加盐逼水，成品才不稀。，这一点很关键。",
  "蒜加盐捣，才捣得细。，这一点很关键。",
  "冷藏二十分钟再吃，味道才融。，这一点很关键。"
 ],
 "common_mistakes": [
  "黄瓜水没挤，拌完一盘子汤。，这一点很关键。",
  "蒜切碎不捣，吃到颗粒发冲。，这一点很关键。",
  "酸奶太稀，成品挂不住。，这一点很关键。"
 ],
