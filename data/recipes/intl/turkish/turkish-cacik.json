    "刨丝器",
    "刀",
    "蒜臼"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜去皮刨成细丝，撒一点盐抓匀。，始终中小火，别心急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "加盐逼水，成品才不稀。，火要均匀，食材才不糊。",
      "visual_cue": "瓜丝出水，体积缩小"
    },
    {
      "n": 2,
      "text": "用手把瓜丝的水挤干，留在一旁。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水挤得越干越好。，全程留意火候，别贪快。",
      "visual_cue": "瓜丝成团，掌心不出水"
    },
    {
      "n": 3,
      "text": "大蒜加一点盐捣成细泥。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐粒帮忙，蒜才捣得细。，火别开太大，稳着来。",
      "visual_cue": "蒜泥发白，无颗粒，这是关键点。"
    },
    {
      "n": 4,
      "text": "酸奶搅散，加蒜泥和盐拌匀。，锅温要匀，别忽高忽低。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶先搅顺，拌起来才匀。，火力保持中等，慢慢来。",
      "visual_cue": "酱体顺滑，无结块，别嫌麻烦，做完它。"
    },
    {
      "n": 5,
      "text": "加清水调到能流动的稠度。，火候宁小勿大，慢慢推进。",
      "time_min": 2,
      "heat": "无火",
      "tip": "稠了像糊，稀了挂不住黄瓜。，注意锅里温度别掉下来。",
      "visual_cue": "酱体流动，勺子划过留痕"
    },
    {
      "n": 6,
      "text": "拌入黄瓜丝，冷藏二十分钟。，始终中小火，别心急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冷藏后味道才融合。，火要均匀，食材才不糊。",
      "visual_cue": "成品冰凉，瓜丝悬浮"
    },
    {
      "n": 7,
      "text": "上桌淋橄榄油，撒薄荷碎。，看住火，别让它失控。",
      "time_min": 2,
      "heat": "无火",
      "tip": "油和薄荷最后放，颜色才鲜。，全程留意火候，别贪快。",
      "visual_cue": "油珠浮面，绿叶点散"
    }
  ],
  "tips": [
    "黄瓜加盐逼水，成品才不稀。，这一步别省。",
    "蒜加盐捣，才捣得细。，别跳过这步。",
    "冷藏二十分钟再吃，味道才融。，这步最关键。"
  ],
  "common_mistakes": [
    "黄瓜水没挤，拌完一盘子汤。，很多人在这里出错。",
    "蒜切碎不捣，吃到颗粒发冲。，这里最容易翻车。",
    "酸奶太稀，成品挂不住。，别小看这一步。"
  ],
  "substitutions": [
    {
      "original": "黄瓜",
      "substitute": "西葫芦",
      "ratio": "300 克:300 克",
      "note": "需先焯水再刨丝。"
    },
    {
      "original": "薄荷",
      "substitute": "莳萝",
      "ratio": "10 克:8 克",
      "note": "香气更清，用量要少。"
    }
  ],
  "variations": [
    "加一勺柠檬汁，酸味更亮。，成败就在这一步。",
    "撒一点辣椒粉，做成微辣。，这点要注意。"
  ],
  "serving_suggestion": "配烤肉和米饭，冰凉解腻。，这是关键点。",
  "storage": "冷藏一天，吃前拌匀。，别嫌麻烦，做完它。",
