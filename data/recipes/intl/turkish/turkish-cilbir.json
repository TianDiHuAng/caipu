    "打蛋器",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酸奶倒进碗里加蒜泥和两克盐搅匀，静置回温十五分钟。",
      "time_min": 17,
      "heat": "无火",
      "tip": "酸奶回温后铺底才不会让蛋变凉。",
      "visual_cue": "酸奶顺滑，能挂住勺背"
    },
    {
      "n": 2,
      "text": "深锅加水加香醋烧至微沸，水面冒细密小泡但不翻滚。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "水只能微沸，大滚会把蛋白冲散。",
      "visual_cue": "水面细泡密集，锅边不翻滚"
    },
    {
      "n": 3,
      "text": "鸡蛋逐枚磕进小碗，再贴着水面轻轻滑入锅中。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "先磕进碗再滑入，蛋形才完整不散。",
      "visual_cue": "蛋液沉底抱团，蛋白裹住蛋黄"
    },
    {
      "n": 4,
      "text": "煮三分钟至蛋白完全凝固，用漏勺捞出放厨房纸上吸干水。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "三分钟刚好蛋白凝固蛋黄温热，久了就老。",
      "visual_cue": "蛋白洁白包住蛋黄，无流动蛋清"
    },
    {
      "n": 5,
      "text": "小锅放黄油小火化开，加红椒粉炒三十秒至油色橘红。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油小火化，起泡后立刻下红椒粉防焦。",
      "visual_cue": "黄油橘红发亮，香气冲鼻"
    },
    {
      "n": 6,
      "text": "酸奶舀进盘底摊开，放上水波蛋，浇红椒黄油，撒小葱与黑胡椒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "浇油要趁热，香气才能被激出来。",
      "visual_cue": "蛋卧在酸奶上，表面淋满红油"
    }
  ],
  "tips": [
    "酸奶提前回温，铺底才不会把蛋激冷。",
    "煮蛋的水只能微沸，大滚会把蛋白冲成絮。",
    "蛋先磕进小碗再滑入锅，形状才完整。",
    "黄油起泡就下红椒粉，稍慢一步就焦。"
  ],
  "common_mistakes": [
    "水在大滚时下蛋，蛋白散成一片蛋花。",
    "蛋直接磕进锅里，蛋黄磕破整锅浑。",
    "煮超过四分钟，蛋黄全硬，切开没有流动感。",
    "红椒黄油炒糊，苦味盖住了所有香味。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "希腊酸奶",
      "ratio": "250克:250克",
      "note": "更浓稠，需加两勺清水调稀。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "30克:30毫升",
      "note": "更清爽，香气稍弱。"
    }
  ],
  "variations": [
    "加一勺辣椒油代替红椒黄油，辣味更直接。",
    "底下垫一片烤面包，吸汁后特别香。",
    "表面撒一点干薄荷碎，香气更清凉解腻。"
  ],
  "serving_suggestion": "趁热上桌，用勺子从酸奶底部舀起，配一张热烤饼撕着蘸最香。",
  "storage": "现做现吃，冷藏不超过一天，酸奶和蛋须分开保存，复热只热蛋。",
