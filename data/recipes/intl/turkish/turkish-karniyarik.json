  "steps": [
    {
      "n": 1,
      "text": "茄子削出条纹皮，泡盐水十分钟。，火大了就离锅远一点。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡盐水，茄肉才不吸油。，火别开太大，稳着来。",
      "visual_cue": "茄身微软，水色变浅"
    },
    {
      "n": 2,
      "text": "茄子擦干，纵向划开一道口不切断。，锅温要匀，别忽高忽低。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划口别切断，才装得住馅。，火力保持中等，慢慢来。",
      "visual_cue": "开口整齐，茄身完整"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油，茄子煎到四面发软。，火候宁小勿大，慢慢推进。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煎软再烤，口感才绵。，注意锅里温度别掉下来。",
      "visual_cue": "茄皮起皱，按压发软"
    },
    {
      "n": 4,
      "text": "锅留底油，炒洋葱丁到透明。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒软，馅才甜。，火要均匀，食材才不糊。",
      "visual_cue": "洋葱透明，香气散出"
    },
    {
      "n": 5,
      "text": "加牛肉末炒散，炒到变色出油。，看住火，别让它失控。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉末炒散，不要结块。，全程留意火候，别贪快。",
      "visual_cue": "肉末松散，颜色变深"
    },
    {
      "n": 6,
      "text": "加甜椒丁和蒜末炒两分钟。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蒜末后放，才不发苦。，火别开太大，稳着来。",
      "visual_cue": "椒丁发亮，蒜香散出"
    },
    {
      "n": 7,
      "text": "加番茄丁、牛至、盐和黑胡椒炒成馅。，锅温要匀，别忽高忽低。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒出汁，馅才润。，火力保持中等，慢慢来。",
      "visual_cue": "馅料湿润，汁水收浓"
    },
    {
      "n": 8,
      "text": "馅料填进茄子开口，压实。，火候宁小勿大，慢慢推进。",
      "time_min": 6,
      "heat": "无火",
      "tip": "填满压实，烤后才不塌。，注意锅里温度别掉下来。",
      "visual_cue": "开口饱满，馅面平整"
    },
    {
      "n": 9,
      "text": "烤盘倒清水和番茄酱拌匀，摆入茄子。，始终中小火，别心急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盘底加汁，茄子才不干。，火要均匀，食材才不糊。",
      "visual_cue": "汁水到茄身一半，这点要注意。"
    },
    {
      "n": 10,
      "text": "一百八十度烤三十分钟，中途淋汁一次。，看住火，别让它失控。",
      "time_min": 32,
      "heat": "无火",
      "tip": "中途淋汁，表面才不干。，全程留意火候，别贪快。",
      "visual_cue": "茄身软塌，汁水浓稠"
    }
  ],
  "tips": [
    "茄子先煎软，烤后才绵。，这是关键点。",
    "划口别切断，馅才装得住。，别嫌麻烦，做完它。",
    "盘底加汁，烤时不会干。，这一步别省。"
  ],
  "common_mistakes": [
    "茄子没煎，烤后发硬。，别跳过这步。",
    "馅太湿，烤完流一滩。，这步最关键。",
    "不划口，馅放不进去。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "羊肉末",
      "ratio": "400 克:400 克",
      "note": "风味更重，可加孜然一克。"
    },
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "800 克:800 克",
      "note": "水分多，需先撒盐出水。"
    }
  ],
  "variations": [
    "加一点辣椒粉，味道更冲。，这里最容易翻车。",
    "表面加奶酪丝烤化，口感更浓。，别小看这一步。"
  ],
  "serving_suggestion": "配米饭和酸奶，汁水拌饭最香。，成败就在这一步。",
  "storage": "冷藏三天，复烤十分钟。，这点要注意。",
