  "steps": [
    {
      "n": 1,
      "text": "白芸豆提前用清水泡八小时，泡到豆子明显膨胀、表皮发皱。",
      "time_min": 480,
      "heat": "无火",
      "tip": "豆子必须泡透，否则炖两小时还是硬芯。",
      "visual_cue": "豆子胀大一倍，捏起来能压动"
    },
    {
      "n": 2,
      "text": "泡好的豆子沥干，倒进汤锅加清水煮开后转小火炖四十分钟。",
      "time_min": 45,
      "heat": "小火",
      "tip": "白芸豆提前浸泡八小时，炖煮时才容易软烂入味。",
      "visual_cue": "豆子变软但仍保持完整"
    },
    {
      "n": 3,
      "text": "洋葱切丁，番茄切块，青椒切块，大蒜切末备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "番茄切大块，久炖后会化进汤里。",
      "visual_cue": "各料切好分装，块型均匀"
    },
    {
      "n": 4,
      "text": "另起锅倒橄榄油下洋葱丁中火炒五分钟至软塌微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒透，炖出来的汤汁才甜。",
      "visual_cue": "洋葱软塌微黄，锅底泛油"
    },
    {
      "n": 5,
      "text": "加蒜末、番茄膏和红椒粉小火炒两分钟至油色变红。",
      "time_min": 3,
      "heat": "小火",
      "tip": "番茄膏炒出红油，汤色才红亮不发暗。",
      "visual_cue": "锅底油色橘红，香气浓"
    },
    {
      "n": 6,
      "text": "下番茄块和青椒块炒三分钟出汁，倒入煮过的豆子和清水。",
      "time_min": 5,
      "heat": "中火",
      "tip": "连豆子带汤一起倒，浓度才一致。",
      "visual_cue": "汤面翻起红泡，豆子浸在汤里"
    },
    {
      "n": 7,
      "text": "加盐、白糖和黑胡椒，小火炖三十分钟至豆子软烂、汤汁浓稠。",
      "time_min": 35,
      "heat": "小火",
      "tip": "小火慢炖，豆子才入味又不散成泥。",
      "visual_cue": "豆子软糯完整，汤汁浓稠挂勺"
    },
    {
      "n": 8,
      "text": "尝味补盐，关火焖五分钟再盛盘，配一碗白饭同吃最香。",
      "time_min": 6,
      "heat": "无火",
      "tip": "关火焖五分钟，豆子更入味。",
      "visual_cue": "汤汁浓稠红亮，豆子饱满"
    }
  ],
  "tips": [
    "白芸豆必须提前浸泡八小时，这是能炖烂的前提条件。",
    "豆子先单独煮到半软，再和番茄同炖更入味。",
    "番茄膏炒出红油，成品汤色才红亮。",
    "盐最后放，早放会让豆皮变硬不易炖烂。"
  ],
  "common_mistakes": [
    "豆子不泡直接炖，炖两小时还是硬的。",
    "一次加太多水，最后变成一锅豆汤。",
    "用大火滚煮，豆子被煮散成泥，汤变浑浊。",
    "一开始就放盐，豆皮收紧，怎么炖都不烂。"
  ],
  "substitutions": [
    {
      "original": "白芸豆",
      "substitute": "红腰豆",
      "ratio": "300克:300克",
      "note": "汤色更深，泡发时间相同。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "35毫升:35克",
      "note": "奶香更浓，需小火防焦。"
    }
  ],
  "variations": [
    "加一根切片的香肠同炖，荤香更足。",
    "放一个切块土豆同炖，汤汁会变得更浓稠。",
    "最后撒一把香菜碎，清香解腻更开胃。"
  ],
  "serving_suggestion": "盛在深盘里配白米饭，浇上浓汤，土耳其人吃这道菜必配一把腌黄瓜。",
  "storage": "冷藏可放三天，复热加少量清水小火加热，豆子会继续吸汤。",
