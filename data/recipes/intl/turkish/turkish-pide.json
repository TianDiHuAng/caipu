    "烤盘",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加酵母、白糖和四克盐拌匀，分次加清水揉成光滑面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团要揉到光滑，盖布发一小时至两倍大。",
      "visual_cue": "面团光滑有弹性，按下去缓慢回弹"
    },
    {
      "n": 2,
      "text": "洋葱、番茄、青椒切细丁，牛肉剁成粗粒备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "牛肉别剁太细，留颗粒口感才有嚼劲。",
      "visual_cue": "肉粒大小均匀，蔬菜丁细小"
    },
    {
      "n": 3,
      "text": "炒锅倒橄榄油下洋葱丁中火炒三分钟至透明，加牛肉粒炒散。",
      "time_min": 6,
      "heat": "中火",
      "tip": "牛肉炒到变色就好，后面还要进烤箱。",
      "visual_cue": "肉粒散开变色，洋葱透明"
    },
    {
      "n": 4,
      "text": "加番茄丁和青椒丁炒三分钟收干汁水，加盐、黑胡椒和红椒粉炒匀晾凉。",
      "time_min": 5,
      "heat": "中火",
      "tip": "馅料必须炒干，否则会浸湿面皮。",
      "visual_cue": "馅料干爽，锅底不见汤水"
    },
    {
      "n": 5,
      "text": "发好的面团分成三份，擀成三十厘米长的椭圆薄片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擀得薄一点，烤出来才脆不软塌。",
      "visual_cue": "面片均匀薄透，边缘整齐"
    },
    {
      "n": 6,
      "text": "把馅料铺在面片中间，两侧面皮向内折起并捏紧两端成船形。",
      "time_min": 8,
      "heat": "无火",
      "tip": "两端捏紧封口，烤的时候馅才不会漏。",
      "visual_cue": "船形两侧竖起，两端封口紧实"
    },
    {
      "n": 7,
      "text": "烤盘铺油纸放上肉饼，边缘刷一层橄榄油，醒十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "醒十分钟再烤，面皮才不会回缩变形。",
      "visual_cue": "面皮略微鼓起，边缘油亮"
    },
    {
      "n": 8,
      "text": "烤箱预热两百二十度，中层烤十五分钟至边缘金黄，出炉趁热切段。",
      "time_min": 16,
      "heat": "无火",
      "tip": "高温快烤，底部才脆而馅料不干。",
      "visual_cue": "底壳焦脆，边缘金黄起泡"
    }
  ],
  "tips": [
    "面团发到两倍大再擀，皮才松软有韧性。",
    "馅料一定要炒干汁水，否则底壳会被泡软。",
    "面皮擀得薄一些，烤出来底壳才焦脆不软塌。",
    "用高温快烤，底壳焦脆而馅料不会变干柴。"
  ],
  "common_mistakes": [
    "面团没发够就擀，烤出来又硬又薄脆。",
    "馅料带汤铺上去，底壳全湿黏糊。",
    "两侧没捏紧，烤的时候馅料全漏在烤盘上。",
    "温度太低慢烤，面皮发干、馅料出水变柴。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "300克:300克",
      "note": "膻香更浓，多加一克孜然粉。"
    },
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "60克:70克",
      "note": "不辣版本，甜味更足。"
    }
  ],
  "variations": [
    "上面磕一枚鸡蛋同烤，蛋黄半凝最好吃。",
    "加一把磨碎的奶酪铺在馅上，更香浓。",
    "全部换成蔬菜馅，做成素食版本同样好吃。"
  ],
  "serving_suggestion": "出炉趁热切段，配一杯酸奶或一碗汤，手拿着吃最香。",
  "storage": "冷藏可放两天，复烤一百八十度六分钟，微波会让底壳变软。",
