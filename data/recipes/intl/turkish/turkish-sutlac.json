    "total_min": 210
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "rich",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 800,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大米",
          "name_en": "rice",
          "amount": 90,
          "unit": "g",
          "note": "短粒米",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 100,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 20,
          "unit": "g",
          "note": "增稠",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 2,
          "unit": "g",
          "note": "表面撒粉",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "木勺",
    "小烤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后加清水浸泡三十分钟，泡到米粒发白。",
      "time_min": 30,
      "heat": "无火",
      "tip": "短粒米泡透，煮出来才绵。",
      "visual_cue": "米粒发白，指甲能掐断"
    },
    {
      "n": 2,
      "text": "沥干的大米与四百毫升牛奶一起倒进汤锅，小火加热。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶别用大火，容易糊底。",
      "visual_cue": "牛奶微冒热气，米粒沉底"
    },
    {
      "n": 3,
      "text": "边加热边用木勺搅动，煮十五分钟到米粒完全软烂。",
      "time_min": 15,
      "heat": "小火",
      "tip": "一直搅，米粒才不会粘锅。",
      "visual_cue": "米粒开花，糊体变稠"
    },
    {
      "n": 4,
      "text": "倒入剩下的牛奶，继续小火煮十分钟让味道融合。",
      "time_min": 10,
      "heat": "小火",
      "tip": "牛奶分次加，口感更顺滑。",
      "visual_cue": "糊体稀稠均匀，奶香浓"
    },
    {
      "n": 5,
      "text": "玉米淀粉用少量冷牛奶调开，缓缓倒入锅中搅匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "淀粉先调开，才不会结块。",
      "visual_cue": "糊体明显变稠，勺背挂糊"
    },
    {
      "n": 6,
      "text": "加入白糖后搅到完全融化，再转小火慢煮三分钟收稠。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖后放，米粒更容易煮软。",
      "visual_cue": "甜香明显，糊体缓缓流动"
    },
    {
      "n": 7,
      "text": "趁热分装进小烤碗里，表面用勺背抹平后放凉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "装七分满，烤时才不溢出。",
      "visual_cue": "表面平整，糊体微微颤动"
    },
    {
      "n": 8,
      "text": "烤箱预热两百度，烤碗放进烤箱烤八分钟上色。",
      "time_min": 8,
      "heat": "中火",
      "tip": "表面结一层焦皮最好吃。",
      "visual_cue": "表面出现焦褐色薄皮"
    },
    {
      "n": 9,
      "text": "取出彻底放凉，冷藏两小时后撒桂皮粉食用。",
      "time_min": 120,
      "heat": "无火",
      "tip": "冷藏后口感更绵密。",
      "visual_cue": "布丁凝固，表面焦皮完好"
    }
  ],
  "tips": [
    "大米先泡半小时，煮出来才够绵软。",
    "全程小火并不断搅拌，牛奶才不糊底。",
    "淀粉先用冷牛奶调开，加入时才不结块。"
  ],
  "common_mistakes": [
    "大米没泡直接煮，煮很久还是硬芯。",
    "火太大不搅拌，锅底结一层焦皮。",
    "淀粉直接撒进热牛奶，立刻结成小疙瘩。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "800 毫升:800 毫升",
      "note": "奶香更热带，糖可减二十克。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "大米粉",
      "ratio": "20 克:25 克",
      "note": "稠度略低，煮的时间加两分钟。"
    }
  ],
  "variations": [
    "表面撒一层杏仁碎再烤，坚果香更足。",
    "加几滴香草精进去，奶香会变得更柔和。"
  ],
  "serving_suggestion": "冷藏后当甜点，配一杯红茶解腻。",
  "storage": "冷藏两天内吃完，表面盖膜防结皮。",
