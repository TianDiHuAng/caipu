    "砧板",
    "大碗",
    "烤签",
    "烤架",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉剔掉筋膜，切成小块放冰箱冷冻二十分钟。，看住火，别让它失控。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冻硬一点，剁起来才不散。，全程留意火候，别贪快。",
      "visual_cue": "肉块硬挺，边缘微白"
    },
    {
      "n": 2,
      "text": "洋葱擦成细泥，用纱布挤掉一半水分。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱水太多，肉团挂不住签。，火别开太大，稳着来。",
      "visual_cue": "洋葱泥浓稠，汁水滤出"
    },
    {
      "n": 3,
      "text": "羊肉用刀剁成细粒，颗粒要均匀。，锅温要匀，别忽高忽低。",
      "time_min": 10,
      "heat": "无火",
      "tip": "别用料理机，打成糊就没嚼劲。，火力保持中等，慢慢来。",
      "visual_cue": "羊肉粒细匀，微微发黏"
    },
    {
      "n": 4,
      "text": "羊肉粒里加洋葱泥、辣椒粉、红椒粉、孜然、盐和黑胡椒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "调料先混匀再上手，味道才一致。，火候宁小勿大，慢慢推进。",
      "visual_cue": "肉团泛红，香料均匀"
    },
    {
      "n": 5,
      "text": "用手揉捏十分钟，到肉团起胶发黏。，注意锅里温度别掉下来。",
      "time_min": 11,
      "heat": "无火",
      "tip": "揉到发黏，烤的时候才不掉。，始终中小火，别心急。",
      "visual_cue": "肉团成团，掌心挂丝"
    },
    {
      "n": 6,
      "text": "盖保鲜膜冷藏半小时，让味道进肉里。，火要均匀，食材才不糊。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冷藏定型，串签才不塌。，看住火，别让它失控。",
      "visual_cue": "肉团紧实，按压回弹"
    },
    {
      "n": 7,
      "text": "手上抹橄榄油，把肉团捏成长条压上烤签，捏出波浪纹。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一边捏一边压，厚薄要匀。，全程留意火候，别贪快。",
      "visual_cue": "肉条平整，指痕成纹"
    },
    {
      "n": 8,
      "text": "烤架烧到高温，肉串离火十厘米烤十二分钟。，火大了就离锅远一点。",
      "time_min": 14,
      "heat": "中大火",
      "tip": "高温快烤，表面焦香里面多汁。，火别开太大，稳着来。",
      "visual_cue": "表面焦褐，油脂滴落"
    },
    {
      "n": 9,
      "text": "翻面再烤六分钟，按压无血水即可。，锅温要匀，别忽高忽低。",
      "time_min": 7,
      "heat": "中大火",
      "tip": "按压不冒血水就熟了。，火力保持中等，慢慢来。",
      "visual_cue": "肉串紧实，油光微亮"
    },
    {
      "n": 10,
      "text": "出炉静置三分钟，配洋葱丝和烤饼上桌。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置让肉汁回流，切开不流失。，注意锅里温度别掉下来。",
      "visual_cue": "切面多汁，香气冲鼻"
    }
  ],
  "tips": [
    "羊肉冻硬再剁，颗粒才匀。，别嫌麻烦，做完它。",
    "洋葱泥要挤水，否则肉团散。，这一步别省。",
    "揉到起胶，烤的时候才不脱落。，别跳过这步。"
  ],
  "common_mistakes": [
    "用料理机打肉，口感发糊。，这步最关键。",
    "洋葱水没挤，串签就往下掉。，很多人在这里出错。",
    "火太小慢烤，肉又干又硬。，这里最容易翻车。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "700 克:700 克",
      "note": "牛肉瘦，需多加三十毫升橄榄油。"
    }
  ],
  "variations": [
    "加一勺番茄膏，颜色更红亮。，别小看这一步。",
    "配烤青椒和番茄一起吃。，成败就在这一步。"
  ],
  "serving_suggestion": "配薄饼、洋葱丝和烤青椒，卷起来吃。",
  "storage": "冷藏两天，复热用平底锅干煎。，这点要注意。",
