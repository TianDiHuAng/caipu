      ]
    }
  ],
  "equipment": [
    "刀",
    "砧板",
    "炒锅",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫三十秒后撕去外皮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "开水烫过再剥皮，酱体才细腻不卷皮。",
      "visual_cue": "番茄皮整片撕下，果肉完整"
    },
    {
      "n": 2,
      "text": "去皮番茄对半切开，挤出籽和多余汁水，再切细丁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "籽和多余的汁挤掉，酱才不会稀得流汤。",
      "visual_cue": "番茄丁干爽，颜色鲜红"
    },
    {
      "n": 3,
      "text": "青椒去籽去蒂，切成比番茄丁还要细的小丁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "青椒丁切细一点，辣味散布才均匀。",
      "visual_cue": "青椒丁细碎，颜色翠绿"
    },
    {
      "n": 4,
      "text": "洋葱与大蒜分别剁成细末，颗粒尽量小而匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "末剁得够细，入口才不冲鼻子不呛喉。",
      "visual_cue": "葱白与蒜末细碎，颜色分明"
    },
    {
      "n": 5,
      "text": "炒锅下植物油，小火把洋葱末炒到透明发甜。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢慢炒，洋葱的甜味才出得来。",
      "visual_cue": "洋葱末透明，油色微黄"
    },
    {
      "n": 6,
      "text": "下蒜末与辣椒粉炒出香味，随即倒入番茄丁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "辣椒粉最怕焦，油温别烧得太高。",
      "visual_cue": "锅里红油泛香，番茄开始出汁"
    },
    {
      "n": 7,
      "text": "用中火翻炒六分钟，把番茄汁收到浓稠挂勺。",
      "time_min": 6,
      "heat": "中火",
      "tip": "水分收干，酱才挂得住烤饼不往下淌。",
      "visual_cue": "酱体浓稠，铲子划开见锅底"
    },
    {
      "n": 8,
      "text": "关火之后拌入青椒丁，加盐调味再彻底晾凉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青椒最后拌入，脆感和鲜绿都保留下来。",
      "visual_cue": "红酱里点点翠绿，油亮诱人"
    }
  ],
  "tips": [
    "番茄去皮去籽，酱体才浓稠不稀。",
    "青椒关火后再拌，颜色和脆感都在。",
    "辣椒粉下锅前油温别过高，否则发苦。"
  ],
  "common_mistakes": [
    "番茄带皮切丁，酱里全是卷起的皮。",
    "番茄不挤汁，炒完就是一锅稀的红汤。",
    "青椒一开始就下锅炒，颜色发黄变软。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "辣椒",
      "ratio": "100 克:60 克",
      "note": "辣度更高，用量减三分之一。"
    },
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "600 克:500 克",
      "note": "味道更浓，糖分略高。"
    }
  ],
  "variations": [
    "加一勺石榴糖浆，酸香更有土耳其风味。",
    "拌入一把切碎的欧芹，颜色更清新好看。"
  ],
  "serving_suggestion": "盛小碟抹在面包上，配烤肉与烤饼一起吃，是土耳其餐桌的常客。",
  "storage": "冷藏三天，表面淋一层植物油隔绝空气可多存一天。",
