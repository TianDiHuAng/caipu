  "steps": [
    {
      "n": 1,
      "text": "面粉加盐、酸奶和清水揉成软面团。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "加酸奶，饼皮才柔韧。，火候要稳，别忽大忽小。",
      "visual_cue": "面团光滑，手感柔软"
    },
    {
      "n": 2,
      "text": "盖布静置三十分钟，让面筋松弛。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "无火",
      "tip": "松弛到位，擀开才不缩。，火候要稳，别忽大忽小。",
      "visual_cue": "面团回弹变慢，这一点很关键。"
    },
    {
      "n": 3,
      "text": "菠菜洗净切碎，撒盐揉一分钟。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "撒盐揉出水分，馅才不湿。，火候要稳，别忽大忽小。",
      "visual_cue": "叶片软塌，水分析出"
    },
    {
      "n": 4,
      "text": "菠菜挤干水，拌入洋葱碎和羊乳酪。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水挤干，饼皮才不破。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料干爽，奶酪成块"
    },
    {
      "n": 5,
      "text": "加黑胡椒调味，拌匀备用。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "奶酪本身咸，盐要少放。，火候要稳，别忽大忽小。",
      "visual_cue": "味道咸香，香气清亮"
    },
    {
      "n": 6,
      "text": "面团分四份，擀成薄圆片。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "越薄越好，才吃得出馅。，火候要稳，别忽大忽小。",
      "visual_cue": "面片透光，边缘圆整"
    },
    {
      "n": 7,
      "text": "半边铺馅，对折压紧边缘。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "边缘压紧，煎时才不漏。，火候要稳，别忽大忽小。",
      "visual_cue": "半月形，边缘密封，这一点很关键。"
    },
    {
      "n": 8,
      "text": "平底锅烧热，放入饼干烙三分钟。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中火",
      "tip": "干烙起泡，饼才香。，火候要稳，别忽大忽小。",
      "visual_cue": "表面起泡，底面焦斑"
    },
    {
      "n": 9,
      "text": "翻面刷黄油，再烙两分钟。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中火",
      "tip": "刷黄油，饼皮才亮。，火候要稳，别忽大忽小。",
      "visual_cue": "两面金黄，油光均匀"
    },
    {
      "n": 10,
      "text": "出锅切条，趁热配酸奶吃。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "切条散热，口感更脆。，火候要稳，别忽大忽小。",
      "visual_cue": "外脆内软，香气扑鼻"
    }
  ],
  "tips": [
    "菠菜要挤干水，否则饼皮破。，这一点很关键。",
    "面团松弛到位，擀开才不缩。，这一点很关键。",
    "干烙再刷黄油，饼皮才酥。，这一点很关键。"
  ],
  "common_mistakes": [
    "馅太湿，煎时破皮流汁。，这一点很关键。",
    "面团没松弛，擀开就缩。，这一点很关键。",
    "火太大，皮焦馅没热。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "羊乳酪",
      "substitute": "切达奶酪",
      "ratio": "200 克:200 克",
      "note": "咸度低，需加盐一克。"
    },
    {
      "original": "菠菜",
      "substitute": "土豆泥",
      "ratio": "400 克:400 克",
      "note": "需先蒸熟压泥，馅更绵。"
    }
  ],
  "variations": [
    "馅换成牛肉末炒洋葱，做成肉馅版。",
    "加鸡蛋打入饼中，煎成蛋饼。，这一点很关键。"
  ],
  "serving_suggestion": "切条配酸奶或柠檬，趁热吃。，这一点很关键。",
  "storage": "冷藏两天，复烙三分钟。，这一点很关键。",
