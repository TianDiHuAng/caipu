    "锅",
    "木勺",
    "压泥器",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子整根放明火上烤，烤到表皮全黑。，始终中小火，别心急。",
      "time_min": 12,
      "heat": "中火",
      "tip": "烤到皮黑，肉才有烟香。，火要均匀，食材才不糊。",
      "visual_cue": "表皮焦黑，茄身软塌"
    },
    {
      "n": 2,
      "text": "趁热放入碗中盖住，焖十分钟。，看住火，别让它失控。",
      "time_min": 12,
      "heat": "无火",
      "tip": "盖住焖，皮才易剥。，全程留意火候，别贪快。",
      "visual_cue": "热气回软，皮皱起，这里最容易翻车。"
    },
    {
      "n": 3,
      "text": "剥去焦皮，取出茄肉压成泥。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "无火",
      "tip": "焦皮去净，泥才不发苦。，火别开太大，稳着来。",
      "visual_cue": "茄泥细腻，颜色微褐"
    },
    {
      "n": 4,
      "text": "锅化黄油，加面粉炒一分钟。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "小火",
      "tip": "面粉炒过，酱才不结块。，火力保持中等，慢慢来。",
      "visual_cue": "面糊起泡，颜色微黄"
    },
    {
      "n": 5,
      "text": "分次倒牛奶，边倒边搅成糊。，火候宁小勿大，慢慢推进。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶慢慢加，糊才顺。，注意锅里温度别掉下来。",
      "visual_cue": "糊体浓稠，无颗粒，别小看这一步。"
    },
    {
      "n": 6,
      "text": "拌入茄泥和羊乳酪，小火煮五分钟。，始终中小火，别心急。",
      "time_min": 7,
      "heat": "小火",
      "tip": "小火慢煮，味道才融合。，火要均匀，食材才不糊。",
      "visual_cue": "泥体厚实，勺背挂住"
    },
    {
      "n": 7,
      "text": "加盐和黑胡椒调味，保温备用。，看住火，别让它失控。",
      "time_min": 2,
      "heat": "小火",
      "tip": "咸淡要准，茄子很吃味。，全程留意火候，别贪快。",
      "visual_cue": "味道浓郁，奶香明显"
    },
    {
      "n": 8,
      "text": "牛肉切块，用橄榄油煎到焦褐。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "大火",
      "tip": "煎上色，炖后才香。，火别开太大，稳着来。",
      "visual_cue": "表面焦褐，肉汁锁住"
    },
    {
      "n": 9,
      "text": "下洋葱丁炒软，加番茄酱和牛至。，锅温要匀，别忽高忽低。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄酱炒过，酸味才柔。，火力保持中等，慢慢来。",
      "visual_cue": "酱色红亮，香气散出"
    },
    {
      "n": 10,
      "text": "加盐和清水，小火炖三十分钟。，火候宁小勿大，慢慢推进。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火炖，肉才软。，注意锅里温度别掉下来。",
      "visual_cue": "肉块酥软，汤汁浓稠"
    },
    {
      "n": 11,
      "text": "茄泥铺盘底，牛肉连汁浇在上面。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先铺泥再浇肉，层次才清。，火要均匀，食材才不糊。",
      "visual_cue": "颜色分明，汁水微淌"
    }
  ],
  "tips": [
    "茄子明火烤到皮黑，烟香才足。，成败就在这一步。",
    "焖十分钟再剥皮，最容易。，这点要注意。",
    "茄泥要稠，才托得住肉汁。，这是关键点。"
  ],
  "common_mistakes": [
    "茄子没烤透，泥带生味。，别嫌麻烦，做完它。",
    "牛奶一次倒入，糊结块。，这一步别省。",
    "茄泥太稀，浇汁后流一滩。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "600 克:600 克",
      "note": "风味更正，可加孜然一克。"
    },
    {
      "original": "羊乳酪",
      "substitute": "帕玛森奶酪",
      "ratio": "80 克:60 克",
      "note": "咸度高，盐减少两克。"
    }
  ],
  "variations": [
    "牛肉换成炖鸡腿，口感更清。，这步最关键。",
    "表面撒红椒粉，颜色更暖。，很多人在这里出错。"
  ],
  "serving_suggestion": "配米饭或薄饼，连泥一起吃。，这里最容易翻车。",
  "storage": "冷藏两天，复热加少量牛奶。，别小看这一步。",
