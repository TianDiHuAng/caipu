          "name_en": "butter",
          "amount": 200,
          "unit": "g",
          "note": "融化刷层",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 80,
          "unit": "g",
          "note": "撒层防粘",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 350,
          "unit": "g",
          "note": "熬糖浆",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 60,
          "unit": "g",
          "note": "增亮增香",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取汁",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "入面",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 300,
          "unit": "ml",
          "note": "熬糖浆",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 1,
          "unit": "piece",
          "note": "入面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "擀面杖",
    "小锅",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "中筋面粉加盐和鸡蛋，分次加水揉成偏硬的面团，盖布静置半小时。",
      "time_min": 35,
      "heat": "无火",
      "tip": "面团要揉得硬一点，擀薄才不破。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 2,
      "text": "面团分成十二份，擀成薄如纸的圆片，每片撒玉米淀粉防粘。",
      "time_min": 25,
      "heat": "无火",
      "tip": "擀到能透出手指的影子，才算够薄。",
      "visual_cue": "薄片透光，边缘整齐"
    },
    {
      "n": 3,
      "text": "核桃用刀切成粗碎粒，拌入二十克白糖备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "核桃别切太细，留一点颗粒有嚼头。",
      "visual_cue": "碎粒均匀，不出油"
    },
    {
      "n": 4,
      "text": "烤盘刷黄油，铺一张薄片刷一层黄油，重复六张后撒核桃碎。",
      "time_min": 12,
      "heat": "无火",
      "tip": "每层都要刷到黄油，烤完才起酥。",
      "visual_cue": "层层分明，油光均匀"
    },
    {
      "n": 5,
      "text": "再叠六张薄片，最上层刷足黄油，切成菱形小块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "先切块再烤，切面才整齐不碎裂。",
      "visual_cue": "菱形规整，切口见层"
    },
    {
      "n": 6,
      "text": "烤箱一百八十度烤三十分钟，表面金黄酥脆即可出炉。",
      "time_min": 30,
      "heat": "中火",
      "tip": "烤到表面浅金就够，取出还会继续上色。",
      "visual_cue": "表面金黄，层层鼓起"
    },
    {
      "n": 7,
      "text": "白糖、蜂蜜、清水和柠檬汁小火熬成糖浆，稍微放凉。",
      "time_min": 8,
      "heat": "小火",
      "tip": "糖浆熬到能挂勺就停，熬过头会发硬。",
      "visual_cue": "糖浆透亮，微稠挂勺"
    },
    {
      "n": 8,
      "text": "热蜜饼均匀淋上温糖浆，静置两小时让糖浆渗进去。",
      "time_min": 120,
      "heat": "无火",
      "tip": "糖浆要温的淋，太烫会把酥皮泡软。",
      "visual_cue": "糖浆渗入，切面湿润"
    }
  ],
  "tips": [
    "面团要揉得偏硬，擀到透光才够薄。",
    "每一层薄片都要刷黄油，烤出来才层层起酥。",
    "糖浆趁温热淋上，慢慢渗进去才够味。"
  ],
  "common_mistakes": [
    "面团太软，擀的时候破裂粘成一团。",
    "黄油刷得太省，烤完层与层之间粘在一起。",
    "糖浆熬过了头，冷却后硬得像糖块咬不动。"
  ],
  "substitutions": [
    {
      "original": "核桃",
      "substitute": "开心果",
      "ratio": "250 克:250 克",
      "note": "更接近土耳其原味，颜色更绿。"
    },
    {
      "original": "蜂蜜",
      "substitute": "葡萄糖浆",
      "ratio": "60 克:70 克",
      "note": "甜度接近，颜色更透亮。"
    }
  ],
  "variations": [
    "核桃换成开心果碎，做成加济安泰普风格。",
    "加一小勺玫瑰水进糖浆，香气更中东。"
  ],
  "serving_suggestion": "切成小块配一杯不加糖的红茶或土耳其咖啡，是节庆和待客最经典的甜点。",
  "storage": "密封常温三天，冷藏一周；受潮后可用一百五十度烤箱回脆五分钟。",
