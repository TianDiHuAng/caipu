  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "做酥皮",
          "optional": false
        },
        {
          "name": "核桃",
          "name_en": "walnut",
          "amount": 250,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
