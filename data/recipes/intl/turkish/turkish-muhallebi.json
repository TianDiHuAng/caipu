  "equipment": [
    "锅",
    "打蛋器",
    "小碗",
    "筛子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米淀粉加少量冷牛奶调成稀糊。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先用冷奶调开，才不结块。，看住火，别让它失控。",
      "visual_cue": "糊体顺滑，无颗粒，别嫌麻烦，做完它。"
    },
    {
      "n": 2,
      "text": "剩余牛奶加白糖，小火加热到微沸。，全程留意火候，别贪快。",
      "time_min": 7,
      "heat": "小火",
      "tip": "牛奶别煮开，会起膜。，火大了就离锅远一点。",
      "visual_cue": "边缘冒泡，糖化开，这一步别省。"
    },
    {
      "n": 3,
      "text": "把淀粉糊慢慢倒入热牛奶，不停搅拌。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "小火",
      "tip": "边倒边搅，才不会沉底。，锅温要匀，别忽高忽低。",
      "visual_cue": "液体变稠，搅动有阻力"
    },
    {
      "n": 4,
      "text": "小火煮五分钟，煮到浓稠挂勺。，火力保持中等，慢慢来。",
      "time_min": 6,
      "heat": "小火",
      "tip": "不停刮底，防糊锅。，火候宁小勿大，慢慢推进。",
      "visual_cue": "划痕清晰，稠度如膏"
    },
    {
      "n": 5,
      "text": "加盐和淡奶油拌匀，再煮一分钟。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "小火",
      "tip": "奶油最后加，香气才留。，始终中小火，别心急。",
      "visual_cue": "颜色乳白，质地顺滑"
    },
    {
      "n": 6,
      "text": "趁热倒进小碗，表面抹平。，火要均匀，食材才不糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "趁热倒，表面才平。，看住火，别让它失控。",
      "visual_cue": "表面光滑，无气泡，别跳过这步。"
    },
    {
      "n": 7,
      "text": "放凉后冷藏三小时定型。，全程留意火候，别贪快。",
      "time_min": 185,
      "heat": "无火",
      "tip": "冷藏够时间，才凝固得稳。，火大了就离锅远一点。",
      "visual_cue": "轻晃不流动，这步最关键。"
    },
    {
      "n": 8,
      "text": "脱模撒开心果碎，冷藏上桌。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "撒坚果前再脱模，表面才干净。，锅温要匀，别忽高忽低。",
      "visual_cue": "形状完整，坚果点缀"
    }
  ],
  "tips": [
    "淀粉先用冷奶调开，才不结块。，很多人在这里出错。",
    "全程小火搅动，防糊底。，这里最容易翻车。",
    "冷藏足够时间，脱模才完整。，别小看这一步。"
  ],
  "common_mistakes": [
    "淀粉直接下热奶，结成一团。，成败就在这一步。",
    "火太大，底部焦糊。，这点要注意。",
    "冷藏不够，脱模就塌。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "150 毫升:150 毫升",
      "note": "更清爽，需多加淀粉十克。"
    },
    {
      "original": "开心果",
      "substitute": "核桃",
      "ratio": "40 克:40 克",
      "note": "需切碎，香气更浓。"
    }
  ],
  "variations": [
    "加玫瑰水，香气更东方。，别嫌麻烦，做完它。",
    "表面淋蜂蜜，甜度更足。，这一步别省。"
  ],
  "serving_suggestion": "冷藏后脱模，撒坚果配红茶。，别跳过这步。",
  "storage": "冷藏两天，表面盖膜防干。，这步最关键。",
