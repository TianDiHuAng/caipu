  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和温水揉成软团，静置三十分钟。，火候要稳，别忽大忽小。",
      "time_min": 33,
      "heat": "无火",
      "tip": "面团要软，饼才薄。，火候要稳，别忽大忽小。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 2,
      "text": "牛肉切薄片，加盐和黑胡椒抓匀。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切薄一点，煎后才嫩。，火候要稳，别忽大忽小。",
      "visual_cue": "肉片薄亮，大小一致"
    },
    {
      "n": 3,
      "text": "面团分四份，擀成薄圆饼。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擀得越薄，口感越好。，火候要稳，别忽大忽小。",
      "visual_cue": "饼皮透光，厚度均匀"
    },
    {
      "n": 4,
      "text": "平底锅干烙圆饼，两面各一分钟。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "干烙不加油，饼才香。，火候要稳，别忽大忽小。",
      "visual_cue": "饼面起泡，边缘焦斑"
    },
    {
      "n": 5,
      "text": "饼切小块铺盘底，保温备用。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "切块铺底，汁水才吸得进。，火候要稳，别忽大忽小。",
      "visual_cue": "块形整齐，铺平，这一点很关键。"
    },
    {
      "n": 6,
      "text": "平底锅倒橄榄油，牛肉片大火快煎。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "大火",
      "tip": "大火快煎，肉才不老。，火候要稳，别忽大忽小。",
      "visual_cue": "肉片变色，边缘焦香"
    },
    {
      "n": 7,
      "text": "甜椒切条同煎一分钟，撒牛至。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "大火",
      "tip": "甜椒后放，保持脆度。，火候要稳，别忽大忽小。",
      "visual_cue": "椒条发亮，边缘微软"
    },
    {
      "n": 8,
      "text": "番茄酱小火加热，加盐调成浇汁。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "酱要热，浇上去才入味。，火候要稳，别忽大忽小。",
      "visual_cue": "酱汁冒泡，味道醇厚"
    },
    {
      "n": 9,
      "text": "黄油融化，烧到微微起泡。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油微焦，香气才浓。，火候要稳，别忽大忽小。",
      "visual_cue": "泡沫细密，颜色微褐"
    },
    {
      "n": 10,
      "text": "肉片铺饼上，浇番茄汁和热黄油。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后淋黄油，香气才冲。，火候要稳，别忽大忽小。",
      "visual_cue": "表面油亮，汁水四溢"
    },
    {
      "n": 11,
      "text": "一侧放酸奶和洋葱丝，趁热上桌。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶要凉，配热肉才好吃。，火候要稳，别忽大忽小。",
      "visual_cue": "颜色分明，香气扑鼻"
    }
  ],
  "tips": [
    "肉切薄片，大火快煎才嫩。，这一点很关键。",
    "饼要薄，铺底才吸汁。，这一点很关键。",
    "热黄油最后淋，香气最足。，这一点很关键。"
  ],
  "common_mistakes": [
    "肉片太厚，煎后发柴。，这一点很关键。",
    "饼擀太厚，吃起来像面包。，这一点很关键。",
    "黄油烧过头，发苦。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "800 克:800 克",
      "note": "风味更浓，可多加牛至一克。"
    },
    {
      "original": "酸奶",
      "substitute": "酸奶油",
      "ratio": "300 克:300 克",
      "note": "质地更厚，酸度略低。"
    }
  ],
  "variations": [
    "加烤番茄和青椒作配菜，颜色更全。",
    "肉下垫一层茄子泥，口感更丰富。，这一点很关键。"
  ],
  "serving_suggestion": "盘子一端上桌，配咸酸奶饮品解腻。",
  "storage": "冷藏两天，复热用平底锅。，这一点很关键。",
