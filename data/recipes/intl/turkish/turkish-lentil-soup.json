  "equipment": [
    "汤锅",
    "料理机",
    "锅铲",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红扁豆淘洗两遍，挑掉浮起的坏豆后沥干备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "扁豆不用泡，洗净就能直接煮。",
      "visual_cue": "豆子沉底，水变清"
    },
    {
      "n": 2,
      "text": "汤锅倒橄榄油，中火炒洋葱碎三分钟到变软透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒软，汤底才有甜味。",
      "visual_cue": "洋葱透明，锅里有香气"
    },
    {
      "n": 3,
      "text": "加番茄膏与面粉，小火炒一分半到出红油为止。",
      "time_min": 2,
      "heat": "小火",
      "tip": "面粉炒一下，汤才不结块。",
      "visual_cue": "油色橘红，面粉散开"
    },
    {
      "n": 4,
      "text": "下胡萝卜丁与土豆丁翻炒两分钟，让表面裹上油。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蔬菜先炒，汤的甜味更足。",
      "visual_cue": "蔬菜表面均匀泛油光"
    },
    {
      "n": 5,
      "text": "倒入扁豆与孜然，加一千毫升热水大火煮开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "热水下锅，汤体更顺滑。",
      "visual_cue": "水面滚开，浮起少量泡沫"
    },
    {
      "n": 6,
      "text": "撇掉浮沫后转小火，盖盖煮二十五分钟至豆子软烂。",
      "time_min": 25,
      "heat": "小火",
      "tip": "煮到豆子一压就碎，才算到位。",
      "visual_cue": "豆子开花，蔬菜软烂"
    },
    {
      "n": 7,
      "text": "用料理机打成顺滑的浓汤，太稠可加少量热水。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打细一点，口感才像浓汤。",
      "visual_cue": "汤体顺滑，没有明显颗粒"
    },
    {
      "n": 8,
      "text": "倒回锅里加盐调味，小火加热到微滚后关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "尝味补盐，别一开始就下重手。",
      "visual_cue": "汤体浓稠，能挂住勺背"
    },
    {
      "n": 9,
      "text": "盛碗后挤入柠檬汁，撒干薄荷与少许橄榄油即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬汁是灵魂，挤了整碗都清爽。",
      "visual_cue": "汤面泛油光，颜色橙黄"
    }
  ],
  "tips": [
    "红扁豆不用浸泡，洗净直接煮更省时。",
    "面粉先炒过，汤才顺滑而且不结块。",
    "柠檬汁上桌前再挤，酸香最提味。"
  ],
  "common_mistakes": [
    "扁豆没洗净直接煮，汤里带豆腥味。",
    "面粉不炒直接撒，汤里结一粒粒面块。",
    "省略柠檬汁，整碗汤只有豆味没有亮点。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "绿豆",
      "ratio": "250 克:250 克",
      "note": "需提前泡两小时，煮制时间延长十分。"
    },
    {
      "original": "番茄膏",
      "substitute": "番茄",
      "ratio": "20 克:120 克",
      "note": "需切碎先炒出汁，汤色略浅。"
    }
  ],
  "variations": [
    "加一小勺辣椒粉，喝起来微辣更开胃。",
    "配几块烤面包丁，口感更有层次。"
  ],
  "serving_suggestion": "热汤配柠檬角与烤面包，作为头盘或轻食。",
  "storage": "冷藏三天、冷冻一个月，复热加水调稀再煮开。",
