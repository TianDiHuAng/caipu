 "steps": [
  {
   "n": 1,
   "text": "面粉加盐、鸡蛋和清水揉成偏硬的面团。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "面要硬，擀薄才不破。，火候要稳，别忽大忽小。",
   "visual_cue": "面团紧实，表面光洁"
  },
  {
   "n": 2,
   "text": "盖湿布醒面三十分钟，中途再揉一次。，火候要稳，别忽大忽小。",
   "time_min": 33,
   "heat": "无火",
   "tip": "醒透了才好擀。，火候要稳，别忽大忽小。",
   "visual_cue": "按下去缓慢回弹，这一点很关键。"
  },
  {
   "n": 3,
   "text": "牛肉末加洋葱末、盐和黑胡椒，顺一个方向搅上劲。",
   "time_min": 6,
   "heat": "无火",
   "tip": "搅到发黏，馅才抱团。，火候要稳，别忽大忽小。",
   "visual_cue": "肉馅成团，筷子立得住"
  },
  {
   "n": 4,
   "text": "面团擀成两毫米薄片，切成五厘米方块。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "越薄越好，透光能看见手指。，火候要稳，别忽大忽小。",
   "visual_cue": "面片薄匀，边缘整齐"
  },
  {
   "n": 5,
   "text": "每张面片放指甲盖大的馅，四角捏合封口。，火候要稳，别忽大忽小。",
   "time_min": 22,
   "heat": "无火",
   "tip": "馅别多，多了煮的时候撑破。，火候要稳，别忽大忽小。",
   "visual_cue": "小包挺立，封口紧实"
  },
  {
   "n": 6,
   "text": "锅烧开水加盐，下饺子煮八分钟。，火候要稳，别忽大忽小。",
   "time_min": 10,
   "heat": "中火",
   "tip": "水要宽，饺子才不粘。，火候要稳，别忽大忽小。",
   "visual_cue": "饺子浮起，皮呈半透明"
  },
  {
   "n": 7,
   "text": "捞出沥干装盘，趁热淋上酸奶。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "酸奶要浓稠，挂得住饺子。，火候要稳，别忽大忽小。",
   "visual_cue": "白酱覆盖，饺子微露"
  },
  {
   "n": 8,
   "text": "黄油小火化开，加红椒粉炒出红油。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "小火",
   "tip": "红椒粉一下锅就关火，久了发苦。，火候要稳，别忽大忽小。",
   "visual_cue": "油色橘红，香气上冲"
  },
  {
   "n": 9,
   "text": "把红油淋在酸奶上，撒薄荷碎趁热吃。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "淋油时听得到滋滋声才对。，火候要稳，别忽大忽小。",
   "visual_cue": "红白相间，薄荷点缀"
  }
 ],
 "tips": [
  "面团要硬，擀薄才不破皮。，这一点很关键。",
  "馅只放黄豆大，多了会煮破。，这一点很关键。",
  "红椒粉下锅立刻关火，久了发苦。，这一点很关键。"
 ],
 "common_mistakes": [
  "面太软，擀开就粘成一团。，这一点很关键。",
  "馅包太多，煮的时候全漏。，这一点很关键。",
  "酸奶太稀，浇上去流一盘子。，这一点很关键。"
 ],
 "substitutions": [
  {
   "original": "牛肉末",
   "substitute": "羊肉",
   "ratio": "300 克:300 克",
   "note": "羊肉先剁细，香味更重。"
  },
  {
   "original": "酸奶",
   "substitute": "淡奶油",
   "ratio": "300 克:250 克",
   "note": "口感更厚，酸味变淡。"
  }
 ],
 "variations": [
  "加一勺番茄膏炒进红油里。，这一点很关键。",
  "撒一点孜然粉，香气更足。，这一点很关键。"
 ],
 "serving_suggestion": "装盘后拌开吃，配一杯咸酸奶。，这一点很关键。",
 "storage": "生饺子冷冻一个月，熟品冷藏一天。",
