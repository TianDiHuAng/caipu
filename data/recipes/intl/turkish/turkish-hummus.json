  "equipment": [
    "锅",
    "料理机",
    "漏勺",
    "刀",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆提前泡一夜，泡到捏得动。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡够时间，煮出来才软烂。，火候要稳，别忽大忽小。",
      "visual_cue": "豆粒膨大，表皮起皱"
    },
    {
      "n": 2,
      "text": "换清水煮四十分钟，撇掉浮沫。，火候要稳，别忽大忽小。",
      "time_min": 42,
      "heat": "中火",
      "tip": "煮到一捏就碎，别急着关火。，火候要稳，别忽大忽小。",
      "visual_cue": "豆粒开花，汤色发白"
    },
    {
      "n": 3,
      "text": "捞出留一小把豆粒，其余沥干放凉。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "留几粒做装饰，口感有层次。，火候要稳，别忽大忽小。",
      "visual_cue": "豆粒干爽，无多余水"
    },
    {
      "n": 4,
      "text": "鹰嘴豆、芝麻酱、大蒜和柠檬汁放进料理机。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "芝麻酱先搅开，酱才顺滑。，火候要稳，别忽大忽小。",
      "visual_cue": "材料入杯，酱体沉底"
    },
    {
      "n": 5,
      "text": "加盐和孜然，边打边分次倒橄榄油。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "油慢慢加，酱才乳化发亮。，火候要稳，别忽大忽小。",
      "visual_cue": "酱体细腻，颜色米黄"
    },
    {
      "n": 6,
      "text": "分次加清水，打到能缓慢流动的稠度。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水一点点加，稠度才好控。，火候要稳，别忽大忽小。",
      "visual_cue": "酱体顺滑，能挂勺，这一点很关键。"
    },
    {
      "n": 7,
      "text": "尝味后补盐和柠檬汁，装盘抹出旋纹。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酸味要亮，酱才不闷。，火候要稳，别忽大忽小。",
      "visual_cue": "表面旋纹，油光柔和"
    },
    {
      "n": 8,
      "text": "淋橄榄油，撒孜然粉和留下的豆粒。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油淋在凹处，看着才有层次。，火候要稳，别忽大忽小。",
      "visual_cue": "油层清亮，豆粒点缀"
    }
  ],
  "tips": [
    "鹰嘴豆泡一夜，煮出来才细腻。，这一点很关键。",
    "芝麻酱先搅开再用，酱才不结块。，这一点很关键。",
    "水一点点加，稠度才好控。，这一点很关键。"
  ],
  "common_mistakes": [
    "豆没泡透，打出来有颗粒。，这一点很关键。",
    "一次倒太多水，酱稀如水。，这一点很关键。",
    "芝麻酱沉底没搅，酱体发苦。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鹰嘴豆",
      "substitute": "白芸豆",
      "ratio": "400 克:400 克",
      "note": "口感更绵，水要少加。"
    },
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "120 克:110 克",
      "note": "甜味更重，柠檬多加半个。"
    }
  ],
  "variations": [
    "加一勺酸奶，酱体更轻盈。，这一点很关键。",
    "撒辣椒粉和欧芹碎，颜色更亮。，这一点很关键。"
  ],
  "serving_suggestion": "配烤饼撕着蘸，或当烤肉配菜。，这一点很关键。",
  "storage": "冷藏三天，表面淋油封口。，这一点很关键。",
