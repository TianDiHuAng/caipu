  "id": "turkish-zucchini-fritters",
  "name": {
    "zh": "土耳其西葫芦煎饼",
    "en": "Turkish Zucchini Fritters (Mücver)",
    "original": "Mücver"
  },
  "cuisine": {
    "region": "intl",
    "style": "turkish"
  },
  "category": [
    "appetizer",
    "snack"
  ],
  "difficulty": 1,
  "time": {
    "prep_min": 25,
    "cook_min": 30,
    "total_min": 55
  },
  "servings": 4,
  "flavor": [
    "savory",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "西葫芦",
          "name_en": "zucchini",
          "amount": 500,
          "unit": "g",
          "note": "刨丝",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "打散",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 80,
          "unit": "g",
          "note": "粘合",
          "optional": false
        },
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 100,
          "unit": "g",
          "note": "碎粒",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 15,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 60,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 120,
          "unit": "g",
          "note": "佐食",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "刨丝器",
    "大碗",
    "平底锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西葫芦刨成细丝，撒盐拌匀后静置十五分钟。",
      "time_min": 17,
      "heat": "无火",
      "tip": "先撒盐逼出多余水分，饼糊才不会稀。",
      "visual_cue": "西葫芦丝软塌，盆底积了绿水"
    },
    {
      "n": 2,
      "text": "用手把西葫芦丝攥成团，用力挤掉多余水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水分挤得越干，饼才越成型不散。",
      "visual_cue": "丝团干爽，攥紧不出水"
    },
    {
      "n": 3,
      "text": "挤干的西葫芦丝放进大碗，再加入鸡蛋拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鸡蛋先打散再倒入，拌得才更均匀。",
      "visual_cue": "蛋液裹住丝，颜色发亮"
    },
    {
      "n": 4,
      "text": "再放入面粉、奶酪碎与欧芹，翻拌成浓稠面糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "稠到能挂住勺子就好，别加太多面粉。",
      "visual_cue": "糊体稠厚，勺子倒挂不掉"
    },
    {
      "n": 5,
      "text": "尝一下咸淡，奶酪本身有咸味所以要少放盐。",
      "time_min": 2,
      "heat": "无火",
      "tip": "奶酪先尝一下咸度，盐一次别放足。",
      "visual_cue": "咸淡适中，糊里带奶酪香"
    },
    {
      "n": 6,
      "text": "平底锅下植物油，开中火烧到油面微微晃动。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温一定要够，面糊下锅才能定住。",
      "visual_cue": "油面泛起细纹，微微冒烟"
    },
    {
      "n": 7,
      "text": "舀一勺面糊下锅摊成小圆饼，每锅一次只煎四块。",
      "time_min": 4,
      "heat": "中火",
      "tip": "饼不要摊得太厚，中间才容易熟透。",
      "visual_cue": "小饼圆整，边缘冒小泡"
    },
    {
      "n": 8,
      "text": "用中小火每面各煎三分钟，煎到两面都金黄酥香。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "底面完全定住再翻面，翻早了就散。",
      "visual_cue": "两面金黄，饼身微鼓"
    },
    {
      "n": 9,
      "text": "捞出后放在厨房纸上摊开，吸掉表面的多余油分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "把表面的浮油吸干净，入口才不腻。",
      "visual_cue": "纸面渗油，饼皮干爽"
    },
    {
      "n": 10,
      "text": "装盘趁热配一勺冰酸奶，再撒一把欧芹碎上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶要冷藏过的，冷热搭配最解腻。",
      "visual_cue": "饼色焦黄，酸奶雪白"
    }
  ],
  "tips": [
    "西葫芦先撒盐再挤水，饼才成型不塌。",
    "面粉只加到能挂糊，多了饼就发硬。",
    "中小火慢煎，中心才熟透不发黏。"
  ],
  "common_mistakes": [
    "西葫芦不挤水直接拌糊，下锅就散。",
    "面粉一股脑倒进去，煎出来像厚面饼。",
    "火太大，外面焦了里面还是生糊。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "胡萝卜",
      "ratio": "500 克:450 克",
      "note": "甜味更突出，挤水更彻底。"
    },
    {
      "original": "奶酪",
      "substitute": "酸奶",
      "ratio": "100 克:100 克（沥干）",
      "note": "更清爽，粘合度略低。"
    }
  ],
  "variations": [
    "加一把切碎的薄荷，清香更明显。",
    "糊里拌入玉米粒，口感更甜更脆。"
  ],
  "serving_suggestion": "趁热装盘配冰酸奶，作为开胃菜或下午茶小食都合适。",
  "storage": "冷藏两天，复热用平底锅干煎一分钟恢复酥脆。",
