    "砧板",
    "厨师刀",
    "锅铲",
    "小勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子竖着划开一道口子，用勺子挖出内瓤切碎，外壳保持完整像小船。",
      "time_min": 10,
      "heat": "无火",
      "tip": "挖瓤时别戳破外皮，破了炖煮时会散开塌陷。",
      "visual_cue": "茄子外壳完整，切口张开露出白色瓤肉"
    },
    {
      "n": 2,
      "text": "橄榄油烧热，把茄子船逐面煎到表皮起皱变软，取出排在锅里。",
      "time_min": 10,
      "heat": "中火",
      "tip": "茄子先煎后炖能锁住水分，口感比直接焖更有层次。",
      "visual_cue": "茄子表皮呈深紫色皱缩，按压能轻松陷入"
    },
    {
      "n": 3,
      "text": "余油炒洋葱碎到透明，下大蒜片和茄子瓤炒软，再加番茄丁炒出红汁。",
      "time_min": 10,
      "heat": "中火",
      "tip": "番茄要炒到出沙脱形，汤汁才有厚度不寡淡。",
      "visual_cue": "锅中呈浓稠红酱状，洋葱完全软化"
    },
    {
      "n": 4,
      "text": "加白糖、盐和黑胡椒调味，把馅料填进茄子船，倒半碗水盖上焖二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "水量到茄子身三分之一即可，收汁太快可补少量水。",
      "visual_cue": "茄身软塌塌地卧在红汤里，表面泛油光"
    },
    {
      "n": 5,
      "text": "开盖收汁到汤汁浓稠，撒上欧芹碎，晾到温热再装盘。",
      "time_min": 5,
      "heat": "小火",
      "tip": "欧芹最后撒才不会发黄，温吃的风味比滚烫时更清甜。",
      "visual_cue": "馅料表面收起水汽，茄子边缘微微透明"
    }
  ],
  "tips": [
    "茄子选细长的紫皮品种，籽少肉厚，炖完不会发苦。",
    "冷藏一夜再吃风味更融合，冷食也是土耳其家庭的常见吃法。",
    "橄榄油用量不要省，油润是这道菜的灵魂。"
  ],
  "common_mistakes": [
    "茄子挖瓤时划破外皮，炖煮中会散架成一锅碎泥。",
    "番茄没炒出沙就加水，成菜汤汁稀薄挂不住茄子。",
    "省略先煎步骤直接焖，茄子吸油过多且口感发绵。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "1:1",
      "note": "用粗西葫芦代替，炖煮时间缩短到十二分钟。"
    },
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "1:1",
      "note": "香气更冲，用量减半即可。"
    }
  ],
  "variations": [
    "在馅料里加入一小把熟米饭，做成土耳其常见的米饭版炖茄子。"
  ],
  "serving_suggestion": "放凉到微温后配皮塔饼或白饭，淋锅里的红汤汁同食。",
  "storage": "冷藏三天内吃完，冷食风味更佳，复热用小火避免糊底。",
