  "equipment": [
    "平底锅",
    "擀面杖",
    "碗",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加鸡蛋、牛奶和盐揉成偏硬面团。，全程留意火候，别贪快。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面硬一点，皮才擀得薄。，火大了就离锅远一点。",
      "visual_cue": "面团紧实，表面光滑"
    },
    {
      "n": 2,
      "text": "盖布静置二十五分钟松弛。，火别开太大，稳着来。",
      "time_min": 27,
      "heat": "无火",
      "tip": "松弛到位，擀开才不回缩。，锅温要匀，别忽高忽低。",
      "visual_cue": "按压留坑，回弹变慢"
    },
    {
      "n": 3,
      "text": "羊乳酪捏碎，拌入莳萝和黑胡椒。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "奶酪别太碎，留点颗粒。，火候宁小勿大，慢慢推进。",
      "visual_cue": "馅料松散，香气清亮"
    },
    {
      "n": 4,
      "text": "面团分小块，擀成很薄的圆片。，注意锅里温度别掉下来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "薄到透光，卷起来才脆。，始终中小火，别心急。",
      "visual_cue": "面片薄透，边缘圆整"
    },
    {
      "n": 5,
      "text": "面片刷融化黄油，切三角块。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷黄油，炸后才酥。，看住火，别让它失控。",
      "visual_cue": "表面油亮，切块整齐"
    },
    {
      "n": 6,
      "text": "窄边放一条奶酪馅，卷紧成细条。，全程留意火候，别贪快。",
      "time_min": 8,
      "heat": "无火",
      "tip": "卷紧一点，炸时才不散。，火大了就离锅远一点。",
      "visual_cue": "条身紧实，粗细一致"
    },
    {
      "n": 7,
      "text": "边缘刷蛋液封口，压紧。，火别开太大，稳着来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液封口，炸时不裂。，锅温要匀，别忽高忽低。",
      "visual_cue": "封口贴合，条身完整"
    },
    {
      "n": 8,
      "text": "平底锅倒植物油，烧到微冒烟。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温不够会吸油。，火候宁小勿大，慢慢推进。",
      "visual_cue": "油面起纹，筷子冒泡"
    },
    {
      "n": 9,
      "text": "下卷条炸两分钟到金黄，翻面再炸。，注意锅里温度别掉下来。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一次别放多，油温才不降。，始终中小火，别心急。",
      "visual_cue": "表皮金黄，体积鼓起"
    },
    {
      "n": 10,
      "text": "捞出沥油，趁热装盘。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "沥干油，吃着才不腻。，看住火，别让它失控。",
      "visual_cue": "表面干爽，轻捏即碎"
    }
  ],
  "tips": [
    "面团偏硬，才擀得薄。，这是关键点。",
    "卷紧一点，炸后才不散。，别嫌麻烦，做完它。",
    "油温要够，卷条才不吸油。，这一步别省。"
  ],
  "common_mistakes": [
    "面皮太厚，炸后发硬。，别跳过这步。",
    "卷太松，下锅就散开。，这步最关键。",
    "油温低，满口是油。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "羊乳酪",
      "substitute": "切达奶酪",
      "ratio": "250 克:250 克",
      "note": "咸度低，需加盐两克。"
    },
    {
      "original": "莳萝",
      "substitute": "欧芹",
      "ratio": "6 克:6 克",
      "note": "香气更清，用量可增半。"
    }
  ],
  "variations": [
    "馅加土豆泥，口感更绵。，这里最容易翻车。",
    "改成烤箱烤，用油更少。，别小看这一步。"
  ],
  "serving_suggestion": "趁热配酸奶或柠檬角，作前菜上桌。",
  "storage": "冷藏两天，复烤五分钟。，成败就在这一步。",
