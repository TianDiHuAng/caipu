  "equipment": [
    "烤箱",
    "打蛋器",
    "模具",
    "锅",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋加一百克白糖，打到颜色发白发稠。，火力保持中等，慢慢来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到落痕能停留两秒。，火候宁小勿大，慢慢推进。",
      "visual_cue": "蛋糊泛白，体积膨胀"
    },
    {
      "n": 2,
      "text": "加酸奶和橄榄油，搅到完全融合。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油别一次倒，慢慢拌才不吃水。，始终中小火，别心急。",
      "visual_cue": "糊体顺滑，无油花，这里最容易翻车。"
    },
    {
      "n": 3,
      "text": "筛入面粉，翻拌到看不见干粉。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "别画圈拌，起筋蛋糕就硬。，看住火，别让它失控。",
      "visual_cue": "糊体厚实，无干粉，别小看这一步。"
    },
    {
      "n": 4,
      "text": "模具抹黄油撒薄粉，倒入面糊抹平。，全程留意火候，别贪快。",
      "time_min": 4,
      "heat": "无火",
      "tip": "模具处理干净，脱模才完整。，火大了就离锅远一点。",
      "visual_cue": "表面平整，无大气泡"
    },
    {
      "n": 5,
      "text": "烤箱一百八十度烤三十分钟，表面金黄。，火别开太大，稳着来。",
      "time_min": 32,
      "heat": "无火",
      "tip": "牙签插入不粘糊就出炉。，锅温要匀，别忽高忽低。",
      "visual_cue": "表面金黄，中心回弹"
    },
    {
      "n": 6,
      "text": "另起锅放清水、剩余白糖、蜂蜜和柠檬汁煮开。，火力保持中等，慢慢来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "糖浆煮到微稠就关火。，火候宁小勿大，慢慢推进。",
      "visual_cue": "糖浆清亮，微挂勺，成败就在这一步。"
    },
    {
      "n": 7,
      "text": "蛋糕趁热切块，把温热糖浆慢慢浇上去。，注意锅里温度别掉下来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "热的浇热的，糖浆才吸得进去。，始终中小火，别心急。",
      "visual_cue": "糖浆渗入，表面发亮"
    },
    {
      "n": 8,
      "text": "静置一小时让糖浆吸透，撒柠檬皮屑。，火要均匀，食材才不糊。",
      "time_min": 62,
      "heat": "无火",
      "tip": "凉透再切，切口才整齐。，看住火，别让它失控。",
      "visual_cue": "切面湿润，糖浆沉底"
    }
  ],
  "tips": [
    "糖浆和蛋糕都要热，才吸得透。，这点要注意。",
    "静置一小时再切，切口才整齐。，这是关键点。",
    "别画圈拌面糊，起筋发硬。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "糖浆放凉再浇，全浮在表面。，这一步别省。",
    "烤过头，吸不进糖浆。，别跳过这步。",
    "热着就切，蛋糕碎成块。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "牛奶",
      "ratio": "150 克:150 毫升",
      "note": "口感稍薄，油可减十毫升。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "40 克:50 克",
      "note": "香气变淡，糖浆更清。"
    }
  ],
  "variations": [
    "表面撒椰蓉，口感更丰富。，很多人在这里出错。",
    "糖浆里加几片橙皮，香气更亮。，这里最容易翻车。"
  ],
  "serving_suggestion": "切方块配红茶，凉了更好吃。，别小看这一步。",
  "storage": "冷藏三天，密封防干。，成败就在这一步。",
