  "锅",
  "刮刀"
 ],
 "steps": [
  {
   "n": 1,
   "text": "鸡蛋加一百克白糖，打到颜色发白发稠。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "无火",
   "tip": "打到落痕能停留两秒。，火候要稳，别忽大忽小。",
   "visual_cue": "蛋糊泛白，体积膨胀"
  },
  {
   "n": 2,
   "text": "加酸奶和橄榄油，搅到完全融合。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "油别一次倒，慢慢拌才不吃水。，火候要稳，别忽大忽小。",
   "visual_cue": "糊体顺滑，无油花，这一点很关键。"
  },
  {
   "n": 3,
   "text": "筛入面粉，翻拌到看不见干粉。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "别画圈拌，起筋蛋糕就硬。，火候要稳，别忽大忽小。",
   "visual_cue": "糊体厚实，无干粉，这一点很关键。"
  },
  {
   "n": 4,
   "text": "模具抹黄油撒薄粉，倒入面糊抹平。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "模具处理干净，脱模才完整。，火候要稳，别忽大忽小。",
   "visual_cue": "表面平整，无大气泡"
  },
  {
   "n": 5,
   "text": "烤箱一百八十度烤三十分钟，表面金黄。，火候要稳，别忽大忽小。",
   "time_min": 32,
   "heat": "无火",
   "tip": "牙签插入不粘糊就出炉。，火候要稳，别忽大忽小。",
   "visual_cue": "表面金黄，中心回弹"
  },
  {
   "n": 6,
   "text": "另起锅放清水、剩余白糖、蜂蜜和柠檬汁煮开。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "中火",
   "tip": "糖浆煮到微稠就关火。，火候要稳，别忽大忽小。",
   "visual_cue": "糖浆清亮，微挂勺，这一点很关键。"
  },
  {
   "n": 7,
   "text": "蛋糕趁热切块，把温热糖浆慢慢浇上去。，火候要稳，别忽大忽小。",
   "time_min": 5,
   "heat": "无火",
   "tip": "热的浇热的，糖浆才吸得进去。，火候要稳，别忽大忽小。",
   "visual_cue": "糖浆渗入，表面发亮"
  },
  {
   "n": 8,
   "text": "静置一小时让糖浆吸透，撒柠檬皮屑。，火候要稳，别忽大忽小。",
   "time_min": 62,
   "heat": "无火",
   "tip": "凉透再切，切口才整齐。，火候要稳，别忽大忽小。",
   "visual_cue": "切面湿润，糖浆沉底"
  }
 ],
 "tips": [
  "糖浆和蛋糕都要热，才吸得透。，这一点很关键。",
  "静置一小时再切，切口才整齐。，这一点很关键。",
  "别画圈拌面糊，起筋发硬。，这一点很关键。"
 ],
 "common_mistakes": [
  "糖浆放凉再浇，全浮在表面。，这一点很关键。",
  "烤过头，吸不进糖浆。，这一点很关键。",
  "热着就切，蛋糕碎成块。，这一点很关键。"
 ],
 "substitutions": [
