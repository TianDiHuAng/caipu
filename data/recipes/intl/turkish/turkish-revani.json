  }
 ],
 "variations": [
  "表面撒椰蓉，口感更丰富。，这一点很关键。",
  "糖浆里加几片橙皮，香气更亮。，这一点很关键。"
 ],
 "serving_suggestion": "切方块配红茶，凉了更好吃。，这一点很关键。",
 "storage": "冷藏三天，密封防干。，这一点很关键。",
