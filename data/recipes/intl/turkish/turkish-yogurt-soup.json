    "total_min": 50
  },
  "servings": 4,
  "flavor": [
    "sour",
    "savory",
    "herbal"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 400,
          "unit": "g",
          "note": "室温",
          "optional": false
        },
        {
          "name": "大米",
          "name_en": "rice",
          "amount": 60,
          "unit": "g",
          "note": "洗净",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 20,
          "unit": "g",
          "note": "稳定酸奶",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 1,
          "unit": "piece",
          "note": "取蛋黄",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 25,
          "unit": "g",
          "note": "爆香",
          "optional": false
        },
        {
          "name": "薄荷",
          "name_en": "mint",
          "amount": 6,
          "unit": "g",
          "note": "干薄荷碎",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1200,
          "unit": "ml",
          "note": "煮汤",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "打蛋器",
    "小碗",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米洗净后加八百毫升清水，中火煮十五分钟到米粒开花。",
      "time_min": 20,
      "heat": "中火",
      "tip": "大米先煮到开花，汤才带自然稠度。",
      "visual_cue": "米粒开花，汤色发白"
    },
    {
      "n": 2,
      "text": "酸奶放到室温回温，加面粉和鸡蛋黄用打蛋器搅到顺滑无颗粒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酸奶必须回温，冰冷下锅必结块。",
      "visual_cue": "酸奶糊顺滑，无小疙瘩"
    },
    {
      "n": 3,
      "text": "舀两大勺热米汤慢慢淋进酸奶糊里，边淋边快速搅匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "这叫回温调稀，让酸奶先适应温度。",
      "visual_cue": "酸奶糊变温，质地均匀"
    },
    {
      "n": 4,
      "text": "把调好的酸奶糊倒回汤锅，小火加热并持续搅拌。",
      "time_min": 8,
      "heat": "小火",
      "tip": "全程小火不停搅，一停就可能结块。",
      "visual_cue": "汤体变稠，表面微微冒泡"
    },
    {
      "n": 5,
      "text": "加盐调味，保持小火再煮三分钟，汤汁变得浓稠顺滑。",
      "time_min": 4,
      "heat": "小火",
      "tip": "汤微沸就够，煮滚会让酸奶分层。",
      "visual_cue": "汤浓稠挂勺，没有颗粒"
    },
    {
      "n": 6,
      "text": "小锅化开黄油，下干薄荷碎用小火炸出浓郁香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "薄荷一下锅就关火，炸久了会发黑。",
      "visual_cue": "黄油浮起，薄荷飘香"
    },
    {
      "n": 7,
      "text": "盛碗后把薄荷黄油淋在汤面上，趁热食用风味最好。",
      "time_min": 2,
      "heat": "无火",
      "tip": "淋在表面不搅开，香气最有层次。",
      "visual_cue": "汤面浮一层金黄油花"
    }
  ],
  "tips": [
    "酸奶务必回温，冰冷下锅一定会结块。",
    "先用热汤把酸奶调稀，再倒回锅里最稳妥。",
    "全程小火并不断搅拌，汤才不会分离。"
  ],
  "common_mistakes": [
    "酸奶从冰箱拿出来直接倒进热汤，瞬间结块。",
    "用大火煮开，酸奶蛋白质分离变成絮状。",
    "薄荷黄油用大火炸，几秒钟就发黑发苦。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "酸奶油",
      "ratio": "400 克:350 克",
      "note": "更浓稠，需多加两百毫升水。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "25 克:20 毫升",
      "note": "风味更清爽。"
    }
  ],
  "variations": [
    "汤里加几颗小肉丸，做成更饱腹的版本。",
    "最后撒少许甜椒粉，颜色更红亮。"
  ],
  "serving_suggestion": "配热面包和一小碟橄榄同吃，是土耳其家庭和学校食堂最常见的一道暖胃汤。",
  "storage": "冷藏两天，复热必须小火慢加热并不停搅拌，切勿大火煮沸。",
