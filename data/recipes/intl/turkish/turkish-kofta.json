    "烤签",
    "平底锅",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱擦成泥后挤掉汁水，与牛肉末、蛋清、泡软挤干的面包一起放进大碗。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱汁挤掉，肉丸才不散。",
      "visual_cue": "肉馅黏稠、洋葱成泥"
    },
    {
      "n": 2,
      "text": "加蒜末、欧芹碎、孜然、辣椒粉、盐与黑胡椒，顺一个方向搅到起胶。",
      "time_min": 5,
      "heat": "无火",
      "tip": "搅到发黏上劲，口感才弹。",
      "visual_cue": "肉馅发亮、能拉出丝"
    },
    {
      "n": 3,
      "text": "肉馅冷藏十分钟后分成十二份，搓成椭圆压扁，串在烤签上整形成长条。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压扁贴签，受热更均匀。",
      "visual_cue": "肉条厚薄一致、贴合烤签"
    },
    {
      "n": 4,
      "text": "平底锅倒植物油中火烧热，肉丸每面煎三分钟至表面焦褐、内部熟透。",
      "time_min": 6,
      "heat": "中火",
      "tip": "别频繁翻动，焦壳才成型。",
      "visual_cue": "表面焦褐、按压有弹性"
    }
  ],
  "tips": [
    "洋葱擦泥后挤干汁水，多余水分会让肉丸在锅里散开。",
    "肉馅要顺一个方向搅到起胶，烤出来才有弹性。",
    "整形时压扁贴紧烤签，受热均匀才不会外焦里生。"
  ],
  "common_mistakes": [
    "肉馅没上劲就下锅，一煎就散成肉末。",
    "火太大又不翻面，外面焦黑里面还是生的。",
    "肉丸做得太厚，中心始终熟不透，切开还是粉色。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "羊肉末",
      "ratio": "450g 对 450g",
      "note": "香气更浓，孜然可减半。"
    },
    {
      "original": "面包",
      "substitute": "面包糠",
      "ratio": "40g 对 30g",
      "note": "吸水性更强。"
    }
  ],
  "variations": [
    "酸奶版：配 200g 酸奶与烤饼一起上桌。",
    "番茄版：煎好后加 200g 番茄膏酱汁焖五分钟。"
  ],
  "serving_suggestion": "配皮塔饼、番茄片、洋葱丝与酸奶酱，卷起来吃。",
  "storage": "冷藏可存 2 天，冷冻 1 个月，复热用平底锅小火煎 4 分钟。",
