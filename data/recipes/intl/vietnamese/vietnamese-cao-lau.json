  "equipment": [
    "炖锅",
    "汤锅",
    "刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩切三厘米块，冷水下锅焯五分钟去血水后洗净。",
      "time_min": 8,
      "heat": "中火",
      "tip": "焯水后要用温水冲，冷水冲会让肉紧缩。",
      "visual_cue": "肉块表面干净，汤水清"
    },
    {
      "n": 2,
      "text": "锅里下植物油炒香洋葱末与蒜末，加白糖炒到融化变褐。",
      "time_min": 6,
      "heat": "中火",
      "tip": "糖色炒到琥珀色就下肉，再深就发苦。",
      "visual_cue": "糖色琥珀，锅中起泡"
    },
    {
      "n": 3,
      "text": "放入牛腩块中火翻炒到表面均匀上色，再淋生抽炒匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "上色均匀后再加汤，颜色才漂亮。",
      "visual_cue": "肉块均匀裹上酱色"
    },
    {
      "n": 4,
      "text": "倒入高汤煮开，转小火加盖炖五十分钟至牛腩软嫩。",
      "time_min": 52,
      "heat": "小火",
      "tip": "保持微沸，汤面只冒小泡最合适。",
      "visual_cue": "牛腩能被筷子轻松插入"
    },
    {
      "n": 5,
      "text": "另起锅烧水，粗米粉下锅烫一分半钟至软化，捞出过冷水。",
      "time_min": 4,
      "heat": "大火",
      "tip": "米粉只要烫软就捞，过冷水才弹牙。",
      "visual_cue": "米粉柔韧，拉扯有弹性"
    },
    {
      "n": 6,
      "text": "豆芽用同一锅沸水焯二十秒，捞出后摊开彻底沥干。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆芽焯久会失去脆感，二十秒足够。",
      "visual_cue": "豆芽挺立，颜色透亮"
    },
    {
      "n": 7,
      "text": "碗底铺生菜丝与豆芽，放上米粉，浇两大勺牛腩与汤汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汤只浇两大勺，多了会泡软米粉。",
      "visual_cue": "碗中层次分明，汤色棕亮"
    },
    {
      "n": 8,
      "text": "鱼露加青柠汁和小米辣调成蘸汁，撒香菜碎，拌开吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌之前先淋两勺蘸汁，酸香才立起来。",
      "visual_cue": "汁水清亮，香气复杂"
    }
  ],
  "tips": [
    "牛腩炖到能用筷子插透就停，久炖会散。",
    "米粉选粗圆型，细米粉挂不住汤汁。",
    "正宗会安版本会用当地井水，家里做不必强求。"
  ],
  "common_mistakes": [
    "米粉烫太久，拌开全断成一截截。",
    "糖色炒过头变黑，整锅带明显苦味。",
    "汤浇太多，米粉吸满水失去弹性。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "猪五花",
      "ratio": "600 克:600 克",
      "note": "更油润，炖制时间缩短十五分钟。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽加柠檬汁",
      "ratio": "15 毫升:20 毫升加 5 毫升柠檬汁",
      "note": "酸咸接近，鲜味稍弱。"
    }
  ],
  "variations": [
    "加炸猪皮脆片，是当地常见的加料吃法。",
    "把牛腩换成叉烧，做成更清爽的版本。"
  ],
  "serving_suggestion": "拌开后配一碟青柠辣椒汁，再点一杯越南冰咖啡。",
  "storage": "牛腩与汤冷藏三天、冷冻一个月；米粉现煮现吃，冷藏后会变硬。",
