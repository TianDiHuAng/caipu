      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 35,
          "unit": "ml",
          "note": "大火快炒",
          "optional": false
        },
        {
          "name": "鱼露",
          "name_en": "fish sauce",
          "amount": 15,
          "unit": "ml",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "洗菜用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 3,
          "unit": "g",
          "note": "一撮平衡咸味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "木铲",
    "漏盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "空心菜摘去老梗与黄叶，掐成五厘米长段，梗与叶分开放进漏盆。",
      "time_min": 8,
      "heat": "无火",
      "tip": "梗叶分开下锅，梗先炒才脆，叶子后放才绿。",
      "visual_cue": "菜段干爽，梗叶分成两堆"
    },
    {
      "n": 2,
      "text": "用清水加盐把菜段泡五分钟，再换水冲洗两遍，沥干水分。",
      "time_min": 7,
      "heat": "无火",
      "tip": "空心菜易带泥沙，盐水泡一遍再冲，泥沙才出得净。",
      "visual_cue": "水面清澈，菜段无泥"
    },
    {
      "n": 3,
      "text": "蒜拍碎后剁成粗粒，分成均等的两份，分别装碟备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "一半爆香打底，一半最后下锅留生蒜的冲劲。",
      "visual_cue": "蒜末粗粒均匀，两份分开"
    },
    {
      "n": 4,
      "text": "炒锅烧到微微冒烟，倒植物油，下第一份蒜末爆香十秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅要够热，蒜末下锅立刻出香不焦，这是这道菜的关键。",
      "visual_cue": "蒜末边缘泛黄，香气冲出"
    },
    {
      "n": 5,
      "text": "倒入菜梗，大火快速翻炒一分钟，让梗断生保持脆感。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火，锅气足才不出水，一炒软就没了口感。",
      "visual_cue": "菜梗转深绿，锅底几乎无水"
    },
    {
      "n": 6,
      "text": "放入菜叶与第二份蒜末，继续大火翻炒四十秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "叶子一塌就够，多炒十秒就发黄出水。",
      "visual_cue": "菜叶塌软，颜色油绿"
    },
    {
      "n": 7,
      "text": "沿锅边淋入鱼露，撒白糖，快速翻匀后立刻关火。",
      "time_min": 1,
      "heat": "大火",
      "tip": "鱼露最后沿锅边淋，遇热激出香味，直接倒菜上会有生腥味。",
      "visual_cue": "锅里冒出咸香白汽"
    },
    {
      "n": 8,
      "text": "盛盘时把菜梗垫底、菜叶铺上，淋上锅里的汤汁即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘底会有少量汤汁，拌饭很香，别倒掉。",
      "visual_cue": "菜色油绿，盘底微汤"
    }
  ],
  "tips": [
    "空心菜买回来当天吃最好，放一夜梗就发空，炒出来不脆。",
    "没有鱼露可用生抽加一点盐替，鲜味会差一截。",
    "喜欢吃辣可以加两个小米辣与蒜同爆香。",
    "锅小就分两次炒，一次炒太多会出汤变成煮菜。"
  ],
  "common_mistakes": [
    "火不够大就下菜，锅里出一滩绿水，口感发绵。",
    "蒜末一开始就炒到焦黑，整盘菜带苦味。",
    "菜叶菜梗一起下锅，叶子烂了梗还没熟。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "菠菜",
      "ratio": "500克:450克",
      "note": "菠菜易出水，炒制时间各减半分钟。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "15毫升:15毫升",
      "note": "咸度略低，需补一克盐。"
    }
  ],
  "variations": [
    "加一勺虾酱同炒，鲜味更浓，是越南南部的吃法。",
    "把蒜换成蒜片与红葱头片，香气更有层次。"
  ],
  "serving_suggestion": "三人份配菜，配越南米粉、烤肉或白饭都合适。",
  "storage": "现炒现吃最佳，冷藏一夜后复热会出水发黄，不建议久放。",
