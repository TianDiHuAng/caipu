    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成三厘米见方的块，冷水下锅焯三分钟去血水。",
      "time_min": 10,
      "heat": "中火",
      "tip": "冷水下锅焯，血沫才逼得干净。，注意火候。",
      "visual_cue": "浮沫浮起，肉块紧实，状态稳定"
    },
    {
      "n": 2,
      "text": "捞出的肉块用温水冲净，沥干后加一半鱼露抓匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用温水冲，肉才不突然收紧发柴。，注意火候。",
      "visual_cue": "肉块干净，表面微黏，状态稳定"
    },
    {
      "n": 3,
      "text": "鸡蛋煮熟后过冷水剥壳，用刀在蛋身划两刀方便入味。",
      "time_min": 10,
      "heat": "中火",
      "tip": "蛋上划口，炖的时候味道才进得去。，注意火候。",
      "visual_cue": "蛋壳易剥，蛋身有口，状态稳定"
    },
    {
      "n": 4,
      "text": "炖锅倒植物油烧热，下洋葱碎和蒜末炒到透明出香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透，汤汁才带自然的甜。，注意火候。",
      "visual_cue": "洋葱透明，香气浓郁，状态稳定"
    },
    {
      "n": 5,
      "text": "下肉块中火煸炒到表面微黄，加白糖炒出焦糖色。",
      "time_min": 6,
      "heat": "中火",
      "tip": "糖炒到化开裹住肉，颜色才红亮。，注意火候。",
      "visual_cue": "肉块上色，锅底泛红，状态稳定"
    },
    {
      "n": 6,
      "text": "倒入椰奶和半碗清水，加剩余鱼露和黑胡椒煮开。",
      "time_min": 4,
      "heat": "中火",
      "tip": "椰奶别大火滚，容易油水分离。，注意火候。",
      "visual_cue": "汤面微沸，颜色奶褐，状态稳定"
    },
    {
      "n": 7,
      "text": "放入鸡蛋，盖盖小火炖三十五分钟到肉软。这一步不要着急。",
      "time_min": 35,
      "heat": "小火",
      "tip": "小火慢炖，肉才软而不散。，注意火候。",
      "visual_cue": "肉块酥软，汤汁微稠，状态稳定"
    },
    {
      "n": 8,
      "text": "开盖大火收汁到浓稠挂勺，尝味后补鱼露。这一步不要着急。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "汁收到能挂住肉块就好，太干会咸。，注意火候。",
      "visual_cue": "汁亮挂勺，表面油润，状态稳定"
    }
  ],
  "tips": [
    "五花肉冷水焯水，血沫才逼得干净。，值得留意。",
    "白糖炒出焦糖色，成品才红亮好看。，值得留意。",
    "小火慢炖三十五分钟后肉才酥软。，值得留意。"
  ],
  "common_mistakes": [
    "肉热水下锅焯，外层收紧里面还带血。，务必避免。",
    "椰奶大火滚开，汤汁分层看着发花。，务必避免。",
    "收汁不收透，汤汁稀得像汤。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "梅花肉",
      "ratio": "700 克:700 克",
      "note": "脂肪少些，炖制时间加五分钟。"
    },
    {
      "original": "椰奶",
      "substitute": "清水",
      "ratio": "250 毫升:250 毫升",
      "note": "更清爽，白糖可加五克。"
    }
  ],
  "variations": [
    "加一颗切开的椰子水同炖，香气更清甜。",
    "配腌黄瓜一起吃，解腻刚好。，也很受欢迎。"
  ],
  "serving_suggestion": "浇在白米饭上，连蛋带肉一起拌着吃最香。，效果更稳定。",
  "storage": "冷藏两天，复热小火加少量水煮开。，效果更稳定。",
