  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛油果",
          "name_en": "avocado",
          "amount": 300,
          "unit": "g",
          "note": "取熟果肉",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 300,
          "unit": "ml",
          "note": "冷藏的",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "炼乳",
          "name_en": "condensed milk",
          "amount": 45,
          "unit": "g",
          "note": "增甜增稠",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 8,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提甜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "破壁机",
    "量杯",
    "长勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛油果从中间剖开去核，用勺子挖出果肉放进破壁机杯，弃掉褐色筋膜。",
      "time_min": 6,
      "heat": "无火",
      "tip": "贴皮的褐色部分带苦味，要刮干净。这一步别省，成品口感差别很明显。",
      "visual_cue": "果肉翠绿，无黑斑，锅里状态一目了然。"
    },
    {
      "n": 2,
      "text": "倒入冷藏牛奶三百毫升，加炼乳和细砂糖，再放一小撮盐提甜。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐只要一小撮，能把奶香顶出来。火候和顺序都要留神，别图快。",
      "visual_cue": "液体没过果肉，颜色和形态变化清楚。"
    },
    {
      "n": 3,
      "text": "破壁机先低速十秒打碎，再转高速四十秒打至完全顺滑无颗粒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "中途停一次刮杯壁，底部才不留块。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "浆体细腻，无果粒，锅里状态一目了然。"
    },
    {
      "n": 4,
      "text": "开盖尝一口甜度，按口味补少量炼乳或牛奶，再高速打十秒混匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "甜度要略高于平口感受，冰镇后会更淡。",
      "visual_cue": "甜味圆润，稠度能挂勺"
    },
    {
      "n": 5,
      "text": "把奶昔倒入高玻璃杯，轻震两下让表面气泡散开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "震杯让气泡上浮，入口更顺。火候和顺序都要留神，别图快。",
      "visual_cue": "表面平整，无大气孔，锅里状态一目了然。"
    },
    {
      "n": 6,
      "text": "表面淋一小圈炼乳，撒几粒盐，插上粗吸管立即上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "喝前用吸管搅两下，纹路会自然融合。",
      "visual_cue": "奶纹清晰，杯壁挂浆，颜色和形态变化清楚。"
    }
  ],
  "tips": [
    "牛油果要挑外皮发黑、轻按微软的，硬果打出来发涩带生味。",
    "牛奶提前冷藏，冰凉的液体打出来的奶昔才细滑不起泡。",
    "炼乳最后十秒再加，长时间高速搅拌会让奶香变闷。"
  ],
  "common_mistakes": [
    "用没熟的青皮果，打完满口涩味，加多少糖都盖不住。",
    "牛奶常温直接倒进去，奶昔稀薄分层，喝起来像糊。",
    "一次打太多放着等，五分钟后就氧化发暗，颜色难看。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "300毫升:300毫升",
      "note": "椰香更浓，糖可减两克。"
    },
    {
      "original": "炼乳",
      "substitute": "蜂蜜",
      "ratio": "45克:35克",
      "note": "甜度接近，液体更稀，牛奶减三十毫升。"
    }
  ],
  "variations": [
    "加一球香草冰淇淋同打，口感更像甜品店的浓稠版，适合当下午茶。",
    "撒一层烤香的椰丝和碎花生，喝起来带颗粒感，越南街边摊常用这招。"
  ],
  "serving_suggestion": "倒入高玻璃杯，插一根粗吸管，表面点几粒盐和一层炼乳纹路。",
  "storage": "现打现喝最好，冷藏不要超过四小时，久放会氧化发暗并分层。",
