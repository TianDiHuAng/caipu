  "steps": [
    {
      "n": 1,
      "text": "胡萝卜丝加白醋、白糖与少许盐抓匀，静置十五分钟做成酸甜腌菜。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌到出水的胡萝卜丝才脆爽，汁水别倒掉。",
      "visual_cue": "胡萝卜丝变软，碗底有粉色汁水"
    },
    {
      "n": 2,
      "text": "法棍横向剖开但不切断，放入烤箱一百六十度烤三分钟至外壳酥脆。",
      "time_min": 3,
      "heat": "无火",
      "tip": "烤一下外壳才不韧，咬下去有脆响。",
      "visual_cue": "面包外壳干爽，内里仍柔软"
    },
    {
      "n": 3,
      "text": "平底锅下植物油，把鸡蛋煎成蛋黄半凝的荷包蛋。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蛋黄留一点流动最好吃，全熟也可以。",
      "visual_cue": "蛋白定型，蛋黄表面微亮"
    },
    {
      "n": 4,
      "text": "面包内侧抹一层蛋黄酱与少量鱼露，让调味渗进面包组织。",
      "time_min": 2,
      "heat": "无火",
      "tip": "鱼露少放即可，多了会压住其他味道。",
      "visual_cue": "内面湿润，闻得到淡淡酱香"
    },
    {
      "n": 5,
      "text": "依次铺火腿片、煎蛋、黄瓜条与腌好的胡萝卜丝。",
      "time_min": 4,
      "heat": "无火",
      "tip": "食材分层摆放，咬下去口感才丰富。",
      "visual_cue": "馅料饱满，颜色分层清楚"
    },
    {
      "n": 6,
      "text": "撒香菜段与小米椒圈，合上面包轻压定型后切半。",
      "time_min": 3,
      "heat": "无火",
      "tip": "合上后压一下让馅料贴合，切时不散。",
      "visual_cue": "切面层次分明，不流汁"
    }
  ],
  "tips": [
    "面包选外壳脆、内里软的短法棍，长棍会太韧。",
    "腌菜可提前做好冷藏，风味更足也更省时。",
    "不爱香菜可以换成薄荷叶，香气同样清亮。"
  ],
  "common_mistakes": [
    "面包没烤直接夹，外壳韧得咬不断。",
    "腌菜时间不足，胡萝卜丝生硬且没酸甜味。",
    "馅料塞得太满，一咬就全掉出来。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "烤猪肉",
      "ratio": "120 克:120 克",
      "note": "切薄片，香气更浓更接近街头版。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "黄油",
      "ratio": "40 克:30 克",
      "note": "奶香更足，但少了酸味层次。"
    }
  ],
  "variations": [
    "把火腿换成煎牛肉片，做成牛肉法棍。",
    "加一片猪肝酱，是西贡老派的做法。"
  ],
  "serving_suggestion": "切半后用油纸包住下半段，配一杯冰咖啡。",
  "storage": "现做现吃最佳；冷藏一天后面包会回软，建议复烤三分钟。",
