  "steps": [
    {
      "n": 1,
      "text": "虾仁挑掉背上的黑色肠线，用清水冲净后沥干水分备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "虾线不挑会影响口感，也会带一点土腥味。",
      "visual_cue": "虾仁干净，表面微亮，状态稳定"
    },
    {
      "n": 2,
      "text": "汤锅烧开水，下虾仁烫到卷曲变白后立刻捞出。",
      "time_min": 4,
      "heat": "大火",
      "tip": "虾仁一变白就捞，多烫十秒肉质就发柴。",
      "visual_cue": "虾仁卷曲，颜色粉白"
    },
    {
      "n": 3,
      "text": "捞出的虾仁放进冰水浸凉，让肉质收紧更有弹性。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冰水一激，虾仁口感才爽脆不软。，注意火候。",
      "visual_cue": "虾仁冰透，质地紧实，状态稳定"
    },
    {
      "n": 4,
      "text": "胡萝卜和洋葱切成细丝，洋葱丝用冷水泡五分钟去辛辣。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱泡水后辛辣减轻，吃起来更清甜。",
      "visual_cue": "菜丝细匀，洋葱不呛，状态稳定"
    },
    {
      "n": 5,
      "text": "小碗里挤入柠檬汁，加鱼露、白糖、蒜末和小米辣搅匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先尝一次酸甜咸比例，再决定要不要补糖。",
      "visual_cue": "酱汁清亮，酸香扑鼻，状态稳定"
    },
    {
      "n": 6,
      "text": "大碗放虾仁、胡萝卜丝和洋葱丝，倒入酱汁轻轻拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用两把勺子从底部翻拌，虾仁才不被压碎。",
      "visual_cue": "食材裹汁，颜色鲜亮，状态稳定"
    },
    {
      "n": 7,
      "text": "撒上香菜段和烤香的花生碎，装盘后马上上桌食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "花生最后撒，脆感才不会被酱汁泡软。",
      "visual_cue": "花生碎匀，香菜翠绿，状态稳定"
    }
  ],
  "tips": [
    "虾仁烫到卷曲变白就捞，久了口感发柴。",
    "冰水浸泡让虾仁紧实，咬起来更爽脆有弹性。",
    "酱汁先尝后拌，酸辣咸才够平衡。，值得留意。"
  ],
  "common_mistakes": [
    "虾仁煮过头，嚼起来像橡皮一样韧。，务必避免。",
    "洋葱不泡水直接拌，辣味盖过虾仁的甜，务必避免。",
    "花生早撒，泡软后整盘失去脆感。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鱿鱼",
      "ratio": "500 克:450 克",
      "note": "烫四十秒即可，口感更弹牙。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "60 克:60 克",
      "note": "酸香更清透，用量可减十克。"
    }
  ],
  "variations": [
    "加一把粉丝同拌，吃起来更顶饱。，也很受欢迎。",
    "放几片薄荷叶，清凉感更明显。，也很受欢迎。"
  ],
  "serving_suggestion": "装盘后配米饼或直接当开胃菜吃，酸辣很开胃。",
  "storage": "冷藏一天，食用前补挤少许柠檬汁提味。，效果更稳定。",
