  "equipment": [
    "汤锅",
    "大拌菜盆",
    "刨丝器",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉冷水下锅，水开后转小火浸煮十二分钟，关火再焖三分钟。",
      "time_min": 16,
      "heat": "小火",
      "tip": "小火浸煮鸡肉纤维不紧缩，肉丝更嫩不柴。",
      "visual_cue": "鸡肉中心变白不透明、按压有弹性"
    },
    {
      "n": 2,
      "text": "捞出鸡肉放凉，顺着纹理撕成手指粗的细丝，不要用刀切。",
      "time_min": 6,
      "heat": "无火",
      "tip": "手撕断面毛糙更易挂汁，刀切则滑不留味。",
      "visual_cue": "肉丝纤维分明、粗细均匀"
    },
    {
      "n": 3,
      "text": "卷心菜与胡萝卜分别刨成极细的丝，泡冰水十分钟后沥干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冰水泡过的菜丝更脆，沥干越彻底越不出水。",
      "visual_cue": "菜丝挺立透亮、无积水"
    },
    {
      "n": 4,
      "text": "鱼露、青柠汁、白糖、大蒜末与清水调成酸甜汁，搅到糖完全化开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先尝一口，酸甜咸三者要均衡，缺什么补什么。",
      "visual_cue": "汁水清亮、尝起来酸甜开胃"
    },
    {
      "n": 5,
      "text": "大盆里放菜丝、鸡丝、薄荷与香菜，淋入调味汁轻轻抓拌均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌的时候从下往上翻，压太实菜丝会出水变塌。",
      "visual_cue": "菜丝均匀裹汁、体积蓬松"
    },
    {
      "n": 6,
      "text": "装盘后撒上压碎的花生与红辣椒丝，最后挤几滴青柠汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "花生最后撒，早拌会吸汁变软失去脆感。",
      "visual_cue": "花生碎金黄酥脆、色彩层次分明"
    }
  ],
  "tips": [
    "菜丝一定要切得细，粗细直接影响入口的爽脆感。",
    "调味汁可按三酸二甜一咸的比例记，容易复现。",
    "上桌前再拌，拌早了菜叶出水，成品汤汤水水。"
  ],
  "common_mistakes": [
    "鸡胸大火滚煮，肉纤维收紧，撕出的丝又干又柴。",
    "卷心菜没沥干就拌，盘底积一层水，味道被冲淡。",
    "花生提前拌入，吸汁后发软，失去酥脆的点睛作用。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "300g 对 300g",
      "note": "鸡腿更香嫩，煮的时间延长三分钟。"
    },
    {
      "original": "卷心菜",
      "substitute": "生菜",
      "ratio": "300g 对 250g",
      "note": "生菜更嫩但易出水，需最后拌入。"
    }
  ],
  "variations": [
    "加入青芒果丝与炸红葱头，做成越南南部的酸甜鸡丝沙拉。",
    "以虾代替鸡肉，做成越式虾仁凉拌，鲜味更清爽。"
  ],
  "serving_suggestion": "装盘后配虾片或米纸同吃，作为越南餐的前菜。",
  "storage": "冷藏不超过一天，调味汁单独存放，食用前再拌。",
