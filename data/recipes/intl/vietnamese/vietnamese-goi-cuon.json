  "steps": [
    {
      "n": 1,
      "text": "虾仁用沸水煮两分钟至通体变红，捞出过凉水后对半片开。",
      "time_min": 5,
      "heat": "大火",
      "tip": "虾仁煮到卷曲即可，久煮会发硬。",
      "visual_cue": "虾仁卷曲发红，肉质紧实"
    },
    {
      "n": 2,
      "text": "米粉用温水泡软后煮三分钟，捞出过凉水沥干备用。",
      "time_min": 5,
      "heat": "中火",
      "tip": "米粉要沥得很干，湿的会把春卷皮泡破。",
      "visual_cue": "米粉柔软顺滑，根根不粘连"
    },
    {
      "n": 3,
      "text": "鱼露、青柠汁、白糖、蒜末与小米辣圈调成酸甜蘸汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先尝一口，酸甜咸要平衡，太咸可加青柠汁。",
      "visual_cue": "蘸汁清澈，浮着辣椒圈"
    },
    {
      "n": 4,
      "text": "春卷皮在温水里浸泡五秒，变软后立刻平铺在湿布上。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡太久春卷皮会软烂破裂，五秒足够。",
      "visual_cue": "春卷皮柔软有韧性，透光"
    },
    {
      "n": 5,
      "text": "春卷皮下三分之一处铺生菜、米粉、黄瓜条、胡萝卜丝与薄荷香菜。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蔬菜别铺太满，留出边缘方便卷紧。",
      "visual_cue": "馅料成一条，四周留白"
    },
    {
      "n": 6,
      "text": "靠近馅料一侧折起，两侧向中间对折，再顺势卷紧成卷。",
      "time_min": 6,
      "heat": "无火",
      "tip": "卷的时候稍微用力，卷太松切开就散。",
      "visual_cue": "春卷紧实，春卷皮透出绿色"
    },
    {
      "n": 7,
      "text": "最后一层放虾仁片，卷好收口朝下摆放，切半配蘸汁上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "虾仁放外层才好看，红白绿层次分明。",
      "visual_cue": "虾仁清晰可见，切面不散"
    }
  ],
  "tips": [
    "春卷皮要用温水而非热水泡，热水会直接烫烂。",
    "馅料要沥干水分，否则春卷皮几分钟就破。",
    "卷好的春卷用湿布盖着，防止表皮风干发硬。"
  ],
  "common_mistakes": [
    "春卷皮泡太久，包的时候一碰就破。",
    "馅料放太多，卷不起来还撑破春卷皮。",
    "蘸汁只放鱼露不放青柠，咸得盖住海鲜味。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡胸肉",
      "ratio": "180 克:180 克",
      "note": "煮熟撕成细丝，口感更清爽。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "30 毫升:25 毫升",
      "note": "咸味更直接，需多加五克白糖。"
    }
  ],
  "variations": [
    "加一片烤猪肉同卷，是越南南部的常见版本。",
    "把虾换成煎香的豆腐条，做成素食春卷。"
  ],
  "serving_suggestion": "切半摆盘，配酸甜蘸汁或花生酱蘸食。",
  "storage": "现包现吃最佳；用湿布盖住冷藏不超过四小时，春卷皮会逐渐变硬。",
