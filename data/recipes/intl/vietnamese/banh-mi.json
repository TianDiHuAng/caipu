  "steps": [
    {
      "n": 1,
      "text": "胡萝卜与白萝卜切细丝，加白糖、白醋与鱼露抓匀腌十五分钟出水。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌到萝卜丝变软微透明最好。",
      "visual_cue": "萝卜丝变软、碗底有汁"
    },
    {
      "n": 2,
      "text": "猪里脊逆纹切薄片，加生抽、蒜末与少许植物油抓匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纹切，咬起来才不塞牙。",
      "visual_cue": "肉片薄而均匀、裹上酱色"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油中火烧热，肉片摊平煎至两面焦香、边缘微卷。",
      "time_min": 8,
      "heat": "中火",
      "tip": "别急着翻，定型后再动。",
      "visual_cue": "肉片焦香、边缘卷起"
    },
    {
      "n": 4,
      "text": "法棍横向剖开不切断，放进烤箱或干锅小火烘到外皮发脆。",
      "time_min": 5,
      "heat": "小火",
      "tip": "烘过的面包才不吸汁塌软。",
      "visual_cue": "外皮酥脆、内里仍软"
    },
    {
      "n": 5,
      "text": "面包内壁抹少许生抽，依次塞入肉片、腌萝卜丝、黄瓜与香菜。",
      "time_min": 5,
      "heat": "无火",
      "tip": "配料塞紧实，咬下去才有层次。",
      "visual_cue": "馅料饱满、面包合拢"
    },
    {
      "n": 6,
      "text": "最后撒小米椒圈，合上法棍稍压紧，对半切开即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "辣度按口味增减小米椒。",
      "visual_cue": "切口整齐、馅料不外溢"
    }
  ],
  "tips": [
    "萝卜丝提前腌出水，酸脆的口感是三明治的灵魂。",
    "法棍一定要烘脆，否则馅料汁水一泡就塌。",
    "肉片逆纹切薄，煎后依然柔嫩不柴。"
  ],
  "common_mistakes": [
    "法棍不烘直接夹，吃到一半整只塌软流汁。",
    "肉片顺纹切厚片，咬起来又韧又塞牙。",
    "萝卜丝现切现夹，出水后把面包泡软。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡腿肉",
      "ratio": "200g 对 200g",
      "note": "更油润，煎制时间加 2 分钟。"
    },
    {
      "original": "法棍",
      "substitute": "短棍面包",
      "ratio": "200g 对 200g",
      "note": "外皮更硬，须多烘两分钟。"
    }
  ],
  "variations": [
    "烤肉版：肉片改用炭火烤，刷一层蜂蜜生抽。",
    "素食版：肉换成 150g 煎老豆腐与 50g 香菇。"
  ],
  "serving_suggestion": "对半切开装盘，配一杯越南冰咖啡。",
  "storage": "现做现吃，冷藏后面包会返潮，不建议存放。",
