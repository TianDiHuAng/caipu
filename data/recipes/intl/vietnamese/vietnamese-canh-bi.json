  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜去皮去籽，切成三厘米见方的块，虾仁挑掉背上的泥线洗净。",
      "time_min": 10,
      "heat": "无火",
      "tip": "块别切太小，煮久了容易散成泥。，注意火候。",
      "visual_cue": "南瓜成块，虾仁干净，状态稳定"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油烧热，下蒜末和拍扁的香茅小火炒香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香茅拍扁再炒，香气才出得来。，注意火候。",
      "visual_cue": "香气冲鼻，蒜末微黄，状态稳定"
    },
    {
      "n": 3,
      "text": "倒入南瓜块翻炒两分钟，让表面裹上一层油。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先炒后煮，瓜肉更甜也不容易烂。，注意火候。",
      "visual_cue": "瓜块油亮，边缘略软，状态稳定"
    },
    {
      "n": 4,
      "text": "加清水到刚没过南瓜，大火烧开后转小火煮十二分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "煮到筷子能插透，汤才带瓜的甜味。，注意火候。",
      "visual_cue": "汤色微黄，瓜块变软，状态稳定"
    },
    {
      "n": 5,
      "text": "下虾仁煮两分钟到卷曲变红，撇掉表面浮沫。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾仁一变色就好，久煮会发柴。，注意火候。",
      "visual_cue": "虾仁卷曲，汤面清亮，状态稳定"
    },
    {
      "n": 6,
      "text": "加鱼露和盐调味，撒香菜碎后关火盛出。这一步不要着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "鱼露后放，鲜味才留得住。，注意火候。",
      "visual_cue": "咸鲜适口，汤色清亮，状态稳定"
    }
  ],
  "tips": [
    "南瓜切大块煮，汤才清亮不糊。，值得留意。",
    "香茅拍扁再下锅，香气才出得来。，值得留意。",
    "虾仁最后放，变色就可以关火。，值得留意。"
  ],
  "common_mistakes": [
    "南瓜切太小，煮完化在汤里成了糊。，务必避免。",
    "虾仁久煮，吃起来又老又柴。，务必避免。",
    "鱼露一开始就放，煮久只剩咸味。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "120 克:150 克",
      "note": "切薄片，煮三分钟。"
    },
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "650 克:600 克",
      "note": "甜味更足，盐可少放一点。"
    }
  ],
  "variations": [
    "加一小把薄荷叶，清香更明显。，也很受欢迎。",
    "用椰奶替一半水，汤更浓更南洋。，也很受欢迎。"
  ],
  "serving_suggestion": "配米饭当汤菜喝，也可以单独当轻食。，效果更稳定。",
  "storage": "冷藏两天，复热加少量水小火煮开。，效果更稳定。",
