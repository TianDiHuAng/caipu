  "steps": [
    {
      "n": 1,
      "text": "罗望子用温水泡软后抓洗出酸汁，滤掉果核只留浓稠的酸汤。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先泡再抓，酸味才出得干净。",
      "visual_cue": "汤汁浓稠、果核分离"
    },
    {
      "n": 2,
      "text": "鲈鱼切片后用一半鱼露抓匀腌八分钟，鱼片表面微微发亮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼露腌鱼，咸鲜更贴。",
      "visual_cue": "鱼片发亮、无血水"
    },
    {
      "n": 3,
      "text": "汤锅倒植物油，下蒜末小火炒香，再放番茄块炒到出汁变软。",
      "time_min": 6,
      "heat": "小火",
      "tip": "番茄炒出红油，汤色才漂亮。",
      "visual_cue": "番茄起沙、锅底见红汁"
    },
    {
      "n": 4,
      "text": "倒入清水与罗望子酸汁煮开，加白糖与剩余鱼露调出酸甜平衡。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酸味要先尝汤再定糖量。",
      "visual_cue": "汤色橙红、酸甜适口"
    },
    {
      "n": 5,
      "text": "下菠萝煮三分钟，再轻轻滑入鱼片小火煮五分钟至完全变白。",
      "time_min": 6,
      "heat": "小火",
      "tip": "鱼片别搅动，容易碎。",
      "visual_cue": "鱼片洁白、菠萝变软"
    },
    {
      "n": 6,
      "text": "关火后加豆芽、小米椒与香菜，挤入青柠汁即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "豆芽靠余温烫熟，保持脆。",
      "visual_cue": "豆芽脆生、汤面飘香菜"
    }
  ],
  "tips": [
    "罗望子汁决定酸味的骨架，青柠汁只在关火后加。",
    "鱼片入锅后不要用勺子搅，靠汤的余温把它焖熟。",
    "豆芽最后放，靠汤温烫脆，久煮就发软。"
  ],
  "common_mistakes": [
    "罗望子没滤净果核，喝汤时咬到硬块。",
    "大火滚煮鱼片，鱼肉散成碎渣，汤也浑了。",
    "青柠汁早下锅，酸味发闷还带苦。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "虾",
      "ratio": "400g 对 350g",
      "note": "煮制时间缩短到 3 分钟。"
    },
    {
      "original": "罗望子",
      "substitute": "白醋",
      "ratio": "25g 对 40ml",
      "note": "酸味更直，糖量略增。"
    }
  ],
  "variations": [
    "湄公河版：加 100g 秋葵与 50g 芋头梗。",
    "辣味版：小米椒加倍，另加 10g 辣椒酱。"
  ],
  "serving_suggestion": "盛进汤碗配白米饭，越南人习惯用汤泡饭。",
  "storage": "冷藏可存 1 天，鱼片复热后口感变差，建议只复热汤底。",
