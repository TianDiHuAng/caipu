  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆着纹理切成薄片，加一半鱼露和少许白糖抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逆纹切片，煎完才嫩不塞牙。，注意火候。",
      "visual_cue": "肉片薄匀，表面发亮，状态稳定"
    },
    {
      "n": 2,
      "text": "生菜撕成小片，黄瓜和胡萝卜切细丝一起放进大碗。",
      "time_min": 8,
      "heat": "无火",
      "tip": "菜丝切细，拌的时候才挂得住汁。，注意火候。",
      "visual_cue": "菜丝均匀，颜色鲜亮，状态稳定"
    },
    {
      "n": 3,
      "text": "青柠汁、剩余鱼露、白糖和蒜末在小碗里调成酸甜汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先尝一下再补糖，酸甜要平衡。，注意火候。",
      "visual_cue": "汁液清亮，酸甜适口，状态稳定"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到冒烟，牛里脊片下锅大火快煎四十秒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火短煎，肉片表面焦香里面还嫩。，注意火候。",
      "visual_cue": "肉片变色，边缘微焦，状态稳定"
    },
    {
      "n": 5,
      "text": "牛里脊盛出略晾一分钟，连汁一起倒进蔬菜大碗。",
      "time_min": 3,
      "heat": "无火",
      "tip": "连肉汁一起拌，味道才不浪费。，注意火候。",
      "visual_cue": "肉片湿润，汁水微积，状态稳定"
    },
    {
      "n": 6,
      "text": "淋上酸甜汁抓拌，撒薄荷叶和白芝麻后装盘。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "上桌前再拌，蔬菜才保持脆口。，注意火候。",
      "visual_cue": "颜色清爽，香气酸鲜，状态稳定"
    }
  ],
  "tips": [
    "牛里脊逆纹切薄片，煎完才嫩不塞牙。，值得留意。",
    "锅烧到冒烟再下肉，才能煎出焦香。，值得留意。",
    "上桌前再拌汁，蔬菜才保持脆口。，值得留意。"
  ],
  "common_mistakes": [
    "牛里脊顺纹切，吃起来又韧又费牙。，务必避免。",
    "肉在锅里久煎，出锅干得像柴。，务必避免。",
    "提前一小时拌汁，蔬菜出水变软。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛腩",
      "ratio": "450 克:450 克",
      "note": "筋膜多，需切得更薄。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "50 克:50 克",
      "note": "酸味更柔和，糖可减两克。"
    }
  ],
  "variations": [
    "加一小把炸红葱头，香气更足。，也很受欢迎。",
    "撒少许碎花生，口感更有层次。，也很受欢迎。"
  ],
  "serving_suggestion": "当开胃菜或配米线一起吃，酸甜清爽。，效果更稳定。",
  "storage": "冷藏半天，汁水另装，食用前再拌。，效果更稳定。",
