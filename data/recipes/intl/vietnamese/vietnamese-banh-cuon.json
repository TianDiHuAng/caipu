  "刀",
  "大碗"
 ],
 "steps": [
  {
   "n": 1,
   "text": "粘米粉加清水和少许盐调成稀浆，搅到完全没有颗粒。",
   "time_min": 8,
   "heat": "无火",
   "tip": "浆要比米汤略稠，太稀蒸不成片。，注意火候。",
   "visual_cue": "浆体顺滑，能流动，状态稳定"
  },
  {
   "n": 2,
   "text": "鸡腿肉剁成粗粒，香菇和洋葱切末备用。这一步不要着急。",
   "time_min": 10,
   "heat": "无火",
   "tip": "鸡腿丁别剁太细，吃起来才有嚼头。，注意火候。",
   "visual_cue": "鸡腿丁均匀，菜末细碎，状态稳定"
  },
  {
   "n": 3,
   "text": "炒锅倒一半植物油烧热，下洋葱末炒软后加香菇末。",
   "time_min": 4,
   "heat": "中火",
   "tip": "香菇炒出香味，馅料才不寡淡。，注意火候。",
   "visual_cue": "洋葱透明，香气浓郁，状态稳定"
  },
  {
   "n": 4,
   "text": "下鸡腿丁炒到变色，加鱼露和黑胡椒炒干盛出。这一步不要着急。",
   "time_min": 6,
   "heat": "中火",
   "tip": "馅炒干水，包进米皮里才不渗汁。，注意火候。",
   "visual_cue": "馅料松散，汁水收干，状态稳定"
  },
  {
   "n": 5,
   "text": "蒸锅烧水上汽，平盘刷油后舀一勺米浆摊成薄片。",
   "time_min": 4,
   "heat": "大火",
   "tip": "盘子刷油要匀，米皮才揭得下来。，注意火候。",
   "visual_cue": "蒸汽充足，浆面平整，状态稳定"
  },
  {
   "n": 6,
   "text": "盖盖蒸两分钟到米皮变透明鼓起，取出稍晾。这一步不要着急。",
   "time_min": 6,
   "heat": "大火",
   "tip": "米皮透亮就熟，蒸太久会发硬。，注意火候。",
   "visual_cue": "皮透明，边缘翘起，状态稳定"
  },
  {
   "n": 7,
   "text": "在米皮一侧铺上鸡腿馅和胡萝卜丝，用刮板卷成长条。",
   "time_min": 8,
   "heat": "无火",
   "tip": "趁温热卷，凉了皮就脆得卷不动。，注意火候。",
   "visual_cue": "卷体紧实，皮薄透馅，状态稳定"
  },
  {
   "n": 8,
   "text": "卷好切段摆在生菜上，配鱼露蘸汁上桌。这一步不要着急。",
   "time_min": 4,
   "heat": "无火",
   "tip": "切的时候刀沾点水，切口才利落。，注意火候。",
   "visual_cue": "切面整齐，皮透馅香，状态稳定"
  }
 ],
 "tips": [
  "米浆调到比米汤略稠，才蒸得成片。，值得留意。",
  "盘子刷油要匀，米皮才揭得完整。，值得留意。",
  "趁温热卷皮，凉了容易裂。，值得留意。"
 ],
 "common_mistakes": [
  "米浆太稀，蒸出来揭不下一整片。，务必避免。",
  "馅炒得带汁，卷的时候皮就破。，务必避免。",
  "米皮凉透再卷，一折就开裂。，务必避免。"
 ],
