  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "大碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿冷水下锅，加盐和拍扁的蒜，中火煮二十分钟。",
      "time_min": 22,
      "heat": "中火",
      "tip": "冷水下锅慢慢升温，汤才清不腥。，注意火候。",
      "visual_cue": "汤面微沸，浮沫浮起，状态稳定"
    },
    {
      "n": 2,
      "text": "撇净浮沫，捞出鸡腿晾凉后撕成粗丝，鸡汤留着备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "撇沫要撇干净，汤色才清亮。，注意火候。",
      "visual_cue": "汤清不浑，鸡肉成丝，状态稳定"
    },
    {
      "n": 3,
      "text": "干米线用温水泡二十分钟到变软有弹性。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡到能弯折不断就好，泡过头会烂。，注意火候。",
      "visual_cue": "米线柔软，折而不断，状态稳定"
    },
    {
      "n": 4,
      "text": "汤锅里的鸡汤重新烧开，加鱼露调味后保持小火。",
      "time_min": 4,
      "heat": "小火",
      "tip": "鱼露按汤量加，尝一下再补。，注意火候。",
      "visual_cue": "汤色清亮，咸鲜适口，状态稳定"
    },
    {
      "n": 5,
      "text": "另起锅烧水，米线烫四十秒捞出沥干分装四个大碗。",
      "time_min": 4,
      "heat": "大火",
      "tip": "烫一下就好，久煮米线会断。，注意火候。",
      "visual_cue": "米线滑亮，无粘连，状态稳定"
    },
    {
      "n": 6,
      "text": "碗里铺豆芽、生菜和胡萝卜丝，摆上鸡肉丝和薄荷叶。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蔬菜垫底，热汤一浇就半熟更清甜。，注意火候。",
      "visual_cue": "碗中层次分明，状态稳定"
    },
    {
      "n": 7,
      "text": "浇上滚热的鸡汤，挤入青柠汁，按口味再补鱼露。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汤要滚烫浇下去，香气才冲得出来。，注意火候。",
      "visual_cue": "汤面浮油，香气酸鲜，状态稳定"
    }
  ],
  "tips": [
    "鸡腿冷水下锅煮，汤清肉也不柴。，值得留意。",
    "米线泡软后只烫四十秒，久煮易断。，值得留意。",
    "青柠汁上桌前挤，酸香才清爽。，值得留意。"
  ],
  "common_mistakes": [
    "鸡汤大火翻滚，汤色浑浊发腥。，务必避免。",
    "米线泡太久，下锅一烫就烂成段。，务必避免。",
    "青柠早早挤进汤里，酸味变苦。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡胸肉",
      "ratio": "520 克:480 克",
      "note": "更瘦，煮制时间减五分钟。"
    },
    {
      "original": "米线",
      "substitute": "米粉",
      "ratio": "420 克:400 克",
      "note": "更细，泡的时间减五分钟。"
    }
  ],
  "variations": [
    "加几片炸过的红葱头，香气更浓。，也很受欢迎。",
    "汤里加一勺辣椒酱，吃起来更开胃。，也很受欢迎。"
  ],
  "serving_suggestion": "趁热连汤带面吃，配一碟青柠和薄荷叶同放。",
  "storage": "汤与米线分开冷藏，不超过一天。，效果更稳定。",
