      ]
    }
  ],
  "equipment": [
    "平底锅",
    "炒锅",
    "锅铲",
    "刀",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成三厘米见方的块，用厨房纸吸干表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "吸干水再煎，表皮才金黄不粘锅。，注意火候。",
      "visual_cue": "豆腐干爽，块形完整，状态稳定"
    },
    {
      "n": 2,
      "text": "平底锅倒一半植物油烧热，豆腐块平铺下锅中火煎。",
      "time_min": 5,
      "heat": "中火",
      "tip": "别急着翻，等底面结皮再动才不破。，注意火候。",
      "visual_cue": "底面金黄，边缘结实，状态稳定"
    },
    {
      "n": 3,
      "text": "煎到两面金黄后盛出，锅里留少量底油。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "两面都煎透，炖的时候才不散。，注意火候。",
      "visual_cue": "外壳金黄，声响清脆，状态稳定"
    },
    {
      "n": 4,
      "text": "下蒜末小火炒香，倒入番茄块中火炒到软烂出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒出汁，酸甜味才撑得起豆腐。，注意火候。",
      "visual_cue": "番茄成糊，汤汁泛红，状态稳定"
    },
    {
      "n": 5,
      "text": "加鱼露、白糖和半碗清水，煮开后放回豆腐块。",
      "time_min": 4,
      "heat": "中火",
      "tip": "轻轻推锅让豆腐裹汁，别用铲子翻。，注意火候。",
      "visual_cue": "豆腐裹汁，汤汁微沸，状态稳定"
    },
    {
      "n": 6,
      "text": "小火炖六分钟收汁，中途轻推锅底防粘。这一步不要着急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "汁收到浓稠挂勺，味道才进得去。，注意火候。",
      "visual_cue": "汁液浓稠，表面油亮，状态稳定"
    },
    {
      "n": 7,
      "text": "加盐调整咸淡，撒香菜碎后关火装盘。这一步不要着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香菜最后放，清香才留得住。，注意火候。",
      "visual_cue": "香气酸鲜，色泽红亮，状态稳定"
    }
  ],
  "tips": [
    "豆腐先吸干水再煎，表皮才脆不粘。，值得留意。",
    "番茄炒到出汁，酸甜味才够厚。，值得留意。",
    "炖的时候推锅底，别用铲子翻动。，值得留意。"
  ],
  "common_mistakes": [
    "豆腐带水直接下锅，油花四溅还粘底。，务必避免。",
    "番茄没炒透就加水，汤寡淡发酸。，务必避免。",
    "大火久炖，豆腐碎成一锅渣。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鱼露",
      "substitute": "酱油",
      "ratio": "25 毫升:25 毫升",
      "note": "咸味更温和，可加少许白糖。"
    },
    {
      "original": "豆腐",
      "substitute": "油豆腐",
      "ratio": "500 克:400 克",
      "note": "吸汁更足，可以省去煎的步骤。"
    }
  ],
  "variations": [
    "加一把小葱段同炖，香气更足。，也很受欢迎。",
    "放两个切半的小番茄增色，卖相更好。，也很受欢迎。"
  ],
  "serving_suggestion": "浇在热米饭上，配一碗清汤就是完整一餐。，效果更稳定。",
  "storage": "冷藏两天，复热加少量水小火煮开。，效果更稳定。",
