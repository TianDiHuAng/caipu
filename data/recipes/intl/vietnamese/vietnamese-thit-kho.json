        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 3,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 400,
          "unit": "ml",
          "note": "焖煮用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "炒锅",
    "漏勺",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切三厘米见方的块，冷水下锅焯五分钟，撇净浮沫后捞出冲净。",
      "time_min": 8,
      "heat": "中火",
      "tip": "冷水下锅才能逼出血水，热水下锅腥味锁在肉里。",
      "visual_cue": "肉块表面变白、水面浮沫撇净"
    },
    {
      "n": 2,
      "text": "炒锅放二十克白糖与少量清水，中火熬到糖液变枣红色并冒大泡。",
      "time_min": 5,
      "heat": "中火",
      "tip": "糖色到枣红立刻下肉，再熬几秒就发苦。",
      "visual_cue": "糖液枣红透亮、冒起密集大泡"
    },
    {
      "n": 3,
      "text": "倒入肉块快速翻炒，让每块都均匀裹上糖色，表面略收紧。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉块下锅前擦干水分，带水下锅会溅油。",
      "visual_cue": "肉块油亮红亮、边缘微焦"
    },
    {
      "n": 4,
      "text": "把肉转入砂锅，加椰奶、清水、鱼露、蒜末与余下白糖，液面刚没过肉。",
      "time_min": 5,
      "heat": "中火",
      "tip": "椰奶遇酸易分层，鱼露要最后沿边淋入并搅匀。",
      "visual_cue": "汤汁乳白泛褐、肉块基本被淹没"
    },
    {
      "n": 5,
      "text": "大火烧开后转最小火，盖盖焖一小时，中途翻动两次防止粘底。",
      "time_min": 62,
      "heat": "小火",
      "tip": "全程小火，滚大了椰奶会油水分离，汤汁发花。",
      "visual_cue": "汤汁微稠冒小泡、肉块能用筷子插透"
    },
    {
      "n": 6,
      "text": "放入剥壳的熟鸡蛋继续焖十五分钟，让蛋表面染上酱色。",
      "time_min": 16,
      "heat": "小火",
      "tip": "鸡蛋先用叉子扎几个小孔，更容易入味。",
      "visual_cue": "蛋表面呈浅褐色、汤汁更浓"
    },
    {
      "n": 7,
      "text": "开盖转中火收汁到浓稠挂勺，撒黑胡椒，连汁带肉盛出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "收到汤汁能薄薄裹住肉块即可，收干会发咸发黏。",
      "visual_cue": "汤汁浓稠挂勺、表面浮少量油"
    }
  ],
  "tips": [
    "选带皮五花肉，皮中胶质让汤汁自然浓稠。",
    "椰奶要用浓椰浆，稀椰水味道单薄且容易分层。",
    "隔夜再加热更好吃，肉与蛋都更入味。"
  ],
  "common_mistakes": [
    "火太大滚煮，椰奶油水分离，汤汁起絮状颗粒。",
    "糖色熬过头，整锅带焦苦味，甜味全失。",
    "鸡蛋与肉同时下锅久焖，蛋白变硬发柴。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪肩肉",
      "ratio": "700g 对 700g",
      "note": "肩肉更瘦，焖的时间缩短十分钟。"
    },
    {
      "original": "椰奶",
      "substitute": "淡奶油",
      "ratio": "300ml 对 200ml",
      "note": "奶油版本偏西式，甜香更重、香气不同。"
    }
  ],
  "variations": [
    "加入切成块的芋头同焖，做成越南南部的芋头焖猪肉。",
    "把鸡蛋换成鹌鹑蛋，做成一口一个的小蛋版本，宴客更精致。"
  ],
  "serving_suggestion": "盛入深盘，配白米饭与一碟酸黄瓜，也可夹法棍吃。",
  "storage": "冷藏三天，复热时小火慢加热并补少量清水，避免糊底。",
