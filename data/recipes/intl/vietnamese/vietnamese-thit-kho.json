          "optional": false
        },
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 300,
          "unit": "ml",
          "note": "浓椰浆更香",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "鱼露",
          "name_en": "fish sauce",
          "amount": 30,
          "unit": "ml",
          "note": "提供咸鲜",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "一半炒糖色",
