  "equipment": [
    "平底锅",
    "搅拌碗",
    "刀",
    "砧板",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "粘米粉、姜黄粉与盐放进搅拌碗，分次加清水搅成顺滑无颗粒的稀面糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "粉要一点一点加水，一次倒完容易结小疙瘩。",
      "visual_cue": "面糊顺滑流动，舀起能连成线"
    },
    {
      "n": 2,
      "text": "面糊里打入鸡蛋搅散，再倒椰奶拌匀，静置二十分钟让粉充分吸水。",
      "time_min": 20,
      "heat": "无火",
      "tip": "静置后挂锅更均匀，煎出来才薄脆不裂。",
      "visual_cue": "面糊呈淡黄色，表面细泡消散"
    },
    {
      "n": 3,
      "text": "虾仁用厨房纸吸干，热锅放少许油快速煎到变色，先盛出备用。",
      "time_min": 4,
      "heat": "中火",
      "tip": "虾仁先煎熟，后面饼皮才不用久煎而变软。",
      "visual_cue": "虾仁卷曲转红，表面微焦"
    },
    {
      "n": 4,
      "text": "平底锅烧热，用刷子刷一层薄薄的植物油，舀一勺面糊转锅摊开，摊成薄而圆的饼皮。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "锅够热再倒面糊，转得快饼皮才薄得透光。",
      "visual_cue": "饼皮边缘翘起，透出金黄色"
    },
    {
      "n": 5,
      "text": "饼皮半熟时在半边铺虾仁与豆芽，转小火盖盖焖一分钟让底部起脆壳。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "料只铺半边，方便对折，也避免饼皮承重破裂。",
      "visual_cue": "饼皮边缘卷曲，底部出现蜂窝孔"
    },
    {
      "n": 6,
      "text": "开盖把空白的半边折过去压住料，再煎一分钟到两面酥脆。",
      "time_min": 3,
      "heat": "中火",
      "tip": "折的时候用两把铲子托住，防止饼皮断成两半。",
      "visual_cue": "饼皮金黄油亮，轻按有脆响"
    },
    {
      "n": 7,
      "text": "鱼露加白糖、青柠汁与两勺清水调成蘸汁，尝过后按口味补酸或补咸。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蘸汁要酸甜平衡，酸了补糖，甜了加鱼露。",
      "visual_cue": "蘸汁清亮，浮着细密气泡"
    },
    {
      "n": 8,
      "text": "煎饼装盘，配生菜与薄荷叶，吃时撕一块包上香草蘸汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "生菜要擦干水，包起来才不湿软破皮。",
      "visual_cue": "盘面金黄配翠绿，饼皮支棱挺立"
    }
  ],
  "tips": [
    "面糊里加椰奶是南越做法，饼皮更香也更脆，用清水则皮薄更干爽。",
    "锅一定要预热到位，冷锅摊面糊必粘，饼皮撕不下来。",
    "豆芽最后铺、别炒，靠余温断生，保留脆感。",
    "一次煎一张别贪多，锅温掉下来后续几张都不脆。"
  ],
  "common_mistakes": [
    "面糊调得太稠，摊不开，饼皮厚实发韧。",
    "火太小煎，饼皮里的水分蒸发不掉，软趴趴起不了脆壳。",
    "料铺满整张饼皮再折，饼皮承不住重量，一折就裂。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "猪肉末",
      "ratio": "120克:120克",
      "note": "用绞碎的肉先炒散调味，煎制时间加一分钟。"
    },
    {
      "original": "粘米粉",
      "substitute": "面粉",
      "ratio": "150克:150克",
      "note": "皮会偏软，需多加二十毫升水调稀。"
    }
  ],
  "variations": [
    "加五十克切丝的芋头与胡萝卜，口感更丰富，也更接近越南中部的做法。",
    "把虾仁换成蘑菇片，做成素食版，蘸汁里加一勺花生碎增香。"
  ],
  "serving_suggestion": "用大盘盛放，饼皮旁堆生菜、薄荷与一小碗蘸汁，上桌后立刻动手包着吃。",
  "storage": "面糊冷藏可放一天，用前搅匀；煎好的饼当天吃完，隔夜回软，不建议复热。",
