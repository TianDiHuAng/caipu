  "刀"
 ],
 "steps": [
  {
   "n": 1,
   "text": "鸡腿去骨剁成粗粒，胡萝卜切细丝，豆芽掐掉根部。",
   "time_min": 10,
   "heat": "无火",
   "tip": "鸡腿粒别剁太细，留一点颗粒口感更好。",
   "visual_cue": "鸡腿粒松散，菜丝均匀，状态稳定"
  },
  {
   "n": 2,
   "text": "大碗里放鸡腿粒、胡萝卜丝、豆芽、蒜末、鱼露、盐和黑胡椒。",
   "time_min": 5,
   "heat": "无火",
   "tip": "顺着一个方向搅，馅料才抱团不出水。",
   "visual_cue": "馅料黏手，香味冲鼻，状态稳定"
  },
  {
   "n": 3,
   "text": "春卷皮用湿布盖着回软，一次取一张平铺在案板上。",
   "time_min": 6,
   "heat": "无火",
   "tip": "皮回软才不裂，全程盖湿布防干。，注意火候。",
   "visual_cue": "皮变软，边缘微弯，状态稳定"
  },
  {
   "n": 4,
   "text": "在皮的下三分之一处放一勺馅，先折两侧再卷成紧实的长条。",
   "time_min": 10,
   "heat": "无火",
   "tip": "卷的时候压出空气，炸的时候才不会鼓破。",
   "visual_cue": "卷体紧实，接口贴合，状态稳定"
  },
  {
   "n": 5,
   "text": "深锅倒植物油烧到一百六十度，下春卷中火炸四分钟。",
   "time_min": 6,
   "heat": "中火",
   "tip": "油温别太高，皮焦了里面还没熟。，注意火候。",
   "visual_cue": "油面细泡，卷体浮起，状态稳定"
  },
  {
   "n": 6,
   "text": "翻动春卷炸到通体金黄酥脆，捞出放厨房纸上吸油。",
   "time_min": 6,
   "heat": "中火",
   "tip": "颜色均匀浅金就要捞出，余温还会加深。",
   "visual_cue": "外壳金黄，声响清脆，状态稳定"
  },
  {
   "n": 7,
   "text": "切成两段摆在生菜叶上，配一碟鱼露蘸汁上桌。",
   "time_min": 4,
   "heat": "无火",
   "tip": "趁热切开，脆壳才不会回软。，注意火候。",
   "visual_cue": "切面整齐，馅料分明，状态稳定"
  }
 ],
 "tips": [
  "春卷皮全程盖湿布，干了就卷不紧。，值得留意。",
  "卷的时候压出空气，炸时才不鼓破。，值得留意。",
  "油温一百六十度下锅，皮酥里也熟。，值得留意。"
 ],
 "common_mistakes": [
  "馅料太湿，炸的时候皮破漏馅。，务必避免。",
  "油温太高，外面焦黑里面还是生肉。，务必避免。",
  "卷得太松，下锅一炸就散开。，务必避免。"
 ],
