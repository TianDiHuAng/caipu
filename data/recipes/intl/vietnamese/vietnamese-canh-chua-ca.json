    "砧板",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "三文鱼切成三厘米的块，撒盐抓匀腌十分钟去腥。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌出表面水分，煮的时候汤才不腥。，注意火候。",
      "visual_cue": "鱼块紧实，表面干燥，状态稳定"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油烧热，下蒜末小火炒香后加番茄块。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蒜先炒香打底，汤的底味才不单薄。，注意火候。",
      "visual_cue": "蒜末微黄，香气升起，状态稳定"
    },
    {
      "n": 3,
      "text": "番茄炒到软烂出汁，加清水烧开后转小火煮五分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄炒透了，汤色才红亮带酸。，注意火候。",
      "visual_cue": "汤色橙红，番茄软烂，状态稳定"
    },
    {
      "n": 4,
      "text": "放入菠萝块煮三分钟，让果酸和甜味融进汤里。",
      "time_min": 3,
      "heat": "中火",
      "tip": "菠萝后放，煮久了甜味会散掉。，注意火候。",
      "visual_cue": "汤面微沸，果香明显，状态稳定"
    },
    {
      "n": 5,
      "text": "轻轻放入鱼块，小火煮六分钟，中途只推锅底不翻动。",
      "time_min": 6,
      "heat": "小火",
      "tip": "鱼块易碎，用推的方式防粘底。，注意火候。",
      "visual_cue": "鱼块变白，边缘收紧，状态稳定"
    },
    {
      "n": 6,
      "text": "下豆芽煮一分钟，加鱼露和白糖调味。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "豆芽一断生就关火，久煮会发软。，注意火候。",
      "visual_cue": "豆芽脆嫩，汤色清亮，状态稳定"
    },
    {
      "n": 7,
      "text": "挤入青柠汁，撒香菜碎后关火盛出。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠离火加，酸香才清爽不涩。，注意火候。",
      "visual_cue": "香气酸鲜，汤色明亮，状态稳定"
    }
  ],
  "tips": [
    "鱼块腌十分钟，煮出来的汤才不腥。，值得留意。",
    "菠萝后放，果香和甜味才留得住。，值得留意。",
    "青柠离火再加，酸味不涩。，值得留意。"
  ],
  "common_mistakes": [
    "鱼块大火滚煮，出锅全散成碎渣。，务必避免。",
    "豆芽久煮，吃起来又软又寡淡。，务必避免。",
    "青柠早放，汤带一股涩味。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "三文鱼",
      "substitute": "鲈鱼",
      "ratio": "500 克:500 克",
      "note": "肉质更嫩，煮制时间减两分钟。"
    },
    {
      "original": "菠萝",
      "substitute": "青芒果",
      "ratio": "150 克:150 克",
      "note": "酸味更明显，白糖加五克。"
    }
  ],
  "variations": [
    "加几片秋葵同煮，汤汁更稠。，也很受欢迎。",
    "放一小把薄荷叶，香气更清爽。，也很受欢迎。"
  ],
  "serving_suggestion": "配米饭当汤菜吃，也可以单喝一碗。，效果更稳定。",
  "storage": "冷藏一天，复热小火加热避免鱼肉碎。，效果更稳定。",
