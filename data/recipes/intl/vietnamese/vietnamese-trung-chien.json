        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "碗",
    "打蛋器",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进碗里，加鱼露、白糖和黑胡椒，用打蛋器搅匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "鱼露本身很咸，先加一勺再尝味道。，注意火候。",
      "visual_cue": "蛋液均匀，颜色淡黄，状态稳定"
    },
    {
      "n": 2,
      "text": "小葱切成细葱花，取三分之二拌进蛋液里搅匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "葱花拌进蛋液，煎出来香味更均匀。，注意火候。",
      "visual_cue": "葱花细碎，分布均匀，状态稳定"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油烧到微热，转动锅让油铺满锅底。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要铺满锅底，蛋液才不会粘住。，注意火候。",
      "visual_cue": "油面微亮，铺满锅底，状态稳定"
    },
    {
      "n": 4,
      "text": "倒入蛋液，转小火让底部慢慢凝固成厚蛋饼。这一步不要着急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢煎，蛋饼才不会起大泡和焦边。",
      "visual_cue": "边缘凝固，中心微动，状态稳定"
    },
    {
      "n": 5,
      "text": "撒上剩余葱花，盖盖焖一分钟让表面也熟透。这一步不要着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "盖盖用蒸汽把表面焖熟，省得翻面破皮。",
      "visual_cue": "表面凝固，葱花翠绿，状态稳定"
    },
    {
      "n": 6,
      "text": "用铲子切成四块，翻面再煎三十秒后装盘上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "切块后翻面，受热更均匀也不易碎。，注意火候。",
      "visual_cue": "蛋块完整，两面金黄，状态稳定"
    }
  ],
  "tips": [
    "鱼露很咸，先少放再尝，避免过咸。，值得留意。",
    "全程小火慢煎，蛋饼才不会起泡焦边。，值得留意。",
    "盖盖焖一分钟，表面自然熟不用翻面。，值得留意。"
  ],
  "common_mistakes": [
    "大火煎蛋，底部焦黑而表面还是生的。，务必避免。",
    "鱼露一次倒太多，蛋饼咸得没法入口。，务必避免。",
    "不盖盖也不用小火，边缘硬得像纸。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鱼露",
      "substitute": "酱油",
      "ratio": "15 毫升:15 毫升",
      "note": "咸味更柔和，香气略淡。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "240 克:250 克",
      "note": "蛋香更浓，煎制时间加一分钟。"
    }
  ],
  "variations": [
    "加少许洋葱丝同煎，甜味更明显。，也很受欢迎。",
    "配一小碟辣椒酱蘸着吃，味道更冲。，也很受欢迎。"
  ],
  "serving_suggestion": "配热米饭和一碗清汤，是越南家庭最常见的早餐组合。",
  "storage": "冷藏一天，复热用平底锅小火两面各煎三十秒。",
