  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱、芹菜和青椒切成同样大小的丁。，保持小火，吃口才舒服。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丁切得匀，熟度才一致。，火别太大，形状才完整。",
      "visual_cue": "三色丁均匀，颗粒分明，保持小火，颜色才够亮。"
    },
    {
      "n": 2,
      "text": "虾去壳挑虾线，用厨房纸吸干水分。，先试试温度，口感才不散。",
      "time_min": 8,
      "heat": "无火",
      "tip": "吸干水，下锅才不老。，汤汁别收太干，食材才不糊。",
      "visual_cue": "虾身干爽，卷曲有形，翻动放轻，细节才到位。"
    },
    {
      "n": 3,
      "text": "炒锅化黄油，中小火炒蔬菜丁八分钟。，份量心里有数，口感才有层次。",
      "time_min": 9,
      "heat": "中火",
      "tip": "炒到洋葱透明，甜味才出。，翻动放轻，整道菜才立得住。",
      "visual_cue": "菜丁变软，锅底有褐色，别用力搅，味道才进得去。"
    },
    {
      "n": 4,
      "text": "加蒜末、红椒粉和辣椒粉炒出香味。，盖盖焖一会儿，口感才不发柴。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料遇热才出味，别炒糊。，下手别慌，颜色才够亮。",
      "visual_cue": "辣香冲鼻，油色发红，翻动放轻，口感才有层次。"
    },
    {
      "n": 5,
      "text": "撒面粉翻炒两分钟，去掉面粉的生涩味。，先试试温度，成品才稳当。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面粉要炒透，成品才不糊嘴。，别用力搅，火候才均匀。",
      "visual_cue": "粉与油抱成团，颜色变深"
    },
    {
      "n": 6,
      "text": "下番茄和番茄酱，小火煮十分钟。，盖盖焖一会儿，风味才干净。",
      "time_min": 12,
      "heat": "小火",
      "tip": "番茄煮烂，酱汁才厚。，先试试温度，吃口才舒服。",
      "visual_cue": "汁体浓稠，颜色深红，慢慢来别急，成品才好看。"
    },
    {
      "n": 7,
      "text": "下虾，小火煮五分钟到变红。，锅温要匀，口感才不发柴。",
      "time_min": 6,
      "heat": "小火",
      "tip": "虾变红就够，久煮发硬。，翻动放轻，成品才稳当。",
      "visual_cue": "虾身卷曲，颜色橘红，顺序照着来，口感才有层次。"
    },
    {
      "n": 8,
      "text": "加盐和黑胡椒调味，撒小葱出锅。，盖盖焖一会儿，咸淡才好把握。",
      "time_min": 3,
      "heat": "小火",
      "tip": "最后调味，咸淡才准。，盖盖焖一会儿，味道才不闷。",
      "visual_cue": "汤汁挂勺，葱末翠绿，留意锅底，香气才不跑。"
    }
  ],
  "tips": [
    "蔬菜丁炒到洋葱透明，甜味才出来。，手法轻些，火候才均匀。",
    "面粉要炒透，成品才没有面粉的生涩味。，时间掐准，食材才不糊。",
    "虾最后下，变红就关火。，时间掐准，香气才不跑。"
  ],
  "common_mistakes": [
    "火太大，香料炒糊发苦。，手法轻些，口感才不发柴。",
    "不炒面粉，酱汁稀得挂不住。，注意别烧干，味道才进得去。",
    "虾煮太久，肉缩成一小团。，顺序照着来，形状才完整。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鸡腿肉",
      "ratio": "600 克:600 克",
      "note": "切丁后先煎至八成熟再回锅。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "40 克:35 毫升",
      "note": "少一层奶香，需补一点盐。"
    }
  ],
  "variations": [
    "加几滴辣酱，酸辣更冲。，锅温要匀，咸淡才好把握。",
    "配米饭或玉米糊都合适。，起锅前尝味，味道才进得去。"
  ],
  "serving_suggestion": "浇在白米饭上，撒小葱。，别急着加油，整道菜才立得住。",
  "storage": "冷藏两天，复热加水稀释。，汤汁别收太干，口感才有层次。",
