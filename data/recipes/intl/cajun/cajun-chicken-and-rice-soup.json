  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成三厘米见方的块，用厨房纸吸干表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "吸干水才煎得上色，不然只会出水。",
      "visual_cue": "肉块表面干爽，大小一致"
    },
    {
      "n": 2,
      "text": "汤锅大火下橄榄油，鸡皮朝下先煎到金黄。过程中注意火候变化。",
      "time_min": 6,
      "heat": "大火",
      "tip": "先煎皮面，油脂出来汤才香。这一步别省。",
      "visual_cue": "鸡皮金黄酥脆，锅里油清亮"
    },
    {
      "n": 3,
      "text": "翻面煎两分钟，盛出鸡肉备用，留下锅里的油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "先盛出，久煮肉会柴成渣。顺序别颠倒。",
      "visual_cue": "鸡肉表面全白，锅底留焦香物"
    },
    {
      "n": 4,
      "text": "下洋葱丁与胡萝卜丁，中火炒五分钟到洋葱透明。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒透，汤的甜味才出得来。火候要盯住。",
      "visual_cue": "洋葱透明，胡萝卜油亮"
    },
    {
      "n": 5,
      "text": "加蒜末与辣椒粉炒三十秒，炒出红油香味。动作要快别拖延。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "辣椒粉遇油才出色，别炒久了发苦。",
      "visual_cue": "锅里泛红，辣香冲鼻"
    },
    {
      "n": 6,
      "text": "放番茄块炒三分钟，炒到番茄软烂出汁。随时观察锅里的状态。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒化，汤的酸味才自然。多练两次就熟。",
      "visual_cue": "番茄成糊状，汤汁微红"
    },
    {
      "n": 7,
      "text": "倒回鸡肉，加清水大火烧开后撇净浮沫。翻动要轻别弄碎。",
      "time_min": 7,
      "heat": "大火",
      "tip": "浮沫撇干净，汤色才清。细节决定成败。",
      "visual_cue": "汤面干净，肉块浮在汤里"
    },
    {
      "n": 8,
      "text": "转小火盖盖煮二十分钟，让鸡肉和香料融合。",
      "time_min": 22,
      "heat": "小火",
      "tip": "保持微沸，滚太猛肉会散。这一步别省。",
      "visual_cue": "汤色橙红，鸡肉一戳就透"
    },
    {
      "n": 9,
      "text": "倒入洗净的大米，小火再煮十五分钟至米开花。",
      "time_min": 18,
      "heat": "小火",
      "tip": "米下锅后勤搅两次，防止糊底。顺序别颠倒。",
      "visual_cue": "米粒开花，汤变浓稠"
    },
    {
      "n": 10,
      "text": "加盐与黑胡椒调味，装碗后撒少许辣椒粉点缀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后放，早放肉会发紧。火候要盯住。",
      "visual_cue": "汤稠挂勺，红汤里米粒分明"
    }
  ],
  "tips": [
    "鸡肉先煎再煮，汤里才有烤过的香气。",
    "辣椒粉要和油一起炒，红色才漂亮。",
    "大米下锅后勤搅锅底，卡真汤很容易糊。",
    "盐最后放，鸡肉才不柴不紧。多练两次就熟。"
  ],
  "common_mistakes": [
    "鸡肉直接下锅煮，汤寡淡没有焦香。",
    "大米煮过头，汤变成一锅糊。这一步别省。",
    "辣椒粉炒到发黑，整锅发苦。顺序别颠倒。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "400 克:400 克",
      "note": "更瘦，煮十五分钟就够。"
    },
    {
      "original": "辣椒粉",
      "substitute": "烟熏辣椒粉",
      "ratio": "6 克:5 克",
      "note": "烟熏味重，辣度略低。"
    }
  ],
  "variations": [
    "加几片培根同煮，烟熏味更浓。细节决定成败。",
    "出锅前挤几滴柠檬汁，鲜味更亮。"
  ],
  "serving_suggestion": "用厚壁碗装盛，配一片玉米面包或法棍，冬天一顿就够暖。",
  "storage": "冷藏两天，冷冻可放一个月，复热时加清水调稀。",
