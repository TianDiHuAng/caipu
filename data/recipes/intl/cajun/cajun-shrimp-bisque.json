  "steps": [
    {
      "n": 1,
      "text": "虾去壳留壳，虾肉挑去虾线备用。，保持小火，火候才均匀。",
      "time_min": 12,
      "heat": "无火",
      "tip": "壳要留着，汤底全靠它。，保持小火，锅气才足。",
      "visual_cue": "虾壳完整，虾肉干净，保持小火，成品才稳当。"
    },
    {
      "n": 2,
      "text": "虾壳和清水下锅，小火煮十五分钟。，顺序照着来，口感才不散。",
      "time_min": 17,
      "heat": "小火",
      "tip": "小火慢煮，鲜味才出得净。，顺序照着来，颜色才够亮。",
      "visual_cue": "汤色橙红，香气浓，别急着加油，形状才完整。"
    },
    {
      "n": 3,
      "text": "滤出虾汤，壳弃掉，汤留着。，注意别烧干，表面才漂亮。",
      "time_min": 4,
      "heat": "无火",
      "tip": "滤干净，汤才不渣。，别急着加油，口感才有层次。",
      "visual_cue": "汤体清亮，无壳屑，动作放连贯，口感才有层次。"
    },
    {
      "n": 4,
      "text": "汤锅化黄油，中火炒洋葱、芹菜和胡萝卜。，份量心里有数，成品才好看。",
      "time_min": 9,
      "heat": "中火",
      "tip": "炒到软塌，甜味才出来。，先试试温度，形状才完整。",
      "visual_cue": "菜丁发软，颜色透明，盖盖焖一会儿，香气才留得住。"
    },
    {
      "n": 5,
      "text": "加蒜末和红椒粉炒香，再下番茄酱。，翻动放轻，口感才不发柴。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄酱炒一下，颜色才红亮。，起锅前尝味，风味才干净。",
      "visual_cue": "酱色深红，油光浮动，份量心里有数，细节才到位。"
    },
    {
      "n": 6,
      "text": "撒面粉炒两分钟，倒虾汤搅散。，起锅前尝味，香气才不跑。",
      "time_min": 6,
      "heat": "中火",
      "tip": "边倒边搅，才不结块。，保持小火，细节才到位。",
      "visual_cue": "汤体顺滑，微微浓稠，下手别慌，整道菜才立得住。"
    },
    {
      "n": 7,
      "text": "小火煮十分钟，用搅拌机打成浓汤。，别急着加油，香气才留得住。",
      "time_min": 12,
      "heat": "小火",
      "tip": "分次打，热汤别装太满。，动作放连贯，成品才稳当。",
      "visual_cue": "汤体细腻，颜色橙红，下手别慌，吃口才舒服。"
    },
    {
      "n": 8,
      "text": "回锅加淡奶油，小火加热别煮沸。，手法轻些，香气才不跑。",
      "time_min": 5,
      "heat": "小火",
      "tip": "煮沸会分层，温热就够。，料别一次下太多，整道菜才立得住。",
      "visual_cue": "汤色发亮，质地柔滑，留意锅底，香气才留得住。"
    },
    {
      "n": 9,
      "text": "虾肉切小块，下汤煮三分钟，加盐和黑胡椒调味，撒小葱末。，别用力搅，味道才不闷。",
      "time_min": 5,
      "heat": "小火",
      "tip": "虾最后下，才不老。，动作放连贯，香气才不跑。",
      "visual_cue": "虾块卷曲，葱末点缀，火别太大，口感才不发柴。"
    }
  ],
  "tips": [
    "虾壳熬汤，是这道汤的底味。，下手别慌，细节才到位。",
    "打汤分次进行，热汤别装太满。，时间掐准，成品才好看。",
    "淡奶油别煮沸，否则会分层。，锅温要匀，形状才完整。"
  ],
  "common_mistakes": [
    "虾壳不熬，汤味发薄。，留意锅底，颜色才够亮。",
    "面粉不炒，汤有生粉味。，汤汁别收太干，火候才均匀。",
    "大火沸腾，奶油分离结块。，锅温要匀，细节才到位。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "150 毫升:180 毫升",
      "note": "汤更稀，面粉可加到三十克。"
    },
    {
      "original": "虾",
      "substitute": "龙虾",
      "ratio": "600 克:600 克",
      "note": "壳更多，汤底更浓，盐可减一克。"
    }
  ],
  "variations": [
    "加一点白兰地，香气更厚。，料别一次下太多，口感才不发柴。",
    "加蟹肉，做成海鲜浓汤。，顺序照着来，火候才均匀。"
  ],
  "serving_suggestion": "配烤面包片，撒小葱和黑胡椒。，慢慢来别急，口感才有层次。",
  "storage": "冷藏两天，复热需小火。，汤汁别收太干，香气才留得住。",
