  "steps": [
    {
      "n": 1,
      "text": "玉米剥下颗粒，毛豆剥壳后冲洗干净沥干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "毛豆用现剥的，口感比冷冻的脆。",
      "visual_cue": "玉米粒饱满，毛豆粒粒分明"
    },
    {
      "n": 2,
      "text": "洋葱切末，甜椒切丁，番茄也切成大小相近的小丁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "三样切成同样大小，熟度才会一致。",
      "visual_cue": "蔬菜切成均匀的小丁"
    },
    {
      "n": 3,
      "text": "炒锅放黄油小火化开，先下洋葱末炒到透明。",
      "time_min": 4,
      "heat": "小火",
      "tip": "黄油别用大火，烧焦了会带苦味。",
      "visual_cue": "洋葱透明发亮，黄油起泡"
    },
    {
      "n": 4,
      "text": "加入甜椒丁炒两分钟，再放辣椒粉和黑胡椒炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料下锅后要快炒，糊了整锅都苦。",
      "visual_cue": "香料均匀裹在蔬菜上"
    },
    {
      "n": 5,
      "text": "倒入玉米粒和毛豆翻炒三分钟，撒盐调味上色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "翻炒到位，每颗豆都裹上黄油才香。",
      "visual_cue": "颗粒油亮，颜色鲜亮"
    },
    {
      "n": 6,
      "text": "加入番茄丁和清水，盖盖小火焖五分钟至豆熟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "清水不要加多，焖到汤汁收干正好。",
      "visual_cue": "汤汁收干，豆粒软嫩"
    },
    {
      "n": 7,
      "text": "开盖转中火收干汤汁，尝味后按需要补盐出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "收汁时要勤翻动，免得锅底粘糊发苦。",
      "visual_cue": "锅底干爽，食材分明"
    }
  ],
  "tips": [
    "毛豆现剥现用，口感比冷冻的更脆。",
    "香料用油炒过，香气才释放得彻底。",
    "水别加太多，焖到收干口感最好。"
  ],
  "common_mistakes": [
    "毛豆没煮熟就出锅，豆腥味重还难嚼。",
    "香料大火干炒，糊味盖过整道菜。",
    "清水加得太多，最后煮成了一锅豆汤。"
  ],
  "substitutions": [
    {
      "original": "毛豆",
      "substitute": "青豆",
      "ratio": "200 克:200 克",
      "note": "更易熟，焖煮时间减两分钟。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "25 克:20 毫升",
      "note": "香气略减，可加蒜末增味。"
    }
  ],
  "variations": [
    "加几片熏香肠一起炒，咸鲜味道更足。",
    "撒一把葱花，颜色和香气都更活泼。"
  ],
  "serving_suggestion": "配烤鸡或炸鱼一起吃，也能当素食主菜配米饭。",
  "storage": "冷藏两天，复热时用平底锅干炒两分钟。",
