  "equipment": [
    "平底锅",
    "拌菜盆",
    "锅铲",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蟹肉拆出后用手轻挑掉碎壳，摊在厨房纸上吸干水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水分越少，饼才越容易成型。",
      "visual_cue": "蟹肉蓬松干爽，无碎壳"
    },
    {
      "n": 2,
      "text": "洋葱与芹菜切成极细的碎末，颗粒越小越好粘合。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切太粗会把饼撑散。",
      "visual_cue": "碎末细匀，不出水"
    },
    {
      "n": 3,
      "text": "蟹肉放大碗，加蛋液、蛋黄酱、洋葱芹菜碎拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用手轻拌别压，保留蟹肉的块状。",
      "visual_cue": "混合物湿润成团，仍有块"
    },
    {
      "n": 4,
      "text": "加辣椒粉、孜然、盐与小葱，挤入柠檬汁轻轻翻匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁提鲜并能压住腥味。",
      "visual_cue": "调味均匀，颜色微红"
    },
    {
      "n": 5,
      "text": "撒入面粉翻拌到能捏成团，太湿可再补一勺面粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "能捏成团不散就够了，别加太多。",
      "visual_cue": "捏一把能成形，不粘手"
    },
    {
      "n": 6,
      "text": "分成八份压成两厘米厚的圆饼，盖膜冷藏二十分钟定型。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏定型，煎的时候才不散。",
      "visual_cue": "饼形完整，边缘不塌"
    },
    {
      "n": 7,
      "text": "平底锅倒植物油中火烧热，下蟹饼煎三分钟不动。",
      "time_min": 3,
      "heat": "中火",
      "tip": "下锅别急着翻，等底面定型。",
      "visual_cue": "底面金黄，边缘有脆壳"
    },
    {
      "n": 8,
      "text": "翻面再煎三分钟，两面金黄且中心热透后盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "厚饼可盖盖焖一分钟确保热透。",
      "visual_cue": "两面金黄，按压有弹性"
    },
    {
      "n": 9,
      "text": "吸掉多余油，配柠檬角与辣味蛋黄酱一起上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃，凉了外皮会回软。",
      "visual_cue": "外壳酥脆，内里湿润"
    }
  ],
  "tips": [
    "蟹肉要吸干水分，饼才成型不散。",
    "拌料时轻手翻拌，保留蟹肉块状口感。",
    "冷藏定型二十分钟，煎的时候不散开。"
  ],
  "common_mistakes": [
    "蟹肉带水直接拌，饼下锅就散成碎。",
    "面粉加太多，吃起来全是面糊味。",
    "不停翻面，饼被翻碎还吸满了油。"
  ],
  "substitutions": [
    {
      "original": "蟹",
      "substitute": "虾仁",
      "ratio": "400 克:400 克",
      "note": "需切粗粒，口感更弹。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "60 克:60 克",
      "note": "热量更低，酸味更清爽。"
    }
  ],
  "variations": [
    "加一勺卡真调味粉，辣味更地道。",
    "表面裹一层面包糠，外皮更酥脆。"
  ],
  "serving_suggestion": "配柠檬角和蔬菜沙拉，作为主菜或前菜。",
  "storage": "冷藏两天，复热用平底锅小火两面各煎两分钟。",
