  "steps": [
    {
      "n": 1,
      "text": "洋葱、芹菜和青椒切成小丁备用。，翻动放轻，味道才进得去。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切得细些，酱才顺。，顺序照着来，风味才干净。",
      "visual_cue": "丁粒细匀，堆在案板上，料别一次下太多，口感才不散。"
    },
    {
      "n": 2,
      "text": "番茄去蒂切块，皮不用去。，注意别烧干，味道才不闷。",
      "time_min": 5,
      "heat": "无火",
      "tip": "番茄煮久会化，块可大些。，盖盖焖一会儿，吃口才舒服。",
      "visual_cue": "块形整齐，汁水渗出，份量心里有数，吃口才舒服。"
    },
    {
      "n": 3,
      "text": "炖锅化黄油，中火炒菜丁八分钟。，汤汁别收太干，颜色才够亮。",
      "time_min": 9,
      "heat": "中火",
      "tip": "炒到洋葱透明，甜味才出。，手法轻些，味道才进得去。",
      "visual_cue": "菜丁软塌，颜色变深，份量心里有数，形状才完整。"
    },
    {
      "n": 4,
      "text": "加蒜末、辣椒粉和红椒粉炒香。，留意锅底，形状才完整。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料别炒黑，会发苦。，动作放连贯，表面才漂亮。",
      "visual_cue": "油色发红，辣香升起，别用力搅，香气才留得住。"
    },
    {
      "n": 5,
      "text": "撒面粉翻炒两分钟，去掉生味。，盖盖焖一会儿，细节才到位。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面粉炒透，酱才不糊嘴。，手法轻些，食材才不糊。",
      "visual_cue": "粉油抱团，颜色微褐，别急着加油，咸淡才好把握。"
    },
    {
      "n": 6,
      "text": "倒清水搅散，煮到微微浓稠。，慢慢来别急，吃口才舒服。",
      "time_min": 6,
      "heat": "中火",
      "tip": "边倒边搅，才不结块。，料别一次下太多，成品才好看。",
      "visual_cue": "汁体顺滑，能挂勺，动作放连贯，锅气才足。"
    },
    {
      "n": 7,
      "text": "下番茄，小火煮二十分钟。，起锅前尝味，食材才不糊。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火慢煮，酸味才柔。，料别一次下太多，咸淡才好把握。",
      "visual_cue": "番茄化开，汁色深红，份量心里有数，味道才不闷。"
    },
    {
      "n": 8,
      "text": "加白醋、盐和白糖，尝味调整。，先试试温度，味道才进得去。",
      "time_min": 4,
      "heat": "小火",
      "tip": "酸甜平衡才好，别一次加足。，火别太大，颜色才够亮。",
      "visual_cue": "酸香突出，咸甜适中，先试试温度，口感才不发柴。"
    }
  ],
  "tips": [
    "面粉要炒透，酱体才不糊嘴。，火别太大，口感才有层次。",
    "白醋最后加，酸味才清。，手法轻些，香气才留得住。",
    "小火慢煮，番茄的酸才变柔。，下手别慌，香气才留得住。"
  ],
  "common_mistakes": [
    "面粉没炒透，酱有生粉味。，别用力搅，口感才有层次。",
    "火太大，锅底焦黑。，先试试温度，锅气才足。",
    "醋一次倒完，酸得发冲。，别急着加油，味道才不闷。"
  ],
  "substitutions": [
    {
      "original": "白醋",
      "substitute": "苹果醋",
      "ratio": "40 毫升:45 毫升",
      "note": "酸味更柔，白糖可减三克。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30 克:25 毫升",
      "note": "少一层奶香，辣味会更直接。"
    }
  ],
  "variations": [
    "加虾或鸡块，直接做成主菜。，料别一次下太多，味道才不闷。",
    "加辣酱，辣味更冲。，下手别慌，味道才进得去。"
  ],
  "serving_suggestion": "浇在米饭、煎鱼或蛋上。，份量心里有数，咸淡才好把握。",
  "storage": "冷藏四天，冷冻一个月。，料别一次下太多，口感才有层次。",
