  "equipment": [
    "厚底锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱、芹菜、青椒切成同样大小的丁，大蒜单独切末备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "三样切得一样大，炒的时候才会同步软。",
      "visual_cue": "丁块均匀，颜色分明"
    },
    {
      "n": 2,
      "text": "厚底锅化开四十克黄油，加面粉小火不停搅动八分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "油面糊要炒到花生酱色，火大就前功尽弃。",
      "visual_cue": "糊体棕褐，闻起来像烤坚果"
    },
    {
      "n": 3,
      "text": "一次倒入蔬菜丁，快速翻炒让油面糊裹住每一块。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油面糊遇水会结块，蔬菜先下能降温防溅。",
      "visual_cue": "蔬菜裹上棕糊，锅中冒香"
    },
    {
      "n": 4,
      "text": "分三次倒入热高汤，每次搅到顺滑再加下一次。",
      "time_min": 6,
      "heat": "中火",
      "tip": "高汤必须热，冷汤会让糊结团。",
      "visual_cue": "汤汁浓稠顺滑，无颗粒"
    },
    {
      "n": 5,
      "text": "加辣椒粉、盐与黑胡椒，小火煮十分钟收浓。",
      "time_min": 11,
      "heat": "小火",
      "tip": "保持微沸，边缘冒小泡就够。",
      "visual_cue": "汤汁挂勺，颜色红棕"
    },
    {
      "n": 6,
      "text": "虾仁下锅煮四分钟，至卷曲变色立刻关小火。",
      "time_min": 5,
      "heat": "小火",
      "tip": "虾仁久煮会硬，看到全部卷曲就够。",
      "visual_cue": "虾仁橙红卷曲，弹手"
    },
    {
      "n": 7,
      "text": "关火拌入剩余黄油，撒小葱碎，浇在热米饭上。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后一勺黄油让酱汁发亮，也更顺口。",
      "visual_cue": "酱汁油亮，葱碎翠绿"
    }
  ],
  "tips": [
    "油面糊是这道菜的全部难点，耐心小火炒到棕褐色。",
    "高汤用虾壳熬的更鲜，没有就用鸡高汤。",
    "卡真调味粉本身带盐，加盐前先尝。"
  ],
  "common_mistakes": [
    "油面糊火太大炒焦，整锅带苦味。",
    "冷高汤直接倒入，糊体瞬间结块。",
    "虾仁和汤汁一起久煮，缩成硬粒。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "小龙虾尾",
      "ratio": "600 克:600 克",
      "note": "路易斯安那经典版本，煮制时间相同。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "60 克:55 毫升",
      "note": "少了奶香，油面糊颜色更浅。"
    }
  ],
  "variations": [
    "加两勺番茄酱，做成颜色更红的克里奥尔版本。",
    "用鸡肉替代虾仁，炖制时间延长八分钟。"
  ],
  "serving_suggestion": "浇在热白饭上，配一瓶冰啤酒和辣椒酱。",
  "storage": "冷藏两天、冷冻一个月；复热加少量高汤小火加热，别大火滚。",
