  "steps": [
    {
      "n": 1,
      "text": "大米淘洗后煮熟，摊开晾凉。，份量心里有数，香气才不跑。",
      "time_min": 32,
      "heat": "中火",
      "tip": "饭要稍硬，拌炒才不烂。，锅温要匀，吃口才舒服。",
      "visual_cue": "米粒分明，表面干爽，慢慢来别急，表面才漂亮。"
    },
    {
      "n": 2,
      "text": "洋葱、芹菜和青椒切细丁。，别用力搅，整道菜才立得住。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切细些，才和米粒贴合。，盖盖焖一会儿，味道才进得去。",
      "visual_cue": "丁粒细匀，颜色分明，别用力搅，细节才到位。"
    },
    {
      "n": 3,
      "text": "炖锅化黄油，中火炒菜丁七分钟。，留意锅底，口感才不散。",
      "time_min": 8,
      "heat": "中火",
      "tip": "炒到软塌，甜味才出。，慢慢来别急，颜色才够亮。",
      "visual_cue": "菜丁发软，锅底微褐，留意锅底，火候才均匀。"
    },
    {
      "n": 4,
      "text": "下猪肉末拨散，炒到变色出油。，保持小火，口感才不散。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉末要拨散，才不成块。，动作放连贯，细节才到位。",
      "visual_cue": "肉末发白，锅里有油，注意别烧干，颜色才够亮。"
    },
    {
      "n": 5,
      "text": "加蒜末、红椒粉和黑胡椒炒香。，先试试温度，口感才有层次。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料后放，香气才不跑。，慢慢来别急，整道菜才立得住。",
      "visual_cue": "油色发红，香气扑鼻，料别一次下太多，风味才干净。"
    },
    {
      "n": 6,
      "text": "倒入米饭，用勺压散翻炒均匀。，注意别烧干，锅气才足。",
      "time_min": 6,
      "heat": "中火",
      "tip": "饭要压散，不然结块。，料别一次下太多，香气才留得住。",
      "visual_cue": "米粒包油，颗粒分明，起锅前尝味，口感才不发柴。"
    },
    {
      "n": 7,
      "text": "加清水和盐，盖盖小火焖十分钟。，手法轻些，味道才不闷。",
      "time_min": 12,
      "heat": "小火",
      "tip": "水别多，焖到刚好收干。，动作放连贯，风味才干净。",
      "visual_cue": "水分收干，饭粒松软，汤汁别收太干，整道菜才立得住。"
    },
    {
      "n": 8,
      "text": "开盖翻匀，撒小葱末出锅。，锅温要匀，香气才留得住。",
      "time_min": 4,
      "heat": "无火",
      "tip": "翻匀再撒葱，颜色才绿。，份量心里有数，火候才均匀。",
      "visual_cue": "葱末翠绿，饭粒油亮，慢慢来别急，香气才不跑。"
    }
  ],
  "tips": [
    "饭煮得稍硬些，拌炒才不糊。，注意别烧干，整道菜才立得住。",
    "水别加多，收干就够。，慢慢来别急，锅气才足。",
    "香料下锅后火别大，容易糊。，火别太大，成品才好看。"
  ],
  "common_mistakes": [
    "饭太湿，炒成糊状。，份量心里有数，成品才稳当。",
    "肉末不拨散，结成硬团。，时间掐准，火候才均匀。",
    "水加太多，饭粒发烂。，手法轻些，表面才漂亮。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉",
      "ratio": "300 克:300 克",
      "note": "切小丁，炒制时间加两分钟。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30 克:25 毫升",
      "note": "风味略淡，可加一点蒜粉。"
    }
  ],
  "variations": [
    "加烤过的面包丁，口感更丰富。，保持小火，食材才不糊。",
    "塞进烤鸡里做填料。，起锅前尝味，口感才不散。"
  ],
  "serving_suggestion": "配烤鸡或烤肉，当主食。，注意别烧干，吃口才舒服。",
  "storage": "冷藏两天，复热用炒锅。，别急着加油，吃口才舒服。",
