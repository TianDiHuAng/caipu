  "equipment": [
    "碗",
    "打蛋器",
    "密封罐",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛋黄酱和番茄酱放进碗里，用打蛋器搅到颜色均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先把两种酱拌匀，再加料才不出水。",
      "visual_cue": "酱体橙红，质地顺滑"
    },
    {
      "n": 2,
      "text": "芹菜去掉粗筋切成极细的末，越细口感越好。",
      "time_min": 5,
      "heat": "无火",
      "tip": "芹菜末一定要细，粗了会有生青味。",
      "visual_cue": "芹菜末细匀无粗梗"
    },
    {
      "n": 3,
      "text": "柠檬挤出一大勺汁，和大蒜泥一起加进酱里拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁现挤，瓶装汁香气差很多。",
      "visual_cue": "酱体变稀，酸香明显"
    },
    {
      "n": 4,
      "text": "加入辣椒粉、盐和黑胡椒，搅匀后尝味调整咸淡。",
      "time_min": 2,
      "heat": "无火",
      "tip": "辣椒粉分两次加进去，边尝边调整辣度。",
      "visual_cue": "色泽橙红，辛辣适中"
    },
    {
      "n": 5,
      "text": "最后拌入香菜末，冷藏静置二十分钟让味道融合。",
      "time_min": 22,
      "heat": "无火",
      "tip": "香菜末要在最后拌入，早拌颜色会变黑。",
      "visual_cue": "酱面点缀绿末，质地浓稠"
    }
  ],
  "tips": [
    "芹菜末要切得极细，粗梗会让酱带生青味。",
    "柠檬汁现挤现用，香气比瓶装汁明亮得多。",
    "冷藏静置二十分钟，各味融合更好吃。"
  ],
  "common_mistakes": [
    "芹菜末切得太粗，吃起来全是生菜味。",
    "番茄酱加太多，酱体过稀挂不住食材。",
    "香菜末提前拌入，静置后颜色发黑。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "240 克:200 克",
      "note": "热量更低，酸味更明显。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "1 个:15 毫升",
      "note": "酸味更直接，香气略弱。"
    }
  ],
  "variations": [
    "加一小勺辣酱，辛香更接近新奥尔良街头版本。",
    "拌入酸黄瓜碎，口感更清爽解腻。"
  ],
  "serving_suggestion": "配炸虾、蟹饼或炸鱼吃，也可以抹在三明治里当调味酱。",
  "storage": "密封冷藏三天，取用须用干净勺，出现异味即丢弃。",
