  "equipment": [
    "厚底锅",
    "木勺",
    "刀",
    "砧板",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切两厘米块，用三克盐和一半辣椒粉抓匀腌十分钟。香肠斜切一厘米厚片。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鸡肉先腌过再煎，内部才有底味。",
      "visual_cue": "鸡块表面均匀裹上红色调料"
    },
    {
      "n": 2,
      "text": "厚底锅放植物油，香肠片下锅中火煎到边缘微焦出油，盛出备用。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香肠煎出油后，用这层油煎鸡块味道最足。",
      "visual_cue": "香肠边缘卷曲焦黄，锅底留红色油"
    },
    {
      "n": 3,
      "text": "鸡块下锅煎到表面金黄，推到一边，下洋葱、芹菜和大蒜炒软。",
      "time_min": 8,
      "heat": "中火",
      "tip": "蔬菜要炒到出水变软，这是卡真菜的基础底味。",
      "visual_cue": "洋葱透明，芹菜丁颜色转深"
    },
    {
      "n": 4,
      "text": "加番茄块、辣椒酱、余下辣椒粉、百里香和月桂叶翻炒三分钟，倒入生抽。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄要炒到化成泥状，饭粒才会裹上均匀的红。",
      "visual_cue": "锅内食材呈现浓稠红酱状"
    },
    {
      "n": 5,
      "text": "倒入生米翻拌一分钟，加滚热高汤与余下盐，煮开后转小火盖盖焖二十五分钟。",
      "time_min": 27,
      "heat": "小火",
      "tip": "加汤后不要频繁开盖，蒸汽跑了饭就夹生。",
      "visual_cue": "液面被米饭吸干，饭面出现小孔"
    },
    {
      "n": 6,
      "text": "开盖挑出月桂叶，拌入香肠片，盖盖焖五分钟，撒葱花上桌。",
      "time_min": 6,
      "heat": "微火",
      "tip": "关火焖五分钟能让米粒水分分布更均匀。",
      "visual_cue": "米饭粒粒松散，颜色红亮，香肠分布均匀"
    }
  ],
  "tips": [
    "长粒米比短粒更耐煮，做什锦饭不易糊成粥。",
    "高汤必须是热的，冷汤下锅会让米粒外层瞬间收缩、口感发硬。",
    "卡真调味讲究辣、香、烟三重，辣椒粉与百里香都不可省。"
  ],
  "common_mistakes": [
    "用冷汤直接倒进热锅，米饭煮出来外硬内夹生。",
    "焖煮时频繁开盖翻动，米粒被搅成糊。",
    "香肠和鸡块同时下锅，香肠焦了鸡肉还没上色。"
  ],
  "substitutions": [
    {
      "original": "香肠",
      "substitute": "培根",
      "ratio": "200 克:150 克",
      "note": "咸度高，盐减两克。"
    },
    {
      "original": "鸡腿",
      "substitute": "虾仁",
      "ratio": "500 克:400 克",
      "note": "虾仁最后十分钟放入，避免煮老。"
    }
  ],
  "variations": [
    "加入秋葵或西葫芦块，可做成路易斯安那乡间常见的蔬菜版本。"
  ],
  "serving_suggestion": "配辣酱汁与冰啤酒，撒葱花上桌。",
  "storage": "冷藏三天，冷冻一个月，复热时加两勺高汤拌松。",
