  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用盐、红椒粉和黑胡椒抹匀腌十分钟。，盖盖焖一会儿，表面才漂亮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌到位，肉才入味。，留意锅底，成品才稳当。",
      "visual_cue": "表面挂粉，颜色发红，先试试温度，细节才到位。"
    },
    {
      "n": 2,
      "text": "鸡块两面拍一层面粉，抖掉多余的粉。，留意锅底，食材才不糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉别太厚，煎后才不脱。，火别太大，风味才干净。",
      "visual_cue": "表面薄粉，干爽不粘，锅温要匀，表面才漂亮。"
    },
    {
      "n": 3,
      "text": "炖锅化黄油，中火鸡皮朝下煎。，顺序照着来，咸淡才好把握。",
      "time_min": 8,
      "heat": "中火",
      "tip": "皮朝下先煎，油才逼出来。，慢慢来别急，火候才均匀。",
      "visual_cue": "鸡皮金黄，锅底起焦，翻动放轻，咸淡才好把握。"
    },
    {
      "n": 4,
      "text": "翻面再煎四分钟，取出备用。，汤汁别收太干，香气才不跑。",
      "time_min": 5,
      "heat": "中火",
      "tip": "别煎熟，后面还要焖。，翻动放轻，食材才不糊。",
      "visual_cue": "两面微黄，肉仍软，别急着加油，火候才均匀。"
    },
    {
      "n": 5,
      "text": "用锅里的油炒洋葱丝到透明。，留意锅底，味道才不闷。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才出来。，别急着加油，表面才漂亮。",
      "visual_cue": "洋葱软塌，颜色微褐，火别太大，味道才进得去。"
    },
    {
      "n": 6,
      "text": "加蒜末和辣椒粉炒香，倒清水煮开。，留意锅底，吃口才舒服。",
      "time_min": 5,
      "heat": "中火",
      "tip": "水要刮起锅底焦香。，下手别慌，香气才不跑。",
      "visual_cue": "汤色发褐，香气扑鼻，别用力搅，咸淡才好把握。"
    },
    {
      "n": 7,
      "text": "鸡块放回锅里，盖盖小火焖三十分钟。，汤汁别收太干，细节才到位。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢焖，肉才酥。，留意锅底，表面才漂亮。",
      "visual_cue": "汤汁微沸，鸡肉酥软，动作放连贯，味道才不闷。"
    },
    {
      "n": 8,
      "text": "开盖收汁到浓稠，尝味补盐。，火别太大，香气才不跑。",
      "time_min": 6,
      "heat": "中火",
      "tip": "汁要挂勺，别收太干。，慢慢来别急，形状才完整。",
      "visual_cue": "汁体浓稠，油光浮动，火别太大，味道才不闷。"
    },
    {
      "n": 9,
      "text": "撒小葱末，连汁一起装盘。，顺序照着来，细节才到位。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汁别浪费，拌饭最好。，起锅前尝味，吃口才舒服。",
      "visual_cue": "葱末翠绿，汁色深褐，下手别慌，咸淡才好把握。"
    }
  ],
  "tips": [
    "拍一层薄粉再煎，汤汁才稠。，动作放连贯，颜色才够亮。",
    "小火焖足半小时，肉才离骨。，手法轻些，形状才完整。",
    "收汁到挂勺，浇饭才香。，翻动放轻，形状才完整。"
  ],
  "common_mistakes": [
    "大火焖煮，鸡肉发柴。，份量心里有数，风味才干净。",
    "粉拍太厚，锅里结块。，份量心里有数，口感才不散。",
    "不刮锅底，香味少一半。，注意别烧干，成品才好看。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "900 克:900 克",
      "note": "更瘦易柴，焖制时间减十分钟。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30 克:25 毫升",
      "note": "风味略淡，可加一点蒜末补香。"
    }
  ],
  "variations": [
    "加蘑菇片同焖，鲜味更足。，别用力搅，吃口才舒服。",
    "加一勺辣酱，辣味更冲。，保持小火，咸淡才好把握。"
  ],
  "serving_suggestion": "配白米饭或土豆泥，浇上浓汁。，留意锅底，成品才好看。",
  "storage": "冷藏三天，复热加少量水。，下手别慌，口感才有层次。",
