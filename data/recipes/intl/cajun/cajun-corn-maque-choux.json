  "equipment": [
    "煎锅",
    "刀",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米剥成颗粒，剥的时候用刀背刮一下玉米芯取浆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "刮出的玉米浆能让成品更浓稠挂勺。",
      "visual_cue": "玉米粒饱满，断面带浆"
    },
    {
      "n": 2,
      "text": "煎锅化开黄油，下洋葱丁和甜椒丁中火炒三分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味才会完全释放。",
      "visual_cue": "蔬菜丁变软，边缘透明"
    },
    {
      "n": 3,
      "text": "倒入玉米粒翻炒两分钟，让每颗玉米都裹上黄油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "玉米先炒过一遍，甜味会更集中。",
      "visual_cue": "玉米粒油亮，颗颗发黄"
    },
    {
      "n": 4,
      "text": "加辣椒粉、盐和黑胡椒翻匀，倒入清水后转小火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "清水只到玉米的一半，焖出原汁。",
      "visual_cue": "锅里冒出红亮汤汁"
    },
    {
      "n": 5,
      "text": "盖盖小火焖八分钟，中途翻动两次防止糊底。",
      "time_min": 9,
      "heat": "小火",
      "tip": "焖的过程要翻动，糖分容易粘锅。",
      "visual_cue": "汤汁减少，玉米变软"
    },
    {
      "n": 6,
      "text": "开盖倒入淡奶油，中火收汁三分钟到浓稠挂勺。",
      "time_min": 4,
      "heat": "中火",
      "tip": "淡奶油最后加，香味不会被久煮跑掉。",
      "visual_cue": "酱汁浓稠裹住玉米"
    },
    {
      "n": 7,
      "text": "尝一下咸淡补盐，盛盘时把锅里的浓汁一起浇上。",
      "time_min": 1,
      "heat": "无火",
      "tip": "收汁到位才够浓，太稀就成汤了。",
      "visual_cue": "表面油亮，汁浓不流"
    }
  ],
  "tips": [
    "玉米用刀背刮一下芯，取出的浆能让酱汁更浓。",
    "辣椒粉用小火炒，香味才不焦苦。",
    "淡奶油最后加，收汁三分钟刚好浓稠。"
  ],
  "common_mistakes": [
    "玉米直接加水煮，甜味全跑进汤里。",
    "全程大火收汁，糖分粘锅发苦黑。",
    "淡奶油一开始就下锅，久煮后油水分离。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "100 毫升:120 毫升",
      "note": "浓度低，需多收两分钟汁。"
    },
    {
      "original": "辣椒粉",
      "substitute": "甜椒粉",
      "ratio": "4 克:4 克",
      "note": "不辣版本，颜色更红。"
    }
  ],
  "variations": [
    "加几片培根同炒，烟熏味会更足。",
    "最后撒一把切碎的香葱，颜色更清新。"
  ],
  "serving_suggestion": "配烤鸡、煎鱼或黑化鱼排同吃，是路易斯安那家庭餐桌上的经典配菜。",
  "storage": "冷藏两天，复热加一小勺清水小火翻热，避免干锅。",
