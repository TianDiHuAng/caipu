  "steps": [
    {
      "n": 1,
      "text": "玉米面、面粉、白糖、盐和泡打粉混匀。，份量心里有数，口感才不发柴。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先混干料，才不结块。，注意别烧干，香气才不跑。",
      "visual_cue": "粉类均匀，无颗粒，料别一次下太多，表面才漂亮。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，倒进牛奶搅匀。，时间掐准，风味才干净。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液先打匀，糊才顺。，别用力搅，口感才不散。",
      "visual_cue": "液体顺滑，颜色浅黄，保持小火，口感才有层次。"
    },
    {
      "n": 3,
      "text": "液体倒进粉里，搅到没有干粉。，下手别慌，成品才稳当。",
      "time_min": 4,
      "heat": "无火",
      "tip": "别过度搅，起筋就硬。，火别太大，咸淡才好把握。",
      "visual_cue": "糊体浓稠，能挂勺，慢慢来别急，咸淡才好把握。"
    },
    {
      "n": 4,
      "text": "加小葱末拌匀，静置十分钟。，火别太大，锅气才足。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置让粉吸足水。，份量心里有数，整道菜才立得住。",
      "visual_cue": "糊体发亮，葱末均匀，慢慢来别急，味道才不闷。"
    },
    {
      "n": 5,
      "text": "炸锅倒植物油，中火烧到插筷子起泡。，别用力搅，锅气才足。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温不够，球会吸油。，锅温要匀，味道才进得去。",
      "visual_cue": "筷子周围冒细泡，盖盖焖一会儿，锅气才足。"
    },
    {
      "n": 6,
      "text": "用勺挖一勺糊，轻轻推入油锅。，顺序照着来，锅气才足。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一勺一个，大小才匀。，下手别慌，形状才完整。",
      "visual_cue": "球体浮起，边缘冒泡，先试试温度，香气才不跑。"
    },
    {
      "n": 7,
      "text": "炸到金黄浮起，翻面再炸一分钟。，别用力搅，风味才干净。",
      "time_min": 4,
      "heat": "中火",
      "tip": "翻一次面，颜色才匀。，汤汁别收太干，风味才干净。",
      "visual_cue": "表面金黄，体积膨大，锅温要匀，锅气才足。"
    },
    {
      "n": 8,
      "text": "捞出沥油，趁热撒一点盐。，留意锅底，咸淡才好把握。",
      "time_min": 4,
      "heat": "无火",
      "tip": "垫厨房纸，油才去得干净。，盖盖焖一会儿，成品才好看。",
      "visual_cue": "外皮酥脆，纸上有油，汤汁别收太干，味道才不闷。"
    }
  ],
  "tips": [
    "糊别搅太久，起筋口感就硬。，火别太大，整道菜才立得住。",
    "油温不够会吸油，看到细泡再下锅。，份量心里有数，香气才留得住。",
    "趁热吃，凉了外皮就软。，保持小火，香气才留得住。"
  ],
  "common_mistakes": [
    "糊太稀，下锅就散。，注意别烧干，形状才完整。",
    "油温太低，球吸满油。，时间掐准，成品才稳当。",
    "一次下太多，油温骤降。，份量心里有数，锅气才足。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "180 毫升:170 毫升",
      "note": "少一层奶香，需补一点黄油。"
    },
    {
      "original": "玉米面",
      "substitute": "玉米淀粉",
      "ratio": "200 克:200 克",
      "note": "口感偏软，需加面粉三十克。"
    }
  ],
  "variations": [
    "加切碎的青椒，风味更正。，慢慢来别急，食材才不糊。",
    "加一撮辣椒粉，辣味更足。，时间掐准，香气才留得住。"
  ],
  "serving_suggestion": "配炸鱼或炸虾，蘸辣酱吃。，锅温要匀，火候才均匀。",
  "storage": "冷藏一天，复热用烤箱。，锅温要匀，整道菜才立得住。",
