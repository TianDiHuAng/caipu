          "amount": 600,
          "unit": "g",
          "note": "取两大片鱼柳",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 10,
          "unit": "g",
          "note": "卡真调味",
          "optional": false
        },
        {
