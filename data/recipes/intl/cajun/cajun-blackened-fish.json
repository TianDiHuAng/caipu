          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 50,
          "unit": "g",
          "note": "融化",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 60,
          "unit": "g",
          "note": "切角",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "铸铁锅",
    "小碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼片洗净后用厨房纸彻底吸干水分，两面都擦到不粘手。",
      "time_min": 5,
      "heat": "无火",
      "tip": "鱼身越干，煎出的焦壳才越脆越黑亮。",
      "visual_cue": "鱼皮干爽，按压无水分渗出"
    },
    {
      "n": 2,
      "text": "小碗里把辣椒粉、黑胡椒、蒜末、孜然与盐拌匀成卡真调料。",
      "time_min": 3,
      "heat": "无火",
      "tip": "调料现拌现用，香气比瓶装混合粉更足。",
      "visual_cue": "粉料均匀，辛香扑鼻"
    },
    {
      "n": 3,
      "text": "鱼片两面均匀抹上调料，轻轻按压让粉贴紧表面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "抹完静置五分钟，粉料吸水后不易脱落。",
      "visual_cue": "鱼片表面覆一层厚粉，无干粉堆积"
    },
    {
      "n": 4,
      "text": "铸铁锅烧到微微冒烟，再刷一层融化的黄油润锅。",
      "time_min": 4,
      "heat": "大火",
      "tip": "锅一定要够热，鱼下锅才能瞬间封壳。",
      "visual_cue": "锅面油光微烟，手掌悬空能感到灼热"
    },
    {
      "n": 5,
      "text": "鱼片下锅不要翻动，煎三分钟至边缘出现黑褐色焦壳。",
      "time_min": 3,
      "heat": "大火",
      "tip": "全程别压别翻，翻早了粉壳就掉了。",
      "visual_cue": "边缘焦黑，鱼皮自然脱离锅底"
    },
    {
      "n": 6,
      "text": "翻面再煎两分钟，淋少许黄油让表面油亮起香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "第二面时间短一些，鱼肉才不会过熟。",
      "visual_cue": "两面焦壳，鱼肉边缘泛白"
    },
    {
      "n": 7,
      "text": "盛盘后挤上柠檬角，趁热吃，外焦壳脆内里嫩。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬酸味能压住焦壳的苦香，必须配。",
      "visual_cue": "鱼片油亮，柠檬汁渗入焦壳"
    }
  ],
  "tips": [
    "用铸铁锅或不粘厚底锅，薄锅烧不到需要的温度。",
    "鱼片厚度选两厘米左右，太薄一煎就老。",
    "厨房要开窗通风，高温煎香料会冒大量烟。"
  ],
  "common_mistakes": [
    "鱼身没擦干就下锅，表面出水蒸成白肉没有焦壳。",
    "锅不够热，粉料只变褐不发黑，香气不足。",
    "反复翻动鱼片，焦壳全部脱落粘在锅底。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "鳕鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更嫩，煎制时间各减半分钟。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "50 克:45 毫升",
      "note": "烟点更高不易糊，但少了奶香。"
    }
  ],
  "variations": [
    "把鱼换成鸡胸肉拍薄，做成卡真黑煎鸡。",
    "煎好后淋一勺蒜香黄油酱，风味更浓。"
  ],
  "serving_suggestion": "配柠檬角与烤玉米或米饭同食，再配一杯冰啤酒。",
  "storage": "冷藏一天；复热用平底锅小火两面各一分钟，别用微波炉否则焦壳变软。",
