          "name_en": "black pepper",
          "amount": 5,
          "unit": "g",
          "note": "粗磨",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 10,
          "unit": "g",
          "note": "蒜粉替代切末",
          "optional": false
        },
        {
          "name": "孜然",
          "name_en": "cumin",
          "amount": 3,
          "unit": "g",
          "note": "磨粉",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
