    "炒锅",
    "木勺",
    "擦丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩冷水下锅焯去血沫，冲净后加清水与香叶小火炖四十分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "冷水下锅，血沫才出得净。",
      "visual_cue": "汤色清亮、牛腩变软"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，炒洋葱与胡萝卜五分钟至变软，加番茄与番茄膏炒出红油。",
      "time_min": 10,
      "heat": "中火",
      "tip": "番茄膏炒过才没有生味。",
      "visual_cue": "锅底见红油、蔬菜软化"
    },
    {
      "n": 3,
      "text": "加入甜菜丝炒三分钟，倒白醋翻炒，酸性能让甜菜的红色稳住。",
      "time_min": 5,
      "heat": "中火",
      "tip": "先加醋，汤色才不发褐。",
      "visual_cue": "甜菜丝软塌、颜色鲜红"
    },
    {
      "n": 4,
      "text": "炒好的蔬菜倒进牛腩汤里，加土豆煮二十分钟，再放卷心菜煮十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "卷心菜后放，保留脆甜。",
      "visual_cue": "土豆软糯、卷心菜变软"
    },
    {
      "n": 5,
      "text": "加盐与白糖调味，关火后拌入蒜末，静置十分钟再盛出。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜末离火加，香气才冲。",
      "visual_cue": "汤色深红、表面浮油"
    }
  ],
  "tips": [
    "甜菜下锅前先拌醋，红色才不被氧化成褐。",
    "卷心菜最后十分钟放，久煮会发黄失脆。",
    "蒜末关火后拌入，久煮香气全跑掉。"
  ],
  "common_mistakes": [
    "甜菜没加醋就久煮，汤色变成暗褐色。",
    "牛腩不焯水直接炖，汤浑浊带腥。",
    "所有蔬菜一起下锅，土豆化成泥、卷心菜烂透。"
  ],
  "substitutions": [
    {
      "original": "甜菜",
      "substitute": "胡萝卜",
      "ratio": "300g 对 350g",
      "note": "颜色偏橙，酸味需补足。"
    },
    {
      "original": "牛腩",
      "substitute": "牛肉末",
      "ratio": "400g 对 350g",
      "note": "炖制时间缩短到 15 分钟。"
    }
  ],
  "variations": [
    "冷食版：冷藏后加酸奶油与煮蛋碎。",
    "素食版：牛腩换成 300g 蘑菇与 200g 鹰嘴豆。"
  ],
  "serving_suggestion": "配黑麦面包与一勺酸奶，撒欧芹碎。",
  "storage": "冷藏可存 4 天，隔夜风味更融合，复热须煮沸。",
