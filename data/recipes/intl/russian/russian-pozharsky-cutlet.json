  "equipment": [
    "刀",
    "砧板",
    "碗",
    "平底锅",
    "铲子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包去边撕碎，泡进牛奶软化。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡软的面包让肉饼更嫩。，火候要稳，别忽大忽小。",
      "visual_cue": "面包吸饱，捏之成团"
    },
    {
      "n": 2,
      "text": "鸡胸肉剁成细泥，去掉筋膜。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "剁细一点，口感才细。，火候要稳，别忽大忽小。",
      "visual_cue": "肉泥细腻，黏性明显"
    },
    {
      "n": 3,
      "text": "肉泥加面包、盐和黑胡椒，摔打到上劲。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "摔打上劲，饼才不散。，火候要稳，别忽大忽小。",
      "visual_cue": "肉泥发黏，能成团，这一点很关键。"
    },
    {
      "n": 4,
      "text": "分成四份，中间包一小块冷黄油。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "包冷黄油，切开才流汁。，火候要稳，别忽大忽小。",
      "visual_cue": "形状椭圆，封口紧实"
    },
    {
      "n": 5,
      "text": "裹蛋液再滚面包糠，压实边缘。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压紧面包糠，煎时不掉。，火候要稳，别忽大忽小。",
      "visual_cue": "外皮均匀，表面干爽"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油，中小火煎四分钟。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "小火慢煎，里面才熟。，火候要稳，别忽大忽小。",
      "visual_cue": "底面金黄，边缘定型"
    },
    {
      "n": 7,
      "text": "翻面再煎三分钟，加黄油淋面。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "黄油淋面，香气才足。，火候要稳，别忽大忽小。",
      "visual_cue": "两面金黄，表皮酥脆"
    },
    {
      "n": 8,
      "text": "出锅吸油，静置三分钟再切。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置一下，汁水才不流。，火候要稳，别忽大忽小。",
      "visual_cue": "切面多汁，黄油渗出"
    }
  ],
  "tips": [
    "肉泥摔打上劲，饼才不散。，这一点很关键。",
    "中间包冷黄油，切开才流汁。，这一点很关键。",
    "中小火煎，外脆里嫩。，这一点很关键。"
  ],
  "common_mistakes": [
    "肉泥没上劲，一煎就散。，这一点很关键。",
    "火太大，外焦里生。，这一点很关键。",
    "面包糠没压实，煎时脱落。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "600 克:600 克",
      "note": "脂肪更多，口感更润。"
    },
    {
      "original": "面包糠",
      "substitute": "面粉",
      "ratio": "120 克:100 克",
      "note": "外壳更薄，酥脆度略降。"
    }
  ],
  "variations": [
    "内馅换成蘑菇碎，风味更素。，这一点很关键。",
    "配奶油酱汁，口感更浓。，这一点很关键。"
  ],
  "serving_suggestion": "配土豆泥和酸黄瓜一起上桌。，这一点很关键。",
  "storage": "冷藏两天，复煎五分钟。，这一点很关键。",
