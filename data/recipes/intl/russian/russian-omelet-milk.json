  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 5,
          "unit": "piece",
          "note": "室温",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 120,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切细末",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 15,
          "unit": "g",
          "note": "过筛",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "煎蛋用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "打蛋器",
    "碗",
    "锅铲",
    "细筛"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进大碗，加牛奶、盐和黑胡椒，用打蛋器搅到完全均匀无蛋筋。",
      "time_min": 3,
      "heat": "无火",
      "tip": "多搅半分钟让蛋液更匀，卷出来才够嫩滑。",
      "visual_cue": "蛋液匀滑，表面浮细小气泡"
    },
    {
      "n": 2,
      "text": "中筋面粉过筛撒进蛋液，边撒边搅成稀薄无颗粒的面糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "面粉过筛再下，蛋卷里才没有小疙瘩。",
      "visual_cue": "面糊顺滑，舀起能连成细线"
    },
    {
      "n": 3,
      "text": "面糊静置五分钟，让小气泡散掉，煎出来的蛋卷才平整。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置过的面糊更融合，也不容易起泡。",
      "visual_cue": "表面气泡消失，质地均匀"
    },
    {
      "n": 4,
      "text": "平底锅小火化开黄油，让油薄薄铺满整个锅底。",
      "time_min": 2,
      "heat": "小火",
      "tip": "黄油起细泡但别变褐，火大了会发苦。",
      "visual_cue": "锅底一层黄油，泛细密小泡"
    },
    {
      "n": 5,
      "text": "倒入面糊摊平，小火煎三分钟，等边缘翘起、表面半凝再翻面。",
      "time_min": 4,
      "heat": "小火",
      "tip": "全程小火，火大底面焦了里面还是生的。",
      "visual_cue": "边缘翘起金黄，表面还湿润"
    },
    {
      "n": 6,
      "text": "翻面后再煎两分钟，用锅铲轻按有弹性就说明内部已经熟透。",
      "time_min": 2,
      "heat": "小火",
      "tip": "按下去有弹性且不出蛋液，才算煎透。",
      "visual_cue": "两面金黄，按压能立刻回弹"
    },
    {
      "n": 7,
      "text": "把蛋卷折成三层或卷起，铲出切段，撒小葱末趁热上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "出锅立刻切段，凉了会变挺，折起来容易裂。",
      "visual_cue": "切面蛋体细密，层次分明"
    }
  ],
  "tips": [
    "蛋液多搅半分钟，蛋卷质地会明显更细腻。",
    "面粉过筛再下，成品里才不会咬到疙瘩。",
    "面糊静置五分钟，气泡散了表面才平整。",
    "全程小火慢煎，弹性回弹就说明熟透了。"
  ],
  "common_mistakes": [
    "蛋液随便打两下就下锅，卷里全是蛋白条。",
    "面粉直接倒进去，蛋卷里到处是生粉块。",
    "火开大求快，底面焦黑里面还是稀的。",
    "煎好放着不切，凉了变硬很难折起来。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "奶油",
      "ratio": "120毫升:100毫升",
      "note": "更厚实，煎的时间加一分钟。"
    },
    {
      "original": "中筋面粉",
      "substitute": "玉米淀粉",
      "ratio": "15克:10克",
      "note": "质地更嫩，但入口更散。"
    }
  ],
  "variations": [
    "折进去一片奶酪，切开时能拉出长丝。",
    "面糊里拌入切碎的莳萝，香气更像俄式家常早餐。",
    "加一小勺白糖做成甜口版本，配果酱一起吃。"
  ],
  "serving_suggestion": "切段装盘后配一杯热牛奶和一片黑麦面包，是俄罗斯幼儿园和家庭最标准的早餐搭配。",
  "storage": "现做现吃最好，冷藏不超过一天，复热用平底锅小火每面二十秒，微波会变硬。",
  "nutrition_estimate": {
    "basis": "按两人份估算",
    "calories_kcal": 318,
    "protein_g": 20,
