  "equipment": [
    "煮锅",
    "大碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜菜洗净不削皮，整颗冷水下锅煮四十分钟至筷子能戳透。",
      "time_min": 40,
      "heat": "中火",
      "tip": "甜菜带皮整颗煮，红色才不流失到水里。",
      "visual_cue": "甜菜外皮皱起，筷子轻松插入"
    },
    {
      "n": 2,
      "text": "土豆与胡萝卜另起一锅煮熟，约二十分钟后捞出晾凉。",
      "time_min": 20,
      "heat": "中火",
      "tip": "两样分开下锅煮，颜色才不会互相染。",
      "visual_cue": "土豆掰开松软，胡萝卜能压碎"
    },
    {
      "n": 3,
      "text": "三样食材全部晾到不烫手，再逐个削皮切丁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "热的时候切丁会碎，晾透才成形。",
      "visual_cue": "切面平整，丁块大小一致"
    },
    {
      "n": 4,
      "text": "酸黄瓜先纵向剖开，挤出多余的汁水再切小丁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "酸黄瓜挤掉汁水，拌好的沙拉才不水汪汪。",
      "visual_cue": "酸黄瓜丁干爽，酸味清亮"
    },
    {
      "n": 5,
      "text": "洋葱切细丁，用清水泡五分钟去掉辛辣冲味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用清水泡一泡，生洋葱的冲劲就柔和下来。",
      "visual_cue": "洋葱丁透亮，冲味减轻"
    },
    {
      "n": 6,
      "text": "所有食材倒进大碗，加盐与植物油轻轻拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用翻拌的手法而不是搅，块状才不会被搅碎。",
      "visual_cue": "颜色红黄相间，丁块完整"
    },
    {
      "n": 7,
      "text": "盖好放冰箱冷藏一小时，让各种味道互相渗透。",
      "time_min": 30,
      "heat": "无火",
      "tip": "冷藏后各种味道融合，吃起来更清爽凉快。",
      "visual_cue": "表面微凉，汁水清亮"
    },
    {
      "n": 8,
      "text": "上桌前再翻拌一次，盛盘撒少许洋葱丁点缀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "临上桌再拌一次，颜色才不会发暗。",
      "visual_cue": "红菜丁油润透亮，摆盘齐整"
    }
  ],
  "tips": [
    "甜菜带皮整颗煮，红色保留得最好。",
    "三种根茎类分开煮，颜色不串，成品才好看。",
    "全部晾凉再切丁，丁块才整齐不烂。"
  ],
  "common_mistakes": [
    "甜菜削皮切块再煮，红色全跑进水里。",
    "热的时候拌沙拉，食材碎成一锅泥。",
    "酸黄瓜不挤水，拌完盘底一汪汤。"
  ],
  "substitutions": [
    {
      "original": "甜菜",
      "substitute": "红菜头",
      "ratio": "300 克:300 克",
      "note": "同一食材不同叫法，风味不变。"
    },
    {
      "original": "酸黄瓜",
      "substitute": "酸萝卜",
      "ratio": "150 克:150 克",
      "note": "酸度相近，口感更脆。"
    }
  ],
  "variations": [
    "加一把煮熟的青豆，颜色更活泼。",
    "淋上一勺酸奶油，口感更醇厚顺滑。"
  ],
  "serving_suggestion": "冷藏后作为冷盘上桌，配黑面包与烤肉一起吃最地道。",
  "storage": "冷藏三天，食用前翻拌，汁水倒掉再装盘。",
