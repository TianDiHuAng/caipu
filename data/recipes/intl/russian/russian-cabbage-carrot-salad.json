          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "平衡酸味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "拌菜",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "杀水与调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "刀",
    "砧板",
    "大碗",
    "擦丝器",
    "手",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "卷心菜去掉硬芯，切成两毫米宽的细丝，放进大碗里撒三克盐。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丝切得越细，杀水越快，拌的时候也越入味。",
      "visual_cue": "卷心菜丝细匀，碗里开始出水"
    },
    {
      "n": 2,
      "text": "用手反复抓揉卷心菜丝五分钟，揉到体积缩小、摸起来变软。",
      "time_min": 5,
      "heat": "无火",
      "tip": "揉到菜丝软塌再停手，成品才脆爽而不生硬。",
      "visual_cue": "菜丝体积缩到原来的七成"
    },
    {
      "n": 3,
      "text": "把揉好的卷心菜丝攥成团，用力挤掉多余的水分后抖散。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水挤得越干，拌好后才不会越放越稀。",
      "visual_cue": "菜丝干爽成团，挤出浅绿菜汁"
    },
    {
      "n": 4,
      "text": "胡萝卜擦成细丝，和小葱末一起加进卷心菜里翻拌均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "胡萝卜擦丝比切丝更贴口，也更容易出水。",
      "visual_cue": "碗里橙红与浅绿交错，丝条细匀"
    },
    {
      "n": 5,
      "text": "另取小碗放白醋、白糖和剩下的盐，搅到糖盐完全化开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "糖盐先化开再拌，味道才均匀不夹生。",
      "visual_cue": "汁水清澈，碗底无颗粒"
    },
    {
      "n": 6,
      "text": "把调味汁和植物油倒进菜里，用手从下往上翻拌两分钟。",
      "time_min": 2,
      "heat": "无火",
      "tip": "用手翻拌比勺子更容易让味道吃进去。",
      "visual_cue": "菜丝油亮，颜色比拌之前更鲜"
    },
    {
      "n": 7,
      "text": "盖上保鲜膜冷藏三十分钟，让酸甜味渗进菜丝里再上桌。",
      "time_min": 30,
      "heat": "无火",
      "tip": "冷藏半小时后菜丝更脆，酸味也变得柔和。",
      "visual_cue": "菜丝透亮，碗底有少量清汁"
    }
  ],
  "tips": [
    "卷心菜丝切得细，杀水和入味都快得多。",
    "盐揉到菜丝软塌再挤水，成品才脆爽不水。",
    "糖和盐先在醋里化开，拌出来不会有颗粒感。",
    "冷藏半小时再吃，酸甜味才真正吃进菜里。"
  ],
  "common_mistakes": [
    "卷心菜切好直接拌，端上桌又硬又生。",
    "水没挤干就调汁，半小时后碗里全是汤。",
    "白糖直接撒进菜里，吃到一粒粒甜疙瘩。",
    "拌好立刻吃，味道浮在表面完全没进去。"
  ],
  "substitutions": [
    {
      "original": "白醋",
      "substitute": "柠檬",
      "ratio": "20毫升:半个柠檬的汁",
      "note": "酸味更清亮，香气更好。"
    },
    {
      "original": "植物油",
      "substitute": "橄榄油",
      "ratio": "20毫升:20毫升",
      "note": "风味更重，适合配烤肉。"
    }
  ],
  "variations": [
    "加一勺酸黄瓜的腌汁，酸味更有层次。",
    "撒一把莳萝碎，香气立刻变成俄式家常味。",
    "放几粒黑胡椒同拌，配油腻的炖肉刚好解腻。"
  ],
  "serving_suggestion": "装在深碗里压紧再松开，配俄式炖肉或烤鸡，酸味能把油脂全部压下去。",
  "storage": "冷藏密封可放三天，出水后倒掉碗底汤汁再拌一次即可。",
