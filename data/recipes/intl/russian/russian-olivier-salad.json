        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "砧板",
    "刀",
    "拌菜盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆与胡萝卜去皮切成八毫米见方的小丁，大小尽量一致。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丁切得一样大，煮的时候熟度才齐。",
      "visual_cue": "菜丁大小均匀，边缘平整"
    },
    {
      "n": 2,
      "text": "汤锅烧开水，下土豆丁煮八分钟至能用筷子扎透。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煮到刚熟就捞，太烂拌的时候会碎。",
      "visual_cue": "土豆丁扎透但形状完整"
    },
    {
      "n": 3,
      "text": "下胡萝卜丁同煮三分钟，与土豆一起捞出沥水晾凉。",
      "time_min": 3,
      "heat": "中火",
      "tip": "胡萝卜比土豆易熟，后下就好。",
      "visual_cue": "胡萝卜丁微软，颜色鲜亮"
    },
    {
      "n": 4,
      "text": "豌豆下锅焯两分钟，捞出后立刻过凉水保持翠绿。",
      "time_min": 2,
      "heat": "中火",
      "tip": "过凉水能锁住颜色和口感。",
      "visual_cue": "豌豆翠绿饱满，口感粉糯"
    },
    {
      "n": 5,
      "text": "鸡蛋冷水下锅煮九分钟，剥壳后切成一样大的小丁。",
      "time_min": 11,
      "heat": "中火",
      "tip": "冷水下锅计时，蛋黄才不会发青。",
      "visual_cue": "蛋黄居中，颜色金黄"
    },
    {
      "n": 6,
      "text": "酸黄瓜与洋葱切成细丁，洋葱用冰水泡三分钟减辣。",
      "time_min": 5,
      "heat": "无火",
      "tip": "酸黄瓜的酸能解蛋黄酱的腻。",
      "visual_cue": "酸黄瓜丁干爽，洋葱不呛眼"
    },
    {
      "n": 7,
      "text": "所有材料放大盆，加蛋黄酱、盐与黑胡椒轻轻翻拌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻拌别压，土豆丁容易碎。",
      "visual_cue": "食材裹匀酱，粒粒分明"
    },
    {
      "n": 8,
      "text": "装盘后撒小葱碎，冷藏二十分钟再食用风味更好。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏让味道融合，也更清爽。",
      "visual_cue": "表面泛酱光，配色清爽"
    }
  ],
  "tips": [
    "所有材料切同样大小的丁，口感才协调。",
    "土豆煮到刚熟就要捞出，拌的时候才不会碎。",
    "拌好后冷藏二十分钟再吃，各种味道更融合。"
  ],
  "common_mistakes": [
    "土豆煮过了头，一拌就整个变成土豆泥。",
    "鸡蛋用大火猛煮，蛋黄边缘发青发绿。",
    "材料没晾凉就拌蛋黄酱，酱汁变稀出水。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "150 克:150 克",
      "note": "热量更低，酸味更清爽。"
    },
    {
      "original": "酸黄瓜",
      "substitute": "黄瓜",
      "ratio": "100 克:100 克",
      "note": "需加十毫升白醋补酸味。"
    }
  ],
  "variations": [
    "加一块煮鸡胸肉切丁，做成更饱腹的版本。",
    "加一小勺芥末酱，酸辣味让层次更丰富。"
  ],
  "serving_suggestion": "冷藏后作为前菜，配黑面包或烤吐司。",
  "storage": "冷藏保存两天，食用前翻拌均匀，不要室温久放。",
