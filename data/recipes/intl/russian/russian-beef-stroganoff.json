  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛肉",
          "name_en": "beef",
          "amount": 500,
          "unit": "g",
          "note": "选牛里脊，逆纹切条",
          "optional": false
        },
        {
          "name": "口蘑",
          "name_en": "button mushroom",
          "amount": 250,
          "unit": "g",
          "note": "切半厘米厚片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 120,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        },
        {
          "name": "酸奶油",
          "name_en": "sour cream",
          "amount": 120,
          "unit": "g",
          "note": "室温回温",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "分两次下锅",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 15,
          "unit": "g",
          "note": "普通中筋粉",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 2,
          "unit": "clove",
          "note": "拍碎剁末",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 10,
          "unit": "g",
          "note": "只取叶片切碎",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "分两次调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨更香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "砧板",
    "厨师刀",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆纹切成小拇指粗的条，撒上一半的盐和黑胡椒抓匀，静置十分钟让底味渗进纤维。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切条务必逆着纹理下刀，顺着切煎完容易嚼不动。",
      "visual_cue": "肉条表面泛出细密盐霜，颜色略深于生肉"
    },
    {
      "n": 2,
      "text": "口蘑切半厘米厚片，洋葱切细丝，大蒜拍碎剁成末，欧芹只留叶片切碎备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "口蘑别切太薄，煎的时候会大量出水缩成小半。",
      "visual_cue": "蘑菇片洁白完整，洋葱丝松散不粘连"
    },
    {
      "n": 3,
      "text": "平底锅烧热放一半黄油，中大火把牛肉条铺开煎到表面褐变，盛出备用。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "牛肉要分批下锅，一次放太多温度骤降会出汤变柴。",
      "visual_cue": "牛肉表面焦褐，边缘微微卷曲"
    },
    {
      "n": 4,
      "text": "用锅里底油炒洋葱丝到透明，加蒜末和口蘑片炒到收水，再撒面粉翻炒均匀。",
      "time_min": 8,
      "heat": "中火",
      "tip": "面粉要炒到看不见干粉再进液体，否则会结成面疙瘩。",
      "visual_cue": "洋葱半透明泛琥珀色，蘑菇片裹上薄粉"
    },
    {
      "n": 5,
      "text": "倒回牛肉，下酸奶油和剩余盐、黑胡椒，小火煮到汤汁挂勺，撒欧芹碎出锅。",
      "time_min": 6,
      "heat": "小火",
      "tip": "酸奶油要小火下锅，大火久煮容易结絮分层。",
      "visual_cue": "汤汁浓稠能挂在肉条上，呈奶油色"
    }
  ],
  "tips": [
    "牛肉煎好后先盛出，最后回锅只煮六分钟，肉质才嫩而不散。",
    "酸奶油下锅前从冰箱取出回温十分钟，温差小就不易结絮。",
    "想更醇厚可在收汁前加一小勺黄油，让酱汁表面发亮。"
  ],
  "common_mistakes": [
    "全程大火猛煮酸奶油，蛋白受热过度会结成絮状颗粒。",
    "牛肉一次性全部下锅，锅内温度骤降导致肉条出水变老。",
    "面粉没有炒熟就直接加液体，酱汁会带生粉味并结块。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "淡奶油",
      "ratio": "1:1",
      "note": "淡奶油酸度低，可另加半勺柠檬汁提酸。"
    },
    {
      "original": "口蘑",
      "substitute": "香菇",
      "ratio": "1:1",
      "note": "香菇气味更重，用量可减三分之一。"
    }
  ],
  "variations": [
    "把牛肉换成牛肝菌与口蘑同炒，做成全素版本的奶油蘑菇。"
  ],
  "serving_suggestion": "配黄油拌面或炸土豆条，撒少许欧芹碎增色。",
  "storage": "冷藏可存两天，复热时加少量牛奶调稀，不要大火久煮。",
