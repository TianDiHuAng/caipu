  "equipment": [
    "汤锅",
    "擦丝器",
    "大碗",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅，水开后中火煮九分钟，捞出立刻泡进冷水里。",
      "time_min": 12,
      "heat": "中火",
      "tip": "煮够九分钟蛋黄才全熟，泡冷水好剥壳。",
      "visual_cue": "蛋壳一敲就整片剥落，蛋白光洁"
    },
    {
      "n": 2,
      "text": "鸡蛋剥壳后切成粗丁，蛋白和蛋黄分开装，留一部分蛋黄做装饰。",
      "time_min": 4,
      "heat": "无火",
      "tip": "分开装是为了拌的时候蛋黄不糊成一团。",
      "visual_cue": "蛋白丁洁白，蛋黄丁成块"
    },
    {
      "n": 3,
      "text": "奶酪用粗孔擦丝器擦成细丝，堆在碗里先放两分钟。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪从冰箱取出放两分钟更好擦不易碎。",
      "visual_cue": "奶酪丝细长均匀，不结团"
    },
    {
      "n": 4,
      "text": "大碗里放蛋黄酱、酸奶油、蒜泥、盐和黑胡椒，搅成顺滑的酱底。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蒜泥一定要细，粗粒会抢掉奶酪的香。",
      "visual_cue": "酱体细腻，蒜味均匀散开"
    },
    {
      "n": 5,
      "text": "把蛋白丁和大部分蛋黄丁倒进碗里，轻轻翻拌让每块都裹上酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "翻拌别搅圈，压碎蛋黄会让沙拉发灰。",
      "visual_cue": "蛋丁完整不散，酱色淡黄发亮"
    },
    {
      "n": 6,
      "text": "加入奶酪丝和小葱末快速拌匀，尝一下补盐和黑胡椒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "奶酪本身有咸味，补盐要一点一点试。",
      "visual_cue": "奶酪丝与蛋丁混匀，表面泛亮"
    },
    {
      "n": 7,
      "text": "装盘后在表面撒剩下的蛋黄碎和小葱，冷藏十分钟再上桌。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏一会儿味道更融合，也更好定型。",
      "visual_cue": "盘面金黄点缀绿末，形状挺立"
    }
  ],
  "tips": [
    "鸡蛋煮够九分钟再泡冷水，蛋黄全熟且好剥壳。",
    "蛋白和蛋黄分开下锅拌，颜色才不会发灰。",
    "奶酪用粗孔擦丝，细孔擦出来会糊成一团。",
    "盐最后一点点补，奶酪的咸味常常被低估。"
  ],
  "common_mistakes": [
    "鸡蛋只煮六分钟，蛋黄还是流心，拌开一塌糊涂。",
    "所有材料一起猛搅，沙拉变成灰色糊状。",
    "奶酪用细孔擦成粉末，入口完全没有质感。",
    "一开始就放足盐，拌好咸得没法入口。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "酸奶油",
      "ratio": "70克:80克",
      "note": "更清爽，热量下降明显。"
    },
    {
      "original": "奶酪",
      "substitute": "帕玛森",
      "ratio": "120克:80克",
      "note": "咸味重，盐可减到一克。"
    }
  ],
  "variations": [
    "加一勺擦碎的苹果，甜味能解奶酪的腻。",
    "把一部分奶酪换成烟熏口味，香气更有层次。",
    "做成小份装进碗里压紧倒扣，冷盘卖相更整齐。"
  ],
  "serving_suggestion": "压进小碗倒扣成圆顶，配黑麦面包片和一杯冰镇汽水，适合当年夜饭的第一道冷盘。",
  "storage": "冷藏密封可放一天，含蛋黄酱不宜久放，吃前翻拌并检查有无异味。",
