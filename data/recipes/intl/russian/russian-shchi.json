  "equipment": [
    "汤锅",
    "炒锅",
    "刀",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩切三厘米见方的块，放入清水锅中煮开撇净浮沫。",
      "time_min": 15,
      "heat": "大火",
      "tip": "冷水下锅才能把血沫慢慢逼出来。",
      "visual_cue": "汤面浮沫撇净，汤色清"
    },
    {
      "n": 2,
      "text": "加香叶转小火炖四十分钟，直到牛腩用筷子能轻松戳透。",
      "time_min": 42,
      "heat": "小火",
      "tip": "用小火慢慢炖，牛腩才会软烂又不散开。",
      "visual_cue": "筷子能轻松戳透牛腩"
    },
    {
      "n": 3,
      "text": "炒锅放植物油，下洋葱丁和胡萝卜丝中火炒到变软出香。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱要炒到透明，胡萝卜炒软甜味才出来。",
      "visual_cue": "洋葱透明，胡萝卜变软"
    },
    {
      "n": 4,
      "text": "加番茄膏继续翻炒两分钟，把红油和颜色彻底炒出来。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄膏要炒出红油，汤色才漂亮。",
      "visual_cue": "红油析出，颜色深红"
    },
    {
      "n": 5,
      "text": "把炒好的料倒进汤锅，加土豆块和盐，中火再煮十五分钟。",
      "time_min": 16,
      "heat": "中火",
      "tip": "土豆后放，煮到边角变圆就可以关火了。",
      "visual_cue": "土豆边角变圆润，汤色橙红"
    },
    {
      "n": 6,
      "text": "下卷心菜丝再煮十分钟，煮到菜叶变软但还带点脆。",
      "time_min": 11,
      "heat": "中火",
      "tip": "卷心菜别煮太久，留点脆口感更好。",
      "visual_cue": "菜叶变软，汤色橙红"
    },
    {
      "n": 7,
      "text": "加大蒜末、白胡椒和莳萝碎，尝味补盐后立刻离火。",
      "time_min": 3,
      "heat": "无火",
      "tip": "大蒜末最后再放，香气才不会被闷散。",
      "visual_cue": "汤面浮着绿色莳萝碎"
    },
    {
      "n": 8,
      "text": "盛碗后各放一勺酸奶油，趁热拌匀后趁热食用最香。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酸奶油要最后加，奶香才不会煮散。",
      "visual_cue": "酸奶油微微化开，汤色奶白"
    }
  ],
  "tips": [
    "牛腩冷水下锅焯水，汤才不会浑浊。",
    "番茄膏必须炒出红油，汤色才橙红诱人。",
    "莳萝和蒜末最后放，香气层次更清楚。"
  ],
  "common_mistakes": [
    "牛腩直接下热水，血沫凝在肉里汤会发浑。",
    "卷心菜煮过头，整锅汤寡淡发黄。",
    "酸奶油一开始就下锅，煮开会结块分层。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛里脊",
      "ratio": "400 克:400 克",
      "note": "炖煮时间缩短到二十五分钟。"
    },
    {
      "original": "酸奶油",
      "substitute": "原味酸奶",
      "ratio": "80 克:80 克",
      "note": "酸度更高，须离火后再加。"
    }
  ],
  "variations": [
    "加一小把干蘑菇同炖，鲜味更浓。",
    "加一个切块土豆换成米饭，做成更浓稠的版本。"
  ],
  "serving_suggestion": "配黑麦面包和一小碟腌黄瓜，是俄罗斯冬天最经典的一顿热汤。",
  "storage": "冷藏三天，冷冻两周；复热时加少量清水稀释，酸奶油另备。",
