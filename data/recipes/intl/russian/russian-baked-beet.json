  "equipment": [
    "烤箱",
    "锡纸",
    "刀",
    "砧板",
    "烤盘",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜菜根刷洗干净不削皮，用叉子在表面扎七八个小孔让蒸汽能出来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "扎几个小孔能防止烤的时候表皮爆裂、汁水流光。",
      "visual_cue": "表皮干净，布满细密小孔"
    },
    {
      "n": 2,
      "text": "烤箱预热到二百度，烤盘铺锡纸，甜菜根表面刷一层橄榄油。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刷一层油能让表皮烤得紧实，不会干裂开缝。",
      "visual_cue": "甜菜根表面油亮，烤箱指示灯亮"
    },
    {
      "n": 3,
      "text": "甜菜根用锡纸包严放进烤盘，中层烤五十分钟至刀能轻松扎透。",
      "time_min": 50,
      "heat": "无火",
      "tip": "包严实靠自身蒸汽焖熟，肉质才不干。",
      "visual_cue": "锡纸鼓起，刀一扎就进"
    },
    {
      "n": 4,
      "text": "取出稍放凉五分钟，打开锡纸趁温热把表皮整片搓掉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "趁温热剥皮最省力，凉透了皮会牢牢粘住肉。",
      "visual_cue": "表皮整片脱落，露出紫红肉质"
    },
    {
      "n": 5,
      "text": "甜菜根切成两厘米厚的圆片或瓣状，摆进盘里撒盐和黑胡椒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "切厚一点吃着才有肉感，太薄容易碎在盘里。",
      "visual_cue": "切面紫红发亮，边缘整齐"
    },
    {
      "n": 6,
      "text": "酸奶油里拌入蒜末和一半莳萝，调成可以流动的白色酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蒜末切得越细，酱才越顺滑，不会卡在嘴里。",
      "visual_cue": "酱体洁白，能缓缓流动"
    },
    {
      "n": 7,
      "text": "把酸奶油酱淋在甜菜根上，撒剩下的莳萝，趁温热上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁温热淋酱，酱会微微化开，更容易贴住切面。",
      "visual_cue": "盘面紫红配白酱，绿碎点缀"
    }
  ],
  "tips": [
    "甜菜根不削皮直接烤，甜味和颜色都留得住。",
    "锡纸包严靠自身蒸汽焖熟，比裸烤更嫩。",
    "趁温热剥皮最省力，凉了皮会牢牢粘住。",
    "酸奶油酱里加蒜末，甜味才不至于发闷。"
  ],
  "common_mistakes": [
    "削皮后裸烤，表面干硬开裂，里面却还是生的。",
    "锡纸没包严，甜菜汁流满烤盘还难洗。",
    "烤好放凉才剥皮，只能连肉一起削掉。",
    "整颗直接上桌不切，吃起来无从下口。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "酸奶",
      "ratio": "100克:100克",
      "note": "选浓稠原味，酸味更明显。"
    },
    {
      "original": "甜菜根",
      "substitute": "胡萝卜",
      "ratio": "600克:600克",
      "note": "烤四十分钟即可，甜味更柔。"
    }
  ],
  "variations": [
    "烤前在锡纸里放一枝百里香，香气更立体。",
    "撒一把烤香的核桃碎，口感和香气都更足。",
    "把酸奶油换成蛋黄酱酸奶混合，做成冷食版本。"
  ],
  "serving_suggestion": "趁温热装盘，配烤鱼、炖肉或荞麦饭，也可以放凉后当冷盘配黑麦面包。",
  "storage": "冷藏可放三天，冷冻可放一个月；复热用烤箱一百八十度烤八分钟。",
