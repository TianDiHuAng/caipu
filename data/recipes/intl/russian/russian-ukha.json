 "steps": [
  {
   "n": 1,
   "text": "鳕鱼切大块，用盐和黑胡椒略腌。，火候要稳，别忽大忽小。",
   "time_min": 8,
   "heat": "无火",
   "tip": "腌十分钟去腥，别腌太久。，火候要稳，别忽大忽小。",
   "visual_cue": "鱼块紧实，表面微湿"
  },
  {
   "n": 2,
   "text": "锅里加清水，放洋葱和香叶煮开。，火候要稳，别忽大忽小。",
   "time_min": 8,
   "heat": "大火",
   "tip": "冷水下锅，汤更清。，火候要稳，别忽大忽小。",
   "visual_cue": "汤面翻滚，香气升起"
  },
  {
   "n": 3,
   "text": "转小火煮十分钟，撇净浮沫。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "小火",
   "tip": "浮沫撇净，汤才不浑。，火候要稳，别忽大忽小。",
   "visual_cue": "汤色清亮，浮沫成团"
  },
  {
   "n": 4,
   "text": "加土豆块和胡萝卜片，煮十五分钟。，火候要稳，别忽大忽小。",
   "time_min": 17,
   "heat": "小火",
   "tip": "土豆切大小一致，熟得才匀。，火候要稳，别忽大忽小。",
   "visual_cue": "土豆微软，筷子可插"
  },
  {
   "n": 5,
   "text": "放鱼块，小火煮八分钟，别搅动。，火候要稳，别忽大忽小。",
   "time_min": 10,
   "heat": "小火",
   "tip": "一搅鱼就散，汤会浑。，火候要稳，别忽大忽小。",
   "visual_cue": "鱼块发白，边缘微卷"
  },
  {
   "n": 6,
   "text": "尝味补盐，关火撒莳萝。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "莳萝关火后放，香气才留。，火候要稳，别忽大忽小。",
   "visual_cue": "汤色清澈，绿点浮动"
  },
  {
   "n": 7,
   "text": "盛碗挤一点柠檬汁上桌。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "柠檬提鲜，别早放。，火候要稳，别忽大忽小。",
   "visual_cue": "汤面油花，酸香扑鼻"
  }
 ],
 "tips": [
  "冷水下锅，汤才清。，这一点很关键。",
  "鱼块下锅后别搅，保持完整。，这一点很关键。",
  "莳萝关火后放，香气才不跑。，这一点很关键。"
 ],
 "common_mistakes": [
  "大火滚煮，鱼肉碎成渣。，这一点很关键。",
  "浮沫没撇，汤浑味腥。，这一点很关键。",
  "盐放太早，鱼肉发柴。，这一点很关键。"
 ],
