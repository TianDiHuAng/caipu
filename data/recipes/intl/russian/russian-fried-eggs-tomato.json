        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "锅铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄切成半厘米厚的圆片，洋葱切成细丝，鸡蛋先磕进小碗备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "鸡蛋先磕进碗里，坏蛋不会毁掉整锅。",
      "visual_cue": "番茄片厚薄一致，蛋黄完整"
    },
    {
      "n": 2,
      "text": "平底锅放黄油和植物油，小火化开后下洋葱丝炒三分钟至透明。",
      "time_min": 4,
      "heat": "小火",
      "tip": "黄油掺一点植物油一起用，煎的时候不容易焦。",
      "visual_cue": "洋葱丝软塌透明，香气微甜"
    },
    {
      "n": 3,
      "text": "把番茄片平铺在锅里，撒一半的盐，中火煎三分钟至底面微软。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄片先煎一面，出汁后才不水汪汪。",
      "visual_cue": "番茄片边缘软塌，锅底有红汁"
    },
    {
      "n": 4,
      "text": "翻面再煎两分钟，用锅铲把番茄片轻轻压一压让它出更多汁。",
      "time_min": 2,
      "heat": "中火",
      "tip": "轻压出汁，蛋液才能吸到番茄的酸甜。",
      "visual_cue": "番茄软塌出汁，锅底泛红"
    },
    {
      "n": 5,
      "text": "把鸡蛋分别磕进锅里的空位，撒剩下的盐和黑胡椒，转小火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蛋磕在空位别压番茄，蛋白才摊得开。",
      "visual_cue": "蛋白铺开，蛋黄完整立在中间"
    },
    {
      "n": 6,
      "text": "盖盖焖四分钟，让蒸汽把蛋白焖到全熟，蛋黄还留一点软。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盖盖小火焖，比大火直煎更容易控制熟度。",
      "visual_cue": "蛋白全白凝固，蛋黄表面结薄膜"
    },
    {
      "n": 7,
      "text": "撒欧芹碎，连锅端上桌，配几片烤脆的黑麦薄片蘸着蛋黄吃。",
      "time_min": 1,
      "heat": "无火",
      "tip": "离火就上桌，蛋黄凉了会发硬，口感变差。",
      "visual_cue": "蛋面撒满绿碎，锅边微焦"
    }
  ],
  "tips": [
    "番茄先煎出汁，蛋液吸了汁才不寡淡。",
    "黄油掺一点植物油，煎的时候不容易焦黑。",
    "鸡蛋先磕进小碗，避免坏蛋毁掉整锅。",
    "盖盖小火焖，蛋白熟透蛋黄还留软心。"
  ],
  "common_mistakes": [
    "番茄切太薄，煎两下就化成水找不着。",
    "只用黄油大火煎，锅底很快焦黑发苦。",
    "鸡蛋直接磕进锅，蛋壳掉进去挑半天。",
    "大火煎到蛋黄全硬，吃起来像橡皮，毫无嫩感。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "彩椒",
      "ratio": "300克:250克",
      "note": "切条煎软，甜味更突出。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "20克:20毫升",
      "note": "更清爽，香气稍逊。"
    }
  ],
  "variations": [
    "加两片煎过的酸黄瓜，酸味更开胃，也不腻口。",
    "撒一把擦碎的奶酪盖盖焖化，多一层咸香。",
    "把番茄换成西葫芦片，做成夏天版本。"
  ],
  "serving_suggestion": "直接连锅端上桌，配烤脆的黑麦薄片蘸蛋黄，再倒一杯热茶就是俄式周末早餐。",
  "storage": "现做现吃，冷藏不超过一天，复热用平底锅加盖小火两分钟。",
