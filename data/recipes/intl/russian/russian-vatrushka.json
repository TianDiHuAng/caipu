 "steps": [
  {
   "n": 1,
   "text": "温牛奶加酵母和一勺白糖，静置十分钟起泡。，火候要稳，别忽大忽小。",
   "time_min": 11,
   "heat": "无火",
   "tip": "牛奶别超过四十度，会烫死酵母。，火候要稳，别忽大忽小。",
   "visual_cue": "表面浮沫，酵母活跃"
  },
  {
   "n": 2,
   "text": "加面粉、剩余白糖、盐、鸡蛋和软化黄油，揉成光滑面团。",
   "time_min": 12,
   "heat": "无火",
   "tip": "揉到能拉出薄膜，面团才松软。，火候要稳，别忽大忽小。",
   "visual_cue": "面团光滑，不粘手，这一点很关键。"
  },
  {
   "n": 3,
   "text": "盖布发酵一小时，到体积两倍。，火候要稳，别忽大忽小。",
   "time_min": 62,
   "heat": "无火",
   "tip": "温度低就多等一会儿。，火候要稳，别忽大忽小。",
   "visual_cue": "面团膨胀，指压回弹"
  },
  {
   "n": 4,
   "text": "奶油奶酪加一勺白糖拌顺滑，冷藏备用。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "馅别太稀，烤时会流。，火候要稳，别忽大忽小。",
   "visual_cue": "馅料浓稠，能立住，这一点很关键。"
  },
  {
   "n": 5,
   "text": "面团分成六份，搓圆压出中间凹陷。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "无火",
   "tip": "凹陷深一点，馅才装得住。，火候要稳，别忽大忽小。",
   "visual_cue": "圆饼整齐，坑位居中"
  },
  {
   "n": 6,
   "text": "把奶酪馅舀进凹陷，边缘刷蛋液。，火候要稳，别忽大忽小。",
   "time_min": 5,
   "heat": "无火",
   "tip": "馅别装太满，烤时会溢出。，火候要稳，别忽大忽小。",
   "visual_cue": "馅面平整，边缘发亮"
  },
  {
   "n": 7,
   "text": "烤箱一百八十度烤十八分钟，到边缘金黄。，火候要稳，别忽大忽小。",
   "time_min": 20,
   "heat": "无火",
   "tip": "烤到边缘上色就够，馅会略微膨胀。，火候要稳，别忽大忽小。",
   "visual_cue": "表皮金黄，馅心微鼓"
  },
  {
   "n": 8,
   "text": "出炉趁热刷一层蜂蜜水，放架冷却。，火候要稳，别忽大忽小。",
   "time_min": 8,
   "heat": "无火",
   "tip": "刷蜜增加光泽，凉了再收。，火候要稳，别忽大忽小。",
   "visual_cue": "表面油亮，香气扑鼻"
  }
 ],
 "tips": [
  "牛奶温度别过高，否则酵母死掉。，这一点很关键。",
  "面团揉到出膜，口感才松软。，这一点很关键。",
  "馅别装太满，烤时会溢出。，这一点很关键。"
 ],
 "common_mistakes": [
  "酵母被烫死，面团发不起来。，这一点很关键。",
  "馅太稀，烤完全流出来。，这一点很关键。",
  "烤过头，底部干硬。，这一点很关键。"
 ],
