  "steps": [
    {
      "n": 1,
      "text": "土豆带皮放进冷水锅，水面没过三指，大火煮开转中火煮二十分钟。",
      "time_min": 22,
      "heat": "中火",
      "tip": "带皮煮土豆不容易吸水变糊，切丁才利落。",
      "visual_cue": "筷子能轻松插透土豆中心"
    },
    {
      "n": 2,
      "text": "同一锅里放入胡萝卜和鸡蛋煮十分钟，捞出后全部摊开晾凉。",
      "time_min": 11,
      "heat": "中火",
      "tip": "鸡蛋和胡萝卜一起煮，省火也省时间。",
      "visual_cue": "胡萝卜软透，鸡蛋壳好剥"
    },
    {
      "n": 3,
      "text": "晾透的土豆、胡萝卜和鸡蛋都切成半厘米见方的小丁，大小尽量一致。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丁切得一样大，拌开后才好看，入口也均匀。",
      "visual_cue": "三种丁大小均匀，边角整齐"
    },
    {
      "n": 4,
      "text": "酸黄瓜切成同样大小的丁，用厨房纸吸掉表面多余的水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸黄瓜不吸干，沙拉很快就会出水变稀。",
      "visual_cue": "黄瓜丁干爽，不挂水珠"
    },
    {
      "n": 5,
      "text": "大碗里放蛋黄酱和酸奶油，加盐和黑胡椒搅成顺滑的白色沙拉酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "两种酱先调匀，拌出来的沙拉才不花。",
      "visual_cue": "酱体洁白顺滑，无颗粒"
    },
    {
      "n": 6,
      "text": "把所有切好的丁倒进碗里，从底部往上翻拌到每一块都裹上酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻拌的时候别用力压，土豆一压就散成泥，卖相全失。",
      "visual_cue": "所有丁均匀裹酱，没有干块"
    },
    {
      "n": 7,
      "text": "撒上小葱末，装盘后冷藏十分钟再上桌，风味会更融合。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏一会儿让酱味渗进去，口感更清爽。",
      "visual_cue": "沙拉表面撒满绿末，整体紧实"
    }
  ],
  "tips": [
    "土豆一定带皮煮，去皮煮会吸一肚子水，切丁就散。",
    "所有材料都要彻底晾凉再拌，热的时候拌酱会出水。",
    "酸黄瓜丁先吸干水分，沙拉才放得住不返稀。",
    "蛋黄酱和酸奶油先调匀，再一次性拌进材料里更均匀。"
  ],
  "common_mistakes": [
    "土豆煮好趁热就拌，酱被热气逼出一碗水。",
    "丁切得大大小小，端上桌卖相全无，口感也不齐。",
    "酸黄瓜带水下锅，沙拉半小时就变汤。",
    "用力压着拌，土豆全被压成泥浆，沙拉变糊。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "酸奶",
      "ratio": "50克:50克",
      "note": "选浓稠的原味，酸味更明显。"
    },
    {
      "original": "酸黄瓜",
      "substitute": "黄瓜",
      "ratio": "100克:100克",
      "note": "新鲜黄瓜需多加一克盐并尽快吃完。"
    }
  ],
  "variations": [
    "加一把煮熟的鸡胸肉丁，就变成更丰盛的首都沙拉版本。",
    "把蛋黄酱换成一半酸奶油一半蛋黄酱，热量更低也更清爽。",
    "撒一点莳萝碎，香气更接近俄式家常做法的味道。"
  ],
  "serving_suggestion": "装在小碗里压实后倒扣成圆顶，配黑麦面包和一杯热茶，是俄式冷盘里的第一道。",
  "storage": "冷藏密封可放一天半，酱多容易出水，吃前翻拌一次，不建议冷冻。",
