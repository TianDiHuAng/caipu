  "equipment": [
    "平底锅",
    "压板",
    "刀",
    "砧板",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉从内侧划开，压平成整片。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "压平更易受热均匀。，火候要稳，别忽大忽小。",
      "visual_cue": "肉片平整，厚薄一致"
    },
    {
      "n": 2,
      "text": "两面抹盐和黑胡椒，腌十五分钟。，火候要稳，别忽大忽小。",
      "time_min": 17,
      "heat": "无火",
      "tip": "盐腌入味，皮更紧实。，火候要稳，别忽大忽小。",
      "visual_cue": "表面微湿，调味均匀"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油烧热，鸡皮朝下放入。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中火",
      "tip": "皮朝下先煎，油脂才出。，火候要稳，别忽大忽小。",
      "visual_cue": "鸡皮收缩，油花四溅"
    },
    {
      "n": 4,
      "text": "上面压重物，中小火煎十二分钟。，火候要稳，别忽大忽小。",
      "time_min": 14,
      "heat": "中小火",
      "tip": "压住煎，肉面才贴锅焦香。，火候要稳，别忽大忽小。",
      "visual_cue": "鸡皮金黄，压板下沉"
    },
    {
      "n": 5,
      "text": "翻面再煎八分钟，倒掉多余油。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "中火",
      "tip": "倒掉余油，成品才不腻。，火候要稳，别忽大忽小。",
      "visual_cue": "两面焦黄，肉汁清亮"
    },
    {
      "n": 6,
      "text": "加大蒜泥和黄油，倾斜锅淋油三次。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "淋油上色，蒜香才透。，火候要稳，别忽大忽小。",
      "visual_cue": "蒜香四溢，表皮油亮"
    },
    {
      "n": 7,
      "text": "番茄切厚片，放锅里煎到软。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄煎过，酸甜更浓。，火候要稳，别忽大忽小。",
      "visual_cue": "表面起皱，汁水渗出"
    },
    {
      "n": 8,
      "text": "鸡斩块装盘，撒莳萝配番茄。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热斩块，皮才不软。，火候要稳，别忽大忽小。",
      "visual_cue": "皮脆肉嫩，香气扑鼻"
    }
  ],
  "tips": [
    "一定要压着煎，肉面才焦香。，这一点很关键。",
    "鸡皮朝下先煎，油才出得足。，这一点很关键。",
    "大蒜最后放，早了会发苦。，这一点很关键。"
  ],
  "common_mistakes": [
    "不压重物，肉卷成一团。，这一点很关键。",
    "火太大，皮焦里面生。，这一点很关键。",
    "蒜早放，炒糊发苦。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "800 克:800 克",
      "note": "脂肪少，煎的时间缩短三分钟。"
    },
    {
      "original": "莳萝",
      "substitute": "百里香",
      "ratio": "5 克:5 克",
      "note": "香气更浓，用量减半。"
    }
  ],
  "variations": [
    "腌时加辣椒粉，风味更冲。，这一点很关键。",
    "配蒜香酸奶酱一起吃。，这一点很关键。"
  ],
  "serving_suggestion": "配烤土豆和酸黄瓜，上手撕着吃。，这一点很关键。",
  "storage": "冷藏两天，复热用平底锅。，这一点很关键。",
