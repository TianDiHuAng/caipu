  "steps": [
    {
      "n": 1,
      "text": "卷心菜去掉硬芯切成半厘米宽的粗丝，洋葱切丝，胡萝卜擦成细丝。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切粗丝炖完还有口感，切细丝会烂成一锅糊。",
      "visual_cue": "菜丝宽窄一致，堆成小山"
    },
    {
      "n": 2,
      "text": "深锅小火化开黄油，下洋葱丝和胡萝卜丝炒五分钟至软塌出甜香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "胡萝卜擦丝更容易炒出橙红色的油，颜色更漂亮。",
      "visual_cue": "锅底油泛橙红，洋葱透明"
    },
    {
      "n": 3,
      "text": "倒入番茄块炒三分钟，炒到番茄塌软出汁，锅底形成一层红色汤底。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄炒出汁再下菜，味道才融得进去。",
      "visual_cue": "番茄化开，锅底有红色汤汁"
    },
    {
      "n": 4,
      "text": "把卷心菜丝全部倒进锅里，转中火翻炒五分钟，炒到体积缩小一半。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先炒软再加盖炖，出来才不水汪汪，味也浓。",
      "visual_cue": "菜丝体积缩半，颜色变透"
    },
    {
      "n": 5,
      "text": "加盐、白糖、白醋和黑胡椒翻匀，倒入两勺清水，盖上锅盖。",
      "time_min": 2,
      "heat": "中火",
      "tip": "一点白醋能保住卷心菜的浅绿色，不发黄发暗。",
      "visual_cue": "调味均匀，锅底有浅汤"
    },
    {
      "n": 6,
      "text": "转小火炖二十分钟，中途开盖翻两次，让菜丝均匀受热。",
      "time_min": 21,
      "heat": "小火",
      "tip": "中途翻两次就够，翻太勤菜丝会碎，卖相变差。",
      "visual_cue": "菜丝软透透明，锅底汤汁收薄"
    },
    {
      "n": 7,
      "text": "开盖转大火收汁三分钟，撒莳萝碎翻匀，连锅端上桌。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁到锅底只剩一层润就好，别收干。",
      "visual_cue": "菜丝油亮，锅底留薄汁"
    }
  ],
  "tips": [
    "卷心菜切粗丝，炖完还有嚼感不会成糊。",
    "胡萝卜擦丝炒，锅里的油会染成漂亮的橙色。",
    "番茄先炒出汁再下菜，整锅的底味才够厚实。",
    "一点白醋能让卷心菜保持浅绿不发黄。"
  ],
  "common_mistakes": [
    "卷心菜切得像碎末，炖完只剩一锅菜泥。",
    "菜丝没炒软就加水，炖出来汤多味淡。",
    "全程大火猛炖不转小火，锅底很快结一层焦。",
    "一滴醋都不加，卷心菜炖完颜色发黄发暗。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30克:25毫升",
      "note": "更清淡，也适合全素饮食。"
    },
    {
      "original": "白醋",
      "substitute": "柠檬",
      "ratio": "10毫升:四分之一柠檬的汁",
      "note": "酸味更清，香气更好。"
    }
  ],
  "variations": [
    "加一把泡软的蘑菇同炖，鲜味明显提升。",
    "放两片酸黄瓜连汁一起炖，酸香更突出。",
    "最后加一勺酸奶油拌开，口感更圆润。"
  ],
  "serving_suggestion": "连锅端上桌，配煎香肠、烤鸡或荞麦饭，冬天吃最能暖胃。",
  "storage": "冷藏可放三天，冷冻可放一个月；复热用深锅小火加两勺清水慢炖。",
