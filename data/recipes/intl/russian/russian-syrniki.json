  "id": "russian-syrniki",
  "name": {
    "zh": "俄式奶酪煎饼",
    "en": "Russian Cheese Pancakes (Syrniki)",
    "original": "Сырники"
  },
  "cuisine": {
    "region": "intl",
    "style": "russian"
  },
  "category": [
    "breakfast",
    "dessert"
  ],
  "difficulty": 1,
  "time": {
    "prep_min": 20,
    "cook_min": 22,
    "total_min": 42
  },
  "servings": 3,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 400,
          "unit": "g",
          "note": "无盐干酪",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 70,
          "unit": "g",
          "note": "分次用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "打散",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 120,
          "unit": "g",
          "note": "佐食",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "平底锅",
    "锅铲",
    "筛网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶酪放进大碗里，用叉子压散成粗颗粒状态。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别压成糊状，留一点颗粒口感才好。",
      "visual_cue": "奶酪松散，颗粒分明"
    },
    {
      "n": 2,
      "text": "加入鸡蛋、白糖与盐，再用叉子顺着一个方向拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到白糖化开就行，别过度搅打。",
      "visual_cue": "混合物顺滑，糖粒看不见"
    },
    {
      "n": 3,
      "text": "筛入五十克面粉，用勺子翻拌到没有干粉为止。",
      "time_min": 4,
      "heat": "无火",
      "tip": "翻拌而不揉搓，饼身才不会发硬。",
      "visual_cue": "面糊挂勺，略显黏手"
    },
    {
      "n": 4,
      "text": "分成八份，手上沾面粉搓圆再压成一厘米厚。",
      "time_min": 8,
      "heat": "无火",
      "tip": "手上沾点面粉防粘，饼坯才圆整。",
      "visual_cue": "饼坯圆厚一致，表面微干"
    },
    {
      "n": 5,
      "text": "把饼坯两面薄薄裹一层面粉，抖掉多余的粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄薄裹一层就够，面粉多了会发硬。",
      "visual_cue": "表面泛白薄粉，摸起来干爽"
    },
    {
      "n": 6,
      "text": "平底锅倒入植物油，开中小火烧到锅面温热不冒烟。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "油温别太高，奶酪容易外焦内生。",
      "visual_cue": "锅面油光微动，手放上方有热感"
    },
    {
      "n": 7,
      "text": "把饼坯逐个放入锅中，中小火每面各煎三分钟至金黄。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "一面定住再翻面，翻早了整块会散。",
      "visual_cue": "底面金黄定型，边缘微鼓"
    },
    {
      "n": 8,
      "text": "盖上锅盖转小火焖两分钟，让饼的中心也彻底热透。",
      "time_min": 2,
      "heat": "小火",
      "tip": "加盖焖一下，饼的中心才不会夹生。",
      "visual_cue": "饼身鼓起，表面微微发亮"
    },
    {
      "n": 9,
      "text": "装盘趁热配一勺冰酸奶，再撒少许白糖就可以上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶要用冰的，冷热搭配才好吃。",
      "visual_cue": "饼色金黄，酸奶雪白"
    }
  ],
  "tips": [
    "奶酪要压散不要压成糊，留颗粒口感才松。",
    "面粉分次筛入，拌到无干粉就停手。",
    "中小火慢慢煎，中心才熟透不焦。"
  ],
  "common_mistakes": [
    "面糊揉得太久，煎出来硬得像饼砖。",
    "火太大，外面焦黑里面还是凉心。",
    "饼坯太厚，两面焦了中心还夹生。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "酸奶",
      "ratio": "400 克:400 克（需沥干一夜）",
      "note": "水分多，面粉要加到八十克。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "40 克:45 克",
      "note": "风味更润，甜度略低。"
    }
  ],
  "variations": [
    "面团里加一把葡萄干，酸甜更有层次。",
    "煎好后淋一勺蜂蜜，配酸奶油吃更地道。"
  ],
  "serving_suggestion": "热饼三块装盘，旁边一勺冰酸奶，早餐或下午茶都合适。",
  "storage": "冷藏两天，复热用平底锅小火两面各煎一分钟。",
