        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "烤箱",
    "擀面杖",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温牛奶加白糖和酵母静置八分钟，表面起一层泡沫。",
      "time_min": 10,
      "heat": "无火",
      "tip": "牛奶温而不烫，太热会把酵母烫死。",
      "visual_cue": "表面泡沫细密均匀"
    },
    {
      "n": 2,
      "text": "中筋面粉过筛加盐，倒入酵母牛奶和一个鸡蛋揉成面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "先拌成絮状再揉，面团才会更均匀。",
      "visual_cue": "面团成团，不粘盆壁"
    },
    {
      "n": 3,
      "text": "加入软化的黄油继续揉十分钟，揉到面团光滑。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黄油要软化到手指能按出坑再揉。",
      "visual_cue": "面团光滑，有弹性"
    },
    {
      "n": 4,
      "text": "盖上布发酵一小时，面团膨胀到原来两倍大小时取用。",
      "time_min": 62,
      "heat": "无火",
      "tip": "放在温暖的地方发酵，别放在通风口。",
      "visual_cue": "面团膨大到了两倍大"
    },
    {
      "n": 5,
      "text": "洋葱碎用植物油小火炒软放凉，和牛肉、盐、黑胡椒拌成馅。",
      "time_min": 10,
      "heat": "小火",
      "tip": "洋葱要放凉再拌肉，否则会把肉烫熟。",
      "visual_cue": "馅料均匀，洋葱透明"
    },
    {
      "n": 6,
      "text": "面团排气后分成十二份，擀成中间略厚的圆皮包入馅料。",
      "time_min": 12,
      "heat": "无火",
      "tip": "边缘捏紧收口，烤时馅汁才不会流。",
      "visual_cue": "包成半月形，收口严实"
    },
    {
      "n": 7,
      "text": "烤盘铺纸摆入包子，表面刷上蛋液后醒发十五分钟。",
      "time_min": 17,
      "heat": "无火",
      "tip": "刷蛋液前先醒发，表面才均匀饱满。",
      "visual_cue": "包子饱满，表面油亮"
    },
    {
      "n": 8,
      "text": "烤箱两百度烤二十五分钟，表皮金黄即可出炉。",
      "time_min": 25,
      "heat": "中火",
      "tip": "最后五分钟看上色，太深要加盖锡纸。",
      "visual_cue": "表皮金黄，鼓起有弹性"
    }
  ],
  "tips": [
    "牛奶温热不烫手再化酵母，太热会把酵母烫死。",
    "洋葱炒好要放凉再拌肉，否则会把肉馅烫熟。",
    "收口一定要捏紧，否则烤的时候馅汁会流出来。"
  ],
  "common_mistakes": [
    "酵母被烫死，发酵一小时面团还是没长大。",
    "收口没捏紧，烤的时候馅汁流出弄脏烤盘。",
    "馅料水分太多，包子底部被浸湿发黏。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "350 克:350 克",
      "note": "香气更重，需多加洋葱。"
    },
    {
      "original": "中筋面粉",
      "substitute": "高筋面粉",
      "ratio": "450 克:450 克",
      "note": "皮更有嚼劲，需多加点牛奶。"
    }
  ],
  "variations": [
    "用卷心菜和煮鸡蛋做素馅，是俄式常见的素食版本。",
    "包好后油炸而不是烤，外壳更酥脆。"
  ],
  "serving_suggestion": "趁热配一杯红茶或酸奶油，是俄罗斯街头最经典的随手小吃。",
  "storage": "冷藏两天，复热用烤箱一百八十度八分钟；也可冷冻生坯，想吃时直接烤。",
