  "equipment": [
    "刨丝器",
    "碗",
    "平底锅",
    "纱布",
    "铲子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮擦成细丝，泡冷水五分钟去表面粉质。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡水去掉表面粉质，饼才不黑。",
      "visual_cue": "水变浑浊，丝色发白"
    },
    {
      "n": 2,
      "text": "用纱布包住土豆丝，用力挤干水分。，火候宁小勿大，慢慢推进。",
      "time_min": 6,
      "heat": "无火",
      "tip": "挤得越干，饼越脆。，注意锅里温度别掉下来。",
      "visual_cue": "丝体干爽，挤不出水"
    },
    {
      "n": 3,
      "text": "洋葱擦丝，和土豆丝一起拌匀。，始终中小火，别心急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "洋葱出水，帮助粘合。，火要均匀，食材才不糊。",
      "visual_cue": "混合均匀，质地湿润"
    },
    {
      "n": 4,
      "text": "加鸡蛋、面粉、盐和黑胡椒拌成糊。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面粉别多，多了发硬。，全程留意火候，别贪快。",
      "visual_cue": "糊体黏稠，能挂住丝"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油烧热，舀一勺面糊摊成圆饼。",
      "time_min": 6,
      "heat": "中火",
      "tip": "一勺一饼，厚薄才一致。，火大了就离锅远一点。",
      "visual_cue": "边缘定型，底面金黄"
    },
    {
      "n": 6,
      "text": "中小火煎三分钟，翻面再煎两分钟。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "别急着翻，定型后再动。，锅温要匀，别忽高忽低。",
      "visual_cue": "两面金黄，边缘酥脆"
    },
    {
      "n": 7,
      "text": "煎好放厨房纸上吸油。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "吸掉浮油，吃着不腻。，火候宁小勿大，慢慢推进。",
      "visual_cue": "表面干爽，油迹减少"
    },
    {
      "n": 8,
      "text": "趁热装盘，配一勺酸奶油。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃，凉了会软。，始终中小火，别心急。",
      "visual_cue": "外脆内软，奶香解腻"
    }
  ],
  "tips": [
    "土豆丝一定要挤干水，饼才脆。，这里最容易翻车。",
    "面粉少放，多了像面饼。，别小看这一步。",
    "中小火慢煎，里面才熟透。，成败就在这一步。"
  ],
  "common_mistakes": [
    "不挤水，下锅就散。，这点要注意。",
    "面粉放太多，口感发硬。，这是关键点。",
    "火太大，外焦里生。，别嫌麻烦，做完它。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "酸奶",
      "ratio": "120 克:120 克",
      "note": "更清爽，酸度略高。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "700 克:700 克",
      "note": "甜度高，盐可减一克。"
    }
  ],
  "variations": [
    "加一点蒜泥，香气更足。，这一步别省。",
    "中间夹奶酪丝，煎到拉丝。，别跳过这步。"
  ],
  "serving_suggestion": "配酸奶油、莳萝和黑麦面包。，这步最关键。",
  "storage": "冷藏两天，复煎三分钟。，很多人在这里出错。",
