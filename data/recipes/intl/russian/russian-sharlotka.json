        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "打蛋器",
    "蛋糕模",
    "碗",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苹果去皮去核，切成薄片。，火大了就离锅远一点。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切薄一点，烤后才软。，火别开太大，稳着来。",
      "visual_cue": "果片均匀，厚度一致"
    },
    {
      "n": 2,
      "text": "鸡蛋加白糖和盐，高速打到发白膨胀。，锅温要匀，别忽高忽低。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打到画痕不消，蛋糕才蓬。，火力保持中等，慢慢来。",
      "visual_cue": "蛋糊发白，体积翻倍"
    },
    {
      "n": 3,
      "text": "面粉和泡打粉过筛，分两次翻拌进去。，火候宁小勿大，慢慢推进。",
      "time_min": 5,
      "heat": "无火",
      "tip": "翻拌别画圈，免得消泡。，注意锅里温度别掉下来。",
      "visual_cue": "面糊细腻，无干粉，这点要注意。"
    },
    {
      "n": 4,
      "text": "模具抹黄油，苹果片铺满底部。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "铺满底部，果香才透上来。，火要均匀，食材才不糊。",
      "visual_cue": "果片平整，覆盖均匀"
    },
    {
      "n": 5,
      "text": "面糊倒在苹果上，轻震两下排气。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "无火",
      "tip": "震出大气泡，组织才细。，全程留意火候，别贪快。",
      "visual_cue": "表面平整，气泡减少"
    },
    {
      "n": 6,
      "text": "一百八十度烤四十分钟，牙签插入不粘。，火大了就离锅远一点。",
      "time_min": 42,
      "heat": "无火",
      "tip": "牙签干净就熟了。，火别开太大，稳着来。",
      "visual_cue": "表面金黄，按压回弹"
    },
    {
      "n": 7,
      "text": "出炉倒扣放凉，脱模切块。，锅温要匀，别忽高忽低。",
      "time_min": 15,
      "heat": "无火",
      "tip": "倒扣放凉，蛋糕才不塌。，火力保持中等，慢慢来。",
      "visual_cue": "脱模完整，切面湿润"
    }
  ],
  "tips": [
    "蛋糊要打到发白，蛋糕才蓬松。，这是关键点。",
    "苹果铺底，果香才集中。，别嫌麻烦，做完它。",
    "出炉倒扣，防止回缩。，这一步别省。"
  ],
  "common_mistakes": [
    "蛋没打发，蛋糕像饼。，别跳过这步。",
    "翻拌画圈，面糊消泡。，这步最关键。",
    "烤好不倒扣，中间塌陷。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "梨",
      "ratio": "800 克:800 克",
      "note": "水分更多，面粉加二十克。"
    },
    {
      "original": "泡打粉",
      "substitute": "小苏打",
      "ratio": "4 克:3 克",
      "note": "需搭配酸性水果才起效。"
    }
  ],
  "variations": [
    "加肉桂粉，香气更暖。，这里最容易翻车。",
    "表面撒杏仁片，口感更丰富。，别小看这一步。"
  ],
  "serving_suggestion": "放凉切块，配一杯红茶。，成败就在这一步。",
  "storage": "冷藏三天，回温再吃。，这点要注意。",
