  "steps": [
    {
      "n": 1,
      "text": "蜂蜜、白糖和黄油隔水加热到融化融合。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "小火",
      "tip": "别沸腾，蜂蜜一焦就发苦。，火候要稳，别忽大忽小。",
      "visual_cue": "液体顺滑，颜色琥珀"
    },
    {
      "n": 2,
      "text": "离火稍凉，分次加鸡蛋搅匀。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "太烫会烫熟蛋液。，火候要稳，别忽大忽小。",
      "visual_cue": "蛋液融合，无颗粒，这一点很关键。"
    },
    {
      "n": 3,
      "text": "筛入面粉、泡打粉、可可粉和盐，揉成软面团。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面团偏软是正常的，别加粉。，火候要稳，别忽大忽小。",
      "visual_cue": "面团光滑，手感柔软"
    },
    {
      "n": 4,
      "text": "面团分八份，冷藏三十分钟。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冷藏后擀开才不粘。，火候要稳，别忽大忽小。",
      "visual_cue": "面团硬实，易成型，这一点很关键。"
    },
    {
      "n": 5,
      "text": "每份擀成薄圆片，用盘子压出边缘。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "擀得越薄，层次越好看。，火候要稳，别忽大忽小。",
      "visual_cue": "薄片均匀，边缘整齐"
    },
    {
      "n": 6,
      "text": "烤箱一百八十度，每片烤五分钟。，火候要稳，别忽大忽小。",
      "time_min": 42,
      "heat": "无火",
      "tip": "烤到边缘深金就够，凉了会脆。，火候要稳，别忽大忽小。",
      "visual_cue": "饼片金褐，边缘微焦"
    },
    {
      "n": 7,
      "text": "淡奶油打到七分发，能挂住抹刀。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "太硬抹不开，会拽坏饼片。，火候要稳，别忽大忽小。",
      "visual_cue": "奶油蓬松，纹路清晰"
    },
    {
      "n": 8,
      "text": "一层饼片一层奶油叠起，边缘也抹匀。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "奶油别省，太少饼片会干。，火候要稳，别忽大忽小。",
      "visual_cue": "层次平整，奶油外露"
    },
    {
      "n": 9,
      "text": "剩余饼片压碎撒面，冷藏四小时定型。，火候要稳，别忽大忽小。",
      "time_min": 245,
      "heat": "无火",
      "tip": "冷藏够久，切时才不塌。，火候要稳，别忽大忽小。",
      "visual_cue": "表面粗糙，蛋糕挺立"
    }
  ],
  "tips": [
    "糕体薄一点，层次才好看。，这一点很关键。",
    "奶油打到七分发，抹开不拽饼。，这一点很关键。",
    "冷藏四小时以上再切，切面才整齐。"
  ],
  "common_mistakes": [
    "蜂蜜烧焦，整锅发苦。，这一点很关键。",
    "奶油太硬，饼片被拽裂。，这一点很关键。",
    "没冷藏就切，蛋糕全塌。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "酸奶油",
      "ratio": "500 毫升:500 克",
      "note": "酸味更明显，糖加三十克。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "120 克:110 克",
      "note": "少了蜜香，需加二十毫升牛奶。"
    }
  ],
  "variations": [
    "夹层加一层覆盆子果酱，酸甜更明显。",
    "表面撒坚果碎，口感更丰富。，这一点很关键。"
  ],
  "serving_suggestion": "冷藏后切块，配无糖红茶解甜。，这一点很关键。",
  "storage": "冷藏三天，风味融合后更好吃。，这一点很关键。",
