        }
      ]
    }
  ],
  "equipment": [
    "刀",
    "砧板",
    "保鲜膜",
    "肉锤",
    "深锅",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油切成长条，拌入莳萝和柠檬汁，冷冻二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "黄油必须冻硬，炸时才不漏。，火候要稳，别忽大忽小。",
      "visual_cue": "黄油条硬实，香草分布均匀"
    },
    {
      "n": 2,
      "text": "鸡胸横片成两片，用肉锤轻拍到半厘米厚。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拍薄但别拍破，破了就漏油。，火候要稳，别忽大忽小。",
      "visual_cue": "肉片平整，无穿孔，这一点很关键。"
    },
    {
      "n": 3,
      "text": "肉片撒盐和黑胡椒，放上冻黄油条。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油放正中间，卷起来才匀。，火候要稳，别忽大忽小。",
      "visual_cue": "调味均匀，黄油居中"
    },
    {
      "n": 4,
      "text": "从一侧卷紧，用保鲜膜定型冷藏十五分钟。，火候要稳，别忽大忽小。",
      "time_min": 17,
      "heat": "无火",
      "tip": "卷得越紧，炸时越不易散。，火候要稳，别忽大忽小。",
      "visual_cue": "肉卷紧实，两端封口"
    },
    {
      "n": 5,
      "text": "肉卷依次拍面粉、蘸蛋液、裹面包糠。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "三层都裹全，炸衣才不漏。，火候要稳，别忽大忽小。",
      "visual_cue": "表面均匀，无裸露处"
    },
    {
      "n": 6,
      "text": "深锅倒油烧到一百七十度。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中火",
      "tip": "没温度计就丢一小块面包糠试。，火候要稳，别忽大忽小。",
      "visual_cue": "糠粒冒泡，油面微动"
    },
    {
      "n": 7,
      "text": "下肉卷炸六分钟，翻面再炸四分钟。，火候要稳，别忽大忽小。",
      "time_min": 11,
      "heat": "中火",
      "tip": "油温别太高，皮焦了里面还没熟。，火候要稳，别忽大忽小。",
      "visual_cue": "外皮金黄，浮起明显"
    },
    {
      "n": 8,
      "text": "捞出沥油，静置三分钟再切。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置让黄油回流，切时才不喷。，火候要稳，别忽大忽小。",
      "visual_cue": "切开黄油流出，肉汁清亮"
    }
  ],
  "tips": [
    "黄油务必冻硬，卷紧再裹粉。，这一点很关键。",
    "油温一百七十度，太高外焦里生。，这一点很关键。",
    "切开前静置，黄油才不会喷溅。，这一点很关键。"
  ],
  "common_mistakes": [
    "黄油软化，炸时全漏出来。，这一点很关键。",
    "卷太松，炸衣裂开。，这一点很关键。",
    "油温过高，外皮焦黑里面夹生。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "700 克:700 克",
      "note": "去骨拍平，口感更嫩。"
    },
    {
      "original": "面包糠",
      "substitute": "面粉",
      "ratio": "120 克:100 克",
      "note": "外壳偏薄，口感更脆。"
    }
  ],
  "variations": [
    "黄油里加蒜末，香气更重。，这一点很关键。",
    "配蘑菇奶油汁，更接近餐厅版本。，这一点很关键。"
  ],
  "serving_suggestion": "切开让黄油流到盘里，配土豆泥。，这一点很关键。",
  "storage": "生坯冷冻一个月，现炸现吃。，这一点很关键。",
