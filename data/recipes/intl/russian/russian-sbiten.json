        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "木勺",
    "滤网",
    "马克杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅倒清水，放入姜片、肉桂与丁香，中火煮开后转小火煮十分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "香料要先煮出味，水开后转小火慢煨，香气才透。",
      "visual_cue": "水面微沸，香料香气漫开"
    },
    {
      "n": 2,
      "text": "关火，把蜂蜜倒进锅里，用木勺慢慢搅到完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蜂蜜不能大火久煮，高温会把香气煮跑，也会发酸。",
      "visual_cue": "汤色转成琥珀，甜香浮起"
    },
    {
      "n": 3,
      "text": "放入柠檬片与几粒黑胡椒，盖上锅盖浸五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "柠檬皮久煮会发苦，浸五分钟刚好带出清香。",
      "visual_cue": "汤面浮着柠檬片，颜色透亮"
    },
    {
      "n": 4,
      "text": "用细滤网把香料渣滤掉，滤进另一口干净的锅里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "滤干净喝起来才顺口，渣子留在里面会越泡越涩。",
      "visual_cue": "汤体清澈，无渣滓"
    },
    {
      "n": 5,
      "text": "小火加热到烫口但不要沸腾，闻到姜与蜂蜜的混合香气即可。",
      "time_min": 5,
      "heat": "小火",
      "tip": "不要煮沸，蜂蜜的风味在滚沸后会变得单薄。",
      "visual_cue": "表面冒细密热气，不翻滚"
    },
    {
      "n": 6,
      "text": "倒进马克杯，放一片柠檬与几片薄荷叶，趁热捧着喝。",
      "time_min": 3,
      "heat": "无火",
      "tip": "薄荷最后放，热气一冲香气就上来了。",
      "visual_cue": "杯中琥珀色，浮着绿薄荷"
    }
  ],
  "tips": [
    "蜂蜜用量按口味调，喜欢清爽可以减到八十克。",
    "加一小勺覆盆子果酱，是更接近老式的做法。",
    "感冒时加一片柠檬与更多姜，喝下去从喉咙暖到胃。",
    "冷饮版放凉后加冰块，夏天也很舒服。"
  ],
  "common_mistakes": [
    "蜂蜜一开始就下锅大火煮，甜味发酸，香气全无。",
    "香料煮太久，肉桂与丁香发苦，整锅饮料带涩味。",
    "柠檬连皮久煮，苦味压过蜂蜜的香。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "红糖",
      "ratio": "120克:100克",
      "note": "甜味更厚重，可多加一片柠檬。"
    },
    {
      "original": "肉桂",
      "substitute": "肉桂粉",
      "ratio": "5克:3克",
      "note": "粉末易浑汤，煮后需细滤。"
    }
  ],
  "variations": [
    "加一小杯红葡萄酒同煮，做成节庆版本的香料酒。",
    "用橙子替柠檬，果香更甜润，孩子更爱喝。"
  ],
  "serving_suggestion": "四杯热饮，配蜜饼或黑面包，是俄国冬天最经典的暖身饮。",
  "storage": "冷藏三天内喝完，复热时小火加热到烫口即可，不要煮沸。",
