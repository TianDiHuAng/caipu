    "打蛋器",
    "烤盘",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加冷黄油丁搓成粗砂状。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，层次才分明。，看住火，别让它失控。",
      "visual_cue": "颗粒粗砂，手感发凉"
    },
    {
      "n": 2,
      "text": "鸡蛋加白醋和盐打散，和面粉揉成团。，全程留意火候，别贪快。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别揉多，起筋就硬。，火大了就离锅远一点。",
      "visual_cue": "面团光滑，按压有坑"
    },
    {
      "n": 3,
      "text": "面团分八份，冷藏松弛一小时。，火别开太大，稳着来。",
      "time_min": 62,
      "heat": "无火",
      "tip": "松弛到位，擀开才不回缩。，锅温要匀，别忽高忽低。",
      "visual_cue": "面团变硬，按压回弹"
    },
    {
      "n": 4,
      "text": "每份擀成薄片，扎孔后二百度烤七分钟。，火力保持中等，慢慢来。",
      "time_min": 60,
      "heat": "无火",
      "tip": "烤到金黄，凉了才脆。，火候宁小勿大，慢慢推进。",
      "visual_cue": "薄片平整，颜色金黄"
    },
    {
      "n": 5,
      "text": "牛奶加白糖小火加热到微沸。，注意锅里温度别掉下来。",
      "time_min": 6,
      "heat": "小火",
      "tip": "牛奶别煮开，会起膜。，始终中小火，别心急。",
      "visual_cue": "边缘冒小泡，糖化开"
    },
    {
      "n": 6,
      "text": "鸡蛋打散，冲入热牛奶搅匀后回锅。，火要均匀，食材才不糊。",
      "time_min": 6,
      "heat": "小火",
      "tip": "边倒边搅，蛋才不会结块。，看住火，别让它失控。",
      "visual_cue": "液体顺滑，微稠挂勺"
    },
    {
      "n": 7,
      "text": "小火煮到浓稠，离火放凉。，全程留意火候，别贪快。",
      "time_min": 10,
      "heat": "小火",
      "tip": "煮到划痕能留住就好。，火大了就离锅远一点。",
      "visual_cue": "汤匙划痕清晰，这一步别省。"
    },
    {
      "n": 8,
      "text": "黄油软化打发，分次拌入凉卡仕达。，火别开太大，稳着来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "温度一致，才不会油水分离。，锅温要匀，别忽高忽低。",
      "visual_cue": "酱体蓬松，光泽细腻"
    },
    {
      "n": 9,
      "text": "淡奶油打到七分发，翻拌进卡仕达。，火力保持中等，慢慢来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "翻拌别搅，免得消泡。，火候宁小勿大，慢慢推进。",
      "visual_cue": "奶油厚实，能挂住，别跳过这步。"
    },
    {
      "n": 10,
      "text": "一层酥皮一层奶油叠起，留一层压碎。，注意锅里温度别掉下来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "奶油抹匀，切面才好看。，始终中小火，别心急。",
      "visual_cue": "层次平整，厚度均匀"
    },
    {
      "n": 11,
      "text": "碎酥皮撒满表面，冷藏六小时定型。，火要均匀，食材才不糊。",
      "time_min": 362,
      "heat": "无火",
      "tip": "冷藏过夜，酥皮才回软。，看住火，别让它失控。",
      "visual_cue": "表面均匀，切面整齐"
    }
  ],
  "tips": [
    "酥皮薄一点，回软才好吃。，这步最关键。",
    "奶油馅温度要和黄油一致。，很多人在这里出错。",
    "冷藏足够时间，切时才不散。，这里最容易翻车。"
  ],
  "common_mistakes": [
    "酥皮太厚，咬不动。，别小看这一步。",
    "馅料温度不一致，油水分离。，成败就在这一步。",
    "没冷藏就切，层次全散。，这点要注意。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "酸奶油",
      "ratio": "400 毫升:400 克",
      "note": "酸度更高，糖加十克。"
    },
    {
      "original": "白醋",
      "substitute": "柠檬汁",
      "ratio": "5 毫升:5 毫升",
      "note": "香气更清。"
    }
  ],
  "variations": [
    "加可可粉做成巧克力版。，这是关键点。",
    "表面撒核桃碎，口感更香。，别嫌麻烦，做完它。"
  ],
  "serving_suggestion": "冷藏后切块，配红茶。，这一步别省。",
  "storage": "冷藏三天，冷冻一个月。，别跳过这步。",
