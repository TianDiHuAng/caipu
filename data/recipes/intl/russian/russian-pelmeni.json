  "equipment": [
    "大碗",
    "擀面杖",
    "汤锅",
    "刀",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加鸡蛋、水与五克盐揉成光滑面团，盖布醒三十分钟。",
      "time_min": 35,
      "heat": "无火",
      "tip": "面团要揉到表面发亮，擀皮才不破。",
      "visual_cue": "面团光滑细腻，按压回弹"
    },
    {
      "n": 2,
      "text": "牛肉切小块，与猪肉末和半个洋葱一起剁成细腻肉糜。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉糜要剁到黏手，馅才不会散。",
      "visual_cue": "肉糜黏稠，颜色均匀"
    },
    {
      "n": 3,
      "text": "肉馅加剩余盐、黑胡椒与两勺清水，顺一个方向搅到上劲。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水要分次加，一次倒多肉馅会分离。",
      "visual_cue": "肉馅抱团，挑起不散"
    },
    {
      "n": 4,
      "text": "面团分成四份，逐份擀成两毫米厚的薄片，用杯口压出圆皮。",
      "time_min": 18,
      "heat": "无火",
      "tip": "边角料可以重新揉合擀开，别浪费。",
      "visual_cue": "圆皮薄透，大小一致"
    },
    {
      "n": 5,
      "text": "每张皮放一小勺肉馅，对折成半月形，两角捏合。",
      "time_min": 20,
      "heat": "无火",
      "tip": "边缘要捏紧不留缝，否则煮时进水变糊。",
      "visual_cue": "饺子饱满，封口紧实"
    },
    {
      "n": 6,
      "text": "汤锅烧开高汤，下饺子煮到浮起后再煮三分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "浮起不代表熟，再多煮三分钟馅才透。",
      "visual_cue": "饺子鼓起，浮在水面打转"
    },
    {
      "n": 7,
      "text": "另起平底锅化开黄油，把剩余洋葱切丝炒到金黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒到甜味出来，配饺子才不腻。",
      "visual_cue": "洋葱丝炒到金黄、质地软塌"
    },
    {
      "n": 8,
      "text": "饺子捞出沥水，淋洋葱黄油，配一大勺酸奶油上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶油别省，它把酸与油润同时补上。",
      "visual_cue": "饺子油亮，酸奶油雪白"
    }
  ],
  "tips": [
    "和面加鸡蛋，皮更韧，煮时不易破。",
    "一次多包些，撒面粉后冷冻，随吃随煮。",
    "牛肉配猪肉是经典组合，全牛肉会偏干。"
  ],
  "common_mistakes": [
    "面团和得太软，皮根本擀不开，一碰就破洞。",
    "封口没捏紧，下锅后馅漏成一锅肉汤。",
    "饺子浮起立刻捞出，里面还是生肉。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉",
      "ratio": "250 克:250 克",
      "note": "需多加油脂与清水，避免馅干柴。"
    },
    {
      "original": "酸奶油",
      "substitute": "原味酸奶",
      "ratio": "150 克:150 克",
      "note": "更清爽，酸度略高。"
    }
  ],
  "variations": [
    "用蘑菇与卷心菜做素馅，加炒洋葱提香。",
    "把煮好的饺子再煎至底部焦黄，做成煎饺。"
  ],
  "serving_suggestion": "煮好淋黄油洋葱，配酸奶油与黑胡椒，再来一杯冰镇格瓦斯。",
  "storage": "生饺子撒面粉冷冻一个月；熟饺子冷藏两天，复热用平底锅煎或高汤回煮。",
