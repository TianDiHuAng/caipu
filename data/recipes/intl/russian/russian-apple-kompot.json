  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "苹果",
          "name_en": "apple",
          "amount": 600,
          "unit": "g",
          "note": "酸甜品种，切片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取汁与皮",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 60,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 2,
          "unit": "g",
          "note": "一根",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1600,
          "unit": "ml",
          "note": "煮制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "滤网",
    "玻璃壶"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苹果洗净去核，连皮切成半厘米厚的薄片备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "留皮一起煮，果香和颜色都更足。",
      "visual_cue": "苹果片厚薄一致，带皮"
    },
    {
      "n": 2,
      "text": "苹果洗净后去掉果核，连皮切成半厘米厚的薄片备用。",
      "time_min": 5,
      "heat": "大火",
      "tip": "桂皮先煮出味，饮子才香。",
      "visual_cue": "水面翻滚，闻到桂皮香"
    },
    {
      "n": 3,
      "text": "汤锅里倒入清水，放入一根桂皮后用大火烧开。",
      "time_min": 10,
      "heat": "中火",
      "tip": "别猛煮，苹果煮烂就成糊了。",
      "visual_cue": "苹果变软，边缘略透明"
    },
    {
      "n": 4,
      "text": "水开之后放入苹果片，转成中小火煮上十分钟。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火再加蜂蜜，香味不被煮飞。",
      "visual_cue": "汤色透亮，甜味均匀"
    },
    {
      "n": 5,
      "text": "挤入柠檬汁并削少量柠檬皮，盖盖焖十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "焖一下果味才出得来。",
      "visual_cue": "汤色微亮，浮起柠檬香"
    },
    {
      "n": 6,
      "text": "用滤网滤掉苹果片与桂皮，把饮子倒进玻璃壶。",
      "time_min": 3,
      "heat": "无火",
      "tip": "滤干净喝起来顺口。",
      "visual_cue": "饮子清澈，无果渣浮沉"
    },
    {
      "n": 7,
      "text": "用滤网滤掉苹果片与桂皮，把饮子倒进玻璃壶中。",
      "time_min": 120,
      "heat": "无火",
      "tip": "冰镇后酸甜更平衡。",
      "visual_cue": "饮子冰凉，杯壁结水雾"
    },
    {
      "n": 8,
      "text": "饮用时加冰块与一片柠檬，杯中放几片煮苹果装饰。",
      "time_min": 2,
      "heat": "无火",
      "tip": "加片鲜柠檬，香气更活。",
      "visual_cue": "杯中清亮，果片浮在上层"
    }
  ],
  "tips": [
    "苹果连皮煮，颜色和果香都更足。",
    "蜂蜜关火后再加，香味才留得住。",
    "冷藏两小时以上再喝，酸甜才更平衡。"
  ],
  "common_mistakes": [
    "全程大火猛煮，苹果散成一锅果糊。",
    "蜂蜜和苹果一起下锅久煮，香味全跑掉。",
    "一次挤太多柠檬汁，酸得发涩难入口。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "60 克:70 克",
      "note": "甜味更直接，香气略淡。"
    },
    {
      "original": "苹果",
      "substitute": "雪梨",
      "ratio": "600 克:600 克",
      "note": "清甜更明显，柠檬可略减。"
    }
  ],
  "variations": [
    "加一把蔓越莓干同煮，酸味更活泼。",
    "再加两片橙子一起焖，果香会更浓。"
  ],
  "serving_suggestion": "冰镇后倒入玻璃杯，配甜点或早餐都合适。",
  "storage": "冷藏三天内喝完，密封存放避免串味。",
