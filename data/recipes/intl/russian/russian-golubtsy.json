  "steps": [
    {
      "n": 1,
      "text": "整颗卷心菜去芯，整颗放进沸水烫五分钟。，火要均匀，食材才不糊。",
      "time_min": 9,
      "heat": "大火",
      "tip": "烫到叶片能剥下就好，别烫烂。，看住火，别让它失控。",
      "visual_cue": "叶片变软，边缘卷起"
    },
    {
      "n": 2,
      "text": "小心剥下十二片完整叶子，削薄硬梗。，全程留意火候，别贪快。",
      "time_min": 10,
      "heat": "无火",
      "tip": "梗太厚卷不紧，削平更服帖。，火大了就离锅远一点。",
      "visual_cue": "叶片完整，梗部变薄"
    },
    {
      "n": 3,
      "text": "大米煮到半熟，沥干放凉。，火别开太大，稳着来。",
      "time_min": 10,
      "heat": "中火",
      "tip": "半熟就够，炖的时候还会再熟。，锅温要匀，别忽高忽低。",
      "visual_cue": "米粒外软内硬，别小看这一步。"
    },
    {
      "n": 4,
      "text": "牛肉末、米、洋葱和鸡蛋拌成馅，加盐和黑胡椒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺一个方向搅，馅才上劲。，火力保持中等，慢慢来。",
      "visual_cue": "馅料黏稠，颜色均匀"
    },
    {
      "n": 5,
      "text": "每片叶子放一勺馅，两侧折进后卷紧。，火候宁小勿大，慢慢推进。",
      "time_min": 12,
      "heat": "无火",
      "tip": "卷紧一点，炖时才不散。，注意锅里温度别掉下来。",
      "visual_cue": "卷形整齐，接口在下"
    },
    {
      "n": 6,
      "text": "锅化黄油，肉卷接口朝下煎两分钟。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煎定型再翻，才不散开。，火要均匀，食材才不糊。",
      "visual_cue": "底面微焦，形状固定"
    },
    {
      "n": 7,
      "text": "番茄膏加清水和酸奶油调成酱，倒入锅中。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酱汁没过一半就够。，全程留意火候，别贪快。",
      "visual_cue": "酱汁橙红，质地顺滑"
    },
    {
      "n": 8,
      "text": "盖盖小火炖四十分钟，中途淋一次汁。，火大了就离锅远一点。",
      "time_min": 42,
      "heat": "小火",
      "tip": "小火慢炖，卷才软透。，火别开太大，稳着来。",
      "visual_cue": "酱汁冒泡，菜卷软塌"
    },
    {
      "n": 9,
      "text": "尝味补盐，盛盘淋酱。，锅温要匀，别忽高忽低。",
      "time_min": 3,
      "heat": "无火",
      "tip": "炖够时间菜叶才入口即化。，火力保持中等，慢慢来。",
      "visual_cue": "菜卷软嫩，酱汁挂勺"
    }
  ],
  "tips": [
    "菜叶硬梗削平，卷起来才服帖。，成败就在这一步。",
    "肉卷先煎定型，炖时才不散。，这点要注意。",
    "小火炖足四十分钟，菜叶才软。，这是关键点。"
  ],
  "common_mistakes": [
    "菜叶没烫软，一卷就裂。，别嫌麻烦，做完它。",
    "馅太稀，煮出来散成一片。，这一步别省。",
    "大火炖，酱汁烧干粘锅。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "猪肉末",
      "ratio": "400 克:400 克",
      "note": "油脂更多，口感更润。"
    },
    {
      "original": "番茄膏",
      "substitute": "番茄",
      "ratio": "60 克:300 克",
      "note": "需多炖十分收汁。"
    }
  ],
  "variations": [
    "酱汁加一勺蜂蜜，酸甜更平衡。，这步最关键。",
    "表面撒芝士碎，烤十分钟上色。，很多人在这里出错。"
  ],
  "serving_suggestion": "配酸奶油和黑面包，汤汁别浪费。，这里最容易翻车。",
  "storage": "冷藏三天，冷冻一个月。，别小看这一步。",
