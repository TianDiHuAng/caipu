 "steps": [
  {
   "n": 1,
   "text": "整颗卷心菜去芯，整颗放进沸水烫五分钟。，火候要稳，别忽大忽小。",
   "time_min": 9,
   "heat": "大火",
   "tip": "烫到叶片能剥下就好，别烫烂。，火候要稳，别忽大忽小。",
   "visual_cue": "叶片变软，边缘卷起"
  },
  {
   "n": 2,
   "text": "小心剥下十二片完整叶子，削薄硬梗。，火候要稳，别忽大忽小。",
   "time_min": 10,
   "heat": "无火",
   "tip": "梗太厚卷不紧，削平更服帖。，火候要稳，别忽大忽小。",
   "visual_cue": "叶片完整，梗部变薄"
  },
  {
   "n": 3,
   "text": "大米煮到半熟，沥干放凉。，火候要稳，别忽大忽小。",
   "time_min": 10,
   "heat": "中火",
   "tip": "半熟就够，炖的时候还会再熟。，火候要稳，别忽大忽小。",
   "visual_cue": "米粒外软内硬，这一点很关键。"
  },
  {
   "n": 4,
   "text": "牛肉末、米、洋葱和鸡蛋拌成馅，加盐和黑胡椒。",
   "time_min": 8,
   "heat": "无火",
   "tip": "顺一个方向搅，馅才上劲。，火候要稳，别忽大忽小。",
   "visual_cue": "馅料黏稠，颜色均匀"
  },
  {
   "n": 5,
   "text": "每片叶子放一勺馅，两侧折进后卷紧。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "卷紧一点，炖时才不散。，火候要稳，别忽大忽小。",
   "visual_cue": "卷形整齐，接口在下"
  },
  {
   "n": 6,
   "text": "锅化黄油，肉卷接口朝下煎两分钟。，火候要稳，别忽大忽小。",
   "time_min": 5,
   "heat": "中火",
   "tip": "煎定型再翻，才不散开。，火候要稳，别忽大忽小。",
   "visual_cue": "底面微焦，形状固定"
  },
  {
   "n": 7,
   "text": "番茄膏加清水和酸奶油调成酱，倒入锅中。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "酱汁没过一半就够。，火候要稳，别忽大忽小。",
   "visual_cue": "酱汁橙红，质地顺滑"
  },
  {
   "n": 8,
   "text": "盖盖小火炖四十分钟，中途淋一次汁。，火候要稳，别忽大忽小。",
   "time_min": 42,
   "heat": "小火",
   "tip": "小火慢炖，卷才软透。，火候要稳，别忽大忽小。",
   "visual_cue": "酱汁冒泡，菜卷软塌"
  },
  {
   "n": 9,
   "text": "尝味补盐，盛盘淋酱。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "炖够时间菜叶才入口即化。，火候要稳，别忽大忽小。",
   "visual_cue": "菜卷软嫩，酱汁挂勺"
  }
 ],
 "tips": [
  "菜叶硬梗削平，卷起来才服帖。，这一点很关键。",
  "肉卷先煎定型，炖时才不散。，这一点很关键。",
  "小火炖足四十分钟，菜叶才软。，这一点很关键。"
 ],
 "common_mistakes": [
  "菜叶没烫软，一卷就裂。，这一点很关键。",
  "馅太稀，煮出来散成一片。，这一点很关键。",
  "大火炖，酱汁烧干粘锅。，这一点很关键。"
 ],
