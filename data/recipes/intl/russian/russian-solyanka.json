    "锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切小块，冷水下锅焯去血沫。，火候宁小勿大，慢慢推进。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅才能把血水逼出来。，注意锅里温度别掉下来。",
      "visual_cue": "浮沫成团，汤色转清"
    },
    {
      "n": 2,
      "text": "换清水加香叶，小火炖三十分钟。，始终中小火，别心急。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢炖，汤才清亮。，火要均匀，食材才不糊。",
      "visual_cue": "汤面微沸，肉块微软"
    },
    {
      "n": 3,
      "text": "洋葱和胡萝卜切丝，橄榄油炒软。，看住火，别让它失控。",
      "time_min": 7,
      "heat": "中火",
      "tip": "炒到洋葱透明，甜味才出。，全程留意火候，别贪快。",
      "visual_cue": "蔬菜软塌，油色发亮"
    },
    {
      "n": 4,
      "text": "加番茄膏炒出红油，酸味变甜。，火大了就离锅远一点。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄膏一定要炒，生味才去掉。，火别开太大，稳着来。",
      "visual_cue": "油色红亮，香气浓郁"
    },
    {
      "n": 5,
      "text": "酸黄瓜切条，挤掉多余汁水。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "无火",
      "tip": "挤干一点，汤不至于太酸。，火力保持中等，慢慢来。",
      "visual_cue": "瓜条紧实，汁水沥干"
    },
    {
      "n": 6,
      "text": "把炒好的蔬菜和酸黄瓜倒进汤锅。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "沿锅边倒，别溅出来。，注意锅里温度别掉下来。",
      "visual_cue": "汤面浮油，颜色橙红"
    },
    {
      "n": 7,
      "text": "小火再炖十五分钟，尝味补盐。，始终中小火，别心急。",
      "time_min": 17,
      "heat": "小火",
      "tip": "酸黄瓜有咸味，盐最后放。，火要均匀，食材才不糊。",
      "visual_cue": "汤色深红，酸香明显"
    },
    {
      "n": 8,
      "text": "关火挤柠檬汁，撒黑胡椒上桌。，看住火，别让它失控。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬关火后放，香气才留。，全程留意火候，别贪快。",
      "visual_cue": "汤面油花，酸香扑鼻"
    }
  ],
  "tips": [
    "酸黄瓜本身很咸，盐最后再补。，别嫌麻烦，做完它。",
    "番茄膏要炒出红油，汤才够香。，这一步别省。",
    "柠檬关火后挤，香气才不散。，别跳过这步。"
  ],
  "common_mistakes": [
    "酸黄瓜连汁倒进锅，汤酸得没法喝。",
    "番茄膏没炒，一股生味。，这步最关键。",
    "大火炖，牛肉发柴。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛腩",
      "ratio": "500 克:500 克",
      "note": "炖的时间加二十分钟。"
    },
    {
      "original": "酸黄瓜",
      "substitute": "腌黄瓜",
      "ratio": "200 克:200 克",
      "note": "先用清水冲一遍，减咸。"
    }
  ],
  "variations": [
    "加两片火腿，汤更浓。，这里最容易翻车。",
    "放一颗橄榄，风味更有层次。，别小看这一步。"
  ],
  "serving_suggestion": "配酸奶油和一角柠檬，黑面包蘸汤。",
  "storage": "冷藏三天，冷冻一个月。，成败就在这一步。",
