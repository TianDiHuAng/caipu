  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "擦丝器",
    "大碗",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜菜根刷洗干净不削皮，整颗放进冷水锅，水开后小火煮四十分钟。",
      "time_min": 45,
      "heat": "小火",
      "tip": "带皮煮甜菜根才不会流失颜色和甜味。",
      "visual_cue": "刀能轻松扎进甜菜根中心"
    },
    {
      "n": 2,
      "text": "煮好的甜菜根捞出泡冷水两分钟，趁温热把外皮整片搓掉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "温热时皮一搓就掉，凉透了反而难剥。",
      "visual_cue": "表皮整片脱落，露出紫红肉质"
    },
    {
      "n": 3,
      "text": "甜菜根先切薄片再改刀成粗丝，粗细大约火柴梗的样子。",
      "time_min": 6,
      "heat": "无火",
      "tip": "甜菜丝切太细会大量出水，粗丝才有嚼感。",
      "visual_cue": "甜菜丝紫红发亮，长短一致"
    },
    {
      "n": 4,
      "text": "核桃放进干锅小火烘三分钟，闻到坚果香就盛出掰成小块。",
      "time_min": 4,
      "heat": "小火",
      "tip": "干锅烘过的核桃香气浓一倍，别烘焦。",
      "visual_cue": "核桃边缘微亮，香气明显"
    },
    {
      "n": 5,
      "text": "大蒜压成泥，和酸奶油、蛋黄酱、盐、黑胡椒一起搅成调味酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜泥一定要细，否则一口咬到会呛，破坏整体味。",
      "visual_cue": "酱体淡粉白色，蒜香均匀"
    },
    {
      "n": 6,
      "text": "甜菜丝倒进大碗，加调味酱翻拌到每根丝都裹上淡粉色酱汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌的时候轻一点，免得把甜菜丝压断。",
      "visual_cue": "甜菜丝裹酱，呈均匀的玫红色"
    },
    {
      "n": 7,
      "text": "撒上核桃块和莳萝碎，冷藏十五分钟后盛出食用。",
      "time_min": 16,
      "heat": "无火",
      "tip": "核桃最后撒，才能保持干脆的口感不被酱泡软。",
      "visual_cue": "表面坚果块分明，绿碎点缀"
    }
  ],
  "tips": [
    "甜菜根整颗带皮煮，颜色和甜味都不会跑进水里。",
    "趁温热剥皮最省力，凉了皮会牢牢粘住。",
    "核桃用干锅小火烘过，香气比生核桃浓得多。",
    "核桃和莳萝最后撒，吃着才有脆有香。"
  ],
  "common_mistakes": [
    "甜菜根削皮后再切小块煮，煮出一锅红水颜色全失。",
    "煮好放凉才剥皮，皮撕不下来只能削掉一层肉。",
    "甜菜丝切得极细，拌完出一碗红汤，口感也全无。",
    "核桃和沙拉一起拌，端上桌已经软塌。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "酸奶",
      "ratio": "100克:100克",
      "note": "选浓稠原味，热量更低。"
    },
    {
      "original": "核桃",
      "substitute": "葵花籽",
      "ratio": "60克:40克",
      "note": "烘两分钟即可，香气更清。"
    }
  ],
  "variations": [
    "加一勺白醋和少许白糖，做成酸甜口的凉拌版本。",
    "把甜菜根换成烤的，甜味更集中还带一点焦香。",
    "撒一把葡萄干，甜味和坚果的油脂更配。"
  ],
  "serving_suggestion": "盛在白色浅盘里最能衬出玫红色，配烤黑麦面包，或当作烤肉的配菜一起上桌。",
  "storage": "冷藏密封可放两天，颜色会慢慢渗进酱里，吃前翻拌一次即可。",
