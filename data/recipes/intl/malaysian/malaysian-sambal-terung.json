  "steps": [
    {
      "n": 1,
      "text": "茄子切滚刀段，泡淡盐水五分钟。，汤汁别收太干，细节才到位。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡盐水，茄肉才不吸油。，火别太大，锅气才足。",
      "visual_cue": "茄段沉底，水色微浑，汤汁别收太干，整道菜才立得住。"
    },
    {
      "n": 2,
      "text": "捞出挤干水分，摊开晾一会儿。，手法轻些，口感才不散。",
      "time_min": 6,
      "heat": "无火",
      "tip": "表面干爽，煎时才不溅油。，下手别慌，颜色才够亮。",
      "visual_cue": "茄段干爽，切口不变色，手法轻些，成品才稳当。"
    },
    {
      "n": 3,
      "text": "红辣椒、洋葱和大蒜剁成粗酱。，下手别慌，形状才完整。",
      "time_min": 8,
      "heat": "无火",
      "tip": "剁粗些，口感才有层次。，盖盖焖一会儿，吃口才舒服。",
      "visual_cue": "酱体粗粝，颜色鲜红，慢慢来别急，口感才不发柴。"
    },
    {
      "n": 4,
      "text": "炒锅倒一半植物油，中火煎茄子。，时间掐准，口感才不散。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎到两面微焦，茄子才香。，注意别烧干，细节才到位。",
      "visual_cue": "茄皮发亮，切口焦黄，动作放连贯，口感才不发柴。"
    },
    {
      "n": 5,
      "text": "茄子盛出，锅里补油炒辣酱。，盖盖焖一会儿，颜色才够亮。",
      "time_min": 5,
      "heat": "中火",
      "tip": "辣酱要炒出红油，才够香。，顺序照着来，香气才留得住。",
      "visual_cue": "油色转红，香气呛鼻，火别太大，风味才干净。"
    },
    {
      "n": 6,
      "text": "加虾酱和罗望子汁，炒匀出味。，慢慢来别急，吃口才舒服。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾酱易焦，火要小。，锅温要匀，口感才不发柴。",
      "visual_cue": "酱体浓稠，咸香扑鼻，别用力搅，味道才不闷。"
    },
    {
      "n": 7,
      "text": "倒回茄子，加白糖和盐翻匀。，料别一次下太多，口感才不散。",
      "time_min": 5,
      "heat": "中火",
      "tip": "糖压咸，味才平衡。，盖盖焖一会儿，味道才进得去。",
      "visual_cue": "茄段裹酱，油光发亮，料别一次下太多，形状才完整。"
    },
    {
      "n": 8,
      "text": "加少量水焖三分钟，撒小葱末。，起锅前尝味，火候才均匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "焖一下，茄子才入味。，保持小火，表面才漂亮。",
      "visual_cue": "汤汁收干，葱末翠绿，份量心里有数，火候才均匀。"
    }
  ],
  "tips": [
    "茄子泡盐水，煎时才不吸油。，注意别烧干，表面才漂亮。",
    "辣酱要炒出红油，香气才足。，时间掐准，锅气才足。",
    "虾酱易焦，火一定要小。，别急着加油，咸淡才好把握。"
  ],
  "common_mistakes": [
    "茄子不泡水，煎完一盘油。，别急着加油，成品才好看。",
    "虾酱炒焦，整锅发苦。，留意锅底，火候才均匀。",
    "焖太久，茄子化在锅里。，慢慢来别急，风味才干净。"
  ],
  "substitutions": [
    {
