  "equipment": [
    "竹签",
    "烤架或烤盘",
    "料理机",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "竹签用清水泡三十分钟，避免烤时烧焦断签。",
      "time_min": 31,
      "heat": "无火",
      "tip": "竹签必须泡透，否则接口处会先烧断。",
      "visual_cue": "竹签吸足水，颜色变深"
    },
    {
      "n": 2,
      "text": "香茅取白芯切碎，与大蒜、姜黄、孜然、芫荽籽、白糖、生抽、一半椰奶和洋葱一起打成腌料。",
      "time_min": 7,
      "heat": "无火",
      "tip": "香料打成泥才挂得住肉，颗粒粗会往下掉。",
      "visual_cue": "腌料细腻，颜色橙黄"
    },
    {
      "n": 3,
      "text": "鸡腿肉切成两厘米宽的长条，与腌料抓匀冷藏至少三十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "腌够时间味道才进得去，急不得。",
      "visual_cue": "鸡肉均匀裹上橙黄腌料"
    },
    {
      "n": 4,
      "text": "把鸡肉条穿在竹签上，每根三四条，肉与肉之间留小缝。",
      "time_min": 10,
      "heat": "无火",
      "tip": "留缝受热均匀，挤太紧里面烤不熟。",
      "visual_cue": "肉串平整，串长一致"
    },
    {
      "n": 5,
      "text": "花生酱用剩余椰奶调稀，加白糖与少许青柠汁搅成蘸酱。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰奶要一点点加，一次倒多搅不开。",
      "visual_cue": "酱汁浓稠顺滑，能挂勺"
    },
    {
      "n": 6,
      "text": "烤架烧热刷油，放入肉串中火烤六分钟，中途翻面刷花生油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "多翻几次，表面焦了里面却还生就麻烦了。",
      "visual_cue": "肉串边缘焦黄，表面起亮"
    },
    {
      "n": 7,
      "text": "翻面再烤四分钟，至肉条完全熟透、边缘微焦。",
      "time_min": 4,
      "heat": "中火",
      "tip": "最后一分钟靠近火面逼出焦香。",
      "visual_cue": "肉串焦褐，油光明显"
    },
    {
      "n": 8,
      "text": "肉串装盘摆开，配上黄瓜块与蘸酱，再挤青柠汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蘸酱要多给一点，沙爹的味道一半在酱里。",
      "visual_cue": "盘面焦黄肉串，酱汁浓香"
    }
  ],
  "tips": [
    "鸡腿肉比鸡胸更耐烤，油脂能保住嫩度。",
    "没有烤架可用平底锅煎，加盖两分钟模拟炉温。",
    "花生酱选带颗粒型，蘸酱口感更粗犷。"
  ],
  "common_mistakes": [
    "腌料打得太粗，烤时香料掉光，味道进不去。",
    "竹签没泡水，烤到一半烧断，肉掉进火里。",
    "全程大火猛烤，表面焦黑里面还粉红。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "羊肉",
      "ratio": "800 克:800 克",
      "note": "切两厘米块，腌制时间延长至一小时。"
    },
    {
      "original": "花生酱",
      "substitute": "腰果酱",
      "ratio": "120 克:120 克",
      "note": "风味更清爽，过敏人群可尝试但须谨慎。"
    }
  ],
  "variations": [
    "用同款腌料做牛肉沙爹，烤制时间缩短两分钟。",
    "加参巴辣酱同烤，做成更辛辣的版本。"
  ],
  "serving_suggestion": "配黄瓜块、洋葱段和椰浆饭，蘸厚花生酱吃。",
  "storage": "生腌肉冷藏一夜，熟串冷藏两天；复热用烤架两分钟，微波会让肉变硬。",
