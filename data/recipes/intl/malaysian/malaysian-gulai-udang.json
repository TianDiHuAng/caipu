  "steps": [
    {
      "n": 1,
      "text": "虾去壳留尾，背部挑去泥肠。，先试试温度，口感才不散。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泥肠挑净，虾才不腥。，下手别慌，咸淡才好把握。",
      "visual_cue": "虾身透亮，背部开口，火别太大，咸淡才好把握。"
    },
    {
      "n": 2,
      "text": "虾用盐抓一遍，冲水沥干。，保持小火，吃口才舒服。",
      "time_min": 4,
      "heat": "无火",
      "tip": "抓洗一下，口感才脆。，顺序照着来，成品才好看。",
      "visual_cue": "虾身干爽，盐粒化开，留意锅底，味道才进得去。"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，中火炒洋葱丝。，别急着加油，锅气才足。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软，甜味才出。，顺序照着来，口感才不发柴。",
      "visual_cue": "洋葱透明，边缘微黄，汤汁别收太干，味道才不闷。"
    },
    {
      "n": 4,
      "text": "下蒜末、姜片和香茅炒香。，动作放连贯，整道菜才立得住。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香茅拍扁，香气才放出来。，料别一次下太多，咸淡才好把握。",
      "visual_cue": "香气浓，油色发亮，手法轻些，形状才完整。"
    },
    {
      "n": 5,
      "text": "加咖喱粉炒出油色，别炒焦。，先试试温度，颜色才够亮。",
      "time_min": 3,
      "heat": "小火",
      "tip": "小火炒粉，焦了会苦。，手法轻些，细节才到位。",
      "visual_cue": "油色转橙，香气呛鼻，慢慢来别急，咸淡才好把握。"
    },
    {
      "n": 6,
      "text": "倒清水煮开，加红辣椒转小火。，汤汁别收太干，香气才不跑。",
      "time_min": 7,
      "heat": "大火",
      "tip": "水开再熬，味道才匀。，时间掐准，口感才不发柴。",
      "visual_cue": "汤面翻滚，颜色橙黄，份量心里有数，细节才到位。"
    },
    {
      "n": 7,
      "text": "倒椰奶，小火煮五分钟不要沸。，料别一次下太多，锅气才足。",
      "time_min": 6,
      "heat": "小火",
      "tip": "椰奶别沸，才不分层。，慢慢来别急，味道才不闷。",
      "visual_cue": "奶色橙亮，汤汁微稠，别用力搅，味道才进得去。"
    },
    {
      "n": 8,
      "text": "下虾煮三分钟，变色卷起即可。，起锅前尝味，成品才稳当。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾久煮就柴，变色就够。，手法轻些，食材才不糊。",
      "visual_cue": "虾身卷曲，颜色橙红，料别一次下太多，味道才进得去。"
    },
    {
      "n": 9,
      "text": "加盐和白糖调味，撒香菜盛盘。，手法轻些，成品才好看。",
      "time_min": 3,
      "heat": "小火",
      "tip": "尝一下再补盐，咖喱自带咸。，慢慢来别急，香气才留得住。",
      "visual_cue": "汤汁浓稠，香菜翠绿，份量心里有数，味道才进得去。"
    }
  ],
  "tips": [
    "咖喱粉要用小火炒，才不发苦。，留意锅底，香气才留得住。",
    "虾最后下，变色就起锅。，火别太大，表面才漂亮。",
    "椰奶别煮沸，汤才不分层。，动作放连贯，吃口才舒服。"
  ],
  "common_mistakes": [
    "咖喱粉炒焦，整锅发苦。，注意别烧干，成品才好看。",
    "虾煮太久，肉缩发柴。，手法轻些，味道才不闷。",
    "椰奶大火沸，油水分离。，翻动放轻，咸淡才好把握。"
  ],
  "substitutions": [
    {
