      "substitute": "咖喱酱",
      "ratio": "25 克:40 克",
      "note": "酱含盐，盐可减两克。"
    }
  ],
  "variations": [
    "加土豆块，汤汁更绵。，盖盖焖一会儿，口感才有层次。",
    "加一点酸柑汁，酸香更清。，注意别烧干，食材才不糊。"
  ],
  "serving_suggestion": "配白米饭或印度煎饼。，汤汁别收太干，表面才漂亮。",
  "storage": "冷藏两天，复热用小火。，手法轻些，火候才均匀。",
