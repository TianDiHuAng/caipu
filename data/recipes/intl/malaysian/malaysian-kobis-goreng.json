  "steps": [
    {
      "n": 1,
      "text": "卷心菜用手撕成大片，用清水洗净后彻底沥干水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "手撕比刀切更挂汁，撕完一定要沥干，带水下锅就出水。",
      "visual_cue": "菜片边缘不规则，篮底不见积水"
    },
    {
      "n": 2,
      "text": "虾米用温水泡五分钟，捞出挤干，泡发的水留着备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡虾米的水很鲜，别倒掉，最后可以补一点。",
      "visual_cue": "虾米泡软发胀，水色微黄"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下虾米、蒜片与红葱头丝，小火煸出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾米要煸到微脆才香，火大容易焦黑。",
      "visual_cue": "虾米微卷发脆，香气上冲"
    },
    {
      "n": 4,
      "text": "转大火下干辣椒与卷心菜，快速翻炒两分钟至边缘变软。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火炒才脆，卷心菜一软就该调味了。",
      "visual_cue": "菜片边缘透明，仍有脆感"
    },
    {
      "n": 5,
      "text": "加生抽、盐、白糖与白胡椒翻匀，出锅前淋少许泡虾米的水。",
      "time_min": 2,
      "heat": "大火",
      "tip": "最后那点虾米水提鲜极好，但只能淋一勺。",
      "visual_cue": "菜色油亮，盘底几乎无汤"
    }
  ],
  "tips": [
    "卷心菜手撕比刀切好吃，切口不规则更挂味。",
    "虾米煸香是这道菜的灵魂，别省这一步。",
    "全程保持大火，炒的时间越短，菜越脆越甜。",
    "喜欢辣可以加两勺辣椒酱一起炒。"
  ],
  "common_mistakes": [
    "卷心菜没沥干就下锅，炒出一盘水。",
    "小火慢炒，菜叶发黄发软没了脆感。",
    "虾米没煸香，菜吃着只有咸味没鲜味。",
    "盐和生抽一起重手，咸得只能配三碗饭。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "紫甘蓝",
      "ratio": "500克:500克",
      "note": "颜色好看，炒的时间多三十秒。"
    },
    {
      "original": "虾米",
      "substitute": "咸鱼丁",
      "ratio": "20克:25克",
      "note": "咸度更高，盐要减半。"
    }
  ],
  "variations": [
    "加一把粉丝同炒，吸汁后特别下饭。",
    "加两片培根同炒，荤香更浓，咸度也更高。",
    "换成芥蓝同炒，口感更清脆，苦味回甘。"
  ],
  "serving_suggestion": "趁热装盘，配白饭与咖喱鸡，青菜的脆与咖喱的浓正好互补。",
  "storage": "冷藏可放一天，复热用大火快炒十秒，微波会出水变软。",
