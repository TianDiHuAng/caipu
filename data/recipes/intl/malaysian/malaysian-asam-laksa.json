  "steps": [
    {
      "n": 1,
      "text": "鲈鱼洗净，放锅里加水煮十分钟。，慢慢来别急，成品才好看。",
      "time_min": 12,
      "heat": "中火",
      "tip": "鱼肉刚熟就捞，才不柴。，保持小火，火候才均匀。",
      "visual_cue": "鱼眼发白，肉能剥离，翻动放轻，吃口才舒服。"
    },
    {
      "n": 2,
      "text": "捞出鱼去骨拆肉，鱼汤留着。，别用力搅，整道菜才立得住。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拆干净，汤才不腥。，锅温要匀，口感才有层次。",
      "visual_cue": "肉块松散，骨已去净，注意别烧干，火候才均匀。"
    },
    {
      "n": 3,
      "text": "罗望子放温水揉开，滤出酸汁。，起锅前尝味，成品才好看。",
      "time_min": 8,
      "heat": "无火",
      "tip": "滤净渣，汤才不浑。，保持小火，味道才不闷。",
      "visual_cue": "汁水发褐，颗粒去尽，动作放连贯，表面才漂亮。"
    },
    {
      "n": 4,
      "text": "汤锅下洋葱、蒜、姜和香茅炒香。，顺序照着来，口感才有层次。",
      "time_min": 5,
      "heat": "中火",
      "tip": "香料炒过，汤才够味。，火别太大，口感才不散。",
      "visual_cue": "香气升起，洋葱变软，翻动放轻，整道菜才立得住。"
    },
    {
      "n": 5,
      "text": "倒鱼汤煮开，加虾酱和红辣椒。，翻动放轻，锅气才足。",
      "time_min": 7,
      "heat": "大火",
      "tip": "虾酱先化开，味才匀。，时间掐准，味道才进得去。",
      "visual_cue": "汤色转深，香气浓，汤汁别收太干，成品才好看。"
    },
    {
      "n": 6,
      "text": "转小火煮十五分钟，让香味融进汤里。，手法轻些，整道菜才立得住。",
      "time_min": 16,
      "heat": "小火",
      "tip": "小火慢煮，味道才进汤。，保持小火，整道菜才立得住。",
      "visual_cue": "汤面微沸，香草下沉，别用力搅，细节才到位。"
    },
    {
      "n": 7,
      "text": "加罗望子汁、白糖和盐调味。，汤汁别收太干，咸淡才好把握。",
      "time_min": 4,
      "heat": "小火",
      "tip": "酸味要够，甜味打底。，先试试温度，香气才留得住。",
      "visual_cue": "汤色深褐，酸香扑鼻，注意别烧干，香气才留得住。"
    },
    {
      "n": 8,
      "text": "米粉烫软放碗里，浇上汤和鱼肉。，翻动放轻，食材才不糊。",
      "time_min": 5,
      "heat": "大火",
      "tip": "米粉别煮烂，泡软就够。，保持小火，香气才留得住。",
      "visual_cue": "米粉透亮，汤面浮油，保持小火，食材才不糊。"
    },
    {
      "n": 9,
      "text": "放黄瓜丝和薄荷，趁热吃。，锅温要匀，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "配菜最后放，清口。，锅温要匀，成品才稳当。",
      "visual_cue": "黄瓜脆绿，薄荷舒展，翻动放轻，火候才均匀。"
    }
  ],
  "tips": [
    "鱼肉刚熟就捞，才不散不柴。，料别一次下太多，表面才漂亮。",
    "罗望子汁最后加，酸味才清。，火别太大，味道才进得去。",
    "汤要够酸，才有层次。，起锅前尝味，细节才到位。"
  ],
  "common_mistakes": [
    "鱼煮太久，肉散在汤里。，翻动放轻，味道才不闷。",
    "虾酱放太多，咸得发苦。，下手别慌，风味才干净。",
    "米粉煮过头，一夹就断。，注意别烧干，口感才不发柴。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "罗非鱼",
      "ratio": "700 克:700 克",
      "note": "肉更紧，煮制时间加三分钟。"
    },
    {
      "original": "罗望子",
      "substitute": "青柠",
      "ratio": "60 克:3 个",
      "note": "酸味更清，糖可减三克。"
    }
  ],
  "variations": [
    "加菠萝块，甜酸更明亮。，保持小火，味道才进得去。",
    "加更多红辣椒，辣味更足。，动作放连贯，颜色才够亮。"
  ],
  "serving_suggestion": "配虾酱和薄荷，趁热吃。，动作放连贯，味道才不闷。",
  "storage": "汤冷藏两天，米粉现烫。，动作放连贯，形状才完整。",
