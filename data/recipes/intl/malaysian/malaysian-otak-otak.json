  "equipment": [
    "料理机",
    "大碗",
    "蒸锅",
    "锡纸",
    "勺子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲭鱼去骨取肉，用勺子刮下鱼肉，去掉细刺。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "刮肉别带皮，腥味才不重。，注意火候。",
      "visual_cue": "鱼肉细腻，无骨无皮，状态稳定"
    },
    {
      "n": 2,
      "text": "香茅取嫩部切碎，南姜、蒜和洋葱一起剁细。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香料剁细，口感才不粗。，注意火候。",
      "visual_cue": "碎末均匀，香气浓，状态稳定"
    },
    {
      "n": 3,
      "text": "鱼肉和香料放料理机，加鲜辣椒、盐和白糖打成泥。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打到发黏，成品才弹。，注意火候。",
      "visual_cue": "泥体细腻，颜色浅粉，状态稳定"
    },
    {
      "n": 4,
      "text": "加玉米淀粉、鸡蛋和椰奶，顺一方向拌成糊。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "椰奶分次加，糊才不稀。，注意火候。",
      "visual_cue": "糊体稠厚，能挂勺，状态稳定"
    },
    {
      "n": 5,
      "text": "挤入青柠汁拌匀，冷藏十五分钟让味道稳定。这一步不要着急。",
      "time_min": 18,
      "heat": "无火",
      "tip": "冷藏一下，蒸的时候不易散。，注意火候。",
      "visual_cue": "糊体紧实，香气融合，状态稳定"
    },
    {
      "n": 6,
      "text": "锡纸剪成小片，抹薄油，舀一勺鱼糊包成小包。",
      "time_min": 8,
      "heat": "无火",
      "tip": "包薄一点，蒸的时候熟得快。，注意火候。",
      "visual_cue": "包形平整，封口朝上，状态稳定"
    },
    {
      "n": 7,
      "text": "水开后中火蒸十二分钟到鱼糊完全凝固。这一步不要着急。",
      "time_min": 14,
      "heat": "中火",
      "tip": "蒸到按压有弹性就熟了。，注意火候。",
      "visual_cue": "鱼饼凝固，轻按回弹，状态稳定"
    },
    {
      "n": 8,
      "text": "稍晾两分钟再拆锡纸，配青柠角食用。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃最嫩，凉了口感发紧。，注意火候。",
      "visual_cue": "表面油润，香气扑鼻，状态稳定"
    }
  ],
  "tips": [
    "鱼肉刮下来别带皮，腥味才不重。，值得留意。",
    "椰奶分次加，糊才稠而不稀。，值得留意。",
    "包薄一点，蒸十二分钟就够。，值得留意。"
  ],
  "common_mistakes": [
    "鱼肉没去净刺，吃起来扎嘴。，值得留意。",
    "糊太稀，蒸完散成一摊。，值得留意。",
    "蒸过头，鱼饼变硬发柴。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鲭鱼",
      "substitute": "鲈鱼",
      "ratio": "400 克:400 克",
      "note": "腥味更淡，青柠可略减。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "150 毫升:150 毫升",
      "note": "奶香更淡，辣味更突出。"
    }
  ],
  "variations": [
    "加几片柠檬叶丝，香气更清。，值得留意。",
    "用香蕉叶代替锡纸包，香气更浓。，值得留意。"
  ],
  "serving_suggestion": "配椰浆饭和黄瓜片，当作开胃小菜最合适。，效果更稳定。",
  "storage": "冷藏两天，复热用蒸锅蒸五分钟。，效果更稳定。",
