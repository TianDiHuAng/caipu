  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去内脏洗净，两面各划三刀。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "划刀让酱料进得去，也熟得快。，注意火候。",
      "visual_cue": "鱼身完整，刀口均匀，状态稳定"
    },
    {
      "n": 2,
      "text": "鱼身内外抹盐，腌十分钟后擦去渗出的水。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "擦干水，烤的时候皮才不会粘。，注意火候。",
      "visual_cue": "鱼皮干爽，肉质紧实，状态稳定"
    },
    {
      "n": 3,
      "text": "鲜辣椒、蒜、香茅、洋葱放料理机打成粗酱。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打成粗酱，烤完还有颗粒感。，注意火候。",
      "visual_cue": "酱体粗粝，香气冲，状态稳定"
    },
    {
      "n": 4,
      "text": "加罗望子汁、白糖和盐拌匀，调成参巴酱。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "罗望子带酸，糖用来平衡。，注意火候。",
      "visual_cue": "酱色红亮，酸香明显，状态稳定"
    },
    {
      "n": 5,
      "text": "烤盘铺锡纸刷一层植物油，鱼放上去，两面刷参巴酱。",
      "time_min": 5,
      "heat": "无火",
      "tip": "酱刷厚一点，烤完才够味。，注意火候。",
      "visual_cue": "鱼身裹酱，颜色红亮，状态稳定"
    },
    {
      "n": 6,
      "text": "两百度烤十五分钟，中途翻面再刷一次酱。这一步不要着急。",
      "time_min": 16,
      "heat": "-",
      "tip": "中途补酱，颜色才均匀不发干。，注意火候。",
      "visual_cue": "表面焦红，酱层发亮，状态稳定"
    },
    {
      "n": 7,
      "text": "最后三分钟转两百二十度，让边缘微微焦化。这一步不要着急。",
      "time_min": 4,
      "heat": "-",
      "tip": "高温收尾，表皮焦香才够。，注意火候。",
      "visual_cue": "边缘焦脆，香气浓，状态稳定"
    },
    {
      "n": 8,
      "text": "出炉挤青柠汁，配黄瓜片和米饭一起上桌。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸汁能压住酱的厚重。，注意火候。",
      "visual_cue": "鱼皮微焦，肉质雪白，状态稳定"
    }
  ],
  "tips": [
    "鱼身划刀，酱料才进得去。，值得留意。",
    "腌完一定擦干水，鱼皮才不粘烤盘。，值得留意。",
    "中途补一次酱，颜色才均匀。，值得留意。"
  ],
  "common_mistakes": [
    "鱼没擦干就烤，皮全粘在锡纸上。，值得留意。",
    "酱刷太薄，烤完干柴没味。，值得留意。",
    "温度太低，鱼烤老还不出焦香。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "罗非鱼",
      "ratio": "700 克:700 克",
      "note": "肉质更紧，烤制时间加三分钟。"
    },
    {
      "original": "罗望子",
      "substitute": "柠檬汁",
      "ratio": "20 克:25 毫升",
      "note": "酸味更直接，糖可略减。"
    }
  ],
  "variations": [
    "用香蕉叶包起来烤，香气更热带。，值得留意。",
    "烤好撒一把炸红葱酥，口感更丰富。，值得留意。"
  ],
  "serving_suggestion": "配椰浆饭、黄瓜片和参巴酱，是最经典的马来组合。",
  "storage": "冷藏一天，复热用烤箱一百八十度烤八分钟。",
