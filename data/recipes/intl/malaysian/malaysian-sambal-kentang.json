  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "漏勺",
    "研钵"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆削皮切滚刀块，泡清水五分钟洗去表面浆质后沥干。",
      "time_min": 7,
      "heat": "无火",
      "tip": "泡水洗去表面浆质，炸的时候不粘不糊，颜色也更金黄。",
      "visual_cue": "土豆块表面清爽，水盆微浑"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧到一百六十度，下土豆炸六分钟至外皮金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温别太高，外面焦了里面还生，是最难吃的状态。",
      "visual_cue": "土豆浮起，边缘金黄起小泡"
    },
    {
      "n": 3,
      "text": "干辣椒、红葱头、蒜与虾酱舂成粗泥，罗望子加水取两勺汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "舂得粗一点更有口感，罗望子汁要滤掉核与渣。",
      "visual_cue": "酱料深红带颗粒，酸汁清澈"
    },
    {
      "n": 4,
      "text": "另起炒锅留三十毫升油，下酱料小火炒三分钟至出红油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "酱料一定炒到油色发红，生辣椒味才去得掉。",
      "visual_cue": "油色红亮，酱料干香不水"
    },
    {
      "n": 5,
      "text": "下土豆块翻炒裹酱，加罗望子汁、椰糖与盐，收汁两分钟即可。",
      "time_min": 4,
      "heat": "中火",
      "tip": "椰糖与罗望子一甜一酸，比例调好味道才立体。",
      "visual_cue": "酱汁紧裹土豆，盘底不见汤"
    }
  ],
  "tips": [
    "土豆先炸再炒，外脆里粉口感最好。",
    "不想多油可以蒸熟后干锅煎，省油也香。",
    "罗望子汁代替醋，酸得柔和带果香。",
    "椰糖没有就用红糖，甜味略重需减量。"
  ],
  "common_mistakes": [
    "土豆没泡水就炸，粘成一坨还带生粉味。",
    "酱料没炒透，吃得出干辣椒的青涩与生味。",
    "罗望子汁倒太多，酸得盖住所有味道。",
    "土豆炸好后放凉再炒，回软出油。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "芋头",
      "ratio": "500克:500克",
      "note": "更粉，炸的时间加两分钟。"
    },
    {
      "original": "椰糖",
      "substitute": "红糖",
      "ratio": "15克:12克",
      "note": "甜度更高，需减少用量。"
    }
  ],
  "variations": [
    "加几只水煮蛋同炒，酱汁裹蛋特别香。",
    "加一把炸花生米同炒，脆感更足，也更香。",
    "换成茄子同炒，茄子吸酱能力更强，更入味。"
  ],
  "serving_suggestion": "装盘配白饭与黄瓜片，酸辣带甜，配椰浆饭更是经典组合。",
  "storage": "冷藏可放两天，复热用炒锅小火加一勺水焖三分钟，微波会让土豆发硬。",
