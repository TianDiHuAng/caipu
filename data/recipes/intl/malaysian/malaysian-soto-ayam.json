  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉剁成四厘米块，冷水冲净血水后沥干备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "血水冲净汤才清，不冲会有腥味浮沫。",
      "visual_cue": "鸡块表面转淡，水盘无血丝"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，下小洋葱丝、蒜与姜片小火煸到出香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱丝煸到微透明就够，焦了汤会带苦。",
      "visual_cue": "洋葱丝变软透明，锅里香气上冲"
    },
    {
      "n": 3,
      "text": "加姜黄与香茅段炒三十秒，倒入清水大火烧开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "姜黄遇油才出色，炒一下就够，久炒发苦。",
      "visual_cue": "汤水金黄，香茅味明显"
    },
    {
      "n": 4,
      "text": "下鸡块转小火煮二十五分钟，撇净表面浮油与浮沫。",
      "time_min": 25,
      "heat": "小火",
      "tip": "全程小火保持微沸，鸡肉才嫩汤才清。",
      "visual_cue": "鸡肉轻按回弹，汤面干净"
    },
    {
      "n": 5,
      "text": "加盐与白胡椒调味，最后放豆芽与芹菜煮一分钟关火。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆芽芹菜最后放，煮久就软塌失去脆感。",
      "visual_cue": "豆芽挺立，汤色金黄清亮"
    }
  ],
  "tips": [
    "姜黄粉别多放，超过十克汤会发苦带土味。",
    "香茅拍扁再切段，香气才出得来。",
    "汤要小火慢煮，滚太猛鸡肉发柴汤变浑。",
    "喜欢酸口可以挤半个青柠，风味更接近街边摊。"
  ],
  "common_mistakes": [
    "姜黄一次倒半包，汤苦得喝不下去。",
    "全程开大火滚煮，鸡肉老得咬不动，汤也浑。",
    "洋葱丝煸到发黑，整锅汤带焦苦味。",
    "豆芽一开始就下锅，煮成一包水。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "700克:650克",
      "note": "肉更瘦，煮的时间减八分钟。"
    },
    {
      "original": "姜黄",
      "substitute": "咖喱粉",
      "ratio": "6克:10克",
      "note": "风味更复合，颜色略深。"
    }
  ],
  "variations": [
    "加一把米粉同煮，就变成一碗黄姜鸡汤面。",
    "加两片酸柑叶同煮，柑橘香更清爽。",
    "换成牛肉片，煮的时间减到八分钟。"
  ],
  "serving_suggestion": "盛在深碗里，撒一把芹菜碎与炸葱酥，配一碟辣椒酱和青柠角，是马来早餐的常客。",
  "storage": "冷藏可放两天，撇去表面浮油再复热；汤渣与汤分开存，风味保持更久。",
