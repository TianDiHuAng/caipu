  "steps": [
    {
      "n": 1,
      "text": "米粉用温水泡二十分钟到软，捞出沥干。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡到能弯折就好，泡过头一炒就断。，注意火候。",
      "visual_cue": "条身柔软，抖开不粘，状态稳定"
    },
    {
      "n": 2,
      "text": "虾仁去壳去肠线，用厨房纸吸干水分。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "虾仁吸干，下锅才不会出水。，注意火候。",
      "visual_cue": "虾仁表面干爽，颜色透亮，状态稳定"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟倒植物油，下蒜末和鲜辣椒碎爆香。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅要够热，米粉才有镬气。，注意火候。",
      "visual_cue": "蒜末金黄，香气冲鼻，状态稳定"
    },
    {
      "n": 4,
      "text": "放虾仁大火炒到变色卷曲，盛出备用。这一步不要着急。",
      "time_min": 3,
      "heat": "大火",
      "tip": "虾仁先盛出，最后回锅才不老。，注意火候。",
      "visual_cue": "虾仁表面卷曲，颜色转红，状态稳定"
    },
    {
      "n": 5,
      "text": "锅里补少许油，倒入米粉快速翻炒抖散。这一步不要着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "用铲子抖散，别压着炒。，注意火候。",
      "visual_cue": "条条分明，不粘成团，状态稳定"
    },
    {
      "n": 6,
      "text": "淋酱油和蚝油翻炒到每条都染上酱色。这一步不要着急。",
      "time_min": 3,
      "heat": "大火",
      "tip": "酱料沿锅边淋，香气才激出来。，注意火候。",
      "visual_cue": "颜色均匀，油光发亮，状态稳定"
    },
    {
      "n": 7,
      "text": "把米粉推到一边，打入鸡蛋炒散后拌合。这一步不要着急。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蛋液半熟时拌合，米粉才滑。，注意火候。",
      "visual_cue": "蛋花细碎，分布均匀，状态稳定"
    },
    {
      "n": 8,
      "text": "放回虾仁，加豆芽、韭菜和盐调味，大火翻炒三十秒出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "韭菜最后放，脆香才留得住。，注意火候。",
      "visual_cue": "韭菜翠绿，豆芽挺直，状态稳定"
    }
  ],
  "tips": [
    "锅一定要烧到冒烟，米粉才有镬气。，值得留意。",
    "米粉泡软就够，泡过头一炒就断。，值得留意。",
    "韭菜最后下锅，翠绿才好看。，值得留意。"
  ],
  "common_mistakes": [
    "锅不够热，米粉粘成一坨。，值得留意。",
    "米粉泡太久，炒的时候全断。，值得留意。",
    "一次下太多料，变成水煮米粉。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡胸肉",
      "ratio": "120 克:120 克",
      "note": "切薄片，先炒熟再回锅。"
    },
    {
      "original": "米粉",
      "substitute": "宽米粉",
      "ratio": "250 克:250 克",
      "note": "更宽更滑，泡的时间减半。"
    }
  ],
  "variations": [
    "加一把血蚶，鲜味更足。，值得留意。",
    "放两片腊肠同炒，甜香更浓。，值得留意。"
  ],
  "serving_suggestion": "趁热装盘，配一碟参巴辣酱最够味。，效果更稳定。",
  "storage": "冷藏一天，复热用炒锅大火快炒。，效果更稳定。",
