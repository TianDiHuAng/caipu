  "equipment": [
    "汤锅",
    "炒锅",
    "木勺",
    "刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香茅取白段拍扁切段，南姜切片，与蒜末、洋葱丁和咖喱粉一起放进研钵或料理机打成粗酱。",
      "time_min": 10,
      "heat": "无火",
      "tip": "打粗一点保留纤维，煮出来的汤底香气更立体。",
      "visual_cue": "酱料呈橙黄色粗泥，能闻到香茅与南姜的辛香"
    },
    {
      "n": 2,
      "text": "炒锅放植物油，小火炒香料酱与辣椒酱八分钟，炒到油色转红、香味浓郁。",
      "time_min": 9,
      "heat": "小火",
      "tip": "这一步叫爆香，火大就会炒焦发苦，必须耐心推炒。",
      "visual_cue": "锅内红油析出，酱料变深且不再生涩"
    },
    {
      "n": 3,
      "text": "倒入高汤煮开，放入鸡腿条小火煮十二分钟，撇去表面浮沫。",
      "time_min": 14,
      "heat": "中火",
      "tip": "撇净浮沫汤才清亮，成品不会带腥。",
      "visual_cue": "汤色橙红，鸡肉条由粉转白"
    },
    {
      "n": 4,
      "text": "加入椰浆、鱼露和椰糖搅匀，小火保持微沸五分钟，注意不要滚沸。",
      "time_min": 6,
      "heat": "小火",
      "tip": "椰浆一旦大火滚沸就会油水分离，汤面浮起颗粒。",
      "visual_cue": "汤体乳白带橙，质地顺滑无颗粒"
    },
    {
      "n": 5,
      "text": "另起锅烧水，米粉烫三十秒捞出，豆芽与虾仁分别烫熟备用。",
      "time_min": 5,
      "heat": "大火",
      "tip": "配料分开烫，汤底才不会被生豆芽的水味冲淡。",
      "visual_cue": "米粉柔软不断，虾仁卷曲变粉红"
    },
    {
      "n": 6,
      "text": "碗里放米粉，浇上滚烫汤底，摆鸡腿条、虾仁与豆芽，撒香菜，补盐调味后挤青柠汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "汤要滚烫地浇下去，米粉才能吸味而不发坨。",
      "visual_cue": "汤面浮着红油，配料分层码放整齐"
    }
  ],
  "tips": [
    "椰浆选浓稠无糖的烹饪用椰浆，摇匀后再倒，避免油水分离。",
    "汤底可提前一天做好，冷藏后撇去凝固的油层更清爽。",
    "喜欢更浓的口感可加一勺虾米辣椒酱一起爆香。"
  ],
  "common_mistakes": [
    "香料酱炒不到位，汤里带着生咖喱的粉味。",
    "椰浆大火滚沸，汤面结出颗粒状油花。",
    "米粉泡太久再烫，入汤即断成碎段。"
  ],
