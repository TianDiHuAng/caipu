    "料理机",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干辣椒用温水泡十五分钟，泡软后剪段去掉大部分籽。",
      "time_min": 15,
      "heat": "无火",
      "tip": "去籽能控制辣度，别全去掉，香气靠它。",
      "visual_cue": "辣椒变软，水呈淡红色"
    },
    {
      "n": 2,
      "text": "泡好的辣椒与洋葱、大蒜、南姜、香茅一起打成细泥。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打得越细，炒出来越顺滑不起渣。",
      "visual_cue": "泥体细腻，颜色深红"
    },
    {
      "n": 3,
      "text": "虾去壳留尾，从背部划开挑出沙线，用盐抓洗一遍。",
      "time_min": 8,
      "heat": "无火",
      "tip": "开背更易入味，受热也均匀。",
      "visual_cue": "虾肉透亮，背部翻开"
    },
    {
      "n": 4,
      "text": "炒锅倒足量植物油，中小火把辣椒泥慢炒八分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "一定要小火炒到出红油，生辣味才散。",
      "visual_cue": "油色变红，泥体变干起沙"
    },
    {
      "n": 5,
      "text": "加白糖与盐继续翻炒，让参巴酱收干成浓稠状。",
      "time_min": 2,
      "heat": "小火",
      "tip": "糖能压住生辣，也让颜色更亮。",
      "visual_cue": "酱体油亮粘稠，能挂住锅铲"
    },
    {
      "n": 6,
      "text": "转中火下虾，快速翻炒三分钟到虾身卷曲变色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾别久炒，一卷就熟。",
      "visual_cue": "虾身卷成弯钩，颜色橙红"
    },
    {
      "n": 7,
      "text": "加番茄块炒两分钟，炒到番茄稍微塌软出汁。",
      "time_min": 2,
      "heat": "中火",
      "tip": "番茄带来一点酸甜，让辣味更立体。",
      "visual_cue": "番茄微软，锅里有红色汁水"
    },
    {
      "n": 8,
      "text": "倒入椰奶搅匀，小火煮两分钟让酱汁包裹住虾。",
      "time_min": 2,
      "heat": "小火",
      "tip": "椰奶别滚太久，容易出油。",
      "visual_cue": "酱汁浓稠包裹虾身"
    },
    {
      "n": 9,
      "text": "关火后挤入青柠汁拌匀，盛盘即可上桌品尝。",
      "time_min": 1,
      "heat": "无火",
      "tip": "青柠汁关火后加，酸香才明亮。",
      "visual_cue": "虾身红亮，酱汁泛油光"
    }
  ],
  "tips": [
    "辣椒泥必须小火炒到出红油，否则生辣刺口。",
    "虾要开背挑掉沙线，口感才干净无沙。",
    "椰奶和青柠汁都最后加，香气不会被煮散。"
  ],
  "common_mistakes": [
    "参巴泥大火快炒，溅油又带焦苦味。",
    "虾炒过了头，肉质变硬像橡皮筋。",
    "完全不放糖，辣味尖锐而且没有回甘。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鱿鱼",
      "ratio": "600 克:600 克",
      "note": "炒制时间缩短到两分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "辣椒粉",
      "ratio": "20 克:12 克",
      "note": "香气略薄，需多加五克蒜末。"
    }
  ],
  "variations": [
    "加两片咖喱叶同炒，香气更南洋。",
    "配米饭或椰浆饭，酱汁拌饭最香。"
  ],
  "serving_suggestion": "配椰浆饭、黄瓜片和水煮蛋一起上桌。",
  "storage": "冷藏两天，复热小火加一勺椰奶调开。",
