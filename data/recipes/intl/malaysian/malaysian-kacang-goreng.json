  "steps": [
    {
      "n": 1,
      "text": "豇豆洗净后切成四厘米长段，粗的顺长剖成两半。",
      "time_min": 6,
      "heat": "无火",
      "tip": "粗豇豆剖开才熟得均匀，不剖外软内生。",
      "visual_cue": "豆段长短一致，粗条已剖成两半"
    },
    {
      "n": 2,
      "text": "虾米用温水泡软后剁碎，蒜拍碎，小洋葱切细丝。",
      "time_min": 6,
      "heat": "无火",
      "tip": "虾米剁碎才能均匀分布，整只咬着太咸。",
      "visual_cue": "虾米成碎粒，蒜香明显"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下虾米碎小火煸到微脆出香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾米煸脆是提鲜关键，火大直接焦苦。",
      "visual_cue": "虾米碎金黄发脆，油带海鲜香"
    },
    {
      "n": 4,
      "text": "下蒜、洋葱丝与干辣椒炒香，转大火倒入豇豆翻炒三分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "大火快炒，豇豆要保持脆，别炒到发黄。",
      "visual_cue": "豆段转深绿，表面起小泡"
    },
    {
      "n": 5,
      "text": "加生抽、盐与白糖翻匀，沿锅边淋两勺清水焖一分钟即可。",
      "time_min": 3,
      "heat": "中火",
      "tip": "淋一点水焖一分钟能保证熟透又不软塌。",
      "visual_cue": "水汽收干，豆段翠绿挂汁"
    }
  ],
  "tips": [
    "豇豆一定要炒熟透，半生的豆角吃了会不舒服。",
    "粗的豇豆要先剖开，这是保证熟度的小技巧。",
    "虾米和生抽都咸，盐要最后尝过再补。",
    "加一勺辣椒酱同炒，辣味更足，颜色也更红。"
  ],
  "common_mistakes": [
    "豇豆没炒透就出锅，豆腥味重还发硬。",
    "全程小火慢炒，豆段发黄出水，脆感全失。",
    "虾米没泡直接下锅，嚼起来硌牙又过咸。",
    "盐和生抽一起重手放，咸得发苦，只能多配饭。"
  ],
  "substitutions": [
    {
      "original": "豇豆",
      "substitute": "四季豆",
      "ratio": "450克:450克",
      "note": "同样切段，焖的时间加三十秒。"
    },
    {
      "original": "虾米",
      "substitute": "虾酱",
      "ratio": "25克:12克",
      "note": "咸度更高，盐可以不放。"
    }
  ],
  "variations": [
    "加几只虾仁同炒，鲜甜更明显，颜色也好看。",
    "加半个番茄同炒，酸味解腻，汁水也更足。",
    "换成豆角加椰浆同焖，风味更浓。"
  ],
  "serving_suggestion": "装盘配白饭与咖喱，脆嫩的豆段正好解咖喱的浓。",
  "storage": "冷藏可放一天，复热用炒锅大火快炒，不要久焖以免发黄。",
