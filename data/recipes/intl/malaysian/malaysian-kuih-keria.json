        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "炒锅",
    "漏勺",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红薯去皮切块，上锅蒸二十分钟到用筷子一插就透。",
      "time_min": 22,
      "heat": "中火",
      "tip": "蒸到一插就透，压泥才不会有颗粒。",
      "visual_cue": "筷子轻松穿透薯块"
    },
    {
      "n": 2,
      "text": "趁热把红薯压成细腻的薯泥，摊开放到不烫手。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁热压成薯泥更顺滑，放凉了就会结块。",
      "visual_cue": "薯泥细腻，无颗粒"
    },
    {
      "n": 3,
      "text": "薯泥加面粉和盐揉成软硬适中的面团，不粘手即可。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面粉分次加，面团太硬炸出来会发干。",
      "visual_cue": "面团光滑，稍带弹性"
    },
    {
      "n": 4,
      "text": "面团搓成长条分成小段，逐个搓圆后按扁，中间戳一个洞。",
      "time_min": 12,
      "heat": "无火",
      "tip": "中间戳洞受热更均匀，形状也更像甜甜圈。",
      "visual_cue": "圆环大小厚薄一致"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧到六成热，下红薯圈中小火炸到金黄浮起。",
      "time_min": 10,
      "heat": "中火",
      "tip": "油温别太高，外焦里生最常出问题。",
      "visual_cue": "表面金黄，浮在油面"
    },
    {
      "n": 6,
      "text": "捞出沥油，另起锅把白糖和清水小火熬成浓稠糖浆。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖浆熬到能挂勺就够，熬过头会发苦。",
      "visual_cue": "糖浆浓稠，能拉丝"
    },
    {
      "n": 7,
      "text": "把炸好的红薯圈倒进糖浆里快速翻匀，糖浆反沙变白即可。",
      "time_min": 4,
      "heat": "小火",
      "tip": "翻到糖浆反沙结霜，吃起来才够脆。",
      "visual_cue": "表面结起一层白霜"
    }
  ],
  "tips": [
    "红薯要蒸到一插就透，薯泥才细腻。",
    "面粉分次加，面团太硬口感会发干。",
    "糖浆熬到能挂勺，再下甜甜圈翻匀。"
  ],
  "common_mistakes": [
    "薯泥没有压细，成品里能吃到硬块。",
    "油温太高，外面焦了里面还是生的。",
    "糖浆熬过了头，裹上去又硬又带苦味。"
  ],
  "substitutions": [
    {
      "original": "红薯",
      "substitute": "紫薯",
      "ratio": "600 克:600 克",
      "note": "颜色漂亮，甜度略低。"
    },
    {
      "original": "面粉",
      "substitute": "糯米粉",
      "ratio": "150 克:150 克",
      "note": "口感更软糯，需多加少许水。"
    }
  ],
  "variations": [
    "糖浆里加两片香兰叶，香气更南洋。",
    "出锅撒上一层椰蓉，口感会更清爽。"
  ],
  "serving_suggestion": "放凉后配一杯拉茶或黑咖啡，是马来半岛下午茶最常见的传统糕点。",
  "storage": "常温密封一天，冷藏三天；复热用平底锅小火两面烘一分钟。",
