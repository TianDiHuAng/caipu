  "steps": [
    {
      "n": 1,
      "text": "螃蟹刷洗干净，掀开蟹盖去腮，斩成四块沥干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "蟹腮和胃囊要去净，否则带腥苦。",
      "visual_cue": "蟹块干净没有杂质"
    },
    {
      "n": 2,
      "text": "大蒜、姜和洋葱切碎，辣椒粉和番茄酱量好放在手边。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蒜姜切细一点，炒出来才不留颗粒。",
      "visual_cue": "碎末切得均匀又细腻"
    },
    {
      "n": 3,
      "text": "炒锅烧热植物油，下蒜末、姜末和洋葱碎小火炒香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "全程小火慢炒，蒜末炒焦了整锅都苦。",
      "visual_cue": "汤汁红亮，质地浓稠"
    },
    {
      "n": 4,
      "text": "加辣椒粉和番茄酱炒出红油，倒入清水烧开。",
      "time_min": 4,
      "heat": "中火",
      "tip": "辣椒粉先用油炒过，颜色才红亮。",
      "visual_cue": "汤汁红亮，质地浓稠"
    },
    {
      "n": 5,
      "text": "放入蟹块盖盖中火煮八分钟，中途翻动一次让受热均匀。",
      "time_min": 10,
      "heat": "中火",
      "tip": "蟹壳变红不等于熟透，要煮够时间。",
      "visual_cue": "蟹壳通红，汤汁收半"
    },
    {
      "n": 6,
      "text": "加白糖和盐调味，再淋入玉米淀粉水勾一层薄芡。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芡要勾得薄，能挂住蟹块就够了。",
      "visual_cue": "汤汁浓稠，紧紧挂壳"
    },
    {
      "n": 7,
      "text": "转小火淋入打散的鸡蛋液，静置十秒后轻推成蛋花，撒香菜末出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蛋液下锅别马上搅，蛋花才成片。",
      "visual_cue": "蛋花成片，红汤点缀绿末"
    }
  ],
  "tips": [
    "蟹块下锅前要沥干，带水下锅油会炸开。",
    "辣椒粉先用油炒过，红油色泽才漂亮。",
    "蛋液最后淋入并静置片刻，蛋花才会成片。"
  ],
  "common_mistakes": [
    "蟹腮没去净，整盘带上明显腥苦味。",
    "蟹块煮的时间不足，蟹肉发黏不成丝。",
    "芡勾得太厚，汤汁稠成糊裹住蟹壳。"
  ],
  "substitutions": [
    {
      "original": "螃蟹",
      "substitute": "花蟹",
      "ratio": "900 克:900 克",
      "note": "肉质更甜，煮的时间略短。"
    },
    {
      "original": "辣椒粉",
      "substitute": "辣椒酱",
      "ratio": "8 克:30 克",
      "note": "辣度更柔和，需减糖。"
    }
  ],
  "variations": [
    "加两勺酸梅酱进去，酸甜味道更突出。",
    "用蟹钳替代整只蟹，吃起来更加方便。"
  ],
  "serving_suggestion": "配白米饭或炸馒头片蘸汁，是马来西亚海鲜餐馆最受欢迎的吃法。",
  "storage": "冷藏一天，复热时加少量清水小火加热至滚开，避免蟹肉变老。",
