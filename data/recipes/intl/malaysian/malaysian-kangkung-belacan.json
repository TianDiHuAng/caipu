  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "漏勺",
    "研钵"
  ],
  "steps": [
    {
      "n": 1,
      "text": "空心菜摘成六厘米段，梗与叶分开放，洗净沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "梗叶分开下锅，一起炒叶子烂了梗还是硬的。",
      "visual_cue": "菜梗与叶片分装两盘，沥干无积水"
    },
    {
      "n": 2,
      "text": "用研钵把干辣椒、红葱头、蒜与虾酱舂成带颗粒的粗泥状酱料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "舂成粗泥就够，太细会出水，炒时容易溅油。",
      "visual_cue": "酱料带颗粒，颜色深褐发亮"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到微微冒烟，下酱料小火炒出红油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾酱一定要炒透去腥，闻到酱香才算到位。",
      "visual_cue": "油色转红，酱香浓烈扑鼻"
    },
    {
      "n": 4,
      "text": "转大火下菜梗快炒一分钟，再下菜叶翻炒三十秒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "全程大火快炒，锅气足菜才脆，久炒出水变黄。",
      "visual_cue": "菜梗翠绿挺立，叶片刚塌"
    },
    {
      "n": 5,
      "text": "加生抽、白糖与盐快速翻匀，立刻出锅装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "调味翻两下就出锅，多炒十秒就出汤。",
      "visual_cue": "盘底汤汁极少，菜色油亮"
    }
  ],
  "tips": [
    "空心菜要挑梗细叶嫩的，粗梗怎么炒都老。",
    "虾酱本身很咸，生抽与盐都要少放，先尝再补。",
    "锅一定要烧到冒烟再下菜，火力不足炒不出锅气。",
    "没有研钵就把酱料剁碎，效果也接近。"
  ],
  "common_mistakes": [
    "菜叶和菜梗一起下锅，叶子烂成泥梗还生。",
    "虾酱没炒透，整盘菜一股生腥味。",
    "中火慢慢炒，空心菜出水变成一锅汤。",
    "调味后还翻半天，出锅已经发黄。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "小白菜",
      "ratio": "500克:500克",
      "note": "叶片更厚，炒的时间加三十秒。"
    },
    {
      "original": "虾酱",
      "substitute": "辣椒酱",
      "ratio": "20克:25克",
      "note": "腥味轻，咸度略低需补盐。"
    }
  ],
  "variations": [
    "加几只虾仁同炒，鲜味更足也更好看。",
    "加一勺参巴辣椒酱同炒，辣度更冲，香气更野。",
    "换成豆角同炒，口感更脆，也更好挂酱。"
  ],
  "serving_suggestion": "装盘即上桌，配白饭与一碗椰浆汤，咸辣开胃，是马来煮炒档的必点菜。",
  "storage": "当餐吃完最好，冷藏不超过一天，复热用大火快炒十秒，久热会出水发黄。",
