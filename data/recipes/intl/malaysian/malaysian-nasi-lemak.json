  "equipment": [
    "电饭锅或蒸锅",
    "炒锅",
    "刀",
    "砧板",
    "研钵"
  ],
  "steps": [
    {
      "n": 1,
      "text": "米洗净沥干，加椰浆、清水三百毫升、盐、香茅、柠檬叶与姜片拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "椰浆与水的比例约一比一点二，太浓会腻、太稀没香。",
      "visual_cue": "米粒浸在乳白液体中，香茅浮在表面"
    },
    {
      "n": 2,
      "text": "用电饭锅煮饭功能煮熟，跳闸后焖十分钟再开盖，挑出香料。",
      "time_min": 30,
      "heat": "中火",
      "tip": "焖十分钟让椰香回吸到米粒里，饭才粒粒饱满。",
      "visual_cue": "饭粒油润发亮，闻起来椰香明显"
    },
    {
      "n": 3,
      "text": "干辣椒泡软，与大蒜、小葱、虾酱一起捣成粗酱，锅里下植物油小火炒香。",
      "time_min": 8,
      "heat": "小火",
      "tip": "参巴酱要小火慢炒十分钟以上，油色变红才够味。",
      "visual_cue": "酱体深红，油浮在表面"
    },
    {
      "n": 4,
      "text": "加棕榈糖、盐和青柠汁炒匀，收汁到能挂勺，盛出做佐饭辣酱。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖要在末尾加，早加容易焦黑发苦。",
      "visual_cue": "辣酱稠厚，颜色红亮"
    },
    {
      "n": 5,
      "text": "小鱼干与花生分别下油锅炸至酥脆，鸡蛋冷水下锅煮八分钟剥壳切半。",
      "time_min": 9,
      "heat": "中火",
      "tip": "小鱼干炸前拍干水分，下锅才不溅油。",
      "visual_cue": "小鱼干金黄酥脆，蛋黄半凝"
    },
    {
      "n": 6,
      "text": "椰浆饭盛入盘中，配黄瓜片、小鱼干、花生、半颗鸡蛋与一勺辣酱。",
      "time_min": 4,
      "heat": "无火",
      "tip": "配料分区摆放，吃时拌开才算地道吃法。",
      "visual_cue": "白饭、绿瓜、红酱、金脆料层次分明"
    }
  ],
  "tips": [
    "椰浆要选浓稠的，稀椰浆煮出的饭只有甜味没香气。",
    "参巴酱可一次多做，冷藏能放一周，配什么都好吃。",
    "想吃更香的口感，可用香蕉叶垫底蒸饭。"
  ],
  "common_mistakes": [
    "椰浆直接倒进锅不加水，饭油腻发黏。",
    "辣酱炒得时间不够，生蒜味冲、颜色发暗。",
    "花生炸过火或炸得不透，整盘不是焦苦就是回软发韧。"
  ],
  "substitutions": [
    {
      "original": "小鱼干",
      "substitute": "虾皮",
      "ratio": "80 克:60 克",
      "note": "虾皮更小更易焦，炸三十秒即可。"
    },
    {
      "original": "椰浆",
      "substitute": "牛奶",
      "ratio": "250 毫升:250 毫升",
      "note": "香气减弱，可加两滴香兰精补香。"
    }
  ],
  "variations": [
    "加咖喱鸡或牛肉仁当同食，可做节庆版本。"
  ],
  "serving_suggestion": "配咖喱鸡、参巴辣酱与炸小鱼，用香蕉叶垫盘。",
  "storage": "椰浆饭冷藏一天，复热用蒸锅；参巴酱冷藏一周。",
