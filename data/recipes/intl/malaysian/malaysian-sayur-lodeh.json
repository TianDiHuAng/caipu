  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "卷心菜切大块，豇豆切四厘米段，胡萝卜切粗条备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蔬菜切大块些，煮久了才有口感不至于烂成泥。",
      "visual_cue": "蔬菜块大小均匀，颜色分明"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，下小洋葱丝、蒜末与干辣椒小火煸香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "火一定要小，蒜末一焦整锅汤都会带苦味。",
      "visual_cue": "洋葱丝透明，锅中香气微辣"
    },
    {
      "n": 3,
      "text": "加姜黄与香茅炒匀，倒入清水烧开后下胡萝卜与豇豆。",
      "time_min": 7,
      "heat": "中火",
      "tip": "耐煮的先下，胡萝卜与豇豆要先煮五分钟。",
      "visual_cue": "汤水微黄，蔬菜半沉半浮"
    },
    {
      "n": 4,
      "text": "转小火煮八分钟，下卷心菜与油豆腐再煮五分钟。",
      "time_min": 13,
      "heat": "小火",
      "tip": "椰浆还没下，这时候可以放心煮，不必担心油水分离。",
      "visual_cue": "油豆腐鼓起，卷心菜变软"
    },
    {
      "n": 5,
      "text": "倒入椰浆加盐与白糖，小火煮三分钟不停搅拌即可关火。",
      "time_min": 4,
      "heat": "小火",
      "tip": "椰浆下锅后不能大滚，一滚就分离出油花。",
      "visual_cue": "汤色奶白，表面不见油花分离"
    }
  ],
  "tips": [
    "椰浆要最后放，煮开就关火，油水才不会分离。",
    "油豆腐先对半切，吸汤更快更入味。",
    "喜欢浓稠可以少放水，多放一百毫升椰浆。",
    "加几只虾仁同煮，鲜味立刻提升一个层次。"
  ],
  "common_mistakes": [
    "椰浆和清水一起下锅大火煮，汤面浮一层油。",
    "蔬菜全部同时下，结果豇豆还硬卷心菜已成泥。",
    "蒜末煸到发黑，整锅汤都带上焦苦味。",
    "盐一开始就放，蔬菜出水，汤味反而变淡。"
  ],
  "substitutions": [
    {
      "original": "豇豆",
      "substitute": "四季豆",
      "ratio": "200克:200克",
      "note": "同样切段，煮的时间一样。"
    },
    {
      "original": "椰浆",
      "substitute": "椰奶",
      "ratio": "300毫升:350毫升",
      "note": "更清爽，需减五十毫升清水。"
    }
  ],
  "variations": [
    "加一把米粉同煮，就变成一锅浓汤面。",
    "换成南瓜与茄子同煮，甜味更足。",
    "加一勺虾酱同炒底料，风味更地道。"
  ],
  "serving_suggestion": "趁热盛碗，汤要没过蔬菜，配白饭或椰浆饭，是马来家庭的日常素汤。",
  "storage": "冷藏可放两天，复热用小火并不断搅拌，避免椰浆分层。",
