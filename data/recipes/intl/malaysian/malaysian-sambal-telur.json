  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅煮十分钟，捞出泡冷水后剥壳擦干。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煮好后立刻过冷水，蛋壳才好剥且蛋身完整。",
      "visual_cue": "蛋身光滑无破损，表面干爽"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧到一百七十度，下鸡蛋炸两分钟至表皮起皱金黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "炸到表面起虎皮纹更好挂酱，注意翻动防粘。",
      "visual_cue": "蛋皮起皱发黄，捞出沥油"
    },
    {
      "n": 3,
      "text": "干辣椒、小洋葱、蒜与虾酱舂成粗泥，罗望子加水取两勺汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酱料舂粗一些更有层次，罗望子汁滤净渣。",
      "visual_cue": "酱泥深红油亮，酸汁清透"
    },
    {
      "n": 4,
      "text": "锅中留三十毫升油，下酱泥小火炒三分钟至出红油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "炒到油色发红才够香，生辣椒味必须炒掉。",
      "visual_cue": "红油浮起，酱香浓烈扑鼻"
    },
    {
      "n": 5,
      "text": "加罗望子汁、椰糖与盐炒匀，放鸡蛋对半切开翻裹酱汁即可。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鸡蛋对半切后切面朝下先煎一下，挂酱更牢。",
      "visual_cue": "酱汁裹满蛋面，盘底留少许红油"
    }
  ],
  "tips": [
    "鸡蛋炸过才有虎皮，挂酱效果比水煮蛋好很多。",
    "想少油可以半煎半炸，油量减到八十毫升。",
    "罗望子汁要一点点加，酸度够了就停。",
    "椰糖能让辣味变得圆润，别用白糖替代太多。"
  ],
  "common_mistakes": [
    "鸡蛋没擦干就下油锅，油花四溅。",
    "酱料没炒透，一股生辣椒的青涩味。",
    "罗望子汁一次倒完，酸得舌头发麻。",
    "鸡蛋煮太久，蛋黄发绿还带异味。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "鹌鹑蛋",
      "ratio": "5个:15个",
      "note": "个头小，炸的时间减四十秒。"
    },
    {
      "original": "椰糖",
      "substitute": "红糖",
      "ratio": "12克:10克",
      "note": "甜度更重，需减量。"
    }
  ],
  "variations": [
    "加几只炸豆腐同炒，口感更丰富。",
    "加一把炸小鱼干同炒，咸香更足，口感更脆。",
    "换成水煮蛋不炸，做成清爽版三巴蛋。"
  ],
  "serving_suggestion": "对半切开摆在盘里，淋上红油酱汁，配椰浆饭与黄瓜片，是最经典的马来组合。",
  "storage": "冷藏可放两天，酱汁与蛋一起存；复热用小火加一勺水焖两分钟。",
