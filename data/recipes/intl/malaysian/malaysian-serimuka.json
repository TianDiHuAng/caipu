  },
  "servings": 6,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米",
          "name_en": "glutinous rice",
          "amount": 250,
          "unit": "g",
          "note": "提前泡水",
          "optional": false
        },
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 400,
          "unit": "ml",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 150,
          "unit": "g",
          "note": "约三枚",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 50,
          "unit": "g",
          "note": "调蛋层",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 200,
          "unit": "ml",
          "note": "蒸糯米",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "方模",
    "盆",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米提前泡水两小时，沥干后拌入一百五十毫升椰奶和一半白糖、盐。",
      "time_min": 15,
      "heat": "无火",
      "tip": "糯米要泡到手指一捏就碎，蒸出来才软糯。",
      "visual_cue": "米粒饱满，捏之即碎"
    },
    {
      "n": 2,
      "text": "拌好的糯米铺进抹油的方模，压平压实，上锅大火蒸二十五分钟。",
      "time_min": 26,
      "heat": "大火",
      "tip": "一定要压得紧实，松了切块时容易散开。",
      "visual_cue": "米层平整且压得结实"
    },
    {
      "n": 3,
      "text": "鸡蛋打散加剩余白糖搅到糖化，不打出大泡。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅的时候贴着盆底，别搅进空气。",
      "visual_cue": "蛋液细腻，糖粒消失"
    },
    {
      "n": 4,
      "text": "面粉加清水调成无颗粒粉浆，倒进蛋液里拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉浆先单独调开，直接倒进蛋液会结块。",
      "visual_cue": "浆液顺滑没有颗粒"
    },
    {
      "n": 5,
      "text": "倒入剩余椰奶拌匀过筛，得到细腻的奶白蛋浆。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛一次，蒸出来的表层才光滑如镜。",
      "visual_cue": "蛋浆奶白且质地细腻"
    },
    {
      "n": 6,
      "text": "把蛋浆缓缓倒在蒸好的糯米层上，轻敲模具震出气泡。",
      "time_min": 4,
      "heat": "无火",
      "tip": "沿着模具边缓慢倒入，别把糯米层冲翻。",
      "visual_cue": "蛋浆均匀覆盖米层"
    },
    {
      "n": 7,
      "text": "上锅中小火蒸二十五分钟到蛋层凝固不晃，取出彻底放凉。",
      "time_min": 30,
      "heat": "中火",
      "tip": "小火蒸表面才光滑，大火会起蜂窝。",
      "visual_cue": "表面光滑，轻推不流动"
    },
    {
      "n": 8,
      "text": "完全凉透后刀抹油切块，每块带米层和蛋层。",
      "time_min": 6,
      "heat": "无火",
      "tip": "必须凉透再切，热切两层会分离。",
      "visual_cue": "切面齐整，两层分明"
    }
  ],
  "tips": [
    "糯米要泡足两小时，蒸完才软糯不夹生。",
    "蛋浆过筛后再倒，表面才光滑无气孔。",
    "蒸蛋层全程中小火，火大表皮会起蜂窝。"
  ],
  "common_mistakes": [
    "糯米没泡透，蒸完中间还是硬芯。",
    "蛋浆直接倒下去，把糯米层冲翻了。",
    "大火蒸蛋层，表面全是蜂窝气孔。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "椰浆加牛奶",
      "ratio": "400 毫升:250 毫升+150 毫升",
      "note": "更清爽，蒸的时间不变。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "120 克:120 克",
      "note": "颜色偏棕，风味更浓。"
    }
  ],
  "variations": [
    "蛋层里加几滴斑斓汁，颜色更翠绿。",
    "米层里拌一勺炒香的白芝麻，香气更足。"
  ],
  "serving_suggestion": "切块后常温吃，配一杯无糖的马来西亚拉茶，是下午茶的经典组合。",
  "storage": "密封冷藏两天，吃前回温十分钟，冷藏久了米层会变硬。",
