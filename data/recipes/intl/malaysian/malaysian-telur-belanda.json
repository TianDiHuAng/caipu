  "equipment": [
    "炒锅",
    "碗",
    "打蛋器",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打入碗中加白胡椒打散至蛋白蛋黄完全融合。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打散到看不见蛋清丝，炒出来才嫩滑不起块。",
      "visual_cue": "蛋液颜色均匀，表面有细泡"
    },
    {
      "n": 2,
      "text": "番茄切滚刀块，小洋葱切丝，蒜切末，青葱切段备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "番茄别切太小，炒的时候要能保持块形。",
      "visual_cue": "番茄块大小均匀，汁水不外流"
    },
    {
      "n": 3,
      "text": "炒锅倒一半植物油烧热，倒入蛋液炒成嫩块盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋液半凝固就盛出，回锅还会继续熟。",
      "visual_cue": "蛋块嫩滑微颤，不带焦边"
    },
    {
      "n": 4,
      "text": "锅中补油下洋葱丝与蒜末炒香，加番茄块炒到出汁变软。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄要炒到出汁才好吃，压一压更容易出沙。",
      "visual_cue": "番茄塌软出汁，锅中有红色汤汁"
    },
    {
      "n": 5,
      "text": "加番茄酱、生抽、白糖与盐炒匀，回锅蛋块翻匀，撒青葱即可。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋块回锅只翻两下就得盛出，久炒就变老。",
      "visual_cue": "酱汁裹住蛋块，色泽红亮"
    }
  ],
  "tips": [
    "番茄选熟透的，酸甜足，不用多加糖。",
    "蛋液里加一小勺清水，炒出来更嫩。",
    "番茄酱能让颜色更红亮，但别放太多以免抢味。",
    "喜欢辣可以加一只切碎的干辣椒同炒。"
  ],
  "common_mistakes": [
    "鸡蛋炒得太老，回锅后变成橡皮块。",
    "番茄没炒出汁就下蛋，成品干巴巴。",
    "白糖放太多，整盘菜甜得像甜点，配饭很怪。",
    "盐放得太早，番茄大量出水，成品变成一锅汤。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "400克:350克",
      "note": "已有汤汁，糖可减半。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4个:4个",
      "note": "蛋味更浓，需多炒三十秒。"
    }
  ],
  "variations": [
    "加一勺辣椒酱同炒，酸甜带辣更开胃。",
    "加半个洋葱丁同炒，口感更丰富。",
    "盖上白饭做成烩饭，汤汁拌饭极好。"
  ],
  "serving_suggestion": "浇在白饭上，配一份炒青菜与炸虾饼，是马来家庭的快手晚餐。",
  "storage": "冷藏可放一天，复热用炒锅小火加一勺水焖一分钟，微波会让蛋变硬。",
