  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 200,
          "unit": "g",
          "note": "过筛",
          "optional": false
        },
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 300,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 100,
          "unit": "g",
          "note": "调节甜度",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 150,
          "unit": "ml",
          "note": "调浆",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 10,
          "unit": "ml",
          "note": "抹模",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "方模",
    "筛网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "方模内壁薄薄刷一层植物油，蒸锅加水烧开备用。",
      "time_min": 8,
      "heat": "大火",
      "tip": "模具刷油，脱模时才能整块取出。",
      "visual_cue": "模具内壁有薄油光"
    },
    {
      "n": 2,
      "text": "糯米粉过筛进大碗，加盐后先用筷子搅散结块。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过筛能避免蒸出硬粒。",
      "visual_cue": "粉质细腻，无小疙瘩"
    },
    {
      "n": 3,
      "text": "倒入椰奶与清水，慢慢搅成顺滑无颗粒的稀米浆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "边倒边搅，米浆才均匀。",
      "visual_cue": "米浆顺滑，能流动"
    },
    {
      "n": 4,
      "text": "米浆分成两份，其中一份加白糖搅到完全化开。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖要化透，否则成品有甜斑。",
      "visual_cue": "两份米浆颜色一深一浅"
    },
    {
      "n": 5,
      "text": "两份米浆各过一遍细筛，滤掉气泡与粗颗粒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛后每层才平整。",
      "visual_cue": "米浆表面看不到浮沫"
    },
    {
      "n": 6,
      "text": "模具放蒸锅上，倒入一层白色米浆铺满底部。",
      "time_min": 2,
      "heat": "大火",
      "tip": "薄薄一层，蒸得快也均匀。",
      "visual_cue": "米浆铺平，厚度一致"
    },
    {
      "n": 7,
      "text": "盖盖大火蒸四分钟，到表面凝固不粘手再倒下一层。",
      "time_min": 4,
      "heat": "大火",
      "tip": "层要凝固才加下一层，否则会混。",
      "visual_cue": "表面凝固，按压不粘"
    },
    {
      "n": 8,
      "text": "交替倒入另一色的米浆，重复蒸制直到层数达到九层为止。",
      "time_min": 27,
      "heat": "大火",
      "tip": "每层都用大火蒸四分钟。",
      "visual_cue": "层与层分明，颜色交替"
    },
    {
      "n": 9,
      "text": "最后一层倒满后蒸八分钟，直到中心部分完全熟透为止。",
      "time_min": 8,
      "heat": "大火",
      "tip": "最后一层多加时间，中心才透。",
      "visual_cue": "表面光滑，竹签插入不带浆"
    },
    {
      "n": 10,
      "text": "离火完全放凉两小时，凉透后倒扣脱模切块。",
      "time_min": 120,
      "heat": "无火",
      "tip": "必须凉透再切，热切会粘刀。",
      "visual_cue": "糕体回弹，切面层纹清晰"
    }
  ],
  "tips": [
    "每层都要蒸到凝固再加下一层，层纹才清晰。",
    "米浆过筛两次，蒸出来的面才平整。",
    "彻底放凉再切，切面才干净利落。"
  ],
  "common_mistakes": [
    "层没凝固就倒下一层，蒸好混成一团。",
    "糖没化开就直接上锅，成品有甜斑。",
    "热着就切块，刀口粘连连不成形。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "300 毫升:300 毫升",
      "note": "奶香变淡，可多加十克糖。"
    },
    {
      "original": "糯米粉",
      "substitute": "粘米粉",
      "ratio": "200 克:200 克",
      "note": "口感更硬挺，弹韧略弱。"
    }
  ],
  "variations": [
    "其中一层加少量斑斓汁，颜色更漂亮。",
    "糖量减半，做成清淡版本更耐吃。"
  ],
  "serving_suggestion": "切成长方块装盘，配茶当下午茶点。",
  "storage": "冷藏两天内吃完，回温后口感更软。",
