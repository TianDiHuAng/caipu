  "equipment": [
    "汤锅",
    "碗",
    "叉子",
    "裱花袋",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋放进冷水锅里，水开后转中火煮十分钟捞出。",
      "time_min": 11,
      "heat": "中火",
      "tip": "冷水下锅慢升温，蛋壳才不容易煮裂。",
      "visual_cue": "水面微滚，蛋壳完整"
    },
    {
      "n": 2,
      "text": "鸡蛋过冷水浸两分钟，敲裂剥壳后对半切开。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过冷水让蛋膜收缩，剥壳又快又光整。",
      "visual_cue": "蛋白光滑，切面平整"
    },
    {
      "n": 3,
      "text": "挖出全部蛋黄放进碗里，蛋白摆盘留出凹槽。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋黄挖干净，凹槽深一些才装得下馅。",
      "visual_cue": "蛋白边缘整齐无破损"
    },
    {
      "n": 4,
      "text": "蛋黄用叉子压碎，加蛋黄酱、白醋、盐和黑胡椒拌成泥。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到顺滑无颗粒，挤出来才漂亮。",
      "visual_cue": "蛋泥细腻顺滑，能立住小尖"
    },
    {
      "n": 5,
      "text": "蛋泥装进裱花袋，挤回蛋白凹槽，撒甜椒粉和欧芹碎。",
      "time_min": 4,
      "heat": "无火",
      "tip": "挤花时不要贪高，撒上甜椒粉颜色最好看。",
      "visual_cue": "花纹饱满，红绿点缀分明"
    }
  ],
  "tips": [
    "鸡蛋冷水下锅再加热，蛋壳基本不会裂。",
    "煮熟立刻过冷水，剥壳完整不带走蛋白。",
    "蛋泥要拌到顺滑，挤出来才有漂亮花纹。"
  ],
  "common_mistakes": [
    "鸡蛋热水下锅，蛋壳中途炸开蛋白流出。",
    "蛋黄没压碎就拌，馅料粗糙堵住花嘴。",
    "做好放太久不冷藏，蛋黄酱容易变质。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "酸奶油",
      "ratio": "60 克:60 克",
      "note": "更清爽微酸，需加一克盐平衡。"
    },
    {
      "original": "白醋",
      "substitute": "柠檬汁",
      "ratio": "5 毫升:5 毫升",
      "note": "香气更新鲜，用量相同。"
    }
  ],
  "variations": [
    "拌入一点芥末提味，辛香更开胃。",
    "加碎培根和香葱，做成咸香美式版本。"
  ],
  "serving_suggestion": "冷藏二十分钟定型后上桌，做冷盘或聚会小食都合适。",
  "storage": "密封冷藏一天内吃完，出餐前再撒甜椒粉。",
