  "steps": [
    {
      "n": 1,
      "text": "汤锅烧开加盐，放入意大利面煮到略硬有嚼劲的状态。",
      "time_min": 10,
      "heat": "大火",
      "tip": "比包装时间少一分钟，拌好后口感刚好。",
      "visual_cue": "意大利面中心留一点白色芯，掐断有弹性"
    },
    {
      "n": 2,
      "text": "意大利面捞出沥干，趁热拌入一半橄榄油摊开降温。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热拌入少量油，能防止意大利面粘连成坨。",
      "visual_cue": "意大利面根根分明，表面泛油光"
    },
    {
      "n": 3,
      "text": "番茄对半切开，青椒与洋葱切小丁，奶酪切成同样大小的小块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切得大小一致，一勺舀起来口感才好。",
      "visual_cue": "各色小块大小均匀，盆里色彩分明"
    },
    {
      "n": 4,
      "text": "把蔬菜与奶酪倒进意大利面，加剩余橄榄油与柠檬汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁先加一半，尝味再补，避免过酸。",
      "visual_cue": "食材拌匀，表面油润不干涩"
    },
    {
      "n": 5,
      "text": "撒盐、黑胡椒与罗勒碎，用两把勺子从底部翻拌均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻拌比用力搅动轻柔，意大利面才不会断裂。",
      "visual_cue": "调味料分布均匀，盆底没有积油"
    },
    {
      "n": 6,
      "text": "盖好放入冷藏三十分钟，让意大利面吸足味道再上桌。",
      "time_min": 30,
      "heat": "无火",
      "tip": "冷藏会让味道变淡，上桌前再补一点盐。",
      "visual_cue": "意大利面明显入味，整体清爽不腻"
    }
  ],
  "tips": [
    "加一把黑橄榄和火腿丁，风味更接近美式熟食店版本。",
    "用螺旋面比细面更能挂住酱汁不滑落。",
    "冷藏时间别超过半天，意大利面会吸干变硬。",
    "上桌前一勺橄榄油再拌一次，光泽立刻回来。"
  ],
  "common_mistakes": [
    "意大利面煮过头再拌，成品软烂粘成一团。",
    "趁热就把蔬菜全拌进去，番茄被烫软出水。",
    "冷藏过夜才吃，意大利面吸干酱汁像干草。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "马苏里拉",
      "ratio": "60克:60克",
      "note": "更软更能拉丝。"
    },
    {
      "original": "意大利面",
      "substitute": "通心粉",
      "ratio": "300克:300克",
      "note": "挂汁能力接近。"
    }
  ],
  "variations": [
    "加一勺意式油醋汁，整体酸香更明显。",
    "拌入烤鸡肉块，做成能当主食的版本。"
  ],
  "serving_suggestion": "作为烧烤聚会的配菜，或装盒当午餐便当都合适。",
  "storage": "冷藏两天内吃完，食用前补一点橄榄油与盐拌匀。",
