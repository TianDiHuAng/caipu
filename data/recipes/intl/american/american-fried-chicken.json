        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 8,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "深锅",
    "漏勺",
    "大碗",
    "夹子",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿切成大块，用厨房纸吸干水分，表面撒一半盐和黑胡椒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表皮越干，裹粉才挂得住不脱落。，注意火候。",
      "visual_cue": "鸡块干爽，表面有盐粒"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进碗里加牛奶打散，调成均匀的蛋奶液备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋奶液打匀，挂糊才均匀不结块。，注意火候。",
      "visual_cue": "蛋液顺滑，颜色淡黄，状态稳定"
    },
    {
      "n": 3,
      "text": "面粉加剩余盐、黑胡椒和辣椒粉拌匀，做成调味裹粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "裹粉先调匀，每块鸡的咸辣度才一致。",
      "visual_cue": "粉料均匀，颜色微红，状态稳定"
    },
    {
      "n": 4,
      "text": "鸡块先裹一层粉，再蘸蛋奶液，最后回到粉里压紧裹匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "两次沾粉压紧，炸的时候外壳才不会掉。",
      "visual_cue": "外壳厚实，粉层均匀，状态稳定"
    },
    {
      "n": 5,
      "text": "裹好的鸡块静置十分钟，让粉层吸湿贴在肉上。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置后粉层紧贴，下锅不容易脱壳。，注意火候。",
      "visual_cue": "表面微湿，粉层紧贴，状态稳定"
    },
    {
      "n": 6,
      "text": "深锅倒植物油烧到一百六十度，下鸡块慢炸十二分钟。",
      "time_min": 14,
      "heat": "中火",
      "tip": "油温别太高，外面焦了里面还是生的。",
      "visual_cue": "油面小泡，鸡块上浮，状态稳定"
    },
    {
      "n": 7,
      "text": "捞出沥油三分钟，再把油温升到一百八十度复炸两分钟。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "复炸这一步让外壳变脆，颜色也更金。",
      "visual_cue": "外壳金黄，声响清脆，状态稳定"
    },
    {
      "n": 8,
      "text": "捞出放在厨房纸上吸油，撒少许盐趁热上桌。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热撒盐才粘得住，冷了就挂不上。，注意火候。",
      "visual_cue": "表皮酥脆，油迹吸干，状态稳定"
    }
  ],
  "tips": [
    "鸡块表面吸干再裹粉，外壳才挂得牢。，值得留意。",
    "先低温炸透再高温复炸，皮脆肉嫩。，值得留意。",
    "裹好粉静置十分钟，下锅不容易脱壳。，值得留意。"
  ],
  "common_mistakes": [
    "油温太低就下锅，外壳吸满油发腻。，务必避免。",
    "一块块连着下锅，最后全粘成一团。，务必避免。",
    "炸好堆在一起焖着，外壳很快回软。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡翅",
      "ratio": "800 克:800 克",
      "note": "炸制时间减三分钟，更易熟透。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "100 毫升:100 毫升",
      "note": "挂糊更薄，口感偏脆硬。"
    }
  ],
  "variations": [
    "裹粉里加一勺蒜粉，香气更足。，也很受欢迎。",
    "炸好拌入辣酱，做成水牛城风味。，也很受欢迎。"
  ],
  "serving_suggestion": "配凉拌卷心菜和薯条，是美式餐吧的经典组合。",
  "storage": "冷藏两天，复热用烤箱二百度烤十分钟恢复脆皮。",
