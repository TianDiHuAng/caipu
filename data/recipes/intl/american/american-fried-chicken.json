      "items": [
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 800,
          "unit": "g",
          "note": "带骨切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 200,
          "unit": "g",
          "note": "裹粉",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 120,
          "unit": "g",
          "note": "挂糊",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 100,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 260,
          "unit": "ml",
          "note": "炸制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
