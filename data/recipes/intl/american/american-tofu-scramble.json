          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐用厨房纸包住，压上重物静置十五分钟挤出水分。",
      "time_min": 18,
      "heat": "无火",
      "tip": "水分挤得越干，炒出来越松散也不糊锅。",
      "visual_cue": "豆腐块明显变薄，纸被浸湿"
    },
    {
      "n": 2,
      "text": "用手把豆腐捏成不规则的小碎块，模仿炒蛋的质感。",
      "time_min": 4,
      "heat": "无火",
      "tip": "别捏成泥，留一点大小不一的块口感才像。",
      "visual_cue": "碎块大小不均，断面边缘毛糙"
    },
    {
      "n": 3,
      "text": "平底锅烧热橄榄油，下洋葱丁小火炒到透明出甜味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱先炒软，整道菜的底味都靠它打底。",
      "visual_cue": "洋葱变软透明，锅里没有生辣味"
    },
    {
      "n": 4,
      "text": "放甜椒丁炒两分钟，保持一点脆度不要炒塌软。",
      "time_min": 3,
      "heat": "中火",
      "tip": "甜椒久炒会出水变软，颜色也会跟着发暗。",
      "visual_cue": "甜椒颜色鲜亮，块形仍然挺立"
    },
    {
      "n": 5,
      "text": "倒入豆腐碎，加辣椒粉、孜然、盐与黑胡椒翻炒均匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "不停翻动让香料均匀裹上，别让底部结成块。",
      "visual_cue": "豆腐碎均匀上色，呈温暖的橘黄色"
    },
    {
      "n": 6,
      "text": "淋入生抽翻炒一分钟，让豆腐充分吸收咸鲜味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "生抽沿锅边淋下去，遇热散出的酱香更明显。",
      "visual_cue": "碎块颜色加深，锅里几乎没有水汽"
    },
    {
      "n": 7,
      "text": "放入菠菜段翻拌到刚刚塌软，随即关火装盘上桌。",
      "time_min": 2,
      "heat": "中火",
      "tip": "菠菜一变软就关火，锅里的余温还会继续加热。",
      "visual_cue": "菠菜深绿柔软，没有出水的痕迹"
    }
  ],
  "tips": [
    "加一勺营养酵母，会有类似奶酪的咸香。",
    "配烤吐司吃，或者卷进玉米饼里都很好吃。",
    "豆腐换成南豆腐，口感更嫩但更难成形。",
    "吃剩的冷藏后复热，味道反而更进味。"
  ],
  "common_mistakes": [
    "豆腐没压水就下锅，炒出一锅水变成炖豆腐。",
    "火太大还不停翻，豆腐碎被炒成一团糊。",
    "菠菜下锅后炒太久，颜色发黄还出一盘水。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "南豆腐",
      "ratio": "450克:450克",
      "note": "更嫩，需减少翻炒次数。"
    },
    {
      "original": "甜椒",
      "substitute": "蘑菇",
      "ratio": "80克:100克",
      "note": "鲜味更浓，需多炒两分钟。"
    }
  ],
  "variations": [
    "加一小勺咖喱粉，风味立刻变成异国早午餐。",
    "撒一把切达奶酪丝，融化后更接近真炒蛋。"
  ],
  "serving_suggestion": "趁热装盘，配一份烤面包、牛油果或薯饼都合适。",
  "storage": "冷藏可放两天，复热用平底锅比微波炉好得多。",
