  "equipment": [
    "烤箱",
    "平底锅",
    "烤盘",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜椒从蒂部横切掉盖子，掏净籽与白色筋膜，洗净沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "筋膜去掉才不苦，底部保持完整不漏汁。",
      "visual_cue": "甜椒内部干净光滑，外壁无裂口"
    },
    {
      "n": 2,
      "text": "平底锅放橄榄油，下洋葱碎炒三分钟到变软透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒软出甜味，拌好的馅料才不显生。",
      "visual_cue": "洋葱边缘透明，锅里散出甜香"
    },
    {
      "n": 3,
      "text": "加牛肉末炒散到完全变色，再拌入番茄丁炒两分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "牛肉末要炒到没有粉色，颗粒散开别结块。",
      "visual_cue": "牛肉末呈褐色碎粒，锅底没有血水"
    },
    {
      "n": 4,
      "text": "关火拌入米饭、一半番茄酱与一半奶酪，加盐与黑胡椒调味。",
      "time_min": 3,
      "heat": "无火",
      "tip": "米饭要用隔夜冷饭，吸过汁水后不会糊。",
      "visual_cue": "馅料拌匀抱团，颜色红褐发亮"
    },
    {
      "n": 5,
      "text": "甜椒竖放在烤盘里，把馅料填到八分满，轻压压实。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馅料填太满会溢出，留一点空间给奶酪。",
      "visual_cue": "馅料紧实不下陷，甜椒直立不歪"
    },
    {
      "n": 6,
      "text": "表面铺剩余奶酪，盖锡纸一百八十度烤三十分钟。",
      "time_min": 30,
      "heat": "中火",
      "tip": "盖锡纸先焖熟，最后再开盖让奶酪上色。",
      "visual_cue": "甜椒外壁变软起皱，奶酪基本融化"
    },
    {
      "n": 7,
      "text": "揭掉锡纸再烤十分钟，表面金黄起泡后取出静置五分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "静置能让汁水回落，切开不流一盘子汤。",
      "visual_cue": "表面奶酪金黄冒泡，颜色深浅均匀"
    }
  ],
  "tips": [
    "剩下的馅料可以单独煎成肉饼，第二天夹面包吃。",
    "甜椒先用微波炉加热三分钟，烤的时间能缩短。",
    "想更清爽可以换成鸡胸肉末，油脂少一半。",
    "底部铺一层番茄酱再放甜椒，防粘也增加风味。"
  ],
  "common_mistakes": [
    "甜椒底部削破，烤的时候汁水全漏在盘里。",
    "馅料没调味就直接填，烤好后整体寡淡。",
    "不盖锡纸直接烤，甜椒外皮焦黑而内部还硬。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "火鸡肉末",
      "ratio": "250克:250克",
      "note": "更低脂，需多加一勺橄榄油。"
    },
    {
      "original": "米饭",
      "substitute": "藜麦",
      "ratio": "150克:130克",
      "note": "口感更松散，蛋白更高。"
    }
  ],
  "variations": [
    "馅料里加一勺孜然粉与辣椒粉，做成墨西哥风版本。",
    "用红黄两色甜椒混着做，摆盘更热闹。"
  ],
  "serving_suggestion": "一人一个再配一份沙拉，就是很完整的一餐。",
  "storage": "冷藏三天，冷冻一个月，复热盖锡纸烤十五分钟。",
