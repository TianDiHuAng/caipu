  "equipment": [
    "烤箱",
    "烤盘",
    "碗",
    "打蛋器",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到一百八十度，烤盘抹黄油。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "提前预热，布丁才均匀膨起。，火候要稳，别忽大忽小。",
      "visual_cue": "烤箱到位，烤盘油亮"
    },
    {
      "n": 2,
      "text": "玉米粒一半用刀略切碎，留一半整粒。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切一半留一半，口感才有层。，火候要稳，别忽大忽小。",
      "visual_cue": "玉米半碎，颗粒并存"
    },
    {
      "n": 3,
      "text": "鸡蛋打散，加牛奶和融化黄油搅匀。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油别太烫，免得蛋结块。，火候要稳，别忽大忽小。",
      "visual_cue": "蛋液顺滑，颜色淡黄"
    },
    {
      "n": 4,
      "text": "加白糖、盐和黑胡椒调味。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先调味，布丁底味才够。，火候要稳，别忽大忽小。",
      "visual_cue": "味道微甜带咸，这一点很关键。"
    },
    {
      "n": 5,
      "text": "筛入面粉和泡打粉，拌到无干粉。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到均匀就停，别搅出筋。，火候要稳，别忽大忽小。",
      "visual_cue": "面糊略稠，无干粉，这一点很关键。"
    },
    {
      "n": 6,
      "text": "倒入玉米粒拌匀，装进烤盘抹平。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "玉米沥干水，布丁才不稀。，火候要稳，别忽大忽小。",
      "visual_cue": "面糊平整，玉米分布匀"
    },
    {
      "n": 7,
      "text": "烤四十分钟，表面金黄、中心凝固。，火候要稳，别忽大忽小。",
      "time_min": 42,
      "heat": "无火",
      "tip": "牙签插入不带湿糊就熟。，火候要稳，别忽大忽小。",
      "visual_cue": "表面金黄，轻晃不流动"
    },
    {
      "n": 8,
      "text": "出炉静置十分钟再切块。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置定型，切块才整齐。，火候要稳，别忽大忽小。",
      "visual_cue": "切块成型，内部湿润"
    }
  ],
  "tips": [
    "玉米沥干水，布丁才不稀。，这一点很关键。",
    "面糊别过度搅，口感才嫩。，这一点很关键。",
    "烤到中心凝固，轻晃不流动。，这一点很关键。"
  ],
  "common_mistakes": [
    "玉米带水入模，烤出一汪水。，这一点很关键。",
    "烤过头，表面开裂发干。，这一点很关键。",
    "没静置就切，散成糊。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "玉米",
      "substitute": "南瓜",
      "ratio": "350 克:400 克",
      "note": "需先蒸熟压泥，甜味更足。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "200 毫升:150 毫升",
      "note": "需兑水五十毫升，质地更厚。"
    }
  ],
  "variations": [
    "加切达奶酪丝，咸香更足。，这一点很关键。",
    "加辣椒丁，做成微辣版。，这一点很关键。"
  ],
  "serving_suggestion": "切块配烤鸡或炖豆，趁热吃。，这一点很关键。",
  "storage": "冷藏三天，复烤五分钟。，这一点很关键。",
