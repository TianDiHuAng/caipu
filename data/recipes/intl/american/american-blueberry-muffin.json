  "equipment": [
    "大碗",
    "玛芬模具",
    "纸杯",
    "打蛋器",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热两百度，模具里垫好纸杯，动作轻一些即可。",
      "time_min": 5,
      "heat": "无火",
      "tip": "纸杯比抹油更好脱模。，别省略这一步。",
      "visual_cue": "纸杯贴壁，排列整齐"
    },
    {
      "n": 2,
      "text": "面粉、泡打粉、小苏打和盐混合过筛，动作轻一些即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛让膨发剂分布均匀。，别省略这一步。",
      "visual_cue": "粉质蓬松，无颗粒"
    },
    {
      "n": 3,
      "text": "鸡蛋加白糖搅到糖化开、颜色发浅，动作轻一些即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "不用打发，搅匀就够。，别省略这一步。",
      "visual_cue": "蛋液淡黄，糖粒消失"
    },
    {
      "n": 4,
      "text": "倒入融化黄油和牛奶搅匀，再加香草精，动作轻一些即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "黄油别太烫，否则蛋液会结块。，别省略这一步。",
      "visual_cue": "液体顺滑，微微油亮"
    },
    {
      "n": 5,
      "text": "把干粉倒进液体里，翻拌到刚看不见干粉，动作轻一些即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌十下就停，起筋会发硬。，别省略这一步。",
      "visual_cue": "面糊粗糙，略带小疙瘩"
    },
    {
      "n": 6,
      "text": "蓝莓裹一层薄面粉，轻轻拌进面糊，动作轻一些即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "裹粉能防止蓝莓全沉底。，别省略这一步。",
      "visual_cue": "果粒均匀，面糊紫点"
    },
    {
      "n": 7,
      "text": "面糊分装到纸杯，装八分满，动作轻一些即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "装太满会溢到杯沿外，烤盘上都是面糊。",
      "visual_cue": "杯口留白，糊面平整"
    },
    {
      "n": 8,
      "text": "两百度烤二十二分钟到表面金黄，动作轻一些即可。",
      "time_min": 23,
      "heat": "无火",
      "tip": "牙签插入中心不粘就熟了。，别省略这一步。",
      "visual_cue": "表面鼓起，边缘微裂"
    },
    {
      "n": 9,
      "text": "出炉后晾十分钟再脱模，趁温热食用风味最佳。",
      "time_min": 11,
      "heat": "无火",
      "tip": "趁热脱模容易散。，别省略这一步。",
      "visual_cue": "杯壁离模，表皮回弹"
    }
  ],
  "tips": [
    "面糊只拌到无干粉，多拌会发硬。",
    "蓝莓裹薄粉，烤时不会全沉底。，这是成败关键。",
    "八分满烘烤，玛芬才会圆鼓。，这是成败关键。"
  ],
  "common_mistakes": [
    "面糊反复搅拌，成品又硬又韧。，成品质地会明显变差。",
    "烤箱温度不够，玛芬塌成小饼。，成品质地会明显变差。",
    "蓝莓带水下锅，面糊变稀发紫。，成品质地会明显变差。"
  ],
  "substitutions": [
    {
      "original": "蓝莓",
      "substitute": "蔓越莓干",
      "ratio": "200 克:150 克",
      "note": "先泡软，甜度更高。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "110 克:90 毫升",
      "note": "更湿润，奶香略减。"
    }
  ],
  "variations": [
    "表面撒一层粗糖，烤出脆顶。，风味更丰富也更讨喜。",
    "加柠檬皮屑，香气更清。，风味更丰富也更讨喜。"
  ],
  "serving_suggestion": "温热配咖啡当早餐，或下午茶配红茶。",
  "storage": "密封常温两天，冷藏四天；复热一百六十度烤五分钟。",
