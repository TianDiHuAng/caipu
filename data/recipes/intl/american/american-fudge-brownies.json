  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "黑巧克力",
          "name_en": "dark chocolate",
          "amount": 150,
          "unit": "g",
          "note": "可可含量七成",
          "optional": false
        },
        {
          "name": "高筋面粉",
          "name_en": "bread flour",
          "amount": 110,
          "unit": "g",
          "note": "过筛",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 150,
          "unit": "g",
          "note": "切块",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 180,
          "unit": "g",
          "note": "分次加",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 3,
          "unit": "piece",
          "note": "常温",
          "optional": false
        },
        {
          "name": "可可粉",
          "name_en": "cocoa powder",
          "amount": 40,
          "unit": "g",
          "note": "无糖",
          "optional": false
        },
        {
          "name": "核桃",
          "name_en": "walnut",
          "amount": 60,
          "unit": "g",
          "note": "掰成小块",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "香草荚",
          "name_en": "vanilla pod",
          "amount": 1,
          "unit": "piece",
          "note": "取籽",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "方模",
    "隔水锅",
    "打蛋器",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑巧克力与黄油切块放碗里，隔五十度温水搅到完全融化。",
      "time_min": 8,
      "heat": "小火",
      "tip": "水温别太高，巧克力超过六十度会返砂出油。",
      "visual_cue": "混合液顺滑有光泽，碗壁没有颗粒"
    },
    {
      "n": 2,
      "text": "离火加白糖与盐，搅到糖粒基本化开，液体略微发亮。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖不用全化，留一点颗粒口感更有层次。",
      "visual_cue": "表面泛油光，摸起来仍略有颗粒"
    },
    {
      "n": 3,
      "text": "鸡蛋一个一个加入，每加一个都搅到完全融合再加下一个。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一次全倒会让面糊分离，出现油水两层的花斑。",
      "visual_cue": "面糊浓稠能拉出缎带，落下慢慢摊平"
    },
    {
      "n": 4,
      "text": "刮入香草荚里的籽，再筛入高筋面粉与可可粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻拌到看不见干粉就停，拌久会起筋变硬。",
      "visual_cue": "面糊深棕均匀，仍略显粗糙"
    },
    {
      "n": 5,
      "text": "倒入一半核桃碎拌匀，面糊装进铺纸的方模抹平。",
      "time_min": 4,
      "heat": "无火",
      "tip": "抹平时把模具在台面上震几下，气泡才跑得掉。",
      "visual_cue": "面糊厚薄一致，表面基本平整"
    },
    {
      "n": 6,
      "text": "剩下核桃撒在表面，烤箱一百八十度烤二十五分钟。",
      "time_min": 25,
      "heat": "中火",
      "tip": "中心微晃就出炉，烤到完全凝固口感就干了。",
      "visual_cue": "表面结成薄壳，中心轻推有弹性"
    },
    {
      "n": 7,
      "text": "连模放凉至少一小时，再切块，切口才利落不粘。",
      "time_min": 60,
      "heat": "无火",
      "tip": "热着切会糊成一团，冷却定型是切块的关键。",
      "visual_cue": "切面湿润细腻，边缘平整不塌"
    }
  ],
  "tips": [
    "冷藏一夜再切，中心更接近软糖的质地。",
    "想要更浓的巧克力味可以把可可粉换成等量黑巧克力。",
    "表面撒一小撮海盐，甜咸对比更明显。",
    "切刀用热水烫过擦干再切，切口干净利落。"
  ],
  "common_mistakes": [
    "鸡蛋一次全加，面糊油水分离烤出油亮的硬块。",
    "面粉拌过头起筋，成品像蛋糕不像布朗尼。",
    "烤到表面完全干硬才出炉，中心失去湿润感。"
  ],
  "substitutions": [
    {
      "original": "核桃",
      "substitute": "夏威夷果",
      "ratio": "60克:60克",
      "note": "口感更奶油，风味柔和。"
    },
    {
      "original": "黄油",
      "substitute": "椰子油",
      "ratio": "150克:130克",
      "note": "带椰香，质地略硬。"
    }
  ],
  "variations": [
    "面糊里拌入橙皮屑，做成巧克力橙味版本。",
    "表面铺一层奶油奶酪糊，做成大理石纹布朗尼。"
  ],
  "serving_suggestion": "切小块配一球香草冰淇淋，冷热交替的对比最经典。",
  "storage": "室温密封三天，冷藏一周，冷冻可存两个月。",
