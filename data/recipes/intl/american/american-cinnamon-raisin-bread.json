    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温牛奶加一勺白糖和干酵母，静置五分钟起泡。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "牛奶温热不烫手，酵母才活。，注意火候。",
      "visual_cue": "表面起泡，奶香散出，状态稳定"
    },
    {
      "n": 2,
      "text": "面粉加盐、剩余白糖、鸡蛋和酵母液揉成面团。这一步别着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "盐别直接碰酵母，影响发酵。，注意火候。",
      "visual_cue": "面团成形，无干粉，状态稳定"
    },
    {
      "n": 3,
      "text": "加软化黄油继续揉到表面光滑、能拉出薄膜的状态。",
      "time_min": 10,
      "heat": "无火",
      "tip": "揉到能拉薄膜，组织才松软。，注意火候。",
      "visual_cue": "面团光滑，有延展性，状态稳定"
    },
    {
      "n": 4,
      "text": "盖保鲜膜放温暖处发酵，直到体积膨胀到两倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "温度低就放温暖处，别用热水催。，注意火候。",
      "visual_cue": "体积翻倍，按压回弹，状态稳定"
    },
    {
      "n": 5,
      "text": "取出擀成长方形薄片，刷一层融化黄油。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "边缘留空，卷起来才不漏。，注意火候。",
      "visual_cue": "薄片均匀，油层透明，状态稳定"
    },
    {
      "n": 6,
      "text": "撒上肉桂粉和白糖，再铺一层葡萄干。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "肉桂和糖先拌匀，撒得才匀。，注意火候。",
      "visual_cue": "馅料平铺，色带整齐，状态稳定"
    },
    {
      "n": 7,
      "text": "从短边卷紧，收口捏实放进长方形长方形模具具。",
      "time_min": 7,
      "heat": "无火",
      "tip": "卷紧不留空隙，切面才漂亮。，注意火候。",
      "visual_cue": "卷筒紧实，长度贴合，状态稳定"
    },
    {
      "n": 8,
      "text": "二次发酵四十分钟，直到面团涨到模具八分满。",
      "time_min": 42,
      "heat": "无火",
      "tip": "发到模口下方就够，太满会溢出。，注意火候。",
      "visual_cue": "面团膨胀，接近模口，状态稳定"
    },
    {
      "n": 9,
      "text": "一百八十度烤三十五分钟，出炉立刻脱模。这一步别着急。",
      "time_min": 37,
      "heat": "无火",
      "tip": "中途看上色，太深盖锡纸。，注意火候。",
      "visual_cue": "表面金褐，敲底有空响"
    }
  ],
  "tips": [
    "牛奶温热不烫手，酵母才发得起来。，值得留意。",
    "面团揉出膜，切片才不碎。，值得留意。",
    "出炉立刻脱模，不然底部会回潮。，值得留意。"
  ],
  "common_mistakes": [
    "肉桂撒太厚，味道发苦。，值得留意。",
    "卷得不紧，烤好中间有空洞。，值得留意。",
    "发酵过头，进烤箱就塌。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "葡萄干",
      "substitute": "蔓越莓干",
      "ratio": "100 克:100 克",
      "note": "更酸，糖可略加。"
    },
    {
      "original": "牛奶",
      "substitute": "清水加奶粉",
      "ratio": "230 毫升:220 毫升加20 克",
      "note": "奶香稍弱，口感仍软。"
    }
  ],
  "variations": [
    "表面刷蛋液撒杏仁片，更香脆。，值得留意。",
    "切片后煎一下，抹黄油最好吃。，值得留意。"
  ],
  "serving_suggestion": "切片烤脆，抹黄油配咖啡。，效果更稳定。",
  "storage": "密封常温两天，冷冻两周；复热一百七十度烤五分钟。",
