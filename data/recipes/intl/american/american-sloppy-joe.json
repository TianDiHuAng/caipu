  "steps": [
    {
      "n": 1,
      "text": "炒锅倒植物油，洋葱丁小火炒到透明。这一步别着急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒透才甜，别急着下肉。，注意火候。",
      "visual_cue": "洋葱透明，边缘微黄，状态稳定"
    },
    {
      "n": 2,
      "text": "下牛肉末转中火，用铲子压散炒到变色。这一步别着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "压散成小粒，别结成大团。，注意火候。",
      "visual_cue": "肉末松散，颜色转褐，状态稳定"
    },
    {
      "n": 3,
      "text": "加青椒丁翻炒两分钟，炒出清香味。这一步别着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "青椒断生就好，太软不好吃。，注意火候。",
      "visual_cue": "青椒变深绿，仍有脆感"
    },
    {
      "n": 4,
      "text": "倒番茄丁和番茄酱，翻炒到出红色油。这一步别着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出汁，酱才浓。，注意火候。",
      "visual_cue": "锅底泛红，汁水明显，状态稳定"
    },
    {
      "n": 5,
      "text": "加生抽、白糖、白醋、盐和黑胡椒炒匀。这一步别着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "糖和醋平衡酸味，尝了再调。，注意火候。",
      "visual_cue": "酱色红亮，酸甜平衡，状态稳定"
    },
    {
      "n": 6,
      "text": "倒清水小火焖八分钟，让味道融在一起。这一步别着急。",
      "time_min": 9,
      "heat": "小火",
      "tip": "焖到汁水收一半，才不流汤。，注意火候。",
      "visual_cue": "汁水浓稠，肉末挂酱，状态稳定"
    },
    {
      "n": 7,
      "text": "汉堡胚从侧面切开，入烤箱烤三分钟。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "烤一下更脆，也不易被汁泡软。，注意火候。",
      "visual_cue": "切面微黄，边缘干脆，状态稳定"
    },
    {
      "n": 8,
      "text": "肉酱舀进面包，合起来趁热吃。这一步别着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "装七分满，咬的时候才不流。，注意火候。",
      "visual_cue": "酱汁饱满，面包不塌，状态稳定"
    }
  ],
  "tips": [
    "牛肉末要压散，颗粒分明才好吃。，值得留意。",
    "番茄酱炒出红油，酱才够浓。，值得留意。",
    "面包先烤过，才不被汁泡烂。，值得留意。"
  ],
  "common_mistakes": [
    "肉末结块，口感像大肉丸。，值得留意。",
    "汁水没收，面包一下就湿透。，值得留意。",
    "番茄酱没炒，吃着有生酱味。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "鸡腿肉末",
      "ratio": "450 克:450 克",
      "note": "更清爽，焖的时间缩短两分钟。"
    },
    {
      "original": "汉堡胚",
      "substitute": "吐司",
      "ratio": "3 个:6 片",
      "note": "夹起来更方便，汁要收得再干些。"
    }
  ],
  "variations": [
    "加一勺辣椒酱，做出辣味版。，值得留意。",
    "配一层奶酪片，热着吃会拉丝。，值得留意。"
  ],
  "serving_suggestion": "配薯条和凉拌卷心菜，就是美式家庭晚餐。，效果更稳定。",
  "storage": "冷藏两天，复热下锅加少量水炒热。，效果更稳定。",
