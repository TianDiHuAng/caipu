        }
      ]
    }
  ],
  "equipment": [
    "方模",
    "擦丝器",
    "打蛋器",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "柠檬用盐搓洗表皮，擦下黄色皮屑，再挤出足量的柠檬汁备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "只擦表皮黄色部分，白色筋膜会带出苦味。",
      "visual_cue": "皮屑颜色鲜黄，汁液过滤后清亮"
    },
    {
      "n": 2,
      "text": "高筋面粉加黄油块，用手搓成粗砂状，再加一半白糖与盐拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油保持冷藏状态，搓出的颗粒才分明。",
      "visual_cue": "粉油混合物像粗砂，没有大块黄油"
    },
    {
      "n": 3,
      "text": "倒进铺纸的方模压平压实，一百八十度烤二十分钟到浅金。",
      "time_min": 20,
      "heat": "中火",
      "tip": "压得紧一些，切的时候饼底才不会散。",
      "visual_cue": "饼底表面浅金结壳，摸上去发硬"
    },
    {
      "n": 4,
      "text": "鸡蛋打散加剩余白糖、柠檬汁、皮屑与玉米淀粉，搅到无颗粒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "不要打进太多空气，否则表面会浮一层泡沫。",
      "visual_cue": "液体顺滑淡黄，静置后几乎没有气泡"
    },
    {
      "n": 5,
      "text": "把柠檬液过滤到温热的饼底上，轻晃模具让表面流平。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过滤掉气泡与果肉渣，切出来的断面才干净。",
      "visual_cue": "液面平整，饼底与液体界线清晰"
    },
    {
      "n": 6,
      "text": "一百六十度再烤二十五分钟，直到中心基本凝固不晃。",
      "time_min": 25,
      "heat": "中火",
      "tip": "轻晃时中心只微微抖动，这就是刚好的状态。",
      "visual_cue": "表面失去反光，中心的晃动幅度很小"
    },
    {
      "n": 7,
      "text": "彻底放凉后冷藏一小时，切块并筛糖粉在表面。",
      "time_min": 60,
      "heat": "无火",
      "tip": "彻底冷透再切，边缘才不会粘黏出花边。",
      "visual_cue": "切块边缘整齐，表面糖粉均匀"
    }
  ],
  "tips": [
    "冷藏一夜后口感更紧实，酸甜也更平衡。",
    "柠檬汁和皮屑都要用，光有汁香气不够。",
    "表面糖粉吃前才筛，放久会化进馅里。",
    "加一勺柠檬皮屑在饼底里，底味更有层次。"
  ],
  "common_mistakes": [
    "馅料没过滤直接倒，表面浮满泡沫与果肉渣。",
    "没放凉就切块，馅料流出粘得满手都是。",
    "烤到表面完全干裂，馅料失去柔软的口感。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "120克:110克",
      "note": "酸味更冲，颜色偏浅。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "低筋面粉",
      "ratio": "15克:20克",
      "note": "凝固力稍弱，需多烤五分钟。"
    }
  ],
  "variations": [
    "馅料里加一勺柠檬酒，香气层次更成熟。",
    "表面换成奶油奶酪霜，做成更浓郁的版本。"
  ],
  "serving_suggestion": "切成小方块整齐装盘，配红茶或咖啡都很合适。",
  "storage": "冷藏三天，冷冻一个月，食用前回温十分钟。",
