  "equipment": [
    "烤箱",
    "烤盘",
    "夹子",
    "刀",
    "砧板",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊排用厨房纸吸干表面水分，剔除多余的厚油膜，骨头末端包一小段锡纸。",
      "time_min": 10,
      "heat": "无火",
      "tip": "油膜留一层就够，太厚会滴油起火冒黑烟",
      "visual_cue": "骨头末端包紧锡纸，肉面平整"
    },
    {
      "n": 2,
      "text": "蒜末、迷迭香、橄榄油、盐与黑胡椒拌成腌料，均匀抹在羊排两面并按摩两分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "用手按摩能让香草味渗进纤维，只抹表面味道浮",
      "visual_cue": "肉表面裹满油亮厚实的腌料层"
    },
    {
      "n": 3,
      "text": "羊排盖好放冰箱腌制四十分钟，取出后回温十五分钟再进烤箱。",
      "time_min": 55,
      "heat": "无火",
      "tip": "冷藏的肉直接烤外面焦了里面还是凉的",
      "visual_cue": "肉面回软，按下去不再冰手"
    },
    {
      "n": 4,
      "text": "烤箱预热到二百一十度，羊排摆在烤架上中层烤十分钟。",
      "time_min": 12,
      "heat": "大火",
      "tip": "烤架比烤盘好，底面不泡在油里才会两面焦",
      "visual_cue": "表面转褐，边缘微微焦"
    },
    {
      "n": 5,
      "text": "取出刷一层蜂蜜，翻面再烤六分钟，让表面挂上一层亮壳。",
      "time_min": 7,
      "heat": "中火",
      "tip": "蜂蜜要在后半程刷，早刷会先焦黑再发苦",
      "visual_cue": "表面泛出琥珀色光泽，油光流动"
    },
    {
      "n": 6,
      "text": "出炉静置六分钟，沿骨缝切开，挤上柠檬汁配蒜末上桌。",
      "time_min": 8,
      "heat": "无火",
      "tip": "静置让肉汁回收，切的时候才不会流一盘",
      "visual_cue": "切面呈粉红，汁水清澈"
    }
  ],
  "tips": [
    "羊排挑厚薄一致的，薄的那头容易烤过头发柴。",
    "腌料里的蒜末留一小勺生的，出锅撒上更冲鼻。",
    "烤箱温度别降，高温快烤才外焦里嫩。",
    "剩的骨头别扔，加水与洋葱煮二十分钟就是一锅好汤底。"
  ],
  "common_mistakes": [
    "没回温就直接烤，外面焦黑里面还带血水。",
    "蜂蜜一开始就刷满，进烤箱五分钟就发黑带苦味。",
    "烤完立刻切，肉汁全流在盘子里，肉也发干。",
    "烤箱温度太低慢慢烘，羊排烤成灰褐色，一点焦香都没有。"
  ],
  "substitutions": [
    {
      "original": "羊排",
      "substitute": "羊肩排",
      "ratio": "900 克:900 克",
      "note": "肉更厚，烤制时间加四分钟。"
    },
    {
      "original": "迷迭香",
      "substitute": "百里香",
      "ratio": "5 克:5 克",
      "note": "香气更清雅，接受度更高。"
    }
  ],
  "variations": [
    "腌料里加一勺第戎芥末，酸香解腻，配烤蔬菜很搭。",
    "改用炭火烤架，明火烤出烟熏味，收尾刷同样的蜂蜜。"
  ],
  "serving_suggestion": "四人份主菜，配烤芦笋与黄油土豆，柠檬角摆在盘边随吃随挤。",
  "storage": "冷藏两天内吃完，带骨密封保存；复热用烤箱一百八十度烤五分钟，不要用微波炉久转。",
