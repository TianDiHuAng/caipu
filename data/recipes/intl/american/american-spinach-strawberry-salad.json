  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "菠菜",
          "name_en": "spinach",
          "amount": 300,
          "unit": "g",
          "note": "选嫩叶洗净",
          "optional": false
        },
        {
          "name": "草莓",
          "name_en": "strawberry",
          "amount": 300,
          "unit": "g",
          "note": "去蒂切片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "杏仁",
          "name_en": "almond",
          "amount": 60,
          "unit": "g",
          "note": "烤香后粗切",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 40,
          "unit": "g",
          "note": "切极薄的丝",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 45,
          "unit": "ml",
          "note": "拌汁",
          "optional": false
        },
        {
          "name": "苹果醋",
          "name_en": "apple cider vinegar",
          "amount": 20,
          "unit": "ml",
          "note": "提酸",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 20,
          "unit": "g",
          "note": "平衡酸味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "沙拉盆",
    "小碗",
    "打蛋器",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜摘去老梗，用清水冲洗三遍后彻底沥干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "叶片上残留的水会稀释酱汁，一定要甩干。",
      "visual_cue": "叶面干爽，盆底没有一滴积水"
    },
    {
      "n": 2,
      "text": "草莓用流动水冲洗干净，去蒂后切成半厘米厚的片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切之前再冲洗，泡水久了草莓会发软出水。",
      "visual_cue": "切面鲜红多汁，果肉完整不烂"
    },
    {
      "n": 3,
      "text": "杏仁放进干锅小火烘三分钟，闻到香味后取出粗切。",
      "time_min": 5,
      "heat": "小火",
      "tip": "烤过的坚果香气完全不同，千万别省略这步。",
      "visual_cue": "杏仁颜色加深，掰开断面微黄"
    },
    {
      "n": 4,
      "text": "橄榄油、苹果醋、蜂蜜、盐与黑胡椒倒进小碗打匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打到酱汁变浑发稠，油和醋才算融在一起。",
      "visual_cue": "酱汁呈浅金色，静置后不分层"
    },
    {
      "n": 5,
      "text": "菠菜放进大盆，淋一半酱汁轻轻翻拌到每片叶子都裹上。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先拌叶子，叶面有油才不会一见果酸就塌。",
      "visual_cue": "叶片油亮挺立，不带多余汁水"
    },
    {
      "n": 6,
      "text": "铺上草莓片与洋葱丝，淋剩下的酱汁再翻拌两下。",
      "time_min": 3,
      "heat": "无火",
      "tip": "草莓轻轻拌开就好，用力会被压出汁水。",
      "visual_cue": "红色果片分布均匀，菜叶未软塌"
    },
    {
      "n": 7,
      "text": "最后撒上烤香的杏仁碎，立刻端上桌趁新鲜开吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "坚果一定要最后撒，才能保持干脆的口感。",
      "visual_cue": "表面坚果散布，颜色红绿对比鲜明"
    }
  ],
  "tips": [
    "用嫩菠菜叶，老叶带涩味不适合生吃。",
    "加一点羊奶酪碎，咸香与果酸更搭。",
    "草莓换成橙子瓣也很好吃，酸度更柔和。",
    "用冰镇过的盘子盛沙拉，吃起来更清爽。"
  ],
  "common_mistakes": [
    "菠菜洗完不甩干，拌好后五分钟就出水。",
    "酱汁一次全倒，菜叶被酸味泡得发苦发软。",
    "草莓提前切好放着，出水后颜色会发暗。"
  ],
  "substitutions": [
    {
      "original": "菠菜",
      "substitute": "生菜",
      "ratio": "300克:300克",
      "note": "涩味更少，口感更脆。"
    },
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "60克:60克",
      "note": "香气更重，烘烤时间少一分钟。"
    }
  ],
  "variations": [
    "加几片烤鸡胸肉，就变成一份主餐沙拉。",
    "撒一点炒香的黑芝麻，颜色和香气都更丰富。"
  ],
  "serving_suggestion": "现拌现吃，配烤面包或作为烤肉的前菜都很合适。",
  "storage": "拌好后要尽快吃完，冷藏存放不超过六小时。",
