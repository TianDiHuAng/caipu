  "equipment": [
    "厚底炖锅",
    "锅盖",
    "厨房夹",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩提前半小时从冰箱取出回温，用厨房纸把表面血水彻底吸干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表面干燥才能煎出漂亮焦壳，湿肉只会出水发灰。",
      "visual_cue": "肉块表面干燥、纸上几乎没有血水"
    },
    {
      "n": 2,
      "text": "牛腩六面都抹上盐和黑胡椒，再薄薄裹一层面粉拍掉多余粉粒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面粉要薄，太厚会在锅里糊成硬壳。",
      "visual_cue": "肉块均匀挂薄白粉、不见干粉堆积"
    },
    {
      "n": 3,
      "text": "厚底锅放植物油烧到微微冒烟，牛腩下锅每面煎三四分钟至深棕。",
      "time_min": 12,
      "heat": "中大火",
      "tip": "一面煎定型再翻动，频繁翻面会撕破焦壳。",
      "visual_cue": "六面焦棕、锅底留一层褐色锅巴"
    },
    {
      "n": 4,
      "text": "把牛腩夹出，原锅下洋葱丝炒到变软上色，再放蒜和香叶炒香。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱要把焦香炒出来，这层味道是汤底的骨架。",
      "visual_cue": "洋葱塌软发黄、锅底焦痕被刮起"
    },
    {
      "n": 5,
      "text": "倒入红酒煮开刮净锅底，放回牛腩与百里香，加清水到没过三分之二。",
      "time_min": 8,
      "heat": "中火",
      "tip": "红酒沸腾收掉一半酒精味再加水，成品才不酸。",
      "visual_cue": "汤汁没过肉块大半、表面浮沫撇净"
    },
    {
      "n": 6,
      "text": "加盖小火焖一小时后加入土豆和胡萝卜，继续焖四十分钟。",
      "time_min": 100,
      "heat": "小火",
      "tip": "根茎类后放，否则炖到最后全化成泥。",
      "visual_cue": "筷子能轻松插进牛腩、土豆边缘发圆"
    },
    {
      "n": 7,
      "text": "尝味补盐，把肉取出切片，蔬菜与汤一起盛出淋在肉上。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切片逆着纹理下刀，入口才不塞牙。",
      "visual_cue": "肉片纹理清晰、断面湿润不干"
    }
  ],
  "tips": [
    "焖煮时汤汁保持虾眼泡状态，火太大肉会柴硬。",
    "想汤汁更浓，可把部分土豆压碎搅入汤中代替勾芡。",
    "用铸铁锅焖受热更均匀，普通锅应在锅底垫一层洋葱防粘。"
  ],
  "common_mistakes": [
    "牛腩没吸干就下锅，煎不出焦壳还溅一地油。",
    "水一次加得太满，沸腾后溢出来扑灭炉火。",
    "土豆和牛腩同时下锅，等肉炖软时土豆早已散成糊。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛腱",
      "ratio": "1000g 对 1000g",
      "note": "牛腱筋膜多，焖煮时间延长二十分钟。"
    },
    {
      "original": "红酒",
      "substitute": "白酒",
      "ratio": "200ml 对 160ml",
      "note": "酸度更高，糖可多加五克平衡。"
    }
  ],
  "variations": [
    "加入番茄膏与迷迭香，做成更浓郁的地中海风焖牛肉。",
    "最后半小时放入整颗小洋葱与口蘑，配菜层次更丰富。"
  ],
  "serving_suggestion": "切片装深盘，浇上汤汁，配土豆泥或硬壳面包蘸汁。",
  "storage": "冷藏三天，隔夜更入味；复热时小火加少量清水防止糊底。",
