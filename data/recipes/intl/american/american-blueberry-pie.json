    "擀面杖",
    "大碗",
    "烤箱",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和黄油丁搓成粗屑，加冰镇的清水捏成团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "揉到成团就停，别起筋。，注意火候。",
      "visual_cue": "粉油成砂，能捏成团，状态稳定"
    },
    {
      "n": 2,
      "text": "面团分两份，压扁后冷藏三十分钟。这一步别着急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冷藏后擀开才不回缩。，注意火候。",
      "visual_cue": "面团硬实，边缘圆整，状态稳定"
    },
    {
      "n": 3,
      "text": "蓝莓洗净沥干，挑掉破损的果子。这一步别着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "带水下锅会出太多汁。，注意火候。",
      "visual_cue": "果粒干爽，无泥沙，状态稳定"
    },
    {
      "n": 4,
      "text": "蓝莓拌白糖、玉米淀粉和柠檬汁。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "淀粉裹住果肉，汁才不会流。，注意火候。",
      "visual_cue": "果粒挂粉，微微出汁，状态稳定"
    },
    {
      "n": 5,
      "text": "取一份面团擀成圆片，铺进派盘压实。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "边缘留一厘米，压边才好看。，注意火候。",
      "visual_cue": "派底贴合，无气泡，状态稳定"
    },
    {
      "n": 6,
      "text": "把拌好的蓝莓馅倒进派盘里，用勺子抹平表面。",
      "time_min": 3,
      "heat": "无火",
      "tip": "堆成中间略高的小丘。，注意火候。",
      "visual_cue": "馅面平整，果粒密实，状态稳定"
    },
    {
      "n": 7,
      "text": "另一份擀开盖住，边缘捏紧后卷边压花。这一步别着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "捏紧边缘，汁才不会从缝里跑。，注意火候。",
      "visual_cue": "边缘密封，花纹齐整，状态稳定"
    },
    {
      "n": 8,
      "text": "表面划三刀排气，刷一层蛋黄液。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "划口让蒸汽出去，派皮才不鼓。，注意火候。",
      "visual_cue": "表层油亮，刀口清晰，状态稳定"
    },
    {
      "n": 9,
      "text": "烤箱两百度烤二十分钟，转一百八十度再烤二十五分。",
      "time_min": 47,
      "heat": "无火",
      "tip": "先高温定型，后低温烤透。，注意火候。",
      "visual_cue": "派皮金黄，馅汁冒泡，状态稳定"
    }
  ],
  "tips": [
    "黄油保持冰冷，派皮才够酥。，值得留意。",
    "玉米淀粉别省，不然切开流一盘子。，值得留意。",
    "烤到馅汁冒泡才算熟透。，值得留意。"
  ],
  "common_mistakes": [
    "派皮揉过头，烤出来硬邦邦。，值得留意。",
    "淀粉太少，切开全是汁水。，值得留意。",
    "没划口，派皮鼓成半球。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "蓝莓",
      "substitute": "混合莓果",
      "ratio": "500 克:500 克",
      "note": "酸度更高，糖可加到 130 克。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "木薯淀粉",
      "ratio": "25 克:25 克",
      "note": "增稠更透亮。"
    }
  ],
  "variations": [
    "表面编成网格派皮，更好看。，值得留意。",
    "加一点肉桂粉，香气更暖。，值得留意。"
  ],
  "serving_suggestion": "晾到微温切块，配一球香草冰淇淋。，效果更稳定。",
  "storage": "冷藏三天，冷冻两周；复热一百六十度烤十分钟。",
