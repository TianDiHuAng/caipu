  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和冷藏黄油丁搓成粗屑，加冰水捏成团。这一步别着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，派皮才酥。，注意火候。",
      "visual_cue": "粉油成粗砂，能捏成团"
    },
    {
      "n": 2,
      "text": "面团包保鲜膜冷藏三十分钟。这一步别着急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冷藏让面筋松弛，擀开不回缩。，注意火候。",
      "visual_cue": "面团硬实，按压不留痕"
    },
    {
      "n": 3,
      "text": "鸡腿肉切丁，用盐和黑胡椒抓匀。这一步别着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切两厘米见方，熟得均匀。，注意火候。",
      "visual_cue": "肉丁匀整，表面挂盐，状态稳定"
    },
    {
      "n": 4,
      "text": "平底锅倒植物油，鸡丁中火煎到表面变白。这一步别着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煎到变色就好，后面还要煮。，注意火候。",
      "visual_cue": "肉丁发白，边缘微黄，状态稳定"
    },
    {
      "n": 5,
      "text": "下洋葱、胡萝卜和土豆丁炒三分钟。这一步别着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蔬菜先炒，甜味才出来。，注意火候。",
      "visual_cue": "洋葱透明，胡萝卜油亮"
    },
    {
      "n": 6,
      "text": "撒面粉炒匀，慢慢倒牛奶和清水搅成白汁。这一步别着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "边倒边搅，汁才不结块。，注意火候。",
      "visual_cue": "汁液浓稠，无干粉，状态稳定"
    },
    {
      "n": 7,
      "text": "加盐和黑胡椒调味，放青豆煮两分钟收稠。这一步别着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "青豆最后放，颜色才绿。，注意火候。",
      "visual_cue": "馅料浓稠，能挂勺，状态稳定"
    },
    {
      "n": 8,
      "text": "馅料倒进派盘，擀开派皮盖住盘口并压边。这一步别着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "压边封紧，汁才不会溢。，注意火候。",
      "visual_cue": "派皮覆盖完整，边缘压实"
    },
    {
      "n": 9,
      "text": "表面斜划两道口子排气，再刷上一层蛋黄液。",
      "time_min": 3,
      "heat": "无火",
      "tip": "划口排气，烤时皮才不会鼓破。，注意火候。",
      "visual_cue": "表面油亮，刀口整齐，状态稳定"
    },
    {
      "n": 10,
      "text": "烤箱两百度烤三十五分钟到派皮金黄。这一步别着急。",
      "time_min": 37,
      "heat": "无火",
      "tip": "中途看上色，太深盖锡纸。，注意火候。",
      "visual_cue": "派皮金黄，边缘冒泡，状态稳定"
    }
  ],
  "tips": [
    "派皮的黄油要冷，起酥才明显。，值得留意。",
    "白汁边倒边搅，才不会有疙瘩。，值得留意。",
    "派皮划口排气，烤时不开裂。，值得留意。"
  ],
  "common_mistakes": [
    "黄油化软了再搓，派皮硬如饼干。，值得留意。",
    "馅太稀，切开流出汤。，值得留意。",
    "没划口，派皮鼓成大包。，值得留意。"
  ],
  "substitutions": [
