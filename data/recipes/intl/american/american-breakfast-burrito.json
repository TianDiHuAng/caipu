  "equipment": [
    "平底锅",
    "锡纸",
    "打蛋盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆削皮切成一厘米见方的小丁，放滚水里煮三分钟，捞出沥干水分。",
      "time_min": 7,
      "heat": "大火",
      "tip": "先煮再煎，里面才软外面才脆，这一步千万别省。",
      "visual_cue": "土豆丁半透明，边缘发软，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "平底锅放十五毫升植物油中火加热，倒入土豆丁煎六分钟，煎到四面金黄盛出。",
      "time_min": 8,
      "heat": "中火",
      "tip": "铺平别堆叠，让每面都接触到锅底，火候和顺序都要留神。",
      "visual_cue": "土豆丁金黄，外皮起脆，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "培根片下锅小火煎四分钟至出油焦脆，捞出用厨房纸吸去多余油脂。",
      "time_min": 5,
      "heat": "小火",
      "tip": "煎出的油留着，正好炒蛋，提前把配料备好再动手更稳。",
      "visual_cue": "培根卷边，颜色红褐，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "鸡蛋打散加盐和黑胡椒，倒入留有培根油的锅中，小火用铲子慢慢推炒两分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "小火慢推，蛋块才嫩滑不干，这一步千万别省。",
      "visual_cue": "蛋液半凝，仍有光泽，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "玉米饼放干锅里两面各烘十秒至回软，铺上奶酪丝让它微微融化。",
      "time_min": 4,
      "heat": "小火",
      "tip": "烘过的饼才柔韧，卷起来不裂，火候和顺序都要留神。",
      "visual_cue": "饼面柔软，奶酪微软，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "依次放上土豆丁、培根和炒蛋，撒小葱，从一边卷紧成筒，对半切开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "卷的时候先折两边再卷，馅料不漏，提前把配料备好再动手更稳。",
      "visual_cue": "卷紧成筒，切面整齐，颜色和形态变化明显"
    },
    {
      "n": 7,
      "text": "可再用锡纸包住下半段方便手持，配辣椒酱一起上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "锡纸包住能保温，也防酱汁滴落，这一步千万别省。",
      "visual_cue": "锡纸包紧，卷饼挺立，气味的浓淡也说明进度"
    }
  ],
  "tips": [
    "土豆丁先煮三分钟再煎，外脆内软，比直接煎省一半时间。",
    "鸡蛋要用小火慢推，炒到刚凝固就离火，余温会继续加热。",
    "玉米饼在干锅里烘十秒再卷，回软后不易裂开。"
  ],
  "common_mistakes": [
    "鸡蛋大火猛炒，水分瞬间跑光，炒出来干硬成颗粒。",
    "玉米饼冷着直接卷，一折就裂，馅料全漏在盘子里。",
    "土豆丁切得太大，外面焦了里面还是生的，咬着发脆。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "70克:70克",
      "note": "咸度更低，盐可多加一克。"
    },
    {
      "original": "玉米饼",
      "substitute": "面粉薄饼",
      "ratio": "150克:150克",
      "note": "更柔软，烘的时间可略长。"
    }
  ],
  "variations": [
    "加一勺炒过的黑豆和辣酱，做成墨西哥风味的早餐卷。",
    "把培根换成切碎的香肠，配一杯冰咖啡就是美式路边早餐。"
  ],
  "serving_suggestion": "对半切开，露出金黄的蛋和土豆，配辣椒酱和一杯热咖啡。",
  "storage": "冷藏可放一天，回热用平底锅干煎两分钟，微波前用湿纸巾盖住防干。",
