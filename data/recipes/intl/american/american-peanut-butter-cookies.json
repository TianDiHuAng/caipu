      "items": [
        {
          "name": "花生酱",
          "name_en": "peanut butter",
          "amount": 240,
          "unit": "g",
          "note": "颗粒型更香",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 50,
          "unit": "g",
          "note": "约一个",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 150,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 90,
          "unit": "g",
          "note": "细砂糖",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 60,
          "unit": "g",
          "note": "增加湿润度",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 100,
          "unit": "g",
          "note": "室温软化",
          "optional": false
        },
        {
          "name": "泡打粉",
          "name_en": "baking powder",
          "amount": 4,
          "unit": "g",
          "note": "膨发",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "搅拌盆",
    "烤盘",
    "叉子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油提前从冰箱取出，切成小块在室温下软化半小时。",
      "time_min": 30,
      "heat": "无火",
      "tip": "手指能轻松压出坑就够了，化成液体就不行。",
      "visual_cue": "黄油柔软可压，颜色浅黄不发亮"
    },
    {
      "n": 2,
      "text": "软化的黄油加白糖与红糖，用打蛋器打到颜色变浅蓬松。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到体积明显变大，曲奇才会有酥松的口感。",
      "visual_cue": "黄油霜颜色发白，表面有明显纹路"
    },
    {
      "n": 3,
      "text": "分两次加入蛋液，每次都搅到完全吸收再加下一次。",
      "time_min": 4,
      "heat": "无火",
      "tip": "一次加完容易油水分离，面糊会变得粗糙。",
      "visual_cue": "糊体细腻有光，不见流动的蛋液"
    },
    {
      "n": 4,
      "text": "加入花生酱搅匀，再筛入面粉、泡打粉与盐翻拌成团。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌到没有干粉就停手，多拌会让曲奇发硬。",
      "visual_cue": "面团能捏成团，不粘手也不掉渣"
    },
    {
      "n": 5,
      "text": "面团分成二十个小球，摆在铺纸的烤盘上留出间距。",
      "time_min": 8,
      "heat": "无火",
      "tip": "每个小球大小尽量一致，烤的时候才能同时成熟。",
      "visual_cue": "小球圆润均匀，彼此间隔三厘米"
    },
    {
      "n": 6,
      "text": "用叉子在每个球上压出交叉的十字花纹，压到半扁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "压出纹路不只是好看，还能让中间更易烤透。",
      "visual_cue": "表面留下整齐的十字形压痕"
    },
    {
      "n": 7,
      "text": "烤箱一百八十度烤十二分钟，边缘上色即取出晾凉。",
      "time_min": 14,
      "heat": "无火",
      "tip": "出炉时中间偏软是正常的，晾凉后才会定形。",
      "visual_cue": "边缘金黄，中心仍然是浅色微鼓"
    }
  ],
  "tips": [
    "一定要晾凉再挪动，热的时候一碰就散。",
    "加一把巧克力豆进去，口感会更丰富。",
    "面团冷藏半小时再烤，形状更圆更挺。",
    "配一杯冷牛奶就是最经典的美式吃法。"
  ],
  "common_mistakes": [
    "黄油化成液体后才打发，曲奇会摊成薄片。",
    "烤到通体变深才出炉，放凉后硬得咬不动。",
    "面团没冷藏直接烤，饼干全部摊连在一起。"
  ],
  "substitutions": [
    {
      "original": "花生酱",
      "substitute": "杏仁酱",
      "ratio": "240克:240克",
      "note": "香气不同，甜度略低。"
    },
    {
      "original": "红糖",
      "substitute": "白糖",
      "ratio": "60克:60克",
      "note": "口感更脆，少了焦糖香。"
    }
  ],
  "variations": [
    "表面撒几粒粗盐，甜咸层次会更明显。",
    "面团里拌入燕麦片，吃起来更有嚼头。"
  ],
  "serving_suggestion": "配一杯冷牛奶或咖啡，当作下午茶点心都很合适。",
  "storage": "密封常温放五天，冷冻面团可存一个月随烤随取。",
