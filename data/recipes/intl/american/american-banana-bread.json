        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 60,
          "unit": "ml",
          "note": "调节稠度",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "打蛋器",
    "大碗",
    "面包模具",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "熟透的香蕉剥皮放进大碗，用叉子压成带小颗粒的果泥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香蕉皮发黑最甜，压的时候留点颗粒口感更好。",
      "visual_cue": "果泥黏稠，带褐色斑点"
    },
    {
      "n": 2,
      "text": "黄油隔水融化成液体，稍微放凉到不烫手的温度。",
      "time_min": 6,
      "heat": "小火",
      "tip": "太烫的黄油会把蛋液烫成蛋花。，注意火候。",
      "visual_cue": "黄油清澈，温热不烫，状态稳定"
    },
    {
      "n": 3,
      "text": "香蕉泥里加白糖、鸡蛋和融化黄油，用打蛋器搅到乳化均匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅到看不见浮油，烤出来组织才细腻。",
      "visual_cue": "面糊顺滑，颜色浅褐，状态稳定"
    },
    {
      "n": 4,
      "text": "面粉、小苏打和盐混合过筛，倒进湿料里翻拌到无干粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌到刚无干粉就停，过度搅拌会又硬又韧。",
      "visual_cue": "面糊浓稠，无干粉块，状态稳定"
    },
    {
      "n": 5,
      "text": "视稠度加牛奶调到能缓慢流动，倒进铺了油纸的模具里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面糊能缓慢流动就够，太稀烤完会塌。",
      "visual_cue": "面糊流过刮刀，缓慢，状态稳定"
    },
    {
      "n": 6,
      "text": "烤箱预热到一百八十度，中层烤五十分钟到表面深金黄。",
      "time_min": 50,
      "heat": "-",
      "tip": "插入竹签不带湿面糊就熟，带湿的再烤十分钟。",
      "visual_cue": "表面开裂，色泽深金，状态稳定"
    },
    {
      "n": 7,
      "text": "出炉连模具放十分钟，再脱模放架上晾到温热切片。",
      "time_min": 12,
      "heat": "无火",
      "tip": "热的时候切会散，晾十分钟切面才整齐。",
      "visual_cue": "脱模完整，切面湿润，状态稳定"
    }
  ],
  "tips": [
    "香蕉要选皮发黑的熟果，甜度和香气都足。",
    "粉类拌到无干粉就停手，口感才不韧。，值得留意。",
    "竹签插入不带湿面糊才算烤透。，值得留意。"
  ],
  "common_mistakes": [
    "香蕉没熟透，烤出来发涩又不甜。，务必避免。",
    "面糊搅拌过度，成品又硬又干。，务必避免。",
    "模具没铺油纸，脱模时整个粘住。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "110 克:90 毫升",
      "note": "组织更松软，奶香略淡。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "120 克:120 克",
      "note": "颜色更深，焦糖味更浓。"
    }
  ],
  "variations": [
    "加一把核桃碎，口感更有层次。，也很受欢迎。",
    "表面撒一层白糖，烤出薄脆的顶壳。，也很受欢迎。"
  ],
  "serving_suggestion": "温热时切片配一杯咖啡或牛奶，早餐和下午茶都合适。",
  "storage": "常温密封三天，冷藏一周，切片后回温再吃。",
