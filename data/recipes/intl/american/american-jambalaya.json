  "steps": [
    {
      "n": 1,
      "text": "培根切小片，冷锅下锅小火煎，不放植物油也会出油。",
      "time_min": 7,
      "heat": "小火",
      "tip": "冷锅下培根，油才慢慢出。，火大了就离锅远一点。",
      "visual_cue": "培根卷曲，锅底有油"
    },
    {
      "n": 2,
      "text": "下鸡腿肉块，中火煎到表面金黄。，火别开太大，稳着来。",
      "time_min": 8,
      "heat": "中火",
      "tip": "别急着翻动，煎定型再翻。，锅温要匀，别忽高忽低。",
      "visual_cue": "肉块焦黄，边缘收紧"
    },
    {
      "n": 3,
      "text": "加洋葱、芹菜和红椒丁炒到变软。，火力保持中等，慢慢来。",
      "time_min": 7,
      "heat": "中火",
      "tip": "三样切一样大，熟度才一致。，火候宁小勿大，慢慢推进。",
      "visual_cue": "蔬菜软塌，颜色变亮"
    },
    {
      "n": 4,
      "text": "加蒜末和辣椒粉炒香，下番茄块。，注意锅里温度别掉下来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香料炒出油色，饭才够味。，始终中小火，别心急。",
      "visual_cue": "香气冲鼻，番茄渗汁"
    },
    {
      "n": 5,
      "text": "倒大米翻炒两分钟，让米粒裹油。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米粒炒过，煮后才不粘。，看住火，别让它失控。",
      "visual_cue": "米粒油亮，粒粒分开"
    },
    {
      "n": 6,
      "text": "加清水和香叶，加盐调味煮开。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水一次加够，中途别补。，火大了就离锅远一点。",
      "visual_cue": "汤面翻滚，香气浮出"
    },
    {
      "n": 7,
      "text": "转小火盖盖焖二十分钟，别开盖。，火别开太大，稳着来。",
      "time_min": 22,
      "heat": "小火",
      "tip": "中途开盖，蒸汽跑掉饭就夹生。，锅温要匀，别忽高忽低。",
      "visual_cue": "饭粒吸水，表面见小孔"
    },
    {
      "n": 8,
      "text": "关火焖十分钟，开盖挑出香叶。，火力保持中等，慢慢来。",
      "time_min": 12,
      "heat": "无火",
      "tip": "关火再焖，饭心才透。，火候宁小勿大，慢慢推进。",
      "visual_cue": "米粒蓬松，汁水收干"
    },
    {
      "n": 9,
      "text": "撒黑胡椒，用叉子拨散盛盘。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "叉子拨散，米粒才不结块。，始终中小火，别心急。",
      "visual_cue": "饭粒分明，色泽橙红"
    }
  ],
  "tips": [
    "大米先炒过，煮后才松散。，这是关键点。",
    "水一次加够，中途开盖会夹生。，别嫌麻烦，做完它。",
    "关火焖十分钟，饭心才透。，这一步别省。"
  ],
  "common_mistakes": [
    "火太大，锅底焦了一层。，别跳过这步。",
    "水加太多，煮成稀饭。，这步最关键。",
    "米没炒直接煮，黏成一团。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "虾",
      "ratio": "400 克:400 克",
      "note": "虾最后五分钟放，别久煮。"
    },
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "80 克:80 克",
      "note": "咸度更高，盐要减两克。"
    }
  ],
  "variations": [
    "加蛤蜊同煮，鲜味更足。，这里最容易翻车。",
    "加一勺辣酱，辣味更冲。，别小看这一步。"
  ],
  "serving_suggestion": "配辣酱和冰啤酒，撒香菜更香。，成败就在这一步。",
  "storage": "冷藏两天，复热加少量水。，这点要注意。",
