  ],
  "equipment": [
    "炒锅",
    "木铲",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "毛豆剥出豆粒后冲洗两遍，玉米粒若是整根甜玉米先削下来，两样分开装碗备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "毛豆外层的薄皮遇热容易发硬，剥的时候顺手搓掉口感更嫩。",
      "visual_cue": "豆粒饱满发亮，碗底没有积水"
    },
    {
      "n": 2,
      "text": "炒锅烧热倒植物油，下洋葱丁用中火煸炒到边缘透亮、香气散出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱要炒到透明才出甜味，急着放别的料会带生辛气。",
      "visual_cue": "洋葱变半透明，锅里有甜香"
    },
    {
      "n": 3,
      "text": "放红椒丁同炒一分钟，再把玉米粒与毛豆一起下锅翻炒均匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "毛豆比玉米难熟，下锅后先铺平让它贴住锅底受热。",
      "visual_cue": "玉米粒边缘微微起泡，颜色转深"
    },
    {
      "n": 4,
      "text": "沿锅边淋入少量清水，加盖焖三分钟，让毛豆彻底断生熟透。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆类别省这道焖，生的毛豆带豆腥还会闹肚子。",
      "visual_cue": "豆粒一压就碎，锅里水汽将干"
    },
    {
      "n": 5,
      "text": "开盖加黄油与淡奶油，转大火快速翻炒到汤汁变浓、裹住每一粒豆。",
      "time_min": 3,
      "heat": "大火",
      "tip": "奶油下锅后要不停翻，火大了容易糊底发苦。",
      "visual_cue": "汤汁挂在豆粒上不再流动"
    },
    {
      "n": 6,
      "text": "撒盐与现磨黑胡椒翻匀，尝一颗豆子调好咸淡即可盛盘。",
      "time_min": 2,
      "heat": "小火",
      "tip": "盐最后放，早放会让毛豆表皮收紧、口感发韧。",
      "visual_cue": "咸淡合适，盘面油亮不积水"
    }
  ],
  "tips": [
    "冷冻毛豆不用解冻，直接下锅多焖一分钟就行。",
    "想更浓稠可以多加二十毫升淡奶油，收汁时火要更小。",
    "加两片培根先煸出油再炒洋葱，风味更接近南方做法。",
    "剩下的冷吃也好吃，拌一点柠檬汁当沙拉。"
  ],
  "common_mistakes": [
    "毛豆没焖透就出锅，咬起来咯吱响还带豆腥味。",
    "奶油下锅后大火猛烧，锅底结出一层焦褐的奶皮。",
    "盐和洋葱一起早放，毛豆表皮变硬嚼不烂。",
    "玉米用的是罐头甜玉米却没沥干，整盘变成稀汤。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "60 毫升:60 毫升",
      "note": "浓度低一些，收汁时间要延长两分钟。"
    },
    {
      "original": "毛豆",
      "substitute": "青豆",
      "ratio": "200 克:200 克",
      "note": "口感更软，焖的时间可以缩短到两分钟。"
    }
  ],
  "variations": [
    "把淡奶油换成椰浆，做成带椰香的素食版本。",
    "最后拌入一把撕碎的罗勒叶，香气会清爽很多。"
  ],
  "serving_suggestion": "盛进浅口盘里，黄绿两色分明，配烤鸡腿或煎猪排都合适，汤汁别倒掉，拌饭正好。",
  "storage": "冷藏密封可存两天，复热时加一勺清水用小火翻热，不要用大火久煮否则奶油会分离。",
