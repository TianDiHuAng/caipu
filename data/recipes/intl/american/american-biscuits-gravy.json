  "equipment": [
    "烤箱",
    "平底锅",
    "碗",
    "擀面杖",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到二百度，烤盘铺油纸。，始终中小火，别心急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "提前预热，饼干才发得起来。，火要均匀，食材才不糊。",
      "visual_cue": "烤箱温度到位，烤盘备好"
    },
    {
      "n": 2,
      "text": "面粉、泡打粉和盐混匀，加冷黄油丁。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油要冷，层次才明显。，全程留意火候，别贪快。",
      "visual_cue": "颗粒粗砂，粉料均匀"
    },
    {
      "n": 3,
      "text": "倒牛奶揉成团，别过度揉搓。，火大了就离锅远一点。",
      "time_min": 5,
      "heat": "无火",
      "tip": "揉到没干粉就停，越揉越硬。，火别开太大，稳着来。",
      "visual_cue": "面团粗糙，略粘手，别跳过这步。"
    },
    {
      "n": 4,
      "text": "擀成两厘米厚，切出六块圆饼。，锅温要匀，别忽高忽低。",
      "time_min": 6,
      "heat": "无火",
      "tip": "刀直上直下切，边缘才分层。，火力保持中等，慢慢来。",
      "visual_cue": "饼坯厚实，边缘整齐"
    },
    {
      "n": 5,
      "text": "烤十五分钟到表面金黄。，火候宁小勿大，慢慢推进。",
      "time_min": 17,
      "heat": "无火",
      "tip": "烤到侧面裂开，里面才熟。，注意锅里温度别掉下来。",
      "visual_cue": "表面金黄，侧面分层"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油，炒散猪肉末。，始终中小火，别心急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉末炒散，别结大块。，火要均匀，食材才不糊。",
      "visual_cue": "肉末松散，颜色变深"
    },
    {
      "n": 7,
      "text": "撒面粉炒一分钟，倒牛奶搅匀。，看住火，别让它失控。",
      "time_min": 5,
      "heat": "中火",
      "tip": "面粉先炒过，汁才不结块。，全程留意火候，别贪快。",
      "visual_cue": "锅底糊状，无干粉，这步最关键。"
    },
    {
      "n": 8,
      "text": "小火煮到浓稠，加盐和大量黑胡椒。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "小火",
      "tip": "不停搅，免得糊底。，火别开太大，稳着来。",
      "visual_cue": "汁体浓稠，能挂勺，很多人在这里出错。"
    },
    {
      "n": 9,
      "text": "饼干对半切开，浇上肉汁趁热吃。，锅温要匀，别忽高忽低。",
      "time_min": 3,
      "heat": "无火",
      "tip": "现浇现吃，饼干才不软塌。，火力保持中等，慢慢来。",
      "visual_cue": "汁水渗入，香气扑鼻"
    }
  ],
  "tips": [
    "黄油要冷，饼干才分层。，这里最容易翻车。",
    "面团别揉多，揉久就硬。，别小看这一步。",
    "黑胡椒要多，肉汁才有魂。，成败就在这一步。"
  ],
  "common_mistakes": [
    "黄油太软，饼干摊成饼。，这点要注意。",
    "肉汁没搅，结成一团团。，这是关键点。",
    "火太大，肉汁焦底发苦。，别嫌麻烦，做完它。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "300 克:300 克",
      "note": "味道更浓，可多加黄油五克。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "400 毫升:200 毫升",
      "note": "需兑水一半，质地更厚。"
    }
  ],
  "variations": [
    "肉汁里加辣椒碎，辣味更足。，这一步别省。",
    "饼干上加煎蛋，做成早餐堡。，别跳过这步。"
  ],
  "serving_suggestion": "淋满肉汁，配煎蛋和咖啡。，这步最关键。",
  "storage": "饼干常温一天，肉汁冷藏两天。，很多人在这里出错。",
