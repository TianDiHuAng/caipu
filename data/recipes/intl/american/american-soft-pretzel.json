  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "高筋面粉",
          "name_en": "bread flour",
          "amount": 400,
          "unit": "g",
          "note": "过筛",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 230,
          "unit": "ml",
          "note": "温水",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 6,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 15,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        },
        {
          "name": "小苏打",
          "name_en": "baking soda",
          "amount": 20,
          "unit": "g",
          "note": "碱水用",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "融化放凉",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
          "unit": "g",
          "note": "面团调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "烤盘",
    "汤锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水化开酵母与白糖，静置五分钟看到表面浮起细泡。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水太烫会杀死酵母，手摸上去温热即可。",
      "visual_cue": "水面浮起一层细密泡沫"
    },
    {
      "n": 2,
      "text": "高筋面粉加盐拌匀，倒入酵母水和融化黄油，揉成光滑面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "黄油分两次揉进去，面团更容易吸收。",
      "visual_cue": "面团光滑有弹性，拉扯不回缩"
    },
    {
      "n": 3,
      "text": "盖布室温发酵五十分钟，面团膨到原来的两倍大。",
      "time_min": 50,
      "heat": "无火",
      "tip": "环境凉就放温水锅里隔水发酵，温度更稳定。",
      "visual_cue": "体积翻倍，表面鼓起细小气泡"
    },
    {
      "n": 4,
      "text": "面团分成四份，搓成长条后交叉打结，两端压紧成卷饼形状。",
      "time_min": 10,
      "heat": "无火",
      "tip": "打结时留出中间的空隙，烤完形状才漂亮。",
      "visual_cue": "结口紧实，整体粗细均匀"
    },
    {
      "n": 5,
      "text": "汤锅加大半锅水与小苏打煮到微沸，把面团逐个下锅焯三十秒。",
      "time_min": 6,
      "heat": "中火",
      "tip": "小苏打让表皮变深，焯久了会带碱苦味。",
      "visual_cue": "面团表面泛白略皱，捞出时变硬挺"
    },
    {
      "n": 6,
      "text": "烤盘铺纸摆上卷饼，表面撒一层盐，两百度烤十四分钟。",
      "time_min": 14,
      "heat": "中火",
      "tip": "撒盐前刷一层水，盐粒才粘得住不落。",
      "visual_cue": "表面深棕发亮，撒的盐粒仍清晰可见"
    }
  ],
  "tips": [
    "趁热蘸芥末酱吃，是美式球场与街头的标准搭配。",
    "小苏打换成烘焙碱，颜色会更接近德国原版。",
    "表面撒粗粒海盐比细盐更有咬感。",
    "面团冷藏一夜再整形，风味更醇厚。"
  ],
  "common_mistakes": [
    "焯水时水滚得太猛，面团下锅就散开走形。",
    "碱水浓度太高，烤出来带明显碱苦味。",
    "发酵不足就急着整形，烤完硬得像石头块。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30克:30毫升",
      "note": "奶香减淡，适合乳糖不耐。"
    },
    {
      "original": "小苏打",
      "substitute": "烘焙碱",
      "ratio": "20克:15克",
      "note": "上色更深，须戴手套操作。"
    }
  ],
  "variations": [
    "卷饼里夹入奶酪条，做成爆浆的奶酪卷饼。",
    "表面撒一层肉桂糖，做成甜味版卷饼。"
  ],
  "serving_suggestion": "趁热吃口感最好，配一杯啤酒或热咖啡都合适。",
  "storage": "室温密封一天，冷冻一个月，回烤五分钟即可恢复。",
