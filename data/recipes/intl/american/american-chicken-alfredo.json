  "equipment": [
    "深锅",
    "平底锅",
    "夹子",
    "刨丝器",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "深锅烧开大半锅水，加一勺盐，把意大利面下锅按包装时间煮到略硬。",
      "time_min": 11,
      "heat": "大火",
      "tip": "面要煮到咬开中心还有一点白芯，后面拌酱还会继续变软。",
      "visual_cue": "意大利面能弯不易断，中心留白点"
    },
    {
      "n": 2,
      "text": "煮面同时把鸡胸肉横刀片成两片，两面撒盐与黑胡椒腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "片薄再煎受热均匀，整块厚肉外面老了里面还没熟。",
      "visual_cue": "肉片厚薄一致，表面挂满调料"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油中火烧热，放鸡胸肉每面煎四分钟，煎好夹出静置。",
      "time_min": 9,
      "heat": "中火",
      "tip": "下锅后别急着翻，等边缘变白定型再翻才不粘锅。",
      "visual_cue": "两面金黄，按压有弹性"
    },
    {
      "n": 4,
      "text": "原锅放黄油，下洋葱丁与蒜末小火炒到洋葱透亮、蒜香散出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末容易焦，火一定要小，闻到香就下奶油。",
      "visual_cue": "洋葱透明，锅底泛出奶白"
    },
    {
      "n": 5,
      "text": "倒入淡奶油小火加热，边搅边煮到微微冒泡，再放帕玛森芝士搅到融化。",
      "time_min": 4,
      "heat": "小火",
      "tip": "奶油不能大滚，滚过头会油水分离变成颗粒状。",
      "visual_cue": "酱汁顺滑挂勺，表面光亮"
    },
    {
      "n": 6,
      "text": "把沥干的意大利面与切条鸡肉倒进酱汁，翻拌到每根面都裹上酱，撒欧芹出锅。",
      "time_min": 2,
      "heat": "小火",
      "tip": "留半碗煮面水，酱太稠时加两勺就能重新顺滑。",
      "visual_cue": "意大利面被酱裹住，盘底不积油"
    }
  ],
  "tips": [
    "煮面水别全倒掉，含淀粉的水是调稀酱汁的最好材料。",
    "帕玛森现刨比预刨粉香得多，用量也可适当减少。",
    "鸡肉煎完静置三分钟再切，汁水不会全流在板上。",
    "想更浓可以加一个蛋黄同拌，但温度不能太高否则会结块。"
  ],
  "common_mistakes": [
    "奶油大火烧滚，酱汁当场分成油和白色颗粒。",
    "意大利面煮到全软才捞，拌酱时一搅就烂成糊。",
    "蒜末和洋葱一起大火爆，蒜焦黑带苦味毁了整锅。",
    "鸡肉煎完直接切，一盘汁水全渗在盘底。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶加黄油",
      "ratio": "200 毫升:180 毫升加20克",
      "note": "更清爽，收汁时间要延长三分钟。"
    },
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "400 克:400 克",
      "note": "口感更嫩，煎的时间每面多一分钟。"
    }
  ],
  "variations": [
    "加一把白蘑菇同炒，做成蘑菇奶油意面。",
    "最后撒一点红椒碎与帕玛森同烤两分钟，表面多一层焦壳。"
  ],
  "serving_suggestion": "装进预热的深盘，鸡肉条摆在面上，再刨一层芝士与黑胡椒，配一份蒜香面包把酱汁蘸干净。",
  "storage": "冷藏可存两天，复热时加两勺牛奶用小火翻拌，别用大火，酱汁容易分离。",
