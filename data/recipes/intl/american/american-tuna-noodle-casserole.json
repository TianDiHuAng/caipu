  "equipment": [
    "烤箱",
    "汤锅",
    "炒锅",
    "烤盘",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面条放进沸水锅里煮到八分熟，捞出沥干水分备用。",
      "time_min": 8,
      "heat": "大火",
      "tip": "面条煮到中心略硬就捞，后面还要进烤箱焗。",
      "visual_cue": "面条弹牙，根根分开"
    },
    {
      "n": 2,
      "text": "蘑菇洗净切成薄片，炒锅放黄油中火炒到蘑菇出水变软。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蘑菇先炒出水再收干，香气才浓郁不腥。",
      "visual_cue": "蘑菇片软塌，锅底收干"
    },
    {
      "n": 3,
      "text": "撒入面粉不断翻炒成稠糊，慢慢倒入牛奶搅成顺滑白汁。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶分三次倒，边倒边搅才不会结块。",
      "visual_cue": "白汁顺滑，不见颗粒"
    },
    {
      "n": 4,
      "text": "加入奶酪、盐和黑胡椒，小火搅到奶酪完全化开。",
      "time_min": 3,
      "heat": "小火",
      "tip": "奶酪小火慢慢化，大火会让白汁出油分离。",
      "visual_cue": "酱汁浓稠，能挂住勺背"
    },
    {
      "n": 5,
      "text": "拌入面条、金枪鱼和蘑菇片，倒进烤盘抹平表面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "金枪鱼先撕散再拌，块太大口感发柴。",
      "visual_cue": "面糊均匀，盘面平整"
    },
    {
      "n": 6,
      "text": "表面撒满面包糠，烤箱一百八十度焗二十分钟到金黄。",
      "time_min": 20,
      "heat": "中火",
      "tip": "表面金黄冒泡就出炉，烤太久面条会干掉。",
      "visual_cue": "表层金黄酥脆，内里冒泡"
    }
  ],
  "tips": [
    "面条煮八分熟就够，焗的时候还会继续变软。",
    "牛奶分次倒入白汁，酱汁才顺滑不结块。",
    "面包糠最后撒，烤出来才有脆壳。"
  ],
  "common_mistakes": [
    "面条煮到全软再焗，成品糊成一坨。",
    "牛奶一次倒完，白汁结出满锅小疙瘩。",
    "烤箱温度过头，表面焦黑内里还凉。"
  ],
  "substitutions": [
    {
      "original": "金枪鱼",
      "substitute": "鸡胸肉",
      "ratio": "180 克:200 克",
      "note": "煮熟撕成丝，焗制时间不变。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "300 毫升:250 毫升",
      "note": "更浓郁，盐减少一克。"
    }
  ],
  "variations": [
    "加一把青豆同焗，颜色和口感更丰富。",
    "表面撒一层奶酪碎，脆壳更厚更香。"
  ],
  "serving_suggestion": "出炉稍放五分钟再分块，配一份生菜沙拉正好。",
  "storage": "冷藏两天，复烤十五分钟至中心热透。",
