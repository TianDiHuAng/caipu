      ]
    }
  ],
  "equipment": [
    "烤箱",
    "松饼模",
    "搅拌盆",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到一百九十度，松饼模里铺上纸杯备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "模具先备好，面糊调完要立刻进炉不能等。",
      "visual_cue": "烤箱指示灯亮起，纸杯整齐排在模里"
    },
    {
      "n": 2,
      "text": "玉米面、面粉、泡打粉与盐倒进盆里，用打蛋器拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先把干料拌匀，泡打粉分布均匀才发得整齐。",
      "visual_cue": "粉类颜色均匀，看不到明显的结块"
    },
    {
      "n": 3,
      "text": "另一个盆里打散鸡蛋，加牛奶、白糖与融化的黄油搅匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油要放凉再倒，太烫会把蛋液烫成蛋花。",
      "visual_cue": "液体呈浅黄色，油花均匀散开"
    },
    {
      "n": 4,
      "text": "把液体倒进干粉里，用刮刀翻拌到刚好没有干粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌十几下就要停手，多拌出筋会让松饼发硬。",
      "visual_cue": "面糊粗糙，表面还有零星小干粉块"
    },
    {
      "n": 5,
      "text": "面糊分装进纸杯，装到七分满，表面轻磕排出气泡。",
      "time_min": 4,
      "heat": "无火",
      "tip": "装太满会溢出模具，边缘烤成难看的一圈厚边。",
      "visual_cue": "面糊平整，每个杯子高度一致"
    },
    {
      "n": 6,
      "text": "送进烤箱中层烤十八分钟，直到表面金黄牙签插入无粘连。",
      "time_min": 20,
      "heat": "无火",
      "tip": "中途千万不要开炉门，冷气进来松饼立刻塌陷。",
      "visual_cue": "顶部金黄隆起，牙签拔出干爽"
    },
    {
      "n": 7,
      "text": "出炉趁热在表面刷一层蜂蜜，放网架上晾到不烫手。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刷蜜一定要趁热，凉了只浮在表面进不了味。",
      "visual_cue": "表面油亮带蜜光，侧边微微脱模"
    }
  ],
  "tips": [
    "玉米面换成细粒口感更细腻，粗粒更有嚼头。",
    "拌面糊时留一点干粉，烤出来更松软。",
    "配辣椒炖豆吃，是美式南方的经典搭配。",
    "凉透后密封冷冻，复烤五分钟像新出炉一样。"
  ],
  "common_mistakes": [
    "面糊搅拌过度，烤出来的组织紧实发韧。",
    "纸杯只装五分满，烤出来扁扁的没有形态。",
    "烤到一半开炉门查看，温差会让松饼表面塌陷。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "酸奶",
      "ratio": "240毫升:240毫升",
      "note": "口感更湿润，酸味更明显。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "80克:70毫升",
      "note": "组织更松，香气略减。"
    }
  ],
  "variations": [
    "加一把新鲜玉米粒，咬开有爆汁的甜感。",
    "表面撒一点切达奶酪丝，咸香风味会更足。"
  ],
  "serving_suggestion": "温热时掰开抹上黄油，配一碗浓汤或炖豆都很合适。",
  "storage": "密封常温放两天，冷冻可存一个月，复烤后口感回升。",
