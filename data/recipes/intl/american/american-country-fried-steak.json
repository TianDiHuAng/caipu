  ],
  "equipment": [
    "肉锤",
    "平底锅",
    "浅盘",
    "夹子",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊横切成一点五厘米厚的片，用肉锤两面敲松到一厘米厚，边缘剪两刀断筋。",
      "time_min": 12,
      "heat": "无火",
      "tip": "敲松纤维才咬得动，边缘剪口下锅才不会卷边",
      "visual_cue": "肉片摊平，轻按边缘不再回卷"
    },
    {
      "n": 2,
      "text": "肉片两面撒盐与黑胡椒，静置十分钟让调味渗进表层。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐提前撒能带出肉里的水分，裹粉才挂得牢",
      "visual_cue": "肉面渗出一层细密水光"
    },
    {
      "n": 3,
      "text": "鸡蛋与牛奶打匀成蛋液，肉片先两面拍薄面粉，再蘸蛋液，最后压一层面粉抖掉多余干粉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "三层顺序不能乱，抖掉浮粉炸出来才不掉渣",
      "visual_cue": "外壳呈均匀毛絮状，不见干粉"
    },
    {
      "n": 4,
      "text": "平底锅倒花生油烧到插入筷子冒小泡，放入肉片中火每面炸三分钟至金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温不够外壳会脱浆，冒小泡才是下锅时机",
      "visual_cue": "油面翻花，肉片边缘立刻冒泡"
    },
    {
      "n": 5,
      "text": "炸好的肉片放在网架上沥油，锅留两大勺底油下蒜片炒香，加两勺面粉炒成糊。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "面粉要炒到微微发黄，酱汁才不带生面味",
      "visual_cue": "面糊泛起细泡，颜色转浅黄"
    },
    {
      "n": 6,
      "text": "分三次倒入牛奶搅成浓稠酱汁，加盐与黑胡椒调味，煮到挂勺即可。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "牛奶一次倒太多会结块，少量多次才顺滑",
      "visual_cue": "勺背挂着一层顺滑白汁"
    },
    {
      "n": 7,
      "text": "把酱汁浇在炸牛排上，撒一撮黑胡椒，趁外壳还脆立刻端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酱汁要在肉还脆的时候浇，泡久了外壳会软",
      "visual_cue": "酱汁挂住表面，盘底不见积水"
    }
  ],
  "tips": [
    "肉片厚度均匀才炸得一致，两头薄的地方可以叠起来敲。",
    "裹粉后静置五分钟再下锅，外壳更服帖不容易掉。",
    "锅底那层焦渣别洗掉，正好用来炒酱汁，味道更浓。",
    "剩下的酱汁第二天用来浇薯条，比买的蘸酱好吃。"
  ],
  "common_mistakes": [
    "肉片没敲松就直接下锅，端上桌咬着像皮鞋底。",
    "油温过低就下肉，外壳脱浆沉底，肉也吸了一肚子油。",
    "牛奶一次性倒进面糊里，酱汁结成一颗颗白疙瘩。",
    "炸完立刻泡进酱汁，外壳全软，一点脆感都没有。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "猪里脊",
      "ratio": "600 克:600 克",
      "note": "更接近美式家常版本的嫩度。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "60 克:60 克",
      "note": "酱汁更厚重，脂肪含量也更高。"
    }
  ],
  "variations": [
    "酱汁里加一勺白胡椒粉，辛香更明显，接近得州 roadside 版本。",
    "肉片换成鸡腿肉压平，就是同做法的炸鸡排。"
  ],
  "serving_suggestion": "四人份主菜，酱汁单独装小壶随菜上桌，吃前再淋，外壳能一直保持脆口。",
  "storage": "冷藏两天内吃完，肉与酱汁分开密封；复热用平底锅干煎两分钟，酱汁小火加两勺水化开。",
