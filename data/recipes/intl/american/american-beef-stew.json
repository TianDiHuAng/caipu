  "equipment": [
    "炖锅",
    "砧板",
    "木勺",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩块用厨房纸吸干水分，撒上盐与黑胡椒抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面越干，下锅越容易煎出漂亮的焦褐色。",
      "visual_cue": "肉块表面干爽，调料均匀附在每一面"
    },
    {
      "n": 2,
      "text": "把面粉薄薄撒在肉块上，翻动几下让每块都裹上一层。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄薄裹一层就够，裹厚了炖出来汤汁会发黏。",
      "visual_cue": "肉块表面呈哑光白色，看不出干粉"
    },
    {
      "n": 3,
      "text": "炖锅烧热橄榄油，分批下肉块煎到六面呈深褐色后盛出。",
      "time_min": 12,
      "heat": "大火",
      "tip": "一次别放太多，挤在一起只会出水不会上色。",
      "visual_cue": "锅底结出棕褐色焦层，肉块表面硬挺"
    },
    {
      "n": 4,
      "text": "原锅下洋葱、西芹与蒜末，小火炒到洋葱变透明。",
      "time_min": 8,
      "heat": "中火",
      "tip": "用锅铲刮起锅底的焦褐色，那些都是香味。",
      "visual_cue": "洋葱软塌透明，锅底焦层被刮开"
    },
    {
      "n": 5,
      "text": "加番茄膏炒一分钟，倒回肉块，注入清水后用大火烧开。",
      "time_min": 10,
      "heat": "大火",
      "tip": "番茄膏炒过颜色才红亮，生番茄膏带酸涩。",
      "visual_cue": "汤汁呈红棕色，肉块大半浸在汤里"
    },
    {
      "n": 6,
      "text": "转小火加盖炖一小时，中途撇掉浮在表面的油脂。",
      "time_min": 62,
      "heat": "小火",
      "tip": "汤面只冒小泡最合适，翻滚会让肉块散架。",
      "visual_cue": "肉块边缘开始变软，汤色加深"
    },
    {
      "n": 7,
      "text": "放入土豆、胡萝卜与蘑菇，继续炖二十五分钟到蔬菜变软。",
      "time_min": 27,
      "heat": "小火",
      "tip": "根茎菜一定要后放，久炖会化成泥让汤汁变浑。",
      "visual_cue": "土豆一插即透，胡萝卜颜色发亮"
    },
    {
      "n": 8,
      "text": "开盖大火收汁五分钟，尝咸淡补盐，撒黑胡椒即可盛出。",
      "time_min": 7,
      "heat": "大火",
      "tip": "汤汁收到能挂住勺背，舀一勺拌米饭刚刚好。",
      "visual_cue": "汤汁浓亮挂勺，肉块软而完整"
    }
  ],
  "tips": [
    "隔夜再吃味道更好，蔬菜的甜味都渗进汤里。",
    "加一勺番茄酱，汤色更红也更有食欲。",
    "牛腩换成牛肩肉，炖的时间要多二十分钟。",
    "配一碗热米饭，把盘子里的汤汁都拌干净。"
  ],
  "common_mistakes": [
    "肉块没吸干水就下锅，煎出一锅水和灰白的肉。",
    "一次把所有肉倒进锅里，温度骤降后全是水汽。",
    "全程大火猛煮，两小时后肉还是又硬又柴。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛肩肉",
      "ratio": "800克:800克",
      "note": "筋膜少，炖的时间要多二十分钟。"
    },
    {
      "original": "番茄膏",
      "substitute": "番茄酱",
      "ratio": "30克:40克",
      "note": "颜色更亮，酸甜味更明显。"
    }
  ],
  "variations": [
    "加一小杯红酒一起炖，味道会更有层次感。",
    "最后撒一把青豆进去，颜色与口感都更清爽。"
  ],
  "serving_suggestion": "盛进深碗，撒现磨黑胡椒，配米饭或土豆泥都很合适。",
  "storage": "冷藏可放四天，冷冻能存两个月，复热后风味更融合。",
