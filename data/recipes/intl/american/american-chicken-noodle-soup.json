  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "漏勺",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉冲洗干净，冷水下锅煮开，撇掉表面浮沫，转小火炖二十五分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "冷水下锅才能把血沫慢慢逼出来，汤才清亮不腥。",
      "visual_cue": "汤面浮沫撇净，汤色浅金"
    },
    {
      "n": 2,
      "text": "捞出鸡肉放凉，汤过滤留用，撇去表面多余的浮油。",
      "time_min": 8,
      "heat": "无火",
      "tip": "浮油撇干净，汤喝起来清爽，凉了也不会结一层白油。",
      "visual_cue": "汤清见底，表面几乎无油"
    },
    {
      "n": 3,
      "text": "鸡肉去皮去骨，用手撕成一口大小的条，骨头上的肉也别浪费。",
      "time_min": 6,
      "heat": "无火",
      "tip": "手撕比刀切更挂汤，断面粗糙能吸更多汤汁。",
      "visual_cue": "鸡丝粗细随意，无骨无皮"
    },
    {
      "n": 4,
      "text": "汤锅放植物油，中火炒洋葱丁三分钟到透明，再加蒜末炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蔬菜先炒过再炖，甜味更足，汤也不会寡淡。",
      "visual_cue": "洋葱透明，锅底有焦香"
    },
    {
      "n": 5,
      "text": "加胡萝卜片与芹菜段翻炒两分钟，倒回鸡汤与香叶，煮开后小火炖十分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "胡萝卜切薄片才和芹菜同时软，厚了下锅时间对不上。",
      "visual_cue": "胡萝卜微软，汤色加深"
    },
    {
      "n": 6,
      "text": "把面条折断下锅，中火煮六分钟到软，其间搅动两下防粘底。",
      "time_min": 7,
      "heat": "中火",
      "tip": "面条会吸汤，煮的时候多搅几次，不然全粘在锅底。",
      "visual_cue": "面条软透浮起，汤略变稠"
    },
    {
      "n": 7,
      "text": "放回鸡丝煮两分钟，加盐与黑胡椒调味，尝一下咸淡。",
      "time_min": 3,
      "heat": "小火",
      "tip": "鸡丝最后放，久煮会散成絮状，汤也发浑。",
      "visual_cue": "鸡丝分布均匀，汤面清亮"
    },
    {
      "n": 8,
      "text": "挑出香叶，撒上欧芹碎，盛进深碗里趁热喝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "欧芹关火后撒，颜色翠绿，香气也不散。",
      "visual_cue": "汤面浮绿点，鸡肉与面条堆满碗"
    }
  ],
  "tips": [
    "面条单独煮好再放，汤不会变稠，剩下的汤也清爽。",
    "加一勺酸度温和的果醋，汤的味道立刻亮起来。",
    "剩汤第二天会更浓，喝前加一点水稀释。",
    "用整只鸡炖出的汤底更厚，只用腿肉是图方便的做法。"
  ],
  "common_mistakes": [
    "鸡肉热水下锅，外表瞬间收紧，血沫锁在里面，汤发浑带腥。",
    "面条一直在汤里泡，隔夜后吸干汤汁，变成一锅面糊。",
    "盐一开始就放足，炖到最后水分蒸发，汤咸得喝不下。"
  ],
  "substitutions": [
    {
      "original": "面条",
      "substitute": "米粒面",
      "ratio": "240克:200克",
      "note": "更小粒，煮制时间缩短两分钟。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "500克:450克",
      "note": "更瘦，炖制时间缩短五分钟。"
    }
  ],
  "variations": [
    "加一勺奶油与黄油，做成更浓郁的家常版本。",
    "加一把菠菜或青豆，颜色和营养都更均衡。"
  ],
  "serving_suggestion": "四人份汤面，配苏打饼干或烤面包，是最经典的感冒餐。",
  "storage": "汤与面分开冷藏，三天内吃完；复热时先热汤再下面，避免面吸干汤汁。",
