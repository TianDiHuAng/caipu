          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "厨房纸",
    "重物",
    "三个浅盘",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐用厨房纸包好，压上重物静置二十分钟，把里面的水分挤出来。",
      "time_min": 20,
      "heat": "无火",
      "tip": "水分挤不干，下锅只会软塌塌粘成一团，脆壳根本挂不住。",
      "visual_cue": "豆腐厚度变薄，纸吸满水"
    },
    {
      "n": 2,
      "text": "压好的豆腐切成三厘米见方的块，表面再拍一层干玉米淀粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "淀粉要拍匀拍薄，厚的粉层炸完会脱壳。",
      "visual_cue": "块面泛白，摸起来滑而不粘手"
    },
    {
      "n": 3,
      "text": "鸡蛋打散成蛋液，把豆腐块先蘸蛋液再滚一层面包糠，轻压让糠粘牢。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蘸完蛋液要沥一下，太湿会把面包糠泡成糊。",
      "visual_cue": "每块裹满糠粒，边角也盖住"
    },
    {
      "n": 4,
      "text": "平底锅倒植物油中火烧到筷子插入冒小泡，把豆腐块排进去不要挤。",
      "time_min": 2,
      "heat": "中火",
      "tip": "块之间留空隙才不会粘成饼，油温不够会吸油发软。",
      "visual_cue": "豆腐边缘立刻冒密集小泡"
    },
    {
      "n": 5,
      "text": "每面煎两到三分钟，翻面时用夹子托住底部，煎到通体金黄捞出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "翻面太早壳会破，看到边缘定型变色再翻最稳。",
      "visual_cue": "六面金黄，敲起来有脆响"
    },
    {
      "n": 6,
      "text": "出锅后趁热撒盐、黑胡椒与辣椒粉，抖匀后放在厨房纸上吸去浮油。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调味要在刚出锅时撒，凉了表面出油就挂不住。",
      "visual_cue": "表面干爽，调味均匀不结块"
    }
  ],
  "tips": [
    "老豆腐比嫩豆腐好操作，压水后不容易碎。",
    "没有面包糠可以用压碎的玉米片代替，更脆。",
    "想少油可以改成烤箱二百度烤二十分钟，中途翻一次面。",
    "一次多做点冷冻起来，吃前直接回锅复烤就行。"
  ],
  "common_mistakes": [
    "豆腐没压水就下锅，煎出来软趴趴还粘满锅底。",
    "油温太低就下锅，面包糠吸饱油变得又腻又软。",
    "锅里塞得太满，块和块粘在一起翻不动。",
    "调味撒得太早，盐把脆壳泡软变成一层糊。"
  ],
  "substitutions": [
    {
      "original": "面包糠",
      "substitute": "玉米片",
      "ratio": "50 克:50 克",
      "note": "压碎成粗粒，脆度更明显。"
    },
    {
      "original": "鸡蛋",
      "substitute": "玉米淀粉糊",
      "ratio": "50 克:60 克",
      "note": "纯素版本，黏合稍弱要轻拿轻放。"
    }
  ],
  "variations": [
    "裹好糠后刷一层辣酱再烤，做成水牛城风味。",
    "把辣椒粉换成孜然粉与蒜粉，香气更接近炸鸡。"
  ],
  "serving_suggestion": "趁热装盘，配一小碟番茄酱或蜂蜜芥末酱，旁边放几根芹菜条解腻，当正餐或下酒都合适。",
  "storage": "冷藏可存两天，复热用平底锅小火两面各煎一分钟，或烤箱一百八十度烤六分钟恢复脆度。",
