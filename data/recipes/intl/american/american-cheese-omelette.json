  "id": "american-cheese-omelette",
  "name": {
    "zh": "奶酪煎蛋卷",
    "en": "Cheese Omelette",
    "original": "Cheese Omelette"
  },
  "cuisine": {
    "region": "intl",
    "style": "american"
  },
  "category": [
    "main-egg"
  ],
  "difficulty": 1,
  "time": {
    "prep_min": 9,
    "cook_min": 12,
    "total_min": 21
  },
  "servings": 1,
  "flavor": [
    "savory",
    "umami",
    "rich"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 150,
          "unit": "g",
          "note": "约三个大鸡蛋",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "切达奶酪",
          "name_en": "cheddar cheese",
          "amount": 40,
          "unit": "g",
          "note": "擦成细丝",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 30,
          "unit": "g",
          "note": "切极细丁",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 15,
          "unit": "g",
          "note": "煎蛋用",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 20,
          "unit": "ml",
          "note": "让蛋液更嫩",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "打蛋碗",
    "打蛋器",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进碗里，加牛奶、盐与黑胡椒，用打蛋器打到完全均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打到蛋清蛋黄看不见丝，煎出来颜色才一致。",
      "visual_cue": "蛋液呈均匀的浅黄色，表面有细泡"
    },
    {
      "n": 2,
      "text": "洋葱切成极细的丁，越小越容易在短时间内变软。",
      "time_min": 4,
      "heat": "无火",
      "tip": "洋葱丁太大不容易煎熟，吃起来会呛辣。",
      "visual_cue": "洋葱丁细碎均匀，不粘成一团"
    },
    {
      "n": 3,
      "text": "平底锅小火烧热，放黄油融化到起细泡但不上色。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油一发褐就带焦味，宁可火力小一点。",
      "visual_cue": "黄油铺满锅底，泡沫细密不冒烟"
    },
    {
      "n": 4,
      "text": "下洋葱丁炒两分钟，炒到变软透明再摊平在锅底。",
      "time_min": 3,
      "heat": "小火",
      "tip": "先把洋葱炒软，蛋卷里才没有生的辣味。",
      "visual_cue": "洋葱变软透明，锅底散出甜香"
    },
    {
      "n": 5,
      "text": "倒入蛋液，用锅铲从边缘往中间轻推，让未熟的部分流下去。",
      "time_min": 4,
      "heat": "小火",
      "tip": "推拉而不是搅动，蛋皮才能形成柔软的褶层。",
      "visual_cue": "蛋液半凝固，表面还带一点湿润"
    },
    {
      "n": 6,
      "text": "在蛋皮中央撒上切达奶酪丝，用锅铲把一侧折过来盖住。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蛋皮还湿润时折，才能粘合成完整的蛋卷。",
      "visual_cue": "奶酪被盖住，蛋卷边缘自然封口"
    },
    {
      "n": 7,
      "text": "再煎一分钟让奶酪融化，轻轻滑到盘子里趁热吃。",
      "time_min": 2,
      "heat": "小火",
      "tip": "出锅前晃一下锅，蛋卷会自己滑动就说明没粘。",
      "visual_cue": "表面金黄柔软，切开能有奶酪拉丝"
    }
  ],
  "tips": [
    "蛋液里加一点牛奶，煎出来口感更松软。",
    "奶酪换成马苏里拉，拉丝效果会更好。",
    "配一片烤吐司和一杯橙汁，就是完整早餐。",
    "火越小蛋皮越嫩，别急着把火开大。"
  ],
  "common_mistakes": [
    "火太大，蛋皮底部已经焦了上面还是生的。",
    "蛋液搅得太用力，煎出来会碎成一块块。",
    "奶酪放太早，折的时候蛋皮已经硬了折不动。"
  ],
  "substitutions": [
    {
      "original": "切达奶酪",
      "substitute": "马苏里拉",
      "ratio": "40克:40克",
      "note": "拉丝更好，咸味更淡。"
    },
    {
      "original": "洋葱",
      "substitute": "菠菜",
      "ratio": "30克:40克",
      "note": "需先焯水挤干，避免出水。"
    }
  ],
  "variations": [
    "加两片煎脆的培根，咸香味道会更足。",
    "表面再撒一点辣椒粉，早餐也能带点辣劲。"
  ],
  "serving_suggestion": "对折成半月形装盘，配烤面包与咖啡是最常见的美式早餐。",
  "storage": "现做现吃最好，不建议存放之后再复热食用。",
