  "equipment": [
    "烤箱",
    "碗",
    "刷子",
    "刀",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄酱、红糖、白醋和辣椒粉放碗里。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先拌酱，味道才融合。，火候要稳，别忽大忽小。",
      "visual_cue": "酱体浓稠，颜色深红"
    },
    {
      "n": 2,
      "text": "加蒜末搅匀，尝一次酸甜。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸甜平衡，烤后才不腻。，火候要稳，别忽大忽小。",
      "visual_cue": "酱味酸甜，蒜香明显"
    },
    {
      "n": 3,
      "text": "鸡腿肉两面抹盐和黑胡椒，再刷一层植物油。",
      "time_min": 6,
      "heat": "无火",
      "tip": "抹匀静置十分钟，味道才进。，火候要稳，别忽大忽小。",
      "visual_cue": "表面油亮，调味均匀"
    },
    {
      "n": 4,
      "text": "烤箱预热到二百度，鸡肉放烤架。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "架着烤，底部才不泡汁。，火候要稳，别忽大忽小。",
      "visual_cue": "烤箱到位，烤盘垫锡纸"
    },
    {
      "n": 5,
      "text": "烤二十分钟，取出刷一层酱。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "无火",
      "tip": "前段不刷酱，免得烤焦。，火候要稳，别忽大忽小。",
      "visual_cue": "表面微黄，肉汁锁住"
    },
    {
      "n": 6,
      "text": "翻面再刷酱，烤十分钟。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "两面都刷，颜色才匀。，火候要稳，别忽大忽小。",
      "visual_cue": "酱色发亮，边缘焦褐"
    },
    {
      "n": 7,
      "text": "最后刷蜂蜜，烤五分钟上光。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "无火",
      "tip": "蜂蜜最后刷，容易糊。，火候要稳，别忽大忽小。",
      "visual_cue": "表面油亮，焦香扑鼻"
    },
    {
      "n": 8,
      "text": "出炉静置五分钟再切块。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置让肉汁回吸，切开才不干。，火候要稳，别忽大忽小。",
      "visual_cue": "切面多汁，酱色漂亮"
    }
  ],
  "tips": [
    "酱分次刷，颜色才层层上。，这一点很关键。",
    "蜂蜜最后刷，早刷会烤糊。，这一点很关键。",
    "出炉静置再切，肉汁不流失。，这一点很关键。"
  ],
  "common_mistakes": [
    "一开始就刷酱，表面发黑。，这一点很关键。",
    "烤太久，鸡腿肉发干。，这一点很关键。",
    "不翻面，一面焦一面生。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "800 克:800 克",
      "note": "烤的时间减八分钟。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "25 克:25 克",
      "note": "光泽稍差，需多加白醋五毫升。"
    }
  ],
  "variations": [
    "加烟熏辣椒粉，香气更足。，这一点很关键。",
    "用炭火烤，焦香更浓。，这一点很关键。"
  ],
  "serving_suggestion": "配卷心菜沙拉和玉米面包。，这一点很关键。",
  "storage": "冷藏两天，复烤五分钟。，这一点很关键。",
