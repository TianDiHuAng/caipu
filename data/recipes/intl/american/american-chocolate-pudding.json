      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 600,
          "unit": "ml",
          "note": "全脂牛奶",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 100,
          "unit": "g",
          "note": "只取蛋黄",
          "optional": false
        },
        {
          "name": "黑巧克力",
          "name_en": "dark chocolate",
          "amount": 120,
          "unit": "g",
          "note": "黑巧克力切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 70,
          "unit": "g",
          "note": "分次加入",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 25,
          "unit": "g",
          "note": "增稠",
          "optional": false
        },
        {
          "name": "可可粉",
          "name_en": "cocoa powder",
          "amount": 20,
          "unit": "g",
          "note": "加深风味",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "最后加入",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "奶锅",
    "打蛋器",
    "小碗",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛋黄加白糖搅到颜色变浅，筛入玉米淀粉与可可粉拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先拌成顺滑的蛋黄糊，等下冲牛奶才不会结块。",
      "visual_cue": "糊体深褐色顺滑，挑起能缓缓流下"
    },
    {
      "n": 2,
      "text": "牛奶倒进厚底奶锅，小火加热到锅边冒出细小气泡。",
      "time_min": 5,
      "heat": "小火",
      "tip": "不要煮沸，边缘起泡就够了，沸了会烫坏蛋黄。",
      "visual_cue": "锅边聚集一圈细泡，表面微微冒气"
    },
    {
      "n": 3,
      "text": "把热牛奶一点点淋进蛋黄糊里，一边倒一边不停搅动。",
      "time_min": 4,
      "heat": "无火",
      "tip": "一次倒太多蛋黄会被烫熟，只能细流慢加。",
      "visual_cue": "混合液颜色均匀，没有白色蛋花"
    },
    {
      "n": 4,
      "text": "倒回奶锅，小火边加热边搅，直到液体变稠冒大泡。",
      "time_min": 8,
      "heat": "小火",
      "tip": "一定要刮到锅底防止糊底，稠了再煮半分钟。",
      "visual_cue": "布丁糊能挂住打蛋器，划痕缓慢合拢"
    },
    {
      "n": 5,
      "text": "离火加入黑巧克力与黄油，搅到完全融化无颗粒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "利用余温融化就够，再加热会让巧克力出油。",
      "visual_cue": "糊体油亮细滑，颜色均匀发黑"
    },
    {
      "n": 6,
      "text": "加一小撮盐搅匀，尝一下甜度再按需要补一点糖。",
      "time_min": 2,
      "heat": "无火",
      "tip": "一点盐能把巧克力的苦香提出来，千万别省略。",
      "visual_cue": "味道圆润不寡淡，回口有可可香"
    },
    {
      "n": 7,
      "text": "装进小杯，表面贴保鲜膜，冷藏至少两小时到完全凝固。",
      "time_min": 120,
      "heat": "无火",
      "tip": "保鲜膜要贴住表面，不然会结出一层硬皮。",
      "visual_cue": "布丁完全凝固，晃动杯子只有极轻微的颤动"
    }
  ],
  "tips": [
    "用百分之七十的黑巧克力，苦甜更平衡。",
    "表面挤一团打发的淡奶油，口感会更轻盈。",
    "冷藏一夜风味更浓，巧克力的香气也更沉。",
    "装杯之前过一遍细筛，质地会更细腻。"
  ],
  "common_mistakes": [
    "牛奶煮沸后直接冲蛋黄，整锅变成蛋花汤。",
    "加热时没有刮到锅底，一股焦味毁掉整锅。",
    "表面没有贴膜，冷藏后结出厚厚一层硬皮。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "600毫升:400毫升加200毫升牛奶",
      "note": "更浓稠，热量也更高。"
    },
    {
      "original": "黑巧克力",
      "substitute": "可可粉",
      "ratio": "120克:60克",
      "note": "风味更苦，糖要多加二十克。"
    }
  ],
  "variations": [
    "加一勺速溶咖啡粉，巧克力的苦香更立体。",
    "表面撒一层粗海盐，甜咸对比会更明显。"
  ],
  "serving_suggestion": "冷藏后直接吃，配一球香草冰淇淋可以做成冷热双拼。",
  "storage": "冷藏密封可以放三天，表面贴膜能防止结皮。",
