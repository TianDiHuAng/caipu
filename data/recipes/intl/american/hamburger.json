  "equipment": [
    "铸铁锅",
    "锅铲",
    "厨房纸",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉末分成两份轻轻团成球，中间按出一个浅窝，不要反复揉压。",
      "time_min": 8,
      "heat": "无火",
      "tip": "轻团不压实，口感才松。",
      "visual_cue": "肉饼成型、中间微凹"
    },
    {
      "n": 2,
      "text": "肉饼两面撒盐与黑胡椒，静置五分钟让调味渗进表层。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐别提前太久撒，会出水。",
      "visual_cue": "表面调料覆盖均匀、肉饼略回温"
    },
    {
      "n": 3,
      "text": "铸铁锅烧到冒烟，肉饼下锅不要压，中大火煎三分钟形成焦壳。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "别用铲子压，肉汁会全流失。",
      "visual_cue": "底面焦褐、边缘出油"
    },
    {
      "n": 4,
      "text": "翻面再煎两分钟，铺上芝士片转小火盖盖焖一分钟至融化。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盖盖让芝士借蒸汽融化。",
      "visual_cue": "芝士融化、肉饼回弹"
    },
    {
      "n": 5,
      "text": "面包切面对着干锅烘香，取出抹黄油与番茄酱各一层。",
      "time_min": 2,
      "heat": "小火",
      "tip": "面包烘过才不吸肉汁。",
      "visual_cue": "切面金黄、抹酱均匀"
    },
    {
      "n": 6,
      "text": "面包底依次放生菜、肉饼、番茄片、洋葱圈与酸黄瓜，盖顶压紧。",
      "time_min": 3,
      "heat": "无火",
      "tip": "生菜垫底隔开肉汁，面包不塌。",
      "visual_cue": "层次分明、轻压不散"
    }
  ],
  "tips": [
    "肉饼下锅后千万别用铲子压，压一次汁水就跑一半。",
    "面包切面先烘再抹酱，能挡住肉汁不塌软。",
    "牛肉末选肥瘦相间的部位，太瘦的肉饼煎后干得像鞋底。"
  ],
  "common_mistakes": [
    "肉饼反复揉压上劲，煎完又硬又紧。",
    "大火煎太久又没有盖盖，芝士没化肉已发柴。",
    "生菜直接贴面包放，肉汁一浸整只面包塌陷。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "猪肉末",
      "ratio": "300g 对 300g",
      "note": "需多煎一分钟，中心要全熟。"
    },
    {
      "original": "芝士片",
      "substitute": "马苏里拉",
      "ratio": "40g 对 50g",
      "note": "拉丝更明显。"
    }
  ],
  "variations": [
    "双层版：肉饼加厚到 200g，煎制时间加两分钟。",
    "蘑菇版：用 100g 炒香的蘑菇片替换一半生菜。"
  ],
  "serving_suggestion": "配炸薯条与冰可乐，用烘焙纸包住下半部方便拿取。",
  "storage": "肉饼冷藏可存 1 天，面包与蔬菜须分开存放，复热用平底锅。",
