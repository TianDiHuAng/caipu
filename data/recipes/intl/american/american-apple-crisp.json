        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "碗",
    "刀",
    "砧板",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苹果削皮去核，切成一厘米厚的大片摊开备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "苹果切厚片烤完才有果肉感，薄片会烂成泥。",
      "visual_cue": "果片厚薄均匀，切口平整"
    },
    {
      "n": 2,
      "text": "果片拌上红糖、白糖和肉桂，静置十分钟出水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "糖腌出汁是酥层湿润好喝的关键。",
      "visual_cue": "果片发亮，盆底见糖汁"
    },
    {
      "n": 3,
      "text": "面粉、燕麦和盐混匀，搓进冷黄油成粗颗粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，搓出来才是松散粗粒不是面糊。",
      "visual_cue": "酥粒松散成粗糙小颗粒"
    },
    {
      "n": 4,
      "text": "苹果连汁倒进烤盘，表面铺满酥粒轻轻压实。",
      "time_min": 5,
      "heat": "无火",
      "tip": "酥粒铺满但别压太实，烤过才蓬松起脆。",
      "visual_cue": "酥层均匀盖住果片"
    },
    {
      "n": 5,
      "text": "烤箱一百八十度烤三十五分钟，表面金黄冒泡即可。",
      "time_min": 35,
      "heat": "中火",
      "tip": "烤到边缘冒泡才是果肉软透的信号。",
      "visual_cue": "表层焦金，果汁冒泡"
    }
  ],
  "tips": [
    "黄油一定要冷藏状态搓入，酥粒才松散。",
    "苹果选脆甜的品种，酸度高烤完更清爽。",
    "放凉五分钟再切，果肉定形不塌陷。"
  ],
  "common_mistakes": [
    "黄油软化成糊再拌面粉，烤完油腻不脆。",
    "苹果切得太薄，烤完全化成泥没有咬感。",
    "糖腌好的果汁倒掉，成品干硬不润。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "梨",
      "ratio": "800 克:800 克",
      "note": "甜度更高，白糖减到十五克。"
    },
    {
      "original": "燕麦",
      "substitute": "面包糠",
      "ratio": "60 克:60 克",
      "note": "脆感更明显，烤制时间缩短五分钟。"
    }
  ],
  "variations": [
    "加一小把蔓越莓干，酸甜层次更丰富。",
    "酥粒里拌少许肉桂，香气更浓更像节日版。"
  ],
  "serving_suggestion": "温热时配一勺香草冰淇淋，冷热交替最好吃。",
  "storage": "冷藏密封可放三天，食用前复烤十分钟回脆。",
