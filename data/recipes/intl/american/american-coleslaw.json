  "steps": [
    {
      "n": 1,
      "text": "卷心菜去掉硬芯，切成两三毫米宽的细丝装进大碗。",
      "time_min": 10,
      "heat": "无火",
      "tip": "硬芯一定切掉，否则咬起来又硬又涩。",
      "visual_cue": "菜丝细匀，无硬块"
    },
    {
      "n": 2,
      "text": "胡萝卜去皮切成细丝，长度尽量和菜丝保持一致。",
      "time_min": 5,
      "heat": "无火",
      "tip": "胡萝卜丝切细些，拌好才不扎口。",
      "visual_cue": "胡萝卜丝细长均匀"
    },
    {
      "n": 3,
      "text": "菜丝撒盐抓匀静置十分钟，出水后用力挤干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "挤干水是关键，不然拌好会出一碗汤。",
      "visual_cue": "菜丝干爽，抓起来不滴水"
    },
    {
      "n": 4,
      "text": "把蛋黄酱、白醋、白糖和黑胡椒搅匀成沙拉酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "白糖先和白醋拌化，酱汁才不沙口。",
      "visual_cue": "酱汁顺滑，酸甜平衡"
    },
    {
      "n": 5,
      "text": "把菜丝和胡萝卜丝倒入酱汁，翻拌到均匀裹满即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌好冷藏二十分钟再吃，味道更融合。",
      "visual_cue": "菜丝油亮，酱裹均匀"
    }
  ],
  "tips": [
    "卷心菜丝撒盐杀水再挤干，成品不出汤。",
    "沙拉酱先调匀再拌菜，味道更均匀。",
    "拌好冷藏半小时，风味融合更好吃。"
  ],
  "common_mistakes": [
    "菜丝不挤水直接拌，半小时出一盘汤。",
    "硬芯不切掉，嚼起来又硬又涩难以下咽。",
    "卷心菜硬芯不切掉，嚼起来又硬又涩口。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "100 克:100 克",
      "note": "更清爽低脂，白糖减至十克。"
    },
    {
      "original": "卷心菜",
      "substitute": "紫甘蓝",
      "ratio": "500 克:500 克",
      "note": "颜色更艳，口感更脆。"
    }
  ],
  "variations": [
    "加一勺芹菜籽，风味更有美式快餐味。",
    "撒一把葡萄干，甜酸口感更讨喜。"
  ],
  "serving_suggestion": "冷藏后当配菜，配炸鸡、汉堡或烤肉都合适。",
  "storage": "冷藏两天，食用前翻拌，勿久置出水。",
