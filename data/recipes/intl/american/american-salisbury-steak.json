  "steps": [
    {
      "n": 1,
      "text": "面包糠用牛奶泡软，静置五分钟备用。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡软的面包糠让肉饼更嫩。，注意火候。",
      "visual_cue": "面包糠吸饱奶，能捏成团"
    },
    {
      "n": 2,
      "text": "牛肉末加鸡蛋、盐和黑胡椒抓匀上劲。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "顺一个方向搅，肉饼才不散。，注意火候。",
      "visual_cue": "肉馅发黏，能拉丝，状态稳定"
    },
    {
      "n": 3,
      "text": "拌入泡好的面包糠和一半洋葱碎。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "洋葱留一半做汁，香气才分层。，注意火候。",
      "visual_cue": "馅料均匀，略带湿润，状态稳定"
    },
    {
      "n": 4,
      "text": "分成三份，压成两厘米厚的椭圆饼。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "中间压个凹，煎时不易鼓。，注意火候。",
      "visual_cue": "肉饼厚薄一致，边缘光滑"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油，中火煎肉饼每面四分钟。这一步不要着急。",
      "time_min": 9,
      "heat": "中火",
      "tip": "别频繁翻，一面定型再翻。，注意火候。",
      "visual_cue": "两面深褐，按压有弹性"
    },
    {
      "n": 6,
      "text": "盛出肉饼，锅里下剩余洋葱碎和蘑菇片炒软。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蘑菇炒到出水再收干，香味才浓。，注意火候。",
      "visual_cue": "蘑菇软塌，锅底有褐色物"
    },
    {
      "n": 7,
      "text": "撒面粉炒匀，倒清水煮开成浓汁。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "面粉炒散，汁才不结块。，注意火候。",
      "visual_cue": "汤汁浓稠，无干粉，状态稳定"
    },
    {
      "n": 8,
      "text": "加生抽和蚝油调味，放回肉饼小火煮八分钟。这一步不要着急。",
      "time_min": 9,
      "heat": "小火",
      "tip": "小火煮，肉饼才吸足汁。，注意火候。",
      "visual_cue": "肉饼鼓起，汤汁包裹，状态稳定"
    }
  ],
  "tips": [
    "面包糠用牛奶泡软，肉饼才嫩。，值得留意。",
    "肉馅顺一个方向搅，煎的时候才不散。，值得留意。",
    "汤汁里的蘑菇要炒透，香味才够。，值得留意。"
  ],
  "common_mistakes": [
    "肉饼反复翻动，煎散了。，值得留意。",
    "面粉没炒开，汁里全是疙瘩。，值得留意。",
    "火太大，外焦里生。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "猪肉末",
      "ratio": "500 克:500 克",
      "note": "更嫩，煎的时间缩短一分钟。"
    },
    {
      "original": "蘑菇",
      "substitute": "香菇",
      "ratio": "150 克:150 克",
      "note": "香气更重，切片要薄。"
    }
  ],
  "variations": [
    "加一勺番茄膏，汁色更红亮。，值得留意。",
    "配土豆泥一起上桌，更像美式家常。，值得留意。"
  ],
  "serving_suggestion": "浇上蘑菇汁，配土豆泥或米饭。，效果更稳定。",
  "storage": "冷藏两天，复热加少量水盖盖焖五分钟。，效果更稳定。",
