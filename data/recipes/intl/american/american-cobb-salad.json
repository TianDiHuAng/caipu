  "equipment": [
    "平底锅",
    "沙拉碗",
    "小密封罐",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉撒盐和黑胡椒，平底锅中火两面各煎四分钟至全熟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "拍松后再煎受热更均匀，中心不会发柴。",
      "visual_cue": "表面金黄、按压回弹不渗血水"
    },
    {
      "n": 2,
      "text": "煎好的鸡胸静置五分钟再切成手指粗的条状。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置能让肉汁收住，切的时候不流失。",
      "visual_cue": "切面湿润有光泽、肉质紧实"
    },
    {
      "n": 3,
      "text": "培根用小火煎到出油变脆，捞出用厨房纸吸走多余油脂。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火慢煎才能脆而不糊，锅里不用另外放油。",
      "visual_cue": "培根卷曲变深、敲击有脆响"
    },
    {
      "n": 4,
      "text": "鸡蛋冷水下锅煮八分钟，过冷水后剥壳切成四角。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煮好立刻过冷水，蛋黄边缘才不会发灰。",
      "visual_cue": "蛋白凝固、蛋黄中心微润"
    },
    {
      "n": 5,
      "text": "第戎芥末、红酒醋、盐和黑胡椒装罐摇匀，再分次加橄榄油乳化。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油要一点点加，摇到汁液变稠才挂得住菜叶。",
      "visual_cue": "沙拉汁浓稠发亮、不分层"
    },
    {
      "n": 6,
      "text": "生菜铺底，把鸡肉、培根、鸡蛋、牛油果和樱桃番茄按颜色分区摆放。",
      "time_min": 6,
      "heat": "无火",
      "tip": "分区摆盘是科布沙拉的规矩，吃前再淋汁拌开。",
      "visual_cue": "各色食材排成整齐条带、菜叶清爽"
    },
    {
      "n": 7,
      "text": "淋上沙拉汁，撒帕玛森芝士，上桌前轻轻拌开即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁最后淋，提前拌会让生菜出水塌下来。",
      "visual_cue": "菜叶裹薄汁、芝士碎均匀分布"
    }
  ],
  "tips": [
    "牛油果切开后拌一点柠檬汁，颜色不会发黑。",
    "鸡肉换成烤虾或烤三文鱼，就是常见的海鲜版本。",
    "沙拉汁可以提前一晚调好冷藏，第二天省事很多。"
  ],
  "common_mistakes": [
    "生菜洗完没甩干，盘底积一层水把沙拉汁冲淡。",
    "培根用大火煎，外面焦了里面还软。",
    "所有食材提前拌在一起，上桌时菜叶已经软塌出水。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "200g 对 220g",
      "note": "鸡腿更嫩，煎的时间各延长一分钟。"
    },
    {
      "original": "红酒醋",
      "substitute": "柠檬汁",
      "ratio": "15ml 对 12ml",
      "note": "酸味更清爽，适合配海鲜版本。"
    }
  ],
  "variations": [
    "加入玉米粒与黑豆，做成更饱腹的加州风版本。",
    "把所有食材切成小块拌成卷饼馅，做成科布沙拉卷。"
  ],
  "serving_suggestion": "用宽口浅盘分区摆盘，配烤面包片当正餐沙拉。",
  "storage": "食材分开冷藏，沙拉汁单独存放，两天内吃完。",
