  "equipment": [
    "平底锅",
    "压泥器",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐切块放进铺了纱布的筛子里，压上重物静置二十分钟，挤出多余水分。",
      "time_min": 22,
      "heat": "无火",
      "tip": "压到豆腐重量明显变轻才够干，这一步千万别省。",
      "visual_cue": "豆腐紧实，捏不出水，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "洋葱切成细末，蒜切末，平底锅放十毫升植物油，把洋葱末炒三分钟至软。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱先炒过更甜，也去掉生辣，火候和顺序都要留神。",
      "visual_cue": "洋葱透明，香味散出，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "大碗里把豆腐压成泥，加鸡蛋、面粉、生抽、盐和黑胡椒，拌到成团。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌到能捏成团不散，太湿就补面粉，提前把配料备好再动手更稳。",
      "visual_cue": "面糊黏稠，能成团，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "拌好的面糊冷藏十分钟，取出分成三份，捏成两厘米厚、直径十厘米的圆饼。",
      "time_min": 12,
      "heat": "无火",
      "tip": "手上沾水再捏，饼面光滑不粘，这一步千万别省。",
      "visual_cue": "饼形圆整，厚薄一致，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "平底锅放剩余植物油中火烧热，放入豆腐饼煎四分钟，底面金黄后翻面再煎四分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "定型前别动，翻面一次就够，火候和顺序都要留神。",
      "visual_cue": "两面金黄，边缘挺立，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "刷上番茄酱再煎一分钟让酱汁挂住，装盘配酸黄瓜片和番茄片。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酱汁最后刷，糖分才不会烧焦，提前把配料备好再动手更稳。",
      "visual_cue": "表面亮红，酱汁微焦，颜色和形态变化明显"
    }
  ],
  "tips": [
    "豆腐压水一定要到位，用重物压二十分钟，水分不挤干煎时必散。",
    "面糊拌好后冷藏十分钟再捏，蛋白质收紧，煎的时候更成型。",
    "两面定型再翻面，中途不要反复挪动，否则饼边先碎。"
  ],
  "common_mistakes": [
    "豆腐没压水就和面粉混，饼下锅就塌成一摊糊，铲都铲不起来。",
    "火太大下锅，外面瞬间焦黑，里面还是凉的豆腐泥。",
    "番茄酱一开始就刷，糖分烧焦发苦，把豆香全盖住。"
  ],
  "substitutions": [
    {
      "original": "老豆腐",
      "substitute": "豆干",
      "ratio": "400克:350克",
      "note": "豆干更紧实，面粉可减到四十克。"
    },
    {
      "original": "鸡蛋",
      "substitute": "淀粉",
      "ratio": "60克:40克",
      "note": "纯素版本，粘合度略弱，煎时火要更小。"
    }
  ],
  "variations": [
    "把汉堡排夹进面包，配生菜和番茄片，就是完整的美式素汉堡。",
    "刷一层烧烤酱再进烤箱烤五分钟，表面焦糖化，风味更浓。"
  ],
  "serving_suggestion": "配腌酸黄瓜和番茄片，或者夹进面包做成汉堡，佐一杯冰可乐。",
  "storage": "冷藏可放两天，回热用平底锅小火干煎三分钟，微波会让饼身发硬。",
