  "equipment": [
    "炒锅",
    "汤锅",
    "漏勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "四季豆掐掉两头顺便撕去两侧的老筋，洗净后掰成五厘米左右的段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "两侧的筋不撕掉，吃的时候会拖出一根粗纤维。",
      "visual_cue": "豆段两头断面平整无筋丝"
    },
    {
      "n": 2,
      "text": "汤锅烧开大半锅水，加一小撮盐，把四季豆下锅焯三分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水里先加盐能让豆子保住翠绿，不加会发黄发灰。",
      "visual_cue": "豆身转成深绿，浮在水面打转"
    },
    {
      "n": 3,
      "text": "捞出的四季豆立刻放进凉水里过一遍，彻底降温后沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过凉能锁住脆度，捞起就放着会继续变软变黄。",
      "visual_cue": "豆段摸起来冰凉，掰开断面清脆"
    },
    {
      "n": 4,
      "text": "炒锅小火烧热植物油，下杏仁片慢慢煸到边缘泛金，盛出备用。",
      "time_min": 4,
      "heat": "小火",
      "tip": "杏仁片薄，火一大几秒就发黑发苦，务必全程小火。",
      "visual_cue": "杏仁片卷边，锅里有坚果香"
    },
    {
      "n": 5,
      "text": "锅里放黄油与蒜片炒出香味，倒入沥干的四季豆大火快速翻炒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "豆子下锅前要沥干，带水下锅只会溅油不挂香。",
      "visual_cue": "蒜片微黄，豆段表面裹上油光"
    },
    {
      "n": 6,
      "text": "撒盐与黑胡椒翻匀，关火后把杏仁片撒回锅里拌匀即可上桌。",
      "time_min": 2,
      "heat": "小火",
      "tip": "杏仁片最后放才保持脆口，早放会吸潮变软。",
      "visual_cue": "咸淡合适，豆身翠绿不塌"
    }
  ],
  "tips": [
    "四季豆选细一点的，粗的豆荚纤维多，焯水时间要加一分钟。",
    "焯完的凉水可以加几块冰，豆子会更脆更绿。",
    "黄油换成橄榄油就是更清爽的素食版本。",
    "多煸一点杏仁片备着，撒在别的蔬菜上同样好吃。"
  ],
  "common_mistakes": [
    "四季豆只炒不焯，外面焦了里面还是生的，嚼起来发硬。",
    "杏仁片用中火爆香，一转身就全糊成黑色。",
    "豆子焯完不过凉水，上桌时已经软塌塌发黄。",
    "黄油烧到冒烟才下蒜，蒜片瞬间焦掉带苦味。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "核桃仁",
      "ratio": "50 克:50 克",
      "note": "掰成小块，煸的时间缩短一分钟。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "25 克:20 毫升",
      "note": "香气更清淡，适合配油腻的主菜。"
    }
  ],
  "variations": [
    "最后撒一层帕玛森芝士碎，味道会更厚重。",
    "加一小勺柠檬皮屑同炒，豆香里带一点清亮的酸气。"
  ],
  "serving_suggestion": "装进长方形浅盘，把杏仁片均匀撒在表面，配牛排或烤鸡都合适，冷的也好吃。",
  "storage": "冷藏可存两天，复热用平底锅小火干炒两分钟，别用微波炉，豆子会出水变软。",
