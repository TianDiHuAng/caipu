          "name_en": "yeast",
          "amount": 6,
          "unit": "g",
          "note": "发面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "烤箱",
    "烤盘",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶加热到温热不烫手，加酵母和一小勺白糖搅匀静置五分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水温摸着温热就好，太烫会把酵母烫死。",
      "visual_cue": "表面起泡，酵母活化，状态稳定"
    },
    {
      "n": 2,
      "text": "面粉加剩余白糖和盐混匀，倒入酵母牛奶揉成粗糙面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "先揉到没有干粉，再加黄油才好吸收。",
      "visual_cue": "面团粗糙，无干粉，状态稳定"
    },
    {
      "n": 3,
      "text": "加入一半黄油继续揉到光滑能拉出薄膜，盖布发酵一小时。",
      "time_min": 62,
      "heat": "无火",
      "tip": "揉出膜面团才松软，发酵到两倍大再停。",
      "visual_cue": "面团光滑，体积变大，状态稳定"
    },
    {
      "n": 4,
      "text": "剩余黄油软化后和肉桂、两勺白糖拌成均匀的夹层馅料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌成能抹开的糊状，卷的时候才不会漏。",
      "visual_cue": "馅料细腻，香气浓，状态稳定"
    },
    {
      "n": 5,
      "text": "发好的面团擀成半厘米厚的长方片，抹上肉桂馅料。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边缘留出一厘米空白，卷起时馅才不会挤出来。",
      "visual_cue": "面片均匀，馅料抹平，状态稳定"
    },
    {
      "n": 6,
      "text": "从长边卷起成圆柱，切成八段摆在铺纸的烤盘上。",
      "time_min": 8,
      "heat": "无火",
      "tip": "用棉线勒断比刀切更不易压扁面卷。，注意火候。",
      "visual_cue": "面卷整齐，切面朝上，状态稳定"
    },
    {
      "n": 7,
      "text": "盖布二次发酵三十分钟，烤箱预热一百八十度。",
      "time_min": 32,
      "heat": "-",
      "tip": "二次发酵到明显变大，烤出来才蓬松。",
      "visual_cue": "面卷膨胀，间隙变小，状态稳定"
    },
    {
      "n": 8,
      "text": "送入烤箱烤二十二分钟到表面金黄，出炉刷少许黄油。",
      "time_min": 24,
      "heat": "-",
      "tip": "上色后盖锡纸，避免表面烤过头。，注意火候。",
      "visual_cue": "表面金黄，香气散出，状态稳定"
    }
  ],
  "tips": [
    "酵母用温牛奶化开，太烫会把它烫死。，值得留意。",
    "面团揉出薄膜，烤出来的卷才松软。，值得留意。",
    "出炉趁热刷黄油，表皮不会发硬。，值得留意。"
  ],
  "common_mistakes": [
    "牛奶太烫就加酵母，面团发不起来。，务必避免。",
    "馅料抹太厚，卷的时候全挤到外面。，务必避免。",
    "发酵不足就进烤箱，成品硬得像馒头。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "200 毫升:190 毫升",
      "note": "口感略清淡，黄油可加十克。"
    },
    {
      "original": "肉桂",
      "substitute": "可可粉",
      "ratio": "8 克:10 克",
      "note": "换成巧克力风味，颜色更深。"
    }
  ],
  "variations": [
    "表面淋奶油奶酪糖霜，更接近美式店售版。",
    "夹层加葡萄干，口感更丰富。，也很受欢迎。"
  ],
  "serving_suggestion": "温热时配一杯黑咖啡，甜味被苦味一压刚好。",
  "storage": "密封常温两天，冷藏五天，复热微波二十秒。",
