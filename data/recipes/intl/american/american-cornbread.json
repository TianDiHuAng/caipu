  "equipment": [
    "烤箱",
    "烤盘",
    "打蛋器",
    "碗",
    "刮刀",
    "牙签"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到二百一十度，把黄油放进烤盘送入烤箱融化，取出后晃动铺满盘底。",
      "time_min": 8,
      "heat": "无火",
      "tip": "烤盘先烤热再倒面糊，边缘能烤出焦脆的酥壳。",
      "visual_cue": "黄油完全化开，盘底反光并冒细泡"
    },
    {
      "n": 2,
      "text": "玉米面、面粉、白糖、泡打粉和盐放进大碗，用打蛋器拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉类先混匀再进液体，泡打粉分布不均会膨发不齐。",
      "visual_cue": "粉料颜色一致，看不到结块"
    },
    {
      "n": 3,
      "text": "牛奶、鸡蛋和剩下的融化黄油搅匀，倒进粉料里翻拌到刚好看不见干粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌到无干粉就停，过度搅拌会让组织紧实发硬。",
      "visual_cue": "面糊粗糙但无干粉颗粒，能缓慢流动"
    },
    {
      "n": 4,
      "text": "面糊倒进热烤盘抹平，送入烤箱烤约二十到二十五分钟至表面金黄。",
      "time_min": 22,
      "heat": "无火",
      "tip": "盘底有黄油会让边缘滋滋作响，这是正常现象。",
      "visual_cue": "表面呈金褐色，中心轻按回弹"
    },
    {
      "n": 5,
      "text": "取出用牙签插入中心，拔出无湿面糊即可，放凉十分钟再切块。",
      "time_min": 3,
      "heat": "无火",
      "tip": "热切容易散碎，晾到温热再切块边缘完整。",
      "visual_cue": "切面呈细密蜂窝，黄白相间"
    }
  ],
  "tips": [
    "玉米面与面粉比例约为二比一，质地介于蛋糕与馒头之间。",
    "烤盘预热是形成酥脆边缘的关键，冷盘烤出的面包边缘发软。",
    "南方传统做法几乎不放糖，按口味可把白糖减到二十克。"
  ],
  "common_mistakes": [
    "面糊搅拌过度起筋，成品口感紧实像发糕。",
    "玉米面粗糙未过筛，烤好后有明显硬粒硌牙。",
    "烤盘没预热就倒面糊，边缘不酥且脱模易粘。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "酸奶",
      "ratio": "1:1",
      "note": "酸味与泡打粉反应更好，组织更松软。"
    },
    {
      "original": "玉米面",
      "substitute": "细玉米糁",
      "ratio": "1:1",
      "note": "需提前泡十分钟再拌，口感更粗。"
    }
  ],
  "variations": [
    "面糊里加入切碎的培根与切达奶酪，可做咸味版本配汤吃。"
  ],
  "serving_suggestion": "切块趁热抹黄油，或蘸辣豆子炖菜一起吃。",
  "storage": "密封常温一天，冷冻两周；复热用一百六十度烤八分钟。",
