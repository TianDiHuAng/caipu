        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "刮板",
    "圆模",
    "擀面杖",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶中倒入米醋搅匀，静置十分钟到表面出现细小凝块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "这一步是在自制酸凝乳，让饼干更松软带微酸香。",
      "visual_cue": "牛奶表面起细小絮状凝块、质地变稠"
    },
    {
      "n": 2,
      "text": "面粉、泡打粉、小苏打、盐和白糖一起过筛到盆里，搅两下混匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "膨松剂一定要过筛混匀，否则局部发苦局部不起发。",
      "visual_cue": "粉料颜色均匀细腻、无颗粒结块"
    },
    {
      "n": 3,
      "text": "冷藏黄油丁放入粉中，用指尖快速搓成粗沙状，留少许小指盖大小的块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷、手要快，留几块黄油才能烤出层层片状。",
      "visual_cue": "粉料呈湿沙状、能看到零星黄油小块"
    },
    {
      "n": 4,
      "text": "中间挖坑倒入酸凝乳，用刮板切拌到没有干粉即停，不要揉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌到能成团就停手，多揉十秒就会硬得像石头。",
      "visual_cue": "面团粗糙成团、盆底基本干净"
    },
    {
      "n": 5,
      "text": "面团移到撒了面粉的台面，轻压成两厘米厚的片，对折两次再压平。",
      "time_min": 6,
      "heat": "无火",
      "tip": "对折是制造分层的捷径，压的时候别用力压实。",
      "visual_cue": "面片厚度均匀、边缘见层次"
    },
    {
      "n": 6,
      "text": "圆模压出圆饼排入烤盘，刷一层牛奶，二百一十度烤十八分钟。",
      "time_min": 18,
      "heat": "中大火",
      "tip": "压模要直上直下别扭，扭过边缘封死就不长高了。",
      "visual_cue": "表面金黄、侧面能掰出层"
    }
  ],
  "tips": [
    "黄油和牛奶必须保持冷藏状态，全程手温越低成品越高。",
    "没有圆模可用刀切成方块，边角料收拢轻压再用。",
    "出炉趁热刷一层融化黄油，表皮会更酥亮。"
  ],
  "common_mistakes": [
    "面团反复揉到光滑，烤出来又硬又实，完全没有层次。",
    "黄油搓得太细融进粉里，成品扁平不发。",
    "烤箱温度不够高，饼干摊成薄片不上色。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "180ml 对 180ml",
      "note": "更浓郁，需减少十克黄油。"
    },
    {
      "original": "面粉",
      "substitute": "低筋面粉",
      "ratio": "300g 对 300g",
      "note": "口感更酥，层次略薄。"
    }
  ],
  "variations": [
    "面团表面撒粗盐与干香草，做成咸香开胃的版本。",
    "面团中卷入红糖与黄油调成的甜馅，做成甜味早餐饼干。"
  ],
  "serving_suggestion": "趁热剖开夹黄油与煎蛋，或配肉汁与炸鸡当作美式早餐。",
  "storage": "常温密封两天，冷冻一个月；复热一百八十度烤五分钟恢复酥感。",
