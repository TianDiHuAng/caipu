  "equipment": [
    "烤盘",
    "大碗",
    "小锅",
    "刀",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热两百度，烤盘里放黄油送进去融化。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油融化就取出，别烤焦。，注意火候。",
      "visual_cue": "黄油全化，盘底油亮，状态稳定"
    },
    {
      "n": 2,
      "text": "桃子去皮去核，切成两厘米厚的片。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "熟桃好去皮，切口才整齐。，注意火候。",
      "visual_cue": "果片匀整，汁水清亮，状态稳定"
    },
    {
      "n": 3,
      "text": "桃片加六十克白糖、肉桂粉和柠檬汁拌匀。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌糖静置十分钟会出汁，别太久。，注意火候。",
      "visual_cue": "果片挂糖，表面泛光，状态稳定"
    },
    {
      "n": 4,
      "text": "面粉、剩余白糖、泡打粉和盐拌匀。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "粉类过筛更细，口感更松。，注意火候。",
      "visual_cue": "粉质轻盈，无颗粒，状态稳定"
    },
    {
      "n": 5,
      "text": "倒牛奶和香草精搅成略稠的面糊。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "面糊像浓米糊的稠度最合适。，注意火候。",
      "visual_cue": "面糊能缓慢流下，状态稳定"
    },
    {
      "n": 6,
      "text": "把面糊倒在融化的黄油上，不要搅拌。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "别搅，黄油会自己浮上来形成脆边。，注意火候。",
      "visual_cue": "面糊铺满，黄油在边缘"
    },
    {
      "n": 7,
      "text": "桃片连汁均匀铺在面糊上。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻放别压，面糊才会往上包。，注意火候。",
      "visual_cue": "果片铺满，汁水渗下，状态稳定"
    },
    {
      "n": 8,
      "text": "烤三十五分钟到表面金黄、边缘起泡。这一步不要着急。",
      "time_min": 36,
      "heat": "无火",
      "tip": "边缘冒泡才算烤透。，注意火候。",
      "visual_cue": "表面金黄，果馅沸腾，状态稳定"
    },
    {
      "n": 9,
      "text": "出炉晾十五分钟，趁温热配冰淇淋吃。这一步不要着急。",
      "time_min": 16,
      "heat": "无火",
      "tip": "晾一会果馅才定形，不烫嘴。，注意火候。",
      "visual_cue": "切面成形，果馅浓稠，状态稳定"
    }
  ],
  "tips": [
    "面糊倒在黄油上别搅，边缘才酥。，值得留意。",
    "桃子带汁铺上去，果馅才不干。，值得留意。",
    "出炉晾十五分钟再切，形状才完整。，值得留意。"
  ],
  "common_mistakes": [
    "面糊反复搅拌，烤出来发硬。，值得留意。",
    "桃子没熟，酸甜不足还发涩。，值得留意。",
    "烤的时间不够，中间还是湿面糊。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "桃子",
      "substitute": "苹果",
      "ratio": "700 克:700 克",
      "note": "切薄片，烤的时间加十分钟。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "80 克:70 毫升",
      "note": "更清爽，奶香略减。"
    }
  ],
  "variations": [
    "加一把蓝莓，颜色和酸味更丰富。，值得留意。",
    "表面撒红糖，脆边更明显。，值得留意。"
  ],
  "serving_suggestion": "温热时挖一勺，配香草冰淇淋最经典。，效果更稳定。",
  "storage": "冷藏三天，复热用烤箱一百八十度烤十分钟。",
