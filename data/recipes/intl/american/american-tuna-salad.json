  ],
  "steps": [
    {
      "n": 1,
      "text": "金枪鱼倒出沥干汁水，用叉子压散成小块。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "压散但别压成泥，留点颗粒感。，注意火候。",
      "visual_cue": "鱼肉松散，无大块，状态稳定"
    },
    {
      "n": 2,
      "text": "芹菜切小丁，入开水焯三十秒捞出过凉。这一步不要着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "焯一下去生味，还能保脆。，注意火候。",
      "visual_cue": "芹菜翠绿，口感清脆，状态稳定"
    },
    {
      "n": 3,
      "text": "洋葱切细末，用冷水泡五分钟去辛辣。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡过水，生辣味就不冲了。，注意火候。",
      "visual_cue": "葱末透亮，辛辣减轻，状态稳定"
    },
    {
      "n": 4,
      "text": "把金枪鱼、芹菜和洋葱放进大碗。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先放干的，再放酱才不稀。，注意火候。",
      "visual_cue": "料分层摆放，碗底无水"
    },
    {
      "n": 5,
      "text": "加蛋黄酱、柠檬汁、盐和黑胡椒拌匀。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先拌一半酱，再看稠度补。，注意火候。",
      "visual_cue": "沙拉抱团，酱色均匀，状态稳定"
    },
    {
      "n": 6,
      "text": "加蛋黄酱、柠檬汁、盐和黑胡椒，从底往上拌到抱团。",
      "time_min": 3,
      "heat": "无火",
      "tip": "沥干水，沙拉才不会湿塌。，注意火候。",
      "visual_cue": "叶片挺括，无水珠，状态稳定"
    },
    {
      "n": 7,
      "text": "金枪鱼沙拉堆在生菜上，配小番茄上桌。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "堆高一点更好看，别压平。，注意火候。",
      "visual_cue": "造型立体，颜色清爽，状态稳定"
    }
  ],
  "tips": [
    "金枪鱼压散就好，别压成泥。，值得留意。",
    "芹菜焯过更脆，生味也淡。，值得留意。",
    "沙拉现拌现吃，放久会出水。，值得留意。"
  ],
  "common_mistakes": [
    "罐头汁没沥干，沙拉变成糊。，值得留意。",
    "蛋黄酱放太多，压过鱼肉味。，值得留意。",
    "生菜带水，盘底一汪汁。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "金枪鱼",
      "substitute": "鸡胸肉",
      "ratio": "200 克:200 克",
      "note": "先煮熟撕丝，口感更紧实。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "80 克:80 克",
      "note": "热量更低，酸味更明显。"
    }
  ],
  "variations": [
    "加一勺酸黄瓜碎，酸爽更开胃。，值得留意。",
    "夹进面包做成金枪鱼三明治。，值得留意。"
  ],
  "serving_suggestion": "夹面包、配饼干，或直接当轻食午餐。，效果更稳定。",
  "storage": "冷藏一天，吃前再拌一次。，效果更稳定。",
