        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "打蛋器",
    "大碗",
    "烤盘",
    "油纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油提前从冰箱取出放到室温，用手指按下去能轻松压出坑。",
      "time_min": 15,
      "heat": "无火",
      "tip": "黄油软到能压坑就好，化成液体饼干会摊平。",
      "visual_cue": "黄油柔软，表面留指痕"
    },
    {
      "n": 2,
      "text": "软化的黄油加白糖，用打蛋器打到颜色发白、体积变蓬松。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到发白蓬松，烤出来才酥不硬。，注意火候。",
      "visual_cue": "颜色发白，质地蓬松，状态稳定"
    },
    {
      "n": 3,
      "text": "分两次加入鸡蛋液，每次都搅到完全吸收再加下一次。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液分次加，才不容易出现油水分离。",
      "visual_cue": "面糊顺滑，不见蛋液，状态稳定"
    },
    {
      "n": 4,
      "text": "面粉、小苏打和盐混合过筛，倒进黄油糊里翻拌到无干粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌到刚无干粉就停，多拌几下面团就发硬。",
      "visual_cue": "面团成团，无干粉，状态稳定"
    },
    {
      "n": 5,
      "text": "巧克力切成小碎块拌进面团，冷藏二十分钟让面团定形。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冷藏后烤出的饼干更厚，边缘才不摊太薄。",
      "visual_cue": "面团紧实，巧克力均匀"
    },
    {
      "n": 6,
      "text": "取小块面团搓圆按扁，间隔摆在铺纸烤盘上，互相留空隙。",
      "time_min": 6,
      "heat": "无火",
      "tip": "留出两指宽的间距，烤时摊开才不会粘在一起。",
      "visual_cue": "面团圆饼，间距均匀，状态稳定"
    },
    {
      "n": 7,
      "text": "烤箱预热一百八十度，中层烤十二分钟到边缘上色中间还软。",
      "time_min": 12,
      "heat": "-",
      "tip": "边缘上色就出炉，中间软是正常的，余温会继续熟。",
      "visual_cue": "边缘金黄，中心微软，状态稳定"
    },
    {
      "n": 8,
      "text": "出炉在烤盘上放五分钟定型，再移到架子上彻底放凉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "直接在盘上放凉，底部才不会被热气闷软。",
      "visual_cue": "饼干挺括，底部干爽，状态稳定"
    }
  ],
  "tips": [
    "黄油软化到能压坑，别化成液体再打。，值得留意。",
    "面团冷藏二十分钟，饼干更厚不摊薄。，值得留意。",
    "边缘上色就出炉，中间软是正常状态。，值得留意。"
  ],
  "common_mistakes": [
    "黄油化成液体，饼干烤完摊成薄片。，务必避免。",
    "面团反复揉拌，成品硬得像石头。，务必避免。",
    "烤到整体深褐才出炉，凉了苦味明显。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "巧克力",
      "substitute": "葡萄干",
      "ratio": "150 克:150 克",
      "note": "甜味更果香，口感更有嚼劲。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "100 克:100 克",
      "note": "焦糖香更浓，饼干颜色更深。"
    }
  ],
  "variations": [
    "表面撒一小撮海盐，咸甜对比更明显。，也很受欢迎。",
    "加一把核桃碎，坚果香更有层次。，也很受欢迎。"
  ],
  "serving_suggestion": "温热时配一杯冰牛奶，是最经典的吃法。，效果更稳定。",
  "storage": "密封常温四天，冷冻可存一个月，回烤三分钟。",
