  "equipment": [
    "不粘锅",
    "打蛋盆",
    "刀",
    "砧板",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进打蛋盆，加牛奶、一半的盐与黑胡椒，用叉子搅到蛋清蛋黄完全融合。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用叉子搅比打蛋器带入的空气少，蛋饼更紧实不易起洞。",
      "visual_cue": "蛋液颜色均匀，表面浮少量细泡"
    },
    {
      "n": 2,
      "text": "不粘锅放一半植物油，中火煎土豆片，两面煎到金黄微软，盛出备用。",
      "time_min": 10,
      "heat": "中火",
      "tip": "土豆片先煎熟，进烤箱后才不会硬芯。",
      "visual_cue": "土豆片边缘金黄，能用筷子轻松扎透"
    },
    {
      "n": 3,
      "text": "锅里补剩下的植物油，下洋葱丁与青椒丁炒两分钟，再加蘑菇片炒到出水收干。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蘑菇的水一定要炒干，否则蛋饼底部会湿软分层。",
      "visual_cue": "蘑菇片体积缩小，锅底无明水"
    },
    {
      "n": 4,
      "text": "把煎好的土豆片铺回锅里摊平，撒剩下的盐，让底料铺满锅底一层。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "底料铺平是关键，蛋液才能均匀铺开不堆边。",
      "visual_cue": "锅底铺满一层，厚度基本一致"
    },
    {
      "n": 5,
      "text": "转小火，把蛋液沿锅边缓缓倒入，转动锅子让蛋液均匀覆盖所有底料。",
      "time_min": 3,
      "heat": "小火",
      "tip": "倒蛋液要慢，速度一快就把底料冲成一堆。",
      "visual_cue": "蛋液布满锅面，边缘开始凝固"
    },
    {
      "n": 6,
      "text": "保持小火盖盖煎六分钟，让表面靠蒸汽慢慢凝固，不翻面也不搅动。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盖盖能让上层凝固，揭开时表面还有一层薄流动就对了。",
      "visual_cue": "表面七成凝固，中心微微晃动"
    },
    {
      "n": 7,
      "text": "表面撒满奶酪丝，连锅放进两百度烤箱烤六分钟，烤到奶酪融化起小泡。",
      "time_min": 6,
      "heat": "中火",
      "tip": "没有烤箱可用锅盖加小火焖，效果接近但表面不会上色。",
      "visual_cue": "奶酪完全融化，边缘微微焦黄"
    },
    {
      "n": 8,
      "text": "出炉静置三分钟，用铲子沿锅边划一圈，滑到案板上切成六块，撒欧芹碎。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置三分钟是让蛋饼内部定型，热切一定会散成碎块，形状全毁。",
      "visual_cue": "切块边缘整齐，奶酪层完整"
    }
  ],
  "tips": [
    "蛋液和配料的比例别超过一比一，料太多蛋饼容易散开。",
    "想更饱可以在底料里加一把炒过的绞碎肉或培根碎。",
    "冷藏的鸡蛋回温后再打，蛋饼更松软，也更易定型。",
    "剩的蛋饼夹面包当三明治，比单吃更有嚼头。"
  ],
  "common_mistakes": [
    "土豆片没煎熟就直接倒蛋液，蛋熟了土豆还是脆硬。",
    "蛋液一次性猛倒，底料被冲成一堆，切面层次全乱。",
    "大火煎到底部发黑，表面却还是流动的生蛋液。"
  ],
  "substitutions": [
    {
      "original": "蘑菇",
      "substitute": "西葫芦",
      "ratio": "100克:120克",
      "note": "切薄片同样炒到出水收干再用。"
    },
    {
      "original": "奶酪",
      "substitute": "帕玛森碎",
      "ratio": "60克:40克",
      "note": "咸味更重，盐量减一克。"
    }
  ],
  "variations": [
    "加一勺辣椒酱与少许孜然粉，做成西南风味的蛋饼。",
    "把土豆换成红薯片，甜味更足，煎制时间延长两分钟。"
  ],
  "serving_suggestion": "切块后配一片烤吐司与一杯黑咖啡，冷吃也不错，适合当便当菜。",
  "storage": "冷藏三天内吃完，复热用平底锅小火两面各煎一分钟，微波会让蛋饼出水发韧。",
