  "equipment": [
    "不粘平底锅",
    "硅胶铲",
    "打蛋器",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "火腿切成半厘米小丁，洋葱与甜椒同样切细，三样分开放好备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "馅料切得越细越好卷，块太大蛋皮一定会裂开。",
      "visual_cue": "三种丁大小均匀，颗粒分明"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油中火烧热，下洋葱与甜椒炒两分钟到出水变软。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蔬菜要先炒掉水分，带水的馅会把蛋皮泡破。",
      "visual_cue": "蔬菜丁变软透亮，锅底没有水"
    },
    {
      "n": 3,
      "text": "放火腿丁同炒一分钟，撒一半盐与黑胡椒调味后盛出摊凉。",
      "time_min": 2,
      "heat": "中火",
      "tip": "馅料必须放凉再卷，滚烫的馅会当场把蛋皮烫穿。",
      "visual_cue": "火腿边缘微卷，馅料不烫手"
    },
    {
      "n": 4,
      "text": "鸡蛋打散加剩下的盐与黑胡椒，用打蛋器搅到蛋清蛋黄完全融合。",
      "time_min": 2,
      "heat": "无火",
      "tip": "搅到看不见蛋清的丝状物，蛋皮才会平整不起泡。",
      "visual_cue": "蛋液颜色均匀，表面有细泡"
    },
    {
      "n": 5,
      "text": "锅里放黄油化开，倒入蛋液转中小火，用铲子把边缘推向中间让蛋液流动。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "边缘往中间推，未熟的部分才会流到锅底受热。",
      "visual_cue": "蛋皮半凝，表面还略带湿润"
    },
    {
      "n": 6,
      "text": "把馅料与切达奶酪铺在蛋皮一侧，对折盖住，再小火焖一分钟定型出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "焖一分钟让切达奶酪化开，蛋皮也不会因为急翻而断。",
      "visual_cue": "切达奶酪渗出边缘，折口粘合"
    }
  ],
  "tips": [
    "鸡蛋从冰箱拿出来先回温十分钟，蛋液更容易摊匀。",
    "锅子用不粘锅最稳，铸铁锅容易让蛋皮粘底。",
    "馅料别贪多，铺满一半就够，多了卷不起来。",
    "想要更嫩可以在蛋液里加一小勺牛奶。"
  ],
  "common_mistakes": [
    "大火煎蛋皮，底下焦了上面还是流动的蛋液。",
    "蔬菜没炒干就卷，吃的时候盘底渗出一滩水。",
    "馅料刚出锅就铺上去，蛋皮被烫出几个破洞。",
    "蛋液没打匀，蛋白结成白块贴在蛋皮上。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "培根",
      "ratio": "80 克:80 克",
      "note": "先煎脆再切丁，咸度更高可少放盐。"
    },
    {
      "original": "切达奶酪",
      "substitute": "马苏里拉",
      "ratio": "40 克:40 克",
      "note": "拉丝更明显，奶味稍淡一些。"
    }
  ],
  "variations": [
    "把火腿换成烟熏三文鱼，就是更精致的版本。",
    "最后淋一勺番茄莎莎酱，酸甜能解掉切达奶酪的腻。"
  ],
  "serving_suggestion": "出锅后对角切成两半，配一片烤吐司和一小把芝麻菜，趁热吃蛋皮最嫩。",
  "storage": "最好现做现吃；冷藏可存一天，复热用平底锅小火两面各热三十秒，微波会让蛋皮发硬。",
