      ]
    }
  ],
  "equipment": [
    "大碗",
    "深锅",
    "漏勺",
    "厨房纸",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁开背去掉黑色肠线，用盐和黑胡椒腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "开背是为了让虾仁受热卷得更漂亮。",
      "visual_cue": "虾仁平展，肠线去净"
    },
    {
      "n": 2,
      "text": "鸡蛋加牛奶打散，调成均匀的蛋液。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液过筛更顺滑，挂糊更匀。，注意火候。",
      "visual_cue": "蛋液均匀，无蛋筋，状态稳定"
    },
    {
      "n": 3,
      "text": "面粉加辣椒粉和少许盐拌匀做裹粉。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "裹粉里加辣，外壳才有味。，注意火候。",
      "visual_cue": "粉料均匀，颜色微红，状态稳定"
    },
    {
      "n": 4,
      "text": "虾仁依次裹面粉、蘸蛋液、滚面包糠。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "三步顺序别乱，壳才挂得住。，注意火候。",
      "visual_cue": "表面裹满，按压不脱落"
    },
    {
      "n": 5,
      "text": "深锅倒植物油，烧到一百七十度。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "温度太低会吸油，太高会外焦。，注意火候。",
      "visual_cue": "油面微动，筷子入锅起泡"
    },
    {
      "n": 6,
      "text": "分批下虾仁，炸两分钟到金黄浮起。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "一次别下太多，油温才不掉。，注意火候。",
      "visual_cue": "外壳金黄，虾仁卷曲，状态稳定"
    },
    {
      "n": 7,
      "text": "捞出放厨房纸上吸掉多余油脂。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吸油，外壳才不软。，注意火候。",
      "visual_cue": "表面干爽，无油滴，状态稳定"
    },
    {
      "n": 8,
      "text": "装盘配柠檬角，挤汁后食用。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬汁解腻又提鲜。，注意火候。",
      "visual_cue": "柠檬翠绿，外壳酥脆，状态稳定"
    }
  ],
  "tips": [
    "油温一百七十度最合适，太低吸油。，值得留意。",
    "面包糠要按压紧实，炸时才不掉。，值得留意。",
    "分批炸，油温才稳。，值得留意。"
  ],
  "common_mistakes": [
    "油温不够，外壳吸满油。，值得留意。",
    "一次下太多虾，粘连成团。，值得留意。",
    "炸过头，虾肉发柴。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鱿鱼圈",
      "ratio": "400 克:400 克",
      "note": "炸的时间缩短三十秒。"
    },
    {
      "original": "面包糠",
      "substitute": "玉米片碎",
      "ratio": "100 克:100 克",
      "note": "更酥脆，颗粒感更明显。"
    }
  ],
  "variations": [
    "裹粉里加蒜粉，香气更浓。，值得留意。",
    "配塔塔酱或番茄酱食用。，值得留意。"
  ],
  "serving_suggestion": "配凉拌卷心菜和薯条，就是美式海鲜拼盘。，效果更稳定。",
  "storage": "冷藏一天，复热用烤箱两百度烤六分钟。，效果更稳定。",
