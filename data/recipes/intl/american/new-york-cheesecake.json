        }
      ]
    }
  ],
  "equipment": [
    "8 寸活底模",
    "电动打蛋器",
    "水浴烤盘",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "消化饼干压成细屑，与 70g 融化黄油拌匀，压实在模具底部，冷藏 20 分钟定型。",
      "time_min": 25,
      "heat": "无火",
      "tip": "用平底杯压紧，饼底才不会散。",
      "visual_cue": "饼底平整紧实、按压不松动"
    },
    {
      "n": 2,
      "text": "奶油奶酪切小块室温软化 30 分钟，加 120g 白糖与 2g 盐打至顺滑无颗粒。",
      "time_min": 12,
      "heat": "无火",
      "tip": "奶酪必须回温，冷的打不散会结块。",
      "visual_cue": "糊体细腻顺滑、刮刀划过无颗粒"
    },
    {
      "n": 3,
      "text": "分三次加入 3 个鸡蛋，每次彻底拌匀后再加下一个，避免油水分离。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一次加一个，慢速搅拌少进气。",
      "visual_cue": "蛋液完全吸收、糊体光亮"
    },
    {
      "n": 4,
      "text": "加入 120g 酸奶油、1 个柠檬的皮屑与 15ml 柠檬汁，筛入 15g 玉米淀粉拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "柠檬皮只刮黄色层，白色部分发苦。",
      "visual_cue": "糊体浓稠可挂刮刀、带柠檬清香"
    },
    {
      "n": 5,
      "text": "模具外包两层锡纸防进水，倒入奶酪糊抹平，放入注有热水的烤盘，150℃ 烤 65 分钟。",
      "time_min": 70,
      "heat": "小火",
      "tip": "水浴能让温度缓和，避免表面开裂。",
      "visual_cue": "边缘定型、中心轻晃有布丁感"
    },
    {
      "n": 6,
      "text": "关火后留在烤箱中焖 30 分钟，取出放凉再冷藏 6 小时脱模切块。",
      "time_min": 30,
      "heat": "无火",
      "tip": "缓慢降温是防塌陷的关键。",
      "visual_cue": "表面平整无裂、切面细腻绵密"
    }
  ],
  "tips": [
    "所有材料提前回温，温度一致才不容易分离。",
    "搅拌全程低速，卷入空气会让蛋糕烤后塌陷。",
    "切块时刀用热水烫过擦干，切面才利落。"
  ],
  "common_mistakes": [
    "奶酪没软化就打，成品里能吃到小颗粒。",
    "烤箱温度过高，表面先结皮后鼓裂成大缝。",
    "烤好立刻出炉，温差过大导致中心塌陷回缩。"
  ],
  "substitutions": [
    {
      "original": "奶油奶酪",
      "substitute": "马斯卡彭",
      "ratio": "500g 对 500g",
      "note": "质地更软，需加 20g 淀粉稳定。"
    },
    {
      "original": "酸奶油",
      "substitute": "原味酸奶",
      "ratio": "120g 对 120g",
      "note": "需选浓稠型，沥去乳清再用。"
    }
  ],
  "variations": [
    "经典纽约版：表面不加水，烤到深色顶面，风味更浓。",
    "莓果版：表面铺 100g 蓝莓同烤，酸甜平衡。"
  ],
  "serving_suggestion": "冷藏后切块，配一勺打发奶油与新鲜莓果。",
  "storage": "冷藏 4 天，冷冻可存 1 个月；冷冻后需冷藏回温再切。",
