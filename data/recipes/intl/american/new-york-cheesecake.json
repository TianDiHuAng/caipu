        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "分次加",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 15,
          "unit": "g",
          "note": "稳定组织",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
