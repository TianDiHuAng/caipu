  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋放进冷水锅里，水开后转中火煮十分钟关火。",
      "time_min": 12,
      "heat": "中火",
      "tip": "鸡蛋冷水下锅慢升温，煮的时候才不裂壳。",
      "visual_cue": "蛋壳完整，一颗不裂"
    },
    {
      "n": 2,
      "text": "捞出鸡蛋立刻浸入冰水里，凉透后剥壳切成小丁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "浸冰水能防止蛋黄发灰，剥壳也更容易。",
      "visual_cue": "蛋黄鲜黄，蛋白光洁"
    },
    {
      "n": 3,
      "text": "芹菜切成很细的小丁，小葱切成细碎葱花备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "芹菜丁切细些，口感才不抢鸡蛋的软。",
      "visual_cue": "芹丁细碎，大小均匀"
    },
    {
      "n": 4,
      "text": "碗里放蛋黄酱、白醋、盐和黑胡椒搅成顺滑酱汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "白醋一点点就够，用来压蛋黄酱的腻。",
      "visual_cue": "酱汁顺滑，酸香清爽"
    },
    {
      "n": 5,
      "text": "倒入鸡蛋丁和芹菜丁，用刮刀翻拌到每块都裹上酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻拌不压，蛋丁保持块状口感才不糊。",
      "visual_cue": "蛋丁完整，酱色均匀"
    }
  ],
  "tips": [
    "鸡蛋冷水下锅慢煮，蛋壳不容易煮裂。",
    "煮好立刻浸冰水，蛋黄才不会发青灰。",
    "芹菜切细丁，口感清爽不抢主角。"
  ],
  "common_mistakes": [
    "鸡蛋沸水下锅，蛋壳裂开蛋白流一锅。",
    "煮好不浸冷水，蛋黄边缘发灰发绿。",
    "用力搅拌成泥，成品糊口没有层次。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "80 克:80 克",
      "note": "更清爽低脂，白醋减至五毫升。"
    },
    {
      "original": "芹菜",
      "substitute": "黄瓜",
      "ratio": "60 克:70 克",
      "note": "需挤掉多余水分再拌。"
    }
  ],
  "variations": [
    "加一小勺芥末酱同拌，味道更立体。",
    "撒少许辣椒粉拌匀，做成微辣版本。"
  ],
  "serving_suggestion": "夹在两片吐司中间做三明治，或配生菜直接吃。",
  "storage": "冷藏一天，食用前拌匀，勿常温久放。",
