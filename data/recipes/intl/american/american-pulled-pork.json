  "equipment": [
    "烤箱",
    "烤盘",
    "锡纸",
    "叉子",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肩肉擦干，用叉子在表面戳十几个小孔。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "戳孔能让腌料渗进去，也更容易撕。，注意火候。",
      "visual_cue": "表面布满小孔，肉质完整"
    },
    {
      "n": 2,
      "text": "红糖、辣椒粉、孜然粉、大蒜末和盐拌成干腌料，用手搓散结块。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖容易结块，用手搓散。，注意火候。",
      "visual_cue": "腌料均匀，无硬块，状态稳定"
    },
    {
      "n": 3,
      "text": "把干腌料抹满整块猪肩肉，撒上黑胡椒，再刷一层植物油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "边角都要抹到，味道才匀。，注意火候。",
      "visual_cue": "表面裹满红棕色腌料，状态稳定"
    },
    {
      "n": 4,
      "text": "用锡纸包两层，冷藏腌两小时以上。这一步不要着急。",
      "time_min": 125,
      "heat": "无火",
      "tip": "腌一夜更入味，时间够就行。，注意火候。",
      "visual_cue": "肉色变深，香气透出，状态稳定"
    },
    {
      "n": 5,
      "text": "烤箱预热一百五十度，连锡纸放烤盘烤三小时。",
      "time_min": 185,
      "heat": "无火",
      "tip": "低温慢烤才嫩，别急着升温。，注意火候。",
      "visual_cue": "锡纸鼓起，汁水积在底部"
    },
    {
      "n": 6,
      "text": "拆开锡纸，肉内部温度达到九十度即可。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "温度计插最厚处，别碰骨头。，注意火候。",
      "visual_cue": "肉块松软，边缘微焦，状态稳定"
    },
    {
      "n": 7,
      "text": "倒出烤盘里的肉汁，撇去浮油留清汤。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "这层汁是味道的核心，别倒掉。，注意火候。",
      "visual_cue": "汁水棕亮，油浮在上，状态稳定"
    },
    {
      "n": 8,
      "text": "肉汁加白醋和番茄膏小火煮五分钟收浓。这一步不要着急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "酸味能解腻，煮到略挂勺。，注意火候。",
      "visual_cue": "汁液浓稠，颜色深红，状态稳定"
    },
    {
      "n": 9,
      "text": "用两把叉子把肉撕成粗丝，拌入酱汁。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "趁热撕最省力，凉了发硬。，注意火候。",
      "visual_cue": "肉丝松散，裹满酱汁，状态稳定"
    }
  ],
  "tips": [
    "低温一百五十度慢烤，肉才软到能撕。，值得留意。",
    "腌一夜比两小时更入味。，值得留意。",
    "撕肉趁热，凉了纤维会回硬。，值得留意。"
  ],
  "common_mistakes": [
    "温度太高，外面焦了里面还柴。，值得留意。",
    "锡纸没包紧，肉烤干成一块。，值得留意。",
    "肉汁全倒掉，成品没味道。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "猪肩肉",
      "substitute": "猪五花肉",
      "ratio": "1000 克:900 克",
      "note": "油脂更多，烤的时间减少二十分钟。"
    },
    {
      "original": "红糖",
      "substitute": "白糖",
      "ratio": "40 克:35 克",
      "note": "上色略浅，甜味更直接。"
    }
  ],
  "variations": [
    "加一勺烟熏汁，风味更像炭烤。，值得留意。",
    "拌入卷心菜丝，做成手撕猪肉三明治。，值得留意。"
  ],
  "serving_suggestion": "夹进圆面包，配一勺凉拌卷心菜，就是美式烧烤摊的招牌组合。",
  "storage": "冷藏三天，冷冻一个月；复热加少量水盖锡纸烤十分钟。",
