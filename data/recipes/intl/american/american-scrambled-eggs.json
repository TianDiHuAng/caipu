  "equipment": [
    "不粘锅",
    "打蛋器",
    "硅胶铲",
    "烤面包机"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打散加牛奶与一半盐，用打蛋器搅到蛋白蛋黄完全融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "要打到看不见蛋白丝，没打匀的蛋液炒出来带白色絮块。",
      "visual_cue": "蛋液均匀淡黄，表面有细泡"
    },
    {
      "n": 2,
      "text": "不粘锅小火化一半黄油，倒入蛋液静置二十秒不动。",
      "time_min": 2,
      "heat": "小火",
      "tip": "锅一定要小火，大火炒蛋十秒就老，吃起来干硬像橡胶。",
      "visual_cue": "蛋液边缘凝固，中心仍流动"
    },
    {
      "n": 3,
      "text": "用硅胶铲从锅边向中心推，慢慢形成大块柔软的蛋凝块。",
      "time_min": 3,
      "heat": "小火",
      "tip": "靠推不靠翻，推出来的蛋块蓬松，翻炒会把蛋炒成碎渣。",
      "visual_cue": "蛋块柔软成堆，表面仍湿润"
    },
    {
      "n": 4,
      "text": "蛋还带一点湿润时离火，拌入剩下的黄油与剩余盐调味。",
      "time_min": 2,
      "heat": "无火",
      "tip": "离火后余温还会继续熟，锅里就炒到全干，上桌已经老了。",
      "visual_cue": "蛋块湿润发亮，不成干粒"
    },
    {
      "n": 5,
      "text": "面包片烤到金黄，炒蛋盛盘撒白胡椒与葱花，配面包上桌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "面包最后烤，先烤好等着会变凉发硬。",
      "visual_cue": "面包金黄酥脆，蛋堆松软"
    }
  ],
  "tips": [
    "美式炒蛋讲究嫩和滑，全程小火是唯一秘诀。",
    "加一勺酸奶油会更浓稠，是美式早午餐店的做法。",
    "配培根和薯饼就是一份标准的美国早餐拼盘。"
  ],
  "common_mistakes": [
    "大火炒蛋，十秒就结硬块，吃起来像橡皮。",
    "蛋液里加太多牛奶，炒出来水汪汪，蛋香被冲淡。",
    "在锅里炒到全熟才起锅，上桌时已经过老发干。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "60毫升:50毫升",
      "note": "奶油版更浓，热量也更高。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "30克:25毫升",
      "note": "橄榄油版风味偏清，嫩度稍差。"
    }
  ],
  "variations": [
    "加一把切达奶酪碎同炒，做成奶酪炒蛋，奶香更足。",
    "放一点烟熏三文鱼同炒，是纽约早午餐的常见搭配。"
  ],
  "serving_suggestion": "蛋堆盛在烤好的面包上，撒葱花与黑胡椒，配一杯橙汁。",
  "storage": "炒蛋建议现做现吃，冷藏后再复热口感会明显变老。",
