      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 500,
          "unit": "g",
          "note": "选老豆腐",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "番茄酱",
          "name_en": "ketchup",
          "amount": 60,
          "unit": "g",
          "note": "做烧烤酱底",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 25,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 20,
          "unit": "g",
