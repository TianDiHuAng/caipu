        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "烤盘",
    "刷子",
    "厨房纸",
    "重物"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成两厘米厚的片，平铺在厨房纸上，上面压重物十五分钟出水。",
      "time_min": 15,
      "heat": "无火",
      "tip": "压水这一步决定成败，水没压干煎的时候溅油，也吸不进酱。",
      "visual_cue": "豆腐变薄发紧，纸面湿透"
    },
    {
      "n": 2,
      "text": "番茄酱、生抽、红糖、辣椒粉、蒜泥与清水搅成烧烤酱备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "红糖容易结块，先和液体搅开再加别的，否则酱里带颗粒。",
      "visual_cue": "酱汁顺滑，颜色砖红烧亮"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油烧热，豆腐片下锅两面各煎三分钟至金黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "下锅后别急着翻，等底面结出硬壳再动，翻早了豆腐会碎。",
      "visual_cue": "两面金黄，边缘微焦起泡"
    },
    {
      "n": 4,
      "text": "把烧烤酱倒进锅里，小火让豆腐两面裹上酱汁并收浓。",
      "time_min": 8,
      "heat": "小火",
      "tip": "酱里有糖，一律小火，大火三分钟就糊锅发苦。",
      "visual_cue": "酱汁收稠挂住豆腐表面"
    },
    {
      "n": 5,
      "text": "豆腐移到烤盘，入烤箱两百度烤五分钟，表面上色后取出撒盐。",
      "time_min": 5,
      "heat": "大火",
      "tip": "烤一下让表面结一层亮壳，比纯煎的更有烧烤的焦香。",
      "visual_cue": "表面酱层发亮，边缘焦褐"
    }
  ],
  "tips": [
    "这是美国南方烧烤的素食版本，用烤酱把豆腐做出肉的焦香。",
    "配凉拌卷心菜和玉米面包，就是一份标准的烧烤拼盘。",
    "豆腐压水后可以先冷冻一夜，解冻再煎，口感更像肉。"
  ],
  "common_mistakes": [
    "豆腐不压水直接煎，锅里油花四溅，豆腐里面还是水汪汪的。",
    "烧烤酱大火收汁，糖瞬间焦化，锅底黑一层，豆腐发苦。",
    "用嫩豆腐做这道菜，一翻就碎，最后炒成一锅豆腐渣。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "豆干",
      "ratio": "500克:400克",
      "note": "豆干更紧实，煎制时间减两分钟。"
    },
    {
      "original": "番茄酱",
      "substitute": "烧烤酱",
      "ratio": "60克:70克",
      "note": "现成烧烤酱含糖高，红糖减半。"
    }
  ],
  "variations": [
    "把豆腐切条穿串再烤，做成烤串版本，更适合聚会。",
    "加一勺烟熏辣椒粉，风味更接近真正的炭火烧烤。"
  ],
  "serving_suggestion": "配烤玉米、凉拌菜丝和一片烤面包，摆成一份烧烤拼盘。",
  "storage": "冷藏可存两天，复热用烤箱一百八十度烤八分钟，勿用微波会变软塌。",
