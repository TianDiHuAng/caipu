    "total_min": 25
  },
  "servings": 3,
  "flavor": [
    "sweet",
    "fragrant",
    "light"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 220,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 260,
          "unit": "ml",
          "note": "或白脱牛奶",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "按配方用量",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "泡打粉",
          "name_en": "baking powder",
          "amount": 8,
          "unit": "g",
          "note": "按配方用量",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 30,
          "unit": "g",
          "note": "按配方用量",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "按配方用量",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 40,
          "unit": "g",
          "note": "融化",
          "optional": false
        },
        {
          "name": "枫糖浆",
          "name_en": "maple syrup",
          "amount": 60,
          "unit": "ml",
          "note": "佐食用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "打蛋器",
    "刮刀",
    "面粉筛"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉、泡打粉、白糖与盐一起过筛到盆里，用打蛋器干拌两下让膨松剂分布均匀，避免局部发苦。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过筛能打散结块，泡打粉分布不匀会出现苦味斑点。",
      "visual_cue": "粉料蓬松，颜色均匀一致"
    },
    {
      "n": 2,
      "text": "牛奶与鸡蛋另碗打散，倒进粉料中，用刮刀切拌到刚刚没有干粉就停手，面糊保留少量小疙瘩。",
      "time_min": 4,
      "heat": "无火",
      "tip": "千万不要搅到顺滑，过度起筋会导致松饼韧而不松。",
      "visual_cue": "面糊浓稠可流动，表面仍有小块干粉"
    },
    {
      "n": 3,
      "text": "融化黄油放凉到不烫手后拌入面糊，盖布静置十分钟，让面粉充分吸水、泡打粉开始起作用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黄油太热会提前激活泡打粉，静置后就发不高了。",
      "visual_cue": "面糊表面冒出细小气泡"
    },
    {
      "n": 4,
      "text": "平底锅中小火预热，用厨房纸抹一层薄油，舀一勺面糊从高处倒下自然摊成圆形，表面出现密集气泡后翻面。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "只在第一锅抹油，后续靠面糊里的黄油就够，油多会煎出脆壳。",
      "visual_cue": "饼面色泽均匀，边缘一圈变哑并冒出气孔"
    },
    {
      "n": 5,
      "text": "翻面再煎约一分半到两面金黄，饼身轻按回弹即出锅，叠放保温，重复煎完所有面糊。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "只在表面气泡破裂后再翻面，翻早了饼会塌陷。",
      "visual_cue": "两面金黄，侧看有明显厚度"
    },
    {
      "n": 6,
      "text": "松饼叠三层装盘，淋上枫糖浆，可点缀一小块黄油与当季水果，趁热食用。",
      "time_min": 1,
      "heat": "无火",
      "tip": "糖浆温热后流动性更好，浇上去更均匀。",
      "visual_cue": "糖浆沿饼边缓缓流下，形成薄亮的一层"
    }
  ],
  "tips": [
    "面糊静置十分钟是松软的关键，来不及也可省略但厚度会略差。",
    "锅温保持中小火，火太大表面焦了内部还夹生。"
  ],
  "common_mistakes": [
    "面糊搅打到完全顺滑无颗粒，成品口感发韧像薄饼。",
    "泡打粉与面粉未混匀，松饼表面出现苦味黄斑。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "白脱牛奶",
      "ratio": "260ml 对 260ml",
      "note": "用白脱牛奶时泡打粉可减至 5g。"
    },
    {
      "original": "枫糖浆",
      "substitute": "蜂蜜",
      "ratio": "60ml 对 60ml",
      "note": "蜂蜜更甜，用量可减三分之一。"
    }
  ],
  "variations": [
    "面糊里拌入蓝莓或巧克力豆，做成风味松饼。",
    "加一小勺肉桂粉，香气更温暖，适合秋冬时节的早餐桌。"
  ],
  "serving_suggestion": "作为早餐主食，配煎蛋与培根组成经典美式早餐盘。",
  "storage": "冷却后密封冷冻，复热用烤箱或烤面包机，微波会让边缘变韧。",
  "nutrition_estimate": {
    "basis": "每份（3 片，约 260g）",
    "calories_kcal": 490,
    "protein_g": 13,
