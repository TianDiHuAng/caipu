  "equipment": [
    "沙拉碗",
    "烤箱",
    "小锅",
    "刨丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "罗马生菜剥成大片，用冰水浸泡十分钟后沥干水分，冷藏备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "冰水泡过的生菜更脆更挺。",
      "visual_cue": "叶片挺括、表面无水"
    },
    {
      "n": 2,
      "text": "面包切成 1.5cm 方丁，拌 10ml 橄榄油、盐与蒜末。",
      "time_min": 5,
      "heat": "无火",
      "tip": "每块都沾到油，烤后才酥。",
      "visual_cue": "面包丁每块均匀裹满橄榄油"
    },
    {
      "n": 3,
      "text": "面包丁铺在烤盘上，180℃ 烤 8 分钟至金黄酥脆。",
      "time_min": 8,
      "heat": "中火",
      "tip": "中途翻一次，受热才均匀。",
      "visual_cue": "四面金黄、捏着发脆"
    },
    {
      "n": 4,
      "text": "鸡蛋冷水下锅煮 8 分钟，取出泡冷水后剥壳取熟蛋黄压碎。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煮足八分钟，蛋黄才够干。",
      "visual_cue": "蛋黄全熟、压成细末"
    },
    {
      "n": 5,
      "text": "熟蛋黄碎加剩余橄榄油、蒜末、黑胡椒与一半帕玛森芝士拌成酱。",
      "time_min": 4,
      "heat": "无火",
      "tip": "边加油边搅，酱才不分离。",
      "visual_cue": "酱体稠滑、颜色乳黄"
    },
    {
      "n": 6,
      "text": "生菜与面包丁淋酱拌匀，撒剩余帕玛森芝士与黑胡椒即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌之前生菜要够干，酱才挂得住。",
      "visual_cue": "叶片裹酱、芝士片片可见"
    }
  ],
  "tips": [
    "生菜冰水泡过再沥干，脆度明显提升。",
    "面包丁先拌油再烤，才会内软外脆。",
    "酱要边倒油边搅，否则容易油水分离。"
  ],
  "common_mistakes": [
    "生菜带着水下酱，盘底很快积出一汪稀汤。",
    "面包丁直接烤不拌油，烤完又硬又干。",
    "酱一次把油全倒进去，搅不开就分层。"
  ],
  "substitutions": [
    {
      "original": "罗马生菜",
      "substitute": "球生菜",
      "ratio": "250g 对 250g",
      "note": "口感更甜，脆度稍弱。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "格拉纳帕达诺",
      "ratio": "40g 对 40g",
      "note": "咸度接近，价格更友好。"
    }
  ],
  "variations": [
    "烤鸡版：加 150g 煎鸡胸肉切片，就是一顿正餐。",
    "蒜香版：面包丁里多加 5g 蒜末，蒜味更冲。"
  ],
  "serving_suggestion": "拌好立刻上桌，配一杯气泡水最解腻。",
  "storage": "酱可冷藏 2 天，生菜与面包丁须现拌现吃。",
