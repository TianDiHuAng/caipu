  "equipment": [
    "刨丝器",
    "吐司模",
    "搅拌盆",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西葫芦洗净不削皮，用刨丝器擦成细丝，用手挤掉多余水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水分挤得越干，烤出来的面糊越不会稀塌。",
      "visual_cue": "西葫芦丝捏起来不滴水，体积明显缩小"
    },
    {
      "n": 2,
      "text": "鸡蛋与白糖打散搅匀，再慢慢淋入植物油搅到略微发白。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油分次淋入才乳化得匀，一次倒容易分离。",
      "visual_cue": "蛋液浓稠发亮，表面没有浮油"
    },
    {
      "n": 3,
      "text": "高筋面粉、泡打粉、小苏打、肉桂粉与盐混合，过筛两遍。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过筛让膨松剂分布均匀，成品才不塌顶。",
      "visual_cue": "粉类蓬松细腻，没有结块"
    },
    {
      "n": 4,
      "text": "西葫芦丝与核桃碎倒进蛋液里拌匀，让每根都裹上蛋糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌好要马上进入下一步，久放会出水。",
      "visual_cue": "菜丝均匀分布，盆底没有积水"
    },
    {
      "n": 5,
      "text": "筛入粉类，用刮刀翻拌到看不见干粉就停手，别过度搅拌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌过头面糊会起筋，烤出来的组织变硬。",
      "visual_cue": "面糊浓稠有颗粒感，仍有少量干粉痕迹"
    },
    {
      "n": 6,
      "text": "面糊倒进抹油的长条烤模，表面抹平，轻震两下震掉大气泡。",
      "time_min": 4,
      "heat": "无火",
      "tip": "抹平能让膨胀均匀，中间才不会拱起开裂。",
      "visual_cue": "表面平整，模具边缘留出一指高度"
    },
    {
      "n": 7,
      "text": "烤箱一百七十五度烤五十分钟，竹签插入中心不带面糊即可。",
      "time_min": 50,
      "heat": "中火",
      "tip": "中途上色太快要盖锡纸，避免外焦内生。",
      "visual_cue": "表面金黄开裂，竹签拔出干净"
    },
    {
      "n": 8,
      "text": "出炉后留在模具里十分钟，再倒扣脱模彻底放凉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "热着切会散成渣，凉透之后切面才整齐。",
      "visual_cue": "侧边与模具自然分离，敲模能轻松脱出"
    }
  ],
  "tips": [
    "放凉后切片煎一下，抹黄油特别香。",
    "西葫芦不用削皮，绿色点点很好看。",
    "加一把葡萄干，甜味和口感都更丰富。",
    "冷藏两天后再吃，风味比刚出炉更融合。"
  ],
  "common_mistakes": [
    "西葫芦没挤水，面糊过稀烤出中间塌陷的厚饼。",
    "翻拌过度让面糊起筋，成品硬实不松软。",
    "模具没抹油就倒面糊，脱模时整块碎裂。"
  ],
  "substitutions": [
    {
      "original": "核桃",
      "substitute": "葵花籽",
      "ratio": "60克:60克",
      "note": "坚果过敏者可换。"
    },
    {
      "original": "植物油",
      "substitute": "融化黄油",
      "ratio": "120毫升:130克",
      "note": "奶香更浓，口感更扎实。"
    }
  ],
  "variations": [
    "加入一勺橙皮屑，清香味道会更明显一点。",
    "把核桃换成巧克力豆，做成更受孩子喜欢的版本。"
  ],
  "serving_suggestion": "切片当早餐或下午茶，配咖啡与牛奶都合适。",
  "storage": "室温密封三天，冷冻两个月，切片回烤三分钟。",
