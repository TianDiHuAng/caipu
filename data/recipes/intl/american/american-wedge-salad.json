  "steps": [
    {
      "n": 1,
      "text": "结球生菜整颗冷藏一小时，取冰凉状态。这一步不要着急。",
      "time_min": 65,
      "heat": "无火",
      "tip": "越冰越脆，切的时候不塌。，注意火候。",
      "visual_cue": "叶片紧实，手感冰硬，状态稳定"
    },
    {
      "n": 2,
      "text": "培根切小段，冷锅下中小火慢煎出油。这一步不要着急。",
      "time_min": 7,
      "heat": "小火",
      "tip": "冷锅下培根，油才逼得干净。，注意火候。",
      "visual_cue": "培根卷曲，油脂析出，状态稳定"
    },
    {
      "n": 3,
      "text": "煎到深红发脆，捞出放在厨房纸上。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "别煎黑，苦味会盖住奶香。，注意火候。",
      "visual_cue": "质地干脆，无焦黑，状态稳定"
    },
    {
      "n": 4,
      "text": "蛋黄酱、酪乳、白醋和盐搅成沙拉酱。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酪乳调稀，酱才挂得住叶面。，注意火候。",
      "visual_cue": "酱汁浓稠，能缓慢流下"
    },
    {
      "n": 5,
      "text": "生菜去根，纵切成四瓣，保持整块形状。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用刀直切，别掰散。，注意火候。",
      "visual_cue": "四瓣完整，切面平整，状态稳定"
    },
    {
      "n": 6,
      "text": "把生菜瓣立着摆盘，淋上沙拉酱。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "淋在切面上，酱才渗进叶层。，注意火候。",
      "visual_cue": "酱汁顺着叶片流下，状态稳定"
    },
    {
      "n": 7,
      "text": "撒蓝纹奶酪碎、培根和半切小番茄。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "奶酪室温放软一点，口感更好。，注意火候。",
      "visual_cue": "配料铺满切面，状态稳定"
    },
    {
      "n": 8,
      "text": "最后撒黑胡椒和小葱末，立即上桌。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "现做现吃，冰脆感才在。，注意火候。",
      "visual_cue": "表层点缀，颜色分明，状态稳定"
    }
  ],
  "tips": [
    "生菜冰镇后再切，脆感才够。，值得留意。",
    "培根冷锅下慢煎，油逼得干净。，值得留意。",
    "酱汁用酪乳调稀，才挂得住叶面。，值得留意。"
  ],
  "common_mistakes": [
    "生菜常温切开，盘底很快出水。，值得留意。",
    "培根煎焦，整盘带苦味。，值得留意。",
    "奶酪放太少，奶香撑不起来。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "蓝纹奶酪",
      "substitute": "帕玛森奶酪",
      "ratio": "80 克:60 克",
      "note": "味道更温顺，咸香依旧。"
    },
    {
      "original": "酪乳",
      "substitute": "酸奶加牛奶",
      "ratio": "50 毫升:50 克加20 毫升",
      "note": "酸度相近，质地略稠。"
    }
  ],
  "variations": [
    "加一把烤核桃，脆感更丰富。，值得留意。",
    "淋一点蜂蜜，甜咸交织。，值得留意。"
  ],
  "serving_suggestion": "作为牛排的配菜，或单独当轻食午餐。，效果更稳定。",
  "storage": "冷藏一天，酱汁与生菜分开存放。，效果更稳定。",
