  ],
  "equipment": [
    "汤锅",
    "大碗",
    "压泥器",
    "切菜板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆 700g 去皮切成 2 厘米块，冷水下锅加 3g 盐，煮开后转中火煮 15 分钟。",
      "time_min": 18,
      "heat": "中火",
      "tip": "冷水下锅，土豆内外熟得均匀。",
      "visual_cue": "筷子能轻松插入土豆块"
    },
    {
      "n": 2,
      "text": "鸡蛋 2 个冷水下锅，水开后煮 9 分钟，捞出过冷水后剥壳切碎。",
      "time_min": 12,
      "heat": "中火",
      "tip": "煮 9 分钟蛋黄刚凝固，不会发绿。",
      "visual_cue": "蛋黄橙黄、蛋白完全凝固"
    },
    {
      "n": 3,
      "text": "土豆捞出沥干，趁热用压泥器压碎一半，保留一半块状，放凉 10 分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "半泥半块，口感才有层次。",
      "visual_cue": "土豆一半成泥、一半保留块状"
    },
    {
      "n": 4,
      "text": "芹菜 80g、洋葱 60g 与酸黄瓜 60g 分别切成小丁，用厨房纸吸去多余水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蔬菜丁吸干水，沙拉才不会稀。",
      "visual_cue": "蔬菜丁干爽、大小均匀"
    },
    {
      "n": 5,
      "text": "大碗中放土豆、蔬菜丁与鸡蛋碎，加 120g 蛋黄酱、剩余 2g 盐与 2g 黑胡椒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋黄酱分两次拌，裹得更匀。",
      "visual_cue": "所有材料均匀裹上酱"
    },
    {
      "n": 6,
      "text": "翻拌均匀后盖保鲜膜冷藏 30 分钟，让味道融合后再食用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷藏半小时，味道明显更融合。",
      "visual_cue": "沙拉紧实、冷藏后更浓稠"
    }
  ],
  "tips": [
    "土豆半压成泥、半留块状，口感最讨喜。",
    "蔬菜丁一定吸干水分，否则沙拉会出水变稀。",
    "冷藏半小时再吃，味道融合得更好。"
  ],
  "common_mistakes": [
    "土豆煮过头全成糊，沙拉变成一摊泥。",
    "蔬菜没吸干水，第二天沙拉就出水。",
    "鸡蛋煮得太久，蛋黄发绿并带明显硫味。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "120g 对 130g",
      "note": "热量更低，酸味更明显。"
    },
    {
      "original": "酸黄瓜",
      "substitute": "酸豆角",
      "ratio": "60g 对 60g",
      "note": "需切得更细，咸味略重。"
    }
  ],
  "variations": [
    "培根版：加 60g 煎脆培根碎。",
    "芥末版：蛋黄酱中拌入 8g 黄芥末。"
  ],
  "serving_suggestion": "冷藏后盛盘，配烤鸡或汉堡一起上桌。",
  "storage": "冷藏 2 天，食用前翻拌均匀。",
