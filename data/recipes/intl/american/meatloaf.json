  "equipment": [
    "烤箱",
    "炒锅",
    "大碗",
    "烤盘",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切成细末，锅中放植物油小火炒到透明发软，盛出放凉备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "炒过的洋葱更甜，也少出水。",
      "visual_cue": "洋葱末透明、香气散出"
    },
    {
      "n": 2,
      "text": "牛肉加面包糠、鸡蛋、牛奶、放凉的洋葱末、盐与黑胡椒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面包糠先吸饱牛奶，口感才润。",
      "visual_cue": "配料齐全、面包糠湿润"
    },
    {
      "n": 3,
      "text": "用手顺一个方向反复搅打肉料，直到起黏性抱成一团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺一个方向打，肉糕才不裂。",
      "visual_cue": "肉料发黏、能整团离盆"
    },
    {
      "n": 4,
      "text": "肉料整形成 20cm 长、8cm 宽的长条，表面抹平后刷一层番茄酱。",
      "time_min": 6,
      "heat": "无火",
      "tip": "厚薄均匀，烤时才不生熟不均。",
      "visual_cue": "表面平整、酱色均匀"
    },
    {
      "n": 5,
      "text": "烤盘垫锡纸，180℃ 烤 45 分钟，出炉静置 10 分钟再切片。",
      "time_min": 47,
      "heat": "中火",
      "tip": "静置这十分钟能让肉汁回吸。",
      "visual_cue": "表面焦亮、中心不见粉红"
    }
  ],
  "tips": [
    "面包糠先用牛奶泡软，肉糕才不会干柴。",
    "肉料务必顺一个方向搅上劲，切片才不散。",
    "出炉静置十分钟再切，肉汁才不流失。"
  ],
  "common_mistakes": [
    "肉料没有打上劲，切片时整块松散地垮下来。",
    "番茄酱一开始就拌进肉里，表面烤不出焦亮。",
    "烤完立刻切片，肉汁全流到盘子里。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛猪混合肉",
      "ratio": "600g 对 600g",
      "note": "与牛肉混合后更润更香，比例按口味调整即可。"
    },
    {
      "original": "面包糠",
      "substitute": "隔夜面包",
      "ratio": "60g 对 70g",
      "note": "撕碎后同样用牛奶泡软。"
    }
  ],
  "variations": [
    "芝士夹心版：肉料中间包 80g 马苏里拉芝士，切开会拉丝。",
    "烟熏版：加 5g 烟熏辣椒粉，风味更粗犷。"
  ],
  "serving_suggestion": "切片摆盘，配土豆泥与青豆，淋上盘里的肉汁。",
  "storage": "冷藏 3 天，切片后加盖复烤 10 分钟；冷冻可存 1 个月。",
