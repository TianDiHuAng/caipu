  ],
  "steps": [
    {
      "n": 1,
      "text": "黑巧克力与黄油隔水小火融化，搅到顺滑无颗粒后离火晾到温热。",
      "time_min": 8,
      "heat": "小火",
      "tip": "水温别太高，巧克力会结块。",
      "visual_cue": "液体顺滑、有光泽"
    },
    {
      "n": 2,
      "text": "鸡蛋加白糖打发到颜色发白、提起打蛋头能画出纹路。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打发决定表面那层薄壳。",
      "visual_cue": "蛋糊发白、纹路停留"
    },
    {
      "n": 3,
      "text": "巧克力液分两次拌进蛋糊，翻拌均匀后筛入面粉、可可粉与盐。",
      "time_min": 5,
      "heat": "无火",
      "tip": "翻拌别画圈，避免消泡。",
      "visual_cue": "面糊浓稠、无干粉"
    },
    {
      "n": 4,
      "text": "拌入一半核桃碎，倒进铺纸的烤盘抹平，表面撒剩余核桃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "面糊厚薄一致才烤得均匀。",
      "visual_cue": "表面平整、核桃分布均匀"
    },
    {
      "n": 5,
      "text": "175℃ 烤三十二分钟，牙签插入带少许湿润屑即可出炉放凉切块。",
      "time_min": 32,
      "heat": "无火",
      "tip": "带点湿屑才是软心布朗尼。",
      "visual_cue": "表面薄壳、中心微湿"
    }
  ],
  "tips": [
    "巧克力与黄油隔水融化时水温别超过 60℃，否则会油水分离。",
    "蛋糊要打发到发白，表面那层薄壳就靠它。",
    "烤到牙签带湿润屑就出炉，烤透就成蛋糕了。"
  ],
  "common_mistakes": [
    "面糊过度搅拌，烤出来又硬又韧。",
    "烤到牙签全干才出炉，口感变成干蛋糕。",
    "热切布朗尼，切面全塌、形状全毁。"
  ],
  "substitutions": [
    {
      "original": "黑巧克力",
      "substitute": "牛奶巧克力",
      "ratio": "180g 对 180g",
      "note": "白糖减到 100g。"
    },
    {
      "original": "核桃",
      "substitute": "腰果",
      "ratio": "60g 对 60g",
      "note": "先烤香再拌。"
    }
  ],
  "variations": [
    "海盐版：出炉撒 2g 片状海盐。",
    "流心版：中心夹 60g 巧克力块，烤制时间减 3 分钟。"
  ],
  "serving_suggestion": "切块配香草冰淇淋或一杯黑咖啡。",
  "storage": "密封常温可存 3 天，冷藏 1 周，复热 150℃ 烤 4 分钟。",
