  "equipment": [
    "平底锅",
    "锅铲",
    "刀",
    "砧板",
    "削皮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "胡萝卜削掉外皮，斜切成三厘米长的滚刀块，方便受热均匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切成大小相近的滚刀块，熟度才会一起到位。",
      "visual_cue": "切块均匀，棱角分明，状态稳定"
    },
    {
      "n": 2,
      "text": "平底锅放黄油小火化开，下胡萝卜块翻炒到表面裹上油光。",
      "time_min": 5,
      "heat": "小火",
      "tip": "黄油别烧到变色，微黄带奶香时最合适。",
      "visual_cue": "胡萝卜油亮，黄油起泡"
    },
    {
      "n": 3,
      "text": "撒白糖和盐翻匀，倒入清水，盖盖小火焖八分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "加一点水焖，胡萝卜芯才不会硬。，注意火候。",
      "visual_cue": "锅中咕嘟，汤汁变黄，状态稳定"
    },
    {
      "n": 4,
      "text": "开盖转中火收汁，边收边翻让糖汁均匀裹在每一块上。",
      "time_min": 4,
      "heat": "中火",
      "tip": "糖汁变稠就要勤翻，不然锅底很快发焦。",
      "visual_cue": "糖汁浓稠，裹满表面，状态稳定"
    },
    {
      "n": 5,
      "text": "淋入蜂蜜快速翻匀，让表面挂上一层透亮的糖亮膜。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蜂蜜最后放，久煮会失去清亮的香气。",
      "visual_cue": "表面透亮，汁能拉丝，状态稳定"
    },
    {
      "n": 6,
      "text": "撒黑胡椒，关火装盘，趁热吃口感最软甜。这一步别着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "黑胡椒现磨现撒，香气才够活泼不闷。",
      "visual_cue": "糖壳光亮，胡椒点缀，状态稳定"
    }
  ],
  "tips": [
    "胡萝卜切得大小一致，熟度才会同时到位。",
    "加少许清水焖一会儿，芯部才不夹硬。，值得留意。",
    "糖汁变稠后勤翻，锅底不容易焦。，值得留意。"
  ],
  "common_mistakes": [
    "一直大火收汁，糖先焦黑胡萝卜还没熟。，务必避免。",
    "不加水直接炒，胡萝卜外软内硬。，务必避免。",
    "蜂蜜一开始就下锅，久煮后香气全失。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "20 克:20 克",
      "note": "色泽略暗，甜味更直接。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "35 克:30 毫升",
      "note": "素版更清爽，奶香减弱。"
    }
  ],
  "variations": [
    "出锅撒一小撮肉桂粉，甜香更温暖。，也很受欢迎。",
    "加一把葡萄干同焖，口感更有嚼头。，也很受欢迎。"
  ],
  "serving_suggestion": "配烤肉或烤鸡当配菜，甜咸的味道能解腻。，效果更稳定。",
  "storage": "冷藏两天，复热时加一勺清水小火焖透。，效果更稳定。",
