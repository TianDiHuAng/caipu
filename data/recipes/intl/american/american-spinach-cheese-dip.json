          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "烤碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜放进开水里焯一分钟，捞出过凉后挤干水分。",
      "time_min": 5,
      "heat": "大火",
      "tip": "菠菜一定要挤到不出水，不然蘸会稀。",
      "visual_cue": "菠菜团紧实，挤不出水滴"
    },
    {
      "n": 2,
      "text": "洋葱切成细末，大蒜切末，奶油奶酪提前回温软化。",
      "time_min": 5,
      "heat": "无火",
      "tip": "奶油奶酪回温后才容易搅开不起颗粒。",
      "visual_cue": "奶酪按下去能压出凹陷"
    },
    {
      "n": 3,
      "text": "平底锅放黄油小火化开，下洋葱末炒到透明。",
      "time_min": 4,
      "heat": "小火",
      "tip": "黄油要用小火慢慢化开，烧焦了会带苦味。",
      "visual_cue": "洋葱透明发亮，黄油起小泡"
    },
    {
      "n": 4,
      "text": "加入蒜末炒出香味，再沿着锅边倒入牛奶搅匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "牛奶要沿着锅边慢慢倒，免得溅起热油。",
      "visual_cue": "锅中液体乳白，蒜香散出"
    },
    {
      "n": 5,
      "text": "放入奶油奶酪和帕玛森芝士，小火搅到完全融化。",
      "time_min": 4,
      "heat": "小火",
      "tip": "一直搅动，芝士才不会粘锅结块。",
      "visual_cue": "芝士糊顺滑，能挂住勺子"
    },
    {
      "n": 6,
      "text": "加入菠菜碎拌匀，用盐和黑胡椒调味后关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "菠菜下锅后拌匀就关火，久煮会发黄。",
      "visual_cue": "菠菜碎分布均匀，颜色翠绿"
    },
    {
      "n": 7,
      "text": "装进烤碗，放进两百度烤箱烤十分钟到表面起泡。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "烤到边缘冒泡就够，烤久了表面会干。",
      "visual_cue": "表面金黄起泡，边缘微焦"
    }
  ],
  "tips": [
    "菠菜挤干水分是关键，否则蘸会稀成汤。",
    "芝士全程小火搅动，才不会结块粘锅。",
    "烤到边缘冒泡即可，烤过头表面发干。"
  ],
  "common_mistakes": [
    "菠菜没有挤干水分，烤出来就成了一盘稀汤。",
    "菠菜没挤干水分，烤出来成了一盘稀汤。",
    "蒜末炒到焦黄发黑，整碗蘸都带着苦味。"
  ],
  "substitutions": [
    {
      "original": "帕玛森芝士",
      "substitute": "马苏里拉芝士",
      "ratio": "60 克:80 克",
      "note": "拉丝更好，咸味略淡。"
    },
    {
      "original": "奶油奶酪",
      "substitute": "酸奶油",
      "ratio": "200 克:200 克",
      "note": "质地更稀，牛奶减半。"
    }
  ],
  "variations": [
    "加一点辣椒粉一起拌，做成微辣口味。",
    "拌入切碎的洋蓟心，风味更接近经典做法。"
  ],
  "serving_suggestion": "趁热配玉米片、面包片或者芹菜条一起蘸着吃。",
  "storage": "冷藏三天，复热时加一勺牛奶搅匀再用烤箱加热。",
