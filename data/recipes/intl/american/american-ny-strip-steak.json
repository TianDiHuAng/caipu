  "equipment": [
    "铸铁锅",
    "夹子",
    "刀",
    "砧板",
    "厨房纸",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊切三厘米厚片，用厨房纸把两面水分彻底吸干，放室温静置二十五分钟。",
      "time_min": 25,
      "heat": "无火",
      "tip": "表面越干越容易煎出焦壳，湿肉下锅只会出水",
      "visual_cue": "肉面干爽，按下去微微回弹"
    },
    {
      "n": 2,
      "text": "两面均匀撒盐与现磨黑胡椒，用手轻压让调味贴在肉面上，静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐提前撒能渗进表层，出锅后再补一撮更提味",
      "visual_cue": "肉表面均匀挂着盐粒与碎胡椒"
    },
    {
      "n": 3,
      "text": "铸铁锅大火烧到微微冒烟，倒花生油晃匀，放入肉片单面煎三分钟不要翻动。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅要够热，下锅后忍住别翻，焦壳才结得起来",
      "visual_cue": "边缘转褐，锅底冒白烟"
    },
    {
      "n": 4,
      "text": "翻面再煎两分钟，转中火放黄油、蒜与迷迭香，用勺子把融化的油脂反复浇在肉面上。",
      "time_min": 3,
      "heat": "中火",
      "tip": "浇油能让表面持续受热，比单纯翻面更均匀",
      "visual_cue": "黄油起细泡，锅底泛出坚果香"
    },
    {
      "n": 5,
      "text": "把肉夹出放在架子上静置八分钟，让肉汁重新分布回纤维里。",
      "time_min": 8,
      "heat": "无火",
      "tip": "静置这步和煎一样重要，急着切会流失半盘肉汁",
      "visual_cue": "架下盘底积起一层清亮肉汁"
    },
    {
      "n": 6,
      "text": "逆着纹理斜切成两厘米宽的条，撒一撮粗盐与黑胡椒即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "逆纹切才咬得动，顺纹切会拉成一丝丝",
      "visual_cue": "切面呈粉红色，汁水清亮"
    }
  ],
  "tips": [
    "牛里脊选粗细均匀的中段，两头薄厚不一会煎得生熟不一。",
    "锅一定要先烧透再下油，冷锅下肉只会粘底。",
    "静置时把肉架在网架上，别直接放盘子，底部才不会泡软。",
    "剩下的边角料切碎，第二天夹三明治正好。"
  ],
  "common_mistakes": [
    "全程小火慢慢煎，肉在锅里熬到发灰发柴，一点焦香都没有。",
    "下锅前没擦干水分，油花四溅还煎不出壳，肉像水煮。",
    "切的时候顺着纹理切，端上桌嚼半天咽不下去。",
    "静置时间省掉直接切，一盘肉汁全流在砧板上。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "西冷",
      "ratio": "800 克:800 克",
      "note": "筋膜略多，煎的时间加三十秒。"
    },
    {
      "original": "迷迭香",
      "substitute": "百里香",
      "ratio": "3 克:3 克",
      "note": "香气更柔和，适合不喜浓烈香草的人。"
    }
  ],
  "variations": [
    "煎好后铺一层蓝纹奶酪碎进烤箱焗两分钟，就是更厚重的风味版本。",
    "把黄油换成蒜香黄油，出锅前挤半个柠檬汁，油腻感会轻很多。"
  ],
  "serving_suggestion": "四人份主菜，配烤土豆与清炒芦笋，把静置出来的肉汁淋在肉条上一起上桌。",
  "storage": "冷藏两天内吃完，切片后密封保存；复热用平底锅小火两面各热四十秒，不要用微波炉久转。",
