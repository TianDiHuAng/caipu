    "汤锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面条放进加了盐的滚水里煮到八分熟，捞出沥干，拌少许植物油抖散防粘。",
      "time_min": 8,
      "heat": "中大火",
      "tip": "八分熟就捞，后面还要回锅吸汁，全熟会泡烂。",
      "visual_cue": "面条能咬断但中心留一点白芯"
    },
    {
      "n": 2,
      "text": "牛肉逆着纹理切薄片，用厨房纸吸干表面水分，撒盐与黑胡椒抓匀静置五分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切能切断筋膜，炒出来才嫩不塞牙。",
      "visual_cue": "肉片薄而整齐，表面干爽不流水"
    },
    {
      "n": 3,
      "text": "深煎锅烧到微微冒烟，放一半植物油，牛肉片摊开大火快炒到变色，立刻盛出。",
      "time_min": 4,
      "heat": "大火",
      "tip": "肉片别一次全下，锅温降太快就变成水煮。",
      "visual_cue": "肉片边缘焦褐，锅底留褐色焦香物"
    },
    {
      "n": 4,
      "text": "锅里补剩下的植物油，下洋葱与蘑菇中火炒到洋葱透明、蘑菇出水又收干。",
      "time_min": 7,
      "heat": "中火",
      "tip": "蘑菇要炒到水分收干才有香味，出水阶段别急着加盐。",
      "visual_cue": "蘑菇片边缘卷起，锅底略干"
    },
    {
      "n": 5,
      "text": "加蒜末与青椒条炒出香，放番茄酱小火炒三十秒，把锅底的焦香一起刮起来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄酱一定要炒过才去生酸味，颜色也更红亮。",
      "visual_cue": "酱色转深红，锅底褐色物质化开"
    },
    {
      "n": 6,
      "text": "倒入高汤与生抽煮开，放回牛肉与面条，用夹子翻拌到酱汁均匀裹住面条。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "翻拌用夹子比铲子好，面条不易断且能拌匀。",
      "visual_cue": "面条油亮挂汁，锅里无明显汤汁"
    },
    {
      "n": 7,
      "text": "尝味后补盐与黑胡椒，撒香菜碎，连锅端上桌趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，靠余温散发香气，久炒会发黄。",
      "visual_cue": "盘面红褐油亮，香菜翠绿点缀"
    }
  ],
  "tips": [
    "牛肉用肥瘦相间的部位更香，全瘦的炒久容易柴，可先用少量油抓匀。",
    "面条换成螺旋面或通心粉也行，挂汁效果更好。",
    "番茄膏比番茄沙司味更浓，用沙司要减量并多加一勺糖。",
    "炒完立刻吃口感最好，放凉后面条会把酱汁吸干变硬。"
  ],
  "common_mistakes": [
    "牛肉和洋葱一起下锅，肉出水后泡在汤里，炒不出焦香。",
    "番茄酱没炒直接加高汤，整锅带出生涩的酸味。",
    "面条煮到全熟再回锅，翻两下就断成短节。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "猪里脊",
      "ratio": "300克:300克",
      "note": "切薄片同样快炒，口感更嫩但香气略淡。"
    },
    {
      "original": "番茄酱",
      "substitute": "番茄",
      "ratio": "60克:200克",
      "note": "切碎炒软后多煮三分钟收汁。"
    }
  ],
  "variations": [
    "加一勺辣酱与半勺蜂蜜，做成甜辣风味，颜色更红亮。",
    "换成芝士版，拌好后撒一把奶酪丝进烤箱烤五分钟。"
  ],
  "serving_suggestion": "用铸铁锅直接上桌，配一杯冰啤酒或气泡水，旁边放一小碟酸黄瓜解腻。",
  "storage": "冷藏两天内吃完，复热时加两勺高汤小火翻热，避免干炒变硬。",
