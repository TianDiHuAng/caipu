  "steps": [
    {
      "n": 1,
      "text": "虾去壳去虾线，冲洗干净沥干。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "无火",
      "tip": "虾线不去会有腥味。，火候要稳，别忽大忽小。",
      "visual_cue": "虾身干净，颜色透亮"
    },
    {
      "n": 2,
      "text": "清水烧开加盐，虾下锅煮两分钟。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "大火",
      "tip": "变红卷起就熟，别久煮。，火候要稳，别忽大忽小。",
      "visual_cue": "虾身卷曲，颜色橙红"
    },
    {
      "n": 3,
      "text": "捞出放冰水里镇凉，沥干切段。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冰水镇过，虾肉才弹。，火候要稳，别忽大忽小。",
      "visual_cue": "虾肉紧实，切开不散"
    },
    {
      "n": 4,
      "text": "芹菜切细丁，越细越好。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "切细一点，口感才不抢。，火候要稳，别忽大忽小。",
      "visual_cue": "菜丁细小，颗粒均匀"
    },
    {
      "n": 5,
      "text": "蛋黄酱加柠檬汁、盐和黑胡椒拌匀。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调酱，味道才均匀。，火候要稳，别忽大忽小。",
      "visual_cue": "酱体顺滑，酸香明显"
    },
    {
      "n": 6,
      "text": "虾段和芹菜丁拌入酱里，冷藏十分钟。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏一下，味道更融合。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料黏合，色泽清亮"
    },
    {
      "n": 7,
      "text": "面包内侧抹黄油，平底锅烙到微脆。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "面包烙一下，才不软塌。，火候要稳，别忽大忽小。",
      "visual_cue": "内侧焦黄，边缘微脆"
    },
    {
      "n": 8,
      "text": "铺生菜，填满虾馅，合上即可。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "现填现吃，面包才不会湿。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料饱满，生菜翠绿"
    }
  ],
  "tips": [
    "虾煮到卷起就捞，久了发柴。，这一点很关键。",
    "冰水镇一下，虾肉才弹。，这一点很关键。",
    "面包先烙脆，夹馅不出水。，这一点很关键。"
  ],
  "common_mistakes": [
    "虾煮过头，肉质橡皮般硬。，这一点很关键。",
    "芹菜切太粗，抢了虾味。，这一点很关键。",
    "面包没烤，一夹就软。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鳕鱼",
      "ratio": "500 克:500 克",
      "note": "需蒸熟后撕成块，容易散。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "90 克:120 克",
      "note": "热量更低，酸味更明显。"
    }
  ],
  "variations": [
    "加一点辣椒粉，微辣更开胃。，这一点很关键。",
    "用烤热的面包卷，口感更脆。，这一点很关键。"
  ],
  "serving_suggestion": "配薯片和酸黄瓜，挤柠檬汁。，这一点很关键。",
  "storage": "馅料冷藏一天，面包现烤现夹。，这一点很关键。",
