  "steps": [
    {
      "n": 1,
      "text": "核桃放干锅小火烤三分钟，取出掰成小块。这一步别着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "烤过才香，别烤糊。，注意火候。",
      "visual_cue": "核桃微香，颜色加深，状态稳定"
    },
    {
      "n": 2,
      "text": "葡萄干用温水泡五分钟，沥干备用。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡软后口感才不干硬。，注意火候。",
      "visual_cue": "果粒饱满，水色微黄，状态稳定"
    },
    {
      "n": 3,
      "text": "苹果去皮去核，切一厘米见方的丁。这一步别着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切好立刻拌柠檬汁，防止变黑。，注意火候。",
      "visual_cue": "果丁匀整，颜色洁白，状态稳定"
    },
    {
      "n": 4,
      "text": "芹菜撕掉老筋，斜切成薄片。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "去筋才不塞牙。，注意火候。",
      "visual_cue": "芹片脆嫩，纤维少，状态稳定"
    },
    {
      "n": 5,
      "text": "苹果丁、芹菜片和葡萄干放进大碗。这一步别着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先拌干的，再加酱。，注意火候。",
      "visual_cue": "料铺匀，碗底无水，状态稳定"
    },
    {
      "n": 6,
      "text": "加蛋黄酱、盐和黑胡椒，从底往上翻拌。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻拌不压，果丁才不碎。，注意火候。",
      "visual_cue": "沙拉抱团，酱色乳白，状态稳定"
    },
    {
      "n": 7,
      "text": "生菜铺盘底，沙拉堆在中间，撒核桃块。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "核桃最后撒，保持酥脆。，注意火候。",
      "visual_cue": "造型立体，坚果点缀，状态稳定"
    }
  ],
  "tips": [
    "苹果切好马上拌柠檬汁，颜色才白。，值得留意。",
    "核桃烤过更香，注意别烤糊。，值得留意。",
    "翻拌代替搅拌，果丁才完整。，值得留意。"
  ],
  "common_mistakes": [
    "苹果没拌柠檬汁，端上桌就发黑。，值得留意。",
    "核桃没烤，吃着有生涩味。，值得留意。",
    "蛋黄酱太多，整盘糊成一片。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "梨",
      "ratio": "300 克:300 克",
      "note": "更清甜，水分略多。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "80 克:80 克",
      "note": "更清爽，酸味更明显。"
    }
  ],
  "variations": [
    "加一点鸡胸肉丝，做成主菜沙拉。，值得留意。",
    "撒一把蓝纹奶酪，风味更浓。，值得留意。"
  ],
  "serving_suggestion": "冷盘上桌，配烤鸡或三明治。，效果更稳定。",
  "storage": "冷藏一天，吃前撒核桃。，效果更稳定。",
