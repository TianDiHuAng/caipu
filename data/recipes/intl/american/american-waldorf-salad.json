  "equipment": [
    "沙拉碗",
    "刀",
    "砧板",
    "打蛋器",
    "削皮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苹果洗净留皮切成筷子粗的条，立刻拌入柠檬汁翻匀防止氧化变褐。",
      "time_min": 5,
      "heat": "无火",
      "tip": "苹果切好就拌汁，放两分钟不动表面就开始发暗。",
      "visual_cue": "苹果条边缘洁白，带一层薄薄的汁水"
    },
    {
      "n": 2,
      "text": "芹菜撕掉背面粗筋斜切成薄片，放冰水里泡五分钟捞出沥干，口感更脆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "芹菜筋不撕会塞牙，冰水浸泡能让纤维挺起来。",
      "visual_cue": "芹菜片边缘卷起，颜色翠绿透亮"
    },
    {
      "n": 3,
      "text": "核桃掰成小块，干锅小火烘到边缘微黄出香，取出摊开晾凉。",
      "time_min": 4,
      "heat": "小火",
      "tip": "核桃烘到有香味就离锅，余温会让它继续加深颜色。",
      "visual_cue": "核桃表面泛油光，飘出坚果香"
    },
    {
      "n": 4,
      "text": "酸奶加白糖和盐搅匀成沙拉酱，尝一下要甜中带微酸。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用浓稠酸奶才不会把沙拉泡软，稀酸奶需提前沥水。",
      "visual_cue": "酱汁顺滑能挂住勺背"
    },
    {
      "n": 5,
      "text": "生菜铺盘底，苹果、芹菜、葡萄干和核桃放在大碗里淋酱拌匀，再堆到生菜上。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌的时候用两把勺子从底往上翻，避免把苹果压碎。",
      "visual_cue": "食材裹上薄薄一层乳白酱汁，颜色分明"
    }
  ],
  "tips": [
    "苹果和芹菜都要切得粗细一致，入口才有层次不显杂乱。",
    "坚果最后拌入能保持酥脆，提前拌会吸潮变软。",
    "沙拉酱用酸奶替代一半蛋黄酱，热量低且清爽不腻。"
  ],
  "common_mistakes": [
    "苹果切好不加柠檬汁，上桌时已经发褐。",
    "芹菜背面的粗筋没有撕干净，嚼起来满口都是纤维渣。",
    "沙拉提前两小时拌好，出水后盘底积一层稀汤。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "蛋黄酱",
      "ratio": "100 克:80 克",
      "note": "传统做法更浓稠，热量也更高。"
    },
    {
      "original": "核桃",
      "substitute": "腰果",
      "ratio": "1:1",
      "note": "烘烤时间缩短一分钟，腰果更易糊。"
    }
  ],
  "variations": [
    "加入煮熟的鸡胸肉丝或熏鸭胸，可做成能当主餐的版本。"
  ],
  "serving_suggestion": "现拌现吃，冷藏十分钟后风味更融合。",
  "storage": "冷藏不超过一天，酱汁会出水，吃前重新翻拌。",
