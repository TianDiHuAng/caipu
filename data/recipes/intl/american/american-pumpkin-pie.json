  "equipment": [
    "派盘",
    "擀面杖",
    "烤箱",
    "大碗",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜去皮切块，上锅蒸十五分钟到用筷子能轻松插透。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蒸到完全软透，压泥才细腻无颗粒。，注意火候。",
      "visual_cue": "南瓜软烂，颜色橙红，状态稳定"
    },
    {
      "n": 2,
      "text": "面粉加盐和一半黄油，用手搓成粗砂状后加少量水成团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷的，搓出来派皮才酥不硬。，注意火候。",
      "visual_cue": "粉油成砂，面团成团，状态稳定"
    },
    {
      "n": 3,
      "text": "面团冷藏松弛二十分钟，擀成薄片铺进派盘压实边缘。",
      "time_min": 22,
      "heat": "无火",
      "tip": "松弛后擀开不回缩，铺盘时才不破。，注意火候。",
      "visual_cue": "派皮均匀，边缘压实，状态稳定"
    },
    {
      "n": 4,
      "text": "南瓜压成细泥，加鸡蛋、牛奶、白糖和肉桂搅成顺滑馅料。",
      "time_min": 8,
      "heat": "无火",
      "tip": "搅到没有结块，烤出来切面才平整。，注意火候。",
      "visual_cue": "馅料顺滑，颜色橙黄，状态稳定"
    },
    {
      "n": 5,
      "text": "馅料倒进派皮，抹平表面，边缘刷一层蛋液。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "馅料装八分满，烤的时候才不会溢出来。",
      "visual_cue": "表面平整，边缘发亮，状态稳定"
    },
    {
      "n": 6,
      "text": "烤箱预热一百九十度，送入下层烤三十五分钟。",
      "time_min": 5,
      "heat": "-",
      "tip": "下层烤让派皮先定型，底不易湿软。，注意火候。",
      "visual_cue": "烤箱升温，香味渐出，状态稳定"
    },
    {
      "n": 7,
      "text": "取出轻晃派盘，中心微微晃动即熟，放凉两小时再切。",
      "time_min": 8,
      "heat": "-",
      "tip": "完全放凉后馅料才凝住，切块才不掉渣。",
      "visual_cue": "边缘定型，中心微晃，状态稳定"
    }
  ],
  "tips": [
    "南瓜蒸透再压泥，馅料才细腻无颗粒。，值得留意。",
    "派皮面团冷藏松弛，擀开时才不回缩。，值得留意。",
    "出炉彻底放凉再切，馅料才凝得住。，值得留意。"
  ],
  "common_mistakes": [
    "南瓜没蒸透就压泥，馅里带硬块。，务必避免。",
    "派皮不松弛直接擀，边缘一直缩。，务必避免。",
    "热的时候切块，馅料全流到盘底。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "500 克:500 克",
      "note": "甜度更高，白糖减二十克。"
    },
    {
      "original": "牛奶",
      "substitute": "淡椰浆",
      "ratio": "150 毫升:150 毫升",
      "note": "带椰香，适合不吃乳制品的人。"
    }
  ],
  "variations": [
    "表面加一勺打发的奶油，口感更绵。，也很受欢迎。",
    "撒少许姜粉，辛香更明显。，也很受欢迎。"
  ],
  "serving_suggestion": "切块后配一勺奶油，是感恩节餐桌上的固定收尾。",
  "storage": "冷藏三天，食用前回温或冷食皆可。，效果更稳定。",
