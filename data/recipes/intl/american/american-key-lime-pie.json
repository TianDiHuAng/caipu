  "equipment": [
    "派盘",
    "大碗",
    "打蛋器",
    "烤箱",
    "冰箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉、白糖和盐混合，加入冷藏黄油丁搓成粗屑。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油要冷，搓出来才酥。，注意火候。",
      "visual_cue": "粉油成粗砂状，状态稳定"
    },
    {
      "n": 2,
      "text": "加少量冷水捏成团，压进派盘贴紧边缘。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别揉，捏成团就够。，注意火候。",
      "visual_cue": "面团贴盘，边缘齐整，状态稳定"
    },
    {
      "n": 3,
      "text": "用叉子在派底扎孔，冷藏二十分钟定型。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "扎孔排气，烤的时候才不鼓。，注意火候。",
      "visual_cue": "表面布满小孔，状态稳定"
    },
    {
      "n": 4,
      "text": "烤箱一百八十度烤十八分钟到浅金。这一步不要着急。",
      "time_min": 19,
      "heat": "无火",
      "tip": "烤到边缘上色，派底才不湿。，注意火候。",
      "visual_cue": "派底浅金，边缘微褐，状态稳定"
    },
    {
      "n": 5,
      "text": "蛋黄加炼乳搅匀，分次挤入青柠汁。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "青柠汁分次加，蛋液才不结块。，注意火候。",
      "visual_cue": "蛋糊顺滑，颜色淡黄，状态稳定"
    },
    {
      "n": 6,
      "text": "擦入半个青柠的皮屑，搅匀成馅。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "只擦黄色部分，白色发苦。，注意火候。",
      "visual_cue": "皮屑细碎，香气清新，状态稳定"
    },
    {
      "n": 7,
      "text": "擦入半个青柠的黄色皮屑，搅匀成细腻的馅糊。",
      "time_min": 2,
      "heat": "无火",
      "tip": "轻震两下排气泡，表面才平。，注意火候。",
      "visual_cue": "馅面平整，无气泡，状态稳定"
    },
    {
      "n": 8,
      "text": "一百五十度烤二十分钟到边缘凝固。这一步不要着急。",
      "time_min": 21,
      "heat": "无火",
      "tip": "中间略晃是正常的，靠余温定形。，注意火候。",
      "visual_cue": "边缘凝固，中心微颤，状态稳定"
    },
    {
      "n": 9,
      "text": "冷藏四小时，切块配打发的淡奶油。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷藏够久才切得整齐。，注意火候。",
      "visual_cue": "切面紧实，奶油挺立，状态稳定"
    }
  ],
  "tips": [
    "黄油保持冰冷，派底才酥。，值得留意。",
    "青柠汁分次加入，蛋糊才不结块。，值得留意。",
    "冷藏四小时以上，切面才漂亮。，值得留意。"
  ],
  "common_mistakes": [
    "派底没冷藏就烤，回缩塌边。，值得留意。",
    "青柠汁一次倒入，蛋糊结块。，值得留意。",
    "没冷藏就切，馅流一盘子。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "4 个:3 个",
      "note": "酸度更强，糖可略加。"
    },
    {
      "original": "淡奶油",
      "substitute": "酸奶",
      "ratio": "100 毫升:100 克",
      "note": "更清爽，酸味更明显。"
    }
  ],
  "variations": [
    "派底换成压碎的消化饼，省事更酥。，值得留意。",
    "表面加一层蛋白霜，烤出焦边。，值得留意。"
  ],
  "serving_suggestion": "冷藏后切块，配一勺淡奶油和青柠片。，效果更稳定。",
  "storage": "冷藏三天，冷冻可存两周。，效果更稳定。",
