  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆切一厘米小丁，泡冷水十分钟泡掉表面浮粉。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡过再煎，土豆才不粘锅。，注意火候。",
      "visual_cue": "水微浑，薯丁挺实，状态稳定"
    },
    {
      "n": 2,
      "text": "沥干后用厨房纸吸掉表面水分。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "带水下锅会溅油，也不脆。，注意火候。",
      "visual_cue": "薯丁干爽，不粘手，状态稳定"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油，薯丁中小火摊平煎。这一步不要着急。",
      "time_min": 8,
      "heat": "小火",
      "tip": "别急着翻，等底面结壳。，注意火候。",
      "visual_cue": "底面金黄，边缘定型，状态稳定"
    },
    {
      "n": 4,
      "text": "翻面继续煎六分钟到八成熟。这一步不要着急。",
      "time_min": 7,
      "heat": "小火",
      "tip": "翻面用铲子整块翻，别搅碎。，注意火候。",
      "visual_cue": "两面金黄，叉子能戳透"
    },
    {
      "n": 5,
      "text": "把薯丁推到一边，下香肠片煎出油。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香肠先煎，油能给土豆增香。，注意火候。",
      "visual_cue": "香肠卷边，油脂析出，状态稳定"
    },
    {
      "n": 6,
      "text": "下洋葱丁和青椒丁炒到变软。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蔬菜炒软出甜味，才不抢主味。，注意火候。",
      "visual_cue": "洋葱透明，青椒变深，状态稳定"
    },
    {
      "n": 7,
      "text": "全部翻匀，加盐和黑胡椒调味。这一步不要着急。",
      "time_min": 2,
      "heat": "中火",
      "tip": "尝一口再补盐，香肠本身有咸味。，注意火候。",
      "visual_cue": "颜色丰富，油光均匀，状态稳定"
    },
    {
      "n": 8,
      "text": "另起锅煎三个鸡蛋，摆在做好的土豆上。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蛋黄留溏心，拌开更香。，注意火候。",
      "visual_cue": "蛋白凝固，蛋黄微颤，状态稳定"
    },
    {
      "n": 9,
      "text": "配番茄酱上桌，把蛋黄拌进薯丁里一起吃，趁热最香。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌开蛋黄和薯丁一起吃。，注意火候。",
      "visual_cue": "蛋液流下，颜色诱人，状态稳定"
    }
  ],
  "tips": [
    "土豆泡水去淀粉，煎出来才脆。，值得留意。",
    "薯丁摊平别翻炒，才能结壳。，值得留意。",
    "鸡蛋最后煎，蛋黄留溏心最香。，值得留意。"
  ],
  "common_mistakes": [
    "土豆没沥干，下锅溅油又粘锅。，值得留意。",
    "一直翻炒，薯丁全碎成泥。，值得留意。",
    "盐放太早，土豆出水变软。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "香肠",
      "substitute": "培根",
      "ratio": "150 克:120 克",
      "note": "更脆，油要减。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "500 克:500 克",
      "note": "更甜，煎的时间缩短两分钟。"
    }
  ],
  "variations": [
    "加一把玉米粒，颜色更鲜亮。，值得留意。",
    "撒一把奶酪碎，盖盖焖到融化。，值得留意。"
  ],
  "serving_suggestion": "配一杯黑咖啡和一片吐司，就是美式早午餐。",
  "storage": "冷藏两天，复热用平底锅干煎三分钟。，效果更稳定。",
