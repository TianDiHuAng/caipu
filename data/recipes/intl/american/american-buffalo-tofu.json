  "equipment": [
    "烤盘",
    "平底锅",
    "打蛋盆",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐用厨房纸包好，上面压一个盘子静置二十分钟，把多余水分彻底压出来。",
      "time_min": 20,
      "heat": "无火",
      "tip": "压得越干，裹粉越牢，烤出来才有脆壳。",
      "visual_cue": "豆腐块变紧实，纸巾吸满水"
    },
    {
      "n": 2,
      "text": "压好的豆腐切成两厘米见方的小块，撒盐与黑胡椒轻轻翻匀，静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切块大小尽量一致，烤制时间才会均匀，小块不会先焦。",
      "visual_cue": "豆腐块大小均匀，表面泛白微干"
    },
    {
      "n": 3,
      "text": "把豆腐块放进打蛋盆，撒面粉后盖住盆口上下翻摇，让每块都裹上薄粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "摇盆比用手拌更均匀，也不容易把豆腐搅碎。",
      "visual_cue": "豆腐块表面均匀挂白粉，无湿斑"
    },
    {
      "n": 4,
      "text": "烤盘铺纸刷一层植物油，豆腐块间隔摆开，表面再薄薄刷一层油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "块与块之间留空隙，热气才能循环出脆壳。",
      "visual_cue": "豆腐块互不接触，表面泛油光"
    },
    {
      "n": 5,
      "text": "送进两百度烤箱烤二十分钟，中途翻一次面，烤到表面金黄略硬。",
      "time_min": 20,
      "heat": "中火",
      "tip": "翻面时用铲子托住，别用夹子硬夹，容易夹碎。",
      "visual_cue": "表面金黄，边缘出现脆边"
    },
    {
      "n": 6,
      "text": "小锅小火化开黄油，加蒜末炒香三十秒，倒入辣椒油与白醋搅匀成辣酱。",
      "time_min": 4,
      "heat": "小火",
      "tip": "黄油别烧到起泡发褐，一变色就离火。",
      "visual_cue": "酱汁红亮油润，闻到酸辣香"
    },
    {
      "n": 7,
      "text": "把烤好的豆腐块倒进酱汁里快速翻拌，让每块都裹上一层红亮的辣酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁豆腐还热的时候拌，酱汁才挂得住，凉了只能裹上薄薄一层。",
      "visual_cue": "豆腐块通体红亮，无多余酱汁积底"
    },
    {
      "n": 8,
      "text": "装盘配芹菜条，趁热吃，脆壳和辣酱的酸味最明显。",
      "time_min": 2,
      "heat": "无火",
      "tip": "芹菜条能解辣，也可以蘸剩下的酱汁吃。",
      "visual_cue": "盘面红亮，芹菜翠绿微弯"
    }
  ],
  "tips": [
    "辣酱本身带咸，加盐前先尝一口，避免过咸。",
    "想要更脆可以把烤好的豆腐再用热油快炸二十秒，但要先沥干。",
    "剩的辣酱冷藏可放一周，拿来拌面或蘸蔬菜都好用。",
    "不吃黄油可用橄榄油代替，酸味会更突出但少了圆润感。"
  ],
  "common_mistakes": [
    "豆腐不压水就裹粉，烤完粉层脱落，盘底一层白糊。",
    "辣酱用小锅大火收，黄油分离出油，酱汁变得颗粒粗糙。",
    "一次把豆腐全倒进酱里猛搅，脆壳被泡软搅碎。"
  ],
  "substitutions": [
    {
      "original": "辣椒油",
      "substitute": "番茄酱",
      "ratio": "60毫升:60克",
      "note": "辣度大减，需加十毫升白醋补酸。"
    },
    {
      "original": "北豆腐",
      "substitute": "杏鲍菇",
      "ratio": "450克:400克",
      "note": "撕成条状烤制，口感更弹。"
    }
  ],
  "variations": [
    "加一勺蜂蜜进辣酱，做成甜辣挂汁，适合不吃辣的人。",
    "把芹菜换成胡萝卜条与黄瓜条，配色更鲜亮。"
  ],
  "serving_suggestion": "用深盘盛装，辣酱另盛一小碟蘸食，配一杯冰镇气泡水与芹菜条。",
  "storage": "冷藏两天内吃完，复热用烤箱一百八十度烤八分钟恢复脆度；微波会让脆壳完全变软。",
