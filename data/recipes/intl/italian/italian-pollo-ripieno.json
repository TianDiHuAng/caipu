  "equipment": [
    "平底锅",
    "烤箱",
    "牙签",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉横刀片开但不切断，摊平成一大片，两面撒盐与黑胡椒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "片开时手压住上面轻轻拉刀，厚度才一致。",
      "visual_cue": "肉片摊开成均匀的薄片，中间连着不断"
    },
    {
      "n": 2,
      "text": "用刀背在肉面上轻轻敲几下，让厚度更均匀也更易入味。",
      "time_min": 4,
      "heat": "无火",
      "tip": "轻轻敲几下就好，敲散了纤维口感会发柴。",
      "visual_cue": "肉面平整，厚薄基本一致"
    },
    {
      "n": 3,
      "text": "肉片内侧铺番茄薄片、帕玛森芝士、蒜末与罗勒叶。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馅料要铺到边缘留一指空隙，卷时不会挤出来。",
      "visual_cue": "馅料均匀铺开，边缘留出空白"
    },
    {
      "n": 4,
      "text": "从一侧卷起成柱状，用牙签固定两端与接口处。",
      "time_min": 5,
      "heat": "无火",
      "tip": "牙签要斜插穿透，煎的时候才不会松脱。",
      "visual_cue": "肉卷紧实圆润，牙签固定牢固"
    },
    {
      "n": 5,
      "text": "平底锅中火热橄榄油，肉卷下锅把接口朝下先煎定型。",
      "time_min": 7,
      "heat": "中火",
      "tip": "接口先接触锅面，表面受热收紧后就不会散开。",
      "visual_cue": "肉卷表面金黄，接口闭合不上翘"
    },
    {
      "n": 6,
      "text": "转动肉卷把各个面都煎上色，总共煎约六分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "用夹子翻动比锅铲好，形状能保持完整。",
      "visual_cue": "各面焦黄均匀，肉卷微微鼓起"
    },
    {
      "n": 7,
      "text": "烤箱预热一百八十度，肉卷移进烤盘烤十二分钟。",
      "time_min": 14,
      "heat": "大火",
      "tip": "中心温度到七十五度才算熟透，肉厚要延长时间。",
      "visual_cue": "表面干香，按压有弹性"
    },
    {
      "n": 8,
      "text": "平底锅留着煎出的底味，倒入白葡萄酒小火收成汁。",
      "time_min": 4,
      "heat": "小火",
      "tip": "边煮边刮锅底的焦香，汁的味道才够厚。",
      "visual_cue": "汁液略稠，刮起褐色锅巴"
    },
    {
      "n": 9,
      "text": "肉卷取出静置三分钟拔掉牙签，切片淋汁，配洋葱丝上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置后再切，肉汁不会全流失在案板上。",
      "visual_cue": "切面肉白馅红，汁液清亮"
    }
  ],
  "tips": [
    "鸡胸肉提前用盐水泡半小时，口感更嫩。",
    "馅里加一片火腿，咸香层次更足。",
    "没有白葡萄酒可以用清水加半颗柠檬替代。",
    "配烤土豆或者清炒菠菜都很合适。"
  ],
  "common_mistakes": [
    "肉片敲得太散，卷起之后一煎就裂开。",
    "不先用平底锅定型直接烤，接口松开馅料全跑出来。",
    "烤的时间不够，切开的肉芯还带着粉色。"
  ],
  "substitutions": [
    {
      "original": "白葡萄酒",
      "substitute": "清水",
      "ratio": "60毫升:60毫升",
      "note": "加半颗柠檬汁补酸，风味略淡。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "面包糠",
      "ratio": "40克:30克",
      "note": "吸汁效果更好，奶香会淡一些。"
    }
  ],
  "variations": [
    "馅料换成蘑菇与芝士，做成菌菇版本。",
    "外层再裹一层面包糠去烤，口感更脆。"
  ],
  "serving_suggestion": "切片摆盘，淋上锅里的汁，配洋葱丝和烤土豆一起上桌。",
  "storage": "冷藏两天，切片后小火加少量清水翻热，避免微波变柴。",
