        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "料理机",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "口蘑用湿布擦净切厚片，洋葱与胡萝卜切细丁，大蒜切末。",
      "time_min": 12,
      "heat": "无火",
      "tip": "口蘑别用水泡，吸了水就炒不出那股焦香。",
      "visual_cue": "蘑菇片厚约半厘米，切面洁白"
    },
    {
      "n": 2,
      "text": "厚底锅下橄榄油，中火炒洋葱与胡萝卜丁八分钟到软甜。",
      "time_min": 8,
      "heat": "中火",
      "tip": "蔬菜丁炒到透明，酱的底色才不寡淡。",
      "visual_cue": "丁粒变软透明，锅底留下浅褐色痕迹"
    },
    {
      "n": 3,
      "text": "下口蘑片中大火炒六分钟，出水后收干到边缘焦黄。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "蘑菇先出水再回干，鲜味才会被牢牢浓缩住。",
      "visual_cue": "蘑菇体积缩小一半，边缘焦褐"
    },
    {
      "n": 4,
      "text": "淋入白葡萄酒煮两分钟，让酒气完全挥发只剩甜香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "酒气不散会盖住蘑菇香，闻到甜味才算好。",
      "visual_cue": "锅底液体减少，酒香转为甜香"
    },
    {
      "n": 5,
      "text": "加进番茄丁与香叶，转小火加盖慢慢煮二十五分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "中途搅两次防粘底，太稠就补两勺清水。",
      "visual_cue": "酱汁咕嘟冒小泡，表面浮起番茄红油"
    },
    {
      "n": 6,
      "text": "拣出香叶，加盐与黑胡椒，用料理机打成粗粒酱。",
      "time_min": 4,
      "heat": "无火",
      "tip": "点动打三四下就够，保留蘑菇颗粒感。",
      "visual_cue": "酱体浓稠带颗粒，颜色砖红"
    }
  ],
  "tips": [
    "多种蘑菇混用，鲜味层次比单一品种更厚。",
    "打酱前留一小勺蘑菇片最后拌回，口感更有层次。",
    "装瓶前先趁热装并倒扣排气，冷藏能放更久。",
    "拌面时加一勺煮面水，酱能更好地挂在面上。"
  ],
  "common_mistakes": [
    "蘑菇下锅前用水泡过，一炒就出汤，香气全跑光。",
    "全程开大火收汁，番茄糊在锅底带出一股焦苦味。",
    "料理机打得太久，酱变成均匀糊状失去口感。"
  ],
  "substitutions": [
    {
      "original": "口蘑",
      "substitute": "香菇",
      "ratio": "400克:350克",
      "note": "香菇味重，用量略减更平衡。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "料酒",
      "ratio": "60毫升:50毫升",
      "note": "香气不同，适合中式口味。"
    }
  ],
  "variations": [
    "加一把牛肉末同炒，做成肉酱版本更下饭。",
    "换成纯蘑菇不加番茄，加淡奶油打成白酱配牛排。"
  ],
  "serving_suggestion": "拌意面或抹在烤面包上，冷藏后也可当冷盘的蘸酱。",
  "storage": "冷藏四天，冷冻可存一个月，复热须煮沸后再食用。",
