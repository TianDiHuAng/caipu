      ]
    }
  ],
  "equipment": [
    "平底锅",
    "砧板",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切两厘米厚的方块，铺厨房纸压十分钟吸掉水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "厚块煎出来外脆内嫩，切太薄一煎就成硬片。",
      "visual_cue": "豆腐块干爽，纸吸出湿痕"
    },
    {
      "n": 2,
      "text": "平底锅烧热橄榄油，豆腐块依次下锅，块与块之间不要重叠。",
      "time_min": 3,
      "heat": "中火",
      "tip": "块与块之间留空隙，挤在一起水汽散不掉，煎不脆。",
      "visual_cue": "油面微微起纹，豆腐排开"
    },
    {
      "n": 3,
      "text": "一面煎四分钟到金黄结壳，翻面再煎三分钟到同样颜色。",
      "time_min": 8,
      "heat": "中火",
      "tip": "一面煎定型再翻，急着翻会把嫩面翻碎。",
      "visual_cue": "两面金黄，边缘焦脆起壳"
    },
    {
      "n": 4,
      "text": "把豆腐推到锅边，空出的地方下蒜与口蘑片煎香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蘑菇别急着翻，铺平煎到出水收干才有焦香。",
      "visual_cue": "蘑菇出水收干，边缘发褐"
    },
    {
      "n": 5,
      "text": "倒白葡萄酒，撒盐与黑胡椒，让酒气散尽后翻匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酒后要煮到闻不到酒冲味，否则盖住蘑菇的香。",
      "visual_cue": "酒气散去，锅里油汁清亮"
    },
    {
      "n": 6,
      "text": "关火撒欧芹碎与柠檬皮屑，翻匀后趁热装盘上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬皮只取黄色部分，刮到白色那层会发苦。",
      "visual_cue": "香草翠绿，皮屑细黄点点"
    }
  ],
  "tips": [
    "这是一道十五分钟就能上桌的意式家常菜，材料随手可得。",
    "老豆腐比嫩豆腐更适合煎，煎完还能保住形状。",
    "配一片烤面包，把锅里的油汁全抹干净。"
  ],
  "common_mistakes": [
    "豆腐水没吸干就下锅，油花四溅还粘底破皮。",
    "全程大火，豆腐外皮焦黑里面还是凉的。",
    "柠檬皮擦到白色部分，整盘菜带明显苦味。"
  ],
  "substitutions": [
    {
      "original": "口蘑",
      "substitute": "香菇",
      "ratio": "150克:150克",
      "note": "香菇香气更重，煎的时间需延长两分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "柠檬汁",
      "ratio": "40毫升:15毫升",
      "note": "柠檬汁版更清爽，需加三十毫升清水稀释。"
    }
  ],
  "variations": [
    "加一把小番茄对半切开同煎，酸甜味更明显。",
    "撒一勺面包糠同炒，口感更脆，像意大利南部的做法。"
  ],
  "serving_suggestion": "趁热装盘，配烤面包片和一杯干白葡萄酒，把锅里的油汁抹干净。",
  "storage": "冷藏可存两天，复热用平底锅小火两面各煎一分钟。",
