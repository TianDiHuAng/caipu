          "unit": "g",
          "note": "按酸度可增减",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "一小撮提酸",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小锅",
    "浅盘",
    "叉子",
    "榨汁器",
    "细筛"
  ],
  "steps": [
    {
      "n": 1,
      "text": "清水加白糖小火煮到糖完全化开，关火晾到室温备用。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖水不用煮沸太久，水汽蒸发会改变酸甜比例。",
      "visual_cue": "糖水清澈透明，无糖粒沉底"
    },
    {
      "n": 2,
      "text": "柠檬对半切开榨出果汁，用细筛滤掉果核与粗纤维，取约二百毫升。",
      "time_min": 6,
      "heat": "无火",
      "tip": "滤掉果肉渣滓，冰沙才有通透的质地。",
      "visual_cue": "果汁清亮淡黄，碗底无沉淀"
    },
    {
      "n": 3,
      "text": "果汁倒进糖水搅匀，加一小撮盐调和酸味，尝起来甜中偏酸最合适。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冰镇后甜感会变弱，所以糖水要调到比目标略甜一点。",
      "visual_cue": "混合液呈浅黄色，酸甜平衡不刺口"
    },
    {
      "n": 4,
      "text": "液体倒进浅盘冷冻一小时，表面结出薄冰后用叉子刮松，再放回冷冻。",
      "time_min": 60,
      "heat": "无火",
      "tip": "盘子越浅冻得越快，冰晶也更细。",
      "visual_cue": "表层结出薄冰，叉过留下粗糙纹路"
    },
    {
      "n": 5,
      "text": "之后每隔四十分钟刮一次，重复三次直到全部成为蓬松的冰晶，即可装杯。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刮得越勤冰晶越细，偷懒会冻成一块硬冰。",
      "visual_cue": "冰晶松散如粗砂，用勺能轻松挖起"
    }
  ],
  "tips": [
    "用黄柠檬与少量青柠混合，酸香层次比单一品种更丰富。",
    "糖量不要一次加足，先调七成再尝味补充，避免过甜。",
    "装杯前再刮松一次，冰沙看起来更蓬松不结块。"
  ],
  "common_mistakes": [
    "糖水比例太稀，冻出来是一块透明硬冰刮不动。",
    "冷冻中途完全不搅动，冰晶粗大口感像碎冰碴。",
    "柠檬汁带皮一起打碎，白色海绵层带出明显苦味。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "5 个:6 个",
      "note": "香气更冲，可多加十克白糖。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "120 克:100 克",
      "note": "甜度略低，成品质地稍软。"
    }
  ],
  "variations": [
    "拌入少量柠檬皮屑或罗勒碎，可做香气更浓的草本版本。"
  ],
  "serving_suggestion": "装进冰镇过的玻璃杯，配一片柠檬角。",
  "storage": "冷冻可存一周，吃前取出回温两分钟再刮松。",
