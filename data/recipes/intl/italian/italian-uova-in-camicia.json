  "equipment": [
    "平底锅",
    "木勺",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫三十秒后撕去皮，切成小丁备用。",
      "time_min": 8,
      "heat": "大火",
      "tip": "去皮后酱体才细腻，不会有卷起的皮，这一步千万别省。",
      "visual_cue": "番茄丁软烂，无皮，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油小火烧热，下洋葱末和蒜炒三分钟至洋葱透明出香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蒜拍碎别切末，一焦就整锅发苦，火候和顺序都要留神。",
      "visual_cue": "洋葱透明，油面泛香，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "倒入番茄丁，加盐中火炒八分钟，边炒边压，炒到出水又收干成浓酱。",
      "time_min": 10,
      "heat": "中火",
      "tip": "炒到铲子划过能见锅底才够稠，提前把配料备好再动手更稳。",
      "visual_cue": "酱体浓稠，颜色深红，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "转小火，用勺子在酱里挖三个小坑，逐个磕入鸡蛋，撒黑胡椒。",
      "time_min": 4,
      "heat": "小火",
      "tip": "坑挖深一点，蛋白才不会四处流散，这一步千万别省。",
      "visual_cue": "三颗蛋整齐分开，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "加盖小火焖三分钟，焖到蛋白完全变白凝固、蛋黄还是软的。",
      "time_min": 4,
      "heat": "小火",
      "tip": "焖的时间看蛋白，宁可多三十秒，火候和顺序都要留神。",
      "visual_cue": "蛋白洁白，蛋黄微颤，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "开盖撒奶酪丝和手撕罗勒叶，关火利用余温让奶酪化开，趁热上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火撒料，罗勒香才不被煮散，提前把配料备好再动手更稳。",
      "visual_cue": "奶酪半融，罗勒翠绿，颜色和形态变化明显"
    }
  ],
  "tips": [
    "番茄要炒到出水收干成酱，稀汤里打蛋会变成番茄蛋花汤。",
    "打蛋时在酱里挖个小坑再磕入，蛋白才不会到处流。",
    "盖盖小火焖三分钟，靠蒸汽把蛋白焖熟，蛋黄还是软的。"
  ],
  "common_mistakes": [
    "番茄没炒透就打蛋，蛋在稀汤里散成一团，蛋白蛋黄混着汤。",
    "火太大不盖盖，蛋白底部焦了上面还是透明的生蛋清。",
    "盐一开始就放足，收汁后酱变得过咸，只能兑水稀释。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "400克:400克",
      "note": "省去去皮步骤，酸度略高可加一克糖。"
    },
    {
      "original": "奶酪",
      "substitute": "橄榄油",
      "ratio": "30克:10毫升",
      "note": "纯素版本，出锅淋上即可。"
    }
  ],
  "variations": [
    "加一勺辣椒碎做成辣味版，配烤面包片蘸酱吃最过瘾。",
    "出锅前撒一把欧芹碎，颜色更亮，香气也更清新。"
  ],
  "serving_suggestion": "整锅端上桌，配硬面包片蘸着吃，或者盖在白饭上做成简易盖饭。",
  "storage": "冷藏可放一天，回热加盖小火焖五分钟，不要用大火翻动，蛋会碎。",
