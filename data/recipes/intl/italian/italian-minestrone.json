  "equipment": [
    "厚底汤锅",
    "木勺",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扁豆提前泡四小时，洋葱、胡萝卜、芹菜都切成小指甲盖大小的细丁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "三样蔬菜切得一样大，煮完口感才协调。",
      "visual_cue": "蔬菜丁大小均匀、扁豆胀大变软"
    },
    {
      "n": 2,
      "text": "厚底汤锅放橄榄油，下培根小火煸到出油、边缘微卷。",
      "time_min": 6,
      "heat": "小火",
      "tip": "培根先煸出油脂，汤的底味就从这里开始。",
      "visual_cue": "培根缩紧出油、锅底有琥珀色油层"
    },
    {
      "n": 3,
      "text": "加入洋葱、胡萝卜、芹菜丁，中火炒八分钟到蔬菜变软发甜。",
      "time_min": 8,
      "heat": "中火",
      "tip": "这一步叫炒底，耐心炒软比后面多煮十分钟更有效。",
      "visual_cue": "蔬菜丁塌软、洋葱透明不发黄"
    },
    {
      "n": 4,
      "text": "下大蒜与番茄炒到番茄出汁，加清水与扁豆煮开，撇净浮沫。",
      "time_min": 10,
      "heat": "中火",
      "tip": "番茄要炒到碎开，汤色才红亮不寡淡。",
      "visual_cue": "汤色转红、番茄皮浮起"
    },
    {
      "n": 5,
      "text": "转小火加盖煮二十五分钟，煮到扁豆软糯、汤体略稠。",
      "time_min": 25,
      "heat": "小火",
      "tip": "扁豆先煮软再放面，否则面烂豆还硬。",
      "visual_cue": "扁豆一压就散、汤面泛红色油光"
    },
    {
      "n": 6,
      "text": "下意大利面煮到八分钟，加盐调味，关火撒帕玛森芝士与黑胡椒。",
      "time_min": 8,
      "heat": "中火",
      "tip": "面在小火汤里泡着会吸汤，上桌越早越好。",
      "visual_cue": "意大利面微软留白芯、汤浓稠能挂勺"
    }
  ],
  "tips": [
    "隔夜再吃更浓，因为面会吸汤，可加清水调稀。",
    "加一块帕玛森芝士的硬皮同煮，鲜味会明显提升。",
    "夏季可加西葫芦与豆角，蔬菜越杂越好。"
  ],
  "common_mistakes": [
    "蔬菜没炒软直接加水，汤味生涩发水。",
    "面与豆同时下锅，面糊了豆还硬。",
    "一次加足盐又长时间收汁，最后咸得发苦。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "五花肉",
      "ratio": "80g 对 80g",
      "note": "需先切细条煸出油，风味接近。"
    },
    {
      "original": "扁豆",
      "substitute": "红豆",
      "ratio": "150g 对 150g",
      "note": "更绵密，煮的时间需延长十分钟。"
    }
  ],
  "variations": [
    "加入卷心菜与土豆块，做成更接近北方乡村的浓汤版。",
    "全素版省去培根，用干香菇与番茄膏补鲜。"
  ],
  "serving_suggestion": "盛深碗，淋一圈橄榄油撒帕玛森芝士，配硬壳面包蘸汤。",
  "storage": "冷藏三天，冷冻一个月；复热需加水稀释并重新调味。",
