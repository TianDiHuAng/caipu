  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "西葫芦",
          "name_en": "zucchini",
          "amount": 300,
          "unit": "g",
          "note": "选细嫩的小西葫芦",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取汁与皮屑",
          "optional": false
        },
        {
          "name": "罗勒",
          "name_en": "basil",
          "amount": 6,
          "unit": "g",
          "note": "撕成小片",
          "optional": false
        },
        {
          "name": "松子",
          "name_en": "pine nut",
          "amount": 15,
          "unit": "g",
          "note": "干锅烘香",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 30,
          "unit": "ml",
          "note": "初榨，最后淋",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "撒薄片用",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "帕玛森芝士",
          "name_en": "Parmesan",
          "amount": 20,
          "unit": "g",
          "note": "刨薄片",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "削皮刀",
    "平盘",
    "小碗",
    "刨丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西葫芦洗净擦干，用削皮刀顺着长边削成极薄的长片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "削到中间带籽的部分就停下，那一段口感发软。",
      "visual_cue": "薄片透光，边缘完整不破"
    },
    {
      "n": 2,
      "text": "薄片平铺在盘子里，一片压一片，撒上薄薄一层盐。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一片压一片摆，口感才均匀不至于夹生。",
      "visual_cue": "薄片铺满盘面，层层相叠"
    },
    {
      "n": 3,
      "text": "静置十分钟，让盐把薄片稍微腌软并渗出一点水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "时间别太长，腌过头会完全失去脆感。",
      "visual_cue": "薄片变柔韧，盘底有少量水"
    },
    {
      "n": 4,
      "text": "倒掉盘里渗出的多余水分，淋上柠檬汁与橄榄油。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬汁先淋再淋油，酸味才挂得均匀。",
      "visual_cue": "薄片微微透光，表面湿润发亮"
    },
    {
      "n": 5,
      "text": "松子用干锅小火烘到微黄，闻到坚果香后离火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "松子含油易焦，一变色就要立刻离火。",
      "visual_cue": "松子泛金，锅里飘出坚果香"
    },
    {
      "n": 6,
      "text": "撒松子、罗勒片、帕玛森芝士薄片与黑胡椒，擦一点柠檬皮屑。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬皮只取外层黄色部分，白瓤会发苦。",
      "visual_cue": "表面色彩分明，油光清亮"
    }
  ],
  "tips": [
    "选越细越嫩的西葫芦越好，籽多的大瓜不适合生吃。",
    "想要更薄可以用刨片器，但手削的更随性。",
    "上桌前冷藏十分钟，口感更清凉。",
    "配几片生火腿，咸香与清甜很搭。"
  ],
  "common_mistakes": [
    "西葫芦削得太厚，吃起来生硬像在嚼生瓜。",
    "盐放太多又腌得太久，薄片软塌还出水。",
    "松子烘过了头，一股焦苦味毁掉整盘。"
  ],
  "substitutions": [
    {
      "original": "松子",
      "substitute": "核桃",
      "ratio": "15克:20克",
      "note": "切碎烘香，口感更粗一些。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "柠檬",
      "ratio": "20克:半个",
      "note": "纯素版本，用柠檬与橄榄油补足风味。"
    }
  ],
  "variations": [
    "再加几片新鲜薄荷叶进去，清凉感更明显。",
    "把薄片一片片卷成小卷摆盘，造型更精致。"
  ],
  "serving_suggestion": "冷藏十分钟后上桌，作为开胃前菜配气泡水或白葡萄酒都很清爽。",
  "storage": "现做现吃，冷藏不超过四小时，久放会出水变软。",
