    "砧板",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "欧芹摘叶洗净，用厨房纸彻底吸干水分后切碎。",
      "time_min": 8,
      "heat": "无火",
      "tip": "叶子必须完全干，带水打出来的酱会发黑，两天就坏。",
      "visual_cue": "叶片干爽，切碎后松散不粘"
    },
    {
      "n": 2,
      "text": "面包糠倒白醋泡软，挤干水分后捏成小团备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "面包糠是这道酱的黏合剂，不放的话酱汁会分层。",
      "visual_cue": "面包糠吸饱醋，捏成团"
    },
    {
      "n": 3,
      "text": "鳀鱼与水瓜柳切到极碎，大蒜拍扁后剁成细末备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鳀鱼要剁到看不见颗粒，吃到大块会腥得跳脚。",
      "visual_cue": "碎末细匀，闻着咸香扑鼻"
    },
    {
      "n": 4,
      "text": "所有材料放研钵，边捣边分次淋橄榄油成浓稠酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "橄榄油分次淋，一次倒完酱会散，油和料拌不到一起。",
      "visual_cue": "酱体浓绿，油光均匀裹料"
    },
    {
      "n": 5,
      "text": "补盐与黑胡椒，尝一口后按需要加白醋调整酸度。",
      "time_min": 2,
      "heat": "无火",
      "tip": "鳀鱼本身很咸，加盐前先尝，很容易过咸。",
      "visual_cue": "酱色翠绿，酸咸平衡适口"
    }
  ],
  "tips": [
    "绿酱是意大利北方的万能酱，配煮肉、土豆和面包都合适。",
    "用研钵捣比机器打更香，机器转太快油会发热发苦。",
    "做好后表面淋一层橄榄油封住，能多存几天。"
  ],
  "common_mistakes": [
    "欧芹带水就打，酱色发暗，隔夜就变味。",
    "橄榄油一次猛倒，酱体分层，油浮在上面。",
    "盐放太早太多，鳀鱼的咸味全被盖住，成品死咸。"
  ],
  "substitutions": [
    {
      "original": "欧芹",
      "substitute": "罗勒",
      "ratio": "80克:70克",
      "note": "罗勒版更接近青酱，香气偏甜，适合配面。"
    },
    {
      "original": "鳀鱼",
      "substitute": "金枪鱼",
      "ratio": "20克:30克",
      "note": "金枪鱼版腥味轻，咸度低需补盐。"
    }
  ],
  "variations": [
    "加半个牛油果同捣进酱里，酱体更厚，适合抹在烤面包上。",
    "放一勺泡水瓜柳的汁调味，酸味更有层次，也更开胃。"
  ],
  "serving_suggestion": "配水煮牛肉、土豆或烤面包，也可拌意面当冷酱。",
  "storage": "冷藏可存五天，表面淋油封口，取用干净勺避免污染。",
