          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "炒锅",
    "碗",
    "打蛋器",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅加水烧开，放盐后下意大利面煮八分钟。，看准状态再往下做。",
      "time_min": 10,
      "heat": "大火",
      "tip": "水要够咸，面才有底味。，看准状态再往下做。",
      "visual_cue": "水滚面沉，汤色微白"
    },
    {
      "n": 2,
      "text": "鸡蛋只取蛋黄，加帕玛森芝士碎和黑胡椒拌匀。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "芝士和蛋先拌成糊，才不会结块。，看准状态再往下做。",
      "visual_cue": "糊体浓稠，颜色淡黄"
    },
    {
      "n": 3,
      "text": "炒锅倒橄榄油，下培根条小火煸出油。，看准状态再往下做。",
      "time_min": 6,
      "heat": "小火",
      "tip": "培根煸到边缘脆，香味才够。，看准状态再往下做。",
      "visual_cue": "培根卷曲，油色透明"
    },
    {
      "n": 4,
      "text": "加拍碎的大蒜炒出香，捞出蒜块。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜只取香，久炒会苦。，看准状态再往下做。",
      "visual_cue": "蒜香散出，蒜块金黄"
    },
    {
      "n": 5,
      "text": "意大利面留一碗面汤，捞出直接放进炒锅。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "面别过冷水，那层白色浆才是酱汁沾得住的关键。，看准状态再往下做。",
      "visual_cue": "意大利面油亮，带白色浆"
    },
    {
      "n": 6,
      "text": "锅一定要离火，再倒入蛋芝士糊用夹子快速拌匀，别让蛋结块。",
      "time_min": 3,
      "heat": "无火",
      "tip": "一定要离火拌，否则蛋会结成块。，看准状态再往下做。",
      "visual_cue": "酱体顺滑，无蛋花，别小看这一步。"
    },
    {
      "n": 7,
      "text": "分次加面汤调稀，拌到酱汁裹满意大利面。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面汤调稠度，酱才不会干巴。，看准状态再往下做。",
      "visual_cue": "酱汁裹住面，流动缓慢"
    },
    {
      "n": 8,
      "text": "撒剩余芝士碎和黑胡椒，趁热装盘。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃，凉了酱会发硬。，看准状态再往下做。",
      "visual_cue": "酱面油亮，胡椒点点"
    }
  ],
  "tips": [
    "离火再拌蛋糊，否则会炒成蛋花。，成败就在这一步。",
    "面汤是调稠的关键，别一次倒完。，这点要注意。",
    "芝士要磨碎，才融得进酱里。，这是关键点。"
  ],
  "common_mistakes": [
    "锅还热就倒蛋液，直接变炒蛋。，别嫌麻烦，做完它。",
    "面过冷水，酱汁挂不住。，这一步别省。",
    "培根不煸直接炒，油太多发腻。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "180 克:180 克",
      "note": "咸度更低，盐可略增。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "奶酪",
      "ratio": "80 克:90 克",
      "note": "拉丝更强，风味略淡。"
    }
  ],
  "variations": [
    "加一点柠檬皮屑，味道更清爽。，这步最关键。",
    "用通心粉代替直面，挂酱更厚。，很多人在这里出错。"
  ],
  "serving_suggestion": "现做现吃，配一杯干白葡萄酒。，这里最容易翻车。",
  "storage": "不建议隔夜，复热酱会结块。，别小看这一步。",
