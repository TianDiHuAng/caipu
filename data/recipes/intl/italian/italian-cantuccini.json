  "equipment": [
    "烤盘",
    "烤箱",
    "锯齿刀",
    "和面盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到一百七十度，杏仁铺在烤盘上烤八分钟出香。",
      "time_min": 10,
      "heat": "无火",
      "tip": "杏仁先烤过才脆，生杏仁直接进面团，成品发软不香。",
      "visual_cue": "杏仁微黄，闻到坚果香"
    },
    {
      "n": 2,
      "text": "鸡蛋加白糖与盐打散，倒融化黄油搅到颜色发浅。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油要放凉再加，太烫会把蛋液烫成蛋花。",
      "visual_cue": "蛋液发浅，质地顺滑无颗粒"
    },
    {
      "n": 3,
      "text": "面粉与酵母混匀过筛，倒进蛋液里拌到没有干粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌到刚好看不见干粉就停，越搅越硬，烤出来像石头。",
      "visual_cue": "面团粗糙，略带黏性不干裂"
    },
    {
      "n": 4,
      "text": "加入烤香的杏仁与柠檬皮屑，用手轻轻揉成两个长条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "杏仁要整颗揉进去，压碎了口感差，切的时候还容易散。",
      "visual_cue": "面团包住杏仁，两条粗细均匀"
    },
    {
      "n": 5,
      "text": "长条放烤盘，一百七十度烤二十五分钟到表面定型。",
      "time_min": 25,
      "heat": "无火",
      "tip": "第一遍烤到表面硬挺就够，里面不必完全烤干。",
      "visual_cue": "表面浅金，按压有硬度"
    },
    {
      "n": 6,
      "text": "取出稍放凉，用锯齿刀斜切一厘米厚片，回炉烤十五分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "一定要放凉再切，热的时候切，饼干会碎成一堆渣。",
      "visual_cue": "切片整齐，断面见杏仁"
    }
  ],
  "tips": [
    "杏仁脆饼是托斯卡纳的传统饼干，配甜酒蘸着吃最地道。",
    "两次烘烤是它酥脆的关键，第一次定型，第二次烘干水分。",
    "密封保存两周都脆，回软时回炉五分钟即可。"
  ],
  "common_mistakes": [
    "面团搅拌过度，烤出来硬得咬不动，泡酒都化不开。",
    "热着就切片，一刀下去全散成碎块，只能当碎渣吃。",
    "杏仁没烤过直接揉进去，香气寡淡，口感也偏软不脆。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "松子",
      "ratio": "150克:130克",
      "note": "松子版更香，但价格高且容易烤焦。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "40克:35毫升",
      "note": "橄榄油版更清爽，香气偏淡。"
    }
  ],
  "variations": [
    "加一把葡萄干同揉进面团，烤出来的酸甜味更明显，也很适合配茶。",
    "冷却后一端蘸融化黑巧克力，做成节日礼盒的样子，卖相更好。"
  ],
  "serving_suggestion": "切厚片配一杯甜酒或浓缩咖啡，蘸着吃最地道。",
  "storage": "密封常温可存两周，受潮后回炉一百五十度烤五分钟。",
