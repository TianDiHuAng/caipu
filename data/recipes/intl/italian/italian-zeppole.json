          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 3,
          "unit": "piece",
          "note": "烫面用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
