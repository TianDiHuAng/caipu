          "optional": false
        },
        {
          "name": "糖粉",
          "name_en": "powdered sugar",
          "amount": 40,
          "unit": "g",
          "note": "撒面",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取皮",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "打蛋器",
    "裱花袋",
    "厨房纸",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "清水加黄油和盐煮开，一次倒入全部面粉。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "面粉一次倒入，烫出的面才不结块。，看准状态再往下做。",
      "visual_cue": "面团抱团，锅底结膜"
    },
    {
      "n": 2,
      "text": "小火不停翻压面团两分钟，蒸发多余水分。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "炒干水分，炸的时候才不吸油。，看准状态再往下做。",
      "visual_cue": "面团光滑，不粘锅，这一点很关键。"
    },
    {
      "n": 3,
      "text": "面团移到碗里稍凉，分三次打入鸡蛋。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一次一个蛋，面糊才不稀。，看准状态再往下做。",
      "visual_cue": "面糊顺滑，能拉出尖"
    },
    {
      "n": 4,
      "text": "加柠檬皮屑和白糖拌匀，装进裱花袋。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "柠檬皮只取黄色部分，白的会苦。，看准状态再往下做。",
      "visual_cue": "面糊细腻，香气清新"
    },
    {
      "n": 5,
      "text": "面糊挤成小圆球，冷藏一小时定型。，看准状态再往下做。",
      "time_min": 62,
      "heat": "无火",
      "tip": "冷藏后炸，形状才圆不塌。，看准状态再往下做。",
      "visual_cue": "圆球饱满，表面光滑"
    },
    {
      "n": 6,
      "text": "植物油烧到六成热，下圆球中小火炸三分钟。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温别高，里面才熟透。，看准状态再往下做。",
      "visual_cue": "浮起油面，颜色渐深"
    },
    {
      "n": 7,
      "text": "翻动圆球炸到通体金黄，捞出沥油。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "不停翻动，颜色才均匀。，看准状态再往下做。",
      "visual_cue": "外壳深金，形状滚圆"
    },
    {
      "n": 8,
      "text": "趁热滚一层糖粉，温热吃最好。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热滚糖，糖才粘得住。，看准状态再往下做。",
      "visual_cue": "表面雪白，糖粉细密"
    }
  ],
  "tips": [
    "面粉一次倒入烫熟，面糊才蓬松。，这一点很关键。",
    "鸡蛋分次加，面糊稠度才好控。，这一点很关键。",
    "六成油温慢炸，里面才不夹生。，这一点很关键。"
  ],
  "common_mistakes": [
    "面没烫熟，炸出来硬如石头。，这一点很关键。",
    "蛋一次加完，面糊太稀挤不成球。，这一点很关键。",
    "油温太高，外面焦了里面还是生的。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "橙子",
      "ratio": "1 个:1 个",
      "note": "香气更甜，糖粉可减十克。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "60 克:50 毫升",
      "note": "少了奶香，口感略硬。"
    }
  ],
  "variations": [
    "灌入卡仕达酱，做成夹心版。，这一点很关键。",
    "表面撒肉桂糖，风味更暖。，这一点很关键。"
  ],
  "serving_suggestion": "配一杯浓缩咖啡，当下午茶。，这一点很关键。",
  "storage": "当日吃完，隔夜回软不再酥。，这一点很关键。",
  "nutrition_estimate": {
    "basis": "每份约 120 克",
