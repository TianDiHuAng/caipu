  "equipment": [
    "平底锅",
    "烤盘",
    "擦丝器",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切一厘米厚片，撒三克盐静置十分钟后彻底吸干水分。",
      "time_min": 13,
      "heat": "无火",
      "tip": "水分不吸干，裹粉挂不住，煎的时候还会炸油。",
      "visual_cue": "豆腐片干爽，表面微微收紧"
    },
    {
      "n": 2,
      "text": "平底锅倒三十毫升橄榄油，豆腐两面薄裹面粉后下锅煎。",
      "time_min": 10,
      "heat": "中火",
      "tip": "裹粉薄薄一层就够，太厚会成糊壳，咬开还是软的。",
      "visual_cue": "两面金黄，外壳薄而脆"
    },
    {
      "n": 3,
      "text": "另起锅炒洋葱末与蒜末，加番茄碎煮成浓稠的酱汁，锅边见红油。",
      "time_min": 10,
      "heat": "中火",
      "tip": "番茄汁要收浓，稀汁会把煎好的豆腐泡软。",
      "visual_cue": "番茄成酱，锅边见红油"
    },
    {
      "n": 4,
      "text": "番茄汁里加盐、黑胡椒与牛至，撒一半罗勒碎拌匀。",
      "time_min": 2,
      "heat": "小火",
      "tip": "干牛至要早放才出香，鲜罗勒则留到最后撒。",
      "visual_cue": "酱汁浓稠，香气扑鼻而来"
    },
    {
      "n": 5,
      "text": "烤盘底铺一层番茄汁，摆上豆腐片，再浇满剩余酱汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐之间留一点缝，酱汁才能包住每一片。",
      "visual_cue": "豆腐被酱汁盖住，排列平整"
    },
    {
      "n": 6,
      "text": "铺马苏里拉片，撒帕玛森芝士，二百度烤十八分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "烤到奶酪起泡冒小焦点才算到位，发白就是火候不够。",
      "visual_cue": "奶酪融化起泡，边缘焦黄"
    }
  ],
  "tips": [
    "这是意式焗茄子的豆腐版，素食者用它代替茄子和肉。",
    "豆腐先用盐逼水，口感才紧实，不会一咬全是水。",
    "剩下的番茄汁拌意面，一点不浪费。"
  ],
  "common_mistakes": [
    "豆腐没吸水就裹粉，下锅炸油还裹不匀。",
    "番茄汁太稀直接进烤盘，出炉后底下一汪水。",
    "奶酪烤到发白就出炉，没有焦香，拉丝也不够。"
  ],
  "substitutions": [
    {
      "original": "马苏里拉",
      "substitute": "奶酪",
      "ratio": "120克:120克",
      "note": "普通奶酪咸度高，盐要减两克。"
    },
    {
      "original": "豆腐",
      "substitute": "茄子",
      "ratio": "450克:450克",
      "note": "茄子版即传统焗茄子，需先煎软再焗。"
    }
  ],
  "variations": [
    "加一把肉末同炒进番茄汁，就是荤版的做法。",
    "中间夹一层菠菜，颜色更好看，营养也更全。"
  ],
  "serving_suggestion": "出炉静置五分钟再切，配一份芝麻菜沙拉和烤面包。",
  "storage": "冷藏可存两天，复烤十分钟即可恢复表面脆壳。",
