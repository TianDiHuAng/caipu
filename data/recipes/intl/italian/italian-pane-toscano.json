  "equipment": [
    "大碗",
    "烤盘",
    "刮刀",
    "烤箱",
    "冷却架"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉和干酵母倒进大碗，拌匀后中间挖坑。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "托斯卡纳面团几乎不放盐，盐量只作点缀。",
      "visual_cue": "粉类均匀，无颗块，状态稳定"
    },
    {
      "n": 2,
      "text": "倒温水，用刮刀搅到没有干粉的湿面团。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水多面团软，别急着揉。，注意火候。",
      "visual_cue": "面团湿黏，表面粗糙，状态稳定"
    },
    {
      "n": 3,
      "text": "盖布巾静置二十分钟，让面粉自己吸水。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "这一步让面筋自己形成，后续好操作。",
      "visual_cue": "面团松弛，表面稍平，状态稳定"
    },
    {
      "n": 4,
      "text": "加橄榄油和盐，折叠四次让面团收紧。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "折叠比揉更轻柔，气孔才留得住。，注意火候。",
      "visual_cue": "面团光滑，有弹性，状态稳定"
    },
    {
      "n": 5,
      "text": "发酵两小时到体积翻倍、表面起小泡。这一步不要着急。",
      "time_min": 122,
      "heat": "无火",
      "tip": "时间够了气孔才大，别中途翻动。，注意火候。",
      "visual_cue": "体积翻倍，表面多泡，状态稳定"
    },
    {
      "n": 6,
      "text": "移到烤盘上整成椭圆，表面撒薄薄一层面粉。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别拍太多气，气孔是这款面团的灵魂。",
      "visual_cue": "形状饱满，表面带粉，状态稳定"
    },
    {
      "n": 7,
      "text": "两百三十度烤二十分钟，再降到两百度烤十五分钟。",
      "time_min": 36,
      "heat": "-",
      "tip": "先高温定型，后低温烤透内部。，注意火候。",
      "visual_cue": "外壳深棕，敲击有空响"
    },
    {
      "n": 8,
      "text": "出炉放冷却架晾四十分钟再切。这一步不要着急。",
      "time_min": 42,
      "heat": "无火",
      "tip": "凉透再切，切面气孔才完整。，注意火候。",
      "visual_cue": "切面多孔，质地扎实，状态稳定"
    }
  ],
  "tips": [
    "盐量极少是这款面团的特点，别按常规加。",
    "折叠代替揉面，气孔才大。，值得留意。",
    "彻底晾凉再切，切面才漂亮。，值得留意。"
  ],
  "common_mistakes": [
    "按常规加盐，风味就变了。，值得留意。",
    "揉得太狠，气孔全被揉掉。，值得留意。",
    "热切压塌组织，切面黏连。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "部分全麦面粉",
      "ratio": "400 克:300 克加100 克",
      "note": "麦香更浓，水多加二十毫升。"
    },
    {
      "original": "干酵母",
      "substitute": "鲜酵母",
      "ratio": "5 克:15 克",
      "note": "发酵更快，一小时半即可。"
    }
  ],
  "variations": [
    "加一把迷迭香，香气更像乡村面包。，值得留意。",
    "掺入少量黑橄榄，咸香更明显。，值得留意。"
  ],
  "serving_suggestion": "切片烤脆后配橄榄油和豆子汤，是托斯卡纳的传统组合。",
  "storage": "冷冻一个月，复热用烤箱一百八十度烤八分钟。",
