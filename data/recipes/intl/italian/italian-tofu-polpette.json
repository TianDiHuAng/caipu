  "equipment": [
    "平底锅",
    "大碗",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐用厨房纸包好压上重物静置二十分钟，尽量挤干水分。",
      "time_min": 22,
      "heat": "无火",
      "tip": "水分留得太多，丸子下锅就会散开摊成一团。",
      "visual_cue": "豆腐明显变紧实，厨房纸吸得湿透"
    },
    {
      "n": 2,
      "text": "平底锅少油小火，把洋葱末与大蒜末炒到透明出香，盛出放凉。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱要炒到没有生辣味，馅料才够甜润。",
      "visual_cue": "葱末透明微软，锅里有明显甜香"
    },
    {
      "n": 3,
      "text": "大碗里把豆腐用手抓碎，加面包糠、鸡蛋、帕玛森芝士与炒好的洋葱。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用手抓比压泥更好，保留一点颗粒口感更松。",
      "visual_cue": "混合料黏成团，看不到干粉块"
    },
    {
      "n": 4,
      "text": "加盐、黑胡椒与欧芹碎拌匀，静置十分钟让面包糠吸水。",
      "time_min": 11,
      "heat": "无火",
      "tip": "静置后再整形，丸子才不会出水散架。",
      "visual_cue": "馅料变得稍干，捏起能成团不塌"
    },
    {
      "n": 5,
      "text": "手上蘸水把馅料搓成乒乓球大小的丸子，一共十二个左右。",
      "time_min": 8,
      "heat": "无火",
      "tip": "大小要一致，受热才均匀，太大会外焦里生。",
      "visual_cue": "丸子表面光滑圆整，排列成行"
    },
    {
      "n": 6,
      "text": "平底锅中火热橄榄油，丸子下锅后先不翻动，煎到底面金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅后忍住别动，等结壳再翻才不会散。",
      "visual_cue": "底面结出金黄硬壳，锅边微微冒香"
    },
    {
      "n": 7,
      "text": "轻轻翻面，把各面都煎到金黄，中途可淋锅里的油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "用锅铲托着翻，别用筷子戳，容易碎。",
      "visual_cue": "各面颜色均匀，丸子鼓起不塌陷"
    },
    {
      "n": 8,
      "text": "番茄切丁下锅，小火煮成浓稠酱汁，把丸子放回锅里焖两分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "酱汁只需微沸，久煮丸子会吸汤变软。",
      "visual_cue": "番茄化成酱，丸子半浸在红汁中"
    },
    {
      "n": 9,
      "text": "撒罗勒碎与少许帕玛森芝士，连锅端上桌即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火之后再撒芝士，香气保留得更好。",
      "visual_cue": "红汁油亮，绿叶点缀其上"
    }
  ],
  "tips": [
    "没有面包糠可以把隔夜面包搓碎晒干替代。",
    "想更香可在馅里加一点柠檬皮屑。",
    "丸子可先煎后冷冻，吃前回锅加酱焖热。",
    "搭配意面一起吃，就是完整的一份主食。"
  ],
  "common_mistakes": [
    "豆腐水分没压干，丸子下锅立刻散成碎渣。",
    "馅料不静置就整形，下锅马上出水塌陷。",
    "油温太低就下锅，丸子吸满油又软又腻。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "玉米淀粉",
      "ratio": "60克:20克",
      "note": "纯素版本，黏性略差需多加面包糠。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "盐",
      "ratio": "30克:2克",
      "note": "少了奶香，可加一点烤香的松子。"
    }
  ],
  "variations": [
    "丸子搓小一点，做成前菜配酒的小食。",
    "酱汁里加一撮辣椒碎，做成辣味版本。"
  ],
  "serving_suggestion": "连锅端上桌，配一片烤面包或一份意面，撒新鲜罗勒叶趁热吃。",
  "storage": "冷藏两天，冷冻可存两周，复热时用酱汁小火焖透。",
