  "steps": [
    {
      "n": 1,
      "text": "面粉、酵母、白糖和盐混合，加清水揉成面团。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "盐别直接碰酵母，先混匀面粉再放。，看准状态再往下做。",
      "visual_cue": "面团光滑，盆壁干净"
    },
    {
      "n": 2,
      "text": "面团抹一层橄榄油，盖布发酵到两倍大。，看准状态再往下做。",
      "time_min": 65,
      "heat": "无火",
      "tip": "室温低就放温暖处，别省这步。，看准状态再往下做。",
      "visual_cue": "体积翻倍，按压回弹"
    },
    {
      "n": 3,
      "text": "番茄去皮切碎，加蒜末和盐小火熬成稠酱。，看准状态再往下做。",
      "time_min": 12,
      "heat": "小火",
      "tip": "熬到不出水，饼底才不湿。，看准状态再往下做。",
      "visual_cue": "酱体浓稠，颜色深红"
    },
    {
      "n": 4,
      "text": "面团轻压排气，分成两份滚圆松弛十分钟。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "轻压别揉，气泡才留住。，看准状态再往下做。",
      "visual_cue": "面团圆整，表面光滑"
    },
    {
      "n": 5,
      "text": "用手从中间往外推开成圆饼，边缘留厚一圈。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用手推别擀，边缘才鼓得起来。，看准状态再往下做。",
      "visual_cue": "饼边厚，中心薄，这一点很关键。"
    },
    {
      "n": 6,
      "text": "饼皮抹一层番茄酱，留出一指宽的边。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱别抹太厚，否则中间发湿。，看准状态再往下做。",
      "visual_cue": "酱层均匀，边缘干净"
    },
    {
      "n": 7,
      "text": "马苏里拉芝士撕块铺上，淋少许橄榄油。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "芝士别铺到边上，烤时会流。，看准状态再往下做。",
      "visual_cue": "芝士分布，油光点点"
    },
    {
      "n": 8,
      "text": "烤箱两百五十度预热，烤八分钟到边缘焦斑。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "温度越高越好，饼底才脆。，看准状态再往下做。",
      "visual_cue": "边缘鼓起，焦斑点点"
    },
    {
      "n": 9,
      "text": "出炉放上鲜罗勒叶，趁热切块。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "罗勒出炉再放，香气才不被烤没。，看准状态再往下做。",
      "visual_cue": "叶色翠绿，芝士融化"
    }
  ],
  "tips": [
    "面团发酵到两倍大，饼底才蓬松。，这一点很关键。",
    "番茄酱要熬浓，否则饼底发湿。，这一点很关键。",
    "烤温尽量高，才有焦香的边缘。，这一点很关键。"
  ],
  "common_mistakes": [
    "面团没发起来，饼底像饼干。，这一点很关键。",
    "酱抹太多，中间一片湿。，这一点很关键。",
    "温度不够，烤成干硬面饼。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "马苏里拉芝士",
      "substitute": "奶酪",
      "ratio": "180 克:180 克",
      "note": "融化稍差，风味更重。"
    },
    {
      "original": "罗勒",
      "substitute": "欧芹",
      "ratio": "12 克:12 克",
      "note": "香气不同，更清爽。"
    }
  ],
  "variations": [
    "加几片火腿，咸香更足。，这一点很关键。",
    "表面撒帕玛森芝士，味道更浓。，这一点很关键。"
  ],
  "serving_suggestion": "切块趁热吃，配一杯啤酒。，这一点很关键。",
  "storage": "冷藏两天，复热烤箱两百度五分钟。",
