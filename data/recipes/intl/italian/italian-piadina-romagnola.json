  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 500,
          "unit": "g",
          "note": "中筋或零号粉",
          "optional": false
        },
        {
          "name": "猪油",
          "name_en": "lard",
          "amount": 40,
          "unit": "g",
          "note": "传统配方用猪油",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 15,
          "unit": "ml",
          "note": "刷锅防粘",
          "optional": false
        },
        {
          "name": "泡打粉",
          "name_en": "baking powder",
          "amount": 6,
          "unit": "g",
          "note": "替代酵母更省时",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "揉面时加入",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 220,
          "unit": "ml",
          "note": "温水更易成团",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "碗",
    "保鲜膜",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和泡打粉拌匀，放入猪油用手指搓成细砂状，让油脂裹住粉粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "猪油要常温软化，冷藏固态搓不开会留硬块。",
      "visual_cue": "面粉呈浅黄色粗砂状，捏一把能成团"
    },
    {
      "n": 2,
      "text": "分三次加入清水揉成偏硬的面团，揉到表面光滑后盖上保鲜膜静置半小时。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团要比做馒头硬一些，太软擀开后会粘连破洞。",
      "visual_cue": "面团光滑紧实，按压回弹缓慢"
    },
    {
      "n": 3,
      "text": "面团分成四份，撒少量干粉擀成两毫米厚的圆片，用叉子在表面扎些小孔。",
      "time_min": 10,
      "heat": "无火",
      "tip": "扎孔能防止烘烤时鼓起气泡，饼身更平整。",
      "visual_cue": "圆片厚薄均匀，透光不见明显破口"
    },
    {
      "n": 4,
      "text": "平底锅烧热抹一层橄榄油，中火把面饼烙到两面出现焦褐斑点，每面约两分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "锅一定要够热再下饼，温度低会烙得干硬不发泡。",
      "visual_cue": "饼面出现深浅不一的焦褐色斑点"
    },
    {
      "n": 5,
      "text": "烙好的饼叠起用厨房纸盖住保温，吃前趁热夹入配料对折。",
      "time_min": 2,
      "heat": "无火",
      "tip": "叠放保温能让饼皮回软，卷起来不裂。",
      "visual_cue": "饼皮柔韧可折，边缘带焦脆感"
    }
  ],
  "tips": [
    "猪油换成橄榄油也能做，但饼皮会稍硬，香气也更淡。",
    "面团静置半小时不可省，松弛到位的面筋擀开不回缩。",
    "烙好的饼趁温热夹馅，凉透后质地会明显变硬。"
  ],
  "common_mistakes": [
    "面团揉得太软，擀开时粘在案板上提不起来。",
    "锅温不足就下面饼，烙出的饼干瘪无泡口感发韧。",
    "饼皮擀得过厚，中间夹生而边缘已经焦黑。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "橄榄油",
      "ratio": "40 克:35 毫升",
      "note": "口感略硬，适合做素食版本。"
    },
    {
      "original": "泡打粉",
      "substitute": "干酵母",
      "ratio": "6 克:3 克",
      "note": "用酵母需额外发酵一小时。"
    }
  ],
  "variations": [
    "在面粉里掺入两成玉米面，可做出更粗粝有嚼劲的乡村版本。"
  ],
  "serving_suggestion": "夹生火腿、软奶酪与芝麻菜，趁热对折食用。",
  "storage": "密封常温可存两天，吃前用干锅回热三十秒。",
