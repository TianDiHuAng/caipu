        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "口蘑用湿布擦净，切成半厘米厚片。，火大了就离锅远一点。",
      "time_min": 7,
      "heat": "无火",
      "tip": "蘑菇别水洗，吸水后炒不香。，火别开太大，稳着来。",
      "visual_cue": "切片均匀，表面干爽"
    },
    {
      "n": 2,
      "text": "平底锅烧热，倒橄榄油铺满锅底。，锅温要匀，别忽高忽低。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "锅够热，蘑菇才煎得上色。，火力保持中等，慢慢来。",
      "visual_cue": "油面泛光，微微起烟"
    },
    {
      "n": 3,
      "text": "蘑菇摊平下锅，先别翻动煎三分钟。，火候宁小勿大，慢慢推进。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "别急着翻，动了就出不了焦边。，注意锅里温度别掉下来。",
      "visual_cue": "底面金黄，锅面留痕"
    },
    {
      "n": 4,
      "text": "翻面再煎两分钟，到边缘微微焦褐。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "煎到水分收干，香气才浓。，火要均匀，食材才不糊。",
      "visual_cue": "蘑菇收缩，边缘焦褐"
    },
    {
      "n": 5,
      "text": "转中火，放大蒜末炒出香味。，看住火，别让它失控。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蒜末后放，久炒会发苦。，全程留意火候，别贪快。",
      "visual_cue": "蒜香上涌，锅气扑鼻"
    },
    {
      "n": 6,
      "text": "倒白葡萄酒，煮到酒气散尽。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酒气煮掉，酸味才柔和。，火别开太大，稳着来。",
      "visual_cue": "酒液收干，锅底发亮"
    },
    {
      "n": 7,
      "text": "加盐和黑胡椒调味，撒欧芹碎出锅。，锅温要匀，别忽高忽低。",
      "time_min": 2,
      "heat": "小火",
      "tip": "欧芹最后放，颜色才翠。，火力保持中等，慢慢来。",
      "visual_cue": "绿点散布，油光柔和"
    }
  ],
  "tips": [
    "蘑菇用擦不用洗，吸水就炒不香。，别小看这一步。",
    "锅要够热，蘑菇才出焦边。，成败就在这一步。",
    "蒜末后放，久炒发苦。，这点要注意。"
  ],
  "common_mistakes": [
    "蘑菇水洗后下锅，炒出一锅水。，这是关键点。",
    "锅里堆太满，蘑菇焖成软片。，别嫌麻烦，做完它。",
    "蒜末一开始就炒，焦了发苦。，这一步别省。"
  ],
  "substitutions": [
    {
      "original": "口蘑",
      "substitute": "香菇",
      "ratio": "500 克:450 克",
      "note": "香气更重，用量略减。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "柠檬汁",
      "ratio": "50 毫升:15 毫升",
      "note": "酸味更直接，需另加清水。"
    }
  ],
  "variations": [
    "加一点辣椒碎，做成微辣。，别跳过这步。",
    "最后拌一勺黄油，口感更厚。，这步最关键。"
  ],
  "serving_suggestion": "配烤面包片，或当牛排的配菜。，很多人在这里出错。",
  "storage": "冷藏两天，复热用平底锅。，这里最容易翻车。",
