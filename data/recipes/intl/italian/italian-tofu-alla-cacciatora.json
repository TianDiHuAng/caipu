  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "木铲",
    "厨房纸",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成三厘米见方的厚块，用厨房纸吸干表面的水分。",
      "time_min": 7,
      "heat": "无火",
      "tip": "表面越干，煎的时候越不粘锅也不溅油。",
      "visual_cue": "豆腐表面干爽，块形完整"
    },
    {
      "n": 2,
      "text": "平底锅放二十毫升橄榄油，中火把豆腐块各面煎到金黄。",
      "time_min": 9,
      "heat": "中火",
      "tip": "别急着翻，等一面结壳再动就不粘。",
      "visual_cue": "六面金黄，表面微硬"
    },
    {
      "n": 3,
      "text": "煎好的豆腐块盛出，锅里补油下洋葱与胡萝卜丁炒四分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "胡萝卜切小丁才好熟，也更容易出甜味。",
      "visual_cue": "洋葱透明，胡萝卜变软"
    },
    {
      "n": 4,
      "text": "加蒜末与迷迭香炒出香味，再倒蘑菇片煎五分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蘑菇先煎到出水又收干，鲜味才浓。",
      "visual_cue": "蘑菇变软上色，锅底无汤"
    },
    {
      "n": 5,
      "text": "倒入白葡萄酒煮两分钟，让酒气挥发只剩果香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酒气煮掉，酸味才不冲。",
      "visual_cue": "液体减半，香气偏甜"
    },
    {
      "n": 6,
      "text": "加番茄丁与高汤，煮开后转小火炖八分钟成酱汁。",
      "time_min": 9,
      "heat": "小火",
      "tip": "酱汁要能挂住勺子，太稀就多收一会。",
      "visual_cue": "酱汁浓稠，色泽深红"
    },
    {
      "n": 7,
      "text": "放回豆腐块，小火轻推炖六分钟让豆腐吸饱汤汁。",
      "time_min": 7,
      "heat": "小火",
      "tip": "用推的方式翻动，别把豆腐块搅碎。",
      "visual_cue": "豆腐块完整，表面裹酱"
    },
    {
      "n": 8,
      "text": "加盐与黑胡椒，撒香菜碎，连汁一起装盘上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香菜换成欧芹更贴近原味。",
      "visual_cue": "酱汁发亮，豆腐裹满汁"
    }
  ],
  "tips": [
    "老豆腐含水少，比嫩豆腐更能撑住炖煮。",
    "煎好的豆腐可以先撒一点盐，内部更入味。",
    "剩下的酱汁拌意面或拌饭都好吃，别倒掉。",
    "加一颗切碎的酸豆，酸味会更地道。"
  ],
  "common_mistakes": [
    "豆腐不吸干水就下锅，油溅得满灶台还粘底。",
    "炖的时候猛力翻炒，豆腐全碎成渣。",
    "白葡萄酒没煮开就加高汤，酒味盖住所有香气。"
  ],
  "substitutions": [
    {
      "original": "老豆腐",
      "substitute": "豆腐",
      "ratio": "500克:500克",
      "note": "需先压水二十分钟，否则易碎。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "高汤",
      "ratio": "60毫升:70毫升",
      "note": "加半勺白醋补回酸度。"
    }
  ],
  "variations": [
    "加一把黑橄榄，做成更接近猎人鸡的南意风味。",
    "把豆腐换成煎过的蘑菇块，做成纯素炖菜版本。"
  ],
  "serving_suggestion": "三人份主菜，配意面、玉米糊或硬面包，用面包把酱汁擦干净。",
  "storage": "冷藏两天内吃完，复热小火加两勺高汤；豆腐久放易出水，不建议冷冻。",
