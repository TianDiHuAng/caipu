  "equipment": [
    "平底锅",
    "厨房纸",
    "刀",
    "锅铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用厨房纸吸干水，皮面撒盐和黑胡椒。，锅温要匀，别忽高忽低。",
      "time_min": 5,
      "heat": "无火",
      "tip": "皮要够干，煎出来才脆。，火力保持中等，慢慢来。",
      "visual_cue": "表面干爽，调料附着"
    },
    {
      "n": 2,
      "text": "皮面薄薄拍一层面粉，抖掉多余的粉。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "粉别厚，否则煎完发糊。，注意锅里温度别掉下来。",
      "visual_cue": "粉层轻薄，不见干粉"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油，皮面朝下中火煎八分钟。，始终中小火，别心急。",
      "time_min": 9,
      "heat": "中火",
      "tip": "皮朝下先煎，油脂才逼得出来。，火要均匀，食材才不糊。",
      "visual_cue": "皮面金黄，油在锅里冒"
    },
    {
      "n": 4,
      "text": "翻面再煎五分钟，盛出备用。，看住火，别让它失控。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉面煎到微黄就够，余温会透。，全程留意火候，别贪快。",
      "visual_cue": "两面焦香，按压有弹性"
    },
    {
      "n": 5,
      "text": "倒掉多余油，锅里放黄油和蒜碎小火炒香。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油别烧焦，颜色一变就倒酒。，火别开太大，稳着来。",
      "visual_cue": "黄油起泡，蒜香上涌"
    },
    {
      "n": 6,
      "text": "倒入白葡萄酒，煮到酒气散、汁减半。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酒气煮掉，只剩果香。，火力保持中等，慢慢来。",
      "visual_cue": "酒液减半，气泡变小"
    },
    {
      "n": 7,
      "text": "挤入柠檬汁、刨一点柠檬皮，搅匀成酱汁。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "小火",
      "tip": "柠檬皮只取黄色部分，白的会苦。，注意锅里温度别掉下来。",
      "visual_cue": "酱汁微稠，香气清酸"
    },
    {
      "n": 8,
      "text": "鸡腿回锅裹匀酱汁，撒欧芹碎出锅。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "回锅只翻两下，皮才不软。，火要均匀，食材才不糊。",
      "visual_cue": "皮面挂汁，绿点散布"
    }
  ],
  "tips": [
    "鸡皮吸干水，煎出来才脆。，别嫌麻烦，做完它。",
    "皮朝下先煎，油脂才逼得出。，这一步别省。",
    "柠檬皮只取黄色部分，白的发苦。，别跳过这步。"
  ],
  "common_mistakes": [
    "鸡皮带水下锅，溅油且不脆。，这步最关键。",
    "火太大，皮焦了里面还生。，很多人在这里出错。",
    "柠檬皮刨到白瓤，酱汁发苦。，这里最容易翻车。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600 克:600 克",
      "note": "煎的时间减到每面四分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "清水",
      "ratio": "60 毫升:60 毫升",
      "note": "酸味不足，柠檬多加半个。"
    }
  ],
  "variations": [
    "加一勺刺山柑，酸味更立体。，别小看这一步。",
    "撒一点辣椒碎，做成微辣口味。，成败就在这一步。"
  ],
  "serving_suggestion": "配烤土豆或意面，淋上锅里的酱汁。",
  "storage": "冷藏两天，复热用平底锅小火。，这点要注意。",
