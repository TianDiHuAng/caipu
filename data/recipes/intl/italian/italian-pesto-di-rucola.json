    "刀",
    "砧板",
    "刮刀",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芝麻菜洗净后用沙拉脱水器甩干水。，火候宁小勿大，慢慢推进。",
      "time_min": 5,
      "heat": "无火",
      "tip": "叶子要够干，酱才不澥。，注意锅里温度别掉下来。",
      "visual_cue": "叶片干爽，无水滴，成败就在这一步。"
    },
    {
      "n": 2,
      "text": "杏仁放干锅小火烤三分钟，放凉。，始终中小火，别心急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "烤过才香，别烤到发黑。，火要均匀，食材才不糊。",
      "visual_cue": "杏仁微黄，香气上涌"
    },
    {
      "n": 3,
      "text": "料理机里放杏仁和蒜，先打碎成粗粒。，看住火，别让它失控。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先打坚果，颗粒才均匀。，全程留意火候，别贪快。",
      "visual_cue": "粉体粗砂状，无整粒"
    },
    {
      "n": 4,
      "text": "加芝麻菜和盐，分次倒入橄榄油打成糊。，火大了就离锅远一点。",
      "time_min": 4,
      "heat": "无火",
      "tip": "分次倒油，酱体才顺滑。，火别开太大，稳着来。",
      "visual_cue": "酱体浓绿，能缓慢流动"
    },
    {
      "n": 5,
      "text": "加帕玛森芝士和柠檬汁，再打五秒。，锅温要匀，别忽高忽低。",
      "time_min": 2,
      "heat": "无火",
      "tip": "芝士后放，避免打热结块。，火力保持中等，慢慢来。",
      "visual_cue": "酱体细腻，颜色转浅"
    },
    {
      "n": 6,
      "text": "尝味后补盐和黑胡椒，装罐淋一层油封口。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "表面淋油隔绝空气，颜色才不变。，注意锅里温度别掉下来。",
      "visual_cue": "表面油层，颜色翠绿"
    }
  ],
  "tips": [
    "叶子甩干水，酱才不澥。，这点要注意。",
    "坚果先打碎，颗粒才均匀。，这是关键点。",
    "表面淋油封口，颜色才不氧化。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "叶子带水下锅打，酱稀如水。，这一步别省。",
    "料理机久打发热，芝士结成块。，别跳过这步。",
    "装罐不封油，放两天就发黑。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "芝麻菜",
      "substitute": "罗勒",
      "ratio": "150 克:150 克",
      "note": "味道更甜，柠檬可减半。"
    },
    {
      "original": "杏仁",
      "substitute": "松子",
      "ratio": "50 克:50 克",
      "note": "更香，价格更高。"
    }
  ],
  "variations": [
    "加一点薄荷，凉感更足。，很多人在这里出错。",
    "用开心果代替杏仁，颜色更亮。，这里最容易翻车。"
  ],
  "serving_suggestion": "拌意面、抹面包或配烤蔬菜。，别小看这一步。",
  "storage": "冷藏一周，表面保持油封。，成败就在这一步。",
