        }
      ]
    }
  ],
  "equipment": [
    "搅拌机",
    "刀",
    "砧板",
    "碗",
    "刮刀",
    "量勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "开心果去壳，用开水泡三分钟后搓掉外层薄皮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "去皮后酱色更翠绿，苦味也少。",
      "visual_cue": "果仁呈鲜绿色，无褐皮"
    },
    {
      "n": 2,
      "text": "松子放进干锅小火烘两分钟，烘到微微出油、香气冒出来就起锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "松子一变色就起锅，晚了会发苦。",
      "visual_cue": "松子微黄，香气升起"
    },
    {
      "n": 3,
      "text": "罗勒叶洗净彻底晾干，大蒜去皮切小块备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "叶子带水会让酱变稀还容易坏。",
      "visual_cue": "叶片干爽，无水滴"
    },
    {
      "n": 4,
      "text": "开心果与松子放进搅拌机，先打十秒成粗粒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先打坚果再放叶，颗粒才均匀。",
      "visual_cue": "坚果碎成米粒大小"
    },
    {
      "n": 5,
      "text": "加罗勒、大蒜、帕玛森与柠檬皮屑，点动打二十秒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "点动几次，别让刀片把叶子打热发黑。",
      "visual_cue": "混合物呈粗泥，色翠绿"
    },
    {
      "n": 6,
      "text": "分三次淋入橄榄油，每次都搅匀再加下一次。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油慢慢加，酱才乳化得顺滑不分离。",
      "visual_cue": "酱体浓稠，油被吸收"
    },
    {
      "n": 7,
      "text": "加盐与黑胡椒调味，尝一口按口味补酸或补咸。",
      "time_min": 3,
      "heat": "无火",
      "tip": "帕玛森本身很咸，盐要在最后加。",
      "visual_cue": "味道浓郁，咸鲜平衡"
    },
    {
      "n": 8,
      "text": "装进干净的玻璃瓶里，表面再淋一层橄榄油，把酱体完全封住。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油封能隔氧，颜色不易变暗。",
      "visual_cue": "表面覆油，酱体平整"
    }
  ],
  "tips": [
    "开心果用无盐的，咸味自己调更可控。",
    "抹面包、拌意面或配烤肉都好，用量比罗勒青酱更浓。",
    "没有松子可以用杏仁替代，香气会更甜一点。",
    "冷藏取出后搅一搅再用，油会自然分层。"
  ],
  "common_mistakes": [
    "罗勒带水打，酱放两天就发酸变质。",
    "橄榄油一次全倒进去，酱体分层浮油。",
    "用料理机高速打太久，叶子发热发黑变苦。"
  ],
  "substitutions": [
    {
      "original": "开心果",
      "substitute": "杏仁",
      "ratio": "150克:150克",
      "note": "香气更甜，颜色偏浅。"
    },
    {
      "original": "帕玛森",
      "substitute": "奶酪",
      "ratio": "60克:50克",
      "note": "咸度低，盐量可略增。"
    }
  ],
  "variations": [
    "加一把薄荷叶同打，做成配羊肉的清凉版本。",
    "加两勺乳清奶酪调稀，直接当意面酱汁使用。"
  ],
  "serving_suggestion": "四人份酱料，拌四百克意面或抹面包，也可作为烤肉的蘸酱。",
  "storage": "表面油封后冷藏一周，冷冻可存一个月；每次取用须用干净干勺。",
