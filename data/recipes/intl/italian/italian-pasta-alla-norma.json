  "equipment": [
    "深锅",
    "平底锅",
    "漏勺",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子切一厘米厚片，两面撒少许盐静置十分钟后擦干水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "盐渍能逼出水分和涩味，煎时吸油明显减少。",
      "visual_cue": "茄子表面出水珠、按下去变软"
    },
    {
      "n": 2,
      "text": "深锅烧开加盐的水，下意大利面按包装时间减一分钟煮到带硬芯。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水要够咸接近海水，面身才有底味，也才有足够时间煮透。",
      "visual_cue": "意大利面外软内有一点硬芯"
    },
    {
      "n": 3,
      "text": "平底锅放橄榄油中火煎茄子片，两面各煎三分钟至金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "茄子要铺平不重叠，一次煎不下就分两批。",
      "visual_cue": "两面金黄、边缘微焦发软"
    },
    {
      "n": 4,
      "text": "同锅留底油炒香大蒜，倒入番茄丁中火炒到出汁浓稠。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒到塌陷出红油，酱才够浓不水。",
      "visual_cue": "番茄完全散开、酱汁稠厚冒泡"
    },
    {
      "n": 5,
      "text": "把煎好的茄子放回酱中，加盐与黑胡椒轻轻拌匀。",
      "time_min": 5,
      "heat": "小火",
      "tip": "用铲子推不要翻拌，茄子才不会被搅烂。",
      "visual_cue": "茄子裹满红酱、形状完整"
    },
    {
      "n": 6,
      "text": "意大利面捞入酱锅，加两勺煮面水翻拌，装盘后刨上帕玛森芝士并撒罗勒。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煮面水里溶出的面筋能让酱汁挂住意面，是收汁的关键。",
      "visual_cue": "酱汁紧裹意大利面、盘底不留水"
    }
  ],
  "tips": [
    "茄子用盐渍再煎，能省一半油且不发黑。",
    "意大利面提前一分钟捞出，在酱锅里完成最后一分钟。",
    "帕玛森芝士要现刨，预刨的香气散得快。"
  ],
  "common_mistakes": [
    "茄子直接下锅不盐渍，吸油后整盘发腻。",
    "番茄炒得不够久，酱汁稀薄挂不住意大利面。",
    "意大利面煮过头再拌酱，上桌时已经软烂成团。"
  ],
  "substitutions": [
    {
      "original": "帕玛森芝士",
      "substitute": "马苏里拉芝士",
      "ratio": "40g 对 50g",
      "note": "拉丝感强但咸香略淡，需补一点盐。"
    },
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "300g 对 300g",
      "note": "水分更多，煎制时间延长两分钟。"
    }
  ],
  "variations": [
    "加入少许辣椒碎与鳀鱼，做成更浓鲜的西西里风味。",
    "把长面换成意大利面，做成更适合孩子的短面版本。"
  ],
  "serving_suggestion": "装温热深盘，撒芝士后立即上桌，趁热拌开食用。",
  "storage": "冷藏两天，复热时加一勺清水小火翻拌，避免干结。",
