        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "面包刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "法棍斜切成 1.5cm 厚的片，排入烤盘，两面各刷一层橄榄油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "斜切面积大，铺料更稳。",
      "visual_cue": "面包片大小均匀、表面油亮"
    },
    {
      "n": 2,
      "text": "烤箱预热 200℃，面包片烤 6 分钟至边缘金黄微脆。",
      "time_min": 8,
      "heat": "大火",
      "tip": "烤到边缘上色就够，全脆会硌牙。",
      "visual_cue": "边缘金黄、按压有脆响"
    },
    {
      "n": 3,
      "text": "樱桃番茄对半切，加 4g 盐、2g 黑胡椒与 20ml 橄榄油拌匀，静置 5 分钟出水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置出的汁水要留住，那是鲜味来源。",
      "visual_cue": "番茄塌软、碗底积少量红汁"
    },
    {
      "n": 4,
      "text": "趁热用蒜瓣在面包表面来回擦一遍，让蒜香渗进孔隙。",
      "time_min": 2,
      "heat": "无火",
      "tip": "面包越热，蒜香吸得越透。",
      "visual_cue": "面包表面留淡白蒜痕、香气明显"
    },
    {
      "n": 5,
      "text": "把番茄连汁舀在面包上，撒手撕罗勒叶，再淋少许橄榄油即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "上桌前再铺料，面包才不会软塌。",
      "visual_cue": "番茄铺满不溢、罗勒翠绿"
    }
  ],
  "tips": [
    "法棍选隔夜的更好切，新鲜面包反而易压扁。",
    "番茄提前半小时拌盐，出汁后有天然鲜味。",
    "罗勒用手撕不刀切，避免氧化发黑。"
  ],
  "common_mistakes": [
    "面包烤到全硬，咬下去硌牙还掉渣。",
    "番茄铺好后久放，面包吸汁变成软片。",
    "用普通橄榄油代替初榨，香气明显不足。"
  ],
  "substitutions": [
    {
      "original": "法棍",
      "substitute": "乡村面包",
      "ratio": "1 个对 6 片",
      "note": "乡村面包气孔大，吸汁更强。"
    },
    {
      "original": "樱桃番茄",
      "substitute": "普通番茄",
      "ratio": "300g 对 300g",
      "note": "需去籽切丁，避免水分过多。"
    }
  ],
  "variations": [
    "蒜香黄油版：先抹蒜香黄油再烤，奶香更浓。",
    "火腿版：铺一层 60g 帕尔玛火腿，咸鲜更足。"
  ],
  "serving_suggestion": "作为餐前小食，配一杯干白或起泡酒最合适。",
  "storage": "面包片可常温密封存 1 天，番茄料需现拌现用。",
  "nutrition_estimate": {
    "basis": "每份（2 片）",
    "calories_kcal": 260,
    "protein_g": 7,
    "fat_g": 13,
    "carbs_g": 30,
