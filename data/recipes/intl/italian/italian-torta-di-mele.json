        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "蛋糕模",
    "打蛋器",
    "大碗",
    "刮刀",
    "筛网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苹果去皮去核，切成半厘米厚的薄片，拌上柠檬汁防止变色。",
      "time_min": 10,
      "heat": "无火",
      "tip": "酸度高的青苹果烤完更有层次。",
      "visual_cue": "苹果片均匀，色未发褐"
    },
    {
      "n": 2,
      "text": "黄油隔水融化后放凉，烤箱预热到一百八十度。",
      "time_min": 6,
      "heat": "小火",
      "tip": "黄油别太烫，倒进蛋糊会把蛋烫熟。",
      "visual_cue": "黄油化成金液体，无颗粒"
    },
    {
      "n": 3,
      "text": "鸡蛋加白糖与一撮盐，用打蛋器打六分钟至发白起泡。",
      "time_min": 7,
      "heat": "无火",
      "tip": "打到蛋液能画出纹路再停，蓬松全靠这步。",
      "visual_cue": "蛋糊发白稠厚，落下有纹"
    },
    {
      "n": 4,
      "text": "低筋面粉与泡打粉过筛，分两次翻拌进蛋糊里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用刮刀从底往上翻，别画圈搅消泡。",
      "visual_cue": "面糊顺滑，无干粉结块"
    },
    {
      "n": 5,
      "text": "倒入放凉的黄油，加柠檬皮屑与肉桂，轻轻拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬皮只取黄色部分，白色会发苦。",
      "visual_cue": "面糊光亮，香气明显"
    },
    {
      "n": 6,
      "text": "蛋糕模抹油撒薄粉，先倒一半面糊，铺一层苹果片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "苹果分层铺，切面才好看也更湿润。",
      "visual_cue": "苹果片平铺，不留大空隙"
    },
    {
      "n": 7,
      "text": "倒入剩下的一半面糊，把剩余的苹果片整齐排在表面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "表面苹果排得密一点，烤出来更漂亮。",
      "visual_cue": "表面苹果成圈排列"
    },
    {
      "n": 8,
      "text": "中层烤四十五分钟，牙签插入取出无湿面糊即熟。",
      "time_min": 47,
      "heat": "中火",
      "tip": "中途上色太快就盖张锡纸。",
      "visual_cue": "表面金黄，牙签干净"
    },
    {
      "n": 9,
      "text": "出炉后晾十五分钟再脱模，完全凉透后筛上一层糖粉。",
      "time_min": 18,
      "heat": "无火",
      "tip": "热着切会散，凉透才切得整齐。",
      "visual_cue": "蛋糕体松软，切面湿润"
    }
  ],
  "tips": [
    "苹果选脆甜的，烤完仍有口感不发糯。",
    "面糊别过度搅拌，出筋就会变硬。",
    "加一勺酸奶能让蛋糕更湿润耐放。",
    "第二天回软后风味更融合，配红茶最好。"
  ],
  "common_mistakes": [
    "黄油太烫直接倒进蛋糊，蛋液结块分不成糊。",
    "苹果片切得太厚，全沉在底部，烤不透还压塌了蛋糕。",
    "出炉立刻脱模，蛋糕侧边塌陷变形。"
  ],
  "substitutions": [
    {
      "original": "低筋面粉",
      "substitute": "中筋面粉",
      "ratio": "220克:210克",
      "note": "口感略韧，需多加十毫升牛奶。"
    },
    {
      "original": "肉桂",
      "substitute": "豆蔻",
      "ratio": "2克:1克",
      "note": "香气更清冽，用量减半。"
    }
  ],
  "variations": [
    "表面撒一层杏仁片同烤，多一层坚果脆感。",
    "加一把葡萄干浸白葡萄酒，做成更浓郁的节日版本。"
  ],
  "serving_suggestion": "六人份甜点，切块配一杯红茶或甜白葡萄酒，温热食用最佳。",
  "storage": "密封室温可存两天，冷藏四天；冷藏后回温十分钟口感更松软。",
