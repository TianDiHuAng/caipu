  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "罗勒",
          "name_en": "basil",
          "amount": 100,
          "unit": "g",
          "note": "只用叶片",
          "optional": false
        },
        {
          "name": "松子",
          "name_en": "pine nut",
          "amount": 40,
          "unit": "g",
          "note": "小火焙香",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
          "note": "去皮",
          "optional": false
        },
        {
          "name": "帕玛森芝士",
          "name_en": "Parmesan",
          "amount": 50,
          "unit": "g",
          "note": "现刨",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 90,
          "unit": "ml",
          "note": "初榨，分次淋入",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "研钵",
    "料理机",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "松子放入干锅小火焙 4 分钟，不停晃锅至表面微黄并散出坚果香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "焙过头会发苦，颜色一变就离火。",
      "visual_cue": "松子微黄、香气明显"
    },
    {
      "n": 2,
      "text": "罗勒叶洗净用厨房纸彻底吸干，摘下叶片去掉粗梗备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "叶子带水会让酱容易发黑变质。",
      "visual_cue": "叶片干爽、颜色翠绿"
    },
    {
      "n": 3,
      "text": "大蒜与松子放入研钵捣成粗糊，再分次加入罗勒叶继续捣碎。",
      "time_min": 6,
      "heat": "无火",
      "tip": "捣比机器打更能保留香气与颜色。",
      "visual_cue": "混合物呈粗颗粒绿色糊状"
    },
    {
      "n": 4,
      "text": "分三次淋入 90ml 橄榄油，边淋边搅至酱体顺滑油亮。",
      "time_min": 5,
      "heat": "无火",
      "tip": "油要慢淋，才能乳化挂住。",
      "visual_cue": "酱体浓稠、油光均匀不分离"
    },
    {
      "n": 5,
      "text": "拌入 50g 帕玛森芝士与 3g 盐调味，尝一下咸淡即可装瓶。",
      "time_min": 3,
      "heat": "无火",
      "tip": "芝士本身有咸味，盐要少放。",
      "visual_cue": "咸鲜带奶香、颜色鲜绿"
    }
  ],
  "tips": [
    "全程避免高温，温度高罗勒会氧化变黑。",
    "装瓶后表面封一层橄榄油，可以延缓罗勒氧化变黑。",
    "用研钵捣出的酱颗粒感更有层次。"
  ],
  "common_mistakes": [
    "罗勒没擦干就打，成品两天就发黑发酸。",
    "料理机高速打太久，酱体发热变苦。",
    "松子焙焦了还继续用，整瓶带苦味。"
  ],
  "substitutions": [
    {
      "original": "松子",
      "substitute": "核桃仁",
      "ratio": "40g 对 40g",
      "note": "先焙香，苦味略重。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "佩科里诺芝士",
      "ratio": "50g 对 45g",
      "note": "更咸，盐需减 1g。"
    }
  ],
  "variations": [
    "开心果版：用开心果代替松子，颜色更亮。",
    "辣味版：加 1 根小米辣同捣。"
  ],
  "serving_suggestion": "拌意面、抹面包或淋在番茄上，都极合适。",
  "storage": "密封冷藏 1 周，表面封油；冷冻可存 3 个月。",
