    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑巧克力和黄油隔水融化，搅到顺滑无颗粒。，火候宁小勿大，慢慢推进。",
      "time_min": 8,
      "heat": "小火",
      "tip": "水温别太高，巧克力才不结块。，注意锅里温度别掉下来。",
      "visual_cue": "糊体油亮，流动顺滑"
    },
    {
      "n": 2,
      "text": "杏仁磨成粗粉，加盐拌匀备用。，始终中小火，别心急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "别磨太细，留一点颗粒口感更好。，火要均匀，食材才不糊。",
      "visual_cue": "粉体松散，略有颗粒"
    },
    {
      "n": 3,
      "text": "蛋黄加一半白糖打发，颜色变浅体积膨胀。，看住火，别让它失控。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到发白，蛋糕才松。，全程留意火候，别贪快。",
      "visual_cue": "蛋黄泛白，纹路留存"
    },
    {
      "n": 4,
      "text": "把巧克力糊倒进蛋黄里，搅到颜色均匀。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "无火",
      "tip": "慢慢倒边搅，避免局部凝固。，火别开太大，稳着来。",
      "visual_cue": "糊体浓稠，色深均匀"
    },
    {
      "n": 5,
      "text": "拌入杏仁粉，翻拌到看不见干粉。，锅温要匀，别忽高忽低。",
      "time_min": 3,
      "heat": "无火",
      "tip": "别画圈拌，消泡蛋糕会硬。，火力保持中等，慢慢来。",
      "visual_cue": "糊体厚重，粉感消失"
    },
    {
      "n": 6,
      "text": "蛋白加剩余白糖打到提起有尖角。，火候宁小勿大，慢慢推进。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到硬性发泡，蛋糕才立得起来。，注意锅里温度别掉下来。",
      "visual_cue": "蛋白洁白，尖角挺立"
    },
    {
      "n": 7,
      "text": "分三次把蛋白霜翻拌进巧克力糊。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "轻手翻拌，泡跑掉就发不起来。，火要均匀，食材才不糊。",
      "visual_cue": "糊体蓬松，颜色均一"
    },
    {
      "n": 8,
      "text": "倒进抹黄油撒粉的模具，表面抹平。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "无火",
      "tip": "模具处理好，脱模才完整。，全程留意火候，别贪快。",
      "visual_cue": "表面平整，无大气泡"
    },
    {
      "n": 9,
      "text": "烤箱一百七十度烤四十分钟，牙签插入带湿屑即可。",
      "time_min": 42,
      "heat": "无火",
      "tip": "带一点湿屑就出炉，烤太久会干。，火大了就离锅远一点。",
      "visual_cue": "表面微裂，中心略软"
    },
    {
      "n": 10,
      "text": "放凉后脱模，筛一层可可粉。，火别开太大，稳着来。",
      "time_min": 40,
      "heat": "无火",
      "tip": "放凉再脱模，蛋糕才不散。，锅温要匀，别忽高忽低。",
      "visual_cue": "表面哑光，切口整齐"
    }
  ],
  "tips": [
    "杏仁别磨太细，留颗粒口感更好。，别跳过这步。",
    "蛋白打到硬性发泡，蛋糕才立得住。",
    "烤到牙签带湿屑就够，别烤干。，这步最关键。"
  ],
  "common_mistakes": [
    "蛋白拌过头，蛋糕塌成饼。，很多人在这里出错。",
    "巧克力糊温度太高，拌进蛋黄结块。",
    "烤过头，蛋糕干硬掉渣。，这里最容易翻车。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "200 克:200 克",
      "note": "苦味略重，糖可多加十克。"
    },
    {
      "original": "黑巧克力",
      "substitute": "可可粉",
      "ratio": "200 克:80 克",
      "note": "需增加黄油五十克。"
    }
  ],
  "variations": [
    "表面撒一点海盐，甜味更立体。，别小看这一步。",
    "加一勺橙皮屑，香气更亮。，成败就在这一步。"
  ],
  "serving_suggestion": "切小角配一杯浓缩咖啡。，这点要注意。",
  "storage": "常温密封两天，冷藏五天。，这是关键点。",
