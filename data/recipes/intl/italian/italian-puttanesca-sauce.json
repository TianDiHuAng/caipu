  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫一分钟后撕掉外皮切成小块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "烫过皮的番茄更容易炒成浓酱，口感顺滑。",
      "visual_cue": "番茄皮易撕，果肉多汁"
    },
    {
      "n": 2,
      "text": "橄榄切成薄片，酸豆用清水冲掉表面盐分后沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酸豆用清水冲一下，酱汁才不过咸发苦。",
      "visual_cue": "橄榄片整齐，酸豆沥干"
    },
    {
      "n": 3,
      "text": "蒜切成薄片，小米辣切成小圈，和橄榄一起装盘备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜切薄片慢煎才香，切末容易炒焦发苦。",
      "visual_cue": "蒜片均匀，配料备齐"
    },
    {
      "n": 4,
      "text": "炒锅倒橄榄油，冷油下蒜片和小米辣，小火煎到蒜片浅金。",
      "time_min": 5,
      "heat": "小火",
      "tip": "冷油下蒜片，香气才慢慢释出不会焦。",
      "visual_cue": "蒜片浅金，油面泛香"
    },
    {
      "n": 5,
      "text": "加橄榄片和酸豆翻炒一分钟，炒出咸香和微微的酸气。",
      "time_min": 3,
      "heat": "中火",
      "tip": "橄榄和酸豆先炒香，咸味才会融进油里。",
      "visual_cue": "锅中油亮，香气咸鲜"
    },
    {
      "n": 6,
      "text": "倒入番茄块，加盐，中小火炒十分钟到番茄化成浓酱。",
      "time_min": 10,
      "heat": "小火",
      "tip": "番茄炒到出红油、体积减半，酱才算到位。",
      "visual_cue": "酱汁浓稠，红油浮面"
    },
    {
      "n": 7,
      "text": "撒黑胡椒拌匀，关火静置两分钟让味道融合即可使用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "静置两分钟风味融合，浇面时口感更顺。",
      "visual_cue": "酱色深红，油光发亮"
    }
  ],
  "tips": [
    "番茄先烫皮再炒，酱汁才会细腻顺滑。",
    "蒜片冷油下锅慢煎，香气足又不发焦。",
    "酸豆先用清水冲洗，否则整锅酱都过咸。"
  ],
  "common_mistakes": [
    "番茄不去皮直接炒，酱里全是卷起的皮。",
    "蒜片热油下锅，几秒钟就焦成黑点。",
    "酸豆不冲洗，酱汁咸得根本没法入口。"
  ],
  "substitutions": [
    {
      "original": "橄榄",
      "substitute": "橄榄酱",
      "ratio": "80 克:60 克",
      "note": "咸度更高，盐减至一克。"
    },
    {
      "original": "酸豆",
      "substitute": "青柠",
      "ratio": "30 克:30 克",
      "note": "取汁替换，酸味更清爽。"
    }
  ],
  "variations": [
    "加两勺番茄泥同炒，酱体更厚实浓稠。",
    "撒一把奶酪碎，咸香更接近餐馆的味道。"
  ],
  "serving_suggestion": "浇在刚煮好的面条上拌匀，撒一层奶酪碎更香。",
  "storage": "冷藏三天，复热时小火加少许面汤调开。",
