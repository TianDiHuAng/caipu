  "steps": [
    {
      "n": 1,
      "text": "小牛肉整块用棉线捆紧，表面抹盐。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "捆紧让肉受热均匀，切片才成圆形。，注意火候。",
      "visual_cue": "形状规整，表面均匀，状态稳定"
    },
    {
      "n": 2,
      "text": "炖锅放洋葱、胡萝卜和芹菜铺底，摆上牛肉。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蔬菜垫底，肉不粘锅还添香。，注意火候。",
      "visual_cue": "蔬菜平铺，肉放中央，状态稳定"
    },
    {
      "n": 3,
      "text": "倒白葡萄酒和清水，水面刚没过牛肉。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "水别多，味道才不被稀释。，注意火候。",
      "visual_cue": "液体没过，蔬菜浮起，状态稳定"
    },
    {
      "n": 4,
      "text": "放月桂叶，小火保持微沸炖三十五分钟。这一步不要着急。",
      "time_min": 36,
      "heat": "小火",
      "tip": "水只能冒小泡，滚了肉会散。，注意火候。",
      "visual_cue": "汤面微颤，肉色转白，状态稳定"
    },
    {
      "n": 5,
      "text": "关火让牛肉在汤里泡到完全冷却。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡在汤里肉才嫩而不柴。，注意火候。",
      "visual_cue": "肉质紧实，按压有弹性"
    },
    {
      "n": 6,
      "text": "金枪鱼、鳀鱼、酸豆和蛋黄酱放料理机。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鳀鱼是提鲜的关键，别省。，注意火候。",
      "visual_cue": "材料入罐，量齐，状态稳定"
    },
    {
      "n": 7,
      "text": "加柠檬汁和橄榄油打三十秒成顺滑酱汁。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打到能流动，太稠就加点肉汤。，注意火候。",
      "visual_cue": "酱体顺滑，颜色浅粉，状态稳定"
    },
    {
      "n": 8,
      "text": "牛肉拆线切成两毫米薄片，摆进盘里。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "肉凉透再切，切面才不散。，注意火候。",
      "visual_cue": "薄片完整，纹理清晰，状态稳定"
    },
    {
      "n": 9,
      "text": "淋上金枪鱼酱，撒酸豆，冷藏二十分钟再上桌。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冷藏一下风味融合，口感更凉。，注意火候。",
      "visual_cue": "酱层均匀，色泽奶白，状态稳定"
    }
  ],
  "tips": [
    "牛肉煮好一定泡在汤里凉透，肉才嫩。，值得留意。",
    "鳀鱼别省，是酱汁的鲜味来源。，值得留意。",
    "肉凉透再切，薄片才成形。，值得留意。"
  ],
  "common_mistakes": [
    "大火滚煮，肉纤维全散。，值得留意。",
    "酱打得太稠，淋不开。，值得留意。",
    "热的时候切，肉片碎成渣。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "小牛肉",
      "substitute": "鸡胸肉",
      "ratio": "500 克:500 克",
      "note": "炖制时间减到二十分钟。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "希腊酸奶",
      "ratio": "80 克:90 克",
      "note": "更清爽，酸味略重。"
    }
  ],
  "variations": [
    "酱里加一勺刺山柑花蕾，酸香更足。，值得留意。",
    "肉片下垫一层芝麻菜，口感更清。，值得留意。"
  ],
  "serving_suggestion": "冷藏后当开胃菜上桌，配一杯干白葡萄酒最合适。",
  "storage": "冷藏两天，酱汁与肉分开存放。，效果更稳定。",
