  "equipment": [
    "小锅",
    "木勺",
    "蒜压",
    "小砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蒜剥皮切薄片，鳀鱼柳沥干油切碎。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蒜切薄片，煮的时候才化得开。，注意火候。",
      "visual_cue": "蒜片均匀，鳀鱼碎细，状态稳定"
    },
    {
      "n": 2,
      "text": "小锅倒橄榄油，冷油下蒜片开小火。这一步不要着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "冷油下蒜，慢慢升温才不焦。，注意火候。",
      "visual_cue": "油面平静，蒜片沉底，状态稳定"
    },
    {
      "n": 3,
      "text": "保持小火浸煮八分钟，蒜片变软发白。这一步不要着急。",
      "time_min": 9,
      "heat": "小火",
      "tip": "只冒小泡，油一滚蒜就发苦。，注意火候。",
      "visual_cue": "蒜片透明，油色微黄，状态稳定"
    },
    {
      "n": 4,
      "text": "下鳀鱼碎，用木勺慢慢压散拌开。这一步不要着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "压着拌，鳀鱼才化进油里。，注意火候。",
      "visual_cue": "鱼碎溶解，油色变深，状态稳定"
    },
    {
      "n": 5,
      "text": "加黄油搅到完全融化，酱汁变稠。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油别烧开，否则油水分离。，注意火候。",
      "visual_cue": "酱汁浓稠，油润发光，状态稳定"
    },
    {
      "n": 6,
      "text": "倒牛奶搅匀，撒黑胡椒和盐调味。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "牛奶让酱汁柔和，别一次倒太多。，注意火候。",
      "visual_cue": "颜色奶褐，质地顺滑，状态稳定"
    },
    {
      "n": 7,
      "text": "盛进小砂锅，放在小火炉上保温上桌。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "凉了会凝，最好边吃边保温。，注意火候。",
      "visual_cue": "表面油亮，香气冲鼻，状态稳定"
    }
  ],
  "tips": [
    "冷油下蒜小火慢煮，才不会发苦。，值得留意。",
    "鳀鱼要压散化进油里，鲜味才匀。，值得留意。",
    "黄油别烧开，否则油水分离。，值得留意。"
  ],
  "common_mistakes": [
    "火太大，蒜片焦黑发苦。，值得留意。",
    "牛奶一次倒太多，酱汁稀散。，值得留意。",
    "酱凉了再吃，凝成一块。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鳀鱼",
      "substitute": "凤尾鱼酱",
      "ratio": "40 克:20 克",
      "note": "咸度更高，盐可省去。"
    },
    {
      "original": "黄油",
      "substitute": "淡奶油",
      "ratio": "60 克:70 毫升",
      "note": "更清爽，浓稠度略低。"
    }
  ],
  "variations": [
    "加一片松露碎，香气更奢。，值得留意。",
    "用核桃油替一半橄榄油，坚果香更明显。"
  ],
  "serving_suggestion": "配生蔬菜条蘸食，或浇在煮土豆和烤椒上都很地道。",
  "storage": "冷藏三天，复热须小火慢搅至融化。，效果更稳定。",
