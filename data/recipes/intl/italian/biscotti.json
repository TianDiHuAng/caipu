  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "低筋面粉",
          "name_en": "cake flour",
          "amount": 250,
          "unit": "g",
          "note": "过筛",
          "optional": false
        },
        {
          "name": "杏仁",
          "name_en": "almond",
          "amount": 120,
          "unit": "g",
          "note": "整粒生杏仁",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "室温",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 100,
          "unit": "g",
          "note": "细砂糖",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "打蛋器",
    "烤盘",
    "油纸",
    "锋利刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热 170 度，杏仁 120g 平铺烤盘烤 8 分钟至微香。",
      "time_min": 8,
      "heat": "中火",
      "tip": "杏仁先烤香，成品风味才足。",
      "visual_cue": "杏仁微微出油、香气明显"
    },
    {
      "n": 2,
      "text": "鸡蛋 2 个加 100g 白糖与 2g 盐，用打蛋器打发 3 分钟至颜色发白。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打到浓稠发白，饼身才够酥。",
      "visual_cue": "蛋液蓬松、提起有纹路"
    },
    {
      "n": 3,
      "text": "筛入 250g 低筋面粉，用刮刀翻拌至无干粉，不要过度搅拌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到看不见干粉就停，越拌越硬。",
      "visual_cue": "面团粗糙但不粘手"
    },
    {
      "n": 4,
      "text": "加入烤好的杏仁拌匀，把面团整形成 2 条宽 5 厘米、厚 2 厘米的长条。",
      "time_min": 6,
      "heat": "无火",
      "tip": "手上蘸水整形，面团不粘手。",
      "visual_cue": "长条表面平整、厚度一致"
    },
    {
      "n": 5,
      "text": "长条放油纸上，170 度烤 25 分钟至表面微黄，取出放凉 10 分钟。",
      "time_min": 27,
      "heat": "中火",
      "tip": "必须放凉再切，热切会全部碎掉。",
      "visual_cue": "表面浅金、按下去有弹性"
    },
    {
      "n": 6,
      "text": "用锋利刀斜切成 1.5 厘米厚的片，平铺回烤盘。",
      "time_min": 6,
      "heat": "无火",
      "tip": "斜切能让切面更大，更好烤干。",
      "visual_cue": "切片厚薄均匀、断面见杏仁"
    },
    {
      "n": 7,
      "text": "150 度再烤 15 分钟，中途翻面一次，烤至干脆。",
      "time_min": 15,
      "heat": "中火",
      "tip": "低温慢烤，水分才彻底烘走。",
      "visual_cue": "饼干干脆、掰开无软心"
    }
  ],
  "tips": [
    "杏仁先烤香再拌入，香气差别很大。",
    "长条必须完全放凉再切，否则一定碎。",
    "二烤用低温，才能彻底烤脆不焦。"
  ],
  "common_mistakes": [
    "长条还热着就切，饼干全碎成渣。",
    "面团搅拌过度，成品硬得像石头。",
    "二烤温度太高，边缘焦黑中间还软。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "核桃仁",
      "ratio": "120g 对 120g",
      "note": "切小块再拌，口感更松散。"
    },
    {
      "original": "低筋面粉",
      "substitute": "中筋面粉",
      "ratio": "250g 对 250g",
      "note": "成品略硬，可加 10g 玉米淀粉。"
    }
  ],
  "variations": [
    "加 5g 柠檬皮屑，香气更清新。",
    "一半蘸上黑巧克力，做成节日礼盒版。"
  ],
  "serving_suggestion": "配浓缩咖啡或甜酒，蘸着吃最地道。",
  "storage": "密封常温可存 2 周，受潮后回炉 100 度烤 5 分钟。",
