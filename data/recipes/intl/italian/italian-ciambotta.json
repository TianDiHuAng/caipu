  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子切成三厘米的滚刀块，撒少许盐抓匀静置十分钟逼出水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "茄子先杀水，炖的时候才不会吸掉整锅油。",
      "visual_cue": "茄块微塌，表面渗水"
    },
    {
      "n": 2,
      "text": "西葫芦切成同样大小的滚刀块，甜椒切成三厘米的方块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块要切得大小一致，炖出来的熟度才均匀。",
      "visual_cue": "菜块方正，切口平整"
    },
    {
      "n": 3,
      "text": "番茄切块，洋葱切小丁，蒜切成细末，茄子挤干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "茄子用手轻挤，去掉苦水又保留住形状。",
      "visual_cue": "茄块干爽，配料备齐"
    },
    {
      "n": 4,
      "text": "炒锅倒橄榄油烧热，下洋葱丁和蒜末小火炒到软香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱小火慢炒出甜味，底味才不会寡淡。",
      "visual_cue": "洋葱软塌，蒜香散出"
    },
    {
      "n": 5,
      "text": "加茄子块中火翻炒到表面微黄，再下甜椒块翻匀。",
      "time_min": 6,
      "heat": "中火",
      "tip": "茄子先炒到吸油饱和，后面炖煮才不会散。",
      "visual_cue": "茄块金黄，油被吸干"
    },
    {
      "n": 6,
      "text": "倒入番茄块、西葫芦和盐，盖盖小火炖十五分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "全程小火慢炖，蔬菜的甜味才会融在一起。",
      "visual_cue": "汤汁浓稠，菜块软润"
    },
    {
      "n": 7,
      "text": "开盖撒黑胡椒，转中火收两分钟汤汁后即可装盘上桌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "收汁到菜块间挂着浓汤就停，别收太干。",
      "visual_cue": "酱汁挂勺，颜色红亮"
    }
  ],
  "tips": [
    "茄子先撒盐杀水，炖的时候才不会吸光油。",
    "洋葱小火炒出甜味，整锅的底味才够厚。",
    "小火慢炖十五分钟，蔬菜的甜味才融在一起。"
  ],
  "common_mistakes": [
    "茄子不杀水直接炖，锅里的油全被吸干。",
    "全程大火猛炒，蔬菜外焦而里面还夹着生。",
    "番茄炖得太久，菜块全都化成一锅红糊。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "南瓜",
      "ratio": "300 克:320 克",
      "note": "南瓜更甜，炖制时间减三分钟。"
    },
    {
      "original": "甜椒",
      "substitute": "青椒",
      "ratio": "150 克:150 克",
      "note": "辣味更明显，黑胡椒减一克。"
    }
  ],
  "variations": [
    "最后淋一勺橄榄油，香气和光泽都更清爽。",
    "放凉后冷藏一夜，第二天味道融合得更透。"
  ],
  "serving_suggestion": "配硬面包蘸汤汁吃，或浇在短面上当面酱。",
  "storage": "冷藏两天，复热时小火加少许清水焖透。",
