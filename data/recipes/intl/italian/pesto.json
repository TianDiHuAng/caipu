  ],
  "equipment": [
    "料理机",
    "干锅",
    "玻璃瓶",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "罗勒叶摘下叶片、弃掉硬梗，用清水冲洗后彻底沥干水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "叶片带水会让酱发黑。",
      "visual_cue": "罗勒叶干爽、没有黄叶"
    },
    {
      "n": 2,
      "text": "松子放干锅小火焙香，见颜色微微转黄就立刻离火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "松子含油高，多炒十秒就糊。",
      "visual_cue": "松子微黄、香气散出"
    },
    {
      "n": 3,
      "text": "料理机放罗勒、松子、大蒜与盐，边打边分次淋入橄榄油打成粗酱。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打几下停一下，别打成泥。",
      "visual_cue": "酱体粗颗粒、颜色翠绿"
    },
    {
      "n": 4,
      "text": "倒出后拌入刨碎的帕玛森芝士，装瓶后表面封一层橄榄油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "封油能隔氧，颜色才不发黑。",
      "visual_cue": "芝士拌匀、表面油封平整"
    }
  ],
  "tips": [
    "罗勒叶一定要擦干，带水打出的酱很快发黑。",
    "松子焙到微黄就够，多一秒就带苦味。",
    "装瓶后封一层橄榄油，能放更久不氧化。"
  ],
  "common_mistakes": [
    "罗勒带水直接打，酱放半天就变成褐色。",
    "松子焙过头，整瓶酱都带一股苦味。",
    "一次性把所有油倒进去，打出来分层不乳化。"
  ],
  "substitutions": [
    {
      "original": "松子",
      "substitute": "核桃仁",
      "ratio": "40g 对 45g",
      "note": "价格便宜，味稍苦。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "佩科里诺奶酪",
      "ratio": "50g 对 45g",
      "note": "更咸，盐可减 1g。"
    }
  ],
  "variations": [
    "番茄青酱：加 100g 油浸番茄干同打，颜色偏砖红。",
    "坚果版：加 20g 腰果，口感更绵密。"
  ],
  "serving_suggestion": "拌意面时加一勺煮面水调开，也可抹面包、配水煮蔬菜。",
  "storage": "装瓶冷藏可存 1 周，冷冻成小块可存 3 个月。",
