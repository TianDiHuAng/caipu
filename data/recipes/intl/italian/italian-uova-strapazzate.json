  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 180,
          "unit": "g",
          "note": "三个大鸡蛋",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 6,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 25,
          "unit": "g",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "帕玛森芝士",
          "name_en": "Parmesan",
          "amount": 20,
          "unit": "g",
          "note": "刨碎",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "不粘锅",
    "打蛋器",
    "小碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进小碗，加盐与帕玛森芝士，用打蛋器打到颜色均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "芝士先拌进蛋液，炒出来咸香更均匀。",
      "visual_cue": "蛋液顺滑，颜色略泛浅黄"
    },
    {
      "n": 2,
      "text": "不粘锅小火加热，放一半黄油化开，注意不要让黄油变色。",
      "time_min": 2,
      "heat": "小火",
      "tip": "黄油一冒褐色就说明太热，蛋会炒老。",
      "visual_cue": "黄油融成一层细泡，闻着有奶香"
    },
    {
      "n": 3,
      "text": "倒入蛋液，静置十秒让底部微微定型，再用锅铲从边缘推向中间。",
      "time_min": 3,
      "heat": "小火",
      "tip": "推而不是翻，蛋液才能形成柔软的褶皱。",
      "visual_cue": "底部凝出软块，上层仍是流动状态"
    },
    {
      "n": 4,
      "text": "持续小火推炒三分钟，边推边把生的蛋液带到底下。",
      "time_min": 3,
      "heat": "小火",
      "tip": "全程小火是关键，火大蛋一下子就变硬块。",
      "visual_cue": "蛋体呈湿润的膏状，看不出液体"
    },
    {
      "n": 5,
      "text": "关火后再放剩下的黄油，用余温拌到蛋体油亮柔滑。",
      "time_min": 2,
      "heat": "无火",
      "tip": "离火之后再加黄油，口感更绵软也不出油。",
      "visual_cue": "蛋体表面发亮，边缘没有焦褐"
    },
    {
      "n": 6,
      "text": "撒上黑胡椒、小葱与欧芹碎，趁热装盘端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香草最后撒，余温足够把香气激出来。",
      "visual_cue": "绿点散在蛋上，色泽浅黄柔嫩"
    }
  ],
  "tips": [
    "鸡蛋从冷藏取出回温十分钟，炒出来更蓬松。",
    "芝士本身有咸味，盐要比平时少放一点。",
    "配一片烤面包，把蛋铺在上面就是意式早餐。",
    "想更香可在蛋液里加一勺淡奶油。"
  ],
  "common_mistakes": [
    "全程大火猛炒，蛋变成又干又硬的小碎块。",
    "蛋液里不加芝士，味道寡淡像普通炒蛋。",
    "炒好放着不收火，余温把蛋烘得发干。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "25克:20毫升",
      "note": "风味更清爽，奶香会少一点。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "盐",
      "ratio": "20克:2克",
      "note": "少了奶香，可加一瓣蒜同炒提味。"
    }
  ],
  "variations": [
    "蛋液里加几片煎过的蘑菇，口感更丰富。",
    "表面刨一点黑松露碎，做成更浓的版本。"
  ],
  "serving_suggestion": "装盘后配烤面包片与一杯黑咖啡，作为意式早餐或早午餐最合适。",
  "storage": "现炒现吃，冷藏后复热会变干，不建议保存。",
  "nutrition_estimate": {
    "basis": "按两人份估算",
