  "equipment": [
    "平底锅",
    "锅铲",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子切成两厘米见方的丁，撒一半盐拌匀静置十分钟出水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "撒盐出水后茄子不吸油，口感更紧实。",
      "visual_cue": "茄丁湿润，渗出水分，状态稳定"
    },
    {
      "n": 2,
      "text": "用厨房纸把茄丁表面的水吸干，避免下锅溅油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "吸干水再煎，茄丁才焦香不发软。，注意火候。",
      "visual_cue": "表面干爽，无明水，状态稳定"
    },
    {
      "n": 3,
      "text": "平底锅倒一半橄榄油烧热，茄丁平铺中火煎六分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "铺开别挤，煎出焦边才香。，注意火候。",
      "visual_cue": "表面焦褐，边缘收缩，状态稳定"
    },
    {
      "n": 4,
      "text": "翻动茄丁再煎三分钟到整体变软，盛出备用。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "煎到用铲子一压就软，后面炖时才不烂。",
      "visual_cue": "质地柔软，油光浮动，状态稳定"
    },
    {
      "n": 5,
      "text": "锅里倒剩余橄榄油，下洋葱碎小火炒到透明发甜。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒透，甜味才撑得住后面的酸。，注意火候。",
      "visual_cue": "洋葱透明，香气散出，状态稳定"
    },
    {
      "n": 6,
      "text": "加番茄丁炒五分钟到出汁软烂，加白糖和白醋调成酸甜汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "糖醋先调匀，味道才平衡不发呛。，注意火候。",
      "visual_cue": "汁水浓稠，酸甜扑鼻，状态稳定"
    },
    {
      "n": 7,
      "text": "倒回茄丁翻匀，小火炖八分钟让茄子吸足酸甜汁。",
      "time_min": 8,
      "heat": "小火",
      "tip": "小火慢炖，茄子才入味不散形。，注意火候。",
      "visual_cue": "茄丁挂汁，颜色深亮，状态稳定"
    },
    {
      "n": 8,
      "text": "加剩余盐调味，撒香菜碎，放凉后风味更佳。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "放凉两小时再吃，酸甜味融合得更好。",
      "visual_cue": "表面油亮，汁水微收，状态稳定"
    }
  ],
  "tips": [
    "茄丁先撒盐出水，煎的时候不吸油。，值得留意。",
    "糖醋比例先调匀再下锅，味道才平衡。，值得留意。",
    "做好放凉再吃，酸甜味会更融合。，值得留意。"
  ],
  "common_mistakes": [
    "茄丁不吸干水就下锅，油花四溅。，务必避免。",
    "醋一次倒太多，成品酸得发呛。，务必避免。",
    "大火炖茄丁，出锅全成糊状。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "白醋",
      "substitute": "苹果醋",
      "ratio": "35 毫升:35 毫升",
      "note": "酸味更圆润，白糖可减五克。"
    },
    {
      "original": "茄子",
      "substitute": "长茄",
      "ratio": "700 克:700 克",
      "note": "皮薄易软，煎制时间减两分钟。"
    }
  ],
  "variations": [
    "加一把松子或葡萄干，西西里风味更足。",
    "配烤脆的片状主食一起吃。，也很受欢迎。"
  ],
  "serving_suggestion": "冷吃热吃都合适，当配菜或前菜抹在烤片上都好。",
  "storage": "冷藏三天，风味会随时间更融合。，效果更稳定。",
