  "equipment": [
    "炒锅",
    "烤箱",
    "刀",
    "砧板",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿去骨，用肉锤敲成半厘米厚的片。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "敲到厚薄一致，煎时才均匀。，看准状态再往下做。",
      "visual_cue": "肉片摊开，边缘完整"
    },
    {
      "n": 2,
      "text": "肉片两面撒盐和黑胡椒，静置十分钟。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "先腌一会，底味才进得去。，看准状态再往下做。",
      "visual_cue": "表面微湿，调料附着"
    },
    {
      "n": 3,
      "text": "肉片依次裹面粉、蛋液和面包糠，压紧。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "压紧面包糠，煎时不易脱落。，看准状态再往下做。",
      "visual_cue": "外壳均匀，无裸露，这点要注意。"
    },
    {
      "n": 4,
      "text": "平底锅倒橄榄油，中火把鸡排煎到两面金黄。，看准状态再往下做。",
      "time_min": 8,
      "heat": "中火",
      "tip": "一面上色再翻，外壳才不破。，看准状态再往下做。",
      "visual_cue": "两面金黄，边缘焦脆"
    },
    {
      "n": 5,
      "text": "煎好的鸡排放在烤盘上，烤箱一百八十度保温。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先煎后烤，肉才嫩不外焦。，看准状态再往下做。",
      "visual_cue": "表面干爽，油光微亮"
    },
    {
      "n": 6,
      "text": "锅里留底油，下蒜末炒香后加番茄丁。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蒜末别炒焦，否则发苦。，看准状态再往下做。",
      "visual_cue": "蒜香散出，番茄出水"
    },
    {
      "n": 7,
      "text": "加盐小火熬十分钟，熬到番茄成浓酱。，看准状态再往下做。",
      "time_min": 12,
      "heat": "小火",
      "tip": "小火慢熬，酱才浓不酸。，看准状态再往下做。",
      "visual_cue": "酱体浓稠，颜色深红"
    },
    {
      "n": 8,
      "text": "鸡排上铺马苏里拉芝士，淋一勺番茄酱。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "芝士铺满，烤后才拉丝。，看准状态再往下做。",
      "visual_cue": "芝士盖满，酱色鲜红"
    },
    {
      "n": 9,
      "text": "撒帕玛森芝士，烤箱两百度烤十分钟。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "烤到芝士起泡就行，别烤干。，看准状态再往下做。",
      "visual_cue": "芝士融化，表面起泡"
    },
    {
      "n": 10,
      "text": "出炉撒罗勒碎，配剩余番茄酱上桌。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "罗勒最后放，香气才鲜。，看准状态再往下做。",
      "visual_cue": "绿点散布，芝士拉丝"
    }
  ],
  "tips": [
    "鸡排敲薄敲匀，煎烤才不柴。，这是关键点。",
    "面包糠压紧，外壳才不脱落。，别嫌麻烦，做完它。",
    "芝士铺满表面，烤出的拉丝才漂亮。"
  ],
  "common_mistakes": [
    "鸡排太厚，外面焦了里面还生。，这一步别省。",
    "番茄酱不熬，酸味压不住。，别跳过这步。",
    "芝士放太少，烤出来不拉丝。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "猪里脊",
      "ratio": "600 克:600 克",
      "note": "敲得更薄，煎的时间减两分钟。"
    },
    {
      "original": "马苏里拉芝士",
      "substitute": "奶酪",
      "ratio": "180 克:180 克",
      "note": "融化性略差，风味更浓。"
    }
  ],
  "variations": [
    "底下垫一层煮好的意大利面，做成套餐。",
    "加几片茄子同烤，口感更丰富。，很多人在这里出错。"
  ],
  "serving_suggestion": "配意面或烤蔬菜，一杯红酒。，这里最容易翻车。",
  "storage": "冷藏三天，复热烤箱一百八十度十二分钟。",
