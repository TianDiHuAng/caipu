          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 3,
          "unit": "g",
          "note": "平衡酸味",
          "optional": false
        },
        {
          "name": "红酒",
          "name_en": "red wine",
          "amount": 30,
          "unit": "ml",
          "note": "增香，可省略",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "料理机",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜椒对半切开去籽去白瓤，切口朝下摆在烤盘上。",
      "time_min": 6,
      "heat": "无火",
      "tip": "甜椒内的白瓤是苦味来源，一定要刮干净。",
      "visual_cue": "内壁干净，甜椒片平铺不重叠"
    },
    {
      "n": 2,
      "text": "烤箱预热二百度，甜椒表面刷薄薄一层橄榄油后送入烤二十分钟。",
      "time_min": 22,
      "heat": "大火",
      "tip": "烤到表皮起泡才是关键，没起泡就剥不下来。",
      "visual_cue": "表面起黑褐色气泡，边缘塌软"
    },
    {
      "n": 3,
      "text": "取出装进有盖的容器焖十分钟，让热气把皮闷松。",
      "time_min": 10,
      "heat": "无火",
      "tip": "一定要趁热焖，蒸汽会把皮与果肉分开。",
      "visual_cue": "容器内壁结满水汽，甜椒进一步软化"
    },
    {
      "n": 4,
      "text": "撕掉表皮，把甜椒肉撕成条，渗出汁水留着备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用撕不用切，果肉不与金属刀接触更少涩味。",
      "visual_cue": "果肉柔软无皮，颜色深红透亮"
    },
    {
      "n": 5,
      "text": "平底锅小火放少量橄榄油，炒软洋葱末与大蒜末。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蒜末要最后下，与洋葱同时下锅容易焦。",
      "visual_cue": "洋葱透明发软，蒜香明显"
    },
    {
      "n": 6,
      "text": "放入甜椒肉与汁水翻炒两分钟，加盐、白糖与黑胡椒。",
      "time_min": 3,
      "heat": "小火",
      "tip": "白糖只用来平衡酸，尝起来不该吃出甜。",
      "visual_cue": "酱体收稠，颜色深红油亮"
    },
    {
      "n": 7,
      "text": "倒入红酒煮一分钟挥发酒气，关火放凉三分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "红酒煮到没有刺鼻的酒精味就该停火。",
      "visual_cue": "酒气散去，只剩果香与酸香"
    },
    {
      "n": 8,
      "text": "放进料理机打十秒保留一点颗粒感，淋剩下的橄榄油，拌入罗勒碎拌匀装罐。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打太久会变成番茄酱那样的均质泥，口感单调。",
      "visual_cue": "酱体细腻中带细碎颗粒，表面泛油光"
    }
  ],
  "tips": [
    "甜椒用红黄两种，颜色和甜度都更好。",
    "拌入罗勒碎再静置半小时，香气更融合。",
    "装密封罐冷藏，可以配面包、意面或烤肉。",
    "想要更辣可以加半根辣椒一起烤。"
  ],
  "common_mistakes": [
    "甜椒烤得不够，皮撕不下来只能连皮打碎，酱带涩味。",
    "全程用大火收汁，糖分焦化味道发苦。",
    "打得太细成泥，失去了酱该有的颗粒感。"
  ],
  "substitutions": [
    {
      "original": "红酒",
      "substitute": "米醋",
      "ratio": "30毫升:10毫升",
      "note": "酸味更直接，用量要减少。"
    },
    {
      "original": "甜椒",
      "substitute": "番茄",
      "ratio": "600克:600克",
      "note": "风味转向番茄酱，可多加罗勒。"
    }
  ],
  "variations": [
    "加一点烤过的杏仁，酱体更浓稠带坚果香。",
    "拌入奶油奶酪，做成可以抹面包的酱。"
  ],
  "serving_suggestion": "装小碗搭配烤面包片、烤肉或拌意面，也可抹在三明治里提味。",
  "storage": "装密封罐冷藏一周，表面封一层橄榄油可延长保存期限。",
