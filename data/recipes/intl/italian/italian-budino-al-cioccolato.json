  },
  "servings": 4,
  "flavor": [
    "sweet",
    "rich"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "黑巧克力",
          "name_en": "dark chocolate",
          "amount": 280,
          "unit": "g",
          "note": "切碎，可可含量七成",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 100,
          "unit": "g",
          "note": "两个蛋黄",
          "optional": false
        },
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 300,
          "unit": "ml",
          "note": "打发后铺面",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 400,
          "unit": "ml",
          "note": "煮基底",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 25,
          "unit": "g",
          "note": "增稠",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 50,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小锅",
    "打蛋器",
    "模具",
    "冰箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑巧克力切碎装进碗里，尽量切得均匀细碎一些。",
      "time_min": 6,
      "heat": "无火",
      "tip": "碎得越均匀，融化的速度越一致不结块。",
      "visual_cue": "巧克力成细小碎屑，大小接近"
    },
    {
      "n": 2,
      "text": "小锅里把牛奶、白糖、玉米淀粉与盐搅匀到无颗粒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷水调淀粉才不会结粒，先搅匀再点火。",
      "visual_cue": "液体顺滑，锅底没有粉团"
    },
    {
      "n": 3,
      "text": "小火加热并不停搅拌，煮到液体变稠像浓稠的奶糊。",
      "time_min": 6,
      "heat": "小火",
      "tip": "一定要不停刮锅底，不然容易糊一层。",
      "visual_cue": "勺背挂一层薄浆，划痕能留住"
    },
    {
      "n": 4,
      "text": "关火后加入蛋黄快速搅匀，再把热浆倒入巧克力碎上。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋黄要边倒边拌，直接冲入会变蛋花。",
      "visual_cue": "巧克力开始融化，颜色转为深褐"
    },
    {
      "n": 5,
      "text": "静置两分钟后轻轻搅拌，直到巧克力顺滑无颗粒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "别用力去搅，卷入空气后会留下小气泡。",
      "visual_cue": "浆体顺滑发亮，没有未融的碎块"
    },
    {
      "n": 6,
      "text": "倒进四个小模具，表面刮平，用保鲜膜贴面盖住。",
      "time_min": 4,
      "heat": "无火",
      "tip": "贴面盖膜可以防止表面结出一层干皮。",
      "visual_cue": "表面平整，膜紧贴浆面"
    },
    {
      "n": 7,
      "text": "冷藏四小时以上，直到完全凝固，轻晃不流动。",
      "time_min": 110,
      "heat": "无火",
      "tip": "充分冷藏才能定型，急着吃会软塌塌的。",
      "visual_cue": "布丁整体紧实，倾斜杯子时不再流动"
    },
    {
      "n": 8,
      "text": "淡奶油加少许白糖打到七分发，舀在布丁表面装饰。",
      "time_min": 5,
      "heat": "无火",
      "tip": "七分发是能流动的软峰，打硬了口感发干。",
      "visual_cue": "奶油柔软有纹路，提起会缓慢垂下"
    }
  ],
  "tips": [
    "巧克力可可含量越高，甜度越低需自行调整糖量。",
    "想要更浓可以少放三十毫升牛奶。",
    "撒一点海盐在奶油上，咸甜对比更好。",
    "模具用小玻璃杯最好脱模，也可以直接在杯里吃。"
  ],
  "common_mistakes": [
    "淀粉没先调匀就加热，布丁里全是小疙瘩。",
    "热浆直接倒入蛋黄，蛋黄立刻结成蛋花。",
    "冷藏时间不够，脱模的时候整杯塌下来。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "300毫升:250毫升",
      "note": "少了奶香与蓬松感，口感更紧实。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "面粉",
      "ratio": "25克:28克",
      "note": "增稠效果相近，需多煮一分钟去粉味。"
    }
  ],
  "variations": [
    "加一勺浓缩咖啡液进去，做成摩卡风味。",
    "表面撒可可粉与橙皮屑，香气更立体。"
  ],
  "serving_suggestion": "冷藏后装小杯，顶上舀一勺打发的淡奶油，撒少许海盐或可可粉。",
  "storage": "冷藏两天，用保鲜膜贴面覆盖防干皮，不要冷冻以免出水。",
