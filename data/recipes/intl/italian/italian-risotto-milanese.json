  "equipment": [
    "厚底锅",
    "木勺",
    "小碗",
    "刀",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "藏红花放进小碗，浇两勺温热的鸡汤泡开备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用温汤而不是热水泡，香气才不被冲散。",
      "visual_cue": "汤色变成透亮的橙黄"
    },
    {
      "n": 2,
      "text": "厚底锅下橄榄油，把洋葱末小火炒到透明但不上色。",
      "time_min": 6,
      "heat": "小火",
      "tip": "火一大洋葱就焦边，饭的颜色会发灰。",
      "visual_cue": "洋葱软塌透明，没有褐色"
    },
    {
      "n": 3,
      "text": "倒入大米中火翻炒两分钟，直到米粒边缘变得半透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米粒要裹满油再下酒，后面才吸得住汤。",
      "visual_cue": "米粒中间留白点，边缘透亮"
    },
    {
      "n": 4,
      "text": "淋入白葡萄酒，用木勺不停翻炒，直到锅里的酒气完全挥发。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酒要收干再加汤，否则酸味会留在饭里。",
      "visual_cue": "锅里没有刺鼻酒气"
    },
    {
      "n": 5,
      "text": "分次加入温热鸡汤，每次一勺，边加边搅至汤汁被吸收。",
      "time_min": 16,
      "heat": "小火",
      "tip": "汤必须温热，冷汤会让米粒表层骤缩变硬。",
      "visual_cue": "饭面始终湿润，勺过留痕"
    },
    {
      "n": 6,
      "text": "加入泡好的藏红花汤与盐，再搅三分钟至米芯略带硬度。",
      "time_min": 3,
      "heat": "小火",
      "tip": "米芯保留一点硬心才是正宗口感，别煮到全软。",
      "visual_cue": "饭呈金黄，米粒分明"
    },
    {
      "n": 7,
      "text": "关火拌入冷黄油与帕玛森，加盖焖一分钟，盛盘后现磨黑胡椒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "离火拌黄油让饭体乳化，口感才绵密流开。",
      "visual_cue": "勺子舀起能缓慢流动"
    }
  ],
  "tips": [
    "鸡汤全程保持温热，边加边搅是烩饭的基本功。",
    "米饭盛盘后轻拍盘底，饭面会自然摊平显得蓬松。",
    "帕玛森要现刨，提前刨好会失去香气。"
  ],
  "common_mistakes": [
    "一次把鸡汤全倒进锅里，变成泡饭失去绵密口感。",
    "洋葱炒出焦边，整锅饭带上苦味和灰褐色。",
    "黄油在火上拌入，油水分离使饭体发稀。"
  ],
  "substitutions": [
    {
      "original": "帕玛森",
      "substitute": "格拉纳帕达诺",
      "ratio": "80 克:80 克",
      "note": "咸度接近，香气稍温和。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "干白葡萄汁",
      "ratio": "100 毫升:100 毫升",
      "note": "少了酒香，酸度仍能解腻。"
    }
  ],
  "variations": [
    "上桌前撒一点柠檬皮屑，香气更清亮。",
    "配一勺炖牛髓可做更传统的米兰吃法。"
  ],
  "serving_suggestion": "盛在浅盘里轻拍摊平，现刨帕玛森并撒黑胡椒。",
  "storage": "冷藏两天；复热加鸡汤小火搅动恢复流动感，微波易结块。",
