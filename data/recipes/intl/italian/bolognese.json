  ],
  "equipment": [
    "深炒锅",
    "汤锅",
    "木铲",
    "奶酪刨"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱与胡萝卜切细末，大蒜切末，番茄去皮切成小丁备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切得越细，酱汁越顺滑。",
      "visual_cue": "配料切细、大小均匀"
    },
    {
      "n": 2,
      "text": "炒锅倒 20ml 橄榄油，中火把洋葱末与胡萝卜末炒软 5 分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "蔬菜炒软出甜味，酱汁才有底。",
      "visual_cue": "洋葱透明、胡萝卜变软"
    },
    {
      "n": 3,
      "text": "下牛肉末转大火炒散至完全变色，加蒜末炒出香味。",
      "time_min": 6,
      "heat": "大火",
      "tip": "肉末要炒散，结块会影响口感。",
      "visual_cue": "肉末松散、无大块结团"
    },
    {
      "n": 4,
      "text": "加番茄丁与番茄酱转小火熬 25 分钟，中途搅拌防止粘底。",
      "time_min": 30,
      "heat": "小火",
      "tip": "小火慢熬，酸味才会转成甜味。",
      "visual_cue": "酱汁浓稠、油色红亮"
    },
    {
      "n": 5,
      "text": "另起锅烧水，加 3g 盐后下意大利面煮 9 分钟至略带硬芯。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水里加盐，意大利面本身才有味。",
      "visual_cue": "意大利面有嚼劲、根根分明"
    },
    {
      "n": 6,
      "text": "面捞入肉酱锅拌匀，加黑胡椒与剩余盐，装盘撒芝士碎。",
      "time_min": 8,
      "heat": "中火",
      "tip": "面与酱在锅里拌，比装盘后浇更入味。",
      "visual_cue": "意大利面裹满酱汁、芝士融化"
    }
  ],
  "tips": [
    "肉酱小火熬够时间，风味才厚实不酸。",
    "煮面的水要放足盐，意大利面本身才有底味。",
    "面捞出直接进酱锅拌，挂汁更均匀。"
  ],
  "common_mistakes": [
    "肉酱只熬十分钟，番茄酸味压不住。",
    "面煮过头，拌的时候就断成碎段。",
    "酱汁太干还硬拌，成品坨成一团。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "猪肉末",
      "ratio": "300g 对 300g",
      "note": "猪肉末更油润，可少放橄榄油。"
    },
    {
      "original": "意大利面",
      "substitute": "宽扁面",
      "ratio": "300g 对 300g",
      "note": "宽面挂酱更多，煮制时间减 1 分钟。"
    }
  ],
  "variations": [
    "红酒版：熬酱时加 50ml 红酒，香气更立体。",
    "素版：牛肉末换成 200g 蘑菇碎，同样鲜。"
  ],
  "serving_suggestion": "趁热装盘，现刨芝士碎，配一杯气泡水正好。",
  "storage": "肉酱可冷藏 3 天或冷冻 1 个月，意大利面现煮现拌。",
  "nutrition_estimate": {
    "basis": "每份（约 320g）",
