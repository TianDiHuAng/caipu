        }
      ]
    }
  ],
  "equipment": [
    "大拌菜盆",
    "平底锅",
    "削皮刀",
    "沙拉勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜面包撕成两指宽的块，铺在烤盘上通风晾十五分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "要撕不要切，粗糙断面才吸得住汁又不烂。",
      "visual_cue": "面包块边缘干硬、捏起来有脆感"
    },
    {
      "n": 2,
      "text": "平底锅放一半橄榄油，中火把面包块煎到四面金黄微焦。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎过的面包更耐泡，久放也不会糊成一团。",
      "visual_cue": "面包块外表金黄、按压有脆响"
    },
    {
      "n": 3,
      "text": "番茄切块后撒一小撮盐拌匀，静置十分钟让它自然出汁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "这碗番茄汁就是沙拉的酱底，千万别倒掉。",
      "visual_cue": "盆底积起浅红色汁水"
    },
    {
      "n": 4,
      "text": "洋葱切极薄片，用冰水泡五分钟沥干，黄瓜切半月片备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡过冰水的洋葱辛辣感大减，只剩清甜。",
      "visual_cue": "洋葱片边缘卷曲、闻起来不冲"
    },
    {
      "n": 5,
      "text": "把面包、黄瓜、洋葱放入番茄盆，淋黑醋与剩余橄榄油拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌的时候用翻的手法，别把番茄压烂出水。",
      "visual_cue": "面包吸汁变深红、盆底无游离汁水"
    },
    {
      "n": 6,
      "text": "静置十分钟让味道融合，撒罗勒、剩余盐和黑胡椒再拌一次。",
      "time_min": 5,
      "heat": "无火",
      "tip": "罗勒最后放，早放会氧化发黑。",
      "visual_cue": "整体湿润不积水、罗勒翠绿完整"
    }
  ],
  "tips": [
    "面包一定要用无油无糖的硬壳面包，甜面包一泡就糊。",
    "加几条油浸凤尾鱼或马苏里拉小球，可当主菜吃。",
    "做好后二十到三十分钟内食用风味最佳。"
  ],
  "common_mistakes": [
    "面包太新鲜直接拌，成品黏成一团没有层次。",
    "番茄没提前撒盐出汁，只好额外加水冲淡味道。",
    "拌好后放冰箱久置，面包吸汁过度变成糊状。"
  ],
  "substitutions": [
    {
      "original": "黑醋",
      "substitute": "柠檬",
      "ratio": "30ml 对 半个",
      "note": "酸味更清爽，需另加一撮盐。"
    },
    {
      "original": "面包",
      "substitute": "法棍",
      "ratio": "300g 对 一根",
      "note": "切片后先烤脆，吸汁效果更好。"
    }
  ],
  "variations": [
    "加入烤过的甜椒与水煮蛋，做成托斯卡纳的丰盛版本。",
    "用西瓜代替部分番茄，做成夏季清爽版。"
  ],
  "serving_suggestion": "常温上桌，配烤肉或作为前菜，也可直接当轻食午餐。",
  "storage": "不建议久存，冷藏后会变软；剩余面包与菜分开保存可延长脆度。",
