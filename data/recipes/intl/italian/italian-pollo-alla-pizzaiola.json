        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "肉锤",
    "烤箱",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉横刀片成两片，用肉锤轻拍到一厘米厚。",
      "time_min": 10,
      "heat": "无火",
      "tip": "垫一层保鲜膜再拍，肉纤维不会被砸散。",
      "visual_cue": "肉片厚薄一致，表面平整不开裂"
    },
    {
      "n": 2,
      "text": "两面均匀撒上盐与黑胡椒，静置十分钟让咸味渗进肉里。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐早撒十分钟，煎的时候出水少不溅油。",
      "visual_cue": "肉片表面微微湿润，盐粒已经化开"
    },
    {
      "n": 3,
      "text": "平底锅中火加橄榄油，鸡胸两面各煎三分钟到金黄定型。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅后别急着翻，等底面自然离锅再动。",
      "visual_cue": "底面金黄，肉边收紧变白"
    },
    {
      "n": 4,
      "text": "番茄切丁与大蒜末下锅同炒五分钟，加牛至煮成粗酱。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒到出沙再放牛至，香气才透得出来。",
      "visual_cue": "酱汁浓稠挂铲，颜色转深红"
    },
    {
      "n": 5,
      "text": "酱汁铺在鸡胸上，盖马苏里拉，烤箱两百度烤十分钟到芝士融化。",
      "time_min": 10,
      "heat": "中火",
      "tip": "芝士盖满到肉边，能锁住肉汁不流失。",
      "visual_cue": "芝士融化冒泡，边缘微微泛焦"
    },
    {
      "n": 6,
      "text": "出炉撒上罗勒细丝，静置三分钟再切成宽条装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "罗勒最后再放，遇热太久会发黑并且香气尽失。",
      "visual_cue": "罗勒翠绿，盘底积着浅层肉汁"
    }
  ],
  "tips": [
    "鸡胸拍薄是关键，厚度均匀才不会外老内生。",
    "番茄选熟透的，酸甜足，酱不用另加糖。",
    "马苏里拉可换成帕玛森，风味更咸香适合配面。",
    "配一份煮意面拌盘底酱汁，一点不浪费。"
  ],
  "common_mistakes": [
    "鸡胸没拍薄直接煎，中心发白外面却已经煎老。",
    "番茄酱炒得太干，进烤箱后糊在肉上发苦。",
    "芝士烤到油分离才取出，口感发硬结块。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "700克:700克",
      "note": "腿肉更嫩，煎的时间延长两分钟。"
    },
    {
      "original": "马苏里拉",
      "substitute": "切达奶酪",
      "ratio": "100克:80克",
      "note": "切达味浓，盐减到三克。"
    }
  ],
  "variations": [
    "加几片黑橄榄与酸豆，做成更接近披萨的咸香版本。",
    "换成猪里脊拍薄做同款，肉香更浓适合下酒。"
  ],
  "serving_suggestion": "整片装盘，旁边配一份奶油意面或烤时蔬，酱汁不浪费。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤八分钟，别用微波炉。",
