        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "烤箱",
    "面包刀",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包切成两厘米厚的斜片，平铺在烤盘上，表面刷一层橄榄油，放入两百度的烤箱烤五到六分钟，边缘微焦上色即可取出。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面包片务必厚切，太薄容易烤透变硬，托不住番茄的水分。",
      "visual_cue": "面包边缘呈金黄脆边，按压中央有轻微回弹"
    },
    {
      "n": 2,
      "text": "番茄去蒂切成半厘米的小丁，放入碗中加盐静置五分钟，倒掉渗出的多余汁水，避免成品出水把面包泡软。",
      "time_min": 5,
      "heat": "无火",
      "tip": "番茄丁不要切得过大，否则铺在面包上容易滑落。",
      "visual_cue": "番茄丁表面微微发亮，碗底聚起少量淡红汁水"
    },
    {
      "n": 3,
      "text": "大蒜剥皮拍碎，趁面包刚出炉还热时在表面反复擦抹两遍，让蒜香渗进面包的孔隙里。",
      "time_min": 2,
      "heat": "无火",
      "tip": "面包必须趁热擦蒜，冷了蒜香渗不进去。",
      "visual_cue": "面包表面留下浅色的蒜汁痕迹"
    },
    {
      "n": 4,
      "text": "把番茄丁、手撕罗勒叶和剩余橄榄油拌匀，尝味补盐与黑胡椒，铺在面包片上，静置两分钟让汁水浸润后上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "罗勒用手撕不用刀切，刀切会让叶片氧化发黑。",
      "visual_cue": "番茄丁铺满面包表面，罗勒呈深绿色点缀"
    }
  ],
  "tips": [
    "面包烤好后不要久放，两小时内食用口感最佳。",
    "番茄静置去水是避免成品湿软的关键步骤，不可省略。"
  ],
  "common_mistakes": [
    "把番茄直接铺在生面包上送烤，导致面包吸汁塌软成为湿糊。",
    "蒜瓣切片代替擦抹，蒜味分布不均且咀嚼到生蒜刺口。"
  ],
  "substitutions": [
    {
      "original": "面包",
      "substitute": "法棍",
      "ratio": "8 片对 8 片",
      "note": "法棍更脆，需缩短烤制时间一分钟。"
    },
    {
      "original": "罗勒",
      "substitute": "欧芹叶",
      "ratio": "10g 对 10g",
      "note": "香气更清淡，颜色更浅。"
    }
  ],
  "variations": [
    "在番茄丁里拌入撕碎的马苏里拉芝士，做成奶酪版本，口感更浓郁。",
    "表面撒少量牛至碎，风味偏南意风格。"
  ],
  "serving_suggestion": "作为餐前开胃小食，四片一盘，搭配气泡水或淡白葡萄酒。",
  "storage": "番茄料与面包分开冷藏，食用前再组合，冷藏不超过一天。",
