  ],
  "equipment": [
    "深煎锅",
    "木勺",
    "砧板",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉擦干水分，两面撒盐与黑胡椒，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面一定要擦干，带水下锅只会煮出一锅水，煎不出焦壳。",
      "visual_cue": "鸡肉表面干爽，撒料均匀"
    },
    {
      "n": 2,
      "text": "深煎锅烧热橄榄油，鸡皮朝下中火煎到金黄酥脆。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸡皮朝下先煎，逼出的鸡油能让后面的菜更香。",
      "visual_cue": "鸡皮金黄起脆，锅底见油"
    },
    {
      "n": 3,
      "text": "翻面再煎三分钟到微黄，把鸡块夹出放在盘里，锅里留底油。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡块不用煎熟，后面还要炖，煎久了肉质发柴。",
      "visual_cue": "两面微黄，鸡肉中心仍带粉"
    },
    {
      "n": 4,
      "text": "原锅下洋葱丝与蒜，小火炒软后放口蘑煎到出水。",
      "time_min": 7,
      "heat": "小火",
      "tip": "蘑菇要铺平别急着翻，等一面煎上色再动，香气才出得来。",
      "visual_cue": "蘑菇出水收干，边缘发褐"
    },
    {
      "n": 5,
      "text": "倒白葡萄酒刮起锅底焦香，加番茄块与迷迭香煮开。",
      "time_min": 6,
      "heat": "中火",
      "tip": "倒酒时用木勺刮锅底，那层焦褐色就是这道菜的风味来源。",
      "visual_cue": "酒气散尽，锅底焦香刮净"
    },
    {
      "n": 6,
      "text": "鸡块回锅，盖盖小火炖二十五分钟，中途翻动一次。",
      "time_min": 27,
      "heat": "小火",
      "tip": "火要小到汤汁只冒小泡，大火滚会把鸡肉炖散。",
      "visual_cue": "汤汁浓稠，鸡肉轻推即脱骨"
    }
  ],
  "tips": [
    "猎人炖鸡是意大利乡村菜，猎人打到什么禽就炖什么，调料很随意。",
    "加一把黑橄榄同炖，咸香更足，是南部的做法。",
    "剩下的汤汁拌意面极好，别倒掉。"
  ],
  "common_mistakes": [
    "鸡肉带水下锅，煎出一锅汤，完全没有焦香。",
    "白葡萄酒倒太多没煮散，成品带明显酸涩酒味。",
    "全程大火炖，鸡肉散成一堆，汤汁也烧干发苦。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "750克:700克",
      "note": "鸡胸肉炖的时间要缩短到十五分钟，否则发柴。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "红酒",
      "ratio": "120毫升:120毫升",
      "note": "红酒版颜色深，味道更厚重，适合冬天。"
    }
  ],
  "variations": [
    "加几片培根同炖，烟熏味渗进汤汁，风味更浓。",
    "放一把白豆同炖，汤汁更稠，也能当主食 吃。"
  ],
  "serving_suggestion": "连汁带肉盛进深盘，配玉米糊或烤面包片把汤汁抹干净。",
  "storage": "冷藏可存三天，复热时小火加少量清水避免糊底。",
