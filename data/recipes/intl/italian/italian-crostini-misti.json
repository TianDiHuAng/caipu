  "equipment": [
    "烤箱",
    "烤盘",
    "面包刀",
    "拌菜碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包斜切一厘米厚片，排在烤盘上，表面刷一层橄榄油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面包片厚度一致，烤的时候才会同时上色。",
      "visual_cue": "面包片均匀排开，表面泛着油光"
    },
    {
      "n": 2,
      "text": "烤箱预热两百度，中层烤八分钟到边缘金黄发脆。",
      "time_min": 8,
      "heat": "中火",
      "tip": "烤到一半时翻一次面，两面都能烤出脆壳。",
      "visual_cue": "边缘起金黄硬壳，中心仍保有柔软"
    },
    {
      "n": 3,
      "text": "番茄切小丁，罗勒切细丝，大蒜磨成泥，与橄榄油和盐拌匀静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "番茄丁拌好先沥掉多余汁水，面包才不会回软。",
      "visual_cue": "番茄丁渗出淡红汁水，香气散开"
    },
    {
      "n": 4,
      "text": "烤好的面包片趁热用断面抹一层蒜泥，铺上番茄丁与马苏里拉薄片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "大蒜用整瓣擦一遍，量少味足又不会呛口。",
      "visual_cue": "蒜香扑鼻，芝士片平铺不重叠"
    },
    {
      "n": 5,
      "text": "回炉烤三分钟到芝士融化，出炉撒橄榄圈与黑胡椒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芝士刚化就取出，再烤油会析出分离。",
      "visual_cue": "芝士软化拉丝，边缘微微鼓起"
    }
  ],
  "tips": [
    "面包选隔夜的乡村面包，水分少烤出来更脆。",
    "番茄拌好后沥出的汁别扔，可以直接当沙拉汁。",
    "所有配料提前切好摆盘，上桌前现组装最好吃。",
    "一次做几种口味，拼在同一只木板上更热闹。"
  ],
  "common_mistakes": [
    "面包切得太薄，刷油后一烤就焦成硬片。",
    "番茄汁水没沥干就铺上去，面包片很快变软塌。",
    "芝士烤到油分离才取出，口感发硬带颗粒。"
  ],
  "substitutions": [
    {
      "original": "面包",
      "substitute": "英式松饼",
      "ratio": "200克:200克",
      "note": "松饼更软，烤制时间减两分钟。"
    },
    {
      "original": "马苏里拉",
      "substitute": "帕玛森芝士",
      "ratio": "120克:80克",
      "note": "味道更咸，盐相应减半。"
    }
  ],
  "variations": [
    "抹一层酸奶油再铺料，口感更浓厚适合配酒。",
    "换成橄榄酱与烤甜椒，做成全素版本的拼盘。"
  ],
  "serving_suggestion": "摆成拼盘直接用手拿，配一杯气泡水或淡红葡萄酒最合适。",
  "storage": "组装好的成品现做现吃，面包片可提前烤好密封保存一天。",
