          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 100,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        },
        {
          "name": "蛋黄",
          "name_en": "egg yolk",
          "amount": 2,
          "unit": "piece",
          "note": "常温",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "分两次加",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "可可粉",
          "name_en": "cocoa powder",
          "amount": 5,
