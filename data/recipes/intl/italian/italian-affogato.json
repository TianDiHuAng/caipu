          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小汤锅",
    "打蛋器",
    "冰淇淋容器",
    "咖啡机"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛋黄加白糖用打蛋器搅到发白起泡，体积膨胀约一倍。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糖分两次加，蛋糊才打得均匀不发颗粒。",
      "visual_cue": "蛋糊呈浅黄色，画出纹路能留下痕迹"
    },
    {
      "n": 2,
      "text": "牛奶小火加热到锅边冒小泡，慢慢冲进蛋糊里，一边冲一边搅。",
      "time_min": 8,
      "heat": "小火",
      "tip": "牛奶别煮沸，太烫会把蛋黄冲成蛋花。",
      "visual_cue": "蛋奶液顺滑，表面浮一层细密泡沫"
    },
    {
      "n": 3,
      "text": "蛋奶液回锅小火加热到八十五度略稠，离火隔冰水放凉。",
      "time_min": 10,
      "heat": "小火",
      "tip": "没有温度计就看挂勺，木勺背面挂薄薄一层就够。",
      "visual_cue": "液面渐稠，木勺背面挂住一层奶膜"
    },
    {
      "n": 4,
      "text": "奶油打到六分发，与放凉的蛋奶糊翻拌成冰淇淋糊，冷冻四小时。",
      "time_min": 15,
      "heat": "无火",
      "tip": "奶油打成能缓慢流动的浓稠液状即可，打硬了口感发干。",
      "visual_cue": "糊体顺滑有纹路，冷冻后能挖成球"
    },
    {
      "n": 5,
      "text": "咖啡萃取一百二十毫升浓缩液放凉，浇在挖成球的冰淇淋上，撒可可粉立刻上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "咖啡要现萃放凉到微温，太热会把冰淇淋化开。",
      "visual_cue": "咖啡沿冰淇淋边缘流下，形成棕色纹路"
    }
  ],
  "tips": [
    "玻璃杯提前冷藏十分钟，冰淇淋上桌后化得更慢。",
    "咖啡选深烘豆，苦味突出才能压住奶油的甜。",
    "冰淇淋糊冷冻中途搅两次，质地更细腻无冰渣。",
    "可可粉最后撒，撒早了会吸潮结块。"
  ],
  "common_mistakes": [
    "蛋奶糊加热时火太大又不搅拌，蛋黄结块成蛋花。",
    "咖啡趁滚烫浇上去，冰淇淋一下化成一摊奶水。",
    "奶油打过头变得粗糙，拌进蛋糊后口感发干。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "炼乳",
      "ratio": "200克:120克",
      "note": "省去打发步骤，甜度会更高。"
    },
    {
      "original": "咖啡",
      "substitute": "红茶",
      "ratio": "120毫升:120毫升",
      "note": "浓红茶同样香，苦味更柔和。"
    }
  ],
  "variations": [
    "换成开心果冰淇淋底，坚果香与浓缩咖啡很搭。",
    "加一小勺杏仁酒，成人版本的香气层次更丰富。"
  ],
  "serving_suggestion": "装在透明玻璃杯里，趁咖啡还温热时用小勺挖着吃。",
  "storage": "冰淇淋糊可冷冻一周，咖啡须现萃现用，成品不建议存放。",
