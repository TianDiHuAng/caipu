  "equipment": [
    "烤箱",
    "打蛋器",
    "模具",
    "刨丝器",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "柠檬刨出黄色表皮屑，挤汁备用。，看住火，别让它失控。",
      "time_min": 5,
      "heat": "无火",
      "tip": "只刨黄色部分，白瓤发苦。，全程留意火候，别贪快。",
      "visual_cue": "皮屑细黄，汁水清澈"
    },
    {
      "n": 2,
      "text": "鸡蛋加白糖打发到颜色发白、体积膨胀。，火大了就离锅远一点。",
      "time_min": 7,
      "heat": "无火",
      "tip": "打到发白，蛋糕才松。，火别开太大，稳着来。",
      "visual_cue": "蛋糊泛白，落痕缓慢消失"
    },
    {
      "n": 3,
      "text": "分次倒入橄榄油，边倒边搅到乳化。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "无火",
      "tip": "慢慢倒，油才不浮在表面。，火力保持中等，慢慢来。",
      "visual_cue": "糊体顺滑，油光均匀"
    },
    {
      "n": 4,
      "text": "加牛奶和柠檬汁，搅匀后拌入柠檬皮屑。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁遇奶会略稠，正常。，注意锅里温度别掉下来。",
      "visual_cue": "糊体微稠，香气清酸"
    },
    {
      "n": 5,
      "text": "筛入面粉和盐，翻拌到看不见干粉。，始终中小火，别心急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "别画圈拌，起筋蛋糕就硬。，火要均匀，食材才不糊。",
      "visual_cue": "糊体顺滑，无干粉块"
    },
    {
      "n": 6,
      "text": "倒进抹油撒粉的模具，震出大气泡。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "无火",
      "tip": "震两下，切面才没有大孔。，全程留意火候，别贪快。",
      "visual_cue": "表面平整，气泡上浮"
    },
    {
      "n": 7,
      "text": "烤箱一百七十五度烤三十五分钟，表面金黄。，火大了就离锅远一点。",
      "time_min": 36,
      "heat": "无火",
      "tip": "牙签插入带少量湿屑即可。，火别开太大，稳着来。",
      "visual_cue": "表面金黄，中心微弹"
    },
    {
      "n": 8,
      "text": "出炉放凉十分钟再脱模，切片。，锅温要匀，别忽高忽低。",
      "time_min": 12,
      "heat": "无火",
      "tip": "稍凉再脱，蛋糕才不散。，火力保持中等，慢慢来。",
      "visual_cue": "边缘脱离，切面细密"
    }
  ],
  "tips": [
    "柠檬只刨黄色部分，白瓤发苦。，这一步别省。",
    "橄榄油分次倒，才乳化的开。，别跳过这步。",
    "别画圈拌面糊，起筋就发硬。，这步最关键。"
  ],
  "common_mistakes": [
    "蛋糊没打发，蛋糕发硬不发。，很多人在这里出错。",
    "橄榄油一次倒入，油水分离。，这里最容易翻车。",
    "烤过头，表面焦里面干。，别小看这一步。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "橙子",
      "ratio": "2 个:2 个",
      "note": "甜度更高，糖可减二十克。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "120 毫升:130 克",
      "note": "需融化后放凉再拌。"
    }
  ],
  "variations": [
    "表面淋一层柠檬糖霜。，成败就在这一步。",
    "加一勺罂粟籽，口感更丰富。，这点要注意。"
  ],
  "serving_suggestion": "切厚片配红茶，第二天更入味。，这是关键点。",
  "storage": "常温密封三天，冷藏一周。，别嫌麻烦，做完它。",
