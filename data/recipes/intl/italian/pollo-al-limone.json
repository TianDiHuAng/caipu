  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡胸肉",
          "name_en": "chicken breast",
          "amount": 600,
          "unit": "g",
          "note": "片成薄片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 150,
          "unit": "g",
          "note": "取汁与皮屑",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 50,
          "unit": "g",
          "note": "裹薄粉",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 10,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "迷迭香",
          "name_en": "rosemary",
          "amount": 5,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 40,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "肉锤",
    "平底锅",
    "夹子",
    "刨丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉 600g 横片成 1 厘米厚的薄片，用肉锤轻敲至厚薄均匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "敲到整片厚度一致，受热才均匀。",
      "visual_cue": "肉片薄而均匀、边缘平整"
    },
    {
      "n": 2,
      "text": "肉片两面撒 5g 盐与 2g 黑胡椒，再薄薄裹一层面粉并抖掉多余粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉要薄，厚了会糊成一团。",
      "visual_cue": "肉片挂薄粉、表面干爽"
    },
    {
      "n": 3,
      "text": "柠檬 150g 刨下黄色表皮屑，挤出 40ml 柠檬汁备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "只取黄色表皮，白色部分会发苦。",
      "visual_cue": "柠檬汁清亮、皮屑细碎"
    },
    {
      "n": 4,
      "text": "平底锅倒 40ml 橄榄油烧热，转中火下鸡排煎 4 分钟至底面金黄。",
      "time_min": 4,
      "heat": "中火",
      "tip": "下锅后别急着翻，定型才不粘。",
      "visual_cue": "底面金黄、边缘泛白"
    },
    {
      "n": 5,
      "text": "翻面再煎 3 分钟，加入 20g 黄油、蒜片与迷迭香碎。",
      "time_min": 3,
      "heat": "中火",
      "tip": "黄油后放，奶香才不焦。",
      "visual_cue": "黄油融化起泡、香草出香"
    },
    {
      "n": 6,
      "text": "倒入 40ml 柠檬汁，中火煮 2 分钟至酱汁乳化发亮。",
      "time_min": 2,
      "heat": "中火",
      "tip": "柠檬汁煮沸会变苦，煮到微稠即可。",
      "visual_cue": "酱汁乳化、呈浅金色"
    },
    {
      "n": 7,
      "text": "撒上柠檬皮屑，把鸡排翻面裹匀酱汁后盛盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "皮屑最后撒，香气最清亮。",
      "visual_cue": "鸡排表面泛光、酱汁挂身"
    }
  ],
  "tips": [
    "鸡胸肉敲匀厚度，厚薄不一最容易一面老一面生。",
    "面粉只裹薄薄一层，太厚会脱壳糊锅。",
    "柠檬汁别煮太久，煮过了苦味会出来。"
  ],
  "common_mistakes": [
    "鸡胸肉不敲直接煎，外层老内部还发白。",
    "黄油一下锅就开大火，奶香变焦苦。",
    "酱汁大火收得太干，只剩一层发苦的油。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "600g 对 600g",
      "note": "口感更嫩，煎制时间加 2 分钟。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "20g 对 20ml",
      "note": "奶香减弱，可加 2g 蒜泥补味。"
    }
  ],
  "variations": [
    "加 30ml 白葡萄酒一起收汁，酸香更立体。",
    "配 100g 芝麻菜沙拉，清爽平衡。"
  ],
  "serving_suggestion": "鸡排上浇满酱汁，配烤土豆或意面，旁边放一瓣柠檬。",
  "storage": "冷藏可存 2 天，复热时加 10ml 水小火回锅，别久煎。",
