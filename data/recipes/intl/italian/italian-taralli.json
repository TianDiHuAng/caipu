    }
  ],
  "equipment": [
    "大碗",
    "锅",
    "烤盘",
    "烤箱",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茴香籽放干锅小火炒一分钟到出香。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "干锅炒香，别放油，香味才干净。，注意火候。",
      "visual_cue": "香气散出，颜色略深，状态稳定"
    },
    {
      "n": 2,
      "text": "面粉加盐和干酵母拌匀，中间挖个小坑。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酵母别直接接触盐，分开放。，注意火候。",
      "visual_cue": "粉类均匀，坑在中央，状态稳定"
    },
    {
      "n": 3,
      "text": "倒白葡萄酒、橄榄油和温水，揉成光滑面团。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "酒先倒，水按面团软硬慢慢补。，注意火候。",
      "visual_cue": "面团光滑，柔软不粘，状态稳定"
    },
    {
      "n": 4,
      "text": "加炒香的茴香籽，再揉两分钟拌匀。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "籽要揉匀，不然一口咸一口淡。，注意火候。",
      "visual_cue": "籽粒分布均匀，状态稳定"
    },
    {
      "n": 5,
      "text": "面团搓成小指粗的长条，圈成直径三厘米的环。",
      "time_min": 12,
      "heat": "无火",
      "tip": "粗细一致，煮的时候熟得才均匀。，注意火候。",
      "visual_cue": "圆环均匀，接口压实，状态稳定"
    },
    {
      "n": 6,
      "text": "锅里水烧到微沸，分批下圈饼煮一分钟。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "水别大滚，滚了圈饼容易散。，注意火候。",
      "visual_cue": "圈饼浮起，表面发皱，状态稳定"
    },
    {
      "n": 7,
      "text": "用漏勺捞出，摊在布巾上吸干水分。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "吸干水，烤的时候才不会裂。，注意火候。",
      "visual_cue": "表面干爽，形状完整，状态稳定"
    },
    {
      "n": 8,
      "text": "一百八十度烤三十分钟到金黄干脆。这一步不要着急。",
      "time_min": 32,
      "heat": "-",
      "tip": "中途翻一次，上色才均匀。，注意火候。",
      "visual_cue": "颜色金黄，敲击发脆，状态稳定"
    },
    {
      "n": 9,
      "text": "出炉放凉，掰开听声音判断酥脆度。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "掰开有脆响就是烤透了。，注意火候。",
      "visual_cue": "断面干脆，无软心，状态稳定"
    }
  ],
  "tips": [
    "茴香籽先干炒，香味才出得来。，值得留意。",
    "煮的时间别超一分钟，久了会散。，值得留意。",
    "捞出一定吸干水，烤时才不裂。，值得留意。"
  ],
  "common_mistakes": [
    "水温太高，酵母被烫死发不起来。，值得留意。",
    "圈饼煮太久，烤完软塌塌。，值得留意。",
    "粗细不一，细的焦了粗的还软。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "白葡萄酒",
      "substitute": "清水加少量白醋",
      "ratio": "120 毫升:110 毫升加10 毫升",
      "note": "少了酒香，脆度不变。"
    },
    {
      "original": "茴香籽",
      "substitute": "黑胡椒碎",
      "ratio": "5 克:4 克",
      "note": "风味更冲，适合配酒。"
    }
  ],
  "variations": [
    "加一勺辣椒碎，做成辣味圈饼。，值得留意。",
    "拌入少量帕玛森芝士粉，咸香更浓。，值得留意。"
  ],
  "serving_suggestion": "配一杯干白或淡啤酒，是普利亚最常见的下酒小食。",
  "storage": "密封常温放两周，回潮后一百五十度烤五分钟。",
