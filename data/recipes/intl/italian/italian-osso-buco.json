  "equipment": [
    "厚底炖锅",
    "棉线",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腱横切厚段，用棉线沿外围绑一圈固定形状。",
      "time_min": 8,
      "heat": "无火",
      "tip": "绑线能防止久炖后肉块散开。",
      "visual_cue": "肉块紧实，棉线勒住外圈"
    },
    {
      "n": 2,
      "text": "肉段两面撒盐与黑胡椒，薄薄裹一层面粉抖掉多余。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面粉只裹薄薄一层，太厚会让酱汁发糊。",
      "visual_cue": "表面哑光，不见干粉堆积"
    },
    {
      "n": 3,
      "text": "厚底锅下橄榄油与黄油，中大火把肉段两面煎至深褐后取出。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "焦褐层是酱汁的香味来源，别急着翻面。",
      "visual_cue": "肉面深褐，锅底留焦渣"
    },
    {
      "n": 4,
      "text": "原锅下洋葱、胡萝卜与芹菜末，小火炒十分钟至软甜。",
      "time_min": 10,
      "heat": "小火",
      "tip": "蔬菜切得越细越容易化进酱汁。",
      "visual_cue": "蔬菜软塌，锅底焦渣被刮起"
    },
    {
      "n": 5,
      "text": "倒白葡萄酒煮到酒气散尽，加番茄块与高汤煮开。",
      "time_min": 8,
      "heat": "中火",
      "tip": "酒气必须煮散，否则酱汁发酸。",
      "visual_cue": "液体微沸，酒味转成甜香"
    },
    {
      "n": 6,
      "text": "放回肉段，液面到肉块三分之二高，加盖小火焖一小时四十分钟。",
      "time_min": 100,
      "heat": "小火",
      "tip": "中途翻面一次，保持微沸别大滚。",
      "visual_cue": "肉块变软，筷子能轻松穿透"
    },
    {
      "n": 7,
      "text": "取出肉段拆掉棉线保温，酱汁大火收浓并调盐。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "收汁时要不停搅拌防糊底。",
      "visual_cue": "酱汁浓稠，能挂住勺背"
    },
    {
      "n": 8,
      "text": "柠檬皮屑、欧芹碎与蒜末拌成 gremolata，撒在肉上趁热上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌料现做现撒，柠檬香才不散。",
      "visual_cue": "表面点点翠绿，柠檬香清亮"
    }
  ],
  "tips": [
    "牛腱要横切带骨或带筋部位，久炖才胶质丰厚。",
    "gremolata 是这道菜的点睛，别省略柠檬皮。",
    "炖好后静置一夜再复热，味道更融合。"
  ],
  "common_mistakes": [
    "煎肉时火不够大，肉面上不了色，酱汁寡淡。",
    "炖煮时大滚，肉纤维紧缩变得又干又柴。",
    "收汁时忘了搅拌，锅底焦糊带苦味。"
  ],
  "substitutions": [
    {
      "original": "牛腱",
      "substitute": "牛腩",
      "ratio": "900 克:900 克",
      "note": "切大块绑线，炖制时间不变。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "苹果醋加水",
      "ratio": "150 毫升:60 毫升醋加水至150毫升",
      "note": "酸味更尖，需多加五克白糖平衡。"
    }
  ],
  "variations": [
    "加一把去核橄榄同炖，咸香更足。",
    "把 gremolata 换成橙皮屑，果香更明亮。"
  ],
  "serving_suggestion": "肉段连酱汁装盘，撒 gremolata，配意式玉米糊或土豆泥。",
  "storage": "冷藏三天、冷冻两个月；复热连酱汁小火加热，撒新鲜 gremolata。",
