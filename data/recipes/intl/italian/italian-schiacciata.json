        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "大碗",
    "保鲜膜",
    "刷子",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "高筋面粉与盐混匀，酵母化在温水里，慢慢倒进面粉揉成团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水别一次倒完，面团偏软但不粘手最好。",
      "visual_cue": "面团抱团，盆边干净"
    },
    {
      "n": 2,
      "text": "揉八分钟后盖上保鲜膜，放在温暖处发酵一小时，直到体积涨到两倍大。",
      "time_min": 68,
      "heat": "无火",
      "tip": "温度低就多等一会，看状态不看钟。",
      "visual_cue": "面团蓬松，按下去缓慢回弹"
    },
    {
      "n": 3,
      "text": "烤盘抹厚厚一层橄榄油，把面团倒上去用手指轻轻压开。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别用擀面杖压，手指按才能留住气泡。",
      "visual_cue": "面饼铺满烤盘，厚薄均匀"
    },
    {
      "n": 4,
      "text": "用手指在面饼上按出一排排小坑，每个坑都按到盘底。",
      "time_min": 4,
      "heat": "无火",
      "tip": "坑按得深一点，油和盐才会聚在里面。",
      "visual_cue": "饼面布满凹坑，间距一致"
    },
    {
      "n": 5,
      "text": "刷一层橄榄油，撒盐与黑胡椒，铺上迷迭香与大蒜片。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐要撒得均匀，吃的时候每口都有咸味。",
      "visual_cue": "表面油亮，香料分布均匀"
    },
    {
      "n": 6,
      "text": "把番茄切面朝下按进面饼里，静置二次发酵二十分钟。",
      "time_min": 21,
      "heat": "无火",
      "tip": "番茄按进面团里，烤时汁水才会渗进去。",
      "visual_cue": "番茄嵌入饼面，面团膨胀"
    },
    {
      "n": 7,
      "text": "烤箱预热两百度，中层烤二十分钟至表面金黄。",
      "time_min": 22,
      "heat": "大火",
      "tip": "烤到边缘焦黄酥脆，中间仍柔软才是对的。",
      "visual_cue": "表面金黄，边缘酥脆"
    },
    {
      "n": 8,
      "text": "出炉趁热再刷一层橄榄油，稍放凉后切成粗条。",
      "time_min": 4,
      "heat": "无火",
      "tip": "最后一层油让表皮发亮，也更耐存。",
      "visual_cue": "表面油润，切面有气孔"
    }
  ],
  "tips": [
    "面团含水量高，用刮刀辅助整形会更容易。",
    "迷迭香换成百里香或牛至，香气各有风格。",
    "烤盘用金属的比玻璃的更容易烤出脆底。",
    "隔天吃之前喷点水回炉五分钟，能恢复柔软。"
  ],
  "common_mistakes": [
    "面团没发够就压盘，烤出来像块硬板。",
    "橄榄油刷得太少，饼干巴在烤盘上揭不下来。",
    "番茄切太厚压在饼上，中间烤不熟还出一摊水。"
  ],
  "substitutions": [
    {
      "original": "迷迭香",
      "substitute": "百里香",
      "ratio": "6克:6克",
      "note": "香气更柔和，用量可略增。"
    },
    {
      "original": "高筋面粉",
      "substitute": "中筋面粉",
      "ratio": "400克:400克",
      "note": "口感更松软，发酵时间缩短十分钟。"
    }
  ],
  "variations": [
    "面团里拌入黑橄榄与洋葱丝，做成更有料的一版。",
    "表面撒一层粗盐与葡萄干，做出托斯卡纳的甜咸吃法。"
  ],
  "serving_suggestion": "四人份主食，切成长条配火腿、奶酪与一杯白葡萄酒。",
  "storage": "室温密封可存两天，吃前喷水回炉或平底锅干烙；冷冻可存两周。",
