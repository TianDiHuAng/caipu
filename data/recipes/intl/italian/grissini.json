  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "高筋粉",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 180,
          "unit": "ml",
          "note": "温水",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 5,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "迷迭香",
          "name_en": "rosemary",
          "amount": 5,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 40,
          "unit": "ml",
          "note": "和面与刷面",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "180ml 温水加 5g 白糖与 5g 酵母化开，静置 10 分钟至水面浮起细密泡沫。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水温约 35 度，太烫会杀死酵母。",
      "visual_cue": "水面浮起细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉 300g 与 6g 盐混匀，倒入酵母水和 20ml 橄榄油，揉成表面光滑的团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "揉到面团能拉出薄膜。",
      "visual_cue": "面团光滑、按压回弹"
    },
    {
      "n": 3,
      "text": "盖湿布放温暖处发酵 60 分钟，至体积膨胀到原来的两倍大。",
      "time_min": 62,
      "heat": "无火",
      "tip": "发酵到位，面棍才松脆。",
      "visual_cue": "面团膨大两倍、指压留坑"
    },
    {
      "n": 4,
      "text": "轻拍排出大气泡，擀成 0.8 厘米厚的长片，切成 1 厘米宽的长条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别过度揉压，保留气泡。",
      "visual_cue": "面片厚薄一致、条状整齐"
    },
    {
      "n": 5,
      "text": "长条搓圆摆在烤盘上，刷橄榄油撒迷迭香，静置 15 分钟再入炉。",
      "time_min": 17,
      "heat": "无火",
      "tip": "二次醒发后才进烤箱。",
      "visual_cue": "长条略膨、表面油亮"
    },
    {
      "n": 6,
      "text": "烤箱预热 200 度，中层烤 15 分钟至表面金黄、敲之清脆，取出放凉。",
      "time_min": 21,
      "heat": "-",
      "tip": "烤到敲之清脆才够干。",
      "visual_cue": "表面金黄、敲击声脆"
    }
  ],
  "tips": [
    "酵母水温度控制在 35 度左右，太烫酵母就失去活性。",
    "面团要揉到能拉出薄膜，成品才脆而不硬。",
    "烤到表面金黄、敲击有脆响才算真的到位。"
  ],
  "common_mistakes": [
    "酵母水太烫，面团发酵一小时毫无变化。",
    "长条搓得太粗，中间烤不透留下软芯。",
    "出炉就密封，水汽回流导致成品回软。"
  ],
  "substitutions": [
    {
      "original": "迷迭香",
      "substitute": "黑胡椒",
      "ratio": "5g 对 3g",
      "note": "香气更辛，用量要少。"
    },
    {
      "original": "高筋粉",
      "substitute": "中筋粉",
      "ratio": "300g 对 300g",
      "note": "口感略酥，水量减 10ml。"
    }
  ],
  "variations": [
    "芝麻版：表面撒 10g 熟白芝麻同烤。",
    "芝士版：表面撒 30g 奶酪碎增香。"
  ],
  "serving_suggestion": "装篮配橄榄油黑醋蘸食，或配汤和沙拉。",
  "storage": "密封常温 5 天，回软可 150 度烤 5 分钟。",
