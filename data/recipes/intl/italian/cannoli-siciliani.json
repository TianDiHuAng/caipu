  ],
  "equipment": [
    "擀面杖",
    "圆模",
    "深锅",
    "裱花袋"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉 250g 与 10g 可可粉、60g 白糖、2g 盐混合，加入 30g 黄油搓成砂状。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，搓出的砂粒才细。",
      "visual_cue": "面粉呈粗砂状、无大块黄油"
    },
    {
      "n": 2,
      "text": "加 1 个鸡蛋与 10ml 红酒醋，揉成光滑面团，包保鲜膜冷藏松弛 30 分钟。",
      "time_min": 35,
      "heat": "无火",
      "tip": "红酒醋能让炸好的面壳更酥脆。",
      "visual_cue": "面团光滑不粘手、按之回弹"
    },
    {
      "n": 3,
      "text": "面团擀成 2mm 薄片，用 10cm 圆模压出圆片，卷在金属卷筒上捏合接口。",
      "time_min": 20,
      "heat": "无火",
      "tip": "接口处抹一点蛋液，炸时才不开裂。",
      "visual_cue": "面卷紧贴卷筒、接口压实"
    },
    {
      "n": 4,
      "text": "锅中倒 500ml 植物油烧至 170℃，下入面卷炸 2 分钟至深褐酥脆。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温别超 180℃，太热外面焦里面生。",
      "visual_cue": "面壳深褐、表面起小泡"
    },
    {
      "n": 5,
      "text": "捞出沥油稍凉后抽出卷筒，放凉备用，炸好的面壳可存 3 天。",
      "time_min": 5,
      "heat": "无火",
      "tip": "趁热抽筒，凉了会粘住。",
      "visual_cue": "面壳完整空心、轻敲发脆响"
    },
    {
      "n": 6,
      "text": "300g 奶油奶酪拌 60g 白糖与柠檬皮屑打顺滑，装入裱花袋挤入面壳。",
      "time_min": 8,
      "heat": "无火",
      "tip": "吃之前再挤馅，否则壳会回软。",
      "visual_cue": "馅料饱满两端露、表面平滑"
    },
    {
      "n": 7,
      "text": "两端蘸上糖粉或巧克力碎，撒少许糖粉装饰后立即食用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "现挤现吃是这道甜点的铁律。",
      "visual_cue": "糖粉薄覆、馅料成形不塌"
    }
  ],
  "tips": [
    "面皮要擀到 2mm 以下，炸出来才够酥脆",
    "馅料冷藏 30 分钟再挤，形状更挺。",
    "炸油温度用筷子试，冒细密小泡即可下锅。"
  ],
  "common_mistakes": [
    "面皮擀太厚，炸后硬得像饼干咬不开。",
    "提前挤好馅放置，壳吸湿变软失去脆感。",
    "面皮擀得偏厚，炸好后又硬又韧像在嚼饼干"
  ],
  "substitutions": [
    {
      "original": "奶油奶酪",
      "substitute": "意式乳清奶酪",
      "ratio": "300g 对 300g",
      "note": "更接近西西里本地风味，质地更干爽。"
    },
    {
      "original": "红酒醋",
      "substitute": "白醋",
      "ratio": "10ml 对 8ml",
      "note": "酸度接近，风味略单薄。"
    }
  ],
  "variations": [
    "开心果版：馅中拌入 40g 开心果碎，两端蘸坚果。",
    "巧克力版：馅中加 30g 融化黑巧克力，风味更浓。"
  ],
  "serving_suggestion": "撒糖粉后立即食用，配一小杯浓缩咖啡是西西里传统吃法。",
  "storage": "空壳密封可存 3 天，馅料冷藏 2 天；成品不建议存放。",
