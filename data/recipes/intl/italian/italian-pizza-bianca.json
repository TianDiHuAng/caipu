      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "擀面杖",
    "大碗",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉和盐混匀，酵母用温水化开。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐和酵母分开，发酵才稳。，火候要稳，别忽大忽小。",
      "visual_cue": "面粉成絮，水色微浑"
    },
    {
      "n": 2,
      "text": "揉面十分钟，到面团光滑有延展性。，火候要稳，别忽大忽小。",
      "time_min": 11,
      "heat": "无火",
      "tip": "揉出筋，烤出来才有嚼劲。，火候要稳，别忽大忽小。",
      "visual_cue": "面团光滑，拉伸不断"
    },
    {
      "n": 3,
      "text": "抹一层橄榄油，盖布室温发酵一小时。，火候要稳，别忽大忽小。",
      "time_min": 62,
      "heat": "无火",
      "tip": "温暖处发酵，体积才翻倍。，火候要稳，别忽大忽小。",
      "visual_cue": "体积翻倍，指压留痕"
    },
    {
      "n": 4,
      "text": "烤盘刷油，面团用手从中间往外推开。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用手推别用擀，气泡才留得住。，火候要稳，别忽大忽小。",
      "visual_cue": "面饼铺满，边缘略厚"
    },
    {
      "n": 5,
      "text": "表面刷橄榄油，撒盐和蒜末。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油刷够，烤出来才脆。，火候要稳，别忽大忽小。",
      "visual_cue": "表面油亮，蒜末散布"
    },
    {
      "n": 6,
      "text": "静置二十分钟，同时预热烤箱两百四十度。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "无火",
      "tip": "再醒一次，面饼才不缩。，火候要稳，别忽大忽小。",
      "visual_cue": "面饼微鼓，按压回弹"
    },
    {
      "n": 7,
      "text": "烤十五分钟，到边缘金黄起泡。，火候要稳，别忽大忽小。",
      "time_min": 16,
      "heat": "无火",
      "tip": "高温短烤，底部才脆。，火候要稳，别忽大忽小。",
      "visual_cue": "边缘鼓起，底面金黄"
    },
    {
      "n": 8,
      "text": "出炉撒罗勒叶，趁热切块。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "罗勒遇热就香，别提前放。，火候要稳，别忽大忽小。",
      "visual_cue": "绿叶微卷，香气扑鼻"
    }
  ],
  "tips": [
    "用手推面饼，气泡才留得住。，这一点很关键。",
    "油刷够，烤出来才脆。，这一点很关键。",
    "出炉再放罗勒，香气才清。，这一点很关键。"
  ],
  "common_mistakes": [
    "面团没发起来，烤成硬饼。，这一点很关键。",
    "油刷太少，表面干硬。，这一点很关键。",
    "烤箱温度不够，底部发白。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "高筋面粉",
      "substitute": "中筋面粉",
      "ratio": "400 克:400 克",
      "note": "水减二十毫升。"
    },
    {
      "original": "罗勒",
      "substitute": "迷迭香",
      "ratio": "15 克:5 克",
      "note": "香气更重，用量要少。"
    }
  ],
  "variations": [
    "撒一点海盐粒，口感更立体。，这一点很关键。",
    "加片状奶酪，做成奶酪白披萨。，这一点很关键。"
  ],
  "serving_suggestion": "切块当开胃面包，配橄榄和火腿。，这一点很关键。",
  "storage": "常温一天，冷冻两周。，这一点很关键。",
