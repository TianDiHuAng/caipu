  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 750,
          "unit": "g",
          "note": "去骨成片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 120,
          "unit": "g",
          "note": "拍粉",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 120,
          "unit": "g",
          "note": "蛋液",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 90,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 70,
          "unit": "g",
          "note": "配盘",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "肉锤",
    "三个盘子",
    "夹子",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿去骨后从中间片开，用肉锤敲成半厘米厚的薄片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "敲到厚薄一致，煎的时候受热才均匀。",
      "visual_cue": "肉片均匀，边缘薄，状态稳定"
    },
    {
      "n": 2,
      "text": "肉片两面撒盐和黑胡椒，静置五分钟入味。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "提前调味渗进肉里，外层裹粉才不会只剩咸味。",
      "visual_cue": "肉片微湿，表面有盐，状态稳定"
    },
    {
      "n": 3,
      "text": "鸡蛋打散成蛋液，面粉倒在另一只盘里铺平。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "三个盘子分开摆，裹的顺序才不会乱。",
      "visual_cue": "蛋液顺滑，面粉铺开，状态稳定"
    },
    {
      "n": 4,
      "text": "肉片先两面拍一层面粉，抖掉多余的干粉。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉太厚会掉渣，薄薄一层就够挂蛋液。",
      "visual_cue": "表面薄粉，不见干块，状态稳定"
    },
    {
      "n": 5,
      "text": "再放进蛋液里两面蘸匀，让表面完全裹上一层蛋液。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液裹满，煎出来才金黄不脱落。，注意火候。",
      "visual_cue": "表面湿润，蛋液均匀，状态稳定"
    },
    {
      "n": 6,
      "text": "平底锅倒入橄榄油烧热，肉片下锅中火煎三分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油要热但别冒大烟，蛋液才不焦黑。，注意火候。",
      "visual_cue": "边缘起泡，底面金黄，状态稳定"
    },
    {
      "n": 7,
      "text": "翻面再煎两分钟，两面都成金黄色后捞出沥油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "第二面时间稍短，肉才不干。，注意火候。",
      "visual_cue": "两面金黄，声响轻微，状态稳定"
    },
    {
      "n": 8,
      "text": "装盘时旁边放切开的柠檬角，吃前挤汁提味。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "挤柠檬能解油腻，也让咸香更突出。，注意火候。",
      "visual_cue": "表面干爽，柠檬鲜亮，状态稳定"
    }
  ],
  "tips": [
    "肉片敲到厚薄一致，煎的时候才同步熟。",
    "拍粉要薄，太厚煎完会掉一整圈渣。，值得留意。",
    "出锅挤几滴柠檬汁，油腻感立刻减轻。，值得留意。"
  ],
  "common_mistakes": [
    "肉片没敲薄，外面焦了中间还发白。，务必避免。",
    "油温过高，蛋液下锅立刻变黑。，务必避免。",
    "煎好叠放不沥油，底下一层又软又腻。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡胸肉",
      "ratio": "750 克:700 克",
      "note": "更瘦，煎制时间减一分钟。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "90 毫升:80 克",
      "note": "奶香更浓，需小火避免焦化。"
    }
  ],
  "variations": [
    "表面撒一层奶酪丝，风味更浓。，也很受欢迎。",
    "配一份番茄意面，就是米兰常见的组合。"
  ],
  "serving_suggestion": "趁热配柠檬角和一份蔬菜沙拉，简单又扎实。",
  "storage": "冷藏两天，复热用平底锅干煎一分钟恢复脆感。",
