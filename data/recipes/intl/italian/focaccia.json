  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "高筋面粉",
          "name_en": "bread flour",
          "amount": 400,
          "unit": "g",
          "note": "蛋白质 12% 以上",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 6,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 280,
          "unit": "ml",
          "note": "常温水",
          "optional": false
        },
        {
          "name": "迷迭香",
          "name_en": "rosemary",
          "amount": 5,
          "unit": "g",
          "note": "新鲜叶片",
          "optional": false
        },
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 100,
          "unit": "g",
          "note": "对半切开",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 60,
          "unit": "ml",
          "note": "分次使用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
          "unit": "g",
          "note": "面团与表面各半",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "烤盘",
    "刮刀",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "清水化开酵母，倒进高筋面粉与一半盐，用刮刀拌到没有干粉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团很湿，用刮刀别用手。",
      "visual_cue": "没有干粉、面团黏稠挂刮刀"
    },
    {
      "n": 2,
      "text": "倒入二十毫升橄榄油，用折叠手法把面团整成团，盖上湿布静置。",
      "time_min": 10,
      "heat": "无火",
      "tip": "折叠代替揉搓，面筋更松弛。",
      "visual_cue": "面团成团、表面略光"
    },
    {
      "n": 3,
      "text": "每三十分钟折叠一次，共折叠三次，面团会变得光滑有弹性。",
      "time_min": 90,
      "heat": "无火",
      "tip": "手上沾水折叠，防粘手。",
      "visual_cue": "面团光滑、能拉出薄膜"
    },
    {
      "n": 4,
      "text": "烤盘刷满橄榄油，把面团倒进去用手掌摊开，盖布再醒四十分钟。",
      "time_min": 40,
      "heat": "无火",
      "tip": "油要刷厚，底部才酥脆。",
      "visual_cue": "面团摊满烤盘、明显膨起"
    },
    {
      "n": 5,
      "text": "手指蘸油在面团上戳出深窝，塞进迷迭香与番茄，撒剩下的盐。",
      "time_min": 5,
      "heat": "无火",
      "tip": "戳到底但别戳破，窝深才好看。",
      "visual_cue": "表面布满深窝、配料嵌稳"
    },
    {
      "n": 6,
      "text": "烤箱预热 220℃ 烤二十分钟，出炉趁热刷一层橄榄油晾五分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "表面金黄、敲底部有空响即熟。",
      "visual_cue": "表面金黄、底部酥脆"
    }
  ],
  "tips": [
    "面团含水量高，用折叠代替揉搓，组织才松软有大孔。",
    "烤盘底油要刷厚，底部那层酥脆是佛卡夏的精华。",
    "出炉立刻刷一层橄榄油，表面会亮且不易干。"
  ],
  "common_mistakes": [
    "水加少了追求好操作，烤出来像厚饼干一样硬。",
    "戳窝时用力过猛戳穿面团，油从底部漏光。",
    "发酵不足就进烤箱，成品密实厚重没有大孔。"
  ],
  "substitutions": [
    {
      "original": "迷迭香",
      "substitute": "百里香",
      "ratio": "5g 对 5g",
      "note": "香气更柔，用量可略增。"
    },
    {
      "original": "番茄",
      "substitute": "黑橄榄",
      "ratio": "100g 对 80g",
      "note": "咸香更重，盐可减 1g。"
    }
  ],
  "variations": [
    "洋葱版：表面铺 100g 洋葱丝与迷迭香同烤。",
    "甜味版：表面撒 40g 葡萄干与粗糖，做成甜佛卡夏。"
  ],
  "serving_suggestion": "切成方块，配橄榄油与黑醋蘸食，或夹火腿做成三明治。",
  "storage": "常温密封可存 1 天，冷冻 1 个月，回温后 180℃ 烤 5 分钟。",
  "nutrition_estimate": {
    "basis": "每份（约 150g）",
