        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "压泥器",
    "擀面杖",
    "叉子",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆洗净带皮放汤锅，加水煮二十五分钟至软。，看准状态再往下做。",
      "time_min": 27,
      "heat": "大火",
      "tip": "带皮煮，土豆不吸太多水。，看准状态再往下做。",
      "visual_cue": "表皮裂开，筷子可穿"
    },
    {
      "n": 2,
      "text": "趁热剥皮，用压泥器压成细腻土豆泥。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁热压泥，团子才不散。，看准状态再往下做。",
      "visual_cue": "泥质细滑，无颗粒，别小看这一步。"
    },
    {
      "n": 3,
      "text": "土豆泥摊开晾到不烫手，散去多余水汽。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "太烫会烫熟面粉，太凉就吸更多粉。，看准状态再往下做。",
      "visual_cue": "泥面干爽，手温可触"
    },
    {
      "n": 4,
      "text": "加面粉、鸡蛋和盐，轻轻揉成不粘手的面团。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "少揉快成团，揉多了就发韧。，看准状态再往下做。",
      "visual_cue": "面团柔软，略粘手，成败就在这一步。"
    },
    {
      "n": 5,
      "text": "取小块搓成长条，切成两厘米的段。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "条粗细一致，煮的时间才好掌握。，看准状态再往下做。",
      "visual_cue": "段形均匀，切口平整"
    },
    {
      "n": 6,
      "text": "用叉子背面压出纹路，让团子带凹槽。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "纹路能挂住酱汁，别省这步。，看准状态再往下做。",
      "visual_cue": "表面有沟，形状微凹"
    },
    {
      "n": 7,
      "text": "汤锅水烧开加盐，下团子煮到浮起再煮一分钟。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "浮起来就是熟，别久煮。，看准状态再往下做。",
      "visual_cue": "团子上浮，汤面翻滚"
    },
    {
      "n": 8,
      "text": "捞出团子，与融化黄油和帕玛森芝士拌匀。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "黄油化开就拌，别炒上色。，看准状态再往下做。",
      "visual_cue": "表面油亮，芝士拉丝"
    },
    {
      "n": 9,
      "text": "撒黑胡椒和罗勒碎，趁热装盘。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃，凉了会变硬。，看准状态再往下做。",
      "visual_cue": "表面点点绿，香气散出"
    }
  ],
  "tips": [
    "土豆带皮煮，水汽进得少。，这点要注意。",
    "面粉少放，团子才松软。，这是关键点。",
    "用叉子压纹路，酱汁才挂得住。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "土豆泥太湿，加一堆面粉越揉越硬。",
    "揉面太久，煮出来像橡皮。，这一步别省。",
    "煮到浮起还继续煮，烂成糊。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "帕玛森芝士",
      "substitute": "奶酪",
      "ratio": "60 克:70 克",
      "note": "更拉丝，咸度略低。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "60 克:50 毫升",
      "note": "更清爽，奶香减弱。"
    }
  ],
  "variations": [
    "拌番茄酱，做成番茄团子。，这步最关键。",
    "加一点蘑菇同炒，风味更浓。，很多人在这里出错。"
  ],
  "serving_suggestion": "盛盘撒芝士，配一杯红酒。，这里最容易翻车。",
  "storage": "生团子冷冻一个月，煮熟冷藏两天。",
