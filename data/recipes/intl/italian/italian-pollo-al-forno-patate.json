  "equipment": [
    "烤箱",
    "烤盘",
    "肉叉",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用厨房纸吸干表面水分，盐与黑胡椒里外抹匀，静置二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "皮面一定要干，烤出来才会脆而不韧。",
      "visual_cue": "鸡皮干爽，表面均匀附着盐粒"
    },
    {
      "n": 2,
      "text": "土豆去皮切楔形块，洋葱切瓣，大蒜轻拍一下不切碎。",
      "time_min": 10,
      "heat": "无火",
      "tip": "土豆块大小接近，才不会有的焦有的生。",
      "visual_cue": "土豆块约三厘米宽，棱角分明"
    },
    {
      "n": 3,
      "text": "烤盘铺洋葱与土豆，撒一半迷迭香，淋一半橄榄油拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蔬菜垫底能接住鸡油，香味互相渗透。",
      "visual_cue": "土豆表面裹油，洋葱散成单瓣"
    },
    {
      "n": 4,
      "text": "鸡腿皮朝上摆在土豆上，撒余下迷迭香，淋剩下的橄榄油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "全程保持皮朝上不翻面，脆皮才更有保证。",
      "visual_cue": "鸡皮朝上整齐排列，彼此留出间隙"
    },
    {
      "n": 5,
      "text": "沿盘边倒入白葡萄酒与清水，烤箱两百度烤四十五分钟到皮金黄。",
      "time_min": 45,
      "heat": "中火",
      "tip": "中途舀盘底的汁浇两次，肉质不干柴。",
      "visual_cue": "鸡皮鼓起金黄，盘底汁水微微沸腾"
    },
    {
      "n": 6,
      "text": "出炉先静置五分钟，挤上柠檬汁再切块装盘上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置让肉汁回流到纤维里，切开不流失。",
      "visual_cue": "肉汁清亮，切面呈白色不发红"
    }
  ],
  "tips": [
    "土豆切好用水冲掉表面淀粉，烤完更干爽不粘盘。",
    "没有新鲜迷迭香可用干品，用量减到三克即可。",
    "鸡腿比整鸡好掌握火候，家庭烤箱也能做出脆皮。",
    "盘底汁水收一收浇在肉上，咸香更集中。"
  ],
  "common_mistakes": [
    "鸡皮没擦干就抹盐，出炉后皮软发白不起脆。",
    "土豆切得太小，四十五分钟后缩成硬块发苦。",
    "盘里水加太多，变成蒸鸡，皮没有脆感。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "800克:900克",
      "note": "鸡翅熟得快，烤三十分钟即可。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "米酒",
      "ratio": "80毫升:80毫升",
      "note": "酒味更直，糖分略高易上色。"
    }
  ],
  "variations": [
    "加几个小番茄同烤，烤到爆浆后酸甜解腻。",
    "换成羊排配土豆，迷迭香用量翻倍，风味更浓。"
  ],
  "serving_suggestion": "整盘端上桌，配一份烤蔬菜或简单的绿叶沙拉即可。",
  "storage": "冷藏可存两天，复热用两百二十度烤十分钟恢复脆皮。",
