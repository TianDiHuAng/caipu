  "steps": [
    {
      "n": 1,
      "text": "大蒜 30g 剥皮切成 1 毫米薄片，干辣椒掰成小段去籽。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切薄片，香气才慢慢释放。",
      "visual_cue": "蒜片薄而均匀、无碎末"
    },
    {
      "n": 2,
      "text": "小锅倒 120ml 橄榄油，冷油下蒜片，最小火加热 8 分钟至蒜片微黄。",
      "time_min": 9,
      "heat": "小火",
      "tip": "冷油下蒜，苦味才不会出来。",
      "visual_cue": "蒜片金黄、油面细密气泡"
    },
    {
      "n": 3,
      "text": "加干辣椒段小火浸 2 分钟，闻到辣香后立即离火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒发黑就苦了，见色就停。",
      "visual_cue": "辣椒转深红、油色微橙"
    },
    {
      "n": 4,
      "text": "油温降到不烫手时加 4g 盐搅匀，拌入香菜碎与柠檬皮屑。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐在温油里才化得开。",
      "visual_cue": "酱汁透亮、香菜均匀悬浮"
    }
  ],
  "tips": [
    "全程最小火，蒜片微黄就要离火，余温会继续加深颜色。",
    "冷油下蒜片，蒜香慢慢渗出而不发苦。",
    "盐要在油还温热时加，才化得开。"
  ],
  "common_mistakes": [
    "热油下蒜片，几秒钟就焦黑并带出明显苦味。",
    "辣椒炸到发黑，整锅油都带着焦糊气息。",
    "油温太高时加盐，盐粒沉底完全化不开。"
  ],
  "substitutions": [
    {
      "original": "干辣椒",
      "substitute": "辣椒粉",
      "ratio": "3 个对 5g",
      "note": "辣味更均匀，需过滤渣。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "1 个对 10ml",
      "note": "酸味更直接，香气略弱。"
    }
  ],
  "variations": [
    "鳀鱼版：加 2 条鳀鱼同浸增鲜。",
    "香草版：加 3g 欧芹碎与 2g 罗勒碎。"
  ],
  "serving_suggestion": "趁温热拌入煮好的意面，或淋在烤蔬菜和面包上。",
  "storage": "冷藏 5 天，取用时连蒜片一起用。",
