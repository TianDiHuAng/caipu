  "equipment": [
    "烤箱",
    "烤盘",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿用厨房纸吸干水分，在肉厚处划两刀方便入味。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮面必须干，烤出来才脆。",
      "visual_cue": "鸡皮干爽、切口平整"
    },
    {
      "n": 2,
      "text": "鸡腿抹 6g 盐、2g 黑胡椒与 20ml 橄榄油，塞入大蒜与一半迷迭香。",
      "time_min": 6,
      "heat": "无火",
      "tip": "盐要抹到皮下，味道才进得去。",
      "visual_cue": "鸡皮表面均匀挂油"
    },
    {
      "n": 3,
      "text": "覆膜冷藏腌制 90 分钟，取出回温 15 分钟再烤。",
      "time_min": 106,
      "heat": "无火",
      "tip": "回温能让内部受热更均匀。",
      "visual_cue": "鸡肉回软、表面略干"
    },
    {
      "n": 4,
      "text": "烤盘铺土豆块，拌剩余 20ml 橄榄油与盐，鸡腿皮朝上放在土豆上。",
      "time_min": 8,
      "heat": "无火",
      "tip": "土豆垫底吸鸡油，比鸡肉还香。",
      "visual_cue": "土豆块大小一致、表面挂油"
    },
    {
      "n": 5,
      "text": "铺柠檬片与剩余迷迭香，放入 200℃ 烤箱烤 45 分钟至鸡皮金黄。",
      "time_min": 47,
      "heat": "大火",
      "tip": "中途刷一次烤盘里的油。",
      "visual_cue": "鸡皮金黄酥脆、流出清亮肉汁"
    },
    {
      "n": 6,
      "text": "取出静置 5 分钟再切块，淋烤盘里的原汁上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置锁汁，切开不流血水。",
      "visual_cue": "肉汁清亮、切面湿润"
    }
  ],
  "tips": [
    "鸡皮一定要擦干，脆皮全靠这一步。",
    "土豆切得和鸡块差不多大，才能同步烤熟。",
    "出炉必须静置，直接切肉汁全流失。"
  ],
  "common_mistakes": [
    "鸡腿没回温就进烤箱，外面焦了里面还生。",
    "烤盘里堆太满，蒸汽散不掉皮变软。",
    "盐只抹在表面，皮下没味道，肉质淡而发柴。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡翅",
      "ratio": "600g 对 600g",
      "note": "烤制时间减 12 分钟。"
    },
    {
      "original": "迷迭香",
      "substitute": "百里香",
      "ratio": "8g 对 8g",
      "note": "香气更柔和，适合不吃浓香者。"
    }
  ],
  "variations": [
    "整鸡版：用 1.2kg 小整鸡，烤制 70 分钟。",
    "番茄版：土豆旁加 200g 小番茄同烤。"
  ],
  "serving_suggestion": "配烤土豆与柠檬角，浇原汁，搭一杯干白。",
  "storage": "冷藏 2 天，复热 180℃ 烤 10 分钟恢复脆皮。",
