  "steps": [
    {
      "n": 1,
      "text": "金枪鱼沥去油水，用叉子顺着纹路压散成小块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "选水浸罐头，酱的颜色更浅也更清爽。",
      "visual_cue": "鱼肉松散成小团，没有大块结块"
    },
    {
      "n": 2,
      "text": "鳀鱼切成细末，橄榄切小圈，柠檬挤出汁水备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "鳀鱼是咸鲜底味，用量按口味微调即可。",
      "visual_cue": "鳀鱼碎呈褐色细末，橄榄圈大小均匀"
    },
    {
      "n": 3,
      "text": "金枪鱼、鳀鱼与蛋黄酱入料理机，加柠檬汁与橄榄油打成顺滑糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "太稠时分次加清水，一次一勺打到能流动。",
      "visual_cue": "酱体细腻发亮，能缓慢流动"
    },
    {
      "n": 4,
      "text": "加盐与黑胡椒调味，拌入橄榄圈，装罐冷藏二十分钟后使用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏后风味融合，配冷切肉或蔬菜条都合适。",
      "visual_cue": "酱体略挺，表面平整没有气泡"
    }
  ],
  "tips": [
    "蛋黄酱本身有咸味，盐最后尝过再加。",
    "想要更清爽，可把一半蛋黄酱换成原味酸奶。",
    "冷藏能让味道融合，但别超过三天。",
    "配冷切牛肉或烤鸡胸冷片，是意式冷盘的经典搭配。"
  ],
  "common_mistakes": [
    "金枪鱼没沥干就下料理机，酱体出水变稀。",
    "鳀鱼放太多，整体咸得发苦压住鱼香。",
    "打的时间过长，酱体发热变稀失去挺度。"
  ],
  "substitutions": [
    {
      "original": "金枪鱼",
      "substitute": "三文鱼",
      "ratio": "240克:240克",
      "note": "用熟三文鱼压碎，风味更肥美。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "酸奶油",
      "ratio": "120克:120克",
      "note": "酸味更重，柠檬汁减半。"
    }
  ],
  "variations": [
    "加一大勺酸豆碎，酸咸更突出，配小牛肉最正宗。",
    "抹在烤面包上撒芝士焗三分钟，做成热前菜。"
  ],
  "serving_suggestion": "抹在烤面包或冷切肉片上，也可作蔬菜条的蘸酱。",
  "storage": "密封冷藏三天内吃完，室温放置超过两小时不要再食用。",
