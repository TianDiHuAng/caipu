  "equipment": [
    "厚底锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫三十秒后去皮，切成小丁备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "去皮番茄熬出来才顺滑，带皮的酱煮久了会卷成一片片硬皮。",
      "visual_cue": "番茄去皮完整，果肉红亮"
    },
    {
      "n": 2,
      "text": "厚底锅倒橄榄油，下蒜片与干辣椒段，小火慢煸出香味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蒜片只煸到边缘微黄就够，煸焦了整锅酱都带苦味。",
      "visual_cue": "蒜片边缘微黄，油色透出淡红"
    },
    {
      "n": 3,
      "text": "倒入番茄丁，转中火翻炒到果肉塌软出水，汤汁开始变稠。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄要炒到塌软出汁，火小了只出汤不出味，酱会稀。",
      "visual_cue": "番茄塌软，锅中有红汤"
    },
    {
      "n": 4,
      "text": "加盐与白糖，转小火熬十五分钟，中途搅两次防粘底。",
      "time_min": 12,
      "heat": "小火",
      "tip": "糖不是为了甜，是为了压住番茄的生酸，一小勺就够。",
      "visual_cue": "酱汁浓稠挂勺，表面浮一层红油"
    },
    {
      "n": 5,
      "text": "关火撒欧芹碎，趁热拌进刚煮好的主食，或直接装罐保存。",
      "time_min": 4,
      "heat": "无火",
      "tip": "欧芹关火后再放，余温就能激出香气，久煮会发黄。",
      "visual_cue": "酱色深红，欧芹翠绿点点"
    }
  ],
  "tips": [
    "这款酱的名字在意大利语里是愤怒的意思，指辣椒带来的那股冲劲。",
    "拌面时留一勺煮面水一起拌，酱更容易裹在面上不发干。",
    "用罐装去皮番茄也行，酸度更稳定，糖可以省掉。"
  ],
  "common_mistakes": [
    "干辣椒和蒜一起下锅大火爆，辣椒瞬间焦黑，酱带焦苦味。",
    "番茄没炒塌软就加水熬，酱稀如水，拌面挂不住。",
    "熬煮全程不搅，锅底结一层焦皮，翻上来全是黑点。"
  ],
  "substitutions": [
    {
      "original": "干辣椒",
      "substitute": "辣椒粉",
      "ratio": "6克:4克",
      "note": "辣椒粉易糊，需在番茄下锅后再放。"
    },
    {
      "original": "番茄",
      "substitute": "罐装去皮番茄",
      "ratio": "600克:600克",
      "note": "罐装版酸度高，糖加到八克。"
    }
  ],
  "variations": [
    "加一小把黑橄榄同熬，风味更咸鲜，是意大利南部的家常版。",
    "最后拌入一勺黄油，酱体更圆润，适合配宽面。"
  ],
  "serving_suggestion": "拌直身意面或斜管面，撒一点硬质奶酪碎，趁热吃最香。",
  "storage": "装瓶冷藏可存五天，冷冻可存两个月；开盖后表面淋油封口。",
