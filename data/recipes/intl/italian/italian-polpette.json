  "equipment": [
    "炒锅",
    "大碗",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包撕碎用少量清水泡软，挤干备用。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面包泡软能吸汁，肉丸才嫩。，看准状态再往下做。",
      "visual_cue": "面包软烂，一捏成团"
    },
    {
      "n": 2,
      "text": "猪肉末加面包、鸡蛋、芝士和一半洋葱拌匀。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌匀就好，别过度搅打。，看准状态再往下做。",
      "visual_cue": "肉料黏手，颜色均匀"
    },
    {
      "n": 3,
      "text": "加欧芹、盐和黑胡椒，顺一个方向搅到起胶。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "顺一个方向搅，丸子才不散。，看准状态再往下做。",
      "visual_cue": "肉料抱团，有黏性，这一点很关键。"
    },
    {
      "n": 4,
      "text": "搓成乒乓球大小的丸子，薄薄滚一层面粉。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "裹薄粉，煎时表面才结实。，看准状态再往下做。",
      "visual_cue": "丸子圆整，粉层薄，这一点很关键。"
    },
    {
      "n": 5,
      "text": "炒锅倒橄榄油，中火把丸子煎到各面上色。，看准状态再往下做。",
      "time_min": 8,
      "heat": "中火",
      "tip": "滚动着煎，各面才均匀上色。，看准状态再往下做。",
      "visual_cue": "表面焦褐，形状完整"
    },
    {
      "n": 6,
      "text": "盛出丸子，锅里下剩余洋葱碎炒到透明。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软，酱才不呛。，看准状态再往下做。",
      "visual_cue": "洋葱透明，油色微黄"
    },
    {
      "n": 7,
      "text": "加蒜末和番茄丁炒出汁，加盐调味。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒出汁，酱味才浓。，看准状态再往下做。",
      "visual_cue": "番茄化开，汁水冒泡"
    },
    {
      "n": 8,
      "text": "放回丸子小火炖十八分钟，中途翻一次。，看准状态再往下做。",
      "time_min": 20,
      "heat": "小火",
      "tip": "小火慢炖，丸子才入味。，看准状态再往下做。",
      "visual_cue": "丸子沉浮，酱汁变稠"
    },
    {
      "n": 9,
      "text": "关火撒罗勒碎和帕玛森芝士，配面包或面包吃。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "撒帕玛森芝士碎，趁热吃味道更浓。",
      "visual_cue": "绿点散布，酱面油亮"
    }
  ],
  "tips": [
    "面包泡软挤干，肉丸才嫩。，这一点很关键。",
    "肉料顺一个方向搅，才不散。，这一点很关键。",
    "先煎后炖，形状味道都稳。，这一点很关键。"
  ],
  "common_mistakes": [
    "肉料不搅打，下锅就散。，这一点很关键。",
    "番茄酱没收浓，汤汤水水。，这一点很关键。",
    "大火炖，丸子煮成碎渣。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉",
      "ratio": "500 克:500 克",
      "note": "风味更浓，需多炖五分钟。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "奶酪",
      "ratio": "50 克:55 克",
      "note": "咸度略低，盐可微调。"
    }
  ],
  "variations": [
    "丸子中间塞小块芝士，切开流心。，这一点很关键。",
    "加一点红椒粉，酱味更暖。，这一点很关键。"
  ],
  "serving_suggestion": "配意面或面包，把酱蘸干净。，这一点很关键。",
  "storage": "冷藏三天，冷冻两周；复热小火慢炖。",
