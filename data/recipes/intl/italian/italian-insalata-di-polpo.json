    "煮锅",
    "沙拉盆",
    "削皮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "章鱼整只冲洗干净，撕去表皮杂物，剪掉眼睛与喙附近的硬块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "触须之间容易藏沙，用指腹顺着吸盘推一遍就干净。",
      "visual_cue": "章鱼表面泛白，触须完整无破损"
    },
    {
      "n": 2,
      "text": "深锅加水与白葡萄酒烧开，整只章鱼下锅，小火煮四十分钟到触须能扎透。",
      "time_min": 45,
      "heat": "小火",
      "tip": "煮的时候别用勺子刮锅底，触须很容易断。",
      "visual_cue": "触须自然卷起，叉子能轻松扎透根部"
    },
    {
      "n": 3,
      "text": "土豆切三厘米见方的块下锅，中火煮十五分钟到软而不散，捞出沥干放凉。",
      "time_min": 15,
      "heat": "中火",
      "tip": "土豆煮到筷子能插入就捞出，别泡在热水里。",
      "visual_cue": "土豆边缘略粉，中心不再发白"
    },
    {
      "n": 4,
      "text": "芹菜斜切薄片，欧芹切碎，柠檬挤汁，章鱼放凉后切薄片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "章鱼一定要凉透再切，热切会散成碎条。",
      "visual_cue": "章鱼片边缘卷曲，切面呈乳白"
    },
    {
      "n": 5,
      "text": "橄榄油、柠檬汁、盐与黑胡椒调成汁，淋在章鱼土豆上，撒欧芹轻拌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌前先尝咸淡，章鱼吸味慢，静置十分钟更入味。",
      "visual_cue": "油汁挂在土豆表面，泛着均匀光泽"
    }
  ],
  "tips": [
    "章鱼煮好后连汤放凉，肉质更湿润不柴。",
    "土豆选粉质品种，拌的时候能吸住油汁。",
    "柠檬汁分两次加，第一次入味，第二次提香。",
    "拌好冷藏半小时再上桌，风味融合得更好。"
  ],
  "common_mistakes": [
    "章鱼用大火猛煮，触须卷成一团，外皮裂开肉质变硬。",
    "土豆煮过头泡在水里，拌的时候碎成糊状。",
    "油汁一次全倒进去，盐味不均，底层过咸。"
  ],
  "substitutions": [
    {
      "original": "章鱼",
      "substitute": "小章鱼",
      "ratio": "700克:600克",
      "note": "小章鱼煮二十五分钟就够。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "料酒",
      "ratio": "60毫升:50毫升",
      "note": "味道略重，用量减一些。"
    }
  ],
  "variations": [
    "加一把煮青豆同拌，颜色与口感都更丰富。",
    "换成整只小章鱼不切片，摆盘更有海港气息。"
  ],
  "serving_suggestion": "冷盘上桌，配两片烤面包和一杯干白，是很好的开胃前菜。",
  "storage": "冷藏可存两天，拌好后密封保存，第二天吃完。",
