  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "木铲",
    "盘",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成四厘米的块，用盐与黑胡椒抓匀腌十分钟。",
      "time_min": 11,
      "heat": "无火",
      "tip": "带皮那面朝下先煎，皮脆油香才出得来。",
      "visual_cue": "肉块大小均匀，表面挂盐"
    },
    {
      "n": 2,
      "text": "蘑菇擦净切片，洋葱切碎，大蒜切末分开放。",
      "time_min": 7,
      "heat": "无火",
      "tip": "蘑菇别切太薄，煎过会缩成一半。",
      "visual_cue": "蘑菇片均匀，色白"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油，鸡皮朝下中火煎五分钟至金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅别急着动，等皮离锅自然松开。",
      "visual_cue": "鸡皮金黄酥脆，锅底有油"
    },
    {
      "n": 4,
      "text": "翻面再煎三分钟至两面金黄，盛出备用，锅里留一层底油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "这一步只上色，内部后面还要炖。",
      "visual_cue": "两面金黄，中心略生"
    },
    {
      "n": 5,
      "text": "下洋葱碎炒三分钟，再加蒜末与百里香炒出香味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蒜末最后放，炒焦会发苦。",
      "visual_cue": "洋葱透明，香气升起"
    },
    {
      "n": 6,
      "text": "把蘑菇倒进锅里中火煎六分钟至出水又收干。",
      "time_min": 7,
      "heat": "中火",
      "tip": "蘑菇先煎到锅底干，鲜味才浓缩。",
      "visual_cue": "蘑菇缩小，锅底无汤"
    },
    {
      "n": 7,
      "text": "倒白葡萄酒煮两分钟至酒气挥发，把鸡块放回锅中。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酒气煮挥发，只留果香不留酒精味。",
      "visual_cue": "酒液减半，香气偏甜"
    },
    {
      "n": 8,
      "text": "加高汤与黄油，转小火盖盖炖十五分钟至鸡肉软嫩。",
      "time_min": 17,
      "heat": "小火",
      "tip": "汤汁微沸就行，滚太猛鸡肉会散。",
      "visual_cue": "汤汁微沸，鸡肉能用筷子穿透"
    },
    {
      "n": 9,
      "text": "开盖收汁至浓稠挂勺，尝味补盐，撒香菜碎出锅。",
      "time_min": 5,
      "heat": "中火",
      "tip": "收汁要不断晃锅，免得蘑菇粘底。",
      "visual_cue": "酱汁浓稠发亮，裹住鸡块"
    }
  ],
  "tips": [
    "用鸡腿肉比鸡胸嫩，久炖也不发柴。",
    "蘑菇混一半香菇，鲜味层次会明显提升。",
    "白葡萄酒没有的话，用高汤加半勺白醋替代。",
    "剩下的酱汁拌意面或抹面包都很合适。"
  ],
  "common_mistakes": [
    "鸡肉不煎直接炖，皮软发腻，汤汁也不香。",
    "蘑菇和鸡一起下锅，出水太多变成水煮鸡。",
    "大火收汁又不搅动，蘑菇糊在锅底发苦。"
  ],
  "substitutions": [
    {
      "original": "白葡萄酒",
      "substitute": "高汤",
      "ratio": "80毫升:90毫升",
      "note": "加半勺白醋补酸度。"
    },
    {
      "original": "蘑菇",
      "substitute": "白蘑菇",
      "ratio": "300克:300克",
      "note": "味道更温和，适合不爱菌味的人。"
    }
  ],
  "variations": [
    "加两勺淡奶油收汁，做成奶香蘑菇鸡，配面包吸汁。",
    "最后撒一把帕玛森，咸鲜更浓，是北部的吃法。"
  ],
  "serving_suggestion": "三人份主菜，配烤土豆、意面或一份硬面包，用面包把汁擦干净。",
  "storage": "冷藏两天内吃完，复热小火加两勺高汤；含奶油版本不建议冷冻。",
  "nutrition_estimate": {
    "basis": "按三人份估算",
