  "equipment": [
    "烤盘",
    "煮锅",
    "煎锅",
    "打蛋器",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱、胡萝卜与大蒜切细末，橄榄油小火炒软出甜味。",
      "time_min": 10,
      "heat": "小火",
      "tip": "蔬菜末切得越细，肉酱口感越顺滑。",
      "visual_cue": "蔬菜末软塌透明，锅底无焦"
    },
    {
      "n": 2,
      "text": "下猪肉末转中火炒散，炒到肉末出水后再收干上色。",
      "time_min": 10,
      "heat": "中火",
      "tip": "肉末先出水再收干才不腥，别急着加盐。",
      "visual_cue": "肉末颗粒分明，锅底泛油"
    },
    {
      "n": 3,
      "text": "加番茄酱炒两分钟上色，再倒入压碎的番茄小火炖二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "炖到酱体浓稠挂勺，水分太多烤时会塌。",
      "visual_cue": "酱汁深红浓稠，表面微微冒泡"
    },
    {
      "n": 4,
      "text": "另起锅化黄油加面粉炒一分钟，分次倒入牛奶搅成顺滑白酱。",
      "time_min": 10,
      "heat": "小火",
      "tip": "牛奶分次加并持续搅动，白酱才不结块。",
      "visual_cue": "白酱能裹住打蛋器，无颗粒"
    },
    {
      "n": 5,
      "text": "白酱加盐与黑胡椒调味，取三分之一拌入帕玛森备用。",
      "time_min": 3,
      "heat": "小火",
      "tip": "白酱要略咸一点，烤好后芝士会稀释咸度。",
      "visual_cue": "白酱细腻顺滑，勺背挂膜"
    },
    {
      "n": 6,
      "text": "烤盘底部铺一层肉酱，依次叠放意大利面、肉酱、白酱，重复四层。",
      "time_min": 12,
      "heat": "无火",
      "tip": "每层都压实，切块时才不会散开。",
      "visual_cue": "层次平整，酱料覆盖每片面皮"
    },
    {
      "n": 7,
      "text": "最上层铺马苏里拉与帕玛森，撒几片罗勒叶，盖锡纸入二百度烤箱烤三十分钟。",
      "time_min": 30,
      "heat": "无火",
      "tip": "先盖锡纸防表面焦黑，最后十分钟再揭开。",
      "visual_cue": "芝士融化鼓起，边缘冒泡"
    },
    {
      "n": 8,
      "text": "揭去锡纸再烤十分钟至表面金黄，出炉静置十五分钟后切块。",
      "time_min": 15,
      "heat": "无火",
      "tip": "静置是关键，刚出炉就切会流成一片。",
      "visual_cue": "表面金黄起斑，切块断面完整"
    }
  ],
  "tips": [
    "免煮意大利面要用足酱汁，否则烤后发硬。",
    "静置十五分钟再切，切面整齐不塌。",
    "肉酱可提前一天做好，风味更浓。"
  ],
  "common_mistakes": [
    "白酱没调顺滑就直接叠盘，烤后结块成团。",
    "意大利面边缘露在酱汁外，烤完变干脆发硬。",
    "出炉立刻切块，芝士未定型，切面糊成一团。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "400 克:400 克",
      "note": "风味更浓，油脂略少可加一勺橄榄油。"
    },
    {
      "original": "马苏里拉",
      "substitute": "高达奶酪",
      "ratio": "250 克:220 克",
      "note": "奶香更重，拉丝效果稍弱。"
    }
  ],
  "variations": [
    "加一层菠菜与乳清干酪，做成蔬菜版本。",
    "用现做鸡蛋面皮替代免煮面片，口感更软。"
  ],
  "serving_suggestion": "切大块盛盘，配一份简单的油醋沙拉解腻。",
  "storage": "冷藏三天、冷冻一个月；复烤一百八十度十五分钟，中途盖锡纸防干。",
