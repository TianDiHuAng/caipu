          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木铲",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "彩椒去籽去白膜，切成两厘米宽的条，番茄底部划十字泡热水去皮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "白膜一定刮净，那层才是苦味来源。这一步别省，成品口感差别很明显。",
      "visual_cue": "彩椒条齐整，番茄皮卷起"
    },
    {
      "n": 2,
      "text": "厚底锅倒一半橄榄油，中火下洋葱丝和蒜，炒四分钟至洋葱透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透出甜，别急着上色。火候和顺序都要留神，别图快。",
      "visual_cue": "洋葱透明，锅底有油光"
    },
    {
      "n": 3,
      "text": "放入彩椒条铺平，中小火煎八分钟，中途翻两次到边缘发软起皱。",
      "time_min": 9,
      "heat": "中小火",
      "tip": "彩椒要贴着锅面煎，才出甜香。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "椒皮起皱，边缘微焦，锅里状态一目了然。"
    },
    {
      "n": 4,
      "text": "加入番茄块和盐，盖盖留缝小火炖十二分钟，中途开盖翻一次。",
      "time_min": 13,
      "heat": "小火",
      "tip": "留缝散热，蒸汽太足味道会淡。这一步别省，成品口感差别很明显。",
      "visual_cue": "番茄化开，汤汁浓稠，颜色和形态变化清楚。"
    },
    {
      "n": 5,
      "text": "开盖收汁三分钟至汤汁挂在彩椒上，加黑胡椒和几滴白醋拌匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "醋别早加，久煮酸味会发冲。火候和顺序都要留神，别图快。",
      "visual_cue": "酱汁裹面，锅底无积水"
    },
    {
      "n": 6,
      "text": "关火淋剩下的橄榄油，静置五分钟让味道融合，装碗冷却后食用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置这一步不能省，味道融合后才好吃。",
      "visual_cue": "油亮发润，香气聚拢，颜色和形态变化清楚。"
    }
  ],
  "tips": [
    "彩椒要炒到边缘发软起皱再下番茄，甜味才出得来。",
    "全程中小火慢炖，火大了番茄会糊底发苦。",
    "关火后滴几滴白醋，酸甜平衡，凉了更入味。"
  ],
  "common_mistakes": [
    "大火猛炒想省时间，彩椒外焦内生，番茄结在锅底焦成黑点。",
    "番茄早早就下锅，和彩椒一起煮成烂泥，完全没了咬劲。",
    "盐一次放足后不尝味，收汁后咸得只能配大量面包下口。"
  ],
  "substitutions": [
    {
      "original": "彩椒",
      "substitute": "青椒",
      "ratio": "500克:500克",
      "note": "青椒带清气，糖分低，甜味弱一些。"
    },
    {
      "original": "白醋",
      "substitute": "柠檬",
      "ratio": "10毫升:12毫升",
      "note": "挤汁最后加，果香更亮。"
    }
  ],
  "variations": [
    "加两片去骨鳀鱼同炖，鲜味更立体，是那不勒斯的家常版本。",
    "拌进煮好的短管面里，连汤汁一起吃，直接变成一顿素面。"
  ],
  "serving_suggestion": "温着或放凉后装碗，淋一勺生榨橄榄油，配乡村面包和奶酪一起吃。",
  "storage": "冷藏可放三天，味道会越来越融合，回热时加一勺清水小火慢热。",
