          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 140,
          "unit": "g",
          "note": "冷藏切小丁",
          "optional": false
        },
        {
          "name": "糖粉",
          "name_en": "powdered sugar",
          "amount": 60,
          "unit": "g",
          "note": "挞皮用",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 1,
          "unit": "piece",
          "note": "刷面与和面",
          "optional": false
        },
        {
