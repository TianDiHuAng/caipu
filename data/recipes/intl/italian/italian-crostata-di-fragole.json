      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 70,
          "unit": "g",
          "note": "煮果酱",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "挤汁",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提甜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "挞模",
    "擀面杖",
    "打蛋盆",
    "小汤锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "低筋面粉与糖粉倒进盆里混匀，冷藏黄油切小丁丢进去，用指尖搓成粗砂粒状。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黄油保持冰凉，搓出的砂粒越松，烤好的挞皮越酥。",
      "visual_cue": "面粉呈淡黄色粗砂颗粒，没有大块黄油"
    },
    {
      "n": 2,
      "text": "磕入半个鸡蛋，加两勺冰水捏成团，包上保鲜膜冷藏松弛三十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团只捏到成形就停手，多揉会出筋，挞皮发硬。",
      "visual_cue": "面团光滑不粘手，按下去缓慢回弹"
    },
    {
      "n": 3,
      "text": "草莓切小块加白糖与一小撮盐，小火煮十分钟，再下柠檬汁与玉米淀粉煮到挂勺。",
      "time_min": 12,
      "heat": "小火",
      "tip": "果酱别煮太干，放凉后还会再稠一档。",
      "visual_cue": "果酱冒小泡，木勺划过留下清晰的沟"
    },
    {
      "n": 4,
      "text": "面团分成两份，大的一份擀成三毫米薄片铺进挞模，底部用叉子扎满小孔。",
      "time_min": 15,
      "heat": "无火",
      "tip": "面片比模具大一圈再铺，边缘留出余量好收口。",
      "visual_cue": "面片紧贴模壁，扎孔后微微下陷"
    },
    {
      "n": 5,
      "text": "倒进放凉的果酱抹平，剩余面团切成长条编成菱形网格，边缘压紧刷蛋液。",
      "time_min": 12,
      "heat": "无火",
      "tip": "编网格的面片条疏一点，果酱受热冒泡才有空隙。",
      "visual_cue": "网格交错均匀，蛋液薄薄一层泛光"
    },
    {
      "n": 6,
      "text": "烤箱预热两百度，中层烤三十五分钟到表面金黄，出炉完全放凉再脱模。",
      "time_min": 35,
      "heat": "中火",
      "tip": "烤到二十分钟时盖一张锡纸，防止网格上色过深。",
      "visual_cue": "表面金黄起酥，果酱从格子里冒出小泡"
    }
  ],
  "tips": [
    "挞皮黄油用量足，出炉后要完全放凉再脱模，热着脱模容易散。",
    "草莓偏酸时把白糖加到八十克，果酱酸度会更平衡。",
    "果酱可提前三天做好冷藏，赶时间时能省一大半工夫。",
    "剩余面片搓成小圆饼一起烤，撒糖粉当零嘴正好。"
  ],
  "common_mistakes": [
    "黄油软化过头再搓，面团出油，烤好的挞皮发硬不酥。",
    "果酱趁热倒进生面皮，挞底吸湿，出炉后底部发黏。",
    "烤箱温度不够高，挞皮烤不透，凉后回软完全没有脆感。"
  ],
  "substitutions": [
    {
      "original": "低筋面粉",
      "substitute": "全麦面粉",
      "ratio": "250克:250克",
      "note": "全麦吸水多，冰水多放一勺。"
    },
    {
      "original": "草莓",
      "substitute": "蓝莓",
      "ratio": "500克:450克",
      "note": "蓝莓果胶少，玉米淀粉加到二十克。"
    }
  ],
  "variations": [
    "换成桃子切块做夹心，糖减到五十克，果香更清淡爽口。",
    "挞皮里拌入一勺杏仁粉，坚果香气更明显，口感也更松。"
  ],
  "serving_suggestion": "切块后撒一层糖粉，配一小勺淡奶油或一杯红茶都很合适。",
  "storage": "室温可放一天，冷藏能存三天，回温后一百五十度烤五分钟恢复酥脆。",
