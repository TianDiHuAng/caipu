  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 800,
          "unit": "g",
          "note": "熟透的罗马番茄或罐装去皮番茄",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 20,
          "unit": "g",
          "note": "拍碎切末",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 80,
          "unit": "g",
          "note": "切细末",
          "optional": false
        },
        {
          "name": "罗勒",
          "name_en": "basil",
          "amount": 10,
          "unit": "g",
          "note": "新鲜叶片，最后放",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 40,
          "unit": "ml",
          "note": "初榨橄榄油",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "分次调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "平衡酸度",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底酱锅",
    "木勺",
    "料理机"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄底部划十字，用沸水烫四十秒后剥皮去蒂，切成小块，保留流出的汁水。",
      "time_min": 6,
      "heat": "中火",
      "tip": "烫皮时间不宜长，果肉变软出水太多会稀释酱味。",
      "visual_cue": "番茄皮自动卷边、果肉仍紧实"
    },
    {
      "n": 2,
      "text": "厚底锅倒橄榄油，小火下大蒜末与洋葱末，慢慢炒到透明出香而完全不焦。",
      "time_min": 6,
      "heat": "小火",
      "tip": "大蒜一旦变褐就发苦，全程小火并不断推动。",
      "visual_cue": "蒜末浅金、洋葱透明无焦边"
    },
    {
      "n": 3,
      "text": "倒入番茄块与番茄汁，用木勺压碎果肉，加盐与白糖翻匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "盐加早能让番茄更快出汁，糖只用来压酸不要吃出甜。",
      "visual_cue": "番茄塌软、汤汁泛起细密气泡"
    },
    {
      "n": 4,
      "text": "转小火敞锅慢煮，中途撇去浮沫并偶尔搅动，煮到酱体浓稠挂勺。",
      "time_min": 12,
      "heat": "小火",
      "tip": "敞锅慢煮是浓缩风味的关键，盖盖会出水成汤。",
      "visual_cue": "酱汁减量约三分之一、木勺划过留痕"
    },
    {
      "n": 5,
      "text": "关火后撕入罗勒叶拌匀，尝味补盐，静置五分钟让香气融合。",
      "time_min": 2,
      "heat": "无火",
      "tip": "罗勒关火后再放，久煮会发黑并失去清香。",
      "visual_cue": "罗勒叶变软、酱面泛油亮红光"
    }
  ],
  "tips": [
    "罐装去皮番茄风味更稳定，冬季尤其推荐。",
    "煮好的酱静置一夜更融合，是意面的万能底酱。",
    "橄榄油要多，油层能隔绝空气，延长保存。"
  ],
  "common_mistakes": [
    "全程大火滚煮，酱汁飞溅变干，番茄的甜味被煮成焦苦。",
    "罗勒与番茄一起久炖，叶片发黑，整锅酱带闷味。",
    "盐一次加太多，收汁后咸得无法入口，只能靠加水补救。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "罐装去皮番茄",
      "ratio": "800g 对 800g",
      "note": "罐装已加盐，配方用盐减半。"
    },
    {
      "original": "罗勒",
      "substitute": "干牛至",
      "ratio": "10g 对 3g",
      "note": "干香草需在煮酱时加入，风味才出得来。"
    }
  ],
  "variations": [
    "加一小撮干辣椒与黑橄榄，做成辣味拿波里风番茄酱。",
    "最后拌入一勺黄油，酱汁更圆润，适合搭配宽面。"
  ],
  "serving_suggestion": "浇在刚出锅的意面上拌匀，撒帕玛森芝士与新鲜罗勒叶。",
  "storage": "密封冷藏五天，冷冻三个月；分装小份，取用不回锅整体。",
