  "equipment": [
    "厚底锅",
    "木勺",
    "汤勺",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "高汤在小锅里保持微热，另起厚底锅倒橄榄油炒洋葱末与蒜末至透明。",
      "time_min": 6,
      "heat": "小火",
      "tip": "高汤必须热着加，冷水会中断糊化。",
      "visual_cue": "洋葱透明、香气散出"
    },
    {
      "n": 2,
      "text": "蘑菇片用平底锅大火单独煎到金黄出香，撒少许盐盛出备用。",
      "time_min": 8,
      "heat": "大火",
      "tip": "蘑菇分批煎，锅不降温才焦。",
      "visual_cue": "蘑菇金黄、边缘卷起"
    },
    {
      "n": 3,
      "text": "大米倒进洋葱锅里中火翻炒两分钟，米粒边缘变透明、中心仍白。",
      "time_min": 5,
      "heat": "中火",
      "tip": "炒米让米粒裹油，煮后才粒粒分明。",
      "visual_cue": "米粒透亮、带油光"
    },
    {
      "n": 4,
      "text": "倒白葡萄酒煮到酒气散尽，分次加高汤每次一勺，边加边搅十八分钟。",
      "time_min": 18,
      "heat": "小火",
      "tip": "每次汤汁吸干再加，搅动出米浆。",
      "visual_cue": "米粒饱满、汤汁乳白"
    },
    {
      "n": 5,
      "text": "拌入蘑菇、黄油与帕玛森芝士，加盐与黑胡椒调味，静置一分钟上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "离火拌黄油，质地才顺滑。",
      "visual_cue": "饭体流动、芝士拉丝"
    }
  ],
  "tips": [
    "高汤要热着分次加，冷汤会让米粒外层骤缩、内里夹生。",
    "搅动是烩饭的关键，米粒互相摩擦才释放淀粉形成奶油质地。",
    "最后的黄油与芝士必须离火拌入，温度过高会油水分离。"
  ],
  "common_mistakes": [
    "一次倒进全部高汤，煮成夹生粥。",
    "蘑菇和米一起煮，出水把饭泡软还失了焦香。",
    "火太大又不停猛搅，米粒被搅碎成糊。"
  ],
  "substitutions": [
    {
      "original": "蘑菇",
      "substitute": "香菇",
      "ratio": "250g 对 200g",
      "note": "香气更浓，需多煎两分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "料酒",
      "ratio": "60ml 对 40ml",
      "note": "香气略冲，用量减半。"
    }
  ],
  "variations": [
    "松露版：出锅拌入 5g 松露酱。",
    "海鲜版：加 200g 虾与 100g 蛤蜊，最后五分钟放。"
  ],
  "serving_suggestion": "盛进浅盘，撒帕玛森碎与黑胡椒，趁热流动时吃。",
  "storage": "冷藏可存 1 天，复热需加少量高汤小火搅开。",
