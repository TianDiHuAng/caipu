      "items": [
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 400,
          "unit": "g",
          "note": "去皮切碎",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 60,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 10,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "罗勒",
          "name_en": "basil",
          "amount": 5,
          "unit": "g",
          "note": "撕碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 30,
          "unit": "ml",
          "note": "炒底用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "帕玛森芝士",
          "name_en": "Parmesan",
          "amount": 20,
          "unit": "g",
          "note": "擦丝撒面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "锅盖",
    "木勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "平底锅倒橄榄油，下洋葱末与蒜片小火炒到透明出香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒到透明甜味才出来，炒上色会带一点焦苦。",
      "visual_cue": "洋葱透明，蒜片边缘微黄"
    },
    {
      "n": 2,
      "text": "加番茄碎翻炒，中火煮十分钟到汁水浓稠，锅边见红油。",
      "time_min": 12,
      "heat": "中火",
      "tip": "番茄要炒到出红油，汁水太稀蛋会漂在上面定不住。",
      "visual_cue": "番茄成浓汁，锅边见红油"
    },
    {
      "n": 3,
      "text": "补盐与黑胡椒，用勺背在酱汁里压出四个浅坑。",
      "time_min": 3,
      "heat": "小火",
      "tip": "坑要压得深一点，蛋打进去才不容易滑到锅边。",
      "visual_cue": "酱面四个浅坑，间距均匀"
    },
    {
      "n": 4,
      "text": "鸡蛋逐个打入小碗再滑进坑里，撒盐与黑胡椒。",
      "time_min": 4,
      "heat": "小火",
      "tip": "先打小碗再滑入，万一有蛋壳或散黄，不会毁掉整锅。",
      "visual_cue": "蛋黄完整，蛋白铺在酱上"
    },
    {
      "n": 5,
      "text": "盖上锅盖小火焖六分钟，蛋白凝固，蛋黄还是软的。",
      "time_min": 6,
      "heat": "小火",
      "tip": "全程小火，火大蛋白起泡变硬，蛋黄却还是生的。",
      "visual_cue": "蛋白凝固，蛋黄表面薄一层"
    },
    {
      "n": 6,
      "text": "撒罗勒碎与帕玛森芝士，直接连锅端上桌趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "芝士最后撒，靠余温化开就够，久煮会拉成硬丝。",
      "visual_cue": "芝士微融，罗勒翠绿新鲜"
    }
  ],
  "tips": [
    "这是一道意大利家常早餐，一锅出四只蛋，配面包蘸汁最香。",
    "番茄用熟透的，甜度高，汁水也足。",
    "想要更浓可以加一勺番茄酱，颜色更红亮。"
  ],
  "common_mistakes": [
    "火力太大，蛋白起满大泡，口感像橡胶。",
    "番茄汁太稀，蛋滑到锅边摊成一片，形状全散。",
    "焖过头蛋黄全硬，拌不出流心的效果。"
  ],
  "substitutions": [
    {
      "original": "帕玛森芝士",
      "substitute": "奶酪",
      "ratio": "20克:25克",
      "note": "普通奶酪咸度低，盐可略增。"
    },
    {
      "original": "番茄",
      "substitute": "番茄酱",
      "ratio": "400克:200克",
      "note": "番茄酱版需加一百毫升清水调稀。"
    }
  ],
  "variations": [
    "加几片火腿同煮，咸香更足，适合当正餐。",
    "放一把菠菜垫底，颜色和营养都更好。"
  ],
  "serving_suggestion": "连锅端上桌，配烤面包片蘸着浓汁吃，撒现磨黑胡椒。",
  "storage": "建议现做现吃，冷藏后蛋黄会完全凝固，复热风味也变差。",
