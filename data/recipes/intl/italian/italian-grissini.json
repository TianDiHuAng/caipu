          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "擀面杖",
    "烤盘",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水化开酵母静置五分钟，表面浮起细泡说明活性正常。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酵母先用水激活，直接撒在面粉里容易颗粒不均。",
      "visual_cue": "水面浮起一层细泡，边缘泛白"
    },
    {
      "n": 2,
      "text": "面粉加盐、橄榄油与酵母水揉成偏硬的面团，揉到表面不那么粘手。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团要比做普通发面点心的硬一些，太软搓不成条，一搓就塌。",
      "visual_cue": "面团紧实，按下去回弹快"
    },
    {
      "n": 3,
      "text": "盖湿布醒发到一点五倍大，手指按下去留下浅坑。",
      "time_min": 60,
      "heat": "无火",
      "tip": "醒发不足的面团一擀就回缩，搓条时容易断。",
      "visual_cue": "面团鼓起，指尖压出浅坑"
    },
    {
      "n": 4,
      "text": "面团擀成半厘米厚的方片，切成半厘米宽的长条。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切得越细越脆，粗细不匀烤的时候细的先焦。",
      "visual_cue": "长条整齐，粗细接近一致"
    },
    {
      "n": 5,
      "text": "手掌搓圆长条，撒迷迭香碎，摆在烤盘上留出间距。",
      "time_min": 12,
      "heat": "无火",
      "tip": "搓的时候用掌根轻推，用力压会把面团里的气全挤掉。",
      "visual_cue": "长条圆润，香草粘在表面"
    },
    {
      "n": 6,
      "text": "烤箱一百八十度烤十八分钟，直到变成浅浅的金黄色。",
      "time_min": 18,
      "heat": "无火",
      "tip": "出炉时还有点软是正常的，放凉后会变脆。",
      "visual_cue": "表面浅金，敲着发脆响"
    }
  ],
  "tips": [
    "这种细长脆条是意大利北部的餐前小吃，都灵一带做得最出名。",
    "搓得越细越脆，粗的版本偏软，适合配浓汤蘸食。",
    "烤好后密封保存，回潮时回炉三分钟恢复脆度。"
  ],
  "common_mistakes": [
    "面团揉得太软，搓条时全塌在台面上不成形。",
    "烤到颜色很深才出炉，凉后发苦，香气也没了。",
    "长条摆得太密，烤完粘成一大块，掰开全是碎的。"
  ],
  "substitutions": [
    {
      "original": "迷迭香",
      "substitute": "黑胡椒",
      "ratio": "4克:3克",
      "note": "黑胡椒版更冲，适合配酒。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "40毫升:40克",
      "note": "黄油版香气更浓，但已不是传统做法。"
    }
  ],
  "variations": [
    "表面撒一层芝麻同烤，香气更浓，口感也更丰富。",
    "搓成长条后绕成圈，就是意大利的环形脆条，摆盘很好看。"
  ],
  "serving_suggestion": "放在竹篮里当餐前小食，配橄榄、火腿和一杯白葡萄酒。",
  "storage": "密封常温可存一周，回潮后烤箱一百五十度烤三分钟即脆。",
