          "unit": "ml",
          "note": "去腥提香",
          "optional": false
        },
        {
          "name": "番茄膏",
          "name_en": "tomato paste",
          "amount": 30,
          "unit": "g",
          "note": "增色浓缩味",
          "optional": false
        },
        {
          "name": "迷迭香",
