          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底炖锅",
    "锡纸",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用厨房纸吸干水分，两面抹 5g 盐与 2g 黑胡椒，静置 15 分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "表面干才能煎出脆皮。",
      "visual_cue": "鸡皮干爽、调料贴合"
    },
    {
      "n": 2,
      "text": "厚底锅烧热下 40ml 橄榄油，鸡皮朝下中火煎 6 分钟至金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "不要频繁翻动，皮面定型后再翻。",
      "visual_cue": "鸡皮金黄焦脆、锅底留褐色焦物"
    },
    {
      "n": 3,
      "text": "翻面再煎 3 分钟，取出鸡肉，用留底油炒洋葱丝与蒜末至透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "焦物别刮掉，那是后续的香味来源。",
      "visual_cue": "洋葱软塌透亮、香味散出"
    },
    {
      "n": 4,
      "text": "下蘑菇与胡萝卜块炒 4 分钟，倒入 30g 番茄膏炒出红油。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄膏要炒到颜色加深才不酸。",
      "visual_cue": "蘑菇出水回缩、番茄膏呈深红"
    },
    {
      "n": 5,
      "text": "倒入 100ml 白葡萄酒刮起锅底焦物，煮至酒味挥发剩一半。",
      "time_min": 3,
      "heat": "中火",
      "tip": "刮底能让所有焦香溶进汤汁。",
      "visual_cue": "酒气散去、汤汁略稠"
    },
    {
      "n": 6,
      "text": "放回鸡腿，加番茄块、3g 盐、1g 黑胡椒与迷迭香，盖盖小火炖 25 分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "小火慢炖鸡肉才不柴。",
      "visual_cue": "汤汁微沸、番茄化开成酱"
    },
    {
      "n": 7,
      "text": "开盖收汁 5 分钟至汤汁挂勺，尝味补盐后出锅。",
      "time_min": 5,
      "heat": "中火",
      "tip": "收汁时轻推锅底防糊。",
      "visual_cue": "汤汁浓稠挂勺、鸡皮呈酱红色"
    }
  ],
  "tips": [
    "带骨鸡腿比鸡胸肉耐炖，久煮仍嫩。",
    "番茄膏别省，它决定这道菜的浓度和颜色。",
    "最后撒一把欧芹碎，香气会立刻立体。"
  ],
  "common_mistakes": [
    "鸡皮没擦干就下锅，煎出一锅水汽皮软不脆。",
    "白葡萄酒没煮挥发就加番茄，成品带生酒酸味。",
    "大火收汁过久，番茄发苦、鸡肉变干。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "800g 对 700g",
      "note": "鸡胸易老，炖的时间缩短到 12 分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "料酒加清水",
      "ratio": "100ml 对 50ml 料酒加 50ml 水",
      "note": "风味略减，补 2g 白糖平衡酸度。"
    }
  ],
  "variations": [
    "猎人经典版：加 80g 黑橄榄与 60g 刺山柑，酸香更突出。",
    "红酒版：白葡萄酒换等量红葡萄酒，颜色更深。"
  ],
  "serving_suggestion": "配硬皮面包蘸汤汁，或配玉米糊与意面。",
  "storage": "冷藏 3 天，隔夜更入味；复热加少量水，小火慢热。",
