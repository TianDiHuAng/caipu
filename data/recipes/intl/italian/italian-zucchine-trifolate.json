        {
          "name": "西葫芦",
          "name_en": "zucchini",
          "amount": 600,
          "unit": "g",
          "note": "切薄片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 12,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 10,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 80,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 45,
          "unit": "ml",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味并帮助出水",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "辣椒碎",
          "name_en": "chili flakes",
          "amount": 1,
          "unit": "g",
          "note": "可省略",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "砧板",
    "锅铲",
    "滤盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西葫芦洗净切成三毫米厚的薄片，撒两克盐拌匀静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "撒盐出水，能去掉生涩味也避免下锅出汤。",
      "visual_cue": "西葫芦片变软，表面渗出细密水珠"
    },
    {
      "n": 2,
      "text": "把西葫芦片放进滤盆，用手轻压挤出多余水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "压得太狠会失去脆感，轻压一遍就够。",
      "visual_cue": "滤盆下积起一层浅绿汁水"
    },
    {
      "n": 3,
      "text": "平底锅中火热三分之二的橄榄油，下蒜片与辣椒碎炒出香味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蒜片一变色就下菜，焦了整锅会发苦。",
      "visual_cue": "蒜片边缘泛浅金，闻到辛辣香"
    },
    {
      "n": 4,
      "text": "加入洋葱丝炒到微透明，再倒入西葫芦片摊平。",
      "time_min": 5,
      "heat": "中火",
      "tip": "摊平不要堆高，堆在一起会焖成软泥。",
      "visual_cue": "洋葱丝塌软，西葫芦层均匀铺满"
    },
    {
      "n": 5,
      "text": "中火煎三分钟不翻动，让底部贴锅面煎出焦边。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先煎一面才有香气，一直翻炒只会出水。",
      "visual_cue": "边缘出现浅褐焦斑，片形仍完整"
    },
    {
      "n": 6,
      "text": "翻炒均匀之后再煎两分钟，加盐与黑胡椒调味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "盐最后放，早放会继续出水把锅变汤。",
      "visual_cue": "西葫芦软而带韧，锅里没有多余汤水"
    },
    {
      "n": 7,
      "text": "关火淋上剩下的橄榄油，撒欧芹碎拌匀后装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生橄榄油最后淋，果香比加热过的清亮。",
      "visual_cue": "表面油光清亮，香草均匀附着"
    }
  ],
  "tips": [
    "西葫芦要选细嫩的，籽少的口感更脆。",
    "一次别煎太多，锅里挤了就只能焖熟。",
    "冷吃也好吃，冷藏后当作凉菜风味更清爽。",
    "撒一点帕玛森芝士碎，咸香更足。"
  ],
  "common_mistakes": [
    "西葫芦不撒盐直接下锅，出汤变成一锅水煮菜。",
    "火太小慢慢煎，成品软烂全程没有焦边。",
    "蒜片和菜一起下锅久炒，焦苦味盖掉清香。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "茄子",
      "ratio": "600克:500克",
      "note": "茄子需多放油，煎的时间延长三分钟。"
    },
    {
      "original": "辣椒碎",
      "substitute": "黑胡椒",
      "ratio": "1克:2克",
      "note": "去掉辣味，香气更温和。"
    }
  ],
  "variations": [
    "加几片泡软的干番茄同煎，酸甜更突出。",
    "最后打一颗鸡蛋进去，做成意式蔬菜烘蛋的简化版。"
  ],
  "serving_suggestion": "温热时装盘，配烤肉或意面当配菜，也可冷藏后当开胃凉菜。",
  "storage": "冷藏两天，复热用平底锅小火翻热两分钟，不建议微波以免出水。",
