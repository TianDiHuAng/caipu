  "equipment": [
    "厚底炖锅",
    "炒锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩块用厨房纸吸干血水，撒四克盐、黑胡椒和面粉抓匀，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "薄薄一层面粉能在炖时自然增稠，别裹太厚。",
      "visual_cue": "牛腩表面干爽，裹着薄薄一层白粉"
    },
    {
      "n": 2,
      "text": "厚底锅化开黄油，下洋葱丝小火炒到透明微甜，盛出备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "洋葱炒到发甜再炖，汤底会多一层回甘。",
      "visual_cue": "洋葱丝软塌透明，锅底略带褐色"
    },
    {
      "n": 3,
      "text": "牛腩分批下锅，中大火煎到各面深褐，取出备用。",
      "time_min": 12,
      "heat": "中大火",
      "tip": "分批煎是关键，挤满一锅只会出水变成煮肉。",
      "visual_cue": "牛腩表面形成深褐色焦层"
    },
    {
      "n": 4,
      "text": "倒啤酒煮开刮起锅底焦香，放回牛腩与洋葱，加高汤、百里香和月桂叶。",
      "time_min": 8,
      "heat": "中火",
      "tip": "刮锅底这步别省，焦香层是整锅汤的味道核心。",
      "visual_cue": "锅底褐色物溶解，汤汁呈深琥珀色"
    },
    {
      "n": 5,
      "text": "小火盖盖炖一小时，加入胡萝卜与一半土豆，继续炖四十分钟。",
      "time_min": 100,
      "heat": "小火",
      "tip": "土豆分两次下，先下的化开增稠，后下的保持形状。",
      "visual_cue": "牛腩用筷子能插入，土豆边缘开始崩裂"
    },
    {
      "n": 6,
      "text": "放入余下土豆炖二十分钟，取几块土豆压成泥搅回汤里，补盐后撒欧芹。",
      "time_min": 24,
      "heat": "小火",
      "tip": "压土豆增稠比勾芡自然，汤汁能挂住勺子。",
      "visual_cue": "汤汁浓稠乳白，牛腩酥软不散"
    }
  ],
  "tips": [
    "牛腩选带筋膜的部位，久炖后胶质融化，汤会自然稠厚。",
    "黑啤带来麦芽香，不喝酒可用等量高汤加一小勺糖替代。",
    "炖好后放凉撇去表面浮油，再复热会更清爽。"
  ],
  "common_mistakes": [
    "牛腩没吸干就下锅，煎不出焦色，汤色发灰。",
    "全程大火，土豆化成一锅糊、牛腩散成丝。",
    "盐一次加足，收汁后整锅过咸，最后调味须分两次进行。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "羊肉",
      "ratio": "900 克:850 克",
      "note": "爱尔兰传统也用羊肉，炖煮时间可缩短十分钟。"
    },
    {
      "original": "啤酒",
      "substitute": "高汤",
      "ratio": "300 毫升:300 毫升",
      "note": "无酒版本，需补一克盐。"
    }
  ],
  "variations": [
    "加入芹菜根或防风根，可做成更接近爱尔兰乡间的蔬菜版本。"
  ],
  "serving_suggestion": "盛进深盘，配苏打面包与一勺芥末酱，蘸汤汁吃。",
  "storage": "冷藏三天，冷冻两个月，复热时加少量高汤防止过稠。",
