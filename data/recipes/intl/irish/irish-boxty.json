      "group": "main",
      "items": [
        {
          "name": "土豆",
          "name_en": "potato",
          "amount": 600,
          "unit": "g",
          "note": "一半擦蓉一半煮熟压泥",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 180,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 100,
          "unit": "ml",
          "note": "调糊用",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "煎饼用",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "切细花",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "擦蓉器",
    "和面盆",
    "平底锅",
    "锅铲",
    "纱布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "一半土豆去皮擦成细蓉，用纱布包住用力挤干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水一定要挤干，不然面糊稀得不成形。",
      "visual_cue": "薯蓉干爽，捏起来能成团"
    },
    {
      "n": 2,
      "text": "另一半土豆切块煮熟，捞出趁热压成细腻的土豆泥。",
      "time_min": 12,
      "heat": "中火",
      "tip": "煮到叉子一戳就散，压出来才细腻。",
      "visual_cue": "泥体细腻，没有硬块"
    },
    {
      "n": 3,
      "text": "把薯蓉、土豆泥与面粉一起倒入大盆，加盐与黑胡椒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "两种土豆混合，口感才外脆内软。",
      "visual_cue": "三样食材分层铺在盆底"
    },
    {
      "n": 4,
      "text": "分次倒入牛奶，用手揉成光滑且不粘手的软面团。",
      "time_min": 4,
      "heat": "无火",
      "tip": "牛奶别一次倒完，看面团软硬再补。",
      "visual_cue": "面团光滑，按下去会回弹"
    },
    {
      "n": 5,
      "text": "面团分成四份，擀成一厘米厚的圆饼，撒上小葱。",
      "time_min": 6,
      "heat": "无火",
      "tip": "厚薄一致，煎的时候才能同时熟。",
      "visual_cue": "四张饼大小均匀，厚度一致"
    },
    {
      "n": 6,
      "text": "平底锅放黄油小火化开，放入薯饼煎四分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "小火慢煎，里面才熟透不夹生。",
      "visual_cue": "底面金黄，边缘定型"
    },
    {
      "n": 7,
      "text": "翻面后再煎四分钟，两面金黄即可出锅装盘。",
      "time_min": 4,
      "heat": "小火",
      "tip": "翻面要果断，一次翻过去才不破皮。",
      "visual_cue": "两面金黄，饼身微微鼓起"
    },
    {
      "n": 8,
      "text": "出锅放厨房纸上吸去多余油脂，趁热切开食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "吸一下油，吃起来清爽不腻口。",
      "visual_cue": "表面无浮油，切面松软"
    }
  ],
  "tips": [
    "生土豆蓉必须挤干水分，这是成败的关键。",
    "面团软硬像耳垂最好，太硬煎出来发干。",
    "用黄油煎比植物油香，别省这一步。"
  ],
  "common_mistakes": [
    "薯蓉没挤水，面糊稀得摊不成饼。",
    "火太大，外面焦了里面还是生土豆。",
    "面团揉得太硬，煎出来像石头一样。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "粘米粉",
      "ratio": "180 克:160 克",
      "note": "口感更软糯，需多加二十毫升牛奶。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "100 毫升:90 毫升",
      "note": "风味略淡，可加十克黄油补香。"
    }
  ],
  "variations": [
    "面糊里拌一把奶酪丝，煎出拉丝的口感。",
    "做成小圆饼当早餐，配一个煎蛋一起吃。"
  ],
  "serving_suggestion": "配煎蛋和培根，或者抹上黄油趁热吃。",
  "storage": "冷藏两天，复热用平底锅干烙两分钟。",
