  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切块，泡水洗去表面淀粉。，注意别烧干，口感才不发柴。",
      "time_min": 10,
      "heat": "无火",
      "tip": "洗去淀粉，汤才不黏。，别急着加油，整道菜才立得住。",
      "visual_cue": "水色微白，块面干爽，手法轻些，整道菜才立得住。"
    },
    {
      "n": 2,
      "text": "洋葱切细丝，越薄越好。，翻动放轻，食材才不糊。，盖盖焖一会儿，味道才不闷。",
      "time_min": 6,
      "heat": "无火",
      "tip": "丝切薄，炒时才出甜。，锅温要匀，香气才不跑。",
      "visual_cue": "丝形细长，均匀一致，份量心里有数，成品才好看。"
    },
    {
      "n": 3,
      "text": "汤锅化黄油，小火炒洋葱到透明。，留意锅底，口感才不散。",
      "time_min": 6,
      "heat": "小火",
      "tip": "火别大，洋葱才不焦。，注意别烧干，吃口才舒服。",
      "visual_cue": "洋葱软塌，颜色透亮，火别太大，火候才均匀。"
    },
    {
      "n": 4,
      "text": "下土豆块翻炒两分钟，裹上黄油。，别用力搅，口感才不散。",
      "time_min": 3,
      "heat": "中火",
      "tip": "裹油再煮，汤才香。，火别太大，颜色才够亮。",
      "visual_cue": "块面油亮，边缘微透，时间掐准，香气才不跑。"
    },
    {
      "n": 5,
      "text": "倒清水煮开，转小火煮二十分钟。，料别一次下太多，口感才有层次。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火煮透，土豆才绵。，慢慢来别急，味道才进得去。",
      "visual_cue": "块体软烂，一压就碎，留意锅底，整道菜才立得住。"
    },
    {
      "n": 6,
      "text": "用搅拌机打成顺滑的泥，倒回锅里。，先试试温度，香气才留得住。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打细一些，口感才顺。，起锅前尝味，香气才不跑。",
      "visual_cue": "糊体顺滑，无颗粒，手法轻些，食材才不糊。"
    },
    {
      "n": 7,
      "text": "倒牛奶和淡奶油，小火加热不要沸。，保持小火，味道才不闷。",
      "time_min": 5,
      "heat": "小火",
      "tip": "奶后加，别久煮。，起锅前尝味，表面才漂亮。",
      "visual_cue": "汤色乳白，质地浓稠，留意锅底，味道才进得去。"
    },
    {
      "n": 8,
      "text": "加盐和黑胡椒调味，撒小葱末。，盖盖焖一会儿，风味才干净。",
      "time_min": 4,
      "heat": "小火",
      "tip": "尝一下再补盐，别偏咸。，手法轻些，吃口才舒服。",
      "visual_cue": "汤面光滑，葱末点缀，动作放连贯，整道菜才立得住。"
    }
  ],
  "tips": [
    "土豆泡水去淀粉，汤才不黏。，别急着加油，味道才不闷。",
    "洋葱炒到透明，甜味才出来。，料别一次下太多，颜色才够亮。",
    "奶类后加且别煮沸，口感才顺。，下手别慌，成品才好看。"
  ],
  "common_mistakes": [
    "土豆不泡水，汤发黏。，汤汁别收太干，口感才有层次。",
    "洋葱炒焦，汤带苦味。，顺序照着来，整道菜才立得住。",
    "牛奶煮沸，汤起絮。，保持小火，整道菜才立得住。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "80 毫升:80 毫升",
      "note": "更清爽，黄油可加十克。"
    },
    {
      "original": "洋葱",
      "substitute": "韭葱",
      "ratio": "200 克:250 克",
      "note": "香气更清，炒制时间加两分钟。"
    }
  ],
  "variations": [
    "加培根碎，咸香更足。，料别一次下太多，吃口才舒服。",
    "加一片面包丁，口感更实。，锅温要匀，成品才好看。"
  ],
  "serving_suggestion": "配黑麦面包，撒黑胡椒。，留意锅底，锅气才足。",
  "storage": "冷藏两天，复热加牛奶。，慢慢来别急，整道菜才立得住。",
