          "name_en": "water",
          "amount": 500,
          "unit": "ml",
          "note": "煮茶用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "极少量提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小汤锅",
    "茶壶",
    "刀",
    "砧板",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小汤锅倒进清水，中火烧到锅边冒出细密小泡、水面开始冒气时关火。",
      "time_min": 6,
      "heat": "中火",
      "tip": "水刚冒气就够，滚沸的水会把茶叶烫出涩味。",
      "visual_cue": "锅边布满细泡，水面冒热气"
    },
    {
      "n": 2,
      "text": "投入红茶叶，盖盖焖四分钟，让茶色完全释出成深琥珀色。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用焖不用煮，茶叶不翻滚，涩味就少，茶汤也更清亮。",
      "visual_cue": "茶汤深琥珀色，香气明显"
    },
    {
      "n": 3,
      "text": "柠檬用盐搓洗表皮，冲净后切成三毫米厚的圆片，去掉两头。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐搓能去掉表皮蜡质与苦味，切之前一定要洗干净。",
      "visual_cue": "柠檬片薄厚均匀，表皮干净"
    },
    {
      "n": 4,
      "text": "滤掉茶叶，把茶汤倒进茶壶，加白糖与蜂蜜搅到完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热加糖才化得开，冷了就沉在壶底。",
      "visual_cue": "茶汤清澈，无糖粒残留"
    },
    {
      "n": 5,
      "text": "放两片柠檬进壶，用手轻压出一点汁，剩下的一片留作装饰。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬只用两片压味，放多了会苦，皮久泡也发涩。",
      "visual_cue": "茶汤微微泛黄，柠檬香浮出"
    },
    {
      "n": 6,
      "text": "杯子里先放柠檬片，再倒入热茶，最后放几片薄荷叶点缀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "茶倒进杯子再放薄荷，香气才留得住，不会闷熟。",
      "visual_cue": "杯面浮薄荷，柠檬片透亮"
    },
    {
      "n": 7,
      "text": "趁热喝，喝到一半可以再添热水续泡一次，味道还在。",
      "time_min": 1,
      "heat": "无火",
      "tip": "第二泡时间减半，茶味才不会变淡成水。",
      "visual_cue": "茶汤色泽转浅，仍有柠檬香"
    }
  ],
  "tips": [
    "阿萨姆或锡兰红茶最适合，茶味厚，压得住柠檬。",
    "蜂蜜要比白糖少放，两者叠加会过甜。",
    "加一小片生姜同泡，冬天喝更暖，也能压住茶涩。",
    "冰镇后加满冰块，再补两片柠檬，就是夏日柠檬茶。"
  ],
  "common_mistakes": [
    "用滚水猛煮茶叶，茶汤发苦，加多少糖都盖不住。",
    "柠檬连皮久泡，喝到后半杯全是苦涩味。",
    "糖在凉茶里加，怎么搅都化不开，杯底一层甜渣。"
  ],
  "substitutions": [
    {
      "original": "红茶",
      "substitute": "乌龙茶",
      "ratio": "10克:10克",
      "note": "香气更清雅，焖泡时间缩短一分钟。"
    },
    {
      "original": "蜂蜜",
      "substitute": "枫糖浆",
      "ratio": "15克:15克",
      "note": "风味更浓，用量可减至10克。"
    }
  ],
  "variations": [
    "加一勺爱尔兰威士忌与一片橙皮，做成冬夜暖身的版本。",
    "换成绿茶与薄荷，做成清爽的夏日冰茶。"
  ],
  "serving_suggestion": "两只马克杯趁热喝，配一块黄油饼干或司康，就是下午茶的一整套。",
  "storage": "现泡现喝最好，冷藏不超过一天；柠檬片要取出，久泡会发苦。",
