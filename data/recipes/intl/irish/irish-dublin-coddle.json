  "steps": [
    {
      "n": 1,
      "text": "培根切条，放冷水锅里煮开焯三分钟。，手法轻些，风味才干净。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯一下，咸味才不压锅。，慢慢来别急，味道才不闷。",
      "visual_cue": "水面浮沫，培根卷曲，注意别烧干，表面才漂亮。"
    },
    {
      "n": 2,
      "text": "猪肉末加盐和黑胡椒，搓成小球。，时间掐准，吃口才舒服。",
      "time_min": 8,
      "heat": "无火",
      "tip": "球别太大，炖后才不散。，先试试温度，形状才完整。",
      "visual_cue": "肉球紧实，大小均匀，慢慢来别急，香气才不跑。"
    },
    {
      "n": 3,
      "text": "炖锅底铺洋葱丝，再放培根。，顺序照着来，口感才不散。",
      "time_min": 4,
      "heat": "无火",
      "tip": "洋葱垫底，汤才不糊。，份量心里有数，表面才漂亮。",
      "visual_cue": "层次分明，锅底铺满，时间掐准，风味才干净。"
    },
    {
      "n": 4,
      "text": "放上肉球、土豆和胡萝卜，撒蒜末。，顺序照着来，风味才干净。",
      "time_min": 5,
      "heat": "无火",
      "tip": "料别堆太满，汤才进得去。，慢慢来别急，火候才均匀。",
      "visual_cue": "食材平整，层叠稳固，起锅前尝味，口感才不散。"
    },
    {
      "n": 5,
      "text": "倒清水，水面刚好没过食材。，顺序照着来，成品才稳当。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水别太少，炖一小时会缩。，起锅前尝味，整道菜才立得住。",
      "visual_cue": "液面齐平，食材浸没，起锅前尝味，风味才干净。"
    },
    {
      "n": 6,
      "text": "大火煮开后转小火，盖盖炖四十分钟。，顺序照着来，口感才有层次。",
      "time_min": 42,
      "heat": "小火",
      "tip": "小火慢炖，味才融在一起。，别急着加油，风味才干净。",
      "visual_cue": "汤面微沸，香气上升，留意锅底，表面才漂亮。"
    },
    {
      "n": 7,
      "text": "开盖尝汤，补盐和黑胡椒。，翻动放轻，火候才均匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "培根本身咸，盐要少放。，别用力搅，口感才有层次。",
      "visual_cue": "汤色浅褐，咸淡适口，别急着加油，成品才好看。"
    },
    {
      "n": 8,
      "text": "盛碗撒小葱末，汤汁别收干，趁热配土豆吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汤汁别收干，要能蘸土豆泥。，起锅前尝味，口感才不发柴。",
      "visual_cue": "汤面浮油，葱末翠绿，下手别慌，颜色才够亮。"
    }
  ],
  "tips": [
    "培根先焯水，汤才不齁咸。，别急着加油，细节才到位。",
    "洋葱垫底，锅底才不会糊。，手法轻些，口感才有层次。",
    "小火慢炖，土豆才不散。，慢慢来别急，食材才不糊。"
  ],
  "common_mistakes": [
    "培根不焯水，汤咸得发苦。，动作放连贯，香气才不跑。",
    "火太大，土豆煮成糊。，慢慢来别急，口感才不散。",
    "水加太少，炖到一半就干。，顺序照着来，火候才均匀。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "250 克:250 克",
      "note": "咸度略低，盐可加一克。"
    },
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉",
      "ratio": "300 克:300 克",
      "note": "切块替代，炖制时间加十分钟。"
    }
  ],
  "variations": [
    "加一根芹菜，汤更清。，先试试温度，口感才不散。",
    "加一点黑啤，味道更厚。，别急着加油，火候才均匀。"
  ],
  "serving_suggestion": "汤汁别收干，蘸着土豆泥吃最香，撒黑胡椒提味。",
  "storage": "冷藏两天，复热用小火。，动作放连贯，吃口才舒服。",
