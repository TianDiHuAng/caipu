  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "土豆",
          "name_en": "potato",
          "amount": 800,
          "unit": "g",
          "note": "去皮切块",
          "optional": false
        },
        {
          "name": "卷心菜",
          "name_en": "cabbage",
          "amount": 300,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 80,
          "unit": "g",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 120,
          "unit": "ml",
          "note": "温热",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 60,
          "unit": "g",
          "note": "切细末",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 7,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 3,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "土豆压泥器",
    "小锅",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切大块，冷水下锅加盐煮二十分钟至能用叉子轻松插入。",
      "time_min": 22,
      "heat": "中火",
      "tip": "冷水下锅煮，土豆受热均匀不夹生。",
      "visual_cue": "叉子插入无阻力，边缘微裂"
    },
    {
      "n": 2,
      "text": "卷心菜切细丝，投入沸水焯三分钟至软身，捞出彻底沥干。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯好后要挤干水分，否则土豆泥会变稀。",
      "visual_cue": "菜丝软塌，颜色翠绿"
    },
    {
      "n": 3,
      "text": "小锅化开一半黄油，倒入牛奶小火加热至微温，别煮沸。",
      "time_min": 3,
      "heat": "小火",
      "tip": "牛奶温热后拌入才不会让土豆泥骤冷发硬。",
      "visual_cue": "牛奶冒热气，边缘小泡"
    },
    {
      "n": 4,
      "text": "土豆沥干放回锅中，开小火晃一分钟蒸发多余水汽。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒸发水汽能让土豆泥更绵密不水塌。",
      "visual_cue": "土豆表面干爽，锅底无积水"
    },
    {
      "n": 5,
      "text": "用压泥器把土豆压成泥，倒入温牛奶与剩余黄油拌匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "压泥器压出的口感比搅拌机细腻不粘。",
      "visual_cue": "土豆泥顺滑绵密，无颗粒"
    },
    {
      "n": 6,
      "text": "拌入卷心菜丝与小葱末，加盐与黑胡椒调匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "卷心菜和小葱拌入后别久煮，保留清香。",
      "visual_cue": "绿色点缀均匀，质地浓稠"
    },
    {
      "n": 7,
      "text": "盛盘用勺背在中央压一个小坑，放一小块黄油融化其中。",
      "time_min": 3,
      "heat": "无火",
      "tip": "中间那坑黄油是传统吃法，拌开更香。",
      "visual_cue": "中央黄油融化，冒着热气"
    }
  ],
  "tips": [
    "土豆选淀粉含量高的品种，压出的泥更绵。",
    "卷心菜一定要挤干水分，否则整盘水塌塌。",
    "拌好的土豆泥要趁热吃，凉了口感发硬。"
  ],
  "common_mistakes": [
    "土豆煮好后没蒸发水汽，土豆泥稀得能流动。",
    "牛奶煮沸后倒入，土豆泥结块还带奶腥味。",
    "卷心菜没挤干，盘底积出一汪绿汤。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "羽衣甘蓝",
      "ratio": "300 克:250 克",
      "note": "焯水时间延长一分钟，口感更有嚼劲。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "120 毫升:100 毫升",
      "note": "更浓郁，黄油可减二十克。"
    }
  ],
  "variations": [
    "加一把煎香的培根丁，是节日的豪华版本。",
    "把卷心菜换成韭菜，辛香更突出。"
  ],
  "serving_suggestion": "盛盘中央放黄油块，配炖肉或烤香肠同食。",
  "storage": "冷藏两天；复热加少许牛奶小火翻拌，避免干硬。",
  "nutrition_estimate": {
    "basis": "每份约 320 克",
