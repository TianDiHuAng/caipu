          "note": "切碎点缀",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "木勺",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅小火化开黄油，放入洋葱丁炒到透明出香味。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒透，汤底才会有自然甜味。",
      "visual_cue": "洋葱透明，锅底微微发黄"
    },
    {
      "n": 2,
      "text": "撒入面粉翻炒一分钟，让洋葱均匀裹上薄薄一层。",
      "time_min": 1,
      "heat": "小火",
      "tip": "面粉炒过，汤才不会有干粉的腥气。",
      "visual_cue": "面糊裹匀，看不到干粉"
    },
    {
      "n": 3,
      "text": "分次倒入牛奶并不断搅拌，避免结出小疙瘩。",
      "time_min": 4,
      "heat": "中火",
      "tip": "牛奶要一点点加，一次倒多容易结块。",
      "visual_cue": "液体顺滑，表面微微冒热气"
    },
    {
      "n": 4,
      "text": "加入土豆丁，转小火煮十五分钟到土豆变软。",
      "time_min": 15,
      "heat": "小火",
      "tip": "土豆煮软后会自然让汤变浓稠。",
      "visual_cue": "土豆边缘变钝，一压就碎"
    },
    {
      "n": 5,
      "text": "放入鳕鱼块，小火再煮五分钟，不要用力搅动。",
      "time_min": 5,
      "heat": "小火",
      "tip": "鱼块很嫩，搅多了会散成碎末。",
      "visual_cue": "鱼肉变白，纹理清晰分明"
    },
    {
      "n": 6,
      "text": "加盐与黑胡椒调味，尝一口再决定是否补盐。",
      "time_min": 2,
      "heat": "小火",
      "tip": "鱼本身带咸味，盐要少放慢慢试。",
      "visual_cue": "汤味鲜咸，浓稠挂勺"
    },
    {
      "n": 7,
      "text": "盛入碗中后撒上香菜碎，趁热端上桌立刻食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香草最后撒，香气才不会散掉。",
      "visual_cue": "汤面点缀翠绿碎叶"
    }
  ],
  "tips": [
    "牛奶要分次加，一次倒多很容易结块。",
    "鱼块最后下锅，煮五分钟就足够嫩。",
    "汤别用大火滚，一滚牛奶容易分层。"
  ],
  "common_mistakes": [
    "牛奶一次倒完，汤里全是小疙瘩。",
    "大火一直滚，奶汤分层变成絮状。",
    "鱼煮得太久，捞起来全是碎渣没有口感。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "龙利鱼",
      "ratio": "400 克:400 克",
      "note": "肉质更嫩，煮制时间缩短两分钟。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "400 毫升:200 毫升",
      "note": "需加两百毫升清水稀释，口感更浓。"
    }
  ],
  "variations": [
    "加一把虾仁同煮，鲜味层次更丰富立体。",
    "撒一撮烟熏辣椒粉，风味更有趣。"
  ],
  "serving_suggestion": "配一片苏打面包蘸着汤吃，暖胃又管饱。",
  "storage": "冷藏两天，复热要用小火并不断搅拌，避免分层。",
