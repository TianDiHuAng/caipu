  ],
  "difficulty": 1,
  "time": {
    "prep_min": 15,
    "cook_min": 45,
    "total_min": 60
  },
  "servings": 4,
  "flavor": [
    "savory",
    "rich",
    "light"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 500,
          "unit": "g",
          "note": "中筋或全麦混合",
          "optional": false
        },
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 350,
          "unit": "g",
          "note": "浓稠原味",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小苏打",
          "name_en": "baking soda",
          "amount": 8,
          "unit": "g",
          "note": "膨松",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
          "unit": "g",
          "note": "细盐",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "冷藏切丁",
          "optional": false
        },
        {
          "name": "燕麦",
          "name_en": "oats",
          "amount": 40,
          "unit": "g",
          "note": "表面撒用",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 60,
          "unit": "ml",
          "note": "调节稠度",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "烤盘",
    "烤箱",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱先预热到二百度，烤盘铺好烘焙纸备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "烤箱必须充分预热，否则面团发不起来。",
      "visual_cue": "烤箱内腔稳定高温"
    },
    {
      "n": 2,
      "text": "大碗里把面粉、小苏打、盐和燕麦一起混匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "小苏打要拌匀，局部过量会有肥皂味。",
      "visual_cue": "粉料均匀，无结块"
    },
    {
      "n": 3,
      "text": "加入冷藏黄油丁，用手指把粉料搓成粗砂状颗粒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油保持冷，搓出的颗粒才酥松。",
      "visual_cue": "粉料呈粗砂状，黄油碎小"
    },
    {
      "n": 4,
      "text": "倒入酸奶，用刮刀翻拌到刚成团，不要过度揉面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到没有干粉就停手，揉多了成品会硬。",
      "visual_cue": "面团粗糙成团，略带黏性"
    },
    {
      "n": 5,
      "text": "若面团太干加牛奶，太湿补一勺面粉，调整到能成团。",
      "time_min": 3,
      "heat": "无火",
      "tip": "这款面团偏软，能塑形即可。",
      "visual_cue": "面团柔软，不流散"
    },
    {
      "n": 6,
      "text": "把面团整成圆形放在烤盘上，表面撒燕麦，中央切一道深十字。",
      "time_min": 6,
      "heat": "无火",
      "tip": "十字切口要切到三分之二深，帮助中心熟透。",
      "visual_cue": "圆形面团，十字切口清晰"
    },
    {
      "n": 7,
      "text": "二百度烤四十分钟至表面深金黄、敲底部有空响。",
      "time_min": 40,
      "heat": "无火",
      "tip": "敲底部有空洞声才说明中心烤透。",
      "visual_cue": "外壳深金，敲击空心"
    },
    {
      "n": 8,
      "text": "出炉放网架晾二十分钟再切，趁温热吃最好。",
      "time_min": 20,
      "heat": "无火",
      "tip": "刚出炉就切会塌陷，晾一会结构才稳。",
      "visual_cue": "成品外壳干脆，内部密实"
    }
  ],
  "tips": [
    "苏打面包要趁新鲜吃，放久了会硬得咬不动。",
    "全麦粉最多占一半，太多会发苦发硬。",
    "用酸奶提供酸度激活小苏打，没有就用牛奶加柠檬汁。"
  ],
  "common_mistakes": [
    "反复揉面，烤出来像石头一样硬。",
    "小苏打放多，成品带着明显的肥皂苦味。",
    "十字口没切深，中心夹生而外壳已经焦了。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "牛奶加柠檬汁",
      "ratio": "350 克:350 毫升加 15 毫升柠檬汁",
      "note": "静置五分钟至微稠再用。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "30 克:25 毫升",
      "note": "口感略紧，但更适合素食。"
    }
  ],
  "variations": [
    "加一把葡萄干与一茶匙糖，做成甜味版本。",
    "全部用全麦粉加少许蜂蜜，风味更粗犷。"
  ],
  "serving_suggestion": "趁温热切片，抹黄油配浓汤，或夹烟熏三文鱼当早餐。",
  "storage": "常温密封两天、冷冻两个月；食用前复烤一百八十度八分钟恢复外壳。",
  "nutrition_estimate": {
    "basis": "每份约 180 克",
    "calories_kcal": 480,
    "protein_g": 14,
