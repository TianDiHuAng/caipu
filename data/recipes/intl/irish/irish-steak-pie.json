  "steps": [
    {
      "n": 1,
      "text": "牛腱切三厘米块，用盐和黑胡椒抓匀。，份量心里有数，咸淡才好把握。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块别太小，炖久才不散。，手法轻些，颜色才够亮。",
      "visual_cue": "块形方正，表面沾盐，时间掐准，火候才均匀。"
    },
    {
      "n": 2,
      "text": "炖锅倒植物油，大火把牛腱煎上色。，份量心里有数，口感才不散。",
      "time_min": 8,
      "heat": "大火",
      "tip": "煎出焦色，味道才厚。，别用力搅，风味才干净。",
      "visual_cue": "表面深褐，锅底有焦痕，别用力搅，成品才好看。"
    },
    {
      "n": 3,
      "text": "下洋葱和蒜末炒软，加胡萝卜翻匀。，先试试温度，吃口才舒服。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒透，汤才甜。，先试试温度，口感才不发柴。",
      "visual_cue": "洋葱透明，香气升起，料别一次下太多，形状才完整。"
    },
    {
      "n": 4,
      "text": "倒啤酒和清水，煮开后转小火。，慢慢来别急，锅气才足。",
      "time_min": 6,
      "heat": "大火",
      "tip": "啤酒先冒泡，苦味才散。，翻动放轻，整道菜才立得住。",
      "visual_cue": "液面翻滚，泡沫消退，火别太大，香气才不跑。"
    },
    {
      "n": 5,
      "text": "盖盖炖一小时，炖到牛腱变软。，时间掐准，味道才进得去。",
      "time_min": 62,
      "heat": "小火",
      "tip": "小火慢炖，肉才酥。，盖盖焖一会儿，食材才不糊。",
      "visual_cue": "肉块松软，筷子能穿，份量心里有数，火候才均匀。"
    },
    {
      "n": 6,
      "text": "开盖收汁，尝味补盐，放凉备用。，先试试温度，锅气才足。",
      "time_min": 8,
      "heat": "中火",
      "tip": "馅要稠，派才不漏。，顺序照着来，咸淡才好把握。",
      "visual_cue": "汤汁浓稠，能挂勺，保持小火，锅气才足。"
    },
    {
      "n": 7,
      "text": "面粉加黄油搓成粗砂，加冷水揉成团。，起锅前尝味，成品才稳当。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黄油要冷，派皮才酥。，顺序照着来，成品才好看。",
      "visual_cue": "面团光滑，手感凉，手法轻些，味道才进得去。"
    },
    {
      "n": 8,
      "text": "面团擀开，铺进派盘压边，留一片盖面。，时间掐准，锅气才足。",
      "time_min": 10,
      "heat": "无火",
      "tip": "边要压实，烤时才不缩。，别急着加油，颜色才够亮。",
      "visual_cue": "派皮贴合，边缘整齐，手法轻些，成品才好看。"
    },
    {
      "n": 9,
      "text": "填入牛腱馅，盖上派皮，刷蛋液划口。，汤汁别收太干，锅气才足。",
      "time_min": 8,
      "heat": "无火",
      "tip": "划两道口，蒸汽才出得来。，份量心里有数，口感才不发柴。",
      "visual_cue": "表面平整，刀口清晰，起锅前尝味，吃口才舒服。"
    },
    {
      "n": 10,
      "text": "烤箱两百度烤三十五分钟到金黄。，份量心里有数，味道才进得去。",
      "time_min": 37,
      "heat": "无火",
      "tip": "烤到表面金黄，馅才热透。，留意锅底，口感才不发柴。",
      "visual_cue": "表皮金黄，边缘起酥，动作放连贯，咸淡才好把握。"
    }
  ],
  "tips": [
    "牛腱先煎上色，味道才厚。，汤汁别收太干，口感才不散。",
    "馅要收稠，烤时才不漏。，时间掐准，表面才漂亮。",
    "派皮划口，蒸汽才出得来。，锅温要匀，细节才到位。"
  ],
  "common_mistakes": [
    "牛腱不煎直接炖，味道发淡。，动作放连贯，香气才留得住。",
    "馅太稀，烤完底皮湿软。，留意锅底，成品才好看。",
    "不划口，派皮鼓包裂开。，留意锅底，风味才干净。"
  ],
  "substitutions": [
    {
      "original": "啤酒",
