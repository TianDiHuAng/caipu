      "ratio": "400 毫升:400 毫升",
      "note": "风味变清淡，可加一勺酱油提味。"
    },
    {
      "original": "牛腱",
      "substitute": "牛腩",
      "ratio": "800 克:800 克",
      "note": "更油润，炖制时间减十分钟。"
    }
  ],
  "variations": [
    "加蘑菇片，鲜味更足。，份量心里有数，锅气才足。",
    "加一点百里香，香气更草本。，别急着加油，口感才不发柴。"
  ],
  "serving_suggestion": "切块配土豆泥和青豆。，火别太大，成品才好看。",
  "storage": "冷藏两天，复热用烤箱。，火别太大，口感才有层次。",
