  "equipment": [
    "炒锅",
    "烤盘",
    "压泥器",
    "汤锅",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切块，冷水下锅煮二十分钟到软。这一步不要着急。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅，土豆受热才均匀。，注意火候。",
      "visual_cue": "水已沸腾，块状完整，状态稳定"
    },
    {
      "n": 2,
      "text": "另起炒锅倒植物油，下洋葱和胡萝卜丁炒软。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蔬菜炒软，甜味才出得来。，注意火候。",
      "visual_cue": "洋葱透明，胡萝卜发亮"
    },
    {
      "n": 3,
      "text": "放牛肉丁转大火炒散，炒到表面变色收紧。这一步不要着急。",
      "time_min": 6,
      "heat": "大火",
      "tip": "炒散炒透，肉丁才不结团。，注意火候。",
      "visual_cue": "肉丁分散，颜色变深，状态稳定"
    },
    {
      "n": 4,
      "text": "撒面粉炒一分钟，再加番茄膏炒出红色。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "面粉炒一下，汤汁才稠得住。，注意火候。",
      "visual_cue": "面糊裹匀，颜色红亮，状态稳定"
    },
    {
      "n": 5,
      "text": "倒高汤搅匀，加盐和黑胡椒小火炖二十分钟。这一步不要着急。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火慢炖，牛肉才软而入味。，注意火候。",
      "visual_cue": "汤汁变稠，肉丁软嫩，状态稳定"
    },
    {
      "n": 6,
      "text": "拌入豌豆，把馅料铺进烤盘压平。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "豌豆最后拌，颜色才翠绿。，注意火候。",
      "visual_cue": "表面平整，豌豆分布匀"
    },
    {
      "n": 7,
      "text": "土豆压成泥，加黄油和热牛奶搅到顺滑。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "牛奶要热的，泥才不结块。，注意火候。",
      "visual_cue": "泥体顺滑，没有干块，状态稳定"
    },
    {
      "n": 8,
      "text": "土豆泥铺在馅料上抹平，用叉子划出纹路。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "划几道沟，烤完表面才脆。，注意火候。",
      "visual_cue": "纹路清晰，厚薄一致，状态稳定"
    },
    {
      "n": 9,
      "text": "两百一十度烤二十分钟到表面金黄起壳。这一步不要着急。",
      "time_min": 21,
      "heat": "-",
      "tip": "烤到边缘冒泡，香气才出来。，注意火候。",
      "visual_cue": "表面金黄，边角微焦，状态稳定"
    }
  ],
  "tips": [
    "土豆泥里加热牛奶，搅出来才顺滑。，值得留意。",
    "馅料先炖到收汁，铺泥时才不塌。，值得留意。",
    "表面划沟，烤完才有一层脆壳。，值得留意。"
  ],
  "common_mistakes": [
    "馅料汤汁太多，土豆泥全沉下去。，值得留意。",
    "土豆泥太干，烤完表面开裂。，值得留意。",
    "没烤到上色就出炉，缺一层脆壳。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "450 克:450 克",
      "note": "风味更浓，可多加百里香。"
    },
    {
      "original": "豌豆",
      "substitute": "玉米粒",
      "ratio": "80 克:80 克",
      "note": "口感更甜，颜色更亮。"
    }
  ],
  "variations": [
    "土豆泥里拌一把切达芝士，奶香更重。，值得留意。",
    "馅料加一勺辣酱油，味道更立体。，值得留意。"
  ],
  "serving_suggestion": "切开时配一份卷心菜沙拉，解腻又清爽。，效果更稳定。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤十五分钟。",
