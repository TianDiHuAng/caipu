  "steps": [
    {
      "n": 1,
      "text": "土豆削皮切成小丁，洋葱去皮切碎后放在一旁备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "土豆切小一点，煮起来才容易化开。",
      "visual_cue": "土豆丁切得大小均匀"
    },
    {
      "n": 2,
      "text": "汤锅里化开黄油，下洋葱碎小火炒到透明出香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱只炒到透明发软，别炒上色。",
      "visual_cue": "洋葱透明，质地柔软"
    },
    {
      "n": 3,
      "text": "撒入普通面粉用小火翻炒一分钟，把生粉味炒掉。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面粉一定要炒过，汤才不夹生味。",
      "visual_cue": "面粉微微发黄无生味"
    },
    {
      "n": 4,
      "text": "倒入清水和土豆丁煮开，转小火煮十五分钟至土豆软烂。",
      "time_min": 17,
      "heat": "小火",
      "tip": "水开后转小火，土豆才不会煮散。",
      "visual_cue": "土豆一压就烂成泥"
    },
    {
      "n": 5,
      "text": "放入鳕鱼块小火煮五分钟，鱼块变白后轻轻拨散。",
      "time_min": 6,
      "heat": "小火",
      "tip": "鱼块一定要后放，煮久了就散成渣。",
      "visual_cue": "鱼块雪白完整不散"
    },
    {
      "n": 6,
      "text": "倒入牛奶加热到微沸，加盐和黑胡椒调味，撒欧芹末盛出。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶不要煮滚，否则会起皮结块。",
      "visual_cue": "汤色乳白，表面浮绿末"
    }
  ],
  "tips": [
    "土豆切得越小越容易煮化，汤体自然变浓稠。",
    "面粉要先用黄油炒过，才能去掉生粉味。",
    "牛奶最后加且不要煮滚，避免起皮结块。"
  ],
  "common_mistakes": [
    "洋葱炒到焦黄再加水，汤色发暗还带苦味。",
    "鳕鱼一开始就和土豆同煮，最后全散成碎渣。",
    "牛奶大火煮开，表面结出一层厚皮。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "巴沙鱼",
      "ratio": "400 克:400 克",
      "note": "肉质更软，煮的时间缩短两分钟。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "400 毫升:200 毫升",
      "note": "更浓稠，需另加清水稀释。"
    }
  ],
  "variations": [
    "用烟熏鳕鱼替代一半鲜鱼，烟熏风味更接近原版。",
    "撒一把切碎的小葱代替欧芹，辛香更清新。"
  ],
  "serving_suggestion": "配一片抹黄油的黑面包或苏打面包，是爱尔兰东海岸冬天的家常汤。",
  "storage": "冷藏两天，复热时小火加热并不断搅拌，避免牛奶结皮。",
