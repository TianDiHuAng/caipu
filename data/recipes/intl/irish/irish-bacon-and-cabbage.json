          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 40,
          "unit": "g",
          "note": "拌土豆",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "按咸度调整",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1500,
          "unit": "ml",
          "note": "煮制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "培根整块冷水下锅，加洋葱和一千五百毫升清水，大火烧开。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅慢慢升温，肉才不会外面老里面生。",
      "visual_cue": "水面浮起灰白浮沫"
    },
    {
      "n": 2,
      "text": "撇净浮沫后转小火，盖盖煮四十分钟到筷子能轻松插入。",
      "time_min": 40,
      "heat": "小火",
      "tip": "全程小火慢煮，肉才软嫩而不发柴。",
      "visual_cue": "筷子能轻松一插即透"
    },
    {
      "n": 3,
      "text": "捞出培根稍晾，煮肉的汤留着，撇去表面浮油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "煮肉汤是这道菜的底味，别全倒掉。",
      "visual_cue": "汤色清亮，带明显咸香"
    },
    {
      "n": 4,
      "text": "土豆块放进肉汤里煮十五分钟到软，捞出沥干。",
      "time_min": 16,
      "heat": "中火",
      "tip": "土豆借肉汤煮，风味比清水足很多。",
      "visual_cue": "土豆一压就散成泥"
    },
    {
      "n": 5,
      "text": "卷心菜切大块放进肉汤煮八分钟，煮到梗部能用指甲掐断。",
      "time_min": 9,
      "heat": "中火",
      "tip": "卷心菜别煮烂，留一点脆度口感更好。",
      "visual_cue": "叶片变软，颜色转深绿"
    },
    {
      "n": 6,
      "text": "土豆趁热加黄油、盐和黑胡椒压成粗泥，留少许小块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "趁热压泥才细腻，凉了会起疙瘩。",
      "visual_cue": "薯泥顺滑带小颗粒"
    },
    {
      "n": 7,
      "text": "培根切片，和卷心菜、薯泥一起装盘，淋两勺热肉汤。",
      "time_min": 3,
      "heat": "无火",
      "tip": "淋一勺煮肉汤，整盘味道就活了。",
      "visual_cue": "盘面湿润，肉片带光泽"
    }
  ],
  "tips": [
    "整块咸肉冷水下锅慢煮，肉心才不会发硬。",
    "用煮肉汤煮土豆和卷心菜，风味更完整。",
    "薯泥要趁热压，凉了容易起小颗粒。"
  ],
  "common_mistakes": [
    "培根大火猛煮，外层散了里面还硬。",
    "卷心菜煮过头，捞起来全是烂叶。",
    "薯泥凉了才压，吃起来一粒一粒的。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "火腿整块",
      "ratio": "500 克:500 克",
      "note": "咸度更低，盐量再减一克。"
    },
    {
      "original": "卷心菜",
      "substitute": "羽衣甘蓝",
      "ratio": "600 克:500 克",
      "note": "更有嚼劲，需多煮三分钟。"
    }
  ],
  "variations": [
    "把薯泥和卷心菜拌在一起，就是爱尔兰传统吃法。",
    "配一勺黄芥末酱，咸香更突出也解腻。"
  ],
  "serving_suggestion": "培根切片铺在盘上，旁边放卷心菜和一大团薯泥，淋上热肉汤，配一杯黑啤。",
  "storage": "冷藏三天，复热时把肉和菜分开加热，薯泥加一勺牛奶调软。",
