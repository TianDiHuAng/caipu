  "equipment": [
    "厚底锅",
    "木勺",
    "刀",
    "砧板",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉切四厘米块，用厨房纸吸干表面水分。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面吸干，煎的时候才上色。，注意火候。",
      "visual_cue": "肉块干爽，形状完整，状态稳定"
    },
    {
      "n": 2,
      "text": "肉块裹一层面粉，抖去多余的粉。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄薄一层就够，太厚汤会糊。，注意火候。",
      "visual_cue": "表面均匀，粉层轻薄，状态稳定"
    },
    {
      "n": 3,
      "text": "厚底锅化开黄油，中火把羊肉煎到四面金黄。这一步不要着急。",
      "time_min": 8,
      "heat": "中火",
      "tip": "分批煎，锅里挤满就变成煮。，注意火候。",
      "visual_cue": "表面焦黄，锅底结香，状态稳定"
    },
    {
      "n": 4,
      "text": "盛出羊肉，原锅下洋葱、胡萝卜和芹菜炒软。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "用锅底的焦香炒蔬菜，底味更足。，注意火候。",
      "visual_cue": "蔬菜变软，颜色透亮，状态稳定"
    },
    {
      "n": 5,
      "text": "羊肉倒回锅里，加高汤、百里香和月桂叶。这一步不要着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "高汤要没过肉，炖的时候才不干。，注意火候。",
      "visual_cue": "液体没过，香料浮面，状态稳定"
    },
    {
      "n": 6,
      "text": "烧开后转小火盖锅炖三十五分钟。这一步不要着急。",
      "time_min": 38,
      "heat": "小火",
      "tip": "小火慢炖，肉才酥而不散。，注意火候。",
      "visual_cue": "汤面微沸，肉已变软，状态稳定"
    },
    {
      "n": 7,
      "text": "放土豆块再炖二十分钟到土豆边角发毛。这一步不要着急。",
      "time_min": 22,
      "heat": "小火",
      "tip": "土豆后放，久炖才不会化成泥。，注意火候。",
      "visual_cue": "土豆软糯，边角圆润，状态稳定"
    },
    {
      "n": 8,
      "text": "加盐和黑胡椒调味，挑出月桂叶后盛出。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐最后加，肉才不会发紧。，注意火候。",
      "visual_cue": "汤汁浓稠，香气厚实，状态稳定"
    }
  ],
  "tips": [
    "羊肉表面吸干再煎，才煎得上色。，值得留意。",
    "分两批煎肉，锅里挤满就变成煮。，值得留意。",
    "土豆后放，久炖才不会化成泥。，值得留意。"
  ],
  "common_mistakes": [
    "肉没煎上色就加水，汤色发白发淡。，值得留意。",
    "大火滚煮，羊肉又柴又硬。，值得留意。",
    "土豆早放，最后全化在汤里。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "600 克:600 克",
      "note": "炖制时间加十五分钟。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "25 克:22 毫升",
      "note": "奶香略减，风味更清爽。"
    }
  ],
  "variations": [
    "加一把青豆同炖，颜色更鲜亮。，值得留意。",
    "出锅前撒一把欧芹碎，香气更清。，值得留意。"
  ],
  "serving_suggestion": "配一片苏打面包蘸汤，是最地道的爱尔兰吃法。",
  "storage": "冷藏三天，复热加少量高汤小火炖开。，效果更稳定。",
