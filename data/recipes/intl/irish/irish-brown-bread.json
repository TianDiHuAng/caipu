  "equipment": [
    "大碗",
    "烤盘",
    "刮刀",
    "烤箱",
    "冷却架"
  ],
  "steps": [
    {
      "n": 1,
      "text": "全麦面粉、白面粉、燕麦片、小苏打和盐倒进大碗拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉类先拌匀，小苏打才不会局部发苦。",
      "visual_cue": "粉类均匀，无结块，状态稳定"
    },
    {
      "n": 2,
      "text": "中间挖个坑，倒入牛奶和白糖，用刮刀拌成湿面团。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌匀即停，揉多了口感发硬。，注意火候。",
      "visual_cue": "面团湿黏，无干粉，状态稳定"
    },
    {
      "n": 3,
      "text": "案板撒薄面，把面团整成圆形，表面划一个十字。",
      "time_min": 5,
      "heat": "无火",
      "tip": "划十字让热气透进去，中心才熟透。，注意火候。",
      "visual_cue": "表面平滑，十字纹清晰"
    },
    {
      "n": 4,
      "text": "面团移到烤盘上，表面薄薄刷一层融化的黄油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷黄油让表皮更薄脆。，注意火候。",
      "visual_cue": "表面油润，有光泽，状态稳定"
    },
    {
      "n": 5,
      "text": "两百度烤四十分钟，敲底部有空响即可出炉。这一步不要着急。",
      "time_min": 42,
      "heat": "-",
      "tip": "空响说明内部已烤透。，注意火候。",
      "visual_cue": "外壳硬挺，颜色深棕，状态稳定"
    },
    {
      "n": 6,
      "text": "放冷却架上晾二十分钟再切片，别趁热切。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "热切会压塌组织，晾凉再切才整齐。，注意火候。",
      "visual_cue": "切片平整，气孔均匀，状态稳定"
    }
  ],
  "tips": [
    "面团拌到无干粉就停，别反复揉。，值得留意。",
    "表面划十字，中心才烤得透。，值得留意。",
    "彻底晾凉再切，切面才整齐。，值得留意。"
  ],
  "common_mistakes": [
    "牛奶加太多，面团摊成一片。，值得留意。",
    "小苏打没拌匀，局部发苦发黄。，值得留意。",
    "热的时候切，面包全压扁。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "全麦面粉",
      "substitute": "黑麦面粉",
      "ratio": "300 克:300 克",
      "note": "风味更酸香，牛奶可多加二十毫升。"
    },
    {
      "original": "牛奶",
      "substitute": "水加奶粉",
      "ratio": "380 毫升:380 毫升加30 克",
      "note": "奶香略淡，口感更轻。"
    }
  ],
  "variations": [
    "加一把南瓜籽，口感更丰富。，值得留意。",
    "掺一勺蜂蜜，回甜更明显。，值得留意。"
  ],
  "serving_suggestion": "抹黄油配海鲜浓汤，或夹烟熏三文鱼都很搭。",
  "storage": "冷冻一个月，复热用烤箱一百八十度烤八分钟。",
