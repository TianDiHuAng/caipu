  ],
  "steps": [
    {
      "n": 1,
      "text": "韭菜摘掉老叶和黄尖，用清水反复冲洗根部，那里藏的泥沙最多。",
      "time_min": 10,
      "heat": "无火",
      "tip": "韭菜根部贴地长，泥沙藏在叶缝里，不掰开洗不干净。",
      "visual_cue": "韭菜翠绿挺直，根部不见泥沙"
    },
    {
      "n": 2,
      "text": "洗净的韭菜摊开晾十分钟，把表面水分控干再切段。",
      "time_min": 12,
      "heat": "无火",
      "tip": "带水的韭菜拌好以后会不断出水，味道被稀释得又淡又水。",
      "visual_cue": "叶面干爽，手摸上去不粘"
    },
    {
      "n": 3,
      "text": "韭菜切成四厘米长的段，梗和叶分开摆，梗要多拌两下才入味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "梗叶分开下，梗先拌才不至于叶子烂梗还生。",
      "visual_cue": "梗段硬挺，叶片完整不碎"
    },
    {
      "n": 4,
      "text": "大蒜压成蒜泥，小米辣切圈，芝麻下干锅小火炒到微微跳动。",
      "time_min": 5,
      "heat": "小火",
      "tip": "芝麻炒香是这碟菜的加分项，生芝麻只有渣感。",
      "visual_cue": "芝麻散出坚果香，颗粒微鼓"
    },
    {
      "n": 5,
      "text": "韭菜放进拌菜盆，先加辣椒粉和盐抓匀，让颜色和咸味挂上叶片。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先拌辣椒粉，颜色才透亮，韭菜本身水分少不易出水。",
      "visual_cue": "韭菜叶片泛红，颜色均匀"
    },
    {
      "n": 6,
      "text": "加蒜泥、鱼露和白糖翻拌，动作要轻，韭菜叶一压就塌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鱼露本身带着咸鲜，盐要少放，拌匀后尝一口再决定补多少。",
      "visual_cue": "味道咸鲜带甜，蒜香明显"
    },
    {
      "n": 7,
      "text": "淋香油、撒小米辣圈和炒香芝麻，轻轻翻两下装碟即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油封住韭菜的辛香，拌好后要马上吃，放久就塌软了。",
      "visual_cue": "韭菜油亮翠绿，小米辣圈点缀"
    }
  ],
  "tips": [
    "韭菜洗净后要晾十分钟控干水分再切，带水拌出来会出水，味道被稀释。",
    "梗和叶分开拌，梗先拌两下再放叶，这样梗入味叶子也不烂。",
    "动作要轻，从下往上翻拌。韭菜叶薄，用力搅会塌成一团，看着就没食欲。",
    "鱼露本身很咸，盐要少放，先尝一口再决定补不补。"
  ],
  "common_mistakes": [
    "韭菜洗完直接切，水淋淋地拌，成品一汪汤。要晾干再切。",
    "梗叶一起下锅拌，叶子烂了梗还生。要分开拌。",
    "用力搅拌，韭菜塌成一团。要轻轻翻拌。",
    "鱼露和盐一起放足，咸得发苦。鱼露下了盐要减半。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "蒜苗",
      "ratio": "320克:320克",
      "note": "辛香更重，拌制时间缩短，避免软塌。"
    },
    {
      "original": "鱼露",
      "substitute": "浓口酱油",
      "ratio": "12毫升:14毫升",
      "note": "咸味相近，鲜味略减，素食者可用。"
    }
  ],
  "variations": [
    "加一勺粗辣椒粉，颜色更红亮、辣味更粗犷，是韩国烤肉店的常备小菜。",
    "把韭菜换成韭菜花，拌出来更脆，适合夏天配冷面。",
    "加几丝胡萝卜同拌，颜色更热闹，口感也多一层甜脆。"
  ],
  "serving_suggestion": "一碟翠绿油亮的凉拌韭菜，入口辛香先冲上来，接着是鱼露的咸鲜和辣椒的暖，配烤肉、配豆腐汤都解腻。",
  "storage": "冷藏可放两天，拌好后两小时内吃最好；出水后倒掉汁水补几滴香油。",
