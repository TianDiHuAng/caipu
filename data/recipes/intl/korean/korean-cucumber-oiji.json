  "equipment": [
    "玻璃罐",
    "汤锅",
    "细筛",
    "干净石块"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净擦干，切去两头，整根用盐反复搓一遍，静置两小时出水。",
      "time_min": 20,
      "heat": "无火",
      "tip": "黄瓜必须擦到全干，带生水腌两天就长白膜，整罐发酸发臭。",
      "visual_cue": "黄瓜表皮发皱，盆底积一层水"
    },
    {
      "n": 2,
      "text": "清水加盐与白糖煮开搅化，关火倒米醋，放凉至完全常温。",
      "time_min": 10,
      "heat": "大火",
      "tip": "醋一定要关火后再放，和盐水一起煮酸味会挥发掉大半。",
      "visual_cue": "腌汁清亮，尝着咸中带酸"
    },
    {
      "n": 3,
      "text": "黄瓜挤掉多余水分，塞进玻璃罐，夹入蒜片与干辣椒段。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄瓜要压紧塞实，罐里空隙越少越不容易坏。",
      "visual_cue": "黄瓜竖立排紧，调料夹层"
    },
    {
      "n": 4,
      "text": "倒入凉腌汁没过黄瓜，压重物封口，冰箱冷藏腌两天。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冷藏腌才脆，室温放一天黄瓜就发软，咬着像泡烂的瓜条。",
      "visual_cue": "腌汁没过瓜身，罐口无水珠"
    },
    {
      "n": 5,
      "text": "腌够时间取出切段，淋一勺原汁，撒少量辣椒粉拌着上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "取黄瓜用干筷，沾油的筷子会把整罐带坏。",
      "visual_cue": "瓜身半透明，颜色转黄绿"
    }
  ],
  "tips": [
    "오이지 是韩国夏天配冷面和白粥的酸黄瓜，比泡菜清爽得多。",
    "腌汁可以重复用两轮，第二轮要补一点盐和醋。",
    "吃前用清水冲一下能减盐，口味淡的人别忘了这一步。"
  ],
  "common_mistakes": [
    "黄瓜没擦干就下罐，三天后表面浮一层白膜，只能整罐倒掉。",
    "腌汁趁热倒进罐，黄瓜被烫软，腌好一点不脆。",
    "盐放太少想靠时间长补咸，结果黄瓜先烂后酸，只能扔。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "红酒醋",
      "ratio": "60毫升:55毫升",
      "note": "红酒醋颜色深，腌汁会偏红。"
    },
    {
      "original": "黄瓜",
      "substitute": "西葫芦",
      "ratio": "600克:600克",
      "note": "西葫芦腌一天即可，口感更软。"
    }
  ],
  "variations": [
    "腌汁里加一勺鱼露，鲜味更足，是韩国南部的做法。",
    "腌好后切丝拌辣椒酱与芝麻，做成即食小菜。"
  ],
  "serving_suggestion": "切段装碟，配冷面、白粥或烤肉，解腻开胃。",
  "storage": "连汁冷藏可存三周，取用保持黄瓜浸在汁中不露出液面。",
