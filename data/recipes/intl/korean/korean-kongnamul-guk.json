  "steps": [
    {
      "n": 1,
      "text": "黄豆芽用清水冲洗两遍，掐掉发黑变软的豆瓣和细根。",
      "time_min": 6,
      "heat": "无火",
      "tip": "颜色发黑的豆瓣一定要掐掉，留着煮出来带苦味，整锅汤都发涩。",
      "visual_cue": "豆芽根须干净，豆瓣饱满"
    },
    {
      "n": 2,
      "text": "汤锅倒清水，冷水下豆芽，盖盖用大火煮到水开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "豆芽必须冷水下锅，热水下锅豆腥味锁在豆子里，煮不掉。",
      "visual_cue": "水面翻滚，豆芽全部浮起"
    },
    {
      "n": 3,
      "text": "开盖撇净浮沫，转中小火煮十分钟，加蒜末与生抽。",
      "time_min": 8,
      "heat": "中火",
      "tip": "全程开盖煮，盖着煮豆腥味回闷到汤里，闻着发闷。",
      "visual_cue": "豆芽变软塌，汤色清亮见底"
    },
    {
      "n": 4,
      "text": "尝咸淡补盐，撒辣椒粉与葱花，淋香油后关火。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香油最后淋，早点下锅香气全跑光，只剩一层油花。",
      "visual_cue": "葱花翠绿，汤面浮一圈油光"
    }
  ],
  "tips": [
    "豆芽汤是韩国家常餐桌上的解酒汤，宿醉早上喝一碗最舒服。",
    "想要汤更鲜可以加一把小鱼干同煮，煮完捞出。",
    "豆芽别煮太久，煮到软塌就失了脆劲。"
  ],
  "common_mistakes": [
    "豆芽热水下锅，汤里一股豆腥味，怎么加蒜都压不住。",
    "颜色发黑的豆瓣没掐就下锅，煮出的汤发苦发涩，怎么调味都盖不住。",
    "盖着锅盖一直煮，汤色发浑，味道也闷。"
  ],
  "substitutions": [
    {
      "original": "黄豆芽",
      "substitute": "绿豆芽",
      "ratio": "400克:400克",
      "note": "绿豆芽更细嫩，煮八分钟即可。"
    },
    {
      "original": "生抽",
      "substitute": "鱼露",
      "ratio": "15毫升:12毫升",
      "note": "鱼露版鲜味更重，盐量需减。"
    }
  ],
  "variations": [
    "加几片牛肉同煮，做成牛肉豆芽汤，饱腹感更强。",
    "放一勺大酱调开，汤头更厚，是韩国全罗道的吃法。"
  ],
  "serving_suggestion": "盛进石锅端上桌，配一碗白米饭和一碟泡菜。",
  "storage": "冷藏可存两天，复热时补一点清水，豆芽久放会发酸。",
