  "equipment": [
    "平底锅",
    "锅铲",
    "大碗",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐与清水调成能缓慢流动的面糊，静置十分钟让面粉吸水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面糊别太稠，摊开才薄脆。",
      "visual_cue": "面糊顺滑、能挂勺"
    },
    {
      "n": 2,
      "text": "小葱整根洗净沥干，切成长段，胡萝卜切细丝备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "葱一定沥干，带水下锅会溅油。",
      "visual_cue": "葱段干爽、无积水"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油中火烧热，葱段铺满锅底，倒入面糊摊开成圆饼。",
      "time_min": 5,
      "heat": "中火",
      "tip": "葱先铺再倒糊，饼才够葱香。",
      "visual_cue": "饼体成型、边缘微焦"
    },
    {
      "n": 4,
      "text": "面糊半凝固时铺上虾、鱿鱼与胡萝卜丝，淋上打散的鸡蛋液。",
      "time_min": 6,
      "heat": "中火",
      "tip": "料要压在糊上，翻面才不散。",
      "visual_cue": "海鲜变色、蛋液凝固"
    },
    {
      "n": 5,
      "text": "底部金黄后翻面再煎三分钟，出锅切块撒白芝麻，配生抽白醋蘸汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "翻面用大盘扣住倒扣，饼不破。",
      "visual_cue": "两面金黄、饼体酥脆"
    }
  ],
  "tips": [
    "葱要整根铺满锅底，这是海鲜葱饼区别于普通煎饼的关键。",
    "面糊调好后静置十分钟，面粉充分吸水，煎出的饼才不粘牙。",
    "翻面时用大盘扣住倒扣过去，比铲子翻更不容易破。"
  ],
  "common_mistakes": [
    "面糊调得太稠，摊不开，饼厚如发糕。",
    "葱没沥干就下锅，油花四溅还把饼泡软。",
    "火太大又不翻面，底面焦黑中间还生。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "蛤蜊肉",
      "ratio": "120g 对 120g",
      "note": "须先焯水去沙。"
    },
    {
      "original": "小葱",
      "substitute": "韭菜",
      "ratio": "150g 对 150g",
      "note": "香气更冲，切段使用。"
    }
  ],
  "variations": [
    "泡菜版：面糊里加 100g 切碎的泡菜，盐减半。",
    "厚饼版：面糊加倍，煎制时间延长至 12 分钟。"
  ],
  "serving_suggestion": "切成菱形块，配米酒或韩式烧酒。",
  "storage": "冷藏可存 1 天，复热用平底锅小火两面各煎 2 分钟。",
