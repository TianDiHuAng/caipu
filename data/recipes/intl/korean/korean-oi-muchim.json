  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净切半厘米厚片，撒盐拌匀腌十分钟。，看状态再决定下一步。",
      "time_min": 12,
      "heat": "无火",
      "tip": "杀过水，拌好才不出汤。，看状态再决定下一步。",
      "visual_cue": "瓜片出水，质地变软"
    },
    {
      "n": 2,
      "text": "腌好后用手轻挤水分，别挤太干。，看状态再决定下一步。",
      "time_min": 4,
      "heat": "无火",
      "tip": "挤太干口感发柴，留一点水才脆。，看状态再决定下一步。",
      "visual_cue": "瓜片微湿，弹性好，这一点很关键。"
    },
    {
      "n": 3,
      "text": "大碗里放辣椒粉、蒜末、白糖和鱼露调匀。，看状态再决定下一步。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先调成酱，再拌瓜片更均匀。，看状态再决定下一步。",
      "visual_cue": "酱色红亮，糖粒化开"
    },
    {
      "n": 4,
      "text": "倒入黄瓜片，用手轻轻抓拌到上色。，看状态再决定下一步。",
      "time_min": 3,
      "heat": "无火",
      "tip": "手抓比筷子拌更入味。，看状态再决定下一步。",
      "visual_cue": "瓜片均匀裹酱，这一点很关键。"
    },
    {
      "n": 5,
      "text": "淋香油，撒白芝麻和葱段拌匀即可。，看状态再决定下一步。",
      "time_min": 2,
      "heat": "无火",
      "tip": "现拌现吃，放久会出水。，看状态再决定下一步。",
      "visual_cue": "油光发亮，芝麻点缀"
    }
  ],
  "tips": [
    "黄瓜先撒盐杀水，拌好才不出一碗汤。",
    "辣椒粉选粗的，颜色红但不死辣。，这一点很关键。",
    "现拌现吃，放久了会变软出水。，这一点很关键。"
  ],
  "common_mistakes": [
    "黄瓜不杀水，装盘一汪汤。，这一点很关键。",
    "辣椒粉直接撒，拌不匀发苦。，这一点很关键。",
    "挤水挤太干，吃着像黄瓜干。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "黄瓜",
      "substitute": "西葫芦",
      "ratio": "400 克:400 克",
      "note": "先焯十秒再拌，口感更软。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "10 毫升:10 毫升",
      "note": "鲜味略减，可加少许糖。"
    }
  ],
  "variations": [
    "加一勺梨泥，酸甜更柔和。，这一点很关键。",
    "放几丝洋葱，辛香更足。，这一点很关键。"
  ],
  "serving_suggestion": "作为烤肉配菜，解腻最好。，这一点很关键。",
  "storage": "冷藏一天，隔夜后会出水，拌前倒掉汤汁。",
