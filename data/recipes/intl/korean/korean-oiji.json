      ]
    }
  ],
  "equipment": [
    "密封罐",
    "刀",
    "砧板",
    "大碗",
    "锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小黄瓜洗净擦干，切去两头，在表面划几道浅口。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面划几道浅口，盐水才渗得进黄瓜里。",
      "visual_cue": "黄瓜表面有均匀浅刀口"
    },
    {
      "n": 2,
      "text": "清水里加入盐煮开，放凉后做成腌黄瓜用的淡盐水。",
      "time_min": 8,
      "heat": "大火",
      "tip": "盐水一定要完全放凉再倒进罐子。",
      "visual_cue": "盐水清澈，摸着不烫手"
    },
    {
      "n": 3,
      "text": "黄瓜码进密封罐，倒入凉盐水没过所有黄瓜。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄瓜要完全泡在盐水里，露出水面会坏。",
      "visual_cue": "黄瓜全浸没，罐口留空隙"
    },
    {
      "n": 4,
      "text": "密封后放在阴凉处腌五天，每天开盖放一次气。",
      "time_min": 10,
      "heat": "无火",
      "tip": "每天开盖放一次气，罐子才不会胀裂。",
      "visual_cue": "罐口有气泡冒出，有轻微酸味"
    },
    {
      "n": 5,
      "text": "糯米粉加少量清水调匀，小火煮成黏稠的糯米糊放凉。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糯米糊要煮到挂勺，才能裹住黄瓜。",
      "visual_cue": "糯米糊半透明，能挂住勺"
    },
    {
      "n": 6,
      "text": "腌好的黄瓜捞出切段，拌入辣椒粉、大蒜末、白糖和鱼露。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄瓜先尝一下咸度，太咸可用清水冲一冲。",
      "visual_cue": "黄瓜段泛红，裹着酱料"
    },
    {
      "n": 7,
      "text": "拌入放凉的糯米糊抓匀，装罐冷藏两天即可食用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冷藏两天味道才融合，之后可放一周。",
      "visual_cue": "黄瓜裹糊均匀，颜色红亮"
    }
  ],
  "tips": [
    "盐水必须完全放凉再倒进罐子，否则黄瓜会软。",
    "腌渍期间每天开盖放气，防止罐内胀气。",
    "糯米糊要煮到挂勺，才裹得住黄瓜。"
  ],
  "common_mistakes": [
    "盐水没放凉就倒进罐子，黄瓜腌出来发软。",
    "黄瓜没被盐水完全浸没，露出的部分发霉。",
    "糯米糊太稀，裹不住黄瓜也不易发酵。"
  ],
  "substitutions": [
    {
      "original": "小黄瓜",
      "substitute": "普通黄瓜",
      "ratio": "800 克:800 克",
      "note": "切长段，腌渍时间减一天。"
    },
    {
      "original": "鱼露",
      "substitute": "虾酱",
      "ratio": "15 毫升:10 克",
      "note": "咸味更重，盐量要减。"
    }
  ],
  "variations": [
    "加一点韭菜段一起同拌，香气会更足。",
    "喜欢更辣可加两勺辣椒粉再拌一次。"
  ],
  "serving_suggestion": "切小段当小菜，配白饭、烤肉或者冷面都很合适。",
  "storage": "冷藏可存两周，取用时用干净无水的筷子夹取。",
