          "note": "稀释醋液",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 3,
          "unit": "g",
          "note": "整粒更香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "消毒玻璃罐",
    "小锅",
    "滤网",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玻璃罐用开水烫过后倒扣晾干，确保内部完全没有水汽。",
      "time_min": 10,
      "heat": "无火",
      "tip": "罐子带生水最容易坏，烫过后一定要晾到全干。",
      "visual_cue": "瓶壁干透，内壁不挂水珠"
    },
    {
      "n": 2,
      "text": "洋葱剥去外层干皮，切成四瓣或者一厘米厚的圆片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚切口感更脆，切得太薄腌完会彻底软掉。",
      "visual_cue": "洋葱块大小均匀，层次分明不散"
    },
    {
      "n": 3,
      "text": "锅里加米醋、生抽、清水、白糖与盐，小火加热到糖完全融化。",
      "time_min": 6,
      "heat": "小火",
      "tip": "只加热到糖化就关火，煮开会让醋味变冲。",
      "visual_cue": "液体清亮不浑浊，底部没有糖粒"
    },
    {
      "n": 4,
      "text": "热醋液离火放凉到常温，加入黑胡椒粒静置十分钟出味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "一定要放凉再倒，热液会把洋葱烫软烫白。",
      "visual_cue": "液面浮着黑胡椒粒，闻到酸甜醋香"
    },
    {
      "n": 5,
      "text": "洋葱与白萝卜片交替装进罐子，尽量塞紧减少空隙。",
      "time_min": 5,
      "heat": "无火",
      "tip": "塞紧能减少气泡，腌出来的味道更均匀。",
      "visual_cue": "罐内装到八分满，层次交替清晰"
    },
    {
      "n": 6,
      "text": "倒入放凉的腌汁，汁水要完全没过洋葱，盖紧冷藏腌制一天。",
      "time_min": 120,
      "heat": "无火",
      "tip": "汁水没过食材才不会长霉，冷藏一天就能吃。",
      "visual_cue": "液面高于洋葱，罐底无大片气泡"
    },
    {
      "n": 7,
      "text": "腌好后夹出小碟，淋一点腌汁撒葱花即可当小菜上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "取用时用干净筷子，剩下的可以放很久。",
      "visual_cue": "洋葱透亮微粉，入口脆爽酸甜"
    }
  ],
  "tips": [
    "用紫洋葱腌出来颜色最漂亮，汁水会变成粉红色。",
    "加一片香叶或几粒花椒，香气层次更足。",
    "腌汁别浪费，拌黄瓜或做沙拉酱都很好用。",
    "冷藏三天后风味最佳，洋葱的辛辣会变得柔和。"
  ],
  "common_mistakes": [
    "罐子没彻底晾干就装，腌汁几天就发浑。",
    "热醋液直接倒进罐子，洋葱被烫得软塌发苦。",
    "醋和糖比例失衡，成品酸得没法入口。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "苹果醋",
      "ratio": "200毫升:200毫升",
      "note": "酸味更柔，颜色略深。"
    },
    {
      "original": "生抽",
      "substitute": "盐",
      "ratio": "50毫升:8克",
      "note": "颜色更浅，咸味更直接。"
    }
  ],
  "variations": [
    "加几片黄瓜同腌，做成腌黄瓜洋葱拼盘。",
    "加一点蜂蜜代替部分白糖，酸味更圆润。"
  ],
  "serving_suggestion": "夹一小碟配烤肉或炸鸡，酸甜解腻，也可以配白饭直接吃。",
  "storage": "冷藏可放一个月，取用须用干净无水的筷子。",
