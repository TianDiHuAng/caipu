        }
      ]
    }
  ],
  "equipment": [
    "深锅",
    "厨房温度计",
    "漏勺",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡翅根用叉子在肉厚处扎孔，倒入牛奶并加 1g 盐浸泡 20 分钟去腥。",
      "time_min": 20,
      "heat": "无火",
      "tip": "扎孔能让奶液渗进肉里，腥味更淡。",
      "visual_cue": "肉质松软、表面乳白"
    },
    {
      "n": 2,
      "text": "捞出鸡翅根沥干，加 2g 盐与 10g 蒜末抓匀，静置腌 10 分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌够时间底味才进得去。",
      "visual_cue": "表面发黏、蒜香明显"
    },
    {
      "n": 3,
      "text": "玉米淀粉倒入盘中，鸡翅根逐个滚一圈并用手压实，抖掉多余干粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压粉让粉层贴紧，炸后不脱壳。",
      "visual_cue": "粉层均匀、无干粉结块"
    },
    {
      "n": 4,
      "text": "深锅倒 250ml 植物油烧至 160℃，下鸡翅根中火炸 6 分钟捞出控油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "第一遍低温炸熟，油温别超 165℃。",
      "visual_cue": "外壳浅金黄、肉已断生"
    },
    {
      "n": 5,
      "text": "把植物油升温至 180℃，鸡翅根复炸 2 分钟至外壳金黄酥脆，捞出控油。",
      "time_min": 4,
      "heat": "大火",
      "tip": "复炸时间短，只为脆壳不回软。",
      "visual_cue": "外壳金红、敲击声清脆"
    },
    {
      "n": 6,
      "text": "另起炒锅小火炒香剩余蒜末，加入韩式辣酱、蜂蜜与生抽搅匀成酱汁。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酱料小火慢搅，蜂蜜易焦。",
      "visual_cue": "酱汁浓稠发亮、冒小泡"
    },
    {
      "n": 7,
      "text": "倒入炸好的鸡翅根中火快速翻裹酱汁，撒熟白芝麻出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "翻裹要快，久炒外壳会软。",
      "visual_cue": "每块均匀裹酱、芝麻点缀"
    }
  ],
  "tips": [
    "两次油炸是脆壳的关键，中间要让鸡翅根控油。",
    "牛奶浸泡能让鸡肉更嫩，还能带走冷冻腥味。",
    "裹酱动作要快，出锅趁热吃才能保留脆壳。"
  ],
  "common_mistakes": [
    "一次高温炸到底，外壳焦黑而里面还是生的。",
    "裹粉没有压实，下锅后粉壳脱落、油变浑浊。",
    "酱汁大火收得太久，蜂蜜焦化后带一股苦味。"
  ],
  "substitutions": [
    {
      "original": "韩式辣酱",
      "substitute": "番茄酱加辣椒粉",
      "ratio": "50g 对 40g 加 5g",
      "note": "辣度自调，甜味略高。"
    },
    {
      "original": "鸡翅根",
      "substitute": "鸡腿肉",
      "ratio": "700g 对 700g",
      "note": "切块后炸制时间减 1 分钟。"
    }
  ],
  "variations": [
    "原味版：不裹酱，撒椒盐与芝麻。",
    "芝士版：出锅撒 30g 芝士粉，风味更浓。"
  ],
  "serving_suggestion": "配腌萝卜块与冰啤酒，趁热吃外壳最脆。",
  "storage": "冷藏 1 天，复热用 180℃ 烤箱烤 6 分钟回脆。",
