          "note": "提咸鲜",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "腌与泡各半",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
