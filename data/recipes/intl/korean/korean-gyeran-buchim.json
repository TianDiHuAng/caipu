  ],
  "steps": [
    {
      "n": 1,
      "text": "胡萝卜削皮切成细丝，洋葱也切成同样粗细的丝，丝越细越容易煎熟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丝切粗了会夹生，煎的时候蛋熟了菜还硬。",
      "visual_cue": "胡萝卜丝橙红细匀，洋葱丝透明"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进盆里，加盐和黑胡椒，用筷子顺一个方向打散到蛋液均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "只打散不打发，打进太多空气，煎出来会鼓包塌陷。",
      "visual_cue": "蛋液颜色一致，无絮状蛋白"
    },
    {
      "n": 3,
      "text": "把面粉筛进蛋液里搅匀到没有干粉块，再加两勺清水调稀一些。",
      "time_min": 3,
      "heat": "无火",
      "tip": "加一点面粉让蛋饼不容易破，但多了就成了面糊。",
      "visual_cue": "蛋液微稠，能缓缓流动成线"
    },
    {
      "n": 4,
      "text": "胡萝卜丝、洋葱丝和葱花拌进蛋液，静置三分钟让蔬菜稍微出水融合。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置几分钟蔬菜的水分融进蛋液，煎出来更嫩不散。",
      "visual_cue": "蔬菜丝均匀裹上蛋液，颜色分明"
    },
    {
      "n": 5,
      "text": "平底锅烧热倒植物油晃匀，转中小火倒入蛋液，用铲子摊平成圆饼。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "中小火是煎蛋饼的铁律，大火底下焦了上面还是生的。",
      "visual_cue": "蛋液铺平，边缘开始凝固"
    },
    {
      "n": 6,
      "text": "盖锅盖焖三分钟，让表面的蛋液和蔬菜丝靠蒸汽凝固定型。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "盖盖能让表面熟透又不上火，蛋饼底部还保持金黄。",
      "visual_cue": "表面凝固，轻晃锅饼整体滑动"
    },
    {
      "n": 7,
      "text": "揭盖沿锅边淋香油，用铲子托底翻面，再煎两分钟到两面金黄。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "翻面要用铲子托底整块翻，直接硬铲必定破成两半。",
      "visual_cue": "两面金黄，边缘微微酥脆"
    },
    {
      "n": 8,
      "text": "出锅放在案板上切成八块，趁热装盘，配白饭或当小菜都行。",
      "time_min": 3,
      "heat": "无火",
      "tip": "切的时候用推拉刀法，压着切会把蛋饼压散。",
      "visual_cue": "切块整齐，断面嫩黄夹着蔬菜"
    }
  ],
  "tips": [
    "蔬菜丝一定要切细，胡萝卜和洋葱的粗细要一致。丝粗了蛋熟了菜还生，咬着发硬。",
    "蛋液里加一小勺面粉是为了增加黏合力，煎的时候不容易破。但别加多，多了就成了面糊饼。",
    "全程中小火，倒入蛋液后盖锅盖焖三分钟。大火煎出来的蛋饼底焦面生，还容易发黑发苦。",
    "翻面要用铲子从边缘托底整块翻，或者扣一个盘子辅助。硬铲必定破成两半。"
  ],
  "common_mistakes": [
    "蔬菜丝切得粗，蛋饼煎好咬着夹生。要切细丝并保持粗细一致。",
    "大火煎蛋饼，底下焦黑上面还是液体。全程中小火。",
    "面粉加太多，成品发硬像面饼。一小勺就够，只为增稠。",
    "下锅后不敢翻面，一面焦一面生。盖盖焖定型后用铲托底翻。"
  ],
  "substitutions": [
    {
      "original": "胡萝卜",
      "substitute": "西葫芦",
      "ratio": "60克:70克",
      "note": "需先撒盐杀水挤干，否则出水影响成型。"
    },
    {
      "original": "面粉",
      "substitute": "糯米粉",
      "ratio": "15克:15克",
      "note": "口感更软糯，黏性略强，需多加十毫升清水。"
    }
  ],
  "variations": [
    "加一点泡菜碎同煎，酸辣味和蛋香特别搭，是韩国居酒屋常见的下酒菜。",
    "把蔬菜换成韭菜段，做成韭菜蛋饼，辛香更突出。",
    "煎成小圆饼而不是大饼，一块一口，更适合当便当菜。"
  ],
  "serving_suggestion": "蛋饼切成方块叠在盘里，金黄的外皮裹着橙红的胡萝卜和半透明洋葱，咬下去蛋香浓、蔬菜还带着脆。",
  "storage": "冷藏可放一天，复热用平底锅干烙一分钟；微波会出水变软，不建议。",
