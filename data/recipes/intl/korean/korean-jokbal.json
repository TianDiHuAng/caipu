  "equipment": [
    "汤锅",
    "料包袋",
    "镊子",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪蹄用镊子拔净残毛，冷水浸泡一小时，中途换水三次把血水泡出来。",
      "time_min": 60,
      "heat": "无火",
      "tip": "残毛用火燎一下再刮，比反复拔快得多。",
      "visual_cue": "外皮泛白，泡水后水面无血色。"
    },
    {
      "n": 2,
      "text": "猪蹄冷水下锅，加料酒与姜片，大火煮开撇净浮沫后捞出用温水冲净。",
      "time_min": 15,
      "heat": "大火",
      "tip": "飞水用冷水下锅，血沫才逼得干净。",
      "visual_cue": "浮沫结块浮起，外皮收紧发亮。"
    },
    {
      "n": 3,
      "text": "汤锅铺大葱段、洋葱块、蒜瓣与姜片，放猪蹄，倒生抽、老抽、白糖和清水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "锅底垫葱姜，外皮不贴锅，炖完不易破。",
      "visual_cue": "液体没过猪蹄两指，酱色均匀。"
    },
    {
      "n": 4,
      "text": "八角、桂皮、香叶和干辣椒装进料包投锅，大火烧开转小火炖一小时。",
      "time_min": 62,
      "heat": "小火",
      "tip": "香料装包才好捞，散着煮久了会发苦。",
      "visual_cue": "汤面小泡微滚，香料味漫出锅沿。"
    },
    {
      "n": 5,
      "text": "炖到外皮起胶、筷子能扎透时加盐和梨泥，再小火焖二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "盐后放肉才不柴，梨泥让胶质更软糯。",
      "visual_cue": "外皮轻按即凹，汤汁变得黏稠。"
    },
    {
      "n": 6,
      "text": "开中火收汁到酱色油亮，淋蜂蜜翻匀，放凉后切块撒黑胡椒与大葱丝。",
      "time_min": 10,
      "heat": "中火",
      "tip": "收汁时勤翻动，胶质容易糊底。",
      "visual_cue": "每块猪蹄挂满亮汁，色如琥珀。"
    }
  ],
  "tips": [
    "猪蹄选前蹄，筋多肉厚，炖后更弹牙。",
    "炖好别急着捞，关火焖半小时胶质会更透。",
    "收汁到锅底只剩薄薄一层就够，汁多反而稀薄。"
  ],
  "common_mistakes": [
    "猪蹄没泡透血水，炖出来汤浑带腥。",
    "全程大火炖，猪皮开裂、肉散脱骨。",
    "收汁过头，糖分焦化发苦，颜色发黑。"
  ],
  "substitutions": [
    {
      "original": "猪蹄",
      "substitute": "猪肘",
      "ratio": "1:1",
      "note": "肘子肉多，炖的时间缩短二十分钟，切块更方整。"
    },
    {
      "original": "梨",
      "substitute": "苹果",
      "ratio": "1:1",
      "note": "苹果泥甜度略低，白糖可多加五克。"
    }
  ],
  "variations": [
    "首尔奖忠洞一带的做法偏清淡，酱油减半，靠长时间炖出原胶香。",
    "有的店家在收汁前加一勺辣椒粉，做成微辣的酱猪蹄，配冷面吃很搭。"
  ],
  "serving_suggestion": "趁温热切块装盘，配辣酱、蒜片和泡菜，冷吃当冷盘也很受欢迎。",
  "storage": "连汁冷藏可存三日，冷冻两周；复热连汁小火加热，别用大火收干。",
