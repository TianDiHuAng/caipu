  "equipment": [
    "汤锅",
    "保鲜盒",
    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋从冰箱取出先放半小时回温，煮的时候才不容易从中间裂开流白。",
      "time_min": 30,
      "heat": "无火",
      "tip": "来不及回温就在蛋壳气室端扎一个小孔，同样防裂。",
      "visual_cue": "蛋壳表面无凝露，握起来不冰手"
    },
    {
      "n": 2,
      "text": "汤锅加清水与盐，鸡蛋冷水下锅，中火煮开后再煮八分钟，煮到全熟。",
      "time_min": 11,
      "heat": "中火",
      "tip": "水里加盐能让漏出的蛋白迅速凝固，减少损失。",
      "visual_cue": "水面保持微滚，蛋在锅里轻转"
    },
    {
      "n": 3,
      "text": "捞出鸡蛋立刻放进凉水里浸三分钟，边浸边轻轻磕裂蛋壳，剥出完整蛋身。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过凉水后蛋膜收缩，壳一磕就滑下来，不易带肉。",
      "visual_cue": "蛋身光洁无破损，摸起来微温"
    },
    {
      "n": 4,
      "text": "小锅里放生抽、老抽、白糖与清水煮开，加蒜、青辣椒与干辣椒转小火煮三分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "卤汁要先煮出香再放蛋，辣椒久煮会发苦，三分钟足够。",
      "visual_cue": "卤汁深褐透亮，闻到蒜辣香"
    },
    {
      "n": 5,
      "text": "把剥好的鸡蛋放进卤汁，小火保持微滚煮五分钟，中途用勺轻推让颜色均匀。",
      "time_min": 5,
      "heat": "小火",
      "tip": "火大滚沸会把蛋煮出蜂窝孔，口感变硬。",
      "visual_cue": "蛋身染上均匀酱色，表面光润"
    },
    {
      "n": 6,
      "text": "连汁倒进保鲜盒，放凉后冷藏浸渍一夜，让咸味与酱香渗进蛋黄外层。",
      "time_min": 480,
      "heat": "无火",
      "tip": "至少浸六小时，两天内风味最平衡，久了会过咸。",
      "visual_cue": "卤汁没过蛋身，蛋面颜色深亮"
    },
    {
      "n": 7,
      "text": "吃前取出鸡蛋对半切开，淋少许卤汁与香油，撒上焙香的芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "切蛋用沾水的刀，切面整齐不粘蛋黄。",
      "visual_cue": "切面蛋黄橙黄，酱色渗入半厘米"
    }
  ],
  "tips": [
    "卤汁咸度按生抽品牌差别很大，先尝一口，比平时喝汤咸两倍正好。",
    "同一锅卤汁可以再卤一次鹌鹑蛋或豆腐，用完即弃不要反复久存。",
    "冷藏浸渍时把蛋翻一次面，上下颜色和咸度更一致。",
    "想让蛋黄也入味，可用牙签在蛋身扎几个浅孔再浸。"
  ],
  "common_mistakes": [
    "鸡蛋直接从冰箱下锅又大火猛煮，壳裂蛋白流出，锅里一片白絮。",
    "卤汁没过蛋就冷藏，露在空气中的部分发干变色。",
    "浸渍超过一周还继续吃，卤汁变味，蛋也发酸。"
  ],
  "substitutions": [
    {
      "original": "生抽",
      "substitute": "酱油",
      "ratio": "120毫升:120毫升",
      "note": "咸度略高，白糖加到三十克平衡。"
    },
    {
      "original": "干辣椒",
      "substitute": "辣椒粉",
      "ratio": "5克:3克",
      "note": "直接放进卤汁，辣味更散但少了香气层次。"
    }
  ],
  "variations": [
    "加两片海带同卤，鲜味更足，卤汁也带上昆布香。",
    "换成溏心做法，煮蛋时间缩到六分半，浸渍后蛋黄半流。"
  ],
  "serving_suggestion": "对半切开摆盘，配一碗白饭与海苔碎，当作便当配菜也方便携带。",
  "storage": "连卤汁冷藏可放五天，取用时用干净筷子夹，卤汁可续用一次；去壳蛋冷冻会变硬，不建议冷冻。",
