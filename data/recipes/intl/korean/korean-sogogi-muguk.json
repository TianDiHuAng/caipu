  "equipment": [
    "汤锅",
    "木勺",
    "砧板",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆着纹理切成薄片，泡在清水里十分钟逼出血水，捞出沥干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纹切才咬得动，顺纹切的牛肉煮完像嚼筋，越嚼越硬。",
      "visual_cue": "肉片薄而均匀，水色转淡"
    },
    {
      "n": 2,
      "text": "白萝卜削皮切成两厘米见方的薄块，洋葱切块，大葱斜切成段。",
      "time_min": 5,
      "heat": "无火",
      "tip": "萝卜切薄块比滚刀块好，二十分钟就能煮透入味，汤也清。",
      "visual_cue": "萝卜块大小一致，切口平整"
    },
    {
      "n": 3,
      "text": "汤锅烧热淋香油，下牛肉片与蒜末大火快炒至肉色转白。",
      "time_min": 6,
      "heat": "大火",
      "tip": "牛肉先炒再煮，汤才带焦香；直接冷水下锅，汤会发浑带腥。",
      "visual_cue": "肉片全白，锅底留一层肉汁"
    },
    {
      "n": 4,
      "text": "倒入清水煮开撇净浮沫，加萝卜、洋葱与生抽，转小火煮二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "浮沫一定要撇干净，撇不净汤会浑，凉了表面还结一层灰膜。",
      "visual_cue": "汤色清亮，萝卜半透明"
    },
    {
      "n": 5,
      "text": "尝咸淡补盐，撒白胡椒与大葱段，滚一分钟关火盛出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "盐最后放，早放盐牛肉收紧，煮多久都是柴的。",
      "visual_cue": "葱段翠绿挺立，汤面清透不浑"
    }
  ],
  "tips": [
    "牛肉萝卜汤是韩国家常餐桌上最常见的汤，清甜不辣，配米饭最稳。",
    "萝卜挑沉的、捏着硬的，切面有水光，煮出来才甜。",
    "汤放一夜更甜，第二天配面条煮成汤面也很好吃。"
  ],
  "common_mistakes": [
    "牛肉顺纹切薄片，煮完卷成硬条，咬着费劲。",
    "萝卜和牛肉同时下锅大火滚，萝卜煮烂成渣，汤也浑了。",
    "香油放太多，汤面浮一层厚油，喝两口就腻。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛筋",
      "ratio": "300克:300克",
      "note": "牛筋需多炖四十分钟至软糯。"
    },
    {
      "original": "白萝卜",
      "substitute": "西葫芦",
      "ratio": "400克:400克",
      "note": "西葫芦版煮十分钟即可，汤更清。"
    }
  ],
  "variations": [
    "加一把粉丝同煮，做成牛肉萝卜粉丝汤，饱腹感更强。",
    "放两片海带同煮，汤头多一层海味，是济州岛做法。"
  ],
  "serving_suggestion": "盛进石锅或厚陶碗，配一碗米饭和一碟泡菜，就是标准的韩式一餐。",
  "storage": "冷藏可存两天，萝卜久泡会发酸，复热时加少量清水。",
