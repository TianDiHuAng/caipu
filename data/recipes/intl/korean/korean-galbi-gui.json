  "steps": [
    {
      "n": 1,
      "text": "牛排骨沿骨缝切成一指厚的片，冷水浸泡四十分钟，中途换水两次去血水。",
      "time_min": 40,
      "heat": "无火",
      "tip": "泡够时间血水才出得净，烤时不会起黑沫。",
      "visual_cue": "盆里的水由红转清，骨面发白。"
    },
    {
      "n": 2,
      "text": "梨与洋葱分别磨成泥，加生抽、白糖、料酒、黑胡椒、蒜末和香油调成腌汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腌汁先加清水调稀，太浓会盖住肉的本味。",
      "visual_cue": "腌汁呈深褐色，能闻到果香与酱香。"
    },
    {
      "n": 3,
      "text": "排骨放进腌汁里抓匀，冷藏腌三小时，中途翻面一次让味道进透。",
      "time_min": 180,
      "heat": "无火",
      "tip": "腌足三小时才进骨缝，赶时间也别少于两小时。",
      "visual_cue": "肉色转深褐，汁液被吸收过半。"
    },
    {
      "n": 4,
      "text": "烤箱预热到二百二十度，排骨摆上烤架，刷一层蜂蜜腌汁送入中层。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "烤架下垫烤盘接汁，清理省事也不冒烟。",
      "visual_cue": "炉内温度到位，排骨表面油亮挂汁。"
    },
    {
      "n": 5,
      "text": "烤十二分钟后翻面再刷一次蜂蜜腌汁，继续烤八分钟至表面焦亮。",
      "time_min": 20,
      "heat": "中大火",
      "tip": "蜂蜜最后刷，早刷糖分焦化会发黑。",
      "visual_cue": "肉边卷起焦褐色，骨端微微露白。"
    },
    {
      "n": 6,
      "text": "出炉撒芝麻和大葱丝，静置五分钟后顺骨缝切成段装盘。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置这几分钟让肉汁回流，切开不流一盘汤。",
      "visual_cue": "切面湿润不流血水，香气直冲。"
    }
  ],
  "tips": [
    "牛排骨选肉厚带筋的小排，烤后筋络软糯，比纯瘦肉更香。",
    "腌汁留两勺单独装碗，烤好淋在肉上，味道更集中。",
    "家用烤箱温度虚高，看到边缘焦黑就先盖一层锡纸。"
  ],
  "common_mistakes": [
    "腌汁里糖放太多又腌过夜，肉表面发黏，烤出来发苦。",
    "排骨没吸干水分就上烤架，炉内水汽重，烤成焖肉。",
    "出炉立刻切块，肉汁全流在案板上，口感变干。"
  ],
  "substitutions": [
    {
      "original": "牛排骨",
      "substitute": "牛里脊",
      "ratio": "1:1",
      "note": "里脊无骨易熟，腌一小时即可，烤制时间减半。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "1:1.2",
      "note": "白糖挂汁弱些，需多刷一次才够亮。"
    }
  ],
  "variations": [
    "首尔店家会把排骨切得更薄，用炭火快烤，焦香更重、肉质更嫩。",
    "家庭版常加半勺芝麻粉进腌汁，坚果香浓，配生菜包食很搭。"
  ],
  "serving_suggestion": "趁热配生菜、蒜片和泡菜包食，也可直接盖在白饭上做排骨盖饭。",
  "storage": "冷藏可存两日，复热用烤箱一百八十度烤六分钟，别用微波炉回软。",
