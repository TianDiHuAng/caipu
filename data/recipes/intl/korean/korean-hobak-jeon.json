  "equipment": [
    "平底锅",
    "锅铲",
    "厨房纸",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西葫芦洗净切成半厘米厚的圆片，两面薄薄撒盐静置出水。",
      "time_min": 7,
      "heat": "无火",
      "tip": "瓜片别切太薄，煎完会缩水变软塌没有口感。",
      "visual_cue": "瓜片厚薄一致，切面渗出细水珠"
    },
    {
      "n": 2,
      "text": "用厨房纸把瓜片表面的水分彻底吸干，两面拍上薄薄一层面粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拍完抖掉多余干粉，粉太厚煎出来发糊。",
      "visual_cue": "瓜片表面只留一层薄白粉"
    },
    {
      "n": 3,
      "text": "鸡蛋打散加少许盐搅匀，把拍过粉的瓜片逐片蘸满蛋液。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液里别加水，浓一点才挂得住瓜片。",
      "visual_cue": "蛋液均匀包裹，边缘不见干粉"
    },
    {
      "n": 4,
      "text": "平底锅倒植物油烧到五成热，中小火把瓜片两面煎到金黄。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "一锅只放五六片，留出翻面的空隙才不会粘。",
      "visual_cue": "两面金黄结壳，边缘微微鼓起"
    },
    {
      "n": 5,
      "text": "出锅放厨房纸上吸油，撒胡萝卜末、葱白碎与熟白芝麻，最后淋香油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "吸油这步别省，否则一盘饼端起来全是油。",
      "visual_cue": "表面油光收敛，配料颜色分明"
    }
  ],
  "tips": [
    "西葫芦杀水一定要彻底，否则煎的时候出水，饼会散开。",
    "面粉只拍薄薄一层，多了会盖住瓜的清甜。",
    "蘸酱用生抽、香油和熟白芝麻调一个简单的酱油碟就很好吃。"
  ],
  "common_mistakes": [
    "瓜片没杀水也没吸干，下锅立刻出汤，蛋皮脱开成碎片。",
    "油温不够就下锅，蛋液全被瓜片吸进去，煎完又软又腻。",
    "一次下满整锅，翻面时全部粘在一起，最后变成一坨。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "茄子",
      "ratio": "400克:400克",
      "note": "茄子更吸油，油量加到五十五毫升。"
    },
    {
      "original": "面粉",
      "substitute": "糯米粉",
      "ratio": "80克:80克",
      "note": "糯米粉煎完更脆，凉了会回软。"
    }
  ],
  "variations": [
    "蛋液里拌入切碎的泡菜，酸辣味更足，接近泡菜煎饼的吃法。",
    "在瓜片上铺一片薄牛肉再煎，就是韩国节日桌上的豪华版本。"
  ],
  "serving_suggestion": "趁热装盘，配一小碟酱油蘸汁，当作前菜或下酒小菜都合适。",
  "storage": "冷藏可存一天，回锅用平底锅小火两面各烘一分钟，不要用微波炉。",
