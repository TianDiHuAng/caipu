    }
  ],
  "equipment": [
    "大锅",
    "料理机",
    "陶罐",
    "纱布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄豆洗净后加三倍清水浸泡 8 小时，泡至豆粒用手一捏就碎。",
      "time_min": 485,
      "heat": "无火",
      "tip": "夏天放冰箱泡,避免发酸。",
      "visual_cue": "豆粒膨大、一捏即碎"
    },
    {
      "n": 2,
      "text": "黄豆连水入锅大火煮开，转中小火煮 40 分钟至豆子软烂。",
      "time_min": 45,
      "heat": "中小火",
      "tip": "煮到能轻松压成泥才算够。",
      "visual_cue": "豆粒开花、汤汁浑浊"
    },
    {
      "n": 3,
      "text": "煮好的黄豆沥干，用料理机打成粗泥，保留少许颗粒感。",
      "time_min": 10,
      "heat": "无火",
      "tip": "打成细泥口感会发死。",
      "visual_cue": "豆泥粗粝、能挂住勺子"
    },
    {
      "n": 4,
      "text": "糯米粉 100g 加 200ml 清水调匀，小火煮成半透明糊状，与豆泥拌匀。",
      "time_min": 12,
      "heat": "小火",
      "tip": "糯米糊是酱体粘稠的关键。",
      "visual_cue": "糊体半透明、拉起来挂丝"
    },
    {
      "n": 5,
      "text": "拌入 120g 辣椒粉、60g 盐与 60g 白糖，全程用干净木勺搅匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐量足才不会坏,别随意减。",
      "visual_cue": "酱呈深红色、质地稠厚"
    },
    {
      "n": 6,
      "text": "装入消毒陶罐至八分满，表面撒一层盐封口，室温初发酵 12 小时后移入冰箱继续熟成 30 天。",
      "time_min": 715,
      "heat": "无火",
      "tip": "每天开盖放气一次，避免罐内气压过高胀罐。",
      "visual_cue": "表面析出红油、香气醇厚"
    }
  ],
  "tips": [
    "所有器具必须无水无油，否则整罐发霉。",
    "盐量不能减，它是防腐核心，减了很快坏。",
    "发酵期间每天放气，避免罐内气压过高。"
  ],
  "common_mistakes": [
    "容器带生水，几天就长出白毛，整罐报废。",
    "豆泥打得太细，成品口感像果泥。",
    "盐放太少，发酵中途变酸，只能倒掉。"
  ],
  "substitutions": [
    {
      "original": "糯米粉",
      "substitute": "大米粉",
      "ratio": "100g 对 100g",
      "note": "黏度略低，需多加 20ml 水。"
    },
    {
      "original": "辣椒粉",
      "substitute": "辣椒碎",
      "ratio": "120g 对 110g",
      "note": "颗粒更粗，辣度更冲。"
    }
  ],
  "variations": [
    "甜辣版：白糖增至 90g，适合做拌饭酱。",
    "蒜香版：拌入 30g 蒜泥再入罐发酵。"
  ],
  "serving_suggestion": "作为拌饭、炒年糕与腌肉的底酱，取用需用干勺。",
  "storage": "冷藏可存 6 个月，表面淋一层香油隔绝空气。",
