  "steps": [
    {
      "n": 1,
      "text": "鲭鱼去头去内脏，刮净腹腔内壁的黑膜，用清水冲洗干净。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黑膜不去净，烤出来腥味压都压不住。",
      "visual_cue": "腹腔内壁洁白无黑膜，鱼身完整"
    },
    {
      "n": 2,
      "text": "厨房纸把鱼身内外彻底擦干，两面各斜划三刀方便入味。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鱼皮必须擦干，烤的时候才不会粘在纸上。",
      "visual_cue": "鱼皮干爽发紧，刀口深浅一致"
    },
    {
      "n": 3,
      "text": "鱼身两面抹盐和黑胡椒，刷一层香油，再撒蒜末腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐抹完静置一会儿，鱼肉会更紧实不出水。",
      "visual_cue": "鱼皮泛油光，表面挂薄薄蒜末"
    },
    {
      "n": 4,
      "text": "烤箱预热两百度，烤盘垫纸刷植物油，鱼放上去烤十二分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱼身离上火远一点，皮才不会被烤焦。",
      "visual_cue": "鱼皮起泡微焦，筷子能轻松插入"
    },
    {
      "n": 5,
      "text": "出炉挤柠檬汁，撒上大葱切成的葱白碎，趁热上桌配米饭最好。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬汁一定要吃之前再挤，早挤会让鱼肉发柴。",
      "visual_cue": "鱼皮金黄微脆，柠檬香清晰"
    }
  ],
  "tips": [
    "买冰鲜鲭鱼比冷冻的更合适，肉质紧实腥味也轻。",
    "没有烤箱可用平底锅煎，鱼皮朝下先煎三分钟再翻面。",
    "腌鱼时加一小勺白葡萄酒，去腥效果比料酒更明显。"
  ],
  "common_mistakes": [
    "鱼没擦干就进烤箱，烤完鱼皮全粘在纸上，一翻就烂。",
    "盐提前一小时抹好，鱼肉被盐拔干，烤完又柴又咸。",
    "温度开得太高，鱼皮焦黑而鱼骨边还是生的。"
  ],
  "substitutions": [
    {
      "original": "鲭鱼",
      "substitute": "秋刀鱼",
      "ratio": "600克:600克",
      "note": "秋刀鱼油脂更多，烤的时间缩短两分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "白葡萄酒",
      "ratio": "30克:20毫升",
      "note": "淋酒后再烤一分钟，酸香更柔和。"
    }
  ],
  "variations": [
    "抹盐时换成粗海盐，烤完表面结一层盐壳，鱼肉更鲜甜。",
    "喜欢重口可在香油里拌入辣椒粉与蒜末，抹匀后再烤，带一点辣香。"
  ],
  "serving_suggestion": "整条装盘，配一碗热米饭、一碟泡菜和一碗大酱汤，是标准的韩式家常饭桌。",
  "storage": "冷藏可存一天，回热用烤箱一百八十度烤五分钟，别用微波炉否则皮会发韧。",
