  "equipment": [
    "卷帘",
    "平底锅",
    "锋利的刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘净后煮成略硬的米饭，趁热加 10ml 香油、3g 盐与 5g 白糖拌匀，摊开晾至温热。",
      "time_min": 30,
      "heat": "中火",
      "tip": "饭要比平时硬一点，卷起来才不糊。",
      "visual_cue": "米粒油亮松散、不黏成坨"
    },
    {
      "n": 2,
      "text": "鸡蛋打散摊成薄蛋皮，切成 1cm 宽长条；黄瓜去瓤切条，火腿切条。",
      "time_min": 8,
      "heat": "中火",
      "tip": "蛋皮摊得薄，卷起才不鼓包。",
      "visual_cue": "蛋皮金黄完整、边缘不焦"
    },
    {
      "n": 3,
      "text": "平底锅下 15ml 植物油，把胡萝卜丝炒软，加 2g 盐调味盛出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "胡萝卜过油后营养更好吸收。",
      "visual_cue": "胡萝卜丝油亮变软"
    },
    {
      "n": 4,
      "text": "菠菜下沸水焯 40 秒捞出过冷水，挤干水分后加 3g 盐与 5ml 香油拌匀。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水分挤得越干，紫菜越不容易破。",
      "visual_cue": "菠菜翠绿成团、不出水"
    },
    {
      "n": 5,
      "text": "卷帘上铺一张紫菜，均匀铺一层 1cm 厚的米饭，边缘留 2cm 空白，再排上各类馅料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "馅料集中在下方三分之一处，卷起来才不溢出。",
      "visual_cue": "米饭平整、馅料成条"
    },
    {
      "n": 6,
      "text": "用卷帘从下往上压实卷紧，收口处用米粒粘住，表面刷 5ml 香油并撒 8g 芝麻，切 1.5cm 厚片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刀蘸水再切，切面才整齐不散。",
      "visual_cue": "卷体紧实、切面层次分明"
    }
  ],
  "tips": [
    "米饭一定要趁温热时铺，凉了会散、太烫会烫软紫菜。",
    "卷的时候双手均匀用力，中间边压边卷，切面才不空心。",
    "做好的紫菜包饭表面刷香油，既防干又亮泽。"
  ],
  "common_mistakes": [
    "米饭铺得太厚，卷起后馅料挤爆紫菜卷。",
    "馅料带水不挤干，紫菜吸水变韧、切片就散。",
    "切的时候刀不利，切面被压扁变形。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "蟹柳",
      "ratio": "80g 火腿 ≈ 80g 蟹柳",
      "note": "蟹柳需先撕条，口感更嫩。"
    },
    {
      "original": "菠菜",
      "substitute": "生菜",
      "ratio": "100g 菠菜 ≈ 90g 生菜",
      "note": "生菜不用焯水，洗净吸干水直接卷。"
    }
  ],
  "variations": [
    "家庭简化版：馅料只用鸡蛋、黄瓜与火腿三样，十分钟就能卷好。",
    "金枪鱼版：拌入 60g 金枪鱼罐头与 15g 蛋黄酱，风味更足。"
  ],
  "serving_suggestion": "切段摆盘，配一碟酱油与芥末，或蘸香油加盐食用。",
  "storage": "冷藏 1 天，切片后密封防干；不建议冷冻，解冻后米饭会返生。",
