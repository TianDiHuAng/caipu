  "equipment": [
    "大碗",
    "平底锅",
    "擀面杖",
    "小碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "高筋面粉和糯米粉混匀过筛，加入酵母、白糖和盐。",
      "time_min": 8,
      "heat": "无火",
      "tip": "粉类先混匀，面团才发得均匀。，看状态再决定下一步。",
      "visual_cue": "粉质蓬松，无结块，这一点很关键。"
    },
    {
      "n": 2,
      "text": "分次倒温水，揉成光滑不粘手的面团。，看状态再决定下一步。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水慢慢加，面团软硬才合适。，看状态再决定下一步。",
      "visual_cue": "面团光滑，能拉出薄膜"
    },
    {
      "n": 3,
      "text": "盖上湿布，室温发酵一小时到两倍大。，看状态再决定下一步。",
      "time_min": 62,
      "heat": "无火",
      "tip": "温度低就多等一会，看状态别看表。，动作轻一点，别把料弄碎。",
      "visual_cue": "面团膨胀，指压回弹"
    },
    {
      "n": 4,
      "text": "核桃和葵花籽切碎，与红糖、肉桂粉拌成馅。，看状态再决定下一步。",
      "time_min": 6,
      "heat": "无火",
      "tip": "坚果别切太细，咬着才有颗粒。，看状态再决定下一步。",
      "visual_cue": "馅料松散，香气浓郁"
    },
    {
      "n": 5,
      "text": "面团排气后分成八个剂子，滚圆按扁。，看状态再决定下一步。",
      "time_min": 8,
      "heat": "无火",
      "tip": "剂子大小一致，煎的时间才齐。，看状态再决定下一步。",
      "visual_cue": "面剂圆整，表面光滑"
    },
    {
      "n": 6,
      "text": "包入一勺馅料，收口捏紧朝下按成圆饼。，看状态再决定下一步。",
      "time_min": 8,
      "heat": "无火",
      "tip": "收口一定捏紧，糖化了会流出来。，看状态再决定下一步。",
      "visual_cue": "饼坯扁平，无裂缝，这一点很关键。"
    },
    {
      "n": 7,
      "text": "平底锅倒植物油，中小火把饼两面煎黄。，看状态再决定下一步。",
      "time_min": 10,
      "heat": "中小火",
      "tip": "中小火慢煎，里面才熟透。，看状态再决定下一步。",
      "visual_cue": "两面金黄，饼身鼓起"
    },
    {
      "n": 8,
      "text": "出锅后用锅铲在饼边压开一个小口散热。，看状态再决定下一步。",
      "time_min": 3,
      "heat": "无火",
      "tip": "压开小口，糖浆不至于烫嘴。，看状态再决定下一步。",
      "visual_cue": "开口微裂，糖浆微溢"
    }
  ],
  "tips": [
    "面团要发到两倍大，煎出来才松软。",
    "收口必须捏紧，否则糖浆全流到锅里。",
    "煎的时候中小火，火大外面焦里面生。"
  ],
  "common_mistakes": [
    "收口没捏紧，糖浆流一锅。，这一点很关键。",
    "火太大，饼皮焦了馅还是冷的。，这一点很关键。",
    "面团没发够，煎出来又硬又实。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "核桃",
      "substitute": "花生米",
      "ratio": "50 克:50 克",
      "note": "先烤香再切碎，香气更浓。"
    },
    {
      "original": "红糖",
      "substitute": "黑糖",
      "ratio": "80 克:80 克",
      "note": "焦香更重，甜度接近。"
    }
  ],
  "variations": [
    "馅里加一勺芝士，拉丝更好吃。，这一点很关键。",
    "换成豆沙馅，做成传统甜饼。，这一点很关键。"
  ],
  "serving_suggestion": "趁热吃，配一杯热豆浆。，这一点很关键。",
  "storage": "冷藏两天，复热平底锅小火两面各煎一分钟。",
