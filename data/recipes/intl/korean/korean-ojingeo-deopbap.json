    "刀",
    "砧板",
    "铲",
    "饭碗",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼收拾干净，去掉内脏和软骨，把外皮撕掉，再切成半厘米宽的圈。",
      "time_min": 12,
      "heat": "无火",
      "tip": "外皮留着会发硬发柴，撕掉口感才嫩。",
      "visual_cue": "鱿鱼圈白净，切口整齐"
    },
    {
      "n": 2,
      "text": "切好的鱿鱼用清水冲一遍沥干，用厨房纸吸掉表面水分备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "鱿鱼带水下锅会出水，酱汁就挂不住。",
      "visual_cue": "鱿鱼圈干爽透亮，不见滴水"
    },
    {
      "n": 3,
      "text": "洋葱和胡萝卜切细丝，大葱切段，大蒜切末，芝麻下干锅小火炒香。",
      "time_min": 8,
      "heat": "小火",
      "tip": "胡萝卜丝要细，粗了炒不熟还抢口感。",
      "visual_cue": "洋葱丝散开，胡萝卜丝橙红"
    },
    {
      "n": 4,
      "text": "小碗里放韩式辣椒酱、辣椒粉、浓口酱油、白糖和清水，搅成均匀酱汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "酱汁先调好，下锅才来得及，现调容易糊锅。",
      "visual_cue": "酱汁呈深红稠状，无干粉"
    },
    {
      "n": 5,
      "text": "炒锅烧热倒植物油，中火下蒜末和洋葱丝炒两分钟，炒到洋葱出甜味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软出甜是这道菜的底味，别急着放鱿鱼。",
      "visual_cue": "洋葱丝透明微软，香气发甜"
    },
    {
      "n": 6,
      "text": "转大火下鱿鱼圈快炒一分钟，看到鱿鱼卷边变白立刻进行下一步。",
      "time_min": 3,
      "heat": "大火",
      "tip": "鱿鱼炒久了像橡皮，卷边就停手，后面还要回锅。",
      "visual_cue": "鱿鱼卷成花，表面转白"
    },
    {
      "n": 7,
      "text": "倒入调好的酱汁和胡萝卜丝，中火翻炒两分钟，让酱汁裹住鱿鱼。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酱汁下锅后勤翻，糖分高容易糊底发苦。",
      "visual_cue": "酱汁浓亮，均匀裹住鱿鱼"
    },
    {
      "n": 8,
      "text": "撒大葱段翻两下关火，淋香油，把炒好的鱿鱼连酱汁浇在热米饭上。",
      "time_min": 3,
      "heat": "中火",
      "tip": "大葱最后下，余温烫软就够，久炒会发黄。",
      "visual_cue": "米饭上铺满鱿鱼，酱汁渗入"
    },
    {
      "n": 9,
      "text": "最后撒炒香芝麻，趁热拌开吃，让米饭吸饱酱汁再入口。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌的时候把饭粒压散，每粒都裹到酱汁才香。",
      "visual_cue": "拌开后饭粒红亮，芝麻点缀"
    }
  ],
  "tips": [
    "鱿鱼要撕掉外皮再下锅，皮留着嚼起来发硬，是这道菜最容易被忽略的一步。",
    "鱿鱼全程大火快炒，卷边变白就盛出。炒久了肉质收紧像橡皮，回锅再炒也救不回来。",
    "酱汁提前在小碗里调好，辣椒酱本身很稠，锅里边炒边调会糊底发苦。",
    "米饭要用热的，热饭才吸得住酱汁。冷饭下碗，酱汁全沉在碗底，吃起来又干又咸。"
  ],
  "common_mistakes": [
    "鱿鱼不撕皮直接炒，咬着发硬。要撕掉外层薄膜。",
    "鱿鱼和酱汁一起久煮，肉质变橡皮。要大火快炒后回锅。",
    "用冷饭做盖饭，酱汁挂不住。要用刚出锅的热饭。",
    "辣椒酱直接下锅炒，容易糊底。要先调成酱汁再倒。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "章鱼",
      "ratio": "300克:300克",
      "note": "更有嚼劲，炒制时间需延长三十秒。"
    },
    {
      "original": "韩式辣椒酱",
      "substitute": "辣椒粉加酱油",
      "ratio": "30克:12克加20毫升",
      "note": "辣味更直白，缺少发酵甜味。"
    }
  ],
  "variations": [
    "把鱿鱼换成五花肉片，就是韩式辣炒猪肉盖饭，肥瘦相间更下饭。",
    "加一把豆芽同炒，脆感更强，也是韩国食堂常见的搭配。",
    "把米饭换成拌了香油的紫米饭，颜色更深，口感更扎实。"
  ],
  "serving_suggestion": "一只大碗端上桌，白饭上堆着红亮的鱿鱼圈和彩色蔬菜丝，拌开后每粒米都裹着甜辣的酱汁，鱿鱼弹牙带脆。",
  "storage": "冷藏可放一天，复热用炒锅小火加一勺水翻两分钟；鱿鱼隔夜会变硬，口感略差。",
