  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "碗",
    "打蛋器",
    "寿司帘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进碗里加盐，用打蛋器打散到蛋黄蛋白完全混匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打散但别打出太多泡，卷出来才平整。",
      "visual_cue": "蛋液均匀，颜色橙黄，状态稳定"
    },
    {
      "n": 2,
      "text": "胡萝卜和大葱切成很细的末，海苔撕成小片备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切得越细越好卷，太粗会把蛋皮顶破。",
      "visual_cue": "菜末细碎，大小均匀，状态稳定"
    },
    {
      "n": 3,
      "text": "菜末和海苔拌进蛋液，静置两分钟让味道融合。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置后菜末不浮在表面，卷起来更均匀。",
      "visual_cue": "蛋液带料，分布均匀，状态稳定"
    },
    {
      "n": 4,
      "text": "平底锅刷薄薄一层植物油小火烧热，倒入三分之一蛋液铺满锅底。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋液铺满锅底就够薄，太厚卷起来会裂。",
      "visual_cue": "蛋液薄平，边缘凝固，状态稳定"
    },
    {
      "n": 5,
      "text": "表面还微湿时从一边卷起，用锅铲压紧推到锅边。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋皮半熟就卷，才粘得住不散开。，注意火候。",
      "visual_cue": "蛋卷紧实，形状整齐，状态稳定"
    },
    {
      "n": 6,
      "text": "空出来的锅面再刷植物油倒蛋液，接在卷好的蛋卷边上继续卷。",
      "time_min": 6,
      "heat": "小火",
      "tip": "每次都往同一方向卷，层次才漂亮。，注意火候。",
      "visual_cue": "层层相叠，接口粘合，状态稳定"
    },
    {
      "n": 7,
      "text": "重复倒入剩余蛋液并卷起，最后把蛋卷两面各煎半分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "两面煎定型，切的时候才不散。，注意火候。",
      "visual_cue": "外壳微黄，整体紧实，状态稳定"
    },
    {
      "n": 8,
      "text": "放在寿司帘上略压实，稍凉后切成两厘米宽的段装盘。",
      "time_min": 5,
      "heat": "无火",
      "tip": "稍凉再切，热的时候切容易散。，注意火候。",
      "visual_cue": "切面整齐，层次分明，状态稳定"
    }
  ],
  "tips": [
    "蛋液打散不必起泡，卷出来才平整。，值得留意。",
    "蛋皮半熟就卷，粘合力最好不散开。，值得留意。",
    "稍凉再切，切面才整齐不掉渣。，值得留意。"
  ],
  "common_mistakes": [
    "火太大蛋液立刻焦，卷起来一碰就碎。，务必避免。",
    "一次倒太多蛋液，蛋皮太厚卷不成层。，务必避免。",
    "热的时候切，蛋卷整段散开。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "胡萝卜",
      "substitute": "青椒",
      "ratio": "60 克:60 克",
      "note": "香气更明显，切末要更细。"
    },
    {
      "original": "海苔",
      "substitute": "紫菜",
      "ratio": "6 克:6 克",
      "note": "鲜味相近，用量可略增。"
    }
  ],
  "variations": [
    "加一小勺牛奶，蛋皮更软嫩。，也很受欢迎。",
    "卷好后刷一层香油撒芝麻，香气更足。，也很受欢迎。"
  ],
  "serving_suggestion": "切段后当便当配菜，配米饭和小菜一起上桌。",
  "storage": "冷藏一天，复热用平底锅小火干煎一分钟。，效果更稳定。",
