  "equipment": [
    "不粘锅",
    "打蛋盆",
    "筷子",
    "硅胶铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进盆里，加盐和清水，用筷子顺一个方向轻轻打散到均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "加一点清水比加奶更容易让蛋液嫩，且不出水。",
      "visual_cue": "蛋液均匀，表面浮细密小泡"
    },
    {
      "n": 2,
      "text": "洋葱切成细末，小葱切葱花，洋葱末越细越容易炒软出甜味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱末粗了会有生辛味，切细才化在蛋里。",
      "visual_cue": "洋葱末细白透明，葱花翠绿"
    },
    {
      "n": 3,
      "text": "不粘锅小火化开黄油，晃匀锅底，注意别让黄油变褐发焦。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油一冒棕色就发苦，看到起泡融化立刻下蛋液。",
      "visual_cue": "黄油融化微起泡，奶香散出"
    },
    {
      "n": 4,
      "text": "洋葱末下锅小火炒两分钟，炒到变软透明、甜味出来为止。",
      "time_min": 4,
      "heat": "小火",
      "tip": "洋葱先炒软，甜味才融进黄油里，蛋更香。",
      "visual_cue": "洋葱末透明微软，香气发甜"
    },
    {
      "n": 5,
      "text": "倒入蛋液，静置十秒让底部略微凝固，再用硅胶铲从外往中间推。",
      "time_min": 4,
      "heat": "小火",
      "tip": "别急着搅，等底部定型再推，蛋才会形成柔软的大块。",
      "visual_cue": "蛋液边缘凝固，中间仍流动"
    },
    {
      "n": 6,
      "text": "不停从锅边往中间推，让未凝固的蛋液流到锅底，全程保持小火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "推的节奏要慢，快了蛋就碎成小颗粒，没有绵密如脂的质地。",
      "visual_cue": "蛋块柔软湿润，不见焦边"
    },
    {
      "n": 7,
      "text": "蛋液八成凝固就关火，靠余温再推两下，撒黑胡椒和葱花。",
      "time_min": 3,
      "heat": "无火",
      "tip": "八成关火是关键，锅里余温会让蛋继续熟，见全熟再关就老了。",
      "visual_cue": "蛋块湿润发亮，无流动蛋液"
    },
    {
      "n": 8,
      "text": "最后淋两滴香油，装盘趁热吃，配米饭或馒头都很合适。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油只要两滴，多了会盖住黄油的奶香。",
      "visual_cue": "蛋堆松软，表面油光微亮"
    }
  ],
  "tips": [
    "蛋液里加清水而不是牛奶，清水在加热时变成蒸汽，蛋更蓬松也不出水。量大约是每枚鸡蛋五毫升。",
    "全程小火，用硅胶铲从锅边往中间推。火一大，蛋白迅速收紧，蛋就炒成颗粒状。",
    "八成凝固就要关火，靠余温继续熟。等锅里看着全熟再关，端上桌就老了，口感发干。",
    "黄油一融化就下洋葱，闻到奶香变焦味说明火大了，那锅蛋会带苦味。"
  ],
  "common_mistakes": [
    "牛奶代替清水，成品出水发灰。用清水更蓬松。",
    "中大火炒蛋，蛋迅速收紧成颗粒。必须全程小火。",
    "一直炒到锅里完全凝固才关火，上桌已经老了。八成关火。",
    "黄油烧到发褐再下蛋，整锅带苦味。融化起泡就下料。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "20克:18毫升",
      "note": "奶香减少，需多放一点葱花提香。"
    },
    {
      "original": "清水",
      "substitute": "牛奶",
      "ratio": "25毫升:25毫升",
      "note": "口感更浓郁但易出水，需减少五毫升用量。"
    }
  ],
  "variations": [
    "加一点切碎的火腿丁同炒，咸香更足，是韩国早餐店的常见做法。",
    "把洋葱换成大葱碎，辛香更重，配白饭特别下口。",
    "炒好后铺在白饭上，加一片芝士盖上焖十秒，就是韩式芝士蛋饭。"
  ],
  "serving_suggestion": "一勺舀起，蛋块松软湿润像云一样，黄油的奶香和洋葱的甜混在一起，入口即化，配白饭或热馒头都适合。",
  "storage": "现做现吃最好，冷藏不超过一天；复热只能用小火快翻十秒，微波会变橡皮。",
