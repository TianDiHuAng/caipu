  "equipment": [
    "保鲜盒",
    "平底锅",
    "磨泥器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆纹切成 0.3cm 薄片，用厨房纸吸去血水，冷藏备用。",
      "time_min": 15,
      "heat": "无火",
      "tip": "逆纹切才不塞牙，片要薄而匀。",
      "visual_cue": "肉片透光、纹理被切断"
    },
    {
      "n": 2,
      "text": "梨去皮磨成泥，与 50ml 酱油、25g 白糖、蒜末、黑胡椒混成腌料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "梨的酶能软化肉质，别省。",
      "visual_cue": "腌料呈浅褐色、有果香"
    },
    {
      "n": 3,
      "text": "肉片与洋葱丝倒入腌料抓匀，冷藏腌制 4 小时，中途翻动两次。",
      "time_min": 245,
      "heat": "无火",
      "tip": "腌足四小时，味道才能进到肉里。",
      "visual_cue": "肉片吸饱汁液、颜色转深"
    },
    {
      "n": 4,
      "text": "平底锅大火烧热，抖去多余腌汁后把肉片单层铺入锅中。",
      "time_min": 3,
      "heat": "大火",
      "tip": "一次别铺太多，否则变成水煮。",
      "visual_cue": "肉片边缘迅速变色、滋滋作响"
    },
    {
      "n": 5,
      "text": "煎 1 分钟翻面，加洋葱丝与 15ml 香油大火翻炒 2 分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "保持大火快炒，肉才嫩。",
      "visual_cue": "肉片焦边、洋葱微软"
    },
    {
      "n": 6,
      "text": "撒大葱与 5g 白芝麻翻匀立刻出锅，趁热用生菜包食。",
      "time_min": 2,
      "heat": "中火",
      "tip": "久炒会出水，肉质变老。",
      "visual_cue": "肉片油亮、香气四溢"
    }
  ],
  "tips": [
    "梨泥比糖更嫩肉，成品带自然果甜。",
    "腌汁要抖掉再下锅，否则容易糊锅。",
    "全程大火，锅温足才能炒出焦香。"
  ],
  "common_mistakes": [
    "顺着纹理切片，嚼起来又韧又塞牙，完全咬不动。",
    "小火慢炒，肉片出水变成炖牛肉。",
    "腌料太咸又加盐，整盘咸得无法入口。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "猪梅花肉",
      "ratio": "500g 对 500g",
      "note": "更油润，腌 3 小时即可。"
    },
    {
      "original": "梨",
      "substitute": "苹果",
      "ratio": "150g 对 150g",
      "note": "甜度更高，白糖减 5g。"
    }
  ],
  "variations": [
    "芝士版：炒好后撒 60g 芝士焗至融化。",
    "粉丝版：加泡软的粉丝同炒吸汁。"
  ],
  "serving_suggestion": "配生菜、蒜片与包饭酱，卷起来一口吃下。",
  "storage": "冷藏 2 天，复热用大火快炒 1 分钟。",
