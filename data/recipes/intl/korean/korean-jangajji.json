  "equipment": [
    "密封罐",
    "小锅",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜用盐搓洗表面后冲净，切成五厘米长的段，再纵向切成四条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "每条都带皮，腌出来颜色好看也更脆，这一步千万别省。",
      "visual_cue": "瓜条匀称，切口平整，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "切好的黄瓜摊在竹筛上，撒薄盐静置二十分钟，让多余水分渗出。",
      "time_min": 20,
      "heat": "无火",
      "tip": "杀出水分腌汁才不稀释，成品更脆，火候和顺序都要留神。",
      "visual_cue": "瓜条微微发软，筛下有水，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "小锅里倒生抽、清水、米醋和细砂糖，中火煮到糖化开，煮滚后关火放凉。",
      "time_min": 8,
      "heat": "中火",
      "tip": "腌汁必须彻底凉透，热汁会把黄瓜烫软，提前把配料备好再动手更稳。",
      "visual_cue": "腌汁清亮，手摸锅壁不温，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "黄瓜用厨房纸吸干表面水分，蒜切片，干辣椒剪成两段备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水分吸干是耐放的关键，湿的容易坏，这一步千万别省。",
      "visual_cue": "瓜条表面干爽，配料备齐，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "黄瓜和蒜片、干辣椒一起装进干燥的密封罐，倒入晾凉的腌汁没过食材。",
      "time_min": 5,
      "heat": "无火",
      "tip": "腌汁要完全淹没，露出水面的部分容易坏，火候和顺序都要留神。",
      "visual_cue": "瓜条沉底，汁面高过食材，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "盖紧密封放冰箱冷藏两天，中途翻动一次，吃前淋芝麻油撒白芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻动让上下入味一致，冷藏比室温风味更清爽。",
      "visual_cue": "瓜条转深褐，汤汁略浑，颜色和形态变化明显"
    }
  ],
  "tips": [
    "黄瓜先用盐搓洗再冲净，表面蜡质去掉了才腌得进去。",
    "腌汁要煮开再放凉，凉透再浇黄瓜，热汁会把黄瓜烫软。",
    "腌两天以上风味最好，中途翻动一次，让上下入味一致。"
  ],
  "common_mistakes": [
    "腌汁没放凉就倒进罐子，黄瓜被烫得发黄发软，一点不脆。",
    "盐放太多又腌了三天，咸得只能配白粥，救不回来。",
    "黄瓜没擦干就装罐，罐里出水发浑，两天就有了异味。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "苹果醋",
      "ratio": "80毫升:80毫升",
      "note": "果香更足，糖可减十克。"
    },
    {
      "original": "黄瓜",
      "substitute": "白萝卜",
      "ratio": "600克:600克",
      "note": "萝卜需多腌一天才入味，口感更脆。"
    }
  ],
  "variations": [
    "腌汁里加一片昆布同泡，鲜味更厚，是韩国全罗道的做法。",
    "把干辣椒换成小米辣，辣味更冲，适合喜欢重辣的人。"
  ],
  "serving_suggestion": "夹几段装小碟，淋一点腌汁和芝麻油，配烤肉或白米饭解腻又开胃。",
  "storage": "密封冷藏可放两周，取用时用干净无水的筷子，避免生水进入导致变质。",
