  "equipment": [
    "蒸锅",
    "碗",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净去蒂，切成手指长的段后再对半剖开成条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "剖开后受热更快，蒸出来也不会积水。",
      "visual_cue": "茄条均匀，长短一致，状态稳定"
    },
    {
      "n": 2,
      "text": "蒸锅加水烧开，茄条皮朝上摆进蒸屉，盖盖中火蒸十分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "皮朝上摆，颜色才不会泡得发暗。，注意时间。",
      "visual_cue": "蒸汽充足，茄条变软，状态稳定"
    },
    {
      "n": 3,
      "text": "用筷子能轻松插透即熟，取出放在漏勺里晾到不烫手。",
      "time_min": 8,
      "heat": "无火",
      "tip": "晾凉再拌，茄子才不会散成一团糊。，注意时间。",
      "visual_cue": "质地柔软，不出水，状态稳定"
    },
    {
      "n": 4,
      "text": "用手把茄条顺着纹路撕成细条，攥掉多余的水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "手撕比刀切更挂得住调料，口感也更好。",
      "visual_cue": "茄条成丝，水分挤干，状态稳定"
    },
    {
      "n": 5,
      "text": "大葱和蒜切末，和酱油、香油、白糖、盐调成拌料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先调匀再拌，咸淡才一致不发死。，注意时间。",
      "visual_cue": "拌料均匀，香气冲鼻，状态稳定"
    },
    {
      "n": 6,
      "text": "茄条放进大碗，倒入拌料轻轻抓匀，撒芝麻后装盘。",
      "time_min": 4,
      "heat": "无火",
      "tip": "抓拌要轻，避免把茄条压烂出水。，注意时间。",
      "visual_cue": "色泽油亮，芝麻均匀，状态稳定"
    }
  ],
  "tips": [
    "茄子蒸到用筷子能插透就好，蒸过久会烂成泥。",
    "晾凉后再撕条，形状才完整，也不会出太多水。",
    "拌料先在小碗里调匀再拌，咸淡才均匀。"
  ],
  "common_mistakes": [
    "茄子蒸太久，撕的时候整块散成糊状。",
    "热的时候就把拌料倒进去，茄子立刻出一盘水。",
    "蒜末切得太粗，吃起来辣口而且不清爽。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "长茄",
      "ratio": "600 克:600 克",
      "note": "皮薄易软，蒸制时间减两分钟。"
    },
    {
      "original": "酱油",
      "substitute": "鱼露",
      "ratio": "30 毫升:25 毫升",
      "note": "咸鲜更冲，用量要略减。"
    }
  ],
  "variations": [
    "加一勺辣椒粉，颜色更红，味道也更开胃。",
    "撒少许葱花和白芝麻，卖相更清爽好看。"
  ],
  "serving_suggestion": "冷藏后当小菜吃，配米饭和汤一起上桌最合适。",
  "storage": "冷藏一天，食用前拌匀，隔夜风味更融合。",
