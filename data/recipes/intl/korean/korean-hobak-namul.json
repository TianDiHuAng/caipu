    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西葫芦洗净切去两端，纵向剖开后切成三毫米厚的半月形薄片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "厚薄一致最关键，太厚炒不透，太薄一炒就烂成泥。",
      "visual_cue": "薄片厚薄均匀，边缘平整"
    },
    {
      "n": 2,
      "text": "薄片放进大碗，撒三克盐抓匀静置十分钟，杀出多余水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "杀过水的西葫芦炒时不出汤，口感才爽脆不水塌。",
      "visual_cue": "碗底积起浅绿汁水，薄片变软"
    },
    {
      "n": 3,
      "text": "用双手把西葫芦片轻轻挤压，挤掉水分，铺在干净布上再吸一遍水。",
      "time_min": 4,
      "heat": "无火",
      "tip": "挤水别太用力，压碎了炒出来就没有形状。",
      "visual_cue": "薄片不滴水，手感柔韧"
    },
    {
      "n": 4,
      "text": "炒锅烧热下植物油，油纹出现后放蒜末，小火炒到香味出来但不变黄。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末一焦就发苦，闻到香味就要立刻下菜。",
      "visual_cue": "蒜末微透明，香味明显"
    },
    {
      "n": 5,
      "text": "倒入西葫芦片转中大火快速翻炒两分钟，让每片都裹上油。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "大火快炒锁住水分，慢炒会出一锅汤。",
      "visual_cue": "薄片转半透明，锅底无积水"
    },
    {
      "n": 6,
      "text": "加剩下的盐与辣椒粉翻匀，尝一片确认咸淡，略微断生就关火。",
      "time_min": 2,
      "heat": "中火",
      "tip": "西葫芦八分熟最好吃，余温还会继续加热。",
      "visual_cue": "薄片柔软但仍能夹起不断"
    },
    {
      "n": 7,
      "text": "关火后淋香油，撒葱圈与焙香的白芝麻，用余温拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "西葫芦八分熟口感最好，关火后余温还会继续加热一层。",
      "visual_cue": "表面油亮，芝麻葱花均匀附着"
    },
    {
      "n": 8,
      "text": "拌好后盛盘，等温度降到温热再吃，冷藏后风味更清爽。",
      "time_min": 5,
      "heat": "无火",
      "tip": "温热时味道最融合，冰过之后蒜味会更突出。",
      "visual_cue": "成品色泽浅绿油亮，汁水很少"
    }
  ],
  "tips": [
    "西葫芦皮薄不用削，带皮炒颜色更好看，口感也更脆。",
    "没有芝麻可以撒一点紫菜碎，鲜味不输。",
    "这道拌菜冷藏可当小菜，配烤肉吃特别解腻。",
    "想更省油可以把炒改成焯水十秒后凉拌，热量更低。"
  ],
  "common_mistakes": [
    "不杀水直接炒，锅里很快积出一层汤，菜变软塌。",
    "蒜末在大火里炒到焦褐发黑，整盘拌菜都会带上明显苦味。",
    "炒过头把西葫芦炒成软糊，完全失去应有的爽脆口感。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "南瓜",
      "ratio": "480克:480克",
      "note": "需切更薄的片，炒制时间延长一分钟。"
    },
    {
      "original": "辣椒粉",
      "substitute": "小米辣圈",
      "ratio": "2克:5克",
      "note": "辣味更直接，适合重口版本。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝一起拌，做成更有饱腹感的版本。",
    "拌入一勺韩式大酱，咸鲜味更厚，配米饭很合适。"
  ],
  "serving_suggestion": "当作韩式餐桌上的小菜，配烤肉、汤饭或便当都合适，温热或冷藏皆可。",
  "storage": "冷藏两天内吃完，取用时用干净筷子；出水后风味会变淡，建议尽快食用。",
