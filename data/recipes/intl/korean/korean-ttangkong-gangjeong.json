  "equipment": [
    "炒锅",
    "平盘",
    "木勺",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花生仁挑去坏粒，用清水快速冲洗后彻底晾干表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "带水下锅会炸油，一定要晾到摸着完全干爽。",
      "visual_cue": "花生表面干爽，盆底不见水痕"
    },
    {
      "n": 2,
      "text": "锅里倒植物油，冷油下花生，小火慢慢升温并不断翻动。",
      "time_min": 8,
      "heat": "小火",
      "tip": "冷油下锅受热均匀，花生才不会外焦内生。",
      "visual_cue": "油面冒出细密小泡，花生颜色微微变深"
    },
    {
      "n": 3,
      "text": "花生炸到浅金黄、闻到明显香气后立刻捞出沥油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "炸到浅金黄就要马上捞出，余温还会继续上色。",
      "visual_cue": "花生呈浅金黄色，碰撞有清脆声"
    },
    {
      "n": 4,
      "text": "另起锅放白糖、清水与盐，小火熬到糖化开并冒大泡。",
      "time_min": 6,
      "heat": "小火",
      "tip": "中途不要搅动，搅了糖容易返砂结晶。",
      "visual_cue": "糖液透明鼓起大泡，呈浅琥珀色"
    },
    {
      "n": 5,
      "text": "倒入花生快速翻炒，让每颗都裹上糖液，再加蜂蜜翻匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "翻炒动作要快，糖一凉就会拉丝粘成硬团。",
      "visual_cue": "花生颗颗分明，表面裹着亮糖层"
    },
    {
      "n": 6,
      "text": "关火撒白芝麻拌开，趁热摊在平盘上摊散晾凉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一定要摊散，堆在一起凉了会结成一大块。",
      "visual_cue": "颗粒散开不粘连，糖衣透明发亮"
    }
  ],
  "tips": [
    "用烤花生代替油炸，少油也更省事。",
    "糖衣里加一点辣椒粉，做成甜辣口更上瘾。",
    "完全凉透再密封，热着装罐会返潮。",
    "配一杯热茶，甜香与茶苦正好互补。"
  ],
  "common_mistakes": [
    "花生炸到深褐才捞，放凉后带明显苦味。",
    "糖液熬过头变深棕，裹上去发苦还不粘。",
    "摊凉时没拨散，凝成一大块只能砸着吃。"
  ],
  "substitutions": [
    {
      "original": "花生",
      "substitute": "核桃仁",
      "ratio": "300克:300克",
      "note": "苦味略重，糖衣要多裹一层。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "30克:30克",
      "note": "糖衣更脆，光泽略差。"
    }
  ],
  "variations": [
    "裹糖之前撒一点肉桂粉，香气会更温暖厚实。",
    "用黑芝麻代替白芝麻，颜色对比更强。"
  ],
  "serving_suggestion": "装小碟当茶点或下酒小食，也可以装袋当伴手礼。",
  "storage": "密封常温可放两周，受潮后回锅小火复炒可恢复脆度。",
