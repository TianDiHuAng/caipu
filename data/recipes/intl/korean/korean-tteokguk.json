  "steps": [
    {
      "n": 1,
      "text": "年糕片放进冷水泡十分钟，泡到边缘发软，捞出沥干备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "牛腩要先煸再加水煮，汤底才有厚度和肉香",
      "visual_cue": "年糕片泡得柔软，片与片不粘连"
    },
    {
      "n": 2,
      "text": "汤锅放植物油烧热，下牛腩片中火煸三分钟，煸到表面变色出香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "年糕片一浮起来就该关火，煮久了会化成糊",
      "visual_cue": "牛腩变色，锅底留着一层焦香"
    },
    {
      "n": 3,
      "text": "加清水大火烧开，撇净浮沫后转小火煮四十分钟，煮出清亮的牛腩汤。",
      "time_min": 42,
      "heat": "小火",
      "tip": "用熬好的高汤代替清水，汤底会更浓更白",
      "visual_cue": "汤色清亮不浑，牛腩香气往上冒"
    },
    {
      "n": 4,
      "text": "另起平底锅刷薄油，倒蛋液摊成薄蛋皮，晾凉后切成细丝。",
      "time_min": 6,
      "heat": "小火",
      "tip": "浮沫一定要撇得彻底，汤色才清亮不会发灰",
      "visual_cue": "蛋皮摊得金黄，切出来的丝很均匀"
    },
    {
      "n": 5,
      "text": "把年糕片和蒜末下进汤锅，中火煮六分钟，煮到年糕浮起变软。",
      "time_min": 7,
      "heat": "中火",
      "tip": "蛋皮要尽量摊得薄一点，切丝才好看也容易熟",
      "visual_cue": "年糕片浮起来，汤色微微发白"
    },
    {
      "n": 6,
      "text": "加生抽和盐调味，盛入碗中，铺上牛腩片，撒蛋皮丝和葱花即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "调味一定放在最后做，先尝一勺汤再决定放盐",
      "visual_cue": "汤清味鲜，碗里配料摆得分明"
    }
  ],
  "tips": [
    "牛腩先煸后煮，汤才有厚度，直接水煮味道会寡淡。",
    "年糕不要久煮，浮起来就关火，泡在汤里久了会化。",
    "用牛骨汤代替清水，汤底更浓，是韩式老铺的做法。"
  ],
  "common_mistakes": [
    "牛腩不煸就直接加水，汤色发灰，喝起来只有咸味没有肉香。",
    "牛肉不煸就加水，汤色发灰，喝起来只有咸味没有肉香。",
    "蛋液倒进热油里大火煎，蛋皮起泡发硬，切丝就碎。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛肉末",
      "ratio": "150克:150克",
      "note": "牛肉末无需久煮，煸香后煮十分钟即可。"
    },
    {
      "original": "年糕",
      "substitute": "切片年糕",
      "ratio": "400克:400克",
      "note": "切片年糕易熟，煮四分钟就够。"
    }
  ],
  "variations": [
    "用海带和鳀鱼先熬汤底，不放牛腩，做成清爽的海鲜版年糕汤。",
    "用海带和鳀鱼先熬汤底，不放牛肉，做成清爽的海鲜版年糕汤。"
  ],
  "serving_suggestion": "大碗盛出，汤多料足，配一小碟泡菜和紫菜，是韩国人过年和生日的必备。",
  "storage": "冷藏可放两天，回热时加少量清水小火煮开，年糕久放会变硬，宜尽快吃完。",
