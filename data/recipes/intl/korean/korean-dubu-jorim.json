  "equipment": [
    "平底锅",
    "锅铲",
    "刀",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成两厘米厚的方片，用厨房纸吸干两面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面一定要吸干，不然下锅会溅油也煎不黄。",
      "visual_cue": "豆腐干爽，块形完整"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油烧到微热，把豆腐片平铺进锅中小火煎。",
      "time_min": 5,
      "heat": "小火",
      "tip": "一次别放太多，留出空隙才煎得均匀。",
      "visual_cue": "豆腐贴锅，油面微响"
    },
    {
      "n": 3,
      "text": "每面煎三分钟到金黄定型，翻面时用铲子轻推不粘。",
      "time_min": 7,
      "heat": "小火",
      "tip": "一面定型再翻，急着翻会把豆腐弄碎。",
      "visual_cue": "两面金黄，边缘挺括"
    },
    {
      "n": 4,
      "text": "小碗里把酱油、白糖、蒜末和清水调匀成酱汁备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调匀再入锅，白糖才不会结在锅底。",
      "visual_cue": "酱汁均匀，糖已化开"
    },
    {
      "n": 5,
      "text": "把酱汁淋进锅里，加小米辣圈，小火焖四分钟收汁。",
      "time_min": 4,
      "heat": "小火",
      "tip": "小火慢焖让豆腐吸味，大火会烧干发苦。",
      "visual_cue": "汤汁收浓，豆腐上色"
    },
    {
      "n": 6,
      "text": "撒上葱花和白芝麻，关火后连锅上桌即可食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花关火再撒，颜色和香气都留得住。",
      "visual_cue": "葱绿点缀，酱汁油亮"
    }
  ],
  "tips": [
    "豆腐表面吸干水分，煎的时候才不会溅油。",
    "一面煎定型再翻动，豆腐块才不碎。，值得留意。",
    "酱汁先调好再倒锅，甜咸味更均匀。，值得留意。"
  ],
  "common_mistakes": [
    "豆腐带水下锅，油花四溅还煎不上色。",
    "火大煎豆腐，外面焦黑里面还是凉的。",
    "酱汁收得太干，豆腐表面发咸发硬。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "小米辣",
      "substitute": "辣椒粉",
      "ratio": "10 克:5 克",
      "note": "辣味更均匀，颜色更红。"
    },
    {
      "original": "豆腐",
      "substitute": "老豆腐",
      "ratio": "500 克:500 克",
      "note": "质地更硬，煎制时间加两分钟。"
    }
  ],
  "variations": [
    "加一勺辣椒酱同焖，酱汁更浓稠微辣。",
    "放几片洋葱垫底，甜味更柔和。，也很受欢迎。"
  ],
  "serving_suggestion": "配一碗白米饭，把酱汁浇在饭上一起吃最香。",
  "storage": "冷藏两天，复热用平底锅小火加一勺水焖透。",
