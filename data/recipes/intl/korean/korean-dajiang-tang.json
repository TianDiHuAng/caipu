    "菜刀",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切滚刀块，西葫芦切半月片，洋葱切粗丝，豆腐切成三厘米方块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "土豆切小一点，才能与豆腐同时熟。",
      "visual_cue": "蔬菜切块均匀、大小相近"
    },
    {
      "n": 2,
      "text": "汤锅加清水烧开，放入黄豆酱与韩式辣椒酱，用汤勺压散搅匀。",
      "time_min": 5,
      "heat": "大火",
      "tip": "酱要用勺底压散，不然结块沉底。",
      "visual_cue": "汤色酱褐、无结块"
    },
    {
      "n": 3,
      "text": "下土豆块与洋葱丝，中火煮八分钟到土豆边缘变透明。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱先煮，汤的甜味才出来。",
      "visual_cue": "土豆能被筷子插入"
    },
    {
      "n": 4,
      "text": "放入西葫芦与豆腐块，再煮五分钟，让豆腐吸足酱汤。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "豆腐下锅后别大力搅，容易碎。",
      "visual_cue": "豆腐浮起、表面微孔"
    },
    {
      "n": 5,
      "text": "加蒜末与盐调味，撒葱段关火，连锅上桌配米饭。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "蒜末最后放，辛香才留得住。",
      "visual_cue": "汤面微微冒泡、葱段翠绿"
    }
  ],
  "tips": [
    "大酱咸度差别大，先少放再尝味补盐。",
    "加一把蛤蜊或几片牛肉，汤头更鲜甜。",
    "用淘米水代替清水，汤更浓稠顺口。"
  ],
  "common_mistakes": [
    "酱直接丢进锅里不搅散，喝到咸块。",
    "土豆切得太大，汤煮干了土豆还硬。",
    "一直大火滚煮，豆腐全碎在汤里。"
  ],
  "substitutions": [
    {
      "original": "黄豆酱",
      "substitute": "韩式大酱",
      "ratio": "30g 对 30g",
      "note": "正宗大酱风味更醇厚。"
    },
    {
      "original": "西葫芦",
      "substitute": "小白菜",
      "ratio": "150g 对 150g",
      "note": "小白菜最后两分钟再下。"
    }
  ],
  "variations": [
    "加泡菜同煮，做成酸辣口味的泡菜大酱汤。",
    "放几片五花肉先煸香，汤更浓郁。"
  ],
  "serving_suggestion": "配一碗白饭和几样小菜，就是标准韩式家常饭。",
  "storage": "冷藏两天，复热时加少量清水稀释。",
