  "id": "kimchi-jjigae",
  "name": {
    "zh": "泡菜豆腐锅",
    "en": "Kimchi Jjigae",
    "original": "김치찌개"
  },
  "cuisine": {
    "region": "intl",
    "style": "korean"
  },
  "category": [
    "hotpot-bbq"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 10,
    "cook_min": 25,
    "total_min": 35
  },
  "servings": 3,
  "flavor": [
    "sour",
    "spicy",
    "salty",
    "rich"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "泡菜",
          "name_en": "kimchi",
          "amount": 300,
          "unit": "g",
          "note": "选发酵较酸的，切 4 厘米段，泡菜汁留用",
          "optional": false
        },
        {
          "name": "五花肉",
          "name_en": "pork belly",
          "amount": 200,
          "unit": "g",
          "note": "切 0.5 厘米厚片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "嫩豆腐",
          "name_en": "silken tofu",
          "amount": 400,
          "unit": "g",
          "note": "切 2 厘米厚块",
          "optional": false
        },
        {
          "name": "大葱",
          "name_en": "Welsh onion",
          "amount": 40,
          "unit": "g",
          "note": "斜切段",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 60,
          "unit": "g",
          "note": "切丝",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 1,
          "unit": "piece",
          "note": "可选，最后打入锅中",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "韩式辣椒酱",
          "name_en": "gochujang",
          "amount": 20,
          "unit": "g",
          "note": "增辣与稠度",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 10,
          "unit": "ml",
          "note": "起锅炒肉用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "平衡泡菜酸度",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "补咸味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 700,
          "unit": "ml",
          "note": "可用第二遍淘米水代替",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "浅口砂锅",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "砂锅中下香油，中火把五花肉片两面煎到微黄。",
      "time_min": 3,
      "heat": "中火",
      "tip": "肉先煎出油，汤才香而不腻。",
      "visual_cue": "肉片边缘卷起，锅底有析出的油脂"
    },
    {
      "n": 2,
      "text": "下泡菜与洋葱同炒 2 分钟，加韩式辣椒酱与白糖炒匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "泡菜炒过，酸味会变柔和。",
      "visual_cue": "泡菜颜色转深，闻到酸香与辣酱香"
    },
    {
      "n": 3,
      "text": "倒入清水与泡菜汁，煮开后转小火炖 12 分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "用淘米水代替清水，汤更浓稠。",
      "visual_cue": "汤色橙红，表面浮起红油"
    },
    {
      "n": 4,
      "text": "放入嫩豆腐块并加生抽，小火再煮 5 分钟，期间不要大力翻动。",
      "time_min": 5,
      "heat": "小火",
      "tip": "豆腐后放，久煮会碎。",
      "visual_cue": "豆腐鼓起，用勺背轻推能滑动"
    },
    {
      "n": 5,
      "text": "撒大葱段关火；喜欢的话在中心打入鸡蛋，盖盖用余温焖 2 分钟。",
      "time_min": 4,
      "heat": "微火",
      "tip": "鸡蛋靠余温焖熟，蛋黄半流心最好吃。",
      "visual_cue": "蛋白凝固、蛋黄仍流动，葱段变翠绿"
    }
  ],
  "tips": [
    "泡菜越酸越适合煮锅，新腌的泡菜味淡。",
    "五花肉先煎出油再炒，汤底更厚更香。",
    "豆腐用嫩豆腐，老豆腐不易入味。"
  ],
  "common_mistakes": [
    "泡菜不先炒直接加水，汤味寡淡缺少层次。",
    "全程大火滚煮，豆腐碎、汤变浑。"
  ],
  "substitutions": [
    {
      "original": "泡菜",
      "substitute": "酸菜 250 克加韩式辣椒粉 10 克",
      "ratio": "1:0.8",
      "note": "偏中式酸香，需加 10 克白糖平衡。"
    },
    {
      "original": "五花肉",
      "substitute": "午餐肉或金枪鱼罐头",
      "ratio": "1:1",
      "note": "午餐肉本身咸，生抽减半。"
    }
  ],
  "variations": [
    "加方便面饼与芝士片做成部队锅。",
    "加年糕与芝士片，适合儿童口味。"
  ],
  "serving_suggestion": "配一碗白米饭，用汤泡饭最下口。",
  "storage": "冷藏 2 天，复热需煮沸；豆腐久放易酸，不建议冷冻。",
