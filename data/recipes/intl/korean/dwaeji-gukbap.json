  "equipment": [
    "汤锅",
    "电饭煲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加 30ml 料酒与姜片焯 8 分钟，撇净血沫后捞出冲洗。",
      "time_min": 12,
      "heat": "中火",
      "tip": "焯水后再冲一遍，汤才不浑。",
      "visual_cue": "肉块表面变白、无血水渗出"
    },
    {
      "n": 2,
      "text": "汤锅加 2500ml 清水，放小鱼干与海带煮 15 分钟，捞出渣料留清汤。",
      "time_min": 20,
      "heat": "中火",
      "tip": "小鱼干与海带是韩式汤底的鲜味来源。",
      "visual_cue": "汤色微黄、海带香味散出"
    },
    {
      "n": 3,
      "text": "清汤中放入五花肉、洋葱、大蒜与一半大葱段，大火烧开转小火煮 90 分钟。",
      "time_min": 95,
      "heat": "小火",
      "tip": "小火慢煮肉才酥而不散。",
      "visual_cue": "筷子能轻松插透肉块"
    },
    {
      "n": 4,
      "text": "取出肉块稍凉后切成 0.5cm 薄片，汤过滤后加 8g 盐、20ml 生抽与 3g 白胡椒调味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉要凉一点再切，才切得薄。",
      "visual_cue": "肉片薄而完整、汤色乳白"
    },
    {
      "n": 5,
      "text": "大米煮成饭后盛入石锅或深碗，铺上肉片与剩余葱段，浇入滚汤没过食材。",
      "time_min": 25,
      "heat": "中火",
      "tip": "汤要滚烫浇下去，香味才冲。",
      "visual_cue": "碗中汤面浮油、葱段变软"
    },
    {
      "n": 6,
      "text": "30g 辣椒酱加 10ml 生抽与少许汤调成酱碟，随汤饭一同上桌，按口味取用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱碟单独放，避免一次搅浑整碗汤。",
      "visual_cue": "酱料顺滑、颜色红亮"
    }
  ],
  "tips": [
    "五花肉选肥瘦相间的整块，煮后切片不易碎。",
    "汤底用小鱼干和海带吊鲜，比单纯清水浓郁很多。",
    "肉片切得越薄，吸汤越快口感越好。"
  ],
  "common_mistakes": [
    "肉块煮好后趁热切，切面毛糙且容易散。",
    "火候过大，汤被煮成浑浊的白色浮渣汤。",
    "酱料直接搅进锅里，整锅汤咸辣失衡。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "前腿肉",
      "ratio": "700g 对 700g",
      "note": "瘦一些，煮的时间减 15 分钟。"
    },
    {
      "original": "小鱼干",
      "substitute": "鳀鱼高汤包",
      "ratio": "20g 对 1 包",
      "note": "省去过滤步骤，风味相近。"
    }
  ],
  "variations": [
    "血肠版：加 200g 血肠片同煮，是釜山吃法。",
    "辣汤版：汤中加 15g 辣椒粉，做成辣味汤饭。"
  ],
  "serving_suggestion": "汤饭配泡菜与酱碟，是韩国釜山最经典的早餐组合。",
  "storage": "汤与饭分开冷藏可存 2 天，复热时饭另蒸避免糊化。",
