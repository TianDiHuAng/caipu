  "equipment": [
    "大碗",
    "密封盒",
    "手套"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白萝卜 1000g 去皮切 2 厘米见方的块，装碗撒 10g 盐抓匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块切大些，腌完才有脆感。",
      "visual_cue": "萝卜块均匀、表面挂盐粒"
    },
    {
      "n": 2,
      "text": "静置 1 小时，中途翻动两次，让萝卜均匀出水。",
      "time_min": 60,
      "heat": "无火",
      "tip": "腌到萝卜块弯折不断即可。",
      "visual_cue": "萝卜变软、碗底积盐水"
    },
    {
      "n": 3,
      "text": "倒掉腌出的水，用清水冲洗两遍，沥干 10 分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冲洗再沥干，成品才不会过咸。",
      "visual_cue": "萝卜块干爽、无积水"
    },
    {
      "n": 4,
      "text": "碗中放 30g 辣椒粉、蒜末 20g、姜末 10g、15ml 鱼露与 10g 白糖。",
      "time_min": 3,
      "heat": "无火",
      "tip": "粗辣椒粉颜色更红，也更不容易糊。",
      "visual_cue": "调料成深红色糊状"
    },
    {
      "n": 5,
      "text": "戴手套把调料均匀揉抹在每块萝卜上，加 5g 盐与葱段拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "每块都要裹到，发酵才均匀。",
      "visual_cue": "萝卜块通体红亮、葱段分布均匀"
    },
    {
      "n": 6,
      "text": "装入密封盒压紧排出空气，室温放置 1 天后转冷藏发酵 3 天。",
      "time_min": 5,
      "heat": "无火",
      "tip": "夏天室温放半天即可，冬天放一天。",
      "visual_cue": "盒内出现气泡、汤汁增多"
    }
  ],
  "tips": [
    "萝卜腌到能弯折不断，脆度刚刚好。",
    "腌完必须冲洗沥干，否则成品过咸。",
    "冷藏发酵 3 天后酸味最平衡，越放越酸。"
  ],
  "common_mistakes": [
    "萝卜切得太小，腌完软塌没有脆感。",
    "没沥干就拌料，出水后味道寡淡。",
    "夏天室温放太久，直接发酸发黏。"
  ],
  "substitutions": [
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "15ml 对 15ml",
      "note": "咸度略高，盐减 2g。"
    },
    {
      "original": "白萝卜",
      "substitute": "青萝卜",
      "ratio": "1000g 对 1000g",
      "note": "辛辣感更强，糖可加 3g。"
    }
  ],
  "variations": [
    "加 50g 韭菜段，发酵香气更足。",
    "加 20g 糯米糊，酸味更圆润。"
  ],
  "serving_suggestion": "配烤肉、白饭或汤饭，切小块上桌。",
  "storage": "冷藏可存 1 个月，取用时用干净筷子夹。",
