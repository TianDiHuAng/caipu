  "equipment": [
    "平底锅",
    "汤勺",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "午餐肉切 0.5cm 厚片，豆腐切厚片，泡菜切段，年糕冲洗后分开。",
      "time_min": 8,
      "heat": "无火",
      "tip": "年糕冲洗掉表面黏粉，煮时才不粘连。",
      "visual_cue": "片状整齐、年糕条分离"
    },
    {
      "n": 2,
      "text": "方便面去掉调料包只留面饼，豆芽洗净掐去根须备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面饼最后放，久煮就糊成团。",
      "visual_cue": "面饼完整、豆芽干净"
    },
    {
      "n": 3,
      "text": "韩式辣酱、辣椒面与生抽加 100ml 清水调匀成酱汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先调开酱料，汤底才不结块。",
      "visual_cue": "酱汁顺滑、不见干料结块"
    },
    {
      "n": 4,
      "text": "平底锅倒剩余清水烧开，下酱汁搅匀后放泡菜与午餐肉。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水开再下酱，辣味更融。",
      "visual_cue": "汤色红亮、泡菜香出"
    },
    {
      "n": 5,
      "text": "下豆腐、年糕与豆芽中火煮 8 分钟，再放面饼煮 3 分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "面饼煮 3 分钟就够，久了没口感。",
      "visual_cue": "年糕软糯、面饼散开"
    },
    {
      "n": 6,
      "text": "表面铺芝士片，加盖焖 2 分钟至融化，撒蒜末即可开吃。",
      "time_min": 6,
      "heat": "小火",
      "tip": "芝士融化能柔化辣味，别省。",
      "visual_cue": "芝士拉丝、汤面微沸"
    }
  ],
  "tips": [
    "面饼最后下锅，三分钟就够软而不断。",
    "芝士融化后能减轻辣度，口味更圆润。",
    "汤底用清水即可，泡菜与辣酱已够味。"
  ],
  "common_mistakes": [
    "面饼一开始就下锅，煮成一锅烂糊。",
    "辣酱直接丢进汤里，结块化不开。",
    "芝士放太早，长时间煮后油水分离。"
  ],
  "substitutions": [
    {
      "original": "午餐肉",
      "substitute": "火腿肠",
      "ratio": "200g 对 200g",
      "note": "火腿肠更咸，生抽减 5ml。"
    },
    {
      "original": "芝士",
      "substitute": "马苏里拉芝士碎",
      "ratio": "50g 对 60g",
      "note": "拉丝效果更好。"
    }
  ],
  "variations": [
    "海鲜版：加 150g 蛤蜊与 6 只虾，鲜味更足。",
    "牛肉版：加 150g 肥牛片，涮 30 秒即可。"
  ],
  "serving_suggestion": "边煮边吃，先吃面再喝汤，最后用汤汁拌饭。",
  "storage": "不建议隔夜，年糕与面回热后口感尽失。",
