      "items": [
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 15,
          "unit": "ml",
          "note": "炒海带用",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 15,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "收尾调整",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 10,
          "unit": "ml",
          "note": "炒牛肉用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "剪刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干海带放进清水泡十分钟，泡到完全展开，捞出冲洗两遍沥干。",
      "time_min": 4,
      "heat": "无火",
      "tip": "泡发的水沉淀后取上层清液，一半用来煮汤更鲜。",
      "visual_cue": "海带完全舒展，颜色转深绿。"
    },
    {
      "n": 2,
      "text": "泡好的海带用剪刀剪成五厘米长的段，太厚的梗部片薄。",
      "time_min": 3,
      "heat": "无火",
      "tip": "梗部片薄一半，煮出来和叶片同时软，不会一口硬一口软。",
      "visual_cue": "海带段宽窄一致，厚梗已片开。"
    },
    {
      "n": 3,
      "text": "汤锅倒香油，中小火下海带翻炒四分钟，炒到海带表面发亮变软。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "炒到海带边缘微微透明就对了，这一步决定汤白不白。",
      "visual_cue": "海带颜色转深、质地柔软，锅里有海腥转香的气味。"
    },
    {
      "n": 4,
      "text": "倒入清水或泡海带的水，大火烧开后转中小火煮十分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "水一次加足，中途补水会让汤色变淡。",
      "visual_cue": "汤色转为浅乳白，海带沉底。"
    },
    {
      "n": 5,
      "text": "另起小锅倒植物油，把牛肉薄片快速炒到变色，连汁倒进汤锅。",
      "time_min": 4,
      "heat": "中火",
      "tip": "牛肉单炒再入汤，血沫不会浑汤，肉香也更集中。",
      "visual_cue": "牛肉片通体变色，没有粉红部分。"
    },
    {
      "n": 6,
      "text": "加蒜末和生抽煮两分钟，尝味后加盐调整，关火盛碗。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "蒜末最后放，久煮会抢掉海带的清香。",
      "visual_cue": "汤色乳白微透，海带沉在碗底。"
    }
  ],
  "tips": [
    "干海带泡十分钟就够，泡久了香气全跑到水里，汤就寡淡。",
    "海带一定要用香油先炒过再加水，这是汤头浓白的唯一诀窍。",
    "牛肉切得越薄越好，下锅一烫就熟，久煮反而发柴。"
  ],
  "common_mistakes": [
    "海带直接丢进冷水里煮，汤色清灰、味道腥，怎么调味都救不回来。",
    "泡海带的水全部倒掉，鲜味最浓的部分被浪费。",
    "盐一开始就放足，海带本身带咸，最后咸得无法入口。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "蛤蜊",
      "ratio": "150克:200克",
      "note": "鲜味更清，盐要减半。"
    },
    {
      "original": "香油",
      "substitute": "植物油",
      "ratio": "15毫升:15毫升",
      "note": "少了坚果香，汤头略薄。"
    }
  ],
  "variations": [
    "加几片薄切年糕同煮，汤变得稠一点，是孩子爱喝的版本。",
    "把牛肉换成干贝，汤色更清亮，适合夏天喝。"
  ],
  "serving_suggestion": "盛进石锅或厚壁汤碗，配一碗白米饭和几样小菜，就是韩国人生日必喝的那一碗。",
  "storage": "冷藏两天内吃完，海带久泡会发软失味，回热时补一点蒜末提香。",
