  "equipment": [
    "小碗",
    "勺子",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大葱只取葱白部分切成极细的葱白碎，大蒜拍碎后剁成细蓉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "葱白切得越细，酱里分布才越均匀，不会一口硌牙。",
      "visual_cue": "葱白末细白松散，蒜蓉黏稠无颗粒"
    },
    {
      "n": 2,
      "text": "小碗里放韩式辣椒酱、生抽、白糖与香油，用勺子搅到顺滑。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先搅酱再放葱白末与蒜末，酱体才不会有干粉块。",
      "visual_cue": "酱体顺滑油亮，勺子提起能挂住"
    },
    {
      "n": 3,
      "text": "加入葱白碎、蒜蓉和压碎的熟白芝麻，继续拌匀到带颗粒感。",
      "time_min": 3,
      "heat": "无火",
      "tip": "熟白芝麻要先用勺背压碎再拌进去，香气才出得来。",
      "visual_cue": "酱中可见均匀葱白与芝麻颗粒"
    },
    {
      "n": 4,
      "text": "盖上盖子静置五分钟让味道融合，装小碟随菜上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置这步别省，大葱与蒜的辛辣会变得柔和。",
      "visual_cue": "表面浮一层薄油，香气厚而不冲"
    }
  ],
  "tips": [
    "想要更醇厚可加一勺大酱同拌，风味层次立刻厚一层。",
    "拌好后冷藏半小时再吃，大葱的香气和酱香会融合得更彻底。",
    "用来包生菜烤肉最合适，也可以直接拌饭、蘸黄瓜条。"
  ],
  "common_mistakes": [
    "葱白碎切得太粗，包菜时一口咬到生的大葱，辣得盖住肉味。",
    "白糖一次放太多，酱甜得发腻，配烤肉完全不解腻。",
    "香油倒得过量，酱体稀得流汤，包菜时全滴在手上。"
  ],
  "substitutions": [
    {
      "original": "韩式辣椒酱",
      "substitute": "大酱",
      "ratio": "120克:100克",
      "note": "大酱更咸，生抽减到五毫升。"
    },
    {
      "original": "熟白芝麻",
      "substitute": "花生碎",
      "ratio": "6克:8克",
      "note": "花生碎更香，须压得更碎以免呛口。"
    }
  ],
  "variations": [
    "加半个切碎的青椒，带一点清脆与青辣，配白切肉特别对味。",
    "加一勺梨泥，甜味更自然，也更适合孩子吃。"
  ],
  "serving_suggestion": "装在小瓷碟里，配烤肉、生菜叶、白切肉和蒜片一起上桌。",
  "storage": "密封冷藏可存两周，取用时用干净干勺，避免生水进去变质。",
