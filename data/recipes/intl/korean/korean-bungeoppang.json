        }
      ]
    }
  ],
  "equipment": [
    "鱼形模具",
    "大碗",
    "打蛋器",
    "小锅",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆提前泡四小时，加水煮四十分钟到用手一捏就碎。",
      "time_min": 30,
      "heat": "中火",
      "tip": "煮到完全软烂，压泥时才不夹生。，注意火候。",
      "visual_cue": "豆粒软烂，汤色发深，状态稳定"
    },
    {
      "n": 2,
      "text": "红豆沥水压成泥，加一半白糖小火炒到能成团。",
      "time_min": 12,
      "heat": "小火",
      "tip": "炒到抱团不粘锅，包的时候才不外流。",
      "visual_cue": "豆沙成团，铲子留痕，状态稳定"
    },
    {
      "n": 3,
      "text": "牛奶加热到温热，加酵母和剩余白糖搅匀静置五分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "温牛奶化酵母，太烫会烫死发酵力。，注意火候。",
      "visual_cue": "表面起泡，糖已化开，状态稳定"
    },
    {
      "n": 4,
      "text": "面粉加盐过筛，倒入酵母牛奶搅成顺滑无颗粒的面糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面糊要比蛋糕糊稠些，倒进模具才不流散。",
      "visual_cue": "面糊顺滑，能缓慢流下"
    },
    {
      "n": 5,
      "text": "盖布静置四十分钟，面糊膨胀到约一倍半大。这一步不要着急。",
      "time_min": 42,
      "heat": "无火",
      "tip": "发起来的面糊烤完才松软不硬。，注意火候。",
      "visual_cue": "表面起泡，体积变大，状态稳定"
    },
    {
      "n": 6,
      "text": "鱼形模具刷一层植物油，小火烧热后倒入一半面糊。",
      "time_min": 4,
      "heat": "小火",
      "tip": "模具烧热再倒糊，脱模才完整不粘。，注意火候。",
      "visual_cue": "模具油亮，面糊铺底，状态稳定"
    },
    {
      "n": 7,
      "text": "放一小团红豆沙在中间，再倒面糊盖住馅料填满。",
      "time_min": 3,
      "heat": "小火",
      "tip": "馅别放太多，盖不住就会露出来。，注意火候。",
      "visual_cue": "馅料居中，面糊覆盖，状态稳定"
    },
    {
      "n": 8,
      "text": "盖模小火烤三分钟，翻面再烤三分钟到两面金黄。",
      "time_min": 8,
      "heat": "小火",
      "tip": "两面都要烤到能轻松脱模，中间才熟。",
      "visual_cue": "外壳金黄，声响清脆，状态稳定"
    }
  ],
  "tips": [
    "红豆要煮到一捏就碎，豆沙才细腻。，值得留意。",
    "模具烧热再倒面糊，脱模才完整。，值得留意。",
    "小火两面慢烤，外皮脆里面熟。，值得留意。"
  ],
  "common_mistakes": [
    "豆沙没炒干就包，烤的时候流一模具。，务必避免。",
    "面糊没发起来，烤出来硬邦邦。，务必避免。",
    "火太大只烤一面，另一面还是生的。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "红豆沙",
      "ratio": "250 克:300 克",
      "note": "省去煮豆一步，白糖减二十克。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "220 毫升:220 毫升",
      "note": "口感略清爽，奶香稍减。"
    }
  ],
  "variations": [
    "豆沙里加一点肉桂，香气更暖。，也很受欢迎。",
    "面糊加少许抹茶粉，做成绿色鱼饼。，也很受欢迎。"
  ],
  "serving_suggestion": "趁热吃最香，配一杯热牛奶当下午点心。，效果更稳定。",
  "storage": "常温一天，冷藏三天，复热用烤箱一百六十度烤五分钟。",
