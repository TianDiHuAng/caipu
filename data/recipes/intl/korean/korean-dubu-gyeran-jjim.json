  "equipment": [
    "蒸锅",
    "打蛋盆",
    "细筛",
    "碗",
    "筷子",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐用刀面压成泥，再用细筛过一遍，滤掉粗颗粒让口感更细。",
      "time_min": 8,
      "heat": "无火",
      "tip": "过筛这步决定滑不滑，粗颗粒会让蛋羹里带渣。",
      "visual_cue": "豆腐泥细腻发白，筛上留粗渣"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进盆里打散，加盐、白胡椒和清水搅匀到完全融合。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液和清水按一比一配，水多了不成形，少了发硬。",
      "visual_cue": "蛋液浅黄均匀，无絮状物"
    },
    {
      "n": 3,
      "text": "把豆腐泥分两次拌进蛋液，用打蛋器慢慢搅到没有结块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆腐要一点点拌进去，一次倒入容易结团搅不开。",
      "visual_cue": "豆腐与蛋液融合，呈稠糊"
    },
    {
      "n": 4,
      "text": "拌好的糊过细筛两遍，滤掉浮沫和残渣，倒进深碗里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛两遍是滑嫩的保证，滤完表面才平整无坑。",
      "visual_cue": "糊体细腻，表面不见气泡"
    },
    {
      "n": 5,
      "text": "胡萝卜切细末撒在表面，碗口蒙保鲜膜扎几个小孔防冷凝水。",
      "time_min": 4,
      "heat": "无火",
      "tip": "保鲜膜挡住锅盖回流的冷凝水，蛋面才不会起麻点。",
      "visual_cue": "表面平整，胡萝卜末点缀其上"
    },
    {
      "n": 6,
      "text": "蒸锅水烧开后放碗，转中小火蒸十二分钟，关火虚蒸三分钟。",
      "time_min": 14,
      "heat": "中小火",
      "tip": "中小火蒸，大火会让蛋里的水分快速沸腾形成蜂窝。",
      "visual_cue": "蛋面光滑，轻晃中间微微颤动"
    },
    {
      "n": 7,
      "text": "取出撕掉保鲜膜，淋浓口酱油和香油，撒葱花和炒香芝麻即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱油要沿着碗边慢慢淋一圈，颜色分布均匀也不会砸出坑。",
      "visual_cue": "蛋面如镜，葱花翠绿点缀"
    }
  ],
  "tips": [
    "北豆腐一定要压泥过筛，颗粒滤掉蛋羹才滑。这步多做两分钟，口感差一个档次。",
    "蛋液与清水按一比一，豆腐本身含水，水别再加多。水多了蒸出来会塌成一汪。",
    "蛋液和豆腐糊都要过筛，浮沫滤干净表面才平整。不过筛怎么蒸都有气孔。",
    "蒸的时候蒙保鲜膜并扎孔，全程中小火十二分钟再虚蒸三分钟。大火猛蒸必出蜂窝。"
  ],
  "common_mistakes": [
    "北豆腐不过筛直接压碎拌，蛋羹里全是粗渣。必须过细筛。",
    "清水加太多，蒸出来不成形。蛋和水一比一就够。",
    "不蒙保鲜膜，冷凝水滴落砸出麻点。要蒙膜并扎孔。",
    "大火蒸十五分钟以上，豆腐蛋羹又老又出水。中小火并虚蒸。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "嫩豆腐",
      "ratio": "300克:300克",
      "note": "更嫩滑但含水多，清水减到一百四十毫升。"
    },
    {
      "original": "浓口酱油",
      "substitute": "生抽",
      "ratio": "8毫升:8毫升",
      "note": "咸味稍轻，可加一点盐补味。"
    }
  ],
  "variations": [
    "加一勺虾皮碎同蒸，海味渗进蛋羹，鲜度提升明显。",
    "把胡萝卜换成香菇末，菌香更沉，是秋冬常做的版本。",
    "用砂锅代替深碗蒸，砂锅保温好，端上桌还在咕嘟，适合冬天。"
  ],
  "serving_suggestion": "一勺挖下去，蛋羹颤悠悠的，豆腐的豆香和蛋香混在一起，滑得几乎不用嚼，淋一点酱油香气就起来了。",
  "storage": "冷藏可放一天，复热需覆膜中火蒸五分钟；隔夜会出水，建议现做现吃。",
