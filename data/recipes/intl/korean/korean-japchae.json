  "steps": [
    {
      "n": 1,
      "text": "红薯粉丝用温水泡二十分钟至变软，剪成二十厘米长段备用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡软即可，不要泡到发白发涨。",
      "visual_cue": "粉丝柔软有弹性，能弯成圈"
    },
    {
      "n": 2,
      "text": "牛肉丝用生抽、白糖、黑胡椒与蒜末抓匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "牛肉逆纹切丝，腌后才嫩。",
      "visual_cue": "肉丝裹上酱色，表面微黏"
    },
    {
      "n": 3,
      "text": "菠菜入沸水焯三十秒捞出过凉水，挤干水分切段，用盐与芝麻油拌一下。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯完立刻过凉水，颜色才翠绿。",
      "visual_cue": "菠菜深绿不塌，水分挤干"
    },
    {
      "n": 4,
      "text": "鸡蛋打散摊成薄蛋皮，晾凉后切成细丝，胡萝卜、洋葱、香菇与黑木耳分别切丝。",
      "time_min": 8,
      "heat": "小火",
      "tip": "蛋皮要摊薄，切出的丝才漂亮。",
      "visual_cue": "蛋皮金黄平整，丝条均匀"
    },
    {
      "n": 5,
      "text": "炒锅下植物油，先把牛肉丝大火炒到变色盛出，再依次炒胡萝卜、洋葱、香菇与黑木耳丝。",
      "time_min": 10,
      "heat": "大火",
      "tip": "每样分开炒，蔬菜出水少、颜色分明。",
      "visual_cue": "蔬菜断生仍带脆感，锅底干爽"
    },
    {
      "n": 6,
      "text": "粉丝入沸水烫两分钟捞出沥干，趁热加生抽、白糖与一半芝麻油拌匀上色。",
      "time_min": 4,
      "heat": "大火",
      "tip": "粉丝趁热拌酱才吸味，凉了就只是挂着酱。",
      "visual_cue": "粉丝呈浅褐色，根根分开"
    },
    {
      "n": 7,
      "text": "把所有配料倒进粉丝里，加剩余芝麻油与盐抓拌均匀，撒白芝麻。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用手抓拌比筷子更均匀，粉丝不易断。",
      "visual_cue": "粉丝与配菜颜色交错，油亮不粘"
    }
  ],
  "tips": [
    "配一碗白饭或单吃都合适，冷藏后当小菜更入味。",
    "粉丝拌好后放凉再吃，甜咸味会更平衡。",
    "想更丰富可加青椒丝、鱼饼丝与少量辣酱同拌。"
  ],
  "common_mistakes": [
    "粉丝泡过头，一炒就断成一截一截。",
    "所有蔬菜一起下锅炒，出水多、颜色发暗。",
    "酱料一次全倒，粉丝吸不均、局部过咸。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "猪里脊",
      "ratio": "200 克:200 克",
      "note": "炒制时间略短，避免发柴。"
    },
    {
      "original": "红薯粉丝",
      "substitute": "绿豆粉丝",
      "ratio": "200 克:200 克",
      "note": "更耐煮，泡的时间减到十五分钟。"
    }
  ],
  "variations": [
    "加入辣酱与芝麻叶，可做全州式的辣味杂菜。"
  ],
  "serving_suggestion": "温热或放凉后食用，配白饭与泡菜。",
  "storage": "冷藏两天，风味更融合；复热用平底锅小火干炒，不要微波加热以免粉丝发硬。",
