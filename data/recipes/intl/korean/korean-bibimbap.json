  "equipment": [
    "石锅或厚底锅",
    "平底锅",
    "小碗",
    "刀",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜与豆芽分别焯水后挤干，各加少许盐、香油与蒜末拌匀。",
      "time_min": 10,
      "heat": "中火",
      "tip": "焯好后立刻过凉水，颜色才翠绿。",
      "visual_cue": "蔬菜翠绿，挤干后不滴水"
    },
    {
      "n": 2,
      "text": "胡萝卜丝与口蘑片分别用少油快炒至断生，撒一点盐调味。",
      "time_min": 8,
      "heat": "中火",
      "tip": "分开炒是为了保留各自颜色和口感。",
      "visual_cue": "胡萝卜丝橙亮，口蘑片软而不出水"
    },
    {
      "n": 3,
      "text": "牛肉末加生抽、白糖、蒜末与香油抓匀，腌十分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "牛肉末先腌后炒，酱香才进得去。",
      "visual_cue": "肉末颜色变深，手感黏滑"
    },
    {
      "n": 4,
      "text": "平底锅下植物油炒散牛肉末，炒到水分收干、颗粒分明。",
      "time_min": 6,
      "heat": "中火",
      "tip": "炒到出油才有焦香，别急着盛出。",
      "visual_cue": "肉末散开，锅底泛油光"
    },
    {
      "n": 5,
      "text": "石锅内壁刷一层香油，铺入温热米饭压平，中小火烧到底部结锅巴。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "锅先刷油再放饭，锅巴才不粘底。",
      "visual_cue": "锅边有滋滋声，飘出焦香"
    },
    {
      "n": 6,
      "text": "把蔬菜与牛肉末按颜色分区摆在饭上，中央打一枚煎蛋。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "分区摆放不仅好看，拌开前也能各尝一口。",
      "visual_cue": "颜色分明，蛋黄金黄"
    },
    {
      "n": 7,
      "text": "把辣椒粉、香油、生抽与白糖调成拌饭酱，撒紫菜丝与芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱料现调现拌，香气最足。",
      "visual_cue": "酱色红亮，表面撒满芝麻"
    }
  ],
  "tips": [
    "米饭用偏干的口感更好，湿饭容易拌成糊。",
    "石锅要烧到锅巴脆响再关火，声音就是熟成的信号。",
    "拌饭酱按口味调整辣椒粉用量，别一次全倒。"
  ],
  "common_mistakes": [
    "蔬菜焯水后没挤干，拌饭出水变成一锅粥。",
    "石锅没刷油就放饭，锅巴粘底铲不下来。",
    "鸡蛋煎得过老，拌开后没有润泽感。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "猪肉末",
      "ratio": "150 克:150 克",
      "note": "炒制时加少许黑胡椒去腥。"
    },
    {
      "original": "菠菜",
      "substitute": "小油菜",
      "ratio": "150 克:180 克",
      "note": "焯水时间增加半分钟。"
    }
  ],
  "variations": [
    "加一勺辣白菜同拌，酸辣更过瘾。",
    "换成生牛肉配梨丝的版本，是韩国传统吃法。"
  ],
  "serving_suggestion": "连石锅端上桌，趁热把蛋黄拌开，配一碗清汤。",
  "storage": "冷藏两天；复热用平底锅小火干煎，恢复锅巴脆感。",
