  "equipment": [
    "汤锅",
    "大碗",
    "刀",
    "砧板",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐用纱布包住压十分钟，挤出多余水分。，看状态再决定下一步。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水挤不干，馅会稀得包不住。，看状态再决定下一步。",
      "visual_cue": "豆腐成块，手感发紧"
    },
    {
      "n": 2,
      "text": "猪前腿肉剁成细粒，加蒜末、生抽和盐抓匀。，看状态再决定下一步。",
      "time_min": 8,
      "heat": "无火",
      "tip": "剁得细一点，馅才抱团。，看状态再决定下一步。",
      "visual_cue": "肉糜发黏，颜色变深"
    },
    {
      "n": 3,
      "text": "韭菜和洋葱切末，拌入肉料和压碎的豆腐。，看状态再决定下一步。",
      "time_min": 6,
      "heat": "无火",
      "tip": "韭菜最后拌，才不出水。，看状态再决定下一步。",
      "visual_cue": "馅料湿润，菜末翠绿"
    },
    {
      "n": 4,
      "text": "淋香油拌匀，馅料放进冰箱冷藏十分钟。，看状态再决定下一步。",
      "time_min": 13,
      "heat": "无火",
      "tip": "冷藏定型，包的时候更好操作。，看状态再决定下一步。",
      "visual_cue": "馅料紧实，油光可见"
    },
    {
      "n": 5,
      "text": "取饺子皮放一勺馅，捏紧封口成月牙形。，看状态再决定下一步。",
      "time_min": 15,
      "heat": "无火",
      "tip": "封口抹一点水，捏得更牢。，看状态再决定下一步。",
      "visual_cue": "边褶均匀，皮薄馅足"
    },
    {
      "n": 6,
      "text": "汤锅倒清水烧开，下饺子煮到浮起。，看状态再决定下一步。",
      "time_min": 8,
      "heat": "大火",
      "tip": "下锅后轻推，别让饺子粘底。，看状态再决定下一步。",
      "visual_cue": "饺子浮面，皮色透亮"
    },
    {
      "n": 7,
      "text": "加一勺冷水再煮开，重复两次确保馅熟。，看状态再决定下一步。",
      "time_min": 6,
      "heat": "大火",
      "tip": "点水两次，皮不破馅也熟。，看状态再决定下一步。",
      "visual_cue": "饺子鼓起，汤色微白"
    },
    {
      "n": 8,
      "text": "鸡蛋摊成薄蛋皮切丝，撒在汤上配葱花。，看状态再决定下一步。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蛋皮切细丝，浮在汤面更好看。，看状态再决定下一步。",
      "visual_cue": "蛋丝金黄，葱花点缀"
    }
  ],
  "tips": [
    "豆腐一定要压干水分，馅才不散。，这一点很关键。",
    "包的时候封口抹点水，煮时不易开口。",
    "点两次冷水，饺子皮不破馅也熟透。"
  ],
  "common_mistakes": [
    "豆腐没压水，料稀得包不住。，这一点很关键。",
    "饺子下锅猛搅，全破在锅里。，这一点很关键。",
    "馅放太多，皮撑破煮成肉汤。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪前腿肉",
      "substitute": "牛肉馅",
      "ratio": "300 克:300 克",
      "note": "更瘦，需多加一勺香油。"
    },
    {
      "original": "韭菜",
      "substitute": "白菜",
      "ratio": "100 克:150 克",
      "note": "先撒盐杀水挤干。"
    }
  ],
  "variations": [
    "汤里加年糕片，做成饺子年糕汤。，这一点很关键。",
    "包成圆形大饺子，做成王饺子。，这一点很关键。"
  ],
  "serving_suggestion": "新年早晨吃一碗，配泡菜。，这一点很关键。",
  "storage": "生饺子冷冻两周，冷藏不超过一天；汤现做现喝。",
