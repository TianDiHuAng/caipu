  "equipment": [
    "砂锅",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛤蜊放入淡盐水浸泡 30 分钟吐沙，捞出用清水反复搓洗两遍。",
      "time_min": 33,
      "heat": "无火",
      "tip": "水里滴几滴香油，吐沙更快。",
      "visual_cue": "盆底沉有细沙、蛤蜊闭合"
    },
    {
      "n": 2,
      "text": "砂锅放 10ml 香油，小火炒香蒜末与 12g 辣椒粉约 1 分钟出红油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒粉极易糊，火要小。",
      "visual_cue": "油色变红、香气辛辣"
    },
    {
      "n": 3,
      "text": "倒入 500ml 清水煮开，下蛤蜊中火煮 3 分钟至开口。",
      "time_min": 5,
      "heat": "中火",
      "tip": "不开口的蛤蜊直接挑出丢弃。",
      "visual_cue": "蛤蜊壳张开、汤色微白"
    },
    {
      "n": 4,
      "text": "用勺子把嫩豆腐大块挖入锅中，加 4g 盐小火煮 4 分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "挖不要切，边缘不规则更挂汤。",
      "visual_cue": "豆腐浮起、汤面微滚"
    },
    {
      "n": 5,
      "text": "在中央打入鸡蛋，撒大葱，盖盖焖 1 分钟至蛋白凝固。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蛋黄留半熟，拌开更香。",
      "visual_cue": "蛋白凝固、蛋黄微微晃动"
    }
  ],
  "tips": [
    "嫩豆腐用挖的不用切，断面粗糙更吸汤。",
    "蛤蜊一定要吐净沙，否则整锅带腥味。",
    "砂锅保温好，上桌还在滚，小心烫口。"
  ],
  "common_mistakes": [
    "辣椒粉大火干炒，瞬间焦黑发苦。",
    "豆腐整块下锅久煮，碎成一锅豆花。",
    "鸡蛋煮到全熟，蛋黄发干失去滑润感。"
  ],
  "substitutions": [
    {
      "original": "蛤蜊",
      "substitute": "虾仁",
      "ratio": "200g 对 150g",
      "note": "虾仁煮 2 分钟即熟。"
    },
    {
      "original": "嫩豆腐",
      "substitute": "内酯豆腐",
      "ratio": "400g 对 400g",
      "note": "质地更软，挖块时轻些。"
    }
  ],
  "variations": [
    "猪肉版：先炒 80g 猪肉末再加水。",
    "海鲜版：加 100g 鱿鱼圈同煮。"
  ],
  "serving_suggestion": "连砂锅上桌，配一碗米饭和几碟小菜。",
  "storage": "现做现吃，不建议隔夜，豆腐会出水变味。",
