  "equipment": [
    "炒锅",
    "汤锅",
    "刀",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱、土豆、西葫芦都切成半厘米见方的小丁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丁要切得一样大，熟度才一致。",
      "visual_cue": "三种丁大小接近，切面平整"
    },
    {
      "n": 2,
      "text": "炒锅下植物油，小火把酱料炒两分钟至香味散出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酱要小火慢炒去生味，火大会立刻发苦。",
      "visual_cue": "酱色加深，油面泛亮"
    },
    {
      "n": 3,
      "text": "另起一锅下少许油，炒散猪肉末至变色出油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉末炒到微干，酱才不会腥。",
      "visual_cue": "肉末松散，边缘微焦"
    },
    {
      "n": 4,
      "text": "加蒜末与姜末炒出香味，再下洋葱丁翻炒到完全透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软后甜味才融进酱里。",
      "visual_cue": "洋葱透明，锅中香气浓"
    },
    {
      "n": 5,
      "text": "放入土豆丁与西葫芦丁翻炒三分钟，加生抽、白糖与盐。",
      "time_min": 4,
      "heat": "中火",
      "tip": "土豆先下锅，它最需要时间煮软。",
      "visual_cue": "蔬菜裹上酱色，微微出水"
    },
    {
      "n": 6,
      "text": "把炒好的酱倒回锅里，加水四百毫升煮开后转小火炖八分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "酱与水的比例决定浓稠度，太稀不挂面。",
      "visual_cue": "汤汁棕黑，蔬菜已软"
    },
    {
      "n": 7,
      "text": "土豆淀粉加水调开，淋入锅中勾芡至浓稠能挂勺。",
      "time_min": 3,
      "heat": "小火",
      "tip": "水淀粉要分两次淋，一次倒多会结块。",
      "visual_cue": "酱汁浓稠发亮，勺子挂糊"
    },
    {
      "n": 8,
      "text": "面条按包装煮至熟，过冷水沥干装碗，浇酱并配黄瓜丝。",
      "time_min": 8,
      "heat": "大火",
      "tip": "面过冷水才弹，拌的时候不容易断。",
      "visual_cue": "面条弹韧，酱汁覆盖表面"
    }
  ],
  "tips": [
    "酱要小火炒够时间，去掉生酱味是成败关键。",
    "勾芡后要再煮一分钟，芡汁才稳定不返稀。",
    "黄瓜丝最后放，脆感能解酱的厚重。"
  ],
  "common_mistakes": [
    "酱没炒透就加水，成品带着生酱的涩味。",
    "水淀粉一次性倒入，锅里结满小疙瘩。",
    "面条煮好不过冷水，拌的时候粘成一块。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "300 克:300 克",
      "note": "加五克糖补甜，风味更清爽。"
    },
    {
      "original": "土豆淀粉",
      "substitute": "玉米淀粉",
      "ratio": "15 克:15 克",
      "note": "芡汁更透亮，稠度略低。"
    }
  ],
  "variations": [
    "加虾仁与鱿鱼，做成海鲜炸酱面。",
    "把面条换成米饭，就是韩式炸酱饭。"
  ],
  "serving_suggestion": "装碗后铺黄瓜丝，配一碟黄色腌萝卜，趁热拌开吃。",
  "storage": "炸酱冷藏三天、冷冻一个月；面条现煮现吃，复热酱料须加少量水化开。",
