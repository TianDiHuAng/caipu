  "steps": [
    {
      "n": 1,
      "text": "五花肉放冰箱冷冻二十分钟再切，肉变硬后能切出均匀的薄片。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冻过的肉切片更薄更整齐，炒的时候受热均匀。",
      "visual_cue": "肉片薄透均匀，边缘整齐"
    },
    {
      "n": 2,
      "text": "切好的肉片放碗里，加辣椒粉、浓口酱油、白糖和一半蒜末抓匀腌十分钟。",
      "time_min": 13,
      "heat": "无火",
      "tip": "先腌十分钟让底味进去，炒出来才不是只有表面辣。",
      "visual_cue": "肉片裹满红褐色腌料，发黏"
    },
    {
      "n": 3,
      "text": "洋葱切丝，胡萝卜切丝，大葱切段，芝麻放干锅小火炒出香味备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "洋葱丝别切太细，炒久了会化在锅里没口感。",
      "visual_cue": "洋葱丝弯曲散开，芝麻微鼓"
    },
    {
      "n": 4,
      "text": "小碗里把韩式辣椒酱加清水调开，再加香油搅匀成流动的酱汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "辣椒酱太稠直接下锅会结块，先用清水调开。",
      "visual_cue": "酱汁顺滑流动，颜色深红"
    },
    {
      "n": 5,
      "text": "炒锅烧热倒植物油，中火下五花肉片平铺煎三分钟，逼出多余油脂。",
      "time_min": 5,
      "heat": "中火",
      "tip": "五花肉先煎出油，后面炒酱才不腻，油还能炒蔬菜。",
      "visual_cue": "肉片边缘卷起，锅底见油"
    },
    {
      "n": 6,
      "text": "加剩余蒜末和洋葱丝大火翻炒两分钟，炒到洋葱微软透出甜味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "洋葱吸收猪油后特别香，这一步别省。",
      "visual_cue": "洋葱微软透明，蒜香冲鼻"
    },
    {
      "n": 7,
      "text": "倒入调好的辣椒酱汁和胡萝卜丝，中火翻炒两分钟收浓酱汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酱汁收浓才挂得住肉片和饭，太稀就成了一碗汤。",
      "visual_cue": "酱汁浓稠发亮，裹住每片肉"
    },
    {
      "n": 8,
      "text": "撒大葱段翻两下关火，连肉带酱浇在热米饭上，撒芝麻趁热吃。",
      "time_min": 3,
      "heat": "中火",
      "tip": "大葱最后放，靠余温烫软，脆甜解腻。",
      "visual_cue": "肉片油亮，酱汁渗入饭粒"
    }
  ],
  "tips": [
    "五花肉先冷冻二十分钟再切，能切出又薄又匀的片，炒的时候受热一致不夹生。",
    "肉片要先腌十分钟再炒，底味进去了才有层次。直接下锅炒再拌酱，只有表面辣。",
    "五花肉要中火煎出油脂再加蔬菜，这样整锅不腻，蔬菜也带着猪油香。",
    "酱汁里加清水调开再下锅，辣椒酱本身很稠，不稀释会结块糊底。"
  ],
  "common_mistakes": [
    "五花肉直接切，厚薄不匀有的生有的老。要先冻硬再切。",
    "肉片不腌直接炒，只有表面一层辣。要先腌十分钟。",
    "辣椒酱不调水直接下锅，结块糊底发苦。要先用清水调开。",
    "酱汁不收浓就浇饭，饭粒泡软发糊。要收到能挂住肉片。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "梅花肉",
      "ratio": "320克:320克",
      "note": "脂肪更少，需多加五毫升油防粘。"
    },
    {
      "original": "韩式辣椒酱",
      "substitute": "辣椒粉加韩式大酱",
      "ratio": "35克:12克加15克",
      "note": "辣味更沉，发酵香更重。"
    }
  ],
  "variations": [
    "加一把泡菜同炒，酸辣味更立体，是韩国上班族的常见做法。",
    "把米饭换成紫菜饭卷用的调味饭，做成辣猪肉饭团更便携。",
    "加一片煎蛋盖在饭上，蛋黄拌进酱汁里，口感更顺滑。"
  ],
  "serving_suggestion": "一大碗端上来，粉红的五花肉片堆在白饭上，油亮的酱汁慢慢渗进饭里，一口下去辣中带甜，肥而不腻。",
  "storage": "冷藏可放一天，复热用炒锅小火加两勺水焖三分钟；米饭隔夜会吸干酱汁，需补少量水。",
