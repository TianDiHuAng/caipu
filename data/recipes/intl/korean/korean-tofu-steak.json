    "total_min": 25
  },
  "servings": 2,
  "flavor": [
    "savory",
    "salty",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 500,
          "unit": "g",
          "note": "老豆腐，切一厘米厚片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "打散成蛋液",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 40,
          "unit": "g",
          "note": "薄薄裹一层",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "煎制用",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "蘸汁基底",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 8,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 5,
          "unit": "g",
          "note": "炒香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "盘子",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成一厘米厚的片，平铺在厨房纸上，上面再压一层吸水十分钟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "上下都垫纸吸水，豆腐片才够干，裹粉时不会糊成一团。",
      "visual_cue": "豆腐片表面干爽，形状挺立不变形。"
    },
    {
      "n": 2,
      "text": "鸡蛋打进浅盘打散，面粉倒在另一个盘里，两样都摊开备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "用浅盘裹料，豆腐片能整片按进去，比碗里操作干净。",
      "visual_cue": "蛋液均匀无蛋筋，面粉铺成薄层。"
    },
    {
      "n": 3,
      "text": "豆腐片先两面沾满面粉并抖掉多余粉末，再整片按进蛋液裹匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "面粉只留薄薄一层，太厚煎出来会有干粉的涩口感。",
      "visual_cue": "豆腐片表面均匀挂粉，没有干粉结块。"
    },
    {
      "n": 4,
      "text": "平底锅倒植物油烧到六成热，逐片下豆腐，中小火煎三分钟。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "下锅后先别动，等蛋液凝固定型再翻面，皮才完整。",
      "visual_cue": "底面金黄定型，边缘蛋液凝固。"
    },
    {
      "n": 5,
      "text": "翻面再煎两分钟到两面金黄，取出沥油，单层平铺在盘中。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "出锅别叠放，热气散不出去外皮很快回软。",
      "visual_cue": "两面金黄色泽均匀，表面无油滴。"
    },
    {
      "n": 6,
      "text": "生抽、蒜末、葱花和白芝麻调成蘸汁，配豆腐排一起上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蘸汁提前十分钟调好，蒜香有时间渗进酱油里。",
      "visual_cue": "蘸汁清亮，葱花浮在表面。"
    }
  ],
  "tips": [
    "豆腐片先用厨房纸压干，裹粉才粘得牢，煎的时候不脱壳。",
    "蛋液裹完立刻下锅，放久了会淌下来，锅底变成炒蛋。",
    "蘸汁提前调好，煎好的豆腐趁热蘸，咸鲜味才吸得进去。"
  ],
  "common_mistakes": [
    "豆腐切得太薄，裹粉煎完硬得像饼干，完全失去嫩芯。",
    "油温太低就把豆腐下锅，蛋液顺着豆腐滑进油里，豆腐脱壳。",
    "煎好堆成一摞等上桌，水汽闷在中间，外皮全软掉。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "压碎的脆谷片",
      "ratio": "40克:45克",
      "note": "外皮更脆，粘附力稍弱，按压时要轻。"
    },
    {
      "original": "生抽",
      "substitute": "淡酱油",
      "ratio": "20毫升:22毫升",
      "note": "颜色更浅，咸度略低。"
    }
  ],
  "variations": [
    "蘸汁里加一勺辣椒碎和半勺果醋，酸辣带劲，是庆尚道的吃法。",
    "把豆腐换成南瓜厚片，同样裹粉裹蛋煎，甜味更明显。"
  ],
  "serving_suggestion": "煎好的豆腐排单层平铺装盘，撒白芝麻和葱花，配一小碗蘸汁和小菜一起上桌。",
  "storage": "冷藏可放一天，回锅用平底锅无油小火两面各烘一分钟，微波会让外皮变韧。",
  "nutrition_estimate": {
    "basis": "按两人份估算",
    "calories_kcal": 380,
    "protein_g": 24,
    "fat_g": 26,
    "carbs_g": 14,
