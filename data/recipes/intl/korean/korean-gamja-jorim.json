    "刀",
    "砧板",
    "铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆削皮切成三厘米的滚刀块，切好后泡进清水里十分钟洗掉表面淀粉。",
      "time_min": 14,
      "heat": "无火",
      "tip": "洗掉表层淀粉，煎的时候才不会粘锅发糊。",
      "visual_cue": "土豆块棱角分明，水色微微发白"
    },
    {
      "n": 2,
      "text": "捞出土豆块用厨房纸吸干表面水分，湿的土豆下锅会溅油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "土豆表面带水下油锅会剧烈爆油，很容易烫到手，必须擦干。",
      "visual_cue": "土豆块表面干爽，不见水光"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，土豆块平铺下锅中火煎五分钟，一面金黄再翻面。",
      "time_min": 7,
      "heat": "中火",
      "tip": "先煎出焦壳，土豆才不会煮散，还能锁住甜味。",
      "visual_cue": "土豆块边缘金黄，散出焦香"
    },
    {
      "n": 4,
      "text": "加蒜片和小米辣圈炒香，辣味和蒜香借锅里的油一起爆出来。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蒜片下锅别离开，十几秒就焦，焦了整锅发苦。",
      "visual_cue": "蒜片微黄不焦，辣香冲鼻"
    },
    {
      "n": 5,
      "text": "倒入浓口酱油和白糖翻匀，再撒辣椒粉，让每块土豆都裹上酱色。",
      "time_min": 2,
      "heat": "中火",
      "tip": "沿锅边淋酱油，香气才激出来，直接浇中间会糊。",
      "visual_cue": "土豆块通体酱红，锅底泛油光"
    },
    {
      "n": 6,
      "text": "加清水没过土豆一半，大火烧开后转中小火加盖焖十二分钟。",
      "time_min": 14,
      "heat": "中小火",
      "tip": "水不要多，没过一半正好，收汁才浓不稀。",
      "visual_cue": "汤汁微沸起泡，土豆边角变软"
    },
    {
      "n": 7,
      "text": "开盖转大火收汁，边收边翻动，汤汁浓到能挂住土豆块就关火。",
      "time_min": 5,
      "heat": "大火",
      "tip": "收汁要不停翻，糖分高的汁容易糊底发苦。",
      "visual_cue": "汤汁浓亮挂块，锅底沙沙作响"
    },
    {
      "n": 8,
      "text": "淋香油、撒辣椒粉和芝麻葱花，装盘时把酱汁浇在上面，热吃最香。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香油一定要关火之后再淋，高温会把香油的香气全部挥发掉。",
      "visual_cue": "土豆油亮，葱花芝麻撒放均匀"
    }
  ],
  "tips": [
    "土豆块切好后要泡水洗掉表面淀粉再吸干水分，这样煎的时候不粘锅、不溅油。",
    "土豆先煎出金黄焦壳再加酱油焖。直接下锅煮，土豆容易散成泥，也没有焦香。",
    "加水只要没过土豆一半，中小火焖十二分钟，再大火收汁。水加多了收不干，味道就淡。",
    "收汁阶段要一直翻动，酱汁里糖分高，一停手就糊底。看到汤汁能挂住土豆就该关火。"
  ],
  "common_mistakes": [
    "土豆表面带水下锅，油花四溅还粘锅。要吸干水分再煎。",
    "土豆不煎直接煮，散成泥还不香。要先煎出焦壳。",
    "水加太多收不干，味道发淡。水到土豆一半就够。",
    "收汁不翻动，糖分焦化糊底，整锅发苦。要边收边翻。"
  ],
  "substitutions": [
    {
      "original": "浓口酱油",
      "substitute": "生抽",
      "ratio": "30毫升:28毫升",
      "note": "咸味略轻，颜色偏浅，可补半克盐。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "12克:14克",
      "note": "甜味更柔和，需在收汁后期加入避免焦化。"
    }
  ],
  "variations": [
    "加一把小鱼干同焖，海味渗进土豆，是韩式家常饭桌的常客。",
    "把土豆换成小土豆整颗焖，皮不用削，咬着更绵密。",
    "加两片洋葱和一根青椒同焖，甜味和清香更丰富，是釜山家庭做法。"
  ],
  "serving_suggestion": "土豆块裹着红亮酱汁，咬着外有焦香、内里绵软，甜咸里带一丝辣，最下饭的一道家常小菜。",
  "storage": "冷藏可放三天，复热用锅小火加两勺水焖三分钟；土豆隔夜会吸干酱汁，需补少量水。",
