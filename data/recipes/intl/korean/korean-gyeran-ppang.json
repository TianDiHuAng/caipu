  "equipment": [
    "烤箱",
    "布丁杯",
    "搅拌盆",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶温热到不烫手，加酵母与一小勺白糖拌匀静置五分钟。",
      "time_min": 7,
      "heat": "无火",
      "tip": "牛奶太烫会把酵母烫死，摸着温温的正好。",
      "visual_cue": "表面浮起一层细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉过筛进大盆里，加剩下的白糖与盐拌匀备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面粉过筛后组织更松，烤出来成品才不会发硬。",
      "visual_cue": "粉体蓬松细腻，颜色均匀"
    },
    {
      "n": 3,
      "text": "倒入酵母奶液与融化的黄油，搅成没有干粉的浓稠面糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面糊比普通面团稀得多，能缓慢流下就对了。",
      "visual_cue": "面糊顺滑有光泽，刮刀挑起缓慢滑落"
    },
    {
      "n": 4,
      "text": "盖湿布室温发酵一小时，体积涨到原来的一点五倍。",
      "time_min": 60,
      "heat": "无火",
      "tip": "温度低时延长发酵，看体积不看时间。",
      "visual_cue": "表面布满气泡，体积明显膨起"
    },
    {
      "n": 5,
      "text": "面糊拌入玉米粒、奶酪丁与胡萝卜碎，轻轻翻匀排气。",
      "time_min": 4,
      "heat": "无火",
      "tip": "翻拌十下左右就够，排气过度会发硬。",
      "visual_cue": "配料分布均匀，面糊体积略有回缩"
    },
    {
      "n": 6,
      "text": "面糊分装进布丁杯到六分满，每杯中间磕入一个鸡蛋。",
      "time_min": 6,
      "heat": "无火",
      "tip": "只装六分满，给蛋和面糊留出膨胀空间。",
      "visual_cue": "蛋黄居中，面糊包住蛋的四周"
    },
    {
      "n": 7,
      "text": "撒一点盐与欧芹，一百八十度烤二十分钟到面团鼓起、蛋液熟透。",
      "time_min": 22,
      "heat": "无火",
      "tip": "烤到表面金黄、轻压有弹性就是好了。",
      "visual_cue": "面团膨起包住整个鸡蛋，表面金黄发亮"
    }
  ],
  "tips": [
    "鸡蛋磕入前先在杯里挖个小坑，蛋黄才不会跑偏。",
    "加一点培根碎，咸香更像韩国的街边口味。",
    "趁热吃最好，凉了成品会失去松软感。",
    "剩下的成品密封冷冻，复烤六分钟即可。"
  ],
  "common_mistakes": [
    "蛋黄磕破混进面糊，成品看不出整颗蛋的效果。",
    "面糊装太满，烤的时候溢到杯外焦成硬边。",
    "烤的时间不够，切开蛋黄还在流动没有凝固。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "150毫升:140毫升",
      "note": "奶香减弱，需要多加五克黄油。"
    },
    {
      "original": "奶酪",
      "substitute": "培根",
      "ratio": "40克:50克",
      "note": "咸香更突出，先煎出油再用。"
    }
  ],
  "variations": [
    "撒一点辣椒粉与葱花，做成咸口版本。",
    "面糊里加可可粉，做成巧克力底的甜版本。"
  ],
  "serving_suggestion": "趁热当早餐或下午点心，配一杯牛奶或美式咖啡都合适。",
  "storage": "冷藏可放两天，冷冻两周，复烤后基本恢复松软。",
