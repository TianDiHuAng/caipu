  "equipment": [
    "深锅",
    "砧板",
    "木勺",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿剁成四厘米大小的块，用清水冲洗两遍去掉血水后沥干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冲掉血水，焖出来的汤汁才不会发浑发腥。",
      "visual_cue": "鸡块颜色发白，盆底水清澈不泛红"
    },
    {
      "n": 2,
      "text": "红薯粉条用温水泡二十分钟，泡到能用指甲掐断。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡到半软就够，泡过头下锅一煮就烂。",
      "visual_cue": "粉条柔软可弯折，中心没有硬芯"
    },
    {
      "n": 3,
      "text": "深锅烧热植物油，下鸡块中火煸炒到表面变白收紧。",
      "time_min": 8,
      "heat": "中火",
      "tip": "先煸出鸡皮里的油，后面焖出来才不腻。",
      "visual_cue": "鸡皮微黄，锅底渗出清亮的鸡油"
    },
    {
      "n": 4,
      "text": "放蒜、姜、洋葱与胡萝卜翻炒两分钟，炒出香味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软后甜味会融进汤里，别省这一步。",
      "visual_cue": "洋葱透明，胡萝卜表面泛油光"
    },
    {
      "n": 5,
      "text": "加生抽、白糖与清水，大火烧开后转小火焖二十分钟。",
      "time_min": 23,
      "heat": "大火",
      "tip": "水量刚没过鸡块就够，倒太多最后收不干。",
      "visual_cue": "汤汁翻滚，鸡块大半浸在酱色汤里"
    },
    {
      "n": 6,
      "text": "放入泡软的粉条与香菇，继续小火焖八分钟到入味。",
      "time_min": 9,
      "heat": "小火",
      "tip": "粉条吸汤很快，最后几分钟要盯着别糊底。",
      "visual_cue": "粉条变成酱褐色，锅里的汤汁明显变少"
    },
    {
      "n": 7,
      "text": "转大火收汁，淋蜂蜜与芝麻油翻匀，撒黑胡椒、葱花与白芝麻出锅。",
      "time_min": 5,
      "heat": "大火",
      "tip": "蜂蜜最后加，早放容易在锅底烧焦发苦。",
      "visual_cue": "汤汁浓亮裹住鸡块，盘底不见流动液体"
    }
  ],
  "tips": [
    "加几个煮熟的鸡蛋一起焖，吸满酱汁特别好吃。",
    "生抽咸度不同，收汁前尝一下再决定要不要补盐。",
    "用整鸡剁块也行，焖的时间要多五分钟。",
    "剩的汤汁拌面条，比任何酱料都香。"
  ],
  "common_mistakes": [
    "鸡块没沥干就下锅，煸出一锅水变成煮鸡。",
    "粉条泡得太软再焖，出锅全断成小段。",
    "大火收汁时走开没看锅，糖分烧出焦苦味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡翅",
      "ratio": "800克:800克",
      "note": "焖的时间缩短三分钟。"
    },
    {
      "original": "红薯粉条",
      "substitute": "年糕",
      "ratio": "80克:100克",
      "note": "口感更弹，需要多焖两分钟。"
    }
  ],
  "variations": [
    "加一把干辣椒一起焖，甜味里带一点微辣。",
    "用酱油减半、加一勺大酱，风味更厚重。"
  ],
  "serving_suggestion": "连汤带粉条盛进深盘，配一碗白米饭最合适。",
  "storage": "冷藏可放三天，粉条会吸干汤汁，复热时补两勺水。",
