  "steps": [
    {
      "n": 1,
      "text": "泡菜挤掉多余汁水后切碎，汁水留两勺备用，米饭用手抓散成粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡菜汁是炒饭的灵魂，别全挤掉，这一步决定了成品的口感。",
      "visual_cue": "饭粒松散，泡菜碎干爽，锅面和食材状态一目了然"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧热，下泡菜碎中火炒三分钟，炒出酸香和红油。",
      "time_min": 5,
      "heat": "中火",
      "tip": "泡菜要炒出红油，酸味变柔和，饭才好吃，这一步决定了成品的口感。",
      "visual_cue": "锅内泛红，酸香扑鼻，颜色与质地变化清楚可见"
    },
    {
      "n": 3,
      "text": "加韩式辣椒酱翻炒半分钟，让酱和泡菜混匀，锅底呈深红色。",
      "time_min": 2,
      "heat": "中火",
      "tip": "辣椒酱容易糊底，火别大，快翻几下就够，这一步决定了成品的口感。",
      "visual_cue": "酱色浓重，锅底泛亮，香气和声音能说明进度"
    },
    {
      "n": 4,
      "text": "倒入米饭大火翻炒四分钟，用铲子压散结块，让每粒饭都裹上红酱。",
      "time_min": 5,
      "heat": "大火",
      "tip": "压炒结合，饭粒才散得开又不粘锅，这一步决定了成品的口感。",
      "visual_cue": "饭粒红亮，颗颗分明，整体火候状态清楚好判断"
    },
    {
      "n": 5,
      "text": "淋生抽和泡菜汁继续炒一分钟，最后淋芝麻油，撒葱花翻匀关火。",
      "time_min": 3,
      "heat": "大火",
      "tip": "泡菜汁带咸味，生抽少放，先尝再补，这一步决定了成品的口感。",
      "visual_cue": "饭粒油亮，香气四溢，表面变化看得出来已到位"
    },
    {
      "n": 6,
      "text": "另起锅煎两个溏心蛋，把炒饭盛进碗里扣成圆顶，盖上蛋撒紫菜芝麻。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蛋黄半熟最好拌饭，煎过头就拌不开了，这一步决定了成品的口感。",
      "visual_cue": "蛋面白净，蛋黄晃荡，汤汁和食材状态清楚到位"
    }
  ],
  "tips": [
    "冷饭要放冰箱冷藏过夜，水分少才炒得散，现煮的饭黏成一坨。",
    "泡菜越酸越适合炒饭，发酵到位的老泡菜酸香浓，炒出来才够味。",
    "炒饭火要大，锅要热，饭下锅后不停翻炒，一分钟内把水汽炒干。",
    "芝麻油一定要最后关火前淋，早放会被高温炒出苦味。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭炒，饭粒黏在一起压不散，最后炒成一锅粥。",
    "泡菜汁全挤干扔掉，炒饭只有咸味，缺少那股发酵的酸香。",
    "小火慢慢翻，饭吸油发腻，锅底还结一层焦黑的酱块。"
  ],
  "substitutions": [
    {
      "original": "泡菜",
      "substitute": "酸菜",
      "ratio": "200克:200克",
      "note": "酸菜版需多加五克白糖平衡酸味。"
    },
    {
      "original": "韩式辣椒酱",
      "substitute": "辣椒粉",
      "ratio": "15克:8克",
      "note": "辣椒粉不上色，可加一点生抽补色。"
    }
  ],
  "variations": [
    "加一把切片的午餐肉同炒，就是韩国小馆里的豪华版泡菜炒饭。",
    "顶部铺一层马苏里拉烤到融化，做成芝士泡菜炒饭，拉丝又解辣。"
  ],
  "serving_suggestion": "扣成圆顶盛盘，盖一个溏心蛋，配一碗紫菜汤或泡菜汤，是韩国人的深夜标配。",
  "storage": "冷藏可放一天，回热用平底锅干炒两分钟，微波会让饭粒变硬。",
