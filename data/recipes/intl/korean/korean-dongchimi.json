    "砧板",
    "纱布",
    "干净石块"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白萝卜刷洗干净不去皮，切成四厘米长的粗条，粗的再对半切开。",
      "time_min": 8,
      "heat": "无火",
      "tip": "萝卜不去皮才够脆，削了皮泡两天就软塌塌的没有咬劲。",
      "visual_cue": "萝卜条粗细一致，皮色完整"
    },
    {
      "n": 2,
      "text": "大白菜掰成大片，与一半盐一起抓匀，静置二十分钟至叶片出水变软。",
      "time_min": 20,
      "heat": "无火",
      "tip": "菜叶只腌到打蔫就行，腌太久会失去脆感，泡出来发烂。",
      "visual_cue": "菜叶变软出水，盆底有盐水"
    },
    {
      "n": 3,
      "text": "清水加剩下的盐与白糖煮沸，搅到完全化开，晾到彻底凉透。",
      "time_min": 10,
      "heat": "中火",
      "tip": "卤水必须凉透再倒进坛里，热汤会把菜烫熟，泡出来一股烂菜味。",
      "visual_cue": "卤水清澈，尝着微咸带甜"
    },
    {
      "n": 4,
      "text": "腌好的萝卜与大白菜挤干水分装进陶罐，放蒜片、姜丝与辣椒粉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "菜要层层压实不留空隙，空隙里存空气容易长白膜发臭。",
      "visual_cue": "菜料压实，调料分布均匀"
    },
    {
      "n": 5,
      "text": "倒入凉透的卤水没过菜面，压上干净石块，盖纱布放阴凉处发酵两天。",
      "time_min": 7,
      "heat": "无火",
      "tip": "室温二十度左右两天就够，天热一天半，尝着冒气泡的酸味就成。",
      "visual_cue": "卤水微浑冒小泡，闻着清爽酸香"
    }
  ],
  "tips": [
    "水泡菜是韩国冬天配烤肉的解腻小菜，卤水冰镇后当饮料喝也很爽口。",
    "坛口不要密封死，发酵会产气，留一条缝让气体跑出去，免得坛子胀裂。",
    "取菜一定用干净无油的筷子，沾了油整坛会起白膜烂掉。"
  ],
  "common_mistakes": [
    "卤水没晾凉就倒进坛子，菜叶被烫软，两天后整坛发黏发臭。",
    "盐放太少想靠时间长一点补，结果杂菌先长起来，白膜盖满坛口。",
    "坛子放在暖气边发酵，温度太高，菜心发空还带一股馊味。"
  ],
  "substitutions": [
    {
      "original": "白萝卜",
      "substitute": "青萝卜",
      "ratio": "600克:600克",
      "note": "青萝卜辣味重，糖可多加五克平衡。"
    },
    {
      "original": "大白菜",
      "substitute": "娃娃菜",
      "ratio": "200克:200克",
      "note": "娃娃菜叶薄，腌制时间缩短到十分钟。"
    }
  ],
  "variations": [
    "加几只整梨同泡，卤水带果甜，是韩国秋冬的常见做法。",
    "放几段葱白与一小块昆布同泡，鲜味更厚，汤可以直接喝。"
  ],
  "serving_suggestion": "用小碗连卤水一起上桌，配烤肉或白切肉，一口肉一口冰卤水最解腻。",
  "storage": "冷藏可存两周，越泡越酸；卤水变浑发黏或起白膜须整坛丢弃。",
