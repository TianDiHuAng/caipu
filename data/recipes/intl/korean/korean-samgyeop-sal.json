  "equipment": [
    "铸铁煎锅",
    "夹子",
    "剪刀",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成三毫米厚的片，用厨房纸吸干表面水分，冷藏静置十分钟定形。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面越干越容易上色，带水入锅只会白煮。",
      "visual_cue": "肉片表面干爽，指按不留水印。"
    },
    {
      "n": 2,
      "text": "梨磨成细泥，与生抽、白糖、香油、黑胡椒和盐调成刷肉汁备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "梨泥里的果酸能软化肉纤维，别省这一勺。",
      "visual_cue": "汁液呈浅褐色，稠度像稀糖浆。"
    },
    {
      "n": 3,
      "text": "铸铁煎锅烧到微微冒烟，肉片平铺下锅，中大火煎两分钟不要翻动。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "锅一定要烧透，冷锅下肉会粘底又出水。",
      "visual_cue": "肉片边缘卷起，底面焦黄出油。"
    },
    {
      "n": 4,
      "text": "翻面再煎一分半，边缘焦脆时用剪刀剪成小块，刷一层刷肉汁。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "剪小块再煎一次，肥肉里的油才逼得出来。",
      "visual_cue": "剪口处油脂沸腾，肉块缩成厚实小方。"
    },
    {
      "n": 5,
      "text": "生菜与大白菜叶洗净撕成掌心大小，大葱切细丝泡冷水去掉辛辣。",
      "time_min": 6,
      "heat": "无火",
      "tip": "大葱丝泡过冷水会自然打卷，包肉更服帖。",
      "visual_cue": "菜叶透亮挺立，葱丝卷成圈。"
    },
    {
      "n": 6,
      "text": "韩式辣椒酱拌上大蒜片、芝麻和葱丝，肉块蘸酱包进菜叶里趁热吃。",
      "time_min": 4,
      "heat": "无火",
      "tip": "包一口吃一口，放久了菜叶出水就失了脆劲。",
      "visual_cue": "酱色红润裹住肉块，菜叶翠绿不塌。"
    }
  ],
  "tips": [
    "五花肉冷藏半小时再切，厚薄最容易匀，三毫米最合适。",
    "煎出的猪油别倒，用来煎泡菜或大蒜片，香味能再上一层。",
    "一次只铺一层肉，挤在一起会变成水煮，出不了焦壳。"
  ],
  "common_mistakes": [
    "肉片切太厚，表面焦了里面还生，嚼起来发韧。",
    "锅没烧透就下肉，粘底翻不动，肉片被撕成碎条。",
    "全程大火猛烧，油脂烧焦发苦，整锅都带糊味。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "梅花肉",
      "ratio": "1:1",
      "note": "梅花肉瘦多油少，煎的时间缩短半分钟，别煎老。"
    },
    {
      "original": "梨",
      "substitute": "洋葱",
      "ratio": "1:2",
      "note": "洋葱泥水分多，刷肉汁要少放五毫升生抽。"
    }
  ],
  "variations": [
    "济州岛吃法用粗盐和香油调成油盐碟，不加辣酱，专吃肉的本味。",
    "店家常把泡菜铺在锅边同煎，酸辣汁水淋在肉上，解腻又提味。"
  ],
  "serving_suggestion": "肉刚离锅最香，配蒜片、葱丝和辣酱包进菜叶，一口一个吃法最地道。",
  "storage": "煎好的肉冷藏一日内吃完，复热用平底锅小火回煎两分钟，别用蒸锅。",
