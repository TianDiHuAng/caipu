  "steps": [
    {
      "n": 1,
      "text": "牛肉剁成细碎肉粒，洋葱与大葱切成细末，大蒜压成泥，分三个小碗装好。",
      "time_min": 10,
      "heat": "无火",
      "tip": "牛肉碎剁得越细越黏，饼才不散，别用绞肉机打太烂。",
      "visual_cue": "牛肉碎起黏拉丝，洋葱末透明多汁。"
    },
    {
      "n": 2,
      "text": "牛肉碎加生抽、白糖、蒜泥、洋葱末、黑胡椒和香油，顺同一方向搅到上劲。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一个方向搅打，牛肉碎才抱团，翻面时不会裂。",
      "visual_cue": "牛肉碎发亮起胶，按下去能弹回。"
    },
    {
      "n": 3,
      "text": "牛肉碎分成六份，先裹玉米淀粉，再蘸鸡蛋液，最后压上面包糠成厚饼。",
      "time_min": 10,
      "heat": "无火",
      "tip": "饼压半厘米厚最合适，太厚外面焦了里面还生。",
      "visual_cue": "饼面均匀挂满糠粒，边缘整齐不散。"
    },
    {
      "n": 4,
      "text": "平底锅刷一层植物油，中火煎三分钟至底面金黄，翻面再煎两分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅后别急着动，等底面结壳再翻才完整。",
      "visual_cue": "两面金黄酥壳，按下去有弹性。"
    },
    {
      "n": 5,
      "text": "年糕用清水泡软，与清水、剩余生抽和蜂蜜下锅，小火煮五分钟至汁发亮。",
      "time_min": 8,
      "heat": "小火",
      "tip": "年糕先泡软再煮，才不会有硬芯。",
      "visual_cue": "年糕变软弯折不断，汤汁浓稠挂勺。"
    },
    {
      "n": 6,
      "text": "煎好的肉饼放进年糕汁里滚一圈，撒芝麻和大葱丝，连汁一起盛盘。",
      "time_min": 4,
      "heat": "小火",
      "tip": "肉饼只在汁里滚一圈，久煮酥壳就泡软了。",
      "visual_cue": "饼面裹上亮汁，年糕透亮有光泽。"
    }
  ],
  "tips": [
    "牛肉选带一点脂肪的部位，纯瘦肉做出来发干，口感差一截。",
    "肉馅里加一勺洋葱汁，比加水更能保住嫩度。",
    "年糕汁收到能挂勺就关火，收过头会结成硬块。"
  ],
  "common_mistakes": [
    "肉馅没搅上劲就下锅，煎时裂开散成碎肉。",
    "油温太低就下饼，面包糠吸油发腻，外壳不脆。",
    "年糕没泡直接煮，外软内硬，咬开有生芯。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "猪肉",
      "ratio": "1:1",
      "note": "猪肉馅油脂多，香油减到五毫升，煎时少放油。"
    },
    {
      "original": "面包糠",
      "substitute": "玉米淀粉",
      "ratio": "1:1.5",
      "note": "全用淀粉外壳更薄脆，但容易脱落，需现裹现煎。"
    }
  ],
  "variations": [
    "光州版本把肉饼做得更薄更大，几乎和手掌同宽，配生菜包着吃。",
    "有的家庭在年糕汁里加一勺辣椒酱，甜辣口味更下饭。"
  ],
  "serving_suggestion": "肉饼与年糕同盘上桌，趁热吃外壳最脆，剩下的酱汁拌饭正好。",
  "storage": "生肉饼可冷冻一周，煎好的冷藏两日，复热用平底锅小火回煎。",
