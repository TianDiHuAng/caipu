  "equipment": [
    "保鲜盒",
    "碗",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "紫苏叶逐张摘下洗净，放入淡盐水中浸泡 10 分钟去除虫卵与灰尘。",
      "time_min": 12,
      "heat": "无火",
      "tip": "叶背绒毛最容易藏污，正反都要冲。",
      "visual_cue": "叶片完整、水色微浑"
    },
    {
      "n": 2,
      "text": "捞出沥干水分，摊在厨房纸上吸干，一定要完全干爽。",
      "time_min": 10,
      "heat": "无火",
      "tip": "带水腌会稀释酱汁并导致变质。",
      "visual_cue": "叶面无水珠、手感干爽"
    },
    {
      "n": 3,
      "text": "洋葱切末、大蒜切末、大葱切碎，与 150ml 生抽、30g 白糖、20g 辣椒粉混合成腌汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱能提供自然甜味，别省略。",
      "visual_cue": "腌汁呈深红色、洋葱末均匀悬浮"
    },
    {
      "n": 4,
      "text": "保鲜盒底部先铺一层腌汁，放一张紫苏叶后用刷子均匀刷上腌汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一张一张刷，每片才都入味。",
      "visual_cue": "叶片表面均匀挂上红色酱汁"
    },
    {
      "n": 5,
      "text": "重复刷汁叠放，全部叠好后把剩余腌汁浇在表面，压上重物盖盖。",
      "time_min": 5,
      "heat": "无火",
      "tip": "重物能让叶片紧实不出空隙。",
      "visual_cue": "叶片被压平、酱汁漫过边缘"
    },
    {
      "n": 6,
      "text": "室温腌 2 小时后转冷藏 24 小时，食用前淋 15ml 香油并撒 10g 熟白芝麻。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷藏越久越入味，三天后风味最佳。",
      "visual_cue": "叶片深褐透亮、酱汁减少三分之一"
    }
  ],
  "tips": [
    "紫苏叶必须彻底晾干，带水腌制容易发酸变质。",
    "腌汁要够咸，紫苏叶本身出水会稀释味道。",
    "取用时用干净筷子，避免污染整盒。"
  ],
  "common_mistakes": [
    "叶片没晾干就叠放，两天后表面起白沫。",
    "酱汁放太少，上面的叶片不入味发干。",
    "用细辣椒粉代替粗粉，成品糊成一团。"
  ],
  "substitutions": [
    {
      "original": "紫苏叶",
      "substitute": "芝麻叶",
      "ratio": "80 张对 80 张",
      "note": "韩式芝麻叶腌菜做法，风味更浓。"
    },
    {
      "original": "生抽",
      "substitute": "酱油加鱼露",
      "ratio": "150ml 对 120ml+30ml",
      "note": "鲜味更足，咸度需减少糖量。"
    }
  ],
  "variations": [
    "辣味加强版：辣椒粉增至 40g，并加 10g 韩式辣椒酱。",
    "不辣版：去掉辣椒粉，改加 20ml 梅子汁，酸甜清爽。"
  ],
  "serving_suggestion": "作为小菜配白米饭与烤肉，包着五花肉一起吃最经典。",
  "storage": "冷藏可存 3 周，取用需用干净筷子，酱汁可续腌第二批叶子。",
