  ],
  "equipment": [
    "砂锅",
    "打蛋器",
    "碗",
    "漏勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进大碗，加盐后用打蛋器朝一个方向搅到完全均匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅到看不见系带和蛋黄块，蒸出来才细腻。",
      "visual_cue": "蛋液均匀，表面起泡"
    },
    {
      "n": 2,
      "text": "倒入清水再搅匀，用漏勺过滤一遍去掉浮沫和杂质。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过滤这步别省，蒸出的蛋面才平滑如镜。",
      "visual_cue": "蛋液顺滑，无泡沫，状态稳定"
    },
    {
      "n": 3,
      "text": "蛋液倒进砂锅，只装到六分满，留出膨起的空间。",
      "time_min": 3,
      "heat": "无火",
      "tip": "装太满会溢出来，六分满刚好。，注意火候。",
      "visual_cue": "液面平整，留有空隙"
    },
    {
      "n": 4,
      "text": "砂锅放上小火，边加热边用勺子从锅底轻轻搅动防粘。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢加热，蛋液才不结块也不糊底。",
      "visual_cue": "蛋液微稠，锅底不粘"
    },
    {
      "n": 5,
      "text": "盖盖小火蒸八分钟，等蛋液膨起成布丁状就关火。",
      "time_min": 8,
      "heat": "小火",
      "tip": "盖盖后别开盖看，温度一掉就塌下去。",
      "visual_cue": "蛋面膨起，边缘微鼓"
    },
    {
      "n": 6,
      "text": "开盖淋香油，撒葱花和白芝麻，趁热连锅端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油最后淋，香气才够明显不闷。，注意火候。",
      "visual_cue": "表面油亮，葱花翠绿"
    }
  ],
  "tips": [
    "蛋液过滤一遍，蒸出来的表面才平滑。",
    "全程小火加热，蛋液才不会起蜂窝。，值得留意。",
    "盖盖后不要开盖查看，温度一掉就塌。"
  ],
  "common_mistakes": [
    "一直大火蒸，蛋面全是蜂窝状气孔。，务必避免。",
    "水加得太少，蒸好后干硬像蛋饼。，务必避免。",
    "蒸好放凉再上桌，蛋羹塌成一层。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "清水",
      "substitute": "昆布汤",
      "ratio": "300 毫升:300 毫升",
      "note": "鲜味更足，盐减一克。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸡蛋加嫩豆腐",
      "ratio": "240 克:150 克加 150 克",
      "note": "豆腐压碎同蒸，口感更滑。"
    }
  ],
  "variations": [
    "加一小勺虾皮同蒸，鲜味更突出。，也很受欢迎。",
    "表面撒一点辣椒粉，微辣更开胃。，也很受欢迎。"
  ],
  "serving_suggestion": "连着砂锅端上桌，配白米饭用勺子挖着吃，暖胃又下饭。",
  "storage": "现做现吃，冷藏一天后复蒸三分钟。，效果更稳定。",
