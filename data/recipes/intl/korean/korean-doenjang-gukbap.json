  "equipment": [
    "石锅",
    "汤勺",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成半厘米厚的片，西葫芦切半月片，洋葱切丝，大葱斜切成段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐切厚一点，煮的时候才不散，吸饱汤还带豆香。",
      "visual_cue": "豆腐片厚薄一致，边缘整齐"
    },
    {
      "n": 2,
      "text": "清水入锅烧开，黄豆酱用滤网兜着在汤里化开，让酱渣留在网里。",
      "time_min": 5,
      "heat": "中火",
      "tip": "用滤网化酱汤才清，直接倒进去会有酱渣沉底，喝着牙碜。",
      "visual_cue": "汤色酱褐清亮，无结块"
    },
    {
      "n": 3,
      "text": "汤里下洋葱、西葫芦与蒜末，中火煮五分钟让蔬菜变软出甜。",
      "time_min": 7,
      "heat": "中火",
      "tip": "蔬菜先煮出味再下豆腐，豆腐久煮会老，孔洞变粗不好吃。",
      "visual_cue": "西葫芦微软，汤面微滚"
    },
    {
      "n": 4,
      "text": "放豆腐片与辣椒粉再煮三分钟，最后撒大葱段，尝咸淡补酱。",
      "time_min": 12,
      "heat": "中火",
      "tip": "辣椒粉和豆腐同时下，辣味能渗进豆腐孔隙里更入味。",
      "visual_cue": "豆腐鼓起小孔，葱段翠绿"
    },
    {
      "n": 5,
      "text": "热米饭盛进石锅或厚碗，把滚汤连料浇在饭上，趁热拌着吃。",
      "time_min": 5,
      "heat": "无火",
      "tip": "饭要用热的最好是刚焖的，冷饭浇汤会冲淡汤味，吃着发寡。",
      "visual_cue": "汤饭分层冒热气，酱香扑鼻"
    }
  ],
  "tips": [
    "大酱汤饭是韩国市场里最便宜的饱腹饭，一碗汤一碗饭配几碟泡菜。",
    "大酱本身很咸，先尝汤再决定是否加盐，多数情况一点盐都不用放。",
    "喜欢更浓可以加一勺辣椒酱，汤色转红，味道也更奔放。"
  ],
  "common_mistakes": [
    "大酱直接甩进滚汤里，结成一团化不开，汤里漂着酱疙瘩。",
    "豆腐和蔬菜一起久煮，豆腐煮成蜂窝，咬着像海绵没有豆味。",
    "饭盛得太满再浇汤，汤溢出来，饭上面一层全是清汤。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "土豆",
      "ratio": "150克:150克",
      "note": "土豆版需多煮五分钟至软。"
    },
    {
      "original": "黄豆酱",
      "substitute": "味噌",
      "ratio": "60克:50克",
      "note": "味噌咸度更高，需减量并少放盐。"
    }
  ],
  "variations": [
    "加几片五花肉先煸出油再煮汤，做成猪肉大酱汤饭，是釜山吃法。",
    "放一把蛤蜊同煮，汤头更鲜，辣椒粉可以多放一点压腥。"
  ],
  "serving_suggestion": "一碗热汤饭配一碟泡菜和一小碟凉拌豆芽，就是标准的韩式家常一餐。",
  "storage": "汤与饭分开冷藏可存一天，复热时汤单独煮开再浇饭。",
