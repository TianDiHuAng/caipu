  "equipment": [
    "平底锅",
    "大碗",
    "打蛋器",
    "铲子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉、糯米粉、盐与清水搅成能流动的面糊，静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面糊要稀一点，稠了煎出来像面饼，吃不出葱的清香。",
      "visual_cue": "面糊顺滑，舀起能缓缓流下"
    },
    {
      "n": 2,
      "text": "小葱洗净沥干，切成与锅直径相当的长段，青椒切斜丝。",
      "time_min": 4,
      "heat": "无火",
      "tip": "葱一定要沥到全干，带水下锅会溅油，饼也煎不脆。",
      "visual_cue": "葱段整齐，表面无水珠"
    },
    {
      "n": 3,
      "text": "鱿鱼切圈、虾仁去背上黑线，用厨房纸吸干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "海鲜必须吸干水，湿的下锅，饼底会出水变得软趴。",
      "visual_cue": "海鲜表面干爽，切面齐整"
    },
    {
      "n": 4,
      "text": "平底锅倒橄榄油烧热，葱段铺满锅底，淋面糊压平，摆上海鲜。",
      "time_min": 5,
      "heat": "中火",
      "tip": "葱铺底、糊盖顶，这样饼才不会散，切块时葱还完整。",
      "visual_cue": "面糊盖住葱段，边缘起泡"
    },
    {
      "n": 5,
      "text": "底面煎脆后淋蛋液翻面，两面煎到金黄，出锅切块。",
      "time_min": 6,
      "heat": "中火",
      "tip": "翻面用盘子盖住锅口倒扣，直接用铲子翻容易散成两半。",
      "visual_cue": "两面金黄，边缘焦脆起小泡"
    }
  ],
  "tips": [
    "海鲜葱饼是韩国雨天必吃的小食，配马格利米酒最地道。",
    "面糊里加一勺糯米粉，饼边更脆，凉了也不软。",
    "蘸汁用生抽、米醋和芝麻调开，酸甜解腻。"
  ],
  "common_mistakes": [
    "面糊调得太稠，煎出来的饼又厚又硬，葱香被面味盖住。",
    "葱没沥干就下锅，油花四溅还煎不脆。",
    "火太大又急着翻面，饼散成碎块，只能铲起来当炒面吃。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "章鱼",
      "ratio": "150克:150克",
      "note": "章鱼需切更小块，煎的时间加两分钟。"
    },
    {
      "original": "糯米粉",
      "substitute": "玉米淀粉",
      "ratio": "40克:40克",
      "note": "玉米淀粉版更脆，但凉得快。"
    }
  ],
  "variations": [
    "加一把韭菜同煎，香气更冲，是韩国市场的做法。",
    "用泡菜替代一半葱，做成泡菜海鲜饼，酸辣更开胃。"
  ],
  "serving_suggestion": "切块装盘，配一碟酱油醋蘸汁，趁热吃最脆香。",
  "storage": "冷藏可存一天，复热用平底锅干煎到两面回脆，勿用微波炉加热会变韧。",
