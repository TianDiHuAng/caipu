  "equipment": [
    "炒锅",
    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊 500g 逆着纤维切成 3 毫米薄片，用厨房纸吸干表面血水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纤维切，肉片才不塞牙。",
      "visual_cue": "肉片薄而均匀、干爽不粘手"
    },
    {
      "n": 2,
      "text": "碗中放 40g 辣椒酱、10g 辣椒粉、30ml 生抽、20g 白糖与 15ml 香油，拌成腌料。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖必须化开，腌料才挂得匀。",
      "visual_cue": "腌料浓稠均匀、颜色红亮"
    },
    {
      "n": 3,
      "text": "肉片与腌料抓匀，加 10g 蒜末拌匀，冷藏腌 20 分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "腌够时间，辣味才渗进去。",
      "visual_cue": "肉片均匀裹红、表面发亮"
    },
    {
      "n": 4,
      "text": "炒锅倒 25ml 植物油烧热，中大火下腌好的肉片，摊平煎 2 分钟后翻炒。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "先摊平煎，肉片才有焦香。",
      "visual_cue": "肉片边缘微焦、香气冲鼻"
    },
    {
      "n": 5,
      "text": "加洋葱丝与香菇片翻炒 3 分钟至洋葱变软，倒入腌料碗里剩余酱汁炒匀。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "洋葱炒到半透明就够，保持脆感。",
      "visual_cue": "洋葱变软、酱汁裹住食材"
    },
    {
      "n": 6,
      "text": "撒入大葱段与剩余 10g 蒜末，翻炒 30 秒后关火装盘。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "蒜末最后放，生蒜香更冲。",
      "visual_cue": "大葱翠绿、酱汁收浓"
    }
  ],
  "tips": [
    "猪里脊逆纤维切薄片，口感才嫩不柴。",
    "腌料里的糖要完全化开，肉片才会挂出亮色。",
    "最后一把生蒜末关火前放，蒜香最冲。"
  ],
  "common_mistakes": [
    "顺着纤维切肉，炒出来嚼不动还塞牙。",
    "肉片堆在锅里不摊开，出水变成炖肉。",
    "酱汁收得太干，肉片发硬失去嫩度。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "猪五花",
      "ratio": "500g 对 500g",
      "note": "更香但油腻，无需额外加油。"
    },
    {
      "original": "辣椒酱",
      "substitute": "辣椒粉",
      "ratio": "40g 对 20g 加 20ml 水",
      "note": "辣度更高，需补 5g 糖。"
    }
  ],
  "variations": [
    "豆腐版：加 200g 老豆腐片同炒。",
    "芝士版：起锅前铺 80g 奶酪烤化。"
  ],
  "serving_suggestion": "配生菜叶包着吃，或配白米饭和泡菜。",
  "storage": "冷藏 2 天，复热后肉片会略硬。",
