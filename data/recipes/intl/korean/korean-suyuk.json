    "刀",
    "砧板",
    "漏勺",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整条用清水冲净，用棉线捆紧成卷，冷水下锅水要完全没过肉面。",
      "time_min": 10,
      "heat": "无火",
      "tip": "捆紧再煮，肉卷切出来才圆整不散。",
      "visual_cue": "肉卷紧实成柱，棉线勒出浅痕。"
    },
    {
      "n": 2,
      "text": "锅里放黄豆酱、姜片、大葱段、洋葱块、盐和料酒，大火煮开撇净浮沫。",
      "time_min": 10,
      "heat": "大火",
      "tip": "浮沫撇得越干净，白切肉的味道越清爽。",
      "visual_cue": "汤面浮沫聚到锅边，汤色转清。"
    },
    {
      "n": 3,
      "text": "转小火煮四十分钟，煮到筷子能轻松穿透肉卷最厚的部分。",
      "time_min": 40,
      "heat": "小火",
      "tip": "全程小泡微滚，翻滚太猛肉皮会破。",
      "visual_cue": "筷子直插无阻，肉皮透亮起胶。"
    },
    {
      "n": 4,
      "text": "关火后让肉在汤里焖二十分钟，捞出趁热用保鲜膜卷紧放凉。",
      "time_min": 22,
      "heat": "微火",
      "tip": "焖这一步让肉汁回流，切片才不干。",
      "visual_cue": "肉卷表面油润，按压有回弹。"
    },
    {
      "n": 5,
      "text": "黄瓜切薄片泡冰水，大蒜切片，大葱切细丝，分盘摆成小碟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄瓜冰水泡十分钟，脆度能明显提升。",
      "visual_cue": "黄瓜片透亮卷边，葱丝细而散。"
    },
    {
      "n": 6,
      "text": "韩式辣椒酱、米醋、白糖、香油和芝麻调成蘸酱，肉卷切薄片配黄瓜上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "醋要在最后加，早放辣酱的颜色会发暗。",
      "visual_cue": "酱色红亮微稠，肉片切面肥瘦分层。"
    }
  ],
  "tips": [
    "肉卷放凉后再切，片形才完整，厚度控制在三毫米左右。",
    "煮肉汤撇净浮油可以当高汤，煮萝卜或面条都很鲜。",
    "想吃更清爽，把肉片在冰水里过一下再摆盘。"
  ],
  "common_mistakes": [
    "肉没捆紧就下锅，煮后散成几块，切片全碎。",
    "大火滚煮，肉皮破开、瘦肉发柴，切面毛糙。",
    "刚出锅就切片，肉汁流失，片上干白发硬。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "1:1",
      "note": "前腿肉瘦，煮的时间缩短十分钟，蘸酱里多加五毫升香油。"
    },
    {
      "original": "米醋",
      "substitute": "柠檬汁",
      "ratio": "1:1",
      "note": "柠檬酸更清爽，用量减少五毫升避免过酸。"
    }
  ],
  "variations": [
    "庆尚道做法在汤锅里加一把紫苏叶同煮，香气特殊，能压猪肉味。",
    "有的家庭把肉卷换成猪颈肉，脂肪更细密，口感更弹。"
  ],
  "serving_suggestion": "肉片薄切后配黄瓜与辣酱醋碟，也可直接包泡菜，冷热吃都合适。",
  "storage": "肉卷冷藏可存三日，切片后密封保存，复热用蒸锅五分钟最接近原味。",
