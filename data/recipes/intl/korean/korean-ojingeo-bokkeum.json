  "steps": [
    {
      "n": 1,
      "text": "鱿鱼撕掉外膜去净内脏，切成宽一厘米的圈，冲洗后沥干。",
      "time_min": 7,
      "heat": "无火",
      "tip": "外膜如果撕不干净，炒出来会又韧又腥还带沙。",
      "visual_cue": "鱿鱼圈洁白紧实，不带泥沙"
    },
    {
      "n": 2,
      "text": "洋葱切粗丝，胡萝卜切薄片，大葱斜切段，蒜姜分别切末。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱别切太细，炒软后还要有点嚼头。",
      "visual_cue": "辅料分堆摆好，切面整齐"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，中火先炒香蒜末、姜末与辣椒粉。",
      "time_min": 4,
      "heat": "中火",
      "tip": "辣椒粉一遇热油就出色，动作要快别停手。",
      "visual_cue": "锅底油色橙红，香味冲鼻"
    },
    {
      "n": 4,
      "text": "转大火下鱿鱼圈快炒到卷起变白，加韩式辣椒酱、生抽与白糖。",
      "time_min": 4,
      "heat": "大火",
      "tip": "鱿鱼一遇高温就出水，火不猛会越炒越老。",
      "visual_cue": "鱿鱼卷成圈状，通体裹红酱"
    },
    {
      "n": 5,
      "text": "放洋葱丝、胡萝卜片和大葱段，翻炒到洋葱断生即可。",
      "time_min": 5,
      "heat": "中火",
      "tip": "菜断生就起锅，多炒一分钟鱿鱼就发硬。",
      "visual_cue": "洋葱半透明，胡萝卜片微微发软"
    },
    {
      "n": 6,
      "text": "淋香油翻匀，撒熟白芝麻出锅，趁热配米饭上桌。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香油一定要关火后再淋，香味才留得住不散。",
      "visual_cue": "表面油亮泛红，芝麻分布均匀"
    }
  ],
  "tips": [
    "鱿鱼下锅前沥得越干越好，出汤少才炒得出焦香。",
    "大火快炒全程不超过四分钟，时间长了肉质就像橡皮。",
    "喜欢更辣可把辣椒粉加到二十克，配上冰水一起吃最过瘾。"
  ],
  "common_mistakes": [
    "鱿鱼切得乱七八糟还带内膜，炒完卷不起来，嚼着发韧。",
    "小火慢炒，鱿鱼持续出水，最后变成一锅红汤煮鱿鱼。",
    "胡萝卜和洋葱一起早下锅，炒到软塌，颜色也发暗。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "八爪鱼",
      "ratio": "500克:500克",
      "note": "八爪鱼更韧，须先焯水三十秒再炒。"
    },
    {
      "original": "胡萝卜",
      "substitute": "青椒",
      "ratio": "60克:80克",
      "note": "青椒更脆，最后两分钟下锅。"
    }
  ],
  "variations": [
    "加一把年糕片同炒，酱汁裹住年糕，是韩国街头小吃的常见版本。",
    "加两勺乌冬面或细面同炒，吸满红酱，一锅就够一顿饭。"
  ],
  "serving_suggestion": "盛在白瓷盘里，配一碗热米饭和一碟泡菜，酱汁拌饭是最受欢迎的吃法。",
  "storage": "冷藏可存一天，回锅时加一勺清水小火翻热，别久炒否则变硬。",
