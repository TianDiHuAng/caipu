  "steps": [
    {
      "n": 1,
      "text": "糯米提前用清水泡两小时，泡到用手指一捻就碎，捞起沥干备用。",
      "time_min": 125,
      "heat": "无火",
      "tip": "糯米不泡透，塞进鸡肚里炖不熟还发硬。",
      "visual_cue": "糯米饱满发白，一捻即碎"
    },
    {
      "n": 2,
      "text": "整鸡冲洗干净，撕掉腹腔里的肥油块，用厨房纸把内外都擦干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腹腔里的肥油要撕掉，留着汤会发浑发腻。",
      "visual_cue": "鸡身白净干爽，腹腔无血块"
    },
    {
      "n": 3,
      "text": "红枣去核，栗子去壳，大蒜剥成整瓣，生姜切片，大葱切长段。",
      "time_min": 12,
      "heat": "无火",
      "tip": "红枣去核才不燥，栗子去壳时别弄碎。",
      "visual_cue": "配料摆放整齐，栗子颗颗完整"
    },
    {
      "n": 4,
      "text": "把泡好的糯米、一半红枣、一半栗子和一半蒜瓣从鸡尾开口塞进腹腔。",
      "time_min": 8,
      "heat": "无火",
      "tip": "只能塞七分满，糯米煮涨会把外层表皮撑破。",
      "visual_cue": "鸡腹鼓起，开口处能看到米粒"
    },
    {
      "n": 5,
      "text": "用棉线把两条腿交叉绑住，开口缝紧，防止炖的时候糯米漏出来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "棉线要绑得紧实一些，一旦漏了米汤整锅汤就浑了。",
      "visual_cue": "鸡身下段并拢绑紧，形态整圆"
    },
    {
      "n": 6,
      "text": "汤锅放整鸡，倒入清水没过鸡身两指，大火烧开后撇净表面的浮沫。",
      "time_min": 12,
      "heat": "大火",
      "tip": "浮沫要撇干净，不然汤色发灰还带腥。",
      "visual_cue": "汤面清亮，浮沫撇得干净"
    },
    {
      "n": 7,
      "text": "转小火放姜片和剩余蒜瓣，盖盖炖五十分钟，中途不要开盖搅动。",
      "time_min": 50,
      "heat": "小火",
      "tip": "小火慢炖，汤面只是微微冒泡，外层表皮才不破。",
      "visual_cue": "汤面微沸，鸡身完整不破皮"
    },
    {
      "n": 8,
      "text": "放入剩余红枣和栗子再炖十五分钟，闻到浓郁的鸡香和枣甜味即可。",
      "time_min": 15,
      "heat": "小火",
      "tip": "红枣要后放，炖太久会烂成泥，把清亮的汤底弄浑。",
      "visual_cue": "红枣颗颗鼓起，栗子软糯发亮"
    },
    {
      "n": 9,
      "text": "起锅前放盐和黑胡椒调味，撒大葱段，连锅端上桌趁热喝汤吃肉。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐一定最后放，早放鸡肉会紧缩发柴。",
      "visual_cue": "汤色清亮微黄，油花点点"
    }
  ],
  "tips": [
    "糯米要塞七分满。糯米煮开会膨胀，塞得太满会把鸡皮撑破，汤就浑了。",
    "全程小火慢炖，汤面只微微冒泡。大火滚煮鸡皮容易破，鸡肉也会发柴。",
    "盐最后放。提前加盐会让鸡肉的蛋白质收紧，炖再久也硬。",
    "鸡腹里的肥油块一定撕干净，留着整锅汤都会发腻，还带一股腥味。"
  ],
  "common_mistakes": [
    "糯米不泡直接塞，炖不熟还发硬。要泡两小时。",
    "鸡肚塞满糯米，煮涨撑破鸡皮。要塞七分满。",
    "大火滚炖，鸡皮破裂肉发柴。要小火慢炖。",
    "一开始就放盐，鸡肉紧缩。要最后调味。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "童子鸡",
      "ratio": "1100克:900克",
      "note": "肉质更嫩，炖制时间可缩短十五分钟。"
    },
    {
      "original": "栗子",
      "substitute": "山药",
      "ratio": "60克:100克",
      "note": "口感更绵，汤色略稠。"
    }
  ],
  "variations": [
    "塞一小段黄芪同炖，药香更足，是韩国夏天的进补做法。",
    "把糯米换成小米，口感更细，汤也更清。",
    "炖好后下一小把面条同煮，就是韩国人吃的鸡汤面。"
  ],
  "serving_suggestion": "整只鸡卧在清亮的汤里，鸡皮完整泛着油光，一勺舀开露出软糯的糯米和红枣，汤清味浓、鸡肉一抿就脱骨。",
  "storage": "冷藏可放两天，复热须小火慢加热至沸腾并保持三分钟；糯米会吸汤，复热时补少量清水。",
