  "steps": [
    {
      "n": 1,
      "text": "小章鱼翻出腹部去掉内脏和墨囊，冲洗干净。，看状态再决定下一步。",
      "time_min": 12,
      "heat": "无火",
      "tip": "内脏和墨囊必须去净，否则发苦。，看状态再决定下一步。",
      "visual_cue": "章鱼雪白，无异物残留"
    },
    {
      "n": 2,
      "text": "章鱼切成五厘米长的段，触须单独留用。，看状态再决定下一步。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切太短一炒就缩没了。，看状态再决定下一步。",
      "visual_cue": "段长均匀，触须完整"
    },
    {
      "n": 3,
      "text": "韩式辣椒酱、辣椒粉、蒜末、白糖和生抽调成酱料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "提前调匀，下锅才不会手忙脚乱。，看状态再决定下一步。",
      "visual_cue": "酱色红亮，质地顺滑"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，下洋葱丝炒到透明。，看状态再决定下一步。",
      "time_min": 4,
      "heat": "大火",
      "tip": "洋葱炒软出甜味，辣味才不冲。，看状态再决定下一步。",
      "visual_cue": "洋葱透亮，香气溢出"
    },
    {
      "n": 5,
      "text": "下章鱼段大火快炒一分钟，炒到卷曲。，看状态再决定下一步。",
      "time_min": 2,
      "heat": "大火",
      "tip": "章鱼一缩就熟，炒久变橡皮。，看状态再决定下一步。",
      "visual_cue": "触须卷曲，颜色转白"
    },
    {
      "n": 6,
      "text": "倒酱料快速翻炒，让每一块都裹上红酱。，看状态再决定下一步。",
      "time_min": 3,
      "heat": "大火",
      "tip": "全程大火，酱才挂得住。，看状态再决定下一步。",
      "visual_cue": "酱色裹匀，油光发亮"
    },
    {
      "n": 7,
      "text": "放大葱段翻两下，淋香油撒白芝麻关火。，看状态再决定下一步。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱段断生就好，炒软就没了脆感。，看状态再决定下一步。",
      "visual_cue": "葱段翠绿，芝麻点缀"
    }
  ],
  "tips": [
    "章鱼炒的时间越短越嫩，一分钟足够。",
    "酱料提前调好，下锅后没时间慢慢配。",
    "大葱最后放，脆感才留得住。，这一点很关键。"
  ],
  "common_mistakes": [
    "章鱼炒五分钟以上，咬起来像橡皮。",
    "酱料直接倒不调匀，辣咸分布不均。",
    "锅不够热，章鱼出水变成煮章鱼。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "小章鱼",
      "substitute": "鱿鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更厚，炒的时间加一分钟。"
    },
    {
      "original": "韩式辣椒酱",
      "substitute": "辣椒酱加辣椒粉",
      "ratio": "45 克:30 克加 10 克",
      "note": "辣度更高，糖可略加。"
    }
  ],
  "variations": [
    "加一把年糕片同炒，饱腹感更强。，这一点很关键。",
    "放几片五花肉，油脂更香。，这一点很关键。"
  ],
  "serving_suggestion": "配白米饭，酱汁拌饭一绝。，这一点很关键。",
  "storage": "冷藏一天，复热用炒锅快炒，微波会变硬。",
