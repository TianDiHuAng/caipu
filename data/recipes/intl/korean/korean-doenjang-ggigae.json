  "steps": [
    {
      "n": 1,
      "text": "蛤蜊放淡盐水里吐沙一小时，刷净外壳。，看状态再决定下一步。",
      "time_min": 62,
      "heat": "无火",
      "tip": "吐沙不净，一口下去全是沙。，看状态再决定下一步。",
      "visual_cue": "外壳洁净，水底沉沙"
    },
    {
      "n": 2,
      "text": "土豆和西葫芦切成一厘米厚的片，洋葱切丝。，看状态再决定下一步。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致，煮的时间才齐。，看状态再决定下一步。",
      "visual_cue": "切片均匀，边缘整齐"
    },
    {
      "n": 3,
      "text": "砂锅倒清水，加韩式大酱用汤勺化开。，看状态再决定下一步。",
      "time_min": 5,
      "heat": "中火",
      "tip": "酱要完全化开，不然结块沉底。，看状态再决定下一步。",
      "visual_cue": "汤色褐黄，无酱疙瘩"
    },
    {
      "n": 4,
      "text": "放大蒜和辣椒粉，中火煮到汤开。，看状态再决定下一步。",
      "time_min": 6,
      "heat": "中火",
      "tip": "辣椒粉后放颜色更红。，看状态再决定下一步。",
      "visual_cue": "汤面微滚，红油浮起"
    },
    {
      "n": 5,
      "text": "下土豆片煮五分钟，煮到边缘透明。，看状态再决定下一步。",
      "time_min": 6,
      "heat": "中火",
      "tip": "土豆先下，耐煮。，看状态再决定下一步。",
      "visual_cue": "土豆半透，汤略稠，这是关键点。"
    },
    {
      "n": 6,
      "text": "放西葫芦、洋葱和蛤蜊，煮到蛤蜊开口。，看状态再决定下一步。",
      "time_min": 7,
      "heat": "中火",
      "tip": "蛤蜊一开口就熟，久煮肉缩。，看状态再决定下一步。",
      "visual_cue": "蛤壳张开，汤色发白"
    },
    {
      "n": 7,
      "text": "加北豆腐块，小火煮三分钟入味。，看状态再决定下一步。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆腐后放，煮久会碎。，看状态再决定下一步。",
      "visual_cue": "豆腐鼓起，边缘泛黄"
    },
    {
      "n": 8,
      "text": "撒葱段，淋香油关火端上桌。，看状态再决定下一步。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油关火后淋，香气才透。，看状态再决定下一步。",
      "visual_cue": "葱段翠绿，汤面油亮"
    }
  ],
  "tips": [
    "大酱要用汤勺压散，汤才不结块。，别嫌麻烦，做完它。",
    "蛤蜊提前吐沙，汤才没有土腥味。，这一步别省。",
    "豆腐最后放，煮久了会散成渣。，别跳过这步。"
  ],
  "common_mistakes": [
    "大酱直接下锅不化开，锅底一层糊。",
    "蛤蜊没吐沙，整锅汤带沙。，这步最关键。",
    "全程大火，汤煮干一半。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "蛤蜊",
      "substitute": "五花肉",
      "ratio": "200 克:150 克",
      "note": "先煸出油，汤更浓。"
    },
    {
      "original": "韩式大酱",
      "substitute": "东北大酱",
      "ratio": "60 克:55 克",
      "note": "咸度更高，盐要减。"
    }
  ],
  "variations": [
    "加一把泡菜，酸辣更开胃。，这里最容易翻车。",
    "放几片牛肉，做成牛肉大酱汤。，别小看这一步。"
  ],
  "serving_suggestion": "配白米饭，汤泡饭最好吃。，成败就在这一步。",
  "storage": "冷藏两天，复热须煮开。，这点要注意。",
