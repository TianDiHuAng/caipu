      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 150,
          "unit": "g",
          "note": "中筋面粉过筛",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "打散成蛋液",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "胡萝卜",
          "name_en": "carrot",
          "amount": 80,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 40,
          "unit": "g",
          "note": "切五厘米长段",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "分两次煎",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "面糊调味",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "蘸汁",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 5,
          "unit": "g",
          "note": "蘸汁增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "打蛋盆",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉过筛进打蛋盆，加盐和一百二十毫升清水，搅到没有干粉颗粒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "搅到面糊能挂住打蛋器缓慢滴落，稠度就正合适。",
      "visual_cue": "面糊顺滑无颗粒，滴落能留短暂痕迹。"
    },
    {
      "n": 2,
      "text": "打入鸡蛋继续搅匀，面糊转成浅黄色，静置五分钟让粉充分吸水。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置这一步能让饼皮更均匀，省掉也勉强能做，但边缘容易破。",
      "visual_cue": "面糊呈均匀浅黄，表面有小气泡。"
    },
    {
      "n": 3,
      "text": "胡萝卜切细丝，小葱切五厘米长段，一起拌进面糊轻轻翻匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "配料只在表面拌开就好，反复搅会把蔬菜搅出水。",
      "visual_cue": "蔬菜丝均匀分布在面糊中。"
    },
    {
      "n": 4,
      "text": "平底锅倒一半植物油烧到六成热，倒一勺面糊摊开成薄圆片。",
      "time_min": 3,
      "heat": "中火",
      "tip": "面糊下锅立刻用铲子背面画圈摊开，厚薄一致才好看。",
      "visual_cue": "面糊摊成约三毫米厚的圆片，边缘起小泡。"
    },
    {
      "n": 5,
      "text": "中小火煎三分钟到底面金黄定型，翻面再煎两分钟。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "翻面前先晃锅，饼能自由滑动说明底面已经定住。",
      "visual_cue": "底面金黄脆硬，边缘微微翘起。"
    },
    {
      "n": 6,
      "text": "煎好的饼切菱形块装盘，生抽加白芝麻调成蘸汁一起上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出锅放在网架上透气，直接叠盘会回软。",
      "visual_cue": "饼块边缘焦脆，蘸汁表面浮芝麻。"
    }
  ],
  "tips": [
    "面糊调到能缓慢流下就好，太稀摊不成形，太稠摊不薄。",
    "胡萝卜丝先干炒一分钟再拌面糊，生胡萝卜的土味就没了。",
    "一次摊薄一点，饼薄才脆，厚了就成发软的面饼。"
  ],
  "common_mistakes": [
    "面糊调好放太久，面粉起筋，煎出来硬得像鞋底。",
    "油温不够就下面糊，饼吸满油，一点都不脆。",
    "翻面太早，底面还没定型就铲，整张饼破成两半。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "土豆淀粉",
      "ratio": "150克:130克",
      "note": "更脆，但香气稍弱。"
    },
    {
      "original": "胡萝卜",
      "substitute": "西葫芦",
      "ratio": "80克:100克",
      "note": "水分多，面糊要少加两勺水。"
    }
  ],
  "variations": [
    "加一把切段的韭菜，香气更冲，是釜山街头的常见加料。",
    "面糊里拌入泡菜碎，酸辣带劲，连蘸汁都可以省掉。"
  ],
  "serving_suggestion": "煎好切成菱形块，趁热配蘸汁上桌，也可以当作下酒小菜或便当里的配菜。",
  "storage": "冷藏可放一天，回锅用平底锅无油小火两面各烘一分钟恢复脆感。",
