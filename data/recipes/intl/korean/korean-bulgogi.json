  "equipment": [
    "平底锅或烤盘",
    "保鲜盒",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊稍微冷冻半小时，逆着纹理切成两毫米左右的薄片。",
      "time_min": 12,
      "heat": "无火",
      "tip": "半冻状态最好切薄片，纹理断开了才嫩。",
      "visual_cue": "肉片薄而透光，大小均匀"
    },
    {
      "n": 2,
      "text": "梨去皮磨成泥，与生抽、白糖、香油、蒜末和黑胡椒拌成腌料。",
      "time_min": 8,
      "heat": "无火",
      "tip": "梨泥里的酶能软化肉质，别用糖水代替。",
      "visual_cue": "腌料棕亮，带果香与甜味"
    },
    {
      "n": 3,
      "text": "牛里脊片与腌料抓匀，冷藏腌制半小时以上，中途翻动一次。",
      "time_min": 30,
      "heat": "无火",
      "tip": "腌久了肉质会散，半小时到两小时之间最好。",
      "visual_cue": "肉片吸饱酱汁，盆底有少量余汁"
    },
    {
      "n": 4,
      "text": "平底锅大火烧热下植物油，牛里脊片摊平铺开，一次别放太多。",
      "time_min": 4,
      "heat": "大火",
      "tip": "分次煎才能煎出焦边，堆着煎就变成煮肉。",
      "visual_cue": "肉片边缘卷起，锅面滋滋响"
    },
    {
      "n": 5,
      "text": "肉片变色后加洋葱丝同炒，炒到洋葱微微透明断生。",
      "time_min": 4,
      "heat": "大火",
      "tip": "洋葱后放，脆甜口感才不会被煎软。",
      "visual_cue": "洋葱丝透亮，肉片带焦边"
    },
    {
      "n": 6,
      "text": "关火撒小葱段与炒香芝麻，趁热配米饭与泡菜上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "关火后再撒芝麻，香气才不散。",
      "visual_cue": "表面撒满芝麻与小葱，油光清亮"
    }
  ],
  "tips": [
    "牛里脊换成肥瘦相间的部位会更香，但需切得更薄。",
    "腌料里的梨可用苹果替代，甜味同样柔和。",
    "配米饭吃最家常，也可加一碟泡菜解腻。"
  ],
  "common_mistakes": [
    "肉片切得太厚，煎完外焦里生嚼不动。",
    "腌料里白糖放太多，煎的时候迅速焦黑发苦。",
    "一次把肉全倒进锅，温度骤降变成水煮牛里脊。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛腩",
      "ratio": "500 克:500 克",
      "note": "肥瘦相间更香，需冷冻后切得更薄。"
    },
    {
      "original": "梨",
      "substitute": "苹果",
      "ratio": "100 克:100 克",
      "note": "甜味更直接，白糖可减五克。"
    }
  ],
  "variations": [
    "加一把金针菇同炒，吸饱酱汁很下饭。",
    "用同样的腌料腌猪五花，做成烤五花肉。"
  ],
  "serving_suggestion": "配米饭与泡菜同食，也可用生菜叶卷着吃。",
  "storage": "腌好后冷藏一天内用掉；熟肉冷藏两天，复热用大火快煎三十秒。",
