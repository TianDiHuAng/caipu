  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "米饭",
          "name_en": "steamed rice",
          "amount": 400,
          "unit": "g",
          "note": "隔夜冷饭最佳，粒粒分开",
          "optional": false
        },
        {
          "name": "泡菜",
          "name_en": "kimchi",
          "amount": 150,
          "unit": "g",
          "note": "带汁切碎，汁水留用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "煎成溏心或全熟荷包蛋",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
          "name": "韩式辣椒酱",
          "name_en": "gochujang",
          "amount": 15,
          "unit": "g",
          "note": "按辣度增减",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 10,
          "unit": "ml",
          "note": "出锅前淋",
          "optional": false
        },
        {
          "name": "紫菜",
          "name_en": "nori",
          "amount": 5,
          "unit": "g",
          "note": "剪细丝",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 15,
          "unit": "ml",
          "note": "炒饭用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "小煎锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "泡菜挤去多余汁水后切成小块，泡菜汁单独留在一只小碗里，小葱切成细葱花备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "泡菜汁是天然调味料，别倒掉，最后用来提酸提鲜。",
      "visual_cue": "泡菜块大小均匀、汁水分离清楚"
    },
    {
      "n": 2,
      "text": "炒锅烧热植物油，下泡菜块用中火翻炒到酸香散出、边缘略卷。",
      "time_min": 3,
      "heat": "中火",
      "tip": "泡菜先炒出香再下饭，酸味会变得圆润不刺鼻。",
      "visual_cue": "泡菜边缘卷起、锅中有红亮油光"
    },
    {
      "n": 3,
      "text": "倒入冷饭用锅铲压散翻匀，让每粒米裹上红色油脂，沿锅边淋入泡菜汁。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "冷饭要压散不要来回戳，米粒才不会碎成糊状。",
      "visual_cue": "米饭由白转红、粒粒松散不结块"
    },
    {
      "n": 4,
      "text": "加入韩式辣椒酱快速翻匀，尝味后关火，淋香油撒葱花与海苔丝拌匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "辣椒酱含糖易焦，最后加并缩短加热时间。",
      "visual_cue": "酱色均匀、香气浓郁不焦苦"
    },
    {
      "n": 5,
      "text": "另起小锅煎两枚鸡蛋，蛋白凝固、蛋黄半熟，铺在炒饭中央即可上桌。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "鸡蛋需彻底加热至蛋白完全凝固，蛋黄按喜好控制。",
      "visual_cue": "蛋白全白不透明、蛋黄表面结薄膜"
    }
  ],
  "tips": [
    "冷饭提前冷藏一夜，水分稳定才炒得松散。",
    "泡菜越酸炒出来越香，太新的泡菜需补少量醋。",
    "香油一定关火后再淋，加热过头会发苦。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭下锅，米饭黏成一坨，怎么炒都散不开。",
    "泡菜汁一次性全倒入，炒饭变成湿糊，失去锅气。",
    "辣椒酱与泡菜一起大火久炒，糖分焦化发苦发黑。"
  ],
  "substitutions": [
    {
      "original": "泡菜",
      "substitute": "辣白菜罐头",
      "ratio": "150g 对 150g",
      "note": "罐头偏咸，需减少辣椒酱用量。"
    },
    {
      "original": "米饭",
      "substitute": "糙米饭",
      "ratio": "400g 对 400g",
      "note": "糙米偏干，需多放一勺油与两勺泡菜汁。"
    }
  ],
  "variations": [
    "加午餐肉丁与芝士片同炒，做成部队锅风味的浓郁版本。",
    "换成金枪鱼罐头与蛋黄酱，做出日韩混搭的绵密口感。"
  ],
  "serving_suggestion": "盛入石锅或厚陶碗，趁热拌开荷包蛋，让蛋黄裹住每粒米饭。",
  "storage": "冷藏一天内吃完，复热时加一勺清水盖盖焖两分钟，避免干硬。",
