  "equipment": [
    "汤锅",
    "保鲜盒",
    "小碗",
    "漏勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋从冰箱取出放常温二十分钟，让蛋温回升，煮的时候不容易破壳。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷蛋直接下锅最易爆壳，回温这一步很关键。",
      "visual_cue": "蛋壳表面无冷凝水，手感接近室温"
    },
    {
      "n": 2,
      "text": "汤锅加水烧沸，放白醋，用勺背把鸡蛋一枚枚轻轻送进锅里，避免磕碰。",
      "time_min": 4,
      "heat": "大火",
      "tip": "醋能让蛋白遇破口迅速凝固，减少流白。",
      "visual_cue": "水面微滚，鸡蛋全部沉底"
    },
    {
      "n": 3,
      "text": "转中火煮六分半，中途用勺子轻推鸡蛋转动，让蛋黄居中不偏。",
      "time_min": 7,
      "heat": "中火",
      "tip": "六分半是溏心的分界，超过七分半蛋黄就全实了。",
      "visual_cue": "计时结束，蛋壳无裂开"
    },
    {
      "n": 4,
      "text": "立刻捞出放进冰水里泡五分钟，彻底降温后再剥壳，蛋面才光滑。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冰水能让蛋白收缩脱离蛋壳，剥起来整片脱落。",
      "visual_cue": "蛋壳一剥就掉，蛋面光滑无坑"
    },
    {
      "n": 5,
      "text": "小碗里放生抽、清水、白糖、蒜末、红辣椒圈与香油，搅到糖完全化开成腌汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "腌汁要尝起来偏咸一点，蛋在里面泡着才不会寡淡。",
      "visual_cue": "腌汁深褐透亮，蒜末分布均匀"
    },
    {
      "n": 6,
      "text": "鸡蛋放进保鲜盒，倒入腌汁没过蛋面，撒上葱圈与焙香的白芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋要完全浸没，露出的部分会颜色不均。",
      "visual_cue": "蛋全部被腌汁淹没，表面浮着葱花"
    },
    {
      "n": 7,
      "text": "盖好冷藏腌六小时以上，隔夜风味最足，中途翻一次面让上色均匀。",
      "time_min": 360,
      "heat": "无火",
      "tip": "腌四小时能吃，腌一夜蛋白才会染成琥珀色。",
      "visual_cue": "蛋白表面染成浅褐色，闻起来咸香带蒜味"
    },
    {
      "n": 8,
      "text": "取出的蛋用刀对半切开，蛋黄微微流动，淋一勺腌汁，撒剩下的葱花即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "切蛋时刀一定要沾点水，切面才会干净不粘，蛋黄也不易压破。",
      "visual_cue": "切面蛋黄橙黄半凝，蛋身褐亮"
    }
  ],
  "tips": [
    "用可生食级别的鸡蛋做溏心最安心，普通蛋建议煮到八分钟。",
    "腌汁可以重复使用一次，再泡一批蛋或腌黄瓜都好吃。",
    "加一勺辣椒粉或半勺鱼露，咸鲜层次会更厚。",
    "配一碗热米饭就是韩剧里最常见的吃法，蛋黄拌饭格外香。"
  ],
  "common_mistakes": [
    "冷水下锅就开始计时，煮的时间不准，剥开蛋黄全熟发干。",
    "煮好不冰镇直接剥壳，蛋白粘住蛋壳，剥得坑坑洼洼。",
    "腌汁不加水直接用生抽，蛋白泡一天后咸得没法入口。"
  ],
  "substitutions": [
    {
      "original": "生抽",
      "substitute": "淡酱油加盐",
      "ratio": "90毫升:100毫升加1克盐",
      "note": "咸度更轻，适合口味清淡的人。"
    },
    {
      "original": "白醋",
      "substitute": "盐",
      "ratio": "15毫升:5克",
      "note": "同样能减少破壳流白，但效果略弱。"
    }
  ],
  "variations": [
    "腌汁里加一勺辣椒酱与蜂蜜，做成甜辣版本，更下饭。",
    "把蛋换成溏心鹌鹑蛋，腌三小时即可入味，适合做便当配菜。"
  ],
  "serving_suggestion": "对半切开摆在米饭上，淋一勺腌汁撒葱花与芝麻，配泡菜与海苔一起吃。",
  "storage": "冷藏腌三到四天内吃完，蛋须始终浸在腌汁中；溏心蛋不建议超过二十四小时再食用。",
