  "equipment": [
    "大碗",
    "平底锅",
    "擀面杖",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水加干酵母和十克白糖搅开，静置五分钟，水面浮起一层细泡。",
      "time_min": 7,
      "heat": "无火",
      "tip": "水温摸着温热就行，烫手会把酵母烫死，这一步决定了成品的口感。",
      "visual_cue": "水面起泡，酵母激活，锅面和食材状态一目了然"
    },
    {
      "n": 2,
      "text": "面粉和糯米粉加盐和剩余白糖混匀，倒进酵母水，揉成光滑不粘手的面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面团要揉到表面光滑，粘手就撒一点干粉，这一步决定了成品的口感。",
      "visual_cue": "面团光滑，按下去回弹，颜色与质地变化清楚可见"
    },
    {
      "n": 3,
      "text": "面团盖保鲜膜放温暖处发酵一小时，涨到原来的一点五倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "室温低时可以把碗放在温水盆上加速发酵。",
      "visual_cue": "面团膨胀，内部呈蜂窝，香气和声音能说明进度"
    },
    {
      "n": 4,
      "text": "红豆沙拌入炒香的芝麻，分成二十克一个的小球，冷藏十分钟定型。",
      "time_min": 12,
      "heat": "无火",
      "tip": "馅球冷一点更好包，软馅容易漏，这一步决定了成品的口感。",
      "visual_cue": "馅球圆整，不粘手，整体火候状态清楚好判断"
    },
    {
      "n": 5,
      "text": "发好的面团排气后分成八份，压扁包入馅球，收口朝下按成圆饼。",
      "time_min": 10,
      "heat": "无火",
      "tip": "收口一定要捏紧，煎的时候糖馅会流出来，这一步决定了成品的口感。",
      "visual_cue": "饼坯圆整，收口紧闭，表面变化看得出来已到位"
    },
    {
      "n": 6,
      "text": "平底锅刷植物油烧到中火，饼坯下锅煎两分钟，翻面压扁再煎两分钟，出锅刷蜂蜜。",
      "time_min": 8,
      "heat": "中火",
      "tip": "用铲子轻压让饼变薄，中间糖馅才化得透，这一步决定了成品的口感。",
      "visual_cue": "两面金黄，饼身微鼓，汤汁和食材状态清楚到位"
    }
  ],
  "tips": [
    "酵母水一定要先激活，直接撒进面粉里发得慢，面团容易发死。",
    "加糯米粉是让饼皮更软糯的关键，全用面粉煎出来偏硬。",
    "馅料别包太多，煎的时候糖液化膨胀，会从收口处流出来。",
    "煎的时候用铲子压一压，让饼变薄受热均匀，中间才不会夹生。"
  ],
  "common_mistakes": [
    "酵母用烫水和，酵母被烫死后完全发不起来，饼硬得像石头。",
    "收口没捏紧就下锅，糖馅遇热流到锅里，饼底焦黑发苦。",
    "火太大急着煎，外皮焦了里面还是生面，咬开一股生粉味。"
  ],
  "substitutions": [
    {
      "original": "红豆沙",
      "substitute": "红糖",
      "ratio": "150克:80克",
      "note": "红糖加十克面粉拌匀，防止流得太快。"
    },
    {
      "original": "糯米粉",
      "substitute": "玉米淀粉",
      "ratio": "60克:40克",
      "note": "淀粉版更脆，软糯感会弱一些。"
    }
  ],
  "variations": [
    "馅里加一把碾碎的坚果，口感更丰富，咬起来有脆粒。",
    "把红豆沙换成芝士碎和白糖，做成拉丝版糖饼，年轻人很喜欢。"
  ],
  "serving_suggestion": "趁热吃最好，外皮微脆内里软糯，糖馅烫口，配一杯热豆浆或咖啡都合适。",
  "storage": "冷藏可放两天，回热用平底锅小火两面各烘一分钟，不要微波否则发硬。",
