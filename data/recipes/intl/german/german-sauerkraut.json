  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "卷心菜",
          "name_en": "cabbage",
          "amount": 2000,
          "unit": "g",
          "note": "去芯切细丝",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 32,
          "unit": "g",
          "note": "粗盐",
          "optional": false
        },
        {
          "name": "孜然",
          "name_en": "cumin",
          "amount": 4,
          "unit": "g",
          "note": "整粒",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 3,
          "unit": "g",
          "note": "整粒",
          "optional": false
        },
        {
          "name": "苹果",
          "name_en": "apple",
          "amount": 150,
          "unit": "g",
          "note": "去皮擦丝",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大盆",
    "玻璃罐",
    "重物",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "卷心菜去掉外层老叶和硬芯，切成两三毫米的细丝。",
      "time_min": 25,
      "heat": "无火",
      "tip": "切得越细越容易出水，发酵也更均匀。",
      "visual_cue": "菜丝细匀，堆成小山"
    },
    {
      "n": 2,
      "text": "菜丝放进大盆，撒盐后用干净的手反复揉搓十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "揉到菜丝变软出水，这一步决定成败。",
      "visual_cue": "菜丝变软，盆底积水"
    },
    {
      "n": 3,
      "text": "加入孜然粒、黑胡椒和苹果丝，和卷心菜丝一起拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "苹果提供糖分，发酵的酸味更圆润。",
      "visual_cue": "菜丝湿润，香料均匀"
    },
    {
      "n": 4,
      "text": "把菜丝连汁装进玻璃罐，用拳头压实到液面淹过菜丝。",
      "time_min": 10,
      "heat": "无火",
      "tip": "压得够紧，菜丝才不会浮上来长霉。",
      "visual_cue": "液体淹没菜丝两指"
    },
    {
      "n": 5,
      "text": "罐口压上重物，盖好盖子放在阴凉处静置一天。",
      "time_min": 720,
      "heat": "无火",
      "tip": "一天后先看有没有起泡，正常再继续发酵。",
      "visual_cue": "表面布满细小气泡"
    },
    {
      "n": 6,
      "text": "移入阴凉处继续发酵两周，期间每周开盖放一次气。",
      "time_min": 720,
      "heat": "无火",
      "tip": "每次开盖闻一下，酸香清爽才是正常的。",
      "visual_cue": "酸香明显，菜丝微黄"
    }
  ],
  "tips": [
    "切得越细越容易出水，揉盐这一步不能省。",
    "菜丝必须完全浸在自身汁液里，露出容易长霉。",
    "发酵期间每周开盖放气，避免瓶内压力过大。"
  ],
  "common_mistakes": [
    "盐放太少，菜丝不出水压不实容易烂。",
    "菜丝浮出液面，几天后表面长出一层白霉。",
    "发酵温度太高，成品发黏且带异味。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "胡萝卜",
      "ratio": "150 克:150 克",
      "note": "甜度稍低，颜色更橙。"
    },
    {
      "original": "孜然",
      "substitute": "杜松子",
      "ratio": "4 克:4 克",
      "note": "香气更清冽，德式南部常用。"
    }
  ],
  "variations": [
    "加一片黑麦面包一起发酵，酸味更圆润。",
    "发酵好后加培根和洋葱同炖，做成经典配菜。"
  ],
  "serving_suggestion": "配烤猪肘、香肠或土豆泥，是德国餐桌上最常见的酸味配菜。",
  "storage": "冷藏可存三个月，取用用干净筷子，液面下降可补凉盐水。",
