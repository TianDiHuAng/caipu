 "steps": [
  {
   "n": 1,
   "text": "土豆去皮切两厘米块，泡水备用。，火候要稳，别忽大忽小。",
   "time_min": 10,
   "heat": "无火",
   "tip": "泡水防止发黑。，火候要稳，别忽大忽小。",
   "visual_cue": "土豆洁白，水微浑，这一点很关键。"
  },
  {
   "n": 2,
   "text": "汤锅放黄油，培根丁下锅炒出油。，火候要稳，别忽大忽小。",
   "time_min": 5,
   "heat": "中火",
   "tip": "培根炒脆，汤底才香。，火候要稳，别忽大忽小。",
   "visual_cue": "培根卷边，油脂析出"
  },
  {
   "n": 3,
   "text": "加洋葱、胡萝卜和芹菜炒三分钟。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "中火",
   "tip": "蔬菜炒软，甜味才出来。，火候要稳，别忽大忽小。",
   "visual_cue": "洋葱透明，锅底微黄"
  },
  {
   "n": 4,
   "text": "撒面粉炒一分钟，搅匀。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "小火",
   "tip": "面粉炒过才不腥。，火候要稳，别忽大忽小。",
   "visual_cue": "干粉消失，糊状均匀"
  },
  {
   "n": 5,
   "text": "倒入清水和香叶，加土豆块煮开。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "大火",
   "tip": "水要没过土豆两指。，火候要稳，别忽大忽小。",
   "visual_cue": "汤面翻滚，土豆下沉"
  },
  {
   "n": 6,
   "text": "转小火煮二十分钟，到土豆一压就散。，火候要稳，别忽大忽小。",
   "time_min": 22,
   "heat": "小火",
   "tip": "煮到软才压得动。，火候要稳，别忽大忽小。",
   "visual_cue": "土豆酥软，边缘发毛"
  },
  {
   "n": 7,
   "text": "压泥器压碎一半土豆，留一些块。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "小火",
   "tip": "留块口感才有层次。，火候要稳，别忽大忽小。",
   "visual_cue": "汤体半稠，仍有块状"
  },
  {
   "n": 8,
   "text": "倒牛奶，加盐和黑胡椒，煮开即可。，火候要稳，别忽大忽小。",
   "time_min": 5,
   "heat": "小火",
   "tip": "牛奶后加，别大火滚。，火候要稳，别忽大忽小。",
   "visual_cue": "汤色乳白，微微冒泡"
  },
  {
   "n": 9,
   "text": "盛碗撒黑胡椒，配酸菜吃。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "现磨黑胡椒香气最好。，火候要稳，别忽大忽小。",
   "visual_cue": "表面油光，热气升腾"
  }
 ],
 "tips": [
  "培根先炒出油，汤底才香。，这一点很关键。",
  "压碎一半就好，留块才有口感。，这一点很关键。",
  "牛奶后加，别大火滚。，这一点很关键。"
 ],
 "common_mistakes": [
  "土豆没煮透，压不碎。，这一点很关键。",
  "面粉没炒，汤有生粉味。，这一点很关键。",
  "牛奶大火滚，容易分层。，这一点很关键。"
 ],
