  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切两厘米块，泡水备用。，全程留意火候，别贪快。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡水防止发黑。，火大了就离锅远一点。",
      "visual_cue": "土豆洁白，水微浑，这一步别省。"
    },
    {
      "n": 2,
      "text": "汤锅放黄油，培根丁下锅炒出油。，火别开太大，稳着来。",
      "time_min": 5,
      "heat": "中火",
      "tip": "培根炒脆，汤底才香。，锅温要匀，别忽高忽低。",
      "visual_cue": "培根卷边，油脂析出"
    },
    {
      "n": 3,
      "text": "加洋葱、胡萝卜和芹菜炒三分钟。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蔬菜炒软，甜味才出来。，火候宁小勿大，慢慢推进。",
      "visual_cue": "洋葱透明，锅底微黄"
    },
    {
      "n": 4,
      "text": "撒面粉炒一分钟，搅匀。，注意锅里温度别掉下来。",
      "time_min": 2,
      "heat": "小火",
      "tip": "面粉炒过才不腥。，始终中小火，别心急。",
      "visual_cue": "干粉消失，糊状均匀"
    },
    {
      "n": 5,
      "text": "倒入清水和香叶，加土豆块煮开。，火要均匀，食材才不糊。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水要没过土豆两指。，看住火，别让它失控。",
      "visual_cue": "汤面翻滚，土豆下沉"
    },
    {
      "n": 6,
      "text": "转小火煮二十分钟，到土豆一压就散。，全程留意火候，别贪快。",
      "time_min": 22,
      "heat": "小火",
      "tip": "煮到软才压得动。，火大了就离锅远一点。",
      "visual_cue": "土豆酥软，边缘发毛"
    },
    {
      "n": 7,
      "text": "压泥器压碎一半土豆，留一些块。，火别开太大，稳着来。",
      "time_min": 3,
      "heat": "小火",
      "tip": "留块口感才有层次。，锅温要匀，别忽高忽低。",
      "visual_cue": "汤体半稠，仍有块状"
    },
    {
      "n": 8,
      "text": "倒牛奶，加盐和黑胡椒，煮开即可。，火力保持中等，慢慢来。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶后加，别大火滚。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤色乳白，微微冒泡"
    },
    {
      "n": 9,
      "text": "盛碗撒黑胡椒，配酸菜吃。，注意锅里温度别掉下来。",
      "time_min": 2,
      "heat": "无火",
      "tip": "现磨黑胡椒香气最好。，始终中小火，别心急。",
      "visual_cue": "表面油光，热气升腾"
    }
  ],
  "tips": [
    "培根先炒出油，汤底才香。，别跳过这步。",
    "压碎一半就好，留块才有口感。，这步最关键。",
    "牛奶后加，别大火滚。，很多人在这里出错。"
  ],
  "common_mistakes": [
    "土豆没煮透，压不碎。，这里最容易翻车。",
    "面粉没炒，汤有生粉味。，别小看这一步。",
    "牛奶大火滚，容易分层。，成败就在这一步。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "100 克:100 克",
      "note": "咸味更轻，盐少放一克。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "150 毫升:120 毫升",
      "note": "汤更浓，可加五十毫升清水。"
    }
  ],
  "variations": [
    "撒一把炸洋葱碎，口感更脆。，这点要注意。",
    "加一勺酸菜，酸香更足。，这是关键点。"
  ],
  "serving_suggestion": "配酸菜和腌黄瓜。，别嫌麻烦，做完它。",
  "storage": "冷藏三天，复热须煮开。，这一步别省。",
