  "equipment": [
    "汤锅",
    "炒锅",
    "木勺",
    "大碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆带皮洗净冷水下锅，加三克盐煮开后转中火煮十八分钟，筷子能轻松扎透即捞出。",
      "time_min": 20,
      "heat": "中火",
      "tip": "带皮煮土豆不吸太多水，切开才不会散成糊。",
      "visual_cue": "土豆皮微微开裂，筷子一插即透"
    },
    {
      "n": 2,
      "text": "趁热剥皮切成三毫米厚的圆片，放进大碗里立刻淋二十毫升白醋拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "趁热淋醋才能让土豆片吸味，凉了就只在表面挂着。",
      "visual_cue": "土豆片表面泛出淡淡酸香，边缘完整"
    },
    {
      "n": 3,
      "text": "炒锅不放油煸培根条到出油微脆，连油一起浇在土豆片上。",
      "time_min": 6,
      "heat": "中火",
      "tip": "培根要煸到出足够的油，这层油是整道菜的香味来源。",
      "visual_cue": "培根边缘卷起呈深红色，锅底留一层清油"
    },
    {
      "n": 4,
      "text": "热高汤加洋葱末、白糖、余下白醋和盐烧开，趁热浇入大碗，轻拌后静置十五分钟。",
      "time_min": 17,
      "heat": "中火",
      "tip": "高汤必须热，冷汤会让土豆遇冷回硬、吸不进味道。",
      "visual_cue": "汤汁被土豆吸走大半，碗底浅浅一层"
    },
    {
      "n": 5,
      "text": "加入酸黄瓜片和黑胡椒翻拌，尝味补盐，撒欧芹碎即可上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酸黄瓜最后放才保留脆感，早放会被热汤烫软。",
      "visual_cue": "沙拉湿润不积水，酸香与肉香交织"
    }
  ],
  "tips": [
    "南德做法用热高汤与醋，北德偏用蛋黄酱，这道走南德路线更清爽。",
    "土豆选蜡质品种，切面光滑有光泽，煮后不易碎。",
    "拌好后温热吃最香，冷藏一夜再吃风味更融合。"
  ],
  "common_mistakes": [
    "土豆煮好放凉才切，切面碎裂成小块。",
    "醋一次性倒完，酸味压过所有其他味道。",
    "培根只煎到变色就停，油脂没煸出来导致沙拉发腻。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "100 克:110 克",
      "note": "咸度更高，需减盐一克。"
    },
    {
      "original": "白醋",
      "substitute": "苹果醋",
      "ratio": "40 毫升:45 毫升",
      "note": "果香更柔，酸度略低。"
    }
  ],
  "variations": [
    "加入切块的煮鸡蛋或一勺蛋黄酱，可做成更厚重的北德风味。"
  ],
  "serving_suggestion": "温热时配德式香肠、酸菜与黑麦面包一起上桌。",
  "storage": "冷藏三天，复热时隔水蒸五分钟，勿用微波直打以免土豆发硬。",
