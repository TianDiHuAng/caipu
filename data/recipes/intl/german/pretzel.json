  "steps": [
    {
      "n": 1,
      "text": "高筋面粉、酵母与盐混匀，加温水与软化黄油揉成光滑面团，盖布发酵一小时。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐别直接接触酵母，会抑制发酵。",
      "visual_cue": "面团光滑、体积两倍大"
    },
    {
      "n": 2,
      "text": "面团分成四份滚圆，搓成中间粗两头细的长条，静置十分钟放松面筋。",
      "time_min": 10,
      "heat": "无火",
      "tip": "松弛够才搓得长不断。",
      "visual_cue": "面棍粗细均匀、不回缩"
    },
    {
      "n": 3,
      "text": "长条打成结，两端翻折压在底部，整形成经典的心形结状。",
      "time_min": 8,
      "heat": "无火",
      "tip": "接口压紧，煮时不易散。",
      "visual_cue": "结形饱满、接口贴紧"
    },
    {
      "n": 4,
      "text": "小苏打加清水调成碱水，面结每面浸十秒捞出，沥干后摆上烤盘。",
      "time_min": 10,
      "heat": "无火",
      "tip": "戴手套操作，碱水伤皮肤。",
      "visual_cue": "表面微黄发亮、沥干水分"
    },
    {
      "n": 5,
      "text": "表面撒粗盐并划一道深口，200℃ 烤二十五分钟至深棕红色。",
      "time_min": 25,
      "heat": "无火",
      "tip": "划口要深，烤后才裂得漂亮。",
      "visual_cue": "表皮深棕红、裂口张开"
    }
  ],
  "tips": [
    "高筋面粉的蛋白质高，碱水浸泡后才撑得起那股嚼劲。",
    "整形时接口一定压紧，泡碱水时散开就白做了。",
    "划口要划得深，烤的时候才裂得开、露出内部组织。"
  ],
  "common_mistakes": [
    "面团没发酵到位就整形，烤出来硬得像石头。",
    "碱水浓度太高又泡太久，表皮发苦。",
    "划口太浅，烤后裂不开，成品圆钝无型。"
  ],
  "substitutions": [
    {
      "original": "小苏打",
      "substitute": "食用碱",
      "ratio": "30g 对 20g",
      "note": "碱性更强，浸泡时间减到 5 秒。"
    },
    {
      "original": "粗盐",
      "substitute": "海盐",
      "ratio": "5g 对 5g",
      "note": "颗粒感接近。"
    }
  ],
  "variations": [
    "芝士版：出炉前撒 40g 奶酪丝。",
    "甜味版：表面不撒盐，改刷黄油撒肉桂糖。"
  ],
  "serving_suggestion": "趁热配黄油与啤酒，或横切夹火腿与奶酪。",
  "storage": "常温密封可存 2 天，冷冻 1 个月，复热 180℃ 烤 5 分钟。",
