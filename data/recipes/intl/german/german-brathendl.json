          "name_en": "lemon",
          "amount": 80,
          "unit": "g",
          "note": "塞入腹腔",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "刷子",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡里外冲洗干净，用厨房纸把表面和腹腔的水分擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鸡皮一定要擦干，烤出来才会脆。",
      "visual_cue": "鸡皮干爽，表面没有水珠"
    },
    {
      "n": 2,
      "text": "用盐和黑胡椒把整鸡里外擦一遍，冷藏腌二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "盐要擦进鸡皮和腹腔，味道才进得去。",
      "visual_cue": "鸡身均匀裹着盐粒"
    },
    {
      "n": 3,
      "text": "黄油隔水融化，拌入切末的大蒜和迷迭香碎调成香料油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油别用大火直接烧，容易焦糊发黑。",
      "visual_cue": "香料油呈浅黄色，香气浓"
    },
    {
      "n": 4,
      "text": "洋葱切成大块铺在烤盘底部，柠檬切成两半放在旁边。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱垫底接住鸡油，烤完就是配菜。",
      "visual_cue": "洋葱铺满盘底，厚薄均匀"
    },
    {
      "n": 5,
      "text": "柠檬塞进整鸡腹腔，把胸部朝上放在洋葱上面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬塞进去能去腥，还能让肉更嫩。",
      "visual_cue": "鸡身稳放，腹口不外翻"
    },
    {
      "n": 6,
      "text": "用刷子把香料油均匀刷满整鸡表面和两腿外侧。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷两遍更均匀，鸡皮才会金黄酥脆。",
      "visual_cue": "鸡皮油亮，香料粘附均匀"
    },
    {
      "n": 7,
      "text": "烤箱预热到两百度，把烤盘放进中层烤五十分钟。",
      "time_min": 50,
      "heat": "中大火",
      "tip": "中途翻一次面，上色才会均匀好看。",
      "visual_cue": "表皮金黄，能闻到烤香"
    },
    {
      "n": 8,
      "text": "取出刷一层黄油，再回炉烤十五分钟至鸡皮酥脆。",
      "time_min": 15,
      "heat": "中大火",
      "tip": "最后刷油是脆皮的关键，别省略这一步。",
      "visual_cue": "鸡皮深金，按压有脆响"
    },
    {
      "n": 9,
      "text": "出炉静置十分钟再切块，配盘底的洋葱一起上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置让肉汁回吸，切开才不会流一盘汤。",
      "visual_cue": "肉汁清亮，切面湿润不干"
    }
  ],
  "tips": [
    "鸡皮务必擦干，烤出来才会真正酥脆。",
    "中途翻面一次，受热和上色都会更均匀。",
    "出炉必须静置十分钟，肉汁才不会流失。"
  ],
  "common_mistakes": [
    "鸡皮带水下炉，烤完皮软还带腥味。",
    "火候过大又没盖锡纸，鸡皮烤成黑壳。",
    "出炉立刻切开，肉汁全流在盘子里。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "1200 克:1000 克",
      "note": "烤制时间减二十分钟。"
    },
    {
      "original": "迷迭香",
      "substitute": "百里香",
      "ratio": "5 克:5 克",
      "note": "香气更清雅，用量相同。"
    }
  ],
  "variations": [
    "腌料里加一勺蜂蜜，烤出色泽更深亮的脆皮。",
    "盘底铺土豆块，吸满鸡油非常香。"
  ],
  "serving_suggestion": "切块后配德式土豆沙拉和酸菜一起吃，配一杯黑啤更地道。",
  "storage": "冷藏两天，复热时用一百八十度烤十分钟恢复脆皮。",
