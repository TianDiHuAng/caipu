  "equipment": [
    "肉锤",
    "平底锅",
    "夹子",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊横切成三片，用肉锤拍到半厘米厚，两面撒一半盐和黑胡椒。",
      "time_min": 12,
      "heat": "无火",
      "tip": "拍薄要均匀，厚的地方多敲两下。",
      "visual_cue": "肉片薄而完整，边缘不破"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油烧热，肉片每面煎两分钟至金黄，盛出保温。",
      "time_min": 6,
      "heat": "中火",
      "tip": "锅要够热，肉片下去立刻响。",
      "visual_cue": "两面金黄，锅底留一层焦香"
    },
    {
      "n": 3,
      "text": "原锅放黄油，下培根小火煸三分钟至出油变脆。",
      "time_min": 4,
      "heat": "小火",
      "tip": "培根煸出油，蘑菇才不粘。",
      "visual_cue": "培根卷边，锅里有清亮油"
    },
    {
      "n": 4,
      "text": "下洋葱丁和蒜末炒三分钟，再放口蘑片炒到出水收干。",
      "time_min": 7,
      "heat": "中火",
      "tip": "蘑菇要炒到不出水，酱才不稀。",
      "visual_cue": "蘑菇片缩小变褐，锅底干爽"
    },
    {
      "n": 5,
      "text": "撒面粉翻炒一分钟，倒水和淡奶油搅匀，小火煮三分钟成浓酱。",
      "time_min": 5,
      "heat": "小火",
      "tip": "面粉要炒匀再加水，否则结块。",
      "visual_cue": "酱体顺滑，能挂住勺背"
    },
    {
      "n": 6,
      "text": "用剩下的盐和黑胡椒调味，肉片回锅浸一分钟，撒欧芹碎上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "肉片只浸一分钟，久了炸衣会软。",
      "visual_cue": "每片肉都裹上一层褐色酱汁"
    }
  ],
  "tips": [
    "肉锤用拍打面而不是钉面，肉才不会被扎烂。",
    "蘑菇换成鸡油菌，香气更接近森林版。",
    "配炸薯条或土豆泥都能把酱汁用干净。"
  ],
  "common_mistakes": [
    "肉片没有拍薄，煎完外面焦了里面还生。",
    "蘑菇没炒干就加水，酱汁稀得挂不住。",
    "面粉直接撒进汤里，酱里全是白疙瘩。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶加一勺黄油",
      "ratio": "80毫升:70毫升",
      "note": "酱体稍稀，面粉可多加五克。"
    },
    {
      "original": "口蘑",
      "substitute": "香菇",
      "ratio": "250克:250克",
      "note": "香气更重，炒的时间延长两分钟。"
    }
  ],
  "variations": [
    "不加奶油做成清汤猎人汁，口感更轻。",
    "用鸡胸肉代替猪里脊，家庭版更省事。"
  ],
  "serving_suggestion": "肉片连酱一起浇在盘里，配炸薯条和一份黄瓜沙拉，挤上柠檬汁解腻。",
  "storage": "冷藏两天，酱与肉分开存；复热小火加热酱汁再放肉片。",
