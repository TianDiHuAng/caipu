  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切细末，用一半黄油小火炒软放凉。，始终中小火，别心急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "炒过才不呛，凉了再拌馅。，火要均匀，食材才不糊。",
      "visual_cue": "洋葱透明，香气发甜"
    },
    {
      "n": 2,
      "text": "牛肉末放大碗，加鸡蛋、面包糠和清水。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水慢慢加，馅才嫩。，全程留意火候，别贪快。",
      "visual_cue": "肉馅黏稠，能抱团，这是关键点。"
    },
    {
      "n": 3,
      "text": "加洋葱末、欧芹、盐和黑胡椒，顺一个方向搅打。",
      "time_min": 6,
      "heat": "无火",
      "tip": "顺一个方向搅，肉饼才不散。，火大了就离锅远一点。",
      "visual_cue": "馅体起胶，表面发亮"
    },
    {
      "n": 4,
      "text": "手上沾水，把馅团成两厘米厚的圆饼。，火别开太大，稳着来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "中间按个小坑，煎的时候才不鼓。，锅温要匀，别忽高忽低。",
      "visual_cue": "饼形圆整，厚度一致"
    },
    {
      "n": 5,
      "text": "平底锅放剩余黄油，中火下肉饼。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "热锅再下饼，才能锁住肉汁。，火候宁小勿大，慢慢推进。",
      "visual_cue": "边缘起泡，底面变褐"
    },
    {
      "n": 6,
      "text": "一面煎四分钟，翻面再煎三分钟。，注意锅里温度别掉下来。",
      "time_min": 9,
      "heat": "中火",
      "tip": "别频繁翻动，会散。，始终中小火，别心急。",
      "visual_cue": "两面焦褐，按压有弹性"
    },
    {
      "n": 7,
      "text": "出锅静置三分钟，配酱汁或面包吃。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置后肉汁才回吸。，看住火，别让它失控。",
      "visual_cue": "切面多汁，肉香浓，别嫌麻烦，做完它。"
    }
  ],
  "tips": [
    "洋葱先炒过，味道更甜不呛。，这一步别省。",
    "馅顺一个方向搅，肉饼才不散。，别跳过这步。",
    "肉饼中间按个小坑，煎的时候不鼓。"
  ],
  "common_mistakes": [
    "馅太稀，煎的时候散成渣。，这步最关键。",
    "火太大，外面焦里面生。，很多人在这里出错。",
    "频繁翻动，形状全碎。，这里最容易翻车。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "五花肉",
      "ratio": "600 克:600 克",
      "note": "肥一些更香，需剁细。"
    },
    {
      "original": "面包糠",
      "substitute": "面粉",
      "ratio": "40 克:30 克",
      "note": "口感稍实，清水多十毫升。"
    }
  ],
  "variations": [
    "加一勺芥末籽，风味更冲。，别小看这一步。",
    "包一小块芝士做流心。，成败就在这一步。"
  ],
  "serving_suggestion": "配土豆沙拉，或夹进小面包当晚餐。",
  "storage": "冷藏两天，冷冻一个月。，这点要注意。",
