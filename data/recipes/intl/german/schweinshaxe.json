    "烤盘",
    "锡纸",
    "厨房纸",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肘用厨房纸彻底擦干，皮面用刀划出方格纹，深至皮下脂肪但不切断肉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "划到脂肪层，烤后才起脆皮。",
      "visual_cue": "皮面方格均匀、露出白脂"
    },
    {
      "n": 2,
      "text": "皮面抹盐与孜然粒，肉面撒黑胡椒，静置半小时让味道渗进去。",
      "time_min": 30,
      "heat": "无火",
      "tip": "盐多抹在皮上，脆皮靠它脱水。",
      "visual_cue": "表皮干爽、调料贴附"
    },
    {
      "n": 3,
      "text": "烤盘铺洋葱、大蒜与香叶，倒入清水与高汤各半，放上猪蹄膀肉面朝下。",
      "time_min": 8,
      "heat": "无火",
      "tip": "液体不要没过皮，蒸汽焖肉。",
      "visual_cue": "液体到位、蔬菜铺底"
    },
    {
      "n": 4,
      "text": "盖锡纸 180℃ 烤一百分钟，让肉质在蒸汽里慢慢酥软。",
      "time_min": 100,
      "heat": "无火",
      "tip": "盖紧锡纸，水分不跑才不柴。",
      "visual_cue": "肉质变软、筷子可插入"
    },
    {
      "n": 5,
      "text": "揭掉锡纸翻面让皮朝上，刷一层植物油，220℃ 再烤四十分钟至皮起泡。",
      "time_min": 40,
      "heat": "无火",
      "tip": "最后阶段只烤皮，注意别焦。",
      "visual_cue": "表皮金黄、起密集小泡"
    },
    {
      "n": 6,
      "text": "取出静置十分钟再切块，配盘底的洋葱与肉汁一起上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置让肉汁回流，切开会流汁。",
      "visual_cue": "切面湿润、皮脆有声"
    }
  ],
  "tips": [
    "表皮必须提前擦干并划到脂肪层，脆壳就是靠这一步。",
    "先蒸汽焖再高温烤皮，肉才软而皮才脆。",
    "最后静置十分钟再切，肉汁不流失。"
  ],
  "common_mistakes": [
    "皮没擦干就进烤箱，烤出来是韧皮不是脆皮。",
    "全程高温烤，皮焦了里面还咬不动。",
    "出锅立刻切开，肉汁全流在盘底，肉也变得发干。"
  ],
  "substitutions": [
    {
      "original": "黑啤",
      "substitute": "黄啤",
      "ratio": "400ml 对 400ml",
      "note": "苦味轻，麦芽香更淡。"
    },
    {
      "original": "猪肘",
      "substitute": "五花肉",
      "ratio": "1600g 对 1200g",
      "note": "烤制时间缩短到 90 分钟。"
    }
  ],
  "variations": [
    "巴伐利亚版：配酸菜与芥末酱同食。",
    "慢炖版：先炖两小时再烤三十分钟上脆皮。"
  ],
  "serving_suggestion": "切大块装盘，配德式酸菜、土豆丸子与一杯黑啤。",
  "storage": "冷藏可存 3 天，脆皮复热需 200℃ 烤 10 分钟。",
