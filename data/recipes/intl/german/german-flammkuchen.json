        }
      ]
    }
  ],
  "equipment": [
    "擀面杖",
    "烤盘",
    "烤箱",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒进大盆，加盐与植物油，边倒温水边用筷子搅成絮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水别一次倒完，留两成看面团状态再补。",
      "visual_cue": "面絮均匀，盆底少干粉，看着舒服"
    },
    {
      "n": 2,
      "text": "用手揉成光滑面团，盖上湿布静置二十分钟松弛。",
      "time_min": 23,
      "heat": "无火",
      "tip": "松弛过的面团擀得开，回缩也小，薄饼才薄。",
      "visual_cue": "面团光滑，按压回弹慢，状态正好"
    },
    {
      "n": 3,
      "text": "烤箱提前预热到二百四十度，烤盘一起放进去加热。",
      "time_min": 12,
      "heat": "无火",
      "tip": "烤盘一定要预热，饼底一接触就定型，才够脆。",
      "visual_cue": "烤箱灯亮，热气扑面，很有食欲"
    },
    {
      "n": 4,
      "text": "面团分成两份，在撒了干粉的台面上擀成两毫米薄片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擀得越薄越接近正宗，厚了就变成普通披萨。",
      "visual_cue": "面片透光，边缘略不规整，感觉清爽"
    },
    {
      "n": 5,
      "text": "酸奶油加肉豆蔻、盐与黑胡椒搅匀，抹在面片上。",
      "time_min": 4,
      "heat": "无火",
      "tip": "边缘留一厘米不抹，烤的时候才不会流到盘上。",
      "visual_cue": "奶白抹层均匀，边缘留白，火候刚好"
    },
    {
      "n": 6,
      "text": "洋葱切成极薄的圈，铺满饼面，再撒上培根细条。",
      "time_min": 7,
      "heat": "无火",
      "tip": "洋葱切得越薄越好，烤完才会软甜不呛。",
      "visual_cue": "配料铺满，颜色红白相间，让人安心"
    },
    {
      "n": 7,
      "text": "连纸一起滑进滚烫烤盘，二百四十度烤十二分钟。",
      "time_min": 13,
      "heat": "大火",
      "tip": "烤到边缘起焦斑就出炉，多烤两分钟就发苦。",
      "visual_cue": "边缘焦褐，表面微微鼓起，看着舒服"
    },
    {
      "n": 8,
      "text": "出炉趁热切成长方块，撒黑胡椒，趁脆立刻上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "薄饼凉了就软，切好马上吃才有那种脆响。",
      "visual_cue": "饼底金黄，切口干脆，状态正好"
    }
  ],
  "tips": [
    "火焰薄饼源自阿尔萨斯，德法两边都认它是本地菜。",
    "传统版只有酸奶油、洋葱和培根三样，配料越简单越正宗。",
    "家里烤箱最高温就是最好的温度，烤盘预热是脆底的关键。"
  ],
  "common_mistakes": [
    "烤盘没预热就把饼放上去，烤完饼底软塌不脆。",
    "洋葱切太厚，烤十二分钟还是生的，咬着呛辣。",
    "酸奶油抹到边缘，烤的时候流下来糊在烤盘上。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "酸奶",
      "ratio": "150克:150克",
      "note": "酸奶版水分多，须先滤掉乳清再抹，否则饼底发湿。"
    },
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "120克:110克",
      "note": "火腿版不用煎，直接铺上烤，咸度略低。"
    }
  ],
  "variations": [
    "加一把马苏里拉拉丝，出炉能拉出长丝，孩子更爱吃。",
    "把洋葱换成切薄片的苹果，甜味更突出，配猪排很好吃。"
  ],
  "serving_suggestion": "趁热切块上桌，配一杯雷司令白葡萄酒或冰啤酒。",
  "storage": "现烤现吃最好，冷藏可存一天，复热用烤箱二百度烤五分钟回脆。",
