  "equipment": [
    "密封盒",
    "厚底炖锅",
    "煎锅",
    "筛网",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "把红酒、香醋、洋葱丝、胡萝卜片、芹菜段与香叶、黑胡椒粒混合成腌汁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌汁要完全淹没牛腩，中途翻面才入味均匀。",
      "visual_cue": "液体深红，香料散在蔬菜之间"
    },
    {
      "n": 2,
      "text": "牛腩整块放入密封盒倒入腌汁，冷藏腌制一夜，每隔几小时翻一次面。",
      "time_min": 30,
      "heat": "无火",
      "tip": "腌足二十四小时酸味才透到肉心，时间不足会显单薄。",
      "visual_cue": "肉块通体转成暗红，香气浓郁"
    },
    {
      "n": 3,
      "text": "牛腩取出用厨房纸吸干，腌汁用筛网过滤留用，蔬菜也留下。",
      "time_min": 6,
      "heat": "无火",
      "tip": "吸干表面才能煎出焦壳，否则只会溅油。",
      "visual_cue": "肉块干爽，腌汁过滤后清亮"
    },
    {
      "n": 4,
      "text": "厚底锅下黄油把牛腩整块煎到六面深褐，取出备用。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "每面都要煎到，焦壳是酱汁香气的来源。",
      "visual_cue": "肉块表面深褐，锅底有焦渣"
    },
    {
      "n": 5,
      "text": "原锅下过滤出的蔬菜炒两分钟，撒面粉炒匀后倒入腌汁与高汤。",
      "time_min": 8,
      "heat": "中火",
      "tip": "面粉要在液体之前炒过，才不会结块。",
      "visual_cue": "蔬菜裹上薄粉，液体浓稠"
    },
    {
      "n": 6,
      "text": "放回牛腩，加盖小火焖煮两小时，中途翻面一次。",
      "time_min": 120,
      "heat": "小火",
      "tip": "保持微沸，滚太猛肉质发柴。",
      "visual_cue": "肉块变软，筷子能插入一半"
    },
    {
      "n": 7,
      "text": "取出牛腩盖好保温，酱汁加白糖与盐小火收浓并撇去浮油。",
      "time_min": 12,
      "heat": "小火",
      "tip": "白糖能压住醋酸，边加边尝。",
      "visual_cue": "酱汁浓亮，酸中带甜"
    },
    {
      "n": 8,
      "text": "牛腩逆纹切厚片，淋上酱汁撒欧芹碎即可装盘上桌。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切片口感才嫩，顺着纹切会塞牙。",
      "visual_cue": "切片断面湿润，酱汁裹满"
    }
  ],
  "tips": [
    "腌汁里放几片姜也能去腥，但别省掉冷藏腌制的时间。",
    "酱汁颜色太浅可以加一勺番茄酱提色。"
  ],
  "common_mistakes": [
    "腌制时间不够，只剩表面酸味，肉心依旧寡淡。",
    "牛腩没吸干就下锅煎，溅油且煎不出焦壳。",
    "酱汁收得太干，切片时肉块发干难以下咽。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛腱子",
      "ratio": "900 克:900 克",
      "note": "切片更整齐，焖制时间延长二十分钟。"
    },
    {
      "original": "香醋",
      "substitute": "苹果醋",
      "ratio": "150 毫升:130 毫升",
      "note": "酸度稍缓，用量略减以免过酸。"
    }
  ],
  "variations": [
    "加一小把葡萄干同焖，酸甜更接近莱茵地区风味。",
    "用啤酒替代部分红酒，苦味会让酱汁更有层次。"
  ],
  "serving_suggestion": "切厚片摆盘淋酱，配一份炖红甘蓝同食。",
  "storage": "冷藏三天、冷冻两个月；复热小火连酱汁一同加热，勿用微波。",
