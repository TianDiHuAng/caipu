  "id": "german-apfelkompott",
  "name": {
    "zh": "德式肉桂苹果酱",
    "en": "Apple Compote",
    "original": "Apfelkompott"
  },
  "cuisine": {
    "region": "intl",
    "style": "german"
  },
  "category": [
    "dessert"
  ],
  "difficulty": 1,
  "time": {
    "prep_min": 27,
    "cook_min": 31,
    "total_min": 58
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "sour",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "苹果",
          "name_en": "apple",
          "amount": 800,
          "unit": "g",
          "note": "酸味品种，去皮切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "半个，挤汁",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "按酸度调整",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 2,
          "unit": "g",
          "note": "一小根或少许粉",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 100,
          "unit": "ml",
          "note": "防糊底",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提甜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小汤锅",
    "削皮刀",
    "木勺",
    "玻璃碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苹果去皮去核，切成两厘米见方的小块，边切边泡柠檬汁。",
      "time_min": 12,
      "heat": "无火",
      "tip": "不泡柠檬汁的苹果块几分钟就变成褐色，卖相差。",
      "visual_cue": "果块白皙，切口不泛黄，火候刚好"
    },
    {
      "n": 2,
      "text": "小汤锅倒入水与白糖，小火加热到糖完全化开。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖水不用烧到沸，化开就行，煮久了容易返砂。",
      "visual_cue": "糖水清亮，没有颗粒，让人安心"
    },
    {
      "n": 3,
      "text": "放入苹果块与肉桂，中火煮开后转成小火慢慢煮。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉桂用整根的话煮完要捞出，粉就留在里面。",
      "visual_cue": "果块浮沉，香气散开，看着舒服"
    },
    {
      "n": 4,
      "text": "小火煮十五分钟，中途用木勺轻轻推两次防糊底。",
      "time_min": 17,
      "heat": "小火",
      "tip": "推的时候别搅太狠，果块碎了就成了果泥。",
      "visual_cue": "果块变软，汤汁微稠，状态正好"
    },
    {
      "n": 5,
      "text": "加一小撮盐充分搅匀，尝一口再调整甜酸的比例。",
      "time_min": 2,
      "heat": "小火",
      "tip": "一点盐能把甜味提亮，放多了整锅就咸了。",
      "visual_cue": "甜味更亮，酸味更清，很有食欲"
    },
    {
      "n": 6,
      "text": "喜欢浓稠口感可以用勺背压碎三分之一的果块。",
      "time_min": 3,
      "heat": "小火",
      "tip": "只压一部分，留些整块口感更有层次。",
      "visual_cue": "汤汁变浓，仍有果块，感觉清爽"
    },
    {
      "n": 7,
      "text": "关火挑出肉桂，趁热装进玻璃碗里，晾到温热。",
      "time_min": 10,
      "heat": "无火",
      "tip": "热着装碗再晾，表面会结一层薄膜，看着更亮。",
      "visual_cue": "果块透亮，汁水挂勺，火候刚好"
    },
    {
      "n": 8,
      "text": "温热或冷藏后食用，配煎饼和热红茶都很合适。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷藏一晚味道更融合，酸味也会柔下来。",
      "visual_cue": "色泽琥珀，果香浓郁，让人安心"
    }
  ],
  "tips": [
    "苹果酱在德国是土豆煎饼的固定搭档，也常配烤鸭和猪排。",
    "酸苹果比甜苹果好吃，酸味能撑住糖，不至于发腻。",
    "糖量按苹果酸度调整，尝过再加最稳。"
  ],
  "common_mistakes": [
    "白糖放太多盖住了果酸，吃起来就像糖水。",
    "火太大不搅动，锅底糊了一层，整锅带焦味。",
    "白糖放太多盖住了果酸，吃起来就像糖水一样。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "梨",
      "ratio": "800克:800克",
      "note": "梨版更甜更软，糖减到四十克，柠檬汁保留。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "60克:55克",
      "note": "红糖版颜色更深，带一点焦糖香。"
    }
  ],
  "variations": [
    "加一小把葡萄干同煮，口感更有嚼头，甜味也更丰富。",
    "放两片姜同煮，冬天吃暖胃，配烤肉也解腻。"
  ],
  "serving_suggestion": "温热装小碗，配土豆煎饼、香草冰淇淋或一块烤猪排。",
  "storage": "冷藏密封可存一周，冷冻可存三个月，取用时用干净勺子。",
