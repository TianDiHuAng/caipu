        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "刀",
    "砧板",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净后切成极薄的片，越薄越容易入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "用削皮刀把黄瓜刨成薄片，又快又均匀。",
      "visual_cue": "瓜片薄得透光，边缘整齐"
    },
    {
      "n": 2,
      "text": "黄瓜片放大碗，撒上盐抓匀静置十分钟杀出水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "盐腌逼出水分，拌好才不会出汤。",
      "visual_cue": "瓜片变软，碗底有水"
    },
    {
      "n": 3,
      "text": "把黄瓜片倒进滤网用力挤干，再放回干净大碗。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一定要挤干，否则沙拉很快就被泡稀。",
      "visual_cue": "瓜片干爽，捏不出水"
    },
    {
      "n": 4,
      "text": "洋葱切成极细的丝，用冰水泡五分钟去辛辣。",
      "time_min": 7,
      "heat": "无火",
      "tip": "用冰水泡一下洋葱丝，辛辣味会淡很多。",
      "visual_cue": "洋葱丝透明而挺立"
    },
    {
      "n": 5,
      "text": "酸奶油、白醋、白糖和黑胡椒搅匀成沙拉酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱汁先尝一口，酸度按口味增减。",
      "visual_cue": "酱汁顺滑，颜色乳白"
    },
    {
      "n": 6,
      "text": "把黄瓜片、洋葱丝和莳萝碎倒进酱汁里轻轻拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻轻翻拌就好，不要把瓜片弄碎。",
      "visual_cue": "瓜片均匀裹上白酱"
    },
    {
      "n": 7,
      "text": "放进冰箱冷藏二十分钟再上桌，风味会更清爽。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冰镇一会儿口感更脆，也更清爽解腻。",
      "visual_cue": "沙拉冰凉，酱汁不流"
    }
  ],
  "tips": [
    "黄瓜片切得越薄越容易入味，口感也更脆。",
    "盐腌后必须挤干水分，沙拉才不稀。",
    "冰镇二十分钟再吃，风味清爽很多。"
  ],
  "common_mistakes": [
    "黄瓜没挤干水分，拌完很快就出汤。",
    "洋葱不泡冰水，辛辣味盖过黄瓜清香。",
    "酱汁一次调太酸，只能靠加糖硬救。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "酸奶",
      "ratio": "100 克:100 克",
      "note": "更清爽，需沥去乳清。"
    },
    {
      "original": "莳萝",
      "substitute": "香菜",
      "ratio": "10 克:10 克",
      "note": "香气不同，用量减半。"
    }
  ],
  "variations": [
    "加几片樱桃番茄，颜色会更加鲜亮。",
    "加一点芥末籽调味，辛香更突出。"
  ],
  "serving_suggestion": "配烤猪肘或炸肉排一起吃，解腻效果极好，是德式餐桌上的常见配菜。",
  "storage": "冷藏一天，酱汁会析出水分，食用前重新拌匀。",
