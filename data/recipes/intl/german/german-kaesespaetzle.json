 "variations": [
  "顶层撒面包糠，烤完更脆。，这一点很关键。",
  "加一勺酸菜同炒，酸香解腻。，这一点很关键。"
 ],
 "serving_suggestion": "配绿沙拉和一杯啤酒。，这一点很关键。",
 "storage": "冷藏两天，复热用平底锅。，这一点很关键。",
