  "烤箱"
 ],
 "steps": [
  {
   "n": 1,
   "text": "面粉、鸡蛋、牛奶和盐放大碗，搅成稠面糊。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "无火",
   "tip": "面糊要稠到能挂住刮板。，火候要稳，别忽大忽小。",
   "visual_cue": "面糊光滑，能拉丝，这一点很关键。"
  },
  {
   "n": 2,
   "text": "搅到起小泡，静置十五分钟。，火候要稳，别忽大忽小。",
   "time_min": 17,
   "heat": "无火",
   "tip": "静置让面筋松弛，口感才软。，火候要稳，别忽大忽小。",
   "visual_cue": "表面小泡，质地均匀"
  },
  {
   "n": 3,
   "text": "锅里烧开清水，加一点盐。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "大火",
   "tip": "水要保持微沸，滚太猛会冲散。，火候要稳，别忽大忽小。",
   "visual_cue": "水面翻滚，盐粒化开"
  },
  {
   "n": 4,
   "text": "面糊放刮板上，用刮板把面糊推成细条下锅。，火候要稳，别忽大忽小。",
   "time_min": 10,
   "heat": "中火",
   "tip": "动作连续，条才均匀。，火候要稳，别忽大忽小。",
   "visual_cue": "条状浮起，形状细长"
  },
  {
   "n": 5,
   "text": "面疙瘩浮起后再煮一分钟，捞出。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "中火",
   "tip": "浮起就熟，别煮太久。，火候要稳，别忽大忽小。",
   "visual_cue": "浮在表面，颜色发白"
  },
  {
   "n": 6,
   "text": "平底锅放一半黄油，洋葱丝炒到金黄。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "中火",
   "tip": "洋葱炒到焦糖色最香。，火候要稳，别忽大忽小。",
   "visual_cue": "洋葱金黄，甜香上涌"
  },
  {
   "n": 7,
   "text": "面疙瘩下锅，加剩余黄油翻炒两分钟。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "中火",
   "tip": "炒到边缘微焦，口感才好。，火候要稳，别忽大忽小。",
   "visual_cue": "表面微焦，油光浮动"
  },
  {
   "n": 8,
   "text": "烤盘铺一层面疙瘩，撒一层帕玛森芝士，重复两层。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "层层叠，帕玛森芝士才融得匀。，火候要稳，别忽大忽小。",
   "visual_cue": "层间夹帕玛森芝士，厚薄一致"
  },
  {
   "n": 9,
   "text": "烤箱一百八十度烤十分钟，到帕玛森芝士融化拉丝。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "烤到表面起泡就够。，火候要稳，别忽大忽小。",
   "visual_cue": "帕玛森芝士融化，表面微焦"
  },
  {
   "n": 10,
   "text": "出炉撒黑胡椒，配炸洋葱上桌。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "趁热吃，凉了帕玛森芝士会变硬。，火候要稳，别忽大忽小。",
   "visual_cue": "拉丝明显，热气腾腾"
  }
 ],
 "tips": [
  "面糊要稠，推出来的条才成形。，这一点很关键。",
  "面疙瘩浮起后再煮一分钟就捞。，这一点很关键。",
  "帕玛森芝士层层叠，融得才匀。，这一点很关键。"
 ],
 "common_mistakes": [
  "面糊太稀，下水就散。，这一点很关键。",
  "水滚太猛，面疙瘩全碎。，这一点很关键。",
  "帕玛森芝士太少，烤完发干。，这一点很关键。"
 ],
 "substitutions": [
  {
