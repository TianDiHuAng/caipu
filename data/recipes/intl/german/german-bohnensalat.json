        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "大碗",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆角掐掉两头，撕掉侧边的老筋，切成五厘米长的段。",
      "time_min": 9,
      "heat": "无火",
      "tip": "侧筋不撕掉，吃的时候会塞牙，口感也发老。",
      "visual_cue": "豆段整齐，折口青翠，感觉清爽"
    },
    {
      "n": 2,
      "text": "汤锅烧开大半锅水，加一小勺盐，水要完全沸腾。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水里加盐能让豆角保持翠绿，颜色不会发黄。",
      "visual_cue": "水面翻滚，水色微浑，热气升腾"
    },
    {
      "n": 3,
      "text": "豆角下锅煮六分钟，煮到能咬断但还带一点脆劲。",
      "time_min": 7,
      "heat": "大火",
      "tip": "豆角必须煮透，半生的豆角吃了容易闹肚子。",
      "visual_cue": "豆段变深绿，用勺能掐断，看着舒服"
    },
    {
      "n": 4,
      "text": "捞出豆角立刻放进冷水里过凉，让颜色定住不发黄。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过凉这一步别省，脆感和颜色全靠它保住。",
      "visual_cue": "豆段深绿发亮，手感冰凉，状态正好"
    },
    {
      "n": 5,
      "text": "沥干水分的豆角倒进大碗，摊开晾三分钟去余水。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水没沥干拌出来就是一盘酸汤，尽量沥透。",
      "visual_cue": "豆段干爽，碗底无积水，很有食欲"
    },
    {
      "n": 6,
      "text": "平底锅不放油，把培根片小火煎到卷边出油发脆。",
      "time_min": 5,
      "heat": "小火",
      "tip": "培根自己会出油，不用另加油，煎出来更香。",
      "visual_cue": "培根卷曲，锅底留红油，感觉清爽"
    },
    {
      "n": 7,
      "text": "白醋、植物油、盐、白糖与黑胡椒在小碗里搅匀成汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先把汁调匀再浇，味道分布才均匀，不会一块咸。",
      "visual_cue": "沙拉汁清亮，酸香扑鼻，火候刚好"
    },
    {
      "n": 8,
      "text": "豆角、洋葱丝与培根倒入汁中翻拌，撒莳萝碎上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌好放十分钟再吃，酸味渗进去更入味。",
      "visual_cue": "豆段挂汁油亮，绿末点缀，让人安心"
    }
  ],
  "tips": [
    "德式豆角沙拉多为油醋汁版本，不加蛋黄酱，吃着清爽。",
    "配烤猪肘和炸肉排都合适，也能当啤酒小菜。",
    "用细豆角比粗豆角嫩，煮的时间也要相应缩短。"
  ],
  "common_mistakes": [
    "豆角只煮两三分钟就起锅，咬着发硬还有生青味。",
    "煮好不过凉水，豆角继续受热，拌好就成了软塌的暗绿色。",
    "沙拉汁一次全倒，拌完盘底积水，味道也冲。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "香肠",
      "ratio": "80克:90克",
      "note": "香肠版咸度略低，盐要补一克。"
    },
    {
      "original": "白醋",
      "substitute": "苹果醋",
      "ratio": "25毫升:25毫升",
      "note": "苹果醋版果香更柔，酸味没那么冲。"
    }
  ],
  "variations": [
    "加一勺芥末酱进沙拉汁，酸里带辣，配烤肉更解腻。",
    "放几个对半切的小番茄，颜色更好看，汁水也更足。"
  ],
  "serving_suggestion": "装大碗上桌，配烤猪肘、炸肉排和一杯冰啤酒。",
  "storage": "冷藏密封可存两天，第二天吃前补一点白醋回拌提味。",
