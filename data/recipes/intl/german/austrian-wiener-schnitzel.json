  "equipment": [
    "肉锤",
    "三个浅盘",
    "深煎锅",
    "夹子",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊片夹在保鲜膜中，用肉锤敲到三毫米厚且厚薄均匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "从中心向外敲，边缘敲薄容易炸散。",
      "visual_cue": "肉片透光，面积约为原来一倍半"
    },
    {
      "n": 2,
      "text": "肉片两面撒盐与黑胡椒，静置五分钟让底味渗入。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐不要提前太久撒，否则肉会大量出水。",
      "visual_cue": "肉片表面微微发亮"
    },
    {
      "n": 3,
      "text": "依次把肉片拍上面粉、蘸蛋液、滚面包糠，用手轻压使糠层贴紧。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压掉多余干糠，炸时才不会脱落黑渣。",
      "visual_cue": "糠层均匀，看不到裸露的肉面"
    },
    {
      "n": 4,
      "text": "深煎锅倒入植物油烧到一百七十度，肉片下锅每面炸两分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "下锅后轻晃锅让热油淋上表面，鼓起的大泡正是酥皮的信号。",
      "visual_cue": "表面金黄起泡，油面翻起细密气泡"
    },
    {
      "n": 5,
      "text": "捞出沥油放厨房纸上吸去表面油分，撒欧芹碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "只用厨房纸轻按，压重了酥皮会塌。",
      "visual_cue": "表面干爽，轻按有脆响"
    },
    {
      "n": 6,
      "text": "装盘后配一角柠檬，食用前把柠檬汁挤在酥皮表面。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁最后挤，酸味清新能平衡油炸的厚重。",
      "visual_cue": "表面挤汁后油光变清亮"
    }
  ],
  "tips": [
    "油温宁高不低，低于一百六十度炸出的皮会吸满油。",
    "炸好立刻上桌，放久酥皮会回软。",
    "传统吃法配土豆沙拉或欧芹土豆。"
  ],
  "common_mistakes": [
    "肉片没敲薄，中心炸不熟外层已经焦黑。",
    "油温不够就把肉下锅，糠层脱落且吸油发软。",
    "一次下太多片，锅温骤降导致皮不酥。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "600 克:600 克",
      "note": "敲得更薄，炸制时间缩短半分钟。"
    },
    {
      "original": "面包糠",
      "substitute": "苏打饼干碎",
      "ratio": "150 克:130 克",
      "note": "更酥脆，咸度略高需减盐。"
    }
  ],
  "variations": [
    "用牛仔肉做则称 Wiener Schnitzel 的正统版本。",
    "撒一小撮辣椒粉，做个带辣的变奏。"
  ],
  "serving_suggestion": "配柠檬角、欧芹土豆与一碗酸黄瓜沙拉。",
  "storage": "现炸现吃最佳；冷藏一天后可用一百八十度烤箱复脆五分钟。",
