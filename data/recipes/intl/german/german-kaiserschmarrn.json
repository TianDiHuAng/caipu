 ],
 "steps": [
  {
   "n": 1,
   "text": "蛋黄加一半白糖搅匀，倒入牛奶。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "蛋黄糊要顺滑，别有结块。，火候要稳，别忽大忽小。",
   "visual_cue": "颜色淡黄，液体均匀"
  },
  {
   "n": 2,
   "text": "筛入面粉和盐，搅成稠面糊。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "搅到无干粉就停，别过度。，火候要稳，别忽大忽小。",
   "visual_cue": "面糊浓稠，能缓缓流下"
  },
  {
   "n": 3,
   "text": "蛋白加剩余白糖，打到软性发泡。，火候要稳，别忽大忽小。",
   "time_min": 5,
   "heat": "无火",
   "tip": "打到提起有弯钩就够。，火候要稳，别忽大忽小。",
   "visual_cue": "蛋白霜洁白，弯钩直立"
  },
  {
   "n": 4,
   "text": "蛋白霜分两次拌进面糊，轻手翻拌。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "翻拌别画圈，会消泡。，火候要稳，别忽大忽小。",
   "visual_cue": "糊体蓬松，体积变大"
  },
  {
   "n": 5,
   "text": "拌入柠檬皮屑和葡萄干。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "葡萄干裹点面粉，才不沉底。，火候要稳，别忽大忽小。",
   "visual_cue": "果干分布均匀，这一点很关键。"
  },
  {
   "n": 6,
   "text": "平底锅放黄油，中火倒入面糊铺平。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "中火",
   "tip": "锅要够热，底面才不粘。，火候要稳，别忽大忽小。",
   "visual_cue": "边缘起泡，底面金黄"
  },
  {
   "n": 7,
   "text": "煎三分钟到底面金黄，用锅铲切成四块。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "中火",
   "tip": "切块后翻面更容易熟。，火候要稳，别忽大忽小。",
   "visual_cue": "底面焦黄，块状分明"
  },
  {
   "n": 8,
   "text": "翻面再煎两分钟，用铲子把饼撕成小块。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "中火",
   "tip": "撕成不规则小块才是这道菜的样子。，火候要稳，别忽大忽小。",
   "visual_cue": "块状松散，表面金黄"
  },
  {
   "n": 9,
   "text": "撒入剩余白糖，快速翻匀到糖化开。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "中火",
   "tip": "糖裹在表面，吃起来才脆。，火候要稳，别忽大忽小。",
   "visual_cue": "表面挂糖，微微发亮"
  },
  {
   "n": 10,
   "text": "装盘撒糖粉，配一勺苹果酱上桌。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "趁热吃，凉了会软塌。，火候要稳，别忽大忽小。",
   "visual_cue": "表面雪白，热气腾腾"
  }
 ],
 "tips": [
  "蛋白打到软性发泡，饼才蓬松。，这一点很关键。",
  "翻面后用铲子撕成小块，这是传统做法。",
  "最后撒糖翻匀，表面才有一层脆糖。"
 ],
 "common_mistakes": [
  "蛋白打过头，成品发干。，这一点很关键。",
  "火太大，外面焦里面生。，这一点很关键。",
  "没撕开，中间是湿面糊。，这一点很关键。"
 ],
 "substitutions": [
  {
   "original": "葡萄干",
   "substitute": "杏仁",
   "ratio": "50 克:50 克",
   "note": "切片后拌入，口感更脆。"
  },
  {
   "original": "牛奶",
   "substitute": "淡奶油",
   "ratio": "250 毫升:200 毫升",
   "note": "需加五十毫升清水调稀。"
  }
 ],
 "variations": [
  "浇一勺热苹果酱，酸甜搭配。，这一点很关键。",
  "撒一点肉桂粉，香气更暖。，这一点很关键。"
 ],
 "serving_suggestion": "撒糖粉，配苹果酱或李子酱。，这一点很关键。",
 "storage": "冷藏两天，复热用平底锅。，这一点很关键。",
