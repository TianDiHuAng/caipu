  "steps": [
    {
      "n": 1,
      "text": "扁豆洗净挑去杂质，用清水泡二十分钟，赶时间也可直接下锅多煮十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡过的扁豆煮得快，口感也更均匀。",
      "visual_cue": "豆子沉底，水略浑浊"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，下培根小火煸四分钟至出油变脆。",
      "time_min": 5,
      "heat": "小火",
      "tip": "培根的烟熏味是这锅汤的底味。",
      "visual_cue": "培根卷边，锅底浮一层油"
    },
    {
      "n": 3,
      "text": "加洋葱丁、胡萝卜丁和蒜末，中火炒五分钟至洋葱透明。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蔬菜炒软再加水，汤才甜。",
      "visual_cue": "洋葱透亮，胡萝卜边缘发亮"
    },
    {
      "n": 4,
      "text": "倒入扁豆和一千二百毫升水，煮开后转小火煮二十五分钟。",
      "time_min": 27,
      "heat": "小火",
      "tip": "水面保持微沸，别大火滚。",
      "visual_cue": "扁豆裂开变软，汤色转浑"
    },
    {
      "n": 5,
      "text": "加土豆丁继续煮十分钟至土豆能被勺子压碎。",
      "time_min": 10,
      "heat": "小火",
      "tip": "土豆后放，否则会化在汤里。",
      "visual_cue": "土豆边角圆钝，一压就散"
    },
    {
      "n": 6,
      "text": "用盐和黑胡椒调味，关火淋苹果醋搅匀，撒欧芹碎上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "醋最后放，酸香才不会煮飞。",
      "visual_cue": "汤体浓稠，入口先咸后酸"
    }
  ],
  "tips": [
    "扁豆品种不同吸水量差别大，水不够中途补热水。",
    "喜欢更浓可把一勺扁豆压碎搅回汤里。",
    "隔夜更好喝，酸味和烟熏味融合得更透。"
  ],
  "common_mistakes": [
    "扁豆没挑杂质，煮出来有沙粒感。",
    "全程大火滚，扁豆煮烂成一锅糊。",
    "一开始就放盐，扁豆皮会变硬煮不软。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "红腰豆",
      "ratio": "300克:300克",
      "note": "需提前泡四小时，煮的时间延长十分钟。"
    },
    {
      "original": "培根",
      "substitute": "烟熏火腿",
      "ratio": "100克:100克",
      "note": "咸度更高，盐要减两克。"
    }
  ],
  "variations": [
    "加一根切片的香肠同煮，是施瓦本地区的吃法。",
    "加一勺黄芥末，酸辣感更明显，汤也更开胃。"
  ],
  "serving_suggestion": "盛进深碗，配一块黑麦面包和一杯苹果汁，是德国冬天的家常午餐。",
  "storage": "冷藏三天，冷冻一个月；复热加少量热水调稀，出锅前再点几滴醋。",
