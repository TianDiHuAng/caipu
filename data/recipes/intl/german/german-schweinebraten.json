  "equipment": [
    "烤箱",
    "烤盘",
    "厨绳",
    "深烤盘",
    "锡纸",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肩肉擦干，皮朝上划出菱形刀口，深至皮下一厘米，别切断肉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "刀口划透硬皮，烤出来才会起酥壳。",
      "visual_cue": "皮面布满菱形纹，肉块完整"
    },
    {
      "n": 2,
      "text": "整块肉抹盐、黑胡椒和香菜籽粉，刀口里也要抹到，静置二十分钟回温。",
      "time_min": 20,
      "heat": "无火",
      "tip": "提前回温，烤时内外温差小。",
      "visual_cue": "表面干爽，调料贴牢不脱落"
    },
    {
      "n": 3,
      "text": "烤盘倒植物油，肉皮朝下大火煎六分钟至皮面金黄起泡。",
      "time_min": 6,
      "heat": "中火",
      "tip": "只煎皮面，肉面不用煎。",
      "visual_cue": "皮面金黄起小泡，锅里有油渣"
    },
    {
      "n": 4,
      "text": "烤箱预热一百八十度，肉块皮朝上放烤架，烤盘底铺洋葱、胡萝卜、大蒜和百里香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蔬菜垫底接肉汁，别让它们焦黑。",
      "visual_cue": "蔬菜铺平，肉块架在蔬菜上方"
    },
    {
      "n": 5,
      "text": "倒啤酒和水到烤盘，送入烤箱烤四十分钟，中途补一次热水防干。",
      "time_min": 40,
      "heat": "中火",
      "tip": "水位低于一厘米就要补水。",
      "visual_cue": "烤盘里有浅褐色汤汁"
    },
    {
      "n": 6,
      "text": "把土豆块放入烤盘边缘，继续烤四十分钟，直到肉中心温度达七十五度。",
      "time_min": 40,
      "heat": "中火",
      "tip": "土豆吸肉汁，是这道菜的配菜主角。",
      "visual_cue": "土豆边缘焦黄，肉皮鼓起"
    },
    {
      "n": 7,
      "text": "取出肉块静置十分钟再切，烤盘里的蔬菜和汤汁压成浓汁，配土豆上桌。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置让肉汁回吸，切时不出血水。",
      "visual_cue": "切片断面浅粉，肉汁浓稠"
    }
  ],
  "tips": [
    "皮要划透但别切到肉，否则烤时皮会缩成一块。",
    "想要更脆的皮，最后五分钟把上火调到二百二十度。",
    "剩下的肉汁加一勺面粉煮稠，就是标准的德式肉汁。"
  ],
  "common_mistakes": [
    "肉块没回温就进烤箱，中心生冷外层已焦。",
    "烤盘不加水，蔬菜烤成一层黑壳。",
    "出炉立刻切块，肉汁全流在案板上。"
  ],
  "substitutions": [
    {
      "original": "啤酒",
      "substitute": "清水加一勺黑醋",
      "ratio": "200毫升:200毫升加5毫升",
      "note": "少了麦芽香，但汤汁一样浓。"
    },
    {
      "original": "猪肩肉",
      "substitute": "猪五花",
      "ratio": "900克:900克",
      "note": "脂肪更多，烤的时间缩短十分钟。"
    }
  ],
  "variations": [
    "加一勺黄芥末抹在肉面，风味更冲。",
    "用黑啤替代淡啤，汤汁颜色更深。"
  ],
  "serving_suggestion": "切片浇肉汁，配烤土豆和一份酸白菜，是巴伐利亚周日午餐的标准组合。",
  "storage": "冷藏三天，切片后加肉汁小火复热；冷冻可存一个月。",
