  "equipment": [
    "大碗",
    "平底锅",
    "擦丝刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "卷心菜去掉外层老叶和硬芯，切成两毫米宽的细丝，越细口感越软。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刀要锋利，切得细才容易入味。",
      "visual_cue": "菜丝细匀，松散不成团"
    },
    {
      "n": 2,
      "text": "菜丝加盐抓匀，静置十五分钟杀出水分，再用手挤干。",
      "time_min": 16,
      "heat": "无火",
      "tip": "水挤得越干，拌好越不出汤。",
      "visual_cue": "菜丝体积缩小，手心有水"
    },
    {
      "n": 3,
      "text": "平底锅不放油，下培根小火煸四分钟至出油变脆，连油一起留在锅里。",
      "time_min": 5,
      "heat": "小火",
      "tip": "培根自己会出油，不用另外加油。",
      "visual_cue": "培根卷边焦脆，锅底一层亮油"
    },
    {
      "n": 4,
      "text": "关火后把洋葱丝倒进锅里，用余温翻两下，让它吸培根油但不炒熟。",
      "time_min": 2,
      "heat": "小火",
      "tip": "洋葱只烫一下，保留脆感和辛香。",
      "visual_cue": "洋葱丝半透明，仍有脆度"
    },
    {
      "n": 5,
      "text": "菜丝、培根洋葱和锅里的油一起放进大碗，加苹果醋、植物油、白糖和香菜籽粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油和醋先拌开，味道才均匀。",
      "visual_cue": "菜丝表面泛油光，闻到酸香"
    },
    {
      "n": 6,
      "text": "用手抓拌两分钟，让每根菜丝都裹上油醋，撒黑胡椒，冷藏二十分钟后上桌。",
      "time_min": 22,
      "heat": "无火",
      "tip": "抓拌比筷子拌更容易入味。",
      "visual_cue": "菜丝软塌有味，盘底微有汤汁"
    }
  ],
  "tips": [
    "用刨丝刀切，速度快且宽度统一。",
    "喜欢更酸可以多加十毫升苹果醋。",
    "冷藏过夜风味更融合，第二天更好吃。"
  ],
  "common_mistakes": [
    "菜丝切得太粗，拌好还是硬邦邦。",
    "盐杀水后不挤干，拌好出一碗汤。",
    "培根煸到发黑，整盘沙拉带焦苦味。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "烟熏豆腐",
      "ratio": "80克:80克",
      "note": "素食版，油量加十毫升。"
    },
    {
      "original": "苹果醋",
      "substitute": "白葡萄酒醋",
      "ratio": "40毫升:40毫升",
      "note": "酸度接近，果香略淡。"
    }
  ],
  "variations": [
    "加一勺黄芥末进油醋汁，风味更接近巴伐利亚做法。",
    "拌入少量胡萝卜丝，颜色更亮，甜味也更明显。"
  ],
  "serving_suggestion": "配烤猪肘或香煎猪排，用酸味解油腻；也可夹进面包当野餐配菜。",
  "storage": "冷藏两天，次日风味更好；出水后倒掉汤汁再拌一次。",
