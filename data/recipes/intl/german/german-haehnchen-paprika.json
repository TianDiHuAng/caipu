  "equipment": [
    "平底锅",
    "木铲",
    "砧板",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成两厘米宽的条，用厨房纸吸干表面水分。",
      "time_min": 9,
      "heat": "无火",
      "tip": "表面干爽下锅才上色，湿的下锅只会出水。",
      "visual_cue": "肉条干爽，切口整齐，状态正好"
    },
    {
      "n": 2,
      "text": "肉条撒一半盐与黑胡椒抓匀，静置十分钟入底味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌十分钟就够，时间久了肉会出水变柴。",
      "visual_cue": "肉条泛盐光，手感发黏，很有食欲"
    },
    {
      "n": 3,
      "text": "平底锅倒一半植物油烧热，肉条平铺下锅煎三分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "别一次倒太多，摊得太挤就变成煮肉了。",
      "visual_cue": "底面金黄，锅底起焦香，感觉清爽"
    },
    {
      "n": 4,
      "text": "翻面再煎两分钟，盛出备用，锅底焦香别洗掉。",
      "time_min": 3,
      "heat": "中火",
      "tip": "锅底那层褐色是香味，等下用高汤化开就是底味。",
      "visual_cue": "两面微黄，锅底留香，火候刚好"
    },
    {
      "n": 5,
      "text": "原锅补油，下洋葱丝与蒜末小火炒到透明出香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蒜末最后再放，早放容易在锅底烧焦。",
      "visual_cue": "洋葱透明，蒜香浮起，让人安心"
    },
    {
      "n": 6,
      "text": "加甜椒条与口蘑片，中火翻炒四分钟到略软出水。",
      "time_min": 5,
      "heat": "中火",
      "tip": "甜椒别炒太久，留点脆感口感才不闷。",
      "visual_cue": "甜椒变软，蘑菇收紧，看着舒服"
    },
    {
      "n": 7,
      "text": "撒面粉与红椒粉翻匀，倒高汤搅开锅底的焦香物。",
      "time_min": 4,
      "heat": "中火",
      "tip": "红椒粉遇油出红，翻十秒就要加汤，否则发苦。",
      "visual_cue": "汤汁泛红，锅底干净，状态正好"
    },
    {
      "n": 8,
      "text": "鸡肉回锅小火炖八分钟，倒淡奶油煮到汤汁浓稠。",
      "time_min": 10,
      "heat": "小火",
      "tip": "奶油最后放，久煮会分层，汤汁看着发花。",
      "visual_cue": "汤汁挂勺，颜色奶红，很有食欲"
    },
    {
      "n": 9,
      "text": "加剩下的盐与黑胡椒调味，撒欧芹碎盛盘上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "奶油让咸味变钝，尝过再补盐，别一次加足。",
      "visual_cue": "酱汁油亮，香草点缀，感觉清爽"
    }
  ],
  "tips": [
    "红椒炖鸡是德国东部的家常菜，甜椒粉的用量很随意。",
    "配米饭、面条或土豆丸子都合适，汤汁别收太干。",
    "用鸡腿肉比鸡胸更嫩，久炖也不干。"
  ],
  "common_mistakes": [
    "鸡肉没吸干水就下锅，煎出来一锅白汤，完全不上色。",
    "红椒粉和蒜末一起早放，炒到最后带焦苦味。",
    "淡奶油大火煮，油水分离，汤汁看着像渣。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "酸奶",
      "ratio": "80毫升:100克",
      "note": "酸奶版须关火后加，一煮就结块。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600克:600克",
      "note": "鸡胸版煎的时间减一分，炖的时间别超五分钟。"
    }
  ],
  "variations": [
    "加一勺番茄泥同炖，颜色更红，酸味更开胃。",
    "放几片培根同煎，烟熏味和甜椒粉很搭，配面条最好。"
  ],
  "serving_suggestion": "盛深盘上桌，配黄油面条或土豆丸子，汤汁浇在面上。",
  "storage": "冷藏可存三天，冷冻可存一个月，复热时补少量高汤调开。",
