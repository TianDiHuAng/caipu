  "equipment": [
    "厚底锅",
    "木勺",
    "刀",
    "小碗",
    "擦丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米用清水冲两遍，沥干水。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冲掉表面浮粉，煮出来才清。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒洁白，水变清，这一点很关键。"
    },
    {
      "n": 2,
      "text": "锅里放牛奶、白糖、盐和柠檬皮，小火加热。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "别煮开，牛奶沸了会溢锅。，火候要稳，别忽大忽小。",
      "visual_cue": "锅边冒小泡，糖化开"
    },
    {
      "n": 3,
      "text": "倒入大米，搅匀后小火慢煮。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "小火",
      "tip": "一开锅就转小火。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒沉底，液面微动"
    },
    {
      "n": 4,
      "text": "盖盖留缝，小火煮三十五分钟，每五分钟搅一次。",
      "time_min": 37,
      "heat": "小火",
      "tip": "不搅会粘底，糊了整锅都苦。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒膨胀，汤体变稠"
    },
    {
      "n": 5,
      "text": "挑出柠檬皮，加黄油搅匀。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "黄油最后加，光泽才好。，火候要稳，别忽大忽小。",
      "visual_cue": "表面油亮，质地浓稠"
    },
    {
      "n": 6,
      "text": "杏仁干锅烘香，切碎撒面。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "小火",
      "tip": "烘到出香就离火，别烘焦。，火候要稳，别忽大忽小。",
      "visual_cue": "杏仁微黄，香气上涌"
    },
    {
      "n": 7,
      "text": "盛碗撒杏仁碎，温热或冷藏后吃。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冷藏后更浓稠，口感像布丁。，火候要稳，别忽大忽小。",
      "visual_cue": "表面平滑，米粒分明"
    }
  ],
  "tips": [
    "用圆粒米，煮出来才稠。，这一点很关键。",
    "每隔五分钟搅一次，防粘底。，这一点很关键。",
    "黄油最后加，光泽才好。，这一点很关键。"
  ],
  "common_mistakes": [
    "大火煮，牛奶溢锅糊底。，这一点很关键。",
    "不搅拌，锅底结一层焦。，这一点很关键。",
    "米没煮透，中间有硬芯。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "750 毫升:750 毫升",
      "note": "香气更浓，白糖减十克。"
    },
    {
      "original": "杏仁",
      "substitute": "葡萄干",
      "ratio": "40 克:50 克",
      "note": "提前用温水泡软。"
    }
  ],
  "variations": [
    "表面撒一层糖，用喷枪烧成脆壳。，这一点很关键。",
    "加一勺苹果酱，酸甜更清爽。，这一点很关键。"
  ],
  "serving_suggestion": "热吃当早餐，冷藏后当甜点。，这一点很关键。",
  "storage": "冷藏三天，表面盖膜防结皮。，这一点很关键。",
