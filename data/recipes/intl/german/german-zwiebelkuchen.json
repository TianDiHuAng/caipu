  "steps": [
    {
      "n": 1,
      "text": "牛奶温热，加酵母和白糖化开，静置五分钟。，火大了就离锅远一点。",
      "time_min": 7,
      "heat": "无火",
      "tip": "牛奶别烫手，太热会杀死酵母。，火别开太大，稳着来。",
      "visual_cue": "液面起泡，酵母活化"
    },
    {
      "n": 2,
      "text": "面粉加盐和一半黄油，倒入酵母水揉成团。，锅温要匀，别忽高忽低。",
      "time_min": 8,
      "heat": "无火",
      "tip": "揉到光滑，面才不发硬。，火力保持中等，慢慢来。",
      "visual_cue": "面团光滑，不粘手，这里最容易翻车。"
    },
    {
      "n": 3,
      "text": "盖布温暖处发一小时，到两倍大。，火候宁小勿大，慢慢推进。",
      "time_min": 62,
      "heat": "无火",
      "tip": "发到位，饼底才松软。，注意锅里温度别掉下来。",
      "visual_cue": "体积翻倍，指压回弹"
    },
    {
      "n": 4,
      "text": "洋葱切细丝，用剩余黄油小火炒二十分钟。，始终中小火，别心急。",
      "time_min": 22,
      "heat": "小火",
      "tip": "慢炒到软甜，别炒焦。，火要均匀，食材才不糊。",
      "visual_cue": "洋葱软塌，颜色金黄"
    },
    {
      "n": 5,
      "text": "培根丁下锅炒出油，和洋葱拌匀。，看住火，别让它失控。",
      "time_min": 5,
      "heat": "中火",
      "tip": "培根炒脆，口感才有对比。，全程留意火候，别贪快。",
      "visual_cue": "培根卷边，油光浮动"
    },
    {
      "n": 6,
      "text": "蛋液加淡奶油、盐和黑胡椒，搅匀成馅液。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋奶液别打发起泡。，火别开太大，稳着来。",
      "visual_cue": "液体顺滑，颜色淡黄"
    },
    {
      "n": 7,
      "text": "面团擀成烤盘大小，边缘卷起一厘米。，锅温要匀，别忽高忽低。",
      "time_min": 6,
      "heat": "无火",
      "tip": "边缘卷起，馅才不会流出去。，火力保持中等，慢慢来。",
      "visual_cue": "饼皮贴合，边缘立起"
    },
    {
      "n": 8,
      "text": "洋葱培根铺满饼皮，倒入蛋奶液。，火候宁小勿大，慢慢推进。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馅别铺太厚，烤不透。，注意锅里温度别掉下来。",
      "visual_cue": "馅料平整，液体浸匀"
    },
    {
      "n": 9,
      "text": "烤箱两百度烤三十五分钟，表面金黄凝固。，始终中小火，别心急。",
      "time_min": 37,
      "heat": "无火",
      "tip": "中心凝固才算熟。，火要均匀，食材才不糊。",
      "visual_cue": "表面金黄，轻晃不流动"
    },
    {
      "n": 10,
      "text": "出炉稍凉十分钟再切块。，看住火，别让它失控。",
      "time_min": 12,
      "heat": "无火",
      "tip": "凉一点切，馅才不散。，全程留意火候，别贪快。",
      "visual_cue": "切面平整，馅料紧实"
    }
  ],
  "tips": [
    "牛奶温热不烫手，酵母才活。，别小看这一步。",
    "洋葱慢炒到甜，是这道菜的灵魂。，成败就在这一步。",
    "中心凝固才算烤熟。，这点要注意。"
  ],
  "common_mistakes": [
    "牛奶太烫，酵母死掉发不起来。，这是关键点。",
    "洋葱没炒够，馅出水。，别嫌麻烦，做完它。",
    "烤不足，切开中间是稀的。，这一步别省。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "150 毫升:150 毫升",
      "note": "需多加一个鸡蛋固定。"
    },
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "180 克:180 克",
      "note": "咸味轻，盐可加一克。"
    }
  ],
  "variations": [
    "加一点孜然，香气更像德国南部风味。",
    "表面撒奶酪丝，烤出焦壳。，别跳过这步。"
  ],
  "serving_suggestion": "趁热切块，配新酒或苹果汁。，这步最关键。",
  "storage": "冷藏三天，复热用烤箱。，很多人在这里出错。",
