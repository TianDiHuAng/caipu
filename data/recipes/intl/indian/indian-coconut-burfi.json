  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "椰蓉",
          "name_en": "desiccated coconut",
          "amount": 250,
          "unit": "g",
          "note": "细丝状更易成团",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 200,
          "unit": "ml",
          "note": "全脂更香浓",
          "optional": false
        },
        {
          "name": "开心果",
          "name_en": "pistachio",
          "amount": 20,
          "unit": "g",
          "note": "去壳切碎装饰",
          "optional": false
        },
        {
          "name": "小豆蔻",
          "name_en": "cardamom",
          "amount": 2,
          "unit": "g",
          "note": "拍开取籽磨粉",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "按甜度可增减",
          "optional": false
        },
        {
          "name": "酥油",
          "name_en": "ghee",
          "amount": 20,
          "unit": "g",
          "note": "抹模具与增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "刮刀",
    "方形模具",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "椰蓉倒进厚底锅，加入牛奶用刮刀拌匀，静置十分钟让椰丝把奶吸透变软。",
      "time_min": 10,
      "heat": "无火",
      "tip": "吸透奶的椰丝下锅不易糊，成团也更紧实。",
      "visual_cue": "椰丝由干松变得湿润结团"
    },
    {
      "n": 2,
      "text": "厚底锅放上中小火，倒入白糖不停翻拌，糖化开后椰蓉会渐渐变得黏稠挂勺。",
      "time_min": 20,
      "heat": "中小火",
      "tip": "全程刮底翻拌，糖沉底最容易糊出焦味。",
      "visual_cue": "混合物冒细密气泡，颜色转浅黄"
    },
    {
      "n": 3,
      "text": "加入酥油与小豆蔻粉继续翻炒，直到整团料能离开锅底、刮刀划开留下清晰痕迹。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "能整团翻起不断裂就到位了，炒过头会发干。",
      "visual_cue": "料团离锅成团，刮刀痕迹不回缩"
    },
    {
      "n": 4,
      "text": "方形模具内壁抹一层酥油，把炒好的椰蓉料倒进去，用刮刀压平压实表面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压得越实切块越整齐，别留气泡与空隙。",
      "visual_cue": "表面平整，边角填满无缝隙"
    },
    {
      "n": 5,
      "text": "趁表面还温热撒上开心果碎并轻压固定，静置冷却到完全定型后再切块。",
      "time_min": 65,
      "heat": "无火",
      "tip": "一定要完全凉透再下刀切块，切面才平整，边缘也不会掉渣。",
      "visual_cue": "糕体变硬定型，开心果碎嵌在表面"
    }
  ],
  "tips": [
    "椰蓉选细丝无糖款，含糖椰蓉配上白糖容易过甜且更易糊锅。",
    "炒制时火候宁小勿大，糖在高温下很快焦化，一糊整锅都得倒掉。",
    "切块前把刀用温水烫一下擦干，切面干净不留毛边。",
    "想要更浓的奶香，可以把一半牛奶换成甜奶浆，白糖相应减少二十克。"
  ],
  "common_mistakes": [
    "牛奶与椰蓉冷锅直接开大火，锅底先糊一层，整锅带上焦苦味。",
    "炒得不够干就装模，切块时软塌粘刀，拿起来就散。",
    "没等完全凉透就切，糕体拉扯变形，切面粗糙掉渣。"
  ],
  "substitutions": [
    {
      "original": "椰蓉",
      "substitute": "椰丝",
      "ratio": "250克:250克",
      "note": "颗粒更粗，揉拌时多加二十毫升牛奶。"
    },
    {
      "original": "开心果",
      "substitute": "杏仁",
      "ratio": "20克:20克",
      "note": "同样切碎撒面，香气更浓但略带涩感。"
    }
  ],
  "variations": [
    "拌入两克可可粉做成双色层，先倒一半着色料再叠另一半。",
    "表面再撒一小把烤香的开心果碎，坚果香更明显，切块也更立体。"
  ],
  "serving_suggestion": "切成三厘米见方的小块，摆进铺油纸的浅盘，配一杯不加糖的红茶解甜。",
  "storage": "密封冷藏可放一周，冷藏后口感偏硬，室温回软十分钟再吃更合适，切勿受潮。",
