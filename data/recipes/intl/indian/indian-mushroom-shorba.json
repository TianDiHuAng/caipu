  "equipment": [
    "汤锅",
    "手持搅拌棒",
    "刀",
    "砧板",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "口蘑用湿布擦净表面泥土后切成三毫米薄片，洋葱、大蒜与姜分别切末。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蘑菇别用水泡，吸水后下锅只会出水，炒不出焦香。",
      "visual_cue": "蘑菇片干爽，切面白净不渗水"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油烧热，下洋葱末炒到透亮，再放蒜末与姜末炒出香味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蒜末姜末后放，早放容易在锅底焦黑发苦。",
      "visual_cue": "洋葱透明，蒜末微黄不焦"
    },
    {
      "n": 3,
      "text": "倒入口蘑片中大火翻炒到出水又收干，边缘出现金黄色焦边。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蘑菇要炒到水汽完全收干，这一步决定汤香不香。",
      "visual_cue": "蘑菇体积缩一半，锅底干爽"
    },
    {
      "n": 4,
      "text": "撒面粉翻匀炒一分钟，让每片蘑菇都裹上薄薄一层干粉。",
      "time_min": 2,
      "heat": "小火",
      "tip": "面粉必须炒过才没有生面味，但火大就焦了。",
      "visual_cue": "蘑菇表面泛白，看不到干粉颗粒"
    },
    {
      "n": 5,
      "text": "分两次倒入牛奶，边倒边搅避免结块，再加水煮到汤体微稠冒泡。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶分次倒，一次倒完容易在锅底结成硬块。",
      "visual_cue": "汤体顺滑挂勺，表面无颗粒"
    },
    {
      "n": 6,
      "text": "关火用搅拌棒打成细腻糊状，回锅加盐与黑胡椒，盛出撒香菜碎即可。",
      "time_min": 3,
      "heat": "小火",
      "tip": "想保留口感可以留一勺蘑菇片，最后放回汤里。",
      "visual_cue": "汤色奶褐均匀，表面无分层"
    }
  ],
  "tips": [
    "蘑菇选口蘑最稳，香菇味道重会盖住奶香。",
    "炒蘑菇时别急着翻，贴锅一面煎出焦边才有风味。",
    "汤太稠就加牛奶调，加水会让奶味变淡。",
    "上桌前滴两滴植物油在表面，光泽更好看。"
  ],
  "common_mistakes": [
    "蘑菇一进锅就加盐，水全出来变成煮蘑菇。",
    "牛奶一次倒入滚汤，结出一颗颗白色疙瘩。",
    "面粉没炒就加水，整锅汤带明显生粉气。",
    "打泥时汤太烫还盖紧盖子，热气把盖顶开溅一地。"
  ],
  "substitutions": [
    {
      "original": "口蘑",
      "substitute": "香菇",
      "ratio": "400 克:400 克",
      "note": "香气更冲，用量可减到三百克。"
    },
    {
      "original": "牛奶",
      "substitute": "椰浆",
      "ratio": "200 毫升:180 毫升",
      "note": "做成纯素版本，风味偏南洋。"
    }
  ],
  "variations": [
    "加一小勺孜然粉同炒，汤里会多一层温暖的辛香。",
    "最后撒一把烤香的腰果碎，口感更有嚼头。"
  ],
  "serving_suggestion": "装进宽口汤碗，表面撒香菜与黑胡椒，配一片烤饼蘸着吃，冬天当开胃汤最合适。",
  "storage": "冷藏可放两天，复热时加少量牛奶用小火搅开，别用大火否则奶汤会分层。",
