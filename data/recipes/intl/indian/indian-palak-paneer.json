  "equipment": [
    "汤锅",
    "搅拌机",
    "炒锅",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜放入沸水焯一分钟，捞出立刻过凉水挤干，去掉草涩味。",
      "time_min": 6,
      "heat": "大火",
      "tip": "过凉水能锁住绿色，成品不发黄。",
      "visual_cue": "菠菜翠绿，挤干后成团"
    },
    {
      "n": 2,
      "text": "焯好的菠菜加少量水打成细腻的绿色泥备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打泥时水别太多，太稀会挂不住奶酪。",
      "visual_cue": "绿色浓稠，能挂勺"
    },
    {
      "n": 3,
      "text": "奶酪切方块，用温热盐水浸泡五分钟使其软化。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡盐水能让奶酪更柔韧，不易碎。",
      "visual_cue": "奶酪块微弹，边缘圆润"
    },
    {
      "n": 4,
      "text": "炒锅下植物油，孜然粒炸香后下洋葱末、蒜末与姜末炒到微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到透明微黄，甜味才出来。",
      "visual_cue": "洋葱软塌，锅中有孜然香"
    },
    {
      "n": 5,
      "text": "加番茄块与咖喱粉炒三分钟，炒到番茄出沙变软。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒出沙状，酱底才浓稠。",
      "visual_cue": "锅底番茄化开成酱"
    },
    {
      "n": 6,
      "text": "倒入菠菜泥与奶油，小火煮五分钟，加盐调味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "保持小火，滚沸会让绿色变暗。",
      "visual_cue": "酱体浓绿，表面微微冒泡"
    },
    {
      "n": 7,
      "text": "轻轻放入奶酪块，小火再煮三分钟让奶酪吸味，别用力搅动。",
      "time_min": 4,
      "heat": "小火",
      "tip": "翻动要用推的，奶酪块才完整。",
      "visual_cue": "奶酪块裹上绿酱，形状完好"
    }
  ],
  "tips": [
    "菠菜焯水后要挤干，多余水分会稀释酱体。",
    "没有印度奶酪可用质地紧实的白奶酪代替。",
    "咖喱粉现炒一下香气更足，别直接撒进菠菜泥。"
  ],
  "common_mistakes": [
    "菠菜没焯水直接打泥，成品带涩味且发黑。",
    "大火滚煮菠菜泥，绿色几秒就变暗褐。",
    "用力搅拌导致奶酪块全碎，卖相与口感双失。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "北豆腐",
      "ratio": "250 克:300 克",
      "note": "切块煎至微黄，口感更接近但不含奶香。"
    },
    {
      "original": "奶油",
      "substitute": "牛奶",
      "ratio": "40 毫升:50 毫升",
      "note": "酱体更稀，需多煮两分钟收浓。"
    }
  ],
  "variations": [
    "加一勺原味酸奶同煮，酸香更开胃也更顺滑。",
    "把奶酪换成土豆块，做成菠菜土豆咖喱。"
  ],
  "serving_suggestion": "配印度烤饼或香米饭同食，淋一圈奶油装饰。",
  "storage": "冷藏两天；复热小火慢煮，避免奶酪碎散。",
