  "equipment": [
    "刨丝器",
    "纱布",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净纵向剖开，用勺子刮去中间的籽瓤，避免出水稀释酸奶。",
      "time_min": 4,
      "heat": "无火",
      "tip": "籽瓤水分最多，必须去净。",
      "visual_cue": "黄瓜内部只剩浅绿色瓜肉"
    },
    {
      "n": 2,
      "text": "黄瓜擦成细丝，加 2g 盐抓匀静置 10 分钟，用纱布用力挤干水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "挤得越干，酱才不会水汪汪。",
      "visual_cue": "黄瓜丝干爽、纱布拧不出水"
    },
    {
      "n": 3,
      "text": "孜然 3g 放入干锅小火焙 2 分钟至香气散出，取出略压碎。",
      "time_min": 3,
      "heat": "小火",
      "tip": "焙到微微跳动就要离火。",
      "visual_cue": "孜然飘出焦香、颜色转深"
    },
    {
      "n": 4,
      "text": "酸奶搅打至顺滑无颗粒，加入黄瓜丝、剩余 2g 盐与 1g 黑胡椒拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酸奶先搅顺，拌出的酱才细。",
      "visual_cue": "酱体浓稠均匀、黄瓜分布均匀"
    },
    {
      "n": 5,
      "text": "拌入焙香的孜然与薄荷碎，冷藏 15 分钟让风味融合后食用。",
      "time_min": 16,
      "heat": "无火",
      "tip": "冷藏后口感更清凉。",
      "visual_cue": "表面点缀薄荷、质地稠而不流"
    }
  ],
  "tips": [
    "黄瓜一定要去瓤挤水，否则半小时就出水。",
    "孜然现焙现压，香气比粉状强得多。",
    "酸奶选浓稠型，稀酸奶做出来像汤。"
  ],
  "common_mistakes": [
    "黄瓜不去瓤不挤水，端上桌就是一盘奶汤。",
    "酸奶没搅顺就拌，成品带一粒粒疙瘩。",
    "一次加足盐又腌黄瓜，咸得盖过奶香。"
  ],
  "substitutions": [
    {
      "original": "黄瓜",
      "substitute": "西红柿",
      "ratio": "200g 对 200g",
      "note": "番茄版需去籽切丁。"
    },
    {
      "original": "薄荷",
      "substitute": "香菜",
      "ratio": "8g 对 8g",
      "note": "香气更冲，用量可减至 6g。"
    }
  ],
  "variations": [
    "洋葱版：加 50g 紫洋葱碎，辛辣更开胃。",
    "土豆版：拌入 100g 熟土豆丁做成饱腹配菜。"
  ],
  "serving_suggestion": "配印度烤饼、咖喱或烤肉，用来解辣解腻。",
  "storage": "冷藏 2 天，食用前重新拌匀。",
