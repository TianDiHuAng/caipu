  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆提前泡一夜后煮到软烂，用手一捏就碎，捞出沥干留少许煮豆水。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煮到一捏就碎，口感才绵。",
      "visual_cue": "豆子软烂、外皮微裂"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下孜然粒小火爆香，再加洋葱末炒到金黄。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒到金黄油亮，甜味才出。",
      "visual_cue": "孜然跳动、洋葱金黄"
    },
    {
      "n": 3,
      "text": "加姜末、蒜末、小米椒与番茄丁，中火炒到番茄完全塌软出汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒成酱状，是咖喱的底。",
      "visual_cue": "番茄成酱、锅底见红油"
    },
    {
      "n": 4,
      "text": "下咖喱粉、姜黄与辣椒粉炒三十秒出香，倒入鹰嘴豆与清水。",
      "time_min": 12,
      "heat": "小火",
      "tip": "香料遇油才出香，别直接下水。",
      "visual_cue": "香料融合、酱汁橙红"
    },
    {
      "n": 5,
      "text": "小火煮十二分钟至酱汁浓稠裹住豆子，加盐与柠檬汁，撒香菜。",
      "time_min": 2,
      "heat": "小火",
      "tip": "收汁到勺子划开能留痕。",
      "visual_cue": "酱汁浓稠、豆子挂汁"
    }
  ],
  "tips": [
    "香料一定要在油里炒过再加水，干撒进去只有粉味没有香。",
    "鹰嘴豆煮到一捏即碎，咖喱的绵密口感全靠它。",
    "柠檬汁最后加，酸味才明亮，久煮会发苦。"
  ],
  "common_mistakes": [
    "香料直接倒进汤里煮，香气完全出不来。",
    "鹰嘴豆煮得不够烂，吃起来颗粒发硬。",
    "酱汁不收浓就关火，整盘水汪汪像豆汤。"
  ],
  "substitutions": [
    {
      "original": "鹰嘴豆",
      "substitute": "白芸豆",
      "ratio": "400g 对 400g",
      "note": "口感更粉，煮制时间减 3 分钟。"
    },
    {
      "original": "咖喱粉",
      "substitute": "咖喱块",
      "ratio": "12g 对 25g",
      "note": "含盐，盐量减半。"
    }
  ],
  "variations": [
    "菠菜版：最后加 150g 菠菜煮软。",
    "酸奶版：关火后拌入 80g 酸奶增稠。"
  ],
  "serving_suggestion": "配印度面饼或白米饭，旁边放几片生洋葱与柠檬角。",
  "storage": "冷藏可存 3 天，冷冻 1 个月，复热需加水稀释。",
