  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "木铲",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉切成两厘米小块，用一半盐与姜黄抓匀腌十分钟，洋葱姜蒜切末。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鸡肉先腌再下锅，表面有底味也不会在煮的过程中变柴。",
      "visual_cue": "鸡块表面挂满黄色粉末"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油中火烧热，下孜然与咖喱叶炸到香气散出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温不够咖喱叶不会卷，香气也出不来。",
      "visual_cue": "咖喱叶卷边，油面浮起细泡"
    },
    {
      "n": 3,
      "text": "放洋葱末、姜末与蒜末炒到洋葱透亮，锅底出现浅褐色焦香层。",
      "time_min": 5,
      "heat": "中火",
      "tip": "这一步炒得越透，汤的底味越厚，别急着加水。",
      "visual_cue": "洋葱软塌透明，锅底泛焦糖色"
    },
    {
      "n": 4,
      "text": "倒入鸡块翻炒到表面变白，加水没过食材，小火煮十二分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "鸡肉变白就加水，久炒会让肉质发紧、汤也浑。",
      "visual_cue": "鸡块通体变白，汤面浮起少量浮沫"
    },
    {
      "n": 5,
      "text": "撇掉表面浮沫，倒入椰浆搅匀，加剩下的盐与黑胡椒小火再煮三分钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椰浆下锅后不要大滚，滚久了油脂会析出浮在表面。",
      "visual_cue": "汤色转成奶白，表面油花细小"
    },
    {
      "n": 6,
      "text": "尝味补盐，关火撒香菜碎，静置两分钟让香气融合后盛出。",
      "time_min": 2,
      "heat": "无火",
      "tip": "静置两分钟再盛，香料味会和椰香融得更匀。",
      "visual_cue": "汤面平静，香菜保持翠绿"
    }
  ],
  "tips": [
    "鸡胸肉换成鸡腿肉更嫩，煮的时间要加五分钟。",
    "椰浆选浓稠款，稀的罐装椰奶香味不够。",
    "想更酸爽可以挤半个青柠，酸味能提亮椰香。",
    "汤别收太干，留足汤水才有喝汤的口感。"
  ],
  "common_mistakes": [
    "鸡肉腌完直接下滚水，表面姜黄全被冲掉。",
    "椰浆和鸡肉一起久煮，汤变得浑浊还带腥气。",
    "咖喱叶炸到发黑才下洋葱，整锅汤带焦苦。",
    "盐一次放足后又收汁，最后咸得没法喝。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "400 克:400 克",
      "note": "煮的时间延长到十七分钟，肉质更滑。"
    },
    {
      "original": "椰浆",
      "substitute": "牛奶",
      "ratio": "200 毫升:200 毫升",
      "note": "香气变淡，可多加一克孜然补味。"
    }
  ],
  "variations": [
    "加一小把煮熟的鹰嘴豆同煮，汤会更饱腹。",
    "收尾撒一撮烤椰丝，香气更接近南印沿海做法。"
  ],
  "serving_suggestion": "用深碗盛出，鸡肉沉在汤里，表面撒香菜，配米饭或烤饼都能把汤喝干净。",
  "storage": "冷藏可放两天，复热用小火慢加热并搅动，椰浆分离时加两勺热水搅匀即可。",
