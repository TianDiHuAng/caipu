        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "盆",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "薄荷叶洗净沥干，切得细碎，与盐、小茴香、辣椒粉拌成香料末。",
      "time_min": 9,
      "heat": "无火",
      "tip": "叶片一定要沥干，带水会把饼泡软。",
      "visual_cue": "薄荷碎呈深绿色细末。"
    },
    {
      "n": 2,
      "text": "面粉加盐与一半香料末拌匀，分次加清水揉成软面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "香料先和进面里，饼才有底味。",
      "visual_cue": "面团带浅绿色斑点。"
    },
    {
      "n": 3,
      "text": "盖上湿布松弛三十分钟，把面团分成六份分别搓圆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "松弛够，擀的时候不回缩。",
      "visual_cue": "剂子柔软有弹性。"
    },
    {
      "n": 4,
      "text": "剂子擀成薄圆片，刷酥油，撒剩下的薄荷香料末。",
      "time_min": 9,
      "heat": "无火",
      "tip": "香料末撒匀，别堆在一处。",
      "visual_cue": "薄片上油光与绿末交错。"
    },
    {
      "n": 5,
      "text": "卷成长条再盘成螺旋，压扁后擀成六毫米厚的饼坯。",
      "time_min": 10,
      "heat": "无火",
      "tip": "轻擀慢推，别把层次压死。",
      "visual_cue": "饼坯能看出螺旋纹路。"
    },
    {
      "n": 6,
      "text": "平底锅刷酥油中火烙三分钟，翻面刷油再烙两分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "两面都要刷油，饼边才酥。",
      "visual_cue": "两面焦斑均匀，饼身鼓起。"
    },
    {
      "n": 7,
      "text": "出锅后用手轻拍饼边把层次拍散，趁热装盘上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "热的时候拍，层次才分得开。",
      "visual_cue": "饼散成薄片，薄荷香扑鼻。"
    }
  ],
  "tips": [
    "薄荷用新鲜的最好，干薄荷香气差一半。",
    "香料末别一次全用，留一半刷在层间更香。",
    "喜欢更清爽的口感，可以把辣椒粉减到 1g。"
  ],
  "common_mistakes": [
    "薄荷叶没沥干就切，饼中间湿黏、层次粘死。",
    "香料末撒太多，饼咸得发苦，盖住薄荷清香。"
  ],
  "substitutions": [
    {
      "original": "薄荷",
      "substitute": "香菜",
      "ratio": "40g 对 40g",
      "note": "香菜版更温和，香气偏暖。"
    }
  ],
  "variations": [
    "拉贾斯坦版本会加一小勺干芒果粉，酸味明亮，配油炸小吃特别搭。"
  ],
  "serving_suggestion": "配酸奶沙拉或咖喱豆汤，夏天吃最清爽。",
  "storage": "冷藏两天，复热用平底锅干烙一分钟。",
