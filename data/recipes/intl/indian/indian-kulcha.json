      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "盆",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉过筛，加酵母、白糖与盐拌匀，倒入酸奶与清水揉成软面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团要揉到表面光滑，出筋才起层。",
      "visual_cue": "面团表面光滑不粘手。"
    },
    {
      "n": 2,
      "text": "面团抹薄油，盖保鲜膜放在温暖处发酵一小时至体积翻倍。",
      "time_min": 5,
      "heat": "无火",
      "tip": "温度低就多发一会儿，看状态不看钟。",
      "visual_cue": "面团涨大、指按回弹慢。"
    },
    {
      "n": 3,
      "text": "洋葱切细末，用厨房纸吸去多余汁水，与香菜、小茴香拌匀成馅。",
      "time_min": 10,
      "heat": "无火",
      "tip": "洋葱汁水挤干，否则饼会被泡破。",
      "visual_cue": "馅料干爽不流水。"
    },
    {
      "n": 4,
      "text": "发好的面团分成六份，每份包入两勺洋葱馅，收口捏紧后静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "收口一定捏严，擀的时候才不破。",
      "visual_cue": "面团圆润，收口朝下。"
    },
    {
      "n": 5,
      "text": "把包好馅的面团轻轻擀成椭圆饼，表面刷水撒芝麻并按实。",
      "time_min": 8,
      "heat": "无火",
      "tip": "馅饼只能轻擀，用力就破皮漏馅。",
      "visual_cue": "饼坯表面芝麻均匀。"
    },
    {
      "n": 6,
      "text": "平底锅烧热不放油，饼坯下锅烙两分钟至底面起斑，翻面再烙两分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "干烙定型后再刷油，饼才不会软塌。",
      "visual_cue": "底面焦斑密布，饼身鼓起。"
    },
    {
      "n": 7,
      "text": "刷上植物油，把饼按在锅边压着烙到两面酥脆，出锅稍压散层。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "压着烙能让层次分开，吃起来一片片。",
      "visual_cue": "外层金黄起酥，用手一拍能散层。"
    }
  ],
  "tips": [
    "酸奶让饼皮更软，记得选无糖原味的那种。",
    "洋葱馅一定要挤干水，否则饼中间湿塌。",
    "吃之前用手轻轻拍散，层次才漂亮。"
  ],
  "common_mistakes": [
    "洋葱馅带水下锅烙，饼中间泡软、整张塌陷。",
    "面团没发起来就烙，饼硬得像饼干。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "牛奶",
      "ratio": "100g 对 90ml",
      "note": "牛奶和的面偏硬，需多加 10ml 清水。"
    }
  ],
  "variations": [
    "阿姆利则的店铺会在馅料里加一小勺石榴籽粉提酸，颜色微红，酸香更明显。"
  ],
  "serving_suggestion": "配黄油鸡或鹰嘴豆咖喱，撕开蘸酱汁吃。",
  "storage": "冷藏两天，复热用平底锅干烙一分钟，别用微波炉。",
