    "汤锅",
    "炒锅",
    "锅铲",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆挑去坏豆，用清水泡八小时，泡到豆身发胀、指甲能掐动。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡不透的豆子煮两小时也硬，泡够时间才省火。",
      "visual_cue": "豆子胀大一圈，表皮起皱。"
    },
    {
      "n": 2,
      "text": "泡好的红豆换清水，大火烧开转小火煮二十五分钟，煮到一捏就碎。",
      "time_min": 8,
      "heat": "小火",
      "tip": "煮豆水别倒，留着调咖喱的浓稠度。",
      "visual_cue": "豆子一压成泥，汤汁发暗红。"
    },
    {
      "n": 3,
      "text": "洋葱切细丝，番茄切小块，姜与大蒜分别剁成细末备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "姜蒜剁得越细，炒出来的底味越匀。",
      "visual_cue": "配料分装齐整，洋葱丝粗细一致。"
    },
    {
      "n": 4,
      "text": "植物油下锅炒洋葱丝，炒到边缘焦黄发甜，再放姜末蒜末炒香。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱要炒够时间，焦糖化才有印度咖喱的甜底。",
      "visual_cue": "洋葱丝深黄发软，油色转金。"
    },
    {
      "n": 5,
      "text": "放番茄丁炒到化成糊，加咖喱粉、姜黄与孜然炒到油色红亮。",
      "time_min": 8,
      "heat": "中火",
      "tip": "香料下锅后要小火炒，火大立刻发苦。",
      "visual_cue": "锅底油色红亮，香料味冲鼻。"
    },
    {
      "n": 6,
      "text": "倒入红豆与煮豆水，小火煮十五分钟，用勺背压碎部分豆子让汤汁变稠。",
      "time_min": 9,
      "heat": "小火",
      "tip": "压碎一部分豆子是让它自然挂汁的诀窍。",
      "visual_cue": "汤汁浓稠裹勺，豆子软糯。"
    },
    {
      "n": 7,
      "text": "加盐调味，撒香菜碎，配米饭或烤饼一起上桌。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盐最后放，早放豆子不容易煮软。",
      "visual_cue": "表面浮一层红油，香菜点缀。"
    }
  ],
  "tips": [
    "红豆一定要泡足八小时，赶时间就用热水泡三小时。",
    "洋葱炒到焦黄是 Rajma 的甜味来源，别急着下番茄。",
    "剩的咖喱隔夜更好吃，豆子会把香料味吸得更透。"
  ],
  "common_mistakes": [
    "豆子没泡就直接煮，煮到汤干豆心还硬。",
    "香料和番茄一起下锅，香料没炒开、味道发闷。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "红腰豆罐头",
      "ratio": "300g 干豆 对 400g 罐头",
      "note": "用罐头要冲洗掉糖水，煮的时间缩到八分钟。"
    }
  ],
  "variations": [
    "旁遮普家庭会加一小块黄油与半勺奶油收尾，咖喱更顺口，代价是热量翻倍。"
  ],
  "serving_suggestion": "浇在热白饭上，配一片洋葱和青柠角解腻。",
  "storage": "冷藏三天，冷冻一个月；复热时加清水调稀。",
