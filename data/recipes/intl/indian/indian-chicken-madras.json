    "刀",
    "砧板",
    "木铲",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切四厘米块，用姜黄与一半盐抓匀腌十五分钟，洋葱番茄切好备用。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌鸡肉的碗别装太满，留出空间抓拌更均匀。",
      "visual_cue": "鸡块通体染成黄色，汁水微稠"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油中火烧热，下芥末籽炸到籽粒全部跳起、颜色转灰。",
      "time_min": 2,
      "heat": "中火",
      "tip": "芥末籽跳起来才算油温够，不跳说明油太凉。",
      "visual_cue": "籽粒噼啪跳动，油面起泡"
    },
    {
      "n": 3,
      "text": "放咖喱叶与洋葱末炒到洋葱软塌透明，再下姜末蒜末炒出香味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱要炒到体积明显缩小，甜味出来咖喱才厚。",
      "visual_cue": "洋葱缩水一半，锅底呈浅褐色"
    },
    {
      "n": 4,
      "text": "倒入鸡块摊开煎到表面变白，加番茄块炒到出汁、番茄皮卷起。",
      "time_min": 8,
      "heat": "大火",
      "tip": "鸡块先煎后翻，表面有焦色才香，别一直搅。",
      "visual_cue": "鸡块边缘上色，番茄塌成泥"
    },
    {
      "n": 5,
      "text": "加辣椒粉与剩下的盐翻匀，盖盖小火焖十二分钟至鸡肉软嫩。",
      "time_min": 12,
      "heat": "小火",
      "tip": "辣椒粉这时加不容易焦，也能让辣味渗进肉里。",
      "visual_cue": "汤汁变浓，鸡肉能轻松戳透"
    },
    {
      "n": 6,
      "text": "倒入椰浆搅匀小火煮三分钟，撒香菜碎关火，静置两分钟再盛出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椰浆下锅后别大滚，滚久油脂析出会浮一层油。",
      "visual_cue": "酱汁呈橙红奶色，表面油花细"
    }
  ],
  "tips": [
    "马德拉斯风味的辣度偏高，辣椒粉可按口味减到四克。",
    "椰浆选浓稠的，稀椰奶会让酱汁变水。",
    "配烤饼或白饭都好，酱汁多留一点更下饭。",
    "隔夜再吃味道更融合，复热时加点水调稀。"
  ],
  "common_mistakes": [
    "芥末籽没等跳起就下洋葱，香气出不来还带生油味。",
    "椰浆和辣椒粉一起久煮，酱汁发暗还带苦味。",
    "鸡肉没煎上色就加水，成品颜色灰白没有食欲。",
    "焖的时候火太大，锅底焦糊整锅带苦。"
  ],
  "substitutions": [
    {
      "original": "椰浆",
      "substitute": "酸奶",
      "ratio": "200 毫升:180 克",
      "note": "酸味更明显，需关火前调入避免分离。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "羊肉",
      "ratio": "600 克:600 克",
      "note": "焖的时间延长到二十五分钟。"
    }
  ],
  "variations": [
    "加两个土豆块同焖，酱汁会被土豆吸得很香。",
    "收尾挤半个柠檬，酸味能让辣味更干净。"
  ],
  "serving_suggestion": "装进深盘，酱汁裹住鸡块，配印度烤饼或香米饭，旁边放洋葱丝与柠檬角。",
  "storage": "冷藏可放两天，酱汁会凝成冻状，复热时加两勺水小火化开，不要用大火。",
