  "steps": [
    {
      "n": 1,
      "text": "菠菜洗净入沸水氽 90 秒，捞出立刻放入冰水中冷却。",
      "time_min": 6,
      "heat": "大火",
      "tip": "冰水定色，菠菜泥才不发暗。",
      "visual_cue": "菠菜深绿、挤水后不掉色"
    },
    {
      "n": 2,
      "text": "菠菜挤干水分切段，与 10g 尖椒一起打成细腻菜泥备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打得越细，成品口感越顺。",
      "visual_cue": "菜泥细腻、无粗纤维"
    },
    {
      "n": 3,
      "text": "印度奶酪切 2cm 方块，用平底锅小火干煎至两面微黄，泡入温水备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "煎过的奶酪更结实，煮的时候不散。",
      "visual_cue": "奶酪块表面浅黄、按压有弹性"
    },
    {
      "n": 4,
      "text": "炒锅化开 30g 黄油，下 4g 小茴香爆香，加洋葱碎与蒜末炒至透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒到透亮才够甜，别急着放别的。",
      "visual_cue": "洋葱呈半透明、边缘微焦"
    },
    {
      "n": 5,
      "text": "下姜泥与番茄丁炒 5 分钟至软烂出油，加 8g 咖喱粉与 3g 姜黄炒香。",
      "time_min": 7,
      "heat": "中火",
      "tip": "香料要炒到出油，香料生味才散。",
      "visual_cue": "番茄炒化、香料与油融合成酱"
    },
    {
      "n": 6,
      "text": "倒入菠菜泥与 150ml 清水小火煮 5 分钟，放奶酪块与 6g 盐再煮 3 分钟，起锅淋 40ml 奶油。",
      "time_min": 10,
      "heat": "小火",
      "tip": "菠菜泥后放，久煮会失去绿色。",
      "visual_cue": "酱汁浓稠、奶酪块完整"
    }
  ],
  "tips": [
    "菠菜氽水后立刻过冰水，成品才会保持鲜绿。",
    "印度奶酪干煎后泡温水，煮的时候不容易散碎。",
    "香料要炒到出油再下菠菜泥，香味才立体。"
  ],
  "common_mistakes": [
    "菠菜直接下锅久煮，成品呈暗褐色。",
    "奶酪没煎直接煮，一搅就碎成渣。",
    "香料没炒透就加水，吃起来带生粉味。"
  ],
  "substitutions": [
    {
      "original": "印度奶酪",
      "substitute": "北豆腐",
      "ratio": "250g 对 300g",
      "note": "素食可用，需提前用盐开水泡 10 分钟。"
    },
    {
      "original": "奶油",
      "substitute": "椰浆",
      "ratio": "40ml 对 50ml",
      "note": "全素版本，奶香换成椰香。"
    }
  ],
  "variations": [
    "奶酪碎版：把奶酪刨碎拌入，酱汁更浓。",
    "鸡肉版：加 300g 鸡腿肉同煮，即 Palak Chicken。"
  ],
  "serving_suggestion": "配印度烤饼或巴斯马蒂米饭同食，佐一碟酸奶解辣。",
  "storage": "冷藏 2 天，复热时小火加少量水调开，避免糊底。",
