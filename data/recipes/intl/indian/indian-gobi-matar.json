  "steps": [
    {
      "n": 1,
      "text": "花菜拆成小朵泡淡盐水十分钟，捞出后用清水冲洗两遍，彻底沥干水分。",
      "time_min": 9,
      "heat": "无火",
      "tip": "花菜缝里的泥沙要泡出来，否则一咬一嘴沙。",
      "visual_cue": "花菜朵大小一致，沥到不滴水。"
    },
    {
      "n": 2,
      "text": "锅里倒植物油烧到微热，下孜然粒炸到在油里轻轻跳动，再放洋葱丝炒到透明。",
      "time_min": 8,
      "heat": "中火",
      "tip": "孜然要冷油下锅慢慢炸，热油一放就糊。",
      "visual_cue": "孜然微鼓，洋葱边缘透亮。"
    },
    {
      "n": 3,
      "text": "加姜末与蒜末炒出香味，放番茄丁炒到出汁变软，撒姜黄与辣椒粉炒到油色红亮。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄要炒到化成糊，咖喱的稠度才够。",
      "visual_cue": "锅底油色红亮，番茄炒成糊。"
    },
    {
      "n": 4,
      "text": "先放花菜梗与豌豆下锅翻匀上色，加清水盖上锅盖焖五分钟。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "先焖梗再放朵，两者的熟度才能一起到位。",
      "visual_cue": "花菜梗变软，锅内汤汁略收。"
    },
    {
      "n": 5,
      "text": "再把花菜朵铺在上面继续焖五分钟，中途翻动两次，让花菜裹满料汁。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "花菜别焖过头，留一点脆口更好吃。",
      "visual_cue": "花菜挂汁发亮，豌豆由浅转深。"
    },
    {
      "n": 6,
      "text": "加盐调味，撒香菜碎，开大火收干多余汤汁后出锅装盘。",
      "time_min": 5,
      "heat": "大火",
      "tip": "香菜最后撒，久煮香气就散了，关火前切碎再撒更好。",
      "visual_cue": "汤汁贴住食材，盘底不见汤水。"
    }
  ],
  "tips": [
    "花菜先用淡盐水泡过，缝隙里的泥沙和虫子才出得来。",
    "孜然整粒炸过再炒，香气比直接撒孜然粉厚一层。",
    "家里有酥油可以把植物油换掉一半，印度味更足。"
  ],
  "common_mistakes": [
    "花菜梗和花菜朵同时下锅，梗还硬着、朵已经烂成泥。",
    "孜然在滚油里炸，两秒就发黑发苦，整锅都带苦尾。"
  ],
  "substitutions": [
    {
      "original": "花菜",
      "substitute": "西兰花",
      "ratio": "500g 对 500g",
      "note": "西兰花更易熟，焖的时间缩到三分钟。"
    }
  ],
  "variations": [
    "印度北部家庭会在起锅前加一勺酸奶拌匀，酸香更浓，配烤饼吃正好。"
  ],
  "serving_suggestion": "配印度烤饼或白米饭，旁边放一小碟酸奶解辣。",
  "storage": "冷藏两天，复热时加两勺清水，小火翻热。",
