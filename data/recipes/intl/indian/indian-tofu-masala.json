  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成三厘米见方的块，用厨房纸吸干表面的水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面吸干再煎，才不粘锅也不溅油。",
      "visual_cue": "豆腐块方正，表面干爽"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油烧热，把豆腐块煎到两面金黄盛出。",
      "time_min": 8,
      "heat": "中火",
      "tip": "豆腐煎出硬壳，后面炖煮才不散。",
      "visual_cue": "豆腐金黄，边缘挺括"
    },
    {
      "n": 3,
      "text": "番茄切块，洋葱切碎末，蒜和姜分别切成细末备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "洋葱切得越碎，炒化后酱汁才顺滑。",
      "visual_cue": "配料细碎，番茄多汁"
    },
    {
      "n": 4,
      "text": "炒锅放黄油化开，下洋葱末中火炒到软塌透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "黄油别烧到冒烟，微黄出香就可以下洋葱。",
      "visual_cue": "洋葱软塌，黄油微褐"
    },
    {
      "n": 5,
      "text": "加蒜末、姜末、辣椒粉和姜黄粉炒香，再下番茄块。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料先炒出油香，咖喱底味才厚。",
      "visual_cue": "香料出油，油色红亮"
    },
    {
      "n": 6,
      "text": "番茄炒到成糊状，倒入牛奶搅匀，加盐调成浓酱汁。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶小火慢慢搅入，酱汁才不结絮。",
      "visual_cue": "酱汁浓稠，颜色橘红"
    },
    {
      "n": 7,
      "text": "放回煎好的豆腐块，小火轻推炖五分钟让豆腐入味。",
      "time_min": 5,
      "heat": "小火",
      "tip": "轻推不翻搅，豆腐块才能保持完整。",
      "visual_cue": "豆腐挂汁，酱面油亮"
    },
    {
      "n": 8,
      "text": "关火撒上香菜碎，装盘后配烤饼或米饭一起上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜关火以后撒，清香才不被热气冲散。",
      "visual_cue": "香菜翠绿，咖喱冒热气"
    }
  ],
  "tips": [
    "豆腐先煎出硬壳，炖煮的时候才不散块。",
    "香料和洋葱一起炒出油香，咖喱底味才厚。",
    "牛奶要小火慢慢搅进去，酱汁才不会结絮。"
  ],
  "common_mistakes": [
    "豆腐不吸干直接煎，锅里溅油又粘底。",
    "牛奶大火倒入，酱汁立刻结成絮状。",
    "番茄没炒成糊就加奶，咖喱味淡又稀。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "奶酪",
      "ratio": "500 克:400 克",
      "note": "用印度奶酪块，煎制时间缩短两分钟。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "80 毫升:70 毫升",
      "note": "更浓郁，盐减一克。"
    }
  ],
  "variations": [
    "加一把青豌豆，颜色和口感更活泼。",
    "最后淋一勺黄油，香气更接近餐馆版。"
  ],
  "serving_suggestion": "配印度烤饼蘸着吃，或浇在米饭上做成盖饭。",
  "storage": "冷藏两天，复热小火加少许水炖透。",
