  "equipment": [
    "炒锅",
    "搅拌机",
    "碗",
    "刀",
    "砧板",
    "烤箱或平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切块，用酸奶、姜黄、辣椒粉、一半盐与姜泥抓匀，冷藏腌三十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "酸奶腌能让鸡肉更嫩，别用含糖风味酸奶。",
      "visual_cue": "鸡肉表面裹满乳白腌料"
    },
    {
      "n": 2,
      "text": "腰果用温水泡十分钟，与少量水打成细腻糊状备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腰果糊是浓稠度的关键，打到没有颗粒。",
      "visual_cue": "腰果糊顺滑无颗粒"
    },
    {
      "n": 3,
      "text": "平底锅下植物油中大火，把腌好的鸡块煎至表面焦黄、内部断生后盛出。",
      "time_min": 10,
      "heat": "大火",
      "tip": "腌料尽量抖掉再煎，否则容易糊锅。",
      "visual_cue": "鸡块表面有焦斑，肉汁清亮"
    },
    {
      "n": 4,
      "text": "另起锅融化四十克黄油，下孜然粒炒香后加洋葱丁炒八分钟至微黄。",
      "time_min": 10,
      "heat": "中火",
      "tip": "洋葱炒到边缘焦黄，甜味才出来。",
      "visual_cue": "洋葱软甜，锅底微焦糖色"
    },
    {
      "n": 5,
      "text": "加蒜末、生姜、芫荽籽与番茄块煮十分钟至番茄完全塌软。",
      "time_min": 12,
      "heat": "中火",
      "tip": "番茄要煮到出沙，酱体才浓。",
      "visual_cue": "番茄化成糊状，油浮在表面"
    },
    {
      "n": 6,
      "text": "把锅中酱料打成细腻糊再过筛回锅，加腰果糊与鸡块小火煮十分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "过筛一步能去掉番茄皮与籽，口感才滑。",
      "visual_cue": "酱体橙红细腻，鸡块半浸其中"
    },
    {
      "n": 7,
      "text": "加剩余黄油、奶油、白糖与剩余盐调味，撒葛拉姆马萨拉与香菜。",
      "time_min": 5,
      "heat": "小火",
      "tip": "黄油和奶油最后加，香气才不被煮散。",
      "visual_cue": "表面浮一层橙黄油光"
    }
  ],
  "tips": [
    "配印度烤饼或香料米饭，撒一点干辣椒碎更香。",
    "葛拉姆马萨拉一定要最后撒，久煮会苦。",
    "酱体偏酸时可多加五克糖，别用碱中和。"
  ],
  "common_mistakes": [
    "鸡肉腌的时间不够，内部发柴没味道。",
    "番茄没煮透就打糊，酱体带生涩味。",
    "全程大火收汁，奶油分离出油、酱汁发花。"
  ],
  "substitutions": [
    {
      "original": "腰果",
      "substitute": "杏仁",
      "ratio": "50 克:50 克",
      "note": "需泡更久，打糊时多加点水。"
    },
    {
      "original": "奶油",
      "substitute": "牛奶",
      "ratio": "100 毫升:120 毫升",
      "note": "酱体更稀，需多收五分钟。"
    }
  ],
  "variations": [
    "把鸡肉换成印度奶酪块，可做素食版黄油奶酪。"
  ],
  "serving_suggestion": "配印度烤饼、香料米饭与洋葱圈。",
  "storage": "冷藏三天，冷冻一个月；复热小火加少量水，避免大火滚沸分离。",
