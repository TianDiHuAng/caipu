  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去皮后切成两厘米见方的块，用一半盐与黑胡椒抓匀，静置十五分钟入味。",
      "time_min": 15,
      "heat": "无火",
      "tip": "抓匀后再等一会儿，肉质会收紧锁住汁水。",
      "visual_cue": "鸡块表面裹上薄薄一层调料"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油烧到微热，下洋葱碎、蒜末与姜末，中小火炒到洋葱变软发甜。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "洋葱别炒到发黄，留一点清甜更衬柠檬酸香。",
      "visual_cue": "洋葱变软透明，锅里香味散开"
    },
    {
      "n": 3,
      "text": "锅里加姜黄粉翻炒十几秒，放入鸡腿肉块翻动，让每块肉都裹上一层黄色油汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉块下锅后先别急翻，定型一面再动不易出水。",
      "visual_cue": "鸡块表面转白，裹上金黄调料层"
    },
    {
      "n": 4,
      "text": "倒入清水烧开，撇去浮沫后转小火，盖盖煮十八分钟让鸡块把鲜味释放到汤里。",
      "time_min": 18,
      "heat": "小火",
      "tip": "汤面保持微微冒泡的状态，滚太猛汤会浑。",
      "visual_cue": "汤色浅黄清亮，肉块浮在汤面"
    },
    {
      "n": 5,
      "text": "放入香菜茎与青椒丝再煮三分钟，撒剩下的盐与黑胡椒，尝一下咸淡。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香菜茎比叶子耐煮，先下茎后下叶香气更足。",
      "visual_cue": "青椒丝变软，汤里浮起绿色碎末"
    },
    {
      "n": 6,
      "text": "关火后撒香菜叶，挤入柠檬的汁水拌匀，盛进汤碗趁热喝。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁关火后再加，酸香才清亮不发闷。",
      "visual_cue": "汤面浮着翠绿香菜叶与青椒丝"
    }
  ],
  "tips": [
    "鸡腿肉比胸部肉耐煮，小火慢炖后仍然滑嫩，久煮也不至于发柴。",
    "黑胡椒要用研磨瓶现磨，粉状久放香气会跑掉大半。",
    "想让汤更清，鸡块下锅前先用热水汆一遍，撇净血沫再煮。",
    "柠檬用量按口味微调，怕酸可以减到二十克，上桌另配一角。"
  ],
  "common_mistakes": [
    "鸡块和冷水一起下锅久煮，肉质纤维收紧，口感变得干硬。",
    "香菜叶一早下锅，煮到发黄，清香尽失只剩草腥味。",
    "柠檬汁与鸡肉同煮，酸味把肉纤维泡散，汤也带上涩味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "300克:300克",
      "note": "煮制时间缩短至十二分钟，久煮会发柴。"
    },
    {
      "original": "青椒",
      "substitute": "芹菜",
      "ratio": "30克:30克",
      "note": "切小段下锅，香气更清，煮三分钟即可。"
    }
  ],
  "variations": [
    "加两片姜同煮，暖身感更强，适合天气冷的时候喝。",
    "把清水换成同量的骨汤，汤底更厚，盐要相应减量。"
  ],
  "serving_suggestion": "热汤盛在浅口碗里，配一片烤面包或一小碗白饭，酸香开胃适合饭前喝。",
  "storage": "冷藏可存两天，复热时小火加热到微沸，柠檬汁与香菜叶等复热后再补，风味更接近现做。",
