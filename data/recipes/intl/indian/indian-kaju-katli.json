  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "腰果",
          "name_en": "cashew",
          "amount": 250,
          "unit": "g",
          "note": "生腰果仁",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "甜度可按口味调",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 60,
          "unit": "ml",
          "note": "熬糖浆用",
          "optional": false
        },
        {
          "name": "小豆蔻",
          "name_en": "cardamom",
          "amount": 2,
          "unit": "g",
          "note": "去壳磨粉",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "料理机",
    "不粘锅",
    "擀面杖",
    "油纸",
    "细筛"
  ],
  "steps": [
    {
      "n": 1,
      "text": "腰果用干锅小火烘三分钟至微微出香，倒出摊凉后磨成细粉。",
      "time_min": 8,
      "heat": "小火",
      "tip": "腰果磨之前必须彻底凉透，热着磨会出油结块，粉就不细了。",
      "visual_cue": "腰果粉细腻松散，不结团"
    },
    {
      "n": 2,
      "text": "腰果粉过筛两遍，粗粒挑出来重新磨，全部过成细粉备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "筛过的粉做出来口感像绸缎，带粗粒的糖块咬着发沙。",
      "visual_cue": "过筛后粉质细腻，握一把能捏成团"
    },
    {
      "n": 3,
      "text": "不粘锅倒白糖与清水，小火熬到糖化开并冒细密小泡。",
      "time_min": 7,
      "heat": "小火",
      "tip": "糖浆熬到能挂住勺背就够，熬过头糖会返砂，糖块发白发硬。",
      "visual_cue": "糖浆透明微稠，气泡细密"
    },
    {
      "n": 4,
      "text": "关火后把腰果粉与小豆蔻粉倒进糖浆，快速翻拌成团。",
      "time_min": 6,
      "heat": "无火",
      "tip": "离火再下粉，边倒边翻，锅里温度高粉会焦，糖也会发苦。",
      "visual_cue": "面团结成光滑糖团不粘锅"
    },
    {
      "n": 5,
      "text": "糖团趁热夹在两层油纸间擀成半厘米厚，凉透后切成菱形块。",
      "time_min": 4,
      "heat": "无火",
      "tip": "温着擀才擀得开，凉了会裂；切块要等凉透，热切会拉丝变形。",
      "visual_cue": "糖片平整，切块边缘利落"
    }
  ],
  "tips": [
    "腰果软糖是印度排灯节最常见的甜食，银箔包装送人很体面。",
    "糖浆滴一滴到冷水里能捏成软球，就是做这款糖的最佳状态。",
    "切好的块放凉后会稍微回硬，密封一晚口感更糯。"
  ],
  "common_mistakes": [
    "腰果没烘就磨粉，生豆味重，做出的糖带一股青涩气。",
    "糖浆熬过头返砂，拌粉时结成硬块，擀都擀不开。",
    "糖团凉透才想起擀，一擀就裂开，只能改捏成团。"
  ],
  "substitutions": [
    {
      "original": "腰果",
      "substitute": "杏仁",
      "ratio": "250克:250克",
      "note": "杏仁需去皮，磨粉更易出油。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "120克:130克",
      "note": "红糖版颜色深，风味更浓。"
    }
  ],
  "variations": [
    "糖团里包一小勺开心果碎，切开有层次，是节庆版做法。",
    "表面压一片食用银箔，做成年货礼盒样式。"
  ],
  "serving_suggestion": "切成菱形小块摆盘，配一小杯无糖红茶，甜香解腻。",
  "storage": "密封常温可存一周，冷藏两周，受潮会发黏需回锅微热。",
