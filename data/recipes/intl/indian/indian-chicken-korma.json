  "equipment": [
    "炒锅",
    "搅拌机",
    "锅铲",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "腰果用清水泡二十分钟，与少量清水一起打成细腻的腰果糊备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腰果糊打得越细，酱汁越顺滑。",
      "visual_cue": "糊体乳白无颗粒。"
    },
    {
      "n": 2,
      "text": "鸡腿肉切块，用一半酸奶与姜黄抓匀，静置二十分钟。",
      "time_min": 7,
      "heat": "无火",
      "tip": "酸奶腌过的鸡肉更嫩，也不容易柴。",
      "visual_cue": "鸡块裹上白色酸奶层。"
    },
    {
      "n": 3,
      "text": "锅里放酥油，下小豆蔻、桂皮与丁香小火炒出香味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "整粒香料遇酥油才出香，别用大火。",
      "visual_cue": "香料在油中轻响，气味浓郁。"
    },
    {
      "n": 4,
      "text": "加洋葱丝炒到金黄发甜，放姜末蒜末炒香后盛出一半洋葱备用。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱炒到金黄是 korma 的甜底，急不得。",
      "visual_cue": "洋葱深黄发软，油色金黄。"
    },
    {
      "n": 5,
      "text": "放鸡块翻炒到表面变白，倒入腰果糊与清水，小火焖十五分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "腰果糊下锅后要常搅，容易沉底糊锅。",
      "visual_cue": "汤汁乳白浓稠，鸡块浮起。"
    },
    {
      "n": 6,
      "text": "加剩下的酸奶与盐调匀，小火再煮五分钟，注意别煮滚。",
      "time_min": 7,
      "heat": "小火",
      "tip": "酸奶要在小火下加，滚了会分层起絮。",
      "visual_cue": "酱汁顺滑，无明显颗粒。"
    },
    {
      "n": 7,
      "text": "淋淡奶油，撒香菜碎，与预留的洋葱一起装盘。",
      "time_min": 5,
      "heat": "小火",
      "tip": "淡奶油关火前淋，久煮会出油。",
      "visual_cue": "表面一层奶白，香菜点缀。"
    }
  ],
  "tips": [
    "腰果糊是 korma 的灵魂，用生腰果打出来最甜。",
    "酸奶要提前从冰箱取出回温，冷的下锅容易起絮。",
    "全程小火，酱汁只要微微冒泡就够。"
  ],
  "common_mistakes": [
    "酸奶倒入滚开的酱汁，整锅起白絮没法救。",
    "腰果糊下锅后不搅，锅底糊一层，酱汁带焦味。"
  ],
  "substitutions": [
    {
      "original": "腰果",
      "substitute": "杏仁",
      "ratio": "60g 对 60g",
      "note": "杏仁需去皮打糊，香气偏清。"
    }
  ],
  "variations": [
    "莫卧儿宫廷版本会加藏红花与少量玫瑰水，颜色金黄、香气更雅，适合宴客。"
  ],
  "serving_suggestion": "配香米饭或印度烤饼，酱汁浇在饭上最合适。",
  "storage": "冷藏两天，复热时用小火加少量清水，边加热边搅。",
