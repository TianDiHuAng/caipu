  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "全麦面粉",
          "name_en": "whole wheat flour",
          "amount": 450,
          "unit": "g",
          "note": "粗磨",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 50,
          "unit": "g",
          "note": "增加筋性",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 80,
          "unit": "g",
          "note": "无糖",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 240,
          "unit": "ml",
          "note": "和面",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "定咸",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "刷面",
          "optional": false
        },
        {
          "name": "酥油",
          "name_en": "ghee",
          "amount": 30,
          "unit": "g",
          "note": "出锅刷面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "擀面杖",
    "隔热手套"
  ],
  "steps": [
    {
      "n": 1,
      "text": "全麦面粉与面粉混合，加盐拌匀后加入酸奶抓匀。",
      "time_min": 9,
      "heat": "无火",
      "tip": "酸奶让饼更软，也让全麦不那么粗。",
      "visual_cue": "粉料结成小颗粒。"
    },
    {
      "n": 2,
      "text": "分次加清水揉成偏硬的面团，盖湿布松弛三十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团偏硬，贴在炉壁上才不塌。",
      "visual_cue": "面团成型不粘手。"
    },
    {
      "n": 3,
      "text": "面团分成六份，擀成八毫米厚的圆饼，边缘略薄。",
      "time_min": 10,
      "heat": "无火",
      "tip": "厚饼更能承受炉温，薄了会焦。",
      "visual_cue": "饼坯中间厚、边缘薄。"
    },
    {
      "n": 4,
      "text": "烤箱连烤盘预热到二百三十度，烤盘倒扣当炉壁使用。",
      "time_min": 8,
      "heat": "大火",
      "tip": "烤盘一定要预热到烫手，饼才能贴住。",
      "visual_cue": "烤盘冒热气，手靠近发烫。"
    },
    {
      "n": 5,
      "text": "饼坯表面刷一层清水，贴在热烤盘上烤四分钟至饼面鼓起。",
      "time_min": 7,
      "heat": "大火",
      "tip": "刷水是为了粘住，别省略。",
      "visual_cue": "饼面鼓起大泡，底面起焦斑。"
    },
    {
      "n": 6,
      "text": "翻面刷一层植物油，再烤三分钟至两面焦斑均匀，取出刷酥油。",
      "time_min": 7,
      "heat": "大火",
      "tip": "翻面后看着点，全麦饼上色很快。",
      "visual_cue": "焦斑深褐，饼身硬挺。"
    },
    {
      "n": 7,
      "text": "趁热把饼撕成适口的小块，配咖喱一起上桌食用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "撕比切好，断面粗糙更挂酱。",
      "visual_cue": "饼块边缘带焦，内里柔软。"
    }
  ],
  "tips": [
    "没有馕坑就用烤箱加倒扣烤盘，效果接近。",
    "全麦面粉吸水多，清水要分次加，边揉边看。",
    "出锅刷一层酥油，饼面油亮不发干。"
  ],
  "common_mistakes": [
    "烤盘没预热就把饼贴上去，饼滑落变成软塌饼。",
    "面团太软，贴壁后往下坠，烤成厚薄不均的怪形状。"
  ],
  "substitutions": [
    {
      "original": "全麦面粉",
      "substitute": "中筋面粉",
      "ratio": "450g 对 450g",
      "note": "口感更软，但少了麦香与粗粒感。"
    }
  ],
  "variations": [
    "加尔各答的店铺会在饼面撒一层芝麻与香菜碎，出炉时香气格外足。"
  ],
  "serving_suggestion": "配黄油鸡、鹰嘴豆咖喱或烤肉串，撕开蘸汁吃。",
  "storage": "冷藏两天，复热前喷少许水，用烤箱 180℃ 烤三分钟。",
  "nutrition_estimate": {
    "basis": "每份约 160g",
    "calories_kcal": 360,
    "protein_g": 13,
    "fat_g": 9,
    "carbs_g": 58,
