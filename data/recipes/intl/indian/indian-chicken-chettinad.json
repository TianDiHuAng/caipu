  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成三厘米块，用盐与姜黄抓匀，静置十五分钟入味。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腌够时间，鸡肉里面才有底味。",
      "visual_cue": "鸡块表面裹上黄色薄粉。"
    },
    {
      "n": 2,
      "text": "锅烧热不放油，下黑胡椒与孜然小火炒到香味冒出，盛出碾成粗粉。",
      "time_min": 8,
      "heat": "小火",
      "tip": "香料干炒才出香，火大立刻焦苦。",
      "visual_cue": "锅里飘起白烟，香料颜色加深。"
    },
    {
      "n": 3,
      "text": "倒入植物油，放咖喱叶与洋葱丝炒到洋葱边缘焦黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "咖喱叶遇油会噼啪响，先散开再下洋葱。",
      "visual_cue": "咖喱叶卷曲变色，洋葱发软。"
    },
    {
      "n": 4,
      "text": "加姜末与蒜末炒香，放番茄丁炒成糊，撒辣椒粉炒匀。",
      "time_min": 8,
      "heat": "中火",
      "tip": "番茄炒到不流动，后面鸡肉才挂得住料。",
      "visual_cue": "番茄化开，锅底浓稠。"
    },
    {
      "n": 5,
      "text": "下鸡块翻炒到表面变白，加入炒好的黑胡椒与孜然粉，翻匀裹料。",
      "time_min": 7,
      "heat": "中火",
      "tip": "鸡块要一块块铺开翻，堆在一起会出水。",
      "visual_cue": "鸡块表面收紧，裹满香料。"
    },
    {
      "n": 6,
      "text": "加清水没过鸡块一半，盖锅小火焖十五分钟至鸡肉熟透。",
      "time_min": 7,
      "heat": "小火",
      "tip": "鸡腿肉带骨处最难熟，焖到能轻松扎透。",
      "visual_cue": "汤汁浓稠，鸡块油亮。"
    },
    {
      "n": 7,
      "text": "撒椰蓉与香菜碎，大火收汁，尝咸淡后出锅。",
      "time_min": 5,
      "heat": "大火",
      "tip": "椰蓉最后放，久煮会发苦。",
      "visual_cue": "盘底留一层浓汁，椰蓉点缀其上。"
    }
  ],
  "tips": [
    "黑胡椒现磨现炒，香气比瓶装胡椒粉高出一截。",
    "切蒂纳德风格讲究辣和香并重，黑胡椒不能省也不能减半。",
    "咖喱叶没有可以省略，但香气会少一层。"
  ],
  "common_mistakes": [
    "香料干炒时火开太大，几秒就焦黑，整锅发苦。",
    "鸡块堆在锅里不铺开，出水变成水煮鸡。"
  ],
  "substitutions": [
    {
      "original": "椰蓉",
      "substitute": "鲜椰丝",
      "ratio": "20g 对 30g",
      "note": "鲜椰丝水分多，收汁时间延长一分钟。"
    }
  ],
  "variations": [
    "当地家庭会加一小勺茴香籽与黑胡椒同炒，香气更冲，适合配印度薄饼。"
  ],
  "serving_suggestion": "配白米饭或印度薄饼，旁边放洋葱圈与青柠角。",
  "storage": "冷藏两天，复热时加两勺清水小火翻热。",
