    "刀",
    "砧板",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包切去四边硬皮，再对角切成三角形，摊在盘里晾十分钟让表面稍干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面包皮留着会发硬，晾干一点煎的时候不吸太多油。",
      "visual_cue": "面包片边角整齐，摸着略干"
    },
    {
      "n": 2,
      "text": "平底锅放一半酥油小火化开，把面包片两面煎到金黄酥脆，盛出备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "酥油别烧到冒烟，面包一沾就焦，颜色发黑不好看。",
      "visual_cue": "两面金黄，边缘发脆"
    },
    {
      "n": 3,
      "text": "汤锅倒入牛奶小火慢煮，边煮边搅，收到原来一半的量。",
      "time_min": 12,
      "heat": "小火",
      "tip": "熬奶要不停刮底，牛奶含糖容易在锅底结膜烧焦。",
      "visual_cue": "奶液浓稠挂勺，体积明显变少"
    },
    {
      "n": 4,
      "text": "放入白糖、小豆蔻与泡开的藏红花，搅到糖化开，奶色转成浅黄。",
      "time_min": 3,
      "heat": "小火",
      "tip": "藏红花先用两勺热奶泡开再倒，颜色才均匀。",
      "visual_cue": "奶液呈浅鹅黄，闻起来有花香"
    },
    {
      "n": 5,
      "text": "用剩下的酥油把腰果碎与葡萄干小火炒香，坚果边缘微微上色即可。",
      "time_min": 3,
      "heat": "小火",
      "tip": "葡萄干遇热会鼓起来，看到鼓胀就立刻关火。",
      "visual_cue": "腰果微黄，葡萄干圆鼓鼓"
    },
    {
      "n": 6,
      "text": "把煎好的面包片摆进盘里，浇上热浓奶浸透，撒上腰果与葡萄干装饰。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶要趁热浇，面包才能吸足奶汁又保持外层微脆。",
      "visual_cue": "面包吸汁饱满，盘底留少量奶汁"
    }
  ],
  "tips": [
    "用隔夜的厚切面包最好，太软的一泡就散。",
    "浓奶可以提前熬好放凉，吃前再加热浇上去。",
    "想更浓郁可以在奶里加一勺淡奶油一起熬。",
    "上桌前撒一撮开心果碎，颜色和香味都更好。"
  ],
  "common_mistakes": [
    "面包没晾干就下锅，酥油全被吸进去，吃起来满口油。",
    "牛奶大火滚煮，锅底结出一层焦褐奶皮。",
    "藏红花直接撒在冷奶里，颜色出不来还结块。",
    "面包浇奶后放太久才上桌，外层全软塌成糊。"
  ],
  "substitutions": [
    {
      "original": "面包",
      "substitute": "法棍",
      "ratio": "300 克:300 克",
      "note": "切片更厚，煎的时间缩短一分钟。"
    },
    {
      "original": "酥油",
      "substitute": "黄油",
      "ratio": "60 克:60 克",
      "note": "奶香更明显，火要更小防止焦化。"
    }
  ],
  "variations": [
    "把浓奶换成加了椰浆的版本，甜味更清爽。",
    "面包煎好后先浸一层糖水再浇奶，口感更湿润。"
  ],
  "serving_suggestion": "四小块摆一盘，表面撒坚果与葡萄干，趁温热时吃，配一杯不加糖的奶茶正好解甜。",
  "storage": "冷藏可放一天，复热用烤箱一百五十度烤五分钟，微波会让面包变韧。",
