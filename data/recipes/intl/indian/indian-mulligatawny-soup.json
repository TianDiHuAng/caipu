  "steps": [
    {
      "n": 1,
      "text": "木豆提前泡两小时，泡到用手能掐开。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡透才煮得软，不然汤里有硬粒。，注意火候。",
      "visual_cue": "豆身饱满，能掐断，状态稳定"
    },
    {
      "n": 2,
      "text": "汤锅化开酥油，下洋葱丁炒到边缘发黄。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒出甜味，汤的底子才厚。，注意火候。",
      "visual_cue": "洋葱金黄，锅底泛香，状态稳定"
    },
    {
      "n": 3,
      "text": "加蒜末和姜末炒香，再放咖喱粉、孜然粉和姜黄粉。",
      "time_min": 4,
      "heat": "小火",
      "tip": "粉类小火炒十秒就够，炒久会发苦。，注意火候。",
      "visual_cue": "香料起泡，香气冲鼻，状态稳定"
    },
    {
      "n": 4,
      "text": "放鸡腿肉块翻炒到表面变色收紧。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉块炒到封住表面，煮的时候才不散味。",
      "visual_cue": "肉色变白，表面收紧，状态稳定"
    },
    {
      "n": 5,
      "text": "倒入番茄块、木豆和清水一千毫升。这一步不要着急。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水一次加足，中途补水汤会淡。，注意火候。",
      "visual_cue": "液体没过，豆子沉底，状态稳定"
    },
    {
      "n": 6,
      "text": "烧开转小火盖锅煮三十五分钟到豆子开花。这一步不要着急。",
      "time_min": 37,
      "heat": "小火",
      "tip": "豆子开花汤才浓，别中途大火滚。，注意火候。",
      "visual_cue": "豆子松软，汤色变浓，状态稳定"
    },
    {
      "n": 7,
      "text": "用料理棒打十秒，把部分豆子和番茄打碎。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "只打几秒，留一半口感更好。，注意火候。",
      "visual_cue": "汤体半稠，颗粒仍在，状态稳定"
    },
    {
      "n": 8,
      "text": "倒椰奶搅匀，加盐调味后再煮三分钟。这一步不要着急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰奶别大火煮，容易油水分离。，注意火候。",
      "visual_cue": "汤色奶黄，质地顺滑，状态稳定"
    },
    {
      "n": 9,
      "text": "盛碗撒香菜碎，趁热配米饭上桌。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，香气才清。，注意火候。",
      "visual_cue": "表面翠绿，热气腾腾，状态稳定"
    }
  ],
  "tips": [
    "木豆一定泡透，煮出来才绵软。，值得留意。",
    "香料小火炒十秒，香气才不苦。，值得留意。",
    "椰奶最后加，别大火久煮。，值得留意。"
  ],
  "common_mistakes": [
    "豆子没泡直接煮，汤里有硬粒。，值得留意。",
    "香料炒焦，整锅发苦。，值得留意。",
    "椰奶大火滚，油水分离。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鹰嘴豆",
      "ratio": "400 克:200 克",
      "note": "素版更清爽，需多煮十分钟。"
    },
    {
      "original": "椰奶",
      "substitute": "淡奶油",
      "ratio": "120 毫升:100 毫升",
      "note": "奶香更浓，热量更高。"
    }
  ],
  "variations": [
    "加一小把熟米饭同煮，汤更稠。，值得留意。",
    "出锅挤几滴柠檬汁，酸香更开胃。，值得留意。"
  ],
  "serving_suggestion": "配一份印度香米饭，或蘸烤饼吃都很地道。，效果更稳定。",
  "storage": "冷藏三天，复热加少量清水小火煮开。，效果更稳定。",
