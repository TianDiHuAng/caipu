    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "卷心菜削掉中间的硬芯，切成细丝，用清水冲洗两遍后彻底沥干。",
      "time_min": 9,
      "heat": "无火",
      "tip": "水一定沥干，带水下锅会炒成水煮菜。",
      "visual_cue": "菜丝松散不结块，盆底无水。"
    },
    {
      "n": 2,
      "text": "洋葱切小丁，小米辣切圈，咖喱叶从枝上摘下叶片备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "咖喱叶撕一下再下锅，香气更容易出来。",
      "visual_cue": "配料分装，叶片完整无梗。"
    },
    {
      "n": 3,
      "text": "锅里放植物油，冷油下芥末籽小火炸到噼啪跳起，再放咖喱叶与小米辣。",
      "time_min": 8,
      "heat": "小火",
      "tip": "芥末籽一跳就下配料，炸久了发苦。",
      "visual_cue": "芥末籽由黑转灰，锅里响声密集。"
    },
    {
      "n": 4,
      "text": "加洋葱丁炒到透明发甜，倒入卷心菜丝转大火快速翻炒两分钟。",
      "time_min": 7,
      "heat": "大火",
      "tip": "大火快炒，菜丝才脆不出水，全程别盖锅盖。",
      "visual_cue": "菜丝颜色转亮，体积缩小。"
    },
    {
      "n": 5,
      "text": "撒姜黄与盐翻匀，沿锅边淋入清水，盖锅焖三分钟至菜丝变软。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "水只从锅边淋入，直接浇在菜上会冲淡菜味。",
      "visual_cue": "菜丝微软仍带脆，锅内有少量蒸汽水。"
    },
    {
      "n": 6,
      "text": "开盖撒椰蓉快速炒匀，让椰香裹住菜丝后立即出锅。",
      "time_min": 7,
      "heat": "中火",
      "tip": "椰蓉最后放，久炒会发苦发黄，拌匀就该出锅。",
      "visual_cue": "菜丝裹上白色椰蓉，香气上浮。"
    }
  ],
  "tips": [
    "南印度的 poriyal 讲究菜要脆，全程别超过五分钟。",
    "芥末籽是这道菜的灵魂，炸到跳响才够香。",
    "椰蓉用干椰蓉更容易挂住菜丝，鲜椰丝水分多要延长焖制一分钟。"
  ],
  "common_mistakes": [
    "卷心菜没沥干，下锅出一锅水，炒成软烂菜汤。",
    "椰蓉一开始就下锅，炒到最后发苦发黄。"
  ],
  "substitutions": [
    {
      "original": "椰蓉",
      "substitute": "鲜椰丝",
      "ratio": "40g 对 60g",
      "note": "鲜椰丝水分多，清水可以省略不淋。"
    }
  ],
  "variations": [
    "喀拉拉邦的做法会加一小把煮熟的绿豆与咖喱叶同炒，变成带豆香的版本，配米饭更顶饱。"
  ],
  "serving_suggestion": "配白饭与扁豆汤，作为一餐里的蔬菜配菜，一人一大勺。",
  "storage": "冷藏两天，复热用大火快炒一分钟，不要加水。",
