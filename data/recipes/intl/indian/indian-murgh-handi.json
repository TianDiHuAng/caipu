  "equipment": [
    "厚底锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切块，用酸奶、姜黄与一半辣椒粉抓匀，冷藏腌半小时。",
      "time_min": 8,
      "heat": "无火",
      "tip": "酸奶腌料要裹匀每一块，入味才均匀。",
      "visual_cue": "鸡块表面挂上淡黄色浆。"
    },
    {
      "n": 2,
      "text": "厚底锅里倒入植物油，下洋葱丝炒到透明发软。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒软即可，这一步不需要上色。",
      "visual_cue": "洋葱透明，锅里有水汽。"
    },
    {
      "n": 3,
      "text": "加姜末与蒜末炒香，放番茄丁炒到化成浓糊。",
      "time_min": 8,
      "heat": "中火",
      "tip": "番茄炒化，酱汁才不会水汪汪。",
      "visual_cue": "番茄成糊，边缘起泡。"
    },
    {
      "n": 4,
      "text": "撒咖喱粉与剩下的辣椒粉，小火炒三十秒让香料出香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "香料下锅时间短，炒久了发苦。",
      "visual_cue": "香料与番茄糊混成红色。"
    },
    {
      "n": 5,
      "text": "放入腌好的鸡块翻匀，加清水，盖锅小火焖二十分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "鸡块带骨，焖的时间别少于二十分钟。",
      "visual_cue": "汤汁浓稠，鸡块浮起。"
    },
    {
      "n": 6,
      "text": "开盖加盐调味，撒上香菜碎，连锅端上桌更香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "盐最后放，鸡肉更嫩。",
      "visual_cue": "表面油亮，香菜翠绿。"
    }
  ],
  "tips": [
    "用陶锅或厚底锅，受热慢但均匀，鸡肉不易粘底。",
    "腌料里的酸奶不要省，它让鸡肉在焖的过程中保持嫩度。",
    "喜欢更浓的酱汁，最后开大火收三分钟。"
  ],
  "common_mistakes": [
    "鸡块没腌直接下锅，焖完肉质发柴、味道只停在表面。",
    "香料和鸡块同时下锅，香料没炒开，成品发闷。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "淡奶油",
      "ratio": "120g 对 100ml",
      "note": "用淡奶油酱汁更厚，热量也更高。"
    }
  ],
  "variations": [
    "海得拉巴版本会在焖之前铺一层炸洋葱丝，起锅时甜香更突出。"
  ],
  "serving_suggestion": "配印度烤饼或香米饭，锅底的酱汁别浪费。",
  "storage": "冷藏两天，复热时加两勺清水小火焖热。",
