        }
      ]
    }
  ],
  "equipment": [
    "裱花袋",
    "深锅",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉过筛倒入大碗，加酸奶、姜黄和柠檬汁，慢慢加清水搅成无颗粒的面糊。",
      "time_min": 12,
      "heat": "无火",
      "tip": "朝一个方向搅，面糊上劲才挤得成圈，这一步千万别省。",
      "visual_cue": "面糊顺滑，能缓慢流下，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "面糊盖上湿布，放在温暖处静置六小时，让酸奶的酸味把面糊发松。",
      "time_min": 360,
      "heat": "无火",
      "tip": "温度低时要多放两小时，闻到微酸才算发好。",
      "visual_cue": "面糊起小泡，有淡淡酸香，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "细砂糖加清水小火煮十分钟，熬到糖浆能挂住勺背，加小豆蔻碎保温备用。",
      "time_min": 10,
      "heat": "小火",
      "tip": "糖浆别熬过头，稠了糖圈会裹硬壳，提前把配料备好再动手更稳。",
      "visual_cue": "糖浆微黄，能拉出细线，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "面糊装进裱花袋，剪一个三毫米的小口，深锅倒植物油烧至六成热。",
      "time_min": 5,
      "heat": "中火",
      "tip": "剪口别太大，圈才细，受热也均匀，这一步千万别省。",
      "visual_cue": "油面微冒青烟，面糊滴下即浮"
    },
    {
      "n": 5,
      "text": "把面糊在油面上挤成盘绕的圆圈，中火炸三分钟至两面金黄，捞出沥油。",
      "time_min": 12,
      "heat": "中火",
      "tip": "挤圈时手要稳，边挤边转，圈才不会粘连，火候和顺序都要留神。",
      "visual_cue": "糖圈鼓起，颜色金褐，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "趁热把炸好的糖圈浸入糖浆二十秒，捞出沥一下糖汁，摆盘上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡久了会软烂，二十秒刚好吸进表层，提前把配料备好再动手更稳。",
      "visual_cue": "糖圈油亮，糖汁挂满，颜色和形态变化明显"
    }
  ],
  "tips": [
    "面糊要调到能缓慢流下的稠度，太稀炸不成圈，太稠挤不出来。",
    "面糊盖好静置六小时以上，酸味出来炸出来才蓬松，别省这一步。",
    "糖浆要一勺一条线的浓度，趁热把糖圈泡进去，二十秒就吸饱。"
  ],
  "common_mistakes": [
    "面糊没静置直接下锅，炸出来又硬又实，咬着像死面疙瘩。",
    "油温过高，糖圈外面焦黑里面还是生面糊，中心黏牙。",
    "糖浆熬得太稠，糖圈裹上一层糖壳，咬开像在吃硬糖。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "中筋面粉",
      "ratio": "200克:200克",
      "note": "筋度略低，面糊会更松，可少加十克酸奶。"
    },
    {
      "original": "酸奶",
      "substitute": "牛奶",
      "ratio": "100克:100毫升",
      "note": "发酵慢，静置时间要延长到八小时。"
    }
  ],
  "variations": [
    "糖浆里加一小勺玫瑰水，香气更接近节庆摊上的版本。",
    "把糖浆换成加了藏红花的淡糖浆，颜色更金黄，甜度更轻。"
  ],
  "serving_suggestion": "炸好趁热泡糖浆，捞出沥一下摆盘，配一杯无糖酸奶或咸味小吃平衡甜度。",
  "storage": "常温可放一天，冷藏两天，回热用烤箱一百六十度烤四分钟，微波会让糖壳发黏。",
