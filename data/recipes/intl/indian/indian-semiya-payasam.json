          "amount": 15,
          "unit": "g",
          "note": "炒料增香",
          "optional": false
        },
        {
          "name": "藏红花",
          "name_en": "saffron",
          "amount": 0.5,
          "unit": "g",
          "note": "用温牛奶泡开",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "小碟",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干锅放上小火，把掰短的粉丝倒进去不停翻动，炒到颜色微黄并散出麦香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "干炒过的粉丝久煮不糊，香气也更足。",
      "visual_cue": "粉丝段转浅黄，闻得到烘烤香"
    },
    {
      "n": 2,
      "text": "另取小碟倒两勺温牛奶，放入藏红花静置，让花丝把奶染成金黄色。",
      "time_min": 4,
      "heat": "无火",
      "tip": "藏红花别用滚奶泡，高温会让香气散掉。",
      "visual_cue": "牛奶染成橙黄，花丝舒展开"
    },
    {
      "n": 3,
      "text": "厚底锅放酥油化开，下腰果与葡萄干小火翻炒到腰果边缘微黄，盛出备用。",
      "time_min": 3,
      "heat": "小火",
      "tip": "腰果一变色就立刻起锅，余温还会继续加深颜色。",
      "visual_cue": "腰果边缘泛金黄色，葡萄干鼓起"
    },
    {
      "n": 4,
      "text": "锅里倒入牛奶煮到微沸，放入炒过的粉丝，转小火慢煮并不时搅动防止粘底。",
      "time_min": 12,
      "heat": "小火",
      "tip": "牛奶容易在锅底结膜，木勺要刮到锅底。",
      "visual_cue": "粉丝变软透明，牛奶略显稠厚"
    },
    {
      "n": 5,
      "text": "加白糖搅到化开，倒入泡好的藏红花奶与小豆蔻粉，再煮五分钟让甜味融合。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖要在粉丝煮软后再加，早放会让粉丝发硬。",
      "visual_cue": "甜粥呈淡金黄色，粉丝柔软挂奶"
    },
    {
      "n": 6,
      "text": "关火后拌入炒香的腰果与葡萄干，盛进小碗，温热或放凉都可以吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "坚果关火后再拌，久煮会软掉失去脆感。",
      "visual_cue": "碗面浮着腰果与葡萄干，奶汁稠滑"
    }
  ],
  "tips": [
    "粉丝干炒到微黄是这道甜粥香气的主要来源，别省掉这一步直接下锅煮。",
    "煮的过程中牛奶会不断变稠，觉得太干可以补两勺热牛奶调稀。",
    "藏红花泡开后连奶一起倒进锅，颜色与香气都不会浪费。",
    "甜粥放凉后会明显变稠，想当凉品吃可以提前多留一点奶。"
  ],
  "common_mistakes": [
    "粉丝没炒直接下牛奶煮，煮出来软烂发黏，还带一股没炒透的生涩味。",
    "牛奶大火滚煮又不搅动，锅底结焦，甜粥带上糊味。",
    "白糖与粉丝同时下锅，粉丝久煮不软，口感外烂内硬。"
  ],
  "substitutions": [
    {
      "original": "粉丝",
      "substitute": "细面条",
      "ratio": "150克:150克",
      "note": "掰短后同样先干炒，煮制时间略短两分钟。"
    },
    {
      "original": "藏红花",
      "substitute": "姜黄粉",
      "ratio": "0.5克:0.5克",
      "note": "只用零点五克上色即可，多放会盖住奶香。"
    }
  ],
  "variations": [
    "加两片熟香蕉压成泥同煮，甜味更柔和，适合给孩子吃。",
    "把白糖减半并多加两勺牛奶，甜度更轻，奶香反而更突出。"
  ],
  "serving_suggestion": "装进小玻璃碗，温热时吃最顺口，节日餐桌上常作为收尾甜品，配咸味小食平衡甜度。",
  "storage": "冷藏可存两天，甜粥会结块变稠，复热时加少量牛奶小火调开再煮两分钟即可。",
