  "equipment": [
    "和面盆",
    "平底锅",
    "擀面杖",
    "毛刷"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水化开酵母，与酸奶、盐一起倒进高筋面粉，揉成柔软不粘手的面团。",
      "time_min": 15,
      "heat": "无火",
      "tip": "酸奶让饼心更软更有嚼劲。",
      "visual_cue": "面团光滑、按压缓慢回弹"
    },
    {
      "n": 2,
      "text": "盖布放在温暖处发酵到两倍大，手指戳洞不回缩即完成一发。",
      "time_min": 80,
      "heat": "无火",
      "tip": "发足时间，饼才会鼓起来。",
      "visual_cue": "体积两倍、戳洞不回缩"
    },
    {
      "n": 3,
      "text": "面团排气后分成六份滚圆，盖布松弛十五分钟让面筋放松。",
      "time_min": 15,
      "heat": "无火",
      "tip": "松弛到位才擀得开不回缩。",
      "visual_cue": "小面团圆整、手感柔软"
    },
    {
      "n": 4,
      "text": "取一份擀成椭圆形薄片，表面刷一层植物油，撒上蒜末与香菜碎。",
      "time_min": 5,
      "heat": "无火",
      "tip": "擀薄一些，受热才会起泡。",
      "visual_cue": "面片厚薄均匀、撒料均匀"
    },
    {
      "n": 5,
      "text": "平底锅烧到冒烟，面片刷油的一面朝下入锅，盖盖中大火烙两分钟。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "锅一定要够热，饼才会鼓泡。",
      "visual_cue": "饼面鼓起大气泡、边缘定型"
    },
    {
      "n": 6,
      "text": "翻面再烙一分钟至两面焦斑，出锅趁热刷一层融化黄油。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "黄油趁热刷才渗得进饼皮。",
      "visual_cue": "两面焦斑、饼身柔软"
    }
  ],
  "tips": [
    "锅一定要烧到冒烟再下面片，温度不够饼鼓不起来。",
    "面团用酸奶和面，饼心柔软带微微酸香。",
    "出锅立刻刷一层融化黄油，香气和光泽都靠这一下。"
  ],
  "common_mistakes": [
    "锅温不足就下饼，烙出的面饼又硬又扁没有焦斑。",
    "面团没松弛就擀，一擀就回缩、厚薄不均。",
    "香菜蒜末提前拌进面团，烙的时候全焦黑。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "牛奶",
      "ratio": "100g 对 90ml",
      "note": "奶香更淡，需加 5g 油补润。"
    },
    {
      "original": "黄油",
      "substitute": "酥油",
      "ratio": "40g 对 35g",
      "note": "香气更浓，印度本地做法。"
    }
  ],
  "variations": [
    "芝士版：面片里包 60g 马苏里拉，烙后拉丝。",
    "甜味版：刷黄油后撒 20g 椰蓉与糖。"
  ],
  "serving_suggestion": "撕成块蘸咖喱或鹰嘴豆泥，配一杯印度拉茶。",
  "storage": "当天吃最好，密封冷冻可存 2 周，复热用平底锅干烙 1 分钟。",
