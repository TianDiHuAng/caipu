      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "炒锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐、白糖和干酵母拌匀。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖给酵母当养料，发得才快。，注意火候。",
      "visual_cue": "粉类均匀，无结块，状态稳定"
    },
    {
      "n": 2,
      "text": "倒酸奶和温水，揉成柔软不粘手的面团。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "酸奶让饼更松，别用太稀的。，注意火候。",
      "visual_cue": "面团柔软，表面光洁，状态稳定"
    },
    {
      "n": 3,
      "text": "盖布巾发酵一小时到体积明显变大。这一步不要着急。",
      "time_min": 62,
      "heat": "无火",
      "tip": "室温低就延长时间，发到两倍。，注意火候。",
      "visual_cue": "体积膨大，按压回弹，状态稳定"
    },
    {
      "n": 4,
      "text": "面团分成八份，擀成十二厘米的椭圆片。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致，炸的时候才一起鼓。，注意火候。",
      "visual_cue": "椭圆均匀，厚度三毫米"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧到一百八十度。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "筷子插进去冒小泡就是够了。，注意火候。",
      "visual_cue": "油面微动，无青烟，状态稳定"
    },
    {
      "n": 6,
      "text": "下饼胚轻压，几秒内就会鼓起来。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "下锅后用勺背轻轻压，鼓得更匀。，注意火候。",
      "visual_cue": "饼身鼓起，浮在油面，状态稳定"
    },
    {
      "n": 7,
      "text": "翻面再炸三十秒到两面浅金，捞出沥油。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "上色浅一点就行，炸久会硬。，注意火候。",
      "visual_cue": "两面金黄，表皮起泡，状态稳定"
    },
    {
      "n": 8,
      "text": "垫厨房纸吸去多余油，趁热上桌。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃最软，凉了会回硬。，注意火候。",
      "visual_cue": "表面干爽，轻按回弹，状态稳定"
    }
  ],
  "tips": [
    "面团要软，炸出来才蓬松。，值得留意。",
    "油温一百八十度，太低鼓不起来。，值得留意。",
    "下锅后用勺背轻压，饼鼓得更匀。，值得留意。"
  ],
  "common_mistakes": [
    "面团太硬，炸完像块饼。，值得留意。",
    "油温不够，饼吸油发韧。，值得留意。",
    "擀得厚薄不匀，鼓一半塌一半。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "牛奶加少量柠檬汁",
      "ratio": "80 克:80 毫升加5 毫升",
      "note": "酸味略淡，蓬松度相近。"
    },
    {
      "original": "面粉",
      "substitute": "中筋面粉加少量玉米淀粉",
      "ratio": "300 克:270 克加30 克",
      "note": "更酥，鼓得稍小。"
    }
  ],
  "variations": [
    "面团里加一勺孜然籽，香气更足。，值得留意。",
    "炸好撒一层辣椒粉，做成辣味版。，值得留意。"
  ],
  "serving_suggestion": "配鹰嘴豆咖喱，就是北印最经典的早餐组合。",
  "storage": "冷藏一天，复热用烤箱一百八十度烤五分钟。",
