  "equipment": [
    "厚底锅",
    "料理机",
    "木勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗后泡水三十分钟，捞出沥干再磨成粗粒碎米。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡透的米磨起来不易碎成粉，口感更均匀。",
      "visual_cue": "米粒碎成粗砂状，没有完整颗粒"
    },
    {
      "n": 2,
      "text": "牛奶倒进厚底锅，中火加热到锅边冒小泡，不时搅动。",
      "time_min": 8,
      "heat": "中火",
      "tip": "牛奶容易糊底，从一开始就用木勺刮锅底。",
      "visual_cue": "牛奶表面浮起细密气泡，微微冒气"
    },
    {
      "n": 3,
      "text": "把碎米一点点撒进牛奶，边撒边搅防止结块沉底。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "撒得慢、搅得快，米粒就不会粘成团。",
      "visual_cue": "米粒均匀悬在牛奶里，没有结块"
    },
    {
      "n": 4,
      "text": "转小火煮二十五分钟，其间不断搅拌到米粒完全软化。",
      "time_min": 25,
      "heat": "小火",
      "tip": "刮锅底是关键，一停就容易糊出焦味。",
      "visual_cue": "米粒软烂，牛奶明显变稠挂勺"
    },
    {
      "n": 5,
      "text": "加白糖与腰果碎，继续搅五分钟到糖完全溶解。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖要分批加，一次加太多会稀掉稠度。",
      "visual_cue": "布丁浓稠顺滑，勺背能挂一层薄膜"
    },
    {
      "n": 6,
      "text": "离火拌入小豆蔻粉与藏红花水，撒上葡萄干，装碗放凉后冷藏两小时。",
      "time_min": 120,
      "heat": "无火",
      "tip": "冷藏定型后口感更厚，风味也更融合。",
      "visual_cue": "表面平整微凝，颜色淡黄带橙红花丝"
    }
  ],
  "tips": [
    "撒几粒葡萄干与碎开心果，摆盘更精致。",
    "米磨得粗一点口感更好，太细会像浆糊。",
    "用全脂牛奶煮，成品才够香浓不寡淡。",
    "冷藏一夜风味最好，第二天吃更浓。"
  ],
  "common_mistakes": [
    "碎米一次全倒进热牛奶，立刻结成硬疙瘩。",
    "煮的时候没刮锅底，整锅带明显糊味。",
    "糖加得太早，米粒久煮不软，成品稀薄不稠。"
  ],
  "substitutions": [
    {
      "original": "大米",
      "substitute": "糯米",
      "ratio": "60克:50克",
      "note": "更黏更稠，冷藏后像布丁。"
    },
    {
      "original": "牛奶",
      "substitute": "豆奶",
      "ratio": "800毫升:800毫升",
      "note": "纯素可用，需多加十克米增稠。"
    }
  ],
  "variations": [
    "加一勺玫瑰水，做成带花香的节庆版本。",
    "把腰果换成开心果，颜色与香气都更清雅。"
  ],
  "serving_suggestion": "装小碗冷藏后直接吃，节日里常作为餐后甜点端上。",
  "storage": "冷藏两天，须密封防止串味，表面盖保鲜膜防结皮。",
