  "steps": [
    {
      "n": 1,
      "text": "菠菜洗净切段，沸水焯 1 分钟后立刻过冷水，挤干水分。",
      "time_min": 6,
      "heat": "中火",
      "tip": "焯完过冷水，菠菜才保持翠绿。",
      "visual_cue": "菠菜颜色深绿、手感柔软"
    },
    {
      "n": 2,
      "text": "焯好的菠菜放入料理机打成粗泥，不用打得太细。",
      "time_min": 3,
      "heat": "无火",
      "tip": "留一点纤维感，口感更好。",
      "visual_cue": "菠菜泥粗糙带颗粒、颜色均匀"
    },
    {
      "n": 3,
      "text": "土豆去皮切 3 厘米块，加 300ml 清水煮 12 分钟至能用筷子插入。",
      "time_min": 14,
      "heat": "中火",
      "tip": "煮到八分熟就够，后面还要炒。",
      "visual_cue": "土豆块边缘发软、中心仍成型"
    },
    {
      "n": 4,
      "text": "炒锅下 45ml 植物油，中火放孜然粒爆香，下洋葱丁炒 4 分钟至微黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "孜然粒先爆香，是这道菜的底味。",
      "visual_cue": "孜然跳动出香、洋葱边缘金黄"
    },
    {
      "n": 5,
      "text": "下蒜末与姜末炒 1 分钟，加番茄丁炒至出水，再放咖喱粉与辣椒粉炒匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "香料下锅后火调小，别炒糊。",
      "visual_cue": "番茄塌软成糊、油色转红"
    },
    {
      "n": 6,
      "text": "倒入土豆块与菠菜泥，加 5g 盐翻炒 5 分钟至味道融合，汤汁收浓即可。",
      "time_min": 6,
      "heat": "中火",
      "tip": "菠菜泥后放，久煮颜色会发暗。",
      "visual_cue": "酱汁浓稠裹住土豆、颜色墨绿"
    }
  ],
  "tips": [
    "菠菜焯水后过冷水，成菜颜色才够翠绿。",
    "土豆煮到八分熟，炒的时候才不会散。",
    "孜然粒一定要先爆香，风味立刻不一样。"
  ],
  "common_mistakes": [
    "菠菜不焯水直接炒，草酸重还带涩味。",
    "土豆煮过头再炒，全碎成泥没口感。",
    "香料大火干炒，一秒就糊出苦味。"
  ],
  "substitutions": [
    {
      "original": "菠菜",
      "substitute": "羽衣甘蓝",
      "ratio": "400g 对 350g",
      "note": "焯水时间加 1 分钟，口感更硬。"
    },
    {
      "original": "咖喱粉",
      "substitute": "姜黄粉",
      "ratio": "6g 对 4g",
      "note": "颜色更亮，风味更单一。"
    }
  ],
  "variations": [
    "奶香版：起锅前加 50ml 椰奶，口感更圆润。",
    "加豆版：加 100g 鹰嘴豆同炒，蛋白质更足。"
  ],
  "serving_suggestion": "配印度烤饼或印度香米饭，旁边放一碟酸奶。",
  "storage": "冷藏 2 天，复热时加少量清水小火加热，勿微波久打。",
