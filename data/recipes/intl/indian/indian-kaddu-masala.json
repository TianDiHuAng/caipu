    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老南瓜削皮去籽，切成三厘米见方的块，用清水冲掉表面黏液后沥干。",
      "time_min": 9,
      "heat": "无火",
      "tip": "选老南瓜才够甜够粉，嫩南瓜一煮就散。",
      "visual_cue": "南瓜块边角整齐，颜色橙亮。"
    },
    {
      "n": 2,
      "text": "洋葱切成细丝，番茄切成小丁，姜与大蒜分别剁成细末。",
      "time_min": 6,
      "heat": "无火",
      "tip": "姜蒜剁细，炒制时香气才融得开。",
      "visual_cue": "配料分装，洋葱丝均匀。"
    },
    {
      "n": 3,
      "text": "植物油下锅放芥末籽，小火炸到跳响，加洋葱丝炒到发甜变软。",
      "time_min": 8,
      "heat": "小火",
      "tip": "芥末籽冷油下锅，慢慢升温才会跳。",
      "visual_cue": "芥末籽跳动，洋葱透明发亮。"
    },
    {
      "n": 4,
      "text": "放姜末蒜末与咖喱粉、姜黄炒香，再下番茄丁炒成浓糊。",
      "time_min": 7,
      "heat": "中火",
      "tip": "香料炒香再放番茄，红油才出得来。",
      "visual_cue": "锅底泛橙红油色，番茄炒成糊。"
    },
    {
      "n": 5,
      "text": "倒入南瓜块拌匀，加清水与椰奶，小火焖十二分钟至南瓜用勺压即散。",
      "time_min": 8,
      "heat": "小火",
      "tip": "椰奶下锅后别大火滚，容易分层。",
      "visual_cue": "南瓜软透，汤汁浓稠微黄。"
    },
    {
      "n": 6,
      "text": "加盐调味后撒香菜碎，连汁一起装盘上桌趁热食用。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盐最后放，南瓜本身的甜才留得住。",
      "visual_cue": "汤汁挂勺，南瓜完整不烂。"
    }
  ],
  "tips": [
    "老南瓜的皮硬、瓤色深，甜度高，做咖喱最好。",
    "椰奶要在香料炒好后再倒，先倒容易被高温油水分层。",
    "喜欢浓稠口感的可以把一半南瓜压成泥回锅。"
  ],
  "common_mistakes": [
    "南瓜切得太小，焖完化在汤里找不到块。",
    "椰奶倒入后大火猛煮，表面浮一层油花。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "600g 对 600g",
      "note": "红薯更甜，白糖类香料可省，焖的时间减三分钟。"
    }
  ],
  "variations": [
    "孟加拉一带的做法会加一小勺五香粉与几粒葡萄干，甜香更明显，配炸饼吃像甜点。"
  ],
  "serving_suggestion": "浇在香米饭上，配一张烤饼把盘底的汁擦干净。",
  "storage": "冷藏两天，冷冻不建议，南瓜解冻后口感发水。",
