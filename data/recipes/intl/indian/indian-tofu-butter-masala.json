      ]
    }
  ],
  "equipment": [
    "深锅",
    "料理机",
    "刮刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切两厘米方块，平底锅少油煎到六面金黄，盛出待用。",
      "time_min": 10,
      "heat": "中火",
      "tip": "先煎定型再炖，豆腐才不散也更吸味。",
      "visual_cue": "表面金黄结壳，翻动时整块不碎"
    },
    {
      "n": 2,
      "text": "深锅化酥油炒洋葱丝到微焦，加番茄块炒到塌软出汁。",
      "time_min": 10,
      "heat": "中火",
      "tip": "洋葱炒到边缘焦褐，酱底的甜味才出来。",
      "visual_cue": "洋葱转深金色，番茄完全塌陷出水"
    },
    {
      "n": 3,
      "text": "加腰果与姜黄粉、辣椒粉、孜然粉翻炒两分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料遇油才出香，别在干锅里直接加粉。",
      "visual_cue": "香料在油里冒泡，颜色转深红橙"
    },
    {
      "n": 4,
      "text": "全部倒进料理机打成顺滑糊状，过筛后倒回锅里。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛能去掉番茄皮与腰果碎，口感更细。",
      "visual_cue": "酱糊细腻无渣，颜色橙红发亮"
    },
    {
      "n": 5,
      "text": "小火加热酱糊，加奶油、白糖与盐，搅匀煮五分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "奶油要在最后加，久煮容易油水分离发花。",
      "visual_cue": "酱汁浓稠光泽，颜色转成柔和的杏红"
    },
    {
      "n": 6,
      "text": "放回煎好的豆腐块，小火炖六分钟让豆腐吸汁。",
      "time_min": 6,
      "heat": "小火",
      "tip": "轻推锅身翻动，别用勺子搅以免碰碎。",
      "visual_cue": "豆腐块裹满酱汁，颜色均匀饱满"
    }
  ],
  "tips": [
    "配黄油烤饼或印度香米饭，酱汁拌起来最香。",
    "腰果可换成二十克杏仁，稠度稍差但一样顺滑。",
    "加一小勺干葫芦巴叶，香气更接近餐厅版本。",
    "喜欢更浓可把奶油加到一百克，热量也随之上升。"
  ],
  "common_mistakes": [
    "豆腐没煎就下锅炖，翻两下就碎成渣。",
    "番茄没炒透就打泥，酱汁带明显生涩味。",
    "奶油和酱一起大火滚煮，出锅时油水分离发花。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "椰浆",
      "ratio": "80克:100毫升",
      "note": "做成纯素版，奶香换成椰香。"
    },
    {
      "original": "腰果",
      "substitute": "葵花籽",
      "ratio": "40克:40克",
      "note": "坚果过敏者可换，稠度接近。"
    }
  ],
  "variations": [
    "加一把青豆同炖，颜色与口感都更丰富。",
    "最后淋一勺烟熏红椒油，带出淡淡的炭火气。"
  ],
  "serving_suggestion": "配烤饼、米饭或蒸蔬菜，很适合做成一餐的主菜。",
  "storage": "冷藏三天，冷冻一个月，复热时小火加少量清水稀释。",
