        },
        {
          "name": "孜然",
          "name_en": "cumin",
          "amount": 3,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
