  "equipment": [
    "汤锅",
    "料理棒",
    "细筛",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫一分钟去皮，切块备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "去皮番茄打出来的汤才顺，带皮打会有细碎硬皮浮在汤面。",
      "visual_cue": "番茄去皮完整，果肉软塌"
    },
    {
      "n": 2,
      "text": "汤锅化黄油，下洋葱丁小火炒到透明，加蒜末与姜泥炒香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "姜蒜最后放，和洋葱一起久炒会焦，汤里带一股苦味。",
      "visual_cue": "洋葱透明，蒜姜出香不焦"
    },
    {
      "n": 3,
      "text": "加番茄块与辣椒粉翻炒，炒到果肉塌软出汁，锅底见红汤。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄要炒到塌软才出甜，炒不透的汤酸得单薄，还带生味。",
      "visual_cue": "番茄成糊，锅底一层红汁"
    },
    {
      "n": 4,
      "text": "倒清水加盐，放小豆蔻籽，煮开后转小火煮十分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "小豆蔻砸开才出香，整颗扔进去煮完还是干的，等于白放。",
      "visual_cue": "汤色深红，香气带暖调"
    },
    {
      "n": 5,
      "text": "离火用料理棒打细，回锅煮开，淋淡奶油撒白胡椒即可。",
      "time_min": 5,
      "heat": "小火",
      "tip": "打完再回锅煮一遍，汤才顺滑不挂口，也能顺便调稠度。",
      "visual_cue": "汤体细腻，奶油拉出白纹"
    }
  ],
  "tips": [
    "Shorba 在印度指清汤类的汤品，这款番茄汤常作为套餐的头盘。",
    "想要更浓可以加一勺煮熟的扁豆同打，口感更厚实。",
    "汤上撒一小把烤过的孜然，香气立刻上一个层次。"
  ],
  "common_mistakes": [
    "番茄没炒塌就加水，汤又酸又淡，喝起来像番茄泡水。",
    "小豆蔻整颗下锅不砸开，煮完还是硬的，香气一点没出。",
    "料理棒直接在滚汤里打，热汤溅出来烫手，须离火稍凉再打。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "椰浆",
      "ratio": "50毫升:50毫升",
      "note": "椰浆版更清爽，带椰香。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "20克:20毫升",
      "note": "橄榄油版更清，风味偏南欧。"
    }
  ],
  "variations": [
    "加一小把烤腰果同打，汤体更绵密，是北印度的做法。",
    "把辣椒粉换成黑胡椒，辣度温和，适合配烤饼。"
  ],
  "serving_suggestion": "盛深盘，淋一圈淡奶油，配烤饼或脆面包片。",
  "storage": "冷藏可存两天，奶油须现淋，复热小火加热勿滚。",
