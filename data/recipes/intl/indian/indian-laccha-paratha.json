      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 500,
          "unit": "g",
          "note": "中筋",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 270,
          "unit": "ml",
          "note": "和面",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 30,
          "unit": "ml",
          "note": "刷面用",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "定咸",
          "optional": false
        },
        {
          "name": "酥油",
          "name_en": "ghee",
          "amount": 80,
          "unit": "g",
          "note": "起层用",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "烙制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "盆",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐拌匀，分次加清水揉成偏软的面团，盖布松弛三十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团要软，硬了擀不出层次。",
      "visual_cue": "面团按下能留指印。"
    },
    {
      "n": 2,
      "text": "面团分成六份搓圆，表面抹酥油，再盖布醒十分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "抹油能锁住水分，擀的时候不回缩。",
      "visual_cue": "剂子表面油润发亮。"
    },
    {
      "n": 3,
      "text": "取一个剂子擀成薄圆片，刷一层酥油，撒少许干面粉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "干面粉是层与层之间的隔离，别省。",
      "visual_cue": "薄片上油光与粉痕交错。"
    },
    {
      "n": 4,
      "text": "从一边卷成长条，再盘成螺旋，压扁后静置五分钟。",
      "time_min": 9,
      "heat": "无火",
      "tip": "卷紧一点，层次才密。",
      "visual_cue": "面卷盘成松散的圆饼。"
    },
    {
      "n": 5,
      "text": "把螺旋饼坯轻轻擀成六毫米厚的圆饼，表面刷一层牛奶让饼面油润。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擀的时候从中间往外推，来回压会粘层。",
      "visual_cue": "饼坯边缘能看出螺旋纹。"
    },
    {
      "n": 6,
      "text": "平底锅刷植物油中火烙三分钟，翻面刷油再烙三分钟至两面金黄。",
      "time_min": 9,
      "heat": "中火",
      "tip": "两面都要刷油，饼才酥得起层。",
      "visual_cue": "两面焦斑均匀，饼身鼓胀。"
    },
    {
      "n": 7,
      "text": "出锅后双手轻拍饼边，把层次拍散，趁热上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拍散要在热的时候做，凉了就拍不开。",
      "visual_cue": "饼散成一层层薄片。"
    }
  ],
  "tips": [
    "酥油可以用黄油代替，奶香更浓但烟点低，火要小一点。",
    "卷得越紧，层数越多，口感越酥。",
    "吃不完的饼冷藏，复热用平底锅干烙最合适。"
  ],
  "common_mistakes": [
    "面团太硬，擀的时候边缘回缩，饼烙出来厚薄不匀。",
    "刷油太少，饼烙出来是死面一张，拍不出层次。"
  ],
  "substitutions": [
    {
      "original": "酥油",
      "substitute": "黄油",
      "ratio": "80g 对 80g",
      "note": "黄油需提前软化，抹面更均匀。"
    }
  ],
  "variations": [
    "海得拉巴版本会在每层之间撒少许辣椒粉与蒜末，做成咸香版，配咖喱特别下饭。"
  ],
  "serving_suggestion": "配任意咖喱或烤肉，用手撕着吃最能体现层次。",
  "storage": "冷藏两天，冷冻可存两周，复热前先回温。",
  "nutrition_estimate": {
    "basis": "每份约 165g",
    "calories_kcal": 480,
    "protein_g": 11,
    "fat_g": 22,
    "carbs_g": 60,
