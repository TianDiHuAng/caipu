  "equipment": [
    "平底锅",
    "擀面杖",
    "大碗",
    "压泥器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "300g 面粉加 4g 盐与 160ml 清水，揉成光滑面团，盖湿布饧 25 分钟。",
      "time_min": 30,
      "heat": "无火",
      "tip": "面团要揉到表面光滑，才擀得薄。",
      "visual_cue": "面团不粘手、按下去缓慢回弹"
    },
    {
      "n": 2,
      "text": "土豆 400g 蒸 20 分钟至软透，趁热压成细泥，摊开散热。",
      "time_min": 22,
      "heat": "中火",
      "tip": "土豆泥要放凉再拌馅，否则出水。",
      "visual_cue": "土豆泥细腻无颗粒"
    },
    {
      "n": 3,
      "text": "土豆泥加入洋葱末、青椒末、芫荽碎、碾碎的孜然与剩余 2g 盐，拌匀成馅。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馅料别调太湿，包时容易漏。",
      "visual_cue": "馅料成团、能捏成球"
    },
    {
      "n": 4,
      "text": "面团分成 8 份，取一份擀成圆片，包入一份土豆馅，收口捏紧后压扁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "收口一定捏严，擀时才不破皮。",
      "visual_cue": "饼胚圆整、收口处无裂缝"
    },
    {
      "n": 5,
      "text": "把包好的饼胚轻轻擀成 3 毫米厚的圆饼，两面拍掉多余干粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用力要匀，破口处可撒粉补上。",
      "visual_cue": "饼胚厚薄均匀、不露馅"
    },
    {
      "n": 6,
      "text": "平底锅烧热不放油，下饼胚中火烙 90 秒至底面起斑，翻面刷一层黄油再烙 60 秒。",
      "time_min": 12,
      "heat": "中火",
      "tip": "两面都刷黄油，饼皮才酥软分层。",
      "visual_cue": "两面金黄带焦斑、饼身鼓起"
    }
  ],
  "tips": [
    "土豆泥一定放凉再拌馅，温热时出水会让饼皮破。",
    "烙饼时用锅铲轻压边缘，饼更容易鼓起来。",
    "出锅后盖上干净布，饼皮能保持柔软。"
  ],
  "common_mistakes": [
    "面团没有饧够就急着擀开，面皮一直回缩擀不薄。",
    "馅料水分多，擀的时候从边上漏出来。",
    "锅太热直接烙，饼皮一面焦一面生。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "全麦面粉",
      "ratio": "300g 对 300g",
      "note": "需多加 20ml 水。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "40g 对 35ml",
      "note": "香味稍淡，更适合素食。"
    }
  ],
  "variations": [
    "奶酪版：馅中包入 60g 切达碎。",
    "萝卜版：土豆换成白萝卜丝，需先挤干水分。"
  ],
  "serving_suggestion": "趁热切块，配酸奶、腌黄瓜与一杯热奶茶。",
  "storage": "冷藏 2 天，复热时用平底锅干烙 1 分钟。",
