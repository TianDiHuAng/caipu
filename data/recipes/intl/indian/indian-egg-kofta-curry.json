  "equipment": [
    "汤锅",
    "平底锅",
    "搅拌机",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋放进冷水中，大火烧开后转中火煮十二分钟，捞出立刻浸入冷水再剥壳。",
      "time_min": 12,
      "heat": "中火",
      "tip": "冷水下锅计时更准，过冷水后蛋壳一剥就掉。",
      "visual_cue": "蛋壳完整剥落，蛋白光滑无破损"
    },
    {
      "n": 2,
      "text": "洋葱切碎，腰果用温水泡软，与蒜、姜一起放进搅拌机打成细腻的白色糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "腰果泡到能捏软，打出的糊才细，不会留颗粒。",
      "visual_cue": "糊体细腻乳白，看不见明显颗粒"
    },
    {
      "n": 3,
      "text": "平底锅放一半植物油，下桂皮、丁香与小豆蔻小火焙出香味，再倒入洋葱腰果糊。",
      "time_min": 5,
      "heat": "小火",
      "tip": "香料先焙香再下糊，整锅咖喱的底味才立得住。",
      "visual_cue": "整香料鼓起，油面浮起细密香气"
    },
    {
      "n": 4,
      "text": "小火不停翻炒洋葱腰果糊，直到水分收干、糊体颜色从乳白转为浅金并渗出油。",
      "time_min": 10,
      "heat": "小火",
      "tip": "炒到出油是去生味的关键，急不得也糊不得。",
      "visual_cue": "糊体收缩出油，颜色转浅金"
    },
    {
      "n": 5,
      "text": "放入番茄块与姜黄粉、辣椒粉、咖喱粉，压碎番茄炒到软烂，锅底渗出红色油汁。",
      "time_min": 8,
      "heat": "中火",
      "tip": "番茄炒透出红油，咖喱的颜色和酸味才正。",
      "visual_cue": "番茄化开成糊，油色橙红"
    },
    {
      "n": 6,
      "text": "倒入清水烧开，加盐调咸味，转小火煮八分钟让汤汁略收，咖喱汁变得浓稠挂勺。",
      "time_min": 8,
      "heat": "小火",
      "tip": "汁别收太干，后面还要放蛋进去吸味。",
      "visual_cue": "咖喱汁浓稠，木勺划过留痕"
    },
    {
      "n": 7,
      "text": "剥好的鸡蛋在表面轻划两三刀，放进咖喱汁里小火煨五分钟，中途翻一次让蛋身吸味。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蛋上划浅刀不易散，又能让滋味进到里层。",
      "visual_cue": "蛋身挂上橙红咖喱，刀口处颜色更深"
    },
    {
      "n": 8,
      "text": "关火撒香菜碎，把鸡蛋与咖喱汁一起盛进深盘，配米饭或薄饼吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜关火后撒，绿叶不会被热气焖黄。",
      "visual_cue": "深盘里橙红咖喱托着整枚鸡蛋"
    }
  ],
  "tips": [
    "洋葱腰果糊一定要炒到出油，少了这一步咖喱会有生洋葱的辛辣气。",
    "鸡蛋煮好后过冷水再剥，蛋白完整不破，切开后断面也漂亮。",
    "腰果是这道菜浓稠感的来源，实在没有可以换成十克泡软的腰果碎。",
    "咖喱放置一段时间味道会更融合，隔夜复热反而更好吃。"
  ],
  "common_mistakes": [
    "洋葱腰果糊没炒透就加水，咖喱发白寡淡，还带一股生味。",
    "番茄没炒软就倒水，酸味生硬，汤汁也不够浓稠。",
    "鸡蛋在咖喱里大火久煮，蛋白变硬发韧，口感发老。"
  ],
  "substitutions": [
    {
      "original": "腰果",
      "substitute": "花生",
      "ratio": "30克:30克",
      "note": "同样泡软打糊，香气更重，过敏者慎用。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鹌鹑蛋",
      "ratio": "200克:180克",
      "note": "煮制时间缩到六分钟，剥壳后整枚下锅。"
    }
  ],
  "variations": [
    "把鸡蛋换成水煮后对半切的蛋，切面朝上摆盘，咖喱更容易渗进蛋黄。",
    "加两勺椰蓉同炒，咖喱带椰香，辣度也显得柔和。"
  ],
  "serving_suggestion": "盛在深盘里，旁边配一小碗白饭或两张薄饼，把咖喱汁浇在饭上吃最下饭。",
  "storage": "冷藏可放两天，鸡蛋与咖喱汁一起密封存放，复热时小火加热到微沸并补少量清水。",
