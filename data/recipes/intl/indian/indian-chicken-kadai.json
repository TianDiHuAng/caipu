    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香菜籽用干锅小火炒香，盛出后用刀背碾成粗粒备用。",
      "time_min": 7,
      "heat": "小火",
      "tip": "香菜籽现炒现碾，香气差别很明显。",
      "visual_cue": "锅里飘起柑橘样的香味。"
    },
    {
      "n": 2,
      "text": "鸡腿肉切成三厘米见方的块，用盐与姜黄抓匀静置十分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先腌一下，鸡肉里外都有味。",
      "visual_cue": "鸡腿肉表面均匀泛黄。"
    },
    {
      "n": 3,
      "text": "锅里放植物油，下孜然炸香，加洋葱块炒到边缘发软。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱切块炒到边缘软、中心还脆，口感最好。",
      "visual_cue": "洋葱块边缘透明。"
    },
    {
      "n": 4,
      "text": "放姜末蒜末炒香，加番茄丁炒成糊，撒辣椒粉与香菜籽翻匀。",
      "time_min": 8,
      "heat": "中火",
      "tip": "香菜籽最后放，早了香气跑光。",
      "visual_cue": "酱汁橙红，香料颗粒可见。"
    },
    {
      "n": 5,
      "text": "下鸡块翻炒上色，加清水盖锅小火焖十二分钟。",
      "time_min": 7,
      "heat": "小火",
      "tip": "锅炒鸡讲究酱少，水别加多。",
      "visual_cue": "汤汁浓稠挂住鸡块。"
    },
    {
      "n": 6,
      "text": "放入青椒块转大火翻炒三分钟，断生即可，撒香菜碎出锅。",
      "time_min": 7,
      "heat": "大火",
      "tip": "青椒要留脆口，炒软了整道菜就塌了。",
      "visual_cue": "青椒颜色翠绿发亮。"
    }
  ],
  "tips": [
    "kadai 是印度的一种浅口炒锅，用普通炒锅同样能做。",
    "香菜籽与孜然现炒现碾，是这道菜香气的关键。",
    "青椒最后大火快炒，颜色和脆度都能保住。"
  ],
  "common_mistakes": [
    "水加太多，焖完变成汤菜，没有锅炒的干香。",
    "青椒和鸡块一起焖，最后颜色发黄、口感发软。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "150g 对 150g",
      "note": "彩椒不辣，颜色更好看，适合不吃辣的人。"
    }
  ],
  "variations": [
    "家庭版本会加两勺淡奶油把酱汁调柔，辣度不变，口感更顺。"
  ],
  "serving_suggestion": "配烤饼或白饭，用饼把盘底的香料酱擦干净。",
  "storage": "冷藏两天，复热用大火快炒，不要加水。",
