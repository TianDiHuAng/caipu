  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "玉米面",
          "name_en": "cornmeal",
          "amount": 400,
          "unit": "g",
          "note": "粗磨",
          "optional": false
        },
        {
          "name": "全麦面粉",
          "name_en": "whole wheat flour",
          "amount": 100,
          "unit": "g",
          "note": "增加筋性",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 300,
          "unit": "ml",
          "note": "烫面用",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "定咸",
          "optional": false
        },
        {
          "name": "酥油",
          "name_en": "ghee",
          "amount": 40,
          "unit": "g",
          "note": "烙饼用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "盆",
    "湿布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米面与全麦面粉混匀，加盐拌匀后堆成中间凹陷的粉堆。",
      "time_min": 8,
      "heat": "无火",
      "tip": "全麦面粉只用一成，多了饼会硬。",
      "visual_cue": "粉堆中间凹下一圈。"
    },
    {
      "n": 2,
      "text": "把清水烧开后分数次倒入粉中，边倒边用筷子搅成絮状。",
      "time_min": 10,
      "heat": "中火",
      "tip": "必须用滚水烫，玉米面才不发散。",
      "visual_cue": "粉粒结成半透明的小团。"
    },
    {
      "n": 3,
      "text": "稍凉后揉成光滑面团，盖上湿布静置二十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团偏软一点好，太硬擀不薄。",
      "visual_cue": "面团按下去缓慢回弹。"
    },
    {
      "n": 4,
      "text": "把面团分成八个剂子，逐个擀成两毫米厚的圆饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擀的时候撒干粉，防粘。",
      "visual_cue": "饼坯薄到能透光。"
    },
    {
      "n": 5,
      "text": "平底锅烧热，放饼坯中小火烙两分钟，翻面再烙两分钟。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "不刷油干烙，饼面起小泡才地道。",
      "visual_cue": "饼面鼓起焦斑，边缘发硬。"
    },
    {
      "n": 6,
      "text": "两面刷上酥油，再烙半分钟至边缘微脆，趁热叠放上桌。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "酥油最后刷，香气温和不焦。",
      "visual_cue": "表面油亮，焦斑均匀。"
    }
  ],
  "tips": [
    "玉米面筋性差，必须用滚水烫面才能成团。",
    "饼一定要趁热吃，凉了会变硬发脆。",
    "配上一勺黄油与一勺白糖，是旁遮普人冬天的早餐。"
  ],
  "common_mistakes": [
    "用冷水和面，饼烙出来一碰就散。",
    "饼擀得太厚，中间烙不透，吃着发黏生硬。"
  ],
  "substitutions": [
    {
      "original": "玉米面",
      "substitute": "小米面",
      "ratio": "400g 对 400g",
      "note": "小米面更细，水量减少至 260ml。"
    }
  ],
  "variations": [
    "旁遮普农村会把烙好的饼直接埋进炭灰里烤，饼面带一层焦灰，香气更冲。"
  ],
  "serving_suggestion": "配上一勺白黄油、一份芥菜叶糊，是当地的标准搭配。",
  "storage": "现做现吃，剩饼可冷藏一天，复热用平底锅干烙一分钟。",
  "nutrition_estimate": {
    "basis": "每份约 150g",
    "calories_kcal": 340,
    "protein_g": 7,
