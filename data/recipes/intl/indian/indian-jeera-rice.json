    "厚底锅",
    "木勺",
    "滤网",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "米饭提前煮好摊开晾凉，用叉子把结块的部分拨散。",
      "time_min": 8,
      "heat": "无火",
      "tip": "米饭要晾到不烫手再炒，米粒才不粘连成团。",
      "visual_cue": "米粒分明松散，摸上去微温"
    },
    {
      "n": 2,
      "text": "厚底锅小火化开印度酥油，下孜然粒慢慢炒到香气散出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "孜然粒入锅会跳，听到噼啪声就对了。",
      "visual_cue": "孜然粒颜色转深，油面泛起细泡"
    },
    {
      "n": 3,
      "text": "加洋葱薄片炒五分钟到边缘微焦，甜味完全释放。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒到浅褐色就好，饭的底色才金黄好看。",
      "visual_cue": "洋葱片卷曲转金，锅底略带焦糖色"
    },
    {
      "n": 4,
      "text": "倒入米饭，用铲子切拌翻炒四分钟，让油均匀裹住米粒。",
      "time_min": 4,
      "heat": "中火",
      "tip": "切拌不向下压，米粒才保持完整有嚼劲不糊。",
      "visual_cue": "米粒泛油光，颗粒松散不结团"
    },
    {
      "n": 5,
      "text": "加盐与黑胡椒调味，撒香菜碎翻两下即可出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐最后加，先加容易让米粒出水发黏。",
      "visual_cue": "米饭金黄透亮，香菜翠绿点缀其间"
    }
  ],
  "tips": [
    "孜然粒比孜然粉香得更立体，别用粉替代。",
    "配任何咖喱都合适，也能配烤鸡与豆汤。",
    "加一小勺印度酥油再拌，香气会明显更浓。",
    "米饭用长粒品种，炒出来颗粒更分明。"
  ],
  "common_mistakes": [
    "用刚煮的软饭直接炒，越炒越黏变成一坨。",
    "孜然粒炸到发黑才下洋葱，整锅饭带焦苦。",
    "翻炒时用力压米粒，饭被压成泥状失去口感。"
  ],
  "substitutions": [
    {
      "original": "印度酥油",
      "substitute": "黄油",
      "ratio": "40克:40克",
      "note": "奶香接近，焦香稍弱。"
    },
    {
      "original": "孜然粒",
      "substitute": "孜然粉",
      "ratio": "8克:5克",
      "note": "香气更冲但少了颗粒感。"
    }
  ],
  "variations": [
    "加一把煮熟的青豆，做成青豆孜然饭。",
    "用藏红花水代替部分清水煮饭，颜色金黄更华丽。"
  ],
  "serving_suggestion": "配咖喱、烤肉或酸奶沙拉都合适，是北印度餐桌上最常见的配饭。",
  "storage": "冷藏两天，复热前撒一勺清水，加盖小火焖三分钟。",
