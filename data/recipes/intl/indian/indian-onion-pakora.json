        }
      ]
    }
  ],
  "equipment": [
    "深锅",
    "漏勺",
    "大碗",
    "厨房纸",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切成细丝放进大碗，加盐用手抓揉三分钟到出水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "抓出洋葱水，后面不用再加水就能成团。",
      "visual_cue": "洋葱变软，碗底有水，状态稳定"
    },
    {
      "n": 2,
      "text": "加入孜然、辣椒粉和姜黄粉，抓匀让每根洋葱都裹上香料。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香料先和洋葱拌，味道才渗得进去。，注意火候。",
      "visual_cue": "洋葱发红，香气冲鼻，状态稳定"
    },
    {
      "n": 3,
      "text": "倒入面粉和香菜碎，用手抓拌成能抱团的稠糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "太干就补一勺洋葱水，太湿会散在油里。",
      "visual_cue": "糊体黏手，能捏成团，状态稳定"
    },
    {
      "n": 4,
      "text": "静置十分钟让面粉吸水，同时把深锅里的植物油烧到一百七十度。",
      "time_min": 12,
      "heat": "中火",
      "tip": "静置后面糊更紧实，下锅才不散。，注意火候。",
      "visual_cue": "油面微动，糊体紧实，状态稳定"
    },
    {
      "n": 5,
      "text": "抓一小团糊，用虎口挤出小团下进油锅，一次下六七个。",
      "time_min": 6,
      "heat": "中火",
      "tip": "别贪多，一锅太挤会粘成一团。，注意火候。",
      "visual_cue": "小团定型，油面翻滚，状态稳定"
    },
    {
      "n": 6,
      "text": "中火炸四分钟到金黄浮起，翻面再炸一分钟。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "浮起且颜色均匀就熟，捞出前再炸半分钟更脆。",
      "visual_cue": "外壳金黄，声响清脆，状态稳定"
    },
    {
      "n": 7,
      "text": "用漏勺捞出放在厨房纸上吸油，趁热撒少许盐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热撒盐才粘得住，冷了表面挂不上。",
      "visual_cue": "表面干爽，油迹吸净，状态稳定"
    }
  ],
  "tips": [
    "洋葱抓出水分，面糊不用加水就能抱团。",
    "油温一百七十度下锅，太凉会吸油发软。",
    "一锅别下太多，团与团之间要留空隙。，值得留意。"
  ],
  "common_mistakes": [
    "面糊调得太稀，下锅就散成一片渣。，务必避免。",
    "油温不够就下锅，炸出来又软又油。，务必避免。",
    "一次下一大盘，全部粘成一整块。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "洋葱",
      "substitute": "卷心菜",
      "ratio": "320 克:320 克",
      "note": "切细丝后同样抓盐出水。"
    },
    {
      "original": "面粉",
      "substitute": "鹰嘴豆粉",
      "ratio": "260 克:260 克",
      "note": "更香也更酥，吸水略多可补两勺水。"
    }
  ],
  "variations": [
    "加一把切碎的菠菜，颜色更好看。，也很受欢迎。",
    "配一碟酸奶蘸酱一起吃，解腻又清爽。，也很受欢迎。"
  ],
  "serving_suggestion": "趁热当小吃吃，配一杯加柠檬的汽水最合适。",
  "storage": "常温两小时，复热用烤箱一百八十度烤六分钟恢复脆感。",
