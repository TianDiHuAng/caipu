  ],
  "equipment": [
    "烤箱",
    "烤签",
    "密封盒",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成三厘米见方的小块，用厨房纸压十分钟吸掉表面水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水分吸得越干，腌料才挂得住不滑落。",
      "visual_cue": "豆腐块表面干爽，按下去有弹性"
    },
    {
      "n": 2,
      "text": "酸奶加蒜泥、姜泥、柠檬汁，再放姜黄粉、辣椒粉、孜然粉与盐，搅成顺滑腌料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "腌料要调到能裹住勺子，太稠就加一勺柠檬汁。",
      "visual_cue": "腌料呈淡黄色稠糊，香料分布均匀"
    },
    {
      "n": 3,
      "text": "豆腐块放进腌料轻轻翻拌，让每块都裹上一层厚糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用刮刀翻拌不要搅，豆腐容易碎成渣。",
      "visual_cue": "每块豆腐表面均匀裹满腌料"
    },
    {
      "n": 4,
      "text": "盖好冷藏腌四十分钟，中途翻一次面让入味均匀。",
      "time_min": 40,
      "heat": "无火",
      "tip": "腌够四十分钟才有底味，急着烤出来会寡淡发柴。",
      "visual_cue": "腌料略微渗入豆腐，表面不再流动"
    },
    {
      "n": 5,
      "text": "豆腐块串在烤签上，表面刷一层融化的印度酥油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "块与块之间留一点缝隙，热风才能均匀穿过。",
      "visual_cue": "豆腐块排列整齐不挤靠，表面泛油光"
    },
    {
      "n": 6,
      "text": "烤箱两百二十度烤十八分钟，中途翻面再刷一次酥油。",
      "time_min": 18,
      "heat": "中火",
      "tip": "看到边缘出现焦斑就差不多，别烤干。",
      "visual_cue": "表面起焦斑，边缘略微收干收紧"
    },
    {
      "n": 7,
      "text": "出炉后撒上香菜碎，配柠檬角趁热上桌，凉了就不好吃了。",
      "time_min": 2,
      "heat": "无火",
      "tip": "挤一点柠檬汁能压住烤过的干口感，味道更清爽。",
      "visual_cue": "表面焦香带红边，内部仍柔嫩"
    }
  ],
  "tips": [
    "豆腐先冷冻再解冻，挤出水分后口感更像肉。",
    "没有烤箱可用平底锅少油煎，每面三分钟。",
    "腌料里的酸奶换成椰浆，做成纯素版本。",
    "一次多腌一些冷藏过夜，第二天更入味。"
  ],
  "common_mistakes": [
    "豆腐没压水就腌，腌料滑落挂不住，烤后发白发干。",
    "翻拌太用力，豆腐碎成小块串不起来。",
    "烤的时间过长，表面焦黑内部像海绵一样干。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "奶酪",
      "ratio": "500克:400克",
      "note": "风味更浓但油脂高，烤的时间减三分钟。"
    },
    {
      "original": "酸奶",
      "substitute": "椰浆",
      "ratio": "150克:150克",
      "note": "纯素可用，酸味需补柠檬汁。"
    }
  ],
  "variations": [
    "加一勺孜然粒与洋葱块一起串，烤出的香气更足。",
    "最后两分钟开热风上色，表面焦斑更明显。"
  ],
  "serving_suggestion": "配洋葱圈、柠檬角和薄荷酸辣酱，作为前菜或卷进饼里都合适。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤六分钟恢复口感。",
