  "equipment": [
    "汤锅",
    "木铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿 600g 去皮切 3 厘米块，用 2g 盐与 1g 姜黄粉抓匀腌 10 分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "姜黄先腌，鸡肉上色更均匀。",
      "visual_cue": "鸡块通体淡黄、表面干爽"
    },
    {
      "n": 2,
      "text": "汤锅倒 25ml 植物油烧热，下 3g 孜然小火炒 30 秒至香气冒出。",
      "time_min": 2,
      "heat": "小火",
      "tip": "孜然极易焦，闻到香就下洋葱。",
      "visual_cue": "孜然微鼓、油面起小泡"
    },
    {
      "n": 3,
      "text": "加洋葱丁 120g 中火炒 5 分钟至透明微黄，加姜末与蒜末炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到出甜味，汤才醇厚。",
      "visual_cue": "洋葱透明、锅底微焦糖色"
    },
    {
      "n": 4,
      "text": "下鸡块翻炒 4 分钟至表面变白，加 3g 黑胡椒与剩余姜黄粉炒匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡肉表面炒熟锁住汁水。",
      "visual_cue": "鸡块变白、香料裹匀"
    },
    {
      "n": 5,
      "text": "倒入 900ml 高汤烧开，转小火盖盖煮 25 分钟至鸡肉软烂。",
      "time_min": 27,
      "heat": "小火",
      "tip": "小火慢煮，汤清不浑。",
      "visual_cue": "汤面微沸、鸡肉轻推离骨"
    },
    {
      "n": 6,
      "text": "加 3g 盐调味，撇去表面浮油，盛碗后撒香菜碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香菜最后撒，香气才不散。",
      "visual_cue": "汤色金黄、浮油稀薄"
    }
  ],
  "tips": [
    "孜然先炒香再炒洋葱，汤的底味就立起来了。",
    "鸡肉先去皮再煮汤，喝起来清爽不腻。",
    "汤煮好撇一次油，喝起来更利落。"
  ],
  "common_mistakes": [
    "孜然大火炒过头，整锅汤带焦苦味。",
    "洋葱没炒透就加水，汤味显得寡淡。",
    "盐一次加足，收汤后咸得无法入口。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡胸肉",
      "ratio": "600g 对 500g",
      "note": "煮制时间减到 15 分钟。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "900ml 对 900ml",
      "note": "鲜味稍弱，可加 2g 鸡精。"
    }
  ],
  "variations": [
    "加 50g 番茄丁同煮，酸香更开胃。",
    "起锅淋 5ml 柠檬汁，层次更亮。"
  ],
  "serving_suggestion": "热汤装碗，配馕或印度香米饭同食。",
  "storage": "冷藏可存 2 天，复热后风味更融合。",
