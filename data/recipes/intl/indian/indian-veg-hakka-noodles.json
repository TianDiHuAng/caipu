  "equipment": [
    "炒锅",
    "汤锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面条放进滚水里煮六分钟至八分熟，捞出立刻用冷水冲透，沥干后拌五毫升植物油。",
      "time_min": 9,
      "heat": "大火",
      "tip": "冷水冲掉表面的面浆，面才不粘成块，这一步千万别省。",
      "visual_cue": "面条根根分明，捏着有韧，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "卷心菜和胡萝卜切成细丝，洋葱切丝，蒜切末，小葱切成长段备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丝切得越细熟得越快，口感也更均匀，火候和顺序都要留神。",
      "visual_cue": "菜丝细长，大小一致，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟，倒植物油下蒜末和洋葱丝，大火爆炒一分钟出香。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅一定要够热，蒜末才香不苦，提前把配料备好再动手更稳。",
      "visual_cue": "蒜末微黄，洋葱透明，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "倒入卷心菜丝和胡萝卜丝大火快炒两分钟，菜丝变软但仍带脆度。",
      "time_min": 3,
      "heat": "大火",
      "tip": "全程不盖盖，让水汽快速散掉，这一步千万别省。",
      "visual_cue": "菜丝油亮，不积水，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "下入面条，沿锅边淋生抽，加盐和黑胡椒，用夹子上下翻动两分钟炒匀。",
      "time_min": 4,
      "heat": "大火",
      "tip": "用夹子翻不让铲子切断面条，火候和顺序都要留神。",
      "visual_cue": "面色均匀，酱香上涌，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "关火前沿锅边淋入香醋，撒上小葱段快速翻两下，立即装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋最后淋，酸香保留得更完整，提前把配料备好再动手更稳。",
      "visual_cue": "葱段翠绿，面条干爽，颜色和形态变化明显"
    }
  ],
  "tips": [
    "面条煮到八分熟就捞出过冷水，拌一点植物油防粘，炒时才不坨。",
    "全程大火快炒，蔬菜下锅三十秒内就要出香气，久炒会出汤。",
    "生抽沿锅边淋入，遇热激出酱香，比直接倒在面上更香。"
  ],
  "common_mistakes": [
    "面条煮到全熟再炒，成品软塌糊成一团，完全没嚼劲。",
    "蔬菜一次全下锅，温度掉得太快，炒出来是水煮菜味。",
    "生抽一次倒太多，面条发黑发咸，把蔬菜的清甜全盖住。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "白菜",
      "ratio": "150克:150克",
      "note": "白菜出水多，须大火快炒并少放盐。"
    },
    {
      "original": "香醋",
      "substitute": "柠檬",
      "ratio": "8毫升:10毫升",
      "note": "挤汁最后淋，酸味更清爽。"
    }
  ],
  "variations": [
    "加一把熟虾仁或鸡丝，就是加料版炒面，蛋白质更足。",
    "撒一勺印度中式辣酱同炒，酸甜带辣，是加尔各答街头的吃法。"
  ],
  "serving_suggestion": "装盘撒小葱段，配一碟辣酱和一碗清汤，趁热吃面才弹。",
  "storage": "冷藏可放一天，回热用炒锅大火快炒一分钟，微波会出水变硬。",
