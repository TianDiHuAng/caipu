        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木铲",
    "浅盘",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "藏红花放进两勺温牛奶里泡十分钟，让小豆蔻取籽后碾成细粉备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "藏红花要泡到奶色发黄才有效，干撒颜色出不来。",
      "visual_cue": "奶液呈浅金黄色，花丝变软"
    },
    {
      "n": 2,
      "text": "厚底锅放酥油小火化开，倒面粉翻炒到颜色微黄、质地松散。",
      "time_min": 7,
      "heat": "小火",
      "tip": "厚底锅受热均匀，薄锅炒粉容易外围先焦。",
      "visual_cue": "面粉微微发黄，闻得到麦香"
    },
    {
      "n": 3,
      "text": "分三次倒入剩下的牛奶，每次搅到完全吸收再加下一次。",
      "time_min": 8,
      "heat": "小火",
      "tip": "牛奶必须分次加，一次倒完面粉会结成硬疙瘩。",
      "visual_cue": "粉糊顺滑无颗粒，铲子划过留痕"
    },
    {
      "n": 4,
      "text": "加白糖与藏红花奶液，继续小火翻炒到粉糊变稠、不再粘锅底。",
      "time_min": 6,
      "heat": "小火",
      "tip": "炒到铲子推过能见锅底、粉糊成团才算到位。",
      "visual_cue": "粉糊抱成团，锅底干净不挂糊"
    },
    {
      "n": 5,
      "text": "关火拌入小豆蔻粉，把粉团倒进浅盘压平，晾到温热不烫手。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压平时用铲背压紧，成品切块才不松散。",
      "visual_cue": "表面平整，边缘不塌"
    },
    {
      "n": 6,
      "text": "取小块搓圆后轻压成小饼，中间按一颗腰果，再点一颗葡萄干装饰。",
      "time_min": 4,
      "heat": "无火",
      "tip": "按凹窝能让装饰粘牢，否则一碰就掉。",
      "visual_cue": "饼面圆整，中间凹处嵌着坚果"
    }
  ],
  "tips": [
    "牛奶用全脂的，脂肪少熬出来不够香。",
    "炒制全程小火，火大粉糊会在锅底结焦块。",
    "想省时间可以先在锅里把牛奶收浓一半再下面粉。",
    "晾凉后会变硬一点，别压得太薄。"
  ],
  "common_mistakes": [
    "牛奶一次全倒进粉里，粉糊结成一团团的硬块。",
    "白糖和面粉一起下锅，糖先化开导致粉糊发黏糊底。",
    "藏红花没泡就直接加，成品颜色淡且分布不均。",
    "粉团凉透才压模，边缘裂开掉渣。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "全脂奶粉",
      "ratio": "250 克:150 克",
      "note": "奶味更浓，牛奶减少一百毫升。"
    },
    {
      "original": "腰果",
      "substitute": "开心果",
      "ratio": "30 克:30 克",
      "note": "颜色更绿，装饰效果更好。"
    }
  ],
  "variations": [
    "加一小勺可可粉揉进粉团，做成双色奶糕。",
    "把白糖换成红糖，成品带焦糖风味，颜色更深。"
  ],
  "serving_suggestion": "四块摆在小碟里，配一杯热红茶，下午茶或节庆待客都合适，常温吃口感最松软。",
  "storage": "密封冷藏可放三天，吃前回温十分钟；受潮会发黏，务必装盒密封。",
