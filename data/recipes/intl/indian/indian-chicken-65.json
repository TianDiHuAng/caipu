  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成三厘米见方的块，用厨房纸吸干表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面越干，裹粉越服帖，炸的时候也不炸油。",
      "visual_cue": "鸡块表面不泛水光。"
    },
    {
      "n": 2,
      "text": "鸡块加酸奶、姜末、蒜末、辣椒粉、姜黄与盐抓匀，冷藏腌二十分钟。",
      "time_min": 7,
      "heat": "无火",
      "tip": "腌料抓到手感发黏，味道才进得去。",
      "visual_cue": "鸡块裹满橙色腌料。"
    },
    {
      "n": 3,
      "text": "把玉米淀粉与面粉混匀，倒入鸡块中抓拌到每块都挂上薄粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "粉要薄，厚了炸出来像面团。",
      "visual_cue": "鸡块表面呈干爽颗粒状。"
    },
    {
      "n": 4,
      "text": "锅里倒植物油烧到六成热，鸡块分批下锅，炸四分钟捞出。",
      "time_min": 7,
      "heat": "中火",
      "tip": "一次别下太多，油温掉了就炸不脆。",
      "visual_cue": "鸡块浮起，外层浅金。"
    },
    {
      "n": 5,
      "text": "全部炸完后把油温升到八成热，鸡块回锅复炸一分钟至酥脆。",
      "time_min": 6,
      "heat": "大火",
      "tip": "复炸是外壳酥的关键，别省这一步。",
      "visual_cue": "外壳深金，敲起来发硬。"
    },
    {
      "n": 6,
      "text": "另起锅留少量底油，爆香咖喱叶与小米辣，倒入鸡块翻匀，挤青柠汁出锅。",
      "time_min": 7,
      "heat": "大火",
      "tip": "青柠汁最后挤，久炒酸味会变钝。",
      "visual_cue": "鸡块裹上油亮香叶，闻得到酸香。"
    }
  ],
  "tips": [
    "鸡块切得大小一致，炸的时间才好控制。",
    "复炸前把鸡块捞出沥油，油温回升后再下，外壳才脆。",
    "没有咖喱叶可以用小葱段代替，香气不同但同样好吃。"
  ],
  "common_mistakes": [
    "鸡块带水下油，油花四溅还炸不脆。",
    "粉裹太厚，炸出来外壳硬、里面还是生的。"
  ],
  "substitutions": [
    {
      "original": "玉米淀粉",
      "substitute": "土豆淀粉",
      "ratio": "40g 对 40g",
      "note": "土豆淀粉炸出来更脆，回软也更快。"
    }
  ],
  "variations": [
    "餐厅版本会把鸡块炸好后和炒香的洋葱丝、咖喱叶一起颠锅，做成干炒的 65，配啤酒最合适。"
  ],
  "serving_suggestion": "趁热上桌，配青柠角与洋葱圈，当主菜或下酒菜都行。",
  "storage": "冷藏一天，复热用空气炸锅 180℃ 烤五分钟，别用微波炉。",
