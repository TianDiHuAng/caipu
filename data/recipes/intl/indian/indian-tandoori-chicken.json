      "group": "main",
      "items": [
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 700,
          "unit": "g",
          "note": "去骨带皮，切大块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 200,
          "unit": "g",
          "note": "浓稠原味，做腌料基底",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "磨成姜泥",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 20,
          "unit": "g",
          "note": "压成蒜泥",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "半个挤汁，半个切角",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "印度综合香料",
          "name_en": "garam masala",
          "amount": 12,
          "unit": "g",
          "note": "Garam Masala",
          "optional": false
        },
        {
          "name": "红椒粉",
          "name_en": "paprika",
          "amount": 10,
          "unit": "g",
          "note": "上色提香",
          "optional": false
        },
        {
          "name": "姜黄",
          "name_en": "turmeric",
          "amount": 3,
          "unit": "g",
          "note": "少量上色",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
          "unit": "g",
          "note": "腌料用",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "刷面防干",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤架",
    "保鲜袋",
    "食品夹"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用叉子在厚处扎些小孔，加盐和柠檬汁抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "扎孔和柠檬汁都能帮咸味渗进肉里，别省这步。",
      "visual_cue": "鸡肉表面微湿、盐粒化开"
    },
    {
      "n": 2,
      "text": "酸奶、姜泥、蒜泥、印度综合香料、红椒粉和姜黄拌成腌料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香料先与酸奶拌开再下肉，颜色才均匀。",
      "visual_cue": "腌料呈均匀橘红色、无干粉"
    },
    {
      "n": 3,
      "text": "鸡肉与腌料抓匀装进保鲜袋，冷藏静置四小时以上入味。",
      "time_min": 15,
      "heat": "无火",
      "tip": "冷藏过夜风味最好，赶时间也要留足一小时。",
      "visual_cue": "每块鸡肉都裹满腌料、袋内无积气"
    },
    {
      "n": 4,
      "text": "烤箱预热到两百二十度，烤架上铺锡纸并刷一层薄油。",
      "time_min": 12,
      "heat": "无火",
      "tip": "烤架比烤盘受热更均匀，底部不会泡在汁水里。",
      "visual_cue": "烤箱指示灯灭、能感到热浪"
    },
    {
      "n": 5,
      "text": "鸡肉抖掉多余腌料摆上烤架，表面刷一层植物油后入炉烤十五分钟。",
      "time_min": 15,
      "heat": "大火",
      "tip": "腌料留太厚会烤焦，轻轻刮掉一层再刷油更安全。",
      "visual_cue": "表面干爽上色、边缘微微焦香"
    },
    {
      "n": 6,
      "text": "翻面再烤八分钟，取出静置五分钟，配柠檬角上桌。",
      "time_min": 10,
      "heat": "大火",
      "tip": "静置能让肉汁回流，切开不会流一盘子水。",
      "visual_cue": "表皮带焦斑、按压有弹性"
    }
  ],
  "tips": [
    "酸奶要选浓稠无糖的，稀酸奶挂不住肉。",
    "没有烤箱可用厚底锅加盖小火焖烤，中途翻面一次。",
    "想要更浓的烟熏味，可在烤架下撒一把茶叶和红糖同烤。"
  ],
  "common_mistakes": [
    "腌料里盐放太早太多，烤完肉质发紧发柴。",
    "鸡肉从冰箱取出直接进烤箱，外焦里生。",
    "烤盘没垫锡纸，滴落的腌料糊成黑烟熏满厨房。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "700g 对 650g",
      "note": "鸡胸更瘦，烤的时间缩短三分钟。"
    },
    {
      "original": "酸奶",
      "substitute": "椰奶",
      "ratio": "200g 对 180ml",
      "note": "适合乳糖不耐受，香气偏甜。"
    }
  ],
  "variations": [
    "腌好后穿成串用炭火烤，做成街头风味的鸡肉串。",
    "烤好的鸡肉撕碎拌入生菜与洋葱，做成坦都里鸡肉沙拉。"
  ],
  "serving_suggestion": "配洋葱圈、柠檬角和薄荷酸奶酱，佐馕或印度香米饭。",
  "storage": "冷藏两天，复热用烤箱两百度烤六分钟，别用微波炉。",
