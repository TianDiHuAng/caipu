          "name_en": "curry powder",
          "amount": 12,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "姜黄",
          "name_en": "turmeric",
          "amount": 3,
          "unit": "g",
          "note": "增色",
          "optional": false
        },
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 100,
          "unit": "g",
          "note": "腌肉",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
