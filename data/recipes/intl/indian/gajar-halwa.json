        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "刨丝器",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "胡萝卜去皮擦成细丝，600g 大约能擦出一大碗，越细越易煮软。",
      "time_min": 8,
      "heat": "无火",
      "tip": "用最细的孔擦，口感才像布丁。",
      "visual_cue": "胡萝卜丝细软、颜色橙亮"
    },
    {
      "n": 2,
      "text": "厚底锅放 20g 黄油融化，下胡萝卜丝中火翻炒 5 分钟至变软出水。",
      "time_min": 7,
      "heat": "中火",
      "tip": "先炒出胡萝卜的生味。",
      "visual_cue": "胡萝卜丝塌软、锅底有水"
    },
    {
      "n": 3,
      "text": "倒入 500ml 牛奶，中小火慢煮 25 分钟，其间不断搅拌防糊底。",
      "time_min": 27,
      "heat": "中小火",
      "tip": "牛奶收干是关键，别急。",
      "visual_cue": "牛奶几乎收干、胡萝卜呈泥状"
    },
    {
      "n": 4,
      "text": "加 80g 白糖与剩余 20g 黄油，继续翻炒 8 分钟至酱体抱团不粘锅。",
      "time_min": 9,
      "heat": "中小火",
      "tip": "炒到能从锅底整块翻起最好。",
      "visual_cue": "混合物浓稠、铲子划过留痕"
    },
    {
      "n": 5,
      "text": "腰果碎用干锅焙 3 分钟，与泡软的葡萄干一起拌入，撒 1g 豆蔻粉。",
      "time_min": 5,
      "heat": "小火",
      "tip": "豆蔻最后加，香气才不散。",
      "visual_cue": "坚果香明显、色泽深橙油亮"
    }
  ],
  "tips": [
    "牛奶要慢慢收干，火大容易焦底。",
    "全程不停搅拌，这是这道甜点唯一的技术点。",
    "豆蔻最后放，久煮香气会跑光，出锅前再撒更香。"
  ],
  "common_mistakes": [
    "胡萝卜丝擦得太粗，煮完仍有硬芯。",
    "中途走开不搅，锅底结一层焦黑。",
    "牛奶没收干就加糖，成品稀得像粥。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "500ml 对 350ml",
      "note": "更浓郁，煮制时间减 5 分钟。"
    },
    {
      "original": "腰果",
      "substitute": "杏仁",
      "ratio": "30g 对 30g",
      "note": "需先烤香再切碎。"
    }
  ],
  "variations": [
    "南瓜版：用 600g 南瓜泥代替胡萝卜。",
    "无糖版：白糖换成 60g 红枣泥，甜味更自然。"
  ],
  "serving_suggestion": "温热或冷藏后食用，配一球香草冰淇淋更佳。",
  "storage": "冷藏 4 天，冷冻 1 个月，复热需加少许牛奶调开。",
