  "equipment": [
    "汤锅",
    "炒锅",
    "菜刀",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "绿豆用清水冲洗两遍，再泡二十分钟，泡到豆皮起皱、豆粒稍稍胀大。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冲洗到水变清再加清水泡，汤色才不会浑。",
      "visual_cue": "豆粒发胀，豆皮起皱，捏着稍软"
    },
    {
      "n": 2,
      "text": "洋葱切成小丁，姜切细末，大蒜拍碎，番茄切成两厘米的小块分别装碗。",
      "time_min": 6,
      "heat": "无火",
      "tip": "三样切得大小一致，下锅受热才均匀。",
      "visual_cue": "小丁大小齐整，番茄切开带汁"
    },
    {
      "n": 3,
      "text": "炒锅放植物油，中火下洋葱丁炒三分钟到透明发软，再下姜末和蒜末炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒到边缘透明再下姜蒜，否则蒜末先糊。",
      "visual_cue": "洋葱透亮，蒜末微黄不焦"
    },
    {
      "n": 4,
      "text": "倒进番茄块、姜黄粉和孜然，中火翻炒三分钟，炒到番茄出汁塌软。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出红汁再加水，汤的甜味靠这一步。",
      "visual_cue": "番茄塌软，锅底析出红油"
    },
    {
      "n": 5,
      "text": "加泡好的绿豆和清水，大火烧开后转小火煮二十分钟，煮到豆粒开花。",
      "time_min": 22,
      "heat": "小火",
      "tip": "水面要保持微沸，火一大汤底就容易浑",
      "visual_cue": "豆粒开花，汤面浮起细沫"
    },
    {
      "n": 6,
      "text": "用勺子把部分豆粒压碎让汤变稠，加余下的盐再煮三分钟，尝味后关火。",
      "time_min": 4,
      "heat": "小火",
      "tip": "压几勺就够，全压成泥就失去汤的层次。",
      "visual_cue": "汤汁挂勺，豆香浓而不腻"
    }
  ],
  "tips": [
    "绿豆仁煮到开花就好，煮太久整锅会化成糊，失去汤的口感。",
    "姜黄粉三克足够上色，手一抖放多了汤会发苦，宁可少放。",
    "想更浓稠可以多压几下豆粒，但别用搅拌机打，打成泥就成豆糊了。"
  ],
  "common_mistakes": [
    "绿豆没有泡就直接下锅，煮半小时豆芯还是硬的，汤也不香。",
    "洋葱不炒到发软就加清水，汤里有生洋葱的辛辣气，喝着刺口。",
    "盐一开始就放足，豆粒不容易煮软，应等豆开花后再调味。"
  ],
  "substitutions": [
    {
      "original": "绿豆",
      "substitute": "红豆",
      "ratio": "200克:200克",
      "note": "红豆需多煮十分钟，汤色更深。"
    },
    {
      "original": "植物油",
      "substitute": "黄油",
      "ratio": "20毫升:20克",
      "note": "黄油版更香，适合配烤饼食用。"
    }
  ],
  "variations": [
    "加一小把咖喱叶和芥末籽在油里爆香，南方风味更足。",
    "关火前挤半个柠檬的汁，酸味把豆香提起来，夏天喝更清爽。"
  ],
  "serving_suggestion": "热汤盛进深碗，配印度烤饼或者白米饭，喝前撒一点黑胡椒更提味。",
  "storage": "冷藏可放两天，回热时补充少量液体调稀，煮开后饮用，有酸味即丢。",
