  "steps": [
    {
      "n": 1,
      "text": "隔夜冷饭用手轻轻拨散，结块的地方掰开，不要压碎米粒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冷饭水分低，拌起来才不会黏成一团。",
      "visual_cue": "米粒颗颗分明，没有整块粘结"
    },
    {
      "n": 2,
      "text": "平底锅小火烧热，放花生米干炒四分钟到外皮开裂。",
      "time_min": 4,
      "heat": "小火",
      "tip": "花生要冷锅下，慢慢升温才不会外焦内生。",
      "visual_cue": "花生表皮裂开，颜色转深散出香气"
    },
    {
      "n": 3,
      "text": "锅里倒植物油，下芥末籽等它爆开，再放咖喱叶与青椒圈。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芥末籽一跳就马上加其他料，跳久会发苦。",
      "visual_cue": "芥末籽不断弹跳，咖喱叶卷曲变脆"
    },
    {
      "n": 4,
      "text": "加姜黄粉与盐，小火炒十秒让香料在油里散开。",
      "time_min": 1,
      "heat": "小火",
      "tip": "姜黄粉遇高温容易焦，下锅十秒内就要加饭。",
      "visual_cue": "油色转成明亮的金黄色"
    },
    {
      "n": 5,
      "text": "倒入米饭快速翻炒三分钟，让每粒米都裹上香料油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "用铲子切拌而不是向下压，米粒才会完整有嚼感。",
      "visual_cue": "米粒金黄分明，锅底没有结块"
    },
    {
      "n": 6,
      "text": "离火后淋柠檬汁与皮屑，撒花生拌匀，尝味补盐。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬汁一定要离火后加，加热会变苦。",
      "visual_cue": "米饭松散带光，酸香扑鼻"
    }
  ],
  "tips": [
    "柠檬汁现挤现拌，放久了清香会跑掉。",
    "配一碟酸奶或酸辣酱，酸辣平衡更好吃。",
    "加一把炸过的腰果，口感更丰富也更有节庆感。",
    "米饭煮得偏硬一点，拌好后口感最合适。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭直接拌，米粒糊成一团没有颗粒感。",
    "柠檬汁跟着米饭一起炒，酸味变苦香气全失。",
    "芥末籽在油里炸太久，整锅饭都带焦苦味。"
  ],
  "substitutions": [
    {
      "original": "花生",
      "substitute": "腰果",
      "ratio": "40克:40克",
      "note": "坚果过敏者需完全去掉。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "60克:50克",
      "note": "酸味更尖锐，香气偏东南亚风。"
    }
  ],
  "variations": [
    "加一小把煮熟的青豆与胡萝卜丁，颜色更热闹。",
    "把柠檬换成橙子，做成甜香柔和的橙香饭。"
  ],
  "serving_suggestion": "作为配饭与咖喱、豆汤同吃，也适合装盒当便当。",
  "storage": "冷藏两天，复热时用平底锅小火翻炒，不要用微波炉久加热。",
