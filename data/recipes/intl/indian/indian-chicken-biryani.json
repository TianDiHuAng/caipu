  "equipment": [
    "厚底锅",
    "汤锅",
    "碗",
    "纱布",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切块，加酸奶、咖喱粉、姜黄、蒜末、姜末与盐抓匀腌半小时。",
      "time_min": 30,
      "heat": "无火",
      "tip": "酸奶能让香料附着并软化肉质，别省。",
      "visual_cue": "鸡块裹满橙色腌料，盆底有稠汁"
    },
    {
      "n": 2,
      "text": "泰国香米淘洗后浸泡三十分钟，煮到米粒半熟带硬芯后捞出。",
      "time_min": 30,
      "heat": "中火",
      "tip": "煮到三分之二熟即可，后面还要焖。",
      "visual_cue": "米粒中间留一点白芯"
    },
    {
      "n": 3,
      "text": "洋葱一半切丝用植物油炸到深金酥脆，捞起沥油备用。",
      "time_min": 8,
      "heat": "中火",
      "tip": "小火慢炸才有酥脆感，火大易焦。",
      "visual_cue": "洋葱丝金黄酥脆，油色变深"
    },
    {
      "n": 4,
      "text": "厚底锅下少许油炒香洋葱末，倒入腌好的鸡块煎至表面收紧。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸡块先煎上色，焖出来才香。",
      "visual_cue": "鸡块表面微焦，腌料贴附"
    },
    {
      "n": 5,
      "text": "把半熟米饭铺在鸡块上，撒炸洋葱、香菜、腰果与藏红花水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "分层堆叠而不是拌匀，这是焖饭的关键。",
      "visual_cue": "米饭覆盖鸡块，表面点缀金黄"
    },
    {
      "n": 6,
      "text": "黄油化开淋在米饭上，锅边淋两勺水，盖紧锅盖小火焖二十五分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "盖前用湿布封边，蒸汽不跑才焖得透。",
      "visual_cue": "锅边冒细汽，飘出香料味"
    },
    {
      "n": 7,
      "text": "关火静置十分钟再开盖，用长勺从底部轻翻拌匀，配酸奶上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置能让米粒定型，翻拌时别压碎。",
      "visual_cue": "米粒分明，鸡块酥软"
    }
  ],
  "tips": [
    "长粒米要泡透，煮到半熟再焖才不会糊成一团。",
    "藏红花水是颜色和香气的来源，用温水泡十分钟。",
    "锅盖用湿布封边或压重物，蒸汽跑掉米就夹生。"
  ],
  "common_mistakes": [
    "米煮得太软再焖，成品黏成一坨没有粒感。",
    "火太大导致锅底焦糊，整锅带着苦味。",
    "香料没炒开就下鸡块，吃出生粉感与苦味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "羊肉",
      "ratio": "600 克:600 克",
      "note": "炖制时间延长十五分钟。"
    },
    {
      "original": "酸奶",
      "substitute": "椰奶",
      "ratio": "150 克:150 毫升",
      "note": "香气更浓，需减少盐三克。"
    }
  ],
  "variations": [
    "加土豆块同焖，是印度北部的家常版本。",
    "把鸡肉换成蔬菜与鹰嘴豆，做成素食焖饭。"
  ],
  "serving_suggestion": "盛盘配一小碗酸奶与腌洋葱，趁热吃最香。",
  "storage": "冷藏两天、冷冻一个月；复热加一勺水小火焖十分钟。",
