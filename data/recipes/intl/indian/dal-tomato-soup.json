  "equipment": [
    "汤锅",
    "炒锅",
    "搅拌棒",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扁豆 200g 用清水淘洗两遍，加 800ml 清水浸泡 20 分钟后连水倒入汤锅。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过的扁豆更容易煮烂。",
      "visual_cue": "扁豆吸水膨胀、水略浑浊"
    },
    {
      "n": 2,
      "text": "汤锅大火煮开后转小火，加盖煮 25 分钟至扁豆完全软烂能压成泥。",
      "time_min": 26,
      "heat": "小火",
      "tip": "煮到用手指一捏就碎才算到位。",
      "visual_cue": "扁豆开花、汤色发黄"
    },
    {
      "n": 3,
      "text": "炒锅放 20g 黄油融化，下洋葱丁中火炒 3 分钟至边缘透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透才有甜味，别急着下番茄。",
      "visual_cue": "洋葱透明、锅底微甜香"
    },
    {
      "n": 4,
      "text": "加入蒜末、姜末、4g 孜然、3g 姜黄粉与 3g 辣椒粉，小火炒 40 秒出香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香料小火炒，火大立刻发苦。",
      "visual_cue": "香料冒泡、香气浓郁"
    },
    {
      "n": 5,
      "text": "倒入番茄块炒到软塌出汁，再连汤带豆倒入汤锅，加 6g 盐小火煮 8 分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "番茄炒出红汁，汤色才亮。",
      "visual_cue": "汤汁橙红、番茄化开"
    },
    {
      "n": 6,
      "text": "用搅拌棒把汤打成粗泥，回锅煮开，撒香菜碎盛出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "留一点豆粒口感更好，别打太细。",
      "visual_cue": "汤体浓稠、能挂住勺背"
    }
  ],
  "tips": [
    "扁豆一定要煮到软烂，否则口感发硬且不易消化。",
    "番茄先炒出汁再入汤，酸香更立体。",
    "打泥时留一点颗粒，口感更有层次。"
  ],
  "common_mistakes": [
    "扁豆没泡直接煮，半小时还是硬的。",
    "香料用大火爆炒，几秒钟就焦糊发苦。",
    "盐一次放足又加辣，咸辣盖住豆香。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "鹰嘴豆",
      "ratio": "200g 对 200g",
      "note": "需浸泡 6 小时并多煮 10 分钟。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "20g 对 18ml",
      "note": "素食版更清爽。"
    }
  ],
  "variations": [
    "椰香版：最后加 100ml 椰浆同煮。",
    "菠菜版：起锅前放 100g 菠菜烫软。"
  ],
  "serving_suggestion": "盛入汤碗，配馕或白饭，挤少许柠檬汁。",
  "storage": "冷藏 3 天，冷冻 1 个月，复热时加水调稀。",
