  "equipment": [
    "平底锅",
    "打蛋碗",
    "打蛋器",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱、番茄与青椒分别切碎，香菜切末，全部放碗里待用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蔬菜切得越细越容易在蛋液里分布均匀。",
      "visual_cue": "蔬菜碎大小一致，碗底没有积水"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进碗里，加姜黄粉、辣椒粉、盐与黑胡椒打散。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打到蛋清蛋黄完全融合，蛋卷才没有白斑。",
      "visual_cue": "蛋液颜色均匀，表面浮一层小泡"
    },
    {
      "n": 3,
      "text": "把蔬菜碎与香菜末拌进蛋液，静置三分钟让味道融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蔬菜会出水，拌好后要马上入锅别久放。",
      "visual_cue": "蛋液里蔬菜分布均匀，略见稀水"
    },
    {
      "n": 4,
      "text": "平底锅烧热放印度酥油，倒入蛋液转中小火煎三分钟。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "油要铺满锅底，蛋皮才不会粘住撕破。",
      "visual_cue": "蛋液边缘凝固鼓起，中心仍略晃动"
    },
    {
      "n": 5,
      "text": "表面基本凝固后对折成半月形，再煎一分钟出锅。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "对折时用铲子托住底部，整片翻不会断。",
      "visual_cue": "蛋卷两面金黄，切开内部无流动蛋液"
    }
  ],
  "tips": [
    "配两片烤面包和一杯印度香料茶，就是很完整的早餐。",
    "喜欢辣可以把青椒换成绿辣椒，辣度更直接。",
    "酥油换成黄油也行，香气稍淡但一样好吃。",
    "蔬菜先炒软再拌蛋液，成品口感更温润。"
  ],
  "common_mistakes": [
    "火太大急着定型，蛋皮底部焦黑而中心还是流动的。",
    "蔬菜切得太粗，蛋卷折起来就裂开散架。",
    "鸡蛋没打匀就下锅，蛋皮上出现白色斑块影响卖相。"
  ],
  "substitutions": [
    {
      "original": "印度酥油",
      "substitute": "植物油",
      "ratio": "15克:15毫升",
      "note": "风味更清爽，但少了奶香。"
    },
    {
      "original": "青椒",
      "substitute": "甜椒",
      "ratio": "40克:40克",
      "note": "完全不辣，适合孩子。"
    }
  ],
  "variations": [
    "加入一小把磨碎的奶酪，趁热折起来做成爆浆版本。",
    "把鸡蛋换成三颗蛋加两颗蛋清，蛋白质更高更轻盈。"
  ],
  "serving_suggestion": "趁热吃，配面包、薄饼或番茄酱都很合适，也是很常见的早餐。",
  "storage": "现做现吃最好，冷藏可存一天，回热时用平底锅小火两面各煎一分钟。",
  "nutrition_estimate": {
    "basis": "按两人份估算",
