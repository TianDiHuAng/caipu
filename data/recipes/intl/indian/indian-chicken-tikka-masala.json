  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉块加酸奶、姜泥、蒜泥、一半咖喱粉、姜黄与盐抓匀，冷藏腌制。",
      "time_min": 30,
      "heat": "无火",
      "tip": "酸奶里的酸能软化肉质，腌足半小时再煎才嫩。",
      "visual_cue": "肉块裹满橙黄腌料，手感黏稠"
    },
    {
      "n": 2,
      "text": "厚底锅下植物油，把腌好的鸡块分批中火煎至表面焦黄。",
      "time_min": 10,
      "heat": "中火",
      "tip": "腌料先刮掉一些，否则容易在锅里烧黑发苦。",
      "visual_cue": "鸡块表面焦褐，内部仍略带粉色"
    },
    {
      "n": 3,
      "text": "原锅下黄油与洋葱丝，小火炒到洋葱软塌发甜。",
      "time_min": 8,
      "heat": "小火",
      "tip": "洋葱要炒到出甜味，咖喱的甜底就靠它。",
      "visual_cue": "洋葱琥珀色，锅底有甜香"
    },
    {
      "n": 4,
      "text": "加姜蒜泥、剩余咖喱粉、孜然与辣椒粉，小火炒三十秒出香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "香料在油里只需半分钟，炒久立刻发苦。",
      "visual_cue": "香料油冒香，颜色转深"
    },
    {
      "n": 5,
      "text": "倒入番茄块中火炒十五分钟，用铲背压碎成浓稠酱汁。",
      "time_min": 15,
      "heat": "中火",
      "tip": "番茄要炒到出油分离，酱体才够浓。",
      "visual_cue": "番茄完全化开，锅边泛红油"
    },
    {
      "n": 6,
      "text": "把鸡块倒回锅中加白糖与半杯水，小火炖十分钟至肉熟透。",
      "time_min": 12,
      "heat": "小火",
      "tip": "炖到鸡肉能用筷子轻松插透就够了。",
      "visual_cue": "汤汁浓稠挂勺，鸡块上色"
    },
    {
      "n": 7,
      "text": "淋入淡奶油拌匀，关火撒香菜碎配米饭上桌。",
      "time_min": 5,
      "heat": "小火",
      "tip": "奶油最后加且不要煮滚，否则容易油水分离。",
      "visual_cue": "酱色转成柔和的橘粉"
    }
  ],
  "tips": [
    "腌肉时间越长越嫩，隔夜冷藏风味更足。",
    "番茄底酱炒到出红油，是这道菜颜色漂亮的关键。",
    "配印度香米或烤饼蘸酱吃最合适。"
  ],
  "common_mistakes": [
    "腌料没刮就下锅，糖分焦化使酱色发黑发苦。",
    "奶油大火煮沸，酱汁当场分离出油。",
    "鸡肉炖太久，肉质变柴失去弹性。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "椰奶",
      "ratio": "150 毫升:150 毫升",
      "note": "奶香变椰香，酸度略降。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600 克:600 克",
      "note": "腌足时间，炖制缩短三分钟以免发干。"
    }
  ],
  "variations": [
    "最后一勺腰果酱拌进酱汁，酱体更浓更香，口感也更顺滑。",
    "用炭火烤鸡块再入酱，烟熏味更接近北印度风味。"
  ],
  "serving_suggestion": "盛在碗中淋上酱汁，配香米饭与烤饼同食。",
  "storage": "冷藏三天、冷冻一个月；复热小火加少量水，避免猛火使奶油分离。",
