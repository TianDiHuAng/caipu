  "equipment": [
    "煮锅",
    "平底锅",
    "深锅",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅煮九分钟，一次煮六颗，捞出泡凉水后剥壳，擦干表面水分。",
      "time_min": 12,
      "heat": "中火",
      "tip": "煮好立刻过凉水，蛋壳一剥就整片脱落。",
      "visual_cue": "蛋黄中心呈亮黄凝固状，蛋白光滑无破"
    },
    {
      "n": 2,
      "text": "猪肉末加一半洋葱碎、盐与孜然粉，顺同一方向搅到起黏性。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅到肉馅能挂住碗壁，包蛋时才不散。",
      "visual_cue": "猪肉末抱团发黏，表面泛出细密纹路"
    },
    {
      "n": 3,
      "text": "手上抹水，把猪肉末压成薄片裹住整颗鸡蛋，六颗逐一裹好，收口捏紧。",
      "time_min": 8,
      "heat": "无火",
      "tip": "裹得薄而匀，煎的时候才不会一边厚一边破。",
      "visual_cue": "肉层厚度均匀，收口处完全封住不漏蛋"
    },
    {
      "n": 4,
      "text": "平底锅化酥油，中火把肉丸滚动煎到表面金黄定型。",
      "time_min": 8,
      "heat": "中火",
      "tip": "一边煎一边转动，让整颗都上色不夹生。",
      "visual_cue": "肉层表面金黄紧实，轻推能滚圈"
    },
    {
      "n": 5,
      "text": "另起深锅炒剩余洋葱到透明，加番茄、姜黄粉与辣椒粉炒成酱。",
      "time_min": 8,
      "heat": "中火",
      "tip": "番茄炒到出油发亮，酱才不会水汪汪。",
      "visual_cue": "番茄完全塌软，锅底浮出红色油脂"
    },
    {
      "n": 6,
      "text": "倒入酸奶搅匀，放回肉丸，小火炖十五分钟收汁。",
      "time_min": 15,
      "heat": "小火",
      "tip": "酸奶要一点一点加，一次倒容易分层出水。",
      "visual_cue": "酱汁浓稠裹住肉丸，表面泛油光"
    },
    {
      "n": 7,
      "text": "撒香菜出锅，吃的时候对半切开露出中心的蛋。",
      "time_min": 2,
      "heat": "无火",
      "tip": "切开的断面要工整，摆盘时蛋黄才露在正中间好看。",
      "visual_cue": "切面蛋白雪白蛋黄亮黄，肉层完整不脱落"
    }
  ],
  "tips": [
    "鸡蛋煮好可提前一晚冷藏，第二天裹肉更快。",
    "肉层里拌少许面包糠，能吸住汁水不易开裂。",
    "酱汁嫌稀就多炖五分钟，别用水淀粉勾。",
    "配印度香米饭或烤饼，汤汁拌饭尤其好吃。"
  ],
  "common_mistakes": [
    "鸡蛋表面带水就裹肉，煎的时候肉层整片脱落。",
    "肉馅没搅出黏性就包蛋，下锅后肉层散开露出蛋。",
    "酸奶一次全倒进热锅，酱汁立刻分层出现颗粒。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡肉末",
      "ratio": "240克:240克",
      "note": "更瘦，需多加十克酥油防干。"
    },
    {
      "original": "酸奶",
      "substitute": "椰浆",
      "ratio": "100克:100克",
      "note": "奶香更浓，酸味消失。"
    }
  ],
  "variations": [
    "把鸡蛋换成鹌鹑蛋，做成一口大小的迷你版本。",
    "酱汁里加一勺腰果酱，口感更浓稠适合配烤饼。"
  ],
  "serving_suggestion": "配印度香米饭或黄油烤饼，配一小碟洋葱沙拉解腻。",
  "storage": "冷藏三天，酱汁与肉丸分开存放，复热时一起小火炖十分钟。",
