      "items": [
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 150,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 100,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "腰果",
          "name_en": "cashew",
          "amount": 30,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "小豆蔻",
          "name_en": "cardamom",
          "amount": 2,
          "unit": "g",
          "note": "取籽碾碎",
          "optional": false
        },
        {
          "name": "酥油",
          "name_en": "ghee",
          "amount": 50,
          "unit": "g",
          "note": "炒面与搓球",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "木铲",
    "浅盘",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "平底锅小火烧热放一半酥油，倒面粉不停翻炒到颜色转浅褐、散出坚果香。",
      "time_min": 8,
      "heat": "小火",
      "tip": "面粉要炒到能闻到香味，生面味会让成品发涩。",
      "visual_cue": "面粉由白转浅褐，颗粒松散"
    },
    {
      "n": 2,
      "text": "倒入椰浆继续翻炒，让面粉把水分吸干成粗颗粒状。",
      "time_min": 6,
      "heat": "小火",
      "tip": "椰浆分两次倒，一次倒完面粉会结成大团。",
      "visual_cue": "锅里的粉粒抱团又松散，不粘铲"
    },
    {
      "n": 3,
      "text": "加白糖、腰果碎与小豆蔻粉，翻匀到糖完全化开、整体微微发亮。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖化开后马上关火，再炒会返砂结成硬块。",
      "visual_cue": "糖粒消失，粉团表面泛油光"
    },
    {
      "n": 4,
      "text": "关火把粉团倒进浅盘摊开，晾到不烫手但仍温热的状态。",
      "time_min": 5,
      "heat": "无火",
      "tip": "太烫会把球搓散，凉透又会发硬搓不动，温热最好。",
      "visual_cue": "粉团温热不烫手，按压能成团"
    },
    {
      "n": 5,
      "text": "手上抹一点剩下的酥油，取一小团粉搓成乒乓球大小的圆球。",
      "time_min": 6,
      "heat": "无火",
      "tip": "手上抹油才不会粘，搓的时候用力均匀球面才光滑。",
      "visual_cue": "球体圆整光滑，表面不裂"
    }
  ],
  "tips": [
    "面粉换成全麦粉会更粗一点，但吸水量不同要少加椰浆。",
    "搓好的球放凉后会变硬一点，属正常状态。",
    "想更香可以在面粉里加一勺炒香的芝麻。",
    "装进小纸杯里摆盘，比直接堆放好看。"
  ],
  "common_mistakes": [
    "面粉没炒透就加椰浆，成品带明显生面味。",
    "糖化开后还继续炒，粉团返砂变成硬块搓不动。",
    "粉团完全凉透才搓，一按就裂开散成渣。",
    "手上不抹油直接搓，粉团全粘在掌心搓不圆。"
  ],
  "substitutions": [
    {
      "original": "椰浆",
      "substitute": "牛奶",
      "ratio": "150 毫升:150 毫升",
      "note": "椰香变淡，可加两勺奶粉补味。"
    },
    {
      "original": "腰果",
      "substitute": "花生",
      "ratio": "30 克:30 克",
      "note": "需先烤香去皮，切得碎一些。"
    }
  ],
  "variations": [
    "把白糖换成红糖，颜色更深、焦香更足。",
    "搓好球后滚一层干椰蓉，外层口感更丰富。"
  ],
  "serving_suggestion": "四到五个装一小碟，配无糖的茶或咖啡，饭后当甜点，常温吃的口感最软。",
  "storage": "密封常温可放三天，冷藏可存一周；受潮会失去香味，务必装罐密封。",
