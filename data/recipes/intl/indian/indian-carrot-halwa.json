      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "擦丝器",
    "木勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "胡萝卜削皮擦成细丝，越细越好，粗丝煮不软会硌牙。",
      "time_min": 12,
      "heat": "无火",
      "tip": "擦丝粗细决定口感，粗丝煮四十分钟仍带硬芯，像嚼草根。",
      "visual_cue": "胡萝卜丝细软，堆成小山"
    },
    {
      "n": 2,
      "text": "厚底锅化一半黄油，倒入胡萝卜丝中火翻炒五分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先炒出胡萝卜的生味再下牛奶，直接煮会有一股土腥气。",
      "visual_cue": "胡萝卜丝变软塌，颜色转深"
    },
    {
      "n": 3,
      "text": "倒入牛奶煮开，转小火慢煮二十五分钟，边煮边搅。",
      "time_min": 27,
      "heat": "小火",
      "tip": "牛奶容易糊底，必须用木勺一路刮锅底，别只搅表面。",
      "visual_cue": "牛奶收干一半，丝变软烂"
    },
    {
      "n": 4,
      "text": "加白糖与剩下黄油继续翻炒，直到锅底见油、混合物抱团。",
      "time_min": 10,
      "heat": "中火",
      "tip": "这一步要炒到水分基本走干，湿的话不成布丁，只是胡萝卜糊。",
      "visual_cue": "混合物成团，锅底泛油光"
    },
    {
      "n": 5,
      "text": "撒小豆蔻粉，拌入腰果碎与泡软的葡萄干，翻匀后盛出。",
      "time_min": 4,
      "heat": "小火",
      "tip": "坚果最后放才保脆，早放会被炒软，香气也散掉。",
      "visual_cue": "坚果均匀分布，甜香扑鼻"
    }
  ],
  "tips": [
    "胡萝卜布丁是印度冬天婚礼和节庆的必备甜点，趁热吃最香。",
    "用红皮胡萝卜做颜色更艳，甜度也更高。",
    "配一球香草冰淇淋，是德里餐厅里的时髦吃法。"
  ],
  "common_mistakes": [
    "胡萝卜丝擦得太粗，煮到时间还有生味，嚼着咯吱响。",
    "牛奶全程大火煮，锅底糊一层，整锅带焦苦。",
    "水分没炒干就起锅，装盘后出水，看着像胡萝卜汤。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "600毫升:500毫升",
      "note": "椰奶版更浓稠，煮的时间减五分钟。"
    },
    {
      "original": "腰果",
      "substitute": "杏仁",
      "ratio": "30克:30克",
      "note": "杏仁需先烤香再切碎。"
    }
  ],
  "variations": [
    "加一勺印度酥油替代黄油，香气更接近印度本土做法。",
    "放几粒藏红花泡牛奶同煮，颜色金黄，风味更贵气。"
  ],
  "serving_suggestion": "盛进小碗，趁温热吃，配一勺冰淇淋或一小杯浓茶。",
  "storage": "冷藏可存三天，复热时加一小勺牛奶小火翻热，勿微波会变干。",
