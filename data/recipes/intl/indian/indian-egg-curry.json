  "equipment": [
    "炒锅",
    "汤锅",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅煮十分钟，捞出过冷水后剥壳。",
      "time_min": 11,
      "heat": "中火",
      "tip": "煮好后立刻过冷水，壳好剥不粘蛋白。",
      "visual_cue": "蛋壳完整，蛋白光滑"
    },
    {
      "n": 2,
      "text": "剥好的鸡蛋对半切开，切面朝上平摆在盘里备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "切蛋用温水润刀，切面更平整好看。",
      "visual_cue": "蛋黄完整不散，切面平整"
    },
    {
      "n": 3,
      "text": "洋葱切碎末，番茄切小丁，姜和蒜分别切成细末。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱切得越碎，炒出来的酱汁越顺滑。",
      "visual_cue": "配料切碎分堆放好"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，下孜然和姜蒜末小火炒出香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "孜然遇热油就出香，别炒到发黑变苦。",
      "visual_cue": "孜然噼啪响，蒜末微黄"
    },
    {
      "n": 5,
      "text": "下洋葱碎中火炒到透明，加咖喱粉翻炒均匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "咖喱粉要在油里炒一下，香味才释放得开。",
      "visual_cue": "洋葱透亮，油色发黄"
    },
    {
      "n": 6,
      "text": "加番茄丁炒到出沙，倒椰奶和清水烧开成酱汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒到塌软出汁，酱汁才浓稠不寡。",
      "visual_cue": "番茄成泥，酱汁翻滚"
    },
    {
      "n": 7,
      "text": "放入鸡蛋小火焖八分钟，加盐调味撒香菜碎。",
      "time_min": 8,
      "heat": "小火",
      "tip": "鸡蛋入锅后别猛翻，轻推才不会散。",
      "visual_cue": "酱汁浓稠裹蛋，油亮泛红"
    }
  ],
  "tips": [
    "鸡蛋煮好立刻过冷水，剥壳完整漂亮。",
    "咖喱粉先用油炒香，味道才不寡淡发粉。",
    "焖制用小火，酱汁才浓而不糊底。"
  ],
  "common_mistakes": [
    "鸡蛋煮过头，蛋黄边缘发绿还带硫味。",
    "咖喱粉直接下水和煮，香味出不来还发涩。",
    "大火焖蛋不停翻动，蛋黄全散进酱汁里。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "淡奶油",
      "ratio": "150 毫升:120 毫升",
      "note": "奶香更浓，需另加三十毫升清水。"
    },
    {
      "original": "鸡蛋",
      "substitute": "豆腐",
      "ratio": "6 个:400 克",
      "note": "切厚片煎定型再焖，口感同样嫩。"
    }
  ],
  "variations": [
    "加半个青椒切丁同焖，清香解腻不抢味。",
    "用番茄酱替换部分番茄，颜色更红亮。"
  ],
  "serving_suggestion": "配印度烤饼或白饭，酱汁拌饭最下口。",
  "storage": "冷藏一天，复热加少量清水小火焖透。",
