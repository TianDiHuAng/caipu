  "equipment": [
    "炒锅",
    "锅铲",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花菜 500g 掰成小朵洗净沥干，土豆 400g 去皮切 3 厘米滚刀块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "花菜一定沥干，带水下锅会出水变软。",
      "visual_cue": "花菜朵匀称、土豆块棱角分明"
    },
    {
      "n": 2,
      "text": "炒锅倒 40ml 植物油烧热，下 4g 孜然小火炒 30 秒出香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "孜然一焦就苦，闻到香立即可下料。",
      "visual_cue": "孜然鼓起、油面泛泡"
    },
    {
      "n": 3,
      "text": "下洋葱丁 120g 中火炒 4 分钟至透明，加姜末与蒜末炒 1 分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒出甜味，咖喱底才厚。",
      "visual_cue": "洋葱透明、香气上冲"
    },
    {
      "n": 4,
      "text": "加 3g 姜黄粉与 3g 辣椒粉炒匀，倒入土豆块翻炒 3 分钟裹上香料。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料下锅后马上翻炒，容易糊底。",
      "visual_cue": "土豆通体金黄、香料裹匀"
    },
    {
      "n": 5,
      "text": "加 3g 盐与 100ml 清水，盖盖小火焖 8 分钟至土豆半熟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "水别多，靠蒸汽把土豆焖软。",
      "visual_cue": "汤汁将干、土豆边缘变软"
    },
    {
      "n": 6,
      "text": "放入花菜朵翻炒均匀，盖盖小火再焖 8 分钟至花菜断生。",
      "time_min": 9,
      "heat": "小火",
      "tip": "花菜后放，才不会焖成糊。",
      "visual_cue": "花菜微透、仍保持形状"
    },
    {
      "n": 7,
      "text": "开盖加 2g 盐调味，中火翻炒 2 分钟收干汤汁，撒香菜碎。",
      "time_min": 3,
      "heat": "中火",
      "tip": "收干水分，香料味才附着得住。",
      "visual_cue": "锅底无汤、蔬菜油润"
    }
  ],
  "tips": [
    "花菜后放，先焖土豆才熟得均匀。",
    "清水只加一点点，靠蒸汽把蔬菜焖软。",
    "香料下锅后必须不停翻炒，很容易糊底。"
  ],
  "common_mistakes": [
    "花菜和土豆一起下锅，花菜焖烂土豆还硬。",
    "水加太多，最后变成一锅蔬菜汤。",
    "香料炒过头，整盘菜发苦还发黑。"
  ],
  "substitutions": [
    {
      "original": "花菜",
      "substitute": "西兰花",
      "ratio": "500g 对 500g",
      "note": "焖制时间减 2 分钟，保持翠绿。"
    },
    {
      "original": "辣椒粉",
      "substitute": "黑胡椒",
      "ratio": "3g 对 2g",
      "note": "辣度更温润。"
    }
  ],
  "variations": [
    "加 100g 青豆同焖，颜色更丰富。",
    "起锅前加 5ml 柠檬汁，酸香提神。"
  ],
  "serving_suggestion": "配馕、印度香米饭或作为咖喱配菜。",
  "storage": "冷藏可存 3 天，复热时用平底锅小火回炒。",
