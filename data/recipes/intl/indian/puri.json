          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "油锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "300g 面粉加 4g 盐与 150ml 清水，揉成偏硬的面团，盖湿布饧 20 分钟。",
      "time_min": 25,
      "heat": "无火",
      "tip": "面团偏硬一点，炸时才容易鼓起来。",
      "visual_cue": "面团光滑、按压缓慢回弹"
    },
    {
      "n": 2,
      "text": "面团分成 12 个小剂子，逐个搓圆后按扁，盖上湿布防止风干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "剂子大小一致，受热才均匀。",
      "visual_cue": "剂子大小均匀、表面光滑"
    },
    {
      "n": 3,
      "text": "取一个剂子擀成直径约 10 厘米的圆片，厚薄控制在 2 毫米左右。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边缘比中间略薄，鼓包更漂亮。",
      "visual_cue": "圆片圆整、无破洞"
    },
    {
      "n": 4,
      "text": "锅中倒入 270ml 植物油烧至六成热，下圆片炸 20 秒，用漏勺轻压让饼鼓起。",
      "time_min": 5,
      "heat": "中火",
      "tip": "轻压饼面，饼才会鼓成球。",
      "visual_cue": "饼身鼓起、颜色转白"
    },
    {
      "n": 5,
      "text": "翻面再炸 20 秒至两面金黄，捞出放厨房纸上沥油，趁热食用。",
      "time_min": 6,
      "heat": "中火",
      "tip": "两面金黄立刻出锅，久炸会硬。",
      "visual_cue": "饼身金黄鼓胀、放凉后略软"
    }
  ],
  "tips": [
    "面团偏硬是鼓包的关键，太软炸不起来。",
    "油温六成热最合适，太低会吸油。",
    "炸时用漏勺轻压饼面，饼才鼓成球。"
  ],
  "common_mistakes": [
    "面团和得太软，饼下锅后塌成扁片。",
    "油温烧得过高，饼皮下锅后外皮焦黑里面还生。",
    "擀的时候边缘破洞，炸时漏气鼓不起来。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "全麦面粉",
      "ratio": "300g 对 300g",
      "note": "需多加 15ml 水，口感更粗犷。"
    }
  ],
  "variations": [
    "甜味版：面团中加 30g 白糖。",
    "芝麻版：饼胚表面撒一层白芝麻再擀压实。"
  ],
  "serving_suggestion": "趁热配土豆咖喱或酸奶一起食用。",
  "storage": "现炸现吃最佳，凉后可干锅复烙 1 分钟。",
