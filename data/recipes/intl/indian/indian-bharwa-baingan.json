  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "小勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小圆茄洗净擦干，从顶部划一个十字刀口，深到能塞馅但不切断底部。",
      "time_min": 9,
      "heat": "无火",
      "tip": "刀口要开得深，馅才塞得进、熟得匀。",
      "visual_cue": "茄子顶端张开四瓣，底部完整。"
    },
    {
      "n": 2,
      "text": "茄子放进淡盐水泡十分钟，捞出挤干水分，去掉部分涩味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡过盐水再煎，茄子少吃油也不易发黑。",
      "visual_cue": "茄身微软，切口不滴水。"
    },
    {
      "n": 3,
      "text": "花生炒香搓掉外皮，与芝麻、椰蓉一起碾成粗粒，留一点颗粒感。",
      "time_min": 8,
      "heat": "小火",
      "tip": "别碾成粉，粗粒的坚果馅咬起来才有层次。",
      "visual_cue": "混合物粗砂状，闻得到坚果香。"
    },
    {
      "n": 4,
      "text": "植物油炒香洋葱末与姜末，加孜然、姜黄、辣椒粉与盐炒匀，拌入花生芝麻碎成馅。",
      "time_min": 8,
      "heat": "中火",
      "tip": "先煎后焖，皮皱肉软才好吃，也更容易把馅香逼出来。",
      "visual_cue": "馅料松散油润，颜色金黄。"
    },
    {
      "n": 5,
      "text": "用小勺把馅料塞进茄子刀口，塞满压实，表面抹一层薄油。",
      "time_min": 7,
      "heat": "无火",
      "tip": "每一瓣都塞到，煎的时候才不会塌。",
      "visual_cue": "茄子鼓胀，馅料不外溢。"
    },
    {
      "n": 6,
      "text": "平底锅少油小火煎茄子到四面起皮，倒入清水盖锅焖十分钟至软。",
      "time_min": 8,
      "heat": "小火",
      "tip": "先煎后焖，皮皱肉软才好吃。",
      "visual_cue": "茄子表皮起皱，筷子能轻松插入。"
    },
    {
      "n": 7,
      "text": "开盖收汁，撒香菜碎装盘，把锅里剩的汁淋在茄子上。",
      "time_min": 5,
      "heat": "中火",
      "tip": "汁不用收太干，留一点挂在茄子上拌饭特别香。",
      "visual_cue": "盘底留薄汁，茄子油亮。"
    }
  ],
  "tips": [
    "选小圆茄最好，个头小、皮薄，一次一个正好入口。",
    "花生芝麻馅塞之前先尝一下咸淡，茄子本身不吃盐。",
    "煎的时候少翻动，皮破了馅料会漏出来。"
  ],
  "common_mistakes": [
    "茄子没泡盐水就煎，吸油像海绵、成品发腻。",
    "馅塞得太松，焖完一开盖全散在汤里。"
  ],
  "substitutions": [
    {
      "original": "花生",
      "substitute": "腰果",
      "ratio": "80g 对 80g",
      "note": "腰果更甜，辣椒粉可减一克。"
    }
  ],
  "variations": [
    "南印度的做法会把花生换成椰蓉加扁豆，馅料更清爽，配酸奶一起吃。"
  ],
  "serving_suggestion": "一个茄子配一碗白饭，把焖汁浇在饭上最香。",
  "storage": "冷藏两天，复热时加两勺清水小火焖热。",
