  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 250,
          "unit": "g",
          "note": "做酥皮",
          "optional": false
        },
        {
          "name": "土豆",
          "name_en": "potato",
          "amount": 400,
          "unit": "g",
          "note": "蒸熟压碎",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "豌豆",
          "name_en": "green pea",
          "amount": 100,
          "unit": "g",
          "note": "冷冻豌豆解冻",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 10,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "孜然",
          "name_en": "cumin",
          "amount": 5,
          "unit": "g",
          "note": "整粒略压碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "咖喱粉",
          "name_en": "curry powder",
          "amount": 12,
          "unit": "g",
          "note": "调味主体",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 250,
          "unit": "ml",
          "note": "和面与炸制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "面团与馅料",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "擀面杖",
    "深锅",
    "厨房温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "中筋面粉加 2g 盐与 40ml 植物油搓匀，分次加 100ml 清水揉成偏硬面团，盖布醒 25 分钟。",
      "time_min": 30,
      "heat": "无火",
      "tip": "面团偏硬，炸后才酥脆不回软。",
      "visual_cue": "面团光滑、按压回弹"
    },
    {
      "n": 2,
      "text": "土豆蒸 15 分钟至能轻松压碎，趁热压成粗泥，豌豆解冻沥干。",
      "time_min": 18,
      "heat": "无火",
      "tip": "土豆压粗泥即可，太细会散。",
      "visual_cue": "土豆泥无大块、微有颗粒"
    },
    {
      "n": 3,
      "text": "炒锅倒 15ml 植物油，小火炒香孜然与姜末，加咖喱粉炒 20 秒出香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香料小火炒，糊了整锅发苦。",
      "visual_cue": "香料出油、香味散出"
    },
    {
      "n": 4,
      "text": "下土豆泥与豌豆翻炒，加剩余盐拌匀成馅，盛出放凉。",
      "time_min": 5,
      "heat": "中火",
      "tip": "馅料必须放凉再包，否则皮会破。",
      "visual_cue": "馅料抱团、颜色金黄"
    },
    {
      "n": 5,
      "text": "面团分成 8 份，擀成椭圆薄片，对半切开后卷成锥形，装入馅料捏紧封口。",
      "time_min": 12,
      "heat": "无火",
      "tip": "封口抹一点水，炸时才不裂开。",
      "visual_cue": "三角饱满、封口贴合"
    },
    {
      "n": 6,
      "text": "深锅倒 250ml 植物油烧至 160℃，下咖喱角小火慢炸 6 分钟至外壳金黄起泡。",
      "time_min": 8,
      "heat": "小火",
      "tip": "低温慢炸，皮才起酥不硬。",
      "visual_cue": "外壳金黄、表面小气泡"
    }
  ],
  "tips": [
    "面团要揉得偏硬，炸制时才不易吸油。",
    "馅料必须彻底放凉再包，面皮才不破。",
    "160℃ 低温慢炸，酥皮才起层不回软。"
  ],
  "common_mistakes": [
    "面团和水太软，炸后外皮发韧完全不酥。",
    "馅料带热就包，蒸汽把皮顶破漏馅。",
    "油温过高下锅，外壳焦了里面还是凉的。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "400g 对 400g",
      "note": "甜味更足，盐可少 1g。"
    },
    {
      "original": "豌豆",
      "substitute": "玉米粒",
      "ratio": "100g 对 100g",
      "note": "口感更甜，炒制时间减 1 分钟。"
    }
  ],
  "variations": [
    "加肉版：加 150g 炒香的牛肉末同包。",
    "菠菜皮版：面团中加 50g 菠菜泥，颜色更绿。"
  ],
  "serving_suggestion": "趁热配薄荷酸奶酱或酸辣酱食用。",
  "storage": "冷藏 2 天，复热用 180℃ 烤箱烤 8 分钟回脆。",
