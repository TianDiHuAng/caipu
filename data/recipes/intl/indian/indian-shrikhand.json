  "id": "indian-shrikhand",
  "name": {
    "zh": "印度藏红花酸奶甜点",
    "en": "Shrikhand",
    "original": "श्रीखंड"
  },
  "cuisine": {
    "region": "intl",
    "style": "indian"
  },
  "category": [
    "dessert"
  ],
  "difficulty": 1,
  "time": {
    "prep_min": 30,
    "cook_min": 5,
    "total_min": 35
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "fragrant",
    "tangy"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 600,
          "unit": "g",
          "note": "选浓稠原味酸奶",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 70,
          "unit": "g",
          "note": "糖粉更易融合",
          "optional": false
        },
        {
          "name": "小豆蔻",
          "name_en": "cardamom",
          "amount": 2,
          "unit": "g",
          "note": "去壳磨粉",
          "optional": false
        },
        {
          "name": "藏红花",
          "name_en": "saffron",
          "amount": 0.5,
          "unit": "g",
          "note": "用温牛奶泡开",
          "optional": false
        },
        {
          "name": "杏仁",
          "name_en": "almond",
          "amount": 20,
          "unit": "g",
          "note": "切薄片烘香",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 30,
          "unit": "ml",
          "note": "泡藏红花用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "细纱布",
    "滤网",
    "碗",
    "打蛋器",
    "小勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酸奶倒进铺了细纱布的滤网，扎紧袋口架在碗上，冷藏沥水六小时以上。",
      "time_min": 10,
      "heat": "无火",
      "tip": "沥到酸奶稠得能立在勺上，成品才不会稀塌。",
      "visual_cue": "纱布里的酸奶缩成紧实一团，碗底积出乳清"
    },
    {
      "n": 2,
      "text": "藏红花放进温热牛奶里泡十分钟，泡到奶液染成明亮的橙黄色。",
      "time_min": 10,
      "heat": "无火",
      "tip": "牛奶温度别超过六十度，太烫会让藏红花的香气跑光。",
      "visual_cue": "牛奶呈金黄色，花瓣舒展开来"
    },
    {
      "n": 3,
      "text": "把沥好的酸奶放进碗里，加白糖用打蛋器搅到顺滑没有颗粒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糖要分两次加，先少后多更易搅匀不起疙瘩。",
      "visual_cue": "酸奶质地细腻发亮，挑起能缓慢滴落"
    },
    {
      "n": 4,
      "text": "拌入小豆蔻粉和泡好的藏红花牛奶，搅到颜色均匀分布。",
      "time_min": 3,
      "heat": "无火",
      "tip": "小豆蔻现磨最香，提前磨好放置香气会明显变淡。",
      "visual_cue": "甜点呈均匀的淡鹅黄色，可见金红花丝"
    },
    {
      "n": 5,
      "text": "装杯冷藏一小时，吃前撒上烘香的杏仁片增脆。",
      "time_min": 2,
      "heat": "无火",
      "tip": "杏仁片用干锅小火烘到边缘微黄，香气才足。",
      "visual_cue": "表面堆着浅褐色杏仁薄片"
    }
  ],
  "tips": [
    "酸奶一定要充分沥水，水分析出是这道甜点最常见的失败点。",
    "藏红花用温牛奶而不用热水泡，奶脂能更好锁住香气。",
    "糖量可按酸奶酸度增减，甜中带一点酸才好吃。"
  ],
  "common_mistakes": [
    "酸奶没沥干就直接加糖，成品稀得挂不住勺。",
    "用滚烫牛奶泡藏红花，香气挥发且颜色发暗。",
    "小豆蔻下手过重，甜点带出药味盖住奶香。"
  ],
  "substitutions": [
    {
      "original": "藏红花",
      "substitute": "姜黄粉",
      "ratio": "0.5 克:1 克",
      "note": "颜色接近但香气偏土，适合临时替代。"
    },
    {
      "original": "杏仁",
      "substitute": "开心果",
      "ratio": "1:1",
      "note": "切碎撒面，风味更接近印度西部做法。"
    }
  ],
  "variations": [
    "拌入芒果泥可做成芒果酸奶甜点，夏季版本更清爽。"
  ],
  "serving_suggestion": "冷藏后盛小碗，配炸面球或薄饼同食。",
  "storage": "冷藏两天内吃完，不要冷冻，解冻后会出水分离。",
