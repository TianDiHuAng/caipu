    "锅铲",
    "碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进碗里加一小撮盐，用筷子彻底打散到均匀起泡。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液打到看不见明显蛋黄丝，炒出来才嫩。",
      "visual_cue": "蛋液均匀，表面起细泡"
    },
    {
      "n": 2,
      "text": "番茄切成小丁，洋葱切成碎末，小米辣切圈，姜切末。",
      "time_min": 7,
      "heat": "无火",
      "tip": "洋葱切得越碎越容易炒化，甜味出得更快。",
      "visual_cue": "配料细碎，番茄出水"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到微热，下洋葱末中火炒到边缘透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒到透明再加别的料，生洋葱味会抢味。",
      "visual_cue": "洋葱透明，油面泛香"
    },
    {
      "n": 4,
      "text": "加姜末、小米辣圈和姜黄粉，翻炒半分钟炒出香气。",
      "time_min": 3,
      "heat": "中火",
      "tip": "姜黄粉遇油易焦，火别大，炒半分钟就够。",
      "visual_cue": "油色橙黄，香气辛辣"
    },
    {
      "n": 5,
      "text": "下番茄丁炒到软烂出汁，加剩余的盐翻匀调底味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒到成糊状，蛋液下锅才不容易出水。",
      "visual_cue": "番茄软塌成糊，汤汁收浓"
    },
    {
      "n": 6,
      "text": "倒入蛋液转小火，用锅铲不断推炒到蛋液刚凝固成块。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢推，蛋块才嫩滑不焦；炒到全干就老了。",
      "visual_cue": "蛋块嫩黄松散，不成大团"
    },
    {
      "n": 7,
      "text": "关火撒入香菜碎，用余温翻拌两下即可装盘上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜关火后再放，清香才不被热气冲散掉。",
      "visual_cue": "香菜翠绿，蛋块油润"
    }
  ],
  "tips": [
    "蛋液打到起泡，炒出来才够蓬松柔软。",
    "番茄先炒成糊状，蛋液下锅就不会出水。",
    "全程小火慢慢推炒，蛋块才嫩滑不老。",
    "香菜关火以后再撒，清香保留得更好。"
  ],
  "common_mistakes": [
    "大火猛炒蛋液，蛋块又干又硬像橡皮。",
    "番茄没炒软就下蛋液，成品出水成汤。",
    "姜黄粉下锅后久炒，整锅发苦发黑。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "北豆腐",
      "ratio": "300 克:350 克",
      "note": "豆腐捏碎后同炒，素版更清爽。"
    },
    {
      "original": "小米辣",
      "substitute": "辣椒粉",
      "ratio": "8 克:3 克",
      "note": "辣度接近，香气更干爽。"
    }
  ],
  "variations": [
    "加一把青豌豆同炒，颜色和口感更丰富。",
    "撒少许孜然粉，香气更接近街头风味。"
  ],
  "serving_suggestion": "趁热配印度烤饼或白米饭，蛋香和辣香都够下饭。",
  "storage": "冷藏一天，复热小火翻拌，勿微波久打。",
