  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "胡萝卜削皮后切成一厘米见方的小丁，豌豆冲洗两遍沥干，洋葱与番茄分别切碎。",
      "time_min": 8,
      "heat": "无火",
      "tip": "胡萝卜丁切得大小一致，受热才均匀不夹生。",
      "visual_cue": "胡萝卜丁大小均匀，豌豆颗颗分明"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧到微热，放孜然炒出香味，接着下洋葱碎炒到边缘透明发软。",
      "time_min": 5,
      "heat": "中火",
      "tip": "孜然下锅几秒钟就出香味，别等它颜色变深再下别的料。",
      "visual_cue": "孜然在油里冒泡，香味明显"
    },
    {
      "n": 3,
      "text": "加姜末与番茄块压碎同炒，撒姜黄粉与辣椒粉，炒到番茄出汁、锅底泛红。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出汁再下胡萝卜，蔬菜才不干锅。",
      "visual_cue": "番茄软烂出汁，油色转橙红"
    },
    {
      "n": 4,
      "text": "倒入胡萝卜丁翻匀，加清水与盐，盖上锅盖小火焖八分钟让胡萝卜变软。",
      "time_min": 8,
      "heat": "小火",
      "tip": "焖的时候水别多，胡萝卜本身会出水。",
      "visual_cue": "胡萝卜丁变软，能用锅铲压扁"
    },
    {
      "n": 5,
      "text": "开盖放入豌豆继续翻炒四分钟，收掉多余汁水，尝一下咸淡再补盐。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豌豆后放才保得住翠绿和清甜，久煮会发黄。",
      "visual_cue": "豌豆翠绿饱满，锅底只剩薄汁"
    },
    {
      "n": 6,
      "text": "关火撒香菜碎拌匀，盛进浅盘趁热吃，配薄饼或米饭都合适。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香菜关火后拌，颜色与香气都不损失。",
      "visual_cue": "盘里红黄绿相间，光泽油亮"
    }
  ],
  "tips": [
    "胡萝卜本身带甜味，糖可以完全不放，靠洋葱与番茄的甜就够。",
    "想保留口感可以把焖的时间缩到五分钟，胡萝卜带一点脆更清爽。",
    "豌豆用新鲜的比冷冻的甜，解冻的豌豆下锅前要沥干水。",
    "这道菜凉了也好吃，可以一次多做一些冷藏，第二天当冷盘配饭。"
  ],
  "common_mistakes": [
    "胡萝卜丁切得太大又不加水焖，外软内生，嚼起来发硬。",
    "豌豆与胡萝卜一起下锅久煮，豌豆变黄发绵，清甜全失。",
    "孜然炒过头变黑，蔬菜表面沾满黑点，带一股焦苦味。"
  ],
  "substitutions": [
    {
      "original": "豌豆",
      "substitute": "毛豆",
      "ratio": "150克:150克",
      "note": "先煮三分钟断生再下锅炒，口感更嫩。"
    },
    {
      "original": "胡萝卜",
      "substitute": "土豆",
      "ratio": "250克:250克",
      "note": "切丁后焖制时间加到十分钟才软透。"
    }
  ],
  "variations": [
    "加两勺椰蓉同炒，蔬菜的甜味会被放大，口感也更润。",
    "撒一小把烤香的腰果碎，脆感明显，适合当宴客配菜。"
  ],
  "serving_suggestion": "装在白色浅盘里，红黄绿三色分明，配热薄饼、白饭或酸奶都可以。",
  "storage": "冷藏可放两天，复热时用炒锅中火翻炒两分钟，别加水否则会变软塌。",
