    "汤锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面条放进加了盐的滚水里煮到八分熟，捞出过一遍凉水再沥干，拌少许油备用。",
      "time_min": 8,
      "heat": "中大火",
      "tip": "过凉水能洗掉面条表面的黏性物质，炒的时候不粘成一坨。",
      "visual_cue": "面条根根分明，挑起不粘连"
    },
    {
      "n": 2,
      "text": "卷心菜、胡萝卜与洋葱分别切成粗细一致的丝，青辣椒斜切成薄片。",
      "time_min": 7,
      "heat": "无火",
      "tip": "丝切得越均匀，下锅受热越一致，脆度也好。",
      "visual_cue": "切丝粗细一致，堆叠不塌软"
    },
    {
      "n": 3,
      "text": "炒锅烧到微微冒烟，放一半植物油，蒜粒小火炒到边缘金黄、香气散出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜粒别切太碎，碎末下锅一炒就焦苦。",
      "visual_cue": "蒜粒边缘金黄，油面浮出蒜香"
    },
    {
      "n": 4,
      "text": "转大火下洋葱丝与青辣椒片快炒，炒到洋葱边缘微微透明仍带脆。",
      "time_min": 3,
      "heat": "大火",
      "tip": "全程大火快炒，蔬菜下锅后不停翻动，才脆不出水也不发黄。",
      "visual_cue": "洋葱边缘透明，辣椒颜色变亮"
    },
    {
      "n": 5,
      "text": "加入卷心菜丝与胡萝卜丝，翻炒到略软但仍挺，撒盐与黑胡椒调味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蔬菜只炒到刚断生，久炒会软塌出水，面条也跟着发湿。",
      "visual_cue": "菜丝体积略缩，锅底无积水"
    },
    {
      "n": 6,
      "text": "放面条，沿锅边淋生抽与辣椒油，用夹子快速翻拌让每根面都染色。",
      "time_min": 3,
      "heat": "大火",
      "tip": "酱油沿锅边淋才能激出香，直接浇面会把面泡软。",
      "visual_cue": "面条均匀上色，锅气明显"
    },
    {
      "n": 7,
      "text": "补剩下的植物油，撒小葱段，再翻两下立刻出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "最后一勺油能让面亮起来，也让香气更冲。",
      "visual_cue": "面条油亮干爽，无汤汁"
    }
  ],
  "tips": [
    "面条选细一点的更容易裹味，粗面要延长煮制一分钟。",
    "蒜是这道面的主角，量别减，喜辣可再加两根青辣椒。",
    "家里火不够旺时把面分两次下锅，锅温才降不下来。",
    "想更饱可加一个煎蛋或一把豆腐块同炒。"
  ],
  "common_mistakes": [
    "蒜粒切得太碎又用大火，下锅几秒就焦黑发苦。",
    "面条没过凉水直接下锅，粘成一团怎么翻都散不开。",
    "蔬菜炒太久出水，最后变成一锅煮面而不是炒面。"
  ],
  "substitutions": [
    {
      "original": "辣椒油",
      "substitute": "辣椒粉",
      "ratio": "15毫升:5克",
      "note": "用热油泼香后再拌面，辣味更直接。"
    },
    {
      "original": "卷心菜",
      "substitute": "豆芽",
      "ratio": "150克:150克",
      "note": "豆芽更脆，下锅时间缩短半分钟。"
    }
  ],
  "variations": [
    "加一勺番茄酱与半勺白糖，做成印式中餐常见的甜辣口。",
    "把面条换成米粉，做成炒米粉版本，口感更弹。"
  ],
  "serving_suggestion": "用宽盘盛装，配一小碟醋泡洋葱与一杯加冰的柠檬苏打水。",
  "storage": "冷藏一天内吃完，复热用炒锅大火快炒一分钟，微波会让面条发韧。",
