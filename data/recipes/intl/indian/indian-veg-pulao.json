    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米用清水淘洗三遍，泡二十分钟后捞出沥干水分。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过的米吸足水，煮出来粒粒分明不粘连。",
      "visual_cue": "米粒洁白，沥干不滴水"
    },
    {
      "n": 2,
      "text": "胡萝卜切成小丁，洋葱切成细丝，豌豆冲洗干净备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "胡萝卜丁切小些，和米同熟不会夹生。",
      "visual_cue": "配料切丁均匀，豌豆饱满"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下洋葱丝中火炒到金黄焦香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到焦黄，甜味和香气才完全释放出来。",
      "visual_cue": "洋葱金褐，油色发亮"
    },
    {
      "n": 4,
      "text": "加孜然和桂皮炒出香味，再下胡萝卜丁和豌豆翻炒。",
      "time_min": 4,
      "heat": "中火",
      "tip": "孜然遇热油香味才出，炒糊了就发苦。",
      "visual_cue": "孜然爆香，蔬菜断生"
    },
    {
      "n": 5,
      "text": "倒入大米翻炒两分钟，让每粒米都裹上一层油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米先炒过再煮，颗粒分明还不容易糊底。",
      "visual_cue": "米粒油亮，微微透明"
    },
    {
      "n": 6,
      "text": "加盐炒匀后倒入清水，大火烧开再转小火盖盖焖煮。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水量比平时煮饭略少，蔬菜本身会出水。",
      "visual_cue": "水沸冒泡，米粒上浮"
    },
    {
      "n": 7,
      "text": "转小火焖二十分钟，关火再虚焖十分钟后开盖拌匀。",
      "time_min": 20,
      "heat": "小火",
      "tip": "关火虚焖十分钟，米芯才彻底熟透不夹生。",
      "visual_cue": "米饭松散，香气扑鼻"
    }
  ],
  "tips": [
    "大米先泡二十分钟，煮出来粒粒分明。",
    "洋葱炒到焦黄，饭的香气才够层次。",
    "关火后虚焖十分钟，米芯不会夹生。"
  ],
  "common_mistakes": [
    "大米不泡就直接煮，米芯硬得咬不动。",
    "水放太多，最后煮成一锅黏糊的稠饭。",
    "孜然火大炒糊了，整锅饭都带上苦味。"
  ],
  "substitutions": [
    {
      "original": "豌豆",
      "substitute": "毛豆仁",
      "ratio": "100 克:100 克",
      "note": "口感更厚实，焖制时间不变。"
    },
    {
      "original": "胡萝卜",
      "substitute": "南瓜",
      "ratio": "100 克:120 克",
      "note": "更甜软，水量减二十毫升。"
    }
  ],
  "variations": [
    "加一把腰果同炒，坚果香气更浓郁。",
    "放几颗葡萄干同煮，甜咸交错更地道。"
  ],
  "serving_suggestion": "趁热配一杯酸奶或一份酸奶黄瓜沙拉，清爽解腻。",
  "storage": "冷藏两天，复热时加少许清水蒸透。",
