  "steps": [
    {
      "n": 1,
      "text": "粉丝用温水泡到变软，捞出剪成十厘米长的段。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡到能弯折就停，泡太久炒时容易断。",
      "visual_cue": "粉丝柔软可弯，长度整齐"
    },
    {
      "n": 2,
      "text": "洋葱切丝，胡萝卜切小丁，青豆冲洗干净沥水备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "胡萝卜丁切得和青豆差不多大，熟得才匀。",
      "visual_cue": "配料大小均匀分开放"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下孜然小火爆香后加洋葱丝炒软。",
      "time_min": 4,
      "heat": "小火",
      "tip": "孜然先下锅，油香出来再放洋葱。",
      "visual_cue": "孜然响，洋葱丝变软透明"
    },
    {
      "n": 4,
      "text": "下胡萝卜丁和青豆翻炒三分钟，加咖喱粉炒匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "咖喱粉和油一起炒，香气才足不呛。",
      "visual_cue": "蔬菜断生，油色发黄"
    },
    {
      "n": 5,
      "text": "加清水和盐烧开，放入粉丝翻拌到吸干汤汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "粉丝下锅要不停翻，否则粘成一坨。",
      "visual_cue": "粉丝吸干汁，根根分明"
    },
    {
      "n": 6,
      "text": "关火挤入柠檬汁，撒上香菜碎拌匀后装盘出锅。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬汁最后挤，香气才清爽不苦。",
      "visual_cue": "酸香清亮，粉丝松散"
    }
  ],
  "tips": [
    "粉丝泡软就够，泡过头一炒就断成碎段。",
    "孜然先用小火爆香，油里带香再下菜。",
    "最后挤柠檬汁提味，整盘立刻清爽起来。"
  ],
  "common_mistakes": [
    "粉丝泡到发糊再炒，翻两下全断成渣。",
    "清水一次倒太多，粉丝煮成软糊粘锅。",
    "孜然大火爆到发黑，整锅串上焦苦味。"
  ],
  "substitutions": [
    {
      "original": "粉丝",
      "substitute": "米粉",
      "ratio": "200 克:200 克",
      "note": "口感更弹，泡发时间缩短三分钟。"
    },
    {
      "original": "青豆",
      "substitute": "玉米",
      "ratio": "80 克:80 克",
      "note": "甜味更明显，盐可减一克。"
    }
  ],
  "variations": [
    "加一把熟花生碎，口感更香脆有层次。",
    "放几片咖喱叶同炒，香气更地道。"
  ],
  "serving_suggestion": "趁热吃最松散，配一杯酸奶或印度奶茶正好。",
  "storage": "冷藏一天，复热加少许清水翻炒回软。",
