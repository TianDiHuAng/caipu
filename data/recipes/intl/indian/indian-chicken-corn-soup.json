        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "打蛋器",
    "汤勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡汤倒进汤锅烧开，撇去表面浮沫让汤色清亮。",
      "time_min": 6,
      "heat": "中火",
      "tip": "浮沫要撇干净，成品汤色才清亮没有杂味。",
      "visual_cue": "汤面清亮，边缘冒均匀小泡"
    },
    {
      "n": 2,
      "text": "放入玉米粒煮六分钟，煮到玉米粒鼓胀发亮变软。",
      "time_min": 6,
      "heat": "中火",
      "tip": "甜玉米粒多煮一会汤更甜，但别煮到破皮。",
      "visual_cue": "玉米粒饱满发亮，汤色转浅黄"
    },
    {
      "n": 3,
      "text": "玉米淀粉加两勺冷水调开，慢慢倒进汤里边倒边搅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "水淀粉一定要调匀，直接下锅会结块。",
      "visual_cue": "汤汁明显变稠，能挂住汤勺"
    },
    {
      "n": 4,
      "text": "放入鸡胸肉丝与盐、黑胡椒，小火煮三分钟让味道融合。",
      "time_min": 3,
      "heat": "小火",
      "tip": "熟鸡胸肉最后放，煮久了纤维会柴得像发丝。",
      "visual_cue": "鸡肉丝散开浮在汤里，汤体浓稠顺滑"
    },
    {
      "n": 5,
      "text": "关小火把打散的蛋液绕圈淋进汤里，静置五秒再推散。",
      "time_min": 2,
      "heat": "小火",
      "tip": "淋完别马上搅，等蛋液定型才能成蛋花。",
      "visual_cue": "蛋花细长成丝，浮在汤面不散碎"
    },
    {
      "n": 6,
      "text": "撒上香菜碎即可关火出锅，趁热盛进碗里端上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香菜最后放，久煮会发黄失香只剩青草味。",
      "visual_cue": "汤面点缀翠绿，香气清新"
    }
  ],
  "tips": [
    "印度中餐馆的经典汤品，配一小碟辣椒醋更地道。",
    "玉米粒一半打成泥，汤体更浓更有玉米味。",
    "加几滴芝麻油与白胡椒粉，香气立刻不同。",
    "汤稠度按喜好调整，水淀粉可分两次加。"
  ],
  "common_mistakes": [
    "水淀粉一次倒完又猛搅，汤里结出一团团芡块。",
    "蛋液在滚汤里下锅还用力搅，蛋花碎成蛋渣。",
    "鸡胸肉一开始就下锅久煮，口感变得又干又柴。"
  ],
  "substitutions": [
    {
      "original": "鸡肉",
      "substitute": "豆腐",
      "ratio": "150克:200克",
      "note": "素食版，汤体稍淡需补盐。"
    },
    {
      "original": "鸡汤",
      "substitute": "清水加蔬菜",
      "ratio": "800毫升:800毫升",
      "note": "味道更薄，需加一勺香菇粉提鲜。"
    }
  ],
  "variations": [
    "加一勺奶油玉米酱，做成更浓稠的奶香版本。",
    "放入几片蘑菇同煮，鲜味层次会更足一些。"
  ],
  "serving_suggestion": "作为套餐里的汤品，配炒饭或面条都很合适。",
  "storage": "冷藏两天，复热时加少量清水稀释，小火加热到微沸。",
