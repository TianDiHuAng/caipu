  "equipment": [
    "炒锅",
    "木勺",
    "小碗",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "椰蓉放进小碗，加温水揉搓两分钟，用滤网滤出乳白色的汁水，渣留作他用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水温不烫手就好，太热会让椰香发闷。",
      "visual_cue": "滤出的汁水呈乳白色，略带稠感"
    },
    {
      "n": 2,
      "text": "炒锅烧热倒植物油，放芥末籽小火加热，等籽粒跳动爆开后下咖喱叶与腰果。",
      "time_min": 4,
      "heat": "小火",
      "tip": "芥末籽一跳起来就马上下料，爆过头颜色发黑会带苦味。",
      "visual_cue": "籽粒在油里跳动爆开，香气扑出"
    },
    {
      "n": 3,
      "text": "放入洋葱丝与青椒丝中火翻炒，炒到洋葱边缘透明、青椒丝略微变软。",
      "time_min": 5,
      "heat": "中火",
      "tip": "青椒别炒太久，留一点脆感口感更好。",
      "visual_cue": "洋葱透明，青椒丝颜色转深"
    },
    {
      "n": 4,
      "text": "撒入姜黄粉与盐翻匀，倒入乳白色的椰蓉汁水煮开，让香料味融进汁里。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汁水煮开再下饭，米饭才不会吸太多水发黏。",
      "visual_cue": "汁水微沸，表面浮起黄色油点"
    },
    {
      "n": 5,
      "text": "放入米饭转小火，用木勺从锅底翻拌，让每粒米都裹上椰汁，拌到水汽收干。",
      "time_min": 6,
      "heat": "小火",
      "tip": "翻拌要轻，压碎米粒会让整锅饭发黏。",
      "visual_cue": "米粒松散分明，泛淡淡金黄"
    }
  ],
  "tips": [
    "米饭最好用隔夜冷饭，水分少，拌炒后粒粒分明不粘块。",
    "椰蓉汁水要现揉现用，放久了会分层，香气也淡。",
    "芥末籽与咖喱叶是南印风味的骨架，两样都别省。",
    "想更香可以在关火前淋几滴植物油，饭粒表面会亮起来，香气也更足。"
  ],
  "common_mistakes": [
    "热米饭直接下锅拌炒，米粒被压成一团，口感发黏。",
    "芥末籽在热油里久炸，颜色变黑，整锅饭带上苦味。",
    "椰蓉汁水倒得太多，米饭泡成粥状，失去松散的口感。"
  ],
  "substitutions": [
    {
      "original": "椰蓉",
      "substitute": "椰丝",
      "ratio": "50克:50克",
      "note": "颗粒更粗，揉汁时多加二十毫升清水。"
    },
    {
      "original": "腰果",
      "substitute": "花生",
      "ratio": "25克:25克",
      "note": "去皮后掰瓣，香气更浓，炒制时间略短。"
    }
  ],
  "variations": [
    "加一勺煮熟的豌豆同拌，颜色更绿，饭的口感也更丰富。",
    "起锅前撒一把炸香的小葱碎，香气更冲，适合配咖喱吃。"
  ],
  "serving_suggestion": "盛进小碗压一下再倒扣在盘上，配咖喱或烤鸡一起吃，米饭负责吸走酱汁。",
  "storage": "冷藏可存一天，复热时隔水蒸八分钟，别用微波炉久转否则米粒会变硬。",
