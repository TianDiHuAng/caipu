          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "盆",
    "干净棉布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "两种面粉混合过筛，加盐拌匀，中间挖出凹坑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "全麦面粉占比一成，多了饼易裂。",
      "visual_cue": "粉堆中间凹下一圈。"
    },
    {
      "n": 2,
      "text": "牛奶与清水混合后慢慢倒入，边倒边搅成絮状。",
      "time_min": 10,
      "heat": "无火",
      "tip": "液体分三次加，面团才揉得匀。",
      "visual_cue": "粉絮大小均匀粗细一致。"
    },
    {
      "n": 3,
      "text": "揉成光滑软面团，表面抹一层植物油，盖湿布松弛四十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "松弛到位，擀的时候才不回缩。",
      "visual_cue": "面团按下去柔软有弹性。"
    },
    {
      "n": 4,
      "text": "把面团分成八份，擀成直径二十厘米的薄圆片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "越薄越好，薄到能看见案板纹路。",
      "visual_cue": "饼坯透光，边缘不裂。"
    },
    {
      "n": 5,
      "text": "平底锅烧到微热，饼坯下锅烙四十秒，表面变干即翻面。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "火不能大，饼薄容易焦。",
      "visual_cue": "饼面出现浅色干斑。"
    },
    {
      "n": 6,
      "text": "另一面烙三十秒后立刻出锅，趁热对折两次成扇形。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "出锅就要折，凉了折会断。",
      "visual_cue": "饼折成四层的三角扇形。"
    },
    {
      "n": 7,
      "text": "叠放时用干净布盖住保温，全部烙完一起上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盖布能让饼保持柔软不干裂。",
      "visual_cue": "饼柔软可折叠，边缘不脆。"
    }
  ],
  "tips": [
    "Rumali 意为手帕，饼要薄到能当手帕叠起来。",
    "牛奶与清水各半，饼既有奶香又不失筋道。",
    "这道饼靠手感，锅越薄越容易控制火候。"
  ],
  "common_mistakes": [
    "饼擀得太厚，出锅后硬得折不动。",
    "火太大，饼下锅十秒就焦黑，里面还是生的。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "150ml 对 150ml",
      "note": "全用水和面更素净，奶香会淡一层。"
    }
  ],
  "variations": [
    "婚宴上会把饼叠成塔状上桌，吃的时候一层层揭开，配烤肉最合适。"
  ],
  "serving_suggestion": "配坦都里烤肉或咖喱，把饼摊开包着肉吃。",
  "storage": "现做现吃，冷藏后饼会变硬，只能改作煎饼底。",
  "nutrition_estimate": {
    "basis": "每份约 155g",
    "calories_kcal": 380,
    "protein_g": 12,
