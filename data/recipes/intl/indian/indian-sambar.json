  "equipment": [
    "汤锅",
    "炒锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "木豆洗净泡两小时，连水一起下锅煮。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡豆的水别倒，煮出来更香。，注意火候。",
      "visual_cue": "豆身饱满，水略浑，状态稳定"
    },
    {
      "n": 2,
      "text": "大火烧开撇去浮沫，转小火煮三十分钟到软烂。",
      "time_min": 32,
      "heat": "小火",
      "tip": "煮到用勺一压就散，汤才浓。，注意火候。",
      "visual_cue": "豆子软烂，汤汁稠厚，状态稳定"
    },
    {
      "n": 3,
      "text": "罗望子放半碗温水里抓捏，滤出酸汁备用。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "抓出胶质，酸味才柔和。，注意火候。",
      "visual_cue": "汁水棕褐，味酸，状态稳定"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，下芥末籽小火等它爆开。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "籽一跳就下料，别等它变黑。，注意火候。",
      "visual_cue": "籽粒跳动，香气散出，状态稳定"
    },
    {
      "n": 5,
      "text": "放洋葱、咖喱叶和姜黄粉炒到洋葱变软。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "咖喱叶揉一下再下锅，香气更足。，注意火候。",
      "visual_cue": "洋葱透明，油色发黄，状态稳定"
    },
    {
      "n": 6,
      "text": "加番茄块、土豆和胡萝卜炒三分钟。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蔬菜先炒过，煮出来更有味。，注意火候。",
      "visual_cue": "蔬菜裹油，番茄出汁，状态稳定"
    },
    {
      "n": 7,
      "text": "把炒好的蔬菜倒进豆汤，加香菜籽粉和辣椒粉。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料入汤后要煮开才出味。，注意火候。",
      "visual_cue": "汤色橙黄，香气浓，状态稳定"
    },
    {
      "n": 8,
      "text": "倒罗望子汁和盐，小火再煮十分钟。这一步不要着急。",
      "time_min": 11,
      "heat": "小火",
      "tip": "酸汁后加，久煮会失酸。，注意火候。",
      "visual_cue": "汤汁浓稠，酸香明显，状态稳定"
    },
    {
      "n": 9,
      "text": "撒香菜碎，配米饭或蒸米糕一起吃。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酸辣要平衡，觉得尖就补一点糖。，注意火候。",
      "visual_cue": "表面翠绿，汤色油亮，状态稳定"
    }
  ],
  "tips": [
    "木豆煮到一压就散，汤才够浓。，值得留意。",
    "芥末籽小火爆开，别炒黑发苦。，值得留意。",
    "罗望子汁最后加，酸味才清。，值得留意。"
  ],
  "common_mistakes": [
    "豆没煮烂就打汤，口感粗糙。，值得留意。",
    "芥末籽炒焦，整锅发苦。，值得留意。",
    "罗望子放太多，酸得发涩。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "木豆",
      "substitute": "红腰豆",
      "ratio": "180 克:180 克",
      "note": "口感更粉，需多煮十分钟。"
    },
    {
      "original": "罗望子",
      "substitute": "柠檬汁",
      "ratio": "25 克:30 毫升",
      "note": "酸味更直接，出锅前再加。"
    }
  ],
  "variations": [
    "加一把青豆，颜色更鲜。，值得留意。",
    "放两片咖喱叶增香，风味更南印。，值得留意。"
  ],
  "serving_suggestion": "浇在热米饭上，配一份椰香酸辣酱和一碟脆饼就是标准南印套餐。",
  "storage": "冷藏三天，复热时加少量水小火煮开。，效果更稳定。",
