    "漏勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶倒进厚底锅烧开，中途不停搅防糊底。这一步不要着急。",
      "time_min": 8,
      "heat": "中火",
      "tip": "锅底厚一点，牛奶才不焦。，注意火候。",
      "visual_cue": "表面结皮，奶液翻涌，状态稳定"
    },
    {
      "n": 2,
      "text": "关火稍晾两分钟，慢慢倒柠檬汁搅到分层。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一边倒一边搅，乳清分离才干净。，注意火候。",
      "visual_cue": "奶块结团，乳清发黄，状态稳定"
    },
    {
      "n": 3,
      "text": "滤网铺纱布，倒进奶块，用清水冲掉酸味。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冲一遍去酸，成品才不涩。，注意火候。",
      "visual_cue": "奶块成团，水变清，状态稳定"
    },
    {
      "n": 4,
      "text": "挤干水分，把奶块揉到顺滑无颗粒。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "揉到能捏成球，否则口感发粗。，注意火候。",
      "visual_cue": "质地细腻，能成团，状态稳定"
    },
    {
      "n": 5,
      "text": "分成十二份，搓圆压扁成小饼。这一步不要着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "压薄一点，泡糖水才吸得透。，注意火候。",
      "visual_cue": "饼形圆整，厚薄一致，状态稳定"
    },
    {
      "n": 6,
      "text": "白糖加八百毫升水煮开，下奶饼小火煮十分钟。",
      "time_min": 13,
      "heat": "小火",
      "tip": "糖水微沸就好，滚了奶饼会散。，注意火候。",
      "visual_cue": "奶饼膨大，糖水变稠，状态稳定"
    },
    {
      "n": 7,
      "text": "捞出奶饼放进淡奶油、藏红花和小豆蔻拌的奶浆里。",
      "time_min": 4,
      "heat": "无火",
      "tip": "奶浆要凉的，热奶饼会缩。，注意火候。",
      "visual_cue": "奶饼浸没，奶浆淡黄，状态稳定"
    },
    {
      "n": 8,
      "text": "冷藏三小时到奶饼吸饱奶浆变软。这一步不要着急。",
      "time_min": 185,
      "heat": "无火",
      "tip": "冷藏足够时间，中心才吸透。，注意火候。",
      "visual_cue": "奶饼松软，奶浆浓稠，状态稳定"
    },
    {
      "n": 9,
      "text": "上桌前撒开心果碎和杏仁碎。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "坚果最后撒，脆感才保得住。，注意火候。",
      "visual_cue": "表面点缀，色泽分明，状态稳定"
    }
  ],
  "tips": [
    "柠檬汁一边倒一边搅，乳清才分得干净。",
    "奶饼煮好一定泡进凉奶浆，口感才嫩。，值得留意。",
    "冷藏三小时以上，中间才吸透。，值得留意。"
  ],
  "common_mistakes": [
    "牛奶没烧开就加酸，结块太小。，值得留意。",
    "揉奶块不到位，吃起来有颗粒。，值得留意。",
    "糖水大滚煮奶饼，全散成渣。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "全脂牛奶",
      "ratio": "150 毫升:150 毫升",
      "note": "奶香略薄，热量更低。"
    },
    {
      "original": "开心果",
      "substitute": "腰果",
      "ratio": "25 克:25 克",
      "note": "香气更淡，口感更软。"
    }
  ],
  "variations": [
    "奶浆里加一勺玫瑰水，花香更明显。，值得留意。",
    "撒少量椰丝，口感更有层次。，值得留意。"
  ],
  "serving_suggestion": "冰镇后盛小碗，作为节庆甜点或饭后清口最合适。",
  "storage": "冷藏两天，奶饼与奶浆一起存放。，效果更稳定。",
