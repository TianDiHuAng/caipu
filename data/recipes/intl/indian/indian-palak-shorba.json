  "equipment": [
    "汤锅",
    "搅拌机",
    "炒锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜摘掉老梗，用清水反复洗三遍去掉泥沙，沥干后切成三段备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "根部最容易藏沙，多洗一遍省得吃出碴。",
      "visual_cue": "叶片翠绿，洗到水清无沙"
    },
    {
      "n": 2,
      "text": "锅里烧开清水，把菠菜下锅烫一分钟，捞出立刻放进冷水里过凉。",
      "time_min": 4,
      "heat": "大火",
      "tip": "过凉水能锁住绿色，后面打出来的汤不发黄。",
      "visual_cue": "叶片变软，颜色越发翠绿"
    },
    {
      "n": 3,
      "text": "洋葱切成细丝，大蒜和姜切末，过凉的菠菜挤干水分后粗粗切碎。",
      "time_min": 5,
      "heat": "无火",
      "tip": "菠菜水分挤得越干，煮出的汤就越浓不稀",
      "visual_cue": "菠菜攥成团，挤出水分彻底"
    },
    {
      "n": 4,
      "text": "炒锅烧热放黄油化开，下洋葱丝小火炒四分钟，炒到透明又带甜味。",
      "time_min": 5,
      "heat": "小火",
      "tip": "黄油很容易焦，火小一点慢慢炒才不苦",
      "visual_cue": "洋葱透亮，锅底没有焦色"
    },
    {
      "n": 5,
      "text": "加蒜末、姜末和孜然炒半分钟出香味，倒菠菜碎翻炒两分钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香料遇油才出味，炒到香气扑鼻即可。",
      "visual_cue": "香气上冲，菠菜均匀裹油"
    },
    {
      "n": 6,
      "text": "加清水煮五分钟，连汤倒进搅拌机打成细糊，回锅加鲜奶和盐小火煮三分钟，撒黑胡椒。",
      "time_min": 10,
      "heat": "小火",
      "tip": "加鲜奶后不要大滚，滚久了奶汤会分层",
      "visual_cue": "汤色翠绿，质地细滑不稀"
    }
  ],
  "tips": [
    "菠菜先烫再过凉，是这道汤保持颜色最关键的一步，省了会发暗。",
    "鲜奶要在打好糊之后再加，和菠菜一起打容易起泡沫，口感变糙。",
    "汤的浓稠度靠菠菜本身，觉得稀就多放五十克菠菜，不要加面粉。"
  ],
  "common_mistakes": [
    "菠菜不烫直接打，汤里有生涩味，颜色也偏暗黄不好看。",
    "加鲜奶后大火滚开，奶和汤分层，表面浮起白点看着就不清爽。",
    "黄油烧到冒烟才下洋葱，苦味进了汤里，整锅都救不回来。"
  ],
  "substitutions": [
    {
      "original": "鲜奶",
      "substitute": "椰浆",
      "ratio": "200毫升:200毫升",
      "note": "椰浆版更浓，素食者也适合。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "20克:18毫升",
      "note": "植物油版香气弱一些，可加半克孜然补味。"
    }
  ],
  "variations": [
    "把一半菠菜换成香菜叶，香气更冲，适合配烤肉解腻。",
    "起锅前加一勺淡奶油画圈，颜色分层更好看，适合待客。"
  ],
  "serving_suggestion": "浓汤倒进浅口碗，配印度烤饼撕着蘸，或者当烤鸡的配汤都很合适。",
  "storage": "冷藏可放两天，回热时用小火慢加热并不断搅动，避免奶汤分层起粒。",
