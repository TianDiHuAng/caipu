  "equipment": [
    "料理机",
    "深锅",
    "平底锅",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜放沸水焯三十秒，捞出立刻过冷水，挤干水分后切碎。",
      "time_min": 8,
      "heat": "大火",
      "tip": "过冷水能锁住翠绿，直接放凉会发黄发暗。",
      "visual_cue": "菠菜颜色鲜绿、挤干后成团"
    },
    {
      "n": 2,
      "text": "焯好的菠菜放料理机打成带颗粒的粗泥，不要打得太细。",
      "time_min": 6,
      "heat": "无火",
      "tip": "留一点纤维口感更好，打成浆会失去质地。",
      "visual_cue": "泥状带细小碎叶、能缓慢流动"
    },
    {
      "n": 3,
      "text": "平底锅放植物油中火煎鸡腿肉到表面变白定型，盛出备用。",
      "time_min": 7,
      "heat": "中火",
      "tip": "只煎到表面定型，后面炖煮才会嫩不柴。",
      "visual_cue": "鸡肉四面变白、略微上色"
    },
    {
      "n": 4,
      "text": "深锅放黄油化开，下孜然炒香，加洋葱丁炒到微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "孜然下锅听到爆响就对了，香气出来再放洋葱。",
      "visual_cue": "孜然微微爆开、洋葱边缘金黄"
    },
    {
      "n": 5,
      "text": "加生姜、大蒜、香菜籽、姜黄和辣椒粉炒三十秒，再下番茄炒成糊。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香料遇油才释香，火太大会瞬间发苦。",
      "visual_cue": "油色泛红、番茄完全塌陷"
    },
    {
      "n": 6,
      "text": "放入鸡肉与菠菜泥，加盐和一百毫升清水，盖盖小火炖十分钟。",
      "time_min": 7,
      "heat": "小火",
      "tip": "小火慢炖让鸡肉吸味，大火会让菠菜发暗。",
      "visual_cue": "鸡肉中心变白、酱体浓稠"
    },
    {
      "n": 7,
      "text": "淋入淡奶油拌匀，小火煮一分钟即关火，尝味补盐。",
      "time_min": 5,
      "heat": "小火",
      "tip": "淡奶油不能煮沸，一滚就分离出油花。",
      "visual_cue": "酱体顺滑呈深绿色、表面有光泽"
    }
  ],
  "tips": [
    "菠菜焯水后一定要挤干，水分多会把咖喱冲淡。",
    "香料粉提前在小碗混好，下锅时一次倒入不易炒焦。",
    "配烤饼或印度香米饭，酱汁量刚好够蘸。"
  ],
  "common_mistakes": [
    "菠菜焯完不过冷水，成品颜色发黄发暗。",
    "香料炒过头变黑，整锅带焦苦味。",
    "淡奶油大火煮沸，酱汁出现白色颗粒与出油。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鹰嘴豆",
      "ratio": "400g 对 300g 熟豆",
      "note": "做成素食版，炖制时间缩短三分钟。"
    },
    {
      "original": "淡奶油",
      "substitute": "酸奶",
      "ratio": "60ml 对 60g",
      "note": "需关火后再加，否则容易结块。"
    }
  ],
  "variations": [
    "把鸡肉换成印度奶酪块，做成菠菜奶酪咖喱的经典搭配。",
    "加入腰果泥增加浓稠度，做成更浓郁醇厚的版本。"
  ],
  "serving_suggestion": "装碗配烤饼或米饭食用，表面可再淋一圈淡奶油。",
  "storage": "冷藏两天，冷冻一个月；复热用小火加少量清水慢煮，不要微波。",
