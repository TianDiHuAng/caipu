  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扁豆先拣掉碎石与瘪粒，用冷水浸泡两小时后冲洗两遍，沥干水分放进汤锅。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡到豆皮起皱发软，后面才容易煮到起沙。",
      "visual_cue": "扁豆颗粒饱满，表面略起皱发软"
    },
    {
      "n": 2,
      "text": "汤锅里倒入清水，大火烧开后转中小火，让扁豆慢慢煮到外壳裂开、豆身散开成泥状。",
      "time_min": 22,
      "heat": "中小火",
      "tip": "中途撇掉浮在表面的白沫，汤色才清亮。",
      "visual_cue": "豆粒外壳裂开，汤面浮起细沫"
    },
    {
      "n": 3,
      "text": "另起炒锅放植物油，下孜然炒到香味冒出，再放洋葱丁炒到边缘变透明。",
      "time_min": 6,
      "heat": "中火",
      "tip": "孜然一下锅就动锅铲，几秒钟香味就出来了。",
      "visual_cue": "孜然在油里跳起小泡并散发香气"
    },
    {
      "n": 4,
      "text": "炒锅里加蒜末、姜末、姜黄粉与辣椒粉翻炒，接着下番茄块压碎炒到出红色汁水。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄要炒到软烂出汁，汤底才有一层红油。",
      "visual_cue": "番茄软塌，锅底渗出红色油汁"
    },
    {
      "n": 5,
      "text": "把炒好的料全部倒进扁豆汤里搅匀，加盐调味，小火再煮八分钟让味道融合。",
      "time_min": 8,
      "heat": "小火",
      "tip": "煮的时候用木勺压几下豆粒，汤会更浓稠。",
      "visual_cue": "汤汁浓稠，勺子挂上一层薄浆"
    },
    {
      "n": 6,
      "text": "关火后撒香菜碎，挤入柠檬的汁水搅一下，趁热盛进碗里上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬一定关火后再挤，久煮会发苦失香。",
      "visual_cue": "碗面浮着绿色香菜，汤色橙红透亮"
    }
  ],
  "tips": [
    "扁豆煮到起沙是这道汤好喝的关键，火太小豆肉出不来，汤会寡淡。",
    "香料要现炒现用，孜然与姜黄粉久放香气会散掉，别提前拌进汤里。",
    "想让汤更厚，可以留一勺煮好的扁豆单独压成泥，最后再拌回锅里。",
    "柠檬汁分两次挤，一半入锅提味，一半上桌时加，酸香层次更清楚。"
  ],
  "common_mistakes": [
    "扁豆没泡直接下锅，久煮也难起沙，汤喝起来颗粒感太硬。",
    "孜然与姜黄粉冷油下锅，容易糊成黑点，整锅汤带上苦味。",
    "柠檬汁在火未关时挤入，酸味被煮散，只剩涩口的感觉。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "红小豆",
      "ratio": "200克:200克",
      "note": "需延长煮制时间十分钟，否则不易起沙。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "30克:15克",
      "note": "香气更冲，用量减半即可避免过酸。"
    }
  ],
  "variations": [
    "喜欢口感更厚的，可以在关火前压入两勺煮软的本锅扁豆，汤会变得绵密。",
    "把番茄换成番茄膏十克，颜色更红，酸味更集中。"
  ],
  "serving_suggestion": "盛进厚壁小碗，旁边配一角柠檬与几片薄脆饼，酸香热汤配饼最顺口。",
  "storage": "冷藏可放三天，复热时小火加热并补少量清水，柠檬汁要等复热后再挤，风味才不散。",
