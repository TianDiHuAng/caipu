  "equipment": [
    "汤锅",
    "手持搅拌棒",
    "刀",
    "砧板",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜菜根削去外皮切成两厘米见方的小块，洋葱与姜分别剁成细末分开放好。",
      "time_min": 8,
      "heat": "无火",
      "tip": "甜菜根表皮带着土腥味，削厚一点去掉外层纤维更清甜。",
      "visual_cue": "块面颜色均匀，断面呈深紫红"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油中火烧热，下孜然与咖喱叶炸到籽粒跳动、叶子卷起。",
      "time_min": 3,
      "heat": "中火",
      "tip": "孜然一变色就要下洋葱，多炸十秒整锅都会发苦。",
      "visual_cue": "孜然颜色变深，锅里有噼啪声"
    },
    {
      "n": 3,
      "text": "放洋葱末与姜末炒到洋葱透亮发软，锅底泛出甜香不见生辛味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱要炒足时间出甜味，急着加水汤会寡淡。",
      "visual_cue": "洋葱半透明，锅底微微焦糖色"
    },
    {
      "n": 4,
      "text": "倒入甜菜根块翻炒两分钟，加水没过食材三厘米，盖盖小火煮十五分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "水一次加够，中途补水会让汤味变薄、颜色发灰。",
      "visual_cue": "甜菜根一插就透，汤色深红"
    },
    {
      "n": 5,
      "text": "关火用手持搅拌棒把汤打成顺滑糊状，再回小火加热到锅边冒小泡。",
      "time_min": 4,
      "heat": "小火",
      "tip": "打完再回锅煮一分钟，能把搅打带出的涩味煮散。",
      "visual_cue": "汤体细腻无颗粒，表面泛起小泡"
    },
    {
      "n": 6,
      "text": "离火稍放两分钟再拌入酸奶，挤青柠汁，撒盐与黑胡椒，最后撒香菜碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶必须在离火后加，高温会当场让它絮状分离。",
      "visual_cue": "汤色转成柔和的玫瑰粉，酸奶不结块"
    }
  ],
  "tips": [
    "喜欢更浓的口感可以少加一百毫升水，收成半汤半泥的状态。",
    "酸奶选浓稠的原味款，稀的容易在汤里散开挂不住。",
    "上桌前留一勺酸奶淋在表面打旋，卖相会好看很多。",
    "青柠汁按口味补，甜菜根本身甜度高，酸味能压住土腥。"
  ],
  "common_mistakes": [
    "酸奶在滚汤里搅，整锅瞬间出现白色絮状小块。",
    "甜菜根切得过大就下锅，煮到汤干中间还硬。",
    "孜然和咖喱叶炸过头，汤里带一股糊苦味。",
    "汤打得太稀还继续加水，喝起来像兑了水的菜汁。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "淡奶油",
      "ratio": "150 克:120 毫升",
      "note": "口感更厚，酸味需靠青柠补足。"
    },
    {
      "original": "甜菜根",
      "substitute": "胡萝卜",
      "ratio": "500 克:500 克",
      "note": "甜度更高，青柠汁可少放一点。"
    }
  ],
  "variations": [
    "加一小勺烤过的孜然粉收尾，香气会更立体。",
    "把一半汤打成泥一半保留块状，吃起来有层次。"
  ],
  "serving_suggestion": "盛进白瓷汤碗，汤色粉红衬得好看，表面淋一勺酸奶划出螺旋，配烤饼或面包片同吃。",
  "storage": "冷藏密封可放两天，复热用小火慢加热并不断搅拌，不要煮沸，酸奶容易分离。",
