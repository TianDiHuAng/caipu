  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成两厘米的块，泡进清水里洗掉表面多余的粉质。",
      "time_min": 8,
      "heat": "无火",
      "tip": "冲洗掉表面黏质，炖的时候汤才不浑。",
      "visual_cue": "水色发白，土豆清爽，状态稳定"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧热，放孜然粒小火爆到香气出来。",
      "time_min": 3,
      "heat": "小火",
      "tip": "孜然一变色就下洋葱，爆过头会发苦。",
      "visual_cue": "孜然跳动，香气冲鼻，状态稳定"
    },
    {
      "n": 3,
      "text": "下洋葱碎炒到透明发软，加蒜末和姜末炒出香味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透才有甜底，姜蒜后放不容易焦。",
      "visual_cue": "洋葱透明，锅中香气浓"
    },
    {
      "n": 4,
      "text": "加番茄丁和姜黄粉，中火炒五分钟到番茄软烂出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒出红油，咖喱的颜色和味道才够。",
      "visual_cue": "汤汁泛红，锅底不干，状态稳定"
    },
    {
      "n": 5,
      "text": "倒入土豆块翻炒两分钟，加清水到刚没过土豆。",
      "time_min": 5,
      "heat": "中火",
      "tip": "水量别太多，后面还要收汁。，注意火候。",
      "visual_cue": "土豆裹汁，水面齐平，状态稳定"
    },
    {
      "n": 6,
      "text": "盖盖小火炖十二分钟，用筷子能插透土豆即可。",
      "time_min": 12,
      "heat": "小火",
      "tip": "中途翻一下防粘底，土豆才均匀熟。，注意火候。",
      "visual_cue": "锅中冒泡，土豆变软，状态稳定"
    },
    {
      "n": 7,
      "text": "倒入青豆加盐，再炖三分钟到青豆熟透。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "青豆后放，久煮会发黄失甜。，注意火候。",
      "visual_cue": "青豆翠绿，汤汁微稠，状态稳定"
    },
    {
      "n": 8,
      "text": "大火收汁到浓稠，撒香菜碎后关火装盘。这一步不要着急。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "汁收到能挂在土豆上就好，太干会糊。",
      "visual_cue": "汁液挂勺，表面油亮，状态稳定"
    }
  ],
  "tips": [
    "土豆切好先冲洗，炖出来的汤才不发浑。",
    "番茄要炒到出红油，咖喱味才够厚。，值得留意。",
    "青豆最后放，久煮会发黄失甜。，值得留意。"
  ],
  "common_mistakes": [
    "孜然爆到发黑才下料，整锅带苦味。，务必避免。",
    "土豆一直大火煮，外面烂了中间还硬。，务必避免。",
    "水加太多不收汁，变成一锅稀汤。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "青豆",
      "substitute": "毛豆",
      "ratio": "150 克:150 克",
      "note": "口感更扎实，煮的时间加两分钟。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "600 克:600 克",
      "note": "甜味更明显，盐可少放一克。"
    }
  ],
  "variations": [
    "加一勺酸奶同煮，味道更圆润。，也很受欢迎。",
    "配一份烤饼蘸汁，是最常见的吃法。，也很受欢迎。"
  ],
  "serving_suggestion": "配米饭或烤饼蘸汁吃，撒一把香菜更清香。，效果更稳定。",
  "storage": "冷藏两天，复热加少量水小火煮开。，效果更稳定。",
