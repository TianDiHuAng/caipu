    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩切成四厘米见方的块，用厨房纸吸干。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面干爽，煎的时候才上色。，火候要稳，别忽大忽小。",
      "visual_cue": "肉块干爽，形状方正"
    },
    {
      "n": 2,
      "text": "厚底锅烧热倒橄榄油，肉块分批下锅煎。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中大火",
      "tip": "别一次下太多，锅温掉了就出水。，火候要稳，别忽大忽小。",
      "visual_cue": "肉块焦褐，锅底留痕"
    },
    {
      "n": 3,
      "text": "煎到各面金黄，盛出备用。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中大火",
      "tip": "煎出焦壳，炖出来才香。，火候要稳，别忽大忽小。",
      "visual_cue": "表面金黄，油脂析出"
    },
    {
      "n": 4,
      "text": "原锅炒洋葱丝和蒜，炒到洋葱软塌。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中火",
      "tip": "用锅里的油炒，味道才连得上。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱软塌，颜色转黄"
    },
    {
      "n": 5,
      "text": "加番茄块炒出汁，锅底焦渣刮起来。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "刮起锅底的焦香，汤才够味。，火候要稳，别忽大忽小。",
      "visual_cue": "番茄化开，汤汁泛红"
    },
    {
      "n": 6,
      "text": "肉块回锅，加盐、黑胡椒和清水没过肉。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "水一次加够，中途别加冷水。，火候要稳，别忽大忽小。",
      "visual_cue": "水面齐平，肉块沉底"
    },
    {
      "n": 7,
      "text": "盖盖小火炖一小时，中途翻一次。，火候要稳，别忽大忽小。",
      "time_min": 62,
      "heat": "小火",
      "tip": "小火慢炖，肉才软而不散。，火候要稳，别忽大忽小。",
      "visual_cue": "汤面微沸，肉块转深"
    },
    {
      "n": 8,
      "text": "加土豆块再炖二十分钟，到筷子能插透。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "小火",
      "tip": "土豆后放，才不会炖成泥。，火候要稳，别忽大忽小。",
      "visual_cue": "土豆微软，边缘完整"
    },
    {
      "n": 9,
      "text": "开盖收汁五分钟，尝味补盐。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "收汁时轻推锅，别把肉翻碎。，火候要稳，别忽大忽小。",
      "visual_cue": "汤汁浓稠，油光浮动"
    }
  ],
  "tips": [
    "肉块先煎出焦壳，炖出来才香。，这一点很关键。",
    "水一次加够，中途加冷水肉会紧。，这一点很关键。",
    "土豆后放，才不会炖成泥。，这一点很关键。"
  ],
  "common_mistakes": [
    "肉没吸干就下锅，煎不出焦色。，这一点很关键。",
    "全程大火，肉老汤干。，这一点很关键。",
    "土豆早放，最后化成糊。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛腱",
      "ratio": "900 克:900 克",
      "note": "炖的时间要加二十分钟。"
    },
    {
      "original": "土豆",
      "substitute": "胡萝卜",
      "ratio": "400 克:400 克",
      "note": "甜味更明显，炖的时间减五分。"
    }
  ],
  "variations": [
    "加两勺番茄膏，汤汁更浓。，这一点很关键。",
    "放一根肉桂，香气更暖。，这一点很关键。"
  ],
  "serving_suggestion": "浇在白米饭上，配一勺汤汁。，这一点很关键。",
  "storage": "冷藏三天，冷冻一个月。，这一点很关键。",
