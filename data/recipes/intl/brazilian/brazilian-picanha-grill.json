  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛肉",
          "name_en": "beef",
          "amount": 800,
          "unit": "g",
          "note": "臀肉部位，带一层脂肪",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
          "unit": "g",
          "note": "粗盐更佳",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 4,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
          "note": "拍碎",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 20,
          "unit": "ml",
          "note": "抹面防粘",
          "optional": false
        },
        {
          "name": "青柠",
          "name_en": "lime",
          "amount": 2,
          "unit": "piece",
          "note": "挤汁解腻",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "铸铁烤盘",
    "夹子",
    "砧板",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉修去多余筋膜，保留表面约半厘米厚的一层脂肪。",
      "time_min": 8,
      "heat": "无火",
      "tip": "脂肪是香味的来源，别修得太干净。",
      "visual_cue": "肉面平整，脂肪层均匀"
    },
    {
      "n": 2,
      "text": "顺着纹理把整块肉切成四条厚约四厘米的长条。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切厚些，烤的时候才外焦里嫩。",
      "visual_cue": "四块大小相近的长条"
    },
    {
      "n": 3,
      "text": "肉块表面抹橄榄油，撒粗盐与黑胡椒，放上拍碎的大蒜腌二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "盐提前撒能入味，别撒太早出水。",
      "visual_cue": "表面挂满调料，油光发亮"
    },
    {
      "n": 4,
      "text": "铸铁烤盘大火烧到微微冒烟，脂肪面朝下先煎。",
      "time_min": 4,
      "heat": "大火",
      "tip": "先煎脂肪面逼出油，后面不容易粘。",
      "visual_cue": "脂肪金黄，油滴渗出"
    },
    {
      "n": 5,
      "text": "翻面继续煎，每面三分钟，形成深褐色焦壳。",
      "time_min": 6,
      "heat": "大火",
      "tip": "别频繁翻，焦壳要时间才能形成。",
      "visual_cue": "表面深褐，边缘微卷"
    },
    {
      "n": 6,
      "text": "转到中火继续烤，让肉块中心达到自己喜欢的熟度。",
      "time_min": 6,
      "heat": "中火",
      "tip": "用夹子按压，弹性越大越生。",
      "visual_cue": "肉汁微渗，中心粉红"
    },
    {
      "n": 7,
      "text": "取出放在砧板上盖锡纸静置八分钟，然后再切片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "静置让肉汁回流，切时才不流失。",
      "visual_cue": "肉汁均匀，切面多汁"
    },
    {
      "n": 8,
      "text": "逆着纹理切成一厘米厚的片，摆盘后挤上青柠汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "逆纹切，咬起来才嫩。",
      "visual_cue": "切片完整，颜色分层"
    }
  ],
  "tips": [
    "脂肪面先煎，逼出的油正好煎另一面。",
    "静置这一步别省，切早了肉汁全流光。",
    "粗盐比细盐好，撒得匀又不死咸。"
  ],
  "common_mistakes": [
    "把脂肪全部修掉，烤出来又干又柴没有香气。",
    "一直大火烤，外面焦黑里面还生。",
    "出炉立刻下刀切，肉汁全流在盘子里浪费了。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "800 克:800 克",
      "note": "羊排部位同法烤制，去膻可多加青柠。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "2 个:1 个",
      "note": "酸度更低，挤半颗即可。"
    }
  ],
  "variations": [
    "配一碟青柠洋葱莎莎酱，解腻又提味。",
    "撒一层粗粒海盐片，口感更有层次。"
  ],
  "serving_suggestion": "切片摆盘，配白米饭、红豆和青柠角。",
  "storage": "冷藏两天，复热用平底锅小火两面各煎四十秒。",
