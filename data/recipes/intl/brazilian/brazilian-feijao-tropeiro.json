  "steps": [
    {
      "n": 1,
      "text": "黑豆提前泡发煮熟，沥干水分备用。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆子要煮到软而不烂，炒的时候才不糊。",
      "visual_cue": "豆粒完整，轻压即碎，状态稳定"
    },
    {
      "n": 2,
      "text": "大米煮成稍硬的饭，摊开晾到不烫手。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "饭煮硬一点，炒的时候才不粘。，注意火候。",
      "visual_cue": "米粒分明，松散不黏，状态稳定"
    },
    {
      "n": 3,
      "text": "培根丁和香肠片下锅，加植物油小火煎到出油微焦。",
      "time_min": 6,
      "heat": "小火",
      "tip": "先煎出油，后面炒才香不腻。，注意火候。",
      "visual_cue": "培根卷边，油脂清亮，状态稳定"
    },
    {
      "n": 4,
      "text": "加洋葱丁和蒜末炒到透明，再倒入打散的蛋液。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蛋液下锅立刻划散，才成小碎块。，注意火候。",
      "visual_cue": "蛋液凝固，颗粒松散，状态稳定"
    },
    {
      "n": 5,
      "text": "放入黑豆翻炒两分钟，让豆子裹上油脂。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "轻轻翻，别把豆子压成泥。，注意火候。",
      "visual_cue": "豆子油亮，颗粒完整，状态稳定"
    },
    {
      "n": 6,
      "text": "倒入米饭炒散，加盐和黑胡椒调味。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "饭要压散再炒，结块就不好吃。，注意火候。",
      "visual_cue": "米粒松散，颜色均匀，状态稳定"
    },
    {
      "n": 7,
      "text": "撒木薯粉快速翻炒一分钟，让粉吸收水分。这一步不要着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "粉最后撒，吸掉多余水分又不糊。，注意火候。",
      "visual_cue": "颗粒干爽，不粘锅，状态稳定"
    },
    {
      "n": 8,
      "text": "关火撒欧芹碎，趁热盛出。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "欧芹关火后加，清香不散。，注意火候。",
      "visual_cue": "香气浓郁，颗粒松散，状态稳定"
    }
  ],
  "tips": [
    "米饭煮硬一点，炒的时候才不粘锅。，值得留意。",
    "木薯粉最后撒，吸掉多余水分。，值得留意。",
    "黑豆轻翻，压碎就没了口感。，值得留意。"
  ],
  "common_mistakes": [
    "饭煮太软，炒完黏成一坨。，值得留意。",
    "豆子煮烂，炒的时候全散成泥。，值得留意。",
    "木薯粉下太多，成品干得噎人。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "香肠",
      "substitute": "培根",
      "ratio": "100 克:100 克",
      "note": "咸味更重，盐可略减。"
    },
    {
      "original": "黑豆",
      "substitute": "白豆",
      "ratio": "250 克:250 克",
      "note": "颜色浅些，风味更清淡。"
    }
  ],
  "variations": [
    "加一把羽衣甘蓝碎同炒，颜色更绿。，值得留意。",
    "配一个煎蛋放上面，更饱腹。，值得留意。"
  ],
  "serving_suggestion": "配烤肉和蔬菜一起吃，也可以直接当主食。，效果更稳定。",
  "storage": "冷藏两天，复热加少许水小火炒散。，效果更稳定。",
