  "equipment": [
    "锅",
    "大碗",
    "烤盘",
    "勺子",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶、清水、黄油和盐放锅里煮到微沸。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煮到锅边冒小泡就够。，火候要稳，别忽大忽小。",
      "visual_cue": "液面微滚，黄油化开"
    },
    {
      "n": 2,
      "text": "关火倒入木薯粉，用木勺快速搅成团。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热倒粉，烫熟才成团。，火候要稳，别忽大忽小。",
      "visual_cue": "面团粗糙，无干粉，这一点很关键。"
    },
    {
      "n": 3,
      "text": "面团稍凉后分次加鸡蛋，揉到光滑。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蛋一个一个加，视吸水情况调整。，火候要稳，别忽大忽小。",
      "visual_cue": "面团光滑，能拉成条"
    },
    {
      "n": 4,
      "text": "拌入帕玛森芝士，揉匀。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "芝士最后拌，香气才留得住。，火候要稳，别忽大忽小。",
      "visual_cue": "面团均匀，黄色斑点"
    },
    {
      "n": 5,
      "text": "手上抹橄榄油，把面团搓成乒乓球大小的球。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "大小一致，烤的时间才统一。，火候要稳，别忽大忽小。",
      "visual_cue": "小球圆整，表面光滑"
    },
    {
      "n": 6,
      "text": "摆在烤盘上留出间距，冷藏十分钟定型。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏后烤，形状才不塌。，火候要稳，别忽大忽小。",
      "visual_cue": "小球挺立，不粘手，这一点很关键。"
    },
    {
      "n": 7,
      "text": "烤箱两百度烤二十分钟，到表面微黄鼓起。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "无火",
      "tip": "烤到鼓起、底部微焦最好吃。，火候要稳，别忽大忽小。",
      "visual_cue": "表面裂口，底部金黄"
    },
    {
      "n": 8,
      "text": "出炉稍凉三分钟再吃，里面会拉丝。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "太烫会烫嘴，凉一点更有嚼劲。，火候要稳，别忽大忽小。",
      "visual_cue": "外壳脆，内里空心，这一点很关键。"
    }
  ],
  "tips": [
    "木薯粉要趁热烫，才成团。，这一点很关键。",
    "鸡蛋分次加，看吸水调整。，这一点很关键。",
    "烤到鼓起裂口才够空心。，这一点很关键。"
  ],
  "common_mistakes": [
    "粉没烫熟，面团散成渣。，这一点很关键。",
    "蛋一次全加，面团太湿。，这一点很关键。",
    "烤的时间不够，中间是死面。，这一点很关键。"
  ],
  "substitutions": [
