  "equipment": [
    "锅",
    "木勺",
    "刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米洗净，泡十分钟后沥干水。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "沥干再炒，米粒才不粘。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒松散，无积水，这一点很关键。"
    },
    {
      "n": 2,
      "text": "锅里倒橄榄油，炒香洋葱末和蒜末。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软就好，别炒焦。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱透明，香气上涌"
    },
    {
      "n": 3,
      "text": "下大米翻炒三分钟，炒到米粒透亮。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "炒过再煮，米粒才粒粒分明。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒油亮，边缘透明"
    },
    {
      "n": 4,
      "text": "倒入椰奶和清水，加盐搅匀。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "椰奶容易分层，倒前先摇匀。，火候要稳，别忽大忽小。",
      "visual_cue": "液面乳白，米粒铺平"
    },
    {
      "n": 5,
      "text": "煮开后转小火，盖盖焖十五分钟。，火候要稳，别忽大忽小。",
      "time_min": 17,
      "heat": "小火",
      "tip": "焖的时候别开盖，蒸汽跑了饭就夹生。",
      "visual_cue": "锅边冒气，水声变小"
    },
    {
      "n": 6,
      "text": "关火再焖五分钟，用木勺翻松。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "翻松让蒸汽散掉，饭才不黏。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒松散，颗颗分明"
    },
    {
      "n": 7,
      "text": "装盘撒椰蓉，趁热吃。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "椰蓉干锅烘一下更香。，火候要稳，别忽大忽小。",
      "visual_cue": "表面雪白，香气清甜"
    }
  ],
  "tips": [
    "米先炒过再煮，粒粒分明。，这一点很关键。",
    "焖的时候别开盖，跑了汽就夹生。，这一点很关键。",
    "椰奶先用前摇匀，免得油水分层。，这一点很关键。"
  ],
  "common_mistakes": [
    "米没沥干，煮出来一锅糊。，这一点很关键。",
    "火太大，锅底结焦。，这一点很关键。",
    "焖的时候掀盖，饭夹生。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "250 毫升:250 毫升",
      "note": "香气变淡，可加一勺椰蓉。"
    },
    {
      "original": "大米",
      "substitute": "糙米",
      "ratio": "320 克:320 克",
      "note": "需多煮十分钟，水多加五十毫升。"
    }
  ],
  "variations": [
    "加一把葡萄干，甜咸更明显。，这一点很关键。",
    "撒烤腰果碎，口感更脆。，这一点很关键。"
  ],
  "serving_suggestion": "配椰奶鱼或烤肉，吸收汤汁。，这一点很关键。",
  "storage": "冷藏两天，复热加一勺水。，这一点很关键。",
