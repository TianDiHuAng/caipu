  "equipment": [
    "宽口炖锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼切大块，用青柠汁、盐与黑胡椒抓匀腌十五分钟去腥。",
      "time_min": 16,
      "heat": "无火",
      "tip": "青柠汁能让鱼肉紧实，也压住海腥味。",
      "visual_cue": "鱼块表面发亮，滴水不浑"
    },
    {
      "n": 2,
      "text": "洋葱与红椒切成圈，番茄切厚片，大蒜切末备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切圈而非切丁，成菜才有层层叠叠的样子。",
      "visual_cue": "蔬菜片厚薄一致，摆开整齐"
    },
    {
      "n": 3,
      "text": "宽口锅底淋一层橄榄油，铺上洋葱圈与蒜末垫底。",
      "time_min": 3,
      "heat": "无火",
      "tip": "洋葱垫底能防鱼块粘锅，也把甜味炖进汤里。",
      "visual_cue": "锅底铺满一层白色洋葱圈"
    },
    {
      "n": 4,
      "text": "依次码上番茄片与红椒圈，撒盐和辣椒粉，再放腌好的鳕鱼块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "层层码放不搅拌，是moqueca的关键手法。",
      "visual_cue": "鱼块平铺不重叠，蔬菜裹住鱼肉"
    },
    {
      "n": 5,
      "text": "倒入椰奶没过食材的三分之二，加盖中火煮开转小火炖二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "椰奶不要大火滚，否则会析出油水分层。",
      "visual_cue": "汤面轻沸，椰香混着番茄酸甜"
    },
    {
      "n": 6,
      "text": "开盖淋一圈橄榄油，撒香菜碎，关火焖三分钟让香气融合。",
      "time_min": 4,
      "heat": "无火",
      "tip": "关火后再撒香菜，颜色翠绿不黄。",
      "visual_cue": "汤色橙白，香菜浮在表面"
    },
    {
      "n": 7,
      "text": "连锅端上桌，配白饭舀汤浇在饭碗上一起吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "连锅上桌保温，汤凉了椰奶会发腻。",
      "visual_cue": "汤汁浓稠，鱼块完整不散"
    }
  ],
  "tips": [
    "用厚底宽口锅，受热均匀汤才不糊底。",
    "椰奶选全脂，低脂版本炖出来寡淡。",
    "千万别用勺子搅，晃动锅身即可。"
  ],
  "common_mistakes": [
    "大火猛滚椰奶，汤分层成油花和水。",
    "鱼块切太小，炖完化成碎渣捞不起来。",
    "提前搅拌翻动，鱼块散在汤里没有整块。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "鲈鱼",
      "ratio": "700 克:700 克",
      "note": "肉质更细，炖制时间缩短五分钟。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "400 毫升:400 毫升",
      "note": "香气变淡，可加十克黄油补脂香。"
    }
  ],
  "variations": [
    "加几只虾仁一起同炖，做成海边风味的海鲜版。",
    "用陶锅慢炖，风味更接近巴伊亚州的做法。"
  ],
  "serving_suggestion": "配白饭与一份炒木薯粉同食，汤要浇满饭面。",
  "storage": "冷藏两天；复热小火慢煨，别煮沸以免椰奶分层。",
