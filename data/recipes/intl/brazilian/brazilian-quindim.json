  "equipment": [
    "碗",
    "打蛋器",
    "小模具",
    "烤箱",
    "水浴盘",
    "筛子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛋黄加白糖，用打蛋器搅到发白。，火候宁小勿大，慢慢推进。",
      "time_min": 5,
      "heat": "无火",
      "tip": "只搅不打发，起泡会有蜂窝。，注意锅里温度别掉下来。",
      "visual_cue": "蛋糊泛白，糖粒化开"
    },
    {
      "n": 2,
      "text": "倒入椰奶和清水，搅到完全融合。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "慢慢倒边搅，蛋液才不起泡。，火要均匀，食材才不糊。",
      "visual_cue": "液体顺滑，颜色奶黄"
    },
    {
      "n": 3,
      "text": "拌入椰蓉，静置十分钟让椰蓉吸饱。，看住火，别让它失控。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置后烤出来才不分层。，全程留意火候，别贪快。",
      "visual_cue": "椰蓉沉底，液面平静"
    },
    {
      "n": 4,
      "text": "模具内壁抹黄油，撒一层白糖。，火大了就离锅远一点。",
      "time_min": 4,
      "heat": "无火",
      "tip": "撒糖烤完才有一层亮壳。，火别开太大，稳着来。",
      "visual_cue": "内壁油亮，糖粒附着"
    },
    {
      "n": 5,
      "text": "蛋液过筛倒进模具，撇掉表面气泡。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛去掉泡沫，表面才光滑。，火力保持中等，慢慢来。",
      "visual_cue": "液面平整，无浮沫，成败就在这一步。"
    },
    {
      "n": 6,
      "text": "模具放进水浴盘，烤箱一百六十度烤四十分钟。，火候宁小勿大，慢慢推进。",
      "time_min": 42,
      "heat": "无火",
      "tip": "水浴让布丁受热均匀不裂。，注意锅里温度别掉下来。",
      "visual_cue": "表面凝固，轻晃微颤"
    },
    {
      "n": 7,
      "text": "出炉放凉后冷藏两小时，倒扣脱模。，始终中小火，别心急。",
      "time_min": 130,
      "heat": "无火",
      "tip": "冷藏定型，脱模才完整。，火要均匀，食材才不糊。",
      "visual_cue": "表面油亮，形状完整"
    }
  ],
  "tips": [
    "只取蛋黄，蛋白会让口感发硬。，这点要注意。",
    "水浴烤，表面才不会裂。，这是关键点。",
    "冷藏两小时再脱模，形状才完整。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "蛋液打出发泡，成品全是孔。，这一步别省。",
    "没用水浴，表面裂成网。，别跳过这步。",
    "没冷藏就脱模，一碰就塌。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "椰蓉",
      "substitute": "椰奶",
      "ratio": "120 克:200 毫升",
      "note": "口感更滑，需多加二十克白糖。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "180 克:200 克",
      "note": "甜味更柔，成品颜色更深。"
    }
  ],
  "variations": [
    "模具底部放一颗丁香，香气更足。，很多人在这里出错。",
    "加一勺柠檬皮屑，甜味更清。，这里最容易翻车。"
  ],
  "serving_suggestion": "冷藏后切块，配一杯浓咖啡。，别小看这一步。",
  "storage": "冷藏三天，密封防干。，成败就在这一步。",
