  "equipment": [
    "炒锅",
    "盆",
    "漏勺",
    "料理机"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉冷水下锅加盐煮十五分钟，捞出稍晾用手撕成细丝。",
      "time_min": 18,
      "heat": "中火",
      "tip": "煮到能用筷子戳透即可，煮久肉会发干。",
      "visual_cue": "肉心无粉色，一撕成丝"
    },
    {
      "n": 2,
      "text": "炒锅放少许植物油，中火炒洋葱末三分钟到透明，下鸡丝、番茄酱和黑胡椒炒匀。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄酱要炒出红油，馅料才香不酸生。",
      "visual_cue": "馅料红亮抱团，无汤水"
    },
    {
      "n": 3,
      "text": "牛奶倒进锅中小火加热到微沸，一次倒入两百克面粉快速搅成面团。",
      "time_min": 8,
      "heat": "小火",
      "tip": "面粉一次倒入不停搅，慢一点就结疙瘩。",
      "visual_cue": "面团离开锅壁成团"
    },
    {
      "n": 4,
      "text": "面团稍降温后移到抹油的案板，揉两分钟到光滑，分成十二份。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面团要揉到光滑，包的时候才不裂。",
      "visual_cue": "面团细腻光滑有弹性"
    },
    {
      "n": 5,
      "text": "取一份面团按成圆饼，放一勺鸡丝馅和一小块奶酪，捏成水滴形收口。",
      "time_min": 15,
      "heat": "无火",
      "tip": "收口一定捏紧，炸的时候裂开油就进去了。",
      "visual_cue": "形状像小水滴，收口封实"
    },
    {
      "n": 6,
      "text": "鸡蛋打散成蛋液，面坯先蘸蛋液再滚一层面包屑，摆开静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "裹好静置一会儿，炸的时候外皮不脱。",
      "visual_cue": "表面均匀沾满面包屑"
    },
    {
      "n": 7,
      "text": "锅中倒二百七十毫升植物油烧到一百七十度，分批炸四分钟到金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温别太高，太高外皮黑了馅还是凉的。",
      "visual_cue": "外皮金黄酥脆，浮起冒泡"
    },
    {
      "n": 8,
      "text": "捞出沥油，稍凉两分钟再咬，内馅奶酪会流心。",
      "time_min": 3,
      "heat": "无火",
      "tip": "稍晾一会儿，里面的奶酪烫口要小心。",
      "visual_cue": "外壳脆响，掰开奶酪拉丝"
    }
  ],
  "tips": [
    "面团趁热揉，凉了会变硬不好操作。",
    "馅料一定要炒干水分，湿了会把面皮泡软。",
    "炸制分批进行，油温稳定外皮才脆。"
  ],
  "common_mistakes": [
    "面团调得太稀，捏不成形直接摊开。",
    "收口没有捏紧，炸的时候裂开吸满油。",
    "油温太低，成品油腻而且外壳软塌。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "350 克:350 克",
      "note": "更嫩，煮的时间缩短三分钟。"
    },
    {
      "original": "奶酪",
      "substitute": "奶酪片",
      "ratio": "120 克:120 克",
      "note": "融化更快，包的时候别露在收口。"
    }
  ],
  "variations": [
    "馅料里加一勺奶油奶酪，口感更滑。",
    "用空气炸锅二百度十二分钟，油量更少。"
  ],
  "serving_suggestion": "趁热装纸盘，配一杯冰镇甘蔗汁或啤酒，是巴西街头最常见的手抓小吃。",
  "storage": "炸好的冷藏两天，复热用二百度烤十分钟恢复脆度。",
