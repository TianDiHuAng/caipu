  "equipment": [
    "厚底炖锅",
    "木勺",
    "刀",
    "砧板",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑豆用清水泡一夜，沥干后重新加清水煮开后倒掉水，去涩味。",
      "time_min": 15,
      "heat": "中火",
      "tip": "倒掉第一遍豆水，煮出的炖菜汤色才黑亮不发灰。",
      "visual_cue": "豆子表皮起皱，水色深褐"
    },
    {
      "n": 2,
      "text": "五花肉冷水下锅煮五分钟去血沫，捞出冲净，切大块备用。",
      "time_min": 8,
      "heat": "中火",
      "tip": "先焯再切，肉块形状完整不易散。",
      "visual_cue": "肉块表面收紧，浮沫撇净"
    },
    {
      "n": 3,
      "text": "炖锅下橄榄油炒洋葱丁与蒜末至透明，加入腊肠片煸出红油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "腊肠先煸出油，整锅炖菜的香气基础就在这里。",
      "visual_cue": "锅内油脂泛橙红，洋葱透明"
    },
    {
      "n": 4,
      "text": "下五花肉与猪里脊块同炒三分钟，倒入黑豆、月桂叶和高汤，煮开后转小火。",
      "time_min": 8,
      "heat": "中火",
      "tip": "高汤量以刚没过豆子为准，中途水少可补热水。",
      "visual_cue": "豆与肉全部浸在汤汁中"
    },
    {
      "n": 5,
      "text": "盖盖小火炖九十分钟，期间每二十分钟搅一次底，防豆子粘锅。",
      "time_min": 92,
      "heat": "小火",
      "tip": "豆子富含粉质，最容易糊底，勤搅是唯一办法。",
      "visual_cue": "豆子软烂出沙，汤汁浓稠挂勺"
    },
    {
      "n": 6,
      "text": "加橙皮丝和橙汁煮五分钟，加盐与黑胡椒调味，盛盘配米饭撒香菜。",
      "time_min": 8,
      "heat": "小火",
      "tip": "橙子能平衡油脂感，这是巴西家常的收尾小技巧。",
      "visual_cue": "汤汁乌黑发亮，表面浮一层红油"
    }
  ],
  "tips": [
    "黑豆必须泡透，泡不够久炖两小时也不易软。",
    "隔夜再热更好吃，豆子与肉味完全融合。",
    "配橙子片和炒羽衣甘蓝是里约的标准套餐。"
  ],
  "common_mistakes": [
    "豆子没换水直接炖，汤色发灰带土腥味。",
    "全程大火猛滚，豆皮破光、汤汁成糊。",
    "盐一开始就放足，豆子表面变硬再也炖不烂。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪里脊",
      "ratio": "300 克:300 克",
      "note": "油脂减少，可加十毫升橄榄油补香。"
    },
    {
      "original": "腊肠",
      "substitute": "香肠",
      "ratio": "200 克:200 克",
      "note": "烟熏味略淡，可加两克辣椒粉提味。"
    }
  ],
  "variations": [
    "加入猪蹄或牛腩同炖，可做更丰盛的节日版本。"
  ],
  "serving_suggestion": "配白米饭、橙子片、炒羽衣甘蓝与木薯粉炒香料。",
  "storage": "冷藏三天，冷冻一个月；复热加少量水小火慢炖。",
