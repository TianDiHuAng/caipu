          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "裹面用",
          "optional": false
        },
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 30,
          "unit": "ml",
          "note": "调节软硬",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "浅盘",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "厚底锅倒入炼乳、可可粉、黄油与淡奶油，先用木勺搅匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "火还没开就搅匀，才不会结块。",
      "visual_cue": "颜色均匀，无干粉团"
    },
    {
      "n": 2,
      "text": "开小火边加热边不停搅拌，锅底和锅壁都要刮到。",
      "time_min": 2,
      "heat": "小火",
      "tip": "全程别停手，一停就容易糊底。",
      "visual_cue": "液体变稠，开始冒泡"
    },
    {
      "n": 3,
      "text": "继续搅拌十二分钟，直到混合物能整块脱离锅底。",
      "time_min": 8,
      "heat": "小火",
      "tip": "用勺划一道，能看见锅底就到位了。",
      "visual_cue": "糊体抱团，划痕不回填"
    },
    {
      "n": 4,
      "text": "倒进抹了黄油的浅盘，摊平后室温放凉一小时。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别放冰箱，太快冷却会出水。",
      "visual_cue": "表面结皮，按下去不粘"
    },
    {
      "n": 5,
      "text": "手抹一点黄油，取一小块糊体搓成乒乓球大小的球。",
      "time_min": 6,
      "heat": "无火",
      "tip": "手上有油，搓起来不粘也不变形。",
      "visual_cue": "圆球光滑，个头一致"
    },
    {
      "n": 6,
      "text": "把球放进白糖里滚一圈，让表面均匀裹上糖粒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖要现裹，放久了会受潮化掉。",
      "visual_cue": "表面挂满白色糖粒"
    },
    {
      "n": 7,
      "text": "装入小纸托里，室温静置十分钟让表面的糖壳定型。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置后糖壳更脆，拿起来不粘手。",
      "visual_cue": "糖壳结实，不脱落"
    }
  ],
  "tips": [
    "搅拌一定要刮到锅底角落，那是先糊的地方。",
    "糊体要炒到能离锅，太软搓不成球。",
    "裹糖要用细砂糖，粗颗粒的糖挂不住表面。"
  ],
  "common_mistakes": [
    "火太大，巧克力糊底部焦黑带苦味。",
    "炒得不够干，搓球时黏成一团根本不成型。",
    "刚出锅就上手搓，烫手而且一捏就扁。"
  ],
  "substitutions": [
    {
      "original": "可可粉",
      "substitute": "巧克力",
      "ratio": "45 克:120 克",
      "note": "用黑巧克力切碎融化，甜度需减糖。"
    },
    {
      "original": "炼乳",
      "substitute": "牛奶",
      "ratio": "400 克:300 毫升",
      "note": "需加八十克糖并延长熬煮时间。"
    }
  ],
  "variations": [
    "裹一层巧克力碎或椰蓉，口感更多层。",
    "中间包一颗杏仁，做成夹心版本。"
  ],
  "serving_suggestion": "装在小纸托里，配一杯浓咖啡解甜。",
  "storage": "室温密封三天，冷藏一周；冷藏后取出回温十分钟再吃。",
