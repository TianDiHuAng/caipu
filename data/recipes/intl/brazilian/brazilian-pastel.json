  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和一小勺油，慢慢加温水揉成光滑面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团要软一点，擀开才不裂。，注意火候。",
      "visual_cue": "面团光滑，按下去回弹"
    },
    {
      "n": 2,
      "text": "面团盖布醒二十分钟，同时准备馅料。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "醒面够，擀皮才不回缩。，注意火候。",
      "visual_cue": "面团松弛，手感柔软，状态稳定"
    },
    {
      "n": 3,
      "text": "牛里脊切细丁，洋葱切碎，番茄切小丁备用。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "肉切小丁，包的时候才不会顶破皮。，注意火候。",
      "visual_cue": "肉丁细小，颗粒均匀，状态稳定"
    },
    {
      "n": 4,
      "text": "橄榄油炒香洋葱碎和蒜末，下牛里脊丁炒到变色。",
      "time_min": 5,
      "heat": "中火",
      "tip": "牛里脊炒散不结块，馅才均匀。，注意火候。",
      "visual_cue": "肉丁散开，颜色变深，状态稳定"
    },
    {
      "n": 5,
      "text": "加番茄丁炒到出汁收干，加盐、黑胡椒和欧芹拌匀。",
      "time_min": 6,
      "heat": "中火",
      "tip": "汁要收干，湿馅会浸破面皮。，注意火候。",
      "visual_cue": "馅料干爽，汁水收尽，状态稳定"
    },
    {
      "n": 6,
      "text": "面团分成小份擀成薄长方形，放馅后对折。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "皮擀得薄，炸出来才脆。，注意火候。",
      "visual_cue": "面皮匀薄，边缘整齐，状态稳定"
    },
    {
      "n": 7,
      "text": "用叉子在边缘压出纹路封口，表面刷一层蛋液。",
      "time_min": 8,
      "heat": "无火",
      "tip": "压紧封口，炸的时候馅才不会漏。，注意火候。",
      "visual_cue": "封口压痕清晰，状态稳定"
    },
    {
      "n": 8,
      "text": "植物油烧到一百八十度，下炸饺炸三分钟到金黄。",
      "time_min": 14,
      "heat": "中火",
      "tip": "油温够高，皮才迅速鼓脆不吸油。，注意火候。",
      "visual_cue": "表皮起泡，颜色金黄，状态稳定"
    },
    {
      "n": 9,
      "text": "捞出沥油，稍晾一分钟再吃。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "内馅很烫，晾一下再咬。，注意火候。",
      "visual_cue": "外壳干爽，声响清脆，状态稳定"
    }
  ],
  "tips": [
    "面皮擀薄一点，炸出来才脆。，值得留意。",
    "馅料要收干汁水，湿馅会浸破皮。，值得留意。",
    "油温一百八十度下锅，皮立刻鼓起来。，值得留意。"
  ],
  "common_mistakes": [
    "面皮擀太厚，炸完皮硬馅还凉。，值得留意。",
    "馅料太湿，炸的时候全漏油锅。，值得留意。",
    "封口没压紧，下锅就张开。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "鸡胸肉",
      "ratio": "300 克:300 克",
      "note": "口感更清淡，可多加少许盐。"
    },
    {
      "original": "面粉",
      "substitute": "木薯粉",
      "ratio": "400 克:350 克",
      "note": "皮更酥，需多加少许温水。"
    }
  ],
  "variations": [
    "馅里加奶酪丁，咬开能拉丝。，值得留意。",
    "做甜口版本，包香蕉和肉桂。，值得留意。"
  ],
  "serving_suggestion": "配一杯甘蔗汁，巴西街头的经典组合。，效果更稳定。",
  "storage": "冷冻生坯可存两周，炸前无需解冻。，效果更稳定。",
