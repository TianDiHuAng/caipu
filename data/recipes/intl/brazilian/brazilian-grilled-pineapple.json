        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "椰蓉",
          "name_en": "desiccated coconut",
          "amount": 30,
          "unit": "g",
          "note": "装饰",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "刷子",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠萝削皮后切成一厘米厚的圆片，去掉中间的硬芯。",
      "time_min": 8,
      "heat": "无火",
      "tip": "硬芯口感粗，一定要挖干净。这一步别省。",
      "visual_cue": "菠萝片厚薄均匀，中间挖空"
    },
    {
      "n": 2,
      "text": "把菠萝片平铺在厨房纸上，两面吸干表面水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "吸干水才上色，湿的只会出水。顺序别颠倒。",
      "visual_cue": "表面不挂汁，纸巾被浸湿"
    },
    {
      "n": 3,
      "text": "平底锅中火加热，放黄油化开铺满锅底。过程中注意火候变化。",
      "time_min": 3,
      "heat": "中火",
      "tip": "黄油别烧到发褐，那是焦了。火候要盯住。",
      "visual_cue": "黄油融化起泡，颜色浅黄"
    },
    {
      "n": 4,
      "text": "放入菠萝片，中火煎三分钟到底面金黄。动作要快别拖延。",
      "time_min": 4,
      "heat": "中火",
      "tip": "别急着翻，等焦痕出来再动。多练两次就熟。",
      "visual_cue": "底面焦糖色，边缘微微收缩"
    },
    {
      "n": 5,
      "text": "翻面再煎两分钟，用刷子在表面刷一层蜂蜜。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蜂蜜刷在一面就够，两面都刷会太甜。",
      "visual_cue": "表面油亮，蜂蜜被热气吸住"
    },
    {
      "n": 6,
      "text": "撒上白糖，转大火让糖在表面焦化成薄脆壳。",
      "time_min": 3,
      "heat": "大火",
      "tip": "糖一化就晃锅，别让它烧黑发苦。",
      "visual_cue": "表面出现琥珀色焦壳，香气冲鼻"
    },
    {
      "n": 7,
      "text": "关火把菠萝片取出，摆在盘里稍晾一分钟。随时观察锅里的状态。",
      "time_min": 2,
      "heat": "无火",
      "tip": "晾一分钟焦壳才脆，不烫嘴。细节决定成败。",
      "visual_cue": "焦壳反光，边缘脆硬"
    },
    {
      "n": 8,
      "text": "表面撒一层椰蓉，切三角块趁温热上桌。翻动要轻别弄碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "椰蓉最后撒，遇热太久会吸潮。这一步别省。",
      "visual_cue": "椰蓉雪白，焦壳金黄"
    }
  ],
  "tips": [
    "菠萝片务必吸干水分，才煎得出焦壳。",
    "蜂蜜只刷一面，两面刷会甜得发腻。",
    "撒糖后转大火快煎，焦壳才薄脆不糊。"
  ],
  "common_mistakes": [
    "菠萝没吸干就下锅，煎出一锅水。",
    "火太大糖烧黑，整片带苦味。顺序别颠倒。",
    "切片太薄，煎完缩成一团没有口感。"
  ],
  "substitutions": [
    {
      "original": "菠萝",
      "substitute": "香蕉",
      "ratio": "800 克:600 克",
      "note": "更软，煎的时间要缩短一半。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "30 克:30 克",
      "note": "少了花香，甜味更直接。"
    }
  ],
  "variations": [
    "撒少许辣椒粉，甜辣对比更刺激。",
    "配一球香草冰淇淋，冷热交替更好吃。"
  ],
  "serving_suggestion": "切块摆盘，表面撒椰蓉，巴西烤肉店常作为清口甜点端上桌。",
  "storage": "冷藏一天，复热用平底锅干煎一分钟恢复焦壳。",
