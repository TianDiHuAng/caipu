 "variations": [
  "加两片薄荷叶，凉感更足。，这一点很关键。",
  "兑一点气泡水，做成气泡橙汁。，这一点很关键。"
 ],
 "serving_suggestion": "配烤肉或早餐面包，冰镇更好喝。，这一点很关键。",
 "storage": "冷藏一天，喝前摇匀。，这一点很关键。",
