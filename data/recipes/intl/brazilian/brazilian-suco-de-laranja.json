  "equipment": [
    "榨汁器",
    "刀",
    "滤网",
    "大杯",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "橙子对半切开，室温放置十分钟。，看住火，别让它失控。",
      "time_min": 12,
      "heat": "无火",
      "tip": "回温后出汁率更高。，全程留意火候，别贪快。",
      "visual_cue": "果皮油亮，手感柔软"
    },
    {
      "n": 2,
      "text": "用榨汁器压出果汁，滤掉粗渣。，火大了就离锅远一点。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别压太深，白皮会发苦。，火别开太大，稳着来。",
      "visual_cue": "果汁橙黄，渣滓滤净"
    },
    {
      "n": 3,
      "text": "尝一口，按酸甜度加白糖。，锅温要匀，别忽高忽低。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先尝后加糖，免得过甜。，火力保持中等，慢慢来。",
      "visual_cue": "甜酸平衡，果香突出"
    },
    {
      "n": 4,
      "text": "加清水调稀，挤入柠檬汁提酸。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬提亮酸味，别多放。，注意锅里温度别掉下来。",
      "visual_cue": "颜色清亮，味道清爽"
    },
    {
      "n": 5,
      "text": "搅匀后冷藏半小时，倒杯时加冰块。，始终中小火，别心急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冰镇后香气更收敛。，火要均匀，食材才不糊。",
      "visual_cue": "杯壁凝水，果香清甜"
    }
  ],
  "tips": [
    "橙子回温再榨，出汁更多。，这是关键点。",
    "白皮别压破，会发苦。，别嫌麻烦，做完它。",
    "柠檬汁只提味，放多就抢戏。，这一步别省。"
  ],
  "common_mistakes": [
    "橙子刚从冰箱拿出就榨，出汁少。，别跳过这步。",
    "压到底部白皮，果汁发苦。，这步最关键。",
    "糖一次加太多，甜得发腻。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "橙子",
      "substitute": "青柠",
      "ratio": "6 个:8 个",
      "note": "酸味更冲，糖加到三十克。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "20 克:25 克",
      "note": "香气更柔，需先化开。"
    }
  ],
  "variations": [
    "加两片薄荷叶，凉感更足。，这里最容易翻车。",
    "兑一点气泡水，做成气泡橙汁。，别小看这一步。"
  ],
  "serving_suggestion": "配烤肉或早餐面包，冰镇更好喝。，成败就在这一步。",
  "storage": "冷藏一天，喝前摇匀。，这点要注意。",
