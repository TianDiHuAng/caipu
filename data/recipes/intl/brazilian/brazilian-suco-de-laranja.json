 "steps": [
  {
   "n": 1,
   "text": "橙子对半切开，室温放置十分钟。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "回温后出汁率更高。，火候要稳，别忽大忽小。",
   "visual_cue": "果皮油亮，手感柔软"
  },
  {
   "n": 2,
   "text": "用榨汁器压出果汁，滤掉粗渣。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "无火",
   "tip": "别压太深，白皮会发苦。，火候要稳，别忽大忽小。",
   "visual_cue": "果汁橙黄，渣滓滤净"
  },
  {
   "n": 3,
   "text": "尝一口，按酸甜度加白糖。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "先尝后加糖，免得过甜。，火候要稳，别忽大忽小。",
   "visual_cue": "甜酸平衡，果香突出"
  },
  {
   "n": 4,
   "text": "加清水调稀，挤入柠檬汁提酸。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "柠檬提亮酸味，别多放。，火候要稳，别忽大忽小。",
   "visual_cue": "颜色清亮，味道清爽"
  },
  {
   "n": 5,
   "text": "搅匀后冷藏半小时，倒杯时加冰块。，火候要稳，别忽大忽小。",
   "time_min": 32,
   "heat": "无火",
   "tip": "冰镇后香气更收敛。，火候要稳，别忽大忽小。",
   "visual_cue": "杯壁凝水，果香清甜"
  }
 ],
 "tips": [
  "橙子回温再榨，出汁更多。，这一点很关键。",
  "白皮别压破，会发苦。，这一点很关键。",
  "柠檬汁只提味，放多就抢戏。，这一点很关键。"
 ],
 "common_mistakes": [
  "橙子刚从冰箱拿出就榨，出汁少。，这一点很关键。",
  "压到底部白皮，果汁发苦。，这一点很关键。",
  "糖一次加太多，甜得发腻。，这一点很关键。"
 ],
