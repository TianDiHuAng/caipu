  "equipment": [
    "烤箱",
    "烤模",
    "料理机",
    "大碗",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "胡萝卜切块后与植物油一起放进料理机打成细泥。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打得越细，蛋糕体才越润。，注意火候。",
      "visual_cue": "泥体顺滑，颜色橙亮，状态稳定"
    },
    {
      "n": 2,
      "text": "鸡蛋加白糖，用打蛋器打到颜色发浅略发泡。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打到泛白，蛋糕才蓬松。，注意火候。",
      "visual_cue": "蛋液泛白，体积变大，状态稳定"
    },
    {
      "n": 3,
      "text": "把胡萝卜泥倒进蛋液里，搅到完全混合。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "分两次加，混合才均匀。，注意火候。",
      "visual_cue": "颜色橙黄，无分层，状态稳定"
    },
    {
      "n": 4,
      "text": "面粉、酵母和盐一起过筛，分两次拌进糊里。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用刮刀翻拌，别画圈搅出面筋。，注意火候。",
      "visual_cue": "面糊细腻，无干粉，状态稳定"
    },
    {
      "n": 5,
      "text": "倒入抹过油的烤模，震两下排出大气泡。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "震出气泡，切面才平整。，注意火候。",
      "visual_cue": "表面平整，气泡上浮，状态稳定"
    },
    {
      "n": 6,
      "text": "一百八十度烤三十五分钟，竹签插入无黏糊即可。",
      "time_min": 35,
      "heat": "-",
      "tip": "中途别开门，温度一降就塌。，注意火候。",
      "visual_cue": "表面金黄，竹签干爽，状态稳定"
    },
    {
      "n": 7,
      "text": "可可粉、牛奶、黄油和两勺白糖小火煮成淋面。",
      "time_min": 5,
      "heat": "小火",
      "tip": "边煮边搅，淋面才顺滑不结块。，注意火候。",
      "visual_cue": "酱体发亮，流动顺滑，状态稳定"
    },
    {
      "n": 8,
      "text": "蛋糕稍晾后淋上可可酱，静置十分钟定型。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "温热的时候淋，酱才贴得住。，注意火候。",
      "visual_cue": "表面光滑，酱层均匀，状态稳定"
    }
  ],
  "tips": [
    "胡萝卜打成细泥，蛋糕体才润不粗糙。，值得留意。",
    "蛋液打到泛白，蓬松感才好。，值得留意。",
    "面粉用刮刀翻拌，别搅出面筋。，值得留意。"
  ],
  "common_mistakes": [
    "胡萝卜切碎直接拌，吃起来有颗粒。，值得留意。",
    "面粉搅太久，蛋糕又硬又实。，值得留意。",
    "烤好立刻脱模，蛋糕全散掉。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "可可粉",
      "substitute": "黑巧克力",
      "ratio": "40 克:60 克",
      "note": "需熔化后使用，甜度更低。"
    },
    {
      "original": "植物油",
      "substitute": "黄油",
      "ratio": "120 毫升:130 克",
      "note": "香气更浓，需熔化后使用。"
    }
  ],
  "variations": [
    "淋面上撒少许海盐，甜咸更有层次。，值得留意。",
    "蛋糕体加一勺橙皮屑，香气更清。，值得留意。"
  ],
  "serving_suggestion": "切块配一杯黑咖啡，下午茶最合适。，效果更稳定。",
  "storage": "冷藏三天，食用前回温十分钟。，效果更稳定。",
