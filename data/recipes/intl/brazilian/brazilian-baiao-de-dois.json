  "equipment": [
    "炒锅",
    "木勺",
    "刀",
    "电饭锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑豆提前泡一夜后煮到软烂，沥干水分备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆子煮到一捏就烂，拌饭才不硌牙。",
      "visual_cue": "豆粒软糯，无硬芯"
    },
    {
      "n": 2,
      "text": "培根和香肠切成小丁，洋葱和大蒜切碎待用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切得大小一致，炒出来的口感才整齐。",
      "visual_cue": "丁粒均匀，蒜末细碎"
    },
    {
      "n": 3,
      "text": "炒锅放橄榄油，先下培根丁用小火慢慢煸出油脂。",
      "time_min": 6,
      "heat": "小火",
      "tip": "培根慢慢煸，油脂出来才有底味。",
      "visual_cue": "培根卷边，油脂清亮"
    },
    {
      "n": 4,
      "text": "加入香肠片和洋葱碎炒两分钟，再下大蒜末炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "大蒜末要在最后下锅，避免炒糊发苦。",
      "visual_cue": "洋葱透明，香气上浮"
    },
    {
      "n": 5,
      "text": "倒入黑豆翻炒两分钟，用勺背压碎一部分豆子让汤汁变浓。",
      "time_min": 4,
      "heat": "中火",
      "tip": "用勺背压碎一部分豆子，饭体才黏得住。",
      "visual_cue": "汤汁微稠，豆香浓"
    },
    {
      "n": 6,
      "text": "加入熟米饭翻拌均匀，再撒盐和黑胡椒调味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米饭要分次加入，拌开才不会结成块。",
      "visual_cue": "米粒均匀裹上豆汁"
    },
    {
      "n": 7,
      "text": "关火拌入奶酪丁和香菜末，盖盖焖两分钟再盛盘。",
      "time_min": 4,
      "heat": "无火",
      "tip": "靠余温慢慢化开奶酪，香味才均匀柔和。",
      "visual_cue": "奶酪微融，表面点缀绿末"
    }
  ],
  "tips": [
    "黑豆煮到一捏就烂，拌进饭里才绵软。",
    "压碎一部分豆子，饭体更黏更有豆香。",
    "奶酪在关火后拌入，靠余温化开最香。"
  ],
  "common_mistakes": [
    "黑豆没提前泡就直接煮，煮很久还带硬芯。",
    "米饭太湿，拌完之后变成一锅稠糊。",
    "奶酪一开始就下锅，化开后全粘在锅底。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "风干牛肉",
      "ratio": "100 克:90 克",
      "note": "咸香更浓，需减盐。"
    },
    {
      "original": "奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "60 克:70 克",
      "note": "拉丝效果更好。"
    }
  ],
  "variations": [
    "加一把切碎的太阳能晒牛肉，风味更像巴西东北部版本。",
    "用剩烤肉切丁替代培根，肉香更足。"
  ],
  "serving_suggestion": "盛在深盘里撒香菜，配一份烤肉和辣酱，是巴西东北部的家常主食。",
  "storage": "冷藏两天，复热时加少量清水用小火翻炒，避免干硬。",
