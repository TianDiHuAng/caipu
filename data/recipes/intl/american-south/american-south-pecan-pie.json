  "equipment": [
    "烤箱",
    "派盘",
    "盆",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和黄油丁，用手搓成粗砂状，倒入六十毫升清水揉成团冷藏三十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "黄油保持冷，搓出的颗粒才让派皮起酥。",
      "visual_cue": "面团成团且不粘手"
    },
    {
      "n": 2,
      "text": "面团擀成三毫米圆片，铺进派盘压实，边缘捏出花边，冷藏十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "派皮贴紧盘边不留空隙，烤完才不会缩。",
      "visual_cue": "派皮服帖，边缘整齐"
    },
    {
      "n": 3,
      "text": "鸡蛋打散加红糖、白糖、蜂蜜和盐，搅到糖基本化开。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别打出太多泡，泡泡烤完会成蜂窝孔。",
      "visual_cue": "蛋液浓稠，糖粒基本消失"
    },
    {
      "n": 4,
      "text": "加肉桂搅匀，核桃仁铺进派皮，把蛋液缓缓倒进去没过核桃。",
      "time_min": 5,
      "heat": "无火",
      "tip": "核桃先铺再倒液，受热更均匀不上浮。",
      "visual_cue": "核桃均匀分布，液面平整"
    },
    {
      "n": 5,
      "text": "烤箱一百七十五度烤五十分钟，中间轻转一次让上色均匀。",
      "time_min": 50,
      "heat": "中火",
      "tip": "烤到中心轻晃只有轻微晃动即可出炉。",
      "visual_cue": "表面结皮呈琥珀色"
    },
    {
      "n": 6,
      "text": "出炉彻底放凉两小时再切，让内馅凝固定型。",
      "time_min": 20,
      "heat": "无火",
      "tip": "热切一定流馅，凉透才切得整齐。",
      "visual_cue": "内馅凝固，切口平整不流"
    }
  ],
  "tips": [
    "黄油和冰水是派皮起酥的关键，全程别让面团回温。",
    "内馅别打进太多气泡，否则表面会成蜂窝。",
    "必须凉透再切，热切内馅会流一盘。"
  ],
  "common_mistakes": [
    "派皮搓过头，烤完硬得像一块饼干。",
    "内馅没有完全烤透，切开还是稀的。",
    "热切派，核桃和糖浆全散在盘子。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "红糖浆",
      "ratio": "60 克:70 克",
      "note": "颜色更深，甜度更高需减糖。"
    },
    {
      "original": "核桃",
      "substitute": "碧根果",
      "ratio": "220 克:220 克",
      "note": "更接近原版，香气更柔和。"
    }
  ],
  "variations": [
    "表面撒一层海盐，甜咸对比更明显。",
    "加一勺威士忌进蛋液，香气更有层次。"
  ],
  "serving_suggestion": "切块配一球香草冰淇淋或一坨打发奶油，再来一杯不加糖的黑咖啡。",
  "storage": "密封冷藏三天，回温后一百五十度烤五分钟恢复酥脆。",
