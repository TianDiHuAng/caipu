  "equipment": [
    "平底锅",
    "三个浅盘",
    "刀",
    "砧板",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青番茄洗净去蒂，切成一点二厘米厚的圆片。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "青番茄硬才好切，太熟会散。，注意火候。",
      "visual_cue": "切片匀厚，边缘完整，状态稳定"
    },
    {
      "n": 2,
      "text": "番茄片两面撒盐和黑胡椒，静置五分钟出水。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先撒盐出水，裹粉才挂得牢。，注意火候。",
      "visual_cue": "表面微湿，水珠渗出，状态稳定"
    },
    {
      "n": 3,
      "text": "面粉里拌入辣椒粉，另备蛋液和面包糠分装三盘。",
      "time_min": 5,
      "heat": "无火",
      "tip": "三盘按顺序摆好，操作起来才顺。，注意火候。",
      "visual_cue": "三盘就位，粉料均匀，状态稳定"
    },
    {
      "n": 4,
      "text": "番茄片先裹面粉，再蘸蛋液，最后压上一层面包糠。",
      "time_min": 10,
      "heat": "无火",
      "tip": "手轻压让糠粘紧，炸时才不掉。，注意火候。",
      "visual_cue": "外层均匀，无裸露，状态稳定"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油烧到一百七十度，放入番茄片中火煎。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油到番茄片一半高就够，不用深炸。，注意火候。",
      "visual_cue": "油面起泡，边缘定型，状态稳定"
    },
    {
      "n": 6,
      "text": "一面煎三分钟到金黄，翻面再煎两分钟。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "只翻一次，外壳才完整。，注意火候。",
      "visual_cue": "两面金黄，外壳酥脆，状态稳定"
    },
    {
      "n": 7,
      "text": "捞出放厨房纸吸油，配蛋黄酱趁热吃。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "稍晾一分钟再咬，内里很烫。，注意火候。",
      "visual_cue": "表面干爽，油已吸走，状态稳定"
    }
  ],
  "tips": [
    "青番茄要挑硬的，切开才不会散。，值得留意。",
    "先撒盐出水，裹粉才挂得牢。，值得留意。",
    "油到番茄片一半高就够，不必深炸。，值得留意。"
  ],
  "common_mistakes": [
    "番茄太熟，下锅就软成一摊。，值得留意。",
    "裹粉没压实，炸完外壳全掉锅里。，值得留意。",
    "油温不够，外壳吸油发腻。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "面包糠",
      "substitute": "玉米面",
      "ratio": "120 克:100 克",
      "note": "颗粒更粗，口感更脆。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "80 克:80 克",
      "note": "酸味更清，可加少许盐。"
    }
  ],
  "variations": [
    "蘸酱里拌入辣酱，酸辣更过瘾。，值得留意。",
    "表面撒少许帕玛森奶酪，香气更浓。，值得留意。"
  ],
  "serving_suggestion": "当前菜或配汉堡吃，蘸酱里加辣酱更地道。，效果更稳定。",
  "storage": "现做现吃，冷藏后复热外壳会软。，效果更稳定。",
