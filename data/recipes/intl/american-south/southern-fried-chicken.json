  "steps": [
    {
      "n": 1,
      "text": "牛奶加柠檬汁静置五分钟成酪乳状，放入鸡腿肉块、蒜末与一半盐腌二十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "酸性奶让鸡肉更嫩。",
      "visual_cue": "奶液微稠、鸡块浸透"
    },
    {
      "n": 2,
      "text": "面粉、淀粉、辣椒粉、黑胡椒与剩余盐混匀成裹粉，鸡块捞出沥掉多余奶液。",
      "time_min": 10,
      "heat": "无火",
      "tip": "粉料混匀，裹层才均匀。",
      "visual_cue": "粉料均匀、鸡块湿而不滴"
    },
    {
      "n": 3,
      "text": "植物油倒入深锅烧到 170℃，鸡腿肉块裹粉压实后抖掉多余干粉，分两批下锅。",
      "time_min": 8,
      "heat": "中火",
      "tip": "压一下粉，炸衣才贴肉。",
      "visual_cue": "粉层贴紧、油面翻泡"
    },
    {
      "n": 4,
      "text": "每批炸八分钟至深金黄、外壳硬脆，捞出沥油静置三分钟再上桌。",
      "time_min": 6,
      "heat": "中火",
      "tip": "静置让内部余温收尾。",
      "visual_cue": "外壳深金、敲击有声"
    }
  ],
  "tips": [
    "牛奶加柠檬汁做简易酪乳，腌出的鸡肉更嫩更多汁。",
    "裹粉要压实再抖掉多余干粉，炸衣才贴肉不掉。",
    "油量不多就分两批炸，锅温稳定外壳才脆。"
  ],
  "common_mistakes": [
    "鸡块湿着裹粉就炸，炸衣整片脱落。",
    "油温太低就下锅，炸出来油润发软。",
    "一次全下锅，油温骤降，成品又油又白。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "700g 对 800g",
      "note": "炸制时间减到 7 分钟。"
    },
    {
      "original": "牛奶",
      "substitute": "酸奶",
      "ratio": "200ml 对 200g",
      "note": "酸度更高，腌 15 分钟即可。"
    }
  ],
  "variations": [
    "辣味版：裹粉里辣椒粉加倍，另加 5g 辣椒粉撒面。",
    "烤箱版：200℃ 烤二十五分钟，中途翻面。"
  ],
  "serving_suggestion": "配土豆泥、肉汁与凉拌卷心菜，再来一杯冰红茶。",
  "storage": "冷藏可存 2 天，复热 200℃ 烤 6 分钟恢复脆皮。",
