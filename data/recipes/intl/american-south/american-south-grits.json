  "equipment": [
    "汤锅",
    "打蛋器",
    "量杯",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "清水加盐在汤锅里烧开，烧到锅底冒密集小泡。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水要彻底烧开再下糁，否则会结块。",
      "visual_cue": "水面翻滚，蒸汽上升"
    },
    {
      "n": 2,
      "text": "一边搅一边慢慢撒入玉米糁，全部撒完再搅三十秒防结块。",
      "time_min": 4,
      "heat": "中火",
      "tip": "糁要一点点撒，倒快了立刻成疙瘩。",
      "visual_cue": "粥体顺滑，无干粉块"
    },
    {
      "n": 3,
      "text": "转小火盖盖煮二十五分钟，每五分钟开盖搅一次。",
      "time_min": 27,
      "heat": "小火",
      "tip": "一定要勤搅，糁沉底很容易糊锅。",
      "visual_cue": "粥体浓稠，铲过留痕"
    },
    {
      "n": 4,
      "text": "倒入牛奶后用小火继续煮五分钟，边倒边搅匀。",
      "time_min": 6,
      "heat": "小火",
      "tip": "牛奶要后加，煮久了会起膜发腥。",
      "visual_cue": "粥色乳白，质地顺滑"
    },
    {
      "n": 5,
      "text": "关火后拌入黄油和奶酪，一直搅到完全融化。",
      "time_min": 3,
      "heat": "无火",
      "tip": "一定要趁热拌，凉了黄油就化不开。",
      "visual_cue": "表面油亮，奶酪拉丝"
    },
    {
      "n": 6,
      "text": "盛进碗里撒上现磨黑胡椒，趁热端上桌趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "黑胡椒要在最后撒，香气才不会散。",
      "visual_cue": "粥面细腻，胡椒点缀"
    }
  ],
  "tips": [
    "糁要一点点撒进开水，边撒边搅才不会结块。",
    "全程小火并勤加搅拌，锅底才不会糊。",
    "黄油和奶酪在关火后再拌，奶香更足。"
  ],
  "common_mistakes": [
    "糁一次性全倒进去，整锅结成大疙瘩。",
    "火太大又不搅拌，锅底糊出焦苦味。",
    "牛奶一开始就下锅，久煮起膜并带腥味。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "300 毫升:300 毫升",
      "note": "更清爽，需增十克黄油补香。"
    },
    {
      "original": "奶酪",
      "substitute": "淡奶油",
      "ratio": "60 克:50 毫升",
      "note": "更顺滑，奶味更浓。"
    }
  ],
  "variations": [
    "上面卧一只煎蛋，就是美南常见的全套早餐。",
    "拌入煎香的小虾仁，做成经典的口味组合。"
  ],
  "serving_suggestion": "盛在宽口碗里，配煎蛋、培根和一杯黑咖啡，是美南早晨的标准配置。",
  "storage": "冷藏两天，复热加少量清水小火搅匀，避免结块。",
