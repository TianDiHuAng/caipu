  "steps": [
    {
      "n": 1,
      "text": "秋葵洗净擦干后切两厘米段，番茄切滚刀块备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "秋葵切好别久放，出水后黏液会变多。",
      "visual_cue": "秋葵段干爽，番茄块完整"
    },
    {
      "n": 2,
      "text": "厚底锅倒植物油，下培根小火煸到出油微脆。",
      "time_min": 5,
      "heat": "小火",
      "tip": "培根煸出油，整锅菜的底味就有了。",
      "visual_cue": "培根卷曲出油，锅底油亮"
    },
    {
      "n": 3,
      "text": "下洋葱丁与蒜末炒到洋葱透明，加番茄块炒出汁。",
      "time_min": 8,
      "heat": "中火",
      "tip": "番茄要炒到塌软出沙，汤汁才自然浓稠。",
      "visual_cue": "番茄化成泥，锅中有红色汤汁"
    },
    {
      "n": 4,
      "text": "下秋葵段翻匀，倒清水盖盖小火焖十五分钟。",
      "time_min": 16,
      "heat": "小火",
      "tip": "秋葵焖久一点黏液会融进汤里，汤汁自然稠。",
      "visual_cue": "秋葵变软，汤汁浓稠挂勺"
    },
    {
      "n": 5,
      "text": "加盐、白糖、黑胡椒与米醋调味，再煮三分钟即可。",
      "time_min": 4,
      "heat": "小火",
      "tip": "醋最后加，酸味清爽，也能压住秋葵的青味。",
      "visual_cue": "汤汁红亮微酸，秋葵软而不烂"
    }
  ],
  "tips": [
    "秋葵的黏液是天然的勾芡，别用水冲掉。",
    "番茄要炒到出沙，汤汁才浓得自然。",
    "加一点米醋，能把整体的味道提亮。",
    "配白饭或玉米面包，浇汁都很下饭。"
  ],
  "common_mistakes": [
    "秋葵焯水后再焖，黏液全没了汤也寡淡。",
    "番茄没炒出汁就加水，汤色发白发淡。",
    "焖的时间太短，秋葵咬着还是硬邦邦。",
    "白糖放太多，整锅菜变成一道甜汤。"
  ],
  "substitutions": [
    {
      "original": "秋葵",
      "substitute": "四季豆",
      "ratio": "450克:450克",
      "note": "无黏液，需多焖五分钟。"
    },
    {
      "original": "培根",
      "substitute": "烟熏香肠",
      "ratio": "50克:60克",
      "note": "咸度更高，盐减两克。"
    }
  ],
  "variations": [
    "加一把甜玉米粒同焖，甜味更足也更好看。",
    "加半勺辣椒粉同焖，微辣的口味更开胃。",
    "加几只虾仁同焖，就变成海鲜版本了。"
  ],
  "serving_suggestion": "盛在深盘里，浇在白饭上，配一片玉米面包蘸汁，是很朴素却舒服的一餐。",
  "storage": "冷藏可放两天，复热用小火加少量清水慢加热，避免糊底。",
