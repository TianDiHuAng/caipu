  "steps": [
    {
      "n": 1,
      "text": "秋葵冲洗干净后彻底擦干，切成一厘米厚的斜片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一定擦干再切，水遇热油会剧烈溅起。",
      "visual_cue": "切片干净不拉丝，盘面干爽"
    },
    {
      "n": 2,
      "text": "秋葵片浸入酪乳抓匀，静置五分钟让表面挂上稠液。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酪乳带酸，能压秋葵的黏液，也帮粉挂得牢。",
      "visual_cue": "秋葵片表面挂满乳白稠液"
    },
    {
      "n": 3,
      "text": "玉米面、面粉、盐、黑胡椒与辣椒粉混匀，把秋葵片逐片裹上干粉。",
      "time_min": 7,
      "heat": "无火",
      "tip": "裹好后抖掉多余干粉，炸时油才不浑浊。",
      "visual_cue": "每片均匀挂粉，不结厚块"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到一百七十五度，分批下秋葵炸三分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一次别下太多，油温掉了外皮就吸油发软。",
      "visual_cue": "油面气泡密集，秋葵浮起"
    },
    {
      "n": 5,
      "text": "炸到金黄后捞出放厨房纸上沥油，趁热再撒少许盐即可。",
      "time_min": 4,
      "heat": "中火",
      "tip": "趁热撒盐才粘得住，凉了就挂不上。",
      "visual_cue": "外壳金黄酥脆，纸巾吸出油印"
    }
  ],
  "tips": [
    "秋葵一定要干，带水下油锅非常危险。",
    "酪乳浸过再裹粉，外壳更厚更脆。",
    "玉米面比纯面粉脆，两者混着用效果最好。",
    "炸好立刻上桌，放凉之后外壳就会回软。"
  ],
  "common_mistakes": [
    "秋葵带水下锅，油花四溅还崩皮。",
    "油温太低，炸出来一咬就是一口油。",
    "一次倒半锅秋葵，油温骤降全粘一起。",
    "裹好粉放太久，粉回潮了炸不脆。"
  ],
  "substitutions": [
    {
      "original": "秋葵",
      "substitute": "西葫芦",
      "ratio": "500克:500克",
      "note": "水分多，切片后需多擦一次。"
    },
    {
      "original": "酪乳",
      "substitute": "牛奶",
      "ratio": "200毫升:200毫升",
      "note": "加一小勺米醋静置五分钟代用。"
    }
  ],
  "variations": [
    "加一勺卡真调料粉，风味更辣更有层次。",
    "改成空气炸锅二百度烤十二分钟，油更少。",
    "配一碟辣味蛋黄酱蘸着吃，最对味。"
  ],
  "serving_suggestion": "趁热堆在小筐里，撒一层盐，配炸鸡与柠檬水，是美南午后最常见的一份小吃。",
  "storage": "当餐吃完最好，冷藏不超过一天，复热用二百度烤箱烤五分钟可恢复脆度。",
