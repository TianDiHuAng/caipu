  "equipment": [
    "汤锅",
    "擀面杖",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉冷水下锅，加洋葱、芹菜和胡萝卜。，先试试温度，香气才留得住。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷水下锅，汤才清。，顺序照着来，口感才不散。",
      "visual_cue": "水面没过鸡肉，蔬菜铺底"
    },
    {
      "n": 2,
      "text": "大火煮开撇去浮沫，转小火煮三十分钟。，汤汁别收太干，香气才不跑。",
      "time_min": 33,
      "heat": "小火",
      "tip": "撇净浮沫，汤才不浑。，汤汁别收太干，咸淡才好把握。",
      "visual_cue": "汤色清亮，浮沫去尽，别急着加油，锅气才足。"
    },
    {
      "n": 3,
      "text": "捞出鸡肉去骨撕成粗条，汤留着。，起锅前尝味，香气才不跑。",
      "time_min": 10,
      "heat": "无火",
      "tip": "撕成条，口感才好。，别用力搅，口感才不散。",
      "visual_cue": "肉条粗短，骨已去净，手法轻些，成品才稳当。"
    },
    {
      "n": 4,
      "text": "面粉加泡打粉和盐混匀，化黄油切进粉里。，别急着加油，细节才到位。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油要冷，搓出小颗粒。，慢慢来别急，口感才不发柴。",
      "visual_cue": "粉呈粗砂状，握起成团，火别太大，口感才有层次。"
    },
    {
      "n": 5,
      "text": "倒牛奶揉成软面团，盖布醒十分钟。，料别一次下太多，味道才进得去。",
      "time_min": 13,
      "heat": "无火",
      "tip": "揉到不见干粉就停。，时间掐准，形状才完整。",
      "visual_cue": "面团柔软，表面光滑，锅温要匀，成品才稳当。"
    },
    {
      "n": 6,
      "text": "鸡汤煮沸，面团分小团下锅。，保持小火，味道才进得去。",
      "time_min": 6,
      "heat": "中火",
      "tip": "团别太大，中心才熟。，注意别烧干，口感才有层次。",
      "visual_cue": "面团结实，汤面冒泡，先试试温度，细节才到位。"
    },
    {
      "n": 7,
      "text": "盖盖小火煮二十分钟，中途别搅。，慢慢来别急，吃口才舒服。",
      "time_min": 22,
      "heat": "小火",
      "tip": "别搅，面团才不散。，保持小火，火候才均匀。",
      "visual_cue": "面疙瘩浮起，体积膨大，别急着加油，颜色才够亮。"
    },
    {
      "n": 8,
      "text": "鸡肉放回锅里，加盐和黑胡椒调味。，火别太大，风味才干净。",
      "time_min": 5,
      "heat": "小火",
      "tip": "肉最后放，才不柴。，注意别烧干，整道菜才立得住。",
      "visual_cue": "汤体微稠，肉条回软，下手别慌，颜色才够亮。"
    },
    {
      "n": 9,
      "text": "撒小葱末，连汤带面盛碗。，锅温要匀，口感才有层次。",
      "time_min": 4,
      "heat": "无火",
      "tip": "汤汁要宽，面才润。，顺序照着来，火候才均匀。",
      "visual_cue": "葱末翠绿，汤面油亮，时间掐准，咸淡才好把握。"
    }
  ],
  "tips": [
    "面团别揉太硬，煮出来才松。，起锅前尝味，形状才完整。",
    "下锅后别搅，面团容易散。，起锅前尝味，食材才不糊。",
    "鸡汤撇净浮沫，汤色才清。，锅温要匀，风味才干净。"
  ],
  "common_mistakes": [
    "面团太湿，下锅就化。，下手别慌，口感才不散。",
    "中途搅拌，面疙瘩散成糊。，盖盖焖一会儿，食材才不糊。",
    "鸡肉煮过头，撕出来发柴。，汤汁别收太干，吃口才舒服。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "整鸡",
      "ratio": "800 克:1200 克",
      "note": "汤更香，煮制时间加十分钟。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "120 毫升:110 毫升",
      "note": "面团稍硬，可加黄油十克。"
    }
  ],
  "variations": [
    "加一勺黑胡椒，辛香更足。，份量心里有数，表面才漂亮。",
    "面团里加香草碎，风味更清新。，火别太大，香气才不跑。"
  ],
  "serving_suggestion": "盛深碗，撒黑胡椒和葱花。，别急着加油，食材才不糊。",
  "storage": "冷藏两天，复热加鸡汤。，下手别慌，风味才干净。",
