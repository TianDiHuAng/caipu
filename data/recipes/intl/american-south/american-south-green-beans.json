  "equipment": [
    "汤锅",
    "锅铲",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆角掐去两头，掰成约五厘米长的段，冲洗干净沥水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "掰断比刀切更容易入味。",
      "visual_cue": "豆角段长短一致，表面无老筋"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，小火放入培根条慢慢煸出油脂。",
      "time_min": 5,
      "heat": "小火",
      "tip": "冷锅下培根，油才能慢慢逼出来。",
      "visual_cue": "培根卷边，锅底有一层油"
    },
    {
      "n": 3,
      "text": "加入洋葱丝与大蒜，中火炒到洋葱变软出香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒透，整锅的底味才够厚。",
      "visual_cue": "洋葱变软透明，蒜香明显"
    },
    {
      "n": 4,
      "text": "倒入豆角段翻炒两分钟，让每根都裹上油脂。",
      "time_min": 2,
      "heat": "中火",
      "tip": "先炒过再炖，豆角不会水塌塌。",
      "visual_cue": "豆角颜色转为深绿"
    },
    {
      "n": 5,
      "text": "倒入两百毫升清水，小火盖盖焖二十五分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "水量刚没过一半就好，久焖才软糯。",
      "visual_cue": "汤汁减半，豆角明显变软"
    },
    {
      "n": 6,
      "text": "加盐与黑胡椒调味，开盖收汁两分钟即可上桌。",
      "time_min": 2,
      "heat": "中火",
      "tip": "培根带咸味，盐要少放慢慢试。",
      "visual_cue": "汤汁浓稠，挂在豆角上"
    }
  ],
  "tips": [
    "豆角必须焖到完全变软，生豆角不能吃。",
    "用培根煸出的油炒洋葱，香味更统一。",
    "最后收汁别收太干，留点汤汁拌饭最好。"
  ],
  "common_mistakes": [
    "豆角只炒不焖，嚼起来又硬又生。",
    "水一次加得太多，最后煮成一锅汤水。",
    "盐下得太早又放多，整锅咸得发苦。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "猪颈肉",
      "ratio": "80 克:100 克",
      "note": "切薄片先煸出油，风味接近。"
    },
    {
      "original": "豆角",
      "substitute": "扁豆",
      "ratio": "450 克:450 克",
      "note": "焖制时间可缩短五分钟。"
    }
  ],
  "variations": [
    "加两个土豆块同焖，吸饱汤汁更香。",
    "丢一根干辣椒进去，微辣更下饭。"
  ],
  "serving_suggestion": "配玉米面包和烤肉一起上桌，是南方餐桌的标配。",
  "storage": "冷藏三天，复热加两勺清水小火焖热。",
