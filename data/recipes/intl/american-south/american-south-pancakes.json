  "steps": [
    {
      "n": 1,
      "text": "面粉、白糖、泡打粉和盐一起过筛。，时间掐准，口感才有层次。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛一次，饼才松软。，注意别烧干，颜色才够亮。",
      "visual_cue": "粉质细腻，无结块，时间掐准，香气才不跑。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加牛奶和融化黄油搅匀。，顺序照着来，整道菜才立得住。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油温着倒，才不结块。，动作放连贯，味道才不闷。",
      "visual_cue": "液体顺滑，油花均匀，锅温要匀，口感才不散。"
    },
    {
      "n": 3,
      "text": "液体倒进粉里，搅到刚好看不见干粉。，下手别慌，吃口才舒服。",
      "time_min": 4,
      "heat": "无火",
      "tip": "有小结块也别再搅，起筋就硬。，时间掐准，细节才到位。",
      "visual_cue": "糊体稠厚，能缓慢流下，先试试温度，火候才均匀。"
    },
    {
      "n": 4,
      "text": "静置十分钟，让泡打粉起效。，手法轻些，锅气才足。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置后气泡才足。，保持小火，食材才不糊。",
      "visual_cue": "表面出现小气泡，汤汁别收太干，表面才漂亮。"
    },
    {
      "n": 5,
      "text": "平底锅刷一层植物油，中小火烧热。，手法轻些，口感才不散。",
      "time_min": 3,
      "heat": "中火",
      "tip": "锅别太热，不然外面焦里面生。，翻动放轻，成品才稳当。",
      "visual_cue": "锅面微冒烟，油光薄，动作放连贯，颜色才够亮。"
    },
    {
      "n": 6,
      "text": "舀一勺糊倒入锅中，摊成圆饼。，份量心里有数，口感才不发柴。",
      "time_min": 4,
      "heat": "中火",
      "tip": "一勺一张，大小才一致。，动作放连贯，火候才均匀。",
      "visual_cue": "面糊摊开，边缘定型，火别太大，锅气才足。"
    },
    {
      "n": 7,
      "text": "表面起泡后翻面，再煎一分钟。，时间掐准，锅气才足。",
      "time_min": 4,
      "heat": "中火",
      "tip": "看到气泡再翻，才不粘。，动作放连贯，咸淡才好把握。",
      "visual_cue": "两面金黄，饼身鼓起，动作放连贯，整道菜才立得住。"
    },
    {
      "n": 8,
      "text": "叠盘保温，淋蜂蜜上桌。，动作放连贯，锅气才足。，动作放连贯，成品才稳当。",
      "time_min": 4,
      "heat": "无火",
      "tip": "叠着放，饼才不凉。，盖盖焖一会儿，表面才漂亮。",
      "visual_cue": "表面金黄，蜂蜜流下，起锅前尝味，咸淡才好把握。"
    }
  ],
  "tips": [
    "面糊别搅过头，起筋就硬。，锅温要匀，食材才不糊。",
    "静置十分钟，饼才松软。，注意别烧干，口感才不散。",
    "表面起泡再翻面，最稳。，先试试温度，整道菜才立得住。"
  ],
  "common_mistakes": [
    "面糊太稀，摊开就破。，锅温要匀，吃口才舒服。",
    "锅太热，外面焦里面生。，份量心里有数，口感才不散。",
    "反复翻面，饼身塌陷。，下手别慌，细节才到位。"
  ],
