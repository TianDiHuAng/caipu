  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和一半黄油搓成粗砂状。，别用力搅，风味才干净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，才搓得出层。，保持小火，颜色才够亮。",
      "visual_cue": "粉呈颗粒，握之成团，顺序照着来，味道才不闷。"
    },
    {
      "n": 2,
      "text": "加少量冷水揉成团，冷藏二十分钟。，火别太大，味道才进得去。",
      "time_min": 22,
      "heat": "无火",
      "tip": "别揉太久，起筋就硬。，份量心里有数，火候才均匀。",
      "visual_cue": "面团光滑，手感凉，起锅前尝味，味道才进得去。"
    },
    {
      "n": 3,
      "text": "面团擀成圆片，铺进派盘压边。，别急着加油，成品才稳当。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边要压实，烤时才不缩。，翻动放轻，整道菜才立得住。",
      "visual_cue": "派皮贴合，边缘整齐，先试试温度，形状才完整。"
    },
    {
      "n": 4,
      "text": "鸡蛋加白糖打散，打到糖粒化开。，料别一次下太多，成品才好看。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糖要打化，切面才细。，留意锅底，成品才稳当。",
      "visual_cue": "蛋液发白，质地稠，火别太大，细节才到位。"
    },
    {
      "n": 5,
      "text": "加玉米面、牛奶、柠檬汁和肉桂粉拌匀。，汤汁别收太干，形状才完整。",
      "time_min": 5,
      "heat": "无火",
      "tip": "柠檬汁去腥，别省。，翻动放轻，细节才到位。",
      "visual_cue": "馅体顺滑，微带酸香，别急着加油，口感才有层次。"
    },
    {
      "n": 6,
      "text": "倒入融化黄油搅匀，静置五分钟。，别用力搅，成品才稳当。",
      "time_min": 7,
      "heat": "无火",
      "tip": "黄油温着倒，才不分离。，手法轻些，香气才不跑。",
      "visual_cue": "表面浮油，馅体发亮，时间掐准，成品才好看。"
    },
    {
      "n": 7,
      "text": "馅倒进派皮，烤箱一百八十度烤四十分钟。，动作放连贯，口感才不散。",
      "time_min": 42,
      "heat": "无火",
      "tip": "烤到中心微晃，凉后会凝。，汤汁别收太干，细节才到位。",
      "visual_cue": "表面金黄，边缘起壳，料别一次下太多，香气才不跑。"
    },
    {
      "n": 8,
      "text": "取出完全放凉，再切块食用。，慢慢来别急，锅气才足。",
      "time_min": 30,
      "heat": "无火",
      "tip": "放凉才凝，热切会流。，别用力搅，口感才不发柴。",
      "visual_cue": "切面平整，馅体紧实，别用力搅，细节才到位。"
    }
  ],
  "tips": [
    "黄油要冷，派皮才酥。，盖盖焖一会儿，整道菜才立得住。",
    "馅里加柠檬汁，甜味才不闷。，料别一次下太多，细节才到位。",
    "完全放凉再切，切面才漂亮。，注意别烧干，吃口才舒服。"
  ],
  "common_mistakes": [
    "馅没打匀，烤后分层。，盖盖焖一会儿，颜色才够亮。",
    "火太大，表面焦里稀。，别急着加油，味道才进得去。",
    "热的时候切，馅全部流出来。，时间掐准，味道才不闷。"
  ],
