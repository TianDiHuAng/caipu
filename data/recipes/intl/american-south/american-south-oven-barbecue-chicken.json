  "equipment": [
    "烤箱",
    "烤盘",
    "刷子",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用厨房纸吸干，两面撒盐与黑胡椒抹匀静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "提前撒盐能让肉入味，也让表面更干爽好上色。",
      "visual_cue": "鸡皮干爽，调料分布均匀"
    },
    {
      "n": 2,
      "text": "碗中把番茄酱、红糖、米醋、辣椒粉与蒜末调成浓稠酱汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "红糖要搅到完全化开，不然烤的时候会焦黑结块。",
      "visual_cue": "酱汁顺滑无糖粒，颜色深红"
    },
    {
      "n": 3,
      "text": "烤箱预热到二百度，烤盘铺洋葱丝垫底后放上鸡块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱垫底既防粘又吸油，烤完还能当配菜吃。",
      "visual_cue": "烤盘铺好，洋葱丝铺成一层"
    },
    {
      "n": 4,
      "text": "入烤箱中层烤二十分钟，取出刷一层酱汁再烤十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "分两次刷酱，第一次入味第二次上色，不会烤糊。",
      "visual_cue": "鸡皮收紧微焦，酱色红亮"
    },
    {
      "n": 5,
      "text": "取出翻面刷剩余酱汁与植物油，再烤八分钟至中心熟透即可。",
      "time_min": 10,
      "heat": "无火",
      "tip": "最后八分钟盯着烤箱，糖分高很容易在边缘焦黑。",
      "visual_cue": "表面焦糖化发亮，肉汁清亮"
    }
  ],
  "tips": [
    "红糖比白糖上色更漂亮，也带一点焦香。",
    "刷酱汁分两三次，比一次刷厚更好吃。",
    "烤好后静置五分钟再切，肉汁不会流一盘子。",
    "垫底的洋葱丝别丢，拌进饭里特别香。"
  ],
  "common_mistakes": [
    "酱汁一次全刷上，糖分烤糊成黑壳。",
    "鸡块直接从冰箱取出进烤箱，中间生外面焦。",
    "烤箱温度不够，鸡皮油乎乎的没有焦色。",
    "烤完立刻切开，肉汁全流在盘底。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "900克:900克",
      "note": "烤的时间减十分钟。"
    },
    {
      "original": "米醋",
      "substitute": "青柠汁",
      "ratio": "20毫升:18毫升",
      "note": "果酸更清香，最后再加。"
    }
  ],
  "variations": [
    "加一勺烟熏辣椒酱，烟熏味更明显。",
    "用整只鸡烤，烤的时间延长到一小时。",
    "把酱汁换成蜂蜜芥末，做成不同风味。"
  ],
  "serving_suggestion": "整盘端上桌，撒一把葱花，配烤玉米与凉拌卷心菜，是美南后院烧烤的标配。",
  "storage": "冷藏可放两天，复热用一百八十度烤箱烤八分钟，微波会让皮变韧。",
