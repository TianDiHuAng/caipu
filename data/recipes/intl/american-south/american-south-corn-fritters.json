  "steps": [
    {
      "n": 1,
      "text": "玉米粒剥下，用刀略剁几下。，下手别慌，整道菜才立得住。",
      "time_min": 8,
      "heat": "无火",
      "tip": "略剁就好，保留颗粒感。，别急着加油，口感才不发柴。",
      "visual_cue": "玉米碎粒，浆水微出，留意锅底，风味才干净。"
    },
    {
      "n": 2,
      "text": "面粉加泡打粉、白糖和盐混匀。，别用力搅，锅气才足。",
      "time_min": 3,
      "heat": "无火",
      "tip": "粉类先混，才不结块。，注意别烧干，味道才进得去。",
      "visual_cue": "粉质均匀，无颗粒，料别一次下太多，食材才不糊。"
    },
    {
      "n": 3,
      "text": "鸡蛋打散加牛奶，倒进粉里搅匀。，火别太大，吃口才舒服。",
      "time_min": 4,
      "heat": "无火",
      "tip": "搅到无干粉就停手。，留意锅底，口感才不散。",
      "visual_cue": "糊体稠厚，能挂勺，翻动放轻，颜色才够亮。"
    },
    {
      "n": 4,
      "text": "加玉米粒和黑胡椒拌匀，静置五分钟。，保持小火，细节才到位。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置让粉吸水，饼才不散。，下手别慌，成品才稳当。",
      "visual_cue": "糊体发紧，玉米分布匀，翻动放轻，味道才进得去。"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油，中火烧热。，顺序照着来，颜色才够亮。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油铺满锅底，饼才不粘。，下手别慌，香气才不跑。",
      "visual_cue": "油面微波，锅边发热，锅温要匀，香气才不跑。"
    },
    {
      "n": 6,
      "text": "舀一勺糊摊成小圆饼下锅。，盖盖焖一会儿，香气才留得住。",
      "time_min": 5,
      "heat": "中火",
      "tip": "摊薄些，中心才熟。，慢慢来别急，风味才干净。",
      "visual_cue": "饼胚成形，边缘冒泡，翻动放轻，风味才干净。"
    },
    {
      "n": 7,
      "text": "两面各煎两分钟到金黄。，盖盖焖一会儿，形状才完整。",
      "time_min": 5,
      "heat": "中火",
      "tip": "翻一次就够，别反复翻。，保持小火，锅气才足。",
      "visual_cue": "两面金黄，表面凝固，先试试温度，风味才干净。"
    },
    {
      "n": 8,
      "text": "捞出沥油，撒小葱末上桌。，时间掐准，火候才均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "垫厨房纸，油才去得净。，别用力搅，吃口才舒服。",
      "visual_cue": "外脆内软，纸上有油，动作放连贯，表面才漂亮。"
    }
  ],
  "tips": [
    "玉米略剁一下，口感才不散。，慢慢来别急，形状才完整。",
    "糊别太稀，摊开才不会破。，慢慢来别急，整道菜才立得住。",
    "煎到两面金黄就起锅，久了发干。，别用力搅，味道才进得去。"
  ],
  "common_mistakes": [
    "糊太稀，下锅摊不开。，别用力搅，颜色才够亮。",
    "油太少，饼粘在锅上。，注意别烧干，成品才稳当。",
    "火太大，外面焦里面生。，别急着加油，吃口才舒服。"
  ],
  "substitutions": [
    {
      "original": "玉米",
      "substitute": "玉米罐头",
      "ratio": "400 克:350 克",
      "note": "先沥干水分，面糊可再补一勺粉。"
    },
    {
      "original": "植物油",
