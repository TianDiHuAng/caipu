  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉与六十克黄油搓成粗砂状，加清水揉成团后冷藏三十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黄油要冷、水要冰，派皮才酥不硬。",
      "visual_cue": "面团成团不粘手，冷藏后变硬"
    },
    {
      "n": 2,
      "text": "红薯去皮切块蒸二十分钟至软透，压成细腻的泥。",
      "time_min": 22,
      "heat": "中火",
      "tip": "蒸比煮好，水分少，馅料不容易稀。",
      "visual_cue": "薯泥细腻，筷子能轻松压散"
    },
    {
      "n": 3,
      "text": "面团擀成三毫米厚，铺进派盘压实边缘，用叉子在底部扎孔。",
      "time_min": 8,
      "heat": "无火",
      "tip": "扎孔能让蒸汽出去，派皮才不会鼓包。",
      "visual_cue": "派皮贴合盘壁，孔洞均匀"
    },
    {
      "n": 4,
      "text": "薯泥加白糖、红糖、剩余黄油、蛋液、牛奶、肉桂、盐与香草精拌匀。",
      "time_min": 7,
      "heat": "无火",
      "tip": "拌到顺滑无颗粒，馅料烤出来才细腻。",
      "visual_cue": "馅料顺滑浓稠，颜色橙棕"
    },
    {
      "n": 5,
      "text": "馅料倒入派皮，一百八十度烤五十分钟至中心微微晃动即可。",
      "time_min": 52,
      "heat": "无火",
      "tip": "中心轻晃但有弹性就是好了，烤过头会裂。",
      "visual_cue": "表面微鼓，边缘派皮金黄"
    }
  ],
  "tips": [
    "红薯要蒸不要煮，水分少馅才浓。",
    "派皮黄油一定要冷藏，酥松全靠这一步。",
    "烤到一半可以用锡纸盖边缘，防止边焦里生。",
    "冷藏一夜再切，切面整齐，风味也更融合。"
  ],
  "common_mistakes": [
    "红薯煮得太湿，馅料稀得晃不停。",
    "派皮黄油太软，烤完硬得像饼干。",
    "烤箱温度太高，表面裂开一道大口子。",
    "没放凉就急着切块，馅料全流到盘子里。"
  ],
  "substitutions": [
    {
      "original": "红薯",
      "substitute": "南瓜",
      "ratio": "600克:620克",
      "note": "更清淡，糖可加十克。"
    },
    {
      "original": "红糖",
      "substitute": "白糖",
      "ratio": "40克:35克",
      "note": "少了焦香，可加两克肉桂补。"
    }
  ],
  "variations": [
    "表面挤一层打发的鲜奶油，口感更滑。",
    "加一把核桃碎在馅里，脆感更足。",
    "做成小塔模，一次烤十二个更方便分食。"
  ],
  "serving_suggestion": "切一块配一球打发奶油或一勺冰淇淋，再来一杯黑咖啡，是美南节庆餐桌上的固定甜点。",
  "storage": "冷藏可放三天，切块密封冷冻可放两周；复热用一百六十度烤箱烤十分钟。",
