  "steps": [
    {
      "n": 1,
      "text": "玉米粒剥下，一半用刀背压碎出浆。，翻动放轻，口感才有层次。",
      "time_min": 10,
      "heat": "无火",
      "tip": "压碎一半，口感才润。，先试试温度，口感才不发柴。",
      "visual_cue": "玉米粒半碎，浆水渗出，盖盖焖一会儿，味道才不闷。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加牛奶搅匀。，汤汁别收太干，整道菜才立得住。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液打匀，布丁才细。，顺序照着来，成品才好看。",
      "visual_cue": "液体顺滑，无蛋丝，汤汁别收太干，火候才均匀。"
    },
    {
      "n": 3,
      "text": "面粉、玉米面、白糖、盐和泡打粉混匀。，注意别烧干，形状才完整。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先混干料，才不结块。，盖盖焖一会儿，口感才不发柴。",
      "visual_cue": "粉类均匀，无颗粒，下手别慌，锅气才足。"
    },
    {
      "n": 4,
      "text": "干料倒进蛋奶液，搅到无干粉。，汤汁别收太干，锅气才足。",
      "time_min": 4,
      "heat": "无火",
      "tip": "别过度搅，避免起筋。，慢慢来别急，咸淡才好把握。",
      "visual_cue": "糊体浓稠，顺滑流动，手法轻些，香气才留得住。"
    },
    {
      "n": 5,
      "text": "加玉米粒和融化黄油拌匀。，先试试温度，口感才有层次。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油温着倒，才不结块。，料别一次下太多，口感才有层次。",
      "visual_cue": "表面浮油，玉米分布匀，先试试温度，颜色才够亮。"
    },
    {
      "n": 6,
      "text": "倒进抹过油的烤盘，抹平表面。，别用力搅，味道才不闷。",
      "time_min": 4,
      "heat": "无火",
      "tip": "抹平表面，受热才均匀。，盖盖焖一会儿，香气才不跑。",
      "visual_cue": "表面平整，厚度一致，火别太大，食材才不糊。"
    },
    {
      "n": 7,
      "text": "烤箱一百七十五度烤四十分钟。，注意别烧干，成品才好看。",
      "time_min": 42,
      "heat": "无火",
      "tip": "烤到中心不晃，才算熟。，盖盖焖一会儿，咸淡才好把握。",
      "visual_cue": "表面金黄，轻按回弹，手法轻些，整道菜才立得住。"
    },
    {
      "n": 8,
      "text": "取出放十分钟再切块，配黄油食用。，火别太大，形状才完整。",
      "time_min": 12,
      "heat": "无火",
      "tip": "放凉再切，切面才整齐。，时间掐准，成品才稳当。",
      "visual_cue": "切块成型，内部嫩滑，别急着加油，口感才不散。"
    }
  ],
  "tips": [
    "一半玉米压碎，口感才润。，慢慢来别急，细节才到位。",
    "烤到中心不晃，才算熟透。，时间掐准，口感才不发柴。",
    "放凉十分钟再切，才不塌。，留意锅底，形状才完整。"
  ],
  "common_mistakes": [
    "糊太稀，烤完中心发水。，锅温要匀，火候才均匀。",
    "火太大，表面焦里生。，保持小火，形状才完整。",
    "不放凉就切，整块散开。，锅温要匀，形状才完整。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "300 毫升:300 毫升",
      "note": "更浓郁，烤制时间加五分钟。"
    },
    {
      "original": "玉米",
      "substitute": "玉米罐头",
      "ratio": "500 克:400 克",
      "note": "需沥干水分，糖可减十克。"
    }
  ],
  "variations": [
    "加切碎的青椒，风味更足。，时间掐准，颜色才够亮。",
    "加奶酪碎，表面更香。，先试试温度，锅气才足。"
  ],
  "serving_suggestion": "切块配烤鸡或火腿。，别急着加油，风味才干净。",
  "storage": "冷藏三天，复热用烤箱。，起锅前尝味，口感才不散。",
