    "total_min": 70
  },
  "servings": 4,
  "flavor": [
    "savory",
    "rich",
    "salty",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 350,
          "unit": "g",
          "note": "低筋面粉",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 500,
          "unit": "ml",
          "note": "面团与肉汁",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 130,
          "unit": "g",
          "note": "冷切小块",
          "optional": false
        },
        {
          "name": "培根",
          "name_en": "bacon",
          "amount": 200,
          "unit": "g",
          "note": "切小片",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 4,
          "unit": "g",
          "note": "现磨粗粒",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 7,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "切花点缀",
          "optional": false
        },
        {
          "name": "泡打粉",
          "name_en": "baking powder",
          "amount": 12,
          "unit": "g",
          "note": "膨发",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "平底锅",
    "擀面杖",
    "圆模"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉与泡打粉、盐混合过筛，放冷的黄油块用手指搓成粗砂。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冰的，搓出来层次才明显。",
      "visual_cue": "混合物呈粗砂状，无大块油"
    },
    {
      "n": 2,
      "text": "倒入两百毫升牛奶，用刮刀翻拌到刚成团就停手。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌过头会起筋，饼干就发硬。",
      "visual_cue": "面团粗糙成团，不光滑"
    },
    {
      "n": 3,
      "text": "面团放案板轻压成两厘米厚，用圆模压出八个圆饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "轻压别揉，压完剩下的边角别再揉。",
      "visual_cue": "圆饼厚薄一致，边缘整齐"
    },
    {
      "n": 4,
      "text": "圆饼排进烤盘留出间隙，表面刷一层融化黄油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "留间隙让热气流通，才会膨起。",
      "visual_cue": "表面油亮，间隔均匀"
    },
    {
      "n": 5,
      "text": "烤箱两百度烤十五分钟，烤到表面金黄、侧面分层。",
      "time_min": 15,
      "heat": "中火",
      "tip": "中途别开盖，温度掉了就不膨。",
      "visual_cue": "表面金黄，侧面有明显分层"
    },
    {
      "n": 6,
      "text": "平底锅小火煎培根六分钟，煎到出油变脆后盛出。",
      "time_min": 6,
      "heat": "小火",
      "tip": "培根煎脆，肉汁才有烟熏香。",
      "visual_cue": "培根卷曲出油，颜色深红"
    },
    {
      "n": 7,
      "text": "锅里留两勺培根油，加面粉小火炒两分钟成糊。",
      "time_min": 2,
      "heat": "小火",
      "tip": "面粉先炒一下，肉汁才不会有生面粉味。",
      "visual_cue": "面糊冒小泡，颜色微黄"
    },
    {
      "n": 8,
      "text": "分三次倒入剩余牛奶，边倒边搅，小火煮到浓稠挂勺。",
      "time_min": 6,
      "heat": "小火",
      "tip": "一次倒太多会结块，慢慢加才顺。",
      "visual_cue": "肉汁浓稠顺滑，能挂勺背"
    },
    {
      "n": 9,
      "text": "加盐与大量黑胡椒调味，倒回煎好的培根片拌匀。",
      "time_min": 2,
      "heat": "小火",
      "tip": "黑胡椒是灵魂，别舍不得放。",
      "visual_cue": "肉汁颜色奶白，胡椒颗粒明显"
    },
    {
      "n": 10,
      "text": "饼干对半切开，浇上热肉汁，撒小葱趁热食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "肉汁要趁热浇，饼干才吸得进去。",
      "visual_cue": "肉汁流下饼干，热气压出"
    }
  ],
  "tips": [
    "黄油保持冰冷，搓出来的饼干才有层次。",
    "面团只压不揉搓，烤出来的口感才松软。",
    "肉汁用小火慢煮并分次加奶，才不结块。"
  ],
  "common_mistakes": [
    "黄油融化后和面，饼干烤出来又硬又扁。",
    "面团反复揉搓，成品像石头一样实。",
    "牛奶一次全倒进面糊，肉汁结成一粒粒面疙瘩。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "香肠",
      "ratio": "200 克:200 克",
      "note": "需切小片并多煎两分钟。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "500 毫升:400 毫升",
      "note": "肉汁更浓，需加一百毫升水。"
    }
  ],
  "variations": [
    "肉汁里加一勺辣酱，风味更带劲。",
    "饼干里加一把奶酪丝，咸香更足。"
  ],
  "serving_suggestion": "热饼干浇上肉汁，配一个煎蛋当早餐。",
  "storage": "饼干冷藏两天，肉汁冷藏三天分开保存。",
  "nutrition_estimate": {
    "basis": "每份约 320 克",
