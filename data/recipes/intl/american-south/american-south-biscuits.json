          "name_en": "baking powder",
          "amount": 15,
          "unit": "g",
          "note": "膨松",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "助上色",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白醋",
          "name_en": "white vinegar",
          "amount": 10,
          "unit": "ml",
          "note": "与牛奶做酸乳",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "擀面杖",
    "圆形切模",
    "烤盘",
    "大碗",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶里加白醋搅匀，静置十分钟到微微起稠，做成酸乳备用。",
      "time_min": 11,
      "heat": "无火",
      "tip": "没有酪乳就用这招，酸味能让比司吉更松更香。",
      "visual_cue": "奶液变稠，表面有小颗粒"
    },
    {
      "n": 2,
      "text": "面粉、泡打粉、白糖与盐倒进大碗，用打蛋器搅匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉类先混匀，膨松剂分布才均匀，成品才发得整齐。",
      "visual_cue": "粉类颜色一致，无结块"
    },
    {
      "n": 3,
      "text": "把冷藏黄油丁倒进粉里，用手指快速搓成小指头大的粗砂粒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "手要快、别捂热，黄油一旦化掉，层次就没了。",
      "visual_cue": "粉里带小指头大的酥粒"
    },
    {
      "n": 4,
      "text": "倒进酸乳，用刮刀翻拌到刚好成团，不要反复揉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到没有干粉就停，多揉十下就会变硬。",
      "visual_cue": "面团粗糙成团，盆底无干粉"
    },
    {
      "n": 5,
      "text": "面团移到撒了薄粉的台面，轻压成两厘米厚的方片，对折一次。",
      "time_min": 4,
      "heat": "无火",
      "tip": "折一次就够出层，折太多会把黄油压实。",
      "visual_cue": "面片厚薄均匀，边缘齐整"
    },
    {
      "n": 6,
      "text": "用圆形切模垂直压下切出圆饼，切口不要扭转。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压下去直接提起来，转着切会把层次压死，发不高。",
      "visual_cue": "圆饼切口齐整，边缘分层可见"
    },
    {
      "n": 7,
      "text": "圆饼排进烤盘，间隔两厘米，表面刷一层融化的黄油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "挨着摆边缘更软，分开摆则四周都脆，看个人喜好。",
      "visual_cue": "饼面泛油光，排列整齐"
    },
    {
      "n": 8,
      "text": "烤箱预热到二百二十度，中层烤十四分钟到表面金黄。",
      "time_min": 16,
      "heat": "大火",
      "tip": "高温快烤才起层，温度低会烤成硬饼。",
      "visual_cue": "表面金黄，侧面裂开层次"
    }
  ],
  "tips": [
    "黄油、牛奶都要冰的，全程手温别传进去。",
    "切模压完剩下的边角料别揉成团再压，会变硬，直接烤成小饼。",
    "出炉趁热刷一层黄油，是美南家庭的固定动作。",
    "配香肠肉汁或煎蛋，就是南方的经典早餐。"
  ],
  "common_mistakes": [
    "黄油软化后再用，面团出油，烤出来扁硬不起层。",
    "面团反复揉到光滑，筋度上来，比司吉变成小面包。",
    "切模扭着压，边缘封死，烤的时候发不起来。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "酪乳",
      "ratio": "180毫升:180毫升",
      "note": "可直接用，无需加醋。"
    },
    {
      "original": "黄油",
      "substitute": "猪油",
      "ratio": "110克:100克",
      "note": "层次更酥，香气更重。"
    }
  ],
  "variations": [
    "加一把切达奶酪碎与葱花，做成咸香版。",
    "表面撒粗盐与黑胡椒，风味更立体。"
  ],
  "serving_suggestion": "四份，每份两个，配香肠肉汁、煎蛋与咖啡。",
  "storage": "密封常温放一天，冷藏三天；复热用烤箱一百八十度烤五分钟，微波会变韧。",
