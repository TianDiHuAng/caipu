    "面粉盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用厨房纸吸干水，撒盐、黑胡椒与辣椒粉抹匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面一定要吸干，带水裹粉会结块脱皮。",
      "visual_cue": "鸡皮干爽，调料痕迹均匀"
    },
    {
      "n": 2,
      "text": "把面粉倒在盘里，鸡块逐块按压裹粉，抖掉多余干粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "按压裹粉才附着结实，抖掉干粉煎时不易焦。",
      "visual_cue": "鸡块表面均匀挂粉且不结团"
    },
    {
      "n": 3,
      "text": "厚底煎锅倒植物油中火烧热，鸡皮朝下煎六分钟至金黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "先煎皮面出油，皮才脆，油也不用再多放。",
      "visual_cue": "鸡皮金黄起脆，锅中有大量鸡油"
    },
    {
      "n": 4,
      "text": "翻面再煎三分钟，盛出后下洋葱丝与蒜末炒到洋葱变软。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱要炒到透明出甜味，这是汤汁的底。",
      "visual_cue": "洋葱丝透明发软，锅底有焦香"
    },
    {
      "n": 5,
      "text": "撒一勺锅中余粉炒匀，倒清水搅开成稀糊，回锅鸡块盖盖小火焖二十五分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "小火焖到骨缝不见血水，汤汁才会浓而挂勺。",
      "visual_cue": "汤汁浓稠挂勺，鸡肉一夹就离骨"
    }
  ],
  "tips": [
    "用带皮带骨的鸡腿肉，焖出来才有胶质和香气。",
    "锅底的焦香是汤汁的灵魂，别洗锅再焖。",
    "汤汁太稀可以开盖多烧五分钟收浓。",
    "配白饭或比司吉都好吃，汤汁别浪费。"
  ],
  "common_mistakes": [
    "鸡块没吸干就裹粉，煎的时候脱皮粘锅。",
    "大火焖煮，肉还没软汤已经烧干。",
    "洋葱没炒透就加水，汤汁寡淡没有甜味。",
    "一次下太多鸡块，锅温骤降煎不出金黄的皮。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "800克:700克",
      "note": "更瘦，焖的时间减八分钟。"
    },
    {
      "original": "面粉",
      "substitute": "玉米面",
      "ratio": "60克:60克",
      "note": "外皮更脆，汤更粗颗粒。"
    }
  ],
  "variations": [
    "加两片培根同炒底料，烟熏味更足。",
    "加一把白蘑菇同焖，鲜味更浓也更有口感。",
    "换成猪排同焖，就是美南焖猪排。"
  ],
  "serving_suggestion": "把鸡块摆在盘里，浇上浓稠的洋葱汤汁，配白饭与青豆，是美南周日的家常主菜。",
  "storage": "冷藏可放两天，汤汁与鸡分开存；复热用小火加少量清水焖八分钟。",
