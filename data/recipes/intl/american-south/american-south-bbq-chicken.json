  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 1000,
          "unit": "g",
          "note": "去骨留皮",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "番茄酱",
          "name_en": "ketchup",
          "amount": 100,
          "unit": "ml",
          "note": "刷酱",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 30,
          "unit": "g",
          "note": "增亮",
          "optional": false
        },
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 10,
          "unit": "g",
          "note": "腌渍",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "刷面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "锡纸",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉剔去多余脂肪，在厚处划两刀，让受热更均匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "划刀既好熟也入味，别划穿鸡皮。",
      "visual_cue": "鸡腿肉厚薄均匀，刀口浅而整齐"
    },
    {
      "n": 2,
      "text": "两面撒盐与辣椒粉，抹匀蒜末后静置二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "腌二十分钟打底，烤出来才有底味。",
      "visual_cue": "表面泛红，蒜末均匀附着"
    },
    {
      "n": 3,
      "text": "烤盘铺锡纸，鸡皮朝上摆好，表面刷一层植物油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷油能让鸡皮起脆，不刷容易发干。",
      "visual_cue": "鸡皮油亮，摆得平展不重叠"
    },
    {
      "n": 4,
      "text": "烤箱预热到二百度，中层烤二十分钟使鸡皮上色。",
      "time_min": 20,
      "heat": "中火",
      "tip": "高温先把皮烤脆，再低温焖熟。",
      "visual_cue": "鸡皮金黄，边缘微微起泡"
    },
    {
      "n": 5,
      "text": "番茄酱、蜂蜜与少许辣椒粉调成刷酱，搅到顺滑。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蜂蜜让酱色红亮，也帮酱汁挂住。",
      "visual_cue": "酱体浓稠，颜色深红发亮"
    },
    {
      "n": 6,
      "text": "取出鸡腿翻个面，刷上一层酱，回炉再烤十分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "翻面刷酱，两面颜色才一致。",
      "visual_cue": "酱层起小泡，香味扑出来"
    },
    {
      "n": 7,
      "text": "再翻回来让鸡皮朝上，刷第二层酱，烤八分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "分次薄刷，糖分才不焦黑。",
      "visual_cue": "鸡皮红亮油润，酱色均匀"
    },
    {
      "n": 8,
      "text": "最后三分钟转二百二十度，让表皮收紧起脆。",
      "time_min": 3,
      "heat": "大火",
      "tip": "高温短烤上脆皮，久烤就焦了。",
      "visual_cue": "表皮微焦发脆，油光明显"
    },
    {
      "n": 9,
      "text": "取出后静置五分钟，顺着肌肉纹理切条装盘。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置让肉汁回渗，切开不流汤。",
      "visual_cue": "切面肉汁清亮，肉质白嫩"
    }
  ],
  "tips": [
    "鸡皮朝上先高温烤，上色起脆，再刷酱补味。",
    "刷酱分两三次薄薄刷，一次刷厚容易烤焦发苦。",
    "烤完静置五分钟再切，肉汁不流失。"
  ],
  "common_mistakes": [
    "腌好直接刷酱烤，糖分在表面烧黑，里面还没熟。",
    "全程一个温度烤到底，皮不脆、肉还发干。",
    "鸡腿肉不划刀，厚处夹生，薄处已经干柴。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "1000 克:1000 克",
      "note": "肉薄熟得快，烤制时间减十分钟。"
    },
    {
      "original": "蜂蜜",
      "substitute": "糖浆",
      "ratio": "30 克:30 克",
      "note": "甜度相近，上色略浅。"
    }
  ],
  "variations": [
    "腌料里加一勺芥末酱，酸辣更开胃。",
    "出炉撒一把烤香的白芝麻，香气更足。"
  ],
  "serving_suggestion": "配烤玉米、凉拌卷心菜与冰柠檬水，就是南方烧烤的经典一盘。",
  "storage": "冷藏三天，复热包锡纸一百八十度烤十分钟。",
