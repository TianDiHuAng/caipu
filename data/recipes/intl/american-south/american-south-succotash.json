    "刀",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米剥粒，青豆洗净，番茄和洋葱切成同样大的小丁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "配料切成同样大小，入口层次才整齐。",
      "visual_cue": "丁块大小均匀一致"
    },
    {
      "n": 2,
      "text": "青豆下入开水锅里焯两分钟，捞出过凉水后沥干。",
      "time_min": 4,
      "heat": "大火",
      "tip": "先焯一遍水，能去掉青豆的腥味。",
      "visual_cue": "豆粒翠绿，口感微粉"
    },
    {
      "n": 3,
      "text": "炒锅放黄油中火化开，下洋葱和大蒜炒到透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "黄油别烧到发褐，否则会带焦味。",
      "visual_cue": "洋葱透明，黄油微泡"
    },
    {
      "n": 4,
      "text": "加入番茄丁炒三分钟，一直炒到番茄出汁变软。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄要炒出汁水，整道菜才不会太干。",
      "visual_cue": "番茄塌软，锅底见汁"
    },
    {
      "n": 5,
      "text": "倒入玉米粒和青豆翻炒三分钟，加盐和白胡椒。",
      "time_min": 4,
      "heat": "中火",
      "tip": "玉米和青豆都易熟，别炒得太久了。",
      "visual_cue": "蔬菜裹汁，颜色鲜亮"
    },
    {
      "n": 6,
      "text": "淋淡奶油小火煮两分钟收汁，撒香菜碎出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "奶油只用来收汁，煮久了会油水分离。",
      "visual_cue": "汤汁浓稠，略带乳白"
    }
  ],
  "tips": [
    "青豆先焯水，能去掉生豆的涩味。",
    "黄油用中小火化开，别烧到发褐。",
    "淡奶油最后收汁，煮久会油水分离。"
  ],
  "common_mistakes": [
    "青豆没焯直接炒，成品带一股生豆腥。",
    "火太大黄油烧焦，整锅菜都是苦味。",
    "勾芡过度，变成一锅糊状的稠泥。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "培根油",
      "ratio": "30 克:30 克",
      "note": "更南方风味，咸度更高。"
    },
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "80 毫升:80 毫升",
      "note": "更清爽，需略延长收汁时间。"
    }
  ],
  "variations": [
    "加一把煮熟的利马豆，更接近南方老式做法。",
    "撒一层煎脆的培根碎，咸香更突出。"
  ],
  "serving_suggestion": "配烤鸡、玉米面包和一杯冰茶，是南方餐桌上最常见的夏季配菜。",
  "storage": "冷藏两天，复热用炒锅小火加两勺水；不建议冷冻，青豆会失去口感。",
