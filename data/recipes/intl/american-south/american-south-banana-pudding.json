  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "香蕉",
          "name_en": "banana",
          "amount": 300,
          "unit": "g",
          "note": "切一厘米厚片",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 400,
          "unit": "ml",
          "note": "全脂牛奶",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "取蛋黄",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 30,
          "unit": "g",
          "note": "增稠用",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "出锅拌入",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 40,
          "unit": "g",
          "note": "调甜味",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 1,
          "unit": "g",
          "note": "提香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "打蛋器",
    "烤盘",
    "冰箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小碗里放面粉、盐与肉桂，加少量牛奶搅成顺滑的稀糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调成糊再下锅，才不会有面疙瘩。",
      "visual_cue": "糊体顺滑，没有干粉颗粒"
    },
    {
      "n": 2,
      "text": "汤锅倒入剩余的牛奶，小火加热到锅边冒小泡。",
      "time_min": 4,
      "heat": "小火",
      "tip": "别煮沸，牛奶一滚容易起皮。",
      "visual_cue": "锅边冒小泡，表面微微冒气"
    },
    {
      "n": 3,
      "text": "蛋黄加蜂蜜打散，缓缓倒入牛奶中并不断搅拌。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蛋液要慢慢倒，太快会结成蛋花。",
      "visual_cue": "液体颜色均匀发黄"
    },
    {
      "n": 4,
      "text": "倒入调好的面粉糊，小火不停搅动煮五分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "勺子要刮到锅底，稠了立刻调小。",
      "visual_cue": "布丁糊浓稠，划过留痕"
    },
    {
      "n": 5,
      "text": "关火拌入黄油，搅到完全化开让布丁糊更顺滑。",
      "time_min": 1,
      "heat": "无火",
      "tip": "黄油最后加，香气才不会被煮散。",
      "visual_cue": "糊体柔亮，提起勺子缓慢滴落"
    },
    {
      "n": 6,
      "text": "烤盘底铺一层香蕉片，倒入一半布丁糊抹平。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香蕉贴边摆，切片才不会塌下去。",
      "visual_cue": "香蕉铺满盘底，糊面平整"
    },
    {
      "n": 7,
      "text": "再铺一层香蕉片，倒入剩余布丁糊抹平表面。",
      "time_min": 3,
      "heat": "无火",
      "tip": "两层香蕉两层糊，切开层次更好看。",
      "visual_cue": "表面平整，香蕉完全被盖住"
    },
    {
      "n": 8,
      "text": "放凉后冷藏四小时以上，定型后取出切块食用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冷藏够久才能切出整齐的块。",
      "visual_cue": "布丁完全凝固，勺背压不回弹"
    }
  ],
  "tips": [
    "布丁糊要浓到能挂勺，太稀冷藏后不成型。",
    "香蕉选刚熟带点硬的，太熟会出水。",
    "中途盖一张保鲜膜贴面，防止结皮。"
  ],
  "common_mistakes": [
    "搅动不够勤，锅底糊了一层带焦味。",
    "蛋液一次倒进去，锅里出现蛋花。",
    "冷藏时间不够，切开时整盘都流汤。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "400 毫升:250 毫升",
      "note": "需加一百五十毫升清水，口感更厚。"
    },
    {
      "original": "蜂蜜",
      "substitute": "炼乳",
      "ratio": "40 克:50 克",
      "note": "奶香更浓，甜度接近。"
    }
  ],
  "variations": [
    "夹一层酥脆的饼干碎，口感更有层次。",
    "表面撒一层可可粉，苦甜更平衡。"
  ],
  "serving_suggestion": "冷藏后切块装盘，表面点几片香蕉和肉桂粉。",
  "storage": "冷藏三天内吃完，香蕉久放会发黑出水。",
