  "steps": [
    {
      "n": 1,
      "text": "羽衣甘蓝逐片洗净，撕下叶片去掉中间粗梗后撕成大块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "粗梗纤维硬，留着怎么焖都咬不动。",
      "visual_cue": "叶片撕成大片，粗梗全部去掉"
    },
    {
      "n": 2,
      "text": "汤锅小火煸培根三分钟，逼出油脂至边缘微脆。",
      "time_min": 5,
      "heat": "小火",
      "tip": "培根的油脂是这道菜的底味，别急着下菜。",
      "visual_cue": "培根卷曲出油，锅底一层亮油"
    },
    {
      "n": 3,
      "text": "下洋葱丝与大蒜炒香，再倒入清水，大火烧到汤水翻滚。",
      "time_min": 7,
      "heat": "大火",
      "tip": "水量要能没过菜叶一半，太少会焖干。",
      "visual_cue": "汤水翻滚，洋葱浮在表面"
    },
    {
      "n": 4,
      "text": "下羽衣甘蓝转入小火，盖盖焖四十分钟至叶片完全软塌。",
      "time_min": 40,
      "heat": "小火",
      "tip": "焖够时间才軟糯，四十分钟是底线。",
      "visual_cue": "叶片深绿发软，汤色转墨绿"
    },
    {
      "n": 5,
      "text": "加盐、黑胡椒、白糖与米醋调味，再焖五分钟让味道吃进去。",
      "time_min": 6,
      "heat": "小火",
      "tip": "醋最后加，酸味保留得住，也能压住菜的涩。",
      "visual_cue": "汤汁咸鲜带酸，菜叶柔软"
    }
  ],
  "tips": [
    "焖的时间宁长勿短，羽衣甘蓝越焖越软越甜。",
    "培根不能省，它是这道菜的咸香来源。",
    "加一点米醋能去掉青菜的涩味，风味立刻亮起来。",
    "焖出来的汤别倒，用来蘸玉米面包最好吃。"
  ],
  "common_mistakes": [
    "羽衣甘蓝没去粗梗，嚼起来像咬草绳。",
    "焖十分钟就起锅，菜叶硬得咬不动。",
    "培根没煸出油就加水，汤寡淡没有烟熏味。",
    "盐一次放太多，汤汁咸得喝不下。"
  ],
  "substitutions": [
    {
      "original": "羽衣甘蓝",
      "substitute": "芥蓝",
      "ratio": "800克:800克",
      "note": "苦味略重，糖可加两克。"
    },
    {
      "original": "培根",
      "substitute": "熏火腿",
      "ratio": "80克:100克",
      "note": "咸度更高，盐要减半。"
    }
  ],
  "variations": [
    "加一只熏鸡腿同焖，变成荤焖青菜。",
    "加几片干辣椒同焖，微微带辣更下饭。",
    "加一把玉米粒同焖，甜味更明显。"
  ],
  "serving_suggestion": "用漏勺捞出装盘，淋两勺焖出来的汤，配玉米面包与炸鸡，是美南新年的传统组合。",
  "storage": "冷藏可放三天，风味反而更入味；复热用小火加少量清水焖五分钟。",
