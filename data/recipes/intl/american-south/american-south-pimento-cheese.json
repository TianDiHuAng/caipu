  "steps": [
    {
      "n": 1,
      "text": "切达奶酪用粗孔刨丝器刨成细丝，装进大碗。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "自己刨的奶酪比预 shred 的更香更顺滑。",
      "visual_cue": "奶酪成丝，松散不结，状态稳定"
    },
    {
      "n": 2,
      "text": "甜椒烤过后撕掉焦皮，切成极小的细丁。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "烤过的甜椒甜味足，生青味也去掉了。",
      "visual_cue": "细丁柔软，颜色红亮，状态稳定"
    },
    {
      "n": 3,
      "text": "奶油奶酪提前取出回温，用刮刀压到顺滑无颗粒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "回温不够会结块，拌不匀。，注意火候。",
      "visual_cue": "质地细腻，无小疙瘩，状态稳定"
    },
    {
      "n": 4,
      "text": "把奶酪丝、奶油奶酪和蛋黄酱一起拌到均匀。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "从底部翻拌，别把奶酪丝搅碎。，注意火候。",
      "visual_cue": "酱体浓稠，丝状分明，状态稳定"
    },
    {
      "n": 5,
      "text": "加甜椒丁、擦碎的洋葱、辣椒粉、盐和黑胡椒拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "洋葱擦成泥，味道才融进酱里。，注意火候。",
      "visual_cue": "颜色橘红，香气辛甜，状态稳定"
    },
    {
      "n": 6,
      "text": "冷藏半小时让味道融合，食用前撒欧芹碎。这一步不要着急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冷藏后质地更紧实，抹起来更好。，注意火候。",
      "visual_cue": "酱体紧实，凉透爽口，状态稳定"
    }
  ],
  "tips": [
    "奶酪自己刨，口感比预制的更顺滑。，值得留意。",
    "奶油奶酪回温再拌，避免结小疙瘩。，值得留意。",
    "冷藏半小时，味道才真正融合。，值得留意。"
  ],
  "common_mistakes": [
    "奶酪没回温就拌，酱里全是硬块。，值得留意。",
    "甜椒切太大，抹的时候总掉出来。，值得留意。",
    "蛋黄酱放太多，酱稀得挂不住饼干。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "切达奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "320 克:320 克",
      "note": "质地更软，咸味稍淡。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "120 克:120 克",
      "note": "更清爽，需多加十克奶油奶酪。"
    }
  ],
  "variations": [
    "加一勺辣酱，辣味更有层次。，值得留意。",
    "用烟熏切达替换一半，香气更浓。，值得留意。"
  ],
  "serving_suggestion": "抹在饼干或烤面包上，也可以夹进汉堡里。，效果更稳定。",
  "storage": "冷藏三天，食用前搅匀。，效果更稳定。",
