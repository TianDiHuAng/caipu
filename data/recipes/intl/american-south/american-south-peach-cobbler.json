  "steps": [
    {
      "n": 1,
      "text": "桃子去皮去核切成两厘米厚的片，拌入六十克白糖与肉桂静置十五分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "静置让果肉出水，烤的时候才不会干。",
      "visual_cue": "桃片表面泛光，盘底有果汁"
    },
    {
      "n": 2,
      "text": "烤盘放入黄油，送进二百度烤箱融化后取出。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油要完全融化再倒面糊，底部才会起酥边。",
      "visual_cue": "黄油全化，盘底油层均匀"
    },
    {
      "n": 3,
      "text": "面粉、剩余白糖、泡打粉与盐混匀，加牛奶、蛋液与香草精拌成稀面糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌到没有干粉就够，面糊稀一点没关系。",
      "visual_cue": "面糊顺滑可流动，无干粉块"
    },
    {
      "n": 4,
      "text": "把面糊倒在融化的黄油上，不要搅拌，再铺上桃片与果汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "千万别搅，黄油从底下往上冒才会形成脆边。",
      "visual_cue": "桃片均匀铺满，面糊在底下"
    },
    {
      "n": 5,
      "text": "二百度烤三十五分钟至表面金黄膨起，取出稍凉即可。",
      "time_min": 36,
      "heat": "无火",
      "tip": "烤到边缘焦黄、中心轻按回弹才算好。",
      "visual_cue": "表面金黄起酥，桃汁冒泡"
    }
  ],
  "tips": [
    "用熟透的桃子，甜度和汁水都够。",
    "黄油一定要在盘里融化再倒面糊，别提前拌。",
    "面糊别搅，搅了就没有那层酥边。",
    "配一勺香草冰淇淋，热冷交替最好吃。"
  ],
  "common_mistakes": [
    "桃子没去皮，烤完皮卷成硬片，口感发韧。",
    "面糊和黄油搅在一起，烤出来平塌没有层次。",
    "糖放得太多，甜得发腻，把桃子的香气盖住。",
    "烤的时间不够，中心还是湿面糊。"
  ],
  "substitutions": [
    {
      "original": "桃子",
      "substitute": "罐头桃",
      "ratio": "900克:800克",
      "note": "已有糖水，白糖减四十克。"
    },
    {
      "original": "牛奶",
      "substitute": "酪乳",
      "ratio": "200毫升:200毫升",
      "note": "更稠，酥边更明显。"
    }
  ],
  "variations": [
    "加一把蓝莓同烤，酸甜层次更丰富。",
    "表面撒一层红糖再烤，脆壳更厚。",
    "加一点肉豆蔻同烤，香气更暖更厚。"
  ],
  "serving_suggestion": "趁热盛进碗里，挖一勺香草冰淇淋放上去，冷热交融，是美南夏天最受欢迎的一份甜点。",
  "storage": "冷藏可放三天，复热用一百八十度烤箱烤十分钟，微波会让酥边变软。",
