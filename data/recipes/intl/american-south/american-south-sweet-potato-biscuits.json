  "equipment": [
    "烤箱",
    "烤盘",
    "碗",
    "擀面杖",
    "圆模",
    "叉子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红薯去皮切块蒸十五分钟，趁热压成细腻的泥后放凉。",
      "time_min": 18,
      "heat": "中火",
      "tip": "一定要放凉再用，热的薯泥会把黄油化掉。",
      "visual_cue": "薯泥细腻无颗粒，温度接近室温"
    },
    {
      "n": 2,
      "text": "面粉、泡打粉、白糖、盐与肉桂混合过筛到盆里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛后成品更松，粉末分布也更均匀。",
      "visual_cue": "粉料蓬松，颜色均匀"
    },
    {
      "n": 3,
      "text": "把冷藏黄油丁搓进粉里，搓成粗砂粒状即可。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油要冷，搓到粗砂就停，别搓成面团。",
      "visual_cue": "粉里有粗砂状的黄油粒"
    },
    {
      "n": 4,
      "text": "加红薯泥与酪乳，用刮刀翻拌到刚成团，不要反复揉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到没有干粉就停，揉多了比司吉会变硬。",
      "visual_cue": "面团粗糙成团，表面不光滑"
    },
    {
      "n": 5,
      "text": "面团擀成一厘米半厚，用圆模压出八块，摆在烤盘上。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压模要垂直压下不要扭转，层次才起得来。",
      "visual_cue": "坯子厚薄一致，边缘整齐"
    },
    {
      "n": 6,
      "text": "烤箱预热到二百度，烤十五分钟至表面金黄膨起。",
      "time_min": 16,
      "heat": "无火",
      "tip": "烤到边缘微焦、侧面有分层就是熟了。",
      "visual_cue": "表面金黄，侧面能看见层纹"
    }
  ],
  "tips": [
    "所有材料尽量保持低温，比司吉才松。",
    "红薯泥要压得细，颗粒会影响层次。",
    "面团不要揉，翻拌到刚好成团就可以了。",
    "趁热掰开抹黄油，是最标准的吃法。"
  ],
  "common_mistakes": [
    "红薯泥没放凉就拌黄油，面团变得又黏又软。",
    "反复揉面，烤出来像小面包一样韧。",
    "压模时左右扭转，层次全被压死。",
    "烤箱温度不足，比司吉扁塌不膨。"
  ],
  "substitutions": [
    {
      "original": "红薯",
      "substitute": "南瓜",
      "ratio": "300克:320克",
      "note": "水分更多，面粉加二十克。"
    },
    {
      "original": "酪乳",
      "substitute": "牛奶",
      "ratio": "120毫升:120毫升",
      "note": "加一小勺米醋静置五分钟代用。"
    }
  ],
  "variations": [
    "加一把核桃碎同拌，口感更丰富。",
    "加一勺蜂蜜在面团里，甜香更浓。",
    "做成小圆球状，当点心一口一个正好。"
  ],
  "serving_suggestion": "趁热掰开，抹黄油或夹一片火腿，配一杯冰牛奶，是美南早餐的经典搭法。",
  "storage": "常温密封可放一天，冷藏两天；复热用一百八十度烤箱烤五分钟。",
