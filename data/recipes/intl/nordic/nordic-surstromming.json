          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 30,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1000,
          "unit": "ml",
          "note": "盐水用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "玻璃罐",
    "砧板",
    "刀",
    "厨房纸",
    "重物"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲭鱼去头去内脏，保留鱼皮，用清水冲净血水，再用厨房纸彻底吸干表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "血水与水分都要彻底去干净，残留的水会让鱼在罐里腐坏。",
      "visual_cue": "鱼身干爽，腹腔无血丝"
    },
    {
      "n": 2,
      "text": "按每一升清水配六十克粗盐的比例调成浓盐水，搅到盐粒完全化开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐水要饱和，盐不够就压不住杂菌，鱼会变臭而不是变酸。",
      "visual_cue": "盐水清亮，底部略有未化盐粒"
    },
    {
      "n": 3,
      "text": "玻璃罐底铺一层莳萝，把鲭鱼逐条码进罐里，鱼皮朝外、腹部朝内。",
      "time_min": 8,
      "heat": "无火",
      "tip": "码得紧一些，减少罐内空气，发酵才均匀。",
      "visual_cue": "鱼身紧密叠放，罐壁可见鱼皮"
    },
    {
      "n": 4,
      "text": "撒入剩余盐与白糖，倒入浓盐水淹没全部鱼身，留两指宽的顶部空间。",
      "time_min": 4,
      "heat": "无火",
      "tip": "顶部要留空间，发酵会产生气体，罐子灌满容易胀裂。",
      "visual_cue": "液面高出鱼身，罐口留空"
    },
    {
      "n": 5,
      "text": "盖紧罐盖，旁边备一碟切好的洋葱，取用时配着同吃，前三天每天开盖放一次气。",
      "time_min": 6,
      "heat": "无火",
      "tip": "开盖放气时要慢慢拧，气体冲出来会带汤汁喷溅。",
      "visual_cue": "开盖时听到放气声，液面有气泡"
    },
    {
      "n": 6,
      "text": "静置发酵六到八周，罐身微微鼓起、汤汁变浑、气味浓烈即成熟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "发酵温度越低时间越长，冰箱冷藏发酵风味更温和。",
      "visual_cue": "罐身微鼓，汤汁浑浊"
    }
  ],
  "tips": [
    "开罐前先冷藏几小时，低温能减少气体喷出。",
    "传统吃法配薄饼、洋葱丝与煮土豆，气味被面饼裹住更好入口。",
    "罐身若出现黑霉或液体发黏，说明杂菌污染，必须整罐丢弃。",
    "初尝者建议在户外开罐，气味非常强烈。"
  ],
  "common_mistakes": [
    "盐量不足省成本，鱼在罐里腐坏发臭，只能整罐倒掉。",
    "鱼没吸干水就入罐，汤汁很快发浑长膜。",
    "罐子装得太满不留空隙，发酵产气后胀裂漏液。"
  ],
  "substitutions": [
    {
      "original": "鲭鱼",
      "substitute": "沙丁鱼",
      "ratio": "800克:800克",
      "note": "体积小，发酵时间缩短到四到五周。"
    },
    {
      "original": "莳萝",
      "substitute": "茴香叶",
      "ratio": "20克:20克",
      "note": "香气更浓烈，用量可减半。"
    }
  ],
  "variations": [
    "加入几粒白胡椒与一片月桂叶，风味更有层次。",
    "做成小罐分装，发酵时间更短，适合初次尝试。"
  ],
  "serving_suggestion": "四份配菜，配薄饼、洋葱丝、煮土豆与酸奶油，是瑞典北部的传统吃法。",
  "storage": "冷藏可放六个月，开罐后须在三天内吃完并保持冷藏。",
