  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切三厘米块，用厨房纸吸干。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "干爽才煎得上色。，火候要稳，别忽大忽小。",
      "visual_cue": "肉块方正，表面干爽"
    },
    {
      "n": 2,
      "text": "肉块撒盐和白胡椒，裹一层面粉。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄薄一层就够，太厚汤会糊。，火候要稳，别忽大忽小。",
      "visual_cue": "表面挂粉，均匀不结块"
    },
    {
      "n": 3,
      "text": "厚底锅化黄油，肉块分批煎到焦黄。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "分批煎，锅温才不掉。，火候要稳，别忽大忽小。",
      "visual_cue": "表面焦褐，锅底留香"
    },
    {
      "n": 4,
      "text": "加洋葱块炒到软，锅底焦渣刮起。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中火",
      "tip": "焦渣是味道，别浪费。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱软塌，锅底干净"
    },
    {
      "n": 5,
      "text": "倒清水，放香叶，煮开后转小火。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水没过肉就好，别太多。，火候要稳，别忽大忽小。",
      "visual_cue": "汤面翻滚，浮沫聚边"
    },
    {
      "n": 6,
      "text": "盖盖小火炖一小时，中途翻一次。，火候要稳，别忽大忽小。",
      "time_min": 62,
      "heat": "小火",
      "tip": "小火慢炖，肉才软而不柴。，火候要稳，别忽大忽小。",
      "visual_cue": "汤面微沸，肉块转深"
    },
    {
      "n": 7,
      "text": "加胡萝卜块再炖二十分钟。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "小火",
      "tip": "胡萝卜后放，才不会烂成泥。，火候要稳，别忽大忽小。",
      "visual_cue": "胡萝卜微软，形状完整"
    },
    {
      "n": 8,
      "text": "尝味补盐，收汁五分钟上桌。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "收汁到略稠就停。，火候要稳，别忽大忽小。",
      "visual_cue": "汤汁浓稠，油光浮动"
    }
  ],
  "tips": [
    "肉块裹薄粉，炖出来汤汁才稠。，这一点很关键。",
    "锅底焦渣要刮起，味道全在那。，这一点很关键。",
    "胡萝卜后放，形状才完整。，这一点很关键。"
  ],
  "common_mistakes": [
    "肉没吸干，煎不上色。，这一点很关键。",
    "大火炖，肉柴汤干。，这一点很关键。",
    "粉裹太厚，汤成一锅糊。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛腩",
      "ratio": "800 克:800 克",
      "note": "炖的时间加二十分钟。"
    },
    {
      "original": "胡萝卜",
      "substitute": "土豆",
      "ratio": "200 克:250 克",
      "note": "土豆后放，炖十五分钟即可。"
    }
  ],
  "variations": [
    "加一勺越橘酱，酸甜解腻。，这一点很关键。",
    "最后撒欧芹碎，颜色更亮。，这一点很关键。"
  ],
  "serving_suggestion": "配煮土豆或土豆泥，浇上浓汁。，这一点很关键。",
  "storage": "冷藏三天，冷冻一个月。，这一点很关键。",
