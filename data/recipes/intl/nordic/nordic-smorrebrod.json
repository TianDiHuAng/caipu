  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅煮八分钟，捞出过冷水后剥壳切片。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煮八分钟蛋黄刚凝，切片才不会散。",
      "visual_cue": "蛋黄边缘凝固，中心微润"
    },
    {
      "n": 2,
      "text": "奶油奶酪放小碗回温，拌入一半莳萝碎和少许盐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪回温后更好抹，不会撕破面包。",
      "visual_cue": "抹酱顺滑，能看到莳萝碎"
    },
    {
      "n": 3,
      "text": "平底锅放黄油化开，把面包片两面各煎一分半钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "面包煎到边缘金黄，咬下去才够脆。",
      "visual_cue": "边缘金黄，表面干爽"
    },
    {
      "n": 4,
      "text": "生菜沥干水分，铺在煎好的面包片上当作垫底。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生菜一定沥干，否则面包很快回软。",
      "visual_cue": "生菜平铺，没有滴水"
    },
    {
      "n": 5,
      "text": "三文鱼片铺在生菜上面，均匀撒上盐和黑胡椒调味。",
      "time_min": 2,
      "heat": "无火",
      "tip": "鱼片顺着面包长边摆，造型更整齐。",
      "visual_cue": "鱼片层叠整齐，有光泽"
    },
    {
      "n": 6,
      "text": "抹一勺莳萝奶酪，放上鸡蛋片和柠檬角即成。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪最后挤在空隙处，摆盘更有层次。",
      "visual_cue": "表面点缀绿色莳萝与黄色柠檬"
    }
  ],
  "tips": [
    "面包煎到边缘金黄，口感才够香脆。",
    "生菜必须沥干水分，面包才不会回软。",
    "奶酪回温再抹，涂得开也不撕破面包。"
  ],
  "common_mistakes": [
    "面包没煎直接抹酱，几分钟就软塌。",
    "生菜带着水下碗，面包底部渗出一摊水。",
    "鸡蛋煮过了头，蛋黄发青还带着腥味。"
  ],
  "substitutions": [
    {
      "original": "三文鱼",
      "substitute": "烟熏三文鱼",
      "ratio": "150 克:150 克",
      "note": "咸味更足，盐要减半。"
    },
    {
      "original": "奶油奶酪",
      "substitute": "黄油",
      "ratio": "80 克:60 克",
      "note": "更腻，需配柠檬解腻。"
    }
  ],
  "variations": [
    "换成煮虾仁和蛋黄酱，做成海味版本。",
    "加几片腌黄瓜一起摆，酸味更清爽解腻。"
  ],
  "serving_suggestion": "配一杯黑咖啡当早餐，或者切成小块当聚会小食。",
  "storage": "组装后当天吃完，面包冷藏会回软。",
