  "equipment": [
    "保鲜盒",
    "厨房纸",
    "重物",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "三文鱼用厨房纸吸干水分，仔细摸一遍挑掉残留的细刺。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鱼刺要摸一遍，吃的时候才安心。",
      "visual_cue": "表面干爽，没有多余水分"
    },
    {
      "n": 2,
      "text": "盐、白糖和黑胡椒混匀，均匀抹在鱼肉两面，厚度要一致。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腌料要抹匀，厚的地方多抹一点。",
      "visual_cue": "鱼身覆满一层腌料"
    },
    {
      "n": 3,
      "text": "莳萝连梗切碎，厚厚铺在鱼肉表面，把两片鱼叠合起来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "莳萝铺厚一点，香气才透得进去。",
      "visual_cue": "莳萝层均匀铺满鱼身"
    },
    {
      "n": 4,
      "text": "鱼放进保鲜盒上压重物，冷藏腌制二十四小时，中途翻面两次。",
      "time_min": 720,
      "heat": "无火",
      "tip": "中途要翻面两次，腌汁才能均匀渗透。",
      "visual_cue": "鱼肉紧实，渗出清亮汁水"
    },
    {
      "n": 5,
      "text": "取出刮掉腌料，用厨房纸擦干表面，斜刀切成薄片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "刀一定要斜着切，片才够薄够大。",
      "visual_cue": "薄片透光，边缘整齐"
    },
    {
      "n": 6,
      "text": "摆盘后挤上柠檬汁，搭配配菜一起食用即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬汁要现挤，酸香味道最清新。",
      "visual_cue": "表面油润，柠檬点缀"
    }
  ],
  "tips": [
    "鱼一定要选冷冻处理过的，生食才安全。",
    "腌料厚薄要均匀，厚处多抹一点才不会寡淡。",
    "腌够二十四小时并中途翻面，渗透才均匀。"
  ],
  "common_mistakes": [
    "用了没冷冻过的鲜鱼直接生腌，存在寄生虫风险。",
    "盐抹得太薄，四十八小时后鱼肉中间还是生的。",
    "切片时顺着纹理直切，口感变柴还嚼不烂。"
  ],
  "substitutions": [
    {
      "original": "三文鱼",
      "substitute": "虹鳟鱼",
      "ratio": "800 克:800 克",
      "note": "须确认经过冷冻杀虫处理。"
    },
    {
      "original": "莳萝",
      "substitute": "小茴香叶",
      "ratio": "40 克:40 克",
      "note": "香气接近，略带甘草甜。"
    }
  ],
  "variations": [
    "加一勺白兰地进腌料，北欧传统做法。",
    "配芥末酱汁食用，酸甜辛香更平衡。"
  ],
  "serving_suggestion": "切薄片配黑麦面包、煮土豆和芥末酱，是北欧节日餐桌和圣诞自助的标准冷盘。",
  "storage": "冷藏三天，切片后用保鲜膜贴面封好，避免表面风干发硬。",
