  "equipment": [
    "汤锅",
    "木勺",
    "滤网",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蓝莓和草莓洗净，草莓去蒂切块。，注意锅里温度别掉下来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冻蓝莓不用解冻，直接下锅。，始终中小火，别心急。",
      "visual_cue": "果粒干净，草莓切面平整"
    },
    {
      "n": 2,
      "text": "锅里加清水和水果，中火煮开。，火要均匀，食材才不糊。",
      "time_min": 7,
      "heat": "中火",
      "tip": "水开后会溢，锅别太满。，看住火，别让它失控。",
      "visual_cue": "汤面翻滚，果粒浮起"
    },
    {
      "n": 3,
      "text": "转小火煮十分钟，把果粒压碎。，全程留意火候，别贪快。",
      "time_min": 12,
      "heat": "小火",
      "tip": "压碎一点，汤色才浓。，火大了就离锅远一点。",
      "visual_cue": "果肉散开，汤色紫红"
    },
    {
      "n": 4,
      "text": "玉米淀粉加两勺冷水调开。，火别开太大，稳着来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调开再下锅，不然会结块。，锅温要匀，别忽高忽低。",
      "visual_cue": "粉水均匀，无颗粒，别小看这一步。"
    },
    {
      "n": 5,
      "text": "边搅边倒粉水，煮到汤体微稠。，火力保持中等，慢慢来。",
      "time_min": 5,
      "heat": "小火",
      "tip": "一直搅，淀粉沉底就糊。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤体挂勺，流动缓慢"
    },
    {
      "n": 6,
      "text": "加白糖和柠檬汁，尝味调整。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "小火",
      "tip": "柠檬提亮酸度，糖别一次加完。，始终中小火，别心急。",
      "visual_cue": "酸甜平衡，香气清亮"
    },
    {
      "n": 7,
      "text": "盛碗冷藏或热饮，淋一点淡奶油。，火要均匀，食材才不糊。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷热都行，冷藏后更稠。，看住火，别让它失控。",
      "visual_cue": "表面奶纹，汤色透亮"
    }
  ],
  "tips": [
    "粉水先调开，下锅才不结块。，成败就在这一步。",
    "柠檬汁提亮酸度，别省。，这点要注意。",
    "冷藏后会更稠，水可稍多。，这是关键点。"
  ],
  "common_mistakes": [
    "淀粉直接撒锅里，结成一团。，别嫌麻烦，做完它。",
    "糖加太多，酸味被盖住。，这一步别省。",
    "大火煮久，果香全跑掉。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "蓝莓",
      "substitute": "黑加仑",
      "ratio": "450 克:450 克",
      "note": "酸度更高，糖加二十克。"
    },
    {
      "original": "淡奶油",
      "substitute": "酸奶",
      "ratio": "80 毫升:80 克",
      "note": "更清爽，酸味更明显。"
    }
  ],
  "variations": [
    "加一片姜，冬天喝更暖。，这步最关键。",
    "撒燕麦脆，当早餐碗。，很多人在这里出错。"
  ],
  "serving_suggestion": "冷天热饮，夏天加冰当冷汤。，这里最容易翻车。",
  "storage": "冷藏三天，冷冻一个月。，别小看这一步。",
