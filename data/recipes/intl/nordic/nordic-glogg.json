 "equipment": [
  "汤锅",
  "刀",
  "削皮刀",
  "漏勺"
 ],
 "steps": [
  {
   "n": 1,
   "text": "苹果去皮，用小勺挖掉果核，保持整颗。，火候要稳，别忽大忽小。",
   "time_min": 9,
   "heat": "无火",
   "tip": "挖核别挖穿，煮时才好成形。，火候要稳，别忽大忽小。",
   "visual_cue": "果身完整，孔洞干净"
  },
  {
   "n": 2,
   "text": "柠檬挤汁抹在苹果表面。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "抹酸防氧化，苹果才不发黑。，火候要稳，别忽大忽小。",
   "visual_cue": "果面湿亮，颜色洁白"
  },
  {
   "n": 3,
   "text": "锅里倒红酒，加白糖、桂皮和丁香。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "香料装袋，捞的时候省事。，火候要稳，别忽大忽小。",
   "visual_cue": "酒液深红，香料沉底"
  },
  {
   "n": 4,
   "text": "削一片橙皮放入，小火加热到糖化。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "小火",
   "tip": "糖化就行，别煮沸。，火候要稳，别忽大忽小。",
   "visual_cue": "液面小泡，糖粒消失"
  },
  {
   "n": 5,
   "text": "放入苹果，小火煮二十分钟，翻一次面。，火候要稳，别忽大忽小。",
   "time_min": 22,
   "heat": "小火",
   "tip": "液面刚过果身一半就好。，火候要稳，别忽大忽小。",
   "visual_cue": "果身转红，香气上涌"
  },
  {
   "n": 6,
   "text": "关火浸十分钟，让颜色吃进去。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "浸泡比久煮更入味，果肉也不散。，火候要稳，别忽大忽小。",
   "visual_cue": "果色均匀，酒香透心"
  },
  {
   "n": 7,
   "text": "漏勺捞起苹果，装盘。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "轻拿轻放，果肉很软。，火候要稳，别忽大忽小。",
   "visual_cue": "果形完整，汁水清亮"
  },
  {
   "n": 8,
   "text": "余汁大火收浓，淋在苹果上。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "中火",
   "tip": "收到能挂勺就停，太稠会发苦。，火候要稳，别忽大忽小。",
   "visual_cue": "汁液挂勺，颜色透亮"
  }
 ],
 "tips": [
  "苹果挖核别挖穿，煮时才成形。，这一点很关键。",
  "小火慢煮，滚起来果肉就散。，这一点很关键。",
  "余汁收浓再淋，味道才集中。，这一点很关键。"
 ],
 "common_mistakes": [
  "大火煮，苹果煮成泥。，这一点很关键。",
  "没抹柠檬汁，果肉发褐。，这一点很关键。",
  "汁收太干，糖分焦化成苦味。，这一点很关键。"
 ],
 "substitutions": [
  {
   "original": "红酒",
   "substitute": "葡萄汁",
   "ratio": "400 毫升:400 毫升",
   "note": "无酒精版，糖减二十克。"
  },
  {
   "original": "苹果",
   "substitute": "梨",
   "ratio": "700 克:700 克",
   "note": "果肉更软，煮的时间减五分。"
  }
 ],
 "variations": [
  "塞一颗杏仁在果核孔里，口感更有层次。",
  "配一球香草冰淇淋，冷热对比好。，这一点很关键。"
 ],
 "serving_suggestion": "圣诞餐桌的冷甜点，温热或冷藏都行。",
 "storage": "连汁冷藏三天。，这一点很关键。，很多人就是漏了这一步。",
