        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 130,
          "unit": "g",
          "note": "打蛋",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 5,
          "unit": "g",
          "note": "抹模具",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "打蛋盆",
    "烤模"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到一百七十五度，烤模内壁抹黄油并撒一层面粉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "撒粉防粘，脱模才完整。",
      "visual_cue": "模具内壁均匀挂粉"
    },
    {
      "n": 2,
      "text": "黄油放小锅小火融化，离火后加入可可粉搅匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "趁热拌可可粉，味道才融得开。",
      "visual_cue": "混合物顺滑发亮，无颗粒"
    },
    {
      "n": 3,
      "text": "鸡蛋加白糖与盐，用打蛋器打到颜色发白发稠。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打到蛋糊能画出纹路。",
      "visual_cue": "蛋糊发白，体积变大"
    },
    {
      "n": 4,
      "text": "把可可黄油倒进蛋糊，用刮刀翻拌到颜色均匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "慢慢倒，边倒边拌不易分离。",
      "visual_cue": "面糊呈深褐色，质地顺滑"
    },
    {
      "n": 5,
      "text": "筛入面粉，用刮刀翻拌到刚好看不见干粉的时候立刻停手。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌过头口感会变硬，不能多拌。",
      "visual_cue": "面糊浓稠，无干粉"
    },
    {
      "n": 6,
      "text": "面糊倒进烤模里面，用刮刀把表面仔细抹平整。",
      "time_min": 2,
      "heat": "无火",
      "tip": "抹平表面，烤出来才好看。",
      "visual_cue": "表面平整，厚度均匀"
    },
    {
      "n": 7,
      "text": "放进烤箱中层烤十八分钟，看到中心仍微微晃动就可以出炉。",
      "time_min": 18,
      "heat": "中火",
      "tip": "中心略软是特色，烤干了就变普通蛋糕。",
      "visual_cue": "边缘定型，中心轻晃"
    },
    {
      "n": 8,
      "text": "出炉后连模具一起放凉十分钟，让余温把中心部分慢慢定型。",
      "time_min": 10,
      "heat": "无火",
      "tip": "别急着脱模，会塌陷。",
      "visual_cue": "表面微微下陷，边缘收紧"
    },
    {
      "n": 9,
      "text": "脱模后在表面撒一层可可粉，切块装盘即食。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁微温吃，中心最润。",
      "visual_cue": "切面湿润，中间略流心"
    }
  ],
  "tips": [
    "烤到中心微晃就出炉，凉后刚好湿润。",
    "面粉拌到无干粉即停，多拌会变硬。",
    "脱模前放凉十分钟，形状才完整。"
  ],
  "common_mistakes": [
    "烤到完全定型，成品干硬像饼干。",
    "面粉拌太久，蛋糕失去湿润口感。",
    "热着就脱模，蛋糕会直接塌成一团。"
  ],
  "substitutions": [
    {
      "original": "可可粉",
      "substitute": "黑巧克力",
      "ratio": "30 克:80 克",
      "note": "需先融化，风味更浓。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "120 克:100 克",
      "note": "口感略轻，奶香更弱。"
    }
  ],
  "variations": [
    "面糊里加一勺速溶咖啡粉，可可味更突出。",
    "表面撒少许海盐，甜咸对比更明显。"
  ],
  "serving_suggestion": "切块配香草冰淇淋或咖啡，当下午茶。",
  "storage": "密封室温两天、冷藏四天，回温后食用。",
