  "steps": [
    {
      "n": 1,
      "text": "汤锅小火化开黄油，下洋葱、胡萝卜与芹菜炒六分钟至蔬菜变软出香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蔬菜炒软，汤才不寡。",
      "visual_cue": "蔬菜软化、洋葱透明"
    },
    {
      "n": 2,
      "text": "撒入面粉不停搅拌炒两分钟，让面粉裹住蔬菜形成面糊底。",
      "time_min": 5,
      "heat": "小火",
      "tip": "面粉要炒熟，汤才不粉。",
      "visual_cue": "面糊起泡、无干粉"
    },
    {
      "n": 3,
      "text": "分次倒入清水边倒边搅，再加土豆丁煮十五分钟至土豆软烂。",
      "time_min": 15,
      "heat": "中火",
      "tip": "分次加水，避免结块。",
      "visual_cue": "汤汁浓稠、土豆软糯"
    },
    {
      "n": 4,
      "text": "放入鳕鱼块小火煮五分钟，倒入牛奶煮到微沸，加盐与白胡椒。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶别煮沸，会分层。",
      "visual_cue": "鱼块变白、汤色乳白"
    },
    {
      "n": 5,
      "text": "盛碗撒莳萝碎，配一片黑麦面包与黄油上桌，趁热食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "莳萝最后撒，香气才留。",
      "visual_cue": "汤面浮绿、质地顺滑"
    }
  ],
  "tips": [
    "面粉要在黄油里炒熟再加水，否则汤带生粉味。",
    "牛奶最后加并保持微沸，滚沸会油水分离。",
    "鳕鱼块最后五分钟才下，久煮散成碎渣。"
  ],
  "common_mistakes": [
    "清水一次性倒进面糊，结成一锅疙瘩。",
    "牛奶大火煮沸，汤面浮起一层絮状物。",
    "土豆切太大，煮到鱼都散了还没软。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "鲈鱼",
      "ratio": "500g 对 500g",
      "note": "肉质更细，煮制时间减 1 分钟。"
    },
    {
      "original": "牛奶",
      "substitute": "奶油",
      "ratio": "200ml 对 150ml",
      "note": "质地更浓，可加水 50ml。"
    }
  ],
  "variations": [
    "虾味版：加 200g 虾同煮。",
    "番茄版：加 150g 番茄丁，牛奶减半。"
  ],
  "serving_suggestion": "配黑麦面包与黄油，撒白胡椒与莳萝碎。",
  "storage": "冷藏可存 2 天，复热须小火并不断搅拌。",
