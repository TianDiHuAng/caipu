  "equipment": [
    "厚底锅",
    "木勺",
    "大碗",
    "打蛋器",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米冲洗两遍，加牛奶和盐小火煮。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶别煮开，边煮边搅。，火候要稳，别忽大忽小。",
      "visual_cue": "锅边小泡，米粒沉底"
    },
    {
      "n": 2,
      "text": "盖盖留缝煮三十五分钟，每五分钟搅一次。，火候要稳，别忽大忽小。",
      "time_min": 37,
      "heat": "小火",
      "tip": "不搅就粘底，焦味整锅都有。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒膨胀，糊体浓稠"
    },
    {
      "n": 3,
      "text": "倒进大碗摊开，盖膜放凉。，火候要稳，别忽大忽小。",
      "time_min": 20,
      "heat": "无火",
      "tip": "贴膜防结皮，凉透才好拌。，火候要稳，别忽大忽小。",
      "visual_cue": "表面平滑，彻底放凉"
    },
    {
      "n": 4,
      "text": "淡奶油加白糖，打到七分发。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打到有纹路但会流动。，火候要稳，别忽大忽小。",
      "visual_cue": "奶油蓬松，纹路柔缓"
    },
    {
      "n": 5,
      "text": "分两次把奶油拌进米糊，轻手翻拌。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "翻拌别搅打，否则会出水。，火候要稳，别忽大忽小。",
      "visual_cue": "糊体轻盈，颜色乳白"
    },
    {
      "n": 6,
      "text": "拌入大部分杏仁碎，留一点撒面。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "杏仁烘过更香。，火候要稳，别忽大忽小。",
      "visual_cue": "果仁分布均匀，这一点很关键。"
    },
    {
      "n": 7,
      "text": "盛碗撒杏仁，冷藏半小时再吃。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冷藏后口感更浓稠。，火候要稳，别忽大忽小。",
      "visual_cue": "表面雪白，点缀鲜亮"
    }
  ],
  "tips": [
    "用圆粒米，煮出来才稠。，这一点很关键。",
    "米糊要彻底放凉再拌奶油。，这一点很关键。",
    "奶油打到七分发，口感才轻。，这一点很关键。"
  ],
  "common_mistakes": [
    "米糊没凉就拌，奶油化成水。，这一点很关键。",
    "奶油打过头，成品发干。，这一点很关键。",
    "锅底没搅，糊味盖不住。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "酸奶",
      "ratio": "250 毫升:250 克",
      "note": "酸味更明显，白糖加十克。"
    },
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "50 克:50 克",
      "note": "烘过再切，香气更浓。"
    }
  ],
  "variations": [
    "藏一颗整杏仁在碗底，吃到的人有礼物。",
    "淋热樱桃酱，冷热对比更好。，这一点很关键。"
  ],
  "serving_suggestion": "圣诞夜配热红酒，或当夏天冷甜点。",
  "storage": "冷藏两天，表面盖膜。，这一点很关键。",
