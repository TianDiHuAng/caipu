  "flavor": [
    "sweet",
    "sour",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "蓝莓",
          "name_en": "blueberry",
          "amount": 500,
          "unit": "g",
          "note": "冷冻或新鲜均可",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "按酸甜调整",
          "optional": false
        },
        {
          "name": "水",
          "name_en": "water",
          "amount": 600,
          "unit": "ml",
          "note": "煮汤用",
          "optional": false
        },
        {
          "name": "土豆淀粉",
          "name_en": "potato-starch",
          "amount": 15,
          "unit": "g",
          "note": "勾薄芡",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 15,
          "unit": "g",
          "note": "取汁",
          "optional": false
        },
        {
          "name": "肉桂粉",
          "name_en": "ground-cinnamon",
          "amount": 1,
          "unit": "g",
          "note": "可选增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "手持搅拌棒",
    "细筛",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蓝莓和水一起下锅，中火煮开后转小火煮十分钟至果粒全部裂开。",
      "time_min": 13,
      "heat": "中火",
      "tip": "冷冻蓝莓不用解冻，直接下锅更省事。",
      "visual_cue": "汤色深紫，果粒软塌"
    },
    {
      "n": 2,
      "text": "用手持搅拌棒把果粒打成浆，再煮两分钟让味道融合。",
      "time_min": 4,
      "heat": "小火",
      "tip": "打浆前离火，避免溅出烫伤。",
      "visual_cue": "汤体顺滑，看不见整颗果粒"
    },
    {
      "n": 3,
      "text": "土豆淀粉加两勺冷水调匀，慢慢倒进汤里边倒边搅。",
      "time_min": 2,
      "heat": "小火",
      "tip": "淀粉水必须用冷水调，否则立刻结块。",
      "visual_cue": "汤体略稠，能挂住勺背"
    },
    {
      "n": 4,
      "text": "加白糖和肉桂粉搅匀，煮一分钟至糖完全化开，尝味后补柠檬汁。",
      "time_min": 3,
      "heat": "小火",
      "tip": "柠檬汁最后加，酸味才清晰。",
      "visual_cue": "甜酸平衡，入口先是果香"
    },
    {
      "n": 5,
      "text": "离火放凉到室温，再冷藏一小时至冰凉，喝前搅匀。",
      "time_min": 60,
      "heat": "无火",
      "tip": "冷藏后稠度会增加，太稠可加冷水调稀。",
      "visual_cue": "冷汤浓稠冰凉，表面有光泽"
    }
  ],
  "tips": [
    "用冷冻蓝莓颜色更深，甜度也更稳定。",
    "想当饮品喝，淀粉减半并加一百毫升水。",
    "配一勺淡奶油淋在表面，是瑞典传统吃法。"
  ],
  "common_mistakes": [
    "淀粉水直接倒进滚汤，整锅出现白色疙瘩。",
    "白糖一次加得太多，冷藏后甜得发腻。",
    "热着喝判断甜度，凉了之后味道会变淡。"
  ],
  "substitutions": [
    {
      "original": "蓝莓",
      "substitute": "黑加仑",
      "ratio": "500克:500克",
      "note": "酸度更高，糖加到一百克。"
    },
    {
      "original": "土豆淀粉",
      "substitute": "玉米淀粉",
      "ratio": "15克:12克",
      "note": "稠度更强，用量要少一点。"
    }
  ],
  "variations": [
    "加几片薄荷叶同煮，清凉感更明显。",
    "冬天做成热饮版，加一片柠檬皮增香。"
  ],
  "serving_suggestion": "冰镇后盛进玻璃杯，淋一勺淡奶油或配一块燕麦饼干，是北欧夏末的家常甜点。",
  "storage": "冷藏三天，冷冻一个月；复热须小火搅拌防糊底。",
