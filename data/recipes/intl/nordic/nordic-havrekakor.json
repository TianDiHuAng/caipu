    "烘焙纸",
    "打蛋盆",
    "擀面杖",
    "圆形切模"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油小火融化后放凉到不烫手，加白糖搅到糖粒基本化开。",
      "time_min": 6,
      "heat": "小火",
      "tip": "黄油别烧到冒烟，焦了会抢味。",
      "visual_cue": "液体浅黄，碗底无颗粒沉底"
    },
    {
      "n": 2,
      "text": "打入鸡蛋搅匀，再倒牛奶拌成均匀的黄油蛋液。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鸡蛋回温后再加，冷蛋会让黄油结块。",
      "visual_cue": "蛋液顺滑，表面无油水分离"
    },
    {
      "n": 3,
      "text": "燕麦、面粉、小苏打和盐混匀，倒进黄油蛋液里翻拌成团。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌到没有干粉就停，揉久了饼干发硬。",
      "visual_cue": "面团粗糙有颗粒感，不粘手"
    },
    {
      "n": 4,
      "text": "面团压成一厘米厚的片，用切模压出圆饼，铺在垫纸烤盘上。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致，烤出来才同时熟。",
      "visual_cue": "圆饼边缘整齐，间距两厘米"
    },
    {
      "n": 5,
      "text": "烤箱一百八十度烤十五分钟，边缘金黄即可出炉。",
      "time_min": 15,
      "heat": "中火",
      "tip": "最后三分钟盯着，燕麦容易上色过头。",
      "visual_cue": "边缘深金，中心浅褐"
    },
    {
      "n": 6,
      "text": "连纸拖到网架上晾十分钟，完全冷却后密封保存。",
      "time_min": 12,
      "heat": "无火",
      "tip": "趁热移动会碎，凉透才定型。",
      "visual_cue": "饼干硬挺，掰开断面干燥"
    }
  ],
  "tips": [
    "燕麦换成粗燕麦片，口感更有嚼劲。",
    "加一把葡萄干或蔓越莓干，酸甜更明显。",
    "面团太干加一勺牛奶，太湿加一勺燕麦。"
  ],
  "common_mistakes": [
    "面团揉太久，饼干烤完硬得咬不动。",
    "饼压得太厚，表面焦了中心还是软的。",
    "烤好不晾就叠放，全部粘成一摞。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "椰子油",
      "ratio": "120克:100克",
      "note": "带椰香，面团略干可加牛奶。"
    },
    {
      "original": "面粉",
      "substitute": "全麦面粉",
      "ratio": "80克:80克",
      "note": "口感更粗，颜色偏深。"
    }
  ],
  "variations": [
    "加一勺肉桂粉，做成冬季香料版。",
    "表面压一颗杏仁，做成节庆款待客点心。"
  ],
  "serving_suggestion": "配咖啡或红茶，也可以夹一层果酱做成小甜点，是瑞典人下午茶的家常标配。",
  "storage": "密封常温一周，冷冻一个月；受潮后一百五十度回烤五分钟恢复脆感。",
