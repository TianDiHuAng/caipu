  "equipment": [
    "锅",
    "平底锅",
    "玻璃碗",
    "木勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苹果去皮去核，切小块，挤柠檬汁拌匀。，火别开太大，稳着来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "柠檬防氧化，苹果才不发黑。，锅温要匀，别忽高忽低。",
      "visual_cue": "果块洁白，果汁清亮"
    },
    {
      "n": 2,
      "text": "苹果加一半白糖和桂皮，小火煮十五分钟。，火力保持中等，慢慢来。",
      "time_min": 17,
      "heat": "小火",
      "tip": "煮到软但不烂，留点颗粒感。，火候宁小勿大，慢慢推进。",
      "visual_cue": "果块软塌，汁水收浓"
    },
    {
      "n": 3,
      "text": "平底锅化黄油，倒面包糠小火炒到金黄。，注意锅里温度别掉下来。",
      "time_min": 6,
      "heat": "小火",
      "tip": "不停翻，糠很容易焦。，始终中小火，别心急。",
      "visual_cue": "糠色金褐，香气酥脆"
    },
    {
      "n": 4,
      "text": "炒好的糠加剩余白糖拌匀放凉。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "凉了才脆，热的时候会闷软。，看住火，别让它失控。",
      "visual_cue": "糠粒松散，甜香明显"
    },
    {
      "n": 5,
      "text": "淡奶油打到七分发，能缓慢流动。，全程留意火候，别贪快。",
      "time_min": 4,
      "heat": "无火",
      "tip": "太硬会盖住苹果味。，火大了就离锅远一点。",
      "visual_cue": "奶油蓬松，纹路柔缓"
    },
    {
      "n": 6,
      "text": "玻璃碗里铺一层苹果，撒一层糠，重复两层。，火别开太大，稳着来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "层数分明，看着才有食欲。，锅温要匀，别忽高忽低。",
      "visual_cue": "层次清晰，颜色交替"
    },
    {
      "n": 7,
      "text": "顶层挤奶油，撒剩余糠，冷藏半小时。，火力保持中等，慢慢来。",
      "time_min": 32,
      "heat": "无火",
      "tip": "现做现吃，糠才不软。，火候宁小勿大，慢慢推进。",
      "visual_cue": "顶层雪白，糠粒金黄"
    }
  ],
  "tips": [
    "苹果煮到软而不烂，留点口感。，这里最容易翻车。",
    "面包糠要小火不停翻，容易焦。，别小看这一步。",
    "吃之前再叠，糠才够脆。，成败就在这一步。"
  ],
  "common_mistakes": [
    "苹果煮成泥，吃起来没层次。，这点要注意。",
    "糠炒焦了，苦味盖住甜味。，这是关键点。",
    "提前叠好放久，糠全软掉。，别嫌麻烦，做完它。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "梨",
      "ratio": "700 克:700 克",
      "note": "水分更多，煮的时间加五分。"
    },
    {
      "original": "面包糠",
      "substitute": "燕麦",
      "ratio": "80 克:80 克",
      "note": "需先烘香，口感更粗。"
    }
  ],
  "variations": [
    "加一勺越橘酱，酸甜更明显。，这一步别省。",
    "表面撒杏仁片，口感更丰富。，别跳过这步。"
  ],
  "serving_suggestion": "冷吃当甜点，配一杯红茶。，这步最关键。",
  "storage": "冷藏一天，糠会变软。，很多人在这里出错。",
