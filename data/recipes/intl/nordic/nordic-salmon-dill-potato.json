  "equipment": [
    "烤箱",
    "烤盘",
    "锡纸",
    "煮锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "三文鱼排用厨房纸吸干表面水分，两面抹盐与黑胡椒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "吸干水分再调味，烤出来的皮才脆。",
      "visual_cue": "鱼排表面干爽，盐粒均匀"
    },
    {
      "n": 2,
      "text": "烤盘铺锡纸，鱼皮朝下放好，静置十分钟入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置能让盐渗进去，鱼肉更紧实。",
      "visual_cue": "鱼肉微微收紧，渗出少量水"
    },
    {
      "n": 3,
      "text": "小土豆洗净不削皮，冷水下锅加盐煮二十分钟。",
      "time_min": 22,
      "heat": "中火",
      "tip": "带着皮煮，土豆的香气才不流失。",
      "visual_cue": "筷子能轻松插透，皮微微开裂"
    },
    {
      "n": 4,
      "text": "煮好的土豆沥干，趁热拌入一半融化的黄油和莳萝。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热拌进黄油，香味才裹得住土豆。",
      "visual_cue": "土豆油亮，莳萝碎粘得均匀"
    },
    {
      "n": 5,
      "text": "烤箱预热到一百九十度，鱼排上摆几片柠檬。",
      "time_min": 6,
      "heat": "中火",
      "tip": "柠檬铺面，果香随热气渗进鱼肉。",
      "visual_cue": "柠檬片铺满鱼排，黄绿相间"
    },
    {
      "n": 6,
      "text": "把剩余黄油淋在鱼排上，送进烤箱烤十二分钟。",
      "time_min": 13,
      "heat": "中火",
      "tip": "黄油淋面，鱼肉不干，表皮带香。",
      "visual_cue": "黄油滋滋冒泡，鱼皮略卷"
    },
    {
      "n": 7,
      "text": "取出后静置三分钟，让鱼汁重新回流到肉里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置之后再切，肉汁才不会流失。",
      "visual_cue": "鱼排表面微鼓，汁水清亮"
    },
    {
      "n": 8,
      "text": "土豆装盘垫底，鱼排摆在上面，撒剩余莳萝碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "土豆垫在底下吸汁，摆盘也更稳当。",
      "visual_cue": "绿白黄相衬，油光点点"
    },
    {
      "n": 9,
      "text": "挤上柠檬汁，再撒少许现磨黑胡椒即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "上桌前挤上柠檬酸汁，清香最明显。",
      "visual_cue": "鱼肉分层，柠檬酸香扑鼻"
    }
  ],
  "tips": [
    "三文鱼吸干水分再调味，烤出来皮才脆。",
    "土豆带皮煮，香气足，口感也更粉。",
    "烤好静置三分钟再切，肉汁锁得住。"
  ],
  "common_mistakes": [
    "鱼排湿着进烤箱，出来一汪水，皮也软塌。",
    "烤过头，鱼肉发白发干，一叉就散。",
    "刚出炉就切，肉汁全流在盘子里。"
  ],
  "substitutions": [
    {
      "original": "三文鱼",
      "substitute": "鳕鱼",
      "ratio": "500 克:500 克",
      "note": "肉质更白更紧，烤的时间减两分钟。"
    },
    {
      "original": "莳萝",
      "substitute": "欧芹",
      "ratio": "15 克:15 克",
      "note": "香气不同，但同样清爽。"
    }
  ],
  "variations": [
    "配一勺酸奶油与芥末调成的酱，北欧味更足。",
    "撒一把烤香的芝麻，口感更丰富。"
  ],
  "serving_suggestion": "土豆垫底、鱼排压顶，配一杯冰水与黑麦面包，是北欧人的日常一餐。",
  "storage": "冷藏一天，复热用一百六十度烤八分钟，别用高火。",
