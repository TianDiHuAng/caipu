  "id": "nordic-cardamom-buns",
  "name": {
    "zh": "北欧小豆蔻面包卷",
    "en": "Cardamom Buns",
    "original": "Kardemummabullar"
  },
  "cuisine": {
    "region": "intl",
    "style": "nordic"
  },
  "category": [
    "bakery"
  ],
  "difficulty": 3,
  "time": {
    "prep_min": 120,
    "cook_min": 25,
    "total_min": 145
  },
  "servings": 6,
  "flavor": [
    "sweet",
    "fragrant",
    "rich"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 450,
          "unit": "g",
          "note": "高筋面粉",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 120,
          "unit": "g",
          "note": "其中六十克用于夹馅",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 240,
          "unit": "ml",
          "note": "温热至三十五度",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 7,
          "unit": "g",
          "note": "耐高糖酵母",
          "optional": false
        },
        {
          "name": "豆蔻",
          "name_en": "cardamom",
          "amount": 4,
          "unit": "g",
          "note": "现磨成粉",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 60,
          "unit": "g",
          "note": "面团与夹馅各半",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 1,
          "unit": "piece",
          "note": "刷面用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "增强筋性",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "烤箱",
    "擀面杖",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温牛奶加一半蜂蜜搅匀，撒入干酵母静置五分钟起泡。",
      "time_min": 5,
      "heat": "无火",
      "tip": "牛奶别超过四十度，太烫会把酵母烫死。",
      "visual_cue": "表面浮起一层细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉与盐、一半豆蔻粉混匀，倒入酵母牛奶搅成絮状。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐别直接碰酵母，分开拌更稳。",
      "visual_cue": "面粉结团，没有干粉堆积"
    },
    {
      "n": 3,
      "text": "揉面十分钟至面团光滑，再加入四十克软黄油揉匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黄油分次加，面团才吃得进去。",
      "visual_cue": "面团光滑有弹性，能拉出薄膜"
    },
    {
      "n": 4,
      "text": "盖湿布室温发酵六十分钟，发到体积变成两倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "放温暖处发酵，温度低会拖很久。",
      "visual_cue": "面团膨胀两倍，手指戳洞不回缩"
    },
    {
      "n": 5,
      "text": "剩余软黄油拌入剩下的蜂蜜与豆蔻粉，做成夹馅。",
      "time_min": 4,
      "heat": "无火",
      "tip": "夹馅要软到能抹开，别用冷藏硬块。",
      "visual_cue": "夹馅顺滑，香气浓郁"
    },
    {
      "n": 6,
      "text": "面团擀成三十乘四十厘米的长方片，均匀抹上夹馅。",
      "time_min": 5,
      "heat": "无火",
      "tip": "边缘留一厘米不抹，卷起才不流。",
      "visual_cue": "夹馅铺满，厚薄均匀"
    },
    {
      "n": 7,
      "text": "从长边卷成条，切成六段，每段中间压一道深痕。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用筷子压到底，烤出来花纹才开。",
      "visual_cue": "六段面团大小一致，纹路清晰"
    },
    {
      "n": 8,
      "text": "二次发酵三十分钟，表面刷蛋液后撒少量豆蔻粉。",
      "time_min": 30,
      "heat": "无火",
      "tip": "二发到位，烤出来才松软。",
      "visual_cue": "面团轻按缓慢回弹"
    },
    {
      "n": 9,
      "text": "烤箱两百度烤十五分钟，表面金黄即可出炉。",
      "time_min": 15,
      "heat": "中火",
      "tip": "中途转盘一次，上色才均匀。",
      "visual_cue": "表面深金，底部不焦"
    },
    {
      "n": 10,
      "text": "出炉放烤架晾十分钟，温热时食用口感最好。",
      "time_min": 5,
      "heat": "无火",
      "tip": "趁温热吃，豆蔻香最明显。",
      "visual_cue": "外皮微脆，掰开层次分明"
    }
  ],
  "tips": [
    "牛奶温热到三十五度最适合酵母，手摸微温即可。",
    "黄油必须软化后再揉进面团，冷藏硬块会撕裂面筋。",
    "二发别省，压痕烤后能否张开全看这一步。"
  ],
  "common_mistakes": [
    "牛奶太烫，酵母被烫死，面团发不起来。",
    "夹馅用冷藏硬黄油，卷的时候整片裂开。",
    "二发时间不够就进烤箱，成品又硬又小。"
  ],
  "substitutions": [
    {
      "original": "小豆蔻",
      "substitute": "肉桂",
      "ratio": "4 克:5 克",
      "note": "风味更甜暖，接近肉桂卷。"
    },
    {
      "original": "蜂蜜",
      "substitute": "炼乳",
      "ratio": "60 克:60 克",
      "note": "上色更快，烘烤时间可减两分钟。"
    }
  ],
  "variations": [
    "表面撒一层粗粒糖，咬下去有清脆的响声。",
    "夹馅里加一小撮盐，甜味更立体。"
  ],
  "serving_suggestion": "配一杯黑咖啡或热红茶，当早餐或下午茶。",
  "storage": "密封常温放两天，冷冻两周，回烤五分钟恢复松软。",
