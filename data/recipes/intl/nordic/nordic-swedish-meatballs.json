  "equipment": [
    "平底锅",
    "碗",
    "砧板",
    "厨师刀",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包糠倒牛奶泡软五分钟，洋葱切极细的碎末，用少量黄油炒到透明放凉。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱要炒到没有辛辣生味，放凉后再拌肉馅不出汤。",
      "visual_cue": "面包糠吸饱牛奶发胀，洋葱碎呈半透明"
    },
    {
      "n": 2,
      "text": "牛肉末与猪肉末混合，加鸡蛋、盐、黑胡椒和肉豆蔻，顺一个方向搅到起胶。",
      "time_min": 8,
      "heat": "无火",
      "tip": "搅打到肉馅发黏能整团拉起，丸子煎时才不散。",
      "visual_cue": "肉馅紧实有黏性，颜色均匀发亮"
    },
    {
      "n": 3,
      "text": "拌入泡好的面包糠与洋葱碎，冷藏十分钟后搓成乒乓球大小的圆丸。",
      "time_min": 8,
      "heat": "无火",
      "tip": "手沾凉水再搓，肉馅不粘手，丸子表面更光滑。",
      "visual_cue": "丸子圆整光滑，大小均匀如乒乓球"
    },
    {
      "n": 4,
      "text": "平底锅化开黄油，中小火把肉丸滚动煎到四周金黄，倒入少许水盖盖焖五分钟。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "不断摇晃锅子让丸子滚圆定型，受热均匀不焦底。",
      "visual_cue": "丸子通体金褐，按压有弹性"
    },
    {
      "n": 5,
      "text": "盛出丸子，锅里撒面粉炒香，倒奶油煮到浓稠，加盐调味后浇回肉丸上。",
      "time_min": 6,
      "heat": "小火",
      "tip": "奶油不要滚沸，微沸状态搅动才不会结皮分层。",
      "visual_cue": "酱汁乳白稠滑，能裹住丸身如薄纱"
    }
  ],
  "tips": [
    "牛猪肉各半最香，全用瘦肉会干柴，全用肥肉又腻口。",
    "肉馅搅打起胶是关键，黏性足丸子才不散不裂。",
    "奶油酱要现做现浇，放凉后表面容易结出一层皮。"
  ],
  "common_mistakes": [
    "肉馅没搅打上劲就搓丸，下锅一煎就散成碎肉。",
    "洋葱没炒透直接拌入，煎后出水让丸子发软散形。",
    "奶油酱煮沸时间过长，乳脂分离出现颗粒与浮油。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "牛奶",
      "ratio": "1:1",
      "note": "用牛奶更清爽，需多加五克面粉增稠。"
    },
    {
      "original": "面包糠",
      "substitute": "吐司",
      "ratio": "50 克:2 片",
      "note": "吐司撕碎泡软代替，口感更松。"
    }
  ],
  "variations": [
    "丸子搓好后冷冻定型再煎，可一次多做当作便当常备菜。"
  ],
  "serving_suggestion": "配越橘酱、盐渍黄瓜与土豆泥，是瑞典家庭的传统组合。",
  "storage": "冷藏三天，冷冻一个月；复热连酱汁小火加热，不要用微波炉干烤。",
