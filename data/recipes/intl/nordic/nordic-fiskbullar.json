  "equipment": [
    "料理机",
    "刮刀",
    "汤锅",
    "平底锅",
    "冰淇淋勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼块用厨房纸吸干水分，切小块后与洋葱末一起放进料理机。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼块吸水不彻底，丸子会散。",
      "visual_cue": "鱼块表面干爽，无多余水分"
    },
    {
      "n": 2,
      "text": "加蛋清和一半牛奶，脉冲搅打到成细腻鱼浆，中途停下刮两次壁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "不能连续高速打，否则鱼肉发热变散。",
      "visual_cue": "鱼浆细腻有黏性，能整团提起"
    },
    {
      "n": 3,
      "text": "鱼浆倒进碗里，加面粉、剩下的盐和白胡椒，顺一个方向搅两分钟上劲。",
      "time_min": 4,
      "heat": "无火",
      "tip": "剩下的牛奶分次加入，稠度以能成团为准。",
      "visual_cue": "鱼浆黏稠，勺背挂浆不掉"
    },
    {
      "n": 4,
      "text": "汤锅烧开水，加剩下的盐，用冰淇淋勺把鱼浆舀成球下锅。",
      "time_min": 6,
      "heat": "中火",
      "tip": "水保持微沸，滚开会把丸子冲散。",
      "visual_cue": "丸子浮起，体积略膨胀"
    },
    {
      "n": 5,
      "text": "丸子全部浮起后再煮四分钟，用漏勺捞起沥干。",
      "time_min": 5,
      "heat": "小火",
      "tip": "浮起不代表全熟，再多煮四分钟。",
      "visual_cue": "丸子按下去有弹性，中心全白"
    },
    {
      "n": 6,
      "text": "平底锅化黄油，把鱼丸煎至表面金黄，撒莳萝碎出锅。",
      "time_min": 5,
      "heat": "中火",
      "tip": "黄油容易焦，中火快速上色就好。",
      "visual_cue": "表面金褐，切口洁白细嫩"
    }
  ],
  "tips": [
    "鱼浆全程保持低温，冰块裹毛巾垫在碗下更稳。",
    "不煎直接放进鱼汤煮，就是挪威版的鱼丸汤。",
    "丸子做小一点更容易熟透，直径三厘米最合适。"
  ],
  "common_mistakes": [
    "料理机连续打太久，鱼肉发热变成粗糙颗粒。",
    "面粉一次加太多，丸子吃起来发硬像面团。",
    "水大滚下丸子，全被冲散成肉汤。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "三文鱼",
      "ratio": "700克:700克",
      "note": "脂肪更高，面粉多加十克。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "40克:35毫升",
      "note": "少了奶香，煎时不易焦。"
    }
  ],
  "variations": [
    "鱼浆里加一勺淡奶油，丸子更滑嫩。",
    "加少量咖喱粉做成北欧咖喱鱼丸，配米饭吃。"
  ],
  "serving_suggestion": "配水煮土豆、白酱和一份莳萝，或放进清汤里当汤菜，撒白胡椒提味。",
  "storage": "冷藏两天，冷冻三周；复热用小火煎或放进汤里煮透。",
