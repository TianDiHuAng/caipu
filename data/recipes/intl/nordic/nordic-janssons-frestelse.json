  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切细条，泡水后沥干。，注意锅里温度别掉下来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切细一点，熟得才透。，始终中小火，别心急。",
      "visual_cue": "土豆条均匀，水色转清"
    },
    {
      "n": 2,
      "text": "洋葱切细丝，用一半黄油小火炒软。，火要均匀，食材才不糊。",
      "time_min": 5,
      "heat": "小火",
      "tip": "炒软不炒焦，甜味才出。，看住火，别让它失控。",
      "visual_cue": "洋葱透明，香气发甜"
    },
    {
      "n": 3,
      "text": "鳀鱼从油里捞出，撕成小段。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鳀鱼本身很咸，不用再加盐。，火大了就离锅远一点。",
      "visual_cue": "鱼段整齐，油分沥干"
    },
    {
      "n": 4,
      "text": "烤盘先铺一层土豆条，再铺洋葱和鳀鱼。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "层数铺匀，每口都有鱼。，锅温要匀，别忽高忽低。",
      "visual_cue": "铺面平整，层次分明"
    },
    {
      "n": 5,
      "text": "再盖一层土豆条，表面抹平。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "顶层要平，烤出来才好看。，火候宁小勿大，慢慢推进。",
      "visual_cue": "表面齐整，无空隙，成败就在这一步。"
    },
    {
      "n": 6,
      "text": "淡奶油和牛奶混合，浇在土豆上。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "浇透一点，土豆才不干。，始终中小火，别心急。",
      "visual_cue": "液面齐平，缓慢下渗"
    },
    {
      "n": 7,
      "text": "撒面包糠，剩余黄油切片铺面。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "黄油片分散，表面才脆得匀。，看住火，别让它失控。",
      "visual_cue": "表面有糠有油，分布均匀"
    },
    {
      "n": 8,
      "text": "烤箱一百九十度烤三十五分钟，到表面金黄。，全程留意火候，别贪快。",
      "time_min": 37,
      "heat": "无火",
      "tip": "中途不搅动，让表面结壳。，火大了就离锅远一点。",
      "visual_cue": "表面焦黄，汁水冒泡"
    },
    {
      "n": 9,
      "text": "出炉静置八分钟，撒白胡椒上桌。，火别开太大，稳着来。",
      "time_min": 9,
      "heat": "无火",
      "tip": "静置后汁水回吸，切才不散。，锅温要匀，别忽高忽低。",
      "visual_cue": "切面分层，汁水丰盈"
    }
  ],
  "tips": [
    "土豆切细条，熟得更均匀。，这点要注意。",
    "鳀鱼很咸，不用额外加盐。，这是关键点。",
    "静置八分钟再切，层次才整齐。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "土豆切太粗，里面是硬芯。，这一步别省。",
    "没浇够奶油，烤完发干。，别跳过这步。",
    "额外加盐，整盘咸得下不去口。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "鳀鱼",
      "substitute": "金枪鱼",
      "ratio": "150 克:180 克",
      "note": "咸味轻，需补两克盐。"
    },
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "200 毫升:200 毫升",
      "note": "需多加十克黄油保持香浓。"
    }
  ],
  "variations": [
    "撒一层芝士碎，表面更焦香。，很多人在这里出错。",
    "加一点肉豆蔻，风味更浓。，这里最容易翻车。"
  ],
  "serving_suggestion": "配冰啤酒和黑面包，圣诞餐桌常见。",
  "storage": "冷藏两天，复热用烤箱。，别小看这一步。",
