  "steps": [
    {
      "n": 1,
      "text": "黄油软化到手指能压出坑，加红糖和白糖打发。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打发到颜色变浅，饼干才酥。，火大了就离锅远一点。",
      "visual_cue": "黄油发白，体积变大"
    },
    {
      "n": 2,
      "text": "加鸡蛋搅匀，再筛入面粉和盐。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面粉过筛，口感才细。，锅温要匀，别忽高忽低。",
      "visual_cue": "面糊均匀，无干粉，这点要注意。"
    },
    {
      "n": 3,
      "text": "加入桂皮、小豆蔻和丁香粉，揉成面团。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香料现磨，香气才足。，火候宁小勿大，慢慢推进。",
      "visual_cue": "面团油润，香气浓烈"
    },
    {
      "n": 4,
      "text": "包保鲜膜冷藏两小时，到面团变硬。，注意锅里温度别掉下来。",
      "time_min": 122,
      "heat": "无火",
      "tip": "冷藏后擀开才不粘。，始终中小火，别心急。",
      "visual_cue": "面团硬实，按不留痕"
    },
    {
      "n": 5,
      "text": "面团擀成三毫米厚，用模子压出形状。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致，烤的时间才统一。，看住火，别让它失控。",
      "visual_cue": "饼坯整齐，厚薄均匀"
    },
    {
      "n": 6,
      "text": "烤箱一百八十度烤十分钟，边缘微焦即可。，全程留意火候，别贪快。",
      "time_min": 12,
      "heat": "无火",
      "tip": "烤到边缘上色就够，凉了会更脆。，火大了就离锅远一点。",
      "visual_cue": "边缘焦褐，中心浅金"
    },
    {
      "n": 7,
      "text": "出炉放架上彻底放凉，密封保存。，火别开太大，稳着来。",
      "time_min": 15,
      "heat": "无火",
      "tip": "凉透才脆，热的时候是软的。，锅温要匀，别忽高忽低。",
      "visual_cue": "饼干硬挺，掰开清脆"
    }
  ],
  "tips": [
    "面团冷藏够时间，擀开才不粘。，这是关键点。",
    "饼坯厚薄一致，才不会有的焦有的生。",
    "烤到边缘上色就够，凉了会更脆。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "面团太软，压出来变形。，这一步别省。",
    "擀太厚，中心烤不透。，别跳过这步。",
    "烤过头，吃起来发苦。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "红糖",
      "substitute": "白糖",
      "ratio": "100 克:90 克",
      "note": "颜色更浅，风味偏甜。"
    },
    {
      "original": "小豆蔻",
      "substitute": "桂皮",
      "ratio": "2 克:4 克",
      "note": "香气更单一，可加一点丁香。"
    }
  ],
  "variations": [
    "表面刷蛋液撒粗糖，更有光泽。，很多人在这里出错。",
    "做成心形，圣诞挂在树上装饰。，这里最容易翻车。"
  ],
  "serving_suggestion": "配热红酒或咖啡，圣诞必备。，别小看这一步。",
  "storage": "密封常温两周。，成败就在这一步。，这处常被忽略。",
