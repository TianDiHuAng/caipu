 "steps": [
  {
   "n": 1,
   "text": "黄油软化到手指能压出坑，加红糖和白糖打发。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "无火",
   "tip": "打发到颜色变浅，饼干才酥。，火候要稳，别忽大忽小。",
   "visual_cue": "黄油发白，体积变大"
  },
  {
   "n": 2,
   "text": "加鸡蛋搅匀，再筛入面粉和盐。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "面粉过筛，口感才细。，火候要稳，别忽大忽小。",
   "visual_cue": "面糊均匀，无干粉，这一点很关键。"
  },
  {
   "n": 3,
   "text": "加入桂皮、小豆蔻和丁香粉，揉成面团。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "香料现磨，香气才足。，火候要稳，别忽大忽小。",
   "visual_cue": "面团油润，香气浓烈"
  },
  {
   "n": 4,
   "text": "包保鲜膜冷藏两小时，到面团变硬。，火候要稳，别忽大忽小。",
   "time_min": 122,
   "heat": "无火",
   "tip": "冷藏后擀开才不粘。，火候要稳，别忽大忽小。",
   "visual_cue": "面团硬实，按不留痕"
  },
  {
   "n": 5,
   "text": "面团擀成三毫米厚，用模子压出形状。，火候要稳，别忽大忽小。",
   "time_min": 8,
   "heat": "无火",
   "tip": "厚薄一致，烤的时间才统一。，火候要稳，别忽大忽小。",
   "visual_cue": "饼坯整齐，厚薄均匀"
  },
  {
   "n": 6,
   "text": "烤箱一百八十度烤十分钟，边缘微焦即可。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "烤到边缘上色就够，凉了会更脆。，火候要稳，别忽大忽小。",
   "visual_cue": "边缘焦褐，中心浅金"
  },
  {
   "n": 7,
   "text": "出炉放架上彻底放凉，密封保存。，火候要稳，别忽大忽小。",
   "time_min": 15,
   "heat": "无火",
   "tip": "凉透才脆，热的时候是软的。，火候要稳，别忽大忽小。",
   "visual_cue": "饼干硬挺，掰开清脆"
  }
 ],
 "tips": [
  "面团冷藏够时间，擀开才不粘。，这一点很关键。",
  "饼坯厚薄一致，才不会有的焦有的生。",
  "烤到边缘上色就够，凉了会更脆。，这一点很关键。"
 ],
 "common_mistakes": [
  "面团太软，压出来变形。，这一点很关键。",
  "擀太厚，中心烤不透。，这一点很关键。",
  "烤过头，吃起来发苦。，这一点很关键。"
 ],
