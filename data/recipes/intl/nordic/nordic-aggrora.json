  "equipment": [
    "不粘锅",
    "硅胶铲",
    "打蛋碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打散加牛奶和一半盐，用叉子搅到蛋清蛋黄完全融合，别打出太多泡沫。",
      "time_min": 4,
      "heat": "无火",
      "tip": "叉子比打蛋器温和，不会灌进太多空气。",
      "visual_cue": "蛋液均匀浅黄，泡沫很少"
    },
    {
      "n": 2,
      "text": "不粘锅小火化一半黄油，油面微微起泡时倒入蛋液。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油起泡但不变褐，这个温度最合适。",
      "visual_cue": "黄油铺满锅底，蛋液边缘开始凝"
    },
    {
      "n": 3,
      "text": "用硅胶铲从边缘往中间慢慢推，每次停顿五秒让蛋液重新铺开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "全程小火慢推，这是嫩滑的关键。",
      "visual_cue": "蛋液成大块柔软的凝乳"
    },
    {
      "n": 4,
      "text": "还有少量湿润蛋液时关火，加剩下的黄油和剩余的盐拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "余温会把蛋液收熟，不能等全干再关火。",
      "visual_cue": "炒蛋湿润成团，表面有光泽"
    },
    {
      "n": 5,
      "text": "撒白胡椒和莳萝碎，配上加热的面粉薄饼一起上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "薄饼干锅两面各烘二十秒就够。",
      "visual_cue": "炒蛋堆成小丘，薄饼温热柔软"
    }
  ],
  "tips": [
    "锅一定要用不粘的，不锈钢锅容易糊底。",
    "想要更滑可以加一勺淡奶油替代牛奶。",
    "北欧吃法会配一小碟腌鱼，咸鲜对撞很提神。"
  ],
  "common_mistakes": [
    "火开太大，蛋液底部焦了面上还是液体。",
    "不停快速翻炒，炒蛋变成碎渣没有块感。",
    "盐一开始加足，收汁后整体偏咸。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "40克:35毫升",
      "note": "少了奶香，火候要更小。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "60毫升:50毫升",
      "note": "口感略薄，黄油可多加十克。"
    }
  ],
  "variations": [
    "加一把切碎的韭菜，做成春季版本。",
    "撒少量糖做成瑞典式的甜炒蛋，配果酱吃。"
  ],
  "serving_suggestion": "配薄饼、一片腌三文鱼和黑咖啡，就是北欧酒店早餐盘里最常见的一组。",
  "storage": "现做现吃，冷藏不超过一天；复热须小火加一小块黄油慢慢拌开。",
