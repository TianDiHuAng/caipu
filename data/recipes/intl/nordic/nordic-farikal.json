  "equipment": [
    "厚底炖锅",
    "漏勺",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉块用厨房纸吸干，撒一半盐和面粉抓匀，让每块都裹上薄粉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "薄粉能封住肉汁，也让汤汁自然变稠。",
      "visual_cue": "肉块表面干爽，裹粉均匀不结块"
    },
    {
      "n": 2,
      "text": "厚底锅底铺一层卷心菜块，再铺一层羊肉，撒黑胡椒粒和剩下的盐。",
      "time_min": 6,
      "heat": "无火",
      "tip": "菜垫底防粘，肉汁往下渗正好喂菜。",
      "visual_cue": "一层菜一层肉，层次清楚"
    },
    {
      "n": 3,
      "text": "交替铺完所有卷心菜和羊肉，最上层收卷心菜，放黄油块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黑胡椒整粒放，炖久了香气才透。",
      "visual_cue": "顶层菜叶盖满，黄油块散落其上"
    },
    {
      "n": 4,
      "text": "沿锅边倒入水到食材三分之二高，大火煮开后转小火盖盖炖六十分钟。",
      "time_min": 65,
      "heat": "小火",
      "tip": "水别没过食材，靠蒸汽把上层焖熟。",
      "visual_cue": "水面微沸，锅盖有水汽凝结"
    },
    {
      "n": 5,
      "text": "开盖轻轻压一下食材，继续炖三十分钟至羊肉能被叉子轻松分开。",
      "time_min": 30,
      "heat": "小火",
      "tip": "中途别频繁翻动，菜叶会碎。",
      "visual_cue": "羊肉脱骨，汤汁浅褐"
    },
    {
      "n": 6,
      "text": "另锅把土豆带皮煮二十分钟至软，沥干后配炖菜一起上桌。",
      "time_min": 22,
      "heat": "中火",
      "tip": "土豆带皮煮更香，剥皮时趁热。",
      "visual_cue": "土豆一压就散，皮易剥落"
    }
  ],
  "tips": [
    "隔夜更入味，挪威人常做一大锅吃两天。",
    "用整粒黑胡椒而不是粉，香气更干净。",
    "羊肉带骨炖，汤味比纯肉版本厚得多。"
  ],
  "common_mistakes": [
    "水加得太满，炖出来成了一锅清汤不是菜。",
    "大火滚煮，羊肉变柴卷心菜烂成泥。",
    "黑胡椒放成粉，长时间炖后发苦。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛腩",
      "ratio": "800克:800克",
      "note": "炖的时间延长二十分钟。"
    },
    {
      "original": "卷心菜",
      "substitute": "皱叶甘蓝",
      "ratio": "900克:900克",
      "note": "口感更嫩，炖的时间缩短十分钟。"
    }
  ],
  "variations": [
    "加几颗整粒多香果，香气更接近挪威西部做法。",
    "最后撒一把切碎的欧芹，颜色更清爽。"
  ],
  "serving_suggestion": "连汤带菜盛进深盘，配带皮煮土豆和一杯啤酒，是挪威九月入秋后的固定晚餐。",
  "storage": "冷藏三天，冷冻一个月；复热加少量水小火加热，别用大火滚。",
