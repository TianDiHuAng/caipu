  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "苹果",
          "name_en": "apple",
          "amount": 500,
          "unit": "g",
          "note": "去皮切薄片",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 200,
          "unit": "g",
          "note": "低筋",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 150,
          "unit": "g",
          "note": "约三枚",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 120,
          "unit": "g",
          "note": "融化",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "打发",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 80,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 3,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "泡打粉",
          "name_en": "baking powder",
          "amount": 5,
          "unit": "g",
          "note": "膨发",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "盆",
    "打蛋器",
    "蛋糕模"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油隔水融化后放温，模具内壁抹一层黄油并撒薄面粉防粘。",
      "time_min": 6,
      "heat": "小火",
      "tip": "黄油别烧到滚烫，温度太高会把蛋液烫熟。",
      "visual_cue": "黄油化成清亮液体"
    },
    {
      "n": 2,
      "text": "鸡蛋加白糖和盐，用打蛋器打到颜色发白、体积明显膨胀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到画纹路能停留三秒，蛋糕才够松。",
      "visual_cue": "蛋糊发白浓稠，滴落有纹"
    },
    {
      "n": 3,
      "text": "面粉和泡打粉过筛，分两次拌进蛋糊，翻拌到看不见干粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用翻拌不要画圈搅，画圈会把气泡搅掉。",
      "visual_cue": "面糊顺滑没有干粉"
    },
    {
      "n": 4,
      "text": "倒入融化黄油和牛奶拌匀，加肉桂粉翻两下，面糊呈流动状。",
      "time_min": 3,
      "heat": "无火",
      "tip": "黄油分次淋入并快速拌，避免油水分离。",
      "visual_cue": "面糊光亮，能缓慢流动"
    },
    {
      "n": 5,
      "text": "面糊倒进模具，苹果片一片压一片斜插在表面，铺满整层。",
      "time_min": 5,
      "heat": "无火",
      "tip": "苹果片斜插进去，烤完才不会全浮在上面。",
      "visual_cue": "苹果片排列整齐陷入面糊"
    },
    {
      "n": 6,
      "text": "烤箱一百八十度烤四十五分钟，牙签插入中心不带湿糊即可。",
      "time_min": 45,
      "heat": "中火",
      "tip": "出炉后等彻底凉透再脱模，热切一定会散。",
      "visual_cue": "表面金黄，苹果边缘微焦"
    },
    {
      "n": 7,
      "text": "出炉连模放凉十五分钟再脱模，切块前彻底凉透。",
      "time_min": 15,
      "heat": "无火",
      "tip": "必须彻底凉透再切，热切时蛋糕一定会散开。",
      "visual_cue": "蛋糕回缩平整，切口干净"
    }
  ],
  "tips": [
    "苹果选偏酸的品种，烤完甜度刚好不腻。",
    "蛋糊打到能留纹路，蛋糕才蓬松。",
    "出炉后放凉再脱模，热脱容易碎。"
  ],
  "common_mistakes": [
    "蛋糊没打发，烤出来像一块实心饼。",
    "苹果切太厚，烤完中间还是生的。",
    "没凉透就脱模，蛋糕整块散成碎块。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "梨",
      "ratio": "500 克:500 克",
      "note": "水分更多，需多加十克面粉。"
    },
    {
      "original": "肉桂",
      "substitute": "豆蔻粉",
      "ratio": "3 克:2 克",
      "note": "香气更清爽，适合不爱肉桂的人。"
    }
  ],
  "variations": [
    "表面撒一层粗糖，烤完带一层脆壳。",
    "拌入葡萄干，口感更丰富有层次。"
  ],
  "serving_suggestion": "温热时切块，配一勺香草冰淇淋或淡奶油，北欧人常配黑咖啡当下午茶。",
  "storage": "密封常温两天、冷藏四天，吃前回温或微波十五秒恢复松软。",
