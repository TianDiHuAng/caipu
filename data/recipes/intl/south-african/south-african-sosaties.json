  "steps": [
    {
      "n": 1,
      "text": "罗望子用热水泡开，滤出酸汁。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡软后揉一揉，酸味才出。，火候要稳，别忽大忽小。",
      "visual_cue": "汁液深褐，果肉分离"
    },
    {
      "n": 2,
      "text": "咖喱粉、红糖、蒜末、白醋和罗望子汁调成腌料。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先调匀再倒，香料才不结块。，火候要稳，别忽大忽小。",
      "visual_cue": "酱料浓稠，颜色深黄"
    },
    {
      "n": 3,
      "text": "羊肉切三厘米块，加腌料抓匀。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "块切大一点，烤后缩水才刚好。，火候要稳，别忽大忽小。",
      "visual_cue": "肉块挂酱，颜色转深"
    },
    {
      "n": 4,
      "text": "加洋葱丁和葡萄干拌匀，冷藏两小时。，火候要稳，别忽大忽小。",
      "time_min": 122,
      "heat": "无火",
      "tip": "时间够，酸味和甜味才进去。，火候要稳，别忽大忽小。",
      "visual_cue": "肉色深褐，香气明显"
    },
    {
      "n": 5,
      "text": "竹签泡水半小时，每串交替穿肉和洋葱。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "无火",
      "tip": "签子泡水，烤时才不烧焦。，火候要稳，别忽大忽小。",
      "visual_cue": "串身紧实，排列整齐"
    },
    {
      "n": 6,
      "text": "烤架中火，肉串刷植物油。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "刷油防粘，也让表面更亮。，火候要稳，别忽大忽小。",
      "visual_cue": "架子冒烟，油光闪，这一点很关键。"
    },
    {
      "n": 7,
      "text": "每面烤四分钟，中途翻两次。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "中火",
      "tip": "中火慢烤，外面不焦。，火候要稳，别忽大忽小。",
      "visual_cue": "表面焦痕，肉汁渗出"
    },
    {
      "n": 8,
      "text": "撒盐，静置三分钟再吃。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置后肉汁才不白流。，火候要稳，别忽大忽小。",
      "visual_cue": "肉块油亮，切面微粉"
    }
  ],
  "tips": [
    "罗望子提前泡开，酸味才柔和。，这一点很关键。",
    "腌够两小时，香料才渗进去。，这一点很关键。",
    "中火烤，肉才嫩不柴。，这一点很关键。"
  ],
  "common_mistakes": [
    "腌的时间太短，只有表面有咖喱味。",
    "大火烤，糖分先烧黑。，这一点很关键。",
    "洋葱和肉分开穿，容易掉。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "700 克:700 克",
      "note": "腌三小时，口感更紧实。"
    },
    {
      "original": "罗望子",
      "substitute": "白醋",
      "ratio": "25 克:50 毫升",
      "note": "酸味更直，少了果香。"
    }
  ],
  "variations": [
    "加一点杏干，甜味更有层次。，这一点很关键。",
    "腌料加半勺孜然，香气更足。，这一点很关键。"
  ],
  "serving_suggestion": "配玉米糊或抓饭，挤柠檬汁。，这一点很关键。",
  "storage": "冷藏两天，复烤五分钟。，这一点很关键。",
