  "steps": [
    {
      "n": 1,
      "text": "羊肉切块，用盐和黑胡椒抓匀。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "块切均匀，炖时才一起软。，火候要稳，别忽大忽小。",
      "visual_cue": "肉块紧实，表面微湿"
    },
    {
      "n": 2,
      "text": "锅里植物油烧热，羊肉煎到表面变褐。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煎出焦褐色，炖出来才香。，火候要稳，别忽大忽小。",
      "visual_cue": "表面焦褐，锅底有焦香"
    },
    {
      "n": 3,
      "text": "下洋葱丝和蒜末炒到透明。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才出来。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱软塌，油色发亮"
    },
    {
      "n": 4,
      "text": "加番茄块炒出汁，放香叶和桂皮。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中火",
      "tip": "番茄炒烂，汤才浓。，火候要稳，别忽大忽小。",
      "visual_cue": "汤汁渗出，颜色橙红"
    },
    {
      "n": 5,
      "text": "倒清水没过肉，煮开后转小火炖四十分钟。，火候要稳，别忽大忽小。",
      "time_min": 45,
      "heat": "小火",
      "tip": "小火慢炖，肉才酥不柴。，火候要稳，别忽大忽小。",
      "visual_cue": "汤面微沸，香气浓郁"
    },
    {
      "n": 6,
      "text": "加土豆块和豆角段，再炖二十分钟。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "小火",
      "tip": "土豆后放，才不会炖成泥。，火候要稳，别忽大忽小。",
      "visual_cue": "土豆软透，豆角翠绿"
    },
    {
      "n": 7,
      "text": "加红糖和盐调味，收汁五分钟。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "中火",
      "tip": "红糖中和酸味，别放多。，火候要稳，别忽大忽小。",
      "visual_cue": "汤汁浓稠，油光浮面"
    },
    {
      "n": 8,
      "text": "挑出香叶和桂皮，盛盘上桌。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香料久留会发苦。，火候要稳，别忽大忽小。",
      "visual_cue": "汤色红亮，肉块完整"
    }
  ],
  "tips": [
    "羊肉先煎出焦褐色，汤才够香。，这一点很关键。",
    "土豆后放，避免炖烂成糊。，这一点很关键。",
    "红糖一点就够，只为平衡酸味。，这一点很关键。"
  ],
  "common_mistakes": [
    "羊肉不煎直接炖，汤味寡淡。，这一点很关键。",
    "大火滚炖，肉缩成硬块。，这一点很关键。",
    "番茄放太少，汤色发白发淡。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "700 克:700 克",
      "note": "炖的时间延长十五分钟。"
    },
    {
      "original": "豆角",
      "substitute": "青椒",
      "ratio": "150 克:150 克",
      "note": "最后十分钟放，保持脆感。"
    }
  ],
  "variations": [
    "加一勺咖喱粉，风味更接近开普马来版。",
    "加南瓜块同炖，汤汁更甜。，这一点很关键。"
  ],
  "serving_suggestion": "配玉米糊或米饭，汤汁拌饭。，这一点很关键。",
  "storage": "冷藏三天，冷冻一个月。，这一点很关键。",
