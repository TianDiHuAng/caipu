  ],
  "equipment": [
    "锡纸",
    "烤盘",
    "削皮刀",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜菜根刷洗干净不去皮，用锡纸包紧，烤箱两百度烤四十分钟至叉子能轻松插入。",
      "time_min": 40,
      "heat": "中火",
      "tip": "包锡纸烤能锁住甜味和颜色。",
      "visual_cue": "表皮略皱，叉子插入无阻力"
    },
    {
      "n": 2,
      "text": "取出晾到不烫手，用厨房纸一搓外皮就脱落，切成薄片或滚刀块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁温热剥皮最容易，凉透会黏。",
      "visual_cue": "切面深紫红，有光泽"
    },
    {
      "n": 3,
      "text": "酸奶加柠檬汁、橄榄油、白糖、盐和黑胡椒搅匀成淋酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱要先调好味，拌进去就改不了了。",
      "visual_cue": "酱体顺滑，能流动"
    },
    {
      "n": 4,
      "text": "甜菜根放碗里，倒入一半淋酱轻拌，让每片都裹上。",
      "time_min": 2,
      "heat": "无火",
      "tip": "用勺子翻拌，别用力搅防止染色过深。",
      "visual_cue": "甜菜根表面挂一层淡粉酱"
    },
    {
      "n": 5,
      "text": "装盘后淋剩下的一半淋酱，撒薄荷碎，冷藏十分钟再上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冷藏后风味融合，颜色也更亮。",
      "visual_cue": "表面点缀绿薄荷，盘底有淡粉汁"
    }
  ],
  "tips": [
    "烤比煮好，水煮会让甜味和颜色流进水里。",
    "戴一次性手套处理，手上不会染紫。",
    "拌好后尽快上桌，久放整盘颜色会发暗发灰。"
  ],
  "common_mistakes": [
    "甜菜根没烤透，切片发硬带土味。",
    "酱汁一次全倒进去，成品水塌塌。",
    "拌好后久放，整盘颜色发暗发灰。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "酸奶油",
      "ratio": "120克:120克",
      "note": "质地更稠，酱体要加一勺水调开。"
    },
    {
      "original": "薄荷",
      "substitute": "莳萝",
      "ratio": "10克:10克",
      "note": "香气更清冷，与甜菜根也搭。"
    }
  ],
  "variations": [
    "表面撒一把烤核桃碎，脆感层次会更明显。",
    "换成橙汁和橙皮屑调味，果香版本更清爽。"
  ],
  "serving_suggestion": "作为烧烤的凉菜上桌，配烤肉能解腻；也可夹进面包做成三明治。",
  "storage": "冷藏两天，颜色会渐深；出水后倒掉再拌一次即可。",
