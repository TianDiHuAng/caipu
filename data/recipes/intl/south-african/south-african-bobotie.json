  "equipment": [
    "烤盘",
    "炒锅",
    "打蛋器",
    "刀",
    "砧板",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包去边撕碎，用一百二十毫升牛奶泡软；葡萄干用温水泡十分钟后沥干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面包是黏合剂，泡软后能让肉糜烤完不散。",
      "visual_cue": "面包吸饱牛奶，捏起来成糊"
    },
    {
      "n": 2,
      "text": "炒锅下植物油炒洋葱丁与蒜末八分钟至金黄，加咖喱粉和肉桂炒一分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "香料要在洋葱炒软后再下，香味才铺得开。",
      "visual_cue": "洋葱金黄，锅里香料油色发亮"
    },
    {
      "n": 3,
      "text": "下牛肉粒炒到变色，加白醋、白糖、盐、黑胡椒和葡萄干翻匀。",
      "time_min": 8,
      "heat": "中火",
      "tip": "肉炒到刚变色即可，后面还要进烤箱，久炒会老。",
      "visual_cue": "肉色由红转褐，颗粒分明"
    },
    {
      "n": 4,
      "text": "关火拌入泡好的面包糊与两个鸡蛋，把肉糜压进烤盘抹平，铺月桂叶。",
      "time_min": 6,
      "heat": "微火",
      "tip": "肉糜要压实，烤后切片才不松散。",
      "visual_cue": "馅面平整，月桂叶嵌在表面"
    },
    {
      "n": 5,
      "text": "剩余牛奶与一个鸡蛋打匀，加少许盐，慢慢浇在肉糜表面。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶液要沿盘边缓慢浇，否则会把肉糜冲出坑。",
      "visual_cue": "表面覆一层浅黄奶液"
    },
    {
      "n": 6,
      "text": "烤箱一百八十度烤三十五分钟至表面凝固呈金黄，取出静置十分钟再切块。",
      "time_min": 45,
      "heat": "中火",
      "tip": "奶液完全凝固、轻晃不流动才算烤透，切开配米饭最对味。",
      "visual_cue": "表面金黄有细密气孔，刀刃切下不散"
    }
  ],
  "tips": [
    "咖喱粉品质决定风味，选香气浓的 Madras 类更接近原味。",
    "配米饭与香蕉片、椰丝烤甜椒是标准摆盘。",
    "隔夜再热更入味，切片也更整齐。"
  ],
  "common_mistakes": [
    "肉糜没压实，切块时散成一盘碎肉。",
    "奶液浇得太急，把表面冲出坑洞。",
    "烤温过高，表面焦褐而中心还是湿的。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "700 克:700 克",
      "note": "羊肉风味更浓，肉桂可略减。"
    },
    {
      "original": "葡萄干",
      "substitute": "红枣",
      "ratio": "60 克:60 克",
      "note": "切碎后使用，甜味更柔和。"
    }
  ],
  "variations": [
    "把肉糜换成扁豆与蘑菇，可做素食版本，需增加面包糊用量。"
  ],
  "serving_suggestion": "切块配米饭、香蕉片与烤甜椒一起上桌。",
  "storage": "冷藏三天，冷冻一个月；复热用烤箱一百六十度十五分钟。",
