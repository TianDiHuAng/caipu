  "flavor": [
    "light",
    "savory"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "玉米面",
          "name_en": "cornmeal",
          "amount": 300,
          "unit": "g",
          "note": "粗磨",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1000,
          "unit": "ml",
          "note": "煮糊",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "厚底锅里倒入清水，加盐后开大火烧到滚开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水先烧开再下粉，粉才不结块、不沉底。",
      "visual_cue": "水面翻滚，锅边冒白汽"
    },
    {
      "n": 2,
      "text": "玉米面分三次撒入，每次都用木勺快速搅散。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一把把撒，边撒边搅，疙瘩才少。",
      "visual_cue": "粉粒散开，锅里有细泡"
    },
    {
      "n": 3,
      "text": "转小火，木勺顺着一个方向不停搅动十分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "始终朝一个方向搅，糊体才细滑不返生。",
      "visual_cue": "糊体渐稠，勺子划出纹路"
    },
    {
      "n": 4,
      "text": "加入黄油再继续搅五分钟，让糊体发亮变滑。",
      "time_min": 5,
      "heat": "小火",
      "tip": "黄油让糊更润口，也不容易粘锅底。",
      "visual_cue": "表面油润发亮，勺子挂糊"
    },
    {
      "n": 5,
      "text": "若太稠可添少量清水，调到能缓慢流动的稠度。",
      "time_min": 3,
      "heat": "小火",
      "tip": "稠度像厚粥就好，凉了之后还会更硬一些。",
      "visual_cue": "舀起一勺缓慢落下成堆"
    },
    {
      "n": 6,
      "text": "盖上锅盖再焖三分钟，让玉米面彻底吸水熟透。",
      "time_min": 3,
      "heat": "小火",
      "tip": "关火焖一焖，中心才不夹生不发硬。",
      "visual_cue": "糊面平整，边缘微微鼓起"
    },
    {
      "n": 7,
      "text": "盛进碗里，趁热配着炖菜或烤肉一起吃最香。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃口感最滑，凉透了会结成硬块。",
      "visual_cue": "糊体白亮，碗边不见水"
    }
  ],
  "tips": [
    "玉米面分次撒入并快速搅，疙瘩才少。",
    "全程顺一个方向搅，糊体才细滑。",
    "黄油在最后阶段加，香气足又不容易糊底。"
  ],
  "common_mistakes": [
    "玉米面一次倒进开水，立刻结成大疙瘩。",
    "大火猛煮不搅，锅底焦糊、上面还是稀的。",
    "水加得太少，出锅就硬得连勺都舀不动。"
  ],
  "substitutions": [
    {
      "original": "玉米面",
      "substitute": "小米面",
      "ratio": "300 克:300 克",
      "note": "口感更细，煮的时间减五分钟。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30 克:30 毫升",
      "note": "少了奶香，但更清爽。"
    }
  ],
  "variations": [
    "加一勺糖做成甜口，配牛奶当早餐。",
    "撒一把玉米粒同煮，口感更有层次。"
  ],
  "serving_suggestion": "配南非辣蔬沙拉与炖肉，边上浇一勺肉汁，用手团着吃最地道。",
  "storage": "冷藏两天，复热时加清水小火重新搅开。",
