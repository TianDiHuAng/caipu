    "dessert"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 30,
    "cook_min": 50,
    "total_min": 80
  },
  "servings": 6,
  "flavor": [
    "sweet",
    "rich",
    "fragrant",
    "tangy"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 380,
          "unit": "g",
          "note": "低筋面粉",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 3,
          "unit": "piece",
          "note": "室温",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 150,
          "unit": "g",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 200,
          "unit": "ml",
          "note": "面糊与酱汁",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 120,
          "unit": "g",
          "note": "融化",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 80,
          "unit": "g",
          "note": "代替杏酱",
          "optional": false
        },
        {
          "name": "白醋",
          "name_en": "white vinegar",
          "amount": 15,
          "unit": "ml",
          "note": "让组织松软",
          "optional": false
        },
        {
          "name": "小苏打",
          "name_en": "baking soda",
          "amount": 3,
          "unit": "g",
          "note": "膨发",
          "optional": false
        },
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 120,
          "unit": "g",
          "note": "佐食",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "打蛋器",
    "小锅",
    "拌面盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋与一百克白糖放盆里，用打蛋器打到颜色发白变浓稠。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到能画出纹路不马上消失。",
      "visual_cue": "蛋糊发白蓬松，体积变大"
    },
    {
      "n": 2,
      "text": "加入融化的黄油与蜂蜜，继续搅打到完全融合为止。",
      "time_min": 3,
      "heat": "无火",
      "tip": "黄油别太烫，否则会把蛋糊烫散。",
      "visual_cue": "糊体顺滑发亮，无油水分层"
    },
    {
      "n": 3,
      "text": "牛奶加白醋后静置五分钟，表面微微结块成酪乳。",
      "time_min": 5,
      "heat": "无火",
      "tip": "酸让组织更松软，别省这一步。",
      "visual_cue": "牛奶变稠，表面有细小结块"
    },
    {
      "n": 4,
      "text": "小苏打与面粉混合过筛，分两次切拌进蛋糊里。",
      "time_min": 4,
      "heat": "无火",
      "tip": "切拌别画圈，避免起筋。",
      "visual_cue": "面糊细腻，没有干粉颗粒"
    },
    {
      "n": 5,
      "text": "倒入酪乳拌成能缓缓流动的稀面糊，静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面糊偏稀是对的，烤后才会湿润。",
      "visual_cue": "面糊顺滑，从勺上缓慢落下"
    },
    {
      "n": 6,
      "text": "烤盘内壁刷黄油，面糊倒入后轻震两下排出大气泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "震出气泡，烤出来组织才均匀。",
      "visual_cue": "表面平整，有小气泡浮起"
    },
    {
      "n": 7,
      "text": "烤箱一百八十度烤三十五分钟，烤到表面深金按回弹。",
      "time_min": 35,
      "heat": "中火",
      "tip": "中途别开盖，温度掉了会塌。",
      "visual_cue": "表面深金，按压能回弹"
    },
    {
      "n": 8,
      "text": "小锅放剩余白糖、牛奶与黄油，小火煮成温热酱汁。",
      "time_min": 4,
      "heat": "小火",
      "tip": "只需温热融化，不用煮滚。",
      "visual_cue": "酱汁顺滑，糖完全化开"
    },
    {
      "n": 9,
      "text": "布丁出炉后用叉子在表面扎满小孔，趁热淋上酱汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "扎孔让酱汁渗进去，才有湿润口感。",
      "visual_cue": "酱汁被吸收，表面湿润发亮"
    },
    {
      "n": 10,
      "text": "静置二十分钟让酱汁吸透，切块配一勺酸奶食用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "趁温热吃最香，配酸奶油更平衡。",
      "visual_cue": "切面湿润，酱汁渗入内层"
    }
  ],
  "tips": [
    "鸡蛋要打到发白蓬松，布丁才够松软。",
    "酪乳用牛奶加白醋现做即可，酸度足够。",
    "出炉趁热扎孔淋酱，酱汁才渗得进去。"
  ],
  "common_mistakes": [
    "黄油太烫就倒入蛋糊，蛋液被烫出颗粒。",
    "搅拌时一直画圈起筋，烤出来又硬又结实。",
    "不扎孔就直接淋酱，酱汁全积在盘底。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "杏酱",
      "ratio": "80 克:80 克",
      "note": "风味更酸甜，是原版做法。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "200 毫升:180 毫升",
      "note": "口感更厚重，需加二十毫升水。"
    }
  ],
  "variations": [
    "酱汁里加一勺橙皮屑，香气更清新解腻。",
    "配一球香草冰淇淋，冷热对比更好吃。"
  ],
  "serving_suggestion": "温热时切块，配一勺酸奶或冰淇淋食用。",
  "storage": "冷藏三天，复热用微波中火四十秒回软。",
  "nutrition_estimate": {
    "basis": "每份约 140 克",
