  ],
  "equipment": [
    "汤锅",
    "沙拉碗",
    "刀",
    "搅拌勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切三厘米块，放进清水里泡五分钟洗掉表面淀粉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡掉表面淀粉，煮出来才不黏糊。",
      "visual_cue": "水变浑浊，土豆块清爽"
    },
    {
      "n": 2,
      "text": "汤锅加清水和盐，下土豆块中火煮十二分钟到能戳透。",
      "time_min": 14,
      "heat": "中火",
      "tip": "煮到筷子能戳透就停，煮烂了拌完会成泥。",
      "visual_cue": "筷子能穿透，边缘不散"
    },
    {
      "n": 3,
      "text": "鸡蛋冷水下锅煮八分钟，捞出泡冷水后剥壳切块。",
      "time_min": 10,
      "heat": "中火",
      "tip": "蛋煮八分钟蛋黄刚好凝固不发青。",
      "visual_cue": "蛋黄橙黄，蛋白完整"
    },
    {
      "n": 4,
      "text": "土豆沥干水分后摊开放晾五分钟，让表面水汽散掉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "晾掉表面水汽，拌酱才不会变稀。",
      "visual_cue": "土豆表面干爽不粘"
    },
    {
      "n": 5,
      "text": "蛋黄酱加白醋、白糖、盐和白胡椒搅匀成拌酱。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先把酱调好再拌，味道才会均匀一致。",
      "visual_cue": "酱料顺滑，微酸带甜"
    },
    {
      "n": 6,
      "text": "把土豆块和鸡蛋块放进沙拉碗，淋上拌酱轻轻翻匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用刮刀轻轻翻拌，千万别把土豆压碎。",
      "visual_cue": "土豆裹满酱，块形完整"
    },
    {
      "n": 7,
      "text": "撒上香葱碎，冷藏二十分钟后食用风味更佳。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冷藏半小时再吃，味道融合得更透。",
      "visual_cue": "表面点缀绿色葱碎"
    }
  ],
  "tips": [
    "土豆煮到能戳透就停，煮烂拌完会成泥。",
    "煮好土豆要晾掉水汽，酱汁才挂得住。",
    "拌的时候用刮刀轻翻，块形才完整。"
  ],
  "common_mistakes": [
    "土豆煮过了头，拌完就变成一坨糊状。",
    "土豆带着水下酱，沙拉会出水变稀。",
    "鸡蛋煮得太久，蛋黄发青带着硫味。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "原味酸奶",
      "ratio": "120 克:120 克",
      "note": "更清爽，酸度略高。"
    },
    {
      "original": "白醋",
      "substitute": "柠檬",
      "ratio": "20 毫升:半个",
      "note": "果香更明显。"
    }
  ],
  "variations": [
    "加一把煮熟的青豆，颜色更好看。",
    "撒一层甜椒粉，香气更有南非风味。"
  ],
  "serving_suggestion": "配烤肉、香肠和南非玉米糊同吃，是当地烧烤聚会必备的冷盘。",
  "storage": "冷藏两天，食用前翻拌一次；含蛋黄酱制品不宜常温放置超过两小时。",
