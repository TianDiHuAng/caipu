    "total_min": 125
  },
  "servings": 6,
  "flavor": [
    "savory",
    "light",
    "salty"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 500,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 350,
          "unit": "ml",
          "note": "油炸",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 7,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 30,
          "unit": "g",
          "note": "帮助发酵",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 300,
          "unit": "ml",
          "note": "温水",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炸锅",
    "和面盆",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水里加白糖与酵母，静置十分钟到表面浮起一层泡沫。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡沫说明酵母活着，发酵才稳。",
      "visual_cue": "表面有一层细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉倒进大盆，加盐混匀后在中间挖一个小坑。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐别直接接触酵母水。",
      "visual_cue": "面粉堆中间凹出一个深坑"
    },
    {
      "n": 3,
      "text": "倒入酵母水，用筷子把面粉搅成均匀絮状，再加融化黄油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油让面团更软，炸后更香。",
      "visual_cue": "面团成絮，油被吸收"
    },
    {
      "n": 4,
      "text": "揉八分钟到面团光滑有弹性，在盆口盖上湿布。",
      "time_min": 8,
      "heat": "无火",
      "tip": "揉到能拉出薄膜，口感才松。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 5,
      "text": "放在温暖的地方发酵一小时，到体积膨胀成原来的两倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "温度低就延长时间，别省。",
      "visual_cue": "面团蓬松，内部有蜂窝孔"
    },
    {
      "n": 6,
      "text": "取出面团轻轻拍打排气，搓成长条分成八等份。",
      "time_min": 5,
      "heat": "无火",
      "tip": "分匀才炸得一致。",
      "visual_cue": "八份小剂子大小接近"
    },
    {
      "n": 7,
      "text": "每份揉圆按成直径八厘米左右的圆饼，再醒十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "二次醒发让饼更松。",
      "visual_cue": "饼坯略膨胀，手感轻"
    },
    {
      "n": 8,
      "text": "炸锅倒植物油烧到中温，下入饼坯炸三分钟到表面完全鼓起。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温中等，里面才熟透。",
      "visual_cue": "饼坯鼓胀，底部金黄"
    },
    {
      "n": 9,
      "text": "翻面再炸三分钟，等两面都金黄后捞出沥油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "勤翻面，受热才均匀。",
      "visual_cue": "两面色泽一致，外壳硬挺"
    },
    {
      "n": 10,
      "text": "稍微放凉后从侧面切开，夹入馅料或抹黄油食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热切开，夹馅最松软。",
      "visual_cue": "内部组织松软，有气孔"
    }
  ],
  "tips": [
    "酵母水要先起泡，发酵才有把握。",
    "油温保持中等，太高会外焦内生。",
    "饼坯二次醒发别省，口感才蓬松。"
  ],
  "common_mistakes": [
    "水温太高把酵母烫死，面团完全不发。",
    "油温过高，外壳焦黑里面还是生面。",
    "饼按得太薄，炸好以后硬得像石头。"
  ],
  "substitutions": [
    {
      "original": "清水",
      "substitute": "牛奶",
      "ratio": "300 毫升:300 毫升",
      "note": "更香更软，糖可减五克。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "20 克:18 毫升",
      "note": "风味更淡，口感略轻。"
    }
  ],
  "variations": [
    "面团里加一把玉米粒，口感更甜。",
    "做成甜口可以撒糖粉或者淋上蜂蜜吃。"
  ],
  "serving_suggestion": "趁热切开夹肉酱或抹黄油，配红茶。",
  "storage": "冷冻一个月，回温后烤箱复烤五分钟。",
