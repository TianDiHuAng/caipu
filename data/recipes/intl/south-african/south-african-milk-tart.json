  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 250,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 800,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 140,
          "unit": "g",
          "note": "分次用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 110,
          "unit": "g",
          "note": "分次用",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "分开用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "取皮屑",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "挞盘",
    "擀面杖",
    "厚底锅",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉过筛，加一小撮盐与三十克白糖一起拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "干料先混匀，烤出的挞皮才均匀。",
      "visual_cue": "粉料洁白，糖粒分布均匀"
    },
    {
      "n": 2,
      "text": "冷黄油切成小丁，用手指搓进面粉成粗砂状。",
      "time_min": 8,
      "heat": "无火",
      "tip": "手要快一点，黄油化了挞皮就不酥。",
      "visual_cue": "面絮粗砂状，捏团能散"
    },
    {
      "n": 3,
      "text": "加一个鸡蛋揉成光滑面团，再冷藏松弛三十分钟。",
      "time_min": 35,
      "heat": "无火",
      "tip": "冷藏之后再擀，挞皮才不会回缩。",
      "visual_cue": "面团光滑偏硬，按下去有弹性"
    },
    {
      "n": 4,
      "text": "面团擀成三毫米厚的圆片，铺进挞盘后压紧边缘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "贴着盘壁压紧，烤完才不会脱边。",
      "visual_cue": "挞皮贴盘，边缘高出少许"
    },
    {
      "n": 5,
      "text": "用叉子在底部戳一些小孔，冷藏十分钟再烤。",
      "time_min": 12,
      "heat": "无火",
      "tip": "戳孔让气体排出，挞底才不会鼓起来。",
      "visual_cue": "挞底密布小孔，边缘齐整"
    },
    {
      "n": 6,
      "text": "烤箱预热一百九十度，空烤十五分钟至浅金。",
      "time_min": 16,
      "heat": "中火",
      "tip": "先空烤让挞皮定型，倒馅时才不会塌。",
      "visual_cue": "挞皮浅金，边缘微焦"
    },
    {
      "n": 7,
      "text": "牛奶用小火慢慢加热到锅边冒小泡，千万别烧开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶一沸腾就起皮，温度一定要压住。",
      "visual_cue": "奶面微微冒气，边缘起小泡"
    },
    {
      "n": 8,
      "text": "鸡蛋与剩余白糖打散，慢慢冲入热牛奶搅匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一边倒一边搅，蛋液才不会结块。",
      "visual_cue": "液体顺滑浅黄，无颗粒"
    },
    {
      "n": 9,
      "text": "混合液倒回锅里小火加热，不停搅动到稠厚。",
      "time_min": 7,
      "heat": "小火",
      "tip": "木勺刮着锅底不停搅，一停就糊底。",
      "visual_cue": "勺背挂厚糊，搅动有阻力"
    },
    {
      "n": 10,
      "text": "加黄油与柠檬皮屑拌匀，再倒入挞皮里抹平。",
      "time_min": 4,
      "heat": "无火",
      "tip": "表面一定要抹得平整，冷却后才好切块。",
      "visual_cue": "馅面平整光滑，香气浓郁"
    },
    {
      "n": 11,
      "text": "放凉后再冷藏两小时，表面撒一层糖粉切块。",
      "time_min": 130,
      "heat": "无火",
      "tip": "彻底冷藏定型后再切，切面才整齐。",
      "visual_cue": "馅体凝固微颤，切块棱角清楚"
    }
  ],
  "tips": [
    "黄油要冷，搓面时手快，挞皮才酥。",
    "蛋奶液回锅后必须不停搅，防糊底。",
    "冷藏两小时以上再切，切面才干净。"
  ],
  "common_mistakes": [
    "黄油软化过度再搓面，挞皮烤完又硬又油。",
    "加热时停手不搅，锅底结一层焦块。",
    "没冷藏到定型就切，馅会流满一盘子。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "800 毫升:500 毫升加 300 毫升牛奶",
      "note": "更浓更香，冷藏时间要更久。"
    },
    {
      "original": "柠檬",
      "substitute": "橙子",
      "ratio": "30 克:40 克",
      "note": "果香更甜，酸味更淡。"
    }
  ],
  "variations": [
    "表面撒厚厚一层肉桂粉，风味更传统。",
    "挞皮改用消化饼干碎加黄油压成，省时又省力。"
  ],
  "serving_suggestion": "切一角配红茶，冷藏后食用最清爽，也是南非家庭待客的必备甜点。",
  "storage": "冷藏三天，表面盖保鲜膜防干裂。",
