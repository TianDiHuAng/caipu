          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "刷面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "烤架",
    "刷子",
    "保鲜膜",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶温热，加白糖和酵母静置十分钟。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "牛奶别烫手，太热会把酵母烫死。，火候要稳，别忽大忽小。",
      "visual_cue": "表面起泡，酵母活跃"
    },
    {
      "n": 2,
      "text": "面粉加盐，倒入酵母牛奶和融化黄油。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐别和酵母直接接触，会抑制发酵。，火候要稳，别忽大忽小。",
      "visual_cue": "面絮成团，湿度适中"
    },
    {
      "n": 3,
      "text": "揉十分钟到面团光滑有弹性。，火候要稳，别忽大忽小。",
      "time_min": 11,
      "heat": "无火",
      "tip": "揉出筋膜，烤后才松软。，火候要稳，别忽大忽小。",
      "visual_cue": "面团光滑，按下去回弹"
    },
    {
      "n": 4,
      "text": "盖膜发酵一小时，涨到两倍大。，火候要稳，别忽大忽小。",
      "time_min": 62,
      "heat": "无火",
      "tip": "放温暖处，别吹风。，火候要稳，别忽大忽小。",
      "visual_cue": "体积膨胀，指压缓慢回弹"
    },
    {
      "n": 5,
      "text": "排气后分成八份，搓圆再按扁。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "按成一厘米厚，烤时才不夹生。，火候要稳，别忽大忽小。",
      "visual_cue": "面坯扁平，大小一致"
    },
    {
      "n": 6,
      "text": "盖布二次醒发二十分钟。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "无火",
      "tip": "醒过再烤，饼才蓬松。，火候要稳，别忽大忽小。",
      "visual_cue": "面坯变轻，边缘圆润"
    },
    {
      "n": 7,
      "text": "烤架中火，饼坯刷植物油。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "火别太旺，外面焦里面生。，火候要稳，别忽大忽小。",
      "visual_cue": "架子温热，油光闪，这一点很关键。"
    },
    {
      "n": 8,
      "text": "每面烤六分钟，鼓起金黄即可。，火候要稳，别忽大忽小。",
      "time_min": 14,
      "heat": "中火",
      "tip": "勤翻面，烤到敲起来空响。，火候要稳，别忽大忽小。",
      "visual_cue": "表面焦斑，饼身鼓起"
    }
  ],
  "tips": [
    "牛奶温热不烫手，酵母才活。，这一点很关键。",
    "二次醒发别省，饼才蓬松。，这一点很关键。",
    "中火慢烤，里面才熟透。，这一点很关键。"
  ],
  "common_mistakes": [
    "牛奶太烫，酵母全烫死，面发不起来。",
    "饼按太厚，中间夹生。，这一点很关键。",
    "火太大，外皮焦黑里面湿。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "280 毫升:260 毫升",
      "note": "少了奶香，需多加黄油十克。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "40 克:35 毫升",
      "note": "口感稍硬，风味更淡。"
    }
  ],
  "variations": [
    "面团里加一把奶酪丝，烤后拉丝。，这一点很关键。",
    "表面撒粗盐和迷迭香，风味更足。，这一点很关键。"
  ],
  "serving_suggestion": "趁热撕开，夹香肠和洋葱酱。，这一点很关键。",
  "storage": "常温一天，冷冻两周，复烤五分钟。",
