      "group": "main",
      "items": [
        {
          "name": "南瓜",
          "name_en": "pumpkin",
          "amount": 400,
          "unit": "g",
          "note": "去皮去籽，切块蒸熟",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "flour",
          "amount": 150,
          "unit": "g",
          "note": "普通面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "打散",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 30,
          "unit": "g",
          "note": "面糊用",
          "optional": false
        },
        {
          "name": "肉桂粉",
          "name_en": "ground-cinnamon",
          "amount": 3,
          "unit": "g",
          "note": "一半入糊一半撒面",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable-oil",
          "amount": 40,
          "unit": "ml",
          "note": "煎饼用",
          "optional": false
        },
        {
          "name": "糖粉",
          "name_en": "powdered-sugar",
          "amount": 10,
          "unit": "g",
          "note": "出锅撒面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "压泥器",
    "大碗",
    "平底不粘锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜块上锅蒸十五分钟至用筷子能轻松扎透，取出倒掉盘里的水。",
      "time_min": 15,
      "heat": "中火",
      "tip": "蒸完一定把水倒掉，面糊才不稀。",
      "visual_cue": "南瓜一压就碎，盘底无积水"
    },
    {
      "n": 2,
      "text": "趁热把南瓜压成细腻的泥，放凉到不烫手再加鸡蛋。",
      "time_min": 5,
      "heat": "无火",
      "tip": "太烫会把鸡蛋烫成蛋花。",
      "visual_cue": "泥体顺滑无颗粒，温度微温"
    },
    {
      "n": 3,
      "text": "南瓜泥里加鸡蛋、白糖、盐和一半肉桂粉拌匀，再分次筛入面粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面粉分两次加，稠度更好控制。",
      "visual_cue": "面糊能挂在勺背上缓慢滴落"
    },
    {
      "n": 4,
      "text": "面糊静置五分钟让面粉吸水，状态太稀可补一小勺面粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置后稠度会变，别一开始就加粉。",
      "visual_cue": "面糊略微收紧，滴落变慢"
    },
    {
      "n": 5,
      "text": "平底锅倒薄薄一层植物油，中火烧热，用勺舀面糊摊成六厘米小饼。",
      "time_min": 6,
      "heat": "中火",
      "tip": "一次别摊太多，留空隙好翻面。",
      "visual_cue": "边缘起小泡，底面金黄"
    },
    {
      "n": 6,
      "text": "两面各煎两到三分钟至金黄熟透，捞出放厨房纸吸油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "翻面轻压，饼厚的地方要煎透。",
      "visual_cue": "两面金黄，按压有弹性"
    },
    {
      "n": 7,
      "text": "装盘后混合糖粉和剩余肉桂粉，均匀筛在饼面上，趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "糖粉最后撒，早了会化掉。",
      "visual_cue": "表面覆一层薄薄白霜"
    }
  ],
  "tips": [
    "南瓜选肉质紧实的贝贝南瓜，水分少更好操作。",
    "面糊里加一小勺酸奶，成品更松软。",
    "煎好的饼可放烤箱一百度保温，一次上桌。"
  ],
  "common_mistakes": [
    "南瓜泥带水，面糊稀到摊不成形。",
    "锅里的油温太低，饼吸满油，吃起来发腻。",
    "火太大外面焦了里面还是生面糊。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "400克:400克",
      "note": "甜度更高，糖可减到二十克。"
    },
    {
      "original": "肉桂粉",
      "substitute": "肉豆蔻",
      "ratio": "3克:2克",
      "note": "香气更暖，用量减三分之一。"
    }
  ],
  "variations": [
    "面糊里拌入葡萄干，口感更有层次。",
    "做成咸口：去掉糖和肉桂，加黑胡椒和香菜碎。"
  ],
  "serving_suggestion": "配一杯红茶当下午茶，或摆在烧烤桌上当甜味配菜，趁热吃最香。",
  "storage": "冷藏三天，冷冻一个月；复热用平底锅干烙两分钟或烤箱一百六十度五分钟。",
