  "equipment": [
    "炭火烤炉或铸铁烤盘",
    "夹子",
    "刷子",
    "浅盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊排用厨房纸吸干血水，两面撒盐和黑胡椒，静置十分钟回温。",
      "time_min": 10,
      "heat": "无火",
      "tip": "回温后受热均匀，中心不会过生。",
      "visual_cue": "肉表面干爽，按下去有弹性"
    },
    {
      "n": 2,
      "text": "蒜末、柠檬汁、柠檬皮屑、橄榄油和辣椒粉拌成腌料，抹遍羊排。",
      "time_min": 5,
      "heat": "无火",
      "tip": "每块都抹到骨头边缘，香味才完整。",
      "visual_cue": "表面挂一层油亮腌料"
    },
    {
      "n": 3,
      "text": "腌三十分钟，室温放置即可，中途翻面一次。",
      "time_min": 30,
      "heat": "无火",
      "tip": "别腌过两小时，柠檬汁会让肉发糊。",
      "visual_cue": "肉质微微收紧，香气外散"
    },
    {
      "n": 4,
      "text": "炭火烧到表面泛白、手放上方能撑三秒，把羊排平铺上架。",
      "time_min": 5,
      "heat": "大火",
      "tip": "炭火别带明火苗，否则外焦内生。",
      "visual_cue": "炭块表面覆白灰，无高火焰"
    },
    {
      "n": 5,
      "text": "每面烤四分钟，翻面一次，厚的地方多给一分钟。",
      "time_min": 9,
      "heat": "大火",
      "tip": "只翻一次面，让表面形成焦壳。",
      "visual_cue": "两面焦褐，骨边略缩"
    },
    {
      "n": 6,
      "text": "用夹子轻按中心，有弹性即可离火，盖上锡纸静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置让肉汁回到纤维里，别马上切。",
      "visual_cue": "切面呈淡粉，盘底有少量肉汁"
    },
    {
      "n": 7,
      "text": "装盘撒一撮粗盐，配柠檬角挤汁，趁热上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐最后补，腌料里的盐已经起作用。",
      "visual_cue": "表面有盐粒反光，热气带柠檬香"
    }
  ],
  "tips": [
    "羊排选带厚脂肪层的，烤出来更香不干。",
    "没有炭火可用铸铁烤盘大火替代，风味略逊。",
    "烤前把骨头外露的部分包锡纸，防止烧黑。"
  ],
  "common_mistakes": [
    "直接用猛火烤，外层焦黑，里面还是生的。",
    "烤的过程中反复翻面，肉汁全流失，肉质发干。",
    "腌料里的柠檬汁放太多，肉质变粉发散。"
  ],
  "substitutions": [
    {
      "original": "羊排",
      "substitute": "羊肩肉",
      "ratio": "800克:800克",
      "note": "切成厚片，烤的时间延长三分钟。"
    },
    {
      "original": "辣椒粉",
      "substitute": "辣椒碎",
      "ratio": "3克:3克",
      "note": "颗粒更粗，可在出炉后撒。"
    }
  ],
  "variations": [
    "腌料里加一勺蜂蜜，出炉前刷一层更上色。",
    "撒一把香菜碎和石榴籽，做成开普马来风味。"
  ],
  "serving_suggestion": "配玉米糊、番茄炖菜和一份凉拌甜菜根，就是标准的南非烧烤桌。",
  "storage": "冷藏两天，复热用烤箱一百八十度六分钟，别用微波炉。",
