  "steps": [
    {
      "n": 1,
      "text": "羊肉切成四厘米见方的大块，用厨房纸吸干表面血水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块大才经得起长时间炖煮。",
      "visual_cue": "肉块方正，表面干爽"
    },
    {
      "n": 2,
      "text": "厚底锅烧热倒植物油，羊肉分批下锅，每面煎到褐黄。",
      "time_min": 8,
      "heat": "中大火",
      "tip": "分批煎，锅里挤太满就变煮。",
      "visual_cue": "肉块表面焦褐，油脂析出"
    },
    {
      "n": 3,
      "text": "下洋葱丝与大蒜，中火炒到洋葱透明出甜味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱垫底能防肉粘锅。",
      "visual_cue": "洋葱软塌，锅底微焦"
    },
    {
      "n": 4,
      "text": "放番茄块翻炒两分钟，加盐、黑胡椒与香叶。",
      "time_min": 2,
      "heat": "中火",
      "tip": "此时不要加水，靠蔬菜自身出水。",
      "visual_cue": "番茄塌软，锅底有汁"
    },
    {
      "n": 5,
      "text": "转小火加盖慢炖四十五分钟，中途不开盖不搅拌。",
      "time_min": 45,
      "heat": "小火",
      "tip": "这道菜讲究不搅，层次才分明。",
      "visual_cue": "盖沿冒细气，香气变浓"
    },
    {
      "n": 6,
      "text": "把土豆块与胡萝卜块铺在肉上，加盖再炖三十分钟。",
      "time_min": 30,
      "heat": "小火",
      "tip": "蔬菜铺面靠蒸汽焖熟，不会煮烂。",
      "visual_cue": "土豆边缘发亮，能插入筷子"
    },
    {
      "n": 7,
      "text": "关火静置十分钟，尝味后补盐，连锅端上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置让汤汁回吸进肉里。",
      "visual_cue": "汤汁浅褐，肉块完整"
    }
  ],
  "tips": [
    "全程小火，锅底一旦糊就整锅带苦味。",
    "带骨羊肩比纯瘦肉香，骨髓能化进汤里。",
    "不开盖是原则，每开一次要补十分钟火候。"
  ],
  "common_mistakes": [
    "中途频繁搅拌，土豆碎成糊把汤弄浑。",
    "火太大导致锅底焦糊，汤汁发苦。",
    "一开始就加水，成品变成清汤炖菜。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "800 克:800 克",
      "note": "选牛腩，炖制时间延长二十分钟。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "400 克:400 克",
      "note": "甜味更突出，容易散，缩短十分钟。"
    }
  ],
  "variations": [
    "加一把青豆，颜色和口感都更丰富。",
    "用炭火慢炖，锅边会带上烟熏香。"
  ],
  "serving_suggestion": "连锅端上桌，配玉米面粥或面包一起舀着吃。",
  "storage": "冷藏三天，复热时加少量清水小火慢热，不要大火滚。",
