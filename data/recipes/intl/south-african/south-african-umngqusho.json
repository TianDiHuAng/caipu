  "steps": [
    {
      "n": 1,
      "text": "红豆提前泡八小时，涨到两倍大。，火候要稳，别忽大忽小。",
      "time_min": 482,
      "heat": "无火",
      "tip": "泡够时间，煮时才容易软。，火候要稳，别忽大忽小。",
      "visual_cue": "豆粒饱满，皮皱展开"
    },
    {
      "n": 2,
      "text": "玉米粒冲洗两遍，沥干备用。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "干玉米要多冲，去掉表面浮尘。，火候要稳，别忽大忽小。",
      "visual_cue": "玉米粒干净，无杂质"
    },
    {
      "n": 3,
      "text": "锅中倒清水，放玉米粒大火煮开。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水要一次加够，中途别添冷水。，火候要稳，别忽大忽小。",
      "visual_cue": "汤面翻滚，玉米浮起"
    },
    {
      "n": 4,
      "text": "转小火煮三十分钟，玉米开始变软。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢煮，玉米才糯。，火候要稳，别忽大忽小。",
      "visual_cue": "玉米膨胀，汤色微白"
    },
    {
      "n": 5,
      "text": "加泡好的红豆同煮二十五分钟。，火候要稳，别忽大忽小。",
      "time_min": 27,
      "heat": "小火",
      "tip": "红豆后放，避免煮成豆沙。，火候要稳，别忽大忽小。",
      "visual_cue": "豆粒裂开，汤变稠，这一点很关键。"
    },
    {
      "n": 6,
      "text": "另起锅用黄油炒香洋葱和蒜末。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "黄油别烧焦，小火炒。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱透明，奶香扑鼻"
    },
    {
      "n": 7,
      "text": "炒好的洋葱拌入锅中，加盐和黑胡椒。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "小火",
      "tip": "拌匀后再煮五分钟，味道才融。，火候要稳，别忽大忽小。",
      "visual_cue": "汤稠挂勺，香气融合"
    },
    {
      "n": 8,
      "text": "尝味补盐，盛碗趁热吃。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐最后调，豆子才易软。，火候要稳，别忽大忽小。",
      "visual_cue": "豆玉米软糯，汤汁浓稠"
    }
  ],
  "tips": [
    "红豆必须提前泡够，否则久煮不软。",
    "玉米先煮，红豆后放。，这一点很关键。",
    "盐最后加，豆子才容易煮烂。，这一点很关键。"
  ],
  "common_mistakes": [
    "红豆没泡直接煮，硬得咬不动。，这一点很关键。",
    "中途加冷水，豆子皮皱发硬。，这一点很关键。",
    "煮太久，红豆全化成泥。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "绿豆",
      "ratio": "200 克:200 克",
      "note": "煮的时间缩短十分钟。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30 克:25 毫升",
      "note": "少了奶香，口感更清爽。"
    }
  ],
  "variations": [
    "加一点辣椒粉，味道更跳。，这一点很关键。",
    "配炖羊肉一起吃，是传统搭配。，这一点很关键。"
  ],
  "serving_suggestion": "配烤香肠或炖肉，撒黑胡椒。，这一点很关键。",
  "storage": "冷藏三天，冷冻一个月。，这一点很关键。",
