  "equipment": [
    "炒锅",
    "木铲",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切细丝，青椒去籽切条，番茄切成的小丁备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切得越细，成品越像泥状拌菜。",
      "visual_cue": "大小均匀，洋葱散开"
    },
    {
      "n": 2,
      "text": "炒锅烧热倒植物油，下洋葱丝中小火炒到透明发甜。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "洋葱炒透才没有生辣味。",
      "visual_cue": "洋葱变软，边缘透明"
    },
    {
      "n": 3,
      "text": "加入咖喱粉与小米辣圈，快速翻炒到香气散出。",
      "time_min": 1,
      "heat": "小火",
      "tip": "咖喱粉遇油才出香，炒久了会苦。",
      "visual_cue": "油色转黄，香味冲鼻"
    },
    {
      "n": 4,
      "text": "下番茄丁翻炒三分钟，压出汁水成浓稠底料。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄炒出沙，酸甜打底。",
      "visual_cue": "番茄塌软，锅底有红汁"
    },
    {
      "n": 5,
      "text": "加入胡萝卜丝与青椒条，翻炒两分钟至断生。",
      "time_min": 2,
      "heat": "中火",
      "tip": "保持脆感，别炒到发黄。",
      "visual_cue": "青椒转亮绿，边缘略软"
    },
    {
      "n": 6,
      "text": "放卷心菜丝和盐，翻炒三分钟至略软但仍带脆口。",
      "time_min": 3,
      "heat": "中火",
      "tip": "卷心菜最后下，出水少。",
      "visual_cue": "菜丝塌下但仍有嚼劲"
    },
    {
      "n": 7,
      "text": "淋入白醋拌均匀，关火后稍放凉再装碗，覆膜冷藏。",
      "time_min": 1,
      "heat": "小火",
      "tip": "醋关火前放，酸味才清亮。",
      "visual_cue": "汁水微红，酸香扑鼻"
    }
  ],
  "tips": [
    "冷藏两小时后风味更融合，适合提前做。",
    "咖喱粉先炒香再下蔬菜，是这道菜的关键。",
    "配烤肉或面包粥吃，解腻效果最好。"
  ],
  "common_mistakes": [
    "卷心菜一开始就下锅，炒到软烂出水。",
    "咖喱粉撒在汤里没炒香，吃着只有粉味。",
    "白醋早放，酸味被长时间加热挥发掉。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "大白菜",
      "ratio": "300 克:300 克",
      "note": "出水略多，炒制时间缩短一分钟。"
    },
    {
      "original": "小米辣",
      "substitute": "辣椒粉",
      "ratio": "8 克:4 克",
      "note": "辣味更均匀，香气偏干。"
    }
  ],
  "variations": [
    "加一勺番茄膏，成品颜色更红亮。",
    "拌入煮熟的玉米粒，口感更甜更有嚼头。"
  ],
  "serving_suggestion": "装碗后冷藏半小时，配烤肉、香肠或面包粥一起吃。",
  "storage": "冷藏三天，复热用炒锅翻热两分钟，不要微波太久。",
