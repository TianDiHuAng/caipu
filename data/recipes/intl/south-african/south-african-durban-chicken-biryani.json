  "equipment": [
    "厚底锅",
    "烤盘",
    "锡纸",
    "滤网",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切三厘米块，加酸奶、蒜末、姜末、咖喱粉和一半盐抓匀，腌二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "酸奶能软化肉质，也让香料贴得住。",
      "visual_cue": "鸡肉裹上橙黄腌料，表面湿润"
    },
    {
      "n": 2,
      "text": "大米淘洗后泡二十分钟，沥干；小锅烧水加盐和姜黄，米煮六分钟至半熟捞出。",
      "time_min": 26,
      "heat": "中火",
      "tip": "米只煮到七成熟，后面还要焖。",
      "visual_cue": "米粒外层透明，中心留一点白芯"
    },
    {
      "n": 3,
      "text": "厚底锅化黄油，中火炒洋葱片八分钟至边缘焦糖色，盛出一半备用。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱炒到甜，是这道饭的底味。",
      "visual_cue": "洋葱呈深金褐色，锅底有糖色"
    },
    {
      "n": 4,
      "text": "锅里下肉桂粉和丁香炒香，倒入腌好的鸡块，中火煎炒十分钟至表面变白。",
      "time_min": 10,
      "heat": "中火",
      "tip": "腌料一起下锅，别提前抖掉。",
      "visual_cue": "鸡块外层收紧，锅里汁水微沸"
    },
    {
      "n": 5,
      "text": "把半熟米饭铺在鸡块上，撒预留的洋葱和剩余盐，淋五十毫升热水。",
      "time_min": 3,
      "heat": "小火",
      "tip": "米要盖满，别留空隙透气。",
      "visual_cue": "米饭平铺成层，表面撒着洋葱"
    },
    {
      "n": 6,
      "text": "盖严锅盖，小火焖二十五分钟，中途不要开盖。",
      "time_min": 25,
      "heat": "小火",
      "tip": "听声音判断，锅里不能烧干。",
      "visual_cue": "锅边冒细汽，闻到香料味"
    },
    {
      "n": 7,
      "text": "关火静置五分钟，开盖用木勺从底部翻起拌匀，撒香菜碎上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "翻拌要轻，米粒才不碎。",
      "visual_cue": "米粒金黄分明，鸡块完整"
    }
  ],
  "tips": [
    "用厚底锅或不粘锅，薄锅容易糊底。",
    "锅盖边围一条湿布，蒸汽不外逃。",
    "喜欢更辣可用辣椒粉替换部分咖喱粉。"
  ],
  "common_mistakes": [
    "米煮得太熟，焖完全部糊成一团。",
    "火开得太大，锅底焦糊了而鸡肉里面还是生的。",
    "焖到一半开盖加水，米饭夹生，香气也跑了。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "羊肉",
      "ratio": "600克:600克",
      "note": "切小块，焖的时间延长十分钟。"
    },
    {
      "original": "酸奶",
      "substitute": "椰奶",
      "ratio": "100克:100克",
      "note": "奶香更浓，酸度降低可加几滴柠檬汁。"
    }
  ],
  "variations": [
    "表层撒炸洋葱丝和葡萄干，口感更丰富。",
    "换成羊肉版本，加土豆块一同焖到软烂。"
  ],
  "serving_suggestion": "配一份黄瓜酸奶沙拉和酸辣酱，用手抓饭或勺子从底部挖起吃。",
  "storage": "冷藏三天，复热加一勺水盖盖小火八分钟；不建议冷冻，米饭会返生。",
