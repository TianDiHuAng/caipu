  "equipment": [
    "大碗",
    "擀面杖",
    "刀",
    "锅",
    "漏勺",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉、泡打粉和盐混合过筛。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛后更松，麻花才不硬。，火候要稳，别忽大忽小。",
      "visual_cue": "粉质细腻，无结块，这一点很关键。"
    },
    {
      "n": 2,
      "text": "加黄油搓成粗砂状，再倒牛奶和蛋液。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油要冷，搓出来才起酥。，火候要稳，别忽大忽小。",
      "visual_cue": "面絮松散，颗粒均匀"
    },
    {
      "n": 3,
      "text": "揉成光滑面团，盖布醒三十分钟。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "无火",
      "tip": "醒够时间，擀开才不回缩。，火候要稳，别忽大忽小。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 4,
      "text": "面团擀成半厘米厚，切成长条。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致，炸时才一起熟。，火候要稳，别忽大忽小。",
      "visual_cue": "面片平整，条宽均匀"
    },
    {
      "n": 5,
      "text": "每条编成三股麻花，捏紧两头。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "两端捏紧，炸时不会散。，火候要稳，别忽大忽小。",
      "visual_cue": "麻花紧实，形状整齐"
    },
    {
      "n": 6,
      "text": "清水加白糖、桂皮和柠檬汁，小火煮成糖浆。，火候要稳，别忽大忽小。",
      "time_min": 15,
      "heat": "小火",
      "tip": "煮到略挂勺就够，太稠裹不匀。，火候要稳，别忽大忽小。",
      "visual_cue": "糖浆微稠，颜色清亮"
    },
    {
      "n": 7,
      "text": "植物油烧到一百七十度，下麻花炸三分钟。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "中火",
      "tip": "油温别太高，里面要熟透。，火候要稳，别忽大忽小。",
      "visual_cue": "外皮金黄，浮起膨大"
    },
    {
      "n": 8,
      "text": "捞出趁热浸糖浆二十秒，翻面裹匀。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "趁热浸，糖浆才吸得进。，火候要稳，别忽大忽小。",
      "visual_cue": "表面挂浆，油润发亮"
    }
  ],
  "tips": [
    "面团醒够时间，擀开才不回缩。，这一点很关键。",
    "油温一百七十度，外脆内熟。，这一点很关键。",
    "趁热浸糖浆，吸得最透。，这一点很关键。"
  ],
  "common_mistakes": [
    "糖浆煮太稠，裹上结成硬壳。，这一点很关键。",
    "油温太高，外面焦里面生。，这一点很关键。",
    "麻花编太松，一炸就散开。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "50 克:45 毫升",
      "note": "少了奶香，口感稍硬。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "1 个:10 毫升",
      "note": "只取酸味，香气偏弱。"
    }
  ],
  "variations": [
    "糖浆里加一勺蜂蜜，风味更浓。，这一点很关键。",
    "表面撒椰丝，口感更丰富。，这一点很关键。"
  ],
  "serving_suggestion": "温热时吃最香，配红茶解甜。，这一点很关键。",
  "storage": "常温两天，冷藏五天，复热后食用。",
