        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 150,
          "unit": "ml",
          "note": "和面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "刀",
    "深锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加两克盐、二十毫升植物油和一百五十毫升清水，揉成光滑面团醒半小时。",
      "time_min": 32,
      "heat": "无火",
      "tip": "加点油揉面，炸出来的皮才起酥。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 2,
      "text": "牛肉切成小粒再粗剁几下，保留一点颗粒感。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别剁成泥，粗粒咬起来才有肉感。",
      "visual_cue": "肉粒均匀，略带黏性"
    },
    {
      "n": 3,
      "text": "平底锅放少量植物油，中火下洋葱碎炒到变软透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒软出甜味，馅才不会水气重。",
      "visual_cue": "洋葱透明，质地变软"
    },
    {
      "n": 4,
      "text": "加入牛肉粒炒到变色，再下孜然、姜末和辣椒粉炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香料下锅后小火炒，避免糊锅发苦。",
      "visual_cue": "肉粒变色，香料飘香"
    },
    {
      "n": 5,
      "text": "倒入煮熟的豌豆和盐一起炒匀，盛出来摊凉备用。",
      "time_min": 4,
      "heat": "中火",
      "tip": "馅必须放凉再包，热馅会把皮烫破。",
      "visual_cue": "馅料干爽，颜色分明"
    },
    {
      "n": 6,
      "text": "面团分成十份擀成薄圆片，对半切开成两个半圆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面片要擀得足够薄，炸完才层层酥脆。",
      "visual_cue": "面片薄透，边缘整齐"
    },
    {
      "n": 7,
      "text": "半圆面片折成锥形，填入一勺馅料，边缘抹水捏紧封口。",
      "time_min": 12,
      "heat": "无火",
      "tip": "封口抹点水再捏，下锅才不会开。",
      "visual_cue": "锥形饱满，封口紧实"
    },
    {
      "n": 8,
      "text": "深锅倒植物油烧到一百七十度，下咖喱角中小火炸六分钟。",
      "time_min": 10,
      "heat": "中小火",
      "tip": "油温别太高，外皮金黄时里面也要熟。",
      "visual_cue": "外皮金黄，浮起冒泡"
    },
    {
      "n": 9,
      "text": "捞出沥干油分，稍凉后配一碟酸辣蘸酱食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "沥油时垫厨房纸，成品才不油腻。",
      "visual_cue": "表面干爽，咬开酥脆"
    }
  ],
  "tips": [
    "面皮擀得薄一些，炸完才会层层起酥。",
    "馅要完全放凉再包，热馅会把皮烫软。",
    "油温保持一百七十度，外酥内熟不吸油。"
  ],
  "common_mistakes": [
    "面皮擀得太厚，炸完外面焦了里面还生。",
    "封口没捏紧，下锅后馅全漏进油里。",
    "油温太高，外皮发黑而肉粒还是生的。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "350 克:350 克",
      "note": "风味更浓，需多加姜末去膻。"
    },
    {
      "original": "豌豆",
      "substitute": "土豆",
      "ratio": "80 克:100 克",
      "note": "切小丁先煮软，口感更绵。"
    }
  ],
  "variations": [
    "加一小把葡萄干，甜咸交错更像开普敦版本。",
    "用鸡肉替代牛肉，口感更清淡一些。"
  ],
  "serving_suggestion": "趁热配一碟芒果酸辣酱或酸奶蘸料，是南非街头和家庭聚会都常见的点心。",
  "storage": "冷藏两天，复热用一百八十度烤八分钟恢复酥脆，微波会变软。",
