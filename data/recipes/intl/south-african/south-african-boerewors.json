    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉末和猪肉末放大碗，摊平。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "两种肉比例七比三，口感才不柴。，始终中小火，别心急。",
      "visual_cue": "肉末松散，颜色分明"
    },
    {
      "n": 2,
      "text": "桂皮和丁香碾成细粉，撒在肉上。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香料现碾，香气才够冲。，看住火，别让它失控。",
      "visual_cue": "粉层均匀，香气突出"
    },
    {
      "n": 3,
      "text": "加盐、黑胡椒、香菜碎和白醋。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "无火",
      "tip": "白醋能去腥，也让肉更松。，火大了就离锅远一点。",
      "visual_cue": "调料分布均匀，很多人在这里出错。"
    },
    {
      "n": 4,
      "text": "用手抓匀，抓到手感发黏。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别过度揉，肉会变硬。，锅温要匀，别忽高忽低。",
      "visual_cue": "肉馅起胶，能抱团，这里最容易翻车。"
    },
    {
      "n": 5,
      "text": "肉馅搓成两厘米粗的长条，盘成圈。，火力保持中等，慢慢来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "粗细一致，烤时才一起熟。，火候宁小勿大，慢慢推进。",
      "visual_cue": "条身紧实，粗细均匀"
    },
    {
      "n": 6,
      "text": "冷藏半小时定型，表面刷植物油。，注意锅里温度别掉下来。",
      "time_min": 32,
      "heat": "无火",
      "tip": "定型后再烤，才不塌。，始终中小火，别心急。",
      "visual_cue": "表面油亮，形状稳定"
    },
    {
      "n": 7,
      "text": "烤架中火，每面烤八分钟。，火要均匀，食材才不糊。",
      "time_min": 18,
      "heat": "中火",
      "tip": "中火慢烤，里面才熟透。，看住火，别让它失控。",
      "visual_cue": "表面焦褐，油脂滴落"
    },
    {
      "n": 8,
      "text": "切开确认中心不再发红，静置三分钟。，全程留意火候，别贪快。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置让肉汁收回，切时不出水。，火大了就离锅远一点。",
      "visual_cue": "切面灰褐，肉汁清亮"
    }
  ],
  "tips": [
    "肉比例七比三，太瘦会干。，别小看这一步。",
    "香料现碾，香气才能窜出来。，成败就在这一步。",
    "中火慢烤，外面不焦里面熟。，这点要注意。"
  ],
  "common_mistakes": [
    "全程大火，外面焦黑里面生。，这是关键点。",
    "盐放太早又放太多，肉变硬。，别嫌麻烦，做完它。",
    "肉抓得太久，香肠口感发紧。，这一步别省。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "300 克:300 克",
      "note": "更瘦，需多加植物油二十毫升。"
    },
    {
      "original": "桂皮",
      "substitute": "甜椒粉",
      "ratio": "3 克:5 克",
      "note": "香气更甜，少了暖味。"
    }
  ],
  "variations": [
    "加一点白兰地，香气更浓。，别跳过这步。",
    "加半勺肉豆蔻粉，风味更像老式做法。"
  ],
  "serving_suggestion": "配玉米糊和洋葱番茄酱，卷面包吃。",
  "storage": "冷藏三天，冷冻一个月。，这步最关键。",
