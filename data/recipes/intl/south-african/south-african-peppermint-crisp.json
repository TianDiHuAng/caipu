  "equipment": [
    "方形活底模",
    "保鲜袋",
    "擀面杖",
    "电动打蛋器",
    "冰箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "消化饼干装进保鲜袋压成粗颗粒，留两把做表面撒料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "留一点粗粒，成品才有脆感层次。",
      "visual_cue": "碎屑大小不一，无整块饼干"
    },
    {
      "n": 2,
      "text": "融化的黄油倒进饼屑拌匀，铺进模具底部压实，冷藏十分钟定型。",
      "time_min": 10,
      "heat": "无火",
      "tip": "压得越实，切块越不散。",
      "visual_cue": "饼底平整紧实，按压不下陷"
    },
    {
      "n": 3,
      "text": "炼乳加酸奶用打蛋器打到顺滑发亮，颜色变浅、体积略涨。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打匀就好，打太久会稀。",
      "visual_cue": "质地像浓稠的慕斯，能缓缓流下"
    },
    {
      "n": 4,
      "text": "把打好的炼乳糊倒进模具里抹平，厚度保持均匀一致。",
      "time_min": 2,
      "heat": "无火",
      "tip": "用刮刀轻轻推，别把饼底带起来。",
      "visual_cue": "表面平整，边缘无气泡"
    },
    {
      "n": 5,
      "text": "黑巧克力刮成薄片或刨碎，均匀撒在表面，再撒预留的饼屑。",
      "time_min": 4,
      "heat": "无火",
      "tip": "巧克力提前冷藏，刨出来才成片。",
      "visual_cue": "表层铺满深褐巧克力碎"
    },
    {
      "n": 6,
      "text": "冷藏三小时以上至完全凝固，脱模后筛可可粉、点薄荷丝。",
      "time_min": 180,
      "heat": "无火",
      "tip": "至少三小时，急冻会有冰渣。",
      "visual_cue": "切面层次清晰，饼底不下塌"
    }
  ],
  "tips": [
    "用带薄荷夹心的巧克力条，风味最接近原版。",
    "脱模前用热毛巾捂模具外壁五秒，边缘更干净。",
    "切块时刀先热水烫一下再擦干，切口利落。"
  ],
  "common_mistakes": [
    "黄油放得太少，饼底压不实，一切就散成碎屑。",
    "炼乳糊没有打匀就入模，冷藏后出现明显分层。",
    "冷藏时间不够就脱模，边缘塌成一片。"
  ],
  "substitutions": [
    {
      "original": "消化饼干",
      "substitute": "全麦饼干",
      "ratio": "250克:250克",
      "note": "甜度略低，可在饼屑里加十克糖。"
    },
    {
      "original": "酸奶",
      "substitute": "酸奶油",
      "ratio": "200克:200克",
      "note": "质地更稠，冷藏时间可缩短半小时。"
    }
  ],
  "variations": [
    "中间加一层香蕉片，口感更清爽。",
    "表面换成白巧克力碎，颜色对比更明显。"
  ],
  "serving_suggestion": "切成长方块，配一杯不加糖的黑咖啡，中和甜度。",
  "storage": "密封冷藏三天，冷冻可两周；冷冻取出放冷藏半小时再切。",
