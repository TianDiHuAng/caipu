  "equipment": [
    "炖锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切末，番茄切丁，大蒜与姜分别切末备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "三种辛香料切得越细，咖喱底味越均匀。",
      "visual_cue": "配料切好分装，颗粒细小"
    },
    {
      "n": 2,
      "text": "炖锅下植物油烧热，炒香洋葱末直到透明微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到微微发黄，甜味才完全释放。",
      "visual_cue": "洋葱软塌金黄，锅中香气浓"
    },
    {
      "n": 3,
      "text": "加蒜末、姜末、咖喱粉与姜黄炒一分钟，让香料出油。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "香料遇油才出色，粉状料别炒过头会发苦。",
      "visual_cue": "锅中橙黄色油亮，辛香扑鼻"
    },
    {
      "n": 4,
      "text": "下鸡胸肉块翻炒，直到每一块表面都变白收紧。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡肉表面封住再炖，才不会流失汁水。",
      "visual_cue": "肉块表面转白，无粉色"
    },
    {
      "n": 5,
      "text": "加番茄丁与高汤煮开后，转小火炖二十五分钟至汤汁浓稠。",
      "time_min": 27,
      "heat": "小火",
      "tip": "炖到汤汁能挂在肉上最好，太稀会泡烂面包。",
      "visual_cue": "汤汁浓稠挂勺，番茄化开"
    },
    {
      "n": 6,
      "text": "加盐调定味道后撒上香菜碎，关火稍微放凉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "咖喱稍放凉再装面包，面包才不会被泡透。",
      "visual_cue": "咖喱浓稠，香菜翠绿"
    },
    {
      "n": 7,
      "text": "方形面包从中间剖开挖出部分面包心，填入咖喱鸡肉，盖上撕下的面包片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "挖空时留两厘米壁厚，太薄会漏汤。",
      "visual_cue": "面包壁完整，咖喱刚好填满"
    }
  ],
  "tips": [
    "用整条未切片的方形白面包，挖空才成型。",
    "咖喱一定要炖到浓稠，汤汁稀了面包立刻塌软。",
    "挖出的面包心别扔，蘸咖喱吃正好。"
  ],
  "common_mistakes": [
    "咖喱汤汁太多，装进面包后立刻漏一桌。",
    "面包挖太空只留薄皮，一拿就散。",
    "咖喱粉没炒出香就加水，味道生涩发苦。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "羊肉",
      "ratio": "500 克:500 克",
      "note": "炖制时间延长十五分钟，风味更浓。"
    },
    {
      "original": "面包",
      "substitute": "面包卷",
      "ratio": "600 克:600 克",
      "note": "单个分量更小，适合一人份。"
    }
  ],
  "variations": [
    "用豆类代替鸡肉，做成素食咖喱面包盅。",
    "咖喱里加一颗土豆切丁，口感更饱足。"
  ],
  "serving_suggestion": "直接端着面包吃，配一杯冰可乐或南非本地汽水。",
  "storage": "咖喱冷藏三天、冷冻一个月；面包现挖现吃，不建议冷藏，复热咖喱后再装。",
