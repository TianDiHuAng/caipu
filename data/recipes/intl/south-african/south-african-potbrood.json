    "大碗",
    "擀面杖",
    "厨房布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水加白糖化开，撒入酵母静置八分钟，表面起一层细泡说明活性正常。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水温别超过四十度，烫了酵母就死。",
      "visual_cue": "液面浮起细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉加盐拌匀，倒入酵母水和融化黄油，揉十二分钟至面团光滑有弹性。",
      "time_min": 12,
      "heat": "无火",
      "tip": "揉到能拉出薄膜，面团才蓬松。",
      "visual_cue": "面团光滑不粘手，按下去回弹"
    },
    {
      "n": 3,
      "text": "面团盖布放温暖处发酵一小时，体积涨到原来两倍。",
      "time_min": 60,
      "heat": "无火",
      "tip": "冬天可放烤箱旁，别超过四十度。",
      "visual_cue": "手指戳洞不回缩，内部呈蜂窝状"
    },
    {
      "n": 4,
      "text": "牛肉末加洋葱丁、盐和黑胡椒拌成馅，中火炒六分钟至变色收干。",
      "time_min": 6,
      "heat": "中火",
      "tip": "馅要炒干水汽，否则面团底部发黏。",
      "visual_cue": "肉末松散无汤水，洋葱变透明"
    },
    {
      "n": 5,
      "text": "面团排气后擀成厚饼，铺一半肉馅，卷起揉圆后再擀开，包入剩余馅料收口朝下。",
      "time_min": 8,
      "heat": "无火",
      "tip": "收口捏紧压平，烤时才不会裂开。",
      "visual_cue": "面团包住馅料，表面平整"
    },
    {
      "n": 6,
      "text": "铸铁锅刷油，面团放入盖盖，二次发酵三十五分钟至明显膨胀。",
      "time_min": 35,
      "heat": "无火",
      "tip": "锅要够深，留出膨胀空间。",
      "visual_cue": "面团顶到接近锅沿"
    },
    {
      "n": 7,
      "text": "烤箱预热两百二十度，锅盖盖烤四十分钟，揭盖再烤十二分钟上色。",
      "time_min": 52,
      "heat": "中火",
      "tip": "先盖盖保蒸汽，后揭盖上脆皮。",
      "visual_cue": "表皮深金黄，敲起来有空响"
    },
    {
      "n": 8,
      "text": "取出脱模，放在晾架上十分钟再切块，趁热配黄油。",
      "time_min": 10,
      "heat": "无火",
      "tip": "刚出炉别急着切，内部还在定型。",
      "visual_cue": "切面气孔均匀，肉馅分层清晰"
    }
  ],
  "tips": [
    "用铸铁锅保温好，锅底可先垫烘焙纸防粘。",
    "面团发酵看状态不看时间，室温低就多等一会。",
    "肉馅可提前一晚炒好，冷藏后更好包。"
  ],
  "common_mistakes": [
    "面团没发到位就进烤箱，成品又硬又实。",
    "炒肉馅时没把水汽收干，面包底部湿黏发软。",
    "全程盖盖烤，表皮发白发软不上色。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "牛肉末",
      "ratio": "300克:300克",
      "note": "也可换成羊肉末，膻香更重。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30克:25毫升",
      "note": "奶香略淡，表皮会稍薄。"
    }
  ],
  "variations": [
    "馅里加一勺咖喱粉，做成开普马来风味的版本。",
    "加一把奶酪碎同包，切开会拉丝。"
  ],
  "serving_suggestion": "切厚片配炖菜或汤，也可以撕开夹香肠和辣酱，是南非烧烤桌上的主食。",
  "storage": "常温密封两天，冷藏四天；复热用一百六十度烤八分钟恢复脆皮。",
