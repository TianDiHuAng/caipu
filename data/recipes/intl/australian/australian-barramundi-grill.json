  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去内脏洗净，用厨房纸把里外擦干。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鱼身擦干，烤出来皮才脆。，注意火候。",
      "visual_cue": "表面干爽，无水珠，状态稳定"
    },
    {
      "n": 2,
      "text": "鱼身两侧各划三刀，抹盐和黑胡椒腌十分钟。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刀口划到骨，热和味道才进得去。，注意火候。",
      "visual_cue": "刀口整齐，盐已融化，状态稳定"
    },
    {
      "n": 3,
      "text": "柠檬切圆片，塞进鱼腹，再放两枝迷迭香。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "腹中塞柠檬，能压住土腥味。，注意火候。",
      "visual_cue": "鱼腹饱满，香气清亮，状态稳定"
    },
    {
      "n": 4,
      "text": "橄榄油拌蒜末，用刷子在鱼身两面刷一层。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜末拌油刷，烤完有淡淡蒜香。，注意火候。",
      "visual_cue": "鱼身油亮，蒜末均匀，状态稳定"
    },
    {
      "n": 5,
      "text": "烤箱两百一十度预热，鱼放烤盘入炉烤十二分钟。",
      "time_min": 13,
      "heat": "-",
      "tip": "高温快烤，肉才嫩不干。，注意火候。",
      "visual_cue": "表皮收紧，颜色微黄，状态稳定"
    },
    {
      "n": 6,
      "text": "取出放上黄油片，回炉再烤三分钟到黄油融化。",
      "time_min": 4,
      "heat": "-",
      "tip": "黄油最后加，奶香不被烤跑。，注意火候。",
      "visual_cue": "黄油融化，鱼皮起泡，状态稳定"
    },
    {
      "n": 7,
      "text": "出炉撒欧芹碎，挤剩余柠檬汁后趁热上桌。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "上桌前再挤汁，酸香才清新。，注意火候。",
      "visual_cue": "鱼皮金黄，汁水清亮，状态稳定"
    }
  ],
  "tips": [
    "鱼身一定擦干，烤出来皮才脆。，值得留意。",
    "腹中塞柠檬和迷迭香，能压住腥味。，值得留意。",
    "高温快烤十二分钟，肉才嫩不柴。，值得留意。"
  ],
  "common_mistakes": [
    "鱼没擦干就烤，皮软塌不出脆感。，值得留意。",
    "烤太久，鱼肉干柴发硬。，值得留意。",
    "盐抹太多，盖掉鱼本身的鲜甜。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "罗非鱼",
      "ratio": "600 克:600 克",
      "note": "肉更紧，烤制时间加两分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "80 克:70 克",
      "note": "香气更冲，酸味更重。"
    }
  ],
  "variations": [
    "涂一层味噌酱再烤，咸鲜更浓。，值得留意。",
    "撒少许辣椒粉，皮更香。，值得留意。"
  ],
  "serving_suggestion": "配烤蔬菜和一杯白葡萄酒，柠檬角摆盘边。，效果更稳定。",
  "storage": "冷藏一天，复热用烤箱一百八十度烤六分钟。",
