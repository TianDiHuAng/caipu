  "steps": [
    {
      "n": 1,
      "text": "羊肉提前半小时从冰箱取出回温。，时间掐准，锅气才足。",
      "time_min": 32,
      "heat": "无火",
      "tip": "回温到位，受热才均匀。，火别太大，味道才不闷。",
      "visual_cue": "肉表不冰凉，手感柔，时间掐准，香气才不跑。"
    },
    {
      "n": 2,
      "text": "用刀在肉上划几道浅口，塞入蒜瓣。，起锅前尝味，香气才不跑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "口别太深，塞蒜不露头。，动作放连贯，颜色才够亮。",
      "visual_cue": "刀口整齐，蒜嵌入，份量心里有数，整道菜才立得住。"
    },
    {
      "n": 3,
      "text": "整块羊肉抹橄榄油、盐和黑胡椒。，慢慢来别急，香气才不跑。",
      "time_min": 5,
      "heat": "无火",
      "tip": "抹匀到边角，味才一致。，起锅前尝味，火候才均匀。",
      "visual_cue": "表面油亮，盐粒分布匀，慢慢来别急，风味才干净。"
    },
    {
      "n": 4,
      "text": "烤盘底铺土豆、胡萝卜和洋葱。，翻动放轻，锅气才足。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蔬果垫底，接收肉汁。，火别太大，吃口才舒服。",
      "visual_cue": "铺满盘底，厚薄一致，动作放连贯，口感才有层次。"
    },
    {
      "n": 5,
      "text": "羊肉放上去，倒清水到盘底。，翻动放轻，颜色才够亮。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水别没过蔬菜，蒸烤才香。，注意别烧干，口感才不散。",
      "visual_cue": "液面齐平，蔬菜半露，翻动放轻，成品才好看。"
    },
    {
      "n": 6,
      "text": "烤箱两百度烤二十分钟上色。，先试试温度，颜色才够亮。",
      "time_min": 22,
      "heat": "无火",
      "tip": "先高温定型，肉汁才锁住。，份量心里有数，味道才不闷。",
      "visual_cue": "表面焦褐，香气外溢，时间掐准，表面才漂亮。"
    },
    {
      "n": 7,
      "text": "转一百八十度，盖锡纸再烤五十分钟。，别急着加油，表面才漂亮。",
      "time_min": 52,
      "heat": "无火",
      "tip": "盖锡纸，肉才不会干。，料别一次下太多，风味才干净。",
      "visual_cue": "锡纸鼓起，肉汁清亮，翻动放轻，火候才均匀。"
    },
    {
      "n": 8,
      "text": "取出静置十五分钟，肉汁才回稳。，份量心里有数，颜色才够亮。",
      "time_min": 17,
      "heat": "无火",
      "tip": "静置一下，切时才不流汁。，汤汁别收太干，口感才有层次。",
      "visual_cue": "肉面微干，按压回弹，动作放连贯，吃口才舒服。"
    },
    {
      "n": 9,
      "text": "烤肉汁加面粉小火收稠，配着切片上桌。，锅温要匀，味道才进得去。",
      "time_min": 8,
      "heat": "小火",
      "tip": "收汁要小火，才不结块。，锅温要匀，口感才不散。",
      "visual_cue": "汁体浓稠，颜色棕亮，别急着加油，食材才不糊。"
    }
  ],
  "tips": [
    "肉回温后再烤，中心才不生。，别用力搅，香气才留得住。",
    "静置十五分钟，切时肉汁才不流失。，先试试温度，口感才不散。",
    "先高温上色，再低温烤透。，注意别烧干，吃口才舒服。"
  ],
  "common_mistakes": [
    "肉直接进烤箱，中心夹生。，留意锅底，风味才干净。",
    "不盖锡纸，表面烤成焦壳。，注意别烧干，风味才干净。",
    "切太早，肉汁流了一盘。，盖盖焖一会儿，细节才到位。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "1200 克:1200 克",
      "note": "烤制时间加十五分钟。"
    },
    {
      "original": "橄榄油",
      "substitute": "植物油",
      "ratio": "50 毫升:50 毫升",
      "note": "风味略淡，可加蒜末增香。"
    }
  ],
  "variations": [
    "加迷迭香，香气更草本。，别急着加油，口感才有层次。",
    "加柠檬皮屑，味道更清。，起锅前尝味，味道才进得去。"
  ],
  "serving_suggestion": "配烤蔬菜和薄荷酱。，翻动放轻，口感才不散。",
  "storage": "冷藏两天，切片后复热。，顺序照着来，形状才完整。",
