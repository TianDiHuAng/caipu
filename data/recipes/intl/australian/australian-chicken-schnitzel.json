          "note": "切碎",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "三个浅盘",
    "肉锤",
    "刀",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉横刀片成两片，用肉锤轻拍到一厘米厚。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拍到厚薄均匀，煎的时候才一起熟。，注意火候。",
      "visual_cue": "肉片匀薄，纹理松开，状态稳定"
    },
    {
      "n": 2,
      "text": "肉片两面撒盐和黑胡椒，静置五分钟入味。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先调味再裹粉，里面才有味。，注意火候。",
      "visual_cue": "表面泛盐，肉质回软，状态稳定"
    },
    {
      "n": 3,
      "text": "面粉、打散的蛋液和面包糠分别装进三个浅盘。",
      "time_min": 4,
      "heat": "无火",
      "tip": "顺序摆好，手才不会忙乱。，注意火候。",
      "visual_cue": "三盘就位，粉料均匀，状态稳定"
    },
    {
      "n": 4,
      "text": "肉片先裹面粉，再蘸蛋液，最后压紧面包糠。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "手掌压实，糠才不掉。，注意火候。",
      "visual_cue": "外层均匀，无裸露处，状态稳定"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油烧到一百七十度，放入鸡排中火煎。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油到鸡排一半高，煎出的壳才脆。，注意火候。",
      "visual_cue": "油面起泡，边缘定型，状态稳定"
    },
    {
      "n": 6,
      "text": "一面煎三分钟到金黄，翻面再煎两分半。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "只翻一次，壳才完整不脱。，注意火候。",
      "visual_cue": "两面金黄，外壳酥脆，状态稳定"
    },
    {
      "n": 7,
      "text": "捞出沥油，撒欧芹碎，配柠檬角挤汁。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "挤柠檬汁解腻，酸味提鲜。，注意火候。",
      "visual_cue": "外壳干爽，香气扑鼻，状态稳定"
    }
  ],
  "tips": [
    "鸡胸拍到一厘米厚，煎时才一起熟。，值得留意。",
    "面包糠用手压紧，煎时才不掉。，值得留意。",
    "油到鸡排一半高，不必整块淹油。，值得留意。"
  ],
  "common_mistakes": [
    "拍得太薄，煎完干柴没汁水。，值得留意。",
    "油温不够就下锅，外壳吸油发腻。，值得留意。",
    "翻面太频繁，脆壳全脱落。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "480 克:480 克",
      "note": "更嫩更多汁，煎制时间加一分钟。"
    },
    {
      "original": "面包糠",
      "substitute": "玉米面",
      "ratio": "140 克:120 克",
      "note": "颗粒更粗，口感更脆。"
    }
  ],
  "variations": [
    "上面铺一层番茄酱和奶酪烤化，就是帕尔玛鸡排。",
    "配蘑菇奶油酱一起吃，更像酒吧菜。，值得留意。"
  ],
  "serving_suggestion": "配薯条和沙拉，柠檬角放一边，挤汁后再吃。",
  "storage": "冷藏两天，复热用烤箱两百度烤六分钟。，效果更稳定。",
