          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 60,
          "unit": "g",
          "note": "切角",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 12,
