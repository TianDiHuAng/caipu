  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "蛋清",
          "name_en": "egg white",
          "amount": 180,
          "unit": "g",
          "note": "约六枚蛋的蛋白，冷藏后更易打发",
          "optional": false
        },
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 300,
          "unit": "ml",
          "note": "动物性，冷藏",
          "optional": false
        },
        {
          "name": "草莓",
          "name_en": "strawberry",
          "amount": 250,
          "unit": "g",
          "note": "去蒂，对半切",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 200,
          "unit": "g",
          "note": "细砂糖",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 15,
          "unit": "g",
          "note": "稳定蛋白霜",
          "optional": false
        },
        {
          "name": "白醋",
          "name_en": "white vinegar",
          "amount": 8,
          "unit": "ml",
          "note": "帮助蛋白霜定型",
          "optional": false
        },
        {
          "name": "香草荚",
          "name_en": "vanilla pod",
          "amount": 5,
          "unit": "ml",
          "note": "去蛋腥",
          "optional": false
        },
        {
          "name": "糖粉",
          "name_en": "powdered sugar",
          "amount": 20,
          "unit": "g",
          "note": "装饰撒面",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取汁淋水果",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "电动打蛋器",
    "裱花袋",
    "烤盘",
    "油纸",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热一百二十度，烤盘铺油纸，用碗底在纸上压出一个二十厘米的圆形痕迹。",
      "time_min": 12,
      "heat": "无火",
      "tip": "低温长时间烘烤是蛋白霜外壳干爽、内里绵软的关键。",
      "visual_cue": "纸上留下清晰的圆形压痕"
    },
    {
      "n": 2,
      "text": "蛋白用电动打蛋器中速打发到起粗泡，分三次加入白糖，每次打一分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "糖分三次加，蛋白霜才细腻稳定，一次倒完容易塌。",
      "visual_cue": "泡沫由粗变细，体积膨胀三倍"
    },
    {
      "n": 3,
      "text": "打到提起打蛋头呈直立尖角，加玉米淀粉、白醋和香草精，低速拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋白霜要打到硬性发泡，尖角挺立不弯才算够。",
      "visual_cue": "尖角直立，盆倒扣蛋白霜不流动"
    },
    {
      "n": 4,
      "text": "把蛋白霜堆在圆形压痕上，用刮刀从中心向外抹出放射状纹路，边缘略高。",
      "time_min": 6,
      "heat": "无火",
      "tip": "边缘堆高一点，烤后中间自然下陷，正好盛奶油和水果。",
      "visual_cue": "圆形蛋糕坯中间浅凹，表面有竖纹"
    },
    {
      "n": 5,
      "text": "放入烤箱一百二十度烤九十分钟，关火后留在炉内自然冷却一小时。",
      "time_min": 150,
      "heat": "小火",
      "tip": "烤完不要马上出炉，温差过大会让表面炸裂。",
      "visual_cue": "外壳呈米白色，轻敲有空洞声"
    },
    {
      "n": 6,
      "text": "淡奶油加糖粉打到七分发，铺在冷却的蛋白霜上，摆上草莓，挤柠檬汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "奶油打到能缓慢流动最好，太硬口感发腻。",
      "visual_cue": "奶油在蛋白霜上形成柔软的雪白一层"
    }
  ],
  "tips": [
    "蛋白盆和打蛋头必须无油无水，有一滴油就打不发。",
    "蛋白霜烤好后放凉再脱纸，热的时候极易碎。",
    "水果上桌前再摆，久放会出水浸软外壳。"
  ],
  "common_mistakes": [
    "蛋白里混入蛋黄，蛋白霜怎么也打不硬。",
    "烤箱温度过高，外壳焦黄而内部湿黏。",
    "奶油打得过硬，抹上去像黄油块，失去轻盈感。"
  ],
  "substitutions": [
    {
      "original": "草莓",
      "substitute": "菠萝",
      "ratio": "250 克:250 克",
      "note": "切成小块，酸度更高可多撒五克糖粉。"
    },
    {
      "original": "淡奶油",
      "substitute": "酸奶",
      "ratio": "300 毫升:300 克",
      "note": "需用浓稠希腊式酸奶并沥去水分。"
    }
  ],
  "variations": [
    "水果可换成芒果、猕猴桃或百香果，酸甜搭配各有风味。"
  ],
  "serving_suggestion": "整只端上桌切开分食，切时用沾热水的刀更利落。",
  "storage": "冷藏不超过一天，蛋白霜会吸潮变软；未加奶油的部分可室温密封放两天。",
