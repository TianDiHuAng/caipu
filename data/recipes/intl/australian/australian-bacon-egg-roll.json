  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和清水揉成柔软面团，盖好静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团偏软一点，烙出来的圆饼才好咬。",
      "visual_cue": "面团光滑，不粘手不裂"
    },
    {
      "n": 2,
      "text": "面团分成两份擀成一厘米厚的圆饼，用叉子在表面扎孔。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用叉子在表面扎几个小孔，烙时才不会鼓起。",
      "visual_cue": "圆饼扎孔，厚薄均匀"
    },
    {
      "n": 3,
      "text": "平底锅化开一半黄油，中小火把圆饼两面各烙三分钟。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "用中小火慢慢烙，圆饼里面才会熟透。",
      "visual_cue": "圆饼两面微黄起斑点"
    },
    {
      "n": 4,
      "text": "同一口锅放培根片，中火煎到边缘卷起、油脂析出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "培根煎到边缘微脆，吃起来口感最好。",
      "visual_cue": "培根卷边，锅里出油"
    },
    {
      "n": 5,
      "text": "用剩下的黄油把鸡蛋煎成单面半熟，撒盐和黑胡椒。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "蛋白凝固蛋黄仍流动，口感最好。",
      "visual_cue": "蛋白凝固，蛋黄微亮"
    },
    {
      "n": 6,
      "text": "圆饼从中间切开不切透，内侧抹一层番茄酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "切开时留一层底，夹料才不会漏出来。",
      "visual_cue": "切口整齐，内壁抹匀"
    },
    {
      "n": 7,
      "text": "依次塞入生菜、培根和煎蛋，合起来趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生菜垫在底部，饼皮才不被汁水泡软。",
      "visual_cue": "馅料饱满，层次分明"
    }
  ],
  "tips": [
    "面团偏软一点，烙出来的饼才好咬。",
    "圆饼扎几个小孔，烙时不会鼓成气泡。",
    "培根煎出油脂，再用锅里的油煎蛋更香。"
  ],
  "common_mistakes": [
    "圆饼擀得太厚，中间夹生外面已焦。",
    "鸡蛋煎到全熟发硬，切开没有流心。",
    "生菜没垫底，饼皮很快被汁水泡烂。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "120 克:120 克",
      "note": "咸度更低，煎制时间缩短。"
    },
    {
      "original": "番茄酱",
      "substitute": "蛋黄酱",
      "ratio": "30 克:30 克",
      "note": "口感更润滑。"
    }
  ],
  "variations": [
    "加一片芝士同煎，融化的奶香更浓。",
    "撒少许辣椒粉，味道层次会更丰富。"
  ],
  "serving_suggestion": "配一杯平白咖啡，是澳洲咖啡馆早餐柜台最常见的快手组合。",
  "storage": "现做现吃，冷藏一天内复热；复热用平底锅小火烙两分钟恢复口感。",
