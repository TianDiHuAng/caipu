  "equipment": [
    "烤盘",
    "碗",
    "勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热一百六十度，烤盘铺纸。，火别太大，锅气才足。",
      "time_min": 6,
      "heat": "无火",
      "tip": "温度别太高，燕麦易焦。，留意锅底，细节才到位。",
      "visual_cue": "烤箱灯亮，温度稳定，起锅前尝味，口感才有层次。"
    },
    {
      "n": 2,
      "text": "燕麦和花生放盆里，加肉桂粉和盐。，别用力搅，颜色才够亮。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先混干料，裹油才匀。，顺序照着来，整道菜才立得住。",
      "visual_cue": "干料混合，花生分布散，翻动放轻，味道才不闷。"
    },
    {
      "n": 3,
      "text": "倒植物油和蜂蜜，翻拌到每粒裹上。，顺序照着来，细节才到位。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌到发黏，烤后才结块。，料别一次下太多，香气才不跑。",
      "visual_cue": "燕麦发亮，粒粒裹匀，手法轻些，咸淡才好把握。"
    },
    {
      "n": 4,
      "text": "平铺在烤盘上，厚薄要一致。，料别一次下太多，口感才不发柴。",
      "time_min": 4,
      "heat": "无火",
      "tip": "铺薄些，受热才均匀。，顺序照着来，口感才有层次。",
      "visual_cue": "铺面平整，不重叠，别用力搅，形状才完整。"
    },
    {
      "n": 5,
      "text": "烤十分钟取出翻一次，再烤八分钟。，份量心里有数，细节才到位。",
      "time_min": 20,
      "heat": "无火",
      "tip": "中途翻动，颜色才一致。，保持小火，成品才稳当。",
      "visual_cue": "燕麦浅金，香气外溢，留意锅底，口感才不散。"
    },
    {
      "n": 6,
      "text": "取出摊开彻底放凉，才会脆。，份量心里有数，风味才干净。",
      "time_min": 15,
      "heat": "无火",
      "tip": "放凉再装，热气会返潮。，盖盖焖一会儿，味道才进得去。",
      "visual_cue": "颗粒干脆，手感轻，下手别慌，颜色才够亮。"
    },
    {
      "n": 7,
      "text": "苹果切小丁，拌进麦片里。，手法轻些，吃口才舒服。",
      "time_min": 6,
      "heat": "无火",
      "tip": "现切现拌，果香才清。，起锅前尝味，吃口才舒服。",
      "visual_cue": "果丁均匀，颜色白净，顺序照着来，成品才稳当。"
    },
    {
      "n": 8,
      "text": "盛碗倒牛奶，稍等两分钟再吃。，顺序照着来，表面才漂亮。",
      "time_min": 4,
      "heat": "无火",
      "tip": "泡一会儿，口感才软。，保持小火，成品才好看。",
      "visual_cue": "麦片下沉，牛奶微稠，保持小火，吃口才舒服。"
    }
  ],
  "tips": [
    "蜂蜜和油要拌匀，烤后才结块。，动作放连贯，风味才干净。",
    "中途翻动，颜色才均匀。，下手别慌，味道才进得去。",
    "放凉再密封，才不回潮。，锅温要匀，锅气才足。"
  ],
  "common_mistakes": [
    "温度太高，燕麦外层焦苦。，别急着加油，形状才完整。",
    "不翻动，底部烤成黑块。，锅温要匀，口感才不发柴。",
    "热着装罐，第二天就软了。，慢慢来别急，咸淡才好把握。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "红糖",
      "ratio": "80 克:90 克",
      "note": "需先用少量热水化开。"
    },
    {
      "original": "牛奶",
      "substitute": "酸奶",
      "ratio": "400 毫升:400 克",
      "note": "口感更浓稠，可少加蜂蜜。"
    }
  ],
  "variations": [
    "加葡萄干，甜味更足。，起锅前尝味，形状才完整。",
    "加椰蓉，香气更热带。，料别一次下太多，味道才不闷。"
  ],
  "serving_suggestion": "配牛奶或酸奶，加新鲜水果。，盖盖焖一会儿，成品才好看。",
  "storage": "密封常温两周。，留意锅底，形状才完整。",
