  "equipment": [
    "派模",
    "烤箱",
    "平底锅",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐与冷藏黄油丁搓成砂粒状，加水和成面团冷藏半小时。",
      "time_min": 30,
      "heat": "无火",
      "tip": "黄油保持低温，烤出的派皮才层层起酥。",
      "visual_cue": "面团光滑，按下去不粘手"
    },
    {
      "n": 2,
      "text": "牛肉切成一厘米见方的细丁，洋葱切末备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "牛肉切丁比绞碎有嚼劲，也更有肉感。",
      "visual_cue": "牛肉丁大小一致，切面平整"
    },
    {
      "n": 3,
      "text": "平底锅炒香洋葱末至透明，下牛肉丁炒到变色收紧。",
      "time_min": 8,
      "heat": "中火",
      "tip": "牛肉要炒到表面封住，锁住内部汁水。",
      "visual_cue": "牛肉丁表面褐亮，锅中无多余水"
    },
    {
      "n": 4,
      "text": "撒面粉炒匀，倒高汤、番茄酱与生抽，小火炖二十五分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "面粉先炒再倒汤，酱汁才不会结块。",
      "visual_cue": "酱汁浓稠，能挂住牛肉丁"
    },
    {
      "n": 5,
      "text": "加盐与黑胡椒调定味道，盛出放凉至不烫手。",
      "time_min": 10,
      "heat": "无火",
      "tip": "馅料太热会融化派皮黄油，必须放凉。",
      "visual_cue": "馅料浓稠抱团，凉透凝固"
    },
    {
      "n": 6,
      "text": "面团分两份，一份擀开铺进派模压实，边缘修齐。",
      "time_min": 10,
      "heat": "无火",
      "tip": "派皮要贴合模壁，中间别有空气。",
      "visual_cue": "派皮紧贴模壁，边缘整齐"
    },
    {
      "n": 7,
      "text": "填入放凉的牛肉丁，另一份面团擀开盖住，边缘捏紧压花。",
      "time_min": 12,
      "heat": "无火",
      "tip": "边缘捏紧后再压花，烤时才不会裂开。",
      "visual_cue": "边缘密实，表面平整"
    },
    {
      "n": 8,
      "text": "派面刷蛋液并戳几个小孔排气，二百度烤三十五分钟至金黄。",
      "time_min": 35,
      "heat": "无火",
      "tip": "戳孔排气能防止派皮鼓起破裂。",
      "visual_cue": "表面金黄，边缘起酥"
    }
  ],
  "tips": [
    "黄油全程保持低温，是派皮酥松的关键。",
    "馅料必须炖到浓稠放凉，切面才不会流汤。",
    "想更省事可用现成酥皮，风味差别不大。"
  ],
  "common_mistakes": [
    "馅料没收干就填，切开时汤汁漫出来泡软派皮。",
    "派皮擀得太薄，烤后撑不住馅料塌陷。",
    "没戳排气孔，表面鼓起一个大包破裂。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "600 克:600 克",
      "note": "加孜然三克去膻，风味更浓。"
    },
    {
      "original": "番茄酱",
      "substitute": "番茄膏",
      "ratio": "40 克:25 克",
      "note": "酸味更集中，需多加十毫升高汤稀释。"
    }
  ],
  "variations": [
    "表面加一层土豆泥，就是乡村派的变体。",
    "加一小勺咖喱粉，做成澳式咖喱肉派。"
  ],
  "serving_suggestion": "趁热切块，挤上番茄酱或配一勺豌豆泥。",
  "storage": "冷藏三天、冷冻两个月；复烤一百八十度十分钟恢复酥脆。",
