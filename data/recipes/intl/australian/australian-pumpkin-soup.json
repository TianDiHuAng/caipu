      "group": "main",
      "items": [
        {
          "name": "南瓜",
          "name_en": "pumpkin",
          "amount": 700,
          "unit": "g",
          "note": "去皮切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 120,
          "unit": "g",
          "note": "切丁",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 12,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 80,
          "unit": "ml",
          "note": "淋面",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 30,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 600,
          "unit": "ml",
          "note": "煮汤",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "搅拌机",
    "木勺",
    "削皮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜削皮后切成三厘米大小的块，去掉瓜瓤和籽。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块切小一点，煮的时候才一起软透。",
      "visual_cue": "南瓜块边缘整齐，橙黄饱满"
    },
    {
      "n": 2,
      "text": "洋葱切成小丁，大蒜拍碎后切成细末备用。过程中注意火候变化。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切得细一点，炒香时才不会焦。这一步别省。",
      "visual_cue": "洋葱丁均匀，蒜末细白"
    },
    {
      "n": 3,
      "text": "汤锅中火下橄榄油，先炒洋葱丁三分钟到透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "耐心炒到透明，甜味才出得来。顺序别颠倒。",
      "visual_cue": "洋葱变软透明，锅底微微上色"
    },
    {
      "n": 4,
      "text": "加入蒜末炒三十秒，闻到香味立刻下南瓜块。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "蒜末一香就下料，炒久了发苦。火候要盯住。",
      "visual_cue": "蒜香扑鼻，南瓜块裹上油光"
    },
    {
      "n": 5,
      "text": "翻炒两分钟，撒盐与一半黑胡椒让南瓜先入味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先撒盐，南瓜的甜味会被提出来。",
      "visual_cue": "南瓜块油润发亮，锅底无水"
    },
    {
      "n": 6,
      "text": "倒入清水没过南瓜，大火烧开后转小火煮二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "水刚没过就行，多了汤会稀。多练两次就熟。",
      "visual_cue": "汤汁微沸，南瓜用勺一压就散"
    },
    {
      "n": 7,
      "text": "用搅拌机把汤打成细腻的糊，可分两次打。动作要快别拖延。",
      "time_min": 5,
      "heat": "无火",
      "tip": "热汤打的时候留出气孔，别盖严。",
      "visual_cue": "汤糊顺滑无颗粒，颜色橙亮"
    },
    {
      "n": 8,
      "text": "打好的汤倒回锅里，小火加热并尝味补盐。随时观察锅里的状态。",
      "time_min": 5,
      "heat": "小火",
      "tip": "回锅别烧开太久，糊了会有生粉味。",
      "visual_cue": "汤面冒着细泡，稠度能挂勺"
    },
    {
      "n": 9,
      "text": "盛碗后淋一圈淡奶油，撒剩余黑胡椒即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶油绕圈淋，花纹才好看。细节决定成败。",
      "visual_cue": "奶油浮在汤面，纹路清晰"
    }
  ],
  "tips": [
    "南瓜切小块，二十分钟就能煮到一压就散。",
    "先炒洋葱到透明，汤的甜味底子才够。",
    "打糊前把汤晾一分钟，搅拌机才不喷。",
    "淡奶油最后淋，遇热久了会结花。"
  ],
  "common_mistakes": [
    "南瓜块切太大，煮不透打出来带颗粒。",
    "汤里水加太多，打完成了一锅稀水。",
    "蒜末炒到发黄，整锅汤带苦味。顺序别颠倒。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "80 毫升:80 毫升",
      "note": "热量更低，奶香稍薄。"
    },
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "700 克:700 克",
      "note": "甜度更高，水量可减一百毫升。"
    }
  ],
  "variations": [
    "加一小勺咖喱粉同炒，风味更有层次。",
    "表面撒烤南瓜籽，口感更丰富。这一步别省。"
  ],
  "serving_suggestion": "用厚壁碗盛出，表面淋淡奶油画圈，配一片烤面包就是澳洲冬天的常见晚餐。",
  "storage": "冷藏三天，冷冻可放一个月，复热时加少量清水搅匀。",
