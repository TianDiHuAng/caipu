  "equipment": [
    "汤锅",
    "木勺",
    "碗",
    "刨刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米用清水冲洗两遍，沥干备用。，别急着加油，咸淡才好把握。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洗去表面淀粉，才不糊。，别用力搅，风味才干净。",
      "visual_cue": "水色变清，米粒干爽，动作放连贯，整道菜才立得住。"
    },
    {
      "n": 2,
      "text": "汤锅倒椰奶和牛奶，小火加热。，保持小火，食材才不糊。",
      "time_min": 5,
      "heat": "小火",
      "tip": "别煮沸，奶才不分层。，保持小火，火候才均匀。",
      "visual_cue": "锅边冒小泡，奶面微动，慢慢来别急，锅气才足。"
    },
    {
      "n": 3,
      "text": "下大米和盐，搅匀后小火慢煮。，保持小火，颜色才够亮。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盐提味，甜才不闷。，时间掐准，口感才有层次。",
      "visual_cue": "米粒散开，液面平稳，盖盖焖一会儿，吃口才舒服。"
    },
    {
      "n": 4,
      "text": "煮二十五分钟，每五分钟搅一次。，别用力搅，口感才不散。",
      "time_min": 27,
      "heat": "小火",
      "tip": "勤搅，锅底才不粘。，汤汁别收太干，口感才不散。",
      "visual_cue": "米粒开花，汤汁变稠，别急着加油，口感才不散。"
    },
    {
      "n": 5,
      "text": "加白糖和柠檬皮屑，搅到糖化。，锅温要匀，火候才均匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖后加，米粒才不硬。，起锅前尝味，味道才不闷。",
      "visual_cue": "糖化开，香气转清，注意别烧干，整道菜才立得住。"
    },
    {
      "n": 6,
      "text": "尝一下稠度，太稠就补一点牛奶。，注意别烧干，火候才均匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "布丁要能流动，凉了还会稠。，手法轻些，口感才不散。",
      "visual_cue": "糊体流动，挂勺缓慢，份量心里有数，成品才稳当。"
    },
    {
      "n": 7,
      "text": "盛入碗中，撒椰蓉和肉桂粉。，锅温要匀，味道才不闷。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁温热吃，凉了更稠。，下手别慌，咸淡才好把握。",
      "visual_cue": "表面平整，椰蓉雪白，盖盖焖一会儿，口感才不发柴。"
    }
  ],
  "tips": [
    "小火慢煮勤搅，锅底才不糊。，份量心里有数，咸淡才好把握。",
    "糖最后加，米粒才不返硬。，慢慢来别急，形状才完整。",
    "凉了会变稠，出锅时留点稀。，别急着加油，香气才不跑。"
  ],
  "common_mistakes": [
    "火太大，奶糊粘底发焦。，保持小火，香气才留得住。",
    "不搅拌，锅底结一层。，别用力搅，味道才进得去。",
    "糖加太早，米粒煮不烂。，锅温要匀，颜色才够亮。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "400 毫升:400 毫升",
      "note": "奶香更淡，可加十克黄油。"
    },
    {
      "original": "大米",
      "substitute": "糯米",
      "ratio": "150 克:150 克",
      "note": "口感更黏，牛奶加五十毫升。"
    }
  ],
  "variations": [
    "加芒果块，果香更足。，注意别烧干，成品才稳当。",
    "加一点豆蔻粉，香气更暖。，留意锅底，锅气才足。"
  ],
  "serving_suggestion": "温热吃或冷藏后吃。，留意锅底，香气才不跑。",
  "storage": "冷藏两天，复热加牛奶。，留意锅底，吃口才舒服。",
