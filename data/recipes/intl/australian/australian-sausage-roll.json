  "steps": [
    {
      "n": 1,
      "text": "面粉加盐，黄油切小块搓进粉里。，下手别慌，风味才干净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，酥层才分明。，慢慢来别急，吃口才舒服。",
      "visual_cue": "颗粒粗砂，粉不结块，汤汁别收太干，锅气才足。"
    },
    {
      "n": 2,
      "text": "加清水揉成团，冷藏松弛二十分钟。，留意锅底，整道菜才立得住。",
      "time_min": 22,
      "heat": "无火",
      "tip": "松弛到位，擀开才不回缩。，盖盖焖一会儿，成品才稳当。",
      "visual_cue": "面团光滑，手感凉，料别一次下太多，细节才到位。"
    },
    {
      "n": 3,
      "text": "猪肉末加洋葱碎、面包糠、盐和黑胡椒，顺一个方向拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "顺一个方向搅，肉馅才紧。，锅温要匀，风味才干净。",
      "visual_cue": "馅体黏手，颜色均匀，起锅前尝味，颜色才够亮。"
    },
    {
      "n": 4,
      "text": "面团擀成三毫米厚的长方片。，别急着加油，细节才到位。",
      "time_min": 6,
      "heat": "无火",
      "tip": "擀薄些，层次才明显。，时间掐准，形状才完整。",
      "visual_cue": "厚薄一致，边缘整齐，动作放连贯，味道才不闷。"
    },
    {
      "n": 5,
      "text": "肉馅搓成长条，放在面片一侧。，保持小火，锅气才足。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馅别太多，卷时才不漏。，起锅前尝味，锅气才足。",
      "visual_cue": "条状均匀，粗细一致，顺序照着来，锅气才足。"
    },
    {
      "n": 6,
      "text": "卷起压实接口，切成四段。，动作放连贯，锅气才足。",
      "time_min": 5,
      "heat": "无火",
      "tip": "接口捏紧，烤时才不开口。，手法轻些，表面才漂亮。",
      "visual_cue": "卷形紧实，接口贴住，时间掐准，口感才不散。"
    },
    {
      "n": 7,
      "text": "表面刷蛋液，划两道浅口。，留意锅底，味道才进得去。",
      "time_min": 4,
      "heat": "无火",
      "tip": "划口透气，馅汁才不冲开。，别用力搅，口感才不发柴。",
      "visual_cue": "表面油亮，刀口浅，料别一次下太多，食材才不糊。"
    },
    {
      "n": 8,
      "text": "烤盘铺纸，两百度烤二十五分钟。，顺序照着来，口感才不散。",
      "time_min": 27,
      "heat": "无火",
      "tip": "烤到金黄，馅才熟透。，别急着加油，锅气才足。",
      "visual_cue": "表皮金黄，边缘起酥，时间掐准，香气才留得住。"
    },
    {
      "n": 9,
      "text": "稍凉两分钟再取，配番茄酱吃。，锅温要匀，口感才有层次。",
      "time_min": 4,
      "heat": "无火",
      "tip": "稍凉再动，酥皮才不碎。，慢慢来别急，口感才有层次。",
      "visual_cue": "外壳干爽，切面湿润，火别太大，香气才不跑。"
    }
  ],
  "tips": [
    "黄油要冷，酥皮层次才分明。，下手别慌，口感才不散。",
    "馅别包太满，卷时不易破口。，汤汁别收太干，火候才均匀。",
    "划口透气，表皮才不会鼓裂。，先试试温度，表面才漂亮。"
  ],
  "common_mistakes": [
    "黄油融化，酥皮层次糊在一起。，手法轻些，口感才不发柴。",
    "接口不压实，烤时咧嘴。，起锅前尝味，风味才干净。",
    "馅包太满，烤时爆开。，起锅前尝味，成品才稳当。"
  ],
