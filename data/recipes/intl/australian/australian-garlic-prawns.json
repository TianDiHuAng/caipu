          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取汁与皮屑",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 20,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 30,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "刀",
    "柠檬榨汁器",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁去壳留尾，用刀从背部划开，挑出黑色肠线。",
      "time_min": 8,
      "heat": "无火",
      "tip": "背上划一刀，受热均匀也不易卷成球。",
      "visual_cue": "背部划开，肠线清除干净"
    },
    {
      "n": 2,
      "text": "虾仁用厨房纸吸干水分，撒盐和黑胡椒抓匀腌五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "表面必须吸干，煎的时候才不上水。",
      "visual_cue": "虾仁干爽，调料裹匀"
    },
    {
      "n": 3,
      "text": "平底锅放橄榄油烧到微冒烟，虾仁平铺下锅煎一分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾仁别重叠，一次煎不完就分两批。",
      "visual_cue": "底面变红，边缘卷起"
    },
    {
      "n": 4,
      "text": "翻面再煎一分钟，虾仁一变粉红立刻盛出备用。",
      "time_min": 2,
      "heat": "中火",
      "tip": "虾仁熟得很快，煎久了肉就发柴。",
      "visual_cue": "两两面变红，身体挺立"
    },
    {
      "n": 5,
      "text": "锅里转小火放一半黄油，下大蒜末炒三十秒出香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "黄油非常容易烧焦，火一定要调到最小。",
      "visual_cue": "蒜末浅黄，黄油起泡"
    },
    {
      "n": 6,
      "text": "倒回虾仁，加剩余黄油和柠檬汁，快速翻匀三十秒。",
      "time_min": 2,
      "heat": "小火",
      "tip": "黄油最后加，奶香才不被高温破坏。",
      "visual_cue": "虾仁裹满蒜香黄油"
    },
    {
      "n": 7,
      "text": "关火撒上柠檬皮屑和香菜末，立刻装盘趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬皮屑只刮黄色部分，白色会发苦。",
      "visual_cue": "表面油亮，点缀绿末"
    }
  ],
  "tips": [
    "虾仁表面一定吸干水分，下锅才会焦香不出水。",
    "黄油分两次加，最后一次保留奶香不被高温破坏。",
    "全程快炒，虾仁变粉红就立刻停火。"
  ],
  "common_mistakes": [
    "虾仁没吸干水下锅，煎出一锅水变成水煮虾。",
    "火太大把蒜末炒焦，整锅带苦味。",
    "煎的时间过长，肉质紧缩发硬像橡皮。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "带壳大虾",
      "ratio": "600 克:800 克",
      "note": "带壳更香，需多煎一分钟。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "60 克:55 毫升",
      "note": "更清爽，奶香略弱。"
    }
  ],
  "variations": [
    "加一小勺辣椒碎，辛香气味更明显。",
    "出锅前淋一圈白葡萄酒，酸香更有层次。"
  ],
  "serving_suggestion": "连锅里的蒜香黄油一起浇在米饭或面包上，配一瓶白葡萄酒，是澳洲海边餐厅的常见吃法。",
  "storage": "冷藏一天，复热用平底锅中火三十秒，时间过长虾肉会变韧。",
