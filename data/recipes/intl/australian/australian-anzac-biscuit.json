  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "燕麦",
          "name_en": "oats",
          "amount": 150,
          "unit": "g",
          "note": "即食燕麦片",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 120,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 100,
          "unit": "g",
          "note": "融化后用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 90,
          "unit": "g",
          "note": "可用红糖替代",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 30,
          "unit": "g",
          "note": "代替金糖浆",
          "optional": false
        },
        {
          "name": "小苏打",
          "name_en": "baking soda",
          "amount": 3,
          "unit": "g",
          "note": "用热水化开",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "烤纸",
    "和面盆",
    "小汤锅",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到一百七十度，烤盘铺好烤纸备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "烤箱必须预热到位，饼干才均匀上色。",
      "visual_cue": "烤箱灯亮，内部升温"
    },
    {
      "n": 2,
      "text": "小汤锅小火融化黄油，加白糖与蜂蜜搅到完全化开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "别烧开，糖化了就离火。",
      "visual_cue": "液体顺滑，无沙粒感"
    },
    {
      "n": 3,
      "text": "小苏打用两勺热水化开，倒入糖油里搅匀起泡。",
      "time_min": 2,
      "heat": "无火",
      "tip": "小苏打遇热会起泡，这是饼干酥松的关键。",
      "visual_cue": "液面泛起细密泡沫"
    },
    {
      "n": 4,
      "text": "大盆里把燕麦与面粉拌匀，中间扒出一个坑。",
      "time_min": 2,
      "heat": "无火",
      "tip": "干料先混匀，湿料倒进来才好拌。",
      "visual_cue": "粉料均匀，没有干团"
    },
    {
      "n": 5,
      "text": "倒入糖油液，用勺子翻拌到没有干粉的状态。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌到能抱团就停，拌过头口感发硬。",
      "visual_cue": "面团湿润，能捏成团"
    },
    {
      "n": 6,
      "text": "取一小勺面团搓成圆球再按扁，间隔摆在烤盘上。",
      "time_min": 6,
      "heat": "无火",
      "tip": "留出两指宽的空隙，烤时会摊开。",
      "visual_cue": "饼坯圆整，厚薄一致"
    },
    {
      "n": 7,
      "text": "放入烤箱中层烤十五分钟，边缘金黄即可出炉。",
      "time_min": 15,
      "heat": "中火",
      "tip": "刚出炉是软的，凉了才会脆。",
      "visual_cue": "边缘焦黄，中心浅金"
    },
    {
      "n": 8,
      "text": "连烤纸一起移到晾架上，完全放凉后再密封保存。",
      "time_min": 10,
      "heat": "无火",
      "tip": "热的时候别动，一碰就散。",
      "visual_cue": "饼干变硬，能整片拿起"
    }
  ],
  "tips": [
    "黄油融化后不要烧开，冒泡就离火。",
    "面团偏湿可以补一勺燕麦，别加面粉。",
    "饼干放凉后马上密封，能保持酥脆三天。"
  ],
  "common_mistakes": [
    "黄油烧开再拌，饼干带一股焦味。",
    "饼坯按得太厚，烤出来中间还是软软的。",
    "刚出炉就取下来，饼干直接碎成好几片。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "红糖",
      "ratio": "30 克:35 克",
      "note": "颜色更深，焦香更明显。"
    },
    {
      "original": "燕麦",
      "substitute": "藜麦",
      "ratio": "150 克:130 克",
      "note": "需先烤香，口感更脆。"
    }
  ],
  "variations": [
    "面团里加一把椰蓉，烘出来香气更浓。",
    "用一半红糖替代白糖，颜色金黄偏深。"
  ],
  "serving_suggestion": "配一杯红茶或咖啡，下午茶最合适。",
  "storage": "密封常温保存五天，冷冻可放一个月。",
