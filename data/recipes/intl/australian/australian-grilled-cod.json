  ],
  "equipment": [
    "平底锅",
    "鱼铲",
    "砧板",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼块从冰箱取出回温十分钟，用厨房纸吸干表面水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表面越干，下锅越容易煎出焦壳。",
      "visual_cue": "鱼皮干爽，纸巾不粘"
    },
    {
      "n": 2,
      "text": "鱼块两面撒盐与黑胡椒，轻轻按压让调料贴住鱼身。",
      "time_min": 2,
      "heat": "无火",
      "tip": "提前撒盐五分钟，鱼肉更紧实。",
      "visual_cue": "表面均匀附着调料"
    },
    {
      "n": 3,
      "text": "平底锅烧热倒橄榄油，放蒜碎小火煸出香味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜一变金黄就下鱼，久炒会苦。",
      "visual_cue": "蒜末金黄，油面飘香"
    },
    {
      "n": 4,
      "text": "鱼块皮面朝下入锅，中火煎四分钟不要翻动。",
      "time_min": 4,
      "heat": "中火",
      "tip": "下锅后别动，焦壳才完整。",
      "visual_cue": "边缘变白，底部焦黄"
    },
    {
      "n": 5,
      "text": "用鱼铲小心翻面，加一半黄油继续煎三分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "黄油后放，不然高温容易烧焦。",
      "visual_cue": "两面金黄，鱼肉分层"
    },
    {
      "n": 6,
      "text": "挤入半个柠檬的汁，撒上香菜碎后立刻关火起锅。",
      "time_min": 1,
      "heat": "中火",
      "tip": "柠檬汁遇热会挥发，关火前挤最香。",
      "visual_cue": "汁水收干，香气上扬"
    },
    {
      "n": 7,
      "text": "盛盘摆上柠檬片，淋上锅里的黄油汁即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "锅底的黄油汁是精华，别浪费。",
      "visual_cue": "盘底有浅金色汤汁"
    }
  ],
  "tips": [
    "鱼块厚薄要一致，不然熟度参差。",
    "下锅前一定要吸干水分，否则溅油又粘锅。",
    "煎鱼全程中火，火大了外面焦里面还是生的。"
  ],
  "common_mistakes": [
    "鱼块带水下锅，油花四溅还粘底。",
    "不停翻动鱼块，鱼肉散成一块块碎渣。",
    "黄油一开始就下锅，加热过头变成焦褐色。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "龙利鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更嫩，煎制时间减少一分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "2 个:3 个",
      "note": "酸味更尖锐，用量减半。"
    }
  ],
  "variations": [
    "加一勺刺山柑同煎，酸香更开胃。",
    "撒一把烤杏仁碎，口感更有层次。"
  ],
  "serving_suggestion": "配烤土豆角和一份绿叶菜，淋上锅里的黄油汁。",
  "storage": "冷藏一天，复热用平底锅小火两面各煎一分钟。",
