  "steps": [
    {
      "n": 1,
      "text": "鲈鱼蒸十分钟，取出去刺拆成小块。，锅温要匀，形状才完整。",
      "time_min": 13,
      "heat": "中火",
      "tip": "拆仔细，鱼刺别留在肉里。，料别一次下太多，成品才稳当。",
      "visual_cue": "鱼肉松散，刺已去净，先试试温度，吃口才舒服。"
    },
    {
      "n": 2,
      "text": "土豆蒸十五分钟，趁热压成细泥。，份量心里有数，食材才不糊。",
      "time_min": 18,
      "heat": "中火",
      "tip": "趁热压泥，才细腻。，手法轻些，香气才不跑。",
      "visual_cue": "泥体顺滑，无块状，时间掐准，火候才均匀。"
    },
    {
      "n": 3,
      "text": "鱼肉、土豆泥和小葱末放大碗拌匀。，慢慢来别急，细节才到位。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到能捏成团，别过湿。，时间掐准，吃口才舒服。",
      "visual_cue": "混合物抱团，不散落，火别太大，整道菜才立得住。"
    },
    {
      "n": 4,
      "text": "加盐、黑胡椒和柠檬汁调味。，锅温要匀，香气才留得住。",
      "time_min": 3,
      "heat": "无火",
      "tip": "尝一下，鱼味淡要补盐。，先试试温度，味道才不闷。",
      "visual_cue": "咸淡适口，带柠檬香，别急着加油，味道才进得去。"
    },
    {
      "n": 5,
      "text": "搓成八个扁圆饼，冰箱冷藏十分钟定型。，盖盖焖一会儿，香气才留得住。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏一下，煎时不散。，份量心里有数，口感才不发柴。",
      "visual_cue": "饼形圆整，手感偏硬，盖盖焖一会儿，整道菜才立得住。"
    },
    {
      "n": 6,
      "text": "鱼饼先拍面粉，再蘸蛋液裹面包糠。，动作放连贯，表面才漂亮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "三层裹匀，外壳才脆。，锅温要匀，成品才稳当。",
      "visual_cue": "表面均匀，无裸露，翻动放轻，表面才漂亮。"
    },
    {
      "n": 7,
      "text": "平底锅倒植物油，中火烧到六成热。，注意别烧干，咸淡才好把握。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温别太高，外壳容易焦。，时间掐准，咸淡才好把握。",
      "visual_cue": "筷子入油起小泡，火别太大，成品才稳当。"
    },
    {
      "n": 8,
      "text": "鱼饼下锅，两面各煎三分钟到金黄。，盖盖焖一会儿，味道才不闷。",
      "time_min": 8,
      "heat": "中火",
      "tip": "翻面轻些，饼才不散。，翻动放轻，口感才有层次。",
      "visual_cue": "两面上色，边缘酥脆，锅温要匀，细节才到位。"
    },
    {
      "n": 9,
      "text": "捞出沥油，配柠檬角趁热吃，此时外壳最酥脆。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热吃，凉了外壳软。，留意锅底，香气才留得住。",
      "visual_cue": "外壳干爽，切面洁白，手法轻些，味道才不闷。"
    }
  ],
  "tips": [
    "鱼和土豆比例要匀，饼才不散。，份量心里有数，味道才进得去。",
    "冷藏定型，煎时不容易碎。，慢慢来别急，表面才漂亮。",
    "油温六成热最稳，外壳才酥。，慢慢来别急，成品才稳当。"
  ],
  "common_mistakes": [
    "混合物太湿，下锅就散。，别用力搅，咸淡才好把握。",
    "油温太低，鱼饼吸油。，动作放连贯，口感才不散。",
    "裹层不匀，煎时漏出鱼馅。，先试试温度，成品才好看。"
  ],
  "substitutions": [
