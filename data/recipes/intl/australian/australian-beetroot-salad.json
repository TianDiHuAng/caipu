  "equipment": [
    "烤盘",
    "锡纸",
    "刀",
    "砧板",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜菜根刷洗干净，不削皮，用锡纸包紧。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "带皮包烤，颜色和甜味都不流失。，注意火候。",
      "visual_cue": "包得严实，无破口，状态稳定"
    },
    {
      "n": 2,
      "text": "烤箱两百度烤三十分钟，筷子能轻松插透即可。",
      "time_min": 30,
      "heat": "-",
      "tip": "烤到叉子一插就进，才好切。，注意火候。",
      "visual_cue": "表皮起皱，捏着发软，状态稳定"
    },
    {
      "n": 3,
      "text": "取出稍晾，趁温热用厨房纸搓掉外皮。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "温的时候皮最好搓，凉了就难剥。，注意火候。",
      "visual_cue": "表皮脱落，露出红肉，状态稳定"
    },
    {
      "n": 4,
      "text": "甜菜根切成薄片或小瓣，装进大碗。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切薄一点，入口才不显土腥。，注意火候。",
      "visual_cue": "切片匀薄，颜色鲜红，状态稳定"
    },
    {
      "n": 5,
      "text": "核桃放干锅小火烘两分钟到出香，掰成小块。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "烘过的核桃香气完全不同。，注意火候。",
      "visual_cue": "香气升起，颜色微深，状态稳定"
    },
    {
      "n": 6,
      "text": "柠檬汁、橄榄油、蜂蜜、盐和黑胡椒调成汁。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蜂蜜先与柠檬汁化开，再加油。，注意火候。",
      "visual_cue": "汁液乳化，微稠发亮，状态稳定"
    },
    {
      "n": 7,
      "text": "甜菜根与调味汁拌匀，铺上芝麻菜、羊乳酪和核桃。",
      "time_min": 4,
      "heat": "无火",
      "tip": "奶酪掰大块，咬着才有存在感。，注意火候。",
      "visual_cue": "颜色红白绿，层次分明"
    }
  ],
  "tips": [
    "甜菜根带皮烤，甜味和颜色都不流失。，值得留意。",
    "趁温热搓皮，一下就能剥干净。，值得留意。",
    "核桃干锅烘香，脆感和香气都更好。，值得留意。"
  ],
  "common_mistakes": [
    "甜菜根切太厚，吃着带土腥味。，值得留意。",
    "烤完直接削皮，浪费一层红肉。，值得留意。",
    "调味汁一次倒太多，沙拉泡在汁里。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "羊乳酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "100 克:100 克",
      "note": "咸味稍淡，可略加盐。"
    },
    {
      "original": "核桃",
      "substitute": "南瓜子",
      "ratio": "50 克:50 克",
      "note": "烘香时间减半分钟。"
    }
  ],
  "variations": [
    "加几片橙子，果酸更清爽。，值得留意。",
    "撒少许孜然粉，风味更中东。，值得留意。"
  ],
  "serving_suggestion": "配烤肉或烤鱼当配盘，冷吃热吃都合适。，效果更稳定。",
  "storage": "冷藏两天，食用前再拌汁以免出水。，效果更稳定。",
