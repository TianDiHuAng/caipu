  ],
  "equipment": [
    "烤面包机",
    "汤锅",
    "小碗",
    "叉子",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包切成两厘米厚的片，放入烤面包机烤到两面金黄。",
      "time_min": 3,
      "heat": "中火",
      "tip": "厚切才撑得住牛油果，不会一压就软。",
      "visual_cue": "表面金黄，边缘酥脆"
    },
    {
      "n": 2,
      "text": "牛油果对半切开去核，用勺子挖出果肉放大碗里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "熟透的牛油果一挖就整块出来。",
      "visual_cue": "果肉柔软，颜色翠绿"
    },
    {
      "n": 3,
      "text": "用叉子把果肉压成粗泥，挤入柠檬汁、加盐拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "留一点颗粒感，口感比顺滑泥更好。",
      "visual_cue": "泥状带颗粒，颜色鲜绿"
    },
    {
      "n": 4,
      "text": "汤锅烧水，水微沸时加白醋，用勺搅出旋涡。",
      "time_min": 4,
      "heat": "小火",
      "tip": "水别滚，翻滚会把蛋冲散。",
      "visual_cue": "水面起旋，小泡不断"
    },
    {
      "n": 5,
      "text": "鸡蛋先打在小碗里，再顺着旋涡滑入水中煮三分钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "先打碗里再下锅，蛋形才完整。",
      "visual_cue": "蛋白包住蛋黄，呈椭圆"
    },
    {
      "n": 6,
      "text": "用漏勺捞出鸡蛋，放厨房纸上吸去表面水分。",
      "time_min": 1,
      "heat": "无火",
      "tip": "吸干水，面包片才不会被泡软。",
      "visual_cue": "蛋面干爽，边缘整齐"
    },
    {
      "n": 7,
      "text": "牛油果泥厚厚抹在面包片上，再放上水波蛋。",
      "time_min": 2,
      "heat": "无火",
      "tip": "抹厚一点，每一口都能吃到。",
      "visual_cue": "泥层均匀，蛋居中"
    },
    {
      "n": 8,
      "text": "撒盐、黑胡椒与小葱花，淋一圈橄榄油即可。",
      "time_min": 1,
      "heat": "无火",
      "tip": "最后撒盐，牛油果不会出水。",
      "visual_cue": "表面光亮，配色清爽"
    }
  ],
  "tips": [
    "牛油果要挑按下去微软的，硬的不香。",
    "水波蛋的水保持微沸，蛋白才包得紧。",
    "面包片烤好马上抹，热的时候更入味。"
  ],
  "common_mistakes": [
    "牛油果太生就压成泥，吃起来又涩又硬。",
    "水大开时把蛋下锅，蛋白瞬间散成蛋花。",
    "面包片烤好放着，凉了变硬咬不动。"
  ],
  "substitutions": [
    {
      "original": "面包",
      "substitute": "玉米饼",
      "ratio": "160 克:4 片",
      "note": "烙热后当底，口感更脆。"
    },
    {
      "original": "牛油果",
      "substitute": "奶油奶酪",
      "ratio": "200 克:150 克",
      "note": "质地更厚，酸味更明显。"
    }
  ],
  "variations": [
    "加几片烟熏三文鱼，咸鲜味更足更高级。",
    "撒一撮辣椒碎，微辣提味又开胃。"
  ],
  "serving_suggestion": "两片面包片配一杯黑咖啡，就是标准的澳洲早午餐。",
  "storage": "现做现吃，牛油果泥不宜久放，容易发黑。",
