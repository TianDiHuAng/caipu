  "equipment": [
    "竹签",
    "烤盘或烤架",
    "研钵",
    "刀",
    "砧板",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切两厘米见方的块，加生抽、蒜末、姜末、孜然粉和盐抓匀腌三十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "腌料里加一勺植物油，肉块烤时不易干柴。",
      "visual_cue": "肉块表面泛酱油色，手感黏滑"
    },
    {
      "n": 2,
      "text": "竹签提前泡水二十分钟，每根穿四五块鸡肉，肉块之间留一点空隙。",
      "time_min": 8,
      "heat": "无火",
      "tip": "竹签必泡水，否则上烤架就烧焦断掉。",
      "visual_cue": "串好的肉串长度一致，排列整齐"
    },
    {
      "n": 3,
      "text": "小锅小火炒香蒜末与葱白，倒入花生酱、椰浆、棕榈糖和白糖搅匀。",
      "time_min": 5,
      "heat": "小火",
      "tip": "花生酱要先化在温热椰浆里，直接下锅易结块。",
      "visual_cue": "酱汁顺滑流动，表面泛油光"
    },
    {
      "n": 4,
      "text": "酱汁里加生抽与青柠汁，小火煮三分钟至浓稠挂勺，尝味后调盐。",
      "time_min": 4,
      "heat": "小火",
      "tip": "沙嗲酱要比蘸酱略稀，烤后还会收紧。",
      "visual_cue": "酱汁浓稠能挂住勺背"
    },
    {
      "n": 5,
      "text": "肉串刷植物油，烤箱两百度烤十二分钟，中途翻面并刷一层沙嗲酱。",
      "time_min": 14,
      "heat": "大火",
      "tip": "中途刷酱要在最后五分钟进行，太早会烤焦。",
      "visual_cue": "肉块边缘焦褐，酱层油亮"
    },
    {
      "n": 6,
      "text": "肉串装盘，配黄瓜片与洋葱丝，撒香菜碎，蘸剩余沙嗲酱和辣椒酱食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠角现挤在肉串上，酸香能解腻。",
      "visual_cue": "肉串堆叠整齐，配菜分格摆放"
    }
  ],
  "tips": [
    "花生酱选无糖型，甜味靠棕榈糖控制才好调。",
    "炭火烤比烤箱更香，火力要中火避免外焦内生。",
    "沙嗲酱做多一点，拌饭吃也极好。"
  ],
  "common_mistakes": [
    "竹签不泡水就上烤架，中途烧断肉块全掉下去。",
    "酱汁一开始就熬太稠，烤完黏在肉上像糊了一层泥。",
    "鸡肉块切太大，外面焦了里面还是生的。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "虾仁",
      "ratio": "700 克:600 克",
      "note": "虾仁烤六分钟即可，勿过火。"
    },
    {
      "original": "花生酱",
      "substitute": "芝麻酱",
      "ratio": "120 克:110 克",
      "note": "需加十克糖补甜，酱体更稠可多加椰浆。"
    }
  ],
  "variations": [
    "把肉换成牛肉片或豆腐块，都能用同一款沙嗲酱。"
  ],
  "serving_suggestion": "配米饭或米糕、黄瓜片与洋葱丝，蘸辣椒酱。",
  "storage": "生肉串可冷冻一个月，酱汁冷藏三天；熟肉冷藏两天，复热用烤箱。",
