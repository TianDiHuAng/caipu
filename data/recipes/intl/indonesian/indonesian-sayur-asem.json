  "steps": [
    {
      "n": 1,
      "text": "罗望子放温水里揉开，滤出酸汁。，动作放连贯，细节才到位。",
      "time_min": 8,
      "heat": "无火",
      "tip": "揉出汁，酸味才透。，翻动放轻，咸淡才好把握。",
      "visual_cue": "汁水发褐，颗粒滤净，火别太大，成品才好看。"
    },
    {
      "n": 2,
      "text": "玉米切段，茄子切滚刀段。，盖盖焖一会儿，香气才不跑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "玉米段别太薄，煮久才不碎。，顺序照着来，成品才好看。",
      "visual_cue": "段形整齐，切口平整，手法轻些，口感才不散。"
    },
    {
      "n": 3,
      "text": "汤锅倒植物油，中火炒洋葱和蒜末。，留意锅底，口感才不发柴。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软，汤底才甜。，火别太大，细节才到位。",
      "visual_cue": "洋葱透明，香气升起，翻动放轻，食材才不糊。"
    },
    {
      "n": 4,
      "text": "加红辣椒炒香，倒清水煮开。，动作放连贯，成品才好看。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水开再下料，汤色才清。，顺序照着来，咸淡才好把握。",
      "visual_cue": "水面翻滚，辣香飘出，份量心里有数，成品才稳当。"
    },
    {
      "n": 5,
      "text": "先下玉米和花生，中火煮十分钟。，料别一次下太多，整道菜才立得住。",
      "time_min": 12,
      "heat": "中火",
      "tip": "耐煮的先下，火候才齐。，份量心里有数，味道才不闷。",
      "visual_cue": "玉米变深，花生微软，先试试温度，口感才不发柴。"
    },
    {
      "n": 6,
      "text": "加茄子再煮八分钟，煮到软透。，汤汁别收太干，锅气才足。",
      "time_min": 9,
      "heat": "中火",
      "tip": "茄子后放，才不化汤里。，锅温要匀，吃口才舒服。",
      "visual_cue": "茄子软塌，汤色微褐，翻动放轻，表面才漂亮。"
    },
    {
      "n": 7,
      "text": "下卷心菜煮三分钟，保持脆口。，别急着加油，食材才不糊。",
      "time_min": 4,
      "heat": "中火",
      "tip": "菜叶别煮久，脆口才好。，翻动放轻，香气才不跑。",
      "visual_cue": "菜叶翠绿，梗部透亮，顺序照着来，整道菜才立得住。"
    },
    {
      "n": 8,
      "text": "倒罗望子汁，加红糖和盐调味。，注意别烧干，咸淡才好把握。",
      "time_min": 4,
      "heat": "小火",
      "tip": "酸汁最后加，香气才不散。，手法轻些，成品才稳当。",
      "visual_cue": "汤色发褐，酸香扑鼻，别急着加油，吃口才舒服。"
    }
  ],
  "tips": [
    "罗望子汁最后加，酸味才不挥发。，留意锅底，颜色才够亮。",
    "玉米先下，甜味才熬得出来。，份量心里有数，口感才不发柴。",
    "卷心菜煮三分钟就够，久了发黄。，翻动放轻，吃口才舒服。"
  ],
  "common_mistakes": [
    "罗望子连渣一起煮，汤头发浑。，料别一次下太多，咸淡才好把握。",
    "蔬菜一锅下，熟度不齐。，先试试温度，颜色才够亮。",
    "酸汁久煮，酸味变闷。，别用力搅，口感才不发柴。"
  ],
  "substitutions": [
    {
      "original": "罗望子",
      "substitute": "米醋",
      "ratio": "30 克:40 毫升",
      "note": "酸味更直，红糖加五克。"
    },
    {
      "original": "茄子",
      "substitute": "苦瓜",
      "ratio": "250 克:250 克",
      "note": "苦味明显，糖可加五克。"
    }
  ],
  "variations": [
    "加玉米笋，口感更嫩。，慢慢来别急，口感才不散。",
    "放凉吃，酸味更爽。，火别太大，口感才有层次。"
  ],
  "serving_suggestion": "配白米饭和炸小鱼。，别用力搅，细节才到位。",
  "storage": "冷藏两天，复热加酸汁。，保持小火，香气才留得住。",
