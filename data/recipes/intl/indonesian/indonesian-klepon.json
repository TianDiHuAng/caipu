  "id": "indonesian-klepon",
  "name": {
    "zh": "印尼椰糖糯米球",
    "en": "Indonesian Klepon",
    "original": "Klepon"
  },
  "cuisine": {
    "region": "intl",
    "style": "indonesian"
  },
  "category": [
    "dessert"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 25,
    "cook_min": 15,
    "total_min": 40
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 250,
          "unit": "g",
          "note": "搓团",
          "optional": false
        },
        {
          "name": "椰糖",
          "name_en": "palm sugar",
          "amount": 100,
          "unit": "g",
          "note": "做内馅",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "椰蓉",
          "name_en": "desiccated coconut",
          "amount": 100,
          "unit": "g",
          "note": "裹面",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 160,
          "unit": "ml",
          "note": "和面",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "大碗",
    "漏勺",
    "蒸锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "椰糖用刀背敲碎再切成小粒，方便包进糯米团里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "椰糖块别太大，煮的时候才容易化开。",
      "visual_cue": "糖粒大小均匀，切口平整"
    },
    {
      "n": 2,
      "text": "糯米粉倒进大碗，分次加清水揉成不粘手的面团。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水要一点点加，面团太湿就补糯米粉。",
      "visual_cue": "面团光滑，按压不留裂口"
    },
    {
      "n": 3,
      "text": "揪一小块面团按成小窝，放一颗椰糖粒再收口搓圆。",
      "time_min": 8,
      "heat": "无火",
      "tip": "收口一定捏紧，煮的时候糖才不会漏。",
      "visual_cue": "小球表面光滑无裂缝"
    },
    {
      "n": 4,
      "text": "汤锅烧开一锅清水，把糯米球逐个下锅轻推。",
      "time_min": 3,
      "heat": "大火",
      "tip": "下锅后轻推锅底，防粘也防变形。",
      "visual_cue": "糯米球沉在锅底打转"
    },
    {
      "n": 5,
      "text": "煮到糯米球全部浮起再煮两分钟，用漏勺捞出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "浮起说明定型，再多煮两分钟内心才熟。",
      "visual_cue": "小球浮起，个头胀大"
    },
    {
      "n": 6,
      "text": "椰蓉加盐拌匀蒸三分钟，趁热把糯米球滚上椰蓉。",
      "time_min": 5,
      "heat": "中火",
      "tip": "椰蓉蒸过更湿润，裹得均匀也不干喉。",
      "visual_cue": "表面挂满白色椰蓉"
    }
  ],
  "tips": [
    "椰糖敲成小粒，包的时候才不会顶破面皮。",
    "收口要捏紧，否则煮的时候糖全漏进锅里。",
    "椰蓉先蒸三分钟，裹得更服帖也不干喉。"
  ],
  "common_mistakes": [
    "面团加水太多，搓球时粘手搓不成形。",
    "收口没捏紧，煮出来变成一锅甜汤。",
    "椰蓉不蒸直接干裹，吃起来满口都是粉末。"
  ],
  "substitutions": [
    {
      "original": "椰糖",
      "substitute": "红糖",
      "ratio": "100 克:100 克",
      "note": "颜色相近，少了椰香。"
    },
    {
      "original": "椰蓉",
      "substitute": "熟黄豆粉",
      "ratio": "100 克:100 克",
      "note": "更干爽，豆香突出。"
    }
  ],
  "variations": [
    "和面时加两滴斑斓汁，颜色和香气更东南亚。",
    "内馅换成黑芝麻糖，香味更浓口感更香。"
  ],
  "serving_suggestion": "趁温热吃口感最好，配一杯无糖茶解甜。",
  "storage": "冷藏两天，复热时蒸三分钟回软。",
  "nutrition_estimate": {
    "basis": "每份约 130 克",
