  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切大块，用盐和黑胡椒抓匀。，起锅前尝味，口感才不发柴。",
      "time_min": 8,
      "heat": "无火",
      "tip": "抓匀腌十分钟，肉才入味。，料别一次下太多，表面才漂亮。",
      "visual_cue": "表面干爽，盐粒化开，料别一次下太多，味道才进得去。"
    },
    {
      "n": 2,
      "text": "炖锅倒植物油，中火炒洋葱丝。，汤汁别收太干，细节才到位。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才出来。，汤汁别收太干，味道才不闷。",
      "visual_cue": "洋葱软塌，颜色微黄，汤汁别收太干，形状才完整。"
    },
    {
      "n": 3,
      "text": "下蒜末、姜片和香茅，炒出香味。，顺序照着来，成品才稳当。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香茅拍扁，香气才出。，汤汁别收太干，口感才不发柴。",
      "visual_cue": "香气浓，油色微亮，份量心里有数，食材才不糊。"
    },
    {
      "n": 4,
      "text": "鸡块下锅，煎到表面变白。，慢慢来别急，风味才干净。",
      "time_min": 7,
      "heat": "中火",
      "tip": "表面煎定型，肉汁才锁住。，手法轻些，细节才到位。",
      "visual_cue": "表面发白，边缘微黄，时间掐准，风味才干净。"
    },
    {
      "n": 5,
      "text": "倒清水，大火煮开后转小火。，动作放连贯，锅气才足。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水量到肉一半，别太多。，注意别烧干，口感才有层次。",
      "visual_cue": "水面翻滚，浮沫浮起，别急着加油，口感才有层次。"
    },
    {
      "n": 6,
      "text": "盖盖小火炖二十分钟，肉变软。，顺序照着来，风味才干净。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火慢炖，肉才不柴。，顺序照着来，表面才漂亮。",
      "visual_cue": "肉块松软，筷子能穿，保持小火，香气才不跑。"
    },
    {
      "n": 7,
      "text": "倒椰奶，小火加热不要煮沸。，先试试温度，风味才干净。",
      "time_min": 6,
      "heat": "小火",
      "tip": "椰奶后加，才不分层。，汤汁别收太干，成品才好看。",
      "visual_cue": "奶色乳白，汤汁微稠，时间掐准，口感才有层次。"
    },
    {
      "n": 8,
      "text": "加白糖调味，撒小葱末盛出。，注意别烧干，吃口才舒服。",
      "time_min": 4,
      "heat": "小火",
      "tip": "尝一下再补盐，别偏咸。，料别一次下太多，风味才干净。",
      "visual_cue": "汤汁浓稠，葱末翠绿，注意别烧干，成品才好看。"
    }
  ],
  "tips": [
    "鸡块先煎定型，肉汁才不流失。，起锅前尝味，咸淡才好把握。",
    "椰奶后加且别煮沸，才不分层。，先试试温度，细节才到位。",
    "小火慢炖，鸡肉才软嫩。，手法轻些，成品才好看。"
  ],
  "common_mistakes": [
    "大火炖煮，鸡肉发柴。，注意别烧干，锅气才足。",
    "椰奶煮开，油水分离。，盖盖焖一会儿，表面才漂亮。",
    "香茅不拍扁，香味出不来。，注意别烧干，食材才不糊。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "900 克:800 克",
      "note": "肉更瘦，炖制时间减五分钟。"
    },
    {
      "original": "椰奶",
      "substitute": "淡奶油",
      "ratio": "500 毫升:400 毫升",
      "note": "奶香更浓，需加水一百毫升。"
    }
  ],
  "variations": [
    "加土豆块，汤更绵。，份量心里有数，细节才到位。",
    "加一点咖喱粉，香气更足。，料别一次下太多，形状才完整。"
  ],
  "serving_suggestion": "配白米饭或米糕。，料别一次下太多，吃口才舒服。",
  "storage": "冷藏两天，复热用小火。，下手别慌，锅气才足。",
