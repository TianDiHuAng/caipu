  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切厚片，冷水下锅焯五分钟去血沫，捞出用温水冲净。",
      "time_min": 12,
      "heat": "大火",
      "tip": "焯水后要用温水冲，冷水一激肉会发紧。",
      "visual_cue": "牛肉表面干净，无灰色浮沫"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，下洋葱丝、蒜碎与南姜炒到洋葱透明。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒出甜味，汤底才厚实不寡淡。",
      "visual_cue": "洋葱软塌透明，香味明显"
    },
    {
      "n": 3,
      "text": "下牛肉片翻炒上色，加清水、柠檬叶与香茅大火烧开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水一次加足，中途加水汤味会变淡。",
      "visual_cue": "汤面翻滚，牛肉变色收紧"
    },
    {
      "n": 4,
      "text": "转小火煮五十分钟至牛肉软，加土豆块与番茄再煮十五分钟。",
      "time_min": 62,
      "heat": "小火",
      "tip": "土豆后放，早了会煮化在汤里。",
      "visual_cue": "牛肉软而有形，土豆边缘微融"
    },
    {
      "n": 5,
      "text": "倒椰奶加盐与黑胡椒，小火加热五分钟至汤微沸，撒葱花即可。",
      "time_min": 8,
      "heat": "小火",
      "tip": "椰奶下锅后别大火滚，否则油水分离。",
      "visual_cue": "汤色奶白微黄，表面浮少许油花"
    }
  ],
  "tips": [
    "椰奶要最后再加，这样香气保留得最好。",
    "牛肉用带一点筋的部位，汤更浓。",
    "汤必须小火慢煮，用急火牛肉不会软。",
    "配白饭、炸红葱片与辣椒酱一起吃。"
  ],
  "common_mistakes": [
    "焯水用冷水冲，牛肉瞬间收紧，怎么煮都硬。",
    "椰奶大火滚煮，汤变成豆腐渣状。",
    "盐放得太早，牛肉失水后越煮越柴。",
    "番茄煮得太久，汤发酸盖住了椰香。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡腿肉",
      "ratio": "600克:600克",
      "note": "煮的时间减到三十分钟。"
    },
    {
      "original": "土豆",
      "substitute": "芋头",
      "ratio": "200克:200克",
      "note": "更粉糯，汤更稠。"
    }
  ],
  "variations": [
    "加一把米粉同煮，就成了汤粉版本。",
    "加两片酸菜同煮，酸香更开胃解腻。",
    "配一块炸豆腐同煮，口感更丰富。"
  ],
  "serving_suggestion": "盛进深碗，撒葱花与炸红葱片，旁边放一碟甜辣酱和白饭，是雅加达街头最常见的早餐汤。",
  "storage": "冷藏可放两天，椰奶汤不宜久放；复热用小火慢加热不要滚沸。",
