    "勺子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "椰奶加白糖、拍扁的香茅和盐，小火加热到微沸。",
      "time_min": 6,
      "heat": "小火",
      "tip": "加点盐，椰奶的甜味才立得住。，注意火候。",
      "visual_cue": "液面微沸，香气清甜，状态稳定"
    },
    {
      "n": 2,
      "text": "关火滤去香茅，放凉后冷藏二十分钟。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冷藏过的椰汁才够冰爽。，注意火候。",
      "visual_cue": "液体凉透，香气融合，状态稳定"
    },
    {
      "n": 3,
      "text": "牛油果对半切开去核，果肉切成小方丁。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切丁别太小，冰里才吃得到口感。，注意火候。",
      "visual_cue": "果丁整齐，颜色新鲜，状态稳定"
    },
    {
      "n": 4,
      "text": "菠萝去皮切成同样大小的方丁，沥去汁水。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "沥干汁水，冰镇后不会太稀。，注意火候。",
      "visual_cue": "果丁干爽，大小一致，状态稳定"
    },
    {
      "n": 5,
      "text": "香蕉去皮斜切薄片，避免切太厚。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香蕉容易发黑，切好马上用。，注意火候。",
      "visual_cue": "片形整齐，颜色乳白，状态稳定"
    },
    {
      "n": 6,
      "text": "碗里先铺牛油果丁和菠萝丁，再摆香蕉片。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "重的水果垫底，层次才好看。，注意火候。",
      "visual_cue": "层次清楚，果料铺满，状态稳定"
    },
    {
      "n": 7,
      "text": "淋上冰镇椰汁，再挤一圈炼乳。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "炼乳淋成圈，比直接倒更好看。，注意火候。",
      "visual_cue": "奶纹螺旋，液面平稳，状态稳定"
    },
    {
      "n": 8,
      "text": "放冰箱再冰十分钟，取出拌匀后食用。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "最后冰一下，口感才够透心凉。，注意火候。",
      "visual_cue": "温度冰凉，果香清新，状态稳定"
    }
  ],
  "tips": [
    "椰汁里放一点盐，甜味才立体。，值得留意。",
    "牛油果和香蕉切好马上用，容易发黑。，值得留意。",
    "椰汁提前冰镇，成品才够爽。，值得留意。"
  ],
  "common_mistakes": [
    "椰汁加热过大滚，容易油水分离。，值得留意。",
    "水果切太早，氧化后发黑。，值得留意。",
    "炼乳一次倒太多，甜得压住果味。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "牛油果",
      "substitute": "芒果",
      "ratio": "200 克:200 克",
      "note": "酸味更明显，糖可略减。"
    },
    {
      "original": "炼乳",
      "substitute": "蜂蜜",
      "ratio": "60 克:50 克",
      "note": "甜度略低，风味更清。"
    }
  ],
  "variations": [
    "加一勺椰果或西米，口感更丰富。，值得留意。",
    "放几块冰块一起打碎，做成沙冰。，值得留意。"
  ],
  "serving_suggestion": "冰镇后当下午茶甜品，配一块炸香蕉更满足。",
  "storage": "冷藏一天，水果部分建议现拌现吃。，效果更稳定。",
