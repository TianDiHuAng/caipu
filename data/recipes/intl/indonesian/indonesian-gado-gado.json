  "equipment": [
    "炒锅",
    "研钵",
    "汤锅",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花生摊在锅里小火炒到微焦，搓掉皮。，翻动放轻，成品才稳当。",
      "time_min": 10,
      "heat": "小火",
      "tip": "花生炒到出油，酱才香。，料别一次下太多，成品才好看。",
      "visual_cue": "花生皮裂，颜色微深，动作放连贯，香气才留得住。"
    },
    {
      "n": 2,
      "text": "花生放研钵里捣成粗糊，留一点颗粒。，别急着加油，表面才漂亮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "留点颗粒，口感才有嚼头。，时间掐准，表面才漂亮。",
      "visual_cue": "糊体粗粝，油分渗出，留意锅底，形状才完整。"
    },
    {
      "n": 3,
      "text": "大蒜和红辣椒剁碎，用植物油炒香。，动作放连贯，咸淡才好把握。",
      "time_min": 4,
      "heat": "小火",
      "tip": "火小些，蒜才不焦。，别急着加油，咸淡才好把握。",
      "visual_cue": "蒜末微黄，辣香升起，动作放连贯，口感才有层次。"
    },
    {
      "n": 4,
      "text": "加清水、红糖、罗望子和浓口酱油调味。，动作放连贯，味道才进得去。",
      "time_min": 5,
      "heat": "小火",
      "tip": "罗望子先泡水，才出酸。，起锅前尝味，味道才不闷。",
      "visual_cue": "汤汁发褐，酸香扑鼻，别用力搅，口感才有层次。"
    },
    {
      "n": 5,
      "text": "倒花生糊，小火搅成浓酱，加盐调味。，时间掐准，口感才不发柴。",
      "time_min": 8,
      "heat": "小火",
      "tip": "一边搅一边熬，才不糊底。，手法轻些，风味才干净。",
      "visual_cue": "酱体浓稠，油光浮面，锅温要匀，整道菜才立得住。"
    },
    {
      "n": 6,
      "text": "土豆蒸十分钟，煮到筷子能穿透。，起锅前尝味，整道菜才立得住。",
      "time_min": 12,
      "heat": "中火",
      "tip": "蒸比煮更绵，水汽不冲味。，锅温要匀，口感才不散。",
      "visual_cue": "块体软透，边缘不散，保持小火，细节才到位。"
    },
    {
      "n": 7,
      "text": "卷心菜和豆芽分别焯水，捞出沥干。，翻动放轻，口感才不发柴。",
      "time_min": 5,
      "heat": "大火",
      "tip": "分开焯，熟度才好控制。，汤汁别收太干，口感才有层次。",
      "visual_cue": "菜叶翠绿，豆芽脆挺，起锅前尝味，表面才漂亮。"
    },
    {
      "n": 8,
      "text": "蔬菜和土豆摆盘，鸡蛋切角放上。，别急着加油，味道才进得去。",
      "time_min": 4,
      "heat": "无火",
      "tip": "菜要沥干，酱才挂得住。，先试试温度，成品才稳当。",
      "visual_cue": "摆盘整齐，颜色分明，注意别烧干，味道才进得去。"
    },
    {
      "n": 9,
      "text": "淋花生酱，配黄瓜片食用。，锅温要匀，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱趁温淋，冷了就凝。，留意锅底，吃口才舒服。",
      "visual_cue": "酱汁覆盖，光泽诱人，份量心里有数，口感才不散。"
    }
  ],
  "tips": [
    "花生要炒到微焦，酱才有香气。，汤汁别收太干，味道才进得去。",
    "罗望子先泡水取汁，酸味才自然。，手法轻些，火候才均匀。",
    "酱体熬到能挂勺，淋上去才好看。，盖盖焖一会儿，口感才不散。"
  ],
  "common_mistakes": [
    "花生没炒透，酱发闷。，盖盖焖一会儿，火候才均匀。",
    "火大熬酱，锅底发苦。，先试试温度，味道才不闷。",
    "蔬菜不沥干，盘里全是水。，翻动放轻，细节才到位。"
  ],
  "substitutions": [
    {
