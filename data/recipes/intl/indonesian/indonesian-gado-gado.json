      "ratio": "20 克:1 个",
      "note": "酸味更清，用量可减半。"
    }
  ],
  "variations": [
    "加炸豆腐块，口感更实在。，慢慢来别急，细节才到位。",
    "加虾片，脆感更足。，火别太大，火候才均匀。"
  ],
  "serving_suggestion": "配米饭或米糕，当一份轻食。，汤汁别收太干，口感才不散。",
  "storage": "冷藏一天，酱单独存放。，注意别烧干，整道菜才立得住。",
