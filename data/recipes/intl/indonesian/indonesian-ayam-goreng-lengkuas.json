  "steps": [
    {
      "n": 1,
      "text": "南姜去皮磨成细蓉，大蒜与红葱头切碎，鸡腿肉用盐抹匀。",
      "time_min": 14,
      "heat": "无火",
      "tip": "南姜纤维粗，磨成蓉才出香，切丝嚼着扎嘴。",
      "visual_cue": "南姜蓉湿润带香，鸡块表面有盐粒"
    },
    {
      "n": 2,
      "text": "锅中放鸡块、南姜蓉、蒜碎、红葱头、柠檬叶、香茅、姜黄与清水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水要没过鸡块大半，煮的过程才不会烧干。",
      "visual_cue": "锅中有香料的清汤，鸡块浸在其中"
    },
    {
      "n": 3,
      "text": "大火烧开后转小火煮三十分钟，至鸡肉熟透、汤几乎收干。",
      "time_min": 32,
      "heat": "小火",
      "tip": "煮到汤基本收干，香料蓉会裹在鸡皮上。",
      "visual_cue": "汤汁收干，香料蓉糊满鸡块"
    },
    {
      "n": 4,
      "text": "把鸡块捞出稍晾，表面附着的香料蓉尽量留住。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香料蓉是这道菜的灵魂，别冲洗掉。",
      "visual_cue": "鸡块表面覆一层黄褐色香料蓉"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧到一百七十度，下鸡块炸四分钟至外皮金黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "带着香料蓉炸容易焦，油温不要过高。",
      "visual_cue": "外皮金褐酥脆，香料蓉炸成细絮"
    }
  ],
  "tips": [
    "南姜用量不能省，它是这道菜的标志香气。",
    "先煮后炸，肉能熟透，外皮又是脆的。",
    "炸完的香料蓉可以捞出来撒在饭上。",
    "配一碟辣酱与黄瓜片，解油又清爽。"
  ],
  "common_mistakes": [
    "南姜切片直接煮，吃的时候纤维扎嘴。",
    "煮的时间不够，炸完里面还带血色。",
    "油温太高，香料蓉一下锅就先焦黑发苦。",
    "炸好之后闷在锅里，外皮很快就回软了。"
  ],
  "substitutions": [
    {
      "original": "南姜",
      "substitute": "姜",
      "ratio": "120克:100克",
      "note": "香气弱一些，可加一片柠檬叶补。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "900克:900克",
      "note": "煮的时间减十分钟。"
    }
  ],
  "variations": [
    "炸好后用刀背拍松，就是印尼的ayam penyet。",
    "加一勺辣椒酱同煮，辣味渗进肉里。",
    "用空气炸锅二百度烤十分钟，油少一些。"
  ],
  "serving_suggestion": "整块摆在盘里，撒炸香的香料蓉，配白饭、黄瓜片与辣酱，是最经典的印尼炸鸡吃法。",
  "storage": "冷藏可放两天，复热用二百度烤箱烤六分钟可恢复脆度。",
