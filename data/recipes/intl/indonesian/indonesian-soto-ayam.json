  "equipment": [
    "汤锅",
    "炒锅",
    "漏勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉洗净放入汤锅，加一千二百毫升清水大火煮开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "冷水下锅，血沫才会慢慢浮出。",
      "visual_cue": "水面浮起灰白浮沫"
    },
    {
      "n": 2,
      "text": "撇掉浮沫后转小火，加姜片煮二十五分钟至肉熟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "小火保持微滚，汤才清不浑。",
      "visual_cue": "鸡肉能用筷子轻松扎透"
    },
    {
      "n": 3,
      "text": "捞出鸡腿放凉，撕成粗丝，鸡汤过滤后留用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "撕比切更容易挂住汤汁。",
      "visual_cue": "鸡丝粗细均匀，汤色清亮"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，中火炒洋葱丝、蒜末与姜黄一分钟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "姜黄容易焦，火别大。",
      "visual_cue": "洋葱变软，油色转金黄"
    },
    {
      "n": 5,
      "text": "把炒好的香料连同南姜、香茅一起倒回鸡汤锅里。",
      "time_min": 2,
      "heat": "中火",
      "tip": "香料装纱袋更好捞，省得喝汤费劲。",
      "visual_cue": "汤面浮一层金色油花"
    },
    {
      "n": 6,
      "text": "中火煮十分钟让香料味融进汤里，再补盐调味即可。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煮到香气冲鼻就够了，久煮会发苦。",
      "visual_cue": "汤色金黄，香气浓郁"
    },
    {
      "n": 7,
      "text": "倒入椰奶搅匀，小火加热到微微冒泡即可关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椰奶别大火滚，会油水分离。",
      "visual_cue": "汤色乳黄，表面细滑"
    },
    {
      "n": 8,
      "text": "米粉用热水泡软，豆芽焯十秒，鸡蛋煮熟切半。",
      "time_min": 5,
      "heat": "中火",
      "tip": "豆芽只烫十秒，脆感才留住。",
      "visual_cue": "米粉变软可绕指，豆芽翠白"
    },
    {
      "n": 9,
      "text": "碗里放米粉、豆芽与鸡丝，浇上滚烫的金汤。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汤要够烫，浇下去才把香气逼出来。",
      "visual_cue": "碗里层次分明，汤面冒热气"
    },
    {
      "n": 10,
      "text": "摆上半个鸡蛋，撒香菜，挤青柠汁后趁热食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁最后挤，酸香最鲜活。",
      "visual_cue": "汤色金黄，配菜齐全"
    }
  ],
  "tips": [
    "鸡腿冷水下锅，撇净浮沫汤才清亮。",
    "椰奶最后小火加热，滚沸会分离出水。",
    "香料煮十分钟足够，久煮会带苦味。"
  ],
  "common_mistakes": [
    "鸡肉大火猛煮，撕出来又干又柴。",
    "椰奶大火煮开，表面浮起一层油花。",
    "香料煮太久，汤里带一股药苦味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600 克:550 克",
      "note": "煮制时间减到十八分钟。"
    },
    {
      "original": "米粉",
      "substitute": "挂面",
      "ratio": "150 克:150 克",
      "note": "煮三分钟即可，别泡太久。"
    }
  ],
  "variations": [
    "喜欢辣的加一勺辣椒酱，汤更冲。",
    "用鸡汤配米饭，就是印尼常见的汤饭。"
  ],
  "serving_suggestion": "单碗汤粉配米饭，旁边放辣酱和青柠角。",
  "storage": "汤与粉分开冷藏两天，复热汤再浇粉。",
