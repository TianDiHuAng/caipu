  "steps": [
    {
      "n": 1,
      "text": "北豆腐切两厘米见方的块，用厨房纸吸干表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面的水一定吸干，下油锅时不溅也不粘。",
      "visual_cue": "豆腐块表面干爽，边角完整"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油中火，豆腐块摊开慢煎到四面金黄定型后盛出。",
      "time_min": 8,
      "heat": "中火",
      "tip": "一面煎定型再翻面，来回拨动会把豆腐弄碎。",
      "visual_cue": "四面金黄起壳，晃锅能滑动"
    },
    {
      "n": 3,
      "text": "留底油下红葱头与大蒜小火炒香，再放小米辣炒出辣气。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小米辣最后放，炒久了辣味发闷而且呛人。",
      "visual_cue": "葱片透亮，辣气冲鼻但未发黑"
    },
    {
      "n": 4,
      "text": "下番茄块炒到出汁软塌，加椰糖、盐与生抽炒成浓稠酱底。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒出汁是酱底的关键，干炒会发酸不浓。",
      "visual_cue": "番茄化开成酱，锅中有红亮汁水"
    },
    {
      "n": 5,
      "text": "倒回豆腐与青豆翻匀，小火焖三分钟让酱汁挂上豆腐。",
      "time_min": 3,
      "heat": "小火",
      "tip": "轻推别翻锅，豆腐才不会碎，酱汁也挂得匀。",
      "visual_cue": "豆腐裹满红酱，青豆翠绿不黄"
    }
  ],
  "tips": [
    "豆腐选质地紧实的北豆腐，煎完才有外壳。",
    "喜欢更辣就多留一点辣椒籽，辣味会明显上升。",
    "剩下的酱底拌白饭或炒面都好吃，别浪费。",
    "青豆换成豆角要先焯三分钟，否则不易熟。"
  ],
  "common_mistakes": [
    "豆腐没吸干水就下锅，油溅得满灶台还粘锅。",
    "不停翻动豆腐，煎完碎成一锅渣。",
    "辣椒一开始就下锅炒，辣味发苦还呛得咳嗽。",
    "番茄没炒出汁就放豆腐，酱汁稀薄挂不上。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "鸡蛋豆腐",
      "ratio": "400克:400克",
      "note": "更嫩滑，煎的时候要更轻手。"
    },
    {
      "original": "青豆",
      "substitute": "四季豆",
      "ratio": "80克:120克",
      "note": "须先焯水三分钟确保熟透。"
    }
  ],
  "variations": [
    "加一把炸花生米同炒，口感更有嚼头。",
    "换成虾米同炒，鲜味更浓，是沿海一带的吃法。",
    "把豆腐换成煎蛋块，就是另一道经典辣酱蛋的做法。"
  ],
  "serving_suggestion": "装盘后连红油一起浇上，配白饭能吃两碗，辣得恰到好处。",
  "storage": "冷藏可放两天，复热用平底锅小火加两勺水焖三分钟，豆腐才不回硬。",
