  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "料理机",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅，水开后煮八分钟捞出泡冷水，剥壳后擦干表面。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煮八分钟蛋黄刚好凝固不噎，泡冷水更容易剥。",
      "visual_cue": "蛋壳一剥就掉，蛋白完整光滑"
    },
    {
      "n": 2,
      "text": "小米辣、红葱头与大蒜放进料理机打成粗糊，番茄单独切块备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酱糊打得粗一点，炒出来才有口感不发糊。",
      "visual_cue": "酱糊橙红带颗粒，辣气冲鼻"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，鸡蛋下锅滚炸到表面起皱呈金黄色后捞出。",
      "time_min": 10,
      "heat": "中火",
      "tip": "炸的时候用漏勺轻轻推动，让蛋壳均匀起皱。",
      "visual_cue": "蛋白表面布满金黄细皱，形如虎皮"
    },
    {
      "n": 4,
      "text": "留底油下酱糊小火炒香，加番茄、生抽、椰糖与盐炒成浓稠红酱。",
      "time_min": 4,
      "heat": "小火",
      "tip": "酱要炒到出红油才香，火大就焦苦，耐心小火。",
      "visual_cue": "酱色深红发亮，锅边渗出红油"
    },
    {
      "n": 5,
      "text": "把鸡蛋放进酱里小火焖两分钟，中途翻面让两面都裹上酱汁。",
      "time_min": 2,
      "heat": "小火",
      "tip": "焖的时候用勺把酱汁往蛋上浇，颜色才均匀。",
      "visual_cue": "蛋身裹满红酱，切口处也是红色"
    }
  ],
  "tips": [
    "鸡蛋煮好擦干再炸，带水入油锅会剧烈溅油。",
    "怕油多可以改成少油煎，风味略减但更清爽。",
    "辣度靠小米辣调节，第一次做先放一半试试。",
    "留一点酱汁拌饭，是这道菜最受欢迎的吃法。"
  ],
  "common_mistakes": [
    "鸡蛋带水下油锅，油花四溅容易烫伤手。",
    "煮蛋时间不足，切开蛋黄还是稀的流一盘子。",
    "酱糊大火快炒，颜色发黑带苦味整锅报废。",
    "鸡蛋下酱后猛翻，蛋白碎开，卖相全无。"
  ],
  "substitutions": [
    {
      "original": "小米辣",
      "substitute": "彩椒",
      "ratio": "30克:120克",
      "note": "完全不辣，适合孩子，酱色更亮。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鹌鹑蛋",
      "ratio": "5个:15个",
      "note": "个头小更入味，煮的时间减三分钟。"
    }
  ],
  "variations": [
    "加两片柠檬叶同炒，香气更清亮不闷。",
    "把鸡蛋换成水煮土豆块，就是同款辣酱土豆。",
    "淋一勺椰奶收尾，辣味更柔和顺口。"
  ],
  "serving_suggestion": "一人一个半蛋，浇上红亮酱汁，配白饭和清汤，最典型的印尼家常午餐。",
  "storage": "冷藏可放两天，复热加两勺清水小火焖三分钟；鸡蛋久泡酱汁会变硬。",
