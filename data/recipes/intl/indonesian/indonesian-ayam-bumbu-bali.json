  "equipment": [
    "炒锅",
    "料理机",
    "刀",
    "砧板",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成三厘米见方的块，加盐与生抽抓匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌十分钟足够入味，久放肉质会出水变散。",
      "visual_cue": "鸡块表面泛光，调料完全吸附"
    },
    {
      "n": 2,
      "text": "小米辣、红葱头、大蒜、南姜与香茅放进料理机打成粗糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打成粗糊就够，太细的酱炒起来容易糊底发苦。",
      "visual_cue": "酱糊呈橙红色，能见到细颗粒"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油中火烧热，下酱糊小火慢炒五分钟至香气浓烈、油色发红。",
      "time_min": 5,
      "heat": "小火",
      "tip": "这步叫炒香，火大十秒就焦苦，务必小火耐心。",
      "visual_cue": "酱色转深红，锅边渗出红油"
    },
    {
      "n": 4,
      "text": "下鸡块翻炒到表面变色，加柠檬叶、番茄与清水，盖盖小火焖十五分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "水只要刚没过鸡块一半，焖到收汁才浓郁不稀。",
      "visual_cue": "鸡块裹满红酱，汤汁收至一半"
    },
    {
      "n": 5,
      "text": "加椰糖与盐调味，开盖中火收汁到酱汁浓稠挂勺。",
      "time_min": 8,
      "heat": "中火",
      "tip": "椰糖最后放，早放容易糊底也失去焦糖香。",
      "visual_cue": "酱汁浓稠发亮，锅底留一层红油"
    },
    {
      "n": 6,
      "text": "挑出柠檬叶，装盘后把锅里红油一并浇上即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "红油是这道菜的灵魂，别撇掉，浇上才够香。",
      "visual_cue": "成品油亮红润，酱汁紧裹鸡块"
    }
  ],
  "tips": [
    "小米辣的辣度差别很大，先放一半，尝过再加。",
    "南姜与香茅不可省，这两样撑起了巴厘风味。",
    "炒酱时锅底一有焦味立刻调小，宁可多炒两分钟。",
    "收汁到锅铲划过能留痕的程度，味道最浓缩。"
  ],
  "common_mistakes": [
    "酱糊大火快炒，颜色发黑带苦，整锅只能倒掉。",
    "水加太多收不干，成品变成一锅辣汤。",
    "椰糖一开始就下，糊在锅底带焦苦味。",
    "鸡块焖太久，肉散成丝，一点弹性都没有。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "500克:450克",
      "note": "更瘦，焖的时间减五分钟。"
    },
    {
      "original": "小米辣",
      "substitute": "红辣椒",
      "ratio": "30克:40克",
      "note": "辣度降低，香气更甜。"
    }
  ],
  "variations": [
    "焖好后用炭火烤三分钟，表面带焦香，风味更接近巴厘岛街头。",
    "加一小块虾酱同炒，鲜味更浓，是爪哇一带的做法。",
    "剩下的酱汁拌白饭，比菜本身还下饭。"
  ],
  "serving_suggestion": "连酱带油浇在白饭上，配黄瓜片与炸红葱头，辣得冒汗时来一口冰饮最痛快。",
  "storage": "冷藏可放三天，复热加一勺清水小火焖五分钟，酱汁会重新化开。",
