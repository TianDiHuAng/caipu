    "total_min": 180
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "savory",
    "smoky"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 800,
          "unit": "g",
          "note": "带皮带骨",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 60,
          "unit": "ml",
          "note": "甜酱油底",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 50,
          "unit": "g",
          "note": "增甜上色",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 20,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 15,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 15,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取汁",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "刷烤架",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "腌制",
          "optional": false
        },
        {
          "name": "小米辣",
          "name_en": "bird's eye chili",
          "amount": 10,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 100,
          "unit": "ml",
          "note": "调酱",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤架",
    "刷子",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用刀在厚处划两刀，加盐抹匀，腌十五分钟入味。",
      "time_min": 20,
      "heat": "无火",
      "tip": "划几刀让酱汁进得去，也熟得更均匀。",
      "visual_cue": "肉面划痕清晰可见"
    },
    {
      "n": 2,
      "text": "酱油、红糖、大蒜末、姜末和清水调匀成甜酱油汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "甜酱油汁要调得略稠，刷在肉上才挂得住。",
      "visual_cue": "酱汁棕亮，能挂住勺"
    },
    {
      "n": 3,
      "text": "鸡腿肉放进甜酱油汁里，冷藏腌制两小时以上。",
      "time_min": 120,
      "heat": "无火",
      "tip": "至少两小时，隔夜风味更浓更好吃。",
      "visual_cue": "肉面着色均匀一致"
    },
    {
      "n": 4,
      "text": "烤架烧热刷上植物油，鸡腿肉带皮一面朝下用中火烤八分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "先烤带皮那面，油脂滴下来更香。",
      "visual_cue": "表皮起焦斑，油光冒泡"
    },
    {
      "n": 5,
      "text": "翻面再烤七分钟，同时用刷子刷上两遍腌料汁。",
      "time_min": 8,
      "heat": "中火",
      "tip": "刷两遍就足够，刷太多容易烤糊发苦。",
      "visual_cue": "表面酱色油亮，微微焦边"
    },
    {
      "n": 6,
      "text": "烤到肉中心不再渗出血水，撒香菜和小米辣，挤上柠檬汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "挤柠檬汁能解腻，也让酱香更清爽。",
      "visual_cue": "肉汁清澈，香气扑鼻"
    }
  ],
  "tips": [
    "鸡腿肉划刀更容易入味，也保证中心熟透。",
    "腌够两小时，甜酱油的香气才透到骨头旁边。",
    "刷酱分两三次刷，一次刷太厚容易烤糊。"
  ],
  "common_mistakes": [
    "腌的时间太短，肉只有表面有味。",
    "全程大火猛烤，皮焦了里面还是生的。",
    "腌料刷得太频繁，糖分烤焦发苦。"
  ],
  "substitutions": [
    {
      "original": "红糖",
      "substitute": "棕榈糖",
      "ratio": "50 克:50 克",
      "note": "香气更南洋，甜度略高。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "800 克:900 克",
      "note": "烤的时间缩短三分钟。"
    }
  ],
  "variations": [
    "加两片香兰叶同腌，香气更清雅。",
    "最后撒烤花生碎和红葱酥，口感更丰富。"
  ],
  "serving_suggestion": "配白米饭、黄瓜片和参巴辣酱，是印尼家庭最常做的一份烤鸡。",
  "storage": "冷藏两天，复热用平底锅小火煎两面各两分钟；酱汁单独煮沸后可再用。",
