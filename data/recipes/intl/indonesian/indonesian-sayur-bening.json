  "steps": [
    {
      "n": 1,
      "text": "空心菜摘下嫩叶与茎段，用清水冲洗两遍沥干备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "茎与叶分开下锅，叶子最后放才不会煮烂发黄。",
      "visual_cue": "茎段挺直，叶面湿润不蔫"
    },
    {
      "n": 2,
      "text": "红葱头切片、大蒜拍碎，锅里放植物油小火炒到出香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "葱蒜只要炒香，别炒上色，汤色才清亮。",
      "visual_cue": "葱片透明无焦边，香味清甜"
    },
    {
      "n": 3,
      "text": "加清水、香茅与玉米段烧开，转小火煮十二分钟让玉米出甜味。",
      "time_min": 12,
      "heat": "小火",
      "tip": "玉米先煮够时间，汤底才有自然的甜，不必加糖。",
      "visual_cue": "汤色微黄，玉米粒饱满鼓起"
    },
    {
      "n": 4,
      "text": "下空心菜茎与豆芽煮两分钟，再放嫩叶，加盐与白胡椒关火。",
      "time_min": 3,
      "heat": "中火",
      "tip": "叶子下锅数到二十就关火，余温会继续把它烫熟。",
      "visual_cue": "叶子翠绿卷曲，茎仍带脆感"
    }
  ],
  "tips": [
    "这道汤宜清淡，盐少量即可，靠玉米的甜撑底味。",
    "换成菠菜也行，但菠菜要先焯水去涩再下汤。",
    "汤不要久煮，蔬菜颜色一变就关火最鲜。",
    "喜欢辣可以配一碟小米辣酱油蘸着吃。"
  ],
  "common_mistakes": [
    "空心菜煮超过五分钟，捞起来发黄发烂没有口感。",
    "葱蒜炒到焦黑才加水，整锅汤带一股苦味。",
    "盐放太多，盖过了玉米与蔬菜本身的清甜。",
    "叶子与茎一起下锅，茎还没熟叶子已经烂了。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "菠菜",
      "ratio": "300克:300克",
      "note": "先焯水十秒去涩再下锅。"
    },
    {
      "original": "玉米",
      "substitute": "南瓜",
      "ratio": "200克:250克",
      "note": "汤更绵甜，煮的时间缩短三分钟。"
    }
  ],
  "variations": [
    "加几粒虾米同煮，鲜味更足，汤体更有层次。",
    "换成椰奶做底，就接近印尼的椰香蔬菜汤。",
    "加一小把粉丝同煮，当主食汤喝更顶饱。"
  ],
  "serving_suggestion": "连汤带菜盛一大碗，配炸鸡与白饭，清口解腻正合适。",
  "storage": "冷藏可放一天，复热须煮沸；叶菜隔夜易发黄，建议当餐喝完。",
