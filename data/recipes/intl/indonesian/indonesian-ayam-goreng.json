  "steps": [
    {
      "n": 1,
      "text": "鸡腿洗净擦干，用刀在肉厚处划两刀便于入味。",
      "time_min": 8,
      "heat": "无火",
      "tip": "划两刀，香料味才进得去。，注意火候。",
      "visual_cue": "刀口整齐，肉质完整，状态稳定"
    },
    {
      "n": 2,
      "text": "蒜末、姜片、拍扁的香茅和香菜根放进汤锅。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香菜根别丢，香气比叶子浓。，注意火候。",
      "visual_cue": "香料铺底，香气清亮，状态稳定"
    },
    {
      "n": 3,
      "text": "加姜黄粉、盐和清水，放入鸡腿大火煮开。这一步不要着急。",
      "time_min": 5,
      "heat": "大火",
      "tip": "姜黄粉先化在水里，颜色才匀。，注意火候。",
      "visual_cue": "汤色金黄，浮沫上浮，状态稳定"
    },
    {
      "n": 4,
      "text": "撇去浮沫，转小火盖锅煮二十分钟到肉熟。这一步不要着急。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火煮，鸡肉才嫩不散。，注意火候。",
      "visual_cue": "鸡肉变白，筷子能插透"
    },
    {
      "n": 5,
      "text": "捞出鸡腿沥干汤汁，摊开放凉十分钟。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面干爽，炸的时候才不溅油。，注意火候。",
      "visual_cue": "表皮干爽，颜色金黄，状态稳定"
    },
    {
      "n": 6,
      "text": "炒锅倒植物油烧到一百七十度，下鸡腿中火炸。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温够高，皮才迅速脆起来。，注意火候。",
      "visual_cue": "油面翻泡，表皮起皱，状态稳定"
    },
    {
      "n": 7,
      "text": "每面炸两分钟到深金黄，翻动使受热均匀。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "边炸边转，颜色才一致。，注意火候。",
      "visual_cue": "色泽深金，外壳酥脆，状态稳定"
    },
    {
      "n": 8,
      "text": "捞出沥油，挤青柠汁后趁热吃。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "挤点酸汁，解腻又提香。，注意火候。",
      "visual_cue": "外壳干爽，香气扑鼻，状态稳定"
    }
  ],
  "tips": [
    "先煮后炸，肉才嫩而皮又脆。，值得留意。",
    "煮完晾干表面，炸的时候不溅油。，值得留意。",
    "油温一百七十度最合适，太低会吸油。，值得留意。"
  ],
  "common_mistakes": [
    "没煮熟就炸，里面还是红的。，值得留意。",
    "表面湿就下锅，油花四溅。，值得留意。",
    "炸太久，鸡肉干柴发硬。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡胸肉",
      "ratio": "600 克:600 克",
      "note": "更清淡，煮制时间减五分钟。"
    },
    {
      "original": "姜黄粉",
      "substitute": "咖喱粉",
      "ratio": "6 克:8 克",
      "note": "香气更复合，颜色略浅。"
    }
  ],
  "variations": [
    "煮好后刷甜酱油烤，风味更浓。，值得留意。",
    "配辣椒酱和黄瓜片，做完整套餐。，值得留意。"
  ],
  "serving_suggestion": "配椰香饭、黄瓜片和辣椒酱，是印尼经典组合。",
  "storage": "冷藏两天，复热用烤箱两百度烤八分钟。，效果更稳定。",
