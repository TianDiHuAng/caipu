  ],
  "steps": [
    {
      "n": 1,
      "text": "木薯粉加四十毫升清水揉成团，搓成小指头粗的细条再切成小粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面团要揉到不粘手，太湿就补一点木薯粉。",
      "visual_cue": "面团光滑不裂，颗粒大小均匀"
    },
    {
      "n": 2,
      "text": "水烧开后下木薯粒煮到全部浮起，再煮三分钟捞出泡冷水。",
      "time_min": 6,
      "heat": "中火",
      "tip": "浮起后再煮三分钟中心才透明，别急着捞。",
      "visual_cue": "颗粒完全透明，泡冷水后弹性十足"
    },
    {
      "n": 3,
      "text": "椰糖加水小火煮成糖浆，放凉后与椰奶、白糖、盐混合搅匀。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰奶里加一点盐能明显提甜，别省略也不要多。",
      "visual_cue": "糖浆深褐透亮，椰奶液均匀顺滑"
    },
    {
      "n": 4,
      "text": "菠萝与芒果切成小丁，与木薯粒一起放进大碗，倒入椰奶液。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水果切好后冷藏半小时，吃起来更清爽。",
      "visual_cue": "果丁大小一致，椰奶液没过配料"
    },
    {
      "n": 5,
      "text": "加刨冰或冰块搅匀，盛入杯中淋一勺糖浆即可食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冰要最后加，久泡会让椰奶变稀、果味变淡。",
      "visual_cue": "杯壁挂霜，果丁与珍珠层次分明"
    }
  ],
  "tips": [
    "椰奶选浓稠的老椰奶，稀的会让整杯变水。",
    "木薯粒一次可以多做一些，泡冷水冷藏能放两天。",
    "水果随季节换，菠萝与芒果是最经典的组合。",
    "想更清凉可以把椰奶提前冻成半冰状态再拌。"
  ],
  "common_mistakes": [
    "木薯粒煮到浮起就捞，中心还是白硬块咬不动。",
    "椰奶里不放盐，甜味发散，喝起来单薄发寡。",
    "冰块加太早，椰奶被稀释得完全没味。",
    "椰糖浆熬过头，结成一坨拌不开还带苦味。"
  ],
  "substitutions": [
    {
      "original": "木薯粉",
      "substitute": "糯米粉",
      "ratio": "60克:60克",
      "note": "口感更软，煮的时间缩短一分钟。"
    },
    {
      "original": "菠萝",
      "substitute": "西瓜",
      "ratio": "300克:300克",
      "note": "水分更多，冰要少放一些。"
    }
  ],
  "variations": [
    "加一勺斑斓汁进木薯团，颗粒带天然绿色与清香。",
    "换成牛油果丁，口感更绵密，甜度也更温和。",
    "淋一点炼乳在表面，奶香更浓，是更甜美的版本。"
  ],
  "serving_suggestion": "盛在透明杯里，果丁、珍珠与椰奶分层，插一根粗吸管边喝边舀最过瘾。",
  "storage": "椰奶液与配料分开冷藏可放一天，拌好后尽快吃完，久放会出水变稀。",
