  "steps": [
    {
      "n": 1,
      "text": "椰糖加五十毫升椰奶小火煮化，倒入椰蓉炒到收干成馅。",
      "time_min": 12,
      "heat": "小火",
      "tip": "炒到能抱团不粘手就停，太干会散。",
      "visual_cue": "椰蓉馅深棕油亮，能捏成团"
    },
    {
      "n": 2,
      "text": "面粉、鸡蛋、白砂糖与盐拌匀，分次加剩余椰奶与清水调成稀糊。",
      "time_min": 7,
      "heat": "无火",
      "tip": "面糊要能流动，太稠摊不开薄饼。",
      "visual_cue": "面糊顺滑无颗粒，勺子能挂薄层"
    },
    {
      "n": 3,
      "text": "面糊过筛后静置十分钟，让面粉充分吸足水分。",
      "time_min": 11,
      "heat": "无火",
      "tip": "静置后饼皮更柔韧，包馅不易破。",
      "visual_cue": "面糊表面有小气泡，质地均匀"
    },
    {
      "n": 4,
      "text": "平底锅刷一层薄薄的植物油，小火倒一勺面糊转锅摊成薄饼，煎到边缘翘起。",
      "time_min": 6,
      "heat": "小火",
      "tip": "锅温不要高，饼皮起泡就说明太热了。",
      "visual_cue": "饼皮薄透均匀，表面无焦斑"
    },
    {
      "n": 5,
      "text": "饼皮趁热放一勺椰蓉馅，卷起并把两头折进成春卷状，即可装盘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁热卷才粘得住，凉了会裂开。",
      "visual_cue": "卷形紧实，饼皮半透出棕色馅"
    }
  ],
  "tips": [
    "饼皮越薄越好吃，面糊宁可稀一点。",
    "椰蓉馅要炒干，卷的时候才不漏。",
    "平底锅只要刷薄油，油多饼皮会起泡。",
    "现做现吃最好，放久了饼皮会变硬。"
  ],
  "common_mistakes": [
    "面糊太稠，饼皮厚得像煎饼，卷不起来。",
    "锅太热，饼皮一下锅就起泡焦边。",
    "椰蓉馅太湿，卷完从两头流出来。",
    "饼皮放凉了才去卷，一折就裂开。"
  ],
  "substitutions": [
    {
      "original": "椰蓉",
      "substitute": "椰丝",
      "ratio": "150克:150克",
      "note": "颗粒粗，需切短一些。"
    },
    {
      "original": "椰糖",
      "substitute": "红糖",
      "ratio": "80克:75克",
      "note": "焦香相近，甜度略低。"
    }
  ],
  "variations": [
    "馅里加一小勺椰奶再炒，更湿润。",
    "饼皮加一勺斑斓汁，颜色翠绿更漂亮。",
    "做成小方块状，当茶点吃起来更方便。"
  ],
  "serving_suggestion": "切成两段摆在盘里，配一杯无糖红茶，饼皮柔韧、馅香甜糯，是印尼下午茶最常见的点心。",
  "storage": "常温密封可放一天，冷藏两天；复热用平底锅小火两面各烙一分钟。",
