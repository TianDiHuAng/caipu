  "steps": [
    {
      "n": 1,
      "text": "空心菜与豆芽分别洗净，空心菜摘成五厘米长的段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆芽要掐掉根，口感才干净不牙碜。",
      "visual_cue": "菜段整齐，豆芽根须去净"
    },
    {
      "n": 2,
      "text": "蒸锅水开后放空心菜与豆芽，大火蒸四分钟到刚断生，取出摊开散热。",
      "time_min": 8,
      "heat": "大火",
      "tip": "蒸比焯水更能保住甜味，蒸完一定要摊开散热。",
      "visual_cue": "菜叶翠绿不发黄，茎仍挺直"
    },
    {
      "n": 3,
      "text": "干锅小火把椰蓉炒到浅褐色出香，盛出备用。",
      "time_min": 6,
      "heat": "小火",
      "tip": "椰蓉极易糊，颜色一变金就立刻离火。",
      "visual_cue": "椰蓉呈浅金褐色，香气焦甜"
    },
    {
      "n": 4,
      "text": "锅里倒植物油小火炒香红葱头、大蒜与小米辣，加盐与椰糖拌成料汁。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖只要化开就关火，久炒会结成硬块。",
      "visual_cue": "料汁微稠，葱蒜香气冲鼻"
    },
    {
      "n": 5,
      "text": "蒸好的菜放进大碗，淋料汁撒椰蓉，挤青柠汁后拌匀装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁最后挤，香气最清亮，早放会发涩。",
      "visual_cue": "椰蓉均匀裹住菜叶，闻着清新"
    }
  ],
  "tips": [
    "椰蓉一定要现炒，买来的熟椰蓉香气差很多。",
    "蔬菜蒸完摊开散热，避免余温把菜叶焖黄。",
    "青柠汁用之前再挤，久放会带一股苦味。",
    "喜欢更辣可以把小米辣换成带籽的，辣度翻倍。"
  ],
  "common_mistakes": [
    "椰蓉大火炒，几秒焦黑发苦，整碗都要重做。",
    "蔬菜蒸过头，出锅软塌成泥，一点口感都没有。",
    "料汁里的椰糖没化开，吃到大颗糖粒很突兀。",
    "提前挤好青柠汁放太久，拌出来发苦不清香。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "菠菜",
      "ratio": "250克:250克",
      "note": "蒸的时间减一分钟，避免过软。"
    },
    {
      "original": "椰蓉",
      "substitute": "花生碎",
      "ratio": "80克:70克",
      "note": "香气更浓，但少了椰香。"
    }
  ],
  "variations": [
    "加一点虾酱进料汁，鲜味更足，是更传统的做法。",
    "拌好后撒一把炸红葱头，脆感与香气都更上一层。",
    "换成温热的米饭同拌，就是印尼式的蔬菜拌饭。"
  ],
  "serving_suggestion": "温着吃最香，配烤鸡或炸鱼，清爽解腻，也是一道合格的素主菜。",
  "storage": "冷藏可放一天，复热用蒸锅回温三分钟，微波会让椰蓉返潮失去脆感。",
