  "steps": [
    {
      "n": 1,
      "text": "大米淘洗到水变清，加椰奶、清水与盐放进电饭锅煮成饭。",
      "time_min": 22,
      "heat": "中火",
      "tip": "椰奶容易糊底，水量比平时少一成比较稳。",
      "visual_cue": "米饭蓬松，粒粒带椰香"
    },
    {
      "n": 2,
      "text": "红葱头切薄片，用植物油小火炸到金黄酥脆，捞出沥油。",
      "time_min": 8,
      "heat": "小火",
      "tip": "炸到浅金就捞，余温还会继续上色。",
      "visual_cue": "红葱片金黄透明，油色清亮"
    },
    {
      "n": 3,
      "text": "柠檬叶去掉中间硬梗切细丝，香茅取嫩芯切碎，香菜切碎。",
      "time_min": 8,
      "heat": "无火",
      "tip": "柠檬叶的梗很硬，一定要去掉再切丝。",
      "visual_cue": "香草碎细匀，颜色鲜绿"
    },
    {
      "n": 4,
      "text": "煮好的米饭倒进大碗稍放凉，加入所有香草碎与炸红葱片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "饭太烫会把香草烫黄，放到温热最合适。",
      "visual_cue": "米饭松散，绿色香草分布均匀"
    },
    {
      "n": 5,
      "text": "撒上烤香的花生与小米辣，配黄瓜片一起拌匀即可上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "花生最后加才保脆，拌早了会回软。",
      "visual_cue": "饭色淡黄带绿，花生颗粒分明"
    }
  ],
  "tips": [
    "香草越新鲜越好，切碎后立刻拌进饭里。",
    "炸红葱片是灵魂，一次可以多炸一些存着。",
    "椰奶不要全代替水，否则饭会太腻太湿。",
    "配炸鸡或沙嗲串一起吃，才够完整。"
  ],
  "common_mistakes": [
    "米饭煮得太湿，拌完香草糊成一团。",
    "用热饭直接拌，香草全被烫黄变色。",
    "红葱片炸到深褐才捞，苦味全出来了。",
    "花生提前拌进饭里，吃到时已经回软。"
  ],
  "substitutions": [
    {
      "original": "大米",
      "substitute": "隔夜冷饭",
      "ratio": "400克:600克",
      "note": "改用炒制，不必再煮。"
    },
    {
      "original": "柠檬叶",
      "substitute": "青柠皮屑",
      "ratio": "6片:1个量",
      "note": "香气相近，用量要少。"
    }
  ],
  "variations": [
    "加一把炸小鱼干同拌，咸鲜味更足。",
    "加半勺虾酱同炒，风味更浓更厚。",
    "配一碟甜辣酱蘸黄瓜，吃起来更开胃。"
  ],
  "serving_suggestion": "盛在荷叶或盘里，旁边摆黄瓜片、炸红葱片与花生，配炸鸡与虾片，是印尼家庭聚餐的常见主食。",
  "storage": "冷藏可放一天，复热用蒸锅蒸五分钟，风味会略淡。",
