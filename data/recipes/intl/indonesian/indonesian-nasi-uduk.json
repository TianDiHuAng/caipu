  "steps": [
    {
      "n": 1,
      "text": "大米淘洗三遍后泡二十分钟，捞出沥干水分。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过再煮，米粒才饱满分明。，注意火候。",
      "visual_cue": "米粒白净，水已沥干，状态稳定"
    },
    {
      "n": 2,
      "text": "椰奶、清水、拍扁的香茅和姜片一起倒进汤锅。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香茅拍扁再放，香气才出得来。，注意火候。",
      "visual_cue": "香气清甜，液体乳白，状态稳定"
    },
    {
      "n": 3,
      "text": "加盐搅匀，中火加热到锅边冒小泡但未沸腾。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "别让椰奶大滚，滚了容易分离。，注意火候。",
      "visual_cue": "锅边起泡，液面平稳，状态稳定"
    },
    {
      "n": 4,
      "text": "倒入大米，小火不停翻拌到椰奶被完全吸收。这一步不要着急。",
      "time_min": 12,
      "heat": "小火",
      "tip": "不断翻拌，米才不会粘底糊锅。，注意火候。",
      "visual_cue": "米粒吸饱，锅底无积液"
    },
    {
      "n": 5,
      "text": "把半熟的米移到铺纱布的蒸屉上摊平。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "摊平留孔，蒸汽才上得均匀。，注意火候。",
      "visual_cue": "米层均匀，留有气孔，状态稳定"
    },
    {
      "n": 6,
      "text": "水开后蒸二十分钟，中途开盖翻松一次。这一步不要着急。",
      "time_min": 22,
      "heat": "中火",
      "tip": "翻松一次，米粒上下熟得更匀。，注意火候。",
      "visual_cue": "米粒饱满，粒粒分明，状态稳定"
    },
    {
      "n": 7,
      "text": "关火焖三分钟，花生用植物油小火炒香，盛出配黄瓜片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "关火焖一会，米芯才彻底熟透。，注意火候。",
      "visual_cue": "饭面干爽，香气浓郁，状态稳定"
    }
  ],
  "tips": [
    "大米先泡二十分钟，煮出来才饱满。，值得留意。",
    "椰奶加热别大滚，滚了容易分离。，值得留意。",
    "蒸好的饭翻松一次，粒粒分明。，值得留意。"
  ],
  "common_mistakes": [
    "椰奶大火滚开，煮饭时油水分离。，值得留意。",
    "翻拌不到位，锅底糊一层。，值得留意。",
    "蒸的时间不够，米芯还是硬的。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "300 毫升:300 毫升",
      "note": "奶香更淡，可不加盐。"
    },
    {
      "original": "香茅",
      "substitute": "柠檬叶",
      "ratio": "20 克:6 片",
      "note": "香气更清，用量可略增。"
    }
  ],
  "variations": [
    "加几片斑斓叶同煮，香气更浓。，值得留意。",
    "配炸鸡和辣椒酱，做成完整套餐。，值得留意。"
  ],
  "serving_suggestion": "配炸鸡、煎蛋和辣椒酱，是印尼最常见的早餐组合。",
  "storage": "冷藏两天，复热用蒸锅蒸八分钟。，效果更稳定。",
