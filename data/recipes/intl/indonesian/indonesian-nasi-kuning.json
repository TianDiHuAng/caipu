  "steps": [
    {
      "n": 1,
      "text": "大米淘洗三遍后浸清水半小时，捞出沥到表面不见明水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "米粒要浸透再煮，才会熟得均匀又不夹生。",
      "visual_cue": "米粒发白饱满，指压即碎"
    },
    {
      "n": 2,
      "text": "姜黄磨成细泥，南姜切片，香茅拍扁后切下白色嫩段。",
      "time_min": 5,
      "heat": "无火",
      "tip": "姜黄戴一次性手套处理，沾到手上半天洗不掉。",
      "visual_cue": "姜黄呈明黄糊状，香料分置备用"
    },
    {
      "n": 3,
      "text": "椰奶加清水与盐搅匀，倒入米中拌入姜黄泥与植物油，让米粒均匀染上黄色。",
      "time_min": 5,
      "heat": "无火",
      "tip": "椰奶太浓会糊底，兑清水才煮得透；一勺植物油让饭粒更油亮。",
      "visual_cue": "米粒通体金黄，液面没过米一指"
    },
    {
      "n": 4,
      "text": "电饭锅铺上香茅、南姜与柠檬叶，倒入米与椰奶液，按下煮饭键焖到跳闸。",
      "time_min": 20,
      "heat": "中小火",
      "tip": "香料垫底才不会粘锅，香气也能从下往上渗。",
      "visual_cue": "锅内冒白汽，香料清香散出"
    },
    {
      "n": 5,
      "text": "跳闸后再焖十分钟，开盖挑出香料，用饭勺翻松米粒即可盛盘。",
      "time_min": 5,
      "heat": "无火",
      "tip": "焖十分钟让水汽散匀，米粒才会一颗颗分明。",
      "visual_cue": "饭粒松散油亮，颜色匀净金黄"
    }
  ],
  "tips": [
    "没有姜黄就用咖喱粉，颜色偏淡但香气更足。",
    "椰奶一定要选浓稠的老椰奶，稀的那种煮出来发寡。",
    "米提前浸过，煮饭的水量要比平时少一成，否则会烂。",
    "上桌前撒一把炸好的椰蓉，香味和卖相都更上一个层次。"
  ],
  "common_mistakes": [
    "姜黄下太多，饭苦得吃不出椰香，颜色也发暗。",
    "椰奶不兑水直接煮，锅底糊成一层焦黑硬壳。",
    "米没浸透就下锅，煮出来外软里硬粒粒夹生。",
    "跳闸立刻开盖，蒸汽跑掉，饭粒发干不成团。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "250毫升:250毫升",
      "note": "香气变淡，需补一勺植物油增润。"
    },
    {
      "original": "姜黄",
      "substitute": "咖喱粉",
      "ratio": "10克:12克",
      "note": "风味更复合，颜色略浅。"
    }
  ],
  "variations": [
    "加入几粒丁香同煮，香气更接近节庆版本。",
    "换成糯米来做，就是更黏更香的黄姜糯米饭。",
    "配炸红葱头与花生一起上桌，口感层次更足。"
  ],
  "serving_suggestion": "饭盛成小山状，配咖喱鸡或烤鸡一起上桌，节庆时再撒一层炸红葱头。",
  "storage": "冷藏可放两天，复热加一勺清水用蒸锅蒸十分钟，微波容易让米粒发硬。",
