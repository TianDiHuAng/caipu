  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "香蕉",
          "name_en": "banana",
          "amount": 720,
          "unit": "g",
          "note": "选偏硬未全熟的",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 120,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "调节甜度",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 140,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 300,
          "unit": "ml",
          "note": "油炸",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炸锅",
    "和面盆",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香蕉去皮后纵向对半剖开，再切成两段方便挂糊下锅。",
      "time_min": 5,
      "heat": "无火",
      "tip": "选偏硬的香蕉，炸完才不会烂软。",
      "visual_cue": "香蕉段完整，切面平整"
    },
    {
      "n": 2,
      "text": "面粉倒进盆中，加白糖与盐，用筷子先干拌均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先混干料，面糊才不起疙瘩。",
      "visual_cue": "干粉颜色均匀，无糖结块"
    },
    {
      "n": 3,
      "text": "分次倒入清水，边倒边搅成能挂住手指的稠面糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面糊稠一点，挂得牢才脆。",
      "visual_cue": "面糊顺滑，提起能缓慢滴落"
    },
    {
      "n": 4,
      "text": "把香蕉段放进面糊，翻动让每面都裹上一层薄糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "裹薄薄一层，炸后不吸油。",
      "visual_cue": "香蕉表面均匀挂糊"
    },
    {
      "n": 5,
      "text": "炸锅倒植物油烧到中温，插入筷子周围冒小泡即可。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温不足会吸油，过高会焦。",
      "visual_cue": "筷子入油冒出密集小泡"
    },
    {
      "n": 6,
      "text": "下入香蕉段炸两分钟，到底面定型金黄再翻面。",
      "time_min": 2,
      "heat": "中火",
      "tip": "刚下锅别动，等定型再翻。",
      "visual_cue": "底部变金黄，外壳硬挺"
    },
    {
      "n": 7,
      "text": "翻面继续炸一分半，到两面金黄酥脆后捞出。",
      "time_min": 2,
      "heat": "中火",
      "tip": "外壳金黄就捞出，久炸会焦。",
      "visual_cue": "两面色泽一致，外壳硬脆"
    },
    {
      "n": 8,
      "text": "捞出立放在漏勺上沥油，垫一层厨房纸吸掉多余油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "沥油干净，吃起来才不腻。",
      "visual_cue": "表面无明显挂油，纸上有油印"
    },
    {
      "n": 9,
      "text": "装盘后趁热食用，喜欢甜可再撒一层白糖粉。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃外壳最脆，凉了会变软。",
      "visual_cue": "外壳脆响，香蕉内芯软热"
    }
  ],
  "tips": [
    "香蕉要选偏硬未全熟的，炸后才有形。",
    "面糊调稠一些，裹得牢外壳才脆。",
    "油温保持中温，太热会外焦里生。"
  ],
  "common_mistakes": [
    "用熟透的香蕉去做，下锅就散成糊。",
    "面糊太稀挂不住，炸出来只剩裸香蕉。",
    "油温过高，外壳焦黑里面还是凉的。"
  ],
  "substitutions": [
    {
      "original": "香蕉",
      "substitute": "菠萝",
      "ratio": "720 克:700 克",
      "note": "酸甜更明显，糖可多加十克。"
    },
    {
      "original": "面粉",
      "substitute": "糯米粉",
      "ratio": "120 克:120 克",
      "note": "外壳更黏软，脆度略低。"
    }
  ],
  "variations": [
    "面糊里加一勺椰奶，香味更浓郁。",
    "出锅后淋炼乳或蜂蜜，甜度更足。"
  ],
  "serving_suggestion": "趁热装盘，配一杯黑咖啡或热茶解甜。",
  "storage": "现炸现吃，冷藏后复热外壳不再脆。",
