  "steps": [
    {
      "n": 1,
      "text": "面粉加清水与两克盐揉成光滑面团，表面抹油静置二十分钟。",
      "time_min": 24,
      "heat": "无火",
      "tip": "面团要软一点，抹油静置后才拉得开。",
      "visual_cue": "面团光滑有弹性，按下去能回弹"
    },
    {
      "n": 2,
      "text": "鸡腿肉切小丁，洋葱与胡萝卜切碎，小葱切葱花备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丁切小一点，馅才铺得平、熟得匀。",
      "visual_cue": "食材颗粒细小均匀，大小接近"
    },
    {
      "n": 3,
      "text": "鸡蛋打散，加鸡肉丁、洋葱、胡萝卜、葱花、盐、黑胡椒、辣椒粉与生抽拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液里先调好味，煎的时候不用再补盐。",
      "visual_cue": "蛋液浓稠，食材分布均匀"
    },
    {
      "n": 4,
      "text": "面团分成四份，用手在抹油的案板上推成薄片，铺上蛋液馅料。",
      "time_min": 8,
      "heat": "无火",
      "tip": "推得越薄越脆，破了也没关系会包回去。",
      "visual_cue": "饼皮薄透，馅料铺满中间"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油小火，把饼皮四边折起包住馅料，两面各煎四分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "小火慢煎，皮脆了里面也刚好熟。",
      "visual_cue": "两面金黄，边缘鼓起有脆壳"
    }
  ],
  "tips": [
    "面团抹油静置，是能推薄的关键。",
    "馅料别放太满，包不住就会漏出来。",
    "全程小火慢煎，皮才会酥而不焦。",
    "配酸黄瓜与辣椒酱一起吃最对味。"
  ],
  "common_mistakes": [
    "面团和得太硬，推的时候一拉就破。",
    "馅料水分太多，煎的时候漏一锅。",
    "大火煎，皮焦了里面蛋液还是生的。",
    "包的时候没折紧，翻面时全散开。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "牛肉",
      "ratio": "250克:250克",
      "note": "更接近原版，切得更细。"
    },
    {
      "original": "面粉",
      "substitute": "春卷皮",
      "ratio": "250克:8张",
      "note": "更省事，口感更脆。"
    }
  ],
  "variations": [
    "加一把切碎的韭菜同拌，辛香味更足。",
    "加一小勺咖喱粉，风味更有层次。",
    "做成小方饼状，一口一个吃起来方便。"
  ],
  "serving_suggestion": "煎好切成四块，配酸黄瓜、辣椒酱与一杯甜茶，是印尼傍晚街头最热闹的一份小吃。",
  "storage": "当餐吃完最好，冷藏不超过一天；复热用平底锅小火两面各烙两分钟。",
