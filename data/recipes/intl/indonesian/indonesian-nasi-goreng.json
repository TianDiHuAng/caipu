  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜米饭用手抓散，把结块的饭团全部捏开，摊在盘里备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "饭粒必须颗颗分开，否则下锅后只能炒成糊。",
      "visual_cue": "米饭松散无结块，表面略干"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，热锅下一半植物油，炒成小块蛋花后盛出备用。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "蛋先炒熟盛出，最后回锅才不会碎成渣。",
      "visual_cue": "蛋块蓬松金黄，无流动蛋液"
    },
    {
      "n": 3,
      "text": "余油下蒜末与洋葱丁爆香，加辣椒酱与番茄酱小火炒出红油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "辣酱必须炒过才出香，直接拌进饭里只有生辣味。",
      "visual_cue": "锅内红油翻滚，香味扑鼻"
    },
    {
      "n": 4,
      "text": "下虾仁大火炒到变红卷曲，倒入米饭快速翻炒，把饭粒都裹上酱色。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火快炒才能让饭粒干爽，中小火只会把饭焖软。",
      "visual_cue": "虾仁转成粉红色，饭粒均匀上色"
    },
    {
      "n": 5,
      "text": "淋生抽、撒白糖和盐，倒回蛋花与葱花翻炒三十秒，尝味即出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "生抽沿锅边淋入，遇热激出的酱香更明显。",
      "visual_cue": "饭粒干爽油亮，葱花翠绿未变黄"
    }
  ],
  "tips": [
    "冷饭放冰箱一夜，水分收干后炒出来最松散。",
    "没有三巴酱可用豆瓣酱加少许糖替代，风味略有差别但同样好吃。",
    "出锅前撒炸红葱片，口感层次会明显提升。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭下锅，炒完是一坨黏饭。",
    "火太小，饭在锅里被水汽焖软而不是炒香。",
    "调料一次性全倒，盐和酱叠加导致过咸。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡胸肉",
      "ratio": "120 克:150 克",
      "note": "切小丁先炒熟再回锅。"
    },
    {
      "original": "辣椒酱",
      "substitute": "豆瓣酱",
      "ratio": "25 克:20 克",
      "note": "咸度更高，生抽减至十毫升。"
    }
  ],
  "variations": [
    "上面盖一个单面煎蛋，做成印尼街头最常见的加蛋版本。"
  ],
  "serving_suggestion": "装盘后配黄瓜片、番茄角与炸虾片。",
  "storage": "冷藏两天，复热时用炒锅大火翻热，勿用微波以免饭粒发硬。",
