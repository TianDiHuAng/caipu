  "steps": [
    {
      "n": 1,
      "text": "牛肉切成三厘米块，冷水下锅焯五分钟去血沫，捞出冲净。",
      "time_min": 12,
      "heat": "大火",
      "tip": "冷水下锅才能把血水慢慢逼出来，肉不腥。",
      "visual_cue": "牛肉表面无血沫，汤水澄清"
    },
    {
      "n": 2,
      "text": "厚底锅化黄油，下洋葱丝小火炒到金黄软透。",
      "time_min": 8,
      "heat": "小火",
      "tip": "洋葱炒到甜味出来，饭的底味才厚。",
      "visual_cue": "洋葱丝金黄软塌，锅底香气浓"
    },
    {
      "n": 3,
      "text": "加肉桂、丁香、豆蔻与姜炒香，下牛肉块翻炒上色。",
      "time_min": 7,
      "heat": "中火",
      "tip": "香料要先炒出香再下肉，不然只有生粉味。",
      "visual_cue": "牛肉表面焦褐，香料味扑鼻"
    },
    {
      "n": 4,
      "text": "加番茄、生抽、盐与黑胡椒炒匀，倒清水小火焖四十分钟至肉软。",
      "time_min": 42,
      "heat": "小火",
      "tip": "焖到筷子能轻松插入肉块，汤也收掉一半。",
      "visual_cue": "汤汁浓稠，牛肉软而有形"
    },
    {
      "n": 5,
      "text": "大米洗净放进电饭锅，加焖好的牛肉与汤汁，再补牛奶焖成饭。",
      "time_min": 28,
      "heat": "中火",
      "tip": "汤汁加牛奶总量按米量一比一点二，饭才不烂。",
      "visual_cue": "饭粒饱满带光泽，牛肉分布均匀"
    }
  ],
  "tips": [
    "香料整颗炒比粉状更香，煮前挑出硬块。",
    "牛奶能让饭粒更油润，别用太多。",
    "牛肉焖得越久越软，时间不够嚼不动。",
    "配酸黄瓜与炸红葱片一起上桌更完整。"
  ],
  "common_mistakes": [
    "牛肉没焯水，焖出来的饭带腥味。",
    "香料炒糊了，整锅饭都带一股焦苦味。",
    "汤汁加得太多，饭变成软烂的稀粥。",
    "牛肉切得太小，焖完缩成一颗颗硬粒。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "400克:400克",
      "note": "更接近原版，焖的时间加十分钟。"
    },
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "200毫升:200毫升",
      "note": "更浓香，盐要减两克。"
    }
  ],
  "variations": [
    "加一把葡萄干同焖，甜咸层次更足。",
    "加半勺辣椒粉，微微带辣更正点。",
    "表面撒炸红葱片与杏仁片，卖相更好。"
  ],
  "serving_suggestion": "把饭盛成小山状，牛肉块摆在顶部，撒炸红葱片，配酸黄瓜与一杯热茶，是印尼节庆的主食。",
  "storage": "冷藏可放两天，复热用蒸锅蒸十分钟或微波加盖加热。",
