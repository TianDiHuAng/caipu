      "ratio": "30 克:30 克",
      "note": "口感更粗，蛋液需多加一勺水。"
    }
  ],
  "variations": [
    "加一点虾米，鲜味更足。，别急着加油，成品才好看。",
    "加奶酪碎，口感更浓。，火别太大，味道才进得去。"
  ],
  "serving_suggestion": "配白米饭和辣酱。，锅温要匀，颜色才够亮。",
  "storage": "冷藏一天，复热用平底锅。，慢慢来别急，口感才有层次。",
