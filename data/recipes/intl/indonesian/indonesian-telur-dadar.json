  "equipment": [
    "平底锅",
    "碗",
    "打蛋器",
    "铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打散，加面粉搅到无颗粒。，手法轻些，香气才留得住。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面粉先加，饼才不易破。，起锅前尝味，香气才不跑。",
      "visual_cue": "蛋液稠厚，表面无泡，慢慢来别急，吃口才舒服。"
    },
    {
      "n": 2,
      "text": "洋葱切细丝，小葱切末。，注意别烧干，风味才干净。",
      "time_min": 5,
      "heat": "无火",
      "tip": "丝切细些，才好裹进蛋液。，先试试温度，味道才进得去。",
      "visual_cue": "丝形细长，颗粒匀齐，锅温要匀，口感才不发柴。"
    },
    {
      "n": 3,
      "text": "洋葱、小葱和红辣椒拌进蛋液。，时间掐准，形状才完整。",
      "time_min": 4,
      "heat": "无火",
      "tip": "料别太多，饼才叠得起来。，慢慢来别急，成品才稳当。",
      "visual_cue": "蛋液裹料，分布均匀，先试试温度，咸淡才好把握。"
    },
    {
      "n": 4,
      "text": "加盐和黑胡椒调味，静置三分钟。，下手别慌，表面才漂亮。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置一下，粉才吸足蛋液。，汤汁别收太干，成品才稳当。",
      "visual_cue": "蛋液稍稠，香气混匀，料别一次下太多，食材才不糊。"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油，中火烧热。，起锅前尝味，口感才不散。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要铺满，饼才不粘。，留意锅底，咸淡才好把握。",
      "visual_cue": "油面微波，锅边发热，留意锅底，味道才不闷。"
    },
    {
      "n": 6,
      "text": "倒蛋液，转锅摊成圆饼。，下手别慌，成品才稳当。，注意别烧干，形状才完整。",
      "time_min": 4,
      "heat": "中火",
      "tip": "别急着翻，边缘定型再说。，起锅前尝味，香气才留得住。",
      "visual_cue": "饼边凝固，中心微晃，下手别慌，成品才好看。"
    },
    {
      "n": 7,
      "text": "底面金黄后翻面，再煎一分半。，留意锅底，香气才不跑。",
      "time_min": 3,
      "heat": "中火",
      "tip": "翻一次就够，饼才完整。，火别太大，锅气才足。",
      "visual_cue": "两面金黄，边缘微焦，留意锅底，口感才不散。"
    },
    {
      "n": 8,
      "text": "盛出切块，趁热配饭吃。，锅温要匀，表面才漂亮。，保持小火，整道菜才立得住。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃，凉了发韧。，保持小火，颜色才够亮。",
      "visual_cue": "切块整齐，蛋香扑鼻，时间掐准，吃口才舒服。"
    }
  ],
  "tips": [
    "加一点面粉，饼才不易破。，锅温要匀，火候才均匀。",
    "洋葱切细，口感才软。，慢慢来别急，味道才不闷。",
    "底面金黄再翻，饼才完整。，锅温要匀，味道才进得去。"
  ],
  "common_mistakes": [
    "蛋液太稀，摊开就破。，火别太大，味道才不闷。",
    "火太大，外面焦里面生。，手法轻些，口感才有层次。",
    "翻面太早，饼散成块。，注意别烧干，香气才留得住。"
  ],
  "substitutions": [
