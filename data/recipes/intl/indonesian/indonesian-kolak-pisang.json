  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "木勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红薯去皮切成两厘米块，香蕉剥皮切成三厘米厚的斜片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "香蕉选偏硬一点的，煮了才不散。",
      "visual_cue": "红薯块均匀，香蕉片完整"
    },
    {
      "n": 2,
      "text": "汤锅倒清水与椰糖，小火煮到椰糖完全化开。",
      "time_min": 8,
      "heat": "小火",
      "tip": "椰糖要煮化再下料，否则底部会结块发焦。",
      "visual_cue": "糖水棕红清亮，无糖粒"
    },
    {
      "n": 3,
      "text": "下红薯块煮十二分钟，筷子能插入但还有一点阻力。",
      "time_min": 14,
      "heat": "小火",
      "tip": "红薯先煮，香蕉后放，成熟时间差很多。",
      "visual_cue": "红薯软中带韧，汤色加深"
    },
    {
      "n": 4,
      "text": "加椰奶、白砂糖、肉桂与盐，小火加热到微沸。",
      "time_min": 6,
      "heat": "小火",
      "tip": "椰奶不要大火滚，滚了容易油水分离。",
      "visual_cue": "汤色奶白微棕，表面有细泡"
    },
    {
      "n": 5,
      "text": "下香蕉片煮四分钟至热透，关火放温即可盛碗。",
      "time_min": 6,
      "heat": "小火",
      "tip": "香蕉煮久了会化，热透就够。",
      "visual_cue": "香蕉片边缘半透，形状完整"
    }
  ],
  "tips": [
    "香蕉选半熟偏硬的，煮完才成形。",
    "椰糖比白糖香，别全用白糖代替。",
    "椰奶全程小火加热，滚沸就会油水分离。",
    "冰镇之后吃更清爽，夏天最合适。"
  ],
  "common_mistakes": [
    "用熟透发软的香蕉，一煮就化成糊。",
    "椰糖没化开就下红薯，锅底结块发苦。",
    "用大火滚椰奶，汤立刻变成絮状。",
    "清水放得太少，煮到一半就稠成泥。"
  ],
  "substitutions": [
    {
      "original": "香蕉",
      "substitute": "芭蕉",
      "ratio": "500克:500克",
      "note": "更紧实，煮的时间加两分钟。"
    },
    {
      "original": "红薯",
      "substitute": "南瓜",
      "ratio": "200克:220克",
      "note": "更易化，煮的时间减四分钟。"
    }
  ],
  "variations": [
    "加几颗糯米小圆子同煮，更有嚼感。",
    "加一片香草荚同煮，香气更浓更圆。",
    "冰镇后加碎冰，做成夏天的甜品。"
  ],
  "serving_suggestion": "温热时盛进小碗，香蕉与红薯各占一半，浇上奶白的椰汤，是印尼斋月里最常见的开斋甜品。",
  "storage": "冷藏可放两天，复热用小火加少量清水慢加热，不要滚沸。",
