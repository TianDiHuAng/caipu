  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切大块，上锅蒸二十分钟到用筷子能压烂。",
      "time_min": 23,
      "heat": "中火",
      "tip": "蒸比煮好，土豆不吸水才不粘手。",
      "visual_cue": "筷子一压就散开成泥"
    },
    {
      "n": 2,
      "text": "趁热把土豆压成细泥，再放凉到不烫手时使用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "放凉一点，后面拌蛋才不会被烫熟。",
      "visual_cue": "泥体细腻，没有颗粒"
    },
    {
      "n": 3,
      "text": "五花肉丁下锅小火煸出油脂，加洋葱碎和大蒜末炒香放凉。",
      "time_min": 6,
      "heat": "小火",
      "tip": "煸出的油别倒，拌进土豆泥更香。",
      "visual_cue": "肉丁焦香，洋葱透明"
    },
    {
      "n": 4,
      "text": "土豆泥里加炒好的肉料、香菜末、盐和黑胡椒拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到看不见明显的土豆结块为止。",
      "visual_cue": "泥体均匀，颜色微黄"
    },
    {
      "n": 5,
      "text": "拌入一个蛋黄让泥更黏，再分成十份搓成圆饼。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蛋黄黏性最好，饼坯才不容易散。",
      "visual_cue": "饼坯圆整，边缘不开裂"
    },
    {
      "n": 6,
      "text": "饼坯两面沾一层玉米淀粉，再刷上打散的鸡蛋液。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先沾淀粉再刷蛋液，下锅才成脆壳。",
      "visual_cue": "表面均匀挂一薄层"
    },
    {
      "n": 7,
      "text": "植物油烧到一百七十度，下饼坯炸两分钟至两面金黄。",
      "time_min": 4,
      "heat": "大火",
      "tip": "油温别太高，外皮焦了里面还没热。",
      "visual_cue": "外壳金黄，浮起上浮"
    }
  ],
  "tips": [
    "土豆选粉质品种，压出的泥才不黏手。",
    "土豆泥要放凉再加蛋，否则蛋会被烫成小块。",
    "先沾淀粉再刷蛋液，炸出来的壳才够脆。"
  ],
  "common_mistakes": [
    "土豆煮后没吸干水，泥太湿饼坯一按就塌。",
    "土豆泥太烫就加蛋，蛋被烫熟结出白块。",
    "油温太高下锅，外皮发黑里面还是凉的。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "牛肉",
      "ratio": "100 克:100 克",
      "note": "切更细的丁，煸的时间缩短。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "面粉",
      "ratio": "30 克:30 克",
      "note": "外壳稍厚，不如淀粉脆。"
    }
  ],
  "variations": [
    "加一把甜玉米粒进去，口感更清甜。",
    "做成小圆球状，炸的时间缩短半分钟。"
  ],
  "serving_suggestion": "配辣椒酱和米饭，或者当下午茶点心，是印尼家庭最常见的配菜之一。",
  "storage": "冷藏两天，复热用烤箱两百度五分钟恢复酥脆，微波会变软。",
