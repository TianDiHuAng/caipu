  "steps": [
    {
      "n": 1,
      "text": "红葱头、大蒜、小米辣、南姜与姜黄放进研磨碗，磨成细腻的香料泥。",
      "time_min": 12,
      "heat": "无火",
      "tip": "磨得越细，香气越匀，也不容易炒糊。",
      "visual_cue": "香料泥细腻，颜色橙黄"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油中火，下香料泥慢炒八分钟到出红油。",
      "time_min": 9,
      "heat": "中火",
      "tip": "一定要炒到油色变红，生香料味才散掉。",
      "visual_cue": "香料泥变深，锅边渗红油"
    },
    {
      "n": 3,
      "text": "下鸡腿肉块翻炒上色，加柠檬叶与香茅一起炒香。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸡块表面收紧再下椰奶，肉才不会散。",
      "visual_cue": "鸡块色泽橙红，香气浓烈"
    },
    {
      "n": 4,
      "text": "倒一半椰奶与清水，小火盖盖焖三十分钟至鸡肉软。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢焖，椰奶才不会油水分离。",
      "visual_cue": "汤汁浓稠，表面浮一层红油"
    },
    {
      "n": 5,
      "text": "加剩余椰奶、盐与椰糖，开中火收汁到浓稠挂勺即可。",
      "time_min": 10,
      "heat": "中火",
      "tip": "最后这半份椰奶是香气和浓度的关键。",
      "visual_cue": "汤汁浓亮，鸡块裹满酱汁"
    }
  ],
  "tips": [
    "香料泥要炒到出红油，这是味道的分水岭。",
    "椰奶分两次加，先焖后收，层次差很多。",
    "椰糖能压住辣，也让酱色更漂亮。",
    "配白饭与冰黄瓜片，辣得顺口又解腻。"
  ],
  "common_mistakes": [
    "香料泥没炒透，吃起来有生蒜的冲味。",
    "大火收汁，椰奶油水分离变成絮状。",
    "小米辣放太早又煮太久，辣味发闷。",
    "鸡块没上色就加椰奶，成品寡淡。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "900克:900克",
      "note": "焖的时间减五分钟。"
    },
    {
      "original": "椰糖",
      "substitute": "红糖",
      "ratio": "20克:18克",
      "note": "焦香稍弱，甜度接近。"
    }
  ],
  "variations": [
    "加两只水煮蛋同焖，蛋吸满酱汁非常香。",
    "加一把小土豆同焖，更饱腹也更香。",
    "收得更干一些，就接近仁当的浓稠度。"
  ],
  "serving_suggestion": "连酱一起浇在白饭上，配黄瓜片与炸虾片，辣香里带椰奶的圆润，是印尼最下饭的一道鸡。",
  "storage": "冷藏可放两天，椰奶制品不宜久放；复热用小火加少量清水慢加热。",
