  "steps": [
    {
      "n": 1,
      "text": "卷心菜切成大片，豆角掐去两头切四厘米段，土豆去皮切滚刀块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆角一定要掐掉筋，吃口才不塞牙。",
      "visual_cue": "三种菜大小均匀分开装"
    },
    {
      "n": 2,
      "text": "炒锅放植物油烧热，下姜片和大蒜片小火爆出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "姜蒜只需爆香，炒焦了整锅汤都发苦。",
      "visual_cue": "蒜片金黄，香气升起来"
    },
    {
      "n": 3,
      "text": "倒入五百毫升清水大火烧开，先下土豆块煮五分钟。",
      "time_min": 7,
      "heat": "大火",
      "tip": "土豆最耐煮，先下它才不会一锅生熟不一。",
      "visual_cue": "土豆边缘变钝，水滚不停"
    },
    {
      "n": 4,
      "text": "下豆角和卷心菜，中小火再煮八分钟到蔬菜变软。",
      "time_min": 8,
      "heat": "中火",
      "tip": "豆角必须煮到完全熟透，生豆角含毒素不能吃。",
      "visual_cue": "豆角颜色转深发暗"
    },
    {
      "n": 5,
      "text": "倒入椰奶转小火，边倒边轻搅，让汤色变成乳白。",
      "time_min": 4,
      "heat": "小火",
      "tip": "椰奶一沸就分层，全程小火别让它滚起来。",
      "visual_cue": "汤色乳白，表面浮薄油花"
    },
    {
      "n": 6,
      "text": "加盐和白糖调味，小火再温三分钟关火，静置五分钟上桌。",
      "time_min": 5,
      "heat": "小火",
      "tip": "静置几分钟味道才融进去，急着喝味寡淡。",
      "visual_cue": "汤面平静，菜料沉底"
    }
  ],
  "tips": [
    "椰奶务必最后小火加入，滚沸会油水分离。",
    "豆角要煮到颜色全暗、彻底熟透才能出锅。",
    "姜蒜先爆香是印尼菜打底的固定动作。"
  ],
  "common_mistakes": [
    "椰奶大火滚开，汤面立刻浮起一层油。",
    "豆角没煮透，夹生还带着生豆味。",
    "土豆和卷心菜同时下，菜烂了土豆还硬。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "小白菜",
      "ratio": "300 克:300 克",
      "note": "更嫩，煮四分钟就熟，别久煮。"
    },
    {
      "original": "椰奶",
      "substitute": "椰奶加牛奶",
      "ratio": "400 毫升:250 毫升+150 毫升",
      "note": "奶味更轻，适合怕腻的人。"
    }
  ],
  "variations": [
    "加一勺虾米同煮，鲜味更足更厚。",
    "配一碟三巴酱蘸着吃，辣香更明显。"
  ],
  "serving_suggestion": "盛进深碗配白米饭，印尼人习惯用汤勺舀汤浇在饭上一起吃。",
  "storage": "冷藏两天，复热时小火慢温，加少量清水稀释免得过稠。",
