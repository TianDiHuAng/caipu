  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "料理机",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红椒整只与大蒜放烤盘，两百度烤二十五分钟到表皮起黑泡。",
      "time_min": 25,
      "heat": "中火",
      "tip": "表皮烤到发黑才好剥，肉却仍是甜的。",
      "visual_cue": "红椒鼓胀塌陷，表皮大片焦黑"
    },
    {
      "n": 2,
      "text": "趁热把红椒放进碗里盖住焖十分钟，然后撕去外皮与籽。",
      "time_min": 10,
      "heat": "无火",
      "tip": "焖过之后皮一拉就整片下来，不用刮。",
      "visual_cue": "红椒肉呈半透明状，表面无残留薄膜"
    },
    {
      "n": 3,
      "text": "杏仁用干锅小火烘三分钟到出香，中途不停翻动。",
      "time_min": 3,
      "heat": "小火",
      "tip": "闻到坚果香就起锅，颜色变深就苦了。",
      "visual_cue": "杏仁表面泛油光，香气明显"
    },
    {
      "n": 4,
      "text": "红椒肉、烤软的大蒜、杏仁与撕碎的面包一起放进料理机。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面包能吸住多余水分，打出的酱稠而不散不渗油。",
      "visual_cue": "食材堆在杯底，坚果与椒肉分层"
    },
    {
      "n": 5,
      "text": "加橄榄油、黑醋与红椒粉打成顺滑糊，用盐调味后冷藏静置。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打一会停一下刮杯壁，避免油水分离。",
      "visual_cue": "酱体橙红发亮，能缓慢流动"
    }
  ],
  "tips": [
    "红椒烤完可提前一晚做好冷藏，第二天打酱更省事。",
    "黑醋换成雪利醋风味更地道，酸度更柔和。",
    "喜欢颗粒感就留一小把杏仁最后切碎拌进去。",
    "做好的酱冷藏一夜，风味融合后才最好吃。"
  ],
  "common_mistakes": [
    "红椒没烤到起泡就剥皮，皮撕不下来只能刮，带出涩味。",
    "杏仁烘过头，打出的酱带明显焦苦盖住椒香。",
    "一次性倒完橄榄油，酱体打散出现油水分离。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "60克:60克",
      "note": "核桃油脂高，橄榄油减十毫升。"
    },
    {
      "original": "红椒",
      "substitute": "甜椒",
      "ratio": "400克:400克",
      "note": "不辣，风味更清淡。"
    }
  ],
  "variations": [
    "加一小块烤过的番茄，酸甜更突出适合配烤鱼。",
    "把杏仁换成松子，酱体颜色更浅更浓郁。"
  ],
  "serving_suggestion": "配烤蔬菜、煎鱼或白灼海鲜，抹在烤面包上也很合适。",
  "storage": "冷藏四天，表面淋一层橄榄油封住，冷冻一个月风味不散。",
