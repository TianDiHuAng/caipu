  "equipment": [
    "烤箱",
    "烤盘",
    "刀",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼柳用厨房纸吸干水分，两面撒盐和黑胡椒腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "提前撒盐能让鱼肉收紧，烤的时候不易散。",
      "visual_cue": "鱼柳干爽，表面有盐粒"
    },
    {
      "n": 2,
      "text": "土豆切成半厘米厚的圆片，铺在烤盘底部当垫层。",
      "time_min": 8,
      "heat": "无火",
      "tip": "土豆垫底接住鱼汁，烤出来最入味。，注意火候。",
      "visual_cue": "土豆片均匀，铺满盘底"
    },
    {
      "n": 3,
      "text": "洋葱切丝铺在土豆上，再放番茄块，撒一半蒜片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蔬菜铺成一层，鱼肉才不直接贴盘烤焦。",
      "visual_cue": "蔬菜平整，蒜片分布，状态稳定"
    },
    {
      "n": 4,
      "text": "鳕鱼柳摆在蔬菜上，淋一半橄榄油，撒剩余蒜片。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鱼皮朝下摆，烤好外形完整不卷边。，注意火候。",
      "visual_cue": "鱼柳平放，油已淋匀，状态稳定"
    },
    {
      "n": 5,
      "text": "烤箱预热二百度，烤盘送入中层烤二十分钟。这一步不要着急。",
      "time_min": 5,
      "heat": "-",
      "tip": "土豆厚的话先单独烤十分钟，避免鱼熟土豆硬。",
      "visual_cue": "烤箱升温，香味渐出，状态稳定"
    },
    {
      "n": 6,
      "text": "取出再淋剩余橄榄油，回炉烤五分钟到表面微微金黄。",
      "time_min": 6,
      "heat": "-",
      "tip": "最后淋一次油，表面亮泽也不干柴。，注意火候。",
      "visual_cue": "鱼表面金黄，油光浮动"
    },
    {
      "n": 7,
      "text": "出炉静置三分钟，撒香菜碎，连烤盘一起端上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置让汁水回稳，切的时候不流一盘。",
      "visual_cue": "鱼肉分层，汁水清亮，状态稳定"
    }
  ],
  "tips": [
    "鱼柳提前撒盐腌十分钟，肉质更紧实。，值得留意。",
    "土豆垫底接住鱼汁，成品味道才浓。，值得留意。",
    "最后再淋一次橄榄油，表面不干柴。，值得留意。"
  ],
  "common_mistakes": [
    "鱼直接贴烤盘，底部粘住撕不下来。，务必避免。",
    "土豆切太厚，鱼熟了土豆还夹生。，务必避免。",
    "烤完立刻切，鱼肉散成一块块碎片。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "银鳕鱼",
      "ratio": "600 克:600 克",
      "note": "油脂更多，烤制时间减三分钟。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "60 毫升:55 克",
      "note": "奶香更浓，适合喜欢西式风味的人。"
    }
  ],
  "variations": [
    "加一把青橄榄同烤，咸香更突出。，也很受欢迎。",
    "撒少许红椒粉，颜色和香气都更足。，也很受欢迎。"
  ],
  "serving_suggestion": "连烤盘端上桌，配硬面包蘸盘底的油汁最香。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤八分钟。",
