          "name_en": "garlic",
          "amount": 30,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 10,
          "unit": "g",
          "note": "切碎",
