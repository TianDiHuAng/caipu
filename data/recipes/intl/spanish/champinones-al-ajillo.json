        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蘑菇 500g 用湿布擦净表面，去掉硬蒂后对半切开，不要用水浸泡。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蘑菇吸水像海绵，擦比洗好。",
      "visual_cue": "蘑菇表面干净、切面平整"
    },
    {
      "n": 2,
      "text": "平底锅倒 50ml 橄榄油，小火加热后放入 30g 蒜片与 2 个干辣椒段。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜片小火慢煎，香味才温和。",
      "visual_cue": "蒜片边缘微黄、油面冒小泡"
    },
    {
      "n": 3,
      "text": "转大火放入蘑菇，平铺锅底不要翻动，煎 2 分钟至底面金黄。",
      "time_min": 3,
      "heat": "大火",
      "tip": "先别翻，让蘑菇煎出焦边。",
      "visual_cue": "蘑菇底面金黄、体积略缩"
    },
    {
      "n": 4,
      "text": "翻炒 2 分钟至蘑菇出水又收干，淋入 40ml 白葡萄酒继续翻炒 1 分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "酒一入锅就挥发，香气全留在蘑菇里。",
      "visual_cue": "酒气散尽、蘑菇油亮"
    },
    {
      "n": 5,
      "text": "加 4g 盐翻匀，撒欧芹碎，关火后静置 1 分钟让味道融合即可装盘。",
      "time_min": 3,
      "heat": "小火",
      "tip": "关火静置一分钟，蘑菇更入味。",
      "visual_cue": "蘑菇油润、蒜香浓郁"
    }
  ],
  "tips": [
    "蘑菇用湿布擦净即可，泡水会吸满水分煎不香。",
    "蒜片小火煎出香味，别用大火爆到焦黑。",
    "白葡萄酒沿锅边淋入，酒香挥发得更透。"
  ],
  "common_mistakes": [
    "蘑菇水洗后直接下锅，出水变成煮蘑菇。",
    "蒜片用大火爆炒，几秒钟就焦黑发苦。",
    "盐放太早，蘑菇出水多口感发韧。"
  ],
  "substitutions": [
    {
      "original": "蘑菇",
      "substitute": "口蘑",
      "ratio": "500g 对 500g",
      "note": "个头小可整颗煎。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "料酒",
      "ratio": "40ml 对 30ml",
      "note": "香气不同，需加 1g 白糖平衡。"
    }
  ],
  "variations": [
    "黄油版：橄榄油减半，加 20g 黄油同煎。",
    "辣味版：干辣椒增加到 4 个，辣味更明显。"
  ],
  "serving_suggestion": "装小陶盘，配切片法棍蘸蒜油一起吃。",
  "storage": "冷藏 2 天，复热用平底锅干煎 2 分钟。",
