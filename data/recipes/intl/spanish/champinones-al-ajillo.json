          "name_en": "olive oil",
          "amount": 50,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
          "name": "白葡萄酒",
          "name_en": "dry white wine",
          "amount": 40,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "盐",
