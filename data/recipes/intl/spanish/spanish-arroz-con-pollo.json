  "equipment": [
    "厚底平底锅",
    "木铲",
    "厨房夹",
    "铝箔"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用厨房纸吸干，两面撒一半盐和黑胡椒静置十分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面干才煎得出金黄脆皮，湿的只会出水。",
      "visual_cue": "鸡皮干燥、盐粒均匀附着"
    },
    {
      "n": 2,
      "text": "厚底锅放橄榄油，中火把鸡皮朝下煎到金黄，翻面再煎两分钟盛出。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸡皮煎到能自然离锅再翻，硬翻会撕破鸡皮。",
      "visual_cue": "鸡皮金脆、锅底留一层焦香物"
    },
    {
      "n": 3,
      "text": "原锅下洋葱与甜椒炒软，加入大蒜与红椒粉炒二十秒出香。",
      "time_min": 10,
      "heat": "中火",
      "tip": "红椒粉极易焦苦，下锅后数到二十就要加液体。",
      "visual_cue": "蔬菜软塌、油色转红"
    },
    {
      "n": 4,
      "text": "倒入番茄泥炒到颜色变深、水分收干，淋白葡萄酒煮到酒气散尽。",
      "time_min": 10,
      "heat": "中火",
      "tip": "这一步叫做索夫里托，是西班牙菜的味道底座。",
      "visual_cue": "酱体浓稠发暗红、酒味不再刺鼻"
    },
    {
      "n": 5,
      "text": "下大米翻炒一分钟裹上酱汁，加清水与剩余盐，鸡块铺回锅中。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "米要先炒再加水，煮出来颗粒分明不黏糊。",
      "visual_cue": "米粒油亮、液面高出米约一指"
    },
    {
      "n": 6,
      "text": "煮开后转小火盖铝箔焖十八分钟，撒青豆再焖三分钟，关火静置五分钟。",
      "time_min": 18,
      "heat": "小火",
      "tip": "焖好后静置别急着开盖，让水分均匀回吸。",
      "visual_cue": "米粒饱满无白芯、锅底微结薄壳"
    },
    {
      "n": 7,
      "text": "开盖撒欧芹碎，配柠檬角上桌，吃前挤汁提香。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬汁能压住油腻，也让红椒粉的香气更亮。",
      "visual_cue": "米饭松散、鸡皮颜色油亮"
    }
  ],
  "tips": [
    "米量与水量的比例约一比二点二，短粒米吸水量大。",
    "喜欢锅巴可在最后两分钟开大火十秒，听到轻响即可关火。",
    "用焯鸡腿肉的汤代替清水，鲜味会明显提升一个档次。"
  ],
  "common_mistakes": [
    "米下锅后频繁翻搅，煮出来成了一锅粥。",
    "红椒粉与蒜同炒过久，整锅发苦。",
    "水量不足中途加水，米粒夹生且外层糊。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "整鸡",
      "ratio": "500g 对 半只",
      "note": "需剁成小块并延长焖煮五分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "米酒",
      "ratio": "50ml 对 50ml",
      "note": "甜度较高，需减少五克盐。"
    }
  ],
  "variations": [
    "甜椒与青豆加量、番茄减半，做成更清爽的蔬菜版本。",
    "红椒粉加量并把鸡腿肉煎得更焦，烟熏香气更突出。"
  ],
  "serving_suggestion": "连锅上桌，配柠檬角与沙拉，作为家庭聚餐的主食。",
  "storage": "冷藏两天，冷冻两周；复热加少量清水盖盖小火焖透。",
