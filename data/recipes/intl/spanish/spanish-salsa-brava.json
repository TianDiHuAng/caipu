  "equipment": [
    "小汤锅",
    "打蛋器",
    "细筛",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小锅里倒橄榄油，下洋葱末小火炒到透明发软。",
      "time_min": 7,
      "heat": "小火",
      "tip": "洋葱炒透才出甜味，这点甜能托住后面的辣。",
      "visual_cue": "洋葱透明，锅底浮着清油"
    },
    {
      "n": 2,
      "text": "加蒜末炒出香味，大约一分钟，不要炒到变色。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末一炒黄就发苦，一分钟刚好出香味。",
      "visual_cue": "蒜末发白，香气慢慢升起"
    },
    {
      "n": 3,
      "text": "撒入面粉炒一分钟，让油和粉混成一层稀薄的糊。",
      "time_min": 2,
      "heat": "小火",
      "tip": "面粉炒过才没有生面粉味，酱体也更顺滑。",
      "visual_cue": "油粉混匀，锅底没有干粉"
    },
    {
      "n": 4,
      "text": "加红椒粉炒出红油，立刻倒入番茄碎快速翻炒。",
      "time_min": 4,
      "heat": "中火",
      "tip": "红椒粉怕高温，炒十秒就下番茄，否则整锅发苦。",
      "visual_cue": "油色橙红，番茄碎开始起泡"
    },
    {
      "n": 5,
      "text": "倒入高汤煮十分钟，中途用打蛋器搅动两三次。",
      "time_min": 12,
      "heat": "中火",
      "tip": "打蛋器能把番茄块打散，比用铲子搅得更细。",
      "visual_cue": "酱体收稠，气泡变得粗大"
    },
    {
      "n": 6,
      "text": "加辣椒酱、白醋、白糖与盐，搅匀后尝一口调味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣、酸、甜要平衡，觉得辣就再补一点糖。",
      "visual_cue": "酱色深红，质地明显浓稠"
    },
    {
      "n": 7,
      "text": "用细筛压出细腻的酱汁，装进小碗里晾凉备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛去掉番茄皮和粗粒，抹在炸物上才够顺滑。",
      "visual_cue": "酱面光滑，看不到颗粒"
    }
  ],
  "tips": [
    "辣味酱是配油炸小食的标配，在家里多做一份冷藏起来很方便。",
    "红椒粉的辣度差别很大，第一次做先少放，尝了再加。",
    "酱要浓到能挂住勺子，太稀浇上去会全流到盘底。"
  ],
  "common_mistakes": [
    "红椒粉下锅后大火炒，几秒就发苦，整锅救不回来。",
    "高汤一次倒完，煮到最后酱还是稀的，挂不住菜。",
    "番茄没炒透就加水，生酸味留在酱里，吃着寡淡。"
  ],
  "substitutions": [
    {
      "original": "辣椒酱",
      "substitute": "红椒粉",
      "ratio": "20克:加至12克",
      "note": "只用红椒粉，辣度温和，颜色更亮。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "200毫升:200毫升",
      "note": "清水版需补一克盐，鲜味略淡。"
    }
  ],
  "variations": [
    "加半个煮软的甜椒同打，酱体更厚，辣味也更柔。",
    "放一勺蒜香蛋黄酱搅开，做成粉红色的柔和版，配面包也合适。"
  ],
  "serving_suggestion": "装小碗配油炸小食，或直接浇在煎蛋上，怎么吃都合适。",
  "storage": "冷藏密封可存四天，冷冻可存一个月，复热时加少量水调开。",
