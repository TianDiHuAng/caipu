  "equipment": [
    "砂锅",
    "木勺",
    "砧板",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉撒盐腌十分钟，砂锅烧热橄榄油，鸡皮朝下煎。",
      "time_min": 12,
      "heat": "中火",
      "tip": "砂锅要先烧透再下油，冷锅下鸡肉会粘得抬不起来。",
      "visual_cue": "鸡皮金黄，锅底起焦香"
    },
    {
      "n": 2,
      "text": "翻面再煎三分钟取出，用原锅下腊肠片煎出红油。",
      "time_min": 5,
      "heat": "中火",
      "tip": "腊肠的红油是这道饭的颜色来源，别急着倒掉。",
      "visual_cue": "腊肠卷边，锅里的油色发红"
    },
    {
      "n": 3,
      "text": "下洋葱末、蒜末与甜椒丁，中火翻炒到软透出水。",
      "time_min": 6,
      "heat": "中火",
      "tip": "甜椒炒软才出甜味，硬的时候下汤只会涩。",
      "visual_cue": "蔬菜软塌，锅底不见水"
    },
    {
      "n": 4,
      "text": "加番茄碎与红椒粉炒成浓稠底酱，倒入白葡萄酒。",
      "time_min": 6,
      "heat": "中火",
      "tip": "酒后煮到酒气散尽，酸味才不会抢掉藏红花的香。",
      "visual_cue": "底酱浓稠，酒气基本散尽"
    },
    {
      "n": 5,
      "text": "鸡块回锅翻匀，倒入泡过藏红花的热高汤煮开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "汤要热，冷的会让砂锅温度骤降，米粒外熟内生。",
      "visual_cue": "汤面翻滚，汤色转成金黄"
    },
    {
      "n": 6,
      "text": "下大米用木勺铺平，中火煮十二分钟，全程不搅动。",
      "time_min": 14,
      "heat": "中火",
      "tip": "米下锅就别搅，砂锅底薄，一搅米粒全碎。",
      "visual_cue": "汤面冒小泡，米粒鼓起"
    },
    {
      "n": 7,
      "text": "撒入豌豆转小火焖八分钟，到汤汁基本收干为止。",
      "time_min": 9,
      "heat": "小火",
      "tip": "豌豆最后放，久煮会发黄，甜味也跑掉。",
      "visual_cue": "汤汁收干，豌豆仍旧翠绿"
    },
    {
      "n": 8,
      "text": "关火后盖上干布静置五分钟，撒上欧芹碎端上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置的五分钟饭粒会把余汤吸干，口感才松散。",
      "visual_cue": "饭面干爽，锅边结薄壳"
    }
  ],
  "tips": [
    "砂锅饭是西班牙家庭的周日午饭，一口砂锅就能端上桌。",
    "腊肠和藏红花是这锅饭的两个关键，缺一个味道就单薄。",
    "锅底的薄壳别刮掉，那是最好吃的一层。"
  ],
  "common_mistakes": [
    "砂锅没烧透就下鸡肉，全粘在锅底刮不下来。",
    "中途搅动米粒，淀粉出来，整锅变成稠糊。",
    "汤一次加太多，煮到最后饭烂成粥，粒感全无。"
  ],
  "substitutions": [
    {
      "original": "腊肠",
      "substitute": "火腿",
      "ratio": "80克:80克",
      "note": "火腿版咸度更高，盐要少放两克。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "兔肉",
      "ratio": "450克:450克",
      "note": "兔肉是瓦伦西亚传统做法，炖的时间需延长十分钟。"
    }
  ],
  "variations": [
    "加一把青豆和几片红椒同焖，颜色更热闹。",
    "放几只虾仁进去，海陆混合，是海岸一带的吃法。"
  ],
  "serving_suggestion": "连砂锅端上桌，配一份蔬菜沙拉和一杯干红。",
  "storage": "冷藏可存两天，复热加两勺高汤小火焖五分钟。",
