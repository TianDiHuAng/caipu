  "equipment": [
    "烤盘",
    "擀面杖",
    "平底锅",
    "烤箱",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉过筛加盐和酵母，倒入温水和软化的黄油揉成光滑面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团揉到不粘手，擀皮才不易破。，注意火候。",
      "visual_cue": "面团光滑，按压回弹，状态稳定"
    },
    {
      "n": 2,
      "text": "盖布在温暖处发酵四十分钟，面团涨到约两倍大。",
      "time_min": 42,
      "heat": "无火",
      "tip": "发到两倍大就够，发过头会有酸味。，注意火候。",
      "visual_cue": "体积变大，手指留坑，状态稳定"
    },
    {
      "n": 3,
      "text": "洋葱切丝，用橄榄油小火炒十五分钟到焦糖色。",
      "time_min": 16,
      "heat": "小火",
      "tip": "洋葱炒透出甜味，馅才不水。，注意火候。",
      "visual_cue": "洋葱发褐，甜香明显，状态稳定"
    },
    {
      "n": 4,
      "text": "加番茄丁炒到出汁收干，再放金枪鱼和红椒粉炒匀。",
      "time_min": 6,
      "heat": "中火",
      "tip": "馅必须炒干，湿馅会把饼底泡软。，注意火候。",
      "visual_cue": "馅料干爽，无积水，状态稳定"
    },
    {
      "n": 5,
      "text": "面团分成两份，二比一大小，大份擀成烤盘大小的圆片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擀得比烤盘略大，边缘才好收口。，注意火候。",
      "visual_cue": "面皮匀薄，边缘整齐，状态稳定"
    },
    {
      "n": 6,
      "text": "铺在抹油的烤盘上，把馅料均匀铺开留出两厘米边。",
      "time_min": 5,
      "heat": "无火",
      "tip": "边上留白，封口时才粘得牢。，注意火候。",
      "visual_cue": "馅料铺平，边缘干净，状态稳定"
    },
    {
      "n": 7,
      "text": "盖上小份擀开的面皮，边缘卷起捏紧后用叉子压出花纹。",
      "time_min": 8,
      "heat": "无火",
      "tip": "封口要压实，烤的时候馅汁才不会流。",
      "visual_cue": "边缘紧密，花纹清晰，状态稳定"
    },
    {
      "n": 8,
      "text": "表面刷一层蛋液，用叉子扎几个小孔，两百度烤三十五分钟。",
      "time_min": 35,
      "heat": "-",
      "tip": "扎孔让蒸汽散出，饼皮才不会鼓裂。，注意火候。",
      "visual_cue": "表面金黄，饼体饱满，状态稳定"
    }
  ],
  "tips": [
    "馅料炒得越干越好，饼底才不软塌。，值得留意。",
    "边缘留白两厘米，封口才粘得牢。，值得留意。",
    "表面扎几个孔，烤的时候才不鼓裂。，值得留意。"
  ],
  "common_mistakes": [
    "馅带汁就铺，烤完饼底一片湿。，务必避免。",
    "封口没压实，进烤箱馅汁全流出来。，务必避免。",
    "不刷蛋液，成品表面干白发硬。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "金枪鱼",
      "substitute": "沙丁鱼",
      "ratio": "200 克:200 克",
      "note": "风味更浓，盐可略减。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "90 克:75 毫升",
      "note": "面团略硬，可多加二十毫升水。"
    }
  ],
  "variations": [
    "加一把青椒丝同炒，风味更清。，也很受欢迎。",
    "做成小圆饼形状，方便当手食。，也很受欢迎。"
  ],
  "serving_suggestion": "趁温热切块吃，配一杯啤酒或气泡水最合适。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤八分钟。",
