          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 150,
          "unit": "g",
          "note": "熬糖浆",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "取皮屑",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "肉桂粉",
          "name_en": "ground cinnamon",
          "amount": 4,
          "unit": "g",
          "note": "表面撒粉",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 80,
          "unit": "ml",
          "note": "熬糖浆",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小汤锅",
    "打蛋器",
    "布丁模",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜去皮切块蒸二十分钟，压成细腻的泥，铺在布丁模底部。",
      "time_min": 20,
      "heat": "中火",
      "tip": "南瓜泥要压到完全没有颗粒，蒸出的切面才会细致顺滑。",
      "visual_cue": "南瓜泥呈浓稠膏状，颜色橙亮"
    },
    {
      "n": 2,
      "text": "白糖加清水入小锅，中火煮到糖完全溶解且微微冒泡。",
      "time_min": 8,
      "heat": "中火",
      "tip": "糖只煮到完全化开，颜色转黄就成焦糖，风味会全变。",
      "visual_cue": "糖浆清澈透明，锅边起细小气泡"
    },
    {
      "n": 3,
      "text": "糖浆离火放凉到不烫手，慢慢倒进蛋黄里搅匀，加柠檬皮屑。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糖浆太烫会把蛋黄烫熟结块，一定要放凉。",
      "visual_cue": "蛋黄糊细腻无颗粒，表面浮细密泡沫"
    },
    {
      "n": 4,
      "text": "蛋黄糊过筛后慢慢倒在南瓜泥上，撇掉表面浮沫再蒸。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛能去掉蛋黄糊里的系带，成品切面才光洁没有白丝。",
      "visual_cue": "液面平整光滑，没有明显气泡"
    },
    {
      "n": 5,
      "text": "蒸锅水开后转小火，模具盖锡纸蒸三十五分钟到凝固。",
      "time_min": 35,
      "heat": "小火",
      "tip": "全程小火慢蒸，火一大蛋黄糊内部就会起蜂窝孔洞。",
      "visual_cue": "轻晃模具中心微微颤动，不流动"
    },
    {
      "n": 6,
      "text": "放凉后冷藏两小时定型，脱模撒上肉桂粉即可切块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "一定要凉透再脱模，热的时候容易碎。",
      "visual_cue": "切面细腻光滑，橙黄与米白分层"
    }
  ],
  "tips": [
    "蒸的时候锅盖留一条缝，蒸汽不会滴到表面。",
    "南瓜选粉质的贝贝品种，泥更干不易出水。",
    "糖浆用量按蛋黄重量的一半，成品才够挺。",
    "冷藏一夜后风味最好，切块也更利落。"
  ],
  "common_mistakes": [
    "糖浆没放凉就冲进蛋黄，蛋黄糊结成蛋花颗粒。",
    "蒸的时候火太大，成品内部全是蜂窝孔洞。",
    "没盖锡纸，蒸汽滴落把表面冲出一片坑洼。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "420克:420克",
      "note": "甜度更高，糖可减二十克。"
    },
    {
      "original": "柠檬",
      "substitute": "橙子",
      "ratio": "30克:40克",
      "note": "果香更柔和，适合儿童口味。"
    }
  ],
  "variations": [
    "不加南瓜，纯蛋糖浆蒸成经典的金黄布丁切块。",
    "南瓜泥里拌少量肉桂与姜粉，风味更像秋冬点心。"
  ],
  "serving_suggestion": "切块冷食，配一杯甜雪利酒或黑咖啡，是很传统的收尾甜点。",
  "storage": "冷藏可存三天，须密封保存，表面盖保鲜膜防结皮。",
