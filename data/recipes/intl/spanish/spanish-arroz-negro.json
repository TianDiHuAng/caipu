  "equipment": [
    "平底浅锅",
    "木勺",
    "砧板",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "高汤加热到边缘微沸，放入藏红花泡出金色备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "汤必须是热的，冷汤下锅米粒会骤缩，煮不匀。",
      "visual_cue": "汤色金红，红花舒展开"
    },
    {
      "n": 2,
      "text": "浅锅倒橄榄油，下鱿鱼丁中火煎到边缘卷起发白。",
      "time_min": 6,
      "heat": "中火",
      "tip": "鱿鱼先煎出水分再炖，香气比直接下汤浓得多。",
      "visual_cue": "鱿鱼卷边，锅底渗出汁水"
    },
    {
      "n": 3,
      "text": "加洋葱末与蒜末炒出香味，再下甜椒丁炒到发软，撒一半盐。",
      "time_min": 6,
      "heat": "中火",
      "tip": "甜椒要炒到发软出甜味，硬着下汤会冲淡整体味道。",
      "visual_cue": "洋葱透明，甜椒丁炒软"
    },
    {
      "n": 4,
      "text": "倒入番茄泥炒到冒红油，颜色变深、水分收紧。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄泥要炒干水汽，这一步叫 sofrito，是西班牙菜的底味。",
      "visual_cue": "油色红亮，每粒米都裹匀"
    },
    {
      "n": 5,
      "text": "下大米翻炒两分钟，让每一粒米都均匀裹上一层油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "米炒过再煮才不粘，粒粒分明是这道饭的基本要求。",
      "visual_cue": "米粒透亮，表面裹油发亮"
    },
    {
      "n": 6,
      "text": "墨鱼汁用少量热汤化开，倒进锅里与米拌匀上色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "墨鱼汁先化开再倒，直接挤会结块，颜色也不匀。",
      "visual_cue": "米粒通体发黑，汁色均匀"
    },
    {
      "n": 7,
      "text": "倒入剩余热汤把米铺平，中火煮十分钟，全程不搅动。",
      "time_min": 12,
      "heat": "中火",
      "tip": "下汤后千万别搅，一搅米粒出淀粉，整锅变成糊。",
      "visual_cue": "汤面冒小泡，米粒鼓起"
    },
    {
      "n": 8,
      "text": "把虾仁摆在饭面上，转小火再焖八分钟到汤基本收干。",
      "time_min": 9,
      "heat": "小火",
      "tip": "虾仁最后放，早放会煮老，口感像橡皮。",
      "visual_cue": "汤汁收干，虾仁转粉红"
    },
    {
      "n": 9,
      "text": "关火后盖一块干布静置五分钟，撒欧芹配柠檬角上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置能让锅底结一层焦香锅巴，那是这道饭的精华。",
      "visual_cue": "锅底结薄壳，饭面干爽"
    }
  ],
  "tips": [
    "墨鱼汁饭是瓦伦西亚海岸的做法，和海鲜饭同锅同米，只是多了墨汁。",
    "吃之前挤柠檬汁，酸味能把墨汁的腥压下去。",
    "锅底那层焦壳叫 socarrat，懂行的人抢着吃。"
  ],
  "common_mistakes": [
    "汤是冷的直接倒进锅，米粒外烂内生，怎么煮都不匀。",
    "中途反复搅动，淀粉全出来，饭变成一锅黑糊。",
    "墨鱼汁挤多了，整锅发苦，盖住海鲜的鲜甜。"
  ],
  "substitutions": [
    {
      "original": "墨鱼汁",
      "substitute": "鱿鱼",
      "ratio": "12克:增加100克",
      "note": "不加墨汁就是白色海鲜饭，鲜味一样在。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "900毫升:900毫升",
      "note": "清水版鲜度弱，需补一勺盐和几片香叶。"
    }
  ],
  "variations": [
    "加几只青口同煮，贝类开口后鲜汁渗进饭里，味道更足。",
    "最后淋一勺蒜香蛋黄酱，是北部餐厅的吃法。"
  ],
  "serving_suggestion": "连锅端上桌，配柠檬角和一勺蒜香蛋黄酱，趁热分食。",
  "storage": "冷藏可存一天，复热时加少量高汤小火焖五分钟。",
