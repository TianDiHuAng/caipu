      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 450,
          "unit": "g",
          "note": "老豆腐，切方块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 30,
          "unit": "g",
          "note": "切薄片",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 10,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 100,
          "unit": "ml",
          "note": "蒜香油",
          "optional": false
        },
        {
          "name": "红椒粉",
          "name_en": "paprika",
          "amount": 3,
          "unit": "g",
          "note": "甜椒粉",
          "optional": false
        },
        {
          "name": "白葡萄酒",
          "name_en": "dry white wine",
          "amount": 50,
          "unit": "ml",
          "note": "干白",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "厨房纸",
    "蒜压",
    "浅盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切两厘米方块，用厨房纸反复按压吸干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水分按不干，下锅就粘，一翻面全碎在锅里。",
      "visual_cue": "表面干爽，按不出水光"
    },
    {
      "n": 2,
      "text": "豆腐块两面薄薄撒上盐与黑胡椒，静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先撒盐出水，再吸一次，煎出来更脆。",
      "visual_cue": "表面泛盐花，边缘干爽"
    },
    {
      "n": 3,
      "text": "平底锅倒入一半橄榄油，中火把豆腐两面煎到金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "下锅后两分钟不要动，等表面定型再翻，才不掉皮。",
      "visual_cue": "底面金黄，边缘结起薄壳"
    },
    {
      "n": 4,
      "text": "翻面再煎三分钟，盛出放在厨房纸上把油沥干。",
      "time_min": 4,
      "heat": "中火",
      "tip": "煎好先沥一遍油，等下淋蒜油才不会腻。",
      "visual_cue": "两面金黄，纸上吸出油痕"
    },
    {
      "n": 5,
      "text": "锅里倒入剩下的橄榄油，转小火下蒜片慢慢煎。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蒜片要冷油下锅慢煎，一下锅就焦的油会发苦。",
      "visual_cue": "蒜片浮起，油面细泡密"
    },
    {
      "n": 6,
      "text": "加红椒粉与白葡萄酒，小火煮到酒气完全散尽。",
      "time_min": 4,
      "heat": "小火",
      "tip": "红椒粉遇油就出颜色，别在火上久炒，容易发苦。",
      "visual_cue": "油色橙红，酒气基本烧尽"
    },
    {
      "n": 7,
      "text": "撒欧芹碎，直接连锅端上桌，配烤面点片蘸油吃。",
      "time_min": 3,
      "heat": "小火",
      "tip": "锅里剩下的蒜香油别浪费，撕块面点蘸着吃最好。",
      "visual_cue": "豆腐裹油，蒜片贴上面"
    },
    {
      "n": 8,
      "text": "撒欧芹碎，直接连锅端上桌，配烤面点片蘸油吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "锅里剩下的蒜香油别浪费，撕块面点蘸着吃最好。",
      "visual_cue": "香草翠绿，锅里油光流亮"
    }
  ],
  "tips": [
    "蒜香做法在西班牙多用来做虾，换成豆腐一样下酒。",
    "橄榄油要放足，这道菜靠油当酱汁。",
    "蒜片别煎过火，微黄就够，焦了整锅发苦。"
  ],
  "common_mistakes": [
    "豆腐没吸干水就下锅，粘锅翻面全碎。",
    "蒜片用大火煎，几秒就发黑，油味发苦。",
    "橄榄油放太少，豆腐干巴巴裹不上味。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "白豆",
      "ratio": "450克:400克",
      "note": "煮软的白豆吸油更狠，蒜香味更浓，但口感软。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "白醋",
      "ratio": "50毫升:10毫升",
      "note": "醋版酸味突出，适合配油炸食物解腻。"
    }
  ],
  "variations": [
    "加几只虾仁一起煎，油里多一层海鲜的甜。",
    "切几片腊肠同煎，红油把豆腐染成橙红色，最下酒。"
  ],
  "serving_suggestion": "连锅端上桌，配烤面点片和一杯冰镇的干白。",
  "storage": "冷藏可存两天，复热用平底锅小火两面回煎，别用微波炉。",
