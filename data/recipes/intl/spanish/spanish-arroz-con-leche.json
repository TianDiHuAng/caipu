        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米用清水淘洗两遍，沥干后倒进厚底汤锅里。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用短粒米淀粉足，煮出来才浓稠挂勺。",
      "visual_cue": "米粒洗净，锅底铺平"
    },
    {
      "n": 2,
      "text": "柠檬用盐搓洗外皮，削下几片黄色表皮不要白瓤。",
      "time_min": 6,
      "heat": "无火",
      "tip": "只取黄色表皮，带白瓤整锅会发苦。",
      "visual_cue": "柠檬皮薄片，无白瓤"
    },
    {
      "n": 3,
      "text": "锅里倒六百毫升牛奶，加柠檬皮和桂皮，中火煮到微沸。",
      "time_min": 6,
      "heat": "中火",
      "tip": "牛奶微沸就转小火，滚沸容易溢锅。",
      "visual_cue": "奶面冒小泡，香气散出"
    },
    {
      "n": 4,
      "text": "转小火慢慢煮十五分钟，边煮边用木勺不停搅动防粘底。",
      "time_min": 15,
      "heat": "小火",
      "tip": "全程小火勤搅，米粒才不粘锅底发焦。",
      "visual_cue": "米粒膨胀，奶汁变稠"
    },
    {
      "n": 5,
      "text": "分两次倒入剩余牛奶，每次都搅匀煮到米粒完全软烂。",
      "time_min": 12,
      "heat": "小火",
      "tip": "牛奶分次加，米粒吸水均匀不夹生。",
      "visual_cue": "米粒软烂，奶汁浓稠"
    },
    {
      "n": 6,
      "text": "加白糖和盐搅到化开，再煮三分钟收浓到能挂住木勺。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖最后才放，早放米粒不容易煮到软烂。",
      "visual_cue": "布丁浓稠，挂勺成线"
    },
    {
      "n": 7,
      "text": "盛入碗中撒少许桂皮粉，放凉后冷藏两小时再吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冷藏后质地更凝固，风味也更融合。",
      "visual_cue": "表面平滑，撒粉均匀"
    }
  ],
  "tips": [
    "用短粒米来煮，淀粉足才有浓稠感。",
    "柠檬只削黄色表皮，带上白瓤会发苦。",
    "全程小火勤搅动，米粒才不会粘锅底。"
  ],
  "common_mistakes": [
    "牛奶一次全倒入，米粒外层糊内心还硬。",
    "大火煮又不搅拌，锅底结出焦黑的一层。",
    "糖一开始就放进去，米粒久煮也不软烂。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "豆奶",
      "ratio": "900 毫升:900 毫升",
      "note": "素版，糖加十克补味。"
    },
    {
      "original": "柠檬",
      "substitute": "橙子",
      "ratio": "60 克:70 克",
      "note": "香气更甜，桂皮减一克。"
    }
  ],
  "variations": [
    "表面撒白糖烤成焦壳，做成焦糖版本。",
    "加一把葡萄干同煮，甜味层次更丰富一点。"
  ],
  "serving_suggestion": "冷藏后盛小碗，撒桂皮粉，配一杯咖啡正好。",
  "storage": "冷藏两天，食用前搅匀，勿常温久放。",
