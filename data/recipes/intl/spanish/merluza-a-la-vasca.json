  "equipment": [
    "平底锅",
    "汤勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛤蜊 300g 提前用淡盐水泡 1 小时吐沙，中途换水两次，洗净沥干。",
      "time_min": 65,
      "heat": "无火",
      "tip": "吐沙不干净会毁掉整锅汤。",
      "visual_cue": "蛤蜊壳净、水底无沙粒"
    },
    {
      "n": 2,
      "text": "鳕鱼 600g 吸干水分，两面抹 4g 盐，静置 15 分钟逼出多余水汽。",
      "time_min": 16,
      "heat": "无火",
      "tip": "腌出水后煎制才不粘锅。",
      "visual_cue": "鱼片表面干爽、肉质紧实"
    },
    {
      "n": 3,
      "text": "平底锅倒 40ml 橄榄油烧热，中火下洋葱碎与蒜末炒 4 分钟至软透。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透，汤底才甜。",
      "visual_cue": "洋葱透明、蒜香散出"
    },
    {
      "n": 4,
      "text": "撒入 20g 面粉炒 1 分钟至无干粉，倒入 80ml 白葡萄酒和 200ml 清水煮开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "面粉炒散，汤汁才不结块。",
      "visual_cue": "汤汁微稠、无面粉颗粒"
    },
    {
      "n": 5,
      "text": "放入鳕鱼片小火浸煮 6 分钟，再放蛤蜊加盖煮 4 分钟至全部开口。",
      "time_min": 12,
      "heat": "小火",
      "tip": "小火浸煮，鱼肉才嫩而不散。",
      "visual_cue": "蛤蜊张口、鱼肉分层发白"
    },
    {
      "n": 6,
      "text": "加盐调好咸淡后撒香菜碎，连汤汁一起盛入浅盘上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "只要蛤蜊没开口就丢掉。",
      "visual_cue": "汤汁乳白微稠、香菜翠绿"
    }
  ],
  "tips": [
    "蛤蜊必须彻底吐沙，汤里带沙就全毁了。",
    "鳕鱼用小火浸煮，大火会把鱼肉冲散。",
    "面粉先炒散再加水，汤汁才细腻不结块。"
  ],
  "common_mistakes": [
    "蛤蜊没泡透直接下锅，汤底带沙颗粒。",
    "大火滚煮鱼片，鱼肉碎裂成渣捞不起来。",
    "面粉直接撒进汤里，结成一团团面疙瘩。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "比目鱼",
      "ratio": "600g 对 600g",
      "note": "肉质更软，浸煮时间减 2 分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "白醋",
      "ratio": "80ml 对 20ml 加 60ml 水",
      "note": "酸度更高，需补 3g 糖。"
    }
  ],
  "variations": [
    "海鲜综合版：加 200g 虾仁同煮。",
    "浓汤版：面粉加到 30g，汤汁更厚。"
  ],
  "serving_suggestion": "用浅盘盛装，浇上汤汁，配面包蘸食。",
  "storage": "现做现吃，冷藏后再热鱼肉会变柴。",
