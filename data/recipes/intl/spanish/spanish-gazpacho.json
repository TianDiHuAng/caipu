  "equipment": [
    "搅拌机",
    "滤网",
    "削皮刀",
    "冷藏碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄底部划十字，用沸水烫三十秒后撕去表皮切块；黄瓜削去部分表皮保留少许绿色，彩椒去籽切块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "番茄去皮后汤体更细腻，颜色也更纯净。",
      "visual_cue": "番茄块表面无白皮，切面多汁"
    },
    {
      "n": 2,
      "text": "面包撕成小块，用少量清水浸软挤去多余水分，与大蒜一起放入搅拌杯，作为汤体的天然增稠剂。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面包只取内芯，外皮带有硬壳会留下颗粒感。",
      "visual_cue": "面包块吸足水后呈湿润海绵状"
    },
    {
      "n": 3,
      "text": "把番茄、黄瓜、彩椒、泡软的面包与大蒜一同高速搅打成完全顺滑的泥状，中途停机刮一次杯壁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "想要细腻口感可延长搅打时间，中途停机让颗粒重新落入刀头。",
      "visual_cue": "汤体流动细腻，看不到明显颗粒"
    },
    {
      "n": 4,
      "text": "边搅打边缓缓淋入橄榄油，让油脂与汤体乳化成顺滑质地，再加苹果醋、盐与黑胡椒调出酸咸平衡的味道。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油要细流慢加，一次性倒入容易油水分离。",
      "visual_cue": "汤色由亮红转成柔和的橙红，质地浓稠挂勺"
    },
    {
      "n": 5,
      "text": "倒入清水调节到能流动的稠度，密封冷藏至少两小时，食用前尝味补盐，盛碗可配黄瓜丁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷藏后再调味更准确，低温会让咸味和酸味感受变弱。",
      "visual_cue": "汤面泛着细密油花，入口冰凉清爽"
    }
  ],
  "tips": [
    "所有食材尽量选成熟度高、甜味足的，冷汤没有加热过程，原料的味道会被完整呈现。",
    "冷藏时用保鲜膜贴面覆盖，避免表面氧化发暗。"
  ],
  "common_mistakes": [
    "用不粘锅加热后再冷藏，加热会破坏番茄的清鲜果香，冷汤应全程不加热。",
    "橄榄油一次性倒入搅拌杯，导致汤体浮起一层油而无法乳化。"
  ],
  "substitutions": [
    {
      "original": "苹果醋",
      "substitute": "红酒醋",
      "ratio": "15ml 对 15ml",
      "note": "酸度接近，果香略有不同。"
    },
    {
      "original": "面包",
      "substitute": "土豆",
      "ratio": "60g 对 60g",
      "note": "土豆需先煮熟再打，增稠效果相近。"
    }
  ],
  "variations": [
    "加入少量西瓜瓤，做成更甜润的夏季版本。",
    "过滤一遍汤体，得到口感更轻盈的高级餐厅版本。"
  ],
  "serving_suggestion": "冰镇后作为夏季开胃汤，配烤面包丁与淋橄榄油上桌。",
  "storage": "密封冷藏可存两天，饮用前摇匀；不建议冷冻，解冻后质地会分离。",
