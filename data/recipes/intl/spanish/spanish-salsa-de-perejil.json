        }
      ]
    }
  ],
  "equipment": [
    "料理机",
    "砧板",
    "密封瓶",
    "量勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "欧芹摘叶去粗梗，洗净后彻底沥干水分，用厨房纸吸一遍。",
      "time_min": 8,
      "heat": "无火",
      "tip": "带水的欧芹打出来的酱容易发黑变质。",
      "visual_cue": "叶片干爽无水滴，梗部全部摘净"
    },
    {
      "n": 2,
      "text": "大蒜去皮切厚片，用刀背压一下让香味更容易散出。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜芯如果发绿要挑掉，不去掉成品会有明显苦味。",
      "visual_cue": "蒜片压出细纹，香气明显上扬"
    },
    {
      "n": 3,
      "text": "料理机里放欧芹与大蒜，先加一半橄榄油打成粗糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先少加油打碎，再补油才不容易分离。",
      "visual_cue": "混合物呈深绿色粗粒状态"
    },
    {
      "n": 4,
      "text": "补入剩余橄榄油与白醋，继续打三十秒到顺滑。",
      "time_min": 3,
      "heat": "无火",
      "tip": "醋能让绿色更稳定，不加的话很快发暗。",
      "visual_cue": "酱体顺滑流动，颜色鲜亮翠绿"
    },
    {
      "n": 5,
      "text": "加盐与黑胡椒调味，装进玻璃瓶冷藏静置一小时再用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置能让蒜味渗出，辛辣感也会变柔。",
      "visual_cue": "油层浮在上方，绿色酱体沉在底部"
    }
  ],
  "tips": [
    "这酱最适合配烤鱼、白灼海鲜和煮土豆，味道清爽。",
    "多做可以冷冻成小块，用时取一两块直接融化。",
    "欧芹换成一半香菜一半欧芹，风味更有层次。",
    "取用前先摇匀，油与酱体分层是正常现象。"
  ],
  "common_mistakes": [
    "欧芹没沥干就下料理机，酱汁发稀并很快变暗。",
    "大蒜用量过多，成品辛辣刺鼻盖住草本清香。",
    "全程高速长时间打，油温升高导致酱体分离。"
  ],
  "substitutions": [
    {
      "original": "白醋",
      "substitute": "柠檬",
      "ratio": "20毫升:25克",
      "note": "柠檬汁更清亮，酸味更柔和。"
    },
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "240克:200克",
      "note": "气味更冲，适合配烤肉。"
    }
  ],
  "variations": [
    "加一小勺烤过的甜椒碎，做成带颗粒感的红绿双色酱。",
    "把橄榄油换成一半黄油加热融化后再打，凉后呈膏状好抹。"
  ],
  "serving_suggestion": "配煎鱼排、烤鸡或水煮土豆，浇一勺就能把整道菜提亮。",
  "storage": "冷藏可存五天，表面淋油封住，冷冻三个月风味基本不变。",
