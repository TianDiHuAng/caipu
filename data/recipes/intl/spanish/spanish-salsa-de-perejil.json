          "name_en": "olive oil",
          "amount": 160,
          "unit": "ml",
          "note": "分次加入",
          "optional": false
        },
        {
          "name": "白醋",
          "name_en": "white vinegar",
          "amount": 20,
          "unit": "ml",
          "note": "提酸",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
