  "equipment": [
    "铸铁锅",
    "刀",
    "砧板",
    "夹子",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼去内脏和软骨，撕掉表皮冲洗干净。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表皮撕掉，口感才不韧。，看准状态再往下做。",
      "visual_cue": "鱼身洁白，无杂质，这点要注意。"
    },
    {
      "n": 2,
      "text": "鱿鱼身切成长条，触手整只保留。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切条别太细，煎了会缩。，看准状态再往下做。",
      "visual_cue": "条宽均匀，触手完整"
    },
    {
      "n": 3,
      "text": "用厨房纸把鱿鱼表面水分彻底吸干。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "有水就煎不出焦香，只会出水。，看准状态再往下做。",
      "visual_cue": "表面干爽，纸巾不粘"
    },
    {
      "n": 4,
      "text": "铸铁锅大火烧到冒烟，倒橄榄油晃匀。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "锅要够热，鱿鱼才瞬间封住汁。，看准状态再往下做。",
      "visual_cue": "锅面泛烟，油纹流动"
    },
    {
      "n": 5,
      "text": "鱿鱼下锅铺平，不要翻动煎两分钟。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "别急着翻，等它自己脱锅。，看准状态再往下做。",
      "visual_cue": "底面焦褐，边缘卷起"
    },
    {
      "n": 6,
      "text": "翻面再煎一分半，撒盐和黑胡椒。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "第二面时间短，肉才不老。，看准状态再往下做。",
      "visual_cue": "两面焦香，肉质弹，这是关键点。"
    },
    {
      "n": 7,
      "text": "关火撒蒜片和欧芹碎，用余温激香。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火再放蒜，蒜才不苦。，看准状态再往下做。",
      "visual_cue": "蒜香散出，油面发亮"
    },
    {
      "n": 8,
      "text": "装盘撒红椒粉，挤柠檬汁即可。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬最后挤，酸香才鲜。，看准状态再往下做。",
      "visual_cue": "红粉点缀，柠檬翠黄"
    }
  ],
  "tips": [
    "鱿鱼一定要擦干，才能煎出焦香。，别嫌麻烦，做完它。",
    "锅要烧到冒烟再下料。，这一步别省。",
    "蒜片关火后放，避免焦苦。，别跳过这步。"
  ],
  "common_mistakes": [
    "鱿鱼带水下锅，煎出一锅水。，这步最关键。",
    "不停翻动，鲜味全流失。，很多人在这里出错。",
    "煎太久，肉质变橡皮。，这里最容易翻车。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "章鱼",
      "ratio": "600 克:600 克",
      "note": "需先煮四十分钟再煎。"
    },
    {
      "original": "柠檬",
      "substitute": "香醋",
      "ratio": "1 个:15 毫升",
      "note": "酸味更冲，用量减半。"
    }
  ],
  "variations": [
    "撒一点烟熏红椒粉，风味更浓。，别小看这一步。",
    "配一勺蒜香蛋黄酱，口感更润。，成败就在这一步。"
  ],
  "serving_suggestion": "配面包和一杯冰白葡萄酒。，这点要注意。",
  "storage": "当日吃完，复热锅煎一分钟。，这是关键点。",
