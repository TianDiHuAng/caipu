  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成半厘米厚的圆片，洋葱顺纹切成细丝备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "土豆片厚薄要一致，不然薄的那片早糊了。",
      "visual_cue": "圆片大小均匀，边缘不带芽眼"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油，中小火把土豆片与洋葱丝炒到变软透明。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "油要能没过锅底一层，土豆才煎得外软内粉。",
      "visual_cue": "土豆片边缘金黄，洋葱塌软出甜味"
    },
    {
      "n": 3,
      "text": "番茄丁下锅，中火炒到出汁变稠，加一半盐调底味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄汁水收浓一点，后面卧蛋才不会漫开。",
      "visual_cue": "锅底酱汁浓稠，番茄块化开大半"
    },
    {
      "n": 4,
      "text": "用勺子在锅里压出四个小窝，把鸡蛋逐个磕进窝里。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "磕蛋前把火关小，蛋白才不会瞬间起大泡。",
      "visual_cue": "四个蛋液各自成形，蛋黄居中"
    },
    {
      "n": 5,
      "text": "加盖小火焖到蛋白完全凝固，撒盐、黑胡椒与欧芹碎出锅。",
      "time_min": 5,
      "heat": "小火",
      "tip": "焖的时候别掀盖，蒸汽跑掉蛋白就会发硬。",
      "visual_cue": "蛋白雪白不透明，蛋黄表面覆白膜"
    }
  ],
  "tips": [
    "用可入烤箱的平底锅，最后三分钟转上火烤，蛋白更嫩。",
    "土豆提前用水泡五分钟去表面淀粉，煎的时候不易糊锅。",
    "喜欢辣味可在番茄料里加一勺红椒粉，颜色和香气都更足。"
  ],
  "common_mistakes": [
    "火太大就卧蛋，蛋白底部焦黑、上面还是透明生液。",
    "土豆切得太厚，外面焦了里面还是硬芯，咬着发涩。",
    "番茄没炒出汁就把蛋打进去，蛋液和番茄水混成一锅汤。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "面包",
      "ratio": "200克:120克",
      "note": "面包切丁用油煎脆，吸汁后口感更轻。"
    },
    {
      "original": "番茄",
      "substitute": "番茄",
      "ratio": "150克:150克",
      "note": "没有新鲜番茄可用一勺浓缩番茄酱代替。"
    }
  ],
  "variations": [
    "加五十克腊肠丁与土豆同炒，肉香渗进蛋里，是塞维利亚的街头版本。",
    "加一把青豆同焖，颜色更鲜亮，也顺带添了一分清甜。"
  ],
  "serving_suggestion": "连锅端上桌，配厚切烤面包蘸蛋黄吃，早餐或周末早午餐都合适。",
  "storage": "现做现吃最好，冷藏后蛋白会变韧，复热只回锅两分钟即可。",
