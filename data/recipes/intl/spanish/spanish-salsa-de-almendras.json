  "equipment": [
    "搅拌机",
    "平底锅",
    "刀",
    "砧板",
    "量杯",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "杏仁放进干锅小火烘四分钟，烘到边缘微微发黄、香气散出。",
      "time_min": 5,
      "heat": "小火",
      "tip": "烘过的杏仁香气浓一倍，但一焦就发苦。",
      "visual_cue": "杏仁微黄，香气明显"
    },
    {
      "n": 2,
      "text": "隔夜白面包撕成小块，泡进两勺高汤里软化备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面包能帮酱汁乳化，缺了会分层。",
      "visual_cue": "面包吸汤变软，无干块"
    },
    {
      "n": 3,
      "text": "杏仁与大蒜放进搅拌机打成细粉，中途刮一次杯壁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打到粉状再加别的，颗粒才均匀。",
      "visual_cue": "杏仁成细粉，无大颗粒"
    },
    {
      "n": 4,
      "text": "加泡软的面包、欧芹与红椒粉，点动打二十秒成粗泥。",
      "time_min": 2,
      "heat": "无火",
      "tip": "点动打，别让机器发热把油逼出来。",
      "visual_cue": "混合物成稠泥，色浅褐"
    },
    {
      "n": 5,
      "text": "分三次淋入橄榄油，每次打十秒再加下一次。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油慢慢加，酱才乳化得细腻。",
      "visual_cue": "酱体顺滑，油被吸收"
    },
    {
      "n": 6,
      "text": "倒入剩余高汤调稀，加盐、黑胡椒与柠檬汁调味。",
      "time_min": 4,
      "heat": "无火",
      "tip": "稀稠以能挂勺又能流动为准。",
      "visual_cue": "酱汁流动，能挂住勺背"
    },
    {
      "n": 7,
      "text": "尝味补齐咸酸，装碗后用欧芹碎与红椒粉点缀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁一点点加，酸过头就救不回来。",
      "visual_cue": "表面点缀红绿，光泽柔和"
    }
  ],
  "tips": [
    "杏仁去皮后颜色更浅，卖相也更接近原版。",
    "这款酱配烤鱼、白灼蔬菜或水煮土豆都好。",
    "高汤换成清水也行，但鲜味会淡一些。",
    "做好后冷藏静置两小时，味道更融合。"
  ],
  "common_mistakes": [
    "杏仁烘过头，整碗酱都带焦苦味。",
    "油一次全倒进去，酱体分层浮起一层油。",
    "面包省略不放，酱汁稀薄且容易分离。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "榛子",
      "ratio": "150克:150克",
      "note": "香气更浓，适合配烤肉。"
    },
    {
      "original": "面包",
      "substitute": "面粉",
      "ratio": "60克:25克",
      "note": "需先用高汤煮成糊再打。"
    }
  ],
  "variations": [
    "加一个烤过的番茄同打，酸味更足，适合配蔬菜。",
    "加一小撮藏红花，做成节庆版本的香浓酱汁。"
  ],
  "serving_suggestion": "三人份酱料，配烤鱼、烤肉或水煮蔬菜，也可作为面包蘸酱。",
  "storage": "冷藏三天内吃完，表面覆一层油隔绝空气；出现酸味须整碗弃用。",
