  "equipment": [
    "平底浅锅",
    "木铲",
    "汤勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米 320g 淘洗两遍后沥干，摊在盘里晾 10 分钟至表面干爽。",
      "time_min": 12,
      "heat": "无火",
      "tip": "米粒干爽，炒的时候才不粘。",
      "visual_cue": "米粒松散、表面无水"
    },
    {
      "n": 2,
      "text": "鱿鱼 300g 去膜切圈，用厨房纸吸干水分，撒 2g 盐抓匀腌 10 分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "擦干再炒，鱿鱼才不出水。",
      "visual_cue": "鱿鱼圈干爽、略有弹性"
    },
    {
      "n": 3,
      "text": "平底浅锅倒 40ml 橄榄油烧热，下洋葱碎中火炒 4 分钟至透明，加蒜末炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透，底味才甜。",
      "visual_cue": "洋葱透明、蒜末微黄"
    },
    {
      "n": 4,
      "text": "放入鱿鱼圈大火翻炒 2 分钟至卷曲变色，再倒入大米炒 3 分钟至米粒裹油。",
      "time_min": 6,
      "heat": "大火",
      "tip": "米粒炒到透亮，吸汤才均匀。",
      "visual_cue": "米粒泛油光、边缘半透明"
    },
    {
      "n": 5,
      "text": "加入番茄泥与 15g 墨鱼汁炒匀，倒入 800ml 热水，加剩余 4g 盐搅开后转小火。",
      "time_min": 5,
      "heat": "中火",
      "tip": "墨鱼汁要提前化开，避免结块。",
      "visual_cue": "汤汁墨黑、米粒均匀上色"
    },
    {
      "n": 6,
      "text": "小火煮 18 分钟不翻动，至汤汁收干，关火盖布焖 5 分钟，配柠檬角上桌。",
      "time_min": 24,
      "heat": "小火",
      "tip": "煮时别搅，锅底才有焦香锅巴。",
      "visual_cue": "汤汁收干、锅底结成薄脆锅巴"
    }
  ],
  "tips": [
    "米粒先炒到裹油，吸汤才均匀入味。",
    "煮的过程不要搅动，锅底才能结出脆锅巴。",
    "墨鱼汁先用热水化开再倒入，避免结块。"
  ],
  "common_mistakes": [
    "鱿鱼带水下锅，锅里出水变成煮鱿鱼。",
    "煮饭时频繁搅动，米粒破碎成糊。",
    "墨鱼汁直接挤入锅，结块沉底搅不开。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "虾仁",
      "ratio": "300g 对 300g",
      "note": "炒制时间缩到 2 分钟。"
    },
    {
      "original": "大米",
      "substitute": "烩饭米",
      "ratio": "320g 对 320g",
      "note": "吸水量更大，热水加到 900ml。"
    }
  ],
  "variations": [
    "海鲜版：加 200g 蛤蜊与鱿鱼同煮。",
    "蛋黄酱版：配一碟蒜香蛋黄酱同食。"
  ],
  "serving_suggestion": "连锅上桌，配柠檬角挤汁，一人一盘分食。",
  "storage": "现做现吃，冷藏后再热锅巴会软掉。",
