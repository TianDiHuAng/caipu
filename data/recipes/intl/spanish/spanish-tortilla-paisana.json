  "equipment": [
    "不粘锅",
    "打蛋盆",
    "刀",
    "砧板",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆削皮切成一厘米见方的小丁，泡在清水里冲掉表面的浆水，捞出用布擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擦干再下锅才不会溅油，表面浆水去净也更不容易粘锅底。",
      "visual_cue": "土豆丁干爽，切口整齐"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油，中小火下土豆丁，慢煎十分钟到软而不上色，用漏勺捞出沥油。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "土豆要煎软不要煎脆，脆了蛋饼就合不起来。",
      "visual_cue": "土豆丁微软，筷子能扎透"
    },
    {
      "n": 3,
      "text": "锅里留两勺油，下洋葱丝炒到透明发甜，再加青椒丁与蒜末炒两分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到透明甜味才出来，别急着上色。",
      "visual_cue": "洋葱变软透明，青椒颜色转深"
    },
    {
      "n": 4,
      "text": "鸡蛋磕进大盆，加盐与黑胡椒打散，倒入沥好油的土豆丁，轻轻拌到每块都裹上蛋液。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌的时候别搅碎土豆，块状口感才是乡村蛋饼的灵魂。",
      "visual_cue": "蛋液里均匀分布土豆丁"
    },
    {
      "n": 5,
      "text": "把蛋液土豆倒回锅里，先静置半分钟等底部定型，再用铲子把边缘往中间推压出圆边。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "边缘往里推能让蛋饼外高内低，翻面时不容易散。",
      "visual_cue": "蛋饼边缘成型，成为厚圆饼"
    },
    {
      "n": 6,
      "text": "保持中小火煎四分钟，盖盖焖三分钟让中心慢慢凝固，别急着翻动。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "盖盖能让上层靠蒸汽凝固，翻面时就不怕漏生蛋液。",
      "visual_cue": "表面七成凝固，晃锅时能整体移动"
    },
    {
      "n": 7,
      "text": "用一个大盘子扣在锅上，一手压盘一手翻锅，把蛋饼倒到盘里再滑回锅中煎另一面。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "盘子要大于锅口，动作一次到位，犹豫就容易破。",
      "visual_cue": "蛋饼完整翻转，未破裂"
    },
    {
      "n": 8,
      "text": "另一面煎四分钟到金黄，出锅静置三分钟再切块，可热吃也可放凉当冷盘。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "静置让内部余温收尾，切的时候截面才平整好看。",
      "visual_cue": "两面金黄，切面紧密无流液"
    }
  ],
  "tips": [
    "土豆先煎软再拌蛋液，是西班牙蛋饼和普通煎蛋最大的区别。",
    "喜欢蛋液湿润就缩短一分钟，但要确保中心已无流动蛋液。",
    "橄榄油用量大是为了炸土豆，用后可过滤冷藏，下次继续用。",
    "放凉后夹在面包里吃，是西班牙酒吧常见的吃法。"
  ],
  "common_mistakes": [
    "土豆切好不擦干就下锅，油花四溅，蛋饼也带水气。",
    "大火煎到底面焦黑，中心却还是流动生蛋液。",
    "翻面时用铲子硬推，蛋饼从中间裂开，形状全毁。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "红甜椒",
      "ratio": "80克:80克",
      "note": "辣度为零，颜色更亮，甜味略高。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "350克:350克",
      "note": "甜味明显，煎制时间延长三分钟。"
    }
  ],
  "variations": [
    "加一把煮熟的青豆与火腿丁，做成更丰盛的版本。",
    "把橄榄油换成黄油，奶香更浓，但风味会更偏法式。"
  ],
  "serving_suggestion": "切成六块当作餐前小食或配一杯干红，也可以夹在面包片里当午餐。",
  "storage": "冷藏三天内吃完，复热用平底锅小火两面各煎两分钟；冷食风味也不错。",
