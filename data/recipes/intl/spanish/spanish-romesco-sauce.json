  "equipment": [
    "料理机",
    "平底锅",
    "烤盘",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄对半切开，大蒜带皮，干辣椒去籽后和杏仁一起摊在烤盘上，淋一勺橄榄油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜带皮烤才不焦，皮焦了里面的蒜瓣发苦，打出来的酱带焦味。",
      "visual_cue": "食材摊平不叠，表面裹油"
    },
    {
      "n": 2,
      "text": "烤箱两百度烤十五分钟，番茄边微焦、杏仁出香时取出。",
      "time_min": 15,
      "heat": "大火",
      "tip": "烤到番茄边缘起焦斑才够味，全程浅色烤出来的酱香味寡淡。",
      "visual_cue": "番茄边焦黑，杏仁金黄"
    },
    {
      "n": 3,
      "text": "面包撕成小块，用平底锅小火干烘到两面发脆，掰碎备用。",
      "time_min": 4,
      "heat": "小火",
      "tip": "面包是这道酱的稠度来源，烘脆了打出来才绵，不会稀。",
      "visual_cue": "面包两面焦黄，按着发脆有声"
    },
    {
      "n": 4,
      "text": "全部食材放进料理机，加红酒醋与盐，分次淋橄榄油打成粗酱。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打到带颗粒就停，打太细会变成糊，失去这道酱的粗粝口感。",
      "visual_cue": "酱体粗糙，能看见杏仁碎"
    },
    {
      "n": 5,
      "text": "尝味补盐或醋，盛出静置十分钟让味道融合再食用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刚打完味道是散的，静置一会儿蒜香和酸味才会合到一起。",
      "visual_cue": "酱色砖红，表面油光均匀发亮"
    }
  ],
  "tips": [
    "罗梅斯科酱出自西班牙加泰罗尼亚，配烤蔬菜和烤鱼最地道。",
    "用炭火烤番茄和蒜，多一层烟熏味，是传统做法里的关键。",
    "打好的酱表面淋一层橄榄油封住，能多存几天不返潮。"
  ],
  "common_mistakes": [
    "杏仁没烤直接打，酱带一股生豆味，怎么调味都压不住。",
    "大蒜烤到发黑还照用，整罐酱发苦，只能重做。",
    "橄榄油一次全倒进料理机，油水分离，酱打出来一层浮油。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "榛子",
      "ratio": "80克:80克",
      "note": "榛子需先烤去皮，风味更浓。"
    },
    {
      "original": "红酒醋",
      "substitute": "米醋",
      "ratio": "15毫升:15毫升",
      "note": "米醋柔和，酸度略低。"
    }
  ],
  "variations": [
    "加一个烤过的红椒同打，酱色更红，甜味也更足。",
    "用烤过的核桃替代一半杏仁，做成核桃版，口感更绵。"
  ],
  "serving_suggestion": "配烤芦笋、烤鱼或烤肉丸，也可当面包抹酱。",
  "storage": "装瓶冷藏可存一周，表面淋油封口，冷冻可存一个月。",
