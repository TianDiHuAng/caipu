  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "锅铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成滚刀块，用清水冲一遍沥干。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冲掉表面汁水，煎时才不粘。，看准状态再往下做。",
      "visual_cue": "块形均匀，表面干爽"
    },
    {
      "n": 2,
      "text": "土豆块放进碗里，撒面粉颠匀裹薄层。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "裹薄粉，炖的时候汤汁才挂住。，看准状态再往下做。",
      "visual_cue": "表面泛白，粉层薄，这里最容易翻车。"
    },
    {
      "n": 3,
      "text": "炒锅倒橄榄油，中火把土豆块煎到微黄。，看准状态再往下做。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煎出焦壳，炖后不易散。，看准状态再往下做。",
      "visual_cue": "表皮金黄，边缘起皱"
    },
    {
      "n": 4,
      "text": "盛出土豆，锅里下腊肠片小火煸出油。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "腊肠煸香，整锅味道的底子。，看准状态再往下做。",
      "visual_cue": "油脂透明，颜色变深"
    },
    {
      "n": 5,
      "text": "加洋葱丝和蒜片炒软，撒红椒粉炒匀。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "红椒粉遇油才出色，别炒糊。，看准状态再往下做。",
      "visual_cue": "油色红亮，香气冲鼻"
    },
    {
      "n": 6,
      "text": "倒白葡萄酒煮到酒气散尽。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酒气散掉，只留果香。，看准状态再往下做。",
      "visual_cue": "锅底微干，香气柔和"
    },
    {
      "n": 7,
      "text": "放回土豆，加清水和盐，小火炖二十分钟。，看准状态再往下做。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火慢炖，土豆才入味不烂。，看准状态再往下做。",
      "visual_cue": "汤汁减半，土豆完整"
    },
    {
      "n": 8,
      "text": "汤汁浓稠时撒欧芹碎，出锅装盘。，看准状态再往下做。",
      "time_min": 2,
      "heat": "小火",
      "tip": "汁收浓才挂得住土豆。，看准状态再往下做。",
      "visual_cue": "汁色红褐，油光发亮"
    }
  ],
  "tips": [
    "土豆裹薄面粉，炖后汤汁才挂住。，别小看这一步。",
    "先煎后炖，块形完整不散。，成败就在这一步。",
    "红椒粉遇油出色，注意别炒糊。，这点要注意。"
  ],
  "common_mistakes": [
    "土豆不煎直接炖，全化成泥。，这是关键点。",
    "红椒粉炒糊，整锅发苦。，别嫌麻烦，做完它。",
    "水加太多，炖成土豆汤。，这一步别省。"
  ],
  "substitutions": [
    {
      "original": "腊肠",
      "substitute": "培根",
      "ratio": "150 克:150 克",
      "note": "咸度更高，盐要减。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "清水",
      "ratio": "80 毫升:80 毫升",
      "note": "风味略淡，可多加红椒粉。"
    }
  ],
  "variations": [
    "加两个煎蛋，做成土豆配蛋。，别跳过这步。",
    "放一点辣椒粉，辛香更足。，这步最关键。"
  ],
  "serving_suggestion": "配煎蛋和面包，就是一顿午饭。，很多人在这里出错。",
  "storage": "冷藏三天，复热小火加少量水。，这里最容易翻车。",
