  "steps": [
    {
      "n": 1,
      "text": "生菜掰成入口大小的片，用清水冲洗两遍后充分沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "生菜一定甩干水，带水拌汁会把味道冲淡。",
      "visual_cue": "叶片挺脆不带水珠，颜色鲜绿"
    },
    {
      "n": 2,
      "text": "番茄切成楔形块，黄瓜切薄圆片，洋葱切细圈泡冷水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱圈泡五分钟，辣气就淡了，生吃也不冲。",
      "visual_cue": "番茄带汁不塌，瓜片薄而透光"
    },
    {
      "n": 3,
      "text": "小碗里挤入柠檬汁，加橄榄油、盐和黑胡椒搅打成油醋汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油和酸要搅到微微发白，才会挂在菜叶上。",
      "visual_cue": "汁液乳化发白，静置不立刻分层"
    },
    {
      "n": 4,
      "text": "全部蔬菜放进拌菜盆，淋上油醋汁用两把勺子轻轻翻拌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用勺子托着翻，别用筷子戳，菜叶才不会破。",
      "visual_cue": "每片叶子都挂薄汁，盆底无积水"
    },
    {
      "n": 5,
      "text": "装盘后撒欧芹碎，冷藏五分钟再上桌，口感更清脆。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冷藏别超过十分钟，久了番茄出水会塌。",
      "visual_cue": "红绿白三色分明，表面泛油光"
    }
  ],
  "tips": [
    "蔬菜洗好后用沙拉甩干器甩一遍，比晾着控水快得多。",
    "油醋汁按三份油一份酸的比例最稳，柠檬太酸可减半。",
    "想更丰盛可加半个水煮蛋切角，摆盘立刻有西班牙小馆的样子。"
  ],
  "common_mistakes": [
    "生菜带水下盆，拌完十分钟盆底积一层水，菜全泡软。",
    "油醋汁一次性倒满，菜叶沉底发蔫，酸味压过一切。",
    "番茄提前半小时切好，出水把整盘沙拉变成汤。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "白葡萄酒",
      "ratio": "30克:20毫升",
      "note": "酒味偏冲，须再加少许盐平衡。"
    },
    {
      "original": "生菜",
      "substitute": "罗马生菜",
      "ratio": "200克:200克",
      "note": "罗马生菜更脆，叶片要撕得更小。"
    }
  ],
  "variations": [
    "加一百克油浸金枪鱼罐头同拌，就是西班牙酒吧里最常见的加强版冷盘。",
    "撒一把烤过的面包丁，多了脆感，也能吸住多余的油醋汁。"
  ],
  "serving_suggestion": "用白瓷浅盘装，作为第一道冷菜上桌，配油炸小吃或烤鱼都清爽。",
  "storage": "蔬菜与油醋汁分开冷藏，吃前再拌；拌好的沙拉不建议隔夜。",
