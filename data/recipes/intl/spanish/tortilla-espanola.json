  ],
  "equipment": [
    "不粘平底锅",
    "大碗",
    "盘子",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切三毫米薄片，洋葱切丝，撒一半盐抓匀静置五分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "薄片才煎得透、口感软。",
      "visual_cue": "土豆片均匀、洋葱出水"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油中小火加热，下土豆片与洋葱慢煎十二分钟至软而不焦。",
      "time_min": 10,
      "heat": "中火",
      "tip": "小火慢煎，土豆是熟不是炸。",
      "visual_cue": "土豆软透、洋葱透明"
    },
    {
      "n": 3,
      "text": "捞出土豆与洋葱沥油，拌进打散的鸡蛋里，加剩余盐拌匀静置五分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置让蛋液吸收土豆香。",
      "visual_cue": "蛋液包裹土豆、质地浓稠"
    },
    {
      "n": 4,
      "text": "锅里留一层薄油，倒入蛋液混合物小火煎八分钟，盖盘翻面再煎五分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "翻面用盘子扣住最稳。",
      "visual_cue": "两面金黄、中心凝固微颤"
    }
  ],
  "tips": [
    "土豆片切得越薄越容易煎透，口感也更绵。",
    "煎土豆用中小火，油温高了外面焦里面硬。",
    "翻面时用盘子扣住锅口，整块蛋饼才不会散。"
  ],
  "common_mistakes": [
    "土豆切太厚，外层焦了里面还是硬的。",
    "火太大煎蛋液，底部焦黑中心还流。",
    "翻面时直接用铲子铲，蛋饼会碎成好几块。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "400g 对 400g",
      "note": "甜味更足，煎制时间减 2 分钟。"
    },
    {
      "original": "洋葱",
      "substitute": "大葱",
      "ratio": "120g 对 100g",
      "note": "香气更冲，用量减半。"
    }
  ],
  "variations": [
    "加料版：拌入 80g 切丁培根同煎。",
    "厚切版：蛋液加倍，煎成厚蛋饼切块。"
  ],
  "serving_suggestion": "温热时切块，配面包与一杯红酒，冷食也好吃。",
  "storage": "冷藏可存 2 天，复热用平底锅小火两面各煎 2 分钟。",
  "nutrition_estimate": {
    "basis": "每份（约 240g）",
