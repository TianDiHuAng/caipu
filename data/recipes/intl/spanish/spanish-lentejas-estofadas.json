  "equipment": [
    "炖锅",
    "木铲",
    "刀",
    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扁豆挑去杂质冲洗两遍，洋葱与胡萝卜分别切成小丁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "扁豆不用提前泡，洗净直接炖口感更完整。",
      "visual_cue": "豆粒大小均匀，不见碎石杂质"
    },
    {
      "n": 2,
      "text": "炖锅倒橄榄油，中火把洋葱丁炒软，下猪肉末炒散出油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "肉末下锅先别翻，等底面煎定型再拨散才不粘。",
      "visual_cue": "肉末颗粒分明，锅底见清油"
    },
    {
      "n": 3,
      "text": "加胡萝卜丁、蒜末与红椒粉，翻炒两分钟让香料裹匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "红椒粉在油里一炒就出色，动作要快别停手。",
      "visual_cue": "锅底一片橙红油，蒜香扑鼻"
    },
    {
      "n": 4,
      "text": "下番茄块炒出汁，倒入清水与扁豆，大火煮开后转小火。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水一次加够，中途添水会把汤味冲淡。",
      "visual_cue": "水面没过食材两指，汤色泛红"
    },
    {
      "n": 5,
      "text": "加盖小火炖三十五分钟，炖到扁豆软烂、汤汁明显收稠。",
      "time_min": 35,
      "heat": "小火",
      "tip": "炖到一半搅一次锅底，防止豆子沉底糊锅。",
      "visual_cue": "豆子开花起沙，汤汁挂勺不流"
    },
    {
      "n": 6,
      "text": "加盐与黑胡椒调味，盛出前撒欧芹碎提香即可。",
      "time_min": 2,
      "heat": "小火",
      "tip": "盐一定要最后放，早放豆皮会变硬炖不烂。",
      "visual_cue": "汤色深红浓稠，表面浮一层油"
    }
  ],
  "tips": [
    "喜欢浓稠口感可在炖好后舀一勺豆子压成泥回锅，汤汁立刻变稠。",
    "用压力锅可把炖煮时间压缩到十二分钟，豆子同样软糯。",
    "剩的汤汁别倒，第二天加米煮成豆汤饭，比新做的还香。"
  ],
  "common_mistakes": [
    "一开始就放盐，扁豆炖一小时仍是硬芯，怎么煮都不烂。",
    "水加得太多又不收汁，最后成了扁豆汤，完全没了炖菜的样子。",
    "大火滚炖全程不管，豆子被翻得全碎，锅底还结了一层焦。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "白豆",
      "ratio": "300克:300克",
      "note": "白豆更易软烂，炖煮时间缩到二十五分钟。"
    },
    {
      "original": "猪肉末",
      "substitute": "腊肠",
      "ratio": "150克:120克",
      "note": "腊肠切丁先煸油，咸味重须减少用盐。"
    }
  ],
  "variations": [
    "加一小段血肠同炖，是西班牙中部冬天的传统版本，汤色更深。",
    "加一把米饭同炖，出锅就是扁豆豆饭，一锅能顶一顿正餐。"
  ],
  "serving_suggestion": "盛深碗连汤带豆上桌，配硬皮面包和一杯红酒，是最典型的西班牙家常晚餐。",
  "storage": "冷藏可存四天，冷冻可存一个月；复热时加少许清水，小火慢搅防糊底。",
