  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "法棍切成半厘米厚的薄片，摊开晾十分钟到表面发干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面包片晾干，煮的时候才不糊成渣。，注意火候。",
      "visual_cue": "切片干爽，边缘发硬，状态稳定"
    },
    {
      "n": 2,
      "text": "汤锅倒橄榄油小火加热，下蒜片慢慢煎到微黄。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢煎，蒜香才出而不焦苦。，注意火候。",
      "visual_cue": "蒜片金黄，香气浓郁，状态稳定"
    },
    {
      "n": 3,
      "text": "撒入红椒粉快速翻炒十秒，注意别炒糊。这一步不要着急。",
      "time_min": 1,
      "heat": "小火",
      "tip": "红椒碎极易焦，闻到香就立刻下一步。",
      "visual_cue": "油色泛红，香气冲鼻，状态稳定"
    },
    {
      "n": 4,
      "text": "放入面包片翻炒两分钟，让每片都裹上油和蒜香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "面包裹油后再加汤，才不散成糊。，注意火候。",
      "visual_cue": "面包油亮，边缘略硬，状态稳定"
    },
    {
      "n": 5,
      "text": "倒入清水烧开，加盐和黑胡椒，小火煮八分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "汤要煮到面包化开，汤体才稠。，注意火候。",
      "visual_cue": "汤色橙红，面包变软，状态稳定"
    },
    {
      "n": 6,
      "text": "把打散的鸡蛋液沿锅边淋入，静置十秒再轻轻搅开。",
      "time_min": 3,
      "heat": "小火",
      "tip": "淋进去等十秒再搅，蛋花才成丝。，注意火候。",
      "visual_cue": "蛋花成丝，汤面浮云，状态稳定"
    },
    {
      "n": 7,
      "text": "撒香菜碎后关火，盛出时每碗再撒少许红椒碎。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后放，清香才留得住。，注意火候。",
      "visual_cue": "汤色红亮，香气浓郁，状态稳定"
    }
  ],
  "tips": [
    "面包片先晾干，煮的时候才不糊成渣。，值得留意。",
    "蒜片小火慢煎到微黄，香气最足。，值得留意。",
    "蛋液沿锅边淋入，蛋花才成丝。，值得留意。"
  ],
  "common_mistakes": [
    "蒜片大火煎到发黑，整锅汤带苦味。，务必避免。",
    "面包没裹油就下汤，全散成糊。，务必避免。",
    "蛋液倒进去立刻搅，蛋花碎成渣。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "法棍",
      "substitute": "馒头",
      "ratio": "200 克:200 克",
      "note": "切薄片晾干，口感接近。"
    },
    {
      "original": "红椒粉",
      "substitute": "红椒粉",
      "ratio": "5 克:5 克",
      "note": "烟熏味淡些，可加少许盐。"
    }
  ],
  "variations": [
    "汤里加一小块火腿同煮，鲜味更足。，也很受欢迎。",
    "用鸡汤代替清水，汤体更厚。，也很受欢迎。"
  ],
  "serving_suggestion": "趁热用汤碗盛出，配一片烤面包最合适。，效果更稳定。",
  "storage": "冷藏一天，复热小火加少量水煮开。，效果更稳定。",
