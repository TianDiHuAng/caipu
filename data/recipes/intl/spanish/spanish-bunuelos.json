          "amount": 40,
          "unit": "g",
          "note": "裹面用",
          "optional": false
        },
        {
          "name": "肉桂粉",
          "name_en": "ground cinnamon",
          "amount": 5,
          "unit": "g",
          "note": "裹面用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "深锅",
    "打蛋器",
    "挤袋",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "低筋面粉与泡打粉一起过筛，加白糖与一小撮盐拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉类过筛两遍，炸出的面圈内部才均匀。",
      "visual_cue": "粉类蓬松无结块，混匀后颜色一致"
    },
    {
      "n": 2,
      "text": "鸡蛋打散后与牛奶混合，分两次倒进粉里搅成稠面糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面糊要稠到能挂住勺子不掉，稀了会散。",
      "visual_cue": "面糊顺滑有光泽，勺背挂住厚厚一层"
    },
    {
      "n": 3,
      "text": "面糊盖好静置二十分钟，让面粉充分吸水松弛。",
      "time_min": 20,
      "heat": "无火",
      "tip": "静置过的面糊炸时不易回缩，形状更圆。",
      "visual_cue": "面糊表面平整，舀起时缓慢下滑"
    },
    {
      "n": 4,
      "text": "深锅倒橄榄油烧到一百七十度，用挤袋挤出小圆球下锅。",
      "time_min": 6,
      "heat": "中火",
      "tip": "筷子插进油里冒小泡，温度就差不多了。",
      "visual_cue": "面球入油立刻浮起，周围密布气泡"
    },
    {
      "n": 5,
      "text": "中火炸四分钟到金黄，中途翻动让受热均匀，捞出沥油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "一次别下太多，油温掉下来面球就会吸满油发腻。",
      "visual_cue": "表面金黄鼓起，敲起来有轻脆声"
    },
    {
      "n": 6,
      "text": "糖粉与肉桂粉混合均匀，趁热把炸好的面圈滚一圈裹上。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热滚糖才粘得住，凉了表面挂不住糖会整片滑落。",
      "visual_cue": "表面覆一层薄糖霜，肉桂香扑鼻"
    }
  ],
  "tips": [
    "面糊可前一晚调好冷藏，第二天早上现炸最松。",
    "油温保持在一百七十度上下，用温度计最稳。",
    "裹糖前先沥干油，糖才不会结块发黏。",
    "配一杯热巧克力蘸着吃，是西班牙冬天的吃法。"
  ],
  "common_mistakes": [
    "油温太低就下锅，面圈吸满油，咬下去发腻。",
    "面糊调得太稀，挤进油里立刻散成不规则碎块。",
    "一次下太多面球，锅温骤降，成品外软内生。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "150毫升:150毫升",
      "note": "更轻盈，奶香会淡一些。"
    },
    {
      "original": "肉桂粉",
      "substitute": "可可粉",
      "ratio": "5克:5克",
      "note": "风味更有巧克力感。"
    }
  ],
  "variations": [
    "面糊里拌入柠檬皮屑，香气更清爽不腻口。",
    "换成南瓜泥代替部分牛奶，做成秋日版本的甜面圈。"
  ],
  "serving_suggestion": "装纸袋趁热吃，配热巧克力或浓咖啡都很合适。",
  "storage": "现炸现吃最好，凉了可一百八十度回烤五分钟恢复松软。",
