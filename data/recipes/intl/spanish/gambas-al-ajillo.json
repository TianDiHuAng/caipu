          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "白葡萄酒",
          "name_en": "dry white wine",
          "amount": 30,
          "unit": "ml",
          "note": "提香去腥",
          "optional": false
        }
      ]
    },
