      ]
    }
  ],
  "equipment": [
    "汤锅",
    "小碗",
    "勺子",
    "裱花袋"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅，水里加白醋，水开后煮十分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "加醋能让蛋白在裂壳时迅速凝固，不会漏出一团白絮。",
      "visual_cue": "水面翻滚，个别蛋壳微裂"
    },
    {
      "n": 2,
      "text": "捞出后泡进冰水五分钟，剥壳再纵向对半切开。",
      "time_min": 7,
      "heat": "无火",
      "tip": "冰水泡过蛋壳一敲就脱，剥出来表面光洁。",
      "visual_cue": "蛋壳整片脱落，蛋白光滑"
    },
    {
      "n": 3,
      "text": "取出蛋黄放小碗，蛋白整齐排在垫了生菜的盘上。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋白底部切掉一小片，摆盘时才稳稳站住。",
      "visual_cue": "蛋白站稳，切口边缘平整"
    },
    {
      "n": 4,
      "text": "蛋黄用叉子压碎，加金枪鱼、洋葱末与番茄丁拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌到没有大块蛋黄就行，太细会变成糊，口感发黏。",
      "visual_cue": "馅料拌匀，整体颜色粉红"
    },
    {
      "n": 5,
      "text": "加橄榄油、盐与黑胡椒调味，尝一口再调整咸淡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "金枪鱼本身带咸味，盐要一点一点地加。",
      "visual_cue": "馅料油润，尝一口咸鲜"
    },
    {
      "n": 6,
      "text": "把馅料填回蛋白凹处，用勺子背压出饱满的弧形。",
      "time_min": 6,
      "heat": "无火",
      "tip": "填得比蛋白高一点，摆出来才精神，不会显得瘪。",
      "visual_cue": "馅料饱满，蛋白上高高鼓起"
    },
    {
      "n": 7,
      "text": "淋一圈橄榄油，撒黑胡椒，冷藏二十分钟后上桌。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冷藏一会儿味道融合，夏天吃最舒服。",
      "visual_cue": "油光发亮，馅料看着紧实"
    }
  ],
  "tips": [
    "酿鸡蛋是西班牙酒馆里最常见的冷盘，做起来几乎不费火。",
    "蛋黄馅里加金枪鱼是家常版，也有人只用蛋黄和橄榄油。",
    "提前做好冷藏，客人来了直接端上桌就行。"
  ],
  "common_mistakes": [
    "鸡蛋煮的时间不够，蛋黄流心，压不成馅。",
    "煮好不泡冰水，剥壳时蛋白坑坑洼洼，卖相全毁。",
    "馅拌得太稀，填回蛋白后整坨往下塌。"
  ],
  "substitutions": [
    {
      "original": "金枪鱼",
      "substitute": "沙丁鱼",
      "ratio": "120克:100克",
      "note": "沙丁鱼版腥味重，可加几滴柠檬汁压一压。"
    },
    {
      "original": "白醋",
      "substitute": "白葡萄酒",
      "ratio": "15毫升:20毫升",
      "note": "换酒煮蛋，香气更浓，蛋白也更容易凝固。"
    }
  ],
  "variations": [
    "馅里拌一勺番茄酱，颜色更红，孩子更爱吃。",
    "表面撒一层帕玛森芝士，进烤箱烤五分钟，热食版更香。"
  ],
  "serving_suggestion": "冰镇后装盘，配面包片和一杯冰镇白葡萄酒。",
  "storage": "冷藏密封可存一天，蛋黄馅易变质，不建议隔夜更久。",
