  "equipment": [
    "深汤锅",
    "漏勺",
    "砧板",
    "厨房剪"
  ],
  "steps": [
    {
      "n": 1,
      "text": "章鱼洗净后放进冰箱冷冻半小时，让肌肉纤维先放松再下锅。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冻过再煮，肉质更松，不会嚼起来像橡胶。",
      "visual_cue": "章鱼表面收紧，触手自然卷"
    },
    {
      "n": 2,
      "text": "深锅烧一大锅清水，放香叶与盐，水开后再下章鱼。",
      "time_min": 12,
      "heat": "大火",
      "tip": "水要足量，下章鱼后温度掉得太多，肉就会发硬。",
      "visual_cue": "水面翻大泡，蒸汽腾起"
    },
    {
      "n": 3,
      "text": "提起章鱼再放下，重复三次，让触手自然卷曲。",
      "time_min": 4,
      "heat": "中火",
      "tip": "三提三放是加利西亚的老规矩，触手卷得漂亮也不易断。",
      "visual_cue": "触手卷成螺旋，颜色转红"
    },
    {
      "n": 4,
      "text": "整只浸入水中，小火煮三十五分钟到筷子能扎透。",
      "time_min": 37,
      "heat": "小火",
      "tip": "水只能冒小泡，大滚会把表皮煮破，肉也发柴。",
      "visual_cue": "触手卷曲，筷子轻松扎入"
    },
    {
      "n": 5,
      "text": "捞出章鱼稍放凉，煮锅水留着，把土豆片下锅煮软。",
      "time_min": 12,
      "heat": "中火",
      "tip": "土豆用煮章鱼的水，吸足海味，比清水煮的香得多。",
      "visual_cue": "土豆片边缘发软，能压开"
    },
    {
      "n": 6,
      "text": "土豆片铺盘底，章鱼切厚片摆上，撒盐与红椒粉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "红椒粉别一次撒满，画两道弧线，卖相更像店里。",
      "visual_cue": "红椒粉成弧，油光发亮"
    },
    {
      "n": 7,
      "text": "淋足初榨橄榄油，撒上欧芹碎，趁还温热就端上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "橄榄油要淋得多，这道菜靠油把甜椒粉的香带出来。",
      "visual_cue": "油面流光，香草点缀其间"
    }
  ],
  "tips": [
    "这是西班牙西北部的招牌菜，做法只有煮和撒料两件事。",
    "土豆一定要用煮章鱼的水，海味全在汤里。",
    "章鱼买回来要先冻再煮，肉质才够松软。"
  ],
  "common_mistakes": [
    "锅里水太少，下章鱼后温度骤降，肉又韧又硬。",
    "大火滚煮，表皮破裂，触手断成几截。",
    "橄榄油舍不得放，红椒粉干巴巴粘不匀。"
  ],
  "substitutions": [
    {
      "original": "章鱼",
      "substitute": "鱿鱼",
      "ratio": "900克:800克",
      "note": "鱿鱼煮的时间要缩到五分钟，煮久会老。"
    },
    {
      "original": "红椒粉",
      "substitute": "辣椒酱",
      "ratio": "6克:15克",
      "note": "辣酱版口味更冲，适合下酒。"
    }
  ],
  "variations": [
    "加几片月桂叶同煮，香气更清，是港口小馆的常见做法。",
    "土豆换成烤过的，边缘焦香，口感层次更足。"
  ],
  "serving_suggestion": "用木盘端上桌，配烤面包和一杯冰镇白葡萄酒。",
  "storage": "冷藏可存两天，复热用平底锅小火两面略煎，不要久煮。",
