  "equipment": [
    "汤锅",
    "碗",
    "刀",
    "砧板",
    "漏勺",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅，水开后煮九分钟，捞出立刻放进冰水里泡五分钟。",
      "time_min": 16,
      "heat": "中火",
      "tip": "冰水急冷能防蛋黄外层发绿，也更好剥壳。",
      "visual_cue": "蛋壳易剥，蛋面光滑"
    },
    {
      "n": 2,
      "text": "土豆去皮切成半厘米厚的片，放进沸水煮八分钟至能被筷子扎透。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煮到将透未散，凉拌才不糊。",
      "visual_cue": "土豆片软透，边缘不散"
    },
    {
      "n": 3,
      "text": "洋葱切薄片，用盐抓软后挤掉多余水分，去掉辛辣味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "抓过盐的洋葱更甜，生味几乎消失。",
      "visual_cue": "洋葱片变软，呈半透明"
    },
    {
      "n": 4,
      "text": "碗里放橄榄油、白葡萄酒、蒜末、柠檬汁、盐与黑胡椒拌成汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酒用余温的菜带出香气，不必加热。",
      "visual_cue": "汁液乳化发亮，不分离"
    },
    {
      "n": 5,
      "text": "鸡蛋剥壳切成两半，土豆片与洋葱一起铺在盘底，摆上鸡蛋。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蛋切面朝上，腌汁才渗得进去。",
      "visual_cue": "蛋块完整，切面平整"
    },
    {
      "n": 6,
      "text": "把调好的汁淋在蛋与土豆上，撒红椒粉与欧芹。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汁要淋满，尤其是蛋黄的切面。",
      "visual_cue": "汁液覆盖食材，色橙红"
    },
    {
      "n": 7,
      "text": "盖保鲜膜冷藏腌三十分钟，中途翻动一次让味道均匀。",
      "time_min": 31,
      "heat": "无火",
      "tip": "至少腌半小时，冷了才好吃。",
      "visual_cue": "汁液渗入，食材发亮"
    },
    {
      "n": 8,
      "text": "取出回温五分钟，尝味补盐后即可上桌分食。",
      "time_min": 6,
      "heat": "无火",
      "tip": "太冷会盖住香气，回温后味道才开。",
      "visual_cue": "蛋面湿润，配菜色泽鲜亮"
    }
  ],
  "tips": [
    "鸡蛋煮前用针在钝端扎一小孔，剥壳更顺。",
    "土豆换成蒸的，口感更绵也更清爽。",
    "腌汁里加一勺番茄丁，颜色和酸甜都更好。",
    "这道菜冷藏过夜更入味，适合提前做。"
  ],
  "common_mistakes": [
    "鸡蛋煮过头，蛋黄发灰发干，腌汁也救不回来。",
    "土豆煮太烂，一拌就成泥，卖相全无。",
    "腌的时间太短就上桌，只有表面有味道。"
  ],
  "substitutions": [
    {
      "original": "白葡萄酒",
      "substitute": "柠檬汁",
      "ratio": "20毫升:20毫升",
      "note": "酸味更强，盐量可略减。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "200克:200克",
      "note": "甜味更足，煮制时间减两分钟。"
    }
  ],
  "variations": [
    "加一把青橄榄与酸豆，做成更像酒吧小食的版本。",
    "把鸡蛋换成煎蛋，做成热食版的腌汁蛋。"
  ],
  "serving_suggestion": "两人份前菜或轻午餐，配面包片与一杯冰啤酒，也可以作为聚会的冷盘。",
  "storage": "冷藏一天内吃完，腌汁与蛋分开存放可延长半天；食用前须回温。",
