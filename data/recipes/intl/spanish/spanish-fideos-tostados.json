  "equipment": [
    "汤锅",
    "平底锅",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蒜切片，洋葱切细丁，番茄底部划十字用热水烫后去皮擦成碎。",
      "time_min": 10,
      "heat": "无火",
      "tip": "番茄擦碎比切块更容易化进汤里，汤色也更红亮。",
      "visual_cue": "配料备齐，番茄擦成细腻的泥。"
    },
    {
      "n": 2,
      "text": "高汤倒进汤锅小火加热到微沸，保持温度不要滚开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "高汤提前烧热保温，冷汤倒进热锅，面条立刻粘成一坨。",
      "visual_cue": "汤面微微冒热气，还没滚开。"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油中火加热，倒入面条铺平，煎五分钟至通体金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "面条铺平不停翻，煎到通体金黄才够香，急不得。",
      "visual_cue": "面条金黄透亮，锅里有焦香。"
    },
    {
      "n": 4,
      "text": "把面条推到锅边，下蒜片和洋葱丁炒两分钟出香，再和面条翻匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "用煎面的油炒蒜和洋葱，那点焦香混进去，味道更足。",
      "visual_cue": "蒜片微黄，洋葱变透明发甜。"
    },
    {
      "n": 5,
      "text": "倒入番茄碎炒一分钟，再倒入热高汤，加盐和黑胡椒煮八分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "汤保持微沸就好，滚大了面条会断，汤也变浑。",
      "visual_cue": "汤汁微稠，面条变软涨大。"
    },
    {
      "n": 6,
      "text": "关火静置两分钟让面条吸汤，尝味补盐，盛盘撒香菜碎即成。",
      "time_min": 3,
      "heat": "无火",
      "tip": "关火静置两分钟，面条把汤吸得更饱，稠度也刚好。",
      "visual_cue": "汤面浓稠饱满，香气扑鼻。"
    }
  ],
  "tips": [
    "面条要先用油煎到金黄再下汤，焦香是这道汤的灵魂。",
    "高汤要提前烧热，冷汤倒进热锅面会发糊不散。",
    "汤面煮好后静置两分钟，面条吸足汤汁更入味。"
  ],
  "common_mistakes": [
    "面条直接下汤煮，整锅发黏糊嘴，完全没有香气。",
    "高汤一次倒太多，煮成稀汤寡水，面泡得发胀没咬劲。",
    "火太大滚着煮，面条断成一截一截，汤也浑了。"
  ],
  "substitutions": [
    {
      "original": "鸡高汤",
      "substitute": "蔬菜高汤",
      "ratio": "700毫升:700毫升",
      "note": "素版更清淡，盐可加一克。"
    },
    {
      "original": "细短面条",
      "substitute": "意面碎段",
      "ratio": "200克:190克",
      "note": "更耐煮，须多煮两分钟。"
    }
  ],
  "variations": [
    "加一把小虾仁同煮，鲜味更足，是沿海一带的家常版。",
    "打入一个鸡蛋搅成蛋花，汤体更浓，当作一人份午饭刚好。"
  ],
  "serving_suggestion": "盛在深盘里，撒香菜碎和现磨黑胡椒，配两片煎面包一起吃。",
  "storage": "冷藏可放一天，回热时补少量高汤，面条会继续吸汤需多备一些。",
