  "steps": [
    {
      "n": 1,
      "text": "面包撕小块用清水泡软，挤干水分备用。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面包泡软能吸汁，肉丸才嫩。，看准状态再往下做。",
      "visual_cue": "面包软烂，一捏成团"
    },
    {
      "n": 2,
      "text": "牛肉剁细，加面包、鸡蛋、一半洋葱和蒜末。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉料要拌匀上劲，丸子才不散。，看准状态再往下做。",
      "visual_cue": "肉料黏手，颜色均匀"
    },
    {
      "n": 3,
      "text": "加欧芹、红椒粉、盐和黑胡椒，顺一个方向搅打。",
      "time_min": 5,
      "heat": "无火",
      "tip": "顺一个方向搅，肉料才起胶。，看准状态再往下做。",
      "visual_cue": "肉料抱团，有黏性，这一点很关键。"
    },
    {
      "n": 4,
      "text": "搓成乒乓球大小的丸子，表面滚一层面粉。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "裹薄粉，煎时表面才结实。，看准状态再往下做。",
      "visual_cue": "丸子圆整，粉层薄，这一点很关键。"
    },
    {
      "n": 5,
      "text": "炒锅倒橄榄油，中火把丸子煎到各面上色。，看准状态再往下做。",
      "time_min": 8,
      "heat": "中火",
      "tip": "丸子要滚动着煎，各面才均匀。，看准状态再往下做。",
      "visual_cue": "表面焦褐，形状完整"
    },
    {
      "n": 6,
      "text": "盛出丸子，锅里下剩余洋葱碎炒软。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软，酱汁才不呛。，看准状态再往下做。",
      "visual_cue": "洋葱透明，油色微黄"
    },
    {
      "n": 7,
      "text": "加番茄丁炒出汁，倒白葡萄酒煮到酒气散。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "酒气煮掉，酱汁才只留香。，看准状态再往下做。",
      "visual_cue": "番茄化开，酱色红亮"
    },
    {
      "n": 8,
      "text": "加清水、盐和红椒粉，放回丸子小火炖二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火慢炖，丸子才入味不散。，看准状态再往下做。",
      "visual_cue": "丸子沉浮，酱汁浓稠"
    },
    {
      "n": 9,
      "text": "撒欧芹碎，配面包或米饭一起吃。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "配面包蘸酱，一点都不剩。，看准状态再往下做。",
      "visual_cue": "酱面油亮，绿点散布"
    }
  ],
  "tips": [
    "面包泡软挤干，肉丸才嫩不散。，这一点很关键。",
    "肉料顺一个方向搅，才起胶上劲。，这一点很关键。",
    "丸子先煎后炖，形状和味道都稳。，这一点很关键。"
  ],
  "common_mistakes": [
    "肉料不搅打，下锅就散。，这一点很关键。",
    " tomato酱没收浓，汤汤水水。",
    "大火炖，丸子煮成碎渣。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "猪里脊",
      "ratio": "500 克:500 克",
      "note": "口感更嫩，炖的时间减五分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "白酒",
      "ratio": "80 毫升:60 毫升",
      "note": "酒味更冲，要多煮两分钟。"
    }
  ],
  "variations": [
    "加一把青豆，颜色更清爽。，这一点很关键。",
    "放一点藏红花，酱汁金黄带香。，这一点很关键。"
  ],
  "serving_suggestion": "配土豆泥或面包，把酱汁蘸干净。，这一点很关键。",
  "storage": "冷藏三天，冷冻两周；复热小火加少量水慢炖。",
