  "equipment": [
    "烤箱",
    "塔模",
    "擀面杖",
    "大碗",
    "刮刀",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "冷黄油切小丁，与低筋面粉、四十克白糖和盐一起搓成粗砂状。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冰的，手温高了塔皮会硬。",
      "visual_cue": "面粉呈粗砂粒，黄油不化"
    },
    {
      "n": 2,
      "text": "加一个蛋黄揉成团，压扁包保鲜膜冷藏三十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "面团别揉太久，出筋后烤出来是硬的。",
      "visual_cue": "面团光滑，无干粉"
    },
    {
      "n": 3,
      "text": "苹果去皮去核，切成两毫米厚的薄片，拌柠檬汁防氧化。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切得薄才容易铺弯但不折断。",
      "visual_cue": "苹果片薄而完整，色白"
    },
    {
      "n": 4,
      "text": "塔模抹黄油撒薄粉，面团擀成三毫米厚片铺进去，压实边缘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边缘压实能防烤时回缩塌边。",
      "visual_cue": "塔皮贴合模壁，厚薄均匀"
    },
    {
      "n": 5,
      "text": "塔底铺一层苹果片，撒少许白糖与肉桂，再叠第二层。",
      "time_min": 7,
      "heat": "无火",
      "tip": "糖别太多，苹果本身有甜味。",
      "visual_cue": "苹果层层叠起，无空隙"
    },
    {
      "n": 6,
      "text": "把剩下的苹果片从外向内圈着摆成花形，撒杏仁片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "摆得紧一点，烤完缩水才不会露出空隙。",
      "visual_cue": "苹果成圈排列，整齐美观"
    },
    {
      "n": 7,
      "text": "蛋液刷在塔皮边缘，烤箱一百八十度中层烤四十分钟。",
      "time_min": 42,
      "heat": "中火",
      "tip": "中途上色太深就盖锡纸，别让它焦。",
      "visual_cue": "塔皮金黄，苹果边缘微焦"
    },
    {
      "n": 8,
      "text": "出炉趁热刷一层蜂蜜水，晾到温热后脱模切块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "果酱刷在热塔上，亮度才均匀。",
      "visual_cue": "表面亮泽，苹果软透"
    }
  ],
  "tips": [
    "苹果选酸甜平衡的品种，烤完不会太软烂。",
    "塔皮可以提前一天做好冷藏，用起来更省时。",
    "加一勺杏仁粉在塔底，能吸住苹果出的汁。",
    "配一球香草冰淇淋，冷热对比更讨喜。"
  ],
  "common_mistakes": [
    "黄油温度太高，揉面时出油，塔皮烤完又硬又韧。",
    "苹果切太厚，中间烤不透，外面已经焦了。",
    "塔皮不冷藏就擀，入模后严重回缩变形。"
  ],
  "substitutions": [
    {
      "original": "低筋面粉",
      "substitute": "中筋面粉",
      "ratio": "200克:190克",
      "note": "口感略韧，需多加十克黄油。"
    },
    {
      "original": "肉桂",
      "substitute": "香草精",
      "ratio": "2克:3毫升",
      "note": "香气更甜润，适合不爱香料的人。"
    }
  ],
  "variations": [
    "表面撒一层粗糖再烤，多一层脆壳口感。",
    "用梨代替苹果，做成更清甜的梨塔版本。"
  ],
  "serving_suggestion": "六人份甜点，切块配一球冰淇淋或一勺打发的淡奶油，温热食用最佳。",
  "storage": "室温密封可存一天，冷藏三天；食用前回烤五分钟能恢复塔皮脆度。",
