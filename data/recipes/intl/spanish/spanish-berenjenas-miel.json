  "equipment": [
    "烤箱",
    "刀",
    "砧板",
    "刷子",
    "烤盘",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净切成两厘米厚的斜片，表面用刀划几道浅口。",
      "time_min": 10,
      "heat": "无火",
      "tip": "划口能让腌料渗进去，也更容易烤软。",
      "visual_cue": "茄子片厚薄一致，表面划痕均匀"
    },
    {
      "n": 2,
      "text": "茄子片两面撒盐，静置十五分钟逼出水分，再用厨房纸吸干。",
      "time_min": 18,
      "heat": "无火",
      "tip": "杀水后茄子不吸油，烤出来也不发苦。",
      "visual_cue": "茄子片表面渗出小水珠，按下去变软"
    },
    {
      "n": 3,
      "text": "橄榄油、蜂蜜、蒜末、甜椒粉与黑胡椒调成刷料，拌匀备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蜂蜜和油要拌匀，不然烤的时候容易糊。",
      "visual_cue": "刷料呈亮橙色，蒜末分布均匀"
    },
    {
      "n": 4,
      "text": "烤盘铺锡纸，茄子片平铺，两面都刷一层调好的刷料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "两面都要刷到，烤出来颜色和味道才匀。",
      "visual_cue": "茄子片油亮泛光，表面带红椒色"
    },
    {
      "n": 5,
      "text": "烤箱预热两百度，中层烤二十分钟，中途翻面再刷一次刷料。",
      "time_min": 22,
      "heat": "无火",
      "tip": "中途翻面补刷，成品才两面焦亮不干。",
      "visual_cue": "边缘焦黄卷起，中间软塌"
    },
    {
      "n": 6,
      "text": "出炉挤上柠檬汁，撒欧芹碎与少许盐，趁热装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁最后挤，酸味才清爽不闷。",
      "visual_cue": "表面油亮带焦斑，香气浓郁"
    }
  ],
  "tips": [
    "茄子先用盐杀水，能去苦味也不那么吸油。",
    "表面划几道浅口，腌料才渗得进去。",
    "中途补刷一次刷料，两面都亮才好看。",
    "蜂蜜容易焦，烤箱温度别超过两百度。"
  ],
  "common_mistakes": [
    "不杀水直接烤，茄子吸光油还发苦。",
    "刷料只刷一面，另一面干硬没味道。",
    "温度开太高，蜂蜜先糊而茄子还硬。",
    "烤完不挤柠檬，甜味闷口，吃着发腻。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "麦芽糖浆",
      "ratio": "40克:40克",
      "note": "甜度更低，烤的时间减两分钟。"
    },
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "600克:600克",
      "note": "水分更多，杀水时间加五分钟。"
    }
  ],
  "variations": [
    "撒一把烤松子，口感层次更丰富。",
    "加一点孜然粉，香气更有中东风情。",
    "烤好后淋一勺酸奶，酸甜解腻，很像地中海吃法。"
  ],
  "serving_suggestion": "茄子片摆盘，淋上盘底的蜜汁，撒欧芹，配烤面包或作为烤肉的配菜都很合适。",
  "storage": "冷藏可放两天，复热用烤箱一百八十度烤五分钟，微波加热会变软塌出水。",
