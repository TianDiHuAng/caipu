  "equipment": [
    "烤盘",
    "平底锅",
    "厨房纸",
    "牙签"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜椒纵向切开去籽去白膜，切口朝下放在厨房纸上。",
      "time_min": 8,
      "heat": "无火",
      "tip": "白膜是苦味来源，刮干净，馅才不会发涩。",
      "visual_cue": "内壁光洁，看不到水珠"
    },
    {
      "n": 2,
      "text": "鳕鱼两面撒盐腌十分钟，再用厨房纸吸干表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱼肉表面要干，下锅煎的时候才不粘。",
      "visual_cue": "鱼身干爽，表面盐粒泛光"
    },
    {
      "n": 3,
      "text": "平底锅热油，鳕鱼中火煎四分钟，翻面再煎三分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎到用叉子一拨就散开，说明鱼肉熟透了。",
      "visual_cue": "鱼肉分层，表面煎成浅金"
    },
    {
      "n": 4,
      "text": "关火用叉子把鱼肉压碎，挑掉可能残留的细刺。",
      "time_min": 5,
      "heat": "无火",
      "tip": "海边家常做法全靠手挑刺，别省这一步。",
      "visual_cue": "鱼碎松散，骨刺已挑净"
    },
    {
      "n": 5,
      "text": "另起一锅炒香洋葱末与蒜末，加番茄泥炒到浓稠。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄泥炒干水汽，馅料才不会烤出一盘汤。",
      "visual_cue": "底酱收紧，锅边见红油"
    },
    {
      "n": 6,
      "text": "撒入面粉炒匀，分两次倒牛奶搅成顺滑的稠糊。",
      "time_min": 4,
      "heat": "小火",
      "tip": "牛奶分两次倒，一次倒完容易结小疙瘩。",
      "visual_cue": "糊体顺滑，看不到颗粒"
    },
    {
      "n": 7,
      "text": "鱼肉碎回锅，加盐与黑胡椒拌匀，晾到不烫手。",
      "time_min": 6,
      "heat": "小火",
      "tip": "馅太烫会烫手，填馅时也容易把椒壳弄软。",
      "visual_cue": "馅体稠厚，能堆成一小团"
    },
    {
      "n": 8,
      "text": "把馅填进甜椒，表面抹平撒面包糠，淋橄榄油。",
      "time_min": 8,
      "heat": "无火",
      "tip": "填得略高出椒口，烤完回缩也不会凹下去。",
      "visual_cue": "馅面平整，面包糠撒得均匀"
    },
    {
      "n": 9,
      "text": "烤箱一百八十度烤二十五分钟，表面金黄出炉，撒欧芹碎。",
      "time_min": 27,
      "heat": "中火",
      "tip": "最后五分钟开上火，面包糠上色更快。",
      "visual_cue": "表面金黄，甜椒皮微微起皱"
    }
  ],
  "tips": [
    "酿甜椒在西班牙北部常见，鳕鱼馅是经典版本。",
    "甜椒先烤软再填馅也好吃，馅料不易出水。",
    "一次多做几只冷冻，忙的时候直接烤。"
  ],
  "common_mistakes": [
    "甜椒内壁白膜没刮干净，吃到最后一口发苦。",
    "番茄泥没炒干就调馅，烤完盘底全是汤。",
    "牛奶一次倒完，面糊结疙瘩，馅料口感粗糙。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "金枪鱼",
      "ratio": "300克:240克",
      "note": "金枪鱼本身咸，盐要减到三克。"
    },
    {
      "original": "牛奶",
      "substitute": "高汤",
      "ratio": "120毫升:120毫升",
      "note": "高汤版更咸鲜，适合配酒。"
    }
  ],
  "variations": [
    "馅里加一勺米饭，口感更扎实，也更顶饱。",
    "用青椒代替甜椒，辣味清一点，颜色更热闹。"
  ],
  "serving_suggestion": "烤好趁热装盘，配番茄沙拉和一杯干白葡萄酒。",
  "storage": "冷藏可存两天，复烤时盖锡纸一百八十度十分钟即可。",
