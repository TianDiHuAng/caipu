          "amount": 800,
          "unit": "g",
          "note": "熟透去皮",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "面包",
          "name_en": "bread",
          "amount": 100,
          "unit": "g",
          "note": "去边隔夜面包",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 10,
          "unit": "g",
          "note": "去皮",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 60,
          "unit": "ml",
          "note": "搅打",
          "optional": false
        },
        {
          "name": "红酒醋",
          "name_en": "red wine vinegar",
          "amount": 15,
          "unit": "ml",
          "note": "提酸",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 100,
          "unit": "ml",
          "note": "调整浓度",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "搅拌机",
    "刀",
    "砧板",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄去蒂后切成大块，大蒜剥好皮放在一旁备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "番茄挑熟透的，甜度高才不用多加糖。",
      "visual_cue": "番茄块切面多汁，颜色红亮"
    },
    {
      "n": 2,
      "text": "面包撕成小块，放进清水里泡软后挤干水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡软的面包是浓稠的关键，别省略。",
      "visual_cue": "面包块吸水变软，捏起来能成团"
    },
    {
      "n": 3,
      "text": "把番茄、大蒜和泡软的面包一起放进搅拌机。",
      "time_min": 4,
      "heat": "无火",
      "tip": "材料分两批打，搅拌机才带得动这么多。",
      "visual_cue": "杯中材料堆到一半高度"
    },
    {
      "n": 4,
      "text": "倒入橄榄油和红酒醋，加盐后高速搅打三分钟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "橄榄油慢慢淋进去，才能打成乳化状态。",
      "visual_cue": "糊体顺滑，颜色橙红发亮"
    },
    {
      "n": 5,
      "text": "打到完全顺滑没有颗粒，倒进碗里冷藏三十分钟。",
      "time_min": 30,
      "heat": "无火",
      "tip": "冷藏过后汤体更稠，风味也更圆润。",
      "visual_cue": "汤体挂勺，表面平滑"
    },
    {
      "n": 6,
      "text": "盛出后淋一圈橄榄油，配上烤面包块一起吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "上桌前再淋油，颜色和香气更好看。",
      "visual_cue": "表面油光清亮，配面包块"
    }
  ],
  "tips": [
    "面包要泡软挤干，汤才有浓稠的口感。",
    "橄榄油分次慢慢淋入，才能打出乳化。",
    "冷藏半小时再吃，风味明显更融合。"
  ],
  "common_mistakes": [
    "面包没泡软就打，汤里有硬块颗粒。",
    "橄榄油一次倒入，油水分离打不匀。",
    "番茄不够熟，成品寡淡还要靠糖补救。"
  ],
  "substitutions": [
    {
      "original": "红酒醋",
      "substitute": "苹果醋",
      "ratio": "15 毫升:15 毫升",
      "note": "酸味更柔和，糖可减量。"
    },
    {
      "original": "面包",
      "substitute": "面包糠",
      "ratio": "100 克:50 克",
      "note": "更易打匀，需减少清水量。"
    }
  ],
  "variations": [
    "表面撒一点切碎的熟鸡蛋，口感更丰富。",
    "表面撒几片火腿碎，咸鲜味道会更突出。"
  ],
  "serving_suggestion": "冷藏后盛进玻璃碗，配面包块和火腿碎一起上桌。",
  "storage": "冷藏两天，食用前搅匀；不宜冷冻，解冻后会出水。",
