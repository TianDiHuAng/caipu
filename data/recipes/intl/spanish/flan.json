  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 150,
          "unit": "g",
          "note": "三个全蛋",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 500,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "分焦糖与蛋液",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "香草荚",
          "name_en": "vanilla pod",
          "amount": 2,
          "unit": "g",
          "note": "剖开取籽",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "布丁模",
    "打蛋器",
    "烤箱",
    "深烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白糖取 60g 放小锅，小火加热到融化变琥珀色，趁热倒进布丁模底部铺平。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖色到琥珀就离火，深了发苦。",
      "visual_cue": "糖液呈琥珀色、流动变缓"
    },
    {
      "n": 2,
      "text": "牛奶加香草荚小火加热到微微冒汽，关火焖五分钟让香气渗出。",
      "time_min": 8,
      "heat": "小火",
      "tip": "牛奶别煮沸，会起皮。",
      "visual_cue": "奶液冒汽、香气明显"
    },
    {
      "n": 3,
      "text": "鸡蛋加剩余白糖与盐打散，缓缓倒入温牛奶边倒边搅，过筛两次去掉气泡。",
      "time_min": 8,
      "heat": "无火",
      "tip": "过筛两次，成品才无孔洞。",
      "visual_cue": "蛋奶液顺滑、表面无泡"
    },
    {
      "n": 4,
      "text": "蛋奶液倒进布丁模，烤盘注入热水至模子一半高，160℃ 水浴烤二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "水浴让布丁受热温和不裂。",
      "visual_cue": "布丁凝固、轻晃中心微颤"
    },
    {
      "n": 5,
      "text": "取出放凉后冷藏两小时，倒扣脱模让焦糖汁流下即可。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷藏定型后再脱模。",
      "visual_cue": "布丁完整脱模、焦糖包裹表面"
    }
  ],
  "tips": [
    "糖色只熬到琥珀色，颜色过深会带明显苦味。",
    "蛋奶液务必过筛两次，烤出的布丁才无蜂窝孔洞。",
    "水浴烤制能稳住温度，布丁才细腻不裂。"
  ],
  "common_mistakes": [
    "糖色熬过头，布丁底部带焦苦味。",
    "蛋奶液没过滤，成品切开全是气孔。",
    "不加水浴直接烤，表面裂开内部变老。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "500ml 对 400ml 加 100ml 牛奶",
      "note": "质地更浓，烤制时间加 3 分钟。"
    },
    {
      "original": "香草荚",
      "substitute": "香草精",
      "ratio": "2g 对 3ml",
      "note": "直接拌入蛋液即可。"
    }
  ],
  "variations": [
    "橙味版：牛奶里加 10g 橙皮屑同焖。",
    "椰奶版：牛奶换成椰奶，风味更南洋。"
  ],
  "serving_suggestion": "冷藏后倒扣在小碟上，焦糖汁自然流下，配一杯黑咖啡。",
  "storage": "冷藏可存 3 天，密封避免串味。",
