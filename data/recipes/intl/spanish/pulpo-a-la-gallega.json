  "steps": [
    {
      "n": 1,
      "text": "章鱼洗净后反复在案板上摔打几下，让肉质松弛，煮出来才不韧。",
      "time_min": 5,
      "heat": "无火",
      "tip": "摔打松弛纤维，口感更嫩。",
      "visual_cue": "章鱼触手卷曲、肉质松软"
    },
    {
      "n": 2,
      "text": "大锅水烧开，捏住章鱼头把触手浸入热水三次再整只下锅，中小火煮五十分钟。",
      "time_min": 50,
      "heat": "中火",
      "tip": "三浸三提让触手卷得漂亮。",
      "visual_cue": "触手卷曲、表皮变紫红"
    },
    {
      "n": 3,
      "text": "土豆去皮切一厘米厚片，放进煮章鱼的汤里煮八分钟至软而不烂。",
      "time_min": 8,
      "heat": "中火",
      "tip": "用章鱼汤煮土豆，鲜味更足。",
      "visual_cue": "土豆软透、边缘完整"
    },
    {
      "n": 4,
      "text": "土豆铺盘底，章鱼剪成小段摆上，撒盐与辣椒粉，淋橄榄油趁热上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热淋油，香气才起。",
      "visual_cue": "表面油亮、辣椒粉红艳"
    }
  ],
  "tips": [
    "章鱼煮前摔打几下，纤维松弛后口感才嫩。",
    "触手三浸三提再整只下锅，卷曲漂亮且受热均匀。",
    "用煮章鱼的汤煮土豆，鲜味全吸进土豆里。"
  ],
  "common_mistakes": [
    "章鱼直接下锅，煮完又韧又硬咬不动。",
    "全程大火猛煮，表皮破裂、肉质又柴又硬。",
    "土豆另起清水煮，味道寡淡不搭。"
  ],
  "substitutions": [
    {
      "original": "章鱼",
      "substitute": "鱿鱼",
      "ratio": "800g 对 800g",
      "note": "煮制时间减至 15 分钟。"
    },
    {
      "original": "辣椒粉",
      "substitute": "甜椒粉",
      "ratio": "5g 对 5g",
      "note": "辣度降低，颜色更红。"
    }
  ],
  "variations": [
    "冷食版：煮好冷藏，切片后拌橄榄油与盐。",
    "烤制版：煮后刷油烤五分钟，表面焦香。"
  ],
  "serving_suggestion": "配木盘与牙签，撒海盐与辣椒粉，配一杯红酒。",
  "storage": "冷藏可存 2 天，冷食切片拌橄榄油风味更佳。",
