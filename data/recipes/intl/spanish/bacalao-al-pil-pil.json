          "name_en": "garlic",
          "amount": 30,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "干辣椒",
          "name_en": "dried chili",
          "amount": 2,
          "unit": "piece",
          "note": "掰段",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 250,
          "unit": "ml",
          "note": "乳化汤汁",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "陶锅",
    "夹子",
    "小碗",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼 500g 用厨房纸吸干表面水分，两面抹 4g 盐，静置 15 分钟逼出水汽。",
      "time_min": 16,
      "heat": "无火",
      "tip": "盐腌出水后鱼皮更易定型。",
      "visual_cue": "鱼排表面干爽、无渗水"
    },
    {
      "n": 2,
      "text": "陶锅倒 250ml 橄榄油，冷油下大蒜片与干辣椒段，小火慢炸 6 分钟至蒜片微黄。",
      "time_min": 8,
      "heat": "小火",
      "tip": "冷油下蒜，香气才慢慢渗进油里。",
      "visual_cue": "蒜片金黄、油面微微起泡"
    },
    {
      "n": 3,
      "text": "捞出蒜片和辣椒留着备用，油温降到约 70 度，放入鳕鱼排小火煎 8 分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "油温别高，鱼排要慢慢浸熟。",
      "visual_cue": "鱼排边缘转白、鱼肉微颤"
    },
    {
      "n": 4,
      "text": "翻面再煎 5 分钟，取出鱼排放在温盘上，锅内留约 150ml 油。",
      "time_min": 6,
      "heat": "小火",
      "tip": "翻面用夹子托住，鱼肉才不散。",
      "visual_cue": "两面洁白、鱼皮完整"
    },
    {
      "n": 5,
      "text": "保持小火，用汤勺舀起锅里的油反复浇在锅底，边浇边晃锅 3 分钟至汤汁乳白浓稠。",
      "time_min": 4,
      "heat": "小火",
      "tip": "反复浇油是乳化的关键动作。",
      "visual_cue": "汤汁乳白、能挂住勺背"
    },
    {
      "n": 6,
      "text": "把鳕鱼放回锅中裹上酱汁，撒回炸香的蒜片和辣椒，离火上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "离火再拌，避免酱汁分层。",
      "visual_cue": "鱼身裹满乳白酱汁"
    }
  ],
  "tips": [
    "橄榄油必须全程小火，温度过高就乳不起来。",
    "鱼排下锅前吸干水分，油才不飞溅。",
    "装盘后摇匀锅底酱汁再浇一遍，卖相更好。"
  ],
  "common_mistakes": [
    "大火煎鱼，橄榄油过热导致酱汁永远无法乳化。",
    "蒜片炸到焦黑，整锅橄榄油都带着焦苦味。",
    "鱼排煎完直接端上桌，没有回锅裹酱汁。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "比目鱼",
      "ratio": "500g 对 500g",
      "note": "肉质更软，煎制时间减 2 分钟。"
    },
    {
      "original": "大蒜",
      "substitute": "蒜苗",
      "ratio": "30g 对 40g",
      "note": "香气更清，辣味更淡。"
    }
  ],
  "variations": [
    "藏红花版：油中加 0.2g 藏红花增色。",
    "蒜香浓版：大蒜加到 50g 同煎。"
  ],
  "serving_suggestion": "用浅盘盛装，淋上乳白酱汁，配烤面包蘸食。",
  "storage": "现做现吃，冷藏后酱汁会分层凝结。",
