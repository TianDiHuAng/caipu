  "equipment": [
    "搅拌机",
    "汤锅",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄 800g 顶部划十字，用开水烫 30 秒后撕去表皮，切成大块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "烫 30 秒就好，久了肉质变散。",
      "visual_cue": "番茄皮轻松撕下、果肉完整"
    },
    {
      "n": 2,
      "text": "隔夜白面包 100g 撕成小块，用少量清水浸软后挤干水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "隔夜面包吸水性更好。",
      "visual_cue": "面包块软塌、捏之成团"
    },
    {
      "n": 3,
      "text": "番茄块、面包、10g 大蒜与 5g 盐放入搅拌机，高速打 2 分钟至顺滑。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打久一点，质地才细腻。",
      "visual_cue": "糊体顺滑、无颗粒感"
    },
    {
      "n": 4,
      "text": "保持搅拌，从投料口分次淋入 100ml 橄榄油，打到酱体发亮变稠。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油缓慢淋入才能乳化。",
      "visual_cue": "酱体浓稠发亮、能挂勺"
    },
    {
      "n": 5,
      "text": "加 15ml 白醋搅匀，尝味后按需补盐，冷藏 30 分钟风味更融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷藏后酸味会变柔和。",
      "visual_cue": "酱色橙红、质地细腻"
    }
  ],
  "tips": [
    "番茄必须撕皮，否则酱体带渣影响口感。",
    "橄榄油要缓慢淋入，一次倒完会油水分离。",
    "冷藏半小时再吃，酸味和蒜味会更融合。"
  ],
  "common_mistakes": [
    "番茄带皮直接打，酱里全是细小皮渣。",
    "橄榄油一次倒入，酱体表面浮一层油。",
    "大蒜放太多，辛辣味压过番茄的清甜。"
  ],
  "substitutions": [
    {
      "original": "面包",
      "substitute": "无麸质面包",
      "ratio": "100g 对 100g",
      "note": "口感略粗，需多打 30 秒。"
    },
    {
      "original": "白醋",
      "substitute": "雪莉醋",
      "ratio": "15ml 对 15ml",
      "note": "风味更接近安达卢西亚原版。"
    }
  ],
  "variations": [
    "浓稠版：面包加到 150g 做成蘸酱。",
    "加料版：表面撒切碎的水煮蛋与火腿丁。"
  ],
  "serving_suggestion": "盛入碗中，淋少许橄榄油，配面包块或炸面包丁。",
  "storage": "冷藏 2 天，食用前搅匀即可。",
