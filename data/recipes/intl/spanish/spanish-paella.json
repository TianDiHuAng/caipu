  "equipment": [
    "海鲜饭平底锅",
    "刀",
    "砧板",
    "木铲",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁用盐与黑胡椒抓匀，静置十分钟入底味备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "虾仁腌太久会出水变硬，十分钟足够。",
      "visual_cue": "虾仁表面发亮略带黏性"
    },
    {
      "n": 2,
      "text": "平底饭锅下橄榄油，把鸡腿肉丁中火煎到四面金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "肉丁擦干再下锅，锅够热才煎得上色。",
      "visual_cue": "肉丁边缘焦黄，锅底留香"
    },
    {
      "n": 3,
      "text": "下洋葱末与大蒜末炒到透明，再加彩椒丁翻炒两分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱要炒软出甜，别只炒到断生。",
      "visual_cue": "洋葱透明发亮，彩椒变软"
    },
    {
      "n": 4,
      "text": "倒入番茄泥中火炒到颜色转深、水分收干成浓稠底酱。",
      "time_min": 6,
      "heat": "中火",
      "tip": "这一步是西班牙饭的底味，番茄要炒到发暗红。",
      "visual_cue": "锅底呈深红色酱状"
    },
    {
      "n": 5,
      "text": "把大米倒入锅中翻炒两分钟，让每粒米都裹上油脂。",
      "time_min": 5,
      "heat": "中火",
      "tip": "米不要淘洗，表面的粉质正是汤汁变浓的关键。",
      "visual_cue": "米粒泛油光，边缘微透明"
    },
    {
      "n": 6,
      "text": "淋入白葡萄酒煮到酒气散尽，加入藏红花汤与热鸡汤铺平米粒。",
      "time_min": 5,
      "heat": "中火",
      "tip": "加汤后不要搅动，米粒沉底的那层才是焦香锅巴。",
      "visual_cue": "液体没过米面一厘米"
    },
    {
      "n": 7,
      "text": "转小火煮十八分钟，期间只转锅不搅拌，让米粒均匀吸汁。",
      "time_min": 18,
      "heat": "小火",
      "tip": "锅太小可以中途转一次锅，搅动会破坏锅巴。",
      "visual_cue": "汤面冒小泡，米粒半露"
    },
    {
      "n": 8,
      "text": "摆上虾仁与青豆，加盖再煮六分钟至虾仁变粉红、汤汁将干。",
      "time_min": 7,
      "heat": "小火",
      "tip": "虾仁最后放，久煮会缩成硬球失去甜味。",
      "visual_cue": "虾仁卷曲变粉，锅边汤已收"
    },
    {
      "n": 9,
      "text": "关火盖上干净布巾静置五分钟，撒欧芹配柠檬角上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置让余温把米芯焖透，也锁住锅底的香气。",
      "visual_cue": "米粒分明不烂，锅底有薄脆锅巴"
    }
  ],
  "tips": [
    "大米不要淘洗，保留表面粉质汤汁才浓稠。",
    "加汤后坚持不搅拌，是形成锅巴的关键。",
    "藏红花用温汤泡开再下锅，颜色和香气才完全释放。"
  ],
  "common_mistakes": [
    "中途不停搅拌，米粒破碎变成一锅糊粥。",
    "汤一次全倒满，米粒浮起受热不均。",
    "虾仁一开始就下锅，端上桌已经老得咬不动。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鱿鱼圈",
      "ratio": "250 克:250 克",
      "note": "鱿鱼须最后三分钟再下，避免过老。"
    },
    {
      "original": "藏红花",
      "substitute": "姜黄粉",
      "ratio": "1 克:2 克",
      "note": "颜色接近但少了花香，用量减半以免发苦。"
    }
  ],
  "variations": [
    "只用海鲜不加鸡肉，可做纯海鲜版本。",
    "最后加几个青口贝同煮，海味会更足，也更有海边风味。"
  ],
  "serving_suggestion": "连锅端上桌，配柠檬角与一杯冰镇白葡萄酒。",
  "storage": "冷藏两天；复热加少量鸡汤小火加盖焖五分钟，锅巴会变软。",
