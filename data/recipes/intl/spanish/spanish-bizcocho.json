        }
      ]
    }
  ],
  "equipment": [
    "打蛋器",
    "大碗",
    "蛋糕模",
    "烤箱",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进大碗，加白糖和盐，用打蛋器高速打发。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蛋液要打到画纹路不消失，蛋糕才蓬松。",
      "visual_cue": "蛋糊发白，体积膨胀，状态稳定"
    },
    {
      "n": 2,
      "text": "继续打八分钟，直到提起打蛋器流下的糊能堆成小山。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打到这个状态，蛋糕才不塌陷不紧实。",
      "visual_cue": "糊体浓稠，纹路不消，状态稳定"
    },
    {
      "n": 3,
      "text": "面粉过筛分三次撒进蛋糊，用刮刀抄底轻轻翻拌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一次倒完会压塌气泡，分次才拌得匀。",
      "visual_cue": "面糊无干粉，质地蓬松"
    },
    {
      "n": 4,
      "text": "黄油隔水化开稍放凉，和牛奶一起沿碗边淋进面糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "油温别太烫，否则会把蛋糊里的气泡烫消。",
      "visual_cue": "面糊顺滑，油已吸收，状态稳定"
    },
    {
      "n": 5,
      "text": "蛋糕模内壁刷一层薄油撒粉，把面糊倒进去抹平。",
      "time_min": 4,
      "heat": "无火",
      "tip": "模子处理到位，脱模时蛋糕才完整不掉皮。",
      "visual_cue": "面糊平整，无大气泡，状态稳定"
    },
    {
      "n": 6,
      "text": "烤箱预热一百七十度，送入中层烤三十分钟。这一步不要着急。",
      "time_min": 5,
      "heat": "-",
      "tip": "中途别开烤箱门，温度一掉蛋糕就塌。",
      "visual_cue": "烤箱升温，表面渐黄，状态稳定"
    },
    {
      "n": 7,
      "text": "插入竹签不带湿面糊即出炉，倒扣放凉后脱模切块。",
      "time_min": 8,
      "heat": "-",
      "tip": "倒扣放凉避免回缩，切块时刀要快。，注意火候。",
      "visual_cue": "表面金黄，按压回弹，状态稳定"
    }
  ],
  "tips": [
    "蛋液要打到画纹路不消失，蛋糕才蓬松。",
    "面粉分三次翻拌，别画圈以免消泡。，值得留意。",
    "出炉立刻倒扣放凉，蛋糕才不回缩。，值得留意。"
  ],
  "common_mistakes": [
    "蛋液没打发够就拌面粉，蛋糕又硬又扁。",
    "翻拌时画圈搅，气泡全消烤成蛋饼。，务必避免。",
    "烤到一半开箱门查看，蛋糕瞬间塌陷。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "120 克:100 毫升",
      "note": "口感更轻，奶香稍减。"
    },
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "80 毫升:80 毫升",
      "note": "带椰香，适合不吃乳制品的人。"
    }
  ],
  "variations": [
    "面糊里加柠檬皮屑，香气更清爽。，也很受欢迎。",
    "表面撒一层粗糖，烤出脆壳。，也很受欢迎。"
  ],
  "serving_suggestion": "切厚片配一杯牛奶或咖啡，当下午茶点心最合适。",
  "storage": "密封常温两天或冷藏四天，食用前回温。，效果更稳定。",
