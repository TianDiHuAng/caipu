        }
      ]
    }
  ],
  "equipment": [
    "奶锅",
    "方形模具",
    "深口锅",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶锅放牛奶、细砂糖和盐，小火慢慢加热，用木勺搅到糖完全化开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖一定要先化开再放淀粉，否则容易结块沉底。",
      "visual_cue": "糖粒消失，牛奶微微冒热气"
    },
    {
      "n": 2,
      "text": "玉米淀粉先用四勺凉牛奶调成没有颗粒的浆，再倒进温热的牛奶里搅匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "淀粉先调浆再入锅，直接撒一定结出疙瘩，顺序别弄反。",
      "visual_cue": "浆水顺滑，没有干粉颗粒，表面看不见干粉"
    },
    {
      "n": 3,
      "text": "奶锅回到小火，不停画圈搅拌八分钟，搅到面糊变稠能挂住木勺。",
      "time_min": 8,
      "heat": "小火",
      "tip": "全程别停手，一停就糊底，糊了味道全毁，慢一点更稳妥。",
      "visual_cue": "面糊浓稠，勺背挂一层，勺子划过留痕"
    },
    {
      "n": 4,
      "text": "趁热倒进湿润的方模里，表面抹平，凉到室温后冷藏四小时定型。",
      "time_min": 6,
      "heat": "无火",
      "tip": "模具先沾水，脱模时一扣就下来，不会粘，热的时候最好操作。",
      "visual_cue": "表面平整，轻轻晃动不流，晃动时整体一起动"
    },
    {
      "n": 5,
      "text": "定型的奶冻倒扣脱模，切成四厘米见方的块，先滚一层面粉再蘸蛋液。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切块前刀沾点水，切口才利落，不会带出一片。",
      "visual_cue": "方块齐整，表面裹得均匀，切面平整不粘刀"
    },
    {
      "n": 6,
      "text": "深口锅倒玉米油烧到六成热，下奶冻块中火炸两分钟到外壳金黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温不能太高，外壳焦了里面还是凉的，火别开太大。",
      "visual_cue": "外壳金黄，油面翻小泡，边缘金黄不焦黑"
    },
    {
      "n": 7,
      "text": "捞出沥油，趁热滚上一层肉桂细砂糖，摆盘即可食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热滚糖才挂得住，凉了表面就挂不上了，动作要快。",
      "visual_cue": "糖层均匀，表面微微反光，糖面薄薄一层"
    }
  ],
  "tips": [
    "玉米淀粉的用量不能少，比例不到奶冻就定不了型，切块时会散。",
    "面糊必须熬到挂勺、能离开锅底，这一步决定了成品能不能成形。",
    "冷藏时间要够四小时，急了切开是软塌塌的糊，炸不起来。",
    "炸的时候油温保持中火，外壳金黄就够了，内部本来就是熟的。"
  ],
  "common_mistakes": [
    "淀粉直接撒进热牛奶里，锅里立刻结成一片白疙瘩，怎么搅都散不开。",
    "熬面糊时玩手机停了手，锅底一层焦糊，整锅奶浆带苦味只能倒掉。",
    "冷藏两小时就急着切块，奶冻软塌塌地摊在盘里，下锅全散了。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "500毫升:400毫升",
      "note": "奶香更浓，甜度可减少十克。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "玉米淀粉加吉利丁",
      "ratio": "60克:50克加2片",
      "note": "更Q弹，但需冷藏更久才能定型。"
    }
  ],
  "variations": [
    "裹好蛋液后滚一层面包糠再炸，外壳更厚更脆，口感像炸鲜奶。",
    "把肉桂糖换成可可粉和白砂糖，做成可可味的炸奶冻，孩子更喜欢。"
  ],
  "serving_suggestion": "四块装一小盘，表面撒一点肉桂粉，配一杯苦味咖啡或红茶，甜而不腻。",
  "storage": "冷藏可放两天，炸好的成品建议当天吃完，回热用平底锅小火两面各煎一分钟。",
