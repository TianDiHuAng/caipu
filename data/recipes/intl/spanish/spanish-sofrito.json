  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "砧板",
    "料理机"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫一分钟后撕去外皮，切成小块备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "烫过的番茄皮一撕就掉，炒出来不会有卷边。",
      "visual_cue": "番茄皮完整脱落，果肉呈鲜红色"
    },
    {
      "n": 2,
      "text": "洋葱与红椒切细丁，大蒜切末，三者分开盛放待用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丁切得越小越均匀，炒出的酱越顺滑。",
      "visual_cue": "洋葱丁约半厘米见方，大小一致"
    },
    {
      "n": 3,
      "text": "厚底锅倒橄榄油，中小火炒洋葱丁八分钟到透明出甜味。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "洋葱炒到透明而不是焦黄，甜味才干净。",
      "visual_cue": "洋葱丁边缘透明，锅底泛出浅金色"
    },
    {
      "n": 4,
      "text": "下红椒丁与蒜末再炒三分钟，闻到蒜香但不要炒到上色。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "蒜末要最后再下，炒焦了整锅酱都会带上苦味。",
      "visual_cue": "蒜末泛白未变黄，香气刚刚散出"
    },
    {
      "n": 5,
      "text": "加番茄块与白糖，中小火慢炒二十五分钟，其间不断搅动。",
      "time_min": 25,
      "heat": "中小火",
      "tip": "糖能压住番茄的尖酸，别一次放太多。",
      "visual_cue": "番茄塌软出汁，锅底冒密集小泡"
    },
    {
      "n": 6,
      "text": "炒到汁水收干、红油浮起，加盐与黑胡椒，按需打成细泥或留粗粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "喜欢有口感就短促点动两下，别打成泥浆。",
      "visual_cue": "酱体浓稠发亮，表面浮一层红油"
    }
  ],
  "tips": [
    "做一大锅分装冷冻，煮饭炖菜时挖一勺就能提味。",
    "番茄要选熟透的，果肉厚、酸度低，成酱才甜。",
    "加一小勺番茄膏颜色更红，风味也更集中。",
    "炒的时候别离人，番茄含糖高，很容易糊底。"
  ],
  "common_mistakes": [
    "火太大急着收汁，番茄在锅底糊出一层黑膜发苦。",
    "洋葱没炒透就下番茄，成酱有一股生洋葱的呛气。",
    "蒜末和洋葱一起下锅，炒到发黑带明显焦苦味。"
  ],
  "substitutions": [
    {
      "original": "红椒",
      "substitute": "甜椒",
      "ratio": "100克:100克",
      "note": "甜椒不辣，颜色更浅偏橙。"
    },
    {
      "original": "新鲜番茄",
      "substitute": "番茄膏",
      "ratio": "600克:120克",
      "note": "要补一百毫升清水稀释。"
    }
  ],
  "variations": [
    "加一勺烟熏红椒粉，做出来的底酱带明显的炭火香。",
    "把一半番茄换成烤过的，甜味更浓适合配鱼。"
  ],
  "serving_suggestion": "作为炖菜、米饭与汤的底酱，也能直接拌意面或抹面包。",
  "storage": "冷藏可存五天，分格冷冻能放三个月，用时取一块直接下锅。",
