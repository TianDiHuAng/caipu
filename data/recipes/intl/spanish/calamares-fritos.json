          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼去内脏与软骨，撕去外层薄膜，洗净后切成 1 厘米宽的圆圈。",
      "time_min": 10,
      "heat": "无火",
      "tip": "薄膜撕干净，口感才不发韧。",
      "visual_cue": "鱿鱼圈白净、厚薄一致"
    },
    {
      "n": 2,
      "text": "鱿鱼圈用厨房纸吸干表面水分，撒 3g 盐与 2g 白胡椒粉抓匀，静置 8 分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "擦干水分，炸时才不会猛烈爆油。",
      "visual_cue": "鱿鱼表面干爽、略微收紧"
    },
    {
      "n": 3,
      "text": "鸡蛋 1 个打散，鱿鱼圈先蘸蛋液再滚上 100g 面粉，抖掉多余干粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先蛋液后干粉，外壳才挂得牢。",
      "visual_cue": "鱿鱼圈裹粉均匀、不见湿斑"
    },
    {
      "n": 4,
      "text": "锅中倒入 270ml 橄榄油烧至七成热，下鱿鱼圈炸 2 分钟至金黄。",
      "time_min": 4,
      "heat": "大火",
      "tip": "一次别下太多，油温掉了会吸油。",
      "visual_cue": "外壳浅金色、油面翻小泡"
    },
    {
      "n": 5,
      "text": "用漏勺捞出沥油 1 分钟，装盘撒剩余 2g 盐与欧芹碎，配柠檬角挤汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出锅立刻撒盐，味道才贴得住。",
      "visual_cue": "外壳酥脆、柠檬清香明显"
    }
  ],
  "tips": [
    "鱿鱼圈务必擦干再裹粉，否则下锅会剧烈炸油。",
    "油温保持七成热，分两批炸更稳当。",
    "出锅立刻撒盐和欧芹，香气最足。"
  ],
  "common_mistakes": [
    "鱿鱼带水下油锅，热油飞溅容易烫手。",
    "裹粉太厚，炸出来外壳硬里面还生。",
    "炸好后堆放沥油，水汽回软失去脆感。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "小章鱼",
      "ratio": "500g 对 500g",
      "note": "炸制时间加 40 秒。"
    }
  ],
  "variations": [
    "安达卢西亚版：面糊改用啤酒调稀后挂糊。",
    "辣味版：面粉中拌入 2g 红椒粉。"
  ],
  "serving_suggestion": "趁热装盘，配柠檬角和一杯冰啤酒。",
  "storage": "现炸现吃最佳，冷藏后可 200 度复烤 5 分钟。",
