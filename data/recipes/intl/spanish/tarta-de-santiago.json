          "amount": 250,
          "unit": "g",
          "note": "细磨",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 4,
          "unit": "piece",
          "note": "室温",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "取皮屑",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 150,
          "unit": "g",
          "note": "分次加入",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "刷模",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 2,
          "unit": "g",
          "note": "可选增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "六寸圆模",
    "打蛋器",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "模具内壁刷一层黄油，撒薄薄一层杏仁粉，铺上油纸备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "模具处理好，脱模才完整。",
      "visual_cue": "模具内壁均匀挂粉"
    },
    {
      "n": 2,
      "text": "鸡蛋与 150g 白糖放入盆中，高速打发 6 分钟至颜色发白、体积膨大。",
      "time_min": 7,
      "heat": "无火",
      "tip": "打到滴落的糊能堆出纹路才好。",
      "visual_cue": "蛋糊浓稠泛白、能挂住打蛋器"
    },
    {
      "n": 3,
      "text": "筛入 250g 杏仁粉与 2g 肉桂粉，用刮刀从底往上翻拌至无干粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "翻拌别画圈，避免消泡。",
      "visual_cue": "面糊细腻无颗粒、体积略降"
    },
    {
      "n": 4,
      "text": "擦入柠檬皮屑拌匀，倒入模具，轻震两下排出大气泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬皮只取黄色部分，带白会苦。",
      "visual_cue": "面糊表面平整、气泡浮起破裂"
    },
    {
      "n": 5,
      "text": "烤箱 175 度烤 30 分钟，牙签插入中心取出无湿糊即熟。",
      "time_min": 33,
      "heat": "中火",
      "tip": "表面盖锡纸防上色过深。",
      "visual_cue": "蛋糕边缘脱离模具、表面金黄"
    },
    {
      "n": 6,
      "text": "完全放凉后脱模，撒一层糖粉并放上十字镂空纸模筛出图案。",
      "time_min": 15,
      "heat": "无火",
      "tip": "必须凉透再脱模，热脱会塌。",
      "visual_cue": "蛋糕体紧实、糖粉图案清晰"
    }
  ],
  "tips": [
    "杏仁粉务必过筛，粗颗粒会让口感发沙。",
    "蛋糊打发到位，蛋糕才蓬松不塌。",
    "完全冷却后再脱模，这是成败关键。"
  ],
  "common_mistakes": [
    "蛋糊打发不够就进烤箱，出炉塌成一张饼。",
    "杏仁粉结块不过筛，切开有硬粒。",
    "蛋糕还热着就脱模，边缘全碎掉不成形。"
  ],
  "substitutions": [
    {
      "original": "杏仁粉",
      "substitute": "榛子粉",
      "ratio": "250g 对 250g",
      "note": "风味更浓，糖可减 10g。"
    },
    {
      "original": "肉桂",
      "substitute": "香草精",
      "ratio": "2g 对 3ml",
      "note": "风味更清爽。"
    }
  ],
  "variations": [
    "橙香版：用橙皮屑代替柠檬皮屑。",
    "淋糖版：出炉后刷一层柠檬糖浆增湿。"
  ],
  "serving_suggestion": "切三角块配一杯浓缩咖啡，是西班牙朝圣之路上的经典甜点。",
  "storage": "密封常温 2 天，冷藏 4 天，食用前回温。",
