  "equipment": [
    "烤箱",
    "烤盘",
    "料理机",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄对半切、甜椒去籽切块，与带皮大蒜一起放进烤盘，200℃ 烤十五分钟至表面起皱。",
      "time_min": 15,
      "heat": "无火",
      "tip": "烤到表皮起泡，甜味才浓缩。",
      "visual_cue": "番茄软塌、甜椒表皮起泡"
    },
    {
      "n": 2,
      "text": "杏仁与面包片铺在烤盘边缘，继续烤六分钟至微焦出香，中途翻一次面。",
      "time_min": 6,
      "heat": "无火",
      "tip": "杏仁烤过才香，生的发涩。",
      "visual_cue": "杏仁微黄、面包片焦脆"
    },
    {
      "n": 3,
      "text": "烤好的番茄、甜椒、大蒜剥皮后与杏仁、面包一起放进料理机，加米醋、辣椒粉与盐打碎。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先打碎再加液体，口感才匀。",
      "visual_cue": "混合物成粗粒糊状"
    },
    {
      "n": 4,
      "text": "橄榄油分三次淋入，边淋边打，打到酱体浓稠挂勺、仍带明显坚果颗粒即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油分次淋，酱才乳化不分离。",
      "visual_cue": "酱体浓稠、油脂完全吸收"
    }
  ],
  "tips": [
    "番茄与甜椒要烤到表皮起泡，甜味才够浓。",
    "橄榄油分次淋入并持续搅打，酱体才乳化成浓稠质地。",
    "喜欢颗粒感就少打几秒，别打成完全顺滑的泥。"
  ],
  "common_mistakes": [
    "番茄没烤就直接打，酱汁水汪汪没有浓度。",
    "橄榄油一次性倒入，打完油水分离浮一层油。",
    "用生杏仁代替烤杏仁，酱里带明显涩味。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "榛子",
      "ratio": "80g 对 80g",
      "note": "香气更浓，烤制时间减 2 分钟。"
    },
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "15ml 对 12ml",
      "note": "酸度更直接。"
    }
  ],
  "variations": [
    "鱼肉版：配烤鱼或煎鱼一起吃，酸香解腻。",
    "涂面包版：直接抹在烤面包片上当早餐。"
  ],
  "serving_suggestion": "配烤蔬菜、烤鱼或烤肉，也可抹在面包上当蘸酱。",
  "storage": "冷藏密封可存 5 天，表面淋一层橄榄油隔绝空气。",
