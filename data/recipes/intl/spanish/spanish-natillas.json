      "items": [
        {
          "name": "蛋黄",
          "name_en": "egg yolk",
          "amount": 4,
          "unit": "piece",
          "note": "常温",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 100,
          "unit": "g",
          "note": "分次加",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 25,
          "unit": "g",
          "note": "过筛",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 20,
          "unit": "g",
          "note": "取皮屑",
          "optional": false
        },
        {
          "name": "肉桂粉",
          "name_en": "ground cinnamon",
          "amount": 3,
          "unit": "g",
          "note": "表面撒粉",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "打蛋器",
    "小碗",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶倒进厚底锅，加柠檬皮屑小火加热到锅边冒小泡。",
      "time_min": 8,
      "heat": "小火",
      "tip": "柠檬皮只取黄色层，刮到白瓤会发苦。",
      "visual_cue": "牛奶表面浮起细密小泡，香气散出"
    },
    {
      "n": 2,
      "text": "蛋黄加白糖、玉米淀粉与一小撮盐搅成顺滑糊状，没有干粉颗粒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "淀粉先与糖混匀再下蛋黄，不容易结块。",
      "visual_cue": "蛋糊颜色浅黄，提起打蛋器能顺滑流下"
    },
    {
      "n": 3,
      "text": "把热牛奶慢慢冲进蛋糊，一边冲一边快速搅动。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冲的时候别停手，不然蛋黄会被烫出颗粒。",
      "visual_cue": "液体均匀无蛋花，表面有一层薄泡"
    },
    {
      "n": 4,
      "text": "倒回锅里小火加热，不断搅拌八分钟到明显变稠。",
      "time_min": 8,
      "heat": "小火",
      "tip": "刮到锅底搅，糊底就是一条焦味的来源。",
      "visual_cue": "勺背挂住厚厚一层，划过留下清楚沟痕"
    },
    {
      "n": 5,
      "text": "离火后过筛倒进小碗，放凉再冷藏两小时到凝固。",
      "time_min": 10,
      "heat": "无火",
      "tip": "过筛能去掉柠檬皮与结块，口感更细。",
      "visual_cue": "表面平整光滑，略微晃动能颤动"
    },
    {
      "n": 6,
      "text": "食用前撒一层肉桂粉，也可放一片柠檬皮装饰。",
      "time_min": 2,
      "heat": "无火",
      "tip": "肉桂粉最后再撒，放久了会吸潮结成难看的小团块。",
      "visual_cue": "表面铺一层薄薄棕色粉层"
    }
  ],
  "tips": [
    "牛奶换成一半淡奶油，成品更浓厚接近布丁。",
    "喜欢更甜可把糖加到一百二十克，但别超过。",
    "冷藏后表面会结一层皮，盖保鲜膜贴面可避免。",
    "用宽口浅碗装，凉得快也更易定型。"
  ],
  "common_mistakes": [
    "加热时火太大又不搅拌，锅底糊住带出焦味。",
    "热牛奶一次倒进冷蛋糊，蛋黄被烫熟结成颗粒。",
    "淀粉量不足，冷藏后仍是液体无法定型。"
  ],
  "substitutions": [
    {
      "original": "玉米淀粉",
      "substitute": "低筋面粉",
      "ratio": "25克:30克",
      "note": "口感略厚，需多煮两分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "橙子",
      "ratio": "20克:25克",
      "note": "果香更柔和甜润。"
    }
  ],
  "variations": [
    "加入一小勺可可粉，做成巧克力味的奶糊。",
    "表面放一片烤过的杏仁或饼干，增加口感层次。"
  ],
  "serving_suggestion": "冷藏后直接吃，配一块甜饼干或一杯淡咖啡都很合适。",
  "storage": "冷藏两天内吃完，须密封保存，不要反复取出回温。",
