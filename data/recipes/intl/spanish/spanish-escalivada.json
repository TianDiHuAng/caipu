          "optional": false
        },
        {
          "name": "红酒醋",
          "name_en": "red wine vinegar",
          "amount": 15,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
