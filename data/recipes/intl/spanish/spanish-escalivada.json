          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 4,
          "unit": "g",
          "note": "平衡酸味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "刀",
    "砧板",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到两百度，茄子对半切开在表面划几刀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表面划刀能让茄子烤得均匀不爆皮。",
      "visual_cue": "茄子切面平整，有浅刀痕"
    },
    {
      "n": 2,
      "text": "甜椒去籽切两半，番茄去蒂，一起平铺在烤盘上。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切面朝下摆，烤出的焦香更明显。",
      "visual_cue": "三种蔬菜平铺不重叠"
    },
    {
      "n": 3,
      "text": "蔬菜表面刷一层橄榄油，撒上盐后送进烤箱。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷油能锁水，也让蔬菜不粘烤盘。",
      "visual_cue": "表面泛油光，盐粒均匀"
    },
    {
      "n": 4,
      "text": "放进两百度烤箱烤三十五分钟，中途取出翻一次面。",
      "time_min": 35,
      "heat": "中大火",
      "tip": "烤到表皮起皱发黑，才有烟熏香。",
      "visual_cue": "表皮起泡，边缘焦黑"
    },
    {
      "n": 5,
      "text": "取出后盖上湿布焖十分钟，让皮和肉自然分离。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盖上湿布焖这一会儿，撕皮特别容易。",
      "visual_cue": "蒸汽冒出，表皮起皱"
    },
    {
      "n": 6,
      "text": "撕去外皮和籽，把蔬菜肉撕成粗条放进大碗。",
      "time_min": 10,
      "heat": "无火",
      "tip": "手撕比刀切更吸酱汁，口感也更好。",
      "visual_cue": "蔬菜条柔软，不带焦皮"
    },
    {
      "n": 7,
      "text": "加橄榄油、红酒醋、大蒜末、盐和白糖拌匀静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置十分钟，各种味道才会彼此融合。",
      "visual_cue": "酱汁微微析出，颜色红润"
    }
  ],
  "tips": [
    "烤到表皮发黑起泡，烟熏味才够正。",
    "出炉盖湿布焖一会儿，撕皮会容易很多。",
    "手撕比刀切更吸味，别图快用刀。"
  ],
  "common_mistakes": [
    "烤得不够就取出来，皮撕不动还发苦。",
    "没盖湿布焖，蔬菜表面干掉难撕皮。",
    "醋一次加太多，压掉了蔬菜的烟熏甜味。"
  ],
  "substitutions": [
    {
      "original": "红酒醋",
      "substitute": "米醋",
      "ratio": "15 毫升:15 毫升",
      "note": "酸味更直，可减少用量。"
    },
    {
      "original": "甜椒",
      "substitute": "青椒",
      "ratio": "300 克:300 克",
      "note": "风味更清爽，烟熏感略淡。"
    }
  ],
  "variations": [
    "拌进一点鳀鱼碎，鲜味会更加突出。",
    "抹在烤面包上吃，就是加泰罗尼亚的经典小吃。"
  ],
  "serving_suggestion": "当作凉菜或抹面包的酱都行，配烤鱼烤肉能解腻。",
  "storage": "冷藏三天，油封住表面可延长到五天；食用前回温拌匀。",
  "nutrition_estimate": {
    "basis": "每份约 180 克",
