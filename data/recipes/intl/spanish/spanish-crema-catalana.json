          "optional": false
        },
        {
          "name": "香草荚",
          "name_en": "vanilla pod",
          "amount": 3,
          "unit": "ml",
          "note": "去腥",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "碗",
    "打蛋器",
    "烤盅",
    "筛",
    "喷枪"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶倒入汤锅，加柠檬皮屑、桂皮卷与香草荚，小火加热到边缘冒小泡后离火。",
      "time_min": 8,
      "heat": "小火",
      "tip": "牛奶别煮沸，边缘冒泡就关火，否则会起皮。",
      "visual_cue": "奶面微颤冒气，桂皮香味散出"
    },
    {
      "n": 2,
      "text": "蛋黄加白砂糖与玉米淀粉搅打到发白起稠，形成细腻的蛋糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "搅打到颜色变浅，淀粉才不会结块。",
      "visual_cue": "蛋糊颜色浅黄，舀起能缓缓流下"
    },
    {
      "n": 3,
      "text": "把温热牛奶慢慢冲进蛋糊，边冲边搅，滤回锅中用小火加热。",
      "time_min": 6,
      "heat": "小火",
      "tip": "牛奶要慢慢冲，一次倒会烫成蛋花。",
      "visual_cue": "混合液均匀顺滑，筛上无颗粒"
    },
    {
      "n": 4,
      "text": "持续小火搅拌八分钟，加热到奶糊浓稠能挂住刮刀后离火。",
      "time_min": 9,
      "heat": "小火",
      "tip": "全程不停搅，停手就会糊底。",
      "visual_cue": "奶糊浓稠，刮刀划过留下清晰痕迹"
    },
    {
      "n": 5,
      "text": "趁热舀进四个烤盅，表面抹平，放凉后冷藏三小时至完全凝固。",
      "time_min": 5,
      "heat": "无火",
      "tip": "表面抹平成品才好看，冷藏时间要足。",
      "visual_cue": "奶冻平整光滑，轻晃微颤"
    },
    {
      "n": 6,
      "text": "表面撒一层薄薄的白砂糖，用喷枪烤成琥珀色脆壳即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖层要薄才脆，喷枪离远一点慢慢烤。",
      "visual_cue": "表面琥珀色发亮，脆壳一敲就裂"
    }
  ],
  "tips": [
    "牛奶只要加热到边缘冒泡，煮开会结皮。",
    "牛奶冲蛋糊时慢慢倒、不停搅，才不结块。",
    "全程小火不停搅拌，奶糊才不会糊底。",
    "糖壳要薄，太厚咬不动还不易烤透。"
  ],
  "common_mistakes": [
    "牛奶煮沸直接冲蛋，蛋糊立刻结成疙瘩。",
    "搅拌中断三十秒，锅底就结了一层焦皮。",
    "奶糊没熬稠就出锅，冷藏后仍是一摊液体。",
    "糖撒太厚烤不透，表面一层砂糖硌牙。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "600毫升:400毫升",
      "note": "更醇厚，淀粉可减五克。"
    },
    {
      "original": "香草精",
      "substitute": "橙花水",
      "ratio": "3毫升:3毫升",
      "note": "香气更自然，可换成一小勺橙花水"
    }
  ],
  "variations": [
    "换成橙皮屑和橙花水，做成橙香版本很受欢迎。",
    "表面撒一层肉桂粉再烤，香气更暖。",
    "烤盅换成浅盘，焦糖面积更大，脆壳更过瘾。"
  ],
  "serving_suggestion": "冷藏后取出，现烤焦糖脆壳，一勺敲开配着奶冻吃，冰凉的奶香和焦糖的微苦刚好平衡。",
  "storage": "未烤糖的奶冻冷藏可放两天，烤好糖壳的须半小时内食用，否则脆壳会回软。",
