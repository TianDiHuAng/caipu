  "equipment": [
    "平底锅",
    "锅铲",
    "厨房纸",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成两厘米厚的方片，用厨房纸压住吸去表面水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水吸得越干，煎的时候越不容易崩油溅手。",
      "visual_cue": "豆腐片表面干爽，纸不留湿印"
    },
    {
      "n": 2,
      "text": "豆腐片两面薄薄撒一层盐，静置五分钟让底味渗进豆心。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐只在表面撒一层，撒多了出水会拖软豆皮。",
      "visual_cue": "表面泛起细盐粒，边缘略见湿光"
    },
    {
      "n": 3,
      "text": "平底锅烧热倒橄榄油，中火把豆腐片煎到两面金黄起壳。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅后别急着翻，等晃锅能滑动再翻面。",
      "visual_cue": "底面结金黄色硬壳，边缘微鼓"
    },
    {
      "n": 4,
      "text": "转小火撒入蒜末与红椒粉，让香味均匀裹住每片豆腐。",
      "time_min": 2,
      "heat": "小火",
      "tip": "红椒粉遇高温就苦，一定要转小火再撒。",
      "visual_cue": "豆腐表面挂上橙红薄层，蒜末微黄"
    },
    {
      "n": 5,
      "text": "出锅装盘，挤柠檬汁并撒欧芹碎与现磨黑胡椒即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬汁吃前再挤，早挤会让豆皮回软。",
      "visual_cue": "表面红亮油润，点缀翠绿欧芹"
    }
  ],
  "tips": [
    "用老豆腐比嫩豆腐更合适，煎的时候不易碎，咬开还有豆香。",
    "锅要烧到微微冒烟再下油，豆腐才不会粘锅底。",
    "想更入味可提前用红椒粉和橄榄油腌十分钟再煎。"
  ],
  "common_mistakes": [
    "豆腐没吸水就下锅，热油四溅，锅边全是崩出的油点。",
    "一锅下太多片，锅温掉下来，豆腐全粘在锅底撕不下来。",
    "红椒粉和大火蒜末一起下，十秒就发黑，满锅焦苦味。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "嫩豆腐",
      "ratio": "400克:400克",
      "note": "嫩豆腐须先蒸五分钟定型再煎。"
    },
    {
      "original": "柠檬",
      "substitute": "白葡萄酒",
      "ratio": "20克:15毫升",
      "note": "淋酒后略烧一下，酸香更柔和。"
    }
  ],
  "variations": [
    "煎好后淋一勺番茄洋葱酱，就是带酱汁的铁板豆腐版本，更下饭。",
    "撒料里加少许孜然粉，风味接近西班牙南部的铁板小吃摊。"
  ],
  "serving_suggestion": "热盘上桌，配烤面包片和一小碟腌橄榄，当作下酒小菜最合适。",
  "storage": "冷藏可存两天，回锅时用平底锅小火两面各烘一分钟，别用微波炉。",
