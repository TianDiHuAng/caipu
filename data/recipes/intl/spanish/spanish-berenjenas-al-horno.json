  "equipment": [
    "烤箱",
    "烤盘",
    "刀",
    "砧板",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净去蒂，纵向剖成两半，在切面上划出菱形刀口。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刀口只划到三分之二深，别把茄皮划破。",
      "visual_cue": "切面菱形纹路整齐，茄皮完整"
    },
    {
      "n": 2,
      "text": "切面薄薄撒一层盐静置十分钟，逼出的水分用厨房纸吸干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "这步别省，茄子吸油全是因为水没逼出来。",
      "visual_cue": "切面渗出细密水珠，表面变潮"
    },
    {
      "n": 3,
      "text": "番茄切小丁，洋葱与大蒜切末，欧芹切碎分别装碗备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "番茄籽和汁水一起留着，烤的时候正好滋润茄肉。",
      "visual_cue": "配料分装清楚，颗粒大小一致"
    },
    {
      "n": 4,
      "text": "烤箱预热两百度，烤盘刷橄榄油，茄子切面朝下烤十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "切面朝下贴盘烤，茄肉才不会烤干发柴。",
      "visual_cue": "茄皮起皱，用筷子能轻松戳透"
    },
    {
      "n": 5,
      "text": "翻面铺上番茄洋葱蒜末，淋橄榄油再烤八分钟，撒欧芹与黑胡椒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "配料铺平别堆太厚，否则上面的番茄还是生的。",
      "visual_cue": "配料边缘微焦，表面冒小泡"
    }
  ],
  "tips": [
    "茄子选细长的紫皮品种，皮薄肉嫩，烤完不会发苦。",
    "想更省时间可先把茄子微波五分钟，再进烤箱上色，总时长能省一半。",
    "出炉后静置三分钟再上桌，茄肉回吸一遍汤汁更入味。"
  ],
  "common_mistakes": [
    "茄子没撒盐杀水就进烤箱，吸掉半盘油，吃着满口腻。",
    "番茄铺得太厚，烤完底下还是生的，上面已经焦黑。",
    "烤箱温度调得太高，茄皮烤焦发苦，茄肉里面还是硬的。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "500克:500克",
      "note": "西葫芦水分多，杀水时间缩到五分钟。"
    },
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "8克:8克",
      "note": "香菜味更冲，用量减半更合适。"
    }
  ],
  "variations": [
    "铺料里加三十克磨碎的干酪同烤，表面结一层金黄脆壳，奶香更足。",
    "喜欢辣味可在番茄料里拌入少许辣椒粉，烤完带一点尾辣，很下酒。"
  ],
  "serving_suggestion": "趁热整只上桌，配烤面包或白米饭都可以，剩下的酱汁拌面也好吃。",
  "storage": "冷藏可存两天，回热时盖锡纸进烤箱一百八十度烤八分钟，不会变干。",
