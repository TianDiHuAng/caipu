  "steps": [
    {
      "n": 1,
      "text": "汤锅烧开水加盐，下通心粉煮到比包装时间少两分钟，捞出留半杯煮面水。",
      "time_min": 10,
      "heat": "大火",
      "tip": "少煮两分钟，后面还要进酱汁里煮，否则会烂软没口感。",
      "visual_cue": "通心粉外软，中心略留硬芯"
    },
    {
      "n": 2,
      "text": "平底锅放橄榄油，中火下洋葱碎炒三分钟到透明，再加蒜末炒出香味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒到发甜再下蒜，蒜早下容易焦苦。",
      "visual_cue": "洋葱透明，蒜香明显"
    },
    {
      "n": 3,
      "text": "下猪肉末，用铲子一边压一边炒三分钟，炒到颗粒散开、表面微焦。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉末下锅先别翻，压平煎一分钟再炒散，才有焦香。",
      "visual_cue": "肉末颗粒分明，边缘微焦"
    },
    {
      "n": 4,
      "text": "加胡萝卜细丁翻炒两分钟，让胡萝卜丁裹上油，颜色转深。",
      "time_min": 3,
      "heat": "中火",
      "tip": "胡萝卜用油炒过，甜味才出得来。",
      "visual_cue": "胡萝卜丁油亮，质地略软"
    },
    {
      "n": 5,
      "text": "倒入番茄泥，加盐、白糖与牛至，中小火煮十二分钟到酱汁浓稠。",
      "time_min": 14,
      "heat": "中小火",
      "tip": "慢煮让番茄的酸转成甜，急着收汁只会留下尖酸。",
      "visual_cue": "酱汁浓稠红亮，表面浮油"
    },
    {
      "n": 6,
      "text": "把通心粉倒进酱汁里，加两勺煮面水，中火翻拌两分钟让面吸味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "煮面水里的面糊能让酱汁挂在面上，比清水好得多。",
      "visual_cue": "面管里灌满酱汁，锅底不干"
    },
    {
      "n": 7,
      "text": "撒上黑胡椒与奶酪碎，关火盖上锅盖焖一分钟让奶酪化开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盖一分钟奶酪刚好融而不拉丝断裂，趁热吃最好。",
      "visual_cue": "奶酪半融，面身油亮"
    },
    {
      "n": 8,
      "text": "盛进深盘里，把锅里剩下的酱汁浇在面上，趁热上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "留一点酱汁浇面，吃到底也不会干。",
      "visual_cue": "每盘面都裹着厚厚一层红酱"
    }
  ],
  "tips": [
    "通心粉比细面更能挂酱，管里灌满酱汁是最好吃的部分。",
    "没有猪肉末可以用西班牙腌肉切丁，风味更浓。",
    "番茄泥用新鲜番茄擦出来，比罐装的甜度自然。",
    "加一勺擦碎的奶酪最后拌开，酱汁会更顺滑。"
  ],
  "common_mistakes": [
    "面煮全熟再进酱汁，翻两下就断，成品糊成一团。",
    "番茄泥不煮浓缩，直接拌面，盘底一层红水。",
    "奶酪撒完立刻关火拌，奶酪结块成坨，挂不均匀。"
  ],
  "substitutions": [
    {
      "original": "通心粉",
      "substitute": "斜管面",
      "ratio": "300克:300克",
      "note": "煮制时间相近，按包装调整。"
    },
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉末",
      "ratio": "180克:180克",
      "note": "更清淡，需多加一勺橄榄油补润。"
    }
  ],
  "variations": [
    "表面撒面包糠进烤箱烤十分钟，做成焗通心粉，表层焦脆。",
    "加几只虾仁与青口，做成海鲜版本的通心粉。"
  ],
  "serving_suggestion": "三人份主食，配一份拌生菜与面包，是西班牙家庭的日常午餐。",
  "storage": "冷藏两天内吃完，复热加一勺水小火拌开；不建议冷冻，面会失去弹性。",
