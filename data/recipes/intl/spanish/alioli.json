  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 30,
          "unit": "g",
          "note": "去皮",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 1,
          "unit": "piece",
          "note": "取蛋黄",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 200,
          "unit": "ml",
          "note": "乳化用",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 10,
          "unit": "ml",
          "note": "调节酸度",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "研钵",
    "打蛋器",
    "量杯",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大蒜 30g 放入研钵，加 4g 盐捣成细腻的蒜泥，静置 5 分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "盐能磨得更细，也能缓和辛辣。",
      "visual_cue": "蒜泥细腻、无颗粒"
    },
    {
      "n": 2,
      "text": "加入 1 个蛋黄与 10ml 柠檬汁，用打蛋器搅到完全融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先加柠檬汁，乳化更稳定。",
      "visual_cue": "蛋液浓稠、颜色均匀"
    },
    {
      "n": 3,
      "text": "把 200ml 橄榄油分 10 次淋入，每次都搅到完全吸收再加下一次。",
      "time_min": 8,
      "heat": "无火",
      "tip": "油一定要慢加，一次倒多会分离。",
      "visual_cue": "酱体逐渐浓稠、颜色变浅"
    },
    {
      "n": 4,
      "text": "搅到酱体浓稠能挂住打蛋器，尝味后按需补少许盐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "太稠可加几滴水调稀。",
      "visual_cue": "酱体顺滑、纹路缓慢消失"
    },
    {
      "n": 5,
      "text": "装入干燥密封罐，冷藏 30 分钟后风味更融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "罐子必须干燥，避免水汽变质。",
      "visual_cue": "罐内无气泡、表面平整"
    }
  ],
  "tips": [
    "油必须一点点淋入，倒太快酱汁会分离。",
    "蒜泥捣得越细，成品口感越顺滑。",
    "如果酱汁分离，取一个新蛋黄重新慢慢乳化。"
  ],
  "common_mistakes": [
    "橄榄油一次倒太多，酱汁油水分离。",
    "大蒜没捣碎就下油，成品有辛辣颗粒。",
    "密封罐带水没擦干，两天后就变质发酸。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "无蛋版",
      "ratio": "1 个对 0",
      "note": "省略蛋黄，改为先加 10ml 水乳化。"
    },
    {
      "original": "橄榄油",
      "substitute": "玉米油",
      "ratio": "200ml 对 200ml",
      "note": "味道更清淡，蒜香更突出。"
    }
  ],
  "variations": [
    "烤蒜版：大蒜先烤软再捣泥，香气更温和。",
    "藏红花版：加 0.2g 藏红花泡水调色。"
  ],
  "serving_suggestion": "配烤蔬菜、炸鱿鱼圈或面包片食用。",
  "storage": "冷藏 5 天内用完，取用须用干净勺子。",
  "nutrition_estimate": {
    "basis": "每份（约 90g）",
    "calories_kcal": 520,
