    "烤盘",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成三厘米的滚刀块，用清水冲去表面溢出的白浆。",
      "time_min": 14,
      "heat": "无火",
      "tip": "冲掉表面的白浆，烤出来外壳才够脆。",
      "visual_cue": "土豆块表面不再发白起浆"
    },
    {
      "n": 2,
      "text": "土豆块冷水下锅煮八分钟，煮到边缘变软而中心还硬。",
      "time_min": 9,
      "heat": "中火",
      "tip": "先煮一遍，烤的时候内部才会绵软。",
      "visual_cue": "边缘微软，中心留有硬芯"
    },
    {
      "n": 3,
      "text": "捞出沥干水分，摊开晾五分钟让表面彻底干爽。",
      "time_min": 7,
      "heat": "无火",
      "tip": "表面必须晾干，否则烤不出脆壳。",
      "visual_cue": "土豆块干爽不粘手"
    },
    {
      "n": 4,
      "text": "土豆块拌上橄榄油和一半盐，摊在烤盘上两百二十度烤二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "块与块之间留出缝隙，才烤得焦脆。",
      "visual_cue": "土豆块边缘焦黄起泡"
    },
    {
      "n": 5,
      "text": "炒锅放少量橄榄油，下洋葱末和大蒜末用小火炒到透明。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒软出甜味，酱汁才不会发酸。",
      "visual_cue": "洋葱末变得透明发亮"
    },
    {
      "n": 6,
      "text": "加入番茄碎、红椒粉、辣椒粉、白糖和白醋，小火熬十分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "熬到番茄完全化开，酱汁才会浓稠。",
      "visual_cue": "酱汁浓稠，颜色深红"
    },
    {
      "n": 7,
      "text": "尝一下味道补上剩下的盐，把酱汁离火稍微放凉。",
      "time_min": 2,
      "heat": "无火",
      "tip": "红椒粉久煮容易发苦，盐要最后调。",
      "visual_cue": "酱汁细腻，表面泛着油光"
    },
    {
      "n": 8,
      "text": "烤好的土豆块装进盘子里，淋上辣酱趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "上桌之前再淋酱，土豆才不会提前软掉。",
      "visual_cue": "土豆焦脆，酱汁红亮"
    }
  ],
  "tips": [
    "土豆先煮再烤，内部绵软外壳才够脆。",
    "晾干水分是烤出脆壳最关键的一步。",
    "红椒粉不耐高温久炒，后半程再加更香。"
  ],
  "common_mistakes": [
    "土豆没煮就直接烤，硬得咬不动。",
    "表面带水下烤盘，烤完软塌一点都不脆。",
    "辣酱熬得太干，拌上土豆后发黏。"
  ],
  "substitutions": [
    {
      "original": "红椒粉",
      "substitute": "辣椒粉",
      "ratio": "6 克:5 克",
      "note": "辣度更高，用量略减。"
    },
    {
      "original": "白醋",
      "substitute": "米醋",
      "ratio": "10 毫升:10 毫升",
      "note": "酸味更柔和。"
    }
  ],
  "variations": [
    "配一碟蒜香蛋黄酱同吃，辣味更平衡。",
    "撒少许欧芹碎，颜色更加鲜亮好看。"
  ],
  "serving_suggestion": "当作餐前小食或下酒菜，配一杯冰啤酒是西班牙酒吧的标配。",
  "storage": "冷藏两天，复热用烤箱两百度烤八分钟；酱汁可单独冷藏三天。",
