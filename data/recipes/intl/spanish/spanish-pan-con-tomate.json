  "equipment": [
    "烤箱",
    "刀",
    "砧板",
    "小碗",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包切成两厘米厚的片，表面用刷子薄薄刷一层橄榄油。",
      "time_min": 6,
      "heat": "无火",
      "tip": "刷薄油烤出来外脆内软，不会干硬。，注意火候。",
      "visual_cue": "面包片油亮，厚度均匀"
    },
    {
      "n": 2,
      "text": "烤箱预热二百度，面包片放在烤盘上烤四分钟到边缘微焦。",
      "time_min": 5,
      "heat": "-",
      "tip": "烤到表面金黄就够，久了会变硬咬不动。",
      "visual_cue": "边缘焦黄，表面干脆，状态稳定"
    },
    {
      "n": 3,
      "text": "大蒜对半切开，趁热在面包表面来回擦出蒜香。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热擦蒜，香气才渗进面包的孔隙。，注意火候。",
      "visual_cue": "表面有蒜痕，香气散出"
    },
    {
      "n": 4,
      "text": "番茄对半切开，用细孔擦板把果肉擦成泥，去掉外皮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "擦板能顺便滤掉皮，番茄泥才细腻。，注意火候。",
      "visual_cue": "番茄泥浓稠，无皮渣，状态稳定"
    },
    {
      "n": 5,
      "text": "番茄泥加盐搅匀，尝一下咸淡后静置两分钟出水。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先加盐静置，番茄的甜酸味才更突出。",
      "visual_cue": "泥体发亮，略见汁水，状态稳定"
    },
    {
      "n": 6,
      "text": "把番茄泥厚厚铺在面包片上，淋几滴橄榄油立即上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "铺好马上吃，面包才不吸水变软。，注意火候。",
      "visual_cue": "番茄泥匀，油光闪亮，状态稳定"
    }
  ],
  "tips": [
    "面包刷薄油再烤，外脆内软不发硬。，值得留意。",
    "趁热擦蒜，香气才渗得进面包里。，值得留意。",
    "番茄泥铺好马上吃，放久面包会泡软。，值得留意。"
  ],
  "common_mistakes": [
    "面包烤太久，咬起来像石头一样硬。，务必避免。",
    "番茄泥提前拌好放着，出水把面包泡烂。",
    "蒜擦太多次，蒜味盖过番茄的清甜。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "面包",
      "substitute": "法棍",
      "ratio": "330 克:330 克",
      "note": "切斜片，烤制时间减一分钟。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "40 毫升:40 克",
      "note": "奶香更浓，刷量减半以免油腻。"
    }
  ],
  "variations": [
    "铺一层火腿片，做成加泰罗尼亚常见版本。",
    "撒少许黑胡椒，味道更有层次。，也很受欢迎。"
  ],
  "serving_suggestion": "当早餐或前菜配一杯咖啡或气泡酒都很合适。",
  "storage": "面包冷藏一天，番茄泥须现做现用。，效果更稳定。",
