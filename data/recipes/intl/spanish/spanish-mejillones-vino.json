  "steps": [
    {
      "n": 1,
      "text": "青口逐个刷洗外壳，扯掉须丝，闭不上的和破壳的挑出来丢掉。",
      "time_min": 20,
      "heat": "无火",
      "tip": "破壳和闭不上的青口不新鲜，一定要挑掉。",
      "visual_cue": "外壳干净无泥沙，须丝去净"
    },
    {
      "n": 2,
      "text": "汤锅倒橄榄油中火炒香洋葱末与蒜末，炒到洋葱透明发软。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒到透明才甜，这一步决定汤底的味道。",
      "visual_cue": "洋葱半透明，蒜末香气散出"
    },
    {
      "n": 3,
      "text": "倒入白葡萄酒煮开，让酒精挥发一分钟，汤汁略减。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酒要先煮开去生酒味，剩下的才是酒香。",
      "visual_cue": "汤汁微滚，酒气冲鼻后转香"
    },
    {
      "n": 4,
      "text": "倒入青口翻匀，加盖大火焖四分钟至贝壳全部张开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "大火加盖焖，蒸汽让青口快速开口不老。",
      "visual_cue": "贝壳张开，汤汁变成乳白色"
    },
    {
      "n": 5,
      "text": "开盖加盐与黑胡椒调味，撒一半欧芹碎翻匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "盐别多放，青口本身带海水咸味。",
      "visual_cue": "汤汁清亮微白，青口肉饱满"
    },
    {
      "n": 6,
      "text": "连汤汁一起倒进深盘，撒剩余欧芹，配柠檬角上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汤汁是精华，一定要一起盛出来蘸面包。",
      "visual_cue": "青口堆成小山，汤汁没过底部"
    }
  ],
  "tips": [
    "青口要逐个刷洗并扯掉须丝，泥沙最影响口感。",
    "闭不上的青口直接丢掉，说明已经死了。",
    "白葡萄酒煮开一分钟去生酒味，只留酒香。",
    "汤汁别倒掉，拿烤过的面包片蘸着吃，比青口肉还香。"
  ],
  "common_mistakes": [
    "青口没吐沙就下锅，吃一口满嘴沙。",
    "闭壳的也一起煮，端上桌还闭着说明已死。",
    "焖太久，青口肉缩成一小团又老又韧。",
    "盐下多了，青口本身带咸，一锅咸得下不去口。"
  ],
  "substitutions": [
    {
      "original": "白葡萄酒",
      "substitute": "高汤",
      "ratio": "180毫升:200毫升",
      "note": "无酒版，加几滴柠檬汁补酸。"
    },
    {
      "original": "青口",
      "substitute": "蛤蜊",
      "ratio": "1200克:1000克",
      "note": "吐沙两小时，焖的时间加一分钟。"
    }
  ],
  "variations": [
    "加一勺淡奶油同煮，汤汁更浓，蘸面包一流。",
    "放一点干辣椒碎同炒，微辣更开胃，汤汁也更香。",
    "加番茄丁同焖，汤汁带酸甜，颜色也好看。"
  ],
  "serving_suggestion": "连锅或深盘端上桌，撒欧芹配柠檬角，配烤面包片蘸汤汁，再开一瓶同款白葡萄酒。",
  "storage": "冷藏可放一天，复热加两勺水小火煮三分钟，贝类不宜反复加热。",
