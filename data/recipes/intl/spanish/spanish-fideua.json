  "equipment": [
    "平底锅",
    "锅铲",
    "刀",
    "砧板",
    "汤锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面条掰成三四厘米的短段，摊在盘里晾着备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "掰得越短越容易平铺，受热也更均匀。",
      "visual_cue": "面段短小，平铺不叠"
    },
    {
      "n": 2,
      "text": "虾仁去壳挑掉虾线，用少许盐抓洗后沥干水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "虾线挑净，腥味才不会带进整锅面里。",
      "visual_cue": "虾仁干净，颜色透亮"
    },
    {
      "n": 3,
      "text": "番茄擦成泥，洋葱切碎末，蒜切成细末，藏红花泡水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "藏红花用温水泡开，颜色和香气才出得来。",
      "visual_cue": "番茄成泥，藏红花水橙黄"
    },
    {
      "n": 4,
      "text": "平底锅倒橄榄油烧热，下面条段中小火煎到通体金黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "面条煎到发黄才有坚果香，别煎到发黑。",
      "visual_cue": "面段金黄，香气焦香"
    },
    {
      "n": 5,
      "text": "把面段推到一边，下洋葱末和蒜末炒到透明出香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱蒜末用锅边的油炒，不易糊也不抢味。",
      "visual_cue": "洋葱透明，蒜末微黄"
    },
    {
      "n": 6,
      "text": "加番茄泥炒出红油，撒盐翻匀后倒入清水和藏红花水。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄泥炒出红油，汤底才浓稠红亮。",
      "visual_cue": "汤汁红亮，油面泛光"
    },
    {
      "n": 7,
      "text": "汤烧开后铺上面段，转小火焖十分钟至汤汁被吸干。",
      "time_min": 10,
      "heat": "小火",
      "tip": "面段平铺不搅，底部才能结出微焦的锅巴。",
      "visual_cue": "汤汁收干，面段鼓起"
    },
    {
      "n": 8,
      "text": "放上虾仁继续焖三分钟，关火静置五分钟再上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "虾仁最后三分钟才放，久煮会缩水变硬。",
      "visual_cue": "虾仁变红，面条松散"
    }
  ],
  "tips": [
    "面条先煎到金黄，香气才接近餐馆版本。",
    "汤汁被吸干就关火，久焖面条会糊底。",
    "虾仁最后三分钟放，口感才弹嫩不老。"
  ],
  "common_mistakes": [
    "面条不煎直接煮，软烂没有半点焦香。",
    "中途不停搅拌，锅底结不出那层锅巴。",
    "虾仁一开始就下锅，最后缩成硬粒。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "200 克:220 克",
      "note": "切小块先煎至金黄再焖。"
    },
    {
      "original": "藏红花",
      "substitute": "姜黄",
      "ratio": "0.2 克:1 克",
      "note": "颜色相近，香气略淡。"
    }
  ],
  "variations": [
    "加几只完整虾仁同焖，海味更浓更鲜甜。",
    "出锅挤几滴柠檬汁，酸香解腻更清爽。"
  ],
  "serving_suggestion": "配上蒜香蛋黄酱一起上桌，趁热吃锅底那层焦香面。",
  "storage": "冷藏一天，复热加少许水小火焖透。",
