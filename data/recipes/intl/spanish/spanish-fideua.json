  "steps": [
    {
      "n": 1,
      "text": "意大利面掰成四厘米长的短段，摊开备用，虾仁去壳挑干净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "意大利面掰短才好铺平受热，太长会翘起。",
      "visual_cue": "意大利意大利面段长短一致，虾仁完整"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油炒香洋葱末与蒜末，加番茄丁炒到出汁变稠。",
      "time_min": 9,
      "heat": "中火",
      "tip": "番茄要炒出红汁，酱底才够浓。",
      "visual_cue": "番茄软烂出汁，锅底红色酱汁"
    },
    {
      "n": 3,
      "text": "撒甜椒粉炒匀，倒白葡萄酒煮开，把虾仁下锅煎到变色后先盛出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "虾仁先煎后放回，久煮会变老发韧。",
      "visual_cue": "虾仁卷曲发红，锅底酒香散出"
    },
    {
      "n": 4,
      "text": "把意大利意大利面段倒进锅里，中火干炒三分钟，让意大利面裹上酱汁并微微焦香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "意大利面先干炒再煮，成品才粒粒分明不粘。",
      "visual_cue": "意大利意大利面段均匀上色，散出坚果香"
    },
    {
      "n": 5,
      "text": "倒入高汤没过意大利面，加盐调味，中火煮十分钟不加盖。",
      "time_min": 12,
      "heat": "中火",
      "tip": "这道菜不加盖不搅拌，靠汤汁自己收干。",
      "visual_cue": "汤面冒泡，意大利面逐渐吸干汤汁"
    },
    {
      "n": 6,
      "text": "摆上青口与虾仁，转小火焖五分钟至贝壳张开，撒欧芹即可。",
      "time_min": 7,
      "heat": "小火",
      "tip": "贝壳不张的要丢掉，闭壳说明不新鲜。",
      "visual_cue": "贝壳全部张开，汤汁几乎收干"
    }
  ],
  "tips": [
    "意大利面先干炒再煮，成品才松散不粘成块。",
    "全程不加盖不搅动，底部的焦香层是精华。",
    "虾仁先煎再回锅，口感才嫩不柴。",
    "高汤一次加足，中途加水会毁掉意大利面的口感。"
  ],
  "common_mistakes": [
    "意大利面直接下汤煮，最后糊成一锅粘团。",
    "不停搅拌，意大利面断成碎末，锅底也起不了焦香。",
    "汤汁加太多，煮完还是汤面而不是干面。",
    "青口闭壳的也一起下锅，吃出腥味。"
  ],
  "substitutions": [
    {
      "original": "青口",
      "substitute": "蛤蜊",
      "ratio": "300克:300克",
      "note": "吐沙要足，鲜味更清。"
    },
    {
      "original": "意大利面",
      "substitute": "米形面",
      "ratio": "300克:280克",
      "note": "更接近米饭口感，煮的时间减两分钟。"
    }
  ],
  "variations": [
    "加一小撮藏红花，颜色金黄，香气也更地道。",
    "换成全海鲜版本，加鱿鱼圈和扇贝一起焖。",
    "出锅前挤半个柠檬，酸味解腻更清爽。"
  ],
  "serving_suggestion": "连锅端上桌，摆上青口和虾仁，撒欧芹，配一碟蒜香蛋黄酱，每人从锅里直接盛。",
  "storage": "冷藏可放一天，复热加两勺高汤小火焖三分钟，微波加热会让意大利面发硬。",
