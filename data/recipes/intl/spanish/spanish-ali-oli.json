      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 120,
          "unit": "g",
          "note": "只用蛋黄",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 200,
          "unit": "ml",
          "note": "初榨橄榄油",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 20,
          "unit": "g",
          "note": "去皮压泥",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "挤汁",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "去腥",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "研钵",
    "打蛋器",
    "小碗",
    "密封瓶"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大蒜去皮压成细泥，加盐用研钵磨到完全看不见颗粒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜泥必须磨细，粗蒜末做出来的酱会呛辣，还卡舌头。",
      "visual_cue": "蒜泥乳白细腻，闻着浓香"
    },
    {
      "n": 2,
      "text": "蛋黄放室温回温，加蒜泥与白胡椒打散到颜色均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋要回温再打，冷蛋液遇油容易油水分离，酱会散成两团。",
      "visual_cue": "蛋黄液顺滑，颜色略深"
    },
    {
      "n": 3,
      "text": "橄榄油分几十次极少量淋入，边淋边不停搅打到乳化。",
      "time_min": 7,
      "heat": "无火",
      "tip": "油一定要一点点加，一次倒多了立刻分离，这步急不得。",
      "visual_cue": "酱体浓稠发亮，纹路不散"
    },
    {
      "n": 4,
      "text": "搅到稠得能挂住打蛋器，挤柠檬汁与补盐调开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁别早放，早加酸会让蛋黄提前结块，油吸不进去。",
      "visual_cue": "酱体乳白细腻，尝着酸咸平衡"
    },
    {
      "n": 5,
      "text": "装进干净玻璃瓶，表面抹平，冷藏静置一小时后使用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "装瓶后停一小时，蒜味和油熟起来，味道比现做柔和得多。",
      "visual_cue": "酱面平整光滑，瓶壁挂一层白"
    }
  ],
  "tips": [
    "蒜香蛋黄酱是加泰罗尼亚的万能酱，蘸烤蔬菜和炸薯块都行。",
    "传统做法只用蒜和油，靠研钵反复磨到乳化，不用蛋黄。",
    "抹在三明治里替代黄油，香气比普通蛋黄酱更冲。"
  ],
  "common_mistakes": [
    "油一次倒太多，酱体突然分离，怎么搅都救不回来。",
    "蒜没磨细就拌进去，成品辣得呛喉咙，压过了油香。",
    "冷藏超过三天还继续吃，蛋黄的腥味已经出来。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "淡奶油",
      "ratio": "120克:100毫升",
      "note": "奶油版更清淡，但乳化稳定性差，需当天用完。"
    },
    {
      "original": "柠檬",
      "substitute": "米醋",
      "ratio": "30克:20毫升",
      "note": "米醋版酸味更直，用量减半以免过酸。"
    }
  ],
  "variations": [
    "加一小勺藏红花泡水，做成金黄色蒜香酱，配海鲜最搭。",
    "放半个烤过的蒜头替代生蒜，辣味柔和，甜香更明显。"
  ],
  "serving_suggestion": "盛小碗中，淋在烤蔬菜、炸薯块或烤鱼上，也可抹面包。",
  "storage": "冷藏密封可存三天，出现油水分离或发酸异味即不可再用。",
