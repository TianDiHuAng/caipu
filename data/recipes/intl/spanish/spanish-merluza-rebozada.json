  "equipment": [
    "油炸锅",
    "漏勺",
    "厨房纸",
    "浅盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼块用厨房纸吸干，两面撒盐与黑胡椒腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱼块表面要干，带水下油锅会爆得很凶。",
      "visual_cue": "鱼块表面干爽，盐粒均匀"
    },
    {
      "n": 2,
      "text": "鱼块先在面粉里滚一圈，抖掉多余粉末，再蘸一层蛋液。",
      "time_min": 6,
      "heat": "无火",
      "tip": "粉要抖干净，裹太厚一咬全是面壳，鱼味全无。",
      "visual_cue": "薄薄一层粉，蛋液挂匀"
    },
    {
      "n": 3,
      "text": "植物油烧到一百七十度，鱼块顺着锅边滑下去炸到浅金。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温不够鱼会吸油发腻，撒一点面糊试，起泡就够热。",
      "visual_cue": "油面起细泡，鱼块浮起"
    },
    {
      "n": 4,
      "text": "翻面再炸三分钟，捞出放在厨房纸上把浮油沥干。",
      "time_min": 4,
      "heat": "中火",
      "tip": "起锅后别马上叠放，蒸汽一闷外壳就软塌。",
      "visual_cue": "外壳金黄，纸吸出油痕"
    },
    {
      "n": 5,
      "text": "另起小锅用橄榄油小火炒香蒜片，做成蒜香油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜片一变黄就关火，余温会继续加深，焦了会苦。",
      "visual_cue": "蒜片微黄，油香扑鼻而来"
    },
    {
      "n": 6,
      "text": "鱼块装盘，淋一勺蒜香油撒上欧芹，配柠檬角一起上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬角挤汁前先在手心压一下，汁水出得更多。",
      "visual_cue": "外壳金黄，柠檬角翠黄"
    }
  ],
  "tips": [
    "炸鳕鱼是西班牙酒馆里最常见的下酒菜，面衣薄是它的关键。",
    "油温控制在一百七十度，低了下油，高了外焦里生。",
    "配一杯冰啤酒，比什么酱汁都合适。"
  ],
  "common_mistakes": [
    "面衣裹太厚，咬开一半都是面，鱼味尝不出来。",
    "油温太低，鱼块吸饱油，吃完满嘴油。",
    "炸好叠在一起放，外壳全被蒸汽闷软。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "沙丁鱼",
      "ratio": "600克:500克",
      "note": "沙丁鱼体型小，炸的时间缩短到三分钟。"
    },
    {
      "original": "面粉",
      "substitute": "面包糠",
      "ratio": "120克:100克",
      "note": "面包糠版更脆，但要注意火候，容易焦。"
    }
  ],
  "variations": [
    "面糊里加一勺红椒粉，颜色红亮，香气也更足。",
    "换成整条小鱼下锅炸，头尾酥脆，是最家常的做法。"
  ],
  "serving_suggestion": "趁热装盘，配柠檬角和一杯冰镇啤酒，再撒一点海盐。",
  "storage": "建议现炸现吃，冷藏后外壳回软，复炸三十秒可恢复脆度。",
