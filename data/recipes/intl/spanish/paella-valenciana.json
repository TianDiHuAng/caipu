  "equipment": [
    "双耳平底锅",
    "木铲",
    "厨房布",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾去壳留头，青口刷净外壳，洋葱与大蒜切末，番茄擦成泥备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "番茄擦泥比切块更容易熬进米里。",
      "visual_cue": "料头齐备、番茄成泥"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油中火烧热，下虾与青口煎至变色卷曲，先盛出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "海鲜只煎定型，后面还会回锅。",
      "visual_cue": "虾身变红、青口开口"
    },
    {
      "n": 3,
      "text": "原锅下洋葱末与蒜末炒香，加红椒丁与番茄泥炒五分钟至汤汁发暗。",
      "time_min": 8,
      "heat": "中火",
      "tip": "番茄泥要炒到发暗，甜味才出来。",
      "visual_cue": "锅底泛红、水分基本收干"
    },
    {
      "n": 4,
      "text": "下大米与红椒粉翻炒两分钟，让每一粒米都裹上油与料汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "米炒过才粒粒分明不粘连。",
      "visual_cue": "米粒油亮、颗颗分开"
    },
    {
      "n": 5,
      "text": "淋白葡萄酒煮至酒气散尽，加盐，倒入泡了藏红花的热高汤与香叶煮开。",
      "time_min": 5,
      "heat": "大火",
      "tip": "高汤要热，冷水会让米粒夹生。",
      "visual_cue": "汤汁沸腾、颜色金黄"
    },
    {
      "n": 6,
      "text": "转小火煮十八分钟，中途不要搅动，让米在锅底结出薄薄焦层。",
      "time_min": 18,
      "heat": "小火",
      "tip": "不搅动才有锅巴，这是灵魂。",
      "visual_cue": "汤汁基本被米粒吸收"
    },
    {
      "n": 7,
      "text": "摆回虾与青口，撒豌豆与黑胡椒再焖八分钟，关火盖布静置五分钟。",
      "time_min": 13,
      "heat": "小火",
      "tip": "静置让余温把米芯焖透。",
      "visual_cue": "米粒饱满、青口全部张口"
    }
  ],
  "tips": [
    "高汤必须提前加热，冷汤下锅会让米粒夹生。",
    "下米后不要搅动，锅底那层焦香锅巴是精髓。",
    "关火后盖布静置五分钟，米芯才彻底焖透。"
  ],
  "common_mistakes": [
    "用冷水或凉高汤一次倒入，米粒外层糊化、里面发硬。",
    "中途不停搅动，米饭变成一锅稠粥。",
    "藏红花直接撒干粉下锅，颜色和香气都出不来。"
  ],
  "substitutions": [
    {
      "original": "藏红花",
      "substitute": "姜黄粉",
      "ratio": "0.5g 对 2g",
      "note": "颜色接近，香气差一截。"
    },
    {
      "original": "青口",
      "substitute": "蛤蜊",
      "ratio": "200g 对 250g",
      "note": "鲜味相近，需提前吐沙。"
    }
  ],
  "variations": [
    "瓦伦西亚农家版：加 150g 鸡腿肉与 80g 四季豆，不放海鲜。",
    "墨鱼汁版：高汤里加 10g 墨鱼汁，做成黑米饭。"
  ],
  "serving_suggestion": "连锅端上桌，配柠檬角挤汁，用木勺从锅边往中间分盛。",
  "storage": "现做现吃最好，冷藏可存 1 天，复热需加盖小火蒸透。",
