  "equipment": [
    "平底锅",
    "木勺",
    "砧板",
    "汤锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍沥干，摊在盘里晾十分钟让表面水分走掉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "米粒表面干爽，炒的时候才不粘锅，也不容易糊成一团。",
      "visual_cue": "米粒干爽松散，粒粒分明不粘连"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油，下洋葱末与蒜片小火炒到洋葱透明。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱要炒出甜味再下其他菜，急火只会把蒜炒焦发苦。",
      "visual_cue": "洋葱透明软塌，蒜片浅黄"
    },
    {
      "n": 3,
      "text": "加番茄碎炒成浓酱，撒辣椒粉，炒到酱汁颜色变深红。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄一定要炒到出水再收干，生番茄直接加水，饭会发酸发水。",
      "visual_cue": "酱汁浓稠发亮，锅底见红油"
    },
    {
      "n": 4,
      "text": "下青椒丁、胡萝卜丁与豌豆翻炒两分钟，加盐调味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豌豆用冷冻的可以直接下锅，新鲜的要先焯水去生豆味。",
      "visual_cue": "蔬菜断生，颜色鲜亮有光泽"
    },
    {
      "n": 5,
      "text": "倒入大米翻炒到每粒都裹上酱汁，加清水煮开后转小火。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水一次加足，中途补水会让米粒外烂内硬，口感全毁。",
      "visual_cue": "米粒裹红，水面没过米一指"
    },
    {
      "n": 6,
      "text": "盖盖小火焖十八分钟，关火再焖五分钟，撒欧芹碎上桌。",
      "time_min": 23,
      "heat": "小火",
      "tip": "关火后焖五分钟让水汽回匀，立刻开盖饭粒会外湿内硬。",
      "visual_cue": "饭粒吸干水，锅边微焦"
    }
  ],
  "tips": [
    "蔬菜饭是西班牙人平常日子里的主食，比海鲜饭省事得多。",
    "用短粒米才吸得住汤汁，长粒米做出来汤汤水水。",
    "喜欢锅巴可以在最后两分钟开大火，听到轻微噼啪声就关火。"
  ],
  "common_mistakes": [
    "米没沥干就下锅炒，粘成一坨，怎么翻都散不开。",
    "番茄没炒透就加水，整锅饭发酸发水，味道单薄。",
    "中途揭盖补水，米粒外烂内硬，锅底还糊一层。"
  ],
  "substitutions": [
    {
      "original": "豌豆",
      "substitute": "青豆",
      "ratio": "100克:100克",
      "note": "青豆罐头需先沥干水分再下锅。"
    },
    {
      "original": "青椒",
      "substitute": "红椒",
      "ratio": "150克:150克",
      "note": "红椒版颜色更亮，甜度也更高。"
    }
  ],
  "variations": [
    "加一把泡发的鹰嘴豆同焖，饱腹感更强，是西班牙南部的做法。",
    "放几片西班牙香肠同炒，油脂渗进饭里，香气更足。"
  ],
  "serving_suggestion": "连锅端上桌，撒欧芹碎，配一碟蒜香蛋黄酱一起食用。",
  "storage": "冷藏可存两天，复热时淋一勺水加盖蒸热，勿干炒会变硬。",
