    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜面包撕成小块，用两百毫升高汤泡软备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "隔夜硬面包最好，新鲜面包一泡就烂成糊。",
      "visual_cue": "面包块吸足汤汁，捏起来软而不散"
    },
    {
      "n": 2,
      "text": "汤锅倒橄榄油小火加热，下蒜片与洋葱丝慢炒十分钟至金黄发甜。",
      "time_min": 13,
      "heat": "小火",
      "tip": "蒜片要炒到金黄不焦，甜味是汤的底子。",
      "visual_cue": "蒜片金黄柔软，洋葱透明发甜"
    },
    {
      "n": 3,
      "text": "撒入甜椒粉快速翻匀，立刻倒入泡好的面包块压碎炒两分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "甜椒粉遇高温立刻发苦，撒后马上倒面包。",
      "visual_cue": "面包吸油变深色，锅里香气浓郁"
    },
    {
      "n": 4,
      "text": "倒入剩余高汤，用汤勺把面包压散，大火煮开转小火熬十五分钟。",
      "time_min": 18,
      "heat": "小火",
      "tip": "边煮边压，面包才能散开变成浓汤。",
      "visual_cue": "汤体浓稠，面包完全化开"
    },
    {
      "n": 5,
      "text": "加盐与黑胡椒调味，把三只鸡蛋逐个磕进汤里，小火浸四分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蛋磕进汤里别搅动，静置才会成型。",
      "visual_cue": "蛋表面凝固发白，蛋黄仍软"
    },
    {
      "n": 6,
      "text": "连汤带蛋盛进碗里，撒欧芹碎，淋几滴橄榄油即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "每碗盛一只蛋，蛋黄完整是这道汤的卖点。",
      "visual_cue": "汤色深红，蛋卧在中央"
    }
  ],
  "tips": [
    "一定要用隔夜的硬面包，汤才浓稠不糊，新鲜面包一泡就烂。",
    "蒜片小火慢慢炒到金黄，炒焦整锅都苦。",
    "甜椒粉一撒就倒面包，高温久炒会发苦。",
    "鸡蛋下锅后别搅动，小火浸熟蛋黄才半流。"
  ],
  "common_mistakes": [
    "用新鲜面包代替硬面包，一煮就化成浆糊，汤完全没了口感。",
    "大蒜大火爆香，焦苦味盖住所有香味。",
    "鸡蛋下锅就搅，最后变成蛋花汤。",
    "汤熬得太咸，面包吸味后咸得下不去口。"
  ],
  "substitutions": [
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "900毫升:900毫升",
      "note": "素汤版，需多加三克盐提味。"
    },
    {
      "original": "甜椒粉",
      "substitute": "辣椒粉",
      "ratio": "4克:2克",
      "note": "辣度上升，用量要减半。"
    }
  ],
  "variations": [
    "加几片伊比利亚火腿丁同炒，鲜味提升明显。",
    "汤里放一小把葡萄干，甜咸对比很有趣。",
    "用鸡汤代替蔬菜高汤，汤体更厚重。"
  ],
  "serving_suggestion": "盛进陶碗，每碗卧一只蛋，撒欧芹淋橄榄油，配几片烤面包就是一顿暖胃的午饭。",
  "storage": "冷藏可放两天，复热小火加热别煮沸，蛋会变老。",
