    "平底锅",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄洗净在擦板上擦成泥，洋葱切细末，蒜切成薄片备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擦泥比切块更容易熬出红亮的汤底，这一步千万别省。",
      "visual_cue": "番茄泥细腻，无大块，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "汤锅放橄榄油小火烧热，下蒜片慢煎两分钟，煎到边缘泛黄出香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜片别煎黑，一焦整锅汤都带苦，火候和顺序都要留神。",
      "visual_cue": "蒜片金黄，油面发亮，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "倒入面条段中火翻炒五分钟，不停翻动煎到面条均匀金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎到发黄才有坚果香，这是关键，提前把配料备好再动手更稳。",
      "visual_cue": "面条深黄，颗粒分明，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "加洋葱末炒两分钟至变软，再倒入番茄泥炒三分钟至颜色变暗。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄泥炒到出油，汤色才红亮，这一步千万别省。",
      "visual_cue": "番茄泥浓稠，油边泛红，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "倒入清水搅匀，加盐和黑胡椒，煮开后转小火煮八分钟至面条变软。",
      "time_min": 10,
      "heat": "小火",
      "tip": "面条软透但仍有嚼劲就关火，火候和顺序都要留神。",
      "visual_cue": "汤色橙红，面条饱满，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "尝味后补盐，盛入汤碗，撒上小葱碎，趁热端上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汤要趁热喝，放久面条会继续吸水，提前把配料备好再动手更稳。",
      "visual_cue": "汤面清亮，葱花翠绿，颜色和形态变化明显"
    }
  ],
  "tips": [
    "面条一定要先用橄榄油煎到金黄，汤才会有坚果般的香，这是这道汤的骨架。",
    "番茄要擦成泥而不是切块，煮出来的汤才浓而不散。",
    "水一次加足，中途添水会把汤味冲淡，面条也容易糊。"
  ],
  "common_mistakes": [
    "面条直接扔进水里煮，汤色发白发寡，喝起来像白水泡面。",
    "番茄切大块下锅，煮二十分钟还是硬芯，汤也出不来红亮色。",
    "面条在汤里泡着等客，端上桌已经涨成一碗糊，完全没口感。"
  ],
  "substitutions": [
    {
      "original": "面条",
      "substitute": "通心粉",
      "ratio": "150克:150克",
      "note": "通心粉更耐煮，时间延长三分钟。"
    },
    {
      "original": "橄榄油",
      "substitute": "植物油",
      "ratio": "30毫升:30毫升",
      "note": "清香变淡，可加一瓣蒜补味。"
    }
  ],
  "variations": [
    "加两个水波蛋进去，汤更饱满，能当午餐主食用。",
    "把番茄换成南瓜泥同煮，颜色金黄，甜味更突出。"
  ],
  "serving_suggestion": "盛碗后撒小葱和现磨黑胡椒，趁热喝最香。",
  "storage": "冷藏可放一天，回热加半碗清水小火煮开，面条会继续吸水，汤量要留余地。",
