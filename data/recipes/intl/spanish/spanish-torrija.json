  "equipment": [
    "平底锅",
    "碗",
    "打蛋器",
    "刀",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包切成两厘米厚的片，隔夜的更合适。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "硬面包吸奶不烂，口感才好。，看准状态再往下做。",
      "visual_cue": "片厚均匀，边缘完整"
    },
    {
      "n": 2,
      "text": "牛奶加一半白糖、肉桂粉和柠檬皮，小火加热。，看准状态再往下做。",
      "time_min": 6,
      "heat": "小火",
      "tip": "奶别煮沸，边缘冒泡就关火。，看准状态再往下做。",
      "visual_cue": "奶色微黄，香气散出"
    },
    {
      "n": 3,
      "text": "热奶倒进盘里，面包片两面各浸三十秒。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "浸太久会散，浸太短不入味。，看准状态再往下做。",
      "visual_cue": "面包吸饱，仍成形，这一点很关键。"
    },
    {
      "n": 4,
      "text": "浸好的面包片摆盘，冷藏半小时定型。，看准状态再往下做。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冷藏后裹蛋液才不散。，看准状态再往下做。",
      "visual_cue": "片身紧实，表面不塌"
    },
    {
      "n": 5,
      "text": "鸡蛋打散，把面包片两面都裹上蛋液。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液裹满，煎时才成金黄外壳。，看准状态再往下做。",
      "visual_cue": "表面挂浆，无干处，这一点很关键。"
    },
    {
      "n": 6,
      "text": "平底锅倒橄榄油，中火把面包片煎到金黄。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "一面定型再翻，别急着动。，看准状态再往下做。",
      "visual_cue": "两面金黄，外壳鼓起"
    },
    {
      "n": 7,
      "text": "捞出沥油，趁热撒上剩余白糖和肉桂粉。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热撒糖，糖才粘得住。，看准状态再往下做。",
      "visual_cue": "表面挂糖，香气扑鼻"
    },
    {
      "n": 8,
      "text": "淋一勺蜂蜜，温热或放凉吃都可以。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蜂蜜最后淋，甜香才不流失。，看准状态再往下做。",
      "visual_cue": "蜜汁流下，色泽诱人"
    }
  ],
  "tips": [
    "用隔夜硬面包，浸奶后才不散。，这一点很关键。",
    "冷藏定型再煎，形状才完整。，这一点很关键。",
    "中火慢煎，糖分高的面包容易焦。，这一点很关键。"
  ],
  "common_mistakes": [
    "用新鲜软面包，一浸就烂。，这一点很关键。",
    "奶煮沸了再泡，面包全散。，这一点很关键。",
    "大火煎，外面焦黑里面还湿。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "面包",
      "substitute": "法棍",
      "ratio": "400 克:400 克",
      "note": "更硬，需多浸十秒。"
    },
    {
      "original": "蜂蜜",
      "substitute": "糖浆",
      "ratio": "40 克:40 克",
      "note": "更稀，注意别淋太多。"
    }
  ],
  "variations": [
    "用红酒代替牛奶浸泡，风味更成人向。",
    "表面撒杏仁片，口感更丰富。，这一点很关键。"
  ],
  "serving_suggestion": "复活节的传统甜点，温热吃最香。，这一点很关键。",
  "storage": "冷藏两天，复热平底锅小火两面各一分钟。",
