    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成四厘米见方的块，用盐与黑胡椒抓匀腌十五分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "带皮鸡腿肉最合适，煎出油脂才够香。",
      "visual_cue": "鸡块表面均匀沾满调料"
    },
    {
      "n": 2,
      "text": "鸡块表面薄薄裹一层面粉，抖掉多余的粉备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "薄粉锁住肉汁，煎完表面也更酥。",
      "visual_cue": "鸡块表面干爽细白，不见厚粉块"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油中火烧热，鸡皮朝下摆入锅中煎六分钟至金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸡皮朝下先煎，油脂逼出来才不腻。",
      "visual_cue": "鸡皮金黄酥脆，锅底积出鸡油"
    },
    {
      "n": 4,
      "text": "翻面再煎四分钟，把鸡块推到锅边，下蒜片与干辣椒小火炒香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蒜片小火慢炒，火大立刻焦苦。",
      "visual_cue": "蒜片浅金黄色，香气扑鼻不焦黑"
    },
    {
      "n": 5,
      "text": "倒白葡萄酒煮开，转中小火加盖焖八分钟至鸡肉熟透。",
      "time_min": 11,
      "heat": "中小火",
      "tip": "酒要先煮开挥发酸味，再盖盖焖入味。",
      "visual_cue": "汤汁浓缩一半，鸡块油亮"
    },
    {
      "n": 6,
      "text": "开盖收汁两分钟，撒欧芹碎翻匀，趁热装盘。",
      "time_min": 4,
      "heat": "中火",
      "tip": "欧芹最后撒，颜色翠绿香气也留得住。",
      "visual_cue": "汤汁裹住鸡块，表面撒满绿碎"
    }
  ],
  "tips": [
    "用带皮鸡腿肉，煎出的鸡油是这道菜的香味来源。",
    "鸡块薄薄裹粉再煎，表面酥且肉汁不外流。",
    "蒜片一定小火慢炒，一焦整锅都带苦味。",
    "白葡萄酒煮开后再焖，酸味挥发只留酒香。"
  ],
  "common_mistakes": [
    "鸡块不擦干就下锅，油溅得到处都是还不易上色。",
    "大火炒蒜片，两秒钟就焦黑发苦。",
    "鸡块没煎透就焖，出锅切开还带粉色。",
    "收汁收得太干，鸡块发干发柴，咬下去没有一点肉汁。"
  ],
  "substitutions": [
    {
      "original": "白葡萄酒",
      "substitute": "高汤",
      "ratio": "80毫升:100毫升",
      "note": "无酒版更清爽，盐可加一克。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "700克:650克",
      "note": "更瘦，焖的时间减三分钟。"
    }
  ],
  "variations": [
    "加一把青豆同焖，颜色更亮，口感也清爽。",
    "出锅前淋一勺雪莉酒醋，酸香让整道菜活起来。",
    "把鸡块换成兔肉，是西班牙内陆的传统做法。"
  ],
  "serving_suggestion": "鸡块连汤汁一起盛进深盘，撒欧芹碎，配炸土豆块或面包蘸汁，一瓶红酒刚好配这一盘。",
  "storage": "冷藏可放两天，复热加两勺水小火焖五分钟，微波加热会让鸡肉发柴。",
