  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "青椒",
          "name_en": "green bell pepper",
          "amount": 450,
          "unit": "g",
          "note": "小青椒整只",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 40,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "撒面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "铸铁锅",
    "碗",
    "锅铲",
    "厨房纸",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小青椒用清水冲洗干净，用厨房纸把表面水分彻底擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "小青椒必须擦干，带水下油锅会猛烈溅油。",
      "visual_cue": "青椒表面干爽，蒂部完整不破"
    },
    {
      "n": 2,
      "text": "铸铁锅大火空烧两分钟，倒橄榄油烧到微微冒烟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "锅要够热，青椒下锅才能立刻起虎皮斑。",
      "visual_cue": "油面泛起细烟，锅底油光波动"
    },
    {
      "n": 3,
      "text": "小青椒整只下锅，铺成一层不要重叠，煎两分钟至表皮起泡发皱。",
      "time_min": 3,
      "heat": "大火",
      "tip": "一层铺开才煎得匀，堆在一起会焖软出水。",
      "visual_cue": "表皮起白泡，局部出现焦斑"
    },
    {
      "n": 4,
      "text": "用夹子翻面再煎两分钟，让另一面也煎出焦斑并彻底变软。",
      "time_min": 3,
      "heat": "大火",
      "tip": "两面都要煎到起斑，青椒的甜味才出来。",
      "visual_cue": "青椒整体变软塌，两面都有虎皮"
    },
    {
      "n": 5,
      "text": "撒上海盐快速翻匀，让盐粒挂在青椒表面，趁热装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐要最后撒，早撒会出水把焦斑泡软。",
      "visual_cue": "盐粒清晰附着，青椒油亮微皱"
    }
  ],
  "tips": [
    "青椒一定擦干再下锅，否则油会溅得吓人。",
    "锅要烧到足够热，青椒才能煎出虎皮斑。",
    "整只下锅别切开，保留汁水才好吃。",
    "盐最后撒，撒早了青椒出水，焦斑就不脆了。"
  ],
  "common_mistakes": [
    "青椒带水下锅，油花四溅还容易烫伤。",
    "锅温不够就下青椒，煎出来是软塌塌的水煮味。",
    "青椒堆成一堆，下面的焖软上面还没熟。",
    "提前撒盐，青椒出水，表皮一点都不起皱。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "杭椒",
      "ratio": "450克:450克",
      "note": "辣度更高，海盐可略减。"
    },
    {
      "original": "橄榄油",
      "substitute": "玉米油",
      "ratio": "40毫升:40毫升",
      "note": "烟点更高，风味略淡。"
    }
  ],
  "variations": [
    "出锅后挤几滴柠檬汁，酸香解腻。",
    "撒一点粗粒红椒粉，颜色和香气都更足。",
    "配一碟蒜香蛋黄酱蘸着吃，是酒吧常见的搭法。"
  ],
  "serving_suggestion": "趁热装盘，撒足海盐，配冰啤酒或红酒当餐前小吃，用手直接拿着吃最地道。",
  "storage": "现做现吃最佳，冷藏可放一天，复热用大火快煎一分钟恢复焦香。",
