  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "青椒",
          "name_en": "green bell pepper",
          "amount": 450,
          "unit": "g",
          "note": "小个头",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 50,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "粗盐",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "切角",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "夹子",
    "盘",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小青椒洗净，用厨房纸彻底擦干表面水分。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "带水下锅会溅油，也煎不出虎皮。，看准状态再往下做。",
      "visual_cue": "椒身干爽，蒂头完整"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油，中大火烧到油面微微起烟。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温够高，青椒才起虎皮。，看准状态再往下做。",
      "visual_cue": "油面泛光，轻烟升起"
    },
    {
      "n": 3,
      "text": "小青椒整只下锅铺平，别重叠。，看准状态再往下做。",
      "time_min": 2,
      "heat": "中火",
      "tip": "铺平受热才均匀，别叠在一起。，看准状态再往下做。",
      "visual_cue": "椒身平铺，油泡翻起"
    },
    {
      "n": 4,
      "text": "一面煎两分钟到表皮起皱发褐再翻面。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "起虎皮再翻，香气才出来。，看准状态再往下做。",
      "visual_cue": "表皮起泡，颜色发褐"
    },
    {
      "n": 5,
      "text": "另一面同样煎到起皱，用夹子翻动检查。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "青椒软了就行，别煎成糊。，看准状态再往下做。",
      "visual_cue": "椒身变软，表皮斑驳"
    },
    {
      "n": 6,
      "text": "捞出放厨房纸上吸去多余油分。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "吸油后口感才清爽不腻。，看准状态再往下做。",
      "visual_cue": "纸面泛油，椒身干爽"
    },
    {
      "n": 7,
      "text": "装盘趁热撒粗盐，配柠檬角上桌。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热撒盐，盐才挂得住。，看准状态再往下做。",
      "visual_cue": "盐粒闪光，椒香扑鼻"
    }
  ],
  "tips": [
    "青椒要擦干，才能煎出虎皮。，这一点很关键。",
    "油温要够高，青椒才不软塌。，这一点很关键。",
    "趁热撒盐，咸味才均匀。，这一点很关键。"
  ],
  "common_mistakes": [
    "青椒带水下锅，油溅得到处都是。，这一点很关键。",
    "火太小，青椒煮软没焦香。，这一点很关键。",
    "盐撒太早，青椒出水变咸汤。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "尖椒",
      "ratio": "450 克:450 克",
      "note": "更辣，用量减半。"
    },
    {
      "original": "橄榄油",
      "substitute": "植物油",
      "ratio": "50 毫升:50 毫升",
      "note": "风味稍淡，用量可减。"
    }
  ],
  "variations": [
    "撒一点海盐片，口感更有层次。，这一点很关键。",
    "淋几滴香醋，酸香更清爽。，这一点很关键。"
  ],
  "serving_suggestion": "当餐前小食，配冰啤酒最爽。，这一点很关键。",
  "storage": "当日吃完，冷藏后口感变差。，这一点很关键。",
