  "equipment": [
    "厚底锅",
    "打蛋器",
    "滤网",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱与胡萝卜切细丁，厚底锅化开黄油，中小火炒到软而微焦。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "炒到锅底出现褐色小点，酱的焦香就有了底。",
      "visual_cue": "蔬菜丁转成浅褐色，锅底粘着薄薄焦层"
    },
    {
      "n": 2,
      "text": "撒入低筋面粉翻炒两分钟，炒到面粉发黄并散出坚果香。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "面粉一定要炒熟，生面粉味会毁掉整锅酱。",
      "visual_cue": "面粉松散结沙，颜色由白转浅棕"
    },
    {
      "n": 3,
      "text": "分三次倒入高汤，每倒一次都搅到没有颗粒再加下一次。",
      "time_min": 6,
      "heat": "中火",
      "tip": "热汤冲冷面糊最容易结块，慢慢搅就顺了。",
      "visual_cue": "酱体顺滑无颗粒，能挂住勺背"
    },
    {
      "n": 4,
      "text": "加入白葡萄酒与番茄膏，小火煮三十分钟，撇去表面浮沫。",
      "time_min": 30,
      "heat": "小火",
      "tip": "全程保持微沸就好，滚得太猛会把酱体煮散分离。",
      "visual_cue": "酱汁转成砖棕色，表面浮起细密泡沫"
    },
    {
      "n": 5,
      "text": "用滤网滤掉蔬菜渣，加盐与黑胡椒调味，表面抹一层橄榄油防结皮。",
      "time_min": 5,
      "heat": "无火",
      "tip": "滤过的酱更细腻，配肉丸和可乐饼都好看。",
      "visual_cue": "酱体细腻发亮，表面覆一层薄油膜"
    }
  ],
  "tips": [
    "没有牛肉高汤可用鸡汤加一勺牛肉膏替代，味道更薄但也能用。",
    "炒面糊时用木勺不停画圈，角落里的干粉才不会结块。",
    "一次多做一些分装冷冻，做肉丸或炖肉时直接加。",
    "最后调浓度用汤不用水，加水会稀释咸香。"
  ],
  "common_mistakes": [
    "面粉没炒熟就倒汤，整锅酱带有明显的生面粉味。",
    "汤一次全倒进去，面糊结成硬疙瘩很难挽救。",
    "大火滚煮半小时，酱汁水分收干后油水分离。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "20克:20毫升",
      "note": "风味更清爽，焦香稍淡。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "黑醋",
      "ratio": "60毫升:15毫升",
      "note": "更酸，可额外加一小勺白糖。"
    }
  ],
  "variations": [
    "加几片干牛肝菌同煮，鲜味层次立刻上一个档次。",
    "配炖牛肉时用同锅的肉汁代替部分高汤，风味更浓。"
  ],
  "serving_suggestion": "淋在肉丸、煎鸡腿或可乐饼上，也可作为炖菜的基础汤底。",
  "storage": "冷藏四天，冷冻三个月，复热时加少量高汤稀释。",
