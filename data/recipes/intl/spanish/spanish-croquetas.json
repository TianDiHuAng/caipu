  "equipment": [
    "小锅",
    "打蛋器",
    "冰箱",
    "炒锅",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油放小锅小火融化，加洋葱碎炒到透明。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒透，甜味才出来。，看准状态再往下做。",
      "visual_cue": "洋葱透明，香气柔和"
    },
    {
      "n": 2,
      "text": "下腊肠碎炒香，让油脂渗出。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "腊肠炒出油，面糊才够香。，看准状态再往下做。",
      "visual_cue": "腊肠出油，颜色变深"
    },
    {
      "n": 3,
      "text": "倒入面粉，小火不停搅拌炒两分钟。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面糊要炒透，否则有生面粉味。，看准状态再往下做。",
      "visual_cue": "面糊抱团，锅底发白"
    },
    {
      "n": 4,
      "text": "分五次倒入牛奶，每次都搅到完全吸收。，看准状态再往下做。",
      "time_min": 8,
      "heat": "小火",
      "tip": "分次加奶，面糊才不结块。，看准状态再往下做。",
      "visual_cue": "糊体顺滑，勺背挂浆"
    },
    {
      "n": 5,
      "text": "加盐和黑胡椒调味，搅到浓稠离锅。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糊要够稠，成形才不塌。，看准状态再往下做。",
      "visual_cue": "糊体厚重，能立住，这一点很关键。"
    },
    {
      "n": 6,
      "text": "倒进方盘抹平，表面贴保鲜膜冷藏两小时。，看准状态再往下做。",
      "time_min": 125,
      "heat": "无火",
      "tip": "冷藏定型，切块才不粘刀。，看准状态再往下做。",
      "visual_cue": "糊体变硬，按压回弹"
    },
    {
      "n": 7,
      "text": "取出切成小长条，依次裹面粉、蛋液和面包糠。，看准状态再往下做。",
      "time_min": 15,
      "heat": "无火",
      "tip": "三步裹法，外壳才贴得牢。，看准状态再往下做。",
      "visual_cue": "外壳均匀，无裸露，这一点很关键。"
    },
    {
      "n": 8,
      "text": "橄榄油烧到六成热，下可乐饼中火炸两分钟。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温别太高，否则外焦内生。，看准状态再往下做。",
      "visual_cue": "周围起泡，颜色金黄"
    },
    {
      "n": 9,
      "text": "捞出沥油，趁热吃外酥内流心。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃，里面才是流心的。，看准状态再往下做。",
      "visual_cue": "外壳酥脆，切开流糊"
    }
  ],
  "tips": [
    "面糊要炒透，否则有生面粉味。，这一点很关键。",
    "牛奶分次加，糊体才顺滑。，这一点很关键。",
    "冷藏两小时定型，切的时候才不塌。"
  ],
  "common_mistakes": [
    "糊太稀，下锅就散开。，这一点很关键。",
    "油温太高，外壳焦了里面凉的。，这一点很关键。",
    "不冷藏直接切，切一堆烂糊。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "腊肠",
      "substitute": "鸡腿肉",
      "ratio": "120 克:120 克",
      "note": "切更碎，先炒熟。"
    },
    {
      "original": "面包",
      "substitute": "面包糠",
      "ratio": "80 克:80 克",
      "note": "更省事，颗粒更细。"
    }
  ],
  "variations": [
    "内馅换成鳕鱼，做成海鲜可乐饼。，这一点很关键。",
    "加一点藏红花，颜色金黄更漂亮。，这一点很关键。"
  ],
  "serving_suggestion": "当开胃小食，配一杯冰啤酒。，这一点很关键。",
  "storage": "生坯冷冻一个月，炸前不需解冻。，这一点很关键。",
