  "equipment": [
    "炒锅",
    "木铲",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干鹰嘴豆提前一晚用清水泡发，挑去开裂坏豆，冲洗后沥干备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡豆的水要倒掉，豆腥味全在这一泡里。",
      "visual_cue": "豆粒饱满发胀，表皮光滑不皱"
    },
    {
      "n": 2,
      "text": "洋葱切成小丁，大蒜切末，番茄划十字烫后去皮切成小块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "番茄先去皮再切小块，炖出来的酱底才细腻不卷皮。",
      "visual_cue": "洋葱丁大小均匀，番茄块带汁"
    },
    {
      "n": 3,
      "text": "炒锅倒一半橄榄油，中小火把洋葱丁炒到透明，再下蒜末炒香。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "蒜末一定要后放，早下锅容易发苦发黑还带生辣味。",
      "visual_cue": "洋葱变软透亮，锅里有蒜香"
    },
    {
      "n": 4,
      "text": "加番茄块和红椒粉翻炒成浓稠酱底，中途倒入白葡萄酒煮开。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "白葡萄酒要等番茄出汁后再倒，酒气才散得掉。",
      "visual_cue": "酱汁红亮浓稠，能挂住铲子"
    },
    {
      "n": 5,
      "text": "下鹰嘴豆与清水没过食材，小火加盖炖十五分钟至入味。",
      "time_min": 15,
      "heat": "小火",
      "tip": "水别加太多，鹰嘴豆本身已经吸饱了水。",
      "visual_cue": "汤汁收浓一半，豆子边缘发软"
    },
    {
      "n": 6,
      "text": "放入菠菜段翻拌至塌软，加盐和黑胡椒调味即可出锅。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "菠菜下锅两分钟就够，久煮会发黄发涩。",
      "visual_cue": "菠菜深绿油亮，不见生涩水汽"
    }
  ],
  "tips": [
    "用罐装鹰嘴豆可省去泡发，直接冲洗后下锅炖十分钟就能入味。",
    "红椒粉分两次放，炒酱底放一半，出锅前撒一半，香气更立体。",
    "喜欢浓稠口感可留一勺鹰嘴豆压成泥，回锅能让酱汁更稠。"
  ],
  "common_mistakes": [
    "鹰嘴豆泡的时间不够，炖半小时中心还是硬心，咬着发咯。",
    "菠菜和番茄一起下锅，菠菜煮烂发黄，番茄还没出汁。",
    "全程大火收汁，锅底的红椒粉糊掉，整锅带苦焦味。"
  ],
  "substitutions": [
    {
      "original": "鹰嘴豆",
      "substitute": "白豆",
      "ratio": "400克:400克",
      "note": "白豆更绵软，炖的时间缩短五分钟。"
    },
    {
      "original": "菠菜",
      "substitute": "羽衣甘蓝",
      "ratio": "300克:250克",
      "note": "需多煮三分钟，口感更韧。"
    }
  ],
  "variations": [
    "加五十克腊肠丁先煸出油，整道菜立刻带上肉香，是安达卢西亚做法。",
    "出锅前打一个鸡蛋卧在酱汁里焖熟，就是农家常见的加蛋版本。"
  ],
  "serving_suggestion": "盛在浅口陶碗里，配一片烤过的乡村面包，蘸着酱汁吃最香。",
  "storage": "冷藏可存三天，第二天回锅时加两勺清水化开酱汁，味道更融。",
