          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "不粘锅",
    "打蛋碗",
    "硅胶铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进碗里，加两克盐和一点黑胡椒，用筷子打散到蛋黄蛋白混匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打匀即可，别打出厚厚一层泡沫。这一步别省，成品口感差别很明显。",
      "visual_cue": "蛋液均匀，颜色一致，锅里状态一目了然。"
    },
    {
      "n": 2,
      "text": "虾仁用厨房纸吸干表面水，撒一点盐和黑胡椒抓匀，静置三分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "表面干才香，湿的下锅会溅油。火候和顺序都要留神，别图快。",
      "visual_cue": "虾仁干爽，调料附着，颜色和形态变化清楚。"
    },
    {
      "n": 3,
      "text": "不粘锅中小火倒一半橄榄油，下蒜末炒三十秒出香，不要上色。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "蒜末一变色就会发苦，要盯着。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "蒜末微黄，油有香气，锅里状态一目了然。"
    },
    {
      "n": 4,
      "text": "放入虾仁煎两分钟，一面变色后翻面再煎一分钟至通体透亮卷曲。",
      "time_min": 4,
      "heat": "中火",
      "tip": "虾仁卷起就熟，久煎变硬。这一步别省，成品口感差别很明显。",
      "visual_cue": "虾仁卷曲，表面不透，颜色和形态变化清楚。"
    },
    {
      "n": 5,
      "text": "转小火倒入蛋液，用硅胶铲从锅边往中间慢推，让生蛋液流到锅底。",
      "time_min": 4,
      "heat": "小火",
      "tip": "慢慢推，别翻炒，蛋才会成大块。火候和顺序都要留神，别图快。",
      "visual_cue": "蛋液半凝，成大软块，锅里状态一目了然。"
    },
    {
      "n": 6,
      "text": "蛋液还有一点湿润时关火离锅，拌入小葱末，淋剩下的橄榄油装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "余温会把蛋收到刚好嫩的状态。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "蛋体湿润，无流液，颜色和形态变化清楚。"
    }
  ],
  "tips": [
    "蛋液打散就行，别打进太多空气，炒出来才绵密不起泡。",
    "虾仁下锅前用厨房纸吸干，遇油才香不溅。",
    "蛋液入锅后全程小火慢推，离火余温收尾最嫩。"
  ],
  "common_mistakes": [
    "大火炒蛋，十几秒就结成硬块，口感像橡皮。",
    "虾仁和蛋一起下锅，虾仁还没熟蛋已经老了。",
    "不停大力翻炒，蛋被搅成碎渣，装盘散得收不拢。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "蛤蜊肉",
      "ratio": "180克:180克",
      "note": "蛤蜊更易出水，须先焯后炒。"
    },
    {
      "original": "小葱",
      "substitute": "欧芹",
      "ratio": "10克:8克",
      "note": "香气更清，适合配海鲜。"
    }
  ],
  "variations": [
    "加一把熟土豆丁同炒，就是西班牙北部的家常版，更顶饱。",
    "出锅前淋一勺淡奶油快速拌两下，蛋体更润，适合配烤面包。"
  ],
  "serving_suggestion": "趁热铲进预热过的盘子，撒小葱末和黑胡椒，配烤面包片和一杯白葡萄酒。",
  "storage": "现炒现吃，炒蛋冷藏后口感变硬出水，不建议二次加热食用。",
