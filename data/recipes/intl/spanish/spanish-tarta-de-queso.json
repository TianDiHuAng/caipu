          "note": "淡奶油",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "分次加",
          "optional": false
        },
        {
          "name": "低筋面粉",
          "name_en": "cake flour",
          "amount": 20,
          "unit": "g",
          "note": "过筛",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "取皮屑",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "活底模",
    "打蛋器",
    "烤箱",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶油奶酪室温软化后加白糖，用刮刀压顺再打成细腻糊。",
      "time_min": 10,
      "heat": "无火",
      "tip": "奶酪一定要回温，冷的打不散会有颗粒。",
      "visual_cue": "奶酪糊顺滑无颗粒，能缓慢流动"
    },
    {
      "n": 2,
      "text": "鸡蛋一个一个加入，每次都搅到完全融合再加下一个。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一次加一个，蛋液才不会被奶酪拒水分离。",
      "visual_cue": "蛋液与奶酪完全融合，颜色变浅黄"
    },
    {
      "n": 3,
      "text": "倒入淡奶油与柠檬皮屑，加一小撮盐用刮刀拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬皮只刮黄色部分，白色会有苦味。",
      "visual_cue": "糊体浓稠发亮，香气清新"
    },
    {
      "n": 4,
      "text": "筛入低筋面粉，用刮刀翻拌到看不见干粉为止。",
      "time_min": 5,
      "heat": "无火",
      "tip": "翻拌时别画圈搅，起筋后面糊烤出来就不够细腻。",
      "visual_cue": "面糊均匀无干粉，提起刮刀缓慢滴落"
    },
    {
      "n": 5,
      "text": "倒进铺纸的活底模，烤箱两百二十度烤三十五分钟到表面焦褐。",
      "time_min": 35,
      "heat": "中火",
      "tip": "表面烤出深褐色斑点才是西班牙风格。",
      "visual_cue": "表面焦褐鼓起，轻晃中心微微颤动"
    },
    {
      "n": 6,
      "text": "出炉彻底放凉后冷藏四小时定型，再脱模切块食用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冷藏定型后切面才漂亮，热着切蛋糕会整块塌下去。",
      "visual_cue": "切面细腻，中心略软带流心感"
    }
  ],
  "tips": [
    "所有材料提前两小时回温，面糊才不容易分离。",
    "表面想要更深色，最后五分钟开热风。",
    "刀用热水烫过再切，切面干净不粘。",
    "配一勺酸奶油或莓果酱，酸甜平衡更好。"
  ],
  "common_mistakes": [
    "奶酪没软化就打，面糊里全是小颗粒，烤后口感粗糙。",
    "鸡蛋一次全加进去，糊体出现油水分离。",
    "烤好立刻脱模，蛋糕塌陷成中间凹陷的圆饼。"
  ],
  "substitutions": [
    {
      "original": "奶油奶酪",
      "substitute": "马斯卡彭芝士",
      "ratio": "500克:500克",
      "note": "更柔软，面粉加到三十克。"
    },
    {
      "original": "奶油",
      "substitute": "酸奶油",
      "ratio": "200克:200克",
      "note": "酸味更明显，糖加二十克。"
    }
  ],
  "variations": [
    "模具底铺一层消化饼干碎，做成带饼底的版本。",
    "拌入一把蓝莓，烤后爆浆酸甜，颜色也好看。"
  ],
  "serving_suggestion": "切块冷食，配一杯浓缩咖啡或一小勺莓果酱。",
  "storage": "冷藏四天，冷冻一个月，食用前提前两小时移到冷藏解冻。",
