  },
  "category": [
    "breakfast",
    "main-egg"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 20,
    "cook_min": 25,
    "total_min": 45
  },
  "servings": 4,
  "flavor": [
    "savory",
    "umami",
    "light"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "土豆",
          "name_en": "potato",
          "amount": 500,
          "unit": "g",
          "note": "切两毫米薄片",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 300,
          "unit": "g",
          "note": "约六枚，回温后打散",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 120,
          "unit": "ml",
          "note": "低温浸炸土豆用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 120,
          "unit": "g",
          "note": "切细丝，可不放",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "分两次撒入",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨，可选",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "不粘平底锅",
    "打蛋器",
    "大碗",
    "锅铲",
    "盘子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆削皮切成两毫米厚的薄片，用三克盐抓匀静置十分钟，倒掉渗出的水并用厨房纸吸干表面。",
      "time_min": 12,
      "heat": "无火",
      "tip": "土豆片一定要薄且干，带水下锅会溅油也不易煎软。",
      "visual_cue": "土豆片边缘半透明，表面干爽不粘连"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油烧到四成热，下土豆片和洋葱丝小火慢煎，中途翻动三四次避免粘底。",
      "time_min": 15,
      "heat": "小火",
      "tip": "油温不能高，土豆只需被油泡软而不是炸成薯片。",
      "visual_cue": "土豆片变软能弯曲，颜色浅黄不焦"
    },
    {
      "n": 3,
      "text": "捞出土豆洋葱沥油，把余下三克盐与黑胡椒撒入蛋液打散，再把沥干的土豆片拌进蛋液静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置这十分钟让土豆吸饱蛋液，煎好才不会层层分离。",
      "visual_cue": "蛋液被土豆吸收大半，碗底只剩薄薄一层"
    },
    {
      "n": 4,
      "text": "锅里留一大勺油，倒入土豆蛋液糊摊平，小火煎六分钟让底部定型，晃动锅确认能整块滑动。",
      "time_min": 7,
      "heat": "小火",
      "tip": "火太大会外焦内生，边缘先翘起来就说明底部定型了。",
      "visual_cue": "蛋饼边缘收紧泛金黄，中心仍微微晃动"
    },
    {
      "n": 5,
      "text": "取一个大于锅口的盘子扣住锅口翻面，再滑回锅内小火煎五分钟至中心凝固。",
      "time_min": 6,
      "heat": "小火",
      "tip": "翻面动作要快而稳，先锅后盘再回锅，别在空中翻转。",
      "visual_cue": "两面金黄，按压中心有弹性不出蛋液"
    },
    {
      "n": 6,
      "text": "出锅静置五分钟再切块，切面整齐不塌，冷吃热吃都合适。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刚出锅就切会散，静置能让内部结构收紧。",
      "visual_cue": "切面蛋体紧实，土豆片分层清晰"
    }
  ],
  "tips": [
    "油量看着多但大部分会沥出，油太少土豆煎不透只能煮软。",
    "传统做法只用土豆与蛋，加洋葱版本更甜润，两种都算正宗。",
    "煎好的蛋饼室温放凉两小时风味最好，是西班牙酒吧常见吃法。"
  ],
  "common_mistakes": [
    "土豆片切太厚，煎好后中心还是硬的。",
    "全程大火，外层焦黑而内部蛋液还在流动。",
    "蛋液拌好立刻下锅，土豆没吸汁导致切片时整层脱落。"
  ],
  "substitutions": [
    {
      "original": "橄榄油",
      "substitute": "食用油",
      "ratio": "1:1",
      "note": "风味稍逊但更适合高温操作。"
    },
    {
      "original": "洋葱",
      "substitute": "大葱白",
      "ratio": "120 克:100 克",
      "note": "甜味略淡，需多煎两分钟。"
    }
  ],
  "variations": [
    "拌入切碎的西班牙火腿或甜椒丁，可做成加料版本。"
  ],
  "serving_suggestion": "切三角块，配面包与一杯干型雪莉酒。",
  "storage": "冷藏两天，复热时用平底锅小火两面各煎一分钟。",
