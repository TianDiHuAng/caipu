  "equipment": [
    "不粘锅",
    "刀",
    "砧板",
    "碗",
    "锅铲",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成三毫米厚的薄片，洋葱切成细丝备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "土豆片一定要切薄切匀，太厚煎不透会夹生。",
      "visual_cue": "土豆片厚薄一致，边缘透光"
    },
    {
      "n": 2,
      "text": "不粘锅倒橄榄油炸土豆片与洋葱丝，中小火慢煎十五分钟至软而不焦。",
      "time_min": 17,
      "heat": "中小火",
      "tip": "油温别高，土豆是泡在温油里煮软而不是炸脆。",
      "visual_cue": "土豆片软塌透明，边缘微黄"
    },
    {
      "n": 3,
      "text": "用漏勺把土豆洋葱捞出沥油，土豆片用铲子轻轻压散成小块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "沥油彻底一点，蛋饼才不会油腻。",
      "visual_cue": "土豆片松软不成泥，漏勺上油滴干净"
    },
    {
      "n": 4,
      "text": "鸡蛋打散加盐与黑胡椒，倒入温热的土豆洋葱拌匀，静置五分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "热土豆拌蛋液才吸得进去，静置让蛋液裹匀。",
      "visual_cue": "蛋液浓稠挂住土豆，颜色金黄"
    },
    {
      "n": 5,
      "text": "锅留一大勺橄榄油中火烧热，倒入蛋液混合物，用铲子把边缘往中间推。",
      "time_min": 6,
      "heat": "中火",
      "tip": "边缘往里推能让蛋饼更厚实，中间不塌。",
      "visual_cue": "表面微微凝固，边缘圆整上翘"
    },
    {
      "n": 6,
      "text": "转小火加盖焖六分钟，翻面再焖四分钟，出锅前撒欧芹碎切块。",
      "time_min": 12,
      "heat": "小火",
      "tip": "翻面用一个平盘扣住倒扣，蛋饼才不会破。",
      "visual_cue": "两面金黄，切开内里湿润不流蛋液"
    }
  ],
  "tips": [
    "土豆片切薄切匀，煎出来才软糯不夹生。",
    "土豆要在温油里慢慢煮软，不是大火炸脆。",
    "蛋液和热土豆拌好后静置五分钟，味道更融合。",
    "翻面用盘子扣着倒扣，整块蛋饼完整不掉渣。"
  ],
  "common_mistakes": [
    "土豆片切太厚，煎完中间还是生的。",
    "油温太高把土豆炸成脆片，蛋饼就没有软糯感了。",
    "蛋液没裹匀就下锅，切开的蛋饼一层蛋一层土豆。",
    "开大火煎，底面焦黑而中心还在流蛋液。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "500克:500克",
      "note": "甜味更明显，煎的时间加两分钟。"
    },
    {
      "original": "洋葱",
      "substitute": "大葱",
      "ratio": "120克:100克",
      "note": "辛香更冲，甜味略淡。"
    }
  ],
  "variations": [
    "加几片西班牙香肠同煎，油脂渗进蛋饼里更香。",
    "喜欢溏心的可以缩短焖的时间，中间保留一点流动的蛋液。",
    "放凉后切块当餐前小吃，配面包吃很地道。"
  ],
  "serving_suggestion": "切成六块楔形，温热或放凉后食用都合适，配一杯红酒和几片面包就是西班牙人的家常午餐。",
  "storage": "冷藏可放两天，复热用平底锅小火两面各煎一分钟，微波加热会让蛋变韧。",
