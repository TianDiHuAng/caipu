        }
      ]
    }
  ],
  "equipment": [
    "研钵",
    "小锅",
    "料理棒",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "欧芹摘下叶片与嫩梗，用清水洗净后彻底沥干，摊在布上吸掉表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "叶子必须完全干，带水打出来的酱放两天就发酸变味。",
      "visual_cue": "叶片干爽无水，盆底一滴水都没有"
    },
    {
      "n": 2,
      "text": "大蒜去皮去芯切碎，与欧芹叶一起放进研钵，加盐慢慢捣成粗泥。",
      "time_min": 4,
      "heat": "无火",
      "tip": "研钵捣出来的酱比机器打的更香，叶子的纤维不会被绞成糊。",
      "visual_cue": "混合物成粗泥，能看见细碎叶粒"
    },
    {
      "n": 3,
      "text": "橄榄油分三次淋入，边淋边搅，让油和草泥完全融合成浓稠酱汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油要一点点加，一次倒完酱会分层，油浮在上面叶沉在底下。",
      "visual_cue": "酱体浓稠均匀，无油水分层"
    },
    {
      "n": 4,
      "text": "小锅小火加热酱汁到微微温热即离火，撒白胡椒，加清水调稠度。",
      "time_min": 4,
      "heat": "小火",
      "tip": "只需温热不要煮沸，一滚欧芹就发黄，清香也会变成熟菜味。",
      "visual_cue": "酱色翠绿，闻着蒜香扑鼻"
    }
  ],
  "tips": [
    "这款酱在西班牙常配煎鱼、烤蔬菜或水煮土豆，凉着吃也很清爽。",
    "做好的酱表面淋一层橄榄油封住，能多放两三天不发黑。",
    "欧芹选叶片厚实的平叶种，卷叶种香味淡，做酱不够劲。"
  ],
  "common_mistakes": [
    "用料理机高速打半分钟，叶子发热变褐，酱色发暗像泥浆。",
    "油一次全部倒入，酱汁分层，用的时候油叶各占一半。",
    "把酱煮开杀菌，欧芹的清香味全跑掉，只剩一股青草苦味。"
  ],
  "substitutions": [
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "130克:120克",
      "note": "香菜版风味更冲，适合配烤肉。"
    },
    {
      "original": "橄榄油",
      "substitute": "植物油",
      "ratio": "120毫升:120毫升",
      "note": "植物油版香气弱，需当天吃完。"
    }
  ],
  "variations": [
    "加一勺面包屑同捣，酱体更稠，是加泰罗尼亚配烤鱼的吃法。",
    "拌入少许柠檬皮屑，酸香更清，适合配生蚝与白灼海鲜。"
  ],
  "serving_suggestion": "装小碟配煎鱼或烤土豆，淋一勺在热菜上，香气立刻被激出来。",
  "storage": "密封冷藏可存五天，表面淋油封口；冷冻成小块可存一个月，用时直接取一块。",
