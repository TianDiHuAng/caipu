  "servings": 2,
  "flavor": [
    "fragrant",
    "spicy",
    "savory"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "虾仁",
          "name_en": "peeled shrimp",
          "amount": 300,
          "unit": "g",
          "note": "去壳留尾,擦干水分",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 30,
          "unit": "g",
          "note": "切薄片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 80,
          "unit": "ml",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "小米辣",
          "name_en": "bird's eye chili",
          "amount": 5,
          "unit": "g",
          "note": "切圈",
          "optional": false
        },
        {
          "name": "白葡萄酒",
          "name_en": "dry white wine",
          "amount": 30,
          "unit": "ml",
          "note": "增香,酒气须煮散",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 10,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 20,
          "unit": "g",
          "note": "切角",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "铸铁小锅",
    "刀",
    "砧板",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁用厨房纸彻底吸干水分，撒盐抓匀静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "虾仁越干越容易煎出香气，湿的只会出水。",
      "visual_cue": "虾仁表面干爽，略有黏感"
    },
    {
      "n": 2,
      "text": "大蒜切成均匀薄片，小米辣切圈，欧芹切碎备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蒜片厚薄一致，受热才均匀不发苦。",
      "visual_cue": "蒜片薄厚一致，边缘完整不碎"
    },
    {
      "n": 3,
      "text": "铸铁小锅倒一半橄榄油，冷油下蒜片小火慢炸至浅金色。",
      "time_min": 6,
      "heat": "小火",
      "tip": "冷油下蒜，香气才慢慢渗出，蒜片不焦。",
      "visual_cue": "蒜片薄厚一致，边缘完整不碎"
    },
    {
      "n": 4,
      "text": "下小米辣圈与虾仁，转中火摊平煎一分钟再翻面。",
      "time_min": 3,
      "heat": "中火",
      "tip": "别急着翻动，定型后再翻才不破皮。",
      "visual_cue": "虾仁边缘转白，底面微焦"
    },
    {
      "n": 5,
      "text": "沿锅边倒白葡萄酒，等酒气散尽后加剩余橄榄油与盐调味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酒要沿锅壁淋，遇热挥发才带出香气。",
      "visual_cue": "锅边起泡，香气扑鼻"
    },
    {
      "n": 6,
      "text": "关火撒欧芹碎，连锅端上桌配柠檬角，吃前挤汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "欧芹关火后再撒，颜色翠绿不发黄。",
      "visual_cue": "油面泛红，虾仁卷曲"
    }
  ],
  "tips": [
    "用厚底小铁锅，油温稳定，蒜片不容易焦。",
    "虾仁务必擦干，水分会让油爆且虾肉发韧。",
    "剩下的蒜香油蘸面包是另一种吃法，别浪费。"
  ],
  "common_mistakes": [
    "蒜片下锅火太大，几秒就焦黑发苦。",
    "虾仁没吸干就下锅，油花四溅且虾肉变柴。",
    "全程小火慢煮，虾仁煮老弹性尽失。"
  ],
  "substitutions": [
    {
      "original": "白葡萄酒",
      "substitute": "清酒",
      "ratio": "30 毫升:30 毫升",
      "note": "香气更清淡，同样需等酒气散尽。"
    },
    {
      "original": "小米辣",
      "substitute": "干辣椒",
      "ratio": "5 克:4 克",
      "note": "辣味更醇，需与蒜同下煸香。"
    }
  ],
  "variations": [
    "加一把小番茄同煮，酸甜味更适合夏天。",
    "把虾仁换成鱿鱼圈，做法完全相同。"
  ],
  "serving_suggestion": "连铸铁锅端上桌，配面包片蘸蒜油同食。",
  "storage": "最好现做现吃；冷藏一天后复热需小火加少许橄榄油。",
