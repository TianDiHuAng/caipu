          "name_en": "rice vinegar",
          "amount": 20,
          "unit": "ml",
          "note": "提酸",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "红椒粉",
          "name_en": "paprika",
          "amount": 5,
          "unit": "g",
