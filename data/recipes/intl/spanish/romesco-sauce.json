          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "料理机",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红椒与番茄切面对上摆在烤盘，大蒜带皮同放，淋 10ml 橄榄油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切面朝上更容易烤出焦痕。",
      "visual_cue": "蔬菜表面裹上一层薄油"
    },
    {
      "n": 2,
      "text": "烤箱 220 度烤 20 分钟，至红椒表皮起泡发黑、番茄软塌。",
      "time_min": 22,
      "heat": "大火",
      "tip": "烤到起泡才有烟熏香，这是酱的灵魂。",
      "visual_cue": "椒皮焦黑起泡、番茄出汁"
    },
    {
      "n": 3,
      "text": "取出蔬菜盖碗焖 5 分钟，撕去红椒与番茄的外皮，大蒜挤出去皮。",
      "time_min": 7,
      "heat": "无火",
      "tip": "焖一下皮就好撕。",
      "visual_cue": "表皮轻松剥离、椒肉柔软"
    },
    {
      "n": 4,
      "text": "杏仁用干锅小火烘 3 分钟至出香，放凉备用。",
      "time_min": 4,
      "heat": "小火",
      "tip": "杏仁烤过才够香，别烤糊。",
      "visual_cue": "杏仁微黄、香气明显"
    },
    {
      "n": 5,
      "text": "把蔬菜、杏仁、大蒜、欧芹、甜椒粉、米醋与 3g 盐放入料理机打碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先粗打再加油，质地更均匀。",
      "visual_cue": "混合物呈粗颗粒糊状"
    },
    {
      "n": 6,
      "text": "分三次倒入剩余 70ml 橄榄油，每次打 20 秒至酱体乳化发亮。",
      "time_min": 3,
      "heat": "无火",
      "tip": "慢慢加油，酱才不会油水分离。",
      "visual_cue": "酱体浓稠挂勺、颜色橙红"
    }
  ],
  "tips": [
    "红椒烤到表皮发黑，烟熏味才够正。",
    "橄榄油分次慢加，酱体才乳化顺滑。",
    "杏仁一定要烤香，生杏仁会让酱发涩。"
  ],
  "common_mistakes": [
    "蔬菜只烤到变软，酱缺少烟熏底味。",
    "橄榄油一次全倒，打出来油水分离。",
    "用带皮生杏仁直接打，口感粗涩发苦。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "榛子",
      "ratio": "80g 对 80g",
      "note": "风味更浓，烘烤时间加 1 分钟。"
    },
    {
      "original": "米醋",
      "substitute": "柠檬汁",
      "ratio": "20ml 对 20ml",
      "note": "酸味更清亮。"
    }
  ],
  "variations": [
    "加面包版：加 30g 烤面包块，酱体更稠厚。",
    "微辣版：加 3g 干辣椒同打。"
  ],
  "serving_suggestion": "配烤蔬菜、烤鱼或煎肉，也可当面包蘸酱。",
  "storage": "冷藏 5 天，表面淋一层橄榄油封存，取用前搅匀。",
