  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼去内脏与软骨，撕掉外膜，冲洗干净后用厨房纸吸干，鱿鱼须切碎备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "外膜不撕掉炖完会发韧，撕的时候从边缘慢慢揭。",
      "visual_cue": "鱿鱼筒雪白光滑，内壁干净"
    },
    {
      "n": 2,
      "text": "平底锅放一半橄榄油，下洋葱碎炒三分钟到透明，再加蒜末炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱要炒到发甜，馅料才有底味，别只炒到断生。",
      "visual_cue": "洋葱透明软塌，蒜香散出"
    },
    {
      "n": 3,
      "text": "下猪肉末与切碎的鱿鱼须，中火炒到肉末散开变色，加三克盐与黑胡椒调味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉末下锅先用铲子压散，结块后馅料口感会很粗糙。",
      "visual_cue": "肉末颗粒分明，颜色由粉转灰白"
    },
    {
      "n": 4,
      "text": "倒入白葡萄酒煮一分钟让酒精挥发，再加番茄泥与面包糠，炒到馅料收干成团。",
      "time_min": 5,
      "heat": "中火",
      "tip": "馅料太湿会把鱿鱼筒撑破，收干到能抱团就对了。",
      "visual_cue": "馅料抱团不散，锅底无明水"
    },
    {
      "n": 5,
      "text": "用勺子把馅料填进鱿鱼筒，只填七分满，开口处用牙签横插两三根封住。",
      "time_min": 8,
      "heat": "无火",
      "tip": "填太满一炖就爆开，七分满是安全线，鱿鱼受热还会收缩。",
      "visual_cue": "鱿鱼筒饱满有形，牙签固定牢靠"
    },
    {
      "n": 6,
      "text": "炖锅放剩下的橄榄油，中火把鱿鱼筒两面各煎一分钟，煎到表面泛白收紧。",
      "time_min": 4,
      "heat": "中火",
      "tip": "先煎定形再炖，鱿鱼才不会软塌变形。",
      "visual_cue": "鱿鱼表面收紧泛白，有轻微焦痕"
    },
    {
      "n": 7,
      "text": "加白葡萄酒、香叶与剩余盐，倒热水到鱿鱼一半高，小火盖盖炖二十五分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "中途翻一次面，让两面都吸到汤汁，入味才均匀。",
      "visual_cue": "汤汁微滚，鱿鱼筒鼓起饱满"
    },
    {
      "n": 8,
      "text": "开盖转中火收汁五分钟，汤汁变稠挂勺时关火，抽掉牙签切段装盘淋汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "收汁要不停舀汁淋在鱿鱼上，表面才不会干。",
      "visual_cue": "汤汁浓稠油亮，切面馅料紧实"
    }
  ],
  "tips": [
    "选中等大小的鱿鱼，太大肉厚难入味，太小又填不进馅。",
    "馅料里加一勺泡软的米饭，口感更松软，是渔村的传统做法。",
    "剩下的汤汁拌饭或蘸面包都极好，别倒掉。",
    "鱿鱼须别丢，切碎拌进馅里，鲜味会明显提升。"
  ],
  "common_mistakes": [
    "鱿鱼筒填得太满，炖的时候皮开肉绽，馅全散在汤里。",
    "大火炖煮，鱿鱼缩成一团橡皮，馅料却没熟透。",
    "不煎定形直接炖，鱿鱼软塌变形，切段时全散开。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "小墨鱼",
      "ratio": "600克:600克",
      "note": "肉更厚，炖制时间延长五分钟。"
    },
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉末",
      "ratio": "150克:150克",
      "note": "更清淡，需多加一勺橄榄油补润。"
    }
  ],
  "variations": [
    "加一把松子与葡萄干进馅料，做成加泰罗尼亚的甜咸版本。",
    "把馅换成纯蔬菜与米饭，做成素食酿鱿鱼，炖制时间缩短五分钟。"
  ],
  "serving_suggestion": "切段摆盘淋上浓汁，配烤面包与一杯干白，作为周末的主菜。",
  "storage": "冷藏两天内吃完，复热加一勺水小火慢炖五分钟；不建议反复加热，鱿鱼会越发坚韧。",
