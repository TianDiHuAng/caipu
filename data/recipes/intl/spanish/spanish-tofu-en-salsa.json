  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 400,
          "unit": "g",
          "note": "老豆腐，切两厘米厚片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 300,
          "unit": "g",
          "note": "熟透的，去皮切丁",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 100,
          "unit": "g",
          "note": "切细末",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 40,
          "unit": "ml",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 12,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "分次放",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 10,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "木铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切两厘米厚的片，用厨房纸包住压十分钟，把多余水分吸走。",
      "time_min": 3,
      "heat": "无火",
      "tip": "压水这一步别省，水分多下锅必粘，翻面就散。",
      "visual_cue": "豆腐片表面干爽，纸上有明显湿痕。"
    },
    {
      "n": 2,
      "text": "平底锅倒一半橄榄油，中火把豆腐片煎到两面金黄后盛出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "下锅后两分钟内别动，等底面结壳再翻，才不粘锅。",
      "visual_cue": "豆腐两面金黄，边缘略微鼓起。"
    },
    {
      "n": 3,
      "text": "原锅补剩下的橄榄油，下洋葱末小火炒到透明变软出甜味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "洋葱要炒到发甜，急火只会让它焦边而内部还生。",
      "visual_cue": "洋葱末透明发亮，锅底有焦糖色薄层。"
    },
    {
      "n": 4,
      "text": "加蒜末炒香，倒入番茄丁，中火炒六分钟到番茄完全出沙。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄出沙前别加水，靠自身水分收浓，酱汁才挂得住。",
      "visual_cue": "番茄化成浓稠红酱，铲子划过留痕。"
    },
    {
      "n": 5,
      "text": "放回豆腐片，加盐和黑胡椒，小火煨五分钟让豆腐吸味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "用铲子推锅底而不是翻豆腐，避免把豆腐片弄碎。",
      "visual_cue": "酱汁浓稠裹住豆腐，锅边冒小泡。"
    },
    {
      "n": 6,
      "text": "关火后撒入香菜碎，把豆腐连同浓稠的番茄酱汁一起盛进深盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火后静置一分钟再盛，酱汁会更稠一点。",
      "visual_cue": "豆腐片上挂着厚酱，盘底不流汁。"
    }
  ],
  "tips": [
    "豆腐先用厨房纸压十分钟去水，煎的时候才不粘锅、不溅油。",
    "番茄一定要炒到出沙，酱汁才有厚度，靠加水是补不出来的。",
    "橄榄油分两次用，煎豆腐一次、炒酱一次，风味层次更清楚。"
  ],
  "common_mistakes": [
    "嫩豆腐直接下锅煎，翻面就碎成豆腐渣，酱汁里全是碎屑。",
    "番茄没炒透就加豆腐同煮，酸味生硬，酱汁稀得像汤。",
    "盐一开始放足，收汁后咸得发苦，只能靠加糖补救。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "北豆腐",
      "ratio": "400克:400克",
      "note": "水分更少，煎出来更结实。"
    },
    {
      "original": "香菜",
      "substitute": "欧芹",
      "ratio": "10克:10克",
      "note": "更接近西班牙本地做法，香气清冽。"
    }
  ],
  "variations": [
    "加一小勺烟熏辣椒粉，酱汁立刻带上西班牙式的烟熏底味。",
    "把豆腐换成煎过的西葫芦厚片，同样吸汁，口感更软。"
  ],
  "serving_suggestion": "连酱汁一起盛盘，撒香菜碎，配烤面包片或白米饭，用面包把盘底的汁擦干净最香。",
  "storage": "冷藏可放两天，回锅时加一勺水小火煨热，豆腐久放会吸满汤汁、口感更实。",
