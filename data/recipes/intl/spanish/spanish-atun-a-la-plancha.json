    "夹子",
    "厨房纸",
    "刀",
    "砧板",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "金枪鱼排用厨房纸彻底吸干血水与表面水分，两面抹上一层橄榄油。",
      "time_min": 6,
      "heat": "无火",
      "tip": "鱼排干爽是煎出焦壳的前提，湿的只会出水。",
      "visual_cue": "鱼排干爽，泛出油光"
    },
    {
      "n": 2,
      "text": "两面撒上海盐、黑胡椒与红椒粉，静置五分钟让味道吃进去。",
      "time_min": 6,
      "heat": "无火",
      "tip": "盐只在煎之前撒，提前太久会逼出水分。",
      "visual_cue": "表面调味均匀，无堆积"
    },
    {
      "n": 3,
      "text": "铸铁锅大火烧到微微冒烟，倒一点橄榄油，放拍碎的大蒜爆香后捞掉。",
      "time_min": 4,
      "heat": "大火",
      "tip": "锅一定要够热，鱼下锅才会有脆壳。",
      "visual_cue": "锅面冒烟，蒜香升起"
    },
    {
      "n": 4,
      "text": "鱼排下锅，保持大火煎九十秒，中途不要翻动也不要压。",
      "time_min": 2,
      "heat": "大火",
      "tip": "只翻一次面，反复翻会把表面撕破。",
      "visual_cue": "贴锅一面结出褐色焦壳"
    },
    {
      "n": 5,
      "text": "用夹子翻面，再煎六十秒，侧面看鱼肉一半转白即可出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "中间留一点粉红才嫩，全熟就会发干。",
      "visual_cue": "外皮焦褐，中心微红"
    },
    {
      "n": 6,
      "text": "出锅后放在温热的盘子上静置两分钟，让肉汁重新分布。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置是嫩的关键，这一步别省。",
      "visual_cue": "切面湿润，汁水不外流"
    },
    {
      "n": 7,
      "text": "逆纹切成两厘米厚的片，撒欧芹碎，配柠檬角挤汁食用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "逆着纹理切，入口才不塞牙。",
      "visual_cue": "切面颜色分层，摆盘整齐"
    }
  ],
  "tips": [
    "金枪鱼选颜色深红、有弹性的部位，口感更接近牛肉。",
    "家里没有铸铁锅，用厚底平底不粘锅也能做出焦壳。",
    "配一层炒洋葱或烤彩椒，甜味能压住鱼的铁味。",
    "煎好的鱼不要再回锅加热，会瞬间变柴。"
  ],
  "common_mistakes": [
    "锅不够热就下鱼，鱼肉出水变成水煮，表面完全没有焦香。",
    "翻面太勤快，鱼排散成几块，卖相全毁。",
    "煎到全白才起锅，肉质又干又硬，白瞎了好鱼。"
  ],
  "substitutions": [
    {
      "original": "金枪鱼",
      "substitute": "旗鱼",
      "ratio": "400克:400克",
      "note": "肉质相近，需多煎三十秒。"
    },
    {
      "original": "红椒粉",
      "substitute": "黑胡椒",
      "ratio": "2克:2克",
      "note": "少了颜色，香气更单纯。"
    }
  ],
  "variations": [
    "煎好后淋一层番茄洋葱碎，做成安达卢西亚的冷拌吃法。",
    "用白芝麻裹满鱼身再煎，多一层坚果脆感。"
  ],
  "serving_suggestion": "两人份主菜，配烤彩椒、土豆块和一杯干白葡萄酒，趁热享用。",
  "storage": "冷藏一天内吃完，冷食可做沙拉；不建议复热，口感会明显变硬。",
