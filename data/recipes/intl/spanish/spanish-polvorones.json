    "cook_min": 18,
    "total_min": 38
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "低筋面粉",
          "name_en": "cake flour",
          "amount": 150,
          "unit": "g",
          "note": "先干炒去生粉味",
          "optional": false
        },
        {
          "name": "杏仁粉",
          "name_en": "almond flour",
          "amount": 150,
          "unit": "g",
          "note": "细磨，带天然油脂",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 120,
          "unit": "g",
          "note": "室温软化",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "糖粉",
          "name_en": "powdered sugar",
          "amount": 80,
          "unit": "g",
          "note": "比砂糖更易融合",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 3,
          "unit": "g",
          "note": "磨成粉",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "一撮提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "面粉筛",
    "烤箱",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "低筋面粉倒入干锅，小火不停翻动炒到微微发黄并散出麦香。",
      "time_min": 10,
      "heat": "小火",
      "tip": "炒粉是为了去掉粉的生味，也让饼更松散。",
      "visual_cue": "面粉泛浅黄、闻到坚果般麦香"
    },
    {
      "n": 2,
      "text": "炒好的低筋面粉离火晾凉，与杏仁粉、桂皮粉、盐一起过筛。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉必须完全凉透，热粉会把黄油融化。",
      "visual_cue": "粉料细腻蓬松、无颗粒"
    },
    {
      "n": 3,
      "text": "软化的黄油加糖粉，用刮刀压拌到顺滑发白，不需要打发。",
      "time_min": 6,
      "heat": "无火",
      "tip": "只要拌到无颗粒即可，打发会让饼膨胀开裂。",
      "visual_cue": "黄油霜状、颜色变浅"
    },
    {
      "n": 4,
      "text": "把粉料分两次压拌进黄油，拌到成团即可停止，不要反复揉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过度揉搓会出筋，烤完就不酥了。",
      "visual_cue": "面团松散抱团、按压有裂纹"
    },
    {
      "n": 5,
      "text": "面团擀成一厘米厚，用模具压出小圆饼，摆入铺纸烤盘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "压模时轻压即可，用力压实会让饼变硬。",
      "visual_cue": "饼坯边缘整齐、厚度一致"
    },
    {
      "n": 6,
      "text": "烤箱一百六十度烤十五分钟，表面略干不上色时取出晾凉。",
      "time_min": 15,
      "heat": "小火",
      "tip": "这款饼不该烤上色，一发黄就说明过头了。",
      "visual_cue": "表面干爽发白、边缘微微开裂"
    },
    {
      "n": 7,
      "text": "完全冷却后筛一层糖粉，轻拿轻放装入盒中。",
      "time_min": 5,
      "heat": "无火",
      "tip": "凉透再筛粉，热的时候糖粉会化掉。",
      "visual_cue": "饼面覆薄白粉、拿起来会掉渣"
    }
  ],
  "tips": [
    "杏仁粉要选细磨的，粗颗粒会让饼身容易散。",
    "想更酥可把黄油换成一半猪油，这是西班牙南部的老做法。",
    "压模剩下的边角料重新团起来会略硬，建议最后单独烤。"
  ],
  "common_mistakes": [
    "低筋面粉没炒就直接用，成品带明显干粉味。",
    "黄油打发过度，烤时膨胀裂成几块。",
    "烤到上色才出炉，口感发硬失去入口即化的特点。"
  ],
  "substitutions": [
    {
      "original": "杏仁粉",
      "substitute": "低筋面粉",
      "ratio": "150g 对 130g",
      "note": "完全无坚果版，香气减弱但更省钱。"
    },
    {
      "original": "黄油",
      "substitute": "猪油",
      "ratio": "120g 对 110g",
      "note": "更酥更传统，冷藏后偏硬。"
    }
  ],
  "variations": [
    "加入可可粉做成巧克力版本，表面筛糖粉依旧。",
    "混入烤香的芝麻或核桃碎，口感更有层次。"
  ],
  "serving_suggestion": "配一杯甜酒或热可可，是西班牙圣诞餐桌的固定甜点。",
  "storage": "密封常温两周，受潮后可用一百四十度回烤五分钟。",
