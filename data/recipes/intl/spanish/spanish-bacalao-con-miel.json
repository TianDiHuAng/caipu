  "equipment": [
    "烤箱",
    "烤盘",
    "小碗",
    "刷子",
    "厨房纸",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼排用厨房纸吸干表面水分，两面均匀撒上盐与黑胡椒，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱼身越干，烤出来表面才有一层薄脆的焦香。",
      "visual_cue": "鱼排表面干爽，调料附着均匀"
    },
    {
      "n": 2,
      "text": "小碗里放蜂蜜、橄榄油、蒜末与红椒粉，搅拌成浓稠的亮色酱汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蜂蜜偏稠的话加半勺温水，更容易刷开。",
      "visual_cue": "酱汁橙红发亮，质地顺滑"
    },
    {
      "n": 3,
      "text": "烤盘铺纸，鱼排单层放好，用刷子把酱汁均匀涂满两面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "留三分之一酱汁到最后再刷，避免烤糊。",
      "visual_cue": "鱼身裹满酱色，无裸露"
    },
    {
      "n": 4,
      "text": "烤箱预热两百度，中层烤十二分钟至鱼肉边缘泛白。",
      "time_min": 13,
      "heat": "大火",
      "tip": "鱼排厚薄不同，时间按最厚处八分熟来判断。",
      "visual_cue": "鱼肉边缘转白，酱汁冒泡"
    },
    {
      "n": 5,
      "text": "取出烤盘，把剩下的酱汁再刷一遍，回炉烤四分钟上色。",
      "time_min": 5,
      "heat": "大火",
      "tip": "第二次刷酱只烤几分钟，蜜糖不易焦苦。",
      "visual_cue": "表面焦糖色，光泽明亮"
    },
    {
      "n": 6,
      "text": "出炉挤上柠檬汁，撒欧芹碎，静置两分钟让汁水回收。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬汁最后加，酸香才不被烤散。",
      "visual_cue": "配角鲜绿，鱼汁清亮"
    },
    {
      "n": 7,
      "text": "配柠檬片装盘，把烤盘里的酱汁淋在鱼身上。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盘底酱汁别倒掉，拌饭拌薯块都很香。",
      "visual_cue": "酱汁挂浆，鱼排完整"
    }
  ],
  "tips": [
    "鱼排选厚实的段，薄片容易烤干发柴。",
    "蜂蜜本身很甜，盐要在鱼身上先撒够，甜咸才平衡。",
    "没有欧芹用香菜替代，香气会偏清爽一点。",
    "烤盘垫油纸能省去很多刷洗功夫。"
  ],
  "common_mistakes": [
    "鱼身没吸干水就直接烤，出来一滩白汤，酱也挂不住。",
    "酱汁一次全刷完，高温下蜂蜜很快烤黑发苦。",
    "烤的时间按菜谱死记，鱼排薄了就一定过火发干。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "鲈鱼",
      "ratio": "500克:500克",
      "note": "肉质更细，烤制时间减两分钟。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "40克:35克",
      "note": "先化在温水里再刷，否则易结块。"
    }
  ],
  "variations": [
    "酱汁里加一勺酱油，做成咸甜更浓的亚洲风版本。",
    "底下垫一层土豆片同烤，吸满鱼汁与蜜酱。"
  ],
  "serving_suggestion": "两人份主菜，配烤土豆、白米饭或一份生菜沙拉，挤上柠檬汁一起吃。",
  "storage": "冷藏一天内吃完，复热盖锡纸低温烤八分钟；鱼肉不建议反复加热，避免变柴。",
