  "equipment": [
    "厚底锅",
    "锅盖",
    "漏勺",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛤蜊放入淡盐水中静置一小时吐沙，中途换一次水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水里加一勺盐模拟海水，蛤蜊才会张壳吐沙。",
      "visual_cue": "盆底沉下细沙、蛤蜊微张壳"
    },
    {
      "n": 2,
      "text": "用刷子逐只刷洗外壳缝隙，敲击后不闭合的挑出丢弃。",
      "time_min": 8,
      "heat": "无火",
      "tip": "死蛤蜊一旦下锅会带腥味毁掉整锅汤。",
      "visual_cue": "外壳干净、活的遇敲立即闭合"
    },
    {
      "n": 3,
      "text": "厚底锅放橄榄油，小火把蒜片与干辣椒煸到蒜片边缘微黄。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蒜片只要上色不要焦，焦了整锅发苦。",
      "visual_cue": "蒜片金黄卷边、油面泛起细泡"
    },
    {
      "n": 4,
      "text": "倒入白葡萄酒煮到酒气挥发，下蛤蜊转中火，加盖焖四分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "盖盖让蒸汽把上层的蛤蜊也蒸开，别频繁开盖。",
      "visual_cue": "锅内汤汁沸腾、蛤蜊陆续张口"
    },
    {
      "n": 5,
      "text": "开盖检查，把已开口的蛤蜊先夹出，未开的再盖盖焖一分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "一直不开口的是死蛤蜊，务必丢弃不要硬撬。",
      "visual_cue": "九成以上蛤蜊张壳、汤汁略收"
    },
    {
      "n": 6,
      "text": "汤汁加盐与黑胡椒调味，淋在蛤蜊上撒欧芹，配柠檬角食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛤蜊本身带咸，盐要最后尝过再加。",
      "visual_cue": "汤汁清亮微稠、欧芹翠绿不塌"
    }
  ],
  "tips": [
    "锅底的汤汁是整道菜的精华，别倒掉，可留着蘸食或煮面。",
    "白葡萄酒选干型，甜型酒会让汤汁发腻。",
    "蛤蜊买回后当天使用，冷藏时用湿布覆盖不要泡水。"
  ],
  "common_mistakes": [
    "蛤蜊没吐沙直接下锅，吃一口满嘴是沙。",
    "大火猛煮导致蛤蜊肉缩成硬块失去鲜嫩。",
    "蒜片炒焦后仍继续使用，成品带明显苦味。"
  ],
  "substitutions": [
    {
      "original": "蛤蜊",
      "substitute": "花蛤",
      "ratio": "800g 对 800g",
      "note": "个头小更易入味，煮的时间缩短一分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "米酒",
      "ratio": "100ml 对 80ml",
      "note": "甜度偏高，需加少许柠檬汁平衡。"
    }
  ],
  "variations": [
    "大蒜加倍、干辣椒加到四根，做成更冲的辣味版本。",
    "选个头更小的蛤蜊，更易入味，焖制时间缩短一分钟。"
  ],
  "serving_suggestion": "连锅上桌，作为餐前小菜或配酒的小食。",
  "storage": "现做现吃，带壳海鲜不建议隔夜；剩余汤汁可冷藏一天煮面用。",
