  "steps": [
    {
      "n": 1,
      "text": "虾仁从背上划开，挑出里面的黑色沙线，用厨房纸吸干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "背上那条黑色沙线腥味最重，一定要挑干净。",
      "visual_cue": "虾仁干爽，背部开得整齐"
    },
    {
      "n": 2,
      "text": "姜切成细丝，大蒜切末，洋葱和香菇分别切好。",
      "time_min": 8,
      "heat": "无火",
      "tip": "姜丝切细一点，炒出来才不会辛辣。",
      "visual_cue": "姜丝细长，粗细一致"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧热，下姜丝和蒜末小火炒香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "姜丝炒到微微卷起，香气才出得来。",
      "visual_cue": "姜丝微黄卷曲，香气上扬"
    },
    {
      "n": 4,
      "text": "下洋葱丝和香菇片，用中火翻炒到洋葱变软。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软出甜味，能压住姜的辛辣。",
      "visual_cue": "洋葱透明，香菇变软"
    },
    {
      "n": 5,
      "text": "转大火下虾仁快速翻炒，炒到虾仁卷曲变成粉红色。",
      "time_min": 3,
      "heat": "大火",
      "tip": "虾仁一变颜色就够，炒久了口感会老。",
      "visual_cue": "虾仁卷曲，颜色粉红"
    },
    {
      "n": 6,
      "text": "淋生抽和蚝油，撒白糖快速翻匀让味道包住虾仁。",
      "time_min": 2,
      "heat": "大火",
      "tip": "调味下锅后快炒，汁才不会糊底。",
      "visual_cue": "虾仁挂上酱汁，表面发亮"
    },
    {
      "n": 7,
      "text": "最后下入小葱段翻两下，马上关火起锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "葱段最后下锅，才保得住翠绿和辛香。",
      "visual_cue": "葱段翠绿，盘中不见余汁"
    }
  ],
  "tips": [
    "虾仁背上的沙线腥味重，一定要挑干净再洗。",
    "姜丝切细炒到微卷，香气最足也不辛辣。",
    "虾仁一变色就调味出锅，久炒会发硬。"
  ],
  "common_mistakes": [
    "虾仁带水下锅，锅里全是汤水炒不香。",
    "姜丝切太粗，整道菜吃着辛辣发冲。",
    "虾仁炒到收缩发白才起锅，口感已经老了。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡胸肉",
      "ratio": "400 克:350 克",
      "note": "切薄片，炒制时间略延长。"
    },
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "60 克:60 克",
      "note": "泡发后切片，口感更脆。"
    }
  ],
  "variations": [
    "加一勺蚝油换成豆瓣酱，咸鲜更浓。",
    "起锅前淋几滴青柠汁，酸香更开胃。"
  ],
  "serving_suggestion": "配茉莉香米饭最合适，汤汁拌饭特别香。",
  "storage": "冷藏一天，复热用炒锅大火三十秒；不建议冷冻，虾仁会出水变韧。",
