  "equipment": [
    "蒸锅",
    "鱼盘",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼刮鳞去内脏冲洗干净，两面各斜划三刀，刀口深到骨边。",
      "time_min": 4,
      "heat": "无火",
      "tip": "划刀让热气进到肉里，也能让调味汁渗进刀缝。",
      "visual_cue": "鱼身刀口整齐，腹腔无血黑膜。"
    },
    {
      "n": 2,
      "text": "鱼身内外抹薄薄一层盐，静置五分钟，用厨房纸吸掉渗出的水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "抹盐逼出表面水分，蒸出来鱼肉更紧实不腥。",
      "visual_cue": "鱼皮干爽，纸上有淡粉色湿痕。"
    },
    {
      "n": 3,
      "text": "蒸锅加足水大火烧开上汽，鱼放姜片垫底后入锅盖盖。",
      "time_min": 2,
      "heat": "大火",
      "tip": "垫两片姜把鱼身抬离盘底，蒸汽才能从下面走通。",
      "visual_cue": "锅盖边缘冒出连续蒸汽。"
    },
    {
      "n": 4,
      "text": "大火蒸八分钟，看到鱼眼突出发白、刀口鱼肉不再透明即熟。",
      "time_min": 8,
      "heat": "大火",
      "tip": "六百克的鱼八分钟足够，每多一百克加一分钟。",
      "visual_cue": "鱼眼凸起发白，刀口肉呈白色。"
    },
    {
      "n": 5,
      "text": "取出鱼盘，把盘底蒸出的血水全部倒掉，重新铺一层香菜碎。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘底那层水是腥味来源，务必倒干净再淋汁。",
      "visual_cue": "盘底干爽，只有鱼身残留少量清汁。"
    },
    {
      "n": 6,
      "text": "青柠汁加鱼露、细砂糖、蒜末和辣椒粉搅匀，淋在鱼身上即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁要在上桌前才淋，鱼肉才保持嫩度。",
      "visual_cue": "汁水清亮微绿，蒜末浮在表面。"
    }
  ],
  "tips": [
    "鱼一定要新鲜，眼睛清亮、鳃色暗红，蒸出来才没有土腥味。",
    "水开后上锅，全程大火八分钟，鱼肉刚离骨最嫩。",
    "调味汁最后淋，提前淋会让鱼肉被酸味腌得发紧。"
  ],
  "common_mistakes": [
    "冷水上锅慢蒸，鱼肉在低温里久泡，蛋白质流失、肉质发柴。",
    "蒸好后不倒掉盘底血水，腥味全被鱼肉吸回去。",
    "青柠汁下锅加热，酸味变苦，整道菜带涩。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "黄花鱼",
      "ratio": "600克:600克",
      "note": "肉质更细，蒸的时间减一分钟。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "2个:1个",
      "note": "酸度低，糖可以减少两克。"
    }
  ],
  "variations": [
    "蒸好后浇一勺热油淋在蒜末上，蒜香更冲，是南部餐馆的常见做法。",
    "把调味汁换成酸梅汁，酸甜带果香，适合怕辣的人。"
  ],
  "serving_suggestion": "整条鱼连着盘里的汁上桌，撒香菜碎，配泰国香米饭，用汁拌饭最下饭。",
  "storage": "鱼最好现蒸现吃，剩下的冷藏不超过一天，回蒸三分钟，不要微波以免肉质变硬。",
