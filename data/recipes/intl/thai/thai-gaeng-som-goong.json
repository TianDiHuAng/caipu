  "equipment": [
    "汤锅",
    "炒锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香茅拍扁后切成段，红葱头与大蒜分别切末，青椒去籽切成三角块备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香茅先拍扁再切，香气才容易煮进汤里。",
      "visual_cue": "香茅纤维松散，青椒块大小均匀"
    },
    {
      "n": 2,
      "text": "虾仁从背部划开挑净黑线，用一半鱼露抓匀腌五分钟去腥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黑线一定要挑干净，否则汤会有泥腥味。",
      "visual_cue": "虾仁背部干净，表面微微发亮"
    },
    {
      "n": 3,
      "text": "炒锅放植物油，小火先把红葱头末与蒜末炒香，再下咖喱粉炒匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "咖喱粉最后下且只用小火，炒糊了整锅发苦。",
      "visual_cue": "香料呈橙红色油亮，香味浓而不焦"
    },
    {
      "n": 4,
      "text": "把炒好的香料倒进汤锅，加清水与香茅段，转中火煮开约八分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煮到香茅的柠檬香透出来，汤底才算打好。",
      "visual_cue": "汤色橙黄，飘出明显的香茅味"
    },
    {
      "n": 5,
      "text": "加罗望子、椰糖与剩下的鱼露，边尝边调成酸中带甜的汤底。",
      "time_min": 2,
      "heat": "中火",
      "tip": "先调酸再调甜，糖一次别下太多容易腻口。",
      "visual_cue": "汤味先酸后回甜，咸度适中"
    },
    {
      "n": 6,
      "text": "下青椒块与腌好的虾仁，煮到虾仁卷起变红立刻关火盛碗。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾仁一变红就关火，多煮一分钟就发硬。",
      "visual_cue": "虾仁卷成弯月状，表面紧实弹手"
    }
  ],
  "tips": [
    "罗望子带核的要先泡水再取汁，渣别一起下锅。",
    "汤底酸度靠罗望子，青柠汁留到关火后再补更香。",
    "青椒换成南瓜块也别有风味，甜味能压住酸。",
    "汤煮好放十分钟再喝，酸味会更圆润。"
  ],
  "common_mistakes": [
    "咖喱粉用大火干炒，几下就焦黑发苦。",
    "虾仁久煮不捞出，肉质变得又硬又柴。",
    "罗望子连渣倒进锅里，汤喝起来满是纤维渣。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鱿鱼",
      "ratio": "220克:250克",
      "note": "切圈后同样最后下锅，煮到卷起即可。"
    },
    {
      "original": "罗望子",
      "substitute": "青柠",
      "ratio": "15克:40克",
      "note": "青柠取汁在关火后加入，香气更清。"
    }
  ],
  "variations": [
    "加半颗菠萝切块同煮，酸味多一层果香。",
    "换成鱼块做酸咖喱鱼汤，煮的时间要缩短。"
  ],
  "serving_suggestion": "盛进深碗趁热喝，第一口是罗望子的酸，接着辣味和虾的鲜甜慢慢浮上来，配白米饭最好下饭。",
  "storage": "冷藏可存一天，复热时小火加热到滚即可，虾仁不要久煮以免变硬。",
