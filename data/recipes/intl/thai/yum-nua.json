  "steps": [
    {
      "n": 1,
      "text": "牛里脊 350g 提前 20 分钟从冰箱取出回温，用厨房纸吸干表面水分，两面抹 4g 盐。",
      "time_min": 5,
      "heat": "无火",
      "tip": "回温后再煎，内部熟度才均匀。",
      "visual_cue": "牛里脊表面干爽、无血水渗出"
    },
    {
      "n": 2,
      "text": "平底锅烧到微微冒烟，放入牛里脊大火煎 2 分钟至底面焦褐，翻面再煎 2 分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "锅够热才封得住肉汁。",
      "visual_cue": "两面焦褐、按压有弹性"
    },
    {
      "n": 3,
      "text": "煎好的牛里脊放在案板上静置 8 分钟，让肉汁回流后再切成薄片。",
      "time_min": 9,
      "heat": "无火",
      "tip": "静置是肉嫩的关键，别急着切。",
      "visual_cue": "切面呈粉红、肉汁不外流"
    },
    {
      "n": 4,
      "text": "干辣椒 3 个用干锅小火烤 1 分钟至微焦，碾成粗碎备用。",
      "time_min": 3,
      "heat": "小火",
      "tip": "烤过的辣椒香气更立体。",
      "visual_cue": "辣椒颜色转深、散发焦香"
    },
    {
      "n": 5,
      "text": "大碗中放 25ml 鱼露、8g 白糖与 2 个青柠的汁，搅到糖完全溶解成酱汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖先化开，酸咸才平衡。",
      "visual_cue": "酱汁清亮、酸甜咸明显"
    },
    {
      "n": 6,
      "text": "碗中放入生菜、番茄块、洋葱丝与牛里脊片，淋酱汁撒辣椒碎和香菜，快速拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "上桌前再拌，蔬菜才不塌。",
      "visual_cue": "沙拉均匀裹汁、颜色鲜亮"
    }
  ],
  "tips": [
    "牛里脊煎好必须静置 8 分钟，切开才不会流失肉汁。",
    "干辣椒烤香再碾碎，辣味更有层次。",
    "生菜和香菜最后拌，保持脆爽不塌软。"
  ],
  "common_mistakes": [
    "牛里脊从冰箱取出直接下锅，中间生外面老。",
    "煎好立刻切片，肉汁全流到案板上。",
    "酱汁提前拌好放置，蔬菜出水变软。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛腩",
      "ratio": "350g 对 350g",
      "note": "需先炖软再切片，口感不同。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "25ml 对 22ml",
      "note": "鲜味稍弱，可加 3g 白糖。"
    }
  ],
  "variations": [
    "烤牛里脊版：改用炭火烤至七分熟。",
    "粉丝版：加 80g 泡软粉丝同拌。"
  ],
  "serving_suggestion": "装盘后淋上碗底酱汁，配糯米饭一起食用。",
  "storage": "现拌现吃，冷藏不超过 1 天。",
