  "equipment": [
    "石臼",
    "菜刀",
    "刨丝器",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青木瓜削皮去籽，用刨丝器刨成细长丝，泡冰水十分钟后沥干。",
      "time_min": 13,
      "heat": "无火",
      "tip": "泡冰水能让木瓜丝更脆，口感差别明显，这一步决定了成品的口感。",
      "visual_cue": "瓜丝透亮，根根分明，锅面和食材状态一目了然"
    },
    {
      "n": 2,
      "text": "胡萝卜同样刨成细丝，番茄切成小块，香菜切成五厘米长的段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "胡萝卜丝比木瓜丝粗一点，嚼起来有层次，这一步决定了成品的口感。",
      "visual_cue": "三色分明，摆盘清爽，颜色与质地变化清楚可见"
    },
    {
      "n": 3,
      "text": "石臼里放蒜末和红辣椒碎，用杵捣三十下，捣出汁水香气。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先把蒜辣捣出味，整份沙拉的底味才够冲，这一步决定了成品的口感。",
      "visual_cue": "蒜辣成泥，香气冲鼻，香气和声音能说明进度"
    },
    {
      "n": 4,
      "text": "加椰糖继续捣到化开，再倒鱼露和青柠汁，捣匀成酸甜汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "椰糖硬，捣碎了才融得进汁里，不然一粒粒硌牙。",
      "visual_cue": "汁水棕亮，酸甜扑鼻，整体火候状态清楚好判断"
    },
    {
      "n": 5,
      "text": "放木瓜丝和胡萝卜丝，一边轻捣一边翻拌，让每根丝都沾上汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "捣得太重会出水变软，轻捣加翻拌就够，这一步决定了成品的口感。",
      "visual_cue": "丝条挂汁，颜色鲜亮，表面变化看得出来已到位"
    },
    {
      "n": 6,
      "text": "拌入番茄块和香菜，装盘后撒烤香的花生碎，现拌现吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "花生最后撒，早了会吸汁变软没脆感，这一步决定了成品的口感。",
      "visual_cue": "花生碎金黄，卖相饱满，汤汁和食材状态清楚到位"
    }
  ],
  "tips": [
    "青木瓜要选表皮青绿、捏着硬实的，发黄的就熟过了，刨不出脆丝。",
    "没有石臼就用大碗加擀面杖压，别用料理机，打成泥就全毁了。",
    "酸甜咸辣四味要边捣边尝，泰国本地口味偏重，可以按自己口味减辣。",
    "拌好立刻吃，放半小时木瓜丝就出水，脆感全无。"
  ],
  "common_mistakes": [
    "青木瓜刨太粗，嚼起来像啃萝卜，完全没有脆嫩的口感。",
    "椰糖不捣碎直接拌，沙拉里一粒粒硬块，吃到嘴里硌牙。",
    "提前一小时拌好放着，出水后整碗软塌，汁水积在碗底。"
  ],
  "substitutions": [
    {
      "original": "青木瓜",
      "substitute": "黄瓜",
      "ratio": "400克:400克",
      "note": "黄瓜版水分更多，需挤掉部分汁水。"
    },
    {
      "original": "花生米",
      "substitute": "腰果",
      "ratio": "40克:40克",
      "note": "腰果更甜，烤香后碾碎同样香脆。"
    }
  ],
  "variations": [
    "加一把泡软的干虾米，鲜味更足，是泰国东北部的经典搭配。",
    "把青木瓜换成青芒果，酸味更亮，做成芒果沙拉也别有风味。"
  ],
  "serving_suggestion": "装在白盘里，配烤鸡和糯米饭，用手抓着吃最地道，是泰国街头最常见的开胃菜。",
  "storage": "拌好当天吃完，剩下的瓜丝会出水发软，冷藏不超过一天。",
