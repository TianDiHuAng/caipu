  "steps": [
    {
      "n": 1,
      "text": "虾去壳留尾，背部划一刀挑出虾线。，火大了就离锅远一点。",
      "time_min": 7,
      "heat": "无火",
      "tip": "划一刀既去虾线，也让虾受热卷曲。，火别开太大，稳着来。",
      "visual_cue": "虾背开口，虾线清除"
    },
    {
      "n": 2,
      "text": "虾用鱼露和白胡椒抓匀，腌十分钟。，锅温要匀，别忽高忽低。",
      "time_min": 11,
      "heat": "无火",
      "tip": "腌一下去腥，也有底味。，火力保持中等，慢慢来。",
      "visual_cue": "虾身发亮，调料附着"
    },
    {
      "n": 3,
      "text": "沥干腌汁，薄薄裹一层面粉。，火候宁小勿大，慢慢推进。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉别太厚，否则外壳发硬。，注意锅里温度别掉下来。",
      "visual_cue": "虾身泛白，粉层均匀"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，中火烧到筷子插入冒小泡。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温不够就下虾，外壳会吸油。，火要均匀，食材才不糊。",
      "visual_cue": "筷子周围细泡密集，别跳过这步。"
    },
    {
      "n": 5,
      "text": "虾一只只下锅，炸一分半到卷曲变红。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "中火",
      "tip": "别一次下太多，油温才不掉。，全程留意火候，别贪快。",
      "visual_cue": "虾身卷曲，颜色橙红"
    },
    {
      "n": 6,
      "text": "捞出沥油，静置一分钟让余温透熟。，火大了就离锅远一点。",
      "time_min": 2,
      "heat": "无火",
      "tip": "余温会继续加热，别炸过头。，火别开太大，稳着来。",
      "visual_cue": "外壳酥脆，油滴回落"
    },
    {
      "n": 7,
      "text": "留底油小火炒香蒜末，炒到微黄。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜末小火炒，才金黄不发苦。，火力保持中等，慢慢来。",
      "visual_cue": "蒜末散开，香气上涌"
    },
    {
      "n": 8,
      "text": "虾回锅翻匀，让蒜末裹住虾身。，火候宁小勿大，慢慢推进。",
      "time_min": 2,
      "heat": "小火",
      "tip": "回锅只翻几下，蒜才不焦。，注意锅里温度别掉下来。",
      "visual_cue": "蒜末挂虾，油光亮，这步最关键。"
    },
    {
      "n": 9,
      "text": "装盘撒盐，配青柠角挤汁。，始终中小火，别心急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠解油，别省。，火要均匀，食材才不糊。",
      "visual_cue": "酸香散开，外壳发亮"
    }
  ],
  "tips": [
    "虾背划刀，炸时才卷得漂亮。，很多人在这里出错。",
    "油温够了再下虾，外壳才脆。，这里最容易翻车。",
    "蒜末小火炒，才不苦。，别小看这一步。"
  ],
  "common_mistakes": [
    "油温不够就下虾，外壳软塌含油。，成败就在这一步。",
    "蒜末大火炒，瞬间发黑发苦。，这点要注意。",
    "炸过头，虾肉缩成硬块。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鱿鱼",
      "ratio": "400 克:400 克",
      "note": "切圈炸一分钟。"
    },
    {
      "original": "面粉",
      "substitute": "淀粉",
      "ratio": "60 克:60 克",
      "note": "外壳更脆，油温可略高。"
    }
  ],
  "variations": [
    "加一点辣椒粉，做成微辣。，别嫌麻烦，做完它。",
    "蒜末里拌一点白芝麻，更香。，这一步别省。"
  ],
  "serving_suggestion": "配白饭和甜辣酱。，别跳过这步。",
  "storage": "现炸现吃，冷藏后外壳会软。，这步最关键。",
