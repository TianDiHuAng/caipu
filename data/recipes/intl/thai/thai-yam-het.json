  "steps": [
    {
      "n": 1,
      "text": "平菇撕成手指粗细的条，用厨房纸吸干表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "平菇一定吸干水，煎出来才香不发软。",
      "visual_cue": "平菇条干爽，粗细均匀"
    },
    {
      "n": 2,
      "text": "青柠挤出汁，和鱼露、白糖一起搅拌到糖完全化开。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖先化开，酸辣味才均匀挂在平菇上。",
      "visual_cue": "调味汁清亮，无糖粒"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧热，把平菇条平铺下锅用中火煎香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "平菇一定要平铺，别堆着，水汽才散得掉。",
      "visual_cue": "平菇边缘开始焦黄"
    },
    {
      "n": 4,
      "text": "煎到平菇出水又收干，表面微焦时盛出放凉。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎到水汽完全收干，口感才有嚼劲。",
      "visual_cue": "平菇缩小发亮，边缘焦褐"
    },
    {
      "n": 5,
      "text": "把香茅切成薄片，红辣椒切圈，小葱和香菜切成段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香茅只取里面最嫩的部分，老皮嚼不动。",
      "visual_cue": "香茅片薄而透光，能看见纹理"
    },
    {
      "n": 6,
      "text": "放凉的平菇倒进大碗，加入香茅、辣椒和调味汁拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "平菇稍凉再拌，太烫会把香菜烫蔫。",
      "visual_cue": "平菇均匀裹上调味汁"
    },
    {
      "n": 7,
      "text": "撒上小葱段和香菜段，轻轻翻拌几下再装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后拌进去，香气才留得住。",
      "visual_cue": "葱花翠绿，盘中泛酸辣汁"
    }
  ],
  "tips": [
    "平菇先吸干水分再煎，香气才炒得出来。",
    "调味汁里糖要先化开，味道才均匀。",
    "平菇稍放凉再拌，香菜才不会被烫蔫。"
  ],
  "common_mistakes": [
    "平菇没吸干水下锅，煎成一锅水汽。",
    "火太小慢慢煸，平菇发软没有嚼劲。",
    "热平菇直接拌香菜，叶子立刻发黄。"
  ],
  "substitutions": [
    {
      "original": "平菇",
      "substitute": "杏鲍菇",
      "ratio": "400 克:400 克",
      "note": "口感更弹，需切片煎。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "2 个:1 个",
      "note": "酸味更柔，香气略淡。"
    }
  ],
  "variations": [
    "加一把烤香的花生碎，口感更丰富。",
    "撒一点糯米粉炒香的米粉，风味更泰北。"
  ],
  "serving_suggestion": "趁温吃最香，配糯米饭或者烤鸡一起吃都很合适。",
  "storage": "冷藏一天，食用前挤一点青柠汁恢复酸香；不建议久放，香菜会变色。",
