  "equipment": [
    "炒锅",
    "小碗",
    "打蛋器",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "装盘后摆上柠檬角，吃之前挤上柠檬汁拌匀再吃。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡到微软即可，泡太透炒时容易断。",
      "visual_cue": "米粉弯折不断，手感有弹"
    },
    {
      "n": 2,
      "text": "罗望子肉用温水泡开揉散，滤出汁水，加鱼露、白糖调成酸甜酱汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "酱汁先尝一口，酸、甜、咸要平衡。",
      "visual_cue": "酱汁棕红透亮，闻着带酸"
    },
    {
      "n": 3,
      "text": "炒锅下植物油烧热，蒜末与小米辣圈小火爆香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末别炒焦，一变黄就下虾仁。",
      "visual_cue": "蒜末金黄，油面泛香"
    },
    {
      "n": 4,
      "text": "下虾仁转中大火炒到转红，拨到锅边，中间倒入打散的鸡蛋炒成碎块。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "虾仁变红即可，久炒会老。",
      "visual_cue": "虾仁卷曲发红，蛋碎蓬松"
    },
    {
      "n": 5,
      "text": "下沥干的米粉，淋入调好的罗望子酱汁，快速翻炒让每根米粉上色。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "用筷子辅助翻拌，米粉不易断。",
      "visual_cue": "米粉均匀上色，不粘成一团"
    },
    {
      "n": 6,
      "text": "加入豆芽翻炒半分钟至断生，关火后撒花生碎与香菜段。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "豆芽保持脆感，炒久了出水。",
      "visual_cue": "豆芽挺立，锅气足"
    },
    {
      "n": 7,
      "text": "装盘后摆上柠檬角，吃之前挤上柠檬汁拌匀再吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁最后挤，酸味才鲜活。",
      "visual_cue": "盘边柠檬翠绿，米粉干爽"
    }
  ],
  "tips": [
    "米粉泡好后要彻底沥干，带水下锅会粘成一团。",
    "罗望子汁是灵魂，买不到可用白醋加红糖替代但风味不同。",
    "全程大火快炒，超过十分钟米粉就会发糊。"
  ],
  "common_mistakes": [
    "米粉泡得过软，下锅一炒就断成碎渣。",
    "酱汁一次倒太多，米粉吸汁后变得黏糊。",
    "虾仁与鸡蛋同时下锅，结果鸡蛋老、虾仁不熟。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "150 克:150 克",
      "note": "切薄片先腌十分钟，口感稍逊但同样好吃。"
    },
    {
      "original": "罗望子",
      "substitute": "白醋",
      "ratio": "30 克:25 毫升",
      "note": "酸味单一，需多加五克白糖平衡。"
    }
  ],
  "variations": [
    "加几块炸豆干同炒，口感更有层次也更顶饱。",
    "加几块炸豆干同炒，口感更有层次也更顶饱。"
  ],
  "serving_suggestion": "装盘撒花生碎，配柠檬角与生豆芽一起上桌。",
  "storage": "现炒现吃；冷藏一天后米粉会回硬，复热需加一勺水小火翻拌。",
