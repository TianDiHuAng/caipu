  "equipment": [
    "汤锅",
    "汤勺",
    "小碗",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肉末加蛋清、一半鱼露和白胡椒，顺一个方向搅到起胶发黏。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅到肉馅能整团提起不掉，丸子才弹。",
      "visual_cue": "肉馅抱团发亮、表面有黏性"
    },
    {
      "n": 2,
      "text": "把肉馅反复在碗中摔打十几次，排出空气后冷藏十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "摔打是弹牙的关键，别只用筷子搅。",
      "visual_cue": "肉馅紧实、按压回弹"
    },
    {
      "n": 3,
      "text": "香菜根与大蒜拍碎放入清水，中火煮开转小火熬五分钟出香。",
      "time_min": 8,
      "heat": "中火",
      "tip": "香菜根别丢，它是这锅清汤的香气来源。",
      "visual_cue": "汤色微浊、闻到明显香菜蒜香"
    },
    {
      "n": 4,
      "text": "捞出香菜根与蒜渣，用勺子把肉馅挤成小丸子逐个下锅。",
      "time_min": 8,
      "heat": "小火",
      "tip": "汤保持微沸即可，滚太猛丸子会散。",
      "visual_cue": "丸子浮起、表面由粉转白"
    },
    {
      "n": 5,
      "text": "丸子全部浮起后加入香菇片与泡软的粉丝，小火煮五分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "粉丝最后放，久煮会吸汤变糊。",
      "visual_cue": "粉丝透明柔软、香菇片变软"
    },
    {
      "n": 6,
      "text": "加剩余鱼露、白糖与白胡椒调味，撒葱花和香菜叶关火。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鱼露后放香气更足，尝过咸淡再补。",
      "visual_cue": "汤清味鲜、表面浮少量油花"
    }
  ],
  "tips": [
    "肉馅里加一勺冰水，丸子会更嫩更多汁。",
    "没有香菜根可以用芫荽籽代替，香气接近但更内敛。",
    "想更清爽可把汤面上的浮沫撇干净，汤色会透亮许多。"
  ],
  "common_mistakes": [
    "肉馅没搅上劲就下锅，丸子一煮全散成肉碎汤。",
    "汤一直大火滚，丸子外表老了里面还生。",
    "鱼露一开始就全倒进去，久煮后鲜味散掉只剩咸。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡胸肉末",
      "ratio": "300g 对 300g",
      "note": "更清爽，需多加一勺淀粉保水。"
    },
    {
      "original": "粉丝",
      "substitute": "米粉",
      "ratio": "60g 对 60g",
      "note": "口感更爽利，煮的时间缩短两分钟。"
    }
  ],
  "variations": [
    "加入冬瓜块同煮，做成泰式冬瓜肉丸汤。",
    "把肉丸换成鱼丸或虾丸，做成海鲜版本。"
  ],
  "serving_suggestion": "盛入深碗，配泰国香米饭和一小碟辣椒鱼露汁。",
  "storage": "冷藏两天，复热时补少量清水，丸子不易散。",
