  "equipment": [
    "汤锅",
    "木勺",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成三厘米见方的块，用清水冲去表面血水后沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "带皮鸡腿肉油脂香，汤更醇厚，别去皮。",
      "visual_cue": "鸡块干净、无血水渗出"
    },
    {
      "n": 2,
      "text": "南姜切薄片，香茅拍扁后切成五厘米段，柠檬叶撕开去掉硬梗。",
      "time_min": 4,
      "heat": "无火",
      "tip": "三样香料都要拍裂撕开，香气才出得来。",
      "visual_cue": "香料拍裂、香气扑鼻"
    },
    {
      "n": 3,
      "text": "汤锅倒高汤，放南姜、香茅和柠檬叶，中火煮五分钟出香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "香料先煮出味，是这道汤的底子。",
      "visual_cue": "汤色微黄、香气浓郁"
    },
    {
      "n": 4,
      "text": "下鸡块煮八分钟至肉色变白、基本熟透，撇去浮沫。",
      "time_min": 8,
      "heat": "中火",
      "tip": "浮沫要撇净，汤才清亮不腥。",
      "visual_cue": "汤面清亮、鸡块转白"
    },
    {
      "n": 5,
      "text": "放入蘑菇煮三分钟至微软，蘑菇吸汤后会鼓起。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蘑菇后放，久煮会缩成小块失了口感。",
      "visual_cue": "蘑菇微软、体积饱满"
    },
    {
      "n": 6,
      "text": "倒入椰浆和棕榈糖，转小火煮三分钟，别让汤大滚。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椰浆大滚会油水分离，汤色发灰发涩。",
      "visual_cue": "汤色奶白、表面无油花分离"
    },
    {
      "n": 7,
      "text": "关火后加鱼露和青柠汁调味，撒小米辣与香菜即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁离火再放，酸香才清亮不发苦。",
      "visual_cue": "汤色奶白、香菜翠绿浮面"
    }
  ],
  "tips": [
    "椰浆选浓稠型，摇匀再用，稀的汤会寡淡。",
    "青柠先挤半个尝味，酸度按口味再加。",
    "南姜不可用普通生姜代替，风味完全不同。"
  ],
  "common_mistakes": [
    "香料没拍裂就下锅，汤只有甜味没有香气。",
    "椰浆下锅后大火滚煮，油水分离、汤面浮渣。",
    "青柠汁早放久煮，酸味发苦、清香尽失。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "350g 对 350g",
      "note": "鸡胸易柴，煮的时间减三分钟。"
    },
    {
      "original": "棕榈糖",
      "substitute": "白糖",
      "ratio": "8g 对 6g",
      "note": "甜味更直接，鱼露可略增。"
    }
  ],
  "variations": [
    "加几只虾仁同煮，做成海鲜版椰奶汤。",
    "加一把米线同煮，直接变成一人份汤面。"
  ],
  "serving_suggestion": "配泰国香米饭，汤菜同锅，酸辣开胃。",
  "storage": "冷藏两天，复热时加少许椰浆稀释再小火煮开。",
