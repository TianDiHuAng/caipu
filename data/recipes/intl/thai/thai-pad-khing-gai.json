  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成三毫米薄片，用一半鱼露抓匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆着肉纹切薄片，炒十秒就熟，切片厚了外面老里面生。",
      "visual_cue": "肉片薄透均匀，表面发黏"
    },
    {
      "n": 2,
      "text": "姜切成极细的丝，大蒜拍碎，青椒切块，小葱切段。",
      "time_min": 4,
      "heat": "无火",
      "tip": "姜丝越细越好，粗姜丝嚼到会辣口，还压住鸡肉味。",
      "visual_cue": "姜丝纤细成缕，配料分堆"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟倒橄榄油，下蒜末与姜丝大火爆香。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅必须烧到冒烟再下油，温锅炒出来的菜水汪汪没锅气。",
      "visual_cue": "蒜姜出香，边缘微黄不焦"
    },
    {
      "n": 4,
      "text": "下鸡片快速翻炒到肉色转白，加青椒块与剩下鱼露、生抽、白糖。",
      "time_min": 4,
      "heat": "大火",
      "tip": "全程大火快炒，火小了鸡肉出水，变成煮鸡片。",
      "visual_cue": "肉片全白无粉，青椒翠绿挺立"
    },
    {
      "n": 5,
      "text": "撒葱段与白胡椒翻两下就出锅，趁热配米饭吃。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱段最后放，炒久了发黄发蔫，香气也散了。",
      "visual_cue": "葱段挺立，锅底无积水"
    }
  ],
  "tips": [
    "姜丝炒鸡是泰国街边最常见的快炒，姜香压腥又开胃。",
    "泰国本地会用指天椒加辣，怕辣可以换成甜椒。",
    "鸡肉换成猪肉片同样好吃，炒的时间缩短一分钟。"
  ],
  "common_mistakes": [
    "鸡肉切片太厚，外面焦了里面还带粉，只能回锅再炒变柴。",
    "火候不够，鸡肉出水，整盘菜泡在汤里。",
    "姜丝切太粗，吃起来辣口，盖过其他味道。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "400克:400克",
      "note": "鸡胸肉更瘦，腌时加一勺油防柴。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "20毫升:18毫升",
      "note": "生抽版少了发酵鲜味，糖可略增。"
    }
  ],
  "variations": [
    "加一把泡发的木耳同炒，口感更脆，也能吸住酱汁。",
    "起锅前淋半勺蚝油，味道更厚，是曼谷小店的做法。"
  ],
  "serving_suggestion": "配一碗泰国香米饭，旁边放几片生黄瓜解辣。",
  "storage": "冷藏可存一天，复热用炒锅大火快翻，久煮会让鸡肉变柴。",
