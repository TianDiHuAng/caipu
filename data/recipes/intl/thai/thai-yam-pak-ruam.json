  "steps": [
    {
      "n": 1,
      "text": "卷心菜去硬芯切细丝，泡冰水五分钟捞出彻底沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡冰水能让菜丝更脆，但一定要沥干否则出水。",
      "visual_cue": "菜丝卷曲挺立，无积水"
    },
    {
      "n": 2,
      "text": "黄瓜切薄片，胡萝卜刨成细丝，小番茄对半切开装碗。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄瓜切薄一点才挂得住汁，厚片会冲淡味道。",
      "visual_cue": "三种蔬菜颜色分明，片厚一致"
    },
    {
      "n": 3,
      "text": "青柠挤汁，加鱼露、椰糖、大蒜与小米辣搅到糖完全化开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糖必须搅到看不见颗粒，否则沙拉底会发苦。",
      "visual_cue": "料汁清澈微稠，闻着酸辣冲鼻"
    },
    {
      "n": 4,
      "text": "所有蔬菜放进大碗，淋料汁快速拌匀，撒花生碎与香菜即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌好立刻上桌，久放蔬菜出水会稀释料汁。",
      "visual_cue": "菜丝挂满料汁，花生碎分布均匀"
    }
  ],
  "tips": [
    "料汁的酸甜比例按三份青柠汁配一份椰糖来调最稳。",
    "蔬菜一定沥干，带水拌出来的沙拉会变成汤。",
    "花生碎现炒现撒，脆度差别很明显。",
    "喜欢更辣把小米辣切开，辣味会更冲。"
  ],
  "common_mistakes": [
    "菜丝没沥干就拌，五分钟盘底一汪汁水。",
    "椰糖没化开，吃到硬糖粒还带苦。",
    "提前一小时拌好放着，蔬菜全塌成一团。",
    "鱼露手抖倒多，酸辣全被咸味压死。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "生菜",
      "ratio": "200克:200克",
      "note": "更嫩，拌好要立刻吃。"
    },
    {
      "original": "花生碎",
      "substitute": "腰果碎",
      "ratio": "40克:40克",
      "note": "香气更甜，坚果过敏者均需避开。"
    }
  ],
  "variations": [
    "加几只水煮虾仁，就是更扎实的主菜沙拉。",
    "换成青芒果丝，酸度更高，接近经典的青芒果沙拉。",
    "滴几滴虾酱进料汁，鲜味更重，是东北部的吃法。"
  ],
  "serving_suggestion": "装在白盘里堆高，配烤鸡与糯米一起吃，作为重口菜的清口前菜。",
  "storage": "冷藏可放半天，料汁与蔬菜分开存放更好，拌好不要超过两小时。",
