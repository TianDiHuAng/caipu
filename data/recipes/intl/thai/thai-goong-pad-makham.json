    "刀",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "罗望子果肉加热水泡十分钟，滤出汁。，先试试温度，口感才不散。",
      "time_min": 12,
      "heat": "无火",
      "tip": "边泡边捏，汁才出得干净。，别用力搅，味道才不闷。",
      "visual_cue": "汁色深褐，果肉脱核，留意锅底，成品才稳当。"
    },
    {
      "n": 2,
      "text": "虾去壳留尾，背部划开挑出虾线。，动作放连贯，表面才漂亮。",
      "time_min": 10,
      "heat": "无火",
      "tip": "挑净虾线，口感才不发苦。，慢慢来别急，味道才不闷。",
      "visual_cue": "虾身完整，背缝干净，份量心里有数，咸淡才好把握。"
    },
    {
      "n": 3,
      "text": "碗里倒罗望子汁、椰糖和鱼露拌匀。，动作放连贯，风味才干净。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调匀，酸甜才平衡。，火别太大，火候才均匀。",
      "visual_cue": "汁体顺滑，颜色褐亮，盖盖焖一会儿，细节才到位。"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，中火下蒜末和红葱头。，别急着加油，形状才完整。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蒜别炒焦，颜色一变就下虾。，下手别慌，表面才漂亮。",
      "visual_cue": "蒜香散出，红葱头丝透明，慢慢来别急，成品才稳当。"
    },
    {
      "n": 5,
      "text": "下虾大火翻炒到变红卷曲。，份量心里有数，食材才不糊。",
      "time_min": 4,
      "heat": "大火",
      "tip": "虾一变红就够，别久炒。，慢慢来别急，形状才完整。",
      "visual_cue": "虾身卷成弯月，颜色橘红"
    },
    {
      "n": 6,
      "text": "倒入罗望子汁，转中小火翻匀。，时间掐准，吃口才舒服。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汁下锅会冒泡，别溅到手上。，先试试温度，颜色才够亮。",
      "visual_cue": "虾身挂色，汁水收浓，留意锅底，食材才不糊。"
    },
    {
      "n": 7,
      "text": "加红辣椒圈，翻两下尝味。，慢慢来别急，味道才进得去。",
      "time_min": 2,
      "heat": "中火",
      "tip": "先尝再补鱼露，别一次加多。，别急着加油，口感才不散。",
      "visual_cue": "辣香升起，汁色发亮，起锅前尝味，表面才漂亮。"
    },
    {
      "n": 8,
      "text": "汁收到挂壳，撒香菜出锅。，别用力搅，口感才不发柴。",
      "time_min": 3,
      "heat": "中火",
      "tip": "收太干会发苦，挂壳就够。，份量心里有数，形状才完整。",
      "visual_cue": "表面油亮，汁不流盘，起锅前尝味，香气才留得住。"
    }
  ],
  "tips": [
    "罗望子汁先滤净，成品才不发渣。，份量心里有数，口感才不发柴。",
    "虾别久炒，变红就够。，锅温要匀，锅气才足。",
    "酸甜先调好再下锅，味道才稳。，注意别烧干，形状才完整。"
  ],
  "common_mistakes": [
    "虾炒太久，肉质发柴。，注意别烧干，火候才均匀。",
    "椰糖没化开，锅里结块。，慢慢来别急，火候才均匀。",
    "汁收太干，只剩苦味。，动作放连贯，味道才不闷。"
  ],
  "substitutions": [
    {
      "original": "罗望子",
      "substitute": "米醋",
      "ratio": "60 克:50 毫升",
      "note": "酸味更直白，椰糖可加十克。"
    },
    {
      "original": "虾",
      "substitute": "鱿鱼",
      "ratio": "600 克:600 克",
      "note": "切圈后炒制时间减一分钟。"
    }
  ],
  "variations": [
    "加菠萝块，果香更足。，翻动放轻，食材才不糊。",
    "撒花生碎，口感更丰富。，下手别慌，食材才不糊。"
  ],
  "serving_suggestion": "配泰国香米饭，把汁浇在饭上。，份量心里有数，香气才留得住。",
  "storage": "冷藏一天，复热用炒锅。，别用力搅，颜色才够亮。",
