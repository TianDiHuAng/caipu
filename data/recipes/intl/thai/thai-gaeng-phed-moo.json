  "equipment": [
    "炒锅",
    "木铲",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肩肉逆着纹理切成三毫米薄片，肥瘦相间的部位最嫩。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切才不塞牙，薄片也更容易入味。",
      "visual_cue": "肉片薄而均匀、纹理短"
    },
    {
      "n": 2,
      "text": "四季豆撕掉两侧老筋，斜切成五厘米长的段备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "老筋不撕会影响口感，斜切更易熟。",
      "visual_cue": "豆段整齐、无粗纤维"
    },
    {
      "n": 3,
      "text": "炒锅放植物油，中小火下红咖喱酱炒两分钟至香味散出、油色发红。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "咖喱酱必须用油炒开，直接下水会结块发苦。",
      "visual_cue": "油面泛红、香气浓烈"
    },
    {
      "n": 4,
      "text": "倒入一半椰奶，边倒边搅，炒到表面浮出红油。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "椰奶炒出油，咖喱的香气才算彻底释放。",
      "visual_cue": "表面析出红油、酱体浓稠"
    },
    {
      "n": 5,
      "text": "下猪肉片翻炒到表面变色，加清水和棕榈糖，中火煮八分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "肉片下锅后快速划散，避免粘成一片。",
      "visual_cue": "肉片转白、汤面微沸"
    },
    {
      "n": 6,
      "text": "放入四季豆再煮六分钟，直到豆段变软但仍带脆感。",
      "time_min": 6,
      "heat": "中火",
      "tip": "四季豆一定要煮透，生豆角含皂苷会引起不适。",
      "visual_cue": "豆段转深绿、能折断"
    },
    {
      "n": 7,
      "text": "倒入剩下的椰奶、鱼露和小米辣，小火煮两分钟后关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椰奶最后放才不会油水分离，汤色更奶白。",
      "visual_cue": "汤汁奶红、辣味扑鼻"
    },
    {
      "n": 8,
      "text": "关火后挤入青柠汁，撒泰国罗勒叶，搅匀即可离锅。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠离火再加，酸香清亮不发苦。",
      "visual_cue": "罗勒叶微萎、香气上扬"
    }
  ],
  "tips": [
    "红咖喱酱比绿咖喱温和，怕辣可以减到三十克。",
    "猪肩肉可用五花肉代替，油脂更足更香。",
    "四季豆换茄子或竹笋同样好吃，先焯再煮。"
  ],
  "common_mistakes": [
    "咖喱酱没炒开就加水，结块且没有香气。",
    "四季豆下锅就起锅，豆角生硬、带生青味。",
    "椰奶一次性全倒入久煮，油水分离汤色发灰。"
  ],
  "substitutions": [
    {
      "original": "猪肩肉",
      "substitute": "鸡腿肉",
      "ratio": "450g 对 450g",
      "note": "鸡肉易熟，炖煮时间减三分钟。"
    },
    {
      "original": "棕榈糖",
      "substitute": "红糖",
      "ratio": "10g 对 8g",
      "note": "焦糖香不同，甜度接近。"
    }
  ],
  "variations": [
    "加两片柠檬叶和少许酸角汁，酸香更立体。",
    "加一把小番茄同煮，果酸解腻颜色也亮。"
  ],
  "serving_suggestion": "配泰国香米饭，咖喱汁拌饭最下饭。",
  "storage": "冷藏两天，冷冻一个月；复热加少许椰奶小火煮开。",
