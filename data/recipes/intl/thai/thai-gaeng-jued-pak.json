  "steps": [
    {
      "n": 1,
      "text": "卷心菜切成三厘米宽的块，胡萝卜切滚刀块，清水冲净沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "两种菜熟的时间不同，胡萝卜一定要切小一点。",
      "visual_cue": "菜块大小均匀，表面无泥沙"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油小火炒香大蒜末，炒到边缘微黄不焦。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜末只炒到微黄，颜色一深整锅汤都带苦。",
      "visual_cue": "蒜末浮在油面，香气清甜"
    },
    {
      "n": 3,
      "text": "倒清水烧开，下胡萝卜煮十分钟，再放卷心菜煮五分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "胡萝卜先下锅，卷心菜久煮会发黄失去脆感。",
      "visual_cue": "胡萝卜能插入筷子，菜叶转深绿"
    },
    {
      "n": 4,
      "text": "加北豆腐再煮三分钟，用鱼露与盐调味，撒白胡椒与香菜关火。",
      "time_min": 3,
      "heat": "中火",
      "tip": "豆腐最后放免得煮碎，鱼露关火前加香气最足。",
      "visual_cue": "豆腐完整浮起，汤色清亮不浑"
    }
  ],
  "tips": [
    "汤要清就别大滚，中小火保持微沸汤色才透亮。",
    "鱼露别早放，久煮会发酸且香气跑掉。",
    "加几片柠檬叶同煮，清香更接近泰国本地味。",
    "喜欢辣可在碗里加一颗捣碎的小米辣。"
  ],
  "common_mistakes": [
    "全程大火滚，汤浑菜烂，一点清爽感都没有。",
    "鱼露一次倒太多，整锅咸得喝不下去。",
    "卷心菜和胡萝卜同时下锅，一个烂了一个还硬。",
    "香菜一起久煮，汤里带一股闷味。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "大白菜",
      "ratio": "250克:250克",
      "note": "更甜，煮的时间减两分钟。"
    },
    {
      "original": "北豆腐",
      "substitute": "鸡蛋豆腐",
      "ratio": "150克:150克",
      "note": "更嫩，下锅后不要搅动。"
    }
  ],
  "variations": [
    "加一把粉丝同煮，就是泰式清汤粉丝。",
    "换成鸡汤打底，鲜味更浓，是节庆版本。",
    "加几粒手打猪肉丸同煮，汤更鲜，孩子也更爱吃。"
  ],
  "serving_suggestion": "盛在深碗里，配白饭与一碟辣酱，泰国家常饭桌的标配清汤。",
  "storage": "冷藏可放一天，复热须煮沸；叶菜隔夜易发黄，建议当餐喝完。",
