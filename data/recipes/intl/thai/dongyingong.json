  "equipment": [
    "汤锅",
    "炒锅",
    "漏勺",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大虾去壳留头尾，挑出虾线；虾头单独留下，用 15ml 植物油小火煸炒 3 分钟压出虾油。",
      "time_min": 8,
      "heat": "小火",
      "tip": "虾头压出红油，汤底才鲜得浓。",
      "visual_cue": "虾头变红、锅底泛橙红油"
    },
    {
      "n": 2,
      "text": "汤锅加 900ml 水，放香茅段、南姜片与柠檬叶，大火烧开转小火煮 8 分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "香料先煮出味，汤底才有层次。",
      "visual_cue": "汤色微黄、香气清冽"
    },
    {
      "n": 3,
      "text": "倒入炒好的虾头与冬阴功酱，搅匀后小火再熬 5 分钟，用漏勺捞出虾头。",
      "time_min": 6,
      "heat": "小火",
      "tip": "虾头熬完要捞出，久煮会发苦。",
      "visual_cue": "汤色橙红浓郁、香味扑鼻"
    },
    {
      "n": 4,
      "text": "下草菇煮 3 分钟，再放大虾仁煮 2 分钟至变红卷曲。",
      "time_min": 5,
      "heat": "中火",
      "tip": "虾仁后下，久煮肉就老了。",
      "visual_cue": "虾仁鲜红卷曲、草菇吸饱汤"
    },
    {
      "n": 5,
      "text": "加鱼露、白糖与椰浆搅匀，小火加热 1 分钟不要煮沸。",
      "time_min": 2,
      "heat": "小火",
      "tip": "椰浆煮沸会油水分离，出现絮状物。",
      "visual_cue": "汤色转乳橙、质地顺滑"
    },
    {
      "n": 6,
      "text": "关火后加入青柠汁与小米辣，撒香菜段即可盛出。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁关火再加，酸味才清爽。",
      "visual_cue": "汤面浮着小米辣、酸香扑鼻"
    }
  ],
  "tips": [
    "青柠汁一定要关火后加，否则酸味变苦。",
    "椰浆不能煮沸，保持微温即可。，会影响最终的口感层次与卖相。",
    "虾头熬油是冬阴功鲜味的秘密。，会影响最终的口感层次与卖相。"
  ],
  "common_mistakes": [
    "青柠汁一开始就加，煮后带明显苦味。",
    "椰浆大火滚煮，汤面浮起絮状颗粒。",
    "虾仁久煮，口感变橡皮。，成品口感会明显变差。"
  ],
  "substitutions": [
    {
      "original": "大虾",
      "substitute": "鸡腿肉",
      "ratio": "400g 对 300g",
      "note": "做冬阴功鸡，煮的时间加 5 分钟。"
    },
    {
      "original": "草菇",
      "substitute": "口蘑",
      "ratio": "150g 对 150g",
      "note": "香气稍淡，南姜加 5g。"
    }
  ],
  "variations": [
    "清汤版：不加椰浆，汤色清亮辣味更冲。",
    "海鲜版：加 100g 鱿鱼圈同煮，海味更足。"
  ],
  "serving_suggestion": "配茉莉香米饭，酸辣汤拌饭特别开胃。",
  "storage": "冷藏 1 天；复热不要煮沸，青柠汁重新补加。",
