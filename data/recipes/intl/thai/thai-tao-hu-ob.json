  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成两厘米厚的片，用厨房纸压十分钟吸干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆腐一定要压干，水分多烤完会软塌不成形。",
      "visual_cue": "豆腐片干爽硬挺，厚薄一致"
    },
    {
      "n": 2,
      "text": "香菜根切碎，与大蒜末、白胡椒、鱼露、椰糖拌成腌汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腌汁只要拌匀不用加热，椰糖有颗粒可以压碎。",
      "visual_cue": "腌汁呈深褐色，蒜末细碎均匀"
    },
    {
      "n": 3,
      "text": "豆腐片两面刷上腌汁，静置十五分钟让味道渗进去。",
      "time_min": 15,
      "heat": "无火",
      "tip": "中途翻一次面，两面咸度才均匀。",
      "visual_cue": "豆腐表面着色均匀，无多余汁水"
    },
    {
      "n": 4,
      "text": "烤箱预热两百度，豆腐铺烤盘刷植物油，烤十五分钟至表面金黄。",
      "time_min": 15,
      "heat": "中火",
      "tip": "中途翻面补刷一次油，边缘才不会干裂。",
      "visual_cue": "表面金黄起皱，边缘微焦不糊"
    },
    {
      "n": 5,
      "text": "出炉挤青柠汁，撒柠檬叶丝与香菜叶即可上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "青柠汁出炉后再挤，烤前挤会发苦。",
      "visual_cue": "香气清亮，豆腐表皮略带脆感"
    }
  ],
  "tips": [
    "北豆腐比嫩豆腐更适合烤，结构紧实不易碎。",
    "腌的时间别超过半小时，否则咸味过重。",
    "想更香可以用炭火烤，表面带一层烟熏味。",
    "剩下的腌汁可以当蘸汁，加点青柠更清爽。"
  ],
  "common_mistakes": [
    "豆腐没压干就烤，出锅软塌得像布丁。",
    "腌汁里椰糖没压碎，烤完表面有黑点。",
    "烤箱温度太低，豆腐慢慢出水，烤不出脆皮。",
    "烤完立刻装盘，盘底积水，脆皮全泡软。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "鸡蛋豆腐",
      "ratio": "450克:450克",
      "note": "更嫩，烤的时间减三分钟。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽加少许盐",
      "ratio": "20毫升:20毫升",
      "note": "鲜味稍减，咸度相近。"
    }
  ],
  "variations": [
    "加一勺泰式咖喱酱进腌汁，风味更浓，接近咖喱烤豆腐。",
    "烤好后配花生蘸酱，口感更丰富。",
    "把豆腐换成蘑菇同烤，吸味更快，时间减五分钟。"
  ],
  "serving_suggestion": "配黄瓜片与糯米团，淋上一点剩下的腌汁，是很清爽的素食主菜。",
  "storage": "冷藏可放两天，复热用烤箱一百八十度烤五分钟，微波会返软失去脆皮。",
