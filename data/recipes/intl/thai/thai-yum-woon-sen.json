  "equipment": [
    "汤锅",
    "大拌碗",
    "漏勺",
    "捣钵"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干粉丝用温水泡十分钟到能弯折不断，捞出剪成两段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别用热水泡，粉丝外层糊了里面还是硬的。",
      "visual_cue": "粉丝透明柔软、用手能轻松掐断"
    },
    {
      "n": 2,
      "text": "清水烧开，下五花肉片汆到变色卷起，捞出过凉水沥干。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉片切得越薄越嫩，汆的时间控制在四十秒内。",
      "visual_cue": "肉片变白卷边、无粉红色"
    },
    {
      "n": 3,
      "text": "同一锅水汆烫粉丝三十秒，捞出立刻过冰水，彻底沥干。",
      "time_min": 3,
      "heat": "中火",
      "tip": "过冰水能让粉丝弹牙不粘连，沥干是关键。",
      "visual_cue": "粉丝根根分明、抓一把不滴水"
    },
    {
      "n": 4,
      "text": "大蒜与小米辣在捣钵里捣成粗末，加鱼露、白糖和柠檬汁搅到糖化。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先尝一口酱汁，酸辣咸要同时到位才够泰式。",
      "visual_cue": "酱汁清澈、尝起来先酸后辣带回甘"
    },
    {
      "n": 5,
      "text": "大碗里放粉丝、五花肉、洋葱丝、芹菜、小葱和香菜，倒入酱汁拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用手抓拌比用筷子匀，粉丝能均匀吸味。",
      "visual_cue": "粉丝均匀上色、蔬菜分布均匀"
    },
    {
      "n": 6,
      "text": "装盘后撒上烤香压碎的花生，挤少许柠檬汁即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "花生最后撒，久放会吸水变软失去脆感。",
      "visual_cue": "花生碎金黄、粉丝湿润不汪汁"
    }
  ],
  "tips": [
    "粉丝沥干后可用剪刀剪短，拌和吃起来更方便。",
    "想更清爽可加大洋葱与芹菜的比例，同时减少粉丝用量。",
    "鱼露品牌咸度差异大，先少放后补味。"
  ],
  "common_mistakes": [
    "粉丝泡太久又焯水，拌完变成一坨糊。",
    "酱汁只有酸没有糖，吃起来尖锐寡淡。",
    "五花肉汆过头变柴，咬着像橡皮。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "鸡腿肉",
      "ratio": "150g 对 150g",
      "note": "需切丝并缩短汆水时间。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "30ml 对 30ml",
      "note": "咸鲜更直接，缺少发酵香。"
    }
  ],
  "variations": [
    "把五花肉减半、洋葱与芹菜加倍，做成更爽脆的轻食版本。",
    "小米辣与香菜加量，做成依善风味的重辣版本。"
  ],
  "serving_suggestion": "凉拌上桌配烤肉同食，作为泰式套餐的清爽前菜。",
  "storage": "冷藏一夜，酱汁与粉丝分开保存可避免过软；食用前再拌。",
