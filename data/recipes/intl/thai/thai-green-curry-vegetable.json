          "name_en": "green curry paste",
          "amount": 50,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 400,
          "unit": "ml",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "青椒",
          "name_en": "green bell pepper",
          "amount": 150,
          "unit": "g",
          "note": "切菱形块",
          "optional": false
        },
        {
          "name": "泰国罗勒",
          "name_en": "Thai basil",
          "amount": 20,
          "unit": "g",
          "note": "取叶片",
          "optional": false
        },
        {
          "name": "鱼露",
          "name_en": "fish sauce",
          "amount": 15,
