          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "大碗",
    "小锅",
    "汤勺",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉放碗里，分次加清水揉成光滑面团。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水慢慢加，面团才不粘手。，火候要稳，别忽大忽小。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 2,
      "text": "面团搓成长条，揪成小块搓成小圆子。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "圆子搓小一点，煮时才透。，火候要稳，别忽大忽小。",
      "visual_cue": "圆子均匀，表面光洁"
    },
    {
      "n": 3,
      "text": "汤锅烧水，水开后下圆子轻轻推散。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "大火",
      "tip": "轻轻推，圆子才不粘底。，火候要稳，别忽大忽小。",
      "visual_cue": "圆子浮起，水面旋转"
    },
    {
      "n": 4,
      "text": "圆子全浮起后再煮两分钟，捞出过凉水。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "大火",
      "tip": "过凉水让圆子更弹，不粘连。，火候要稳，别忽大忽小。",
      "visual_cue": "圆子透亮，颗颗分明"
    },
    {
      "n": 5,
      "text": "小锅倒椰奶，小火加热到边缘冒小泡。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰奶别煮滚，滚了会分层。，火候要稳，别忽大忽小。",
      "visual_cue": "边缘起泡，表面微动"
    },
    {
      "n": 6,
      "text": "加白糖和盐，搅到完全溶解。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐提味，糖才不腻。，火候要稳，别忽大忽小。",
      "visual_cue": "液体顺滑，甜香散开"
    },
    {
      "n": 7,
      "text": "圆子盛碗，浇上热椰奶，趁温热吃。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "圆子泡久会涨，端上桌再浇。，火候要稳，别忽大忽小。",
      "visual_cue": "圆子浮在汤上，奶白清亮"
    }
  ],
  "tips": [
    "糯米粉水慢慢加，面团才不粘手。，这一点很关键。",
    "椰奶别煮滚，否则分层。，这一点很关键。",
    "加一点盐，甜味才不腻。，这一点很关键。"
  ],
  "common_mistakes": [
    "水一次倒完，面团粘手成糊。，这一点很关键。",
    "火大煮椰奶，油水分离。，这一点很关键。",
    "圆子搓太大，中心煮不透。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "500 毫升:500 毫升",
      "note": "少了椰香，可加一点椰蓉。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "70 克:75 克",
      "note": "颜色更深，风味更重。"
    }
  ],
  "variations": [
    "圆子里包一小块红糖，咬开流心。，这一点很关键。",
    "加一点香兰叶同煮，香气更足。，这一点很关键。"
  ],
  "serving_suggestion": "温热吃，冬天当暖胃甜汤。，这一点很关键。",
  "storage": "冷藏一天，圆子与椰奶分开保存。，这一点很关键。",
