  ],
  "equipment": [
    "搅拌机",
    "杯子",
    "量杯",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "椰奶提前冷藏两小时，取出后摇匀让油脂重新混合。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏后打的冰饮更顺滑，也不容易分层。",
      "visual_cue": "椰奶浓稠，无分层，状态稳定"
    },
    {
      "n": 2,
      "text": "把椰奶倒进搅拌机，加牛奶和清水稀释到合适浓稠度。",
      "time_min": 3,
      "heat": "无火",
      "tip": "太浓会腻口，加清水调到能顺畅流动。",
      "visual_cue": "液体顺滑，颜色奶白，状态稳定"
    },
    {
      "n": 3,
      "text": "加白糖和一小撮盐，搅打三十秒到糖完全溶解。",
      "time_min": 2,
      "heat": "无火",
      "tip": "一点点盐能提椰香，不影响甜味。，注意火候。",
      "visual_cue": "甜度均匀，闻着发香，状态稳定"
    },
    {
      "n": 4,
      "text": "倒入装有冰块的杯子，表面撒少许椰蓉即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冰块装八分满，倒进去才不会溢出来。",
      "visual_cue": "杯壁凝水，冰饮分层，状态稳定"
    }
  ],
  "tips": [
    "椰奶先冷藏摇匀，打出来才顺滑不分层。",
    "加一小撮盐，椰香会更突出。，值得留意。",
    "冰别装太满，倒液体时才不溢出。，值得留意。"
  ],
  "common_mistakes": [
    "椰奶没摇匀就用，上层油脂结块。，务必避免。",
    "糖没搅化直接倒冰里，甜味不均。，务必避免。",
    "冰装太满，倒的时候撒一桌。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "豆奶",
      "ratio": "200 毫升:200 毫升",
      "note": "豆香清淡，适合不吃乳制品的人。"
    },
    {
      "original": "白糖",
      "substitute": "椰糖",
      "ratio": "50 克:55 克",
      "note": "焦香更浓，颜色偏深。"
    }
  ],
  "variations": [
    "加一勺椰肉碎，口感更有层次。，也很受欢迎。",
    "滴几滴香兰叶汁，颜色和香气都更泰式。"
  ],
  "serving_suggestion": "冰镇后当餐后饮品，配辛辣的泰菜最解辣。，效果更稳定。",
  "storage": "冷藏当天喝完，饮用前摇匀。，效果更稳定。",
