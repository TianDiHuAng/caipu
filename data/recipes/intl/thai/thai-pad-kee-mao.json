  "steps": [
    {
      "n": 1,
      "text": "米粉用温水泡二十分钟到软而有芯。，看准状态再往下做。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡到能弯不断，炒时才不烂。，看准状态再往下做。",
      "visual_cue": "粉条柔软，指甲可掐断"
    },
    {
      "n": 2,
      "text": "鸡腿切薄片，用一半鱼露抓匀腌五分钟。，看准状态再往下做。",
      "time_min": 7,
      "heat": "无火",
      "tip": "薄片易熟，腌一下有底味。，看准状态再往下做。",
      "visual_cue": "肉片湿润，颜色略深"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下蒜末和小米椒爆香。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火爆香，辣味才冲出来。，看准状态再往下做。",
      "visual_cue": "蒜末金黄，辣气上扬"
    },
    {
      "n": 4,
      "text": "下鸡腿片快速翻炒到表面变白。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火快炒，肉才嫩。，看准状态再往下做。",
      "visual_cue": "肉片卷曲，颜色转白"
    },
    {
      "n": 5,
      "text": "推到锅边，打入鸡蛋炒散成块。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蛋先炒散，拌进面里才香。，看准状态再往下做。",
      "visual_cue": "蛋块金黄，无流动，这点要注意。"
    },
    {
      "n": 6,
      "text": "下米粉和洋葱丝，用筷子抖散翻炒。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "用筷子抖散，粉条才不结团。，看准状态再往下做。",
      "visual_cue": "粉条分明，充分裹油"
    },
    {
      "n": 7,
      "text": "加酱油、剩余鱼露和棕榈糖，炒到上色。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "沿锅边淋酱油，香气才冲。，看准状态再往下做。",
      "visual_cue": "粉条深褐，油光发亮"
    },
    {
      "n": 8,
      "text": "下青豆炒一分钟，关火撒罗勒叶拌匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "罗勒关火拌，香气才不跑。，看准状态再往下做。",
      "visual_cue": "叶色翠绿，豆色鲜亮"
    }
  ],
  "tips": [
    "米粉泡到软而有芯，炒时才不断。，这是关键点。",
    "全程大火，粉条才不粘锅。，别嫌麻烦，做完它。",
    "罗勒关火再拌，香气最足。，这一步别省。"
  ],
  "common_mistakes": [
    "米粉泡太软，一炒就断。，别跳过这步。",
    "火小慢炒，粉条粘成一团。，这步最关键。",
    "酱油一次倒完，咸得发苦。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "虾",
      "ratio": "250 克:250 克",
      "note": "炒到变红即可，更快熟。"
    },
    {
      "original": "青豆",
      "substitute": "豆芽",
      "ratio": "60 克:80 克",
      "note": "最后放，保持脆感。"
    }
  ],
  "variations": [
    "加几片紫苏叶，香气更野。，这里最容易翻车。",
    "用牛肉片代替鸡腿，味道更浓。，别小看这一步。"
  ],
  "serving_suggestion": "趁热吃，配一杯冰镇饮料。，成败就在这一步。",
  "storage": "不建议隔夜，粉条会回生。，这点要注意。",
