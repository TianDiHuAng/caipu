  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去皮切成入口大小的块，用少许鱼露抓匀腌十分钟去腥。",
      "time_min": 10,
      "heat": "无火",
      "tip": "去皮后汤不浮油，更清爽。",
      "visual_cue": "鸡块均匀、表面微黏"
    },
    {
      "n": 2,
      "text": "南姜切薄片，香茅拍扁切段，柠檬叶撕碎，小米椒拍破备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香茅拍扁香气才出得来。",
      "visual_cue": "香料拍裂、香气散出"
    },
    {
      "n": 3,
      "text": "高汤与椰浆一起下锅，放入南姜、香茅与柠檬叶小火煮五分钟出香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "椰浆别大火滚，会油水分离。",
      "visual_cue": "汤色奶白、香料浮面"
    },
    {
      "n": 4,
      "text": "下鸡块与草菇小火煮十分钟，撇去浮沫，煮到鸡肉完全变白。",
      "time_min": 10,
      "heat": "小火",
      "tip": "保持微沸，鸡肉才嫩。",
      "visual_cue": "鸡肉全白、草菇变软"
    },
    {
      "n": 5,
      "text": "加鱼露与白糖调味，关火后挤入青柠汁，撒小米椒与香菜。",
      "time_min": 4,
      "heat": "小火",
      "tip": "青柠汁关火后加，酸味才清。",
      "visual_cue": "汤色乳白、酸辣扑鼻"
    }
  ],
  "tips": [
    "椰浆全程小火，滚沸会让油脂分离、汤面浮起絮状物。",
    "青柠汁一定要关火后再挤，加热过的酸味会发苦。",
    "南姜与香茅只取香气不吃，盛碗时挑出来更清爽。"
  ],
  "common_mistakes": [
    "椰浆大火滚开，汤变成油水分层的絮状。",
    "青柠汁跟材料一起下锅煮，酸味发闷带苦。",
    "用姜代替南姜，香气完全不同、汤味发冲。"
  ],
  "substitutions": [
    {
      "original": "草菇",
      "substitute": "口蘑",
      "ratio": "120g 对 120g",
      "note": "鲜味接近，口感更软。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "虾",
      "ratio": "300g 对 300g",
      "note": "做成椰奶虾汤，煮制时间缩短到 5 分钟。"
    }
  ],
  "variations": [
    "海鲜版：加 150g 虾与 100g 鱿鱼，最后三分钟下锅。",
    "素食版：鸡腿换成 200g 老豆腐与 100g 杏鲍菇。"
  ],
  "serving_suggestion": "盛进深碗，配一碗泰国香米饭，酸辣汤汁拌饭最下饭。",
  "storage": "冷藏可存 1 天，复热须小火并重新挤少许青柠汁。",
