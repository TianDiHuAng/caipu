  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉块用一半黄咖喱酱和鱼露抓匀，腌十五分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "腌透了肉才有味，别省这一步。，看住火，别让它失控。",
      "visual_cue": "肉块挂酱，颜色发黄"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，小火炒香红葱头末和剩余黄咖喱酱。",
      "time_min": 5,
      "heat": "小火",
      "tip": "咖喱炒出油，饭才够香。，全程留意火候，别贪快。",
      "visual_cue": "酱体冒泡，油色转红"
    },
    {
      "n": 3,
      "text": "下腌好的鸡肉块，中火翻炒到表面变白。，火大了就离锅远一点。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉块裹住咖喱，焖出来才入味。，火别开太大，稳着来。",
      "visual_cue": "肉块挂酱，边角收紧"
    },
    {
      "n": 4,
      "text": "加红糖炒匀，倒入椰奶煮开后关火。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "中火",
      "tip": "椰奶别久煮，香气会跑。，火力保持中等，慢慢来。",
      "visual_cue": "汤色奶黄，香气浓，别小看这一步。"
    },
    {
      "n": 5,
      "text": "大米放进电饭锅，加清水和炒好的鸡肉连酱汁。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水按米量算，酱汁也含水分。，注意锅里温度别掉下来。",
      "visual_cue": "米粒铺平，汤汁浸过"
    },
    {
      "n": 6,
      "text": "放一根香茅在米上，按下煮饭键焖熟。，始终中小火，别心急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "香茅整根放，焖完取出。，火要均匀，食材才不糊。",
      "visual_cue": "按键跳起，香气满锅"
    },
    {
      "n": 7,
      "text": "焖好别马上开盖，静置十分钟再拌松。，看住火，别让它失控。",
      "time_min": 11,
      "heat": "无火",
      "tip": "静置让水汽回匀，饭才不湿。，全程留意火候，别贪快。",
      "visual_cue": "开盖热气腾，米粒分明"
    },
    {
      "n": 8,
      "text": "取出香茅，鸡肉配黄瓜片摆盘上桌。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "无火",
      "tip": "黄瓜解腻，配着吃更清爽。，火别开太大，稳着来。",
      "visual_cue": "饭色金黄，黄瓜翠绿"
    }
  ],
  "tips": [
    "鸡肉腌透，焖出来才有味。，成败就在这一步。",
    "咖喱酱炒出油，饭才香。，这点要注意。",
    "焖好静置十分钟，米粒才松散。，这是关键点。"
  ],
  "common_mistakes": [
    "鸡肉不腌直接焖，味道只在表面。，别嫌麻烦，做完它。",
    "水放太多，焖成烂饭。，这一步别省。",
    "焖好立刻开盖，饭发黏。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡翅",
      "ratio": "400 克:450 克",
      "note": "焖的时间加十分钟。"
    },
    {
      "original": "黄咖喱酱",
      "substitute": "咖喱粉",
      "ratio": "45 克:25 克",
      "note": "需另加盐调味。"
    }
  ],
  "variations": [
    "加一点葡萄干，甜味更明显。，这步最关键。",
    "配泰式酸甜酱一起吃。，很多人在这里出错。"
  ],
  "serving_suggestion": "配黄瓜片和一碗清汤。，这里最容易翻车。",
  "storage": "冷藏两天，复热加一勺水。，别小看这一步。",
