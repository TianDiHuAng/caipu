  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 750,
          "unit": "g",
          "note": "去骨切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 40,
          "unit": "g",
          "note": "拍碎",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 5,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "鱼露",
          "name_en": "fish sauce",
          "amount": 30,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 45,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 20,
          "unit": "g",
          "note": "切段",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "研钵"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿去骨切成三厘米见方的块，用厨房纸吸干表面水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表面干爽，下锅才煎出香气不出水。，注意火候。",
      "visual_cue": "肉块干爽，大小一致，状态稳定"
    },
    {
      "n": 2,
      "text": "蒜拍碎后和黑胡椒一起放进研钵，捣成粗粒的香料泥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "捣比切更出香，胡椒别磨太细。，注意火候。",
      "visual_cue": "泥状带颗粒，香气冲鼻"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下香料泥小火炒三十秒出香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜一变色就会苦，闻到香就下鸡肉。，注意火候。",
      "visual_cue": "油面起泡，蒜香四溢，状态稳定"
    },
    {
      "n": 4,
      "text": "转中大火放入鸡块，平铺不翻动煎两分钟定型上色。",
      "time_min": 5,
      "heat": "中大火",
      "tip": "先别翻动，让肉面贴着锅煎出焦香。，注意火候。",
      "visual_cue": "底面金黄，锅气足，状态稳定"
    },
    {
      "n": 5,
      "text": "翻炒到鸡块整体变白，加鱼露和白糖继续炒三分钟。",
      "time_min": 5,
      "heat": "中大火",
      "tip": "鱼露后放，久炒会发苦失香。，注意火候。",
      "visual_cue": "肉块上色，汁水收干，状态稳定"
    },
    {
      "n": 6,
      "text": "沿锅边淋少许清水，盖盖焖两分钟让肉熟透入味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "少量水焖一下，肉才嫩不干。，注意火候。",
      "visual_cue": "锅中有汁，香气浓，状态稳定"
    },
    {
      "n": 7,
      "text": "开盖收汁，撒香菜段翻匀后关火装盘。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菜最后放，清香才留得住。，注意火候。",
      "visual_cue": "汁水挂肉，表面油亮，状态稳定"
    }
  ],
  "tips": [
    "蒜和胡椒用研钵捣，香气比切碎更足。，值得留意。",
    "鸡块表面吸干水，下锅才煎得上色。，值得留意。",
    "鱼露后放，久炒会发苦失香。，值得留意。"
  ],
  "common_mistakes": [
    "蒜炒到发黑才下肉，整锅带苦味。，务必避免。",
    "鸡块带水直接下锅，变成水煮鸡。，务必避免。",
    "鱼露下太早，炒久了香气全跑光。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鱼露",
      "substitute": "酱油",
      "ratio": "30 毫升:30 毫升",
      "note": "咸味更温和，可加少许盐。"
    },
    {
      "original": "鸡腿",
      "substitute": "鸡胸肉",
      "ratio": "750 克:700 克",
      "note": "更瘦，焖制时间减一分钟。"
    }
  ],
  "variations": [
    "加一把九层塔同炒，香气更泰式。，也很受欢迎。",
    "最后挤几滴柠檬汁，解腻又清爽。，也很受欢迎。"
  ],
  "serving_suggestion": "配香米饭和一只煎蛋，是最常见的泰式家常搭配。",
  "storage": "冷藏两天，复热用炒锅大火快炒一分钟。，效果更稳定。",
