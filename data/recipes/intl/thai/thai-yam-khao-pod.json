      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "沙拉碗",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜玉米剥去外皮和须，整根放进蒸锅，水开后蒸十二分钟。",
      "time_min": 12,
      "heat": "大火",
      "tip": "整根蒸比掰断蒸更保水，颗粒不会因切口失水发皱。",
      "visual_cue": "玉米粒鼓胀发亮，用叉子一戳就出浆。"
    },
    {
      "n": 2,
      "text": "蒸好的玉米稍放凉，顺着玉米芯把颗粒整排剥下来装碗。",
      "time_min": 3,
      "heat": "无火",
      "tip": "凉到不烫手再剥，太烫会把玉米粒压破出水。",
      "visual_cue": "玉米粒完整成排，碗里没有多余汁水。"
    },
    {
      "n": 3,
      "text": "番茄切薄片，洋葱切细丝用冷水泡十分钟后沥干水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "洋葱丝切得越细越好入口，粗细不均会有一口呛一口淡。",
      "visual_cue": "洋葱丝透亮不刺眼，番茄片整齐。"
    },
    {
      "n": 4,
      "text": "小碗里挤入青柠汁，加鱼露、细砂糖和辣椒粉搅到糖化开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先尝一口汁，酸辣甜三味平衡了再往玉米里倒。",
      "visual_cue": "调味汁呈淡琥珀色，碗底没有糖粒。"
    },
    {
      "n": 5,
      "text": "把玉米粒、番茄片、洋葱丝和调味汁一起翻拌，撒香菜段装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "用两把勺子从底往上翻，玉米粒才不会被压碎。",
      "visual_cue": "每粒玉米都裹上薄汁，盘面无积水。"
    }
  ],
  "tips": [
    "玉米蒸比煮甜，蒸汽不带走糖分，颗粒也更饱满。",
    "洋葱丝泡十分钟冷水再沥干，辛辣味去掉大半，只剩清甜。",
    "青柠汁最后拌，早放会让玉米粒失去脆感，出水变软。"
  ],
  "common_mistakes": [
    "玉米煮过头，颗粒发皱、甜味跑进水里，拌出来寡淡。",
    "所有调料一次倒进去猛拌，酸辣盖住玉米本身的甜，吃着只有刺激。",
    "拌好放着不管，半小时后盘底积一层水，沙拉变成泡菜。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "2个:1个",
      "note": "酸度略低，香气更柔和。"
    },
    {
      "original": "鱼露",
      "substitute": "淡酱油",
      "ratio": "20毫升:18毫升",
      "note": "素食可用，鲜味层次少一层。"
    }
  ],
  "variations": [
    "加一把炒香压碎的坚果，脆感和坚果香让整盘更立体。",
    "把番茄换成小番茄对半切，酸甜更集中，颜色也更鲜亮。"
  ],
  "serving_suggestion": "拌好立刻装盘，表面撒香菜段，配烤鸡或糯米饭吃，酸辣刚好解腻。",
  "storage": "调料与玉米分开冷藏，吃前再拌，冷藏不超过一天，出水后口感明显下降。",
