  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "空心菜摘成十厘米长的段，老梗去掉，洗净沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "老梗掐不动就丢掉，只留嫩茎和叶子。",
      "visual_cue": "菜段翠绿，叶片完整"
    },
    {
      "n": 2,
      "text": "蒜瓣拍碎后再切成末，小米椒切成斜段备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜拍过再切，香味比直接切更冲。",
      "visual_cue": "蒜末粗糙带汁，椒段整齐"
    },
    {
      "n": 3,
      "text": "炒锅大火烧到冒烟倒植物油，下蒜末和椒段爆香。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅一定要烧透，菜下去才有锅气不发水。",
      "visual_cue": "蒜末瞬间金黄，香气炸开"
    },
    {
      "n": 4,
      "text": "立刻下空心菜，用铲子快速翻炒到叶片开始塌软。",
      "time_min": 2,
      "heat": "大火",
      "tip": "菜下锅就猛火快炒，慢一秒就出水变黄。",
      "visual_cue": "菜叶塌软，茎仍挺脆"
    },
    {
      "n": 5,
      "text": "沿锅边淋入鱼露、酱油和清水，加白糖快速炒匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "调味沿锅边淋，遇热激香味道更立体。",
      "visual_cue": "菜色深绿油亮，盘底少汁"
    }
  ],
  "tips": [
    "空心菜要大火快炒，慢炒会出水发黄。",
    "老梗一定掐掉，否则嚼起来像草绳。",
    "调味沿锅边淋入，香气比直接倒更足。"
  ],
  "common_mistakes": [
    "小火慢炒空心菜，炒出一盘黄汤水。",
    "蒜末冷油下锅，香味没出来就糊了。",
    "菜洗完不沥干直接下锅，油花四溅还出水。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "芥蓝",
      "ratio": "500 克:450 克",
      "note": "更脆爽，炒制时间多三十秒。"
    },
    {
      "original": "小米椒",
      "substitute": "辣椒酱",
      "ratio": "10 克:15 克",
      "note": "辣度更柔和，鱼露减五毫升。"
    }
  ],
  "variations": [
    "加一小勺虾酱同炒，鲜味更地道更浓郁。",
    "放几片蒜片先爆香，香气更圆润。"
  ],
  "serving_suggestion": "趁热立刻上桌，配咖喱或炒饭最解腻。",
  "storage": "现炒现吃最好，隔夜菜色发黄不建议留。",
