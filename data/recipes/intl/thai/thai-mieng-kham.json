  "steps": [
    {
      "n": 1,
      "text": "假蒌叶摘去硬梗，用清水泡洗两遍沥干。，这一步的关键在于火候。",
      "time_min": 8,
      "heat": "无火",
      "tip": "叶片要完整无破口，包料才不会漏。，这一步的关键在于火候。",
      "visual_cue": "叶片挺括，无泥沙残留"
    },
    {
      "n": 2,
      "text": "椰丝倒进干锅，小火炒到微黄出香。，这一步的关键在于火候。",
      "time_min": 5,
      "heat": "小火",
      "tip": "干锅不放油，椰丝才炒得松散。，这一步的关键在于火候。",
      "visual_cue": "椰丝微黄，香气清甜"
    },
    {
      "n": 3,
      "text": "花生米用刀背压碎，保留一半颗粒。，这一步的关键在于火候。",
      "time_min": 4,
      "heat": "无火",
      "tip": "压碎不碾粉，咬着才有层次。，这一步的关键在于火候。",
      "visual_cue": "颗粒不均，香气溢出"
    },
    {
      "n": 4,
      "text": "青柠、小米辣、红葱头和姜切成细丁。，这一步的关键在于火候。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切得越细，一口咬下去越融合。，这一步的关键在于火候。",
      "visual_cue": "丁粒均匀，汁水微出"
    },
    {
      "n": 5,
      "text": "椰糖加清水小火化开，加鱼露熬成浓汁。，这一步的关键在于火候。",
      "time_min": 5,
      "heat": "小火",
      "tip": "熬到能挂勺，太稀会流得到处是。，这一步的关键在于火候。",
      "visual_cue": "汁液浓稠，色如琥珀"
    },
    {
      "n": 6,
      "text": "托盘上把椰丝、花生、四色丁和酱汁分格摆好。，这一步的关键在于火候。",
      "time_min": 4,
      "heat": "无火",
      "tip": "分开放，吃的时候自己搭。，这一步的关键在于火候。",
      "visual_cue": "摆盘整齐，颜色分明"
    },
    {
      "n": 7,
      "text": "取一片叶子，依次放各种料，卷起一口吃掉。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "无火",
      "tip": "别贪多，一勺料刚好一口。，这一步的关键在于火候。",
      "visual_cue": "叶卷小巧，馅料不溢"
    }
  ],
  "tips": [
    "叶子洗净后要沥干，带水会稀释酱汁。",
    "椰糖汁熬浓一点，包的时候才不流手。",
    "各种料切细丁，一口下去味道才均匀。"
  ],
  "common_mistakes": [
    "叶子洗后带水，包好汁水横流。，这一点很关键。",
    "酱汁熬太稀，滴得到处都是。，这一点很关键。",
    "辣椒放太多，一口下去只剩辣。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "假蒌叶",
      "substitute": "生菜叶",
      "ratio": "20 片:20 片",
      "note": "口感更脆，缺少独特香气。"
    },
    {
      "original": "椰丝",
      "substitute": "椰蓉",
      "ratio": "80 克:80 克",
      "note": "更甜，糖量可减一成。"
    }
  ],
  "variations": [
    "加一小块烤姜，辛香更有层次。，这一点很关键。",
    "用虾干替代花生，鲜味更足。，这一点很关键。"
  ],
  "serving_suggestion": "作为餐前小食，配冰镇饮料。，这一点很关键。",
  "storage": "配料分别冷藏，叶子当日用完，酱汁冷藏三天。",
