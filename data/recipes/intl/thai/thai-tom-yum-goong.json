  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香茅拍裂切段，南姜切片，柠檬叶撕开去梗备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香料拍裂撕开才能释放精油，整块下锅只有形没有味。",
      "visual_cue": "香料气味扑鼻，叶面可见裂口"
    },
    {
      "n": 2,
      "text": "鸡汤煮开，下香茅、南姜与柠檬叶，中小火煮五分钟出香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先煮香料再放其他料，汤底才有层次。",
      "visual_cue": "汤面香气浓郁，清水转淡黄"
    },
    {
      "n": 3,
      "text": "下蘑菇煮三分钟至变软，再放小米椒煮出辣味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "辣椒拍裂再下，辣味才溶进汤里。",
      "visual_cue": "蘑菇变软吸汁，汤色微浑"
    },
    {
      "n": 4,
      "text": "放入虾仁煮两分钟，见虾仁卷曲、通体变红后立刻转小火。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "虾仁一变色就够，久煮会缩成硬球。",
      "visual_cue": "虾仁卷成弯月，通体粉红"
    },
    {
      "n": 5,
      "text": "倒入椰奶搅匀，加鱼露与白糖调味后保持微沸。",
      "time_min": 4,
      "heat": "小火",
      "tip": "椰奶下锅后不要大滚，否则会析出油花。",
      "visual_cue": "汤色转成奶白微橘"
    },
    {
      "n": 6,
      "text": "关火后挤入青柠汁，撒上香菜碎，盛进深碗里趁热上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "青柠汁离火再加，酸味才清亮不涩。",
      "visual_cue": "汤面清香扑鼻，酸辣平衡"
    }
  ],
  "tips": [
    "香料只取其味，盛汤时可以不盛进碗里。",
    "青柠汁务必关火后再加，高温会让酸味变苦。",
    "想更浓郁可以加一小勺辣椒膏提色。"
  ],
  "common_mistakes": [
    "青柠汁下锅煮开，整锅汤发苦失去清香。",
    "虾仁在汤里煮得太久，肉质收紧失去弹性，嚼起来发硬。",
    "椰奶大火滚沸，汤面浮起一层油。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "300 克:300 克",
      "note": "鸡肉切薄片，煮制时间延长两分钟。"
    },
    {
      "original": "椰奶",
      "substitute": "淡奶",
      "ratio": "200 毫升:180 毫升",
      "note": "奶香更清，汤体略稀。"
    }
  ],
  "variations": [
    "换成鱼片做冬阴功鱼汤，鲜味更集中。",
    "加几片草菇和番茄，汤体更酸更开胃。"
  ],
  "serving_suggestion": "盛在深碗中，配一碗泰国香米饭同食。",
  "storage": "冷藏两天；复热时补一点青柠汁恢复酸香，不要久煮。",
