  "equipment": [
    "炒锅",
    "木勺",
    "沙拉碗",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉倒进干锅小火炒到微黄出香，盛出备用，这就是泰式炒米粉。",
      "time_min": 6,
      "heat": "小火",
      "tip": "干锅炒粉，不加一滴油。",
      "visual_cue": "米粉微黄、香气明显"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油中火烧热，下剁碎的鸡腿肉炒散，炒到肉粒变白断生。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡肉粒要炒散，别结成团。",
      "visual_cue": "鸡粒松散、颜色变白"
    },
    {
      "n": 3,
      "text": "关火后加鱼露、青柠汁、辣椒粉与盐拌匀，再拌入洋葱丝、薄荷与香菜。",
      "time_min": 5,
      "heat": "无火",
      "tip": "离火调味，香气不被炒散。",
      "visual_cue": "鸡粒裹汁、香气扑鼻"
    },
    {
      "n": 4,
      "text": "装盘撒炒米粉与剩余辣椒粉，用洗净的生菜叶包着吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "吃前再撒粉，保持干香。",
      "visual_cue": "表面撒粉、配菜鲜绿"
    }
  ],
  "tips": [
    "糯米粉干锅炒到微黄才香，生粉直接撒会带粉味。",
    "鸡肉粒炒散后离火调味，青柠的酸香才不被高温破坏。",
    "洋葱丝切得越细越好，拌进去才脆口。"
  ],
  "common_mistakes": [
    "糯米粉没炒就撒，吃起来一股生粉味。",
    "鸡肉下锅没炒散，拌的时候味道进不去还结块。",
    "青柠汁早放又加热，酸味变闷还发苦。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "猪里脊",
      "ratio": "400g 对 400g",
      "note": "剁碎后炒制时间加 2 分钟。"
    },
    {
      "original": "鱼露",
      "substitute": "酱油",
      "ratio": "25ml 对 25ml",
      "note": "素食可用，咸度略高。"
    }
  ],
  "variations": [
    "牛肉版：换成牛肉粒，炒到全熟再调味。",
    "素食版：用 300g 豆腐碎代替鸡肉，炒干水分。"
  ],
  "serving_suggestion": "配糯米、生菜叶与黄瓜片，包起来一口吃。",
  "storage": "冷藏可存 1 天，冷食风味更清爽，不建议复热。",
