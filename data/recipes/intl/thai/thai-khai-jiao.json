  },
  "servings": 2,
  "flavor": [
    "salty",
    "umami",
    "tangy"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 4,
          "unit": "piece",
          "note": "室温鸡蛋更易打发",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切细葱花",
          "optional": false
        },
        {
          "name": "红辣椒",
          "name_en": "red chili",
          "amount": 10,
          "unit": "g",
          "note": "切圈，怕辣可去籽",
          "optional": false
        },
        {
          "name": "青柠",
          "name_en": "lime",
          "amount": 1,
          "unit": "piece",
          "note": "切角挤汁",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "鱼露",
          "name_en": "fish sauce",
          "amount": 10,
          "unit": "ml",
          "note": "替代盐，提供咸鲜",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 60,
          "unit": "ml",
          "note": "半煎半炸用量",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小炒锅",
    "打蛋碗",
    "筷子",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打入碗中，用筷子垂直来回抽打，打散蛋黄但不要打出太多泡沫。",
      "time_min": 3,
      "heat": "无火",
      "tip": "泰式煎蛋讲究蛋液拉丝，不是打出空气的软绵质地。",
      "visual_cue": "蛋液均匀无蛋清块、表面少泡"
    },
    {
      "n": 2,
      "text": "加入鱼露与黑胡椒搅匀，尝一小口应咸鲜适中、略带鱼露的腥香。",
      "time_min": 2,
      "heat": "无火",
      "tip": "鱼露咸度差别大，先少放，尝后再补。",
      "visual_cue": "蛋液微微发褐、调味均匀"
    },
    {
      "n": 3,
      "text": "葱花与红辣椒圈拌入蛋液，静置两分钟让香味融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "辣椒去籽只留皮，辣味温和不影响蛋香。",
      "visual_cue": "葱花辣椒均匀铺在蛋液表面"
    },
    {
      "n": 4,
      "text": "小炒锅倒足量植物油烧到六成热，油面开始冒出细密纹路。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "油要够多够热，蛋液下去才能立刻膨起气泡。",
      "visual_cue": "油面微波、插入筷子冒小泡"
    },
    {
      "n": 5,
      "text": "蛋液从锅中央一次倒入，边缘瞬间膨起后转中火煎一百秒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "倒入后不要马上搅动，等底层结壳定型。",
      "visual_cue": "边缘卷起金边、中央鼓起大泡"
    },
    {
      "n": 6,
      "text": "翻面再煎一分钟，两面金黄酥脆后盛出，配青柠角挤汁同吃。",
      "time_min": 2,
      "heat": "中火",
      "tip": "趁热吃最脆，凉了油会回渗变软。",
      "visual_cue": "两面焦黄、边缘酥脆易断"
    }
  ],
  "tips": [
    "泰式煎蛋要蓬松焦边，油量比中式炒蛋多一倍。",
    "打蛋用筷子而非打蛋器，避免过度充气导致塌陷。",
    "鱼露是唯一咸味来源，不要另加盐，否则过咸。"
  ],
  "common_mistakes": [
    "油温不够就倒蛋液，蛋液渗进锅底吸油，成品湿软油腻。",
    "用打蛋器高速打发，煎好上层厚而松散，一压就塌。",
    "翻面太早，蛋饼撕裂碎成蛋块，没有整片焦边。"
  ],
  "substitutions": [
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "10ml 对 10ml",
      "note": "生抽咸鲜近似，但少了发酵带来的复合香。"
    },
    {
      "original": "红辣椒",
      "substitute": "甜椒",
      "ratio": "10g 对 20g",
      "note": "甜椒完全不辣，适合孩子吃。"
    }
  ],
  "variations": [
    "蛋液里加入猪肉末与洋葱丁，做成泰式肉末煎蛋，更饱腹。",
    "拌入一小勺红咖喱酱同煎，做成咖喱风味的煎蛋。"
  ],
  "serving_suggestion": "整片滑入盘中，盖上白米饭，配黄瓜片与一碟辣酱。",
  "storage": "现煎现吃，冷藏一天后复热需用平底锅干煎恢复脆边。",
