  "equipment": [
    "烤箱",
    "烤盘",
    "保鲜袋",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡翅从关节处剁成两段，用厨房纸把表面的水分彻底吸干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面越干，腌料越容易挂住，烤出来皮也更脆。",
      "visual_cue": "鸡翅表面干爽，剁口整齐"
    },
    {
      "n": 2,
      "text": "香茅、南姜与大蒜切末，加鱼露、椰糖、黑胡椒与椰奶拌成腌料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "椰奶能让肉质更嫩，也让表皮烤出漂亮的焦色。",
      "visual_cue": "腌料浓稠挂勺，呈淡褐色"
    },
    {
      "n": 3,
      "text": "鸡翅放进保鲜袋，倒入腌料揉匀，冷藏静置半小时以上入味。",
      "time_min": 15,
      "heat": "无火",
      "tip": "隔着袋子揉更均匀，中途翻一次面更入味。",
      "visual_cue": "每只鸡翅都裹满腌料，袋内没有干块"
    },
    {
      "n": 4,
      "text": "烤箱预热到两百度，鸡翅平铺在烤盘上烤二十分钟至表面金黄。",
      "time_min": 20,
      "heat": "中火",
      "tip": "中途翻面并倒掉烤出的油水，成品才不会腻。",
      "visual_cue": "表皮金黄带焦边，用筷子能轻松扎透"
    },
    {
      "n": 5,
      "text": "出炉后在鸡翅表面薄薄刷一层植物油，让光泽更亮也更香。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷油要趁热，凉了油挂不住会积在盘底。",
      "visual_cue": "表面油亮反光，焦色均匀"
    },
    {
      "n": 6,
      "text": "撒上香菜末装盘，趁热撕开吃，外皮脆口里面还带汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，靠余温散香就足够，别早放。",
      "visual_cue": "表面点缀绿色香菜，香气扑鼻"
    }
  ],
  "tips": [
    "鸡翅提前一晚腌上，第二天烤更入味。",
    "烤盘垫一层锡纸，清洗省事也不粘底。",
    "最后两分钟转上火，表皮会更脆更香。",
    "没有香茅可以用柠檬叶代替，香气方向相近。"
  ],
  "common_mistakes": [
    "鸡翅带水下腌料，烤的时候出水，皮软不脆。",
    "一次全堆在烤盘里，受热不均一半焦一半生。",
    "腌料里的椰糖放太多，表皮很快发黑变苦。"
  ],
  "substitutions": [
    {
      "original": "鸡翅",
      "substitute": "鸡腿肉",
      "ratio": "500克:500克",
      "note": "切大块后同样腌制，烤的时间加五分钟。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "60毫升:60毫升",
      "note": "奶香更淡，可加少许油补足润感。"
    }
  ],
  "variations": [
    "改用炭火烤，皮更脆还带明显烟熏香。",
    "腌料里加一勺咖喱粉，做成咖喱风味的烤鸡翅。"
  ],
  "serving_suggestion": "刚出炉的鸡翅皮脆肉嫩，撕开还冒着热气，香茅的清香混着椰奶的甜，配一碟甜辣酱更开胃。",
  "storage": "冷藏可存两天，复热用烤箱两百度烤五分钟，微波会让表皮回软失去脆感。",
