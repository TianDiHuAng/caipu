  "equipment": [
    "烤箱",
    "烤架",
    "刷子",
    "研钵"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼撕掉外层薄膜，剖开清除内脏与软骨，冲洗干净后切成两半。",
      "time_min": 10,
      "heat": "无火",
      "tip": "外膜不撕烤完会韧得嚼不动，一定要去掉。",
      "visual_cue": "鱿鱼表面洁白无膜，触感有弹性"
    },
    {
      "n": 2,
      "text": "香茅拍扁切末，南姜与大蒜切末，与鱼露、椰糖、黑胡椒拌成腌料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香茅只取根部那段，叶子部分纤维太粗。",
      "visual_cue": "腌料呈浅褐色糊状，香气浓烈"
    },
    {
      "n": 3,
      "text": "把腌料均匀抹在鱿鱼上，用手抓匀后静置十分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "十分钟够入味，腌太久肉质会被盐分收紧。",
      "visual_cue": "鱿鱼表面挂满腌料，汁水微黏"
    },
    {
      "n": 4,
      "text": "烤箱预热到两百度，鱿鱼铺在烤架上烤十二分钟，中途翻一次面。",
      "time_min": 12,
      "heat": "中火",
      "tip": "用烤架比烤盘好，多余水分能滴下去不积在盘里。",
      "visual_cue": "表面出现焦斑，边缘微微卷起"
    },
    {
      "n": 5,
      "text": "青柠榨汁，加小米辣碎与少许鱼露、椰糖，拌成酸甜蘸汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蘸汁现拌现用，青柠放久了香气会走味。",
      "visual_cue": "蘸汁清亮，尝起来酸辣带甜"
    },
    {
      "n": 6,
      "text": "出炉趁热在鱿鱼表面刷一层植物油，撒香菜段，配蘸汁上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "刷油能让表面更亮，也能锁住里面的水分。",
      "visual_cue": "鱿鱼油亮带焦纹，切段后断面白嫩"
    }
  ],
  "tips": [
    "鱿鱼挑肉厚身挺的，烤完才不缩成一小团。",
    "喜欢焦香可以最后三分钟转成上下火同开。",
    "没有烤箱用平底锅大火煎，两面各三分钟。",
    "蘸汁里加一勺糯米粉烘香的水，风味更地道。"
  ],
  "common_mistakes": [
    "外膜没撕干净，烤好后咬着像橡皮一样韧。",
    "腌太久才烤，鱿鱼出水多，烤完干瘪发硬。",
    "烤的时间过头，肉一缩就咬不动也没汁。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "墨鱼",
      "ratio": "500克:500克",
      "note": "肉质更厚，烤的时间需多加两分钟。"
    },
    {
      "original": "南姜",
      "substitute": "姜",
      "ratio": "15克:12克",
      "note": "普通姜辛辣更直接，香气略薄。"
    }
  ],
  "variations": [
    "换成炭火直烤，边缘微焦带烟熏味更香。",
    "腌料里加一勺咖喱粉，做成黄咖喱风味烤鱿鱼。"
  ],
  "serving_suggestion": "切成条状摆盘，趁热挤上蘸汁吃，外层焦香微韧，里面还是嫩白的，配一杯冰镇饮料非常解馋。",
  "storage": "冷藏可存一天，复热用烤箱两百度烤三分钟，微波会让肉质发韧失去弹性。",
