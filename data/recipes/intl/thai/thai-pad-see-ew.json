  "equipment": [
    "铸铁锅或炒锅",
    "锅铲",
    "大漏勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "生抽、老抽、蚝油和白糖在小碗里搅匀，提前调好酱汁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "炒河粉全程火大动作快，酱汁必须事先调好。",
      "visual_cue": "酱汁均匀无糖粒、颜色深褐"
    },
    {
      "n": 2,
      "text": "锅烧到冒烟下植物油，五花肉片铺平煎到两面微焦出油。",
      "time_min": 5,
      "heat": "大火",
      "tip": "肉片先煎香再动，出的猪油能让后面河粉更香。",
      "visual_cue": "肉片金黄卷边、锅底有清亮油脂"
    },
    {
      "n": 3,
      "text": "下蒜末炒香，把肉推到一边，鸡蛋打入空白处快速划散。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蛋在半凝固时与肉混合，口感才嫩不干。",
      "visual_cue": "蛋液刚凝成软块、边缘微焦"
    },
    {
      "n": 4,
      "text": "下芥蓝梗先炒一分钟，再放叶片，翻炒到叶子刚塌软。",
      "time_min": 4,
      "heat": "大火",
      "tip": "梗叶分开下锅，一起下会梗硬叶烂。",
      "visual_cue": "菜梗颜色变深、叶片翠绿发亮"
    },
    {
      "n": 5,
      "text": "河粉用手撕散后下锅，沿锅边淋入酱汁，用铲子摊开再翻。",
      "time_min": 5,
      "heat": "大火",
      "tip": "河粉别用铲子反复切，摊开等十秒再翻才不断。",
      "visual_cue": "河粉均匀上色、没有白块"
    },
    {
      "n": 6,
      "text": "保持大火快速翻炒到河粉边缘微焦，撒黑胡椒即可出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅气来自这一步的高温短炒，不要延长以免河粉出水。",
      "visual_cue": "河粉油亮有焦边、盘底不积水"
    }
  ],
  "tips": [
    "河粉冷藏后会发硬，提前微波三十秒变软再下锅。",
    "想更香可用猪油代替植物油，火力也更容易拉高。",
    "芥蓝可换成豆芽或卷心菜，但蔬菜需沥干水再下锅。"
  ],
  "common_mistakes": [
    "河粉没撕散就下锅，结成一团怎么炒都夹生。",
    "火不够大，河粉吸油变软像糊条。",
    "酱汁直接倒中心，底层咸上层白，颜色不匀。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪肩肉",
      "ratio": "200g 对 200g",
      "note": "油脂少，需多补十毫升油防粘。"
    },
    {
      "original": "芥蓝",
      "substitute": "豆芽",
      "ratio": "150g 对 150g",
      "note": "口感更清爽，下锅时间减半。"
    }
  ],
  "variations": [
    "加入腌制牛肉片与少量米酒，做成泰式牛肉炒河粉。",
    "喜欢酸甜可挤半个青柠，增清香解腻。"
  ],
  "serving_suggestion": "热锅装盘，配鱼露浸辣椒、白糖与青柠角按口味调味。",
  "storage": "现炒现吃最佳，冷藏一夜再复热会偏硬，可用平底锅干煎回软。",
