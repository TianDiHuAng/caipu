  "equipment": [
    "料理机",
    "炒锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "龙利鱼切小块，用厨房纸吸干水分后放入料理机打成细腻鱼泥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼泥要打到起胶发黏，饼才不散。",
      "visual_cue": "鱼泥细腻、黏手起胶"
    },
    {
      "n": 2,
      "text": "鱼泥中加红咖喱酱、鱼露、白糖和蛋清，顺一个方向搅打上劲。",
      "time_min": 6,
      "heat": "无火",
      "tip": "始终朝一个方向搅，蛋白才能把鱼泥拉成胶状。",
      "visual_cue": "鱼泥黏稠、挑起不掉"
    },
    {
      "n": 3,
      "text": "拌入淀粉、四季豆片和泰国罗勒碎，冷藏二十分钟让味道融合。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏后更好塑形，下锅也不易散。",
      "visual_cue": "配料分布均匀、泥体紧实"
    },
    {
      "n": 4,
      "text": "手心抹少许油，把鱼泥搓成直径五厘米的圆饼，轻轻压扁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "饼厚一厘米最合适，太厚炸不透。",
      "visual_cue": "饼形圆整、厚度一致"
    },
    {
      "n": 5,
      "text": "锅中倒植物油烧到六成热，鱼饼逐个下锅炸三分钟至浮起金黄。",
      "time_min": 3,
      "heat": "中火",
      "tip": "下锅后先别翻动，等定型再翻面。",
      "visual_cue": "表面金黄、鱼饼浮起"
    },
    {
      "n": 6,
      "text": "捞出沥油，把油温升高再复炸二十秒，配着酸甜蘸酱趁热上桌。",
      "time_min": 2,
      "heat": "大火",
      "tip": "复炸逼出多余油分，外皮更脆。",
      "visual_cue": "外壳酥脆、按压回弹"
    }
  ],
  "tips": [
    "鱼泥全程保持低温，手温过高时可把碗坐在冰水里搅打。",
    "四季豆切薄斜片才容易炸熟，厚块会夹生。",
    "红咖喱酱本身有咸味，鱼露要边尝边加。"
  ],
  "common_mistakes": [
    "鱼泥没打上劲就下锅，饼一入油就散成渣。",
    "油温偏低，鱼饼吸油发软，毫无弹性。",
    "四季豆切太厚，外皮金黄而内部还是生的。"
  ],
  "substitutions": [
    {
      "original": "龙利鱼",
      "substitute": "鲈鱼",
      "ratio": "400g 对 400g",
      "note": "鲈鱼需去皮去刺，肉质更紧实。"
    },
    {
      "original": "红咖喱酱",
      "substitute": "咖喱粉加辣椒粉",
      "ratio": "25g 对 15g 加 5g",
      "note": "香气层次略薄，可补少许香茅末。"
    }
  ],
  "variations": [
    "加两片柠檬叶切细丝拌入鱼泥，柑橘香更突出。",
    "做成小球状油炸，蘸酸甜梅酱当派对小食。"
  ],
  "serving_suggestion": "配黄瓜片、花生碎和甜辣酱，趁热吃最有弹性。",
  "storage": "冷藏两天，冷冻一个月，复热用烤箱两百度八分钟。",
