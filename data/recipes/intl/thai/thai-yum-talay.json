  "steps": [
    {
      "n": 1,
      "text": "青柠挤汁，与鱼露、白糖和蒜末调成汁。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先尝一口，酸咸要打头。，看准状态再往下做。",
      "visual_cue": "汁色清亮，甜香微酸"
    },
    {
      "n": 2,
      "text": "汤锅水烧开，下虾煮到变红捞出。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "虾变红就捞，煮久就柴。，看准状态再往下做。",
      "visual_cue": "虾身卷曲，颜色橙红"
    },
    {
      "n": 3,
      "text": "同锅下鱿鱼圈烫四十秒立刻捞出。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "鱿鱼烫久就橡皮，四十秒够。，看准状态再往下做。",
      "visual_cue": "鱿鱼卷边，肉质白嫩"
    },
    {
      "n": 4,
      "text": "海鲜过冰水降温，沥干水分备用。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冰水定型，口感才脆。，看准状态再往下做。",
      "visual_cue": "表面冷凉，无多余水"
    },
    {
      "n": 5,
      "text": "洋葱丝用冰水泡五分钟去辛辣。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡水去辣，吃起来才不冲。，看准状态再往下做。",
      "visual_cue": "洋葱变脆，辣气减轻"
    },
    {
      "n": 6,
      "text": "大碗放海鲜、洋葱、番茄和香茅片。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻拌别压，海鲜才不碎。，看准状态再往下做。",
      "visual_cue": "碗中分层，颜色鲜亮"
    },
    {
      "n": 7,
      "text": "淋上调好的汁，轻拌让海鲜裹匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汁分两次加，避免过咸。，看准状态再往下做。",
      "visual_cue": "表面油亮，汁液挂身"
    },
    {
      "n": 8,
      "text": "撒小米椒圈、柠檬叶丝和香菜段。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "最后撒香草，香气才清爽。，看准状态再往下做。",
      "visual_cue": "绿红点缀，汁面微浑"
    }
  ],
  "tips": [
    "海鲜烫好过冰水，口感才脆。，这一点很关键。",
    "汁先调好再拌，味道才均匀。，这一点很关键。",
    "洋葱泡冰水，辛辣就没那么冲。，这一点很关键。"
  ],
  "common_mistakes": [
    "鱿鱼烫太久，咬起来像橡皮。，这一点很关键。",
    "汁一次倒太多，沙拉泡在水里。，这一点很关键。",
    "海鲜没沥干，味道全被稀释。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "青口",
      "ratio": "250 克:250 克",
      "note": "烫到开壳即可。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "3 个:3 个",
      "note": "酸度更柔和。"
    }
  ],
  "variations": [
    "加一把粉丝，吸汁更饱口。，这一点很关键。",
    "加烤花生碎，口感更脆。，这一点很关键。"
  ],
  "serving_suggestion": "当开胃菜上桌，配冰啤酒最好。，这一点很关键。",
  "storage": "现拌现吃，不宜隔夜。，这一点很关键。",
