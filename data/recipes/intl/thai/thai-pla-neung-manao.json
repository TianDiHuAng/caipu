  "steps": [
    {
      "n": 1,
      "text": "鲈鱼刮净鱼鳞，去掉内脏和血线，冲洗干净。，这一步的关键在于火候。",
      "time_min": 10,
      "heat": "无火",
      "tip": "血线一定要去净，这是腥味主要来源。",
      "visual_cue": "鱼身雪白，无血水渗出"
    },
    {
      "n": 2,
      "text": "鱼身两面各划三刀，深到鱼骨方便入味。，这一步的关键在于火候。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刀口斜着划，蒸好才会张开。，这一步的关键在于火候。",
      "visual_cue": "刀口整齐，鱼肉外翻"
    },
    {
      "n": 3,
      "text": "盘底铺香茅段，把鱼放上去，鱼肚里塞姜片。，这一步的关键在于火候。",
      "time_min": 5,
      "heat": "无火",
      "tip": "垫高让蒸汽能到鱼底，受热才均匀。，这一步的关键在于火候。",
      "visual_cue": "鱼身平稳，香气散出"
    },
    {
      "n": 4,
      "text": "水大开后上锅，大火蒸十二分钟关火焖两分钟。，这一步的关键在于火候。",
      "time_min": 15,
      "heat": "大火",
      "tip": "全程大火，中途千万别开盖放气。，这一步的关键在于火候。",
      "visual_cue": "鱼眼凸出，鱼肉离骨"
    },
    {
      "n": 5,
      "text": "取出倒掉盘中腥水，去掉香茅和姜片。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "无火",
      "tip": "这步不能省，腥水留着整道菜都毁。，这一步的关键在于火候。",
      "visual_cue": "盘底干爽，无积水，别小看这一步。"
    },
    {
      "n": 6,
      "text": "青柠挤汁，加大蒜、小米辣、鱼露和白糖调匀。，这一步的关键在于火候。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糖先化开，酸辣才平衡不冲。，这一步的关键在于火候。",
      "visual_cue": "汁液清亮，蒜末悬浮"
    },
    {
      "n": 7,
      "text": "把调好的酸辣汁均匀淋在鱼身上。，这一步的关键在于火候。",
      "time_min": 2,
      "heat": "无火",
      "tip": "沿着鱼身淋，别只浇中间。，这一步的关键在于火候。",
      "visual_cue": "汁液铺满，鱼肉泛光"
    },
    {
      "n": 8,
      "text": "撒香菜段，趁热端上桌蘸汁吃。，这一步的关键在于火候。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后放，香气才不被烫散。，这一步的关键在于火候。",
      "visual_cue": "香菜翠绿，鱼身完整"
    }
  ],
  "tips": [
    "蒸鱼的水必须大开再上锅，鱼肉才嫩。",
    "盘里的腥水一定倒掉，否则整道菜发腥。",
    "青柠汁现挤现用，放久了会发苦。，成败就在这一步。"
  ],
  "common_mistakes": [
    "冷水上锅慢慢加热，鱼肉变老发柴。",
    "蒸过头十几分钟，鱼肉一夹就碎。，这点要注意。",
    "提前挤好青柠汁，苦味压过鲜味。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "海鲈鱼",
      "ratio": "700 克:700 克",
      "note": "肉质更紧，蒸的时间加两分钟。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "3 个:2 个",
      "note": "酸度稍低，可以多挤半个。"
    }
  ],
  "variations": [
    "加一勺椰糖，酸甜更圆润。，别嫌麻烦，做完它。",
    "改用清蒸方式加粉丝垫底，吸汁更好吃。"
  ],
  "serving_suggestion": "连盘上桌，配糯米饭蘸汁吃最香。，这一步别省。",
  "storage": "现做现吃，冷藏不超过一天，复热后风味明显下降。",
