          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "木勺",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香蕉剥皮，切成三厘米长的斜段，切面朝上摆放。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用半熟的香蕉，煮完才不散不烂。，注意火候。",
      "visual_cue": "香蕉段完整，切面平整"
    },
    {
      "n": 2,
      "text": "汤锅倒清水烧开，轻轻放入香蕉段，小火煮五分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "水微沸就够，大滚会把香蕉冲散。，注意火候。",
      "visual_cue": "香蕉变软，汤水微浑"
    },
    {
      "n": 3,
      "text": "加白糖和盐，转小火再煮三分钟让香蕉吸进甜味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐只要一小撮，能把甜味衬得更厚。",
      "visual_cue": "糖水清甜，香蕉发亮"
    },
    {
      "n": 4,
      "text": "倒入椰奶，保持小火慢煮五分钟，不要煮到沸腾。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰奶一沸腾就出油分层，小火温热即可。",
      "visual_cue": "汤色乳白，质地顺滑"
    },
    {
      "n": 5,
      "text": "淀粉加两勺冷水化开，慢慢淋进锅里勾成薄芡。",
      "time_min": 4,
      "heat": "小火",
      "tip": "边淋边搅，薄薄一层芡就够挂住香蕉。",
      "visual_cue": "汤汁微稠，能挂勺，状态稳定"
    },
    {
      "n": 6,
      "text": "关火静置三分钟，让椰奶香气融合后盛入碗中。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置一会儿风味更融合，也不至于烫嘴。",
      "visual_cue": "表面平滑，香气浓，状态稳定"
    }
  ],
  "tips": [
    "用半熟香蕉，煮完才成型不散开。，值得留意。",
    "椰奶全程小火，煮沸就会出油分层。，值得留意。",
    "勾芡薄一点，汤汁挂勺就够。，值得留意。"
  ],
  "common_mistakes": [
    "用熟透的香蕉煮，最后化成一锅糊。，务必避免。",
    "椰奶大火滚煮，表面浮一层清油。，务必避免。",
    "芡勾得太厚，成品像浆糊一样黏。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "香蕉",
      "substitute": "芋头",
      "ratio": "500 克:500 克",
      "note": "切块先蒸十分钟再煮，口感更粉。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "80 克:80 克",
      "note": "颜色偏褐，焦糖香更浓。"
    }
  ],
  "variations": [
    "撒一点烤过的白芝麻，香气更丰富。，也很受欢迎。",
    "冷藏后加碎冰吃，做成夏日版本。，也很受欢迎。"
  ],
  "serving_suggestion": "温热时盛碗，也可以冷藏后当凉甜品吃。，效果更稳定。",
  "storage": "冷藏两天，复热小火加热至微温再食用。，效果更稳定。",
