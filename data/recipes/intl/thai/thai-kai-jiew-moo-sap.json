  "equipment": [
    "炒锅",
    "打蛋盆",
    "叉子",
    "漏勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肉末加一勺鱼露与白胡椒，用叉子拨散拌匀，静置十分钟稍微入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉末要拨散不成团，煎的时候才会均匀分布在蛋里。",
      "visual_cue": "肉末松散无结块，颜色略深"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进大盆，用叉子以画圈方式打散，打到蛋液完全均匀、略有细泡。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用叉子比筷子更容易打出细密气泡，煎出来才蓬松。",
      "visual_cue": "蛋液颜色一致，表面浮着小气泡"
    },
    {
      "n": 3,
      "text": "蛋液里加剩下的鱼露、生抽、白糖与蒜末，再拌入肉末与一半葱花，搅匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "调味料要先在蛋液里化开，直接在锅里加容易咸淡不均。",
      "visual_cue": "蛋液呈浅褐色，肉末均匀悬浮"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，中火烧到油面微微晃动、筷子插入冒细泡。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要够热蛋液才能瞬间鼓起，油太少就会摊成薄饼。",
      "visual_cue": "油面泛纹，筷子周围起小泡"
    },
    {
      "n": 5,
      "text": "把蛋液从锅中央高处一次倒入，让它在油里自然膨胀成厚饼。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "高处倒入能让蛋液带气落下，蓬松度明显更好。",
      "visual_cue": "蛋液迅速鼓起，边缘起大泡"
    },
    {
      "n": 6,
      "text": "保持中火煎三分钟，用铲子沿边缘掀起查看底部，金黄后翻面。",
      "time_min": 4,
      "heat": "中火",
      "tip": "边缘金黄就先别动中心，中心还在凝固时翻面最容易破。",
      "visual_cue": "边缘金黄酥脆，蛋饼能整体晃动"
    },
    {
      "n": 7,
      "text": "另一面煎两分钟到同样金黄，用铲子按压中间，无蛋液渗出即可出锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "按压判断熟度最直接，渗液说明中心还没熟。",
      "visual_cue": "两面金黄，按压无液体渗出"
    },
    {
      "n": 8,
      "text": "蛋饼放在漏网上沥油一分钟，切成四块装盘，撒剩下的葱花，配青柠角。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先用漏网沥一分钟油再切，切面才不会油汪汪一片。",
      "visual_cue": "表面干爽不滴油，切面有气孔"
    }
  ],
  "tips": [
    "油量足是泰式煎蛋蓬松的秘诀，剩下的油过滤后可以炒菜。",
    "肉末可以换成虾仁丁或纯素不加，光是蛋与蒜也很下饭。",
    "喜欢辣可以加两枚小米辣剁碎一起打蛋。",
    "配一勺甜辣酱和一碗热米饭，是最快的一顿泰式家常饭。"
  ],
  "common_mistakes": [
    "蛋液不打匀就下锅，蛋白蛋黄分成两层，煎出来一块白一块黄。",
    "油温不够就倒蛋液，蛋液慢慢浸在油里，成品又油又塌。",
    "全程大火猛煎，底面焦黑而中心还是流动的。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉丁",
      "ratio": "120克:120克",
      "note": "口感更有嚼头，需先炒到断生再拌入蛋液。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽加盐",
      "ratio": "22毫升:24毫升加1克盐",
      "note": "少了发酵鲜味，适合不习惯鱼露的人。"
    }
  ],
  "variations": [
    "加一把九层塔叶与蛋液同煎，香气立刻变成打抛风格。",
    "把肉末换成腌好的蟹肉，做成泰式蟹肉煎蛋，鲜味更足。"
  ],
  "serving_suggestion": "切块盖在热米饭上，配青柠角与甜辣酱，旁边放几片黄瓜解腻。",
  "storage": "现煎现吃最好，冷藏后蛋饼会出水变硬；复热用平底锅小火干煎两分钟。",
