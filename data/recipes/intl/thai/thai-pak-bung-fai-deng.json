  "steps": [
    {
      "n": 1,
      "text": "空心菜摘去老梗与黄叶，掐成六厘米长段，用清水冲洗两遍后沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泰式做法不切太碎，长段下锅才脆，也好夹。",
      "visual_cue": "菜段整齐，沥干不滴水"
    },
    {
      "n": 2,
      "text": "蒜拍碎、小米辣拍裂、红葱头切片，一起放进小碗备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "小米辣拍裂比切圈更出辣，香味也更冲。",
      "visual_cue": "辛香料备齐，辣味隐约刺鼻"
    },
    {
      "n": 3,
      "text": "把蚝油、鱼露、黄豆酱与白糖一起调进小碗，搅到糖化开备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调好酱汁，下锅时一气呵成，菜才不会炒老。",
      "visual_cue": "酱汁浓稠均匀，呈褐色"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒青烟，倒植物油，下蒜、小米辣与红葱头爆香十五秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅要极热，这就是泰式所谓火焰炒，锅气足菜才香。",
      "visual_cue": "辛香料边缘微焦，香气冲鼻"
    },
    {
      "n": 5,
      "text": "立刻倒入空心菜，大火翻炒四十秒，让菜均匀沾上油与香料。",
      "time_min": 2,
      "heat": "大火",
      "tip": "菜一下锅就翻，别停手，停一下就出水。",
      "visual_cue": "菜叶塌软，颜色转为深绿"
    },
    {
      "n": 6,
      "text": "沿锅边淋入调好的酱汁，继续大火翻炒三十秒到汁收。",
      "time_min": 2,
      "heat": "大火",
      "tip": "酱汁沿锅边淋，遇热立刻焦香，直接浇菜上会发腥。",
      "visual_cue": "酱汁裹住菜段，锅底见油不见水"
    },
    {
      "n": 7,
      "text": "尝一根菜梗的咸辣，按口味补少许鱼露，翻匀后关火。",
      "time_min": 1,
      "heat": "大火",
      "tip": "蚝油与黄豆酱都咸，补味要谨慎，宁淡不咸。",
      "visual_cue": "咸辣适中，香气浓郁"
    },
    {
      "n": 8,
      "text": "盛盘时把菜梗理齐在上，浇上锅里的汁，趁热端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "这道菜凉了辣味会变尖，一定要趁热吃。",
      "visual_cue": "菜色油亮，盘底酱汁少"
    }
  ],
  "tips": [
    "空心菜要买梗细叶小的，粗梗炒不脆。",
    "没有黄豆酱可用豆瓣酱替半勺，咸度更高需减鱼露。",
    "家里灶火不够旺，就把菜分两次炒，每次一小把。",
    "加几只虾仁同炒，鲜味更足，是常见的升级版。"
  ],
  "common_mistakes": [
    "锅不够热就下菜，出水变成煮菜，泰式风味全无。",
    "酱汁提前倒进锅再放菜，酱先糊锅，整盘带焦苦。",
    "小米辣切太碎，辣味全部渗进油里，辣得吃不下。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "芥蓝",
      "ratio": "500克:450克",
      "note": "芥蓝梗硬，需先焯水一分钟再炒。"
    },
    {
      "original": "蚝油",
      "substitute": "酱油",
      "ratio": "15毫升:15毫升",
      "note": "鲜味淡些，糖可加一克。"
    }
  ],
  "variations": [
    "加一勺虾酱与辣椒同炒，做成更浓的南部风味。",
    "把空心菜换成芥蓝，口感更脆，需先焯水一分钟。"
  ],
  "serving_suggestion": "三人份配菜，配泰式烤鸡、糯米饭或炒河粉。",
  "storage": "现炒现吃，冷藏后复热会失脆；剩余菜须冷藏并在一天内吃完。",
