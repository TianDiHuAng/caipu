  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "漏勺",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干米粉用温水泡二十分钟到软而有韧性，捞出沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡到能弯折不断就够，泡过头下锅就烂。",
      "visual_cue": "米粉柔软可绕指，无硬芯"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油小火炒香香茅、南姜与小米辣，炒到香气冲鼻。",
      "time_min": 5,
      "heat": "小火",
      "tip": "香料拍扁再炒，味道才出得来，别炒到发黑。",
      "visual_cue": "香料边缘微卷，油色带香"
    },
    {
      "n": 3,
      "text": "倒清水与柠檬叶烧开，转中火煮十分钟让香料味进汤。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煮够十分钟汤底才有层次，时间短只剩辣味。",
      "visual_cue": "汤色微黄，香气浓郁扑鼻"
    },
    {
      "n": 4,
      "text": "下蘑菇与小番茄煮三分钟，再放虾仁煮到变色卷曲。",
      "time_min": 5,
      "heat": "中火",
      "tip": "虾仁最后放，煮久会老，变色就够。",
      "visual_cue": "虾仁卷曲粉红，蘑菇变软浮起"
    },
    {
      "n": 5,
      "text": "加鱼露与椰糖调味，米粉下锅烫一分钟，关火挤青柠汁撒香菜。",
      "time_min": 4,
      "heat": "中火",
      "tip": "青柠汁一定关火后再挤，滚汤里挤会发苦。",
      "visual_cue": "米粉浸在红亮汤中，香气酸辣"
    }
  ],
  "tips": [
    "汤底香料别吃，吃的时候挑出来，口感太硬。",
    "青柠汁分两次挤，一半入汤一半上桌补，酸味更鲜活。",
    "喜欢重口可以加一勺辣椒酱，汤色更红。",
    "米粉与汤底分开煮，汤色才不会发浑变稠。"
  ],
  "common_mistakes": [
    "米粉泡过头，下锅一烫就断成一截一截。",
    "青柠汁倒进滚汤里，整锅发苦没法救。",
    "香料没拍扁就下锅，汤只有辣没有香。",
    "虾仁煮到发白发硬，嚼起来像橡皮。"
  ],
  "substitutions": [
    {
      "original": "米粉",
      "substitute": "粉丝",
      "ratio": "240克:200克",
      "note": "更吸汤，泡的时间减到十分钟。"
    },
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "240克:250克",
      "note": "切薄片，煮的时间加两分钟。"
    }
  ],
  "variations": [
    "加两勺椰奶，汤变浓白，是椰香酸辣汤米粉。",
    "加一颗水煮蛋对半切，饱腹感更强。",
    "换成河粉，汤头更挂味，是曼谷常见的版本。"
  ],
  "serving_suggestion": "大碗盛汤与米粉，虾仁摆面，配青柠角与辣椒粉，趁热吃最过瘾。",
  "storage": "冷藏可放一天，米粉与汤分开存放；复热汤须煮沸，米粉用热水烫开即可。",
