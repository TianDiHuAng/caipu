  "equipment": [
    "炒锅",
    "打蛋碗",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进碗里加盐，用筷子快速打散到蛋白蛋黄完全融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液要多打一会儿，打散了蛋白蛋黄才嫩，也不会有白块。",
      "visual_cue": "蛋液均匀，表面浮起细密泡沫。"
    },
    {
      "n": 2,
      "text": "炒锅大火烧热倒入植物油，转动锅让油均匀铺满整个锅底。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油一定要够热，蛋液下锅立刻鼓起大泡，边缘才焦脆。",
      "visual_cue": "油面微微冒烟，铺满整个锅底。"
    },
    {
      "n": 3,
      "text": "沿锅边倒入蛋液摊成大片，中火煎三分钟至底面金黄起泡。",
      "time_min": 4,
      "heat": "大火",
      "tip": "不要急着翻动，底面结壳起泡再整体翻，蛋饼才完整。",
      "visual_cue": "底面金黄起泡，边缘焦脆上翘。"
    },
    {
      "n": 4,
      "text": "整体翻面再煎一分钟，两面焦脆后盛出，切成三厘米见方的块。",
      "time_min": 3,
      "heat": "中火",
      "tip": "另一面只煎一分钟，两面都焦脆但里面还要嫩。",
      "visual_cue": "蛋饼两面焦黄，切块整齐。"
    },
    {
      "n": 5,
      "text": "小碗放鱼露、青柠汁、细砂糖和辣椒粉，搅匀成酸甜微辣的酱汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "鱼露和青柠比例按口味调，先酸后咸，糖只是提味。",
      "visual_cue": "酱汁清亮，尝起来酸咸平衡。"
    },
    {
      "n": 6,
      "text": "番茄块、洋葱丝和蛋块放大碗，淋酱汁轻拌，撒香菜段装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋块最后拌，翻动要轻，泡久了会散，装盘前再淋汁。",
      "visual_cue": "蛋块裹汁，配菜鲜亮不塌。"
    }
  ],
  "tips": [
    "蛋液要多打一会儿，蛋白蛋黄完全打散，煎出来才细嫩。",
    "油要烧到微微冒烟再下蛋液，边缘才会起泡焦脆。",
    "酱汁先尝再淋，酸咸平衡是这道沙拉的关键。"
  ],
  "common_mistakes": [
    "油温不够就倒蛋液，蛋饼薄软发白，没有焦边也没有香气。",
    "煎好的蛋块泡在酱汁里拌太久，吸汁变软塌成一团。",
    "鱼露一次倒多，整盘只剩咸味，青柠的清香全被压住。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "240克:250克",
      "note": "蛋香更浓，煎制时间加半分钟。"
    },
    {
      "original": "番茄",
      "substitute": "小黄瓜",
      "ratio": "150克:150克",
      "note": "口感更脆，酸甜味稍弱。"
    }
  ],
  "variations": [
    "蛋液里加一小把切碎的小葱再煎，香气更足，颜色也好看。",
    "加两根切段的香茅和几片薄荷叶同拌，泰式风味更清爽。"
  ],
  "serving_suggestion": "装盘后淋上剩下的酱汁，配糯米饭或白饭一起吃，酸辣开胃。",
  "storage": "现拌现吃，冷藏可放一天，蛋块会吸汁变软，回温后口感略差。",
