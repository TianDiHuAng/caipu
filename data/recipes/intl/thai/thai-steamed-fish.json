  "equipment": [
    "蒸锅",
    "深盘",
    "小碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼洗净擦干，两面各划三刀，鱼身内外抹盐，腹中塞一半香菜。",
      "time_min": 8,
      "heat": "无火",
      "tip": "划刀让蒸汽进到厚肉处。",
      "visual_cue": "鱼身干爽、刀口整齐"
    },
    {
      "n": 2,
      "text": "蒸锅水烧到大滚，鱼放深盘入锅，大火蒸十分钟至鱼眼发白凸出。",
      "time_min": 4,
      "heat": "大火",
      "tip": "水滚再上锅，鱼肉才嫩。",
      "visual_cue": "鱼眼凸出、鱼身微裂"
    },
    {
      "n": 3,
      "text": "小碗调青柠汁、鱼露、白糖、蒜末、辣椒酱与清水，搅到糖完全化开。",
      "time_min": 12,
      "heat": "无火",
      "tip": "糖先化开，酸辣才均匀。",
      "visual_cue": "酱汁清亮、蒜末悬浮"
    },
    {
      "n": 4,
      "text": "倒掉盘里的腥水，淋上酱汁再蒸一分钟，出锅撒剩余香菜。",
      "time_min": 3,
      "heat": "大火",
      "tip": "腥水必须倒掉再淋汁。",
      "visual_cue": "汤汁清亮、香气酸辣"
    }
  ],
  "tips": [
    "蒸鱼前一定要把盘里的腥水倒掉，否则整道菜带土腥味。",
    "水滚后再上锅，鱼肉受热快、口感才嫩。",
    "青柠汁关火前才淋，久蒸会发苦变闷。"
  ],
  "common_mistakes": [
    "冷水上锅慢慢蒸，鱼肉发散还带腥。",
    "蒸制时间过头，鱼肉用筷子一夹就散成渣。",
    "青柠汁提前拌进酱汁久蒸，酸味变闷。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "鲷鱼",
      "ratio": "700g 对 700g",
      "note": "肉质更紧，蒸制时间加 1 分钟。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "60g 对 60g",
      "note": "酸度略低，可加 10g。"
    }
  ],
  "variations": [
    "椰浆版：酱汁里加 50ml 椰浆，口感更浓。",
    "清蒸版：不加辣椒酱，只用鱼露与青柠。"
  ],
  "serving_suggestion": "连汁一起上桌，配白米饭，把酸辣汤汁浇在饭上。",
  "storage": "冷藏可存 1 天，复热须重新蒸 5 分钟并补少量青柠汁。",
