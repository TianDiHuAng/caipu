  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿冲洗干净用厨房纸吸干，皮面用叉子在表面扎些小孔。",
      "time_min": 8,
      "heat": "无火",
      "tip": "扎孔让腌料渗进皮下，烤出来更入味。",
      "visual_cue": "鸡皮干爽，孔洞均匀"
    },
    {
      "n": 2,
      "text": "香茅拍扁后切成段，蒜切末，和鱼露、白糖、黑胡椒混成腌料。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香茅拍过再切，香气才散得出来。，注意火候。",
      "visual_cue": "腌料成糊，香气冲鼻"
    },
    {
      "n": 3,
      "text": "把鸡腿放进腌料里抓匀，冷藏腌制两小时以上入味。",
      "time_min": 25,
      "heat": "无火",
      "tip": "时间够腌料才能渗进厚肉里，隔夜更好。",
      "visual_cue": "鸡肉裹满腌料，色深"
    },
    {
      "n": 4,
      "text": "烤箱预热到二百度，鸡腿皮面朝上放在烤架上送入中层。",
      "time_min": 5,
      "heat": "-",
      "tip": "用烤架架空，烤出的油滴下去皮才脆。",
      "visual_cue": "烤箱升温，鸡皮朝上"
    },
    {
      "n": 5,
      "text": "烤十五分钟后取出，用刷子在表面刷一层椰奶再送回烤箱。",
      "time_min": 5,
      "heat": "-",
      "tip": "刷椰奶让表皮上色发亮，也不容易烤干。",
      "visual_cue": "表皮油亮，颜色转金"
    },
    {
      "n": 6,
      "text": "继续烤十二分钟，等表皮深金黄、肉汁清亮就出炉。",
      "time_min": 12,
      "heat": "-",
      "tip": "最厚处插入竹签，流出的汁清澈就熟透。",
      "visual_cue": "表皮焦香，肉汁清亮"
    },
    {
      "n": 7,
      "text": "出炉静置五分钟再斩块，撒上香菜碎配蘸汁上桌。",
      "time_min": 8,
      "heat": "无火",
      "tip": "静置五分钟肉汁才回稳，切的时候不流一桌。",
      "visual_cue": "肉块整齐，切面多汁"
    }
  ],
  "tips": [
    "鸡腿扎孔再腌，味道才渗得进厚肉。，值得留意。",
    "用烤架架空烤，鸡皮才会脆不软。，值得留意。",
    "中途刷一层椰奶，表皮上色更漂亮。，值得留意。"
  ],
  "common_mistakes": [
    "腌十分钟就烤，鸡肉里面完全没味。，务必避免。",
    "直接放烤盘烤，泡在油里皮永远不脆。",
    "烤好立刻切，肉汁全流到盘底。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡翅",
      "ratio": "750 克:750 克",
      "note": "烤制时间减八分钟，更易熟。"
    },
    {
      "original": "椰奶",
      "substitute": "淡奶油",
      "ratio": "80 毫升:80 毫升",
      "note": "上色略深，奶香更重。"
    }
  ],
  "variations": [
    "腌料里加一勺辣椒粉，辣味更明显。，也很受欢迎。",
    "配一碟酸甜蘸汁，油腻感全消。，也很受欢迎。"
  ],
  "serving_suggestion": "斩块配糯米饭和青木瓜沙拉，是最经典的泰式组合。",
  "storage": "冷藏两天，复热用烤箱二百度烤八分钟恢复脆皮。",
