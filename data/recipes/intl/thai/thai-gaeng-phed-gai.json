  "equipment": [
    "炒锅",
    "木铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成三厘米见方的块，用厨房纸吸干表面水分备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "表面水分吸干，下锅才不会出水，能直接煎出焦边。",
      "visual_cue": "肉块表面干爽，块形大小一致。"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，中小火下蒜末和咖喱粉，慢慢炒出红油和香气。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "咖喱粉怕高温，火大了立刻发苦，宁可小火多炒一分钟。",
      "visual_cue": "油色转橘红，锅里有明显香料香。"
    },
    {
      "n": 3,
      "text": "倒入一半椰奶，边倒边搅成顺滑的酱汁，煮到表面浮出油花。",
      "time_min": 3,
      "heat": "中火",
      "tip": "椰奶分次倒，一次倒完容易把咖喱粉冲成疙瘩。",
      "visual_cue": "酱汁橘红浓稠，表面泛出细小油点。"
    },
    {
      "n": 4,
      "text": "下肉块翻炒到每块都裹上酱，倒入剩下的椰奶煮开后转小火。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉块下锅先煎到边缘发白再翻，裹酱更均匀。",
      "visual_cue": "肉块表面变白，酱汁均匀包裹。"
    },
    {
      "n": 5,
      "text": "盖上锅盖小火炖十分钟，中途翻一次，让鸡肉吸足咖喱味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "小火慢炖椰奶才不会分离，锅边只冒小泡就对了。",
      "visual_cue": "酱汁轻滚冒小泡，肉块略微收缩。"
    },
    {
      "n": 6,
      "text": "加鱼露、细砂糖和辣椒粉调味，翻匀后关火撒香菜装盘。",
      "time_min": 2,
      "heat": "小火",
      "tip": "调味后再煮一分钟让味道融合，关火前尝一口咸淡。",
      "visual_cue": "酱汁红亮挂勺，香菜翠绿点缀。"
    }
  ],
  "tips": [
    "先用厚的那层椰奶炒酱，油分析出后香气才彻底炸开。",
    "鸡腿肉比胸部肉耐煮，炖十分钟依然嫩，别换成鸡胸。",
    "糖不是为了甜，是为了把辣和咸拉圆，一勺就够。"
  ],
  "common_mistakes": [
    "咖喱粉直接倒进汤里煮，粉粒结块挂在鸡肉上，入口发涩。",
    "全程大火收汁，椰奶被煮到油水分离，表面浮一层粗油。",
    "鸡腿肉冷水下锅慢煮，肉质紧缩发柴，咀嚼像嚼棉絮。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "淡椰浆加牛奶",
      "ratio": "400毫升:300毫升加100毫升",
      "note": "奶香更淡，需要补一点糖。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡腿肉去皮",
      "ratio": "500克:500克",
      "note": "油脂少，炒酱的油要多加十毫升。"
    }
  ],
  "variations": [
    "加半个菠萝切块同炖，果酸让咖喱更清爽，是南部海边的吃法。",
    "把一半椰奶换成椰水，汤汁更稀薄，适合配大量米饭浇着吃。"
  ],
  "serving_suggestion": "盛在深盘里，淋一勺椰奶在表面拉出纹路，撒香菜，配泰国香米饭一起吃。",
  "storage": "冷藏可放两天，第二天咖喱更入味，回锅时加两勺水小火加热，别用大火收干。",
