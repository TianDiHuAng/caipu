  "steps": [
    {
      "n": 1,
      "text": "香茅拍扁切成五厘米长的段，南姜切薄片，柠檬叶撕掉中间的梗。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香茅拍扁才出香，不拍等于白放。",
      "visual_cue": "香料裂口渗出汁水，香气清锐"
    },
    {
      "n": 2,
      "text": "汤锅倒清水，下香茅、南姜和柠檬叶，大火煮开转小火煮八分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "香料先煮出味，汤底才清亮有层次。",
      "visual_cue": "汤水微黄，香气飘满厨房"
    },
    {
      "n": 3,
      "text": "草菇对半切开，用清水快速冲一遍后沥干水分备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "草菇冲洗即可，久泡会吸水变淡。",
      "visual_cue": "草菇切面平整，无泥沙"
    },
    {
      "n": 4,
      "text": "虾仁挑去背上的肠线，用厨房纸吸干表面水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "吸干水分，下锅才不会把汤弄浑。",
      "visual_cue": "虾仁干爽，尾部完整"
    },
    {
      "n": 5,
      "text": "把草菇下进汤锅，小火煮四分钟至菌盖变软出水。",
      "time_min": 5,
      "heat": "小火",
      "tip": "草菇煮到出水，汤里才有菌菇的鲜味。",
      "visual_cue": "草菇软塌，汤色略深"
    },
    {
      "n": 6,
      "text": "倒入椰浆搅匀，小火加热到锅边冒小泡，不要烧开。",
      "time_min": 4,
      "heat": "小火",
      "tip": "椰浆一滚就分层出油，只加热到冒泡就好。",
      "visual_cue": "汤色奶白，表面无油花"
    },
    {
      "n": 7,
      "text": "下虾仁煮两分钟至蜷曲变红，加鱼露、棕榈糖和盐调味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾仁变红就关火，多煮一分钟就发硬。",
      "visual_cue": "虾仁蜷成弯钩，颜色橙红"
    },
    {
      "n": 8,
      "text": "关火挤入青柠汁，撒朝天椒和香菜碎，趁热盛碗。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁关火再挤，酸味才清不被煮苦。",
      "visual_cue": "汤面浮着辣椒圈与翠绿香菜"
    }
  ],
  "tips": [
    "香茅下锅前先用力拍扁，香气才出得来。",
    "椰浆只加热到冒泡，滚开会分层出油。",
    "虾仁变红蜷曲就关火，久煮发硬。",
    "青柠汁关火再挤，酸味清亮不苦。"
  ],
  "common_mistakes": [
    "香茅整根下锅，煮完汤里几乎没有香气。",
    "椰浆大火滚煮，汤面浮一层油还结块。",
    "虾仁在汤里煮足五分钟，口感硬得像橡皮。",
    "青柠汁早放，酸味被煮得发苦发闷。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "300克:300克",
      "note": "切片煮三分钟，做成椰奶鸡汤。"
    },
    {
      "original": "草菇",
      "substitute": "口蘑",
      "ratio": "150克:150克",
      "note": "口感更软，鲜味略淡。"
    }
  ],
  "variations": [
    "加几片嫩豆腐同煮，汤更有饱足感。",
    "多放两只朝天椒，辣味压过椰奶的甜。",
    "加一小把米粉同煮，直接当主食吃。"
  ],
  "serving_suggestion": "盛进深碗，撒一把香菜配香米饭，先喝汤再拌饭，酸辣奶香一起上来。",
  "storage": "冷藏可放两天，复热小火加热不要滚沸，青柠汁喝前再补。",
