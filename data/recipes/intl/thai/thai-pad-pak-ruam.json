  "steps": [
    {
      "n": 1,
      "text": "西兰花掰成小朵，用淡盐水泡十分钟再冲净沥干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "盐水泡能把缝隙里的脏东西泡出来。",
      "visual_cue": "花朵紧实，水清无沙"
    },
    {
      "n": 2,
      "text": "胡萝卜削皮斜切三毫米薄片，四季豆撕筋掰成五厘米段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "胡萝卜切薄一点，和西兰花才同时熟。",
      "visual_cue": "片薄均匀，豆段整齐"
    },
    {
      "n": 3,
      "text": "草菇对半切开，大蒜拍碎，红葱头切片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "草菇切开后别再泡水，吸水会变淡。",
      "visual_cue": "草菇切面白净，配料备齐"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，下蒜碎和红葱头小火炒一分钟出香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜别炒黄，微香就下蔬菜才不苦。",
      "visual_cue": "蒜香散出，油面微亮"
    },
    {
      "n": 5,
      "text": "转大火下胡萝卜片先炒两分钟，胡萝卜最难熟要先下。",
      "time_min": 3,
      "heat": "大火",
      "tip": "胡萝卜先下两分钟，最后才不生不硬。",
      "visual_cue": "胡萝卜片边缘变透亮"
    },
    {
      "n": 6,
      "text": "下西兰花和四季豆翻炒三分钟，沿锅边淋清水盖上焖两分钟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "淋一点水再焖，蔬菜熟得透还保持绿。",
      "visual_cue": "菜色翠绿，锅内蒸汽腾起"
    },
    {
      "n": 7,
      "text": "下草菇炒一分钟，加鱼露、酱油、棕榈糖和盐快炒均匀。",
      "time_min": 3,
      "heat": "大火",
      "tip": "调料沿锅边淋，遇热才激出香气。",
      "visual_cue": "酱色均匀，汤汁略收"
    },
    {
      "n": 8,
      "text": "尝一下咸淡，蔬菜断生即可出锅，盘底不留汁水。",
      "time_min": 2,
      "heat": "大火",
      "tip": "断生就出锅，久炒颜色发黄口感发软。",
      "visual_cue": "菜色鲜亮，盘底干爽"
    }
  ],
  "tips": [
    "西兰花用淡盐水泡，缝隙才洗得干净。",
    "胡萝卜先下锅，它比别的菜更难熟。",
    "淋一点清水盖盖焖，菜熟得透还保绿。",
    "断生就出锅，久炒颜色发黄口感发软。"
  ],
  "common_mistakes": [
    "所有菜一起下锅，硬的还生软的已烂。",
    "全程小火慢炒，蔬菜出水变成煮菜。",
    "酱油一次倒太多，成品发黑发咸。",
    "焖的时间过长，西兰花散成黄渣。"
  ],
  "substitutions": [
    {
      "original": "西兰花",
      "substitute": "花椰菜",
      "ratio": "250克:250克",
      "note": "颜色更白，口感更绵。"
    },
    {
      "original": "草菇",
      "substitute": "香菇",
      "ratio": "120克:120克",
      "note": "香气更浓，炒的时间加一分钟。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同炒，直接当主食。",
    "淋一勺椰浆，做成奶香版本更柔和。",
    "加几只虾仁同炒，鲜味更足也更像一道主菜。"
  ],
  "serving_suggestion": "盛盘配香米饭，作咖喱或烤鸡的配菜，颜色鲜亮摆上桌就很讨喜。",
  "storage": "冷藏可放两天，复热用炒锅大火一分钟，不要加水回锅。",
