  "equipment": [
    "汤锅",
    "炒锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "粉丝放进温水里泡十分钟，泡到能用指甲掐断，捞出剪成两段。",
      "time_min": 2,
      "heat": "无火",
      "tip": "水温大约四十度最合适，太烫会把外层泡烂。",
      "visual_cue": "粉丝变软发白，能轻松掐断。"
    },
    {
      "n": 2,
      "text": "白菜切成三厘米宽的条，香菇去蒂切薄片，蒜拍碎后切成细末。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香菇片切得越薄越容易出味，别超过三毫米。",
      "visual_cue": "配料分堆摆好，香菇片薄而均匀。"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，中小火下蒜末炒到微黄，闻到明显蒜香就停。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "蒜末一下锅就要翻动，变褐就带苦，宁可少炒半分钟。",
      "visual_cue": "蒜末边缘转金黄，油面泛细泡。"
    },
    {
      "n": 4,
      "text": "倒入高汤转大火烧开，下白菜条和香菇片，煮四分钟到白菜变软。",
      "time_min": 5,
      "heat": "大火",
      "tip": "先下白菜梗，一分钟后放菜叶，熟度才一起到位。",
      "visual_cue": "白菜梗由白转半透明，汤面轻滚。"
    },
    {
      "n": 5,
      "text": "放入泡好的粉丝煮两分钟，加鱼露和白胡椒粉调味后关火。",
      "time_min": 2,
      "heat": "中火",
      "tip": "粉丝下锅别久煮，吸足汤汁就起锅，泡久了会涨成一团。",
      "visual_cue": "粉丝透明柔软，能用筷子整缕夹起。"
    },
    {
      "n": 6,
      "text": "盛入碗中撒香菜碎，按口味再补几滴鱼露提鲜。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香菜连梗切，梗里的香气比叶子更足。",
      "visual_cue": "汤色清亮见底，香菜翠绿浮面。"
    }
  ],
  "tips": [
    "粉丝用温水泡软就够，泡到完全透明下锅一煮就烂成糊。",
    "鱼露分两次放，一半炒香料时提底味，一半出锅前补鲜。",
    "这碗汤讲究清亮，全程别用大火猛滚，汤才不浑。"
  ],
  "common_mistakes": [
    "粉丝用开水泡发，外层泡烂内芯还硬，一煮就断成碎渣。",
    "白菜久煮到完全透明，甜味全跑到汤里，菜本身寡淡无味。",
    "鱼露一次性倒足，汤咸得发苦，只能靠兑水救回来。"
  ],
  "substitutions": [
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "18毫升:15毫升",
      "note": "少了发酵的鲜，咸度更直接。"
    },
    {
      "original": "白菜",
      "substitute": "娃娃菜",
      "ratio": "200克:220克",
      "note": "更嫩，煮的时间减一分钟。"
    }
  ],
  "variations": [
    "加一把绞碎的肉捏成小丸子同煮，汤头更厚，就是曼谷街边常见的肉丸粉丝汤。",
    "素食版把高汤换成香菇水，鱼露换成淡酱油，清爽得可以当开胃汤。"
  ],
  "serving_suggestion": "盛进白瓷碗，撒香菜碎和白胡椒粉，配一小碟辣椒鱼露蘸水，配米饭或单喝都合适。",
  "storage": "粉丝泡汤久了会吸干水分，建议一顿吃完，剩下的只留汤底冷藏，第二天重新下粉丝。",
