  "steps": [
    {
      "n": 1,
      "text": "豆腐切成三厘米见方的块，用厨房纸吸干表面水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面水分吸干，煎的时候才不炸油。",
      "visual_cue": "豆腐块干爽，边缘整齐"
    },
    {
      "n": 2,
      "text": "小米椒切成小圈，蒜切成末，罗勒摘下叶片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "辣椒圈别切太碎，炒出来更好看也更香。",
      "visual_cue": "椒圈均匀，蒜末细碎"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，豆腐块下锅中火煎到金黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "豆腐下锅后别急着翻，等底面定形再动。",
      "visual_cue": "四面金黄，表皮起壳"
    },
    {
      "n": 4,
      "text": "把豆腐推到锅边，下蒜末和小米椒小火炒出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒蒜末用小火炒，大火容易焦黑发苦。",
      "visual_cue": "蒜末微黄，辣椒香气冲鼻"
    },
    {
      "n": 5,
      "text": "加鱼露、酱油、白糖和清水烧开，与豆腐翻拌裹汁。",
      "time_min": 3,
      "heat": "大火",
      "tip": "汁要收到挂得住豆腐，别留一锅汤水。",
      "visual_cue": "豆腐裹满酱汁，红亮油润"
    },
    {
      "n": 6,
      "text": "关火放入罗勒叶，用余温拌到叶片变软即可。",
      "time_min": 1,
      "heat": "无火",
      "tip": "罗勒关火后拌，香气清新鲜活不闷。",
      "visual_cue": "罗勒深绿，香气扑鼻"
    }
  ],
  "tips": [
    "豆腐吸干水再煎，表皮才起壳不粘锅。",
    "辣椒和蒜末用小火炒，香气够又不发苦。",
    "罗勒最后放，靠余温拌软香气最好。"
  ],
  "common_mistakes": [
    "豆腐湿着下锅，油花四溅还粘一锅底。",
    "大火炒辣椒蒜末，几秒黑糊整锅带苦。",
    "汁收得太干，豆腐发干没了酱香。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "白蘑菇",
      "ratio": "450 克:400 克",
      "note": "撕成块，煎制时间缩短两分钟。"
    },
    {
      "original": "罗勒",
      "substitute": "香菜",
      "ratio": "10 克:10 克",
      "note": "清香略不同，最后撒上即可。"
    }
  ],
  "variations": [
    "加半个洋葱切片同炒，甜味更足。",
    "放一勺辣椒酱同炒，酱香更浓更下饭。"
  ],
  "serving_suggestion": "配白饭最合适，辣汁浇饭能吃两碗。",
  "storage": "冷藏一天，复热小火加少许水焖透。",
