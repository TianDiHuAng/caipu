  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "打蛋器",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁挑去背上的肠线，用厨房纸吸干水分，加一点鱼露抓匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "虾仁吸干水再下锅，才不会出汤变老。",
      "visual_cue": "虾仁干爽，尾部完整"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进碗里加白胡椒粉打匀，打至蛋液表面起细泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液打得起泡，炒出来才松软。",
      "visual_cue": "蛋液均匀，浮一层细泡"
    },
    {
      "n": 3,
      "text": "洋葱切细丝，番茄切小块，小葱切四厘米段备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱切细丝，炒软后才不抢口感。",
      "visual_cue": "洋葱丝细匀，番茄块完整"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒一半植物油，下虾仁中火煎四十秒至变色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾仁只煎到变色就盛出，最后再回锅。",
      "visual_cue": "虾仁两面橙红，微微蜷曲"
    },
    {
      "n": 5,
      "text": "盛出虾仁，补剩下的油，下洋葱丝炒一分半至软塌透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒出甜味，蛋的味道才不单薄。",
      "visual_cue": "洋葱透明软塌，锅底泛油"
    },
    {
      "n": 6,
      "text": "下番茄块炒两分钟至出汁，加酱油和棕榈糖炒匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄出汁，蛋液才会裹上一层酸甜。",
      "visual_cue": "番茄软塌出汁，色红亮"
    },
    {
      "n": 7,
      "text": "倒入蛋液，等二十秒底部定型再轻推成大块蛋花。",
      "time_min": 3,
      "heat": "中火",
      "tip": "别急着搅，等定型再推才有大块蛋花。",
      "visual_cue": "蛋块蓬松，边缘微黄"
    },
    {
      "n": 8,
      "text": "虾仁回锅，加鱼露翻匀，撒小葱段与香菜即可出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "虾仁最后回锅，才不会炒两遍变硬。",
      "visual_cue": "蛋花裹着虾仁，葱花翠绿"
    }
  ],
  "tips": [
    "虾仁吸干水再下锅，才不会出汤。",
    "蛋液打得起泡，炒出来才松软蓬松。",
    "番茄炒出汁再倒蛋液，酸甜才裹得住。",
    "虾仁最后回锅，避免炒两遍变硬。"
  ],
  "common_mistakes": [
    "虾仁带水直接下锅，出水后越炒越硬。",
    "蛋液下锅猛搅，炒成碎渣状蛋花。",
    "只放盐不放鱼露，鲜味明显不足。",
    "虾仁和蛋液一起久炒，虾肉发老蛋块发干。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "250克:250克",
      "note": "切丁先炒熟，做法相同。"
    },
    {
      "original": "番茄",
      "substitute": "彩椒",
      "ratio": "100克:100克",
      "note": "口感更脆，酸味减弱。"
    }
  ],
  "variations": [
    "加一勺辣椒酱同炒，做成微辣版。",
    "淋一点椰浆，蛋花更滑顺还带奶香。",
    "盖在热米饭上，配一片青柠就是盖饭。"
  ],
  "serving_suggestion": "盛盘趁热配香米饭，蛋花松软、虾仁弹嫩，盘边的番茄汁别浪费。",
  "storage": "冷藏不超过一天，复热用炒锅小火三十秒，微波会让虾仁发硬。",
