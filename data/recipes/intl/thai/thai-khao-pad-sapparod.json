  "steps": [
    {
      "n": 1,
      "text": "米饭用手抓散，结块的地方全部捏开。，这一步的关键在于火候。",
      "time_min": 6,
      "heat": "无火",
      "tip": "米粒分开，炒出来才颗颗分明。，这一步的关键在于火候。",
      "visual_cue": "饭粒松散，无结块，成败就在这一步。"
    },
    {
      "n": 2,
      "text": "菠萝切小丁，用淡盐水泡五分钟沥干。，这一步的关键在于火候。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐水泡过不扎嘴，甜味也更明显。，这一步的关键在于火候。",
      "visual_cue": "果丁饱满，水分析出"
    },
    {
      "n": 3,
      "text": "大虾去虾线，用厨房纸吸干表面水分。，这一步的关键在于火候。",
      "time_min": 5,
      "heat": "无火",
      "tip": "吸干水，下锅才不溅油。，这一步的关键在于火候。",
      "visual_cue": "大虾干爽，虾身弯曲"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，倒蛋液炒成蛋块盛出。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要够热，蛋才蓬松不吸油。，这一步的关键在于火候。",
      "visual_cue": "蛋块金黄，质地松软"
    },
    {
      "n": 5,
      "text": "下大虾炒到变色，加咖喱粉炒出香味。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "中火",
      "tip": "咖喱粉遇油才出香，别干炒。，这一步的关键在于火候。",
      "visual_cue": "大虾橙红，粉末裹匀"
    },
    {
      "n": 6,
      "text": "倒米饭大火翻炒，把饭粒炒散炒热。，这一步的关键在于火候。",
      "time_min": 5,
      "heat": "大火",
      "tip": "大火快炒，饭才香不湿。，这一步的关键在于火候。",
      "visual_cue": "饭粒跳动，粒粒裹油"
    },
    {
      "n": 7,
      "text": "加鱼露和青豆、菠萝丁，翻炒两分钟。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "大火",
      "tip": "菠萝最后放，炒久会出水。，这一步的关键在于火候。",
      "visual_cue": "果丁微热，饭色金黄"
    },
    {
      "n": 8,
      "text": "倒回蛋块，撒腰果和葱末，翻匀装盘。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "大火",
      "tip": "腰果最后放，保持脆感。，这一步的关键在于火候。",
      "visual_cue": "腰果完整，葱末点缀"
    }
  ],
  "tips": [
    "用冷透的米饭，水分少才炒得散。，这点要注意。",
    "菠萝最后下锅，久炒会出水变酸。，这是关键点。",
    "腰果关火前放，脆感才留得住。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "用刚出锅的热米饭，一炒就成糊。，这一步别省。",
    "咖喱粉早放久炒，香味跑光发苦。，别跳过这步。",
    "菠萝炒太久，整锅饭变得湿软。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡胸肉",
      "ratio": "150 克:150 克",
      "note": "切丁同炒，口感更清淡。"
    },
    {
      "original": "腰果",
      "substitute": "花生米",
      "ratio": "50 克:50 克",
      "note": "提前烤香，香气更接地气。"
    }
  ],
  "variations": [
    "加一勺虾酱，风味更浓。，很多人在这里出错。",
    "用菠萝壳当容器上桌，卖相更好。，这里最容易翻车。"
  ],
  "serving_suggestion": "装盘后撒少许肉松，趁热吃。，别小看这一步。",
  "storage": "冷藏一天，复热用炒锅快炒，别用微波炉。",
