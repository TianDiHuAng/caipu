    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成两厘米见方的小块，用厨房纸吸干水。",
      "time_min": 7,
      "heat": "无火",
      "tip": "表面水分吸干，煎的时候才不粘锅。，这一步的关键在于火候。",
      "visual_cue": "豆腐块干爽，边角完整"
    },
    {
      "n": 2,
      "text": "香菇洗净去根，切成半厘米厚的片备用。，这一步的关键在于火候。",
      "time_min": 5,
      "heat": "无火",
      "tip": "厚片咬着有肉感，太薄容易炒干。，这一步的关键在于火候。",
      "visual_cue": "菇片均匀，菌褶完整"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到微冒烟，码入豆腐块。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "中火",
      "tip": "豆腐一块块摆，别叠在一起。，这一步的关键在于火候。",
      "visual_cue": "底面结皮，边缘金黄"
    },
    {
      "n": 4,
      "text": "中火煎到两面金黄，盛出备用。，这一步的关键在于火候。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎定型再翻，急着翻会碎。，这一步的关键在于火候。",
      "visual_cue": "两面金黄，外壳结实"
    },
    {
      "n": 5,
      "text": "锅里留底油，下蒜末和小米辣炒香。，这一步的关键在于火候。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蒜末变浅黄就下料，别炒焦。，这一步的关键在于火候。",
      "visual_cue": "蒜香四溢，辣味冲出"
    },
    {
      "n": 6,
      "text": "放香菇片大火翻炒到出水变软。，这一步的关键在于火候。",
      "time_min": 4,
      "heat": "大火",
      "tip": "香菇先炒出香，再回豆腐。，这一步的关键在于火候。",
      "visual_cue": "菇片收缩，汤汁渗出"
    },
    {
      "n": 7,
      "text": "倒回豆腐，加生抽、素蚝油和白糖，淋清水。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "大火",
      "tip": "清水让味道渗进豆腐里。，这一步的关键在于火候。",
      "visual_cue": "汤汁翻滚，颜色转深"
    },
    {
      "n": 8,
      "text": "中火焖三分钟，收汁后撒罗勒叶关火。，这一步的关键在于火候。",
      "time_min": 4,
      "heat": "中火",
      "tip": "罗勒关火放，香气才不散。，这一步的关键在于火候。",
      "visual_cue": "汁浓裹料，罗勒翠绿"
    }
  ],
  "tips": [
    "豆腐先煎定型，回锅才不散。，这一点很关键。",
    "香菇要炒到出水，鲜味才浓郁。，这一点很关键。",
    "罗勒最后放，久炒香气全无。，这一点很关键。"
  ],
  "common_mistakes": [
    "豆腐没吸干水，下锅全粘锅底。，这一点很关键。",
    "全程小火慢炒，香菇出一锅水。，这一点很关键。",
    "盐和酱油一起猛加，咸得发苦。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "老豆腐",
      "ratio": "350 克:350 克",
      "note": "质地更硬，煎起来更好操作。"
    },
    {
      "original": "香菇",
      "substitute": "口蘑",
      "ratio": "200 克:200 克",
      "note": "出水更多，焖的时间减一分钟。"
    }
  ],
  "variations": [
    "加一把毛豆，颜色和口感更丰富。，这一点很关键。",
    "改用咖喱酱炒，做成咖喱豆腐。，这一点很关键。"
  ],
  "serving_suggestion": "配香米饭，素食主菜很下饭。，这一点很关键。",
  "storage": "冷藏两天，复热用炒锅，微波会出水。",
