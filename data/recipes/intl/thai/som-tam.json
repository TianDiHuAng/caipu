  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "青木瓜",
          "name_en": "green papaya",
          "amount": 400,
          "unit": "g",
          "note": "去皮去籽，刨成细丝",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 100,
          "unit": "g",
          "note": "对半切去蒂",
          "optional": false
        },
        {
          "name": "豆角",
          "name_en": "green beans",
          "amount": 60,
          "unit": "g",
          "note": "切 3 厘米段",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
          "note": "切 3 厘米段，焯水 3 分钟至熟透后沥干",
          "optional": false
        },
        {
          "name": "小米辣",
          "name_en": "bird's eye chili",
          "amount": 10,
          "unit": "g",
          "note": "按耐辣度增减",
          "optional": false
        },
        {
          "name": "花生",
          "name_en": "peanut",
          "amount": 30,
          "unit": "g",
          "note": "干锅烤香后略压碎",
          "optional": false
        },
        {
          "name": "虾米",
          "name_en": "dried shrimp",
          "amount": 15,
          "unit": "g",
          "note": "温水泡 5 分钟，沥干",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "鱼露",
          "name_en": "fish sauce",
          "amount": 25,
          "unit": "ml",
          "note": "先放 20 毫升再尝味",
          "optional": false
        },
        {
          "name": "青柠",
          "name_en": "lime",
          "amount": 40,
          "unit": "g",
          "note": "挤汁约 30 毫升",
          "optional": false
        },
        {
          "name": "椰糖",
          "name_en": "palm sugar",
          "amount": 25,
          "unit": "g",
          "note": "切碎，便于捣化",
          "optional": false
        },
        {
          "name": "罗望子",
          "name_en": "tamarind",
          "amount": 15,
          "unit": "g",
          "note": "取果肉用 20 毫升温水化开",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "石臼研钵",
    "木杵",
    "刨丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "刨好的青木瓜丝泡冰水 5 分钟，捞出充分沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冰水让木瓜丝更挺脆。",
      "visual_cue": "木瓜丝挺立不软塌"
    },
    {
      "n": 2,
      "text": "研钵中放大蒜与小米辣，捣成粗粒，加椰糖、鱼露、罗望子水与青柠汁继续捣匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "先捣香料再放液体，味道才融合。",
      "visual_cue": "汁液呈浅褐色，能闻到酸辣香"
    },
    {
      "n": 3,
      "text": "放入焯熟的豆角与番茄轻捣至番茄略出汁，再下木瓜丝，边捣边用勺翻拌 2 分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "只轻捣，捣烂木瓜会出水变淡。",
      "visual_cue": "木瓜丝均匀挂汁，呈半透明感"
    },
    {
      "n": 4,
      "text": "拌入泡好的虾米与烤花生碎，装盘后立即上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "花生最后放，保持脆感。",
      "visual_cue": "花生碎铺面，闻到烤花生香"
    }
  ],
  "tips": [
    "青木瓜选表皮青绿、手感硬的，熟瓜会发甜出水。",
    "鱼露品牌咸度差异大，先放 20 毫升再尝。",
    "用研钵比料理机好，刀片会把木瓜打烂。"
  ],
  "common_mistakes": [
    "用熟木瓜代替青木瓜，成品软烂出水。",
    "一次加足鱼露，过咸且压住青柠香。"
  ],
  "substitutions": [
    {
      "original": "青木瓜",
      "substitute": "青芒果或胡萝卜",
      "ratio": "1:1",
      "note": "青芒果更酸，糖加 5 克；胡萝卜口感偏硬。"
    },
    {
      "original": "椰糖",
      "substitute": "红糖",
      "ratio": "1:1",
      "note": "红糖风味更重，颜色偏深。"
    }
  ],
  "variations": [
    "泰东北版本加腌蟹或生腌虾，风味更重，但需注意生食风险。",
    "素食版去掉鱼露与虾米，用酱油加海苔碎替代。"
  ],
  "serving_suggestion": "作为泰餐前菜，配烤鸡与糯米饭。",
  "storage": "现拌现吃，冷藏不超过 4 小时，久放出水变软。",
