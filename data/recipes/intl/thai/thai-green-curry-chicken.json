  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 600,
          "unit": "g",
          "note": "去骨切块",
          "optional": false
        },
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 400,
          "unit": "ml",
          "note": "分两次用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "茄子",
          "name_en": "eggplant",
          "amount": 200,
          "unit": "g",
          "note": "切滚刀块",
          "optional": false
        },
        {
          "name": "罗勒",
          "name_en": "basil",
          "amount": 15,
          "unit": "g",
          "note": "最后放",
          "optional": false
        },
        {
          "name": "青柠",
          "name_en": "lime",
          "amount": 1,
          "unit": "piece",
          "note": "取汁",
          "optional": false
        },
        {
          "name": "红辣椒",
          "name_en": "red chili",
          "amount": 20,
          "unit": "g",
          "note": "切斜片",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "绿咖喱酱",
          "name_en": "green curry paste",
          "amount": 60,
          "unit": "g",
          "note": "按辣度调整",
          "optional": false
        },
        {
          "name": "鱼露",
          "name_en": "fish sauce",
          "amount": 25,
          "unit": "ml",
          "note": "定咸鲜",
          "optional": false
        },
        {
          "name": "椰糖",
          "name_en": "palm sugar",
          "amount": 15,
          "unit": "g",
          "note": "可用白糖代替",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "炒酱用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "木铲",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切 3cm 块，用 10ml 鱼露抓匀腌 10 分钟；茄子切滚刀块泡盐水。",
      "time_min": 15,
      "heat": "无火",
      "tip": "茄子泡盐水可防氧化发黑。",
      "visual_cue": "鸡肉表面微黏、茄子颜色发亮"
    },
    {
      "n": 2,
      "text": "锅中放 20ml 植物油，小火下 60g 绿咖喱酱炒 2 分钟至出香出油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酱一定要用油炒开，生酱味很冲。",
      "visual_cue": "酱色转深、油脂泛绿光"
    },
    {
      "n": 3,
      "text": "倒入 200ml 椰浆继续小火搅匀，煮到表面浮起一层绿油。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰浆分次加，先浓后稀层次更好。",
      "visual_cue": "表面析出绿色油花、香气浓郁"
    },
    {
      "n": 4,
      "text": "下鸡腿肉翻炒 5 分钟至上色，再加入茄子与剩余 200ml 椰浆。",
      "time_min": 7,
      "heat": "中火",
      "tip": "鸡肉先炒定型，久煮才不会散。",
      "visual_cue": "鸡肉表面转白、茄子开始变软"
    },
    {
      "n": 5,
      "text": "加 15g 棕榈糖与 15ml 鱼露调味，小火煮 6 分钟至茄子软透。",
      "time_min": 7,
      "heat": "小火",
      "tip": "糖先放、鱼露后放，咸甜才平衡。",
      "visual_cue": "茄子软而不烂、汤汁略稠"
    },
    {
      "n": 6,
      "text": "关火后挤入青柠汁，撒九层塔叶与红辣椒片，拌匀即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁关火后加，酸香才不挥发。",
      "visual_cue": "表面浮绿油、九层塔微微萎软"
    }
  ],
  "tips": [
    "绿咖喱酱品牌辣度差别大，先放 40g 试味再加。",
    "椰浆要选浓稠型，太稀的煮不出油花。",
    "茄子先泡盐水，煮后颜色紫亮不发黑。"
  ],
  "common_mistakes": [
    "咖喱酱直接倒进汤里，生酱味重且香味不出。",
    "大火滚煮椰浆，油水分离变成絮状。",
    "青柠汁过早放入久煮，酸味变苦涩还带杂味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600g 对 550g",
      "note": "鸡胸易柴，煮的时间缩短 2 分钟。"
    },
    {
      "original": "棕榈糖",
      "substitute": "白糖",
      "ratio": "15g 对 12g",
      "note": "甜度更直接，略减用量。"
    }
  ],
  "variations": [
    "牛肉版：换成 500g 牛里脊片，煮前先滑油。",
    "素食版：鸡肉换成 300g 老豆腐与 150g 口蘑。"
  ],
  "serving_suggestion": "配一碗泰国香米饭，把咖喱汁浇在饭上最下饭。",
  "storage": "冷藏 2 天，复热时补 50ml 椰浆避免变稠。",
