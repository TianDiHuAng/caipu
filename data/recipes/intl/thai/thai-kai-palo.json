    "小碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋放汤锅加冷水没过两厘米，中火烧开后再煮八分钟，煮到蛋黄完全凝固。",
      "time_min": 12,
      "heat": "中火",
      "tip": "水开后再计时，冷水下锅蛋壳不易裂，这一步千万别省。",
      "visual_cue": "蛋身浮沉，水面微微沸腾，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "捞出鸡蛋立刻放进冷水里泡五分钟，边泡边轻敲蛋壳，让壳与蛋白分离。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过冷水让蛋白收缩，剥壳一撕就掉不破，火候和顺序都要留神。",
      "visual_cue": "蛋壳敲出细纹，蛋白完整，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "从蛋的大头开始剥壳，剥好后用牙签在蛋白上扎几个小孔方便入味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "扎孔让卤汁渗进去，蛋白里外咸度一致，提前把配料备好再动手更稳。",
      "visual_cue": "蛋白光洁，表面有小孔，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "汤锅里倒生抽、老抽、清水，加细砂糖、八角、陈皮和五香粉，大火煮开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "卤汁先煮开让香料出味，再下蛋才入味，这一步千万别省。",
      "visual_cue": "卤汁深褐，香料浮在表面，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "放入蒜、香菜根和干辣椒，下剥好的鸡蛋，转小火保持微沸卤二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "小火慢卤蛋白才嫩，大火会煮出蜂窝孔，火候和顺序都要留神。",
      "visual_cue": "蛋身转深褐，卤汁微滚，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "关火后让鸡蛋在卤汁里再浸泡十分钟，捞出对半切开，淋汁撒香菜。",
      "time_min": 12,
      "heat": "无火",
      "tip": "离火浸泡比一直煮更入味，蛋白也更嫩，提前把配料备好再动手更稳。",
      "visual_cue": "切面酱色入里，蛋黄绵密，颜色和形态变化明显"
    }
  ],
  "tips": [
    "鸡蛋冷水下锅煮，水开后再计时八分钟，蛋黄刚好凝固不老。",
    "煮好的蛋立刻过冷水再剥壳，蛋壳一撕就掉，蛋白光滑不破。",
    "卤汁煮开后关小火保持微沸，蛋才慢慢吃味，大火会把蛋白煮硬发柴。"
  ],
  "common_mistakes": [
    "鸡蛋热水下锅，蛋壳受热炸裂，蛋白漏出来糊了一锅。",
    "剥壳太急，蛋白被扯掉一块块，卤好后表面坑坑洼洼。",
    "卤汁收得太干，糖分浓缩发苦，蛋皮又咸又黏，只能刮掉吃。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "鹌鹑蛋",
      "ratio": "480克:480克",
      "note": "鹌鹑蛋煮五分钟即可，卤的时间缩短一半。"
    },
    {
      "original": "生抽",
      "substitute": "酱油膏",
      "ratio": "80毫升:60克",
      "note": "更浓稠，卤汁需补一百毫升水。"
    }
  ],
  "variations": [
    "卤汁里加两片香茅和青柠叶，做成带草本香的泰南风味。",
    "把蛋换成炸过的豆腐块，同样的卤汁卤出来就是素食版五香卤豆腐。"
  ],
  "serving_suggestion": "剥壳后对半切开，淋一勺热卤汁，配糯米饭和一份青木瓜沙拉。",
  "storage": "连卤汁一起冷藏可放三天，冷藏后卤汁凝固成冻属正常，回热时小火化开。",
