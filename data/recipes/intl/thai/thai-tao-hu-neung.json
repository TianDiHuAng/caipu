    "刀",
    "砧板",
    "浅盘",
    "碗",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐横刀片成两厘米厚的片，用厨房纸吸掉表面水分。",
      "time_min": 7,
      "heat": "无火",
      "tip": "吸干水分，蒸出来的汁才不浑浊。",
      "visual_cue": "豆腐片完整，表面干爽"
    },
    {
      "n": 2,
      "text": "香菇去蒂切成细丝，姜和大蒜分别切成细末备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "姜末切细一点，蒸过之后才不会呛口。",
      "visual_cue": "菇丝均匀，姜末细碎"
    },
    {
      "n": 3,
      "text": "小锅倒酱油、清水、棕榈糖和鱼露，小火加热搅至糖化开。",
      "time_min": 4,
      "heat": "小火",
      "tip": "汁先调好，蒸好浇上味道才匀。",
      "visual_cue": "汁液清亮微稠，糖全化开"
    },
    {
      "n": 4,
      "text": "豆腐片整齐码进浅盘，撒上香菇丝、姜末和蒜末。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豆腐平铺不叠压，受热才均匀。",
      "visual_cue": "豆腐平铺一盘，配料铺面"
    },
    {
      "n": 5,
      "text": "蒸锅水大火烧开后放入浅盘，大火蒸八分钟至豆腐定型。",
      "time_min": 10,
      "heat": "大火",
      "tip": "水开再上锅，蒸八分钟豆腐刚好嫩滑。",
      "visual_cue": "蒸锅上汽，盘中有清汁"
    },
    {
      "n": 6,
      "text": "取出盘子倒掉盘里多余的水，避免味道被稀释。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘里的水一定要倒掉，不然汁会变淡。",
      "visual_cue": "盘底清亮无水，豆腐表面微鼓"
    },
    {
      "n": 7,
      "text": "把调好的调味汁均匀淋在豆腐上，再淋一层芝麻油。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁趁热淋，豆腐才吸得进味。",
      "visual_cue": "汁液铺满盘底，油光浮面"
    },
    {
      "n": 8,
      "text": "撒上葱花、朝天椒圈和香菜段，趁热连盘上桌即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "配菜最后撒，颜色鲜亮香气足。",
      "visual_cue": "葱花翠绿，辣椒圈鲜红"
    }
  ],
  "tips": [
    "豆腐吸干水分，蒸出的汁才不浑。",
    "姜末切得越细越好，蒸过之后才不会呛口。",
    "盘里的水要倒掉，否则味道被冲淡。",
    "调味汁趁热淋，豆腐才吸得进味。"
  ],
  "common_mistakes": [
    "豆腐带水下锅，蒸完盘里一汪浑水。",
    "水没开就上锅，豆腐蒸老起蜂窝。",
    "汁一次性熬得太咸，浇完只能配白饭。",
    "葱花和香菜早放，蒸完变成黄褐色。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "鸡蛋豆腐",
      "ratio": "500克:500克",
      "note": "口感更弹，蒸的时间加两分钟。"
    },
    {
      "original": "香菇",
      "substitute": "金针菇",
      "ratio": "120克:120克",
      "note": "不用切丝，直接铺在豆腐上。"
    }
  ],
  "variations": [
    "加一勺椰浆进调味汁，奶香更浓。",
    "铺几只虾仁一起蒸，鲜味更足也更像宴客菜。",
    "淋一点辣椒油，做成微辣版本更开胃下饭。"
  ],
  "serving_suggestion": "连盘上桌，配香米饭舀汁拌饭，清淡又下饭，适合做一桌菜的清口菜。",
  "storage": "冷藏可放一天，复热用蒸锅回蒸四分钟，不要用微波以免豆腐出水。",
