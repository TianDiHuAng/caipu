  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "锅铲",
    "碗",
    "杵臼"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成两厘米见方的丁，加盐抓匀静置十分钟入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切得匀一点，炒的时候才一起熟。",
      "visual_cue": "鸡丁大小一致，表面微黏"
    },
    {
      "n": 2,
      "text": "四季豆掐去两头撕掉筋络，掰成四厘米长的段洗净沥干。",
      "time_min": 4,
      "heat": "无火",
      "tip": "筋络一定要撕掉，不然嚼起来塞牙。",
      "visual_cue": "豆段整齐，表面无水"
    },
    {
      "n": 3,
      "text": "朝天椒和红葱头拍碎，大蒜切粗粒，用杵臼略捣出香气。",
      "time_min": 6,
      "heat": "无火",
      "tip": "略捣一下辣味更容易出来，但别捣成泥。",
      "visual_cue": "料碎带汁，香气冲鼻"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒烟倒植物油，下捣好的辣料小火炒四十秒。",
      "time_min": 2,
      "heat": "小火",
      "tip": "辣料用小火，火大容易焦苦。",
      "visual_cue": "锅中油变红，香味浓"
    },
    {
      "n": 5,
      "text": "转中大火下鸡丁，摊平煎两分钟再翻炒至表面变白定型。",
      "time_min": 5,
      "heat": "中大火",
      "tip": "先摊平煎再翻，鸡肉表面才焦香。",
      "visual_cue": "鸡丁表面发白带焦边"
    },
    {
      "n": 6,
      "text": "下四季豆段翻炒三分钟，炒到豆段表面起皱颜色变深绿。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "四季豆要炒到起皱，才彻底断生不夹生。",
      "visual_cue": "豆段深绿起皱，锅气足"
    },
    {
      "n": 7,
      "text": "淋鱼露和酱油，撒棕榈糖，快炒一分半让酱汁裹匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "糖要最后撒，才不会先焦在锅底。",
      "visual_cue": "酱汁亮红，均匀裹在食材上"
    },
    {
      "n": 8,
      "text": "关火抓一把罗勒叶翻两下，挤青柠汁，趁热配米饭上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "罗勒靠余温出香，久炒会发黑。",
      "visual_cue": "罗勒翠绿微卷，酱汁油亮"
    }
  ],
  "tips": [
    "鸡丁切得匀，受热一致才不会老的生嫩的生。",
    "辣料用小火炒出红色，火大只会焦苦。",
    "四季豆要炒到起皱，彻底断生才安全。",
    "罗勒关火再下，靠余温出香不发黑。"
  ],
  "common_mistakes": [
    "鸡丁切得大小不一，小的柴了大的还生。",
    "辣料大火爆香，整锅泛出焦苦味。",
    "四季豆炒两下就起锅，豆腥味重还有生味。",
    "罗勒一早就下锅，出锅全变成黑片。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "450克:450克",
      "note": "更瘦，炒的时间各减一分钟。"
    },
    {
      "original": "四季豆",
      "substitute": "彩椒",
      "ratio": "150克:150克",
      "note": "不用久炒，断生即可出锅。"
    }
  ],
  "variations": [
    "加一把腰果同炒，脆感更足也更香。",
    "淋一勺椰浆收汁，辣味变得柔和。",
    "把鸡丁换成虾仁，做成海鲜版本更快手。"
  ],
  "serving_suggestion": "盛盘趁热配香米饭，盘子边上放两片黄瓜解辣，再配一碗清汤就成一顿。",
  "storage": "冷藏可放两天，复热用炒锅大火三十秒，微波会让鸡肉发硬出水。",
