        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 700,
          "unit": "ml",
          "note": "煮粉",
          "optional": false
        },
        {
          "name": "香草荚",
          "name_en": "vanilla pod",
          "amount": 3,
          "unit": "ml",
