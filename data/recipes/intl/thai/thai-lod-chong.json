          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "碗",
    "刀",
    "刮板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "淀粉加二百毫升清水搅匀，过筛去颗粒。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛一次，凉粉才透亮。，看准状态再往下做。",
      "visual_cue": "粉浆顺滑，无结块，这一点很关键。"
    },
    {
      "n": 2,
      "text": "剩余清水加一半白糖煮开。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "糖先化开，粉浆才不糊底。，看准状态再往下做。",
      "visual_cue": "水面翻滚，糖全溶，这一点很关键。"
    },
    {
      "n": 3,
      "text": "关小火，粉浆慢慢倒入并快速搅动。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "边倒边搅，否则结块。，看准状态再往下做。",
      "visual_cue": "粉浆变稠，颜色透明"
    },
    {
      "n": 4,
      "text": "搅到粉糊透亮冒泡，再煮一分钟。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "透明就熟了，生的会有粉味。，看准状态再往下做。",
      "visual_cue": "糊体透明，能拉丝，这一点很关键。"
    },
    {
      "n": 5,
      "text": "粉糊压进漏勺，落入冰水盆成条。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "漏勺抬高，条才细长均匀。，看准状态再往下做。",
      "visual_cue": "条状沉底，透明弹手"
    },
    {
      "n": 6,
      "text": "椰奶加剩余白糖和盐，小火加热到微沸。，看准状态再往下做。",
      "time_min": 6,
      "heat": "小火",
      "tip": "加点盐，甜味才立体。，看准状态再往下做。",
      "visual_cue": "汁面微沸，香气散出"
    },
    {
      "n": 7,
      "text": "加香草精搅匀，放凉备用。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "放凉再淋，凉粉才不化。，看准状态再往下做。",
      "visual_cue": "汁体顺滑，微凉，这一点很关键。"
    },
    {
      "n": 8,
      "text": "凉粉沥水盛碗，淋上椰奶汁加冰块。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "加冰块口感更清爽。，看准状态再往下做。",
      "visual_cue": "碗中漂浮，汁面泛光"
    }
  ],
  "tips": [
    "粉浆过筛，凉粉才透亮。，这一点很关键。",
    "倒粉浆时要不停搅，否则结块。，这一点很关键。",
    "椰奶汁加点盐，甜味更有层次。，这一点很关键。"
  ],
  "common_mistakes": [
    "粉浆直接倒进沸水，结成一坨。，这一点很关键。",
    "煮不透就漏，凉粉带生粉味。，这一点很关键。",
    "椰奶汁煮过头，油水分离。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "淀粉",
      "substitute": "玉米淀粉",
      "ratio": "150 克:150 克",
      "note": "透明度略差，口感相近。"
    },
    {
      "original": "香草精",
      "substitute": "香草荚",
      "ratio": "3 毫升:半根",
      "note": "香气更自然，需浸泡。"
    }
  ],
  "variations": [
    "加一点斑斓汁，颜色更翠。，这一点很关键。",
    "配甜玉米粒，口感更丰富。，这一点很关键。"
  ],
  "serving_suggestion": "冰镇后食用，夏天最解暑。，这一点很关键。",
  "storage": "凉粉冷藏两天，椰奶汁当日用完。，这一点很关键。",
