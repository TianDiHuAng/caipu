  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 300,
          "unit": "g",
          "note": "过筛",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 450,
          "unit": "ml",
          "note": "调浆",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 70,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "刷盘",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "孔状煎盘",
    "碗",
    "打蛋器",
    "勺子",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉过筛进碗里，加盐和一半椰奶搅成无颗粒的浆。",
      "time_min": 6,
      "heat": "无火",
      "tip": "边倒边搅，粉才不会沉底结块。，注意火候。",
      "visual_cue": "浆体顺滑，无干粉，状态稳定"
    },
    {
      "n": 2,
      "text": "倒入剩余椰奶和白糖，搅到糖完全化开后静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置让粉充分吸水，煎出来才不散。，注意火候。",
      "visual_cue": "浆体浓稠，能挂勺，状态稳定"
    },
    {
      "n": 3,
      "text": "孔状煎盘刷一层植物油，中小火烧到微微发热。",
      "time_min": 5,
      "heat": "中火",
      "tip": "每个孔都要刷到，脱模才干净不破边。",
      "visual_cue": "盘面油亮，热度均匀，状态稳定"
    },
    {
      "n": 4,
      "text": "把粉浆倒进每个孔里，装到七分满后盖上盖子。",
      "time_min": 4,
      "heat": "中火",
      "tip": "七分满留出膨胀空间，溢出会连成一整片。",
      "visual_cue": "每孔齐平，浆面平滑，状态稳定"
    },
    {
      "n": 5,
      "text": "煎四分钟到边缘定型、底部微焦，开盖看表面是否凝固。",
      "time_min": 5,
      "heat": "中火",
      "tip": "边缘先熟，中间还在冒泡是正常状态。",
      "visual_cue": "边缘定型，底面焦黄，状态稳定"
    },
    {
      "n": 6,
      "text": "盖上盖子再煎三分钟，让中心完全熟透后关火。",
      "time_min": 4,
      "heat": "小火",
      "tip": "全程中小火，火大底部焦了中间还稀。",
      "visual_cue": "表面凝固，香气散出，状态稳定"
    },
    {
      "n": 7,
      "text": "用小勺沿孔边一挑脱模，趁热装盘上桌。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃外脆内软，凉了会变韧。，注意火候。",
      "visual_cue": "外壳焦脆，整体圆润，状态稳定"
    }
  ],
  "tips": [
    "粉浆过筛搅匀，煎出来才无颗粒。，值得留意。",
    "孔里只装七分满，留出膨胀空间。，值得留意。",
    "中小火慢煎，底部才焦中间不稀。，值得留意。"
  ],
  "common_mistakes": [
    "粉浆调太稀，煎出来软塌不成形。，务必避免。",
    "孔里倒太满，几只连成一片撕不开。，务必避免。",
    "火太大，底面焦黑中间还是浆。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "糯米粉",
      "substitute": "粘米粉",
      "ratio": "300 克:300 克",
      "note": "口感更硬挺，椰奶可多加五十毫升。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "70 克:70 克",
      "note": "颜色偏褐，焦糖香更重。"
    }
  ],
  "variations": [
    "表面撒少许玉米粒，口感更丰富。，也很受欢迎。",
    "加一勺椰蓉同煎，香气更浓。，也很受欢迎。"
  ],
  "serving_suggestion": "趁热当街头小吃吃，配一杯冰椰奶正好解甜。",
  "storage": "常温一天，冷藏两天，复热用平底锅小火两面各煎一分钟。",
