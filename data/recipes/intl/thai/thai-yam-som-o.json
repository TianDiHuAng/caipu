    "沙拉碗",
    "榨汁器",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "柚子剥去外层厚皮与白色薄膜，把果肉掰成拇指大的小块放碗里。",
      "time_min": 8,
      "heat": "无火",
      "tip": "白膜一定要撕干净，留一点都会发苦。",
      "visual_cue": "果肉颗粒分明，碗底没有多余汁水"
    },
    {
      "n": 2,
      "text": "虾仁放进沸水里煮到卷起变红，捞出过一遍凉水沥干备用。",
      "time_min": 4,
      "heat": "大火",
      "tip": "过凉水能让虾仁收紧，拌的时候不易碎。",
      "visual_cue": "虾仁紧实弹手，颜色粉红均匀"
    },
    {
      "n": 3,
      "text": "青柠对半切开榨出汁，加鱼露与椰糖搅到糖完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要先化开再拌，否则沙拉里会有颗粒。",
      "visual_cue": "料汁清亮，尝起来酸中带甜"
    },
    {
      "n": 4,
      "text": "把虾仁、红葱头片与小米辣放进柚子碗里，轻轻铺平。",
      "time_min": 2,
      "heat": "无火",
      "tip": "红葱头切薄一点，辛味才不会压住果香。",
      "visual_cue": "碗内料铺得均匀，果肉完整"
    },
    {
      "n": 5,
      "text": "淋上调好的料汁，用勺子从底部向上轻拌，别用力压果肉。",
      "time_min": 2,
      "heat": "无火",
      "tip": "果肉一压就出水，拌的动作要轻要快。",
      "visual_cue": "果肉裹上料汁仍保持颗粒完整"
    },
    {
      "n": 6,
      "text": "撒上花生碎、椰蓉与香菜段，装盘后趁新鲜立刻上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "花生碎最后撒才脆，早了会吸汁变软。",
      "visual_cue": "表面花生金黄，椰蓉雪白点缀"
    }
  ],
  "tips": [
    "柚子选水分足、皮薄的，剥起来好用也不苦。",
    "虾仁可以换成烤鸡丝，风味同样清爽。",
    "料汁提前拌好静置五分钟，味道更融合。",
    "拌好后别久放，半小时内吃完口感最好。"
  ],
  "common_mistakes": [
    "白膜没撕干净，整碗沙拉都带苦涩味。",
    "料汁里的糖没化开，吃起来有颗粒砂感。",
    "提前一小时拌好，果肉出水泡得软烂。"
  ],
  "substitutions": [
    {
      "original": "柚子",
      "substitute": "西柚",
      "ratio": "400克:400克",
      "note": "西柚偏酸，椰糖可多加五克平衡。"
    },
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "120克:150克",
      "note": "煮熟撕成细丝，放凉后再拌。"
    }
  ],
  "variations": [
    "加几片烤椰片同拌，咬起来更有层次。",
    "换成青芒果切丝代替一半柚子，酸度更明显。"
  ],
  "serving_suggestion": "装进白瓷盘里趁凉吃，柚子清甜多汁，虾仁弹牙，花生碎一咬就碎开，酸甜里带一点辣。",
  "storage": "拌好后冷藏不超过四小时，花生与椰蓉建议现吃现撒，久放会回软失去脆感。",
