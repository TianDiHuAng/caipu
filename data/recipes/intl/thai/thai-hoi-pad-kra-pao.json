    "锅铲",
    "漏盆",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛤蜊放进淡盐水里静置两小时吐净泥沙，捞出用刷子逐只刷洗外壳。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水里滴几滴油能催促吐沙，中途换一次水。",
      "visual_cue": "盆底沉下细沙，蛤蜊壳面干净"
    },
    {
      "n": 2,
      "text": "泰国罗勒摘下叶片洗净，大蒜与小米辣切碎，红葱头切成薄片备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "罗勒梗别丢，梗比叶更耐炒，香气也更足。",
      "visual_cue": "叶片完整无破损，蒜末大小均匀"
    },
    {
      "n": 3,
      "text": "炒锅烧到微微冒烟，放植物油后下蒜末、小米辣与红葱头炒香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "锅要够热再下料，冷锅炒香料会出苦味。",
      "visual_cue": "蒜末边缘泛黄，油面泛起细密泡沫"
    },
    {
      "n": 4,
      "text": "倒入蛤蜊，沿锅边淋入清水，盖上锅盖焖到壳全部张开。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "开口后立刻进入下一步，久焖肉就缩水变硬。",
      "visual_cue": "蛤蜊壳七成以上张开，汤汁微滚"
    },
    {
      "n": 5,
      "text": "加鱼露、蚝油与白糖，快速翻炒十几下让汤汁均匀裹住蛤蜊。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "别用铲子用力压壳，汤汁沾匀就够，压碎会掉渣。",
      "visual_cue": "壳面挂汁发亮，锅底剩少量浓汁"
    },
    {
      "n": 6,
      "text": "关火前撒进泰国罗勒叶片，用余温翻两下烫出香气即可出锅。",
      "time_min": 1,
      "heat": "小火",
      "tip": "罗勒遇高温容易发黑，靠余温烫最合适。",
      "visual_cue": "罗勒叶颜色转深绿，香气扑鼻"
    }
  ],
  "tips": [
    "蛤蜊买回来先问摊主是否已吐沙，可省一半时间。",
    "没张口的蛤蜊直接挑出丢掉，说明已经死掉。",
    "汤汁别收太干，拌饭是这道菜的精髓。",
    "罗勒换成九层塔风味接近，但香气略薄。"
  ],
  "common_mistakes": [
    "蛤蜊没吐沙就下锅，吃一口满嘴是沙子。",
    "焖煮时间过长，蛤蜊肉缩成一点点又老又韧。",
    "罗勒和蒜一起早下，炒到发黑还带苦味。"
  ],
  "substitutions": [
    {
      "original": "蛤蜊",
      "substitute": "花甲",
      "ratio": "600克:600克",
      "note": "同样需要吐沙，个头小熟得更快。"
    },
    {
      "original": "泰国罗勒",
      "substitute": "九层塔",
      "ratio": "25克:25克",
      "note": "香气稍淡，可适当增加用量。"
    }
  ],
  "variations": [
    "加一勺辣椒膏同炒，颜色更红辣味更厚。",
    "换成椰奶做咖喱炒蛤蜊，汤汁更浓郁。"
  ],
  "serving_suggestion": "趁热连壳带汁装盘，先吸一口壳里的汤汁再挑肉吃，辣味混着罗勒的清香，配冰啤酒最对味。",
  "storage": "建议现做现吃，冷藏后再复热蛤蜊肉会变硬，最多存放一天且须彻底加热。",
