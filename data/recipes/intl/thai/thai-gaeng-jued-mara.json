        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "小勺",
    "蒸盘",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苦瓜洗净后切成三厘米厚的圈状，用小勺把中间的瓤与籽彻底挖干净。",
      "time_min": 6,
      "heat": "无火",
      "tip": "瓤要挖到露出淡绿的肉，汤才不会发苦。",
      "visual_cue": "苦瓜圈内壁光滑，圈身完整不塌"
    },
    {
      "n": 2,
      "text": "汤锅烧一锅开水，把苦瓜圈放进去焯一分钟，捞出沥干水分备用。",
      "time_min": 2,
      "heat": "大火",
      "tip": "焯水能带走大半苦味，时间别超过一分半。",
      "visual_cue": "苦瓜圈颜色转为翠绿半透明"
    },
    {
      "n": 3,
      "text": "猪肉末放大蒜末、虾米碎与一半鱼露，顺着一个方向搅到肉馅起胶发黏。",
      "time_min": 5,
      "heat": "无火",
      "tip": "同一方向搅，肉馅才抱团不散，入口更弹。",
      "visual_cue": "肉馅黏成一团，挑起不轻易掉落"
    },
    {
      "n": 4,
      "text": "把肉馅填进每个苦瓜圈里，用勺背压平表面，逐个摆进深盘备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "填八分满就够，煮的时候肉馅还会微微膨胀。",
      "visual_cue": "肉馅与圈口齐平，没有空隙和气泡"
    },
    {
      "n": 5,
      "text": "清水倒进汤锅煮沸，放入酿好的苦瓜圈，转中小火加盖煮二十分钟。",
      "time_min": 20,
      "heat": "中小火",
      "tip": "保持汤面微沸，大火会把肉馅煮散冲出圈外。",
      "visual_cue": "汤色清亮微绿，苦瓜圈浮起变软"
    },
    {
      "n": 6,
      "text": "加剩下的鱼露与盐调味，撒上香菜段，关火后连汤盛进深碗即可上桌。",
      "time_min": 2,
      "heat": "小火",
      "tip": "先尝汤再补盐，虾米本身带咸味容易过咸。",
      "visual_cue": "汤面飘着香菜，苦瓜圈饱满不散"
    }
  ],
  "tips": [
    "肉馅选带一点肥的，煮出来才不柴不干。",
    "苦瓜焯水后立刻沥干，避免久泡发黄。",
    "汤要全程微沸，滚太猛肉馅会从圈里掉出。",
    "喜欢清甜可以加两片冬瓜同煮，汤味更柔。"
  ],
  "common_mistakes": [
    "苦瓜瓤没挖干净，煮出来的汤苦得盖住肉香。",
    "肉馅填得太满，一煮就溢出圈外散成肉渣。",
    "全程大火滚煮，肉馅散开汤色浑浊不清。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉",
      "ratio": "200克:200克",
      "note": "剁成粗粒后搅打上劲，口感更清爽。"
    },
    {
      "original": "虾米",
      "substitute": "干贝",
      "ratio": "10克:10克",
      "note": "提前泡软撕成细丝，鲜味更浓。"
    }
  ],
  "variations": [
    "换个做法用清鸡汤代替清水，汤底更鲜更厚。",
    "加几颗白胡椒粒同煮，暖胃又去苦味。"
  ],
  "serving_suggestion": "趁热连汤带料盛进深碗，先喝一口清汤再咬开苦瓜圈，肉汁混着微苦的回甘最舒服。",
  "storage": "冷藏可存两天，复热时加少量清水小火煮开，别反复滚沸以免肉馅散掉。",
