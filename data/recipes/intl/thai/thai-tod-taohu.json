        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "漏勺",
    "厨房纸",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐横着片成一厘米半厚的块，用厨房纸包住压十分钟，把水分挤出来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水分压得越干，炸出来越脆，也不容易炸锅。",
      "visual_cue": "豆腐变薄，厨房纸吸满水"
    },
    {
      "n": 2,
      "text": "压好的豆腐切成三厘米见方的块，表面均匀滚上一层玉米淀粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "滚完抖掉多余干粉，炸的时候油才不浑。",
      "visual_cue": "块面干爽，粉层薄而匀"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，豆腐块分批下锅，中火炸四分钟到外壳金黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一次别下太多，油温掉了外壳就不脆。",
      "visual_cue": "外壳金黄，边缘浮起冒泡"
    },
    {
      "n": 4,
      "text": "炸好的豆腐用漏勺捞出，放在厨房纸上沥掉浮油，保持温热。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出锅后竖着排开摆放，免得底部积油变软",
      "visual_cue": "外壳干爽，按压有脆响"
    },
    {
      "n": 5,
      "text": "小碗里放椰糖、鱼露和青柠汁，搅到糖化开，再拌进花生碎做成蘸酱。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先把糖彻底化开再加花生，酱才不会结块",
      "visual_cue": "酱汁浓稠，花生挂勺不落"
    },
    {
      "n": 6,
      "text": "豆腐摆盘，撒上小葱碎和一小撮盐，蘸酱单独装碟上桌即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蘸酱现调现吃，放久了花生会沉底返潮。",
      "visual_cue": "豆腐金黄，酱色透亮如琥珀"
    }
  ],
  "tips": [
    "豆腐一定要用老豆腐，嫩豆腐一切就散，压水也会塌成一团。",
    "油温六成下锅最稳，筷子插进油里周围冒小泡就是六成热。",
    "花生酱里加鱼露和青柠是泰式蘸酱的基本搭配，甜酸咸三味要齐。"
  ],
  "common_mistakes": [
    "豆腐不压水直接炸，油花四溅还炸不脆，成品软塌塌的没口感。",
    "油温太低就下豆腐，淀粉脱落沉底，豆腐吸满油吃起来发腻。",
    "蘸酱一次调太多放桌上，花生吸潮变软，第二天就不好吃了。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "嫩豆腐",
      "ratio": "500克:500克",
      "note": "嫩豆腐须先冷冻再解冻，挤出水分后才能炸。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "15毫升:18毫升",
      "note": "生抽版咸味直，椰糖可减到十五克。"
    }
  ],
  "variations": [
    "把蘸酱换成甜辣酱，孩子更喜欢，酸甜味也更明显。",
    "炸好的豆腐和九层塔一起回锅爆十秒，香气更足，接近街头做法。"
  ],
  "serving_suggestion": "趁热装盘，配糯米饭或者生菜包着吃，蘸酱放中间方便取用。",
  "storage": "炸豆腐当天吃完最好，冷藏后外壳会软，回锅复炸一分钟可以恢复脆度。",
