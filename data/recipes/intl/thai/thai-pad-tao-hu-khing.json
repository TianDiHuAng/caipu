  "equipment": [
    "炒锅",
    "菜刀",
    "木铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干香菇用温水泡二十分钟到软，挤干水分后切成半厘米厚的片备用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡香菇的水别倒，滤净后可以当高汤用",
      "visual_cue": "菇片柔软，捏着有弹性"
    },
    {
      "n": 2,
      "text": "北豆腐切成两厘米厚的片，用厨房纸吸干表面水分，姜切成细丝。",
      "time_min": 6,
      "heat": "无火",
      "tip": "姜丝切得细才不抢口，粗了嚼着发辣。",
      "visual_cue": "豆腐干爽，姜丝细长发亮"
    },
    {
      "n": 3,
      "text": "炒锅放一半植物油烧热，豆腐片下锅小火煎三分钟到两面微黄，盛出。",
      "time_min": 5,
      "heat": "小火",
      "tip": "煎豆腐别急着翻面，等底面结壳再翻动",
      "visual_cue": "两面微黄，边缘结起脆壳"
    },
    {
      "n": 4,
      "text": "锅补余油，下姜丝、蒜片和香菇片，中火炒两分钟炒出香味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "姜丝炒到卷边时最香，一旦炒焦就发苦",
      "visual_cue": "姜丝卷边，香菇香气扑出"
    },
    {
      "n": 5,
      "text": "倒回豆腐片，加生抽、蚝油和白糖翻匀，再沿锅边淋入清水。",
      "time_min": 3,
      "heat": "中火",
      "tip": "调料先在小碗里混匀再倒，味道更均匀。",
      "visual_cue": "酱色挂匀，锅底留有薄汁"
    },
    {
      "n": 6,
      "text": "盖上锅盖小火焖三分钟让豆腐入味，开盖撒小葱段和盐，收汁后出锅。",
      "time_min": 5,
      "heat": "小火",
      "tip": "焖的时间别超三分钟，久了豆腐会碎。",
      "visual_cue": "汤汁收浓，葱段翠绿挺立"
    }
  ],
  "tips": [
    "香菇泡发的水别倒掉，滤掉杂质后当清水用，鲜味能翻一倍。",
    "豆腐先煎再焖，外壳能挡住酱汁，里面还是嫩的，口感有层次。",
    "姜丝是这道菜的主角，切足二十五克才够味，少了就成普通烧豆腐。"
  ],
  "common_mistakes": [
    "香菇用热水急泡，外面软了里面还是硬的，炒出来嚼不动。",
    "豆腐不吸干水分就下锅，油花四溅，煎出来也软塌不结壳。",
    "生抽和蚝油一起早放还大火收，酱汁烧糊发苦，整盘都带焦味。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "油豆腐",
      "ratio": "400克:250克",
      "note": "油豆腐吸味快，焖的时间减到两分钟。"
    },
    {
      "original": "蚝油",
      "substitute": "素蚝油",
      "ratio": "15毫升:15毫升",
      "note": "素蚝油不含贝类，素食者可用。"
    }
  ],
  "variations": [
    "加两根小米辣一起炒，辣味更直接，配糯米饭很下饭。",
    "把香菇换成木耳，口感更脆，泡发时间也能省十分钟。"
  ],
  "serving_suggestion": "装盘后配一碗热米饭，酱汁拌饭最香，也可以配清汤平衡咸味。",
  "storage": "冷藏可放两天，回热时加一勺清水小火焖热，避免大火把豆腐炒碎。",
