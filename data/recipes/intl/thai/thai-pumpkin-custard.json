          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "搅拌盆",
    "滤网",
    "4 只小碗",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜 600g 去皮去籽，切成 2 厘米厚的片，上锅大火蒸 15 分钟至软烂。",
      "time_min": 18,
      "heat": "大火",
      "tip": "蒸到用筷子一戳就透最合适。",
      "visual_cue": "南瓜软烂、边缘略透明"
    },
    {
      "n": 2,
      "text": "趁热把南瓜压成细泥，过筛一次去掉粗纤维，放至微温。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛后布丁口感才细腻。",
      "visual_cue": "南瓜泥细腻、无颗粒"
    },
    {
      "n": 3,
      "text": "3 个鸡蛋打散，加 70g 白糖与 2g 盐搅至糖完全溶解，不要打出泡沫。",
      "time_min": 5,
      "heat": "无火",
      "tip": "只搅不打，起泡会有蜂窝。",
      "visual_cue": "蛋液清亮、糖已化开"
    },
    {
      "n": 4,
      "text": "南瓜泥与 300ml 椰浆倒入蛋液中拌匀，再过筛两遍倒入 4 只小碗。",
      "time_min": 8,
      "heat": "无火",
      "tip": "过筛两遍，成品表面才光滑。",
      "visual_cue": "布丁液顺滑、无气泡"
    },
    {
      "n": 5,
      "text": "碗口盖保鲜膜扎几个小孔，水开后中小火蒸 25 分钟，关火焖 5 分钟。",
      "time_min": 30,
      "heat": "中小火",
      "tip": "中小火蒸，火大表面会起蜂窝。",
      "visual_cue": "轻晃碗中心微颤、表面光滑"
    }
  ],
  "tips": [
    "南瓜泥过筛一次，布丁口感才细腻无渣。",
    "蛋液只搅不打，起泡会让成品出现蜂窝。",
    "中小火蒸制，火太大表面就会粗糙开裂。"
  ],
  "common_mistakes": [
    "南瓜没蒸透就压泥，布丁里有硬块。",
    "蛋液搅出大量泡沫，蒸好表面全是孔。",
    "大火蒸制，布丁膨胀后又塌陷开裂。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "600g 对 600g",
      "note": "甜度更高，糖减到 50g。"
    },
    {
      "original": "椰浆",
      "substitute": "牛奶",
      "ratio": "300ml 对 300ml",
      "note": "奶香更淡，可加 10g 糖。"
    }
  ],
  "variations": [
    "香兰版：加 2 滴香兰精增香。",
    "椰盅版：装入椰壳中蒸，风味更浓。"
  ],
  "serving_suggestion": "冷藏后切块，淋上少许椰浆一起食用。",
  "storage": "冷藏 3 天，取出后可直接冷食。",
