        {
          "name": "南瓜",
          "name_en": "pumpkin",
          "amount": 600,
          "unit": "g",
          "note": "去皮切块",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 300,
          "unit": "ml",
          "note": "布丁液",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 3,
          "unit": "piece",
          "note": "打散",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 70,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
