  "steps": [
    {
      "n": 1,
      "text": "南瓜去籽切块，玉米切成小段。，翻动放轻，形状才完整。",
      "time_min": 10,
      "heat": "无火",
      "tip": "块别切太小，煮久才不烂。，动作放连贯，整道菜才立得住。",
      "visual_cue": "块形均匀，切口平整，锅温要匀，成品才稳当。"
    },
    {
      "n": 2,
      "text": "香菇切片，胡萝卜切薄圆片。，份量心里有数，整道菜才立得住。",
      "time_min": 6,
      "heat": "无火",
      "tip": "片要切薄，才和南瓜同熟。，起锅前尝味，风味才干净。",
      "visual_cue": "薄片透光，大小一致，火别太大，整道菜才立得住。"
    },
    {
      "n": 3,
      "text": "虾米用温水泡五分钟，捞出沥干。，先试试温度，口感才有层次。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡软的虾米才出味。，时间掐准，咸淡才好把握。",
      "visual_cue": "虾米回软，水色发黄，起锅前尝味，咸淡才好把握。"
    },
    {
      "n": 4,
      "text": "汤锅倒清水，放虾米和红辣椒煮开。，锅温要匀，口感才有层次。",
      "time_min": 7,
      "heat": "大火",
      "tip": "虾米先煮，汤底才鲜。，手法轻些，味道才进得去。",
      "visual_cue": "水面翻滚，香气扑鼻，别急着加油，成品才好看。"
    },
    {
      "n": 5,
      "text": "下南瓜和玉米，中火煮八分钟。，汤汁别收太干，成品才稳当。",
      "time_min": 9,
      "heat": "中火",
      "tip": "耐煮的先下，火候才齐。，先试试温度，成品才稳当。",
      "visual_cue": "南瓜微软，玉米转亮，留意锅底，整道菜才立得住。"
    },
    {
      "n": 6,
      "text": "加香菇和胡萝卜，再煮五分钟。，汤汁别收太干，细节才到位。",
      "time_min": 6,
      "heat": "中火",
      "tip": "后放的菜别煮过头。，翻动放轻，整道菜才立得住。",
      "visual_cue": "香菇软塌，胡萝卜发亮，顺序照着来，颜色才够亮。"
    },
    {
      "n": 7,
      "text": "加鱼露和白糖调味，搅匀。，动作放连贯，口感才不散。",
      "time_min": 3,
      "heat": "中火",
      "tip": "鱼露分次加，咸淡才好调。，别用力搅，火候才均匀。",
      "visual_cue": "汤色浅褐，咸鲜扑鼻，盖盖焖一会儿，形状才完整。"
    },
    {
      "n": 8,
      "text": "关火撒香菜，盛碗上桌。，顺序照着来，口感才不发柴。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香菜关火再放，香气才清。，起锅前尝味，吃口才舒服。",
      "visual_cue": "香菜翠绿，汤面清亮，火别太大，成品才好看。"
    }
  ],
  "tips": [
    "南瓜选粉的，煮出来汤才甜。，保持小火，香气才不跑。",
    "虾米泡软再用，鲜味才释放。，别用力搅，口感才有层次。",
    "鱼露分次加，咸淡才好控制。，翻动放轻，味道才进得去。"
  ],
  "common_mistakes": [
    "南瓜切太小，煮化在汤里。，锅温要匀，细节才到位。",
    "一次倒足鱼露，咸得发苦。，盖盖焖一会儿，食材才不糊。",
    "香菜早放，颜色变黄。，别急着加油，风味才干净。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "冬瓜",
      "ratio": "400 克:400 克",
      "note": "出水更多，煮制时间减三分钟。"
    },
    {
      "original": "香菇",
      "substitute": "平菇",
      "ratio": "150 克:150 克",
      "note": "撕条更易入味，煮制时间不变。"
    }
  ],
  "variations": [
    "加几只虾仁，鲜味更足。，盖盖焖一会儿，咸淡才好把握。",
    "加罗勒叶，香气更浓。，下手别慌，口感才不发柴。"
  ],
  "serving_suggestion": "配米饭，当作一道清爽的汤菜。，汤汁别收太干，香气才留得住。",
  "storage": "冷藏两天，复热后再加香菜。，汤汁别收太干，吃口才舒服。",
