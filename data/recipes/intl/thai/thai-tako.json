        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "小杯",
    "打蛋器",
    "蒸锅",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "木薯粉过筛后加清水搅成无颗粒的稀浆，静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛这一步别省，颗粒留在浆里蒸出来会有硬芯。",
      "visual_cue": "浆液顺滑，勺背挂薄薄一层"
    },
    {
      "n": 2,
      "text": "椰奶三百毫升加白糖与盐小火加热，搅到糖化开即离火。",
      "time_min": 6,
      "heat": "小火",
      "tip": "椰奶不能煮沸，边缘冒小泡就关火，否则会分层。",
      "visual_cue": "糖完全融化，椰奶微温不烫手"
    },
    {
      "n": 3,
      "text": "把温椰奶慢慢倒进木薯浆里，边倒边搅，再加入玉米粒拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一定要慢慢倒并持续搅，一次性倒入会结块。",
      "visual_cue": "浆液均匀无结块，玉米粒分布匀"
    },
    {
      "n": 4,
      "text": "浆液分装进小杯，蒸锅上汽后中火蒸十五分钟至完全透明。",
      "time_min": 15,
      "heat": "中火",
      "tip": "蒸到中心透明才算熟，中间发白说明火候不够。",
      "visual_cue": "表面平整透亮，轻晃有弹性"
    },
    {
      "n": 5,
      "text": "取出放凉，淋上剩余椰奶撒椰蓉，冷藏半小时后食用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "放凉再淋椰奶，热的时候淋会混成一团。",
      "visual_cue": "糕体成型不塌，椰奶浮在表面"
    }
  ],
  "tips": [
    "木薯粉一定要买纯的，掺了别的粉就蒸不出透明感。",
    "椰奶加热时别走开，边缘一冒泡就要离火。",
    "玉米粒先煮熟再拌，生玉米蒸十五分钟不够熟。",
    "冷藏后口感更弹，但不要超过一天，会返生变硬。"
  ],
  "common_mistakes": [
    "浆液没过筛，蒸出来带白色硬粒，口感发渣。",
    "椰奶煮沸后倒进浆里，直接结成一坨疙瘩。",
    "蒸的时间不足，切开中心还是白浆状态。",
    "热着就淋椰奶，表面糊成一片看不出层次。"
  ],
  "substitutions": [
    {
      "original": "木薯粉",
      "substitute": "糯米粉",
      "ratio": "120克:110克",
      "note": "口感更糯，蒸的时间减两分钟。"
    },
    {
      "original": "玉米",
      "substitute": "芋头丁",
      "ratio": "150克:150克",
      "note": "需先蒸熟再拌入，口感更绵。"
    }
  ],
  "variations": [
    "加一勺斑斓汁，糕体带天然绿色与清香。",
    "表面撒烤芝麻代替椰蓉，香气更浓。",
    "做成大块蒸熟再切件，是市集常见的切糕形态。"
  ],
  "serving_suggestion": "冷藏后一人一杯，配一杯热茶，甜而不腻，是泰式甜品摊的经典组合。",
  "storage": "冷藏可放一天，加盖防串味；返生变硬后可蒸三分钟回软，不建议冷冻。",
