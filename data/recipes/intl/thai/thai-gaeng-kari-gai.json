      ]
    }
  ],
  "equipment": [
    "炒锅",
    "木铲",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成四厘米见方的块，用厨房纸吸干表面水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "带皮鸡腿肉煎出油更香，别去皮。",
      "visual_cue": "鸡块大小均匀、表面干爽"
    },
    {
      "n": 2,
      "text": "土豆削皮切滚刀块，泡在清水里洗去表面淀粉后沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洗掉淀粉汤才不会浑，土豆也不易粘锅。",
      "visual_cue": "土豆块棱角分明、水清不浑"
    },
    {
      "n": 3,
      "text": "炒锅放植物油中小火，下黄咖喱酱炒两分钟至香气散出、油色变红。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "咖喱酱必须用油炒开，直接下水会结块发苦。",
      "visual_cue": "油面泛红、咖喱香浓"
    },
    {
      "n": 4,
      "text": "倒入一半椰浆继续搅炒三分钟，直到油水分离、表面浮出红油。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "椰浆炒到出油，咖喱的香气才彻底释放。",
      "visual_cue": "表面析出红油、酱体浓稠"
    },
    {
      "n": 5,
      "text": "下鸡块翻炒到表面变色，加清水和棕榈糖，中火炖十分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "棕榈糖提前碾碎，整块很难化开。",
      "visual_cue": "鸡块转白、汤面微沸"
    },
    {
      "n": 6,
      "text": "加入土豆和洋葱再炖十分钟，直到土豆能用筷子轻松插入。",
      "time_min": 12,
      "heat": "中火",
      "tip": "土豆后放，久炖会化成泥糊在锅底。",
      "visual_cue": "土豆软透、洋葱透明"
    },
    {
      "n": 7,
      "text": "倒入剩下的椰浆和鱼露搅匀，小火煮两分钟即关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椰浆最后放才不会油水分离，汤色也更白。",
      "visual_cue": "汤汁奶黄顺滑、香味浓郁"
    }
  ],
  "tips": [
    "黄咖喱酱比红绿咖喱温和，怕辣的可以少放一半。",
    "鸡腿肉换成鸡翅根也行，炖煮时间加五分钟。",
    "椰浆选浓稠型，摇匀后再倒，避免分层。"
  ],
  "common_mistakes": [
    "咖喱酱没炒开就加水，成品结块、香味寡淡。",
    "椰浆一次性全倒进去久煮，油水分离汤色发灰。",
    "土豆一开始就下锅，炖到最后全化在汤里。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "450g 对 450g",
      "note": "鸡胸易柴，炖煮时间减五分钟。"
    },
    {
      "original": "棕榈糖",
      "substitute": "白糖",
      "ratio": "10g 对 8g",
      "note": "甜味更直接，鱼露可略减。"
    }
  ],
  "variations": [
    "加两片柠檬叶和少许罗望子汁，酸香更立体。",
    "加一把小番茄同炖，果酸解腻颜色也更亮。"
  ],
  "serving_suggestion": "配泰国香米饭或烙饼蘸汁，旁边放几片黄瓜解辣。",
  "storage": "冷藏两天，冷冻一个月；复热加少许椰浆稀释再煮开。",
