  "steps": [
    {
      "n": 1,
      "text": "米粉用温水泡十五分钟到软，剪成两段。，看准状态再往下做。",
      "time_min": 17,
      "heat": "无火",
      "tip": "剪短一点，夹起来才方便。，看准状态再往下做。",
      "visual_cue": "粉条柔软，长短均匀"
    },
    {
      "n": 2,
      "text": "虾从背部剖开挑出虾线，保留尾部。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "开背更入味，蒸后也好看。，看准状态再往下做。",
      "visual_cue": "虾身展开，尾部完整"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，小火炒香蒜末和姜丝。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜末别炒焦，蒸后才香不苦。，看准状态再往下做。",
      "visual_cue": "蒜末微黄，香气散出"
    },
    {
      "n": 4,
      "text": "加酱油、鱼露、白糖、白胡椒和清水煮开。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汁要先煮开，味道才融合。，看准状态再往下做。",
      "visual_cue": "汁面翻滚，香气复合"
    },
    {
      "n": 5,
      "text": "米粉铺盘底，淋一半汁拌匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "米粉先吸汁，蒸后才入味。，看准状态再往下做。",
      "visual_cue": "粉条松散，汁色浅褐"
    },
    {
      "n": 6,
      "text": "虾开背朝上摆在米粉上，淋剩余汁。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "虾别叠放，受热才均匀。，看准状态再往下做。",
      "visual_cue": "虾身平铺，尾部翘起"
    },
    {
      "n": 7,
      "text": "蒸锅水开后大火蒸七分钟。，看准状态再往下做。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水开再上锅，虾肉才嫩。，看准状态再往下做。",
      "visual_cue": "虾身变红，米粉透明"
    },
    {
      "n": 8,
      "text": "出锅撒香菜段和小米椒圈，趁热吃。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，颜色才鲜。，看准状态再往下做。",
      "visual_cue": "香气上涌，粉条油亮"
    }
  ],
  "tips": [
    "米粉先淋汁拌，蒸后才入味。，这一点很关键。",
    "水开再上锅，虾肉才不老。，这一点很关键。",
    "虾开背朝上摆，形状好看也易熟。，这一点很关键。"
  ],
  "common_mistakes": [
    "冷水上锅蒸，虾肉发柴。，这一点很关键。",
    "米粉不泡透，蒸完还是硬的。，这一点很关键。",
    "蒜末炒焦，整盘带苦味。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鱿鱼",
      "ratio": "400 克:400 克",
      "note": "切圈蒸五分钟即可。"
    },
    {
      "original": "米粉",
      "substitute": "面条",
      "ratio": "150 克:150 克",
      "note": "需先煮半熟，蒸六分钟。"
    }
  ],
  "variations": [
    "加一块五花肉同蒸，油香更足。，这一点很关键。",
    "用砂锅代替蒸盘，收汁更浓。，这一点很关键。"
  ],
  "serving_suggestion": "连盘上桌，配一碗白饭。，这一点很关键。",
  "storage": "当日吃完，隔夜粉丝会发硬。，这一点很关键。",
