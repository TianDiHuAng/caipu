    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾 400g 沿背部划开挑去虾线，用清水冲净后用厨房纸吸干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "虾线去净，腥味才彻底消失。",
      "visual_cue": "虾干爽、背缝清晰"
    },
    {
      "n": 2,
      "text": "吸干的虾加 2g 盐抓匀腌 5 分钟，罗勒叶摘下洗净沥干备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腌一下虾肉更紧实弹牙。",
      "visual_cue": "虾表面微黏、罗勒叶干爽"
    },
    {
      "n": 3,
      "text": "炒锅倒 35ml 植物油烧至七成热，下虾大火煎 90 秒至边缘转红，盛出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "虾先煎定型，回锅才不会出水。",
      "visual_cue": "虾卷曲、两面转红"
    },
    {
      "n": 4,
      "text": "原锅留底油，下蒜末、洋葱丝与干辣椒段，中火炒 2 分钟至香味散出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蒜末别炒到发黑，微黄就够。",
      "visual_cue": "洋葱透明、锅中香气浓"
    },
    {
      "n": 5,
      "text": "倒回虾，加 20ml 鱼露、10ml 生抽与 6g 白糖，大火快速翻炒 1 分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "调味后动作要快，虾肉才不老。",
      "visual_cue": "酱汁裹匀、虾油亮"
    },
    {
      "n": 6,
      "text": "关火放入罗勒叶，用余温翻拌至叶片微微萎缩即可装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "罗勒关火再放，香气最足。",
      "visual_cue": "罗勒叶翠绿微塌、香气冲鼻"
    }
  ],
  "tips": [
    "虾先煎定型再回锅，肉质才紧实不出水。",
    "罗勒必须关火后再放，高温久炒会发黑。",
    "虾腌 5 分钟就够，腌久会流失水分变柴。"
  ],
  "common_mistakes": [
    "虾带水下锅，锅里瞬间出水变成白煮虾。",
    "干辣椒炒到焦黑，整盘菜带着焦糊味。",
    "罗勒早早下锅，出锅时叶子全黑了。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "虾仁",
      "ratio": "400g 对 400g",
      "note": "已去壳的虾仁更省事，煎制时间减 30 秒。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "20ml 对 18ml",
      "note": "鲜味稍弱，糖可加 2g。"
    }
  ],
  "variations": [
    "九层塔版：用九层塔替换罗勒，香气更冲。",
    "椰浆版：起锅前加 50ml 椰浆增润。"
  ],
  "serving_suggestion": "配白米饭装盘，旁边放一碟辣椒鱼露蘸食。",
  "storage": "现做现吃，冷藏后再热虾肉会变韧。",
