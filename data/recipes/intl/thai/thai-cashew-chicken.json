  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成两厘米见方的块，加一半生抽与少许植物油抓匀腌十分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腌过的鸡肉炒后更嫩。",
      "visual_cue": "鸡块裹上酱色、表面微黏"
    },
    {
      "n": 2,
      "text": "生腰果放冷锅冷油里小火慢炸到浅金黄，捞出摊开晾凉保持酥脆。",
      "time_min": 5,
      "heat": "小火",
      "tip": "颜色略浅就要捞，余温会继续加深。",
      "visual_cue": "腰果浅金黄、有香味"
    },
    {
      "n": 3,
      "text": "炒锅大火烧热，鸡块摊平煎到两面金黄、边缘微焦，盛出备用。",
      "time_min": 4,
      "heat": "大火",
      "tip": "摊平别翻动，才能煎出焦壳。",
      "visual_cue": "鸡块金黄、边缘焦香"
    },
    {
      "n": 4,
      "text": "原锅下洋葱与青椒大火翻炒，加蒜末与小米椒炒出香气。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蔬菜保持脆度，别炒过头。",
      "visual_cue": "洋葱半透明、青椒色亮"
    },
    {
      "n": 5,
      "text": "鸡块回锅，加剩余生抽、蚝油与白糖快速翻匀，最后撒大葱段与腰果。",
      "time_min": 4,
      "heat": "大火",
      "tip": "腰果最后放，早放会回软。",
      "visual_cue": "酱汁裹匀、腰果完整"
    }
  ],
  "tips": [
    "腰果冷油下锅慢炸，直接热油炸外焦内生。",
    "鸡块腌十分钟再炒，肉质更嫩也更入味。",
    "腰果最后十秒才下锅，久炒会吸汁回软。"
  ],
  "common_mistakes": [
    "腰果炸到深褐色才捞，凉后发苦。",
    "蔬菜炒到出水发软，整道菜失了脆感。",
    "鸡肉带着水分下锅，煎成水煮不结焦壳。"
  ],
  "substitutions": [
    {
      "original": "腰果",
      "substitute": "花生",
      "ratio": "80g 对 80g",
      "note": "先去皮更香。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "350g 对 350g",
      "note": "腌时多加 5ml 油，避免发干。"
    }
  ],
  "variations": [
    "素食版：鸡腿换成 200g 老豆腐与 100g 杏鲍菇。",
    "重辣版：小米椒加倍，另加 10g 辣椒酱。"
  ],
  "serving_suggestion": "配一碗泰国香米饭，把酱汁拌进饭里吃。",
  "storage": "冷藏可存 1 天，复热用炒锅大火，勿用微波炉加热腰果。",
