    "烤架",
    "保鲜袋"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪颈肉顺纹切两厘米厚片，用厨房纸吸干表面水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "表面擦干腌料才挂得住，也更容易烤出焦边。",
      "visual_cue": "肉片表面干爽不渗水"
    },
    {
      "n": 2,
      "text": "香茅拍扁切段，蒜拍碎，香菜根切碎，青柠挤汁备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香菜根是泰式腌料的香气来源，别丢掉。",
      "visual_cue": "香料碎末均匀、青柠汁清亮"
    },
    {
      "n": 3,
      "text": "鱼露、棕榈糖、椰浆、生抽和白胡椒粉倒进碗里搅到糖完全溶化。",
      "time_min": 3,
      "heat": "无火",
      "tip": "棕榈糖要碾碎再放，整块很难化开。",
      "visual_cue": "腌汁顺滑、无糖粒沉底"
    },
    {
      "n": 4,
      "text": "肉片与腌汁、香茅、蒜、香菜根一起装入保鲜袋，揉匀后冷藏腌一小时。",
      "time_min": 60,
      "heat": "无火",
      "tip": "隔着袋子揉两分钟，腌一小时能顶两小时。",
      "visual_cue": "肉片均匀裹满腌汁"
    },
    {
      "n": 5,
      "text": "烤箱上下火两百度预热十分钟，烤盘铺锡纸、架烤网。",
      "time_min": 10,
      "heat": "无火",
      "tip": "预热到位肉片才能瞬间封住表面，汁水不流失。",
      "visual_cue": "烤箱指示灯灭、内部高温"
    },
    {
      "n": 6,
      "text": "肉片平铺在烤网上烤十分钟，翻面再烤六分钟至边缘焦褐。",
      "time_min": 16,
      "heat": "中火",
      "tip": "铺得太挤会焖出水汽，烤不出焦香边。",
      "visual_cue": "边缘焦褐、表面油亮"
    },
    {
      "n": 7,
      "text": "出炉静置两分钟再切条，淋青柠汁、撒香菜叶装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置两分钟让肉汁回收，切时才不流汁。",
      "visual_cue": "切面湿润不流血水"
    }
  ],
  "tips": [
    "猪颈肉又叫梅花颈，肥瘦相间，烤后脆嫩不柴，别换成纯瘦的里脊。",
    "没有烤网可用平底锅干煎，中火每面三分半，效果接近。",
    "蘸酱用糯米粉炒香加鱼露、青柠和辣椒粉调成，最搭这道肉。"
  ],
  "common_mistakes": [
    "腌料里的棕榈糖没化开，烤后局部发苦。",
    "肉片切得太薄，烤完失水变干硬。",
    "烤完立刻切片，肉汁全流失，切面发白发干。"
  ],
  "substitutions": [
    {
      "original": "猪颈肉",
      "substitute": "五花肉",
      "ratio": "500g 对 450g",
      "note": "五花出油多，烤制时下面垫烤盘接油。"
    },
    {
      "original": "棕榈糖",
      "substitute": "红糖",
      "ratio": "15g 对 12g",
      "note": "红糖甜味更重，鱼露可略减。"
    }
  ],
  "variations": [
    "腌料加一勺红咖喱酱，做成咖喱风味烤猪颈肉。",
    "用炭火烤代替烤箱，焦香更足，注意翻面防焦。"
  ],
  "serving_suggestion": "切片配糯米饭店与生菜、薄荷叶包食。",
  "storage": "冷藏三天，复热用烤箱两百度六分钟，避免微波失脆。",
