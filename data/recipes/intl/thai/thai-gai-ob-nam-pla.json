  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用刀背在厚肉处划两刀，让厚度接近一致便于均匀受热。",
      "time_min": 5,
      "heat": "无火",
      "tip": "厚肉处划刀是为了烤时不夹生，别划破鸡皮。",
      "visual_cue": "鸡腿肉展开平整，皮面完整"
    },
    {
      "n": 2,
      "text": "香菜根切碎，与大蒜末、白胡椒、鱼露、椰糖一起调成腌料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香菜根香味最浓，千万别只留叶子丢掉根。",
      "visual_cue": "腌料呈深褐液体，蒜末分布均匀"
    },
    {
      "n": 3,
      "text": "把腌料抹遍鸡腿肉并轻揉两分钟，静置十五分钟后擦掉表面蒜末。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蒜末一定要擦掉，留在表面烤会发黑发苦。",
      "visual_cue": "鸡肉表面着色均匀，无浮水"
    },
    {
      "n": 4,
      "text": "烤箱预热到两百度，鸡皮朝上放烤架，刷植物油烤十五分钟。",
      "time_min": 15,
      "heat": "中火",
      "tip": "鸡皮朝上才能烤出脆皮，中途刷一次油防干。",
      "visual_cue": "鸡皮金黄收紧，油脂析出滴落"
    },
    {
      "n": 5,
      "text": "翻面再烤八分钟至中心熟透，出炉挤青柠汁撒柠檬叶丝即可。",
      "time_min": 8,
      "heat": "中火",
      "tip": "最后挤青柠汁能提亮咸味，别在烤前挤。",
      "visual_cue": "鸡皮焦脆，切面无粉红色血水"
    }
  ],
  "tips": [
    "鱼露本身极咸，腌料里不要再额外加盐。",
    "没有烤箱可用平底锅小火煎，两面各煎六分钟效果相近。",
    "椰糖别省，它能把鱼露的咸拉圆润，缺了就死咸。",
    "香菜叶留到最后切碎撒面，烤过就发黄发黑。"
  ],
  "common_mistakes": [
    "腌料蒜末没擦掉就进烤箱，表面焦黑带苦味。",
    "鸡腿直接大火烤，皮焦了里面还是生的。",
    "腌了一整夜，肉质被盐分析水，烤出来又干又柴。",
    "烤完立刻切，肉汁全流失，盘底一汪水。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600克:500克",
      "note": "更瘦，烤的时间减五分钟。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "30毫升:25毫升",
      "note": "咸度略低，风味少一层鲜。"
    }
  ],
  "variations": [
    "腌料里加一勺椰奶，烤出来表皮更润。",
    "用炭火烤代替烤箱，带一层烟熏香，更接近街边摊。",
    "剩下的腌料加水煮开当蘸汁，配糯米一起吃。"
  ],
  "serving_suggestion": "斩成大块装盘，配糯米团与青柠角，街边常见配一碟辣酱同吃。",
  "storage": "冷藏可放两天，复热用烤箱一百八十度烤六分钟，微波会让鸡皮变韧。",
