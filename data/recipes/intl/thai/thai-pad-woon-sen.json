  "steps": [
    {
      "n": 1,
      "text": "粉丝放进冷水里泡到变软，捞出剪成十厘米长的段。",
      "time_min": 12,
      "heat": "无火",
      "tip": "粉丝只用冷水泡，热水泡过一炒就断。",
      "visual_cue": "粉丝柔韧可弯，长度整齐"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，豆芽洗净沥干，小葱切段，蒜切成末。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆芽一定沥干水，下锅才不出汤变软。",
      "visual_cue": "蛋液均匀，豆芽干爽"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，倒入蛋液炒成蛋块盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋炒到刚凝固就盛出，回锅时才不会老。",
      "visual_cue": "蛋块金黄蓬松，不散不碎"
    },
    {
      "n": 4,
      "text": "原锅下蒜末小火炒香，放粉丝加鱼露酱油白糖翻炒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "粉丝下锅用筷子挑散，铲子容易把它压断。",
      "visual_cue": "粉丝上色均匀，根根分明"
    },
    {
      "n": 5,
      "text": "倒回蛋块，加豆芽和小葱段大火快速翻炒均匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆芽下去只炒半分钟，久了就出水发软。",
      "visual_cue": "豆芽脆挺，粉丝透亮"
    },
    {
      "n": 6,
      "text": "沿锅边淋清水激出香气，关火挤入青柠汁拌匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "青柠汁一定关火后挤，久煮清香全跑光。",
      "visual_cue": "酸香清亮，盘底干爽"
    }
  ],
  "tips": [
    "粉丝用冷水泡软，炒的时候才不断不粘。",
    "青柠汁关火后再挤，酸香清爽不发苦。",
    "全程大火快炒，豆芽保持脆感才好吃。"
  ],
  "common_mistakes": [
    "粉丝用热水泡，下锅一炒就断成碎渣。",
    "青柠汁早下锅同炒，酸味发闷不清爽。",
    "豆芽没沥干就下锅，炒出一盘水汪汪。"
  ],
  "substitutions": [
    {
      "original": "粉丝",
      "substitute": "米粉",
      "ratio": "240 克:240 克",
      "note": "口感更弹，泡发时间需延长五分钟。"
    },
    {
      "original": "鱼露",
      "substitute": "酱油",
      "ratio": "20 毫升:20 毫升",
      "note": "不腥偏咸香，白糖可再加三克。"
    }
  ],
  "variations": [
    "加几只虾仁同炒，鲜味更足更饱满。",
    "撒一把熟花生碎，口感更有层次。"
  ],
  "serving_suggestion": "趁热吃最香，配青柠角和辣椒粉按口味调整。",
  "storage": "冷藏一天，复热加少许清水大火抖炒。",
