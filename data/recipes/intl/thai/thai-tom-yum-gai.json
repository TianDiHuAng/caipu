  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅倒植物油，小火把香茅、南姜和柠檬叶炒香，再倒清水煮五分钟。",
      "time_min": 8,
      "heat": "大火",
      "tip": "香草先煮，汤底的香气才出得来。，火大了就离锅远一点。",
      "visual_cue": "汤面翻滚，香气上涌"
    },
    {
      "n": 2,
      "text": "下口蘑和番茄块，中火煮三分钟。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蘑菇先煮，汤才鲜。，锅温要匀，别忽高忽低。",
      "visual_cue": "口蘑变软，番茄起皮"
    },
    {
      "n": 3,
      "text": "鸡胸肉片用筷子一片片抖散下锅，别粘成团。",
      "time_min": 3,
      "heat": "中火",
      "tip": "抖散下锅，肉片才嫩不成坨。，火力保持中等，慢慢来。",
      "visual_cue": "肉片散开，颜色转白"
    },
    {
      "n": 4,
      "text": "加冬阴功酱搅开，小火煮八分钟。，火候宁小勿大，慢慢推进。",
      "time_min": 9,
      "heat": "小火",
      "tip": "酱要搅散，汤色才均匀。，注意锅里温度别掉下来。",
      "visual_cue": "汤色转橙红，香气浓"
    },
    {
      "n": 5,
      "text": "加鱼露和白糖调味，尝一次咸淡。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "鱼露咸，白糖只用来平衡酸味。，火要均匀，食材才不糊。",
      "visual_cue": "汤味鲜咸，微带回甜"
    },
    {
      "n": 6,
      "text": "关火后挤入青柠汁，搅匀再盛。，看住火，别让它失控。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠关火挤，酸香才清不苦。，全程留意火候，别贪快。",
      "visual_cue": "汤面微绿，酸香扑鼻"
    },
    {
      "n": 7,
      "text": "盛碗撒香菜？没有香菜就用柠檬叶丝点缀。，火大了就离锅远一点。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬叶丝切细，香气更清。，火别开太大，稳着来。",
      "visual_cue": "表面浮叶，汤色红亮"
    }
  ],
  "tips": [
    "青柠汁关火再挤，酸香才清。，别嫌麻烦，做完它。",
    "香茅拍扁再切，香气才出。，这一步别省。",
    "鸡肉抖散下锅，肉片才嫩。，别跳过这步。"
  ],
  "common_mistakes": [
    "青柠汁煮开，汤发苦。，这步最关键。",
    "鸡肉整块下锅，外面老里面生。，很多人在这里出错。",
    "香草煮太久，汤发涩。，这里最容易翻车。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "虾",
      "ratio": "350 克:350 克",
      "note": "虾变红即熟，煮的时间减半。"
    },
    {
      "original": "冬阴功酱",
      "substitute": "红咖喱酱",
      "ratio": "50 克:40 克",
      "note": "辣度更高，白糖可多加。"
    }
  ],
  "variations": [
    "加淡奶，做成浓汤版本。，别小看这一步。",
    "加河粉，变成一碗汤面。，成败就在这一步。"
  ],
  "serving_suggestion": "配白饭，汤和饭分开盛。，这点要注意。",
  "storage": "冷藏两天，复热不再加青柠。，这是关键点。",
