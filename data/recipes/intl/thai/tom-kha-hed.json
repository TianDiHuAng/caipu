  "equipment": [
    "汤锅",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香茅 2 根拍扁后切成 5 厘米段，南姜 20g 切成厚片，干辣椒 3 个拍破备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香茅拍扁再切，香气才出得来。",
      "visual_cue": "香茅纤维松散、香气明显"
    },
    {
      "n": 2,
      "text": "汤锅倒入 500ml 清水，放香茅、南姜与干辣椒，大火煮开后转小火煮 8 分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "先煮香料水，汤底才有层次。",
      "visual_cue": "汤色微黄、香气扑鼻"
    },
    {
      "n": 3,
      "text": "蘑菇 300g 撕成小块放入汤中，小火煮 5 分钟至变软出汁。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蘑菇撕比切更挂汤汁。",
      "visual_cue": "蘑菇软塌、体积明显缩小"
    },
    {
      "n": 4,
      "text": "倒入 400ml 椰浆，小火加热至锅边冒小泡，注意不要煮沸。",
      "time_min": 4,
      "heat": "小火",
      "tip": "椰浆煮沸会油水分离。",
      "visual_cue": "汤色乳白、表面微冒热气"
    },
    {
      "n": 5,
      "text": "加 25ml 鱼露、8g 白糖与 2g 盐搅匀，关火后挤入 2 个青柠的汁。",
      "time_min": 3,
      "heat": "小火",
      "tip": "青柠汁关火后加，酸香才不散。",
      "visual_cue": "汤味酸辣平衡、椰香浓"
    },
    {
      "n": 6,
      "text": "盛入预热过的碗中，撒上香菜碎即可趁热上桌食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，颜色才翠绿。",
      "visual_cue": "汤面浮香菜、颜色乳白"
    }
  ],
  "tips": [
    "椰浆不要煮沸，否则会油水分离影响口感。",
    "青柠汁必须关火后再加，久煮酸香会挥发。",
    "香茅和南姜只取味，喝汤时可以挑出不吃。"
  ],
  "common_mistakes": [
    "椰浆大火滚煮，汤面浮起一层油花且分层。",
    "青柠汁过早放入汤中，酸味挥发后只剩苦涩。",
    "鱼露放太多，整锅汤咸得盖住椰香。"
  ],
  "substitutions": [
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "25ml 对 20ml",
      "note": "鲜味略淡，需加 2g 盐。"
    },
    {
      "original": "蘑菇",
      "substitute": "草菇",
      "ratio": "300g 对 300g",
      "note": "草菇需先焯水去涩。"
    }
  ],
  "variations": [
    "海鲜版：加 150g 虾仁同煮 3 分钟。",
    "素食版：鱼露换酱油并加 10g 香菇粉。"
  ],
  "serving_suggestion": "配茉莉香米饭，旁边放一小碟辣椒鱼露。",
  "storage": "冷藏 2 天，复热时小火加热不要煮沸。",
