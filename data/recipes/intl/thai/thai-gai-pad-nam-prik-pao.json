  "equipment": [
    "炒锅",
    "小碗",
    "铲子",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干辣椒剪段去籽，用干锅小火烘两分钟，放凉后捣成粗末。",
      "time_min": 5,
      "heat": "小火",
      "tip": "辣椒烘到颜色变深就起锅，烘黑了整锅辣酱会带焦苦味。",
      "visual_cue": "辣椒干脆发亮，颜色转深红"
    },
    {
      "n": 2,
      "text": "辣椒末与红糖、一半鱼露、蒜末拌成辣酱，静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "红糖要用粉状的，块状化不开，辣酱里会有砂粒感。",
      "visual_cue": "辣酱黏稠挂勺，颜色暗红发亮"
    },
    {
      "n": 3,
      "text": "鸡腿肉切一口大小，用剩下的鱼露与生抽抓匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鸡肉块切均匀，大小不一下锅后小的老大的生。",
      "visual_cue": "鸡块大小一致，表面挂汁"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒橄榄油，下洋葱瓣与辣酱小火炒出红油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣酱含糖，必须小火慢炒，火大了三十秒就发黑发苦。",
      "visual_cue": "油色转红，香气带甜辣"
    },
    {
      "n": 5,
      "text": "下鸡块大火翻炒到上色熟透，加青椒、罗勒与青柠汁翻匀出锅。",
      "time_min": 6,
      "heat": "大火",
      "tip": "青柠汁关火前再挤，早放酸味被煮散，只剩涩口。",
      "visual_cue": "鸡块红亮，罗勒叶刚塌软"
    }
  ],
  "tips": [
    "辣酱炒鸡的关键是辣酱炒出红油，颜色红亮才算到位。",
    "配糯米饭吃最地道，泰国东北部都是这么搭配。",
    "想要更香可以加一勺椰奶，辣味会柔和许多。"
  ],
  "common_mistakes": [
    "辣酱大火炒，糖瞬间焦化，整盘菜发苦发黑。",
    "鸡块切太大，外面裹满酱里面还没熟。",
    "青柠汁一开始就下锅，酸味煮没了，菜只剩甜辣。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "猪里脊",
      "ratio": "400克:400克",
      "note": "猪肉版炒制时间减两分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "辣椒粉",
      "ratio": "6克:5克",
      "note": "辣椒粉直接拌酱，不用烘炒。"
    }
  ],
  "variations": [
    "加一把腰果同炒，口感更丰富，是餐馆常见版本。",
    "用虾仁替代鸡肉，做成辣酱炒虾，炒制时间减半。"
  ],
  "serving_suggestion": "配糯米饭和一份凉拌黄瓜，辣得够劲时喝口冰水。",
  "storage": "冷藏可存一天，复热用大火快炒，中途不要加水会变淡。",
