  "equipment": [
    "炒锅",
    "锅铲",
    "刷子",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "螃蟹 900g 用刷子刷净壳缝，揭盖去掉鳃和胃袋，斩成带钳的块状。",
      "time_min": 15,
      "heat": "无火",
      "tip": "鳃和胃袋必须去净，腥味都在这。",
      "visual_cue": "蟹块干净、切口整齐"
    },
    {
      "n": 2,
      "text": "蟹块切面拍一层薄薄的面粉，抖掉多余的粉备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拍粉能锁住蟹肉水分。",
      "visual_cue": "切面均匀挂粉、不结块"
    },
    {
      "n": 3,
      "text": "炒锅倒 40ml 植物油烧至七成热，蟹块切面朝下煎 2 分钟至定型金黄，盛出。",
      "time_min": 5,
      "heat": "大火",
      "tip": "切面先煎，蟹肉才不散。",
      "visual_cue": "切面金黄、蟹壳转红"
    },
    {
      "n": 4,
      "text": "原锅留底油，下洋葱丝与蒜末炒香，加 10g 咖喱粉小火炒 40 秒。",
      "time_min": 4,
      "heat": "小火",
      "tip": "咖喱粉小火炒，火大立刻发苦。",
      "visual_cue": "油色变黄、咖喱香浓"
    },
    {
      "n": 5,
      "text": "放回蟹块翻炒，加 100ml 清水、20ml 鱼露、8g 白糖与 3g 盐，加盖焖 5 分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "焖到蟹壳全红，蟹肉才熟透。",
      "visual_cue": "蟹壳通红、汤汁浓稠"
    },
    {
      "n": 6,
      "text": "转小火淋入打散的鸡蛋液，快速推炒成蛋花裹住蟹块，撒小葱段与香菜出锅。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋液小火推，才成滑嫩蛋花。",
      "visual_cue": "蛋花滑嫩、均匀挂在蟹壳上"
    }
  ],
  "tips": [
    "蟹鳃和胃袋必须去净，这是腥味的主要来源。",
    "鸡蛋液最后小火推炒，蛋花才滑嫩不结块。",
    "蟹块切面拍粉再煎，蟹肉更紧实多汁。"
  ],
  "common_mistakes": [
    "蟹块不拍粉直接煎，蟹肉流失水分变干。",
    "咖喱粉大火爆炒，整锅带着焦苦味。",
    "蛋液大火下锅，瞬间结成硬块，口感发柴难以下咽。"
  ],
  "substitutions": [
    {
      "original": "螃蟹",
      "substitute": "花蟹",
      "ratio": "900g 对 900g",
      "note": "肉质更甜，焖制时间减 1 分钟。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "20ml 对 18ml",
      "note": "鲜味略淡，盐可加 1g。"
    }
  ],
  "variations": [
    "椰浆版：加 150ml 椰浆同焖，酱汁更浓稠。",
    "黑胡椒版：起锅前撒 5g 现磨黑胡椒。"
  ],
  "serving_suggestion": "配白米饭，用蟹壳里的酱汁拌饭最香。",
  "storage": "现做现吃，冷藏后再热蟹肉会变柴。",
