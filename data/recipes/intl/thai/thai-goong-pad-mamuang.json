  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾开背去虾线，用厨房纸吸干水分，加生抽与淀粉抓匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "虾一定擦干再抓淀粉，否则下锅会出水发白。",
      "visual_cue": "虾表面挂薄浆，无滴水"
    },
    {
      "n": 2,
      "text": "炒锅倒入植物油，冷油下腰果小火慢炸到浅金黄，捞出摊开晾凉。",
      "time_min": 5,
      "heat": "小火",
      "tip": "冷油下锅腰果才酥，热油一炸外面焦里面软。",
      "visual_cue": "腰果浅金发亮，掰开断面白色"
    },
    {
      "n": 3,
      "text": "留底油中火下虾滑炒到卷曲变色，立即盛出控油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "虾七成熟就盛出，回锅再炒会老得像橡皮。",
      "visual_cue": "虾卷成弧形，表面泛粉红"
    },
    {
      "n": 4,
      "text": "下蒜末、洋葱与彩椒炒一分钟，加鱼露、椰糖与小米辣翻匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱只要断生，炒软了整道菜就少了脆口。",
      "visual_cue": "洋葱边缘透明，彩椒仍挺括"
    },
    {
      "n": 5,
      "text": "倒回虾与腰果，加小葱段大火翻三下，汤汁收紧即出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "腰果最后放，早放会吸汁变软失去脆感。",
      "visual_cue": "酱汁紧裹食材，锅底无积水"
    }
  ],
  "tips": [
    "腰果可用现成烤腰果，但要最后放，避免回软。",
    "虾要买大只的，缩水后还有口感。",
    "全程锅要够热，快炒才能保住虾的弹牙。",
    "喜欢甜口可多加一小勺椰糖，风味更接近曼谷版本。"
  ],
  "common_mistakes": [
    "虾没擦干就下锅，出水变成一锅白汤。",
    "腰果热油下锅，外面焦黑里面还是软的。",
    "虾炒到全熟再回锅，第二次加热后发柴。",
    "洋葱炒到发软出甜水，整道菜没了脆感。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡胸肉",
      "ratio": "400克:350克",
      "note": "切丁后同样滑炒，口味清淡一些。"
    },
    {
      "original": "腰果",
      "substitute": "花生",
      "ratio": "80克:80克",
      "note": "香气更浓，坚果过敏者均需避开。"
    }
  ],
  "variations": [
    "加一勺虾酱同炒，鲜味更重，是南部沿海的吃法。",
    "加菠萝块一起翻炒，酸甜感更强，孩子更爱吃。",
    "把虾换成鱿鱼圈，口感更弹，时间要缩短一分钟。"
  ],
  "serving_suggestion": "装盘后淋一圈锅里的酱汁，配香米饭，甜咸交错很下饭。",
  "storage": "冷藏可放一天，复热用炒锅大火一分钟；腰果复热后会变软，建议挑出另放。",
