    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾去虾线后切成小粒，加少许鱼露抓匀备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切小粒是为了每口都吃到虾，整只容易把蛋顶破。",
      "visual_cue": "虾段大小一致，表面微黏"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加鱼露、白胡椒与淀粉，搅到看不见蛋筋。",
      "time_min": 4,
      "heat": "无火",
      "tip": "加一点淀粉能让蛋皮更蓬松不易破，别加多。",
      "visual_cue": "蛋液均匀起细泡，颜色一致"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到微冒烟，下蒜末与洋葱碎炒香后放虾段。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油要够热蛋才会蓬，油温低了蛋会吸油发硬。",
      "visual_cue": "虾段转粉红卷曲，洋葱透明"
    },
    {
      "n": 4,
      "text": "倒入蛋液，等边缘凝固后用锅铲从外往内推，让生蛋液流到锅底。",
      "time_min": 5,
      "heat": "中火",
      "tip": "推而不是翻，蛋才会形成厚软的层次。",
      "visual_cue": "蛋体蓬起，表面还有少量湿液"
    },
    {
      "n": 5,
      "text": "撒葱花，盖盖焖一分钟至表面凝固，整块滑出装盘即可。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盖盖焖一分钟让表面定型，比翻面更嫩。",
      "visual_cue": "蛋面凝固无流动液，边缘微焦香"
    }
  ],
  "tips": [
    "锅要够热、油要够多，蛋才会蓬松不粘。",
    "虾先炒到半熟再倒蛋液，避免蛋熟了虾还生。",
    "鱼露本身已有足够咸味，不需要再额外加盐。",
    "想更香可以最后淋几滴香油，香气更浓。"
  ],
  "common_mistakes": [
    "油温不够就倒蛋液，蛋吸满油发硬又腻。",
    "一直大火猛炒，蛋碎成一小块一小块。",
    "虾整只下锅，蛋被顶破，成品不成形。",
    "蛋液没打匀，煎出来蛋白蛋黄一块块分层。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "猪颈肉",
      "ratio": "250克:200克",
      "note": "切薄片先炒熟，风味更足。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "15毫升:12毫升",
      "note": "咸度略低，鲜味也不同。"
    }
  ],
  "variations": [
    "加一把泰国罗勒同炒，香气更冲，是常见的变体。",
    "把虾换成蟹肉棒撕丝，成本更低也鲜。",
    "加两勺椰奶进蛋液，口感更滑更香。"
  ],
  "serving_suggestion": "整块蛋盖在热白饭上，配一碟辣酱与黄瓜片，泰式快餐的经典组合。",
  "storage": "冷藏可放一天，复热用炒锅小火两面各煎一分钟，微波会让蛋变韧。",
