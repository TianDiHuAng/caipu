  "steps": [
    {
      "n": 1,
      "text": "糯米用清水泡四小时以上，泡到手指一捻就碎，沥干后铺在纱布上。",
      "time_min": 240,
      "heat": "无火",
      "tip": "泡不透就蒸不糯。",
      "visual_cue": "米粒饱满、一捻即碎"
    },
    {
      "n": 2,
      "text": "蒸锅上汽后大火蒸二十分钟，中途翻动一次，让米粒熟得均匀。",
      "time_min": 5,
      "heat": "大火",
      "tip": "中途翻米，避免夹生。",
      "visual_cue": "米粒透明、粒粒分明"
    },
    {
      "n": 3,
      "text": "椰浆加白糖与盐小火加热到糖化开，不要煮沸，趁热分数次拌进热糯米。",
      "time_min": 25,
      "heat": "小火",
      "tip": "热米拌热浆，才吸得进去。",
      "visual_cue": "米粒吸浆发亮、质地黏糯"
    },
    {
      "n": 4,
      "text": "盖好静置十分钟让糯米吸足椰浆，盛盘配芒果片，撒炒香的白芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置十分钟，味道才匀。",
      "visual_cue": "米粒油亮、芒果清香"
    }
  ],
  "tips": [
    "糯米至少泡四小时，泡到一捏即碎蒸出来才够糯。",
    "椰浆加热到糖化开即可，煮沸会油水分离。",
    "糯米要趁热拌椰浆，冷米吸不进味道。"
  ],
  "common_mistakes": [
    "糯米只泡半小时，蒸出来硬芯夹生。",
    "椰浆煮沸后拌入，油水分层、米粒发干。",
    "拌好立刻吃，糯米还没吸味，甜得浮在表面。"
  ],
  "substitutions": [
    {
      "original": "芒果",
      "substitute": "菠萝",
      "ratio": "300g 对 300g",
      "note": "酸甜更明显。"
    },
    {
      "original": "椰浆",
      "substitute": "椰奶",
      "ratio": "300ml 对 300ml",
      "note": "稀薄，需延长收浆时间。"
    }
  ],
  "variations": [
    "紫米版：紫糯米与白糯米各 200g 同泡同蒸。",
    "咸口版：不加糖，配烤鸡与黄瓜同食。"
  ],
  "serving_suggestion": "配芒果厚片，淋一勺浓椰浆，撒白芝麻。",
  "storage": "冷藏可存 2 天，复热须蒸 8 分钟，勿微波。",
