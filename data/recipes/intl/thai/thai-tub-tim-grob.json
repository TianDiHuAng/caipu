          "name_en": "coconut milk",
          "amount": 300,
          "unit": "ml",
          "note": "浇面用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 50,
          "unit": "g",
          "note": "调甜",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 800,
          "unit": "ml",
          "note": "煮制用",
          "optional": false
        }
      ]
    },
    {
