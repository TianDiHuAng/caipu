        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "冰水盆",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "荸荠削掉外皮切成半厘米的小方丁，用厨房纸吸掉表面的水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切得大小一致，煮的时候才会同时熟透。",
      "visual_cue": "荸荠丁洁白透亮，表面没有水珠"
    },
    {
      "n": 2,
      "text": "把荸荠丁放进木薯粉里滚一圈，让每一颗都均匀裹上一层粉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "粉要裹得厚一点，煮出来才有一层脆壳。",
      "visual_cue": "每颗都裹满白粉，盆底不留干粉"
    },
    {
      "n": 3,
      "text": "清水倒进汤锅烧到滚沸，把裹好粉的荸荠丁分批下锅煮。",
      "time_min": 5,
      "heat": "大火",
      "tip": "一次别下太多，粘在一起就分不开了。",
      "visual_cue": "下锅后立刻浮起，水面保持翻滚"
    },
    {
      "n": 4,
      "text": "煮到外层粉壳变透明、整颗浮起，用漏勺捞出立刻放进冰水里。",
      "time_min": 10,
      "heat": "中火",
      "tip": "过冰水这一步决定外层脆不脆，千万别省。",
      "visual_cue": "外壳透明发亮，咬起来脆弹"
    },
    {
      "n": 5,
      "text": "椰奶加白糖与盐用小火加热，一边搅一边化开糖，微沸就关火。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰奶别煮到大滚，油脂分离会分层发渣。",
      "visual_cue": "椰奶温热浓稠，表面没有油花"
    },
    {
      "n": 6,
      "text": "把红宝石盛进碗里，浇上温椰奶，加碎冰后即可食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "现浇现吃最好，泡久了外层就不脆了。",
      "visual_cue": "红宝石半沉在奶白汤里，冰块透亮"
    }
  ],
  "tips": [
    "木薯粉用细一点的，裹出来外壳更均匀。",
    "荸荠换成凉薯口感更脆，甜味更淡。",
    "椰奶里加一片斑兰叶同煮，香气更明显。",
    "剩下的红宝石可以冷冻，吃前直接煮不用解冻。"
  ],
  "common_mistakes": [
    "荸荠带水下粉，粉结成硬块裹不均匀。",
    "一次全下锅，颗粒粘成一团变成粉疙瘩。",
    "椰奶大火煮开，油脂分离表面浮一层油。"
  ],
  "substitutions": [
    {
      "original": "荸荠",
      "substitute": "凉薯",
      "ratio": "250克:250克",
      "note": "质地更脆，甜味更淡，糖可略加。"
    },
    {
      "original": "木薯粉",
      "substitute": "糯米粉",
      "ratio": "80克:80克",
      "note": "外壳偏软，煮的时间要缩短一分钟。"
    }
  ],
  "variations": [
    "加几颗椰果或菠萝丁，口感层次更丰富。",
    "做成热食版本，椰奶煮滚后直接浇上去。"
  ],
  "serving_suggestion": "盛进玻璃碗里，红色的宝石泡在奶白的椰浆中格外好看，一勺下去脆弹带汁，冰凉清甜正好解腻。",
  "storage": "红宝石与椰奶分开冷藏可存两天，食用前再混合，泡在一起过夜外层就软了。",
