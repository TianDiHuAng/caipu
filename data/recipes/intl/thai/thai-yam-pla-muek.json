  "steps": [
    {
      "n": 1,
      "text": "鱿鱼洗净去掉内脏和软骨，切成半厘米宽的圈。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱿鱼圈切得均匀，受热时间才一致。",
      "visual_cue": "鱿鱼圈整齐，表面干净"
    },
    {
      "n": 2,
      "text": "汤锅烧开水，加几片姜，把鱿鱼圈放进去烫四十秒。",
      "time_min": 5,
      "heat": "大火",
      "tip": "一变色就捞，多烫十秒就变橡皮。，注意火候。",
      "visual_cue": "鱿鱼卷曲，颜色发白"
    },
    {
      "n": 3,
      "text": "马上捞出放进冰水里浸凉，让肉质收紧变脆。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冰水一激，鱿鱼口感才弹牙不韧。，注意火候。",
      "visual_cue": "鱿鱼冰透，质地紧实"
    },
    {
      "n": 4,
      "text": "小碗里挤入柠檬汁，加鱼露、白糖、蒜末和小米辣调匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先尝一下酸甜咸的平衡，再倒进沙拉里。",
      "visual_cue": "酱汁清澈，酸辣扑鼻"
    },
    {
      "n": 5,
      "text": "洋葱切丝用冷水泡五分钟去辛辣，芹菜切成小段。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱泡水后辛辣减轻，口感更清甜。",
      "visual_cue": "洋葱丝脆，芹菜翠绿"
    },
    {
      "n": 6,
      "text": "大碗里放鱿鱼、洋葱丝和芹菜段，倒入调好的酱汁拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "轻轻翻拌别用力压，鱿鱼才不被搅烂。",
      "visual_cue": "食材裹汁，颜色鲜亮"
    },
    {
      "n": 7,
      "text": "撒上香菜段，装盘后立刻上桌，趁脆吃口感最好。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后放，叶片才不会蔫掉。，注意火候。",
      "visual_cue": "香菜翠绿，汁水清亮"
    }
  ],
  "tips": [
    "鱿鱼烫四十秒就够，久了会变硬橡皮。",
    "烫好立刻过冰水，口感才弹牙爽脆。，值得留意。",
    "酱汁先尝后拌，酸甜咸才平衡。，值得留意。"
  ],
  "common_mistakes": [
    "鱿鱼煮两分钟以上，嚼起来完全咬不动。",
    "不泡冰水直接拌，肉质软塌没弹性。，务必避免。",
    "柠檬汁倒太多，整盘只尝得出酸味。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "虾仁",
      "ratio": "450 克:450 克",
      "note": "烫二十秒即可，口感更甜。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "60 克:60 克",
      "note": "酸香更清透，用量可减十克。"
    }
  ],
  "variations": [
    "加一把粉丝同拌，口感更丰富顶饱。，也很受欢迎。",
    "放少许香茅薄片，香气更有层次。，也很受欢迎。"
  ],
  "serving_suggestion": "趁着冰凉时上桌，配糯米饭和烤肉一起吃最解腻。",
  "storage": "冷藏一天，食用前补挤少许柠檬汁。，效果更稳定。",
