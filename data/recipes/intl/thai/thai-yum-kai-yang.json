  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "大碗",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉片成两片薄厚均匀的肉排，撒盐抹匀。，锅温要匀，别忽高忽低。",
      "time_min": 6,
      "heat": "无火",
      "tip": "片薄一点，煎的时候才受热均匀。，火力保持中等，慢慢来。",
      "visual_cue": "肉排厚薄一致，盐粒附着"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油烧热，下鸡胸肉中火煎。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "中火",
      "tip": "锅热再下肉，表面才封得住汁。，注意锅里温度别掉下来。",
      "visual_cue": "油面泛光，肉边转白"
    },
    {
      "n": 3,
      "text": "每面煎五分钟，到表面金黄、中心不透明。，始终中小火，别心急。",
      "time_min": 11,
      "heat": "中火",
      "tip": "别急着翻，一面定了再翻。，火要均匀，食材才不糊。",
      "visual_cue": "两面焦黄，按压有弹性"
    },
    {
      "n": 4,
      "text": "盛出静置五分钟，再切成条。，看住火，别让它失控。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置让肉汁回吸，切了才不流。，全程留意火候，别贪快。",
      "visual_cue": "切面湿润，汁水不外流"
    },
    {
      "n": 5,
      "text": "小碗里放青柠汁、鱼露和白糖，搅到糖化。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要化开，酱汁才不齁。，火别开太大，稳着来。",
      "visual_cue": "汁体清亮，糖粒消失"
    },
    {
      "n": 6,
      "text": "大碗放黄瓜片、番茄块和红葱头丝。，锅温要匀，别忽高忽低。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蔬菜切均匀，入口才顺。，火力保持中等，慢慢来。",
      "visual_cue": "颜色交错，堆成小山"
    },
    {
      "n": 7,
      "text": "放入鸡肉条，淋酱汁轻轻拌匀。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻拌别压，蔬菜才不出水。，注意锅里温度别掉下来。",
      "visual_cue": "酱汁挂匀，颜色发亮"
    },
    {
      "n": 8,
      "text": "撒罗勒叶和花生碎，装盘上桌。，始终中小火，别心急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "罗勒最后放，香气才清。，火要均匀，食材才不糊。",
      "visual_cue": "绿叶点缀，脆料散布"
    }
  ],
  "tips": [
    "鸡肉煎后静置再切，肉汁才不流失。",
    "糖要搅化，酱汁才不齁。，别嫌麻烦，做完它。",
    "罗勒最后放，香气才清。，这一步别省。"
  ],
  "common_mistakes": [
    "鸡肉煎完立刻切，汁水全流走。，别跳过这步。",
    "酱汁糖没化，吃到颗粒。，这步最关键。",
    "拌太久，蔬菜出水变汤。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "牛里脊",
      "ratio": "400 克:400 克",
      "note": "煎的时间减到三分钟每面。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "25 毫升:25 毫升",
      "note": "咸度略低，可少放糖。"
    }
  ],
  "variations": [
    "加烤花生换成腰果，口感更脆。，这里最容易翻车。",
    "加几片薄荷，凉感更足。，别小看这一步。"
  ],
  "serving_suggestion": "配糯米饭，用手捏着吃。，成败就在这一步。",
  "storage": "冷藏一天，酱汁分开保存。，这点要注意。",
