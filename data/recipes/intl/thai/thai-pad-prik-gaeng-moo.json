    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊逆着纹切成两毫米薄片，装碗备用。，这一步的关键在于火候。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纹切，咬着才不塞牙。，这一步的关键在于火候。",
      "visual_cue": "肉片薄透，纹路整齐"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，中小火下红咖喱酱炒香。，这一步的关键在于火候。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "酱要炒到出红油，香味才出来。，这一步的关键在于火候。",
      "visual_cue": "酱色转深，红油析出"
    },
    {
      "n": 3,
      "text": "倒入一半椰浆，慢慢搅到油水分离。，这一步的关键在于火候。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "分次加椰浆，酱才不澥。，这一步的关键在于火候。",
      "visual_cue": "表面浮油，酱体浓稠"
    },
    {
      "n": 4,
      "text": "下猪肉片滑散，炒到肉片变白卷起。，这一步的关键在于火候。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉片一片片下，别堆成一坨。，这一步的关键在于火候。",
      "visual_cue": "肉片雪白，边缘卷曲"
    },
    {
      "n": 5,
      "text": "放豇豆段和柠檬叶，翻炒两分钟断生。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "中火",
      "tip": "柠檬叶撕开才出香，整片放味不散。，这一步的关键在于火候。",
      "visual_cue": "豆段翠绿，香气扑鼻"
    },
    {
      "n": 6,
      "text": "倒剩下的椰浆，加鱼露和椰糖调味。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "中火",
      "tip": "糖和鱼露先尝再调，咸甜要平衡。，这一步的关键在于火候。",
      "visual_cue": "汤汁浓稠，油光明亮"
    },
    {
      "n": 7,
      "text": "撒小米辣圈翻两下，关火盛盘。，这一步的关键在于火候。",
      "time_min": 2,
      "heat": "中火",
      "tip": "辣味最后放，才够冲又不苦。，这一步的关键在于火候。",
      "visual_cue": "红绿相间，汁裹肉片"
    }
  ],
  "tips": [
    "红咖喱酱要炒出红油，味道才醇厚。",
    "椰浆分两次加，酱汁才不澥不油水分离。",
    "青柠叶用手撕开，香气才释放得彻底。"
  ],
  "common_mistakes": [
    "咖喱酱没炒透，吃着有生酱味。，这一点很关键。",
    "肉片一起下锅，温度骤降全出水。，这一点很关键。",
    "椰糖和鱼露一次全倒，咸甜失衡。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "梅花肉",
      "ratio": "400 克:400 克",
      "note": "脂肪多，口感更润，油可减半。"
    },
    {
      "original": "豇豆",
      "substitute": "四季豆",
      "ratio": "120 克:120 克",
      "note": "须彻底炒熟，避免豆角中毒。"
    }
  ],
  "variations": [
    "加几片竹笋，口感更脆。，这一点很关键。",
    "换成鸡肉做同样做法，味更清淡。，这一点很关键。"
  ],
  "serving_suggestion": "配茉莉香米饭，趁热连汁浇饭。，这一点很关键。",
  "storage": "冷藏两天，复热加少许椰浆防干。，这一点很关键。",
