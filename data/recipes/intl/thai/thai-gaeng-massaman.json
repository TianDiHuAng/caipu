  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "锅铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切三厘米块，冷水下锅焯去血沫。，看准状态再往下做。",
      "time_min": 12,
      "heat": "大火",
      "tip": "焯水去腥，汤才不浑。，看准状态再往下做。",
      "visual_cue": "浮沫成层，肉色变浅"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，小火炒红咖喱酱出红油。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢炒，酱才不苦。，看准状态再往下做。",
      "visual_cue": "油色转红，香气浓，这一点很关键。"
    },
    {
      "n": 3,
      "text": "倒入一半椰奶，搅到油水分离出油。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "炒到椰奶出油，咖喱才香。，看准状态再往下做。",
      "visual_cue": "表面浮红油，椰奶收干"
    },
    {
      "n": 4,
      "text": "放牛肉块翻炒，让每块裹上咖喱。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "牛肉裹满酱，炖后才入味。，看准状态再往下做。",
      "visual_cue": "肉块上色，酱层均匀"
    },
    {
      "n": 5,
      "text": "加清水和柠檬叶煮开，转小火炖三十分钟。，看准状态再往下做。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢炖，牛肉才软烂。，看准状态再往下做。",
      "visual_cue": "汤面微沸，肉块下沉"
    },
    {
      "n": 6,
      "text": "加土豆和洋葱，继续炖十五分钟。，看准状态再往下做。",
      "time_min": 16,
      "heat": "小火",
      "tip": "土豆后放，才不会炖成泥。，看准状态再往下做。",
      "visual_cue": "土豆微软，边缘圆润"
    },
    {
      "n": 7,
      "text": "倒剩余椰奶，加棕榈糖、鱼露和罗望子酱。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酸甜咸要平衡，边尝边调。，看准状态再往下做。",
      "visual_cue": "汤色奶红，香气复合"
    },
    {
      "n": 8,
      "text": "撒烤香的花生，再煮两分钟关火。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "花生最后放，才保持脆感。，看准状态再往下做。",
      "visual_cue": "花生浮面，汤体浓稠"
    }
  ],
  "tips": [
    "椰奶先炒出油，咖喱才香。，这一点很关键。",
    "土豆后放，炖久会化。，这一点很关键。",
    "酸甜咸三味要平衡，边尝边调。，这一点很关键。"
  ],
  "common_mistakes": [
    "咖喱酱不炒直接煮，味道发闷。，这一点很关键。",
    "土豆一开始就放，最后全化了。，这一点很关键。",
    "椰奶一次全倒，炒不出红油。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡腿",
      "ratio": "600 克:600 克",
      "note": "炖二十分钟即可。"
    },
    {
      "original": "罗望子酱",
      "substitute": "青柠",
      "ratio": "20 毫升:2 个",
      "note": "酸味更清，需多加糖。"
    }
  ],
  "variations": [
    "加几块菠萝，果酸更明亮。，这一点很关键。",
    "撒烤椰片，香气更浓。，这一点很关键。"
  ],
  "serving_suggestion": "配一碗白饭或印度飞饼。，这一点很关键。",
  "storage": "冷藏三天，冷冻两周；复热小火加椰奶。",
