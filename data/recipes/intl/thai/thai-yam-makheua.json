  "equipment": [
    "烤箱",
    "烤盘",
    "捣臼",
    "沙拉碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净切成四厘米长的段，表面均匀刷上一层植物油备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刷一层薄油就够，油多了烤完会发腻。",
      "visual_cue": "茄子表面油光均匀，不见干斑"
    },
    {
      "n": 2,
      "text": "烤箱预热到两百度，把茄子段平铺在烤盘上烤十五分钟。",
      "time_min": 15,
      "heat": "中火",
      "tip": "中途翻一次面，两面都烤出焦痕才香。",
      "visual_cue": "茄子表皮起皱，按压能陷下去"
    },
    {
      "n": 3,
      "text": "猪肉末放进炒锅干煸到变色出油，盛出稍微晾凉备用。",
      "time_min": 5,
      "heat": "中火",
      "tip": "不额外放油，靠肉末自身的油脂煸香。",
      "visual_cue": "肉末颗粒松散，锅底留一层油"
    },
    {
      "n": 4,
      "text": "大蒜与小米辣放进捣臼捣碎，加鱼露、青柠汁与椰糖拌成料汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "捣出来的香料比切的更出味，汁水也更融合。",
      "visual_cue": "料汁呈浅褐色，酸辣味冲鼻"
    },
    {
      "n": 5,
      "text": "烤好的茄子用手撕成粗条，连同肉末与红葱头片一起放进碗里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "撕比切好，粗糙的断面更容易吸住料汁。",
      "visual_cue": "茄子条柔软带焦边，长度均匀"
    },
    {
      "n": 6,
      "text": "淋上料汁轻轻拌匀，撒香菜段与薄荷叶，装盘即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "薄荷最后放，靠余温散香就够，久拌会发黑。",
      "visual_cue": "表面点缀绿薄荷，茄子裹满料汁"
    }
  ],
  "tips": [
    "茄子选细长的品种，肉薄易熟也不发水。",
    "烤到外皮焦黑也没关系，撕开里面是软的就行。",
    "肉末可以省略，纯素版本同样好吃。",
    "料汁里的椰糖换成白糖也行，甜味更直接。"
  ],
  "common_mistakes": [
    "茄子没刷油直接烤，表面干硬像柴火。",
    "烤的时间不够，撕开中间还有生硬的白芯。",
    "薄荷提前拌进去，端上桌时叶子已经发黑。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉",
      "ratio": "120克:130克",
      "note": "剁成粗粒干煸，油脂少可补少许油。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "30克:30克",
      "note": "柠檬酸味更直，椰糖可略加。"
    }
  ],
  "variations": [
    "加一把烤花生碎同拌，口感更脆更香。",
    "改用炭火烤茄子，烟熏味更足更地道。"
  ],
  "serving_suggestion": "趁温热吃最合适，茄子软糯带焦香，肉末咸鲜，料汁的酸辣在舌尖一跳，配糯米饭刚刚好。",
  "storage": "冷藏可存一天，复热建议用平底锅干煎一分钟，微波会让茄子出水变糊。",
