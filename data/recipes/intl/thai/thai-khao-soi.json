  "steps": [
    {
      "n": 1,
      "text": "炒锅倒一半植物油，小火炒香黄咖喱酱两分钟。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "小火",
      "tip": "咖喱酱要炒出油，香味才出来。，火力保持中等，慢慢来。",
      "visual_cue": "酱体冒泡，油色转红"
    },
    {
      "n": 2,
      "text": "倒一半椰奶，中火搅到油水分离出红油。，火候宁小勿大，慢慢推进。",
      "time_min": 6,
      "heat": "中火",
      "tip": "椰奶煮到出油，咖喱才够香。，注意锅里温度别掉下来。",
      "visual_cue": "表面浮红油，酱体浓稠"
    },
    {
      "n": 3,
      "text": "下鸡胸肉块翻炒到表面变白。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉块裹上咖喱，才入味。，火要均匀，食材才不糊。",
      "visual_cue": "肉块挂酱，颜色发黄"
    },
    {
      "n": 4,
      "text": "加清水和红糖，小火煮二十分钟。，看住火，别让它失控。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火慢煮，鸡肉才不柴。，全程留意火候，别贪快。",
      "visual_cue": "汤面微沸，酱汁转稠"
    },
    {
      "n": 5,
      "text": "倒剩余椰奶和鱼露，搅匀后再煮三分钟。，火大了就离锅远一点。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰奶后放，香气才清。，火别开太大，稳着来。",
      "visual_cue": "汤色奶黄，质地顺滑"
    },
    {
      "n": 6,
      "text": "河粉用开水烫软，捞出沥干分装碗里。，锅温要匀，别忽高忽低。",
      "time_min": 5,
      "heat": "大火",
      "tip": "河粉烫软就捞，泡久会烂。，火力保持中等，慢慢来。",
      "visual_cue": "河粉柔软，根根分明"
    },
    {
      "n": 7,
      "text": "大蒜末用剩余植物油小火炸到金黄。，火候宁小勿大，慢慢推进。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火慢炸，蒜末才不焦。，注意锅里温度别掉下来。",
      "visual_cue": "蒜末金黄，油香浓，成败就在这一步。"
    },
    {
      "n": 8,
      "text": "咖喱汤浇在粉上，撒蒜末和花生碎。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "配料最后撒，脆感才在。，火要均匀，食材才不糊。",
      "visual_cue": "汤面油亮，脆料堆顶"
    },
    {
      "n": 9,
      "text": "挤一点青柠汁，拌匀趁热吃。，看住火，别让它失控。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠解腻，别省。，全程留意火候，别贪快。",
      "visual_cue": "酸香散开，汤色变浅"
    }
  ],
  "tips": [
    "咖喱酱要炒出红油，香味才足。，这点要注意。",
    "椰奶后放，香气才清不腻。，这是关键点。",
    "蒜末小火炸，才金黄不苦。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "咖喱酱不炒，汤发闷。，这一步别省。",
    "河粉泡太久，端上来就断。，别跳过这步。",
    "火大煮椰奶，油水分离发渣。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "牛里脊",
      "ratio": "400 克:400 克",
      "note": "炖的时间加十分钟。"
    },
    {
      "original": "河粉",
      "substitute": "米粉",
      "ratio": "300 克:300 克",
      "note": "更细，烫的时间减半。"
    }
  ],
  "variations": [
    "加酸菜，酸味更正。，很多人在这里出错。",
    "加一个溏心蛋，更饱腹。，这里最容易翻车。"
  ],
  "serving_suggestion": "配腌菜和青柠角一起上。，别小看这一步。",
  "storage": "汤冷藏两天，粉现煮现烫。，成败就在这一步。",
