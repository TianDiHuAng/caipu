  "steps": [
    {
      "n": 1,
      "text": "罗非鱼刮净鳞片，剔下鱼肉切成三厘米块。，这一步的关键在于火候。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱼块大小一致，煮的时间才齐。，这一步的关键在于火候。",
      "visual_cue": "鱼块完整，肉色透亮"
    },
    {
      "n": 2,
      "text": "香茅拍扁切段，南姜切片，柠檬叶撕成两半。，这一步的关键在于火候。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香料拍裂才出味，整块煮香味淡。，这一步的关键在于火候。",
      "visual_cue": "香料散开，香气明显"
    },
    {
      "n": 3,
      "text": "汤锅倒清水，下香茅、南姜和柠檬叶烧开。，这一步的关键在于火候。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水开后再煮五分钟，让香料出味。，这一步的关键在于火候。",
      "visual_cue": "汤色微黄，香气满屋"
    },
    {
      "n": 4,
      "text": "放鱼块和菠萝块，中小火煮八分钟。，这一步的关键在于火候。",
      "time_min": 9,
      "heat": "中小火",
      "tip": "鱼块下锅别搅动，容易碎。，这一步的关键在于火候。",
      "visual_cue": "鱼块变白，菠萝微软"
    },
    {
      "n": 5,
      "text": "加鱼露和椰糖调味，尝一下酸甜平衡。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "先咸后甜，最后再定酸度。，这一步的关键在于火候。",
      "visual_cue": "汤味鲜甜，咸淡适口"
    },
    {
      "n": 6,
      "text": "挤入青柠汁，撒小米辣和香菜关火。，这一步的关键在于火候。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁关火后放，酸味才清亮。，这一步的关键在于火候。",
      "visual_cue": "汤色清亮，浮着青柠叶"
    }
  ],
  "tips": [
    "香茅和南姜要煮够时间，汤底才有层次。",
    "青柠汁关火后再挤，久煮会发苦。，别跳过这步。",
    "菠萝选偏酸的，汤的酸甜才平衡。，这步最关键。"
  ],
  "common_mistakes": [
    "鱼块下锅猛搅，端上来全是碎渣。，很多人在这里出错。",
    "青柠汁早放，酸味煮没了只剩苦。，这里最容易翻车。",
    "香料整根下锅，汤只有清水味。，别小看这一步。"
  ],
  "substitutions": [
    {
      "original": "罗非鱼",
      "substitute": "鲈鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更细，煮的时间减两分钟。"
    },
    {
      "original": "菠萝",
      "substitute": "番茄",
      "ratio": "200 克:250 克",
      "note": "酸味更直接，糖可略加。"
    }
  ],
  "variations": [
    "加一把草菇，汤更鲜。，成败就在这一步。",
    "放几片苦瓜，回甘更明显。，这点要注意。"
  ],
  "serving_suggestion": "趁热喝汤吃鱼，配白米饭。，这是关键点。",
  "storage": "冷藏两天，复热须煮开，青柠汁另加。",
