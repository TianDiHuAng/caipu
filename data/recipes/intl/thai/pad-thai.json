        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干河粉用温水浸泡 20 分钟至软而有韧性，捞出沥干水分备用。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡到能弯折不断就够了，别泡烂。",
      "visual_cue": "河粉柔软、弯折不断"
    },
    {
      "n": 2,
      "text": "罗望子用 30ml 温水抓洗取汁，加鱼露与椰糖搅成酸甜酱汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先尝酱汁，酸甜要平衡。",
      "visual_cue": "酱汁均匀、无糖粒"
    },
    {
      "n": 3,
      "text": "大虾挑净虾线，豆芽掐根洗净，香菜切段，青柠切成四角。",
      "time_min": 5,
      "heat": "无火",
      "tip": "虾线一定挑干净，否则腥味重。",
      "visual_cue": "虾身完整、配菜齐备"
    },
    {
      "n": 4,
      "text": "炒锅倒 20ml 植物油烧热，中火把大虾炒到变红卷曲后盛出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "虾先炒后回锅，肉质才不老。",
      "visual_cue": "虾身通红、微微卷曲"
    },
    {
      "n": 5,
      "text": "锅中再加 20ml 植物油，倒入蛋液炒散，下河粉大火快速翻炒 2 分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "河粉下锅后少翻多推，不易断。",
      "visual_cue": "河粉透亮、蛋块散开"
    },
    {
      "n": 6,
      "text": "淋入酸甜酱汁快速翻匀，回锅大虾与豆芽，撒花生碎与香菜，配青柠角上桌。",
      "time_min": 4,
      "heat": "大火",
      "tip": "酱汁下锅后动作要快，河粉易糊。",
      "visual_cue": "河粉均匀上色、豆芽仍脆"
    }
  ],
  "tips": [
    "河粉泡到软而不烂，炒时才不断条。",
    "酸甜酱汁先调好尝味，比边炒边调更稳。",
    "豆芽最后下锅，才能保持脆口不出一盘水。"
  ],
  "common_mistakes": [
    "河粉泡过头，下锅一炒就碎成糊。",
    "酱汁一次倒太多，河粉变成汤粉。",
    "虾仁与河粉同炒太久，虾肉发硬变柴。"
  ],
  "substitutions": [
    {
      "original": "大虾",
      "substitute": "鸡胸肉",
      "ratio": "150g 对 150g",
      "note": "鸡肉切条先炒熟，时间加 1 分钟。"
    },
    {
      "original": "罗望子",
      "substitute": "青柠汁加红糖",
      "ratio": "20g 对 30ml 加 15g",
      "note": "酸味更直白，糖量略减。"
    }
  ],
  "variations": [
    "素食版：省去大虾与鱼露，用酱油与香菇提鲜。",
    "加辣版：出锅前加 5g 辣椒粉同炒。"
  ],
  "storage": "冷藏 1 天，复热用炒锅大火回炒 1 分钟。",
