  "steps": [
    {
      "n": 1,
      "text": "茄子对半剖开，用勺子挖出中间果肉留一厘米厚的外壳，果肉切丁。",
      "time_min": 14,
      "heat": "无火",
      "tip": "外壳别挖太薄，烤的时候容易塌陷破口。",
      "visual_cue": "茄子壳完整呈船形，果肉丁大小均匀"
    },
    {
      "n": 2,
      "text": "炒锅倒一半橄榄油，中火炒洋葱碎到透明，加茄子丁炒软。",
      "time_min": 10,
      "heat": "中火",
      "tip": "茄子吸油，先用中火炒到软再加油就不腻。",
      "visual_cue": "洋葱透明，茄子丁软塌出汁"
    },
    {
      "n": 3,
      "text": "加番茄丁、大米、盐、黑胡椒与肉桂翻炒两分钟，倒清水小火焖十五分钟。",
      "time_min": 18,
      "heat": "小火",
      "tip": "米焖到半熟就够，后面还要进烤箱。",
      "visual_cue": "米粒半透明，馅料湿润不流汤"
    },
    {
      "n": 4,
      "text": "把馅料填进茄子壳，表面撒松子与欧芹碎，再淋上剩余的橄榄油。",
      "time_min": 7,
      "heat": "无火",
      "tip": "馅料填八分满，米受热膨胀才不会溢出来。",
      "visual_cue": "茄子船填得饱满，松子分布均匀"
    },
    {
      "n": 5,
      "text": "烤盘底部倒五十毫升清水，一百八十度烤三十五分钟至茄子软透。",
      "time_min": 38,
      "heat": "中火",
      "tip": "盘底加水能保持湿润，茄子皮不会烤干发硬。",
      "visual_cue": "茄子皮皱软，表面松子金黄"
    }
  ],
  "tips": [
    "茄子先炒软再填馅，成品口感才不生硬。",
    "盘底加水是防止烤干的关键一步。",
    "米焖到半熟就停，否则烤完会糊成一团。",
    "出炉后撒一把欧芹碎再静置十分钟，盛盘时茄子船才不会散。"
  ],
  "common_mistakes": [
    "茄子壳挖得太薄，烤完塌成一团。",
    "米煮到全熟再烤，馅料干硬口感差。",
    "盘底没加水，茄子皮烤得又干又韧。",
    "盐放太少，茄子本身味淡，整道菜寡口。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "700克:700克",
      "note": "挖出的瓤要挤干水分。"
    },
    {
      "original": "松子",
      "substitute": "杏仁片",
      "ratio": "30克:30克",
      "note": "先烤香再用，口感更脆。"
    }
  ],
  "variations": [
    "馅里加一百克羊肉碎，做成荤版更香。",
    "表面撒一层奶酪碎，烤到融化拉丝。",
    "加一勺番茄酱进馅，酸甜更开胃。"
  ],
  "serving_suggestion": "整只茄子船摆在盘里，撒欧芹碎，配一碗原味酸奶与阿拉伯薄饼，是中东家庭餐桌上的主菜。",
  "storage": "冷藏可放两天，复热用一百八十度烤箱烤十分钟，微波加热会让茄子出水。",
