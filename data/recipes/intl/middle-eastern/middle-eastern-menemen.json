  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字用开水烫一分钟去皮，切成小丁。",
      "time_min": 9,
      "heat": "无火",
      "tip": "去皮后炒出的汁才顺滑不卷边。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "番茄皮轻松撕下，果肉出汁"
    },
    {
      "n": 2,
      "text": "红椒去籽切小丁，洋葱切细末，欧芹切碎备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "红椒丁别太大，否则炒不软。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "丁状均匀，洋葱末细碎"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油烧热，下洋葱末中小火炒到透明。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "洋葱炒透才甜，不要炒上色。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "洋葱透明发软，香气散出"
    },
    {
      "n": 4,
      "text": "下红椒丁炒三分钟至微软，加红椒粉与黑胡椒炒香。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "香料下锅略炒就出味，别炒糊。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "红椒变软，油色橙红色泽分明状态稳定"
    },
    {
      "n": 5,
      "text": "倒入番茄丁，加盐与白糖中火炒八分钟至出水变稠。",
      "time_min": 9,
      "heat": "中火",
      "tip": "炒到番茄化成酱汁，蛋才挂汁好吃。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "番茄塌软成糊状，锅里有浓汁"
    },
    {
      "n": 6,
      "text": "把蛋液直接磕入锅中，用铲子轻推至半凝固即离火，撒欧芹末。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋半熟就离火，余温会继续焖熟。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "蛋液半凝，蛋白洁白蛋黄橙黄"
    }
  ],
  "tips": [
    "番茄去皮，口感才细腻。火候与时间都要盯紧，宁可略短也别过头。",
    "蛋液入锅后轻推不猛翻，才成嫩块。做之前把料备齐，下锅后就没空切配了。",
    "半熟离火，靠余温焖熟最嫩。这几步照顺序来，味道才会一层层叠上去。",
    "配扁面包蘸着吃才是当地吃法。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "番茄没炒出汁就下蛋，蛋变干硬。结果往往一锅好料全被这一步毁掉。",
    "蛋液猛火快炒，结成一团老蛋块。很多人就在这里翻车，出菜后才发现。",
    "炒到全熟才离火，端上桌已经过火。账面上看是小疏忽，入口立刻能尝出来。",
    "不放红椒粉，颜色和风味都单薄。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "红椒",
      "substitute": "青椒",
      "ratio": "150克:150克",
      "note": "香气更清，甜味略淡。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "40毫升:35克",
      "note": "奶香更浓，适合早餐。"
    }
  ],
  "variations": [
    "加一点辣椒粉，辣味更明显。口味会更厚一些，适合重口的人。",
    "加碎羊奶酪同炒，咸香更足。做法不复杂，家常灶台就能完成。",
    "加几片香肠同炒，更像当地街头早餐。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "连锅端上桌，配热扁面包直接挖着吃，蛋嫩汁浓，番茄酸香裹着蛋块。",
  "storage": "冷藏不超过一天，复热用小火加一勺清水推炒一分钟。",
