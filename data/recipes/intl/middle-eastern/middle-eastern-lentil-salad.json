  "steps": [
    {
      "n": 1,
      "text": "扁豆挑去杂质，用清水冲洗两遍后沥干备用。趁热操作更顺手。",
      "time_min": 7,
      "heat": "无火",
      "tip": "扁豆不用泡，洗掉浮尘直接煮就好。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "豆子干净无砂粒，水清澈"
    },
    {
      "n": 2,
      "text": "锅中加水烧开，下扁豆中小火煮二十分钟至软而不烂。",
      "time_min": 24,
      "heat": "中小火",
      "tip": "煮到能咬开但不散，沙拉口感才对。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "豆子饱满，用手一捏即碎"
    },
    {
      "n": 3,
      "text": "煮好的扁豆倒入漏勺沥干，摊开放凉十分钟。趁热操作更顺手。",
      "time_min": 12,
      "heat": "无火",
      "tip": "摊开散热，豆子才不 continued 变糊。",
      "visual_cue": "豆粒松散不粘连，表面干爽"
    },
    {
      "n": 4,
      "text": "番茄与黄瓜切小丁，洋葱切末，欧芹切碎备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "所有配料切得一样大，入口才协调。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "丁状均匀，颜色分明色泽分明状态稳定"
    },
    {
      "n": 5,
      "text": "柠檬汁、橄榄油、盐、孜然与黑胡椒搅匀成调味汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "调味汁在豆子温热时拌，吸味最好。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汁液乳浊，香料均匀色泽分明状态稳定"
    },
    {
      "n": 6,
      "text": "扁豆与蔬菜混合，淋调味汁拌匀，静置十分钟入味即可。",
      "time_min": 12,
      "heat": "无火",
      "tip": "豆子温热时拌，酸香才吃得进去。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "豆粒裹满汁液，色泽油亮"
    }
  ],
  "tips": [
    "扁豆煮到刚软就停，煮烂就成了豆泥。火候与时间都要盯紧，宁可略短也别过头。",
    "趁温热拌汁，吸味效果最好。做之前把料备齐，下锅后就没空切配了。",
    "洋葱切细末，生辣味不冲。这几步照顺序来，味道才会一层层叠上去。",
    "静置十分钟再吃，风味更融合。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "扁豆泡过夜再煮，容易煮成糊。结果往往一锅好料全被这一步毁掉。",
    "煮得太久，豆子散了没口感。很多人就在这里翻车，出菜后才发现。",
    "热豆子直接拌蔬菜，黄瓜被烫软。账面上看是小疏忽，入口立刻能尝出来。",
    "不放孜然，风味不像中东菜。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "鹰嘴豆",
      "ratio": "300克:300克",
      "note": "需提前泡八小时，煮的时间加十分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "50克:50克",
      "note": "酸味更清，香气更冲。"
    }
  ],
  "variations": [
    "加一把薄荷碎，清凉感更强。口味会更厚一些，适合重口的人。",
    "加碎羊奶酪，咸香更足。做法不复杂，家常灶台就能完成。",
    "加一勺辣椒酱，变成微辣版。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "盛在浅碗里撒黑胡椒，配烤蔬菜或烤肉，温热吃或冷藏后吃都很清爽。",
  "storage": "冷藏可放两天，吃前回温或加一勺柠檬汁提味；豆类久放易发酸。",
