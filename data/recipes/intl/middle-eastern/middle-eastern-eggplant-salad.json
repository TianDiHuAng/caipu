  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净擦干，整只用叉子在表面扎十来个孔。",
      "time_min": 6,
      "heat": "无火",
      "tip": "扎孔排气，烤的时候才不会爆开。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "表皮密布小孔，茄子完整"
    },
    {
      "n": 2,
      "text": "烤箱预热二百度，茄子放烤盘烤三十五分钟至表皮焦黑变软。",
      "time_min": 38,
      "heat": "无火",
      "tip": "烤到皮全黑、肉塌软，烟熏味才足。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "表皮起皱发黑，按压软塌"
    },
    {
      "n": 3,
      "text": "取出放凉十分钟，剥去焦皮，把茄肉撕成粗条放在滤网上沥水。",
      "time_min": 15,
      "heat": "无火",
      "tip": "沥掉多余汁水，拌好才不会稀。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "茄肉呈浅褐色条状，滤网下积汁"
    },
    {
      "n": 4,
      "text": "番茄切丁，洋葱与大蒜切末，欧芹切碎备用。趁热操作更顺手。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱切细末，口感才不会突兀。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "配料切得细碎均匀色泽分明状态稳定"
    },
    {
      "n": 5,
      "text": "柠檬汁、橄榄油、盐、孜然与红椒粉搅匀成调味汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "调味汁先调好，茄子才吸得均匀。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汁液橙红透亮，香料分布均匀"
    },
    {
      "n": 6,
      "text": "茄条与番茄、洋葱、大蒜、欧芹混合，淋调味汁拌匀静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置十分钟让味道进去，更入味。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "茄条裹满料汁，色泽油润"
    }
  ],
  "tips": [
    "茄子烤到皮黑肉塌，烟熏味才正。火候与时间都要盯紧，宁可略短也别过头。",
    "茄肉撕不用刀切，口感更粗犷。做之前把料备齐，下锅后就没空切配了。",
    "沥干水分，沙拉才不稀。这几步照顺序来，味道才会一层层叠上去。",
    "静置十分钟再吃，味道融得更好。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "茄子没烤透，茄肉发硬带生涩。结果往往一锅好料全被这一步毁掉。",
    "不沥水直接拌，装盘全是汁。很多人就在这里翻车，出菜后才发现。",
    "火太大把茄子烤成炭，只剩焦味。账面上看是小疏忽，入口立刻能尝出来。",
    "蒜末切太粗，一口咬到辣得冲。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "700克:700克",
      "note": "烟熏味淡，烤的时间减十分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "米醋",
      "ratio": "50克:40毫升",
      "note": "酸味更直接，少一点即可。"
    }
  ],
  "variations": [
    "加一勺酸奶拌匀，口感更柔滑。口味会更厚一些，适合重口的人。",
    "加石榴籽点缀，酸甜又好看。做法不复杂，家常灶台就能完成。",
    "加碎核桃，口感层次更丰富。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装盘撒红椒粉和欧芹碎，配热扁面包一起挖着吃，烟熏味和柠檬酸香最搭。",
  "storage": "冷藏可放一天，吃前回温十分钟；出水后须倒掉多余汁液。",
