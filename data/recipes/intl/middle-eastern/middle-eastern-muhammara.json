  ],
  "equipment": [
    "烤箱",
    "料理机",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红椒对半切开去籽，切面朝下摆进烤盘，烤箱二百度烤二十分钟到表皮起泡。",
      "time_min": 8,
      "heat": "中火",
      "tip": "烤到皮起泡才好撕，皮留着会有生青味。",
      "visual_cue": "表皮鼓起焦斑，椒肉变软"
    },
    {
      "n": 2,
      "text": "趁热把红椒盖在碗里焖十分钟，撕掉表皮，只留柔软的椒肉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "趁热盖上碗焖十分钟，表皮一撕就整片脱落。",
      "visual_cue": "椒皮整片脱离，椒肉带汁"
    },
    {
      "n": 3,
      "text": "核桃仁放干锅小火炒三分钟到香气出来，掰成小块备用。",
      "time_min": 4,
      "heat": "小火",
      "tip": "核桃只需炒香，颜色变深就发苦。",
      "visual_cue": "核桃边缘微焦，香气明显"
    },
    {
      "n": 4,
      "text": "面包撕碎用少量清水泡软，挤干水分，让酱体更稠。",
      "time_min": 3,
      "heat": "无火",
      "tip": "面包泡软是天然的增稠剂，别换别的增稠料。",
      "visual_cue": "面包碎捏成团不滴水"
    },
    {
      "n": 5,
      "text": "把红椒肉、核桃、面包碎、大蒜和孜然放进料理机，打成粗粒糊状。",
      "time_min": 4,
      "heat": "无火",
      "tip": "不要打到顺滑，留颗粒感才像手捣的。",
      "visual_cue": "糊体带明显坚果颗粒"
    },
    {
      "n": 6,
      "text": "倒出后加橄榄油、辣椒粉、白糖和盐拌匀，静置十分钟让味道融合。",
      "time_min": 5,
      "heat": "无火",
      "tip": "橄榄油最后加，先加会被机器打散油腻。",
      "visual_cue": "表面油亮，酱色橙红"
    }
  ],
  "tips": [
    "红椒一定要烤到表皮起泡，撕皮后没有生青味。",
    "核桃小火焙香即可，颜色一深就会带苦。",
    "面包泡水挤干是天然增稠剂，比加面粉口感好。"
  ],
  "common_mistakes": [
    "红椒没烤透，酱里带一股生青草味。",
    "核桃炒糊了，整碗酱都发苦发涩。",
    "料理机打到顺滑，成品像婴儿泥没层次。"
  ],
  "substitutions": [
    {
      "original": "核桃",
      "substitute": "腰果",
      "ratio": "100 克:100 克",
      "note": "更柔和，苦味更轻。"
    },
    {
      "original": "面包",
      "substitute": "苏打饼干",
      "ratio": "60 克:50 克",
      "note": "吸水更快，饼干自带咸味要减盐。"
    }
  ],
  "variations": [
    "加一勺石榴糖浆，酸甜味更立体。",
    "增加辣椒粉用量，做成更冲的辣版。"
  ],
  "serving_suggestion": "盛在小碗里淋一圈橄榄油，配现烤的皮塔饼撕着蘸，是中东餐前必备的一碟。",
  "storage": "密封冷藏四天，表面淋一层橄榄油封住，吃前回温再搅匀。",
