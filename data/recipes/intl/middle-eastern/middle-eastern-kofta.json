  "steps": [
    {
      "n": 1,
      "text": "洋葱擦成泥，用手挤掉多余水分。，翻动放轻，口感才不散。",
      "time_min": 6,
      "heat": "无火",
      "tip": "挤干水，肉丸才不散。，时间掐准，咸淡才好把握。",
      "visual_cue": "洋葱渣干爽，汁留一碗，顺序照着来，火候才均匀。"
    },
    {
      "n": 2,
      "text": "牛肉剁成粗粒，别剁成泥。，份量心里有数，细节才到位。",
      "time_min": 8,
      "heat": "无火",
      "tip": "粗一点，口感才有嚼头。，手法轻些，表面才漂亮。",
      "visual_cue": "颗粒分明，暗红色，别急着加油，香气才留得住。"
    },
    {
      "n": 3,
      "text": "牛肉加洋葱、欧芹和蒜末拌匀。，翻动放轻，吃口才舒服。",
      "time_min": 5,
      "heat": "无火",
      "tip": "顺着一个方向搅，才上劲。，保持小火，食材才不糊。",
      "visual_cue": "肉团发黏，混合均匀，手法轻些，锅气才足。"
    },
    {
      "n": 4,
      "text": "加孜然、辣椒粉、盐和黑胡椒调味。，保持小火，锅气才足。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香料别过量，抢了肉味就亏。，保持小火，表面才漂亮。",
      "visual_cue": "香气浓，颜色转深，别用力搅，味道才进得去。"
    },
    {
      "n": 5,
      "text": "反复摔打十次，让肉团排出空气。，份量心里有数，香气才不跑。",
      "time_min": 4,
      "heat": "无火",
      "tip": "摔几下，口感才紧实。，顺序照着来，口感才不散。",
      "visual_cue": "馅体整团，不松散，下手别慌，吃口才舒服。"
    },
    {
      "n": 6,
      "text": "搓成八个椭圆团，穿在签子上压成条。，时间掐准，锅气才足。",
      "time_min": 10,
      "heat": "无火",
      "tip": "压扁些，受热才均匀。，动作放连贯，香气才留得住。",
      "visual_cue": "形状长条，厚薄一致，别急着加油，表面才漂亮。"
    },
    {
      "n": 7,
      "text": "烤盘刷油，肉串摆上去再刷一层橄榄油。，下手别慌，香气才留得住。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷油防粘，表面才亮。，盖盖焖一会儿，香气才不跑。",
      "visual_cue": "肉串油润，间距均匀，锅温要匀，香气才留得住。"
    },
    {
      "n": 8,
      "text": "两百度烤十二分钟，中途翻一次面。，下手别慌，成品才稳当。",
      "time_min": 14,
      "heat": "无火",
      "tip": "翻一次面，两面才焦香。，料别一次下太多，火候才均匀。",
      "visual_cue": "表面褐亮，边缘微焦，翻动放轻，咸淡才好把握。"
    },
    {
      "n": 9,
      "text": "取出配芝麻酱和薄饼吃。，动作放连贯，成品才稳当。",
      "time_min": 3,
      "heat": "无火",
      "tip": "稍凉一分钟，肉汁才回稳。，注意别烧干，口感才有层次。",
      "visual_cue": "切面湿润，香气扑鼻，留意锅底，形状才完整。"
    }
  ],
  "tips": [
    "洋葱水一定挤干，肉丸才不会散。，下手别慌，锅气才足。",
    "肉剁粗粒，口感才有嚼头。，别用力搅，口感才不散。",
    "摔打几下，肉丸才紧实不裂。，先试试温度，味道才进得去。"
  ],
  "common_mistakes": [
    "洋葱带水，肉丸烤完塌成一堆。，保持小火，味道才不闷。",
    "香料下太多，盖住肉味。，保持小火，成品才稳当。",
    "搓太粗，中心不易熟。，翻动放轻，风味才干净。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "600 克:600 克",
      "note": "风味更浓，可多加点孜然。"
    },
    {
      "original": "牛肉",
      "substitute": "鸡腿肉",
      "ratio": "600 克:600 克",
      "note": "剁成粗粒，烤制时间减两分钟。"
    }
  ],
  "variations": [
    "加松子碎，口感更丰富。，手法轻些，火候才均匀。",
    "加一点肉桂，香气更暖。，盖盖焖一会儿，成品才好看。"
  ],
  "serving_suggestion": "配薄饼、芝麻酱和沙拉。，别急着加油，形状才完整。",
  "storage": "冷藏两天，复热用烤箱。，汤汁别收太干，口感才不发柴。",
