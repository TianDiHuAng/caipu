  "equipment": [
    "竹签",
    "碗",
    "刀",
    "砧板",
    "烤盘",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成三厘米见方的块，用厨房纸吸干表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面越干，腌料才挂得住，烤出来也更香。",
      "visual_cue": "鸡块干爽，大小基本一致"
    },
    {
      "n": 2,
      "text": "酸奶、柠檬汁、蒜泥、橄榄油、番茄酱、盐、黑胡椒、孜然与辣椒粉调成腌料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酸奶要用原味无糖的，甜的会毁掉整盘味道。",
      "visual_cue": "腌料呈淡粉色，质地浓稠顺滑"
    },
    {
      "n": 3,
      "text": "鸡块放进腌料抓匀，盖好冷藏至少两小时，中途翻一次。",
      "time_min": 125,
      "heat": "无火",
      "tip": "腌足两小时肉才入味，时间短只有表面味道。",
      "visual_cue": "鸡块均匀裹满腌料，颜色微粉"
    },
    {
      "n": 4,
      "text": "竹签提前泡水三十分钟，把鸡块与洋葱块交替串起，每串五六块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "竹签泡过水才不会被烤焦，串的时候留一点空隙。",
      "visual_cue": "肉串紧实均匀，洋葱夹在中间"
    },
    {
      "n": 5,
      "text": "烤盘刷油，二百度烤十八分钟，中途翻面并刷一层腌料至表面焦香。",
      "time_min": 20,
      "heat": "中火",
      "tip": "最后三分钟开上火，表面焦香但里面还是嫩的。",
      "visual_cue": "表面焦褐色斑块，肉汁清亮"
    }
  ],
  "tips": [
    "用鸡腿肉不用鸡胸，烤完才不会干柴。",
    "腌料里的酸奶能软化肉质，时间别少于两小时。",
    "烤到最后刷一次腌料，颜色和香气都会更好。",
    "配薄饼、番茄与蒜味酸奶酱卷着吃最地道。"
  ],
  "common_mistakes": [
    "用鸡胸肉代替鸡腿肉，烤完又干又柴。",
    "腌的时间太短，只有表面有味里面还是白水味。",
    "竹签没泡水，进烤箱后烧焦发黑。",
    "烤过了时间，肉汁全流失，咬着发硬。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅中",
      "ratio": "900克:900克",
      "note": "烤的时间减到十五分钟。"
    },
    {
      "original": "酸奶",
      "substitute": "牛奶",
      "ratio": "200克:180克",
      "note": "软化效果弱，需加一勺柠檬汁。"
    }
  ],
  "variations": [
    "加一勺蜂蜜进腌料，烤出来更焦亮。",
    "改用炭火烤，烟熏味更足更正点。",
    "串上彩椒与番茄块，颜色更鲜亮，烤后也更甜。"
  ],
  "serving_suggestion": "连竹签一起摆盘，配阿拉伯薄饼、番茄黄瓜沙拉与一碗蒜味酸奶酱，卷起来吃最痛快。",
  "storage": "冷藏可放两天，复热用平底锅小火两面各煎两分钟或烤箱一百八十度烤六分钟。",
