  "steps": [
    {
      "n": 1,
      "text": "面粉、酵母、泡打粉与二十克白砂糖混匀，加牛奶与清水搅成顺滑面糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面糊要比煎饼稀一些，摊出来才有细密气泡。",
      "visual_cue": "面糊能缓缓流动，无干粉颗粒"
    },
    {
      "n": 2,
      "text": "盖上湿布静置一小时，面糊表面出现大量气泡即发酵完成。",
      "time_min": 62,
      "heat": "无火",
      "tip": "发酵到位饼皮才松软，气泡是判断标准。",
      "visual_cue": "面糊体积变大，表面布满小泡"
    },
    {
      "n": 3,
      "text": "剩余白砂糖加一百毫升清水与柠檬汁小火煮八分钟，加蜂蜜成糖浆。",
      "time_min": 10,
      "heat": "小火",
      "tip": "糖浆煮到能挂勺就够，煮过头会结成硬糖。",
      "visual_cue": "糖浆淡金色，淋下时呈细线"
    },
    {
      "n": 4,
      "text": "平底锅小火不放油，倒一勺面糊摊成八厘米小饼，只煎一面到表面凝固。",
      "time_min": 8,
      "heat": "小火",
      "tip": "只煎一面，另一面留着粘合，这是这道甜点的关键。",
      "visual_cue": "底面金黄，表面布满气孔未煎熟"
    },
    {
      "n": 5,
      "text": "饼皮趁热放一勺奶酪，对折捏紧边缘，放进植物油中火炸一分半至金黄，蘸糖浆撒开心果。",
      "time_min": 10,
      "heat": "中火",
      "tip": "边缘要捏紧，炸的时候奶酪才不会流出来。",
      "visual_cue": "外壳金黄酥脆，糖浆挂壁不滴"
    }
  ],
  "tips": [
    "面糊发酵到位，饼皮才会松软多孔。",
    "饼只煎一面，另一面用来粘合封口。",
    "奶酪选不太咸的，甜咸平衡才好吃。",
    "糖浆现淋现吃，泡久了饼皮会软塌。"
  ],
  "common_mistakes": [
    "面糊没发酵就摊，饼皮又硬又实。",
    "饼皮两面都煎熟再对折，边缘封不住口，炸时馅料全流出。",
    "油温太低，饼皮吸油变得又腻又软。",
    "糖浆煮太久，冷却后结成硬块蘸不上。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "核桃仁",
      "ratio": "250克:150克",
      "note": "加两勺糖拌匀，做成坚果馅。"
    },
    {
      "original": "蜂蜜",
      "substitute": "椰糖",
      "ratio": "30克:30克",
      "note": "焦香更浓，糖浆颜色更深。"
    }
  ],
  "variations": [
    "馅料里加一勺肉桂粉，香气更暖，也更接近传统风味。",
    "改用烤箱二百度烤十分钟，油少一些。",
    "做成小号一口一个的尺寸，更适合待客时端上桌。"
  ],
  "serving_suggestion": "炸好趁热淋糖浆、撒开心果碎，四个一盘，配一杯阿拉伯咖啡，是斋月夜里最受欢迎的甜点。",
  "storage": "炸好的成品当餐吃完最好，冷藏不超过一天，复热用二百度烤箱烤四分钟。",
