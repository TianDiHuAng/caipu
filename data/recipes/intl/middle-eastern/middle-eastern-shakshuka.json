    "锅铲",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切碎，甜椒去籽切小丁，番茄切成小块备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丁切得越小，炖出的酱汁越顺滑。，注意火候。",
      "visual_cue": "颗粒细小，颜色分明，状态稳定"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油烧热，下洋葱碎中火炒到透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透，酱汁的底味才甜。，注意火候。",
      "visual_cue": "洋葱透明，边缘微黄，状态稳定"
    },
    {
      "n": 3,
      "text": "加甜椒丁和蒜末炒三分钟，炒到甜椒变软出香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "甜椒炒软，生味才去掉。，注意火候。",
      "visual_cue": "甜椒变软，香气甜润，状态稳定"
    },
    {
      "n": 4,
      "text": "撒入孜然炒十秒，倒入番茄丁和番茄酱翻炒。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "孜然遇油才出香，别炒久了发苦。，注意火候。",
      "visual_cue": "香气冲鼻，油色泛红，状态稳定"
    },
    {
      "n": 5,
      "text": "小火炖十二分钟到番茄化开，加盐和黑胡椒调味。",
      "time_min": 14,
      "heat": "小火",
      "tip": "炖到汁水浓稠，蛋才有地方卧住。，注意火候。",
      "visual_cue": "汁浓挂勺，颜色红亮，状态稳定"
    },
    {
      "n": 6,
      "text": "用勺子在酱汁里压出三个小坑，各打入一枚鸡蛋。",
      "time_min": 4,
      "heat": "小火",
      "tip": "坑要挖深一点，蛋液才不会四处流。，注意火候。",
      "visual_cue": "三个坑位均匀，状态稳定"
    },
    {
      "n": 7,
      "text": "盖盖小火焖六分钟，蛋白凝固蛋黄仍然流动。",
      "time_min": 6,
      "heat": "小火",
      "tip": "焖到蛋白全白就好，蛋黄半熟最好吃。",
      "visual_cue": "蛋白凝固，蛋黄微颤，状态稳定"
    },
    {
      "n": 8,
      "text": "撒香菜碎后连锅端上桌，直接连酱汁一起吃。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "上桌后再撒香菜，清香不散。，注意火候。",
      "visual_cue": "色泽红黄，香气扑鼻，状态稳定"
    }
  ],
  "tips": [
    "番茄炖到化开成酱，蛋才有地方卧。，值得留意。",
    "挖坑要深，蛋液才不会流成一片。，值得留意。",
    "盖盖小火焖，蛋白凝固蛋黄还流心。，值得留意。"
  ],
  "common_mistakes": [
    "番茄没炖透就下蛋，汁水太稀。，值得留意。",
    "大火焖蛋，蛋黄全凝固还起泡。，值得留意。",
    "孜然炒过头，整锅发苦。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "甜椒",
      "substitute": "青椒",
      "ratio": "150 克:150 克",
      "note": "辛香味更清，可略减盐。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鹌鹑蛋",
      "ratio": "210 克:200 克",
      "note": "个数多，焖制时间减两分钟。"
    }
  ],
  "variations": [
    "加一勺辣椒酱，辣味更过瘾。，值得留意。",
    "出锅前撒奶酪碎，奶香更浓。，值得留意。"
  ],
  "serving_suggestion": "连锅端上桌，用勺子舀着酱汁和鸡蛋一起吃。",
  "storage": "冷藏一天，复热小火加盖焖五分钟。，效果更稳定。",
