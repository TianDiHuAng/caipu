  "equipment": [
    "碗",
    "烤盘",
    "锅",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油融化后放温，别太烫。，锅温要匀，整道菜才立得住。",
      "time_min": 5,
      "heat": "小火",
      "tip": "太烫会把蛋烫熟。，动作放连贯，口感才不散。",
      "visual_cue": "黄油澄清，温度不烫手，慢慢来别急，颜色才够亮。"
    },
    {
      "n": 2,
      "text": "面粉、椰蓉、泡打粉和一半白糖混匀。，动作放连贯，风味才干净。",
      "time_min": 4,
      "heat": "无火",
      "tip": "干料先拌匀，才不结块。，先试试温度，香气才留得住。",
      "visual_cue": "粉体均匀，无颗粒，汤汁别收太干，整道菜才立得住。"
    },
    {
      "n": 3,
      "text": "鸡蛋打散，和酸奶、温黄油一起倒入。，注意别烧干，口感才不散。",
      "time_min": 5,
      "heat": "无火",
      "tip": "液体分次加，才好拌。，保持小火，香气才留得住。",
      "visual_cue": "糊体顺滑，无干粉，保持小火，颜色才够亮。"
    },
    {
      "n": 4,
      "text": "拌成厚糊，静置十分钟。，动作放连贯，表面才漂亮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置一下，粉才吸足水。，盖盖焖一会儿，香气才留得住。",
      "visual_cue": "糊体变稠，表面平，先试试温度，形状才完整。"
    },
    {
      "n": 5,
      "text": "倒进烤盘抹平，表面划菱形纹。，先试试温度，表面才漂亮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划纹要深些，切时才顺。，注意别烧干，整道菜才立得住。",
      "visual_cue": "纹路清晰，深浅一致，注意别烧干，锅气才足。"
    },
    {
      "n": 6,
      "text": "每块中央嵌一颗杏仁，一百八十度烤三十分钟。，火别太大，味道才不闷。",
      "time_min": 32,
      "heat": "无火",
      "tip": "烤到表面金黄，牙签插入不带糊。，汤汁别收太干，成品才好看。",
      "visual_cue": "表面金黄，边缘离模，起锅前尝味，火候才均匀。"
    },
    {
      "n": 7,
      "text": "清水加剩余白糖和蜂蜜煮成糖浆，加柠檬汁。，时间掐准，成品才好看。",
      "time_min": 8,
      "heat": "小火",
      "tip": "糖浆别太稠，凉了会更浓。，料别一次下太多，香气才不跑。",
      "visual_cue": "浆体清亮，能挂勺，时间掐准，口感才不散。"
    },
    {
      "n": 8,
      "text": "蛋糕趁热淋糖浆，静置二十分钟吸收。，锅温要匀，香气才不跑。",
      "time_min": 22,
      "heat": "无火",
      "tip": "趁热淋，浆才吸得进。，注意别烧干，味道才进得去。",
      "visual_cue": "浆水渗入，表面发亮，锅温要匀，颜色才够亮。"
    },
    {
      "n": 9,
      "text": "放凉切块，按纹路下刀。，份量心里有数，火候才均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "凉了再切，块形才整。，火别太大，口感才有层次。",
      "visual_cue": "切面整齐，杏仁居中，料别一次下太多，味道才进得去。"
    }
  ],
  "tips": [
    "黄油别太烫，会把蛋烫成块。，盖盖焖一会儿，味道才不闷。",
    "趁热淋糖浆，蛋糕才吸得透。，慢慢来别急，吃口才舒服。",
    "凉了再切，块形才完整。，别急着加油，整道菜才立得住。"
  ],
  "common_mistakes": [
    "黄油过热，蛋液结块。，动作放连贯，颜色才够亮。",
    "糖浆太稠，只在表面挂一层。，手法轻些，细节才到位。",
    "热着切，蛋糕散成碎块。，留意锅底，口感才有层次。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "牛奶",
      "ratio": "200 克:200 毫升",
      "note": "糊体更稀，面粉加二十克。"
    },
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "30 克:30 克",
      "note": "口感更油润，可切半使用。"
    }
  ],
  "variations": [
    "加一点橙皮屑，香气更亮。，别用力搅，口感才有层次。",
    "淋糖浆前撒椰蓉，口感更丰富。，火别太大，味道才进得去。"
  ],
  "serving_suggestion": "配红茶，当下午茶点心。，留意锅底，整道菜才立得住。",
  "storage": "常温两天，冷藏可放四天。，慢慢来别急，味道才进得去。",
