  "equipment": [
    "烤箱",
    "烤盘",
    "叉子",
    "料理机",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净擦干，用叉子在表面扎满小孔防止烤爆。",
      "time_min": 6,
      "heat": "无火",
      "tip": "扎孔排气，茄子才不会在烤箱里裂开。",
      "visual_cue": "表面孔洞均匀，状态稳定"
    },
    {
      "n": 2,
      "text": "烤箱两百度预热，茄子放烤盘烤三十分钟到皮皱塌软。",
      "time_min": 30,
      "heat": "-",
      "tip": "烤到整只塌下去，肉才够软够香。，注意火候。",
      "visual_cue": "表皮焦皱，整体塌软，状态稳定"
    },
    {
      "n": 3,
      "text": "取出稍晾，趁热剥掉外皮，把茄肉放进滤网沥水十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "沥掉水分，茄泥才不会稀。，注意火候。",
      "visual_cue": "茄肉成条，汁水滤出，状态稳定"
    },
    {
      "n": 4,
      "text": "茄肉用叉子压成粗泥，保留一点纤维口感。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别打成顺滑糊，留点颗粒更像家常味。",
      "visual_cue": "泥体粗糙，纤维可见，状态稳定"
    },
    {
      "n": 5,
      "text": "加芝麻酱、酸奶、蒜泥、柠檬汁、盐和孜然拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "芝麻酱先与柠檬汁调开，才不结块。，注意火候。",
      "visual_cue": "颜色米褐，质地顺滑，状态稳定"
    },
    {
      "n": 6,
      "text": "装盘后用勺背压出浅沟，淋上橄榄油撒欧芹碎。",
      "time_min": 4,
      "heat": "无火",
      "tip": "淋油前压出纹路，油才挂得住。，注意火候。",
      "visual_cue": "表面有纹，油光清亮，状态稳定"
    }
  ],
  "tips": [
    "茄子整只烤到塌软，肉才够香够绵。，值得留意。",
    "茄肉要沥水十分钟，成品才不稀。，值得留意。",
    "芝麻酱先用柠檬汁调开，避免结块。，值得留意。"
  ],
  "common_mistakes": [
    "茄子没烤透，压出的泥又硬又生。，值得留意。",
    "水分没沥干，成品稀得像汤。，值得留意。",
    "蒜压太多，整盘只剩辛辣味。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "椰奶",
      "ratio": "100 克:100 克",
      "note": "更清爽，可略加盐。"
    },
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "80 克:80 克",
      "note": "香味更甜，孜然可略减。"
    }
  ],
  "variations": [
    "加一勺石榴糖浆，酸甜更中东。，值得留意。",
    "表面撒红椒粉，颜色更艳。，值得留意。"
  ],
  "serving_suggestion": "配皮塔饼掰着蘸，也可以作为烤肉拼盘的一格。",
  "storage": "冷藏两天，食用前淋橄榄油拌匀。，效果更稳定。",
