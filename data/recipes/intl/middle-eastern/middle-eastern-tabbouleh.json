  "steps": [
    {
      "n": 1,
      "text": "小米洗净后加水煮十分钟，煮到颗粒松散不粘连。",
      "time_min": 12,
      "heat": "中火",
      "tip": "煮到刚断生就好，太软拌起来会成团。",
      "visual_cue": "颗粒分明，无夹生，状态稳定"
    },
    {
      "n": 2,
      "text": "捞出小米用冷水冲凉，彻底沥干水分备用。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冲凉后要沥很干，沙拉才不出水。，注意火候。",
      "visual_cue": "米粒松散，干爽不黏，状态稳定"
    },
    {
      "n": 3,
      "text": "欧芹和薄荷洗净晾干，切成细碎末。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一定要晾干再切，带水会把沙拉泡软。",
      "visual_cue": "碎末翠绿，无水分，状态稳定"
    },
    {
      "n": 4,
      "text": "番茄和黄瓜切小丁，洋葱切得极碎。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "番茄先去籽再切，汁水才不会太多。，注意火候。",
      "visual_cue": "丁粒均匀，碗底无水，状态稳定"
    },
    {
      "n": 5,
      "text": "柠檬挤汁，与橄榄油、盐和黑胡椒在小碗里调成汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先调汁再拌，味道才均匀。，注意火候。",
      "visual_cue": "汁液乳化，颜色微黄，状态稳定"
    },
    {
      "n": 6,
      "text": "所有材料和调味汁一起放进大碗，从底部翻拌均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "翻拌别按压，米粒才保持松散。，注意火候。",
      "visual_cue": "颜色翠绿，米粒分明，状态稳定"
    },
    {
      "n": 7,
      "text": "冷藏二十分钟后食用，风味更融合。这一步不要着急。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏一下香草味会更明显。，注意火候。",
      "visual_cue": "凉透爽口，香气清新，状态稳定"
    }
  ],
  "tips": [
    "香草一定晾干再切，带水会泡软沙拉。，值得留意。",
    "小米煮到刚断生，拌起来才松散。，值得留意。",
    "番茄去籽再切，沙拉才不会出水。，值得留意。"
  ],
  "common_mistakes": [
    "香草切得太粗，吃起来一口草味。，值得留意。",
    "小米煮成糊，拌完黏成一团。，值得留意。",
    "拌好放很久，蔬菜出水香气也散。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "小米",
      "substitute": "大米",
      "ratio": "190 克:180 克",
      "note": "口感更软，煮制时间加三分钟。"
    },
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "80 克:80 克",
      "note": "风味更浓，柠檬汁可略增。"
    }
  ],
  "variations": [
    "加少许石榴籽，酸甜和脆感更足。，值得留意。",
    "撒一层烤松子，香气更厚。，值得留意。"
  ],
  "serving_suggestion": "作为烤肉或烤鸡的配菜，也可以直接当轻食吃。",
  "storage": "冷藏一天，食用前挤少许柠檬汁提味。，效果更稳定。",
