  "equipment": [
    "烤架",
    "竹签",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉切成三厘米见方的块，剔除表面的厚筋膜。",
      "time_min": 12,
      "heat": "无火",
      "tip": "筋膜不剔干净，烤完嚼不动还塞牙。",
      "visual_cue": "肉块大小一致均匀"
    },
    {
      "n": 2,
      "text": "洋葱擦成细泥，和大蒜末一起拌入羊肉块抓匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱泥的酶能让肉更嫩，多抓一会儿。",
      "visual_cue": "肉块表面湿润挂浆"
    },
    {
      "n": 3,
      "text": "加孜然粉、黑胡椒、一半的盐和橄榄油，挤入柠檬汁和羊肉拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用手抓拌两三分钟，味道才进得去。",
      "visual_cue": "调料均匀裹住肉块"
    },
    {
      "n": 4,
      "text": "盖上保鲜膜冷藏腌制一小时，中途翻动一次羊肉块。",
      "time_min": 62,
      "heat": "无火",
      "tip": "至少腌一小时，时间太短只有表面有味。",
      "visual_cue": "肉质松软，香气明显"
    },
    {
      "n": 5,
      "text": "竹签提前泡水，把羊肉块串起来，每串留一点空隙。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉块之间要留出缝隙，受热才均匀。",
      "visual_cue": "串得整齐，肥瘦相间"
    },
    {
      "n": 6,
      "text": "烤架烧到高温，羊肉串每面烤三分钟，共烤约十二分钟。",
      "time_min": 13,
      "heat": "大火",
      "tip": "高温快烤锁住肉汁，别频繁翻面。",
      "visual_cue": "表面焦褐，肉汁渗出"
    },
    {
      "n": 7,
      "text": "出炉撒剩下的盐，羊肉串配洋葱丝、番茄片和薄荷碎上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐要出炉后再撒，肉才不会变硬。",
      "visual_cue": "表面油亮，配菜清爽"
    }
  ],
  "tips": [
    "洋葱泥要抓进肉里，酶能让羊肉更嫩。",
    "至少腌够一小时，中途翻动一次更均匀。",
    "高温快烤锁肉汁，反复翻面会让肉变干。"
  ],
  "common_mistakes": [
    "筋膜没剔干净，烤完嚼起来又硬又塞牙。",
    "腌的时间太短，只有表面有味里面淡。",
    "烤架温度不够，肉块慢慢出水变得干柴。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "羊腿肉",
      "ratio": "800 克:800 克",
      "note": "更瘦，腌制时多加一勺橄榄油。"
    },
    {
      "original": "孜然",
      "substitute": "孜然粉",
      "ratio": "6 克:6 克",
      "note": "直接用粉，省去磨制步骤。"
    }
  ],
  "variations": [
    "加一勺酸奶一起腌制，肉质会更加嫩。",
    "用牛肉替代羊肉来做，风味更加清淡。"
  ],
  "serving_suggestion": "配皮塔饼、洋葱丝和一杯薄荷茶，是中东街头最经典的吃法。",
  "storage": "冷藏两天，复热用平底锅大火快煎一分钟或烤箱两百度五分钟。",
