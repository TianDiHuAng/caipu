  "equipment": [
    "厚底锅",
    "木勺",
    "量杯",
    "碗",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米洗净沥干，与清水一起放进厚底锅，中小火煮十分钟至水被吸干。",
      "time_min": 12,
      "heat": "小火",
      "tip": "米要先用水煮开，直接下牛奶容易糊底。",
      "visual_cue": "米粒膨胀，锅底几乎无水"
    },
    {
      "n": 2,
      "text": "倒入六百毫升牛奶，小火慢煮二十分钟，全程用木勺不停搅动。",
      "time_min": 22,
      "heat": "小火",
      "tip": "一定要不停搅，米沉底就会糊锅发苦。",
      "visual_cue": "米粒软烂，液体变稠能挂勺"
    },
    {
      "n": 3,
      "text": "加白砂糖与盐搅匀，再倒入剩余牛奶继续煮八分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "糖后加，先加糖米不容易煮软。",
      "visual_cue": "甜度均匀，质地顺滑浓稠"
    },
    {
      "n": 4,
      "text": "关火拌入奶油，趁热分装进四个小碗，表面抹平。",
      "time_min": 4,
      "heat": "无火",
      "tip": "奶油关火后加，香气保留得最好。",
      "visual_cue": "表面平整光滑，质地细腻"
    },
    {
      "n": 5,
      "text": "放凉后冷藏两小时，食用前撒肉桂粉与开心果碎。",
      "time_min": 125,
      "heat": "无火",
      "tip": "冷藏后会更稠，热的时候别调得太干。",
      "visual_cue": "布丁凝固微颤，表面肉桂粉均匀"
    }
  ],
  "tips": [
    "全程小火并不断搅动，是这道甜品成功的关键。",
    "牛奶分两次加，米粒更容易煮透。",
    "糖要后加，否则米粒会一直煮不软。",
    "冷藏后口感更浓，热食则更顺滑。"
  ],
  "common_mistakes": [
    "火太大又不搅动，锅底糊一层，整锅发苦。",
    "一次把牛奶全倒进去，米粒煮不透心。",
    "糖加太早，米煮到时间还是硬的。",
    "煮得太干，冷藏后结成硬块挖不动。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "900毫升:900毫升",
      "note": "风味更浓，糖可减二十克。"
    },
    {
      "original": "开心果",
      "substitute": "杏仁",
      "ratio": "40克:40克",
      "note": "切碎后撒面，口感相近。"
    }
  ],
  "variations": [
    "表面撒一层椰蓉代替开心果，椰香更浓也更清爽。",
    "加几滴香草精，甜味更圆润，奶香也更突出。",
    "做成大碗装，表面用肉桂粉画出花纹。"
  ],
  "serving_suggestion": "盛在小碗里冷藏后上桌，撒肉桂粉与开心果碎，配一杯不加糖的红茶，是中东餐后最常见的甜点。",
  "storage": "冷藏可放两天，表面盖保鲜膜防止结皮；冷食为主，也可小火加热后再吃。",
