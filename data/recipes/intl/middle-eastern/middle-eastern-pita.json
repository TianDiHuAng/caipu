  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 6,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "帮助发酵",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 250,
          "unit": "ml",
          "note": "温水",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 20,
          "unit": "ml",
          "note": "揉面用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "和面盆",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水中加白糖与酵母，静置八分钟到表面浮起泡沫。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡沫说明酵母活跃，发酵才稳。",
      "visual_cue": "水面浮起细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉倒进盆中加盐混匀，中间挖坑倒入酵母水。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐先与面粉混，别直接碰酵母。",
      "visual_cue": "面粉中间凹出一个坑"
    },
    {
      "n": 3,
      "text": "用筷子搅成絮状，再加橄榄油揉成偏软的面团。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面团软一点，烤时更容易鼓泡。",
      "visual_cue": "面团成团，表面略粗糙"
    },
    {
      "n": 4,
      "text": "在案板上揉八分钟到面团光滑，能拉出薄膜。",
      "time_min": 8,
      "heat": "无火",
      "tip": "揉出筋膜，饼才够韧。",
      "visual_cue": "面团光滑，拉出半透明膜"
    },
    {
      "n": 5,
      "text": "面团放回盆中盖湿布，温暖处发酵一小时到两倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "发到位才容易鼓成空心。",
      "visual_cue": "体积翻倍，内部有蜂窝孔"
    },
    {
      "n": 6,
      "text": "取出面团轻拍排气，搓长条分成六个等份小剂子。",
      "time_min": 4,
      "heat": "无火",
      "tip": "分匀，烤出的饼大小才一致。",
      "visual_cue": "六份剂子大小均匀"
    },
    {
      "n": 7,
      "text": "每个剂子擀成半厘米厚的圆饼，盖布醒十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "别擀太薄，太薄鼓不起来。",
      "visual_cue": "饼坯圆整，厚薄均匀"
    },
    {
      "n": 8,
      "text": "烤箱连烤盘预热到二百三十度，把饼坯放上烤五分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "高温下饼才会瞬间鼓起空心。",
      "visual_cue": "饼身鼓起，像充气的气球"
    },
    {
      "n": 9,
      "text": "翻面再烤三分钟，表面微黄后取出，趁热用布包住。",
      "time_min": 3,
      "heat": "大火",
      "tip": "出炉马上盖布，饼皮才不发硬。",
      "visual_cue": "表面浅黄，按压有弹性"
    }
  ],
  "tips": [
    "面团要揉出筋膜，烤好的饼才有嚼劲。",
    "烤箱温度必须够高，饼才能鼓起空心。",
    "出炉立刻用布包住，饼皮保持柔软。"
  ],
  "common_mistakes": [
    "面团擀得太薄，烤完扁塌不成口袋。",
    "烤箱温度不够高，饼皮干硬鼓不起来。",
    "烤好敞着放凉，很快就变脆发硬。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "全麦面粉",
      "ratio": "400 克:400 克",
      "note": "口感更粗，水要多加二十毫升。"
    },
    {
      "original": "橄榄油",
      "substitute": "植物油",
      "ratio": "20 毫升:20 毫升",
      "note": "风味更中性，香气略淡。"
    }
  ],
  "variations": [
    "面团里加一勺孜然粉，香气更中东。",
    "表面撒上一层白芝麻，烤出来更香。"
  ],
  "serving_suggestion": "切开成口袋，夹炸豆丸或蘸鹰嘴豆泥。",
  "storage": "密封冷冻一个月，回烤三分钟恢复柔软。",
