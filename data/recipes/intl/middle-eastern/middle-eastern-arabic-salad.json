  "steps": [
    {
      "n": 1,
      "text": "番茄洗净去蒂，切成一点五厘米见方的小丁放入沙拉盆。",
      "time_min": 8,
      "heat": "无火",
      "tip": "番茄切丁别太小，拌完才不出水。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "番茄丁大小一致，盆底无汁"
    },
    {
      "n": 2,
      "text": "黄瓜削皮后纵向剖开去籽，切成同样大小的丁。",
      "time_min": 7,
      "heat": "无火",
      "tip": "去掉瓜籽，拌好才不会出一盆水。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "黄瓜丁清爽，剖面色泽发白"
    },
    {
      "n": 3,
      "text": "洋葱切成细丝，用冰水泡五分钟去掉辛辣味后沥干。",
      "time_min": 7,
      "heat": "无火",
      "tip": "冰水泡过洋葱，辣味淡了口感更脆。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "洋葱丝透亮弯曲，水珠沥干"
    },
    {
      "n": 4,
      "text": "生菜洗净撕成小片，欧芹与薄荷切碎备用。趁热操作更顺手。",
      "time_min": 6,
      "heat": "无火",
      "tip": "生菜用手撕，刀切会发黑出水。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "生菜边缘不规则，叶片干爽"
    },
    {
      "n": 5,
      "text": "柠檬榨汁，与橄榄油、盐和孜然搅匀成油醋汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "孜然是中东沙拉的标志，别省。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汁液乳浊，孜然均匀悬浮"
    },
    {
      "n": 6,
      "text": "把所有蔬菜放入沙拉盆，淋上油醋汁轻轻翻拌均匀即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌的时候从下往上翻，蔬菜才不压塌。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "蔬菜裹上油光，颜色鲜亮分明"
    }
  ],
  "tips": [
    "黄瓜去籽，沙拉才清爽不出水。火候与时间都要盯紧，宁可略短也别过头。",
    "洋葱冰水泡一下，辣味减半。做之前把料备齐，下锅后就没空切配了。",
    "生菜手撕不用刀，边缘才不发黑。这几步照顺序来，味道才会一层层叠上去。",
    "吃前再拌，拌早了蔬菜会塌。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "黄瓜不去籽，十分钟后盆底全是水。结果往往一锅好料全被这一步毁掉。",
    "洋葱不泡水，辣味压过所有菜。很多人就在这里翻车，出菜后才发现。",
    "用力拌匀，番茄压碎变成糊。账面上看是小疏忽，入口立刻能尝出来。",
    "提前一小时拌好，生菜全蔫了。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "60克:60克",
      "note": "酸味更清冽，香气更冲。"
    },
    {
      "original": "橄榄油",
      "substitute": "植物油",
      "ratio": "40毫升:40毫升",
      "note": "风味略淡，可加少许香油。"
    }
  ],
  "variations": [
    "加一把黑橄榄，风味更地中海。口味会更厚一些，适合重口的人。",
    "加一点碎羊奶酪，咸香更足。做法不复杂，家常灶台就能完成。",
    "加一勺石榴糖浆，酸甜层次更丰富。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装在浅口沙拉盆里，红黄绿三色相间，配烤肉和扁面包一起吃最地道。",
  "storage": "冷藏不超过半天，拌好的沙拉出水后风味明显下降，建议现做现吃。",
