        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 180,
          "unit": "g",
          "note": "融化",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 150,
          "unit": "g",
          "note": "糖浆",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "糖浆",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "挤汁入糖浆",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "面团用",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 140,
          "unit": "ml",
          "note": "和面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "擀面杖",
    "刷子",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐与清水揉成偏硬的面团，盖布醒四十分钟。",
      "time_min": 45,
      "heat": "无火",
      "tip": "面团偏硬，擀薄时才不容易破。",
      "visual_cue": "面团光滑紧实，按坑回弹"
    },
    {
      "n": 2,
      "text": "核桃仁用刀切成粗粒，拌入一小勺融化黄油备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切粗粒口感更好，别打成粉。",
      "visual_cue": "核桃碎大小一致，泛油光"
    },
    {
      "n": 3,
      "text": "面团平均分成十六份，每一份都擀成薄得透光的圆片。",
      "time_min": 20,
      "heat": "无火",
      "tip": "越薄越好，透光能看见手指。",
      "visual_cue": "面片透光，边缘完整"
    },
    {
      "n": 4,
      "text": "烤盘底部刷一层黄油，铺一张面片再刷一层黄油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "每层都要刷油，烤出来才酥。",
      "visual_cue": "面片贴紧盘底，油光均匀"
    },
    {
      "n": 5,
      "text": "重复铺上八张面片，每层之间都要刷黄油不能漏刷。",
      "time_min": 8,
      "heat": "无火",
      "tip": "漏刷的地方烤完会发硬不起酥。",
      "visual_cue": "八层叠好，厚薄均匀"
    },
    {
      "n": 6,
      "text": "均匀铺上核桃碎，用手轻轻压实让馅料贴住面皮。",
      "time_min": 4,
      "heat": "无火",
      "tip": "压实一点，切的时候才不会散。",
      "visual_cue": "馅层平整，厚度一致"
    },
    {
      "n": 7,
      "text": "再铺剩下八张面片，每层同样刷黄油，最后刷满表面。",
      "time_min": 8,
      "heat": "无火",
      "tip": "最上层油要刷足，烤出色泽才漂亮。",
      "visual_cue": "表面油亮，层次分明"
    },
    {
      "n": 8,
      "text": "用刀切成菱形小块，垂直切到底部但不要推动分层。",
      "time_min": 4,
      "heat": "无火",
      "tip": "垂直下刀，别来回拉锯。",
      "visual_cue": "菱形切口整齐，层次不散"
    },
    {
      "n": 9,
      "text": "烤箱一百八十度烤三十分钟，烤到表面金黄起层。",
      "time_min": 30,
      "heat": "中火",
      "tip": "中途观察上色，上色过快盖锡纸。",
      "visual_cue": "表面金黄，边缘鼓起分层"
    },
    {
      "n": 10,
      "text": "小锅放蜂蜜、白糖、柠檬汁与五十毫升水，小火煮成糖浆。",
      "time_min": 5,
      "heat": "小火",
      "tip": "煮到能挂勺就关火，别熬成焦糖。",
      "visual_cue": "糖浆微稠，滴落成细线"
    },
    {
      "n": 11,
      "text": "出炉后趁热把糖浆均匀淋在表面，静置一小时吸收。",
      "time_min": 60,
      "heat": "无火",
      "tip": "趁热淋浆，糖浆才会渗进每层。",
      "visual_cue": "糖浆被吸收，表面油亮不流"
    }
  ],
  "tips": [
    "面片擀得越薄越好，成品的层次才会一层层分明。",
    "每层都要刷黄油，漏刷的地方不发酥。",
    "糖浆必须趁热淋上去，放凉了就渗不进去。"
  ],
  "common_mistakes": [
    "面片擀得太厚，烤完像饼干没有层次。",
    "黄油刷得不均匀，成品一半发硬一半才起酥。",
    "糖浆熬过了头，冷却以后结成一块硬糖。"
  ],
  "substitutions": [
    {
      "original": "核桃",
      "substitute": "开心果",
      "ratio": "250 克:250 克",
      "note": "风味更清香，颜色翠绿。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "150 克:180 克",
      "note": "糖浆需多加五十毫升水。"
    }
  ],
  "variations": [
    "糖浆里加一勺玫瑰水，香气更有中东风味。",
    "核桃里混一把杏仁碎，坚果口感更丰富。"
  ],
  "serving_suggestion": "切块配红茶或黑咖啡，当成下午茶甜点食用。",
  "storage": "密封室温三天、冷藏一周，回温后食用更酥。",
