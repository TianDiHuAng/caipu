          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "高筋面粉",
          "optional": false
        },
        {
          "name": "核桃",
          "name_en": "walnut",
          "amount": 250,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
