  "steps": [
    {
      "n": 1,
      "text": "面粉、酵母、白糖和盐混匀。，先试试温度，细节才到位。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐别直接碰酵母，会抑制发酵。，翻动放轻，形状才完整。",
      "visual_cue": "粉体均匀，颗粒分散，盖盖焖一会儿，味道才进得去。"
    },
    {
      "n": 2,
      "text": "倒清水揉成光滑面团。，时间掐准，口感才有层次。，起锅前尝味，成品才稳当。",
      "time_min": 10,
      "heat": "无火",
      "tip": "揉到表面光滑，才好擀。，顺序照着来，咸淡才好把握。",
      "visual_cue": "面团成型，按压回弹，份量心里有数，风味才干净。"
    },
    {
      "n": 3,
      "text": "盖布发酵一小时，体积翻倍。，先试试温度，风味才干净。",
      "time_min": 62,
      "heat": "无火",
      "tip": "室温低就多等一会儿。，翻动放轻，细节才到位。",
      "visual_cue": "体积膨大，指压回慢，锅温要匀，口感才不散。"
    },
    {
      "n": 4,
      "text": "百里香、芝麻、蒜末和橄榄油拌成酱。，手法轻些，味道才进得去。",
      "time_min": 5,
      "heat": "无火",
      "tip": "油要能裹住香料。，先试试温度，味道才不闷。",
      "visual_cue": "酱体油润，香气浓，顺序照着来，口感才不发柴。"
    },
    {
      "n": 5,
      "text": "面团分成四份，擀成椭圆薄片。，慢慢来别急，香气才不跑。",
      "time_min": 10,
      "heat": "无火",
      "tip": "擀薄些，烤出来才脆。，料别一次下太多，咸淡才好把握。",
      "visual_cue": "片形椭圆，厚度均匀，注意别烧干，香气才不跑。"
    },
    {
      "n": 6,
      "text": "香料酱抹在表面，边缘留一厘米。，保持小火，咸淡才好把握。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别抹到边，烤时才好拿。，注意别烧干，咸淡才好把握。",
      "visual_cue": "酱层均匀，边缘留白，留意锅底，口感才不发柴。"
    },
    {
      "n": 7,
      "text": "烤盘刷油，两百度烤八分钟。，留意锅底，吃口才舒服。",
      "time_min": 10,
      "heat": "无火",
      "tip": "烤到边缘微焦就出炉。，锅温要匀，火候才均匀。",
      "visual_cue": "边缘上色，酱层冒泡，锅温要匀，咸淡才好把握。"
    },
    {
      "n": 8,
      "text": "出炉稍凉，卷着酸奶一起吃。，留意锅底，锅气才足。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热卷，饼才不裂。，时间掐准，表面才漂亮。",
      "visual_cue": "饼体柔韧，香气扑鼻，先试试温度，火候才均匀。"
    }
  ],
  "tips": [
    "盐和酵母分开下，发酵才顺。，时间掐准，食材才不糊。",
    "饼擀薄一点，烤出来才脆。，份量心里有数，食材才不糊。",
    "酱别抹到边，烤焦会发苦。，起锅前尝味，颜色才够亮。"
  ],
  "common_mistakes": [
    "酵母遇盐，面团发不起来。，料别一次下太多，风味才干净。",
    "饼擀太厚，中间夹生。，份量心里有数，口感才不散。",
    "烤太久，饼干脆成饼干。，动作放连贯，整道菜才立得住。"
  ],
  "substitutions": [
    {
      "original": "百里香",
      "substitute": "牛至",
      "ratio": "20 克:20 克",
      "note": "香气更柔和，用量可略增。"
    },
    {
      "original": "橄榄油",
      "substitute": "植物油",
      "ratio": "80 毫升:80 毫升",
      "note": "风味略平，可加蒜末补香。"
    }
  ],
  "variations": [
    "上面铺奶酪，做成芝士版。，别急着加油，口感才不散。",
    "加辣椒粉，味道更冲。，慢慢来别急，风味才干净。"
  ],
  "serving_suggestion": "卷酸奶和黄瓜，当早餐。，先试试温度，香气才不跑。",
  "storage": "常温一天，复热用平底锅。，慢慢来别急，表面才漂亮。",
