  "steps": [
    {
      "n": 1,
      "text": "面粉加盐、白糖与酵母拌匀，加清水与橄榄油揉成光滑面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团揉到能拉开薄膜，圈形才不易断。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "面团光滑有弹性，表面不粘手"
    },
    {
      "n": 2,
      "text": "盖布醒发五十分钟，面团涨到约两倍大。趁热操作更顺手。",
      "time_min": 55,
      "heat": "无火",
      "tip": "醒到戳洞缓慢回缩就发好了。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "面团膨胀，指压缓慢回弹"
    },
    {
      "n": 3,
      "text": "面团分成八份滚圆，搓成四十厘米长条，两头接合成圆环。",
      "time_min": 12,
      "heat": "无火",
      "tip": "接合处捏紧压扁，烤时才不会裂开。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "圆环粗细均匀，接缝隐蔽"
    },
    {
      "n": 4,
      "text": "鸡蛋打散成蛋液，把圆环正面蘸一下蛋液，再滚一层芝麻。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先蘸蛋液再蘸芝麻，芝麻才粘得牢。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "芝麻密密麻麻裹满表面"
    },
    {
      "n": 5,
      "text": "烤箱预热二百度，圆环摆入烤盘再醒十分钟。趁热操作更顺手。",
      "time_min": 12,
      "heat": "无火",
      "tip": "入炉前二次醒发，圈形才饱满。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "圆环微胖，芝麻面平整"
    },
    {
      "n": 6,
      "text": "中层烤十五分钟至表面金黄，取出放网架晾凉。",
      "time_min": 17,
      "heat": "无火",
      "tip": "表面金黄敲着发空就熟了。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "表面金褐，芝麻焦香，底部干爽"
    }
  ],
  "tips": [
    "接缝捏紧压扁，烤时不开裂。火候与时间都要盯紧，宁可略短也别过头。",
    "芝麻要滚满，香气才够。做之前把料备齐，下锅后就没空切配了。",
    "入炉前二次醒发，形状才饱满。这几步照顺序来，味道才会一层层叠上去。",
    "出炉放网架，底不返潮。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "接缝没捏紧，进炉就裂成两半。结果往往一锅好料全被这一步毁掉。",
    "没蘸蛋液，芝麻一烤全掉。很多人就在这里翻车，出菜后才发现。",
    "醒发不足就烤，圈硬得像石头。账面上看是小疏忽，入口立刻能尝出来。",
    "出炉直接放盘里，底部冒水汽发软。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "芝麻",
      "substitute": "黑芝麻",
      "ratio": "80克:80克",
      "note": "香气更浓，颜色更深。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "25毫升:25克",
      "note": "奶香更足，需化开使用。"
    }
  ],
  "variations": [
    "面团里加一点肉桂粉，香气更甜。口味会更厚一些，适合重口的人。",
    "做成小圆饼造型，更适合当零食。做法不复杂，家常灶台就能完成。",
    "表面撒孜然粒，风味更接近中东街头。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "刚出炉时外脆内软，掰开还冒热气，配一杯红茶或蘸橄榄油吃都很合适。",
  "storage": "密封常温可放两天，冷冻一个月；回温用烤箱一百八十度烤三分钟。",
