  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆提前泡八小时，煮到半软备用。，下手别慌，细节才到位。",
      "time_min": 10,
      "heat": "中火",
      "tip": "泡足时间，才煮得透。，火别太大，香气才不跑。",
      "visual_cue": "豆粒膨大，外皮易脱，料别一次下太多，口感才不散。"
    },
    {
      "n": 2,
      "text": "羊肉切块，用盐和黑胡椒抓匀。，别用力搅，整道菜才立得住。",
      "time_min": 6,
      "heat": "无火",
      "tip": "抓匀腌一下，味才进得去。，汤汁别收太干，表面才漂亮。",
      "visual_cue": "块形方正，表面挂料，料别一次下太多，形状才完整。"
    },
    {
      "n": 3,
      "text": "炖锅倒橄榄油，中火把羊肉煎上色。，盖盖焖一会儿，风味才干净。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎出焦壳，汤才够香。，盖盖焖一会儿，吃口才舒服。",
      "visual_cue": "表面褐亮，锅底有焦香，汤汁别收太干，咸淡才好把握。"
    },
    {
      "n": 4,
      "text": "羊肉盛出，下洋葱炒到透明。，注意别烧干，香气才留得住。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒软，甜味才出。，料别一次下太多，口感才不发柴。",
      "visual_cue": "洋葱透明，边缘微黄，锅温要匀，形状才完整。"
    },
    {
      "n": 5,
      "text": "加蒜末、姜末、孜然和辣椒粉炒香。，起锅前尝味，吃口才舒服。",
      "time_min": 4,
      "heat": "小火",
      "tip": "小火炒香料，才不发苦。，手法轻些，口感才有层次。",
      "visual_cue": "香气冲鼻，油色发红，翻动放轻，锅气才足。"
    },
    {
      "n": 6,
      "text": "羊肉回锅，加番茄块翻炒出汁。，锅温要匀，吃口才舒服。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒软，汁才浓。，盖盖焖一会儿，颜色才够亮。",
      "visual_cue": "番茄化开，汤汁变红，顺序照着来，成品才稳当。"
    },
    {
      "n": 7,
      "text": "倒清水和鹰嘴豆，煮开后转小火。，料别一次下太多，颜色才够亮。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水别太多，炖完要收汁。，料别一次下太多，成品才稳当。",
      "visual_cue": "液面没过食材，别急着加油，味道才进得去。"
    },
    {
      "n": 8,
      "text": "盖盖炖一小时，中途翻动两次。，手法轻些，成品才好看。",
      "time_min": 62,
      "heat": "小火",
      "tip": "翻动一下，受热才均匀。，火别太大，细节才到位。",
      "visual_cue": "汤面微沸，肉块软烂，汤汁别收太干，成品才稳当。"
    },
    {
      "n": 9,
      "text": "加葡萄干再炖十分钟，撒杏仁和香菜。，份量心里有数，表面才漂亮。",
      "time_min": 12,
      "heat": "小火",
      "tip": "葡萄干后加，甜味才不散。，盖盖焖一会儿，口感才不散。",
      "visual_cue": "汤汁浓稠，果香清甜，盖盖焖一会儿，锅气才足。"
    }
  ],
  "tips": [
    "鹰嘴豆提前泡发，才煮得软。，火别太大，整道菜才立得住。",
    "羊肉先煎上色，汤才够香。，汤汁别收太干，细节才到位。",
    "葡萄干最后加，甜味才不发酸。，汤汁别收太干，吃口才舒服。"
  ],
  "common_mistakes": [
    "鹰嘴豆没泡透，煮两小时还硬。，别急着加油，颜色才够亮。",
    "火太大，汤汁烧干粘锅。，盖盖焖一会儿，整道菜才立得住。",
    "香料炒焦，整锅发苦。，别急着加油，成品才稳当。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "鸡腿肉",
      "ratio": "800 克:800 克",
      "note": "炖制时间减三十分钟。"
    },
    {
      "original": "鹰嘴豆",
      "substitute": "红豆",
      "ratio": "200 克:200 克",
      "note": "需同样泡发，口感更绵。"
    }
  ],
  "variations": [
    "加南瓜块，汤汁更甜。，份量心里有数，味道才不闷。",
    "加柠檬皮屑，味道更清。，别急着加油，口感才不发柴。"
  ],
  "serving_suggestion": "配米饭或薄饼，撒香菜。，保持小火，口感才不散。",
  "storage": "冷藏三天，复热用小火。，汤汁别收太干，味道才不闷。",
