  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐与酵母拌匀，倒清水与橄榄油揉成柔软的面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团偏软一点，烤出的饼才不干硬。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "面团光滑柔软，按压有弹性"
    },
    {
      "n": 2,
      "text": "盖布醒发四十分钟，面团体积明显变大。趁热操作更顺手。",
      "time_min": 45,
      "heat": "无火",
      "tip": "天冷时放到温暖角落，发酵更快。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "面团膨胀，表面有细密气孔"
    },
    {
      "n": 3,
      "text": "面团分成四份滚圆，擀成直径十八厘米的圆饼坯。",
      "time_min": 8,
      "heat": "无火",
      "tip": "中间稍薄边缘略厚，奶酪才不流边。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "饼坯圆整，中间平整边缘略厚"
    },
    {
      "n": 4,
      "text": "奶酪丝与欧芹末拌匀，均匀铺在饼坯上，边缘留一厘米。",
      "time_min": 5,
      "heat": "无火",
      "tip": "边缘留白，奶酪化开才不会溢出。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "奶酪铺满中间，边缘一圈干净"
    },
    {
      "n": 5,
      "text": "烤箱预热二百度，饼坯入烤盘烤十二分钟至奶酪融化起斑。",
      "time_min": 15,
      "heat": "无火",
      "tip": "奶酪起褐色斑点就是烤到味了。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "奶酪融化冒泡，局部焦褐"
    },
    {
      "n": 6,
      "text": "出炉淋几滴橄榄油，切成四块趁热食用。趁热操作更顺手。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热切块，奶酪才不会拉断成丝团。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "切面奶酪拉丝，饼底金黄"
    }
  ],
  "tips": [
    "面团软一点，饼底才不硬。火候与时间都要盯紧，宁可略短也别过头。",
    "奶酪铺到边留一厘米，防止溢出。做之前把料备齐，下锅后就没空切配了。",
    "烤到奶酪起褐斑香气最足。这几步照顺序来，味道才会一层层叠上去。",
    "淋橄榄油提香，别省这一勺。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "面团太硬，烤出的饼底又厚又干。结果往往一锅好料全被这一步毁掉。",
    "奶酪铺到边上，烤化流满烤盘。很多人就在这里翻车，出菜后才发现。",
    "温度不够，奶酪只是化开不起斑。账面上看是小疏忽，入口立刻能尝出来。",
    "放凉才切，奶酪结成硬块。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "250克:250克",
      "note": "拉丝效果更好，咸度略低。"
    },
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "15克:15克",
      "note": "气味更冲，用量可减半。"
    }
  ],
  "variations": [
    "加几片番茄同烤，酸甜解腻。口味会更厚一些，适合重口的人。",
    "撒一点红椒粉，颜色和味道更亮。做法不复杂，家常灶台就能完成。",
    "加熟羊肉末，做成肉馅烤饼。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "切成四块趁热吃，饼底薄脆、奶酪拉丝，配一碗番茄汤或一杯薄荷茶都是好搭配。",
  "storage": "冷藏可放一天，复烤用烤箱一百八十度烤四分钟；微波会让饼底变韧。",
