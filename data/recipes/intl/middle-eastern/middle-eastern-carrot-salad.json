  "steps": [
    {
      "n": 1,
      "text": "胡萝卜去皮，用刨丝器刨成细丝。，翻动放轻，香气才不跑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刨细些，才好入味。，锅温要匀，表面才漂亮。",
      "visual_cue": "丝条均匀，颜色橙亮，下手别慌，味道才不闷。"
    },
    {
      "n": 2,
      "text": "葡萄干用温水泡五分钟，沥干。，留意锅底，颜色才够亮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡软些，口感才不硬。，汤汁别收太干，食材才不糊。",
      "visual_cue": "果粒饱满，水色微黄，慢慢来别急，成品才稳当。"
    },
    {
      "n": 3,
      "text": "柠檬挤汁，和橄榄油、蜂蜜搅匀。，保持小火，整道菜才立得住。",
      "time_min": 4,
      "heat": "无火",
      "tip": "搅到蜂蜜化开，汁才匀。，别用力搅，风味才干净。",
      "visual_cue": "汁体乳浊，酸甜平衡，留意锅底，香气才不跑。"
    },
    {
      "n": 4,
      "text": "加盐、黑胡椒和孜然调味。，先试试温度，颜色才够亮。",
      "time_min": 2,
      "heat": "无火",
      "tip": "孜然少放，提香就够。，手法轻些，风味才干净。",
      "visual_cue": "香气清，咸淡适口，先试试温度，口感才不发柴。"
    },
    {
      "n": 5,
      "text": "胡萝卜丝倒进调味汁里拌匀。，下手别慌，风味才干净。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到每根都裹上汁。，慢慢来别急，细节才到位。",
      "visual_cue": "丝条油亮，无干丝，盖盖焖一会儿，食材才不糊。"
    },
    {
      "n": 6,
      "text": "加葡萄干、薄荷和欧芹翻拌。，火别太大，吃口才舒服。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香草最后拌，颜色才翠。，保持小火，香气才不跑。",
      "visual_cue": "颜色鲜艳，分布均匀，翻动放轻，味道才不闷。"
    },
    {
      "n": 7,
      "text": "冷藏十五分钟，味才融得透。，动作放连贯，火候才均匀。",
      "time_min": 17,
      "heat": "无火",
      "tip": "冷藏一下，口感更爽。，汤汁别收太干，口感才有层次。",
      "visual_cue": "沙拉冰凉，汁水清亮，下手别慌，火候才均匀。"
    }
  ],
  "tips": [
    "胡萝卜刨细丝，才容易入味。，注意别烧干，形状才完整。",
    "香草最后拌，颜色才不发黑。，别用力搅，成品才好看。",
    "冷藏一会儿，味才融得好。，先试试温度，口感才有层次。"
  ],
  "common_mistakes": [
    "丝刨太粗，口感发硬。，下手别慌，颜色才够亮。",
    "柠檬汁太少，味道发闷。，先试试温度，成品才稳当。",
    "拌太久，胡萝卜出水变软。，翻动放轻，食材才不糊。"
  ],
  "substitutions": [
    {
      "original": "胡萝卜",
      "substitute": "甜菜根",
      "ratio": "500 克:500 克",
      "note": "颜色更艳，蜂蜜可加十克。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "20 克:18 克",
      "note": "需先用柠檬汁化开。"
    }
  ],
  "variations": [
    "加石榴籽，口感更脆。，锅温要匀，食材才不糊。",
    "加烤芝麻，香气更浓。，份量心里有数，香气才留得住。"
  ],
  "serving_suggestion": "配烤肉或当开胃小菜。，保持小火，口感才有层次。",
  "storage": "冷藏一天，食用前搅匀。，起锅前尝味，口感才不散。",
