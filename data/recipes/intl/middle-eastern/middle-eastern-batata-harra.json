  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成两厘米见方的块，用清水冲去表面的白浆后彻底擦干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面水分一定要擦干，否则下油锅会剧烈飞溅。",
      "visual_cue": "土豆块干爽，棱角分明"
    },
    {
      "n": 2,
      "text": "炒锅倒橄榄油烧到一百七十度，下土豆块中火炸十分钟至外脆内软。",
      "time_min": 12,
      "heat": "中火",
      "tip": "一次别下太多，油温掉了土豆就炸不透。",
      "visual_cue": "土豆块金黄，用筷子能轻松插透"
    },
    {
      "n": 3,
      "text": "捞出土豆放在厨房纸上沥油，静置两分钟让余温把内部焖熟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置这两分钟能让外壳更脆，别省。",
      "visual_cue": "表面干爽无浮油，外壳硬挺"
    },
    {
      "n": 4,
      "text": "另起锅留一勺底油，小火炒香蒜碎、小米辣与孜然。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜碎一变色就下土豆，炒久了会发苦。",
      "visual_cue": "蒜香扑鼻，蒜碎微黄不焦"
    },
    {
      "n": 5,
      "text": "倒入土豆块，加盐、辣椒粉与黑胡椒大火颠锅三十秒，撒香菜、淋柠檬汁即可。",
      "time_min": 4,
      "heat": "大火",
      "tip": "香菜和柠檬汁一定关火后再加，香气才留得住。",
      "visual_cue": "土豆块裹满红色香料，香菜翠绿"
    }
  ],
  "tips": [
    "土豆擦干再下锅，是避免溅油的关键。",
    "炸完静置两分钟，外壳会明显更脆。",
    "香菜和柠檬汁关火后加，香气最足。",
    "配芝麻酱蘸酱与皮塔饼，就是完整一餐。"
  ],
  "common_mistakes": [
    "土豆带水下油锅，油花四溅容易烫伤。",
    "油温不够就下土豆，炸出来又软又油。",
    "蒜碎炒到焦黑发苦，整锅菜都带上明显的焦味。",
    "香菜放得太早，一炒就发黄发黑，失去清香气。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "800克:800克",
      "note": "甜味更明显，盐可减一克。"
    },
    {
      "original": "小米辣",
      "substitute": "干辣椒",
      "ratio": "10克:6克",
      "note": "香气更浓，辣度略低。"
    }
  ],
  "variations": [
    "加一勺芝麻酱拌进热土豆，更绵密。",
    "改用空气炸锅二百度烤二十分钟，油少一半。",
    "加一把炸花生同炒，口感更丰富。"
  ],
  "serving_suggestion": "趁热装盘，表面撒香菜与柠檬角，配芝麻酱和皮塔饼，是中东餐桌最常见的配菜之一。",
  "storage": "冷藏可放两天，复热用二百度烤箱烤八分钟，微波会让外壳回软。",
