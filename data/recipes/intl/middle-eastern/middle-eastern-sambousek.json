  "equipment": [
    "平底锅",
    "碗",
    "擀面杖",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加清水、橄榄油与两克盐揉成光滑面团，盖上湿布静置二十分钟。",
      "time_min": 24,
      "heat": "无火",
      "tip": "面团揉到表面光洁再静置，擀皮时才不回缩。",
      "visual_cue": "面团光滑柔软，按下去能慢慢回弹"
    },
    {
      "n": 2,
      "text": "羊肉放进平底锅小火干炒到变色出油，加洋葱碎继续炒软。",
      "time_min": 10,
      "heat": "小火",
      "tip": "羊肉自身有油，不用另加油炒，馅才不腻。",
      "visual_cue": "绞碎的肉松散微焦，洋葱软塌透明"
    },
    {
      "n": 3,
      "text": "加盐、黑胡椒与孜然炒匀，关火拌入松子与欧芹碎，摊开放凉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馅一定要放凉再包，热馅会把饼皮烫软。",
      "visual_cue": "馅料干爽不流汁，松子颗粒分明"
    },
    {
      "n": 4,
      "text": "面团分成十二份，擀成直径十厘米的薄圆片，放一勺馅料对折成半月形。",
      "time_min": 15,
      "heat": "无火",
      "tip": "边缘捏紧后用叉子压出纹路，炸的时候才不漏馅。",
      "visual_cue": "半月形饺坯整齐，边缘压纹清晰"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油烧到一百七十度，下饺子中火炸三分钟至金黄，捞出沥油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温别太高，皮薄容易一下子焦黑。",
      "visual_cue": "外皮金黄起泡，咬开有脆响"
    }
  ],
  "tips": [
    "馅必须放凉才能包，热馅会让饼皮出水变软。",
    "边缘用叉子压纹，既好看又能防止炸时漏馅。",
    "松子先烤香再拌进馅里，香气会明显很多。",
    "一次可以多包一些冷冻，吃前直接下锅炸。"
  ],
  "common_mistakes": [
    "馅料还热就包，饼皮马上被烫得又软又黏。",
    "饼皮擀得太厚，炸完外面酥里面还是生的。",
    "油温过高，饺子下锅立刻焦黑发苦。",
    "边缘没捏紧，下锅后馅料全散在油里。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "250克:250克",
      "note": "牛肉偏瘦，可加一勺橄榄油。"
    },
    {
      "original": "松子",
      "substitute": "核桃仁",
      "ratio": "40克:40克",
      "note": "切碎后使用，香气相近。"
    }
  ],
  "variations": [
    "加一小勺石榴糖浆进馅，酸香更突出。",
    "改用烤箱二百度烤十五分钟，油量更少。",
    "做成三角形小饺，更适合当餐前小食。"
  ],
  "serving_suggestion": "炸好趁热摆在盘里，配一碟柠檬角与酸奶蘸酱，作为开胃小食或茶点都很合适。",
  "storage": "生坯可冷冻一个月，炸好的成品冷藏不超过一天，复热用二百度烤箱烤五分钟。",
