  "steps": [
    {
      "n": 1,
      "text": "欧芹去粗梗切碎，洋葱切细丝，小葱切成细葱花备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "欧芹的粗梗纤维硬，一定要去掉只用叶子。",
      "visual_cue": "香草碎细匀，洋葱丝粗细一致"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加面粉、泡打粉、盐、黑胡椒与肉桂搅到无颗粒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面粉先和蛋液调匀，再加香草才不结块。",
      "visual_cue": "蛋液顺滑，表面有细密泡沫"
    },
    {
      "n": 3,
      "text": "把欧芹、洋葱丝与葱花拌进蛋液，静置五分钟让面粉吸水。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置后饼更容易成型，煎的时候不易散。",
      "visual_cue": "蛋液浓稠挂勺，香草分布均匀"
    },
    {
      "n": 4,
      "text": "平底锅倒一半橄榄油中火烧热，倒入蛋液摊平，盖盖煎六分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "盖盖子能让表面凝固，底面又不会焦。",
      "visual_cue": "边缘定型起边，表面半凝固"
    },
    {
      "n": 5,
      "text": "翻面淋剩余橄榄油再煎四分钟至两面金黄，切块装盘。",
      "time_min": 6,
      "heat": "中火",
      "tip": "翻面要果断，拖泥带水饼容易碎。",
      "visual_cue": "两面金黄，切开断面蛋液全凝固"
    }
  ],
  "tips": [
    "欧芹用量要足，这是这道菜的灵魂。",
    "加一点泡打粉，煎出来的蛋饼会明显更蓬松柔软。",
    "小火盖盖煎，里面熟透外面不焦。",
    "配酸奶、皮塔饼与番茄黄瓜一起吃。"
  ],
  "common_mistakes": [
    "欧芹切得不碎，饼里全是硬梗，口感粗糙。",
    "火太大，底面焦了中心还是流动蛋液。",
    "不盖盖子，表面不凝固，翻面就散。",
    "面粉一次倒进蛋液，结成疙瘩搅不开。"
  ],
  "substitutions": [
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "60克:60克",
      "note": "香气更冲，用量可减到四十克。"
    },
    {
      "original": "洋葱",
      "substitute": "韭葱",
      "ratio": "100克:100克",
      "note": "更清甜，切得细一些。"
    }
  ],
  "variations": [
    "加五十克羊肉碎同煎，做成荤版更扎实。",
    "加一小勺辣椒粉拌进蛋液，微辣口味更开胃。",
    "做成小圆饼形状，方便夹进薄饼里。"
  ],
  "serving_suggestion": "切成三角块装盘，配一碗原味酸奶、几片番茄和刚出炉的薄饼，是中东家庭最常见的早餐。",
  "storage": "冷藏可放一天，复热用平底锅小火两面各烙一分钟，微波会变韧。",
