    "滤网",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扁豆洗净加清水煮十五分钟至半软，保留豆子完整，捞出沥干。",
      "time_min": 18,
      "heat": "中火",
      "tip": "扁豆只能煮到半软，煮烂了拌饭就成糊。",
      "visual_cue": "豆子捏得动但皮没破"
    },
    {
      "n": 2,
      "text": "洋葱切极细的丝，用一百毫升橄榄油小火慢炸二十五分钟至深褐酥脆。",
      "time_min": 26,
      "heat": "小火",
      "tip": "炸洋葱要全程小火，颜色一变深就苦。",
      "visual_cue": "洋葱丝缩成深褐色酥条，油色发棕"
    },
    {
      "n": 3,
      "text": "捞出炸洋葱沥油，留一半做装饰，锅里留两大勺油炒香孜然与肉桂。",
      "time_min": 2,
      "heat": "小火",
      "tip": "孜然遇热油才有那股坚果香，冷锅下没效果。",
      "visual_cue": "香料在油里翻滚，香气四溢"
    },
    {
      "n": 4,
      "text": "下扁豆与洗净的米，加盐、黑胡椒翻匀，倒入清水五百毫升煮开。",
      "time_min": 6,
      "heat": "中火",
      "tip": "水量比白饭少一些，扁豆本身含水分。",
      "visual_cue": "米豆混合均匀，水刚没过食材"
    },
    {
      "n": 5,
      "text": "转最小火加盖焖十八分钟，关火再焖十分钟，开盖用叉子翻松。",
      "time_min": 30,
      "heat": "小火",
      "tip": "焖好别马上搅拌，静置十分钟米粒才不黏。",
      "visual_cue": "米粒分明，豆子嵌在饭中"
    },
    {
      "n": 6,
      "text": "盛盘撒大量炸洋葱与香菜，配一勺酸奶一起吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "炸洋葱一定要在上桌前撒，保持脆感。",
      "visual_cue": "饭面铺满深褐色脆丝，酸奶雪白"
    }
  ],
  "tips": [
    "炸洋葱可一次多做一些，密封保存一周，配什么都香。",
    "扁豆与米的比例通常一比一，喜欢豆多可调成一比一点二。",
    "配黄瓜番茄沙拉与酸奶是完整的黎凡特一餐。"
  ],
  "common_mistakes": [
    "扁豆煮过头，拌进饭里全部碎成泥。",
    "洋葱炸时火大，外黑内生、整锅带焦苦味。",
    "焖饭中途开盖搅拌，米粒破碎、饭变糊。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "绿豆",
      "ratio": "250 克:250 克",
      "note": "煮制时间减到十分钟，口感更粉。"
    },
    {
      "original": "酸奶",
      "substitute": "柠檬",
      "ratio": "200 克:2 个",
      "note": "挤汁淋在饭上，酸味更清爽。"
    }
  ],
  "variations": [
    "加入炸松子与葡萄干，可做节庆的甜咸版本。"
  ],
  "serving_suggestion": "配酸奶、黄瓜番茄沙拉与腌橄榄一起上桌。",
  "storage": "冷藏三天，冷冻一个月；复热用蒸锅或加两勺水小火焖热。",
