        }
      ]
    }
  ],
  "equipment": [
    "烤架",
    "竹签",
    "拌菜盆",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成三厘米见方的块，用厨房纸吸干表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面干爽，腌料才挂得住。",
      "visual_cue": "鸡肉块干爽，大小一致"
    },
    {
      "n": 2,
      "text": "酸奶、柠檬汁、蒜泥、番茄膏、孜然与辣椒粉拌匀成腌料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "番茄膏先和酸奶搅开，避免结块。",
      "visual_cue": "腌料呈粉橙色，质地顺滑"
    },
    {
      "n": 3,
      "text": "鸡块放入腌料抓匀，加盐与橄榄油再抓一遍。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油最后加，能把香味封在肉里。",
      "visual_cue": "每块鸡肉都裹满橙色腌料"
    },
    {
      "n": 4,
      "text": "盖保鲜膜冷藏腌两小时，中途翻动一次让味道均匀。",
      "time_min": 120,
      "heat": "无火",
      "tip": "至少腌两小时，过夜风味更足。",
      "visual_cue": "鸡肉颜色变深，腌料渗入"
    },
    {
      "n": 5,
      "text": "竹签提前泡水三十分钟，避免上烤架后烧焦。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡透水的竹签不会烧黑断掉。",
      "visual_cue": "竹签颜色变深，手感柔软"
    },
    {
      "n": 6,
      "text": "把鸡块串到竹签上，每串五块，块与块之间留一点缝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "留缝受热均匀，也更容易翻面。",
      "visual_cue": "肉串紧实不散，排列整齐"
    },
    {
      "n": 7,
      "text": "烤架烧到中高温，肉串放上去烤七分钟，期间刷一次油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "先别急着翻，等表面定型再动。",
      "visual_cue": "表面出现焦色网纹"
    },
    {
      "n": 8,
      "text": "翻面再烤六分钟，烤到按压有弹性、中心不见粉红。",
      "time_min": 6,
      "heat": "中火",
      "tip": "中途刷油防干，别反复翻动。",
      "visual_cue": "两面焦黄，肉汁清亮"
    },
    {
      "n": 9,
      "text": "肉串离火后静置三分钟，让肉汁回流再装盘上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置后再切，肉汁才不会流干。",
      "visual_cue": "表面油亮，按压回弹"
    },
    {
      "n": 10,
      "text": "配洋葱片与香菜上桌，挤上剩下的柠檬汁一起食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生洋葱的辛香最能解腻。",
      "visual_cue": "肉串焦香，配菜清脆"
    }
  ],
  "tips": [
    "酸奶腌能让鸡肉更嫩，酸性还能去腥。",
    "竹签一定要提前泡透水，上烤架才不会烧焦。",
    "烤好静置三分钟再吃，肉汁不流失。"
  ],
  "common_mistakes": [
    "腌料里不加酸奶，鸡肉烤完又干又柴。",
    "竹签不泡水，上烤架就烧黑断裂。",
    "肉串不停翻动，表面烤不出焦纹。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "700 克:650 克",
      "note": "烤制时间各减两分钟，避免过干。"
    },
    {
      "original": "酸奶",
      "substitute": "酸奶油",
      "ratio": "150 克:150 克",
      "note": "质地更厚，需加两勺清水调开。"
    }
  ],
  "variations": [
    "腌料里加一勺辣椒酱，辣味更直接。",
    "配一碟蒜味酸奶酱蘸食，风味更浓郁。"
  ],
  "serving_suggestion": "配烤饼、番茄洋葱沙拉与蒜味酸奶酱一起上桌。",
  "storage": "冷藏两天，复热用平底锅小火两面各煎两分钟。",
