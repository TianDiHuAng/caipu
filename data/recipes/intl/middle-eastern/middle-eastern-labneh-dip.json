  ],
  "steps": [
    {
      "n": 1,
      "text": "酸奶加盐拌匀，倒进铺纱布的滤网里。，别急着加油，味道才不闷。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐能出水，酸奶才够浓。，别急着加油，风味才干净。",
      "visual_cue": "酸奶裹紧，盐水渗出，下手别慌，口感才不发柴。"
    },
    {
      "n": 2,
      "text": "纱布收口系紧，下面放碗接水。，动作放连贯，锅气才足。",
      "time_min": 4,
      "heat": "无火",
      "tip": "系紧些，才压得干。，火别太大，形状才完整。",
      "visual_cue": "布团紧实，水开始滴，顺序照着来，香气才不跑。"
    },
    {
      "n": 3,
      "text": "压上重物，冷藏六小时。，别急着加油，火候才均匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "时间够，才有浓稠质感。，留意锅底，咸淡才好把握。",
      "visual_cue": "滴水变慢，布团变硬，火别太大，口感才不发柴。"
    },
    {
      "n": 4,
      "text": "取出酸奶团，倒进碗里。，起锅前尝味，形状才完整。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刮下布上的，一点别浪费。，份量心里有数，成品才稳当。",
      "visual_cue": "质地厚实，能立勺，锅温要匀，味道才不闷。"
    },
    {
      "n": 5,
      "text": "加蒜末、柠檬汁和黑胡椒，搅到顺滑。，盖盖焖一会儿，口感才不发柴。",
      "time_min": 4,
      "heat": "无火",
      "tip": "搅匀即可，别过度搅打。，份量心里有数，颜色才够亮。",
      "visual_cue": "糊体细腻，无颗粒，动作放连贯，咸淡才好把握。"
    },
    {
      "n": 6,
      "text": "用勺背在表面压出浅浅的旋纹。，翻动放轻，成品才好看。",
      "time_min": 3,
      "heat": "无火",
      "tip": "压出纹路，油才挂得住。，动作放连贯，味道才进得去。",
      "visual_cue": "纹路清晰，深浅均匀，先试试温度，口感才不散。"
    },
    {
      "n": 7,
      "text": "淋橄榄油，撒薄荷和烤芝麻。，锅温要匀，味道才进得去。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油要淋满，才好看。，时间掐准，味道才不闷。",
      "visual_cue": "油层浮面，香草翠绿，手法轻些，口感才不发柴。"
    },
    {
      "n": 8,
      "text": "配黄瓜条和薄饼蘸食。，手法轻些，香气才不跑。，注意别烧干，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷藏取出后放五分钟再吃。，动作放连贯，细节才到位。",
      "visual_cue": "酱体微凉，香气清，慢慢来别急，成品才好看。"
    }
  ],
  "tips": [
    "压重物六小时，酸奶才够浓。，火别太大，风味才干净。",
    "盐能帮助出水，别省。，盖盖焖一会儿，形状才完整。",
    "淋油前压纹，油才会挂在表面。，留意锅底，香气才留得住。"
  ],
  "common_mistakes": [
    "滤的时间不够，蘸酱太稀。，手法轻些，颜色才够亮。",
    "盐太多，酸味发冲。，别急着加油，锅气才足。",
    "蒜末太粗，口感发辣。，起锅前尝味，口感才不发柴。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "希腊酸奶",
      "ratio": "800 克:800 克",
      "note": "本身已浓稠，滤制时间减半。"
    },
    {
      "original": "薄荷",
      "substitute": "欧芹",
      "ratio": "15 克:15 克",
      "note": "香气更平，可加一点柠檬皮。"
    }
  ],
  "variations": [
    "加一点辣椒粉，颜色更跳。，先试试温度，食材才不糊。",
    "加核桃碎，口感更丰富。，手法轻些，吃口才舒服。"
  ],
  "serving_suggestion": "配薄饼、黄瓜条和橄榄。，慢慢来别急，香气才留得住。",
  "storage": "冷藏三天，表面油封可放更久。，翻动放轻，成品才稳当。",
