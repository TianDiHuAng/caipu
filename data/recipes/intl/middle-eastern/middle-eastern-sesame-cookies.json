  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油室温软化，加白砂糖与盐打发到颜色发白、体积变轻。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油打到发白，饼才会酥松而不是硬块。",
      "visual_cue": "黄油蓬松发白，呈羽毛状"
    },
    {
      "n": 2,
      "text": "分次加入牛奶与香草精搅匀，再把面粉与泡打粉筛入拌成面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面粉筛过再拌，饼身才细腻不结块。",
      "visual_cue": "面团柔软不粘手，能整形成团"
    },
    {
      "n": 3,
      "text": "面团分成二十份搓成小圆球，表面蘸一层芝麻后轻轻压扁。",
      "time_min": 15,
      "heat": "无火",
      "tip": "球别搓太大，烤的时候还会略微摊开。",
      "visual_cue": "小饼厚薄均匀，芝麻裹满表面"
    },
    {
      "n": 4,
      "text": "鸡蛋打散刷在饼面，烤箱预热一百八十度烤十五分钟至边缘微黄。",
      "time_min": 18,
      "heat": "中火",
      "tip": "刷蛋液是为了上色和粘住芝麻，薄薄一层足够。",
      "visual_cue": "表面金黄，芝麻紧贴不脱落"
    },
    {
      "n": 5,
      "text": "出炉后在烤盘上静置五分钟再移到网架，完全放凉后密封保存。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刚出炉的饼干是软的，放凉才会变脆。",
      "visual_cue": "饼干边缘酥硬，中心微润"
    }
  ],
  "tips": [
    "黄油一定要软化到位，否则打不发。",
    "面团别过度揉，拌到无干粉就够。",
    "芝麻裹好再轻压，烤完不会掉一地。",
    "饼干要完全放凉再密封，否则水汽会让它回软。"
  ],
  "common_mistakes": [
    "黄油没软化就打，面团成一团硬块。",
    "面粉揉太久，烤出来饼干又硬又韧。",
    "烤盘直接移到冷台面，底部受潮不脆。",
    "没放凉就密封，水汽把饼干闷软。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "150克:120毫升",
      "note": "口感更脆，香气略淡。"
    },
    {
      "original": "芝麻",
      "substitute": "芝麻与核桃仁各半",
      "ratio": "100克:100克",
      "note": "坚果味更足。"
    }
  ],
  "variations": [
    "面团里加一勺肉桂粉，香气更暖。",
    "表面点缀几粒杏仁，卖相更好，坚果香也更足。",
    "做成小条状，配薄荷茶时更方便蘸着吃。"
  ],
  "serving_suggestion": "完全放凉的饼干装进铁盒或盘里，配一杯薄荷茶或阿拉伯咖啡，是中东人家待客常备的茶点。",
  "storage": "密封常温可放一周，受潮后可用一百五十度烤箱烘五分钟恢复酥脆。",
