      ]
    }
  ],
  "equipment": [
    "深锅",
    "平底锅",
    "木铲",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子切成两厘米厚的片，表面撒少许盐静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "撒盐逼水，煎的时候才不吸一肚子油。",
      "visual_cue": "茄子片表面渗出水珠，边缘略软"
    },
    {
      "n": 2,
      "text": "平底锅下橄榄油，把茄子片中火煎到两面金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎到边缘上色再翻面，别急着去动它。",
      "visual_cue": "茄子片两面焦黄，质地变软"
    },
    {
      "n": 3,
      "text": "煎好的茄子片盛出，锅里留下的油用来煸洋葱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "茄子吸的油会回吐，正好炒洋葱。",
      "visual_cue": "锅底留油，茄子堆在盘中"
    },
    {
      "n": 4,
      "text": "下洋葱丁小火炒到透明，再加蒜末炒出香味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒透，甜味才垫得住后面的酸。",
      "visual_cue": "洋葱透明发甜，蒜末微黄"
    },
    {
      "n": 5,
      "text": "牛里脊切块下锅，大火煎到表面变色锁住肉汁。",
      "time_min": 6,
      "heat": "大火",
      "tip": "肉块先煎上色，炖出来才香不柴。",
      "visual_cue": "肉块外表褐亮，内部仍带红"
    },
    {
      "n": 6,
      "text": "加孜然与盐翻炒均匀，让香料裹住每一块牛里脊。",
      "time_min": 2,
      "heat": "中火",
      "tip": "孜然遇热才出香，翻炒几下就够。",
      "visual_cue": "肉块挂满香料，锅里香气冲"
    },
    {
      "n": 7,
      "text": "倒入番茄块翻炒，加半碗清水烧开后转小火。",
      "time_min": 6,
      "heat": "小火",
      "tip": "番茄出水后炖，汤汁才浓郁自然。",
      "visual_cue": "汤汁变红，微微冒泡"
    },
    {
      "n": 8,
      "text": "把煎好的茄子铺回锅里，盖盖小火炖二十五分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "茄子铺在上面炖，吸汤又不会散开。",
      "visual_cue": "茄子软塌入味，汤汁收浓"
    },
    {
      "n": 9,
      "text": "开盖尝一下咸淡，撒少许孜然，连锅端上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后再补一次孜然，香气更立体。",
      "visual_cue": "汤汁稠亮，茄子颤而不散"
    }
  ],
  "tips": [
    "茄子先撒盐逼水，煎时少吸油又不发苦。",
    "牛肉先大火煎上色再炖，肉香才足。",
    "茄子铺面炖，不翻搅，块形完整。"
  ],
  "common_mistakes": [
    "茄子不腌直接下锅，吸干半瓶油。",
    "牛肉一直小火煮，出水变灰，肉质发柴。",
    "炖的时候不停搅，茄子全散成泥。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛腩",
      "ratio": "450 克:500 克",
      "note": "筋膜多，炖的时间加十分钟。"
    },
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "500 克:500 克",
      "note": "出水更多，煎前同样撒盐。"
    }
  ],
  "variations": [
    "加一勺番茄膏，颜色更红，味道更浓。",
    "表面撒一把松子，香气与口感都更丰富。"
  ],
  "serving_suggestion": "连锅端上桌，配皮塔饼蘸汤汁，或浇在米饭上一起吃。",
  "storage": "冷藏三天，复热时加两勺清水小火慢炖十分钟。",
