  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆泡一夜后煮到一捏即碎，捞出时顺手搓掉外层薄皮，豆泥才细腻。",
      "time_min": 10,
      "heat": "中火",
      "tip": "去皮是顺滑的关键一步。",
      "visual_cue": "豆子软烂、外皮脱落"
    },
    {
      "n": 2,
      "text": "煮好的鹰嘴豆趁热放进料理机，加芝麻酱、蒜末、柠檬汁、盐与孜然。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热打，质地更顺。",
      "visual_cue": "材料混合、豆子成粗粒"
    },
    {
      "n": 3,
      "text": "分次加冰水边打边刮壁，打到豆泥发白蓬松、能拉出尖角。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冰水让芝麻酱乳化发白。",
      "visual_cue": "质地蓬松、颜色乳白"
    },
    {
      "n": 4,
      "text": "盛盘用勺背划出螺旋纹，淋橄榄油、撒辣椒粉与孜然粉即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "划纹能兜住橄榄油。",
      "visual_cue": "表面油亮、纹路清晰"
    }
  ],
  "tips": [
    "鹰嘴豆去皮再打，口感才细腻无渣。",
    "冰水分次加，芝麻酱在低温下才乳化成乳白色。",
    "趁热打豆，淀粉糊化让豆泥更绵密。"
  ],
  "common_mistakes": [
    "豆子没煮透就打，豆泥带颗粒还发涩。",
    "一次倒入全部清水，豆泥打成稀浆。",
    "省略芝麻酱，只剩豆味毫无层次。"
  ],
  "substitutions": [
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "80g 对 70g",
      "note": "香气偏甜，柠檬汁加 10g。"
    },
    {
      "original": "鹰嘴豆",
      "substitute": "白芸豆",
      "ratio": "400g 对 400g",
      "note": "质地更细腻。"
    }
  ],
  "variations": [
    "甜菜版：加 100g 烤甜菜打成粉红色豆泥。",
    "辣味版：辣椒粉加倍，另加 5g 辣椒酱。"
  ],
  "serving_suggestion": "配皮塔饼、生蔬菜条，或抹在三明治里。",
  "storage": "冷藏密封可存 4 天，表面淋一层橄榄油隔绝空气。",
