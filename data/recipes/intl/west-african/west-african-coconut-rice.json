  "equipment": [
    "汤锅",
    "锅铲",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后沥干水分，摊开静置十分钟让表面干爽。",
      "time_min": 10,
      "heat": "无火",
      "tip": "米粒干爽，炒的时候才不容易粘锅。",
      "visual_cue": "米粒松散，不粘成一团"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，中火炒洋葱丁三分钟到变软透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒软，饭底才有自然的甜味。",
      "visual_cue": "洋葱透明发软，香气散出"
    },
    {
      "n": 3,
      "text": "下蒜末与姜末炒三十秒，闻到香味就可以下一步。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蒜姜容易焦，时间要短。",
      "visual_cue": "蒜末微黄，香味明显"
    },
    {
      "n": 4,
      "text": "倒入番茄块中火炒三分钟，炒到出汁变软成糊状。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄炒出汁，饭的颜色才漂亮。",
      "visual_cue": "番茄软烂，锅里有红色汁"
    },
    {
      "n": 5,
      "text": "倒入大米翻炒四分钟，让每粒米都裹上一层油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米炒到边缘透明，煮出来才粒粒分明。",
      "visual_cue": "米粒油亮，边缘半透明"
    },
    {
      "n": 6,
      "text": "倒入椰奶与清水，加盐搅匀后转大火煮开，注意别溢锅。",
      "time_min": 4,
      "heat": "大火",
      "tip": "水量以刚没过米面一指为准。",
      "visual_cue": "液面滚开，米粒浮起"
    },
    {
      "n": 7,
      "text": "转小火盖盖煮十八分钟，中途不要开盖搅动。",
      "time_min": 18,
      "heat": "小火",
      "tip": "开盖会让蒸汽跑掉，饭容易夹生。",
      "visual_cue": "表面出现小孔，液面收干"
    },
    {
      "n": 8,
      "text": "关火后继续焖十分钟，让余温把米粒内部闷透。",
      "time_min": 10,
      "heat": "无火",
      "tip": "焖这一步决定米饭的松软程度。",
      "visual_cue": "饭粒饱满，锅边有焦香"
    },
    {
      "n": 9,
      "text": "用饭勺从底部轻轻翻松米饭，撒上小葱碎后装盘食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "翻松让多余蒸汽散掉，饭更松。",
      "visual_cue": "饭粒分明，椰香扑鼻"
    }
  ],
  "tips": [
    "大米洗净后要沥干，炒的时候才不粘锅。",
    "煮饭全程小火并盖紧锅盖，中途不要开盖。",
    "关火焖十分钟，米粒才会内外一致。"
  ],
  "common_mistakes": [
    "米没沥干就下锅，炒的时候粘成一整块。",
    "中途开盖查看，蒸汽跑掉饭夹生。",
    "水加得太多，煮出来变成软烂的粥。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "400 毫升:400 毫升",
      "note": "香气变淡，可加一勺黄油补香。"
    },
    {
      "original": "大米",
      "substitute": "糯米",
      "ratio": "400 克:350 克",
      "note": "口感更黏，水量减少五十毫升。"
    }
  ],
  "variations": [
    "加一把葡萄干一起焖，甜味更有层次感。",
    "放几片咖喱叶同炒，香气更浓更地道。"
  ],
  "serving_suggestion": "作为主食配烤鸡或炖菜，也可单吃。",
  "storage": "冷藏两天，复热加一勺水用微波中火两分钟。",
  "nutrition_estimate": {
    "basis": "每份约 300 克",
