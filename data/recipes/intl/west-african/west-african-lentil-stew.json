          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1000,
          "unit": "ml",
          "note": "炖煮",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "深锅",
    "木铲",
    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扁豆淘洗两遍，用清水浸泡三十分钟后沥干。",
      "time_min": 32,
      "heat": "无火",
      "tip": "泡过的扁豆炖起来省时又不起渣。",
      "visual_cue": "扁豆胀大，水色微浑"
    },
    {
      "n": 2,
      "text": "洋葱切成小丁，红薯削皮后切成两厘米方块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块切得均匀，炖熟的时间才一致。",
      "visual_cue": "洋葱丁细匀，红薯块齐整"
    },
    {
      "n": 3,
      "text": "深锅下植物油，中火把洋葱丁炒到边缘发黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒出焦边，汤底的甜味才够。",
      "visual_cue": "洋葱边缘金黄，锅里有甜香"
    },
    {
      "n": 4,
      "text": "加入辣椒粉炒三十秒，让香料的辛香在油里散开。",
      "time_min": 1,
      "heat": "小火",
      "tip": "辣椒粉一炒就香，时间久了会发苦。",
      "visual_cue": "油色转红，香辣味冲上来"
    },
    {
      "n": 5,
      "text": "倒入番茄块翻炒五分钟，一直炒到软烂出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒烂成泥，汤才浓稠不发寡。",
      "visual_cue": "番茄塌软化开，汤汁变红"
    },
    {
      "n": 6,
      "text": "放入泡好的扁豆与红薯块，再倒入清水大火烧开。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水一次加足，中途添水会冲淡味。",
      "visual_cue": "汤面翻滚，食材上下浮动"
    },
    {
      "n": 7,
      "text": "转小火加盖炖二十五分钟，中途搅动两次防粘底。",
      "time_min": 25,
      "heat": "小火",
      "tip": "偶尔搅动一下，扁豆才不糊锅底。",
      "visual_cue": "扁豆软糯，红薯块边缘化开"
    },
    {
      "n": 8,
      "text": "加盐调味，再用勺背轻压几颗扁豆让汤变稠。",
      "time_min": 3,
      "heat": "小火",
      "tip": "压几颗豆，汤自然浓稠不用勾芡。",
      "visual_cue": "汤汁稠厚，勺子挂汁"
    },
    {
      "n": 9,
      "text": "盛碗之后再撒少许辣椒粉，趁热配米饭上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "表面撒一点辣粉，香气更有层次。",
      "visual_cue": "红汤油亮，冒着热气"
    }
  ],
  "tips": [
    "扁豆先泡半小时，炖得快也更易消化。",
    "番茄一定要炒烂，汤的浓度全靠它。",
    "压碎几颗扁豆，汤底自然就浓稠。"
  ],
  "common_mistakes": [
    "扁豆不泡直接炖，煮一小时还硬心。",
    "番茄没炒透就加水，汤又稀又寡。",
    "全程不搅动，锅底会糊出一层焦味。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "鹰嘴豆",
      "ratio": "300 克:300 克",
      "note": "需延长炖煮十五分钟或提前煮熟。"
    },
    {
      "original": "红薯",
      "substitute": "南瓜",
      "ratio": "200 克:250 克",
      "note": "更易化开，汤更甜。"
    }
  ],
  "variations": [
    "加一勺花生酱，汤更浓稠，坚果香突出。",
    "放一把切碎的秋葵，汤汁会更黏稠。"
  ],
  "serving_suggestion": "浇在热米饭上，配一勺辣酱和几片炸香蕉，是最常见的西非吃法。",
  "storage": "冷藏三天，冷冻可达一个月，复热时加少量清水调稀。",
