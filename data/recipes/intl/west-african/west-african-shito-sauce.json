      ]
    }
  ],
  "equipment": [
    "炒锅",
    "料理机",
    "木勺",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾米用温水泡十五分钟，捞出挤干水分，再用料理机打成粗粉。",
      "time_min": 18,
      "heat": "无火",
      "tip": "虾米一定要挤干，否则下油锅会溅。",
      "visual_cue": "虾米粉粗松且干燥"
    },
    {
      "n": 2,
      "text": "洋葱、姜和大蒜分别切碎，尽量切得细一些。",
      "time_min": 8,
      "heat": "无火",
      "tip": "三样都切细，熬出来的酱才顺滑。",
      "visual_cue": "碎末细匀，无大块"
    },
    {
      "n": 3,
      "text": "炒锅倒入植物油，中小火下洋葱碎炒五分钟到微微透明。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "火不能大，洋葱一焦整锅酱就发苦。",
      "visual_cue": "洋葱碎透明并出香气"
    },
    {
      "n": 4,
      "text": "加入姜末和大蒜末继续炒两分钟，炒到香气完全出来。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "蒜末要最后下锅，早放很容易炒糊。",
      "visual_cue": "蒜末浅黄，香气刺鼻"
    },
    {
      "n": 5,
      "text": "放入虾米粉和辣椒粉，转小火不停翻炒十分钟。",
      "time_min": 11,
      "heat": "小火",
      "tip": "全程小火勤翻，辣椒粉很容易糊底。",
      "visual_cue": "油色转红，虾米粉散开"
    },
    {
      "n": 6,
      "text": "加入番茄酱、盐和黑胡椒，继续小火熬十五分钟到酱体发亮。",
      "time_min": 16,
      "heat": "小火",
      "tip": "熬到油和料明显分层，酱才能放得久。",
      "visual_cue": "酱体深红发亮，油浮表面"
    },
    {
      "n": 7,
      "text": "关火晾凉后装进干净玻璃罐，油层要盖过酱料。",
      "time_min": 4,
      "heat": "无火",
      "tip": "晾凉再装罐，热着装会产生水汽。",
      "visual_cue": "罐内油封顶，酱色浓郁"
    }
  ],
  "tips": [
    "虾米一定要泡软挤干，否则打粉不顺还带腥味。",
    "辣椒粉必须小火慢炒，火大立刻发黑发苦。",
    "熬到油料分层才算到位，这样的酱耐放。"
  ],
  "common_mistakes": [
    "洋葱用大火炒，焦黑后整锅带苦味。",
    "虾米没挤干水分，下油锅溅油严重。",
    "熬的时间不够，酱体稀薄容易坏。"
  ],
  "substitutions": [
    {
      "original": "虾米",
      "substitute": "小鱼干",
      "ratio": "120 克:120 克",
      "note": "腥香更重，需多泡十分钟。"
    },
    {
      "original": "辣椒粉",
      "substitute": "辣椒酱",
      "ratio": "30 克:60 克",
      "note": "辣度更柔和，需减盐。"
    }
  ],
  "variations": [
    "加一小把干虾皮进去，鲜味更浓更足。",
    "喜欢更辣可留一半辣椒粉在最后加。"
  ],
  "serving_suggestion": "拌饭、配炸鱼或蘸炸香蕉吃，是加纳街边小吃摊上的万能辣酱。",
  "storage": "密封冷藏一个月，每次用干勺取，油层变浑或发酸即弃用。",
