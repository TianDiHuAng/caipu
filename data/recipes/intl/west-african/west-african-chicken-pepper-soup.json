  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切块，冷水下锅焯去血沫。，全程留意火候，别贪快。",
      "time_min": 10,
      "heat": "中火",
      "tip": "冷水下锅，血沫才逼得出来。，火大了就离锅远一点。",
      "visual_cue": "浮沫上浮，汤面变清，很多人在这里出错。"
    },
    {
      "n": 2,
      "text": "捞出鸡块，用温水冲净表面浮沫。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用温水冲，肉才不紧缩。，锅温要匀，别忽高忽低。",
      "visual_cue": "鸡块干净，汤底清亮，这里最容易翻车。"
    },
    {
      "n": 3,
      "text": "汤锅倒清水，放入鸡块大火煮开。，火力保持中等，慢慢来。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水开后再转小火，汤才清。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤面翻涌，香气升起，别小看这一步。"
    },
    {
      "n": 4,
      "text": "加洋葱丁、姜泥和拍碎的大蒜。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "中火",
      "tip": "姜蒜去腥，是这道汤的骨架。，始终中小火，别心急。",
      "visual_cue": "香味散出，汤色微黄，成败就在这一步。"
    },
    {
      "n": 5,
      "text": "加辣椒粉、红椒粉和一半黑胡椒。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香料分两次放，辣味才有层。，看住火，别让它失控。",
      "visual_cue": "汤面泛红，辛香扑鼻，这点要注意。"
    },
    {
      "n": 6,
      "text": "转小火盖盖炖三十五分钟。，全程留意火候，别贪快。",
      "time_min": 35,
      "heat": "小火",
      "tip": "小火慢炖，鸡肉才入味。，火大了就离锅远一点。",
      "visual_cue": "鸡肉离骨，汤色深黄，这是关键点。"
    },
    {
      "n": 7,
      "text": "加盐调味，再煮五分钟。，火别开太大，稳着来。，动作放缓，形状才保得住。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盐后放，鸡肉才不柴。，锅温要匀，别忽高忽低。",
      "visual_cue": "咸淡合适，汤味醇厚，别嫌麻烦，做完它。"
    },
    {
      "n": 8,
      "text": "关火撒剩余黑胡椒和香菜碎。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "关火撒香料，香气才不散。，火候宁小勿大，慢慢推进。",
      "visual_cue": "香菜鲜绿，汤面油亮，这一步别省。"
    }
  ],
  "tips": [
    "鸡肉先焯水，汤才清。，别跳过这步。",
    "香料分两次放，香气更有层。，这步最关键。",
    "香菜最后撒，颜色才绿。，很多人在这里出错。"
  ],
  "common_mistakes": [
    "火大滚煮，鸡肉发柴。，这里最容易翻车。",
    "辣椒粉一次全放，辣得发苦。，别小看这一步。",
    "盐放太早，肉硬汤咸。，成败就在这一步。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "牛肉",
      "ratio": "800 克:800 克",
      "note": "需多炖二十分钟至软。"
    },
    {
      "original": "辣椒粉",
      "substitute": "黑胡椒",
      "ratio": "6 克:10 克",
      "note": "辣度降低，香气更冲。"
    }
  ],
  "variations": [
    "加几片山药同炖，汤更稠。，这点要注意。",
    "加一点柠檬汁，酸香更亮。，这是关键点。"
  ],
  "serving_suggestion": "趁热盛碗，配米饭或面包吃。，别嫌麻烦，做完它。",
  "storage": "冷藏两天，复热后加香菜。，这一步别省。",
