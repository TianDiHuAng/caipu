  ],
  "steps": [
    {
      "n": 1,
      "text": "罗非鱼去鳞去内脏，两面各划三刀。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "划刀让味道进得去，也熟得匀。，火候要稳，别忽大忽小。",
      "visual_cue": "鱼身完整，刀口均匀"
    },
    {
      "n": 2,
      "text": "鱼身里外抹盐和黑胡椒，腌十分钟。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "盐抹匀，鱼皮才不腥。，火候要稳，别忽大忽小。",
      "visual_cue": "鱼身微湿，调味均匀"
    },
    {
      "n": 3,
      "text": "姜末、蒜末、小米辣和辣椒粉拌成酱。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌成稠糊，才好抹在鱼身。，火候要稳，别忽大忽小。",
      "visual_cue": "酱料红亮，香气冲鼻"
    },
    {
      "n": 4,
      "text": "把辣酱抹进刀口和鱼腹，塞洋葱丝。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "刀口里也要抹到，味道才透。，火候要稳，别忽大忽小。",
      "visual_cue": "鱼身挂酱，腹部鼓起"
    },
    {
      "n": 5,
      "text": "表面刷植物油，包锡纸静置十分钟。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置让味道渗进去。，火候要稳，别忽大忽小。",
      "visual_cue": "鱼身油亮，腌料贴合"
    },
    {
      "n": 6,
      "text": "烤架中火，鱼放锡纸上烤十二分钟。，火候要稳，别忽大忽小。",
      "time_min": 14,
      "heat": "中火",
      "tip": "垫锡纸防粘，鱼皮才完整。，火候要稳，别忽大忽小。",
      "visual_cue": "鱼皮微焦，香气升起"
    },
    {
      "n": 7,
      "text": "翻面再烤六分钟，刷一次油。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "中火",
      "tip": "翻面要轻，鱼肉嫩易散。，火候要稳，别忽大忽小。",
      "visual_cue": "两面焦黄，鱼眼凸出"
    },
    {
      "n": 8,
      "text": "出炉挤青柠汁，撒洋葱丝。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠提鲜，也解辣。，火候要稳，别忽大忽小。",
      "visual_cue": "鱼身油亮，酸香扑鼻"
    }
  ],
  "tips": [
    "鱼身划刀，味道才进得去。，这一点很关键。",
    "垫锡纸烤，鱼皮才不粘架。，这一点很关键。",
    "中火慢烤，鱼肉才不散。，这一点很关键。"
  ],
  "common_mistakes": [
    "火太大，鱼皮焦了肉还生。，这一点很关键。",
    "翻面太用力，鱼身散架。，这一点很关键。",
    "盐抹太少，鱼肉发腥。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "罗非鱼",
      "substitute": "海鲈鱼",
      "ratio": "800 克:800 克",
      "note": "肉质更细，烤的时间减两分钟。"
    },
    {
      "original": "小米辣",
      "substitute": "辣椒粉",
      "ratio": "15 克:6 克",
      "note": "辣味分布更均匀，少了鲜辣。"
    }
  ],
  "variations": [
    "塞几片柠檬进鱼腹，酸香更清。，这一点很关键。",
    "配洋葱番茄辣酱，风味更足。，这一点很关键。"
  ],
  "serving_suggestion": "配炸芭蕉或米饭，挤青柠汁。，这一点很关键。",
  "storage": "冷藏一天，复烤五分钟。，这一点很关键。",
