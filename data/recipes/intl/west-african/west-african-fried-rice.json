  "steps": [
    {
      "n": 1,
      "text": "大米淘净，加水煮成偏硬的饭。，火别开太大，稳着来。",
      "time_min": 18,
      "heat": "中火",
      "tip": "饭煮硬一点，炒时才不糊。，锅温要匀，别忽高忽低。",
      "visual_cue": "米粒分明，无夹生，这步最关键。"
    },
    {
      "n": 2,
      "text": "饭摊开晾凉，用手拨散结块。，火力保持中等，慢慢来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "晾凉的饭，炒出来才粒粒分明。，火候宁小勿大，慢慢推进。",
      "visual_cue": "饭粒松散，不粘手，很多人在这里出错。"
    },
    {
      "n": 3,
      "text": "鸡胸肉切小丁，用盐抓匀腌五分钟。，注意锅里温度别掉下来。",
      "time_min": 7,
      "heat": "无火",
      "tip": "鸡肉切小，熟得才快。，始终中小火，别心急。",
      "visual_cue": "肉丁整齐，表面发黏，这里最容易翻车。"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，把鸡丁炒到变白后先盛出。",
      "time_min": 6,
      "heat": "大火",
      "tip": "先炒鸡丁，锅才不串味。，看住火，别让它失控。",
      "visual_cue": "肉丁变白，表面微焦，别小看这一步。"
    },
    {
      "n": 5,
      "text": "余油炒鸡蛋，边炒边划散盛出。，全程留意火候，别贪快。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蛋液半凝就盛出，才嫩。，火大了就离锅远一点。",
      "visual_cue": "蛋块蓬松，颜色金黄，成败就在这一步。"
    },
    {
      "n": 6,
      "text": "下洋葱丁炒香，加胡萝卜丁炒两分钟。，火别开太大，稳着来。",
      "time_min": 5,
      "heat": "大火",
      "tip": "胡萝卜先下，熟度才一致。，锅温要匀，别忽高忽低。",
      "visual_cue": "洋葱透明，萝卜发亮，这点要注意。"
    },
    {
      "n": 7,
      "text": "加甜椒丁和红椒粉，翻炒一分钟。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "大火",
      "tip": "甜椒后放，保持脆度。，火候宁小勿大，慢慢推进。",
      "visual_cue": "椒丁鲜亮，香气散出，这是关键点。"
    },
    {
      "n": 8,
      "text": "倒入米饭，用铲子压散翻炒。，注意锅里温度别掉下来。",
      "time_min": 6,
      "heat": "大火",
      "tip": "压散再翻，饭才不结团。，始终中小火，别心急。",
      "visual_cue": "饭粒油亮，颗颗分开，别嫌麻烦，做完它。"
    },
    {
      "n": 9,
      "text": "放回鸡丁和鸡蛋，加盐和黑胡椒。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "大火",
      "tip": "料回锅再调味，咸淡才匀。，看住火，别让它失控。",
      "visual_cue": "颜色丰富，味道融合，这一步别省。"
    },
    {
      "n": 10,
      "text": "撒香菜碎，翻两下出锅。，全程留意火候，别贪快。，别用力搅，保持完整。",
      "time_min": 3,
      "heat": "大火",
      "tip": "香菜最后放，香气才留。，火大了就离锅远一点。",
      "visual_cue": "香气扑鼻，饭粒松散，别跳过这步。"
    }
  ],
  "tips": [
    "用隔夜饭或晾凉的饭，炒才不粘。，这步最关键。",
    "分次下料，锅温才不会掉。，很多人在这里出错。",
    "鸡蛋半凝就盛出，回锅才嫩。，这里最容易翻车。"
  ],
  "common_mistakes": [
    "饭太湿，炒成一团。，别小看这一步。，不少人栽在这里。",
    "一次下太多料，变成焖饭。，成败就在这一步。",
    "鸡蛋炒老，口感发硬。，这点要注意。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "虾仁",
      "ratio": "200 克:200 克",
      "note": "虾易熟，最后两分钟下锅。"
    },
    {
      "original": "大米",
      "substitute": "糙米",
      "ratio": "400 克:400 克",
      "note": "需多煮十分钟，口感更韧。"
    }
  ],
  "variations": [
    "加一点咖喱粉，颜色更黄。，这是关键点。",
    "加青豆和玉米粒，颜色更全。，别嫌麻烦，做完它。"
  ],
  "serving_suggestion": "配烤鸡或炸鱼，作主餐主食。，这一步别省。",
  "storage": "冷藏两天，复炒加少量水。，别跳过这步。",
