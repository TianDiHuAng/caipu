    "碗",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和冷黄油，搓成粗砂状。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，皮才酥。，看住火，别让它失控。",
      "visual_cue": "粉体松散，握团易散，别小看这一步。"
    },
    {
      "n": 2,
      "text": "加冰水揉成团，冷藏三十分钟。，全程留意火候，别贪快。",
      "time_min": 32,
      "heat": "无火",
      "tip": "别多揉，起筋就硬。，火大了就离锅远一点。",
      "visual_cue": "面团光滑，手感凉，成败就在这一步。"
    },
    {
      "n": 3,
      "text": "锅倒植物油，炒洋葱丁到透明。，火别开太大，稳着来。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒软，馅才甜。，锅温要匀，别忽高忽低。",
      "visual_cue": "洋葱透明，香气散出，这点要注意。"
    },
    {
      "n": 4,
      "text": "加牛肉末炒散，炒到变色出油。，火力保持中等，慢慢来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉末炒散，别结块。，火候宁小勿大，慢慢推进。",
      "visual_cue": "肉末松散，颜色变深，这是关键点。"
    },
    {
      "n": 5,
      "text": "加土豆丁和胡萝卜丁炒三分钟。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蔬菜切小，才易熟。，始终中小火，别心急。",
      "visual_cue": "丁块透亮，微微发软，别嫌麻烦，做完它。"
    },
    {
      "n": 6,
      "text": "加咖喱粉、盐和黑胡椒炒匀，晾凉。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "小火",
      "tip": "馅要晾凉，否则皮会破。，看住火，别让它失控。",
      "visual_cue": "馅料干爽，香气浓郁，这一步别省。"
    },
    {
      "n": 7,
      "text": "面团分小份，擀成圆片。，全程留意火候，别贪快。，慢慢推，别拉扯。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致，烤时才同步。，火大了就离锅远一点。",
      "visual_cue": "圆片均匀，边缘薄，别跳过这步。"
    },
    {
      "n": 8,
      "text": "包入馅料，捏紧边缘压出花边。，火别开太大，稳着来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "边缘捏紧，烤时才不漏。，锅温要匀，别忽高忽低。",
      "visual_cue": "花边整齐，形状饱满，这步最关键。"
    },
    {
      "n": 9,
      "text": "表面刷蛋液，扎几个小孔。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "扎孔排气，烤时不开裂。，火候宁小勿大，慢慢推进。",
      "visual_cue": "表面油亮，孔位均匀，很多人在这里出错。"
    },
    {
      "n": 10,
      "text": "一百八十度烤二十五分钟到金黄。，注意锅里温度别掉下来。",
      "time_min": 27,
      "heat": "无火",
      "tip": "烤到金黄，皮才酥。，始终中小火，别心急。",
      "visual_cue": "表面金黄，香气外溢，这里最容易翻车。"
    }
  ],
  "tips": [
    "黄油要冷，皮才酥。，别小看这一步。，多数人会忘了这一步。",
    "馅要晾凉再包，皮才不破。，成败就在这一步。",
    "表面扎孔排气，烤时不开裂。，这点要注意。"
  ],
  "common_mistakes": [
    "面团揉过头，烤后发硬。，这是关键点。",
    "馅太湿，底部湿软。，别嫌麻烦，做完它。，细节就在这里。",
    "边缘没捏紧，馅漏出来。，这一步别省。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "鸡肉末",
      "ratio": "400 克:400 克",
      "note": "更清淡，可多加咖喱粉一克。"
    },
    {
      "original": "黄油",
      "substitute": "人造黄油",
      "ratio": "120 克:120 克",
      "note": "酥度略降，需冷藏面团更久。"
    }
  ],
  "variations": [
    "做成小三角，适合当茶点。，别跳过这步。",
    "馅里加一点辣椒粉，味道更冲。，这步最关键。"
  ],
  "serving_suggestion": "趁热吃，配一杯冰饮解腻。，很多人在这里出错。",
  "storage": "冷藏三天，复烤八分钟。，这里最容易翻车。",
