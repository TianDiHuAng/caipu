  "steps": [
    {
      "n": 1,
      "text": "番茄、红椒和红葱头打成粗糊。，火别开太大，稳着来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打粗一点，保留口感层次。，锅温要匀，别忽高忽低。",
      "visual_cue": "糊体红亮，质地不均"
    },
    {
      "n": 2,
      "text": "菠菜洗净切段，焯水十秒捞出。，火力保持中等，慢慢来。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯太久会发黄发涩。，火候宁小勿大，慢慢推进。",
      "visual_cue": "菠菜翠绿，体积缩小"
    },
    {
      "n": 3,
      "text": "锅热棕榈油，下小米辣和虾米炒香。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "棕榈油一热就出红，别烧冒烟。，始终中小火，别心急。",
      "visual_cue": "油色橙红，香气浓烈"
    },
    {
      "n": 4,
      "text": "倒入打好的蔬菜糊，中火炒十分钟。，火要均匀，食材才不糊。",
      "time_min": 12,
      "heat": "中火",
      "tip": "炒到水分收干，酱才不稀。，看住火，别让它失控。",
      "visual_cue": "糊体浓稠，油酱分离"
    },
    {
      "n": 5,
      "text": "加牛肉小块翻炒，倒清水炖二十分钟。，全程留意火候，别贪快。",
      "time_min": 22,
      "heat": "小火",
      "tip": "牛肉切小，才和菜一起熟。，火大了就离锅远一点。",
      "visual_cue": "肉块软嫩，汤汁减少"
    },
    {
      "n": 6,
      "text": "放菠菜翻炒，煮三分钟就够。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "菠菜最后放，颜色才绿。，锅温要匀，别忽高忽低。",
      "visual_cue": "菠菜软塌，颜色鲜绿"
    },
    {
      "n": 7,
      "text": "加盐和黑胡椒调味，拌匀出锅。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后加，菠菜不出水。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤汁浓稠，油光浮面"
    }
  ],
  "tips": [
    "蔬菜糊要炒干水分，味道才浓。，很多人在这里出错。",
    "菠菜最后放，颜色翠绿不发黄。，这里最容易翻车。",
    "棕榈油是灵魂，颜色和香气都靠它。"
  ],
  "common_mistakes": [
    "糊没炒干就下菜，成品稀汤寡水。，别小看这一步。",
    "菠菜久煮，颜色发黑发苦。，成败就在这一步。",
    "盐放太早，出一锅绿水。，这点要注意。"
  ],
  "substitutions": [
    {
      "original": "棕榈油",
      "substitute": "植物油",
      "ratio": "50 毫升:50 毫升",
      "note": "少了橙红色，需加辣椒粉五克。"
    },
    {
      "original": "菠菜",
      "substitute": "红薯叶",
      "ratio": "700 克:700 克",
      "note": "口感更滑，煮的时间加两分钟。"
    }
  ],
  "variations": [
    "加鱼干同炖，鲜味更足。，这是关键点。",
    "加花生酱一勺，汤汁更厚。，别嫌麻烦，做完它。"
  ],
  "serving_suggestion": "配米饭或木薯泥，汤汁拌饭。，这一步别省。",
  "storage": "冷藏两天，复热须煮透。，别跳过这步。",
