  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 450,
          "unit": "g",
          "note": "过筛",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 500,
          "unit": "ml",
          "note": "炸制",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 7,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 70,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "平衡甜味",
          "optional": false
        },
        {
          "name": "肉豆蔻",
          "name_en": "nutmeg",
          "amount": 1,
          "unit": "g",
          "note": "磨粉",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 350,
          "unit": "ml",
          "note": "约四十度",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "炒锅",
    "漏勺",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水加白糖和酵母搅匀，静置八分钟到表面起一层泡沫。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水摸起来温热不烫手，酵母才活得起来。",
      "visual_cue": "表面浮起细密泡沫"
    },
    {
      "n": 2,
      "text": "中筋面粉先过筛一遍，加盐和肉豆蔻粉拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉类先拌匀，后面才不会结成块。",
      "visual_cue": "粉体蓬松，没有颗粒"
    },
    {
      "n": 3,
      "text": "把酵母水倒进面粉，搅成浓稠不流动的面糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面糊要稠到能挂住勺子，太稀炸不成球。",
      "visual_cue": "面糊稠厚，能挂住勺"
    },
    {
      "n": 4,
      "text": "盖保鲜膜放在温暖处发酵一小时，面糊膨胀到两倍并起大泡。",
      "time_min": 65,
      "heat": "无火",
      "tip": "发酵到位了，口感才会蓬松轻盈。",
      "visual_cue": "面糊涨大，布满气泡"
    },
    {
      "n": 5,
      "text": "面糊用勺子轻轻排气，静置十分钟让气泡稳定。",
      "time_min": 12,
      "heat": "无火",
      "tip": "排气后静置，球体炸出来才不塌。",
      "visual_cue": "气泡减少，面糊平滑"
    },
    {
      "n": 6,
      "text": "植物油烧到一百六十度，用勺子舀面糊挤成小球下锅。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温太高，外皮焦里面还是生的。",
      "visual_cue": "球体浮起，缓慢上色"
    },
    {
      "n": 7,
      "text": "小火炸四分钟到金黄色，捞出沥油稍微放凉。",
      "time_min": 4,
      "heat": "小火",
      "tip": "炸的时候轻轻推动，受热才均匀。",
      "visual_cue": "外壳金黄，按压回弹"
    }
  ],
  "tips": [
    "面糊要稠到能挂勺，太稀下锅就散。",
    "发酵到表面布满气泡，炸出来才蓬松。",
    "油温控制在一百六十度，外焦里生多半是火大。"
  ],
  "common_mistakes": [
    "面糊调得太稀，下锅摊成一片不成球。",
    "发酵时间不够，成品又硬又实像石头。",
    "油温过高，外皮发黑里面还是生面糊。"
  ],
  "substitutions": [
    {
      "original": "肉豆蔻",
      "substitute": "肉桂",
      "ratio": "1 克:2 克",
      "note": "香气更甜，适合嗜甜的口味。"
    },
    {
      "original": "中筋面粉",
      "substitute": "低筋面粉",
      "ratio": "450 克:450 克",
      "note": "口感更松软，需略减水量。"
    }
  ],
  "variations": [
    "面糊里加一勺可可粉，做成巧克力版本。",
    "炸好后滚一层糖粉，甜味更集中。"
  ],
  "serving_suggestion": "趁热配一杯冰镇姜汁饮料或辣椒酱，是西非街头和派对必备的小吃。",
  "storage": "常温密封一天，冷藏两天；复热用一百八十度烤箱五分钟恢复外壳。",
