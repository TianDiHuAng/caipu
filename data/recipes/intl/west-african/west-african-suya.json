  "equipment": [
    "竹签",
    "烤架或烤箱",
    "研钵",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆纹切成三毫米薄片，用厨房纸吸干表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逆纹切薄，烤出来才嫩不塞牙。",
      "visual_cue": "肉片薄而完整，透光可见"
    },
    {
      "n": 2,
      "text": "花生小火干炒到出香，放凉后用研钵磨成粗粉。",
      "time_min": 8,
      "heat": "小火",
      "tip": "花生磨成粗粉比细粉更有颗粒香，别磨出油。",
      "visual_cue": "花生碎松散，香气坚果味浓"
    },
    {
      "n": 3,
      "text": "把花生碎粒、辣椒粉、孜然、姜末、蒜末与盐拌匀成香料粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香料粉现拌现用，香气最足。",
      "visual_cue": "粉料颜色红褐，辛香扑鼻"
    },
    {
      "n": 4,
      "text": "牛肉片倒入一半香料粉抓匀，冷藏腌二十分钟。",
      "time_min": 21,
      "heat": "无火",
      "tip": "腌料里的盐能让肉入味，别超过半小时。",
      "visual_cue": "肉片表面挂粉，手感微黏"
    },
    {
      "n": 5,
      "text": "竹签提前泡水，把腌好的牛肉片穿上，每串三到四片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉片别穿太紧，留空隙才烤得透。",
      "visual_cue": "串型整齐，肉片不重叠"
    },
    {
      "n": 6,
      "text": "烤架烧到高温，肉串两面各烤三分钟，中途刷植物油。",
      "time_min": 7,
      "heat": "大火",
      "tip": "高温短烤能让表面焦香而里面多汁。",
      "visual_cue": "表面焦褐，边缘微卷"
    },
    {
      "n": 7,
      "text": "出炉后再撒上剩余的香料粉，配洋葱圈同吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "最后撒的那层粉是 suya 的招牌风味。",
      "visual_cue": "肉串表面泛红，洋葱圈清爽"
    }
  ],
  "tips": [
    "花生碎粒是风味的核心，别用花生酱代替，太湿。",
    "牛肉选带一点脂肪的部位，烤后不干。",
    "竹签务必泡水，否则会烤断甚至起火。"
  ],
  "common_mistakes": [
    "肉片切得太厚，外面焦了里面还生。",
    "花生碎粒磨得太细出油，裹上去一坨糊。",
    "烤前没刷油，肉片烤得干硬嚼不动。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "600 克:600 克",
      "note": "加孜然两克，风味更接近北非烤串。"
    },
    {
      "original": "花生",
      "substitute": "腰果",
      "ratio": "100 克:100 克",
      "note": "香气更甜，磨碎后质地更绵。"
    }
  ],
  "variations": [
    "牛肉换成鸡胸肉片，烤制时间缩短一半。",
    "加一小勺咖喱粉同拌，风味更复合。"
  ],
  "serving_suggestion": "用报纸包着吃，配洋葱圈和番茄片，再来一杯冰饮。",
  "storage": "生串冷藏一天，熟串冷藏两天；复热用烤箱二百度五分钟，别用微波。",
