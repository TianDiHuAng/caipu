  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "香蕉",
          "name_en": "banana",
          "amount": 600,
          "unit": "g",
          "note": "选偏硬未全熟的",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "磨成姜泥",
          "optional": false
        },
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 3,
          "unit": "g",
          "note": "提辣",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "一小撮",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 350,
          "unit": "ml",
          "note": "小锅浅炸用",
          "optional": false
        },
        {
          "name": "青柠",
          "name_en": "lime",
          "amount": 30,
          "unit": "g",
          "note": "挤汁防氧化",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炸锅",
    "漏勺",
    "拌菜盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香蕉剥皮切成两厘米厚的斜片，切口要平整均匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "选偏硬的香蕉，太熟一炸就烂。",
      "visual_cue": "香蕉片厚薄一致，边缘整齐"
    },
    {
      "n": 2,
      "text": "姜磨成细泥，与辣椒粉、黑胡椒和盐调成香料糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "姜泥越细，裹得越均匀。",
      "visual_cue": "香料糊浓稠，颜色橙红"
    },
    {
      "n": 3,
      "text": "香蕉片放入盆中，淋青柠汁后倒入香料糊抓匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁能防氧化，也让味道更亮。",
      "visual_cue": "每片香蕉都裹上香料"
    },
    {
      "n": 4,
      "text": "静置十分钟让香料渗进香蕉，表面微微出水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置后更入味，炸出来更香。",
      "visual_cue": "香蕉片颜色变深，表面湿润"
    },
    {
      "n": 5,
      "text": "炸锅倒植物油，中火烧到插入筷子时周围冒密集小泡。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温太低会吸油，太高会外焦内生。",
      "visual_cue": "筷子周围冒密集小泡"
    },
    {
      "n": 6,
      "text": "炸锅倒植物油，中火烧到插入筷子时周围冒小泡。",
      "time_min": 3,
      "heat": "中火",
      "tip": "一次别下太多，油温才掉不下来。",
      "visual_cue": "表面金黄，边缘微微起泡"
    },
    {
      "n": 7,
      "text": "分批下香蕉片，炸三分钟左右到表面金黄定型。",
      "time_min": 2,
      "heat": "中火",
      "tip": "两面都上色，口感才一致。",
      "visual_cue": "外壳深金，轻敲有脆响"
    },
    {
      "n": 8,
      "text": "捞出放厨房纸上沥掉多余油分，趁热撒一点盐。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热撒盐，咸甜对比更明显。",
      "visual_cue": "表面干爽，不滴油"
    }
  ],
  "tips": [
    "香蕉要选硬一点的，熟透的一炸就散。",
    "香料糊里加姜泥，是西非风味的核心。",
    "分批下锅复炸，油温才稳得住，成品更酥脆。"
  ],
  "common_mistakes": [
    "用熟透的香蕉，下锅就化成一团。",
    "油温不够就下锅，成品吸油发软。",
    "一次全部下锅，香蕉会粘连成一整坨。"
  ],
  "substitutions": [
    {
      "original": "香蕉",
      "substitute": "芭蕉",
      "ratio": "600 克:600 克",
      "note": "粉质更多，口感更粉糯。"
    },
    {
      "original": "辣椒粉",
      "substitute": "小米辣",
      "ratio": "3 克:2 个",
      "note": "需切碎后拌入，辣味更冲。"
    }
  ],
  "variations": [
    "表面撒一撮花生碎，增加坚果的香气。",
    "配一碟辣味花生酱蘸食，风味更浓。"
  ],
  "serving_suggestion": "热食最佳，配烤花生或一杯冰饮解辣。",
  "storage": "现炸现吃，冷藏后回锅复炸两分钟恢复酥脆。",
