      "group": "main",
      "items": [
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 500,
          "unit": "g",
          "note": "切块",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 150,
          "unit": "g",
          "note": "切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 8,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 60,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 20,
          "unit": "g",
          "note": "去皮",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "搅拌机",
    "汤锅",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫一分钟后撕掉外皮切块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "去皮后酱体更细腻不涩。",
      "visual_cue": "外皮轻松撕下，果肉饱满"
    },
    {
      "n": 2,
      "text": "洋葱、姜和大蒜分别切小块，方便一起打碎。",
      "time_min": 4,
      "heat": "无火",
      "tip": "切小些，机器打得更匀。",
      "visual_cue": "配料切成大小相近的小块"
    },
    {
      "n": 3,
      "text": "所有材料放进搅拌机，打成带细小颗粒的粗酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "别打太细，留颗粒口感更好。",
      "visual_cue": "酱体浓稠，仍有细颗粒"
    },
    {
      "n": 4,
      "text": "汤锅倒植物油中火烧热，倒入打好的酱料翻炒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要够热，酱才不粘锅。",
      "visual_cue": "酱料下锅发出沙沙声"
    },
    {
      "n": 5,
      "text": "不停翻炒十分钟，让水分慢慢蒸发掉一部分。",
      "time_min": 10,
      "heat": "中火",
      "tip": "勤翻防糊底，锅边溅油注意。",
      "visual_cue": "酱体变稠，颜色转深红"
    },
    {
      "n": 6,
      "text": "加辣椒粉与盐翻匀，转小火继续慢炒十五分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "小火慢炒，辣味才融进酱里。",
      "visual_cue": "表面浮出一层红油"
    },
    {
      "n": 7,
      "text": "炒到酱体抱团、油酱微微分离时尝味调整咸淡。",
      "time_min": 2,
      "heat": "小火",
      "tip": "油浮出来说明水分够了。",
      "visual_cue": "酱体油亮，铲过留痕"
    },
    {
      "n": 8,
      "text": "关火放凉后装进干净玻璃瓶，表面淋一层油封口。",
      "time_min": 3,
      "heat": "无火",
      "tip": "封油能延长保存时间。",
      "visual_cue": "瓶口油层完整覆盖酱面"
    }
  ],
  "tips": [
    "番茄先去皮，酱体口感才细腻不涩。",
    "全程中小火并勤翻炒，避免糊底发苦。",
    "装瓶后表面淋一层油，能多存几天。"
  ],
  "common_mistakes": [
    "一直用大火猛炒，酱还没稠就糊了底。",
    "辣椒粉一次全下，辣到盖住番茄的酸甜。",
    "装进带水的瓶子，两天就发酸变质。"
  ],
  "substitutions": [
    {
      "original": "辣椒粉",
      "substitute": "辣椒酱",
      "ratio": "8 克:30 克",
      "note": "湿度更高，炒制时间加五分钟。"
    },
    {
      "original": "植物油",
      "substitute": "花生油",
      "ratio": "60 毫升:60 毫升",
      "note": "坚果香更浓，适合配烤肉。"
    }
  ],
  "variations": [
    "加一小把虾皮同炒，鲜味会更加充足。",
    "加半个青椒进去，辣味更清香一些。"
  ],
  "serving_suggestion": "配米饭、烤肉或炸物，一勺就能提味。",
  "storage": "冷藏两周，每次用干净干勺取用。",
  "nutrition_estimate": {
    "basis": "每份约 80 克",
