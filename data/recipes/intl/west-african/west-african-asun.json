  "steps": [
    {
      "n": 1,
      "text": "牛肉切三厘米块，冷水下锅煮二十分钟。，注意锅里温度别掉下来。",
      "time_min": 22,
      "heat": "中火",
      "tip": "煮到七成熟，再烤才不干。，始终中小火，别心急。",
      "visual_cue": "肉块变色，汤色发白"
    },
    {
      "n": 2,
      "text": "捞出沥干，放凉后切小块。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "煮过再切，块才方正。，看住火，别让它失控。",
      "visual_cue": "肉块干爽，切面平整"
    },
    {
      "n": 3,
      "text": "小米辣、蒜末和姜末捣成粗酱。，全程留意火候，别贪快。",
      "time_min": 5,
      "heat": "无火",
      "tip": "捣比打更香，汁水不外流。，火大了就离锅远一点。",
      "visual_cue": "酱体粗糙，辣香冲鼻"
    },
    {
      "n": 4,
      "text": "肉块加辣酱、辣椒粉和盐抓匀。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "抓匀后腌十分钟，味道才进。，锅温要匀，别忽高忽低。",
      "visual_cue": "肉块挂酱，颜色转红"
    },
    {
      "n": 5,
      "text": "加洋葱丝和植物油拌开。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油能锁住水分，烤后不柴。，火候宁小勿大，慢慢推进。",
      "visual_cue": "肉块油亮，洋葱分散"
    },
    {
      "n": 6,
      "text": "烤箱二百度烤十五分钟，中途翻一次。，注意锅里温度别掉下来。",
      "time_min": 17,
      "heat": "无火",
      "tip": "高温快烤，表面才焦香。，始终中小火，别心急。",
      "visual_cue": "边缘焦褐，油脂滋滋"
    },
    {
      "n": 7,
      "text": "出炉撒黑胡椒，挤青柠汁。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠离火后挤，酸香更鲜。，看住火，别让它失控。",
      "visual_cue": "肉块油亮，酸辣扑鼻"
    }
  ],
  "tips": [
    "先煮后烤，肉才不干硬。，这步最关键。",
    "烤温要高，表面才有焦香。，很多人在这里出错。",
    "青柠最后挤，酸香不挥发。，这里最容易翻车。"
  ],
  "common_mistakes": [
    "生肉直接烤，外面焦里面生。，别小看这一步。",
    "煮太久再烤，肉干得像柴。，成败就在这一步。",
    "辣酱放太少，只剩咸味。，这点要注意。"
  ],
  "substitutions": [
    {
      "original": "辣椒粉",
      "substitute": "小米辣",
      "ratio": "8 克:20 克",
      "note": "辣味更鲜，量要减半。"
    },
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "700 克:700 克",
      "note": "煮的时间延长五分钟。"
    }
  ],
  "variations": [
    "加一点啤酒腌，肉更松软。，这是关键点。",
    "配洋葱生菜同拌，口感更清爽。，别嫌麻烦，做完它。"
  ],
  "serving_suggestion": "当小菜配啤酒，或配米饭。，这一步别省。",
  "storage": "冷藏两天，复烤五分钟。，别跳过这步。",
