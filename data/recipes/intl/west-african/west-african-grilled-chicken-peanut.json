  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨，用刀背轻拍松肉。，火别开太大，稳着来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "拍松肉纤维，腌料才进得去。，锅温要匀，别忽高忽低。",
      "visual_cue": "肉片变薄，厚度均匀，很多人在这里出错。"
    },
    {
      "n": 2,
      "text": "花生酱加酸奶搅开，调成顺滑糊。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先调稀，才裹得匀。，火候宁小勿大，慢慢推进。",
      "visual_cue": "糊体顺滑，无颗粒，这里最容易翻车。"
    },
    {
      "n": 3,
      "text": "加姜泥、蒜泥、辣椒粉、红椒粉和孜然。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香料全下，味道才立体。，始终中小火，别心急。",
      "visual_cue": "糊体发红，香气冲鼻，别小看这一步。"
    },
    {
      "n": 4,
      "text": "加柠檬汁和盐，拌匀成腌料。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁嫩肉，别省。，看住火，别让它失控。",
      "visual_cue": "咸淡合适，酸香明显，成败就在这一步。"
    },
    {
      "n": 5,
      "text": "鸡肉抹满腌料，冷藏一小时。，全程留意火候，别贪快。",
      "time_min": 62,
      "heat": "无火",
      "tip": "腌够时间，味道才进肉。，火大了就离锅远一点。",
      "visual_cue": "表面裹匀，颜色发红，这点要注意。"
    },
    {
      "n": 6,
      "text": "取出回温十分钟，刷一层植物油。，火别开太大，稳着来。",
      "time_min": 12,
      "heat": "无火",
      "tip": "回温再烤，肉才不老。，锅温要匀，别忽高忽低。",
      "visual_cue": "表面油亮，温度不冰，这是关键点。"
    },
    {
      "n": 7,
      "text": "烤盘铺纸，鸡肉平铺不要重叠。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "留空隙，受热才均匀。，火候宁小勿大，慢慢推进。",
      "visual_cue": "排列整齐，互不接触，别嫌麻烦，做完它。"
    },
    {
      "n": 8,
      "text": "二百度烤二十分钟，中途翻面刷油。，注意锅里温度别掉下来。",
      "time_min": 22,
      "heat": "无火",
      "tip": "中途刷油，表面才不干。，始终中小火，别心急。",
      "visual_cue": "表面焦褐，肉汁微冒，这一步别省。"
    },
    {
      "n": 9,
      "text": "再烤五分钟上色，边缘微焦即可。，火要均匀，食材才不糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "最后上色，别烤过头。，看住火，别让它失控。",
      "visual_cue": "边缘焦香，肉心熟透，别跳过这步。"
    },
    {
      "n": 10,
      "text": "静置五分钟切条，撒香菜和柠檬汁。，全程留意火候，别贪快。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置锁汁，切开才不流。，火大了就离锅远一点。",
      "visual_cue": "肉汁清亮，切面嫩白，这步最关键。"
    }
  ],
  "tips": [
    "腌料先调稀，才裹得匀。，很多人在这里出错。",
    "腌够一小时，味道才深。，这里最容易翻车。",
    "烤后静置，肉汁才不回流失。，别小看这一步。"
  ],
  "common_mistakes": [
    "腌料太稠，烤后结块发苦。，成败就在这一步。",
    "直接用冰肉烤，外焦内生。，这点要注意。",
    "烤过头，鸡肉发柴。，这是关键点。，别重复别人的错。"
  ],
  "substitutions": [
    {
      "original": "花生酱",
      "substitute": "芝麻酱",
      "ratio": "100 克:100 克",
      "note": "香气更淡，可加孜然一克。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "700 克:700 克",
      "note": "更瘦，烤制时间减五分钟。"
    }
  ],
  "variations": [
    "串成烤串，烟火气更足。，别嫌麻烦，做完它。",
    "配洋葱丝和番茄同烤，汁水更足。，这一步别省。"
  ],
  "serving_suggestion": "配洋葱番茄沙拉和烤饼，挤柠檬汁。，别跳过这步。",
  "storage": "冷藏两天，复烤五分钟。，这步最关键。",
