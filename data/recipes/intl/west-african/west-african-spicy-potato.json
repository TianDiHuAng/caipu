  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切三厘米见方的块。，锅温要匀，别忽高忽低。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块大小一致，熟度才匀。，火力保持中等，慢慢来。",
      "visual_cue": "块形方正，切口平整，这是关键点。"
    },
    {
      "n": 2,
      "text": "清水加盐煮开，土豆煮八分钟。，火候宁小勿大，慢慢推进。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煮到半熟就捞，煎时才不烂。，注意锅里温度别掉下来。",
      "visual_cue": "筷子能插入，边缘不散，别嫌麻烦，做完它。"
    },
    {
      "n": 3,
      "text": "捞出沥干，摊开晾到表面干爽。，始终中小火，别心急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面干爽，煎时才上色。，火要均匀，食材才不糊。",
      "visual_cue": "表面无水，边缘微白，这一步别省。"
    },
    {
      "n": 4,
      "text": "平底锅倒植物油，中火煎土豆块。，看住火，别让它失控。",
      "time_min": 8,
      "heat": "中火",
      "tip": "别急着翻，定型再动。，全程留意火候，别贪快。",
      "visual_cue": "底面金黄，形状完整，别跳过这步。"
    },
    {
      "n": 5,
      "text": "翻面继续煎六分钟到四面金黄。，火大了就离锅远一点。",
      "time_min": 7,
      "heat": "中火",
      "tip": "四面都煎到，口感才一致。，火别开太大，稳着来。",
      "visual_cue": "外皮金黄，按压微软，这步最关键。"
    },
    {
      "n": 6,
      "text": "盛出土豆，余油炒洋葱丁和蒜末。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒香，酱汁才甜。，火力保持中等，慢慢来。",
      "visual_cue": "洋葱透明，蒜香散出，很多人在这里出错。"
    },
    {
      "n": 7,
      "text": "加甜椒丁、辣椒粉和红椒粉炒香。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料遇油，辣味才开。，注意锅里温度别掉下来。",
      "visual_cue": "油色泛红，香气冲鼻，这里最容易翻车。"
    },
    {
      "n": 8,
      "text": "放回土豆，加盐和黑胡椒翻匀。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "翻炒要轻，别把块弄碎。，火要均匀，食材才不糊。",
      "visual_cue": "表面裹匀，颜色红亮，别小看这一步。"
    },
    {
      "n": 9,
      "text": "挤柠檬汁，撒香菜碎出锅。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬提酸，味道才不闷。，全程留意火候，别贪快。",
      "visual_cue": "香气清亮，颜色鲜），成败就在这一步。"
    }
  ],
  "tips": [
    "先煮半熟再煎，外脆内软。，这点要注意。",
    "表面晾干再下锅，才不粘。，这是关键点。",
    "香料用油炒过，辣味才香。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "煮太软，煎时全碎。，这一步别省。，稳住这步就成了一半。",
    "锅不够热，土豆吸油。，别跳过这步。",
    "一次下太多，变成焖土豆。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "700 克:700 克",
      "note": "更甜，煮制时间减两分钟。"
    },
    {
      "original": "辣椒粉",
      "substitute": "黑胡椒",
      "ratio": "5 克:8 克",
      "note": "辣度降低，香气更浓。"
    }
  ],
  "variations": [
    "加炒鸡蛋同拌，做成早餐。，很多人在这里出错。",
    "撒一点孜然粉，香味更足。，这里最容易翻车。"
  ],
  "serving_suggestion": "趁热装盘，配一杯冷饮。，别小看这一步。",
  "storage": "冷藏两天，复煎五分钟。，成败就在这一步。",
