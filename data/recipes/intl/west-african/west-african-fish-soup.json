  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞洗净，切成厚段。，注意锅里温度别掉下来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼段厚薄一致，熟度才匀。，始终中小火，别心急。",
      "visual_cue": "鱼段整齐，表面干爽，很多人在这里出错。"
    },
    {
      "n": 2,
      "text": "鱼段抹盐和柠檬汁，腌十分钟。，火要均匀，食材才不糊。",
      "time_min": 12,
      "heat": "无火",
      "tip": "柠檬去腥，鱼肉也更紧。，看住火，别让它失控。",
      "visual_cue": "鱼皮发亮，腥味变淡，这里最容易翻车。"
    },
    {
      "n": 3,
      "text": "汤锅倒清水，加姜片和洋葱丝煮开。，全程留意火候，别贪快。",
      "time_min": 8,
      "heat": "大火",
      "tip": "姜先下，汤底才不腥。，火大了就离锅远一点。",
      "visual_cue": "汤面翻涌，香气升起，别小看这一步。"
    },
    {
      "n": 4,
      "text": "加番茄块，小火煮十分钟出味。，火别开太大，稳着来。",
      "time_min": 12,
      "heat": "小火",
      "tip": "番茄煮出汁，汤才红亮。，锅温要匀，别忽高忽低。",
      "visual_cue": "汤色转红，番茄软塌，成败就在这一步。"
    },
    {
      "n": 5,
      "text": "加辣椒粉、红椒粉和拍碎的大蒜。，火力保持中等，慢慢来。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香料下锅，汤味才立体。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤面泛红，辛香散出，这点要注意。"
    },
    {
      "n": 6,
      "text": "放入鱼段，小火煮八分钟不翻动。，注意锅里温度别掉下来。",
      "time_min": 9,
      "heat": "小火",
      "tip": "别翻动，鱼肉才不散。，始终中小火，别心急。",
      "visual_cue": "鱼皮完整，肉色变白，这是关键点。"
    },
    {
      "n": 7,
      "text": "加盐和黑胡椒调味，关火。，火要均匀，食材才不糊。",
      "time_min": 2,
      "heat": "小火",
      "tip": "鱼汤咸淡要轻，才吃得出鲜。，看住火，别让它失控。",
      "visual_cue": "味道清鲜，咸淡合适，别嫌麻烦，做完它。"
    },
    {
      "n": 8,
      "text": "撒香菜碎，盛碗挤柠檬汁。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后挤汁，酸香才清亮。，火大了就离锅远一点。",
      "visual_cue": "香菜浮面，汤色清亮，这一步别省。"
    }
  ],
  "tips": [
    "鱼段别翻动，肉才不散。，别跳过这步。",
    "番茄先煮出味，汤才红。，这步最关键。",
    "柠檬汁最后挤，酸香才活。，很多人在这里出错。"
  ],
  "common_mistakes": [
    "鱼煮太久，肉全散。，这里最容易翻车。，这步做对就顺了。",
    "汤滚太猛，鱼皮破。，别小看这一步。，别急着往下走。",
    "香料下太多，盖住鱼鲜。，成败就在这一步。"
  ],
  "substitutions": [
    {
