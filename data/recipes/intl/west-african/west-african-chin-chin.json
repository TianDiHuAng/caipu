    "漏勺",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉、泡打粉、白糖和盐混合过筛。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛后更酥，颗粒才细。，始终中小火，别心急。",
      "visual_cue": "粉质细腻，无结块，这步最关键。"
    },
    {
      "n": 2,
      "text": "加黄油搓成粗砂状。，火要均匀，食材才不糊。，翻动要柔，别用力压。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油要冷，搓出来才起酥。，看住火，别让它失控。",
      "visual_cue": "面絮松散，颜色发白"
    },
    {
      "n": 3,
      "text": "倒蛋液和牛奶，揉成偏硬的面团。，全程留意火候，别贪快。",
      "time_min": 7,
      "heat": "无火",
      "tip": "面要硬一点，炸后才脆。，火大了就离锅远一点。",
      "visual_cue": "面团光滑，按压偏硬"
    },
    {
      "n": 4,
      "text": "盖布醒二十分钟，让面筋松弛。，火别开太大，稳着来。",
      "time_min": 22,
      "heat": "无火",
      "tip": "醒够时间，擀开才不回缩。，锅温要匀，别忽高忽低。",
      "visual_cue": "面团柔软，擀压顺手"
    },
    {
      "n": 5,
      "text": "擀成半厘米厚，切成小方块。，火力保持中等，慢慢来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切小一点，炸得透也好看。，火候宁小勿大，慢慢推进。",
      "visual_cue": "方块均匀，边缘整齐"
    },
    {
      "n": 6,
      "text": "植物油烧到一百六十度，下锅炸。，注意锅里温度别掉下来。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温低一点，里面才熟透。，始终中小火，别心急。",
      "visual_cue": "面块浮起，慢慢鼓胀"
    },
    {
      "n": 7,
      "text": "炸到金黄捞出，沥油放凉。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "中火",
      "tip": "颜色浅黄就要捞，余温会加深。，看住火，别让它失控。",
      "visual_cue": "表面金黄，敲起来脆"
    },
    {
      "n": 8,
      "text": "完全放凉后密封保存。，全程留意火候，别贪快。",
      "time_min": 10,
      "heat": "无火",
      "tip": "放凉再装罐，才不回软。，火大了就离锅远一点。",
      "visual_cue": "口感酥脆，咬开有声"
    }
  ],
  "tips": [
    "面团偏硬，炸出来才脆。，很多人在这里出错。",
    "油温一百六十度，里面才熟透。，这里最容易翻车。",
    "彻底放凉再密封，才不回软。，别小看这一步。"
  ],
  "common_mistakes": [
    "面团太软，炸出来像油饼。，成败就在这一步。",
    "油温太高，外焦里生。，这点要注意。",
    "热着装罐，第二天全软了。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "40 克:35 毫升",
      "note": "少了奶香，口感稍硬。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "100 毫升:95 毫升",
      "note": "风味更淡，需多加糖十克。"
    }
  ],
  "variations": [
    "加一点肉豆蔻粉，香气更暖。，别嫌麻烦，做完它。",
    "表面裹糖粉，甜度更足。，这一步别省。"
  ],
  "serving_suggestion": "当零食或配茶，装小碗分食。，别跳过这步。",
  "storage": "密封常温一周，受潮可回炉烘三分钟。",
