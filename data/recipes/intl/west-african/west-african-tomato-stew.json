  "equipment": [
    "炖锅",
    "搅拌机",
    "木勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄、甜椒、洋葱切块，和生姜、大蒜、小米椒一起放进搅拌机打碎。",
      "time_min": 12,
      "heat": "无火",
      "tip": "打成粗糊就停，太细会失去质感。",
      "visual_cue": "打成浓稠红色糊状"
    },
    {
      "n": 2,
      "text": "炖锅倒植物油中火烧热，倒入打好的菜糊，不断翻炒。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油要够多，酱才挂得住也不易糊底。",
      "visual_cue": "菜糊冒泡，油浮在表面"
    },
    {
      "n": 3,
      "text": "继续中火翻炒十分钟，把菜糊里的水分慢慢炒干。",
      "time_min": 11,
      "heat": "中火",
      "tip": "这一步不能急，水分炒干酱才香浓。",
      "visual_cue": "菜糊变稠，颜色转深红"
    },
    {
      "n": 4,
      "text": "加番茄酱、辣椒粉、盐和黑胡椒翻匀，继续炒三分钟。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "番茄酱最后加，颜色才鲜亮不发暗。",
      "visual_cue": "酱色油亮，红润不发暗"
    },
    {
      "n": 5,
      "text": "转小火盖盖焖十二分钟，中途翻动两次防止粘锅。",
      "time_min": 13,
      "heat": "小火",
      "tip": "小火慢焖，甜味和辣味才会融合。",
      "visual_cue": "酱体浓稠，能挂住木勺"
    },
    {
      "n": 6,
      "text": "开盖补盐调整咸淡，收汁到油浮面即可关火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "油浮到表面，说明酱汁已经炒透了。",
      "visual_cue": "表面浮起一层红油"
    }
  ],
  "tips": [
    "菜糊要用中火慢慢炒干水分，香味才浓。",
    "油量要足，酱汁才挂勺且不易糊底。",
    "辣椒粉和海椒按口味增减，先少后补。"
  ],
  "common_mistakes": [
    "菜糊一下锅就大火猛炒，溅得到处都是还糊底。",
    "水分没炒干就装罐，两天就发酸。",
    "盐一次加太多，掩盖了番茄的甜味。"
  ],
  "substitutions": [
    {
      "original": "甜椒",
      "substitute": "胡萝卜",
      "ratio": "200 克:200 克",
      "note": "甜度更高，辣味更突出。"
    },
    {
      "original": "番茄酱",
      "substitute": "番茄膏",
      "ratio": "60 克:40 克",
      "note": "颜色更深，需补少量清水。"
    }
  ],
  "variations": [
    "加一勺花生酱，酱体更浓稠带坚果香。",
    "最后加几片香肠同焖，风味更饱满。"
  ],
  "serving_suggestion": "配白饭、炸芭蕉片或煮木薯同吃，是西非家庭每天离不开的基础炖酱。",
  "storage": "冷藏四天，冷冻一个月；表面浮油可延长保存，食用前彻底加热。",
