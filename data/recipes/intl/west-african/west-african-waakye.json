  "steps": [
    {
      "n": 1,
      "text": "红豆提前泡四小时，冲洗干净。，火大了就离锅远一点。",
      "time_min": 242,
      "heat": "无火",
      "tip": "泡够时间，煮时才不硬心。，火别开太大，稳着来。",
      "visual_cue": "豆粒饱满，表皮舒展"
    },
    {
      "n": 2,
      "text": "红豆加清水和香叶，大火煮开。，锅温要匀，别忽高忽低。",
      "time_min": 10,
      "heat": "大火",
      "tip": "水一次加够，中途别添冷水。，火力保持中等，慢慢来。",
      "visual_cue": "汤面翻滚，豆子浮起"
    },
    {
      "n": 3,
      "text": "转小火煮三十五分钟，豆子刚软。，火候宁小勿大，慢慢推进。",
      "time_min": 37,
      "heat": "小火",
      "tip": "煮到能捏碎但不烂。，注意锅里温度别掉下来。",
      "visual_cue": "豆粒裂开，仍完整，这是关键点。"
    },
    {
      "n": 4,
      "text": "大米淘洗三遍，沥干水。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洗到水清，饭才不糊。，火要均匀，食材才不糊。",
      "visual_cue": "米粒清爽，无浮粉，别嫌麻烦，做完它。"
    },
    {
      "n": 5,
      "text": "把米倒入豆汤，加姜片和盐。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "中火",
      "tip": "水位高出米两指，饭才不夹生。，全程留意火候，别贪快。",
      "visual_cue": "米粒平铺，汤汁没过"
    },
    {
      "n": 6,
      "text": "煮开后转小火焖二十分钟，不揭盖。，火大了就离锅远一点。",
      "time_min": 22,
      "heat": "小火",
      "tip": "中途揭盖，蒸汽跑了夹生。，火别开太大，稳着来。",
      "visual_cue": "表面气孔，汤汁收干"
    },
    {
      "n": 7,
      "text": "关火焖十分钟，拌入植物油。，锅温要匀，别忽高忽低。",
      "time_min": 12,
      "heat": "无火",
      "tip": "焖够时间，米芯才透。，火力保持中等，慢慢来。",
      "visual_cue": "饭粒松散，豆色发紫"
    },
    {
      "n": 8,
      "text": "挑出香叶和姜片，盛碗上桌。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香料久留会发苦。，注意锅里温度别掉下来。",
      "visual_cue": "饭色紫红，颗粒分明"
    }
  ],
  "tips": [
    "红豆先煮到刚软，再下米。，这一步别省。",
    "全程小火焖，饭才不夹生。，别跳过这步。",
    "关火焖十分钟，米芯才透。，这步最关键。"
  ],
  "common_mistakes": [
    "红豆和米同时下锅，豆硬米烂。，很多人在这里出错。",
    "大火收汁，锅底糊一层。，这里最容易翻车。",
    "水放太多，煮成粥。，别小看这一步。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "黑眼豆",
      "ratio": "200 克:200 克",
      "note": "煮的时间缩短十分钟，更易软。"
    },
    {
      "original": "大米",
      "substitute": "糙米",
      "ratio": "300 克:300 克",
      "note": "需多加水两百毫升并延长焖制。"
    }
  ],
  "variations": [
    "加一点小苏打，豆色更红。，成败就在这一步。",
    "配辣酱和水煮蛋，是加纳街头标配。"
  ],
  "serving_suggestion": "配辣酱、煮蛋和炸鱼一起吃。，这点要注意。",
  "storage": "冷藏两天，复热加少量水。，这是关键点。",
