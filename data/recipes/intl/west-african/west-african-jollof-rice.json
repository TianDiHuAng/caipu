  "steps": [
    {
      "n": 1,
      "text": "番茄、甜椒、洋葱、大蒜、姜与辣椒酱一起打成细腻的红酱，约一升。",
      "time_min": 8,
      "heat": "无火",
      "tip": "红酱要打得细，粗颗粒焖饭时不易融合。",
      "visual_cue": "酱体均匀浓稠，呈鲜红色"
    },
    {
      "n": 2,
      "text": "厚底锅下植物油，倒入红酱小火慢炒二十分钟，炒到水分收干、油浮到表面。",
      "time_min": 22,
      "heat": "小火",
      "tip": "这步叫炒底，炒到油酱分离，饭才有那种深红油亮的颜色。",
      "visual_cue": "酱体变深红，锅边渗出红油"
    },
    {
      "n": 3,
      "text": "加咖喱粉、百里香、月桂叶、番茄酱和盐，翻炒两分钟让香料融合。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香料在油里炒过才香，直接倒进汤里会发涩。",
      "visual_cue": "酱料油亮，香气浓烈"
    },
    {
      "n": 4,
      "text": "鸡腿肉块用盐和黑胡椒抓匀，另起锅煎到两面金黄，移入酱料中拌匀。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸡肉先煎上色再焖，肉香更足、口感不柴。",
      "visual_cue": "鸡皮金黄，酱料裹住每块鸡肉"
    },
    {
      "n": 5,
      "text": "倒入洗净的米和七百毫升高汤，搅匀后煮开，转最小的火加盖焖二十五分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "水一开就转最小火，火大必定糊底。",
      "visual_cue": "米粒吸饱红色汤汁，表面冒细孔"
    },
    {
      "n": 6,
      "text": "关火后不要开盖，焖十分钟让余温收干水汽，翻松米粒再上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "关火焖这十分钟能让米粒分明不粘。",
      "visual_cue": "米粒松散分明，锅底没有焦黑层"
    }
  ],
  "tips": [
    "炒底越耐心颜色越漂亮，赶时间会得到一锅浅橙色的饭。",
    "想做出锅巴效果，最后五分钟把火略开大让底部微微焦香。",
    "没有高汤可用清水加一小块黄油替代。"
  ],
  "common_mistakes": [
    "红酱没炒透就下米，饭带生番茄的酸涩味。",
    "水量过多，煮成番茄粥而不是炒饭。",
    "中途频繁开盖搅拌，米粒被搅断、饭变黏糊。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "虾仁",
      "ratio": "500 克:400 克",
      "note": "虾仁最后五分钟铺在饭上焖熟。"
    },
    {
      "original": "米",
      "substitute": "藜麦",
      "ratio": "400 克:350 克",
      "note": "吸水量低，高汤减到五百五十毫升。"
    }
  ],
  "variations": [
    "加青豆与胡萝卜丁同焖，可做更家常的蔬菜版本。"
  ],
  "serving_suggestion": "配炸香蕉、凉拌卷心菜与烤鸡一起上桌。",
  "storage": "冷藏两天，复热加两勺水小火焖热；冷冻可存一个月。",
