  "equipment": [
    "汤锅",
    "料理机",
    "木勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花生用干锅小火炒五分钟，放凉后搓去红皮。",
      "time_min": 7,
      "heat": "小火",
      "tip": "花生炒香但别炒黑，苦味会毁掉整锅汤。",
      "visual_cue": "花生微焦，皮一搓就掉"
    },
    {
      "n": 2,
      "text": "花生与两百毫升高汤放进料理机，打成顺滑花生糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打久一点，颗粒越少汤越顺。",
      "visual_cue": "糊体浓稠，能缓慢流动"
    },
    {
      "n": 3,
      "text": "汤锅下植物油，中火把鸡腿块煎到两面微黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "先煎封住肉汁，炖出来才不柴。",
      "visual_cue": "鸡块表面金黄，锅底带焦香"
    },
    {
      "n": 4,
      "text": "加入洋葱、姜与蒜末，炒三分钟至软塌出香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透，汤的甜味才够。",
      "visual_cue": "洋葱透明，香气浓"
    },
    {
      "n": 5,
      "text": "下番茄块与辣椒粉炒五分钟，边炒边压碎成酱。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒到出红油，汤色才饱满。",
      "visual_cue": "番茄化开，油色发红"
    },
    {
      "n": 6,
      "text": "倒入剩余高汤与花生糊，煮开后小火炖三十分钟。",
      "time_min": 32,
      "heat": "小火",
      "tip": "花生糊容易沉底，木勺要刮到锅底。",
      "visual_cue": "汤体浓稠，表面冒小泡"
    },
    {
      "n": 7,
      "text": "加盐调定味道，撒香菜碎，配米饭一起上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "咸淡要偏足，花生会吸盐。",
      "visual_cue": "汤面油亮，香菜点缀"
    }
  ],
  "tips": [
    "花生必须烤过再打，生花生带涩。",
    "想更浓可多放五十克花生，少放两百毫升高汤。",
    "西非本地会加干鱼或辣椒酱，风味更冲。"
  ],
  "common_mistakes": [
    "花生糊下锅后没搅动，锅底焦糊整锅发苦。",
    "鸡汤炖过头，肉散成丝没有口感。",
    "盐放得太少，花生汤喝起来发闷没有层次。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "牛肉",
      "ratio": "600 克:600 克",
      "note": "炖制时间延长二十分钟至肉软。"
    },
    {
      "original": "花生",
      "substitute": "花生酱",
      "ratio": "200 克:150 克",
      "note": "省去打糊步骤，直接调水化开。"
    }
  ],
  "variations": [
    "加六根秋葵同炖，汤汁更黏稠，口感更滑。",
    "用南瓜替代一半番茄，做成甜口版本。"
  ],
  "serving_suggestion": "浇在米饭上，配炸香蕉或木薯块一起吃。",
  "storage": "冷藏三天、冷冻一个月；复热加少量高汤小火搅开。",
