  ],
  "steps": [
    {
      "n": 1,
      "text": "黑眼豆泡四小时，搓掉外皮冲净。，火要均匀，食材才不糊。",
      "time_min": 242,
      "heat": "无火",
      "tip": "去皮后口感才细，别省这步。，看住火，别让它失控。",
      "visual_cue": "豆粒白净，皮浮在水面"
    },
    {
      "n": 2,
      "text": "豆加清水打成细腻豆糊。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打久一点，越细越滑。，火大了就离锅远一点。",
      "visual_cue": "糊体细白，无颗粒，成败就在这一步。"
    },
    {
      "n": 3,
      "text": "洋葱、红椒和小米辣打成泥拌入。，火别开太大，稳着来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蔬菜泥别太多，糊要稠。，锅温要匀，别忽高忽低。",
      "visual_cue": "糊色微红，能挂勺，这点要注意。"
    },
    {
      "n": 4,
      "text": "加植物油和盐，用木勺搅打五分钟。，火力保持中等，慢慢来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅打起泡，蒸后才松。，火候宁小勿大，慢慢推进。",
      "visual_cue": "糊体发亮，表面有泡"
    },
    {
      "n": 5,
      "text": "碗底抹一层植物油，把豆糊倒到七分满，留出膨胀空间。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别倒太满，蒸时会胀。，注意锅里温度别掉下来。",
      "visual_cue": "糊面平整，留出空间"
    },
    {
      "n": 6,
      "text": "蒸锅水开后放入，中火蒸三十五分钟。，始终中小火，别心急。",
      "time_min": 37,
      "heat": "中火",
      "tip": "水开再上锅，糕才成型。，火要均匀，食材才不糊。",
      "visual_cue": "表面凝固，边缘离碗"
    },
    {
      "n": 7,
      "text": "牙签插入不粘即熟，取出放温。，看住火，别让它失控。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粘牙签说明还要再蒸。，全程留意火候，别贪快。",
      "visual_cue": "牙签干净，糕体弹性"
    },
    {
      "n": 8,
      "text": "脱模切块，配米饭或粥。，火大了就离锅远一点。",
      "time_min": 4,
      "heat": "无火",
      "tip": "放温再脱模，才不散。，火别开太大，稳着来。",
      "visual_cue": "切面细密，气孔均匀"
    }
  ],
  "tips": [
    "豆子去皮，口感才细腻。，这是关键点。",
    "糊要搅打起泡，蒸后才松软。，别嫌麻烦，做完它。",
    "水开后再上锅，糕才不塌。，这一步别省。"
  ],
  "common_mistakes": [
    "豆没去皮，口感粗糙。，别跳过这步。",
    "糊太稀，蒸出来是豆汤。，这步最关键。",
    "冷水上锅，蒸一小时还稀。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "黑眼豆",
      "substitute": "红豆",
      "ratio": "300 克:300 克",
      "note": "颜色偏红，口感更绵。"
    },
    {
      "original": "虾米",
      "substitute": "鱼露",
      "ratio": "15 克:10 毫升",
      "note": "咸鲜更直接，盐要减半。"
    }
  ],
  "variations": [
    "加玉米粒同蒸，口感更丰富。，这里最容易翻车。",
    "用香蕉叶包裹蒸，香气更足。，别小看这一步。"
  ],
  "serving_suggestion": "切块配米饭或粥，也可当早餐。，成败就在这一步。",
  "storage": "冷藏三天，冷冻一个月，蒸热食用。",
