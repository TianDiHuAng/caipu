  "equipment": [
    "炒锅",
    "烤箱",
    "刀",
    "砧板",
    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成三厘米见方的块，用厨房纸压干表面水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆腐表面一定要压干，腌料才挂得住。",
      "visual_cue": "豆腐块表面干爽，边角整齐"
    },
    {
      "n": 2,
      "text": "酸奶加姜黄粉、辣椒粉和两克盐调匀，把豆腐块裹上腌料静置十五分钟。",
      "time_min": 17,
      "heat": "无火",
      "tip": "腌十五分钟让香料渗进去，煎时才香。",
      "visual_cue": "豆腐块裹满橙红腌料，微微挂浆"
    },
    {
      "n": 3,
      "text": "平底锅倒二十毫升花生油中火煎豆腐，每面煎三分钟至金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "每面煎到结壳再翻，翻早了会破皮。",
      "visual_cue": "豆腐六面金黄，表面结一层薄壳"
    },
    {
      "n": 4,
      "text": "另起炒锅倒剩下的油，下洋葱丁中火炒六分钟至软塌微黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒到发黄出甜味，酱底才够厚。",
      "visual_cue": "洋葱软塌微黄，锅底泛油光"
    },
    {
      "n": 5,
      "text": "加姜末和蒜末炒香，再下咖喱粉、孜然粉与剩下的盐炒三十秒。",
      "time_min": 3,
      "heat": "小火",
      "tip": "干粉小火炒三十秒就够，炒久会发苦。",
      "visual_cue": "香料起泡出油，香味冲鼻"
    },
    {
      "n": 6,
      "text": "倒番茄块大火炒八分钟，边炒边压成浓稠的酱汁。",
      "time_min": 9,
      "heat": "大火",
      "tip": "番茄炒成糊状，酱汁才够浓能挂豆腐。",
      "visual_cue": "番茄完全化开，酱汁浓稠冒泡"
    },
    {
      "n": 7,
      "text": "倒入煎好的豆腐块小火煮八分钟，让豆腐吸足酱汁。",
      "time_min": 9,
      "heat": "小火",
      "tip": "小火慢煮，豆腐内部才会吸进汤汁。",
      "visual_cue": "豆腐块沉在红酱里，表面微皱"
    },
    {
      "n": 8,
      "text": "淋入淡奶油搅匀，加白糖调酸，撒香菜出锅。",
      "time_min": 4,
      "heat": "小火",
      "tip": "淡奶油最后放，煮久了会分层析油。",
      "visual_cue": "酱汁转为奶橘色，质地顺滑"
    }
  ],
  "tips": [
    "豆腐用重物压十分钟去水，煎的时候才不散。",
    "酸奶腌料里加姜黄，煎出来颜色才漂亮。",
    "香料粉一定要小火炒，大火十秒就焦苦。",
    "淡奶油最后再放，久煮会分层出油。"
  ],
  "common_mistakes": [
    "豆腐不压水直接下锅，煎出来碎成一锅渣。",
    "番茄没炒成糊就加豆腐，酱汁稀得挂不住。",
    "香料粉大火炒，整锅带焦苦味，辣味也发冲。",
    "淡奶油一开始就下锅，煮到后面油水分离。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "老豆腐",
      "ratio": "450克:450克",
      "note": "更紧实，压水时间可缩短。"
    },
    {
      "original": "淡奶油",
      "substitute": "椰浆",
      "ratio": "60毫升:80毫升",
      "note": "做成纯素版，味道更清甜。"
    }
  ],
  "variations": [
    "加一把青豆同煮，颜色和口感都更丰富。",
    "喜欢更辣的可以在最后撒一勺辣椒粉。",
    "用炭火烤豆腐代替煎，带一点烟熏香。"
  ],
  "serving_suggestion": "盛进深盘，配一张烤饼或一碗香米饭，酱汁浓稠能裹住每一块豆腐。",
  "storage": "冷藏可放两天，复热加两勺清水小火煮五分钟，奶油会略分层，搅匀即可。",
