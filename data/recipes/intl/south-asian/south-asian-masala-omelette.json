  "equipment": [
    "平底锅",
    "碗",
    "打蛋器",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱、番茄切细丁，青辣椒切末，香菜切碎备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "配料切得越细，蛋卷才越好卷不破。",
      "visual_cue": "各料切碎成细丁，装在盘里"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进碗里，加盐、姜黄粉、辣椒粉和黑胡椒打散。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香料直接打进蛋液，颜色才匀。",
      "visual_cue": "蛋液呈浅黄色，香料分布均匀"
    },
    {
      "n": 3,
      "text": "把洋葱丁、番茄丁、青辣椒末和香菜碎倒进蛋液拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "配料拌进蛋液，下锅才不会散落。",
      "visual_cue": "蛋液里裹着细丁，稠度均匀"
    },
    {
      "n": 4,
      "text": "平底锅倒花生油中火烧热，倒入蛋液摊成厚薄均匀的圆饼。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要热但别冒烟，蛋液才能立刻定型。",
      "visual_cue": "蛋液边缘起泡，底面凝固"
    },
    {
      "n": 5,
      "text": "转小火盖盖煎三分钟，让表面蛋液慢慢凝固。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盖盖小火焖，表面才熟而底部不糊。",
      "visual_cue": "表面蛋液凝固，底面金黄"
    },
    {
      "n": 6,
      "text": "用锅铲把蛋饼对折成半圆，再煎一分钟定型后滑入盘中。",
      "time_min": 3,
      "heat": "小火",
      "tip": "对折时动作轻，蛋卷才不裂口。",
      "visual_cue": "蛋卷半圆饱满，边缘微微焦黄"
    }
  ],
  "tips": [
    "配料切细丁，蛋卷才好对折不破皮。",
    "香料直接打进蛋液，颜色和味道都匀。",
    "盖盖小火焖，表面才凝固而底部不焦。",
    "对折时用锅铲托着，蛋卷不容易裂。"
  ],
  "common_mistakes": [
    "配料切太大块，蛋卷卷不起来全散开。",
    "大火煎，底面焦黑表面还是流动蛋液。",
    "油太少，蛋液粘锅铲都铲不起来。",
    "蛋液倒太多堆成厚饼，中间夹生外面发干。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "5枚:4枚",
      "note": "口感更紧实，腥味略重可加姜末。"
    },
    {
      "original": "花生油",
      "substitute": "黄油",
      "ratio": "25毫升:25克",
      "note": "奶香更浓，火要调小防焦。"
    }
  ],
  "variations": [
    "加一勺磨碎的奶酪夹心，做成芝士蛋卷。",
    "放一点切碎的咖喱叶，香气更地道。",
    "配一碟番茄酸辣酱同吃，味道更完整。"
  ],
  "serving_suggestion": "趁热上桌，配两片烤面包和一杯奶茶，就是印度街边最常见的早餐。",
  "storage": "现做现吃最好，冷藏不超过一天，复热用平底锅小火两面各热一分钟。",
