  "equipment": [
    "炒锅",
    "锅盖",
    "木铲",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成滚刀块，泡在清水里洗去表面浆水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洗掉表面浆水，煎的时候才不粘锅底。",
      "visual_cue": "水变清，块面光滑"
    },
    {
      "n": 2,
      "text": "菜花掰成均匀小朵，用淡盐水泡五分钟再沥干水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "盐水泡能逼出藏在花缝里的小虫。",
      "visual_cue": "花球分离，水色发浑"
    },
    {
      "n": 3,
      "text": "炒锅倒一半植物油，中火把土豆块煎到表面金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "先煎后炖，土豆不易散。",
      "visual_cue": "边缘焦黄，能扎透一半"
    },
    {
      "n": 4,
      "text": "盛出土豆，补余下的油下菜花煎到边缘微焦。",
      "time_min": 6,
      "heat": "中火",
      "tip": "菜花煎出焦边，香味才足。",
      "visual_cue": "花球边缘出现褐色小点"
    },
    {
      "n": 5,
      "text": "原锅下洋葱碎炒到透明，加蒜末、姜末炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透是整道菜的甜味底子。",
      "visual_cue": "洋葱透明，锅底微黄"
    },
    {
      "n": 6,
      "text": "加姜黄、孜然粉、辣椒粉小火炒三十秒，再下番茄丁炒软。",
      "time_min": 4,
      "heat": "小火",
      "tip": "香料先炒一下能去生味，但别炒糊。",
      "visual_cue": "番茄出汁，油色橙红"
    },
    {
      "n": 7,
      "text": "倒回土豆与菜花，加盐与半碗清水，盖盖小火焖十分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "水量到食材一半就行，焖到收汁。",
      "visual_cue": "汤汁浓稠，蔬菜软透"
    },
    {
      "n": 8,
      "text": "开盖翻匀收汁，撒上香菜碎后装盘，趁热端上桌。",
      "time_min": 2,
      "heat": "中火",
      "tip": "收汁收到挂勺，味道才浓。",
      "visual_cue": "表面无多余汤水挂汁"
    }
  ],
  "tips": [
    "土豆和菜花分开煎，熟度才一致。",
    "香料粉下锅只要三十秒，久了发苦。",
    "焖的时候火要小，否则锅底容易糊。"
  ],
  "common_mistakes": [
    "土豆菜花一起下锅炖，一个烂了一个还硬。",
    "番茄没炒出沙就加水，汤汁寡淡发酸。",
    "香料粉炒过了头，整锅菜都带苦味。"
  ],
  "substitutions": [
    {
      "original": "菜花",
      "substitute": "西兰花",
      "ratio": "400 克:400 克",
      "note": "颜色更绿，煎制时间缩短两分钟。"
    },
    {
      "original": "辣椒粉",
      "substitute": "小米辣",
      "ratio": "4 克:2 个",
      "note": "切碎同炒，辣味更冲。"
    }
  ],
  "variations": [
    "最后撒一撮干辣椒碎，辣香更立体。",
    "喜欢湿润口感可多加半个番茄，做成半汤半菜。"
  ],
  "serving_suggestion": "配热米饭或烤饼，用手撕饼蘸汁吃最香。",
  "storage": "冷藏两天，复热用平底锅干炒，避免微波让菜花变软。",
