  "steps": [
    {
      "n": 1,
      "text": "大米淘洗后泡二十分钟，沥干。，火候宁小勿大，慢慢推进。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过再煮，米粒才不碎。，注意锅里温度别掉下来。",
      "visual_cue": "米粒发白，手感松，这一步别省。"
    },
    {
      "n": 2,
      "text": "洋葱丝用一半植物油炸到金黄，捞出。，始终中小火，别心急。",
      "time_min": 8,
      "heat": "中火",
      "tip": "炸到脆才香，别炸黑。，火要均匀，食材才不糊。",
      "visual_cue": "洋葱褐黄，油色加深"
    },
    {
      "n": 3,
      "text": "余油炒姜末、蒜末、孜然和小豆蔻。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料一响就下菜，别炒糊。，全程留意火候，别贪快。",
      "visual_cue": "香气冲鼻，油面波动"
    },
    {
      "n": 4,
      "text": "下胡萝卜、南瓜和花菜炒五分钟。，火大了就离锅远一点。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蔬菜切小块，才和米一起熟。，火别开太大，稳着来。",
      "visual_cue": "蔬菜上色，略微软，别跳过这步。"
    },
    {
      "n": 5,
      "text": "加酸奶和咖喱粉，小火拌到裹匀。，锅温要匀，别忽高忽低。",
      "time_min": 5,
      "heat": "小火",
      "tip": "酸奶小火拌，才不结块。，火力保持中等，慢慢来。",
      "visual_cue": "菜块挂糊，颜色橙黄"
    },
    {
      "n": 6,
      "text": "清水加盐和香叶烧开，下米煮到半熟。，火候宁小勿大，慢慢推进。",
      "time_min": 12,
      "heat": "大火",
      "tip": "煮到米粒外软内硬就捞。，注意锅里温度别掉下来。",
      "visual_cue": "米粒膨胀，中心有白点"
    },
    {
      "n": 7,
      "text": "锅底铺菜，米盖在上面，撒炸洋葱。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "分层铺好，别搅动。，火要均匀，食材才不糊。",
      "visual_cue": "层次分明，表面平整"
    },
    {
      "n": 8,
      "text": "盖盖小火焖二十分钟，中途转一次锅。，看住火，别让它失控。",
      "time_min": 22,
      "heat": "小火",
      "tip": "转锅让受热均匀，别开盖。，全程留意火候，别贪快。",
      "visual_cue": "蒸汽冒香，米粒竖立"
    },
    {
      "n": 9,
      "text": "关火焖十分钟，开盖轻轻翻松。，火大了就离锅远一点。",
      "time_min": 12,
      "heat": "无火",
      "tip": "翻松用叉子，米粒才不断。，火别开太大，稳着来。",
      "visual_cue": "饭粒分明，香气浓郁"
    }
  ],
  "tips": [
    "米泡过再煮，粒粒分明。，这步最关键。",
    "分层铺好别搅，饭才不糊。，很多人在这里出错。",
    "小火焖足时间，米芯才透。，这里最容易翻车。"
  ],
  "common_mistakes": [
    "米煮过头再焖，饭成糊。，别小看这一步。",
    "大火焖，锅底焦一层。，成败就在这一步。",
    "翻拌太用力，米粒全断。，这点要注意。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "牛奶",
      "ratio": "100 克:100 毫升",
      "note": "酸味减弱，需多加咖喱粉三克。"
    },
    {
      "original": "南瓜",
      "substitute": "土豆",
      "ratio": "200 克:200 克",
      "note": "口感更粉，需多煮三分钟。"
    }
  ],
  "variations": [
    "加腰果和葡萄干，风味更豪华。，这是关键点。",
    "用藏红花水淋面，颜色更亮。，别嫌麻烦，做完它。"
  ],
  "serving_suggestion": "配酸奶酱和腌洋葱一起吃。，这一步别省。",
  "storage": "冷藏两天，复热洒水加盖蒸。，别跳过这步。",
