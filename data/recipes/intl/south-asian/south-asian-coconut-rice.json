  "steps": [
    {
      "n": 1,
      "text": "香米淘洗三遍至水清，加清水浸泡二十分钟后沥干。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡二十分钟米粒吸水，煮出来才松散。",
      "visual_cue": "米粒发白饱满，水基本澄清"
    },
    {
      "n": 2,
      "text": "洋葱切薄片，香菜切碎，腰果掰成两半备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱切薄片，炸出来才酥脆不软。",
      "visual_cue": "洋葱片薄而均匀，腰果对半"
    },
    {
      "n": 3,
      "text": "炒锅倒花生油下芥末籽小火炒至噼啪爆开，再下腰果炒香后盛出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芥末籽爆开才香，小火防止炸糊。",
      "visual_cue": "芥末籽跳起，腰果微黄"
    },
    {
      "n": 4,
      "text": "锅里补少量花生油下洋葱片小火煎至金黄酥脆，盛出备用。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱小火慢煎才酥，大火容易发黑。",
      "visual_cue": "洋葱片金黄卷曲，质地酥脆"
    },
    {
      "n": 5,
      "text": "下咖喱叶炒十秒出香，倒入沥干的香米中火翻炒两分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "米粒炒过再煮，颗粒分明不粘连。",
      "visual_cue": "米粒透亮挂油，闻得到米香"
    },
    {
      "n": 6,
      "text": "倒入椰浆、清水和盐搅匀，大火烧开后转小火盖盖焖十五分钟。",
      "time_min": 17,
      "heat": "小火",
      "tip": "小火焖足十五分钟，米芯才熟透不夹生。",
      "visual_cue": "水面收干，锅边冒小泡"
    },
    {
      "n": 7,
      "text": "关火焖五分钟再开盖，用叉子拨松米饭，撒洋葱酥、腰果和香菜。",
      "time_min": 6,
      "heat": "无火",
      "tip": "关火再焖五分钟，米粒回润更松软。",
      "visual_cue": "米饭颗粒分明，表面铺满酥料"
    }
  ],
  "tips": [
    "香米先泡二十分钟，煮出来才松散不粘。",
    "芥末籽小火炒到爆开，香气才出得来。",
    "米粒先炒过再加水，颗粒分明更好吃。",
    "关火后焖五分钟再开盖，米粒回润不夹生。"
  ],
  "common_mistakes": [
    "米不泡直接煮，外面烂了里面还有硬芯。",
    "全程大火煮，锅底糊了上面还是生的。",
    "椰浆放太多，米饭黏成一团没有颗粒感。",
    "煮好立刻开盖翻动，米粒被搅断变得糊烂。"
  ],
  "substitutions": [
    {
      "original": "椰浆",
      "substitute": "椰奶",
      "ratio": "200毫升:220毫升",
      "note": "更稀薄，清水减到180毫升。"
    },
    {
      "original": "腰果",
      "substitute": "花生米",
      "ratio": "30克:30克",
      "note": "需提前炸香去皮。"
    }
  ],
  "variations": [
    "加一小勺姜黄粉同煮，颜色金黄更好看。",
    "放几粒葡萄干一起焖，甜咸交错。",
    "配咖喱或炖菜同吃，能吸足酱汁。"
  ],
  "serving_suggestion": "用碗压实后扣在盘里，撒上洋葱酥和腰果，配咖喱、炖菜或烤鸡都合适。",
  "storage": "冷藏可放两天，复热撒两勺清水盖盖小火焖五分钟，或用微波中火加热。",
