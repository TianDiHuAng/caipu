          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜冷饭用手或饭勺拨散，确保米粒之间没有黏团。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷饭才松散，热饭一炒就糊。",
      "visual_cue": "米粒分开，没有结块"
    },
    {
      "n": 2,
      "text": "洋葱切成细小的丁，花生用刀背压成粗碎后备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "洋葱切细，炒后才不出水。",
      "visual_cue": "洋葱丁细小均匀，花生粗碎"
    },
    {
      "n": 3,
      "text": "平底锅小火烧热，放入孜然粒干炒四十秒出香。",
      "time_min": 1,
      "heat": "小火",
      "tip": "孜然一变色就够，炒久会发苦。",
      "visual_cue": "孜然颜色变深，香气扑鼻"
    },
    {
      "n": 4,
      "text": "加入黄油让它融化，趁热下洋葱丁炒到透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "黄油别烧焦，融化就下洋葱。",
      "visual_cue": "洋葱透明，黄油香气浓"
    },
    {
      "n": 5,
      "text": "倒入米饭，用锅铲不停翻压把米粒彻底炒散炒热。",
      "time_min": 4,
      "heat": "中火",
      "tip": "边压边翻，米粒才粒粒分明。",
      "visual_cue": "米粒松散，表面挂油"
    },
    {
      "n": 6,
      "text": "撒入盐翻匀，让每一粒米都沾上咸味与孜然香气。",
      "time_min": 2,
      "heat": "中火",
      "tip": "盐先少量加，尝过再补。",
      "visual_cue": "米粒油亮，香气均匀"
    },
    {
      "n": 7,
      "text": "关火后撒入花生碎，利用锅里余温快速翻匀后装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "花生最后加，口感才脆。",
      "visual_cue": "米饭松散，花生分布均匀"
    }
  ],
  "tips": [
    "用隔夜冷饭，炒出来才粒粒分明。",
    "孜然干炒到出香就够，炒久会发苦。",
    "花生关火后再加，脆感才留得住。"
  ],
  "common_mistakes": [
    "用刚煮的热饭去炒，越炒越黏成一团。",
    "黄油烧到冒烟才下料，整锅都带着焦味。",
    "盐撒得不均匀，一口咸一口又太淡。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30 克:28 毫升",
      "note": "奶香变淡，可加少许蒜末提味。"
    },
    {
      "original": "花生",
      "substitute": "腰果",
      "ratio": "40 克:40 克",
      "note": "口感更酥，坚果香更浓。"
    }
  ],
  "variations": [
    "加一把青豆一同翻炒，颜色更好看。",
    "出锅前挤少许柠檬汁，味道更清爽。"
  ],
  "serving_suggestion": "趁热配咖喱或豆汤，做一餐的主食。",
  "storage": "冷藏两天，复热用平底锅回炒散开。",
