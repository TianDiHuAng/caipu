          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 100,
          "unit": "g",
          "note": "切细丁",
          "optional": false
        },
        {
          "name": "花生",
          "name_en": "peanut",
          "amount": 40,
          "unit": "g",
          "note": "烤香去皮",
          "optional": false
        },
        {
