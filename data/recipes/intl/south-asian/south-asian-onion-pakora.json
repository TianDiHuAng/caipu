  "steps": [
    {
      "n": 1,
      "text": "洋葱切细丝，土豆切火柴条，一起放进盆里加盐抓匀腌十分钟出水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "加盐腌出水是面糊能挂住的关键。",
      "visual_cue": "盆底积起一层水分"
    },
    {
      "n": 2,
      "text": "加入面粉、姜黄、孜然、辣椒粉、菠菜碎和香菜碎，用手抓拌成黏稠面糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "靠腌出的水调糊，太干才少量加水。",
      "visual_cue": "每根洋葱都裹上黄色面糊"
    },
    {
      "n": 3,
      "text": "炒锅倒入二百七十毫升植物油，中火烧到插入筷子边缘冒小泡。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温不够时炸出来会吸油，咬着发软发腻。",
      "visual_cue": "筷子周围冒细密小泡"
    },
    {
      "n": 4,
      "text": "用勺子把面糊一小团一小团拨进油锅，一次放六七个不要挤。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一团别太大，个头小中间才炸得透。",
      "visual_cue": "油面翻起密集气泡"
    },
    {
      "n": 5,
      "text": "炸三分钟到底部定型变硬，翻面再炸两分钟到金黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "翻动要等定型，早了会散开成碎渣。",
      "visual_cue": "表面金黄，形状固定"
    },
    {
      "n": 6,
      "text": "捞出放厨房纸沥油，油温回升后再炸下一批，趁热撒少许盐。",
      "time_min": 5,
      "heat": "中火",
      "tip": "分批炸并保持油温，凉油下锅会油汪汪。",
      "visual_cue": "外皮酥脆，按压有响声"
    }
  ],
  "tips": [
    "洋葱先加盐腌出水，靠它调糊不用额外加水。",
    "油温保持在插入筷子冒小泡的状态，太冷会吸油。",
    "每批别放太多，油温掉下来就炸不脆。"
  ],
  "common_mistakes": [
    "面糊加水太多，炸出来软塌不成形。",
    "油温太低，炸饼吸满油一按就冒油。",
    "一次倒太多进锅，全部粘成一大团。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "鹰嘴豆粉",
      "ratio": "150 克:150 克",
      "note": "更接近印度原版，需多加二十毫升水。"
    },
    {
      "original": "菠菜",
      "substitute": "卷心菜",
      "ratio": "100 克:120 克",
      "note": "切细丝，炸完更脆。"
    }
  ],
  "variations": [
    "加一勺酸奶进面糊，炸完外层更酥。",
    "配薄荷酸辣酱蘸着吃，解腻又提味。"
  ],
  "serving_suggestion": "趁热装盘，配薄荷酱或番茄酸辣酱，配一杯加了柠檬的咸味酸奶一起喝。",
  "storage": "现炸现吃最佳，冷藏一天复热用二百度烤八分钟恢复脆度。",
