  "equipment": [
    "汤锅",
    "小煎锅",
    "搅拌勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扁豆洗净用清水泡二十分钟，沥干后放进汤锅。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过的扁豆煮起来更省时间也更容易软。",
      "visual_cue": "豆子吸水后明显膨胀"
    },
    {
      "n": 2,
      "text": "汤锅加清水大火煮开，转小火煮十五分钟到豆子开花。",
      "time_min": 17,
      "heat": "小火",
      "tip": "用小火慢慢煮，豆子才会绵软不破皮。",
      "visual_cue": "豆子裂开，汤色微黄"
    },
    {
      "n": 3,
      "text": "番茄切块放进汤里，中火再煮八分钟到番茄软烂。",
      "time_min": 9,
      "heat": "中火",
      "tip": "番茄煮到化开，汤底才带自然酸甜。",
      "visual_cue": "番茄塌软，汤色转红"
    },
    {
      "n": 4,
      "text": "加罗望子酱、盐和黑胡椒，搅匀后小火再煮五分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "罗望子酱很浓，先用汤化开再倒回锅。",
      "visual_cue": "汤色深红，酸香扑鼻"
    },
    {
      "n": 5,
      "text": "小煎锅放植物油，下孜然、大蒜和生姜小火爆香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "孜然一下锅就出香，千万别炒到发黑。",
      "visual_cue": "孜然跳动，蒜末金黄"
    },
    {
      "n": 6,
      "text": "把爆香的油和香料一起倒进汤锅，盖上焖两分钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "热油冲进汤里，能把香料的香气激出来。",
      "visual_cue": "汤面浮着一层香料油"
    },
    {
      "n": 7,
      "text": "尝味后补足盐分，撒上香菜碎趁热盛碗上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后再撒，香气才会清新不闷。",
      "visual_cue": "汤面点缀绿色香菜"
    }
  ],
  "tips": [
    "扁豆先泡二十分钟，煮起来更快更绵。",
    "罗望子酱先用热汤化开，避免结块。",
    "香料用小火爆香，孜然才不焦苦。"
  ],
  "common_mistakes": [
    "扁豆没泡直接煮，煮很久还是有硬芯。",
    "罗望子酱整坨下锅，汤里结成一团。",
    "孜然用大火爆，几秒就焦黑发苦。"
  ],
  "substitutions": [
    {
      "original": "罗望子酱",
      "substitute": "柠檬",
      "ratio": "40 克:2 个",
      "note": "酸味更明亮，起锅前再挤。"
    },
    {
      "original": "扁豆",
      "substitute": "绿豆",
      "ratio": "100 克:100 克",
      "note": "煮制时间缩短五分钟。"
    }
  ],
  "variations": [
    "加一小勺辣椒粉，辣味会更醒目。",
    "最后淋一勺热酥油，香气会更加浓郁。"
  ],
  "serving_suggestion": "浇在白饭上拌着吃，或当作饭前开胃汤，是南印度家庭每天都会煮的一道汤。",
  "storage": "冷藏三天，冷冻两周；复热时加少量清水，香菜另备。",
