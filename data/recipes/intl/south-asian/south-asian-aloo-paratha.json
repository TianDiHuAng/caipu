    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和水，揉成偏软的面团。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面软一点，擀开才不裂。，火别开太大，稳着来。",
      "visual_cue": "面团光滑，按压柔软"
    },
    {
      "n": 2,
      "text": "盖布醒三十分钟，让面筋松弛。，锅温要匀，别忽高忽低。",
      "time_min": 32,
      "heat": "无火",
      "tip": "醒够时间，擀皮才不回缩。，火力保持中等，慢慢来。",
      "visual_cue": "面团松软，延展性好"
    },
    {
      "n": 3,
      "text": "土豆蒸熟压成泥，别留硬块。，火候宁小勿大，慢慢推进。",
      "time_min": 15,
      "heat": "中火",
      "tip": "趁热压，泥才细。，注意锅里温度别掉下来。",
      "visual_cue": "泥体细腻，无颗粒，这点要注意。"
    },
    {
      "n": 4,
      "text": "土豆泥加姜末、香菜、孜然、辣椒粉和盐拌匀。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌到能捏成团，馅才不散。，火要均匀，食材才不糊。",
      "visual_cue": "馅料湿润，能抱团，这是关键点。"
    },
    {
      "n": 5,
      "text": "面团分成八份，擀成圆皮。，看住火，别让它失控。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边缘擀薄，中间略厚。，全程留意火候，别贪快。",
      "visual_cue": "皮薄均匀，圆形完整"
    },
    {
      "n": 6,
      "text": "包入土豆馅，收口捏紧压扁。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "无火",
      "tip": "收口一定捏紧，否则煎时漏馅。，火别开太大，稳着来。",
      "visual_cue": "饼坯圆整，无破口，别嫌麻烦，做完它。"
    },
    {
      "n": 7,
      "text": "轻轻擀成半厘米厚的饼。，锅温要匀，别忽高忽低。",
      "time_min": 6,
      "heat": "无火",
      "tip": "轻擀别用力，馅才不挤出来。，火力保持中等，慢慢来。",
      "visual_cue": "饼坯均匀，无露馅，这一步别省。"
    },
    {
      "n": 8,
      "text": "平底锅烧热，饼两面刷酥油煎。，火候宁小勿大，慢慢推进。",
      "time_min": 12,
      "heat": "中火",
      "tip": "刷油煎，表皮才酥脆。，注意锅里温度别掉下来。",
      "visual_cue": "表面金黄，鼓起小泡"
    },
    {
      "n": 9,
      "text": "两面煎到焦斑，趁热上桌。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "焦斑才香，别只煎一面。，火要均匀，食材才不糊。",
      "visual_cue": "饼身鼓起，按压回弹"
    }
  ],
  "tips": [
    "面团软一点，擀皮才不裂。，别跳过这步。",
    "收口捏紧，煎时馅才不漏。，这步最关键。",
    "中火煎，外酥里熟。，很多人在这里出错。"
  ],
  "common_mistakes": [
    "面团太硬，擀开就裂。，这里最容易翻车。",
    "馅太湿，饼坯一擀就破。，别小看这一步。",
    "火太大，皮焦馅冷。，成败就在这一步。"
  ],
  "substitutions": [
    {
      "original": "酥油",
      "substitute": "黄油",
      "ratio": "60 克:60 克",
      "note": "奶香相近，熔点略高。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "400 克:400 克",
      "note": "甜味更明显，需减盐一克。"
    }
  ],
  "variations": [
    "馅里加青豆，口感更丰富。，这点要注意。",
    "包一点奶酪碎，煎后拉丝。，这是关键点。"
  ],
  "serving_suggestion": "配酸奶或腌菜，趁热吃。，别嫌麻烦，做完它。",
  "storage": "冷藏两天，复煎三分钟。，这一步别省。",
