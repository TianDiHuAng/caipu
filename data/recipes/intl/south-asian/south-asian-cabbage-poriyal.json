  "steps": [
    {
      "n": 1,
      "text": "卷心菜去掉硬芯，切成两三毫米的细丝，洗净沥干水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切得越细越好，两分钟就能炒熟。",
      "visual_cue": "菜丝细匀，干爽无水"
    },
    {
      "n": 2,
      "text": "无糖椰蓉直接倒出来备用，颗粒松散不需要再处理。",
      "time_min": 6,
      "heat": "无火",
      "tip": "椰蓉要松散，结块的要先捻开再用。",
      "visual_cue": "椰碎松散，油润发白"
    },
    {
      "n": 3,
      "text": "炒锅烧热放植物油，下孜然粒小火炒到香气飘出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芥末籽一跳就要下料，不然会糊。",
      "visual_cue": "籽粒爆开，噼啪作响"
    },
    {
      "n": 4,
      "text": "加咖喱粉、姜末和小米辣炒三十秒，把香气炒出来。",
      "time_min": 2,
      "heat": "小火",
      "tip": "咖喱粉遇热容易焦，动作一定要快。",
      "visual_cue": "叶片卷起，香气上扬"
    },
    {
      "n": 5,
      "text": "倒入卷心菜丝大火翻炒三分钟，加姜黄粉和盐炒匀。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火快炒保留脆感，别炒到出水。",
      "visual_cue": "菜丝变软仍有脆感"
    },
    {
      "n": 6,
      "text": "撒入椰碎再炒一分钟，出锅前挤上柠檬汁拌匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "椰蓉最后才放，炒久了会发苦味。",
      "visual_cue": "椰香明显，菜色金黄"
    }
  ],
  "tips": [
    "卷心菜切得越细越容易熟，两分钟就能炒透。",
    "孜然粒在油里一爆香就要下料，炸过头会发苦。",
    "椰蓉最后才放，炒久了会发苦也失去香气。"
  ],
  "common_mistakes": [
    "卷心菜没沥干水就下锅，炒出来像煮的。",
    "孜然粒炸过了头，整盘菜带一股焦苦味。",
    "盐放太早出水太多，菜丝软塌成一团。"
  ],
  "substitutions": [
    {
      "original": "椰蓉",
      "substitute": "花生碎",
      "ratio": "80 克:80 克",
      "note": "香气不同，需少放盐。"
    },
    {
      "original": "孜然",
      "substitute": "花椒",
      "ratio": "4 克:4 克",
      "note": "麻香替辛香，风味偏川式。"
    }
  ],
  "variations": [
    "加一把煮熟的绿豆，做成更饱腹的版本。",
    "用胡萝卜丝替换一半卷心菜，颜色更漂亮。"
  ],
  "serving_suggestion": "配白米饭、豆汤和一张薄饼，是南印度家常午餐最常见的蔬菜配菜。",
  "storage": "冷藏两天，复热用炒锅大火一分钟；椰碎久放会失香，建议现做现吃。",
