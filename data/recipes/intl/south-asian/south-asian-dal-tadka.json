  "equipment": [
    "汤锅",
    "小煎锅",
    "木勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小扁豆用清水淘洗两遍，泡二十分钟后沥干备用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡过的小扁豆煮得更快也更绵。",
      "visual_cue": "豆粒饱满，水色微浊"
    },
    {
      "n": 2,
      "text": "汤锅加水放入小扁豆与姜黄，大火烧开后转小火。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水面要高出豆子三指，中途别急着加水。",
      "visual_cue": "汤面翻滚，浮沫浮起"
    },
    {
      "n": 3,
      "text": "撇净浮沫，小火煮二十五分钟到豆子完全软烂。",
      "time_min": 25,
      "heat": "小火",
      "tip": "用勺背压一颗豆，能压碎就到位了。",
      "visual_cue": "豆子开花，汤变浓稠"
    },
    {
      "n": 4,
      "text": "另起小煎锅倒植物油，下洋葱末中火炒到微黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒到边缘焦糖色，甜味才出来。",
      "visual_cue": "洋葱末金黄，油色变深"
    },
    {
      "n": 5,
      "text": "加蒜末、姜末与一半孜然粉、辣椒粉，小火炒出香气。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香料粉遇高温易糊，火一定要小。",
      "visual_cue": "油面泛红，香气扑鼻"
    },
    {
      "n": 6,
      "text": "倒番茄块炒三分钟，压成糊状后倒进豆汤里。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出沙，汤色才红亮。",
      "visual_cue": "番茄塌软，汤汁变红"
    },
    {
      "n": 7,
      "text": "加盐调味后小火再煮五分钟，让香料和豆香融合。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盐分两次放，最后尝一次再定。",
      "visual_cue": "汤稠挂勺，豆香浓"
    },
    {
      "n": 8,
      "text": "撒上香菜碎与剩下的孜然粉，盛入深碗趁热喝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "孜然粉最后撒，香气最冲。",
      "visual_cue": "表面浮着红油与绿叶"
    }
  ],
  "tips": [
    "小扁豆泡过再煮，成品更绵密不夹生。",
    "香料一定要用小火慢炒，糊一点整锅就苦。",
    "汤煮好放十分钟再喝，稠度更合适。"
  ],
  "common_mistakes": [
    "小扁豆没泡直接煮，煮很久中间还是硬的。",
    "香料大火炒，几秒钟就焦黑发苦。",
    "水加得太少，最后煮成一锅厚豆泥。"
  ],
  "substitutions": [
    {
      "original": "小扁豆",
      "substitute": "红豆",
      "ratio": "300 克:250 克",
      "note": "需提前泡两小时，煮制时间延长十五分钟。"
    },
    {
      "original": "酥油",
      "substitute": "植物油",
      "ratio": "30 克:40 毫升",
      "note": "酥油更香，植物油更清爽。"
    }
  ],
  "variations": [
    "起锅前加一勺酥油，香气更浓更地道。",
    "加一把青豆同煮，口感层次更丰富。"
  ],
  "serving_suggestion": "盛进深碗，配米饭或烤饼一起吃，挤点青柠汁解腻。",
  "storage": "冷藏三天，冷冻一个月；复热时加少量清水调稀。",
