        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "炸锅",
    "叉子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐与三勺植物油搓匀，分次加温水揉成偏硬的面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团偏硬，炸出来的皮才酥脆。",
      "visual_cue": "面团光滑紧实，不粘手"
    },
    {
      "n": 2,
      "text": "面团盖湿布醒三十分钟，让面筋松弛更容易擀薄。",
      "time_min": 30,
      "heat": "无火",
      "tip": "醒不够会回缩，擀不薄。",
      "visual_cue": "面团柔软，按下去回弹慢"
    },
    {
      "n": 3,
      "text": "土豆带皮蒸二十分钟至能用筷子轻松扎透，取出去皮。",
      "time_min": 20,
      "heat": "中火",
      "tip": "蒸比煮好，水分少馅才不湿。",
      "visual_cue": "土豆软透，筷子一扎就进"
    },
    {
      "n": 4,
      "text": "土豆趁热压成粗泥，保留一些小块让口感更实在。",
      "time_min": 3,
      "heat": "无火",
      "tip": "别压太细，粗泥口感更好。",
      "visual_cue": "泥中有小块，质地松散"
    },
    {
      "n": 5,
      "text": "平底锅下少量油，中火炒孜然粒三十秒到香气出来。",
      "time_min": 2,
      "heat": "中火",
      "tip": "孜然炒香再下别的料，香味才足。",
      "visual_cue": "孜然颜色变深，香气冲鼻"
    },
    {
      "n": 6,
      "text": "下洋葱碎与姜末炒三分钟，炒到洋葱变软透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒甜，馅的味道才立体。",
      "visual_cue": "洋葱透明，锅里有香气"
    },
    {
      "n": 7,
      "text": "加辣椒粉炒匀，倒入土豆泥与豌豆翻拌成馅并调味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "馅要干爽能成团，湿了会破皮。",
      "visual_cue": "馅料成团，颜色金黄"
    },
    {
      "n": 8,
      "text": "馅料拌入香菜碎后盛出彻底放凉，凉透再包。",
      "time_min": 10,
      "heat": "无火",
      "tip": "热馅会软化面皮，包的时候容易破。",
      "visual_cue": "馅料凉透，粒粒分明"
    },
    {
      "n": 9,
      "text": "面团分成十份擀成薄圆片，对切成两个半圆。",
      "time_min": 12,
      "heat": "无火",
      "tip": "擀薄一点，炸的时候才透。",
      "visual_cue": "面片薄而均匀，边缘整齐"
    },
    {
      "n": 10,
      "text": "半圆面片卷成圆锥，填入一勺馅后捏紧封口成三角。",
      "time_min": 14,
      "heat": "无火",
      "tip": "封口捏紧并压花，炸时才不漏馅。",
      "visual_cue": "三角饱满，封口紧密"
    },
    {
      "n": 11,
      "text": "炸锅倒植物油烧至中温，下三角炸五分钟至金黄起泡。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温中等，外皮酥且内部熟透。",
      "visual_cue": "表面金黄起小泡，浮起"
    },
    {
      "n": 12,
      "text": "捞出沥干油分，稍凉后配一碟酸辣酱一起食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃最酥，凉了皮会回软。",
      "visual_cue": "外皮金黄酥脆，轻敲有响声"
    }
  ],
  "tips": [
    "面团要偏硬并醒足时间，擀薄才不回缩。",
    "馅料炒干并彻底放凉，包的时候才不破皮。",
    "油温中等慢炸，皮酥且不会含油。"
  ],
  "common_mistakes": [
    "面团太软，炸出来皮厚发硬不酥。",
    "馅料还热就包，面皮被水汽泡破。",
    "油温太低，三角吸满油又软又塌。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "400 克:400 克",
      "note": "甜味更明显，需减少糖分调味。"
    },
    {
      "original": "豌豆",
      "substitute": "玉米粒",
      "ratio": "150 克:150 克",
      "note": "口感更甜，颜色更亮。"
    }
  ],
  "variations": [
    "馅里加一勺咖喱粉，风味更浓更地道。",
    "做成小个一口装，更适合当茶点。"
  ],
  "serving_suggestion": "趁热配酸辣酱或酸奶酱，作为下午小吃。",
  "storage": "冷藏三天，复热用烤箱两百度烤八分钟回酥。",
