  "steps": [
    {
      "n": 1,
      "text": "香米淘洗三遍至水清，浸泡二十分钟后沥干备用。",
      "time_min": 22,
      "heat": "无火",
      "tip": "米泡透煮出来才松散，不泡容易夹生。",
      "visual_cue": "米粒饱满发白，沥干不滴水"
    },
    {
      "n": 2,
      "text": "番茄切块，洋葱切丝，青辣椒切段，大蒜切末。",
      "time_min": 9,
      "heat": "无火",
      "tip": "番茄切大块就好，煮的时候会化开。",
      "visual_cue": "番茄块带汁，洋葱丝均匀"
    },
    {
      "n": 3,
      "text": "炒锅倒花生油下芥末籽小火炒至爆开，加咖喱叶炒十秒出香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芥末籽和咖喱叶是南印菜的香底子。",
      "visual_cue": "芥末籽跳起，咖喱叶变深绿"
    },
    {
      "n": 4,
      "text": "下洋葱丝中火炒五分钟至软塌微黄，加蒜末和青辣椒炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到发甜，番茄的酸才不冲。",
      "visual_cue": "洋葱软塌微黄，蒜香飘出"
    },
    {
      "n": 5,
      "text": "倒入番茄块大火炒六分钟，边炒边压至化成浓糊。",
      "time_min": 7,
      "heat": "大火",
      "tip": "番茄一定要炒化出红油，饭才上色。",
      "visual_cue": "番茄塌软成糊，锅底一层红油"
    },
    {
      "n": 6,
      "text": "加姜黄粉、辣椒粉和盐炒匀，倒入沥干的香米翻炒两分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "米粒炒到挂上红油，煮出来才粒粒分明。",
      "visual_cue": "米粒染成橘红色，颗粒松散"
    },
    {
      "n": 7,
      "text": "加清水大火烧开，转小火盖盖焖十五分钟，关火再焖五分钟。",
      "time_min": 21,
      "heat": "小火",
      "tip": "水量按米量一比一点五，多了会烂。",
      "visual_cue": "水收干，米粒立起透亮"
    },
    {
      "n": 8,
      "text": "开盖先用叉子把米饭拨松，尝味补盐后装盘，粒粒分明最好看。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用叉子拨松不粘块，米粒保持完整。",
      "visual_cue": "米饭蓬松分明，橘红诱人"
    }
  ],
  "tips": [
    "香米泡二十分钟，煮出来才粒粒分明。",
    "番茄一定要炒化成糊，米饭才够红够味。",
    "米粒先炒过再加水，成品更松散。",
    "关火焖五分钟再开盖，米芯才熟透。"
  ],
  "common_mistakes": [
    "番茄没炒化就加水，米饭颜色发白味道淡。",
    "水放太多又用大火，煮出来变成一锅番茄粥。",
    "全程大火，锅底焦了上面还夹生。",
    "煮好马上翻动，米粒被搅断变成糊。"
  ],
  "substitutions": [
    {
      "original": "香米",
      "substitute": "长粒米",
      "ratio": "270克:270克",
      "note": "需多泡十分钟，口感略硬。"
    },
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "400克:350克",
      "note": "酸味更浓，盐减一克。"
    }
  ],
  "variations": [
    "加一把花生米同煮，口感更丰富。",
    "放两片柠檬叶同煮，香气更清凉解腻。",
    "拌入一勺酥炸洋葱，最后口感更香脆。"
  ],
  "serving_suggestion": "装盘后配一碟酸奶或一碗扁豆汤，酸甜微辣，单吃也很香。",
  "storage": "冷藏可放两天，复热撒一勺清水盖盖小火焖五分钟。",
