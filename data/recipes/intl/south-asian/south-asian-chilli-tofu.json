  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "漏勺",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切两厘米方块，用厨房纸吸干表面水分后静置五分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水分吸得越干，裹粉越匀，炸出来越脆。",
      "visual_cue": "豆腐块表面干爽，边角完整"
    },
    {
      "n": 2,
      "text": "玉米淀粉倒进碗里，把豆腐块逐块滚上一层薄粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一块块滚粉，薄薄一层才脆不糊。",
      "visual_cue": "豆腐块表面均匀挂白粉"
    },
    {
      "n": 3,
      "text": "炒锅倒花生油烧至七成热，豆腐块分两批下锅炸三分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "分两批炸，油温才不掉，豆腐才酥。",
      "visual_cue": "豆腐表皮金黄起壳，捞出沥油"
    },
    {
      "n": 4,
      "text": "锅留底油下姜末、蒜末和青辣椒段炒三十秒出香味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "姜蒜炒香即可，别炒到发黄。",
      "visual_cue": "蒜末微黄，辣椒段翠绿"
    },
    {
      "n": 5,
      "text": "下洋葱块大火翻炒两分钟，炒到边缘透明而中心还带着脆劲。",
      "time_min": 3,
      "heat": "大火",
      "tip": "洋葱保持脆劲，这道菜才有层次。",
      "visual_cue": "洋葱边缘透明，中心仍挺"
    },
    {
      "n": 6,
      "text": "加生抽、辣椒粉、盐、白糖和清水烧开，淋香醋调成亮汁。",
      "time_min": 3,
      "heat": "大火",
      "tip": "汁要烧开再下豆腐，味道才融合。",
      "visual_cue": "锅底汤汁红亮，微微冒泡"
    },
    {
      "n": 7,
      "text": "倒入炸好的豆腐块大火翻炒一分钟，撒小葱段翻匀出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆腐回锅只翻一分钟，久了就不脆了。",
      "visual_cue": "豆腐块裹上红亮酱汁，葱段翠绿"
    }
  ],
  "tips": [
    "豆腐一定要吸干水分，裹粉才均匀不脱落。",
    "分两批下锅炸，油温稳定豆腐才酥脆。",
    "洋葱只炒到边缘透明，留住脆劲口感才好。",
    "豆腐回锅时间要短，久了外壳就回软。"
  ],
  "common_mistakes": [
    "豆腐带水下锅，油花四溅还炸不酥。",
    "一次全倒进锅，油温骤降，豆腐吸油发腻。",
    "洋葱炒到全软烂，成品没有脆感层次。",
    "豆腐在汁里翻炒太久，外壳泡软像煮豆腐。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "老豆腐",
      "ratio": "450克:450克",
      "note": "更紧实，炸的时候不易碎。"
    },
    {
      "original": "青辣椒",
      "substitute": "彩椒",
      "ratio": "30克:60克",
      "note": "不辣版本，适合怕辣的人。"
    }
  ],
  "variations": [
    "加一把炸过的腰果同炒，口感更香脆。",
    "换成番茄酱打底，做成酸甜口更讨小孩喜欢。",
    "把豆腐换成花菜，做成干烧花菜同样好吃。"
  ],
  "serving_suggestion": "装盘后撒一把小葱段，配炒饭或炒面，酸甜带辣，很下饭。",
  "storage": "冷藏可放一天，复热用炒锅大火干煸三分钟，微波会回软。",
