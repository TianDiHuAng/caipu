        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 90,
          "unit": "g",
          "note": "按甜度调整",
          "optional": false
        },
        {
          "name": "腰果",
          "name_en": "cashew",
          "amount": 40,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "葡萄干",
          "name_en": "raisin",
          "amount": 30,
          "unit": "g",
          "note": "温水泡软",
          "optional": false
        },
        {
          "name": "小豆蔻",
          "name_en": "cardamom",
          "amount": 4,
          "unit": "g",
          "note": "去壳磨粉",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "刨丝器",
    "木勺",
    "平底小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "胡萝卜去皮擦成细丝，越细越容易在短时间内收干水分。",
      "time_min": 15,
      "heat": "无火",
      "tip": "擦丝比切丝快，成品口感也更均匀。",
      "visual_cue": "胡萝卜丝橙色细软，堆成小山"
    },
    {
      "n": 2,
      "text": "厚底锅化一半酥油，中火炒胡萝卜丝八分钟至颜色变深、体积缩小。",
      "time_min": 9,
      "heat": "中火",
      "tip": "先炒能让胡萝卜的甜味集中，不靠糖也甜。",
      "visual_cue": "丝体发亮变软，锅底有橙色油"
    },
    {
      "n": 3,
      "text": "倒入牛奶煮开，转小火边煮边搅四十分钟，直到牛奶几乎全被吸收。",
      "time_min": 42,
      "heat": "小火",
      "tip": "全程小火勤搅，牛奶糊底整锅带焦味。",
      "visual_cue": "混合物稠厚，木勺划过能留痕"
    },
    {
      "n": 4,
      "text": "加白糖继续搅五分钟至完全融化，甜味渗进胡萝卜丝里。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖要在牛奶收干后加，早了会出水。",
      "visual_cue": "糖化开，混合物颜色加深"
    },
    {
      "n": 5,
      "text": "另用小锅化剩下的酥油，把腰果碎炒到金黄，连油一起倒进主锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "腰果炒到微黄就够，深了会发苦。",
      "visual_cue": "腰果金黄，酥油香气散开"
    },
    {
      "n": 6,
      "text": "加泡软的葡萄干和小豆蔻粉，搅匀后再煮两分钟，趁热盛出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "小豆蔻最后加，香气才不跑。",
      "visual_cue": "甜糊油亮，能看到坚果和葡萄干"
    }
  ],
  "tips": [
    "胡萝卜用擦丝器最省力，手切很难切到同样细。",
    "想更浓可以加一百克全脂奶粉，收汁时间缩短十分钟。",
    "冷藏后压成小方块，切块吃像甜点。"
  ],
  "common_mistakes": [
    "大火煮牛奶，锅底焦了整锅发苦。",
    "白糖下得太早，胡萝卜出水煮成了一锅汤。",
    "搅得不够勤，牛奶在锅底结出一层硬皮。"
  ],
  "substitutions": [
    {
      "original": "酥油",
      "substitute": "黄油",
      "ratio": "50克:50克",
      "note": "奶香接近，焦化点低要小火。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油加水",
      "ratio": "700毫升:400毫升加300毫升水",
      "note": "成品更厚，糖可减十克。"
    }
  ],
  "variations": [
    "加一勺椰丝同煮，做成带椰香的南印度风味。",
    "用红糖代替白糖，颜色更深带焦糖香。"
  ],
  "serving_suggestion": "趁温热盛进小碗，配一杯不加糖的奶茶，冬天吃最合适。",
  "storage": "冷藏四天，冷冻一个月；复热加一勺牛奶小火搅开。",
