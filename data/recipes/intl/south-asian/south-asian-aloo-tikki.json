  "equipment": [
    "汤锅",
    "压泥器",
    "砧板",
    "平底锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆带皮冷水下锅，中火煮二十分钟至刀能轻松插透，捞出趁热剥皮。",
      "time_min": 22,
      "heat": "中火",
      "tip": "带皮煮不会吸太多水，压出来才干爽。",
      "visual_cue": "土豆一压就散，皮整片剥落"
    },
    {
      "n": 2,
      "text": "趁热把土豆压成泥，摊开晾十分钟散去水汽。",
      "time_min": 12,
      "heat": "无火",
      "tip": "晾过的土豆泥不粘手，饼才成形。",
      "visual_cue": "泥体干爽，不粘勺不粘手"
    },
    {
      "n": 3,
      "text": "把煮熟的豌豆压碎，和姜末、红辣椒末、香菜、孜然、辣椒粉及一半盐一起拌进土豆泥。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豌豆留一半颗粒，口感更有层次。",
      "visual_cue": "混合物颜色斑驳，能捏成团"
    },
    {
      "n": 4,
      "text": "手上抹点油，取乒乓球大小的土豆泥搓圆压成一厘米厚的饼。",
      "time_min": 6,
      "heat": "无火",
      "tip": "饼别压太薄，煎的时候容易散。",
      "visual_cue": "饼形圆整，厚度均匀"
    },
    {
      "n": 5,
      "text": "饼的两面都薄薄拍一层面粉，再抖掉多余的干粉，避免煎时脱落。",
      "time_min": 2,
      "heat": "无火",
      "tip": "裹粉能封住表面，煎出来壳更脆。",
      "visual_cue": "表面薄白，看不到厚粉块"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油中火烧热，下饼煎四分钟至底面金黄，翻面再煎三分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "一次别超过四个，锅里太挤翻不动。",
      "visual_cue": "两面金黄硬壳，边缘焦脆"
    },
    {
      "n": 7,
      "text": "出锅放在厨房纸上吸油，撒剩下的盐，趁热配酸辣酱吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐最后撒，外壳才不会被腌软。",
      "visual_cue": "饼皮干爽，掰开内部仍软糯"
    }
  ],
  "tips": [
    "土豆选淀粉多的品种，压出来更黏更容易成形。",
    "想更脆可以先裹一层面包糠，再下锅煎到金黄。",
    "吃不完的生饼可以冷冻，煎的时候无需解冻。"
  ],
  "common_mistakes": [
    "土豆煮得太软吸水过多，饼完全成形不了。",
    "没裹面粉直接下锅，饼在锅里散开。",
    "油温太低煎，饼吸油发软不成壳。"
  ],
  "substitutions": [
    {
      "original": "豌豆",
      "substitute": "玉米粒",
      "ratio": "120克:120克",
      "note": "甜味更明显，盐可减一克。"
    },
    {
      "original": "面粉",
      "substitute": "玉米淀粉",
      "ratio": "40克:30克",
      "note": "壳更脆，但裹粉要薄。"
    }
  ],
  "variations": [
    "在饼里包一小块印度奶酪，做成夹心版本。",
    "压成小圆球油炸，就是北印度的 aloo bonda。"
  ],
  "serving_suggestion": "两个饼配一勺酸奶、一勺酸甜罗望子酱和一把洋葱碎，是最常见的街头组合。",
  "storage": "冷藏两天，冷冻一个月；复热用平底锅小火干煎两面各两分钟。",
