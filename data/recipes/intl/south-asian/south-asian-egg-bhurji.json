  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "打蛋器",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切小丁，番茄切丁，青辣椒切圈，姜切末备用。",
      "time_min": 9,
      "heat": "无火",
      "tip": "洋葱丁切小，炒软更快也更入味。",
      "visual_cue": "配料切好分装，丁状均匀"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进碗里加一小撮盐打散，打散即可不用起泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻轻打散就行，过度打发口感会发干。",
      "visual_cue": "蛋液均匀，没有成块蛋清"
    },
    {
      "n": 3,
      "text": "炒锅倒花生油下孜然粒小火炒香，再下洋葱丁中火炒四分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒到透明发甜，蛋才不腥。",
      "visual_cue": "洋葱软塌透明，孜然香味飘出"
    },
    {
      "n": 4,
      "text": "加姜末、青辣椒圈炒香，倒入番茄丁炒三分钟出汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄出汁后，蛋液炒出来才湿润不柴。",
      "visual_cue": "番茄软化出汁，锅底红亮"
    },
    {
      "n": 5,
      "text": "加姜黄粉、辣椒粉和盐炒匀，倒入蛋液静置十秒再翻炒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "先静置十秒让底部凝固，再炒才成块不碎。",
      "visual_cue": "蛋液边缘凝固，开始出现块状"
    },
    {
      "n": 6,
      "text": "用锅铲不停翻炒成松散小蛋块，撒香菜碎关火出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "小火慢炒成小块，口感才嫩不老。",
      "visual_cue": "蛋块松散湿润，香菜翠绿点缀"
    }
  ],
  "tips": [
    "蛋液轻轻打散就好，过度打发口感发干。",
    "洋葱炒到透明发甜，成品的蛋腥味就没了。",
    "蛋液下锅先静置十秒，炒出来才有小块不散。",
    "全程用中小火慢炒，蛋块才嫩而不是又老又干。"
  ],
  "common_mistakes": [
    "蛋液倒进锅立刻猛炒，变成一锅碎渣。",
    "大火久炒，蛋块又老又干像橡皮。",
    "番茄没炒出汁就下蛋液，成品又干又散。",
    "香料放太多盖住蛋香，吃起来只有辣味。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "豆腐",
      "ratio": "5枚:400克",
      "note": "做成素食版，豆腐需先捏碎压水。"
    },
    {
      "original": "青辣椒",
      "substitute": "彩椒",
      "ratio": "15克:40克",
      "note": "完全不辣，适合孩子吃。"
    }
  ],
  "variations": [
    "加一把青豆同炒，颜色和口感更丰富。",
    "出锅前撒一点柠檬汁，酸香解腻。",
    "把炒好的蛋块夹进烤饼里，做成卷饼早餐。"
  ],
  "serving_suggestion": "装盘撒香菜，配两张烤饼或一片吐司，两分钟就能吃完的一顿早饭。",
  "storage": "冷藏不超过一天，复热用小火干炒两分钟，久加热蛋块会老。",
