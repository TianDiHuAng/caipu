  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 220,
          "unit": "ml",
          "note": "和面",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "抹面与烙制",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "出锅刷面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "大碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒进大碗，加盐拌匀后在中间挖出一个凹坑。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先拌匀再加水和，面饼口感才均匀。",
      "visual_cue": "面粉中间有个明显的坑"
    },
    {
      "n": 2,
      "text": "清水要分三次倒入，边倒边用筷子搅成棉絮状。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水别一次倒完，看干湿程度再补。",
      "visual_cue": "面粉结成大小均匀的絮团"
    },
    {
      "n": 3,
      "text": "下手揉成光滑的面团，盖上湿布静置醒二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "醒面够了才擀得开，烙出来也软。",
      "visual_cue": "面团光滑，按压能回弹"
    },
    {
      "n": 4,
      "text": "面团搓成长条，切成八个大小一致的小剂子。",
      "time_min": 4,
      "heat": "无火",
      "tip": "剂子大小一致，烙的时候熟度才统一。",
      "visual_cue": "八个小面团大小一致"
    },
    {
      "n": 5,
      "text": "把小剂子按扁，表面抹一点植物油，擀成圆薄片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "表面抹一层植物油再擀，烙出来层次更分明。",
      "visual_cue": "薄片直径约十八厘米"
    },
    {
      "n": 6,
      "text": "平底锅烧热不放油，放入薄饼用中火烙一分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "锅一定要烧到足够热，饼身才会鼓起来。",
      "visual_cue": "饼面鼓起小泡，底面发白"
    },
    {
      "n": 7,
      "text": "翻面再烙一分钟，看到饼身鼓起大泡就翻回去。",
      "time_min": 3,
      "heat": "中火",
      "tip": "用铲子轻压边缘，能帮助饼鼓起来。",
      "visual_cue": "饼身鼓起，两面上色斑点"
    },
    {
      "n": 8,
      "text": "出锅趁热刷一层融化的黄油，摞起来盖布保温。",
      "time_min": 2,
      "heat": "无火",
      "tip": "出锅刷油再摞起来，饼才软而不干。",
      "visual_cue": "表面油润，摞着微微冒热气"
    }
  ],
  "tips": [
    "面团醒够二十分钟，擀的时候才不回缩。",
    "锅要烧到够热，饼身才会鼓起来。",
    "出锅摞起来盖布，饼能一直保持柔软。"
  ],
  "common_mistakes": [
    "水和得太急，面团粘手揉不成团。",
    "锅不够热就下饼，烙出来又硬又干。",
    "烙好后敞着放，几分钟就变得干硬。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "低筋面粉",
      "ratio": "400 克:400 克",
      "note": "更软，需减少二十毫升水。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "20 克:15 毫升",
      "note": "香气略减，奶香变淡。"
    }
  ],
  "variations": [
    "和面时加一勺孜然粉，香气更浓。",
    "把饼擀得更薄一些，做成更脆的脆饼版本。"
  ],
  "serving_suggestion": "配咖喱、豆泥或者炒蔬菜一起吃，撕开蘸汁最香。",
  "storage": "冷藏两天，复热时用平底锅干烙三十秒回软。",
