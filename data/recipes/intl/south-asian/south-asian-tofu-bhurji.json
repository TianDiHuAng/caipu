  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐用手捏成粗碎块，颗粒留一点大小差别口感更好。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别捏成泥，留些颗粒才有嚼头。",
      "visual_cue": "豆腐碎大小不匀，呈粗颗粒状"
    },
    {
      "n": 2,
      "text": "洋葱切丁，番茄切小丁，青辣椒切圈，大蒜与姜切末。",
      "time_min": 8,
      "heat": "无火",
      "tip": "番茄切小一点，容易炒化出汁。",
      "visual_cue": "各料切好分装，大小均匀"
    },
    {
      "n": 3,
      "text": "炒锅倒花生油下孜然粒小火炒十秒，炒到香味出来且孜然微微变色。",
      "time_min": 2,
      "heat": "小火",
      "tip": "孜然粒先爆香，整道菜的底香就有了。",
      "visual_cue": "孜然粒在油里跳动，香味冲鼻"
    },
    {
      "n": 4,
      "text": "下洋葱丁中火炒四分钟至软塌透明，再加姜末蒜末炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒软出甜，才压得住香料的冲味。",
      "visual_cue": "洋葱透明软塌，蒜末微黄"
    },
    {
      "n": 5,
      "text": "加入番茄丁大火炒三分钟，炒到番茄出汁变软。",
      "time_min": 4,
      "heat": "大火",
      "tip": "番茄出汁后香料才挂得住豆腐碎。",
      "visual_cue": "番茄软烂出汁，锅底一层红汤"
    },
    {
      "n": 6,
      "text": "加姜黄粉、辣椒粉和盐炒匀，倒入豆腐碎中火翻炒三分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆腐碎下锅后要不停翻，防止粘底。",
      "visual_cue": "豆腐碎染成鹅黄色，颗粒松散"
    },
    {
      "n": 7,
      "text": "撒香菜碎翻两下，尝味补盐后关火装盘，趁热吃香气最足。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后放，香气才不被炒掉。",
      "visual_cue": "香菜翠绿点缀，豆腐松散不结团"
    }
  ],
  "tips": [
    "豆腐用手捏碎，比刀切更容易挂上香料。",
    "孜然粒先下锅爆香，整道菜的底味就立住了。",
    "洋葱炒到发甜，香料的冲味才柔和。",
    "香菜关火后再撒，香气保留得最完整。"
  ],
  "common_mistakes": [
    "豆腐捏成细泥，炒出来像糊糊没有颗粒感。",
    "香料和洋葱一起下锅，炒久了发苦发涩。",
    "豆腐下锅后不翻动，底部粘锅焦黑。",
    "番茄没炒出汁就下豆腐，成品又干又散。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "嫩豆腐",
      "ratio": "450克:450克",
      "note": "更细腻，需提前压水十分钟。"
    },
    {
      "original": "青辣椒",
      "substitute": "干辣椒",
      "ratio": "20克:8克",
      "note": "辣味更沉，香气偏干。"
    }
  ],
  "variations": [
    "加一小把青豆同炒，颜色更活泼。",
    "最后淋半勺柠檬汁，酸香更清爽。",
    "用同样的做法把豆腐换成鸡蛋，就是鸡蛋布尔吉。"
  ],
  "serving_suggestion": "配两张热烤饼或一碗白米饭，用勺子舀着吃，香料味浓又不腻。",
  "storage": "冷藏可放一天，复热用小火干炒三分钟，出水后收干即可。",
