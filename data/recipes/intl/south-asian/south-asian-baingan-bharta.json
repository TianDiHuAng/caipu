  "equipment": [
    "明火炉",
    "炒锅",
    "锅铲",
    "叉子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净擦干，用叉子在表面扎几排小孔方便透气。",
      "time_min": 3,
      "heat": "无火",
      "tip": "扎孔能防止烤的时候表皮爆裂。",
      "visual_cue": "表面布满均匀小孔"
    },
    {
      "n": 2,
      "text": "明火直接烤茄子，每两分钟转一次，烤到表皮焦黑。",
      "time_min": 12,
      "heat": "大火",
      "tip": "明火烤才有烟熏味，烤箱替代会差一些。",
      "visual_cue": "表皮全黑起皱，整体软塌"
    },
    {
      "n": 3,
      "text": "烤好的茄子放凉八分钟，剥掉焦皮，只留里面的茄肉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "放凉再剥，手不容易被烫到。",
      "visual_cue": "焦皮整片脱落，茄肉米白"
    },
    {
      "n": 4,
      "text": "用叉子把茄肉压成粗泥，带一点纤维口感更好。",
      "time_min": 3,
      "heat": "无火",
      "tip": "别压太细，留点颗粒更有嚼头。",
      "visual_cue": "泥体粗松，能挂住叉子"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油，中火下孜然粒炒到微微跳动出香味。",
      "time_min": 1,
      "heat": "中火",
      "tip": "孜然一跳就下料，别等它变黑。",
      "visual_cue": "孜然粒跳动，香气冲鼻"
    },
    {
      "n": 6,
      "text": "加洋葱碎炒四分钟，炒到边缘微黄、体积明显变软缩小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒到微黄，甜味才出来。",
      "visual_cue": "洋葱边缘金黄，体积缩小"
    },
    {
      "n": 7,
      "text": "下姜末与蒜末炒一分钟，再加辣椒粉与姜黄炒匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "姜黄容易糊，下锅后马上翻炒。",
      "visual_cue": "油色橙红，香料裹住洋葱"
    },
    {
      "n": 8,
      "text": "倒入番茄丁炒六分钟，炒到番茄完全塌软出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒出汁，整道菜才不干。",
      "visual_cue": "番茄软烂，锅里有红油"
    },
    {
      "n": 9,
      "text": "放入茄泥翻炒五分钟，让茄肉吸足香料和番茄汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "勤翻动，茄泥容易粘锅。",
      "visual_cue": "泥体颜色转橙红，油光明显"
    },
    {
      "n": 10,
      "text": "加盐调味，撒香菜碎翻匀，关火盛盘趁热食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜关火后加，香气才不被煮散。",
      "visual_cue": "表面油亮，香菜翠绿"
    }
  ],
  "tips": [
    "明火烤茄子是这道菜的灵魂，焦皮带来烟熏味。",
    "孜然整粒下锅炒香，比孜然粉香气更足。",
    "茄子压泥别太细，留点纤维口感更好。"
  ],
  "common_mistakes": [
    "茄子用蒸的代替明火烤，完全没烟熏味。",
    "香料下锅后大火炒，姜黄焦成苦味。",
    "番茄没炒出汁就下茄泥，成品又干又散。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "800 克:800 克",
      "note": "需烤箱烤二十分钟，水分更多。"
    },
    {
      "original": "辣椒粉",
      "substitute": "小米辣",
      "ratio": "4 克:2 个",
      "note": "切碎后炒，辣味更冲。"
    }
  ],
  "variations": [
    "拌入一勺酸奶，酸味能压住辣度。",
    "撒一把熟豌豆，口感和颜色都更丰富。"
  ],
  "serving_suggestion": "配烤饼或白米饭，配一碟酸奶一起吃。",
  "storage": "冷藏两天，复热小火加少量水翻炒。",
