  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切三厘米块，加酸奶、姜末和盐抓匀。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "酸奶腌过，肉才嫩不柴。，火候要稳，别忽大忽小。",
      "visual_cue": "肉块挂糊，颜色发白"
    },
    {
      "n": 2,
      "text": "冷藏腌三十分钟，让酸味软化纤维。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "无火",
      "tip": "时间短了效果不明显。，火候要稳，别忽大忽小。",
      "visual_cue": "肉块紧实，表面微干"
    },
    {
      "n": 3,
      "text": "腰果用温牛奶泡软，打成细浆。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打细一点，汤汁才滑。，火候要稳，别忽大忽小。",
      "visual_cue": "浆体细腻，无颗粒，这一点很关键。"
    },
    {
      "n": 4,
      "text": "锅中一半黄油化开，鸡块煎到两面金黄。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎定型再翻，肉才不破。，火候要稳，别忽大忽小。",
      "visual_cue": "表面焦黄，油脂清亮"
    },
    {
      "n": 5,
      "text": "另起锅用余下黄油炒洋葱到软甜。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才出来。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱透明，油色发黄"
    },
    {
      "n": 6,
      "text": "加番茄、蒜末、辣椒粉和咖喱粉炒十五分钟。，火候要稳，别忽大忽小。",
      "time_min": 17,
      "heat": "中火",
      "tip": "炒到番茄散开，酱才浓。，火候要稳，别忽大忽小。",
      "visual_cue": "番茄软烂，油酱分离"
    },
    {
      "n": 7,
      "text": "打成细糊倒回锅，加腰果浆和牛奶。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火加热，奶才不分离。，火候要稳，别忽大忽小。",
      "visual_cue": "汤色橙红，质地顺滑"
    },
    {
      "n": 8,
      "text": "放回鸡块，小火炖十五分钟收汁。，火候要稳，别忽大忽小。",
      "time_min": 17,
      "heat": "小火",
      "tip": "慢炖入味，别大火滚。，火候要稳，别忽大忽小。",
      "visual_cue": "鸡块裹酱，汤汁浓稠"
    },
    {
      "n": 9,
      "text": "补盐，撒香菜，淋一点黄油出锅。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后淋油，香气才亮。，火候要稳，别忽大忽小。",
      "visual_cue": "表面油光，香菜翠绿"
    }
  ],
  "tips": [
    "酸奶腌够时间，肉才嫩。，这一点很关键。",
    "番茄要炒烂，酱才浓。，这一点很关键。",
    "小火加热奶浆，避免分离。，这一点很关键。"
  ],
  "common_mistakes": [
    "大火煮奶浆，油水分离。，这一点很关键。",
    "番茄没炒散，酱里带块。，这一点很关键。",
    "盐放太早，鸡肉出水变硬。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "腰果",
      "substitute": "芝麻",
      "ratio": "40 克:30 克",
      "note": "香气不同，需多加牛奶五十毫升。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "70 克:60 毫升",
      "note": "少了奶香，口感偏清爽。"
    }
  ],
  "variations": [
    "加一点蜂蜜，甜味更圆。，这一点很关键。",
    "用炭火先烤鸡块，烟熏味更足。，这一点很关键。"
  ],
  "serving_suggestion": "配烤饼或米饭，淋酱汁。，这一点很关键。",
  "storage": "冷藏三天，冷冻一个月。，这一点很关键。",
