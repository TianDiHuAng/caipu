        }
      ]
    }
  ],
  "equipment": [
    "深锅",
    "木铲",
    "砧板",
    "压泥器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切成细丁，姜与大蒜分别剁成细末备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "末剁得细一些，炒的时候才不呛口。",
      "visual_cue": "洋葱丁细匀，姜蒜末成糊"
    },
    {
      "n": 2,
      "text": "深锅下植物油，中火把洋葱丁炒到金黄发软。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱炒到金黄，甜味才是咖喱的底。",
      "visual_cue": "洋葱焦黄卷边，油色变深"
    },
    {
      "n": 3,
      "text": "加姜末与蒜末炒一分钟，炒到生味完全散掉。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "姜蒜一定要炒透，生味会毁掉整锅。",
      "visual_cue": "姜蒜末微黄，香气浓烈"
    },
    {
      "n": 4,
      "text": "下咖喱粉快速翻炒二十秒，让香料裹上油脂。",
      "time_min": 1,
      "heat": "小火",
      "tip": "香料遇油才出味，火一大就发焦苦。",
      "visual_cue": "锅里金黄泛油，香气冲鼻"
    },
    {
      "n": 5,
      "text": "倒入番茄块炒六分钟，边炒边用铲背压碎成糊。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄压成糊，酱汁才挂得住豆子。",
      "visual_cue": "番茄化开成浓糊，油浮表面"
    },
    {
      "n": 6,
      "text": "放入煮熟的鹰嘴豆翻匀，让每颗都裹上酱汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "豆子先沥干水分，不然酱会变稀。",
      "visual_cue": "鹰嘴豆油亮，颗颗挂糊"
    },
    {
      "n": 7,
      "text": "加半碗清水小火炖十五分钟，中途轻推防粘。",
      "time_min": 15,
      "heat": "小火",
      "tip": "小火慢慢炖，豆子才吸得进味道。",
      "visual_cue": "汤汁浓稠，豆子微微涨大"
    },
    {
      "n": 8,
      "text": "加盐调味，用压泥器把一小部分鹰嘴豆压碎增稠。",
      "time_min": 3,
      "heat": "小火",
      "tip": "压碎几颗鹰嘴豆，酱汁口感更绵密。",
      "visual_cue": "汤汁更稠，豆泥与整颗混着"
    },
    {
      "n": 9,
      "text": "关火后撒入香菜碎，配上热米饭或烤饼上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜关火后再放，清香才留得住。",
      "visual_cue": "表面翠绿点缀，红黄相衬"
    }
  ],
  "tips": [
    "洋葱炒到金黄，甜味才撑得起香料的冲。",
    "香料只需炒二十秒，炒久了必定发苦。",
    "压碎几颗鹰嘴豆，酱汁自然浓稠。"
  ],
  "common_mistakes": [
    "洋葱没炒透就下香料，成品生辣不甜。",
    "番茄不压碎，酱汁稀薄挂不住豆子。",
    "香料炒到发黑，整锅都是焦苦味。"
  ],
  "substitutions": [
    {
      "original": "鹰嘴豆",
      "substitute": "扁豆",
      "ratio": "350 克:300 克",
      "note": "更易煮软，炖的时间减五分钟。"
    },
    {
      "original": "咖喱粉",
      "substitute": "姜黄粉",
      "ratio": "8 克:5 克",
      "note": "颜色相近，辛香更单纯。"
    }
  ],
  "variations": [
    "加一勺原味酸奶一起炖，酸香更柔和。",
    "最后挤半个柠檬的汁，酸味更明亮。"
  ],
  "serving_suggestion": "盛碗配热米饭或烤饼，旁边放几片生洋葱与柠檬角，解腻又添脆。",
  "storage": "冷藏三天，冷冻可达一个月，复热时加少量清水化开。",
