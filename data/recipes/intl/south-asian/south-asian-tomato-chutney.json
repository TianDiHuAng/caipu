  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫后去皮。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "大火",
      "tip": "去皮后酱才细滑。，火候要稳，别忽大忽小。",
      "visual_cue": "皮肉分离，轻松撕下"
    },
    {
      "n": 2,
      "text": "番茄切块，洋葱切碎备用。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "块切小，煮时才快散。，火候要稳，别忽大忽小。",
      "visual_cue": "番茄成块，洋葱细碎"
    },
    {
      "n": 3,
      "text": "锅中植物油烧热，下芥末籽和咖喱叶爆香。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "籽一跳就下洋葱，别炸焦。，火候要稳，别忽大忽小。",
      "visual_cue": "香气窜出，籽粒跳动"
    },
    {
      "n": 4,
      "text": "加洋葱碎炒三分钟到透明。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才出来。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱软塌，油色发亮"
    },
    {
      "n": 5,
      "text": "下番茄块、姜末和小米辣，中火煮十五分钟。，火候要稳，别忽大忽小。",
      "time_min": 17,
      "heat": "中火",
      "tip": "煮到番茄完全散开。，火候要稳，别忽大忽小。",
      "visual_cue": "汤汁渗出，颜色深红"
    },
    {
      "n": 6,
      "text": "加白糖、盐、辣椒粉和白醋拌匀。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖醋先拌开，味道才均匀。，火候要稳，别忽大忽小。",
      "visual_cue": "酱体发亮，酸甜扑鼻"
    },
    {
      "n": 7,
      "text": "小火再煮五分钟到浓稠挂勺。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "小火",
      "tip": "煮到勺背挂住不流。，火候要稳，别忽大忽小。",
      "visual_cue": "酱体浓稠，表面油光"
    },
    {
      "n": 8,
      "text": "放凉装罐，冷藏保存。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "完全放凉再装罐，才不返潮。，火候要稳，别忽大忽小。",
      "visual_cue": "酱色暗红，质地细腻"
    }
  ],
  "tips": [
    "番茄去皮，酱才细滑。，这一点很关键。",
    "糖醋比例要试，酸甜才平衡。，这一点很关键。",
    "小火收稠，别炒到发黑。，这一点很关键。"
  ],
  "common_mistakes": [
    "番茄没煮散，酱里有块。，这一点很关键。",
    "糖放太少，酸得发涩。，这一点很关键。",
    "火太大，锅底焦糊发苦。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "白醋",
      "substitute": "青柠",
      "ratio": "40 毫升:2 个",
      "note": "酸味更鲜，需在关火后挤入。"
    },
    {
      "original": "小米辣",
      "substitute": "辣椒粉",
      "ratio": "15 克:6 克",
      "note": "辣味更均匀，少了鲜辣。"
    }
  ],
  "variations": [
    "加一点孜然粉，香气更足。，这一点很关键。",
    "加蒜末同炒，风味更冲。，这一点很关键。"
  ],
  "serving_suggestion": "配炸物、烤饼或米饭，当蘸酱。，这一点很关键。",
  "storage": "冷藏两周，取用须用干勺。，这一点很关键。",
