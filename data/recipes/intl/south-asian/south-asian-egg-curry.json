  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅，水开后煮九分钟。，火候要稳，别忽大忽小。",
      "time_min": 11,
      "heat": "中火",
      "tip": "冷水下锅，蛋才不裂。，火候要稳，别忽大忽小。",
      "visual_cue": "水沸翻滚，蛋身完整"
    },
    {
      "n": 2,
      "text": "捞出泡冷水，剥壳后在表面划两刀。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "划刀让咖喱味渗进去。，火候要稳，别忽大忽小。",
      "visual_cue": "蛋身光滑，刀口浅，这一点很关键。"
    },
    {
      "n": 3,
      "text": "锅中植物油烧热，下芥末籽和咖喱叶爆香。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "籽一跳就下洋葱，别炸黑。，火候要稳，别忽大忽小。",
      "visual_cue": "香气窜出，油面波动"
    },
    {
      "n": 4,
      "text": "加洋葱丁炒到金黄透明。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才出来。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱软塌，边缘微焦"
    },
    {
      "n": 5,
      "text": "下姜末、蒜末、咖喱粉和辣椒粉炒香。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料用油炒过，味道才释放。，火候要稳，别忽大忽小。",
      "visual_cue": "油色红亮，香气浓，这一点很关键。"
    },
    {
      "n": 6,
      "text": "加番茄块炒十分钟到软烂出汁。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "中火",
      "tip": "番茄炒烂，汤底才浓。，火候要稳，别忽大忽小。",
      "visual_cue": "番茄散开，汤汁浓稠"
    },
    {
      "n": 7,
      "text": "倒椰奶，小火煮五分钟，别煮沸。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "小火",
      "tip": "椰奶一沸就分层，保持微开。，火候要稳，别忽大忽小。",
      "visual_cue": "汤色奶白，表面微沸"
    },
    {
      "n": 8,
      "text": "放鸡蛋小火煮八分钟入味，加盐撒香菜。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "小火",
      "tip": "轻轻翻动，别把蛋弄破。，火候要稳，别忽大忽小。",
      "visual_cue": "蛋身染红，汤汁浓稠"
    }
  ],
  "tips": [
    "蛋煮好立刻泡冷水，才好剥。，这一点很关键。",
    "椰奶小火加热，别大火滚。，这一点很关键。",
    "蛋身划刀，味道才进得去。，这一点很关键。"
  ],
  "common_mistakes": [
    "椰奶大火煮沸，油水分离。，这一点很关键。",
    "蛋煮过头，蛋黄发青。，这一点很关键。",
    "咖喱粉没炒香，汤发涩。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "200 毫升:200 毫升",
      "note": "少了椰香，需多煮两分钟收稠。"
    },
    {
      "original": "鸡蛋",
      "substitute": "土豆",
      "ratio": "300 克:400 克",
      "note": "需先蒸熟再入锅。"
    }
  ],
  "variations": [
    "加一点罗望子汁，酸味更立体。，这一点很关键。",
    "用酥油替植物油，香气更浓。，这一点很关键。"
  ],
  "serving_suggestion": "配米饭或烤饼，浇汤一起吃。，这一点很关键。",
  "storage": "冷藏两天，复热须煮透。，这一点很关键。",
