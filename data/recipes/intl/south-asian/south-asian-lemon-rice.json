  "equipment": [
    "汤锅",
    "平底锅",
    "木勺",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "米淘净后加四百五十毫升水煮成偏硬的饭，摊在大盘上放凉。",
      "time_min": 22,
      "heat": "中火",
      "tip": "饭要煮得比平时硬一点，拌的时候才不糊。",
      "visual_cue": "米粒分明，摸起来不粘手"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油中火烧热，下芥末籽等到全部爆开跳动。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油要够热芥末籽才爆，冷油下锅不响。",
      "visual_cue": "籽粒噼啪跳起，油面有小泡"
    },
    {
      "n": 3,
      "text": "加腰果炒到微黄，再下红辣椒圈和姜末炒四十秒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "腰果先炒，焦香才出得透。",
      "visual_cue": "腰果金黄，辣椒圈变深红"
    },
    {
      "n": 4,
      "text": "转小火加姜黄粉和一半盐，搅匀后立刻关火，避免姜黄烧焦。",
      "time_min": 1,
      "heat": "小火",
      "tip": "姜黄遇高温会发苦，最后加最安全。",
      "visual_cue": "油色橙黄，香料均匀散开"
    },
    {
      "n": 5,
      "text": "把放凉的米饭倒进锅里，用木勺从底部翻拌，让每粒都沾上香料油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "饭要凉透再拌，热饭会把米粒压烂。",
      "visual_cue": "米粒均匀发黄，松散不结块"
    },
    {
      "n": 6,
      "text": "离火后淋柠檬汁和剩下的盐，撒香菜碎，尝味后调整酸度。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬汁离火加，酸香才清亮不闷。",
      "visual_cue": "饭粒金黄油亮，酸香明显"
    }
  ],
  "tips": [
    "用隔夜冷饭做最省事，米粒也更干爽。",
    "加一勺炸花生或炸豆，口感层次更足。",
    "剩的柠檬饭冷藏后第二天炒热吃，风味更好。"
  ],
  "common_mistakes": [
    "饭还热就拌，米粒被压成一团糊。",
    "芥末籽没爆开就下料，成品带生苦味。",
    "柠檬汁和饭一起加热，酸味变闷。"
  ],
  "substitutions": [
    {
      "original": "腰果",
      "substitute": "花生米",
      "ratio": "40克:40克",
      "note": "便宜好买，香气更重。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "60克:50克",
      "note": "酸味更尖锐，用量要少一点。"
    }
  ],
  "variations": [
    "加一把煮熟的豌豆，做成更饱腹的版本。",
    "用椰油代替植物油，南印度风味更明显。"
  ],
  "serving_suggestion": "配酸奶、一份番茄酸辣酱和几片黄瓜，就是南印度家里最常见的午餐盘。",
  "storage": "冷藏两天；复热用平底锅小火干炒，别用微波炉否则米粒返生。",
