  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 900,
          "unit": "ml",
          "note": "全脂，分两次加",
          "optional": false
        },
        {
          "name": "大米",
          "name_en": "rice",
          "amount": 80,
          "unit": "g",
          "note": "短粒米，泡二十分钟",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "杏仁",
          "name_en": "almond",
          "amount": 20,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "腰果",
          "name_en": "cashew",
          "amount": 20,
          "unit": "g",
          "note": "切小粒",
          "optional": false
        },
        {
          "name": "葡萄干",
          "name_en": "raisin",
          "amount": 20,
          "unit": "g",
          "note": "温水泡软",
          "optional": false
        },
        {
          "name": "豆蔻",
          "name_en": "cardamom",
          "amount": 1,
          "unit": "g",
          "note": "磨成粉",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 15,
          "unit": "g",
          "note": "最后淋入",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "小煎锅",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后泡二十分钟，沥干水分备用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡过的米更容易煮开花。",
      "visual_cue": "米粒发白，一捻就碎"
    },
    {
      "n": 2,
      "text": "厚底锅倒入七百毫升牛奶，中火加热到锅边冒小泡。",
      "time_min": 5,
      "heat": "中火",
      "tip": "厚底锅不易糊，边加热边搅。",
      "visual_cue": "锅边起一层细密小泡"
    },
    {
      "n": 3,
      "text": "下大米转小火，边煮边搅拌十五分钟至米粒开花。",
      "time_min": 15,
      "heat": "小火",
      "tip": "全程别停手，米沉底就会糊。",
      "visual_cue": "米粒开花，汤汁变稠"
    },
    {
      "n": 4,
      "text": "倒入余下的牛奶搅匀，继续小火慢煮十分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "分次加奶，口感更顺滑不稠结。",
      "visual_cue": "质地像稀粥，能挂勺"
    },
    {
      "n": 5,
      "text": "加白糖搅到完全化开，再煮五分钟收稠出香味。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖后放，米才容易煮烂。",
      "visual_cue": "甜味均匀，表面泛光"
    },
    {
      "n": 6,
      "text": "小煎锅放黄油，下杏仁碎与腰果粒小火炒香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "坚果炒到微黄就够，焦了会苦。",
      "visual_cue": "坚果金黄，香气上升"
    },
    {
      "n": 7,
      "text": "把坚果与葡萄干倒进布丁里，加豆蔻粉拌匀。",
      "time_min": 2,
      "heat": "小火",
      "tip": "豆蔻只需一点点，多了发苦。",
      "visual_cue": "香气复合，粒粒可见"
    },
    {
      "n": 8,
      "text": "盛入碗中，可趁热吃，或冷藏一小时后再食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冷藏后更浓稠，口感像奶冻。",
      "visual_cue": "表面结起一层薄薄奶皮"
    }
  ],
  "tips": [
    "全程小火慢煮，火大了奶容易分离。",
    "米要用短粒的，长粒米煮不出绵密感。",
    "坚果现炒现用，回软的坚果不香。"
  ],
  "common_mistakes": [
    "牛奶一次全倒，煮的时间不够，米心还硬。",
    "中途不搅拌，锅底结一层焦糊黑底。",
    "糖一开始就放进去，米粒久煮也不易烂。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "900 毫升:700 毫升",
      "note": "奶香变椰香，需多加一百毫升清水。"
    },
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "20 克:20 克",
      "note": "先烤香再切碎，风味更足。"
    }
  ],
  "variations": [
    "加一小撮藏红花，颜色金黄，香气更贵气。",
    "用红糖替代白糖，颜色偏褐，焦香更深。"
  ],
  "serving_suggestion": "热食时撒坚果，冷食时配一片芒果。",
  "storage": "冷藏三天，表面盖保鲜膜防结皮；冷食口感更佳。",
