  "equipment": [
    "汤锅",
    "料理机",
    "平底锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜洗净后放进沸水焯一分钟，捞出立刻过冷水，挤干水分。",
      "time_min": 8,
      "heat": "中火",
      "tip": "焯水去草酸，过冷水能保住翠绿。",
      "visual_cue": "菠菜深绿软塌，挤出的水发黑"
    },
    {
      "n": 2,
      "text": "焯好的菠菜放料理机打成细泥，太干可加两勺清水。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打成泥不要留粗纤维，口感才顺。",
      "visual_cue": "菜泥细腻，颜色浓绿"
    },
    {
      "n": 3,
      "text": "平底锅化一半酥油，中火把印度奶酪块两面各煎一分钟至微黄，盛出泡进温盐水。",
      "time_min": 4,
      "heat": "中火",
      "tip": "泡盐水能让奶酪保持软嫩不硬。",
      "visual_cue": "奶酪块边缘金黄，内部仍软"
    },
    {
      "n": 4,
      "text": "同一锅加剩下的酥油，下孜然粒炒二十秒至噼啪响，再下洋葱丁炒五分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "孜然粒先爆香，整道菜的底味就定了。",
      "visual_cue": "孜然跳动，洋葱透明发软"
    },
    {
      "n": 5,
      "text": "加蒜末和姜末炒一分钟，下番茄块炒到塌软出汁，加辣椒粉和姜黄炒匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄要炒出红色油，酱体才不涩。",
      "visual_cue": "番茄散开，锅底有红油"
    },
    {
      "n": 6,
      "text": "倒入菠菜泥和一半盐，小火煮五分钟至浓稠，尝味补盐。",
      "time_min": 6,
      "heat": "小火",
      "tip": "菠菜泥容易溅，边煮边搅。",
      "visual_cue": "酱体稠绿，边缘冒小泡"
    },
    {
      "n": 7,
      "text": "放回煎好的印度奶酪块煮两分钟，淋淡奶油划圈，关火加盖焖一分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "奶酪最后煮，久了会变韧。",
      "visual_cue": "奶酪吸满绿酱，表面有白色奶油纹"
    }
  ],
  "tips": [
    "菠菜焯水后一定要挤干，否则酱会出水。",
    "想要更浓可以加一勺腰果泥，口感更像餐馆版。",
    "配印度薄饼或白米饭都合适，蘸着吃最香。"
  ],
  "common_mistakes": [
    "菠菜没焯水直接打泥，成品带涩味。",
    "印度奶酪煎过了头，煮完之后变成橡皮一样的硬块。",
    "火开得太大煮菠菜泥，颜色转成暗黄发黑。"
  ],
  "substitutions": [
    {
      "original": "印度奶酪",
      "substitute": "老豆腐",
      "ratio": "250克:250克",
      "note": "压干水分再煎，口感接近但更软。"
    },
    {
      "original": "酥油",
      "substitute": "植物油",
      "ratio": "25克:22毫升",
      "note": "少了奶香，孜然用量可略增。"
    }
  ],
  "variations": [
    "把菠菜换成芥菜叶，做成更苦香的 saag paneer。",
    "加一把玉米粒，甜味能压住菠菜的涩。"
  ],
  "serving_suggestion": "盛在浅盘里配两张印度薄饼、一小碟洋葱和柠檬，是最常见的家庭套餐组合。",
  "storage": "冷藏两天，冷冻会影响奶酪口感；复热小火加两勺水慢慢拌开。",
