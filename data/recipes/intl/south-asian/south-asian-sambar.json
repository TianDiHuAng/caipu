  "equipment": [
    "锅",
    "木勺",
    "碗",
    "小煎锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扁豆洗净，加清水煮开后转小火。，锅温要匀，别忽高忽低。",
      "time_min": 10,
      "heat": "小火",
      "tip": "水开再转小火，豆汤才清。，火力保持中等，慢慢来。",
      "visual_cue": "汤面翻滚，豆子浮起"
    },
    {
      "n": 2,
      "text": "煮二十五分钟到豆子完全散开。，火候宁小勿大，慢慢推进。",
      "time_min": 27,
      "heat": "小火",
      "tip": "煮到用勺一压就碎。，注意锅里温度别掉下来。",
      "visual_cue": "豆粒开花，汤变稠，这点要注意。"
    },
    {
      "n": 3,
      "text": "罗望子用热水泡开，滤出酸汁。，始终中小火，别心急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡软后揉出汁，渣别下锅。，火要均匀，食材才不糊。",
      "visual_cue": "汁液深褐，果肉分离"
    },
    {
      "n": 4,
      "text": "锅中植物油烧热，下芥末籽爆到跳。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "中火",
      "tip": "籽一跳就下料，别等发黑。，全程留意火候，别贪快。",
      "visual_cue": "籽粒跳动，香气窜出"
    },
    {
      "n": 5,
      "text": "加咖喱叶、姜末和洋葱丁炒到软。，火大了就离锅远一点。",
      "time_min": 6,
      "heat": "中火",
      "tip": "咖喱叶一炸就香，动作要快。，火别开太大，稳着来。",
      "visual_cue": "洋葱透明，油色发黄"
    },
    {
      "n": 6,
      "text": "下番茄和辣椒粉炒到出汁。，锅温要匀，别忽高忽低。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄炒烂，汤才酸甜平衡。，火力保持中等，慢慢来。",
      "visual_cue": "番茄软塌，汤汁渗出"
    },
    {
      "n": 7,
      "text": "把豆汤和罗望子汁倒入锅中，加咖喱粉。，火候宁小勿大，慢慢推进。",
      "time_min": 4,
      "heat": "中火",
      "tip": "慢慢倒，边倒边搅。，注意锅里温度别掉下来。",
      "visual_cue": "汤色橙褐，浓稠挂勺"
    },
    {
      "n": 8,
      "text": "小火煮十分钟，加盐调味，撒香菜。，始终中小火，别心急。",
      "time_min": 12,
      "heat": "小火",
      "tip": "盐最后加，豆才不硬。，火要均匀，食材才不糊。",
      "visual_cue": "汤面微沸，香菜浮面"
    }
  ],
  "tips": [
    "豆子煮到散开，汤才稠。，这是关键点。",
    "罗望子汁滤渣，口感才顺。，别嫌麻烦，做完它。",
    "芥末籽爆香是灵魂，别省。，这一步别省。"
  ],
  "common_mistakes": [
    "豆子没煮烂，汤里全是颗粒。，别跳过这步。",
    "罗望子放太多，酸得发涩。，这步最关键。",
    "芥末籽炸黑，整锅发苦。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "罗望子",
      "substitute": "青柠",
      "ratio": "30 克:2 个",
      "note": "酸味更清，需在关火后挤入。"
    },
    {
      "original": "扁豆",
      "substitute": "绿豆",
      "ratio": "250 克:250 克",
      "note": "煮的时间缩短五分钟。"
    }
  ],
  "variations": [
    "加茄子块同煮，口感更丰富。，这里最容易翻车。",
    "加一勺酥油，香气更浓。，别小看这一步。"
  ],
  "serving_suggestion": "浇在米饭上，或配蒸米糕。，成败就在这一步。",
  "storage": "冷藏三天，冷冻一个月。，这点要注意。",
