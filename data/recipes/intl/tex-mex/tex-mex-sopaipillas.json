  "equipment": [
    "锅",
    "擀面杖",
    "刀",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉、泡打粉和盐放盆里拌匀。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先拌干料，膨松才均匀。，火候要稳，别忽大忽小。",
      "visual_cue": "粉末均匀，无结块，这一点很关键。"
    },
    {
      "n": 2,
      "text": "加冷黄油丁，用指尖搓成粗砂状。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油要冷，层次才明显。，火候要稳，别忽大忽小。",
      "visual_cue": "颗粒细碎，手感发沙"
    },
    {
      "n": 3,
      "text": "倒牛奶和清水，揉成软面团。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "揉到不粘手就停，别揉过头。，火候要稳，别忽大忽小。",
      "visual_cue": "面团柔软，表面光滑"
    },
    {
      "n": 4,
      "text": "盖布醒二十分钟，让面筋松弛。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "无火",
      "tip": "醒够时间，擀时才不回缩。，火候要稳，别忽大忽小。",
      "visual_cue": "面团松弛，按压有坑"
    },
    {
      "n": 5,
      "text": "擀成三毫米厚，切成三角小片。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致，炸时才一起熟。，火候要稳，别忽大忽小。",
      "visual_cue": "面片均匀，边缘整齐"
    },
    {
      "n": 6,
      "text": "植物油倒进深锅，中火烧到一百七十度左右。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温不够，饼会吸油发硬。，火候要稳，别忽大忽小。",
      "visual_cue": "油面微动，筷子冒小泡"
    },
    {
      "n": 7,
      "text": "下饼片炸到鼓起并金黄，翻面再炸。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中火",
      "tip": "一次别下太多，油温才稳。，火候要稳，别忽大忽小。",
      "visual_cue": "饼片膨胀，颜色金黄"
    },
    {
      "n": 8,
      "text": "捞出沥油，趁热滚白糖食用。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热蘸糖，糖才粘得住。，火候要稳，别忽大忽小。",
      "visual_cue": "表面糖粒，外脆内空"
    }
  ],
  "tips": [
    "黄油要冷，搓出的层次才酥。，这一点很关键。",
    "油温一百七十度最合适，太低会吸油。",
    "趁热蘸糖，糖才挂得住。，这一点很关键。"
  ],
  "common_mistakes": [
    "面团揉过头，炸后发硬。，这一点很关键。",
    "油温太低，饼吸满油。，这一点很关键。",
    "面片太厚，中间不熟。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "40 克:35 毫升",
      "note": "少了奶香，口感偏脆。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "60 克:50 克",
      "note": "淋着吃，甜味更润。"
    }
  ],
  "variations": [
    "面团里加一勺肉桂粉，香气更足。，这一点很关键。",
    "炸好后淋炼乳，甜味更浓。，这一点很关键。"
  ],
  "serving_suggestion": "趁热撒白糖，配热饮一起吃。，这一点很关键。",
  "storage": "现炸现吃，密封可存一天。，这一点很关键。",
