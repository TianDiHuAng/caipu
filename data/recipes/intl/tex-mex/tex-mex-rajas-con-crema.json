  "equipment": [
    "平底锅",
    "锅铲",
    "刨丝器",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青椒去蒂去籽切成宽条，洋葱切丝，大蒜切末分开放。",
      "time_min": 10,
      "heat": "无火",
      "tip": "青椒条别切太细，煎软后还要有口感。",
      "visual_cue": "青椒条宽窄一致，籽去干净"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油中火烧热，下洋葱丝炒四分钟至透明发软。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱先下，甜味才能出来。",
      "visual_cue": "洋葱软塌透亮，锅底无焦色"
    },
    {
      "n": 3,
      "text": "倒入青椒条大火煎六分钟，中途只翻两次，让表面带焦点。",
      "time_min": 7,
      "heat": "中火",
      "tip": "少翻动青椒才有焦斑，味道更香。",
      "visual_cue": "青椒边缘起褐斑，体积缩小"
    },
    {
      "n": 4,
      "text": "加蒜末、一半盐和黑胡椒炒一分钟至蒜香出来。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蒜末最后加，炒久会发苦。",
      "visual_cue": "蒜末微黄，香气明显"
    },
    {
      "n": 5,
      "text": "转小火倒入酸奶油和切达奶酪丝，慢慢翻拌三分钟至切达奶酪化开成酱。",
      "time_min": 4,
      "heat": "小火",
      "tip": "火必须小，酸奶油一滚就分离出水。",
      "visual_cue": "酱体奶白浓稠，裹住青椒"
    },
    {
      "n": 6,
      "text": "尝味补盐，把青椒卷进加热过的玉米饼里，趁热上桌。",
      "time_min": 4,
      "heat": "小火",
      "tip": "饼要先烘软，卷时才不裂。",
      "visual_cue": "卷起不破，切口能看到奶白酱"
    }
  ],
  "tips": [
    "青椒选肉质厚的甜椒，辣度低也更耐煎。",
    "加一把煮熟的玉米粒，甜味和口感都更丰富。",
    "不喜欢酸奶油可全用奶酪，酱会更浓。"
  ],
  "common_mistakes": [
    "大火煮酸奶油，奶白酱瞬间分离成水。",
    "青椒炒太久，软成一片没有咬口。",
    "玉米饼没提前烘软就卷，一折就裂开。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "淡奶油加半勺柠檬汁",
      "ratio": "150毫升:140毫升",
      "note": "静置十分钟后再用，酸度接近。"
    },
    {
      "original": "切达奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "80克:80克",
      "note": "拉丝更好，咸味更淡。"
    }
  ],
  "variations": [
    "加几片煎过的培根，咸香更突出。",
    "做成烤盘版，表面撒奶酪进烤箱烤到起泡。"
  ],
  "serving_suggestion": "卷成两份配黑豆泥和一份莎莎，或作为烤肉旁的配菜直接上桌。",
  "storage": "冷藏两天，复热须小火加一勺牛奶慢慢拌开，避免分离。",
