  "equipment": [
    "烤箱",
    "烤盘",
    "碗",
    "打蛋器",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到一百八十度，烤盘抹油。，锅温要匀，别忽高忽低。",
      "time_min": 10,
      "heat": "无火",
      "tip": "提前预热，膨发才均匀。，火力保持中等，慢慢来。",
      "visual_cue": "烤箱温度到位，烤盘油亮"
    },
    {
      "n": 2,
      "text": "玉米面、面粉、泡打粉和盐拌匀。，火候宁小勿大，慢慢推进。",
      "time_min": 3,
      "heat": "无火",
      "tip": "干料先混匀，避免结块。，注意锅里温度别掉下来。",
      "visual_cue": "粉末均匀，无颗粒，别小看这一步。"
    },
    {
      "n": 3,
      "text": "牛奶、鸡蛋、融化黄油和白糖搅匀。，始终中小火，别心急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油别太烫，免得蛋结块。，火要均匀，食材才不糊。",
      "visual_cue": "液体顺滑，颜色淡黄"
    },
    {
      "n": 4,
      "text": "湿料倒进干料，刮刀翻拌到无干粉。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到无干粉就停，别过度搅。，全程留意火候，别贪快。",
      "visual_cue": "面糊粗糙，略有小疙瘩"
    },
    {
      "n": 5,
      "text": "拌入甜玉米粒，倒进烤盘抹平。，火大了就离锅远一点。",
      "time_min": 4,
      "heat": "无火",
      "tip": "玉米沥干水，面糊才不稀。，火别开太大，稳着来。",
      "visual_cue": "面糊平整，玉米分布匀"
    },
    {
      "n": 6,
      "text": "入烤箱烤三十分钟，表面金黄。，锅温要匀，别忽高忽低。",
      "time_min": 32,
      "heat": "无火",
      "tip": "牙签插入不带糊就是熟了。，火力保持中等，慢慢来。",
      "visual_cue": "表面金黄，边缘离模"
    },
    {
      "n": 7,
      "text": "出炉放凉十分钟再切块。，火候宁小勿大，慢慢推进。",
      "time_min": 12,
      "heat": "无火",
      "tip": "放凉再切，切面才整齐。，注意锅里温度别掉下来。",
      "visual_cue": "切块方正，内部松软"
    }
  ],
  "tips": [
    "面糊别过度搅拌，口感才松。，成败就在这一步。",
    "玉米粒沥干水，面糊才不会稀。，这点要注意。",
    "烤到牙签插入干净就出炉。，这是关键点。"
  ],
  "common_mistakes": [
    "搅拌太久，面包含有韧筋。，别嫌麻烦，做完它。",
    "烤箱没预热，中间塌陷。，这一步别省。",
    "烤过头，边缘发干发硬。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "玉米面",
      "substitute": "玉米饼",
      "ratio": "300 克:300 克",
      "note": "需打碎成粗粉再用。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "80 克:70 毫升",
      "note": "少了奶香，质地略粗。"
    }
  ],
  "variations": [
    "加切达奶酪丝，咸香更足。，这步最关键。",
    "加辣椒丁，做成辣味版。，很多人在这里出错。"
  ],
  "serving_suggestion": "切块配炖豆或辣肉酱一起吃。，这里最容易翻车。",
  "storage": "密封常温两天，冷藏四天。，别小看这一步。",
