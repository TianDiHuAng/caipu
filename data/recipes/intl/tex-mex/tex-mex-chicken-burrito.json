  "steps": [
    {
      "n": 1,
      "text": "面粉加两克盐和清水，揉成光滑面团。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水慢慢加，面团才不粘手。，火候要稳，别忽大忽小。",
      "visual_cue": "面团光滑，按下回弹"
    },
    {
      "n": 2,
      "text": "盖布醒二十分钟，分成四份擀成薄饼。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "无火",
      "tip": "擀薄一点，卷起来才好折。，火候要稳，别忽大忽小。",
      "visual_cue": "饼皮圆薄，边缘整齐"
    },
    {
      "n": 3,
      "text": "干锅小火烙饼，两面各烙一分钟。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "不刷油，饼才筋道。，火候要稳，别忽大忽小。",
      "visual_cue": "饼面起斑，柔软有弹性"
    },
    {
      "n": 4,
      "text": "大米淘净加水煮成干爽米饭。，火候要稳，别忽大忽小。",
      "time_min": 25,
      "heat": "小火",
      "tip": "水比平时少一点，饭才不黏。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒分明，干爽松散"
    },
    {
      "n": 5,
      "text": "鸡腿肉切条，用辣椒粉、孜然和盐抓匀。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "抓匀腌十分钟，味道才进。，火候要稳，别忽大忽小。",
      "visual_cue": "肉条挂粉，颜色发红"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油，鸡条煎到两面焦黄。，火候要稳，别忽大忽小。",
      "time_min": 9,
      "heat": "中火",
      "tip": "别急着翻，煎定型再动。，火候要稳，别忽大忽小。",
      "visual_cue": "表面焦褐，肉汁锁住"
    },
    {
      "n": 7,
      "text": "余油炒洋葱丁、蒜末和红腰豆，加盐。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "中火",
      "tip": "豆子压碎几颗，馅才黏。，火候要稳，别忽大忽小。",
      "visual_cue": "豆粒软糯，洋葱透明"
    },
    {
      "n": 8,
      "text": "饼上依次铺米饭、鸡肉、豆子、番茄和切达奶酪。",
      "time_min": 6,
      "heat": "无火",
      "tip": "馅别放太多，卷不住。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料堆叠，边缘留空"
    },
    {
      "n": 9,
      "text": "抹酸奶油和生菜，先折两边再卷紧。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "卷紧一点，切开才不散。，火候要稳，别忽大忽小。",
      "visual_cue": "卷体紧实，两端封口"
    },
    {
      "n": 10,
      "text": "用锡纸包住静置三分钟，对半切开。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置定形，切面才整齐。，火候要稳，别忽大忽小。",
      "visual_cue": "切面层次清楚，馅不外流"
    }
  ],
  "tips": [
    "面团要软，饼才不硬。，这一点很关键。",
    "米饭煮干爽，卷起来不出水。，这一点很关键。",
    "馅别贪多，卷得紧才好吃。，这一点很关键。"
  ],
  "common_mistakes": [
    "饼擀太厚，卷起来折不断。，这一点很关键。",
    "米饭太湿，饼皮很快泡软。，这一点很关键。",
    "馅料太满，一卷就破。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "500 克:500 克",
      "note": "脂肪少，煎的时间减两分钟。"
    },
    {
      "original": "红腰豆",
      "substitute": "白豆",
      "ratio": "200 克:200 克",
      "note": "口感更绵，需减盐一克。"
    }
  ],
  "variations": [
    "加牛油果片，口感更顺滑。，这一点很关键。",
    "换成牛肉馅，就是经典牛肉卷。，这一点很关键。"
  ],
  "serving_suggestion": "对半切开，配辣酱和酸奶油。，这一点很关键。",
  "storage": "冷藏一天，复热须彻底加热。，这一点很关键。",
