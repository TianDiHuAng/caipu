          "name_en": "tomato",
          "amount": 120,
          "unit": "g",
          "note": "去籽切丁",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 15,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
