    "压泥器",
    "木勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红腰豆泡四小时，换水后煮四十分钟。，始终中小火，别心急。",
      "time_min": 282,
      "heat": "大火",
      "tip": "泡透再煮，豆子才易烂。，火要均匀，食材才不糊。",
      "visual_cue": "豆粒软烂，一压就碎"
    },
    {
      "n": 2,
      "text": "留半碗煮豆水，豆子沥干备用。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豆水留着，调稀正好。，全程留意火候，别贪快。",
      "visual_cue": "豆粒沥干，水色发红"
    },
    {
      "n": 3,
      "text": "锅里倒植物油，中火炒洋葱丁。，火大了就离锅远一点。",
      "time_min": 6,
      "heat": "中火",
      "tip": "炒到边缘发黄，甜味才足。，火别开太大，稳着来。",
      "visual_cue": "洋葱软塌，颜色微黄"
    },
    {
      "n": 4,
      "text": "加蒜末、孜然和辣椒粉炒出香味。，锅温要匀，别忽高忽低。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料先炒，豆泥才有底味。，火力保持中等，慢慢来。",
      "visual_cue": "香气浓厚，油色发红"
    },
    {
      "n": 5,
      "text": "倒入豆子，用压泥器边压边炒。，火候宁小勿大，慢慢推进。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "压一半留一半，口感才有层。，注意锅里温度别掉下来。",
      "visual_cue": "豆粒半碎，仍见颗粒"
    },
    {
      "n": 6,
      "text": "分次加豆水，调成浓稠豆泥。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "水慢慢加，别调太稀。，火要均匀，食材才不糊。",
      "visual_cue": "泥体稠厚，能挂勺，这点要注意。"
    },
    {
      "n": 7,
      "text": "加盐调味，小火再炒三分钟。，看住火，别让它失控。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢炒，豆香才浓。，全程留意火候，别贪快。",
      "visual_cue": "豆泥发亮，香气扑鼻"
    },
    {
      "n": 8,
      "text": "盛盘后撒上切达奶酪丝，趁热上桌搭配玉米片食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "余温就能化奶酪。，火大了就离锅远一点。",
      "visual_cue": "奶酪微软，表面油亮"
    }
  ],
  "tips": [
    "豆子泡透再煮，才容易压烂。，这是关键点。",
    "留豆水调稀，味道更浓。，别嫌麻烦，做完它。",
    "压一半留一半，口感有层次。，这一步别省。"
  ],
  "common_mistakes": [
    "豆子没泡透，压不碎还有硬粒。，别跳过这步。",
    "一次加太多水，豆泥稀成汤。，这步最关键。",
    "火太大不搅，锅底糊成焦块。，很多人在这里出错。"
  ],
  "substitutions": [
    {
      "original": "红腰豆",
      "substitute": "白豆",
      "ratio": "400 克:400 克",
      "note": "颜色更浅，味道更淡。"
    },
    {
      "original": "切达奶酪",
      "substitute": "酸奶酪",
      "ratio": "50 克:60 克",
      "note": "酸味更明显，需减盐。"
    }
  ],
  "variations": [
    "加培根碎同炒，咸香更足。，这里最容易翻车。",
    "打成全泥，口感更细腻。，别小看这一步。"
  ],
  "serving_suggestion": "卷饼里抹一层，或配玉米片蘸食。，成败就在这一步。",
  "storage": "冷藏三天，冷冻一个月。，这点要注意。",
