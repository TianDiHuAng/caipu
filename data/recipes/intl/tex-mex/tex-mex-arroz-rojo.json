    "木勺",
    "料理机",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "配料用的米饭用清水淘洗三遍至水基本清澈，摊在筛网上晾十分钟沥干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "米要洗掉表面淀粉，煮出来才粒粒分开。",
      "visual_cue": "米粒干爽，水从筛孔滴尽"
    },
    {
      "n": 2,
      "text": "番茄和一半水打成果浆，加番茄膏搅匀备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "番茄膏先化在浆里，下锅才不结块。",
      "visual_cue": "浆体均匀橙红，无干粉团"
    },
    {
      "n": 3,
      "text": "厚底锅倒植物油中火烧热，下米粒翻炒五分钟至米粒发白、边缘微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "炒米是这道菜的关键，米粒外层要封住。",
      "visual_cue": "米粒松散发亮，有坚果香"
    },
    {
      "n": 4,
      "text": "加洋葱丁和蒜末炒两分钟，再下孜然炒三十秒出香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱别炒焦，否则整锅带苦。",
      "visual_cue": "洋葱软塌，蒜末微黄"
    },
    {
      "n": 5,
      "text": "倒入番茄浆煮两分钟至颜色变深，加盐搅匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "浆要炒到发暗红，生番茄味才走。",
      "visual_cue": "米粒裹上红浆，锅底无积水"
    },
    {
      "n": 6,
      "text": "加剩下的水煮开，转最小火盖盖焖十八分钟，中途不开盖。",
      "time_min": 20,
      "heat": "小火",
      "tip": "水正好没过米一指尖，多了会烂。",
      "visual_cue": "表面出现小孔，锅边无水泡声"
    },
    {
      "n": 7,
      "text": "关火焖五分钟，用叉子从底部翻松，撒香菜碎上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "焖足时间再翻，米粒才会完整。",
      "visual_cue": "米粒分明发亮，带淡红色"
    }
  ],
  "tips": [
    "用隔夜冷饭可省去晾米，但炒的时间缩短到两分钟。",
    "加一勺青豆或玉米粒一起焖，颜色更好看。",
    "锅巴别铲掉，配汤吃是墨西哥人的心头好。"
  ],
  "common_mistakes": [
    "米没洗就直接下锅，煮完粘成一大团。",
    "火太大，锅底焦了上层还是夹生。",
    "焖的时候反复开盖，蒸汽跑掉米粒发硬。"
  ],
  "substitutions": [
    {
      "original": "植物油",
      "substitute": "橄榄油",
      "ratio": "30毫升:30毫升",
      "note": "果香更明显，火力要稍低一点。"
    },
    {
      "original": "番茄膏",
      "substitute": "番茄酱",
      "ratio": "25克:35克",
      "note": "甜度更高，盐减少一克。"
    }
  ],
  "variations": [
    "加一把冷冻豌豆和胡萝卜丁，做成家庭版配菜饭。",
    "用鸡汤代替清水，鲜味明显提升。"
  ],
  "serving_suggestion": "作为配菜配烤鸡、炖豆或墨西哥卷饼，也可以在顶上放一个煎蛋当简餐。",
  "storage": "冷藏三天，冷冻一个月；复热加一勺水盖盖小火焖五分钟。",
