        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶酪切成小块放室温回软，切得越碎融化越快。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冷奶酪直接下锅容易结块。",
      "visual_cue": "奶酪块柔软，边缘微塌"
    },
    {
      "n": 2,
      "text": "厚底锅倒植物油，小火下洋葱末炒到透明发软。",
      "time_min": 3,
      "heat": "小火",
      "tip": "小火慢炒，洋葱甜味才出得来。",
      "visual_cue": "洋葱透明，不焦不黄"
    },
    {
      "n": 3,
      "text": "加蒜末、孜然粉与辣椒粉炒三十秒，香味出来后下青椒碎。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香料遇高温易糊，一定要小火。",
      "visual_cue": "油面泛红，香气升起"
    },
    {
      "n": 4,
      "text": "倒入淡奶油与牛奶，小火加热到锅边冒出小泡。",
      "time_min": 3,
      "heat": "小火",
      "tip": "液体先热，奶酪下去才不会结团。",
      "visual_cue": "液体微沸，边缘起泡"
    },
    {
      "n": 5,
      "text": "分三次撒入奶酪，每次搅到完全融化再加下一批。",
      "time_min": 6,
      "heat": "小火",
      "tip": "少量多次是关键，一次倒下去就结块。",
      "visual_cue": "酱体顺滑，没有颗粒感"
    },
    {
      "n": 6,
      "text": "加入番茄丁与盐搅匀，小火再煮两分钟入味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "番茄最后放，保留一点果酸。",
      "visual_cue": "番茄变软，颜色红亮"
    },
    {
      "n": 7,
      "text": "尝味后按需补盐，撒上香菜碎离火盛出，趁热上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "奶酪本身有咸味，盐要少放。",
      "visual_cue": "浓稠挂勺，能拉丝"
    }
  ],
  "tips": [
    "全程小火，奶酪一沸腾就分离出油。",
    "奶酪选易融化的品种，成品才顺滑。",
    "上桌后小火保温，凉了会结块变硬。"
  ],
  "common_mistakes": [
    "大火煮奶酪，酱体分离成油和渣。",
    "奶酪一次性全倒进去，搅成一团硬疙瘩。",
    "盐放得又早又多，成品咸得发苦。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "100 毫升:120 毫升",
      "note": "更清淡，需多加二十克奶酪。"
    },
    {
      "original": "青椒",
      "substitute": "小米辣",
      "ratio": "60 克:2 个",
      "note": "切碎同炒，辣度明显提升。"
    }
  ],
  "variations": [
    "加一勺炒好的牛肉末，做成肉酱版蘸酱。",
    "撒一层辣椒粉与香菜，颜色更有层次。"
  ],
  "serving_suggestion": "盛入小铸铁锅，配玉米片或烤饼蘸着吃。",
  "storage": "冷藏两天，复热须小火加少量牛奶慢慢搅开。",
