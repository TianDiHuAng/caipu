  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "中筋面粉做饼皮",
          "optional": false
        },
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 300,
          "unit": "g",
          "note": "去骨切条",
          "optional": false
        },
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 200,
          "unit": "g",
          "note": "刨丝",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "甜椒",
          "name_en": "bell pepper",
          "amount": 150,
          "unit": "g",
          "note": "切条",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 120,
          "unit": "g",
          "note": "切丝",
          "optional": false
        },
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "孜然",
          "name_en": "cumin",
          "amount": 3,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 35,
          "unit": "ml",
          "note": "和面与煎制",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 160,
          "unit": "ml",
          "note": "和面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和一百六十毫升清水，揉成光滑软面团，盖布醒二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "面团要软，擀出来的饼皮才不会硬。",
      "visual_cue": "面团光滑，按下去能回弹"
    },
    {
      "n": 2,
      "text": "鸡腿肉切条，加辣椒粉、孜然和少许盐抓匀，腌十分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌十分钟足够，久了肉会出水变柴。",
      "visual_cue": "肉条均匀裹上红棕香料"
    },
    {
      "n": 3,
      "text": "平底锅放少许植物油中火，鸡腿肉铺开煎六分钟到两面焦黄，盛出。",
      "time_min": 7,
      "heat": "中火",
      "tip": "肉条别叠着放，铺开才煎得上色。",
      "visual_cue": "表面焦褐，切断无血色"
    },
    {
      "n": 4,
      "text": "同锅下洋葱丝和甜椒条炒四分钟到断生微甜，和鸡肉放在一起。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蔬菜只需断生，炒软了夹在饼里会出水。",
      "visual_cue": "蔬菜微软仍带脆度"
    },
    {
      "n": 5,
      "text": "面团分成六份擀成薄饼，平底锅不放油中火烙一分钟，两面定型。",
      "time_min": 8,
      "heat": "中火",
      "tip": "饼皮烙到刚定型就起锅，烙老了卷起来会裂。",
      "visual_cue": "饼皮浅黄，边缘带小气泡"
    },
    {
      "n": 6,
      "text": "一张饼皮铺锅里，半边撒奶酪丝，放上鸡肉和蔬菜，再撒一层奶酪。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪上下两层，才能把馅料粘住不散。",
      "visual_cue": "馅料铺满半边，奶酪密布"
    },
    {
      "n": 7,
      "text": "对折压实，中小火两面各煎两分钟到表面金黄、奶酪拉丝。",
      "time_min": 5,
      "heat": "中火",
      "tip": "对折后压一下，让两层饼皮贴紧。",
      "visual_cue": "饼皮焦黄，切口奶酪流出"
    }
  ],
  "tips": [
    "饼皮要擀得薄，煎完才脆而不硬。",
    "奶酪分上下两层撒，馅料才不会散出来。",
    "蔬菜只炒断生，出水会让饼皮变软。"
  ],
  "common_mistakes": [
    "饼皮擀太厚，煎完外面焦了里面还是软面。",
    "奶酪只放一层，翻面时馅料全掉出来。",
    "火太大，饼皮已经黑了奶酪还没融化。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "300 克:300 克",
      "note": "更瘦，腌时加一勺油防柴。"
    },
    {
      "original": "奶酪",
      "substitute": "切达奶酪片",
      "ratio": "200 克:180 克",
      "note": "融化更快，咸味更重需减盐。"
    }
  ],
  "variations": [
    "加一勺酸奶油和牛油果泥，做成蘸酱版本。",
    "用牛肉末替代鸡肉，做成牛肉芝士饼。"
  ],
  "serving_suggestion": "切成三角块装盘，配酸奶油、番茄酱和牛油果酱各一小碟，趁热用手拿着吃。",
  "storage": "冷藏一天，复热用平底锅干煎三分钟恢复脆度，微波会让饼皮发软。",
