  "steps": [
    {
      "n": 1,
      "text": "西葫芦洗净切成一点五厘米的小丁，不用去皮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮留着口感更好，也不容易煮烂。",
      "visual_cue": "丁块大小均匀一致"
    },
    {
      "n": 2,
      "text": "洋葱、大蒜和青椒分别切碎切丁，番茄切小块备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "番茄切小一点，出汁快也更容易融。",
      "visual_cue": "配料大小相近均匀"
    },
    {
      "n": 3,
      "text": "炒锅放植物油中火，下洋葱和大蒜炒到洋葱变透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透才有甜味，别急着下别的。",
      "visual_cue": "洋葱透明，香气上浮"
    },
    {
      "n": 4,
      "text": "加青椒和番茄炒三分钟，炒到番茄软烂出汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄要炒出汁水，整道菜才不干。",
      "visual_cue": "番茄塌软，锅底有汁"
    },
    {
      "n": 5,
      "text": "倒入西葫芦丁和玉米粒翻炒，加盐和黑胡椒炒匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "西葫芦容易出水，火别开得太小。",
      "visual_cue": "蔬菜裹汁，颜色鲜亮"
    },
    {
      "n": 6,
      "text": "淋入淡奶油小火煮三分钟，撒上芝士丝焖到融化。",
      "time_min": 5,
      "heat": "小火",
      "tip": "芝士关火前才放，焖到刚化就停。",
      "visual_cue": "芝士融化，汤汁浓稠"
    },
    {
      "n": 7,
      "text": "关火后撒上香菜碎末，直接连锅端上桌食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜单独撒在表面，颜色才翠绿好看。",
      "visual_cue": "表面芝士拉丝，香气扑鼻"
    }
  ],
  "tips": [
    "西葫芦不用去皮，皮能保住形状不容易煮烂。",
    "番茄先炒出汁，整道菜的底味才够。",
    "芝士关火前才放，焖到刚化就停。"
  ],
  "common_mistakes": [
    "西葫芦切成大块久煮，最后软烂成泥。",
    "火太小炒太久，蔬菜出了一锅水。",
    "芝士早放久煮，结成一块拉不出丝。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "80 毫升:80 毫升",
      "note": "更清爽，需加一点淀粉增稠。"
    },
    {
      "original": "芝士",
      "substitute": "马苏里拉奶酪",
      "ratio": "100 克:100 克",
      "note": "拉丝效果更好。"
    }
  ],
  "variations": [
    "加一勺青辣椒碎，辣味更墨西哥。",
    "用南瓜替代西葫芦，甜味更突出。"
  ],
  "serving_suggestion": "配玉米饼或作为烤肉的配菜，是德州墨西哥餐厅最常见的蔬菜碗。",
  "storage": "冷藏两天，复热用炒锅小火加一勺水，芝士会重新化开。",
