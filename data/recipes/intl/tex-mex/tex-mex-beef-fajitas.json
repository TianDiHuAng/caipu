  "equipment": [
    "铸铁锅",
    "砧板",
    "刀",
    "夹子",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊顺着纹路切成一厘米厚片，再切成手指宽的长条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切口感嫩，顺纹切更有嚼头。",
      "visual_cue": "肉条长短粗细一致"
    },
    {
      "n": 2,
      "text": "肉条加孜然粉、辣椒粉、盐、黑胡椒与一半油抓匀，腌二十五分钟。",
      "time_min": 25,
      "heat": "无火",
      "tip": "腌够时间，香料才吃得进肉里。",
      "visual_cue": "肉条表面挂满香料"
    },
    {
      "n": 3,
      "text": "青椒去籽切成条，洋葱切成同样粗细的长粗丝。",
      "time_min": 6,
      "heat": "无火",
      "tip": "粗细一致，下锅才同步熟。",
      "visual_cue": "菜条均匀，不带籽"
    },
    {
      "n": 4,
      "text": "铸铁锅大火烧到微微冒烟，倒余下的植物油晃匀。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅不够热，肉下去就出水变老。",
      "visual_cue": "油面起细纹，微微冒烟"
    },
    {
      "n": 5,
      "text": "肉条铺开下锅，先别翻动，煎足两分钟再翻面。",
      "time_min": 5,
      "heat": "大火",
      "tip": "留出焦面时间，肉才香。",
      "visual_cue": "底部焦褐，边缘卷起"
    },
    {
      "n": 6,
      "text": "肉条盛出，原锅下青椒与洋葱大火快炒两分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蔬菜要脆，别炒到出水。",
      "visual_cue": "菜边微焦，仍带脆感"
    },
    {
      "n": 7,
      "text": "倒回肉条，加蒜末与盐翻炒一分钟，挤青柠汁。",
      "time_min": 2,
      "heat": "大火",
      "tip": "青柠最后挤，酸香才清亮。",
      "visual_cue": "汁水收干，锅气扑鼻"
    },
    {
      "n": 8,
      "text": "玉米饼烤箱一百八十度烤三分钟，卷上肉与菜即可。",
      "time_min": 3,
      "heat": "中火",
      "tip": "饼烤热才软，冷饼一折就裂。",
      "visual_cue": "饼面鼓起小泡，柔软"
    }
  ],
  "tips": [
    "锅一定要烧够热，分批下肉别挤成一堆。",
    "肉腌好擦去表面多余汁水，煎时更容易上色。",
    "玉米饼用干锅烙十几秒也行，比烤箱更快。"
  ],
  "common_mistakes": [
    "锅温不够就把肉下锅，肉出水变成炖肉。",
    "肉和菜一起下锅，蔬菜出汤把肉泡软。",
    "玉米饼没加热就卷，一折就裂成两半。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "鸡腿肉",
      "ratio": "500 克:500 克",
      "note": "切条后腌二十分钟，煎制时间略短。"
    },
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "150 克:150 克",
      "note": "辣味变淡，甜味更明显。"
    }
  ],
  "variations": [
    "加一勺烟熏辣椒粉，带出炭火气息。",
    "配一碟酸奶油和酪梨酱，卷着吃更润。"
  ],
  "serving_suggestion": "连铸铁锅端上桌，配青柠角、玉米饼和莎莎酱自己卷。",
  "storage": "肉与菜单独冷藏两天；玉米饼密封冷冻，复热后口感接近现做。",
