  "equipment": [
    "砧板",
    "锋利小刀",
    "玻璃碗",
    "压汁器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄对半切开，用小勺挖掉籽和汁水，再切成半厘米见方的小丁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "去籽是关键，否则拌好十分钟就出汤。",
      "visual_cue": "番茄丁方整，碗底无积水"
    },
    {
      "n": 2,
      "text": "洋葱切极细的丁，放进冷水泡五分钟再沥干，去掉辛辣冲味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡水后洋葱只剩清甜，不会盖住番茄。",
      "visual_cue": "洋葱丁细小均匀，入口不呛"
    },
    {
      "n": 3,
      "text": "红辣椒去籽切末，香菜只取叶和嫩梗切碎，青柠挤汁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "辣椒籽是辣度来源，去籽后辣味更干净。",
      "visual_cue": "辣椒末细碎，香菜松散不结块"
    },
    {
      "n": 4,
      "text": "番茄丁、洋葱丁、辣椒末和香菜放进玻璃碗，倒入青柠汁和盐轻轻拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用翻拌不用搅，番茄才不会被压碎。",
      "visual_cue": "材料混合均匀，颜色红白分明"
    },
    {
      "n": 5,
      "text": "撒黑胡椒，尝味后补盐或青柠汁，静置十分钟让味道融合，吃前拌入牛油果丁。",
      "time_min": 12,
      "heat": "无火",
      "tip": "牛油果最后拌，早了会变褐。",
      "visual_cue": "莎莎湿润不流水，牛油果块完整"
    }
  ],
  "tips": [
    "番茄选肉质厚、籽少的品种，成品才不稀。",
    "拌好冷藏不超过四小时，久了香菜发黑。",
    "剩下的莎莎沥干汁水，可以拌进炒蛋里。"
  ],
  "common_mistakes": [
    "番茄没去籽，端上桌已经泡在汤里。",
    "洋葱切太粗，一口下去全是辛辣冲味。",
    "提前几小时拌好，香菜和番茄都塌成一片。"
  ],
  "substitutions": [
    {
      "original": "红辣椒",
      "substitute": "青椒",
      "ratio": "25克:40克",
      "note": "完全不辣，适合孩子吃。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "60克:60克",
      "note": "酸味更柔，用量可稍减。"
    }
  ],
  "variations": [
    "加一勺芒果丁，做成夏天的甜辣版本。",
    "把番茄换成烤过的番茄，烟熏味更重。"
  ],
  "serving_suggestion": "配玉米饼、烤肉或煎鱼，也可以直接当沙拉用勺子吃，撒一点奶酪更香。",
  "storage": "冷藏一天，吃前沥掉渗出的汁水；不建议冷冻，口感会变软烂。",
