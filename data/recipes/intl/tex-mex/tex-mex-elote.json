  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "玉米",
          "name_en": "sweet corn",
          "amount": 500,
          "unit": "g",
          "note": "取玉米粒",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 100,
          "unit": "g",
          "note": "代替酸奶油",
          "optional": false
        },
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 60,
          "unit": "g",
          "note": "擦碎",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "青柠",
          "name_en": "lime",
          "amount": 40,
          "unit": "g",
          "note": "挤汁",
          "optional": false
        },
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米粒剥下后用清水冲一遍，沥干水分备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "沥干再下锅，才不会出水。",
      "visual_cue": "玉米粒干爽，无积水"
    },
    {
      "n": 2,
      "text": "平底锅烧热放入黄油，化开后倒入玉米粒摊平。",
      "time_min": 3,
      "heat": "中火",
      "tip": "摊平别急翻，先让底面焦化。",
      "visual_cue": "玉米粒均匀铺满整个锅底"
    },
    {
      "n": 3,
      "text": "不翻动煎两分钟，让玉米粒底部出现焦褐色斑点。",
      "time_min": 2,
      "heat": "中火",
      "tip": "焦化是这道菜的灵魂。",
      "visual_cue": "底部出现褐色焦斑"
    },
    {
      "n": 4,
      "text": "翻炒再煎三分钟，玉米粒整体变金黄并散出甜香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "别煎太干，留住玉米的汁水。",
      "visual_cue": "玉米粒金黄，香气浓厚"
    },
    {
      "n": 5,
      "text": "加盐与辣椒粉翻匀，关火让玉米稍微降一下温。",
      "time_min": 2,
      "heat": "小火",
      "tip": "关火再拌酸奶，避免结块。",
      "visual_cue": "每粒玉米都裹上红色粉末"
    },
    {
      "n": 6,
      "text": "拌入酸奶与青柠汁，快速翻匀成浓稠的奶香玉米。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酸奶别过量，裹住即可。",
      "visual_cue": "玉米外层裹一层奶白酱汁"
    },
    {
      "n": 7,
      "text": "盛进杯子或小碗，表面撒奶酪碎与少许辣椒粉。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁温热吃，奶香最明显。",
      "visual_cue": "表面奶酪碎分布均匀"
    }
  ],
  "tips": [
    "玉米要煎出焦斑，甜味和香气才够。",
    "关火后再拌酸奶，避免受热结块。",
    "青柠汁千万不能省略，酸味能压住奶腻。"
  ],
  "common_mistakes": [
    "玉米一直翻炒，煎不出焦香只剩水汽。",
    "酸奶倒进滚烫的锅里，立刻结成分离的絮。",
    "辣椒粉一次加太多，盖住玉米本身的甜。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "蛋黄酱",
      "ratio": "100 克:100 克",
      "note": "口感更厚重，青柠汁要加倍。"
    },
    {
      "original": "奶酪",
      "substitute": "干酪粉",
      "ratio": "60 克:40 克",
      "note": "咸味更集中，盐要减半。"
    }
  ],
  "variations": [
    "加一勺辣椒酱同炒，辣味更有层次。",
    "出锅撒一把香菜碎，清香气更突出。"
  ],
  "serving_suggestion": "装在小杯里当开胃小吃，配烤肉刚好。",
  "storage": "冷藏一天，复热用平底锅回炒散开。",
