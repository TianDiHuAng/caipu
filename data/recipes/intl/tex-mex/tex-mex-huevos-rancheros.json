  "equipment": [
    "平底锅",
    "汤锅",
    "锅铲",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅倒植物油，中火下洋葱碎炒三分钟到颜色变透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒透，酱汁才有甜底。",
      "visual_cue": "洋葱透明，边缘微黄"
    },
    {
      "n": 2,
      "text": "加蒜末、辣椒粉与孜然粉炒香，再下番茄丁与青椒丁翻炒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料先炒，红油才出得来。",
      "visual_cue": "油色橙红，香气浓郁"
    },
    {
      "n": 3,
      "text": "加番茄膏、红豆与盐，小火煮十分钟成浓酱。",
      "time_min": 10,
      "heat": "小火",
      "tip": "煮到能用勺划出痕迹就够稠。",
      "visual_cue": "酱体浓稠，勺划留痕"
    },
    {
      "n": 4,
      "text": "平底锅烧热倒少许油，玉米饼两面各烙二十秒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "烙过的饼更香，也不易吸水变软。",
      "visual_cue": "饼面鼓起小泡，边缘微焦"
    },
    {
      "n": 5,
      "text": "同一锅补油，打入鸡蛋，小火煎到蛋白凝固。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盖盖十秒能让蛋白熟而蛋黄流。",
      "visual_cue": "蛋白凝固，蛋黄还晃"
    },
    {
      "n": 6,
      "text": "玉米饼铺在盘中，舀一勺热酱均匀盖在饼面上。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酱要趁热浇，香气才能被饼吸进去。",
      "visual_cue": "饼面被热酱完全覆盖"
    },
    {
      "n": 7,
      "text": "放上煎蛋，撒奶酪丝、香菜碎与少许辣椒粉。",
      "time_min": 2,
      "heat": "无火",
      "tip": "奶酪靠余温融化，不用再加热。",
      "visual_cue": "奶酪微融，颜色分明"
    }
  ],
  "tips": [
    "酱汁提前做好，早上只要煎蛋和烙饼。",
    "鸡蛋要室温的，冷蛋下锅蛋白容易散。",
    "饼烙过之后再浇酱，才不会糊成一团。"
  ],
  "common_mistakes": [
    "酱汁煮得太稀，浇上去把饼泡烂。",
    "鸡蛋大火煎，蛋白焦了蛋黄还是生的。",
    "玉米饼不加热直接用，一折就碎。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "黄豆",
      "ratio": "150 克:150 克",
      "note": "需提前泡发煮软，口感更粉。"
    },
    {
      "original": "奶酪",
      "substitute": "酸奶",
      "ratio": "60 克:80 克",
      "note": "更清爽，酸味能解辣。"
    }
  ],
  "variations": [
    "加一勺酸奶油，辣味会变得更柔和。",
    "把蛋换成炒蛋，做成卷饼更好带。"
  ],
  "serving_suggestion": "一盘放两张饼两个蛋，配一杯黑咖啡或鲜榨橙汁。",
  "storage": "酱汁冷藏三天，饼与蛋现做现吃，不建议久放。",
