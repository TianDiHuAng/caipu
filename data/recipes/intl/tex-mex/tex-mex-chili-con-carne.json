  "steps": [
    {
      "n": 1,
      "text": "厚底锅烧热倒植物油，炒洋葱丁到软。，始终中小火，别心急。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒透，汤底才甜。，火要均匀，食材才不糊。",
      "visual_cue": "洋葱透明，油色发亮"
    },
    {
      "n": 2,
      "text": "加蒜末、辣椒粉、孜然和牛至炒香。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料炒出油色，味道才浓。，全程留意火候，别贪快。",
      "visual_cue": "香气冲鼻，油色深红"
    },
    {
      "n": 3,
      "text": "下牛肉末压散，炒到变色。，火大了就离锅远一点。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "压散开，颗粒才细。，火别开太大，稳着来。",
      "visual_cue": "肉末松散，颜色变深"
    },
    {
      "n": 4,
      "text": "加番茄块炒十分钟到软烂。，锅温要匀，别忽高忽低。",
      "time_min": 12,
      "heat": "中火",
      "tip": "番茄炒散，酱才浓稠。，火力保持中等，慢慢来。",
      "visual_cue": "番茄化开，汤汁渗出"
    },
    {
      "n": 5,
      "text": "加清水煮开，转小火炖二十五分钟。，火候宁小勿大，慢慢推进。",
      "time_min": 28,
      "heat": "小火",
      "tip": "小火慢炖，味道才融。，注意锅里温度别掉下来。",
      "visual_cue": "汤面微沸，香气浓，这步最关键。"
    },
    {
      "n": 6,
      "text": "放红腰豆再炖十分钟。，始终中小火，别心急。",
      "time_min": 12,
      "heat": "小火",
      "tip": "豆子后放，才不炖烂。，火要均匀，食材才不糊。",
      "visual_cue": "豆粒完整，汤汁稠，很多人在这里出错。"
    },
    {
      "n": 7,
      "text": "加盐和黑胡椒调味，尝一次咸淡。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "小火",
      "tip": "咸淡最后调，别放早。，全程留意火候，别贪快。",
      "visual_cue": "汤色深红，油光浮面"
    },
    {
      "n": 8,
      "text": "关火静置五分钟再盛碗。，火大了就离锅远一点。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置一下，味道更融合。，火别开太大，稳着来。",
      "visual_cue": "酱体浓稠，香气沉稳"
    }
  ],
  "tips": [
    "香料先用油炒香，底味才足。，这里最容易翻车。",
    "小火慢炖，肉末才不柴。，别小看这一步。",
    "豆子后放，才保持颗粒。，成败就在这一步。"
  ],
  "common_mistakes": [
    "火太大，锅底焦糊带苦味。，这点要注意。",
    "辣椒粉一次全下，辣得发苦。，这是关键点。",
    "豆子炖太久，化成泥。，别嫌麻烦，做完它。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "猪肉末",
      "ratio": "600 克:600 克",
      "note": "更油润，可少放油五毫升。"
    },
    {
      "original": "红腰豆",
      "substitute": "白豆",
      "ratio": "250 克:250 克",
      "note": "口感更粉，汤色变浅。"
    }
  ],
  "variations": [
    "加一块黑巧克力，味道更厚。，这一步别省。",
    "配米饭或玉米饼一起吃。，别跳过这步。"
  ],
  "serving_suggestion": "盛碗撒奶酪丝，配玉米饼蘸食。，这步最关键。",
  "storage": "冷藏三天，冷冻两个月。，很多人在这里出错。",
