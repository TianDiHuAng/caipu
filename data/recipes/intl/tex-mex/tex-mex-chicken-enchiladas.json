          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 120,
          "unit": "g",
          "note": "切丁",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "干辣椒",
          "name_en": "dried chili",
          "amount": 10,
