        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米剥成粒，番茄和青椒切成小丁，洋葱切成细末。",
      "time_min": 8,
      "heat": "无火",
      "tip": "番茄先去籽再切丁，沙拉才不会出水。",
      "visual_cue": "丁块大小均匀，碗底无积水"
    },
    {
      "n": 2,
      "text": "平底锅烧热不放油，把玉米粒倒进去中火干炒。",
      "time_min": 5,
      "heat": "中火",
      "tip": "干炒到玉米边缘微焦，甜味会明显提升。",
      "visual_cue": "玉米粒表面出现焦斑点"
    },
    {
      "n": 3,
      "text": "炒到玉米粒微微发焦就盛出，摊开晾凉备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "摊开晾凉，余温不会把蔬菜烫软。",
      "visual_cue": "玉米粒松散不粘连，摸上去不烫手"
    },
    {
      "n": 4,
      "text": "青柠挤出汁，和橄榄油、盐、辣椒粉一起调成汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁现挤现用，香气才够清新。",
      "visual_cue": "汁液乳化，颜色微绿"
    },
    {
      "n": 5,
      "text": "把所有蔬菜和晾凉的玉米粒一起倒进大碗里。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蔬菜沥干水分再拌，沙拉才清爽。",
      "visual_cue": "碗中材料干爽分明，没有积水"
    },
    {
      "n": 6,
      "text": "淋上调好的汁拌匀，撒上香菜碎即可端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌好后冷藏十分钟，味道融合得更好。",
      "visual_cue": "表面香菜翠绿，汁液均匀"
    }
  ],
  "tips": [
    "玉米干炒出焦斑，甜味和香气都会更足。",
    "番茄去籽再切，沙拉才不会渗一摊水。",
    "青柠汁要现挤现用，酸香气息最清新。"
  ],
  "common_mistakes": [
    "玉米直接水煮就拌，味道寡淡还出水。",
    "蔬菜带水下碗，拌好变成一汪汤。",
    "青柠汁提前挤好放着，香气全跑光。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "60 克:60 克",
      "note": "酸味更平和，可加半勺糖。"
    },
    {
      "original": "辣椒粉",
      "substitute": "孜然粉",
      "ratio": "2 克:2 克",
      "note": "辛辣变温和，香气更浓。"
    }
  ],
  "variations": [
    "加一勺酸奶油一起拌，口感会更浓郁。",
    "拌入黑豆和牛油果丁，做成更丰盛的主食沙拉。"
  ],
  "serving_suggestion": "当配菜配烤肉或卷饼吃，冰镇后风味更清爽。",
  "storage": "冷藏一天，食用前把渗出的汁水倒掉再拌。",
