  "equipment": [
    "汤锅",
    "木勺",
    "手持搅拌棒",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干黑豆洗净泡八小时至表皮起皱，倒掉泡豆的水冲洗一遍。",
      "time_min": 480,
      "heat": "无火",
      "tip": "泡豆水带涩味，倒掉汤才清。",
      "visual_cue": "豆粒膨大，捏开中心无硬芯"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，中火炒洋葱丁六分钟至透明发软。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒透，汤的甜味才有底。",
      "visual_cue": "洋葱透亮，锅底有薄薄一层油"
    },
    {
      "n": 3,
      "text": "下蒜末、孜然和辣椒粉炒四十秒至香味出来，注意别炒焦。",
      "time_min": 2,
      "heat": "中火",
      "tip": "香料遇油才出味，时间短才不苦。",
      "visual_cue": "锅里香气浓，蒜末未变色"
    },
    {
      "n": 4,
      "text": "加番茄丁炒五分钟至软烂出汁，再倒入泡好的黑豆和一千二百毫升水。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄炒出汁再加水，汤底更厚。",
      "visual_cue": "番茄塌软，汤色转深褐"
    },
    {
      "n": 5,
      "text": "大火煮开后转小火盖盖煮三十五分钟至豆子一压就碎。",
      "time_min": 37,
      "heat": "小火",
      "tip": "水保持微沸，豆皮才不会被冲散。",
      "visual_cue": "豆子软烂，汤体浓稠"
    },
    {
      "n": 6,
      "text": "舀出一半豆子用搅拌棒打成泥倒回锅里，加盐调味搅匀。",
      "time_min": 5,
      "heat": "小火",
      "tip": "留一半整豆，口感才有层次。",
      "visual_cue": "汤半稠半粒，颜色墨黑"
    },
    {
      "n": 7,
      "text": "关火挤入青柠汁，撒香菜碎，盛碗后可按口味加一勺酸奶油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠最后加，酸香才不散。",
      "visual_cue": "汤面泛油光，酸香扑鼻"
    }
  ],
  "tips": [
    "用高压锅压十五分钟，能省掉泡豆和长时间炖煮。",
    "想更浓可以多加一百克豆子，煮好后全部打泥。",
    "配一碗白米饭吃，是墨西哥家庭最常见的组合。"
  ],
  "common_mistakes": [
    "豆子没泡透就煮，煮一小时中心还是硬的。",
    "盐加得太早，豆皮收紧一直煮不软。",
    "全部打成泥，汤失去整豆的颗粒层次。"
  ],
  "substitutions": [
    {
      "original": "干黑豆",
      "substitute": "罐装黑豆",
      "ratio": "400克:两罐约480克",
      "note": "冲洗后直接下锅，煮的时间缩到十五分钟。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "30克:30克",
      "note": "酸味略柔，用量可多一点。"
    }
  ],
  "variations": [
    "加一勺烟熏辣椒酱，做成带烟熏味的版本。",
    "放几片培根同炒洋葱，油脂香更浓。"
  ],
  "serving_suggestion": "盛进深碗，顶上放一勺酸奶油、几粒切达奶酪丁和香菜，配玉米饼蘸着吃。",
  "storage": "冷藏四天，冷冻两个月；复热加少量水小火搅开，避免糊底。",
