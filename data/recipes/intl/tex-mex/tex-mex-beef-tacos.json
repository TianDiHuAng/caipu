  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "木勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "平底锅烧热倒植物油，下洋葱丁炒软。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味才出。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱软塌，边缘微黄"
    },
    {
      "n": 2,
      "text": "加蒜末、辣椒粉、孜然和牛至炒香。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料遇油才出味，别炒糊。，火候要稳，别忽大忽小。",
      "visual_cue": "香气冲鼻，油色发红"
    },
    {
      "n": 3,
      "text": "下牛肉末，用铲子压散开。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中大火",
      "tip": "压散一点，颗粒才均匀。，火候要稳，别忽大忽小。",
      "visual_cue": "肉末松散，颜色变深"
    },
    {
      "n": 4,
      "text": "炒到肉末全熟、水汽收干。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "中火",
      "tip": "水汽收干，馅才不湿饼。，火候要稳，别忽大忽小。",
      "visual_cue": "肉末干香，锅底无汁"
    },
    {
      "n": 5,
      "text": "加盐和黑胡椒调味，挤入青柠汁。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "青柠提味，也解油腻。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料油亮，酸香浮出"
    },
    {
      "n": 6,
      "text": "玉米饼放干锅上烘二十秒回软。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "饼烘一下，折起来才不裂。，火候要稳，别忽大忽小。",
      "visual_cue": "饼片发软，边缘微黄"
    },
    {
      "n": 7,
      "text": "饼上铺生菜丝，再放一勺肉馅。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "生菜垫底，饼才不湿。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料居中，菜丝翠绿"
    },
    {
      "n": 8,
      "text": "撒番茄丁、切达奶酪丝和香菜，对折趁热食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃，奶酪才会化。，火候要稳，别忽大忽小。",
      "visual_cue": "奶酪微软，香气扑鼻"
    }
  ],
  "tips": [
    "肉末炒干水汽，饼才不湿软。，这一点很关键。",
    "玉米饼先烘一下，折起来不裂。，这一点很关键。",
    "青柠汁最后挤，酸香才鲜。，这一点很关键。"
  ],
  "common_mistakes": [
    "肉末没炒干，饼一咬就漏汁。，这一点很关键。",
    "香料炒糊，馅发苦。，这一点很关键。",
    "饼没加热，一折就碎。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "猪肉末",
      "ratio": "600 克:600 克",
      "note": "脂肪更多，炒时少放油。"
    },
    {
      "original": "切达奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "80 克:80 克",
      "note": "拉丝更好，风味偏淡。"
    }
  ],
  "variations": [
    "加牛油果片，口感更绵。，这一点很关键。",
    "换成鱼肉馅，就是海鲜版。，这一点很关键。"
  ],
  "serving_suggestion": "配酸奶油和辣酱，挤青柠汁一起上桌。",
  "storage": "馅料冷藏两天，饼现烘现吃。，这一点很关键。",
