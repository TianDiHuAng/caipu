 "steps": [
  {
   "n": 1,
   "text": "章鱼洗净，整只放进冷水锅。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "大火",
   "tip": "整只下锅，触手别切，缩水少。，火候要稳，别忽大忽小。",
   "visual_cue": "章鱼卷曲，表面微紫"
  },
  {
   "n": 2,
   "text": "水开后转小火煮四十分钟，撇去浮沫。，火候要稳，别忽大忽小。",
   "time_min": 45,
   "heat": "小火",
   "tip": "煮到触手能插透筷子，别煮散。，火候要稳，别忽大忽小。",
   "visual_cue": "表皮变粉，触手柔软"
  },
  {
   "n": 3,
   "text": "土豆切块，另锅煮十五分钟到微软。，火候要稳，别忽大忽小。",
   "time_min": 18,
   "heat": "中火",
   "tip": "土豆别煮烂，保持块形。，火候要稳，别忽大忽小。",
   "visual_cue": "土豆微软，边缘完整"
  },
  {
   "n": 4,
   "text": "捞出章鱼放凉，切成适口小块。，火候要稳，别忽大忽小。",
   "time_min": 8,
   "heat": "无火",
   "tip": "凉透再切，切面才整齐。，火候要稳，别忽大忽小。",
   "visual_cue": "块形均匀，质地紧实"
  },
  {
   "n": 5,
   "text": "大碗放土豆、章鱼和洋葱丝。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "洋葱丝切薄，口感才不冲。，火候要稳，别忽大忽小。",
   "visual_cue": "材料分层，颜色分明"
  },
  {
   "n": 6,
   "text": "淋橄榄油和柠檬汁，撒盐、黑胡椒和牛至。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "先拌油再放盐，味道更匀。，火候要稳，别忽大忽小。",
   "visual_cue": "沙拉油亮，香气散开"
  },
  {
   "n": 7,
   "text": "拌匀后撒欧芹，冷藏十分钟上桌。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "冷藏一下更入味，别放太久。，火候要稳，别忽大忽小。",
   "visual_cue": "沙拉油亮，香草点缀"
  }
 ],
 "tips": [
  "章鱼整只冷水下锅，触手才不缩成一团。",
  "煮到筷子能插透就停，久了发硬。，这一点很关键。",
  "土豆煮到微软，拌时才不碎。，这一点很关键。"
 ],
 "common_mistakes": [
  "水开后才下章鱼，肉质发柴。，这一点很关键。",
  "土豆煮过头，一拌全成泥。，这一点很关键。",
  "柠檬放太多，酸味盖住海鲜味。，这一点很关键。"
 ],
