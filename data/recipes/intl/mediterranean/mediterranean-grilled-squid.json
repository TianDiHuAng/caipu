  "steps": [
    {
      "n": 1,
      "text": "鱿鱼去内脏和软骨，撕掉表皮。，翻动放轻，整道菜才立得住。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表皮撕干净，腥味才少。，留意锅底，成品才好看。",
      "visual_cue": "鱼身光滑，颜色发白，起锅前尝味，口感才不发柴。"
    },
    {
      "n": 2,
      "text": "鱿鱼身切条，触手整只保留。，汤汁别收太干，颜色才够亮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切条均匀，烤时才同步。，手法轻些，味道才进得去。",
      "visual_cue": "条宽一致，触手完整，料别一次下太多，食材才不糊。"
    },
    {
      "n": 3,
      "text": "碗里倒橄榄油，加蒜末和红椒粉。，慢慢来别急，锅气才足。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜末切细，香气才出。，手法轻些，食材才不糊。",
      "visual_cue": "油色泛红，蒜末浮面，料别一次下太多，口感才不发柴。"
    },
    {
      "n": 4,
      "text": "加柠檬汁、盐和黑胡椒，搅匀成腌料。，汤汁别收太干，形状才完整。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬先拌，酸味才均匀。，起锅前尝味，口感才有层次。",
      "visual_cue": "腌料乳化，颜色微黄，汤汁别收太干，香气才不跑。"
    },
    {
      "n": 5,
      "text": "鱿鱼拌入腌料，静置十五分钟。，锅温要匀，口感才不发柴。",
      "time_min": 17,
      "heat": "无火",
      "tip": "别腌太久，肉会发韧。，料别一次下太多，细节才到位。",
      "visual_cue": "表面裹匀，油光发亮，翻动放轻，咸淡才好把握。"
    },
    {
      "n": 6,
      "text": "烤盘烧到冒烟，鱿鱼平铺上去。，慢慢来别急，味道才进得去。",
      "time_min": 5,
      "heat": "大火",
      "tip": "锅要够热，鱿鱼才不吐水。，锅温要匀，形状才完整。",
      "visual_cue": "锅面冒烟，鱿鱼卷边，火别太大，食材才不糊。"
    },
    {
      "n": 7,
      "text": "每面烤两分钟，边缘微焦即翻。，注意别烧干，咸淡才好把握。",
      "time_min": 5,
      "heat": "大火",
      "tip": "时间要短，久了像橡皮。，手法轻些，咸淡才好把握。",
      "visual_cue": "表面焦痕，鱼身卷曲，留意锅底，口感才不发柴。"
    },
    {
      "n": 8,
      "text": "出锅撒欧芹，挤柠檬汁趁热吃。，时间掐准，口感才有层次。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃，凉了就发韧。，别用力搅，成品才好看。",
      "visual_cue": "香草鲜绿，香气扑鼻，保持中小火，口感才不发柴。"
    }
  ],
  "tips": [
    "锅要烧到冒烟，鱿鱼才香。，时间掐准，成品才好看。",
    "烤的时间要短，久了发韧。，慢慢来别急，口感才不发柴。",
    "腌料别太咸，鱿鱼本身带海水味。，手法轻些，锅气才足。"
  ],
  "common_mistakes": [
    "锅不够热，鱿鱼出一盘水。，起锅前尝味，整道菜才立得住。",
    "烤太久，口感像橡皮。，留意锅底，香气才不跑。",
    "腌太久，肉质发糊。，别用力搅，香气才不跑。"
  ],
