  "steps": [
    {
      "n": 1,
      "text": "西葫芦洗净，纵向剖开成两半。，翻动放轻，细节才到位。",
      "time_min": 8,
      "heat": "无火",
      "tip": "选粗细一致的，摆盘才好看。，翻动放轻，火候才均匀。",
      "visual_cue": "切面平整，长度一致，起锅前尝味，颜色才够亮。"
    },
    {
      "n": 2,
      "text": "用勺子挖出瓜瓤，留一厘米边。，盖盖焖一会儿，整道菜才立得住。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别挖穿底，馅会漏。，时间掐准，味道才进得去。",
      "visual_cue": "内壁平滑，底部完整，别用力搅，整道菜才立得住。"
    },
    {
      "n": 3,
      "text": "挖出的瓜瓤切碎，挤掉多余水分。，时间掐准，咸淡才好把握。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水分挤干，馅才不稀。，保持中小火，细节才到位。",
      "visual_cue": "瓜瓤松散，手感干爽，起锅前尝味，香气才不跑。"
    },
    {
      "n": 4,
      "text": "锅倒橄榄油，炒洋葱丁到透明。，时间掐准，香气才不跑。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒软，馅才甜。，保持中小火，颜色才够亮。",
      "visual_cue": "洋葱透明，香气散出，时间掐准，形状才完整。"
    },
    {
      "n": 5,
      "text": "加蒜末炒香，再下番茄丁炒出汁。，手法轻些，整道菜才立得住。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出汁，米才易熟。，别用力搅，食材才不糊。",
      "visual_cue": "汁水泛红，番茄软塌，注意别烧干，火候才均匀。"
    },
    {
      "n": 6,
      "text": "加大米翻炒两分钟，裹上油汁。，慢慢来别急，细节才到位。",
      "time_min": 3,
      "heat": "中火",
      "tip": "米先炒一下，口感才不夹生。，起锅前尝味，咸淡才好把握。",
      "visual_cue": "米粒油亮，颗颗分开，盖盖焖一会儿，口感才不发柴。"
    },
    {
      "n": 7,
      "text": "加瓜瓤、欧芹、薄荷、盐和黑胡椒拌匀。，翻动放轻，锅气才足。",
      "time_min": 4,
      "heat": "中火",
      "tip": "馅别太湿，否则烤时出水。，火别太大，味道才不闷。",
      "visual_cue": "馅料粘稠，香气清爽，盖盖焖一会儿，锅气才足。"
    },
    {
      "n": 8,
      "text": "把馅填进西葫芦，压平表面。，起锅前尝味，味道才进得去。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别塞太满，米会膨胀。，保持中小火，味道才进得去。",
      "visual_cue": "馅面平整，不留空隙，慢慢来别急，味道才不闷。"
    },
    {
      "n": 9,
      "text": "烤盘倒清水，摆入西葫芦，淋油。，别用力搅，口感才不发柴。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盘底加水，烤时才不干。，保持中小火，口感才有层次。",
      "visual_cue": "水位到盘底，油光浮面，汤汁别收太干，火候才均匀。"
    },
    {
      "n": 10,
      "text": "盖锡纸，二百度烤三十分钟。，时间掐准，整道菜才立得住。",
      "time_min": 32,
      "heat": "无火",
      "tip": "盖锡纸焖，米才熟透。，手法轻些，味道才不闷。",
      "visual_cue": "锡纸鼓起，香气外溢，慢慢来别急，成品才好看。"
    },
    {
      "n": 11,
      "text": "揭锡纸再烤十分钟上色。，别用力搅，锅气才足。，保持中小火，食材才不糊。",
      "time_min": 12,
      "heat": "无火",
      "tip": "最后上色，表面才微焦。，注意别烧干，锅气才足。",
      "visual_cue": "表面金黄，瓜皮起皱，翻动放轻，食材才不糊。"
    },
    {
      "n": 12,
      "text": "出炉挤柠檬汁，稍凉再盛盘。，汤汁别收太干，口感才不发柴。",
      "time_min": 5,
      "heat": "无火",
      "tip": "柠檬提味，酸香才清。，汤汁别收太干，味道才不闷。",
      "visual_cue": "汁水清亮，香气扑鼻，留意锅底，细节才到位。"
    }
  ],
  "tips": [
    "挖瓤别挖穿，馅才不会漏。，火别太大，口感才不发柴。",
    "米先炒过再填，口感才不夹生。，手法轻些，口感才不发柴。",
    "盘底加水，烤时才不干硬。，汤汁别收太干，成品才好看。"
  ],
  "common_mistakes": [
    "馅塞太满，米膨胀后溢出来。，翻动放轻，成品才好看。",
    "不盖锡纸，米烤不熟。，手法轻些，成品才好看。",
    "番茄太湿，馅变成糊。，料别一次下太多，整道菜才立得住。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "甜椒",
      "ratio": "800 克:800 克",
      "note": "甜椒更甜，烤制时间减五分钟。"
    },
    {
      "original": "大米",
      "substitute": "藜麦",
      "ratio": "120 克:120 克",
      "note": "需先煮半熟，水量减半。"
    }
  ],
  "variations": [
    "馅里加羊肉末，风味更足。，别用力搅，细节才到位。",
    "表面撒奶酪同烤，更拉丝。，慢慢来别急，香气才不跑。"
  ],
  "serving_suggestion": "温热时吃，配酸奶或面包。，时间掐准，口感才不发柴。",
  "storage": "冷藏三天，复热加少量水。，保持中小火，香气才不跑。",
