  "equipment": [
    "铸铁锅",
    "烤箱",
    "刀",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁用盐、白胡椒和一半柠檬汁抓匀，腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "柠檬汁能去腥，也让虾肉变得更紧实。",
      "visual_cue": "虾仁肉质微微收紧"
    },
    {
      "n": 2,
      "text": "铸铁锅放植物油中火，下洋葱和大蒜炒到透明出香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透，番茄的酸甜才不单薄。",
      "visual_cue": "洋葱透明，蒜香上浮"
    },
    {
      "n": 3,
      "text": "加番茄丁和辣椒粉炒八分钟，炒到番茄化成浓汁。",
      "time_min": 9,
      "heat": "中火",
      "tip": "番茄要炒到成酱，汤汁才够浓稠。",
      "visual_cue": "番茄化开，锅底浓汁"
    },
    {
      "n": 4,
      "text": "把虾仁铺在番茄汁上，中火煮三分钟到虾仁变红。",
      "time_min": 4,
      "heat": "中火",
      "tip": "虾仁只煮三分钟，煮久了肉质会发韧。",
      "visual_cue": "虾仁卷曲，颜色转红"
    },
    {
      "n": 5,
      "text": "撒上掰碎的芝士块，连锅放进两百二十度烤箱烤六分钟。",
      "time_min": 7,
      "heat": "大火",
      "tip": "芝士烤到边缘焦黄就取，别等全化开。",
      "visual_cue": "芝士软化，边缘微焦"
    },
    {
      "n": 6,
      "text": "出炉撒香菜碎，挤上剩下的柠檬汁即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出炉之后再挤柠檬，酸香才不容易散。",
      "visual_cue": "表面芝士冒泡，香气扑鼻"
    }
  ],
  "tips": [
    "虾仁先腌一会儿，肉质会更紧实去腥。",
    "番茄要炒到化成浓汁，不要加水。",
    "芝士烤到边缘微焦的时候就可以出炉。"
  ],
  "common_mistakes": [
    "虾仁煮得太久，肉变韧像在嚼橡皮。",
    "汤汁太多没炒浓，铺上芝士后流得满锅。",
    "芝士烤过头全部融化消失，只剩焦皮。"
  ],
  "substitutions": [
    {
      "original": "芝士",
      "substitute": "马苏里拉奶酪",
      "ratio": "150 克:150 克",
      "note": "拉丝更好，咸味偏淡需补盐。"
    },
    {
      "original": "虾仁",
      "substitute": "鱿鱼圈",
      "ratio": "600 克:600 克",
      "note": "煮的时间需延长两分钟。"
    }
  ],
  "variations": [
    "加一小杯白葡萄酒同炒，酸度更明亮。",
    "换成半干番茄，酸甜风味会更集中。"
  ],
  "serving_suggestion": "热锅直接上桌，配一块硬皮面包蘸汤汁，是希腊海边小馆的经典吃法。",
  "storage": "冷藏两天，复热用烤箱一百八十度八分钟；不建议微波，虾肉会变硬。",
