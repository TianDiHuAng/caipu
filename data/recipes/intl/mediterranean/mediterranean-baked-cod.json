  "steps": [
    {
      "n": 1,
      "text": "鳕鱼排擦干水分，两面抹盐和黑胡椒。，汤汁别收太干，整道菜才立得住。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼排擦干，烤后才不腥。，起锅前尝味，食材才不糊。",
      "visual_cue": "表面干爽，鱼肉紧实，料别一次下太多，形状才完整。"
    },
    {
      "n": 2,
      "text": "烤盘倒一半橄榄油，铺上洋葱丝。，锅温要匀，火候才均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "底层铺洋葱，鱼才不粘。，留意锅底，味道才进得去。",
      "visual_cue": "洋葱铺平，油迹均匀，留意锅底，味道才不闷。"
    },
    {
      "n": 3,
      "text": "烤盘里倒一半橄榄油，铺上洋葱丝和大蒜片。，锅温要匀，食材才不糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "番茄垫底，汁水才不流失。，料别一次下太多，香气才不跑。",
      "visual_cue": "番茄铺匀，颜色鲜红，盖盖焖一会儿，细节才到位。"
    },
    {
      "n": 4,
      "text": "鱼排放在番茄上，刷一层橄榄油。，保持中小火，咸淡才好把握。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷油锁水，鱼肉才嫩。，别用力搅，口感才有层次。",
      "visual_cue": "表面油亮，鱼皮完整，留意锅底，形状才完整。"
    },
    {
      "n": 5,
      "text": "撒红椒粉，铺柠檬片和橄榄。，汤汁别收太干，细节才到位。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬片增香，别压太重。，料别一次下太多，味道才不闷。",
      "visual_cue": "装饰整齐，颜色丰富，盖盖焖一会儿，咸淡才好把握。"
    },
    {
      "n": 6,
      "text": "烤箱预热二百度，中层烤十五分钟。，锅温要匀，味道才进得去。",
      "time_min": 17,
      "heat": "无火",
      "tip": "高温快烤，鱼肉才不柴。，翻动放轻，味道才不闷。",
      "visual_cue": "表面微焦，鱼香外溢，留意锅底，火候才均匀。"
    },
    {
      "n": 7,
      "text": "取出淋剩余橄榄油，撒剩余欧芹。，保持中小火，整道菜才立得住。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出炉淋油，香气才活。，留意锅底，食材才不糊。",
      "visual_cue": "油光浮动，香草鲜绿，料别一次下太多，火候才均匀。"
    },
    {
      "n": 8,
      "text": "静置三分钟再盛盘，浇上盘底汤汁。，汤汁别收太干，咸淡才好把握。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置让鱼肉回吸汁水。，火别太大，颜色才够亮。",
      "visual_cue": "鱼肉分层，汁水清亮，锅温要匀，锅气才足。"
    }
  ],
  "tips": [
    "鱼排厚薄一致，烤制时间才好掌握。，注意别烧干，香气才不跑。",
    "番茄垫底能保住鱼肉的汁水。，注意别烧干，成品才好看。",
    "烤后静置几分钟，鱼肉更嫩。，留意锅底，口感才有层次。"
  ],
  "common_mistakes": [
    "烤太久，鱼肉发干。，别用力搅，形状才完整。",
    "鱼没擦干，盘底积水。，锅温要匀，咸淡才好把握。",
    "盐放太早，鱼肉出水变柴。，慢慢来别急，食材才不糊。"
  ],
