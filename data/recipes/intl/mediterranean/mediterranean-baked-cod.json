  "variations": [
    "加一点白葡萄酒，香气更足。，保持中小火，味道才不闷。",
    "撒面包屑同烤，表面更脆。，注意别烧干，细节才到位。"
  ],
  "serving_suggestion": "配烤土豆或面包，连汤汁一起吃。，起锅前尝味，味道才不闷。",
  "storage": "冷藏一天，复热用烤箱低温。，锅温要匀，成品才好看。",
