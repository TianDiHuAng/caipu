  "equipment": [
    "沙拉碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄切滚刀大块，黄瓜切一厘米厚片，一起放进沙拉碗。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切大块才吃得到蔬菜的水分和脆感。",
      "visual_cue": "块形饱满，切面湿润"
    },
    {
      "n": 2,
      "text": "洋葱切薄圈，用冰水泡五分钟去辛辣味后沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡过冰水的洋葱只剩清甜，不再冲鼻。",
      "visual_cue": "洋葱圈透明，辛辣味变淡"
    },
    {
      "n": 3,
      "text": "把洋葱圈、橄榄一起放进碗里，撒粗盐与黑胡椒轻轻翻匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐要粗粒，咬到颗颗咸味才地道。",
      "visual_cue": "蔬菜表面均匀挂盐"
    },
    {
      "n": 4,
      "text": "淋橄榄油与柠檬汁，用两把勺子从底部翻拌，不要用力搅。",
      "time_min": 2,
      "heat": "无火",
      "tip": "翻拌而非搅拌，防止番茄出水变糊。",
      "visual_cue": "每块蔬菜裹上油光"
    },
    {
      "n": 5,
      "text": "把整块奶酪放在沙拉中央，撒上撕碎的罗勒叶。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪整块上桌，吃时自己压碎才够传统。",
      "visual_cue": "奶酪方方正正，白绿相间"
    },
    {
      "n": 6,
      "text": "静置五分钟让盐和柠檬汁渗入，再淋一勺橄榄油上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置让味道融合，但别超过十分钟会出水。",
      "visual_cue": "盘底略有汁水，香气清爽"
    }
  ],
  "tips": [
    "橄榄油用初榨的，风味差别很明显。",
    "番茄选熟透的，汁水甜才是这道沙拉的灵魂。",
    "不加生菜，正宗做法只有番茄黄瓜洋葱。"
  ],
  "common_mistakes": [
    "把所有材料大力搅拌，番茄出水变成一汪汤。",
    "用细盐提前腌，蔬菜瞬间塌软失去脆感。",
    "黄瓜切太薄，翻拌后就软塌塌没口感。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "马苏里拉",
      "ratio": "150 克:150 克",
      "note": "咸味更淡，需略加盐。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "30 克:20 毫升",
      "note": "酸味更直接，少一点果香。"
    }
  ],
  "variations": [
    "加一把腌酸豆同拌，咸酸层次更突出。",
    "撒一小撮干牛至，是希腊本土的做法。"
  ],
  "serving_suggestion": "作为主菜配面包蘸汁，或作为烤肉的前菜。",
  "storage": "现拌现吃，冷藏不超过十二小时，复吃前倒掉积水重新调味。",
