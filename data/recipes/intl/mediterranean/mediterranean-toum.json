          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "料理机",
    "量杯",
    "密封罐",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大蒜剥皮去芯，把发绿的芽也挑掉，只留白色蒜瓣。",
      "time_min": 10,
      "heat": "无火",
      "tip": "蒜芯带苦味，一定要挑干净再打。",
      "visual_cue": "蒜瓣洁白，没有绿芽"
    },
    {
      "n": 2,
      "text": "蒜瓣放进料理机，加一半的盐，先干打成细碎的蒜末。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先把蒜干打成末，再淋油打出来更细。",
      "visual_cue": "蒜末细匀，黏成一团"
    },
    {
      "n": 3,
      "text": "柠檬挤出汁，和清水一起量好放在旁边备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "清水能防止蒜酱在打的过程中发热分油。",
      "visual_cue": "柠檬汁清亮，没有籽"
    },
    {
      "n": 4,
      "text": "料理机开低速，一边打一边分二十次淋入一小勺植物油。",
      "time_min": 8,
      "heat": "无火",
      "tip": "油一定要一点点淋，倒快了会立刻分离。",
      "visual_cue": "酱体渐渐变白变稠"
    },
    {
      "n": 5,
      "text": "打到一半时加一勺柠檬汁和少量清水，继续打匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "加酸能让蒜酱更稳定，颜色也更白。",
      "visual_cue": "酱体乳白，质地蓬松"
    },
    {
      "n": 6,
      "text": "淋完剩余的油再打一分钟，最后加清水调稠并尝味。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后尝一次咸淡，蒜酱偏咸一点更耐吃。",
      "visual_cue": "酱体挺立，挂勺不掉"
    }
  ],
  "tips": [
    "油必须一小勺一小勺地淋，倒快了酱会立刻分离。",
    "蒜芯发绿要挑掉，否则整罐酱都带苦味。",
    "加冰水与柠檬汁能让蒜酱更稳定也更白。"
  ],
  "common_mistakes": [
    "油一次倒入，蒜酱当场分油变成两层。",
    "蒜瓣没去皮就下机，成品带皮渣口感粗糙。",
    "盐放太少，蒜酱寡淡且不易保存。"
  ],
  "substitutions": [
    {
      "original": "植物油",
      "substitute": "橄榄油",
      "ratio": "170 毫升:170 毫升",
      "note": "香气更重，颜色偏绿。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "1 个:20 毫升",
      "note": "酸味更冲，需减少用量。"
    }
  ],
  "variations": [
    "加一小勺土豆泥一起打，酱体更稳定。",
    "蒜换成烤过的蒜，辛味更柔和香甜。"
  ],
  "serving_suggestion": "抹在烤鸡、烤肉或三明治里，也可以拌沙拉，是黎巴嫩烤肉桌上的标配白酱。",
  "storage": "密封冷藏两周，每次用干勺取，出现分油或酸败味即弃用。",
