      "group": "main",
      "items": [
        {
          "name": "茄子",
          "name_en": "eggplant",
          "amount": 700,
          "unit": "g",
          "note": "选长茄子",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "芝麻酱",
          "name_en": "sesame paste",
          "amount": 60,
          "unit": "g",
          "note": "纯芝麻酱",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 12,
          "unit": "g",
          "note": "压成泥",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 45,
          "unit": "g",
          "note": "挤汁",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 30,
          "unit": "ml",
          "note": "分次加入",
          "optional": false
        },
        {
          "name": "孜然",
          "name_en": "cumin",
          "amount": 2,
          "unit": "g",
          "note": "提香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 10,
          "unit": "g",
          "note": "点缀",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "叉子",
    "料理碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净擦干，用叉子在表皮扎十几个小孔防止爆裂。",
      "time_min": 4,
      "heat": "无火",
      "tip": "扎孔排气，烤的时候才不会炸开。",
      "visual_cue": "表皮布满细密小孔"
    },
    {
      "n": 2,
      "text": "烤箱预热两百度，茄子放烤盘上烤三十分钟至表皮塌陷。",
      "time_min": 30,
      "heat": "中火",
      "tip": "烤到皮皱肉软，才有烟熏般的香气。",
      "visual_cue": "表皮深褐起皱，按压软塌"
    },
    {
      "n": 3,
      "text": "取出茄子放凉五分钟，从中间剖开，用勺子刮出茄肉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "只取茄肉，皮和籽别混进去。",
      "visual_cue": "茄肉呈丝状，皮完整剥开"
    },
    {
      "n": 4,
      "text": "茄肉放滤网里静置五分钟，压掉多余的水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水不滤掉，泥会稀得挂不住勺。",
      "visual_cue": "滤网下积出一层浅黄汁水"
    },
    {
      "n": 5,
      "text": "用叉子把茄肉压成带纤维的粗泥，别打成糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "保留纤维口感更好，太细像婴儿辅食。",
      "visual_cue": "泥体粗糙有丝，能挂住叉子"
    },
    {
      "n": 6,
      "text": "芝麻酱加柠檬汁与蒜泥搅开，分次加橄榄油搅到顺滑。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬汁先加，芝麻酱才不容易结块。",
      "visual_cue": "酱体顺滑发亮，能缓缓流下"
    },
    {
      "n": 7,
      "text": "把粗泥拌入酱里，加孜然与盐搅匀后尝味再补盐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "咸淡按口味微调，柠檬别一次挤完。",
      "visual_cue": "泥体稠厚，颜色米褐"
    },
    {
      "n": 8,
      "text": "盛盘后用勺背抹出纹路，淋橄榄油撒香菜即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "淋油前抹纹路，油才会顺着沟槽流。",
      "visual_cue": "表面油亮，纹路清晰"
    }
  ],
  "tips": [
    "茄子一定要烤到皮皱肉塌，香气才够。",
    "茄肉水分要滤干，成品才不会稀得挂不住勺。",
    "柠檬汁分两次加，酸度更好控制。"
  ],
  "common_mistakes": [
    "茄子没扎孔就进烤箱，表皮爆开流汁。",
    "茄肉没有滤水，拌出来稀得像一碗汤。",
    "用料理机打成细糊，完全没有口感。"
  ],
  "substitutions": [
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "60 克:60 克",
      "note": "风味偏甜，柠檬汁需多加十克。"
    },
    {
      "original": "茄子",
      "substitute": "南瓜",
      "ratio": "700 克:700 克",
      "note": "需先蒸熟再压泥，甜味更重。"
    }
  ],
  "variations": [
    "拌入一勺酸奶，口感更清爽顺滑。",
    "表面撒一点辣椒粉，微辣更开胃解腻。"
  ],
  "serving_suggestion": "配烤面饼或蔬菜条蘸食，也可抹在面包上。",
  "storage": "冷藏两天，表面淋一层橄榄油可防氧化变黑。",
