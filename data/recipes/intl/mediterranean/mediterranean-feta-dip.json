  ],
  "steps": [
    {
      "n": 1,
      "text": "羊乳酪捏碎，放碗里回温十分钟。，别用力搅，味道才不闷。",
      "time_min": 12,
      "heat": "无火",
      "tip": "回温后更易打滑。，汤汁别收太干，食材才不糊。",
      "visual_cue": "奶酪松散，手感变软，火别太大，形状才完整。"
    },
    {
      "n": 2,
      "text": "加酸奶，用打蛋器搅成顺滑糊。，注意别烧干，口感才有层次。",
      "time_min": 5,
      "heat": "无火",
      "tip": "慢慢搅，才不打成颗粒。，留意锅底，颜色才够亮。",
      "visual_cue": "糊体顺滑，无颗粒，注意别烧干，味道才进得去。"
    },
    {
      "n": 3,
      "text": "加柠檬汁和蒜末，继续搅匀。，注意别烧干，味道才不闷。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬分次加，酸度才好控。，注意别烧干，口感才不发柴。",
      "visual_cue": "酸香明显，质地浓稠，保持中小火，形状才完整。"
    },
    {
      "n": 4,
      "text": "加黑胡椒调味，尝一次咸淡。，盖盖焖一会儿，食材才不糊。",
      "time_min": 2,
      "heat": "无火",
      "tip": "羊乳酪本身咸，盐可省。，料别一次下太多，咸淡才好把握。",
      "visual_cue": "咸淡合适，奶香浓郁，别用力搅，咸淡才好把握。"
    },
    {
      "n": 5,
      "text": "核桃干锅小火烤香，切碎。，保持中小火，锅气才足。",
      "time_min": 5,
      "heat": "小火",
      "tip": "核桃一变色就关火。，盖盖焖一会儿，香气才不跑。",
      "visual_cue": "颜色微黄，香气散出，盖盖焖一会儿，火候才均匀。"
    },
    {
      "n": 6,
      "text": "把奶酪糊抹在盘底，划出纹路。，翻动放轻，味道才进得去。",
      "time_min": 3,
      "heat": "无火",
      "tip": "划纹路，油才挂得住。，别用力搅，味道才进得去。",
      "visual_cue": "表面有纹，边缘平整，盖盖焖一会儿，成品才好看。"
    },
    {
      "n": 7,
      "text": "淋橄榄油，撒红椒粉和核桃碎。，慢慢来别急，形状才完整。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油最后淋，颜色才亮。，起锅前尝味，锅气才足。",
      "visual_cue": "油光浮动，颜色丰富，翻动放轻，形状才完整。"
    },
    {
      "n": 8,
      "text": "撒欧芹碎，配蔬菜条上桌。，注意别烧干，颜色才够亮。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香草最后撒，颜色才绿。，汤汁别收太干，口感才有层次。",
      "visual_cue": "配色清爽，香气扑鼻，注意别烧干，形状才完整。"
    }
  ],
  "tips": [
    "奶酪回温后再打，质地才顺。，保持中小火，火候才均匀。",
    "柠檬汁分次加，酸度才好控。，盖盖焖一会儿，颜色才够亮。",
    "核桃烤香再撒，口感才脆。，料别一次下太多，口感才有层次。"
  ],
  "common_mistakes": [
    "奶酪太冷，打成渣。，时间掐准，颜色才够亮。",
    "酸奶加太多，变成汤。，锅温要匀，颜色才够亮。",
    "盐加多了，咸得发苦。，起锅前尝味，形状才完整。"
  ],
  "substitutions": [
    {
      "original": "羊乳酪",
      "substitute": "菲达奶酪",
      "ratio": "300 克:300 克",
      "note": "风味更淡，可加柠檬汁少许。"
    },
    {
      "original": "核桃",
      "substitute": "松子",
      "ratio": "40 克:40 克",
      "note": "香气更细，烤制时间减一分钟。"
    }
  ],
  "variations": [
    "加一点蜂蜜，甜咸更平衡。，料别一次下太多，颜色才够亮。",
    "加烤甜椒泥，颜色更红。，锅温要匀，细节才到位。"
  ],
  "serving_suggestion": "配烤面包片或黄瓜条、胡萝卜条。，慢慢来别急，整道菜才立得住。",
  "storage": "冷藏两天，食用前回温。，保持中小火，成品才好看。",
