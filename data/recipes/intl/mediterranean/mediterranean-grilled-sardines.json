  ],
  "steps": [
    {
      "n": 1,
      "text": "沙丁鱼去内脏刮鳞，冲洗后擦干。，全程留意火候，别贪快。",
      "time_min": 10,
      "heat": "无火",
      "tip": "擦干鱼身，烤时才不粘架。，火大了就离锅远一点。",
      "visual_cue": "鱼身干爽，鳞片去净"
    },
    {
      "n": 2,
      "text": "鱼身两面抹盐和黑胡椒，静置五分钟。，火别开太大，稳着来。",
      "time_min": 7,
      "heat": "无火",
      "tip": "薄薄一层就够，鱼本身够咸。，锅温要匀，别忽高忽低。",
      "visual_cue": "鱼皮微亮，调味均匀"
    },
    {
      "n": 3,
      "text": "橄榄油、蒜末、红椒粉和柠檬汁调成刷料。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷料拌匀，蒜末别太大。，火候宁小勿大，慢慢推进。",
      "visual_cue": "刷料浓稠，颜色橙红"
    },
    {
      "n": 4,
      "text": "烤架烧热，刷一层油防粘。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "大火",
      "tip": "烤架一定要够热，鱼皮才不破。，始终中小火，别心急。",
      "visual_cue": "架子冒烟，油膜发亮"
    },
    {
      "n": 5,
      "text": "鱼放上架，每面烤四分钟。，火要均匀，食材才不糊。",
      "time_min": 9,
      "heat": "大火",
      "tip": "一面定型再翻，鱼皮才完整。，看住火，别让它失控。",
      "visual_cue": "鱼皮焦纹，肉色发白"
    },
    {
      "n": 6,
      "text": "刷上调料，再烤一分钟收香。，全程留意火候，别贪快。",
      "time_min": 2,
      "heat": "中火",
      "tip": "刷料最后刷，蒜才不烧焦。，火大了就离锅远一点。",
      "visual_cue": "表面油亮，香气浓郁"
    },
    {
      "n": 7,
      "text": "离火挤柠檬，撒欧芹装盘。，火别开太大，稳着来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "欧芹最后撒，颜色才绿。，锅温要匀，别忽高忽低。",
      "visual_cue": "鱼身完整，柠檬点缀"
    }
  ],
  "tips": [
    "鱼身擦干，烤时才不粘架。，这里最容易翻车。",
    "烤架够热，鱼皮才不破。，别小看这一步。",
    "刷料最后刷，蒜末才不焦。，成败就在这一步。"
  ],
  "common_mistakes": [
    "鱼没擦干，烤出来一滩水。，这点要注意。",
    "烤架不够热，鱼皮全粘在架上。，这是关键点。",
    "翻得太勤，鱼肉散开。，别嫌麻烦，做完它。"
  ],
  "substitutions": [
    {
      "original": "沙丁鱼",
      "substitute": "鱿鱼",
      "ratio": "800 克:700 克",
      "note": "切圈烤三分钟，口感更脆。"
    },
    {
      "original": "红椒粉",
      "substitute": "牛至",
      "ratio": "4 克:3 克",
      "note": "香气偏草本，少了甜味。"
    }
  ],
  "variations": [
    "腌料里加一勺白葡萄酒，去腥更彻底。",
    "烤好后淋一点白醋，酸香更开胃。，这一步别省。"
  ],
  "serving_suggestion": "配番茄洋葱沙拉和烤饼，趁热吃。，别跳过这步。",
  "storage": "冷藏一天，凉食也可，不建议复热。",
