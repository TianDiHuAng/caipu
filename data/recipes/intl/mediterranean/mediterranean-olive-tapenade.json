  "equipment": [
    "搅拌机",
    "碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑橄榄去核，冲洗后沥干。，火别太大，味道才进得去。",
      "time_min": 8,
      "heat": "无火",
      "tip": "橄榄本身咸，冲洗能减咸。，别用力搅，火候才均匀。",
      "visual_cue": "果肉完整，水沥净，时间掐准，味道才不闷。"
    },
    {
      "n": 2,
      "text": "核桃干锅小火烤香，放凉。，慢慢来别急，火候才均匀。",
      "time_min": 5,
      "heat": "小火",
      "tip": "核桃一变色就离火。，时间掐准，火候才均匀。",
      "visual_cue": "颜色微黄，香气散出，料别一次下太多，成品才好看。"
    },
    {
      "n": 3,
      "text": "橄榄、核桃和蒜末放入搅拌机。，注意别烧干，整道菜才立得住。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先放硬的，才打得匀。，火别太大，成品才好看。",
      "visual_cue": "料集中，机器好转，留意锅里的变化，口感才不塌。"
    },
    {
      "n": 4,
      "text": "加橄榄油，点动搅打成粗粒。，接触别太猛，味道才有层次。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别打太细，留颗粒才有口感。，手上的力道放匀，味道才有层次。",
      "visual_cue": "颗粒分明，油润不干，手上的力道放匀，细节才经得起看。"
    },
    {
      "n": 5,
      "text": "加柠檬汁和黑胡椒，再打两下。，接触别太猛，风味才不寡淡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬后加，酸香才清。，手上的力道放匀，成品才像样。",
      "visual_cue": "质地发亮，酸香明显，量按手感微调，香气才立得住。"
    },
    {
      "n": 6,
      "text": "尝味后再决定是否加盐。，趁热处理更快，味道才有层次。",
      "time_min": 2,
      "heat": "无火",
      "tip": "橄榄已咸，盐要少放。，别一次加完，细节才经得起看。",
      "visual_cue": "咸淡合适，果香突出，手上的力道放匀，香气才立得住。"
    },
    {
      "n": 7,
      "text": "装入碗中，表面淋一层橄榄油。，手上的力道放匀，卖相才讨喜。",
      "time_min": 3,
      "heat": "无火",
      "tip": "封油保存，颜色才不变。，量按手感微调，细节才经得起看。",
      "visual_cue": "表面油封，颜色乌亮，别一次加完，卖相才讨喜。"
    },
    {
      "n": 8,
      "text": "撒欧芹碎，配烤饼食用。，先试一点再决定，味道才有层次。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香草最后撒，颜色才绿。，趁热处理更快，卖相才讨喜。",
      "visual_cue": "配色清亮，香气浓，先试一点再决定，风味才不寡淡。"
    }
  ],
  "tips": [
    "橄榄先冲洗，咸度才好控。，先试一点再决定，细节才经得起看。",
    "打粗一点，口感才有层次。，留意锅里的变化，味道才有层次。",
    "表面封油，颜色才不变黑。，看着颜色就够，香气才立得住。"
  ],
  "common_mistakes": [
    "打太细，变成糊。，先试一点再决定，口感才不塌。",
    "加盐太多，咸得发苦。，先试一点再决定，颜色才不发暗。",
    "不封油，放两天就发暗。，量按手感微调，成品才像样。"
  ],
  "substitutions": [
    {
      "original": "橄榄",
      "substitute": "绿橄榄",
      "ratio": "300 克:300 克",
      "note": "风味更酸，盐可省。"
    },
    {
      "original": "核桃",
      "substitute": "杏仁",
      "ratio": "30 克:30 克",
      "note": "口感更硬，需打久一点。"
    }
  ],
  "variations": [
    "加一点橙皮屑，香气更清。，先试一点再决定，成品才像样。",
    "加番茄干，风味更浓。，留意锅里的变化，颜色才不发暗。"
  ],
  "serving_suggestion": "配烤饼、饼干或蔬菜条。，趁热处理更快，风味才不寡淡。",
  "storage": "冷藏一周，表面保持油封。，别一次加完，成品才像样。",
