  "steps": [
    {
      "n": 1,
      "text": "面包撕成小块，摊开晾十分钟。，盖盖焖一会儿，味道才进得去。",
      "time_min": 12,
      "heat": "无火",
      "tip": "撕比切好，边缘才挂汁。，慢慢来别急，咸淡才好把握。",
      "visual_cue": "块形粗糙，表面干爽，盖盖焖一会儿，味道才不闷。"
    },
    {
      "n": 2,
      "text": "平底锅少油，面包块烤到微脆。，翻动放轻，口感才不发柴。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "烤脆一点，拌了才不烂。，火别太大，口感才有层次。",
      "visual_cue": "边缘金黄，手感发脆，时间掐准，细节才到位。"
    },
    {
      "n": 3,
      "text": "番茄切块，撒盐静置五分钟出汁。，锅温要匀，整道菜才立得住。",
      "time_min": 7,
      "heat": "无火",
      "tip": "番茄出汁，正好当酱汁。，手法轻些，火候才均匀。",
      "visual_cue": "汁水积在碗底，果肉发亮"
    },
    {
      "n": 4,
      "text": "黄瓜切片，洋葱切薄片泡冷水。，手法轻些，口感才有层次。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱泡水，辣味才淡。，盖盖焖一会儿，形状才完整。",
      "visual_cue": "洋葱透明，辛辣减弱，留意锅底，咸淡才好把握。"
    },
    {
      "n": 5,
      "text": "碗里调橄榄油、红酒醋和蒜末。，翻动放轻，香气才不跑。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调汁，味道才匀。，汤汁别收太干，味道才进得去。",
      "visual_cue": "汁体乳化，颜色微黄，翻动放轻，颜色才够亮。"
    },
    {
      "n": 6,
      "text": "把番茄连汁倒入调味汁中拌匀。，起锅前尝味，细节才到位。",
      "time_min": 3,
      "heat": "无火",
      "tip": "番茄汁别倒掉，那是精华。，别用力搅，颜色才够亮。",
      "visual_cue": "汁水红亮，香气酸鲜，注意别烧干，食材才不糊。"
    },
    {
      "n": 7,
      "text": "加面包块、黄瓜和洋葱，轻轻翻拌。，火别太大，香气才不跑。",
      "time_min": 4,
      "heat": "无火",
      "tip": "别用力压，面包才不糊。，汤汁别收太干，锅气才足。",
      "visual_cue": "面包吸汁，颜色变红，慢慢来别急，颜色才够亮。"
    },
    {
      "n": 8,
      "text": "撒罗勒、盐和黑胡椒，静置五分钟。，锅温要匀，味道才不闷。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置入味，口感才融合。，料别一次下太多，味道才进得去。",
      "visual_cue": "香草鲜绿，汁水挂匀，火别太大，整道菜才立得住。"
    }
  ],
  "tips": [
    "用隔夜硬面包，吸汁才不烂。，留意锅底，锅气才足。",
    "番茄撒盐出汁，就是天然酱汁。，起锅前尝味，成品才好看。",
    "拌好静置几分钟再吃，更入味。，料别一次下太多，锅气才足。"
  ],
  "common_mistakes": [
    "面包太软，拌完成一团。，手法轻些，香气才不跑。",
    "汁调太酸，盖住番茄味。，手法轻些，细节才到位。",
    "拌太久，面包散成渣。，锅温要匀，口感才有层次。"
  ],
  "substitutions": [
    {
      "original": "面包",
      "substitute": "烤饼",
      "ratio": "300 克:300 克",
      "note": "更薄脆，烤制时间减两分钟。"
    },
    {
      "original": "红酒醋",
      "substitute": "柠檬汁",
      "ratio": "20 毫升:25 毫升",
      "note": "酸味更清，糖可加少许。"
    }
  ],
  "variations": [
    "加橄榄和马苏里拉，做成饱腹版。，时间掐准，锅气才足。",
    "加烤甜椒，甜味更足。，火别太大，火候才均匀。"
  ],
  "serving_suggestion": "作为一餐的前菜，或配烤肉同吃。，起锅前尝味，火候才均匀。",
  "storage": "现拌现吃，冷藏不超过一天。，手法轻些，颜色才够亮。",
