 "steps": [
  {
   "n": 1,
   "text": "西葫芦和土豆切成半厘米厚片。，火候要稳，别忽大忽小。",
   "time_min": 8,
   "heat": "无火",
   "tip": "厚度一致，烤的时候才一起熟。，火候要稳，别忽大忽小。",
   "visual_cue": "片形整齐，厚薄均匀"
  },
  {
   "n": 2,
   "text": "番茄切片，洋葱切丝，大蒜切片。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "无火",
   "tip": "蔬菜分开放，摆盘才好排。，火候要稳，别忽大忽小。",
   "visual_cue": "切片完整，汁水不外流"
  },
  {
   "n": 3,
   "text": "烤盘底淋清水，铺一层洋葱丝。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "垫洋葱防粘，还能增甜。，火候要稳，别忽大忽小。",
   "visual_cue": "洋葱铺平，盘底湿润"
  },
  {
   "n": 4,
   "text": "西葫芦、土豆和番茄交替叠排成排。，火候要稳，别忽大忽小。",
   "time_min": 10,
   "heat": "无火",
   "tip": "斜着排紧一点，好看也不易干。，火候要稳，别忽大忽小。",
   "visual_cue": "排列整齐，层次分明"
  },
  {
   "n": 5,
   "text": "撒盐、黑胡椒、牛至和蒜片。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "盐撒匀，别堆在一处。，火候要稳，别忽大忽小。",
   "visual_cue": "调味均匀，蒜片分布开"
  },
  {
   "n": 6,
   "text": "淋橄榄油，盖锡纸烤二十五分钟。，火候要稳，别忽大忽小。",
   "time_min": 27,
   "heat": "无火",
   "tip": "盖锡纸先焖软，后面才不焦。，火候要稳，别忽大忽小。",
   "visual_cue": "蔬菜变软，盘中有汤"
  },
  {
   "n": 7,
   "text": "揭锡纸再烤二十五分钟收汁上色。，火候要稳，别忽大忽小。",
   "time_min": 27,
   "heat": "无火",
   "tip": "揭纸后别翻动，保持排面完整。，火候要稳，别忽大忽小。",
   "visual_cue": "表面焦边，汤汁收浓"
  },
  {
   "n": 8,
   "text": "出炉撒欧芹，静置五分钟再上桌。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "无火",
   "tip": "静置让汤汁回吸，味道更融。，火候要稳，别忽大忽小。",
   "visual_cue": "油亮焦边，香气浓郁"
  }
 ],
 "tips": [
  "蔬菜切一样厚，熟度才一致。，这一点很关键。",
  "先盖锡纸焖软，再揭纸收汁。，这一点很关键。",
  "橄榄油别省，蔬菜吸油才香。，这一点很关键。"
 ],
 "common_mistakes": [
  "切得太薄，烤完全干。，这一点很关键。",
  "不盖锡纸，表面焦了里面还是硬的。",
  "盐撒在番茄上太早，出水太多。，这一点很关键。"
 ],
