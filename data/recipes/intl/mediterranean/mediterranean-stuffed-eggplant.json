  "equipment": [
    "烤箱",
    "平底锅",
    "刀",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子对半剖开，用勺子把中间茄肉挖出来切成小丁，茄壳留一厘米厚。",
      "time_min": 10,
      "heat": "无火",
      "tip": "茄壳别挖太薄，烤完会软塌撑不住馅。",
      "visual_cue": "茄壳完整，边缘厚薄一致"
    },
    {
      "n": 2,
      "text": "茄壳里外刷一层橄榄油，摆进烤盘，二百度烤十五分钟到半软。",
      "time_min": 16,
      "heat": "中火",
      "tip": "先烤半熟再填馅，茄子才不会出水冲淡味道。",
      "visual_cue": "茄壳变软，表面微微塌陷"
    },
    {
      "n": 3,
      "text": "平底锅留橄榄油中火炒洋葱丁五分钟到透明，下大蒜末炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱要炒到透明发甜，急火只会发焦。",
      "visual_cue": "洋葱透明，蒜香散出"
    },
    {
      "n": 4,
      "text": "下牛里脊粒炒到变色，加肉桂、盐和黑胡椒翻匀。",
      "time_min": 6,
      "heat": "中火",
      "tip": "牛里脊粒炒到刚变色就停，久炒会发柴。",
      "visual_cue": "肉丁表面焦褐，无血色"
    },
    {
      "n": 5,
      "text": "倒入番茄丁和茄肉丁，中小火煮十分钟收到浓稠无汤水。",
      "time_min": 11,
      "heat": "中火",
      "tip": "馅一定要收干，湿馅会把茄子泡烂。",
      "visual_cue": "馅料抱团，锅底无积水"
    },
    {
      "n": 6,
      "text": "把馅填进茄壳压紧，表面再淋少许橄榄油，二百度烤二十分钟。",
      "time_min": 21,
      "heat": "中火",
      "tip": "填馅要压实，中间留空烤完会塌。",
      "visual_cue": "表面焦香，馅料微微冒油"
    },
    {
      "n": 7,
      "text": "出炉后撒上香菜碎，静置五分钟让香气回稳再上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "晾几分钟味道更融合，也免得烫嘴。",
      "visual_cue": "香菜翠绿，茄壳带焦边"
    }
  ],
  "tips": [
    "茄子先烤半熟再填馅，能避免出水把馅泡散。",
    "馅料要收到干身抱团，湿了会把茄壳泡烂。",
    "肉桂只放一点点，多放会盖住茄子的清甜。"
  ],
  "common_mistakes": [
    "茄子没预烤，填馅后烤出一盘水。",
    "茄壳挖得太薄，烤完塌成一张皮。",
    "番茄没收汁，馅料湿软摊在盘里。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "羊肉",
      "ratio": "250 克:250 克",
      "note": "更贴近中东原味，需多炒两分钟。"
    },
    {
      "original": "牛里脊",
      "substitute": "鹰嘴豆",
      "ratio": "250 克:200 克",
      "note": "做成素食版，需压碎一半增稠。"
    }
  ],
  "variations": [
    "表面撒一层奶酪碎同烤，拉丝更香。",
    "加一勺番茄膏，颜色更红味道更浓。"
  ],
  "serving_suggestion": "每盘放一只酿茄子，配烤面包和希腊沙拉，淋上盘底的橄榄油汁一起吃。",
  "storage": "冷藏三天，复热盖锡纸一百八十度烤十五分钟，避免表面烤干。",
