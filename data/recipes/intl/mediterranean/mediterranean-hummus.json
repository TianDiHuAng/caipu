  "equipment": [
    "料理机",
    "汤锅",
    "细筛",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆用清水泡一整夜，水面高出豆子三个指节。",
      "time_min": 720,
      "heat": "无火",
      "tip": "泡够时间豆皮才软，打出来才细。",
      "visual_cue": "豆粒胀大，表皮起皱"
    },
    {
      "n": 2,
      "text": "换清水煮四十分钟，至用手指一捏就碎，中途撇掉浮沫。",
      "time_min": 41,
      "heat": "中火",
      "tip": "煮到用手一捏就散，别省时间。",
      "visual_cue": "豆子软烂，汤色乳白"
    },
    {
      "n": 3,
      "text": "捞出后去掉浮起的豆皮，沥干水分，放凉到温热。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆皮去掉一部分，成品才够顺滑。",
      "visual_cue": "豆粒洁净，无杂皮"
    },
    {
      "n": 4,
      "text": "料理机里先放芝麻酱、柠檬汁、大蒜、孜然与盐，打三十秒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先打液体与酱，再加豆，糊体才顺。",
      "visual_cue": "混合物浓稠，颜色浅褐"
    },
    {
      "n": 5,
      "text": "加入鹰嘴豆与一半清水，高速打两分钟中途停机刮壁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冰水让糊体膨松发白，别用热水。",
      "visual_cue": "糊体细腻发白，无颗粒"
    },
    {
      "n": 6,
      "text": "分次淋入橄榄油，每次打二十秒至完全吸收。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油慢慢加才不会分离。",
      "visual_cue": "表面油亮，质地顺滑"
    },
    {
      "n": 7,
      "text": "尝味补盐与柠檬汁，装盘时用勺背划出旋涡淋油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "咸酸要够，冷藏后味道会变淡。",
      "visual_cue": "盘面旋涡清晰，浮一层橄榄油"
    }
  ],
  "tips": [
    "干豆泡足一夜，比罐头豆香气更足。",
    "冰水是让糊体发白蓬松的关键，别用温水替换。",
    "想更细可以过一遍细筛，口感接近餐厅版本。"
  ],
  "common_mistakes": [
    "豆子没煮透就打，成品带颗粒和生豆味。",
    "一次性倒完橄榄油，糊体油水分离。",
    "冷藏后才调味，味道偏淡又难拌开。"
  ],
  "substitutions": [
    {
      "original": "干鹰嘴豆",
      "substitute": "罐装鹰嘴豆",
      "ratio": "250 克:400 克",
      "note": "省去泡发，煮制时间缩短到十分钟。"
    },
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "120 克:120 克",
      "note": "风味偏甜，适合初次尝试。"
    }
  ],
  "variations": [
    "加烤红椒打成红色版本，甜味更突出。",
    "表面撒烤松子与辣椒粉，做成黎凡特风格。"
  ],
  "serving_suggestion": "淋橄榄油撒辣椒粉，配皮塔饼、黄瓜条和番茄块蘸食。",
  "storage": "密封冷藏四天、冷冻一个月；表面淋一层油隔绝空气可延长一天。",
