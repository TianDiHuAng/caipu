 "variations": [
  "加一个番茄，酱更柔和。，这一点很关键。",
  "加一点姜黄，颜色更亮。，这一点很关键。"
 ],
 "serving_suggestion": "配烤肉、饼和鹰嘴豆泥，一小勺就够。",
 "storage": "冷藏两周，表面封油可延长到一个月。",
