 "equipment": [
  "刀",
  "砧板",
  "料理机",
  "碗",
  "刮刀"
 ],
 "steps": [
  {
   "n": 1,
   "text": "小米辣去蒂，香菜切段，大蒜去皮。，火候要稳，别忽大忽小。",
   "time_min": 8,
   "heat": "无火",
   "tip": "辣椒籽留着，辣度才够。，火候要稳，别忽大忽小。",
   "visual_cue": "材料备齐，辣椒完整"
  },
  {
   "n": 2,
   "text": "孜然放干锅小火炒三十秒出香。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "小火",
   "tip": "孜然一冒香就离火，别炒黑。，火候要稳，别忽大忽小。",
   "visual_cue": "香气扑鼻，颗粒微亮"
  },
  {
   "n": 3,
   "text": "全部材料放进料理机，先低速打碎。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "先低速再高速，颗粒才均匀。，火候要稳，别忽大忽小。",
   "visual_cue": "碎粒均匀，颜色深绿"
  },
  {
   "n": 4,
   "text": "分次淋橄榄油，打成粗酱状。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "油慢慢加，酱才不会油水分离。，火候要稳，别忽大忽小。",
   "visual_cue": "酱体浓稠，油光发亮"
  },
  {
   "n": 5,
   "text": "加柠檬汁和盐，再打五秒。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "柠檬最后放，酸味更明亮。，火候要稳，别忽大忽小。",
   "visual_cue": "颜色翠绿，酸香明显"
  },
  {
   "n": 6,
   "text": "装瓶压实，表面淋油封口。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "表面封油，能多放几天。，火候要稳，别忽大忽小。",
   "visual_cue": "表面油层，酱体紧实"
  }
 ],
 "tips": [
  "先低速后高速，酱体才细腻。，这一点很关键。",
  "油分次加，才不油水分离。，这一点很关键。",
  "表面封一层油，保存更久。，这一点很关键。"
 ],
 "common_mistakes": [
  "孜然炒糊，整罐发苦。，这一点很关键。",
  "油一次倒完，酱打不匀。，这一点很关键。",
  "辣椒去籽去太干净，完全没辣味。，这一点很关键。"
 ],
