  ],
  "steps": [
    {
      "n": 1,
      "text": "温水化开酵母和白糖，静置十分钟起泡。，火候要稳，别忽大忽小。",
      "time_min": 11,
      "heat": "无火",
      "tip": "水温别超过四十度，会烫死酵母。，火候要稳，别忽大忽小。",
      "visual_cue": "表面浮沫，酵母活跃"
    },
    {
      "n": 2,
      "text": "加面粉和盐，搅成很黏的软面团。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面团比包子面还软，别加粉。，火候要稳，别忽大忽小。",
      "visual_cue": "面团黏手，能拉丝，这一点很关键。"
    },
    {
      "n": 3,
      "text": "盖保鲜膜发酵一小时，到体积两倍。，火候要稳，别忽大忽小。",
      "time_min": 84,
      "heat": "无火",
      "tip": "室温低就延长时间，看状态别看表。，火候要稳，别忽大忽小。",
      "visual_cue": "面团膨胀，表面气泡"
    },
    {
      "n": 4,
      "text": "锅里倒橄榄油烧到一百七十度。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中火",
      "tip": "没温度计就丢一小团面试。，火候要稳，别忽大忽小。",
      "visual_cue": "面糊冒泡，油面微动"
    },
    {
      "n": 5,
      "text": "面团装袋挤成小球下锅，每批八个。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "挤小一点，里面才容易熟。，火候要稳，别忽大忽小。",
      "visual_cue": "小球浮起，形状圆润"
    },
    {
      "n": 6,
      "text": "炸三分钟到金黄，中途翻动。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温太高会外焦里生。，火候要稳，别忽大忽小。",
      "visual_cue": "表面金黄，浮在油面"
    },
    {
      "n": 7,
      "text": "捞出沥干橄榄油，趁热淋蜂蜜。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热淋蜜，才挂得住。，火候要稳，别忽大忽小。",
      "visual_cue": "表面油亮，蜜汁挂壁"
    },
    {
      "n": 8,
      "text": "撒桂皮粉和核桃碎，热吃。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "桂皮别多，一点就够香。，火候要稳，别忽大忽小。",
      "visual_cue": "颜色金黄，坚果点缀"
    }
  ],
  "tips": [
    "面团要软，稠了炸出来发硬。，这一点很关键。",
    "油温一百七十度，太高外焦里生。，这一点很关键。",
    "趁热淋蜂蜜，才挂得住。，这一点很关键。"
  ],
  "common_mistakes": [
    "面团太硬，炸出来像石头。，这一点很关键。",
    "油温太低，吸油一嘴腻。，这一点很关键。",
    "蜂蜜淋太早，全流到盘底。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "120 克:100 克",
      "note": "需熬成糖浆再淋，否则不挂。"
    },
    {
      "original": "核桃",
      "substitute": "芝麻",
      "ratio": "40 克:30 克",
      "note": "香气更轻，口感更细。"
    }
  ],
  "variations": [
    "面团里加一点桂皮粉，香气更足。，这一点很关键。",
    "淋巧克力酱，孩子更喜欢。，这一点很关键。"
  ],
  "serving_suggestion": "趁热吃，配一杯浓咖啡解甜。，这一点很关键。",
  "storage": "现炸现吃，凉了复烤三分钟。，这一点很关键。",
