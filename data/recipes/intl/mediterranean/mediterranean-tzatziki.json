          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "挤汁",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 10,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "刨丝器",
    "纱布",
    "大碗",
    "蒜臼"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜削皮后用刨丝器刨成细丝，粗细尽量一致。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刨得细一点，入口才顺滑不塞牙。",
      "visual_cue": "黄瓜丝细白，堆成一小盆"
    },
    {
      "n": 2,
      "text": "黄瓜丝撒一小撮盐抓匀，静置十分钟让它出水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先腌出水分，酱才不会稀得流汤。",
      "visual_cue": "黄瓜丝软塌，盆底积了绿水"
    },
    {
      "n": 3,
      "text": "把黄瓜丝包进纱布里用力挤干，挤得越干越好。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水分挤得够干，酱体才浓稠挂勺。",
      "visual_cue": "挤出的黄瓜丝干爽成团"
    },
    {
      "n": 4,
      "text": "酸奶倒进大碗里，用勺子反复搅到顺滑无颗粒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先把酸奶搅顺再加料，成品才细腻。",
      "visual_cue": "酸奶顺滑，勺背挂薄层"
    },
    {
      "n": 5,
      "text": "大蒜先用刀背压成细泥，再加进酸奶里彻底拌匀。",
      "time_min": 1,
      "heat": "无火",
      "tip": "蒜泥压得够细，辣味才均匀不冲。",
      "visual_cue": "蒜泥化开，酸奶泛蒜香"
    },
    {
      "n": 6,
      "text": "加入挤干的黄瓜丝，再淋上橄榄油与柠檬汁。",
      "time_min": 1,
      "heat": "无火",
      "tip": "柠檬汁分两次加进去，酸度更好掌握。",
      "visual_cue": "酱体泛青白，油光微亮"
    },
    {
      "n": 7,
      "text": "加盐调味后拌匀，先尝一口再决定是否补酸。",
      "time_min": 1,
      "heat": "无火",
      "tip": "咸淡留到最后调，早加盐容易过头。",
      "visual_cue": "咸酸平衡，酱体稠厚"
    },
    {
      "n": 8,
      "text": "撒上切碎的欧芹，冷藏二十分钟之后再上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冷藏过后风味更融合，吃起来也更清凉。",
      "visual_cue": "表面点点翠绿，凉气十足"
    }
  ],
  "tips": [
    "黄瓜先腌再挤水，酱体才浓稠不稀。",
    "用浓稠的原味酸奶，稀酸奶做出来像汤。",
    "冷藏二十分钟再吃，蒜香和酸味才融合。"
  ],
  "common_mistakes": [
    "黄瓜不挤水直接拌，半小时后就成了汤。",
    "用甜味酸奶代替原味，成品又甜又怪。",
    "蒜泥不压细，吃到一口蒜块辣得呛人。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "酸奶油",
      "ratio": "400 克:400 克",
      "note": "更浓稠醇厚，酸度略低。"
    },
    {
      "original": "欧芹",
      "substitute": "薄荷",
      "ratio": "10 克:10 克",
      "note": "清香更突出，也别有风味。"
    }
  ],
  "variations": [
    "加一小勺柠檬皮屑，香气更明亮。",
    "拌入几粒切碎的橄榄，咸香更足。"
  ],
  "serving_suggestion": "盛小碗淋一圈橄榄油，配皮塔饼、烤肉串或烤蔬菜一起吃。",
  "storage": "冷藏两天，食用前把析出的水倒掉再拌一次。",
