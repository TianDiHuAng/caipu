  "steps": [
    {
      "n": 1,
      "text": "菠菜洗净切段，沸水焯一分钟后挤干水。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水一定要挤干，馅才不会稀。，火候要稳，别忽大忽小。",
      "visual_cue": "菠菜成团，挤不出水"
    },
    {
      "n": 2,
      "text": "洋葱切碎，黄油小火炒到透明。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒软，甜味才出来。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱透明，锅底微黄"
    },
    {
      "n": 3,
      "text": "菠菜切碎，和洋葱、奶油奶酪、鸡蛋拌成馅。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "奶酪先回温，拌起来才顺。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料浓稠，颜色均匀"
    },
    {
      "n": 4,
      "text": "加莳萝、盐和黑胡椒调味。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "尝一下再补盐，奶酪本身有咸味。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料顺滑，香草分布均匀"
    },
    {
      "n": 5,
      "text": "春卷皮摊开，取一勺馅放在一角。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "皮别放太久，容易风干变脆。，火候要稳，别忽大忽小。",
      "visual_cue": "皮面柔软，馅量适中"
    },
    {
      "n": 6,
      "text": "两侧折进，卷成长条，接口蘸水粘紧。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "接口刷水，烤时才不张开。，火候要稳，别忽大忽小。",
      "visual_cue": "卷形整齐，接口封紧"
    },
    {
      "n": 7,
      "text": "表面刷融化黄油，排在铺纸烤盘上。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄薄刷一层，烤出来才金黄。，火候要稳，别忽大忽小。",
      "visual_cue": "表面油亮，排列不重叠"
    },
    {
      "n": 8,
      "text": "烤箱一百九十度烤二十分钟到金黄起酥。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "无火",
      "tip": "烤到边缘深金就出炉，别等发黑。，火候要稳，别忽大忽小。",
      "visual_cue": "卷皮起泡，颜色金黄"
    }
  ],
  "tips": [
    "菠菜水一定挤干，否则皮会烂。，这一点很关键。",
    "奶酪回温后再拌，馅才顺滑。，这一点很关键。",
    "接口刷水粘紧，烤时不张口。，这一点很关键。"
  ],
  "common_mistakes": [
    "菠菜没挤水，烤完底下全是汤。，这一点很关键。",
    "馅太咸，因为奶酪本身有盐。，这一点很关键。",
    "皮风干变脆，一卷就裂。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "春卷皮",
      "substitute": "面粉",
      "ratio": "10 张:250 克",
      "note": "需自己和面擀薄，工艺更费时。"
    },
    {
      "original": "奶油奶酪",
      "substitute": "酸奶油",
      "ratio": "200 克:250 克",
      "note": "馅更稀，菠菜要多挤一次水。"
    }
  ],
  "variations": [
    "馅里加一点小米辣碎，微辣更开胃。",
    "表面撒芝麻，香气更浓。，这一点很关键。"
  ],
  "serving_suggestion": "温热上桌，配一小碟酸奶蘸食。，这一点很关键。",
  "storage": "冷藏两天，复烤五分钟恢复酥脆。，这一点很关键。",
