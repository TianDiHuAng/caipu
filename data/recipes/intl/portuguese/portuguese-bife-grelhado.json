      ]
    }
  ],
  "equipment": [
    "平底锅",
    "刀背",
    "小锅",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊切成一厘米厚的大片，用刀背轻拍几下让厚度均匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拍松能让肉受热均匀，口感也更加嫩。",
      "visual_cue": "肉片厚薄一致，表面平整"
    },
    {
      "n": 2,
      "text": "肉片两面抹盐和白胡椒，静置十五分钟回温。",
      "time_min": 16,
      "heat": "无火",
      "tip": "提前回温，下锅才不会外焦里生。",
      "visual_cue": "肉片表面微微出水"
    },
    {
      "n": 3,
      "text": "土豆切厚片，水开后下锅煮六分钟，捞出沥干。",
      "time_min": 10,
      "heat": "大火",
      "tip": "土豆先煮再煎，外皮脆里面绵软。",
      "visual_cue": "土豆片半透明，边缘软"
    },
    {
      "n": 4,
      "text": "平底锅放橄榄油烧到冒薄烟，下肉片每面煎一分半。",
      "time_min": 5,
      "heat": "大火",
      "tip": "锅一定要够热，肉汁才会锁在里面不流失。",
      "visual_cue": "表面深褐，边缘微焦"
    },
    {
      "n": 5,
      "text": "肉片盛出静置五分钟，原锅下土豆片煎到两面金黄。",
      "time_min": 9,
      "heat": "中火",
      "tip": "静置能让肉汁回吸，切开才不会流血水。",
      "visual_cue": "土豆两面金黄，边角微焦"
    },
    {
      "n": 6,
      "text": "锅里下黄油和大蒜碎小火炒香，倒白葡萄酒煮到酒气散尽。",
      "time_min": 5,
      "heat": "小火",
      "tip": "白葡萄酒要煮到酒气挥发，酸味才柔和。",
      "visual_cue": "酱汁浓稠，蒜香明显"
    },
    {
      "n": 7,
      "text": "加柠檬汁、盐和欧芹碎搅匀，浇在牛排和土豆上即可。",
      "time_min": 3,
      "heat": "小火",
      "tip": "柠檬汁关火后再加，清香带酸却不会发苦。",
      "visual_cue": "酱汁挂在肉面上，油亮"
    }
  ],
  "tips": [
    "牛排提前回温再煎，中心熟度才均匀。",
    "煎好静置五分钟再切，肉汁不会流失。",
    "黄油要小火炒蒜，火大会立刻发苦。"
  ],
  "common_mistakes": [
    "肉片从冰箱直接下锅，外面焦了里面还是凉的。",
    "全程大火猛煎，肉汁全部逼出来变干。",
    "蒜末用大火去爆，几秒钟就会焦黑发苦。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛腩",
      "ratio": "450 克:480 克",
      "note": "需延长煎制时间两分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "清水加柠檬汁",
      "ratio": "60 毫升:50 毫升加 10 毫升",
      "note": "无酒版本，酸味更直接。"
    }
  ],
  "variations": [
    "牛排上放一片火腿再盖芝士烤融，接近葡式 francesinha 的做法。",
    "土豆换成烤红薯块，甜味跟牛肉更搭。"
  ],
  "serving_suggestion": "配一份生菜沙拉和一杯红酒，是里斯本小酒馆里最经典的午市套餐。",
  "storage": "冷藏两天，复热用平底锅小火两面各煎四十秒，别用微波以免肉变硬。",
