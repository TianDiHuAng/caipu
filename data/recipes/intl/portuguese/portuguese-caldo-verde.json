  "steps": [
    {
      "n": 1,
      "text": "汤锅下橄榄油炒洋葱丁与蒜末五分钟至透明，加月桂叶炒出香味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱只要炒到透明，不需上色，汤才清甜。",
      "visual_cue": "洋葱软塌透明，锅底无焦痕"
    },
    {
      "n": 2,
      "text": "下土豆块翻炒两分钟，倒入高汤煮开后转小火炖十八分钟至土豆散开。",
      "time_min": 20,
      "heat": "小火",
      "tip": "土豆要炖到一压就碎，打成泥后汤才够浓稠。",
      "visual_cue": "土豆边缘化开，筷子一插就散"
    },
    {
      "n": 3,
      "text": "取出月桂叶，用料理棒把汤打成细腻的浓汤，加盐和黑胡椒调味。",
      "time_min": 4,
      "heat": "微火",
      "tip": "打得越细越顺滑，传统做法要求完全无颗粒。",
      "visual_cue": "汤体浓稠乳白，无任何块状"
    },
    {
      "n": 4,
      "text": "腊肠片用干锅小火煎出红油，连油一起倒回汤里煮三分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "腊肠的红油是这道汤的灵魂，别用其他油替代。",
      "visual_cue": "汤面浮起橙红色油圈"
    },
    {
      "n": 5,
      "text": "把芥蓝细丝撒入汤中，小火煮三分钟，淋一勺生橄榄油即可关火。",
      "time_min": 4,
      "heat": "小火",
      "tip": "芥蓝只需烫熟，煮久了发黄失去脆感。",
      "visual_cue": "菜丝翠绿浮在汤面，汤色绿白相间"
    }
  ],
  "tips": [
    "芥蓝切得越细越好，传统要求切成发丝粗细。",
    "汤要现做现喝，放久后菜丝会变黄。",
    "最后淋的生橄榄油务必用初榨，香气差别很大。"
  ],
  "common_mistakes": [
    "土豆没炖透就打泥，汤里有颗粒感。",
    "芥蓝久煮，颜色发暗、口感发苦。",
    "腊肠省掉不煎，汤少了那股烟熏红油的香。"
  ],
  "substitutions": [
    {
      "original": "芥蓝",
      "substitute": "菠菜",
      "ratio": "300 克:300 克",
      "note": "菠菜更软，下锅一分钟即可。"
    },
    {
      "original": "腊肠",
      "substitute": "培根",
      "ratio": "150 克:150 克",
      "note": "烟熏味足，煎出的油略多需撇去一部分。"
    }
  ],
  "variations": [
    "加入白豆打成泥同煮，可做更浓稠饱腹的版本。"
  ],
  "serving_suggestion": "盛碗淋橄榄油，配玉米面包或硬面包。",
  "storage": "冷藏两天；复热时加少量水调稀，菜丝重新烫绿再上桌。",
