  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 250,
          "unit": "g",
          "note": "中筋面粉做挞皮",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 150,
          "unit": "g",
          "note": "室温软化",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 3,
          "unit": "piece",
          "note": "两个蛋黄一个全蛋",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 200,
          "unit": "ml",
          "note": "全脂牛奶",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "熬糖水用",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 20,
          "unit": "g",
          "note": "让蛋奶液挺立",
          "optional": false
        },
        {
          "name": "香草荚",
          "name_en": "vanilla pod",
          "amount": 1,
          "unit": "piece",
          "note": "剖开取籽",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 1,
          "unit": "piece",
          "note": "熬糖水增香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "挞模",
    "擀面杖",
    "打蛋器",
    "细筛",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和一百二十毫升水揉成光滑面团，盖上湿布静置二十分钟松弛面筋。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团别揉过头，起筋太多烤完挞皮会回缩变形。",
      "visual_cue": "面团光滑不粘手，按压回弹缓慢"
    },
    {
      "n": 2,
      "text": "面团擀成长方薄片，抹一层软化的黄油对折三折，重复三次后冷藏一小时。",
      "time_min": 15,
      "heat": "无火",
      "tip": "黄油必须软化到能抹开但不能化油，太硬会撑破面皮。",
      "visual_cue": "面片层次分明，透光可见黄油夹层"
    },
    {
      "n": 3,
      "text": "牛奶加香草荚籽、白糖和桂皮小火加热到糖化，关火晾到温热备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "糖水不要煮滚起大泡，温度过高会让蛋液冲成蛋花。",
      "visual_cue": "糖水清澈微稠，表面浮有香草籽黑点"
    },
    {
      "n": 4,
      "text": "鸡蛋打散，倒入玉米淀粉搅匀，再缓缓冲入温糖水过筛两遍去掉浮沫。",
      "time_min": 10,
      "heat": "无火",
      "tip": "蛋奶液必须过筛，浮沫残留会让挞面烤出蜂窝气孔。",
      "visual_cue": "蛋液顺滑无颗粒，表面没有气泡"
    },
    {
      "n": 5,
      "text": "面卷切段压进挞模捏成薄底，倒入七分满蛋奶液，二百二十度烤约二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "倒液只到七分满，膨胀后不会溢出来糊在模壁上。",
      "visual_cue": "挞面鼓起焦斑，中心轻晃有布丁感"
    }
  ],
  "tips": [
    "反复折叠三次形成多层酥皮，烤后才有层层剥落的脆壳。",
    "蛋奶液过筛两遍以上，成品的挞面才会平整如镜。",
    "上火温度要够高，表面才会出现标志性的焦黑斑点。"
  ],
  "common_mistakes": [
    "蛋奶液没晾凉就冲入蛋液，高温直接把鸡蛋烫成蛋花。",
    "挞皮捏得厚薄不匀，薄处焦黑厚处夹生。",
    "倒液超过八分满，烘烤膨胀后溢出糊在模具上。"
  ],
  "substitutions": [
    {
      "original": "香草荚",
      "substitute": "香草精",
      "ratio": "1 根:2 毫升",
      "note": "香草精直接调入蛋液，不用再加热。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "1:1",
      "note": "口感更浓厚，糖量可减十克。"
    }
  ],
  "variations": [
    "在蛋奶液中撒少量柠檬皮屑，可做出带柑橘清香的变体。"
  ],
  "serving_suggestion": "出炉微温时吃最好，撒一层肉桂粉风味更接近里斯本街头做法。",
  "storage": "密封冷藏两天，复热用一百八十度烤五分钟恢复酥皮。",
