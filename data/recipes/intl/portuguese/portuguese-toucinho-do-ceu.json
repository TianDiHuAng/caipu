  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "蛋黄",
          "name_en": "egg-yolk",
          "amount": 120,
          "unit": "g",
          "note": "约八个，室温",
          "optional": false
        },
        {
          "name": "杏仁粉",
          "name_en": "almond-flour",
          "amount": 200,
          "unit": "g",
          "note": "细磨后过筛",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "flour",
          "amount": 50,
          "unit": "g",
          "note": "低筋",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 50,
          "unit": "g",
          "note": "融化后刷模",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 200,
          "unit": "g",
          "note": "分次用",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "取黄色表皮屑",
          "optional": false
        },
        {
          "name": "肉桂粉",
          "name_en": "ground-cinnamon",
          "amount": 2,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "水",
          "name_en": "water",
          "amount": 100,
          "unit": "ml",
          "note": "煮糖浆",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小锅",
    "打蛋盆",
    "细孔筛",
    "方形烤模",
    "烘焙纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白糖加清水放小锅，小火煮到糖化开、糖浆挂勺，不要搅动锅里的糖。",
      "time_min": 8,
      "heat": "小火",
      "tip": "糖浆煮到一百一十度左右，稠度刚好。",
      "visual_cue": "糖浆透明微黄，滴落成细线"
    },
    {
      "n": 2,
      "text": "糖浆离火稍放凉到不烫手，慢慢倒进杏仁粉里搅匀成糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糖浆太烫会把杏仁粉烫出油。",
      "visual_cue": "糊体细腻，能缓慢流下"
    },
    {
      "n": 3,
      "text": "蛋黄打散后分三次拌入面糊，每加一次都搅到完全吸收。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋黄别打起泡，拌进气泡会开裂。",
      "visual_cue": "颜色转深黄，质地像浓稠的卡仕达"
    },
    {
      "n": 4,
      "text": "筛入面粉和肉桂粉，加柠檬皮屑，用刮刀从底部翻拌到看不见干粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌到看不见干粉就停，过度会起筋。",
      "visual_cue": "面糊挂刮刀，落下呈缎带状"
    },
    {
      "n": 5,
      "text": "烤模铺烘焙纸，内壁刷融化黄油，倒入面糊抹平，轻震两下排气。",
      "time_min": 3,
      "heat": "无火",
      "tip": "震出气泡，切面才细腻。",
      "visual_cue": "表面平整，边缘无气泡"
    },
    {
      "n": 6,
      "text": "烤箱预热一百七十度，烤三十五分钟至表面金黄、竹签插入带少量湿润屑。",
      "time_min": 35,
      "heat": "中火",
      "tip": "模具放中层，上色过深要盖锡纸。",
      "visual_cue": "表面金黄微裂，中心略晃"
    },
    {
      "n": 7,
      "text": "取出放凉十五分钟再脱模，切块撒少量糖粉，配咖啡食用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "完全放凉再切，边缘才齐整。",
      "visual_cue": "切面湿润绵密，颜色深金"
    }
  ],
  "tips": [
    "蛋黄回温后再拌，冷蛋黄会让面糊结块。",
    "杏仁粉提前过筛一次，成品的口感会更细腻。",
    "煮糖浆时千万别搅动，搅了容易返砂结成块。"
  ],
  "common_mistakes": [
    "糖浆煮得太稀，面糊出水不成型。",
    "蛋黄打发过度，烤后表面塌陷开裂。",
    "烤箱时间给多了，成品发干，失去绵密的口感。"
  ],
  "substitutions": [
    {
      "original": "杏仁粉",
      "substitute": "杏仁",
      "ratio": "150克:150克",
      "note": "用料理机打成细粉并过筛两遍。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "30克:30克",
      "note": "香气更尖，用量减至二十克。"
    }
  ],
  "variations": [
    "加一勺橙皮屑同拌，果香会更明亮，也不压杏仁味。",
    "模具换小纸杯，做成一口大小的版本。"
  ],
  "serving_suggestion": "切成小方块，配一杯浓缩咖啡或甜酒，是葡萄牙人过节时的收尾甜点。",
  "storage": "密封常温可放三天，冷藏五天；吃前回温十分钟风味更好。",
