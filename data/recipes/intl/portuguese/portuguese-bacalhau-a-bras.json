  "equipment": [
    "平底炒锅",
    "刀",
    "砧板",
    "木铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成火柴棍粗细的细丝，泡在冷水里洗去表面多余的粉质后彻底沥干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切好立刻泡水，薯丝才不会氧化发黑，也能炒得更松散。",
      "visual_cue": "水变浑白，薯丝根根硬挺"
    },
    {
      "n": 2,
      "text": "鳕鱼块用厨房纸吸干表面水分，两面薄薄抹盐与黑胡椒腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐只要一半量，鳕鱼本身带底味，别一次下重。",
      "visual_cue": "鱼块表面微微出水，手感紧实"
    },
    {
      "n": 3,
      "text": "平底锅下五十毫升橄榄油中火，把鳕鱼块两面煎到金黄，用叉子拨成粗片盛出。",
      "time_min": 10,
      "heat": "中火",
      "tip": "鱼肉煎到七成熟就起锅，后面回锅再熟一轮才不会柴。",
      "visual_cue": "鱼皮边缘金黄，鱼肉呈蒜瓣状"
    },
    {
      "n": 4,
      "text": "原锅补入剩余橄榄油，下洋葱丝与大蒜末小火炒到软塌出香。",
      "time_min": 8,
      "heat": "小火",
      "tip": "蒜末后放，和洋葱一起下锅容易在高温里炒出苦味。",
      "visual_cue": "洋葱透明发亮，锅里有甜香"
    },
    {
      "n": 5,
      "text": "转大火倒入沥干的土豆丝，不停翻炒八分钟至薯丝熟透并带焦边。",
      "time_min": 10,
      "heat": "大火",
      "tip": "薯丝一次别倒太厚，铺开在锅里才炒得香脆。",
      "visual_cue": "薯丝金黄微焦，锅里的噼啪声变轻"
    },
    {
      "n": 6,
      "text": "把鳕鱼片、鸡蛋块与黑橄榄倒回锅中，用木铲翻底轻轻拌匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "从锅底翻起来拌，猛搅会把鱼肉和蛋白搅成碎渣。",
      "visual_cue": "各色配料分布均匀，油润不粘连"
    },
    {
      "n": 7,
      "text": "关火撒欧芹碎与剩余黑胡椒，趁热盛盘上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "欧芹关火后再撒，余温足够激香又保持翠绿。",
      "visual_cue": "表面点缀碎绿，盘中油光清亮"
    }
  ],
  "tips": [
    "薯丝洗掉表面淀粉是松散不粘的关键，别省这一步。",
    "鳕鱼可用现成咸鳕鱼，需提前二十四小时换水泡淡并减盐。",
    "配一份简单的生菜沙拉能解油炸般的腻口。"
  ],
  "common_mistakes": [
    "薯丝没泡水直接下锅，淀粉遇热结团成糊块。",
    "火候太小炒薯丝，出水变软烂失去焦香。",
    "鱼肉和蛋块一起猛搅，出锅全成碎渣没有形。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "龙利鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更嫩，煎制时间缩短两分钟。"
    },
    {
      "original": "黑橄榄",
      "substitute": "酸豆",
      "ratio": "60 克:40 克",
      "note": "咸酸更突出，盐量再减两克。"
    }
  ],
  "variations": [
    "把一半鳕鱼换成虾仁，可做海陆混合版本。",
    "出锅前淋一勺蒜香橄榄油，香气更足。"
  ],
  "serving_suggestion": "盛在温热的浅盘中，配柠檬角和冰镇白葡萄酒。",
  "storage": "冷藏两天、不建议冷冻；复热用平底锅小火回温，口感比微波好。",
