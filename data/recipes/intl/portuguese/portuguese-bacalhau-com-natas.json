 "equipment": [
  "锅",
  "烤盘",
  "刀",
  "木勺",
  "烤箱"
 ],
 "steps": [
  {
   "n": 1,
   "text": "鳕鱼提前泡水去盐，中途换两次水。，火候要稳，别忽大忽小。",
   "time_min": 62,
   "heat": "无火",
   "tip": "泡够时间，成菜才不咸。，火候要稳，别忽大忽小。",
   "visual_cue": "鱼肉回软，水色转清"
  },
  {
   "n": 2,
   "text": "鳕鱼放锅里煮十分钟，捞出拆成大片。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "中火",
   "tip": "别煮太久，后面还要烤。，火候要稳，别忽大忽小。",
   "visual_cue": "鱼肉分层，能撕成片"
  },
  {
   "n": 3,
   "text": "土豆去皮切半厘米厚片，泡水去掉表面浮粉。，火候要稳，别忽大忽小。",
   "time_min": 8,
   "heat": "无火",
   "tip": "泡过水，炸出来才不粘。，火候要稳，别忽大忽小。",
   "visual_cue": "土豆片洁白，水微浑"
  },
  {
   "n": 4,
   "text": "锅里倒橄榄油烧到六成热，土豆片下锅炸。，火候要稳，别忽大忽小。",
   "time_min": 10,
   "heat": "中大火",
   "tip": "表面金黄就捞，后面还要烤。，火候要稳，别忽大忽小。",
   "visual_cue": "土豆浮起，边缘金黄"
  },
  {
   "n": 5,
   "text": "另起锅放黄油，炒洋葱丝和蒜末到软。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "中火",
   "tip": "洋葱炒软，甜味才出来。，火候要稳，别忽大忽小。",
   "visual_cue": "洋葱透明，锅底微黄"
  },
  {
   "n": 6,
   "text": "撒面粉炒一分钟，倒入牛奶和淡奶油搅匀。，火候要稳，别忽大忽小。",
   "time_min": 5,
   "heat": "小火",
   "tip": "面粉炒过才不腥。，火候要稳，别忽大忽小。",
   "visual_cue": "奶酱浓稠，无颗粒，这一点很关键。"
  },
  {
   "n": 7,
   "text": "加盐和黑胡椒，小火煮到挂勺。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "小火",
   "tip": "奶酱太稀，烤完会流汤。，火候要稳，别忽大忽小。",
   "visual_cue": "勺背挂糊，缓缓流下"
  },
  {
   "n": 8,
   "text": "烤盘铺一层土豆，再铺鳕鱼片和洋葱。，火候要稳，别忽大忽小。",
   "time_min": 5,
   "heat": "无火",
   "tip": "层次铺平，切的时候才好看。，火候要稳，别忽大忽小。",
   "visual_cue": "铺面平整，厚薄均匀"
  },
  {
   "n": 9,
   "text": "倒入奶酱抹平，表面再摆一层土豆片。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "顶层土豆吸收奶酱，最香。，火候要稳，别忽大忽小。",
   "visual_cue": "表面覆盖，酱汁不溢"
  },
  {
   "n": 10,
   "text": "烤箱两百度烤二十五分钟，表面金黄起泡。，火候要稳，别忽大忽小。",
   "time_min": 27,
   "heat": "无火",
   "tip": "烤到边缘冒泡，香气才出来。，火候要稳，别忽大忽小。",
   "visual_cue": "表面焦黄，酱汁冒泡"
  },
  {
   "n": 11,
   "text": "出炉静置八分钟再切块。，火候要稳，别忽大忽小。",
   "time_min": 9,
   "heat": "无火",
   "tip": "静置后切，层次才不散。，火候要稳，别忽大忽小。",
   "visual_cue": "切面分层，酱汁挂壁"
  }
 ],
 "tips": [
  "鳕鱼泡够水，成菜才不咸。，这一点很关键。",
  "奶酱煮到挂勺，烤完才不流汤。，这一点很关键。",
  "静置八分钟再切，层次才整齐。，这一点很关键。"
 ],
 "common_mistakes": [
  "鳕鱼没泡够，整盘咸得下不去口。，这一点很关键。",
  "奶酱太稀，烤完一盘子汤。，这一点很关键。",
  "土豆炸过头，烤完发硬。，这一点很关键。"
 ],
 "substitutions": [
  {
   "original": "鳕鱼",
   "substitute": "鲈鱼",
   "ratio": "700 克:700 克",
   "note": "鲜鱼不用泡水，盐减至三克。"
  },
  {
   "original": "淡奶油",
   "substitute": "牛奶",
   "ratio": "250 毫升:250 毫升",
   "note": "需多加十克面粉增稠。"
  }
 ],
 "variations": [
  "撒一层芝士碎再烤，表面更香。，这一点很关键。",
  "加一点黑橄榄，风味更地中海。，这一点很关键。"
 ],
 "serving_suggestion": "配绿沙拉和一杯白葡萄酒。，这一点很关键。",
 "storage": "冷藏两天，复热用烤箱一百八十度。",
