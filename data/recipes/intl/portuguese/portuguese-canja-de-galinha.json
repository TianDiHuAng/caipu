  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉洗净，剔除多余脂肪。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "脂肪留一点，汤才不寡淡。，火候要稳，别忽大忽小。",
      "visual_cue": "鸡块干净，皮面完整"
    },
    {
      "n": 2,
      "text": "汤锅倒橄榄油，把鸡块两面略煎。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煎一下汤更香，不必煎熟。，火候要稳，别忽大忽小。",
      "visual_cue": "表面微黄，锅底留香"
    },
    {
      "n": 3,
      "text": "加洋葱、大蒜、香叶和清水，大火煮开。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "大火",
      "tip": "煮开时撇净浮沫，汤才清。，火候要稳，别忽大忽小。",
      "visual_cue": "浮沫聚边，汤面转清"
    },
    {
      "n": 4,
      "text": "转小火炖三十分钟，撇两次油。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢炖，汤色才透亮。，火候要稳，别忽大忽小。",
      "visual_cue": "汤面微沸，油花聚边"
    },
    {
      "n": 5,
      "text": "捞出鸡块，拆下肉撕成条，骨头回锅再煮十分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "骨头回锅，汤味才够厚。，火候要稳，别忽大忽小。",
      "visual_cue": "肉条松散，汤色加深"
    },
    {
      "n": 6,
      "text": "加胡萝卜丁煮五分钟，再下大米。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中火",
      "tip": "大米后下，才不煮成糊。，火候要稳，别忽大忽小。",
      "visual_cue": "胡萝卜微软，米粒分明"
    },
    {
      "n": 7,
      "text": "小火煮十五分钟，到米粒开花。，火候要稳，别忽大忽小。",
      "time_min": 16,
      "heat": "小火",
      "tip": "米开花汤才稠，别煮过头。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒开花，汤体微稠"
    },
    {
      "n": 8,
      "text": "鸡肉条回锅，加盐调味，撒薄荷碎。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "薄荷最后放，香气才清。，火候要稳，别忽大忽小。",
      "visual_cue": "绿点浮动，汤色金黄"
    }
  ],
  "tips": [
    "煮开时撇净浮沫，汤才清亮。，这一点很关键。",
    "骨头回锅再煮，味道更厚。，这一点很关键。",
    "大米后下，才不煮成糊。，这一点很关键。"
  ],
  "common_mistakes": [
    "大火滚煮，汤浑肉柴。，这一点很关键。",
    "米早下，煮成一锅粥。，这一点很关键。",
    "不撇浮沫，汤色发灰。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "大米",
      "substitute": "意面",
      "ratio": "120 克:100 克",
      "note": "意面更耐煮，需多煮五分钟。"
    },
    {
      "original": "薄荷",
      "substitute": "欧芹",
      "ratio": "8 克:10 克",
      "note": "香气更平，用量可多。"
    }
  ],
  "variations": [
    "加一勺柠檬汁，汤更清爽。，这一点很关键。",
    "放几片卷心菜，甜味更足。，这一点很关键。"
  ],
  "serving_suggestion": "热汤配面包，感冒时最合适。，这一点很关键。",
  "storage": "冷藏两天，复热须煮开。，这一点很关键。",
