  ],
  "steps": [
    {
      "n": 1,
      "text": "杏仁用干锅小火烘三分钟，放凉后磨成粗粉。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "小火",
      "tip": "烘过才香，别烘到发黑。，火别开太大，稳着来。",
      "visual_cue": "杏仁微黄，香气上涌"
    },
    {
      "n": 2,
      "text": "锅里放白糖、清水和柠檬皮，小火熬成糖浆。，锅温要匀，别忽高忽低。",
      "time_min": 8,
      "heat": "小火",
      "tip": "熬到能挂勺就够，别熬成焦糖。，火力保持中等，慢慢来。",
      "visual_cue": "糖浆清亮，微挂勺背"
    },
    {
      "n": 3,
      "text": "糖浆离火稍凉，分次倒入蛋黄搅匀。，火候宁小勿大，慢慢推进。",
      "time_min": 5,
      "heat": "无火",
      "tip": "太烫会把蛋黄烫成块。，注意锅里温度别掉下来。",
      "visual_cue": "糊体浓稠，颜色奶黄"
    },
    {
      "n": 4,
      "text": "倒回锅里小火搅五分钟，到糊体抱团。，始终中小火，别心急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "全程小火，糊一沸就散。，火要均匀，食材才不糊。",
      "visual_cue": "糊体成团，离锅不粘"
    },
    {
      "n": 5,
      "text": "拌入杏仁粉，搅到完全融合。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "无火",
      "tip": "杏仁粉后放，香气才留得住。，全程留意火候，别贪快。",
      "visual_cue": "团块紧实，手上不粘"
    },
    {
      "n": 6,
      "text": "放凉后抹黄油，搓成乒乓球大小的球。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "无火",
      "tip": "凉透再搓，形状才圆。，火别开太大，稳着来。",
      "visual_cue": "小球圆整，表面光滑"
    },
    {
      "n": 7,
      "text": "滚一圈椰蓉，摆盘静置十分钟定型。，锅温要匀，别忽高忽低。",
      "time_min": 12,
      "heat": "无火",
      "tip": "椰蓉裹匀，看着才精致。，火力保持中等，慢慢来。",
      "visual_cue": "外层雪白，形状稳定"
    }
  ],
  "tips": [
    "杏仁烘过再磨，香气才够。，这步最关键。",
    "糖浆别熬成焦糖，会盖住杏仁味。，很多人在这里出错。",
    "蛋黄分次加，才不结块。，这里最容易翻车。"
  ],
  "common_mistakes": [
    "糖浆太烫倒蛋黄，结成蛋花。，别小看这一步。",
    "小火不够小，糊体起泡发硬。，成败就在这一步。",
    "没放凉就搓，手上粘一团。，这点要注意。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "200 克:200 克",
      "note": "苦味更重，糖多加二十克。"
    },
    {
      "original": "椰蓉",
      "substitute": "糖粉",
      "ratio": "40 克:30 克",
      "note": "外裹更甜，糖浆可减十克。"
    }
  ],
  "variations": [
    "裹一层可可粉，做成巧克力味。，这是关键点。",
    "加几滴橙花水，香气更浓。，别嫌麻烦，做完它。"
  ],
  "serving_suggestion": "配一杯浓咖啡，或当节日糖果。，这一步别省。",
  "storage": "冷藏五天，室温两天。，别跳过这步。",
