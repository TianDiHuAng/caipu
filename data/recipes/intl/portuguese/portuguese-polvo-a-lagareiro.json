  "steps": [
    {
      "n": 1,
      "text": "章鱼整只用清水冲净，撕掉嘴部和眼周，用擀面杖在触手上敲几下让纤维松弛。",
      "time_min": 10,
      "heat": "无火",
      "tip": "敲打能让章鱼煮后不发硬，别用力过猛弄破皮。",
      "visual_cue": "触手略卷，表面无黏液"
    },
    {
      "n": 2,
      "text": "大锅水加洋葱块和香叶烧开，提着章鱼头把触手浸入热水三次再整只放下。",
      "time_min": 5,
      "heat": "大火",
      "tip": "三起三落能让触手自然卷曲，卖相整齐。",
      "visual_cue": "触手卷成漂亮的螺旋，颜色转紫红"
    },
    {
      "n": 3,
      "text": "加盖小火煮三十五分钟，用筷子戳触手最粗处能轻松穿透即可关火。",
      "time_min": 35,
      "heat": "小火",
      "tip": "水要保持微沸，大滚会把皮煮破。",
      "visual_cue": "筷子一插即入，皮完整不脱落"
    },
    {
      "n": 4,
      "text": "捞出章鱼稍放凉，切成大块，煮章鱼的汤留着备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "放凉再切，切口才整齐。",
      "visual_cue": "断面白嫩，边缘带紫色"
    },
    {
      "n": 5,
      "text": "小土豆带皮洗净，放煮章鱼的热水里煮十五分钟至软，捞出压扁。",
      "time_min": 15,
      "heat": "中火",
      "tip": "压扁能让土豆吸油更多，别压成泥。",
      "visual_cue": "土豆裂口，按下去会陷"
    },
    {
      "n": 6,
      "text": "烤盘铺土豆和章鱼块，撒盐和黑胡椒，淋一半橄榄油，撒蒜碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜末撒在表面，烤时才会焦香。",
      "visual_cue": "油亮均匀，蒜末散布其上"
    },
    {
      "n": 7,
      "text": "烤箱两百二十度烤十二分钟至土豆边缘焦黄、章鱼表面微皱。",
      "time_min": 12,
      "heat": "大火",
      "tip": "温度要够高，否则只是把食材烘干。",
      "visual_cue": "土豆边缘起焦，章鱼皮微皱"
    },
    {
      "n": 8,
      "text": "取出淋剩下的橄榄油，撒欧芹碎，趁热连烤盘上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "最后淋的生油带果香，别提前加。",
      "visual_cue": "表面泛着亮油，欧芹翠绿"
    }
  ],
  "tips": [
    "章鱼煮好后可以放回汤里泡着，肉质更嫩。",
    "土豆选个头小的，带皮烤才有脆壳。",
    "烤箱最后两分钟开上火，表面会更焦香。"
  ],
  "common_mistakes": [
    "章鱼大火猛煮，出锅皮破肉韧嚼不动。",
    "土豆提前去皮切块，烤完只剩碎末。",
    "橄榄油一次全倒，烤盘里积油冒烟。"
  ],
  "substitutions": [
    {
      "original": "章鱼",
      "substitute": "鱿鱼",
      "ratio": "1000克:800克",
      "note": "鱿鱼易熟，煮的时间缩短到五分钟。"
    },
    {
      "original": "香叶",
      "substitute": "百里香",
      "ratio": "2克:2克",
      "note": "香气更偏草本，煮汤时用量减半。"
    }
  ],
  "variations": [
    "加几个小番茄同烤，酸味会解掉油腻。",
    "喜欢辣味可在烤盘上撒一撮辣椒碎再进烤箱。"
  ],
  "serving_suggestion": "端上桌后挤一点柠檬汁，配烤面包蘸盘底的蒜香油。",
  "storage": "冷藏可放两天，复热用平底锅小火煎，别用微波会变橡皮。",
