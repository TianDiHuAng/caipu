  "steps": [
    {
      "text": "沙丁鱼去鳞去内脏后冲洗干净，用厨房纸擦干内腔与表皮，鱼身划两刀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "内腔擦干，腥味才轻。",
      "visual_cue": "鱼身干爽、无血水",
      "n": 1
    },
    {
      "text": "鱼身内外刷橄榄油，撒盐、黑胡椒与一半蒜末，腹中塞入欧芹碎。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐撒得匀，皮才不粘架。",
      "visual_cue": "调味均匀、腹腔填满",
      "n": 2
    },
    {
      "text": "面包切片刷橄榄油烤到两面焦脆，柠檬切成薄角备用。",
      "time_min": 3,
      "heat": "中火",
      "tip": "面包烤脆才接得住鱼油。",
      "visual_cue": "面包边缘焦黄、柠檬切面整齐",
      "n": 3
    },
    {
      "text": "烤架烧热后摆上沙丁鱼，每面烤四分钟至表皮起泡焦脆，出炉挤柠檬汁。",
      "time_min": 4,
      "heat": "大火",
      "tip": "别急着翻，皮会粘破。",
      "visual_cue": "表皮起泡、鱼眼变白",
      "n": 4
    },
    {
      "text": "鱼装盘撒剩余蒜末与欧芹，配烤面包与柠檬角一起上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃，凉了腥气回升。",
      "visual_cue": "鱼皮焦脆、蒜末点缀",
      "n": 5
    }
  ],
  "tips": [
    "沙丁鱼要选眼睛清亮、鱼身发硬的，软塌的已不新鲜。",
    "烤前刷油撒盐，鱼皮才不会粘在烤架上。",
    "每面只翻一次，翻多了鱼皮破裂、鱼肉散开。"
  ],
  "common_mistakes": [
    "鱼身湿着上架，皮粘架撕成碎片。",
    "沙丁鱼烤太久，鱼肉干柴，彻底失了油脂香气。",
    "翻面太频繁，鱼皮破裂、鱼身散架不成形。"
  ],
  "substitutions": [
    {
      "original": "沙丁鱼",
      "substitute": "鲈鱼",
      "ratio": "600g 对 600g",
      "note": "切厚片，每面烤六分钟。"
    },
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "10g 对 10g",
      "note": "香气更冲。"
    }
