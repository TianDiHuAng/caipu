  "variations": [
    "炭火版：改用炭火烤制，烟熏气更足，香气更野。",
    "番茄版：配 200g 烤番茄与洋葱同盘。"
  ],
  "serving_suggestion": "配烤面包、烤甜椒与一杯冰镇白葡萄酒。",
  "storage": "冷藏可存 1 天，冷食配沙拉亦可，不建议复烤。",
