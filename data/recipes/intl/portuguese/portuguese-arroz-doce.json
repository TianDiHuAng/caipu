    "total_min": 120
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "大米",
          "name_en": "rice",
          "amount": 150,
          "unit": "g",
          "note": "短粒米",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 800,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 1,
          "unit": "piece",
          "note": "取蛋黄",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "取皮屑",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 15,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "小碗",
    "刨丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米用清水淘洗两遍，沥干后放进厚底锅里。",
      "time_min": 6,
      "heat": "无火",
      "tip": "米洗到水清，煮出的布丁才不浑。",
      "visual_cue": "米粒干净，锅底无积水"
    },
    {
      "n": 2,
      "text": "倒入四百毫升牛奶，开小火加热并不断搅动。",
      "time_min": 8,
      "heat": "小火",
      "tip": "一开始就要搅，米粒才不会粘锅底。",
      "visual_cue": "牛奶微沸，米粒在锅里打转"
    },
    {
      "n": 3,
      "text": "牛奶被米吸干后，再分三次加入剩下的牛奶。",
      "time_min": 12,
      "heat": "小火",
      "tip": "分几次加奶，米粒才能慢慢涨透。",
      "visual_cue": "米粒饱满，液体渐渐变稠"
    },
    {
      "n": 4,
      "text": "加入白糖与一小撮盐，继续搅到糖完全融化。",
      "time_min": 5,
      "heat": "小火",
      "tip": "一小点盐提味，甜味才不会单薄。",
      "visual_cue": "甜香散开，液体泛着光泽"
    },
    {
      "n": 5,
      "text": "刨入柠檬的黄色皮屑，只取黄色那层不要白瓤。",
      "time_min": 3,
      "heat": "小火",
      "tip": "白瓤发苦，刨皮的时候要手下留情。",
      "visual_cue": "表面浮着细碎黄屑，清香扑鼻"
    },
    {
      "n": 6,
      "text": "小火再煮十分钟，直到木勺划底不见流动的浆。",
      "time_min": 10,
      "heat": "小火",
      "tip": "木勺能划出明显痕迹，就说明够稠了。",
      "visual_cue": "勺痕清晰，米粒软糯抱团"
    },
    {
      "n": 7,
      "text": "蛋黄打散，先舀一勺热布丁慢慢兑进去搅匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先把蛋黄兑热再回锅，蛋黄才不结块。",
      "visual_cue": "蛋黄液顺滑，颜色浅黄"
    },
    {
      "n": 8,
      "text": "把蛋黄液倒回锅里，小火搅一分钟马上关火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "回锅只搅一分钟，久煮蛋黄会老。",
      "visual_cue": "布丁浓稠发亮，蛋香融进去"
    },
    {
      "n": 9,
      "text": "拌入黄油搅到完全融化，再盛进小碗里自然放凉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油最后再加，香气才留得住不散。",
      "visual_cue": "表面光滑，油光微微"
    },
    {
      "n": 10,
      "text": "放凉后撒少许柠檬皮屑，冷藏一小时后更好吃。",
      "time_min": 62,
      "heat": "无火",
      "tip": "冷藏后口感更凝实，风味更融合。",
      "visual_cue": "布丁凝成半固体，凉气十足"
    }
  ],
  "tips": [
    "牛奶分次加，米粒才涨得透而不过稀。",
    "柠檬皮只刨黄色部分，白瓤会发苦。",
    "蛋黄先兑热再回锅，才不会结块。"
  ],
  "common_mistakes": [
    "牛奶一次全倒进去，米还没熟奶就熬干。",
    "全程大火煮，锅底会糊出一层焦味。",
    "蛋黄直接倒进滚烫布丁，立刻结成蛋花。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "800 毫升:400 毫升加 400 毫升牛奶",
      "note": "更浓郁，热量也更高。"
    },
    {
      "original": "柠檬",
      "substitute": "橙子",
      "ratio": "30 克:40 克",
      "note": "果香更甜，酸味更淡。"
    }
  ],
  "variations": [
    "表面撒一层肉桂粉，香气更暖也更浓。",
    "放凉后浇一勺焦糖，甜味更有层次。"
  ],
  "serving_suggestion": "盛在小碗里冷藏后食用，表面撒少许柠檬皮屑，配一杯浓缩咖啡正好。",
  "storage": "冷藏两天，表面盖一层保鲜膜防止结皮。",
