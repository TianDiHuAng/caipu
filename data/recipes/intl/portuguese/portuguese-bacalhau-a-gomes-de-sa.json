  "steps": [
    {
      "n": 1,
      "text": "咸鳕鱼提前一夜放冷藏用冷水浸泡，中途换三次水；做菜时取出沥干，用手撕成细丝。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡够时间才不齁咸，撕丝前摸一下肉质是否回软。",
      "visual_cue": "鱼肉松散成丝，闻着只有海味不刺鼻"
    },
    {
      "n": 2,
      "text": "土豆去皮切粗条，放冷水锅煮八分钟至能用筷子插入但不断。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煮到七分熟就捞，后面还要烤。",
      "visual_cue": "土豆条边缘发白，中心略硬"
    },
    {
      "n": 3,
      "text": "炒锅倒一半橄榄油，下洋葱丝和蒜片中火炒六分钟至洋葱透明发甜。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱要炒出甜味，火大只会焦边。",
      "visual_cue": "洋葱软塌透明，锅底有浅金色油"
    },
    {
      "n": 4,
      "text": "放入鳕鱼丝翻炒三分钟，用铲子压散，加黑胡椒和一半的盐调味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "鳕鱼本身带咸，盐要最后尝过再加。",
      "visual_cue": "鱼丝散开成絮状，没有大块"
    },
    {
      "n": 5,
      "text": "把土豆条铺进烤盘，淋上炒好的鳕鱼洋葱，浇剩下的橄榄油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "铺平压实，烤出来才有层次。",
      "visual_cue": "表面平整，油光均匀"
    },
    {
      "n": 6,
      "text": "烤箱预热两百度，烤十五分钟至表面微焦、边缘起小泡。",
      "time_min": 15,
      "heat": "中火",
      "tip": "烤箱温度要够，表面才会结一层薄壳。",
      "visual_cue": "表层金黄，边缘冒细泡"
    },
    {
      "n": 7,
      "text": "取出撒欧芹碎，摆上切半的水煮蛋和黑橄榄，趁热上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鸡蛋最后摆，热气会把欧芹香带出来。",
      "visual_cue": "蛋黄色亮，橄榄乌黑发亮"
    }
  ],
  "tips": [
    "咸鳕鱼泡水时间看厚度，厚块要泡足二十四小时。",
    "土豆煮到七分熟就好，全熟再烤会散成泥。",
    "橄榄油别省，这道菜的风味一半来自油。"
  ],
  "common_mistakes": [
    "鳕鱼没泡够就下锅，成品咸得没法入口。",
    "土豆煮过头再烤，出锅成了一盘碎渣。",
    "全程小火慢炒，洋葱出水变成炖菜。"
  ],
  "substitutions": [
    {
      "original": "咸鳕鱼",
      "substitute": "鳕鱼",
      "ratio": "600克:600克",
      "note": "新鲜鳕鱼省略泡水，盐量加至八克。"
    },
    {
      "original": "黑橄榄",
      "substitute": "橄榄",
      "ratio": "40克:40克",
      "note": "绿橄榄酸度更高，配鱼更清爽。"
    }
  ],
  "variations": [
    "加一勺面包糠撒在表面同烤，会多一层脆壳。",
    "喜欢奶香可在最后一层淋少量黄油。"
  ],
  "serving_suggestion": "直接端烤盘上桌，配一杯绿酒或冰镇白葡萄酒，旁边放一份沙拉平衡咸味。",
  "storage": "冷藏可放两天，复热用烤箱一百八十度十分钟，别用微波会让土豆发硬。",
