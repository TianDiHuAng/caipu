  "equipment": [
    "深锅",
    "木铲",
    "汤勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁挤出背上的黑线，用淡盐水轻轻抓洗后沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黑线不挤干净，整锅汤都会发腥发苦。",
      "visual_cue": "虾仁透亮，背沟干净"
    },
    {
      "n": 2,
      "text": "鱿鱼收拾干净，去掉内骨，切成半厘米宽的圈。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切成一样宽，煮的时候受热才一致。",
      "visual_cue": "鱿鱼圈大小均匀，颜色雪白"
    },
    {
      "n": 3,
      "text": "深锅下橄榄油，放洋葱丁小火炒到透明发软。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒透才出甜味，这锅饭的底子全靠它。",
      "visual_cue": "洋葱透明，锅里有甜香"
    },
    {
      "n": 4,
      "text": "加蒜末炒出香味，再下番茄块炒到出汁变沙。",
      "time_min": 8,
      "heat": "中火",
      "tip": "番茄炒沙才有厚度，别急着倒水。",
      "visual_cue": "番茄化开，锅里红汤微稠"
    },
    {
      "n": 5,
      "text": "倒入大米翻炒两分钟，让每粒米都裹上油脂。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米先炒过，煮出来粒粒分明不粘。",
      "visual_cue": "米粒油亮，粒粒分开"
    },
    {
      "n": 6,
      "text": "加清水与盐，大火烧开后转小火煮十二分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "水位高过米两指，煮到八分熟刚好。",
      "visual_cue": "汤面微微冒泡，米粒膨起"
    },
    {
      "n": 7,
      "text": "把鱿鱼圈与虾仁铺在米面上，盖盖小火再焖八分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "海鲜铺在米上焖，鲜汁才往下渗。",
      "visual_cue": "虾仁转红，鱿鱼卷成小圈"
    },
    {
      "n": 8,
      "text": "关火后再焖五分钟，让米粒把锅底的鲜汤吸干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "关火多焖一会儿，米心才软透而粒粒不烂。",
      "visual_cue": "表面汤收干，米粒饱满"
    },
    {
      "n": 9,
      "text": "撒上切碎的洋葱末，再淋少许橄榄油就可以端上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出锅前淋一点橄榄油，香气立刻再提一层。",
      "visual_cue": "饭面油亮，海鲜红白相间"
    }
  ],
  "tips": [
    "大米先炒后煮，粒粒分明不粘锅。",
    "海鲜最后铺面焖，鲜汁往米里渗，不会煮老。",
    "水一次加足，中途添水会把饭煮成粥。"
  ],
  "common_mistakes": [
    "米和水一起下锅不炒，成品黏成一坨。",
    "海鲜一开始就下锅，煮完又小又韧。",
    "大火滚煮不停搅，米粒全被搅烂。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "蛤蜊",
      "ratio": "250 克:400 克",
      "note": "需吐沙干净，开口即熟。"
    },
    {
      "original": "大米",
      "substitute": "泰国香米",
      "ratio": "300 克:300 克",
      "note": "香气更足，吸水略少。"
    }
  ],
  "variations": [
    "加几只带壳大虾同焖，卖相更漂亮。",
    "撒上一把香菜末，清香解腻，颜色也好看。"
  ],
  "serving_suggestion": "连锅端上桌，挤上柠檬汁，配一杯冰镇白葡萄酒最对味。",
  "storage": "冷藏两天，复热时加两勺清水小火焖五分钟。",
