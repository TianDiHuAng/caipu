  "steps": [
    {
      "n": 1,
      "text": "猪肝用清水冲净血水，撕掉白色筋膜，切成八毫米厚的片，用厨房纸吸干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "筋膜不去会嚼不动，切薄一点更容易嫩。",
      "visual_cue": "肝片边缘整齐，表面不见血水"
    },
    {
      "n": 2,
      "text": "肝片放进白葡萄酒里，加蒜末和香叶腌十分钟去腥。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌的时间别太长，久了肉会发木。",
      "visual_cue": "酒液略带粉色，蒜香明显"
    },
    {
      "n": 3,
      "text": "捞出肝片沥干，两面撒盐和黑胡椒，腌汁留着备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "一定要沥干，带水下锅会溅油。",
      "visual_cue": "肝片表面泛干，不滴汁"
    },
    {
      "n": 4,
      "text": "平底锅倒橄榄油烧到微冒烟，转中大火把肝片平铺下锅，每面煎一分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅要够热，快煎才外焦内嫩。",
      "visual_cue": "表面焦褐，按下去有弹性"
    },
    {
      "n": 5,
      "text": "沿锅边倒入留用的腌汁，加黄油，小火煮一分钟收成薄汁。",
      "time_min": 2,
      "heat": "小火",
      "tip": "汁一开就关，煮久了肝会变硬。",
      "visual_cue": "酱汁发亮，能挂住肝片"
    },
    {
      "n": 6,
      "text": "关火撒欧芹碎，装盘旁配柠檬角，挤汁后食用。",
      "time_min": 1,
      "heat": "无火",
      "tip": "柠檬最后挤，酸味能把油腻压下去。",
      "visual_cue": "肝片泛着酱光，欧芹翠绿"
    }
  ],
  "tips": [
    "猪肝别煎过两分钟，一过就发柴。",
    "腌汁里的蒜末一起下锅，香气更足。",
    "喜欢酸一点可以把柠檬汁直接挤进锅里。"
  ],
  "common_mistakes": [
    "肝片厚薄不均，薄的煎焦厚的还生。",
    "酱汁在锅里煮到干锅，肝片表面发苦发硬。",
    "省略柠檬，整道菜油腻感压不住。"
  ],
  "substitutions": [
    {
      "original": "猪肝",
      "substitute": "牛肝",
      "ratio": "450克:450克",
      "note": "味道更浓，泡水时间延长到二十分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "苹果醋",
      "ratio": "80毫升:20毫升",
      "note": "酸度更尖，用量减半并加四十毫升水。"
    }
  ],
  "variations": [
    "加一小把洋葱丝同煎，甜味能中和肝的苦。",
    "撒一撮辣椒碎同煎，尾味的冲击感更强一些。"
  ],
  "serving_suggestion": "配煮土豆和一小份沙拉，或夹进面包做成三明治。",
  "storage": "当天吃完最好，冷藏不超过一天，复热用小火快速加热。",
