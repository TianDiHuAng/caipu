  "equipment": [
    "烤箱",
    "烤盘",
    "刷子",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用厨房纸吸干水，皮面划两刀。，注意锅里温度别掉下来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划刀让腌料进肉里，受热也更匀。，始终中小火，别心急。",
      "visual_cue": "鸡皮干爽，刀口整齐"
    },
    {
      "n": 2,
      "text": "大蒜、红椒粉、盐、黑胡椒放碗里，加橄榄油拌成酱。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酱要稠一点，才挂得住鸡皮。，火要均匀，食材才不糊。",
      "visual_cue": "酱体红亮，蒜香浓烈"
    },
    {
      "n": 3,
      "text": "抹遍鸡腿，刀口里也塞一点，挤上柠檬汁。，看住火，别让它失控。",
      "time_min": 6,
      "heat": "无火",
      "tip": "皮下也抹到，烤出来才香。，全程留意火候，别贪快。",
      "visual_cue": "鸡皮红亮，酱层均匀"
    },
    {
      "n": 4,
      "text": "倒白葡萄酒，放香叶，盖保鲜膜冷藏两小时。，火大了就离锅远一点。",
      "time_min": 122,
      "heat": "无火",
      "tip": "腌够时间，味道才进得去。，火别开太大，稳着来。",
      "visual_cue": "酒液浸底，香气融合"
    },
    {
      "n": 5,
      "text": "烤箱预热两百度，鸡腿放在烤架上。，锅温要匀，别忽高忽低。",
      "time_min": 10,
      "heat": "无火",
      "tip": "用烤架架空，底部才不泡在汁里。，火力保持中等，慢慢来。",
      "visual_cue": "烤箱升温，指示灯灭"
    },
    {
      "n": 6,
      "text": "烤三十分钟，中途刷一次腌料汁。，火候宁小勿大，慢慢推进。",
      "time_min": 32,
      "heat": "无火",
      "tip": "刷汁让表面不干，颜色更亮。，注意锅里温度别掉下来。",
      "visual_cue": "表皮收紧，油光浮动"
    },
    {
      "n": 7,
      "text": "翻面再烤十五分钟，到皮脆肉熟。，始终中小火，别心急。",
      "time_min": 16,
      "heat": "无火",
      "tip": "最后几分钟调高温度上色。，火要均匀，食材才不糊。",
      "visual_cue": "皮面焦褐，油滴作响"
    },
    {
      "n": 8,
      "text": "出炉静置五分钟，切块时挤出肉汁。，看住火，别让它失控。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置后切，肉汁才不流一盘子。，全程留意火候，别贪快。",
      "visual_cue": "切面多汁，香气冲鼻"
    }
  ],
  "tips": [
    "鸡皮划刀，腌料才进得去。，这步最关键。",
    "用烤架架空，底部才不泡汁。，很多人在这里出错。",
    "出炉静置五分钟再切。，这里最容易翻车。"
  ],
  "common_mistakes": [
    "没腌够时间，里面没味道。，别小看这一步。",
    "烤盘直接放鸡，底部又湿又软。，成败就在这一步。",
    "火太大，皮焦了里面还生。，这点要注意。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "1000 克:900 克",
      "note": "烤的时间减十分钟，避免发柴。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "柠檬汁",
      "ratio": "80 毫升:30 毫升",
      "note": "需另加五十毫升清水。"
    }
  ],
  "variations": [
    "加一点辣椒粉，做成辣味版。，这是关键点。",
    "腌料里加一勺蜂蜜，皮更脆。，别嫌麻烦，做完它。"
  ],
  "serving_suggestion": "配烤土豆和沙拉，或夹面包吃。，这一步别省。",
  "storage": "冷藏三天，复热用烤箱一百八十度。",
