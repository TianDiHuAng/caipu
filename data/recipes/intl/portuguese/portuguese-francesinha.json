  "equipment": [
    "烤盘",
    "烤箱",
    "炖锅",
    "打蛋器",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "炒酱：洋葱末与蒜末用一半黄油小火炒到透明。",
      "time_min": 8,
      "heat": "小火",
      "tip": "黄油别烧焦，微黄就要下洋葱。",
      "visual_cue": "洋葱透明软塌，香气甜润"
    },
    {
      "n": 2,
      "text": "撒入面粉不停搅拌炒两分钟，形成浅褐色面糊。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面糊要炒到不再有干粉的生味，但别炒上色太深。",
      "visual_cue": "面糊顺滑，无干粉颗粒"
    },
    {
      "n": 3,
      "text": "分次倒入高汤搅匀，再加啤酒、番茄酱、红椒粉与辣椒粉。",
      "time_min": 6,
      "heat": "中火",
      "tip": "高汤分批倒，一次倒多会结块。",
      "visual_cue": "酱体顺滑，颜色橙红"
    },
    {
      "n": 4,
      "text": "小火煮二十分钟至酱汁能挂勺，加盐调味后关火保温。",
      "time_min": 22,
      "heat": "小火",
      "tip": "酱汁要浓到能挂住勺子，太稀会泡烂面包。",
      "visual_cue": "挂勺浓稠，表面泛油光"
    },
    {
      "n": 5,
      "text": "鸡胸肉切条用橄榄油煎熟，腊肠片小火煎出油脂。",
      "time_min": 10,
      "heat": "中火",
      "tip": "腊肠煎出油再去皮更香，别煎干。",
      "visual_cue": "腊肠边缘微卷，鸡肉全白"
    },
    {
      "text": "土豆切成手指粗的条，用植物油一百八十度炸到金黄酥脆。",
      "time_min": 8,
      "heat": "中火",
      "tip": "薯条炸两遍更脆，第一遍低温定型第二遍高温上色。",
      "visual_cue": "薯条金黄，表面起小泡",
      "n": 6
    },
    {
      "n": 7,
      "text": "面包片入烤箱烤到微脆，每份叠两片面包夹鸡肉与腊肠。",
      "time_min": 7,
      "heat": "无火",
      "tip": "面包先烤脆，才能扛住辣酱不塌。",
      "visual_cue": "面包微焦，边缘干脆"
    },
    {
      "n": 8,
      "text": "整个三明治铺满奶酪片，二百度烤六分钟至奶酪融化。",
      "time_min": 7,
      "heat": "无火",
      "tip": "奶酪要完全融化盖住表面，像被子一样。",
      "visual_cue": "奶酪融化起泡，表面金褐"
    },
    {
      "n": 9,
      "text": "浇上熬好的热辣酱，顶部放一个溏心煎蛋，配薯条上桌。",
      "time_min": 9,
      "heat": "中火",
      "tip": "酱要趁热浇，冷了会结皮。",
      "visual_cue": "酱汁漫过奶酪，蛋黄流动"
    }
  ],
  "tips": [
    "辣酱现做现用，冷藏后会变得更稠。",
    "面包用厚切白吐司，太软的口感撑不住。",
    "溏心蛋是标志，煎时只煎底面不用翻。"
  ],
  "common_mistakes": [
    "酱汁煮得太稀，浇上去面包瞬间塌成一坨泥。",
    "面包没烤就直接夹料，吸水后散架。",
    "辣酱一次倒太多，辣椒粉苦味盖住所有味道。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "猪里脊",
      "ratio": "300 克:300 克",
      "note": "更柔嫩，煎制时间缩短两分钟。"
    },
    {
      "original": "腊肠",
      "substitute": "培根",
      "ratio": "180 克:180 克",
      "note": "油脂更多，酱汁风味更咸香。"
    }
  ],
  "variations": [
    "加一片火腿或牛排，做成巨型版本。",
    "把辣酱调稀一点当汤浇，更适合蘸薯条。"
  ],
  "serving_suggestion": "配炸薯条和一杯冰啤酒，趁热吃，酱汁会流一盘子。",
  "storage": "辣酱冷藏三天、冷冻一个月；三明治现做现吃，剩料分开冷藏，复热需重新浇酱。",
