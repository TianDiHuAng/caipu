        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "打蛋器",
    "模具",
    "筛子",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋加白糖和盐，隔温水打发到浓稠发白。，火候宁小勿大，慢慢推进。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打到落痕能停留三秒。，注意锅里温度别掉下来。",
      "visual_cue": "蛋糊泛白，纹路留存"
    },
    {
      "n": 2,
      "text": "筛入面粉，分三次翻拌到看不见干粉。，始终中小火，别心急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "轻手翻拌，消泡蛋糕就塌。，火要均匀，食材才不糊。",
      "visual_cue": "糊体蓬松，无干粉，这步最关键。"
    },
    {
      "n": 3,
      "text": "拌入柠檬皮屑，动作要快。，看住火，别让它失控。",
      "time_min": 2,
      "heat": "无火",
      "tip": "皮屑只取黄色部分，白的发苦。，全程留意火候，别贪快。",
      "visual_cue": "香气清亮，糊体均匀"
    },
    {
      "n": 4,
      "text": "模具抹黄油撒薄粉，倒入面糊抹平。，火大了就离锅远一点。",
      "time_min": 4,
      "heat": "无火",
      "tip": "模具处理干净，脱模才完整。，火别开太大，稳着来。",
      "visual_cue": "表面平整，无大气泡"
    },
    {
      "n": 5,
      "text": "烤箱一百七十度烤三十分钟，中途别开盖。，锅温要匀，别忽高忽低。",
      "time_min": 32,
      "heat": "无火",
      "tip": "中途开门，蛋糕会塌。，火力保持中等，慢慢来。",
      "visual_cue": "表面金黄，中心微鼓"
    },
    {
      "n": 6,
      "text": "出炉倒扣放凉十分钟，再脱模。，火候宁小勿大，慢慢推进。",
      "time_min": 12,
      "heat": "无火",
      "tip": "倒扣防回缩，凉了再脱。，注意锅里温度别掉下来。",
      "visual_cue": "边缘脱离，蛋糕挺立"
    },
    {
      "n": 7,
      "text": "切块装盘，表面可筛一点糖粉。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "凉透再切，切口才整齐。，火要均匀，食材才不糊。",
      "visual_cue": "切面细密，气孔均匀"
    }
  ],
  "tips": [
    "蛋糊打到落痕停留，蛋糕才松。，很多人在这里出错。",
    "中途别开烤箱门。，这里最容易翻车。",
    "倒扣放凉，防回缩。，别小看这一步。"
  ],
  "common_mistakes": [
    "蛋糊没打够，蛋糕又扁又硬。，成败就在这一步。",
    "拌面粉用力过猛，消泡塌陷。，这点要注意。",
    "出炉就脱模，蛋糕回缩。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "橙子",
      "ratio": "1 个:1 个",
      "note": "甜味更足，糖可减二十克。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "30 克:25 毫升",
      "note": "需先抹油再撒粉。"
    }
  ],
  "variations": [
    "加一勺蜂蜜，表皮更亮。，别嫌麻烦，做完它。",
    "表面撒杏仁片，口感更脆。，这一步别省。"
  ],
  "serving_suggestion": "切厚片配红茶或咖啡。，别跳过这步。",
  "storage": "常温密封两天，冷藏四天。，这步最关键。",
