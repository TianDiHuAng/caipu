 "steps": [
  {
   "n": 1,
   "text": "鸡蛋加白糖和盐，隔温水打发到浓稠发白。，火候要稳，别忽大忽小。",
   "time_min": 8,
   "heat": "无火",
   "tip": "打到落痕能停留三秒。，火候要稳，别忽大忽小。",
   "visual_cue": "蛋糊泛白，纹路留存"
  },
  {
   "n": 2,
   "text": "筛入面粉，分三次翻拌到看不见干粉。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "无火",
   "tip": "轻手翻拌，消泡蛋糕就塌。，火候要稳，别忽大忽小。",
   "visual_cue": "糊体蓬松，无干粉，这一点很关键。"
  },
  {
   "n": 3,
   "text": "拌入柠檬皮屑，动作要快。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "皮屑只取黄色部分，白的发苦。，火候要稳，别忽大忽小。",
   "visual_cue": "香气清亮，糊体均匀"
  },
  {
   "n": 4,
   "text": "模具抹黄油撒薄粉，倒入面糊抹平。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "无火",
   "tip": "模具处理干净，脱模才完整。，火候要稳，别忽大忽小。",
   "visual_cue": "表面平整，无大气泡"
  },
  {
   "n": 5,
   "text": "烤箱一百七十度烤三十分钟，中途别开盖。，火候要稳，别忽大忽小。",
   "time_min": 32,
   "heat": "无火",
   "tip": "中途开门，蛋糕会塌。，火候要稳，别忽大忽小。",
   "visual_cue": "表面金黄，中心微鼓"
  },
  {
   "n": 6,
   "text": "出炉倒扣放凉十分钟，再脱模。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "倒扣防回缩，凉了再脱。，火候要稳，别忽大忽小。",
   "visual_cue": "边缘脱离，蛋糕挺立"
  },
  {
   "n": 7,
   "text": "切块装盘，表面可筛一点糖粉。，火候要稳，别忽大忽小。",
   "time_min": 3,
   "heat": "无火",
   "tip": "凉透再切，切口才整齐。，火候要稳，别忽大忽小。",
   "visual_cue": "切面细密，气孔均匀"
  }
 ],
 "tips": [
  "蛋糊打到落痕停留，蛋糕才松。，这一点很关键。",
  "中途别开烤箱门。，这一点很关键。",
  "倒扣放凉，防回缩。，这一点很关键。"
 ],
 "common_mistakes": [
  "蛋糊没打够，蛋糕又扁又硬。，这一点很关键。",
  "拌面粉用力过猛，消泡塌陷。，这一点很关键。",
  "出炉就脱模，蛋糕回缩。，这一点很关键。"
 ],
