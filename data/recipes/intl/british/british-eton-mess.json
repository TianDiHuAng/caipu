  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "草莓",
          "name_en": "strawberry",
          "amount": 400,
          "unit": "g",
          "note": "去蒂",
          "optional": false
        },
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 300,
          "unit": "ml",
          "note": "冷藏",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "打发",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取皮屑",
          "optional": false
        },
        {
          "name": "薄荷",
          "name_en": "mint",
          "amount": 5,
          "unit": "g",
          "note": "点缀",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "打蛋器",
    "大碗",
    "玻璃杯",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草莓去蒂，一半切成小块，另一半压成果泥备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "留一半整块，吃起来口感才有层次。",
      "visual_cue": "果泥鲜红，果块完整"
    },
    {
      "n": 2,
      "text": "草莓里加一半白糖和柠檬皮屑拌匀，静置五分钟出汁。",
      "time_min": 7,
      "heat": "无火",
      "tip": "糖腌出汁，甜味才会渗进果肉里。",
      "visual_cue": "果肉表面泛出汁水"
    },
    {
      "n": 3,
      "text": "淡奶油从冰箱取出，加剩下的白糖用打蛋器打到软尖。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打到提起打蛋器有软尖就停，打硬就成油水分离。",
      "visual_cue": "奶油提起呈软尖状"
    },
    {
      "n": 4,
      "text": "玻璃杯底铺一层奶油，再铺一层草莓果块和果泥。",
      "time_min": 3,
      "heat": "无火",
      "tip": "一层一层铺开，舀起来层次才分明。",
      "visual_cue": "杯里红白分层清晰"
    },
    {
      "n": 5,
      "text": "重复铺一层奶油和草莓，顶端留一勺奶油收尾。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最上层用奶油封顶，颜色更清爽。",
      "visual_cue": "奶油封顶，表面平整"
    },
    {
      "n": 6,
      "text": "撒上剩下的草莓块和薄荷叶，冷藏十分钟后食用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏十分钟让风味融合，口感更凉。",
      "visual_cue": "表面点缀红果和绿叶"
    }
  ],
  "tips": [
    "草莓一半切块一半压泥，口感层次最丰富。",
    "奶油打到软尖就停，打硬会变粗糙。",
    "糖腌草莓五分钟出汁，甜味才均匀。"
  ],
  "common_mistakes": [
    "奶油打过了头，变成粗糙的颗粒状油脂。",
    "草莓全部压成泥，成品没有口感。",
    "做好放太久，奶油出水塌成一摊。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "酸奶",
      "ratio": "300 毫升:300 克",
      "note": "热量更低，酸味更明显。"
    },
    {
      "original": "草莓",
      "substitute": "覆盆子",
      "ratio": "400 克:400 克",
      "note": "酸度更高，糖可增至五十克。"
    }
  ],
  "variations": [
    "拌入掰碎的蛋白霜，口感更酥脆。",
    "淋一勺草莓利口酒，风味更成熟。"
  ],
  "serving_suggestion": "装在玻璃杯里冷藏上桌，是英国夏日野餐和学校运动会最常见的甜点。",
  "storage": "冷藏四小时，最好当天吃完；奶油打发的甜点不宜冷冻。",
