    "main-egg"
  ],
  "difficulty": 1,
  "time": {
    "prep_min": 13,
    "cook_min": 10,
    "total_min": 23
  },
  "servings": 3,
  "flavor": [
    "savory",
    "salty",
    "rich"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 300,
          "unit": "g",
          "note": "约六个，室温",
          "optional": false
        },
        {
          "name": "切达奶酪",
          "name_en": "cheddar cheese",
          "amount": 90,
          "unit": "g",
          "note": "擦成丝",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 60,
          "unit": "ml",
          "note": "调蛋液",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "煎蛋",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "打蛋盆",
    "蛋抽",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进打蛋盆，加牛奶、盐和黑胡椒，用蛋抽打到蛋液均匀无蛋筋。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打蛋别打出太多泡沫，泡沫会让表面起蜂窝。",
      "visual_cue": "蛋液顺滑，颜色一致，看着就有食欲"
    },
    {
      "n": 2,
      "text": "切达奶酪用粗孔擦成丝，小葱切成细葱花分开放。",
      "time_min": 5,
      "heat": "无火",
      "tip": "自己擦的芝士比切片融化得更快更均匀。",
      "visual_cue": "芝士丝松散，葱花干爽，香气已出"
    },
    {
      "n": 3,
      "text": "平底锅小火加热，放一半黄油，晃锅让锅底均匀挂上油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "锅不能太热，蛋液下锅一嘶就老，这一步别省。",
      "visual_cue": "黄油融化，泡沫细小，层次分明"
    },
    {
      "n": 4,
      "text": "倒入蛋液，用锅铲从边缘往中心轻推，让生蛋液流到锅底。",
      "time_min": 3,
      "heat": "小火",
      "tip": "推的时候轻，目的是让蛋液受热均匀，不是搅碎。",
      "visual_cue": "蛋液半凝，表面还湿润，火候刚好"
    },
    {
      "n": 5,
      "text": "蛋液表面还有一层湿光时，把芝士丝均匀撒在半边。",
      "time_min": 2,
      "heat": "小火",
      "tip": "芝士撒在还湿的蛋面上，才能贴住不掉。",
      "visual_cue": "芝士铺满半边，边缘开始凝固"
    },
    {
      "n": 6,
      "text": "用锅铲把另一半翻盖过来，压住边缘，小火再煎一分钟。",
      "time_min": 2,
      "heat": "小火",
      "tip": "翻盖时用铲子托住底部，别让蛋皮撕裂。",
      "visual_cue": "半月成形，芝士微微外溢，一目了然"
    },
    {
      "n": 7,
      "text": "关火，撒上葱花，趁热滑进盘子，芝士还在拉丝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盛盘时斜着滑，蛋卷才不会折出褶子。",
      "visual_cue": "表面金黄，芝士半融，火候正好"
    }
  ],
  "tips": [
    "欧姆蛋的关键是嫩，蛋液半凝就要停火，余温会把它弄熟。",
    "芝士选切达这类易融化的硬质奶酪，味道和拉丝都稳。",
    "配一片烤面包和一杯红茶，就是标准的英式早餐组合。"
  ],
  "common_mistakes": [
    "大火煎蛋，底面焦硬、上面还是生的，一口咬下去全是焦味。",
    "芝士放太多，融化后把蛋皮撑破，摊成一锅蛋碎。",
    "蛋液打太久起泡，煎出来表面坑坑洼洼，毫无光泽。"
  ],
  "substitutions": [
    {
      "original": "切达奶酪",
      "substitute": "格鲁耶尔奶酪",
      "ratio": "90克:90克",
      "note": "格鲁耶尔更香，融化后带坚果味，用量可减一成。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "60毫升:50毫升",
      "note": "淡奶油版更浓郁，煎的时间要略微缩短。"
    }
  ],
  "variations": [
    "加一把炒软的蘑菇或者菠菜，蔬菜版更好吃也更顶饱。",
    "把芝士换成烟熏味的奶酪，风味层次立刻不一样。"
  ],
  "serving_suggestion": "对折滑进温热的盘子，配沙拉菜叶和烤番茄，作为午餐主菜。",
  "storage": "现做现吃最好，冷藏后复热会变老，不建议隔夜保存。",
