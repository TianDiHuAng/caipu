  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "土豆",
          "name_en": "potato",
          "amount": 600,
          "unit": "g",
          "note": "去皮切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "卷心菜",
          "name_en": "cabbage",
          "amount": 300,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 80,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "煎饼",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 500,
          "unit": "ml",
          "note": "浸泡土豆",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "压泥器",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成大块，放进清水里浸泡五分钟备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡过水的土豆泥更松，不会发黏。",
      "visual_cue": "水色微浑，土豆块发白"
    },
    {
      "n": 2,
      "text": "土豆块下锅煮十五分钟，煮到能用筷子轻松扎透。",
      "time_min": 15,
      "heat": "大火",
      "tip": "煮到筷子一插就透，压泥才不结块。",
      "visual_cue": "筷子能轻松扎穿土豆块且不费力"
    },
    {
      "n": 3,
      "text": "卷心菜切成细丝，洋葱切成碎末放在一旁备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "卷心菜切细一点，煎的时候才容易熟。",
      "visual_cue": "菜丝细而均匀，洋葱末细碎"
    },
    {
      "n": 4,
      "text": "土豆沥干水分，趁热加黄油压成粗粒的土豆泥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "留一点颗粒感，煎出来口感更好。",
      "visual_cue": "土豆泥带小颗粒，不粘手"
    },
    {
      "n": 5,
      "text": "把卷心菜丝和洋葱末拌进土豆泥，加盐和黑胡椒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌到菜丝均匀分布，别用力搅成糊。",
      "visual_cue": "菜丝均匀混在土豆泥里"
    },
    {
      "n": 6,
      "text": "手上抹一点油，把混合物捏成八个厚约两厘米的饼。",
      "time_min": 6,
      "heat": "无火",
      "tip": "捏的时候轻压，太用力饼会散开。",
      "visual_cue": "八个圆饼大小一致"
    },
    {
      "n": 7,
      "text": "平底锅倒入植物油烧热，中小火把饼煎到底面金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅后先别翻动，定型了再翻面。",
      "visual_cue": "底面金黄，边缘定型"
    },
    {
      "n": 8,
      "text": "翻面再煎上五分钟，两面都脆了就能出锅装盘。",
      "time_min": 5,
      "heat": "中火",
      "tip": "第二面煎的时间略短，避免水分流失。",
      "visual_cue": "两面金黄，按压有脆感"
    }
  ],
  "tips": [
    "土豆泥留点颗粒感，煎出来的饼更有嚼头。",
    "饼下锅后别急着翻，定型了才不散。",
    "用黄油配植物油煎，香气和脆度都好。"
  ],
  "common_mistakes": [
    "土豆泥压得太烂，煎的时候粘成一片。",
    "油温太低就下锅，煎饼吸饱了油一点也不脆。",
    "翻面翻得太早，饼直接在锅里散成碎块。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "羽衣甘蓝",
      "ratio": "300 克:250 克",
      "note": "需先焯水一分钟再拌。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30 克:25 毫升",
      "note": "香气略减，可加一勺奶油。"
    }
  ],
  "variations": [
    "拌入少量切碎的熟培根，咸香更足。",
    "加一把擦碎的芝士，表面会拉丝。"
  ],
  "serving_suggestion": "当早餐或配菜，搭煎蛋和烤番茄一起吃很经典。",
  "storage": "冷藏两天，复热时用平底锅干煎恢复脆皮。",
  "nutrition_estimate": {
    "basis": "每份约 250 克",
