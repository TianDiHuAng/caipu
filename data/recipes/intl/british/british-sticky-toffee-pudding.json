  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 180,
          "unit": "g",
          "note": "低筋",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 100,
          "unit": "g",
          "note": "室温",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 120,
          "unit": "g",
          "note": "软化",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 120,
          "unit": "g",
          "note": "糕体用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "太妃酱用",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 100,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        },
        {
          "name": "奶油",
          "name_en": "cream",
          "amount": 150,
          "unit": "ml",
          "note": "太妃酱",
          "optional": false
        },
        {
          "name": "小苏打",
          "name_en": "baking soda",
          "amount": 3,
          "unit": "g",
          "note": "膨松",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 120,
          "unit": "ml",
          "note": "化糖",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤模",
    "小锅",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "软化的黄油加红糖打到颜色发浅、体积变蓬松，约五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油要回温到手指能压出坑，打发才顺。",
      "visual_cue": "糊体颜色发浅且蓬松"
    },
    {
      "n": 2,
      "text": "鸡蛋分三次加入，每次都搅到完全吸收再加下一次。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一次加太多会油水分离，蛋液要慢慢来。",
      "visual_cue": "蛋液吸收，糊体顺滑"
    },
    {
      "n": 3,
      "text": "面粉、小苏打和盐混合过筛，倒进糊里翻拌到无干粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "翻拌到刚好看不见干粉就停，拌多会硬。",
      "visual_cue": "面糊细腻，没有颗粒"
    },
    {
      "n": 4,
      "text": "牛奶分两次拌入面糊，调成能缓慢流动的浓稠糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "牛奶要分次加进去，糊体才不会变稀。",
      "visual_cue": "面糊浓稠且能挂住勺"
    },
    {
      "n": 5,
      "text": "面糊倒进抹了油的烤模，刮平表面放进预热好的烤箱。",
      "time_min": 4,
      "heat": "无火",
      "tip": "模具先抹油再撒粉，脱模才完整不破。",
      "visual_cue": "面糊浓稠，能挂在勺上"
    },
    {
      "n": 6,
      "text": "一百八十度烤三十五分钟，牙签插入中心取出不粘即熟。",
      "time_min": 37,
      "heat": "中火",
      "tip": "烤到中心不粘牙签，取出前先别开烤箱门。",
      "visual_cue": "表面金黄，牙签干爽"
    },
    {
      "n": 7,
      "text": "小锅放白糖、奶油和一百二十毫升清水，小火煮十分钟成太妃酱。",
      "time_min": 12,
      "heat": "小火",
      "tip": "全程小火慢煮，糖一焦味全变苦。",
      "visual_cue": "酱色琥珀，能挂住勺背"
    },
    {
      "n": 8,
      "text": "布丁稍凉后切块，淋上热太妃酱，配一勺奶油上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酱要趁热淋，凉了会凝住倒不出。",
      "visual_cue": "酱汁流淌，糕体湿润"
    }
  ],
  "tips": [
    "黄油软化到位再打发，糕体才松软不紧实。",
    "面糊拌到看不见干粉就停，过度搅拌会发硬。",
    "太妃酱全程小火，糖色变琥珀立刻关火。"
  ],
  "common_mistakes": [
    "鸡蛋一次倒入，糊体油水分离出现颗粒。",
    "烤过头导致切面干硬，失去湿润口感。",
    "太妃酱煮过了头，糖焦化带明显苦味。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "牛奶",
      "ratio": "150 毫升:150 毫升",
      "note": "酱汁更清爽，需多加十克黄油。"
    },
    {
      "original": "红糖",
      "substitute": "白糖",
      "ratio": "120 克:110 克",
      "note": "颜色更浅，焦香更淡。"
    }
  ],
  "variations": [
    "面糊里加半根香蕉压成的泥，湿润度更好。",
    "太妃酱里加一小勺海盐，甜咸更有层次。"
  ],
  "serving_suggestion": "切块趁热淋上太妃酱，配一勺打发奶油或香草冰淇淋，是英国酒馆的招牌甜点。",
  "storage": "密封常温一天，冷藏三天，复热用微波中火三十秒再淋新做的太妃酱。",
