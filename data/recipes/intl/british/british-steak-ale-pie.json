    "烤盘",
    "擀面杖",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切大块，用厨房纸吸干水分。，全程留意火候，别贪快。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉块擦干，煎时才上色。，火大了就离锅远一点。",
      "visual_cue": "肉块干爽，切面整齐"
    },
    {
      "n": 2,
      "text": "炖锅化一半黄油，牛肉分批煎上色。，火别开太大，稳着来。",
      "time_min": 10,
      "heat": "大火",
      "tip": "分批煎，锅温才不掉。，锅温要匀，别忽高忽低。",
      "visual_cue": "肉块焦褐，锅底有焦香"
    },
    {
      "n": 3,
      "text": "盛出牛肉，余油炒洋葱和胡萝卜。，火力保持中等，慢慢来。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒软，汤才甜。，火候宁小勿大，慢慢推进。",
      "visual_cue": "洋葱透明，胡萝卜发亮"
    },
    {
      "n": 4,
      "text": "撒两克面粉炒匀，倒啤酒和清水。，注意锅里温度别掉下来。",
      "time_min": 5,
      "heat": "中火",
      "tip": "面粉炒过，汤才浓。，始终中小火，别心急。",
      "visual_cue": "汤体微稠，泡沫消散"
    },
    {
      "n": 5,
      "text": "放回牛肉，加香叶和百里香，小火炖一小时。，火要均匀，食材才不糊。",
      "time_min": 62,
      "heat": "小火",
      "tip": "小火慢炖，肉才酥。，看住火，别让它失控。",
      "visual_cue": "汤汁浓稠，肉一戳就散"
    },
    {
      "n": 6,
      "text": "加盐和黑胡椒调味，放凉备用。，全程留意火候，别贪快。",
      "time_min": 10,
      "heat": "无火",
      "tip": "馅要放凉，派皮才不软。，火大了就离锅远一点。",
      "visual_cue": "汤汁浓稠，味道厚实"
    },
    {
      "n": 7,
      "text": "余下面粉加剩余黄油搓成颗粒，加水和团。，火别开太大，稳着来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，派皮才酥。，锅温要匀，别忽高忽低。",
      "visual_cue": "面团光滑，手感凉，别小看这一步。"
    },
    {
      "n": 8,
      "text": "面团擀开盖住馅料，边缘压实。，火力保持中等，慢慢来。",
      "time_min": 7,
      "heat": "无火",
      "tip": "边缘压实，汁才不漏。，火候宁小勿大，慢慢推进。",
      "visual_cue": "派皮贴合，边缘密封"
    },
    {
      "n": 9,
      "text": "表面刷蛋液，二百度烤三十分钟上色。，注意锅里温度别掉下来。",
      "time_min": 32,
      "heat": "无火",
      "tip": "表面金黄就出炉，别烤干。，始终中小火，别心急。",
      "visual_cue": "表皮金黄，微微鼓起"
    }
  ],
  "tips": [
    "牛肉分批煎，才煎出焦香。，成败就在这一步。",
    "馅放凉再盖派皮，皮才不软。，这点要注意。",
    "派皮边缘压紧，汁才不漏。，这是关键点。"
  ],
  "common_mistakes": [
    "牛肉一次下锅，出水变煮。，别嫌麻烦，做完它。",
    "馅还烫就盖皮，皮底湿软。，这一步别省。",
    "烤太久，肉汁收干。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "啤酒",
      "substitute": "红酒",
      "ratio": "330 毫升:300 毫升",
      "note": "酸度更高，需多加糖五克。"
    },
    {
      "original": "牛腱",
      "substitute": "牛腩",
      "ratio": "700 克:700 克",
      "note": "脂肪更多，炖的时间缩短十分钟。"
    }
  ],
  "variations": [
    "上面加一层土豆泥，就是双层派。，这步最关键。",
    "加蘑菇同炖，鲜味更足。，很多人在这里出错。"
  ],
  "serving_suggestion": "切开浇肉汁，配豌豆和薯泥。，这里最容易翻车。",
  "storage": "冷藏三天，冷冻一个月。，别小看这一步。",
