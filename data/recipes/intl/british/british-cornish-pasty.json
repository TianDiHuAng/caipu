  "steps": [
    {
      "n": 1,
      "text": "面粉加盐，放冷黄油丁搓成粗砂。，火候宁小勿大，慢慢推进。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油要冷，皮才酥。，注意锅里温度别掉下来。",
      "visual_cue": "颗粒粗砂，手感发凉"
    },
    {
      "n": 2,
      "text": "加清水揉成团，冷藏松弛三十分钟。，始终中小火，别心急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "面团别揉多，免得发硬。，火要均匀，食材才不糊。",
      "visual_cue": "面团光滑，按压有坑"
    },
    {
      "n": 3,
      "text": "牛肉、土豆、胡萝卜和洋葱切同样大小丁。，看住火，别让它失控。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切一样大，熟度才一致。，全程留意火候，别贪快。",
      "visual_cue": "丁块均匀，大小一致"
    },
    {
      "n": 4,
      "text": "馅料加盐和黑胡椒拌匀，不加水分。，火大了就离锅远一点。",
      "time_min": 4,
      "heat": "无火",
      "tip": "不加水，靠蔬菜自身汁水。，火别开太大，稳着来。",
      "visual_cue": "馅料干爽，调味均匀"
    },
    {
      "n": 5,
      "text": "面团分四份擀成圆片，馅放半边。，锅温要匀，别忽高忽低。",
      "time_min": 10,
      "heat": "无火",
      "tip": "边缘留空，才封得住。，火力保持中等，慢慢来。",
      "visual_cue": "面片圆整，馅料居中"
    },
    {
      "n": 6,
      "text": "对折压边，捏出绳状花边封口。，火候宁小勿大，慢慢推进。",
      "time_min": 8,
      "heat": "无火",
      "tip": "捏紧花边，汁才不会漏。，注意锅里温度别掉下来。",
      "visual_cue": "边缘密封，花边整齐"
    },
    {
      "n": 7,
      "text": "表面刷蛋液，划两道小口透气。，始终中小火，别心急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "划口透气，烤时才不爆。，火要均匀，食材才不糊。",
      "visual_cue": "表面油亮，切口整齐"
    },
    {
      "n": 8,
      "text": "一百八十度烤四十五分钟到金黄。，看住火，别让它失控。",
      "time_min": 47,
      "heat": "无火",
      "tip": "烤到表皮硬脆，里面才熟透。，全程留意火候，别贪快。",
      "visual_cue": "表面深金，边缘起酥"
    },
    {
      "n": 9,
      "text": "出炉静置十分钟再食用。，火大了就离锅远一点。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置一下，汁水才回吸。，火别开太大，稳着来。",
      "visual_cue": "切面湿润，香气扑鼻"
    }
  ],
  "tips": [
    "黄油要冷，皮才起酥。，这一步别省。",
    "馅不加水，靠蔬菜出汁。，别跳过这步。",
    "边缘花边捏紧，汁才不漏。，这步最关键。"
  ],
  "common_mistakes": [
    "面皮太软，烤后塌成一团。，很多人在这里出错。",
    "馅料切太大，里面不熟。，这里最容易翻车。",
    "没划口，烤时爆开漏汁。，别小看这一步。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "350 克:350 克",
      "note": "风味更重，可多加黑胡椒一克。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "180 克:150 毫升",
      "note": "少了酥性，皮偏脆硬。"
    }
  ],
  "variations": [
    "加一点辣椒粉，味道更醒。，成败就在这一步。",
    "做成小号，当点心吃更方便。，这点要注意。"
  ],
  "serving_suggestion": "趁热手拿着吃，配一杯热茶。，这是关键点。",
  "storage": "冷藏两天，复烤十分钟。，别嫌麻烦，做完它。",
