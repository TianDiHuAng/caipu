  ],
  "steps": [
    {
      "n": 1,
      "text": "四个鸡蛋放进冷水锅，中火煮九分钟到全熟，捞出过冰水剥壳。",
      "time_min": 14,
      "heat": "中火",
      "tip": "冷水下锅、水开计时，蛋才不容易煮裂。",
      "visual_cue": "蛋黄全熟，蛋壳一剥就整片脱落"
    },
    {
      "n": 2,
      "text": "洋葱剁成细末，撒一点盐抓匀静置五分钟，用纱布挤掉水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱水挤不干，炸的时候肉层容易开裂。",
      "visual_cue": "洋葱末松散发白，纱布里没有滴水"
    },
    {
      "n": 3,
      "text": "猪肉末加洋葱末、欧芹碎、盐、黑胡椒和肉豆蔻，顺一个方向搅到起黏性。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅到肉糜抱团上劲，包蛋时才贴得牢。",
      "visual_cue": "肉馅黏稠发亮，能整团提起"
    },
    {
      "n": 4,
      "text": "肉馅分成四份，掌心压成圆饼，放一颗鸡蛋，慢慢收拢裹圆。",
      "time_min": 9,
      "heat": "无火",
      "tip": "双手来回轻抛几下，把里面的空气挤出来。",
      "visual_cue": "肉球滚圆，蛋在中心不偏，火候正好"
    },
    {
      "n": 5,
      "text": "剩下两个鸡蛋打散成蛋液，肉球依次滚面粉、裹蛋液、粘面包糠。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面粉层薄薄一层就够，太厚会掉壳，这一步别省。",
      "visual_cue": "外壳均匀，颗粒分明不结块"
    },
    {
      "n": 6,
      "text": "深锅倒植物油烧到一百七十度，肉球下锅小火炸六分钟至金黄。",
      "time_min": 8,
      "heat": "小火",
      "tip": "油温别太高，肉厚需要时间把里面炸熟。",
      "visual_cue": "外壳金黄，油面细泡不断，状态到位"
    },
    {
      "n": 7,
      "text": "捞出放厨房纸上沥油，静置三分钟再切，蛋黄才不会流散。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置让肉汁回到中心，切面更整齐好看。",
      "visual_cue": "外壳酥脆，切开层次分明，颜色清爽"
    }
  ],
  "tips": [
    "苏格兰蛋是英国人野餐盒里的常客，冷的吃比热的更香。",
    "肉层要裹得均匀，薄厚一致才能同时炸熟。",
    "一次多裹几个冷冻生坯，想吃时直接下锅。"
  ],
  "common_mistakes": [
    "鸡蛋没煮成全熟，切开蛋黄流一地，肉层也不熟。",
    "油温过高，外壳焦黑而里面的肉还带血色。",
    "洋葱没有挤水，肉层下锅就散开，蛋整个掉出来。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡肉末",
      "ratio": "400克:400克",
      "note": "鸡肉版口感更清爽，油温可略降一档，防止外焦里生。"
    },
    {
      "original": "面包糠",
      "substitute": "玉米片碎",
      "ratio": "120克:110克",
      "note": "玉米片碎更脆，颗粒粗，压碎后再裹更服帖。"
    }
  ],
  "variations": [
    "肉馅里拌一勺黄芥末，吃起来带一点辛香，配啤酒很合适。",
    "换成鹌鹑蛋做成小个头的版本，一口一个，适合当冷盘。"
  ],
  "serving_suggestion": "切两半露出蛋心，配一小碟第戎芥末和拌菜叶，冷热都好吃。",
  "storage": "冷藏可存两天，外壳会回软；冷冻生坯可存一个月，直接冷油下锅慢炸。",
