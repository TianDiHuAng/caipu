    "大碗",
    "夹子",
    "厨房纸",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成手指粗的条，泡冷水十分钟后彻底擦干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "薯条一定要擦干，带水下锅会炸开油花。",
      "visual_cue": "表面干爽不挂水，条身硬挺"
    },
    {
      "n": 2,
      "text": "鳕鱼条用厨房纸吸干，两面撒盐与黑胡椒静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "鱼身越干，面糊越贴得住不易脱落。",
      "visual_cue": "鱼条表面微亮发黏"
    },
    {
      "n": 3,
      "text": "面粉加少许盐与冰啤酒调成浓稠面糊，静置十分钟醒发。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面糊用冰啤酒调，炸出来才轻薄起泡。",
      "visual_cue": "面糊能挂住勺子缓慢滴落"
    },
    {
      "n": 4,
      "text": "深锅倒入植物油烧到一百六十度，薯条下锅炸四分钟捞出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "第一次低油温是煮熟，薯条内部才粉糯。",
      "visual_cue": "薯条发白变软，没有焦色"
    },
    {
      "n": 5,
      "text": "油温升到一百八十度，鱼条裹满面糊下锅炸五分钟至金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "裹好糊立刻下锅，放久面糊会流掉。",
      "visual_cue": "外壳金黄鼓泡，鱼条浮起"
    },
    {
      "n": 6,
      "text": "把薯条再次下入植物油中炸两分钟，捞出与鱼条一起沥油。",
      "time_min": 4,
      "heat": "大火",
      "tip": "第二次高温把水汽逼走，薯条才脆得持久。",
      "visual_cue": "薯条金黄酥硬，敲起来有脆响"
    },
    {
      "n": 7,
      "text": "在鱼条与薯条上撒盐和欧芹碎，配柠檬角与白醋一同上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出锅立刻撒盐才挂得住，凉了盐就掉。",
      "visual_cue": "表面盐粒均匀，油光被吸干"
    }
  ],
  "tips": [
    "薯条两次炸法是英式脆感的关键，别省第一遍。",
    "油温可用一小块面糊试，浮起立刻冒泡就够热。",
    "传统吃法要配麦芽醋和豌豆泥，酸香能解油炸的厚重。"
  ],
  "common_mistakes": [
    "薯条带水下锅，油花四溅且炸不脆。",
    "油温不够就下鱼条，外壳吸满油发软。",
    "一次下太多鱼条，锅温骤降导致面糊脱落。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "龙利鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更软，炸制时间缩短一分钟。"
    },
    {
      "original": "啤酒",
      "substitute": "苏打水",
      "ratio": "200 毫升:200 毫升",
      "note": "无酒味但气泡同样让外壳酥松。"
    }
  ],
  "variations": [
    "面糊里加一勺咖喱粉，做出带香的版本。",
    "把鳕鱼换成黑线鳕，肉质更紧实，炸后不易散。"
  ],
  "serving_suggestion": "用报纸风格油纸垫盘，配柠檬角与白醋。",
  "storage": "现炸现吃最佳；冷藏一天后用二百度烤箱复烤六分钟。",
