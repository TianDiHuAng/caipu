  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "草莓",
          "name_en": "strawberry",
          "amount": 400,
          "unit": "g",
          "note": "去蒂",
          "optional": false
        },
        {
          "name": "面包",
          "name_en": "bread",
          "amount": 180,
          "unit": "g",
          "note": "切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 300,
          "unit": "ml",
          "note": "冷藏",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 200,
          "unit": "ml",
          "note": "煮酱",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 90,
          "unit": "g",
          "note": "分次用",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 25,
          "unit": "g",
          "note": "增稠",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "玻璃大碗",
    "小锅",
    "打蛋器",
    "勺子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草莓洗净去蒂，取一半切片，另一半切小丁备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "留几颗完整的，最后摆在面上好看。",
      "visual_cue": "草莓片厚薄均匀，红亮多汁"
    },
    {
      "n": 2,
      "text": "面包切成两厘米方块，铺在玻璃碗底压实一层。",
      "time_min": 6,
      "heat": "无火",
      "tip": "铺满底就行，压太实吸不进汁。火候要盯住。",
      "visual_cue": "碗底铺平，面包块间隙均匀"
    },
    {
      "n": 3,
      "text": "把一半草莓片铺在面包上，撒十克白糖腌出汁水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "撒糖腌一会，果汁会渗到面包里。",
      "visual_cue": "草莓表面发亮，碗底见了红汁"
    },
    {
      "n": 4,
      "text": "牛奶加四十克白糖与面粉，小火边煮边搅到浓稠。",
      "time_min": 7,
      "heat": "小火",
      "tip": "一定要不停搅，不然锅底会结块。",
      "visual_cue": "奶酱挂勺，刮过留痕不马上合拢"
    },
    {
      "n": 5,
      "text": "离火加入黄油搅匀，晾到温热不烫手再继续。",
      "time_min": 5,
      "heat": "无火",
      "tip": "太烫会烫化奶油，馅就分层了。多练两次就熟。",
      "visual_cue": "奶酱顺滑有光，黄油完全化开"
    },
    {
      "n": 6,
      "text": "把奶酱浇在草莓和面包上，抹平后冷藏一小时。",
      "time_min": 62,
      "heat": "无火",
      "tip": "冷藏定形，切的时候层次才不塌。",
      "visual_cue": "表面平整，奶酱凝住不流动"
    },
    {
      "n": 7,
      "text": "淡奶油加剩余白糖打至七分发，能拉出软尖即可。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到软尖就停，太硬拌开会出水。",
      "visual_cue": "奶油蓬松有纹路，提起来弯钩"
    },
    {
      "n": 8,
      "text": "把奶油铺在奶酱上抹平，边缘留一厘米不抹满。",
      "time_min": 4,
      "heat": "无火",
      "tip": "中间厚边缘薄，看着才有层次感。",
      "visual_cue": "奶油平整，侧壁玻璃透出层次"
    },
    {
      "n": 9,
      "text": "剩下的草莓丁与整颗草莓摆在奶油上做装饰。",
      "time_min": 4,
      "heat": "无火",
      "tip": "最后摆水果，冷藏久了会出水。细节决定成败。",
      "visual_cue": "草莓红亮，表面颜色分明"
    },
    {
      "n": 10,
      "text": "冷藏三十分钟后取出，用大勺从侧面舀进碗里。",
      "time_min": 32,
      "heat": "无火",
      "tip": "从侧面舀，每一勺都能带出三层。",
      "visual_cue": "层次清楚，勺上有奶油和果肉"
    }
  ],
  "tips": [
    "面包用隔夜的干面包，吸果汁才不烂成糊。",
    "奶酱全程小火不停搅，稠了立刻离火。",
    "奶油打到软尖就停，拌的时候才不散。",
    "组装后冷藏，层次才结实好看。这一步别省。"
  ],
  "common_mistakes": [
    "奶酱没搅匀，结成一粒粒疙瘩。顺序别颠倒。",
    "草莓腌得太久，出水把面包泡成一摊。",
    "奶油打过头，铺上后粗糙发分离。"
  ],
  "substitutions": [
    {
      "original": "草莓",
      "substitute": "树莓",
      "ratio": "400 克:400 克",
      "note": "酸味更强，糖可多加十克。"
    },
    {
      "original": "面包",
      "substitute": "海绵蛋糕",
      "ratio": "180 克:180 克",
      "note": "口感更软，吸汁更快。"
    }
  ],
  "variations": [
    "奶酱里加几滴香草精，香气更浓。",
    "淋一小杯雪利酒在面包上，就是传统英式做法。"
  ],
  "serving_suggestion": "用透明玻璃碗端上桌，让客人看见红白分层，用长柄勺从侧面挖一勺带三层。",
  "storage": "冷藏不超过一天，奶油层久放会出水，最好现做现吃。",
