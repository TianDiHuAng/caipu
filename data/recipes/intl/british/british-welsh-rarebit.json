  "equipment": [
    "小锅",
    "打蛋器",
    "烤箱",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小锅小火化黄油，加面粉炒一分钟。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "小火",
      "tip": "面粉炒过，酱才不结块。，火候要稳，别忽大忽小。",
      "visual_cue": "面糊起泡，颜色微黄"
    },
    {
      "n": 2,
      "text": "分次倒啤酒和牛奶，边倒边搅。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "液体慢慢加，酱才顺滑。，火候要稳，别忽大忽小。",
      "visual_cue": "酱体浓稠，无颗粒，这一点很关键。"
    },
    {
      "n": 3,
      "text": "加入切达奶酪丝，小火搅到完全融化不发颗粒。",
      "time_min": 6,
      "heat": "小火",
      "tip": "火要小，奶酪才不会分离。，火候要稳，别忽大忽小。",
      "visual_cue": "奶酪化开，酱体发亮"
    },
    {
      "n": 4,
      "text": "加黑胡椒和盐调味，尝一次咸淡。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "小火",
      "tip": "奶酪本身咸，盐要少放。，火候要稳，别忽大忽小。",
      "visual_cue": "酱味浓香，胡椒明显"
    },
    {
      "n": 5,
      "text": "面包片烤到两面微黄发脆。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面包烤脆，才不会泡软。，火候要稳，别忽大忽小。",
      "visual_cue": "表面焦黄，手感干硬"
    },
    {
      "n": 6,
      "text": "奶酪酱厚厚抹在面包上。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "抹厚一点，烤后才有层次。，火候要稳，别忽大忽小。",
      "visual_cue": "表面平整，酱体厚实"
    },
    {
      "n": 7,
      "text": "二百二十度烤五分钟到表面起泡。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "无火",
      "tip": "烤到冒泡就够，别烤焦。，火候要稳，别忽大忽小。",
      "visual_cue": "表面金黄，边缘起泡"
    }
  ],
  "tips": [
    "奶酪用小火化，火大就分离。，这一点很关键。",
    "啤酒调稀，酱才有麦香。，这一点很关键。",
    "面包先烤脆，抹酱才不塌。，这一点很关键。"
  ],
  "common_mistakes": [
    "火太大，奶酪结块出油。，这一点很关键。",
    "面包没烤，一咬满口软。，这一点很关键。",
    "盐放多，咸得发苦。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "啤酒",
      "substitute": "牛奶",
      "ratio": "100 毫升:100 毫升",
      "note": "少了麦香，可多加黑胡椒一克。"
    },
    {
      "original": "切达奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "320 克:320 克",
      "note": "拉丝好但风味淡，需加盐一克。"
    }
  ],
  "variations": [
    "加一勺芥末酱，味道更冲。，这一点很关键。",
    "表面加番茄片，烤成三明治。，这一点很关键。"
  ],
  "serving_suggestion": "趁热切块，配酸黄瓜或沙拉。，这一点很关键。",
  "storage": "奶酪酱冷藏两天，现抹现烤。，这一点很关键。",
