  "equipment": [
    "烤盘",
    "砧板",
    "刷子",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到二百度，烤盘放进烤箱一起加热十分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "热烤盘是这道菜的关键，蔬菜下盘就响。",
      "visual_cue": "烤盘冒热气，手悬上方发烫"
    },
    {
      "n": 2,
      "text": "土豆削皮切滚刀块，泡水五分钟去掉表面的粉质后彻底沥干。",
      "time_min": 9,
      "heat": "无火",
      "tip": "表面干爽才能烤出脆壳，湿的只会蒸软。",
      "visual_cue": "块形带棱角，表面无水光，一目了然"
    },
    {
      "n": 3,
      "text": "胡萝卜削皮切成长条，南瓜带皮切成三厘米见方的大块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "南瓜带皮烤才不散，皮烤过之后也能吃。",
      "visual_cue": "条块匀整，南瓜籽已挖净，火候正好"
    },
    {
      "n": 4,
      "text": "洋葱切成四瓣，大蒜带皮拍松，百里香摘下叶片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜带皮烤不会焦苦，吃的时候一挤就出来。",
      "visual_cue": "洋葱瓣完整，蒜瓣裂开，状态到位"
    },
    {
      "n": 5,
      "text": "所有蔬菜放大碗，淋橄榄油，撒盐、黑胡椒和百里香叶拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用手抓匀，每块都裹上油才烤得均匀。",
      "visual_cue": "蔬菜油亮，香料均匀附着，颜色清爽"
    },
    {
      "n": 6,
      "text": "蔬菜倒进热烤盘铺成一层，不要叠压，放香叶在表面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "铺一层不叠压，蔬菜才会烤而不是被焖软。",
      "visual_cue": "蔬菜平铺，块与块留缝，看着就有食欲"
    },
    {
      "n": 7,
      "text": "烤二十五分钟，中途翻面一次，烤到边缘焦褐、叉子可插透。",
      "time_min": 27,
      "heat": "中火",
      "tip": "翻面让每块都接触热盘，焦边才够香。",
      "visual_cue": "边缘焦褐，胡萝卜发软，香气已出"
    },
    {
      "n": 8,
      "text": "出炉挑掉香叶，连烤盘端上桌，趁热吃最香即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "烤盘余温还在，上桌后蔬菜会继续变脆。",
      "visual_cue": "表面油亮，香气扑鼻，层次分明"
    }
  ],
  "tips": [
    "烤根茎蔬菜是英式烤肉旁的固定搭配，甜味全靠烤出来。",
    "烤盘先烧热，蔬菜一下去就开始焦化，味道完全不同。",
    "块切大一点，烤完外面焦里面还是软的。"
  ],
  "common_mistakes": [
    "蔬菜洗完全没沥干就进烤箱，出来全是软塌塌的蒸菜。",
    "蔬菜堆成一座小山，中间那层烤不熟也不上色。",
    "盐放太早，蔬菜出水流在盘底，烤成了煮菜。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "300克:300克",
      "note": "红薯更甜更易焦，烤的时间缩短五分钟。"
    },
    {
      "original": "橄榄油",
      "substitute": "植物油",
      "ratio": "50毫升:50毫升",
      "note": "植物油耐高温，烤制时不容易冒烟。"
    }
  ],
  "variations": [
    "撒一小勺孜然粉和辣椒粉，立刻变成带中东味的烤蔬菜。",
    "出炉后淋一勺蜂蜜再回炉烤三分钟，表面会挂上亮亮的糖色。"
  ],
  "serving_suggestion": "连烤盘端上桌，配烤牛肉、约克郡布丁和肉汁，是周日烤肉的标配。",
  "storage": "冷藏可存三天，复热用烤箱二百度烤八分钟，微波会让表面回软。",
