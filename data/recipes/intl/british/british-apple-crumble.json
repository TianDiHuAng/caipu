  "equipment": [
    "烤箱",
    "烤盘",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苹果去皮去核，切成两厘米块。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "大小一致，烤后才一起软。，火候要稳，别忽大忽小。",
      "visual_cue": "果块均匀，颜色发白"
    },
    {
      "n": 2,
      "text": "苹果加白糖和柠檬汁拌匀，静置十分钟。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置出汁，甜酸才融合。，火候要稳，别忽大忽小。",
      "visual_cue": "果块湿润，汁水渗出"
    },
    {
      "n": 3,
      "text": "倒进烤盘铺平，压紧一点。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "铺平压实，脆顶才不塌。，火候要稳，别忽大忽小。",
      "visual_cue": "果层平整，厚度均匀"
    },
    {
      "n": 4,
      "text": "面粉、燕麦、盐和红糖放碗里拌匀。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "干料先混匀，脆顶才一致。，火候要稳，别忽大忽小。",
      "visual_cue": "粉末均匀，糖粒分散"
    },
    {
      "n": 5,
      "text": "加冷黄油丁，指尖搓成粗颗粒。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油要冷，颗粒才酥。，火候要稳，别忽大忽小。",
      "visual_cue": "颗粒粗大，手感发沙"
    },
    {
      "n": 6,
      "text": "撒在苹果上，别压实。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "松散铺开，烤后才脆。，火候要稳，别忽大忽小。",
      "visual_cue": "表层蓬松，覆盖均匀"
    },
    {
      "n": 7,
      "text": "一百八十度烤三十五分钟到金黄。，火候要稳，别忽大忽小。",
      "time_min": 37,
      "heat": "无火",
      "tip": "烤到边缘冒泡，果肉才软。，火候要稳，别忽大忽小。",
      "visual_cue": "表面金黄，果汁冒泡"
    },
    {
      "n": 8,
      "text": "出炉静置十分钟再盛盘。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置一下，汁水才不流。，火候要稳，别忽大忽小。",
      "visual_cue": "果层定型，脆顶酥松"
    }
  ],
  "tips": [
    "黄油要冷，脆顶才起酥。，这一点很关键。",
    "脆顶别压实，松着烤才脆。，这一点很关键。",
    "苹果选酸一点的，甜度才平衡。，这一点很关键。"
  ],
  "common_mistakes": [
    "黄油化软再搓，脆顶变成饼。，这一点很关键。",
    "苹果切太大，烤不透。，这一点很关键。",
    "烤太短，脆顶发白发软。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "桃子",
      "ratio": "700 克:700 克",
      "note": "甜度更高，白糖减十克。"
