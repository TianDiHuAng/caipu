          "optional": false
        },
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 100,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 60,
          "unit": "g",
          "note": "涂抹",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 90,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "葡萄干",
