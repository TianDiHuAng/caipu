          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "小锅",
    "打蛋器",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜面包切成两厘米厚的片，去掉硬边备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "用隔夜面包，吸了奶液才不烂。火候要盯住。",
      "visual_cue": "面包片干爽，边缘整齐"
    },
    {
      "n": 2,
      "text": "黄油隔水融化，用刷子把每片面包两面都薄薄刷一层。",
      "time_min": 6,
      "heat": "无火",
      "tip": "两面都刷，烤出来才香不干。多练两次就熟。",
      "visual_cue": "面包片油润，刷痕均匀"
    },
    {
      "n": 3,
      "text": "烤盘内壁抹黄油，把面包片斜着叠排进盘里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "斜叠着排，缝隙多才好倒奶液。细节决定成败。",
      "visual_cue": "面包片整齐斜靠，缝隙均匀"
    },
    {
      "n": 4,
      "text": "葡萄干撒在面包缝隙里，塞满一圈备用。动作要快别拖延。",
      "time_min": 3,
      "heat": "无火",
      "tip": "葡萄干塞进去，烤完才爆汁。别怕麻烦。",
      "visual_cue": "缝隙填满，葡萄干分布均匀"
    },
    {
      "n": 5,
      "text": "牛奶与淡奶油小火加热到锅边冒小泡，别烧开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "奶液温热就够，沸腾会起皮。这一步别省。",
      "visual_cue": "奶液微冒气，表面细滑"
    },
    {
      "n": 6,
      "text": "鸡蛋加白糖打散，慢慢冲入温奶液，边倒边搅匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一边倒一边搅，蛋液才不结块。顺序别颠倒。",
      "visual_cue": "混合液顺滑浅黄，无颗粒"
    },
    {
      "n": 7,
      "text": "把奶液慢慢浇在面包上，静置十五分钟让它吸透。",
      "time_min": 17,
      "heat": "无火",
      "tip": "静置让面包吸饱，烤完才不干。火候要盯住。",
      "visual_cue": "面包片软塌，奶液被吸进去"
    },
    {
      "n": 8,
      "text": "烤箱预热一百八十度，烤二十五分钟至表面鼓起金黄。",
      "time_min": 26,
      "heat": "中火",
      "tip": "烤到边缘微焦，香味才足。多练两次就熟。",
      "visual_cue": "表面鼓起金黄，边缘焦香"
    },
    {
      "n": 9,
      "text": "出炉静置十分钟，表面撒一层白糖再切块装盘。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置定型，切块才不塌不流。细节决定成败。",
      "visual_cue": "切块棱角清楚，奶香四溢"
    }
  ],
  "tips": [
    "用隔夜干面包，吸了奶液才不会烂成糊。",
    "奶液要慢慢浇，面包才吸得均匀。",
    "烤前静置十五分钟，成品中心才不夹生。"
  ],
  "common_mistakes": [
    "用新鲜软面包，泡完直接化成一摊。",
    "蛋液冲进滚烫的奶里，结成一块块蛋花。",
    "烤盘装得太满，奶液溢出流得满盘都是。"
  ],
  "substitutions": [
    {
      "original": "葡萄干",
      "substitute": "红枣",
      "ratio": "60 克:60 克",
      "note": "甜味更厚，需切小粒。"
    },
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "100 毫升:100 毫升",
      "note": "更清爽，奶香稍淡。"
    }
  ],
  "variations": [
    "表面撒一层肉桂糖，香气更暖。别怕麻烦。",
    "加几片苹果同烤，酸甜更明显。这一步别省。"
  ],
  "serving_suggestion": "趁温热切块装盘，淋一勺淡奶油或香草酱，冬天配红茶最舒坦。",
  "storage": "冷藏两天，复热用烤箱一百六十度烤十分钟，别用微波会出水。",
