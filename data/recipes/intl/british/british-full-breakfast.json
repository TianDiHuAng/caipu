  "equipment": [
    "平底锅",
    "烤面包机",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "平底锅小火慢慢加热，放入培根慢慢煎出金黄油脂。",
      "time_min": 6,
      "heat": "小火",
      "tip": "冷锅下培根，油才慢慢逼出来。",
      "visual_cue": "培根卷边，油脂渗出"
    },
    {
      "n": 2,
      "text": "把培根推到锅边，用锅里逼出的油煎番茄的切面。",
      "time_min": 4,
      "heat": "中火",
      "tip": "切面朝下先煎，焦香更足。",
      "visual_cue": "切面焦褐，番茄变软"
    },
    {
      "n": 3,
      "text": "腾出位置倒少量植物油，打入鸡蛋煎三分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋黄别戳破，蛋白凝固就好。",
      "visual_cue": "蛋白凝固，蛋黄微颤"
    },
    {
      "n": 4,
      "text": "面包片放入烤面包机中，烤到两面金黄、边缘酥脆。",
      "time_min": 3,
      "heat": "中火",
      "tip": "烤脆一点，用来蘸蛋黄最好。",
      "visual_cue": "表面金黄，边缘酥硬"
    },
    {
      "n": 5,
      "text": "烤好的面包趁热抹上一层黄油，让它自然化开。",
      "time_min": 1,
      "heat": "无火",
      "tip": "热面包抹黄油才化得开。",
      "visual_cue": "黄油融化，表面油亮"
    },
    {
      "n": 6,
      "text": "所有食材加盐与黑胡椒调味，装盘按顺序摆好。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先摆面包再放蛋，底盘不会湿。",
      "visual_cue": "食材铺满盘子，排列整齐不拥挤"
    }
  ],
  "tips": [
    "全程小火慢煎，培根才不会焦硬。",
    "用煎培根的油煎番茄，香气更统一。",
    "鸡蛋最后煎，上桌时蛋黄还是流心的。"
  ],
  "common_mistakes": [
    "大火煎培根，外面焦黑里面还软。",
    "鸡蛋煎得太久，蛋黄完全变成粉状发干。",
    "面包没烤直接抹黄油，软塌塌没口感。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "羊肉",
      "ratio": "120 克:150 克",
      "note": "切薄片煎香，风味接近但更瘦。"
    },
    {
      "original": "面包",
      "substitute": "玉米饼",
      "ratio": "120 克:3 片",
      "note": "烙热后替代，口感更脆。"
    }
  ],
  "variations": [
    "加一份黄油煎口蘑，鲜味更足更有满足感。",
    "配一勺茄汁焗豆，酸甜味道正好解腻开胃。"
  ],
  "serving_suggestion": "整盘上桌，配一杯红茶或黑咖啡。",
  "storage": "现做现吃，煎蛋回热后蛋黄会变硬，不建议保存。",
