  "equipment": [
    "烤盘",
    "小刀",
    "小碗",
    "勺子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香菇用湿布擦净表面，掰下菌柄，菌盖保持完整备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香菇别用水泡，吸水后就烤不出香了。",
      "visual_cue": "菌盖干净完整，菌褶清楚，火候刚好"
    },
    {
      "n": 2,
      "text": "菌柄切碎，洋葱和大蒜切成细末，欧芹切碎分开放。",
      "time_min": 7,
      "heat": "无火",
      "tip": "菌柄别丢，切碎拌馅是整道菜最香的部分。",
      "visual_cue": "碎末均匀，不见大块，一目了然"
    },
    {
      "n": 3,
      "text": "小锅小火融化黄油，下洋葱末炒四分钟到透明发甜。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒透，馅料才不会带生辣味，这一步别省。",
      "visual_cue": "洋葱透明，锅底泛光，火候正好"
    },
    {
      "n": 4,
      "text": "加大蒜末和菌柄碎炒两分钟，炒到水分收干即可。",
      "time_min": 4,
      "heat": "小火",
      "tip": "菌柄水分多，炒干一点馅才不会湿，这一步别省。",
      "visual_cue": "馅料干爽，锅底无积水，状态到位"
    },
    {
      "n": 5,
      "text": "关火拌入面包糠、一半切达奶酪、欧芹碎、盐和黑胡椒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "馅料调得稍咸一点，配上菌盖正好，这一步别省。",
      "visual_cue": "馅料抱团，能捏成小球，颜色清爽"
    },
    {
      "n": 6,
      "text": "烤盘刷一层橄榄油，香菇菌盖朝下摆好，用勺子填入馅料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "馅料压实一点，烤完才不会掉出来，这一步别省。",
      "visual_cue": "馅料饱满，微微隆起，看着就有食欲"
    },
    {
      "n": 7,
      "text": "表面撒剩余切达奶酪，放进二百度烤箱烤十五分钟。",
      "time_min": 17,
      "heat": "中火",
      "tip": "烤到奶酪起泡焦边，香菇才出汁入味。",
      "visual_cue": "奶酪金黄，菌盖边缘起皱，香气已出"
    },
    {
      "n": 8,
      "text": "出炉撒一点欧芹碎，趁热一口一个吃，汁水最足。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先晾一分钟再吃，里面的汁很烫，这一步别省。",
      "visual_cue": "表面焦亮，盘底见汁，层次分明"
    }
  ],
  "tips": [
    "酿香菇是英国酒会上的常见小食，也能当素食主菜。",
    "香菇选大朵厚肉的，馅才装得下也站得稳。",
    "馅料可以提前一天拌好冷藏，吃前再填再烤。"
  ],
  "common_mistakes": [
    "香菇用水泡洗，吸满水后烤出来一盘汤。",
    "馅料填太满，奶酪融化后全流到盘里。",
    "烤箱温度不够，香菇出水多，馅料散成一片。"
  ],
  "substitutions": [
    {
      "original": "香菇",
      "substitute": "白蘑菇",
      "ratio": "500克:500克",
      "note": "白蘑菇味淡，馅料里可以多放一点大蒜提味。"
    },
    {
      "original": "切达奶酪",
      "substitute": "奶油奶酪",
      "ratio": "120克:130克",
      "note": "奶油奶酪更软，烤的时间缩短三分钟，口感更绵。"
    }
  ],
  "variations": [
    "馅料里加一小块煎脆的培根，咸香立刻翻倍。",
    "表面撒一层帕玛森奶酪再烤，外壳会更脆更香。"
  ],
  "serving_suggestion": "摆盘时垫几片芝麻菜，淋一点橄榄油，配一杯干白当开胃菜。",
  "storage": "冷藏可存两天，复热用烤箱一百八十度烤八分钟，别用微波。",
