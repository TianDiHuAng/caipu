  "equipment": [
    "汤锅",
    "烤盘",
    "小锅",
    "蛋抽"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西兰花掰成大小相近的小朵，粗梗削去外皮切成厚片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "大小相近才能同时熟，粗梗别扔，甜味最足。",
      "visual_cue": "小朵匀整，梗片厚薄一致，一目了然"
    },
    {
      "n": 2,
      "text": "汤锅烧水加一点盐，西兰花下锅焯三分钟，捞出沥干。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯到梗部能用指甲掐动就行，颜色还翠绿。",
      "visual_cue": "花球翠绿，梗部微软，火候正好"
    },
    {
      "n": 3,
      "text": "小锅小火融化黄油，下洋葱丁炒四分钟到透明出甜味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒透，白汁才有底味，不会只剩奶味。",
      "visual_cue": "洋葱透明，锅里冒小泡，状态到位"
    },
    {
      "n": 4,
      "text": "撒入面粉不停搅拌炒一分钟，炒到没有干面味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面糊要炒到微微冒泡，白汁才不会带生面味。",
      "visual_cue": "面糊细腻，锅底起细泡，颜色清爽"
    },
    {
      "n": 5,
      "text": "牛奶分三次倒入，每次都搅到完全融合再加下一次。",
      "time_min": 6,
      "heat": "小火",
      "tip": "分次加奶是白汁不结块的关键，急不得。",
      "visual_cue": "白汁顺滑，能挂住勺背，看着就有食欲"
    },
    {
      "n": 6,
      "text": "加盐、黑胡椒和肉豆蔻，关火后拌入三分之二的切达奶酪。",
      "time_min": 3,
      "heat": "无火",
      "tip": "关火再放奶酪，余温足够融化，不会油水分离。",
      "visual_cue": "白汁浓稠，奶酪拉丝，香气已出"
    },
    {
      "n": 7,
      "text": "西兰花铺进烤盘，倒上白汁拌匀，表面撒剩余奶酪和面包糠。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面包糠撒表层，烤出来才有一层脆壳。",
      "visual_cue": "表面平整，颗粒铺满，层次分明"
    },
    {
      "n": 8,
      "text": "烤盘放进二百度烤箱烤十五分钟，到表面金黄冒泡。",
      "time_min": 17,
      "heat": "中火",
      "tip": "烤到边缘咕嘟冒泡，芝士才会有焦香。",
      "visual_cue": "表层金黄，边缘起泡，火候刚好"
    }
  ],
  "tips": [
    "这道菜是英国家庭餐桌上的常备配菜，也是素食主菜。",
    "白汁要浓一点，西兰花出水后会把汁稀释。",
    "西兰花别焯过头，进烤箱还要再烤一次。"
  ],
  "common_mistakes": [
    "白汁结块，一口咬到一团生面粉，整盘都毁了。",
    "西兰花焯太久，出炉后软成一摊，完全没有口感。",
    "奶酪在滚热的汁里煮，油水分离，表面浮一层油。"
  ],
  "substitutions": [
    {
      "original": "西兰花",
      "substitute": "花椰菜",
      "ratio": "800克:800克",
      "note": "花椰菜版更清淡，焯水时间缩短半分钟，避免过软。"
    },
    {
      "original": "切达奶酪",
      "substitute": "格鲁耶尔奶酪",
      "ratio": "150克:130克",
      "note": "格鲁耶尔更香，用量减一成，白汁的盐也要少放。"
    }
  ],
  "variations": [
    "加一层煎脆的培根碎在表面，咸香更突出，孩子更爱吃。",
    "拌入一小勺第戎芥末到白汁里，味道立刻有层次。"
  ],
  "serving_suggestion": "用烤盘直接上桌，配烤鸡或烤牛肉当配菜，也可以单吃当午餐。",
  "storage": "冷藏可存三天，复热用烤箱一百八十度烤八分钟，微波会让白汁出水。",
