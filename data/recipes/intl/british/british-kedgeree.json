  "equipment": [
    "汤锅",
    "炒锅",
    "锅铲",
    "叉子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼放进浅锅，倒牛奶和等量清水，小火浸煮六分钟至肉变白。",
      "time_min": 8,
      "heat": "小火",
      "tip": "牛奶浸煮能去腥，鱼肉也不会煮散，这一步别省。",
      "visual_cue": "鱼肉雪白，用叉子一拨成瓣"
    },
    {
      "n": 2,
      "text": "捞出鳕鱼放凉，用叉子压成大块，挑掉残留的细刺。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别压太碎，留大块口感才好，也吃得出来是鱼。",
      "visual_cue": "鱼块成瓣，不见细刺，状态到位"
    },
    {
      "n": 3,
      "text": "鸡蛋冷水下锅煮八分钟，过冷水剥壳，切成四瓣备用。",
      "time_min": 11,
      "heat": "中火",
      "tip": "煮到蛋黄刚凝就好，太老切开会散渣。",
      "visual_cue": "蛋黄橙黄，切面整齐，颜色清爽"
    },
    {
      "n": 4,
      "text": "炒锅小火融化黄油，下洋葱丁炒五分钟到透明发甜。",
      "time_min": 7,
      "heat": "小火",
      "tip": "洋葱炒到透明，甜味出来饭才不寡，这一步别省。",
      "visual_cue": "洋葱透明，锅底泛油光，看着就有食欲"
    },
    {
      "n": 5,
      "text": "加辣椒粉和香菜籽粉炒三十秒，让香料在油里散开。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香料遇油才出味，炒太久会发苦发黑。",
      "visual_cue": "油色转橙，香气冲鼻，香气已出"
    },
    {
      "n": 6,
      "text": "倒入米饭，用锅铲压散结块，中火翻炒三分钟到粒粒分明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "冷饭水分少，比新煮的饭更容易炒散。",
      "visual_cue": "饭粒松散，颗颗裹上橙油，层次分明"
    },
    {
      "n": 7,
      "text": "放回鳕鱼块，轻轻翻拌两分钟，让鱼块裹上香料饭。",
      "time_min": 4,
      "heat": "中火",
      "tip": "翻拌要轻，鱼块碎了就成鱼糊饭了，这一步别省。",
      "visual_cue": "鱼块完整，饭色均匀，火候刚好"
    },
    {
      "n": 8,
      "text": "加盐和黑胡椒调味，挤入柠檬汁，撒欧芹碎和鸡蛋瓣拌匀出锅。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬汁最后挤，酸味清爽，能压住鱼的腥。",
      "visual_cue": "饭色橙亮，蛋瓣点缀，一目了然"
    }
  ],
  "tips": [
    "这道菜是英国家庭用剩饭和剩鱼变出来的经典，如今成了正式早餐。",
    "香料只用一点点，是提味不是盖味，别抢了鱼和蛋的香。",
    "用隔夜冷饭，粒粒分明不粘糊。，值得记住。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭，一炒就成黏糊的一团。",
    "鳕鱼煮过头，压的时候全成碎末，吃不出鱼的口感。",
    "香料下锅炒到发黑，整锅饭带着苦味。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "三文鱼",
      "ratio": "400克:400克",
      "note": "三文鱼油脂多，浸煮时间缩短两分钟，口感更润。"
    },
    {
      "original": "米饭",
      "substitute": "糙米饭",
      "ratio": "500克:480克",
      "note": "糙米更有嚼劲，需要多炒一分钟才松散。"
    }
  ],
  "variations": [
    "加一小把葡萄干和烤腰果，甜咸混搭的版本更接近老派做法。",
    "把鸡蛋换成溏心蛋对半切，蛋黄拌进饭里更香。"
  ],
  "serving_suggestion": "盛进温热的盘子，摆上蛋瓣、撒欧芹，配柠檬角挤汁。",
  "storage": "冷藏可存两天，复热时加一小块黄油小火翻热，别用微波。",
