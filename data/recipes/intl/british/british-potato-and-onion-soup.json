          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "料理棒",
    "刀",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切成细丝，土豆去皮切成两厘米见方的块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "土豆切得均匀，煮的时间才一致。",
      "visual_cue": "洋葱丝细，土豆块齐整"
    },
    {
      "n": 2,
      "text": "汤锅放黄油小火融化，下洋葱丝炒十五分钟到软甜。",
      "time_min": 16,
      "heat": "小火",
      "tip": "洋葱慢慢炒出甜味，别用大火炒焦。",
      "visual_cue": "洋葱软塌，颜色微黄"
    },
    {
      "n": 3,
      "text": "倒入土豆块翻炒两分钟，让每一块表面都裹上黄油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "土豆先炒一下再加水，汤体香气会更浓。",
      "visual_cue": "土豆块表面泛油光"
    },
    {
      "n": 4,
      "text": "倒入高汤没过食材，大火烧开转小火煮二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "土豆煮到筷子一压就碎，汤才自然浓稠。",
      "visual_cue": "土豆软烂，汤面微沸"
    },
    {
      "n": 5,
      "text": "用料理棒把汤打到顺滑，喜欢颗粒感可只打一半。",
      "time_min": 3,
      "heat": "无火",
      "tip": "料理棒要完全浸入，避免热汤飞溅。",
      "visual_cue": "汤体细腻，无大块"
    },
    {
      "n": 6,
      "text": "倒入牛奶搅匀，加盐和黑胡椒调味，小火加热两分钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "牛奶要在最后加入，久煮会失去奶香。",
      "visual_cue": "汤色乳白，质地顺滑"
    },
    {
      "n": 7,
      "text": "盛进汤碗里撒上切好的大葱丝，趁热端上桌马上喝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "最后撒的这一步要在出锅后才做，香气才新鲜。",
      "visual_cue": "表面撒上翠绿点缀"
    }
  ],
  "tips": [
    "洋葱用小火慢炒十五分钟，甜味才出得来。",
    "土豆煮到筷子一压就碎，汤体自然浓稠。",
    "牛奶在最后加入，避免久煮失去奶香。"
  ],
  "common_mistakes": [
    "洋葱用大火快炒，焦味盖过了洋葱的甜味。",
    "高汤加得太少，打出来的汤稠得像土豆泥。",
    "料理棒没完全浸入汤里，热汤溅得到处都是。"
  ],
  "substitutions": [
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "900 毫升:900 毫升",
      "note": "更清淡，需增加黄油十克补香。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "150 毫升:120 毫升",
      "note": "更醇厚，热量也更高。"
    }
  ],
  "variations": [
    "加一把切达奶酪碎，风味更像英式酒馆版本。",
    "撒少许肉豆蔻粉，香气更温暖醇厚一些。"
  ],
  "serving_suggestion": "配一片烤到酥脆的面包和黄油，是英国冬天最常见的一碗热汤。",
  "storage": "冷藏三天，复热时加少量高汤调稀，小火加热并搅匀。",
