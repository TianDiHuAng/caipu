        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "压泥器",
    "小锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆削皮切成四厘米大块，泡水五分钟洗掉表面的粉质。",
      "time_min": 8,
      "heat": "无火",
      "tip": "土豆块切大一点，吸水少，泥才不稀。",
      "visual_cue": "块形齐整，水色微白，一目了然"
    },
    {
      "n": 2,
      "text": "胡萝卜削皮切成三毫米薄片，切得越薄越容易压烂。",
      "time_min": 7,
      "heat": "无火",
      "tip": "胡萝卜比土豆难软，切薄才能同时熟透。",
      "visual_cue": "薄片匀整，颜色橙亮，火候正好"
    },
    {
      "n": 3,
      "text": "汤锅放土豆，加水没过两指，大火烧开后转中火煮十分钟。",
      "time_min": 13,
      "heat": "中火",
      "tip": "土豆先煮，它比胡萝卜需要更长时间。",
      "visual_cue": "水面翻滚，土豆边缘发毛，状态到位"
    },
    {
      "n": 4,
      "text": "下胡萝卜片继续煮十分钟，到两种食材都能用筷子插透。",
      "time_min": 12,
      "heat": "中火",
      "tip": "筷子一插到底就是熟透，别靠猜时间。",
      "visual_cue": "筷子轻松插透，无水渣，颜色清爽"
    },
    {
      "n": 5,
      "text": "沥干水，把锅放回灶上小火烘一分钟，蒸掉多余水汽。",
      "time_min": 3,
      "heat": "小火",
      "tip": "把水汽烘干，泥才绵密不水塌，这一步别省。",
      "visual_cue": "锅底无水，食材表面发干，看着就有食欲"
    },
    {
      "n": 6,
      "text": "用压泥器压成粗泥，趁热加入黄油拌到完全融化。",
      "time_min": 5,
      "heat": "无火",
      "tip": "趁热加黄油，油脂才能被吸收进去，这一步别省。",
      "visual_cue": "泥体油亮，质地细腻，香气已出"
    },
    {
      "n": 7,
      "text": "温牛奶分两次倒入搅匀，加盐、黑胡椒和肉豆蔻调味。",
      "time_min": 4,
      "heat": "无火",
      "tip": "牛奶要温的，冷的会让泥变硬结块，这一步别省。",
      "visual_cue": "泥体顺滑，勺子能立住，层次分明"
    },
    {
      "n": 8,
      "text": "装盘撒上葱花，抹出几道纹路，淋一点融化的黄油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "表面抹纹路能挂住黄油，看着更有食欲。",
      "visual_cue": "颜色橙黄，葱花点缀，火候刚好"
    }
  ],
  "tips": [
    "土豆泥是英式餐桌的底座，几乎所有烤肉都配它。",
    "胡萝卜和土豆分开煮，各自的熟度才准确。",
    "压泥别用料理机，会打成胶状，口感发黏。"
  ],
  "common_mistakes": [
    "土豆煮过头吸水太多，压出来的泥稀得能流动。",
    "用冷水或冷牛奶拌泥，泥体立刻变硬发散。",
    "胡萝卜和土豆一起下锅，一个烂了一个还硬。"
  ],
  "substitutions": [
    {
      "original": "胡萝卜",
      "substitute": "南瓜",
      "ratio": "400克:400克",
      "note": "南瓜版更甜更软，煮的时间缩短三分钟。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "150毫升:120毫升",
      "note": "淡奶油版更浓，黄油用量可减一半。"
    }
  ],
  "variations": [
    "加一小勺第戎芥末，微酸带辛，配烤牛肉特别对味。",
    "混入一小把擦碎的切达奶酪，奶香更浓，颜色也好看。"
  ],
  "serving_suggestion": "盛在白盘里抹出纹路，配烤香肠、烤鸡或炖肉，浇上肉汁吃。",
  "storage": "冷藏可存两天，复热时隔水蒸热并补一小块黄油搅匀。",
