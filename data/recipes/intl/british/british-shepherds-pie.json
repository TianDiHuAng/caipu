  "equipment": [
    "炒锅",
    "汤锅",
    "烤盘",
    "压泥器",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成三厘米的块，冷水下锅加一撮盐煮二十分钟。",
      "time_min": 20,
      "heat": "中火",
      "tip": "水没过土豆两指，煮到叉子一插就透。",
      "visual_cue": "土豆开裂，叉子轻松插入"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下洋葱丁与胡萝卜丁中火炒五分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "炒到洋葱透明，甜味才出来。",
      "visual_cue": "洋葱透明，胡萝卜变软"
    },
    {
      "n": 3,
      "text": "放入羊肉粒转大火翻炒，炒散炒到肉色变深。",
      "time_min": 6,
      "heat": "大火",
      "tip": "羊肉粒下锅先别翻，让底面煎出焦色。",
      "visual_cue": "羊肉粒松散分明，边缘微焦"
    },
    {
      "n": 4,
      "text": "撒入面粉翻炒一分钟，让肉粒均匀裹上一层薄粉。",
      "time_min": 1,
      "heat": "中火",
      "tip": "面粉炒过才不会有干粉的腥气。",
      "visual_cue": "表面挂粉，锅底变干"
    },
    {
      "n": 5,
      "text": "加番茄、百里香与两百毫升热水，小火炖二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "汤汁收浓一点，铺土豆泥才不会下陷。",
      "visual_cue": "汤汁浓稠，能挂勺"
    },
    {
      "n": 6,
      "text": "土豆捞出沥干压成细腻土豆泥，加黄油与温牛奶搅匀。",
      "time_min": 17,
      "heat": "无火",
      "tip": "牛奶要温的，冷的会让土豆泥结块。",
      "visual_cue": "泥体顺滑，没有干块"
    },
    {
      "n": 7,
      "text": "炒好的馅料加盐与黑胡椒调味后铺入烤盘，抹平表面。",
      "time_min": 3,
      "heat": "无火",
      "tip": "馅料压紧实，堆得平才能抹得匀。",
      "visual_cue": "馅层平整，厚薄一致"
    },
    {
      "n": 8,
      "text": "把土豆泥铺在馅料上抹平，再用叉子在表面划出纹路。",
      "time_min": 4,
      "heat": "无火",
      "tip": "划纹路能让表面烤得酥脆好看。",
      "visual_cue": "表面出现整齐的波浪纹"
    },
    {
      "n": 9,
      "text": "烤箱两百度烤二十五分钟，表面金黄起皮即可。",
      "time_min": 25,
      "heat": "大火",
      "tip": "想更酥可最后开上火烤三分钟。",
      "visual_cue": "表面焦黄，边缘冒泡"
    }
  ],
  "tips": [
    "肉馅的汤汁一定收浓，太稀会把土豆泥泡塌。",
    "土豆泥要趁热加黄油，吸收才好。",
    "烤盘别装得太满，留出土豆泥膨胀的空间。"
  ],
  "common_mistakes": [
    "土豆泥加了冷牛奶，搅出一堆小疙瘩。",
    "肉馅汤汁没收干，切开整个塌成一摊。",
    "烤到表面发黑，实际里面早就热透了。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "500 克:500 克",
      "note": "就是农家的牛肉版，风味更浓。"
    },
    {
      "original": "百里香",
      "substitute": "迷迭香",
      "ratio": "3 克:2 克",
      "note": "香气更冲，用量要减半。"
    }
  ],
  "variations": [
    "土豆泥里加一把奶酪，烤出拉丝的表层。",
    "肉馅加一勺番茄酱，酸甜更开胃。"
  ],
  "serving_suggestion": "切成方块盛盘，配一份水煮绿叶菜和肉汁。",
  "storage": "冷藏三天、冷冻一个月，复热用烤箱一百八十度烤二十分钟。",
