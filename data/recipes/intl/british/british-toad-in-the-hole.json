  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和鸡蛋搅成稠糊，分次倒牛奶。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "牛奶慢慢加，面糊才顺滑。，火候要稳，别忽大忽小。",
      "visual_cue": "糊体顺滑，无干粉，这一点很关键。"
    },
    {
      "n": 2,
      "text": "面糊静置二十分钟，让粉充分吸水。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "无火",
      "tip": "静置一下，烤后涨得更高。，火候要稳，别忽大忽小。",
      "visual_cue": "糊面平静，略有气泡"
    },
    {
      "n": 3,
      "text": "猪肉末加洋葱丝、盐、黑胡椒和迷迭香拌匀。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌到发黏，肉卷才不散。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料成团，香气明显"
    },
    {
      "n": 4,
      "text": "搓成八个小肉卷，冷藏定型十分钟。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏定型，煎时不散。，火候要稳，别忽大忽小。",
      "visual_cue": "肉卷圆整，表面紧实"
    },
    {
      "n": 5,
      "text": "烤盘倒植物油，二百二十度预热十分钟。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "油必须烧到冒烟，面糊才涨。，火候要稳，别忽大忽小。",
      "visual_cue": "油面波动，热气腾腾"
    },
    {
      "n": 6,
      "text": "肉卷放入热油，煎到表面微黄。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "热油下锅，表皮立刻收紧。，火候要稳，别忽大忽小。",
      "visual_cue": "肉卷定型，油花四溅"
    },
    {
      "n": 7,
      "text": "倒入面糊，立刻送回烤箱烤三十分钟。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "无火",
      "tip": "倒糊要快，油温才不降。，火候要稳，别忽大忽小。",
      "visual_cue": "面糊鼓起，边缘上色"
    },
    {
      "n": 8,
      "text": "烤到金黄膨松，出炉静置五分钟。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置一下，内部才定型。，火候要稳，别忽大忽小。",
      "visual_cue": "表面金黄，蓬松高起"
    }
  ],
  "tips": [
    "油要烧到冒烟，面糊才蓬得起来。，这一点很关键。",
    "面糊静置后再烤，涨得更高。，这一点很关键。",
    "倒糊后别开烤箱，温度掉了会塌。，这一点很关键。"
  ],
  "common_mistakes": [
    "油温不够，面糊沉底不涨。，这一点很关键。",
    "中途开烤箱，成品塌陷。，这一点很关键。",
    "面糊太稀，烤成薄饼。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "500 克:500 克",
      "note": "口感更紧实，可多加牛奶二十毫升。"
    },
    {
      "original": "迷迭香",
      "substitute": "百里香",
      "ratio": "3 克:3 克",
      "note": "香气更柔和。"
    }
  ],
  "variations": [
    "加培根片同烤，咸香更足。，这一点很关键。",
    "表面撒切达奶酪丝，烤到融化。，这一点很关键。"
  ],
  "serving_suggestion": "配洋葱肉汁和豌豆一起吃。，这一点很关键。",
  "storage": "冷藏两天，复烤八分钟。，这一点很关键。",
