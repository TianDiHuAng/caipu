  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 200,
          "unit": "g",
          "note": "中筋面粉过筛",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 3,
          "unit": "piece",
          "note": "室温回温",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 200,
          "unit": "ml",
          "note": "温热",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 60,
          "unit": "g",
          "note": "垫烤盘用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "打蛋器",
    "量杯",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉过筛入大碗，中间扒出一个小坑方便倒蛋液。",
      "time_min": 2,
      "heat": "无火",
      "tip": "过筛一次，布丁才不会有粉粒。",
      "visual_cue": "粉质细腻，堆成小山"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加盐，慢慢倒进面粉里用打蛋器搅匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "一点一点搅，稠了再补牛奶。",
      "visual_cue": "面糊黏稠，没有干粉"
    },
    {
      "n": 3,
      "text": "分三次倒入温牛奶，边倒边搅成顺滑的稀面糊。",
      "time_min": 2,
      "heat": "无火",
      "tip": "牛奶要温不要烫，太热会把蛋烫熟。",
      "visual_cue": "面糊顺滑，能流畅流动"
    },
    {
      "n": 4,
      "text": "面糊盖上布静置八分钟，让面粉充分吸水活化。",
      "time_min": 8,
      "heat": "无火",
      "tip": "静置足够久，烤出来才膨胀得高。",
      "visual_cue": "面糊表面冒出细密小气孔"
    },
    {
      "n": 5,
      "text": "烤箱预热到两百二十度，烤盘里每格放一小块黄油。",
      "time_min": 5,
      "heat": "大火",
      "tip": "烤盘一定要预热到位，油要冒烟。",
      "visual_cue": "黄油融化，微微冒烟"
    },
    {
      "n": 6,
      "text": "把烤盘取出，趁热倒面糊到每格的三分之一。",
      "time_min": 3,
      "heat": "无火",
      "tip": "动作要快，油凉了就涨不起来。",
      "visual_cue": "面糊铺满格子底部，没过黄油"
    },
    {
      "n": 7,
      "text": "立刻放回烤箱烤二十分钟，中途千万不要开盖。",
      "time_min": 20,
      "heat": "大火",
      "tip": "中途开门会让布丁瞬间回缩。",
      "visual_cue": "边缘高耸，中心凹陷"
    },
    {
      "n": 8,
      "text": "出炉后稍凉两分钟，再用铲子沿边缘脱模取出。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热脱模，凉了容易粘底。",
      "visual_cue": "底部酥脆，成品完整"
    }
  ],
  "tips": [
    "面糊必须静置，这是能否膨起的关键。",
    "烤盘与黄油要烧到微微冒烟，再快速倒入面糊。",
    "烤制过程中绝对不要打开烤箱门，否则会回缩。"
  ],
  "common_mistakes": [
    "面糊现拌现烤，布丁涨不起来像煎饼。",
    "黄油没烧热就倒面糊，成品又扁又油。",
    "中途开门查看，布丁瞬间塌陷回缩。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "200 毫升:200 毫升",
      "note": "口感更清淡，黄油需多加十克。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "60 克:50 毫升",
      "note": "更易起烟，膨胀效果更稳定。"
    }
  ],
  "variations": [
    "格子里先放一勺肉汁，烤出咸香版本。",
    "面糊里加一撮黑胡椒，风味更立体。"
  ],
  "serving_suggestion": "配烤牛肉和肉汁一起吃，蘸着汤汁最香。",
  "storage": "当天吃最好，冷藏两天，复烤五分钟可回脆。",
