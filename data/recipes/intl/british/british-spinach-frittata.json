  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 300,
          "unit": "g",
          "note": "约六个",
          "optional": false
        },
        {
          "name": "菠菜",
          "name_en": "spinach",
          "amount": 250,
          "unit": "g",
          "note": "择洗干净",
          "optional": false
        },
        {
          "name": "土豆",
          "name_en": "potato",
          "amount": 300,
          "unit": "g",
          "note": "切薄片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 100,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 80,
          "unit": "ml",
          "note": "调蛋液",
          "optional": false
        },
        {
          "name": "切达奶酪",
          "name_en": "cheddar cheese",
          "amount": 60,
          "unit": "g",
          "note": "擦丝撒面",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 30,
          "unit": "ml",
          "note": "煎土豆",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "肉豆蔻",
          "name_en": "nutmeg",
          "amount": 1,
          "unit": "g",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "打蛋盆",
    "蛋抽",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆削皮切成两毫米薄片，泡在清水里洗掉表面的粉质后沥干。",
      "time_min": 9,
      "heat": "无火",
      "tip": "土豆片切薄切匀，才能在烘烤时一同熟透。",
      "visual_cue": "薄片透光，水变清亮，火候正好"
    },
    {
      "n": 2,
      "text": "平底锅放橄榄油中火加热，土豆片下锅摊平煎六分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎到边缘发软再翻，硬的时候一翻就断。",
      "visual_cue": "土豆片金黄，边缘半透明，状态到位"
    },
    {
      "n": 3,
      "text": "放洋葱丝继续炒三分钟，炒到洋葱变软出甜味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱和土豆一起打底，甜味是这道菜的底子。",
      "visual_cue": "洋葱软塌，锅底微焦，颜色清爽"
    },
    {
      "n": 4,
      "text": "菠菜下锅大火翻炒一分钟，叶子塌软后立刻关火晾一会儿。",
      "time_min": 4,
      "heat": "大火",
      "tip": "菠菜水分多，先炒掉水，烘蛋才不会湿塌塌。",
      "visual_cue": "叶片软塌，锅底见水，看着就有食欲"
    },
    {
      "n": 5,
      "text": "鸡蛋加牛奶、盐、黑胡椒和肉豆蔻打匀，倒进锅里摊平。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋液倒下去先别搅，让它自己铺满锅底。",
      "visual_cue": "蛋液没过蔬菜，表面平整，香气已出"
    },
    {
      "n": 6,
      "text": "撒上切达奶酪丝，整锅放进一百八十度烤箱烘十二分钟。",
      "time_min": 14,
      "heat": "中火",
      "tip": "用烤箱比全程在灶上烧更稳，底部不糊。",
      "visual_cue": "奶酪融化，表面鼓起，层次分明"
    },
    {
      "n": 7,
      "text": "取出静置三分钟，用锅铲沿边缘划开，滑到盘里切块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置后蛋体收紧，切块才不散，这一步别省。",
      "visual_cue": "切面平整，层次分明，火候刚好"
    }
  ],
  "tips": [
    "烘蛋比欧姆蛋更省心，切块后冷吃也好吃，适合带饭。",
    "蔬菜一定要先炒干水，蛋液才不会被稀释。",
    "土豆片可以用前一晚剩下的煮土豆代替，更省事。"
  ],
  "common_mistakes": [
    "菠菜没炒水直接进蛋液，烤出来底下积着一层汤。",
    "全程小火在灶上烧，底部焦黑而中心还是稀的。",
    "土豆片切太厚，蛋熟了土豆还是生的。"
  ],
  "substitutions": [
    {
      "original": "菠菜",
      "substitute": "西兰花",
      "ratio": "250克:250克",
      "note": "西兰花先焯水一分钟再下锅，口感更脆。"
    },
    {
      "original": "切达奶酪",
      "substitute": "帕玛森奶酪",
      "ratio": "60克:45克",
      "note": "帕玛森味重，用量减一些，咸度也要相应下调。"
    }
  ],
  "variations": [
    "加几片培根先煎出油，再用这个油煎土豆，咸香更足。",
    "换成南瓜和洋葱，甜味更突出，颜色也更好看。"
  ],
  "serving_suggestion": "切成扇形块，配烤番茄和一杯红茶，早餐午餐都合适。",
  "storage": "冷藏可存三天，复热用平底锅小火两面各热一分钟，别用微波。",
