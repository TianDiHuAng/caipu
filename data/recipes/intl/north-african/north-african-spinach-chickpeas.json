  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "锅铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜摘去老根洗净，切成五厘米长的段，沥干水分备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "菠菜要沥干，带水下锅会出一锅汤。",
      "visual_cue": "菠菜段干净，水基本沥干"
    },
    {
      "n": 2,
      "text": "洋葱切小丁，大蒜切末，番茄切小丁，香菜切碎。",
      "time_min": 9,
      "heat": "无火",
      "tip": "番茄切小丁，炒的时候才容易化开。",
      "visual_cue": "各料切好分装，丁块细小"
    },
    {
      "n": 3,
      "text": "炒锅倒橄榄油下洋葱丁中火炒五分钟至软塌透明。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒透出甜，菠菜的涩味才被压住。",
      "visual_cue": "洋葱透明软塌，锅底泛油"
    },
    {
      "n": 4,
      "text": "加蒜末、孜然和红椒粉小火炒一分钟，再下番茄丁炒三分钟出汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒出汁，后面炖的时候汤才不会干。",
      "visual_cue": "番茄化开，锅底出现红色汁水"
    },
    {
      "n": 5,
      "text": "倒入熟鹰嘴豆翻炒两分钟，加盐与黑胡椒，倒半碗清水小火炖十分钟。",
      "time_min": 13,
      "heat": "小火",
      "tip": "加少量水慢炖，豆子才吸足番茄的味道。",
      "visual_cue": "豆子吸满汤汁，锅底微稠"
    },
    {
      "n": 6,
      "text": "分两次放入菠菜段，用锅铲翻压，让菠菜完全塌进汤汁里。",
      "time_min": 5,
      "heat": "中火",
      "tip": "菠菜分两次放，锅里才装得下也受热均匀。",
      "visual_cue": "菠菜体积缩小，颜色深绿"
    },
    {
      "n": 7,
      "text": "关火挤入柠檬汁，撒香菜碎，拌两下即可装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁关火后挤，酸香清爽不发闷。",
      "visual_cue": "汤汁红亮，菠菜翠绿点缀"
    }
  ],
  "tips": [
    "菠菜洗净沥干，带水下锅会变成一锅汤。",
    "番茄先炒出汁，鹰嘴豆才吸得进味道。",
    "菠菜分两次下锅，锅里才装得下也受热均匀。",
    "柠檬汁关火后再挤，酸香味才清亮不发闷。"
  ],
  "common_mistakes": [
    "菠菜一次全倒进锅，翻不动还出水。",
    "鹰嘴豆不预先煮熟，炖半小时还是硬的。",
    "柠檬汁早放一起炖，酸味变得沉闷。",
    "大火久炒菠菜，颜色发黄发暗卖相差。"
  ],
  "substitutions": [
    {
      "original": "菠菜",
      "substitute": "甜菜叶",
      "ratio": "450克:450克",
      "note": "口感更厚实，炒的时间加两分钟。"
    },
    {
      "original": "鹰嘴豆",
      "substitute": "白芸豆",
      "ratio": "220克:220克",
      "note": "更绵软，炖的时间减三分钟。"
    }
  ],
  "variations": [
    "加一小勺辣椒酱同炒，辣味更地道。",
    "撒一把烤香的松子，口感层次会更丰富。",
    "配一个水煮蛋切开摆盘，蛋白质更足。"
  ],
  "serving_suggestion": "盛盘后配烤饼或米饭，挤上柠檬汁，酸甜咸香的汤汁拌饭特别下饭。",
  "storage": "冷藏可放三天，复热用小火加少量水，菠菜会再出一点水属正常。",
