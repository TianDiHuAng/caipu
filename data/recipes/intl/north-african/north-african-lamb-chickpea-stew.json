  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆提前泡八小时，冲洗沥干。，火别开太大，稳着来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡够时间，煮时才易软。，锅温要匀，别忽高忽低。",
      "visual_cue": "豆粒饱满，表皮起皱"
    },
    {
      "n": 2,
      "text": "羊肉切块，擦干表面血水。，火力保持中等，慢慢来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "血水擦干，汤才不浑。，火候宁小勿大，慢慢推进。",
      "visual_cue": "肉块干爽，颜色鲜红"
    },
    {
      "n": 3,
      "text": "炖锅倒橄榄油，羊肉分批煎上色。，注意锅里温度别掉下来。",
      "time_min": 10,
      "heat": "大火",
      "tip": "分批煎，肉才焦香。，始终中小火，别心急。",
      "visual_cue": "表面焦褐，锅底有香"
    },
    {
      "n": 4,
      "text": "盛出羊肉，余油炒洋葱丝到软。，火要均匀，食材才不糊。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒软，汤汁才甜。，看住火，别让它失控。",
      "visual_cue": "洋葱透明，边缘金黄"
    },
    {
      "n": 5,
      "text": "加蒜末、孜然、姜黄和红椒粉炒香。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "香料遇油才出味。，火大了就离锅远一点。",
      "visual_cue": "香气浓郁，油色变红"
    },
    {
      "n": 6,
      "text": "下番茄丁炒到出汁。，火别开太大，稳着来。，轻拿轻放，别碰碎。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒出汁，汤才红亮。，锅温要匀，别忽高忽低。",
      "visual_cue": "汁水泛红，皮卷起，别小看这一步。"
    },
    {
      "n": 7,
      "text": "放回羊肉，加鹰嘴豆和胡萝卜。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "先放耐煮的料，熟度才一致。，火候宁小勿大，慢慢推进。",
      "visual_cue": "料面齐平，颜色分明"
    },
    {
      "n": 8,
      "text": "倒清水没过食材，大火煮开。，注意锅里温度别掉下来。",
      "time_min": 6,
      "heat": "大火",
      "tip": "煮开撇沫，汤才清。，始终中小火，别心急。",
      "visual_cue": "汤面翻涌，浮沫上浮"
    },
    {
      "n": 9,
      "text": "小火盖盖炖一小时，中途翻两次。，火要均匀，食材才不糊。",
      "time_min": 65,
      "heat": "小火",
      "tip": "小火慢炖，羊肉才软。，看住火，别让它失控。",
      "visual_cue": "肉一戳就离骨，成败就在这一步。"
    },
    {
      "n": 10,
      "text": "加盐、黑胡椒和柠檬汁，开中火收汁十分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "柠檬后放，酸香才鲜。，全程留意火候，别贪快。",
      "visual_cue": "汤汁浓稠，油光浮动"
    },
    {
      "n": 11,
      "text": "撒香菜碎，趁热盛盘。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香菜提香，别久煮。，火别开太大，稳着来。",
      "visual_cue": "颜色鲜绿，香气扑鼻"
    }
  ],
  "tips": [
    "鹰嘴豆泡足八小时，才不会硬心。，这点要注意。",
    "香料要炒出油色，味道才足。，这是关键点。",
    "柠檬汁最后加，酸香才干净。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "鹰嘴豆没泡开，炖不软。，这一步别省。",
    "火大汤干，肉还没烂。，别跳过这步。",
    "盐放太早，羊肉发紧。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "700 克:700 克",
      "note": "炖的时间需加十五分钟。"
    },
    {
      "original": "鹰嘴豆",
      "substitute": "红腰豆",
      "ratio": "250 克:250 克",
      "note": "无需长泡，炖四十分钟即可。"
    }
  ],
  "variations": [
    "加西葫芦最后炖十五分钟，更清爽。",
    "撒一点辣椒粉，味道更冲。，很多人在这里出错。"
  ],
  "serving_suggestion": "配库斯库斯或厚面包，连汤浇上。，这里最容易翻车。",
  "storage": "冷藏三天，复热加少量水。，别小看这一步。",
