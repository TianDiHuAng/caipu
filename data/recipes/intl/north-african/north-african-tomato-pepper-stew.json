    "刀",
    "砧板",
    "锅铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青椒去籽切成两厘米见方的块，番茄切成同样大小的块备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "块切得大小一致，炖的时候受热才均匀。",
      "visual_cue": "青椒与番茄块大小接近"
    },
    {
      "n": 2,
      "text": "洋葱切小丁，大蒜切末，香菜切碎，熟鹰嘴豆沥干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香菜梗和叶分开切，梗早放叶最后撒。",
      "visual_cue": "洋葱丁细小，香菜分两份"
    },
    {
      "n": 3,
      "text": "炒锅倒橄榄油下洋葱丁中火炒五分种至软塌透明。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味才能撑起整道菜。",
      "visual_cue": "洋葱透明软塌，锅底泛油光"
    },
    {
      "n": 4,
      "text": "加蒜末、孜然、红椒粉和辣椒粉小火炒一分钟出香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香料小火炒，火大立刻发苦。",
      "visual_cue": "香料均匀裹在洋葱上，香气浓"
    },
    {
      "n": 5,
      "text": "下青椒块中火炒五分钟，炒到表皮起皱、边缘略焦。",
      "time_min": 6,
      "heat": "中火",
      "tip": "青椒炒到起皱，那股焦香是这道菜的灵魂。",
      "visual_cue": "青椒表皮起皱，边缘微焦"
    },
    {
      "n": 6,
      "text": "倒入番茄块和熟鹰嘴豆，加盐与黑胡椒翻匀后盖盖小火炖二十分钟。",
      "time_min": 23,
      "heat": "小火",
      "tip": "盖盖小火炖，番茄出汁后菜才不会干。",
      "visual_cue": "番茄化开成汁，青椒软塌"
    },
    {
      "n": 7,
      "text": "开盖中火收汁五分钟，收到汤汁浓稠、菜面泛红油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "收汁到油从番茄里渗出来，味道最集中。",
      "visual_cue": "汤汁浓稠红亮，表面泛油"
    },
    {
      "n": 8,
      "text": "关火撒香菜碎，拌两下装盘，温热或放凉吃都行。",
      "time_min": 2,
      "heat": "无火",
      "tip": "放凉后味道更融合，夏天当凉菜也好。",
      "visual_cue": "撒满绿色香菜，红油清亮"
    }
  ],
  "tips": [
    "青椒炒到起皱微焦，焦香是这道菜的灵魂。",
    "番茄和青椒切同样大小，受热才均匀。",
    "盖盖小火慢炖，番茄化开汤汁才浓。",
    "收汁到表面泛出红油，味道最集中。"
  ],
  "common_mistakes": [
    "青椒只炒两分钟就加水，脆生生的没有焦香。",
    "番茄切太碎，一炖就变成一锅汤。",
    "大火收汁不搅动，锅底糊一层焦味。",
    "香菜一开始就下锅，煮完颜色发黑发苦。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "250克:250克",
      "note": "不辣版本，甜味更突出。"
    },
    {
      "original": "鹰嘴豆",
      "substitute": "白芸豆",
      "ratio": "100克:100克",
      "note": "口感更绵密，需提前煮熟。"
    }
  ],
  "variations": [
    "加两个煎蛋铺在上面，做成一顿正餐。",
    "撒一把黑橄榄，咸香层次更丰富。",
    "把菜捣成粗泥，做成蘸酱配烤饼吃。"
  ],
  "serving_suggestion": "盛在浅盘里，配烤饼或米饭，冷吃热吃都合适，夏天配冰镇酸奶最舒服。",
  "storage": "冷藏可放四天，风味会越来越融合，食用前回温或直接冷食。",
