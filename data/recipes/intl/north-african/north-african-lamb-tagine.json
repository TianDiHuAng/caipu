  "equipment": [
    "厚底炖锅",
    "炒锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉块用厨房纸吸干血水，撒四克盐和黑胡椒抓匀，静置十五分钟入味。",
      "time_min": 17,
      "heat": "无火",
      "tip": "羊肉表面一定要干，否则下锅只出水不上色。",
      "visual_cue": "羊肉表面干爽，盐粒均匀附着"
    },
    {
      "n": 2,
      "text": "厚底锅放橄榄油烧热，羊肉分批下锅煎到各面深褐，取出备用。",
      "time_min": 12,
      "heat": "中火",
      "tip": "分批煎才煎得出焦层，一次挤满锅就变成水煮羊肉。",
      "visual_cue": "羊肉块表面焦褐，锅底留深色焦层"
    },
    {
      "n": 3,
      "text": "下洋葱丝炒软，加生姜末、蒜末、孜然粉和肉桂炒出香味，再放番茄块炒到出汁。",
      "time_min": 8,
      "heat": "中火",
      "tip": "香料必须在油里炒过才出香，直接撒进汤里味道发闷。",
      "visual_cue": "洋葱透明，番茄化成汁状，香料味上扬"
    },
    {
      "n": 4,
      "text": "羊肉回锅，倒高汤没过食材，加泡好的鹰嘴豆煮开后转小火盖盖炖七十分钟。",
      "time_min": 72,
      "heat": "小火",
      "tip": "液面只需微微冒泡，滚沸会让羊肉纤维发柴。",
      "visual_cue": "汤汁呈红褐色，羊肉用筷子一夹即软"
    },
    {
      "n": 5,
      "text": "开盖加蜂蜜和余下四克盐，转中火收汁十五分钟至浓稠。",
      "time_min": 16,
      "heat": "中火",
      "tip": "蜂蜜最后放，久煮会失去花香只留甜味。",
      "visual_cue": "酱汁浓稠挂勺，油脂浮在表面呈金色"
    },
    {
      "n": 6,
      "text": "盛出后撒烘香的杏仁和香菜碎，趁热配蒸粗麦粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "杏仁一定最后撒，提前放会吸汁变软。",
      "visual_cue": "表面点缀金黄色杏仁与翠绿香菜"
    }
  ],
  "tips": [
    "羊肉选肩肉或颈肉，带筋膜的部位久炖后更润口。",
    "香料可依喜好加藏红花或橙皮，北非家庭各有配方。",
    "隔夜复热风味更浓，酱汁也更黏稠。"
  ],
  "common_mistakes": [
    "羊肉没擦干就下锅，煎不出焦香且汤汁发腥。",
    "香料与番茄一起下，炒不出香气层次。",
    "全程大火滚炖，鹰嘴豆碎烂成泥、羊肉散成丝。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "800 克:800 克",
      "note": "牛肋条更合适，炖煮时间延长十分钟。"
    },
    {
      "original": "鹰嘴豆",
      "substitute": "白芸豆",
      "ratio": "150 克:150 克",
      "note": "需同样提前泡发，口感更绵。"
    }
  ],
  "variations": [
    "加入腌渍柠檬和绿橄榄，可做摩洛哥经典的酸香版本。"
  ],
  "serving_suggestion": "配蒸粗麦粉或薄饼，用面包蘸酱汁吃。",
  "storage": "冷藏三天，冷冻两个月，复热时加少量高汤调稀。",
