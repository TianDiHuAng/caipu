  "steps": [
    {
      "n": 1,
      "text": "洋葱一半切碎，和牛肉末放一起，撒上黑胡椒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱切碎一点，丸子才不散。，火候宁小勿大，慢慢推进。",
      "visual_cue": "洋葱细碎，肉末松散"
    },
    {
      "n": 2,
      "text": "加孜然、辣椒粉、盐和一半香菜抓匀。，注意锅里温度别掉下来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "抓到发黏，丸子才有弹性。，始终中小火，别心急。",
      "visual_cue": "肉馅起胶，能抱团，很多人在这里出错。"
    },
    {
      "n": 3,
      "text": "搓成三厘米小丸子，冷藏十分钟。，火要均匀，食材才不糊。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏定型，煎时不易散。，看住火，别让它失控。",
      "visual_cue": "丸子圆整，表面紧实"
    },
    {
      "n": 4,
      "text": "厚底锅倒橄榄油，丸子煎到表面变色。，全程留意火候，别贪快。",
      "time_min": 7,
      "heat": "中火",
      "tip": "煎定型就够，里面还会炖。，火大了就离锅远一点。",
      "visual_cue": "表面焦褐，形状完整"
    },
    {
      "n": 5,
      "text": "盛出丸子，余油炒洋葱丁和蒜末。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒透，汤才甜。，锅温要匀，别忽高忽低。",
      "visual_cue": "洋葱透明，油色发亮"
    },
    {
      "n": 6,
      "text": "下番茄块炒十分钟到软烂出汁。，火力保持中等，慢慢来。",
      "time_min": 12,
      "heat": "中火",
      "tip": "番茄炒散，汤底才浓。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤汁渗出，颜色深红"
    },
    {
      "n": 7,
      "text": "加清水煮开，放回丸子小火炖十五分钟。，注意锅里温度别掉下来。",
      "time_min": 18,
      "heat": "小火",
      "tip": "小火炖，丸子才不散。，始终中小火，别心急。",
      "visual_cue": "汤面微沸，丸子饱满"
    },
    {
      "n": 8,
      "text": "打入鸡蛋，盖盖焖六分钟到蛋白凝固。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "小火",
      "tip": "蛋要全熟，蛋白必须凝固。，看住火，别让它失控。",
      "visual_cue": "蛋白雪白，蛋黄微凝"
    },
    {
      "n": 9,
      "text": "撒余下香菜，尝味补盐上桌。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后调，汤才不咸。，火大了就离锅远一点。",
      "visual_cue": "汤色红亮，香气扑鼻"
    }
  ],
  "tips": [
    "肉馅抓出黏性，丸子才不散。，这里最容易翻车。",
    "丸子先煎定型，炖时不碎。，别小看这一步。",
    "鸡蛋要焖到全熟。，成败就在这一步。"
  ],
  "common_mistakes": [
    "肉馅没抓黏，下锅就散。，这点要注意。",
    "大火炖，丸子滚碎。，这是关键点。",
    "鸡蛋没焖透，蛋黄还是生的。，别嫌麻烦，做完它。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "羊肉末",
      "ratio": "600 克:600 克",
      "note": "风味更重，需多加孜然两克。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鹰嘴豆",
      "ratio": "200 克:200 克",
      "note": "需提前泡发并多炖十分钟。"
    }
  ],
  "variations": [
    "加青椒块同炖，味道更清。，这一步别省。",
    "上面撒奶酪碎，烤到融化。，别跳过这步。"
  ],
  "serving_suggestion": "配烤饼蘸汤，或配米饭。，这步最关键。",
  "storage": "冷藏两天，复热须煮透。，很多人在这里出错。",
