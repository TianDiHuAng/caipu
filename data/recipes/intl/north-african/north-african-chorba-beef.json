  "steps": [
    {
      "n": 1,
      "text": "牛肉切小丁，用盐和黑胡椒抓匀。，火要均匀，食材才不糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切小一点，熟得快。，看住火，别让它失控。",
      "visual_cue": "肉丁整齐，调料均匀"
    },
    {
      "n": 2,
      "text": "汤锅倒橄榄油，牛肉丁炒到变色。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "中火",
      "tip": "炒出焦香，汤才浓。，火大了就离锅远一点。",
      "visual_cue": "肉丁变色，锅底有香"
    },
    {
      "n": 3,
      "text": "下洋葱丁炒软，加孜然和红椒粉。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香料炒过，汤底才香。，锅温要匀，别忽高忽低。",
      "visual_cue": "洋葱透明，油色泛红"
    },
    {
      "n": 4,
      "text": "加番茄丁炒到出汁。，火力保持中等，慢慢来。，手法轻些，别弄散。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒出沙，汤才红亮。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汁水浓稠，颜色发红"
    },
    {
      "n": 5,
      "text": "倒清水，加扁豆大火煮开。，注意锅里温度别掉下来。",
      "time_min": 5,
      "heat": "大火",
      "tip": "煮开撇沫，汤才清。，始终中小火，别心急。",
      "visual_cue": "汤面翻涌，浮沫上浮"
    },
    {
      "n": 6,
      "text": "转小火煮二十五分钟，煮到扁豆变软。，火要均匀，食材才不糊。",
      "time_min": 27,
      "heat": "小火",
      "tip": "小火慢煮，豆才不破。，看住火，别让它失控。",
      "visual_cue": "豆粒软糯，汤色转浓"
    },
    {
      "n": 7,
      "text": "加胡萝卜丁和西葫芦丁，再煮十分钟。，全程留意火候，别贪快。",
      "time_min": 12,
      "heat": "小火",
      "tip": "后放蔬菜，口感才清。，火大了就离锅远一点。",
      "visual_cue": "蔬菜透亮，汤稠不糊"
    },
    {
      "n": 8,
      "text": "加鹰嘴豆和一半香菜欧芹，煮五分钟。，火别开太大，稳着来。",
      "time_min": 7,
      "heat": "小火",
      "tip": "香草分两次放，香气才有层。，锅温要匀，别忽高忽低。",
      "visual_cue": "汤色深红，香草浮面"
    },
    {
      "n": 9,
      "text": "加盐和柠檬汁调味，撒剩余香草。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后调酸，味道才立体。，火候宁小勿大，慢慢推进。",
      "visual_cue": "酸香清亮，油光浮动"
    }
  ],
  "tips": [
    "扁豆先煮软，再放其他蔬菜。，别小看这一步。",
    "香草分两次放，香气更有层。，成败就在这一步。",
    "柠檬汁最后加，酸味才干净。，这点要注意。"
  ],
  "common_mistakes": [
    "扁豆没煮软就放菜，口感分层。，这是关键点。",
    "火大汤浑，豆全碎。，别嫌麻烦，做完它。",
    "香草一次全放，煮久发黄。，这一步别省。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡腿肉",
      "ratio": "400 克:400 克",
      "note": "更清爽，煮的时间减五分钟。"
    },
    {
      "original": "扁豆",
      "substitute": "红腰豆",
      "ratio": "120 克:120 克",
      "note": "提前泡两小时，煮制更省时。"
    }
  ],
  "variations": [
    "加一小把细面条，汤更饱腹。，别跳过这步。",
    "加辣椒粉，味道更冲。，这步最关键。"
  ],
  "serving_suggestion": "配柠檬角和硬面包，趁热喝。，很多人在这里出错。",
  "storage": "冷藏三天，复热加少量水。，这里最容易翻车。",
