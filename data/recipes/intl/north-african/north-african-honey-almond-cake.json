    "打蛋器",
    "模具",
    "牙签",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "杏仁放进干锅小火烘五分钟，晾凉后用擀面杖擀成粗碎。",
      "time_min": 8,
      "heat": "小火",
      "tip": "烘过的杏仁香气翻倍，别烘到出油发黑。",
      "visual_cue": "杏仁微微泛油光，香气浓"
    },
    {
      "n": 2,
      "text": "面粉与泡打粉一起过筛，加肉桂粉和盐拌匀备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉类过筛两次，蛋糕组织才细腻不结块。",
      "visual_cue": "粉质蓬松，颜色均匀"
    },
    {
      "n": 3,
      "text": "黄油隔水融化后晾到微温，牛奶量好放室温回温。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油太烫会烫熟蛋液，微温最合适。",
      "visual_cue": "黄油澄亮无渣，温度不烫手"
    },
    {
      "n": 4,
      "text": "鸡蛋加白糖打发至颜色发白、体积膨胀三倍，提起有纹路。",
      "time_min": 9,
      "heat": "无火",
      "tip": "打发到划痕能停留三秒，蛋糕才蓬松。",
      "visual_cue": "蛋糊乳白浓稠，划痕缓慢消失"
    },
    {
      "n": 5,
      "text": "分三次把粉类筛进蛋糊，用刮刀从底部翻拌至无干粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "翻拌不要画圈，消泡了蛋糕就发硬。",
      "visual_cue": "面糊顺滑无干粉，体积略降"
    },
    {
      "n": 6,
      "text": "取一勺面糊与融化黄油拌匀，再倒回面糊里，加牛奶和杏仁碎翻匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先拌一小份黄油再合回，面糊不容易分离。",
      "visual_cue": "面糊光亮浓稠，杏仁分布均匀"
    },
    {
      "n": 7,
      "text": "模具刷黄油撒薄粉，倒入面糊抹平，轻震两下震出大气泡。",
      "time_min": 5,
      "heat": "无火",
      "tip": "震两下就够，震多了气泡全跑光也不蓬。",
      "visual_cue": "面糊平整，表面无大泡"
    },
    {
      "n": 8,
      "text": "烤箱预热一百七十度，烤三十五分钟，牙签插入无粘连即可出炉。",
      "time_min": 37,
      "heat": "无火",
      "tip": "牙签插中心拔出干净就熟了，别多烤会干。",
      "visual_cue": "表面金黄，牙签干燥无糊"
    },
    {
      "n": 9,
      "text": "小锅把蜂蜜小火加热到流动，趁热刷在蛋糕表面，晾凉脱模切块。",
      "time_min": 8,
      "heat": "小火",
      "tip": "蜂蜜加热到流动就行，煮沸会发酸。",
      "visual_cue": "表面亮晶晶挂一层蜜，切块整齐"
    }
  ],
  "tips": [
    "杏仁先烘过，香气比生杏仁浓一倍。",
    "粉类过筛两次，蛋糕组织才细腻。",
    "翻拌只从底部往上，画圈会消泡变硬。",
    "出炉趁热刷蜂蜜，光泽和保湿都更好。"
  ],
  "common_mistakes": [
    "黄油太烫直接倒进蛋糊，蛋液被烫出颗粒。",
    "翻拌时画圈猛搅，面糊消泡蛋糕发硬。",
    "烤到表面焦黑才发现没熟，中心还是湿的。",
    "蜂蜜煮到沸腾再刷，表面发酸还带苦。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "150克:150克",
      "note": "香气更浓，略带回苦。"
    },
    {
      "original": "蜂蜜",
      "substitute": "糖浆",
      "ratio": "120克:110克",
      "note": "甜度相近，光泽略差。"
    }
  ],
  "variations": [
    "面糊里加一勺橙皮屑，香气更清爽。",
    "表面撒几片杏仁片再烤，口感更脆。",
    "配一勺酸奶同吃，甜腻感会被压住。"
  ],
  "serving_suggestion": "晾凉后切块，配一杯薄荷茶或黑咖啡，是北非下午茶桌上最常见的一块甜点。",
  "storage": "密封常温可放三天，冷藏可放一周，食用前回温口感更松软。",
