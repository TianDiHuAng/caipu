  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 6,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 250,
          "unit": "ml",
          "note": "温水",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 20,
          "unit": "ml",
          "note": "揉面",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 15,
          "unit": "g",
          "note": "表面装饰",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "和面盆",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母放进温水中化开，静置五分钟让酵母先苏醒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水温摸着温不烫手最合适。",
      "visual_cue": "水面微浑，酵母化开"
    },
    {
      "n": 2,
      "text": "面粉加盐混匀，倒入酵母水和橄榄油，搅成面絮。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐先与面粉混合，别贴酵母。",
      "visual_cue": "面絮均匀，油被面粉吸收"
    },
    {
      "n": 3,
      "text": "揉成柔软的面团，在案板上揉八分钟到表面光洁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "揉到光滑，饼皮才不开裂。",
      "visual_cue": "面团光洁，手感有弹性"
    },
    {
      "n": 4,
      "text": "面团盖湿布放温暖处发酵一小时，到体积两倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "发到位，饼才松软不硬。",
      "visual_cue": "体积翻倍，内部有蜂窝"
    },
    {
      "n": 5,
      "text": "取出面团轻拍排气，分成四份，滚圆后醒十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "先滚圆再醒，擀时才不回缩。",
      "visual_cue": "四个圆球大小均匀"
    },
    {
      "n": 6,
      "text": "每份擀成半厘米厚的圆饼，表面刷水撒一层芝麻。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刷水芝麻才粘得住。",
      "visual_cue": "饼坯圆整，芝麻分布均匀"
    },
    {
      "n": 7,
      "text": "平底锅小火预热，不放油放入饼坯烙四分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "干锅烙，饼皮才有韧劲。",
      "visual_cue": "底面出现浅褐色斑点"
    },
    {
      "n": 8,
      "text": "翻面再烙四分钟，两面都上色后按压有回弹即可。",
      "time_min": 4,
      "heat": "小火",
      "tip": "勤翻面，受热均匀不上焦。",
      "visual_cue": "两面浅褐，按压回弹"
    },
    {
      "n": 9,
      "text": "出锅后用干净布包住保温，稍凉后撕开食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盖布保温，饼皮不发干。",
      "visual_cue": "饼身柔软，边缘略脆"
    }
  ],
  "tips": [
    "面团揉到光洁，烙出来的饼皮才不开裂。",
    "全程干锅小火烙，饼皮才有韧劲不发硬。",
    "出锅用布盖住，饼不会发干变硬。"
  ],
  "common_mistakes": [
    "面团太硬，烙好后又干又脆嚼不动。",
    "火开太大，表面焦黑里面还是生面。",
    "撒芝麻前没刷水，一翻面就全部掉光。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "全麦面粉",
      "ratio": "400 克:400 克",
      "note": "麦香更浓，水要多加二十毫升。"
    },
    {
      "original": "芝麻",
      "substitute": "孜然粒",
      "ratio": "15 克:8 克",
      "note": "香气更冲，配炖菜更合适。"
    }
  ],
  "variations": [
    "面团里加一勺孜然粉，风味更北非。",
    "擀好以后撒一层粗盐，咸香会更明显。"
  ],
  "serving_suggestion": "撕开蘸鹰嘴豆泥或配汤，当日常主食。",
  "storage": "密封室温一天、冷冻一个月，回热后食用。",
