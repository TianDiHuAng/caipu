    "木勺",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄底部划十字，开水烫后去皮切块。，全程留意火候，别贪快。",
      "time_min": 8,
      "heat": "大火",
      "tip": "去皮后酱才顺滑。，火大了就离锅远一点。",
      "visual_cue": "皮肉分离，轻松撕下"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油，炒洋葱和红椒到软。，火别开太大，稳着来。",
      "time_min": 8,
      "heat": "中火",
      "tip": "小火慢炒，甜味才出来。，锅温要匀，别忽高忽低。",
      "visual_cue": "洋葱透明，椒丁变软"
    },
    {
      "n": 3,
      "text": "加蒜末、孜然和辣椒粉炒香。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料遇油才出味，别炒糊。，火候宁小勿大，慢慢推进。",
      "visual_cue": "香气冲鼻，油色发红"
    },
    {
      "n": 4,
      "text": "下番茄块，中火煮十五分钟到浓稠。，注意锅里温度别掉下来。",
      "time_min": 17,
      "heat": "中火",
      "tip": "煮到铲子划过能见锅底。，始终中小火，别心急。",
      "visual_cue": "酱体浓稠，油酱分离"
    },
    {
      "n": 5,
      "text": "加盐和黑胡椒调味，尝一次咸淡。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "咸淡先调好，蛋下去就不好改。，看住火，别让它失控。",
      "visual_cue": "酱味鲜浓，咸度适中"
    },
    {
      "n": 6,
      "text": "用勺在酱里挖几个坑，打入鸡蛋。，全程留意火候，别贪快。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "坑挖深一点，蛋才不流。，火大了就离锅远一点。",
      "visual_cue": "酱面凹陷，蛋完整，这一步别省。"
    },
    {
      "n": 7,
      "text": "盖盖小火焖六分钟，蛋白凝固蛋黄半熟。，火别开太大，稳着来。",
      "time_min": 8,
      "heat": "小火",
      "tip": "火要小，蛋才嫩不焦底。，锅温要匀，别忽高忽低。",
      "visual_cue": "蛋白变白，蛋黄微颤"
    },
    {
      "n": 8,
      "text": "撒香菜，连锅端上桌。，火力保持中等，慢慢来。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，颜色才绿。，火候宁小勿大，慢慢推进。",
      "visual_cue": "表面翠绿，香气扑鼻"
    }
  ],
  "tips": [
    "番茄去皮，酱才顺滑。，别跳过这步。",
    "挖坑再打蛋，蛋形才完整。，这步最关键。",
    "小火焖，蛋白凝固蛋黄仍嫩。，很多人在这里出错。"
  ],
  "common_mistakes": [
    "火太大，锅底焦了蛋还没熟。，这里最容易翻车。",
    "酱太稀，蛋一打就流散。，别小看这一步。",
    "蛋煮过头，蛋黄发干。，成败就在这一步。"
  ],
  "substitutions": [
    {
      "original": "红椒",
      "substitute": "青椒",
      "ratio": "150 克:150 克",
      "note": "味道更清，甜度略低。"
    },
    {
      "original": "鸡蛋",
      "substitute": "豆腐",
      "ratio": "300 克:400 克",
      "note": "需先煎定型再入酱。"
    }
  ],
  "variations": [
    "加一勺哈里萨辣酱，辣味更冲。，这点要注意。",
    "最后撒奶酪碎，进烤箱烤三分钟。，这是关键点。"
  ],
  "serving_suggestion": "配热烤饼蘸酱，直接连锅上桌。，别嫌麻烦，做完它。",
  "storage": "冷藏一天，复热须煮透。，这一步别省。",
