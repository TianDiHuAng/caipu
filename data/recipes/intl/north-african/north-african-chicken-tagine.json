  "steps": [
    {
      "n": 1,
      "text": "藏红花用温水泡十分钟，水变金黄。，全程留意火候，别贪快。",
      "time_min": 10,
      "heat": "无火",
      "tip": "别用开水，香气会散掉。，火大了就离锅远一点。",
      "visual_cue": "水色橙黄，香气浮出"
    },
    {
      "n": 2,
      "text": "鸡腿肉用盐、黑胡椒和姜末抹匀。，火别开太大，稳着来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "抹匀后静置，味道才进肉。，锅温要匀，别忽高忽低。",
      "visual_cue": "鸡皮微湿，调味均匀"
    },
    {
      "n": 3,
      "text": "厚底锅倒橄榄油，鸡皮朝下煎到金黄。，火力保持中等，慢慢来。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸡皮朝下先煎，油才香。，火候宁小勿大，慢慢推进。",
      "visual_cue": "鸡皮焦黄，锅底有焦香"
    },
    {
      "n": 4,
      "text": "翻面再煎两分钟，盛出备用。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "中火",
      "tip": "煎定型就够，别煎过头。，始终中小火，别心急。",
      "visual_cue": "两面金黄，肉汁锁住"
    },
    {
      "n": 5,
      "text": "余油炒洋葱丝，小火炒到软甜。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "小火",
      "tip": "小火慢炒，洋葱才不焦。，看住火，别让它失控。",
      "visual_cue": "洋葱软塌，颜色金黄"
    },
    {
      "n": 6,
      "text": "加蒜末和孜然粉炒香，倒藏红花水。，全程留意火候，别贪快。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料遇油才释放香气。，火大了就离锅远一点。",
      "visual_cue": "香气冲鼻，汤汁发黄"
    },
    {
      "n": 7,
      "text": "放回鸡块，加清水，小火炖三十五分钟。，火别开太大，稳着来。",
      "time_min": 40,
      "heat": "小火",
      "tip": "小火慢炖，肉才酥不柴。，锅温要匀，别忽高忽低。",
      "visual_cue": "汤面微沸，香气浓郁"
    },
    {
      "n": 8,
      "text": "加橄榄和柠檬片，再炖十分钟。，火力保持中等，慢慢来。",
      "time_min": 12,
      "heat": "小火",
      "tip": "橄榄后放，才不会过咸。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤色深黄，油光浮面"
    },
    {
      "n": 9,
      "text": "挤入柠檬汁，撒香菜，尝味补盐。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬关火后挤，酸香才鲜。，始终中小火，别心急。",
      "visual_cue": "汤汁浓稠，香菜翠绿"
    }
  ],
  "tips": [
    "鸡皮先煎黄，汤才够香。，这里最容易翻车。",
    "藏红花温水泡，颜色才出。，别小看这一步。",
    "柠檬最后挤，酸香不挥发。，成败就在这一步。"
  ],
  "common_mistakes": [
    "大火炖，鸡肉缩成硬块。，这点要注意。",
    "藏红花放太多，发苦。，这是关键点。",
    "橄榄久煮，汤咸得发苦。，别嫌麻烦，做完它。"
  ],
  "substitutions": [
    {
      "original": "橄榄",
      "substitute": "绿葡萄干",
      "ratio": "80 克:60 克",
      "note": "甜味更突出，需减盐一克。"
    },
    {
      "original": "藏红花",
      "substitute": "辣椒粉",
      "ratio": "1 克:3 克",
      "note": "颜色相近，少了花香。"
    }
  ],
  "variations": [
    "加土豆块同炖，汤汁更稠。，这一步别省。",
    "用腌柠檬替鲜柠檬，风味更浓。，别跳过这步。"
  ],
  "serving_suggestion": "配烤饼或小米饭，浇汤汁。，这步最关键。",
  "storage": "冷藏三天，冷冻一个月。，很多人在这里出错。",
