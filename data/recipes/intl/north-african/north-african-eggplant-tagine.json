  "steps": [
    {
      "n": 1,
      "text": "茄子切两厘米厚片，撒盐静置十分钟。，锅温要匀，别忽高忽低。",
      "time_min": 12,
      "heat": "无火",
      "tip": "撒盐出水，煎时不吸油。，火力保持中等，慢慢来。",
      "visual_cue": "表面见水珠，茄肉变软"
    },
    {
      "n": 2,
      "text": "茄子擦干，平底锅少油煎两面。，火候宁小勿大，慢慢推进。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煎到定型再炖，才不烂。，注意锅里温度别掉下来。",
      "visual_cue": "两面微焦，茄身挺立"
    },
    {
      "n": 3,
      "text": "炖锅倒橄榄油，炒洋葱丝到软。，始终中小火，别心急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒软，汤才甜。，火要均匀，食材才不糊。",
      "visual_cue": "洋葱透明，香气散出"
    },
    {
      "n": 4,
      "text": "加蒜末、孜然和红椒粉炒香。，看住火，别让它失控。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "香料遇油，味道才开。，全程留意火候，别贪快。",
      "visual_cue": "油色泛红，香气浓郁"
    },
    {
      "n": 5,
      "text": "下番茄丁炒到出汁变稠。，火大了就离锅远一点。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒出沙，汤才浓。，火别开太大，稳着来。",
      "visual_cue": "汁水红亮，皮卷起，这是关键点。"
    },
    {
      "n": 6,
      "text": "加鹰嘴豆和清水，煮开转小火。，锅温要匀，别忽高忽低。",
      "time_min": 5,
      "heat": "大火",
      "tip": "先煮豆，才入味。，火力保持中等，慢慢来。",
      "visual_cue": "汤面翻涌，豆粒浮沉"
    },
    {
      "n": 7,
      "text": "铺入煎好的茄子片，盖盖炖二十分钟。，火候宁小勿大，慢慢推进。",
      "time_min": 22,
      "heat": "小火",
      "tip": "茄子铺上面，才不会压烂。，注意锅里温度别掉下来。",
      "visual_cue": "茄片软塌，汤汁浓稠"
    },
    {
      "n": 8,
      "text": "加盐、黑胡椒和柠檬汁调味，尝一次咸淡是否合适。",
      "time_min": 2,
      "heat": "小火",
      "tip": "柠檬后放，酸香才清。，始终中小火，别心急。",
      "visual_cue": "味道酸鲜，咸淡合适"
    },
    {
      "n": 9,
      "text": "撒香菜和薄荷碎，关火焖三分钟。，火要均匀，食材才不糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "关火焖，香草味才留。，看住火，别让它失控。",
      "visual_cue": "颜色鲜绿，香气上扬"
    }
  ],
  "tips": [
    "茄子先撒盐再煎，才不吸油。，别嫌麻烦，做完它。",
    "茄子铺上层，炖时才不烂。，这一步别省。",
    "柠檬汁最后加，酸香更干净。，别跳过这步。"
  ],
  "common_mistakes": [
    "茄子没煎，炖成一锅泥。，这步最关键。",
    "香料没炒，味道生涩。，很多人在这里出错。",
    "水加太多，汤成稀水。，这里最容易翻车。"
  ],
  "substitutions": [
    {
      "original": "鹰嘴豆",
      "substitute": "扁豆",
      "ratio": "200 克:200 克",
      "note": "需多炖十五分钟至软。"
    },
    {
      "original": "薄荷",
      "substitute": "欧芹",
      "ratio": "8 克:10 克",
      "note": "香气更清，用量可增。"
    }
  ],
  "variations": [
    "加羊肉块同炖，做成荤版。，别小看这一步。",
    "表面撒羊乳酪碎，奶香更足。，成败就在这一步。"
  ],
  "serving_suggestion": "配库斯库斯或面包，淋上汤汁。，这点要注意。",
  "storage": "冷藏三天，复热加少量水。，这是关键点。",
