  "steps": [
    {
      "n": 1,
      "text": "香菜切碎，大蒜切末，越细越好。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切得细，酱才挂得住鱼。，火大了就离锅远一点。",
      "visual_cue": "菜末细碎，蒜末均匀"
    },
    {
      "n": 2,
      "text": "香菜、蒜末、孜然粉和辣椒粉放碗里。，火别开太大，稳着来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香料先拌开，味道才匀。，锅温要匀，别忽高忽低。",
      "visual_cue": "混合均匀，颜色发绿"
    },
    {
      "n": 3,
      "text": "倒橄榄油和柠檬汁，搅成稠酱。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油慢慢倒，酱才乳化。，火候宁小勿大，慢慢推进。",
      "visual_cue": "酱体浓稠，油光发亮"
    },
    {
      "n": 4,
      "text": "加盐和黑胡椒调味，尝一次咸淡。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "咸淡要略淡，鱼还会出水。，始终中小火，别心急。",
      "visual_cue": "酱味鲜香，咸度适中"
    },
    {
      "n": 5,
      "text": "鳕鱼擦干水分，两面抹满香草酱。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼身擦干，酱才不滑落。，看住火，别让它失控。",
      "visual_cue": "鱼片挂酱，表面湿润"
    },
    {
      "n": 6,
      "text": "盖保鲜膜冷藏腌三十分钟。，全程留意火候，别贪快。",
      "time_min": 32,
      "heat": "无火",
      "tip": "腌够时间，香草味才进去。，火大了就离锅远一点。",
      "visual_cue": "鱼片紧实，酱色加深"
    },
    {
      "n": 7,
      "text": "烤盘铺锡纸，鱼片上面码红椒条。，火别开太大，稳着来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "红椒垫上，烤后带甜味。，锅温要匀，别忽高忽低。",
      "visual_cue": "鱼片整齐，红椒铺满"
    },
    {
      "n": 8,
      "text": "二百一十度烤十八分钟，表面微焦。，火力保持中等，慢慢来。",
      "time_min": 20,
      "heat": "无火",
      "tip": "鱼厚薄不同，最后几分钟看紧。，火候宁小勿大，慢慢推进。",
      "visual_cue": "鱼肉变白，椒条发软"
    },
    {
      "n": 9,
      "text": "出炉挤柠檬汁，撒一点香菜碎。，注意锅里温度别掉下来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后挤柠檬，酸香更清。，始终中小火，别心急。",
      "visual_cue": "鱼片油亮，香气扑鼻"
    }
  ],
  "tips": [
    "鱼身擦干，酱才挂得住。，这一步别省。",
    "腌够半小时，香草味才进肉。，别跳过这步。",
    "烤到鱼肉一按就散，别过头。，这步最关键。"
  ],
  "common_mistakes": [
    "鱼没擦干就抹酱，汁水一滩。，很多人在这里出错。",
    "烤太久，鱼肉发柴。，这里最容易翻车。",
    "柠檬放太早，鱼肉变硬。，别小看这一步。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "海鲈鱼",
      "ratio": "800 克:800 克",
      "note": "肉质更细，烤的时间减三分钟。"
    },
    {
      "original": "香菜",
      "substitute": "香芹",
      "ratio": "50 克:50 克",
      "note": "香气更清，少了刺激味。"
    }
  ],
  "variations": [
    "加一点白醋，酸味更冲。，成败就在这一步。",
    "配烤土豆块一起吃，分量更足。，这点要注意。"
  ],
  "serving_suggestion": "配烤饼和蔬菜沙拉，淋盘底汁。，这是关键点。",
  "storage": "冷藏一天，复烤五分钟。，别嫌麻烦，做完它。",
