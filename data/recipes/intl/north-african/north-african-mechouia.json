          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 40,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取汁",
          "optional": false
        },
        {
          "name": "孜然",
          "name_en": "cumin",
          "amount": 4,
