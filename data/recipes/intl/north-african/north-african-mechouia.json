          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 20,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "保鲜袋",
    "刀",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青椒和番茄洗净擦干，整个放在烤盘上摆好。",
      "time_min": 6,
      "heat": "无火",
      "tip": "擦干表面，烤的时候才起焦斑不流水。",
      "visual_cue": "表面干爽，摆放整齐"
    },
    {
      "n": 2,
      "text": "烤箱两百度烤二十五分钟，中途翻一次面到表皮起泡发黑。",
      "time_min": 26,
      "heat": "大火",
      "tip": "表皮烤到发黑才够香，别提早取出。",
      "visual_cue": "表皮起泡并大面积发黑"
    },
    {
      "n": 3,
      "text": "趁热把青椒装进保鲜袋扎紧，焖十分钟后撕掉外皮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "趁热封袋焖十分钟，皮一撕就掉不粘肉。",
      "visual_cue": "外皮轻松整片剥离"
    },
    {
      "n": 4,
      "text": "青椒去蒂去籽切成小丁，番茄也切成同样大小的丁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "青椒籽要去干净，否则沙拉发苦。",
      "visual_cue": "丁块大小均匀一致"
    },
    {
      "n": 5,
      "text": "把两种丁放进碗里，加入蒜末、孜然、盐和柠檬汁拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "大蒜末切得越细越好，生蒜味才不会抢。",
      "visual_cue": "颜色红绿分明好看"
    },
    {
      "n": 6,
      "text": "淋上橄榄油再拌一次，撒香菜末静置十分钟入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置十分钟，各种味道才融到一起。",
      "visual_cue": "表面油亮，汁水微出"
    }
  ],
  "tips": [
    "青椒要烤到表皮发黑，那股烟熏味才是这道菜的灵魂。",
    "趁热装袋焖十分钟，皮会很好撕。",
    "拌好后静置十分钟再吃，味道更融合。"
  ],
  "common_mistakes": [
    "表皮没烤到发黑，成品缺少烟熏香气。",
    "外皮没撕干净，吃起来有明显的硬纤维。",
    "番茄汁水没控干，拌完变成一汪汤水。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "400 克:400 克",
      "note": "辣度更低，甜味更明显。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "1 个:15 毫升",
      "note": "酸味更直接，香气略弱。"
    }
  ],
  "variations": [
    "加一个烤过的番茄，酸甜感更突出。",
    "拌入一小罐油浸金枪鱼，直接变成一道主食沙拉。"
  ],
  "serving_suggestion": "配烤面包或作为烤肉的配菜，是突尼斯餐桌上最常见的开胃沙拉。",
  "storage": "冷藏两天，食用前回温并补一点橄榄油，汁水多时先沥干。",
  "nutrition_estimate": {
    "basis": "每份约 200 克",
    "calories_kcal": 110,
