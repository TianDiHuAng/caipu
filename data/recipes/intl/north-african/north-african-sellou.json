  "equipment": [
    "平底锅",
    "搅拌机",
    "碗",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒进干锅，小火不停翻炒。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "小火",
      "tip": "不停翻，面粉才不糊。，火候要稳，别忽大忽小。",
      "visual_cue": "颜色微黄，香气像烤麦"
    },
    {
      "n": 2,
      "text": "炒到面粉发黄出香，倒出晾凉。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "晾凉再用，否则结块。，火候要稳，别忽大忽小。",
      "visual_cue": "粉体松散，温度不烫手"
    },
    {
      "n": 3,
      "text": "芝麻干锅炒香，晾凉备用。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "芝麻一跳就关火，容易糊。，火候要稳，别忽大忽小。",
      "visual_cue": "粒粒鼓起，香气散出"
    },
    {
      "n": 4,
      "text": "杏仁烤香，粗粗切碎。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "无火",
      "tip": "留些颗粒，口感才好。，火候要稳，别忽大忽小。",
      "visual_cue": "颗粒大小不一，这一点很关键。"
    },
    {
      "n": 5,
      "text": "把炒面粉、芝麻、杏仁、白糖和盐一起拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先拌干料，油才吸得匀。，火候要稳，别忽大忽小。",
      "visual_cue": "颜色均匀，无干粉，这一点很关键。"
    },
    {
      "n": 6,
      "text": "黄油融化，加蜂蜜搅匀成糖浆。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蜂蜜别煮开，香气会跑。，火候要稳，别忽大忽小。",
      "visual_cue": "糖浆顺滑，颜色琥珀"
    },
    {
      "n": 7,
      "text": "糖浆分次倒入干料，边倒边搓。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "用手搓，油才进得去。，火候要稳，别忽大忽小。",
      "visual_cue": "粉体抱团，能捏成块"
    },
    {
      "n": 8,
      "text": "搓到能捏成团，装入模具压实。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压紧一点，切时才不散。，火候要稳，别忽大忽小。",
      "visual_cue": "表面紧实，边缘平整"
    },
    {
      "n": 9,
      "text": "冷藏一小时定型，切块撒肉桂。，火候要稳，别忽大忽小。",
      "time_min": 64,
      "heat": "无火",
      "tip": "冷藏定型，切面才整。，火候要稳，别忽大忽小。",
      "visual_cue": "切面细密，香气浓郁"
    }
  ],
  "tips": [
    "面粉要小火慢炒，颜色才匀。，这一点很关键。",
    "糖浆分次加，才不结块。，这一点很关键。",
    "压紧再切，块形才完整。，这一点很关键。"
  ],
  "common_mistakes": [
    "火大面粉糊了，整锅发苦。，这一点很关键。",
    "糖浆一次倒入，结成一团。，这一点很关键。",
    "没压实，切时散成粉。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "150 克:150 克",
      "note": "香气更重，微苦回甘。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖糖浆",
      "ratio": "120 克:150 克",
      "note": "少了花香，需多加黄油十克。"
    }
  ],
  "variations": [
    "加一点橙皮屑，香气更清。，这一点很关键。",
    "做成小球，方便一口吃。，这一点很关键。"
  ],
  "serving_suggestion": "配薄荷茶，小口配着吃。，这一点很关键。",
  "storage": "密封常温一周，冷藏可存两周。，这一点很关键。",
