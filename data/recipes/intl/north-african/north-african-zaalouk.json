        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "木勺",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子去皮切成两厘米见方的丁，撒三克盐抓匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌出水分，茄子才不会吸太多油。",
      "visual_cue": "茄子表面渗出水珠，体积略缩"
    },
    {
      "n": 2,
      "text": "茄子挤掉多余水分，再用厨房纸吸干表面后备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "挤得越干，炒出来越香不油腻。",
      "visual_cue": "茄子干爽，按压有弹性"
    },
    {
      "n": 3,
      "text": "番茄顶部划十字，用开水烫三十秒后撕掉外皮切碎。",
      "time_min": 4,
      "heat": "中火",
      "tip": "去皮后口感更细腻。",
      "visual_cue": "番茄皮整片脱落，果肉软"
    },
    {
      "n": 4,
      "text": "平底锅倒一半橄榄油，中火炒洋葱丁三分钟至透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒透，甜味是这道菜的基础。",
      "visual_cue": "洋葱变软透明，锅里有甜香"
    },
    {
      "n": 5,
      "text": "加蒜末、孜然与辣椒粉，小火炒四十秒炒出香气。",
      "time_min": 1,
      "heat": "小火",
      "tip": "香料小火炒，糊了会发苦。",
      "visual_cue": "粉末散开，香气冲鼻"
    },
    {
      "n": 6,
      "text": "下茄子丁中火翻炒八分钟，炒到软塌并吸足油分。",
      "time_min": 8,
      "heat": "中火",
      "tip": "勤翻动，茄子容易粘锅底。",
      "visual_cue": "茄子软塌，颜色变深"
    },
    {
      "n": 7,
      "text": "倒入碎番茄，加剩下的橄榄油，中小火炖十五分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "慢炖到茄子完全散开，泥感才出来。",
      "visual_cue": "锅中冒小泡，茄子与番茄融在一起"
    },
    {
      "n": 8,
      "text": "用木勺把茄子压碎成粗泥，加盐调味再煮三分钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "留一点颗粒感，口感更好。",
      "visual_cue": "泥体浓稠，能堆起来不塌"
    },
    {
      "n": 9,
      "text": "关火拌入香菜碎，挤上柠檬汁，装盘放凉食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "放凉后风味更融合，温热吃也不错。",
      "visual_cue": "表面油亮，颜色红褐"
    }
  ],
  "tips": [
    "茄子先腌再挤水，是少吸油的关键。",
    "番茄一定要去皮，泥的口感才顺滑。",
    "关火后拌香菜和柠檬汁，香气最足。"
  ],
  "common_mistakes": [
    "茄子不腌直接下锅，吸走半锅油。",
    "番茄不去皮，泥里夹着一片片韧皮。",
    "香料炒糊了，整盘菜都带一股焦苦味。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "600 克:600 克",
      "note": "水分更多，炖制时间延长五分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "30 克:15 毫升",
      "note": "酸味更冲，用量减半。"
    }
  ],
  "variations": [
    "加一勺番茄膏，成品颜色会更红亮。",
    "拌入煮熟的鹰嘴豆，做成更有饱腹感的一盘。"
  ],
  "serving_suggestion": "配烤饼或面包蘸着吃，冷食热食都合适。",
  "storage": "冷藏三天，冷食风味最佳，复热需小火加热。",
