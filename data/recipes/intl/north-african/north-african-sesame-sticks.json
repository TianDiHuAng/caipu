      ]
    }
  ],
  "equipment": [
    "烤箱",
    "大碗",
    "案板",
    "擀面杖",
    "烤盘",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒进大碗，加酵母、白糖、盐和孜然拌匀，中间挖一个小坑。",
      "time_min": 7,
      "heat": "无火",
      "tip": "盐和酵母分开放，直接接触会抑制发酵。",
      "visual_cue": "粉料混合均匀，颜色一致"
    },
    {
      "n": 2,
      "text": "倒入清水和一半橄榄油，揉成光滑面团，盖布发至两倍大。",
      "time_min": 95,
      "heat": "无火",
      "tip": "揉到面团光滑不粘手，发一小时左右。",
      "visual_cue": "面团光滑有弹性，体积翻倍"
    },
    {
      "n": 3,
      "text": "发好的面团排气后分成十二份，滚圆盖布松弛十五分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "松弛到位，搓长条时才不回缩。",
      "visual_cue": "小面团圆润，按下去慢慢回弹"
    },
    {
      "n": 4,
      "text": "取一份搓成二十五厘米长的细条，粗细尽量均匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "搓的时候从中间往两头推，粗细才匀。",
      "visual_cue": "长条笔直均匀，表面光滑"
    },
    {
      "n": 5,
      "text": "长条表面刷一层橄榄油，在芝麻盘里滚一圈粘满芝麻。",
      "time_min": 6,
      "heat": "无火",
      "tip": "刷油再滚芝麻，芝麻才粘得牢不脱落。",
      "visual_cue": "长条满身芝麻，分布均匀"
    },
    {
      "n": 6,
      "text": "烤盘铺油纸摆上长条，间隔两厘米，静置十五分钟。",
      "time_min": 17,
      "heat": "无火",
      "tip": "留出间隔，烤的时候才不粘在一起。",
      "visual_cue": "长条略微膨胀，表面发亮"
    },
    {
      "n": 7,
      "text": "烤箱预热一百八十度，中层烤十八分钟至表面金黄酥脆。",
      "time_min": 20,
      "heat": "无火",
      "tip": "烤到掰开中间没有软芯，就是透了。",
      "visual_cue": "表面金黄，芝麻香气浓"
    }
  ],
  "tips": [
    "盐和酵母要分开拌，直接接触会抑制发酵。",
    "面团揉到光滑能拉出薄膜，口感才松脆。",
    "搓条时从中间往两头推，粗细才均匀。",
    "表面刷油再滚芝麻，芝麻才粘得牢。"
  ],
  "common_mistakes": [
    "面团没发好就搓条，烤出来又硬又实。",
    "长条粗细不匀，细的那头烤焦了粗的还软。",
    "不刷油直接滚芝麻，出炉后芝麻掉一半。",
    "烤盘上摆得太挤，烤完全粘成一整块。"
  ],
  "substitutions": [
    {
      "original": "芝麻",
      "substitute": "黑芝麻",
      "ratio": "60克:60克",
      "note": "颜色更深，香气略重。"
    },
    {
      "original": "孜然",
      "substitute": "茴香籽",
      "ratio": "3克:3克",
      "note": "香气更甜，适合配茶。"
    }
  ],
  "variations": [
    "表面撒一点粗盐，咸香味道更突出。",
    "面团里加一勺蜂蜜，回甘更明显。",
    "做成小圆环形状，烤制时间减三分钟。"
  ],
  "serving_suggestion": "晾到微温时配一杯薄荷茶，蘸着橄榄油或鹰嘴豆泥吃，是最常见的北非茶点。",
  "storage": "晾凉后装纸袋常温放三天，复烤一百六十度五分钟恢复酥脆。",
