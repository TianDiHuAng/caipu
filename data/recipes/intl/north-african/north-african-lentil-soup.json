  "equipment": [
    "汤锅",
    "木勺",
    "刀",
    "料理棒"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红扁豆用清水冲洗两遍，挑掉杂质后彻底沥干水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "红扁豆不用泡，冲净就能下锅。",
      "visual_cue": "豆粒洁净，水清不浑"
    },
    {
      "n": 2,
      "text": "汤锅下橄榄油，中火炒洋葱、胡萝卜与芹菜六分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "蔬菜炒软出甜味，汤底才不寡。",
      "visual_cue": "蔬菜软塌，锅底微焦香"
    },
    {
      "n": 3,
      "text": "加蒜末、孜然与姜黄，小火炒四十秒至香气散出。",
      "time_min": 2,
      "heat": "小火",
      "tip": "姜黄怕高温，炒久了会发苦。",
      "visual_cue": "锅中橙黄，香味冲鼻"
    },
    {
      "n": 4,
      "text": "下番茄块炒三分钟，边炒边压碎，让汁水渗出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出红油，汤色才亮。",
      "visual_cue": "番茄化成糊，油色橙红"
    },
    {
      "n": 5,
      "text": "倒入扁豆与高汤，煮开后转小火煮三十分钟。",
      "time_min": 32,
      "heat": "小火",
      "tip": "保持微沸，扁豆容易糊底要偶尔搅。",
      "visual_cue": "豆粒开花，汤体变稠"
    },
    {
      "n": 6,
      "text": "用料理棒打成细腻糊状，按喜好留一点颗粒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打之前先离火，避免热汤飞溅。",
      "visual_cue": "汤体顺滑，颜色橙黄"
    },
    {
      "n": 7,
      "text": "加盐与柠檬汁调定味道，撒香菜碎后趁热上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "柠檬汁最后加，酸香才明亮。",
      "visual_cue": "汤面油亮，香菜翠绿"
    }
  ],
  "tips": [
    "红扁豆比绿扁豆易烂，适合做浓汤。",
    "柠檬汁不可省，酸味能平衡豆腥。",
    "想更浓稠可以少放两百毫升高汤，口感更厚重。"
  ],
  "common_mistakes": [
    "扁豆没冲洗直接煮，汤面浮一层灰沫。",
    "姜黄下锅炒得太久，整锅汤都带苦味。",
    "煮时没搅动，锅底糊一层，汤带焦味。"
  ],
  "substitutions": [
    {
      "original": "红扁豆",
      "substitute": "绿扁豆",
      "ratio": "300 克:300 克",
      "note": "煮制时间延长十分钟，口感更有嚼头。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "1200 毫升:1200 毫升",
      "note": "需补少许盐与橄榄油提味。"
    }
  ],
  "variations": [
    "加一小把米饭同煮，汤体更稠厚。",
    "表面撒烤孜然与辣椒粉，做成更辛香的版本。"
  ],
  "serving_suggestion": "配烤面包块与柠檬角，热食，冬天可作主餐。",
  "storage": "冷藏四天、冷冻两个月；复热时加水调稀，边加热边搅。",
