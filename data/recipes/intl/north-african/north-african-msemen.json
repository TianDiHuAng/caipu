      ]
    }
  ],
  "equipment": [
    "盆",
    "平底锅",
    "擀面杖",
    "油刷"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和白糖拌匀，分次倒入二百六十毫升清水，揉成偏软的面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水要分三次倒，一次倒完很难揉匀。",
      "visual_cue": "面团成团，盆里无干粉"
    },
    {
      "n": 2,
      "text": "面团移到抹了植物油的案板，反复揉十分钟到表面光滑有弹性。",
      "time_min": 11,
      "heat": "无火",
      "tip": "揉到能拉出半透明的薄片，饼才有层次。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 3,
      "text": "面团分成八份滚圆，每份抹一层植物油，盖布醒二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "一定要抹油盖布，暴露在空气里会结皮。",
      "visual_cue": "面团柔软，按压不粘手"
    },
    {
      "n": 4,
      "text": "取一份面团用手压成薄片，尽量推得薄，刷一层融化黄油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "手推比擀更容易出层次，别用力压破。",
      "visual_cue": "薄片透光，边缘略卷"
    },
    {
      "n": 5,
      "text": "把薄片像折信纸一样折成方块，再轻轻压扁成一厘米厚。",
      "time_min": 5,
      "heat": "无火",
      "tip": "折叠时把四边往里收，层数才多。",
      "visual_cue": "方块整齐，边缘封住"
    },
    {
      "n": 6,
      "text": "平底锅中火烧热，不放油，把饼坯放进去烙三分钟到底面金黄。",
      "time_min": 4,
      "heat": "中火",
      "tip": "干锅烙，刷油就成煎饼了，层次会糊死。",
      "visual_cue": "底面金黄，鼓起小泡"
    },
    {
      "n": 7,
      "text": "翻面再烙三分钟，两面金黄后取出，趁热用手拍松。",
      "time_min": 4,
      "heat": "中火",
      "tip": "出锅趁热拍两下，层次立刻分开。",
      "visual_cue": "两面金黄，轻拍即散层"
    }
  ],
  "tips": [
    "面团要和得偏软，硬面团烙出来像死面饼。",
    "每层面片都刷黄油，这是出层次的关键。",
    "干锅不放油烙，饼皮才会起泡发脆。"
  ],
  "common_mistakes": [
    "面团揉得太硬，烙完咬不动也没层次。",
    "折叠时没锁边，下锅就散成一张饼。",
    "火太大，外面焦了中间还是生面。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "50 克:45 毫升",
      "note": "风味略淡，层次一样好。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "10 克:10 克",
      "note": "上色更快，注意别烙糊。"
    }
  ],
  "variations": [
    "面团里加一小勺孜然粉，香气更接近街头版本。",
    "折好后再擀薄一点，成品更像薄脆。"
  ],
  "serving_suggestion": "趁热撕开蘸蜂蜜吃，或者配一碗北非辣酱和橄榄油当早餐。",
  "storage": "常温密封一天，冷藏三天，复热用干锅两面各烙一分钟。",
