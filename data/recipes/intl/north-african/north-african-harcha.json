          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "碗",
    "擀面杖",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和白糖，拌匀。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐和糖先拌开，味道才匀。，火候要稳，别忽大忽小。",
      "visual_cue": "粉体均匀，无结块，这一点很关键。"
    },
    {
      "n": 2,
      "text": "倒入融化黄油，用手搓成粗砂状。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搓成砂粒，饼才酥。，火候要稳，别忽大忽小。",
      "visual_cue": "粉体松散，握团易散"
    },
    {
      "n": 3,
      "text": "分次加牛奶，拌成松散面团。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别过度揉，起筋就不酥。，火候要稳，别忽大忽小。",
      "visual_cue": "面团成团，表面粗糙"
    },
    {
      "n": 4,
      "text": "盖布静置二十分钟，让粉吃水。，火候要稳，别忽大忽小。",
      "time_min": 22,
      "heat": "无火",
      "tip": "静置到位，擀开才不裂。，火候要稳，别忽大忽小。",
      "visual_cue": "面团微润，按压成片"
    },
    {
      "n": 5,
      "text": "面团分成四份，搓圆压扁。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "厚度一致，煎时才同步。，火候要稳，别忽大忽小。",
      "visual_cue": "圆饼均匀，边缘整齐"
    },
    {
      "n": 6,
      "text": "用擀面杖擀成一厘米厚的圆饼。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别擀太薄，太薄就发硬。，火候要稳，别忽大忽小。",
      "visual_cue": "饼厚一致，表面平滑"
    },
    {
      "n": 7,
      "text": "平底锅刷薄薄一层橄榄油，中小火烙五分钟。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "中小火慢烙，里面才熟。，火候要稳，别忽大忽小。",
      "visual_cue": "底面金黄，饼身鼓起"
    },
    {
      "n": 8,
      "text": "翻面再烙四分钟，全程盖盖。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "盖盖烙，饼心才不发硬。，火候要稳，别忽大忽小。",
      "visual_cue": "两面金黄，按压回弹"
    },
    {
      "n": 9,
      "text": "出锅稍凉，切成楔形上桌。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "稍凉再切，形状才整。，火候要稳，别忽大忽小。",
      "visual_cue": "切口平整，层次分明"
    }
  ],
  "tips": [
    "黄油搓进面粉，饼才酥。，这一点很关键。",
    "别过度揉面，起筋就硬。，这一点很关键。",
    "中小火盖盖烙，里面才熟。，这一点很关键。"
  ],
  "common_mistakes": [
    "牛奶一次倒入，面团太湿。，这一点很关键。",
    "火太大，外焦内生。，这一点很关键。",
    "擀得太薄，吃起来像饼干。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "200 毫升:190 毫升",
      "note": "少了奶香，可加黄油十克。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "80 克:70 毫升",
      "note": "风味更清爽，酥度略减。"
    }
  ],
  "variations": [
    "加一点芝麻，香气更足。，这一点很关键。",
    "包入羊乳酪，做成有馅版。，这一点很关键。"
  ],
  "serving_suggestion": "趁热带吃，配蜂蜜或奶酪。，这一点很关键。",
  "storage": "冷藏两天，复烙三分钟。，这一点很关键。",
