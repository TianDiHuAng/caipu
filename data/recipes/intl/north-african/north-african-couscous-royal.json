  "steps": [
    {
      "n": 1,
      "text": "小米放碗里洒水搓匀，静置十分钟。，注意锅里温度别掉下来。",
      "time_min": 12,
      "heat": "无火",
      "tip": "洒水搓过，蒸后粒粒松。，始终中小火，别心急。",
      "visual_cue": "小米湿润，颗粒分开"
    },
    {
      "n": 2,
      "text": "鹰嘴豆提前泡四小时，沥干备用。，火要均匀，食材才不糊。",
      "time_min": 242,
      "heat": "无火",
      "tip": "泡够时间，蒸时才软。，看住火，别让它失控。",
      "visual_cue": "豆粒饱满，表皮舒展"
    },
    {
      "n": 3,
      "text": "蒸锅水烧开，小米铺纱布上蒸二十分钟。，全程留意火候，别贪快。",
      "time_min": 22,
      "heat": "大火",
      "tip": "铺薄一点，蒸汽才透。，火大了就离锅远一点。",
      "visual_cue": "米粒膨胀，松散不粘"
    },
    {
      "n": 4,
      "text": "取出洒水拨散，再回锅蒸十分钟。，火别开太大，稳着来。",
      "time_min": 12,
      "heat": "大火",
      "tip": "洒水回蒸，颗粒才蓬松。，锅温要匀，别忽高忽低。",
      "visual_cue": "米粒分离，手感轻，成败就在这一步。"
    },
    {
      "n": 5,
      "text": "另起锅倒橄榄油，炒洋葱到透明。，火力保持中等，慢慢来。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才出来。，火候宁小勿大，慢慢推进。",
      "visual_cue": "洋葱软塌，油色发亮"
    },
    {
      "n": 6,
      "text": "加姜末、孜然和辣椒粉炒香，下番茄炒软。，注意锅里温度别掉下来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香料先炒，汤底才够味。，始终中小火，别心急。",
      "visual_cue": "番茄散开，汤汁渗出"
    },
    {
      "n": 7,
      "text": "加清水、胡萝卜、南瓜和鹰嘴豆，小火炖二十五分钟。",
      "time_min": 27,
      "heat": "小火",
      "tip": "蔬菜切大小一致，才一起熟。，火要均匀，食材才不糊。",
      "visual_cue": "蔬菜软透，汤色橙红"
    },
    {
      "n": 8,
      "text": "加西葫芦再炖八分钟，加盐调味。，看住火，别让它失控。",
      "time_min": 10,
      "heat": "小火",
      "tip": "西葫芦易烂，后放。，全程留意火候，别贪快。",
      "visual_cue": "西葫芦半透明，仍成型"
    },
    {
      "n": 9,
      "text": "小米盛盘，浇上蔬菜和汤汁。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汤汁多浇一点，拌开才香。，火别开太大，稳着来。",
      "visual_cue": "米粒吸汤，颜色金黄"
    }
  ],
  "tips": [
    "小米搓水再蒸，颗粒才松。，这点要注意。",
    "分两次蒸，蓬松度更好。，这是关键点。",
    "西葫芦最后放，才不烂。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "小米直接下锅煮，黏成团。，这一步别省。",
    "一次蒸足时间不洒水，米粒发硬。，别跳过这步。",
    "蔬菜同时间下锅，软的烂硬的生。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "小米",
      "substitute": "大米",
      "ratio": "400 克:400 克",
      "note": "口感更糯，蒸的时间减五分钟。"
    },
    {
      "original": "鹰嘴豆",
      "substitute": "扁豆",
      "ratio": "150 克:150 克",
      "note": "炖的时间缩短十分钟。"
    }
  ],
  "variations": [
    "加羊肉块同炖，就是节庆版。，很多人在这里出错。",
    "撒葡萄干和烤杏仁，甜咸更丰富。，这里最容易翻车。"
  ],
  "serving_suggestion": "浇汤汁拌匀，配辣酱另加风味。，别小看这一步。",
  "storage": "冷藏两天，复蒸五分钟。，成败就在这一步。",
