  "steps": [
    {
      "n": 1,
      "text": "面粉加酵母、白糖和盐拌匀，倒入清水揉成偏软的面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面团偏软一点，烙出来才柔韧不干硬。",
      "visual_cue": "面团柔软略粘手，能拉出薄膜"
    },
    {
      "n": 2,
      "text": "面团盖布发四十五分钟，发到体积变大、表面出现小气泡。",
      "time_min": 47,
      "heat": "无火",
      "tip": "发到有气泡就行，不用等到完全两倍大。",
      "visual_cue": "体积明显变大，表面起小泡"
    },
    {
      "n": 3,
      "text": "香菜切碎，与辣椒粉、孜然、红椒粉和十毫升橄榄油拌成香料糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香料糊调稠一点，抹在面皮上才不流。",
      "visual_cue": "香料糊浓稠均匀，香气冲鼻"
    },
    {
      "n": 4,
      "text": "发好的面团分成六份，逐份擀成二十厘米的圆薄片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "擀得薄一些，烙出来才有层次不夹生。",
      "visual_cue": "面片薄透均匀，边缘圆整"
    },
    {
      "n": 5,
      "text": "面片抹一层香料糊，从一边卷成长条，再盘成螺旋状压扁。",
      "time_min": 9,
      "heat": "无火",
      "tip": "卷起来再盘，层次和香料才分布均匀。",
      "visual_cue": "螺旋紧实，饼坯圆整"
    },
    {
      "n": 6,
      "text": "把螺旋饼坯再擀成一厘米厚的圆饼，盖布醒十分钟。",
      "time_min": 13,
      "heat": "无火",
      "tip": "醒十分钟再烙，饼才不会回缩变形。",
      "visual_cue": "饼坯厚薄均匀，直径约十八厘米"
    },
    {
      "n": 7,
      "text": "平底锅刷橄榄油中小火烙三分钟，翻面再烙三分钟至两面金黄。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "中小火慢烙，里面才熟透外面不焦。",
      "visual_cue": "两面金黄带焦点，按压有弹性"
    },
    {
      "n": 8,
      "text": "出锅趁热刷一层橄榄油，盖布保湿，全部烙完切块上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热刷油盖上布，饼才会保持柔软。",
      "visual_cue": "表面油润，掰开层次分明"
    }
  ],
  "tips": [
    "面团偏软一点，烙出来才柔韧不发硬。",
    "香料糊要调稠，抹在面皮上才不流。",
    "卷起再盘成螺旋，饼才有层次感。",
    "烙好后盖布保湿，凉了也不会变硬。"
  ],
  "common_mistakes": [
    "面团太硬，擀的时候一直回缩擀不开。",
    "香料糊太稀，卷的时候全流到案板上。",
    "大火烙，外皮焦黑里面还是生面。",
    "烙完敞着放凉，饼很快就变干变硬。"
  ],
  "substitutions": [
    {
      "original": "辣椒粉",
      "substitute": "甜椒粉",
      "ratio": "6克:8克",
      "note": "做成不辣版本，颜色更红。"
    },
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "40毫升:40克",
      "note": "奶香更浓，需中小火防焦。"
    }
  ],
  "variations": [
    "里面夹一层碎奶酪，烙到融化更好吃。",
    "香菜换成薄荷同揉，香气会变得更清凉。",
    "做成小尺寸，当派对上的手指食物。"
  ],
  "serving_suggestion": "趁热切块，配一碗鹰嘴豆汤或酸奶，抹着吃或蘸着吃都很合适。",
  "storage": "常温密封放两天，复热用平底锅小火两面各一分钟，喷点水更柔软。",
