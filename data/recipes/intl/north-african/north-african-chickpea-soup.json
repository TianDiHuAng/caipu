  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆提前用清水浸泡八小时，泡到豆粒明显膨胀、表皮起皱。",
      "time_min": 480,
      "heat": "无火",
      "tip": "必须浸泡透，否则煮一小时还是硬芯。",
      "visual_cue": "豆粒胀大一倍，捏起来能压动"
    },
    {
      "n": 2,
      "text": "泡好的鹰嘴豆沥干，倒进汤锅加清水煮开后转小火煮四十分钟。",
      "time_min": 45,
      "heat": "小火",
      "tip": "先单独把豆煮到半软，再和蔬菜同煮更均匀。",
      "visual_cue": "豆粒变软但外形完整"
    },
    {
      "n": 3,
      "text": "洋葱切小丁，胡萝卜切细丁，大蒜切末，香菜切碎备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "胡萝卜切小一点，炖到后面会化进汤里。",
      "visual_cue": "各料切好分装，丁块均匀"
    },
    {
      "n": 4,
      "text": "另起锅倒橄榄油下洋葱丁中火炒五分钟至软塌微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒透出甜，汤的底味才厚实。",
      "visual_cue": "洋葱软塌微黄，锅底泛油"
    },
    {
      "n": 5,
      "text": "加蒜末、番茄膏、孜然和红椒粉小火炒两分钟至油色变红。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香料和番茄膏一起炒，香气才被激发出来。",
      "visual_cue": "锅底红油泛光，香料飘香"
    },
    {
      "n": 6,
      "text": "下番茄块与胡萝卜丁炒三分钟出汁，倒入煮过的鹰嘴豆连汤一起。",
      "time_min": 5,
      "heat": "中火",
      "tip": "豆子和汤一起倒，浓度才不会被稀释。",
      "visual_cue": "汤面翻滚，蔬菜浸在汤里"
    },
    {
      "n": 7,
      "text": "加盐、肉桂和黑胡椒，小火炖三十分钟至豆子软糯、汤汁变稠。",
      "time_min": 35,
      "heat": "小火",
      "tip": "小火慢炖，豆子才入味又不碎成泥。",
      "visual_cue": "豆子饱满软糯，汤汁浓稠"
    },
    {
      "n": 8,
      "text": "尝味补盐，关火撒香菜碎，盛碗后淋一点橄榄油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香菜关火后撒，清香才留得住。",
      "visual_cue": "汤面浮着绿色香菜，油光清亮"
    }
  ],
  "tips": [
    "鹰嘴豆必须泡足八小时，这是能炖烂的前提。",
    "豆子先单独煮到半软，再和番茄同炖更入味。",
    "香料和番茄膏一起下锅炒，香气才够浓。",
    "香菜关火再撒，清香不会被煮散。"
  ],
  "common_mistakes": [
    "豆子不泡直接煮，两小时中间还是硬的。",
    "水加太多，最后变成一锅清汤没有浓度。",
    "大火滚煮，豆皮全被煮破散在汤里。",
    "一开始就放盐，豆皮收紧，怎么炖都不软。"
  ],
  "substitutions": [
    {
      "original": "鹰嘴豆",
      "substitute": "白芸豆",
      "ratio": "200克:200克",
      "note": "口感更绵，泡发时间相同。"
    },
    {
      "original": "肉桂",
      "substitute": "豆蔻",
      "ratio": "2克:2克",
      "note": "香气更清，用量不可多。"
    }
  ],
  "variations": [
    "加一小勺辣椒粉同炖，辣味会更直接。",
    "最后挤几滴柠檬汁，酸味更清爽解腻。",
    "把汤打成糊，做成浓汤版本也一样好喝。"
  ],
  "serving_suggestion": "盛进深碗，配一块烤饼或面包蘸汤，最后挤几滴柠檬，冬天喝最暖。",
  "storage": "冷藏可放三天，复热加少量清水小火加热，边加热边搅动。",
