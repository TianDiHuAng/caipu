  },
  "servings": 4,
  "flavor": [
    "sweet",
    "sour",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "橙子",
          "name_en": "orange",
          "amount": 600,
          "unit": "g",
          "note": "约三个",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 60,
          "unit": "g",
          "note": "淋面",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 3,
          "unit": "g",
          "note": "磨粉",
          "optional": false
        },
        {
          "name": "杏仁",
          "name_en": "almond",
          "amount": 60,
          "unit": "g",
          "note": "烤香切片",
          "optional": false
        },
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 150,
          "unit": "g",
          "note": "原味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砧板",
    "小锅",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "橙子用盐搓洗外皮，冲净后擦干，去掉表面蜡质。",
      "time_min": 4,
      "heat": "无火",
      "tip": "搓洗能去掉果皮表面的蜡。",
      "visual_cue": "果皮干爽，闻着有橙香"
    },
    {
      "n": 2,
      "text": "切去橙子两端，顺着弧度把外皮与白膜完整削掉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "白膜去净，口感才不苦。",
      "visual_cue": "果肉外露，看不到白色筋膜"
    },
    {
      "n": 3,
      "text": "顺着瓣膜把橙肉一瓣瓣取出，尽量不留白色经络。",
      "time_min": 6,
      "heat": "无火",
      "tip": "沿膜下刀，果肉才完整。",
      "visual_cue": "橙瓣完整，无白膜残留"
    },
    {
      "n": 4,
      "text": "橙瓣放进碗里，淋上蜂蜜轻轻翻匀后静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置让果肉吸甜并出汁。",
      "visual_cue": "碗底积起橙色糖汁"
    },
    {
      "n": 5,
      "text": "杏仁放进干锅小火炒三分钟，炒到表面微黄出香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "小火慢炒，杏仁才不苦。",
      "visual_cue": "杏仁微黄，香气明显"
    },
    {
      "n": 6,
      "text": "炒好的杏仁放凉后切成薄片，留一部分整颗备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "放凉再切，切面才平整。",
      "visual_cue": "杏仁片均匀，边缘完整"
    },
    {
      "n": 7,
      "text": "橙瓣装盘，浇上碗底的蜂蜜橙汁，铺一层酸奶。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶铺薄薄一层就够。",
      "visual_cue": "颜色层次分明，汁水清亮"
    },
    {
      "n": 8,
      "text": "表面撒杏仁片与桂皮粉，冷藏二十分钟后食用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏后风味更融合。",
      "visual_cue": "桂皮粉均匀，果肉冰凉"
    }
  ],
  "tips": [
    "橙子外皮先用盐搓洗，能去掉表面蜡质。",
    "白膜一定去干净，否则整盘带苦味。",
    "桂皮粉最后撒，香气才不被果汁冲淡。"
  ],
  "common_mistakes": [
    "白膜没有去干净，吃起来会发苦发涩。",
    "蜂蜜一次倒太多，橙子泡在糖水里发软。",
    "提前几小时拌好，果肉出水变得松散。"
  ],
  "substitutions": [
    {
      "original": "橙子",
      "substitute": "血橙",
      "ratio": "600 克:600 克",
      "note": "颜色更红，酸甜更浓。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "60 克:50 克",
      "note": "甜味更直接，需提前拌到化开。"
    }
  ],
  "variations": [
    "加少许橙皮屑进去，香气会更加集中。",
    "撒一点肉桂与薄荷叶，清凉感更足。"
  ],
  "serving_suggestion": "冰镇之后当餐后甜点吃，清爽又解腻。",
  "storage": "冷藏一天之内吃完，密封保存避免串味。",
