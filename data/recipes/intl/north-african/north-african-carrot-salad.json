  "equipment": [
    "汤锅",
    "滤网",
    "拌菜盆",
    "刨丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "胡萝卜去皮切成八毫米厚的片，厚薄要尽量一致。",
      "time_min": 6,
      "heat": "无火",
      "tip": "厚薄一致，煮的时候熟度才均匀。",
      "visual_cue": "胡萝卜片厚薄均匀，边缘平整"
    },
    {
      "n": 2,
      "text": "汤锅烧开水加一点盐，下胡萝卜片煮八分钟至微软。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煮到能扎透但仍有脆感就停。",
      "visual_cue": "筷子能扎进去但有点阻力"
    },
    {
      "n": 3,
      "text": "捞出胡萝卜立刻过一遍冰水，锁住颜色和脆度。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过冰水是关键，不然会发软发暗。",
      "visual_cue": "胡萝卜颜色鲜亮，手感脆"
    },
    {
      "n": 4,
      "text": "沥干水分后放大碗里，趁微温加蒜泥与盐拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "微温时拌，味道更容易进去。",
      "visual_cue": "蒜泥均匀附着在胡萝卜上"
    },
    {
      "n": 5,
      "text": "孜然粒干锅小火炒四十秒，炒香后磨成细粉。",
      "time_min": 2,
      "heat": "小火",
      "tip": "现磨的孜然香气比粉强很多。",
      "visual_cue": "孜然粒颜色变深，香气冲鼻"
    },
    {
      "n": 6,
      "text": "拌入孜然粉、辣椒粉、白糖与柠檬汁，翻匀入味。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁先加一半，尝味再补。",
      "visual_cue": "胡萝卜表面湿润，颜色橙亮"
    },
    {
      "n": 7,
      "text": "淋入橄榄油拌匀，冷藏二十分钟让风味融合。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏后更清爽，味道也更融合。",
      "visual_cue": "表面泛油光，汁水清亮"
    },
    {
      "n": 8,
      "text": "上桌前撒香菜碎与薄荷碎，翻一下即可食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香草最后加，颜色和香气都保住。",
      "visual_cue": "表面点缀翠绿，色彩分明"
    }
  ],
  "tips": [
    "胡萝卜煮到微脆即捞出，过冰水保持口感。",
    "孜然现炒现磨，香气和粉完全不一样。",
    "冷藏二十分钟再吃，风味更融合。"
  ],
  "common_mistakes": [
    "胡萝卜煮到软烂，拌完就变成一团泥。",
    "捞出不过冰水，颜色发暗口感软。",
    "柠檬汁一次全加，酸得盖住甜味。"
  ],
  "substitutions": [
    {
      "original": "胡萝卜",
      "substitute": "南瓜",
      "ratio": "600 克:600 克",
      "note": "蒸熟即可，煮易烂。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "40 克:20 毫升",
      "note": "酸味更冲，用量减半。"
    }
  ],
  "variations": [
    "表面撒一把烤芝麻，坚果香气更明显。",
    "加一勺蜂蜜，做成偏甜的口味版本。"
  ],
  "serving_suggestion": "冷藏后作为前菜，配烤肉或炖菜一起吃。",
  "storage": "冷藏三天，风味会随时间更融合。",
