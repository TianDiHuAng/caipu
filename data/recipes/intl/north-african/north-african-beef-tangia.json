  "steps": [
    {
      "n": 1,
      "text": "牛肉切大块，用厨房纸吸干水分。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉块擦干，炖后才香。，看住火，别让它失控。",
      "visual_cue": "表面干爽，块形整齐"
    },
    {
      "n": 2,
      "text": "洋葱切丁，大蒜和姜擦成泥。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "无火",
      "tip": "姜蒜成泥，香气才透。，火大了就离锅远一点。",
      "visual_cue": "泥体细腻，无颗粒，这是关键点。"
    },
    {
      "n": 3,
      "text": "牛肉加孜然、姜黄、红椒粉和盐抓匀。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香料先抓匀，腌得才透。，锅温要匀，别忽高忽低。",
      "visual_cue": "肉块着色均匀，别嫌麻烦，做完它。"
    },
    {
      "n": 4,
      "text": "拌入洋葱丁、姜蒜泥和橄榄油。，火力保持中等，慢慢来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "油封住香料，炖时不散。，火候宁小勿大，慢慢推进。",
      "visual_cue": "表面油亮，香气扑鼻"
    },
    {
      "n": 5,
      "text": "倒入柠檬汁和清水，拌匀腌二十分钟。，注意锅里温度别掉下来。",
      "time_min": 22,
      "heat": "无火",
      "tip": "柠檬汁软化肉质，别省。，始终中小火，别心急。",
      "visual_cue": "汁水浑浊，香气酸鲜"
    },
    {
      "n": 6,
      "text": "连料带汁倒入厚重炖锅，压平。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "料要压实，受热才匀。，看住火，别让它失控。",
      "visual_cue": "表面平整，汁齐料面"
    },
    {
      "n": 7,
      "text": "盖锡纸再盖锅盖，封住缝隙。，全程留意火候，别贪快。",
      "time_min": 4,
      "heat": "无火",
      "tip": "双重封口，水汽才不跑。，火大了就离锅远一点。",
      "visual_cue": "边缘贴紧，盖子压严"
    },
    {
      "n": 8,
      "text": "小火慢炖两个半小时，中途不揭盖。，火别开太大，稳着来。",
      "time_min": 150,
      "heat": "小火",
      "tip": "中途揭盖，香气就散了。，锅温要匀，别忽高忽低。",
      "visual_cue": "锅壁冒气，盖子微响"
    },
    {
      "n": 9,
      "text": "揭盖撒黑胡椒，撇去浮油，再撒香菜和欧芹。",
      "time_min": 8,
      "heat": "小火",
      "tip": "香草最后撒，颜色才绿。，火力保持中等，慢慢来。",
      "visual_cue": "汤汁深褐，油光浮动"
    },
    {
      "n": 10,
      "text": "静置十分钟再盛盘，配库斯库斯趁热上桌吃。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置后肉汁回吸，更嫩。，火候宁小勿大，慢慢推进。",
      "visual_cue": "肉块完整，一戳即散"
    }
  ],
  "tips": [
    "小火慢炖，中途别揭盖。，这一步别省。",
    "香料先用油拌过，味道才进肉。，别跳过这步。",
    "撒一把新鲜香草，颜色才亮。，这步最关键。"
  ],
  "common_mistakes": [
    "火候太大，汁水烧干。，很多人在这里出错。",
    "香料放太早又被冲淡。，这里最容易翻车。",
    "牛肉切太小，炖成碎渣。，别小看这一步。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肩肉",
      "ratio": "800 克:800 克",
      "note": "风味更重，可加孜然两克。"
    },
    {
      "original": "姜黄",
      "substitute": "藏红花",
      "ratio": "4 克:0.2 克",
      "note": "香气更雅，成本更高。"
    }
  ],
  "variations": [
    "加鹰嘴豆同炖，口感更厚。，成败就在这一步。",
    "最后加橄榄同炖十分钟，酸香更足。"
  ],
  "serving_suggestion": "配库斯库斯或厚面包，连汁一起吃。",
  "storage": "冷藏三天，复热加少量水。，这点要注意。",
