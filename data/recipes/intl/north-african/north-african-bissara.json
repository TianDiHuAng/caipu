  "equipment": [
    "锅",
    "料理机",
    "木勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白豆提前泡四小时，搓掉外皮再冲洗干净，沥干水。",
      "time_min": 242,
      "heat": "无火",
      "tip": "去皮后汤才细白无渣。，注意锅里温度别掉下来。",
      "visual_cue": "豆粒白净，皮浮起，别嫌麻烦，做完它。"
    },
    {
      "n": 2,
      "text": "豆加清水大火煮开，撇掉浮沫。，始终中小火，别心急。",
      "time_min": 10,
      "heat": "大火",
      "tip": "浮沫撇净，汤才不浑。，火要均匀，食材才不糊。",
      "visual_cue": "汤面清亮，沫子聚边"
    },
    {
      "n": 3,
      "text": "转小火煮三十五分钟到豆子软烂。，看住火，别让它失控。",
      "time_min": 37,
      "heat": "小火",
      "tip": "煮到一压就碎，才好打泥。，全程留意火候，别贪快。",
      "visual_cue": "豆粒散开，汤变稠，这一步别省。"
    },
    {
      "n": 4,
      "text": "用料理机打成细腻豆糊。，火大了就离锅远一点。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打久一点，口感才顺滑。，火别开太大，稳着来。",
      "visual_cue": "泥体细白，无颗粒，别跳过这步。"
    },
    {
      "n": 5,
      "text": "倒回锅中小火加热，边加热边搅。，锅温要匀，别忽高忽低。",
      "time_min": 6,
      "heat": "小火",
      "tip": "不停搅，免得糊底。，火力保持中等，慢慢来。",
      "visual_cue": "汤体浓稠，冒小泡，这步最关键。"
    },
    {
      "n": 6,
      "text": "加盐、孜然粉和蒜末，搅匀后再煮两分钟尝味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "孜然是灵魂，别省。，火候宁小勿大，慢慢推进。",
      "visual_cue": "香气浮出，咸淡适中"
    },
    {
      "n": 7,
      "text": "盛碗淋橄榄油，撒辣椒粉。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油要淋在表面，颜色才亮。，始终中小火，别心急。",
      "visual_cue": "表面油光，红粉点缀"
    },
    {
      "n": 8,
      "text": "挤一点柠檬汁拌匀食用。，火要均匀，食材才不糊。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬提鲜，也解豆腥。，看住火，别让它失控。",
      "visual_cue": "汤色乳白，酸香清爽"
    }
  ],
  "tips": [
    "豆子去皮，汤才细白。，很多人在这里出错。",
    "边加热边搅，避免糊底。，这里最容易翻车。",
    "孜然和橄榄油是味道关键。，别小看这一步。"
  ],
  "common_mistakes": [
    "豆子没泡透，打泥仍有硬粒。，成败就在这一步。",
    "火大不搅，锅底焦糊。，这点要注意。",
    "盐放太早，豆子煮不烂。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "白豆",
      "substitute": "鹰嘴豆",
      "ratio": "400 克:400 克",
      "note": "煮的时间延长十分钟，质地更粉。"
    },
    {
      "original": "橄榄油",
      "substitute": "植物油",
      "ratio": "50 毫升:50 毫升",
      "note": "少了果香，可加蒜末两克。"
    }
  ],
  "variations": [
    "加一点香菜末，香气更清。，别嫌麻烦，做完它。",
    "配烤饼蘸着吃，是当地早餐吃法。，这一步别省。"
  ],
  "serving_suggestion": "热食配烤饼，或撒孜然粉加味。，别跳过这步。",
  "storage": "冷藏三天，冷冻一个月。，这步最关键。",
