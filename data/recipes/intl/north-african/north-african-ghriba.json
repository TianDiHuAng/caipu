  "equipment": [
    "烤箱",
    "大碗",
    "烤盘",
    "研磨机"
  ],
  "steps": [
    {
      "n": 1,
      "text": "杏仁铺在烤盘上，一百五十度烤八分钟到出香，取出放凉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "烤过的杏仁香气更浓，别烤到发黑。",
      "visual_cue": "杏仁表面微黄，香味明显"
    },
    {
      "n": 2,
      "text": "放凉的杏仁用研磨机打成粗粉，留出一小把做表面装饰。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打成粗粉即可，打成浆会出油结块。",
      "visual_cue": "杏仁粉松散不结团"
    },
    {
      "n": 3,
      "text": "大碗里混合杏仁粉、面粉、白糖、泡打粉、肉桂和盐。",
      "time_min": 6,
      "heat": "无火",
      "tip": "粉类先拌匀，后面加湿料才均匀。",
      "visual_cue": "干粉颜色均匀一致"
    },
    {
      "n": 4,
      "text": "加入融化的黄油和鸡蛋，用手抓成能捏合的面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面团一捏就合即可，不要反复揉。",
      "visual_cue": "面团成团，略松散"
    },
    {
      "n": 5,
      "text": "把面团分成十二份搓圆，轻轻压扁成厚约一厘米的小饼。",
      "time_min": 10,
      "heat": "无火",
      "tip": "按扁一点烤，中心才不会留空洞。",
      "visual_cue": "小饼厚薄一致，边缘圆润"
    },
    {
      "n": 6,
      "text": "小饼表面按上预留的杏仁碎，静置五分钟再进烤箱。",
      "time_min": 5,
      "heat": "无火",
      "tip": "表面按下杏仁碎，吃起来更香脆。",
      "visual_cue": "表面点缀杏仁碎粒"
    },
    {
      "n": 7,
      "text": "烤箱一百七十度预热，中层烤十八分钟到表面微微开裂。",
      "time_min": 20,
      "heat": "无火",
      "tip": "表面出现裂纹就是烤熟了的信号。",
      "visual_cue": "表面出现细裂纹路"
    }
  ],
  "tips": [
    "杏仁先烤香再磨粉，成品香气才足。",
    "面团一捏就合即可，反复揉会变硬。",
    "烤到表面微微开裂就是熟透的信号。"
  ],
  "common_mistakes": [
    "杏仁烤过了头，磨成粉带着焦苦味。",
    "面团揉得太久，烤出来又硬又实。",
    "小饼压得太薄，烤完又干又硬不酥。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "250 克:250 克",
      "note": "苦味略重，糖可加二十克。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "80 克:70 毫升",
      "note": "风味偏清淡。"
    }
  ],
  "variations": [
    "面团里加少许橙皮屑，香气更清新鲜活。",
    "表面撒少量粗糖，烤完会带一层脆壳。"
  ],
  "serving_suggestion": "配一杯薄荷茶，是摩洛哥和突尼斯家庭待客必备的小酥饼。",
  "storage": "密封常温五天，冷冻一个月；食用前用烤箱一百五十度回烤五分钟。",
