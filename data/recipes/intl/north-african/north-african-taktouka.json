  "steps": [
    {
      "n": 1,
      "text": "青椒去籽切成小丁，番茄也用刀切成同样大小的丁。",
      "time_min": 12,
      "heat": "无火",
      "tip": "青椒一定要去净籽，苦味多半来自这里。",
      "visual_cue": "丁块均匀，颜色分明"
    },
    {
      "n": 2,
      "text": "平底锅放植物油中火，下洋葱和大蒜炒到微微透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蒜末别炒到发黄，变黄就会带苦味。",
      "visual_cue": "洋葱透明，蒜香散出"
    },
    {
      "n": 3,
      "text": "倒入青椒丁翻炒十分钟，炒到青椒变软出香气。",
      "time_min": 11,
      "heat": "中火",
      "tip": "青椒要炒够时间，生青味才去得干净。",
      "visual_cue": "青椒变软，颜色转深"
    },
    {
      "n": 4,
      "text": "加番茄丁、辣椒粉和孜然，中火再炒八分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "番茄下锅之后会出水，火别开得太小。",
      "visual_cue": "番茄化开，汤汁收浓"
    },
    {
      "n": 5,
      "text": "加盐拌匀，盖上锅盖小火焖五分钟让味道融合。",
      "time_min": 6,
      "heat": "小火",
      "tip": "焖一会儿青椒和番茄的味道才融在一起。",
      "visual_cue": "汤汁浓稠，油色红亮"
    },
    {
      "n": 6,
      "text": "关火后撒上香菜碎，挤入柠檬汁拌匀再装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁关火之后再加，酸香才清爽。",
      "visual_cue": "表面油润，香气扑鼻"
    }
  ],
  "tips": [
    "青椒要炒够十分钟，生青味才去得干净。",
    "番茄下锅后不用加水，靠自身出汁就够。",
    "柠檬汁关火后再挤，香气清爽不散。"
  ],
  "common_mistakes": [
    "青椒没炒透就下番茄，成品带生青味。",
    "火太小慢慢煮，蔬菜变成一锅烂泥。",
    "盐放太早出水太多，汤汁稀薄没味道。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "甜椒",
      "ratio": "500 克:500 克",
      "note": "辣度降低，适合不吃辣的人。"
    },
    {
      "original": "孜然",
      "substitute": "芫荽籽",
      "ratio": "3 克:3 克",
      "note": "香气更清，磨粉后同炒。"
    }
  ],
  "variations": [
    "加一个烤过去皮的甜椒，烟熏味更明显。",
    "拌入一勺橄榄油冷食，做成夏季凉拌版本。"
  ],
  "serving_suggestion": "趁温热配一块北非扁面包或皮塔饼，是摩洛哥餐桌上最常见的开胃小菜。",
  "storage": "冷藏两天，风味第二天更融合；冷食或复热均可，不建议冷冻。",
