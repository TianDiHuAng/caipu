    "沙拉夹"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆提前泡发后煮至软糯，捞出沥干晾到温热。",
      "time_min": 45,
      "heat": "小火",
      "tip": "煮到捏一下能压碎就好，太烂拌起来会糊。",
      "visual_cue": "豆粒软糯完整，沥干不滴水"
    },
    {
      "n": 2,
      "text": "番茄去籽切成半厘米小丁，洋葱切成极细的末。",
      "time_min": 10,
      "heat": "无火",
      "tip": "番茄去籽才不会出水把沙拉泡稀。",
      "visual_cue": "番茄丁干净无籽，洋葱末细碎"
    },
    {
      "n": 3,
      "text": "香菜与薄荷切碎，柠檬挤汁，籽要去掉避免发苦。",
      "time_min": 6,
      "heat": "无火",
      "tip": "柠檬籽要去掉，压破会带出苦味。",
      "visual_cue": "香草细碎，柠檬汁清澈"
    },
    {
      "n": 4,
      "text": "小碗里倒橄榄油、柠檬汁，加孜然、盐、黑胡椒与红椒粉搅匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "搅到汁液微微乳化，香料才不会沉底。",
      "visual_cue": "沙拉汁微稠，香料分布均匀"
    },
    {
      "n": 5,
      "text": "大碗里放鹰嘴豆、番茄丁、洋葱末，淋上沙拉汁轻拌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻拌别压，鹰嘴豆压碎口感就糊了。",
      "visual_cue": "豆粒裹满汁，配料分布均匀"
    },
    {
      "n": 6,
      "text": "撒香菜与薄荷碎，拌匀后静置十分钟再上桌。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置十分钟入味，酸香会渗进豆子里。",
      "visual_cue": "表面撒满香草，颜色鲜亮"
    }
  ],
  "tips": [
    "鹰嘴豆煮到能捏碎即可，太烂拌起来会糊。",
    "番茄一定要去籽，否则沙拉很快出水。",
    "柠檬籽要去掉，压破会带出苦味。",
    "拌好后静置十分钟，味道渗进豆子更香。"
  ],
  "common_mistakes": [
    "鹰嘴豆煮得过烂，一拌就变成豆泥。",
    "番茄带籽切进去，半小时后碗底一层水。",
    "洋葱不切细，吃到大块辛辣冲鼻。",
    "拌完立刻吃，香料还没渗进豆子里。"
  ],
  "substitutions": [
    {
      "original": "鹰嘴豆",
      "substitute": "白芸豆",
      "ratio": "300克:300克",
      "note": "口感更绵，拌的时候更轻。"
    },
    {
      "original": "薄荷",
      "substitute": "罗勒",
      "ratio": "6克:6克",
      "note": "香气更柔，适合怕薄荷味的人。"
    }
  ],
  "variations": [
    "加一把黑橄榄同拌，咸香的味道会更足一些。",
    "撒一点碎奶酪进去，口感层次会更丰厚。",
    "加半根黄瓜切丁同拌，口感会更清爽一些。"
  ],
  "serving_suggestion": "冷藏半小时后盛出，配烤饼或烤肉，作为配菜或轻食主菜都很合适。",
  "storage": "冷藏可放两天，食用前倒掉积汁再拌一次，香草可重新撒。",
