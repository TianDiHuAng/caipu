  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆提前泡一夜至完全胀大，扁豆洗净沥干备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鹰嘴豆不泡透很难煮软，至少泡八小时。",
      "visual_cue": "豆子体积翻倍，掐开易碎"
    },
    {
      "n": 2,
      "text": "汤锅下橄榄油，炒香洋葱末与芹菜末至软身透明。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱芹菜炒透，汤底才有自然的甜味。",
      "visual_cue": "蔬菜软塌，锅中香气甜润"
    },
    {
      "n": 3,
      "text": "加蒜末、姜黄与桂皮炒半分钟，让香料裹上油。",
      "time_min": 2,
      "heat": "中火",
      "tip": "姜黄遇油才出色，汤色金黄全靠它。",
      "visual_cue": "锅中金黄，香料香浓"
    },
    {
      "n": 4,
      "text": "下番茄丁与番茄膏炒五分钟，炒到番茄完全塌软出红油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄要炒透，酸味才变柔和。",
      "visual_cue": "番茄化开成糊，油面泛红"
    },
    {
      "n": 5,
      "text": "倒高汤，加鹰嘴豆与扁豆，煮开后转小火炖三十五分钟。",
      "time_min": 37,
      "heat": "小火",
      "tip": "豆子要炖到一压就碎，汤才有浓稠感。",
      "visual_cue": "豆子软烂，汤色橙红浓稠"
    },
    {
      "n": 6,
      "text": "加盐与黑胡椒调定咸淡，挤入柠檬汁提亮酸味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "柠檬汁最后加，酸味清爽不发闷。",
      "visual_cue": "汤味酸香平衡，层次分明"
    },
    {
      "n": 7,
      "text": "关火撒香菜碎，静置五分钟让香气融合后盛碗。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香菜关火后撒，颜色翠绿香气足。",
      "visual_cue": "汤面浮香菜，质地浓稠挂勺"
    }
  ],
  "tips": [
    "番茄膏别省，它是汤浓稠发亮的关键。",
    "豆子炖到能压碎就够，太烂会成豆泥。",
    "想更饱腹可加一小把细面条同煮。"
  ],
  "common_mistakes": [
    "鹰嘴豆没泡就直接煮，两小时还是硬芯。",
    "番茄没炒透，汤带明显生番茄的酸涩。",
    "盐一次放太多，柠檬汁加完咸酸失衡。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "绿豆",
      "ratio": "150 克:150 克",
      "note": "更易煮烂，需提前十五分钟关火。"
    },
    {
      "original": "鹰嘴豆",
      "substitute": "白豆",
      "ratio": "200 克:200 克",
      "note": "口感更绵，泡发时间相同。"
    }
  ],
  "variations": [
    "加几块羊肉丁同炖，是斋月的丰盛版本。",
    "最后打入一个鸡蛋搅成蛋花，汤更浓。"
  ],
  "serving_suggestion": "配椰枣与烤面包同食，斋月开斋的第一道汤就是它。",
  "storage": "冷藏三天、冷冻一个月；复热加少许高汤稀释，因冷却后会明显变稠。",
