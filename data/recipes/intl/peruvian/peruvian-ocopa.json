  "equipment": [
    "蒸锅",
    "搅拌机",
    "平底锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆带皮蒸二十五分钟至叉子能轻松插入，取出稍凉后剥皮，切成两厘米厚片。",
      "time_min": 25,
      "heat": "中火",
      "tip": "带皮蒸不容易吸水，口感更粉。",
      "visual_cue": "土豆皮裂开，叉子一插到底"
    },
    {
      "n": 2,
      "text": "核桃用干锅小火烘四分钟至出香，搓掉外层薄皮。",
      "time_min": 4,
      "heat": "小火",
      "tip": "核桃皮带涩，去掉酱才顺滑。",
      "visual_cue": "核桃出油发亮，薄皮一搓就落"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油，下洋葱丝和蒜末小火炒六分钟至软甜。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒到甜，酱的底味才厚。",
      "visual_cue": "洋葱软塌透明，锅里有甜香"
    },
    {
      "n": 4,
      "text": "搅拌机里放核桃、奶酪、消化饼干、炒好的洋葱蒜、辣椒粉、盐和黑胡椒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "饼干是天然的增稠剂，别省。",
      "visual_cue": "材料堆在杯里，干湿分层"
    },
    {
      "n": 5,
      "text": "分次倒入牛奶打成浓稠糊状，尝味后补盐，质地要能挂在勺背上。",
      "time_min": 4,
      "heat": "无火",
      "tip": "牛奶慢慢加，太稀就回不去了。",
      "visual_cue": "酱体顺滑，勺子舀起缓慢流下"
    },
    {
      "n": 6,
      "text": "盘底铺生菜，土豆片叠放，浇上核桃酱，撒少量辣椒粉和黑胡椒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酱要盖住土豆，但边缘留出白色。",
      "visual_cue": "酱面平滑，点缀红椒粉"
    }
  ],
  "tips": [
    "没有黄心小土豆，用普通土豆蒸久一点也可。",
    "核桃酱可提前一天做好冷藏，上桌再浇。",
    "喜欢酸味可以加一勺青柠汁，能把坚果的油腻压下去。"
  ],
  "common_mistakes": [
    "土豆蒸完泡在水里，吸水后口感发水。",
    "核桃没有先烘干就直接打，酱里带一股生涩味。",
    "牛奶一次倒完，酱稀到挂不住土豆。"
  ],
  "substitutions": [
    {
      "original": "核桃",
      "substitute": "杏仁",
      "ratio": "100克:100克",
      "note": "香气更淡，可加一勺烘过的芝麻。"
    },
    {
      "original": "奶酪",
      "substitute": "羊乳酪",
      "ratio": "80克:80克",
      "note": "咸味更重，盐要减半。"
    }
  ],
  "variations": [
    "加一撮孜然粉，香气更接近安第斯山区版本。",
    "酱里拌入烤过的红椒，颜色更红亮，甜味也更足。"
  ],
  "serving_suggestion": "冷食上桌，配煮玉米和炸玉米粒，作为烧烤前的前菜。",
  "storage": "酱冷藏三天，土豆当天吃完；酱与土豆分开存放，上桌前再浇。",
