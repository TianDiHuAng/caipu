  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切块，用盐和黑胡椒略腌。，注意锅里温度别掉下来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腌十分钟就够，太久肉紧。，始终中小火，别心急。",
      "visual_cue": "肉块入味，表面微湿"
    },
    {
      "n": 2,
      "text": "香菜加半杯清水打成浓绿汁。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打细一点，汤色才翠。，看住火，别让它失控。",
      "visual_cue": "汁液浓绿，无粗渣，这步最关键。"
    },
    {
      "n": 3,
      "text": "锅里橄榄油炒香洋葱和蒜末。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "中火",
      "tip": "炒到洋葱透明，甜味才出。，火大了就离锅远一点。",
      "visual_cue": "洋葱软塌，香气升起"
    },
    {
      "n": 4,
      "text": "下鸡块煎到表面变白。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎到变色就好，别煎焦。，锅温要匀，别忽高忽低。",
      "visual_cue": "肉块发白，锅底微黄"
    },
    {
      "n": 5,
      "text": "加清水煮开，撇净浮沫。，火力保持中等，慢慢来。",
      "time_min": 12,
      "heat": "大火",
      "tip": "浮沫撇净，汤才清。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤面翻滚，浮沫成团"
    },
    {
      "n": 6,
      "text": "倒入大米和青椒丁，小火煮二十分钟。，注意锅里温度别掉下来。",
      "time_min": 22,
      "heat": "小火",
      "tip": "米煮开花，汤才稠。，始终中小火，别心急。",
      "visual_cue": "米粒开花，汤色发白"
    },
    {
      "n": 7,
      "text": "倒入香菜汁，再煮五分钟。，火要均匀，食材才不糊。",
      "time_min": 6,
      "heat": "小火",
      "tip": "香菜汁后放，颜色才鲜。，看住火，别让它失控。",
      "visual_cue": "汤色翠绿，香气浓郁"
    },
    {
      "n": 8,
      "text": "尝味补盐，盛碗趁热喝。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后调，米汤才好喝。，火大了就离锅远一点。",
      "visual_cue": "汤稠挂勺，绿意明显"
    }
  ],
  "tips": [
    "香菜汁最后放，颜色才不发黑。，很多人在这里出错。",
    "米多汤稠，喜欢稀一点就减米。，这里最容易翻车。",
    "小火慢煮，鸡肉才不柴。，别小看这一步。"
  ],
  "common_mistakes": [
    "香菜一开始就下锅，汤变土褐色。，成败就在这一步。",
    "大火滚煮，米汤溢锅。，这点要注意。",
    "鸡肉煮太久，撕成丝都散。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "700 克:700 克",
      "note": "煮的时间缩短五分钟，避免发柴。"
    },
    {
      "original": "青椒",
      "substitute": "小米辣",
      "ratio": "100 克:20 克",
      "note": "辣味更冲，量要减半。"
    }
  ],
  "variations": [
    "加一点啤酒，汤味更浓。，别嫌麻烦，做完它。",
    "配青柠角，酸味更清爽。，这一步别省。"
  ],
  "serving_suggestion": "热汤配米饭和青柠，宿醉时的首选。",
  "storage": "冷藏两天，复热须煮开。，别跳过这步。",
