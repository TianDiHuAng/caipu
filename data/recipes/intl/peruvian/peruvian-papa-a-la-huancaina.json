  "equipment": [
    "煮锅",
    "料理机",
    "刀",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆洗净带皮冷水下锅，煮二十五分钟至筷子能轻松插透。",
      "time_min": 27,
      "heat": "中火",
      "tip": "带皮煮土豆不吸水，切出来也不发散。",
      "visual_cue": "筷子一插就能轻松穿透"
    },
    {
      "n": 2,
      "text": "捞出土豆稍凉后剥皮，切成两厘米厚的圆片摆盘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "稍凉再剥皮，热的时候容易撕掉肉。",
      "visual_cue": "圆片完整，边缘不碎裂"
    },
    {
      "n": 3,
      "text": "鸡蛋另起锅煮八分钟，剥壳后切成薄片备用。",
      "time_min": 9,
      "heat": "中火",
      "tip": "鸡蛋时间从水开算起，蛋黄才不噎。",
      "visual_cue": "蛋黄居中，边缘不发绿"
    },
    {
      "n": 4,
      "text": "料理机放奶酪、牛奶、洋葱、大蒜和植物油打成顺滑酱体。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先放液体再放固体，打出来更细。",
      "visual_cue": "酱体细腻顺滑无颗粒"
    },
    {
      "n": 5,
      "text": "加辣椒粉、柠檬汁、盐和黑胡椒再打十秒调匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "辣椒粉要边加边尝，别一次放足。",
      "visual_cue": "酱色金黄带着微橙色"
    },
    {
      "n": 6,
      "text": "把酱汁淋在土豆片上，摆鸡蛋片撒欧芹末即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱汁要现淋现吃，放久了会结皮。",
      "visual_cue": "酱汁覆面，点缀整齐好看"
    }
  ],
  "tips": [
    "土豆带皮煮不易吸水，切出的圆片才不会散。",
    "酱体要打到完全顺滑，颗粒感会破坏口感。",
    "辣椒粉边加边尝，辣度按口味调整。"
  ],
  "common_mistakes": [
    "土豆削皮后再煮，吸水过多切不成片。",
    "奶酪打发过头，酱体过稠挂在土豆上不掉。",
    "酱汁提前几小时做好，表面结出一层硬皮。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "菲达奶酪",
      "ratio": "150 克:130 克",
      "note": "咸味更重，需减盐。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "150 毫升:120 毫升",
      "note": "酱体更浓郁顺滑。"
    }
  ],
  "variations": [
    "加一块苏打饼干一起打，酱体更稳定。",
    "配水煮玉米和生菜一起摆盘，做成常见的套餐拼盘。"
  ],
  "serving_suggestion": "冷食上桌，配一份紫玉米汁或冰镇饮料，是秘鲁家常餐馆最常见的开胃前菜。",
  "storage": "酱汁冷藏两天，土豆现煮现切，冷藏后回温会影响口感。",
