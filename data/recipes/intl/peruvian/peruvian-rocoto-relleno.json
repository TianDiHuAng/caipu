  "steps": [
    {
      "n": 1,
      "text": "红椒去蒂去籽，整只保持完整。，火要均匀，食材才不糊。",
      "time_min": 10,
      "heat": "无火",
      "tip": "别切破，破了馅会漏。，看住火，别让它失控。",
      "visual_cue": "椒身完整，内壁干净"
    },
    {
      "n": 2,
      "text": "红椒沸水焯三分钟，捞出沥干。，全程留意火候，别贪快。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯水去生味，烤时才软。，火大了就离锅远一点。",
      "visual_cue": "椒身微软，颜色发亮"
    },
    {
      "n": 3,
      "text": "橄榄油炒香洋葱、蒜末和孜然。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "孜然遇油才出香，别炒糊。，锅温要匀，别忽高忽低。",
      "visual_cue": "香气浓郁，洋葱透明"
    },
    {
      "n": 4,
      "text": "下牛肉末炒散，加番茄膏炒匀。，火力保持中等，慢慢来。",
      "time_min": 8,
      "heat": "中火",
      "tip": "肉末炒到变色再放番茄膏。，火候宁小勿大，慢慢推进。",
      "visual_cue": "肉末松散，酱色红亮"
    },
    {
      "n": 5,
      "text": "加花生碎、一个鸡蛋、盐和黑胡椒，拌匀成馅。，注意锅里温度别掉下来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鸡蛋让馅黏合，烤时不散。，始终中小火，别心急。",
      "visual_cue": "馅料黏稠，颜色均匀"
    },
    {
      "n": 6,
      "text": "把馅塞进红椒，八分满封口。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别塞太满，烤时会胀。，看住火，别让它失控。",
      "visual_cue": "椒身鼓起，口部平整"
    },
    {
      "n": 7,
      "text": "表面刷蛋液，铺奶酪丝。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪铺满顶面，烤后成壳。，火大了就离锅远一点。",
      "visual_cue": "表面金黄，奶酪覆盖"
    },
    {
      "n": 8,
      "text": "烤箱一百八十度烤三十分钟。，火别开太大，稳着来。",
      "time_min": 32,
      "heat": "无火",
      "tip": "烤到奶酪起泡上色就好。，锅温要匀，别忽高忽低。",
      "visual_cue": "奶酪融化，椒身软塌"
    }
  ],
  "tips": [
    "红椒别切破，整只才能装馅。，这点要注意。",
    "馅塞八分满，烤时才不爆。，这是关键点。",
    "奶酪铺满顶面，烤出脆壳。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "红椒没焯水，腥味重还硬。，这一步别省。",
    "馅塞太满，烤时全溢出来。，别跳过这步。",
    "烤过头，椒身塌成一摊。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "红椒",
      "substitute": "青椒",
      "ratio": "500 克:500 克",
      "note": "辣味更淡，口感更清爽。"
    },
    {
      "original": "牛肉末",
      "substitute": "鸡胸肉末",
      "ratio": "400 克:400 克",
      "note": "更瘦，需多加点橄榄油。"
    }
  ],
  "variations": [
    "馅里加葡萄干，酸甜更平衡。，很多人在这里出错。",
    "配土豆泥一起烤，更饱腹。，这里最容易翻车。"
  ],
  "serving_suggestion": "配米饭和番茄洋葱沙拉。，别小看这一步。",
  "storage": "冷藏三天，复烤十分钟。，成败就在这一步。",
