  "steps": [
    {
      "n": 1,
      "text": "玉米带芯切段，紫薯去皮切块。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "玉米芯别扔，颜色和甜味都在里面。，火候要稳，别忽大忽小。",
      "visual_cue": "玉米断段，紫薯切匀"
    },
    {
      "n": 2,
      "text": "清水入锅，放玉米、紫薯、桂皮和香叶。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "大火",
      "tip": "冷水下锅，颜色慢慢出来。，火候要稳，别忽大忽小。",
      "visual_cue": "汤色转紫，材料沉底"
    },
    {
      "n": 3,
      "text": "煮开后转小火炖三十分钟。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢炖，紫色才浓。，火候要稳，别忽大忽小。",
      "visual_cue": "汤色深紫，材料软透"
    },
    {
      "n": 4,
      "text": "关火加白糖搅化，静置放凉。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糖在热汤里化得快。，火候要稳，别忽大忽小。",
      "visual_cue": "甜味平衡，汤色发亮"
    },
    {
      "n": 5,
      "text": "滤网滤掉渣，只留紫色汤汁。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用细网滤两遍，汤才清。，火候要稳，别忽大忽小。",
      "visual_cue": "汤汁清澈，无残渣，这一点很关键。"
    },
    {
      "n": 6,
      "text": "喝前加柠檬汁，冰镇更佳。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬最后加，颜色更红亮。，火候要稳，别忽大忽小。",
      "visual_cue": "颜色转玫红，酸香明显"
    }
  ],
  "tips": [
    "玉米芯一起煮，颜色和甜味更足。，这一点很关键。",
    "紫薯是上色的关键，别省。，这一点很关键。",
    "柠檬最后加，颜色才变玫红。，这一点很关键。"
  ],
  "common_mistakes": [
    "大火滚煮，汤色发灰。，这一点很关键。",
    "柠檬一开始就加，紫色褪掉。，这一点很关键。",
    "糖放太少，喝起来寡淡。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "紫薯",
      "substitute": "红薯",
      "ratio": "300 克:300 克",
      "note": "颜色偏橙，需要多加玉米芯。"
    },
    {
      "original": "桂皮",
      "substitute": "香叶",
      "ratio": "5 克:3 克",
      "note": "香气更清，少了暖甜味。"
    }
  ],
  "variations": [
    "加一点苹果块，果香更明显。，这一点很关键。",
    "加几粒丁香，香气更有层次。，这一点很关键。"
  ],
  "serving_suggestion": "冰镇后大杯喝，配辣味菜最解腻。，这一点很关键。",
  "storage": "冷藏三天，饮用前摇匀。，这一点很关键。",
