          "name_en": "lemon",
          "amount": 60,
          "unit": "g",
          "note": "挤汁",
          "optional": false
        },
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "拌泥",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 10,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "压泥器",
    "方形模具",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆洗净不去皮，整颗放进蒸锅蒸二十五分钟。",
      "time_min": 26,
      "heat": "中火",
      "tip": "带皮蒸，水分不进去，泥才绵密。",
      "visual_cue": "土豆外皮开裂，筷子一插即透"
    },
    {
      "n": 2,
      "text": "蒸好的土豆稍凉后剥皮，趁温热用压泥器压成细泥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁温热时压泥，泥才细腻没有颗粒。",
      "visual_cue": "土豆泥细滑，堆在盆里"
    },
    {
      "n": 3,
      "text": "在土豆泥里加入植物油与盐，用手反复揉到均匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "把油分完全揉进去，泥才亮而不散开。",
      "visual_cue": "土豆泥油亮，能捏成团"
    },
    {
      "n": 4,
      "text": "挤入柠檬汁与辣椒粉，继续揉到颜色完全均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬汁分次加进去，酸度才好掌握。",
      "visual_cue": "泥色转淡黄，酸香扑鼻"
    },
    {
      "n": 5,
      "text": "先尝一口再调味，酸甜咸辣四味要调得均衡不偏。",
      "time_min": 2,
      "heat": "无火",
      "tip": "四味平衡才像秘鲁味，别只咸不酸。",
      "visual_cue": "味道层次分明，回味带酸"
    },
    {
      "n": 6,
      "text": "鸡蛋冷水下锅煮十分钟，剥壳后切成厚薄一致的片。",
      "time_min": 12,
      "heat": "中火",
      "tip": "鸡蛋煮透放凉再切，刀口才整齐不碎。",
      "visual_cue": "鸡蛋片边缘整齐，蛋黄全熟"
    },
    {
      "n": 7,
      "text": "模具内壁抹薄油，先铺一层土豆泥压平压实。",
      "time_min": 5,
      "heat": "无火",
      "tip": "每一层都压实压平，脱模时才不会塌。",
      "visual_cue": "泥层平整，边角压实"
    },
    {
      "n": 8,
      "text": "中间铺上鸡蛋片，再盖一层土豆泥压实抹平。",
      "time_min": 5,
      "heat": "无火",
      "tip": "夹层铺得均匀，切开后断面才好看。",
      "visual_cue": "两层泥夹一层蛋，表面平整"
    },
    {
      "n": 9,
      "text": "连模具冷藏二十分钟定型，脱模后切块装盘。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冷藏定型之后再切，切面才不碎不散。",
      "visual_cue": "切块棱角分明，断面层次清晰"
    },
    {
      "n": 10,
      "text": "表面撒一层欧芹碎，再配几片柠檬角一起上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "上桌前再撒香草碎，颜色才翠绿好看。",
      "visual_cue": "翠绿点缀，冷气扑面"
    }
  ],
  "tips": [
    "土豆带皮蒸，水分进不去，压出的泥才绵密。",
    "土豆泥要趁温热压，凉了容易结块。",
    "冷藏定型后再切，切面才平整不散。"
  ],
  "common_mistakes": [
    "土豆水煮后不晾干就压泥，泥稀得立不住。",
    "柠檬汁一次倒太多，泥发酸还出水。",
    "不冷藏直接脱模，成品瘫成一摊泥。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "700 克:700 克",
      "note": "甜味更重，柠檬汁可略减。"
    },
    {
      "original": "辣椒粉",
      "substitute": "甜椒粉",
      "ratio": "5 克:6 克",
      "note": "不辣但颜色更红。"
    }
  ],
  "variations": [
    "夹层换成煎香的虾仁，鲜味更足。",
    "表面抹一层辣椒蛋黄酱，口感更润。"
  ],
  "serving_suggestion": "切成厚方块装盘，配一杯冰镇柠檬水和几片生菜叶一起上桌。",
  "storage": "冷藏一天，食用前用刀片重新切面，别反复回温。",
