  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切三厘米见方的块，厚薄一致。，火别开太大，稳着来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "块切均匀，烤时才一起熟。，锅温要匀，别忽高忽低。",
      "visual_cue": "肉块方正，大小一致"
    },
    {
      "n": 2,
      "text": "白醋、辣椒粉、孜然、蒜末和牛至调成腌料。，火力保持中等，慢慢来。",
      "time_min": 4,
      "heat": "无火",
      "tip": "腌料拌成稠糊，才挂得住肉。，火候宁小勿大，慢慢推进。",
      "visual_cue": "酱料红亮，香气冲鼻"
    },
    {
      "n": 3,
      "text": "肉块放进腌料抓匀，冷藏两小时。，注意锅里温度别掉下来。",
      "time_min": 122,
      "heat": "无火",
      "tip": "腌够时间，酸味才渗进去。，始终中小火，别心急。",
      "visual_cue": "肉色变深，表面挂糊"
    },
    {
      "n": 4,
      "text": "竹签提前泡水，每串穿四块肉。，火要均匀，食材才不糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "签子泡水，烤时不烧焦。，看住火，别让它失控。",
      "visual_cue": "肉串紧实，间距均匀"
    },
    {
      "n": 5,
      "text": "烤架烧到很热，肉串刷橄榄油。，全程留意火候，别贪快。",
      "time_min": 5,
      "heat": "大火",
      "tip": "架子够热，肉才不粘。，火大了就离锅远一点。",
      "visual_cue": "架子冒烟，油光闪，很多人在这里出错。"
    },
    {
      "n": 6,
      "text": "每面烤三分钟，中途再刷一次油。，火别开太大，稳着来。",
      "time_min": 7,
      "heat": "大火",
      "tip": "勤翻面，别让辣椒粉烧黑。，锅温要匀，别忽高忽低。",
      "visual_cue": "表面焦痕，肉汁渗出"
    },
    {
      "n": 7,
      "text": "撒盐和黑胡椒，趁热上桌。，火力保持中等，慢慢来。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐最后撒，肉才不老。，火候宁小勿大，慢慢推进。",
      "visual_cue": "肉串油亮，焦香扑鼻"
    }
  ],
  "tips": [
    "白醋是灵魂，腌够两小时才入味。，这里最容易翻车。",
    "竹签泡水，烤时才不烧断。，别小看这一步。",
    "大火快烤，肉才嫩不柴。，成败就在这一步。"
  ],
  "common_mistakes": [
    "腌的时间太短，只有表面有味。，这点要注意。",
    "小火慢烤，肉干得像木头。，这是关键点。",
    "辣椒粉撒太多，苦味盖住肉香。，别嫌麻烦，做完它。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡腿肉",
      "ratio": "600 克:600 克",
      "note": "腌一小时即可，口感更嫩。"
    },
    {
      "original": "白醋",
      "substitute": "柠檬",
      "ratio": "80 毫升:2 个",
      "note": "酸味更柔和，香气更清新。"
    }
  ],
  "variations": [
    "腌料加一勺啤酒，肉更松软。，这一步别省。",
    "配一碟青辣酱，辣味更有层次。，别跳过这步。"
  ],
  "serving_suggestion": "配烤土豆和玉米，挤青柠汁。，这步最关键。",
  "storage": "冷藏两天，复烤三分钟。，很多人在这里出错。",
