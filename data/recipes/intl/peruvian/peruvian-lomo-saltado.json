  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "炸锅或深锅",
    "滤油网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切一指宽粗条，加生抽、黑胡椒和一半蒜末抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌牛肉只用十分钟，时间长了肉质发紧。",
      "visual_cue": "肉条表面挂汁，颜色加深"
    },
    {
      "n": 2,
      "text": "土豆切粗条，用清水冲去表面黏液后彻底擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "土豆条必须擦干，否则下油锅溅得厉害。",
      "visual_cue": "薯条表面干爽不粘手"
    },
    {
      "n": 3,
      "text": "植物油烧到一百七十度，薯条分两批炸四分钟至金黄，捞出撒盐。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "分批炸油温才不回软，一次下太多会粘成团。",
      "visual_cue": "薯条外表金黄坚硬，捞出沥油"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒烟，下少量油快速炒肉条一分钟至变色，盛出备用。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅一定要够热，肉条下去快速封住表面才嫩。",
      "visual_cue": "肉条边缘焦褐，内部仍带粉"
    },
    {
      "n": 5,
      "text": "原锅下洋葱条与青椒炒四十秒，加番茄瓣与剩余蒜末炒三十秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "蔬菜只要断生，保留脆感才对。",
      "visual_cue": "洋葱半透明仍挺立，番茄略塌"
    },
    {
      "n": 6,
      "text": "倒回肉条，沿锅边淋白醋与辣椒酱，加盐翻匀，拌入薯条撒香菜。",
      "time_min": 3,
      "heat": "大火",
      "tip": "醋要沿锅边淋，遇热瞬间挥发的酸香才冲，配白米煮的饭一起上桌。",
      "visual_cue": "锅内腾起白汽，薯条裹上油亮酱汁"
    }
  ],
  "tips": [
    "薯条要在临上桌前才拌进去，久放会软塌。",
    "配白米饭是秘鲁本地吃法，碳水和碳水一起上。",
    "牛肉换成鸡胸肉同样好吃，炒制时间减半。"
  ],
  "common_mistakes": [
    "肉条在锅里炒过头，口感变得又干又硬像牛肉干。",
    "薯条炸一次就拌进菜里，很快变得湿软。",
    "番茄过早下锅炒成糊，失去酸甜的颗粒感。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "西冷",
      "ratio": "500 克:500 克",
      "note": "带油边更香，腌时可少放油。"
    },
    {
      "original": "白醋",
      "substitute": "红酒醋",
      "ratio": "20 毫升:20 毫升",
      "note": "酸味更圆润，果香突出。"
    }
  ],
  "variations": [
    "加入黄辣椒酱可做秘鲁风味的辣味版本。"
  ],
  "serving_suggestion": "连汁带薯条浇在白米饭旁，撒香菜上桌。",
  "storage": "冷藏一天，复热用大火快炒；薯条建议现炸现吃。",
