  "equipment": [
    "厚底炖锅",
    "搅拌机",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉块用厨房纸吸干，撒一半盐和黑胡椒，静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表面擦干才能煎出焦壳。",
      "visual_cue": "肉块干爽，按下去回弹"
    },
    {
      "n": 2,
      "text": "厚底锅倒植物油烧热，分批把牛肉煎到六面焦褐，盛出备用。",
      "time_min": 10,
      "heat": "大火",
      "tip": "一次别下太多，锅里挤了就变成水煮。",
      "visual_cue": "肉块表面深褐，锅底有焦渣"
    },
    {
      "n": 3,
      "text": "原锅下洋葱丁和蒜末，小火炒六分钟，把锅底的焦渣刮起来。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒甜，底味才厚。",
      "visual_cue": "洋葱透明，锅底干净"
    },
    {
      "n": 4,
      "text": "香菜连茎加水打成浓绿泥，倒进锅里，加辣椒粉和孜然煮开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "香菜只用叶会太淡，茎才是香气来源。",
      "visual_cue": "汤色深绿，香气冲鼻"
    },
    {
      "n": 5,
      "text": "牛肉回锅，加热水没过肉面，小火盖盖炖四十分钟。",
      "time_min": 40,
      "heat": "小火",
      "tip": "水面微微冒泡即可，大滚肉会柴。",
      "visual_cue": "肉块能用筷子插进去"
    },
    {
      "n": 6,
      "text": "放土豆和胡萝卜，继续炖十五分钟至蔬菜软透。",
      "time_min": 15,
      "heat": "小火",
      "tip": "土豆后放，否则会炖成糊。",
      "visual_cue": "土豆边缘化开，胡萝卜变软"
    },
    {
      "n": 7,
      "text": "加豌豆煮三分钟，用剩下的盐调味，撒黑胡椒上桌。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豌豆最后放，颜色才翠。",
      "visual_cue": "豌豆翠绿，汤汁浓稠挂勺"
    }
  ],
  "tips": [
    "香菜泥打好立刻下锅，久放会氧化发黑。",
    "喜欢更浓的青草香可留一把香菜最后切碎撒面。",
    "牛腩比牛腱更适合，胶质炖出来汤更厚。"
  ],
  "common_mistakes": [
    "牛肉没煎直接炖，汤寡淡无层次。",
    "香菜泥在锅里煮太久，颜色和香气都发暗发黑。",
    "土豆一开始就下锅，炖到最后全化在汤里。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡腿肉",
      "ratio": "700克:700克",
      "note": "炖的时间缩短到二十五分钟。"
    },
    {
      "original": "豌豆",
      "substitute": "青豆",
      "ratio": "100克:100克",
      "note": "口感接近，煮三分钟即可。"
    }
  ],
  "variations": [
    "加一勺黄辣椒酱，辣味更接近秘鲁本地版本。",
    "配白饭和炸香蕉，是秘鲁北部的吃法。"
  ],
  "serving_suggestion": "浇在白饭上，配一份洋葱青柠拌菜解腻，汤汁拌饭是重点。",
  "storage": "冷藏三天，冷冻一个月；复热小火加热并补少量水。",
