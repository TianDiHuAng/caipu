        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤架",
    "刷子",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用叉子在带皮一面扎些小孔，方便腌料渗进去。",
      "time_min": 6,
      "heat": "无火",
      "tip": "扎孔让腌料进得去，皮还不破相。",
      "visual_cue": "鸡皮上密布细孔，肉面平整"
    },
    {
      "n": 2,
      "text": "大蒜压成泥，与辣椒粉、黑胡椒、盐混合，倒进米醋搅匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先调成糊再抹，味道才裹得均匀。",
      "visual_cue": "腌料成深红色稠糊，辛香冲鼻"
    },
    {
      "n": 3,
      "text": "把腌料糊抹遍鸡腿肉两面，冷藏静置两小时。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌足两小时，咸味才渗到肉心，连皮都入味。",
      "visual_cue": "鸡肉表面挂满红糊，颜色变深"
    },
    {
      "n": 4,
      "text": "烤盘底部铺一层洋葱圈，把鸡腿肉带皮朝上放上去。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱垫底接油，出炉不粘盘也不焦。",
      "visual_cue": "洋葱圈铺满盘底，鸡肉架空"
    },
    {
      "n": 5,
      "text": "烤箱预热到二百度，先烤二十五分钟让鸡皮起色。",
      "time_min": 22,
      "heat": "中火",
      "tip": "先高温定型，鸡皮才脆得起来，也不会塌。",
      "visual_cue": "鸡皮转金红，边缘卷起小泡"
    },
    {
      "n": 6,
      "text": "取出刷一层植物油，翻面再把烤温降到一百八十度。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷一层油保住水分，翻面让肉面也均匀受热。",
      "visual_cue": "表面油亮，肉质微微收紧"
    },
    {
      "n": 7,
      "text": "翻面后继续烤二十分钟，中途再刷一次植物油。",
      "time_min": 18,
      "heat": "中火",
      "tip": "前后刷两次植物油，皮脆而肉不干，颜色也漂亮。",
      "visual_cue": "鸡肉表面泛油光，汁水清亮"
    },
    {
      "n": 8,
      "text": "最后五分钟把温度升到二百度，让鸡皮收紧变脆。",
      "time_min": 5,
      "heat": "大火",
      "tip": "高温收尾才有脆皮，时间一久就发焦了。",
      "visual_cue": "鸡皮深红透亮，按之脆响"
    },
    {
      "n": 9,
      "text": "出炉静置八分钟，斩成大块摆盘淋少许烤汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "静置让汁水回流，切块不流一汪汤。",
      "visual_cue": "切面肉白汁清，皮色油红"
    }
  ],
  "tips": [
    "腌料先调成糊再抹，比撒粉均匀，味道也进得深。",
    "烤盘垫洋葱圈，既接油又添一层甜香。",
    "出炉静置再切，肉汁不流，皮还脆。"
  ],
  "common_mistakes": [
    "腌料直接撒干粉，烤完皮上斑驳，咸淡不均。",
    "全程高温猛烤，鸡皮焦黑而腿肉还夹生。",
    "出炉立刻斩块，肉汁全流在盘子里。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "1100 克:1000 克",
      "note": "肉薄易干，烤制时间减十五分钟。"
    },
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "20 毫升:20 毫升",
      "note": "酸度更直，略减用量。"
    }
  ],
  "variations": [
    "腌料里加一勺黄椒酱，颜色更亮，风味更秘鲁。",
    "配一碟青柠洋葱丝同吃，解腻又开胃。"
  ],
  "serving_suggestion": "斩块配炸薯条与辣酱，挤上青柠汁，是利马街头最热闹的一盘。",
  "storage": "冷藏三天，复热时盖锡纸一百八十度烤十分钟。",
