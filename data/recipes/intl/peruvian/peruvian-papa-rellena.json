  "equipment": [
    "蒸锅",
    "压泥器",
    "平底锅",
    "保鲜膜",
    "深锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切块蒸二十分钟至软透，趁热压成泥，加一个鸡蛋和一半盐拌匀。",
      "time_min": 22,
      "heat": "中火",
      "tip": "土豆泥要干，太湿会散。",
      "visual_cue": "泥体细腻，能捏成团不粘手"
    },
    {
      "n": 2,
      "text": "平底锅倒一半植物油，下洋葱丁和蒜末炒五分钟至透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒软，馅才有甜味。",
      "visual_cue": "洋葱炒到透明发亮，锅里有甜香"
    },
    {
      "n": 3,
      "text": "下牛肉末炒散至变色，加辣椒粉、孜然、剩余的盐和黑胡椒，炒到汁水收干。",
      "time_min": 6,
      "heat": "中火",
      "tip": "馅一定要炒干，否则炸的时候会爆。",
      "visual_cue": "肉末松散无汤，锅底干爽"
    },
    {
      "n": 4,
      "text": "关火拌入橄榄碎和葡萄干，盛出放凉到不烫手。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馅太烫会把土豆泥烫散。",
      "visual_cue": "馅料微温，有甜咸交织的香气"
    },
    {
      "n": 5,
      "text": "手心抹油，取八十克土豆泥压成圆片，放一勺馅，收口捏成椭圆。",
      "time_min": 12,
      "heat": "无火",
      "tip": "收口要捏紧，炸时才不漏馅。",
      "visual_cue": "外形椭圆饱满，看不到缝隙"
    },
    {
      "n": 6,
      "text": "依次裹面粉、剩下那个鸡蛋的蛋液、面包糠，轻压让糠贴牢。",
      "time_min": 6,
      "heat": "无火",
      "tip": "裹好静置五分钟，炸衣更牢。",
      "visual_cue": "表面覆一层均匀面包糠"
    },
    {
      "n": 7,
      "text": "深锅油烧到一百七十度，中小火炸四分钟至金黄，捞出沥油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温别高，糠容易焦黑。",
      "visual_cue": "外壳金黄酥脆，敲起来有空响"
    }
  ],
  "tips": [
    "土豆泥太湿可加两勺土豆淀粉调干。",
    "不油炸可用平底锅少油煎，每面三分钟。",
    "馅料可提前一天做好冷藏，包起来更省事。"
  ],
  "common_mistakes": [
    "土豆泥没放凉就包，遇热馅散成一堆。",
    "馅料里带汁水，一下油锅就爆油花四溅。",
    "收口没捏紧，炸的时候裂开漏馅。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "鸡胸肉",
      "ratio": "250克:250克",
      "note": "剁成细丁，炒的时间缩短两分钟。"
    },
    {
      "original": "面包糠",
      "substitute": "玉米面",
      "ratio": "80克:60克",
      "note": "外皮更粗粝，油温要降低十度。"
    }
  ],
  "variations": [
    "加半个水煮蛋包在中心，切开有惊喜。",
    "做成一口大小的小球，适合当派对上的手指食物。"
  ],
  "serving_suggestion": "配一份洋葱青柠拌菜和辣椒酱，挤上青柠汁趁热吃。",
  "storage": "生胚冷冻一个月，直接冷油下锅炸；熟品冷藏两天，复烤一百八十度八分钟。",
