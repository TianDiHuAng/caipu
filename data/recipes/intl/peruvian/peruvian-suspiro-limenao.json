          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "锅",
    "木勺",
    "打蛋器",
    "大碗",
    "小锅",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "炼乳、淡奶油和牛奶倒入厚底锅。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "锅要厚底，不然底部先糊。，火候要稳，别忽大忽小。",
      "visual_cue": "液体融合，颜色浅黄"
    },
    {
      "n": 2,
      "text": "放一段桂皮，小火煮三十分钟不停搅。，火候要稳，别忽大忽小。",
      "time_min": 32,
      "heat": "小火",
      "tip": "全程小火，一停搅就糊底。，火候要稳，别忽大忽小。",
      "visual_cue": "颜色深黄，质地浓稠"
    },
    {
      "n": 3,
      "text": "煮到木勺划过留下清晰痕迹，离火放温。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "太烫会把蛋黄烫成疙瘩。，火候要稳，别忽大忽小。",
      "visual_cue": "痕迹清晰，流动缓慢"
    },
    {
      "n": 4,
      "text": "蛋黄打散，分次舀入温糖浆中搅匀。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一次一点，边加边搅。，火候要稳，别忽大忽小。",
      "visual_cue": "蛋液顺滑，无颗粒，这一点很关键。"
    },
    {
      "n": 5,
      "text": "倒回锅小火加热两分钟，微浓就离火。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "小火",
      "tip": "别煮开，蛋黄会结块。，火候要稳，别忽大忽小。",
      "visual_cue": "酱体挂勺，边缘微冒泡"
    },
    {
      "n": 6,
      "text": "蛋白打到起泡，分三次加白糖打到硬挺。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打到提起有直立尖角。，火候要稳，别忽大忽小。",
      "visual_cue": "蛋白霜光亮，尖角挺立"
    },
    {
      "n": 7,
      "text": "把蛋白霜铺在甜酱上，撒可可粉。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "堆成小波浪，造型更好看。，火候要稳，别忽大忽小。",
      "visual_cue": "表面起伏，粉层均匀"
    },
    {
      "n": 8,
      "text": "冷藏一小时，定型后挖食。，火候要稳，别忽大忽小。",
      "time_min": 62,
      "heat": "无火",
      "tip": "冷藏后口感更细腻。，火候要稳，别忽大忽小。",
      "visual_cue": "甜酱紧实，蛋白轻盈"
    }
  ],
  "tips": [
    "全程小火不停搅，才能避免糊底。，这一点很关键。",
    "蛋黄要回温分次加，才不会结块。，这一点很关键。",
    "蛋白打到硬挺，形状才立得住。，这一点很关键。"
  ],
  "common_mistakes": [
    "火大不搅，锅底焦成黑色。，这一点很关键。",
    "蛋黄直接倒进热酱，结成蛋花。，这一点很关键。",
    "蛋白打软了，冷藏后摊成一片。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "炼乳",
      "substitute": "牛奶",
      "ratio": "400 克:500 毫升",
      "note": "需多加白糖一百克并延长煮制。"
    },
    {
      "original": "可可粉",
      "substitute": "桂皮粉",
      "ratio": "5 克:3 克",
      "note": "香气更暖，颜色偏棕。"
    }
  ],
  "variations": [
    "甜酱里加一点橙皮屑，香气更清。，这一点很关键。",
    "表面撒坚果碎，口感更丰富。，这一点很关键。"
  ],
  "serving_suggestion": "冷藏后小碗盛出，配浓缩咖啡。，这一点很关键。",
  "storage": "冷藏三天，表面盖膜防结皮。，这一点很关键。",
