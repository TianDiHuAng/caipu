  "equipment": [
    "炒锅",
    "锅铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉丁加少量生抽和黑胡椒抓匀，腌八分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鸡肉先上色，炒出来才不白。",
      "visual_cue": "肉丁表面泛浅褐，质地黏手"
    },
    {
      "n": 2,
      "text": "隔夜冷米饭用手抓散，加一勺水抓匀，让饭粒分开不结块。",
      "time_min": 4,
      "heat": "无火",
      "tip": "隔夜冷饭最好，新饭要摊凉再炒。",
      "visual_cue": "饭粒颗颗分明，没有硬块"
    },
    {
      "n": 3,
      "text": "炒锅大火烧到冒烟，倒一半植物油，倒蛋液炒成碎块盛出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅够热蛋才香，不会出水。",
      "visual_cue": "蛋块蓬松金黄，切成小块"
    },
    {
      "n": 4,
      "text": "锅里补油，下洋葱和蒜末爆香三十秒，再下鸡丁炒三分钟至变白。",
      "time_min": 4,
      "heat": "大火",
      "tip": "蒜别炒焦，一焦整锅发苦。",
      "visual_cue": "鸡肉变白收紧，洋葱边缘透亮"
    },
    {
      "n": 5,
      "text": "下火腿丁和冷米饭，用铲子压散翻炒三分钟，让饭粒受热均匀。",
      "time_min": 4,
      "heat": "大火",
      "tip": "铲子压散再翻，别用湿饭。",
      "visual_cue": "饭粒在锅里跳动，锅底无积水"
    },
    {
      "n": 6,
      "text": "沿锅边淋生抽，加盐和黑胡椒快速翻匀，让颜色铺满米粒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "生抽顺着锅边下去才出香。",
      "visual_cue": "饭粒均匀浅褐，香气扑鼻"
    },
    {
      "n": 7,
      "text": "倒回蛋块翻炒均匀，关火撒上香菜碎，趁热装盘上桌。",
      "time_min": 2,
      "heat": "大火",
      "tip": "香菜关火后放，保持翠绿。",
      "visual_cue": "米粒松散油亮，蛋块分布均匀"
    }
  ],
  "tips": [
    "全程大火快炒，锅气就是这道饭的灵魂。",
    "米饭提前摊凉冷藏，水分少了才不粘锅。",
    "加一勺辣椒酱同炒，酸辣版本也常见。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭，下锅就糊成一团。",
    "锅温不够高，米饭越炒越湿，成了浇饭。",
    "生抽一次倒太多，颜色发黑发苦。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "虾仁",
      "ratio": "250克:250克",
      "note": "虾仁炒到变色即可，别超过两分钟。"
    },
    {
      "original": "火腿",
      "substitute": "叉烧",
      "ratio": "60克:60克",
      "note": "甜咸风味更接近广东炒饭。"
    }
  ],
  "variations": [
    "加一勺黄辣椒酱，做成秘鲁风味的辣炒饭。",
    "换成牛肉丁同炒，配上一份炸薯条更地道。"
  ],
  "serving_suggestion": "配一碗清汤和辣椒酱，挤上青柠汁，是秘鲁中餐馆的标准搭配。",
  "storage": "冷藏两天，复热用炒锅大火回炒两分钟，别用微波炉。",
