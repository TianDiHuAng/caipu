          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 15,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "红辣椒",
          "name_en": "red chili",
          "amount": 1,
          "unit": "piece",
          "note": "切极细圈",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 10,
          "unit": "ml",
          "note": "增亮",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "拌菜盆",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱对半切开，顺着纹路切成极细的丝，越薄越好。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切得越薄，腌得越快越入味。",
      "visual_cue": "洋葱丝细如发丝，粗细均匀"
    },
    {
      "n": 2,
      "text": "洋葱丝放清水里泡五分钟，去掉辛辣的冲味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡水后辛辣感减轻，口感更脆。",
      "visual_cue": "水面无浮沫，洋葱丝变挺"
    },
    {
      "n": 3,
      "text": "捞起洋葱丝彻底沥干，再用厨房纸吸掉多余水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水没沥干会稀释酸味。",
      "visual_cue": "洋葱丝干爽不滴水"
    },
    {
      "n": 4,
      "text": "青柠挤汁过滤，与盐、黑胡椒和橄榄油调成酸汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先调好汁再拌，咸酸才均匀。",
      "visual_cue": "汁液清亮，尝起来咸酸分明"
    },
    {
      "n": 5,
      "text": "洋葱丝与红辣椒圈放入盆中，倒入调好的酸汁抓拌均匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "用手抓拌，洋葱更容易吃进味。",
      "visual_cue": "洋葱丝裹上汁液，颜色透亮"
    },
    {
      "n": 6,
      "text": "撒上香菜碎拌匀，静置十分钟，让酸味和香气融合。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置后辛辣退去，酸香更明显。",
      "visual_cue": "洋葱丝变软一线，香气清爽"
    }
  ],
  "tips": [
    "洋葱切得越细越好，粗丝腌不入味。",
    "泡水后一定要沥干，水分会冲淡酸味。",
    "静置十分钟再吃，辛辣感会明显减弱。"
  ],
  "common_mistakes": [
    "洋葱切得太粗，嚼起来又冲又辣。",
    "洋葱没沥干就拌，盆底很快积一层水。",
    "盐下太多，酸味被压得尝不出来。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "80 克:90 克",
      "note": "酸味更柔，需多加两克盐。"
    },
    {
      "original": "红辣椒",
      "substitute": "辣椒粉",
      "ratio": "1 个:2 克",
      "note": "辣度更均匀，但少了脆感。"
    }
  ],
  "variations": [
    "加几片薄切黄瓜，口感更清脆清爽。",
    "拌入一把煮熟的玉米粒，做成半沙拉。"
  ],
  "serving_suggestion": "配烤肉、炸鱼或米饭一起上桌，解腻效果很好。",
  "storage": "冷藏一天内吃完，久放洋葱会出水变软。",
