  "equipment": [
    "炒锅",
    "电饭煲",
    "锅铲",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用盐与黑胡椒抓匀，腌十五分钟入味。",
      "time_min": 15,
      "heat": "无火",
      "tip": "带骨鸡块腌过更入味。",
      "visual_cue": "鸡皮表面均匀挂上调料"
    },
    {
      "n": 2,
      "text": "香菜与菠菜加少量清水打成浓绿的香料泥备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打得越细，颜色越均匀。",
      "visual_cue": "泥体浓稠，颜色深绿"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，中火把鸡块带皮一面煎到金黄酥脆。",
      "time_min": 8,
      "heat": "中火",
      "tip": "先煎带皮面，油脂香气才足。",
      "visual_cue": "鸡皮金黄微焦，锅底出油"
    },
    {
      "n": 4,
      "text": "翻面再煎三分钟，盛出鸡块，锅中留下底油备用。",
      "time_min": 3,
      "heat": "中火",
      "tip": "不用煎熟，后面还要和饭一起焖。",
      "visual_cue": "两面定型，鸡肉半熟"
    },
    {
      "n": 5,
      "text": "用锅底的油炒洋葱与蒜末，中火炒到洋葱透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透，饭的甜味就有了。",
      "visual_cue": "洋葱透明，香气散出"
    },
    {
      "n": 6,
      "text": "加青椒丁与孜然炒两分钟，再倒入绿色香料泥。",
      "time_min": 2,
      "heat": "中火",
      "tip": "香料泥下锅要不停搅，防止溅出。",
      "visual_cue": "锅内变成深绿色，香气浓郁"
    },
    {
      "n": 7,
      "text": "倒入沥干的大米翻炒三分钟，让米粒裹上香料。",
      "time_min": 3,
      "heat": "中火",
      "tip": "米粒炒到半透明，煮出来才松散。",
      "visual_cue": "米粒油亮，颜色转绿"
    },
    {
      "n": 8,
      "text": "加四百五十毫升清水与盐，放回鸡块，大火煮至沸腾。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水刚没过米面，多了会烂。",
      "visual_cue": "水面翻滚，鸡块露出一点"
    },
    {
      "n": 9,
      "text": "转小火盖盖焖二十分钟，关火后再焖五分钟定型。",
      "time_min": 25,
      "heat": "小火",
      "tip": "中途别开盖，跑了气饭会夹生。",
      "visual_cue": "水收干，表面出现小气孔"
    },
    {
      "n": 10,
      "text": "开盖挤上青柠汁，用锅铲从底部翻松后装盘上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁提亮整锅饭的颜色和味道。",
      "visual_cue": "米粒分明，鸡块完整"
    }
  ],
  "tips": [
    "香菜泥要打细，饭的颜色才均匀好看。",
    "米粒先炒再用小火焖，成品粒粒分明。",
    "青柠汁最后才挤，酸香味道才够鲜活。"
  ],
  "common_mistakes": [
    "香菜泥没打细，饭里夹着粗糙的菜渣。",
    "水加得太多，焖出来变成一锅绿粥。",
    "用大火收干水分，锅底糊成一层焦壳。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "700 克:650 克",
      "note": "煎制时间缩短两分钟，避免发柴。"
    },
    {
      "original": "菠菜",
      "substitute": "小青菜",
      "ratio": "60 克:60 克",
      "note": "颜色略浅，可多加十克香菜补色。"
    }
  ],
  "variations": [
    "配一勺辣酱同食，味道更冲更过瘾。",
    "加一把豌豆同焖，颜色和口感更丰富。"
  ],
  "serving_suggestion": "配洋葱青柠凉拌菜和辣酱一起上桌。",
  "storage": "冷藏两天，复热加两勺清水盖盖焖热。",
