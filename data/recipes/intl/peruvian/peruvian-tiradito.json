    "砧板",
    "碗",
    "小勺",
    "冷藏盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼去皮去刺，切成一厘米厚的片。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "刀要快，切面平整才好看。，火候要稳，别忽大忽小。",
      "visual_cue": "鱼片完整，厚薄均匀"
    },
    {
      "n": 2,
      "text": "鱼片平铺在冷藏过的盘子里。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盘子提前冷藏，鱼片更挺。，火候要稳，别忽大忽小。",
      "visual_cue": "鱼片平整，贴合盘面"
    },
    {
      "n": 3,
      "text": "青柠挤汁，滤掉果肉和籽。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "现挤现用，汁才够香。，火候要稳，别忽大忽小。",
      "visual_cue": "汁液清亮，酸香扑鼻"
    },
    {
      "n": 4,
      "text": "柠檬汁加盐、蒜末和黑胡椒调匀。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐先溶开，味道才均匀。，火候要稳，别忽大忽小。",
      "visual_cue": "调料融合，汤汁微稠"
    },
    {
      "n": 5,
      "text": "把调好的汁均匀淋在鱼片上。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "淋满整片，边角也要浇到。，火候要稳，别忽大忽小。",
      "visual_cue": "鱼片浸汁，颜色转白"
    },
    {
      "n": 6,
      "text": "静置五到八分钟，让酸汁熟化鱼肉。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "无火",
      "tip": "别腌太久，久了鱼肉发木。，火候要稳，别忽大忽小。",
      "visual_cue": "边缘变白，中心微透"
    },
    {
      "n": 7,
      "text": "淋橄榄油，撒小米辣圈和香菜。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "辣圈最后放，颜色才鲜。，火候要稳，别忽大忽小。",
      "visual_cue": "表面油亮，辣圈点缀"
    }
  ],
  "tips": [
    "鱼一定新鲜，这道菜不加热。，这一点很关键。",
    "青柠汁现挤，放久了发苦。，这一点很关键。",
    "腌五到八分钟就够，久了肉发木。，这一点很关键。"
  ],
  "common_mistakes": [
    "鱼切太厚，酸汁渗不进去。，这一点很关键。",
    "青柠汁提前挤好，香气跑光。，这一点很关键。",
    "腌半小时以上，鱼肉变硬发白。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "三文鱼",
      "ratio": "500 克:500 克",
      "note": "油脂更足，酸汁可减一勺。"
    },
    {
      "original": "小米辣",
      "substitute": "辣椒粉",
      "ratio": "10 克:4 克",
      "note": "辣味分布更均匀，少了脆感。"
    }
  ],
  "variations": [
    "淋一点淡奶油，酱汁更柔。，这一点很关键。",
    "配烤玉米粒，甜味更突出。，这一点很关键。"
  ],
  "serving_suggestion": "冷藏后立刻上桌，配冰啤酒。，这一点很关键。",
  "storage": "现做现吃，不建议存放。，这一点很关键。",
