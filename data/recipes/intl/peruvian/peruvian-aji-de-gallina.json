  "equipment": [
    "炖锅",
    "料理机",
    "刀",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉冷水下锅，加盐煮二十分钟至熟，捞出撕成粗丝，汤留用。",
      "time_min": 25,
      "heat": "中火",
      "tip": "撕丝比切块更容易挂住奶油酱。",
      "visual_cue": "鸡肉全白，撕成均匀细丝"
    },
    {
      "n": 2,
      "text": "面包去边泡进牛奶，泡软后连同牛奶一起用料理机打成糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面包糊是这道菜浓稠度的来源，别用其他粉类替代。",
      "visual_cue": "面包糊顺滑无颗粒"
    },
    {
      "n": 3,
      "text": "锅里下植物油，炒香洋葱末与蒜末至透明微黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱要炒到甜味出来，不能只炒软。",
      "visual_cue": "洋葱金黄透明，香气甜润"
    },
    {
      "n": 4,
      "text": "加辣椒粉与红椒粉小火炒一分钟，注意别炒糊。",
      "time_min": 2,
      "heat": "小火",
      "tip": "辣椒粉极易糊，下锅后马上转小火。",
      "visual_cue": "锅中红油泛起，辛香浓"
    },
    {
      "n": 5,
      "text": "倒入面包糊、高汤与奶酪搅匀，小火煮十分钟至浓稠。",
      "time_min": 12,
      "heat": "小火",
      "tip": "边煮边搅，奶酪化开后才不会结块。",
      "visual_cue": "酱体浓稠顺滑，颜色橙黄"
    },
    {
      "n": 6,
      "text": "放入鸡丝与淡奶油，小火再煮五分钟，加盐与黑胡椒调味。",
      "time_min": 7,
      "heat": "小火",
      "tip": "淡奶油最后加，久煮会分离。",
      "visual_cue": "酱汁裹住鸡丝，油亮浓稠"
    },
    {
      "n": 7,
      "text": "盘底摆蒸熟的土豆片，浇上奶油鸡，配水煮蛋与橄榄。",
      "time_min": 6,
      "heat": "无火",
      "tip": "土豆垫底吸汁，是秘鲁的标准摆法。",
      "visual_cue": "盘中橙黄酱汁,配菜整齐"
    },
    {
      "n": 8,
      "text": "在表面撒上欧芹碎点缀，趁热上桌配白饭一起食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "欧芹最后撒，香气才清亮。",
      "visual_cue": "表面翠绿点缀，热气腾腾"
    }
  ],
  "tips": [
    "用黄辣椒酱最好，买不到就用辣椒粉加红椒粉替代。",
    "面包糊决定浓稠度，太稠补高汤，太稀多煮几分钟。",
    "鸡丝用手撕，不要用刀切，口感更蓬松。"
  ],
  "common_mistakes": [
    "辣椒粉用大火炒糊，整锅酱汁都会带上苦味。",
    "奶酪一次全倒进去，结成一团化不开。",
    "淡奶油煮太久，酱汁油水分离发涩。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "800 克:800 克",
      "note": "更嫩多汁，煮制时间延长五分钟。"
    },
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "150 毫升:180 毫升",
      "note": "加十克面粉增稠，热量更低。"
    }
  ],
  "variations": [
    "用火鸡胸肉代替鸡肉，是节日版本。",
    "加一勺核桃碎同煮，口感更厚重绵密。"
  ],
  "serving_suggestion": "配白饭和蒸土豆，撒欧芹，再配一杯紫玉米汁。",
  "storage": "冷藏三天、冷冻一个月；复热加少量高汤小火搅匀，避免糊底。",
