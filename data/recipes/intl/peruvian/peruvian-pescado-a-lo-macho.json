        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "夹子",
    "厨房纸",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼片用厨房纸吸干，两面撒一半盐和黑胡椒，薄薄拍一层面粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拍粉要薄，厚了会糊成一层壳。",
      "visual_cue": "鱼片表面覆一层白霜，不见干粉"
    },
    {
      "n": 2,
      "text": "平底锅倒一半橄榄油，中火烧热，鱼片每面煎两分钟至金黄，盛出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鱼片下锅后别急着动，等它自己脱锅。",
      "visual_cue": "两面金黄，鱼片完整不散"
    },
    {
      "n": 3,
      "text": "同一锅补油，下洋葱丁和一半蒜末，小火炒五分钟至透明。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒甜再下番茄，酱才有层次。",
      "visual_cue": "洋葱透明，锅里有甜香"
    },
    {
      "n": 4,
      "text": "加番茄丁和辣椒粉炒四分钟至出汁，倒白葡萄酒煮一分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒出沙，酱体才浓。",
      "visual_cue": "番茄塌成糊状，汤汁发红"
    },
    {
      "n": 5,
      "text": "加一百毫升热水和剩下的盐，小火煮五分钟收成浓酱。",
      "time_min": 5,
      "heat": "小火",
      "tip": "酱别收太干，浇在鱼上要有流动性。",
      "visual_cue": "酱体能挂勺，锅铲划过留痕"
    },
    {
      "n": 6,
      "text": "鱼片回锅放进酱里，小火煮三分钟让味道渗进去。",
      "time_min": 3,
      "heat": "小火",
      "tip": "只煮三分钟，久了鱼肉发柴。",
      "visual_cue": "鱼片吸满红酱，边缘微卷"
    },
    {
      "n": 7,
      "text": "关火撒剩下的一半蒜末和香菜碎，配青柠角上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生蒜末最后撒，香气更冲。",
      "visual_cue": "表面散着蒜末与绿香菜"
    }
  ],
  "tips": [
    "鱼片厚度切成一致，受热才均匀，不会一块老一块生。",
    "喜欢更辣可以加一勺辣椒酱同炒，酸辣更开胃。",
    "配白饭和煮土豆，酱汁都能用上。"
  ],
  "common_mistakes": [
    "鱼片带水下锅，溅油且粘锅破皮。",
    "酱汁在锅里收得太干，浇上去变成一整块糊。",
    "鱼片在锅里反复翻动，最后全碎成小块。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "鲈鱼",
      "ratio": "600克:600克",
      "note": "肉质更嫩，煎的时间缩短三十秒。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "米酒",
      "ratio": "50毫升:40毫升",
      "note": "酸度略低，可挤几滴青柠补足。"
    }
  ],
  "variations": [
    "加虾仁和蛤蜊同煮，酱汁的海味更足。",
    "换成番茄膏两勺，颜色更深更浓。"
  ],
  "serving_suggestion": "连酱一起浇在白饭上，配青柠角挤汁，最后用面包擦盘底。",
  "storage": "冷藏两天，复热小火加少量水，别用大火滚。",
