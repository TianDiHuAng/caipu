  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "大米",
          "name_en": "rice",
          "amount": 200,
          "unit": "g",
          "note": "短粒米",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 800,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "红糖",
          "name_en": "brown-sugar",
          "amount": 120,
          "unit": "g",
          "note": "也可用白糖",
          "optional": false
        },
        {
          "name": "丁香",
          "name_en": "clove-spice",
          "amount": 1,
          "unit": "g",
          "note": "三粒",
          "optional": false
        },
        {
          "name": "肉桂粉",
          "name_en": "ground-cinnamon",
          "amount": 3,
          "unit": "g",
          "note": "一半煮一半撒面",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "取黄色表皮",
          "optional": false
        },
        {
          "name": "蛋黄",
          "name_en": "egg-yolk",
          "amount": 2,
          "unit": "piece",
          "note": "增稠",
          "optional": false
        },
        {
          "name": "葡萄干",
          "name_en": "raisin",
          "amount": 30,
          "unit": "g",
          "note": "温水泡软",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "小碗",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍沥干，与四百毫升牛奶和丁香一起下锅，小火煮十分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "牛奶容易糊底，前十分钟要一直搅。",
      "visual_cue": "米粒吸饱奶，锅底不见干粉"
    },
    {
      "n": 2,
      "text": "加红糖和柠檬皮，继续小火煮十五分钟，边煮边搅。",
      "time_min": 15,
      "heat": "小火",
      "tip": "木勺刮到锅底，防结块。",
      "visual_cue": "糖化开，颜色转浅褐"
    },
    {
      "n": 3,
      "text": "倒入剩余牛奶和一半肉桂粉，煮五分钟至米粒开花、质地变稠。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶分次加，稠度更好控制。",
      "visual_cue": "米粒软烂，勺子搅过留痕"
    },
    {
      "n": 4,
      "text": "蛋黄在小碗里打散，舀一勺热米糊慢慢冲进去搅匀，再倒回锅里。",
      "time_min": 3,
      "heat": "小火",
      "tip": "先兑温再回锅，蛋黄才不结块。",
      "visual_cue": "糊体顺滑，看不见蛋花"
    },
    {
      "n": 5,
      "text": "保持小火搅两分钟至浓稠，加盐调味，关火拌入葡萄干。",
      "time_min": 3,
      "heat": "小火",
      "tip": "别煮沸，蛋黄会起絮。",
      "visual_cue": "舀起一勺落下成缎带状"
    },
    {
      "n": 6,
      "text": "盛进小碗放凉，撒剩余肉桂粉，冷藏一小时后食用。",
      "time_min": 64,
      "heat": "无火",
      "tip": "凉透后质地会更紧实。",
      "visual_cue": "表面结一层薄皮，撒粉均匀"
    }
  ],
  "tips": [
    "用厚底的不粘锅煮，牛奶不易糊底，省心不少。",
    "喜欢更浓的奶香可在最后加两勺炼乳拌匀。",
    "冷藏过夜风味更足，切块也不散。"
  ],
  "common_mistakes": [
    "全程不搅动，锅底结一层焦糊，整锅带苦味。",
    "蛋黄直接倒进热米糊里，瞬间结成蛋花块。",
    "煮到完全干硬，凉透后变成一块米糕切不动。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "800毫升:800毫升",
      "note": "奶香变椰香，糖可减二十克。"
    },
    {
      "original": "红糖",
      "substitute": "白糖",
      "ratio": "120克:100克",
      "note": "颜色更浅，焦糖香略淡。"
    }
  ],
  "variations": [
    "加一勺可可粉同煮，做成巧克力口味的版本。",
    "表面撒一把烤椰蓉，吃起来口感更有层次。"
  ],
  "serving_suggestion": "盛在小陶碗里，配一杯浓咖啡，是利马冬天的常见甜品。",
  "storage": "冷藏三天，表面盖保鲜膜防干；冷食为主，不建议冷冻。",
