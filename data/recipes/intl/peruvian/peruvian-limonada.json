  "equipment": [
    "榨汁器",
    "大壶",
    "滤网",
    "搅拌勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "柠檬逐个对半切开，用榨汁器压出汁液，用滤网滤掉籽和粗纤维。",
      "time_min": 8,
      "heat": "无火",
      "tip": "滤掉籽和粗纤维，喝起来才清爽不发苦。",
      "visual_cue": "柠檬汁清澈透亮，没有杂质"
    },
    {
      "n": 2,
      "text": "薄荷嫩叶摘下来，留几片完整叶子备用，其余粗略撕开。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用手撕开比用刀切碎，更容易释放香气。",
      "visual_cue": "叶片边缘破损，香气扑鼻"
    },
    {
      "n": 3,
      "text": "白糖加少量清水小火煮到完全化开，晾到不烫手。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖只要化开就行，不必熬成浓稠糖浆。",
      "visual_cue": "糖水清澈，看不到颗粒"
    },
    {
      "n": 4,
      "text": "大壶里倒入柠檬汁、糖水、盐和剩下的清水，搅匀尝味。",
      "time_min": 4,
      "heat": "无火",
      "tip": "加上一小撮盐，能让酸甜味道更立体。",
      "visual_cue": "液体均匀，微酸带甜"
    },
    {
      "n": 5,
      "text": "放入撕开的薄荷叶，冷藏二十分钟让香气浸出来。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏浸二十分钟，比现调更有薄荷香气。",
      "visual_cue": "液体清凉，薄荷味很明显"
    },
    {
      "n": 6,
      "text": "喝前加满冰水或冰块，放上完整薄荷叶和柠檬片装饰。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冰块最后加，风味才不会被水稀释。",
      "visual_cue": "杯壁挂霜，杯口有薄荷叶"
    }
  ],
  "tips": [
    "柠檬汁一定要滤掉籽，否则会带苦味。",
    "薄荷撕开而不是切碎，香气释放得更充分。",
    "加一小撮盐能让柠檬的酸甜更平衡。"
  ],
  "common_mistakes": [
    "柠檬连白皮一起榨，喝起来发苦。",
    "白糖直接倒进冷水，化不开沉在壶底。",
    "不冰镇就上桌，薄荷香气出不来。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "6 个:7 个",
      "note": "酸度更高，糖量增加十克。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "90 克:100 克",
      "note": "风味更柔和，需用温水化开。"
    }
  ],
  "variations": [
    "加几片生姜，做成微辣的暖身版本。",
    "兑入少许气泡水，气泡感让口感更活泼。"
  ],
  "serving_suggestion": "配海鲜冷盘和炸物同喝，是秘鲁海滨餐馆里最常见的消暑饮料。",
  "storage": "冷藏两天内喝完，薄荷叶当天取用，久放会发黑变味。",
