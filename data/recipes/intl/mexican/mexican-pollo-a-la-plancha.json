  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "碗",
    "夹子",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨后片成两厘米厚的大片，用刀背轻拍松肉纤维。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拍松能让腌料渗进去，肉也更嫩不柴。",
      "visual_cue": "肉片厚薄均匀，表面略松"
    },
    {
      "n": 2,
      "text": "橙子和青柠分别挤汁，大蒜拍碎，把盐、黑胡椒、孜然、牛至和红椒粉一起调成渍汁。",
      "time_min": 7,
      "heat": "无火",
      "tip": "酸汁不要超过两小时，久浸会让肉发粉。",
      "visual_cue": "腌汁橙黄清亮，香料浮在表面"
    },
    {
      "n": 3,
      "text": "鸡腿肉放进渍汁里抓匀，盖保鲜膜冷藏浸味四十分钟。",
      "time_min": 45,
      "heat": "无火",
      "tip": "腌四十分钟够入味，别放冰箱过夜。",
      "visual_cue": "肉片浸在汁里，颜色变深"
    },
    {
      "n": 4,
      "text": "洋葱切成厚圈，平底锅烧热倒橄榄油，下洋葱圈煎两分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱先煎出焦边，铺盘时香气更足。",
      "visual_cue": "洋葱圈边缘焦黄，微微软塌"
    },
    {
      "n": 5,
      "text": "把洋葱推到锅边，鸡腿肉沥干渍汁后带皮侧朝下放入锅中。",
      "time_min": 3,
      "heat": "中火",
      "tip": "一定要沥干，带汁下锅只会变成水煮。",
      "visual_cue": "肉片贴锅发出响声，无积水"
    },
    {
      "n": 6,
      "text": "中火煎六分钟不要翻动，让带皮那侧形成金黄的脆壳。",
      "time_min": 7,
      "heat": "中火",
      "tip": "别急着翻，带皮侧定型了才不会粘锅。",
      "visual_cue": "带皮侧金黄焦脆，边缘收缩"
    },
    {
      "n": 7,
      "text": "翻过来再煎四分钟，用夹子按压厚处让其均匀受热。",
      "time_min": 5,
      "heat": "中火",
      "tip": "按压厚的地方，受热才均匀不夹生。",
      "visual_cue": "两侧焦黄，按压有弹性"
    },
    {
      "n": 8,
      "text": "出锅静置五分钟再切条，配洋葱圈挤上青柠汁即可。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置五分钟肉汁才锁得住，切开不流汁。",
      "visual_cue": "切成长条状，肉汁清亮不流失"
    }
  ],
  "tips": [
    "鸡腿肉拍松再浸味，入味快也更嫩。",
    "渍汁里的酸不要超过两小时，肉会发粉。",
    "下锅前一定沥干，否则只能煮出一锅水。",
    "煎好静置五分钟再切，肉汁才不流失。"
  ],
  "common_mistakes": [
    "肉片太厚不拍松，煎完外焦里生。",
    "带着渍汁直接下锅，锅里全是水汽煎不脆。",
    "反复翻动，带皮侧破了也形不成脆壳。",
    "刚出锅就切，肉汁全流到盘子里。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600克:600克",
      "note": "更瘦易柴，煎的时间各减一分钟。"
    },
    {
      "original": "橙子",
      "substitute": "菠萝",
      "ratio": "150克:150克",
      "note": "酸味更重，腌的时间减十分钟。"
    }
  ],
  "variations": [
    "配一勺牛油果酱同吃，口感更润滑。",
    "撒一点辣椒粉，做成微辣版本更下饭。",
    "切片后夹进玉米饼，做成简易塔可。"
  ],
  "serving_suggestion": "切条铺盘，配洋葱圈、牛油果酱和温热玉米饼，挤上青柠汁就是一顿正餐。",
  "storage": "冷藏可放两天，复热用平底锅小火两面各一分钟，微波会让肉变柴。",
