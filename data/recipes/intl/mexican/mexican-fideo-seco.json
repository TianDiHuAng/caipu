  "steps": [
    {
      "n": 1,
      "text": "面条掰成五厘米左右的短段，抖掉碎末装盘备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "掰得长短一致，煎的时候才受热均匀。",
      "visual_cue": "面段整齐，碎末抖净"
    },
    {
      "n": 2,
      "text": "番茄切块，洋葱切小丁，蒜切成末，香菜切碎备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "番茄切小块些，炒的时候更容易出汁。",
      "visual_cue": "番茄块小，配料备齐"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下面条段中小火煎到通体金黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "面条要不断翻动，煎到发黄才有坚果香。",
      "visual_cue": "面段金黄，香气焦香"
    },
    {
      "n": 4,
      "text": "把面段推到一边，下洋葱丁和蒜末炒到透明出香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱蒜末用锅边的油炒，香气更集中。",
      "visual_cue": "洋葱透明，蒜末微黄"
    },
    {
      "n": 5,
      "text": "加番茄块炒出红色汤汁，撒盐翻匀后再倒入清水。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出汁再加水，汤才红亮有味。",
      "visual_cue": "汤汁变红，面段上色"
    },
    {
      "n": 6,
      "text": "转小火盖盖焖八分钟至汤汁收干，撒奶酪和香菜。",
      "time_min": 8,
      "heat": "小火",
      "tip": "焖到面条吸干汤汁就停，再焖会发糊。",
      "visual_cue": "汤汁收干，面条松散"
    }
  ],
  "tips": [
    "面条先干煎到金黄，香气才够浓。",
    "番茄炒出红汁再加水，汤色才好看。",
    "焖到汤汁收干即关火，久焖会粘锅。"
  ],
  "common_mistakes": [
    "面条不煎直接下水，煮成一锅糊。",
    "水加太多，最后收不干变成汤面。",
    "全程大火焖到底，锅底焦糊结出厚黑层。"
  ],
  "substitutions": [
    {
      "original": "面条",
      "substitute": "通心粉",
      "ratio": "250 克:250 克",
      "note": "煎制时间加两分钟。"
    },
    {
      "original": "奶酪",
      "substitute": "酸奶油",
      "ratio": "50 克:50 克",
      "note": "关火后拌入，更清爽。"
    }
  ],
  "variations": [
    "加一勺辣椒酱同炒，酸辣更开胃。",
    "放一小把玉米粒，甜味和口感更丰富。"
  ],
  "serving_suggestion": "趁热装盘，配煎蛋或豆泥就是完整一餐。",
  "storage": "冷藏一天，复热加少许水小火焖透。",
