          "name_en": "cheese",
          "amount": 200,
          "unit": "g",
          "note": "擦丝,切达与马苏里拉混合",
          "optional": false
        },
        {
          "name": "鸡胸肉",
          "name_en": "chicken breast",
          "amount": 250,
          "unit": "g",
          "note": "煮熟撕丝",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
