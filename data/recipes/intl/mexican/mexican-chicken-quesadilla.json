          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "青柠",
          "name_en": "lime",
          "amount": 20,
          "unit": "g",
          "note": "切角",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉冷水下锅煮十二分钟，捞出稍凉后撕成细丝。",
      "time_min": 14,
      "heat": "中火",
      "tip": "煮到筷子能轻松插入即可，别煮过头。",
      "visual_cue": "肉丝纤维分明，不带粉色"
    },
    {
      "n": 2,
      "text": "洋葱切成细丝，小米辣切成薄圈，香菜切碎备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱切得越细，煎后越容易软化。",
      "visual_cue": "洋葱丝均匀，辣椒圈薄"
    },
    {
      "n": 3,
      "text": "平底锅少油把洋葱丝与小米辣炒软，加盐与黑胡椒调味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味才出来。",
      "visual_cue": "洋葱丝软塌，呈半透明状"
    },
    {
      "n": 4,
      "text": "把鸡丝倒入锅中与洋葱同炒一分钟，关火拌入香菜。",
      "time_min": 3,
      "heat": "中火",
      "tip": "鸡丝最后炒，久炒会发干。",
      "visual_cue": "馅料混合均匀，香气足"
    },
    {
      "n": 5,
      "text": "平底锅刷一层植物油，放一张面粉薄饼，半面铺奶酪丝、鸡丝馅再盖奶酪丝。",
      "time_min": 5,
      "heat": "小火",
      "tip": "奶酪上下夹住馅料，才能粘合成型。",
      "visual_cue": "奶酪均匀铺开，边缘留一指宽"
    },
    {
      "n": 6,
      "text": "对折面粉薄饼轻压，小火煎三分钟至底面金黄酥脆。",
      "time_min": 4,
      "heat": "小火",
      "tip": "压的时候用锅铲轻按，别把馅挤出来。",
      "visual_cue": "底面金黄，奶酪开始融化"
    },
    {
      "n": 7,
      "text": "翻面再煎两分钟，出锅切三角块配青柠角上桌。",
      "time_min": 4,
      "heat": "小火",
      "tip": "两面都要煎透，切开时奶酪能拉丝。",
      "visual_cue": "切面奶酪拉丝，饼皮酥脆"
    }
  ],
  "tips": [
    "奶酪要用易融的品种，切达混合马苏里拉拉丝效果最好。",
    "馅料不要太湿，否则面粉薄饼会软塌不脆。",
    "煎好静置一分钟再切，奶酪不容易流出来。"
  ],
  "common_mistakes": [
    "火太大直接煎，饼皮焦黑而奶酪还没化。",
    "馅料塞太满，对折时全部挤到锅外。",
    "鸡胸肉煮过头，撕成丝后干柴难以下咽。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "250 克:250 克",
      "note": "口感更嫩，煮制时间延长三分钟。"
    },
    {
      "original": "面粉薄饼",
      "substitute": "玉米薄饼",
      "ratio": "4 张:4 张",
      "note": "香气更足但易裂，需小火慢煎。"
    }
  ],
  "variations": [
    "加一勺黑豆泥同铺，口感更厚实。",
    "把鸡丝换成炒香的蘑菇，做成素食版芝士饼。"
  ],
  "serving_suggestion": "切三角块摆盘，配青柠角、酸奶油或莎莎酱蘸食。",
  "storage": "冷藏两天；复热用平底锅小火干煎两分钟，恢复酥脆。",
