    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西葫芦洗净不去皮，切成一厘米见方的小丁备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮留着口感更脆，切丁大小一致才同熟。",
      "visual_cue": "西葫芦丁整齐，切口水润"
    },
    {
      "n": 2,
      "text": "洋葱切成小丁，蒜切成末，番茄切成滚刀块备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "番茄切大块些，炒的时候才不化成水。",
      "visual_cue": "洋葱丁均匀，番茄块完整"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下洋葱丁中火炒到透明出香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒到透明甜味才出，急火只会有生味。",
      "visual_cue": "洋葱透明，香气散出"
    },
    {
      "n": 4,
      "text": "加蒜末炒香，倒入西葫芦丁和玉米粒翻炒两分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "西葫芦别炒太久，保持微脆口感最好。",
      "visual_cue": "西葫芦边缘微透明"
    },
    {
      "n": 5,
      "text": "放番茄块炒出汁，盖盖焖五分钟，加盐和黑胡椒调味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "焖几分钟让味道融合，但别焖到软烂。",
      "visual_cue": "汤汁微红，菜丁完整"
    },
    {
      "n": 6,
      "text": "关火撒上奶酪丝，用余温拌到奶酪微微融化即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "奶酪靠余温化开就够，久煮会拉丝成团。",
      "visual_cue": "奶酪半融，香气浓郁"
    }
  ],
  "tips": [
    "西葫芦不去皮切丁，口感更脆不易烂。",
    "番茄炒出汁后再焖，味道才融进去。",
    "奶酪关火后撒，靠余温化开最香。"
  ],
  "common_mistakes": [
    "西葫芦炒太久，出水变成一锅软泥。",
    "番茄一开始就下锅，炒化后汤汁变稀。",
    "奶酪和菜一起久煮，结成一块团的。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "南瓜",
      "ratio": "600 克:600 克",
      "note": "需多焖三分钟至软。"
    },
    {
      "original": "奶酪",
      "substitute": "酸奶油",
      "ratio": "60 克:60 克",
      "note": "关火后拌入，更清爽。"
    }
  ],
  "variations": [
    "加一小勺辣椒粉同炒，辣香更明显更开胃。",
    "拌入一把煮熟的米饭，直接当主食吃。"
  ],
  "serving_suggestion": "趁热吃或放温当配菜，配玉米饼和豆泥很地道。",
  "storage": "冷藏两天，复热小火加少许水焖透。",
