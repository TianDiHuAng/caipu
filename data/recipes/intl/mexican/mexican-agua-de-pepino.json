          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "搅拌机",
    "细筛",
    "大壶",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净不去皮，切成两厘米厚的块，皮的绿色是饮品颜色的来源。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮留着颜色才翠绿好看，老黄瓜要削掉硬皮。",
      "visual_cue": "黄瓜块翠绿，切面多汁"
    },
    {
      "n": 2,
      "text": "青柠先滚一滚再对半切，挤出汁并滤掉籽，约得八十毫升。",
      "time_min": 6,
      "heat": "无火",
      "tip": "滚一下再挤，出汁更多，也更好挤。",
      "visual_cue": "汁液清亮，看不见籽粒"
    },
    {
      "n": 3,
      "text": "黄瓜块和一半清水倒进搅拌机，高速打一分钟到完全细腻无颗粒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先加一半水再打，打得动也打得细。",
      "visual_cue": "浆液翠绿，质地顺滑"
    },
    {
      "n": 4,
      "text": "打好的浆用细筛过滤进大壶，用勺子按压残渣把汁挤干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "滤掉纤维喝起来才清爽，不滤会挂嗓子。",
      "visual_cue": "滤液清亮，渣子干松"
    },
    {
      "n": 5,
      "text": "加入余下的清水、青柠汁、白糖和一撮盐，搅到糖完全化开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐别省，一撮盐能把黄瓜的清甜托出来。",
      "visual_cue": "液体透绿，味道清甜"
    },
    {
      "n": 6,
      "text": "装壶冷藏二十分钟，喝前加冰块，杯口挂一片黄瓜更好看。",
      "time_min": 23,
      "heat": "无火",
      "tip": "冰过的黄瓜味更明显，常温喝会带一点生青气。",
      "visual_cue": "杯壁挂雾，颜色翠绿"
    }
  ],
  "tips": [
    "墨西哥街头的水吧里，黄瓜水是夏天卖得最快的一种。",
    "黄瓜皮别削，颜色和清香全靠它，老黄瓜才需要去皮。",
    "糖量自己调，但青柠汁一定要足，酸味撑起来才不腻。"
  ],
  "common_mistakes": [
    "黄瓜不打细就过滤，渣子里全是块，喝起来塞牙。",
    "青柠汁放太少，整壶只有黄瓜的生味，显得寡淡。",
    "不冰镇直接喝，青味重，很多人第一口就皱眉头。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "150克:160克",
      "note": "柠檬酸味更柔，糖可减到三十克。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "40克:50克",
      "note": "蜂蜜遇冷水不易化，先用少量温水调开再倒入。"
    }
  ],
  "variations": [
    "加一把薄荷叶一起打，香气更凉，适合配辣味的塔可。",
    "把黄瓜换成蜜瓜，做成蜜瓜水，甜度需减十克糖。"
  ],
  "serving_suggestion": "冰镇后倒进高杯，配烤肉塔可或者辣味小吃，解辣又解渴。",
  "storage": "冷藏可存一天，久放会分层变味；喝前摇匀，出现酸味即弃。",
