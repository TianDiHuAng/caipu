          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
