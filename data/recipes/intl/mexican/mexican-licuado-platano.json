      "items": [
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 30,
          "unit": "g",
          "note": "按甜度调整",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 100,
          "unit": "ml",
          "note": "冰块替代用",
