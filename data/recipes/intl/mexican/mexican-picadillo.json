  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "锅铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切一厘米见方的小丁，泡在清水里防止氧化变黑。",
      "time_min": 10,
      "heat": "无火",
      "tip": "土豆丁切小一点，和牛肉才一起熟。",
      "visual_cue": "土豆丁方正，泡水后更白净"
    },
    {
      "n": 2,
      "text": "洋葱、青椒、胡萝卜切小丁，大蒜切末，番茄切小块备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "蔬菜切得比土豆丁略小，入口才协调。",
      "visual_cue": "各料切好分装，丁块均匀"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，下洋葱丁中火炒三分钟至软塌透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱先炒软，牛肉的腥气才被压住。",
      "visual_cue": "洋葱透明软塌，锅底泛油"
    },
    {
      "n": 4,
      "text": "下绞碎的牛肉，用锅铲压散炒五分钟至变色出油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "牛肉要压散炒到颗颗分明，不要结块。",
      "visual_cue": "牛肉粒分明，锅底有汤汁"
    },
    {
      "n": 5,
      "text": "加蒜末、孜然、牛至和黑胡椒炒一分钟，再下番茄膏炒匀上色。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "番茄膏炒一下去生味，颜色也更红亮。",
      "visual_cue": "牛肉粒裹上红亮酱色"
    },
    {
      "n": 6,
      "text": "倒入土豆丁、胡萝卜丁和青椒丁翻炒两分钟，加盐调味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蔬菜翻匀就够，久炒会失去脆感。",
      "visual_cue": "蔬菜与牛肉混匀，颜色丰富"
    },
    {
      "n": 7,
      "text": "下番茄块和半碗清水，盖盖小火焖十五分钟至土豆软烂。",
      "time_min": 18,
      "heat": "小火",
      "tip": "焖到土豆能用铲子切开，汤汁也收得正好。",
      "visual_cue": "土豆软烂，汤汁浓稠"
    },
    {
      "n": 8,
      "text": "开盖中火收汁三分钟，关火撒香菜碎，直接盛盘上桌。",
      "time_min": 5,
      "heat": "中火",
      "tip": "收汁到能挂在食材上就好，太干不好卷饼。",
      "visual_cue": "汤汁紧裹食材，香菜翠绿"
    }
  ],
  "tips": [
    "土豆丁切小一点，才和牛肉一起熟透。",
    "牛肉下锅要压散，炒到颗粒分明不结块。",
    "番茄膏先炒去生味，颜色和香气都更好。",
    "收汁别收太干，留一点汤汁才方便卷饼。"
  ],
  "common_mistakes": [
    "牛肉不压散，炒完结成一大块硬团。",
    "土豆丁切得太大，牛肉老了土豆还硬。",
    "不加水直接炒，锅底糊锅还发苦。",
    "收汁收到全干，卷饼时又干又散。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡腿肉",
      "ratio": "350克:350克",
      "note": "口感更嫩，炒的时间减两分钟。"
    },
    {
      "original": "土豆",
      "substitute": "南瓜",
      "ratio": "250克:250克",
      "note": "甜味更明显，焖的时间减五分钟。"
    }
  ],
  "variations": [
    "加一把葡萄干同焖，甜咸交替更地道。",
    "最后撒一点碎奶酪，融化的口感更浓。",
    "加一勺辣椒酱同炒，辣味会更突出。"
  ],
  "serving_suggestion": "盛盘后配温热玉米饼，卷起来吃或直接盖在米饭上都很下饭。",
  "storage": "冷藏可放三天，复热加一勺清水小火加热，避免炒干。",
