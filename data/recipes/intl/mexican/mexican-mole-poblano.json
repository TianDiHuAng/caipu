  "equipment": [
    "平底锅",
    "搅拌机",
    "汤锅",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干辣椒去籽掰成小段，干锅小火烘到边缘微焦、散出辣香。",
      "time_min": 10,
      "heat": "小火",
      "tip": "辣椒只烘到出香，发黑整锅酱都会苦。",
      "visual_cue": "辣椒边缘深红，香味刺鼻。"
    },
    {
      "n": 2,
      "text": "芝麻、杏仁与葡萄干分别干锅炒香，坚果炒到微黄即可。",
      "time_min": 10,
      "heat": "小火",
      "tip": "坚果炒过头会发苦，别离开锅边。",
      "visual_cue": "芝麻微微跳动，杏仁泛油光。"
    },
    {
      "n": 3,
      "text": "番茄对半切开、大蒜带皮，与洋葱片一起在平底锅上烤到表面起泡。",
      "time_min": 12,
      "heat": "中火",
      "tip": "烤出焦斑，酱底才有烟熏的深味。",
      "visual_cue": "番茄皮起皱发黑，洋葱边缘焦黄。"
    },
    {
      "n": 4,
      "text": "面包撕块烤到干脆，与烤好的蔬菜、坚果、香料一起放入搅拌机。",
      "time_min": 8,
      "heat": "小火",
      "tip": "分批打，太稠时加少量高汤推动。",
      "visual_cue": "搅拌机里呈粗颗粒糊状。"
    },
    {
      "n": 5,
      "text": "加高汤把混合物打成顺滑的深褐色酱浆，倒入碗中备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打得越细，最后的口感越滑。",
      "visual_cue": "酱浆浓稠，能缓慢流动。"
    },
    {
      "n": 6,
      "text": "锅里倒植物油烧热，倒入酱浆中小火慢炒十分钟，不断搅拌防溅。",
      "time_min": 14,
      "heat": "中火",
      "tip": "这一步叫 freír la pasta，生酱必须炒熟才不涩。",
      "visual_cue": "酱体冒泡变稠，颜色加深。"
    },
    {
      "n": 7,
      "text": "加剩余高汤调稀，放肉桂粉与丁香，小火煮二十五分钟。",
      "time_min": 27,
      "heat": "小火",
      "tip": "慢煮让各种香味融合，火大了容易糊底。",
      "visual_cue": "酱体油亮，表面浮出红油。"
    },
    {
      "n": 8,
      "text": "放入黑巧克力与白糖，搅到完全融化，加盐调味。",
      "time_min": 10,
      "heat": "小火",
      "tip": "巧克力最后加，苦甜层次才清楚。",
      "visual_cue": "酱色转为深褐发亮。"
    },
    {
      "n": 9,
      "text": "撒上香菜碎，盛出备用或直接配炖好的鸡肉上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "酱要稠得能挂在肉上，太稀就再收一会儿。",
      "visual_cue": "勺子划过留痕，慢慢合拢。"
    }
  ],
  "tips": [
    "真正的 mole 有三十多种材料，这份是家用简化版，香味骨架齐全。",
    "炒酱时一定要小火并不断搅，溅出的热酱非常烫。",
    "做好冷藏一夜再吃，风味会明显更融合。"
  ],
  "common_mistakes": [
    "酱浆没炒透就直接加汤，成品带生辣椒的青涩味。",
    "火太大，酱底焦糊，整锅发苦无法挽救。"
  ],
  "substitutions": [
    {
      "original": "黑巧克力",
      "substitute": "可可粉加红糖",
      "ratio": "50g 对 20g 可可粉加 15g 红糖",
      "note": "用可可粉时糖量要再调，苦味略轻。"
    }
  ],
  "variations": [
    "摩尔酱在墨西哥各州版本不同，普埃布拉版偏甜、瓦哈卡版加更多香料、韦拉克鲁斯版更稀。"
  ],
  "serving_suggestion": "浇在炖鸡腿上，撒芝麻，配白饭与玉米饼。",
  "storage": "冷藏五天，冷冻三个月；复热时加少量高汤稀释，小火慢搅。",
