  "steps": [
    {
      "n": 1,
      "text": "番茄放入开水锅煮六分钟，煮到表皮裂开即可捞出。",
      "time_min": 9,
      "heat": "中火",
      "tip": "煮番茄去皮更容易，酱体也更顺滑。",
      "visual_cue": "番茄皮裂开，果肉变软。"
    },
    {
      "n": 2,
      "text": "小米辣去梗，与大蒜、洋葱一起放干锅小火烘三分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小米辣烘一下辣味更圆，别烘黑。",
      "visual_cue": "辣椒表面起小泡，蒜瓣带焦斑。"
    },
    {
      "n": 3,
      "text": "番茄撕去外皮，与烘好的辣椒、蒜、洋葱一起放入搅拌机。",
      "time_min": 5,
      "heat": "无火",
      "tip": "留几块番茄不打碎，口感更有层次。",
      "visual_cue": "酱体呈粗颗粒的橙红色。"
    },
    {
      "n": 4,
      "text": "加清水、盐与牛至，再打十秒让所有调料混合均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水别一次加太多，酱要能挂勺。",
      "visual_cue": "酱汁流动但不过稀。"
    },
    {
      "n": 5,
      "text": "倒出后挤入青柠汁，撒香菜碎，搅匀静置五分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "青柠汁现挤现用，放久会发苦。",
      "visual_cue": "酱面浮着香菜，闻起来酸辣。"
    }
  ],
  "tips": [
    "塔可摊的辣酱通常是室温用的，不必加热。",
    "辣度靠小米辣数量控制，一颗大约对应一个辣度档。",
    "配烤猪肉塔可时，淋酱后再挤一点青柠。"
  ],
  "common_mistakes": [
    "番茄煮过头，酱体水塌塌挂不住。",
    "青柠汁提前几小时挤好，酸味发苦。"
  ],
  "substitutions": [
    {
      "original": "小米辣",
      "substitute": "干辣椒",
      "ratio": "25g 对 15g",
      "note": "干辣椒需先泡软，辣味更沉。"
    }
  ],
  "variations": [
    "有的摊子会加一勺烤芝麻，酱带坚果香，配牛肉塔可更合适。"
  ],
  "serving_suggestion": "淋在塔可、烤玉米或烤肉上，也可作薯条蘸酱。",
  "storage": "冷藏五天，食用前搅匀，表面水分多的倒掉。",
