  "equipment": [
    "厚底炖锅",
    "木铲",
    "夹子",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肩肉切成五厘米见方的大块，用盐与黑胡椒抓匀，静置腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "块切大些，炖后才有纤维感。",
      "visual_cue": "肉块均匀裹上调料、表面干爽"
    },
    {
      "n": 2,
      "text": "洋葱切粗块，大蒜拍破，橙子对半挤汁，果皮留着备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "橙皮别丢，白色部分刮掉才不苦。",
      "visual_cue": "橙汁备好、果皮留用"
    },
    {
      "n": 3,
      "text": "厚底锅倒植物油中火烧热，猪肉块分批下锅煎至六面金黄。",
      "time_min": 12,
      "heat": "中火",
      "tip": "分批煎，锅里有空隙才上色。",
      "visual_cue": "肉块表面金黄微焦、油脂析出"
    },
    {
      "n": 4,
      "text": "下洋葱、大蒜、孜然、桂皮与香叶炒香，倒入橙汁与清水没过肉。",
      "time_min": 8,
      "heat": "中火",
      "tip": "液体刚到肉的八分高就够。",
      "visual_cue": "液体微沸、香料散开"
    },
    {
      "n": 5,
      "text": "加盖转小火炖七十分钟，中途翻动两次，直到筷子能轻松插透。",
      "time_min": 72,
      "heat": "小火",
      "tip": "保持微微冒泡，大滚肉会散。",
      "visual_cue": "肉质酥软、筷子轻松插入"
    },
    {
      "n": 6,
      "text": "开盖大火收干汤汁，用木铲把肉块压散成粗丝，煎到底部微脆。",
      "time_min": 10,
      "heat": "大火",
      "tip": "收干后再压散，肉丝才不烂。",
      "visual_cue": "肉丝松散、边缘微焦"
    }
  ],
  "tips": [
    "猪肩肉带点肥膜最好，炖出来才润而不柴。",
    "炖好后先收干汤汁再压散，肉丝才有嚼劲。",
    "最后大火煎一下边缘，焦香是这道菜的关键。"
  ],
  "common_mistakes": [
    "肉切得太小，炖完直接化成一锅碎渣。",
    "汤汁没收到位就压散，肉丝湿软出水。",
    "橙皮连白色部分一起下锅，整锅发苦。"
  ],
  "substitutions": [
    {
      "original": "猪肩肉",
      "substitute": "五花肉",
      "ratio": "1000g 对 900g",
      "note": "更油润，收汁时间需加长。"
    },
    {
      "original": "橙子",
      "substitute": "青柠",
      "ratio": "150g 对 100g",
      "note": "酸味更尖，糖可加 5g。"
    }
  ],
  "variations": [
    "烤箱版：炖好后摊在烤盘上，200℃ 烤 15 分钟收干。",
    "辣味版：加 5g 辣椒粉与孜然同炒。"
  ],
  "serving_suggestion": "夹进玉米饼，配洋葱碎、香菜与青柠角一起吃。",
  "storage": "冷藏 3 天，冷冻可存 2 个月，复热用平底锅煎脆。",
