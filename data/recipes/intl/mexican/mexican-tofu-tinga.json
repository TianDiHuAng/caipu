        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐用厨房纸压去水分，用手掰成不规则的小块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "掰出的粗糙截面更容易挂住酱汁。",
      "visual_cue": "豆腐块干爽，边缘毛糙"
    },
    {
      "n": 2,
      "text": "洋葱切细丝，番茄切小丁，香菜切碎分别装好。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱丝切细些，炒软后能融进酱里。",
      "visual_cue": "洋葱丝细长，番茄丁均匀"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下洋葱丝中火炒到边缘焦黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒出焦边才有甜味，别只炒到软。",
      "visual_cue": "洋葱边缘金黄，香气浓"
    },
    {
      "n": 4,
      "text": "加番茄丁和辣椒酱炒到出汁，撒孜然翻炒均匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒到塌软出汁，酱汁才浓不发水。",
      "visual_cue": "番茄成糊，酱色红亮"
    },
    {
      "n": 5,
      "text": "放入豆腐块轻推翻匀，转小火焖六分钟让酱汁入味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "豆腐别用铲子压，轻推才不散碎。",
      "visual_cue": "豆腐上色，酱汁浓厚"
    },
    {
      "n": 6,
      "text": "加盐调味，撒上香菜碎翻匀后盛入盘中上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜关火之后再拌进去，香气才够清新。",
      "visual_cue": "香菜翠绿，盘底少汁"
    }
  ],
  "tips": [
    "豆腐先压干水分，煎焖时才不出一锅水。",
    "辣椒酱按口味增减，先少放尝过再补。",
    "用手掰豆腐比刀切更挂酱，口感也更粗犷。"
  ],
  "common_mistakes": [
    "豆腐不压水直接下锅，炒出一盘汤水。",
    "用铲子大力翻动，豆腐全碎成豆渣。",
    "辣椒酱一次放太多，咸辣盖住豆腐味。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "白蘑菇",
      "ratio": "500 克:450 克",
      "note": "撕成条状，炒制时间缩短两分钟。"
    },
    {
      "original": "辣椒酱",
      "substitute": "番茄酱",
      "ratio": "40 克:50 克",
      "note": "不辣偏甜，需加三克甜椒粉补色。"
    }
  ],
  "variations": [
    "拌入一把玉米粒同炒，口感更丰富有嚼头。",
    "夹进玉米饼里做成塔可，配牛油果更香。"
  ],
  "serving_suggestion": "夹玉米饼或铺在脆片上吃，酸辣浓香最讨喜。",
  "storage": "冷藏一天，复热小火翻炒避免糊底。",
