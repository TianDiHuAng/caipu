  "steps": [
    {
      "n": 1,
      "text": "玉米剥成粒，用厨房纸吸掉表面的水分。这一步别急着翻动。",
      "time_min": 6,
      "heat": "无火",
      "tip": "吸干水，煎的时候才会上色，火候别过。",
      "visual_cue": "玉米粒干爽，颗粒饱满"
    },
    {
      "n": 2,
      "text": "炒锅放黄油小火化开，倒玉米粒摊平煎。这一步别急着翻动。",
      "time_min": 4,
      "heat": "中火",
      "tip": "别急着翻，等一面焦了再动，火候别过。",
      "visual_cue": "玉米粒底面微黄，黄油起泡"
    },
    {
      "n": 3,
      "text": "煎到玉米粒边缘带焦斑，盛出稍微放凉。这一步别急着翻动。",
      "time_min": 6,
      "heat": "中火",
      "tip": "焦斑是这道菜的灵魂，别煎得太干，火候别过。",
      "visual_cue": "颗粒焦亮，香气浓，状态稳定"
    },
    {
      "n": 4,
      "text": "趁温热拌入蛋黄酱和一半奶酪碎。这一步别急着翻动。",
      "time_min": 3,
      "heat": "无火",
      "tip": "温的时候拌，奶酪才会半融，火候别过。",
      "visual_cue": "酱体包裹，粒粒分明，状态稳定"
    },
    {
      "n": 5,
      "text": "挤入青柠汁，加盐和一半辣椒粉拌匀。这一步别急着翻动。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠最后放，酸香才清新，火候别过。",
      "visual_cue": "汁水裹匀，颜色橙黄，状态稳定"
    },
    {
      "n": 6,
      "text": "装杯，撒上剩余奶酪、辣椒粉和香菜碎。这一步别急着翻动。",
      "time_min": 3,
      "heat": "无火",
      "tip": "顶料最后撒，颜色才好看，火候别过。",
      "visual_cue": "表层雪白，红粉点缀，状态稳定"
    }
  ],
  "tips": [
    "玉米粒吸干水再煎，才煎得出焦斑，值得留意。",
    "趁温热拌酱，奶酪才会半融，值得留意。",
    "青柠汁最后挤，酸香才不闷，值得留意。"
  ],
  "common_mistakes": [
    "玉米没吸干，下锅一摊水汽，值得留意。",
    "煎得太干，咬着发硬，值得留意。",
    "酱拌太多，整杯糊成一团，值得留意。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "希腊酸奶",
      "ratio": "50 克:60 克",
      "note": "热量更低，酸味更明显。"
    },
    {
      "original": "奶酪",
      "substitute": "帕玛森奶酪",
      "ratio": "50 克:40 克",
      "note": "咸味更重，盐可减半。"
    }
  ],
  "variations": [
    "加一勺辣椒酱，辣味更冲，值得留意。",
    "撒一把碎培根，咸香更足，值得留意。"
  ],
  "serving_suggestion": "装杯用勺子挖着吃，配烤肉最好，效果更稳定。",
  "storage": "冷藏一天，复热下锅干炒两分钟，效果更稳定。",
