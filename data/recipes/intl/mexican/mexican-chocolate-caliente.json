      ]
    }
  ],
  "equipment": [
    "小锅",
    "打蛋器",
    "刨丝器",
    "马克杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑巧克力用刀切成小块，块越小融化越快，也不容易糊底。",
      "time_min": 8,
      "heat": "无火",
      "tip": "巧克力要切碎，整块下锅容易沉底结块。",
      "visual_cue": "碎块均匀，大小如豆"
    },
    {
      "n": 2,
      "text": "小锅倒入牛奶，放肉桂，小火加热到锅边冒小泡，不要煮沸。",
      "time_min": 8,
      "heat": "小火",
      "tip": "牛奶一沸就溢锅，还会起皮影响口感。",
      "visual_cue": "锅边起泡，香气浮起"
    },
    {
      "n": 3,
      "text": "关火捞出肉桂，把巧克力碎倒进热牛奶里，静置两分钟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先焖两分钟再搅，巧克力化得更匀。",
      "visual_cue": "巧克力表面变软发亮"
    },
    {
      "n": 4,
      "text": "用打蛋器朝一个方向搅两分钟，打到巧克力完全融化、液体顺滑。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火边搅边化，别让锅底糊出一层焦。",
      "visual_cue": "液体深褐，表面光亮"
    },
    {
      "n": 5,
      "text": "加白糖和一撮盐，继续搅一分钟，让味道完全融合。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐能压住巧克力的涩，甜味也更立体。",
      "visual_cue": "色泽油亮，闻着带咸香"
    },
    {
      "n": 6,
      "text": "倒进预热过的马克杯，表面撒一点肉桂粉，趁热喝。",
      "time_min": 3,
      "heat": "无火",
      "tip": "杯子先用热水烫过，喝到一半也不会凉。",
      "visual_cue": "杯口冒热气，表面细滑"
    }
  ],
  "tips": [
    "墨西哥热巧克力比一般可可更浓，还带一点肉桂的暖香。",
    "巧克力选可可含量六成以上的，甜度才够平衡。",
    "用打蛋器搅出细泡，喝起来口感更厚。"
  ],
  "common_mistakes": [
    "牛奶烧到滚沸，锅边一圈奶皮，喝起来发涩。",
    "巧克力没切碎直接丢进去，锅底结成一团化不开。",
    "全程大火，巧克力焦在锅底，整锅带苦味。"
  ],
  "substitutions": [
    {
      "original": "巧克力",
      "substitute": "可可粉",
      "ratio": "240克:60克",
      "note": "可可粉版需加三十克糖和十克黄油，口感更薄。"
    },
    {
      "original": "牛奶",
      "substitute": "燕麦奶",
      "ratio": "800毫升:800毫升",
      "note": "燕麦奶更清淡，肉桂可多加一克补香。"
    }
  ],
  "variations": [
    "加一小撮辣椒粉，做成带微辣的墨西哥风味，喝起来更暖。",
    "把牛奶换成一半淡奶油，做成更浓稠的节日版本。"
  ],
  "serving_suggestion": "配一块甜面包或者油条蘸着喝，是墨西哥冬天的经典吃法。",
  "storage": "现煮现喝最香，冷藏可存一天，复热须小火并重新搅匀。",
