  "equipment": [
    "烤箱",
    "平底锅",
    "刀",
    "砧板",
    "木铲",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面包横向对半切开，切面朝上，整齐摆进烤盘里。",
      "time_min": 4,
      "heat": "无火",
      "tip": "选紧实的法棍，太软的一烤就塌。",
      "visual_cue": "面包切面平整，厚约两厘米"
    },
    {
      "n": 2,
      "text": "切面薄薄抹一层黄油，烤箱一百八十度烤五分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先烤一次定型，免得后面被豆泥浸软。",
      "visual_cue": "切面微黄，边缘发脆"
    },
    {
      "n": 3,
      "text": "洋葱切碎，大蒜切末，番茄切小丁，香菜切碎分开放。",
      "time_min": 7,
      "heat": "无火",
      "tip": "番茄丁要去掉多余汁水，豆泥才不会稀。",
      "visual_cue": "配料分装，番茄丁无积水"
    },
    {
      "n": 4,
      "text": "平底锅倒橄榄油，下洋葱碎炒三分钟至透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透才有甜味，别只炒到变色。",
      "visual_cue": "洋葱透明柔软，无明显水"
    },
    {
      "n": 5,
      "text": "加蒜末与孜然炒三十秒，倒入煮熟的红腰豆压成粗泥。",
      "time_min": 3,
      "heat": "中火",
      "tip": "用锅铲背压，留一些整粒口感更好。",
      "visual_cue": "豆子八成压碎，仍有颗粒"
    },
    {
      "n": 6,
      "text": "加盐与两勺水小火炒五分钟，收干成能抹开的豆泥。",
      "time_min": 6,
      "heat": "小火",
      "tip": "豆泥要稠，抹在面包上才不会滑落。",
      "visual_cue": "豆泥抱团，铲起不流淌"
    },
    {
      "n": 7,
      "text": "把豆泥厚厚抹在烤过的面包上，撒满奶酪丝。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪铺满边缘，烤化后才会封住豆泥。",
      "visual_cue": "奶酪覆盖豆泥，边缘不漏"
    },
    {
      "n": 8,
      "text": "放回烤箱烤六分钟至奶酪融化起小泡，撒番茄丁与香菜。",
      "time_min": 7,
      "heat": "中火",
      "tip": "烤到奶酪冒泡就够，久了面包会硬。",
      "visual_cue": "奶酪金黄起泡，面包酥脆"
    }
  ],
  "tips": [
    "豆泥可以提前做好冷藏，早上抹上就能烤。",
    "加一勺墨西哥辣酱，味道更立体。",
    "奶酪选能拉丝的，配一半咸味奶酪更香。",
    "配一杯热巧克力，就是墨西哥式早餐。"
  ],
  "common_mistakes": [
    "面包不预烤直接抹豆泥，烤完底部湿软。",
    "豆泥炒太稀，从面包边上流到烤盘。",
    "奶酪放太少，烤不出封层，豆泥表面干裂。"
  ],
  "substitutions": [
    {
      "original": "红腰豆",
      "substitute": "黑豆",
      "ratio": "300克:300克",
      "note": "口感更绵，颜色更深。"
    },
    {
      "original": "奶酪",
      "substitute": "马苏里拉",
      "ratio": "150克:150克",
      "note": "拉丝效果更好，咸度略低。"
    }
  ],
  "variations": [
    "加一层炒香的香肠碎，做成肉末版本。",
    "把豆泥换成炒蛋，做成早餐版 molletes。"
  ],
  "serving_suggestion": "三人份早餐或小食，每人两个半片，配一杯热饮。",
  "storage": "现做现吃，冷藏后奶酪会变韧；豆泥可单独冷藏三天，复热后使用。",
