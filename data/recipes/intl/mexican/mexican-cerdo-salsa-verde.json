  "equipment": [
    "炖锅",
    "刀",
    "砧板",
    "平底锅",
    "木铲",
    "搅拌机"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成三厘米见方的块，用盐与黑胡椒抓匀腌十分钟。",
      "time_min": 11,
      "heat": "无火",
      "tip": "五花肉带皮切，炖出来胶质才足。",
      "visual_cue": "肉块大小均匀，表面挂盐"
    },
    {
      "n": 2,
      "text": "青椒去蒂切段，洋葱一半切块，大蒜拍裂，香菜留根洗净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香菜根别扔，香气比叶子还足。",
      "visual_cue": "配料分开放，香菜根完整"
    },
    {
      "n": 3,
      "text": "平底锅烧热，青椒、洋葱块与大蒜干锅烘五分钟至起焦斑。",
      "time_min": 6,
      "heat": "中火",
      "tip": "烘出焦斑是青酱的魂，直接煮就少了烟熏味。",
      "visual_cue": "青椒表皮起泡发黑"
    },
    {
      "n": 4,
      "text": "烘好的配料连同香菜与墨西哥辣椒放进搅拌机打成粗酱。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打粗一点留颗粒，口感比顺滑的好。",
      "visual_cue": "酱体浓稠带颗粒，颜色翠绿"
    },
    {
      "n": 5,
      "text": "炖锅倒橄榄油，把五花肉块煎至四面金黄，约需八分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "先煎出油，肉才不腻，酱也更香。",
      "visual_cue": "肉块四面金黄，锅底有油"
    },
    {
      "n": 6,
      "text": "放入剩下的洋葱块与孜然炒一分钟，炒到洋葱变软出香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "孜然遇油才出香，别干锅撒。",
      "visual_cue": "洋葱透明，孜然香气起"
    },
    {
      "n": 7,
      "text": "倒入打好的青酱翻炒两分钟，让酱色裹住每一块肉。",
      "time_min": 3,
      "heat": "中火",
      "tip": "青酱易糊锅，火不要大，勤翻。",
      "visual_cue": "肉块挂满绿酱，锅底不干"
    },
    {
      "n": 8,
      "text": "加高汤没过一半肉块，大火烧开转小火炖三十五分钟。",
      "time_min": 37,
      "heat": "小火",
      "tip": "汤别多，收尾要浓稠挂肉。",
      "visual_cue": "汤汁微沸，肉块酥软"
    },
    {
      "n": 9,
      "text": "开盖大火收汁至浓稠，挤入青柠汁，尝味补盐出锅。",
      "time_min": 5,
      "heat": "大火",
      "tip": "青柠最后放，酸香清爽不发苦。",
      "visual_cue": "酱汁浓稠裹肉，色深绿"
    }
  ],
  "tips": [
    "猪肩肉比五花瘦一些，喜欢清爽口感可以换。",
    "青酱一次多打些，冷藏能放四天，拌饭拌面都好用。",
    "怕辣就去掉墨西哥辣椒，青椒的清香已经够了。",
    "配白饭或玉米饼都行，汤汁别收太干。"
  ],
  "common_mistakes": [
    "青椒不烘直接打酱，味道生青，缺了烟熏香。",
    "大火猛煮不盖盖，肉没烂汤先干。",
    "青柠早放又久煮，整锅汤会发苦发涩。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪里脊",
      "ratio": "700克:700克",
      "note": "更瘦，炖制时间减十分钟。"
    },
    {
      "original": "青椒",
      "substitute": "青尖椒",
      "ratio": "250克:250克",
      "note": "辣度上升，减辣椒用量。"
    }
  ],
  "variations": [
    "加一把煮熟的红腰豆同炖，做成豆子青酱猪肉，饱腹感更强。",
    "把肉换成鸡腿块，炖二十分钟即可，是常见的青酱鸡。"
  ],
  "serving_suggestion": "三人份主菜，配白饭、玉米饼和一份豆泥，汤汁用来拌饭最香。",
  "storage": "冷藏两天内吃完，复热小火加两勺水；青酱含香菜易变味，不建议冷冻。",
