  "equipment": [
    "平底锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄切小块，洋葱和青椒切成小丁，香菜切碎分别装盘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "配料切得细小些，炒出的酱汁才够浓稠。",
      "visual_cue": "配料细碎，番茄多汁，状态稳定"
    },
    {
      "n": 2,
      "text": "平底锅倒一半植物油，下洋葱丁中火炒到边缘透明出香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味才融进番茄酱里。",
      "visual_cue": "洋葱透明，油面发亮，状态稳定"
    },
    {
      "n": 3,
      "text": "加青椒丁和番茄块翻炒，撒盐，中小火煮到番茄化成酱。",
      "time_min": 6,
      "heat": "小火",
      "tip": "番茄炒到软烂出汁，酱汁才挂得住蛋。",
      "visual_cue": "酱汁浓稠，颜色红亮，状态稳定"
    },
    {
      "n": 4,
      "text": "另起锅倒剩余植物油，把玉米饼两面各煎三十秒热透。",
      "time_min": 4,
      "heat": "中火",
      "tip": "玉米饼煎过才香，也不会被酱汁泡烂。",
      "visual_cue": "饼面微焦，边缘卷起，状态稳定"
    },
    {
      "n": 5,
      "text": "同一锅里逐个打入鸡蛋，小火煎到蛋白凝固蛋黄还软。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火慢煎，蛋白才不焦而蛋黄保持流心。",
      "visual_cue": "蛋白凝固，蛋黄微颤，状态稳定"
    },
    {
      "n": 6,
      "text": "把煎蛋放在玉米饼上，浇上热番茄酱汁，撒香菜碎。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酱汁要浇热的，蛋和饼的温度才一致。",
      "visual_cue": "蛋卧饼上，酱汁覆面，状态稳定"
    }
  ],
  "tips": [
    "玉米饼先煎热再上酱，才不会泡软塌掉。，值得留意。",
    "番茄炒到成酱，浇上去才挂得住蛋。，值得留意。",
    "小火煎蛋，蛋白不焦蛋黄还流心。，值得留意。"
  ],
  "common_mistakes": [
    "玉米饼不煎直接装盘，被酱汁泡成糊。，务必避免。",
    "大火煎蛋，边缘焦脆蛋黄却还是凉的。，务必避免。",
    "番茄没炒透，酱汁水汪汪没有厚度。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "北豆腐",
      "ratio": "210 克:250 克",
      "note": "切片煎黄后代替，素版也好吃。"
    },
    {
      "original": "青椒",
      "substitute": "小米辣",
      "ratio": "80 克:15 克",
      "note": "辣度更冲，盐减一克。"
    }
  ],
  "variations": [
    "上面加一勺炒豆泥，吃起来更饱腹。，也很受欢迎。",
    "撒一把奶酪丝，热酱汁会把奶酪化开。，也很受欢迎。"
  ],
  "serving_suggestion": "趁热上桌，配一杯冰柠檬水，早餐吃得很满足。",
  "storage": "现做现吃，番茄酱汁可冷藏两天，单独复热后再浇。",
