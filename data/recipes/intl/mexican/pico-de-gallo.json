          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 15,
          "unit": "ml",
          "note": "增亮",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "菜刀",
    "碗",
    "柠檬夹"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄纵向剖开，用勺子刮去籽瓤，再切成 0.5cm 见方的小丁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "去瓤后酱体才不会一汪水。",
      "visual_cue": "番茄丁整齐、砧板无明显汁水"
    },
    {
      "n": 2,
      "text": "白洋葱切成同样大小的细丁，用清水冲一遍沥干降低辛辣。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冲水能去掉呛人的硫化物。",
      "visual_cue": "洋葱丁透亮、辛辣味变淡"
    },
    {
      "n": 3,
      "text": "青柠挤汁取 30ml，与 4g 盐、1g 黑胡椒混匀成调味汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "青柠汁要新鲜挤，风味才活。",
      "visual_cue": "汁液清亮、闻起来酸香"
    },
    {
      "n": 4,
      "text": "番茄丁、洋葱丁与香菜碎放入碗中，倒入调味汁与 15ml 橄榄油拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "轻拌不要压,番茄才不会烂。",
      "visual_cue": "颗粒分明、表面油亮"
    },
    {
      "n": 5,
      "text": "覆膜冷藏静置 15 分钟让味道融合，食用前再拌一次。",
      "time_min": 16,
      "heat": "无火",
      "tip": "静置久了出水，半小时内吃完最好。",
      "visual_cue": "汁水微出、香气融合"
    }
  ],
  "tips": [
    "番茄和洋葱切得越小越均匀，口感越好。",
    "青柠汁是灵魂，别用白醋代替，酸味会发尖。",
    "现做现吃最香，放久了出水，风味分层。"
  ],
  "common_mistakes": [
    "番茄不去瓤，半小时后碗底积一层水。",
    "洋葱不冲水，辣味盖过所有香气。",
    "用刀背猛剁，番茄被砸成糊，失去颗粒感。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "40g 对 50g",
      "note": "酸度略低，可多加 5ml 汁。"
    },
    {
      "original": "香菜",
      "substitute": "欧芹",
      "ratio": "20g 对 20g",
      "note": "香气更清，适合不爱香菜者。"
    }
  ],
  "variations": [
    "辣味版：加 1 根青辣椒切碎同拌。",
    "芒果版：加 100g 芒果丁做成水果莎莎。"
  ],
  "serving_suggestion": "配玉米片、烤肉或卷饼，也可浇在煎鱼上。",
  "storage": "冷藏 1 天，食用前沥去多余汁水。",
