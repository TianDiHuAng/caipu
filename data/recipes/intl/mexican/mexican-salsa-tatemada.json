          "name_en": "lime",
          "amount": 1,
          "unit": "piece",
          "note": "挤汁",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 15,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "铸铁锅",
    "研钵",
    "砧板",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "铸铁锅烧到微微冒烟，把番茄整颗放进去干烤，不用放油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "锅一定要够热，番茄皮才会起泡脱落。",
      "visual_cue": "番茄底部出现黑色焦痕，表皮鼓起"
    },
    {
      "n": 2,
      "text": "翻动番茄让四面都烤到，直到整颗变软、皮面大面积发黑。",
      "time_min": 8,
      "heat": "中火",
      "tip": "烤到软塌出汁才对，硬邦邦的番茄不够甜。",
      "visual_cue": "番茄软塌出汁，焦痕分布均匀"
    },
    {
      "n": 3,
      "text": "同一口锅里放入墨西哥辣椒与洋葱厚片，烤到表面带焦斑。",
      "time_min": 6,
      "heat": "中火",
      "tip": "辣椒烤过辣度会降一点，烟熏味反而更明显。",
      "visual_cue": "辣椒皮起泡发白，洋葱边缘透明带焦"
    },
    {
      "n": 4,
      "text": "大蒜带皮丢进锅边烤香，剥皮后与烤好的蔬菜一起放进研钵。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜带皮烤不会糊，剥开里面是软糯的蒜泥。",
      "visual_cue": "蒜瓣按下去发软，皮一捏就脱"
    },
    {
      "n": 5,
      "text": "用研杵把材料捣成带颗粒的粗酱，保留一点口感。",
      "time_min": 6,
      "heat": "无火",
      "tip": "捣比机器打更香，但也别偷懒留整块番茄。",
      "visual_cue": "酱体粗细不均，能见到细小的番茄粒"
    },
    {
      "n": 6,
      "text": "加盐和青柠汁拌匀，尝一口再决定要不要补一点盐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁最后才加，酸味才清亮，久煮会发闷。",
      "visual_cue": "酱色深红发暗，酸香明显"
    },
    {
      "n": 7,
      "text": "拌入香菜碎装罐，静置十分钟让味道融合后再用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "放一会儿再吃，烟熏与酸味才会走在一起。",
      "visual_cue": "表面泛起少量汁水，香菜均匀分布"
    }
  ],
  "tips": [
    "配烤肉、煎蛋、玉米片都合适，是万能桌上酱。",
    "番茄换成一半樱桃番茄，甜度会更高。",
    "喜欢更辣就多放一根辣椒，不用去籽。",
    "用石臼捣出来的口感明显比机器打好。"
  ],
  "common_mistakes": [
    "锅不够热就下番茄，出水变成炖番茄而不是烤。",
    "烤到番茄全黑才起锅，整锅酱都带焦苦。",
    "香菜太早拌进去，放一会儿就发黄出水变味。"
  ],
  "substitutions": [
    {
      "original": "墨西哥辣椒",
      "substitute": "青椒",
      "ratio": "40克:80克",
      "note": "完全不辣，适合不吃辣的人。"
    },
    {
      "original": "青柠",
      "substitute": "白醋",
      "ratio": "1个:15毫升",
      "note": "酸味更直，香气稍逊。"
    }
  ],
  "variations": [
    "再加半个烤过的甜椒，酱体会更甜、更厚实些。",
    "再拌入一勺烤香的芝麻，坚果香气会更明显。"
  ],
  "serving_suggestion": "装在小碗里配玉米片，或者浇在烤肉与煎蛋上。",
  "storage": "冷藏五天，表面淋一层薄油可延长到一周左右。",
