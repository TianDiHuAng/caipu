  "equipment": [
    "料理机",
    "滤网",
    "水壶",
    "长勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜去皮切块，与一半清水一起放进料理机打成细腻的绿色汁液。",
      "time_min": 5,
      "heat": "无火",
      "tip": "去皮打，颜色才透亮。",
      "visual_cue": "汁液翠绿、无颗粒"
    },
    {
      "n": 2,
      "text": "用细滤网滤掉渣滓，加青柠汁、白糖与盐搅拌到糖完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先化糖再加冰，甜度才准。",
      "visual_cue": "糖粒消失、汁液清亮"
    },
    {
      "n": 3,
      "text": "倒入剩余冰水搅匀，加薄荷叶轻压出香，冷藏十分钟后饮用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "薄荷轻压，别捣碎发苦。",
      "visual_cue": "饮品冰凉、薄荷浮面"
    }
  ],
  "tips": [
    "黄瓜去皮再打，饮品的绿色才通透漂亮。",
    "糖先在少量汁液里化开再加冰水，甜度才均匀。",
    "薄荷只轻压出香，捣碎会释放苦味。"
  ],
  "common_mistakes": [
    "糖直接倒进冰水，喝到底部全是糖粒。",
    "不打滤直接喝，满口都是黄瓜渣，口感全无。",
    "青柠挤完把皮一起泡，久放发苦。"
  ],
  "substitutions": [
    {
      "original": "黄瓜",
      "substitute": "西瓜",
      "ratio": "200g 对 300g",
      "note": "白糖减到 20g。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "80g 对 80g",
      "note": "酸度略低，可加 10g。"
    }
  ],
  "variations": [
    "气泡版：一半清水换成冰苏打水，口感更清爽。",
    "辣味版：加 3g 辣椒粉与盐同调。"
  ],
  "serving_suggestion": "加满冰块，配薄荷叶与青柠片装饰。",
  "storage": "冷藏可存 2 天，饮用前摇匀。",
