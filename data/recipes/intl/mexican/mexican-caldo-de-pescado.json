  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去骨切成大块，用一半青柠汁与少许盐抓匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "青柠汁能去腥并让鱼肉紧实。",
      "visual_cue": "鱼肉表面发白，闻不到腥味。"
    },
    {
      "n": 2,
      "text": "锅里倒橄榄油，下洋葱丝炒到透明，加大蒜末炒香。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱炒软就够，别炒出焦色。",
      "visual_cue": "洋葱透明，蒜香散出。"
    },
    {
      "n": 3,
      "text": "放番茄块与青椒圈炒五分钟，炒到番茄出汁变软。",
      "time_min": 8,
      "heat": "中火",
      "tip": "番茄炒出汁，汤底才有厚度。",
      "visual_cue": "锅里出现橙红色汤汁。"
    },
    {
      "n": 4,
      "text": "加清水与牛至煮开，转小火煮十分钟让味道融合。",
      "time_min": 12,
      "heat": "小火",
      "tip": "先煮出蔬菜的甜，再下鱼。",
      "visual_cue": "汤色橙红，香气清亮。"
    },
    {
      "n": 5,
      "text": "放入鲈鱼块，小火煮六分钟，不要搅动避免鱼肉散开。",
      "time_min": 8,
      "heat": "小火",
      "tip": "鱼块下锅后只能轻推，翻搅就碎。",
      "visual_cue": "鱼块变白不透明。"
    },
    {
      "n": 6,
      "text": "加盐调味，关火挤入剩下的青柠汁，撒香菜碎。",
      "time_min": 6,
      "heat": "小火",
      "tip": "青柠汁关火后加，酸味才清。",
      "visual_cue": "汤面浮着香菜，闻起来酸香。"
    }
  ],
  "tips": [
    "鱼要选肉质紧实的海鱼，鲈鱼、鳕鱼都合适。",
    "鱼块下锅后别盖严锅盖，容易焖散。",
    "汤煮好后立即喝，鱼肉久泡会散。"
  ],
  "common_mistakes": [
    "鱼块冷水下锅，煮出来又老又散。",
    "汤一直大火翻滚，鱼肉全碎在汤里，只剩一锅腥汤。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "鳕鱼",
      "ratio": "700g 对 700g",
      "note": "鳕鱼肉更嫩，煮的时间缩短到四分钟。"
    }
  ],
  "variations": [
    "韦拉克鲁斯版本会加一勺番茄酱与几片月桂叶，汤色更红、味道更浓。"
  ],
  "serving_suggestion": "配玉米饼与青柠角，也可以浇在白饭上。",
  "storage": "冷藏一天，复热时小火加热，不要煮滚。",
