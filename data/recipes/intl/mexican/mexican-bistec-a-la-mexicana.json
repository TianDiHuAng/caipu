  "equipment": [
    "平底锅",
    "砧板",
    "肉锤",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肩肉逆着纹理切成半厘米厚的片，用肉锤轻拍到厚薄均匀。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逆纹切、拍松，煎出来才不塞牙。",
      "visual_cue": "肉片匀薄，纤维被拍断"
    },
    {
      "n": 2,
      "text": "肉片撒盐、黑胡椒和孜然，抓匀腌十五分钟入味。",
      "time_min": 17,
      "heat": "无火",
      "tip": "盐别省，薄片腌过才有底味。",
      "visual_cue": "肉片表面挂料，微微发亮"
    },
    {
      "n": 3,
      "text": "番茄切丁，洋葱切丝，墨西哥辣椒切薄圈，蒜切片备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "料都切好再开火，煎肉讲究快，来不及现切。",
      "visual_cue": "配料分堆，颜色分明"
    },
    {
      "n": 4,
      "text": "平底锅烧到冒烟，放一半植物油，肉片下锅平铺不要重叠。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅要够热，肉一下去就锁住肉汁，不会出水。",
      "visual_cue": "锅面冒烟，肉边立刻变色"
    },
    {
      "n": 5,
      "text": "一面煎一分半，翻面再煎一分钟，两面焦褐后盛出静置。",
      "time_min": 4,
      "heat": "大火",
      "tip": "薄片别久煎，全熟就柴，颜色一变就起锅。",
      "visual_cue": "表面焦褐，按压有弹性"
    },
    {
      "n": 6,
      "text": "锅补余油，下洋葱丝炒两分钟，加蒜片和辣椒圈炒出香味。",
      "time_min": 4,
      "heat": "大火",
      "tip": "辣椒圈后放，炒久了辣味会散，香气也没了。",
      "visual_cue": "洋葱透明，辣椒翠绿"
    },
    {
      "n": 7,
      "text": "倒番茄丁炒三分钟到出汁，加盐调味，把肉片连汁倒回锅里。",
      "time_min": 4,
      "heat": "大火",
      "tip": "番茄出汁后再回肉，肉片裹上酸香才好吃。",
      "visual_cue": "汤汁发红，锅里翻滚"
    },
    {
      "n": 8,
      "text": "翻匀三十秒关火，淋青柠汁，撒香菜碎，趁热装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁最后淋，酸味才清亮，早放会发苦。",
      "visual_cue": "肉片油亮，香菜翠绿"
    }
  ],
  "tips": [
    "这道菜是墨西哥家家会做的家常肉菜，配玉米饼或米饭都行。",
    "肉片薄、锅够热、时间短，三件事做到就嫩。",
    "番茄和辣椒的比例按口味调，喜辣的多放辣椒圈。"
  ],
  "common_mistakes": [
    "肉片顺着纹理切，煎完硬得咬不动。",
    "锅不够热就下肉，肉片渗出水分，变成煮肉。",
    "肉在锅里反复翻，肉汁全流出来，口感发干。"
  ],
  "substitutions": [
    {
      "original": "牛肩肉",
      "substitute": "牛里脊",
      "ratio": "600克:600克",
      "note": "里脊更嫩，煎的时间各减半分钟。"
    },
    {
      "original": "墨西哥辣椒",
      "substitute": "青椒",
      "ratio": "40克:60克",
      "note": "青椒不辣，喜辣的另加辣椒面五克。"
    }
  ],
  "variations": [
    "把肉片切成细条，做成炒肉丝版本，配玉米饼卷着吃。",
    "加一勺番茄膏同炒，酱汁更浓，适合拌米饭。"
  ],
  "serving_suggestion": "配热玉米饼、一勺黑豆泥和一片牛油果，卷起来吃最地道。",
  "storage": "冷藏两天，复热用平底锅大火快炒，别用微波炉会发硬。",
