{
  "schema_version": "1.0",
  "content_version": 1,
  "id": "mexican-champurrado",
  "name": {
    "zh": "墨西哥肉桂玉米热饮",
    "en": "Champurrado (Mexican Cinnamon Corn Hot Chocolate)"
  },
  "cuisine": {
    "region": "intl",
    "style": "mexican"
  },
  "category": [
    "drink"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 10,
    "cook_min": 20,
    "total_min": 30
  },
  "servings": 2,
  "flavor": [
    "sweet",
    "fragrant",
    "rich"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "玉米面",
          "name_en": "cornmeal",
          "amount": 80,
          "unit": "g",
          "note": "细玉米面，先化糊",
          "optional": false
        },
        {
          "name": "黑巧克力",
          "name_en": "dark chocolate",
          "amount": 70,
          "unit": "g",
          "note": "可可含量七成以上，切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 400,
          "unit": "ml",
          "note": "全脂牛奶更顺滑",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 40,
          "unit": "g",
          "note": "敲散结块",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 1,
          "unit": "stalk",
          "note": "长约七厘米，拍裂",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 500,
          "unit": "ml",
          "note": "分两次使用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味一点即可",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "打蛋器",
    "小汤锅",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米面加两百毫升清水搅成无颗粒的稀糊，静置五分钟醒透。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先用凉水化开再下锅，直接倒进热水会结成硬块。",
      "visual_cue": "糊体细腻顺滑、看不到干粉颗粒"
    },
    {
      "n": 2,
      "text": "小汤锅倒入剩余清水与拍裂的桂皮，中火加热到锅边冒小泡。",
      "time_min": 5,
      "heat": "中火",
      "tip": "桂皮提前用刀背拍裂一道缝，香气更快释放。",
      "visual_cue": "水面浮起小泡、闻到明显肉桂香"
    },
    {
      "n": 3,
      "text": "把玉米面糊缓缓淋入锅中，同时用打蛋器不停画圈搅动。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "倒的速度要慢，边倒边搅才能避免结疙瘩。",
      "visual_cue": "液体开始转稠、没有白色团块"
    },
    {
      "n": 4,
      "text": "转小火加入切碎的黑巧克力与红糖，持续搅拌到完全化开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "巧克力切得越碎化得越快，红糖要边搅边压散。",
      "visual_cue": "颜色转为深棕、锅底无糖粒沉积"
    },
    {
      "n": 5,
      "text": "倒入牛奶继续小火加热，边加热边搅，直到表面浮起细密泡沫。",
      "time_min": 6,
      "heat": "小火",
      "tip": "牛奶后加能减少糊底，全程别停下搅拌的手。",
      "visual_cue": "表面布满细泡、飘出奶香与可可香"
    },
    {
      "n": 6,
      "text": "加一点盐搅匀，趁烫盛入预热过的杯子即可饮用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "杯子先用热水烫一遍，端上桌不会马上凉。",
      "visual_cue": "质地浓稠如热可可、杯壁挂一层薄膜"
    }
  ],
  "tips": [
    "玉米面要用“细面”，颗粒粗的口感会发涩。",
    "想减糖可把红糖换成一半，巧克力的苦味会顶上。",
    "煮的过程像稀粥一样不断搅动，稍微偷懒就会焦底。"
  ],
  "common_mistakes": [
    "玉米面直接倒进热水里，一锅全是硬疙瘩。",
    "全程大火猛煮，底部糊了整锅带焦味。",
    "牛奶加得太早又久煮，表面结出厚厚一层奶皮。"
  ],
  "substitutions": [
    {
      "original": "黑巧克力",
      "substitute": "可可粉",
      "ratio": "60g 对 25g",
      "note": "可可粉无糖无脂，需另加十克红糖补味。"
    },
    {
      "original": "全脂牛奶",
      "substitute": "豆浆",
      "ratio": "400ml 对 400ml",
      "note": "豆香更清爽，煮的时间缩短两分钟。"
    }
  ],
  "variations": [
    "加一小勺肉桂粉与辣椒粉，做出带微辣的墨西哥风味。",
    "煮好后兑入一小杯浓缩咖啡，变成成人版的玉米摩卡。"
  ],
  "serving_suggestion": "装在厚壁陶杯里，配油条或甜面包当早餐热饮。",
  "storage": "冷藏两天，复热时小火加少量牛奶稀释并重新搅匀。",
  "nutrition_estimate": {
    "basis": "每份（约 300ml）",
    "calories_kcal": 420,
    "protein_g": 11,
    "fat_g": 17,
    "carbs_g": 56,
