  "equipment": [
    "平底锅",
    "汤锅",
    "搅拌机",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青辣椒块放进干锅小火烙到表皮起泡发黑，翻面烙匀后取出放凉。",
      "time_min": 8,
      "heat": "小火",
      "tip": "表皮烙黑才有烟熏香，别怕焦，里面不会糊。",
      "visual_cue": "椒皮布满黑斑，椒身变软塌陷"
    },
    {
      "n": 2,
      "text": "放凉后用手撕掉焦黑表皮，去掉蒂与籽，只留软化的椒肉备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别用水冲，冲掉的是香气，用纸擦或手撕更干净。",
      "visual_cue": "椒肉呈橄榄绿，质地柔软"
    },
    {
      "n": 3,
      "text": "平底锅放一半植物油，下洋葱与蒜炒到透明，加入椒肉炒两分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "椒肉下锅稍炒出多余水分，打出来的酱才不水，味道也更集中。",
      "visual_cue": "洋葱透明，椒肉塌软出汁"
    },
    {
      "n": 4,
      "text": "把炒好的料倒进搅拌机，加牛奶打成顺滑绿酱，尝一口应有明显椒香。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打久一点更细腻，皮撕不干净时过一遍筛。",
      "visual_cue": "酱体顺滑无颗粒，颜色奶绿"
    },
    {
      "n": 5,
      "text": "面条放进加盐的滚水煮到八分熟，捞出留半碗煮面水备用。",
      "time_min": 8,
      "heat": "中大火",
      "tip": "煮面水里带着面条的黏性物质，等下能让酱汁更好地挂住面身。",
      "visual_cue": "面条有弹性，中心留细白芯"
    },
    {
      "n": 6,
      "text": "平底锅放剩下的植物油，撒面粉小火炒半分钟，倒入绿酱搅匀煮到微稠。",
      "time_min": 5,
      "heat": "小火",
      "tip": "面粉炒过再下液体才不结块，稠度也更稳。",
      "visual_cue": "酱汁冒小泡，勺背挂一层薄膜"
    },
    {
      "n": 7,
      "text": "加入奶酪丝搅到融化，放面条翻拌，视稠度加煮面水调成流动状。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "煮面水一点一点加，太稀就收半分钟。",
      "visual_cue": "面条裹满绿酱，锅底不留汁"
    },
    {
      "n": 8,
      "text": "用盐与黑胡椒调味，撒上切碎的香菜，装盘趁热吃，凉了酱会发硬。",
      "time_min": 2,
      "heat": "无火",
      "tip": "奶酪本身带咸，加盐前先尝，避免过咸。",
      "visual_cue": "盘面奶绿油亮，香菜翠绿点缀"
    }
  ],
  "tips": [
    "没有波布拉诺椒可用青椒加一小段青辣椒代替，辣度会低一些。",
    "酱打好后过筛一次，口感更细，适合给孩子吃。",
    "奶酪选略带咸味的成熟款，风味比马苏里拉更足。",
    "喜欢更辣就在打酱时加半个墨西哥青辣椒，用量自己掌握。"
  ],
  "common_mistakes": [
    "青辣椒不烙直接打酱，成品只有生青味，缺少烟熏的层次。",
    "面粉没炒就撒进酱里，锅里结出一粒粒白疙瘩。",
    "酱汁煮得太稠再拌面，凉一点就结成团，拌不开。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "200毫升:180毫升",
      "note": "做成无奶版，香气更浓但少了乳香。"
    },
    {
      "original": "奶酪",
      "substitute": "营养酵母",
      "ratio": "80克:20克",
      "note": "咸鲜感接近，需补少许盐。"
    }
  ],
  "variations": [
    "加一百克手撕鸡丝或虾仁，蛋白质更足，可以当主菜。",
    "把面条换成墨西哥小面卷饼条，做成焗烤版，表面撒奶酪烤到金黄。"
  ],
  "serving_suggestion": "用深盘盛装，表面再撒一层奶酪丝与香菜，配一杯冰柠檬水缓解辣度。",
  "storage": "冷藏两天内吃完，复热时加两勺牛奶小火翻热，酱汁会重新变顺滑。",
