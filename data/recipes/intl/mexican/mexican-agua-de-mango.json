  "equipment": [
    "搅拌机",
    "刀",
    "砧板",
    "滤网",
    "水壶",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芒果削皮后沿着果核片下两片厚肉，再切成三厘米左右的块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "芒果要挑熟透的，甜度和香气都靠它。",
      "visual_cue": "果肉橙黄多汁，切块整齐"
    },
    {
      "n": 2,
      "text": "瓜块放进搅拌机，倒入一半清水，高速打四十秒成细浆。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先少加水打得细，后面再稀释更好控制。",
      "visual_cue": "浆液细腻无颗粒，颜色鲜亮"
    },
    {
      "n": 3,
      "text": "用细滤网把瓜浆滤进大水壶，用勺子压渣取尽汁水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "渣别压太狠，压过头会带出涩味。",
      "visual_cue": "滤出清亮果汁，渣略干"
    },
    {
      "n": 4,
      "text": "加入剩下的清水、白糖和一小撮盐，搅拌至糖完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "一小撮盐能提甜，喝不出咸味才对。",
      "visual_cue": "糖完全溶解，液体均匀"
    },
    {
      "n": 5,
      "text": "挤入青柠汁搅匀，尝一下调整酸甜后再补糖或补汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁要最后加，酸味才清亮不闷。",
      "visual_cue": "酸甜平衡，果香清爽"
    },
    {
      "n": 6,
      "text": "水壶盖好冷藏一小时，喝前加冰块和薄荷叶。",
      "time_min": 62,
      "heat": "无火",
      "tip": "冷藏一小时风味融合，直接加冰会变淡。",
      "visual_cue": "液体冰镇透，杯壁结水珠"
    }
  ],
  "tips": [
    "芒果挑熟透的，甜度和香气都靠它。",
    "打浆先少加水，后面稀释更好控制浓度。",
    "滤渣别压太狠，压过头会带出涩味。",
    "一小撮盐能提甜，喝不出咸味才对。"
  ],
  "common_mistakes": [
    "瓜没熟透就用，成品寡淡还得靠糖硬撑。",
    "水一次全倒进去，打出来稀得像白开水。",
    "滤渣使劲压，喝起来带一股涩味。",
    "提前一晚做好，第二天香气全跑光。"
  ],
  "substitutions": [
    {
      "original": "芒果",
      "substitute": "菠萝",
      "ratio": "700克:700克",
      "note": "酸味更重，白糖加十克。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "40克:40克",
      "note": "酸味更柔，用量可略增。"
    }
  ],
  "variations": [
    "加几片黄瓜同打，清凉感更明显。",
    "换成气泡水稀释，口感更有刺激感。",
    "加一小枝迷迭香同泡，香气更有层次。"
  ],
  "serving_suggestion": "杯中加满冰块倒入，插一片青柠和薄荷叶，配辣味菜或烤肉特别解腻。",
  "storage": "冷藏可放两天，每次喝前摇匀，出现酸味即丢弃。",
