  ],
  "steps": [
    {
      "n": 1,
      "text": "仙人掌用刀刮掉刺和刺座，切成半厘米宽条。这一步别急着翻动。",
      "time_min": 9,
      "heat": "无火",
      "tip": "刺座要刮干净，扎嘴很难受，火候别过。",
      "visual_cue": "掌条干净，无刺点，状态稳定"
    },
    {
      "n": 2,
      "text": "掌条撒盐抓匀，静置十分钟逼出黏液。这一步别急着翻动。",
      "time_min": 12,
      "heat": "无火",
      "tip": "黏液去掉了，口感才清爽，火候别过。",
      "visual_cue": "表面起黏，颜色更深，状态稳定"
    },
    {
      "n": 3,
      "text": "清水冲洗两遍，洗掉黏液后沥干。这一步别急着翻动。",
      "time_min": 4,
      "heat": "无火",
      "tip": "多冲几遍，最后一遍用凉开水，火候别过。",
      "visual_cue": "掌条干爽，不滑手，状态稳定"
    },
    {
      "n": 4,
      "text": "煎锅倒植物油烧热，掌条摊平中火煎。这一步别急着翻动。",
      "time_min": 4,
      "heat": "中火",
      "tip": "单层摊开，别叠在一起，火候别过。",
      "visual_cue": "底面泛绿，锅气足，状态稳定"
    },
    {
      "n": 5,
      "text": "翻面再煎三分钟，煎到边缘微焦盛出。这一步别急着翻动。",
      "time_min": 4,
      "heat": "中火",
      "tip": "煎到微软就够，太软没口感，火候别过。",
      "visual_cue": "掌条微软，边缘焦边，状态稳定"
    },
    {
      "n": 6,
      "text": "番茄切丁，洋葱切细丝，香菜切碎。这一步别急着翻动。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱切细一点，生吃才不冲，火候别过。",
      "visual_cue": "丁粒均匀，丝细透明，状态稳定"
    },
    {
      "n": 7,
      "text": "掌条、番茄和洋葱装碗，挤青柠汁加盐拌匀。这一步别急着翻动。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁压住黏液味，别省，火候别过。",
      "visual_cue": "汁水裹匀，颜色鲜亮，状态稳定"
    },
    {
      "n": 8,
      "text": "撒香菜和奶酪碎，静置三分钟再吃。这一步别急着翻动。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静一会味道才融合，火候别过。",
      "visual_cue": "表层雪白，香气清新，状态稳定"
    }
  ],
  "tips": [
    "仙人掌要刮净刺座，扎嘴很难受，值得留意。",
    "盐抓出水再冲洗，黏液才去得掉，值得留意。",
    "青柠汁多挤一点，酸味压住土腥，值得留意。"
  ],
  "common_mistakes": [
    "没去黏液，口感滑腻发涩，值得留意。",
    "煎太久，掌条软成一摊，值得留意。",
    "洋葱切太粗，抢掉仙人掌的味，值得留意。"
  ],
  "substitutions": [
    {
      "original": "仙人掌",
      "substitute": "青椒",
      "ratio": "500 克:400 克",
      "note": "口感更脆，煎的时间缩短两分钟。"
    },
    {
      "original": "奶酪",
      "substitute": "菲达奶酪",
      "ratio": "40 克:40 克",
      "note": "咸味更重，盐要减半。"
    }
  ],
  "variations": [
    "加一把煮熟的红腰豆，更有饱腹感，值得留意。",
    "放一勺辣酱，酸辣更开胃，值得留意。"
  ],
  "serving_suggestion": "冷藏后当凉菜，配烤肉解腻，效果更稳定。",
  "storage": "冷藏一天，吃前再挤一次青柠，效果更稳定。",
