  "equipment": [
    "平底锅",
    "搅拌机",
    "密封瓶"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄与青椒洗净擦干，干辣椒去蒂，大蒜保留外皮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "带皮烤蒜能防止蒜肉焦苦，香气也更柔。",
      "visual_cue": "食材表面无水、干辣椒完整不碎"
    },
    {
      "n": 2,
      "text": "平底锅烧热放少许橄榄油，中火把番茄、洋葱、青椒、蒜与干辣椒煎到表皮起泡发黑。",
      "time_min": 8,
      "heat": "中火",
      "tip": "表皮焦斑是烟熏味的来源，别怕煎黑，但别煎成炭。",
      "visual_cue": "番茄皮起皱发黑、辣椒变软"
    },
    {
      "n": 3,
      "text": "煎好的食材放大碗中稍放凉，剥去蒜皮，番茄撕去焦黑的皮。",
      "time_min": 5,
      "heat": "无火",
      "tip": "焦皮要撕掉但别洗，洗掉就等于把香气冲走了。",
      "visual_cue": "蒜肉软糯、食材降到不烫手"
    },
    {
      "n": 4,
      "text": "全部食材放入搅拌机，加米醋、孜然和盐，点动搅打到粗颗粒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "点动几次就停，打成顺滑泥就失去莎莎的口感。",
      "visual_cue": "酱体带细颗粒、颜色深红"
    },
    {
      "n": 5,
      "text": "倒回锅中中火煮三分钟收浓，放凉后拌入香菜碎。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煮一下能让酸与辣融合，也让酱更耐放。",
      "visual_cue": "酱体冒小泡、铲子划过留下痕迹"
    }
  ],
  "tips": [
    "喜欢更辣可留一部分辣椒籽一起打，辣度会明显提升。",
    "装瓶前瓶子用开水烫过，冷藏可放一周。",
    "配烤肉、塔可、煎蛋都合适，也可当薯条的蘸酱。"
  ],
  "common_mistakes": [
    "番茄煎成焦炭，整瓶酱带苦味只能丢弃。",
    "搅拌机打成泥，失去莎莎应有的颗粒感。",
    "香菜一开始就下锅煮，成品发黑且香味尽失。"
  ],
  "substitutions": [
    {
      "original": "干辣椒",
      "substitute": "辣椒粉",
      "ratio": "3 根 对 8g",
      "note": "辣度更均匀，但缺少果香。"
    },
    {
      "original": "米醋",
      "substitute": "柠檬",
      "ratio": "15ml 对 半个",
      "note": "酸味更清新，需多加一克盐。"
    }
  ],
  "variations": [
    "把干辣椒换成辣椒粉，辣度更均匀但少些果香。",
    "番茄与干辣椒同时加量，做成更浓烈的辣酱。"
  ],
  "serving_suggestion": "配玉米饼、烤肉、煎蛋，或作为薯条蘸酱，也可拌饭。",
  "storage": "密封冷藏一周，冷冻三个月；取用时用干净勺子避免污染。",
