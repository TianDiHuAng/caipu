  "equipment": [
    "汤锅",
    "炒锅",
    "漏勺",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉冷水下锅，大火煮开撇沫，转小火煮二十五分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "鸡肉煮到筷子能轻松扎透即可，别煮老。",
      "visual_cue": "鸡腿浮起，汤面清亮。"
    },
    {
      "n": 2,
      "text": "捞出鸡腿稍凉后撕成粗丝，鸡皮与骨头留回汤里再煮十分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "骨头回锅煮，汤味更厚。",
      "visual_cue": "汤色微黄，香气浓。"
    },
    {
      "n": 3,
      "text": "滤出清汤撇去浮油，锅里留少量植物油炒香洋葱丝与蒜末。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱炒到透明就够，不要上色。",
      "visual_cue": "锅里油热，洋葱下锅发出细响。"
    },
    {
      "n": 4,
      "text": "加番茄丁炒出汁，倒入滤好的鸡汤，加牛至与黑胡椒煮十分钟。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "牛至和青柠是这道汤的骨架，别省。",
      "visual_cue": "汤色橙红，香气清亮。"
    },
    {
      "n": 5,
      "text": "玉米饼切细条，下热油炸到金黄酥脆，捞出沥油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "饼条要炸透，泡进汤里才不立刻软烂。",
      "visual_cue": "饼条炸到金黄卷曲，捞出沥油。"
    },
    {
      "n": 6,
      "text": "汤里放回鸡肉丝，加盐调味，关火后挤入两颗青柠的汁。",
      "time_min": 6,
      "heat": "小火",
      "tip": "青柠汁关火后加，煮久会发苦。",
      "visual_cue": "汤味立刻变清酸。"
    },
    {
      "n": 7,
      "text": "盛碗后放青柠片、香菜碎与炸好的玉米饼条，趁热喝。",
      "time_min": 5,
      "heat": "无火",
      "tip": "饼条上桌再放，保持脆感。",
      "visual_cue": "碗面浮着脆饼条与青柠片。"
    }
  ],
  "tips": [
    "尤卡坦的青柠比普通柠檬更小更酸，用普通青柠可减量。",
    "汤要清亮，全程小火，别让大火把汤滚浑。",
    "炸玉米饼条一次多炸些，蘸汤吃很上瘾。"
  ],
  "common_mistakes": [
    "青柠汁和汤一起长时间煮，酸味变苦、汤色发暗。",
    "鸡肉煮过头再撕，肉丝又干又柴。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "3 个对 2 个",
      "note": "柠檬酸度低，需多挤半个提味。"
    }
  ],
  "variations": [
    "梅里达的餐馆会加一小勺炸过的干辣椒碎，酸里带辣，喝起来更开胃。"
  ],
  "serving_suggestion": "配玉米饼与一小碟哈瓦那辣椒酱，酸辣交替。",
  "storage": "汤与饼条分开存放，冷藏两天，复热后现放饼条。",
