  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红腰豆提前用清水浸泡八小时，泡到豆粒膨大、表皮一搓就掉，捞出沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡足八小时，后面煮一小时就能软。",
      "visual_cue": "豆粒胀大一倍，捏起来能压动"
    },
    {
      "n": 2,
      "text": "泡好的豆子沥干，倒进汤锅加清水煮开，转小火炖五十分钟。",
      "time_min": 55,
      "heat": "小火",
      "tip": "先清水炖到半软，再加料味道才不混。",
      "visual_cue": "豆子变软但外形完整"
    },
    {
      "n": 3,
      "text": "培根切成两厘米宽的条，洋葱和青椒切小丁，大蒜切末。",
      "time_min": 9,
      "heat": "无火",
      "tip": "培根切宽一点，炖完还有嚼头。",
      "visual_cue": "培根条均匀，蔬菜丁细小"
    },
    {
      "n": 4,
      "text": "另起炒锅倒植物油，下培根条中火煎四分钟至出油微焦。",
      "time_min": 5,
      "heat": "中火",
      "tip": "培根煎出油，整锅汤的底味就靠它。",
      "visual_cue": "培根边缘微焦，锅底一层油"
    },
    {
      "n": 5,
      "text": "下洋葱丁与青椒丁炒四分钟至软塌，加蒜末炒出香味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "用培根油炒蔬菜，风味比清炒厚得多。",
      "visual_cue": "蔬菜软塌油亮，蒜香散出"
    },
    {
      "n": 6,
      "text": "加番茄丁、孜然、牛至和辣椒粉炒三分钟至番茄出汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出汁，炖的时候汤色才红亮。",
      "visual_cue": "番茄软塌出汁，锅底泛红"
    },
    {
      "n": 7,
      "text": "把炒好的料连油一起倒进豆锅，加盐与黑胡椒小火炖三十分钟。",
      "time_min": 33,
      "heat": "小火",
      "tip": "连油一起倒，汤的香气才完整。",
      "visual_cue": "汤色红亮，豆子入味软糯"
    },
    {
      "n": 8,
      "text": "尝味补盐，用勺子压碎一部分豆子让汤变稠，撒香菜盛碗。",
      "time_min": 4,
      "heat": "无火",
      "tip": "压碎一部分豆子，汤自然变浓不用勾芡。",
      "visual_cue": "汤汁浓稠，撒满翠绿香菜"
    }
  ],
  "tips": [
    "豆子泡足八小时，炖起来才省时省火。",
    "豆子先清水炖到半软，再加料味道更清楚。",
    "用培根煎出的油炒蔬菜，风味更厚。",
    "压碎一部分豆子，汤自然变浓稠。"
  ],
  "common_mistakes": [
    "豆子不泡直接炖，两个小时中间还硬。",
    "盐一开始就放，豆皮收紧怎么炖都不软。",
    "培根不煎直接放，汤里全是生腥气。",
    "大火快炖，豆皮全破散成一锅泥。"
  ],
  "substitutions": [
    {
      "original": "红腰豆",
      "substitute": "白芸豆",
      "ratio": "350克:350克",
      "note": "颜色更浅，汤色偏白。"
    },
    {
      "original": "培根",
      "substitute": "香肠",
      "ratio": "80克:90克",
      "note": "咸味更重，盐要减两克。"
    }
  ],
  "variations": [
    "加一勺辣椒酱同炖，辣味更地道。",
    "放两片香叶同炖，香气更沉更厚实。",
    "汤多点做成汤豆版，配玉米饼蘸着吃。"
  ],
  "serving_suggestion": "盛进深碗，撒香菜配玉米饼或米饭，是墨西哥家庭聚餐必备的一锅。",
  "storage": "冷藏可放四天，越放越入味，复热小火加热并补少量清水。",
