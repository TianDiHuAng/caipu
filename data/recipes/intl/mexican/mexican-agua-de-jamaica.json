    "total_min": 35
  },
  "servings": 4,
  "flavor": [
    "sour",
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "洛神花",
          "name_en": "hibiscus",
          "amount": 40,
          "unit": "g",
          "note": "干花萼，挑去杂质",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1200,
          "unit": "ml",
          "note": "煮花与兑水各用一部分",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "青柠",
          "name_en": "lime",
          "amount": 1,
          "unit": "piece",
          "note": "切片，可选",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 1,
          "unit": "piece",
          "note": "一小段桂皮",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "细筛",
    "玻璃壶",
    "长勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洛神花干花萼倒入盆中，用清水快速漂洗两遍，挑出夹杂的枝叶与碎屑后沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "只快速漂洗，久泡会提前释出酸味与颜色。",
      "visual_cue": "花萼颜色深红发亮、水色浅红"
    },
    {
      "n": 2,
      "text": "锅中加八百毫升清水与洛神花、肉桂，煮开后转小火加盖煮十分钟，让花萼充分出色。",
      "time_min": 10,
      "heat": "小火",
      "tip": "煮到水色深红即可，久煮会带出涩口的单宁味。",
      "visual_cue": "汤色深玫红、花萼变软褪色"
    },
    {
      "n": 3,
      "text": "关火后连花带汤浸泡十五分钟，用细筛滤掉花萼，趁温热加入白糖搅到完全溶解。",
      "time_min": 15,
      "heat": "无火",
      "tip": "趁温热加糖才溶得干净，凉后加糖会沉底不化。",
      "visual_cue": "糖粒完全消失、液体透亮"
    },
    {
      "n": 4,
      "text": "兑入剩余清水与青柠片，尝味调酸甜，冷藏到彻底冰凉后装壶饮用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷藏至少两小时再喝，温度低酸味更清亮不尖。",
      "visual_cue": "液体冰凉爽口、杯壁结薄水雾"
    }
  ],
  "tips": [
    "洛神花本身极酸，糖量可按杯数微调，但不宜完全省略。",
    "肉桂只作底香，一小段足够，多了会盖过花香。",
    "兑水比例约一比十五，浓缩液冷藏可保存一周。"
  ],
  "common_mistakes": [
    "花萼冷水久泡一夜再煮，酸涩味过重，茶汤发暗发苦。",
    "糖在冰镇后才加，糖粒沉底不化，喝起来前甜后酸。",
    "煮好后带花萼久放不滤，茶汤变得浑浊并带土腥味。"
  ],
  "substitutions": [
    {
      "original": "洛神花",
      "substitute": "玫瑰花干",
      "ratio": "40g 对 30g",
      "note": "玫瑰花香气浓但酸度低，需补青柠汁提酸。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "60g 对 70g",
      "note": "蜂蜜不耐高温，需等茶汤降到温热再加。"
    }
  ],
  "variations": [
    "加一片生姜同煮，做出带辛香的冬季热饮版本。",
    "兑入气泡水与薄荷叶，做成夏日的洛神花气泡饮。"
  ],
  "serving_suggestion": "倒入加冰的玻璃杯，放一片青柠与薄荷叶，佐餐解腻最合适。",
  "storage": "冷藏保存五天，冷冻成冰块可放一个月；出现浑浊絮状物即丢弃。",
