          "name_en": "water",
          "amount": 1800,
          "unit": "ml",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 100,
          "unit": "g",
          "note": "按口味调整",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "一小撮提味",
          "optional": false
        },
        {
          "name": "青柠",
          "name_en": "lime",
          "amount": 1,
          "unit": "piece",
          "note": "切片装饰",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "滤网",
    "大壶",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "罗望子果荚掰开，剥出里面带籽的深褐色果肉放进汤锅。",
      "time_min": 8,
      "heat": "无火",
      "tip": "买带荚的比买现成果酱更正，酸味更清。",
      "visual_cue": "果肉柔软黏手，果荚与纤维挑干净"
    },
    {
      "n": 2,
      "text": "倒入一千毫升清水，大火煮开后转小火煮十五分钟。",
      "time_min": 17,
      "heat": "小火",
      "tip": "煮到果肉一按就散，酸味才完全进到水里。",
      "visual_cue": "水色变成深琥珀，果肉松散浮起"
    },
    {
      "n": 3,
      "text": "关火后连锅放凉，静置一小时让味道继续浸出来。",
      "time_min": 60,
      "heat": "无火",
      "tip": "急着喝也别用冷水冲，风味会淡一半。",
      "visual_cue": "液体颜色加深，闻起来酸香明显"
    },
    {
      "n": 4,
      "text": "用细滤网把液体滤进大壶，用勺子压出果肉里剩下的汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压的时候别把籽碾破，否则会带一点涩味。",
      "visual_cue": "滤网上剩干燥纤维，壶里液体清亮"
    },
    {
      "n": 5,
      "text": "加白糖与一小撮盐搅到完全化开，尝味再补糖。",
      "time_min": 4,
      "heat": "无火",
      "tip": "一点盐能把酸味托圆，别多也不能省。",
      "visual_cue": "甜酸平衡，喝下去嘴里回甘"
    },
    {
      "n": 6,
      "text": "加入剩下的清水调稀，搅匀后放冰箱冷藏一小时。",
      "time_min": 60,
      "heat": "无火",
      "tip": "冰镇过的酸味更清爽，室温下会觉得偏甜。",
      "visual_cue": "液体呈清透的琥珀色，没有沉淀"
    },
    {
      "n": 7,
      "text": "喝的时候往杯里放两片青柠，再加满冰块即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠片别提前泡进壶里，泡久了整壶都会发苦。",
      "visual_cue": "杯壁挂霜，液体清亮透光"
    }
  ],
  "tips": [
    "罗望子水最配油腻的烤肉，解腻效果很好。",
    "糖也可以换成蜂蜜，甜味更柔和，凉了也不发腻。",
    "加一小段桂皮同煮，香气更温暖。",
    "做浓缩液冷藏，喝时兑水更方便。"
  ],
  "common_mistakes": [
    "果肉没煮软就过滤，酸味出不来只能靠加糖。",
    "糖一次放太多，只能靠加水稀释到没味道。",
    "冰块直接丢进大壶，化开后整壶变淡。"
  ],
  "substitutions": [
    {
      "original": "罗望子",
      "substitute": "酸梅",
      "ratio": "200克:180克",
      "note": "酸味更单薄，糖要减三成。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "100克:110克",
      "note": "颜色更深，带一点焦糖香。"
    }
  ],
  "variations": [
    "加两片生姜同煮，酸辣感更像街边摊。",
    "兑入气泡水，做成带气的版本更解渴。"
  ],
  "serving_suggestion": "冰镇后倒进玻璃杯，配辣味的塔可最为合适。",
  "storage": "冷藏三天内喝完，也可冻成冰块保存一个月左右。",
