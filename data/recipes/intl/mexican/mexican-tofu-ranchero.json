  ],
  "equipment": [
    "平底锅",
    "砧板",
    "木勺",
    "厨纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐横切成两厘米厚的片，用厨纸把两面水分彻底吸干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水分吸干，煎的时候才不溅油，也更好上色。",
      "visual_cue": "豆腐表面干爽不反光"
    },
    {
      "n": 2,
      "text": "平底锅放一半植物油，豆腐片下锅小火煎到两面金黄起壳。",
      "time_min": 12,
      "heat": "中火",
      "tip": "一面煎定型再翻，翻早了会碎。",
      "visual_cue": "两面金黄，边缘起壳"
    },
    {
      "n": 3,
      "text": "煎好的豆腐块盛出，改刀切成三口大小的方块备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "煎完再切，块形完整，不会碎在锅里。",
      "visual_cue": "块形方整，外皮微脆"
    },
    {
      "n": 4,
      "text": "番茄顶部划十字，用开水烫一下去皮，再切成小丁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "去皮后酱汁更顺，皮的渣感会破坏口感。",
      "visual_cue": "番茄丁红亮且多汁水"
    },
    {
      "n": 5,
      "text": "锅补余油，下洋葱丝炒三分钟，加蒜末和墨西哥辣椒圈炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蒜末后下，炒久了发苦。",
      "visual_cue": "洋葱透明，蒜香扑鼻"
    },
    {
      "n": 6,
      "text": "倒番茄丁炒五分钟到出稠汁，加盐、孜然和牛至调味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄要炒到塌软出汁，酱才有厚度。",
      "visual_cue": "酱汁浓稠，色深红"
    },
    {
      "n": 7,
      "text": "把豆腐块放进酱里，轻轻推匀，中小火煨四分钟吸味。",
      "time_min": 5,
      "heat": "小火",
      "tip": "用推的别用铲翻，豆腐才不散。",
      "visual_cue": "豆腐块裹满鲜红酱汁"
    },
    {
      "n": 8,
      "text": "关火撒香菜碎，连酱汁一起盛盘上桌，趁热吃最香。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香菜最后撒，香气才不被热气冲掉。",
      "visual_cue": "酱红菜绿，豆腐完整"
    }
  ],
  "tips": [
    "牧场风酱汁就是番茄、墨西哥辣椒、洋葱三样炒出来的红酱，配什么都好吃。",
    "老豆腐水分少，煎得住，嫩豆腐容易碎不建议用。",
    "想更浓郁可以在酱里加一勺酸奶油，颜色会变粉。"
  ],
  "common_mistakes": [
    "豆腐没吸干水分就下锅，油花四溅还会粘锅。",
    "酱还没炒稠就下豆腐，成品成一锅稀汤。",
    "用铲子大力翻炒，豆腐会全部碎成小渣。"
  ],
  "substitutions": [
    {
      "original": "老豆腐",
      "substitute": "面筋",
      "ratio": "600克:400克",
      "note": "面筋更有嚼劲，煎的时间缩短两分钟。"
    },
    {
      "original": "墨西哥辣椒",
      "substitute": "甜椒",
      "ratio": "30克:50克",
      "note": "完全不辣，适合孩子，另配辣椒酱食用。"
    }
  ],
  "variations": [
    "把豆腐压碎炒散，做成炒豆腐版本，口感更接近炒蛋。",
    "加一把玉米粒同炒，甜味和红酱很配。"
  ],
  "serving_suggestion": "配两张热玉米饼，上面铺一块豆腐再浇酱，撒点香菜就上桌。",
  "storage": "冷藏两天，复热用平底锅小火加两勺清水，盖盖焖三分钟。",
