  "equipment": [
    "厚底锅",
    "漏勺",
    "砧板",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成拳头大的块，用盐与孜然粉抓匀腌十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "切大块才炖得住，小块炖一小时早就散成肉糜，捞不起来。",
      "visual_cue": "肉块表面挂盐，肥瘦分层清楚"
    },
    {
      "n": 2,
      "text": "厚底锅倒橄榄油，中火把肉块每面煎到金黄上色。",
      "time_min": 12,
      "heat": "中火",
      "tip": "煎上色是香味的来源，跳过这步炖出来的肉只有咸味没焦香。",
      "visual_cue": "肉块四面焦黄，锅底留褐色"
    },
    {
      "n": 3,
      "text": "下洋葱瓣、蒜与干辣椒炒香，倒入清水没过肉块一半。",
      "time_min": 6,
      "heat": "中火",
      "tip": "水只到肉的一半，靠蒸汽和自身油脂焖，水多了就成了白煮肉。",
      "visual_cue": "水面浸到肉块腰线，洋葱散在四周"
    },
    {
      "n": 4,
      "text": "盖盖小火炖一小时，中途翻动两次，让肉块均匀受热。",
      "time_min": 60,
      "heat": "小火",
      "tip": "全程小火保持微微冒泡，火大了水干得快，肉还没烂。",
      "visual_cue": "肉块能用筷子轻松插入"
    },
    {
      "n": 5,
      "text": "开盖转中火收干汤汁，把肉块压散成粗条，煎到边缘微脆。",
      "time_min": 10,
      "heat": "中火",
      "tip": "收汁时别走开，糖分和油一起焦化，几十秒就变黑。",
      "visual_cue": "汤汁收干，肉条边缘焦脆"
    },
    {
      "n": 6,
      "text": "盛盘挤上青柠汁，撒洋葱碎与香菜碎，趁热配热饼一起吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁最后挤，酸味能解掉肥肉的腻，也让焦香更立体。",
      "visual_cue": "肉条油亮焦脆，配菜翠绿点缀"
    }
  ],
  "tips": [
    "慢炖猪肉是墨西哥卷饼的灵魂馅料，外脆内软才对味。",
    "传统做法用猪油慢炸，家里用厚底锅半煎半炖更省油。",
    "剩下的肉第二天炒饭或夹热饼，味道比第一天更透。"
  ],
  "common_mistakes": [
    "肉切太小块，炖完已经找不到完整肉条。",
    "全程大火收汁，锅底焦糊，肉带苦味。",
    "不放盐只靠酱料，肉里没底味，卷饼吃起来发淡。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪里脊",
      "ratio": "800克:800克",
      "note": "里脊更瘦，需多加五十毫升水并缩短炖煮十分钟。"
    },
    {
      "original": "孜然",
      "substitute": "咖喱粉",
      "ratio": "4克:5克",
      "note": "咖喱粉版香气更杂，适合重口。"
    }
  ],
  "variations": [
    "加半个橙子的皮同炖，果香更浓，是墨西哥中部的做法。",
    "炖好后用喷枪把表面燎一下，焦香更接近街头摊。"
  ],
  "serving_suggestion": "夹进热饼里，配洋葱碎、香菜和青柠角，一手一个。",
  "storage": "冷藏可存三天，复热用干锅煎脆，勿加水会失去脆边。",
