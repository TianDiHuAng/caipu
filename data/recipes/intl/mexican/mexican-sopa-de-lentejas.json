  "steps": [
    {
      "n": 1,
      "text": "扁豆用清水冲洗两遍，挑出破损豆粒与杂质。",
      "time_min": 8,
      "heat": "无火",
      "tip": "扁豆不用泡，洗净直接煮就够。",
      "visual_cue": "水面无浮沫，豆粒干净。"
    },
    {
      "n": 2,
      "text": "锅里倒橄榄油，下洋葱丁与胡萝卜丁炒到洋葱透明。",
      "time_min": 9,
      "heat": "中火",
      "tip": "洋葱炒软，汤才有甜味。",
      "visual_cue": "洋葱透明，胡萝卜油亮。"
    },
    {
      "n": 3,
      "text": "加大蒜末与孜然炒香，再放番茄丁炒到出汁。",
      "time_min": 9,
      "heat": "中火",
      "tip": "孜然和番茄一起炒，香气才融。",
      "visual_cue": "番茄塌软，锅底有红汁。"
    },
    {
      "n": 4,
      "text": "倒入扁豆翻炒，加高汤煮开后转小火炖二十五分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "扁豆熟得快，炖到软而不烂最好。",
      "visual_cue": "豆粒鼓起变软，汤略稠。"
    },
    {
      "n": 5,
      "text": "加盐与黑胡椒调味，用勺背轻压几颗豆子让汤更稠。",
      "time_min": 6,
      "heat": "小火",
      "tip": "压几颗豆子，汤自然浓稠，不用勾芡。",
      "visual_cue": "汤色发浑，质感变厚。"
    },
    {
      "n": 6,
      "text": "盛碗后撒香菜碎，配上青柠角，喝前挤汁提味。",
      "time_min": 4,
      "heat": "无火",
      "tip": "青柠汁能提亮豆汤的土味。",
      "visual_cue": "汤面浮着绿色香菜。"
    }
  ],
  "tips": [
    "棕色扁豆煮出来汤色深，绿色扁豆更清甜。",
    "想喝浓汤可以把一半豆子打成泥再倒回锅里。",
    "配一张热玉米饼，是墨西哥最家常的晚餐。"
  ],
  "common_mistakes": [
    "扁豆煮过头，豆皮全散，汤变成糊。",
    "番茄没炒出汁就加汤，汤味寡淡。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "红腰豆",
      "ratio": "300g 对 300g",
      "note": "红腰豆须提前泡八小时，煮的时间延长二十分钟。"
    }
  ],
  "variations": [
    "普埃布拉的家庭会加一小段西班牙香肠同煮，汤带烟熏香，味道更厚。"
  ],
  "serving_suggestion": "配玉米饼或白饭，滴几滴青柠汁更清爽。",
  "storage": "冷藏三天，复热时加水稀释，扁豆会继续吸汤。",
