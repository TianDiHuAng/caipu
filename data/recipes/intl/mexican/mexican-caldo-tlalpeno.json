          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "砧板",
    "炒锅",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆提前一晚用清水浸泡，泡到豆子涨大成两倍。",
      "time_min": 30,
      "heat": "无火",
      "tip": "来不及就买煮好的罐装豆，冲洗后直接用。",
      "visual_cue": "豆子捏起来微软，外皮不再起皱发干"
    },
    {
      "n": 2,
      "text": "鸡腿肉剁成大块，冷水下锅煮开，撇净浮沫后捞出冲净。",
      "time_min": 12,
      "heat": "大火",
      "tip": "冷水下锅血水才逼得出，热水下锅腥味会封住。",
      "visual_cue": "水面浮起灰白浮沫，鸡皮收紧颜色变白"
    },
    {
      "n": 3,
      "text": "汤锅放鸡块、洋葱丝与高汤，大火烧开后转小火炖三十分钟。",
      "time_min": 33,
      "heat": "小火",
      "tip": "汤面保持轻轻冒泡，火大汤会浑成奶白色。",
      "visual_cue": "汤面小泡连绵，鸡肉能轻松脱骨"
    },
    {
      "n": 4,
      "text": "炒锅放少许油，把番茄块与大蒜炒到番茄塌软出红汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒出沙是汤底鲜味的关键，别只是温热。",
      "visual_cue": "番茄块散开成糊，锅底积红亮汁水"
    },
    {
      "n": 5,
      "text": "把炒好的番茄与鹰嘴豆倒进汤锅，加牛至与墨西哥辣椒继续炖。",
      "time_min": 20,
      "heat": "小火",
      "tip": "墨西哥辣椒带腌汁一起下，烟熏味才出得来。",
      "visual_cue": "汤色转深红，鹰嘴豆染上酱色"
    },
    {
      "n": 6,
      "text": "加盐调味，尝一口咸淡与辣度，不够酸就挤半个青柠。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠要在关火后加，久煮酸味会变得发涩。",
      "visual_cue": "汤味咸鲜微酸，辣度在喉咙轻轻一压"
    },
    {
      "n": 7,
      "text": "盛进深碗，铺上牛油果片，撒一把香菜碎趁热上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "牛油果最后放，热气一蒸就发黑变软。",
      "visual_cue": "汤面飘着红油花，牛油果片翠绿泛亮"
    }
  ],
  "tips": [
    "鹰嘴豆换成白豆，汤体会更绵密顺口。",
    "喜欢更辣可以把墨西哥辣椒加到两勺。",
    "汤做好放凉再热一次，味道比刚出锅更融合。",
    "配几片烤过的玉米饼当主食刚好。"
  ],
  "common_mistakes": [
    "鹰嘴豆没泡透就下锅，炖再久中间还是硬芯。",
    "番茄没炒出沙直接加水，整锅汤寡淡发水。",
    "牛油果早早放进锅里，端上桌已经发黑成泥。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600克:600克",
      "note": "炖的时间缩短到二十分钟。"
    },
    {
      "original": "鹰嘴豆",
      "substitute": "黑豆",
      "ratio": "200克:200克",
      "note": "汤色更深，口感更粉。"
    }
  ],
  "variations": [
    "加一勺酸奶油在碗中央，辣里多一层奶香。",
    "再放几块土豆同炖，汤吃起来更有饱腹感。"
  ],
  "serving_suggestion": "连汤带料一起盛进深碗，配着玉米饼撕开蘸汤吃。",
  "storage": "冷藏三天，复热时补少量高汤，牛油果一定要现切现放。",
