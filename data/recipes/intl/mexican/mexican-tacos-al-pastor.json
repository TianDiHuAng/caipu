  "steps": [
    {
      "n": 1,
      "text": "猪里脊切成半厘米厚片，用刀背轻拍松软后放进大碗。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拍松能让腌料更快渗透，口感也更嫩。",
      "visual_cue": "肉片厚薄一致，表面略有刀痕"
    },
    {
      "n": 2,
      "text": "把大蒜、辣椒粉、孜然、芫荽籽、白醋、青柠汁与盐倒入碗中抓匀腌制。",
      "time_min": 30,
      "heat": "无火",
      "tip": "腌料要抹到每片肉上，冷藏静置半小时足够入味。",
      "visual_cue": "肉片裹满红亮腌料，香气刺鼻"
    },
    {
      "n": 3,
      "text": "平底锅烧热下植物油，把腌好的肉片分批煎至两面焦香。",
      "time_min": 10,
      "heat": "中火",
      "tip": "肉片不要叠放，铺开才有煎香而不是焖熟。",
      "visual_cue": "肉片边缘焦褐，锅底有红亮油迹"
    },
    {
      "n": 4,
      "text": "煎好的肉片略放凉后切成小指宽的粗条，菠萝片同锅煎到带焦边。",
      "time_min": 6,
      "heat": "中火",
      "tip": "菠萝煎过甜味更集中，也去掉生涩。",
      "visual_cue": "菠萝切面金黄，果香变浓"
    },
    {
      "n": 5,
      "text": "玉米饼放干锅上小火两面各烙十秒，让饼皮变软带香气。",
      "time_min": 6,
      "heat": "小火",
      "tip": "饼皮烙过才不会一折就裂开。",
      "visual_cue": "饼面起细小斑点，柔软有弹性"
    },
    {
      "n": 6,
      "text": "饼上放肉条与菠萝，撒生洋葱碎和香菜，挤青柠汁卷起食用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馅料别放太多，卷起时两端留空才不会漏。",
      "visual_cue": "卷饼饱满，汁水被饼皮吸住"
    }
  ],
  "tips": [
    "腌肉时间至少三十分钟，隔夜冷藏风味更足。",
    "菠萝可用罐头款，需沥干糖水避免出水。",
    "多备几片青柠，酸味能解油脂的厚重。"
  ],
  "common_mistakes": [
    "肉片切得太厚，下锅后外层已经焦褐，中心却还没有熟。",
    "饼皮不烙直接卷，一折就裂漏馅。",
    "腌制时间不够，肉只带表面咸味。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡腿肉",
      "ratio": "600 克:600 克",
      "note": "煎制时间略短，口感更嫩。"
    },
    {
      "original": "玉米饼",
      "substitute": "小麦饼",
      "ratio": "240 克:240 克",
      "note": "更柔软不易裂，麦香更明显。"
    }
  ],
  "variations": [
    "把菠萝换成芒果丁，果香更清爽，酸甜也更柔和。",
    "加一勺烟熏辣椒酱，风味更接近街头烤炉。"
  ],
  "serving_suggestion": "摆盘时配青柠角与辣酱，趁热手拿着吃。",
  "storage": "肉料冷藏两天，饼皮密封室温一天；复热肉料用平底锅干煎。",
