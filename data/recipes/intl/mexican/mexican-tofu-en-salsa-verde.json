  "equipment": [
    "平底锅",
    "搅拌机",
    "刀",
    "砧板",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄、青椒、一半洋葱与带皮蒜放进干锅，中火烙八分钟到表面起黑斑。",
      "time_min": 9,
      "heat": "中火",
      "tip": "烙出焦斑是这道酱的灵魂，焦香比生青味更有层次。",
      "visual_cue": "蔬菜表面起黑斑，开始塌软"
    },
    {
      "n": 2,
      "text": "把烙好的蔬菜连同一半香菜放进搅拌机，加孜然与三克盐打成粗糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打到粗糊就停，打太细会变成汤，挂在豆腐上挂不住。",
      "visual_cue": "酱体翠绿带颗粒，能流动"
    },
    {
      "n": 3,
      "text": "豆腐切一厘米厚片，用厨房纸压干表面水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压干水再煎，表面才结得住脆皮，也不溅油。",
      "visual_cue": "豆腐片干爽，边缘整齐"
    },
    {
      "n": 4,
      "text": "平底锅放一半植物油烧热，中火把豆腐两面各煎三分钟到金黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "一面煎定型再翻，急着翻面豆腐会粘锅破皮。",
      "visual_cue": "两面金黄结皮，豆腐片挺括"
    },
    {
      "n": 5,
      "text": "盛出豆腐，锅里补剩下的油，下洋葱丝炒两分钟到透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱丝留一点脆感，最后能提口感。",
      "visual_cue": "洋葱丝透明微软带甜香"
    },
    {
      "n": 6,
      "text": "倒入打好的青酱，小火煮五分钟，边煮边搅，酱色转深。",
      "time_min": 6,
      "heat": "小火",
      "tip": "青酱要煮开一次，生涩味才散，酸味也变得圆润。",
      "visual_cue": "酱汁浓稠，颜色深绿"
    },
    {
      "n": 7,
      "text": "把豆腐放回锅里，小火炖六分钟，让豆腐吸饱酱汁。",
      "time_min": 7,
      "heat": "小火",
      "tip": "用勺子把酱汁反复浇在豆腐上，比翻动更入味。",
      "visual_cue": "豆腐表面挂满青酱"
    },
    {
      "n": 8,
      "text": "尝味后补盐，挤入青柠汁，撒剩下的香菜碎，关火盛出。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠最后挤，酸味鲜亮，久煮会发苦。",
      "visual_cue": "表面翠绿油亮，闻到青柠香"
    }
  ],
  "tips": [
    "豆腐用老豆腐，嫩的一炖就散成渣。",
    "酱里加一勺南瓜籽一起打，口感更厚，也是墨西哥的传统做法。",
    "配墨西哥玉米饼卷着吃，比配饭更对味。",
    "怕辣可以去净青椒的籽与白膜，辣度会降一半。"
  ],
  "common_mistakes": [
    "蔬菜不烙直接打酱，生青味重，整道菜发涩。",
    "豆腐煎好就下酱久炖，翻动太勤，最后碎成一锅糊。",
    "青柠早放，煮过后酸味发苦，香气也跑了。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "鸡腿肉",
      "ratio": "450克:400克",
      "note": "切块煎香再炖，时间延长五分钟。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "30克:30克",
      "note": "酸度略柔和，用量不变。"
    }
  ],
  "variations": [
    "加一勺酸奶油淋面，酸香更浓，也更像餐厅版本。",
    "把豆腐换成煎过的鱼块，做成海鲜版本。"
  ],
  "serving_suggestion": "三人份主菜，配玉米饼、米饭与一碟腌洋葱。",
  "storage": "冷藏两天内吃完，复热用小火加一勺水慢炖；豆腐久冻会变海绵状，不建议冷冻。",
