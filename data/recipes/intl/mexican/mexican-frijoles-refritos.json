  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "黑豆",
          "name_en": "black bean",
          "amount": 500,
          "unit": "g",
          "note": "干豆，提前泡八小时",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 150,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 4,
          "unit": "clove",
          "note": "切末",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "孜然",
          "name_en": "cumin",
          "amount": 4,
          "unit": "g",
          "note": "磨粉",
          "optional": false
        },
        {
          "name": "牛至",
          "name_en": "oregano",
          "amount": 3,
          "unit": "g",
          "note": "干牛至",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "分两次",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
          "unit": "g",
          "note": "豆子煮软后再放",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1000,
          "unit": "ml",
          "note": "煮豆用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "压泥器",
    "平底锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干黑豆提前用清水泡八小时，泡到豆皮起皱、捏开中心没有白芯。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡豆的水要没过豆子三指，天热请冷藏浸泡。",
      "visual_cue": "豆粒明显胀大、捏开断面颜色一致"
    },
    {
      "n": 2,
      "text": "泡好的豆子沥干，与清水、一半洋葱一起入锅煮开，撇净浮沫。",
      "time_min": 10,
      "heat": "中火",
      "tip": "先大火煮开再撇沫，豆腥味主要在这一层浮沫里。",
      "visual_cue": "水面浮起灰色泡沫、豆子开始上浮"
    },
    {
      "n": 3,
      "text": "转小火加盖煮五十分钟，煮到豆子一压就烂，捞出洋葱弃掉。",
      "time_min": 50,
      "heat": "小火",
      "tip": "煮豆别放盐，盐会让豆皮变硬久煮不烂。",
      "visual_cue": "豆汤变深紫、豆粒轻压即散"
    },
    {
      "n": 4,
      "text": "平底锅放一半植物油，中火炒香剩余洋葱碎与蒜末，加孜然和牛至。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香料要在油里炒十秒再下豆，香气才出得来。",
      "visual_cue": "洋葱透明发软、香料味上扬"
    },
    {
      "n": 5,
      "text": "漏勺捞入豆子，舀两勺煮豆水，边压边炒到成粗泥状。",
      "time_min": 10,
      "heat": "中火",
      "tip": "留一点豆粒口感更好，压得太细会像罐头。",
      "visual_cue": "豆泥浓稠、铲子划过留痕"
    },
    {
      "n": 6,
      "text": "加盐调味，倒入剩余植物油翻炒到豆泥能整块脱离锅底。",
      "time_min": 6,
      "heat": "中火",
      "tip": "最后这勺油是「refrito（反复炒）」的灵魂，别省。",
      "visual_cue": "豆泥表面泛油光、锅底出现薄膜"
    }
  ],
  "tips": [
    "煮豆水不要倒，压泥时用它调节稠度，比清水香得多。",
    "想更浓郁可加一小块猪油同炒，风味更接近墨西哥本地。",
    "做多了可冷冻成小份，取用方便且风味不变。"
  ],
  "common_mistakes": [
    "煮豆时先加盐，豆皮变硬怎么煮都不烂。",
    "豆子没泡直接煮，耗时翻倍且外烂内硬。",
    "压得太干，冷却后结成硬块抹不开。"
  ],
  "substitutions": [
    {
      "original": "黑豆",
      "substitute": "红豆",
      "ratio": "500g 对 500g",
      "note": "颜色偏红，甜味更足，盐可略减。"
    },
    {
      "original": "植物油",
      "substitute": "黄油",
      "ratio": "40ml 对 35g",
      "note": "奶香更浓，适合配烤肉。"
    }
  ],
  "variations": [
    "加一勺辣椒粉与少量番茄碎，做成微辣的街头版本。",
    "表面撒一层奶酪碎，入烤箱烤到融化做成焗豆泥。"
  ],
  "serving_suggestion": "盛碗配玉米饼、烤肉与酸奶油，也可作为卷饼的底酱。",
  "storage": "冷藏四天，冷冻一个月；复热加少量清水搅开。",
