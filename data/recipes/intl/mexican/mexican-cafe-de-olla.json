  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 800,
          "unit": "ml",
          "note": "煮咖啡的底水",
          "optional": false
        },
        {
          "name": "咖啡",
          "name_en": "coffee",
          "amount": 40,
          "unit": "g",
          "note": "粗研磨的中深烘",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 10,
          "unit": "g",
          "note": "一小段",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 40,
          "unit": "g",
          "note": "圆锥糖更地道",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橙子",
          "name_en": "orange",
          "amount": 1,
          "unit": "piece",
          "note": "只取两片果皮",
          "optional": false
        },
        {
          "name": "丁香",
          "name_en": "clove",
          "amount": 2,
          "unit": "g",
          "note": "两三粒即可",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "陶壶",
    "细滤网",
    "量杯",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "陶壶里倒入清水，放入桂皮、丁香与两片橙皮，大火煮开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "橙皮只刮外层黄色部分，带上白瓤整壶会发苦。",
      "visual_cue": "水沸后香气冲上来，桂皮舒展开"
    },
    {
      "n": 2,
      "text": "转小火加盖煮五分钟，让香料的味道充分进到水里。",
      "time_min": 6,
      "heat": "小火",
      "tip": "这一步是风味基础，别急着把咖啡倒进去。",
      "visual_cue": "水色微黄，闻起来有甜香料味"
    },
    {
      "n": 3,
      "text": "加入红糖搅拌到完全化开，尝一口甜度再决定是否补。",
      "time_min": 2,
      "heat": "小火",
      "tip": "糖先完全化开，咖啡的苦味才会被托得柔和些。",
      "visual_cue": "液体呈浅琥珀色，没有糖粒沉底"
    },
    {
      "n": 4,
      "text": "再次煮沸后关火，倒入粗研磨的咖啡粉，轻轻搅一圈。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火再下粉，煮开会让咖啡发苦发涩。",
      "visual_cue": "咖啡粉浮在液面，散出明显香气"
    },
    {
      "n": 5,
      "text": "盖上壶盖静置四分钟，让咖啡粉慢慢沉到壶底。",
      "time_min": 5,
      "heat": "无火",
      "tip": "不要搅拌过度，否则细粉会堵住滤网。",
      "visual_cue": "粉层沉到壶底，液面变清亮"
    },
    {
      "n": 6,
      "text": "用细滤网慢慢过滤到另一只壶里，滤掉所有咖啡渣。",
      "time_min": 4,
      "heat": "无火",
      "tip": "滤的时候别压渣，压出的是苦味而不是香。",
      "visual_cue": "滤出的咖啡透亮无渣，颜色深褐"
    },
    {
      "n": 7,
      "text": "趁热倒进厚壁小杯，每杯可以再放一小段桂皮。",
      "time_min": 2,
      "heat": "无火",
      "tip": "杯子先用热水烫过一遍，香气能多留一会儿。",
      "visual_cue": "杯口飘着香料气，表面一层细细的油光"
    }
  ],
  "tips": [
    "用陶壶煮比不锈钢锅更香，受热也更均匀。",
    "没有圆锥糖就用红糖块，风味接近。",
    "加一小勺可可粉，喝起来更像墨西哥老式咖啡。",
    "剩下的冷藏后加冰牛奶，做成冰咖啡也不错。"
  ],
  "common_mistakes": [
    "咖啡粉和冷水一起煮开，成品苦得发涩。",
    "桂皮放太多，整壶都是药味盖掉咖啡香。",
    "滤的时候用力压渣，喝起来满口细粉。"
  ],
  "substitutions": [
    {
      "original": "红糖",
      "substitute": "白糖",
      "ratio": "40克:35克",
      "note": "甜味更干净，少了焦糖香。"
    },
    {
      "original": "咖啡",
      "substitute": "速溶咖啡粉",
      "ratio": "40克:20克",
      "note": "风味变薄，香料要减半。"
    }
  ],
  "variations": [
    "加一小撮辣椒粉，做出带微辣的版本。",
    "用牛奶替换一半的清水，喝起来口感更绵密。"
  ],
  "serving_suggestion": "装在粗陶小杯里，配一块甜面包当简单的早餐。",
  "storage": "现煮现喝最好，冷藏不超过一天，复热别煮沸。",
