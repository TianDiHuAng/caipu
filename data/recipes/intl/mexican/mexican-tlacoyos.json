  "equipment": [
    "平底锅",
    "擀面杖",
    "保鲜膜",
    "碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米粉加盐与温水揉成不粘手的面团，盖布醒十分钟。",
      "time_min": 13,
      "heat": "无火",
      "tip": "水慢慢加，面团要像耳垂一样软。",
      "visual_cue": "面团光滑，按压有弹性"
    },
    {
      "n": 2,
      "text": "红腰豆用锅铲压成粗泥，拌入洋葱碎、孜然与一半香菜。",
      "time_min": 7,
      "heat": "无火",
      "tip": "豆泥别压太细，留颗粒更有口感。",
      "visual_cue": "豆泥浓稠，能成团不散"
    },
    {
      "n": 3,
      "text": "面团分成六个小剂子，掌心压成中间略厚的圆片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "中间厚一点，包馅时才不破。",
      "visual_cue": "圆片大小一致，边缘略薄"
    },
    {
      "n": 4,
      "text": "圆片中央放一勺豆泥，对折捏紧边缘，捏成半月形。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边缘一定捏实，煎的时候才不会裂开。",
      "visual_cue": "边缘压出褶，馅不外露"
    },
    {
      "n": 5,
      "text": "把半月饼放保鲜膜上，用擀面杖轻轻压成橄榄形薄饼。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压的时候用力均匀，太用力会挤破。",
      "visual_cue": "饼厚约一厘米，形状饱满"
    },
    {
      "n": 6,
      "text": "平底锅倒橄榄油，中火烧热后放入薄饼，煎四分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一次别放太多，留出翻面的空间。",
      "visual_cue": "底面金黄，边缘略翘"
    },
    {
      "n": 7,
      "text": "翻面再煎三分钟至两面焦黄，饼身鼓起即熟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鼓起就说明内部蒸汽循环，馅也热透了。",
      "visual_cue": "两面有焦斑，饼身微鼓"
    },
    {
      "n": 8,
      "text": "盛盘后放番茄片与墨西哥辣椒圈，撒奶酪与剩下的香菜。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热撒奶酪，靠余温化开才香。",
      "visual_cue": "奶酪半融，配菜铺满饼面"
    }
  ],
  "tips": [
    "没有玉米粉可用现成的玉米饼代替，包馅后直接煎。",
    "豆泥能提前一天做好冷藏，早上省一半工。",
    "怕辣就去掉墨西哥辣椒，改用青椒圈。",
    "配一份墨西哥生青酱，酸辣清爽能解油腻。"
  ],
  "common_mistakes": [
    "面团太干，压饼时边缘一次性裂开。",
    "馅放太多，怎么压都合不上，煎的时候全漏出来。",
    "火太大，外面焦了里面还是生粉味。"
  ],
  "substitutions": [
    {
      "original": "红腰豆",
      "substitute": "黑豆",
      "ratio": "250克:250克",
      "note": "口感更绵，颜色偏深。"
    },
    {
      "original": "玉米粉",
      "substitute": "玉米面",
      "ratio": "300克:300克",
      "note": "颗粒略粗，需多醒五分钟。"
    }
  ],
  "variations": [
    "馅料换成炒香的南瓜花与奶酪，是墨西哥中部的做法。",
    "饼煎好后剖开，塞入炒肉与生菜，做成夹馅版本。"
  ],
  "serving_suggestion": "三人份小食，每人两个，配生青酱与番茄片，也可当正餐主食。",
  "storage": "冷藏两天内吃完，复热用干锅两面各煎两分钟；不建议冷冻，玉米饼容易开裂。",
  "nutrition_estimate": {
    "basis": "按三人份估算",
