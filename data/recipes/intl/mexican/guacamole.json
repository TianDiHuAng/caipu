        }
      ]
    }
  ],
  "equipment": [
    "碗",
    "叉子",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛油果对半切开取出果核，用勺子沿皮把果肉整块挖进碗里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "挑按压微软的，硬果打不出绵密感。",
      "visual_cue": "果肉完整、没有褐变发黑"
    },
    {
      "n": 2,
      "text": "番茄去籽切小丁，洋葱与香菜切细末，青柠对半挤出汁水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "番茄籽水分多，一定要去掉。",
      "visual_cue": "丁末分明、汁水备好"
    },
    {
      "n": 3,
      "text": "用叉子把果肉压成粗泥，刻意留一些小块，口感才立体。",
      "time_min": 3,
      "heat": "无火",
      "tip": "别用料理机，会打成糊。",
      "visual_cue": "泥中带块、质地粗糙"
    },
    {
      "n": 4,
      "text": "拌入番茄丁、洋葱末、香菜与青柠汁，加盐与黑胡椒调味即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁既提味又防氧化。",
      "visual_cue": "颜色翠绿、味道酸咸平衡"
    }
  ],
  "tips": [
    "选按压微软的熟牛油果，硬果压不散也不香。",
    "青柠汁一定要加，既是调味也是防氧化。",
    "用叉子压而不用料理机，保留颗粒才好吃。"
  ],
  "common_mistakes": [
    "牛油果太生就压，成品带着青涩的草味。",
    "番茄连籽一起切进去，酱很快出水变稀。",
    "提前几小时做好不封膜，表面大片发黑。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "40g 对 40g",
      "note": "香气更柔和，酸度接近。"
    },
    {
      "original": "香菜",
      "substitute": "小葱",
      "ratio": "10g 对 10g",
      "note": "接受度更高，香气偏冲。"
    }
  ],
  "variations": [
    "加辣版：拌入 5g 青辣椒碎，辛香更足。",
    "加果版：拌入 50g 石榴籽，口感更清脆。"
  ],
  "serving_suggestion": "配玉米饼片或蔬菜条蘸食，也可抹在三明治里。",
  "storage": "表面贴保鲜膜冷藏可存 1 天，挤青柠汁能延缓发黑。",
