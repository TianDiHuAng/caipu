  "steps": [
    {
      "n": 1,
      "text": "玉米饼片平铺在烤盘上，送进一百八十度烤箱烤八分钟，烤到干脆不焦。",
      "time_min": 8,
      "heat": "中火",
      "tip": "烤比油炸省油，饼片也更挺，裹酱后不易烂。",
      "visual_cue": "饼片边缘微卷，掰开声音清脆"
    },
    {
      "n": 2,
      "text": "平底锅放一半植物油，下洋葱丁与蒜炒到透明，再放番茄块与青辣椒炒软。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄要炒到出汁塌软，红酱才有厚度。",
      "visual_cue": "番茄软塌出红汁，洋葱透明发亮"
    },
    {
      "n": 3,
      "text": "加清水与盐，小火煮五分钟，用勺背把番茄压碎，煮成能挂勺的浓稠红酱。",
      "time_min": 6,
      "heat": "小火",
      "tip": "酱别收得太干，等下还要裹饼片，太干会发硬。",
      "visual_cue": "酱色深红，勺背挂上一层不流"
    },
    {
      "n": 4,
      "text": "把烤好的饼片倒进锅里，用铲子轻翻两下，让每片都裹上红酱就立刻关火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "饼片下锅只翻两下，久煮必烂，裹匀就停。",
      "visual_cue": "饼片均匀挂红，边缘仍带脆感"
    },
    {
      "n": 5,
      "text": "另起锅放剩下的植物油，把鸡蛋煎到蛋白凝固、蛋黄半熟，撒盐调味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煎蛋时盖上盖子三十秒，蛋白熟蛋黄还流心。",
      "visual_cue": "蛋白边缘焦脆，蛋黄表面裹白膜"
    },
    {
      "n": 6,
      "text": "饼片盛盘，放上煎蛋，淋酸奶油、撒奶酪丝与香菜，趁热端上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪靠余温化开就好，别回锅再烤，蛋会过熟。",
      "visual_cue": "盘面红白绿相间，奶酪微微融化"
    }
  ],
  "tips": [
    "用隔夜风干的玉米饼做最合适，新鲜饼片水分多，裹酱就成糊。",
    "红酱可以提前煮好冷藏，吃前加热再裹饼片，早餐做起来只要十分钟。",
    "不吃辣就去掉青辣椒，用一点辣椒粉替代，辣度更可控。",
    "顶上配一勺黑豆泥，蛋白质更足，能当正餐吃。"
  ],
  "common_mistakes": [
    "饼片在酱里煮太久，端上桌变成一摊软糊，失去脆的口感。",
    "番茄没炒透就加水，红酱水味重，只有酸没有甜。",
    "煎蛋煎到蛋黄全熟才上桌，拌开后干噎，失了滑润感。"
  ],
  "substitutions": [
    {
      "original": "玉米饼",
      "substitute": "玉米片",
      "ratio": "200克:150克",
      "note": "不必烤，直接裹酱，脆度略差但更快。"
    },
    {
      "original": "酸奶油",
      "substitute": "酸奶",
      "ratio": "60克:60克",
      "note": "选浓稠原味款，酸度接近但奶香更淡。"
    }
  ],
  "variations": [
    "换成绿酱版，把番茄与青辣椒换成青番茄与墨西哥青椒，颜色翠绿，酸味更锐。",
    "加一百克手撕鸡丝铺在饼片上，就是更有饱足感的一餐。"
  ],
  "serving_suggestion": "用平底浅盘盛装，煎蛋放在饼片正中，配一杯冰镇果汁或黑咖啡当早餐。",
  "storage": "饼片与酱分开存放，冷藏两天内吃完；复热时酱单独加热再拌饼片，避免整体变糊。",
