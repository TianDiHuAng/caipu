  "steps": [
    {
      "n": 1,
      "text": "牛里脊切成半厘米厚的片，用刀背轻轻拍松表面纤维。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拍松后腌料渗得更快，口感也更嫩。，注意火候。",
      "visual_cue": "肉片均匀，厚薄一致，状态稳定"
    },
    {
      "n": 2,
      "text": "蒜切末，和柠檬汁、辣椒粉、孜然、盐、一半橄榄油调成腌汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先调匀再放肉，味道才分布均匀。，注意火候。",
      "visual_cue": "腌汁红亮，香气冲鼻，状态稳定"
    },
    {
      "n": 3,
      "text": "肉片放进腌汁抓匀，冷藏腌三十分钟入味。这一步不要着急。",
      "time_min": 30,
      "heat": "无火",
      "tip": "三十分钟足够，太久肉质会变松散。，注意火候。",
      "visual_cue": "肉片裹汁，颜色发深，状态稳定"
    },
    {
      "n": 4,
      "text": "平底锅倒入剩余橄榄油烧到微微冒烟，肉片平铺下锅。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "锅够热才能封住汁水，一次别铺太满。",
      "visual_cue": "锅中冒烟，肉面滋滋，状态稳定"
    },
    {
      "n": 5,
      "text": "每面煎一分半钟形成焦痕，取出放在盘里静置五分钟。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "薄片煎过久会变硬，看到焦痕就翻面。",
      "visual_cue": "表面焦褐，边缘卷起，状态稳定"
    },
    {
      "n": 6,
      "text": "静置后逆着纹理切成条，撒洋葱丝和香菜碎装盘。",
      "time_min": 5,
      "heat": "无火",
      "tip": "逆纹切才咬得动，顺纹切会拉丝。，注意火候。",
      "visual_cue": "切面平整，肉汁清亮，状态稳定"
    }
  ],
  "tips": [
    "肉片拍松再腌，味道渗得快也更嫩。，值得留意。",
    "锅烧到冒烟再下肉，才煎得出焦香。，值得留意。",
    "切之前逆着纹理，口感才不塞牙。，值得留意。"
  ],
  "common_mistakes": [
    "肉片切太厚，外面焦了里面还生。，务必避免。",
    "锅没热就下肉，出水变成煮牛肉。，务必避免。",
    "顺纹切条，嚼起来全是长长的纤维。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "西冷",
      "ratio": "700 克:700 克",
      "note": "油花更多，煎制时间加三十秒。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "80 克:80 克",
      "note": "酸香更清透，适合墨西哥风味。"
    }
  ],
  "variations": [
    "配玉米饼和小洋葱，做成烤牛肉塔可。，也很受欢迎。",
    "撒少许辣椒粉，辣味更突出。，也很受欢迎。"
  ],
  "serving_suggestion": "切条后夹进热玉米饼，配鳄梨酱和柠檬角一起吃。",
  "storage": "冷藏两天，复热用平底锅大火快炒三十秒。，效果更稳定。",
