  ],
  "steps": [
    {
      "n": 1,
      "text": "苹果去核连皮切成两厘米的块，橙子带皮切成半厘米厚的片。",
      "time_min": 9,
      "heat": "无火",
      "tip": "橙子带皮煮，皮里的精油是这道饮品的魂。",
      "visual_cue": "果块切好，橙片圆整"
    },
    {
      "n": 2,
      "text": "胡萝卜削皮切成滚刀块，丁香轻压一下让香气散出。",
      "time_min": 6,
      "heat": "无火",
      "tip": "丁香压破再煮，香气才出得来但不发冲。",
      "visual_cue": "胡萝卜块均匀，丁香略碎"
    },
    {
      "n": 3,
      "text": "汤锅倒清水，放入肉桂和丁香，大火烧开后转小火煮五分钟。",
      "time_min": 7,
      "heat": "小火",
      "tip": "香料先煮出味，再下水果才不会被抢味。",
      "visual_cue": "汤水微黄，香料香气明显"
    },
    {
      "n": 4,
      "text": "下苹果块、胡萝卜块和橙片，小火煮十五分钟至水果变软。",
      "time_min": 17,
      "heat": "小火",
      "tip": "小火慢煮，水果软而不烂才好喝。",
      "visual_cue": "水果微软，汤色橙黄"
    },
    {
      "n": 5,
      "text": "加白糖与蜂蜜搅匀，再煮三分钟让甜味融合。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蜂蜜最后加，久煮香气会散掉。",
      "visual_cue": "甜味均匀，汤面微微发亮"
    },
    {
      "n": 6,
      "text": "关火挤入柠檬汁，盖盖焖五分钟让味道融合。",
      "time_min": 6,
      "heat": "无火",
      "tip": "关火挤柠檬，酸香清亮不发闷。",
      "visual_cue": "酸香清爽，汤色明亮"
    },
    {
      "n": 7,
      "text": "用滤网滤去香料渣，连水果块一起盛进马克杯。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香料渣要滤掉，喝的时候才不会呛口。",
      "visual_cue": "杯中汤色橙红，漂着果块"
    }
  ],
  "tips": [
    "橙子带皮煮，皮里的精油是这道饮品的魂。",
    "香料先煮五分钟再下水果，层次才清楚。",
    "蜂蜜最后加，久煮香气会全散掉。",
    "关火再挤柠檬汁，酸香才清亮不闷。"
  ],
  "common_mistakes": [
    "水果切太大块，煮十五分钟还是硬的。",
    "肉桂丁香放太多，喝起来像药水。",
    "大火滚煮，水果全被煮成一锅泥。",
    "糖一开始就放，水果反而不容易煮软。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "梨",
      "ratio": "200克:200克",
      "note": "口感更绵，甜度略低。"
    },
    {
      "original": "蜂蜜",
      "substitute": "红糖",
      "ratio": "20克:22克",
      "note": "颜色更深，香气偏焦糖。"
    }
  ],
  "variations": [
    "加一把葡萄干同煮，果香更浓郁。",
    "放两片生姜同煮，暖身效果更明显。",
    "加一小杯朗姆酒，做成成人版本。"
  ],
  "serving_suggestion": "盛进马克杯连果块一起吃，冬天过节时最好配一块甜面包，暖手又暖胃。",
  "storage": "冷藏可放两天，复热小火加热到微滚，不要反复烧开。",
