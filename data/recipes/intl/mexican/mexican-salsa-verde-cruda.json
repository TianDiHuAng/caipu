  "equipment": [
    "搅拌机",
    "刀",
    "砧板",
    "碗",
    "汤勺",
    "量勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青椒洗净去蒂，切成三段，不用去籽以保留辣味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "籽和筋膜是辣味来源，怕辣可去掉。",
      "visual_cue": "青椒段大小一致，色翠"
    },
    {
      "n": 2,
      "text": "香菜连根洗净沥干，洋葱切小块，大蒜去皮拍一下。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香菜根一定要洗到没有泥沙。",
      "visual_cue": "香菜根洁白，洋葱成小块"
    },
    {
      "n": 3,
      "text": "青椒、香菜、洋葱、大蒜与墨西哥辣椒一起放进搅拌机，点动三次打碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "点动能让颗粒均匀，一次打久会成糊。",
      "visual_cue": "颗粒粗大，无整块料"
    },
    {
      "n": 4,
      "text": "加盐、黑胡椒与半个青柠的汁，再打十秒至浓稠。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐能让蔬菜出水，酱体自然变稠。",
      "visual_cue": "酱体浓稠，色深绿带颗粒"
    },
    {
      "n": 5,
      "text": "倒入碗中，淋橄榄油搅匀，尝味补剩余青柠汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸度按口味调，够酸才解腻。",
      "visual_cue": "表面泛油光，能挂住勺"
    },
    {
      "n": 6,
      "text": "静置十分钟让味道融合，再配烤肉、炸物或煎蛋食用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "现做现吃最好，放久了会出水。",
      "visual_cue": "酱体微微分层，香气清新"
    }
  ],
  "tips": [
    "想要烟熏味，把青椒在干锅上烘出焦斑再打。",
    "酱太稀可以加一勺煮熟的米饭同打，浓稠度立刻上来。",
    "一次做一小碗，两天内吃完风味最好。",
    "配炸玉米片当蘸酱，比瓶装的好吃太多。"
  ],
  "common_mistakes": [
    "香菜带水下锅，打出来一层水，酱挂不住。",
    "盐一次加太多，青柠的酸香被压住。",
    "打太久成顺滑液体，失去生青酱的颗粒感。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "青番茄",
      "ratio": "300克:350克",
      "note": "更酸更传统，需加半勺盐平衡。"
    },
    {
      "original": "墨西哥辣椒",
      "substitute": "小米辣",
      "ratio": "30克:15克",
      "note": "辣度高，用量减半。"
    }
  ],
  "variations": [
    "加半个牛油果同打，酱体更绵密，适合配鱼肉。",
    "加一勺烤南瓜籽，做出带坚果香的浓厚版本。"
  ],
  "serving_suggestion": "四人份蘸酱，配玉米片、烤鸡或 tacos，也可以浇在煎蛋上。",
  "storage": "密封冷藏两天内吃完，表面淋一层橄榄油隔氧；不建议冷冻，解冻后出水严重。",
