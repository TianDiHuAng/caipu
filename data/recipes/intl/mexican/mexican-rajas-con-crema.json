  "equipment": [
    "平底锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青椒去蒂去籽，切成半厘米宽的长条，洋葱切成细丝备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "青椒籽和内膜去干净，辣味才不冲。，注意火候。",
      "visual_cue": "椒条均匀，洋葱细丝，状态稳定"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油，下洋葱丝中火炒到软塌且边缘微黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒到焦黄，甜味才压得住青椒的青气。",
      "visual_cue": "洋葱软黄，油面泛香，状态稳定"
    },
    {
      "n": 3,
      "text": "加入青椒条翻炒三分钟，炒到表面起皱但仍保持脆度。",
      "time_min": 4,
      "heat": "中火",
      "tip": "青椒炒到起皱就够，久炒会软塌发黄。",
      "visual_cue": "椒条起皱，颜色翠绿，状态稳定"
    },
    {
      "n": 4,
      "text": "撒盐和黑胡椒翻匀，转小火让锅里的水分慢慢收掉。",
      "time_min": 3,
      "heat": "小火",
      "tip": "先收掉水分，酸奶油下锅才不稀。，注意火候。",
      "visual_cue": "锅中干爽，汁水收拢，状态稳定"
    },
    {
      "n": 5,
      "text": "关小火倒入酸奶油，快速翻拌到每根椒条都裹上白酱。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酸奶油怕高温，小火翻拌才不结块出水。",
      "visual_cue": "白酱包裹，质地顺滑，状态稳定"
    },
    {
      "n": 6,
      "text": "撒上奶酪丝盖盖焖两分钟，等奶酪化开后即可上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "奶酪化开就关火，久焖会析出油脂。，注意火候。",
      "visual_cue": "奶酪融化，表面微拉丝"
    }
  ],
  "tips": [
    "青椒籽去干净，辣味才不会太冲。，值得留意。",
    "酸奶油小火下锅，才不会结块出水。，值得留意。",
    "奶酪化开就关火，久焖会出油分离。，值得留意。"
  ],
  "common_mistakes": [
    "大火下酸奶油，酱汁立刻结块分层。，务必避免。",
    "青椒炒得过久，颜色发黄口感全软。，务必避免。",
    "奶酪放太早久焖，表面浮一层清油。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "淡奶油",
      "ratio": "150 克:130 毫升",
      "note": "更稀薄，小火收稠后再下。"
    },
    {
      "original": "青椒",
      "substitute": "甜椒",
      "ratio": "500 克:500 克",
      "note": "完全不辣，适合孩子吃。"
    }
  ],
  "variations": [
    "加一把玉米粒同炒，甜味和口感更丰富。，也很受欢迎。",
    "用玉米饼卷着吃，做成素版塔可。，也很受欢迎。"
  ],
  "serving_suggestion": "配热玉米饼或白米饭，奶香里带一点辣，很下饭。",
  "storage": "冷藏两天，复热时小火加少许清水慢慢搅开。",
