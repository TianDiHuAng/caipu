  "equipment": [
    "平底锅",
    "锅铲",
    "刀",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶酪用擦板擦成细丝，装碗备用防止结块。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "擦丝的奶酪融得快，也不容易油水分离。",
      "visual_cue": "奶酪成丝，松散不粘，状态稳定"
    },
    {
      "n": 2,
      "text": "番茄去籽切小丁，洋葱切碎，香菜切末分别装好。",
      "time_min": 6,
      "heat": "无火",
      "tip": "番茄去籽才不会出水，蘸酱才够稠。，注意火候。",
      "visual_cue": "丁块均匀，盘中无水，状态稳定"
    },
    {
      "n": 3,
      "text": "平底锅放黄油小火化开，下洋葱碎炒到透明发软。",
      "time_min": 4,
      "heat": "小火",
      "tip": "小火炒洋葱，甜味才慢慢出来不焦。，注意火候。",
      "visual_cue": "洋葱透明，黄油起泡，状态稳定"
    },
    {
      "n": 4,
      "text": "加番茄丁和辣椒粉炒两分钟，收掉多余水分。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "水分收干，加奶酪后才不会稀成汤。，注意火候。",
      "visual_cue": "番茄软烂，锅底干爽，状态稳定"
    },
    {
      "n": 5,
      "text": "转最小火倒入牛奶，分次撒入奶酪丝慢慢搅到融化。",
      "time_min": 6,
      "heat": "小火",
      "tip": "火一大奶酪就出油分层，全程最小火。",
      "visual_cue": "奶酪融化，浆体顺滑，状态稳定"
    },
    {
      "n": 6,
      "text": "加盐调味，撒上香菜碎，趁热端上桌立刻吃。",
      "time_min": 3,
      "heat": "小火",
      "tip": "奶酪凉了就凝住，端上桌要马上吃。，注意火候。",
      "visual_cue": "表面光滑，能拉出丝，状态稳定"
    }
  ],
  "tips": [
    "奶酪擦丝再融，受热均匀不出油。，值得留意。",
    "全程最小火，奶酪才不会油水分离。，值得留意。",
    "番茄先去籽，蘸酱才浓稠不稀。，值得留意。"
  ],
  "common_mistakes": [
    "大火融奶酪，很快结块还渗一层油。，务必避免。",
    "番茄不去籽直接炒，蘸酱稀得像水。，务必避免。",
    "放凉后重新加热，质地变得又韧又硬。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "马苏里拉",
      "ratio": "400 克:400 克",
      "note": "拉丝更长，咸味略淡可补盐。"
    },
    {
      "original": "牛奶",
      "substitute": "淡椰浆",
      "ratio": "120 毫升:120 毫升",
      "note": "带椰香，适合不吃乳制品的人。"
    }
  ],
  "variations": [
    "加少许炒香的香肠碎，口感更丰富。，也很受欢迎。",
    "撒一层辣椒圈，辣味更直接。，也很受欢迎。"
  ],
  "serving_suggestion": "趁热当蘸酱食用，也可以浇在塔可上。",
  "storage": "冷藏一天，复热须小火加少许牛奶慢慢搅开。",
