  "equipment": [
    "汤锅",
    "和馅盆",
    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米用清水泡十分钟后沥干，拌进绞好的五花肉里一起搅打。",
      "time_min": 12,
      "heat": "无火",
      "tip": "加米能让肉丸更松软，也不容易在汤里散开。",
      "visual_cue": "肉料发黏有筋性，米粒均匀分布在肉里"
    },
    {
      "n": 2,
      "text": "肉料里加蛋液、蒜末、碎洋葱、孜然、牛至和一半盐，顺一个方向搅。",
      "time_min": 6,
      "heat": "无火",
      "tip": "同一方向搅到起胶，丸子才抱团不散。",
      "visual_cue": "肉料拉扯能出细丝，盆边干净不粘"
    },
    {
      "n": 3,
      "text": "手上蘸水，把肉料搓成乒乓球大小的丸子，摆在盘里备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丸子大小一致，煮的时候才能同时熟。",
      "visual_cue": "丸子表面光滑圆整，一只手掌能放下三个"
    },
    {
      "n": 4,
      "text": "汤锅放少量油，把洋葱丝炒到透明，倒入番茄泥炒出红油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄泥要炒到颜色由亮红变深，酸味才柔和。",
      "visual_cue": "锅底番茄泥变深红，油浮在表面发亮"
    },
    {
      "n": 5,
      "text": "倒入高汤煮开，轻轻放入丸子，转小火保持微沸。",
      "time_min": 8,
      "heat": "大火",
      "tip": "下丸子时水温别滚得太猛，否则容易冲散。",
      "visual_cue": "丸子浮起定型，汤面开始冒小泡"
    },
    {
      "n": 6,
      "text": "加入胡萝卜与土豆块，小火炖二十五分钟到蔬菜软烂。",
      "time_min": 27,
      "heat": "小火",
      "tip": "蔬菜切得差不多大小，熟的时间才一致。",
      "visual_cue": "筷子能轻松戳透土豆，汤色红亮不浑"
    },
    {
      "n": 7,
      "text": "加剩下的盐调咸淡，撒上香菜碎，关火焖两分钟再盛。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐要分两次加，最后一点一点补最稳。",
      "visual_cue": "汤清味厚，丸子咬开里面是浅粉色"
    }
  ],
  "tips": [
    "肉料换成一半牛肉一半猪肉，风味更浓。",
    "丸子可以提前搓好冷冻，煮的时候不用解冻。",
    "汤里加一把薄荷叶，是墨西哥南部的常见做法。",
    "剩下的汤泡米饭吃，比单喝更顶饱。"
  ],
  "common_mistakes": [
    "肉料没搅上劲就下锅，丸子一煮就散成肉末。",
    "水大滚时下丸子，表面被冲裂汤也变浑。",
    "蔬菜和丸子同时下锅，肉老了土豆还硬。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "鸡腿肉",
      "ratio": "500克:500克",
      "note": "更清爽，丸子需多加一勺米。"
    },
    {
      "original": "大米",
      "substitute": "面包糠",
      "ratio": "40克:35克",
      "note": "口感更松，但吸汤更快。"
    }
  ],
  "variations": [
    "汤里加几片墨西哥辣椒，酸辣味更开胃。",
    "丸子中央包一小块奶酪，咬开会爆浆。"
  ],
  "serving_suggestion": "盛在深碗里，配几片青柠和一叠玉米饼一起上桌。",
  "storage": "冷藏三天，冷冻一个月，复热后加新鲜香菜。",
