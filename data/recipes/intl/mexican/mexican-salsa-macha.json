    "搅拌机",
    "碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花生去皮，干锅小火炒到表面泛油光。这一步别急着翻动。",
      "time_min": 8,
      "heat": "小火",
      "tip": "不停翻，花生容易局部焦，火候别过。",
      "visual_cue": "花生微黄，香气浓，状态稳定"
    },
    {
      "n": 2,
      "text": "干辣椒剪成段，抖掉大部分辣椒籽。这一步别急着翻动。",
      "time_min": 4,
      "heat": "无火",
      "tip": "籽留一点提辣，太多会苦，火候别过。",
      "visual_cue": "辣段均匀，籽粒少，状态稳定"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，冷油下蒜片小火慢炸。这一步别急着翻动。",
      "time_min": 4,
      "heat": "小火",
      "tip": "冷油下锅，蒜香才慢慢出来，火候别过。",
      "visual_cue": "蒜片微黄，油面平静，状态稳定"
    },
    {
      "n": 4,
      "text": "下辣椒段炸到颜色转深，立刻关火。这一步别急着翻动。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒一变深就关火，余温还会继续，火候别过。",
      "visual_cue": "椒段暗红，油色透红，状态稳定"
    },
    {
      "n": 5,
      "text": "倒入花生和芝麻，用余温浸两分钟。这一步别急着翻动。",
      "time_min": 3,
      "heat": "无火",
      "tip": "靠余温浸香，别回火再炸，火候别过。",
      "visual_cue": "花生略深，油香冲鼻，状态稳定"
    },
    {
      "n": 6,
      "text": "连油带料倒进搅拌机，加盐和白糖。这一步别急着翻动。",
      "time_min": 2,
      "heat": "无火",
      "tip": "留一点颗粒感，别打成泥，火候别过。",
      "visual_cue": "碎粒粗大，油汁浓，状态稳定"
    },
    {
      "n": 7,
      "text": "点动搅打成粗粒酱，加白醋拌匀装罐。这一步别急着翻动。",
      "time_min": 3,
      "heat": "无火",
      "tip": "点动几下就停，打过头会变糊，火候别过。",
      "visual_cue": "酱体颗粒明显，油亮，状态稳定"
    }
  ],
  "tips": [
    "辣椒一变深就关火，余温会继续加深，值得留意。",
    "打几下就停，留颗粒才香，值得留意。",
    "装罐后油要盖住料，存得更久，值得留意。"
  ],
  "common_mistakes": [
    "辣椒炸糊，整罐发苦，值得留意。",
    "打成细泥，口感全无，值得留意。",
    "油太少，酱放两天就干硬，值得留意。"
  ],
  "substitutions": [
    {
      "original": "花生",
      "substitute": "杏仁",
      "ratio": "150 克:150 克",
      "note": "更硬，炒的时间加三分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "辣椒碎",
      "ratio": "30 克:20 克",
      "note": "辣度更直接，注意别炸糊。"
    }
  ],
  "variations": [
    "加一把南瓜籽，坚果香更立体，值得留意。",
    "放一点巧克力，做成摩尔风味，值得留意。"
  ],
  "serving_suggestion": "浇在玉米饼、煎蛋或面条上，效果更稳定。",
  "storage": "冷藏一个月，取用须用干勺，效果更稳定。",
