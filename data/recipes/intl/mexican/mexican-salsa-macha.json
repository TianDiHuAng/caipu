        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "料理机",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花生挑掉坏粒，用干锅小火慢慢烘到表皮出现褐色斑点。",
      "time_min": 8,
      "heat": "小火",
      "tip": "干锅烘花生要不停翻，稍有焦味整锅都苦。",
      "visual_cue": "花生浅褐，香气散出，状态稳定"
    },
    {
      "n": 2,
      "text": "烘好的花生倒出摊开晾凉，用手搓掉外层薄皮备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "晾凉后搓皮更容易，带皮打酱会发苦。",
      "visual_cue": "花生仁完整，皮已脱，状态稳定"
    },
    {
      "n": 3,
      "text": "小米辣剪成两厘米小段，抖掉大部分辣椒籽减少苦味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "籽留一点提辣，全留会苦得盖住花生香。",
      "visual_cue": "辣段均匀，籽已减半，状态稳定"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到微热，下蒜片小火炸到浅金色捞出。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜片浅金就捞，颜色再深就带焦苦味。",
      "visual_cue": "蒜片金黄，油香浓，状态稳定"
    },
    {
      "n": 5,
      "text": "同一锅油里下辣段小火慢炸两分钟，炸出红油和辣香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "油温别太高，辣段一黑整锅酱就毁了。",
      "visual_cue": "油色深红，辣香扑鼻，状态稳定"
    },
    {
      "n": 6,
      "text": "把花生、蒜片、辣段和盐、白糖放进料理机，倒入炸油打粗碎。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打几下就停，保留粗颗粒口感最好。，注意火候。",
      "visual_cue": "酱体粗粝，油色红亮，状态稳定"
    },
    {
      "n": 7,
      "text": "倒出拌入炒香的白芝麻，装瓶静置半小时让味道融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置半小时风味融合，第二天更好吃。",
      "visual_cue": "酱面浮油，芝麻均匀，状态稳定"
    }
  ],
  "tips": [
    "花生干锅慢烘，香气足又不带油腥。，值得留意。",
    "辣段小火炸，油温高了立刻发苦。，值得留意。",
    "打酱只打几下，保留粗颗粒更香。，值得留意。"
  ],
  "common_mistakes": [
    "花生烘到深褐，整瓶酱都有焦苦味。，务必避免。",
    "辣段大火下锅，几秒钟就炸成黑渣。，务必避免。",
    "打得过细成泥，失去颗粒的嚼劲。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "小米辣",
      "substitute": "辣椒碎",
      "ratio": "40 克:25 克",
      "note": "辣度更集中，盐减一克。"
    },
    {
      "original": "花生",
      "substitute": "葵花籽仁",
      "ratio": "150 克:160 克",
      "note": "坚果香更淡，烘制时间减两分钟。"
    }
  ],
  "variations": [
    "加一勺白芝麻酱，酱体更浓稠。，也很受欢迎。",
    "放少许桂皮同炸，香气带一点暖甜。，也很受欢迎。"
  ],
  "serving_suggestion": "浇在煎蛋、玉米饼或面条上，一勺就够提味。",
  "storage": "密封冷藏可放一个月，每次取用必须用干勺。",
