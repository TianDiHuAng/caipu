  ],
  "difficulty": 1,
  "time": {
    "prep_min": 40,
    "cook_min": 12,
    "total_min": 52
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "大米",
          "name_en": "rice",
          "amount": 200,
          "unit": "g",
          "note": "长粒白米",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 400,
          "unit": "ml",
          "note": "全脂牛奶",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 70,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 6,
          "unit": "g",
          "note": "肉桂棒砸碎",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 900,
          "unit": "ml",
          "note": "泡米与打浆",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "料理机",
    "细筛",
    "玻璃壶",
    "汤锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗一遍，加清水与砸碎的桂皮泡四小时，泡到米粒一捏就碎。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡足时间米才打得细，泡不够打出来有颗粒感，喝着扎嘴。",
      "visual_cue": "米粒胀大捏即碎，桂皮沉在盆底"
    },
    {
      "n": 2,
      "text": "泡好的米连桂皮与泡米水一起倒进料理机，高速打两分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打两分钟中间停一次，让机器缓一下，浆才打得细腻发白。",
      "visual_cue": "浆液乳白浓稠，看不见整粒米"
    },
    {
      "n": 3,
      "text": "打好的米浆用细筛过滤两遍，滤渣攥干弃掉，只留顺滑米浆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "滤两遍才够顺，一遍的浆喝着有细渣，冰镇后渣更明显。",
      "visual_cue": "滤出的米浆乳白顺滑无渣"
    },
    {
      "n": 4,
      "text": "米浆倒进锅里小火加热，加牛奶与白糖，边加热边搅至糖化。",
      "time_min": 8,
      "heat": "小火",
      "tip": "一定要小火并一直搅，米浆容易沉底糊锅，糊了就发苦。",
      "visual_cue": "浆液温热微稠，糖全化开"
    },
    {
      "n": 5,
      "text": "离火放凉，装壶冷藏两小时，喝时加冰块与一小撮桂皮粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冰镇后的甜度会变淡，糖可以稍微多放一点。",
      "visual_cue": "饮品乳白顺滑，表面浮细小泡沫"
    }
  ],
  "tips": [
    "这种米浆饮料是墨西哥街头最受欢迎的 agua fresca 之一。",
    "加点炼乳会更浓，是墨西哥家庭版的常见做法。",
    "想要更香可以把一半大米换成烤过的米，带一点坚果香。"
  ],
  "common_mistakes": [
    "米没泡就打，浆里全是粗粒，怎么滤都不顺。",
    "大火煮米浆还不搅，锅底一层焦糊，整锅带苦味。",
    "一次加太多桂皮，喝起来像药汤，盖住了米香。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "400毫升:400毫升",
      "note": "椰奶版更清爽，有椰香。"
    },
    {
      "original": "桂皮",
      "substitute": "肉桂粉",
      "ratio": "6克:3克",
      "note": "粉状更易入味，不需过滤。"
    }
  ],
  "variations": [
    "加一勺香草精，风味更甜润，接近冰饮店版本。",
    "用杏仁替换一半大米，做成坚果版，口感更厚。"
  ],
  "serving_suggestion": "倒进玻璃杯加满冰块，表面撒一层桂皮粉，配玉米卷饼最对味。",
  "storage": "冷藏可存两天，久放会沉淀分层，饮用前摇匀即可。",
