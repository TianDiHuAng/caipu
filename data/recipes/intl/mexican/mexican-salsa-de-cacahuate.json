        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 120,
          "unit": "ml",
          "note": "调稀",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 15,
          "unit": "g",
          "note": "炒香增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "搅拌机",
    "炒锅",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干辣椒剪去蒂部倒出籽，放进干锅小火烘两分钟到散发香气。",
      "time_min": 5,
      "heat": "小火",
      "tip": "烘到辣椒变脆但没变黑，发黑整锅会带苦味。",
      "visual_cue": "辣椒颜色转深红，捏起来脆硬不出油"
    },
    {
      "n": 2,
      "text": "花生倒进干锅，小火不断翻动炒到外皮出现焦斑。",
      "time_min": 8,
      "heat": "小火",
      "tip": "花生含油多，火一大表面糊了里面还是生的。",
      "visual_cue": "花生表皮起深褐斑点，闻起来有坚果香"
    },
    {
      "n": 3,
      "text": "番茄切半、大蒜带皮一起放进锅里干烤，烤到表皮发黑起泡。",
      "time_min": 10,
      "heat": "中火",
      "tip": "烤出焦痕是这道酱的魂，别怕番茄皮发黑。",
      "visual_cue": "番茄皮大面积起泡发黑，蒜瓣变软"
    },
    {
      "n": 4,
      "text": "把辣椒、花生、烤番茄与剥皮蒜瓣放进搅拌机，加清水打碎。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先慢速再高速，打出来的酱颗粒才均匀。",
      "visual_cue": "酱体呈粗颗粒状，看不到整颗辣椒"
    },
    {
      "n": 5,
      "text": "平底锅小火，把打好的酱倒进去慢慢熬，边熬边搅。",
      "time_min": 8,
      "heat": "小火",
      "tip": "花生酱容易糊底，全程要用木勺贴着锅底刮。",
      "visual_cue": "酱体冒小泡变稠，颜色由红转深褐"
    },
    {
      "n": 6,
      "text": "加盐与白醋调匀，撒入炒香的芝麻拌匀后关火。",
      "time_min": 3,
      "heat": "无火",
      "tip": "醋最后加，久熬酸味会跑掉，风味变闷。",
      "visual_cue": "酱体油亮挂勺，酸香在鼻尖轻轻冲一下"
    },
    {
      "n": 7,
      "text": "放凉后装进干净密封罐，表面淋一层薄油封住。",
      "time_min": 5,
      "heat": "无火",
      "tip": "表面封油能防氧化，颜色保持得更久。",
      "visual_cue": "罐内酱面平整，油层薄薄铺在最上面"
    }
  ],
  "tips": [
    "这酱配烤肉和玉米饼都合适，抹在面包上也香。",
    "花生换成烤过的腰果，口感更细腻。",
    "喜欢细腻口感可以多打两分钟，过一遍筛。",
    "辣度靠干辣椒品种调，去籽越多越温和。"
  ],
  "common_mistakes": [
    "辣椒烘到发黑，整罐酱都带一股焦苦味。",
    "熬酱时火大又不搅，锅底很快就糊上一层。",
    "醋一开始就倒进去，熬完酸味全跑了。"
  ],
  "substitutions": [
    {
      "original": "干辣椒",
      "substitute": "墨西哥辣椒",
      "ratio": "40克:60克",
      "note": "烟熏味更重，辣度偏低。"
    },
    {
      "original": "白醋",
      "substitute": "青柠汁",
      "ratio": "15毫升:20毫升",
      "note": "香气更清新，适合配海鲜。"
    }
  ],
  "variations": [
    "加一勺可可粉，做出接近摩尔酱的深色版本。",
    "再放两片烤过的洋葱进去，甜味会更突出些。"
  ],
  "serving_suggestion": "抹在烤好的肉上，或者直接蘸玉米饼当小食的酱。",
  "storage": "冷藏可放两周，冷冻三个月，每次取用都用干净无水的勺。",
