        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "擦丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶酪 200g 擦成细丝，洋葱 50g 与青椒 60g 分别切成细丝备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "奶酪擦丝才熔得均匀。",
      "visual_cue": "奶酪丝松散、蔬菜切丝均匀"
    },
    {
      "n": 2,
      "text": "平底锅倒 8ml 橄榄油，中火下洋葱丝与青椒丝炒 3 分钟，加 2g 盐炒匀盛出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蔬菜先炒断生，饼才不会出水。",
      "visual_cue": "蔬菜变软、微微上色"
    },
    {
      "n": 3,
      "text": "锅中放一张玉米饼，铺上一半奶酪丝、全部蔬菜丝，再铺剩余奶酪丝。",
      "time_min": 3,
      "heat": "小火",
      "tip": "奶酪上下夹住馅料，才粘得住。",
      "visual_cue": "馅料铺平、边缘留出空隙"
    },
    {
      "n": 4,
      "text": "盖上第二张玉米饼，小火煎 2 分钟至底面定型金黄，用锅铲翻面再煎 2 分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢煎，奶酪才熔透不焦。",
      "visual_cue": "两面金黄、饼身鼓起"
    },
    {
      "n": 5,
      "text": "出锅静置 1 分钟，切成 6 块，撒香菜碎装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "静置一下再切，奶酪不流。",
      "visual_cue": "切面奶酪拉丝、层次分明"
    }
  ],
  "tips": [
    "奶酪擦丝后铺两层，夹馅才不会散。",
    "全程小火慢煎，玉米饼很容易煎焦发黑。",
    "出锅静置 1 分钟再切，切面才整齐。"
  ],
  "common_mistakes": [
    "大火煎饼，外皮焦黑而奶酪还没熔。",
    "奶酪切块不擦丝，熔化不均还流得到处都是。",
    "蔬菜没炒直接铺，饼身出水变软塌。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "马苏里拉",
      "ratio": "200g 对 200g",
      "note": "拉丝效果更好。"
    },
    {
      "original": "玉米饼",
      "substitute": "面粉饼",
      "ratio": "4 张对 4 张",
      "note": "口感更软，需多煎 1 分钟。"
    }
  ],
  "variations": [
    "鸡肉版：加 100g 熟鸡丝同铺。",
    "蘑菇版：加 100g 炒香的蘑菇片。"
  ],
  "serving_suggestion": "切块后配番茄沙沙酱或酸奶油蘸食。",
  "storage": "现做现吃，冷藏后回锅小火复热 2 分钟。",
