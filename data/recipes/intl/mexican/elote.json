  ],
  "equipment": [
    "烤盘",
    "刷子",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米剥去外壳与须，切掉两端尖头，洗净沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "保留一小截柄方便手拿。",
      "visual_cue": "玉米棒表面干净无残须"
    },
    {
      "n": 2,
      "text": "黄油隔热水化开，加 2g 盐拌匀，用刷子刷遍玉米表面。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷过黄油烤出来更香不干。",
      "visual_cue": "玉米表面均匀挂油"
    },
    {
      "n": 3,
      "text": "平底锅或烤盘烧热，中火把玉米翻转煎烤 10 分钟至表面出现焦斑。",
      "time_min": 12,
      "heat": "中火",
      "tip": "不断翻动，让四面都上色。",
      "visual_cue": "玉米粒鼓起、表面带焦黑斑点"
    },
    {
      "n": 4,
      "text": "趁玉米还热，用勺子把蛋黄酱抹满整根玉米的表面。",
      "time_min": 2,
      "heat": "无火",
      "tip": "玉米热的时候抹，酱才挂得住。",
      "visual_cue": "酱层均匀包裹玉米粒"
    },
    {
      "n": 5,
      "text": "撒上 60g 芝士丝与 5g 辣椒粉，挤入青柠汁，最后撒香菜碎。",
      "time_min": 2,
      "heat": "无火",
      "tip": "芝士遇热微融更好吃。",
      "visual_cue": "芝士略融、辣椒粉红亮"
    }
  ],
  "tips": [
    "玉米烤到有焦斑，甜味才被激出来。",
    "蛋黄酱要趁玉米热的时候抹，凉了就挂不住。",
    "青柠汁千万别省，酸味能压住芝士与酱的腻。"
  ],
  "common_mistakes": [
    "玉米煮后直接抹酱，水汽让酱滑落。",
    "芝士撒得太少，吃不出那种拉丝与咸香。",
    "烤的时候不翻动，一面焦黑一面生。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "酸奶油",
      "ratio": "60g 对 60g",
      "note": "酸味更明显，青柠减半。"
    },
    {
      "original": "芝士",
      "substitute": "帕玛森奶酪",
      "ratio": "60g 对 50g",
      "note": "咸味更重，盐可省。"
    }
  ],
  "variations": [
    "杯装版：把玉米粒剥下，装杯拌酱用勺吃。",
    "辣版：辣椒粉换成辣椒油，辣味更持久。"
  ],
  "serving_suggestion": "插一根木签手持食用，配冰镇汽水。",
  "storage": "建议现做现吃，冷藏后玉米粒会变硬。",
