        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "大碗",
    "刨丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜玉米粒沥干水分，用厨房纸吸一遍，香菜洗净切碎备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "玉米粒一定要吸干水，带水下锅只出蒸汽，煎不出焦斑。",
      "visual_cue": "玉米粒干爽松散，香菜切得细碎。"
    },
    {
      "n": 2,
      "text": "平底锅大火烧热放黄油，化开后倒入玉米粒摊平成一层。",
      "time_min": 3,
      "heat": "大火",
      "tip": "玉米粒摊平成一层别堆叠，每粒才都能贴到锅底。",
      "visual_cue": "黄油起泡化开，玉米铺满锅底。"
    },
    {
      "n": 3,
      "text": "煎三分钟不要翻动，等底面出现焦斑再翻炒两分钟，撒盐盛出。",
      "time_min": 6,
      "heat": "大火",
      "tip": "前几分钟别翻动，等出焦斑再炒，那股焦香是灵魂。",
      "visual_cue": "颗粒带焦斑，香味窜起来。"
    },
    {
      "n": 4,
      "text": "小碗里放蛋黄酱和青柠汁，搅匀成顺滑的酸香酱汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁分两次加，边尝边调，酸过头就压掉奶香。",
      "visual_cue": "酱汁顺滑无结块，颜色乳白。"
    },
    {
      "n": 5,
      "text": "把热玉米粒倒进大碗，淋酱汁快速拌匀，让每粒都裹上。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁玉米还烫就拌，酱汁才挂得住，凉了只会沉在杯底。",
      "visual_cue": "颗粒油亮，每粒都裹上酱。"
    },
    {
      "n": 6,
      "text": "分装小杯，撒奶酪碎、辣椒粉和香菜，配青柠角趁热上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪离火后撒，靠余温化开，锅里加热会拉成硬块。",
      "visual_cue": "表层奶酪雪白，辣椒粉鲜红。"
    }
  ],
  "tips": [
    "玉米粒下锅要摊平别堆叠，煎出焦斑才有街头那股香。",
    "蛋黄酱和青柠汁先在小碗里调匀，酸度才均匀。",
    "奶酪最后撒，趁热才化得开，凉了就只成颗粒。"
  ],
  "common_mistakes": [
    "玉米粒堆在锅里焖，出水变成煮玉米，完全没有焦香。",
    "蛋黄酱一次全倒进去拌，整杯糊成一片，吃着发腻。",
    "青柠汁挤太多，酸味压过奶香，只剩一股涩。"
  ],
  "substitutions": [
    {
      "original": "蛋黄酱",
      "substitute": "酸奶油",
      "ratio": "60克:65克",
      "note": "酸度更高，青柠汁减半。"
    },
    {
      "original": "奶酪",
      "substitute": "干酪粉",
      "ratio": "40克:30克",
      "note": "咸味重，盐减一克。"
    }
  ],
  "variations": [
    "加一勺切碎的小辣椒同拌，辣味更冲，配冰啤酒很过瘾。",
    "把玉米粒换成整根玉米棒煎香后切下，颗粒更饱满，口感更像街头摊。"
  ],
  "serving_suggestion": "装进纸杯或小碗，撒奶酪和香菜，配一片青柠角，趁热用小勺挖着吃。",
  "storage": "现做现吃最好，冷藏可放一天，回锅干煎一分半恢复香气，不要微波加热。",
