  "equipment": [
    "大碗",
    "烤盘",
    "刷子",
    "锡纸",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用叉子在肉厚处扎几下，两面抹盐与黑胡椒静置十五分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "扎孔能让腌料进到肉里，也防止烤时皮收缩变形。",
      "visual_cue": "表面均匀挂盐、肉面略出水"
    },
    {
      "n": 2,
      "text": "青柠挤汁约四十毫升，与大蒜、孜然、辣椒粉、姜黄和橄榄油调成腌料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腌料先尝一下，酸辣咸要平衡，太酸可补一点油。",
      "visual_cue": "腌料呈橙红色稠液、香气冲"
    },
    {
      "n": 3,
      "text": "腌料倒进鸡腿抓匀，盖好冷藏腌制二十分钟，中途翻面一次。",
      "time_min": 8,
      "heat": "无火",
      "tip": "二十分钟是下限，时间充裕可腌两小时更入味。",
      "visual_cue": "鸡皮染上橙红色、表面湿润"
    },
    {
      "n": 4,
      "text": "烤盘铺洋葱圈垫底，鸡腿带皮朝上放好，刷一层腌料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱垫底能防粘并接住滴下的肉汁，别铺太厚。",
      "visual_cue": "鸡腿平放不叠、洋葱铺满盘底"
    },
    {
      "n": 5,
      "text": "放入二百一十度烤箱烤二十分钟，中途刷一次腌料。",
      "time_min": 8,
      "heat": "中大火",
      "tip": "中途刷料能补色，皮面也不至于烤得发干。",
      "visual_cue": "鸡皮转深金色、表面冒油泡"
    },
    {
      "n": 6,
      "text": "转上火再烤五分钟让表皮焦脆，取出静置五分钟再切。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "静置让肉汁回吸，切开才不会流一盘水。",
      "visual_cue": "表皮焦脆有斑、肉汁清澈不流血水"
    },
    {
      "n": 7,
      "text": "装盘配青柠角，撒香菜碎，把烤盘里的洋葱与肉汁一起淋上。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盘底的洋葱吸满肉汁，别丢，一起上桌最香。",
      "visual_cue": "表面油亮、香菜翠绿点缀"
    }
  ],
  "tips": [
    "腌料中的青柠汁不要超过一小时，酸太久会让肉质发松。",
    "想让皮更脆可在最后两分钟开热风，注意别烤焦。",
    "配玉米饼与莎莎酱，就是墨西哥街头常见的吃法。"
  ],
  "common_mistakes": [
    "腌料只抹表面没进肉里，切开后里面发白无味。",
    "全程大火烤到皮焦，肉还没熟透。",
    "出炉立刻切开，肉汁全流失，口感发柴。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600g 对 500g",
      "note": "无皮易干，需缩短烤制五分钟并多刷油。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "2个 对 2个",
      "note": "酸味相近但香气更淡，可补少许孜然。"
    }
  ],
  "variations": [
    "腌料加入橙汁与橙皮屑，做成酸甜更重的柑橘风味。",
    "把整只鸡腿换成鸡翅中，烤制时间缩短到十五分钟。"
  ],
  "serving_suggestion": "配玉米饼、莎莎酱与青柠角上桌，作为主菜或卷饼馅料。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤六分钟，不建议微波以免皮软。",
