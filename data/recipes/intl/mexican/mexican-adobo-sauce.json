  "equipment": [
    "搅拌机",
    "平底锅",
    "玻璃罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干辣椒去籽剪段，用温水泡十五分钟至变软。",
      "time_min": 15,
      "heat": "无火",
      "tip": "泡软后打浆才顺滑，别用开水会失香。",
      "visual_cue": "辣椒吸饱水，捏起来柔软。"
    },
    {
      "n": 2,
      "text": "大蒜带皮与洋葱片放平底锅上烤到表面焦黄发软。",
      "time_min": 8,
      "heat": "中火",
      "tip": "烤过的蒜和洋葱带甜味，能压住醋的尖酸。",
      "visual_cue": "洋葱边缘焦黄，蒜皮发黑。"
    },
    {
      "n": 3,
      "text": "泡软的干辣椒、烤蒜洋葱与番茄一起放入搅拌机，加白醋打成糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "醋先少放，尝过再补，酸度按口味调。",
      "visual_cue": "糊体细腻，颜色深红。"
    },
    {
      "n": 4,
      "text": "锅里倒植物油烧热，倒入酱糊小火炒八分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "炒到酱体变稠、颜色发暗，生味才去掉。",
      "visual_cue": "酱体冒泡，油浮上表面。"
    },
    {
      "n": 5,
      "text": "加高汤、牛至、孜然与香叶，小火煮十分钟。",
      "time_min": 13,
      "heat": "小火",
      "tip": "煮到能挂勺就好，太稠可少量加汤。",
      "visual_cue": "酱汁浓稠，香气浓郁。"
    },
    {
      "n": 6,
      "text": "加盐调味，挑出香叶，放凉后装入干净玻璃罐保存。",
      "time_min": 5,
      "heat": "无火",
      "tip": "放凉再装罐，水汽会让酱更快变质。",
      "visual_cue": "酱色暗红，表面一层油。"
    }
  ],
  "tips": [
    "阿多波酱常用来腌肉或配罐装辣椒，味道咸酸带辣。",
    "做好冷藏可存一周，表面淋一层油能延长保存。",
    "醋用白醋或苹果醋都可以，苹果醋更柔和。"
  ],
  "common_mistakes": [
    "醋一次加太多，酱酸得呛口，只能靠加糖补救。",
    "酱不炒直接装罐，几天后就发酸变味。"
  ],
  "substitutions": [
    {
      "original": "白醋",
      "substitute": "米醋",
      "ratio": "80ml 对 80ml",
      "note": "米醋酸度低，可再加 10ml 提酸。"
    }
  ],
  "variations": [
    "用来腌猪排时，把酱加一倍量，肉腌一夜再烤，外皮焦香内里多汁。"
  ],
  "serving_suggestion": "作腌料或蘸酱，配烤肉、玉米饼与烤蔬菜。",
  "storage": "玻璃罐冷藏一周，冷冻可存三个月。",
