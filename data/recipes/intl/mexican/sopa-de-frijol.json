  "equipment": [
    "汤锅",
    "炒锅",
    "料理棒"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑豆用清水浸泡 8 小时至豆皮起皱，倒掉泡豆水冲洗干净。",
      "time_min": 480,
      "heat": "无火",
      "tip": "泡透的豆子煮得快又软。",
      "visual_cue": "豆粒明显膨大、豆皮发皱"
    },
    {
      "n": 2,
      "text": "汤锅加 1200ml 清水与黑豆，大火煮开后转小火煮 35 分钟。",
      "time_min": 40,
      "heat": "小火",
      "tip": "小火慢煮，豆子才完整不破。",
      "visual_cue": "豆子一捏就碎、汤色转深"
    },
    {
      "n": 3,
      "text": "炒锅下 30ml 橄榄油，中火炒洋葱丁 3 分钟至透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透，汤底才有甜味。",
      "visual_cue": "洋葱变软透明、边缘微黄"
    },
    {
      "n": 4,
      "text": "下大蒜末、孜然与甜椒粉炒 1 分钟，再加番茄丁炒至出汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料用油炒过才出香。",
      "visual_cue": "番茄塌软出汁、香气浓"
    },
    {
      "n": 5,
      "text": "把炒好的底料倒入豆汤，加 4g 盐小火煮 8 分钟，用料理棒打至半糊状。",
      "time_min": 9,
      "heat": "小火",
      "tip": "留一半豆粒不打，口感更有层次。",
      "visual_cue": "汤体浓稠、仍有豆粒颗粒"
    },
    {
      "n": 6,
      "text": "盛碗后撒上香菜碎，挤入青柠汁，趁热端上桌食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁最后加，酸香才清亮。",
      "visual_cue": "汤面泛红亮油光、香菜点缀"
    }
  ],
  "tips": [
    "干豆务必泡透，没泡够的豆子久煮不烂。",
    "孜然用油炒过，烟熏香气才出来。",
    "留一部分豆不打碎，口感更立体。"
  ],
  "common_mistakes": [
    "直接用泡豆水煮汤，喝起来一股涩味压不住。",
    "全程大火猛煮，豆皮全破汤变成一锅糊。",
    "一开始就把盐加足，汤煮浓后咸得下不了口。"
  ],
  "substitutions": [
    {
      "original": "黑豆",
      "substitute": "红腰豆",
      "ratio": "250g 对 250g",
      "note": "口感更粉糯，煮制减 5 分钟。"
    },
    {
      "original": "青柠",
      "substitute": "米醋",
      "ratio": "30g 对 15ml",
      "note": "酸味更直白。"
    }
  ],
  "variations": [
    "烟熏版：加 5g 烟熏辣椒粉，风味更浓。",
    "配饭版：浇在白饭上做成豆汤饭。"
  ],
  "serving_suggestion": "配玉米饼与牛油果片，撒一把香菜上桌。",
  "storage": "冷藏 3 天，冷冻 1 个月，复热时加水调稀。",
