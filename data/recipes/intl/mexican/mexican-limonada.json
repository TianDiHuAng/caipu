  "equipment": [
    "榨汁器",
    "水壶",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青柠和柠檬用盐搓洗外皮，冲净后擦干水切成两半。",
      "time_min": 6,
      "heat": "无火",
      "tip": "外皮用盐搓一遍，能把表皮的蜡和涩去掉。",
      "visual_cue": "果皮光洁，切口整齐"
    },
    {
      "n": 2,
      "text": "青柠用力挤出果汁，柠檬切几片薄片留着装饰用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "挤汁时别压到白瓤，压到会带明显苦味。",
      "visual_cue": "果汁清亮，果片完整"
    },
    {
      "n": 3,
      "text": "果汁倒进水壶里加白糖，搅到糖完全化开后再尝味。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖先用少量温水化开，冷饮里才不会沉底。",
      "visual_cue": "糖化无颗粒，酸甜适口"
    },
    {
      "n": 4,
      "text": "倒入清水和薄荷叶拌匀，放柠檬片冷藏半小时后饮用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冷藏半小时风味融合，青柠香更清爽。",
      "visual_cue": "饮品清亮，浮薄荷叶"
    }
  ],
  "tips": [
    "青柠外皮用盐搓洗，去掉表皮蜡质更清香。",
    "挤汁时别压到白瓤，否则整壶都会发苦。",
    "糖先用温水化开，冷饮中才不沉底。"
  ],
  "common_mistakes": [
    "连白瓤一起压汁，整壶苦得喝不下。",
    "白糖直接倒进冷水，沉底化不开。",
    "做好的青柠水常温久放，清香全散。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "200 克:220 克",
      "note": "酸度略低，白糖减十克。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "60 克:70 克",
      "note": "需先用温水化开再调。"
    }
  ],
  "variations": [
    "加气泡水替代部分清水，做成气泡版。",
    "加几片黄瓜同泡，清香更清爽解渴。"
  ],
  "serving_suggestion": "冰镇后倒在装满冰块的杯里，配辣味菜最解腻。",
  "storage": "冷藏一天，饮用前摇匀，勿常温过夜。",
