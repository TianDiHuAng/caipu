    "砧板",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛油果对半切开去核，用勺子挖出果肉放入搅拌机。",
      "time_min": 6,
      "heat": "无火",
      "tip": "选按压有弹性的熟果，硬果打出来发涩。",
      "visual_cue": "果肉呈嫩黄绿色，质地柔软。"
    },
    {
      "n": 2,
      "text": "立刻挤入一颗青柠的汁，防止果肉氧化变褐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁是护色关键，动作要快。",
      "visual_cue": "果肉表面保持鲜绿。"
    },
    {
      "n": 3,
      "text": "加入香菜、小米辣、洋葱碎与大蒜，倒入清水与橄榄油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "液体先少放，打不动再补。",
      "visual_cue": "材料都浸在液面附近。"
    },
    {
      "n": 4,
      "text": "高速打三十秒成顺滑酱汁，中途刮一次杯壁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "想留颗粒感就打十五秒就停。",
      "visual_cue": "酱体顺滑无大块。"
    },
    {
      "n": 5,
      "text": "加盐与剩下那颗青柠的汁调味，尝一下酸咸平衡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸味要明显，太淡会显得油腻。",
      "visual_cue": "酱汁微酸，颜色鲜绿。"
    },
    {
      "n": 6,
      "text": "盛入碗中，表面盖一层保鲜膜贴住酱面，冷藏十分钟后食用。",
      "time_min": 11,
      "heat": "无火",
      "tip": "贴面盖膜能隔绝空气，防止发褐。",
      "visual_cue": "酱面平整，颜色翠绿。"
    }
  ],
  "tips": [
    "这是流动版牛油果酱，比 guacamole 稀，适合淋在塔可上。",
    "牛油果选哈斯品种，油脂香更浓。",
    "打好的酱两小时内吃完，颜色最好看。"
  ],
  "common_mistakes": [
    "牛油果没熟就打成酱，质地粗且带涩味。",
    "不加青柠汁就静置，十分钟表面就发褐。"
  ],
  "substitutions": [
    {
      "original": "牛油果",
      "substitute": "酸奶油",
      "ratio": "400g 对 250g",
      "note": "酸奶油版更酸，青柠减到一颗。"
    }
  ],
  "variations": [
    "加一勺酸奶油打成奶香版，配烤虾塔可特别合适。"
  ],
  "serving_suggestion": "淋在塔可、烤鱼或沙拉上，也可蘸玉米片。",
  "storage": "冷藏一天，表面贴膜保存；变色部分挖掉仍可食用。",
