  "steps": [
    {
      "n": 1,
      "text": "墨西哥辣椒洗净擦干，用刀在表面划两道小口防爆。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划口能让油少溅，也让咸味渗进去。",
      "visual_cue": "辣椒表面有两道浅口"
    },
    {
      "n": 2,
      "text": "青椒对半切开去籽，洋葱切成半厘米厚的圈。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱圈要厚一点，煎完才不散。",
      "visual_cue": "青椒半片整齐，洋葱成圈"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油，中火烧到油面微微发亮再下辣椒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温不够辣椒会吸油，太热又容易糊皮。",
      "visual_cue": "油面微亮，有细纹"
    },
    {
      "n": 4,
      "text": "下墨西哥辣椒与青椒，皮朝下贴锅，煎四分钟不翻动。",
      "time_min": 5,
      "heat": "中火",
      "tip": "别急着翻，让表皮先起虎皮斑。",
      "visual_cue": "辣椒表皮起泡发白"
    },
    {
      "n": 5,
      "text": "翻面继续煎三分钟，加入洋葱圈与大蒜同煎。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱后放才不会焦成炭。",
      "visual_cue": "辣椒两面有焦斑，洋葱变软"
    },
    {
      "n": 6,
      "text": "撒盐与黑胡椒，淋生抽，翻炒一分钟让味道裹匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "生抽沿锅边淋，遇热才出香。",
      "visual_cue": "辣椒油亮，酱香扑鼻"
    },
    {
      "n": 7,
      "text": "关火盛盘，挤上青柠汁，配烤肉与啤酒一起上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃最香，凉了辣椒皮会发韧。",
      "visual_cue": "辣椒堆叠，青柠角点缀"
    }
  ],
  "tips": [
    "辣椒越辣越地道，怕辣就用青椒代替一半。",
    "煎辣椒别盖盖，水汽闷着就出不来虎皮。",
    "剩下的油别倒，炒蛋炒饭都带着辣香。",
    "配一份酸奶油可以压辣，是墨西哥餐馆的常见搭配。"
  ],
  "common_mistakes": [
    "辣椒不划口直接下锅，热油溅得到处都是。",
    "一直翻炒不停，皮破了辣椒肉全散在锅里。",
    "盐放太早，辣椒出水变成炖辣椒。"
  ],
  "substitutions": [
    {
      "original": "墨西哥辣椒",
      "substitute": "青尖椒",
      "ratio": "300克:300克",
      "note": "辣度更高，可减半用量。"
    },
    {
      "original": "橄榄油",
      "substitute": "玉米油",
      "ratio": "45毫升:45毫升",
      "note": "烟点更高，更不易糊。"
    }
  ],
  "variations": [
    "加几只小洋葱一起煎，甜味能中和辣味。",
    "最后撒一把碎奶酪，盖上锅盖焖三十秒融化，是北部的吃法。"
  ],
  "serving_suggestion": "三人份小菜，配烤牛肉、玉米饼和啤酒，当下酒菜最合适。",
  "storage": "冷藏两天内吃完，复热用平底锅干煎两分钟，别用微波炉会发软。",
