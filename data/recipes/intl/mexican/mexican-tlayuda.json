  "equipment": [
    "平底锅",
    "炒锅",
    "勺子",
    "烤架"
  ],
  "steps": [
    {
      "n": 1,
      "text": "熟黑豆连一点汤汁倒进炒锅，中火加热后用勺子压成粗泥。",
      "time_min": 8,
      "heat": "中火",
      "tip": "留一点颗粒，口感比全泥更有层次。",
      "visual_cue": "豆泥浓稠，能看到碎粒"
    },
    {
      "n": 2,
      "text": "豆泥里加盐和孜然，小火翻炒三分钟收干水分，盛出备用。",
      "time_min": 4,
      "heat": "小火",
      "tip": "水分收干，抹在饼上才不会把饼泡软。",
      "visual_cue": "豆泥抱团，锅底干净"
    },
    {
      "n": 3,
      "text": "平底锅刷一层植物油，玉米饼下锅小火烘两分钟到微微发硬。",
      "time_min": 3,
      "heat": "小火",
      "tip": "饼要先烘硬，铺料才不会塌。",
      "visual_cue": "饼面干爽，边缘微翘"
    },
    {
      "n": 4,
      "text": "把饼翻面，均匀抹一层豆泥，边缘留出一指宽的空隙。",
      "time_min": 2,
      "heat": "小火",
      "tip": "抹厚一点更顶饱，但要抹平不然铺料会滑。",
      "visual_cue": "豆泥平整，颜色深褐"
    },
    {
      "n": 5,
      "text": "豆泥上撒一半奶酪丝，铺番茄片和洋葱丝，再撒余下的奶酪。",
      "time_min": 4,
      "heat": "无火",
      "tip": "奶酪分两层，中间的料就被粘住了。",
      "visual_cue": "料层分明，奶酪成堆"
    },
    {
      "n": 6,
      "text": "盖上锅盖小火烘五分钟，让奶酪完全融化、饼底变脆。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盖盖让热气循环，奶酪化得快，饼底不焦。",
      "visual_cue": "奶酪融化，边缘焦脆"
    },
    {
      "n": 7,
      "text": "起锅前撒辣椒面，铺上牛油果片、生菜丝和香菜碎。",
      "time_min": 4,
      "heat": "无火",
      "tip": "生菜和牛油果最后放，热度会把它们焖软。",
      "visual_cue": "色彩鲜亮，饼身完整"
    },
    {
      "n": 8,
      "text": "切成四块，趁热用手拿着吃，饼底脆响奶酪拉丝才算成功。",
      "time_min": 2,
      "heat": "无火",
      "tip": "切开要快，凉了饼变韧就切不动了。",
      "visual_cue": "切口整齐，奶酪拉丝"
    }
  ],
  "tips": [
    "特莱尤达是瓦哈卡州的招牌，饼比一般玉米饼大一倍，烘得又薄又脆。",
    "豆泥一定要收干，这是饼底不塌的关键。",
    "奶酪选能拉丝的，融化后才有那种黏连的口感。"
  ],
  "common_mistakes": [
    "豆泥太稀就抹上饼，烘完饼底软塌塌提不起来。",
    "火太大，饼底焦黑而奶酪还没化。",
    "配料铺得太满，拿起来就散一地。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "莫扎里拉奶酪",
      "ratio": "200克:200克",
      "note": "拉丝效果更好，咸度略低需补一克盐。"
    },
    {
      "original": "黑豆",
      "substitute": "红腰豆",
      "ratio": "300克:300克",
      "note": "红腰豆压泥颜色偏红，味道更甜。"
    }
  ],
  "variations": [
    "加一层撕碎的熟鸡肉，做成加料的版本，更顶饱。",
    "把豆泥换成南瓜泥，做成甜咸口的素食版本。"
  ],
  "serving_suggestion": "切成四块当小吃，配一杯冰啤酒或青柠水，人多时最合适。",
  "storage": "现做现吃，冷藏一天；复热用平底锅小火加盖烘三分钟回脆。",
