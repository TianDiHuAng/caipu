  "equipment": [
    "平底锅",
    "碗",
    "打蛋器",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进碗里加盐和黑胡椒，用打蛋器打至均匀起小泡。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打得起小泡，煎出来的蛋饼才蓬松。",
      "visual_cue": "蛋液均匀，表面一层细泡"
    },
    {
      "n": 2,
      "text": "番茄切一厘米小丁，洋葱和青椒切细丁，香菜切碎。",
      "time_min": 9,
      "heat": "无火",
      "tip": "番茄丁别太小，煎的时候才保留口感。",
      "visual_cue": "各料分装，丁块均匀"
    },
    {
      "n": 3,
      "text": "平底锅倒一半植物油，下洋葱丁中火炒两分钟至软塌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱先炒出甜味，蛋饼的底味才够。",
      "visual_cue": "洋葱透明软塌，香气散出"
    },
    {
      "n": 4,
      "text": "下番茄丁与青椒丁炒三分钟至番茄出水，加牛至和辣椒粉炒匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒到出水变软，蛋饼才不会出水。",
      "visual_cue": "番茄软塌出汁，锅底红色"
    },
    {
      "n": 5,
      "text": "把蔬菜在锅底摊平，倒入打好的蛋液，转小火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蛋液倒下去后别搅，等它自己铺平定型。",
      "visual_cue": "蛋液覆盖蔬菜，边缘开始凝固"
    },
    {
      "n": 6,
      "text": "盖盖小火焖五分钟，让表面蛋液凝固、底部微黄不焦。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盖盖焖受热均匀，底部不容易焦黑。",
      "visual_cue": "表面凝固不出水，边缘微黄"
    },
    {
      "n": 7,
      "text": "撒上奶酪丝与香菜碎，再盖盖焖一分钟至奶酪融化。",
      "time_min": 2,
      "heat": "小火",
      "tip": "奶酪融到拉丝就够了，久焖会出油。",
      "visual_cue": "奶酪融化铺开，香菜翠绿"
    },
    {
      "n": 8,
      "text": "用锅铲轻轻翻折成半月形，滑入盘中，切块分食。",
      "time_min": 3,
      "heat": "小火",
      "tip": "翻折时用两把铲子托住，蛋饼才不破。",
      "visual_cue": "半月形完整，切面层次分明"
    }
  ],
  "tips": [
    "蛋液打出小泡，煎出来才蓬松柔软。",
    "番茄先炒到出水，蛋饼才不会湿塌。",
    "蛋液下锅后别搅动，等它自己铺平。",
    "盖盖小火焖，底部不焦而表面凝固。"
  ],
  "common_mistakes": [
    "蛋液没打匀就下锅，蛋白蛋黄分层。",
    "大火煎，底部焦黑而中间还是流动的。",
    "番茄不炒直接倒蛋液，成品一盘水。",
    "奶酪下太早，焖久了全化成一层油。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "酸奶油",
      "ratio": "50克:60克",
      "note": "不需要融化，出锅后点在上面。"
    },
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "60克:60克",
      "note": "甜味更突出，辣度更低。"
    }
  ],
  "variations": [
    "加两片火腿同焖，咸香更足更饱。",
    "撒一点辣椒酱，做成微辣的家常版。",
    "做成小圆饼，切成三角当开胃小食。"
  ],
  "serving_suggestion": "切块装盘，配一勺牛油果酱和温热玉米饼，早餐或简易午餐都合适。",
  "storage": "冷藏不超过一天，复热用平底锅小火两面各一分钟，微波会出水变韧。",
