  "equipment": [
    "搅拌机",
    "滤网",
    "大壶",
    "刀",
    "砧板",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草莓摘去蒂部，用清水冲洗两遍，挑出压坏的果子。",
      "time_min": 6,
      "heat": "无火",
      "tip": "不要泡洗，泡久了香味会跑到水里。",
      "visual_cue": "草莓干净无泥，蒂部摘净"
    },
    {
      "n": 2,
      "text": "把草莓放进搅拌机，加四百毫升清水打成细泥。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先少加水打，浓度才够。",
      "visual_cue": "果泥细腻，色鲜红"
    },
    {
      "n": 3,
      "text": "果泥倒进铺了滤网的壶中，用汤勺按压滤出果汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "想保留果肉纤维，可以少滤一遍。",
      "visual_cue": "滤网上留下果渣，汁清亮"
    },
    {
      "n": 4,
      "text": "滤好的果汁加剩下的清水，挤入青柠汁搅匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠能提亮颜色，也能防止氧化发暗。",
      "visual_cue": "液体均匀，色粉红透亮"
    },
    {
      "n": 5,
      "text": "加白糖与一撮盐搅到完全化开，尝味调整酸甜。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐只要一点点，能把甜味托起来。",
      "visual_cue": "无颗粒感，入口酸甜"
    },
    {
      "n": 6,
      "text": "放入薄荷，送进冰箱冷藏十分钟，取出加冰饮用。",
      "time_min": 11,
      "heat": "无火",
      "tip": "冰镇过的果水味道更融合。",
      "visual_cue": "杯壁挂水珠，薄荷浮面"
    }
  ],
  "tips": [
    "用冷冻草莓也行，解冻后直接打，冰省一半。",
    "甜度按草莓成熟度调整，熟透的果子少放糖。",
    "换成西瓜、甜瓜同样做法，就是夏季常备的果水。",
    "喝之前先摇一摇，果肉容易沉在壶底。"
  ],
  "common_mistakes": [
    "草莓泡水太久，香气被稀释，喝起来像糖水。",
    "白糖一次性加太多，把草莓的果酸完全盖住。",
    "不加青柠汁，草莓水很快变暗发褐，卖相全失。"
  ],
  "substitutions": [
    {
      "original": "草莓",
      "substitute": "覆盆子",
      "ratio": "500克:400克",
      "note": "酸度高，糖量加十克。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "60克:50克",
      "note": "风味更柔，需用温水先化开。"
    }
  ],
  "variations": [
    "加半杯气泡水，做成带气的草莓果水，更清爽。",
    "加两片新鲜罗勒叶同泡，香气层次更复杂。"
  ],
  "serving_suggestion": "四人份冷饮，配烧烤、玉米饼或辣味菜解辣最合适。",
  "storage": "冷藏一天内喝完，草莓果水易失香；果渣可冷冻做冰沙。",
