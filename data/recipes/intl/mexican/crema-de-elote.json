  "equipment": [
    "汤锅",
    "搅拌机",
    "滤网",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米 500g 剥成粒，留出一小把做装饰，其余备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "留一把整粒，成品口感有层次。",
      "visual_cue": "玉米粒饱满、无玉米须"
    },
    {
      "n": 2,
      "text": "汤锅放 20g 黄油小火融化，下洋葱碎与蒜末炒 4 分钟至透明。",
      "time_min": 5,
      "heat": "小火",
      "tip": "黄油别烧焦，微起泡就下洋葱。",
      "visual_cue": "洋葱透明、香气散出"
    },
    {
      "n": 3,
      "text": "倒入玉米粒翻炒 3 分钟，加 500ml 清水大火煮开，转小火煮 12 分钟。",
      "time_min": 16,
      "heat": "小火",
      "tip": "煮到玉米粒能用勺子压碎。",
      "visual_cue": "玉米粒变软、汤色微黄"
    },
    {
      "n": 4,
      "text": "连汤倒入搅拌机打成细腻糊状，再倒回锅中过筛一次。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛后汤体才顺滑无渣。",
      "visual_cue": "汤糊细腻、能缓慢流动"
    },
    {
      "n": 5,
      "text": "加 300ml 牛奶、4g 盐、5g 白糖与 1g 黑胡椒，小火加热 5 分钟不断搅拌。",
      "time_min": 6,
      "heat": "小火",
      "tip": "边加热边搅，避免糊底。",
      "visual_cue": "汤面微冒热气、质地浓稠"
    },
    {
      "n": 6,
      "text": "盛入碗中后撒上预留的玉米粒与香菜碎，趁热上桌食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "装饰最后放，颜色才鲜亮。",
      "visual_cue": "汤面点缀金黄玉米粒"
    }
  ],
  "tips": [
    "玉米先炒再煮，甜味会更集中更浓郁。",
    "打好的汤糊过筛一次，口感才细腻顺滑。",
    "牛奶下锅后必须小火，煮沸容易结皮。"
  ],
  "common_mistakes": [
    "玉米没煮软就打泥，汤里全是颗粒渣。",
    "牛奶大火煮沸，表面结出厚厚一层奶皮。",
    "加热时忘记搅拌，锅底糊出一圈焦味。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰浆",
      "ratio": "300ml 对 300ml",
      "note": "风味更浓，糖可减 2g。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "20g 对 18ml",
      "note": "奶香变淡，更清爽。"
    }
  ],
  "variations": [
    "辣味版：加 1 个青辣椒同炒。",
    "芝士版：起锅前加 40g 奶酪搅化。"
  ],
  "serving_suggestion": "配烤玉米饼片或面包丁一起食用。",
  "storage": "冷藏 2 天，复热时加少量牛奶调稀。",
