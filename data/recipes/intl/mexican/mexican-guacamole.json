  "steps": [
    {
      "n": 1,
      "text": "牛油果对半切开去核，用勺子挖出果肉放进研钵里。",
      "time_min": 4,
      "heat": "无火",
      "tip": "果肉要整块挖，切碎的果肉接触空气多，很快就会发褐。",
      "visual_cue": "果肉翠绿，核与皮分离"
    },
    {
      "n": 2,
      "text": "先用叉子把果肉压成带颗粒的粗泥，别压成完全顺滑。",
      "time_min": 3,
      "heat": "无火",
      "tip": "留一点颗粒口感才对，压成泥糊吃起来像婴儿食品。",
      "visual_cue": "果泥带小块，质地不均"
    },
    {
      "n": 3,
      "text": "立刻挤入一半青柠汁拌匀，让果汁裹住每块果肉防氧化。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁要马上加，慢一分钟果肉就开始发褐，颜色回不来。",
      "visual_cue": "果泥颜色鲜绿，汁水发亮"
    },
    {
      "n": 4,
      "text": "加洋葱末、青椒末、番茄丁与香菜碎，撒盐与干辣椒碎拌开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "番茄要去籽去汁，带汁拌进去十分钟就出一滩水，酱变稀。",
      "visual_cue": "配料分布均匀，酱体稠厚"
    }
  ],
  "tips": [
    "牛油果酱是墨西哥餐桌上的万能蘸料，配玉米片最经典。",
    "果核留着放进碗里，据说能减缓氧化，也更方便携带。",
    "喜欢更辣可以加半个墨西哥辣椒，切得越细辣味越均匀。"
  ],
  "common_mistakes": [
    "牛油果压得太碎，变成糊状，蘸玉米片根本挂不住。",
    "番茄带籽下锅，酱汁出水稀成汤，颜色也发暗。",
    "提前几小时做好放着，表面整层发褐，卖相全毁。"
  ],
  "substitutions": [
    {
      "original": "牛油果",
      "substitute": "牛油果酱罐头",
      "ratio": "500克:450克",
      "note": "罐头版咸度已调，盐需减半。"
    },
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "40克:40克",
      "note": "柠檬酸度稍低，可略增用量。"
    }
  ],
  "variations": [
    "拌入一勺酸奶油，做成奶油版牛油果酱，口感更滑。",
    "加半个烤过的青椒同压，烟熏味更浓，适合配烤肉。"
  ],
  "serving_suggestion": "盛进陶碗，配一袋玉米片，或抹在卷饼和烤面包上。",
  "storage": "密封冷藏最多一天，表面贴保鲜膜压紧排出空气可减缓变褐。",
