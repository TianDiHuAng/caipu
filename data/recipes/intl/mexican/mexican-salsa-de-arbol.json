  "steps": [
    {
      "n": 1,
      "text": "干辣椒去梗，干锅小火烘两分钟至出香，注意别烘黑。",
      "time_min": 6,
      "heat": "小火",
      "tip": "树辣椒辣度高，烘的时候别凑近闻。",
      "visual_cue": "辣椒变脆，颜色转深红。"
    },
    {
      "n": 2,
      "text": "番茄与大蒜放入开水锅煮八分钟至番茄皮裂开。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煮过的番茄打出来的酱更顺滑。",
      "visual_cue": "番茄皮裂，蒜瓣变软。"
    },
    {
      "n": 3,
      "text": "锅里倒植物油烧热，下洋葱块炒到边缘微焦。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒出焦边，酱里多一层甜香。",
      "visual_cue": "洋葱边缘焦黄发亮。"
    },
    {
      "n": 4,
      "text": "把干辣椒、番茄、大蒜与洋葱放入搅拌机，加清水打成粗糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "喜欢颗粒感就短打几下，别打成泥。",
      "visual_cue": "酱体呈粗颗粒，颜色深红。"
    },
    {
      "n": 5,
      "text": "加白醋与盐调味，再打五秒，让味道完全均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "醋能提亮辣味，别省；酸度按口味加。",
      "visual_cue": "酱体流动，颜色鲜亮。"
    },
    {
      "n": 6,
      "text": "盛出后撒上香菜碎，静置十分钟让辣味变得圆润。",
      "time_min": 11,
      "heat": "无火",
      "tip": "静置后辣味会更圆润，不那么冲。",
      "visual_cue": "表面浮着香菜碎。"
    }
  ],
  "tips": [
    "树辣椒细长如火柴，辣度很高，第一次做建议减半。",
    "这款酱是墨西哥城塔可摊的标准配置，淋在烤肉上。",
    "用石臼捣出来的质地更传统，比搅拌机香。"
  ],
  "common_mistakes": [
    "辣椒烘过头，酱发苦而且辣味变闷。",
    "番茄不煮直接打，酱体带生涩味。"
  ],
  "substitutions": [
    {
      "original": "干辣椒",
      "substitute": "辣椒粉",
      "ratio": "40g 对 15g",
      "note": "用辣椒粉时跳过烘烤步骤，直接下锅炒香。"
    }
  ],
  "variations": [
    "加半个烤过的洋葱与一勺芝麻，酱会带坚果香，是北部地区的吃法。"
  ],
  "serving_suggestion": "淋在烤牛肉塔可上，也可配烤玉米与炸猪皮。",
  "storage": "冷藏一周，表面淋一层油隔绝空气，风味可保持更久。",
