    "搅拌机",
    "汤勺",
    "刀",
    "砧板",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白蘑菇用湿布擦净，去掉根蒂，切成半厘米厚的片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蘑菇别泡水，吸了水炒不出香。",
      "visual_cue": "蘑菇片厚薄一致，色白"
    },
    {
      "n": 2,
      "text": "洋葱切碎，大蒜拍碎切末，香菜摘下叶子留用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱切得越碎，汤越顺滑。",
      "visual_cue": "洋葱碎粒均匀，蒜末细"
    },
    {
      "n": 3,
      "text": "汤锅放黄油，小火化开后下洋葱碎炒五分钟至透明。",
      "time_min": 6,
      "heat": "小火",
      "tip": "黄油别烧焦，微微起泡就下洋葱。",
      "visual_cue": "洋葱透明发亮，香气甜"
    },
    {
      "n": 4,
      "text": "下蒜末与蘑菇片，中火翻炒八分钟至蘑菇出水又收干。",
      "time_min": 9,
      "heat": "中火",
      "tip": "炒到锅底发干，蘑菇的鲜味才浓缩。",
      "visual_cue": "蘑菇片缩小，锅底无汤"
    },
    {
      "n": 5,
      "text": "撒入面粉翻炒两分钟，让每片蘑菇都裹上薄薄一层。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面粉炒一下去生味，汤才不糊嘴。",
      "visual_cue": "蘑菇表面挂白，无干粉"
    },
    {
      "n": 6,
      "text": "倒入高汤边搅边煮，小火煮十分钟至汤汁略稠。",
      "time_min": 11,
      "heat": "小火",
      "tip": "倒汤要慢慢来，一勺一勺搅才不会结块。",
      "visual_cue": "汤汁顺滑微稠，无颗粒"
    },
    {
      "n": 7,
      "text": "连汤带料倒入搅拌机打成细泥，再倒回锅中。",
      "time_min": 4,
      "heat": "无火",
      "tip": "分两次打，别装太满，热汤会顶盖。",
      "visual_cue": "汤体细腻如绸，色浅褐"
    },
    {
      "n": 8,
      "text": "加牛奶小火加热五分钟，不要煮沸，用盐与黑胡椒调味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "牛奶一沸就分层，保持微微冒汽即可。",
      "visual_cue": "汤面微颤，奶香散出"
    },
    {
      "n": 9,
      "text": "盛碗后磨一点肉豆蔻，撒上香菜叶即可趁热上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "肉豆蔻只要一点，多了会盖住蘑菇香。",
      "visual_cue": "汤面光滑，绿色点缀"
    }
  ],
  "tips": [
    "蘑菇混一半香菇一起炒，鲜味会明显更浓。",
    "想更浓稠就减少一百毫升高汤，不用加面粉。",
    "打好的汤可以过筛一次，口感像餐厅出品。",
    "配一片烤面包，就是一份轻晚餐。"
  ],
  "common_mistakes": [
    "蘑菇泡水洗，炒的时候一直出水，汤味变淡。",
    "面粉直接撒进热汤，结成一团团疙瘩。",
    "牛奶大火煮沸，汤面浮起一层絮状物。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "400毫升:200毫升",
      "note": "更浓郁，需另加两百毫升高汤稀释。"
    },
    {
      "original": "白蘑菇",
      "substitute": "香菇",
      "ratio": "500克:400克",
      "note": "香气更重，用量略减。"
    }
  ],
  "variations": [
    "加一小把玉米粒同打，汤里带自然甜味，是墨西哥家庭常做的版本。",
    "烤过的蘑菇代替生蘑菇，烟熏香更足。"
  ],
  "serving_suggestion": "四人份汤品，作为正餐第一道，配烤面包或玉米饼片。",
  "storage": "冷藏两天内吃完，复热小火慢加热并不断搅拌；含牛奶不建议冷冻，会分层。",
