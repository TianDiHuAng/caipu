  "equipment": [
    "炖锅",
    "刀",
    "木勺",
    "叉子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉冷水下锅，加盐煮十五分钟至熟，捞出稍凉后撕成粗丝。",
      "time_min": 20,
      "heat": "中火",
      "tip": "撕丝顺着纹理，吃起来才有纤维感。",
      "visual_cue": "鸡肉全白，撕成均匀细丝"
    },
    {
      "n": 2,
      "text": "番茄切成大块，洋葱顺纹切丝，大蒜横切成薄片备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "番茄不用去皮，炖煮后自然化开。",
      "visual_cue": "配料切好，番茄汁水充足"
    },
    {
      "n": 3,
      "text": "锅里下植物油，炒香洋葱丝与蒜片至洋葱边缘透明。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒到边缘透明，甜度才出来。",
      "visual_cue": "洋葱软塌，边缘金黄"
    },
    {
      "n": 4,
      "text": "加辣椒粉、红椒粉、孜然与牛至小火炒一分钟出香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香料粉下锅必须转小火，糊了整锅发苦。",
      "visual_cue": "锅中红油泛出，辛香扑鼻"
    },
    {
      "n": 5,
      "text": "倒入番茄块与高汤，中火煮十分钟至番茄完全散开。",
      "time_min": 12,
      "heat": "中火",
      "tip": "用木勺压碎番茄，汤汁才浓。",
      "visual_cue": "汤汁橙红浓稠，无整块"
    },
    {
      "n": 6,
      "text": "放入鸡丝，小火炖十五分钟让肉丝吸满酱汁。",
      "time_min": 17,
      "heat": "小火",
      "tip": "炖的时候多翻动，底部的酱最容易焦。",
      "visual_cue": "肉丝橙红，酱汁裹住每根"
    },
    {
      "n": 7,
      "text": "加盐调定味道，撒香菜碎并挤入青柠汁提酸。",
      "time_min": 3,
      "heat": "无火",
      "tip": "青柠汁最后加，酸味才清亮不闷。",
      "visual_cue": "酱汁油亮，香气带酸"
    },
    {
      "n": 8,
      "text": "把玉米饼在干锅上两面各烙十五秒至微软，包入鸡丝上桌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "饼要烙软才不裂，别烙到干脆。",
      "visual_cue": "饼面微软起泡，边缘卷曲"
    }
  ],
  "tips": [
    "撕鸡丝比切丁更挂酱，是 tinga 的关键。",
    "用罐装番茄更省事，风味也更稳定。",
    "剩下的酱汁拿来煎蛋或拌饭都好吃。"
  ],
  "common_mistakes": [
    "鸡肉煮过头再撕，肉丝干柴像棉絮。",
    "香料粉大火炒糊，整锅带焦苦味。",
    "青柠汁下得太早，久煮后酸味变钝。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "800 克:800 克",
      "note": "更嫩多汁，煮制时间延长五分钟。"
    },
    {
      "original": "玉米饼",
      "substitute": "皮塔饼",
      "ratio": "8 张:4 张",
      "note": "切半口袋式包馅，更结实。"
    }
  ],
  "variations": [
    "加一根切片的墨西哥辣椒，辣度更直白。",
    "把鸡丝铺在烤面包上，加奶酪烤成三明治。"
  ],
  "serving_suggestion": "包玉米饼吃，配洋葱丝、香菜、青柠角和一小碟辣酱。",
  "storage": "冷藏三天、冷冻一个月；复热加两大勺高汤小火搅匀，避免干锅。",
