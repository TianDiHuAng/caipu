          "amount": 60,
          "unit": "g",
          "note": "增稠",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 30,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
