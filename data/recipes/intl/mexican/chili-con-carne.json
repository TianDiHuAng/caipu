      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木铲",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩切成 2 厘米见方的块，用厨房纸吸干表面血水，撒 2g 盐抓匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "块别切太小，久炖会缩成碎渣。",
      "visual_cue": "肉块大小一致、表面干爽"
    },
    {
      "n": 2,
      "text": "厚底锅倒 30ml 橄榄油烧热，牛腩块分批下锅煎至四面焦褐，盛出备用。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "分批煎，锅里挤满就变成煮肉了。",
      "visual_cue": "肉块表面焦褐、锅底留褐色结块"
    },
    {
      "n": 3,
      "text": "原锅下洋葱丁与青椒丁炒到边缘透明，再放蒜末、5g 孜然与 8g 红椒粉炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香料最后放，早放容易炒糊发苦。",
      "visual_cue": "洋葱透明、香味扑鼻"
    },
    {
      "n": 4,
      "text": "倒入番茄块与 60g 番茄酱，压碎炒匀后放回牛腩，加水至刚没过食材。",
      "time_min": 6,
      "heat": "中火",
      "tip": "水刚没过就好，太多收不浓。",
      "visual_cue": "汤汁红亮、牛腩半浸在汤中"
    },
    {
      "n": 5,
      "text": "盖盖转小火炖 50 分钟，中途翻动两次，至牛腩用筷子能轻松插入。",
      "time_min": 50,
      "heat": "小火",
      "tip": "小火慢炖，中途别频繁开盖。",
      "visual_cue": "筷子能轻松插入肉块"
    },
    {
      "n": 6,
      "text": "开盖大火收汁 5 分钟，加剩余 4g 盐调味，撒芫荽碎出锅。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "收到汤汁挂在勺背即可停火。",
      "visual_cue": "汤汁浓稠挂勺、肉块油亮"
    }
  ],
  "tips": [
    "牛腩先煎出焦香，肉味会厚一层。",
    "用番茄块加番茄酱双管齐下，颜色和浓度都更稳。",
    "隔夜再吃味道更融合，第二天更香。"
  ],
  "common_mistakes": [
    "香料跟洋葱一起下锅，炒久了发苦。",
    "水一次加得太多又没收汁，汤汁寡淡没有肉味。",
    "一直大火炖煮，牛腩纤维收紧嚼不动。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "猪肩肉",
      "ratio": "600g 对 600g",
      "note": "炖制时间缩短到 35 分钟。"
    },
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "100g 对 100g",
      "note": "辣度更低，适合小孩。"
    }
  ],
  "variations": [
    "德式版：加入 200g 熟红豆增稠。",
    "烟熏版：加 3g 烟熏红椒粉。",
    "配食版：配玉米饼或白饭一起吃。"
  ],
  "serving_suggestion": "盛入深盘，配温热玉米饼、酸奶油与芫荽叶。",
  "storage": "冷藏可存 3 天，冷冻 1 个月，复热时加少量水。",
