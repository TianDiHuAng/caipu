  "equipment": [
    "汤锅",
    "漏勺",
    "料理机",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米饼切成细条，摊在案板上晾十分钟，让表面稍微干脆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "晾干的饼条炸后更脆。",
      "visual_cue": "饼条挺括、不易折断"
    },
    {
      "n": 2,
      "text": "番茄与洋葱切块，大蒜拍破，干辣椒去籽剪段备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "辣椒籽全部去掉，汤才不苦。",
      "visual_cue": "块形均匀、辣椒去净籽"
    },
    {
      "n": 3,
      "text": "锅中倒植物油烧至六成热，下饼条中小火炸到金黄酥脆，捞出沥油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "分批炸，饼条之间不粘连。",
      "visual_cue": "饼条金黄、捞出沙沙作响"
    },
    {
      "n": 4,
      "text": "留少许底油炒番茄、洋葱、大蒜与干辣椒，加黑胡椒炒到番茄塌软出汁。",
      "time_min": 8,
      "heat": "中火",
      "tip": "炒出红汤底，风味才厚。",
      "visual_cue": "番茄塌软、锅底泛红"
    },
    {
      "n": 5,
      "text": "倒入高汤，加孜然与盐煮开，放入整块鸡胸肉小火煮十二分钟。",
      "time_min": 13,
      "heat": "小火",
      "tip": "整块煮再撕，肉丝才嫩。",
      "visual_cue": "鸡胸熟透、汤面微沸"
    },
    {
      "n": 6,
      "text": "鸡胸撕成细丝放回汤里，盛碗后铺饼条、牛油果丁、酸奶油与香菜，挤青柠汁。",
      "time_min": 5,
      "heat": "小火",
      "tip": "饼条最后放，才保持着脆度。",
      "visual_cue": "配料层次分明、汤色红亮"
    }
  ],
  "tips": [
    "饼条要现炸现放，泡久了会糊成一团。",
    "番茄与洋葱先炒出红汤底，味道才有厚度。",
    "鸡胸整块煮熟再撕，比切丁更嫩更入味。"
  ],
  "common_mistakes": [
    "饼条提前泡进汤里，端上桌就散成糊。",
    "干辣椒连籽下锅，整锅汤发苦发涩。",
    "鸡胸切成小丁久煮，肉质干柴如棉。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "250g 对 250g",
      "note": "更油润，煮制时间加 3 分钟。"
    },
    {
      "original": "酸奶油",
      "substitute": "原味酸奶",
      "ratio": "60g 对 60g",
      "note": "酸度接近，质地更稀。"
    }
  ],
  "variations": [
    "红汤版：番茄先与干辣椒在锅里炒到起泡再打碎。",
    "素食版：去掉鸡胸，用 150g 熟鹰嘴豆代替。"
  ],
  "serving_suggestion": "盛进深碗，饼条与牛油果分开摆在表面，配青柠角挤汁。",
  "storage": "汤底冷藏可存 2 天，饼条须现炸，不可同存。",
