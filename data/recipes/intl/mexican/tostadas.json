    "炒锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "深锅倒 200ml 植物油烧至 180 度，逐张下玉米饼炸 40 秒至鼓起变脆，捞出沥油。",
      "time_min": 12,
      "heat": "中火",
      "tip": "一次只炸一张，温度才不掉。",
      "visual_cue": "饼身金黄鼓起、敲之清脆"
    },
    {
      "n": 2,
      "text": "炒锅留 10ml 底油，中火下洋葱丁与蒜末炒 3 分钟至洋葱透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才出来。",
      "visual_cue": "洋葱透明、蒜香散出"
    },
    {
      "n": 3,
      "text": "放入 250g 牛肉牛肉，中火炒散 6 分钟至完全变色，加 4g 盐与 5g 辣椒粉炒匀。",
      "time_min": 7,
      "heat": "中火",
      "tip": "炒到水汽收干，馅料才不湿。",
      "visual_cue": "牛肉松散干香、颜色转深"
    },
    {
      "n": 4,
      "text": "关火拌入番茄丁与香菜碎，挤入半个青柠的汁拌匀成馅。",
      "time_min": 3,
      "heat": "无火",
      "tip": "番茄后拌，口感才清爽。",
      "visual_cue": "馅料湿润有光、酸香扑鼻"
    },
    {
      "n": 5,
      "text": "在每张脆饼上铺一层生菜丝，再舀两勺牛肉，最后淋酱汁即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "现吃现铺，饼才不返潮。",
      "visual_cue": "饼脆料足、层次分明"
    }
  ],
  "tips": [
    "玉米饼必须炸到鼓起变脆，口感才对。",
    "一次只炸一张，油温稳定才不会软塌。",
    "馅料现拌现铺，脆饼放久会吸湿变韧。"
  ],
  "common_mistakes": [
    "油温不够就下饼，玉米饼吸油变油腻。",
    "牛肉没炒干就拌料，饼底很快被泡软。",
    "提前半小时铺好，客人来吃时脆饼已经软了。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡肉",
      "ratio": "250g 对 250g",
      "note": "口感更清爽，炒制时间减 1 分钟。"
    },
    {
      "original": "玉米饼",
      "substitute": "面粉饼",
      "ratio": "6 张对 6 张",
      "note": "炸后更酥，吸油略多。"
    }
  ],
  "variations": [
    "海鲜版：牛肉换 250g 虾仁丁。",
    "素食版：牛肉换 300g 熟豆泥。"
  ],
  "serving_suggestion": "摆盘后配青柠角和辣椒酱，上手直接吃。",
  "storage": "脆饼密封常温 1 天，馅料冷藏 1 天。",
