          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 100,
          "unit": "g",
          "note": "切细丁",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "煎豆腐用",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 10,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 2,
          "unit": "g",
          "note": "选墨西哥风味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "分次放",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 15,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "木铲",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成边长一厘米的小丁，摊在厨房纸上吸掉表面水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "丁切小一点更易入味，但别小于八毫米，否则一炒就碎。",
      "visual_cue": "豆腐丁大小均匀，表面不再渗水。"
    },
    {
      "n": 2,
      "text": "番茄和洋葱都切成同样大小的细丁，蒜切末，香菜切碎分开放。",
      "time_min": 3,
      "heat": "无火",
      "tip": "三样配料切得一样大，炒出来受热一致，卖相也整齐。",
      "visual_cue": "配料分成三堆，切丁大小接近。"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油，中火把豆腐丁煎到各面微黄，盛出备用。",
      "time_min": 4,
      "heat": "中火",
      "tip": "一次别铺太厚，留出空隙才能煎出焦边而不是焖出水。",
      "visual_cue": "豆腐丁表面结出浅黄薄壳。"
    },
    {
      "n": 4,
      "text": "原锅下洋葱丁炒两分钟到透明，加蒜末和辣椒粉炒出香气。",
      "time_min": 3,
      "heat": "中火",
      "tip": "辣椒粉下锅只炒二十秒，出香就立刻下番茄，久炒必苦。",
      "visual_cue": "洋葱透明，锅里飘出辣椒的干香。"
    },
    {
      "n": 5,
      "text": "倒入番茄丁炒三分钟到出汁，放回豆腐丁，加盐翻匀收汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "轻推锅底翻动，别用铲子猛抄，豆腐丁才完整。",
      "visual_cue": "番茄出红色汁水，包裹住豆腐丁。"
    },
    {
      "n": 6,
      "text": "关火后撒入香菜碎，翻匀装盘，趁热配着薄饼一起上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜离火再拌，余温足够激出香气又不发黑。",
      "visual_cue": "红白绿三色分明，盘底有少量浓汁。"
    }
  ],
  "tips": [
    "a la mexicana 指番茄、洋葱、辣椒三样配色，三样都要切得一样小。",
    "豆腐丁先煎到边缘微焦再炒，形状才不会碎成渣。",
    "香菜最后关火再放，热锅一烫就够，久炒发黑发苦。"
  ],
  "common_mistakes": [
    "豆腐丁直接下锅和番茄同炒，翻两下就碎成一锅豆腐泥。",
    "番茄下锅炒太久，汁水全收干，菜变得干硬没有酱汁感。",
    "辣椒粉在热油里久炸，苦味出来，整盘菜只有糊辣味。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "豆干",
      "ratio": "400克:320克",
      "note": "更紧实，煎的时间可以缩短。"
    },
    {
      "original": "辣椒粉",
      "substitute": "鲜青椒碎",
      "ratio": "2克:40克",
      "note": "辣度更鲜爽，香气更冲。"
    }
  ],
  "variations": [
    "出锅前加一勺酸奶油拌开，口感更绵滑，也能压一压辣味。",
    "把豆腐换成打散的蛋液炒成块，做法和火候完全一样。"
  ],
  "serving_suggestion": "盛盘后撒香菜碎，配温热玉米饼卷着吃，也可以盖在米饭上做成碗装。",
  "storage": "冷藏可放一天，回锅用小火加一勺水翻热，微波加热容易让豆腐丁变硬。",
