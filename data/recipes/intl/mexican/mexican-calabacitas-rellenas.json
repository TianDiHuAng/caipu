  "equipment": [
    "烤箱",
    "刀",
    "砧板",
    "炒锅",
    "烤盘",
    "勺子",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西葫芦洗净对半纵切，用勺子挖出中间的瓤，留一厘米厚的壳。",
      "time_min": 12,
      "heat": "无火",
      "tip": "壳留一厘米厚，烤完才不塌不破。",
      "visual_cue": "两半船形完整，内壁平整"
    },
    {
      "n": 2,
      "text": "挖出的瓤切碎，和番茄丁、洋葱丁一起放碗里备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "瓤别丢，切碎炒进馅里水分刚好。",
      "visual_cue": "瓤碎湿润，配料备齐"
    },
    {
      "n": 3,
      "text": "炒锅倒橄榄油，下洋葱丁中火炒三分钟至软塌透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透出甜，馅料的味道才立得住。",
      "visual_cue": "洋葱透明软塌，锅底泛油"
    },
    {
      "n": 4,
      "text": "下西葫芦瓤与番茄丁炒五分钟，炒到水分收干、锅底无汤。",
      "time_min": 6,
      "heat": "中火",
      "tip": "一定要炒干水，否则烤完馅会流一烤盘。",
      "visual_cue": "锅底无积水，馅料松散"
    },
    {
      "n": 5,
      "text": "加玉米粒、盐、黑胡椒、牛至和孜然炒匀，关火拌入一半奶酪丝。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "奶酪趁热拌才融得开，馅也更黏合。",
      "visual_cue": "奶酪拉丝，馅料黏成团"
    },
    {
      "n": 6,
      "text": "把馅料填进西葫芦壳里，用勺子压实抹平表面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压实一点，切开时才不会散开。",
      "visual_cue": "馅料饱满，表面平整"
    },
    {
      "n": 7,
      "text": "烤盘刷油摆入西葫芦，表面撒剩下的奶酪丝，盖锡纸。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盖锡纸先焖熟，奶酪最后才不会烤焦。",
      "visual_cue": "西葫芦排整齐，奶酪铺满"
    },
    {
      "n": 8,
      "text": "烤箱预热两百度，中层烤二十五分钟，揭锡纸再烤八分钟上色。",
      "time_min": 35,
      "heat": "无火",
      "tip": "揭纸后再烤，表面才有金黄焦斑。",
      "visual_cue": "奶酪金黄起泡，边缘微焦"
    },
    {
      "n": 9,
      "text": "出炉晾五分钟，撒香菜碎，连烤盘汁一起盛盘。",
      "time_min": 6,
      "heat": "无火",
      "tip": "晾五分钟馅料定型，切的时候不流汁。",
      "visual_cue": "切面馅料紧实，奶酪拉丝"
    }
  ],
  "tips": [
    "西葫芦壳留一厘米厚，烤完才不塌破。",
    "馅料一定要炒干水，否则烤完流一盘汤。",
    "奶酪趁热拌一半进馅，馅才黏得紧。",
    "盖锡纸先焖后上色，奶酪不焦馅也熟。"
  ],
  "common_mistakes": [
    "西葫芦挖得太薄，烤完软塌变形。",
    "馅料带水就填，烤完变成一汪汤。",
    "不盖锡纸直接烤，奶酪焦了里面还生。",
    "刚出炉就切，馅料全散在盘子里。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "彩椒",
      "ratio": "600克:600克",
      "note": "做成酿彩椒，烤的时间加五分钟。"
    },
    {
      "original": "玉米粒",
      "substitute": "青豆",
      "ratio": "150克:150克",
      "note": "口感更粉，甜味更淡。"
    }
  ],
  "variations": [
    "馅里加一点绞碎的牛肉，做成荤版更正餐。",
    "表面撒一点辣椒粉，辣味更明显直冲。",
    "淋一勺酸奶油，酸味能解奶酪的厚重。"
  ],
  "serving_suggestion": "每人两只盛盘，配一份番茄沙拉和玉米饼，当主菜或配菜都合适。",
  "storage": "冷藏可放三天，复烤一百八十度十分钟，微波会让西葫芦出水变软。",
