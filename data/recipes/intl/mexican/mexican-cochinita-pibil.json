  "equipment": [
    "厚底烤盘",
    "锡纸",
    "研钵",
    "厨房夹"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肩肉切成五厘米大块，用厨房纸吸干表面，肥油部分保留不要修掉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "肥油在慢烤中会化开渗进瘦肉，是这道菜软润的关键。",
      "visual_cue": "肉块表面干燥、每块带一层白肥"
    },
    {
      "n": 2,
      "text": "孜然与盐在研钵里磨碎，加入牛至和黑胡椒拌成香料盐。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香料现磨比直接撒香得多，颗粒也别磨得太细。",
      "visual_cue": "香料粉碎均匀、闻到明显孜然香"
    },
    {
      "n": 3,
      "text": "柠檬挤汁，与蒜、一半洋葱、香料盐和植物油调成腌料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酸味要足，柠檬汁要没过肉块表面的缝隙才够入味。",
      "visual_cue": "腌料呈浑浊浅黄、尝起来酸咸明显"
    },
    {
      "n": 4,
      "text": "肉块与腌料抓匀按摩两分钟，盖膜冷藏腌四小时以上。",
      "time_min": 8,
      "heat": "无火",
      "tip": "时间紧可腌一小时，但风味只到表层。",
      "visual_cue": "肉块均匀裹上腌料、颜色转浅"
    },
    {
      "n": 5,
      "text": "烤盘底铺剩余洋葱与香叶，放上肉块与腌料，加清水后盖锡纸封严。",
      "time_min": 8,
      "heat": "无火",
      "tip": "锡纸要封到不透气，蒸汽循环才能把肉焖到酥软。",
      "visual_cue": "锡纸四边压实、盘内汤汁没过底部"
    },
    {
      "n": 6,
      "text": "烤箱一百六十度烤两小时，中途不开盖，取出后静置十分钟。",
      "time_min": 120,
      "heat": "中火",
      "tip": "静置让肉纤维回吸汤汁，撕的时候不流一滩水。",
      "visual_cue": "叉子一压就散、盘底有大量红亮油脂"
    },
    {
      "n": 7,
      "text": "把肉撕成粗丝拌回盘底汤汁，玉米饼刷油干锅烘热后包肉食用。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "撕得粗一点更有嚼头，配洋葱丝和柠檬角解腻。",
      "visual_cue": "肉丝吸饱汤汁发亮、饼微软起泡"
    }
  ],
  "tips": [
    "没有香蕉叶可用锡纸代替，风味会少一层草木香。",
    "腌料里的柠檬可换成等量橙汁加一勺白醋，更接近原版酸度。",
    "剩下的肉连汁冷藏，第二天做塔可饼更入味。"
  ],
  "common_mistakes": [
    "肉块切得太小，烤完缩成肉末失去口感。",
    "锡纸没封严，两小时下来肉烤成干柴，只能撕碎重做一锅。",
    "烤完立刻开盖撕肉，肉汁全流在盘里变寡淡。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "3 个 对 4 个",
      "note": "酸度更高，更接近墨西哥本地的酸橙。"
    },
    {
      "original": "猪肩肉",
      "substitute": "五花肉",
      "ratio": "1000g 对 900g",
      "note": "油脂更多，可减少五十毫升清水。"
    }
  ],
  "variations": [
    "把撕好的肉与腌洋葱、香菜夹进烤过的玉米饼，做成街头塔可。",
    "加入一小块黄油同烤，肉香更浓且表面更亮。"
  ],
  "serving_suggestion": "配柠檬角、腌洋葱丝与辣酱，用玉米饼卷着吃，也可配米饭。",
  "storage": "连汁冷藏三天，冷冻一个月；复热加少量清水小火焖透。",
