  "steps": [
    {
      "n": 1,
      "text": "南瓜去皮去瓤切成三厘米块，洋葱切丝，大蒜拍裂。",
      "time_min": 10,
      "heat": "无火",
      "tip": "南瓜块切小一点，煮得快也省火。",
      "visual_cue": "南瓜块大小均匀。"
    },
    {
      "n": 2,
      "text": "锅里化开黄油，下洋葱丝与大蒜炒到洋葱透明发甜。",
      "time_min": 8,
      "heat": "中火",
      "tip": "黄油别烧到冒烟，焦了会苦。",
      "visual_cue": "洋葱透明，锅里有奶香。"
    },
    {
      "n": 3,
      "text": "放入南瓜块翻炒三分钟，加高汤没过南瓜，煮开后转小火。",
      "time_min": 10,
      "heat": "小火",
      "tip": "高汤别太多，否则汤会稀。",
      "visual_cue": "南瓜块半浸在汤里。"
    },
    {
      "n": 4,
      "text": "盖锅小火煮二十分钟至南瓜用勺子一压就烂。",
      "time_min": 20,
      "heat": "小火",
      "tip": "南瓜煮到能轻松压碎，打出来才顺滑。",
      "visual_cue": "勺背轻压南瓜，一压即散开。"
    },
    {
      "n": 5,
      "text": "用搅拌棒把汤打成细腻糊状，倒回锅里加牛奶与肉桂粉。",
      "time_min": 8,
      "heat": "小火",
      "tip": "打浆后再加热，边加热边搅防糊底。",
      "visual_cue": "汤体细腻无颗粒。"
    },
    {
      "n": 6,
      "text": "加盐与黑胡椒调味，淋一圈淡奶油，刨上奶酪碎后上桌。",
      "time_min": 6,
      "heat": "小火",
      "tip": "淡奶油最后淋，保持纹路好看。",
      "visual_cue": "汤面一圈奶白纹路，奶酪碎点缀其上。"
    }
  ],
  "tips": [
    "贝贝南瓜或奶油南瓜都适合，甜度高、水分少。",
    "牛奶别一次全倒，看浓稠度调整。",
    "奶酪刨成细丝再撒，遇热微微融化，口感更好。"
  ],
  "common_mistakes": [
    "南瓜没煮透就打浆，汤里带硬颗粒。",
    "打浆后开大火煮，锅底糊掉带焦味，整锅汤都毁了。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "300ml 对 280ml",
      "note": "椰奶版更浓，带热带香气。"
    }
  ],
  "variations": [
    "瓦哈卡版本会加一小块黑巧克力同煮，苦甜交织，颜色深褐，很有当地特色。"
  ],
  "serving_suggestion": "配烤面包片或玉米饼，淋一圈酸奶油更漂亮。",
  "storage": "冷藏两天，复热时加少量高汤稀释，小火加热。",
