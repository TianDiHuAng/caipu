  "equipment": [
    "烤箱",
    "小锅",
    "打蛋器",
    "模具",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油放小锅小火加热，煮到呈榛子色后离火。，看准状态再往下做。",
      "time_min": 8,
      "heat": "小火",
      "tip": "煮到微微冒烟、闻到坚果香就停。，看准状态再往下做。",
      "visual_cue": "颜色变褐，香气浓，别跳过这步。"
    },
    {
      "n": 2,
      "text": "焦化黄油过筛滤去沉淀，放温备用。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "滤掉奶渣，蛋糕口感才细。，看准状态再往下做。",
      "visual_cue": "液体清亮，无渣，这步最关键。"
    },
    {
      "n": 3,
      "text": "鸡蛋加白糖和蜂蜜，用打蛋器搅到糖化开。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "不用打发，搅匀就行。，看准状态再往下做。",
      "visual_cue": "糖粒消失，蛋液顺滑"
    },
    {
      "n": 4,
      "text": "筛入面粉、杏仁粉和盐，翻拌到无干粉。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "翻拌别画圈，避免起筋。，看准状态再往下做。",
      "visual_cue": "面糊细腻，无颗粒，很多人在这里出错。"
    },
    {
      "n": 5,
      "text": "倒入温热的焦化黄油，拌匀成流动面糊。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油太烫会把蛋烫熟，别急。，看准状态再往下做。",
      "visual_cue": "面糊油亮，流动顺滑"
    },
    {
      "n": 6,
      "text": "面糊盖保鲜膜冷藏半小时，让味道融合。，看准状态再往下做。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冷藏后烤出来更湿润。，看准状态再往下做。",
      "visual_cue": "面糊变稠，表面平静"
    },
    {
      "n": 7,
      "text": "模具抹黄油撒粉，面糊倒到八分满。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "八分满，烤时才好膨胀。，看准状态再往下做。",
      "visual_cue": "模具均匀，面糊平整"
    },
    {
      "n": 8,
      "text": "烤箱一百八十度烤十二分钟到边缘金黄。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "边缘金黄中间略软就出炉。，看准状态再往下做。",
      "visual_cue": "边缘焦黄，中心微凸"
    },
    {
      "n": 9,
      "text": "脱模放凉，密封回油一晚口感最佳。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "放一晚回油，蛋糕才湿润。，看准状态再往下做。",
      "visual_cue": "表面干爽，按压有弹"
    }
  ],
  "tips": [
    "黄油要煮到榛子色，香气才够。，这里最容易翻车。",
    "面糊冷藏半小时，烤后更润。，别小看这一步。",
    "别过度搅拌，蛋糕才不韧。，成败就在这一步。"
  ],
  "common_mistakes": [
    "黄油煮过头，一股焦苦味。，这点要注意。",
    "面糊画圈搅拌，蛋糕发硬。，这是关键点。",
    "烤到大干，失去湿润口感。，别嫌麻烦，做完它。"
  ],
  "substitutions": [
    {
      "original": "杏仁粉",
      "substitute": "榛子粉",
      "ratio": "100 克:100 克",
      "note": "香气更浓，口感略粗。"
    },
    {
      "original": "蜂蜜",
      "substitute": "麦芽糖",
      "ratio": "15 克:15 克",
      "note": "更黏，保湿性更好。"
    }
  ],
  "variations": [
    "加几颗覆盆子，酸甜更平衡。，这一步别省。",
    "表面撒杏仁片，增加脆感。，别跳过这步。"
  ],
  "serving_suggestion": "配一杯红茶或咖啡。，这步最关键。",
  "storage": "密封常温三天，冷冻一个月。，很多人在这里出错。",
