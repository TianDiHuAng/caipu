  "equipment": [
    "汤锅",
    "平底锅",
    "漏勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青豆掐掉两端的硬蒂，顺手撕掉侧面的粗筋。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "两端的筋不摘掉，吃的时候满口渣。，注意火候。",
      "visual_cue": "豆荚翠绿，筋已撕净，状态稳定"
    },
    {
      "n": 2,
      "text": "汤锅烧开水加一小撮盐，青豆下锅焯两分钟捞出。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯水定色，捞起后颜色会更亮更绿。，注意火候。",
      "visual_cue": "豆荚深绿，质地微软，状态稳定"
    },
    {
      "n": 3,
      "text": "捞出后立刻放进冰水里浸凉，保持脆感和翠色。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冰水一激，青豆才不会继续受热变黄。",
      "visual_cue": "青豆冰透，颜色鲜绿，状态稳定"
    },
    {
      "n": 4,
      "text": "平底锅放黄油小火化开，下蒜片煎到微微散发香气。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油别烧褐，微黄带奶香的阶段最好。",
      "visual_cue": "黄油起泡，蒜香散出，状态稳定"
    },
    {
      "n": 5,
      "text": "倒入沥干的青豆翻炒一分钟，加盐和黑胡椒调味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "青豆要沥干再下锅，带水会把黄油冲散。",
      "visual_cue": "豆荚油亮，裹上黄油，状态稳定"
    },
    {
      "n": 6,
      "text": "淋入清水，盖盖小火焖三分钟让豆荚彻底热透入味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "焖一下青豆的豆腥味就走了，口感更甜。",
      "visual_cue": "锅中微沸，豆荚软嫩，状态稳定"
    },
    {
      "n": 7,
      "text": "开盖收掉多余水分，翻匀后立即装盘上桌。这一步不要着急。",
      "time_min": 2,
      "heat": "中火",
      "tip": "水分收干就停，久炒颜色会暗下去。，注意火候。",
      "visual_cue": "盘底干爽，豆荚翠绿，状态稳定"
    }
  ],
  "tips": [
    "青豆焯水后过冰水，颜色才保持翠绿。，值得留意。",
    "黄油小火化开，别烧到发褐发苦。，值得留意。",
    "最后焖三分钟，豆腥味才彻底去掉。，值得留意。"
  ],
  "common_mistakes": [
    "青豆不摘筋直接炒，吃起来满口粗渣。，务必避免。",
    "焯水超过五分钟，豆荚软烂发黄。，务必避免。",
    "黄油烧到发褐再下豆，整盘带焦苦味。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "青豆",
      "substitute": "四季豆",
      "ratio": "550 克:550 克",
      "note": "焯水时间加一分钟，口感更扎实。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "40 克:35 毫升",
      "note": "素版更清爽，奶香减淡。"
    }
  ],
  "variations": [
    "出锅撒一把杏仁片，口感更丰富。，也很受欢迎。",
    "加少许柠檬皮屑，香气更清新。，也很受欢迎。"
  ],
  "serving_suggestion": "作为烤肉或煎鱼旁的配菜，黄油的奶香能解油腻。",
  "storage": "冷藏两天，复热用平底锅小火加黄油翻热。，效果更稳定。",
