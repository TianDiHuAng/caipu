    "搅拌棒",
    "木勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜去皮去瓤切成三厘米见方的块，洋葱切成细丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "南瓜瓤一定要刮净，留着煮出来的汤带一股生瓜味。",
      "visual_cue": "南瓜块橙黄，洋葱丝散开"
    },
    {
      "n": 2,
      "text": "汤锅化黄油，下洋葱丝小火炒到透明发甜，别炒上色。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒到发黄就会抢南瓜的甜，只要软透出香就够。",
      "visual_cue": "洋葱透明，锅里冒甜香"
    },
    {
      "n": 3,
      "text": "倒入南瓜块翻炒三分钟，让每块都裹上一层黄油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "南瓜先炒过再加水，甜味才被油脂带出来，汤更香。",
      "visual_cue": "南瓜块油亮，边缘略软"
    },
    {
      "n": 4,
      "text": "加高汤煮开后转小火炖二十分钟，直到南瓜一压就散。",
      "time_min": 22,
      "heat": "小火",
      "tip": "汤要刚没过南瓜，水太多汤稀得像洗锅水，甜味也淡。",
      "visual_cue": "南瓜软烂，锅铲一压成泥"
    },
    {
      "n": 5,
      "text": "用搅拌棒打成完全顺滑的泥，加淡奶油与肉豆蔻拌匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "打完再加热，别边打边煮，热汤飞溅容易烫手。",
      "visual_cue": "汤体顺滑发亮，无颗粒"
    },
    {
      "n": 6,
      "text": "补盐与黑胡椒调味，尝一口后再决定是否再加淡奶油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐要最后补，南瓜的甜度每批不同，早放容易过咸。",
      "visual_cue": "汤色橘黄，表面微微冒泡"
    }
  ],
  "tips": [
    "南瓜浓汤是法国家常前菜，秋冬南瓜上市时几乎每周都做。",
    "加一小勺烤香的南瓜籽，口感更丰富。",
    "想要更浓可以少加水，用土豆增稠更健康。"
  ],
  "common_mistakes": [
    "南瓜块切得太大，煮二十分钟中心还发硬，打出来带颗粒。",
    "高汤加太多，汤稀得像水，喝不出南瓜的甜。",
    "打泥时汤太烫还盖紧盖子，热汽顶开盖烫到手。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "80毫升:100毫升",
      "note": "牛奶版更清爽，热量也低，但汤的厚度会减。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "700毫升:700毫升",
      "note": "清水版需补一小块黄油增香。"
    }
  ],
  "variations": [
    "加半个烤过的红椒同打，汤里带一点烟熏味。",
    "放一小块姜同煮，甜味更立体，适合冬天喝。"
  ],
  "serving_suggestion": "盛进浅汤碗，淋一圈淡奶油拉花，配烤面包片。",
  "storage": "冷藏可存三天，冷冻可存一个月，复热时补少量高汤调稀。",
