    "木勺",
    "烤箱",
    "耐热汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱去皮切成细丝，切的时候刀口朝下压住，尽量切得粗细一致。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱丝切匀才好一起焦糖化，粗的还没软细的已经焦了。",
      "visual_cue": "洋葱丝细而均匀，堆成小山"
    },
    {
      "n": 2,
      "text": "厚底锅化黄油，下洋葱丝小火慢炒，每隔几分钟翻一次。",
      "time_min": 30,
      "heat": "小火",
      "tip": "这一步急不得，四十分钟慢炒才有深琥珀色，火大了只焦不甜。",
      "visual_cue": "洋葱塌软，颜色转浅褐"
    },
    {
      "n": 3,
      "text": "洋葱炒成深褐色时撒面粉，翻炒两分钟让面粉裹匀炒出生香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "面粉必须炒到没有生面粉气，否则汤会有股面糊味。",
      "visual_cue": "洋葱挂薄浆，锅底无干粉"
    },
    {
      "n": 4,
      "text": "倒入高汤，加百里香与盐，煮开后转小火煨二十分钟。",
      "time_min": 18,
      "heat": "小火",
      "tip": "高汤要一点点倒进去搅开，一次冲下去面粉会结块。",
      "visual_cue": "汤色深褐，表面微微发稠"
    },
    {
      "n": 5,
      "text": "面包片烤脆，汤盛进用大蒜擦过内壁的耐热碗，盖面包撒奶酪与白胡椒，入烤箱烤到奶酪起泡。",
      "time_min": 6,
      "heat": "大火",
      "tip": "碗边先擦干再入烤箱，汤水挂边容易烤焦留下黑圈。",
      "visual_cue": "奶酪金黄起泡，碗边一圈微焦"
    }
  ],
  "tips": [
    "洋葱汤的关键全在那半小时的慢炒，颜色越深汤越甜。",
    "用牛肉高汤最正统，素的用烤过的蘑菇高汤也能出厚味。",
    "汤碗最好用能进烤箱的陶碗，端上桌还咕嘟冒泡才像样。"
  ],
  "common_mistakes": [
    "洋葱大火快炒十分钟就下汤，汤色浅黄，甜味出不来。",
    "面粉一次倒太多，汤稠得像糊，喝一口糊嘴。",
    "奶酪用低脂的，烤完不化还结成一层皮，拉不出丝。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "40克:40毫升",
      "note": "橄榄油版更清爽，焦糖化稍慢。"
    },
    {
      "original": "奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "100克:110克",
      "note": "马苏里拉拉丝好，风味略淡。"
    }
  ],
  "variations": [
    "汤里加一勺干邑，香气更醇，是巴黎餐馆的做法。",
    "洋葱里混一点韭葱同炒，甜味更清，颜色也浅一些。"
  ],
  "serving_suggestion": "连碗上桌，撒一点黑胡椒，配一杯干白或淡啤酒。",
  "storage": "汤底冷藏可存三天，面包与奶酪现烤现盖，勿提前组装。",
