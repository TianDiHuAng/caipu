  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 200,
          "unit": "g",
          "note": "四枚，蛋黄蛋白分开",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 40,
          "unit": "g",
          "note": "擦细丝",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切极细的圈",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "蛋白与蛋黄各一半",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 3,
          "unit": "ml",
          "note": "打蛋白时稳定气泡",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "不粘锅",
    "打蛋盆",
    "电动打蛋器",
    "橡皮刮刀",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕开分离蛋黄与蛋白，蛋白放进无油无水的干净盆里，冷藏备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盆里沾一点油或水，蛋白就打不发，先用厨房纸擦干净。",
      "visual_cue": "蛋白清澈透亮，盆里没有蛋黄混入"
    },
    {
      "n": 2,
      "text": "蛋黄加盐与白胡椒搅散，搅到颜色变浅发稠，放一旁待用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋黄搅到发稠，蛋卷的口感才细腻不水。",
      "visual_cue": "蛋黄液浅黄浓稠，能挂住打蛋器"
    },
    {
      "n": 3,
      "text": "蛋白里加柠檬汁，用电动打蛋器从低速到中速打，打到提起有弯钩的湿性发泡。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打到湿性发泡就停，打太硬拌的时候会消泡，蛋卷塌陷。",
      "visual_cue": "蛋白霜洁白有光泽，提起呈弯钩"
    },
    {
      "n": 4,
      "text": "取三分之一蛋白霜放进蛋黄液，用刮刀翻拌均匀，再倒回剩余蛋白霜里轻轻拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "从底往上翻拌，画圈搅会把气泡全部压破。",
      "visual_cue": "蛋糊颜色均匀，体积蓬松不塌"
    },
    {
      "n": 5,
      "text": "不粘锅中小火加热，放一半黄油抹匀锅底，倒入蛋糊，用刮刀把表面抹平。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "黄油别烧到变色，微微起泡就下蛋糊，焦了会带苦味。",
      "visual_cue": "蛋糊在锅里铺满，边缘开始凝固"
    },
    {
      "n": 6,
      "text": "盖盖焖三分钟，让蒸汽把表层焖到半凝固，此时撒上奶酪丝与葱花。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盖盖是关键，靠蒸汽让表面定型，翻面才不会破。",
      "visual_cue": "表面大半凝固，按压有弹性"
    },
    {
      "n": 7,
      "text": "用刮刀从锅边往中间推，把蛋饼对折成半月形，再煎一分钟定型。",
      "time_min": 2,
      "heat": "小火",
      "tip": "对折时动作要轻，从一侧慢慢翻过去，一次到位。",
      "visual_cue": "蛋卷对折完整，边缘无破裂"
    },
    {
      "n": 8,
      "text": "关火后放剩下的黄油在表面晃一圈，滑到盘中，撒葱花趁热上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "表面那点黄油能让蛋卷泛光，香气也更足。",
      "visual_cue": "表面油亮蓬松，轻按有回弹"
    }
  ],
  "tips": [
    "鸡蛋要提前回温到室温，蛋白更容易打发到位且不易消泡。",
    "奶酪选格鲁耶尔或帕玛森，咸香能把蛋味托起来。",
    "做好的蛋卷要立刻吃，放五分钟就会明显回缩。",
    "想更豪华可以加一勺炒软的蘑菇或烟熏三文鱼做内馅。"
  ],
  "common_mistakes": [
    "蛋白打到硬性发泡，拌的时候一压就消泡，煎出来扁塌。",
    "火太大，底部焦黑而中心还是流动蛋糊。",
    "蛋卷煎好后久放不盛盘，余温继续加热，内部变干。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "奶油奶酪",
      "ratio": "40克:40克",
      "note": "口感更绵密，咸味较弱，盐可略加。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "20克:18毫升",
      "note": "少了奶香，但更适合不喜乳制品的人。"
    }
  ],
  "variations": [
    "加一小勺细砂糖与香草精做甜版，表面撒糖粉就是法式甜蛋卷。",
    "填入炒好的菠菜与羊奶酪，做成咸香更重的主菜版本。"
  ],
  "serving_suggestion": "2人份当作早午餐主菜，配一份拌沙拉与烤番茄，或配一杯香槟。",
  "storage": "必须现做现吃，冷藏后蛋白霜结构塌陷，复热无法恢复蓬松。",
  "nutrition_estimate": {
    "basis": "按两人份估算",
