  "equipment": [
    "烤箱",
    "擀面杖",
    "冰箱",
    "保鲜膜",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉、白糖、盐和酵母加牛奶揉成光滑面团。，看准状态再往下做。",
      "time_min": 15,
      "heat": "无火",
      "tip": "面团要揉出薄膜，层次才撑得住。，看准状态再往下做。",
      "visual_cue": "面团光滑，能拉薄，这一点很关键。"
    },
    {
      "n": 2,
      "text": "面团压扁包保鲜膜，冷藏松弛四十分钟。，看准状态再往下做。",
      "time_min": 42,
      "heat": "无火",
      "tip": "冷藏让面团变硬，才好擀黄油。，看准状态再往下做。",
      "visual_cue": "面团紧实，回弹变慢"
    },
    {
      "n": 3,
      "text": "黄油敲成十七厘米见方的薄片，冷藏备用。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黄油要冷但要能弯，别冻硬。，看准状态再往下做。",
      "visual_cue": "厚度均匀，边缘整齐"
    },
    {
      "n": 4,
      "text": "面团擀成大方形，包入黄油片封紧接口。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "口要捏紧，擀的时候才不漏油。，看准状态再往下做。",
      "visual_cue": "包裹紧实，无气泡，这一点很关键。"
    },
    {
      "n": 5,
      "text": "擀成长方形，三折一次，冷藏二十分钟。，看准状态再往下做。",
      "time_min": 25,
      "heat": "无火",
      "tip": "每次折叠都要冷藏，黄油才不化。，看准状态再往下做。",
      "visual_cue": "面片整齐，黄油不渗"
    },
    {
      "n": 6,
      "text": "重复擀折两次，共完成三次三折后冷藏。，看准状态再往下做。",
      "time_min": 45,
      "heat": "无火",
      "tip": "三次三折，层次才够多够薄。，看准状态再往下做。",
      "visual_cue": "面片光滑，层次可见"
    },
    {
      "n": 7,
      "text": "擀成三毫米厚，切成底宽六厘米的长三角。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "尺寸要匀，卷出来的形状才一致。，看准状态再往下做。",
      "visual_cue": "三角规整，厚薄一致"
    },
    {
      "n": 8,
      "text": "从宽边卷起，收口朝下摆进烤盘，发酵一小时。，看准状态再往下做。",
      "time_min": 65,
      "heat": "无火",
      "tip": "卷紧一点，烤后才不散。，看准状态再往下做。",
      "visual_cue": "卷形饱满，收口在下"
    },
    {
      "n": 9,
      "text": "刷蛋液，烤箱两百度烤十五分钟到金黄。，看准状态再往下做。",
      "time_min": 15,
      "heat": "无火",
      "tip": "中途别开炉门，温度一降就不膨。，看准状态再往下做。",
      "visual_cue": "表面金黄，层次绽开"
    }
  ],
  "tips": [
    "黄油和面团硬度要一致，擀时才不破皮。",
    "每次折叠后冷藏，黄油才不会化。，这一点很关键。",
    "发酵到位再烤，层次才起得开。，这一点很关键。"
  ],
  "common_mistakes": [
    "黄油太软，擀的时候全漏出来。，这一点很关键。",
    "面团不冷藏，折叠后回缩。，这一点很关键。",
    "发酵不足就烤，成品硬如石头。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "起酥油",
      "ratio": "250 克:250 克",
      "note": "更好操作，风味差一些。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "250 毫升:240 毫升",
      "note": "奶香减弱，口感略干。"
    }
  ],
  "variations": [
    "卷入巧克力条，做成巧克力可颂。，这一点很关键。",
    "表面撒杏仁片，口感更香脆。，这一点很关键。"
  ],
  "serving_suggestion": "早餐配咖啡，或配果酱。，这一点很关键。",
  "storage": "常温一天，冷冻一个月；复热烤箱一百八十度五分钟。",
