  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg yolk",
          "amount": 3,
          "unit": "piece",
          "note": "常温回温",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 200,
          "unit": "g",
          "note": "澄清后取油",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 30,
          "unit": "g",
          "note": "挤汁",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 20,
          "unit": "ml",
          "note": "调节稠度",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "隔水锅",
    "打蛋器",
    "小奶锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油切小块放入小奶锅，小火加热至完全融化并浮起白色乳清泡沫。",
      "time_min": 6,
      "heat": "小火",
      "tip": "不要搅动，让杂质自然沉底。",
      "visual_cue": "液面浮起厚厚一层白沫"
    },
    {
      "n": 2,
      "text": "用勺子撇去表面白沫，取上层澄清黄油约 160ml，剩余乳渣弃去。",
      "time_min": 3,
      "heat": "无火",
      "tip": "澄清黄油不易起油水分离。",
      "visual_cue": "油体金黄透亮、无浑浊"
    },
    {
      "n": 3,
      "text": "鸡蛋取 3 个蛋黄加 15ml 柠檬汁与 20ml 温水，放入隔水锅中小火不停搅打。",
      "time_min": 6,
      "heat": "微火",
      "tip": "锅底不能碰到水，温度过高蛋黄会结块。",
      "visual_cue": "蛋液变浅发稠、能挂住打蛋器"
    },
    {
      "n": 4,
      "text": "离火后分十次淋入澄清黄油，每加一次都搅打至完全融合再加下一次。",
      "time_min": 7,
      "heat": "无火",
      "tip": "一次倒多必然油水分离。",
      "visual_cue": "酱体浓稠顺滑、有缎面光泽"
    },
    {
      "n": 5,
      "text": "加 2g 盐、1g 白胡椒与剩余柠檬汁调味，尝一下酸咸是否平衡。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酸味不足可再挤几滴柠檬汁。",
      "visual_cue": "酱汁微酸带奶香、能挂勺"
    }
  ],
  "tips": [
    "全程温度控制在 65℃ 左右，手感温热不烫。",
    "黄油必须一小勺一小勺地淋入，倒急了立刻油水分离。",
    "做好的酱放在 50℃ 温水中保温，别直接加热。"
  ],
  "common_mistakes": [
    "蛋黄直接大火加热，变成一锅炒蛋碎。",
    "黄油倒得太快，酱汁彻底油水分离。",
    "用带盐黄油又额外加盐，咸得发苦。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "无水黄油",
      "ratio": "200g 对 160g",
      "note": "省去澄清步骤。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "30g 对 15ml",
      "note": "酸味更冲，用量减半。"
    }
  ],
  "variations": [
    "贝阿恩酱：加 10g 龙蒿碎与红葱头碎。",
    "马尔泰斯酱：拌入 20ml 番茄酱调色。"
  ],
  "serving_suggestion": "淋在班尼迪克蛋、水煮芦笋或煎鱼上，趁温热食用。",
  "storage": "冷藏 2 天，复温时隔水加 5ml 温水慢慢搅开。",
