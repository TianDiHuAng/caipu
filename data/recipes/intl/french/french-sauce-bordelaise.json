        }
      ]
    }
  ],
  "equipment": [
    "小汤锅",
    "木勺",
    "细筛",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红葱头去皮切成极细的末，百里香摘下叶片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "红葱头切得越细越好，粗末在酱里会有颗粒感，口感发渣。",
      "visual_cue": "葱末细白散开，叶片摘下"
    },
    {
      "n": 2,
      "text": "小汤锅不放油，下红葱头末小火干炒到发软出香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "不要放油，靠红酒慢慢浸出香味，加了油酱会发腻。",
      "visual_cue": "葱末变软，锅底微微发干"
    },
    {
      "n": 3,
      "text": "倒入红酒与百里香、香叶，中火收到只剩三分之一。",
      "time_min": 8,
      "heat": "中火",
      "tip": "红酒一定要收浓，酒味收不掉，酱就会有股冲鼻的酸涩。",
      "visual_cue": "液体浓稠，锅底见红褐色"
    },
    {
      "n": 4,
      "text": "倒入高汤大火煮开，撇干净表面浮沫后转小火煮八分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "高汤要分两次加，一次倒足味道会淡，香气也没层次。",
      "visual_cue": "酱汁微稠，表面浮细沫"
    },
    {
      "n": 5,
      "text": "黄油与面粉揉成小团，一点点投入酱中搅到化开收稠。",
      "time_min": 4,
      "heat": "小火",
      "tip": "黄油面团要一点点投，一次全下去会结块，怎么搅都散不开。",
      "visual_cue": "酱体挂勺，颜色深红发亮"
    },
    {
      "n": 6,
      "text": "细筛滤掉葱末与香叶，回锅补盐与现磨黑胡椒。",
      "time_min": 4,
      "heat": "小火",
      "tip": "过滤后酱体才细腻，不滤的话葱末沉底，看着发脏。",
      "visual_cue": "酱汁顺滑无渣，颜色透亮"
    }
  ],
  "tips": [
    "红酒酱是法式牛排的经典搭配，波尔多一带家家都会做。",
    "加一小勺牛骨髓同煮更正宗，香气厚得多。",
    "收浓的红酒可以提前做好，冷藏一周内用完。"
  ],
  "common_mistakes": [
    "红酒没收浓就加高汤，酱汁带明显酒酸，喉咙发冲。",
    "黄油面团一次投太多，酱里全是一颗颗面疙瘩。",
    "全程大火收汁，锅底焦糖化过头，酱带苦味。"
  ],
  "substitutions": [
    {
      "original": "红酒",
      "substitute": "白葡萄酒",
      "ratio": "250毫升:250毫升",
      "note": "白酒版颜色浅，酸度更亮，适合配白肉。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "300毫升:300毫升",
      "note": "清水版味道单薄，需补一小勺酱油增鲜。"
    }
  ],
  "variations": [
    "加几片煎香的牛骨髓一起上桌，是波尔多餐厅的传统摆盘。",
    "放一把炒香的香菇末，做成菌香红酒酱，配鸡胸也合适。"
  ],
  "serving_suggestion": "趁热淋在煎好的牛排或烤鸡上，配一份炸薯条。",
  "storage": "冷藏可存四天，复热时小火加一勺高汤调稀，勿大火煮沸。",
