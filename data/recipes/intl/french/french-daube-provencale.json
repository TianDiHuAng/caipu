  "steps": [
    {
      "n": 1,
      "text": "牛肉切大块，用盐和黑胡椒抓匀腌二十分钟。，留点余量更好，香气才留得住。",
      "time_min": 22,
      "heat": "无火",
      "tip": "肉块擦干，煎才上色。，动作放连贯，层次才明显。",
      "visual_cue": "表面调料均匀，肉色发深"
    },
    {
      "n": 2,
      "text": "炖锅倒橄榄油，牛肉分批煎到焦褐。，顺序照着来，香气才留得住。",
      "time_min": 12,
      "heat": "大火",
      "tip": "分批煎，锅温才不掉。，火别太大，味道才进得去。",
      "visual_cue": "表面焦褐，锅底留香，手法轻些，形状才完整。"
    },
    {
      "n": 3,
      "text": "盛出牛肉，余油炒洋葱丁到软。，火别太大，锅气才足。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒透，汤才甜。，留意锅底，细节才到位。",
      "visual_cue": "洋葱透明，边缘金黄，慢慢来别急，味道才进得去。"
    },
    {
      "n": 4,
      "text": "加蒜末和百里香炒香。，慢慢来别急，锅气才足。，汤汁别收太干，咸淡才好把握。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "香草遇油，香味才出。，别用力搅，火候才均匀。",
      "visual_cue": "香气散出，油面微泡，翻动放轻，味道才进得去。"
    },
    {
      "n": 5,
      "text": "下番茄块炒到出汁变稠。，锅温要匀，火候才均匀。，动作放连贯，样子才体面。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒出沙，汤才浓。，时间掐准，食材才不糊。",
      "visual_cue": "汁水红亮，番茄软塌，别用力搅，锅气才足。"
    },
    {
      "n": 6,
      "text": "加胡萝卜块和橄榄，翻炒两分钟。，先试试温度，香气才留得住。",
      "time_min": 3,
      "heat": "中火",
      "tip": "橄榄提味，别切碎。，别反复翻动，表面才漂亮。",
      "visual_cue": "胡萝卜油亮，橄榄完整，别用力搅，口感才不发柴。"
    },
    {
      "n": 7,
      "text": "倒红酒煮开，刮起锅底焦香。，看着泡沫就够，成品才稳当。",
      "time_min": 5,
      "heat": "大火",
      "tip": "刮锅底，味道才全。，慢慢来别急，整道菜才立得住。",
      "visual_cue": "酒气挥发，汁色深红，盖盖焖一会儿，味道才不闷。"
    },
    {
      "n": 8,
      "text": "放回牛肉，加高汤没过食材煮开。，别反复翻动，吃口才舒服。",
      "time_min": 7,
      "heat": "大火",
      "tip": "汤要没过肉，炖才均匀。，别反复翻动，火候才到位。",
      "visual_cue": "汤面翻涌，浮沫上浮，顺序照着来，成品才稳当。"
    },
    {
      "n": 9,
      "text": "转小火盖盖炖两小时，中途翻一次。，慢慢来别急，颜色才够亮。",
      "time_min": 122,
      "heat": "小火",
      "tip": "小火慢炖，肉才软烂。，起锅前尝味，香气才不跑。",
      "visual_cue": "肉一戳就散，汤汁浓稠，盖盖焖一会儿，颜色才够亮。"
    },
    {
      "n": 10,
      "text": "开盖收汁十分钟，加盐调味。，慢慢来别急，口感才不发柴。",
      "time_min": 12,
      "heat": "中火",
      "tip": "收汁别太干，浇饭才好吃。，动作放连贯，风味才干净。",
      "visual_cue": "汤汁挂勺，油光浮动，留意锅底，锅气才足。"
    },
    {
      "n": 11,
      "text": "撒欧芹碎，静置五分钟再上桌。，顺序照着来，味道才站得住。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置让味道融合。，料切得匀些，味道才稳。",
      "visual_cue": "香草鲜绿，汤色深沉，手别抖，细节才经得起看。"
    }
  ],
  "tips": [
    "牛肉分批煎，焦香才足。，别急着开盖，火候才准。",
    "红酒煮开先挥发酒精，味道才干净。，手别抖，成品才不出错。",
    "隔夜再吃，味道更融。，量别贪多，香气才足。"
  ],
  "common_mistakes": [
    "火大滚煮，肉发柴。，手别抖，火候才准。",
    "红酒没煮开，酒味冲。，顺序别乱，口感才顺。",
    "汤不够，中途干锅。，量别贪多，细节才经得起看。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "1200 克:1200 克",
      "note": "风味更重，可加百里香一克。"
    },
    {
      "original": "红酒",
      "substitute": "高汤",
      "ratio": "200 毫升:200 毫升",
      "note": "无酒精版本，酸度略低。"
    }
  ],
  "variations": [
    "加橙皮同炖，香气更清。，动作连贯点，香气才足。",
    "加土豆块，汤汁更稠。，别急着开盖，成品才不出错。"
  ],
  "serving_suggestion": "配通心粉、土豆泥或面包。，手别抖，成色才好。",
  "storage": "冷藏三天，复热更入味。，量别贪多，样子才周正。",
