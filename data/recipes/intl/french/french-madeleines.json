  "equipment": [
    "烤箱",
    "打蛋器",
    "碗",
    "贝壳模具",
    "筛网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进碗里加白糖和盐，用打蛋器打到发白浓稠。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打到蛋液画线能短暂停留，膨发才够。",
      "visual_cue": "蛋糊发白，纹路缓慢消失"
    },
    {
      "n": 2,
      "text": "面粉和泡打粉一起过筛，分两次拌进蛋糊里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "分次筛入轻拌，一次倒进去容易起疙瘩。",
      "visual_cue": "面糊顺滑无干粉颗粒"
    },
    {
      "n": 3,
      "text": "黄油化成液体放温，拌进面糊，加蜂蜜和香草精。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油太烫会把蛋糊烫熟，手摸温热就行。",
      "visual_cue": "面糊光亮，流动性好"
    },
    {
      "n": 4,
      "text": "柠檬擦下黄色皮屑拌入，面糊盖好冷藏静置半小时。",
      "time_min": 32,
      "heat": "无火",
      "tip": "只擦黄色表皮，擦到白瓤会带苦味。",
      "visual_cue": "面糊变稠，表面平整"
    },
    {
      "n": 5,
      "text": "贝壳模具刷一层黄油撒薄粉，面糊挤到八分满。",
      "time_min": 5,
      "heat": "无火",
      "tip": "模具撒粉后倒扣抖掉多余粉，脱模才干净。",
      "visual_cue": "面糊居中，模具内壁挂粉"
    },
    {
      "n": 6,
      "text": "烤箱一百九十度烤十分钟，边缘金黄鼓起小肚子。",
      "time_min": 10,
      "heat": "中火",
      "tip": "中途别开门，温差一大就鼓不出小肚子。",
      "visual_cue": "边缘金黄，中心鼓起"
    }
  ],
  "tips": [
    "面糊冷藏静置，烤出来小肚子才明显。",
    "黄油放温再拌，太烫会把蛋糊烫成蛋花。",
    "模具刷油撒粉要匀，脱模才不破边。"
  ],
  "common_mistakes": [
    "面糊不冷藏就烤，成品扁平没有小肚子。",
    "黄油滚烫倒入蛋糊，蛋液结块成蛋花。",
    "模具不撒粉，出炉粘壳挖得稀烂。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "20 克:22 克",
      "note": "香气略减，面糊偏干可加五毫升牛奶。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "20 克:20 克",
      "note": "香气更锐利，用量相同。"
    }
  ],
  "variations": [
    "面糊里加一小勺可可粉，做成巧克力版。",
    "出炉刷一层柠檬糖水，表面更亮更香。"
  ],
  "serving_suggestion": "温热时配红茶吃，外壳微脆内里湿润最迷人。",
  "storage": "密封常温两天，回烤三分钟恢复脆壳。",
