  "equipment": [
    "烤箱",
    "打蛋器",
    "汤锅",
    "烤盅",
    "筛子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤盅内壁刷一层软化黄油，撒白糖转匀。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "内壁裹糖，舒芙蕾才爬得高。，看准状态再往下做。",
      "visual_cue": "内壁均匀，无空档，这一点很关键。"
    },
    {
      "n": 2,
      "text": "牛奶小火加热到边缘冒泡，别煮沸。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "牛奶微沸就够，滚了会结皮。，看准状态再往下做。",
      "visual_cue": "边缘起泡，表面微动"
    },
    {
      "n": 3,
      "text": "黑巧克力隔水融化，搅到顺滑无颗粒。，看准状态再往下做。",
      "time_min": 6,
      "heat": "小火",
      "tip": "水温别太高，巧克力才不结块。，看准状态再往下做。",
      "visual_cue": "糊体油亮，流动顺滑"
    },
    {
      "n": 4,
      "text": "融化巧克力里倒入热牛奶，搅匀成糊。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "慢慢倒边搅，避免结块。，看准状态再往下做。",
      "visual_cue": "糊体浓稠，颜色深褐"
    },
    {
      "n": 5,
      "text": "加面粉和盐拌匀，稍凉后加入蛋黄。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糊要放凉再加蛋黄，否则会熟。，看准状态再往下做。",
      "visual_cue": "糊体顺滑，无干粉，这一点很关键。"
    },
    {
      "n": 6,
      "text": "蛋白加一半白糖打到湿性发泡。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到提起有弯钩就够，别打太硬。，看准状态再往下做。",
      "visual_cue": "蛋白洁白，弯钩下垂"
    },
    {
      "n": 7,
      "text": "分三次把蛋白霜翻拌进巧克力糊。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "翻拌别画圈，消泡就发不起来。，看准状态再往下做。",
      "visual_cue": "糊体蓬松，颜色均一"
    },
    {
      "n": 8,
      "text": "倒进烤盅抹平，烤箱两百度烤十二分钟。，看准状态再往下做。",
      "time_min": 14,
      "heat": "无火",
      "tip": "中途别开炉门，塌了就不回弹。，看准状态再往下做。",
      "visual_cue": "表面鼓起，中心微颤"
    },
    {
      "n": 9,
      "text": "出炉撒糖粉，立刻上桌趁热吃。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "舒芙蕾出炉几分钟就会塌，快吃。，看准状态再往下做。",
      "visual_cue": "顶部高耸，糖粉雪白"
    }
  ],
  "tips": [
    "内壁裹糖，舒芙蕾才爬得高。，这一点很关键。",
    "蛋白打到湿性发泡就够。，这一点很关键。",
    "中途别开烤箱门，否则会塌。，这一点很关键。"
  ],
  "common_mistakes": [
    "蛋白打太硬，拌进糊里结块。，这一点很关键。",
    "巧克力糊太稀，烤起来发不起来。，这一点很关键。",
    "烤好放着不吃，几分钟就塌。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "黑巧克力",
      "substitute": "可可粉",
      "ratio": "150 克:60 克",
      "note": "需增加黄油十克。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "150 毫升:150 毫升",
      "note": "口感更浓，烤的时间加两分钟。"
    }
  ],
  "variations": [
    "底下放一勺樱桃酱，切开流心。，这一点很关键。",
    "表面撒一点海盐，甜味更立体。，这一点很关键。"
  ],
  "serving_suggestion": "出炉立刻上桌，配一勺香草冰淇淋。",
  "storage": "现做现吃，不建议保存。，这一点很关键。",
