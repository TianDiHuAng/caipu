  "steps": [
    {
      "n": 1,
      "text": "大锅烧水加盐，通心粉煮到八分熟就捞出沥干。",
      "time_min": 9,
      "heat": "大火",
      "tip": "煮到八分熟就够，后面还要焗，煮全熟会烂成糊。",
      "visual_cue": "通心粉有嚼劲，中心留白点"
    },
    {
      "n": 2,
      "text": "小锅化黄油炒面粉，小火两分钟到没有生面粉味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "面糊要炒到起泡，生面粉味留在白汁里，整盘菜都发涩。",
      "visual_cue": "面糊冒小泡，颜色转成浅麦色"
    },
    {
      "n": 3,
      "text": "分次倒入温牛奶搅匀，边煮边搅到浓稠能挂住勺背。",
      "time_min": 7,
      "heat": "小火",
      "tip": "牛奶要温，冷的下锅立刻结块，白汁就废了。",
      "visual_cue": "白汁浓稠，勺背挂上厚厚一层"
    },
    {
      "n": 4,
      "text": "白汁加盐、黑胡椒与肉豆蔻，拌入洋葱末与火腿丁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "洋葱末不用炒，靠焗的时候焖熟，还带一点脆。",
      "visual_cue": "配料均匀混入，白汁奶黄"
    },
    {
      "n": 5,
      "text": "通心粉拌进白汁，倒进抹了黄油的烤盘，表面抹平。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌的时候留一点白汁备用，表面太干烤完会发硬。",
      "visual_cue": "面与汁拌匀，盘面平整"
    },
    {
      "n": 6,
      "text": "撒满奶酪丝，二百度烤十八分钟到表面金黄起泡。",
      "time_min": 20,
      "heat": "无火",
      "tip": "奶酪要盖满表面，露出面管的地方会烤干发焦。",
      "visual_cue": "表面金黄起泡，边缘焦脆"
    }
  ],
  "tips": [
    "通心粉焗是法国家庭的经典安慰食物，孩子最爱。",
    "加一勺第戎芥末到白汁里，味道更有层次。",
    "用两三种奶酪混合，风味比单一奶酪更丰富。"
  ],
  "common_mistakes": [
    "通心粉煮太软再焗，出炉后一夹就断成糊。",
    "白汁太稀，焗完盘底汪水，切开全散。",
    "奶酪只撒中间，边缘的面管烤干发焦，卖相差。"
  ],
  "substitutions": [
    {
      "original": "通心粉",
      "substitute": "意大利面",
      "ratio": "400克:400克",
      "note": "长面条需掰短再煮，焗的时候更好分装。"
    },
    {
      "original": "火腿",
      "substitute": "培根",
      "ratio": "100克:100克",
      "note": "培根版咸度高，盐需减半。"
    }
  ],
  "variations": [
    "加一把豌豆同焗，颜色清爽，口感也更丰富。",
    "放几片香菇同拌，做成素版，鲜味来自菌菇。"
  ],
  "serving_suggestion": "出炉静置五分钟再切块，配一份简单的绿叶沙拉。",
  "storage": "冷藏可存两天，复热时盖锡纸烤十分钟防表面过焦。",
