  "equipment": [
    "烤箱",
    "擀面杖",
    "塔模",
    "刀",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和冷黄油丁，用手指搓成粗砂状。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，搓出的颗粒才酥。，看准状态再往下做。",
      "visual_cue": "颗粒松散，无大块，别跳过这步。"
    },
    {
      "n": 2,
      "text": "加清水快速揉成团，包好冷藏松弛半小时。，看准状态再往下做。",
      "time_min": 35,
      "heat": "无火",
      "tip": "别揉太久，起筋就不酥了。，看准状态再往下做。",
      "visual_cue": "面团光滑，手感偏硬"
    },
    {
      "n": 3,
      "text": "苹果去皮去核，切成两毫米的薄片。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "片切薄，烤后才软不夹生。，看准状态再往下做。",
      "visual_cue": "片薄均匀，形状完整"
    },
    {
      "n": 4,
      "text": "面团擀成圆片，铺进塔模压实并扎孔。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "扎孔排气，塔皮才不鼓起。，看准状态再往下做。",
      "visual_cue": "厚度均匀，边缘整齐"
    },
    {
      "n": 5,
      "text": "塔皮上撒杏仁粉，铺一层苹果片撒白糖。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "杏仁粉隔湿，塔底才不软。，看准状态再往下做。",
      "visual_cue": "铺面平整，糖粒均匀"
    },
    {
      "n": 6,
      "text": "余下的苹果片叠成花形摆在表面。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "从外向内叠，花纹才好看。，看准状态再往下做。",
      "visual_cue": "花形紧凑，层次清晰"
    },
    {
      "n": 7,
      "text": "表面撒肉桂粉和剩余白糖，刷一层蛋液。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷蛋液，烤出的表面才亮。，看准状态再往下做。",
      "visual_cue": "表面油亮，糖粒闪光"
    },
    {
      "n": 8,
      "text": "烤箱一百八十度烤三十五分钟到边缘金黄。，看准状态再往下做。",
      "time_min": 35,
      "heat": "无火",
      "tip": "中途转盘一次，上色才均匀。，看准状态再往下做。",
      "visual_cue": "边缘焦黄，苹果软化"
    },
    {
      "n": 9,
      "text": "出炉放凉十分钟，脱模切块。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "凉了再切，塔皮才不碎。，看准状态再往下做。",
      "visual_cue": "切面整齐，果片分明"
    }
  ],
  "tips": [
    "黄油要冷着搓，塔皮才酥。，这步最关键。",
    "苹果片切薄切匀，摆花才服帖。，很多人在这里出错。",
    "出炉放凉再脱模，塔皮不易碎。，这里最容易翻车。"
  ],
  "common_mistakes": [
    "黄油化了再搓，塔皮硬如饼干。，别小看这一步。",
    "苹果切太厚，烤完还是生的。，成败就在这一步。",
    "热着脱模，塔皮全裂。，这点要注意。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "梨",
      "ratio": "800 克:800 克",
      "note": "更甜更软，糖减二十克。"
    },
    {
      "original": "杏仁粉",
      "substitute": "面包糠",
      "ratio": "40 克:40 克",
      "note": "隔湿效果近似，风味略差。"
    }
  ],
  "variations": [
    "表面刷一层杏子果酱，光泽更亮。，这是关键点。",
    "加一勺香草精，香气更浓。，别嫌麻烦，做完它。"
  ],
  "serving_suggestion": "温热吃，配一球香草冰淇淋。，这一步别省。",
  "storage": "冷藏三天，复热烤箱一百六十度十分钟。",
