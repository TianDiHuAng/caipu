  "equipment": [
    "汤锅",
    "研钵",
    "刀",
    "砧板",
    "大碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "罗勒摘叶洗净，用布轻轻拍干，与蒜瓣、松子一起放进研钵，加一小撮盐。",
      "time_min": 6,
      "heat": "无火",
      "tip": "叶片一定要拍干，带水打的酱会发黑发苦。",
      "visual_cue": "罗勒叶干爽，蒜与松子备好"
    },
    {
      "n": 2,
      "text": "一边研捣一边缓慢淋橄榄油，捣成粗颗粒的青酱，不要用机器打成糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "研钵捣出的酱有颗粒感，香气比机器打的浓得多。",
      "visual_cue": "酱体翠绿带颗粒，油润不流散"
    },
    {
      "n": 3,
      "text": "汤锅烧开水，加盐后下意大利面，按包装时间少煮一分钟，捞出留一杯煮面水。",
      "time_min": 10,
      "heat": "大火",
      "tip": "留煮面水是让酱汁挂在面上的秘诀，里面全是煮出来的面糊。",
      "visual_cue": "意面外软内有芯，汤色微浊"
    },
    {
      "n": 4,
      "text": "面煮到一半时另起平底锅，放橄榄油炒西葫芦丁三分钟，撒盐调味盛出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "西葫芦炒到边缘透明就停，炒烂了整盘面会出水。",
      "visual_cue": "西葫芦丁微软，边缘透明"
    },
    {
      "n": 5,
      "text": "把青酱放进大碗里，加两勺煮面水搅开，让酱汁乳化变稠。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先用水把酱稀释再拌面，酱才不会一坨坨堆在面上。",
      "visual_cue": "酱汁顺滑，颜色鲜绿"
    },
    {
      "n": 6,
      "text": "热面沥干后直接倒进碗里，快速翻拌让每根面都裹上青酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "面要滚热时拌，凉了酱挂不住，只能浮在表面。",
      "visual_cue": "意面通体染绿，酱汁不沉底"
    },
    {
      "n": 7,
      "text": "拌入炒好的西葫芦与番茄丁，撒奶酪碎与黑胡椒，试味后补盐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪带咸味，盐要等拌完再补，免得过头。",
      "visual_cue": "配料分布均匀，面上有奶酪雪"
    },
    {
      "n": 8,
      "text": "装盘后淋一圈生的橄榄油，趁热上桌，凉了香气会掉一半。",
      "time_min": 2,
      "heat": "无火",
      "tip": "最后那圈生油是香气的来源，别省。",
      "visual_cue": "表面油亮，罗勒香扑鼻"
    }
  ],
  "tips": [
    "松子可换成去皮的杏仁，但需先焙过再捣，否则发涩。",
    "青酱一次可多做，表面封油冷藏能放一周。",
    "加一把煮软的蚕豆，颜色和口感都更好。",
    "奶酪要用陈年的硬质干酪，咸香最搭罗勒。"
  ],
  "common_mistakes": [
    "用料理机高速打青酱，刀片发热让罗勒氧化，颜色变褐发苦。",
    "面煮好放凉再拌酱，酱汁只挂在表面，吃着油而不香。",
    "省略煮面水，青酱太稠，拌开时要加很多油，成品油腻。"
  ],
  "substitutions": [
    {
      "original": "松子",
      "substitute": "葵花籽",
      "ratio": "30克:30克",
      "note": "先干锅焙香，风味略淡但更便宜。"
    },
    {
      "original": "意大利面",
      "substitute": "通心粉",
      "ratio": "300克:300克",
      "note": "煮制时间按包装调整，其余不变。"
    }
  ],
  "variations": [
    "加几只煎过的虾仁与柠檬皮屑，做成地中海风味的主菜。",
    "把西葫芦换成四季豆与土豆丁，就是尼斯一带的传统搭配。"
  ],
  "serving_suggestion": "三人份主菜，配一份番茄沙拉与一杯冰镇桃红葡萄酒。",
  "storage": "拌好的面冷藏一天内吃完，复热时加一勺煮面水小火拌开；青酱单独冷藏可放一周。",
