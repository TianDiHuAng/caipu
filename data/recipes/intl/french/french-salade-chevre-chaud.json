  "steps": [
    {
      "n": 1,
      "text": "山羊奶酪切一厘米厚片，放室温回软。，锅温要匀，成品才好看。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致，煎时才同步。，保持中小火，颜色才够亮。",
      "visual_cue": "片形完整，手感柔软，手法轻些，整道菜才立得住。"
    },
    {
      "n": 2,
      "text": "面包切同样大小的片，铺平备用。，别急着加油，香气才留得住。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面包比奶酪大一圈才托得住。，盖盖焖一会儿，火候才均匀。",
      "visual_cue": "片形整齐，边缘平直，留点余量更好，火候才到位。"
    },
    {
      "n": 3,
      "text": "小碗调红酒醋、盐、黑胡椒和橄榄油。，汤汁别收太干，口感才不发柴。",
      "time_min": 4,
      "heat": "无火",
      "tip": "慢慢倒油，汁才乳化。，留点余量更好，层次才明显。",
      "visual_cue": "汁体微稠，颜色发红，先试试温度，味道才站得住。"
    },
    {
      "n": 4,
      "text": "生菜和番茄拌入油醋汁，装盘垫底。，时间掐准，锅气才足。",
      "time_min": 5,
      "heat": "无火",
      "tip": "叶菜别泡太久，会塌。，盖盖焖一会儿，口感才有层次。",
      "visual_cue": "叶片油亮，颜色鲜绿，留意锅底，口感才不发柴。"
    },
    {
      "n": 5,
      "text": "平底锅倒橄榄油，面包片煎到脆。，动作放连贯，香气才留得住。",
      "time_min": 5,
      "heat": "中火",
      "tip": "面包煎脆，托住奶酪才不软。，留意锅底，形状才完整。",
      "visual_cue": "表面金黄，边缘酥脆，别用力搅，味道才进得去。"
    },
    {
      "n": 6,
      "text": "奶酪片放面包上，入锅小火煎到底部化。，份量心里有数，味道才站得住。",
      "time_min": 6,
      "heat": "小火",
      "tip": "奶酪别翻面太久，会流。，保持中小火，咸淡才好把握。",
      "visual_cue": "边缘起泡，表面微融，留意锅底，味道才进得去。"
    },
    {
      "n": 7,
      "text": "奶酪淋蜂蜜，撒核桃碎。，保持中小火，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蜂蜜后淋，颜色才亮。，火别太大，火候才均匀。",
      "visual_cue": "表面油亮，坚果点缀，盖盖焖一会儿，咸淡才好把握。"
    },
    {
      "n": 8,
      "text": "趁热放在沙拉上，浇剩余油醋汁。，份量心里有数，吃口才舒服。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热上桌，口感最好。，料别一次下太多，口感才有层次。",
      "visual_cue": "奶酪微融，汁水挂叶，时间掐准，口感才不发柴。"
    }
  ],
  "tips": [
    "奶酪切厚一点，煎时才不塌。，别用力搅，咸淡才好把握。",
    "面包先煎脆，托得住融化的奶酪。，锅温要匀，颜色才够亮。",
    "油醋汁现调现用，香气才足。，眼观颜色就行，层次才明显。"
  ],
  "common_mistakes": [
    "奶酪太薄，一煎就化没。，手法轻些，锅气才足。",
    "面包没煎脆，吸汁就软。，份量心里有数，香气才留得住。",
    "油倒太快，汁水分离。，时间掐准，咸淡才好把握。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "羊乳酪",
      "ratio": "400 克:400 克",
      "note": "咸味更重，盐可省。"
    },
    {
      "original": "核桃",
      "substitute": "松子",
      "ratio": "40 克:40 克",
      "note": "香气更细，烤制时间减一分钟。"
    }
  ],
  "variations": [
    "加培根碎，咸香更足。，火别太大，香气才不跑。",
    "加无花果，甜味更清。，翻动放轻，口感才不发柴。"
  ],
  "serving_suggestion": "作为前菜，或配面包做轻午餐。，别急着开盖，成色才好。",
  "storage": "现做现吃，不建议久放。，看着点锅，味道才稳。",
