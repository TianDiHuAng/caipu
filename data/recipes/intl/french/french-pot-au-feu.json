  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩切成大块，冷水下锅煮开后撇去浮沫捞出。",
      "time_min": 15,
      "heat": "大火",
      "tip": "冷水下锅慢升温，血沫才逼得出来。",
      "visual_cue": "汤面浮沫撇净，肉块紧实"
    },
    {
      "n": 2,
      "text": "胡萝卜切滚刀块，洋葱切大块，芹菜切段，土豆切块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "蔬菜切得比肉块小些，才能和肉一起软。",
      "visual_cue": "蔬菜块大小均匀，切口整齐"
    },
    {
      "n": 3,
      "text": "汤锅放牛腩和清水，加香叶和百里香大火烧开。",
      "time_min": 10,
      "heat": "大火",
      "tip": "水一次加够，中途加水汤会变寡。",
      "visual_cue": "汤面翻滚，香气散出"
    },
    {
      "n": 4,
      "text": "转为小火慢炖一小时，汤面只冒小泡而不翻滚。",
      "time_min": 60,
      "heat": "小火",
      "tip": "全程小火慢炖，大火会把肉煮柴变散。",
      "visual_cue": "肉块轻压有弹性，表面不散"
    },
    {
      "n": 5,
      "text": "加洋葱、胡萝卜和芹菜再炖半小时，最后下土豆炖三十分钟。",
      "time_min": 30,
      "heat": "小火",
      "tip": "土豆晚下，久炖会碎在汤里糊成一锅。",
      "visual_cue": "蔬菜软而完整，汤色清亮"
    },
    {
      "n": 6,
      "text": "加盐和黑胡椒调味，撇去表面浮油后盛出装盘。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盐最后放，肉才不会提前收缩发柴。",
      "visual_cue": "汤清肉烂，油花清亮"
    }
  ],
  "tips": [
    "牛腩冷水下锅焯，血沫去净汤才清。",
    "全程小火保持微沸，肉才炖得软而不散。",
    "盐最后放，肉纤维才不会提前收紧。"
  ],
  "common_mistakes": [
    "大火滚炖两小时，肉散成碎渣汤也浑。",
    "土豆一开始就下锅，炖完全化在汤里。",
    "中途加冷水，肉紧缩变硬口感发柴。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛肋条",
      "ratio": "1000 克:1000 克",
      "note": "油花更多，撇油时多撇一遍。"
    },
    {
      "original": "芹菜",
      "substitute": "大葱",
      "ratio": "120 克:120 克",
      "note": "清甜更明显，炖制时间不变。"
    }
  ],
  "variations": [
    "加两片白葡萄酒同炖，香气更有层次。",
    "放一根迷迭香同炖，草本香气更浓。"
  ],
  "serving_suggestion": "肉和蔬菜一起上桌，汤另盛一碗撒盐单喝。",
  "storage": "冷藏两天，汤与肉分开保存更耐放。",
