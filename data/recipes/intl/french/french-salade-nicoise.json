    "砧板",
    "大碗",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小土豆洗净带皮放进冷水锅，加盐煮十五分钟到能插透。",
      "time_min": 8,
      "heat": "中火",
      "tip": "冷水下锅煮，土豆内部才熟得均匀。，注意火候。",
      "visual_cue": "筷子能插透，皮略开裂"
    },
    {
      "n": 2,
      "text": "捞出土豆晾到不烫手，剥皮后切成两半备用。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "趁温热剥皮最好剥，凉透就粘住了。，注意火候。",
      "visual_cue": "土豆完整，切面平整，状态稳定"
    },
    {
      "n": 3,
      "text": "另起锅烧水，放鸡蛋煮八分钟，捞出立刻过冷水。",
      "time_min": 8,
      "heat": "中火",
      "tip": "八分钟蛋黄刚凝，过冷水才好剥壳。，注意火候。",
      "visual_cue": "蛋壳易剥，蛋黄微溏，状态稳定"
    },
    {
      "n": 4,
      "text": "青豆下沸水焯两分钟，捞出过冷水保持翠绿。这一步不要着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "焯完过冷水，颜色才不发黄。，注意火候。",
      "visual_cue": "豆粒翠绿，口感脆嫩，状态稳定"
    },
    {
      "n": 5,
      "text": "橄榄油、柠檬汁、盐和黑胡椒在小碗里搅成油醋汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "边搅边淋油，汁才乳化不分层。，注意火候。",
      "visual_cue": "汁液微稠，颜色清亮，状态稳定"
    },
    {
      "n": 6,
      "text": "鸡蛋切四瓣，和土豆、番茄、青豆、洋葱丝一起摆进大碗。",
      "time_min": 5,
      "heat": "无火",
      "tip": "摆盘时颜色交错，看着更有食欲。，注意火候。",
      "visual_cue": "颜色分明，摆盘整齐，状态稳定"
    },
    {
      "n": 7,
      "text": "淋上油醋汁轻轻拌匀，静置五分钟让味道渗进去。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌完静置一会，土豆才吸得住酸香。，注意火候。",
      "visual_cue": "表面油亮，汁水微积，状态稳定"
    }
  ],
  "tips": [
    "土豆冷水下锅煮，中心才熟得均匀。，值得留意。",
    "鸡蛋煮好立刻过冷水，剥壳才完整。，值得留意。",
    "油醋汁现调现用，放久会分层。，值得留意。"
  ],
  "common_mistakes": [
    "土豆热水下锅，外面烂了里面还硬。，务必避免。",
    "鸡蛋煮过十分钟，蛋黄发灰带涩味。，务必避免。",
    "汁倒太早，蔬菜出水把味道冲淡。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "40 克:30 毫升",
      "note": "酸味更直接，可加少许白糖平衡。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "420 克:420 克",
      "note": "甜味更足，煮制时间减三分钟。"
    }
  ],
  "variations": [
    "加几片煎过的鱼柳，就是完整一餐。，也很受欢迎。",
    "撒一把黑橄榄，咸香更正宗。，也很受欢迎。"
  ],
  "serving_suggestion": "冷藏半小时后当开胃菜吃，配面包刚好。，效果更稳定。",
  "storage": "冷藏一天，汁水另装，食用前再拌。，效果更稳定。",
