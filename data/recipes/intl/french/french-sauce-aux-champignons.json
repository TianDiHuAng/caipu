    "刀",
    "砧板",
    "打蛋器",
    "筛子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "口蘑切片，用干锅小火煸到出水收干。，看准状态再往下做。",
      "time_min": 8,
      "heat": "小火",
      "tip": "先煸干水，蘑菇香才浓。，看准状态再往下做。",
      "visual_cue": "蘑菇收缩，锅底微焦"
    },
    {
      "n": 2,
      "text": "加黄油和洋葱碎，中火炒到洋葱透明。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "黄油别烧焦，颜色一变就下洋葱。，看准状态再往下做。",
      "visual_cue": "洋葱透明，油色金黄"
    },
    {
      "n": 3,
      "text": "加蒜末炒香，倒白葡萄酒煮到酒气散。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "酒气煮掉，酸味才不冲。，看准状态再往下做。",
      "visual_cue": "酒液减半，香气转甜"
    },
    {
      "n": 4,
      "text": "撒面粉快速拌匀，炒一分钟去生粉味。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面粉炒一下，酱才没有面粉味。，看准状态再往下做。",
      "visual_cue": "面糊结团，颜色微黄"
    },
    {
      "n": 5,
      "text": "分次加清水，边加边搅到顺滑无颗粒。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "水一次别倒完，搅开再加。，看准状态再往下做。",
      "visual_cue": "酱体顺滑，能挂勺，这一点很关键。"
    },
    {
      "n": 6,
      "text": "小火煮五分钟，让面粉完全糊化。，看准状态再往下做。",
      "time_min": 6,
      "heat": "小火",
      "tip": "煮到不再有生味才行。，看准状态再往下做。",
      "visual_cue": "酱面微沸，泡小密，这一点很关键。"
    },
    {
      "n": 7,
      "text": "倒入淡奶油搅匀，加盐和黑胡椒调味。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "奶油别煮沸，否则会分层。，看准状态再往下做。",
      "visual_cue": "酱体奶白，稠度适中"
    },
    {
      "n": 8,
      "text": "关火撒欧芹碎，配牛排或鸡肉上桌。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "欧芹最后放，颜色才翠。，看准状态再往下做。",
      "visual_cue": "绿点散布，光泽柔和"
    }
  ],
  "tips": [
    "蘑菇先煸干水，香气才浓。，这一点很关键。",
    "面粉要炒一下，去生粉味。，这一点很关键。",
    "奶油别煮沸，免得分层。，这一点很关键。"
  ],
  "common_mistakes": [
    "蘑菇不煸直接下锅，酱里全是水。，这一点很关键。",
    "面粉不炒，酱带生粉味。，这一点很关键。",
    "大火煮奶油，油水分离成渣。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "口蘑",
      "substitute": "香菇",
      "ratio": "300 克:300 克",
      "note": "香气更重，用量可减到二百五十克。"
    },
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "200 毫升:200 毫升",
      "note": "需多加十克面粉增稠。"
    }
  ],
  "variations": [
    "加一勺芥末，味道更醒。，这一点很关键。",
    "用红酒代替白葡萄酒，颜色更深。，这一点很关键。"
  ],
  "serving_suggestion": "配煎牛排、烤鸡或土豆泥。，这一点很关键。",
  "storage": "冷藏两天，复热小火加少量水。，这一点很关键。",
