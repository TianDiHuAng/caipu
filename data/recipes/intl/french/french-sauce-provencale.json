  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "木勺",
    "搅拌机"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄划十字用沸水烫半分钟，撕去外皮后切成大块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "去皮后酱体才细腻不挂皮按时间点检查，别凭感觉判断。",
      "visual_cue": "番茄块红润，皮全去掉"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油，下洋葱末小火炒五分钟至透明。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒透，酱底才有甜味发现不对劲就立刻转成小火。",
      "visual_cue": "洋葱末软塌泛黄，状态一眼可辨。"
    },
    {
      "n": 3,
      "text": "加大蒜末和百里香炒四十秒，让香气融进油里。",
      "time_min": 1,
      "heat": "小火",
      "tip": "干香草要用油煸一下才出味这一步宁可稳一点也不必图快。",
      "visual_cue": "油面浮香草碎，蒜香扑鼻"
    },
    {
      "n": 4,
      "text": "倒入番茄块转中火翻炒，加盐和白糖，煮到番茄塌软出水。",
      "time_min": 6,
      "heat": "中火",
      "tip": "糖只为提味，别放多火候和时间都要盯住，别走开。",
      "visual_cue": "番茄出红汁，块状开始塌"
    },
    {
      "n": 5,
      "text": "转小火熬十二分钟，中途搅两次防粘，熬到汁浓能挂勺。",
      "time_min": 12,
      "heat": "小火",
      "tip": "小火慢熬，急了会焦底发苦多做两次就能摸准手感。",
      "visual_cue": "汁体浓稠，勺背挂上一层"
    },
    {
      "n": 6,
      "text": "离火稍微放凉，用搅拌机打成顺滑的酱体再倒回锅里。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打之前先放凉，热气会让盖子崩开宁可分次操作，也别一次到底。",
      "visual_cue": "酱体细腻无颗粒，状态一眼可辨。"
    },
    {
      "n": 7,
      "text": "小火回温，撒黑胡椒和欧芹碎搅匀，尝味后补盐。",
      "time_min": 3,
      "heat": "小火",
      "tip": "欧芹最后放，颜色才绿锅里一有变化就调整火力。",
      "visual_cue": "酱色红亮，浮着绿点，变化看得很清楚。"
    }
  ],
  "tips": [
    "番茄必须去皮，酱才会顺滑备料提前摆好，做起来更顺手。",
    "干香草用油先煸，比直接煮香得多按时间点检查，别凭感觉判断。",
    "熬酱全程小火，急了就焦底发苦发现不对劲就立刻转成小火。",
    "欧芹离火再拌，颜色翠绿不发黄这一步宁可稳一点也不必图快。"
  ],
  "common_mistakes": [
    "番茄带皮下锅，打出来的酱满是碎皮。",
    "白糖下手太重，酱甜得像果酱，整锅料都白费了。",
    "大火猛熬不搅拌，锅底结一层焦，端上桌也没人愿意动筷。",
    "热酱直接倒进搅拌机，盖子被蒸汽顶开。"
  ],
  "substitutions": [
    {
      "original": "百里香",
      "substitute": "迷迭香",
      "ratio": "3克:2克",
      "note": "香气更冲，用量要减。"
    },
    {
      "original": "新鲜番茄",
      "substitute": "罐装去皮番茄",
      "ratio": "500克:400克",
      "note": "冬天更稳，熬的时间减三分钟。"
    }
  ],
  "variations": [
    "加一把黑橄榄同熬，咸鲜更突出，家里做也很方便。",
    "打酱前放两片烤过的彩椒，甜味更厚。",
    "不搅打做成带块版本，配煎蛋和烤面包都合适。"
  ],
  "serving_suggestion": "适合配煎鱼、烤鸡、煎蛋或水煮蔬菜，也可以当意面酱底，温热上桌风味最好。",
  "storage": "冷藏可放三天，冷冻可放一个月；复热时加一勺清水小火搅开。",
