  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "锅铲",
    "深锅",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐横刀片成两厘米厚的大片，用厨房纸把两面水分彻底吸干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "表面越干，下锅越不容易溅油火候和时间都要盯住，别走开。",
      "visual_cue": "豆腐片表面干爽不反光"
    },
    {
      "n": 2,
      "text": "平底锅倒一半橄榄油烧到微微冒烟，把嫩豆腐片逐片排进去。",
      "time_min": 3,
      "heat": "中火",
      "tip": "片与片之间留出空隙，别叠着放多做两次就能摸准手感。",
      "visual_cue": "油面泛细纹，豆腐边缘冒小泡"
    },
    {
      "n": 3,
      "text": "一面煎四分钟至金黄结壳，翻面再煎三分钟，盛出备用。",
      "time_min": 7,
      "heat": "中火",
      "tip": "只翻一次面，反复翻会把豆腐弄碎宁可分次操作，也别一次到底。",
      "visual_cue": "两面金黄，边角挺立，状态一眼可辨。"
    },
    {
      "n": 4,
      "text": "深锅倒剩下的橄榄油，下洋葱丝小火炒六分钟至透明微甜。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒到透明才有甜味，别炒上色锅里一有变化就调整火力。",
      "visual_cue": "洋葱软塌透明，锅底微甜香"
    },
    {
      "n": 5,
      "text": "下彩椒条和大蒜片转中火炒三分钟，炒到彩椒表皮起细泡。",
      "time_min": 3,
      "heat": "中火",
      "tip": "彩椒断生就好，炒久了会发黄备料提前摆好，做起来更顺手。",
      "visual_cue": "彩椒油亮，边缘略软，能明显看出差别。"
    },
    {
      "n": 6,
      "text": "放入番茄块和百里香炒五分钟，炒到番茄塌软出红汤。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄先炒出汁，汤汁才浓稠按时间点检查，别凭感觉判断。",
      "visual_cue": "番茄化开，锅里有红色汤汁"
    },
    {
      "n": 7,
      "text": "倒入高汤、盐和白糖煮开，把煎好的嫩豆腐片轻放进去小火炖八分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "下豆腐后别用勺搅，晃锅就好发现不对劲就立刻转成小火。",
      "visual_cue": "汤汁微沸，豆腐完整吸汁"
    },
    {
      "n": 8,
      "text": "开大火把汤汁收到略稠，撒黑胡椒和欧芹碎，连锅端上桌。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁时晃锅不搅拌，豆腐才不散这一步宁可稳一点也不必图快。",
      "visual_cue": "汤汁挂勺，表面油亮，变化看得很清楚。"
    }
  ],
  "tips": [
    "嫩豆腐一定要吸干水分，下锅才不炸油也不粘底。",
    "煎豆腐只翻一次面，翻得多必然碎在锅里。",
    "洋葱用小火炒到透明，甜味才出得来。",
    "收汁阶段晃锅代替搅拌，豆腐才能整片上桌。"
  ],
  "common_mistakes": [
    "豆腐没吸干就下锅，油溅得满灶台还粘底。",
    "煎的时候不停翻面，最后只剩一堆碎块。",
    "番茄没炒透就加汤，汤汁稀得像水，端上桌也没人愿意动筷。",
    "收汁用大火猛搅，豆腐全散在汤里，前面花的功夫全打了水漂。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "北豆腐",
      "ratio": "600克:600克",
      "note": "更耐炖，煎的时间各加一分钟。"
    },
    {
      "original": "彩椒",
      "substitute": "西葫芦",
      "ratio": "150克:150克",
      "note": "切片后炒两分钟即可，口感更软。"
    }
  ],
  "variations": [
    "最后打一只鸡蛋进去焖两分钟，汤汁更浓稠。",
    "加一小撮辣椒碎同炖，口味更接近巴斯克山区的家常做法。",
    "把嫩豆腐换成煎过的茄子片，做成全素版本。"
  ],
  "serving_suggestion": "盛在浅口盘里配切片法棍或白米饭，汤汁别收得太干，留一点拌饭最香。",
  "storage": "冷藏可放两天，复热用深锅小火加两勺高汤慢煨，微波会让豆腐出水变渣。",
