  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "苹果",
          "name_en": "apple",
          "amount": 900,
          "unit": "g",
          "note": "脆甜品种",
          "optional": false
        },
        {
          "name": "低筋面粉",
          "name_en": "cake flour",
          "amount": 200,
          "unit": "g",
          "note": "塔皮用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 130,
          "unit": "g",
          "note": "塔皮 80g、焦糖 50g",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "熬焦糖",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "塔皮用",
          "optional": false
        },
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 60,
          "unit": "ml",
          "note": "佐食",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "铸铁平底锅",
    "烤箱",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "低筋面粉 200g 加 2g 盐与 80g 冷黄油丁搓成粗砂状，加 40ml 冰水揉成团冷藏 30 分钟。",
      "time_min": 40,
      "heat": "无火",
      "tip": "黄油要冷，手温高了塔皮会硬。",
      "visual_cue": "面团成团不粘手、可擀开"
    },
    {
      "n": 2,
      "text": "苹果去皮去核切成四瓣，平底锅放 50g 黄油与 120g 白糖小火熬成琥珀色焦糖。",
      "time_min": 12,
      "heat": "小火",
      "tip": "糖色到浅琥珀就停，深了会发苦。",
      "visual_cue": "糖液冒泡转为琥珀色、有焦香"
    },
    {
      "n": 3,
      "text": "把苹果瓣切面朝下码入焦糖中，中火煎 8 分钟让底部充分吸糖。",
      "time_min": 10,
      "heat": "中火",
      "tip": "码得越紧，翻面后越漂亮。",
      "visual_cue": "苹果边缘变软、焦糖包裹均匀"
    },
    {
      "n": 4,
      "text": "塔皮擀成比锅口大 3cm 的圆片，盖在苹果上并把边缘塞进锅壁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边缘塞紧，烤时才不会缩回。",
      "visual_cue": "塔皮完全覆盖苹果、边缘贴合锅壁"
    },
    {
      "n": 5,
      "text": "表面扎几个小孔，放入 200℃ 烤箱烤 35 分钟至塔皮金黄酥脆。",
      "time_min": 37,
      "heat": "大火",
      "tip": "烤到塔皮鼓起呈深金色才够脆。",
      "visual_cue": "表皮金黄、轻敲有空响"
    },
    {
      "n": 6,
      "text": "出炉静置 5 分钟，用盘子盖住锅口迅速翻转，轻敲锅底脱模，旁边配 60ml 淡奶油佐食。",
      "time_min": 6,
      "heat": "无火",
      "tip": "太烫翻会流糖，太凉会粘锅。",
      "visual_cue": "苹果完整脱出、焦糖裹满表面"
    }
  ],
  "tips": [
    "苹果选脆甜品种，久煮不烂才成型。",
    "焦糖宁可浅一点，深了整只塔都苦。",
    "翻面要果断，犹豫会让焦糖粘锅。"
  ],
  "common_mistakes": [
    "塔皮揉过头起筋，烤完收缩又硬。",
    "焦糖熬成黑色，成品带明显苦味。",
    "苹果码得太松，翻面后散成一堆。"
  ],
  "substitutions": [
    {
      "original": "苹果",
      "substitute": "梨",
      "ratio": "900g 对 900g",
      "note": "梨更软，煎制时间减 2 分钟。"
    },
    {
      "original": "低筋面粉",
      "substitute": "中筋面粉",
      "ratio": "200g 对 200g",
      "note": "口感略韧，冷藏时间加 10 分钟。"
    }
  ],
  "variations": [
    "肉桂版：焦糖里加 3g 肉桂粉。",
    "咸焦糖版：焦糖中加 3g 海盐，甜咸更立体。"
  ],
  "serving_suggestion": "温热切块，配一勺淡奶油或香草冰淇淋。",
  "storage": "室温存 1 天，冷藏 3 天，复烤 8 分钟回脆。",
