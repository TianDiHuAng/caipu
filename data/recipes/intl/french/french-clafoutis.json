  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "苹果",
          "name_en": "apple",
          "amount": 3,
          "unit": "piece",
          "note": "脆甜品种，去皮切月牙片",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 3,
          "unit": "piece",
          "note": "常温回温",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "低筋面粉",
          "name_en": "cake flour",
          "amount": 80,
          "unit": "g",
          "note": "过筛",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 250,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "分次加入",
          "optional": false
        },
        {
          "name": "黄油",
