  "steps": [
    {
      "n": 1,
      "text": "大米用清水淘洗两遍，沥干后倒入汤锅。趁热操作更顺手。",
      "time_min": 6,
      "heat": "无火",
      "tip": "圆粒米淀粉多，煮出来才稠滑。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "米粒干净，锅底无水色泽分明状态稳定"
    },
    {
      "n": 2,
      "text": "加牛奶、桂皮与橙皮，中小火加热并不断搅拌至微沸。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "牛奶易糊底，全程必须不停搅。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "奶液微冒泡，米粒浮起"
    },
    {
      "n": 3,
      "text": "转最小火煮三十五分钟，每五分钟搅一次防粘底。",
      "time_min": 36,
      "heat": "小火",
      "tip": "小火慢煮，米粒才会开裂出淀粉。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "米粒开花，奶液明显变稠"
    },
    {
      "n": 4,
      "text": "加白糖与盐搅匀，再煮五分钟至糖完全融化。趁热操作更顺手。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖最后加，早加米粒不易煮软。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "糖融化，布丁浓稠挂铲"
    },
    {
      "n": 5,
      "text": "离火挑出桂皮与橙皮，拌入淡奶油搅匀。趁热操作更顺手。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶油离火后拌入，口感才顺滑。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "布丁细腻油润，颜色乳白"
    },
    {
      "n": 6,
      "text": "盛入小碗放凉，冷藏两小时后取出撒桂皮粉食用。",
      "time_min": 125,
      "heat": "无火",
      "tip": "冷藏定型后口感更像布丁。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "布丁凝固，表面平整色泽分明状态稳定"
    }
  ],
  "tips": [
    "用圆粒米，淀粉多口感才稠。火候与时间都要盯紧，宁可略短也别过头。",
    "全程搅拌，牛奶糊底就报废。做之前把料备齐，下锅后就没空切配了。",
    "糖最后加，米粒才煮得烂。这几步照顺序来，味道才会一层层叠上去。",
    "冷藏两小时定型，风味更融合。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "大火煮奶，锅底焦糊整锅带苦。结果往往一锅好料全被这一步毁掉。",
    "米没淘洗，布丁表面发灰。很多人就在这里翻车，出菜后才发现。",
    "糖一开始就加，米粒煮不软。账面上看是小疏忽，入口立刻能尝出来。",
    "煮好马上吃，稀得像粥。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "豆浆",
      "ratio": "900毫升:900毫升",
      "note": "更清爽，需多加十克糖。"
    },
    {
      "original": "桂皮",
      "substitute": "香草荚",
      "ratio": "1块:半根",
      "note": "香气更细腻。"
    }
  ],
  "variations": [
    "表面撒焦糖烤成焦糖米布丁。口味会更厚一些，适合重口的人。",
    "加一把葡萄干，口感更丰富。做法不复杂，家常灶台就能完成。",
    "加柠檬皮代替橙皮，香气更清。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "冷藏后盛在小碗里撒桂皮粉，勺子挖下去浓稠绵密，是法国孩子最爱的家常甜点。",
  "storage": "冷藏可放两天，表面盖保鲜膜防结皮；不宜冷冻。",
