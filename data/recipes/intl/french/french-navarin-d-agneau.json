  "equipment": [
    "炖锅",
    "刀",
    "砧板",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉块用盐和黑胡椒抹匀，薄薄裹一层面粉。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "裹粉能锁汁，汤也自然变稠。，看准状态再往下做。",
      "visual_cue": "肉块泛白，粉层均匀"
    },
    {
      "n": 2,
      "text": "炖锅倒植物油，中大火把羊肉煎到各面焦褐。，看准状态再往下做。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "别急着翻，上色才够香。，看准状态再往下做。",
      "visual_cue": "表面焦褐，锅底结膜"
    },
    {
      "n": 3,
      "text": "盛出羊肉，锅下洋葱和胡萝卜炒软。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蔬菜炒出甜味，汤底才厚。，看准状态再往下做。",
      "visual_cue": "洋葱透明，边缘微黄"
    },
    {
      "n": 4,
      "text": "加蒜末炒香，倒白葡萄酒煮到酒气散。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "酒气煮掉，只剩果香。，看准状态再往下做。",
      "visual_cue": "酒液减半，香气转甜"
    },
    {
      "n": 5,
      "text": "放回羊肉，加清水、番茄、百里香和月桂叶。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "液面刚没过肉块即可。，看准状态再往下做。",
      "visual_cue": "汤面翻滚，香草浮起"
    },
    {
      "n": 6,
      "text": "转小火盖锅炖四十分钟，中途撇一次浮油。，看准状态再往下做。",
      "time_min": 42,
      "heat": "小火",
      "tip": "撇掉浮油，汤才不腻。，看准状态再往下做。",
      "visual_cue": "汤面微沸，油花聚边"
    },
    {
      "n": 7,
      "text": "加土豆和胡萝卜段，再炖二十分钟。，看准状态再往下做。",
      "time_min": 22,
      "heat": "小火",
      "tip": "根茎后放，形状才完整。，看准状态再往下做。",
      "visual_cue": "土豆微软，边缘圆润"
    },
    {
      "n": 8,
      "text": "加豌豆煮五分钟，补盐调味。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "豌豆最后放，颜色才翠绿。，看准状态再往下做。",
      "visual_cue": "豌豆翠绿，汤体浓稠"
    },
    {
      "n": 9,
      "text": "关火静置五分钟，撇去表面浮油后上桌。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置一会，味道才融。，看准状态再往下做。",
      "visual_cue": "汤色深褐，油层清亮"
    }
  ],
  "tips": [
    "羊肉先煎上色，汤才够香。，这一点很关键。",
    "浮油要撇两次，汤才不腻。，这一点很关键。",
    "根茎后放，形状才不散。，这一点很关键。"
  ],
  "common_mistakes": [
    "羊肉不煎直接炖，味道发淡。，这一点很关键。",
    "大火滚煮，肉柴汤浑。，这一点很关键。",
    "豌豆一开始放，最后发黄。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "700 克:700 克",
      "note": "炖的时间加十分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "清水",
      "ratio": "150 毫升:150 毫升",
      "note": "少了果香，需多加香草。"
    }
  ],
  "variations": [
    "加一把四季豆，颜色更鲜。，这一点很关键。",
    "最后撒欧芹碎，香气更清。，这一点很关键。"
  ],
  "serving_suggestion": "配一片乡村面包，蘸汤吃。，这一点很关键。",
  "storage": "冷藏三天，复热小火慢炖。，这一点很关键。",
