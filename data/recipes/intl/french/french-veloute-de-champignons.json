  "steps": [
    {
      "n": 1,
      "text": "口蘑擦净切片，留出几片薄片最后装饰用。趁热操作更顺手。",
      "time_min": 10,
      "heat": "无火",
      "tip": "蘑菇别用水泡，擦净才不出水不寡淡。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "菇片干爽，切面平整色泽分明状态稳定"
    },
    {
      "n": 2,
      "text": "汤锅化黄油，下洋葱末与蒜末小火炒到透明。趁热操作更顺手。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒透汤才甜，不要炒上色。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "洋葱透明发软，香气散出"
    },
    {
      "n": 3,
      "text": "下口蘑片与百里香，中大火炒八分钟至出水再收干。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "炒到水汽收干，蘑菇味才浓缩。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "菇片缩水变褐，锅底无水"
    },
    {
      "n": 4,
      "text": "撒面粉翻炒一分钟至不见干粉，倒高汤搅匀煮开。",
      "time_min": 7,
      "heat": "中火",
      "tip": "面粉炒匀再倒汤，才不结面疙瘩。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "汤汁顺滑，无白色粉块"
    },
    {
      "n": 5,
      "text": "转小火煮十五分钟，挑出百里香，用搅拌机打成细腻糊状。",
      "time_min": 18,
      "heat": "小火",
      "tip": "打之前挑掉香料枝，口感才细。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汤糊细腻无颗粒色泽分明状态稳定"
    },
    {
      "n": 6,
      "text": "倒回锅中加淡奶油、盐与白胡椒小火加热，撒菇片装饰。",
      "time_min": 6,
      "heat": "小火",
      "tip": "奶油加入后别煮沸，微热即可。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "汤色奶白，表面淋奶油花纹"
    }
  ],
  "tips": [
    "蘑菇擦净别泡水，香气才不流失。火候与时间都要盯紧，宁可略短也别过头。",
    "炒到水汽收干再打，味道更浓。做之前把料备齐，下锅后就没空切配了。",
    "面粉炒匀再倒汤，防止结块。这几步照顺序来，味道才会一层层叠上去。",
    "奶油最后加，别煮到沸腾。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "蘑菇泡水后炒，汤淡如水。结果往往一锅好料全被这一步毁掉。",
    "直接倒汤再撒面粉，满锅疙瘩。很多人就在这里翻车，出菜后才发现。",
    "打得太稀，喝起来像蘑菇汤水。账面上看是小疏忽，入口立刻能尝出来。",
    "奶油大火煮沸，表面浮一层油。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "口蘑",
      "substitute": "牛肝菌",
      "ratio": "500克:250克",
      "note": "香气更野，泡发水可入汤。"
    },
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "100毫升:120毫升",
      "note": "更清淡，需多加面粉五克。"
    }
  ],
  "variations": [
    "加一小杯白葡萄酒同煮，酒香更足。口味会更厚一些，适合重口的人。",
    "加松露油几滴，香气更高级。做法不复杂，家常灶台就能完成。",
    "做成冷汤，夏天冷藏后食用。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "盛进浅汤碗，淋一圈淡奶油、撒几片煎菇片，配法棍切片，是法式餐前最经典的一碗。",
  "storage": "冷藏可放两天，复热小火加少量高汤搅匀；不宜冷冻，奶油会分离。",
