    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐与酵母拌匀，倒清水与三十毫升橄榄油揉成光滑面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团揉到能拉开薄膜，烤出来才蓬松。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "面团光滑有弹性，表面不粘"
    },
    {
      "n": 2,
      "text": "盖布发酵一小时，面团涨到两倍大。趁热操作更顺手。",
      "time_min": 62,
      "heat": "无火",
      "tip": "发酵到位，割口才会鼓起来。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "面团膨胀，指戳缓慢回弹"
    },
    {
      "n": 3,
      "text": "百里香、迷迭香与欧芹切碎，与余下橄榄油拌成香草油。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香草切得越碎，香气散得越匀。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "香草碎混在油里，颜色青绿"
    },
    {
      "n": 4,
      "text": "面团分成两份，擀成厚一厘米的椭圆叶形，表面刷香草油。",
      "time_min": 7,
      "heat": "无火",
      "tip": "厚薄均匀，割口才裂得漂亮。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "面坯椭圆，表面油光均匀"
    },
    {
      "n": 5,
      "text": "用刀在面坯上斜切几道口子，把切口向两侧拉开成叶脉状。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切口要切透，烤时才张开成叶子。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "切口张开，形似树叶脉络"
    },
    {
      "n": 6,
      "text": "烤箱预热二百二十度，撒少许盐后烤十八分钟至表面金黄。",
      "time_min": 20,
      "heat": "无火",
      "tip": "高温烤，外壳才脆、里面才松。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "表面金黄，切口张开酥脆"
    }
  ],
  "tips": [
    "面团偏软一点，成品才松软。火候与时间都要盯紧，宁可略短也别过头。",
    "香草油要刷匀，每个切口都沾到。做之前把料备齐，下锅后就没空切配了。",
    "切口切透拉成叶脉，造型才地道。这几步照顺序来，味道才会一层层叠上去。",
    "出炉趁热吃，凉了外壳发韧。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "面团太硬，切口张不开像块砖。结果往往一锅好料全被这一步毁掉。",
    "香草不切碎，烤完焦成黑点。很多人就在这里翻车，出菜后才发现。",
    "切口太浅，烤完看不见叶脉。账面上看是小疏忽，入口立刻能尝出来。",
    "温度不足，面包发白没脆壳。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "橄榄油",
      "substitute": "黄油",
      "ratio": "45毫升:45克",
      "note": "奶香更浓，风味不地道。"
    },
    {
      "original": "百里香",
      "substitute": "牛至",
      "ratio": "4克:4克",
      "note": "香气更浓，用量可减半。"
    }
  ],
  "variations": [
    "表面撒橄榄片，风味更普罗旺斯。口味会更厚一些，适合重口的人。",
    "加一点柠檬皮屑，香气更清爽。做法不复杂，家常灶台就能完成。",
    "做成小份，当餐前小食更合适。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "撕成小块趁热吃，外壳脆、里面软，香草和橄榄油的香气扑鼻，配一碗浓汤正好。",
  "storage": "密封常温放两天，回烤一百八十度三分钟；不建议冷藏。",
