  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 500,
          "unit": "ml",
          "note": "全脂牛奶",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 120,
          "unit": "g",
          "note": "擦成细丝",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 40,
          "unit": "g",
          "note": "做面糊",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 40,
          "unit": "g",
          "note": "等量配黄油",
          "optional": false
        },
        {
          "name": "肉豆蔻",
          "name_en": "nutmeg",
          "amount": 1,
          "unit": "g",
          "note": "现磨少量",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "白胡椒更好",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "打蛋器",
    "木勺",
    "擦丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "厚底锅小火融化黄油，倒进面粉用打蛋器不停搅成顺滑面糊。",
      "time_min": 5,
      "heat": "小火",
      "tip": "黄油和面粉一比一，稠度最稳定也不会结块。",
      "visual_cue": "糊体浅黄细腻，锅底没有白色颗粒"
    },
    {
      "n": 2,
      "text": "保持小火继续搅两分钟，让面糊的生面味完全散掉。",
      "time_min": 3,
      "heat": "小火",
      "tip": "这一步别省，生面味会一直留在最后的酱里。",
      "visual_cue": "糊体颜色略微加深，闻起来是奶香"
    },
    {
      "n": 3,
      "text": "牛奶分三次倒入，每次都搅到完全融合再加下一次。",
      "time_min": 8,
      "heat": "小火",
      "tip": "一次全倒进去必然结块，分次加才顺滑。",
      "visual_cue": "液体由稠转稀再变稠，表面没有疙瘩"
    },
    {
      "n": 4,
      "text": "酱汁煮到能挂勺背，加盐、黑胡椒与现磨肉豆蔻调味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "挂勺背时用指划一道，痕迹能留住就是好了。",
      "visual_cue": "勺子背面挂一层薄酱，划痕边缘清晰"
    },
    {
      "n": 5,
      "text": "关火后把奶酪丝分两次拌入，靠余温化开到完全顺滑。",
      "time_min": 4,
      "heat": "无火",
      "tip": "离火再下奶酪，煮开会让奶酪油脂分离发渣。",
      "visual_cue": "酱体呈淡金黄色，拉起有细长丝"
    },
    {
      "n": 6,
      "text": "趁热浇在水煮花椰菜、烤蔬菜或煎鱼排上，表面擦奶酪烤上色。",
      "time_min": 3,
      "heat": "无火",
      "tip": "这道酱凉了就凝住，一定要趁温热时使用。",
      "visual_cue": "酱面光亮，淋下时能自然摊平"
    }
  ],
  "tips": [
    "奶酪选味道浓一点的，用量可以减少一半。",
    "想要更稀的酱，牛奶多加五十毫升即可。",
    "做好的酱冷藏可存两天，复热时加一点牛奶调开。",
    "表面撒面包糠烤五分钟，就是简易的奶汁焗菜。"
  ],
  "common_mistakes": [
    "牛奶一次全倒进面糊，锅里立刻结成一片疙瘩。",
    "奶酪在沸腾状态下加入，酱体变粗糙还出油。",
    "面粉炒得不够，成品有明显的生面味。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "奶油奶酪",
      "ratio": "120克:120克",
      "note": "味道更柔和，咸度更低。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "500毫升:300毫升",
      "note": "需要再补两百毫升清水稀释。"
    }
  ],
  "variations": [
    "加一勺第戎芥末，酸香更明显，适合配鱼。",
    "加一把炒香的蘑菇片，做成蘑菇奶酪酱。"
  ],
  "serving_suggestion": "趁热浇在焗花椰菜、水煮青菜或煎鱼排上，表面擦奶酪烤到金黄。",
  "storage": "冷藏两天，冷冻会影响顺滑度，复热时用小火加少量牛奶搅开。",
