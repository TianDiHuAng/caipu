  "equipment": [
    "派盘",
    "擀面杖",
    "烤箱",
    "刀",
    "打蛋盆",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉与三克盐混匀，加入冷藏黄油丁，用指尖搓成粗砂状，看不到大块黄油即可。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，手温高的人可以把面粉先冷藏十分钟再操作。",
      "visual_cue": "面团呈粗砂粒状，无整块黄油"
    },
    {
      "n": 2,
      "text": "分次加冰镇清水，用刮刀切拌到能捏成团，压扁包好冷藏松弛三十分钟。",
      "time_min": 35,
      "heat": "无火",
      "tip": "清水不要一次加完，能成团就停，面团太湿烤完会回缩变形。",
      "visual_cue": "面团光滑不粘手，压成圆饼状"
    },
    {
      "n": 3,
      "text": "北豆腐用厨房纸包住压上重物，静置二十分钟逼出水分，再用手掰成小块。",
      "time_min": 22,
      "heat": "无火",
      "tip": "豆腐水压得越干，派馅越结实，不压会渗水泡软派皮。",
      "visual_cue": "豆腐明显收紧，纸巾吸满水"
    },
    {
      "n": 4,
      "text": "平底锅放橄榄油，中火炒洋葱丝到透明发甜，加蘑菇片炒到出水收干。",
      "time_min": 8,
      "heat": "中火",
      "tip": "蘑菇要炒到水分收干，湿的蘑菇会让馅料出水，派底发软。",
      "visual_cue": "蘑菇片体积缩小，锅底收干"
    },
    {
      "n": 5,
      "text": "豆腐块、鸡蛋、淡奶油、剩余盐、黑胡椒与肉豆蔻放进盆里，用手持打蛋器打成细腻糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打到没有颗粒才算好，豆腐渣会毁掉整块派的口感。",
      "visual_cue": "糊体细腻顺滑，无豆腐颗粒"
    },
    {
      "n": 6,
      "text": "把炒好的洋葱蘑菇拌进豆腐糊，尝一下咸淡，略咸一点刚好。",
      "time_min": 3,
      "heat": "无火",
      "tip": "派烤好后味道会被派皮稀释，馅料尝起来要稍咸。",
      "visual_cue": "馅料浓稠能挂勺，配料分布均匀"
    },
    {
      "n": 7,
      "text": "派皮擀成三毫米厚，铺进派盘，用叉子在底部戳密集小孔，边缘捏出花边。",
      "time_min": 10,
      "heat": "无火",
      "tip": "戳孔能让蒸汽跑掉，派底才不会鼓包。",
      "visual_cue": "派皮贴合盘壁，底部布满小孔"
    },
    {
      "n": 8,
      "text": "把馅料倒进派皮抹平表面，送进一百八十度烤箱烤三十五分钟。",
      "time_min": 35,
      "heat": "中火",
      "tip": "烤到轻晃派盘中心不流动才算熟，早了切开会是稀糊。",
      "visual_cue": "表面金黄，轻晃时中心稳固"
    },
    {
      "n": 9,
      "text": "出炉静置十分钟再脱模切块，配一小碟清口的小菜一起上桌。",
      "time_min": 12,
      "heat": "无火",
      "tip": "出炉静置能让馅料彻底定型，热切一定会塌成一片。",
      "visual_cue": "切面平整，馅料与派皮结合紧密"
    }
  ],
  "tips": [
    "豆腐选北豆腐，水分少结构紧，嫩豆腐做不了这道派。",
    "派皮可以一次做双份冷冻，用前回温十分钟就能擀。",
    "加一把炒过的菠菜或烤红椒，颜色和风味都更丰富。",
    "冷吃也很好，第二天切片当便当配菜。"
  ],
  "common_mistakes": [
    "豆腐不压水直接打糊，烤完派底一片湿软，切不成块。",
    "黄油软化后再搓面团，烤出来派皮硬如饼干底。",
    "派皮不戳孔直接烤，底部鼓起大包，馅料倒不平。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "老豆腐",
      "ratio": "400克:400克",
      "note": "压水时间延长五分钟，质地更粗需打更久。"
    },
    {
      "original": "淡奶油",
      "substitute": "无糖豆浆",
      "ratio": "120毫升:120毫升",
      "note": "口感更轻薄，需多加一勺面粉帮助定型。"
    }
  ],
  "variations": [
    "把豆腐糊加一勺番茄酱与牛至，做成普罗旺斯风味。",
    "顶部铺番茄片再烤，酸甜多汁，适合夏天。"
  ],
  "serving_suggestion": "切块配一碟凉拌黄瓜与油醋汁，作为早午餐主菜，冷热皆可。",
  "storage": "冷藏三天内吃完，复热用一百六十度烤箱烤十分钟；不建议冷冻，派皮会变软。",
