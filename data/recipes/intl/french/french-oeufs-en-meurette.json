  "equipment": [
    "炖锅",
    "小碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "培根切一指宽的条，洋葱切细丁，蒜切末，百里香摘下叶子备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "洋葱切得越细，融进汁里的速度越快。",
      "visual_cue": "丁粒细匀，大小一致，锅里状态一目了然。"
    },
    {
      "n": 2,
      "text": "炖锅小火煸培根四分钟出油，加洋葱丁和蒜末炒五分钟至透明。",
      "time_min": 10,
      "heat": "小火",
      "tip": "用培根的油炒洋葱，底味更厚。火候和顺序都要留神，别图快。",
      "visual_cue": "洋葱透明，锅底见油，颜色和形态变化清楚。"
    },
    {
      "n": 3,
      "text": "撒入面粉炒一分钟去掉生面味，倒入红葡萄酒和百里香，中火煮开。",
      "time_min": 6,
      "heat": "中火",
      "tip": "面粉要炒到看不出白点再倒酒。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "汁体微稠，无白色块，锅里状态一目了然。"
    },
    {
      "n": 4,
      "text": "转小火炖十二分钟，把酒汁收到原来一半，加盐和黑胡椒调味。",
      "time_min": 13,
      "heat": "小火",
      "tip": "收汁到位，酱汁才挂得住蛋。这一步别省，成品口感差别很明显。",
      "visual_cue": "汤汁浓亮，能挂勺，颜色和形态变化清楚。"
    },
    {
      "n": 5,
      "text": "把鸡蛋逐个打进小碗，轻轻滑进微沸的汁里，盖盖小火焖四分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "汁面只冒小泡，蛋才完整不散。火候和顺序都要留神，别图快。",
      "visual_cue": "蛋白凝固，蛋黄微软，锅里状态一目了然。"
    },
    {
      "n": 6,
      "text": "用漏勺舀出鸡蛋装盘，酱汁里拌入黄油搅匀，浇在蛋上撒百里香。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄油离火拌入，酱汁才亮不油水分离。",
      "visual_cue": "酱汁油亮，表面无油花"
    }
  ],
  "tips": [
    "红酒先大火收掉一半再炖，酸味变柔和，酱汁才不冲口。",
    "鸡蛋先打进小碗再滑入锅中，蛋黄才不会散。",
    "汤汁保持微沸不滚，翻滚会把蛋冲散成絮。"
  ],
  "common_mistakes": [
    "红酒直接下锅炖，酱汁又酸又涩，蛋完全被压住。",
    "水大开时下蛋，蛋白瞬间被冲散，锅里只剩白絮和蛋黄。",
    "鸡蛋煮过头，蛋黄全凝固成粉状，失去流心的口感。"
  ],
  "substitutions": [
    {
      "original": "红葡萄酒",
      "substitute": "蘑菇高汤",
      "ratio": "250毫升:250毫升",
      "note": "无酒版，须加一勺醋补酸味。"
    },
    {
      "original": "培根",
      "substitute": "五花肉",
      "ratio": "80克:80克",
      "note": "脂肪更多，黄油可减十克。"
    }
  ],
  "variations": [
    "加几片煎香的蘑菇同炖，菌香和酒香叠在一起，更像勃艮第的乡村做法。",
    "把蛋换成水波蛋放在烤面包上，浇汁做成早午餐版，卖相更利落。"
  ],
  "serving_suggestion": "每盘放两枚蛋，浇上红酒酱汁，撒百里香，配煎土豆块和一杯同款干红上桌。",
  "storage": "酱汁可冷藏两天，鸡蛋须现煮现吃，回热会让蛋黄变硬，不建议二次加热。",
