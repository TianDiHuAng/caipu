  "equipment": [
    "厚底汤锅",
    "木勺",
    "烤面包机",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "培根切成手指宽的粗条，厚底锅不放油直接下培根，小火煸出油脂。",
      "time_min": 8,
      "heat": "小火",
      "tip": "培根冷锅下才出得透油，热锅下去外面焦了里面还是白的。",
      "visual_cue": "培根卷边出油，锅底一层亮油"
    },
    {
      "n": 2,
      "text": "培根捞出留用，原油下洋葱丁与大蒜，淋入橄榄油，小火炒到洋葱透明发甜。",
      "time_min": 6,
      "heat": "小火",
      "tip": "用培根留下的油再加橄榄油炒洋葱，汤的底味才厚，另起油锅就散了。",
      "visual_cue": "洋葱透明发软，香气浓"
    },
    {
      "n": 3,
      "text": "卷心菜切大块洗净，下锅翻炒到叶片塌软、边缘略透。",
      "time_min": 5,
      "heat": "中火",
      "tip": "菜叶先炒过再煮，涩味跑掉，汤喝着清甜不冲。",
      "visual_cue": "菜叶塌软，体积缩掉一半"
    },
    {
      "n": 4,
      "text": "倒入高汤与土豆块，放回培根，大火烧开后转小火慢炖三十分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "小火慢煨汤才清亮，滚得太猛土豆散在汤里，汤会变浑发糊。",
      "visual_cue": "土豆块边缘发圆，汤色微黄"
    },
    {
      "n": 5,
      "text": "用勺背压碎两块土豆让汤略稠，加盐与白胡椒调味，撒欧芹碎。",
      "time_min": 5,
      "heat": "小火",
      "tip": "压碎土豆比另调稠汁自然，汤稠得柔和，凉了也不会结块。",
      "visual_cue": "汤汁微稠挂勺，菜块完整"
    },
    {
      "n": 6,
      "text": "面包片烤到两面微焦，摆在汤面上或另装一碟配着吃。",
      "time_min": 6,
      "heat": "中火",
      "tip": "面包烤脆一点，泡进汤里才不散，咬着还有焦香。",
      "visual_cue": "面包两面金黄，边缘酥脆"
    }
  ],
  "tips": [
    "这道汤在法国西南部是一锅到底的农家菜，隔夜再热更入味。",
    "想吃扎实一点可以加一只油封鸭腿同炖，风味立刻变得厚重。",
    "汤面上浮的油别撇掉，那是培根的香气，撇了汤就寡淡。"
  ],
  "common_mistakes": [
    "大火滚煮全程不收火，土豆煮成糊，汤浑得像浆糊。",
    "卷心菜煮过头，菜叶发黄发烂，汤里一股闷味。",
    "盐在炖之前就放足，炖到后面汤收浓，咸得下不了口。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "腊肉",
      "ratio": "120克:120克",
      "note": "腊肉咸味重，盐减到一克。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "1200毫升:1200毫升",
      "note": "清水版需补三克盐与一小块培根增鲜。"
    }
  ],
  "variations": [
    "加一把白豆同炖，汤更绵密，是比利牛斯山区的做法。",
    "把面包片铺在碗底再浇汤，做成泡汤吃的乡村版本。"
  ],
  "serving_suggestion": "盛进厚壁汤碗，配烤面包片和一杯干白，冬天喝最暖胃。",
  "storage": "冷藏可存三天，冷冻一个月；复热时补少量高汤，避免越热越咸。",
