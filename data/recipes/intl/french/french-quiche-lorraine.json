  "equipment": [
    "派盘",
    "擀面杖",
    "打蛋器",
    "烤箱",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "冷黄油切小块与面粉、少许盐搓成粗砂状，加两勺冰水揉成团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "黄油要保持冷，手温一化派皮就发硬。",
      "visual_cue": "面团成团不粘手，能按出指印"
    },
    {
      "n": 2,
      "text": "面团压扁包保鲜膜冷藏松弛三十分钟，让面筋充分放松。",
      "time_min": 30,
      "heat": "无火",
      "tip": "不松弛就擀，烤时派皮会回缩变形。",
      "visual_cue": "面团变硬，按压不易变形"
    },
    {
      "n": 3,
      "text": "面团擀成三毫米厚的圆片铺入派盘，压掉边缘多余部分并用叉子扎孔。",
      "time_min": 10,
      "heat": "无火",
      "tip": "扎孔是为了排气，避免烤时鼓起大泡。",
      "visual_cue": "派皮贴住盘壁，底部孔洞均匀"
    },
    {
      "n": 4,
      "text": "派皮上铺一层油纸压重物，一百八十度盲烤十五分钟至边缘定型。",
      "time_min": 15,
      "heat": "无火",
      "tip": "压重物能防底部鼓起，米或豆子都行。",
      "visual_cue": "派皮边缘微黄，底部干爽"
    },
    {
      "n": 5,
      "text": "培根与洋葱末小火煸炒到洋葱透明、培根出油，铺在派皮底部。",
      "time_min": 8,
      "heat": "小火",
      "tip": "炒出的油要沥掉，否则派底会湿软。",
      "visual_cue": "培根微卷，洋葱透明"
    },
    {
      "n": 6,
      "text": "鸡蛋打散加奶油、牛奶、盐、黑胡椒与肉豆蔻粉搅匀后过筛。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蛋液过筛去掉气泡和系带，成品才细腻。",
      "visual_cue": "蛋液顺滑无泡沫，倒出时呈细线"
    },
    {
      "n": 7,
      "text": "蛋液倒入派皮撒上奶酪丝，一百七十度烤三十分钟至中心凝固。",
      "time_min": 30,
      "heat": "无火",
      "tip": "轻晃派盘中心微微颤动即可出炉，烤过头会出水。",
      "visual_cue": "表面金黄，中心不再流动"
    },
    {
      "n": 8,
      "text": "出炉放置十分钟稍凉后脱模切块，配一份绿叶沙拉上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "凉一点再切，切面才平整不塌。",
      "visual_cue": "切面细腻，蛋奶馅无孔洞"
    }
  ],
  "tips": [
    "派皮黄油一定要冷，搓砂时动作快，别让它被手温融化。",
    "蛋液过筛一次，烤出的馅心才光滑如布丁。",
    "咸派温热吃风味最好，冷藏后需复烤回温。"
  ],
  "common_mistakes": [
    "派皮没冷藏松弛就擀开，烤后收缩变形、边缘塌陷。",
    "蛋液倒得太满，烤时膨胀溢出糊在盘边。",
    "烤到表面焦黄就急着出炉，中心其实还是液态。"
  ],
  "substitutions": [
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "150 克:130 克",
      "note": "咸度更高，蛋液里的盐减到三克。"
    },
    {
      "original": "奶油",
      "substitute": "牛奶",
      "ratio": "200 毫升:200 毫升",
      "note": "口感更轻盈，烤制时间缩短五分钟。"
    }
  ],
  "variations": [
    "加一把炒软的菠菜或口蘑，做成蔬菜版咸派。",
    "表面撒少许百里香，香气更接近南法乡村风味。"
  ],
  "serving_suggestion": "切块温热食用，配一份油醋绿叶沙拉平衡油脂。",
  "storage": "冷藏三天、冷冻一个月；复烤一百六十度十分钟即可恢复酥皮。",
