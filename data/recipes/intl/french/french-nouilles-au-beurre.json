  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面条",
          "name_en": "wheat noodles",
          "amount": 250,
          "unit": "g",
          "note": "细扁面条",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 40,
          "unit": "g",
          "note": "分成小块",
          "optional": false
        },
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 30,
          "unit": "g",
          "note": "擦成细丝",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "煮面用",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 8,
          "unit": "g",
          "note": "切碎点缀",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "平底锅",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅烧开两升水，加四分之一的盐，把面条下锅并轻轻拨散。",
      "time_min": 4,
      "heat": "大火",
      "tip": "水要宽，面下去才不粘连，盐别省，这是面条唯一的底味来源。",
      "visual_cue": "水面翻滚沸腾，面条根根分散不粘。"
    },
    {
      "n": 2,
      "text": "按包装时间煮八分钟，途中尝一根，中心没有白芯就捞出。",
      "time_min": 9,
      "heat": "大火",
      "tip": "按包装时间再减一分钟，捞出时中心留一点点白芯刚刚好。",
      "visual_cue": "面条透亮饱满，咬开中心没有白芯。"
    },
    {
      "n": 3,
      "text": "舀出半碗煮面的热水备用，面条用夹子捞起稍微沥干水。",
      "time_min": 2,
      "heat": "无火",
      "tip": "千万别过冷水，面条一凉黄油就挂不住，拌出来发涩。",
      "visual_cue": "面条湿润有热气，表面不粘手。"
    },
    {
      "n": 4,
      "text": "平底锅小火化开一半黄油，倒入面条用夹子翻拌一分钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油只化不烧，一旦冒泡发褐就带焦味，会压掉奶香。",
      "visual_cue": "黄油化成金黄液体，面条裹上油光。"
    },
    {
      "n": 5,
      "text": "分两次淋入煮面热水，每次两勺，边加边拌到面条表面起薄浆。",
      "time_min": 3,
      "heat": "小火",
      "tip": "热水一次只加两勺，边加边拌，稠度要看着来别一次倒多。",
      "visual_cue": "酱汁薄亮挂在面上，不往盘底流。"
    },
    {
      "n": 6,
      "text": "关火拌入剩下的黄油和奶酪丝，撒盐、黑胡椒和香菜碎装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "离火再拌奶酪，锅还热着拌会结块，表面也会起一层皮。",
      "visual_cue": "面条油亮，奶酪丝拉出细长的丝。"
    }
  ],
  "tips": [
    "煮面的水里要放足盐，面条本身才有底味，不寡淡。",
    "黄油分两次加，先化一半拌面，起锅再补一半更香。",
    "留半碗煮面水，拌的时候分次加，酱汁才挂得住。"
  ],
  "common_mistakes": [
    "面条煮过头还泡在汤里，捞出来软塌塌一夹就断。",
    "黄油烧到冒泡发褐才下面条，一股焦味压过奶香。",
    "拌的时候不加水，奶酪结成硬块裹不匀，口感发干。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "帕玛森干酪",
      "ratio": "30克:28克",
      "note": "咸度更高，盐可减一克。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "40克:32毫升",
      "note": "奶香变淡，适合配海鲜。"
    }
  ],
  "variations": [
    "打一个生蛋黄在碗里先和面条拌匀，再淋黄油，酱体更浓更滑。",
    "撒一把炒香的蘑菇片同拌，菌香和黄油的奶味叠在一起，很适合冷天。"
  ],
  "serving_suggestion": "趁热装盘，表面再擦一层奶酪丝，撒黑胡椒和香菜碎，配一杯白葡萄酒。",
  "storage": "现拌现吃最好，冷藏可放一天，回锅前加一勺清水小火翻热恢复滑润。",
