      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 260,
          "unit": "g",
          "note": "过筛",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 200,
          "unit": "g",
          "note": "打散",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 420,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 45,
          "unit": "g",
          "note": "融化",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 55,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 15,
          "unit": "ml",
          "note": "刷锅",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "打蛋器",
    "大碗",
    "滤网",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉过筛进大碗，加白糖和盐搅匀后在中间挖一个小坑。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛后不容易结块，面糊才细腻。，注意火候。",
      "visual_cue": "粉质松散，无颗粒，状态稳定"
    },
    {
      "n": 2,
      "text": "鸡蛋打散倒进坑里，用打蛋器从中间慢慢往外搅成稠糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "从中间搅起，粉才一点点吃进蛋液。，注意火候。",
      "visual_cue": "糊体稠厚，无干粉，状态稳定"
    },
    {
      "n": 3,
      "text": "牛奶分三次倒入，每次都搅到完全吸收再加下一次。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一次倒完容易结块，分次才顺滑。，注意火候。",
      "visual_cue": "糊体流动，颜色奶黄，状态稳定"
    },
    {
      "n": 4,
      "text": "加入融化黄油搅匀，面糊过筛后静置三十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "静置让面粉吸足水，煎的时候才不破。",
      "visual_cue": "面糊细腻，表面有泡，状态稳定"
    },
    {
      "n": 5,
      "text": "平底锅刷薄薄一层植物油，中小火烧热后舀一勺面糊。",
      "time_min": 4,
      "heat": "中火",
      "tip": "锅热但别冒烟，太热面糊立刻定型摊不开。",
      "visual_cue": "锅面油亮，面糊流动，状态稳定"
    },
    {
      "n": 6,
      "text": "转动锅子让面糊摊成薄圆片，煎一分半钟到边缘微翘。",
      "time_min": 3,
      "heat": "中火",
      "tip": "转锅要快，趁面糊没定型前摊满。，注意火候。",
      "visual_cue": "薄片均匀，边缘翘起，状态稳定"
    },
    {
      "n": 7,
      "text": "翻面再煎四十秒，出锅叠放保温，重复煎完所有面糊。",
      "time_min": 6,
      "heat": "中火",
      "tip": "第二面时间短，颜色浅才够柔软。，注意火候。",
      "visual_cue": "两面微黄，质地柔软，状态稳定"
    },
    {
      "n": 8,
      "text": "按喜好撒白糖或抹果酱，对折成三角后装盘。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热折起来，饼皮才不裂。，注意火候。",
      "visual_cue": "折叠整齐，表面细滑，状态稳定"
    }
  ],
  "tips": [
    "面糊过筛静置半小时，煎出来才不破。，值得留意。",
    "锅只刷薄油，油多会煎出脆边发硬。，值得留意。",
    "第二面时间要短，颜色浅才柔软。，值得留意。"
  ],
  "common_mistakes": [
    "面糊不静置就下锅，饼皮一摊就裂。，务必避免。",
    "火太大下糊，边缘立刻焦黑。，务必避免。",
    "油刷太多，成品硬得像饼干。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "豆奶",
      "ratio": "420 毫升:420 毫升",
      "note": "豆香明显，适合不吃乳制品的人。"
    },
    {
      "original": "面粉",
      "substitute": "荞麦粉",
      "ratio": "260 克:260 克",
      "note": "风味更浓，适合做咸味版本。"
    }
  ],
  "variations": [
    "抹上榛子酱和香蕉片，做成甜味卷。，也很受欢迎。",
    "咸味版夹火腿和奶酪，煎到奶酪融化。，也很受欢迎。"
  ],
  "serving_suggestion": "撒白糖趁热吃，也可以摆一盘水果一起上桌。",
  "storage": "冷藏一天，复热用平底锅小火两面各烘二十秒。",
