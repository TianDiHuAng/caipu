  "equipment": [
    "深锅",
    "平底锅",
    "刀",
    "砧板",
    "漏勺",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蘑菇擦净后切成两毫米薄片，洋葱和大蒜分别切成细末。",
      "time_min": 6,
      "heat": "无火",
      "tip": "片子切得薄，才挂得住酱汁锅里一有变化就调整火力。",
      "visual_cue": "蘑菇片薄而完整，末料细匀"
    },
    {
      "n": 2,
      "text": "深锅烧开一大锅水加盐，下意大利面按包装煮八分钟。",
      "time_min": 10,
      "heat": "大火",
      "tip": "面煮到略硬就捞，后面还要进酱锅备料提前摆好，做起来更顺手。",
      "visual_cue": "意大利面散开，水面翻滚，能明显看出差别。"
    },
    {
      "n": 3,
      "text": "平底锅化开黄油，下蘑菇片中大火煎三分钟至边缘焦黄。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "锅要够热，蘑菇才煎香不出水按时间点检查，别凭感觉判断。",
      "visual_cue": "蘑菇片边缘卷起，色转金黄"
    },
    {
      "n": 4,
      "text": "加洋葱末和大蒜末转小火炒两分钟，炒出甜香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末最后三十秒下，香气最足发现不对劲就立刻转成小火。",
      "visual_cue": "洋葱透明，蒜香柔和，状态一眼可辨。"
    },
    {
      "n": 5,
      "text": "倒入淡奶油小火煮开，加盐和黑胡椒调成浓酱。",
      "time_min": 3,
      "heat": "小火",
      "tip": "奶油别大火滚，容易油水分离这一步宁可稳一点也不必图快。",
      "visual_cue": "酱汁微沸，能挂住勺背"
    },
    {
      "n": 6,
      "text": "意大利面捞进酱锅，留两勺煮面水一起拌，翻匀让酱裹住每根面。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "煮面水里析出的糊化物质能让酱汁更贴面，火候和时间都要盯住。",
      "visual_cue": "意大利面泛白亮，酱不流散"
    },
    {
      "n": 7,
      "text": "关火撒奶酪丝拌匀，装盘后再撒欧芹碎和黑胡椒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火撒奶酪，才不会结块拉丝多做两次就能摸准手感。",
      "visual_cue": "奶酪化开成丝，表面绿点均匀"
    }
  ],
  "tips": [
    "蘑菇切薄片更容易挂酱，煎的时候也熟得快。",
    "奶油全程小火，滚得太猛会油水分离。",
    "拌面记得留两勺煮面水，酱才裹得紧。",
    "奶酪关火再撒，温度太高会结成疙瘩。"
  ],
  "common_mistakes": [
    "蘑菇切得又厚又大，煎完还是水汪汪。",
    "奶油大火滚煮，酱汁分成油和水两层。",
    "面煮到全软再捞，进锅一拌就断，只能重做一遍。",
    "奶酪和意大利面一起下锅煮，全部结成块。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "奶油",
      "ratio": "150毫升:150毫升",
      "note": "更浓稠，可少放五克奶酪。"
    },
    {
      "original": "意大利面",
      "substitute": "通心粉",
      "ratio": "300克:300克",
      "note": "酱会藏进管里，口感更厚。"
    }
  ],
  "variations": [
    "加两片煎过的培根同炒，咸香更重，值得一试。",
    "把蘑菇换成口蘑和杏鲍菇各半，口感更有层次。",
    "表面撒面包糠进烤箱烤三分钟，多一层脆壳。"
  ],
  "serving_suggestion": "盛进温热的深盘，趁热用叉子卷起面卷，配一小碟酸黄瓜解腻。",
  "storage": "冷藏可放两天，复热时加两勺牛奶小火拌开，微波加热会让奶油析出。",
