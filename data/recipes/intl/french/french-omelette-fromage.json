  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 5,
          "unit": "piece",
          "note": "室温",
          "optional": false
        },
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 60,
          "unit": "g",
          "note": "擦成细丝",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 8,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "煎蛋用",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 20,
          "unit": "ml",
          "note": "稀释蛋液",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "打蛋器",
    "碗",
    "锅铲",
    "擦丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进碗里，加牛奶、盐和白胡椒，用打蛋器搅到完全均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "搅到蛋液无丝状蛋白，口感才嫩发现不对劲就立刻转成小火。",
      "visual_cue": "蛋液匀滑，表面有细泡"
    },
    {
      "n": 2,
      "text": "平底锅中小火化开黄油，让油均匀铺满锅底发现不对劲就立刻转成小火。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "黄油起细泡但别变褐，火大了会苦这一步宁可稳一点也不必图快。",
      "visual_cue": "锅底一层黄油，泛细泡"
    },
    {
      "n": 3,
      "text": "倒入蛋液，静置十秒等底部定型，再用锅铲从边缘往里推。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "推的时候要轻，让生蛋液流到锅底火候和时间都要盯住，别走开。",
      "visual_cue": "蛋皮起皱，表面还有湿润层"
    },
    {
      "n": 4,
      "text": "趁表面还湿润时均匀撒上奶酪丝，让余温把奶酪化开。",
      "time_min": 1,
      "heat": "小火",
      "tip": "奶酪撒早会沉底粘锅多做两次就能摸准手感。",
      "visual_cue": "奶酪丝铺满，边缘开始融化"
    },
    {
      "n": 5,
      "text": "把蛋皮对折成半月形，用锅铲轻压定型，两面各煎二十秒。",
      "time_min": 2,
      "heat": "小火",
      "tip": "对折后别压太重，保留蓬松感宁可分次操作，也别一次到底。",
      "visual_cue": "蛋卷鼓起，表面无流动蛋液"
    },
    {
      "n": 6,
      "text": "滑进盘中，撒欧芹碎，趁热切开时奶酪还能拉出丝。",
      "time_min": 1,
      "heat": "无火",
      "tip": "出锅就要上桌，放凉奶酪会凝住锅里一有变化就调整火力。",
      "visual_cue": "切面蛋体嫩滑，奶酪流动"
    }
  ],
  "tips": [
    "蛋液要搅到看不见蛋白丝，蛋卷才细腻。",
    "全程中小火，火大蛋皮立刻起硬壳发现不对劲就立刻转成小火。",
    "奶酪在蛋液还湿时撒，靠余温化开最匀。",
    "出锅立刻吃，凉了奶酪会重新凝硬火候和时间都要盯住，别走开。"
  ],
  "common_mistakes": [
    "蛋液没打匀就下锅，蛋卷里全是一条条蛋白。",
    "大火煎蛋，底面焦褐上面还是生的，端上桌也没人愿意动筷。",
    "奶酪一开始就下锅，全粘在锅底，前面花的功夫全打了水漂。",
    "煎好放着拍照，回桌已经凉透凝住，最后只能倒掉重来。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "帕玛森",
      "ratio": "60克:50克",
      "note": "咸味重，盐减到一克。"
    },
    {
      "original": "牛奶",
      "substitute": "奶油",
      "ratio": "20毫升:20毫升",
      "note": "蛋卷更厚实，煎的时间加二十秒。"
    }
  ],
  "variations": [
    "加一把切碎的蘑菇同煎，做成蘑菇奶酪蛋卷。",
    "蛋液里拌入切碎的欧芹，颜色和香气都更足。",
    "表面淋一勺番茄香草汁，酸味能解奶酪的腻。"
  ],
  "serving_suggestion": "配一片烤过的法棍和一小份生菜沙拉，早餐或轻晚餐都合适，旁边放一杯热咖啡。",
  "storage": "现做现吃最好，冷藏不超过一天，复热用平底锅小火每面二十秒，微波会让蛋体发硬。",
