      ]
    }
  ],
  "equipment": [
    "小锅",
    "打蛋器",
    "刀",
    "砧板",
    "细筛",
    "隔热碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油从冷藏取出切成两厘米小块，切好马上放回冰箱保持低温。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油越冷，乳化越稳备料提前摆好，做起来更顺手。",
      "visual_cue": "小块整齐，摸起来冰凉"
    },
    {
      "n": 2,
      "text": "小锅里放洋葱末、白葡萄酒和白醋，小火慢收八分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "收到只剩两勺液体就够，别收干按时间点检查，别凭感觉判断。",
      "visual_cue": "液体降到锅底薄薄一层"
    },
    {
      "n": 3,
      "text": "用细筛把收好的汁滤进隔热碗，压出洋葱末里的汁水。",
      "time_min": 3,
      "heat": "无火",
      "tip": "滤掉洋葱末，酱才细腻发现不对劲就立刻转成小火。",
      "visual_cue": "碗里得到清亮淡黄的汁"
    },
    {
      "n": 4,
      "text": "隔热碗坐在温水锅上，保持水温不烫手，分三次加入黄油块。",
      "time_min": 4,
      "heat": "小火",
      "tip": "水温过高黄油会化成分离的油这一步宁可稳一点也不必图快。",
      "visual_cue": "黄油慢慢融开，汁变稠"
    },
    {
      "n": 5,
      "text": "用打蛋器不停画圈搅打，让黄油一点点吃进汁里乳化。",
      "time_min": 5,
      "heat": "小火",
      "tip": "加黄油要慢，一次一块搅匀再加火候和时间都要盯住，别走开。",
      "visual_cue": "汁体浓稠发亮，质地如浓稠乳脂"
    },
    {
      "n": 6,
      "text": "加盐和白胡椒调味，尝一下应是酸香带黄油厚味。",
      "time_min": 1,
      "heat": "无火",
      "tip": "咸味要轻，配鱼时才不抢味多做两次就能摸准手感。",
      "visual_cue": "味道酸香平衡，无生酒味"
    },
    {
      "n": 7,
      "text": "碗离火，用勺撇掉表面的浮沫，趁温热立刻上桌配菜。",
      "time_min": 2,
      "heat": "无火",
      "tip": "离火后别放凉，凉了会凝住宁可分次操作，也别一次到底。",
      "visual_cue": "表面光滑，无气泡无浮沫"
    }
  ],
  "tips": [
    "黄油必须冷着切、冷着加，乳化才稳。",
    "水温控制在手能放进去的程度，太烫必分离。",
    "黄油一次只加一块，搅匀了再加下一块。",
    "做好立刻上桌，凉了会凝成固体发现不对劲就立刻转成小火。"
  ],
  "common_mistakes": [
    "黄油室温软化后一次全倒进去，汁立刻分离成油花。",
    "隔热碗下的水烧到大滚，黄油直接化成清油。",
    "收汁收得太干，锅底焦苦，酱全毁，整锅料都白费了。",
    "做好放着等菜，端上桌已经凝成一块。"
  ],
  "substitutions": [
    {
      "original": "白葡萄酒",
      "substitute": "白醋",
      "ratio": "80毫升:60毫升",
      "note": "酸味更冲，需多加十克黄油平衡。"
    },
    {
      "original": "洋葱",
      "substitute": "小葱",
      "ratio": "40克:30克",
      "note": "香气更清，收汁时间减两分钟。"
    }
  ],
  "variations": [
    "加一勺淡奶油打底，乳化更稳，适合新手。",
    "收汁时放几粒黑胡椒碎，做成带辛香的版本。",
    "把白葡萄酒换成干型苹果酒，果香更明显。"
  ],
  "serving_suggestion": "最适合配煎鱼排、水煮芦笋或白灼虾，酱要温热现做现用，盘边配一片柠檬。",
  "storage": "不建议冷藏保存，乳化酱复热必分离；若有多余可冷藏做黄油炒菜用，两天内用完。",
