  "equipment": [
    "平底锅",
    "深锅",
    "漏勺",
    "刀",
    "砧板",
    "夹子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊从冰箱取出放室温二十分钟，表面用厨房纸彻底吸干。",
      "time_min": 20,
      "heat": "无火",
      "tip": "肉回温后煎，中心熟度才均匀不发凉。",
      "visual_cue": "肉块回软，表面干爽，状态稳定"
    },
    {
      "n": 2,
      "text": "土豆去皮切成半厘米见方的粗条，泡冷水十分钟洗掉表面浮粉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡去表面浮粉，炸出来才外脆不粘连。",
      "visual_cue": "薯条水清，条身挺实，状态稳定"
    },
    {
      "n": 3,
      "text": "薯条捞出沥干，深锅倒植物油烧到一百五十度先炸四分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "低温先炸熟内部，这一步只为把薯条煮透。",
      "visual_cue": "薯条发白，质地微软，状态稳定"
    },
    {
      "n": 4,
      "text": "捞出薯条摊开晾三分钟，让表面水分散掉。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "晾一会儿再复炸，外壳才脆得久。，注意火候。",
      "visual_cue": "薯条干爽，不滴油，状态稳定"
    },
    {
      "n": 5,
      "text": "牛里脊两面撒盐和黑胡椒，平底锅烧到冒烟再下锅煎。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "锅一定要够热，肉一接触就封住汁水。",
      "visual_cue": "锅中冒烟，肉面滋滋，状态稳定"
    },
    {
      "n": 6,
      "text": "每面煎两分钟到形成深褐焦壳，取出静置六分钟。",
      "time_min": 8,
      "heat": "中大火",
      "tip": "两厘米厚煎两分钟约五成熟，静置会再熟一点。",
      "visual_cue": "表面焦褐，按压有弹性"
    },
    {
      "n": 7,
      "text": "把油温升到一百八十度，薯条回锅复炸两分钟到金黄上色。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "复炸这步只上色，颜色一变立刻捞出。",
      "visual_cue": "薯条金黄，表面起泡，状态稳定"
    },
    {
      "n": 8,
      "text": "锅中留底油加黄油化开，浇在牛排上，配薯条一起上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油浇面增香，别在锅里久煎以免肉变老。",
      "visual_cue": "黄油起泡，香气浓郁，状态稳定"
    }
  ],
  "tips": [
    "牛排下锅前吸干表面水分，才煎得出焦壳。",
    "薯条炸两遍，先低温炸熟再高温上色。，值得留意。",
    "牛排煎好静置六分钟，肉汁才不流失。，值得留意。"
  ],
  "common_mistakes": [
    "冷牛排直接下锅，外面焦了里面还是凉的。",
    "薯条只炸一遍，出锅两分钟就软塌。，务必避免。",
    "牛排煎完立刻切，一盘子全是血水。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "西冷",
      "ratio": "600 克:600 克",
      "note": "油花更多，煎制时间加一分钟。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "40 克:35 毫升",
      "note": "烟点更高，适合大火煎制。"
    }
  ],
  "variations": [
    "配一小碟黑胡椒酱，风味更浓。，也很受欢迎。",
    "薯条撒少许香草碎，香气更活泼。，也很受欢迎。"
  ],
  "serving_suggestion": "牛排切厚片码在薯条旁，趁热吃最嫩。，效果更稳定。",
  "storage": "现做现吃，薯条不建议冷藏复热。，效果更稳定。",
