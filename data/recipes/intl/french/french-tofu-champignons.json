  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "木勺",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐切成三厘米见方的块，放进淡盐水里浸五分钟再沥干。",
      "time_min": 7,
      "heat": "无火",
      "tip": "浸过盐水的豆腐更紧实不易碎多做两次就能摸准手感。",
      "visual_cue": "豆腐块边角挺立，表面微湿"
    },
    {
      "n": 2,
      "text": "蘑菇用湿布擦净泥点，去蒂后切成半厘米厚的片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蘑菇别泡水，吸水后炒不香宁可分次操作，也别一次到底。",
      "visual_cue": "蘑菇片厚薄均匀，切面白净"
    },
    {
      "n": 3,
      "text": "平底锅放一半黄油化开，下蘑菇片中大火煎四分钟不翻动。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "先煎住一面，蘑菇才不会出水锅里一有变化就调整火力。",
      "visual_cue": "蘑菇底面金黄，锅底无积水"
    },
    {
      "n": 4,
      "text": "翻炒到蘑菇片塌软上色，盛出，锅里留底油锅里一有变化就调整火力。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "蘑菇要炒到边缘焦黄才够香备料提前摆好，做起来更顺手。",
      "visual_cue": "蘑菇片缩水，边缘焦褐"
    },
    {
      "n": 5,
      "text": "下剩下的黄油，放洋葱末和大蒜末小火炒三分钟出甜香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末后放，早放会发苦按时间点检查，别凭感觉判断。",
      "visual_cue": "洋葱透明，蒜香柔和，锅里的样子很直白。"
    },
    {
      "n": 6,
      "text": "撒入中筋面粉不停翻炒四十秒，把生面腥味炒掉再淋白葡萄酒。",
      "time_min": 2,
      "heat": "小火",
      "tip": "面粉一定要炒透，否则有生面腥味发现不对劲就立刻转成小火。",
      "visual_cue": "锅中成细腻糊状，酒香升腾"
    },
    {
      "n": 7,
      "text": "倒入奶油搅匀煮开，放回蘑菇片和嫩豆腐块，小火烩六分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "下豆腐后晃锅，别用勺翻这一步宁可稳一点也不必图快。",
      "visual_cue": "酱汁微沸，豆腐完整，变化看得很清楚。"
    },
    {
      "n": 8,
      "text": "加盐和黑胡椒调匀，撒欧芹碎，趁热盛进深盘。",
      "time_min": 2,
      "heat": "小火",
      "tip": "盐最后加，奶油收浓后咸度会上升火候和时间都要盯住，别走开。",
      "visual_cue": "酱汁浓稠挂勺，表面撒满绿碎"
    }
  ],
  "tips": [
    "蘑菇用干布擦净就好，泡水会炒出一锅汤。",
    "蘑菇下锅先别翻，煎住一面才够香多做两次就能摸准手感。",
    "中筋面粉要炒到没有生味再下液体，酱才顺滑。",
    "豆腐下锅后晃锅代替翻动，块块完整。"
  ],
  "common_mistakes": [
    "蘑菇泡水洗净，下锅出一锅水，怎么都炒不香。",
    "中筋面粉没炒透就倒奶油，整锅泛出生面腥味。",
    "用勺不停翻动，嫩豆腐全碎成渣，前面花的功夫全打了水漂。",
    "盐一开始就放足，收浓后咸得发苦，最后只能倒掉重来。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "牛奶",
      "ratio": "150毫升:150毫升",
      "note": "更清爽，需多加五克面粉收稠。"
    },
    {
      "original": "蘑菇",
      "substitute": "口蘑",
      "ratio": "250克:250克",
      "note": "风味接近，煎的时间相同。"
    }
  ],
  "variations": [
    "表面撒一层奶酪丝，进烤箱上火烤四分钟上色。",
    "加一小勺第戎风味酱同炒，酸香更立体。",
    "把嫩豆腐换成煎过的鸡胸块，做成经典奶油蘑菇鸡。"
  ],
  "serving_suggestion": "配白米饭或煮好的宽面都合适，盘边放两片烤过的法棍片吸汁，再撒一次现磨黑胡椒。",
  "storage": "冷藏可放两天，复热用小火加两勺牛奶慢慢化开，直接微波会油水分离。",
