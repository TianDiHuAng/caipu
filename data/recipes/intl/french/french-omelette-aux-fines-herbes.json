          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "不粘锅",
    "打蛋器",
    "硅胶铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进碗里，加盐和白胡椒，用打蛋器搅到蛋液完全均匀没有絮状蛋清。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液要打到看不见透明蛋清，表面才光滑，这一步千万别省。",
      "visual_cue": "蛋液匀净，表面浮着细泡，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "欧芹和百里香取叶切细末，大葱只取葱白切成极细的末，一起拌进蛋液。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香草切得越细越好，粗了刺破蛋皮影响卷制。",
      "visual_cue": "香草末细碎，均匀浮在蛋液上"
    },
    {
      "n": 3,
      "text": "不粘锅小火烧热，放一半黄油融化晃匀，让锅底均匀挂上一层薄油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油起泡但不变褐就下蛋液，褐了会有焦味。",
      "visual_cue": "黄油起细泡，锅底油亮，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "倒入蛋液，用硅胶铲快速划圈搅动十秒，再静置让底部凝固成一层薄皮。",
      "time_min": 4,
      "heat": "小火",
      "tip": "搅动让蛋液受热均匀，蛋卷内部才嫩而不干。",
      "visual_cue": "蛋液半凝，表面还带光泽，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "把锅微微倾斜，用铲子从远端往中间推三下，让蛋皮自然卷成橄榄形。",
      "time_min": 4,
      "heat": "小火",
      "tip": "边推边转锅，靠蛋液自身粘合，别用力压，火候和顺序都要留神。",
      "visual_cue": "蛋卷成形，表面无裂口，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "关火，把剩下的一半黄油在蛋卷表面抹开，让表面带一层油亮，立刻滑入盘中。",
      "time_min": 2,
      "heat": "无火",
      "tip": "余温会继续加热，抹完黄油就上桌，提前把配料备好再动手更稳。",
      "visual_cue": "表面油亮，切开内部柔软，颜色和形态变化明显"
    }
  ],
  "tips": [
    "蛋液要打到蛋清蛋黄完全融合、看不到絮状蛋白，卷出来表面才细腻无痕。",
    "全程中小火，锅不能冒烟，蛋液凝固得慢才嫩，火大立刻起泡发硬。",
    "卷的时候用铲子从一侧往中间推，边推边转锅，自然形成橄榄形。"
  ],
  "common_mistakes": [
    "火开太大，蛋液底部瞬间焦黄，表面还是稀的，卷起来里外口感割裂。",
    "配料一次全倒进去，蛋皮被压破，卷的时候整块散成炒蛋。",
    "卷好后放锅里继续加热等上色，余温已经足够，再加热就老了。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "25克:20毫升",
      "note": "少了奶香，但更适合乳糖不耐的人。"
    },
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "12克:12克",
      "note": "风味偏东方，用量可再减三分之一。"
    }
  ],
  "variations": [
    "中间抹一层奶油奶酪再卷，切开流心，做成法式早午餐常见版本。",
    "加一勺细碎的炒蘑菇丁，香气更浓，适合当正餐主菜。"
  ],
  "serving_suggestion": "卷好后立刻滑到温热的盘子里，表面刷一层薄黄油，配一片烤面包和沙拉。",
  "storage": "蛋卷现做现吃最佳，冷藏后回热会出水变硬，不建议保存过夜。",
