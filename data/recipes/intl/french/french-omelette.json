    "total_min": 12
  },
  "servings": 2,
  "flavor": [
    "savory",
    "rich",
    "herbal"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 5,
          "unit": "piece",
          "note": "室温，蛋液约二百五十毫升",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切极细葱花",
          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 10,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 25,
          "unit": "g",
          "note": "分两次使用",
          "optional": false
        },
        {
          "name": "奶油",
          "name_en": "cream",
          "amount": 15,
          "unit": "ml",
          "note": "让蛋皮更柔滑",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 1,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "不粘平底锅",
    "打蛋碗",
    "硅胶刮刀",
    "叉子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打入碗中，加盐与黑胡椒，用叉子匀速搅打四十秒到蛋液完全均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液要打到蛋白蛋黄无丝状分离，否则蛋皮有白斑。",
      "visual_cue": "蛋液颜色统一、叉子提起不断线"
    },
    {
      "n": 2,
      "text": "拌入奶油与切碎的葱花、欧芹，静置一分钟让香草释放味道。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香草切得越细越好，粗梗会戳破蛋皮。",
      "visual_cue": "香草碎均匀悬浮、蛋液微微发绿"
    },
    {
      "n": 3,
      "text": "不粘锅中小火加热，放一半黄油化开，泡沫消退但未变色时倒入蛋液。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "黄油起泡后变褐就过头了，会有坚果焦味。",
      "visual_cue": "黄油泡沫细密、锅底薄薄一层"
    },
    {
      "n": 4,
      "text": "用刮刀从边缘向中心快速画圈搅动十秒，形成细嫩的凝乳状蛋花。",
      "time_min": 1,
      "heat": "中小火",
      "tip": "搅动是为了形成细腻凝乳，不要等底面全熟再动。",
      "visual_cue": "蛋液半凝、表面仍有薄薄一层湿润"
    },
    {
      "n": 5,
      "text": "停止搅动让底部定型二十秒，撒余下黄油小块，锅身略倾让蛋皮滑向一边。",
      "time_min": 1,
      "heat": "中小火",
      "tip": "表面保留微微湿润就卷，全熟再卷会发干发硬。",
      "visual_cue": "蛋皮边缘规整、中央仍微亮"
    },
    {
      "n": 6,
      "text": "用刮刀把蛋皮对折成橄榄形，轻推整形后滑入盘中，表面刷少许黄油。",
      "time_min": 2,
      "heat": "小火",
      "tip": "成品应为外表光滑无褐斑、内部半熟柔软。",
      "visual_cue": "蛋卷呈淡黄色橄榄形、表面光滑"
    }
  ],
  "tips": [
    "法式蛋卷追求嫩滑，全程中小火，宁可欠火不要过火。",
    "锅子选二十厘米不粘锅，蛋液厚度刚好容易卷成形。",
    "香草可用龙蒿、细香葱替换，风味各有特色。"
  ],
  "common_mistakes": [
    "火大蛋液迅速上色，蛋卷表面出现褐色斑点，口感发硬。",
    "蛋液完全凝固才卷，折起时开裂碎裂，内里也不嫩。",
    "黄油烧到变褐再下蛋液，带出焦苦味，掩盖蛋香。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "牛奶",
      "ratio": "15ml 对 15ml",
      "note": "牛奶版更清爽，成品嫩度略低。"
    },
    {
      "original": "欧芹",
      "substitute": "香菜",
      "ratio": "10g 对 8g",
      "note": "香菜气味更强，用量需减，风味偏亚洲。"
    }
  ],
  "variations": [
    "内部填入炒软的蘑菇与格鲁耶尔芝士，做成法式乡村蛋卷。",
    "加入一小勺松露酱，做成香气浓郁的餐厅版本。"
  ],
  "serving_suggestion": "装盘后配一片烤吐司与少量沙拉，作为法式早餐或轻午餐。",
  "storage": "现做现吃，不建议存放；冷藏后再加热会失水变韧。",
