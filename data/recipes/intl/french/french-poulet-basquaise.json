          "optional": false
        },
        {
          "name": "欧芹",
          "name_en": "parsley",
          "amount": 10,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "刀",
    "砧板",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成大块，用盐和黑胡椒抓匀，腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鸡肉表面先擦干再腌，煎的时候才上色。",
      "visual_cue": "鸡块表面均匀裹上调料"
    },
    {
      "n": 2,
      "text": "甜椒去籽切成条，洋葱切丝，大蒜切片，番茄切块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "甜椒切得和洋葱差不多宽，熟度才一致。",
      "visual_cue": "蔬菜切成均匀的条和块"
    },
    {
      "n": 3,
      "text": "厚底锅放橄榄油烧热，鸡块皮朝下中火煎到金黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡皮朝下先煎，油脂逼出来才够香。",
      "visual_cue": "鸡皮金黄，锅底积着鸡油"
    },
    {
      "n": 4,
      "text": "把鸡块翻面再煎三分钟，煎好后盛出放在一旁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "两面都煎过一遍，炖出来才不会带腥味。",
      "visual_cue": "鸡块两面金黄，肉质收紧"
    },
    {
      "n": 5,
      "text": "原锅下洋葱丝和蒜片炒软，再放甜椒条炒两分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味才会进到酱汁里。",
      "visual_cue": "洋葱透明，甜椒微软"
    },
    {
      "n": 6,
      "text": "加入番茄块炒到出汁，再倒入高汤大火烧开。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄要炒到塌软出汁，酱汁才有厚度。",
      "visual_cue": "番茄塌软，锅中有红色汤汁"
    },
    {
      "n": 7,
      "text": "把煎好的鸡块放回锅里，盖盖用小火炖二十五分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "小火慢炖，鸡肉才会酥软而不发柴。",
      "visual_cue": "汤汁微沸，鸡肉能用筷子戳透"
    },
    {
      "n": 8,
      "text": "开盖把汤汁收到浓稠，撒上欧芹末即可上桌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "收汁要不停搅动，免得锅底糊掉。",
      "visual_cue": "汤汁浓稠挂勺，表面泛油光"
    }
  ],
  "tips": [
    "鸡皮朝下先煎出油脂，成品香气更足。",
    "小火慢炖二十五分钟，鸡肉才酥而不柴。",
    "收汁时不停搅动，避免锅底糊锅。"
  ],
  "common_mistakes": [
    "鸡块没擦干就下锅，煎出来又白又腥。",
    "大火滚炖，鸡肉纤维紧缩变得发柴。",
    "甜椒下锅太早久煮，颜色发暗口感烂。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "800 克:800 克",
      "note": "炖制时间延长十分钟。"
    },
    {
      "original": "甜椒",
      "substitute": "青椒",
      "ratio": "200 克:200 克",
      "note": "味道更清爽，香气略减。"
    }
  ],
  "variations": [
    "放几片火腿一起同炖，咸鲜味更足。"
  ],
  "serving_suggestion": "配米饭或煎土豆块一起吃，把酱汁浇在饭上。",
  "storage": "冷藏两天，复热时小火加少量高汤；可冷冻一个月。",
