          "optional": false
        },
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 300,
          "unit": "g",
          "note": "切块",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 150,
          "unit": "g",
          "note": "切丝",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 10,
          "unit": "g",
