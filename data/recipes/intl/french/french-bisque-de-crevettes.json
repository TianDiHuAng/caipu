  "steps": [
    {
      "n": 1,
      "text": "虾去壳留壳，虾壳冲洗干净沥干，虾单独冷藏备用。",
      "time_min": 9,
      "heat": "无火",
      "tip": "虾壳别扔，虾汤的红油全在壳里。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "虾壳干净无杂，虾完整"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油，虾壳中小火煎五分钟至变红出香。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "壳煎到发红出油，汤才有虾味。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "虾壳鲜红，锅底有红色油"
    },
    {
      "n": 3,
      "text": "汤锅化黄油，下洋葱、胡萝卜、芹菜与蒜末小火炒软。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蔬菜切细末，汤才细腻易打。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "蔬菜末软塌透明，香气明显"
    },
    {
      "n": 4,
      "text": "下番茄块炒三分钟，倒白葡萄酒煮到酒气挥发。",
      "time_min": 6,
      "heat": "中火",
      "tip": "酒气煮掉再倒汤，才不留酸涩。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "酒液几乎收干，锅底微稠"
    },
    {
      "n": 5,
      "text": "把煎好的虾壳倒入汤锅，加高汤烧开后小火煮二十五分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "小火慢煮，虾味才全进汤里。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汤色橙红，香气浓色泽分明状态稳定"
    },
    {
      "n": 6,
      "text": "过滤掉虾壳蔬菜渣，汤倒回锅加淡奶油与虾煮三分钟，调盐与白胡椒。",
      "time_min": 8,
      "heat": "小火",
      "tip": "虾最后煮，久煮就缩成硬球。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "虾卷曲变红，汤体浓稠光滑"
    }
  ],
  "tips": [
    "虾壳必须煎红，那是汤色的来源。火候与时间都要盯紧，宁可略短也别过头。",
    "过滤要彻底，汤才细不带渣。做之前把料备齐，下锅后就没空切配了。",
    "虾最后三分钟下，口感才弹。这几步照顺序来，味道才会一层层叠上去。",
    "奶油别煮沸，微滚就好。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "把虾壳丢掉，汤只有蔬菜味。结果往往一锅好料全被这一步毁掉。",
    "虾壳没煎透，汤色发灰不红。很多人就在这里翻车，出菜后才发现。",
    "虾久煮，缩成硬球没有弹性。账面上看是小疏忽，入口立刻能尝出来。",
    "过滤不净，喝起来满口沙渣。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "大虾尾",
      "ratio": "400克:500克",
      "note": "壳更多，汤色更浓。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "料酒",
      "ratio": "100毫升:60毫升",
      "note": "风味不同，用量减半。"
    }
  ],
  "variations": [
    "加一点白兰地，香气更华丽。口味会更厚一些，适合重口的人。",
    "加藏红花，汤色更金黄。做法不复杂，家常灶台就能完成。",
    "留几只整虾摆盘，卖相更好。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "盛进浅汤碗，放两只虾、淋一圈奶油、撒欧芹碎，配烤面包片蘸汤吃。",
  "storage": "冷藏可放两天，复热小火加热别沸腾；虾久放口感变硬。",
