  "steps": [
    {
      "n": 1,
      "text": "牛腩块用厨房纸吸干水分，撒盐与黑胡椒，两面薄薄裹一层面粉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉块一定要吸干，湿肉下锅只会出水不会上色。",
      "visual_cue": "肉块表面干爽，粉层薄而均匀"
    },
    {
      "n": 2,
      "text": "厚底锅下橄榄油烧热，把牛腩分批煎到六面深褐，取出备用。",
      "time_min": 15,
      "heat": "中大火",
      "tip": "分批煎，锅挤满温度骤降就煎不出焦壳。",
      "visual_cue": "肉块六面焦褐，锅底留褐色焦渣"
    },
    {
      "n": 3,
      "text": "原锅下培根条小火煸出油，再放洋葱与胡萝卜炒到边缘微焦。",
      "time_min": 10,
      "heat": "中火",
      "tip": "培根的油是这道菜的底味，别倒掉。",
      "visual_cue": "蔬菜边缘带焦边，锅底油亮"
    },
    {
      "n": 4,
      "text": "倒回牛腩，撒入蒜末与香叶、百里香翻炒一分钟出香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料在油里翻一下就好，久炒发苦。",
      "visual_cue": "香气扑鼻，锅内有轻微滋滋声"
    },
    {
      "n": 5,
      "text": "倒入红酒没过肉面，加高汤补足液体，煮开后撇去浮沫。",
      "time_min": 8,
      "heat": "大火",
      "tip": "红酒要先煮滚挥发酒精，否则成品发酸。",
      "visual_cue": "汤面浮沫撇净，液体深红"
    },
    {
      "n": 6,
      "text": "转最小火加盖慢炖两小时，中途翻动两次防止粘底。",
      "time_min": 120,
      "heat": "小火",
      "tip": "保持汤面只有零星小泡，滚太猛肉会散。",
      "visual_cue": "肉块用筷子能轻松插透"
    },
    {
      "n": 7,
      "text": "另起锅用黄油把口蘑煎到金黄，倒入炖锅再煮十分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "蘑菇单独煎香再入锅，汤才不寡淡。",
      "visual_cue": "蘑菇边缘金黄，吸饱汤汁"
    },
    {
      "n": 8,
      "text": "开盖收汁到浓稠挂勺，撒欧芹碎后装盘上桌。",
      "time_min": 10,
      "heat": "中火",
      "tip": "收汁时勤搅，红酒酱含糖容易糊底。",
      "visual_cue": "汤汁能挂在勺背，颜色深亮"
    }
  ],
  "tips": [
    "隔夜冷藏后再加热，风味比当天更融合。",
    "红酒选自己愿意喝的干型，料酒级别的酒会发涩。",
    "收汁阶段离火前尝一次咸淡，红酒本身带酸。"
  ],
  "common_mistakes": [
    "牛肉没吸干就下锅，全程出水，最后变成灰白色的水煮肉。",
    "大火猛炖，肉纤维断裂成渣，汤汁浑浊。",
    "红酒一次倒太多又不收汁，成品酸涩发苦。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛腱子",
      "ratio": "900 克:900 克",
      "note": "胶质更多，炖制时间延长二十分钟。"
    },
    {
      "original": "红酒",
      "substitute": "红酒加高汤各半",
      "ratio": "750 毫升:400 加 350 毫升",
      "note": "酒味更淡，适合不喜浓酒味的人。"
    }
  ],
  "variations": [
    "加一把小洋葱同炖，甜味更突出。",
    "用铸铁锅连锅端上桌，保温效果更好。"
  ],
  "serving_suggestion": "逆纹切厚片摆盘淋酱，配一份主食同食。",
  "storage": "冷藏三天、冷冻两个月；复热小火加少量高汤，避免干锅。",
