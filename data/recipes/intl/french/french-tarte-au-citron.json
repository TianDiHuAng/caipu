  ],
  "steps": [
    {
      "n": 1,
      "text": "低筋面粉、糖粉和盐混匀，加入冷藏黄油丁用指尖搓成粗砂状，再添清水捏成团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "黄油保持低温揉进粉里，塔皮烤后才会分层起酥。",
      "visual_cue": "面团勉强成团，掰开可见细碎黄油粒"
    },
    {
      "n": 2,
      "text": "面团压扁包上保鲜膜冷藏半小时，取出擀成三毫米厚，铺进塔模压实并扎小孔。",
      "time_min": 15,
      "heat": "无火",
      "tip": "面团回软就放回冰箱十分钟，太软擀开会粘在案板上。",
      "visual_cue": "塔皮紧贴模具内壁，边缘整齐无气泡"
    },
    {
      "n": 3,
      "text": "塔皮铺烘焙纸压上重物，一百八十度烤十五分钟，去掉重物再烤五分钟至浅金色。",
      "time_min": 20,
      "heat": "无火",
      "tip": "盲烤到位底部才干爽，省掉这步倒馅后会湿塌。",
      "visual_cue": "塔皮呈浅金黄色，轻敲有脆声"
    },
    {
      "n": 4,
      "text": "柠檬刮下黄色表皮并挤出汁，与白糖、玉米淀粉和蛋液小火边搅边煮到浓稠。",
      "time_min": 9,
      "heat": "小火",
      "tip": "全程不停搅动，温度局部过高蛋液就会结块。",
      "visual_cue": "凝乳浓稠发亮，挑起能缓慢垂落成线"
    },
    {
      "n": 5,
      "text": "趁热把柠檬凝乳过筛倒进塔皮，抹平表面，冷藏两小时定型后脱模切片。",
      "time_min": 4,
      "heat": "无火",
      "tip": "热凝乳流动性好，过筛后灌入才铺得平。",
      "visual_cue": "表面平整光滑，冷藏后轻推不晃动"
    }
  ],
  "tips": [
    "只刮柠檬皮的黄色部分，白色海绵层带苦味会毁掉整锅凝乳。",
    "凝乳必须趁热灌入塔皮，凉透后失去流动性就铺不平了。",
    "切片前把刀用热水烫过擦干，切面才干净利落不塌边。"
  ],
  "common_mistakes": [
    "黄油融化后再揉面，塔皮烤时收缩变形且完全没有酥层。",
    "小火煮凝乳时停手不搅，锅底很快结出蛋花硬块。",
    "塔皮没盲烤就直接倒馅，成品底部湿软发黏。"
  ],
  "substitutions": [
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "3 个:4 个",
      "note": "酸度更高，可多加十五克白糖平衡。"
    },
    {
      "original": "低筋面粉",
      "substitute": "中筋面粉",
      "ratio": "1:1",
      "note": "塔皮稍韧，需多静置十分钟再擀。"
    }
  ],
  "variations": [
    "凝乳表面挤少量蛋白霜用喷枪烤出焦痕，即成柠檬蛋白塔，口感更有层次。"
  ],
  "serving_suggestion": "冷藏后切块，配一小勺无糖打发淡奶油同食。",
  "storage": "密封冷藏两天，塔皮会逐渐回软，建议二十四小时内吃完。",
