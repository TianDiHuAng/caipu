 "steps": [
  {
   "n": 1,
   "text": "面粉和盐混匀，酵母用温水化开后倒入。，看准状态再往下做。",
   "time_min": 8,
   "heat": "无火",
   "tip": "盐和酵母分开，发酵才稳。，看准状态再往下做。",
   "visual_cue": "面粉成絮，水色微浑"
  },
  {
   "n": 2,
   "text": "揉面十分钟到表面光滑有弹性。，看准状态再往下做。",
   "time_min": 11,
   "heat": "无火",
   "tip": "揉到能拉出薄膜，组织才细。，看准状态再往下做。",
   "visual_cue": "面团光滑，按压回弹"
  },
  {
   "n": 3,
   "text": "面团抹一层橄榄油，盖布室温发酵一小时。，看准状态再往下做。",
   "time_min": 62,
   "heat": "无火",
   "tip": "温暖处发酵，体积才翻倍。，看准状态再往下做。",
   "visual_cue": "体积翻倍，指压留痕"
  },
  {
   "n": 4,
   "text": "面团轻压排气，折叠两圈后静置二十分钟。，看准状态再往下做。",
   "time_min": 22,
   "heat": "无火",
   "tip": "折叠代替揉，气泡才留得住。，看准状态再往下做。",
   "visual_cue": "面团紧实，表面光滑"
  },
  {
   "n": 5,
   "text": "整形成圆形，接缝朝下放进撒粉的发酵篮。，看准状态再往下做。",
   "time_min": 6,
   "heat": "无火",
   "tip": "表面张力拉紧，烤时才鼓得高。，看准状态再往下做。",
   "visual_cue": "表面绷紧，形状圆整"
  },
  {
   "n": 6,
   "text": "二次发酵四十分钟，同时预热烤箱两百三十度。，看准状态再往下做。",
   "time_min": 42,
   "heat": "无火",
   "tip": "发酵到位，面团才松软。，看准状态再往下做。",
   "visual_cue": "指压缓慢回弹，这一点很关键。"
  },
  {
   "n": 7,
   "text": "面团倒扣在烤盘上，表面划三道斜口。，看准状态再往下做。",
   "time_min": 4,
   "heat": "无火",
   "tip": "划口要快，刀口才翻得开。，看准状态再往下做。",
   "visual_cue": "刀口翻开，纹路清晰"
  },
  {
   "n": 8,
   "text": "烤箱里放一碗热水，烤四十分钟到外壳深褐。，看准状态再往下做。",
   "time_min": 40,
   "heat": "无火",
   "tip": "蒸汽让外壳薄脆，颜色也好看。，看准状态再往下做。",
   "visual_cue": "外壳深褐，敲声空洞"
  },
  {
   "n": 9,
   "text": "出炉放网架晾凉，完全冷却后再切。，看准状态再往下做。",
   "time_min": 40,
   "heat": "无火",
   "tip": "热切会压塌组织，凉了再切。，看准状态再往下做。",
   "visual_cue": "切面气孔，外壳干脆"
  }
 ],
 "tips": [
  "盐和酵母分开，发酵才不受影响。，这一点很关键。",
  "折叠代替揉，气泡才留得住。，这一点很关键。",
  "烤时放水碗，外壳才薄脆。，这一点很关键。"
 ],
 "common_mistakes": [
  "面团没发起来，烤成硬饼。，这一点很关键。",
  "热着就切，切面全塌。，这一点很关键。",
  "烤箱没蒸汽，外壳又厚又硬。，这一点很关键。"
 ],
 "substitutions": [
  {
   "original": "中筋面粉",
