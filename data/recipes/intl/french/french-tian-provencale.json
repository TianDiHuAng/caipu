  "equipment": [
    "烤盘",
    "切片刀",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子、西葫芦和番茄洗净，各自切成一厘米厚的圆片，撒少许盐静置十分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "撒盐逼水，烤完才不会泡在汤里，这一步千万别省。",
      "visual_cue": "蔬菜片渗水珠，表面湿润，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "洋葱切细末，蒜切末，平底锅倒十五毫升橄榄油，小火炒洋葱五分钟至软甜。",
      "time_min": 8,
      "heat": "小火",
      "tip": "洋葱炒到发甜，才不会抢蔬菜的清味，火候和顺序都要留神。",
      "visual_cue": "洋葱软塌，颜色微黄，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "加蒜末和百里香叶炒一分钟出香，加盐和黑胡椒调味，铺进烤盘底部压平。",
      "time_min": 3,
      "heat": "小火",
      "tip": "底层要压实，蔬菜片才立得住，提前把配料备好再动手更稳。",
      "visual_cue": "底料平铺，无空隙，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "把三种蔬菜片交替斜插进烤盘，一片挨一片排紧，表面刷上剩余橄榄油。",
      "time_min": 8,
      "heat": "无火",
      "tip": "排紧不留缝，烤时蔬菜才不会倒，这一步千万别省。",
      "visual_cue": "蔬菜片层层紧贴，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "表面撒盐和黑胡椒，烤箱预热一百九十度，烤盘进中层烤二十五分钟。",
      "time_min": 27,
      "heat": "中大火",
      "tip": "中途看一次颜色，边缘焦了就盖锡纸，火候和顺序都要留神。",
      "visual_cue": "蔬菜片边缘微卷，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "取出撒上奶酪丝，回炉再烤八分钟至奶酪融化起斑，出炉静置五分钟。",
      "time_min": 10,
      "heat": "中大火",
      "tip": "静置让汁水回收，切开才不流汤，提前把配料备好再动手更稳。",
      "visual_cue": "奶酪金黄，蔬菜软塌，颜色和形态变化明显"
    }
  ],
  "tips": [
    "三种蔬菜切成同样厚度的半厘米片，烤的时候才会同时熟。",
    "蔬菜片要斜着插进烤盘，排得密一点，空隙大会塌陷。",
    "盐要撒在蔬菜表面而不是只在底层，水分才出得来。"
  ],
  "common_mistakes": [
    "蔬菜切得厚薄不一，薄的烤焦发黑，厚的还是生的。",
    "洋葱底没炒软就铺蔬菜，烤完底层还是辛辣的硬块。",
    "表面不刷油直接烤，蔬菜干缩起皱，颜色发暗没有光泽。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "面包屑",
      "ratio": "40克:40克",
      "note": "纯素版本，表面更脆，可加橄榄油拌匀再撒。"
    },
    {
      "original": "西葫芦",
      "substitute": "南瓜",
      "ratio": "250克:250克",
      "note": "甜味更突出，烤的时间延长五分钟。"
    }
  ],
  "variations": [
    "加一层土豆薄片打底，更能吸汁，烤完像蔬菜派。",
    "撒一小撮普罗旺斯香草碎，香气更浓，配烤羊排很搭。"
  ],
  "serving_suggestion": "烤盘直接上桌，配一片烤面包和一杯桃红葡萄酒，冷吃也很好。",
  "storage": "冷藏可放两天，回热盖锡纸一百八十度烤十分钟，冷食风味更集中。",
