      ]
    }
  ],
  "equipment": [
    "小汤锅",
    "裱花袋",
    "烤盘",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶、清水、黄油与盐放小锅煮开，黄油完全化开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "液体要真正滚起来再下面粉，温度不够面糊烫不熟，烤不鼓。",
      "visual_cue": "液体翻滚，油花全化开"
    },
    {
      "n": 2,
      "text": "离火倒入过筛面粉，用木勺快速搅到成团无干粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面粉一次全倒入，分次加会结小疙瘩，成品里全是硬粒。",
      "visual_cue": "面团结团，锅底结一薄层"
    },
    {
      "n": 3,
      "text": "回小火边加热边翻炒两分钟，把面团里的水分炒干。",
      "time_min": 3,
      "heat": "小火",
      "tip": "锅底出现一层薄膜才说明水分够了，这层膜是烤得鼓的关键。",
      "visual_cue": "锅底起薄膜，面团光滑"
    },
    {
      "n": 4,
      "text": "面团移到盆里分五到六次加蛋液，每次都搅到完全吸收。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蛋液千万别一次倒完，面团吸不住就变稀，挤出来全摊平。",
      "visual_cue": "面糊提勺呈倒三角缓慢下落"
    },
    {
      "n": 5,
      "text": "面糊装裱花袋，在烤盘上挤成长条，间隔三厘米。",
      "time_min": 8,
      "heat": "无火",
      "tip": "挤的时候手要稳，粗细不匀烤出来有的焦有的生。",
      "visual_cue": "长条粗细一致，间距均匀"
    },
    {
      "n": 6,
      "text": "烤箱二百度烤十五分钟，转一百八十度再烤十分钟。",
      "time_min": 25,
      "heat": "无火",
      "tip": "中途别开门，一开门蒸汽跑掉，泡芙立刻塌成薄饼。",
      "visual_cue": "泡芙鼓起金黄，外壳硬挺"
    },
    {
      "n": 7,
      "text": "淡奶油加白糖打到硬挺，从泡芙底部挤入，表面可蘸巧克力。",
      "time_min": 8,
      "heat": "无火",
      "tip": "奶油要打到提起打蛋器有直立尖角，软了挤进去会流出来。",
      "visual_cue": "奶油纹路挺立，泡芙鼓起饱满"
    }
  ],
  "tips": [
    "闪电泡芙因表面光泽像闪电而得名，是法式甜点铺的常客。",
    "面糊状态决定成败，提起来呈倒三角缓慢下落最合适。",
    "烤好的空壳冷冻可存一个月，吃前回炉五分钟再填馅。"
  ],
  "common_mistakes": [
    "蛋液一次全倒，面糊变稀，挤出来摊成一片平板。",
    "中途开烤箱看进度，泡芙瞬间塌陷，再也鼓不起来。",
    "奶油打得太软，挤进泡芙里全流出来，切开是空的。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "200毫升:180毫升",
      "note": "牛奶馅需加玉米淀粉煮成卡仕达，口感更厚。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "80克:70毫升",
      "note": "植物油版香气差些，但烤制膨胀效果接近。"
    }
  ],
  "variations": [
    "表面蘸一层巧克力甘纳许，做成经典巧克力闪电泡芙。",
    "挤成小圆球就是奶油泡芙，形状不同但面糊配方一样。"
  ],
  "serving_suggestion": "冷藏一小时定型后食用，配一杯无糖咖啡平衡甜度。",
  "storage": "未填馅的空壳冷冻可存一个月，填馅后冷藏不超过一天。",
