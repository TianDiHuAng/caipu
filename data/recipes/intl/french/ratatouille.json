        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 60,
          "unit": "ml",
          "note": "分三次使用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "分次调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "烤盘",
    "烤箱",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子切成 1cm 圆片，撒少许盐静置 10 分钟后挤去水分，避免烤后出水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "茄子先杀水，成品才不会稀软。",
      "visual_cue": "茄片表面见水珠、按压回弹"
    },
    {
      "n": 2,
      "text": "西葫芦切圆片，番茄一半切块一半切片，彩椒与洋葱切丝，大蒜切末。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切片厚薄一致，摆盘才整齐好看。",
      "visual_cue": "切片均匀、约一枚硬币厚"
    },
    {
      "n": 3,
      "text": "平底锅倒 20ml 橄榄油，中火把茄片煎到两面微黄后盛出。",
      "time_min": 8,
      "heat": "中火",
      "tip": "茄子吸油，煎之前先擦干表面。",
      "visual_cue": "两面金黄、片身挺括"
    },
    {
      "n": 4,
      "text": "锅中再倒 20ml 橄榄油，下洋葱与彩椒丝中火炒 5 分钟至软塌出甜味。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味才出来。",
      "visual_cue": "洋葱透明、体积缩小"
    },
    {
      "n": 5,
      "text": "加蒜末与番茄块翻炒，加 3g 盐与白胡椒，小火煮 15 分钟收成浓稠番茄酱。",
      "time_min": 17,
      "heat": "小火",
      "tip": "小火慢煮，番茄酱才浓稠不涩。",
      "visual_cue": "酱汁浓稠、能挂住勺背"
    },
    {
      "n": 6,
      "text": "烤盘底部铺一层番茄酱，茄片与西葫芦片交错叠放成螺旋状，淋剩余 20ml 橄榄油。",
      "time_min": 8,
      "heat": "无火",
      "tip": "叠放要紧密，烤时才不塌陷。",
      "visual_cue": "螺旋排列整齐、表面见油光"
    },
    {
      "n": 7,
      "text": "盖上锡纸放入预热 180℃ 烤箱烤 35 分钟，出炉揭开锡纸撒罗勒叶。",
      "time_min": 37,
      "heat": "无火",
      "tip": "先盖锡纸保水，后开盖收干表面。",
      "visual_cue": "蔬菜软透、罗勒遇热出香"
    }
  ],
  "tips": [
    "茄子先盐渍杀水，烤完才不出一盘汤。",
    "番茄底酱要小火熬浓，铺底才有味道。",
    "最后 10 分钟开盖烤，表面收干更香。"
  ],
  "common_mistakes": [
    "蔬菜切片厚薄不一，烤制时生熟不匀。",
    "番茄酱熬得太稀，成品出汤变成炖菜。",
    "全程盖着锡纸烤，蔬菜水汽重、香味出不来。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "黄瓜",
      "ratio": "400g 对 400g",
      "note": "黄瓜水分多，烤制时间减 8 分钟。"
    },
    {
      "original": "罗勒",
      "substitute": "百里香",
      "ratio": "8g 对 3g",
      "note": "干香草味浓，用量减半。"
    }
  ],
  "variations": [
    "家常版：全部切丁同锅炖 30 分钟，省去摆盘。",
    "加芝士版：出炉前撒 60g 帕玛森芝士烤 8 分钟。"
  ],
  "storage": "冷藏 3 天，复热后风味更融合，冷食也适合。",
