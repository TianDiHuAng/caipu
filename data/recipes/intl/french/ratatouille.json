          "name_en": "red bell pepper",
          "amount": 150,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 200,
          "unit": "g",
          "note": "切丝",
          "optional": false
        },
        {
