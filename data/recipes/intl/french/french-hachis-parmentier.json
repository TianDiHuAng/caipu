  "equipment": [
    "烤箱",
    "汤锅",
    "炒锅",
    "压泥器",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切块，放汤锅加水煮二十分钟到软。，看准状态再往下做。",
      "time_min": 22,
      "heat": "大火",
      "tip": "煮到叉子一插就透，压泥才细。，看准状态再往下做。",
      "visual_cue": "块边碎开，筷子可穿"
    },
    {
      "n": 2,
      "text": "沥干水分，趁热加黄油和牛奶压成细腻薯泥。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁热压泥，薯泥才顺滑无颗粒。，看准状态再往下做。",
      "visual_cue": "泥质细滑，无结块，这里最容易翻车。"
    },
    {
      "n": 3,
      "text": "洋葱切碎，大蒜切末，番茄切小丁备用。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切碎一点，炒的时候才融进肉里。，看准状态再往下做。",
      "visual_cue": "碎粒均匀，颜色分明"
    },
    {
      "n": 4,
      "text": "炒锅倒橄榄油，下洋葱碎小火炒到透明。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢炒，洋葱才甜不焦。，看准状态再往下做。",
      "visual_cue": "洋葱透明，香气升起"
    },
    {
      "n": 5,
      "text": "加蒜末炒香，下牛肉粒大火炒散至变色。，看准状态再往下做。",
      "time_min": 6,
      "heat": "大火",
      "tip": "牛肉粒要炒散，别结成大块。，看准状态再往下做。",
      "visual_cue": "肉粒松散，颜色变褐"
    },
    {
      "n": 6,
      "text": "加番茄丁、面粉炒匀，加盐和黑胡椒调味。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "面粉裹住肉汁，馅才不水。，看准状态再往下做。",
      "visual_cue": "馅料湿润，不流汤，别小看这一步。"
    },
    {
      "n": 7,
      "text": "撒欧芹碎拌匀，把牛肉料铺进烤盘压平。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "压平压实，切的时候才不散。，看准状态再往下做。",
      "visual_cue": "馅面平整，厚薄一致"
    },
    {
      "n": 8,
      "text": "薯泥铺在牛肉料上抹平，用叉子划出纹路。，看准状态再往下做。",
      "time_min": 7,
      "heat": "无火",
      "tip": "划纹路，烤出的表面才酥。，看准状态再往下做。",
      "visual_cue": "纹路清晰，边缘封住"
    },
    {
      "n": 9,
      "text": "撒奶酪碎，烤箱两百度烤二十分钟到金黄。，看准状态再往下做。",
      "time_min": 20,
      "heat": "无火",
      "tip": "烤到表面起泡，香气才出来。，看准状态再往下做。",
      "visual_cue": "表面金黄，奶酪融化"
    }
  ],
  "tips": [
    "薯泥要趁热压，冷了会起疙瘩。，成败就在这一步。",
    "牛肉料收干汤汁，铺薯泥才不塌。，这点要注意。",
    "表面划纹路，烤出的脆皮更漂亮。，这是关键点。"
  ],
  "common_mistakes": [
    "薯泥太稀，铺上去全陷进肉里。，别嫌麻烦，做完它。",
    "牛肉料带汤，烤完底部一层水。，这一步别省。",
    "奶酪撒太早，烤焦发苦。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "500 克:500 克",
      "note": "风味更浓，需多加百里香。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "120 毫升:100 毫升",
      "note": "更浓郁，热量也更高。"
    }
  ],
  "variations": [
    "加一层蘑菇丁，口感更丰富。，这步最关键。",
    "表面撒面包糠，脆感更足。，很多人在这里出错。"
  ],
  "serving_suggestion": "配一份简单的绿叶蔬菜。，这里最容易翻车。",
  "storage": "冷藏三天，冷冻两周；复热烤箱一百八十度二十分钟。",
