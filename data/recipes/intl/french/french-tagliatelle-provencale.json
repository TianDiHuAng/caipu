    "平底锅",
    "刀",
    "砧板",
    "漏勺",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用沸水烫三十秒后撕掉外皮，切成小丁。",
      "time_min": 7,
      "heat": "无火",
      "tip": "烫过的番茄皮一撕就掉，酱才顺滑宁可分次操作，也别一次到底。",
      "visual_cue": "番茄丁红亮，无皮无硬芯"
    },
    {
      "n": 2,
      "text": "深锅加足量清水烧开，放一小把盐，等下用来煮意大利面。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水要宽，面下锅才不会粘成一团锅里一有变化就调整火力。",
      "visual_cue": "水面翻滚，锅边冒白汽"
    },
    {
      "n": 3,
      "text": "平底锅倒一半橄榄油，下洋葱末小火炒五分钟至透明发甜。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒透，酱的甜味才自然备料提前摆好，做起来更顺手。",
      "visual_cue": "洋葱末软塌，泛淡黄，能明显看出差别。"
    },
    {
      "n": 4,
      "text": "放大蒜末炒三十秒出香，倒入番茄丁转中火翻炒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蒜末只要出香，别炒到发黄按时间点检查，别凭感觉判断。",
      "visual_cue": "蒜香冲鼻，番茄开始出水"
    },
    {
      "n": 5,
      "text": "加盐、白糖和黑胡椒，小火熬十二分钟至番茄化开成酱。",
      "time_min": 12,
      "heat": "小火",
      "tip": "全程小火慢熬，酱才浓稠不焦发现不对劲就立刻转成小火。",
      "visual_cue": "酱体浓稠，表面泛油光"
    },
    {
      "n": 6,
      "text": "把意大利面下进沸水，按包装时间煮九分钟，留半碗面汤。",
      "time_min": 9,
      "heat": "大火",
      "tip": "留一勺面汤，拌面时能挂住酱这一步宁可稳一点也不必图快。",
      "visual_cue": "意大利面柔软，芯里还有一点韧"
    },
    {
      "n": 7,
      "text": "意大利面捞进番茄酱锅，加两勺面汤和剩下的橄榄油快速拌匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "面汤里的糊化物质让酱汁裹得更匀火候和时间都要盯住，别走开。",
      "visual_cue": "每根面都裹上红酱，油亮不干"
    },
    {
      "n": 8,
      "text": "装盘后撒罗勒片和奶酪丝，趁热端上桌拌开火候和时间都要盯住，别走开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "罗勒靠余温出香，别下锅炒多做两次就能摸准手感。",
      "visual_cue": "表面绿白相间，酱汁油润"
    }
  ],
  "tips": [
    "番茄先烫去皮，熬出的酱才细腻不挂皮。",
    "洋葱小火炒到透明，甜味比加糖更自然。",
    "煮面水要宽且带盐，面本身才有底味。",
    "拌面时加一勺面汤，酱汁才裹得紧备料提前摆好，做起来更顺手。"
  ],
  "common_mistakes": [
    "番茄不剥皮直接切，酱里全是卷起的皮片。",
    "洋葱大火炒焦，整锅酱带苦味，前面花的功夫全打了水漂。",
    "意大利面煮好不拌油，出锅就粘成一坨，最后只能倒掉重来。",
    "拌面时一滴面汤都不加，酱全堆在盘底。"
  ],
  "substitutions": [
    {
      "original": "意大利面",
      "substitute": "通心粉",
      "ratio": "320克:320克",
      "note": "煮的时间多加一分钟，缝隙更能藏酱。"
    },
    {
      "original": "奶酪",
      "substitute": "帕玛森",
      "ratio": "30克:30克",
      "note": "咸香更重，盐相应减一克。"
    }
  ],
  "variations": [
    "加一把黑橄榄同熬，咸鲜味更像尼斯一带的做法。",
    "把番茄换成罐装去皮番茄，冬天也能做出浓酱。",
    "最后淋一勺橄榄油生油，香气更清亮。"
  ],
  "serving_suggestion": "用温热的深盘盛面，盘边配两片罗勒叶，再磨一点黑胡椒，配一杯干白最合适。",
  "storage": "冷藏可放两天，复热时加两勺清水小火拌开，微波会让面发硬发干。",
