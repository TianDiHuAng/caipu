  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面包",
          "name_en": "bread",
          "amount": 4,
          "unit": "piece",
          "note": "厚切吐司或乡村面包",
          "optional": false
        },
        {
          "name": "火腿",
          "name_en": "ham",
          "amount": 120,
          "unit": "g",
          "note": "切薄片",
          "optional": false
        },
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 150,
          "unit": "g",
          "note": "擦丝,格吕耶尔最佳",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 40,
          "unit": "g",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 20,
          "unit": "g",
          "note": "做白酱",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 200,
          "unit": "ml",
          "note": "白酱",
          "optional": false
        },
        {
          "name": "肉豆蔻",
          "name_en": "nutmeg",
          "amount": 1,
          "unit": "g",
          "note": "擦粉",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "第戎芥末",
          "name_en": "Dijon mustard",
          "amount": 15,
          "unit": "g",
          "note": "抹面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "烤箱",
    "刷子",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小锅化一半黄油，加面粉小火炒一分钟至微微起泡。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面粉要炒到没有生面味，白酱才不噎口。",
      "visual_cue": "面糊顺滑，泛起细泡"
    },
    {
      "n": 2,
      "text": "分三次倒入牛奶，边倒边搅至顺滑，小火煮三分钟收浓。",
      "time_min": 6,
      "heat": "小火",
      "tip": "牛奶必须分次加，一次倒完容易结块。",
      "visual_cue": "白酱浓稠，能挂住打蛋器"
    },
    {
      "n": 3,
      "text": "白酱加盐、黑胡椒与肉豆蔻粉调味，关火稍凉。",
      "time_min": 2,
      "heat": "小火",
      "tip": "肉豆蔻一点点就够，多了发苦。",
      "visual_cue": "酱体细腻，香气带奶味"
    },
    {
      "n": 4,
      "text": "面包片单面抹第戎芥末，铺火腿片与一半奶酪丝后合上。",
      "time_min": 5,
      "heat": "无火",
      "tip": "芥末能中和奶酪的腻，别省。",
      "visual_cue": "夹层平整，奶酪均匀"
    },
    {
      "n": 5,
      "text": "三明治两面刷上剩余黄油，平底锅中火煎至两面金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "压一个盘子在上面，受热更均匀。",
      "visual_cue": "表面金黄酥脆，按压有脆响"
    },
    {
      "n": 6,
      "text": "把三明治放入烤盘，表面抹一层白酱再撒剩余奶酪。",
      "time_min": 4,
      "heat": "无火",
      "tip": "白酱要抹到边缘，烤后才有那层焦壳。",
      "visual_cue": "表面铺满白酱与奶酪丝"
    },
    {
      "n": 7,
      "text": "放入二百二十度烤箱烤六分钟至奶酪起泡上色，撒黑胡椒上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "烤到奶酪冒泡焦点才够香，注意别烤糊。",
      "visual_cue": "表面金黄起泡，边缘微焦"
    }
  ],
  "tips": [
    "面包选厚切的，太薄会被白酱泡软塌陷。",
    "奶酪用格吕耶尔或孔泰，拉丝和香味都更好。",
    "想更豪华可加一枚半熟煎蛋，做成 croque madame。"
  ],
  "common_mistakes": [
    "白酱太稀，抹上去直接流下来，成品水塌塌。",
    "煎的时候火太大，面包焦了奶酪还没化。",
    "奶酪丝撒得太少，吃不出拉丝和奶香。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "培根",
      "ratio": "120 克:100 克",
      "note": "先煎出油，咸味更重可减盐。"
    },
    {
      "original": "牛奶",
      "substitute": "奶油",
      "ratio": "200 毫升:180 毫升",
      "note": "白酱更浓郁，烤制时间缩短两分钟。"
    }
  ],
  "variations": [
    "在表面加一枚煎蛋，就是经典的 croque madame。",
    "把火腿换成烤鸡胸片，口感更清爽。"
  ],
  "serving_suggestion": "切半装盘，配一份绿叶沙拉或酸黄瓜解腻。",
  "storage": "现做现吃；冷藏一天后复烤一百八十度八分钟恢复酥脆。",
