  "equipment": [
    "汤锅",
    "料理棒",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜去皮去籽切 3cm 块，洋葱切丝，大蒜切片备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "南瓜块切小一点，煮的时间能缩短。",
      "visual_cue": "南瓜块大小一致、洋葱丝均匀"
    },
    {
      "n": 2,
      "text": "汤锅小火融化 30g 黄油，下洋葱丝与蒜片炒 6 分钟至透明出甜味。",
      "time_min": 8,
      "heat": "小火",
      "tip": "洋葱炒透出甜，汤才不需要加糖。",
      "visual_cue": "洋葱丝软塌透明、锅底微黄"
    },
    {
      "n": 3,
      "text": "加入南瓜块翻炒 2 分钟，倒入 600ml 清水，大火烧开转小火煮 20 分钟。",
      "time_min": 24,
      "heat": "小火",
      "tip": "水刚没过南瓜即可，太多汤会稀。",
      "visual_cue": "南瓜用勺子一压就烂"
    },
    {
      "n": 4,
      "text": "用料理棒打成细腻糊状，边打边加 150ml 淡奶油搅匀。",
      "time_min": 5,
      "heat": "小火",
      "tip": "打之前离火，避免烫伤。",
      "visual_cue": "汤体顺滑无颗粒、能挂勺"
    },
    {
      "n": 5,
      "text": "加 5g 盐、2g 黑胡椒与 1g 肉豆蔻调味，小火回温 3 分钟不要煮沸。",
      "time_min": 4,
      "heat": "小火",
      "tip": "加了奶油的汤一沸就容易分层。",
      "visual_cue": "汤面细腻泛光、香气圆润"
    },
    {
      "n": 6,
      "text": "面包丁拌 15ml 橄榄油，180℃ 烤 8 分钟至金黄，撒在汤面即可上桌。",
      "time_min": 10,
      "heat": "中火",
      "tip": "面包丁现烤现撒，脆感最好。",
      "visual_cue": "面包丁金黄酥脆、汤面漂浮"
    }
  ],
  "tips": [
    "南瓜选贝贝南瓜，甜度更高水分更少。",
    "打汤时先离火再上料理棒，安全且不易飞溅。",
    "奶油最后加温不要煮沸，否则容易油水分离。"
  ],
  "common_mistakes": [
    "南瓜直接冷水下锅久煮，甜味被水稀释得寡淡。",
    "汤煮沸后再倒奶油，出现絮状颗粒。",
    "没用料理棒打细，喝起来满口纤维渣。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "椰浆",
      "ratio": "150ml 对 150ml",
      "note": "做成纯素版，风味偏东南亚。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "30g 对 25ml",
      "note": "奶香减弱但更清爽。"
    }
  ],
  "variations": [
    "烤南瓜版：南瓜先 200℃ 烤 25 分钟再煮，焦糖香更浓。",
    "姜味版：加 5g 姜末同炒，暖身效果更好。"
  ],
  "serving_suggestion": "盛入温过的深盘，撒面包丁与少许南瓜籽油，配法棍食用。",
  "storage": "冷藏 2 天，冷冻 1 个月；复热时加少量水调稀。",
