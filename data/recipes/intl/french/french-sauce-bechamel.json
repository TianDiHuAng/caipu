  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 500,
          "unit": "ml",
          "note": "全脂牛奶",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 40,
          "unit": "g",
          "note": "无盐黄油",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 40,
          "unit": "g",
          "note": "中筋粉",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
          "note": "去腥提香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底小锅",
    "打蛋器",
    "量杯",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶倒进小锅小火温到锅边冒小泡，不要煮沸，离火备用。",
      "time_min": 3,
      "heat": "小火",
      "tip": "牛奶温着加才不会结块，冷奶冲进面糊会立刻起疙瘩。",
      "visual_cue": "锅边冒小泡，表面结薄皮"
    },
    {
      "n": 2,
      "text": "另一口厚底锅化黄油，倒面粉用木勺不停搅炒两分钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油和面粉一比一才不出油，粉多了酱发干，油多了酱稀散。",
      "visual_cue": "面糊顺滑，锅底不起焦斑"
    },
    {
      "n": 3,
      "text": "面糊炒到起细泡、闻起来有坚果香，离火稍晾半分钟。",
      "time_min": 2,
      "heat": "小火",
      "tip": "炒到面糊发香再离火，生面粉味炒掉，酱才不带生面气。",
      "visual_cue": "面糊微黄起泡，闻着带坚果香"
    },
    {
      "n": 4,
      "text": "分三次倒入温牛奶，每次都搅到完全融合再加下一次。",
      "time_min": 3,
      "heat": "小火",
      "tip": "分次加是关键，一次全冲进去，面糊就结成难打散的块。",
      "visual_cue": "酱体顺滑无颗粒，能挂勺"
    },
    {
      "n": 5,
      "text": "回火煮两分钟至微稠，加盐与白胡椒，尝味后离火。",
      "time_min": 1,
      "heat": "小火",
      "tip": "煮到能挂住勺背就够，煮太久水分收干，凉了会结成硬块。",
      "visual_cue": "酱汁能挂住勺背，表面光亮"
    }
  ],
  "tips": [
    "白汁是法餐五大母酱之一，加奶酪成莫内酱，加洋葱成苏比斯酱。",
    "酱体太稠可以补一勺温牛奶，太稀就再多煮两分钟收水。",
    "做焗菜时表面撒一层奶酪烤上色，就是最家常的吃法。"
  ],
  "common_mistakes": [
    "牛奶是冷的就一次倒进面糊，酱里全是小疙瘩，越搅越糟。",
    "面粉没炒透就加奶，成品带明显生面粉味，闻着像浆糊。",
    "大火煮酱还不停手，锅底焦一层，整锅酱带糊味无法挽救。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "40克:35毫升",
      "note": "橄榄油版颜色浅，风味偏清。"
    },
    {
      "original": "牛奶",
      "substitute": "豆浆",
      "ratio": "500毫升:500毫升",
      "note": "豆浆版需减盐，豆味明显。"
    }
  ],
  "variations": [
    "加一小撮肉豆蔻粉，是经典的法式调味，香气更暖。",
    "用一半牛奶一半高汤，做成半白汁，配鸡肉更合适。"
  ],
  "serving_suggestion": "趁热浇在煮好的蔬菜、意面或焗饭上，也可作为其他酱汁的底。",
  "storage": "冷藏可存两天，表面贴一层保鲜膜防结皮，复热需小火加少量牛奶稀释。",
