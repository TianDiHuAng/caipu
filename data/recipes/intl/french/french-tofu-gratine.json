  "equipment": [
    "烤盘",
    "小汤锅",
    "打蛋器",
    "擦丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切一厘米厚片，撒三克盐静置十分钟后吸干水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "豆腐先出水再焗，不然烤盘底会积一滩水，白汁全稀掉。",
      "visual_cue": "豆腐片收紧，表面干爽"
    },
    {
      "n": 2,
      "text": "小锅化黄油炒面粉，小火搅两分钟到起小泡不结块。",
      "time_min": 4,
      "heat": "小火",
      "tip": "面粉要炒到微微发香，生面粉味会一路带进成品里。",
      "visual_cue": "面糊起泡，闻着有麦香"
    },
    {
      "n": 3,
      "text": "分三次倒入温牛奶，每次都搅到顺滑，煮到挂勺。",
      "time_min": 7,
      "heat": "小火",
      "tip": "牛奶要温的，冷牛奶一倒进去面糊立刻结块，搅不散。",
      "visual_cue": "白汁浓稠挂勺，无颗粒"
    },
    {
      "n": 4,
      "text": "白汁加盐、黑胡椒与肉豆蔻搅匀调味，然后离火备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "肉豆蔻是白汁的灵魂，只用一点点就够，多了发苦。",
      "visual_cue": "白汁顺滑，闻着奶香带豆蔻"
    },
    {
      "n": 5,
      "text": "烤盘抹黄油，铺一层洋葱与香菇，摆上豆腐片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱和香菇垫底能托住豆腐，也让汁水有地方渗下去。",
      "visual_cue": "豆腐排列整齐，配料垫底"
    },
    {
      "n": 6,
      "text": "浇满白汁，撒上奶酪丝，进二百度烤箱烤二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "奶酪要撒到边缘，烤出一圈焦壳才算焗到位。",
      "visual_cue": "表面金黄起泡，边缘焦脆"
    }
  ],
  "tips": [
    "焗烤是法国家常做法，剩菜浇上白汁加奶酪烤一烤就成新菜。",
    "豆腐选老豆腐，嫩豆腐焗完会散成一摊。",
    "表面撒一层干面粉烤出的薄壳，脆感比单用奶酪更足。"
  ],
  "common_mistakes": [
    "豆腐没出水直接焗，盘底一汪水，白汁全稀掉。",
    "白汁用冷牛奶调，结成一粒粒面疙瘩。",
    "奶酪撒太少，烤完表面发干，没有焦壳拉丝。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "马苏里拉",
      "ratio": "120克:120克",
      "note": "马苏里拉拉丝更好，咸度低需补盐。"
    },
    {
      "original": "牛奶",
      "substitute": "豆浆",
      "ratio": "300毫升:300毫升",
      "note": "豆浆版更清爽，需加一勺面粉增稠。"
    }
  ],
  "variations": [
    "加一把菠菜同焗，颜色和营养都更好。",
    "换成南瓜片垫底，甜味渗进白汁里，秋冬很合适。"
  ],
  "serving_suggestion": "出炉静置五分钟再切，配一份简单的生菜沙拉解腻。",
  "storage": "冷藏可存两天，复烤十分钟即可恢复表面那层脆壳。",
