  "steps": [
    {
      "n": 1,
      "text": "三文鱼排擦干，两面抹盐和黑胡椒。，顺序照着来，层次才明显。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼排擦干，蒸时才不出水。，汤汁别收太干，味道才不闷。",
      "visual_cue": "表面干爽，鱼肉紧实，注意别烧干，味道才不闷。"
    },
    {
      "n": 2,
      "text": "胡萝卜、芹菜和洋葱切细丝，拌在一起。，下手别慌，味道才站得住。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丝切细，铺底才均匀。，留意锅底，成品才好看。",
      "visual_cue": "丝细一致，颜色清爽，留点余量更好，表面才漂亮。"
    },
    {
      "n": 3,
      "text": "油纸裁成四张，各铺一层蔬菜丝。，火别太大，口感才有层次。",
      "time_min": 6,
      "heat": "无火",
      "tip": "纸要够大，包起来才不漏。，锅温要匀，香气才不跑。",
      "visual_cue": "纸边平整，菜丝居中，起锅前尝味，成品才好看。"
    },
    {
      "n": 4,
      "text": "鱼排放在菜丝上，放百里香和黄油。，注意别烧干，食材才不糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油分小块，化得才匀。，动作放连贯，表面才漂亮。",
      "visual_cue": "鱼皮朝下，黄油分布均匀"
    },
    {
      "n": 5,
      "text": "淋白葡萄酒，撒欧芹，盖两片柠檬。，留意锅底，整道菜才立得住。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酒别倒太多，免得出水。，料别一次下太多，口感才不发柴。",
      "visual_cue": "酒香散出，柠檬贴面，手法轻些，食材才不糊。"
    },
    {
      "n": 6,
      "text": "纸对折，边缘卷紧封口成包。，留意锅底，味道才不闷。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边缘卷两圈，蒸汽才跑不掉。，动作放连贯，口感才不散。",
      "visual_cue": "封口紧实，纸包鼓起，别急着加油，表面才漂亮。"
    },
    {
      "n": 7,
      "text": "烤盘上摆纸包，二百度烤十五分钟。，料别一次下太多，整道菜才立得住。",
      "time_min": 17,
      "heat": "无火",
      "tip": "时间看鱼排厚度微调。，料别一次下太多，成品才好看。",
      "visual_cue": "纸包鼓起，香气外溢，慢慢来别急，形状才完整。"
    },
    {
      "n": 8,
      "text": "取出稍放一分，剪开纸包再盛盘。，眼观颜色就行，风味才干净。",
      "time_min": 4,
      "heat": "无火",
      "tip": "剪开时朝外，蒸汽才不会扑面。，盖盖焖一会儿，形状才完整。",
      "visual_cue": "纸内蒸汽腾起，鱼肉雪白"
    }
  ],
  "tips": [
    "鱼排擦干再包，蒸汽才不浑浊。，汤汁别收太干，颜色才够亮。",
    "纸边卷紧，香气才留得住。，翻动放轻，味道才不闷。",
    "出炉稍放一会儿再剪，蒸汽才不烫手。，翻动放轻，口感才有层次。"
  ],
  "common_mistakes": [
    "纸包没封严，鱼肉烤干。，保持中小火，口感才不发柴。",
    "酒倒太多，纸包积成汤。，慢慢来别急，咸淡才好把握。",
    "烤过头，鱼肉发柴。，下手别慌，香气才留得住。"
  ],
  "substitutions": [
    {
      "original": "三文鱼",
      "substitute": "鳕鱼",
      "ratio": "800 克:800 克",
      "note": "肉更白，烤制时间减三分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "高汤",
      "ratio": "60 毫升:60 毫升",
      "note": "无酒精版本，香气更淡。"
    }
  ],
  "variations": [
    "加几片番茄同包，汁水更足。，料别一次下太多，味道才进得去。",
    "加一小勺淡奶油，口感更厚。，时间掐准，整道菜才立得住。"
  ],
  "serving_suggestion": "连纸包上桌，配土豆或面包。，盖盖焖一会儿，口感才不发柴。",
  "storage": "冷藏一天，复热用烤箱低温。，份量心里有数，样子才体面。",
