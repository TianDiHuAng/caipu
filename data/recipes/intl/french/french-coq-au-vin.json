          "name_en": "bacon",
          "amount": 80,
          "unit": "g",
          "note": "切条煸出油",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 150,
          "unit": "g",
          "note": "切粗丝",
          "optional": false
        },
        {
          "name": "胡萝卜",
          "name_en": "carrot",
          "amount": 120,
