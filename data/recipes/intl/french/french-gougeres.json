        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "打蛋器",
    "烤盘",
    "裱花袋",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅放牛奶、黄油、盐和黑胡椒，中火煮到黄油完全融化沸腾。",
      "time_min": 5,
      "heat": "中火",
      "tip": "要煮到真正沸腾再下粉，面糊才起筋。",
      "visual_cue": "液面翻滚，黄油化开，状态稳定"
    },
    {
      "n": 2,
      "text": "关火一次性倒入过筛面粉，用木勺快速搅成不粘锅的团。",
      "time_min": 4,
      "heat": "无火",
      "tip": "离火再倒粉，避免结块成疙瘩。，注意火候。",
      "visual_cue": "面团成团，锅底干净，状态稳定"
    },
    {
      "n": 3,
      "text": "重新小火加热，边翻拌边烘干两分钟到锅底起一层薄膜。",
      "time_min": 4,
      "heat": "小火",
      "tip": "烘掉多余水分，泡芙才膨胀得起来。，注意火候。",
      "visual_cue": "面团发亮，锅底有膜，状态稳定"
    },
    {
      "n": 4,
      "text": "离火分三次加入蛋液，每次都拌到完全吸收再加下一次。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蛋液别一次倒完，多加会塌、少了会硬。",
      "visual_cue": "面团顺滑，能挂住木勺"
    },
    {
      "n": 5,
      "text": "加入奶酪丝和留出的一小撮，拌匀成浓稠的奶酪面糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "奶酪留一点撒表面，烤出来才有焦壳。",
      "visual_cue": "面糊稠厚，带奶酪颗粒"
    },
    {
      "n": 6,
      "text": "面糊装进裱花袋，在铺纸的烤盘上挤出直径三厘米的圆球。",
      "time_min": 6,
      "heat": "无火",
      "tip": "球与球之间留两指宽，膨胀后才不粘连。",
      "visual_cue": "圆球大小一致，状态稳定"
    },
    {
      "n": 7,
      "text": "表面刷一层蛋液，撒上预留的奶酪丝，烤箱两百度烤二十二分钟。",
      "time_min": 24,
      "heat": "-",
      "tip": "中途别开烤箱门，冷风一灌就塌。，注意火候。",
      "visual_cue": "表面金黄，体积鼓起，状态稳定"
    },
    {
      "n": 8,
      "text": "出炉后放两分钟再脱盘，趁温热吃口感最好。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出炉就吃，凉了外壳会变韧。，注意火候。",
      "visual_cue": "外壳脆硬，内部空心，状态稳定"
    }
  ],
  "tips": [
    "面糊要烘干到锅底起膜，泡芙才膨胀。，值得留意。",
    "蛋液分次加，面糊能缓慢滑落就够。，值得留意。",
    "烤的时候别开烤箱门，遇冷会塌陷。，值得留意。"
  ],
  "common_mistakes": [
    "面粉倒进未沸腾的液体，团散成一疙瘩。",
    "蛋液一次加完，面糊稀得挤不成形。，务必避免。",
    "烤到一半开门查看，泡芙全部塌下去。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "格鲁耶尔奶酪",
      "ratio": "150 克:150 克",
      "note": "坚果香更浓，咸味略重可减盐。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "200 毫升:200 毫升",
      "note": "香气略淡，黄油可增十克。"
    }
  ],
  "variations": [
    "面糊里加少许肉豆蔻粉，香气更法式。，也很受欢迎。",
    "撒一层芝麻，表面更香也更脆。，也很受欢迎。"
  ],
  "serving_suggestion": "趁温热当餐前小点，配一杯干白葡萄酒最好。",
  "storage": "常温一天，复热用烤箱一百八十度烤五分钟恢复脆感。",
