  "equipment": [
    "擀面杖",
    "烤盘",
    "烤箱",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐与橄榄油，分次倒清水揉成光滑面团，盖布醒二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "面团要揉到表面光滑，醒够才擀得开，不然一擀就回缩。",
      "visual_cue": "面团光洁，按下去缓慢回弹"
    },
    {
      "n": 2,
      "text": "烤箱预热到二百四十度，烤盘一起放进去烤热。",
      "time_min": 10,
      "heat": "无火",
      "tip": "烤盘要先烤热，冷盘放上去饼底就发软，烤不出脆壳。",
      "visual_cue": "烤箱指示灯灭，烤盘烫手"
    },
    {
      "n": 3,
      "text": "洋葱切细丝，培根切细条，酸奶油加肉豆蔻与黑胡椒拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱要切得和培根一样细，太粗会出水，饼底泡软。",
      "visual_cue": "葱丝细白，奶油酱顺滑"
    },
    {
      "n": 4,
      "text": "面团擀成两三毫米厚的薄片，越薄越好，边缘略厚。",
      "time_min": 5,
      "heat": "无火",
      "tip": "擀得越薄越脆，厚了中间会发软，像在吃发面饼。",
      "visual_cue": "面片透光，厚度两三毫米均匀"
    },
    {
      "n": 5,
      "text": "面片移到烤盘，抹一层酸奶油，铺洋葱丝与培根条。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酸奶油别抹到边缘，留一圈空白，烤时奶油才不会溢出。",
      "visual_cue": "配料铺平，边缘留出一圈白"
    },
    {
      "n": 6,
      "text": "进烤箱烤十二分钟，边缘鼓起焦斑即可取出切块。",
      "time_min": 12,
      "heat": "无火",
      "tip": "烤到边缘焦黄起泡才是正宗口感，发白就出炉会软塌。",
      "visual_cue": "边缘焦脆起泡，饼底干脆"
    }
  ],
  "tips": [
    "阿尔萨斯薄饼是当地酒馆的下酒主食，配一杯雷司令最对味。",
    "传统用火炉烤，家用烤箱开到最高温效果接近。",
    "面团可以提前一晚揉好冷藏，第二天擀开就能用。"
  ],
  "common_mistakes": [
    "饼皮擀得太厚，烤完中间发软，咬着像面包。",
    "洋葱没切细直接铺，出水把饼底泡成一团糊。",
    "酸奶油抹到边缘，烤时流到烤盘上冒烟发苦。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "淡奶油",
      "ratio": "200克:180毫升",
      "note": "淡奶油更稀，需加一勺面粉调稠防流。"
    },
    {
      "original": "培根",
      "substitute": "火腿",
      "ratio": "120克:120克",
      "note": "火腿版咸度低，盐需略增。"
    }
  ],
  "variations": [
    "加一把擦碎的奶酪同烤，做成奶酪版，更接近现代表做法。",
    "放几片香菇同烤，做成素版，香气也不错。"
  ],
  "serving_suggestion": "出炉切成长方块，趁热用手拿着吃，配一杯冰啤酒。",
  "storage": "建议现烤现吃，冷藏后饼底回软，复烤两分钟可恢复部分脆度。",
