  "steps": [
    {
      "n": 1,
      "text": "牛肉切大块，用厨房纸吸干表面水分，撒盐与黑胡椒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉排干再煎，才煎得出褐色焦壳。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "肉块表面干爽，调味均匀"
    },
    {
      "n": 2,
      "text": "炖锅倒橄榄油烧热，牛肉分批下锅煎至四面焦褐盛出。",
      "time_min": 10,
      "heat": "大火",
      "tip": "分批煎不挤锅，肉才上色不冒水。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "肉块四周呈深褐色焦壳"
    },
    {
      "n": 3,
      "text": "原锅下洋葱丝与大蒜炒软，加番茄炒三分钟出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "锅底焦渣别洗掉，那是味道的来源。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "洋葱透明，锅底有褐色焦渣"
    },
    {
      "n": 4,
      "text": "倒红酒煮开刮起锅底焦渣，加高汤、香叶与百里香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "红酒刮锅底，酱汁才有厚度。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "酒液微稠，锅底焦渣溶入汁中"
    },
    {
      "n": 5,
      "text": "牛肉回锅烧开转小火加盖炖一小时。趁热操作更顺手。",
      "time_min": 63,
      "heat": "小火",
      "tip": "小火慢炖，牛肉才软糯不柴。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汤汁小滚，肉块轻晃色泽分明状态稳定"
    },
    {
      "n": 6,
      "text": "下胡萝卜块、白糖与盐继续炖三十五分钟至胡萝卜软透。",
      "time_min": 37,
      "heat": "小火",
      "tip": "胡萝卜后放，久炖会烂成泥。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "胡萝卜棱角圆润，筷子可穿透"
    }
  ],
  "tips": [
    "牛肉先煎出焦壳，味道才厚。火候与时间都要盯紧，宁可略短也别过头。",
    "红酒刮锅底这步别省，是风味关键。做之前把料备齐，下锅后就没空切配了。",
    "胡萝卜后放，炖久了会化。这几步照顺序来，味道才会一层层叠上去。",
    "一勺糖提胡萝卜的甜，不要尝出甜味。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "跳过煎肉，炖出来汤水味寡。结果往往一锅好料全被这一步毁掉。",
    "红酒直接倒进锅不煮，酒精味刺鼻。很多人就在这里翻车，出菜后才发现。",
    "胡萝卜一开始就下锅，最后找不着块。账面上看是小疏忽，入口立刻能尝出来。",
    "盐放太早，牛肉炖出渣。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "红酒",
      "substitute": "白葡萄酒",
      "ratio": "250毫升:250毫升",
      "note": "颜色更浅，可加半勺老抽上色。"
    },
    {
      "original": "牛肉",
      "substitute": "牛肩肉",
      "ratio": "800克:800克",
      "note": "更瘦，炖的时间加十分钟。"
    }
  ],
  "variations": [
    "加一把小洋葱同炖，甜味更足。口味会更厚一些，适合重口的人。",
    "加橙皮同炖，香气更亮。做法不复杂，家常灶台就能完成。",
    "汤汁收浓后配土豆泥，更法式。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "连汁带肉盛进深盘，胡萝卜橙红、牛肉深褐，汤汁拌土豆泥是最舒服的吃法。",
  "storage": "冷藏可放三天，复热小火加少量高汤；隔夜更入味。",
