  "equipment": [
    "炖锅",
    "平底锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐块用厨房纸包住轻压十分钟，压出多余水分，表面才裹得住面粉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "压水越彻底，炖的时候越能吸住酒汁不散。",
      "visual_cue": "豆腐块体积略缩，纸面湿透"
    },
    {
      "n": 2,
      "text": "豆腐块放进面粉里滚一圈，抖掉多余干粉，只留薄薄一层裹衣。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉太厚会糊成一团，薄薄一层就够上色。",
      "visual_cue": "豆腐表面均匀泛白，无粉块堆积"
    },
    {
      "n": 3,
      "text": "平底锅放一半黄油，豆腐块平铺煎到六面金黄结壳，盛出备用。",
      "time_min": 10,
      "heat": "中火",
      "tip": "黄油容易焦，火别大，边煎边转动锅子。",
      "visual_cue": "豆腐各面金黄，外壳微硬"
    },
    {
      "n": 4,
      "text": "炖锅里放剩下的黄油，下洋葱丁与胡萝卜块炒到洋葱透明、胡萝卜略软。",
      "time_min": 7,
      "heat": "中火",
      "tip": "胡萝卜先炒能带出甜味，炖出来不寡。",
      "visual_cue": "洋葱透明发亮，胡萝卜边缘发亮"
    },
    {
      "n": 5,
      "text": "加蒜末、百里香与香叶炒香，倒入红酒煮开，让酒精挥发两分钟。",
      "time_min": 5,
      "heat": "中大火",
      "tip": "红酒一定要滚开挥发酒精，否则成品带涩口的酒气。",
      "visual_cue": "酒液冒大泡，闻到果香不刺鼻"
    },
    {
      "n": 6,
      "text": "放回豆腐块，加高汤没过食材，中小火盖盖炖二十五分钟让豆腐吸饱酒汁。",
      "time_min": 25,
      "heat": "小火",
      "tip": "保持小泡微滚，大火会把豆腐炖散成渣。",
      "visual_cue": "汤汁转深红，豆腐块膨胀饱满"
    },
    {
      "n": 7,
      "text": "开盖放蘑菇，继续炖八分钟，用盐与黑胡椒调味，汤汁收浓到能挂勺。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "蘑菇后放保住弹性，早放会缩成一小团。",
      "visual_cue": "汤汁浓稠挂勺，蘑菇片挺立"
    },
    {
      "n": 8,
      "text": "关火挑出香叶，静置五分钟再盛盘，让汤汁回稠裹在豆腐表面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置后酱汁更贴豆腐，上桌不会流一盘子。",
      "visual_cue": "豆腐表面亮泽，汤汁均匀覆盖"
    }
  ],
  "tips": [
    "红酒选果味重、单宁柔的干红，太涩的酒炖出来会发苦。",
    "没有红酒可用高汤加一勺番茄膏代替，风味不同但同样好吃。",
    "黄油分两次用，最后一次可留一小块关火前拌进去，酱汁更亮。",
    "配土豆泥或面包最合适，汤汁别收太干。"
  ],
  "common_mistakes": [
    "红酒没煮开就盖盖炖，成品酒气冲鼻，酸涩压过豆香。",
    "豆腐不压水也不裹粉，下锅就散，炖完只剩碎渣。",
    "大火滚炖，豆腐表面坑洼，内部却还是白芯没入味。"
  ],
  "substitutions": [
    {
      "original": "红酒",
      "substitute": "葡萄汁",
      "ratio": "250毫升:250毫升",
      "note": "无酒精版，需补一勺白醋提酸度。"
    },
    {
      "original": "北豆腐",
      "substitute": "杏鲍菇",
      "ratio": "450克:400克",
      "note": "切同样大小块，口感更弹，炖制时间减五分钟。"
    }
  ],
  "variations": [
    "加一百克小洋葱与几片培根碎（素食者省略），风味更接近传统勃艮第做法。",
    "把胡萝卜换成小土豆块，汤汁更浓稠，适合配饭。"
  ],
  "serving_suggestion": "用浅口白瓷盘盛，豆腐放正中，汤汁浇在四周，配一小勺土豆泥与欧芹碎。",
  "storage": "冷藏三天内吃完，风味第二天更融合；冷冻会让豆腐出水变渣，不建议冷冻。",
