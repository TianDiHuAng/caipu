  ],
  "equipment": [
    "小锅",
    "打蛋器",
    "烤碗",
    "喷枪",
    "烤盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶油加香草荚小火加热到微微冒汽，关火焖五分钟让香气渗出后捞出荚壳。",
      "time_min": 8,
      "heat": "小火",
      "tip": "别煮沸，起皮就影响口感。",
      "visual_cue": "奶液冒汽、香气明显"
    },
    {
      "n": 2,
      "text": "蛋黄加 50g 白糖与盐打散，边搅边缓缓倒入温奶油，搅到完全融合。",
      "time_min": 5,
      "heat": "无火",
      "tip": "奶油要温不要烫，否则蛋会熟。",
      "visual_cue": "蛋奶液顺滑、颜色淡黄"
    },
    {
      "n": 3,
      "text": "蛋奶液过筛后倒进烤碗，放入注了热水的烤盘，150℃ 水浴烤二十五分钟。",
      "time_min": 25,
      "heat": "无火",
      "tip": "水浴慢烤，质地才细腻。",
      "visual_cue": "布蕾凝固、中心轻晃微颤"
    },
    {
      "n": 4,
      "text": "出炉放凉冷藏两小时，表面撒剩余白糖，用喷枪烧到焦糖化即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要薄薄一层，烧起来才脆。",
      "visual_cue": "表面琥珀脆壳、轻敲有声"
    }
  ],
  "tips": [
    "奶油加热到冒汽即可，煮沸会结皮影响细腻度。",
    "蛋奶液务必过筛，烤出的布蕾才无气泡。",
    "焦糖层要现烧现吃，久放会回软。"
  ],
  "common_mistakes": [
    "蛋奶液倒进滚烫奶油，蛋液直接结块。",
    "烤箱温度太高又不水浴，表面裂开呈蜂窝状。",
    "表面糖撒太厚，烧出的焦糖又苦又硬。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "牛奶",
      "ratio": "400ml 对 400ml 加 30g 黄油",
      "note": "质地更轻，烤制时间减 5 分钟。"
    },
    {
      "original": "香草荚",
      "substitute": "香草精",
      "ratio": "2g 对 3ml",
      "note": "直接拌入蛋奶液。"
    }
  ],
  "variations": [
    "柠檬版：奶油里加 10g 柠檬皮屑同焖。",
    "咖啡版：加 3g 速溶咖啡粉，风味更成人。"
  ],
  "serving_suggestion": "冷藏后现烧焦糖，配一小勺莓果解腻。",
  "storage": "布蕾冷藏可存 2 天，焦糖层须食用前再烧。",
