  "equipment": [
    "炖锅",
    "平底锅",
    "刀",
    "砧板",
    "碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切四厘米块，冷水下锅煮开三分钟撇沫后捞出冲净。",
      "time_min": 14,
      "heat": "大火",
      "tip": "冷水起锅焯，血沫去净汤才白。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "肉块发白，汤面浮沫被撇干净"
    },
    {
      "n": 2,
      "text": "炖锅放牛肉，加高汤、胡萝卜、洋葱、芹菜、香叶与百里香。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蔬菜垫底，汤才有底味不发寡。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "肉块被汤汁没过，香料浮在表面"
    },
    {
      "n": 3,
      "text": "大火烧开后转小火加盖炖一小时二十分钟至牛肉软烂。",
      "time_min": 83,
      "heat": "小火",
      "tip": "小火微沸，肉才酥而不散。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "汤面小滚，肉块轻压即散"
    },
    {
      "n": 4,
      "text": "另起平底锅化黄油，下面粉小火炒成浅黄色面酱。",
      "time_min": 6,
      "heat": "小火",
      "tip": "面酱只炒到浅黄，炒深汤就发褐。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "面酱呈浅米色，锅底无结块"
    },
    {
      "n": 5,
      "text": "舀两勺炖肉汤倒入面酱搅匀，再倒回炖锅搅至汤汁变稠。",
      "time_min": 5,
      "heat": "中火",
      "tip": "先调稀再回锅，才不结颗粒。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汤汁顺滑浓稠，无面疙瘩"
    },
    {
      "n": 6,
      "text": "下口蘑片煮十分钟，加淡奶油、盐、白胡椒与柠檬汁调匀。",
      "time_min": 13,
      "heat": "小火",
      "tip": "奶油最后加，久煮会分层。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "汤汁乳白，口蘑浮在表面"
    }
  ],
  "tips": [
    "焯水用冷水起锅，汤色才白。火候与时间都要盯紧，宁可略短也别过头。",
    "面酱只炒到浅黄，深了汤发灰。做之前把料备齐，下锅后就没空切配了。",
    "奶油最后放，煮久会分层。这几步照顺序来，味道才会一层层叠上去。",
    "柠檬汁收尾，解腻又提白。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "肉用热水焯，血沫锁在里面汤浑。结果往往一锅好料全被这一步毁掉。",
    "面酱直接下汤锅，结成一团疙瘩。很多人就在这里翻车，出菜后才发现。",
    "大火炖一小时，肉散成碎渣。账面上看是小疏忽，入口立刻能尝出来。",
    "奶油煮沸，汤汁出现颗粒分层。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛肋条",
      "ratio": "800克:800克",
      "note": "更肥，炖的时间缩短十分钟。"
    },
    {
      "original": "口蘑",
      "substitute": "香菇",
      "ratio": "200克:200克",
      "note": "香气更浓，汤色略深。"
    }
  ],
  "variations": [
    "加几颗小洋葱同炖，甜味更明显。口味会更厚一些，适合重口的人。",
    "配白饭或土豆泥一起吃，酱汁不浪费。做法不复杂，家常灶台就能完成。",
    "加一小勺芥末酱，风味更立体。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "用深盘盛出，浇上乳白酱汁撒欧芹碎，配米饭或煮土豆，是法国家常菜里的温柔一碗。",
  "storage": "冷藏可放两天，复热用小火加少量高汤搅匀；含奶油不宜反复加热。",
