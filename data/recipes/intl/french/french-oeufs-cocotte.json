  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 180,
          "unit": "g",
          "note": "三枚，每盅一枚",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 90,
          "unit": "ml",
          "note": "每盅三十毫升",
          "optional": false
        },
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 45,
          "unit": "g",
          "note": "擦丝",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切细圈",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 15,
          "unit": "g",
          "note": "刷盅防粘",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "每盅一小撮",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "肉豆蔻",
          "name_en": "nutmeg",
          "amount": 1,
          "unit": "g",
          "note": "现擦，可省略",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小烤盅",
    "烤箱",
    "小碗",
    "刷子",
    "汤锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤盅内壁用黄油仔细刷一遍，连底部弧角都要刷到，避免蛋液粘底。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷不匀的地方最容易结一层洗不掉的蛋膜，宁多勿少。",
      "visual_cue": "盅壁泛油光，无未刷到的干区"
    },
    {
      "n": 2,
      "text": "小锅把淡奶油加热到锅边冒小泡，加盐与肉豆蔻搅匀，离火放温。",
      "time_min": 4,
      "heat": "小火",
      "tip": "奶油微热就好，煮开会结皮，倒进蛋里影响口感。",
      "visual_cue": "奶油温热冒气，表面无结皮"
    },
    {
      "n": 3,
      "text": "每个烤盅里先倒一半的热奶油，铺满盅底，让奶油先垫底。",
      "time_min": 2,
      "heat": "无火",
      "tip": "奶油垫底能让蛋底不粘，也让成品层次更清楚。",
      "visual_cue": "盅壁泛着油光，没有没刷到的干区"
    },
    {
      "n": 4,
      "text": "小心把鸡蛋磕进盅里，蛋黄保持完整，别让蛋壳碎落进去。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先磕进小碗再滑进盅里，比直接磕更安全。",
      "visual_cue": "蛋黄居中不破，蛋白铺开"
    },
    {
      "n": 5,
      "text": "沿盅边淋入剩下的奶油，撒一小撮盐与现磨黑胡椒在黑胡椒上。",
      "time_min": 2,
      "heat": "无火",
      "tip": "奶油沿边淋，别直接冲蛋黄，否则蛋黄会被冲破。",
      "visual_cue": "奶油浮在蛋白边缘，蛋黄完整"
    },
    {
      "n": 6,
      "text": "烤盅放进深烤盘，盘里倒热水到盅身一半高，做成水浴。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水浴能保证蛋受热柔和，蛋白嫩滑不蜂窝。",
      "visual_cue": "水位到达盅身中线，盅体稳定"
    },
    {
      "n": 7,
      "text": "送进一百八十度烤箱烤十四分钟，蛋白凝固、蛋黄还软晃即可出炉。",
      "time_min": 14,
      "heat": "中火",
      "tip": "想吃全熟蛋黄就多烤三分钟，但蛋白会稍显粗糙。",
      "visual_cue": "蛋白乳白凝固，轻晃时蛋黄微颤"
    },
    {
      "n": 8,
      "text": "出炉撒上奶酪丝与葱花，静置两分钟让奶酪融化再上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置两分钟余温会把奶酪化开，也能让蛋盅不烫手。",
      "visual_cue": "奶酪半融，葱花碧绿点缀"
    }
  ],
  "tips": [
    "蛋一定要新鲜，越新鲜蛋白越紧实，烤出来形状越好看。",
    "盅里垫一层炒软的蘑菇或菠菜，底下有料更好吃。",
    "没有小烤盅可以用耐热小碗代替，高度浅的话缩短两分钟。",
    "配一片烤得脆的法棍，用来蘸蛋黄最合适。"
  ],
  "common_mistakes": [
    "奶油煮沸后直接倒进盅里，蛋液还没进烤箱边缘就已凝固。",
    "不用水浴直接烤，蛋白表面结成硬皮，内部却在出水。",
    "烤过头蛋黄完全变干，失去蘸面包的意义。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "90毫升:90毫升",
      "note": "口感更清爽少油，但少了圆润的奶香。"
    },
    {
      "original": "奶酪",
      "substitute": "帕玛森碎",
      "ratio": "45克:30克",
      "note": "咸味更重，盐量减半。"
    }
  ],
  "variations": [
    "盅底铺一层烟熏三文鱼再打蛋，做成更丰盛的早午餐版本。",
    "加一勺番茄酱在奶油里，酸甜味更开胃，颜色也漂亮。"
  ],
  "serving_suggestion": "配烤法棍片与一小份沙拉，是法式早午餐的经典组合。",
  "storage": "现做现吃，冷藏后复热蛋白会发韧；蛋液不建议提前混合保存。",
