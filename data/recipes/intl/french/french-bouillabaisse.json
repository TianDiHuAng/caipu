  "steps": [
    {
      "n": 1,
      "text": "青口刷净外壳泡在盐水里吐沙，鳕鱼切大块擦干水分。",
      "time_min": 15,
      "heat": "无火",
      "tip": "青口壳缝里的泥沙要刷掉，一颗带沙整锅汤都得倒掉。",
      "visual_cue": "贝壳发亮，盆底沉细沙"
    },
    {
      "n": 2,
      "text": "深汤锅倒橄榄油，下洋葱末与蒜末小火炒到洋葱透明。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒出甜味汤才厚，急火只把蒜炒焦，汤带苦。",
      "visual_cue": "洋葱透明软塌，蒜香散出"
    },
    {
      "n": 3,
      "text": "加番茄碎炒成浓酱，倒白葡萄酒煮两分钟让酒气散尽。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄要炒到出红油，汤的颜色和厚度全靠这一层。",
      "visual_cue": "番茄成酱，锅边见红油"
    },
    {
      "n": 4,
      "text": "倒入清水与泡开的藏红花煮开，转小火煮十五分钟成汤底。",
      "time_min": 17,
      "heat": "小火",
      "tip": "藏红花要先用温水泡，直接撒干花丝，颜色出不来还发苦。",
      "visual_cue": "汤色转金黄，香气混着海味"
    },
    {
      "n": 5,
      "text": "先放鳕鱼块煮五分钟，再下虾仁与青口煮到贝壳全开。",
      "time_min": 8,
      "heat": "中火",
      "tip": "贝壳不开的立刻挑出，那颗已经死了，煮着只会毁掉整锅汤。",
      "visual_cue": "贝壳张开，鱼肉变白不透明"
    },
    {
      "n": 6,
      "text": "补盐与黑胡椒调味，撒欧芹碎，连汤带料盛进深盘。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐要最后补，海鲜本身带咸，早放很容易过咸。",
      "visual_cue": "汤面金黄，欧芹碎漂在上层"
    }
  ],
  "tips": [
    "马赛鱼汤是普罗旺斯渔港的家常菜，渔民把卖不掉的杂鱼一锅炖。",
    "传统吃法是汤与鱼分开上，汤配面包片和蒜香酱。",
    "鱼种越杂汤越鲜，家里用两三种海鱼就够。"
  ],
  "common_mistakes": [
    "青口没吐沙就下锅，喝到最后满嘴沙粒。",
    "藏红花直接干撒，汤色发淡还带一丝苦。",
    "鱼和虾一起下锅久煮，虾仁缩成硬球，鱼肉全散。"
  ],
  "substitutions": [
    {
      "original": "青口",
      "substitute": "蛤蜊",
      "ratio": "300克:300克",
      "note": "蛤蜊吐沙时间需延长到一小时。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "料酒",
      "ratio": "100毫升:80毫升",
      "note": "料酒版少了果香，可加半个柠檬的汁补酸。"
    }
  ],
  "variations": [
    "加几只小章鱼同炖，汤更浓，是马赛海边常见的做法。",
    "放半个茴香头同煮，汤里带一点甘草香，风味更正。"
  ],
  "serving_suggestion": "盛进深盘，配烤面包片和一小碟蒜香蛋黄酱一起吃。",
  "storage": "冷藏可存两天，复热须煮开；贝壳类海鲜隔夜后不建议再存。",
