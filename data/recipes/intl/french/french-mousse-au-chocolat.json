  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "黑巧克力",
          "name_en": "dark chocolate",
          "amount": 200,
          "unit": "g",
          "note": "黑巧克力切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 120,
          "unit": "g",
          "note": "蛋黄蛋白分开",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 50,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "增润",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 60,
          "unit": "ml",
          "note": "调稀",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "碗",
    "打蛋器",
    "小锅",
    "刮刀",
    "模具"
  ],
  "steps": [
    {
      "n": 1,
      "text": "巧克力切成碎屑放进碗里，隔水用小火慢慢融化至顺滑。",
      "time_min": 6,
      "heat": "小火",
      "tip": "水温别超过六十度，巧克力才不出油发白。",
      "visual_cue": "巧克力顺滑，无颗粒，状态稳定"
    },
    {
      "n": 2,
      "text": "融化后加入黄油搅匀，再倒入牛奶拌到降温不烫手。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶分两次加，一次倒进去容易油水分离。",
      "visual_cue": "糊体光亮，质地浓稠，状态稳定"
    },
    {
      "n": 3,
      "text": "蛋黄和蛋白分开，蛋黄加一半白糖搅到颜色变浅发白。",
      "time_min": 5,
      "heat": "无火",
      "tip": "搅到蛋黄糊能画出纹路，口感才细腻。",
      "visual_cue": "蛋黄浅黄，质地浓稠，状态稳定"
    },
    {
      "n": 4,
      "text": "把巧克力糊分两次拌进蛋黄糊，翻拌到完全均匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "翻拌别画圈，用刮刀抄底翻才不会消泡。",
      "visual_cue": "糊体均匀，颜色深褐，状态稳定"
    },
    {
      "n": 5,
      "text": "蛋白分三次加剩余白糖，打到提起有小弯钩的湿性发泡。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打到小弯钩就停，打太硬拌的时候容易结块。",
      "visual_cue": "蛋白白亮，弯钩挺立，状态稳定"
    },
    {
      "n": 6,
      "text": "蛋白霜分三次拌进巧克力糊，用刮刀快速轻翻均匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "动作要轻要快，拌久了气泡全消就发硬。",
      "visual_cue": "糊体蓬松，颜色均匀，状态稳定"
    },
    {
      "n": 7,
      "text": "倒进模具抹平，冷藏四小时以上到完全凝固定型。",
      "time_min": 6,
      "heat": "无火",
      "tip": "至少四小时，中间没凝住切开会塌。，注意火候。",
      "visual_cue": "糊面平整，轻晃不流动"
    }
  ],
  "tips": [
    "巧克力隔水融化，水温别超过六十度。，值得留意。",
    "蛋白打到湿性发泡，慕斯口感才轻盈。，值得留意。",
    "冷藏至少四小时，中间彻底凝住才好切。"
  ],
  "common_mistakes": [
    "巧克力直接火上加热，底部发焦发苦。，务必避免。",
    "蛋白打得太硬，拌进去后一粒粒结块。，务必避免。",
    "冷藏两小时就切，慕斯软塌流一桌。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "巧克力",
      "substitute": "可可粉加黄油",
      "ratio": "200 克:80 克加 120 克",
      "note": "风味更苦，白糖加二十克。"
    },
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "60 毫升:60 毫升",
      "note": "带椰香，适合不吃乳制品的人。"
    }
  ],
  "variations": [
    "拌入少许橙皮屑，果香和苦甜很搭。，也很受欢迎。",
    "表面撒可可粉，颜色对比更好看。，也很受欢迎。"
  ],
  "serving_suggestion": "冷藏后挖球装杯，配一颗树莓或一杯浓缩咖啡。",
  "storage": "冷藏两天，密封保存避免串味。，效果更稳定。",
