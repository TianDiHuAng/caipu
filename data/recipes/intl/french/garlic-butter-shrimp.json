  "equipment": [
    "平底锅",
    "锅铲",
    "厨房纸",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾去壳留尾，从背部划开挑出虾线，用厨房纸把表面水分彻底吸干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "擦干才煎得出焦香，不然是水煮。",
      "visual_cue": "虾身干爽、虾线干净"
    },
    {
      "n": 2,
      "text": "平底锅倒橄榄油中火烧热，虾单层摊开煎一分半至卷曲变色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "别挤锅，分两批煎更好。",
      "visual_cue": "虾身卷曲、表面橙红"
    },
    {
      "n": 3,
      "text": "翻面再煎一分钟盛出，原锅下蒜末小火炒香，倒入白葡萄酒刮起锅底焦香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末别炒黄，一黄就苦。",
      "visual_cue": "蒜香散出、锅底焦物溶开"
    },
    {
      "n": 4,
      "text": "关小火放黄油搅到融化，虾回锅翻匀，撒盐与黑胡椒，挤柠檬汁。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油别烧到起泡变褐。",
      "visual_cue": "酱汁乳化发亮、虾身裹汁"
    },
    {
      "n": 5,
      "text": "出锅撒香菜碎，把锅里的蒜香黄油全部淋在虾上。",
      "time_min": 1,
      "heat": "无火",
      "tip": "酱汁是精华，一滴都别浪费。",
      "visual_cue": "蒜末金黄、酱汁挂壁"
    }
  ],
  "tips": [
    "虾一定要擦干再下锅，湿润的虾只会被煮熟而不是煎香。",
    "黄油最后加并保持小火，高温会让它焦化发苦。",
    "蒜末炒到香气出来即可，颜色一变黄就苦了。"
  ],
  "common_mistakes": [
    "虾没擦干就下锅，煎出一锅水，完全结不出焦壳。",
    "黄油和蒜一起大火炒，蒜焦黄油也发褐。",
    "煎好的虾在锅里久放，回缩发硬。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "扇贝",
      "ratio": "350g 对 350g",
      "note": "每面煎一分半再翻。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "料酒",
      "ratio": "40ml 对 30ml",
      "note": "香气略冲，用量减少。"
    }
  ],
  "variations": [
    "辣味版：加 5g 辣椒碎与蒜末同炒。",
    "香草版：出锅加 3g 百里香叶与香菜同撒。"
  ],
  "serving_suggestion": "配烤法棍蘸锅底的蒜香黄油，或铺在意面上。",
  "storage": "冷藏可存 1 天，复热用平底锅小火，勿微波加热。",
