  "equipment": [
    "小锅",
    "打蛋器",
    "刀",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蓝纹奶酪捏碎，留一小把最后加。，保持中小火，成品才好看。",
      "time_min": 5,
      "heat": "无火",
      "tip": "留生奶酪，香气才活。，时间掐准，味道才不闷。",
      "visual_cue": "碎块松散，颜色斑驳，锅温要匀，整道菜才立得住。"
    },
    {
      "n": 2,
      "text": "小锅小火化黄油，加面粉炒匀。，锅温要匀，锅气才足。",
      "time_min": 4,
      "heat": "小火",
      "tip": "炒面粉别上色，白一点。，锅温要匀，口感才不发柴。",
      "visual_cue": "面糊顺滑，无干粉，时间掐准，火候才均匀。"
    },
    {
      "n": 3,
      "text": "分次倒牛奶，边倒边搅。，别反复翻动，成品才稳当。",
      "time_min": 5,
      "heat": "小火",
      "tip": "一点一点加，才不起疙瘩。，时间掐准，味道才进得去。",
      "visual_cue": "糊体发亮，无颗粒，汤汁别收太干，香气才不跑。"
    },
    {
      "n": 4,
      "text": "倒淡奶油和白葡萄酒，搅匀煮开。，火别太大，咸淡才好把握。",
      "time_min": 5,
      "heat": "小火",
      "tip": "酒先煮开，味道才干净。，看着泡沫就够，吃口才舒服。",
      "visual_cue": "汁面起泡，酒气挥发，留意锅底，口感才有层次。"
    },
    {
      "n": 5,
      "text": "加奶酪碎，小火搅到完全融。，别用力搅，成品才好看。",
      "time_min": 6,
      "heat": "小火",
      "tip": "别大火，奶酪会分离。，留意锅底，火候才均匀。",
      "visual_cue": "汁体浓稠，颜色灰蓝，眼观颜色就行，香气才留得住。"
    },
    {
      "n": 6,
      "text": "加盐和黑胡椒，尝一次咸淡。，先试试温度，吃口才舒服。",
      "time_min": 2,
      "heat": "小火",
      "tip": "奶酪已咸，盐要少放。，注意别烧干，味道才进得去。",
      "visual_cue": "咸淡合适，奶香浓，别反复翻动，层次才明显。"
    },
    {
      "n": 7,
      "text": "关火加最后一把奶酪，搅到半融。，别用力搅，形状才完整。",
      "time_min": 3,
      "heat": "无火",
      "tip": "关火加，香气才不散。，先试试温度，层次才明显。",
      "visual_cue": "汁面有奶酪颗粒感，别用力搅，味道才不闷。"
    },
    {
      "n": 8,
      "text": "撒欧芹碎，趁热浇在牛排上。，保持中小火，味道才进得去。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁凉就稠，趁热用。，料别一次下太多，味道才不闷。",
      "visual_cue": "汁亮油润，香气扑鼻，留意锅底，颜色才够亮。"
    }
  ],
  "tips": [
    "奶酪分两次加，香气才有层次。，别反复翻动，香气才留得住。",
    "全程小火，奶酪才不分离。，起锅前尝味，味道才不闷。",
    "汁稠可加牛奶，稀可多煮一会儿。，下手别慌，口感才不散。"
  ],
  "common_mistakes": [
    "大火加热，奶酪油水分离。，盖盖焖一会儿，味道才进得去。",
    "面粉一次倒完，结疙瘩。，下手别慌，表面才漂亮。",
    "盐放多，盖住奶酪味。，顺序照着来，风味才干净。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "羊乳酪",
      "ratio": "300 克:300 克",
      "note": "咸味更重，盐可省。"
    },
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "200 毫升:200 毫升",
      "note": "更清爽，需多加面粉五克。"
    }
  ],
  "variations": [
    "加一点芥末籽，风味更冲。，火别太大，细节才到位。",
    "加炒洋葱碎，甜味更足。，锅温要匀，细节才到位。"
  ],
  "serving_suggestion": "配牛排、烤土豆或西兰花。，料切得匀些，味道才稳。",
  "storage": "冷藏两天，复热小火加牛奶。，别急着开盖，味道才稳。",
