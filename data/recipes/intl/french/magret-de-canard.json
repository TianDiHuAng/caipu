  "equipment": [
    "平底锅",
    "夹子",
    "锡纸",
    "锋利刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸭胸 700g 用厨房纸吸干水分，皮面用刀划出菱形花刀，只划到脂肪层。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别划到肉，否则煎时汁水全流失。",
      "visual_cue": "皮面菱形纹路清晰"
    },
    {
      "n": 2,
      "text": "两面均匀撒 4g 盐与 2g 黑胡椒，室温静置 10 分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "提前回温，煎出来内外熟度才均匀。",
      "visual_cue": "调味均匀、皮面干爽"
    },
    {
      "n": 3,
      "text": "平底锅不放油，鸭胸皮朝下冷锅下入，小火煎 10 分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "冷锅下鸭胸，脂肪才慢慢逼出来。",
      "visual_cue": "鸭胸皮金黄、锅内积起鸭胸油"
    },
    {
      "n": 4,
      "text": "把鸭胸油倒出留用，翻面加蒜与百里香，中火煎 4 分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸭胸油别扔，留着煎蔬菜非常香。",
      "visual_cue": "肉面焦褐、香草出香"
    },
    {
      "n": 5,
      "text": "加 15g 黄油，用勺把融化的黄油反复浇在鸭胸肉面上。",
      "time_min": 3,
      "heat": "中火",
      "tip": "浇淋让肉面均匀受热，别只煎一面。",
      "visual_cue": "肉面油亮、黄油起泡"
    },
    {
      "n": 6,
      "text": "取出鸭胸用锡纸松包，静置 8 分钟让肉汁回流。",
      "time_min": 8,
      "heat": "无火",
      "tip": "静置不能省，切开才不流血水。",
      "visual_cue": "肉汁回收、锡纸内无积液"
    },
    {
      "n": 7,
      "text": "逆纹切成 1 厘米厚片，肉面呈粉红即可装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "逆纹切，口感才不柴。",
      "visual_cue": "切面呈粉红色、皮面金黄"
    }
  ],
  "tips": [
    "皮面划花刀只划脂肪层，别伤到肉。",
    "冷锅下鸭胸小火慢煎，脂肪才逼得干净。",
    "静置 8 分钟再切，肉汁才不会流失。"
  ],
  "common_mistakes": [
    "大火下锅，皮焦了里面还是生的。",
    "不静置直接切，肉汁全流在盘子里。",
    "顺着纹理切片，吃起来韧得嚼不动。"
  ],
  "substitutions": [
    {
      "original": "鸭胸",
      "substitute": "鸡腿排",
      "ratio": "700g 对 700g",
      "note": "煎制时间缩短至每面 6 分钟。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "15g 对 15ml",
      "note": "奶香减弱，可加 2g 蒜末。"
    }
  ],
  "variations": [
    "配 50ml 红酒酱汁，风味更完整。",
    "撒上 3g 橙皮屑，果香能解油腻。"
  ],
  "serving_suggestion": "切片摆盘，淋锅底鸭胸油或红酒酱，配烤蔬菜。",
  "storage": "冷藏可存 2 天，复热时皮朝下小火回煎 2 分钟。",
