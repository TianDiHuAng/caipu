  "steps": [
    {
      "n": 1,
      "text": "洋葱、胡萝卜与芹菜切成同样大小的细丁，蘑菇切成薄片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丁切得越小越均匀，炒出来的甜味释放得越快。",
      "visual_cue": "三种蔬菜丁大小一致，切面平整"
    },
    {
      "n": 2,
      "text": "厚底锅放一半黄油，中火把蔬菜丁炒到边缘焦黄。",
      "time_min": 10,
      "heat": "中火",
      "tip": "炒到焦黄才叫褐色底，只是变软香味完全不够。",
      "visual_cue": "蔬菜丁表面带深色焦斑，锅底有一层褐色"
    },
    {
      "n": 3,
      "text": "加番茄膏与蘑菇片继续炒三分钟，把番茄的生味炒掉。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄膏一定要炒过，不然酱会带酸涩的生味。",
      "visual_cue": "番茄膏由鲜红转为暗红，锅里有黏性"
    },
    {
      "n": 4,
      "text": "倒白葡萄酒刮起锅底的褐色焦层，煮到酒气挥发一半。",
      "time_min": 4,
      "heat": "中火",
      "tip": "刮起锅底的焦香物质，那是整锅酱的精华。",
      "visual_cue": "酒液减少一半，锅底干净发亮"
    },
    {
      "n": 5,
      "text": "另起小锅融化剩下的黄油，加面粉小火炒到深褐色。",
      "time_min": 8,
      "heat": "小火",
      "tip": "颜色到浅可可色那样就停，再深就发苦。",
      "visual_cue": "面糊呈深褐色，闻着有坚果般的焦香"
    },
    {
      "n": 6,
      "text": "褐色面糊分次拌进蔬菜锅里搅匀，加清水、百里香与月桂叶。",
      "time_min": 5,
      "heat": "中火",
      "tip": "面糊先离火再加汤，直接下锅容易结硬块。",
      "visual_cue": "酱汁顺滑无颗粒，香草浮在表面"
    },
    {
      "n": 7,
      "text": "小火慢煮四十分钟，中途撇掉浮沫，最后加盐与黑胡椒调味并过滤。",
      "time_min": 42,
      "heat": "小火",
      "tip": "小火慢煮才出厚度，火大会很快把酱煮干。",
      "visual_cue": "酱汁明显变稠，颜色深褐发亮"
    }
  ],
  "tips": [
    "用牛骨汤代替清水，鲜味会提升一大截。",
    "煮好后表面会结一层薄膜，撇掉即可。",
    "这锅酱是很多经典酱汁的底，可以分装冷冻。",
    "加一点烤过的骨头同煮，胶质会让酱更挂口。"
  ],
  "common_mistakes": [
    "蔬菜没炒到焦黄就加水，酱汁淡而没有深度。",
    "面糊炒得太久发黑，整锅酱带上明显苦味。",
    "煮的过程中不撇浮沫，成品浑浊还有杂味。"
  ],
  "substitutions": [
    {
      "original": "白葡萄酒",
      "substitute": "清水",
      "ratio": "100毫升:100毫升",
      "note": "酸度减弱，可加几滴白醋补。"
    },
    {
      "original": "番茄膏",
      "substitute": "番茄酱",
      "ratio": "30克:40克",
      "note": "甜味更明显，糖可少放。"
    }
  ],
  "variations": [
    "加入烤过的牛骨同煮，浓缩成更深厚的版本。",
    "减半收汁后加黄油块甩匀，做成更亮面的现代版。"
  ],
  "serving_suggestion": "过滤后趁热配烤牛肉、炖肉或作为其他酱汁的底料使用。",
  "storage": "冷藏三天，冷冻可存一个月，分小份冻更方便取用。",
