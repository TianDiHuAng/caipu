  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "土豆",
          "name_en": "potato",
          "amount": 600,
          "unit": "g",
          "note": "黄心土豆，去皮切块",
          "optional": false
        },
        {
          "name": "大葱",
          "name_en": "Welsh onion",
          "amount": 150,
          "unit": "g",
          "note": "只用葱白与浅绿部分，切细丝",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 80,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 30,
          "unit": "g",
          "note": "无盐黄油",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 300,
          "unit": "ml",
          "note": "全脂牛奶",
          "optional": false
        },
        {
          "name": "奶油",
          "name_en": "cream",
          "amount": 100,
          "unit": "ml",
          "note": "淡奶油",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 600,
          "unit": "ml",
          "note": "鸡高汤更佳",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "分次调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "搅拌棒",
    "细筛",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大葱剥去外层老皮，取葱白与浅绿段切成细丝并彻底洗净泥沙，土豆去皮切成厚片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "葱丝要洗掉内层泥沙，否则汤里会有沙粒感。",
      "visual_cue": "葱丝洁白松散、土豆片厚度一致"
    },
    {
      "n": 2,
      "text": "汤锅小火融化黄油，下大葱丝与洋葱丝，加盖慢炒到完全软塌而不上色。",
      "time_min": 6,
      "heat": "小火",
      "tip": "全程不能炒出焦色，白汤的干净风味全靠这一步。",
      "visual_cue": "葱丝透明塌软、锅底无褐斑"
    },
    {
      "n": 3,
      "text": "放入土豆片翻匀，倒入清水没过食材，煮开后转小火炖到土豆一压即碎。",
      "time_min": 15,
      "heat": "小火",
      "tip": "土豆煮透再打泥，淀粉充分糊化汤才顺滑不分离。",
      "visual_cue": "土豆边缘崩开、勺压即散"
    },
    {
      "n": 4,
      "text": "离火用搅拌棒打成细腻糊状，过细筛回锅，去掉粗纤维让口感更绵。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛能滤掉葱的粗纤维，汤体才像丝绒一样。",
      "visual_cue": "汤糊顺滑无颗粒、筛上留少量纤维"
    },
    {
      "n": 5,
      "text": "重新小火加热，缓缓倒入牛奶与奶油搅匀，用盐与黑胡椒调味，微沸即离火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "加了奶之后不能大滚，沸起来会结皮并分层。",
      "visual_cue": "汤面挂勺、边缘冒小泡未翻滚"
    }
  ],
  "tips": [
    "黄心土豆淀粉适中，打出的汤浓稠却不发黏。",
    "先把土豆煮透再打泥，比生打更顺滑也更省时。",
    "上桌可撒几粒炸面包丁与细香葱，增加口感层次。"
  ],
  "common_mistakes": [
    "葱丝下锅炒出焦褐色，白汤变成灰黄色并带苦味。",
    "土豆没煮透就打泥，汤中出现细颗粒且放凉后结块。",
    "加奶后大火煮沸，奶油分离成絮状，汤面浮起油花。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "淡奶油",
      "ratio": "100ml 对 100ml",
      "note": "含脂量低的淡奶油需减少加热时间避免分层。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "30g 对 25ml",
      "note": "风味偏素，适合冷食版本。"
    }
  ],
  "variations": [
    "加一把切碎的韭黄与少许莳萝，做出清爽的夏季冷汤版。",
    "拌入煎脆的培根碎与烤蒜片，做成浓郁的法式乡村风味。"
  ],
  "serving_suggestion": "盛入温热的汤碗，撒现磨黑胡椒与几滴橄榄油，配硬壳面包同食。",
  "storage": "冷藏两天，复热时加少量牛奶调开并小火加热，切勿滚沸。",
