  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成两毫米厚的薄片，泡水洗去表面黏液。",
      "time_min": 10,
      "heat": "无火",
      "tip": "片切得越匀越容易一起熟，厚薄差别大会夹生。",
      "visual_cue": "土豆片透亮，厚薄一致"
    },
    {
      "n": 2,
      "text": "烤盘内壁用黄油均匀抹一遍，蒜切末撒在盘底。",
      "time_min": 3,
      "heat": "无火",
      "tip": "抹黄油是防粘关键，别省这一步。",
      "visual_cue": "盘壁油亮，蒜末铺匀"
    },
    {
      "n": 3,
      "text": "汤锅倒淡奶油和牛奶，加蒜末、盐、黑胡椒和肉豆蔻小火加热。",
      "time_min": 4,
      "heat": "小火",
      "tip": "奶液只加热到冒小泡，煮滚容易结皮。",
      "visual_cue": "奶液微滚，香气散出"
    },
    {
      "n": 4,
      "text": "土豆片码进烤盘，倒入热奶液，让每片都浸到。",
      "time_min": 5,
      "heat": "无火",
      "tip": "土豆片要层层铺平压紧，成品切片才整齐。",
      "visual_cue": "奶液没过土豆，表面平整"
    },
    {
      "n": 5,
      "text": "表面撒上奶酪丝，烤箱一百八十度烤四十五分钟。",
      "time_min": 45,
      "heat": "中火",
      "tip": "烤到刀能轻松插透土豆，才是全熟。",
      "visual_cue": "表面金黄，奶液冒泡"
    }
  ],
  "tips": [
    "土豆片切得厚薄一致，烤制时间才好掌握。",
    "奶液加热再倒，烤出来的层次更细腻。",
    "烤到刀能轻松插透才算熟，别提前出炉。"
  ],
  "common_mistakes": [
    "土豆片厚薄悬殊，熟的熟生的生。",
    "奶液煮滚再倒，表面结皮口感发粗。",
    "奶酪撒太早堆在边缘，烤焦发苦。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "全脂牛奶",
      "ratio": "200 毫升:200 毫升",
      "note": "更清爽，黄油多加十克补润。"
    },
    {
      "original": "奶酪",
      "substitute": "面包糠",
      "ratio": "80 克:60 克",
      "note": "脆感更强，最后十分钟再撒。"
    }
  ],
  "variations": [
    "夹一层培根片一起烤，咸香更足更油润。",
    "用迷迭香代替肉豆蔻，香气更具草本感。"
  ],
  "serving_suggestion": "烤好静置十分钟再切，块形完整不散。",
  "storage": "冷藏两天，复烤十五分钟回温即可上桌。",
