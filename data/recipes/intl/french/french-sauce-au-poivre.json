  "equipment": [
    "平底锅",
    "木勺",
    "细筛",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑胡椒用刀背或研钵压成粗粒，平底锅不放油，小火干炒到香气冲出来。",
      "time_min": 5,
      "heat": "小火",
      "tip": "胡椒要现磨现炒，粉状细末入锅容易焦苦。",
      "visual_cue": "锅中胡椒粒跳动，飘出浓烈辛香"
    },
    {
      "n": 2,
      "text": "下洋葱末用小火炒到透明发甜，倒白葡萄酒煮到几乎收干。",
      "time_min": 5,
      "heat": "小火",
      "tip": "酒要煮到酒精味散尽只剩果酸，否则酱汁发冲。",
      "visual_cue": "锅底只剩薄薄一层湿润的洋葱末"
    },
    {
      "n": 3,
      "text": "倒入高汤小火煮到剩一半，让洋葱与胡椒的味道充分渗进汤里。",
      "time_min": 4,
      "heat": "小火",
      "tip": "收汁时别走开，汤量过半后浓缩速度会明显加快。",
      "visual_cue": "汤汁明显变深，锅边留下浓缩的褐色痕迹"
    },
    {
      "n": 4,
      "text": "倒奶油继续小火煮到挂勺，用细筛滤掉洋葱与胡椒渣，回锅加盐调味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "滤渣后再回锅收一下，酱汁口感才细腻顺滑。",
      "visual_cue": "酱汁乳白带褐，能均匀裹住勺背"
    },
    {
      "n": 5,
      "text": "关火后分两次加入冷黄油块，一边晃锅一边搅到酱汁发亮。",
      "time_min": 2,
      "heat": "无火",
      "tip": "黄油必须离火加入，温度过高会让酱汁油水分离。",
      "visual_cue": "酱汁表面泛起油亮光泽，质地如丝绒"
    }
  ],
  "tips": [
    "黑胡椒用量可按口味增减，但粗粒比细粉更能撑起辛香。",
    "离火加冷黄油是法式酱汁增稠发亮的关键手法，别省略。",
    "成品要立刻上桌，久放会结皮并逐渐析出油脂。"
  ],
  "common_mistakes": [
    "酱汁滚沸时投入黄油，乳脂分离导致表面浮一层油。",
    "白葡萄酒没煮透就加高汤，成品带明显酒精刺激味。",
    "胡椒研磨过细，下锅即焦，酱汁发苦失去辛香。"
  ],
  "substitutions": [
    {
      "original": "奶油",
      "substitute": "牛奶加黄油",
      "ratio": "200 毫升:150 毫升加 30 克",
      "note": "稠度偏稀，需多收两分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "清酒",
      "ratio": "1:1",
      "note": "甜度略高，可减五克盐平衡。"
    }
  ],
  "variations": [
    "在滤渣后加一小勺第戎芥末，可做带酸香的黑胡椒芥末酱。"
  ],
  "serving_suggestion": "浇在煎好的牛排或猪排上，配炸薯条同食。",
  "storage": "冷藏两天，复热用小火加少量高汤调稀，不要滚沸。",
