          "name_en": "onion",
          "amount": 60,
          "unit": "g",
          "note": "切极细末",
          "optional": false
        },
        {
          "name": "白葡萄酒",
          "name_en": "dry white wine",
          "amount": 80,
          "unit": "ml",
