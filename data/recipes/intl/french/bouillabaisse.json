  "steps": [
    {
      "n": 1,
      "text": "蛤蜊提前用淡盐水泡两小时吐沙，中途换两次水，捞出冲净外壳。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡到水清，汤才不牙碜。",
      "visual_cue": "蛤蜊开壳、水底无沙"
    },
    {
      "n": 2,
      "text": "汤锅倒橄榄油，中火炒洋葱、芹菜与胡萝卜八分钟至蔬菜变软出香。",
      "time_min": 8,
      "heat": "中火",
      "tip": "蔬菜炒透，汤底才有厚度。",
      "visual_cue": "蔬菜软化、洋葱透明"
    },
    {
      "n": 3,
      "text": "加蒜片与番茄炒到起沙出汁，倒入白葡萄酒煮到酒气挥发。",
      "time_min": 8,
      "heat": "中火",
      "tip": "酒气挥发完再加水，不然汤发酸。",
      "visual_cue": "番茄起沙、酒气散尽"
    },
    {
      "n": 4,
      "text": "倒入清水、香叶与百里香煮开转小火炖二十分钟，让蔬菜味融进汤里。",
      "time_min": 20,
      "heat": "小火",
      "tip": "保持微沸，汤色才清亮。",
      "visual_cue": "汤色橙红、香气浓郁"
    },
    {
      "n": 5,
      "text": "放入鲈鱼块与蛤蜊小火煮八分钟，蛤蜊开口后加虾再煮两分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "海鲜分次下锅，避免煮老。",
      "visual_cue": "蛤蜊全开、虾身卷曲"
    },
    {
      "n": 6,
      "text": "加盐与黑胡椒调味，淋入泡开的藏红花水，撒百里香叶即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "藏红花最后加，香气才不挥发。",
      "visual_cue": "汤色金黄、香气层次分明"
    }
  ],
  "tips": [
    "蛤蜊必须提前泡沙，否则整锅汤都带碴。",
    "海鲜按耐煮程度分次下锅，虾最后两分钟放。",
    "藏红花要用温水泡开再淋，直接撒会浮在汤面。"
  ],
  "common_mistakes": [
    "所有海鲜一起下锅，鱼散了虾已老。",
    "白葡萄酒没煮到酒气挥发，汤带生酒味。",
    "蛤蜊没吐沙就下锅，汤底一口沙。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "鳕鱼",
      "ratio": "500g 对 500g",
      "note": "肉质更紧实，多煮两分钟。"
    },
    {
      "original": "藏红花",
      "substitute": "姜黄",
      "ratio": "0.5g 对 1g",
      "note": "颜色接近，香气不同。"
    }
  ],
  "variations": [
    "巴黎版：加 200g 淡菜与 100g 鱿鱼。",
    "浓汤版：把一半蔬菜打成泥回锅增稠。"
  ],
  "serving_suggestion": "配烤脆的法棍片与蒜香蛋黄酱，汤与料分盘上桌。",
  "storage": "冷藏可存 1 天，海鲜复热须彻底煮沸，不建议冷冻。",
