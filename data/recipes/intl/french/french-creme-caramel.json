    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 200,
          "unit": "g",
          "note": "全蛋加两个蛋黄",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 500,
          "unit": "ml",
          "note": "全脂牛奶",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "入蛋液",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "熬褐色糖液",
          "optional": false
        },
        {
          "name": "香草荚",
          "name_en": "vanilla pod",
          "amount": 1,
          "unit": "g",
          "note": "剖开取籽",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 30,
          "unit": "ml",
          "note": "熬糖用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "布丁模",
    "烤箱",
    "小锅",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶加香草荚与香草籽，小火加热到锅边冒小泡后离火。",
      "time_min": 8,
      "heat": "小火",
      "tip": "不要煮开，牛奶一沸就会有膜和焦味。",
      "visual_cue": "锅边起细小气泡，奶面微微晃动"
    },
    {
      "n": 2,
      "text": "小锅放八十克白糖与清水，中火熬成琥珀色糖液。",
      "time_min": 7,
      "heat": "中火",
      "tip": "全程不要搅动，晃锅让糖均匀受热就够。",
      "visual_cue": "糖液呈浅琥珀色，闻到焦甜香"
    },
    {
      "n": 3,
      "text": "趁热把糖液倒进布丁模底部，转动模具让糖铺平。",
      "time_min": 4,
      "heat": "无火",
      "tip": "动作一定要快，糖凉了就会立刻凝住不动。",
      "visual_cue": "模底铺一层薄亮的褐色糖层"
    },
    {
      "n": 4,
      "text": "鸡蛋加剩下的白糖打散，只搅到糖化不要打起泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "搅出气泡会让成品表面出现蜂窝小孔。",
      "visual_cue": "蛋液均匀带黏性，表面只有零星细泡"
    },
    {
      "n": 5,
      "text": "温热的牛奶慢慢倒入蛋液，边倒边搅，再过滤两遍。",
      "time_min": 6,
      "heat": "无火",
      "tip": "牛奶一定要放温，太烫会把蛋液烫成蛋花。",
      "visual_cue": "液体顺滑无颗粒，滤网留下少量泡沫"
    },
    {
      "n": 6,
      "text": "奶液分装进模子，放进烤盘并注入热水到模具一半高。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水浴是布丁细嫩的关键，水位别超过模具一半。",
      "visual_cue": "模具稳立水中，液面平静"
    },
    {
      "n": 7,
      "text": "一百五十度烤三十五分钟，中心轻晃有颤动即熟。",
      "time_min": 37,
      "heat": "无火",
      "tip": "中心还微微晃才算正好，烤到完全凝固就老了。",
      "visual_cue": "表面平滑无水泡，边缘微微鼓起"
    },
    {
      "n": 8,
      "text": "取出放凉后冷藏四小时，脱模时用刀沿边划一圈倒扣。",
      "time_min": 120,
      "heat": "无火",
      "tip": "冷藏定型和风味融合都靠这一步，别急。",
      "visual_cue": "脱模完整，褐色糖液自然流下"
    }
  ],
  "tips": [
    "糖液熬到浅琥珀就够，再深会带苦味。",
    "用整颗蛋加蛋黄，成品更挺也更香。",
    "脱模前把模具在热水里浸十秒，更容易完整倒出。",
    "糖液里加一点柠檬汁，能防止返砂结晶。"
  ],
  "common_mistakes": [
    "牛奶煮开后直接冲蛋液，蛋液结块成蛋花汤。",
    "蛋液搅出大量气泡，成品表面满是蜂窝。",
    "烤过头，布丁口感变粗像蒸老的蛋羹。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "500毫升:400毫升",
      "note": "成品更浓稠，需多加一个蛋黄。"
    },
    {
      "original": "香草荚",
      "substitute": "香草精",
      "ratio": "1根:5毫升",
      "note": "香气略薄，出锅前再加。"
    }
  ],
  "variations": [
    "糖液里加几滴橙味酒，香气更有层次。",
    "模具底部放几颗葡萄干，做成酒香版本。"
  ],
  "serving_suggestion": "倒扣在浅盘里，让褐色糖液自然流下，冷藏后当餐后甜点。",
  "storage": "冷藏保存三天，须密封避免串味，不建议冷冻。",
