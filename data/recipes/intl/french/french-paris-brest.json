  "equipment": [
    "锅",
    "裱花袋",
    "烤箱",
    "烤盘",
    "打蛋器",
    "碗",
    "筛网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶、清水、黄油五十克、盐与白糖十克入锅煮沸。",
      "time_min": 6,
      "heat": "中火",
      "tip": "液体必须大滚再倒粉，泡芙才发得起来。",
      "visual_cue": "液体沸腾翻滚，黄油完全融化"
    },
    {
      "n": 2,
      "text": "离火倒入面粉，用木铲快速搅成不粘锅的团，回火炒两分钟。",
      "time_min": 7,
      "heat": "小火",
      "tip": "炒到锅底起薄膜，水分才够干。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "面团成团不粘锅，锅底有薄膜"
    },
    {
      "n": 3,
      "text": "面团稍凉后分四次加入蛋液，每次都搅到完全吸收。",
      "time_min": 9,
      "heat": "无火",
      "tip": "蛋液分次加，面糊浓稠度才可控。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "面糊提起呈倒三角缓慢下落"
    },
    {
      "n": 4,
      "text": "面糊装裱花袋，在烤盘上挤出直径十八厘米的圆环，撒杏仁片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "圆环粗细均匀，烤出来才一样高。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "圆环饱满，杏仁片贴附牢固"
    },
    {
      "n": 5,
      "text": "烤箱预热二百度烤二十分钟，转一百八十度再烤十五分钟。",
      "time_min": 38,
      "heat": "无火",
      "tip": "中途别开门，泡芙遇冷就塌。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "泡芙膨胀中空，表面金褐"
    },
    {
      "n": 6,
      "text": "淡奶油加余下白糖打发，泡芙横切两半，挤入奶油再合上撒糖粉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "奶油打到硬挺，切面才立得住。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "奶油纹路清晰，切面饱满"
    }
  ],
  "tips": [
    "液体大滚再倒粉，泡芙才能鼓。火候与时间都要盯紧，宁可略短也别过头。",
    "蛋液分次加，看状态不看数量。做之前把料备齐，下锅后就没空切配了。",
    "烤制中途绝不开门，塌了没法救。这几步照顺序来，味道才会一层层叠上去。",
    "出炉后晾凉再切，泡芙才不塌。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "液体不沸就倒粉，泡芙扁塌不发。结果往往一锅好料全被这一步毁掉。",
    "蛋液一次全倒，面糊稀得挤不成形。很多人就在这里翻车，出菜后才发现。",
    "中途开门查看，泡芙瞬间回缩。账面上看是小疏忽，入口立刻能尝出来。",
    "奶油打太软，切面流得满盘。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "杏仁",
      "substitute": "榛子",
      "ratio": "50克:50克",
      "note": "切碎撒面，香气更浓。"
    },
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "300毫升:250毫升",
      "note": "需加玉米淀粉打稠。"
    }
  ],
  "variations": [
    "夹馅里加一勺榛子酱，香气更浓。口味会更厚一些，适合重口的人。",
    "做成小size圆环，适合下午茶。做法不复杂，家常灶台就能完成。",
    "表面撒糖粉换成淋巧克力，风味更甜。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "切开一个角露出奶油，撒糖粉上桌，外壳酥、内里软，奶油榛香十足。",
  "storage": "冷藏可放一天，泡芙壳易回软；建议现做现吃，壳与馅分开保存更久。",
