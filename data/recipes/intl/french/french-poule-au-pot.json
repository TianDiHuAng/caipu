  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "漏勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿用盐和黑胡椒抹匀，静置十五分钟。，看准状态再往下做。",
      "time_min": 17,
      "heat": "无火",
      "tip": "提前抹盐，肉才有底味。，看准状态再往下做。",
      "visual_cue": "鸡皮微湿，调料附着"
    },
    {
      "n": 2,
      "text": "鸡腿冷水下锅，中火烧开后撇净浮沫。，看准状态再往下做。",
      "time_min": 10,
      "heat": "中火",
      "tip": "浮沫撇净，汤才清亮。，看准状态再往下做。",
      "visual_cue": "浮沫成层，汤面渐清"
    },
    {
      "n": 3,
      "text": "加洋葱、大蒜、月桂叶和百里香煮开。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "香草扎成束，便于最后捞出。，看准状态再往下做。",
      "visual_cue": "香气上涌，汤面微沸"
    },
    {
      "n": 4,
      "text": "转小火盖锅炖三十分钟，保持汤面微动。，看准状态再往下做。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢炖，肉才嫩不散。，看准状态再往下做。",
      "visual_cue": "汤面微泡，鸡皮完整"
    },
    {
      "n": 5,
      "text": "加胡萝卜和土豆，继续炖二十分钟。，看准状态再往下做。",
      "time_min": 22,
      "heat": "小火",
      "tip": "根茎后放，才不会炖成泥。，看准状态再往下做。",
      "visual_cue": "土豆微软，胡萝卜发亮"
    },
    {
      "n": 6,
      "text": "用筷子戳鸡腿最厚处，无血水即熟。，看准状态再往下做。",
      "time_min": 2,
      "heat": "小火",
      "tip": "见血水就再炖五分钟。，看准状态再往下做。",
      "visual_cue": "汁水清澈，肉质紧实"
    },
    {
      "n": 7,
      "text": "捞出鸡腿保温，汤用漏勺滤去料渣。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "滤一遍汤，喝起来才清爽。，看准状态再往下做。",
      "visual_cue": "汤色金黄，浮油点点"
    },
    {
      "n": 8,
      "text": "汤里补盐调味，撒欧芹碎端上桌。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐最后调，汤才不咸。，看准状态再往下做。",
      "visual_cue": "汤面油亮，绿点散布"
    },
    {
      "n": 9,
      "text": "鸡腿切块放回汤中，配土豆胡萝卜上桌。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "切块回汤，肉才不会干。，看准状态再往下做。",
      "visual_cue": "肉块浸汤，汤色清亮"
    }
  ],
  "tips": [
    "冷水下锅，血沫才逼得干净。，成败就在这一步。",
    "全程小火，鸡肉才嫩不柴。，这点要注意。",
    "根茎后放，炖久了会化。，这是关键点。"
  ],
  "common_mistakes": [
    "大火滚煮，鸡肉散成丝。，别嫌麻烦，做完它。",
    "浮沫不撇，汤浑浊带腥。，这一步别省。",
    "盐一开始放足，汤越煮越咸。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸭腿",
      "ratio": "900 克:900 克",
      "note": "炖的时间加十五分钟。"
    },
    {
      "original": "百里香",
      "substitute": "月桂叶",
      "ratio": "3 克:2 片",
      "note": "香气更单纯。"
    }
  ],
  "variations": [
    "汤里下一把细面，变成一顿主食。，这步最关键。",
    "加半个卷心菜同炖，汤更清甜。，很多人在这里出错。"
  ],
  "serving_suggestion": "先喝汤再吃肉，配一片乡村面包。，这里最容易翻车。",
  "storage": "冷藏三天，冷冻两周；复热小火慢炖。",
