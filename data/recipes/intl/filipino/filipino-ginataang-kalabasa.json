  "steps": [
    {
      "n": 1,
      "text": "南瓜去籽后连皮切成三厘米见方的块，皮朝下摆放备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "连皮煮不易散，皮朝下摆放也更不容易糊底。",
      "visual_cue": "南瓜块大小一致，皮面完整"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下洋葱丝、蒜末与姜丝小火煸到香气出来。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱煸到透明才有甜味，别急着下南瓜。",
      "visual_cue": "洋葱丝发软透明，锅里香气浓"
    },
    {
      "n": 3,
      "text": "加干辣椒与南瓜块翻炒两分钟，让每块都裹上油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先裹油再下水，南瓜不易煮散且更香。",
      "visual_cue": "南瓜块表面油亮，边缘微透"
    },
    {
      "n": 4,
      "text": "倒入清水，盖盖小火煮十分钟至南瓜能用筷子插透。",
      "time_min": 10,
      "heat": "小火",
      "tip": "水只要到南瓜一半高，太多会煮成糊。",
      "visual_cue": "筷子能轻松插透南瓜块"
    },
    {
      "n": 5,
      "text": "倒入椰浆加鱼露与盐，小火煮三分钟收浓即可出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椰浆要最后加，煮开就关火，别让它起油花。",
      "visual_cue": "汤汁奶白浓稠，裹在南瓜上"
    }
  ],
  "tips": [
    "老南瓜比嫩南瓜好，粉糯又甜，汤汁自然浓。",
    "连皮煮口感更好，也不容易散成泥。",
    "鱼露是咸鲜的来源，没有可用生抽代替。",
    "喜欢辣可以加两只小辣椒，整只煮完捞出。"
  ],
  "common_mistakes": [
    "南瓜切得太小块，煮完直接化在汤里没了口感。",
    "水加太多，最后收不浓变成南瓜汤。",
    "椰浆一开始就下锅久煮，油水分离浮油。",
    "鱼露下手太重，甜味全被咸味盖住。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "芋头",
      "ratio": "600克:600克",
      "note": "更粉，煮的时间加三分钟。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "12毫升:15毫升",
      "note": "咸度略低，盐可加一克。"
    }
  ],
  "variations": [
    "加几只虾仁同煮，就是椰浆南瓜虾。",
    "加一把四季豆同煮，颜色与口感更丰富。",
    "加一勺辣椒酱，做成带辣版本更下饭。"
  ],
  "serving_suggestion": "连汤汁一起盛盘，配白饭与烤鱼，南瓜的甜与椰浆的浓搭起来正合适。",
  "storage": "冷藏可放两天，复热用小火加少量清水慢加热，避免南瓜碎散。",
