  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "香蕉",
          "name_en": "banana",
          "amount": 400,
          "unit": "g",
          "note": "去皮纵切",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 200,
          "unit": "g",
          "note": "做薄皮",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 80,
          "unit": "g",
          "note": "裹焦糖",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 300,
          "unit": "ml",
          "note": "炸制",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 100,
          "unit": "ml",
          "note": "和面",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "大碗",
    "刀",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和清水揉成偏软面团，盖布醒十五分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "面团软一点，擀皮才不裂。，注意火候。",
      "visual_cue": "面团光滑，按下去回弹"
    },
    {
      "n": 2,
      "text": "面团分成小份，擀成薄长方形面皮备用。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擀得薄透，炸完才脆不硬。，注意火候。",
      "visual_cue": "面皮透光，边缘整齐，状态稳定"
    },
    {
      "n": 3,
      "text": "香蕉去皮纵切成两半，长度与面皮宽度对齐。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香蕉别切太短，卷起来才饱满。，注意火候。",
      "visual_cue": "条状整齐，长度一致，状态稳定"
    },
    {
      "n": 4,
      "text": "面皮上撒一层红糖，放上香蕉条后卷紧。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "红糖撒匀，化开才裹得住香蕉。，注意火候。",
      "visual_cue": "卷形紧实，糖分布均匀"
    },
    {
      "n": 5,
      "text": "两端向内折紧，接口处抹水粘牢。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "接口粘牢，炸的时候糖才不会漏。，注意火候。",
      "visual_cue": "接口贴合，无开裂，状态稳定"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油烧到一百六十度，放入香蕉卷。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温别太高，糖容易先焦。，注意火候。",
      "visual_cue": "油面细泡，卷身浮起，状态稳定"
    },
    {
      "n": 7,
      "text": "每面炸两分钟到金黄，期间转动使受热均匀。这一步不要着急。",
      "time_min": 8,
      "heat": "中火",
      "tip": "边炸边转，不会一面焦一面生。，注意火候。",
      "visual_cue": "表皮金黄，糖色发亮，状态稳定"
    },
    {
      "n": 8,
      "text": "捞出放厨房纸上沥油，稍晾两分钟再吃。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖壳很烫，晾一下再咬。，注意火候。",
      "visual_cue": "外壳干爽，声响清脆，状态稳定"
    }
  ],
  "tips": [
    "面皮擀薄擀透，炸完才脆不硬。，值得留意。",
    "接口抹水粘牢，糖才不会漏进油锅。，值得留意。",
    "油温一百六十度最稳，太热糖先焦。，值得留意。"
  ],
  "common_mistakes": [
    "皮擀太厚，炸完硬得咬不动。，值得留意。",
    "红糖放太多，炸的时候漏糖发苦。，值得留意。",
    "油温太高，外皮焦了香蕉还没热透。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "香蕉",
      "substitute": "芒果",
      "ratio": "400 克:400 克",
      "note": "酸味更明显，糖可略增。"
    },
    {
      "original": "红糖",
      "substitute": "白糖",
      "ratio": "80 克:70 克",
      "note": "焦香略淡，颜色更浅。"
    }
  ],
  "variations": [
    "加几粒菠萝蜜同卷，香气更热带。，值得留意。",
    "撒少许肉桂粉，风味更暖。，值得留意。"
  ],
  "serving_suggestion": "趁热配一杯冰饮，下午茶最合适。，效果更稳定。",
  "storage": "冷藏一天，复热用烤箱一百八十度烤五分钟。",
