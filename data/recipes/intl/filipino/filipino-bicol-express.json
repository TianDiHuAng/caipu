  "steps": [
    {
      "n": 1,
      "text": "五花肉切两厘米宽的条，肥瘦连着切更香。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肥瘦连着切，炖完才不干。，注意火候。",
      "visual_cue": "肉条整齐，肥瘦相连，状态稳定"
    },
    {
      "n": 2,
      "text": "冷锅下肉条，中小火干煸八分钟到出油微黄。这一步不要着急。",
      "time_min": 9,
      "heat": "中火",
      "tip": "先干煸出油，口感才不腻。，注意火候。",
      "visual_cue": "肉条卷缩，锅底积油，状态稳定"
    },
    {
      "n": 3,
      "text": "倒出多余油脂，加植物油、蒜末、姜丝和洋葱炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蒜姜炒香，底味才够。，注意火候。",
      "visual_cue": "香气升起，洋葱发软，状态稳定"
    },
    {
      "n": 4,
      "text": "加虾酱小火炒三十秒，炒出咸鲜的酱香。这一步不要着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "虾酱炒过才不腥，但别炒糊。，注意火候。",
      "visual_cue": "酱香浓烈，油色发红，状态稳定"
    },
    {
      "n": 5,
      "text": "倒入椰奶和肉条，加盐和黑胡椒翻匀煮开。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "椰奶一滚就转小火，别让它炸开。，注意火候。",
      "visual_cue": "汤面微沸，颜色乳白，状态稳定"
    },
    {
      "n": 6,
      "text": "转小火盖锅盖炖二十五分钟，中途翻动两次。这一步不要着急。",
      "time_min": 26,
      "heat": "小火",
      "tip": "小火慢炖，肉才酥软入味。，注意火候。",
      "visual_cue": "肉已软糯，汤汁略稠，状态稳定"
    },
    {
      "n": 7,
      "text": "放入鲜辣椒段再煮五分钟，让辣味渗进汤汁。这一步不要着急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "鲜辣椒后放，辣度才好控制。，注意火候。",
      "visual_cue": "汤色泛红，辣香冲出，状态稳定"
    },
    {
      "n": 8,
      "text": "开盖略收汁，尝味后盛出配米饭。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "汁别收太干，浇饭才好吃。，注意火候。",
      "visual_cue": "汤汁浓稠，油光发亮，状态稳定"
    }
  ],
  "tips": [
    "五花肉先干煸出油，成品才不腻。，值得留意。",
    "椰奶滚了就转小火，大火会油水分离。，值得留意。",
    "鲜辣椒后放，辣度自己掌握。，值得留意。"
  ],
  "common_mistakes": [
    "肉没煸出油，成品油腻压不住。，值得留意。",
    "虾酱炒糊，整锅发苦。，值得留意。",
    "椰奶大火久煮，汤汁分层发花。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "鸡腿肉",
      "ratio": "500 克:500 克",
      "note": "更清爽，炖制时间减八分钟。"
    },
    {
      "original": "虾酱",
      "substitute": "鱼露",
      "ratio": "25 克:20 毫升",
      "note": "咸度更直接，盐可略减。"
    }
  ],
  "variations": [
    "加几根四季豆同炖，口感更丰富。，值得留意。",
    "放一小勺椰糖，辣中带回甜。，值得留意。"
  ],
  "serving_suggestion": "必须配白米饭，汤汁浇在饭上最下饭。，效果更稳定。",
  "storage": "冷藏两天，复热加少量水小火煮开。，效果更稳定。",
