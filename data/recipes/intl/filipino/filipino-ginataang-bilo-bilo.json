    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉加温水揉成不粘手的面团。，动作放连贯，味道才不闷。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水慢慢加，面团才不稀。，先试试温度，口感才不散。",
      "visual_cue": "面团光滑，手感柔软，锅温要匀，味道才进得去。"
    },
    {
      "n": 2,
      "text": "面团搓成长条，掰成小块再搓圆。，锅温要匀，表面才漂亮。",
      "time_min": 10,
      "heat": "无火",
      "tip": "大小一致，煮时才同步熟。，手法轻些，吃口才舒服。",
      "visual_cue": "圆球均匀，表面光滑，料别一次下太多，形状才完整。"
    },
    {
      "n": 3,
      "text": "紫薯和芋头去皮，切一厘米小丁。，时间掐准，口感才不发柴。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丁切小些，才和圆子同熟。，保持小火，成品才稳当。",
      "visual_cue": "丁粒齐整，颜色分明，手法轻些，咸淡才好把握。"
    },
    {
      "n": 4,
      "text": "汤锅倒清水，下紫薯和芋头煮开。，汤汁别收太干，香气才不跑。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水开再下，块才不散。，盖盖焖一会儿，口感才不发柴。",
      "visual_cue": "水面翻滚，块形完整，起锅前尝味，口感才不散。"
    },
    {
      "n": 5,
      "text": "转中火煮十分钟，煮到块状变软。，时间掐准，成品才稳当。",
      "time_min": 11,
      "heat": "中火",
      "tip": "筷子能穿就够，别煮烂。，手法轻些，味道才不闷。",
      "visual_cue": "块体软透，汤色发紫，份量心里有数，整道菜才立得住。"
    },
    {
      "n": 6,
      "text": "下糯米圆子，煮到全部浮起。，起锅前尝味，形状才完整。",
      "time_min": 6,
      "heat": "中火",
      "tip": "浮起就熟，别久煮。，火别太大，口感才不发柴。",
      "visual_cue": "圆子浮面，体积膨大，动作放连贯，锅气才足。"
    },
    {
      "n": 7,
      "text": "倒椰奶和玉米粒，小火加热。，起锅前尝味，颜色才够亮。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰奶别煮沸，会分层。，先试试温度，形状才完整。",
      "visual_cue": "奶色乳白，香气甜润，盖盖焖一会儿，表面才漂亮。"
    },
    {
      "n": 8,
      "text": "加白糖和盐，搅化后关火。，份量心里有数，味道才不闷。",
      "time_min": 3,
      "heat": "小火",
      "tip": "一点盐，甜味才不闷。，汤汁别收太干，口感才不发柴。",
      "visual_cue": "甜香柔和，汤体顺滑，下手别慌，形状才完整。"
    }
  ],
  "tips": [
    "面团水慢慢加，揉到不粘手就够。，先试试温度，风味才干净。",
    "糯米圆子浮起就熟，别久煮。，别用力搅，口感才不发柴。",
    "椰奶最后加，小火温热即可。，锅温要匀，口感才不散。"
  ],
  "common_mistakes": [
    "面团太软，下锅就化。，别急着加油，吃口才舒服。",
    "椰奶煮沸，油水分离。，顺序照着来，味道才不闷。",
    "紫薯切太大，煮不透。，保持小火，细节才到位。"
  ],
  "substitutions": [
    {
      "original": "紫薯",
      "substitute": "红薯",
      "ratio": "200 克:200 克",
      "note": "颜色偏橙，甜味更足。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "500 毫升:500 毫升",
      "note": "奶香更淡，需加椰蓉补香。"
    }
  ],
  "variations": [
    "加西米，口感更滑。，注意别烧干，成品才稳当。",
    "加几片香兰叶，香气更清。，别用力搅，细节才到位。"
  ],
  "serving_suggestion": "温热吃，或加冰做成冷甜品。，先试试温度，表面才漂亮。",
  "storage": "冷藏两天，复热加少量水。，汤汁别收太干，成品才好看。",
