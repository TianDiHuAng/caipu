  "steps": [
    {
      "n": 1,
      "text": "猪里脊剁成细末，洋葱、胡萝卜切细末，小葱切葱花备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "里脊末剁得越细，蛋饼切开才不散。",
      "visual_cue": "里脊末细腻无筋膜，配料末均匀"
    },
    {
      "n": 2,
      "text": "鸡蛋打入碗中加盐与白胡椒，打散到看不见蛋清丝。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打到蛋液完全均匀，煎出来的蛋饼才平整。",
      "visual_cue": "蛋液颜色一致，表面有细泡"
    },
    {
      "n": 3,
      "text": "平底锅倒一半植物油，下洋葱末与蒜末小火炒出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "洋葱末要炒到透明，甜味出来蛋饼才好吃。",
      "visual_cue": "洋葱末透明，锅中香气明显"
    },
    {
      "n": 4,
      "text": "下里脊末与胡萝卜末中火炒散至颜色转白，加生抽炒匀后盛出放凉。",
      "time_min": 5,
      "heat": "中火",
      "tip": "里脊末一定要炒散，结块会顶破蛋饼。",
      "visual_cue": "里脊末松散干香，无大团"
    },
    {
      "n": 5,
      "text": "把炒好的料与葱花拌入蛋液，锅中补油倒入，小火煎五分半钟后翻面再煎三分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "一定要用小火慢煎，火大底面焦而中间还流。",
      "visual_cue": "两面金黄，晃动锅蛋饼整体移动"
    }
  ],
  "tips": [
    "里脊末先炒熟再入蛋液，蛋饼才不会夹生。",
    "煎的时候盖一下锅盖，中间更容易熟透。",
    "翻面可以用盘子倒扣再滑回锅里，安全又完整。",
    "切块吃比整张端上桌更方便，配番茄酱很搭。"
  ],
  "common_mistakes": [
    "生里脊末直接拌蛋液，中间永远煎不熟。",
    "火太大，蛋饼底面焦黑而里面还在流。",
    "蛋液没打散，蛋白结成一团白块。",
    "料放太多，蛋饼撑不住翻面就碎。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "200克:200克",
      "note": "更清淡，需多放五毫升生抽。"
    },
    {
      "original": "胡萝卜",
      "substitute": "土豆",
      "ratio": "60克:60克",
      "note": "切末后需先炒两分钟再入蛋液。"
    }
  ],
  "variations": [
    "加一把奶酪碎同煎，切开时能有轻微拉丝效果。",
    "加两勺番茄酱同拌，酸甜口味孩子更爱。",
    "做成小圆饼，一口一个当便当菜。"
  ],
  "serving_suggestion": "切成三角块，配蒜香饭与番茄酱，是菲律宾人便当盒里的常客。",
  "storage": "冷藏可放一天，复热用平底锅小火两面各煎一分钟，微波会让蛋饼发硬。",
