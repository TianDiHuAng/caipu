  "steps": [
    {
      "n": 1,
      "text": "空心菜摘成六厘米段，菜梗与菜叶分开放，洗净沥干水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "梗叶分开下锅，叶子才不会烂而梗还是硬的。",
      "visual_cue": "菜梗叶片分装，篮底不见积水"
    },
    {
      "n": 2,
      "text": "大蒜拍碎，洋葱切成细丝，干辣椒剪成小段备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜拍碎比切末更香，拍完不要切得太细。",
      "visual_cue": "蒜粒带裂口，洋葱丝均匀"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下蒜与洋葱丝小火煸到出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "洋葱丝要煸到透明，酸味进来才不会太冲。",
      "visual_cue": "洋葱丝发软透明，香气明显"
    },
    {
      "n": 4,
      "text": "转大火下干辣椒与菜梗快炒一分钟，再下菜叶翻炒三十秒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "全程大火，锅气足菜才脆，出锅颜色也更好。",
      "visual_cue": "菜梗翠绿挺立，叶片刚塌"
    },
    {
      "n": 5,
      "text": "沿锅边淋入米醋与生抽，加白糖、盐与白胡椒翻匀立刻出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋要沿锅边淋，遇热激出香气，直接倒会发闷。",
      "visual_cue": "醋香上冲，盘底汤汁很少"
    }
  ],
  "tips": [
    "米醋比白醋柔和，酸得有层次，别用陈醋抢味。",
    "醋一定要最后淋，早放酸味会煮飞。",
    "空心菜挑梗细的，粗梗怎么炒都老。",
    "喜欢重口的话，可以加一勺辣椒酱一起同炒。"
  ],
  "common_mistakes": [
    "醋一开始就倒进锅，炒完酸味全没了。",
    "菜叶菜梗同时下锅，叶子烂成一团。",
    "中火慢炒，空心菜大量出水，最后变成一锅汤。",
    "生抽与醋比例失衡，整盘只有咸没有香。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "卷心菜",
      "ratio": "500克:500克",
      "note": "手撕成片，炒的时间加一分钟。"
    },
    {
      "original": "米醋",
      "substitute": "青柠汁",
      "ratio": "25毫升:20毫升",
      "note": "更清香，最后关火后再挤。"
    }
  ],
  "variations": [
    "加几片五花肉同炒，油脂带香更下饭。",
    "加一把炸蒜片，香气更浓也更脆。",
    "换成芥蓝同炒，口感更清脆，也更好挂汁。"
  ],
  "serving_suggestion": "装盘立刻上桌，配烤鱼与白饭，酸香解油腻，很适合搭重口的主菜。",
  "storage": "当餐吃完最好，冷藏不超过一天，复热用大火快炒十秒。",
