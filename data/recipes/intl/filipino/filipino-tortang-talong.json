  "equipment": [
    "平底锅",
    "蒸锅",
    "碗",
    "打蛋器",
    "叉子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子整条上锅蒸十二分钟至完全软透，取出稍凉后纵向剖开。",
      "time_min": 14,
      "heat": "中火",
      "tip": "整条蒸才不进水，剖开后肉才不会湿答答。",
      "visual_cue": "茄子皮皱起，筷子可轻松插透"
    },
    {
      "n": 2,
      "text": "用叉子把茄肉刮松摊平成饼状，保留外皮作为底托。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刮松不刮烂，保留一点纤维口感更好。",
      "visual_cue": "茄肉摊平成一整片，皮完整"
    },
    {
      "n": 3,
      "text": "鸡蛋打散加盐、白胡椒与生抽，拌入洋葱末、蒜末与葱花。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液要打匀，配料切得越细越容易摊平。",
      "visual_cue": "蛋液均匀，配料分布散开"
    },
    {
      "n": 4,
      "text": "平底锅倒一半植物油，把茄子皮朝下放入，小火煎两分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "皮朝下先定型，翻面时才不会散架。",
      "visual_cue": "茄子边缘微焦，形状固定"
    },
    {
      "n": 5,
      "text": "倒入蛋液铺满茄面，小火煎四分钟，翻面再煎三分钟至两面金黄。",
      "time_min": 8,
      "heat": "小火",
      "tip": "蛋液要完全凝固再翻，早了整张会碎。",
      "visual_cue": "两面金黄，晃动锅时整体移动"
    }
  ],
  "tips": [
    "茄子要蒸到极软，蛋饼才能和茄肉粘在一起。",
    "用盘子倒扣翻面，比铲子翻更完整。",
    "蛋液里加一点生抽，颜色与咸味都更好。",
    "配番茄酱或醋蒜蘸汁吃，都很对味，酸甜解腻。"
  ],
  "common_mistakes": [
    "茄子蒸不透，咬着发硬还带生味。",
    "蛋液没凝固就翻面，整张碎成几块。",
    "茄子带水下锅，油花四溅还粘锅。",
    "火太大，外皮焦黑里面蛋液还在流。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "450克:450克",
      "note": "水分更多，蒸的时间减三分钟。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4个:4个",
      "note": "蛋香更浓，煎的时间加三十秒。"
    }
  ],
  "variations": [
    "加一把肉末同煎，变成荤版茄子蛋饼。",
    "加两勺番茄酱在蛋液里，酸甜更开胃。",
    "蒸好的茄子抹一层蒜蓉再倒蛋液，蒜香更浓。"
  ],
  "serving_suggestion": "整张端上桌，切块后配蒜香饭与醋蒜蘸汁，是菲律宾家庭最常见的早餐之一。",
  "storage": "冷藏可放一天，复热用平底锅小火两面各煎一分钟，不要用微波。",
