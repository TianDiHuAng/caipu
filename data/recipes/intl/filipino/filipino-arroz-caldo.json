  "equipment": [
    "汤锅",
    "锅铲",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后沥干，摊开放十五分钟让表面水分蒸发。",
      "time_min": 15,
      "heat": "无火",
      "tip": "米粒干爽，炒的时候才不粘锅。",
      "visual_cue": "米粒松散干爽，不粘连"
    },
    {
      "n": 2,
      "text": "鸡腿肉切块，用生抽与少许盐抓匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "生抽提鲜，也让汤色更漂亮。",
      "visual_cue": "鸡块表面均匀上色"
    },
    {
      "n": 3,
      "text": "汤锅倒植物油，中火炒洋葱丁与蒜末三分钟出香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒软，汤底才够甜。",
      "visual_cue": "洋葱透明，锅里有蒜香"
    },
    {
      "n": 4,
      "text": "下鸡块中火翻炒五分钟，炒到表面变白定型。",
      "time_min": 5,
      "heat": "中火",
      "tip": "炒过的鸡肉更香，汤也不腥。",
      "visual_cue": "鸡块表面发白，边缘微黄"
    },
    {
      "n": 5,
      "text": "加入姜丝炒一分钟，倒入一千二百毫升热水煮开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "热水下锅，汤色更清。",
      "visual_cue": "水面滚开，浮起少量浮沫"
    },
    {
      "n": 6,
      "text": "撇掉浮沫后倒入大米，搅匀防止米粒沉底粘锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "米下锅后要立刻搅一次。",
      "visual_cue": "米粒在汤中均匀散开"
    },
    {
      "n": 7,
      "text": "盖盖小火煮二十五分钟，每五分钟搅一次防粘底。",
      "time_min": 25,
      "heat": "小火",
      "tip": "米汤容易糊底，勤搅是必要的。",
      "visual_cue": "米粒开花，汤变浓稠"
    },
    {
      "n": 8,
      "text": "加盐与黑胡椒调味，搅匀后尝一下咸淡再补。",
      "time_min": 2,
      "heat": "小火",
      "tip": "稠度以能缓缓流动为准，太稠可加热水。",
      "visual_cue": "粥体浓稠，米粒软烂"
    },
    {
      "n": 9,
      "text": "盛碗后撒小葱与姜丝，挤上青柠汁趁热食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁能压住鸡肉的腻，别省。",
      "visual_cue": "粥面冒着热气，配色清亮"
    }
  ],
  "tips": [
    "大米先炒过再煮，粥才香浓而不糊底。",
    "煮粥全程小火并勤搅，才不会糊底。",
    "青柠汁最后挤，酸香能提整碗的鲜。"
  ],
  "common_mistakes": [
    "米不沥干直接下锅，炒的时候粘成一团。",
    "大火煮粥不搅动，锅底糊出一层焦。",
    "水一次加得太少，煮出来像干硬的饭。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "500 克:450 克",
      "note": "煮制时间减到十八分钟。"
    },
    {
      "original": "青柠",
      "substitute": "白醋",
      "ratio": "30 克:15 毫升",
      "note": "酸味更直，用量减半。"
    }
  ],
  "variations": [
    "加一个水煮蛋切半，营养更充足。",
    "撒一把炸蒜片，香气更浓更好吃。"
  ],
  "serving_suggestion": "热食单碗，配炸蒜片和青柠角一起上桌。",
  "storage": "冷藏两天，复热加少量热水搅匀再煮开。",
