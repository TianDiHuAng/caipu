      "group": "main",
      "items": [
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 900,
          "unit": "g",
          "note": "带骨琵琶腿四只",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白醋",
          "name_en": "white vinegar",
          "amount": 120,
          "unit": "ml",
          "note": "米醋或蔗醋",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 60,
          "unit": "ml",
          "note": "咸味主来源",
          "optional": false
        },
        {
          "name": "老抽",
          "name_en": "dark soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "上色",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 30,
          "unit": "g",
          "note": "拍碎留整瓣",
          "optional": false
        },
        {
