          "unit": "piece",
          "note": "撕开更出味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 5,
          "unit": "g",
          "note": "粗粒现磨",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 8,
          "unit": "g",
          "note": "平衡酸咸",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "煎鸡上色",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 150,
          "unit": "ml",
          "note": "防止烧干",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "炒锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿用厨房纸吸干表面水分，在厚处划两刀方便入味，大蒜拍碎备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划刀不要切断骨头，只是让厚肉处能吸到酱汁。",
      "visual_cue": "鸡皮干爽，厚肉处有两道浅口"
    },
    {
      "n": 2,
      "text": "厚底锅放植物油烧热，鸡腿皮朝下中火煎到金黄，翻面再煎三分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "煎出鸡皮的油再炖，成品香气明显更厚。",
      "visual_cue": "鸡皮深金色，锅底留一层清亮的油"
    },
    {
      "n": 3,
      "text": "倒入白醋、生抽、老抽和清水，加蒜瓣、月桂叶和黑胡椒，煮开后转小火。",
      "time_min": 5,
      "heat": "中火",
      "tip": "醋要在鸡肉下锅前先煮开，酸味才会变得圆润。",
      "visual_cue": "汤汁深褐色，浮起细密油花"
    },
    {
      "n": 4,
      "text": "盖盖小火炖三十五分钟，中途翻面一次，让鸡肉两面都浸过酱汁。",
      "time_min": 37,
      "heat": "小火",
      "tip": "液面保持微沸，滚沸会把鸡肉煮散。",
      "visual_cue": "鸡肉用筷子轻扎即透，酱汁减少约三分之一"
    },
    {
      "n": 5,
      "text": "开盖加白糖，转中火收汁八分钟，边收边把酱汁往鸡身上淋。",
      "time_min": 9,
      "heat": "中火",
      "tip": "收汁到最后两分钟要盯紧，含糖的酱汁极易焦底。",
      "visual_cue": "酱汁浓稠油亮，紧紧裹住鸡皮"
    },
    {
      "n": 6,
      "text": "装盘后把锅里的蒜瓣和酱汁一起浇上，配白饭趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蒜瓣炖软后不辣，压碎拌饭是菲律宾人的吃法。",
      "visual_cue": "鸡皮油亮呈酱红色，蒜瓣软糯"
    }
  ],
  "tips": [
    "醋不要减量，酸味是这道菜的骨架，收汁后会自然变柔。",
    "用砂锅或厚底锅比薄锅更稳，酱汁不易烧焦。",
    "隔夜冷藏后风味更融合，第二天的酱汁拌饭最香。"
  ],
  "common_mistakes": [
    "醋和酱油一起下锅后大火滚煮，酸味挥发得只剩咸。",
    "收汁时走开，含糖酱汁两分钟就糊底发苦。",
    "用鸡胸代替鸡腿，久炖后肉质干柴，缺少油润感。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "五花肉",
      "ratio": "900 克:800 克",
      "note": "菲律宾也有猪肉版本，炖煮时间延长十分钟。"
    },
    {
      "original": "白醋",
      "substitute": "苹果醋",
      "ratio": "120 毫升:130 毫升",
      "note": "酸味更柔，糖可减两克。"
    }
  ],
  "variations": [
    "收汁前加入椰浆，可做成带奶香的阿斗波椰奶版本。"
  ],
  "serving_suggestion": "配白饭与番茄洋葱小菜，浇上酱汁。",
  "storage": "冷藏三天，冷冻一个月，复热时加少量水小火翻热。",
