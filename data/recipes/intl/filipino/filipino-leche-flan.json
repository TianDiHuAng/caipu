  "id": "filipino-leche-flan",
  "name": {
    "zh": "菲律宾焦糖蛋奶布丁",
    "en": "Filipino Leche Flan",
    "original": "Leche Flan"
  },
  "cuisine": {
    "region": "intl",
    "style": "filipino"
  },
  "category": [
    "dessert"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 130,
    "cook_min": 82,
    "total_min": 212
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 4,
          "unit": "piece",
          "note": "只用蛋黄",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 400,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "熬焦糖",
          "optional": false
        },
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 100,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 10,
          "unit": "g",
          "note": "取皮屑",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "布丁模",
    "蒸锅",
    "打蛋器",
    "滤网",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小锅放八十克白糖，小火干烧到融化变成琥珀色。",
      "time_min": 8,
      "heat": "小火",
      "tip": "别搅动，晃锅就行，搅了会返砂。",
      "visual_cue": "糖液琥珀透亮，锅边冒细烟"
    },
    {
      "n": 2,
      "text": "趁热把焦糖倒进布丁模，转一圈让底部铺匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "动作要快，糖凉了就推不动。火候要盯住。",
      "visual_cue": "模具底部铺满焦糖，边缘略高"
    },
    {
      "n": 3,
      "text": "蛋黄四个打入碗中，加剩余白糖轻轻搅到糖化。",
      "time_min": 6,
      "heat": "无火",
      "tip": "只搅不打发，起泡了布丁就有孔。",
      "visual_cue": "蛋液顺滑，表面几乎无泡"
    },
    {
      "n": 4,
      "text": "牛奶与淡奶油小火加热到锅边冒小泡，离火晾一分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "别烧开，滚了冲蛋会结块。多练两次就熟。",
      "visual_cue": "奶液温热，表面无膜"
    },
    {
      "n": 5,
      "text": "把温奶液慢慢倒进蛋液，边倒边搅直到完全混匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一点点倒，蛋液才不被烫熟。细节决定成败。",
      "visual_cue": "混合液均匀浅黄，无颗粒"
    },
    {
      "n": 6,
      "text": "加柠檬皮屑搅匀，用滤网过滤两遍去掉浮沫。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过滤两遍，成品表面才光滑无孔。",
      "visual_cue": "滤后液体细腻，滤网留细渣"
    },
    {
      "n": 7,
      "text": "把蛋奶液倒进模具，八分满，表面有泡用勺子撇掉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别倒满，蒸的时候会膨起来。这一步别省。",
      "visual_cue": "液面平静，模具内无气泡"
    },
    {
      "n": 8,
      "text": "模具盖上锡纸，放进蒸锅中小火蒸三十五分钟。",
      "time_min": 37,
      "heat": "小火",
      "tip": "火大水滚，布丁就会出蜂窝。顺序别颠倒。",
      "visual_cue": "锅盖边缘冒细气，液面微微晃"
    },
    {
      "n": 9,
      "text": "取出放凉后冷藏两小时，倒扣脱模淋上焦糖汁。",
      "time_min": 132,
      "heat": "无火",
      "tip": "凉透再脱模，不然一倒就散。火候要盯住。",
      "visual_cue": "布丁完整脱模，焦糖汁流下"
    }
  ],
  "tips": [
    "熬焦糖时只晃锅不搅动，糖才不返砂。",
    "蛋黄只搅不打发，成品才没有蜂窝孔。",
    "蛋奶液过滤两遍，表面才像镜面一样滑。",
    "全程中小火蒸，水滚得太猛会起孔。"
  ],
  "common_mistakes": [
    "奶液烧滚直接冲蛋，蛋液结成蛋花。",
    "蒸的时候火太大，布丁表面全是小孔。",
    "没冷藏就脱模，布丁塌成一团。细节决定成败。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "400 毫升:400 毫升",
      "note": "奶香更浓，甜度可减十克。"
    },
    {
      "original": "淡奶油",
      "substitute": "牛奶",
      "ratio": "100 毫升:100 毫升",
      "note": "更清爽，口感稍硬。"
    }
  ],
  "variations": [
    "加一小勺香草精，奶香更柔和。多练两次就熟。",
    "表面撒少许柠檬皮屑，清爽解腻。"
  ],
  "serving_suggestion": "冷藏后倒扣在盘里，焦糖汁自然流下，切块配一杯黑咖啡最合适。",
  "storage": "冷藏三天，用保鲜膜贴面盖住防止串味。",
  "nutrition_estimate": {
    "basis": "每份约 150 克",
    "calories_kcal": 330,
    "protein_g": 9,
