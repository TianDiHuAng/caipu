  "steps": [
    {
      "n": 1,
      "text": "鲈鱼刮鳞去内脏，两面各划三刀。，起锅前尝味，成品才稳当。",
      "time_min": 12,
      "heat": "无火",
      "tip": "划刀入味，煮时才不破皮。，慢慢来别急，锅气才足。",
      "visual_cue": "鱼身完整，刀口整齐，保持小火，口感才不散。"
    },
    {
      "n": 2,
      "text": "鱼身抹盐和黑胡椒，腌十分钟。，留意锅底，成品才稳当。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌一下，肉才紧实。，翻动放轻，细节才到位。",
      "visual_cue": "表面干爽，盐粒化开，先试试温度，香气才不跑。"
    },
    {
      "n": 3,
      "text": "炖锅铺姜片和洋葱圈垫底。，动作放连贯，咸淡才好把握。",
      "time_min": 4,
      "heat": "无火",
      "tip": "垫底防粘，鱼皮才完整。，留意锅底，味道才不闷。",
      "visual_cue": "锅底铺满，层次平整，保持小火，整道菜才立得住。"
    },
    {
      "n": 4,
      "text": "鱼放上去，倒白醋和清水。，手法轻些，锅气才足。，份量心里有数，咸淡才好把握。",
      "time_min": 3,
      "heat": "无火",
      "tip": "液面到鱼身一半就够。，先试试温度，食材才不糊。",
      "visual_cue": "液面平齐，鱼身不动，时间掐准，香气才留得住。"
    },
    {
      "n": 5,
      "text": "加蒜、红辣椒和白糖，大火煮开。，先试试温度，整道菜才立得住。",
      "time_min": 6,
      "heat": "大火",
      "tip": "煮开别翻鱼，晃锅就够。，保持小火，口感才不发柴。",
      "visual_cue": "汤面翻滚，酸香升起，下手别慌，食材才不糊。"
    },
    {
      "n": 6,
      "text": "转小火盖盖煮十二分钟。，翻动放轻，香气才不跑。，动作放连贯，风味才干净。",
      "time_min": 14,
      "heat": "小火",
      "tip": "小火慢煮，鱼肉才嫩。，别急着加油，口感才不发柴。",
      "visual_cue": "汤面微沸，鱼眼变白，份量心里有数，口感才有层次。"
    },
    {
      "n": 7,
      "text": "开盖尝汤，补盐调味。，手法轻些，成品才好看。，留意锅底，风味才干净。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酸味重就补一点糖。，保持小火，吃口才舒服。",
      "visual_cue": "汤汁微稠，咸酸适口，别急着加油，颜色才够亮。"
    },
    {
      "n": 8,
      "text": "撒小葱段，连汁一起盛盘。，起锅前尝味，味道才不闷。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鱼别翻动，整条上桌。，份量心里有数，成品才稳当。",
      "visual_cue": "鱼身完整，葱段翠绿，火别太大，成品才好看。"
    }
  ],
  "tips": [
    "鱼别翻动，晃锅就够。，先试试温度，口感才不发柴。",
    "醋要足够，酸味才压得住腥。，料别一次下太多，香气才不跑。",
    "小火慢煮，鱼肉才嫩。，火别太大，表面才漂亮。"
  ],
  "common_mistakes": [
    "频繁翻鱼，鱼肉散开。，翻动放轻，味道才不闷。",
    "醋太少，腥味压不住。，汤汁别收太干，火候才均匀。",
    "大火久煮，鱼肉发柴。，汤汁别收太干，成品才稳当。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "罗非鱼",
      "ratio": "800 克:800 克",
      "note": "肉更紧，煮制时间加三分钟。"
    },
    {
      "original": "白醋",
      "substitute": "米醋",
      "ratio": "150 毫升:150 毫升",
      "note": "酸味更柔，白糖可减三克。"
    }
  ],
  "variations": [
    "加茄子同煮，吸饱酸汤。，保持小火，表面才漂亮。",
    "放凉吃，第二天更入味。，翻动放轻，食材才不糊。"
  ],
  "serving_suggestion": "配白米饭，浇上酸汤。，汤汁别收太干，表面才漂亮。",
  "storage": "冷藏两天，复热用小火。，盖盖焖一会儿，食材才不糊。",
