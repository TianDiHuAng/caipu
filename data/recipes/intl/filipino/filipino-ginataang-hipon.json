  "steps": [
    {
      "n": 1,
      "text": "虾去壳留尾挑净虾线，用少许盐抓洗后冲净沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "虾线一定要挑净，留着会带泥沙和腥味。",
      "visual_cue": "虾仁半透明，尾壳完整"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，下洋葱丝、蒜末与姜丝小火煸到洋葱透明。",
      "time_min": 5,
      "heat": "小火",
      "tip": "底料煸透汤才香，火大蒜末一焦就发苦。",
      "visual_cue": "洋葱丝变软，锅中香气明显"
    },
    {
      "n": 3,
      "text": "加干辣椒与南瓜块翻炒一分钟，倒入清水烧开后小火煮八分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "南瓜先煮软，后面才能把汤底压出自然的甜。",
      "visual_cue": "南瓜边缘变软，汤水微黄"
    },
    {
      "n": 4,
      "text": "下四季豆与虾仁煮三分钟，虾仁转红卷曲即可。",
      "time_min": 4,
      "heat": "中火",
      "tip": "虾仁只要三分钟，久煮就老得像橡皮。",
      "visual_cue": "虾仁卷成弧形，颜色橙红"
    },
    {
      "n": 5,
      "text": "倒入椰浆加鱼露与盐，小火煮两分钟不停搅拌后关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椰浆下锅后不能大滚，一滚就出油花分层。",
      "visual_cue": "汤色奶白浓稠，表面不见油分离"
    }
  ],
  "tips": [
    "椰浆最后放，微沸就关火，汤才顺滑。",
    "南瓜选粉糯的老南瓜，汤底自带甜味。",
    "虾壳可以先用少量油煸香再煮汤，鲜味更浓。",
    "怕辣可以把干辣椒整只放，煮完再捞出。"
  ],
  "common_mistakes": [
    "椰浆和清水一起下锅大火煮，汤面浮一层油。",
    "虾仁煮了七八分钟，口感像橡皮筋。",
    "南瓜切太小块，煮完化在汤里没有口感。",
    "鱼露一次倒太多，咸得盖住椰香。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "虾仁",
      "ratio": "400克:350克",
      "note": "已去壳更方便，煮的时间一样。"
    },
    {
      "original": "四季豆",
      "substitute": "豇豆",
      "ratio": "150克:150克",
      "note": "同样切段，需多煮一分钟。"
    }
  ],
  "variations": [
    "加几只青口贝同煮，汤更鲜，是海鲜全家版。",
    "加一把米粉同煮，变成椰浆虾汤面。",
    "换成蟹块同煮，鲜味更浓，煮的时间加三分钟。"
  ],
  "serving_suggestion": "盛在深碗里，汤要没过料，配白饭一起吃，椰香与虾鲜混在饭里特别下饭。",
  "storage": "冷藏可放一天，复热用小火边搅边加热，不要大火煮沸以免椰浆分离。",
