  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆着纹理切成半厘米厚的片，用刀背轻拍两下松肉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逆着纹理切再拍松，咬起来才不费劲。",
      "visual_cue": "肉片薄匀，纹路断口"
    },
    {
      "n": 2,
      "text": "酱油、一半柠檬汁、大蒜末和白胡椒调匀，把牛里脊片泡进去。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腌料要没过肉片，翻动两次更均匀。",
      "visual_cue": "肉片浸透，酱色均匀"
    },
    {
      "n": 3,
      "text": "冷藏腌制三十分钟，中途翻面一次让两面都吸到味。",
      "time_min": 30,
      "heat": "无火",
      "tip": "腌半小时就够，腌太久肉会变得发柴。",
      "visual_cue": "肉片整体颜色转深"
    },
    {
      "n": 4,
      "text": "平底锅放植物油大火烧热，把牛里脊片摊开煎一分钟再翻面。",
      "time_min": 4,
      "heat": "大火",
      "tip": "锅要够热，一片片摊开煎才不会出水。",
      "visual_cue": "表面焦褐，锅气足"
    },
    {
      "n": 5,
      "text": "肉片盛出，原锅下洋葱圈炒到边缘透明微焦。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒到边缘焦香，甜味才出来。",
      "visual_cue": "洋葱透明，边缘微焦"
    },
    {
      "n": 6,
      "text": "倒回牛里脊片，加清水、白糖和剩下的柠檬汁翻匀收汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "柠檬汁最后加，酸香才清爽不闷。",
      "visual_cue": "汤汁收浓，油亮挂肉"
    },
    {
      "n": 7,
      "text": "尝味补盐，连洋葱一起盛盘，浇上锅里的酱汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后再补，酱油本身已经带有咸味。",
      "visual_cue": "酱汁红亮，肉片油润"
    }
  ],
  "tips": [
    "牛里脊逆纹切并拍松，口感才不柴。",
    "锅要烧到冒烟再下肉，才有焦香锅气。",
    "柠檬汁分两次加，酸味才有层次。"
  ],
  "common_mistakes": [
    "肉片顺着纹理切，嚼起来像嚼橡皮。",
    "锅不够热就下肉，出水变成煮牛肉。",
    "腌太久又煎过头，肉片干硬没有汁水。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛腩",
      "ratio": "600 克:650 克",
      "note": "更有嚼头，腌制延长十分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "白醋",
      "ratio": "2 个:40 毫升",
      "note": "酸度更直接，用量减半。"
    }
  ],
  "variations": [
    "加一小勺蚝油，鲜味会更浓一些。",
    "最后撒一层炸蒜片，香气更突出。"
  ],
  "serving_suggestion": "浇在白饭上，配一份蒜香炒饭或煎蛋，是菲律宾家庭最常见的下饭菜。",
  "storage": "冷藏两天，复热用平底锅小火加两勺水翻热，别用微波以免肉片变硬。",
