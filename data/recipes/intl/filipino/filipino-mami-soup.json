  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉整块用冷水冲净，洋葱切丝，生姜与蒜拍开备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鸡肉整块煮再撕条，汤更清肉也更嫩。",
      "visual_cue": "鸡肉表面干净，配料切好分装"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，下洋葱丝、姜片与蒜小火煸到洋葱变软出香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱煸软汤才有底味的甜，火大焦了会苦。",
      "visual_cue": "洋葱丝透明发软，香气上冲"
    },
    {
      "n": 3,
      "text": "倒入清水大火烧开，下鸡腿肉转小火煮二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "水面微沸即可，大滚鸡肉会柴、汤会浑。",
      "visual_cue": "鸡肉浮起，汤面干净微黄"
    },
    {
      "n": 4,
      "text": "捞出鸡腿肉稍凉后撕成粗条，汤里下盐、生抽与白胡椒调味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "撕成粗条比切片更挂汤，入口也更有存在感。",
      "visual_cue": "鸡丝粗细均匀，汤味咸鲜"
    },
    {
      "n": 5,
      "text": "面条按包装煮到八成熟捞入碗中，铺鸡丝与卷心菜丝，冲入热汤撒小葱。",
      "time_min": 5,
      "heat": "中火",
      "tip": "面条煮八成就好，热汤会继续把它泡熟。",
      "visual_cue": "碗中汤清面白，鸡丝堆成小山"
    }
  ],
  "tips": [
    "面条与汤要分开煮，汤才不会浑成一片。",
    "鸡腿肉比鸡胸嫩，撕条后口感更好。",
    "白胡椒要多磨一点，这是这道汤的灵魂。",
    "想更丰盛可加半个水煮蛋与几片炸蒜。"
  ],
  "common_mistakes": [
    "鸡肉和面条一起煮，汤浑得像浆糊。",
    "全程大火滚，鸡肉发柴撕不成条。",
    "调味一次放太多生抽，汤色发黑发咸。",
    "面条煮到全熟才装碗，泡一会就烂了。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600克:550克",
      "note": "更瘦，煮的时间减五分钟。"
    },
    {
      "original": "面条",
      "substitute": "米粉",
      "ratio": "400克:350克",
      "note": "只需泡软，不必久煮。"
    }
  ],
  "variations": [
    "加几只虾仁同煮，汤更鲜，是海鲜版麻米。",
    "加一勺炸蒜油，香气更足更地道。",
    "换成牛肉片同煮，做成牛肉麻米汤也很对味。"
  ],
  "serving_suggestion": "趁热端上桌，配一碟青柠角与鱼露，挤点酸汁进去汤味立刻精神起来。",
  "storage": "汤与面分开冷藏可放两天，复热汤要煮沸，面条另煮以免糊汤。",
