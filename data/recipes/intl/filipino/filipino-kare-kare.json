  "equipment": [
    "厚底炖锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩冷水下锅焯五分钟，撇去浮沫后捞出洗净沥干。",
      "time_min": 8,
      "heat": "中火",
      "tip": "焯水要冷水下锅，血水才能慢慢逼出来。",
      "visual_cue": "汤面浮沫灰褐，肉块收紧"
    },
    {
      "n": 2,
      "text": "炖锅下植物油炒香洋葱末与蒜末，直到洋葱透明微黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "洋葱先炒出甜味，再下肉才不会只剩咸味。",
      "visual_cue": "洋葱金黄软塌，香气甜润"
    },
    {
      "n": 3,
      "text": "放入牛腩块翻炒三分钟，让表面封住不出血水。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉块表面封住再炖，汤才清而不浑。",
      "visual_cue": "肉块表面转褐，锅底无积水"
    },
    {
      "n": 4,
      "text": "倒入高汤煮开，转小火加盖炖一小时二十分钟。",
      "time_min": 82,
      "heat": "小火",
      "tip": "保持微沸，滚太猛牛腩容易散烂成丝。",
      "visual_cue": "汤面微沸，牛腩能被筷子插透"
    },
    {
      "n": 5,
      "text": "花生酱先用两勺热汤化开成稀糊，再倒回锅里搅匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "花生酱必须先化开，直接下锅会结成一团。",
      "visual_cue": "酱糊顺滑，无颗粒块"
    },
    {
      "n": 6,
      "text": "放入茄子与豆角，小火再炖十五分钟至蔬菜软而不烂。",
      "time_min": 17,
      "heat": "小火",
      "tip": "蔬菜后放，久炖会化进汤里失去形状。",
      "visual_cue": "茄子微软，豆角翠绿转深"
    },
    {
      "n": 7,
      "text": "加盐与白糖调定味道，汤汁呈浓稠的土黄色即可关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖不是为了甜，而是把花生酱的厚重拉开。",
      "visual_cue": "汤汁浓稠挂勺，颜色土黄"
    },
    {
      "n": 8,
      "text": "盛进深盘，让牛腩与蔬菜浮在酱汁里，配一大碗白饭上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "这道菜的汤汁是拌饭主力，饭要多备。",
      "visual_cue": "盘中酱汁覆肉，米饭热气腾"
    }
  ],
  "tips": [
    "花生酱选无糖幼滑型，带颗粒的会破坏汤汁顺滑。",
    "传统会配一碟虾酱，咸鲜能压住花生酱的厚重。",
    "茄子先干煎一下再下锅，形状更完整。"
  ],
  "common_mistakes": [
    "花生酱直接下锅，结成一团团沉在锅底。",
    "牛腩炖过头，肉散成丝，汤汁浑浊。",
    "茄子豆角一起下锅炖太久，全化成泥。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛腱",
      "ratio": "900 克:900 克",
      "note": "胶质更多，炖制时间延长二十分钟。"
    },
    {
      "original": "花生酱",
      "substitute": "芝麻酱",
      "ratio": "150 克:140 克",
      "note": "风味更坚果香浓，需减糖五克。"
    }
  ],
  "variations": [
    "加牛肚或猪皮同炖，口感层次更丰富。",
    "素食版用花菜与长豆角，花生酱照旧。"
  ],
  "serving_suggestion": "配白饭，另备一小碟虾酱蘸食，汤汁拌饭最香。",
  "storage": "冷藏三天、冷冻一个月；复热加少量高汤小火化开，避免糊底。",
