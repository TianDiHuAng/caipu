  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗后泡水三小时，捞出沥干至表面不滴水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡足三小时米粒才吸够水，煮出来才糯而不硬。",
      "visual_cue": "米粒饱满发白，捏之能碎"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下洋葱丝、蒜末与姜丝小火煸出香味。",
      "time_min": 5,
      "heat": "小火",
      "tip": "底料煸透是这道饭的香源，别急着下鸡肉。",
      "visual_cue": "洋葱丝透明，香气明显上冲"
    },
    {
      "n": 3,
      "text": "下鸡腿肉块中火煎到表面转白，加鱼露、盐与白胡椒炒匀。",
      "time_min": 6,
      "heat": "中火",
      "tip": "鸡肉先煎出油再焖，香味才厚不腥。",
      "visual_cue": "鸡腿肉块表面转白，锅里带焦香"
    },
    {
      "n": 4,
      "text": "倒入糯米翻炒两分钟，让米粒裹上油与调料。",
      "time_min": 3,
      "heat": "中火",
      "tip": "糯米要炒到粒粒分明带油光，煮出来才不粘团。",
      "visual_cue": "米粒油亮，与鸡腿肉块拌得均匀"
    },
    {
      "n": 5,
      "text": "全部转入电饭锅，加椰浆与清水搅匀，按煮饭键煮熟后焖十分钟撒小葱。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水量比平常米饭少一成，椰浆会再补水分。",
      "visual_cue": "饭粒饱满足够松，鸡肉软嫩"
    }
  ],
  "tips": [
    "糯米一定要泡透，不泡煮出来会有硬芯。",
    "椰浆代替一部分水，饭才香而不腻。",
    "水量比平时煮饭少一点，否则会烂成粥。",
    "煮好焖十分钟再开盖，米粒更松更匀。"
  ],
  "common_mistakes": [
    "糯米没泡直接煮，饭粒夹生咬不动。",
    "水加太多，煮成一锅黏糊糊的粥。",
    "鸡肉带骨又没焖透，吃着还带血。",
    "椰浆全代替水，饭太油吃两口就腻。"
  ],
  "substitutions": [
    {
      "original": "糯米",
      "substitute": "大米",
      "ratio": "400克:400克",
      "note": "不需浸泡，水减五十毫升。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "15毫升:18毫升",
      "note": "咸度略低，盐可加一克。"
    }
  ],
  "variations": [
    "加一把葡萄干与花生，甜咸交织更丰富。",
    "加两片咸蛋黄同煮，香气更浓，饭色也更金黄。",
    "换成腊肠丁同煮，粤式风味更明显。"
  ],
  "serving_suggestion": "倒扣在小碗里成型再脱模，配烤鸡与黄瓜片，是菲律宾节庆餐桌的主角。",
  "storage": "冷藏可放两天，复热用蒸锅蒸八分钟，微波会让糯米发硬。",
