  "equipment": [
    "汤锅",
    "大玻璃杯",
    "刀",
    "砧板",
    "勺子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "紫薯去皮切厚片，上锅蒸十五分钟到能用筷子插透。",
      "time_min": 18,
      "heat": "中火",
      "tip": "蒸到筷子一插就进，压出来才细腻。，注意火候。",
      "visual_cue": "薯片发软，颜色深紫，状态稳定"
    },
    {
      "n": 2,
      "text": "红腰豆提前泡发煮熟，沥干后拌一小勺白糖。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆子煮软拌糖，咬着才不会寡淡。，注意火候。",
      "visual_cue": "豆粒完整，轻压即碎，状态稳定"
    },
    {
      "n": 3,
      "text": "紫薯趁热压成粗泥，放凉备用。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压粗一点，冰里才有嚼头。，注意火候。",
      "visual_cue": "泥体带颗粒，颜色均匀"
    },
    {
      "n": 4,
      "text": "香蕉去皮斜切薄片，菠萝切成小方丁。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水果切薄，冰镇后口感才顺。，注意火候。",
      "visual_cue": "片形整齐，果香清甜，状态稳定"
    },
    {
      "n": 5,
      "text": "大玻璃杯底部先放紫薯泥和红腰豆。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先放重的料，上层才不会塌。，注意火候。",
      "visual_cue": "杯底压实，层次分明，状态稳定"
    },
    {
      "n": 6,
      "text": "依次铺上香蕉片、菠萝丁，再撒一层白糖。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "每层压一压，倒奶时才不浮起。，注意火候。",
      "visual_cue": "层次清晰，果料铺满，状态稳定"
    },
    {
      "n": 7,
      "text": "牛奶与椰奶混合，沿杯壁慢慢倒入杯中。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "沿壁慢倒，层次才不被冲散。，注意火候。",
      "visual_cue": "液面平稳，层次未乱，状态稳定"
    },
    {
      "n": 8,
      "text": "顶部淋一勺炼乳，静置五分钟让味道融合。这一步不要着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "淋在顶上，吃的时候再拌开。，注意火候。",
      "visual_cue": "奶层柔滑，香气浓郁，状态稳定"
    }
  ],
  "tips": [
    "紫薯蒸透再压泥，口感才细腻。，值得留意。",
    "每层压一压，倒奶时层次才不乱。，值得留意。",
    "炼乳最后淋，拌开才够甜香。，值得留意。"
  ],
  "common_mistakes": [
    "紫薯没蒸透就压，泥里全是硬块。，值得留意。",
    "奶倒太急，整杯冲成一团糊。，值得留意。",
    "水果切太厚，冰镇后咬着发涩。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "紫薯",
      "substitute": "红薯",
      "ratio": "200 克:200 克",
      "note": "颜色偏橙，甜度更高。"
    },
    {
      "original": "炼乳",
      "substitute": "牛奶加白糖",
      "ratio": "80 克:100 毫升加 20 克",
      "note": "奶香略淡，糖量可略增。"
    }
  ],
  "variations": [
    "加一球香草冰淇淋，奶味更足。，值得留意。",
    "顶层放几块脆米，口感更丰富。，值得留意。"
  ],
  "serving_suggestion": "用长勺从底往上拌开，边拌边吃最有层次。，效果更稳定。",
  "storage": "冷藏一天，水果部分建议现做现吃。，效果更稳定。",
