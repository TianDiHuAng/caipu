  "steps": [
    {
      "n": 1,
      "text": "南瓜去皮切块，茄子切滚刀段。，注意别烧干，口感才不发柴。",
      "time_min": 10,
      "heat": "无火",
      "tip": "块别太小，煮久才不烂。，火别太大，颜色才够亮。",
      "visual_cue": "块形整齐，切口平整，保持小火，风味才干净。"
    },
    {
      "n": 2,
      "text": "苦瓜剖开去籽，切成厚片。，起锅前尝味，食材才不糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "籽刮净，苦味才不重。，起锅前尝味，成品才好看。",
      "visual_cue": "片厚均匀，瓜瓤干净，注意别烧干，风味才干净。"
    },
    {
      "n": 3,
      "text": "虾米温水泡五分钟，捞出沥干。，盖盖焖一会儿，味道才不闷。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡软的虾米才出鲜。，火别太大，形状才完整。",
      "visual_cue": "虾米回软，水色发黄，翻动放轻，风味才干净。"
    },
    {
      "n": 4,
      "text": "汤锅倒植物油，中火炒洋葱和蒜末。，时间掐准，细节才到位。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒透，汤才香。，顺序照着来，整道菜才立得住。",
      "visual_cue": "洋葱透明，香气升起，顺序照着来，形状才完整。"
    },
    {
      "n": 5,
      "text": "下虾米和红辣椒炒出香味。，份量心里有数，形状才完整。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾米炒一下，鲜味才释放。，锅温要匀，咸淡才好把握。",
      "visual_cue": "虾米卷曲，油色变橙，保持小火，火候才均匀。"
    },
    {
      "n": 6,
      "text": "倒椰奶，小火加热别煮沸。，慢慢来别急，味道才不闷。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火加热，椰奶才不会分层。，下手别慌，表面才漂亮。",
      "visual_cue": "奶面微沸，香气甜润，动作放连贯，火候才均匀。"
    },
    {
      "n": 7,
      "text": "先下南瓜和苦瓜，小火煮十分钟。，翻动放轻，火候才均匀。",
      "time_min": 12,
      "heat": "小火",
      "tip": "耐煮的先下，火候才齐。，料别一次下太多，食材才不糊。",
      "visual_cue": "南瓜微软，苦瓜变色，手法轻些，口感才不发柴。"
    },
    {
      "n": 8,
      "text": "加茄子再煮八分钟，煮到软透。，份量心里有数，风味才干净。",
      "time_min": 9,
      "heat": "小火",
      "tip": "茄子后放，才不化在汤里。，慢慢来别急，表面才漂亮。",
      "visual_cue": "茄子软塌，汤色乳白，先试试温度，香气才留得住。"
    },
    {
      "n": 9,
      "text": "加盐和鱼露调味，关火盛碗。，翻动放轻，表面才漂亮。",
      "time_min": 4,
      "heat": "小火",
      "tip": "鱼露最后加，鲜味才不跑。，手法轻些，风味才干净。",
      "visual_cue": "汤色奶白，咸鲜适口，料别一次下太多，锅气才足。"
    }
  ],
  "tips": [
    "椰奶全程小火，才不会分层。，保持小火，食材才不糊。",
    "苦瓜籽要刮净，苦味才不冲。，顺序照着来，口感才不发柴。",
    "茄子后放，久了会化在汤里。，盖盖焖一会儿，香气才不跑。"
  ],
  "common_mistakes": [
    "椰奶大火沸腾，油水分离。，汤汁别收太干，口感才不散。",
    "蔬菜切太小，煮成糊。，别急着加油，成品才稳当。",
    "盐加太早，南瓜出水变软。，手法轻些，火候才均匀。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "淡奶油",
      "ratio": "500 毫升:400 毫升",
      "note": "奶香更浓，需多加一百毫升高汤。"
    },
    {
      "original": "虾米",
      "substitute": "虾",
      "ratio": "40 克:200 克",
      "note": "虾最后五分钟下，煮久会老。"
    }
  ],
  "variations": [
    "加芋头块，口感更粉。，顺序照着来，咸淡才好把握。",
    "加米粉，直接做成一顿主食。，锅温要匀，锅气才足。"
  ],
  "serving_suggestion": "配白米饭，把汤浇在饭上。，火别太大，风味才干净。",
  "storage": "冷藏两天，复热用小火。，份量心里有数，味道才进得去。",
