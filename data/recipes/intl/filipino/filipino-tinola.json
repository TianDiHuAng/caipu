  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡腿肉",
          "name_en": "chicken thigh",
          "amount": 500,
          "unit": "g",
          "note": "带骨切块",
          "optional": false
        },
        {
          "name": "胡萝卜",
          "name_en": "carrot",
          "amount": 150,
          "unit": "g",
          "note": "切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 100,
          "unit": "g",
          "note": "切丝",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 20,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1200,
          "unit": "ml",
          "note": "煮汤",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉带骨切成小块，用清水冲洗掉血水后沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洗掉血水，汤才清不发腥。多练两次就熟。",
      "visual_cue": "鸡肉颜色发白，盆底无血水"
    },
    {
      "n": 2,
      "text": "洋葱切丝，大蒜切末，胡萝卜切成滚刀块备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "块切大一点，久煮才不会烂。细节决定成败。",
      "visual_cue": "胡萝卜块棱角分明，洋葱丝均匀"
    },
    {
      "n": 3,
      "text": "汤锅中火下橄榄油，先炒洋葱丝到透明发软。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒出甜味，汤底才厚。这一步别省。",
      "visual_cue": "洋葱透明，锅里香气上来"
    },
    {
      "n": 4,
      "text": "加蒜末炒三十秒，闻到香味后下鸡块翻炒。动作要快别拖延。",
      "time_min": 6,
      "heat": "中火",
      "tip": "鸡块炒到表面变色，汤才不浑。顺序别颠倒。",
      "visual_cue": "鸡块表面变白，锅底留香"
    },
    {
      "n": 5,
      "text": "撒盐与黑胡椒，翻炒两分钟让鸡肉先入味。随时观察锅里的状态。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先调味，鸡肉里面才有咸味。火候要盯住。",
      "visual_cue": "鸡肉表面收紧，锅里有汁"
    },
    {
      "n": 6,
      "text": "倒入清水大火烧开，撇净汤面的浮沫。翻动要轻别弄碎。",
      "time_min": 7,
      "heat": "大火",
      "tip": "浮沫撇干净，汤色才清亮。多练两次就熟。",
      "visual_cue": "汤面干净，泡沫全部撇掉"
    },
    {
      "n": 7,
      "text": "转小火盖盖煮二十分钟，让鸡肉煮到软嫩。手上别停以免粘锅。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火慢煮，鸡肉才不柴不散。细节决定成败。",
      "visual_cue": "鸡肉一戳就透，汤色清亮"
    },
    {
      "n": 8,
      "text": "加入胡萝卜块，小火再煮十分钟到软。过程中注意火候变化。",
      "time_min": 11,
      "heat": "小火",
      "tip": "胡萝卜后下，煮完还有口感。这一步别省。",
      "visual_cue": "胡萝卜能用筷子扎进去"
    },
    {
      "n": 9,
      "text": "尝味补盐，盛碗后撒少许黑胡椒即可上桌。动作要快别拖延。",
      "time_min": 3,
      "heat": "无火",
      "tip": "上桌前再补盐，咸淡才准。顺序别颠倒。",
      "visual_cue": "汤清味鲜，浮着少许油花"
    }
  ],
  "tips": [
    "鸡块先炒再煮，汤才香不发腥。火候要盯住。",
    "浮沫要撇干净，汤色才清亮。多练两次就熟。",
    "胡萝卜后下，煮十分钟刚好软而不烂。"
  ],
  "common_mistakes": [
    "鸡肉不焯不洗直接煮，汤浑带腥味。",
    "全程大火滚，鸡肉散成渣。这一步别省。",
    "胡萝卜一开始就下锅，煮到最后化在汤里。"
  ],
  "substitutions": [
    {
      "original": "胡萝卜",
      "substitute": "南瓜",
      "ratio": "150 克:200 克",
      "note": "汤会变甜，更稠。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "500 克:450 克",
      "note": "更瘦，煮十五分钟即可。"
    }
  ],
  "variations": [
    "加一把青木瓜块同煮，清甜更明显。",
    "出锅前淋几滴鱼露，鲜味更足。细节决定成败。"
  ],
  "serving_suggestion": "配白米饭，菲律宾人习惯把汤浇在饭上，一边喝汤一边吃肉。",
  "storage": "冷藏两天，冷冻可放一个月，复热须彻底滚透。",
