  "steps": [
    {
      "n": 1,
      "text": "猪肉末放碗里，加盐和黑胡椒抓匀。，留意锅底，锅气才足。",
      "time_min": 6,
      "heat": "无火",
      "tip": "抓出黏性，口感才弹。，盖盖焖一会儿，风味才干净。",
      "visual_cue": "肉末发黏，颜色均匀，料别一次下太多，成品才稳当。"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，中火烧热下肉末。，注意别烧干，食材才不糊。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉末下锅别急翻，先定型。，注意别烧干，火候才均匀。",
      "visual_cue": "肉末贴锅，油花滋滋，时间掐准，口感才不散。"
    },
    {
      "n": 3,
      "text": "用铲把肉末压散，炒到表面焦香。，盖盖焖一会儿，细节才到位。",
      "time_min": 8,
      "heat": "中火",
      "tip": "压散再炒，才有焦脆边。，火别太大，咸淡才好把握。",
      "visual_cue": "肉末颗粒分明，边缘焦黄"
    },
    {
      "n": 4,
      "text": "下洋葱丁和蒜末，炒到洋葱透明。，动作放连贯，细节才到位。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才出来。，慢慢来别急，味道才进得去。",
      "visual_cue": "洋葱软塌，香气升起，慢慢来别急，风味才干净。"
    },
    {
      "n": 5,
      "text": "加浓口酱油和白醋，翻炒到收汁。，汤汁别收太干，口感才有层次。",
      "time_min": 6,
      "heat": "中火",
      "tip": "醋后放，酸味才清。，动作放连贯，成品才稳当。",
      "visual_cue": "汁水收干，肉末油亮，盖盖焖一会儿，颜色才够亮。"
    },
    {
      "n": 6,
      "text": "加白糖和红辣椒圈，翻两下尝味。，时间掐准，颜色才够亮。",
      "time_min": 3,
      "heat": "中火",
      "tip": "糖提味，别放多。，留意锅底，整道菜才立得住。",
      "visual_cue": "辣香扑鼻，咸酸平衡，份量心里有数，口感才不发柴。"
    },
    {
      "n": 7,
      "text": "关火挤柠檬汁，撒小葱末拌匀。，顺序照着来，成品才好看。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬关火挤，香气才鲜。，顺序照着来，吃口才舒服。",
      "visual_cue": "酸香清新，葱末翠绿，保持小火，口感才有层次。"
    },
    {
      "n": 8,
      "text": "盛盘，趁热配米饭上桌。，手法轻些，表面才漂亮。，起锅前尝味，火候才均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃，凉了会腻。，注意别烧干，成品才好看。",
      "visual_cue": "盘底干净，肉末松散，先试试温度，成品才好看。"
    }
  ],
  "tips": [
    "肉末要炒出焦脆边，口感才对。，盖盖焖一会儿，形状才完整。",
    "醋在炒制中加，酸味才不刺。，注意别烧干，口感才不散。",
    "柠檬汁最后挤，香气最清。，注意别烧干，吃口才舒服。"
  ],
  "common_mistakes": [
    "肉末一下锅就猛翻，炒成糊。，盖盖焖一会儿，味道才进得去。",
    "醋加太多，酸得发冲。，翻动放轻，口感才不散。",
    "不挤柠檬，味道发闷。，汤汁别收太干，香气才留得住。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉",
      "ratio": "600 克:600 克",
      "note": "剁成粗粒，炒制时间加两分钟。"
    },
    {
      "original": "白醋",
      "substitute": "米醋",
      "ratio": "20 毫升:20 毫升",
      "note": "酸味更柔，柠檬可减半。"
    }
  ],
  "variations": [
    "打一个鸡蛋在上头，铁板热度烫熟。，时间掐准，风味才干净。",
    "加一点辣酱，辣味更冲。，留意锅底，口感才不散。"
  ],
  "serving_suggestion": "配白米饭，挤柠檬汁吃。，别用力搅，整道菜才立得住。",
  "storage": "冷藏两天，复热用炒锅。，锅温要匀，成品才稳当。",
