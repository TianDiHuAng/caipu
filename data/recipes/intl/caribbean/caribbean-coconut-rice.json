  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "大米",
          "name_en": "rice",
          "amount": 400,
          "unit": "g",
          "note": "长粒米",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 400,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 80,
          "unit": "g",
          "note": "切丁",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 10,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 20,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 200,
          "unit": "ml",
          "note": "调节浓稠",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "木勺",
    "滤篮",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米用清水淘洗两遍，直到水变清后沥干备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洗到水清，饭才不粘不糊。火候要盯住。",
      "visual_cue": "淘米水由浑变清，米粒干净"
    },
    {
      "n": 2,
      "text": "洋葱切成小丁，大蒜拍碎后切成细末备用。手上别停以免粘锅。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切细一点，炒香才均匀。多练两次就熟。",
      "visual_cue": "洋葱丁大小一致，蒜末细白"
    },
    {
      "n": 3,
      "text": "汤锅中火下橄榄油，炒洋葱丁三分钟到透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "炒出甜味，椰香才有层次。细节决定成败。",
      "visual_cue": "洋葱透明发软，锅里有香味"
    },
    {
      "n": 4,
      "text": "加蒜末炒三十秒，闻到蒜香立刻下大米。过程中注意火候变化。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "蒜末别炒黄，黄了就发苦。这一步别省。",
      "visual_cue": "蒜香冲出，米粒倒进锅里"
    },
    {
      "n": 5,
      "text": "中火翻炒两分钟，让每粒米都裹上一层油。动作要快别拖延。",
      "time_min": 3,
      "heat": "中火",
      "tip": "米粒炒到边缘透明，煮出来才松散。",
      "visual_cue": "米粒油亮，边缘半透明"
    },
    {
      "n": 6,
      "text": "倒入椰奶与清水，加盐搅匀后大火烧开。随时观察锅里的状态。",
      "time_min": 4,
      "heat": "大火",
      "tip": "椰奶容易糊底，烧开前要搅一次。",
      "visual_cue": "液面翻滚，米粒浮起"
    },
    {
      "n": 7,
      "text": "转最小火盖严锅盖，焖十八分钟不要开盖。翻动要轻别弄碎。",
      "time_min": 19,
      "heat": "小火",
      "tip": "中途开盖蒸汽跑了，饭就夹生。顺序别颠倒。",
      "visual_cue": "锅盖边缘冒细气，闻得到椰香"
    },
    {
      "n": 8,
      "text": "关火继续焖五分钟，用木勺从底部翻松米饭。",
      "time_min": 7,
      "heat": "无火",
      "tip": "焖够再翻，米粒才松不粘。火候要盯住。",
      "visual_cue": "饭粒分明，椰香浓郁"
    },
    {
      "n": 9,
      "text": "尝味补盐，装碗后撒少许椰蓉或葱末点缀。手上别停以免粘锅。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热尝咸淡，凉了味觉会迟钝。多练两次就熟。",
      "visual_cue": "饭粒油亮松散，椰香扑鼻"
    }
  ],
  "tips": [
    "大米洗到水清，煮出的饭才清爽不粘。",
    "椰奶烧开前搅一次锅底，防止糊锅。",
    "焖饭全程最小火，中途千万不要开盖。"
  ],
  "common_mistakes": [
    "火太大又没盖严，椰奶烧干锅底焦黑。",
    "椰奶与清水比例失调，饭煮成稠粥。",
    "一开锅就翻饭，米粒被压成团。细节决定成败。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "400 毫升:400 毫升",
      "note": "奶香更淡，不加糖更适合配菜。"
    },
    {
      "original": "清水",
      "substitute": "椰奶",
      "ratio": "200 毫升:200 毫升",
      "note": "椰香更浓，容易腻。"
    }
  ],
  "variations": [
    "加一小把葡萄干同焖，甜味更有层次。",
    "用一半椰奶一半鸡汤，鲜味更足。"
  ],
  "serving_suggestion": "配烤鸡或咖喱虾一起上桌，饭粒吸了酱汁更香，是加勒比餐桌的固定搭配。",
  "storage": "冷藏两天，复热时撒一勺清水盖盖小火焖三分钟。",
