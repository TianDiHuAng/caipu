  "equipment": [
    "深煎锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "海鲈鱼切成三厘米厚块，用一半盐和青柠汁抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌十分钟去腥增鲜，别腌太久肉质会发紧。",
      "visual_cue": "鱼块表面泛白有光泽"
    },
    {
      "n": 2,
      "text": "深煎锅放植物油中火烧热，把鱼块两面各煎两分钟盛出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "鱼皮朝下先煎，定型后再翻面才不散。",
      "visual_cue": "鱼块两面微黄定型"
    },
    {
      "n": 3,
      "text": "原锅下洋葱丝炒到透明，加大蒜末、生姜末和小米椒炒出香味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "姜蒜后放，才不会被洋葱的水汽闷苦。",
      "visual_cue": "洋葱透明，香气扑鼻"
    },
    {
      "n": 4,
      "text": "下咖喱粉小火炒三十秒，让香料在油里完全释放颜色。",
      "time_min": 2,
      "heat": "小火",
      "tip": "咖喱粉炒出油色，味道才不会生涩。",
      "visual_cue": "锅里泛出橙黄油亮色"
    },
    {
      "n": 5,
      "text": "加番茄块炒两分钟，倒清水煮开后转小火煮五分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "番茄炒软出汁，汤底才自然浓稠。",
      "visual_cue": "番茄塌软，汤汁微稠"
    },
    {
      "n": 6,
      "text": "倒入椰浆和剩下的盐搅匀，小火煮三分钟到汤汁融合。",
      "time_min": 4,
      "heat": "小火",
      "tip": "椰浆下锅后别大火滚，容易分层。",
      "visual_cue": "汤汁乳白，表面细密油纹"
    },
    {
      "n": 7,
      "text": "把煎好的鱼块放回锅里，盖盖小火焖五分钟入味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "鱼块最后回锅，才不会煮散成碎末。",
      "visual_cue": "鱼块完整浸在椰汁里"
    },
    {
      "n": 8,
      "text": "关火挤入青柠汁，撒香菜碎后连汁一起盛盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁关火后再挤，酸香更清爽。",
      "visual_cue": "表面撒满绿色香菜"
    }
  ],
  "tips": [
    "海鲈鱼先煎定型，回锅焖煮时才不会散。",
    "咖喱粉要用小火在油里炒过，香味才足。",
    "椰浆下锅后保持小火，避免油脂分层。"
  ],
  "common_mistakes": [
    "鱼块直接下锅煮，翻动几次就碎成渣。",
    "咖喱粉用大火炒，几秒钟就焦黑发苦。",
    "椰浆大火滚煮，汤汁分离出一层油。"
  ],
  "substitutions": [
    {
      "original": "海鲈鱼",
      "substitute": "鳕鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更嫩，焖煮时间减两分钟。"
    },
    {
      "original": "椰浆",
      "substitute": "淡奶油",
      "ratio": "200 毫升:180 毫升",
      "note": "奶香更浓，椰香减弱。"
    }
  ],
  "variations": [
    "加半个甜椒切丝同炒，颜色更亮。",
    "加一勺鱼露提鲜，咸味更有层次。"
  ],
  "serving_suggestion": "浇在白饭上配一份炸芭蕉片，是加勒比海岛常见的午餐吃法。",
  "storage": "冷藏两天，复热用小火加少量清水慢慢加热，不要大火滚沸。",
