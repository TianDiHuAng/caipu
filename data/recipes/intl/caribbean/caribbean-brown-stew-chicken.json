  "equipment": [
    "炖锅",
    "锅铲",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉剁成五厘米的块，用生抽、蒜末与姜末抓匀腌二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "腌够时间，鸡肉里才有底味。",
      "visual_cue": "鸡块表面均匀上色"
    },
    {
      "n": 2,
      "text": "炖锅倒植物油，中小火放白糖炒到融化变成深褐色。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖色到枣红就下鸡，久了会发苦。",
      "visual_cue": "糖浆深褐，冒细密小泡"
    },
    {
      "n": 3,
      "text": "下鸡块快速翻炒，让每块都裹上糖色并煎到表面定型。",
      "time_min": 6,
      "heat": "中火",
      "tip": "裹上糖色，炖出来的颜色才漂亮。",
      "visual_cue": "鸡块呈酱褐色，表面微焦"
    },
    {
      "n": 4,
      "text": "加洋葱丁炒三分钟，炒到洋葱变软透明的状态。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒软，汤汁才有自然甜味。",
      "visual_cue": "洋葱变透明，边缘发软"
    },
    {
      "n": 5,
      "text": "放番茄块继续炒三分钟，炒到番茄出汁成糊。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄炒出汁，汤汁才浓稠挂肉。",
      "visual_cue": "番茄软烂，锅里有红汁"
    },
    {
      "n": 6,
      "text": "倒入三百毫升热水，加黑胡椒与盐，大火煮开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "热水下锅，鸡肉不会突然收紧变柴。",
      "visual_cue": "液面滚开，颜色红褐"
    },
    {
      "n": 7,
      "text": "放入南瓜块铺在表面，盖盖小火炖二十五分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "南瓜铺上面，煮久也不会散烂。",
      "visual_cue": "南瓜软透，汤汁略收"
    },
    {
      "n": 8,
      "text": "开盖中火收汁五分钟，收到汤汁挂在鸡块上为止。",
      "time_min": 5,
      "heat": "中火",
      "tip": "边收边晃锅，别让糖分糊底。",
      "visual_cue": "汤汁浓稠，油光浮起"
    },
    {
      "n": 9,
      "text": "尝一下味道补盐，撒香菜碎后配热米饭上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "收过汁再调味，咸淡才准确。",
      "visual_cue": "鸡块酱亮，汤汁挂勺"
    }
  ],
  "tips": [
    "炒糖色到枣红就下鸡，颜色才亮不发苦。",
    "热水下锅慢炖，鸡肉才嫩不会变柴。",
    "最后把汤汁收到挂勺，风味才够集中。"
  ],
  "common_mistakes": [
    "糖色炒到发黑才下鸡，整锅带苦味。",
    "加冷水炖煮，鸡肉紧缩口感发柴。",
    "不盖盖大火猛煮，南瓜全化成糊。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "800 克:900 克",
      "note": "炖制时间减到十八分钟。"
    },
    {
      "original": "南瓜",
      "substitute": "土豆",
      "ratio": "300 克:300 克",
      "note": "口感更粉，汤汁会更稠。"
    }
  ],
  "variations": [
    "加一勺辣酱同炖，甜辣对比更明显。",
    "放几块菠萝同炖，果香更清爽解腻。"
  ],
  "serving_suggestion": "浇在热米饭上，配一份清炒蔬菜同吃。",
  "storage": "冷藏三天、冷冻一个月，复热小火加少量水。",
