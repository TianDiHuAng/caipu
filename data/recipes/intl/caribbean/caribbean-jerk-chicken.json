  "equipment": [
    "烤箱",
    "研钵或料理机",
    "保鲜袋",
    "烤架",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉带皮一面划两刀到骨，用五克盐和黑胡椒抹匀，静置十五分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "划刀是为了让香料进到厚肉处，否则只有表面有味。",
      "visual_cue": "鸡皮上划出两道深口，肉色略变"
    },
    {
      "n": 2,
      "text": "洋葱、小葱、大蒜、姜、小米椒与青柠汁、酱油、植物油一起打成粗糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打成粗糊而非细泥，留一点颗粒烤出来更香。",
      "visual_cue": "糊状带明显碎粒，颜色深红发亮"
    },
    {
      "n": 3,
      "text": "糊里拌入肉桂、肉豆蔻、百里香、辣椒粉、白糖和蜂蜜，调成稠厚的腌酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "肉桂与肉豆蔻各一点点就够，多了会盖住辣香。",
      "visual_cue": "腌酱浓稠能挂住鸡皮"
    },
    {
      "n": 4,
      "text": "鸡腿肉与腌酱抓匀装袋，冷藏腌四小时以上，中途翻面一次。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌足四小时，香料才走到肉里，急用也别少于两小时。",
      "visual_cue": "鸡皮被酱料染成深红褐色"
    },
    {
      "n": 5,
      "text": "烤箱两百度预热，鸡腿肉放烤架上，皮朝上烤二十五分钟至边缘焦黑。",
      "time_min": 28,
      "heat": "大火",
      "tip": "用烤架架空烤，油滴下去才不会把鸡泡软。",
      "visual_cue": "鸡皮焦褐起泡，滴落的油在盘底滋滋响"
    },
    {
      "n": 6,
      "text": "取出静置五分钟，斩块装盘，挤剩余青柠汁，撒香菜叶。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置让肉汁回流，切开才不流一盘水。",
      "visual_cue": "切面汁水清亮，皮色深褐带焦痕"
    }
  ],
  "tips": [
    "腌酱里的辣椒与 cinnamon 比例是这道菜的性格，辣要够、香料要压得住。",
    "没有烤箱可用炭火烤，明火焦香更接近街头风味。",
    "烤到表面略焦是正常的，牙买加本地就追求这点焦黑。"
  ],
  "common_mistakes": [
    "腌十分钟就烤，香料只浮在皮上。",
    "鸡肉堆在烤盘里烤，底部被油水泡住，皮软塌不脆。",
    "肉桂放多，整盘像甜点，辣香全被盖住。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "800 克:800 克",
      "note": "翅根肉薄，烤制时间减到十八分钟。"
    },
    {
      "original": "小米椒",
      "substitute": "辣椒酱",
      "ratio": "30 克:40 克",
      "note": "辣度更稳定，可少放白糖。"
    }
  ],
  "variations": [
    "把腌料换成猪排骨，腌一夜后同样烤制，就是牙买加风味的烤排骨。"
  ],
  "serving_suggestion": "配米饭与青柠角，也可配烤甜椒和洋葱。",
  "storage": "冷藏两天，冷冻一个月；复热用烤箱两百度八分钟恢复脆皮。",
