    "碗",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去内脏洗净，在鱼身两侧各划三刀方便入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刀口划到骨，腌料和热油才进得去。，注意火候。",
      "visual_cue": "鱼身干净，刀口整齐，状态稳定"
    },
    {
      "n": 2,
      "text": "鱼身抹盐和白胡椒，塞入香叶和部分蒜片腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "里外都抹到，鱼肉才不腥。，注意火候。",
      "visual_cue": "表面泛盐，香气微出，状态稳定"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油烧到一百七十度，鱼放进去中火煎炸。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温够高再下锅，鱼皮才不粘破。，注意火候。",
      "visual_cue": "油面翻泡，鱼身定型，状态稳定"
    },
    {
      "n": 4,
      "text": "两面各煎五分钟到金黄酥脆，捞出沥油装盘。这一步不要着急。",
      "time_min": 10,
      "heat": "中火",
      "tip": "翻动只做一次，鱼皮完整才好看。，注意火候。",
      "visual_cue": "两面金黄，鱼皮完整，状态稳定"
    },
    {
      "n": 5,
      "text": "锅留底油，下洋葱圈、胡萝卜丝和青椒丝中火炒软。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蔬菜炒到断生就好，还要保持脆感。，注意火候。",
      "visual_cue": "蔬菜变软，颜色鲜亮，状态稳定"
    },
    {
      "n": 6,
      "text": "加白糖、柠檬汁和少许清水煮开，做成酸甜腌汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "糖先化开再尝酸度，酸甜要平衡。，注意火候。",
      "visual_cue": "汁水微稠，香气酸爽，状态稳定"
    },
    {
      "n": 7,
      "text": "把热腌汁连蔬菜一起浇在鱼身上，静置十分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "趁汁热浇，鱼肉才吸得进味道。，注意火候。",
      "visual_cue": "鱼身覆菜，汁水浸入，状态稳定"
    }
  ],
  "tips": [
    "鱼身划三刀，腌料和热油才进得去。，值得留意。",
    "油温够高再下鱼，鱼皮才完整。，值得留意。",
    "腌汁趁热浇，鱼肉入味更快。，值得留意。"
  ],
  "common_mistakes": [
    "鱼带水下油锅，油溅还粘底破皮。，值得留意。",
    "蔬菜炒过头，口感软塌没脆感。，值得留意。",
    "腌汁太酸，把鱼本味盖掉了。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "罗非鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更紧，煎制时间加两分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "60 克:60 克",
      "note": "香气更冲，糖可加五克。"
    }
  ],
  "variations": [
    "加几片苏格兰帽椒，辣味更地道。，值得留意。",
    "腌汁里放一小勺多香果，香气更复杂。，值得留意。"
  ],
  "serving_suggestion": "配米饭和煎香蕉一起吃，酸甜汁拌饭特别香。",
  "storage": "冷藏一天，复热用烤箱一百八十度烤八分钟。",
