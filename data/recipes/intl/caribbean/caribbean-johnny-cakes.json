          "name_en": "yeast",
          "amount": 5,
          "unit": "g",
          "note": "发面",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 150,
          "unit": "ml",
          "note": "和面",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 300,
          "unit": "ml",
          "note": "炸制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "平底锅",
    "擀面杖",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉过筛加盐、白糖和酵母，拌匀后在中间挖一个小坑。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛两遍，饼皮才细腻蓬松。，注意火候。",
      "visual_cue": "粉质细滑，无结块，状态稳定"
    },
    {
      "n": 2,
      "text": "倒入温牛奶和软化的黄油，从中间慢慢揉成面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "牛奶别太烫，会把酵母烫死发不起来。",
      "visual_cue": "面团成型，不粘手，状态稳定"
    },
    {
      "n": 3,
      "text": "揉到表面光滑后盖布醒发半小时，面团会略涨。",
      "time_min": 32,
      "heat": "无火",
      "tip": "醒发时间够，炸出的饼才松软。，注意火候。",
      "visual_cue": "面团微胀，指压回弹，状态稳定"
    },
    {
      "n": 4,
      "text": "把面团分成八份，逐个搓圆后压成一厘米厚的圆饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致，炸的时候才同时熟。，注意火候。",
      "visual_cue": "圆饼匀厚，边缘圆润，状态稳定"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油烧到一百六十度，放入圆饼中火炸。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温别太高，外面焦了里面还没熟。，注意火候。",
      "visual_cue": "油面细泡，饼体浮起，状态稳定"
    },
    {
      "n": 6,
      "text": "一面炸两分钟到金黄后翻面，另一面再炸两分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "翻面轻一点，别把饼压出坑。，注意火候。",
      "visual_cue": "两面金黄，体积鼓起，状态稳定"
    },
    {
      "n": 7,
      "text": "捞出放厨房纸上吸油，稍晾两分钟再吃。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刚出锅内部很烫，晾一下再咬。，注意火候。",
      "visual_cue": "表面干爽，油已吸走，状态稳定"
    }
  ],
  "tips": [
    "面粉过筛两遍，饼皮才细腻蓬松。，值得留意。",
    "牛奶温热就够，太烫会烫死酵母。，值得留意。",
    "油温一百六十度下锅，里外同时熟。，值得留意。"
  ],
  "common_mistakes": [
    "面团没醒发就炸，成品又硬又实。，值得留意。",
    "油温太低，饼吸一肚子油。，值得留意。",
    "饼压得太厚，外面焦黑里面还是生面。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "50 克:40 毫升",
      "note": "面团略硬，可多加十毫升牛奶。"
    },
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "150 毫升:150 毫升",
      "note": "香气更浓，糖可减五克。"
    }
  ],
  "variations": [
    "面团里加一小勺肉桂粉，香气更暖。，值得留意。",
    "做成小圆球形状，方便一口一个。，值得留意。"
  ],
  "serving_suggestion": "趁热配炸鱼或咖喱鸡，也可以抹黄油单吃。，效果更稳定。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤五分钟。",
