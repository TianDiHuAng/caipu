  "equipment": [
    "汤锅",
    "料理棒",
    "刀",
    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜洗净泥沙，摘掉老梗后切成段备用。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "老梗纤维粗，去掉汤才顺滑。，注意火候。",
      "visual_cue": "叶片干净，梗已去除，状态稳定"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油烧热，下洋葱碎和蒜末小火炒香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒软，汤的底味才甜。，注意火候。",
      "visual_cue": "洋葱透明，香气升起，状态稳定"
    },
    {
      "n": 3,
      "text": "加胡萝卜丁和土豆块翻炒三分钟，让表面裹上油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "先炒后煮，土豆才不散汤也不寡淡。，注意火候。",
      "visual_cue": "蔬菜油亮，边缘略软，状态稳定"
    },
    {
      "n": 4,
      "text": "倒入椰奶和两碗清水，大火烧开后转小火煮十分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "椰奶别大火滚，容易油水分离。，注意火候。",
      "visual_cue": "汤面微沸，颜色奶白，状态稳定"
    },
    {
      "n": 5,
      "text": "放入菠菜段煮五分钟到完全软塌。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "菠菜煮软塌，打成泥才细腻。，注意火候。",
      "visual_cue": "叶片软塌，颜色深绿，状态稳定"
    },
    {
      "n": 6,
      "text": "用料理棒把汤打成细滑的浓汤，再放回火上。这一步不要着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "打之前离火，避免热汤飞溅烫手。，注意火候。",
      "visual_cue": "质地顺滑，无颗粒，状态稳定"
    },
    {
      "n": 7,
      "text": "下虾仁煮两分钟，加盐和白胡椒调味。这一步不要着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾仁一变色就好，久煮发柴。，注意火候。",
      "visual_cue": "虾仁卷曲，汤色浓绿，状态稳定"
    },
    {
      "n": 8,
      "text": "撒香菜碎后盛出，趁热配饭或单独喝。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，清香才留得住。，注意火候。",
      "visual_cue": "汤面油亮，香气浓郁，状态稳定"
    }
  ],
  "tips": [
    "菠菜煮到软塌再打，汤才细腻无渣。，值得留意。",
    "椰奶小火煮，大火容易油水分离。，值得留意。",
    "打汤前先离火，避免热汤飞溅。，值得留意。"
  ],
  "common_mistakes": [
    "菠菜没洗干净，汤里带沙。，值得留意。",
    "椰奶大火滚，汤汁分层看着发花。，值得留意。",
    "虾仁久煮，口感又老又硬。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "菠菜",
      "substitute": "芥蓝",
      "ratio": "500 克:500 克",
      "note": "略带苦味，可加少许白糖。"
    },
    {
      "original": "虾仁",
      "substitute": "培根",
      "ratio": "100 克:80 克",
      "note": "切条先炒，咸味更足。"
    }
  ],
  "variations": [
    "加几只秋葵同煮，汤更黏稠。，值得留意。",
    "放一小块咸鱼同煮，咸鲜更浓。，值得留意。"
  ],
  "serving_suggestion": "配白饭浇着吃，或者单独当一碗浓汤。，效果更稳定。",
  "storage": "冷藏两天，复热小火加少量水煮开。，效果更稳定。",
