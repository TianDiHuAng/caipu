  "equipment": [
    "厚底锅",
    "刀",
    "砧板",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆提前泡一夜，换水煮四十分钟至软但不烂，沥干备用。",
      "time_min": 50,
      "heat": "中火",
      "tip": "煮到用手指能压碎即可，过烂会糊在饭里。",
      "visual_cue": "红豆软而完整，不破皮"
    },
    {
      "n": 2,
      "text": "厚底锅下植物油，炒香洋葱末与蒜末至透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒出甜味，是这锅饭的底味。",
      "visual_cue": "洋葱透明，锅中香气浓"
    },
    {
      "n": 3,
      "text": "加小米辣圈与百里香炒半分钟，让香料裹上油。",
      "time_min": 2,
      "heat": "中火",
      "tip": "香料用油激发，香气才留得久。",
      "visual_cue": "锅中辛香明显，油面泛香"
    },
    {
      "n": 4,
      "text": "倒入椰奶与两百毫升水煮开，加盐与黑胡椒调味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "椰奶要用全脂的，稀的味道太寡淡。",
      "visual_cue": "液体乳白，微微冒泡"
    },
    {
      "n": 5,
      "text": "下淘洗好的米饭用米与红豆，搅匀后转小火加盖焖二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "加米后别频繁搅动，否则米粒破碎发黏。",
      "visual_cue": "米粒吸饱椰汁，表面冒小泡"
    },
    {
      "n": 6,
      "text": "关火后焖十分钟不开盖，让余温把米粒彻底焖透。",
      "time_min": 10,
      "heat": "无火",
      "tip": "焖这一步决定米粒是否松散。",
      "visual_cue": "开盖米粒分明，无硬心"
    },
    {
      "n": 7,
      "text": "撒小葱末，用叉子从底部松散地翻一遍再盛盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用叉子翻松比勺子压拌更不容易碾碎。",
      "visual_cue": "米粒松散，红豆分布均匀"
    }
  ],
  "tips": [
    "罐装红豆可直接用，冲洗沥干后最后十分钟加入。米饭和红豆的比例约三比二最合适。",
    "椰奶不要用低脂的，风味会明显不足。",
    "焖好后别急着开盖，余温让米粒更松软。"
  ],
  "common_mistakes": [
    "红豆煮得太烂，和米饭混成糊状。",
    "火太大水烧干，锅底糊成一层焦壳。",
    "加米后不停搅拌，米粒破碎成稠粥。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "芸豆",
      "ratio": "200 克:200 克",
      "note": "口感更绵，泡发时间延长两小时。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "400 毫升:400 毫升",
      "note": "香气减弱，可加五克黄油补足脂香。"
    }
  ],
  "variations": [
    "加几块腌好的鸡肉同焖，就是一锅端的鸡肉豆饭。",
    "把椰奶换成浓椰浆，风味更浓稠也更厚重。"
  ],
  "serving_suggestion": "配烤鸡、炖牛肉或炸鱼同食，淋一勺炖肉汁更香。",
  "storage": "冷藏两天、冷冻一个月；复热加两勺水小火焖八分钟。",
