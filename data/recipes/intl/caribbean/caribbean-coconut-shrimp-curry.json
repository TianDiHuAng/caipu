  "steps": [
    {
      "n": 1,
      "text": "虾去壳留尾，沿背划开挑出虾线，冲洗后沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "开背更容易入味，卷起来也好看。",
      "visual_cue": "虾身干净，背部划口清晰"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，中火炒香洋葱丁与蒜末，炒到洋葱透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味才出来。",
      "visual_cue": "洋葱透明，蒜香散发"
    },
    {
      "n": 3,
      "text": "加入咖喱粉与辣椒粉，小火炒三十秒炒出香气。",
      "time_min": 1,
      "heat": "小火",
      "tip": "干粉香料必须用油炒过，香味才开。",
      "visual_cue": "香料结块散开，锅底泛黄"
    },
    {
      "n": 4,
      "text": "下番茄块中火炒三分钟，炒到番茄软烂出汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄炒出汁，咖喱的酸甜底就稳了。",
      "visual_cue": "番茄塌软，锅里有红色汁水"
    },
    {
      "n": 5,
      "text": "倒入椰奶搅匀，小火煮五分钟让味道充分融合。",
      "time_min": 5,
      "heat": "小火",
      "tip": "椰奶别大火滚，容易分层出油。",
      "visual_cue": "汤汁乳白微黄，微微冒泡"
    },
    {
      "n": 6,
      "text": "放入虾仁小火煮四分钟，煮到变红卷曲即可。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾一变红就好，久了肉质发硬。",
      "visual_cue": "虾身卷曲成C形，颜色变红"
    },
    {
      "n": 7,
      "text": "加盐调味，撒上香菜碎，关火后即可出锅装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "椰奶本身带甜，盐要分两次加。",
      "visual_cue": "汤汁浓稠，虾身挂满酱汁"
    }
  ],
  "tips": [
    "香料用油炒过，咖喱的香气才出得来。",
    "虾最后下锅，四分钟足够，久了口感发柴。",
    "椰奶全程小火，一旦滚开就会分层出油。"
  ],
  "common_mistakes": [
    "咖喱粉直接倒进汤里，一股生粉味。",
    "虾煮得太久，缩成一颗颗硬球，口感发柴。",
    "用大火煮椰奶，锅面浮起一层油。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鸡腿肉",
      "ratio": "450 克:450 克",
      "note": "切块先煎再煮，风味更浓。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "250 毫升:250 毫升",
      "note": "奶香变淡，需加十克黄油增厚。"
    }
  ],
  "variations": [
    "加半个青椒切块同煮，颜色更漂亮。",
    "最后挤几滴青柠汁，酸香解掉椰奶的腻。"
  ],
  "serving_suggestion": "浇在香米饭上，配一片烤面包蘸汤汁。",
  "storage": "冷藏两天，复热小火加两勺清水，不要煮沸。",
