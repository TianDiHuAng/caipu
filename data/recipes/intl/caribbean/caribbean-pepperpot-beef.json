  "steps": [
    {
      "n": 1,
      "text": "牛腱切大块，用盐和黑胡椒抓匀。，份量心里有数，风味才干净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块大些，炖久才不散。，时间掐准，表面才漂亮。",
      "visual_cue": "块形方正，表面沾料，盖盖焖一会儿，香气才不跑。"
    },
    {
      "n": 2,
      "text": "炖锅倒植物油，大火把牛腱煎上色。，下手别慌，锅气才足。",
      "time_min": 8,
      "heat": "大火",
      "tip": "煎出焦壳，汤汁才厚。，别用力搅，口感才不发柴。",
      "visual_cue": "表面深褐，锅底有焦香，留意锅底，锅气才足。"
    },
    {
      "n": 3,
      "text": "牛腱盛出，锅里下洋葱、姜和蒜炒香。，顺序照着来，成品才好看。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒软，甜味才出。，翻动放轻，口感才不发柴。",
      "visual_cue": "洋葱透明，香气升起，翻动放轻，咸淡才好把握。"
    },
    {
      "n": 4,
      "text": "加红糖小火炒化，熬成深色糖色。，时间掐准，咸淡才好把握。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖别炒黑，发苦就毁锅。，留意锅底，咸淡才好把握。",
      "visual_cue": "糖浆冒泡，颜色深褐，锅温要匀，锅气才足。"
    },
    {
      "n": 5,
      "text": "牛腱回锅翻匀，裹上糖色。，汤汁别收太干，味道才不闷。",
      "time_min": 4,
      "heat": "中火",
      "tip": "翻匀些，颜色才一致。，手法轻些，整道菜才立得住。",
      "visual_cue": "肉块油亮，通体上色，锅温要匀，香气才不跑。"
    },
    {
      "n": 6,
      "text": "倒浓口酱油和清水，加百里香和红辣椒。，注意别烧干，香气才不跑。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水要没过肉，炖够才软。，保持小火，咸淡才好把握。",
      "visual_cue": "液面齐平，香气扑鼻，顺序照着来，味道才不闷。"
    },
    {
      "n": 7,
      "text": "煮开后转小火，盖盖炖一小时二十分。，盖盖焖一会儿，表面才漂亮。",
      "time_min": 82,
      "heat": "小火",
      "tip": "小火慢炖，肉才酥。，翻动放轻，锅气才足。",
      "visual_cue": "汤面微沸，肉块下沉，盖盖焖一会儿，火候才均匀。"
    },
    {
      "n": 8,
      "text": "开盖收汁到浓稠，尝味补盐。，时间掐准，口感才有层次。",
      "time_min": 8,
      "heat": "中火",
      "tip": "收汁要搅，锅底才不糊。，保持小火，吃口才舒服。",
      "visual_cue": "汁体浓稠，油光发亮，手法轻些，表面才漂亮。"
    },
    {
      "n": 9,
      "text": "盛盘浇汁，配烤面包食用。，翻动放轻，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "浇汁要匀，饭才入味。，时间掐准，细节才到位。",
      "visual_cue": "肉块泛光，汁面平整，汤汁别收太干，形状才完整。"
    }
  ],
  "tips": [
    "糖色炒到深褐就够，发黑会苦。，动作放连贯，锅气才足。",
    "小火慢炖，牛腱才酥而不散。，份量心里有数，火候才均匀。",
    "收汁时勤搅，糖分容易糊底。，别用力搅，香气才不跑。"
  ],
  "common_mistakes": [
    "糖色炒过头，整锅发苦。，盖盖焖一会儿，形状才完整。",
    "火太大，汤汁很快烧干。，翻动放轻，形状才完整。",
    "肉没煎上色，汤味发淡。，汤汁别收太干，成品才稳当。"
  ],
  "substitutions": [
    {
      "original": "牛腱",
      "substitute": "牛腩",
      "ratio": "900 克:900 克",
      "note": "更油润，炖制时间减十分钟。"
    },
    {
      "original": "红糖",
      "substitute": "白糖",
      "ratio": "30 克:30 克",
      "note": "颜色偏浅，可加一点酱油提色。"
    }
  ],
  "variations": [
    "加土豆块，汤汁更绵。，别急着加油，口感才不散。",
    "加更多红辣椒，辣味更足。，顺序照着来，咸淡才好把握。"
  ],
  "serving_suggestion": "配烤面包和炸香蕉。，手法轻些，食材才不糊。",
  "storage": "冷藏三天，复热用小火。，动作放连贯，颜色才够亮。",
