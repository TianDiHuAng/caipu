  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "菠萝",
          "name_en": "pineapple",
          "amount": 500,
          "unit": "g",
          "note": "去皮切块",
          "optional": false
        },
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 250,
          "unit": "ml",
          "note": "浓椰浆",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "炼乳",
          "name_en": "condensed milk",
          "amount": 60,
          "unit": "g",
          "note": "增甜增稠",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 200,
          "unit": "ml",
          "note": "调稀",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 20,
          "unit": "g",
          "note": "按甜度调整",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 100,
          "unit": "ml",
          "note": "稀释",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "料理机",
    "刀",
    "量杯",
    "高杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠萝去皮去硬芯，切成两厘米见方的块备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "菠萝硬芯纤维很粗，一定要切掉不用。",
      "visual_cue": "菠萝块大小均匀一致"
    },
    {
      "n": 2,
      "text": "一半菠萝块放进料理机，加椰浆和牛奶打成顺滑果浆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先用液体带动刀头，打出来才细。",
      "visual_cue": "果浆细腻，没有颗粒"
    },
    {
      "n": 3,
      "text": "加入炼乳、白糖和清水，再打二十秒让糖完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "炼乳本身就很甜，白糖要边尝边加。",
      "visual_cue": "甜度适中，质地顺滑"
    },
    {
      "n": 4,
      "text": "剩下的一半菠萝切成小丁，留作杯中的果肉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "留些果肉丁，喝起来口感更有层次。",
      "visual_cue": "果肉丁大小均匀一致"
    },
    {
      "n": 5,
      "text": "果浆倒进高杯，加入菠萝丁，放冰箱冷藏二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "冷藏之后风味更融合，口感也更清爽。",
      "visual_cue": "杯壁结霜，果丁浮起"
    },
    {
      "n": 6,
      "text": "喝前搅匀，喜欢冰凉可加几块冰块再端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冰块别加太多，化开会冲淡椰香。",
      "visual_cue": "表面浮冰，椰香浓郁"
    }
  ],
  "tips": [
    "菠萝硬芯纤维粗，一定要切掉不用。",
    "炼乳本身带甜，白糖要边尝边加。",
    "冷藏二十分钟再喝，味道融合也更清爽。"
  ],
  "common_mistakes": [
    "菠萝硬芯一起打，喝起来满是粗纤维。",
    "白糖加太多，甜腻盖掉了椰浆香。",
    "冰块加太多，化开以后果味被冲淡。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "200 毫升:200 毫升",
      "note": "全植物版本，椰香更浓。"
    },
    {
      "original": "炼乳",
      "substitute": "蜂蜜",
      "ratio": "60 克:50 克",
      "note": "甜味更清爽，稠度稍低。"
    }
  ],
  "variations": [
    "加一小勺青柠汁进去，酸甜更加平衡。",
    "用冷冻菠萝块打制，口感接近冰沙。"
  ],
  "serving_suggestion": "倒进高杯插一片菠萝，加冰块，是加勒比海岛度假时最常见的一杯冷饮。",
  "storage": "冷藏一天，饮用前搅匀，出现分层属正常现象。",
