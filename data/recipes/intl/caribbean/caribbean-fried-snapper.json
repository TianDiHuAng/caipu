  "steps": [
    {
      "n": 1,
      "text": "鲈鱼洗净擦干，两面各划三刀。，别急着加油，锅气才足。",
      "time_min": 8,
      "heat": "无火",
      "tip": "划刀入味，也易熟透。，别用力搅，风味才干净。",
      "visual_cue": "刀口整齐，鱼身干爽，盖盖焖一会儿，锅气才足。"
    },
    {
      "n": 2,
      "text": "用盐、黑胡椒和一半青柠汁抹遍鱼身。，锅温要匀，整道菜才立得住。",
      "time_min": 5,
      "heat": "无火",
      "tip": "里外都抹到，腥味才走。，别急着加油，香气才不跑。",
      "visual_cue": "鱼身挂汁，静置片刻，注意别烧干，吃口才舒服。"
    },
    {
      "n": 3,
      "text": "蒜、姜和红辣椒剁成细末，拌入小葱。，保持小火，成品才稳当。",
      "time_min": 6,
      "heat": "无火",
      "tip": "剁细些，煎时不易焦。，留意锅底，整道菜才立得住。",
      "visual_cue": "末体细碎，颜色鲜亮，下手别慌，细节才到位。"
    },
    {
      "n": 4,
      "text": "把香料末塞进刀口，抹在鱼腹内。，汤汁别收太干，味道才进得去。",
      "time_min": 5,
      "heat": "无火",
      "tip": "塞匀些，味才均匀。，留意锅底，成品才好看。",
      "visual_cue": "刀口填满，鱼腹有料，盖盖焖一会儿，口感才不发柴。"
    },
    {
      "n": 5,
      "text": "鱼身两面薄薄拍一层面粉。，先试试温度，咸淡才好把握。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拍薄些，煎出来才脆。，动作放连贯，表面才漂亮。",
      "visual_cue": "表面干爽，粉层均匀，下手别慌，成品才好看。"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油，中火烧到七成热。，汤汁别收太干，锅气才足。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油要够热，鱼皮才不粘。，留意锅底，香气才不跑。",
      "visual_cue": "油面微动，筷子起泡，慢慢来别急，火候才均匀。"
    },
    {
      "n": 7,
      "text": "鱼下锅，一面煎五分钟再翻面。，份量心里有数，口感才不散。",
      "time_min": 12,
      "heat": "中火",
      "tip": "别急着翻，皮破了就难看。，盖盖焖一会儿，细节才到位。",
      "visual_cue": "底面金黄，鱼皮完整，翻动放轻，火候才均匀。"
    },
    {
      "n": 8,
      "text": "两面煎好后捞出，放在厨房纸上沥油。，别用力搅，味道才不闷。",
      "time_min": 4,
      "heat": "无火",
      "tip": "沥一下油，口感才不腻。，份量心里有数，锅气才足。",
      "visual_cue": "表面干爽，油迹不多，留意锅底，食材才不糊。"
    },
    {
      "n": 9,
      "text": "挤剩余青柠汁，配炸面饼吃。，下手别慌，口感才不发柴。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸味提鲜，趁热吃最好。，锅温要匀，火候才均匀。",
      "visual_cue": "汁水渗入，香气清亮，时间掐准，锅气才足。"
    }
  ],
  "tips": [
    "鱼身擦干再拍粉，煎时皮才不破。，留意锅底，味道才不闷。",
    "油温够高再下锅，鱼皮才不粘。，下手别慌，风味才干净。",
    "别频繁翻动，一面定型再翻。，注意别烧干，口感才不发柴。"
  ],
  "common_mistakes": [
    "鱼身带水，下锅溅油粘皮。，先试试温度，形状才完整。",
    "油温太低，鱼肉吸油发散。，份量心里有数，味道才不闷。",
    "翻面太早，鱼皮粘在锅上。，火别太大，口感才不发柴。"
  ],
