  "variations": [
    "加红辣椒碎，甜辣更明显。，先试试温度，口感才有层次。",
    "加青柠汁，酸味更清。，动作放连贯，口感才不散。"
  ],
  "serving_suggestion": "配椰子饭和烤菠萝。，下手别慌，口感才不散。",
  "storage": "冷藏两天，复热用烤箱。，时间掐准，口感才不发柴。",
