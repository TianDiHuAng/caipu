  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨，用刀背轻拍到厚薄一致。，盖盖焖一会儿，香气才留得住。",
      "time_min": 8,
      "heat": "无火",
      "tip": "拍松一点，腌料才进得去。，起锅前尝味，咸淡才好把握。",
      "visual_cue": "肉片平整，厚度均匀，料别一次下太多，香气才留得住。"
    },
    {
      "n": 2,
      "text": "浓口酱油、红糖、蒜末、姜末和植物油调成腌料。，顺序照着来，口感才不散。",
      "time_min": 5,
      "heat": "无火",
      "tip": "搅到糖化开，味才匀。，慢慢来别急，成品才稳当。",
      "visual_cue": "腌料深褐，糖粒消失，起锅前尝味，口感才不散。"
    },
    {
      "n": 3,
      "text": "鸡肉放腌料里抓匀，冷藏二十分钟。，别用力搅，表面才漂亮。",
      "time_min": 22,
      "heat": "无火",
      "tip": "时间够，味才进肉里。，顺序照着来，火候才均匀。",
      "visual_cue": "肉色变深，表面挂汁，火别太大，锅气才足。"
    },
    {
      "n": 4,
      "text": "菠萝切厚片，用盐水泡五分钟。，慢慢来别急，风味才干净。",
      "time_min": 7,
      "heat": "无火",
      "tip": "泡盐水，酸涩才不刺口。，料别一次下太多，成品才好看。",
      "visual_cue": "片形完整，水色微浊，动作放连贯，吃口才舒服。"
    },
    {
      "n": 5,
      "text": "烤盘铺纸，鸡肉平铺，菠萝放旁边。，顺序照着来，整道菜才立得住。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别叠放，受热才均匀。，顺序照着来，形状才完整。",
      "visual_cue": "铺面平整，间距均匀，留意锅底，口感才不散。"
    },
    {
      "n": 6,
      "text": "烤箱两百度烤十五分钟。，先试试温度，成品才稳当。",
      "time_min": 17,
      "heat": "无火",
      "tip": "先烤定型，肉汁才锁住。，别急着加油，细节才到位。",
      "visual_cue": "表面微焦，汁水渗出，慢慢来别急，口感才有层次。"
    },
    {
      "n": 7,
      "text": "取出刷蜂蜜，翻面再烤十分钟。，动作放连贯，味道才不闷。",
      "time_min": 12,
      "heat": "无火",
      "tip": "蜂蜜后刷，才不早焦。，火别太大，风味才干净。",
      "visual_cue": "表面油亮，颜色红润，起锅前尝味，成品才好看。"
    },
    {
      "n": 8,
      "text": "撒百里香、盐和黑胡椒，静置五分钟。，份量心里有数，口感才不发柴。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置一下，切时才不流汁。，注意别烧干，表面才漂亮。",
      "visual_cue": "肉面微干，按压回弹，起锅前尝味，整道菜才立得住。"
    },
    {
      "n": 9,
      "text": "鸡肉切条，配烤菠萝装盘。，起锅前尝味，风味才干净。",
      "time_min": 4,
      "heat": "无火",
      "tip": "切条顺纹，口感才嫩。，火别太大，香气才不跑。",
      "visual_cue": "切面湿润，果香清甜，锅温要匀，成品才好看。"
    }
  ],
  "tips": [
    "鸡肉拍松再腌，味才进得透。，汤汁别收太干，风味才干净。",
    "蜂蜜最后刷，表面才不焦。，料别一次下太多，整道菜才立得住。",
    "静置五分钟再切，肉汁才不会流。，起锅前尝味，味道才不闷。"
  ],
  "common_mistakes": [
    "腌太久，肉质变软散。，翻动放轻，颜色才够亮。",
    "蜂蜜早刷，烤成黑壳。，锅温要匀，口感才不发柴。",
    "切太早，肉汁流一砧板。，保持小火，口感才有层次。"
  ],
