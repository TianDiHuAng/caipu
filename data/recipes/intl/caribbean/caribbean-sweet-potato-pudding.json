  "equipment": [
    "烤箱",
    "烤盘",
    "料理机",
    "盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红薯去皮刨成细丝，拌入红糖和盐，静置十分钟让糖渗进去。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刨细丝比切块更容易烤透，口感更绵。",
      "visual_cue": "薯丝变软，盆底出糖水"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加入椰奶和融化黄油，搅到完全混合。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油别太烫，否则会把蛋液烫成小块。",
      "visual_cue": "液体均匀，表面细泡"
    },
    {
      "n": 3,
      "text": "把蛋奶液倒进红薯丝里拌匀，加肉桂和肉豆蔻搅匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "肉桂和肉豆蔻最后加，香气才留得住。",
      "visual_cue": "薯丝均匀挂满奶液"
    },
    {
      "n": 4,
      "text": "拌好的料倒进抹油的烤盘，表面均匀撒上葡萄干。",
      "time_min": 4,
      "heat": "无火",
      "tip": "铺平并压实，烤完切块才不会散开。",
      "visual_cue": "表面平整，葡萄干散布"
    },
    {
      "n": 5,
      "text": "烤箱一百七十五度烤五十分钟，表面凝固、边缘微焦即可。",
      "time_min": 50,
      "heat": "中火",
      "tip": "用刀插入中心，拔出时不带湿糊就熟了。",
      "visual_cue": "表面焦糖色，边缘微脆"
    },
    {
      "n": 6,
      "text": "出炉放凉四十分钟再切块，凉透后口感更紧实。",
      "time_min": 40,
      "heat": "无火",
      "tip": "必须凉透再切，热的时候一切就散。",
      "visual_cue": "切面紧实，薯丝纹理清晰"
    }
  ],
  "tips": [
    "红薯刨细丝更容易烤透，成品也更绵密。",
    "鸡蛋加椰奶前先把黄油放温，避免结块。",
    "放凉再切块，热切一定散成一堆。"
  ],
  "common_mistakes": [
    "红薯切得太粗，烤完中心还是硬块。",
    "黄油太烫倒进蛋液，结出许多小块。",
    "没凉透就切，整盘布丁散成碎块。"
  ],
  "substitutions": [
    {
      "original": "红薯",
      "substitute": "南瓜",
      "ratio": "700 克:700 克",
      "note": "水分更多，需多加二十克面粉吸湿。"
    },
    {
      "original": "葡萄干",
      "substitute": "核桃碎",
      "ratio": "60 克:60 克",
      "note": "增加脆感，坚果过敏者勿用。"
    }
  ],
  "variations": [
    "表面撒一层红糖再烤，形成脆焦糖壳。",
    "加一勺朗姆酒，香气更有加勒比风味。"
  ],
  "serving_suggestion": "切块温热吃，配一球香草冰淇淋或一勺淡奶油，是加勒比家庭周日午餐的甜点。",
  "storage": "冷藏四天，复热用烤箱一百六十度十分钟，微波会出水变糊。",
