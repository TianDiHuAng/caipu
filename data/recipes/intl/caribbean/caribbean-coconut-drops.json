  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "椰蓉",
          "name_en": "desiccated coconut",
          "amount": 200,
          "unit": "g",
          "note": "细椰蓉",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 80,
          "unit": "g",
          "note": "低筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 100,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 50,
          "unit": "g",
          "note": "融化",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 50,
          "unit": "g",
          "note": "调甜",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 1,
          "unit": "piece",
          "note": "粘合",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 2,
          "unit": "g",
          "note": "提香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤盘",
    "和面盆",
    "勺子",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油放小碗隔热水化开，放温后加入蜂蜜搅匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "黄油别太烫，会把蛋液烫熟。",
      "visual_cue": "液体顺滑，颜色均匀发亮"
    },
    {
      "n": 2,
      "text": "打入鸡蛋，用手动打蛋器搅到完全乳化融合。",
      "time_min": 2,
      "heat": "无火",
      "tip": "搅到看不见油花，糊才不会分离。",
      "visual_cue": "蛋液与油脂融合，无分层"
    },
    {
      "n": 3,
      "text": "倒入牛奶、肉桂与盐，继续搅匀成顺滑液体。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香料先化在液体里，分布才均匀。",
      "visual_cue": "液体均匀，带淡淡肉桂色"
    },
    {
      "n": 4,
      "text": "加入椰蓉与面粉，用刮刀翻拌到看不见干粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌到刚好成团就停，别过度揉。",
      "visual_cue": "面糊抱团，能捏成小球"
    },
    {
      "n": 5,
      "text": "静置五分钟，让椰蓉充分吸收奶液变软定型。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置后烤出来才不干硬。",
      "visual_cue": "面糊更紧实，指压留坑"
    },
    {
      "n": 6,
      "text": "用勺子挖成小球排在烤盘上，间隔两厘米，大小尽量一致。",
      "time_min": 4,
      "heat": "无火",
      "tip": "大小一致，烤的时间才好掌握。",
      "visual_cue": "八到十个小球排列整齐"
    },
    {
      "n": 7,
      "text": "烤箱一百八十度烤十八分钟，表面金黄即可。",
      "time_min": 18,
      "heat": "中火",
      "tip": "边缘上色就好，烤久了会发干。",
      "visual_cue": "表面金黄，边缘微微焦褐"
    },
    {
      "n": 8,
      "text": "出炉放烤架上晾十分钟，完全放凉后再取下。",
      "time_min": 10,
      "heat": "无火",
      "tip": "热的时候取容易散，凉了才定型。",
      "visual_cue": "底部定型，轻松脱离烤盘"
    }
  ],
  "tips": [
    "面糊能捏成团就够，太湿烤出来会摊开。",
    "静置十分钟不能省，椰蓉吸水后才不干。",
    "烤到边缘金黄就出炉，余温还会继续上色。"
  ],
  "common_mistakes": [
    "面糊太稀，烤完全摊成一盘薄饼。",
    "烤得太久，椰蓉球干得像小石头。",
    "趁热就用手取，球一碰就散成碎渣。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "炼乳",
      "ratio": "50 克:60 克",
      "note": "奶香更浓，需减二十毫升牛奶。"
    },
    {
      "original": "椰蓉",
      "substitute": "面包糠",
      "ratio": "200 克:180 克",
      "note": "口感变脆，需多加二十毫升牛奶。"
    }
  ],
  "variations": [
    "表面压一颗杏仁，卖相更精致好看。",
    "加一撮豆蔻粉，香气更接近岛上的做法。"
  ],
  "serving_suggestion": "配一杯红茶或咖啡，当下午茶点心。",
  "storage": "密封罐常温放五天，受潮可回炉烤三分钟。",
