  "steps": [
    {
      "n": 1,
      "text": "鹰嘴豆提前泡发后煮到软而不烂，沥干备用。这一步不要着急。",
      "time_min": 15,
      "heat": "中火",
      "tip": "煮到手指一捏就碎，烤的时候才入味。",
      "visual_cue": "豆粒饱满，轻压即碎，状态稳定"
    },
    {
      "n": 2,
      "text": "洋葱切碎，胡萝卜切小丁，蒜切成细末。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丁切小一点，烤完口感才协调。，注意火候。",
      "visual_cue": "颗粒均匀，大小一致，状态稳定"
    },
    {
      "n": 3,
      "text": "炒锅倒橄榄油烧热，下洋葱碎小火炒到透明发软。",
      "time_min": 6,
      "heat": "小火",
      "tip": "洋葱炒透，甜味才撑得起整道菜。，注意火候。",
      "visual_cue": "洋葱透明，香气明显，状态稳定"
    },
    {
      "n": 4,
      "text": "加蒜末和胡萝卜丁炒三分钟，再放番茄丁炒出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄要炒到出汁，烤的时候才不会干。",
      "visual_cue": "汤汁泛红，番茄软烂，状态稳定"
    },
    {
      "n": 5,
      "text": "加番茄酱、牛至、盐和黑胡椒，倒入鹰嘴豆拌匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "轻轻翻拌，别把豆子压碎。，注意火候。",
      "visual_cue": "豆子裹汁，颜色红亮，状态稳定"
    },
    {
      "n": 6,
      "text": "倒入烤盘铺平，加半碗清水，表面淋少许橄榄油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "加水防烤干，豆子才软糯不硬。，注意火候。",
      "visual_cue": "液面齐平，表面平整，状态稳定"
    },
    {
      "n": 7,
      "text": "一百八十度烤三十五分钟，中途翻动一次防表面过干。",
      "time_min": 35,
      "heat": "-",
      "tip": "中途翻动一次，受热和上色更均匀。，注意火候。",
      "visual_cue": "表面微焦，汁水收浓，状态稳定"
    },
    {
      "n": 8,
      "text": "取出撒欧芹碎，晾五分钟后再分盘。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "晾几分钟让汁水回吸，味道更融。，注意火候。",
      "visual_cue": "香气浓郁，汁水挂豆，状态稳定"
    }
  ],
  "tips": [
    "鹰嘴豆煮到轻压即碎，烤完才入味。，值得留意。",
    "烤盘里加半碗水，豆子才不会烤干。，值得留意。",
    "中途翻动一次，上色更均匀。，值得留意。"
  ],
  "common_mistakes": [
    "豆子没泡透就烤，成品硬得咬不动。，值得留意。",
    "不加清水直接烤，表面干裂里面还硬。，值得留意。",
    "番茄没炒出汁，整盘菜发酸寡淡。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鹰嘴豆",
      "substitute": "白芸豆",
      "ratio": "600 克:600 克",
      "note": "口感更绵，煮制时间加十分钟。"
    },
    {
      "original": "番茄酱",
      "substitute": "番茄膏",
      "ratio": "60 克:40 克",
      "note": "味道更浓，需多加五十毫升水。"
    }
  ],
  "variations": [
    "加一小把菠菜同烤，颜色更绿。，值得留意。",
    "撒少许奶酪碎入炉，表面更香。，值得留意。"
  ],
  "serving_suggestion": "温热吃当主菜，配面包蘸盘底的番茄汁。，效果更稳定。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤十分钟。",
