          "optional": false
        },
        {
          "name": "黄瓜",
          "name_en": "cucumber",
          "amount": 250,
          "unit": "g",
          "note": "一百五十克切条配盘，一百克刨丝挤干做蘸酱",
          "optional": false
        },
        {
