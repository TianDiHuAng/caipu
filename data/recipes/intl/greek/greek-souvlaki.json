        }
      ]
    }
  ],
  "equipment": [
    "烤盘或铸铁锅",
    "竹签",
    "保鲜袋",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿切三厘米块，与橄榄油、柠檬汁、蒜泥、牛至、百里香、盐和黑胡椒抓匀，冷藏腌两小时。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌料里油要够，油封住肉汁，烤时才不柴。",
      "visual_cue": "每块鸡肉都裹上带草屑的油膜"
    },
    {
      "n": 2,
      "text": "竹签提前泡水二十分钟，把鸡肉与洋葱块交替串起，每串四五块肉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉块之间不要挤太紧，热气才能进到每块肉。",
      "visual_cue": "肉串饱满，块与块之间留小缝"
    },
    {
      "n": 3,
      "text": "黄瓜刨丝加少许盐静置五分钟，挤干水分后拌入酸奶、蒜泥和柠檬汁做成蘸酱。",
      "time_min": 7,
      "heat": "无火",
      "tip": "黄瓜水必须挤干，否则蘸酱会稀成汤。",
      "visual_cue": "蘸酱浓稠，能挂住勺子"
    },
    {
      "n": 4,
      "text": "铸铁锅或烤盘烧到很热，刷一层橄榄油，肉串每面煎烤三分钟至焦痕明显。",
      "time_min": 8,
      "heat": "大火",
      "tip": "锅一定要足够热，肉一放下就发出响声才对。",
      "visual_cue": "表面出现深褐色烤痕，边缘微焦"
    },
    {
      "n": 5,
      "text": "肉串静置三分钟，与番茄块、黄瓜条、洋葱圈一起装盘，配蘸酱与柠檬角。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置几分钟让肉汁回流，切开才不会流一盘水。",
      "visual_cue": "肉质切面多汁略带粉白，配菜颜色鲜亮"
    }
  ],
  "tips": [
    "腌两小时是底线，时间充裕可冷藏一夜，风味更透。",
    "没有烤架用铸铁锅同样能做出焦痕，关键是锅要烧透。",
    "牛至是希腊菜的关键香草，缺了味道就不对。"
  ],
  "common_mistakes": [
    "腌十分钟就下锅，鸡肉只有表面咸味。",
    "锅不够热就下肉，鸡肉出水变成煮鸡块。",
    "肉串挤得过密，中间那块肉始终不熟。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "猪里脊",
      "ratio": "700 克:700 克",
      "note": "猪肉版本煎烤时间相同，需全熟。"
    },
    {
      "original": "酸奶",
      "substitute": "酸奶油",
      "ratio": "150 克:130 克",
      "note": "更浓稠，可加一勺牛奶调稀。"
    }
  ],
  "variations": [
    "把肉串塞进温热的口袋饼，加番茄洋葱与薯条，就是希腊常见的卷饼吃法。"
  ],
  "serving_suggestion": "配口袋饼、番茄黄瓜沙拉与酸奶蘸酱。",
  "storage": "冷藏两天，复热用平底锅干煎或烤箱一百八十度六分钟。",
