  "equipment": [
    "大碗",
    "平底锅",
    "擦丝器",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜面包撕成小块，用少量清水泡软后挤干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡软挤干，肉丸才嫩不散。顺序别颠倒。",
      "visual_cue": "面包成团，挤掉多余水"
    },
    {
      "n": 2,
      "text": "洋葱用擦丝器擦成细茸，挤掉一半汁水备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "汁水太多少，肉料会稀得捏不住。",
      "visual_cue": "洋葱茸湿润，挤出小半碗汁"
    },
    {
      "n": 3,
      "text": "大碗放牛肉绞肉，加面包、洋葱茸与鸡蛋拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "顺着一个方向搅，肉料才上劲。火候要盯住。",
      "visual_cue": "肉料黏稠成团，不散不稀"
    },
    {
      "n": 4,
      "text": "加蒜末、牛至、盐与黑胡椒，继续搅到均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香草用手搓碎再放，香气才放得出。",
      "visual_cue": "香草分布均匀，肉料发亮"
    },
    {
      "n": 5,
      "text": "把肉料反复摔打十几下，排出空气后冷藏二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "摔打上劲，煎的时候才不散。多练两次就熟。",
      "visual_cue": "肉料紧实，按下去有弹性"
    },
    {
      "n": 6,
      "text": "手上蘸水，把肉料搓成乒乓球大小的圆球。随时观察锅里的状态。",
      "time_min": 8,
      "heat": "无火",
      "tip": "大小一致，煎的时候才一起熟。细节决定成败。",
      "visual_cue": "肉丸圆整光滑，约二十个"
    },
    {
      "n": 7,
      "text": "平底锅中火倒橄榄油，油热后下肉丸排成一层。",
      "time_min": 4,
      "heat": "中火",
      "tip": "别挤太密，留出翻动的空间。这一步别省。",
      "visual_cue": "油面微动，肉丸底部贴锅"
    },
    {
      "n": 8,
      "text": "中火煎六分钟，中途翻面让四面都变金黄。翻动要轻别弄碎。",
      "time_min": 7,
      "heat": "中火",
      "tip": "轻推不硬铲，肉丸才不破。顺序别颠倒。",
      "visual_cue": "四面金黄，锅里滋滋作响"
    },
    {
      "n": 9,
      "text": "转小火盖盖焖五分钟，让中心彻底熟透。手上别停以免粘锅。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盖盖焖一下，中心才不生。火候要盯住。",
      "visual_cue": "肉丸鼓起，按压有弹性"
    },
    {
      "n": 10,
      "text": "出锅放厨房纸上吸油，配柠檬角和酸奶酱上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先吸油再装盘，入口不腻。多练两次就熟。",
      "visual_cue": "表面干爽，盘底无积油"
    }
  ],
  "tips": [
    "面包泡软挤干再拌馅，肉丸才嫩不散。",
    "肉料顺一个方向搅上劲，煎的时候才不成渣。",
    "煎完盖盖小火焖五分钟，中心才熟透。",
    "手上蘸水搓丸子，肉料才不会粘手。"
  ],
  "common_mistakes": [
    "洋葱汁水全倒进去，肉料稀得捏不住。",
    "油温太低就下锅，肉丸散开成一锅牛肉碎。",
    "火太大外面焦了，里面还带粉色。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "500 克:500 克",
      "note": "膻香更重，可多加牛至。"
    },
    {
      "original": "面包",
      "substitute": "面粉",
      "ratio": "60 克:30 克",
      "note": "更紧实，需多加两勺清水。"
    }
  ],
  "variations": [
    "加一小勺薄荷碎，清爽解腻。细节决定成败。",
    "肉丸压扁成小饼，煎得更快更脆。"
  ],
  "serving_suggestion": "装盘后挤上柠檬汁，配酸奶黄瓜酱和皮塔饼，就是希腊小酒馆的经典拼盘。",
  "storage": "冷藏两天，冷冻一个月，复热用烤箱一百八十度烤八分钟。",
