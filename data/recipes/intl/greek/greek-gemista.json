  "steps": [
    {
      "n": 1,
      "text": "甜椒切去顶部，掏净籽和白膜。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "白膜去净，才不苦。，火候要稳，别忽大忽小。",
      "visual_cue": "内壁光滑，椒形完整"
    },
    {
      "n": 2,
      "text": "锅倒橄榄油，炒洋葱丁到透明。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒软，馅才甜。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱软塌，香气散出"
    },
    {
      "n": 3,
      "text": "加牛肉末炒散，炒到变色出油。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉末炒散，不要结块。，火候要稳，别忽大忽小。",
      "visual_cue": "肉末松散，颜色变深"
    },
    {
      "n": 4,
      "text": "倒大米炒两分钟，让米粒裹上油。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "米先炒过，煮后不夹生。，火候要稳，别忽大忽小。",
      "visual_cue": "米粒油亮，颗颗分开"
    },
    {
      "n": 5,
      "text": "加番茄丁、蒜末、薄荷和莳萝拌匀。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香草最后放，香气才留。，火候要稳，别忽大忽小。",
      "visual_cue": "馅料湿润，香气清亮"
    },
    {
      "n": 6,
      "text": "加盐和黑胡椒调味，尝一次咸淡。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "馅要偏咸，烤后米会吸味。，火候要稳，别忽大忽小。",
      "visual_cue": "咸淡合适，香气足，这一点很关键。"
    },
    {
      "n": 7,
      "text": "把馅填进甜椒，装七分满。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "无火",
      "tip": "只填七分，米胀才不溢。，火候要稳，别忽大忽小。",
      "visual_cue": "椒内留空，馅面平整"
    },
    {
      "n": 8,
      "text": "盖回椒盖，烤盘倒清水和番茄泥。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盘底加水，才不会烤干。，火候要稳，别忽大忽小。",
      "visual_cue": "汁水到椒身三分之一"
    },
    {
      "n": 9,
      "text": "盖锡纸一百八十度烤四十分钟。，火候要稳，别忽大忽小。",
      "time_min": 42,
      "heat": "无火",
      "tip": "盖上锡纸，米才焖得透。，火候要稳，别忽大忽小。",
      "visual_cue": "锡纸鼓起，椒身变软"
    },
    {
      "n": 10,
      "text": "揭锡纸再烤十五分钟收汁上色。，火候要稳，别忽大忽小。",
      "time_min": 18,
      "heat": "无火",
      "tip": "揭纸收汁，表面才微焦。，火候要稳，别忽大忽小。",
      "visual_cue": "表面微皱，汁水浓稠"
    }
  ],
  "tips": [
    "馅只填七分满，米胀才不溢。，这一点很关键。",
    "盘底加水，甜椒才不会烤干。，这一点很关键。",
    "先盖锡纸再揭，米才熟透。，这一点很关键。"
  ],
  "common_mistakes": [
    "馅填太满，烤时米溢出来。，这一点很关键。",
    "盘底没水，椒底烤糊。，这一点很关键。",
    "全程不盖锡纸，米粒夹生。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "红腰豆",
      "ratio": "200 克:200 克",
      "note": "素版，需多加橄榄油十毫升。"
    },
    {
      "original": "大米",
      "substitute": "糙米",
      "ratio": "250 克:250 克",
      "note": "需提前泡三十分钟，水加一百毫升。"
    }
  ],
  "variations": [
    "用西葫芦或番茄代替甜椒。，这一点很关键。",
    "加葡萄干和松子，甜咸更丰富。，这一点很关键。"
  ],
  "serving_suggestion": "配酸奶和硬面包，趁热吃。，这一点很关键。",
  "storage": "冷藏三天，复烤十分钟。，这一点很关键。",
