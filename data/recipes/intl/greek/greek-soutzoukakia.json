  "steps": [
    {
      "n": 1,
      "text": "牛肉末加洋葱碎、蒜泥、牛至和盐。，看住火，别让它失控。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱擦碎，肉丸才不柴。，全程留意火候，别贪快。",
      "visual_cue": "混合均匀，香气明显"
    },
    {
      "n": 2,
      "text": "加面包糠和鸡蛋，顺一个方向搅上劲。，火大了就离锅远一点。",
      "time_min": 5,
      "heat": "无火",
      "tip": "顺向搅打，肉丸才弹。，火别开太大，稳着来。",
      "visual_cue": "肉泥发黏，能成团，这里最容易翻车。"
    },
    {
      "n": 3,
      "text": "搓成椭圆小条，冷藏十五分钟定型。，锅温要匀，别忽高忽低。",
      "time_min": 17,
      "heat": "无火",
      "tip": "冷藏定型，煎时不散。，火力保持中等，慢慢来。",
      "visual_cue": "形状整齐，表面紧实"
    },
    {
      "n": 4,
      "text": "平底锅倒橄榄油，肉条分批煎上色。，火候宁小勿大，慢慢推进。",
      "time_min": 8,
      "heat": "中火",
      "tip": "表面煎定型就够了，里面靠炖。，注意锅里温度别掉下来。",
      "visual_cue": "表层焦褐，形状完整"
    },
    {
      "n": 5,
      "text": "余油炒番茄泥，倒红酒煮开。，始终中小火，别心急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒过，酸味才柔。，火要均匀，食材才不糊。",
      "visual_cue": "汤色红亮，酒气散去"
    },
    {
      "n": 6,
      "text": "放回肉条，小火炖二十分钟。，看住火，别让它失控。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火炖，肉丸才吸汁。，全程留意火候，别贪快。",
      "visual_cue": "汤汁浓稠，肉条鼓起"
    },
    {
      "n": 7,
      "text": "加盐和黑胡椒调味，撒牛至。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "小火",
      "tip": "最后调味，咸淡才准。，火别开太大，稳着来。",
      "visual_cue": "味道醇厚，香气十足"
    },
    {
      "n": 8,
      "text": "关火静置五分钟再盛盘。，锅温要匀，别忽高忽低。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置一下，汁才挂得住。，火力保持中等，慢慢来。",
      "visual_cue": "酱汁浓稠，肉丸油亮"
    }
  ],
  "tips": [
    "肉泥顺向搅上劲，丸子才弹。，别小看这一步。",
    "先煎定型再炖，才不会散。，成败就在这一步。",
    "番茄炒过再炖，酸味更柔。，这点要注意。"
  ],
  "common_mistakes": [
    "肉丸没定型就下锅，一煎就散。，这是关键点。",
    "火太大，番茄糊底。，别嫌麻烦，做完它。",
    "肉丸搓太大，里面不入味。，这一步别省。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "鸡胸肉泥",
      "ratio": "600 克:600 克",
      "note": "更清爽，需多加橄榄油十毫升。"
    },
    {
      "original": "红酒",
      "substitute": "清水加柠檬汁",
      "ratio": "80 毫升:70 毫升兑10毫升",
      "note": "少了酒香，可加牛至一克。"
    }
  ],
  "variations": [
    "配米饭或薯泥，汁水更下饭。，别跳过这步。",
    "加一点辣椒粉，风味更冲。，这步最关键。"
  ],
  "serving_suggestion": "配米饭、薯泥或硬面包，撒牛至。，很多人在这里出错。",
  "storage": "冷藏三天，复热更入味。，这里最容易翻车。",
