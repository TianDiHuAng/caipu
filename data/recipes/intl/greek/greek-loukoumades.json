    "total_min": 135
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 240,
          "unit": "ml",
          "note": "温水",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 7,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 30,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 90,
          "unit": "g",
          "note": "淋面",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 260,
          "unit": "ml",
          "note": "炸制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "深锅",
    "漏勺",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水加白糖与酵母搅匀，静置十分钟等到表面起泡。",
      "time_min": 12,
      "heat": "无火",
      "tip": "酵母先活化，面团才发得起来。别怕麻烦。",
      "visual_cue": "水面浮起一层细密泡沫"
    },
    {
      "n": 2,
      "text": "加入面粉与盐，用木勺搅成很黏的软面团。先看状态再动手。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面团要软到粘勺，炸出来才蓬松。",
      "visual_cue": "面糊黏稠挂勺，搅动有阻力"
    },
    {
      "n": 3,
      "text": "盖湿布放温暖处发酵一小时，直到体积翻倍。",
      "time_min": 62,
      "heat": "无火",
      "tip": "发到两倍大，内部才有蜂窝。这一步别省。",
      "visual_cue": "面团鼓起，表面布满小气泡"
    },
    {
      "n": 4,
      "text": "发酵好的面团用勺子搅几下排气，重新变得顺滑。",
      "time_min": 3,
      "heat": "无火",
      "tip": "搅几下就好，别把气泡全搅散。顺序别颠倒。",
      "visual_cue": "面团回落，表面重新平整"
    },
    {
      "n": 5,
      "text": "深锅倒入植物油，中火烧到一百七十度。过程中注意火候变化。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温别过一百八，外面焦里面生。",
      "visual_cue": "油面微动，温度计指着一百七"
    },
    {
      "n": 6,
      "text": "手上蘸水，挤出一小团面糊用勺子刮进油锅。",
      "time_min": 6,
      "heat": "中火",
      "tip": "手蘸水才不粘，团子大小才匀。火候要盯住。",
      "visual_cue": "团子入锅立刻浮起，边缘冒泡"
    },
    {
      "n": 7,
      "text": "一次炸八到十个，中火炸三分钟至金黄鼓起。",
      "time_min": 4,
      "heat": "中火",
      "tip": "别一次下太多，油温掉了就吸油。",
      "visual_cue": "团子金黄鼓起，浮在油面打转"
    },
    {
      "n": 8,
      "text": "用漏勺翻面再炸一分钟，捞出沥油。动作要快别拖延。",
      "time_min": 2,
      "heat": "中火",
      "tip": "翻面炸，颜色才均匀不偏。多练两次就熟。",
      "visual_cue": "两面金黄一致，油滴回落"
    },
    {
      "n": 9,
      "text": "趁热淋上蜂蜜，撒少许白糖或坚果碎即可。随时观察锅里的状态。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热淋蜜，甜味才渗进去。细节决定成败。",
      "visual_cue": "蜜汁光亮，团子油润"
    }
  ],
  "tips": [
    "面团要软到粘勺，硬面团炸不出空心。",
    "油温保持一百七十度，团子才外层酥内里软。",
    "趁热淋蜂蜜，甜味才吃得进去。别怕麻烦。"
  ],
  "common_mistakes": [
    "面团发得不够，炸出来像死面疙瘩。",
    "油温太低，团子吸满油又塌又腻。",
    "一次下太多团子，油温骤降全黏在一起。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "90 克:80 克",
      "note": "少了花香，甜味更直接。"
    },
    {
      "original": "清水",
      "substitute": "牛奶",
      "ratio": "240 毫升:250 毫升",
      "note": "奶香更浓，发酵稍慢。"
    }
  ],
  "variations": [
    "淋蜂蜜后撒肉桂粉，香气更暖。这一步别省。",
    "表面撒碎核桃，口感更丰富。顺序别颠倒。"
  ],
  "serving_suggestion": "装纸碟趁热吃，淋足蜂蜜再撒一点肉桂粉，配一杯希腊咖啡最地道。",
  "storage": "现炸现吃最好，凉后复热用烤箱一百八十度烤四分钟。",
  "nutrition_estimate": {
    "basis": "每份约 170 克",
