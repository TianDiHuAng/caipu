  "equipment": [
    "烤盘",
    "刷子",
    "平底锅",
    "大碗",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜洗净后用沸水烫三十秒，捞出过冷水并彻底挤干。",
      "time_min": 10,
      "heat": "中火",
      "tip": "菠菜水分一定要挤干，否则派底会湿软。",
      "visual_cue": "菠菜成团，挤出的水清"
    },
    {
      "n": 2,
      "text": "面粉加温水与一半融化的黄油揉成软面团，盖布醒二十分钟。",
      "time_min": 25,
      "heat": "无火",
      "tip": "面团要软而光滑，擀开才不易破。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 3,
      "text": "锅里下橄榄油炒香洋葱末至透明，盛出稍凉。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到甜味出来，不要炒到焦黄。",
      "visual_cue": "洋葱透明软塌，香气甜润"
    },
    {
      "n": 4,
      "text": "菠菜切碎，与奶酪、鸡蛋、洋葱、莳萝、肉豆蔻、盐和黑胡椒拌匀。",
      "time_min": 7,
      "heat": "无火",
      "tip": "奶酪本身带咸，盐要少放，先尝再调。",
      "visual_cue": "馅料稠密，能抱团不流散"
    },
    {
      "n": 5,
      "text": "面团分成八份，每份擀成薄片，刷上剩余融化黄油。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面片越薄越好，四张叠一层才够酥。",
      "visual_cue": "面片透光，均匀刷油"
    },
    {
      "n": 6,
      "text": "烤盘铺两张面片，边缘留出多余部分，倒入全部馅料铺平。",
      "time_min": 6,
      "heat": "无火",
      "tip": "馅料铺平压实，切块时才不会散。",
      "visual_cue": "馅料平整，厚薄一致"
    },
    {
      "n": 7,
      "text": "盖上剩余面片，边缘向内折压封口，表面刷黄油并划几道口。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面划口是排气通道，不划会鼓成大包。",
      "visual_cue": "表面油亮，划口整齐"
    },
    {
      "n": 8,
      "text": "一百八十度烤四十分钟至表面深金黄、敲击有脆响。",
      "time_min": 40,
      "heat": "无火",
      "tip": "烤到深金黄才够酥，浅色说明火候不足。",
      "visual_cue": "表面金黄起层，边缘焦脆"
    },
    {
      "n": 9,
      "text": "出炉静置十五分钟再切块，温热时食用最佳。",
      "time_min": 15,
      "heat": "无火",
      "tip": "静置让馅料定型，热切会流一盘子。",
      "visual_cue": "切块成型，层次分明"
    }
  ],
  "tips": [
    "菠菜挤水是成败关键，湿了整盘都软塌。",
    "每层面片都要刷黄油，才会烤出酥层。",
    "用现成酥皮可省一半时间，风味稍逊。"
  ],
  "common_mistakes": [
    "菠菜没挤干，烤完盘底一汪绿水。",
    "面片擀太厚，外层熟了里面还是生面团。",
    "出炉立刻切块，馅料全流出来散成一堆。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "马苏里拉",
      "ratio": "250 克:250 克",
      "note": "咸味弱，需补盐三克，拉丝感更强。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "120 克:100 毫升",
      "note": "更清爽，酥层略硬。"
    }
  ],
  "variations": [
    "加一把松子或葡萄干，是希腊北部的做法。",
    "做成小三角酥，适合当派对手指食物。"
  ],
  "serving_suggestion": "切块温热吃，配一碗希腊酸奶或番茄沙拉。",
  "storage": "冷藏三天、冷冻两个月；复烤一百八十度十分钟恢复酥脆，微波会让酥皮变韧。",
