  "equipment": [
    "烤箱",
    "锅",
    "打蛋器",
    "烤盘",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶加一半白糖，小火加热到微沸。，火大了就离锅远一点。",
      "time_min": 7,
      "heat": "小火",
      "tip": "牛奶别煮开，会起膜。，火别开太大，稳着来。",
      "visual_cue": "边缘冒泡，糖化开，别小看这一步。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加剩余白糖和盐拌匀。，锅温要匀，别忽高忽低。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液打匀，奶馅才顺。，火力保持中等，慢慢来。",
      "visual_cue": "蛋液均匀，颜色发浅"
    },
    {
      "n": 3,
      "text": "面粉筛入蛋液，搅成无颗粒糊。，火候宁小勿大，慢慢推进。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉要筛过，糊才细。，注意锅里温度别掉下来。",
      "visual_cue": "糊体顺滑，无干粉，成败就在这一步。"
    },
    {
      "n": 4,
      "text": "热牛奶慢慢冲入蛋糊，边倒边搅。，始终中小火，别心急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "慢慢冲，蛋才不会结块。，火要均匀，食材才不糊。",
      "visual_cue": "液体顺滑，微微冒气"
    },
    {
      "n": 5,
      "text": "倒回锅中小火煮到浓稠挂勺。，看住火，别让它失控。",
      "time_min": 9,
      "heat": "小火",
      "tip": "不停搅，防糊底。，全程留意火候，别贪快。",
      "visual_cue": "划痕清晰，稠度如膏"
    },
    {
      "n": 6,
      "text": "加柠檬皮屑拌匀，放凉备用。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮屑别带白，否则发苦。，火别开太大，稳着来。",
      "visual_cue": "香气清亮，糊体细腻"
    },
    {
      "n": 7,
      "text": "烤盘刷黄油，铺六张面皮，每张刷油。，锅温要匀，别忽高忽低。",
      "time_min": 10,
      "heat": "无火",
      "tip": "每层都刷油，酥皮才分层。，火力保持中等，慢慢来。",
      "visual_cue": "面皮平整，油光均匀"
    },
    {
      "n": 8,
      "text": "倒奶馅铺平，再盖六张刷油的面皮。，火候宁小勿大，慢慢推进。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边缘折进来，馅才不会漏。，注意锅里温度别掉下来。",
      "visual_cue": "馅面平整，边缘封住"
    },
    {
      "n": 9,
      "text": "表面刷黄油，划几刀透气。，始终中小火，别心急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "划口排气，烤时不鼓包。，火要均匀，食材才不糊。",
      "visual_cue": "表面油亮，切口整齐"
    },
    {
      "n": 10,
      "text": "一百八十度烤四十五分钟到金黄。，看住火，别让它失控。",
      "time_min": 47,
      "heat": "无火",
      "tip": "烤到深金黄，酥皮才脆。，全程留意火候，别贪快。",
      "visual_cue": "表面金黄，边缘起酥"
    },
    {
      "n": 11,
      "text": "蜂蜜加水和柠檬汁煮开，趁热淋上。，火大了就离锅远一点。",
      "time_min": 6,
      "heat": "小火",
      "tip": "趁热淋糖浆，才吸得进去。，火别开太大，稳着来。",
      "visual_cue": "糖浆渗入，表面发亮"
    },
    {
      "n": 12,
      "text": "放凉四小时，切块食用。，锅温要匀，别忽高忽低。",
      "time_min": 242,
      "heat": "无火",
      "tip": "放凉定型，切时才不塌。，火力保持中等，慢慢来。",
      "visual_cue": "切面平整，层次分明"
    }
  ],
  "tips": [
    "奶馅要煮到挂勺，切时才不流。，这点要注意。",
    "每层面皮都要刷黄油。，这是关键点。",
    "糖浆趁热淋，香气才进去。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "奶馅太稀，切开流一盘。，这一步别省。",
    "面皮没刷油，烤后不分层。，别跳过这步。",
    "糖浆冷了再淋，吸不进去。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "白糖糖浆",
      "ratio": "120 克:150 克",
      "note": "少了花香，可加柠檬皮增香。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油兑水",
      "ratio": "1000 毫升:400毫升兑600毫升",
      "note": "质地更厚，奶香更浓。"
    }
  ],
  "variations": [
    "奶馅加一点香草，香气更柔。，很多人在这里出错。",
    "表面撒开心果碎，口感更丰富。，这里最容易翻车。"
  ],
  "serving_suggestion": "放凉切块，配一杯浓咖啡。，别小看这一步。",
  "storage": "冷藏三天，回温再吃。，成败就在这一步。",
