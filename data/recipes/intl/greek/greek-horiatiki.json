    "小碗",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄去蒂切成四瓣，黄瓜刮去部分表皮后切成一厘米的厚片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄瓜留一点皮，口感才脆也更好看。，注意火候。",
      "visual_cue": "番茄成瓣，瓜片厚匀，状态稳定"
    },
    {
      "n": 2,
      "text": "洋葱切成细圈，用冰水泡五分钟去掉辛辣味后沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冰水泡过，洋葱只剩甜和脆。，注意火候。",
      "visual_cue": "洋葱圈透亮，水已沥干"
    },
    {
      "n": 3,
      "text": "黑橄榄对半切开，与番茄、黄瓜和洋葱圈一起放进大碗。",
      "time_min": 4,
      "heat": "无火",
      "tip": "轻轻翻拌，番茄才不会被压出水。，注意火候。",
      "visual_cue": "碗中色彩分明，状态稳定"
    },
    {
      "n": 4,
      "text": "奶酪切成半厘米厚的长片，铺在蔬菜上面。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪厚一点，吃起来才有存在感。，注意火候。",
      "visual_cue": "奶酪成片，边缘完整，状态稳定"
    },
    {
      "n": 5,
      "text": "淋上橄榄油，撒盐、黑胡椒和干牛至碎。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "牛至用手搓碎再撒，香气才出得来。，注意火候。",
      "visual_cue": "油光亮泽，香料均匀，状态稳定"
    },
    {
      "n": 6,
      "text": "静置五分钟让味道融合，端上桌时不要搅拌。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "这道沙拉讲究现拌现吃，拌过头就出水。",
      "visual_cue": "汁水微积，颜色鲜亮，状态稳定"
    }
  ],
  "tips": [
    "洋葱用冰水泡过，只剩下甜和脆。，值得留意。",
    "奶酪切厚片，上桌后要能看见形状。，值得留意。",
    "现拌现吃，拌过头蔬菜就出水分。，值得留意。"
  ],
  "common_mistakes": [
    "番茄切得太碎，拌完出一碗汤。，值得留意。",
    "橄榄油淋太多，蔬菜全泡在油里。，值得留意。",
    "提前拌好放置，黄瓜软塌没口感。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "170 克:170 克",
      "note": "质地更软，咸味稍淡。"
    },
    {
      "original": "黑橄榄",
      "substitute": "青橄榄",
      "ratio": "60 克:60 克",
      "note": "酸味更清，可以多加十克。"
    }
  ],
  "variations": [
    "加几片青椒，颜色和清香味都更足。，值得留意。",
    "撒少许酸豆，酸味更有层次。，值得留意。"
  ],
  "serving_suggestion": "作为主菜的配盘或单独当前菜，配烤面包蘸剩下的油汁。",
  "storage": "不建议存放，现做现吃口感最好。，效果更稳定。",
