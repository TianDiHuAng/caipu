          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 320,
          "unit": "ml",
          "note": "和面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "大碗",
    "烤盘",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温清水化开白糖和酵母，静置十分钟到表面浮起一层泡沫。",
      "time_min": 12,
      "heat": "无火",
      "tip": "酵母水起泡说明活性好，没泡就要换。",
      "visual_cue": "水面浮起细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉加盐拌匀，倒入酵母水和橄榄油揉成偏硬的面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团偏硬一点，烤出来才有嚼劲。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 3,
      "text": "盖布室温发酵六十分钟，体积涨到原来的一倍半。",
      "time_min": 62,
      "heat": "无火",
      "tip": "发到一倍半就够，发过头会有酸味。",
      "visual_cue": "体积膨胀，戳洞不回缩"
    },
    {
      "n": 4,
      "text": "面团排气后分成六份，搓成长条再圈成圆环捏紧接口。",
      "time_min": 15,
      "heat": "无火",
      "tip": "接口一定要捏紧，否则烤时会散开。",
      "visual_cue": "圆环粗细均匀，接口收紧"
    },
    {
      "n": 5,
      "text": "蜂蜜兑少量温水刷在圆环表面，再滚一圈芝麻裹匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刷糖水芝麻才粘得牢，烤后也上色。",
      "visual_cue": "表面裹满一层白芝麻"
    },
    {
      "n": 6,
      "text": "烤箱预热两百度，圆环醒十分钟后进炉烤十八分钟。",
      "time_min": 30,
      "heat": "中大火",
      "tip": "烤到深金黄才够脆，颜色浅了会发软。",
      "visual_cue": "表面深金黄，芝麻微焦"
    },
    {
      "n": 7,
      "text": "出炉后移到网架放凉，彻底凉透再装袋保存。",
      "time_min": 20,
      "heat": "无火",
      "tip": "放凉再装袋，水汽闷住外皮就不脆了。",
      "visual_cue": "外皮酥脆，敲起来有响声"
    }
  ],
  "tips": [
    "酵母水必须先起泡，发酵才可靠。",
    "面团偏硬一点，烤出来才有嚼劲。",
    "表面刷蜂蜜水，芝麻才裹得住并上色。"
  ],
  "common_mistakes": [
    "酵母水没起泡就直接和面，面团发不起来。",
    "面团揉得太软，圈烤出来塌成一张扁饼。",
    "烤完趁热装袋，外皮被水汽闷软。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "20 克:20 克",
      "note": "需用温水化开再刷。"
    },
    {
      "original": "芝麻",
      "substitute": "罂粟籽",
      "ratio": "100 克:80 克",
      "note": "香气不同，用量略减。"
    }
  ],
  "variations": [
    "面团里加一小勺肉桂粉，香气更暖。",
    "表面只撒半面芝麻，露出白面团更好看。"
  ],
  "serving_suggestion": "配一杯希腊咖啡，是雅典街头早上最常见的早餐圆环。",
  "storage": "常温密封两天，冷冻一个月；复热用烤箱一百八十度烤五分钟恢复酥脆。",
