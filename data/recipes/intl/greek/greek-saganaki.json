  "equipment": [
    "平底锅",
    "锅铲",
    "刀",
    "砧板",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶酪切成一点五厘米厚的方片，用厨房纸吸掉表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "奶酪越干越好裹粉，煎时也不易爆浆。",
      "visual_cue": "奶酪成片，表面干爽，状态稳定"
    },
    {
      "n": 2,
      "text": "每片奶酪两面都均匀拍上一层面粉，抖掉多余粉末。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄薄一层就够，粉厚了会发硬。，注意火候。",
      "visual_cue": "表面均匀泛白，状态稳定"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油烧到微微冒烟，转中小火放入奶酪片。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "油温够高才立刻封住表面，防漏浆。，注意火候。",
      "visual_cue": "油面起细纹，状态稳定"
    },
    {
      "n": 4,
      "text": "煎九十秒到底面金黄结壳，用铲子轻轻翻面。这一步不要着急。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "只翻一次，翻多了奶酪会散。，注意火候。",
      "visual_cue": "底面金黄，形状完整，状态稳定"
    },
    {
      "n": 5,
      "text": "另一面再煎九十秒，边缘微微融化即可盛出。这一步不要着急。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "看到边缘流出一点就关火，余温还会化。",
      "visual_cue": "两面金黄，边缘微融，状态稳定"
    },
    {
      "n": 6,
      "text": "撒黑胡椒和干牛至碎，配柠檬角挤汁趁热吃。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "挤上柠檬汁解腻，咸香更突出。，注意火候。",
      "visual_cue": "油亮焦香，柠檬清香，状态稳定"
    }
  ],
  "tips": [
    "奶酪切厚片，煎的时候才不塌不漏。，值得留意。",
    "锅要够热再下锅，表面立刻结壳。，值得留意。",
    "只翻一次面，翻多了奶酪就散。，值得留意。"
  ],
  "common_mistakes": [
    "奶酪切太薄，下锅就化成一摊。，值得留意。",
    "火太小慢慢煎，奶酪全漏到锅里。，值得留意。",
    "裹粉太厚，吃起来一层硬壳。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "哈鲁米奶酪",
      "ratio": "420 克:420 克",
      "note": "不易融化，更好操作。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "60 克:60 克",
      "note": "酸味更冲，用量可减十克。"
    }
  ],
  "variations": [
    "出锅前淋一小勺蜂蜜，咸甜对比很强。，值得留意。",
    "撒少许红椒粉，颜色更漂亮。，值得留意。"
  ],
  "serving_suggestion": "趁热配面包和一杯白葡萄酒，也可以作为前菜拼盘的一项。",
  "storage": "现做现吃，冷藏后复热会出油。，效果更稳定。",
