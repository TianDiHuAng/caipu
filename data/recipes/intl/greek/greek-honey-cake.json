          "name_en": "lemon",
          "amount": 1,
          "unit": "piece",
          "note": "取皮屑",
          "optional": false
        },
        {
          "name": "核桃",
          "name_en": "walnut",
          "amount": 40,
          "unit": "g",
          "note": "切碎撒面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "打蛋盆",
    "烤模",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "烤箱预热到一百七十度，烤模内壁刷一层黄油防粘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "模具刷匀，脱模才不粘。",
      "visual_cue": "模具内壁油光均匀"
    },
    {
      "n": 2,
      "text": "黄油放在小锅里隔水融化，放凉到不烫手后备用。",
      "time_min": 5,
      "heat": "小火",
      "tip": "黄油太烫会烫熟蛋液。",
      "visual_cue": "黄油化成液体，温热"
    },
    {
      "n": 3,
      "text": "鸡蛋加白糖与盐，用打蛋器打发到颜色发白体积变大。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到画纹路能停留三秒。",
      "visual_cue": "蛋糊发白，体积膨胀"
    },
    {
      "n": 4,
      "text": "分三次筛入面粉与桂皮粉，用刮刀翻拌到无干粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "翻拌别画圈，避免消泡。",
      "visual_cue": "面糊细腻，无干粉块"
    },
    {
      "n": 5,
      "text": "倒入融化黄油与柠檬皮屑，用刮刀快速翻拌均匀成顺滑面糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "黄油分两次加，更容易拌匀。",
      "visual_cue": "面糊顺滑，带柠檬香"
    },
    {
      "n": 6,
      "text": "面糊倒进烤模，在桌上轻震两下震出大气泡。",
      "time_min": 2,
      "heat": "无火",
      "tip": "震出气泡，切面才细腻。",
      "visual_cue": "表面平整，气泡上浮"
    },
    {
      "n": 7,
      "text": "放进烤箱中下层烤三十五分钟，到表面金黄竹签干爽。",
      "time_min": 35,
      "heat": "中火",
      "tip": "中途不要开炉门，温度会掉。",
      "visual_cue": "表面金黄，竹签插入无湿糊"
    },
    {
      "n": 8,
      "text": "出炉放凉五分钟，用竹签在表面扎十几处小孔。",
      "time_min": 5,
      "heat": "无火",
      "tip": "扎孔让蜂蜜渗进去，成品更润。",
      "visual_cue": "表面扎出密集小孔"
    },
    {
      "n": 9,
      "text": "蜂蜜用小锅加热到流动状，再均匀淋在温热的蛋糕表面上。",
      "time_min": 3,
      "heat": "小火",
      "tip": "趁蛋糕温热淋，蜂蜜才吸得进去。",
      "visual_cue": "表面挂上一层亮蜜"
    },
    {
      "n": 10,
      "text": "撒上核桃碎，等完全放凉后再脱模切成小块。",
      "time_min": 20,
      "heat": "无火",
      "tip": "放凉再切，切面才整齐。",
      "visual_cue": "蛋糕回弹，切面平整"
    }
  ],
  "tips": [
    "蛋糊要充分打发，烤出来的蛋糕才蓬松。",
    "拌面粉时用翻拌手法，画圈搅拌容易消泡。",
    "蜂蜜趁蛋糕温热淋，才渗得进孔隙。"
  ],
  "common_mistakes": [
    "黄油太烫就倒进蛋糊，蛋液被烫出颗粒。",
    "翻拌过度，蛋糕烤好后又硬又扁。",
    "蛋糕没放凉就切，一切开就全部散掉。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "糖浆",
      "ratio": "140 克:140 克",
      "note": "香气略淡，可加少量柠檬汁。"
    },
    {
      "original": "核桃",
      "substitute": "杏仁",
      "ratio": "40 克:40 克",
      "note": "口感更脆，苦味更轻。"
    }
  ],
  "variations": [
    "面糊里加一勺橙皮屑，香气更清爽。",
    "淋面蜂蜜里加少许柠檬汁，甜中带酸。"
  ],
  "serving_suggestion": "切块配希腊酸奶或咖啡，当下午茶点。",
  "storage": "密封室温两天、冷藏四天，回温后食用。",
