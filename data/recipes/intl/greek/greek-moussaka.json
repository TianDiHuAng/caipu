  "equipment": [
    "烤箱",
    "烤盘",
    "平底锅",
    "汤锅",
    "打蛋器",
    "厨师刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子切一厘米厚片，平铺撒少量盐静置十分钟逼出水分，用厨房纸按干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逼水能让茄子少吸油，成菜不会油汪汪地渗汤。",
      "visual_cue": "茄片表面渗出细密水珠，按干后颜色发暗"
    },
    {
      "n": 2,
      "text": "土豆切薄片下锅煮五分钟捞出，橄榄油烧热把茄子片两面煎至软塌盛出。",
      "time_min": 12,
      "heat": "中火",
      "tip": "土豆先煮半熟再铺层，烘烤时才不会夹生发硬。",
      "visual_cue": "土豆片边缘半透明，茄子片软塌出油光"
    },
    {
      "n": 3,
      "text": "锅中留底油炒洋葱碎到透明，下牛肉末炒散出香，加番茄块炒到出沙。",
      "time_min": 10,
      "heat": "中火",
      "tip": "牛肉末要炒到颗粒分明不结团，肉汁收干才香。",
      "visual_cue": "肉末呈松散褐色小粒，番茄化成红汁"
    },
    {
      "n": 4,
      "text": "加盐和黑胡椒调味，小火焖十分钟收成浓稠肉酱，离火放一旁备用。",
      "time_min": 10,
      "heat": "小火",
      "tip": "肉酱不能太稀，否则切块时汁水会冲散分层。",
      "visual_cue": "肉酱抱团粘稠，锅底不积汤水"
    },
    {
      "n": 5,
      "text": "黄油化开炒面粉一分半，慢慢倒牛奶搅到顺滑，加肉豆蔻和盐煮成白酱。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "牛奶要分三次倒入，每次搅匀再续，才不起粉块。",
      "visual_cue": "白酱顺滑挂勺，滴落时呈带纹路的缎带状"
    },
    {
      "n": 6,
      "text": "烤盘依次铺土豆、茄子、肉酱，再铺茄子盖满白酱，撒帕玛森芝士烤四十分钟。",
      "time_min": 40,
      "heat": "无火",
      "tip": "温度约一百八十度，表面金黄起泡即熟，出炉静置十分钟再切。",
      "visual_cue": "表层芝士金黄起泡，刀切入不流散"
    }
  ],
  "tips": [
    "茄子先煎再铺层，口感软糯且能隔绝肉酱水分，切块更整齐。",
    "白酱要熬得比平时稠，烘烤后芝士融化才会凝成平整表面。",
    "出炉静置十分钟再切，层次分明不塌陷。"
  ],
  "common_mistakes": [
    "肉酱水分没收到位就叠层，切块时汤汁横流层次散开。",
    "白酱倒牛奶时一次全加，面粉结块搅不散。",
    "出炉立刻切分，馅料未定型导致整盘塌成一团。"
  ],
  "substitutions": [
    {
      "original": "牛肉末",
      "substitute": "羊肉末",
      "ratio": "1:1",
      "note": "用羊肉更接近希腊传统做法，可加半克桂皮去膻。"
    },
    {
      "original": "帕玛森芝士",
      "substitute": "马苏里拉",
      "ratio": "1:1",
      "note": "马苏里拉拉丝明显，但咸度更低需略补盐。"
    }
  ],
  "variations": [
    "把肉酱换成炒软的蘑菇与扁豆，可做无肉版的蔬菜穆萨卡。"
  ],
  "serving_suggestion": "切方块配希腊沙拉与烤面包，佐一杯红酒。",
  "storage": "冷藏三天，冷冻可存一个月；复热用一百六十度烤二十分钟。",
