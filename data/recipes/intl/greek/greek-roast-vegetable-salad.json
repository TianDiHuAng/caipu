  "steps": [
    {
      "n": 1,
      "text": "茄子与西葫芦切一厘米厚片，撒盐静置十分钟吸掉表面水分再擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "去水后烤起来才不软塌。",
      "visual_cue": "表面泛水、擦后干爽"
    },
    {
      "n": 2,
      "text": "甜椒切块、番茄对半切、洋葱切瓣，紫皮朝下摆进烤盘避免烤焦。",
      "time_min": 4,
      "heat": "无火",
      "tip": "切块大小一致，受热才匀。",
      "visual_cue": "蔬菜块大小均匀、铺满烤盘"
    },
    {
      "n": 3,
      "text": "所有蔬菜铺在烤盘上刷橄榄油，撒盐、黑胡椒与百里香，200℃ 烤二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "单层铺开，堆叠会出水。",
      "visual_cue": "边缘焦褐、蔬菜变软"
    },
    {
      "n": 4,
      "text": "出炉趁热淋柠檬汁与剩余橄榄油，撒罗勒碎拌匀，温热或放凉食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热淋汁更吸味。",
      "visual_cue": "蔬菜油亮、香气清新"
    }
  ],
  "tips": [
    "茄子先撒盐去水，烤后才不会吸油发软。",
    "蔬菜单层铺开烤，堆叠会变成蒸。",
    "柠檬汁趁热淋，蔬菜吸味更彻底。"
  ],
  "common_mistakes": [
    "蔬菜切得太薄，烤完缩成干片，完全没有口感。",
    "烤盘堆太满，出水变成一盘蒸菜。",
    "放凉后才淋汁，味道浮在表面不入味。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "南瓜",
      "ratio": "200g 对 200g",
      "note": "烤制时间加 5 分钟。"
    },
    {
      "original": "罗勒",
      "substitute": "欧芹",
      "ratio": "8g 对 10g",
      "note": "香气更清爽。"
    }
  ],
  "variations": [
    "奶酪版：出炉撒 50g 菲达奶酪碎。",
    "主食版：拌入 150g 煮熟的意面。"
  ],
  "serving_suggestion": "温热时当配菜，或放凉后配面包做轻食。",
  "storage": "冷藏可存 2 天，食用前回温并补淋橄榄油。",
