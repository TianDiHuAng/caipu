  "equipment": [
    "刨丝器",
    "纱布",
    "碗",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西葫芦擦丝，撒盐静置十分钟出水。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "撒盐出水，饼才不稀。，火候要稳，别忽大忽小。",
      "visual_cue": "丝体软塌，盘底积水"
    },
    {
      "n": 2,
      "text": "用纱布包紧，用力挤干水分。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "挤得越干，饼越成形。，火候要稳，别忽大忽小。",
      "visual_cue": "丝体干爽，挤不出水"
    },
    {
      "n": 3,
      "text": "加洋葱碎、薄荷、莳萝和黑胡椒拌匀。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香草多放，风味才足。，火候要稳，别忽大忽小。",
      "visual_cue": "混合均匀，香气清亮"
    },
    {
      "n": 4,
      "text": "加鸡蛋和面粉，拌到能成团。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面粉别多，多了发硬。，火候要稳，别忽大忽小。",
      "visual_cue": "糊体黏稠，能抱团，这一点很关键。"
    },
    {
      "n": 5,
      "text": "拌入捏碎的羊乳酪，轻拌别压碎。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪留块，吃着才有惊喜。，火候要稳，别忽大忽小。",
      "visual_cue": "奶酪颗粒清楚，这一点很关键。"
    },
    {
      "n": 6,
      "text": "取一勺压成小圆饼，厚约两厘米。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "厚薄一致，煎时才同步熟。，火候要稳，别忽大忽小。",
      "visual_cue": "饼形圆整，厚度均匀"
    },
    {
      "n": 7,
      "text": "平底锅倒橄榄油，中小火煎三分钟。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "中小火慢煎，里面才熟。，火候要稳，别忽大忽小。",
      "visual_cue": "底面金黄，边缘定型"
    },
    {
      "n": 8,
      "text": "翻面再煎两分钟，吸油后装盘。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "吸掉浮油，吃着才清爽。，火候要稳，别忽大忽小。",
      "visual_cue": "两面金黄，外脆内软"
    }
  ],
  "tips": [
    "西葫芦一定要挤干水。，这一点很关键。",
    "面粉少放，饼才不硬。，这一点很关键。",
    "羊乳酪最后拌，保留颗粒感。，这一点很关键。"
  ],
  "common_mistakes": [
    "水没挤干，下锅散开。，这一点很关键。",
    "面粉太多，口感像面饼。，这一点很关键。",
    "火太大，外面焦里面生。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "羊乳酪",
      "substitute": "切达奶酪",
      "ratio": "150 克:150 克",
      "note": "咸度低，盐加一克。"
    },
    {
      "original": "薄荷",
      "substitute": "罗勒",
      "ratio": "6 克:6 克",
      "note": "香气更甜，用量减半。"
    }
  ],
  "variations": [
    "加一点辣椒碎，味道更醒。，这一点很关键。",
    "做成小圆球炸，外脆内嫩。，这一点很关键。"
  ],
  "serving_suggestion": "配酸奶黄瓜酱，挤上柠檬汁。，这一点很关键。",
  "storage": "冷藏两天，复煎三分钟。，这一点很关键。",
