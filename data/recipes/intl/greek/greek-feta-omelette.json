  "equipment": [
    "平底锅",
    "碗",
    "打蛋器",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进碗里加盐与黑胡椒打散，打至蛋液均匀无成块蛋清。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液打匀就好，过度起泡口感会发虚。",
      "visual_cue": "蛋液顺滑均匀，表面少泡沫"
    },
    {
      "n": 2,
      "text": "小葱与欧芹切碎，番茄切小丁，菲达奶酪用手掰成小粒。",
      "time_min": 7,
      "heat": "无火",
      "tip": "奶酪掰成小粒，卷的时候才好分布。",
      "visual_cue": "奶酪碎粒均匀，葱花翠绿"
    },
    {
      "n": 3,
      "text": "打好的蛋液里拌入小葱、欧芹、牛至和一半奶酪粒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "留一半奶酪后撒，化开与颗粒口感都有。",
      "visual_cue": "蛋液里均匀分布着碎料"
    },
    {
      "n": 4,
      "text": "平底锅倒橄榄油中火烧热，倒入蛋液摊成圆饼。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油热但别冒烟，蛋液才能立刻定型。",
      "visual_cue": "蛋液铺满锅底，边缘起泡"
    },
    {
      "n": 5,
      "text": "撒上番茄丁与剩下的奶酪粒，转小火盖盖焖三分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盖盖小火焖，奶酪才化开而底部不焦。",
      "visual_cue": "奶酪软化，表面蛋液凝固"
    },
    {
      "n": 6,
      "text": "用锅铲把蛋饼对折成半月，再煎一分钟定型后滑入盘中。",
      "time_min": 3,
      "heat": "小火",
      "tip": "对折时用铲子托住，蛋卷才不裂。",
      "visual_cue": "蛋卷半月饱满，边缘微黄"
    },
    {
      "n": 7,
      "text": "装盘后撒一点欧芹碎，配几片番茄同吃更清爽。",
      "time_min": 1,
      "heat": "无火",
      "tip": "趁热吃，奶酪凉了会变硬失去拉丝感。",
      "visual_cue": "表面点缀翠绿，奶酪微微流出"
    }
  ],
  "tips": [
    "蛋液打匀就好，过度起泡煎出来会发虚。",
    "奶酪留一半后撒，既有化开的也有颗粒的。",
    "盖盖小火焖，奶酪化开而底部不焦黑。",
    "对折时用铲子托住，蛋卷形状才完整。"
  ],
  "common_mistakes": [
    "油温不够就倒蛋液，蛋饼粘锅铲不起来。",
    "大火煎，底面焦了中间还是流动蛋液。",
    "奶酪全拌进蛋液，煎完只剩咸味没有颗粒感。",
    "煎好放凉再吃，奶酪变硬像橡皮。"
  ],
  "substitutions": [
    {
      "original": "菲达奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "80克:80克",
      "note": "咸味更淡，盐可加一克。"
    },
    {
      "original": "小葱",
      "substitute": "韭黄",
      "ratio": "25克:30克",
      "note": "香气更柔，适合怕葱味的人。"
    }
  ],
  "variations": [
    "加几片薄火腿同煎，咸香味道会更足一些。",
    "撒一点辣椒碎同煎，做成微辣的口味更下饭。",
    "配一勺希腊酸奶同吃，酸味更解腻。"
  ],
  "serving_suggestion": "趁热上桌，配两片烤面包和一杯浓咖啡，是希腊家庭最常见的早餐。",
  "storage": "现做现吃最好，冷藏不超过一天，复热用平底锅小火两面各一分钟。",
