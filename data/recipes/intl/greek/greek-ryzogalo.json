  ],
  "equipment": [
    "汤锅",
    "量杯",
    "打蛋器",
    "碗",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗三遍至水清，沥干后倒进汤锅加清水，大火烧开。",
      "time_min": 7,
      "heat": "大火",
      "tip": "先用清水把米煮开，再加牛奶不容易糊底。",
      "visual_cue": "水面翻滚，米粒浮起"
    },
    {
      "n": 2,
      "text": "转小火煮十分钟，煮到清水基本被米吸干、米粒开始变软。",
      "time_min": 11,
      "heat": "小火",
      "tip": "水快收干时勤搅动，防止米粒粘锅底。",
      "visual_cue": "锅底几乎无水，米粒发胀"
    },
    {
      "n": 3,
      "text": "倒入六百毫升牛奶搅匀，小火煮二十分钟，全程不停搅拌。",
      "time_min": 21,
      "heat": "小火",
      "tip": "牛奶容易糊底，木勺要刮到锅底不停搅。",
      "visual_cue": "米粒开花，粥体变浓稠"
    },
    {
      "n": 4,
      "text": "玉米淀粉用剩下的牛奶调成稀浆，慢慢倒进锅里搅匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "淀粉先用冷牛奶调开，直接撒会结块。",
      "visual_cue": "奶浆顺滑无颗粒，粥体更稠"
    },
    {
      "n": 5,
      "text": "加白糖、盐和柠檬皮屑，小火再煮五分钟至刮勺能见锅底。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖最后放，早放米不容易煮软。",
      "visual_cue": "划开能看到锅底，痕迹缓慢合拢"
    },
    {
      "n": 6,
      "text": "趁热分装进小碗，表面撒肉桂粉，晾至温热后冷藏两小时。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面撒肉桂既增香也能防止结皮。",
      "visual_cue": "表面平滑，肉桂呈细纹"
    },
    {
      "n": 7,
      "text": "食用前从冰箱取出回温五分钟，布丁应浓稠到勺子能立住。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冷藏后会继续变稠，太稠可加一勺牛奶调开。",
      "visual_cue": "勺背挂厚浆，口感细腻"
    }
  ],
  "tips": [
    "米先用清水煮开再加牛奶，不容易糊底。",
    "全程小火不停搅，木勺刮到底才不会结皮糊锅。",
    "淀粉先用冷牛奶调开，直接倒进热锅会结块。",
    "糖最后放，早放米粒不容易煮软。"
  ],
  "common_mistakes": [
    "牛奶一开就下米，糊底糊得整锅发苦。",
    "大火猛煮不搅动，锅底结一层焦皮。",
    "淀粉直接撒进热粥，结成一坨坨疙瘩。",
    "冷藏过头变得像米糕，失去顺滑口感。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "900毫升:850毫升",
      "note": "做成无乳版本，香气更浓。"
    },
    {
      "original": "肉桂",
      "substitute": "肉豆蔻",
      "ratio": "3克:2克",
      "note": "香气更暖，用量要少。"
    }
  ],
  "variations": [
    "表面撒一层白糖用喷枪烤成焦糖壳，口感更丰富。",
    "加一小勺香草精同煮，奶香会更加圆润。",
    "拌入一勺橙皮屑，果香更清爽不腻。"
  ],
  "serving_suggestion": "冷藏后盛在小碗里，撒肉桂粉，配一杯浓咖啡，是希腊人饭后最常见的甜点。",
  "storage": "冷藏可放三天，表面盖保鲜膜贴着布丁表面，防止结皮。",
