    "打蛋器",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄用擦板擦成粗泥，皮和籽留在擦板上不要，只取果肉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擦成泥比切块好，炒的时候出水快又均匀。",
      "visual_cue": "番茄变成粗泥，皮籽被滤掉"
    },
    {
      "n": 2,
      "text": "洋葱切小丁，大蒜切末，欧芹切碎，菲达奶酪用手掰成小块。",
      "time_min": 7,
      "heat": "无火",
      "tip": "菲达奶酪掰成不规则小块，口感才有层次。",
      "visual_cue": "各料备好，奶酪块大小不匀"
    },
    {
      "n": 3,
      "text": "鸡蛋磕进碗里加一克盐打散，不用打得起泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液轻轻打散就好，打发口感会发干。",
      "visual_cue": "蛋液均匀，无成块蛋清"
    },
    {
      "n": 4,
      "text": "炒锅倒橄榄油下洋葱丁中火炒四分钟至软塌透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒软出甜，番茄的酸才不冲。",
      "visual_cue": "洋葱透明软塌，锅底泛油光"
    },
    {
      "n": 5,
      "text": "加蒜末与牛至炒三十秒出香，倒入番茄泥大火炒八分钟。",
      "time_min": 9,
      "heat": "大火",
      "tip": "番茄泥要炒到水分收干一半，酱才浓。",
      "visual_cue": "番茄泥浓稠冒泡，颜色深红"
    },
    {
      "n": 6,
      "text": "加盐、白糖与黑胡椒调味，把番茄酱在锅底摊平。",
      "time_min": 2,
      "heat": "中火",
      "tip": "白糖只用来压酸，吃不出甜味才对。",
      "visual_cue": "酱汁浓稠平铺，红亮有光"
    },
    {
      "n": 7,
      "text": "倒入蛋液，静置二十秒再用锅铲慢慢推炒成软块。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "中小火慢推，蛋块才嫩滑不干。",
      "visual_cue": "蛋块柔软湿润，裹着番茄酱"
    },
    {
      "n": 8,
      "text": "撒上菲达奶酪碎与欧芹，关火用余温拌两下即可出锅。",
      "time_min": 2,
      "heat": "无火",
      "tip": "奶酪靠余温化开，久炒会拉丝发硬。",
      "visual_cue": "奶酪微微软化，欧芹翠绿"
    }
  ],
  "tips": [
    "番茄擦成泥再炒，出水快、酱汁更顺滑。",
    "洋葱先炒到透明发甜，番茄的酸味会柔和很多。",
    "蛋液下锅后小火慢推，蛋块才嫩滑不老。",
    "菲达奶酪关火后再加，靠余温化开最好吃。"
  ],
  "common_mistakes": [
    "番茄切成大块就下锅，炒半天还是汤汤水水。",
    "番茄泥没炒干就倒蛋液，成品稀成一锅糊。",
    "用大火猛炒蛋液，蛋块又老又干还出水。",
    "奶酪一开始就下锅，炒到后面又咸又硬。"
  ],
  "substitutions": [
    {
      "original": "菲达奶酪",
      "substitute": "山羊奶酪",
      "ratio": "60克:60克",
      "note": "咸味更重，盐要减一克。"
    },
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "450克:400克",
      "note": "酸度更高，白糖多加两克。"
    }
  ],
  "variations": [
    "加一点辣椒碎同炒，做成微辣版本。",
    "最后淋一小勺蜂蜜，酸甜层次更明显。",
    "盛在烤脆的面包片上，做成开胃小食。"
  ],
  "serving_suggestion": "趁热装盘，配一块烤硬面包和几颗橄榄，就是希腊人的快手午餐。",
  "storage": "冷藏不超过一天，复热用小火快炒两分钟，久加热蛋会出水变老。",
