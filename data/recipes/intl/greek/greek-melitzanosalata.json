    "勺子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子整只放烤盘，两百二十度烤三十五分钟至表皮焦黑、内部完全软塌。",
      "time_min": 37,
      "heat": "无火",
      "tip": "烤到表皮焦黑，茄肉才有烟熏香气。",
      "visual_cue": "外皮起皱焦黑，按压软塌"
    },
    {
      "n": 2,
      "text": "取出晾十分钟，趁温热剥去外皮，把茄肉放进滤网沥水十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "沥掉多余水分，酱才不会稀成汤。",
      "visual_cue": "茄肉不再滴水，质地绵软"
    },
    {
      "n": 3,
      "text": "用叉子把茄肉捣成粗泥，保留一点纤维不要打成糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "叉子捣保留纤维，口感比机器打好。",
      "visual_cue": "茄泥粗松，能见到细小纤维"
    },
    {
      "n": 4,
      "text": "洋葱切细末，大蒜磨泥，欧芹切碎，柠檬挤汁备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "洋葱切得越细越好，太粗会抢口感。",
      "visual_cue": "洋葱末细小，配料备齐"
    },
    {
      "n": 5,
      "text": "茄泥里加蒜泥、洋葱末、柠檬汁、红酒醋和盐拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠檬汁分两次加，边尝边调酸度。",
      "visual_cue": "茄泥顺滑带颗粒，酸香明显"
    },
    {
      "n": 6,
      "text": "分次淋入橄榄油边搅边拌，让油被完全吸收。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油分次淋才不会浮在表面。",
      "visual_cue": "酱体油润发亮，不渗油"
    },
    {
      "n": 7,
      "text": "装盘后撒上菲达奶酪碎、欧芹和黑胡椒，静置五分钟即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "奶酪最后撒，上桌才有颗粒层次。",
      "visual_cue": "表面撒满奶酪与香草，颜色对比强"
    }
  ],
  "tips": [
    "茄子烤到表皮焦黑，才有真正的烟熏味。",
    "茄肉捣之前先沥水，酱才不会稀。",
    "橄榄油分次淋入，油才能被完全吸收。",
    "柠檬汁边尝边加，酸度随时能调整。"
  ],
  "common_mistakes": [
    "茄子蒸熟代替烤，成品水多又没有烟熏香。",
    "茄肉不沥水直接拌，酱稀得像汤。",
    "用料理机打成细泥，吃起来像婴儿辅食。",
    "橄榄油一次全倒，酱表面浮一层油。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "彩椒",
      "ratio": "700克:600克",
      "note": "同样烤焦去皮，做成烤椒酱。"
    },
    {
      "original": "红酒醋",
      "substitute": "柠檬汁",
      "ratio": "10毫升:10毫升",
      "note": "酸味更清亮，适合配烤肉。"
    }
  ],
  "variations": [
    "加一勺原味酸奶同拌，口感会更圆润顺滑。",
    "撒一点辣椒碎同拌，做成微辣版本更开胃。",
    "不放奶酪做成纯素版，味道更清爽。"
  ],
  "serving_suggestion": "装进小碗，淋一点橄榄油，配烤皮塔饼或生蔬菜条，作为开胃菜最合适。",
  "storage": "冷藏可放三天，表面淋一层橄榄油封住，食用前搅匀。",
