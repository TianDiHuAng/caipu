  "equipment": [
    "擦丝器",
    "纱布",
    "大碗",
    "蒜泥器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜去皮擦成细丝，撒一半盐抓匀静置十分钟，让它出掉多余水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "去水是浓稠的关键。",
      "visual_cue": "黄瓜丝出水、体积缩小"
    },
    {
      "n": 2,
      "text": "黄瓜丝包进纱布用力挤干，挤到抓一把不再滴水为止。",
      "time_min": 5,
      "heat": "无火",
      "tip": "挤得越干，酱越浓稠。",
      "visual_cue": "黄瓜丝干爽、抓成紧实的小团"
    },
    {
      "n": 3,
      "text": "酸奶加蒜泥、柠檬汁、剩余盐与黑胡椒拌匀，再拌入黄瓜丝与薄荷碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜泥现磨，香气才冲。",
      "visual_cue": "酱体浓稠、颜色乳白带绿"
    },
    {
      "n": 4,
      "text": "盛进碗里淋一圈橄榄油，撒黑胡椒，冷藏十分钟后食用更佳。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冷藏后风味更融合。",
      "visual_cue": "表面油亮、质地挂勺"
    }
  ],
  "tips": [
    "黄瓜必须挤到不滴水，否则拌好一小时就出水变稀。",
    "酸奶选浓稠型，稀酸奶先挂纱布滤两小时再用。",
    "蒜泥现磨现用，提前磨好会发苦。"
  ],
  "common_mistakes": [
    "黄瓜没去水就拌，酱汁稀得像汤。",
    "用甜味酸奶代替原味，整碗味道跑偏。",
    "蒜泥一次放太多，压过酸奶与黄瓜的清香。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "希腊酸奶",
      "ratio": "400g 对 400g",
      "note": "蛋白更高、质地更厚。"
    },
    {
      "original": "薄荷",
      "substitute": "莳萝",
      "ratio": "5g 对 5g",
      "note": "香气更清冷。"
    }
  ],
  "variations": [
    "辣味版：加 5g 辣椒粉与橄榄油同淋。",
    "胡萝卜版：掺 100g 胡萝卜丝增甜。"
  ],
  "serving_suggestion": "配皮塔饼、烤肉串或烤蔬菜，也可当沙拉酱。",
  "storage": "冷藏密封可存 3 天，出水后拌匀再吃。",
