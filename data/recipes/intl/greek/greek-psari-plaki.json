  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去内脏，洗净擦干。，火大了就离锅远一点。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼身擦干，烤后才不腥。，火别开太大，稳着来。",
      "visual_cue": "鱼身干爽，鳞片干净"
    },
    {
      "n": 2,
      "text": "鱼身两面划三刀，抹盐和黑胡椒。，锅温要匀，别忽高忽低。",
      "time_min": 4,
      "heat": "无火",
      "tip": "划刀入味，也易熟透。，火力保持中等，慢慢来。",
      "visual_cue": "刀口整齐，调料均匀"
    },
    {
      "n": 3,
      "text": "烤盘底刷橄榄油，铺洋葱丝和蒜片。，火候宁小勿大，慢慢推进。",
      "time_min": 4,
      "heat": "无火",
      "tip": "垫底蔬菜托住鱼，不粘盘。，注意锅里温度别掉下来。",
      "visual_cue": "洋葱铺平，油光均匀"
    },
    {
      "n": 4,
      "text": "鱼放洋葱上，鱼腹塞柠檬片。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "腹内塞柠檬，腥味才去。，火要均匀，食材才不糊。",
      "visual_cue": "鱼身平放，方向一致"
    },
    {
      "n": 5,
      "text": "番茄片铺在鱼身周围，撒牛至。，看住火，别让它失控。",
      "time_min": 4,
      "heat": "无火",
      "tip": "番茄围边，汁水自流。，全程留意火候，别贪快。",
      "visual_cue": "分布均匀，颜色鲜亮"
    },
    {
      "n": 6,
      "text": "淋白葡萄酒和剩余橄榄油。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酒和油一起淋，香气才透。，火别开太大，稳着来。",
      "visual_cue": "表面湿润，汁液铺底"
    },
    {
      "n": 7,
      "text": "盖锡纸，二百度烤二十五分钟。，锅温要匀，别忽高忽低。",
      "time_min": 27,
      "heat": "无火",
      "tip": "先盖锡纸，鱼肉才不干。，火力保持中等，慢慢来。",
      "visual_cue": "锡纸鼓起，香气外溢"
    },
    {
      "n": 8,
      "text": "揭锡纸再烤十分钟收汁上色。，火候宁小勿大，慢慢推进。",
      "time_min": 12,
      "heat": "无火",
      "tip": "揭开收汁，表面才微焦。，注意锅里温度别掉下来。",
      "visual_cue": "表面微黄，汁水浓稠"
    },
    {
      "n": 9,
      "text": "出炉挤柠檬汁，趁热上桌。，始终中小火，别心急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后挤汁，酸香才清亮。，火要均匀，食材才不糊。",
      "visual_cue": "汁水清亮，香气扑鼻"
    }
  ],
  "tips": [
    "鱼身划刀，熟度才均匀。，很多人在这里出错。",
    "先盖锡纸，鱼肉更嫩。，这里最容易翻车。",
    "最后挤柠檬，酸香才活。，别小看这一步。"
  ],
  "common_mistakes": [
    "鱼没擦干，烤出一盘水。，成败就在这一步。",
    "全程盖锡纸，表面不上色。，这点要注意。",
    "烤太久，鱼肉发柴。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "鳕鱼",
      "ratio": "800 克:800 克",
      "note": "肉更厚，烤的时间加五分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "柠檬汁加水",
      "ratio": "80 毫升:40 毫升兑40毫升",
      "note": "酸度更高，盐减一克。"
    }
  ],
  "variations": [
    "加黑橄榄同烤，风味更浓。，别嫌麻烦，做完它。",
    "加土豆片垫底，吸汁更好吃。，这一步别省。"
  ],
  "serving_suggestion": "配希腊沙拉和面包，汁水蘸着吃。，别跳过这步。",
  "storage": "冷藏两天，复烤八分钟。，这步最关键。",
