  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成半厘米厚的圆片，泡在清水里防止氧化发黑。",
      "time_min": 12,
      "heat": "无火",
      "tip": "土豆片泡水去淀粉，烤出来不粘不糊。",
      "visual_cue": "土豆片洁白，水微微发浑"
    },
    {
      "n": 2,
      "text": "西葫芦与番茄同样切成半厘米厚的圆片，洋葱切圈，青椒切块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "所有蔬菜切同样厚度，烤的时候才同步熟。",
      "visual_cue": "各片厚薄一致，排列整齐"
    },
    {
      "n": 3,
      "text": "大蒜切片，欧芹切碎，烤盘底部刷一层橄榄油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "烤盘刷油，蔬菜才不粘底也不焦。",
      "visual_cue": "烤盘底部油亮，蒜片备好"
    },
    {
      "n": 4,
      "text": "把土豆片、西葫芦片、番茄片交错叠放排进烤盘，缝隙塞入洋葱与青椒。",
      "time_min": 12,
      "heat": "无火",
      "tip": "竖着叠放比平铺更好看，也更容易均匀受热。",
      "visual_cue": "蔬菜片竖立交错，颜色分明"
    },
    {
      "n": 5,
      "text": "撒上蒜片、盐、黑胡椒和牛至，淋上剩下的橄榄油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "牛至用手搓一下再撒，香气才出得来。",
      "visual_cue": "表面均匀撒满调料与油"
    },
    {
      "n": 6,
      "text": "沿烤盘边缘倒入清水，盖上锡纸，两百度烤三十五分钟。",
      "time_min": 38,
      "heat": "无火",
      "tip": "加水和盖锡纸，蔬菜才不会烤干发焦。",
      "visual_cue": "锡纸鼓起，能听到汁水沸腾"
    },
    {
      "n": 7,
      "text": "揭掉锡纸再烤十五分钟，让表面收汁上色，出炉撒欧芹。",
      "time_min": 18,
      "heat": "无火",
      "tip": "揭纸后再烤，表面才有漂亮的焦边。",
      "visual_cue": "表层微焦，汁水浓稠"
    }
  ],
  "tips": [
    "蔬菜切同样厚度，烤的时候才一起熟。",
    "土豆片先泡水去淀粉，成品不粘不糊。",
    "烤盘里加水并盖锡纸，蔬菜才不干柴。",
    "最后揭纸再烤十五分钟，表面才上色。"
  ],
  "common_mistakes": [
    "蔬菜切得厚薄不一，有的焦了有的还是硬的。",
    "不加水直接烤，蔬菜边缘烤干发苦。",
    "一直盖着锡纸烤到底，表面苍白没有焦香。",
    "油放太少，蔬菜粘在烤盘上铲不下来。"
  ],
  "substitutions": [
    {
      "original": "西葫芦",
      "substitute": "茄子",
      "ratio": "400克:400克",
      "note": "吸油更多，橄榄油加十毫升。"
    },
    {
      "original": "牛至",
      "substitute": "百里香",
      "ratio": "6克:5克",
      "note": "香气更沉，用量略减。"
    }
  ],
  "variations": [
    "加一把黑橄榄同烤，咸香味道会更足更立体。",
    "表面撒一层菲达奶酪碎，烤到微融。",
    "放两三片柠檬同烤，果香能解掉油腻感。"
  ],
  "serving_suggestion": "连汁一起盛盘，配一块硬面包蘸汁，夏天放凉了吃也很清爽。",
  "storage": "冷藏可放三天，复热用烤箱一百八十度十分钟，微波会让蔬菜出水变软。",
