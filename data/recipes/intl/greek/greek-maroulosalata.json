  "steps": [
    {
      "n": 1,
      "text": "生菜掰开洗净，沥干水分后切成半厘米宽的细丝。",
      "time_min": 12,
      "heat": "无火",
      "tip": "生菜一定沥干，带水会把沙拉汁冲淡。",
      "visual_cue": "生菜丝干爽，粗细均匀"
    },
    {
      "n": 2,
      "text": "小葱切段，莳萝与欧芹切碎，菲达奶酪掰成小块备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香草切碎一点，拌开才分布均匀。",
      "visual_cue": "香草细碎，奶酪块零星分布"
    },
    {
      "n": 3,
      "text": "小碗里倒橄榄油、红酒醋，加盐、黑胡椒与牛至搅到乳化。",
      "time_min": 3,
      "heat": "无火",
      "tip": "搅到汁液发白乳化，才不会沉在碗底。",
      "visual_cue": "沙拉汁乳白微稠，油醋融合"
    },
    {
      "n": 4,
      "text": "大沙拉碗里放生菜丝、小葱段、莳萝和欧芹，轻拌两下。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生菜别用力压，拌散保持蓬松口感好。",
      "visual_cue": "菜叶蓬松，香草散布其间"
    },
    {
      "n": 5,
      "text": "淋上沙拉汁，用夹子从碗底往上翻拌，让每片叶子裹到汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "从下往上翻拌，菜叶才不塌不碎。",
      "visual_cue": "每片叶子油亮，碗底无积汁"
    },
    {
      "n": 6,
      "text": "最后撒上菲达奶酪碎与一点牛至，静置三分钟再上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置三分钟入味，但别放太久会出水。",
      "visual_cue": "奶酪点缀表面，香气清新"
    }
  ],
  "tips": [
    "生菜必须沥干水，沙拉汁才不会被稀释。",
    "沙拉汁要搅到乳化，油醋才不会分层。",
    "从碗底往上翻拌，菜叶不容易压塌。",
    "上桌前静置三分钟，味道融合但不出水。"
  ],
  "common_mistakes": [
    "生菜带水下锅，拌完碗底一层水。",
    "沙拉汁随便一搅就浇，油浮在上面醋沉底。",
    "生菜用刀剁碎，叶子全被切断出水发蔫。",
    "提前两小时拌好，上桌时菜叶全塌软。"
  ],
  "substitutions": [
    {
      "original": "生菜",
      "substitute": "罗马生菜",
      "ratio": "400克:400克",
      "note": "口感更脆，切丝要更细。"
    },
    {
      "original": "红酒醋",
      "substitute": "柠檬汁",
      "ratio": "20毫升:18毫升",
      "note": "酸味更清亮，适合夏天。"
    }
  ],
  "variations": [
    "加几颗黑橄榄同拌，咸香味道会更足一些。",
    "撒一把烤香的松子，口感层次会更丰富。",
    "把菲达奶酪换成山羊奶酪，味道更冲。"
  ],
  "serving_suggestion": "装进大碗直接上桌，配烤肉、烤鱼或面包都合适，清爽解腻。",
  "storage": "现拌现吃，冷藏不超过一天，菜叶会出水，复食前倒掉积汁再拌一次。",
