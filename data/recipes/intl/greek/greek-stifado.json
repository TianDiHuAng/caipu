  "steps": [
    {
      "n": 1,
      "text": "牛肉切大块，用厨房纸吸干表面水。，火候宁小勿大，慢慢推进。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉块擦干，煎时才上色。，注意锅里温度别掉下来。",
      "visual_cue": "肉块干爽，形状完整"
    },
    {
      "n": 2,
      "text": "炖锅倒橄榄油，牛肉分批煎到焦褐。，始终中小火，别心急。",
      "time_min": 10,
      "heat": "大火",
      "tip": "分批下锅，锅温才不会掉。，火要均匀，食材才不糊。",
      "visual_cue": "肉块焦褐，锅底有香"
    },
    {
      "n": 3,
      "text": "盛出牛肉，余油炒香整只小洋葱。，看住火，别让它失控。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洋葱整只炖，才不会烂成泥。，全程留意火候，别贪快。",
      "visual_cue": "洋葱外层透明，边缘焦黄"
    },
    {
      "n": 4,
      "text": "加蒜末和牛至炒出香味。，火大了就离锅远一点。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "牛至炒一下，香气才散开。，火别开太大，稳着来。",
      "visual_cue": "香气扑鼻，蒜末微黄"
    },
    {
      "n": 5,
      "text": "倒红酒煮开，刮起锅底焦香。，锅温要匀，别忽高忽低。",
      "time_min": 5,
      "heat": "中火",
      "tip": "酒要煮开，酸味才挥发。，火力保持中等，慢慢来。",
      "visual_cue": "酒气散去，汤汁深褐"
    },
    {
      "n": 6,
      "text": "放回牛肉，加番茄泥和清水。，火候宁小勿大，慢慢推进。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄泥让汤色红亮。，注意锅里温度别掉下来。",
      "visual_cue": "汤色红褐，料面齐平"
    },
    {
      "n": 7,
      "text": "小火盖盖炖一个半小时，中途翻两次。，始终中小火，别心急。",
      "time_min": 92,
      "heat": "小火",
      "tip": "小火慢炖，肉才入口即化。，火要均匀，食材才不糊。",
      "visual_cue": "肉一戳就散，汤汁浓稠"
    },
    {
      "n": 8,
      "text": "开盖收汁，加盐和黑胡椒调味。，看住火，别让它失控。",
      "time_min": 10,
      "heat": "中火",
      "tip": "收汁到挂勺，味道才集中。，全程留意火候，别贪快。",
      "visual_cue": "汤汁浓稠，油光发亮"
    }
  ],
  "tips": [
    "小洋葱整只炖，口感才完整。，成败就在这一步。",
    "红酒煮开再炖，酸味才不冲。，这点要注意。",
    "小火慢炖，肉才软烂。，这是关键点。"
  ],
  "common_mistakes": [
    "火大汤干，肉还没软。，别嫌麻烦，做完它。",
    "洋葱切碎，炖成糊。，这一步别省。",
    "红酒没煮开，成品发酸。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "800 克:800 克",
      "note": "风味更重，可加牛至一克。"
    },
    {
      "original": "红酒",
      "substitute": "白葡萄酒",
      "ratio": "200 毫升:200 毫升",
      "note": "酸度更高，需多加糖五克。"
    }
  ],
  "variations": [
    "加丁香两粒，香气更暖。，这步最关键。",
    "配或佐意面吃，汤汁不浪费。，很多人在这里出错。"
  ],
  "serving_suggestion": "配土豆泥或硬面包蘸汁吃。，这里最容易翻车。",
  "storage": "冷藏三天，复热更入味。，别小看这一步。",
