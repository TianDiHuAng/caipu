  "steps": [
    {
      "n": 1,
      "text": "甜菜根洗净不去皮，整颗放进汤锅加水没过，大火烧开转小火煮四十分钟。",
      "time_min": 45,
      "heat": "小火",
      "tip": "带皮煮才不会掉色，甜味也留得住。",
      "visual_cue": "甜菜根软到筷子能轻松扎透"
    },
    {
      "n": 2,
      "text": "捞出稍晾，趁温热时用厨房纸一搓就去皮，切成两厘米小块。",
      "time_min": 12,
      "heat": "无火",
      "tip": "趁温热搓皮最省力，凉了皮又粘回去。",
      "visual_cue": "表皮一搓即落，块型完整"
    },
    {
      "n": 3,
      "text": "酸奶倒进碗里加蒜泥、盐和黑胡椒，搅到顺滑无颗粒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶先搅顺再拌料，酱才细腻不结块。",
      "visual_cue": "酸奶浓稠顺滑，蒜香散开"
    },
    {
      "n": 4,
      "text": "甜菜根块放进沙拉碗，淋红酒醋与一半橄榄油轻拌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先用醋拌，甜菜根的土味会被压下去。",
      "visual_cue": "甜菜块染上醋汁，颜色更深"
    },
    {
      "n": 5,
      "text": "把酸奶酱浇在甜菜根上，用勺子轻轻兜底翻两下。",
      "time_min": 2,
      "heat": "无火",
      "tip": "别用力搅，搅匀了颜色会变成一团紫泥。",
      "visual_cue": "紫红与奶白交错，纹理漂亮"
    },
    {
      "n": 6,
      "text": "撒上核桃碎、小葱碎，淋剩下的橄榄油即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "核桃最后撒，保持脆感不返潮。",
      "visual_cue": "表面撒满核桃碎，油光清亮"
    }
  ],
  "tips": [
    "甜菜根带皮煮，颜色和甜味都能锁住。",
    "趁温热搓皮，凉了皮就不容易脱下。",
    "先用醋拌一道，能压住甜菜根的土腥味。",
    "酸奶酱只翻两下，紫白交错才好看。"
  ],
  "common_mistakes": [
    "去皮再煮，甜菜根掉色，锅里全是红水。",
    "煮的时间不够，中间还硬，切开有白芯。",
    "酸奶和甜菜根搅得太匀，成品变成一坨紫泥。",
    "核桃早拌进去，上桌时已经被泡软了。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "希腊酸奶",
      "ratio": "200克:160克",
      "note": "更浓稠，需加两勺清水调稀。"
    },
    {
      "original": "核桃",
      "substitute": "开心果",
      "ratio": "30克:30克",
      "note": "颜色更亮，香气偏甜。"
    }
  ],
  "variations": [
    "加一勺蜂蜜，酸甜平衡更适合当开胃菜。",
    "撒一点橙皮屑同拌，整体香气会更清爽。",
    "把甜菜根换成胡萝卜，做成橙色的版本。"
  ],
  "serving_suggestion": "装盘后配烤面包片，作为前菜或配菜都很合适，紫红色上桌很抓眼。",
  "storage": "冷藏可放两天，酱与菜分开保存，食用前再拌，颜色更好看。",
