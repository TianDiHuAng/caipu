  "steps": [
    {
      "n": 1,
      "text": "虾去壳留尾，开背去虾线。，火候要稳，别忽大忽小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "开背更入味，炸时卷得漂亮。，火候要稳，别忽大忽小。",
      "visual_cue": "虾身展开，虾线去净"
    },
    {
      "n": 2,
      "text": "虾加盐和白胡椒腌十分钟。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌十分钟就够，久了肉紧。，火候要稳，别忽大忽小。",
      "visual_cue": "虾身微湿，调味均匀"
    },
    {
      "n": 3,
      "text": "燕麦片用擀面杖压成粗碎。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "无火",
      "tip": "别压成粉，粗粒才有口感。，火候要稳，别忽大忽小。",
      "visual_cue": "颗粒不均匀，大小适中"
    },
    {
      "n": 4,
      "text": "虾拍一层薄面粉，再蘸蛋液。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉薄薄一层，太多会糊。，火候要稳，别忽大忽小。",
      "visual_cue": "表面均匀，无结块，这一点很关键。"
    },
    {
      "n": 5,
      "text": "锅中倒植物油烧到一百八十度，下虾炸一分半。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "时间短，虾一变色就捞。，火候要稳，别忽大忽小。",
      "visual_cue": "外壳浅金，虾身卷曲"
    },
    {
      "n": 6,
      "text": "锅留底油，炒香咖喱叶和小米辣。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "咖喱叶一炸就香，别炒黑。，火候要稳，别忽大忽小。",
      "visual_cue": "叶片卷曲，香气四溢"
    },
    {
      "n": 7,
      "text": "下燕麦碎小火炒到微黄发香。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "小火",
      "tip": "小火慢炒，燕麦才酥不焦。，火候要稳，别忽大忽小。",
      "visual_cue": "颜色金黄，颗粒松散"
    },
    {
      "n": 8,
      "text": "加白糖和盐炒匀，倒回虾翻匀出锅。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "糖先化开，才能挂住虾身。，火候要稳，别忽大忽小。",
      "visual_cue": "虾身裹满麦片，干爽不油"
    }
  ],
  "tips": [
    "燕麦压粗碎，口感才像麦片。，这一点很关键。",
    "虾一变色就捞，久炸发硬。，这一点很关键。",
    "燕麦用小火炒，才酥不焦。，这一点很关键。"
  ],
  "common_mistakes": [
    "燕麦炒过头，整锅发苦。，这一点很关键。",
    "虾炸两分钟以上，肉缩成球。，这一点很关键。",
    "糖放太早，燕麦粘成一坨。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "燕麦",
      "substitute": "面包糠",
      "ratio": "120 克:100 克",
      "note": "更细更脆，香气略淡。"
    },
    {
