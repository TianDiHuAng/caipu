      "substitute": "鱿鱼",
      "ratio": "600 克:600 克",
      "note": "切圈炸四十秒即可。"
    }
  ],
  "variations": [
    "加奶粉一勺，奶香更浓。，这一点很关键。",
    "加咖喱粉半勺，风味更像餐厅版。，这一点很关键。"
  ],
  "serving_suggestion": "热吃，配啤酒或酸柑汁。，这一点很关键。",
  "storage": "现炸现吃，凉了回锅复炒一分钟。，这一点很关键。",
