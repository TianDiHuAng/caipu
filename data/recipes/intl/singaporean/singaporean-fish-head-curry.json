  "equipment": [
    "深炒锅",
    "砂锅",
    "木铲",
    "滤网",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "石斑鱼头剖成两半，用清水冲净血块，撒三克盐抹匀腌十五分钟去腥。",
      "time_min": 15,
      "heat": "无火",
      "tip": "血水冲净，汤才不发腥。",
      "visual_cue": "鱼皮泛白，切口没有血丝"
    },
    {
      "n": 2,
      "text": "罗望子果肉加温水八十毫升泡十分钟，用手揉散后滤出酸汁备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "罗望子肉别直接下锅，会带渣。",
      "visual_cue": "滤出的汁呈琥珀色，味酸"
    },
    {
      "n": 3,
      "text": "红葱头、大蒜、南姜切碎，与咖喱粉、姜黄一同下植物油锅小火炒五分钟至油色泛红。",
      "time_min": 5,
      "heat": "小火",
      "tip": "香料要炒到出油才够香，火大易焦苦。",
      "visual_cue": "锅中红油厚实，香气扑鼻"
    },
    {
      "n": 4,
      "text": "下香茅段、咖喱叶和小米辣继续炒一分钟，加番茄块炒到软塌出汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒软能撑起汤体的厚度。",
      "visual_cue": "番茄边缘化开，锅底有浓汁"
    },
    {
      "n": 5,
      "text": "倒入六百毫升清水和罗望子汁烧开，放茄子块中火煮八分钟至半软。",
      "time_min": 8,
      "heat": "中火",
      "tip": "茄子先煮半软，吸足咖喱汁更入味。",
      "visual_cue": "茄子皮转深紫，边缘微透"
    },
    {
      "n": 6,
      "text": "鱼头肉面朝下放入锅中，加盖小火焖十二分钟，中途把汤汁舀起淋在鱼头上。",
      "time_min": 12,
      "heat": "小火",
      "tip": "鱼头别频繁翻动，肉容易散。",
      "visual_cue": "鱼眼凸白，鱼皮裂开露出白肉"
    },
    {
      "n": 7,
      "text": "转最小火倒入椰奶，加盐和白糖调味，保持微沸煮三分钟即关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椰奶不能大滚，否则油水分离。",
      "visual_cue": "汤色转橙红，表面细泡轻冒"
    },
    {
      "n": 8,
      "text": "连锅端上桌，先舀汤再取鱼肉，配白饭食用。",
      "time_min": 1,
      "heat": "无火",
      "tip": "余温会让鱼肉继续熟成，别久煮。",
      "visual_cue": "鱼肉一夹就离骨，汤汁挂勺"
    }
  ],
  "tips": [
    "鱼头选石斑或鲈鱼，肉质紧实不易散。",
    "咖喱粉先用温油炒过，辛辣味会比直接下汤柔和。",
    "茄子泡过水再煮，颜色才不发黑。"
  ],
  "common_mistakes": [
    "椰奶早放又大火滚，汤汁分层结块。",
    "鱼头不断翻动，出锅时只剩碎肉。",
    "罗望子放太多，酸味压过咖喱香。"
  ],
  "substitutions": [
    {
      "original": "石斑鱼",
      "substitute": "鲈鱼",
      "ratio": "800克:800克",
      "note": "肉质更嫩，焖煮时间缩短三分钟。"
    },
    {
      "original": "罗望子",
      "substitute": "青柠",
      "ratio": "30克:2个",
      "note": "青柠汁出锅前挤入，酸味更清亮。"
    }
  ],
  "variations": [
    "加一把秋葵同煮，汤汁会更稠滑。",
    "用砂锅慢炖，保温久，适合多人分食。"
  ],
  "serving_suggestion": "先把鱼头夹到盘中，浇两勺咖喱汤，配白饭或印度煎饼蘸汤吃。",
  "storage": "冷藏可放两天，复热时加少量清水小火加热，别用大火。",
