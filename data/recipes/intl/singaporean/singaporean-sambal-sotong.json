  "steps": [
    {
      "n": 1,
      "text": "小米辣、红葱头、大蒜和虾酱打成粗酱。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打粗一点，口感才有层次。，火候要稳，别忽大忽小。",
      "visual_cue": "酱体红褐，颗粒分明"
    },
    {
      "n": 2,
      "text": "鱿鱼切圈，用盐抓洗后冲净。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "抓洗去黏液，口感才脆。，火候要稳，别忽大忽小。",
      "visual_cue": "鱿鱼圈白净，无杂质"
    },
    {
      "n": 3,
      "text": "锅热植物油，小火炒香参巴酱。，火候要稳，别忽大忽小。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火慢炒，颜色才红亮。，火候要稳，别忽大忽小。",
      "visual_cue": "油色红亮，香气浓烈"
    },
    {
      "n": 4,
      "text": "加番茄膏炒匀，炒到油酱分离。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "炒出红油，酱才够香。，火候要稳，别忽大忽小。",
      "visual_cue": "锅边见红油，酱体浓稠"
    },
    {
      "n": 5,
      "text": "加罗望子汁和白糖，调出酸甜。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "罗望子先化开再倒，避免结块。，火候要稳，别忽大忽小。",
      "visual_cue": "酱汁酸甜，质地顺滑"
    },
    {
      "n": 6,
      "text": "下鱿鱼圈大火快炒一分半。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "大火",
      "tip": "时间短，鱿鱼才嫩不韧。，火候要稳，别忽大忽小。",
      "visual_cue": "鱿鱼卷曲，颜色转白"
    },
    {
      "n": 7,
      "text": "尝味补盐，挤青柠汁出锅。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠离火后挤，酸香更鲜。，火候要稳，别忽大忽小。",
      "visual_cue": "鱿鱼裹酱，油光发亮"
    }
  ],
  "tips": [
    "参巴酱要小火炒出红油，才够香。，这一点很关键。",
    "鱿鱼只需一分半，久了像橡皮。，这一点很关键。",
    "罗望子汁先化开，避免结块。，这一点很关键。"
  ],
  "common_mistakes": [
    "大火炒参巴酱，糊味盖过辣香。，这一点很关键。",
    "鱿鱼炒三分钟，硬得嚼不动。，这一点很关键。",
    "糖放太少，只剩死辣。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "虾",
      "ratio": "600 克:600 克",
      "note": "去壳炒两分钟，口感更弹。"
    },
    {
      "original": "罗望子",
      "substitute": "青柠",
      "ratio": "20 克:2 个",
      "note": "酸味更清亮，少了果香。"
    }
  ],
  "variations": [
    "加豆角同炒，口感更丰富。，这一点很关键。",
    "加一点椰奶，酱更顺滑。，这一点很关键。"
  ],
  "serving_suggestion": "配白米饭和黄瓜片，酱汁拌饭。，这一点很关键。",
  "storage": "冷藏两天，复热须炒透。，这一点很关键。",
