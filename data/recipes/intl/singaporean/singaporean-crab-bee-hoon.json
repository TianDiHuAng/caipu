  "equipment": [
    "炒锅",
    "汤锅",
    "锅铲",
    "漏勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花蟹用硬刷刷净壳面，揭盖去掉鳃和胃囊，斩成带钳的四大块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "花蟹块别斩太小，肉汁流失得快。",
      "visual_cue": "花蟹壳青亮，断面肉质紧实"
    },
    {
      "n": 2,
      "text": "米粉用冷水泡十五分钟到能弯折，捞出沥干水分。",
      "time_min": 15,
      "heat": "无火",
      "tip": "冷水泡发比热水烫更弹，也不易断。",
      "visual_cue": "米粉柔软有韧性，一折不断"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下大蒜片、姜丝和葱白小火爆香一分钟，再放白胡椒炒三十秒。",
      "time_min": 2,
      "heat": "小火",
      "tip": "白胡椒遇热才出香，但别炒到发黑。",
      "visual_cue": "锅中胡椒香气呛鼻，蒜片微黄"
    },
    {
      "n": 4,
      "text": "转大火放入花蟹块，翻炒两分钟至花蟹壳转红，沿锅边淋入生抽翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "花蟹壳转红再放其他调料，鲜味不流失。",
      "visual_cue": "花蟹壳通红发亮，锅底有焦香汁"
    },
    {
      "n": 5,
      "text": "加三百毫升热水和蚝油、白糖、盐，加盖中火煮五分钟让花蟹的鲜味渗进汤里。",
      "time_min": 5,
      "heat": "中火",
      "tip": "水用热的，锅温不掉，花蟹的肉才嫩。",
      "visual_cue": "汤汁乳白转浅棕，表面浮红油"
    },
    {
      "n": 6,
      "text": "放入沥干的米粉，用筷子抖散浸入汤汁，中火焖四分钟至汤汁被吸走大半。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米粉别用铲子压，容易断成碎段。",
      "visual_cue": "米粉吸饱汤色，根根分明不坨"
    },
    {
      "n": 7,
      "text": "淋入打散的鸡蛋液，静置二十秒待其半凝后再翻拌均匀。",
      "time_min": 1,
      "heat": "中火",
      "tip": "蛋液先定型再拌，才有片片蛋花。",
      "visual_cue": "汤汁挂住米粉，蛋花成薄片"
    },
    {
      "n": 8,
      "text": "关火后撒上葱绿和香菜段，盛进深盘趁热端上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香菜最后下，青草香才不被烫熟。",
      "visual_cue": "表面点缀翠绿，热气带胡椒香"
    }
  ],
  "tips": [
    "白胡椒用量看着多，但它是这道菜的灵魂，别减到一半。",
    "米粉泡发后一定沥干，带水下锅会冲淡汤汁。",
    "花蟹比肉蟹更适合煮米粉，甜味更清。"
  ],
  "common_mistakes": [
    "米粉用热水泡发，下锅一拌就断。",
    "白胡椒最后才撒，香气浮在表面不入味。",
    "全程用大火收汁，蟹肉缩水发柴，汤汁也咸得发苦。"
  ],
  "substitutions": [
    {
      "original": "花蟹",
      "substitute": "蟹",
      "ratio": "900克:900克",
      "note": "青蟹肉质更厚，煮制时间加两分钟。"
    },
    {
      "original": "米粉",
      "substitute": "粉丝",
      "ratio": "300克:250克",
      "note": "粉丝吸水快，汤汁要多加一百毫升。"
    }
  ],
  "variations": [
    "加一把炸过的姜丝，胡椒香里多一层焦香。",
    "喜欢奶香可在收汁前淋两勺椰奶。"
  ],
  "serving_suggestion": "连汤带粉盛进深盘，先夹蟹块再拌米粉，胡椒的辣会在后味浮上来。",
  "storage": "冷藏不超过一天，复热时加少量热水回锅，别用微波直接打。",
