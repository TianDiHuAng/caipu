  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 400,
          "unit": "ml",
          "note": "全脂牛奶，冷藏取出",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "炼乳",
          "name_en": "condensed milk",
          "amount": 60,
          "unit": "g",
          "note": "增稠提甜",
          "optional": false
        },
        {
          "name": "玫瑰酱",
          "name_en": "rose jam",
          "amount": 40,
          "unit": "g",
          "note": "带花瓣的玫瑰糖浆",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "按甜度调整",
          "optional": false
        },
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 50,
          "unit": "ml",
          "note": "增加顺滑感",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小奶锅",
    "量杯",
    "长柄勺",
    "玻璃杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小奶锅倒少量清水，加白糖和玫瑰酱小火加热两分钟，搅到糖完全融化。",
      "time_min": 5,
      "heat": "小火",
      "tip": "玫瑰酱受热才散得开，别用大火煮。",
      "visual_cue": "糖浆呈淡粉色，花瓣舒展开"
    },
    {
      "n": 2,
      "text": "关火倒入炼乳搅匀，让糖浆稍微放凉到不烫手。",
      "time_min": 2,
      "heat": "无火",
      "tip": "太热时加奶会结一层膜。",
      "visual_cue": "液体顺滑无颗粒，颜色转玫瑰粉"
    },
    {
      "n": 3,
      "text": "倒入牛奶和椰奶，用长柄勺沿同一方向搅三十秒，让颜色均匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "椰奶先摇匀再倒，否则会分层。",
      "visual_cue": "饮品呈均匀的浅粉奶色"
    },
    {
      "n": 4,
      "text": "倒进玻璃杯，喜欢凉的可加冰块或提前冷藏一小时再饮用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冰镇后甜味会收敛，口感更清爽。",
      "visual_cue": "杯壁挂薄雾，表面飘少量泡沫"
    }
  ],
  "tips": [
    "玫瑰酱本身带糖，白糖按口味增减。",
    "牛奶换成豆奶也能做，只是奶香会淡一些。",
    "想要浓稠的质地，炼乳可以加到八十克。"
  ],
  "common_mistakes": [
    "玫瑰酱和牛奶一起下锅煮，奶液结块起皮。",
    "搅拌时来回反向，泡沫太多影响卖相。",
    "冰块加得太多，喝到后面只剩下稀释的水味。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "400毫升:300毫升",
      "note": "做成无乳版本，质地更厚，甜度略降。"
    },
    {
      "original": "玫瑰酱",
      "substitute": "红糖",
      "ratio": "40克:30克",
      "note": "换成焦糖风味，颜色偏浅棕。"
    }
  ],
  "variations": [
    "加一勺斑斓汁，颜色会转向淡绿。",
    "做成冰沙版，与冰块一起打成绵密口感。"
  ],
  "serving_suggestion": "冷饮配咖喱或椰浆饭最解辣，上桌时留一撮玫瑰花瓣点缀。",
  "storage": "冷藏不超过一天，饮用前摇匀，不要冷冻。",
  "nutrition_estimate": {
    "basis": "每份约260毫升",
