  "equipment": [
    "汤锅",
    "小碗",
    "木勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛤蜊放进清水里养两小时，水面撒一撮盐帮助吐沙，中途换一次水。",
      "time_min": 120,
      "heat": "无火",
      "tip": "水里放点盐，蛤蜊吐沙更彻底。",
      "visual_cue": "盆底可见细沙，水略浑"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油烧热，放大蒜和姜片中火炒四十秒，再下白胡椒炒二十秒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "白胡椒炒过才香，但要不停翻动防焦。",
      "visual_cue": "蒜姜边缘微黄，胡椒香冲鼻"
    },
    {
      "n": 3,
      "text": "沿锅边淋入米酒，加七百毫升清水，大火烧开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "酒沿锅边淋，香气才挥发得干净。",
      "visual_cue": "汤面翻滚，酒气散尽"
    },
    {
      "n": 4,
      "text": "倒入蛤蜊，加盖大火煮四分钟，煮到壳全部张开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "壳张开的就先捞，久煮肉会缩成小块。",
      "visual_cue": "蛤壳张开，汤汁转浅乳白"
    },
    {
      "n": 5,
      "text": "撇去表面浮沫，加盐调味，撒白胡椒粉再补一点辣味。",
      "time_min": 1,
      "heat": "中火",
      "tip": "盐最后加，蛤蜊本身的咸味要先算进去。",
      "visual_cue": "汤色清亮，表面浮少量油花"
    },
    {
      "n": 6,
      "text": "关火撒葱花和香菜段，挤入青柠汁，趁热分碗上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠最后挤，酸味才清新。",
      "visual_cue": "杯壁冒热气，汤面飘着翠绿葱段"
    }
  ],
  "tips": [
    "蛤蜊买回来先闻一下，有异味说明不新鲜。",
    "煮的时间宁短勿长，肉一老就嚼成渣。",
    "胡椒用现磨的，预磨粉香气已经散了大半。"
  ],
  "common_mistakes": [
    "蛤蜊不吐沙直接下锅，汤里满是细沙。",
    "开壳后继续猛煮，蛤肉缩成硬粒。",
    "盐放早了，蛤蜊一遇浓盐水就闭嘴不开。"
  ],
  "substitutions": [
    {
      "original": "蛤蜊",
      "substitute": "花蛤",
      "ratio": "900克:900克",
      "note": "肉质更饱满，吐沙时间可缩短到一小时。"
    },
    {
      "original": "米酒",
      "substitute": "白醋",
      "ratio": "20毫升:5毫升",
      "note": "去腥力度更直接，用量要减。"
    }
  ],
  "variations": [
    "加一小把枸杞同煮，汤色更暖，喝起来带一点回甘。",
    "喜欢浓味可放两片南姜一起煮，辛香更突出。"
  ],
  "serving_suggestion": "一人一碗，先喝汤再吃蛤肉，蘸一点青柠汁提鲜。",
  "storage": "当天喝完最好，冷藏不超过一天，复热只加热到微沸。",
