    "锅铲",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面条煮到八分熟，过凉水沥干。，火候要稳，别忽大忽小。",
      "time_min": 8,
      "heat": "大火",
      "tip": "别煮太软，回锅还要炒。，火候要稳，别忽大忽小。",
      "visual_cue": "面条弹牙，根根分明"
    },
    {
      "n": 2,
      "text": "锅热植物油，炒香蒜末、红葱头和小米辣。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中火",
      "tip": "红葱头炒到微黄才够香。，火候要稳，别忽大忽小。",
      "visual_cue": "洋葱金黄，油香浓郁"
    },
    {
      "n": 3,
      "text": "下虾仁炒到变色，盛出备用。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "中火",
      "tip": "虾先炒好，久炒会老。，火候要稳，别忽大忽小。",
      "visual_cue": "虾身卷曲，颜色转红"
    },
    {
      "n": 4,
      "text": "倒蛋液炒散，加番茄块炒出汁。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡蛋炒散不结块，口感才匀。，火候要稳，别忽大忽小。",
      "visual_cue": "蛋块松散，番茄出水"
    },
    {
      "n": 5,
      "text": "加番茄膏和生抽炒匀上色。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄膏炒一下，酸味才柔和。，火候要稳，别忽大忽小。",
      "visual_cue": "酱色红亮，香气升起"
    },
    {
      "n": 6,
      "text": "下面条大火快炒，让每条都裹上酱。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "大火",
      "tip": "用筷子抖散，别让面粘成团。，火候要稳，别忽大忽小。",
      "visual_cue": "面条红亮，根根分开"
    },
    {
      "n": 7,
      "text": "放豆芽和虾回锅，炒一分钟。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "大火",
      "tip": "豆芽最后放，才脆。，火候要稳，别忽大忽小。",
      "visual_cue": "豆芽断生，仍挺立，这一点很关键。"
    },
    {
      "n": 8,
      "text": "尝味补盐，挤青柠汁出锅。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠离火后挤，酸香才鲜。，火候要稳，别忽大忽小。",
      "visual_cue": "面身油亮，酸香扑鼻"
    }
  ],
  "tips": [
    "面条煮八分熟就够，回锅还要炒。，这一点很关键。",
    "大火快炒，面条才不粘锅。，这一点很关键。",
    "豆芽最后放，保持脆感。，这一点很关键。"
  ],
  "common_mistakes": [
    "面条煮太软，一炒就断。，这一点很关键。",
    "火不够大，面条粘成坨。，这一点很关键。",
    "番茄膏放太多，酸得发苦。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "面条",
      "substitute": "米粉",
      "ratio": "500 克:400 克",
      "note": "泡软后炒，吸收酱汁更快。"
    },
    {
      "original": "虾",
      "substitute": "鱿鱼",
      "ratio": "200 克:200 克",
      "note": "切圈快炒一分钟，口感更脆。"
    }
  ],
  "variations": [
    "加豆腐皮丝，口感更有层次。，这一点很关键。",
    "加一勺虾酱，风味更浓。，这一点很关键。"
  ],
  "serving_suggestion": "热吃，配青柠角和一小碟辣椒酱。，这一点很关键。",
  "storage": "冷藏一天，复炒须大火。，这一点很关键。",
