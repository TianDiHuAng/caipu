  "steps": [
    {
      "n": 1,
      "text": "鳕鱼切大块，用盐和鱼露略腌十分钟。，注意锅里温度别掉下来。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱼块别切小，煮时容易散。，始终中小火，别心急。",
      "visual_cue": "鱼块紧实，表面微亮"
    },
    {
      "n": 2,
      "text": "锅热植物油，炒香洋葱丝和蒜末。，火要均匀，食材才不糊。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味才出。，看住火，别让它失控。",
      "visual_cue": "洋葱软塌，油色发亮"
    },
    {
      "n": 3,
      "text": "下咖喱粉小火炒一分钟出香。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "小火",
      "tip": "咖喱粉一定要炒，生粉味才去掉。，火大了就离锅远一点。",
      "visual_cue": "油色金黄，香气冲鼻"
    },
    {
      "n": 4,
      "text": "放香茅、南姜和咖喱叶炒匀。，火别开太大，稳着来。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香茅拍扁才出味，别切太碎。，锅温要匀，别忽高忽低。",
      "visual_cue": "香气浓郁，叶片卷曲"
    },
    {
      "n": 5,
      "text": "加番茄块炒软，倒入清水煮开。，火力保持中等，慢慢来。",
      "time_min": 8,
      "heat": "大火",
      "tip": "番茄炒出汁，汤才够浓。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤面翻滚，颜色橙红"
    },
    {
      "n": 6,
      "text": "转小火倒椰奶，煮五分钟不沸腾。，注意锅里温度别掉下来。",
      "time_min": 7,
      "heat": "小火",
      "tip": "椰奶别大火滚，会油水分离。，始终中小火，别心急。",
      "visual_cue": "汤色乳黄，表面平滑"
    },
    {
      "n": 7,
      "text": "放鱼块小火煮八分钟，别翻动。，火要均匀，食材才不糊。",
      "time_min": 10,
      "heat": "小火",
      "tip": "一搅鱼就碎，汤会浑。，看住火，别让它失控。",
      "visual_cue": "鱼块发白，边缘微卷"
    },
    {
      "n": 8,
      "text": "尝味补盐和鱼露，盛碗上桌。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鱼露本身咸，盐最后少放。，火大了就离锅远一点。",
      "visual_cue": "汤浓挂勺，香气扑鼻"
    }
  ],
  "tips": [
    "咖喱粉要小火炒过，香气才出。，很多人在这里出错。",
    "椰奶下锅后别大火滚，容易分层。，这里最容易翻车。",
    "鱼块最后放，煮八分钟就够。，别小看这一步。"
  ],
  "common_mistakes": [
    "咖喱粉没炒，一股生粉味。，成败就在这一步。",
    "大火煮椰奶，汤面浮油渣。，这点要注意。",
    "鱼块煮太久，全碎在汤里。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "鱿鱼",
      "ratio": "700 克:700 克",
      "note": "煮三分钟即可，口感更脆。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "300 毫升:300 毫升",
      "note": "少了椰香，需多加咖喱粉五克。"
    }
  ],
  "variations": [
    "加秋葵同煮，汤汁更稠。，别嫌麻烦，做完它。",
    "配印度煎饼蘸汤，更地道。，这一步别省。"
  ],
  "serving_suggestion": "配白米饭或印度煎饼，汤别浪费。，别跳过这步。",
  "storage": "冷藏两天，复热须小火加热。，这步最关键。",
