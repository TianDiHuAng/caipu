  "equipment": [
    "汤锅",
    "电饭煲",
    "冰水盆",
    "刀",
    "砧板",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡内外抹十五克盐和白胡椒，腹腔塞入姜片与葱结，室温静置二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "鸡皮要抹到盐粒融化，这样煮出的皮才紧实有味。",
      "visual_cue": "鸡皮摸起来均匀发涩，腹腔塞满香料"
    },
    {
      "n": 2,
      "text": "汤锅加水烧到九十度，提着鸡身一侧把整鸡浸入水中三次，让腹腔内外温度均匀。",
      "time_min": 9,
      "heat": "中火",
      "tip": "三提三放能让鸡腔里的冷水流出，煮出的鸡肉内外一致。",
      "visual_cue": "水面微微冒泡，鸡身完全没入"
    },
    {
      "n": 3,
      "text": "保持水面将沸未沸的状态浸煮三十五分钟，用温度计测鸡身最厚处达七十五度。",
      "time_min": 37,
      "heat": "小火",
      "tip": "水绝不能滚沸，一滚鸡皮就破，肉也发柴。",
      "visual_cue": "水面只有小气泡缓慢上升，鸡皮完整"
    },
    {
      "n": 4,
      "text": "整鸡立刻投入冰水浸十分钟，取出沥干后刷一层香油，斩件装盘。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冰水骤冷让鸡皮收紧出胶，这是皮滑的关键一步。",
      "visual_cue": "鸡皮紧致透亮，皮下有一层薄胶"
    },
    {
      "n": 5,
      "text": "炒锅放植物油小火爆香蒜末，倒入香米翻炒两分钟至米粒透亮，移入电饭煲用鸡汤煮饭。",
      "time_min": 25,
      "heat": "中火",
      "tip": "米要用鸡油炒过再煮，饭才有那股标志性的香。",
      "visual_cue": "米粒泛着油光，颗颗分明"
    },
    {
      "n": 6,
      "text": "姜蓉拌盐与香油，辣椒酱挤青柠汁，生抽单独装碟，黄瓜切片垫盘，鸡汤盛碗撒葱花。",
      "time_min": 5,
      "heat": "无火",
      "tip": "姜蓉要磨得细，拌油后静置几分钟更香。",
      "visual_cue": "三碟蘸料颜色分明，鸡汤表面浮着金色油滴"
    }
  ],
  "tips": [
    "浸煮的水温维持在九十度上下，鸡皮才完整、肉质最嫩。",
    "煮鸡的汤不要倒，撇油后就是配汤，也可用来煮饭。",
    "斩鸡时刀刃贴着骨头走，鸡皮才不会拉破。"
  ],
  "common_mistakes": [
    "水大滚时下鸡，鸡皮煮破、腿肉收缩发硬。",
    "省掉冰水这步，鸡皮软塌没有弹性。",
    "米饭直接用清水煮，缺少鸡油的香气层次。"
  ],
  "substitutions": [
    {
      "original": "香米",
      "substitute": "长粒米",
      "ratio": "400 克:400 克",
      "note": "吸水量略高，鸡汤多加五十毫升。"
    },
    {
      "original": "辣椒酱",
      "substitute": "小米椒",
      "ratio": "50 克:30 克",
      "note": "切碎后加少许糖和醋调成蘸酱。"
    }
  ],
  "variations": [
    "把整鸡换成鸡腿肉，可做单人份的简化版本，浸煮时间缩短至十八分钟。"
  ],
  "serving_suggestion": "鸡件配鸡油饭、黄瓜片与三碟蘸料一起上桌。",
  "storage": "鸡肉冷藏两天，鸡汤冷冻一个月；复热时蒸比微波更能保持嫩度。",
