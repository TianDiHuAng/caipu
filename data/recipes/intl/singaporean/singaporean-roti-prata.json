  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 170,
          "unit": "ml",
          "note": "温水",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 80,
          "unit": "ml",
          "note": "起酥",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "可加",
          "optional": false
        },
        {
          "name": "咖喱粉",
          "name_en": "curry powder",
          "amount": 5,
          "unit": "g",
          "note": "佐食",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "平底锅",
    "油刷"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉过筛倒进大碗里，加盐与白糖先用筷子拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先把干料拌匀，再加水面团才均匀。",
      "visual_cue": "粉料洁白蓬松，无结块"
    },
    {
      "n": 2,
      "text": "把温水分几次倒入盆里，边倒边搅成絮状的面团。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水别一次倒完，面团软硬才好调。",
      "visual_cue": "面团成絮，盆底无干粉"
    },
    {
      "n": 3,
      "text": "揉面十分钟到表面光滑，再盖布醒三十分钟。",
      "time_min": 42,
      "heat": "无火",
      "tip": "醒够了面筋才松，后面才好擀得开。",
      "visual_cue": "面团光滑有弹性，按压回弹"
    },
    {
      "n": 4,
      "text": "把面团分成八份，每份抹油搓圆再醒一小时。",
      "time_min": 65,
      "heat": "无火",
      "tip": "表面抹一层油封住，面剂才不会干裂。",
      "visual_cue": "面剂油亮圆润，排成一列"
    },
    {
      "n": 5,
      "text": "取一个面剂按扁，用擀面杖擀成薄透的圆片状。",
      "time_min": 4,
      "heat": "无火",
      "tip": "擀得越薄，成品层次越多也越酥。",
      "visual_cue": "面片薄透，能隐约看到桌面"
    },
    {
      "n": 6,
      "text": "面片表面刷一层植物油，再从一边卷成长条。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油一定要刷得均匀，卷起来才有层次。",
      "visual_cue": "面片油光均匀，卷成紧实长条"
    },
    {
      "n": 7,
      "text": "长条盘成螺旋状把收口压住，再压扁醒十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "螺旋一定盘紧，煎出来才层层起酥。",
      "visual_cue": "螺旋纹清晰，饼坯圆整"
    },
    {
      "n": 8,
      "text": "平底锅烧热刷油，加蛋版先打散一个鸡蛋再放饼坯煎两分钟。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "鸡蛋先摊开铺底，饼皮才粘得住不滑。",
      "visual_cue": "鸡蛋在锅底摊开，饼坯压在上面"
    },
    {
      "n": 9,
      "text": "翻面再煎两分钟，用铲背轻轻压让层次散开。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "用铲背轻轻压几下，层次才松不粘连。",
      "visual_cue": "两面金黄，饼身蓬松起层"
    },
    {
      "n": 10,
      "text": "出锅前双手合拢把饼拍松，配咖喱或白糖上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拍松能让热气散开，层次更分明。",
      "visual_cue": "饼皮酥松，拍一下碎屑掉落"
    }
  ],
  "tips": [
    "面团要醒足，醒不够擀不开还回缩。",
    "面片擀得越薄，煎出的层次越多。",
    "锅要够热，饼才鼓得起来不吸油。"
  ],
  "common_mistakes": [
    "面团没醒够就擀，一擀就回缩成小块。",
    "锅不够热就下饼，吸一肚子油还发硬。",
    "卷的时候不卷紧，煎出来层次全散掉。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "高筋面粉",
      "ratio": "300 克:300 克",
      "note": "更筋道，需多醒二十分钟。"
    },
    {
      "original": "清水",
      "substitute": "牛奶",
      "ratio": "170 毫升:180 毫升",
      "note": "奶香更足，饼皮更软。"
    }
  ],
  "variations": [
    "饼皮里卷入一层咖喱土豆，吃起来更饱腹。",
    "撒一把洋葱碎卷进去，香气更冲。"
  ],
  "serving_suggestion": "撕成小块蘸咖喱汁，或撒白糖卷起来吃，配一杯拉茶最地道。",
  "storage": "现煎现吃最好，冷藏一天复热用干锅小火两面各烙一分钟。",
