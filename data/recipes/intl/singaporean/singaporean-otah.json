  "equipment": [
    "料理机",
    "蒸锅",
    "小碗",
    "锡纸",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲭鱼去皮去骨取鱼肉四百五十克左右，切小块后用厨房纸吸干表面水分。",
      "time_min": 15,
      "heat": "无火",
      "tip": "鱼皮和血合肉都去掉，腥味才干净。",
      "visual_cue": "鱼肉呈浅粉色，摸上去不发黏"
    },
    {
      "n": 2,
      "text": "红葱头、大蒜、南姜、香茅切碎，与小米辣和柠檬叶丝一起放进料理机打成细糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香料打细，鱼浆才均匀不出颗粒。",
      "visual_cue": "成为湿润的橙红色香料糊"
    },
    {
      "n": 3,
      "text": "鱼肉加盐和白糖先打成粗泥，再放入香料糊继续搅两分钟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐先下能让鱼肉出胶，蒸好才有弹性。",
      "visual_cue": "鱼泥抱团，刮刀上能挂住"
    },
    {
      "n": 4,
      "text": "倒入椰奶、鸡蛋和玉米淀粉，低速搅到完全融合，成为稠厚的鱼浆。",
      "time_min": 3,
      "heat": "无火",
      "tip": "椰奶分两次加，一次倒容易分离。",
      "visual_cue": "鱼浆泛着油光，挑起能缓慢滴落"
    },
    {
      "n": 5,
      "text": "小碗内壁刷植物油，填进鱼浆抹平表面，盖上锡纸封口。",
      "time_min": 3,
      "heat": "无火",
      "tip": "锡纸封紧，蒸汽不会滴进去冲淡味道。",
      "visual_cue": "表面平整，锡纸边缘压紧"
    },
    {
      "n": 6,
      "text": "蒸锅水开后放入，中火蒸十八分钟，关火焖两分钟再取出。",
      "time_min": 20,
      "heat": "中火",
      "tip": "全程中火，火太大鱼浆会起蜂窝。",
      "visual_cue": "鱼糕鼓起，竹签插入不粘"
    },
    {
      "n": 7,
      "text": "揭去锡纸稍放凉，倒扣脱模切厚片，配白饭一同上桌食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "放凉再切，片才齐整不散。",
      "visual_cue": "切面光滑，边缘带一圈浅棕色"
    }
  ],
  "tips": [
    "鱼浆摔打几次再入模，口感会更弹。",
    "没有锡纸可用香蕉叶包，香气更接近路边摊。",
    "香料糊要现打现用，放久了会出水，蒸出来容易散。"
  ],
  "common_mistakes": [
    "鱼泥打太久温度升高，成品发散不弹。",
    "蒸的时候火太旺，表面鼓起一层蜂窝孔。",
    "椰奶一次全倒进去，鱼浆分层搅不匀。"
  ],
  "substitutions": [
    {
      "original": "鲭鱼",
      "substitute": "石斑鱼",
      "ratio": "600克:600克",
      "note": "腥味更淡，香料可减两成。"
    },
    {
      "original": "南姜",
      "substitute": "姜",
      "ratio": "25克:20克",
      "note": "香气更尖，用量略少。"
    }
  ],
  "variations": [
    "用烤箱一百八十度烤二十分钟，表面会结一层焦香。",
    "加两片疯人果同蒸，酸香更有层次。"
  ],
  "serving_suggestion": "切厚片夹在烤面包里，配一杯拉茶，是最地道的新加坡下午茶。",
  "storage": "冷藏可放三天，冷冻一个月；复热用蒸锅五分钟或平底锅两面煎。",
