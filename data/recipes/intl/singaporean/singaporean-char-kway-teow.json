  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "河粉用手轻轻抖散，成条不结块，豆芽洗净沥干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "河粉别用刀切，抖散才不会断成一截截。",
      "visual_cue": "河粉根根分明，无粘连"
    },
    {
      "n": 2,
      "text": "生抽、鱼露、白糖与白胡椒放小碗调匀备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱汁提前调好，下锅时手不会乱。",
      "visual_cue": "酱汁棕亮，糖已化开"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟，下二十毫升植物油，倒入虾仁爆炒到卷曲变色。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅必须够热，这是锅气的全部来源。",
      "visual_cue": "虾仁卷曲，边缘泛红"
    },
    {
      "n": 4,
      "text": "把虾仁推到一边，下蒜末与小米辣炒二十秒出香。",
      "time_min": 1,
      "heat": "大火",
      "tip": "蒜末别久炒，焦了整锅带苦。",
      "visual_cue": "蒜末微黄，香气冲鼻"
    },
    {
      "n": 5,
      "text": "打入鸡蛋略凝后划散，与豆芽一起翻炒三十秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "鸡蛋半凝固时下河粉，最容易裹住。",
      "visual_cue": "蛋花松软，豆芽挺立"
    },
    {
      "n": 6,
      "text": "倒入河粉与调好的酱汁，用锅铲快速翻推四十秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "河粉别翻炒过头，推几下就够，否则会断。",
      "visual_cue": "河粉均匀上色，油亮"
    },
    {
      "n": 7,
      "text": "撒入剩余植物油沿锅边淋一圈，再快速颠锅十秒逼出焦香。",
      "time_min": 1,
      "heat": "大火",
      "tip": "最后那一勺油是焦香的关键，别省。",
      "visual_cue": "锅边起烟，河粉边缘微焦"
    },
    {
      "n": 8,
      "text": "关火立刻装盘，趁热上桌，放久了河粉会出水发软。",
      "time_min": 1,
      "heat": "无火",
      "tip": "炒粿条上桌要冒热气，凉了就失了性格。",
      "visual_cue": "盘中油亮，香气扑鼻"
    }
  ],
  "tips": [
    "河粉前一晚买好放冰箱，稍干爽更好炒不粘。",
    "火力全程最大，分次炒比一次堆满锅更好。",
    "没有血蛤可用虾仁替代，鲜味稍淡但更省事。"
  ],
  "common_mistakes": [
    "河粉没抖散直接下锅，粘成一大团。",
    "锅里堆太多一次炒，全部出水变成煮河粉。",
    "酱汁下太少，河粉发白没有颜色。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡胸肉丝",
      "ratio": "180 克:180 克",
      "note": "不吃海鲜时替换，需先滑炒至变色。"
    },
    {
      "original": "鱼露",
      "substitute": "生抽",
      "ratio": "10 毫升:12 毫升",
      "note": "咸度接近，少了发酵鲜味。"
    }
  ],
  "variations": [
    "加血蛤与腊肠，是新加坡老摊的经典组合。",
    "用米粉代替河粉，做成炒米粉口感更细。"
  ],
  "serving_suggestion": "装盘后配一碟辣椒酱和青柠角，加一杯冰镇甘蔗汁。",
  "storage": "现炒现吃风味最佳；冷藏一夜后须用大火快炒回热，别微波。",
