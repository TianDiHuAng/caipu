  "steps": [
    {
      "n": 1,
      "text": "虾去壳留头，虾壳虾头冲洗干净。，注意锅里温度别掉下来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "虾壳别扔，汤的鲜味全靠它。，始终中小火，别心急。",
      "visual_cue": "虾壳红亮，虾仁完整"
    },
    {
      "n": 2,
      "text": "锅热植物油，炒香蒜末、红葱头和虾米。，火要均匀，食材才不糊。",
      "time_min": 6,
      "heat": "中火",
      "tip": "虾米炒到起泡，鲜味才出来。，看住火，别让它失控。",
      "visual_cue": "香气浓烈，虾米微焦"
    },
    {
      "n": 3,
      "text": "下虾壳虾头炒到变红出油。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "中火",
      "tip": "压一压虾头，虾膏才出得来。，火大了就离锅远一点。",
      "visual_cue": "壳色深红，锅底红油"
    },
    {
      "n": 4,
      "text": "倒清水煮开，转小火熬半小时。，火别开太大，稳着来。",
      "time_min": 35,
      "heat": "小火",
      "tip": "小火慢熬，汤才够浓。，锅温要匀，别忽高忽低。",
      "visual_cue": "汤色橙红，香气扑鼻"
    },
    {
      "n": 5,
      "text": "滤网滤掉虾壳和渣，汤回锅。，火力保持中等，慢慢来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用细网滤两遍，汤才清。，火候宁小勿大，慢慢推进。",
      "visual_cue": "汤汁清亮，无残渣，这一步别省。"
    },
    {
      "n": 6,
      "text": "汤里加生抽、盐和白胡椒调味。，注意锅里温度别掉下来。",
      "time_min": 2,
      "heat": "小火",
      "tip": "白胡椒多放一点，才够味。，始终中小火，别心急。",
      "visual_cue": "汤味咸鲜，胡椒香浓"
    },
    {
      "n": 7,
      "text": "虾仁下汤煮两分钟，别煮老。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾一变色就捞，久了发硬。，看住火，别让它失控。",
      "visual_cue": "虾仁卷曲，颜色鲜红"
    },
    {
      "n": 8,
      "text": "面条过热水装碗，浇汤放虾和豆芽。，全程留意火候，别贪快。",
      "time_min": 5,
      "heat": "大火",
      "tip": "豆芽最后烫十秒，保持脆。，火大了就离锅远一点。",
      "visual_cue": "汤面油亮，配菜整齐"
    }
  ],
  "tips": [
    "虾壳虾头一定要炒过，汤才够鲜。，别跳过这步。",
    "小火熬半小时，汤色才橙红。，这步最关键。",
    "虾仁最后下，煮两分钟就够。，很多人在这里出错。"
  ],
  "common_mistakes": [
    "虾壳直接煮不炒，汤寡淡。，这里最容易翻车。",
    "大火熬汤，汤色发浑。，别小看这一步。",
    "虾仁煮五分钟，缩成小硬块。，成败就在这一步。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鱿鱼",
      "ratio": "600 克:600 克",
      "note": "鱿鱼圈烫一分钟即可。"
    },
    {
      "original": "面条",
      "substitute": "米粉",
      "ratio": "400 克:350 克",
      "note": "泡软后烫十秒，吸汤更快。"
    }
  ],
  "variations": [
    "加一勺辣椒油，汤更带劲。，这点要注意。",
    "配排骨同熬，汤底更厚。，这是关键点。"
  ],
  "serving_suggestion": "热汤配辣椒酱和青柠，撒胡椒粉。，别嫌麻烦，做完它。",
  "storage": "汤冷藏两天，面条现煮现吃。，这一步别省。",
