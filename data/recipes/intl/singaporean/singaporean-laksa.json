  "equipment": [
    "汤锅",
    "炒锅",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱、大蒜和香茅一起剁成细末，装碗备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "香茅只取根部三寸，叶片纤维太粗。",
      "visual_cue": "末料细匀，香气冲鼻"
    },
    {
      "n": 2,
      "text": "炒锅放植物油小火，下末料炒到香气散出、颜色微黄。",
      "time_min": 6,
      "heat": "小火",
      "tip": "火大了蒜末会发苦，必须慢慢炒香。",
      "visual_cue": "末料金黄，香气浓郁"
    },
    {
      "n": 3,
      "text": "加咖喱粉和姜黄粉继续小火翻炒两分钟，把粉炒熟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "咖喱粉要炒透，不然有生粉味发涩。",
      "visual_cue": "酱体油亮，颜色橙黄"
    },
    {
      "n": 4,
      "text": "倒入清水烧开转小火煮十分钟，让香料味融进汤里。",
      "time_min": 12,
      "heat": "小火",
      "tip": "煮的时间足够长，汤才够浓也够香。",
      "visual_cue": "汤色橙红，香料上浮"
    },
    {
      "n": 5,
      "text": "倒入椰浆和鱼露搅匀，小火加热到汤汁微微浓稠。",
      "time_min": 4,
      "heat": "小火",
      "tip": "椰浆不能大火滚，一滚就分层出油。",
      "visual_cue": "汤汁乳红，浓稠挂勺"
    },
    {
      "n": 6,
      "text": "另一锅水烧开，米粉烫一分半钟捞出，虾仁和豆芽分别烫熟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "米粉别烫过，一会儿还要浇热汤。",
      "visual_cue": "米粉柔软，虾仁卷曲"
    },
    {
      "n": 7,
      "text": "米粉装碗，摆上虾仁、豆芽和煮鸡蛋，浇上滚汤，撒小米辣并补盐。",
      "time_min": 5,
      "heat": "无火",
      "tip": "汤要滚烫浇上去，香气才被激出来。",
      "visual_cue": "汤面浮油，配料整齐"
    }
  ],
  "tips": [
    "香茅只取根部最嫩的一段，叶子的纤维太粗嚼不动。",
    "咖喱粉和姜黄粉要下锅炒透，才没有生粉的涩味。",
    "椰浆下锅后只能小火，滚开会分层出油。"
  ],
  "common_mistakes": [
    "火太大把蒜末炒焦，整锅汤发苦。",
    "米粉烫过了头，浇上热汤一夹就断。",
    "椰浆大火滚煮，汤面浮起一层油水分开。"
  ],
  "substitutions": [
    {
      "original": "米粉",
      "substitute": "油面",
      "ratio": "400 克:400 克",
      "note": "口感更弹，烫的时间缩短。"
    },
    {
      "original": "虾仁",
      "substitute": "鱼片",
      "ratio": "200 克:250 克",
      "note": "烫到变白即捞，别久煮。"
    }
  ],
  "variations": [
    "加几块油豆腐吸汤，口感更丰富。",
    "换成粗米粉并加血蚶，更接近新加坡本地做法。"
  ],
  "serving_suggestion": "滚烫的汤浇在米粉上，配一碟参巴辣酱，是新加坡小贩中心的招牌之一。",
  "storage": "汤底冷藏两天，复热小火化开不加椰浆；米粉现烫现吃，不建议隔夜。",
