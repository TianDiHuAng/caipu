  "steps": [
    {
      "n": 1,
      "text": "猪肉末加红葱头、蒜末和鸡蛋，顺一个方向搅。，火要均匀，食材才不糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "搅到起胶，肉卷才不散。，看住火，别让它失控。",
      "visual_cue": "肉馅黏稠，能拉丝，成败就在这一步。"
    },
    {
      "n": 2,
      "text": "加生抽、盐、白胡椒和桂皮粉拌匀。，全程留意火候，别贪快。",
      "time_min": 3,
      "heat": "无火",
      "tip": "桂皮碾碎再用，香气才匀。，火大了就离锅远一点。",
      "visual_cue": "馅料入味，颜色转深"
    },
    {
      "n": 3,
      "text": "豆腐皮剪成手掌大的片，擦去表面水。，火别开太大，稳着来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "皮太湿会破，太干会裂。，锅温要匀，别忽高忽低。",
      "visual_cue": "皮面干爽，边缘整齐"
    },
    {
      "n": 4,
      "text": "面粉加清水调成稠糊，用来封口。，火力保持中等，慢慢来。",
      "time_min": 2,
      "heat": "无火",
      "tip": "糊要稠，才粘得牢。，火候宁小勿大，慢慢推进。",
      "visual_cue": "糊体浓稠，无颗粒，这点要注意。"
    },
    {
      "n": 5,
      "text": "肉馅铺在皮上，卷紧成条。，注意锅里温度别掉下来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "卷紧实，切时才不散。，始终中小火，别心急。",
      "visual_cue": "卷条紧实，粗细均匀"
    },
    {
      "n": 6,
      "text": "接口抹面粉糊粘紧，两端也封住。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "两端一定要封，炸时肉汁会漏。，看住火，别让它失控。",
      "visual_cue": "接口封实，无裂缝，这是关键点。"
    },
    {
      "n": 7,
      "text": "水开后上锅蒸十分钟定型。，全程留意火候，别贪快。",
      "time_min": 12,
      "heat": "大火",
      "tip": "蒸过再炸，里面才熟透。，火大了就离锅远一点。",
      "visual_cue": "卷身硬实，表面微亮"
    },
    {
      "n": 8,
      "text": "锅中倒植物油烧到一百七十度，下卷炸四分钟。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蒸过的卷表面有水，下锅前擦干。，锅温要匀，别忽高忽低。",
      "visual_cue": "外皮金黄，浮起起泡"
    },
    {
      "n": 9,
      "text": "捞出沥油，稍凉后切段装盘。，火力保持中等，慢慢来。",
      "time_min": 5,
      "heat": "无火",
      "tip": "放两分钟再切，切面才整齐。，火候宁小勿大，慢慢推进。",
      "visual_cue": "切面紧实，肉馅不散"
    }
  ],
  "tips": [
    "肉馅搅到起胶，卷才不散。，别嫌麻烦，做完它。",
    "先蒸后炸，里面才熟透。，这一步别省。",
    "下锅前擦干表面，避免溅油。，别跳过这步。"
  ],
  "common_mistakes": [
    "肉馅太稀，卷不住。，这步最关键。",
    "皮没封好，炸时全爆开。，很多人在这里出错。",
    "油温太高，外皮焦里面生。，这里最容易翻车。"
  ],
  "substitutions": [
    {
      "original": "豆腐皮",
      "substitute": "春卷皮",
      "ratio": "6 张:8 张",
      "note": "更薄脆，蒸的时间缩短三分钟。"
    },
    {
      "original": "猪肉末",
      "substitute": "鸡胸肉末",
      "ratio": "500 克:500 克",
      "note": "更瘦，需多加一勺植物油。"
    }
  ],
  "variations": [
    "馅里加荸荠碎，口感更脆。，别小看这一步。",
    "配甜辣酱蘸食，酸甜解腻。，成败就在这一步。"
  ],
  "serving_suggestion": "切片拼盘，配辣椒酱和黄瓜。，这点要注意。",
  "storage": "生坯冷冻一个月，现炸现吃。，这是关键点。",
