  "flavor": [
    "sweet",
    "light",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "薏米",
          "name_en": "job's tears",
          "amount": 270,
          "unit": "g",
          "note": "提前泡发",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 70,
          "unit": "g",
          "note": "调节甜度",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1800,
          "unit": "ml",
          "note": "煮制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "滤网",
    "玻璃壶"
  ],
  "steps": [
    {
      "n": 1,
      "text": "薏米用清水淘洗两遍，再泡三十分钟让它吸足水分。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡过再煮，薏米才容易开花。",
      "visual_cue": "薏米颗粒变大，手感变软"
    },
    {
      "n": 2,
      "text": "泡好的薏米倒进汤锅里面，加足清水后用大火烧开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水一次加够，中途加会变淡。",
      "visual_cue": "水面翻滚，米粒上下翻动"
    },
    {
      "n": 3,
      "text": "烧开后转小火煮三十五分钟，煮到薏米开花变软。",
      "time_min": 35,
      "heat": "小火",
      "tip": "小火慢煮，汤才清不浑。",
      "visual_cue": "薏米裂开，边缘呈透明状"
    },
    {
      "n": 4,
      "text": "加白糖搅到完全融化，再小火煮两分钟让甜味渗入。",
      "time_min": 2,
      "heat": "小火",
      "tip": "糖后放，汤色才不发暗。",
      "visual_cue": "汤水微甜，颜色浅乳白"
    },
    {
      "n": 5,
      "text": "关火盖盖焖十分钟，让薏米的香气充分释出。",
      "time_min": 10,
      "heat": "无火",
      "tip": "焖一下汤味更浓。",
      "visual_cue": "汤色略浑，米香明显"
    },
    {
      "n": 6,
      "text": "用滤网滤出汤汁倒进玻璃壶，薏米可以留少量一起喝。",
      "time_min": 4,
      "heat": "无火",
      "tip": "留一点米粒，喝起来更有口感。",
      "visual_cue": "汤水清亮，能看到少量米粒"
    },
    {
      "n": 7,
      "text": "放凉后连壶一起冷藏两小时，冰镇之后饮用更清爽。",
      "time_min": 120,
      "heat": "无火",
      "tip": "冰镇后甜味更柔。",
      "visual_cue": "饮子冰凉，杯壁结水雾"
    },
    {
      "n": 8,
      "text": "倒杯时加冰块，喜欢甜可再加少量糖水调匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冰块别加太多，会冲淡味道。",
      "visual_cue": "杯中有冰，汤色浅白"
    }
  ],
  "tips": [
    "薏米先泡半小时，煮起来更容易开花。",
    "水一次加足，中途加水汤就变淡了。",
    "关火焖十分钟，香气比一直煮更足。"
  ],
  "common_mistakes": [
    "薏米不泡直接煮，煮很久还是硬粒。",
    "一直大火滚煮，汤浑且容易糊底。",
    "糖放太早，汤色发暗还容易溢锅。"
  ],
  "substitutions": [
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "70 克:80 克",
      "note": "甜味更绵，汤色更清亮。"
    },
    {
      "original": "薏米",
      "substitute": "红豆",
      "ratio": "160 克:160 克",
      "note": "口感更绵，煮制时间加十分钟。"
    }
  ],
  "variations": [
    "加两片柠檬同煮，酸甜味更清爽。",
    "加少量腐竹同煮，口感会更滑润。"
  ],
  "serving_suggestion": "冰镇后倒入玻璃杯，配辣味小吃最解腻。",
  "storage": "冷藏三天内喝完，密封保存避免串味。",
