  "steps": [
    {
      "n": 1,
      "text": "茄子切滚刀块，泡冷水五分钟去涩。，注意别烧干，成品才稳当。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡水去涩，颜色才不发黑。，慢慢来别急，口感才不发柴。",
      "visual_cue": "块形均匀，切口发白，汤汁别收太干，香气才留得住。"
    },
    {
      "n": 2,
      "text": "捞出沥干，用厨房纸吸掉水分。，保持中小火，味道才不闷。",
      "time_min": 4,
      "heat": "无火",
      "tip": "吸干水，煎时才不溅油。，慢慢来别急，成品才好看。",
      "visual_cue": "表面干爽，手感轻，动作放连贯，口感才不发柴。"
    },
    {
      "n": 3,
      "text": "碗里调味噌、白糖、清酒和姜泥。，手法轻些，成品才稳当。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调匀，下锅才不会结块。，火别太大，成品才好看。",
      "visual_cue": "酱体顺滑，颜色褐亮，份量心里有数，成品才好看。"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，中火煎茄子到软。，时间掐准，颜色才够亮。",
      "time_min": 8,
      "heat": "中火",
      "tip": "皮朝下先煎，颜色才亮。，份量心里有数，锅气才足。",
      "visual_cue": "茄子软塌，皮色紫亮，起锅前尝味，成品才好看。"
    },
    {
      "n": 5,
      "text": "倒出多余油，淋香油再翻两下。，翻动放轻，成品才稳当。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香油后加，香气才不跑。，别急着加油，香气才不跑。",
      "visual_cue": "油光浮动，香气清雅，手法轻些，口感才不发柴。"
    },
    {
      "n": 6,
      "text": "转小火，倒入味噌酱快速翻匀。，料别一次下太多，细节才到位。",
      "time_min": 4,
      "heat": "小火",
      "tip": "味噌易糊，动作要快。，手法轻些，整道菜才立得住。",
      "visual_cue": "每块挂酱，颜色深褐，慢慢来别急，锅气才足。"
    },
    {
      "n": 7,
      "text": "加两勺清水，翻匀收汁一分钟。，锅温要匀，咸淡才好把握。",
      "time_min": 3,
      "heat": "小火",
      "tip": "加一点水，酱才裹得匀。，汤汁别收太干，口感才不发柴。",
      "visual_cue": "酱汁浓稠，锅底发亮，火别太大，香气才不跑。"
    },
    {
      "n": 8,
      "text": "装盘撒芝麻和小葱末。，先试试温度，味道才不闷。，慢慢来别急，成品才稳当。",
      "time_min": 3,
      "heat": "无火",
      "tip": "芝麻最后撒，香气才足。，先试试温度，食材才不糊。",
      "visual_cue": "配色清爽，油亮诱人，起锅前尝味，成品才稳当。"
    }
  ],
  "tips": [
    "茄子先泡水，颜色才不发黑。，别急着加油，颜色才够亮。",
    "味噌下锅要小火，糊了会苦。，先试试温度，香气才留得住。",
    "最后加一点水，酱才裹得匀。，锅温要匀，成品才稳当。"
  ],
  "common_mistakes": [
    "茄子没吸干水，煎时溅油。，翻动放轻，味道才不闷。",
    "味噌火大炒糊，整锅发苦。，动作放连贯，锅气才足。",
    "酱太稠，茄子裹不均。，别用力搅，口感才不发柴。"
  ],
  "substitutions": [
    {
      "original": "味噌",
      "substitute": "黄豆酱",
      "ratio": "60 克:50 克",
      "note": "咸味更重，白糖可加五克。"
    },
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "800 克:800 克",
      "note": "口感更脆，煎制时间减两分钟。"
    }
  ],
  "variations": [
    "加肉末同炒，做成下饭菜。，别急着加油，味道才进得去。",
    "撒辣椒粉，辣味更冲。，盖盖焖一会儿，味道才进得去。"
  ],
  "serving_suggestion": "配白米饭，趁热吃。，锅温要匀，风味才干净。",
  "storage": "冷藏两天，复热用炒锅。，动作放连贯，吃口才舒服。",
