    "汤勺",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "昆布用清水泡半小时，泡出鲜味后连水一起备用，不要丢掉泡昆布的水。",
      "time_min": 30,
      "heat": "无火",
      "tip": "昆布表面的白霜是鲜味来源，别用水搓洗掉。",
      "visual_cue": "昆布变软，水色微黄，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "五花肉切薄片，白萝卜和胡萝卜切薄片，豆腐切成两厘米见方的小块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "萝卜切薄，煮十分钟就软，厚块要等很久，火候和顺序都要留神。",
      "visual_cue": "切片薄而匀，豆腐齐整，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "汤锅倒芝麻油烧热，下五花肉片中火煸三分钟，煸到肉片出油变白。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉先煸过汤才香，也去掉一部分油腻，提前把配料备好再动手更稳。",
      "visual_cue": "肉片变白卷边，锅中浮油，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "倒入昆布和泡昆布的水，加清水烧开，撇掉表面的浮沫。",
      "time_min": 8,
      "heat": "大火",
      "tip": "浮沫撇干净，汤色才清亮不带腥，这一步千万别省。",
      "visual_cue": "汤面清亮，浮沫撇净，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "下白萝卜和胡萝卜，转中小火煮十分钟，煮到萝卜片能被筷子轻松戳透。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "萝卜要煮到透明才甜，硬着出锅就白煮了，火候和顺序都要留神。",
      "visual_cue": "萝卜透亮，筷子可穿，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "关火，把味噌放进汤勺里用汤慢慢化开再倒回锅里，放豆腐小火加热两分钟，起锅前撒一把小葱葱花提香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "味噌化开再入锅，不结块也不会煮过头，提前把配料备好再动手更稳。",
      "visual_cue": "汤色乳褐，豆腐浮起，颜色和形态变化明显"
    }
  ],
  "tips": [
    "味噌一定要关火后再化开，煮滚了香味会跑掉，还会结块发苦。",
    "白萝卜切薄片比块状更快入味，煮十分钟就能软透。",
    "昆布提前泡半小时，冷泡出的鲜味比直接下锅煮更干净。"
  ],
  "common_mistakes": [
    "味噌和汤一起大火煮，出锅时香气寡淡，汤色发暗还有颗粒。",
    "五花肉不煸直接下汤，浮沫多且汤面一层油，喝起来腻口。",
    "萝卜切得太厚，煮二十分钟中心还是硬的，和汤完全两个味道。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "鸡腿肉",
      "ratio": "200克:200克",
      "note": "鸡肉版汤更清爽，可少放十克味噌。"
    },
    {
      "original": "味噌",
      "substitute": "豆瓣酱",
      "ratio": "60克:40克",
      "note": "咸辣风味，用量需减半，适合重口。"
    }
  ],
  "variations": [
    "加两片柚子皮同煮，汤里带一点柑橘清香，冬天喝很舒服。",
    "把萝卜换成南瓜和洋葱，甜味更足，做成偏甜口的家庭版。"
  ],
  "serving_suggestion": "盛进汤碗，撒一把葱花趁热喝，配一碗白米饭和一小碟腌菜就是日式早餐。",
  "storage": "冷藏可放一天，回热时小火加热到微沸即可，味噌不宜反复煮滚。",
