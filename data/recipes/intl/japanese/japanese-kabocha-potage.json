  "equipment": [
    "汤锅",
    "搅拌机",
    "削皮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜去皮去瓤，切成三厘米见方的块，洋葱剥皮切成细丝备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "块切小才煮得快，瓤一定刮干净不带丝，这一步千万别省。",
      "visual_cue": "南瓜块齐整，洋葱丝均匀，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "汤锅放黄油小火化开，下洋葱丝炒八分钟，炒到变软透明散发甜香。",
      "time_min": 9,
      "heat": "小火",
      "tip": "小火慢炒出甜，火大只会焦苦，火候和顺序都要留神。",
      "visual_cue": "洋葱透明软塌，锅底微黄，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "倒入南瓜块翻炒两分钟，加清水没过南瓜，加盖中火煮十五分钟至软烂。",
      "time_min": 18,
      "heat": "中火",
      "tip": "南瓜煮到筷子一插就透，打出来才细，提前把配料备好再动手更稳。",
      "visual_cue": "南瓜酥烂，汤汁橙黄，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "连汤带料倒进搅拌机，高速打两分钟至完全顺滑，无颗粒感。",
      "time_min": 3,
      "heat": "无火",
      "tip": "分两次打更细，热汤打时盖子留缝排气，这一步千万别省。",
      "visual_cue": "汤体细腻，看不到纤维，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "打好的汤倒回锅中，加牛奶和盐小火加热三分钟，边加热边搅动。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢热，牛奶一滚就结絮，火候和顺序都要留神。",
      "visual_cue": "汤面微冒气，搅动顺滑，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "盛入汤碗，沿碗边淋一圈淡奶油，撒现磨黑胡椒，趁热端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "淡奶油沿碗边淋，纹路才好看，提前把配料备好再动手更稳。",
      "visual_cue": "奶白纹路，汤色暖黄，颜色和形态变化明显"
    }
  ],
  "tips": [
    "南瓜切小块再煮，二十分钟就能透，省时也更容易打细。",
    "洋葱要用黄油小火炒到透明发甜，这是浓汤甜味的底子。",
    "打好的汤回锅时用小火，一开大滚牛奶容易析出絮状。"
  ],
  "common_mistakes": [
    "南瓜瓤里的纤维没刮净，打出来的汤带粗丝，喝着卡喉咙。",
    "汤打得太稠直接上桌，凉一点就结块，舀起来像糊。",
    "牛奶和汤一起大火煮开，蛋白质凝结成小颗粒，汤面起豆腐渣。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰浆",
      "ratio": "300毫升:250毫升",
      "note": "椰香更浓，整体偏甜，盐可略加。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "30克:25毫升",
      "note": "奶香变淡，可加一勺淡奶油补回。"
    }
  ],
  "variations": [
    "加一小块咖喱块同煮，做成南瓜咖喱汤，辛香压过甜味。",
    "撒一把烤过的南瓜籽，增加脆感和坚果香。"
  ],
  "serving_suggestion": "装碗后淋一圈淡奶油，撒黑胡椒，配烤面包片或三明治一起吃。",
  "storage": "冷藏可放两天，回热须小火边加热边搅，冷冻后质地会变粗不建议冷冻。",
