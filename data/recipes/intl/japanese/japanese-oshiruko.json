    "total_min": 81
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "rich",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "红豆",
          "name_en": "adzuki bean",
          "amount": 250,
          "unit": "g",
          "note": "泡发煮软",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 120,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 80,
          "unit": "g",
          "note": "做团子",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1200,
          "unit": "ml",
          "note": "煮豆",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "木勺",
    "碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆挑掉坏豆，用清水冲洗两遍后浸泡两小时以上。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡到豆皮起皱、指甲能轻松掐开才算够。",
      "visual_cue": "红豆饱满，豆皮起皱"
    },
    {
      "n": 2,
      "text": "红豆连水倒进汤锅，大火烧开后转小火煮三十分钟。",
      "time_min": 30,
      "heat": "小火",
      "tip": "煮的过程中泡沫要撇掉，汤才不浑不涩。",
      "visual_cue": "汤色深红，豆子鼓起"
    },
    {
      "n": 3,
      "text": "用木勺背把豆子压碎一部分，保留少许完整豆粒。",
      "time_min": 5,
      "heat": "小火",
      "tip": "压碎一半就够，全压成泥会失去颗粒感。",
      "visual_cue": "豆沙浓稠，仍见豆粒"
    },
    {
      "n": 4,
      "text": "加白糖和盐，小火边搅边煮十分钟到糖完全化开。",
      "time_min": 10,
      "heat": "小火",
      "tip": "糖后放豆子才容易煮软，盐只为提甜。",
      "visual_cue": "汤稠挂勺，颜色暗红"
    },
    {
      "n": 5,
      "text": "糯米粉加温水揉成不粘手的面团，搓成小圆团子备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面团揉到耳垂软度，搓出的团子才不裂。",
      "visual_cue": "面团光滑，团子圆润"
    },
    {
      "n": 6,
      "text": "另起锅烧水，下团子煮到浮起后再煮两分钟捞出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "团子浮起后多煮两分钟，中心才不生硬。",
      "visual_cue": "团子浮面，质地半透明"
    },
    {
      "n": 7,
      "text": "把热红豆汤盛进碗里，放入团子，趁热上桌食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "团子现煮现放，泡久了会散开化在汤里。",
      "visual_cue": "汤面冒热气，团子雪白"
    }
  ],
  "tips": [
    "红豆泡足两小时，煮起来才容易软烂。",
    "白糖要后放，豆子才不会被糖封住煮不透。",
    "团子现煮现放，泡久了会散开化在汤里。"
  ],
  "common_mistakes": [
    "红豆不泡直接煮，煮两小时还有硬芯。",
    "一开始就加糖，豆皮发硬怎么煮都不烂。",
    "团子煮好放汤里久泡，最后全化成糊。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "红豆沙",
      "ratio": "250 克:300 克",
      "note": "直接省去煮豆步骤，糖减至六十克。"
    },
    {
      "original": "糯米粉",
      "substitute": "年糕",
      "ratio": "80 克:150 克",
      "note": "切块烤软后放入，口感更弹。"
    }
  ],
  "variations": [
    "汤里多放二十克白糖，甜味更厚更浓。",
    "团子里加一小勺白糖，口感更软糯。"
  ],
  "serving_suggestion": "盛在粗陶碗里趁热吃，配一杯热茶解甜。",
  "storage": "冷藏两天，红豆汤可冷冻一个月，团子须现做。",
