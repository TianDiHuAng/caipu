  "steps": [
    {
      "n": 1,
      "text": "红豆沙分成十二份，每份二十克搓圆，放冰箱冷藏定型。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆沙先冷藏才好包，软的一按就散。",
      "visual_cue": "豆沙球大小一致，表面光滑"
    },
    {
      "n": 2,
      "text": "面粉、泡打粉、白砂糖与盐混匀，加牛奶和植物油揉成柔软面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面团别揉太久，出筋后蒸出来发硬。",
      "visual_cue": "面团光滑柔软，按压有弹性"
    },
    {
      "n": 3,
      "text": "面团分成十二份擀成圆片，包入豆沙球收口捏紧，收口朝下搓圆。",
      "time_min": 15,
      "heat": "无火",
      "tip": "皮要中间厚边缘薄，收口才不会露馅。",
      "visual_cue": "馒头坯圆润饱满，收口处平整"
    },
    {
      "n": 4,
      "text": "蒸屉铺湿布，馒头坯间隔摆好，表面薄薄刷一层蛋液。",
      "time_min": 5,
      "heat": "无火",
      "tip": "留出膨胀空间，蒸完才不会粘在一起。",
      "visual_cue": "表面油亮，坯体间距均匀"
    },
    {
      "n": 5,
      "text": "水开后中火蒸十二分钟，关火焖三分钟再开盖取出。",
      "time_min": 17,
      "heat": "中火",
      "tip": "关火马上开盖会塌陷，焖三分钟让温度缓降。",
      "visual_cue": "表皮白亮微透，按下去能回弹"
    }
  ],
  "tips": [
    "豆沙先冷藏定型，包的时候不粘手也不散。",
    "面团揉到光滑就停，揉过头蒸出来发硬。",
    "关火焖三分钟再开盖，馒头才不会塌。",
    "表面刷蛋液蒸后更有光泽，卖相接近店里。"
  ],
  "common_mistakes": [
    "豆沙太软没冷藏就包，一按就散开露馅。",
    "面团反复揉搓，蒸出来又硬又韧像馒头块。",
    "水开后立刻开盖，馒头遇冷空气瞬间回缩塌陷。",
    "蒸屉不铺布也不刷油，成品全粘在篦子上。"
  ],
  "substitutions": [
    {
      "original": "红豆沙",
      "substitute": "白豆沙",
      "ratio": "240克:240克",
      "note": "甜度更淡，糖可减十克。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "90毫升:85毫升",
      "note": "奶香消失，口感更清爽。"
    }
  ],
  "variations": [
    "面团里加一小勺抹茶粉，做成绿色馒头。",
    "表面点一颗黑芝麻，卖相更精致。",
    "豆沙里拌入几粒栗子丁，口感更有层次。"
  ],
  "serving_suggestion": "配一杯煎茶或抹茶，馒头温热时吃最软，作为下午茶点心或节日伴手礼都合适。",
  "storage": "常温密封可放一天，冷藏两天，复热用蒸锅大火蒸五分钟恢复柔软。",
