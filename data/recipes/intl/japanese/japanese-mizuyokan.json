          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小锅",
    "模具",
    "筛子",
    "打蛋器",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "琼脂用冷水泡十分钟，捞出挤干水。，火候要稳，别忽大忽小。",
      "time_min": 12,
      "heat": "无火",
      "tip": "琼脂泡软才化得干净。，火候要稳，别忽大忽小。",
      "visual_cue": "琼脂变软，透明发胀"
    },
    {
      "n": 2,
      "text": "小锅倒清水，放琼脂小火煮到完全化开。，火候要稳，别忽大忽小。",
      "time_min": 7,
      "heat": "小火",
      "tip": "煮到看不见颗粒，溶液才清。，火候要稳，别忽大忽小。",
      "visual_cue": "液体透明，无絮状物"
    },
    {
      "n": 3,
      "text": "加白糖和盐，搅到糖完全溶解。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖化开再下豆沙，才不起疙瘩。，火候要稳，别忽大忽小。",
      "visual_cue": "液体清亮，微有黏性"
    },
    {
      "n": 4,
      "text": "红豆沙用筛子过一遍，去掉粗粒。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛一次，口感才细滑。，火候要稳，别忽大忽小。",
      "visual_cue": "豆沙细腻，无颗粒，这一点很关键。"
    },
    {
      "n": 5,
      "text": "把豆沙分次加进琼脂液，边加边搅匀。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "小火",
      "tip": "分次加，豆沙才不结块。，火候要稳，别忽大忽小。",
      "visual_cue": "颜色均匀，质地顺滑"
    },
    {
      "n": 6,
      "text": "小火加热到微微冒泡，别让它滚起来。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "小火",
      "tip": "一滚就起泡，成品会有孔洞。，火候要稳，别忽大忽小。",
      "visual_cue": "表面微沸，气泡细小"
    },
    {
      "n": 7,
      "text": "倒进模具，室温放凉后冷藏两小时。，火候要稳，别忽大忽小。",
      "time_min": 122,
      "heat": "无火",
      "tip": "自然放凉再冷藏，才不会分层。，火候要稳，别忽大忽小。",
      "visual_cue": "表面平整，微微颤动"
    },
    {
      "n": 8,
      "text": "脱模切块，配一小杯绿茶上桌。，火候要稳，别忽大忽小。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刀蘸热水切，切口才平整。，火候要稳，别忽大忽小。",
      "visual_cue": "切面光滑，颜色深红"
    }
  ],
  "tips": [
    "琼脂要煮到完全化开，否则成品发脆。",
    "豆沙过筛一次，口感才细腻。，这一点很关键。",
    "别煮滚，起泡会有孔洞。，这一点很关键。"
  ],
  "common_mistakes": [
    "琼脂没化开，成品一夹就碎。，这一点很关键。",
    "煮滚起泡，切面全是小孔。，这一点很关键。",
    "冷藏前没放凉，豆沙沉底分层。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "红豆沙",
      "substitute": "绿豆沙",
      "ratio": "300 克:300 克",
      "note": "颜色更浅，甜度可减十克。"
    },
    {
      "original": "琼脂",
      "substitute": "吉利丁",
      "ratio": "6 克:8 克",
      "note": "需冷藏四小时以上。"
    }
  ],
  "variations": [
    "加一点抹茶粉，做成抹茶口味。，这一点很关键。",
    "加栗子碎，口感更有层次。，这一点很关键。"
  ],
  "serving_suggestion": "切小块配绿茶，夏天冰镇更好。，这一点很关键。",
  "storage": "冷藏三天，密封防干。，这一点很关键。",
