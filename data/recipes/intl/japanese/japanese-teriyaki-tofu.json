  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 400,
          "unit": "g",
          "note": "老豆腐，压去水分",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切圈",
          "optional": false
        },
        {
          "name": "白萝卜",
          "name_en": "daikon radish",
          "amount": 60,
          "unit": "g",
          "note": "擦泥配盘",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "浓口酱油",
          "name_en": "dark soy sauce (koikuchi)",
          "amount": 40,
          "unit": "ml",
          "note": "照烧汁",
          "optional": false
        },
        {
          "name": "味醂",
          "name_en": "mirin",
          "amount": 30,
          "unit": "ml",
          "note": "增亮增甜",
          "optional": false
        },
        {
          "name": "清酒",
          "name_en": "sake",
          "amount": 20,
          "unit": "ml",
          "note": "去豆味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 8,
          "unit": "g",
          "note": "帮助上色",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 15,
          "unit": "g",
          "note": "薄薄拍一层",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "厨房纸",
    "小碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐用厨房纸包好，上面压重物静置二十分钟出水。",
      "time_min": 22,
      "heat": "无火",
      "tip": "水分压不干，下锅只会出水煮软，煎不香。",
      "visual_cue": "豆腐明显变薄变实，纸面湿透"
    },
    {
      "n": 2,
      "text": "日式酱油、味醂、清酒与白糖调匀成照烧汁备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要搅到基本溶化，不然锅底容易糊。",
      "visual_cue": "汁液深褐透亮，碗底没有糖粒"
    },
    {
      "n": 3,
      "text": "豆腐切成两厘米厚的方块，两面薄薄拍一层面粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄薄一层就足够，太厚会糊成一层面壳。",
      "visual_cue": "豆腐表面均匀泛白，不见干粉堆"
    },
    {
      "n": 4,
      "text": "平底锅中火少油，豆腐下锅煎到一面金黄定型。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅以后别急着翻，等边缘收紧再动锅铲。",
      "visual_cue": "底面金黄结壳，边缘微微收缩"
    },
    {
      "n": 5,
      "text": "翻面再煎三分钟，两面都煎出薄脆的金黄外壳。",
      "time_min": 4,
      "heat": "中火",
      "tip": "两面都煎到才有外脆里嫩的口感对比。",
      "visual_cue": "两面颜色一致，表面干爽不油"
    },
    {
      "n": 6,
      "text": "倒入照烧汁，小火边煮边把汁淋在豆腐上收浓。",
      "time_min": 5,
      "heat": "小火",
      "tip": "只淋不翻，豆腐才不会散；汁浓到挂住即可。",
      "visual_cue": "汁收成亮褐糖浆，紧紧裹住豆腐"
    },
    {
      "n": 7,
      "text": "盛盘以后配上白萝卜泥，撒上小葱圈趁热食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "白萝卜泥解腻，也能中和照烧汁的甜。",
      "visual_cue": "豆腐表面油亮，葱花翠绿点缀"
    }
  ],
  "tips": [
    "要用老豆腐，嫩豆腐一下锅就散。",
    "压出的水可以留着煮汤，别浪费。",
    "照烧汁收浓后立刻关火，糖分容易糊锅。",
    "表面撒一点白芝麻，香气更立体。"
  ],
  "common_mistakes": [
    "豆腐没压水直接下锅，煎出一滩水变成煮豆腐。",
    "照烧汁用大火收干，糖焦了整锅都发苦。",
    "用翻炒代替淋汁，豆腐全碎成了小块。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "香菇",
      "ratio": "400克:300克",
      "note": "菌菇版，煎的时间缩短两分钟。"
    },
    {
      "original": "清酒",
      "substitute": "清水",
      "ratio": "20毫升:20毫升",
      "note": "少了酒香，可加两片姜。"
    }
  ],
  "variations": [
    "表面撒一层木鱼花，热气会让它轻轻摆动。",
    "照烧汁里加一点姜泥，辛辣感更解腻。"
  ],
  "serving_suggestion": "配白米饭和一碗味噌汤，摆上萝卜泥就是一份日式定食。",
  "storage": "冷藏一天，复热用平底锅小火两面各煎一分钟。",
