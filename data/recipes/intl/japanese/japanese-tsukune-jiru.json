      ]
    }
  ],
  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "小勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去皮后切成小块，用刀反复剁成细腻的鸡肉泥，装进大碗备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "剁比绞更弹，鸡肉泥里留一点细颗粒口感更好。",
      "visual_cue": "鸡肉泥细腻带黏性，颜色粉白均匀"
    },
    {
      "n": 2,
      "text": "鸡肉泥里加蛋液、大葱末、姜泥、一半生抽与白糖，顺一个方向搅到起胶。",
      "time_min": 5,
      "heat": "无火",
      "tip": "搅到鸡肉糊黏住勺子再停手，丸子才不散。",
      "visual_cue": "鸡肉糊抱团发亮，挑起呈拉丝状"
    },
    {
      "n": 3,
      "text": "双手蘸一点清水，把鸡肉糊挤成乒乓球大小的丸子，逐个摆在盘中。",
      "time_min": 6,
      "heat": "无火",
      "tip": "手蘸水再挤，鸡肉糊不粘手，丸子表面也光滑。",
      "visual_cue": "丸子大小一致，表面圆润无裂口"
    },
    {
      "n": 4,
      "text": "汤锅倒入高汤，中火烧到锅边冒小泡，把丸子沿锅边轻轻滑入。",
      "time_min": 5,
      "heat": "中火",
      "tip": "汤别滚沸再下丸子，剧烈翻滚会把丸子打散。",
      "visual_cue": "丸子沉底后慢慢浮起，汤面微滚"
    },
    {
      "n": 5,
      "text": "撇掉汤面的浮沫，转小火煮八分钟，再放香菇片与剩下的生抽、盐。",
      "time_min": 8,
      "heat": "小火",
      "tip": "浮沫撇干净汤才清，拖久了汤色发浑带腥。",
      "visual_cue": "汤色清亮，丸子浮起饱满"
    },
    {
      "n": 6,
      "text": "加清酒与味醂再煮两分钟关火，连汤带丸盛进碗里即可上桌。",
      "time_min": 2,
      "heat": "小火",
      "tip": "酒类最后加，香气才留得住不被煮飞。",
      "visual_cue": "汤面泛着油花，飘出淡淡酒香"
    }
  ],
  "tips": [
    "鸡腿肉带一点脂肪，丸子煮完才不干不柴。",
    "鸡肉糊搅打时可以摔打十几次，弹性会更好。",
    "香菇换成金针菇或白菜同样合适。",
    "汤底用高汤比清水鲜得多，别省这一步。"
  ],
  "common_mistakes": [
    "鸡肉糊没搅上劲就下锅，丸子一煮就散成碎渣。",
    "汤大滚时下丸子，翻滚撞击把丸子冲碎。",
    "浮沫没撇干净，汤色发浑还带一股腥味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "250克:250克",
      "note": "脂肪少，需加一勺淀粉帮助抱团。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "900毫升:900毫升",
      "note": "鲜味略薄，生抽可多加五毫升。"
    }
  ],
  "variations": [
    "丸子馅里加切碎的莲藕，咬开有脆感。",
    "换成味噌调汤底，做成鸡肉丸味噌汤。"
  ],
  "serving_suggestion": "盛进陶碗趁热喝，先喝一口清汤再咬开丸子，肉汁混着姜香慢慢散开，暖胃又清爽。",
  "storage": "冷藏可存两天，丸子与汤分开存放，复热时小火煮开三分钟即可。",
