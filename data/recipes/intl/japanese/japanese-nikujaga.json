    "刀",
    "砧板",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成大块，泡清水五分钟去涩。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡水去表面淀粉，汤才清。，看准状态再往下做。",
      "visual_cue": "块形圆整，水微浊，这一点很关键。"
    },
    {
      "n": 2,
      "text": "洋葱切成宽瓣，胡萝卜切滚刀块备用。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切大块，炖久了也不散。，看准状态再往下做。",
      "visual_cue": "块形一致，大小均匀"
    },
    {
      "n": 3,
      "text": "汤锅倒植物油，中火把牛肉片炒到变色。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "牛肉炒到变色就好，别炒老。，看准状态再往下做。",
      "visual_cue": "肉片卷曲，颜色变褐"
    },
    {
      "n": 4,
      "text": "加洋葱炒到边缘透明，再放土豆和胡萝卜。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蔬菜裹上油，炖后更香。，看准状态再往下做。",
      "visual_cue": "洋葱透明，蔬菜油亮"
    },
    {
      "n": 5,
      "text": "倒入清水、清酒、味醂、酱油和白糖煮开。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "液面刚没过食材就够。，看准状态再往下做。",
      "visual_cue": "汤汁翻滚，香气上涌"
    },
    {
      "n": 6,
      "text": "撇去浮沫，转小火盖锅炖十五分钟。，看准状态再往下做。",
      "time_min": 17,
      "heat": "小火",
      "tip": "撇净浮沫，汤才清不腥。，看准状态再往下做。",
      "visual_cue": "浮沫成形，汤面清亮"
    },
    {
      "n": 7,
      "text": "用筷子戳土豆，能穿透但不变形即可。，看准状态再往下做。",
      "time_min": 2,
      "heat": "小火",
      "tip": "土豆熟了就好，再炖会碎。，看准状态再往下做。",
      "visual_cue": "筷子可穿，块形完整"
    },
    {
      "n": 8,
      "text": "加豌豆和盐，再煮两分钟收味。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "豌豆最后放，颜色才翠。，看准状态再往下做。",
      "visual_cue": "豌豆翠绿，汤汁减半"
    },
    {
      "n": 9,
      "text": "关火焖五分钟，让食材吸饱汤汁后盛出。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "关火焖一会，味道才进得去。，看准状态再往下做。",
      "visual_cue": "汤汁挂身，颜色油亮"
    }
  ],
  "tips": [
    "土豆泡水去淀粉，汤才清亮。，这一点很关键。",
    "浮沫要撇净，汤才不腥。，这一点很关键。",
    "关火焖五分钟，味道才进得去。，这一点很关键。"
  ],
  "common_mistakes": [
    "土豆炖过头，全化成泥。，这一点很关键。",
    "酱油一次性倒太多，颜色发黑。，这一点很关键。",
    "不撇浮沫，汤浑浊带腥。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "猪里脊",
      "ratio": "400 克:400 克",
      "note": "更清爽，炖的时间减三分钟。"
    },
    {
      "original": "清酒",
      "substitute": "白酒",
      "ratio": "40 毫升:30 毫升",
      "note": "酒味更冲，需多煮两分钟。"
    }
  ],
  "variations": [
    "加一把粉丝，吸饱汤汁更香。，这一点很关键。",
    "放两片海带同炖，鲜味更足。，这一点很关键。"
  ],
  "serving_suggestion": "配一碗白饭，汤汁拌饭最香。，这一点很关键。",
  "storage": "冷藏三天，复热小火加少量水。，这一点很关键。",
