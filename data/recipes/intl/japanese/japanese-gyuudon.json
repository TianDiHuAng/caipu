    "电饭锅",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "日式酱油、味醂、清酒、白糖与清水调成一碗煮汁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先调好再下锅，煮的时候才不会手忙脚乱。",
      "visual_cue": "汁液深褐清亮，糖基本溶化"
    },
    {
      "n": 2,
      "text": "平底锅中火，洋葱丝铺底，倒入煮汁煮到洋葱变软。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱先煮软，甜味出来了牛里脊才不腻。",
      "visual_cue": "洋葱丝塌软半透明，汁液微沸"
    },
    {
      "n": 3,
      "text": "把牛里脊薄片一片一片摊在洋葱上，不要叠压。",
      "time_min": 3,
      "heat": "中火",
      "tip": "一片片摊开受热均匀，堆在一起会老。",
      "visual_cue": "肉片平铺满锅，颜色由红转浅"
    },
    {
      "n": 4,
      "text": "煮到肉片边缘变色立刻转小火，撇掉表面浮沫。",
      "time_min": 4,
      "heat": "小火",
      "tip": "浮沫要撇干净，煮汁才不会发腥发浑。",
      "visual_cue": "汁面浮起灰白沫，撇后清亮"
    },
    {
      "n": 5,
      "text": "保持小火再煮两分钟，让肉吸进酱汁，尝味后补盐。",
      "time_min": 3,
      "heat": "小火",
      "tip": "肉片变灰就好，煮久了口感发柴像橡皮。",
      "visual_cue": "肉片卷曲发亮，汁液略收浓"
    },
    {
      "n": 6,
      "text": "热米饭盛进深碗里，先淋上两勺煮汁让饭吸味。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先淋煮汁再铺肉，碗底的饭才不会发干。",
      "visual_cue": "米饭表面泛酱色，颗粒分明"
    },
    {
      "n": 7,
      "text": "把牛里脊与洋葱连同汁一起浇在饭上，撒小葱段即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "一定要趁热上桌，凉了肉会收紧变硬。",
      "visual_cue": "肉片层层叠在饭上，汁液自然渗下"
    }
  ],
  "tips": [
    "牛里脊冷冻半小时再切，薄片更容易切均匀。",
    "想更浓郁就在汁里多加十毫升酱油。",
    "旁边再配一颗半熟蛋，拌开吃更香。",
    "剩下的煮汁可以拌面条，别浪费掉。"
  ],
  "common_mistakes": [
    "牛里脊煮得太久，出锅之后口感又老又硬。",
    "煮汁太咸没收汁，整碗饭吃到底都发苦咸。",
    "洋葱没煮透就下肉，甜味完全出不来。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "洋葱",
      "ratio": "250克:400克",
      "note": "全素版本，煮的时间延长五分钟。"
    },
    {
      "original": "清酒",
      "substitute": "清水",
      "ratio": "30毫升:30毫升",
      "note": "少了酒香，可加两片姜同煮。"
    }
  ],
  "variations": [
    "加一颗温泉蛋和一把海苔丝，做成豪华丼饭。",
    "把牛里脊换成薄切猪肉片，做成猪肉丼。"
  ],
  "serving_suggestion": "装进深碗趁热吃，配一小碟腌姜和一碟清汤，日式定食的组合。",
  "storage": "冷藏一天，肉与饭分开保存，复热加少量清水防干。",
