  "equipment": [
    "汤锅",
    "漏勺",
    "小碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "章鱼 500g 冲洗干净，放入沸水中焯 1 分钟至触须卷曲，捞出切成入口小块。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯水定型后再切，块形才整齐。",
      "visual_cue": "触须卷曲、表面由灰转红"
    },
    {
      "n": 2,
      "text": "汤锅倒 400ml 清水放昆布 10g，小火加热 10 分钟，在将沸未沸时捞出昆布。",
      "time_min": 10,
      "heat": "小火",
      "tip": "昆布煮沸会发黏带腥，提前捞出。",
      "visual_cue": "汤色微黄、海味清鲜"
    },
    {
      "n": 3,
      "text": "汤中加清酒 30ml、味醂 30ml、白糖 10g 与姜片，中火煮开。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酒要先煮开，酒精味才挥发干净。",
      "visual_cue": "汤面冒泡、酒香转甜"
    },
    {
      "n": 4,
      "text": "放入章鱼块转小火煮 20 分钟，至肉质变软、用筷子能轻松穿透。",
      "time_min": 20,
      "heat": "小火",
      "tip": "小火慢煮，章鱼才软而不韧。",
      "visual_cue": "章鱼块收缩、筷子轻松插入"
    },
    {
      "n": 5,
      "text": "舀一勺汤汁把 40g 味噌在碗中化开，再倒回锅中煮 5 分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "味噌不能直接下锅，容易结块。",
      "visual_cue": "汤色转深、味噌完全融合"
    },
    {
      "n": 6,
      "text": "关火撒上葱花 10g，静置 10 分钟让味道渗进章鱼里。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置后章鱼更入味，汤也更浓。",
      "visual_cue": "汤汁挂身、章鱼呈酱色"
    }
  ],
  "tips": [
    "章鱼先焯水定型，切块才漂亮不缩。",
    "味噌一定要离火化开，煮沸会失香。",
    "煮好后静置十分钟，比立刻吃入味得多。"
  ],
  "common_mistakes": [
    "章鱼大火久煮，肉质硬得像橡胶。",
    "味噌直接下锅没化开，汤里全是结块。",
    "昆布一直煮到滚沸，汤发黏带腥味。"
  ],
  "substitutions": [
    {
      "original": "味噌",
      "substitute": "白味噌",
      "ratio": "40g 对 45g",
      "note": "咸度更低，甜味更突出。"
    },
    {
      "original": "章鱼",
      "substitute": "鱿鱼",
      "ratio": "500g 对 500g",
      "note": "煮制时间减到 8 分钟。"
    }
  ],
  "variations": [
    "加 100g 白萝卜块同煮，吸满汤汁更好吃。",
    "起锅前淋 5ml 柚子醋，清香解腻。"
  ],
  "serving_suggestion": "连汤带章鱼装碗，配白米饭和渍物，是典型的日式家常定食。",
  "storage": "冷藏可存 2 天，复热时小火加热，避免味噌香气流失。",
