  "steps": [
    {
      "n": 1,
      "text": "虾去壳留尾，用牙签挑出背上的虾线。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "虾线不去，腥味会很明显。，看准状态再往下做。",
      "visual_cue": "虾身干净，尾部完整"
    },
    {
      "n": 2,
      "text": "虾腹斜切三刀再压直，防止下锅卷曲。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切断筋，炸出的虾才笔直。，看准状态再往下做。",
      "visual_cue": "虾身挺直，节节展开"
    },
    {
      "n": 3,
      "text": "虾撒盐和黑胡椒腌五分钟，用纸巾吸干水。，看准状态再往下做。",
      "time_min": 7,
      "heat": "无火",
      "tip": "擦干水，裹粉才贴得牢。，看准状态再往下做。",
      "visual_cue": "虾面干爽，胡椒均匀"
    },
    {
      "n": 4,
      "text": "虾先裹一层面粉，抖掉多余的粉。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "薄薄一层，裹浆才挂得住。，看准状态再往下做。",
      "visual_cue": "表面泛白，无结块，很多人在这里出错。"
    },
    {
      "n": 5,
      "text": "再裹蛋液，最后滚满面包糠并压紧。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糠压紧，炸时不易掉渣。，看准状态再往下做。",
      "visual_cue": "外壳蓬松，无裸露，这里最容易翻车。"
    },
    {
      "n": 6,
      "text": "植物油烧到六成热，下虾中火炸两分钟。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温六成，虾熟得快也不焦。，看准状态再往下做。",
      "visual_cue": "外壳金黄，浮起油面"
    },
    {
      "n": 7,
      "text": "翻面再炸一分钟，捞出沥油。，看准状态再往下做。",
      "time_min": 2,
      "heat": "中火",
      "tip": "虾肉变白就熟，别炸过头。，看准状态再往下做。",
      "visual_cue": "外壳酥脆，颜色均匀"
    },
    {
      "n": 8,
      "text": "白菜丝垫盘，摆上炸虾配蛋黄酱和柠檬。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "挤柠檬解腻，味道更清爽。，看准状态再往下做。",
      "visual_cue": "盘面清爽，柠檬翠黄"
    }
  ],
  "tips": [
    "虾腹切几刀，炸后才不卷。，别小看这一步。",
    "虾要擦干，裹粉才牢。，成败就在这一步。",
    "油温六成，外壳酥里面才嫩。，这点要注意。"
  ],
  "common_mistakes": [
    "不断筋，炸出弯弯的虾球。，这是关键点。",
    "裹粉太厚，咬开全是皮。，别嫌麻烦，做完它。",
    "油温不够，外壳吸油发软。，这一步别省。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鱿鱼",
      "ratio": "500 克:500 克",
      "note": "切圈炸，时间减半。"
    },
    {
      "original": "面包",
      "substitute": "面包糠",
      "ratio": "100 克:100 克",
      "note": "更省事，裹得更均匀。"
    }
  ],
  "variations": [
    "裹粉里加一点咖喱粉，风味更浓。，别跳过这步。",
    "配塔塔酱，酸香更足。，这步最关键。"
  ],
  "serving_suggestion": "配米饭和白菜丝，或做三明治夹心。",
  "storage": "生坯冷冻一个月，炸前不需解冻。，很多人在这里出错。",
