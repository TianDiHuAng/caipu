    "打蛋器",
    "蒸锅",
    "保鲜膜",
    "量杯",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打散后加高汤、盐、酱油与淀粉，用打蛋器轻轻搅到完全融合。",
      "time_min": 7,
      "heat": "无火",
      "tip": "搅蛋液别太用力，气泡多蒸出来会有蜂窝孔。",
      "visual_cue": "蛋液淡黄顺滑，表面泡沫很少"
    },
    {
      "n": 2,
      "text": "蛋液过一遍筛，滤掉系带与泡沫，静置两分钟让气泡消掉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛这一步决定成品细不细，别省。",
      "visual_cue": "滤后蛋液均匀无杂质，质地轻薄"
    },
    {
      "n": 3,
      "text": "香菇与胡萝卜切碎，倒入蛋液中拌匀，撒上葱花。",
      "time_min": 6,
      "heat": "无火",
      "tip": "配料切越碎越好，蒸完口感才细腻。",
      "visual_cue": "配料碎粒均匀分布在蛋液中"
    },
    {
      "n": 4,
      "text": "取一小块保鲜膜铺在碗里，舀两勺蛋液，收口绞成球状扎紧。",
      "time_min": 10,
      "heat": "无火",
      "tip": "绞的时候留一点空间，蛋液受热会膨胀。",
      "visual_cue": "蛋球表面圆润，收口朝下平整"
    },
    {
      "n": 5,
      "text": "蒸锅水开后放蛋球小火蒸十二分钟，取出拆膜摆盘，淋一点酱油。",
      "time_min": 14,
      "heat": "小火",
      "tip": "小火蒸才能保证滑嫩，大火立刻起蜂窝。",
      "visual_cue": "蛋球颤而弹手，切开断面无孔洞"
    }
  ],
  "tips": [
    "蛋液一定要过筛，成品才会像布丁一样细腻。",
    "大火蒸会起蜂窝，全程小火才是关键。",
    "保鲜膜绞的时候留点空隙，蛋液受热会膨胀。",
    "收起口朝下摆盘，形状最圆最好看。"
  ],
  "common_mistakes": [
    "蛋液不过筛，蒸出来全是小孔洞。",
    "大火蒸，表面起满蜂窝，口感又老又粗。",
    "保鲜膜绞得太紧，蛋球蒸出来变形发硬。",
    "汤汁加太多，蛋液太稀，成型后立不住。"
  ],
  "substitutions": [
    {
      "original": "高汤",
      "substitute": "牛奶",
      "ratio": "160毫升:160毫升",
      "note": "奶香版口感更接近茶碗蒸。"
    },
    {
      "original": "香菇",
      "substitute": "豌豆",
      "ratio": "40克:40克",
      "note": "颜色更鲜亮，口感更清甜。"
    }
  ],
  "variations": [
    "蛋液里加一小勺蟹肉棒丝，颜色和鲜味都更足。",
    "蒸好后放凉冷藏，做成冷食前菜。",
    "淋一点勾芡的酱油汁，表面更有光泽。"
  ],
  "serving_suggestion": "每盘放三个茶巾蛋，淋上薄薄一层酱油汁，点缀葱花，作为会席料理的一道小前菜很合适。",
  "storage": "冷藏可放一天，复热用小火蒸五分钟，微波加热容易起孔影响口感。",
