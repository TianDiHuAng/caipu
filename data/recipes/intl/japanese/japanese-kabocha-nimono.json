  "steps": [
    {
      "n": 1,
      "text": "南瓜洗净剖开，挖掉籽与绵瓤，切成三厘米见方的块，保留外皮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮留着煮才不散，也能保住形状，吃起来还有淡淡栗香。",
      "visual_cue": "南瓜块大小一致，切口平整"
    },
    {
      "n": 2,
      "text": "每块南瓜在表皮一侧削去一点棱角，让切面平整，煮时不容易崩边。",
      "time_min": 4,
      "heat": "无火",
      "tip": "这个动作叫面取，能让南瓜久煮仍保持完整。",
      "visual_cue": "南瓜边缘圆润，无锐角"
    },
    {
      "n": 3,
      "text": "小锅加清水与木鱼花，小火加热到微沸后关火焖五分钟，过滤出高汤。",
      "time_min": 7,
      "heat": "小火",
      "tip": "木鱼花微沸就关火，煮久了会带腥苦味。",
      "visual_cue": "高汤浅金色，闻起来清鲜"
    },
    {
      "n": 4,
      "text": "高汤里加生抽、味淋、白糖与盐搅匀，倒进汤锅，南瓜块皮朝下摆成一层。",
      "time_min": 3,
      "heat": "无火",
      "tip": "皮朝下摆能让南瓜均匀吸汁，也避免翻动时破皮。",
      "visual_cue": "南瓜块单层平铺，汤汁到块身一半"
    },
    {
      "n": 5,
      "text": "锅上盖一张厨房纸做的落盖，中火煮开后转小火煮十二分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "落盖能让汤汁均匀浸到南瓜顶部，还不用翻动。",
      "visual_cue": "汤汁微滚，落盖被蒸汽顶起"
    },
    {
      "n": 6,
      "text": "用竹签扎南瓜中心，能轻松穿透就关火，盖盖在原汤里静置十分钟入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置比继续煮更稳，南瓜不会烂，甜味会往中心走。",
      "visual_cue": "竹签一插即透，南瓜完整不散"
    },
    {
      "n": 7,
      "text": "南瓜块轻轻盛出摆进碗里，淋上两勺煮汁，撒葱花。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盛的时候用铲子托住底部，筷子夹容易夹碎。",
      "visual_cue": "南瓜金黄油亮，煮汁清亮"
    },
    {
      "n": 8,
      "text": "温热时吃风味最好，冷藏后作为冷菜也别有清甜。",
      "time_min": 2,
      "heat": "无火",
      "tip": "冷藏后的南瓜甜味更聚，夏天当小菜很清爽。",
      "visual_cue": "南瓜软糯，切面湿润不发干"
    }
  ],
  "tips": [
    "南瓜选栗子南瓜，口感粉糯，甜度也高。",
    "煮汁别收太干，留一点浇在饭上很香。",
    "加几片薄薄五花肉同煮，油润感更足，汤汁也会更香。",
    "剩下的煮汁可以煮豆腐或鸡蛋，别浪费。"
  ],
  "common_mistakes": [
    "南瓜不挖净绵瓤，煮出来带丝，口感发涩。",
    "大火滚煮，南瓜外层化开而中心还是硬的。",
    "煮完不静置就直接盛，南瓜吸汁不足，味道只在表面。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "600克:600克",
      "note": "煮制时间缩短三分钟，甜味更浓。"
    },
    {
      "original": "木鱼花",
      "substitute": "昆布",
      "ratio": "8克:10克",
      "note": "冷水泡四小时吊汤，做成纯素版本。"
    }
  ],
  "variations": [
    "用黄油代替一半清水，加黑胡椒，做成日式洋风南瓜煮。",
    "加一勺味噌调成味噌南瓜，咸甜更浓。"
  ],
  "serving_suggestion": "配白饭与味噌汤，作为日常小菜，也可装进便当冷食。",
  "storage": "冷藏三天内吃完，复热用蒸锅蒸五分钟；微波加热易变干，建议用蒸法。",
