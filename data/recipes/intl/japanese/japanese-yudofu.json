  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "昆布用湿布擦去表面浮尘，放进冷水里浸泡二十分钟出味。",
      "time_min": 20,
      "heat": "无火",
      "tip": "昆布表面的白霜就是鲜味，别用水冲掉。",
      "visual_cue": "昆布变软，水色微黄"
    },
    {
      "n": 2,
      "text": "豆腐切成四厘米见方的大块，用厨房纸轻轻吸掉表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐块切得大一些，煮的时候才不容易碎。",
      "visual_cue": "豆腐块方正，表面干爽"
    },
    {
      "n": 3,
      "text": "昆布连水一起小火加热，快沸腾前把昆布捞出来不要。",
      "time_min": 8,
      "heat": "小火",
      "tip": "水一冒大泡就捞昆布，煮久会带黏液和腥味。",
      "visual_cue": "汤面细泡，昆布捞出"
    },
    {
      "n": 4,
      "text": "汤里轻轻放入豆腐块，保持小火加热六分钟热透。",
      "time_min": 6,
      "heat": "小火",
      "tip": "全程小火微沸，大火会把豆腐煮出蜂窝。",
      "visual_cue": "汤面微颤，豆腐完整"
    },
    {
      "n": 5,
      "text": "小碗里倒酱油，加小葱末和海苔丝，调成蘸豆腐的汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蘸汁现调现用，葱花放久了会失掉香气。",
      "visual_cue": "蘸汁清亮，葱花漂浮"
    },
    {
      "n": 6,
      "text": "用漏勺把豆腐块盛进碗里，浇少许热汤配蘸汁上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "豆腐先浇一勺热汤保温，蘸着吃更柔滑。",
      "visual_cue": "豆腐雪白，汤清见底"
    }
  ],
  "tips": [
    "昆布用冷水慢慢泡出味，别用热水直接煮。",
    "豆腐全程小火加热，表面才不会出蜂窝。",
    "蘸汁现调现吃，葱花的香气才留得住。"
  ],
  "common_mistakes": [
    "昆布一直煮到沸腾，汤里带上黏液和腥味。",
    "大火煮豆腐，表面粗糙内部全是空洞。",
    "豆腐块切得太小，盛的时候全碎在汤里。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "北豆腐",
      "ratio": "600 克:600 克",
      "note": "质地更硬，煮制时间加两分钟。"
    },
    {
      "original": "酱油",
      "substitute": "柚子醋",
      "ratio": "40 毫升:40 毫升",
      "note": "酸香更清爽，适合夏天吃。"
    }
  ],
  "variations": [
    "蘸汁里多加一点海苔丝，鲜味更明显。",
    "豆腐换成北豆腐，口感更扎实有嚼头。"
  ],
  "serving_suggestion": "趁热蘸汁吃，配一小碗白米饭和渍物就是素净的一餐。",
  "storage": "冷藏一天，复热时连汤小火加热至微沸。",
