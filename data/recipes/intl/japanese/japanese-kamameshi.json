  "steps": [
    {
      "n": 1,
      "text": "大米淘洗三遍至水变清，沥干后静置十分钟让米粒吸足表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "米洗好要沥干静置，煮出来才会粒粒分明。",
      "visual_cue": "米粒洁白松散，锅底无积水"
    },
    {
      "n": 2,
      "text": "鸡腿肉切小块，胡萝卜切细丝，香菇切薄片，三样都切得比米粒略大。",
      "time_min": 12,
      "heat": "无火",
      "tip": "配料切小一点，才能和米饭同时熟透。",
      "visual_cue": "配料大小均匀，丝片薄而整齐"
    },
    {
      "n": 3,
      "text": "高汤加酱油、味淋、清酒、白砂糖与盐调匀，尝起来比平时略咸。",
      "time_min": 5,
      "heat": "无火",
      "tip": "汤汁要略咸，米饭吸味后才刚好。",
      "visual_cue": "汤汁深褐色，咸淡适中"
    },
    {
      "n": 4,
      "text": "厚底锅放米，铺上鸡肉、胡萝卜丝与香菇片，倒入调好的汤汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "配料铺在米上别搅动，煮的时候才不会压出生米芯。",
      "visual_cue": "配料均匀铺平，汤汁没过米面一指"
    },
    {
      "n": 5,
      "text": "大火煮开转小火煮十五分钟，关火焖十分钟，撒葱花用木勺从底翻松。",
      "time_min": 26,
      "heat": "小火",
      "tip": "关火焖十分钟是让米芯熟透的关键，别急着开盖。",
      "visual_cue": "米粒饱满透亮，锅底有一层薄锅巴"
    }
  ],
  "tips": [
    "米洗好后沥干静置，煮出来的饭粒才分明。",
    "汤汁要比平时口味略咸一点，米饭吸味才正好。",
    "关火后焖十分钟，米芯才会彻底熟透不夹生。",
    "想吃锅巴就多煮两分钟，底部那层焦香最好吃。"
  ],
  "common_mistakes": [
    "米没沥干就加水，水量失控煮成烂饭。",
    "中途开盖搅动，米饭受热不匀夹生。",
    "汤汁调得太淡，煮出来饭是白水味。",
    "配料切得太大块，饭熟了肉还是生的。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "五花肉片",
      "ratio": "200克:180克",
      "note": "油脂更多，饭更香。"
    },
    {
      "original": "香菇",
      "substitute": "蟹味菇",
      "ratio": "70克:80克",
      "note": "口感更脆，煮的时间相同。"
    }
  ],
  "variations": [
    "加一把毛豆同煮，颜色和口感都更丰富。",
    "放两片炸豆腐皮，吸满汤汁后特别下饭。",
    "用土锅煮，锅巴更厚，香气更足。"
  ],
  "serving_suggestion": "连锅端上桌，用木勺从底部翻松后盛进碗里，配一碗味噌汤和几片腌萝卜。",
  "storage": "冷藏可放一天，复热加一小勺水盖盖小火焖三分钟，口感接近现煮。",
