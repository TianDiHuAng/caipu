      ]
    }
  ],
  "equipment": [
    "汤锅",
    "煮面锅",
    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "海带用湿布擦净表面，放入冷水浸泡二十分钟，小火加热到将沸前捞出海带。",
      "time_min": 10,
      "heat": "小火",
      "tip": "海带不能煮沸，滚了会释出黏液并发苦。",
      "visual_cue": "水面浮小泡、汤色淡黄清亮"
    },
    {
      "n": 2,
      "text": "放入木鱼花静置两分钟，待花瓣沉底后过滤，得到清澈的日式高汤。",
      "time_min": 4,
      "heat": "无火",
      "tip": "木鱼花不要搅动，久煮或搅压都会带来腥涩味。",
      "visual_cue": "木鱼花沉底、滤液清亮无渣"
    },
    {
      "n": 3,
      "text": "高汤回锅，加生抽、味醂与白糖小火加热到微沸，尝起来咸鲜带甜即离火。",
      "time_min": 4,
      "heat": "小火",
      "tip": "汤底宁淡勿咸，乌冬会吸汤，太咸越吃越咸。",
      "visual_cue": "汤色琥珀透亮、甜咸平衡"
    },
    {
      "n": 4,
      "text": "另起一锅水烧开，乌冬面下锅煮三分钟，冷冻乌冬先解冻再下。",
      "time_min": 4,
      "heat": "大火",
      "tip": "乌冬只需加热透，久煮会失弹，乌冬面断成糊。",
      "visual_cue": "乌冬面浮起、用筷子挑起有弹性"
    },
    {
      "n": 5,
      "text": "乌冬捞出过一遍冷水洗去表面淀粉，再回热汤里烫十秒让其吸味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "过冷水的目的是洗掉黏糊，别在外面泡太久。",
      "visual_cue": "乌冬面表面滑爽、汤面不浑浊"
    },
    {
      "n": 6,
      "text": "油豆腐放入汤锅小火浸煮五分钟，让它吸饱汤汁，甜咸味渗进豆皮。",
      "time_min": 5,
      "heat": "小火",
      "tip": "油豆腐先焯水去浮油，汤底更清不影响颜色。",
      "visual_cue": "豆皮颜色加深、捏起来沉甸甸"
    },
    {
      "n": 7,
      "text": "乌冬面装入碗中浇上热汤，摆好油豆腐，撒葱花趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "碗先用热水烫热，成品温度保持更久。",
      "visual_cue": "汤面清亮、葱花翠绿浮在表面"
    }
  ],
  "tips": [
    "高汤是这道面的全部，昆布与木鱼花都不能用大火滚。",
    "冷冻乌冬比干乌冬更接近日本口感，耐嚼且不易断。",
    "汤底可一次多做，冷藏三天，随取随用。"
  ],
  "common_mistakes": [
    "海带与木鱼花一同冷水下锅煮开，高汤发苦带腥。",
    "乌冬煮过头再加汤，乌冬面软烂无弹，汤也变糊。",
    "汤底调得过咸，乌冬吸汤后整碗难以下口。"
  ],
  "substitutions": [
    {
      "original": "乌冬面",
      "substitute": "荞麦面",
      "ratio": "400g 对 300g",
      "note": "荞麦面煮两分钟即可，风味更素淡。"
    },
    {
      "original": "油豆腐",
      "substitute": "油炸腐竹",
      "ratio": "4 片 对 60g",
      "note": "腐竹需提前泡软，吸汤后口感偏韧。"
    }
  ],
  "variations": [
    "打入一颗半熟温泉蛋同碗，做成月见乌冬，口感更浓滑。",
    "加一勺天妇罗碎与姜泥，做成清爽的关西风乌冬。"
  ],
  "serving_suggestion": "热汤热面盛入大碗，撒上七味粉与少许山椒粉，即刻享用。",
  "storage": "面与汤分开放，冷藏一天；复热时汤滚后再下面，避免乌冬面糊烂。",
