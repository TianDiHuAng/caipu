  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 200,
          "unit": "g",
          "note": "低筋，过筛两次",
          "optional": false
        },
        {
          "name": "红豆沙",
          "amount": 250,
          "unit": "g",
          "note": "市售细腻豆沙",
          "optional": false,
          "name_en": "red bean paste"
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 150,
          "unit": "g",
          "note": "三个，回温",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 60,
          "unit": "ml",
          "note": "常温",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 20,
          "unit": "g",
          "note": "增加湿润度",
          "optional": false
        },
        {
          "name": "泡打粉",
          "name_en": "baking powder",
          "amount": 3,
          "unit": "g",
          "note": "与面粉同筛",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "打发蛋液",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "润锅",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "打蛋器",
    "平底不粘锅",
    "裱花袋",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋加白糖用打蛋器打到颜色发白、提起能画出纹路慢慢消失。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打到浓稠发白，饼身才松软。",
      "visual_cue": "蛋液发白、纹路缓慢消失"
    },
    {
      "n": 2,
      "text": "加入蜂蜜与牛奶拌匀，再筛入面粉与泡打粉，翻拌到无干粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "翻拌不要画圈，避免起筋。",
      "visual_cue": "面糊顺滑、无干粉颗粒"
    },
    {
      "n": 3,
      "text": "面糊盖保鲜膜静置十五分钟，让粉类充分吸水、气泡稳定。",
      "time_min": 15,
      "heat": "无火",
      "tip": "静置后饼面才平整无孔。",
      "visual_cue": "面糊略稠、表面有小泡"
    },
    {
      "n": 4,
      "text": "平底锅小火预热，用纸巾薄薄抹一层植物油，舀一勺面糊倒成圆片。",
      "time_min": 4,
      "heat": "小火",
      "tip": "锅温别高，否则上色过深。",
      "visual_cue": "面糊自然摊开、边缘圆整"
    },
    {
      "n": 5,
      "text": "表面冒出密集小泡、边缘凝固时翻面，再煎三十秒出锅晾凉。",
      "time_min": 4,
      "heat": "小火",
      "tip": "泡破再翻，饼身才不塌。",
      "visual_cue": "表面小泡密集、边缘定型"
    },
    {
      "n": 6,
      "text": "取一片饼抹上厚厚一层红豆沙，盖上另一片轻轻压合即完成。",
      "time_min": 4,
      "heat": "无火",
      "tip": "豆沙抹中间厚、边缘薄。",
      "visual_cue": "夹馅均匀、边缘吻合"
    }
  ],
  "tips": [
    "面糊一定静置十五分钟，饼面才会细腻无孔洞。",
    "全程小火，锅温过高会让饼皮焦黑里面夹生。",
    "饼皮晾到微温再夹馅，豆沙才不会化开。"
  ],
  "common_mistakes": [
    "蛋液没打发到位，饼皮又薄又硬不蓬松。",
    "面糊倒进高温锅里，第一片就上色过深发苦。",
    "趁热夹馅，豆沙融化后从边缘溢出。"
  ],
  "substitutions": [
    {
      "original": "红豆沙",
      "substitute": "栗子泥",
      "ratio": "250g 对 250g",
      "note": "甜度更低，风味更清。"
    },
    {
      "original": "蜂蜜",
      "substitute": "麦芽糖",
      "ratio": "20g 对 20g",
      "note": "保湿更强，面糊稍稠。"
    }
  ],
  "variations": [
    "抹茶版：面粉中替换 10g 为抹茶粉。",
    "奶油版：豆沙中拌入 60g 打发的淡奶油。"
  ],
  "serving_suggestion": "对半切开摆盘，配日式煎茶或牛奶。",
  "storage": "密封常温可存 1 天，冷藏 3 天，食用前微波 10 秒回软。",
