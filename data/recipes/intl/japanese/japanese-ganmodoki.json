  "steps": [
    {
      "n": 1,
      "text": "老豆腐用纱布包好压上重物静置二十分钟，挤出多余水分后捏碎。",
      "time_min": 24,
      "heat": "无火",
      "tip": "水压不干丸子会散，压到豆腐渣状最理想。",
      "visual_cue": "豆腐呈细碎渣状，纱布几乎拧不出水"
    },
    {
      "n": 2,
      "text": "胡萝卜切细丝，莲藕与香菇切细丁，全部放进大碗拌匀。",
      "time_min": 12,
      "heat": "无火",
      "tip": "所有配料都切细，炸的时候才能一起熟透。",
      "visual_cue": "配料细碎均匀，大小接近黄豆粒"
    },
    {
      "n": 3,
      "text": "加豆腐碎、鸡蛋、淀粉、酱油、盐、白砂糖与葱花，用手抓拌到能抱团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "拌到抓一把能攥成团不散就够，别过度搅。",
      "visual_cue": "混合物黏稠，能捏成球不塌"
    },
    {
      "n": 4,
      "text": "抓成乒乓球大小的圆球，掌心轻压成扁圆，表面抹平。",
      "time_min": 12,
      "heat": "无火",
      "tip": "压扁能让受热更均匀，中间不容易夹生。",
      "visual_cue": "丸子扁圆规整，表面无裂缝"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧到一百七十度，下丸子中火炸六分钟至金黄，捞出沥油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温低了丸子会吸油散开，筷子冒小泡刚好。",
      "visual_cue": "外壳金黄硬挺，敲起来有脆响"
    }
  ],
  "tips": [
    "豆腐水分一定要压干，这一步决定丸子能不能成型。",
    "配料切得越细，丸子越紧实也不容易裂。",
    "油温保持一百七十度，低了散、高了外焦里生。",
    "炸好后可以放进高汤里小火煮两分钟，更入味。"
  ],
  "common_mistakes": [
    "豆腐没压水就拌，下锅立刻炸散开花。",
    "淀粉放太少，丸子粘不住，一入油锅就裂。",
    "油温太低，丸子吸满油又软又腻。",
    "丸子捏得太厚，外面焦了里面还是凉的。"
  ],
  "substitutions": [
    {
      "original": "莲藕",
      "substitute": "马蹄",
      "ratio": "120克:120克",
      "note": "口感更清脆，甜度更高。"
    },
    {
      "original": "香菇",
      "substitute": "黑木耳",
      "ratio": "60克:60克",
      "note": "切碎后口感相近。"
    }
  ],
  "variations": [
    "拌料里加一把煮熟切碎的毛豆，颜色更鲜绿，口感也更扎实。",
    "用高汤、酱油和味淋煮一下，做成煮物更入味。",
    "丸子做得小一点，作为便当配菜更合适。"
  ],
  "serving_suggestion": "炸好沥油的丸子摆在盘里，配白萝卜泥与酱油，热吃外脆内软，冷吃也很有风味。",
  "storage": "冷藏可放两天，复热用一百八十度烤箱烤六分钟；也可放进高汤里煮成煮物。",
