  "equipment": [
    "碗",
    "小锅",
    "竹签"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉 150g 分次加 120ml 温水，揉成不粘手、可塑形的软面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水要慢慢加，面团太软会塌。",
      "visual_cue": "面团光滑、按压有弹性"
    },
    {
      "n": 2,
      "text": "面团分成 18 份，每份搓成直径 3cm 的小圆球，中间轻按一个凹窝。",
      "time_min": 10,
      "heat": "无火",
      "tip": "凹窝能让团子里外受热均匀。",
      "visual_cue": "团子大小一致、表面光滑"
    },
    {
      "n": 3,
      "text": "汤锅水烧开后下团子，中火煮至全部浮起再煮 2 分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "浮起后多煮两分钟，中心才没有生粉。",
      "visual_cue": "团子全部浮面、体积变大"
    },
    {
      "n": 4,
      "text": "捞出团子立即放入冰水中冷却 2 分钟，让口感更弹牙。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过冰水是弹牙的关键。",
      "visual_cue": "团子紧实、表面光亮"
    },
    {
      "n": 5,
      "text": "小锅放 80ml 清水、30ml 酱油与 40g 白糖煮开，用 8g 淀粉加 10ml 水勾芡至浓稠。",
      "time_min": 6,
      "heat": "小火",
      "tip": "芡汁浓度以能挂住团子为准。",
      "visual_cue": "酱汁半透明、拉起呈线状"
    },
    {
      "n": 6,
      "text": "三个团子穿一根竹签，炭火或平底锅略微烤上色，刷满酱汁即可。",
      "time_min": 5,
      "heat": "中火",
      "tip": "烤出焦痕再刷酱，香气才足。",
      "visual_cue": "表面微焦、酱汁油亮"
    }
  ],
  "tips": [
    "团子煮好过冰水，口感从软糯变弹牙。",
    "酱汁现熬现刷，冷了就稠得刷不开。",
    "竹签提前用清水泡十分钟，烤的时候才不容易烧焦。"
  ],
  "common_mistakes": [
    "糯米粉一次加足水，面团湿黏无法搓圆。",
    "团子没过冰水，放凉后塌软粘牙。",
    "芡汁熬得太稠，刷在团子上结成硬皮。"
  ],
  "substitutions": [
    {
      "original": "糯米粉",
      "substitute": "白玉粉",
      "ratio": "150g 对 150g",
      "note": "颗粒更细，成品更细腻。"
    },
    {
      "original": "酱油",
      "substitute": "淡口酱油",
      "ratio": "30ml 对 35ml",
      "note": "颜色浅，需加 5g 糖补味。"
    }
  ],
  "variations": [
    "三色版：面团分别加抹茶粉与草莓粉。",
    "红豆版：串好的团子表面再淋一层蜜红豆沙。"
  ],
  "serving_suggestion": "温热或放凉食用，配一杯抹茶最地道。",
  "storage": "冷藏 2 天，复热用平底锅干煎或微波 20 秒。",
