  "steps": [
    {
      "n": 1,
      "text": "章鱼丁用开水烫一分钟，捞出沥干备用。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "大火",
      "tip": "先烫一下，烤时更容易熟透。，锅温要匀，别忽高忽低。",
      "visual_cue": "章鱼卷曲，颜色转白"
    },
    {
      "n": 2,
      "text": "面粉过筛，加鸡蛋、高汤和生抽搅成稀糊。，火力保持中等，慢慢来。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糊要稀到能流动，太稠烤不熟。，火候宁小勿大，慢慢推进。",
      "visual_cue": "糊体顺滑，能挂勺流下"
    },
    {
      "n": 3,
      "text": "面糊里拌入小葱碎和盐，静置十分钟。，注意锅里温度别掉下来。",
      "time_min": 11,
      "heat": "无火",
      "tip": "静置让面粉吸水，烤时不易破。，始终中小火，别心急。",
      "visual_cue": "糊面平静，气泡上浮"
    },
    {
      "n": 4,
      "text": "章鱼烧锅烧热，每个孔刷一层植物油。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "中火",
      "tip": "锅要够热，糊下去才能立刻成形。，看住火，别让它失控。",
      "visual_cue": "锅面发亮，微微冒烟"
    },
    {
      "n": 5,
      "text": "把面糊倒满所有孔，每孔放一块章鱼丁。，全程留意火候，别贪快。",
      "time_min": 4,
      "heat": "中火",
      "tip": "倒满溢出没关系，等下推进孔里。，火大了就离锅远一点。",
      "visual_cue": "每孔饱满，糊面铺开"
    },
    {
      "n": 6,
      "text": "等边缘凝固，用竹签把溢出的面糊推进孔里。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "边缘定型再推，才不会破。，锅温要匀，别忽高忽低。",
      "visual_cue": "边缘翘起，底面金黄"
    },
    {
      "n": 7,
      "text": "转丸子九十度，让未熟的面糊流到锅底。，火力保持中等，慢慢来。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一边转一边补糊，丸子才圆。，火候宁小勿大，慢慢推进。",
      "visual_cue": "丸子半圆，表面湿润"
    },
    {
      "n": 8,
      "text": "反复转动烤八分钟，到表面金黄酥脆。，注意锅里温度别掉下来。",
      "time_min": 9,
      "heat": "中火",
      "tip": "转得勤，丸子才滚得圆。，始终中小火，别心急。",
      "visual_cue": "外壳金黄，竹签轻推能滚"
    },
    {
      "n": 9,
      "text": "装盘淋蛋黄酱和生抽，撒木鱼花和紫菜。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热撒木鱼花，才会跳舞。，看住火，别让它失控。",
      "visual_cue": "木鱼花颤动，酱汁交错"
    }
  ],
  "tips": [
    "面糊要稀，太稠烤出来是实心球。，成败就在这一步。",
    "锅要够热，糊下去才能立刻成形。，这点要注意。",
    "转得勤，丸子才滚得圆。，这是关键点。"
  ],
  "common_mistakes": [
    "面糊太稠，中心烤不熟。，别嫌麻烦，做完它。",
    "锅不够热，丸子粘锅破皮。，这一步别省。",
    "翻得太早，丸子散成糊。，别跳过这步。"
  ],
  "substitutions": [
    {
      "original": "章鱼",
      "substitute": "虾仁",
      "ratio": "250 克:250 克",
      "note": "切小丁，烫的时间减半。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "600 毫升:600 毫升",
      "note": "鲜味变淡，可多加生抽。"
    }
  ],
  "variations": [
    "加芝士丁，咬开会拉丝。，这步最关键。",
    "加玉米粒，甜味更明显。，很多人在这里出错。"
  ],
  "serving_suggestion": "趁热吃，插竹签直接入口。，这里最容易翻车。",
  "storage": "现做现吃，冷藏后外壳会软。，别小看这一步。",
