  "equipment": [
    "平底锅",
    "肉锤",
    "三只浅盘",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊横切成两片两厘米厚的猪排，用刀背在两面轻敲断筋。",
      "time_min": 6,
      "heat": "无火",
      "tip": "敲断筋膜炸时才不会卷边收缩。",
      "visual_cue": "猪排厚度均匀、边缘略松"
    },
    {
      "n": 2,
      "text": "猪排两面撒盐和黑胡椒，静置十分钟让底味渗进去。",
      "time_min": 10,
      "heat": "无火",
      "tip": "提前撒盐比炸后撒更入味，也不会掉粉。",
      "visual_cue": "表面均匀覆细盐与黑胡椒"
    },
    {
      "n": 3,
      "text": "准备好面粉、蛋液、面包糠三个浅盘，按顺序排好。",
      "time_min": 3,
      "heat": "无火",
      "tip": "三盘按序摆放，裹粉时手不会乱。",
      "visual_cue": "三盘齐备、面包糠蓬松"
    },
    {
      "n": 4,
      "text": "猪排先拍一层面粉抖掉多余粉，再裹蛋液，最后压满面包糠。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面包糠用手压实，炸时不易脱落。",
      "visual_cue": "外壳厚实蓬松、不见裸肉"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油至没过猪排一半，烧到六成热后下猪排，中火炸四分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温六七成最稳，太低吸油、太高外焦内生。",
      "visual_cue": "外壳金黄、油泡细密"
    },
    {
      "n": 6,
      "text": "翻面再炸三分钟，捞出放在网架上沥油两分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "用网架不用厨房纸，底部才不会焖软。",
      "visual_cue": "两面金黄酥脆、外皮干爽"
    },
    {
      "n": 7,
      "text": "卷心菜切极细丝泡冰水五分钟，沥干后堆在盘边。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冰水泡过的菜丝更脆，也能压住油腻。",
      "visual_cue": "菜丝挺脆、水分沥干"
    },
    {
      "n": 8,
      "text": "番茄酱加生抽调成蘸汁，猪排切条配菜丝一同上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "猪排横切条，看得见肉汁才漂亮。",
      "visual_cue": "切面肉色粉白、外壳不散"
    }
  ],
  "tips": [
    "猪排厚两厘米最合适，太薄容易炸柴。",
    "面包糠选粗粒的，炸出来更酥更立体。",
    "不想多油可改半煎炸，油量盖过猪排一半即可。"
  ],
  "common_mistakes": [
    "没敲断筋膜就下锅，猪排卷成碗状。",
    "裹粉后放太久，面包糠受潮脱落。",
    "炸好直接放盘子里，底部被蒸汽焖软。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "猪梅肉",
      "ratio": "300g 对 300g",
      "note": "带些脂肪更嫩，炸的时间加一分钟。"
    },
    {
      "original": "面包糠",
      "substitute": "玉米片碎",
      "ratio": "80g 对 80g",
      "note": "压碎后裹上，口感更硬脆。"
    }
  ],
  "variations": [
    "上面淋咖喱，做成日式咖喱猪排饭。",
    "加一片奶酪同炸，做成芝士猪排。"
  ],
  "serving_suggestion": "配白饭、味噌汤和卷心菜丝，是日本定食的经典组合。",
  "storage": "冷藏一天，复热用烤箱一百八十度烤五分钟恢复酥脆。",
