  "equipment": [
    "大碗",
    "平底不粘锅",
    "锅铲",
    "刨丝器",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "卷心菜切极细的丝，山药擦成泥，五花肉切成薄片备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "菜丝切细才能快速熟透，太粗会出水塌饼。",
      "visual_cue": "菜丝松散不结块，山药泥黏稠"
    },
    {
      "n": 2,
      "text": "大碗中放面粉、山药泥、鸡蛋、生抽、白糖与盐，搅成顺滑面糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面糊搅到没有粉粒就停，过度搅拌会出筋发硬。",
      "visual_cue": "面糊能缓缓流下成带状"
    },
    {
      "n": 3,
      "text": "把卷心菜丝倒入面糊，用刮刀翻拌到每根菜丝都挂上糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻拌而不是搅拌，菜丝保持完整饼才蓬松。",
      "visual_cue": "菜丝均匀裹糊，体积不塌"
    },
    {
      "n": 4,
      "text": "平底锅下植物油中火，把菜糊分成四份摊成两厘米厚的圆饼，铺上五花肉片。",
      "time_min": 8,
      "heat": "中火",
      "tip": "饼不要摊太薄，厚一点才有松软内芯。",
      "visual_cue": "饼边定型，肉片贴住表面"
    },
    {
      "n": 5,
      "text": "加盖煎六分钟，翻面后再煎五分钟至两面金黄、中心熟透。",
      "time_min": 11,
      "heat": "中火",
      "tip": "翻面用两个铲子托住，饼才不会散。",
      "visual_cue": "两面焦黄，按压回弹"
    },
    {
      "n": 6,
      "text": "刷上生抽与白糖调成的酱汁，挤上蛋黄酱划出纹路。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酱汁最后刷，早刷容易在锅里烧焦。",
      "visual_cue": "表面酱光发亮，纹路清晰"
    },
    {
      "n": 7,
      "text": "在饼面撒上木鱼花与海苔丝，趁热切成四块装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "木鱼花的余温会让薄片卷动，是最有生命感的一刻。",
      "visual_cue": "薄片轻轻卷曲，香气上升"
    }
  ],
  "tips": [
    "山药泥是蓬松的秘诀，没有可用等量土豆泥代替。",
    "翻面时用两个铲子托住饼底，动作要快。",
    "盖上锅盖煎能让中心熟透又不焦底。"
  ],
  "common_mistakes": [
    "卷心菜切得太粗，饼一煎就塌成湿软一团。",
    "火太大，外面焦黑中心还是生面糊。",
    "翻面太早，饼散在锅里变成炒菜。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "培根",
      "ratio": "150 克:120 克",
      "note": "咸度高，面糊里的盐减一克。"
    },
    {
      "original": "山药",
      "substitute": "土豆",
      "ratio": "100 克:100 克",
      "note": "改用土豆泥，蓬松度略差于山药。"
    }
  ],
  "variations": [
    "加一把虾仁或鱿鱼丁，做成海鲜大阪烧。",
    "用炒面夹在饼里，是广岛的吃法。"
  ],
  "serving_suggestion": "切十字分成四块，趁热用铲子直接吃。",
  "storage": "冷藏两天；复热用平底锅干煎三分钟恢复脆边。",
