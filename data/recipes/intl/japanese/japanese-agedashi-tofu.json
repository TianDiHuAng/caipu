  "steps": [
    {
      "n": 1,
      "text": "豆腐用厨房纸包好，压上重物去水十分钟。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "压出水分，炸时才不溅油。，看准状态再往下做。",
      "visual_cue": "豆腐紧实，纸面潮湿"
    },
    {
      "n": 2,
      "text": "豆腐切成四厘米见方的块，边角修平。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切块大小一致，炸得才均匀。，看准状态再往下做。",
      "visual_cue": "块形方整，边缘平整"
    },
    {
      "n": 3,
      "text": "海带加水小火煮五分钟，捞出后留汤。，看准状态再往下做。",
      "time_min": 7,
      "heat": "小火",
      "tip": "海带汤别煮久，久了发苦。，看准状态再往下做。",
      "visual_cue": "汤色清浅，香气淡，这一点很关键。"
    },
    {
      "n": 4,
      "text": "汤里加酱油和味醂煮开，用淀粉勾薄芡。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "芡要薄，挂汁才透亮。，看准状态再往下做。",
      "visual_cue": "汁体微稠，能流动，这一点很关键。"
    },
    {
      "n": 5,
      "text": "豆腐块裹一层薄面粉，抖掉多余粉。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄粉即可，厚了外壳发硬。，看准状态再往下做。",
      "visual_cue": "表面泛白，无结块，这一点很关键。"
    },
    {
      "n": 6,
      "text": "植物油烧到七成热，下豆腐中火炸三分钟。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "高油温速炸，外皮才脆不吸油。，看准状态再往下做。",
      "visual_cue": "外壳金黄，油泡密集"
    },
    {
      "n": 7,
      "text": "翻动豆腐让各面均匀上色，捞出沥油。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "轻轻推动，别把豆腐弄破。，看准状态再往下做。",
      "visual_cue": "各面金黄，形状完整"
    },
    {
      "n": 8,
      "text": "豆腐摆碗里，淋上热芡汁放葱末和姜泥。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汁要趁热淋，香气才冲出来。，看准状态再往下做。",
      "visual_cue": "汁面泛光，姜泥点缀"
    }
  ],
  "tips": [
    "豆腐先压水，炸时才不溅油。，这一点很关键。",
    "油温要高，外壳才脆不油腻。，这一点很关键。",
    "芡汁要薄，挂一层就够。，这一点很关键。"
  ],
  "common_mistakes": [
    "豆腐不压水，下锅油花四溅。，这一点很关键。",
    "油温不够，豆腐吸油变软。，这一点很关键。",
    "芡太厚，像糊在豆腐上。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "北豆腐",
      "ratio": "400 克:400 克",
      "note": "更紧实，压水时间可减半。"
    },
    {
      "original": "淀粉",
      "substitute": "玉米淀粉",
      "ratio": "20 克:20 克",
      "note": "芡更透亮，用量相同。"
    }
  ],
  "variations": [
    "表面撒一点七味粉，辛香更足。，这一点很关键。",
    "加一勺萝卜泥，清爽解腻。，这一点很关键。"
  ],
  "serving_suggestion": "趁热吃，配一杯清酒。，这一点很关键。",
  "storage": "炸好当日吃完，汁可冷藏两天。，这一点很关键。",
