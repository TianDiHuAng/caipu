          "note": "油炸用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "蛋黄酱",
          "name_en": "mayonnaise",
          "amount": 40,
          "unit": "g",
          "note": "佐食",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "油炸锅",
    "漏网",
    "三个浅盘",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牡蛎放淡盐水里轻轻淘洗，挑掉碎壳，再用厨房纸吸干表面水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "淘洗时动作要轻，牡蛎肚一破下锅就流汁。",
      "visual_cue": "牡蛎饱满完整，表面干爽"
    },
    {
      "n": 2,
      "text": "把牡蛎依次裹上面粉、蘸蛋液、再滚一层面包糠，按顺序摆好。",
      "time_min": 10,
      "heat": "无火",
      "tip": "三层顺序不能乱，裹完轻压一下让糠粘牢。",
      "visual_cue": "外层均匀裹满，不见裸露的牡蛎"
    },
    {
      "n": 3,
      "text": "锅中倒入植物油，烧到一百七十度，投入一撮面包糠试温。",
      "time_min": 8,
      "heat": "中火",
      "tip": "面包糠下锅立刻浮起冒泡，油温就差不多了。",
      "visual_cue": "油面微微波动，试炸的糠快速上色"
    },
    {
      "n": 4,
      "text": "把牡蛎分批下锅炸两分钟，外壳金黄后翻面再炸一分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "一次别超过四颗，油温骤降会炸得又软又油。",
      "visual_cue": "外壳金黄酥脆，浮在油面"
    },
    {
      "n": 5,
      "text": "用漏网捞出沥油，放在厨房纸上吸掉多余油脂。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出锅先竖着沥油，底部才不会积一层油。",
      "visual_cue": "表面干爽不泛油光，颜色金黄"
    },
    {
      "n": 6,
      "text": "摆盘配上白萝卜泥、柠檬角与蛋黄酱，趁热吃最酥。",
      "time_min": 2,
      "heat": "无火",
      "tip": "萝卜泥先挤掉一点水，吃起来口感更清爽。",
      "visual_cue": "外壳完整，配菜颜色清爽"
    }
  ],
  "tips": [
    "牡蛎买带壳的自己开，鲜度更好也更便宜。",
    "面包糠用粗粒的，炸出来更酥更蓬松。",
    "油温控制在170度左右，太高外焦里生。",
    "炸好一定要趁热吃，凉了外壳就会回软。"
  ],
  "common_mistakes": [
    "牡蛎没擦干就裹粉，下锅油花四溅还脱壳。",
    "油温不够就下锅，外壳吸满油又软又腻。",
    "一次下太多，油温骤降导致外壳不脆。"
  ],
  "substitutions": [
    {
      "original": "牡蛎",
      "substitute": "扇贝",
      "ratio": "320克:320克",
      "note": "个头大的先片成两半，炸的时间相同。"
    },
    {
      "original": "面包糠",
      "substitute": "玉米淀粉",
      "ratio": "80克:60克",
      "note": "外壳更薄更脆，口感偏硬。"
    }
  ],
  "variations": [
    "裹粉时加一点咖喱粉，做成咖喱风味的炸牡蛎。",
    "炸好后淋一勺塔塔酱，风味会更加浓郁。"
  ],
  "serving_suggestion": "刚出锅的炸牡蛎外壳咔嚓作响，咬开里面还是滚烫多汁，蘸一点蛋黄酱配萝卜泥，鲜味被衬得更突出。",
  "storage": "建议现炸现吃，冷藏后再复热外壳会回软，最多存放一天且须彻底加热。",
