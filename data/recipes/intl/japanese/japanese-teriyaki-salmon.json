  "equipment": [
    "平底锅",
    "夹子",
    "小碗",
    "刷子",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "三文鱼块用厨房纸吸干表面水分，两面薄薄撒一层盐。",
      "time_min": 6,
      "heat": "无火",
      "tip": "表面干爽照烧汁才挂得住，不滑不留。",
      "visual_cue": "鱼块干爽，盐粒均匀，状态稳定"
    },
    {
      "n": 2,
      "text": "酱油、味醂和白糖倒进小碗搅到糖化开，调成照烧汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖先化开，下锅才不会糊在锅底。，注意火候。",
      "visual_cue": "汁液均匀，颜色深褐，状态稳定"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油烧热，鱼块皮朝下放入锅中煎四分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "皮朝下先煎，皮脆肉嫩还不粘锅。，注意火候。",
      "visual_cue": "鱼皮金黄，油面微响，状态稳定"
    },
    {
      "n": 4,
      "text": "翻面再煎两分钟，两面都上色后倒掉锅中多余的油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油倒掉再烧汁，成品才不油腻。，注意火候。",
      "visual_cue": "两面金黄，锅底干净，状态稳定"
    },
    {
      "n": 5,
      "text": "放入姜片，倒入调好的照烧汁，小火煮三分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢收，糖分才不焦，汁也能渗进鱼肉。",
      "visual_cue": "汁液冒泡，香气甘甜，状态稳定"
    },
    {
      "n": 6,
      "text": "用勺子把汁反复淋在鱼块上，收到浓稠发亮后关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "收汁到能挂住勺背就好，太干会发苦。",
      "visual_cue": "表面油亮，汁液浓稠，状态稳定"
    },
    {
      "n": 7,
      "text": "取出姜片，鱼块装盘，把剩下的汁淋在表面即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热淋汁，表面光泽才漂亮。，注意火候。",
      "visual_cue": "汁层均匀，鱼肉分层，状态稳定"
    }
  ],
  "tips": [
    "鱼块先吸干水，照烧汁才挂得住。，值得留意。",
    "皮朝下先煎，鱼皮脆而不粘锅。，值得留意。",
    "收汁用小火，糖分一焦整锅发苦。，值得留意。"
  ],
  "common_mistakes": [
    "鱼块带水直接下锅，油花四溅还粘锅。，务必避免。",
    "照烧汁大火收干，表面一层焦苦味。，务必避免。",
    "煎的时间过长，鱼肉干成木柴。，务必避免。"
  ],
  "substitutions": [
    {
      "original": "三文鱼",
      "substitute": "银鳕鱼",
      "ratio": "600 克:600 克",
      "note": "油脂更足，煎制时间加一分钟。"
    },
    {
      "original": "味醂",
      "substitute": "米酒",
      "ratio": "40 毫升:40 毫升",
      "note": "甜味略减，白糖可加十克。"
    }
  ],
  "variations": [
    "撒一层白芝麻，香气和卖相都更好。，也很受欢迎。",
    "照烧汁里加少许柠檬汁，甜味更清爽。，也很受欢迎。"
  ],
  "serving_suggestion": "配白米饭和一份清炒蔬菜，酱汁拌饭最香。，效果更稳定。",
  "storage": "冷藏两天，复热用平底锅小火加少量水焖三分钟。",
