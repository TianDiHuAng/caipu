  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "菠菜",
          "name_en": "spinach",
          "amount": 300,
          "unit": "g",
          "note": "选嫩叶，根部去泥",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "木鱼花",
          "name_en": "bonito flakes",
          "amount": 10,
          "unit": "g",
          "note": "取汤汁和装饰各半",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "调浸泡汁",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "压咸提鲜",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 6,
          "unit": "g",
          "note": "炒香略压碎",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "冰水盆",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜逐棵掰开洗净，根部泥沙冲干净，长的从中间切两段。",
      "time_min": 3,
      "heat": "无火",
      "tip": "根部最容易藏泥，掰开后对着水冲才洗得干净。",
      "visual_cue": "菠菜棵棵散开，根部没有泥点。"
    },
    {
      "n": 2,
      "text": "汤锅烧一大锅水到滚，菠菜根部先入水十秒，再把整棵按进去。",
      "time_min": 3,
      "heat": "大火",
      "tip": "根比叶难熟，先烫根再压叶，熟度才一致。",
      "visual_cue": "菠菜整体转深绿，叶片刚刚塌软。"
    },
    {
      "n": 3,
      "text": "捞出立刻放进冰水盆浸透，凉后捞出，两手合拢轻轻挤干水。",
      "time_min": 2,
      "heat": "无火",
      "tip": "挤水要轻，用力攥会把叶子攥烂，口感就没了。",
      "visual_cue": "菠菜翠绿紧实，指缝不再滴水。"
    },
    {
      "n": 4,
      "text": "酱油、细砂糖加三大勺清水和一半木鱼花泡十分钟，滤出浸泡汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "木鱼花泡五分钟味道就出足，泡太久会有腥气。",
      "visual_cue": "浸泡汁呈浅琥珀色，滤后清亮。"
    },
    {
      "n": 5,
      "text": "菠菜切成四厘米长的段，码进小碟，淋两勺浸泡汁，撒白芝麻和木鱼花。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁别一次淋满，吃前再补，颜色和口感都更好。",
      "visual_cue": "菠菜段整齐码放，表面点缀芝麻与木鱼花。"
    }
  ],
  "tips": [
    "焯菠菜的水要够多、够滚，下锅二十秒就够，颜色才翠绿。",
    "焯完立刻过冰水，这一步决定口感是脆是烂，千万别省。",
    "浸泡汁要放凉再放菠菜，热汁会把菜叶烫黄。"
  ],
  "common_mistakes": [
    "菠菜整把丢进锅里煮，外层烂了内芯还没断生，口感一塌。",
    "焯完在室温放凉，余温继续加热，叶子发黄发暗。",
    "浸泡时间过长，酱油味盖过菠菜的清甜，吃着只剩咸。"
  ],
  "substitutions": [
    {
      "original": "木鱼花",
      "substitute": "干香菇泡汁",
      "ratio": "10克:干香菇3朵泡出的汁",
      "note": "素食可用，鲜味更厚。"
    },
    {
      "original": "酱油",
      "substitute": "淡口酱油",
      "ratio": "20毫升:22毫升",
      "note": "颜色浅，草本的绿更突出。"
    }
  ],
  "variations": [
    "拌入一勺炒香的白芝麻糊，就是更浓的 goma-ae 风味，配米饭很合适。",
    "把菠菜换成油菜心，茎更脆，焯水时间减到十五秒。"
  ],
  "serving_suggestion": "挤干水分切成四厘米段，整齐码在小碟里，淋一点浸泡汁，撒木鱼花和白芝麻。",
  "storage": "冷藏可放一天，汁水单独存放，吃前再淋，泡久了菜叶会发软出水。",
