  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成三厘米块，红薯与白萝卜切一厘米厚片，胡萝卜切滚刀块。",
      "time_min": 14,
      "heat": "无火",
      "tip": "红薯切太薄容易煮散，一厘米厚刚好。",
      "visual_cue": "各料大小均匀，红薯断面平整"
    },
    {
      "n": 2,
      "text": "汤锅倒芝麻油中火烧热，下鸡腿肉煎到表面变白出香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先把鸡肉煎香再加水，汤头才不寡淡。",
      "visual_cue": "鸡肉表面泛白微黄，锅底有焦香"
    },
    {
      "n": 3,
      "text": "淋清酒翻炒几下，倒入高汤，加白萝卜与胡萝卜煮开后转小火煮十分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "萝卜要先煮，红薯后放才不会化在汤里。",
      "visual_cue": "萝卜半透明，汤面微微翻动"
    },
    {
      "n": 4,
      "text": "放入红薯片继续小火煮八分钟，煮到红薯能用筷子轻松插入。",
      "time_min": 9,
      "heat": "小火",
      "tip": "红薯一插透就关火，再煮就散成泥了。",
      "visual_cue": "红薯边缘圆润，筷子一插即透"
    },
    {
      "n": 5,
      "text": "关火把味噌放在汤勺里化开再倒回锅中，撒葱花，用盐调整咸度。",
      "time_min": 5,
      "heat": "无火",
      "tip": "味噌一定关火后再化开，煮沸会损失香气。",
      "visual_cue": "汤色淡褐浑厚，葱花翠绿漂浮"
    }
  ],
  "tips": [
    "味噌要关火后再化开，煮沸会让香气大打折扣。",
    "红薯后放，才能保持完整的块状不被煮烂。",
    "高汤用昆布木鱼花现煮，鲜味比清水强很多。",
    "喜欢浓一点的可以多放十克味噌，但盐要相应减少。"
  ],
  "common_mistakes": [
    "味噌和汤一起大火煮沸，香气全跑光还发苦。",
    "红薯一开始就下锅，最后整锅汤变成糊。",
    "鸡肉不煎直接下水煮，汤头腥味明显。",
    "萝卜切得比红薯还薄，煮完完全找不到。"
  ],
  "substitutions": [
    {
      "original": "红薯",
      "substitute": "南瓜",
      "ratio": "300克:300克",
      "note": "南瓜更易烂，煮的时间减三分钟。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "五花肉片",
      "ratio": "300克:250克",
      "note": "油脂更多，汤更浓。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同煮，汤更有饱足感。",
    "换成白味噌，汤色更浅，甜味也更柔和。",
    "最后撒一点辣椒粉，冬天喝更暖身。"
  ],
  "serving_suggestion": "盛进厚壁汤碗里，撒上葱花，配一碗白米饭和一小碟腌菜，就是日本家庭最普通的晚饭。",
  "storage": "冷藏可放两天，复热时小火加热不要煮沸，味噌汤不宜反复加热多次。",
