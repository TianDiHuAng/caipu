  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "猪里脊",
          "name_en": "pork tenderloin",
          "amount": 300,
          "unit": "g",
          "note": "切三毫米薄片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 150,
          "unit": "g",
          "note": "切丝",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "磨成姜泥",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "浓口酱油",
          "name_en": "dark soy sauce (koikuchi)",
          "amount": 20,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "味醂",
          "name_en": "mirin",
          "amount": 20,
          "unit": "ml",
          "note": "提甜去腥",
          "optional": false
        },
        {
          "name": "清酒",
          "name_en": "sake",
          "amount": 15,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "平衡咸味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 15,
          "unit": "ml",
          "note": "煎肉用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擦泥器",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切成三毫米薄片，冷冻二十分钟稍硬后更容易切得均匀薄。",
      "time_min": 20,
      "heat": "无火",
      "tip": "半冻状态切片又快又薄，成品口感才嫩。",
      "visual_cue": "肉片厚薄一致、微透光"
    },
    {
      "n": 2,
      "text": "洋葱切细丝，姜用擦泥器磨成细泥，全部放入小碗中备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "姜泥磨得越细，酱汁挂得越匀，辣味也更柔和。",
      "visual_cue": "姜泥细腻、洋葱丝均匀"
    },
    {
      "n": 3,
      "text": "小碗中倒入浓口酱油、味醂、清酒，加白糖和姜泥搅匀成调味汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "调味汁先调好再下锅，避免炒肉时手忙脚乱。",
      "visual_cue": "酱汁均匀、糖粒溶化"
    },
    {
      "n": 4,
      "text": "平底锅放植物油烧热，下洋葱丝中火炒到边缘变软透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒出甜味再下肉，酱汁才不会被生洋葱水稀释。",
      "visual_cue": "洋葱边缘透明、略塌"
    },
    {
      "n": 5,
      "text": "把里脊片抖散铺进锅里，中大火煎到两面变白，不要频繁翻动。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "肉片铺平不叠压才能上色，翻动过多会出水变柴。",
      "visual_cue": "肉片两面转白、边缘微焦"
    },
    {
      "n": 6,
      "text": "沿锅边淋入调味汁，大火翻炒到酱汁浓稠裹住肉片即可关火。",
      "time_min": 2,
      "heat": "大火",
      "tip": "汁收到能裹住肉片就停，收太干会发咸发苦。",
      "visual_cue": "酱汁浓稠挂肉、锅底几乎干"
    }
  ],
  "tips": [
    "里脊要逆着纹理切，嚼起来不塞牙；梅花肉则更肥润。",
    "姜泥分两次用，一半入调味汁一半出锅前撒，辛香更有层次。",
    "调味汁的甜咸比例可按一勺酱油配一勺味醂微调。"
  ],
  "common_mistakes": [
    "肉片切得太厚，煎完外老内生，酱汁也挂不住。",
    "调味汁一次性倒入后小火慢煮，肉片久煮发柴。",
    "洋葱炒得不够透就下肉，成品出汤、酱汁稀薄。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "猪颈肉",
      "ratio": "300g 对 300g",
      "note": "猪颈肉脂肪多，煎时油可减半。"
    },
    {
      "original": "味醂",
      "substitute": "米酒加白糖",
      "ratio": "20ml 对 20ml 加 5g",
      "note": "甜味稍薄，需略加糖补足。"
    }
  ],
  "variations": [
    "加一勺味噌调成味噌生姜烧，酱香更浓。",
    "出锅前淋少许柠檬汁，酸甜更清爽。"
  ],
  "serving_suggestion": "盛在白饭上，配卷心菜丝与味噌汤是经典定食组合。",
  "storage": "冷藏两天，复热用平底锅小火回温，避免微波变韧。",
