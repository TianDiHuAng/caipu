  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "莲藕去皮切薄片，泡醋水十分钟。，保持中小火，颜色才够亮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡水去泥，颜色才白。，保持中小火，香气才不跑。",
      "visual_cue": "薄片透亮，水清无浑，火别太大，口感才不散。"
    },
    {
      "n": 2,
      "text": "捞出沥干，切成细条再冲一次。，翻动放轻，成品才好看。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切条均匀，炒时才同步熟。，留意锅底，整道菜才立得住。",
      "visual_cue": "条形一致，手感脆，时间掐准，食材才不糊。"
    },
    {
      "n": 3,
      "text": "胡萝卜切细丝，和莲藕分开放。，翻动放轻，形状才完整。",
      "time_min": 5,
      "heat": "无火",
      "tip": "分开下锅，火候才不冲突。，动作放连贯，口感才不散。",
      "visual_cue": "丝细如线，颜色分明，留意锅底，细节才到位。"
    },
    {
      "n": 4,
      "text": "炒锅倒香油，小火煸干辣椒出香。，盖盖焖一会儿，味道才不闷。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒别炒黑，会发苦。，别用力搅，食材才不糊。",
      "visual_cue": "辣香散出，油色微黄，时间掐准，表面才漂亮。"
    },
    {
      "n": 5,
      "text": "下莲藕条大火翻炒三分钟。，下手别慌，口感才不散。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火快炒，藕才脆。，时间掐准，味道才进得去。",
      "visual_cue": "藕条透亮，边缘微黄，份量心里有数，颜色才够亮。"
    },
    {
      "n": 6,
      "text": "加胡萝卜丝再炒两分钟。，先试试温度，细节才到位。",
      "time_min": 3,
      "heat": "大火",
      "tip": "胡萝卜后放，才不软烂。，动作放连贯，成品才好看。",
      "visual_cue": "丝条分明，颜色鲜亮，火别太大，食材才不糊。"
    },
    {
      "n": 7,
      "text": "倒浓口酱油、清酒和白糖翻匀。，汤汁别收太干，味道才不闷。",
      "time_min": 3,
      "heat": "中火",
      "tip": "沿锅边淋，香气才冲。，份量心里有数，火候才均匀。",
      "visual_cue": "汁水收干，油光浮动，保持中小火，细节才到位。"
    },
    {
      "n": 8,
      "text": "炒到汁干，撒芝麻拌匀出锅。，别用力搅，口感才有层次。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汁干才香，别留汤水。，翻动放轻，风味才干净。",
      "visual_cue": "表面油亮，芝麻粘匀，注意别烧干，锅气才足。"
    }
  ],
  "tips": [
    "莲藕泡醋水，颜色才不发黑。，别用力搅，味道才不闷。",
    "全程大火快炒，藕才够脆。，起锅前尝味，香气才留得住。",
    "汁要收干，口感才利落。，时间掐准，成品才稳当。"
  ],
  "common_mistakes": [
    "炒太久，藕条发软。，汤汁别收太干，香气才不跑。",
    "酱油倒太多，咸得发苦。，注意别烧干，形状才完整。",
    "不泡水，藕片发黑。，下手别慌，整道菜才立得住。"
  ],
  "substitutions": [
    {
      "original": "莲藕",
      "substitute": "牛蒡",
      "ratio": "600 克:600 克",
      "note": "纤维更粗，需多炒两分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "辣椒粉",
      "ratio": "3 克:2 克",
      "note": "辣味更均匀，出锅前撒。"
    }
  ],
  "variations": [
    "加一点米醋，酸味更清。，慢慢来别急，食材才不糊。",
    "加鸡肉丝同炒，做成主菜。，时间掐准，细节才到位。"
  ],
  "serving_suggestion": "冷吃热吃都行，配便当最合适。，汤汁别收太干，细节才到位。",
  "storage": "冷藏两天，风味更入味。，份量心里有数，咸淡才好把握。",
