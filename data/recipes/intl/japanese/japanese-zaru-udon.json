  "equipment": [
    "汤锅",
    "漏勺",
    "竹帘",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "清水加木鱼花小火煮三分钟，关火过滤出清汤放凉。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蘸汁要提前放凉，热汁会把冷面泡软。",
      "visual_cue": "汤色浅金，滤网下没有碎屑"
    },
    {
      "n": 2,
      "text": "清汤里加日式酱油与味醂搅匀，尝一下咸度后冷藏。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蘸汁要比平时口味咸一些，配面才刚好。",
      "visual_cue": "汁色深琥珀，表面清亮无浮油"
    },
    {
      "n": 3,
      "text": "白萝卜擦成细腻的泥，轻轻挤掉多余水分备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "只挤一次，留一点水分口感才不会柴。",
      "visual_cue": "萝卜泥雪白细密，捏起来微湿"
    },
    {
      "n": 4,
      "text": "大锅烧水加盐，乌冬面抖散下锅煮到完全浮起。",
      "time_min": 7,
      "heat": "大火",
      "tip": "水要多火要大，乌冬面才不会粘成一团。",
      "visual_cue": "乌冬面翻滚浮起，中心没有白芯"
    },
    {
      "n": 5,
      "text": "捞出乌冬立刻过冰水，边冲边用手轻搓到表面滑爽。",
      "time_min": 3,
      "heat": "无火",
      "tip": "这一步叫紧面，冷热一冲乌冬面才有嚼劲。",
      "visual_cue": "乌冬面紧实发亮，摸起来不粘手"
    },
    {
      "n": 6,
      "text": "乌冬面沥干水，整齐码在竹帘上，撒海苔丝与葱花。",
      "time_min": 3,
      "heat": "无火",
      "tip": "乌冬面沥得越干越好，水多会把蘸汁冲淡。",
      "visual_cue": "乌冬面条条分明，竹帘下没有积水"
    },
    {
      "n": 7,
      "text": "小碗蘸汁里放萝卜泥与葱花，夹起乌冬面蘸着吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "萝卜泥在最后放进蘸汁，香气才最清新。",
      "visual_cue": "蘸汁清亮，萝卜泥飘在表面"
    }
  ],
  "tips": [
    "用冰水过面是关键，乌冬面弹性差别很大。",
    "蘸汁可按口味加一点柚子皮屑提香。",
    "乌冬面要现煮现过水，放过冰箱会变硬。",
    "配一小碟天妇罗，就是常见的日式套餐。"
  ],
  "common_mistakes": [
    "煮好之后不过冰水，乌冬面软塌没有嚼劲。",
    "蘸汁煮好不冷藏，温热的汁把面泡得发黏。",
    "乌冬面沥水不彻底，蘸汁很快就被冲淡。"
  ],
  "substitutions": [
    {
      "original": "乌冬面",
      "substitute": "面粉",
      "ratio": "400克:300克",
      "note": "自制乌冬面需和面醒发，工序更复杂。"
    },
    {
      "original": "白萝卜",
      "substitute": "姜",
      "ratio": "60克:15克",
      "note": "辛辣感更强，用量要减少。"
    }
  ],
  "variations": [
    "蘸汁里加一勺炒香的白芝麻，香气更厚重。",
    "配炸虾和炸茄子，做成天妇罗冷乌冬。"
  ],
  "serving_suggestion": "竹帘上桌配一小碗冰镇蘸汁，夹起一口面蘸一下就吃，餐后再配一杯冷麦茶解暑。",
  "storage": "乌冬面现煮现吃最好，蘸汁冷藏可以存放两天。",
