  "equipment": [
    "小煎锅",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切三厘米块，洋葱顺纹切细丝，小葱切末备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱顺纹切，煮后不易散且口感好。",
      "visual_cue": "鸡块大小均匀，洋葱丝细长"
    },
    {
      "n": 2,
      "text": "小锅放高汤、生抽、味醂、清酒与白糖，中火煮开调成煮汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "煮汁先尝一口，甜咸要平衡。",
      "visual_cue": "液体微沸，香气甜中带咸"
    },
    {
      "n": 3,
      "text": "下洋葱丝煮两分钟，煮到洋葱变软呈半透明状。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱先煮出甜味，再下鸡肉。",
      "visual_cue": "洋葱软塌，半透明"
    },
    {
      "n": 4,
      "text": "放入鸡腿肉块，摊平后加盖小火煮六分钟至肉变白。",
      "time_min": 6,
      "heat": "小火",
      "tip": "鸡肉要摊平受热，堆叠会外熟内生。",
      "visual_cue": "鸡肉通体变白，煮汁冒小泡"
    },
    {
      "n": 5,
      "text": "鸡蛋轻轻打散，保留部分蛋清不搅匀，分两次淋在鸡肉上。",
      "time_min": 3,
      "heat": "小火",
      "tip": "别打太匀，蛋白蛋黄分明才有层次。",
      "visual_cue": "蛋液带明显白色纹路"
    },
    {
      "n": 6,
      "text": "第一次蛋液半凝固后淋第二次，盖盖焖一分钟关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "关火用余温把蛋焖到半熟，嫩滑才到位。",
      "visual_cue": "蛋液表面半凝，中心仍湿润"
    },
    {
      "n": 7,
      "text": "连汁滑到热米饭上，撒海苔丝与小葱末趁热吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "动作要快，蛋在半熟状态最好吃。",
      "visual_cue": "蛋层颤巍巍，米饭不塌"
    }
  ],
  "tips": [
    "用鸡腿肉比鸡胸嫩，久煮也不柴。",
    "蛋液分两次淋是关西做法，口感层次更明显。",
    "米饭要热，冷饭会把蛋液温度拉低。"
  ],
  "common_mistakes": [
    "蛋液一次性倒完，全部凝固成蛋饼，失去滑嫩感。",
    "鸡肉堆在一起煮，外面老了里面还带粉。",
    "煮汁收得太干，滑到饭上时没有汁水。"
  ],
  "substitutions": [
    {
      "original": "味醂",
      "substitute": "白糖加清酒",
      "ratio": "30 毫升:10 克糖加20毫升清酒",
      "note": "甜味直白些，需减少生抽五毫升。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "250 克:250 克",
      "note": "切薄片并缩短煮制两分钟。"
    }
  ],
  "variations": [
    "加一把三叶芹或鸭儿芹，香气更清新。",
    "把鸡肉换成炸猪排，就是猪排丼的雏形。"
  ],
  "serving_suggestion": "盛在热米饭上，配一碗味噌汤与渍物同食。",
  "storage": "现做现吃最佳；冷藏一天后复热须小火加少许高汤，避免蛋变硬。",
