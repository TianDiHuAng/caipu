  "equipment": [
    "蒸锅",
    "耐热碗",
    "保鲜膜",
    "硅胶垫",
    "细筛"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草莓用清水冲净后摘去蒂部，再用厨房纸把表面水分彻底吸干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "草莓表面一点水都不能带，湿的会让豆沙打滑脱开。",
      "visual_cue": "草莓干爽不反光，蒂部切口平整"
    },
    {
      "n": 2,
      "text": "红豆沙分成四份压成圆饼，把草莓尖头朝下整个裹住，搓成圆球冷藏待用。",
      "time_min": 9,
      "heat": "无火",
      "tip": "豆沙要裹到完全看不见红色果肉，外层厚薄一致才不漏。",
      "visual_cue": "豆沙球表面光滑，看不出草莓轮廓"
    },
    {
      "n": 3,
      "text": "糯米粉、白糖加清水搅成稀糊，过筛后盖上保鲜膜，水开后中火蒸十二分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "中途取出搅拌一次，粉糊受热均匀才不会夹生。",
      "visual_cue": "粉糊从乳白变成半透明的光泽糊团"
    },
    {
      "n": 4,
      "text": "蒸好的粉团趁热倒在撒了玉米淀粉的硅胶垫上，翻拌散热后揉到光滑有弹性。",
      "time_min": 5,
      "heat": "无火",
      "tip": "手上沾淀粉再碰面团，趁热揉才不粘且更易延展。",
      "visual_cue": "面团光滑能拉长而不易断裂"
    },
    {
      "n": 5,
      "text": "粉团分四份压成圆片，包入豆沙球捏紧收口，收口朝下摆进纸托。",
      "time_min": 6,
      "heat": "无火",
      "tip": "粉片中心留厚边留薄，包起来顶部才不容易破皮。",
      "visual_cue": "成品圆润饱满，收口处平整无痕"
    }
  ],
  "tips": [
    "草莓选当天新鲜的，放软的果肉一压就出水，包不住。",
    "粉团蒸好后用手指按压，回弹有韧性才算完全熟透。",
    "做好后一小时内吃掉，冷藏会让糯米皮明显变硬。"
  ],
  "common_mistakes": [
    "草莓没擦干就包，豆沙滑脱且外皮渗水发黏。",
    "粉糊蒸得时间不足，中心带生浆，放凉后硬得咬不动。",
    "收口没捏紧，切开时豆沙从底部漏出来。"
  ],
  "substitutions": [
    {
      "original": "草莓",
      "substitute": "猕猴桃",
      "ratio": "1:1",
      "note": "切掉两端并吸干汁水后再包。"
    },
    {
      "original": "红豆沙",
      "substitute": "白豆沙",
      "ratio": "1:1",
      "note": "甜度更高，可把白糖减到十五克。"
    }
  ],
  "variations": [
    "糯米粉里加两克抹茶粉，可做带茶香的抹茶大福，配红豆沙更协调。"
  ],
  "serving_suggestion": "常温静置十分钟定型，配无糖抹茶同食，甜度刚好平衡。",
  "storage": "当天食用最佳，冷藏不超过一天，吃前回温十分钟。",
