  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 4,
          "unit": "piece",
          "note": "室温，回温后更易打匀",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切细末，可选",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "提鲜上色",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "关西偏甜",
          "optional": false
        },
        {
          "name": "清酒",
          "name_en": "sake",
          "amount": 10,
          "unit": "ml",
          "note": "去蛋腥",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 60,
          "unit": "ml",
          "note": "让蛋液更嫩",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "每次薄薄刷一层",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "一撮",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "方形煎蛋锅",
    "筷子",
    "细网筛",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打入碗中，加生抽、白糖、清酒、盐和清水，用筷子竖着划拌，撒入小葱末。",
      "time_min": 5,
      "heat": "无火",
      "tip": "筷子划散不要打发，避免打入空气形成气泡孔洞。",
      "visual_cue": "蛋液均匀无蛋筋、表面几乎无泡"
    },
    {
      "n": 2,
      "text": "蛋液过细网筛两遍，滤掉蛋筋和气泡，静置两分钟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛是切面平整的关键，偷懒会有密密麻麻的气孔。",
      "visual_cue": "蛋液顺滑、筛网残留少量稠物"
    },
    {
      "n": 3,
      "text": "方锅小火预热，用厨房纸蘸植物油薄薄擦一层，倒入三分之一蛋液。",
      "time_min": 4,
      "heat": "小火",
      "tip": "油只要薄薄一层，多了会起泡且卷不紧。",
      "visual_cue": "蛋液铺满锅底、边缘开始凝固"
    },
    {
      "n": 4,
      "text": "表面还有流动蛋液时，用筷子从外向内卷起，推回锅的一端。",
      "time_min": 3,
      "heat": "小火",
      "tip": "卷第一层最容易破，手轻一点、宁可早卷别等全熟。",
      "visual_cue": "蛋皮卷成圆柱、表面无破口"
    },
    {
      "n": 5,
      "text": "锅底再擦油，把蛋卷推回前端，倒入第二份蛋液，抬起蛋卷让蛋液流到底下。",
      "time_min": 4,
      "heat": "小火",
      "tip": "抬卷子让蛋液流进缝里，层与层才会粘紧不散。",
      "visual_cue": "新蛋液与旧蛋卷边缘连成一体"
    },
    {
      "n": 6,
      "text": "重复卷起后倒入最后一份蛋液，卷好后利用余温定形，取出稍凉切段。",
      "time_min": 6,
      "heat": "小火",
      "tip": "出锅后用竹帘或保鲜膜卷紧定形两分钟，切面更漂亮。",
      "visual_cue": "蛋卷紧实方正、切面呈同心层"
    }
  ],
  "tips": [
    "全程小火，火大蛋皮一上色就发硬且带焦味。",
    "糖量可按口味增减，关东偏咸、关西偏甜。",
    "加一小勺蟹肉棒或芝士夹心，做成更丰富的版本。"
  ],
  "common_mistakes": [
    "蛋液打发过度，成品全是气孔且质地发松。",
    "锅太热就倒蛋液，底部焦了上面还是液体。",
    "等蛋皮全熟才卷，边缘干硬卷起即裂。"
  ],
  "substitutions": [
    {
      "original": "清酒",
      "substitute": "米酒",
      "ratio": "10ml 对 10ml",
      "note": "酒味较冲，需提前烧开挥发。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "10g 对 10g",
      "note": "需先碾碎才能化开。"
    }
  ],
  "variations": [
    "夹入一片烤海苔与芝士，做成流心芝士厚蛋烧。",
    "加入切碎的小葱与柴鱼片，做成关东风味的咸香版。"
  ],
  "serving_suggestion": "切段装盘，作为便当配菜或寿司的蛋料，早餐配白饭与味噌汤也行。",
  "storage": "冷藏两天，冷食亦可；复热用平底锅干煎三十秒或微波低火。",
