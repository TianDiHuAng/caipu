  "steps": [
    {
      "n": 1,
      "text": "米淘洗三遍，加水按一比一点二煮成饭。，看准状态再往下做。",
      "time_min": 25,
      "heat": "大火",
      "tip": "水比平时略少，盖饭的饭才不黏。，看准状态再往下做。",
      "visual_cue": "米粒分明，锅盖冒白气"
    },
    {
      "n": 2,
      "text": "猪里脊切成两厘米厚片，用刀背轻拍松。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "拍松断筋，炸后不缩不硬。，看准状态再往下做。",
      "visual_cue": "肉片变宽，厚度均匀"
    },
    {
      "n": 3,
      "text": "肉片撒盐和黑胡椒腌十分钟入味。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌十分钟，底味才进得去。，看准状态再往下做。",
      "visual_cue": "表面微湿，调料附着"
    },
    {
      "n": 4,
      "text": "依次裹面粉、蛋液和面包糠，压紧边缘。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面包糠压紧，炸时不易脱落。，看准状态再往下做。",
      "visual_cue": "外壳均匀，无裸露，这一点很关键。"
    },
    {
      "n": 5,
      "text": "植物油烧到六成热，中火炸四分钟捞出。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温别太高，肉才熟透。，看准状态再往下做。",
      "visual_cue": "外壳金黄，浮起油面"
    },
    {
      "n": 6,
      "text": "升高油温复炸三十秒，逼出多余油分。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "复炸一次，外壳才酥脆不软。，看准状态再往下做。",
      "visual_cue": "外壳深金，声音清脆"
    },
    {
      "n": 7,
      "text": "炸排切两厘米条，洋葱丝与酱油、味醂和白糖调的汁煮开。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "汁要煮开再放料，味道才融合。，看准状态再往下做。",
      "visual_cue": "汁面翻滚，甜香散出"
    },
    {
      "n": 8,
      "text": "洋葱煮软后放炸排，淋上打散的蛋液盖锅焖。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋液分两次淋，层次才好看。，看准状态再往下做。",
      "visual_cue": "蛋液半凝，盖住肉排"
    },
    {
      "n": 9,
      "text": "蛋液半熟时关火，连汁盖在热饭上撒小葱。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蛋液半熟就够，盖饭的热气会继续焖。",
      "visual_cue": "蛋面流心，葱末翠绿"
    }
  ],
  "tips": [
    "肉要拍松，炸后才不硬。，这一点很关键。",
    "复炸一次，外壳才酥。，这一点很关键。",
    "蛋液半熟关火，盖饭上还会继续焖熟。"
  ],
  "common_mistakes": [
    "肉不拍松，咬起来像橡皮。，这一点很关键。",
    "蛋液全熟才关火，口感变干。，这一点很关键。",
    "汁收太干，饭拌不开。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡腿肉",
      "ratio": "500 克:500 克",
      "note": "更嫩，炸三分钟即可。"
    },
    {
      "original": "面包",
      "substitute": "面包糠",
      "ratio": "100 克:100 克",
      "note": "更省事，颗粒均匀。"
    }
  ],
  "variations": [
    "加一片芝士，融化后更浓郁。，这一点很关键。",
    "用味噌代替部分酱油，酱香更厚。，这一点很关键。"
  ],
  "serving_suggestion": "趁热吃，配一碗味噌汤。，这一点很关键。",
  "storage": "炸排冷藏两天，复热烤箱一百八十度八分钟。",
