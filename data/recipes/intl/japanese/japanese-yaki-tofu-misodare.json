          "name_en": "sugar",
          "amount": 6,
          "unit": "g",
          "note": "提甜",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 15,
          "unit": "ml",
          "note": "刷烤盘",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "烤盘",
    "刷子",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐用厨房纸包好压十分钟，挤掉水分后切成三角形厚块，每块约一厘米半。",
      "time_min": 10,
      "heat": "无火",
      "tip": "三角块受热面积大，边缘容易烤出焦香。",
      "visual_cue": "豆腐紧实，切面平整不散"
    },
    {
      "n": 2,
      "text": "小碗里放味噌、味醂和白糖，用勺背压着搅成顺滑的酱料，不要有颗粒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "味噌颗粒要是没化开，烤完会有咸疙瘩",
      "visual_cue": "酱料顺滑，能拉出细纹"
    },
    {
      "n": 3,
      "text": "烤盘刷一层植物油，豆腐块摆上去，表面也薄薄刷一层油防止风干。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷油能替代油炸，表面烤出来一样亮。",
      "visual_cue": "豆腐表面泛光，不干裂"
    },
    {
      "n": 4,
      "text": "烤箱预热到两百度，豆腐先烤十分钟，烤到表面微微上色定型。",
      "time_min": 12,
      "heat": "无火",
      "tip": "预热到位再放，温度不够豆腐只会出水。",
      "visual_cue": "表面微黄，形状挺立不塌"
    },
    {
      "n": 5,
      "text": "取出豆腐在表面抹一层味噌酱，抹匀后回炉再烤五分钟到酱料起泡发亮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酱抹薄一层，厚了烤完会咸，也容易焦。",
      "visual_cue": "酱面起泡，颜色红亮发亮"
    },
    {
      "n": 6,
      "text": "出炉后撒白芝麻和小葱碎，趁热装盘，配一碗热米饭一起吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出炉三分钟内吃完最好，酱一凉就发硬",
      "visual_cue": "酱香扑鼻，芝麻零星点缀"
    }
  ],
  "tips": [
    "味噌本身很咸，抹酱只要一层，不要像涂面包那样厚厚铺满。",
    "味噌和味醂先调匀再抹，涂得开，烤出来的颜色也均匀。",
    "想更浓的焦香，最后两分钟转上火烤，但要守着炉子看颜色。"
  ],
  "common_mistakes": [
    "豆腐水分不压力，烤出来一盘水，表面怎么也上不了色。",
    "味噌酱抹太厚，表面先焦里面还咸得发苦，只能刮掉重来。",
    "烤好马上刷第二次酱，成品咸得下不了口，酱量要一次给够。"
  ],
  "substitutions": [
    {
      "original": "味噌",
      "substitute": "白味噌",
      "ratio": "40克:45克",
      "note": "白味噌咸度低，糖可减到四克。"
    },
    {
      "original": "北豆腐",
      "substitute": "油豆腐",
      "ratio": "450克:300克",
      "note": "油豆腐本身带油，烤制时间减到八分钟。"
    }
  ],
  "variations": [
    "在味噌酱里加半勺柚子皮屑，香气更清爽，适合夏天配啤酒。",
    "改用平底锅煎代替烤箱，两面各煎三分钟后抹酱，同样好吃。"
  ],
  "serving_suggestion": "三块豆腐配一小碗米饭和腌菜，就是日式家常的一餐，配清酒也很合适。",
  "storage": "冷藏可放两天，回热用烤箱一百八十度烤三分钟，微波加热会让酱料流散。",
