  "equipment": [
    "平底锅",
    "厨房纸",
    "刀",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扇贝用厨房纸吸干表面水，两面撒黑胡椒。，火候要稳，别忽大忽小。",
      "time_min": 5,
      "heat": "无火",
      "tip": "扇贝一定要干，才能煎出焦面。，火候要稳，别忽大忽小。",
      "visual_cue": "表面干爽，胡椒附着"
    },
    {
      "n": 2,
      "text": "平底锅烧到微微冒烟，倒植物油铺开。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "锅够热，扇贝下去才会立刻上色。，火候要稳，别忽大忽小。",
      "visual_cue": "油面泛光，微微起烟"
    },
    {
      "n": 3,
      "text": "扇贝下锅，别动，煎一分半到边缘金黄。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "别急着翻，动了就出不了焦壳。，火候要稳，别忽大忽小。",
      "visual_cue": "底面金黄，边缘收紧"
    },
    {
      "n": 4,
      "text": "翻面再煎一分钟，盛出备用。，火候要稳，别忽大忽小。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "两面各煎一次就够，久了会老。，火候要稳，别忽大忽小。",
      "visual_cue": "两面焦黄，中心半透"
    },
    {
      "n": 5,
      "text": "转小火，锅里放黄油和蒜末炒香。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油别烧焦，颜色一变就下酒。，火候要稳，别忽大忽小。",
      "visual_cue": "黄油起泡，蒜香上涌"
    },
    {
      "n": 6,
      "text": "倒清酒和生抽，煮到酱汁微微收稠。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酱汁收到能挂勺就够。，火候要稳，别忽大忽小。",
      "visual_cue": "汁体油亮，气泡变小"
    },
    {
      "n": 7,
      "text": "放回扇贝裹匀酱汁，撒小葱碎出锅。，火候要稳，别忽大忽小。",
      "time_min": 3,
      "heat": "小火",
      "tip": "回锅只翻两下，别久煮。，火候要稳，别忽大忽小。",
      "visual_cue": "扇贝挂汁，葱花翠绿"
    }
  ],
  "tips": [
    "扇贝要吸干水，才能煎出焦面。，这一点很关键。",
    "锅要够热再下锅，别急着翻。，这一点很关键。",
    "黄油最后放，才不烧焦。，这一点很关键。"
  ],
  "common_mistakes": [
    "扇贝带水下锅，煎成水煮。，这一点很关键。",
    "煎太久，扇贝缩成小块发硬。，这一点很关键。",
    "黄油一开始就下，烧成黑渣。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "扇贝",
      "substitute": "虾仁",
      "ratio": "400 克:400 克",
      "note": "煎的时间减半。"
    },
    {
      "original": "清酒",
      "substitute": "白葡萄酒",
      "ratio": "20 毫升:20 毫升",
      "note": "酸味更明显。"
    }
  ],
  "variations": [
    "加一点柠檬汁，酸香更清。，这一点很关键。",
    "撒辣椒粉，做成微辣口味。，这一点很关键。"
  ],
  "serving_suggestion": "配白饭或意面，淋上锅里的黄油汁。",
  "storage": "冷藏一天，复热用平底锅小火。，这一点很关键。",
