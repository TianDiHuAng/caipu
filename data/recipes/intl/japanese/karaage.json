  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉带皮切成五厘米大块，用生抽、料酒、蒜泥与姜泥抓匀腌二十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "带皮炸才香，皮朝下先入锅。",
      "visual_cue": "鸡块裹上腌料、色泽均匀"
    },
    {
      "n": 2,
      "text": "淀粉与面粉混匀，鸡块逐块裹粉后静置五分钟让粉返潮贴紧。",
      "time_min": 10,
      "heat": "无火",
      "tip": "返潮后炸衣不脱。",
      "visual_cue": "表面干粉转湿、粉层贴紧"
    },
    {
      "n": 3,
      "text": "植物油倒入深锅烧到 165℃，鸡块分两批下锅炸四分钟至浅金色，捞出静置三分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "第一次只炸熟，别求色。",
      "visual_cue": "外壳浅金、鸡肉定型"
    },
    {
      "n": 4,
      "text": "植物油升温到 185℃ 复炸一分半，外壳金黄酥脆后立刻捞出沥油。",
      "time_min": 3,
      "heat": "大火",
      "tip": "复炸逼油，外壳才脆得响。",
      "visual_cue": "外壳深金、敲击有声"
    },
    {
      "n": 5,
      "text": "生菜垫盘摆上鸡块，撒盐与柠檬角，趁热上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "撒盐在出锅后，外壳不返软。",
      "visual_cue": "盘面干爽、柠檬点缀"
    }
  ],
  "tips": [
    "裹粉后等五分钟让粉返潮，炸的时候才不会脱落。",
    "油量不多时分批炸，锅温才不会一下子掉下去。",
    "出锅后撒盐而不是腌时多放盐，外壳才不会出水返软。"
  ],
  "common_mistakes": [
    "鸡块湿着裹粉就下锅，炸衣整片脱落。",
    "只用一次高温炸，外皮焦黑里面还是生的。",
    "炸好堆在一起闷着，底部全是水汽，脆皮变软。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600g 对 600g",
      "note": "腌时多加 10ml 料酒，避免发柴。"
    },
    {
      "original": "淀粉",
      "substitute": "玉米淀粉",
      "ratio": "80g 对 80g",
      "note": "脆度接近。"
    }
  ],
  "variations": [
    "南蛮版：炸好淋塔塔酱与甜醋汁。",
    "辣味版：裹粉里加 5g 辣椒粉。"
  ],
  "serving_suggestion": "配生菜丝、柠檬角与日式蛋黄酱，趁热吃。",
  "storage": "冷藏可存 1 天，复热用 190℃ 烤箱烤 5 分钟恢复脆度。",
