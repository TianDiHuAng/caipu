    "木勺",
    "滤网",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切薄片，白萝卜切扇形薄片，胡萝卜切薄片，洋葱切细丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根菜切薄才容易煮软。",
      "visual_cue": "片薄均匀、丝条整齐"
    },
    {
      "n": 2,
      "text": "锅中倒香油中火烧热，下五花肉片煸炒到边缘卷起、油脂析出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉先煸出油，汤才香不腻。",
      "visual_cue": "肉片卷边、锅底出油"
    },
    {
      "n": 3,
      "text": "下白萝卜、胡萝卜与洋葱丝翻炒两分钟，让蔬菜裹上肉油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蔬菜炒过再煮，甜味更明显。",
      "visual_cue": "蔬菜微微透亮、裹上油光"
    },
    {
      "n": 4,
      "text": "倒入高汤煮开，撇净浮沫，转小火煮十分钟到萝卜片能轻松咬断。",
      "time_min": 12,
      "heat": "小火",
      "tip": "浮沫撇干净，汤才清。",
      "visual_cue": "萝卜透明、汤色清亮"
    },
    {
      "n": 5,
      "text": "关火把味噌放在滤网里，浸进汤里用勺子慢慢化开，再加生抽调味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "味噌不能煮沸，香气会散。",
      "visual_cue": "汤色浑厚、味噌完全化开"
    },
    {
      "n": 6,
      "text": "盛碗后撒上翠绿的葱花，趁热端上桌，配一碗热气腾腾的饭。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花最后撒，香气才冲。",
      "visual_cue": "葱花翠绿、汤面微沸"
    }
  ],
  "tips": [
    "五花肉先煸出油，汤的香气才够厚而不腻。",
    "味噌必须关火后再化开，一旦煮滚香气就跑光了。",
    "味噌与生抽的咸度都不低，高血压人群请减量使用。"
  ],
  "common_mistakes": [
    "味噌直接大火煮开，汤色发暗、香气全失。",
    "五花肉不煸直接下汤，汤面上浮着一层白油。",
    "根菜切得太厚，煮二十分钟还咬着硬。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪里脊",
      "ratio": "200g 对 200g",
      "note": "油脂少，需补 5ml 香油。"
    },
    {
      "original": "味噌",
      "substitute": "韩式大酱",
      "ratio": "60g 对 55g",
      "note": "酱香更冲，咸度略高。"
    }
  ],
  "variations": [
    "牛蒡版：加 80g 牛蒡薄片，土香更足。",
    "豆乳版：最后加 150ml 无糖豆浆，口感更醇。"
  ],
  "serving_suggestion": "盛进木质汤碗，配一碗白米饭和一小碟渍物。",
  "storage": "冷藏可存 2 天，复热时小火加热，不要煮沸。",
