  "equipment": [
    "砂锅",
    "刀",
    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "三文鱼切成三厘米厚的块，用厨房纸吸干表面水分，两面薄薄撒一点盐。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼块表面一定要擦干，下锅才不粘也不腥。",
      "visual_cue": "鱼块边缘整齐，表面干爽无血水"
    },
    {
      "n": 2,
      "text": "白萝卜切成半厘米厚的半月片，胡萝卜切滚刀块，香菇去蒂划十字。",
      "time_min": 8,
      "heat": "无火",
      "tip": "萝卜切得薄一点，更容易煮透也更加入味。",
      "visual_cue": "萝卜片厚薄一致，香菇刀口整齐"
    },
    {
      "n": 3,
      "text": "砂锅放植物油，中火把大葱段炒出香味，再倒入高汤煮开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "葱段先炒过再煮汤，甜味会明显更足。",
      "visual_cue": "葱段边缘微焦，汤面开始冒泡"
    },
    {
      "n": 4,
      "text": "先下白萝卜与胡萝卜，转中小火煮十分钟，把根菜的甜味煮出来。",
      "time_min": 10,
      "heat": "中小火",
      "tip": "萝卜要煮到用筷子能扎透，汤才不寡淡。",
      "visual_cue": "萝卜片边缘透明，筷子可轻松插入"
    },
    {
      "n": 5,
      "text": "放入三文鱼块与香菇，加清酒和味醂，保持小火煮八分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "鱼块下锅后别频繁翻动，容易碎成渣。",
      "visual_cue": "鱼肉由橙转粉白，表面紧实"
    },
    {
      "n": 6,
      "text": "把味噌放在汤勺里用汤化开再倒回锅里，下北豆腐再煮三分钟即可。",
      "time_min": 5,
      "heat": "小火",
      "tip": "味噌化开再入锅，避免结块沉底糊锅。",
      "visual_cue": "汤色浑浊带酱香，豆腐完整不碎"
    }
  ],
  "tips": [
    "味噌选白味噌或混合味噌，汤底更柔和。",
    "三文鱼可以带皮，皮煮软后胶质丰富。",
    "加一小块黄油收尾，汤会更圆润浓郁。",
    "最后可以下乌冬面吸汤，一锅两吃。"
  ],
  "common_mistakes": [
    "味噌直接扔进锅里，结块后很难化开还会糊底。",
    "大火猛煮鱼块，鱼肉散开汤里全是渣。",
    "根菜没煮透就下鱼，萝卜硬得咬不动。"
  ],
  "substitutions": [
    {
      "original": "三文鱼",
      "substitute": "鲭鱼",
      "ratio": "360克:360克",
      "note": "腥味略重，清酒加十毫升去腥。"
    },
    {
      "original": "北豆腐",
      "substitute": "嫩豆腐",
      "ratio": "250克:250克",
      "note": "更嫩更滑，下锅后煮两分钟就够。"
    }
  ],
  "variations": [
    "加一把白菜同煮，汤汁会变得更清甜爽口。",
    "换成味噌加辣椒粉做辣味版本，冬天更暖身。"
  ],
  "serving_suggestion": "端上桌直接连锅吃，先喝一口带酱香的汤，再夹一块吸满汤汁的萝卜，鱼肉软嫩，豆腐滑口。",
  "storage": "冷藏可存一天，复热时加少量高汤小火煮开，别反复滚沸以免鱼肉散开。",
