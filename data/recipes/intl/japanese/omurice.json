    "炒锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉 200g 去骨切成 1 厘米丁，洋葱、胡萝卜、香菇分别切成同样大小的丁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "所有丁切一样大，熟度才一致。",
      "visual_cue": "丁块大小均匀、颗粒分明"
    },
    {
      "n": 2,
      "text": "炒锅放 15g 黄油小火融化，下鸡肉丁炒 4 分钟至表面变白。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡肉先炒变色，再下蔬菜。",
      "visual_cue": "鸡肉转白、表面微黄"
    },
    {
      "n": 3,
      "text": "加入洋葱、胡萝卜与香菇丁炒 3 分钟，再倒入 400g 米饭炒散。",
      "time_min": 5,
      "heat": "中火",
      "tip": "隔夜饭先用手抓松再下锅。",
      "visual_cue": "米粒分明、无结块"
    },
    {
      "n": 4,
      "text": "加 40g 番茄酱、3g 盐与 1g 黑胡椒炒匀，盛出分成两份装盘。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄酱炒一下去酸，更香。",
      "visual_cue": "米饭均匀上色、颗粒油亮"
    },
    {
      "n": 5,
      "text": "平底锅倒 10ml 植物油，倒入一半蛋液，小火煎成半凝固蛋皮。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蛋液半凝固就要离火，才嫩。",
      "visual_cue": "蛋皮边缘凝固、中心微湿"
    },
    {
      "n": 6,
      "text": "把一份炒饭放在蛋皮一侧，用锅铲翻折包住，滑入盘中，另一份同样操作后淋番茄酱。",
      "time_min": 6,
      "heat": "小火",
      "tip": "动作要快，蛋皮才不会全熟变硬。",
      "visual_cue": "蛋包完整、表面金黄湿润"
    }
  ],
  "tips": [
    "蛋液煎到半凝固就离火，余温会继续加热。",
    "隔夜饭先抓松再下锅，炒出来才粒粒分明。",
    "番茄酱先炒一下，酸味会变得柔和。"
  ],
  "common_mistakes": [
    "鸡蛋煎到全熟发硬，包饭时一折就裂。",
    "米饭太湿下锅，炒出来黏成一团。",
    "番茄酱没炒直接拌，饭带着生酸味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡胸肉",
      "ratio": "200g 对 200g",
      "note": "更清爽，需多放 5g 黄油防柴。"
    },
    {
      "original": "番茄酱",
      "substitute": "番茄膏",
      "ratio": "60g 对 40g",
      "note": "需加 5g 糖平衡酸味。"
    }
  ],
  "variations": [
    "咖喱版：炒饭加 15g 咖喱粉。",
    "和风版：蛋包饭表面淋蘑菇奶油酱代替番茄酱。"
  ],
  "serving_suggestion": "蛋包饭上桌后淋一条番茄酱，配一份蔬菜沙拉。",
  "storage": "现做现吃，冷藏后再热蛋皮会变韧。",
