          "name_en": "shiitake mushroom",
          "amount": 20,
          "unit": "g",
          "note": "温水泡发留汁",
          "optional": false
        },
        {
          "name": "豆角",
          "name_en": "green beans",
          "amount": 100,
          "unit": "g",
          "note": "去筋切段",
