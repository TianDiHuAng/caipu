          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 15,
          "unit": "ml",
          "note": "煸鸡肉",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 300,
          "unit": "ml",
          "note": "含香菇泡汁",
