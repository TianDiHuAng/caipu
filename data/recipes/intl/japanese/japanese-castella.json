  "equipment": [
    "烤箱",
    "打蛋器",
    "木框模",
    "筛子",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进大碗，加白糖用打蛋器高速打发。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "打到能画出纹路不消失才行。，看准状态再往下做。",
      "visual_cue": "蛋糊蓬松，纹路停留"
    },
    {
      "n": 2,
      "text": "蜂蜜、味醂和牛奶混合，隔水温热搅匀。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "温热的蜜才容易拌进蛋糊。，看准状态再往下做。",
      "visual_cue": "液体顺滑，无颗粒，这一点很关键。"
    },
    {
      "n": 3,
      "text": "蛋糊转低速整理气泡，打到细腻有光泽。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "低速收尾，气泡才细密。，看准状态再往下做。",
      "visual_cue": "糊面光亮，无大气泡"
    },
    {
      "n": 4,
      "text": "筛入面粉，用刮刀翻拌到无干粉。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "翻拌别画圈，消泡就发不起来。，看准状态再往下做。",
      "visual_cue": "面糊顺滑，无粉块，这一点很关键。"
    },
    {
      "n": 5,
      "text": "沿碗边倒入温蜜液，轻轻翻拌均匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "沿边倒，冲击小不易消泡。，看准状态再往下做。",
      "visual_cue": "面糊流动，油亮细腻"
    },
    {
      "n": 6,
      "text": "模具抹植物油铺纸，面糊倒进去震出气泡。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "震两下，烤出的切面才没大孔。，看准状态再往下做。",
      "visual_cue": "糊面平整，气泡上浮"
    },
    {
      "n": 7,
      "text": "烤箱一百六十度烤十分钟，取出划几刀。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "划刀让表面平整，不裂成大缝。，看准状态再往下做。",
      "visual_cue": "表面结皮，刀痕整齐"
    },
    {
      "n": 8,
      "text": "回炉再烤三十分钟，竹签插入不带糊。，看准状态再往下做。",
      "time_min": 30,
      "heat": "无火",
      "tip": "竹签干净就熟，别急着出炉。，看准状态再往下做。",
      "visual_cue": "表面深金，签面干净"
    },
    {
      "n": 9,
      "text": "出炉连模震一下，倒扣放凉后切块。，看准状态再往下做。",
      "time_min": 15,
      "heat": "无火",
      "tip": "连模震出热气，蛋糕才不塌。，看准状态再往下做。",
      "visual_cue": "切面细密，气孔均匀"
    }
  ],
  "tips": [
    "全蛋要打到纹路不消失，蛋糕才蓬松。",
    "面粉用翻拌，画圈会消泡。，这一点很关键。",
    "出炉震模，组织才不塌陷。，这一点很关键。"
  ],
  "common_mistakes": [
    "蛋没打发到位，蛋糕像饼。，这一点很关键。",
    "翻拌画圈，面糊全消泡。，这一点很关键。",
    "高温猛烤，表面焦里面还湿。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "麦芽糖",
      "ratio": "40 克:40 克",
      "note": "更黏，需先温水化开。"
    },
    {
      "original": "味醂",
      "substitute": "清水",
      "ratio": "20 毫升:20 毫升",
      "note": "少了酒香，保湿略差。"
    }
  ],
  "variations": [
    "底部撒粗糖，烤出沙沙的口感。，这一点很关键。",
    "加一勺抹茶粉，做成抹茶长崎蛋糕。"
  ],
  "serving_suggestion": "切厚片配牛奶或咖啡。，这一点很关键。",
  "storage": "密封常温两天，冷藏四天。，这一点很关键。",
