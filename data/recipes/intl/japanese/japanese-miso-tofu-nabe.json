  "equipment": [
    "砂锅",
    "汤勺",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "昆布放冷水泡二十分钟，加木鱼花小火煮三分钟过滤成高汤。",
      "time_min": 26,
      "heat": "小火",
      "tip": "昆布先泡透再下锅煮，鲜味才出得干净。",
      "visual_cue": "汤色浅金透明，滤网下无碎屑"
    },
    {
      "n": 2,
      "text": "豆腐切三厘米见方的块，用厨房纸轻轻吸掉表面水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "吸干水分豆腐才不易碎，也更能吸味。",
      "visual_cue": "豆腐块完整不散，表面不再渗水"
    },
    {
      "n": 3,
      "text": "砂锅里先铺洋葱片，再摆入豆腐、胡萝卜与香菇。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱垫在锅底防粘锅，也能让汤更甜。",
      "visual_cue": "食材分层码好，色彩分明"
    },
    {
      "n": 4,
      "text": "倒入高汤与味醂，中火煮开转小火，盖上锅盖焖五分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "刚煮开就转小火，大火会把豆腐冲散。",
      "visual_cue": "汤面微沸，豆腐表面微微颤动"
    },
    {
      "n": 5,
      "text": "舀一点热汤把味噌在小碗里化开，再倒回锅里。",
      "time_min": 3,
      "heat": "小火",
      "tip": "味噌不能久煮，化开后回锅一沸就关火。",
      "visual_cue": "汤色转为乳褐，香气浓郁"
    },
    {
      "n": 6,
      "text": "尝味后补少量日式酱油，撒小葱丝，连锅上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "味噌本身已经够咸，日式酱油只做微调。",
      "visual_cue": "汤色浑厚，葱花翠绿浮在面上"
    }
  ],
  "tips": [
    "白味噌偏甜、红味噌偏咸，各半混合最平衡。",
    "豆腐用嫩豆腐口感滑，用老豆腐更耐煮。",
    "锅里加一把乌冬面，就是味噌乌冬锅。",
    "味噌化开后再回锅，避免结块沉底。"
  ],
  "common_mistakes": [
    "味噌直接丢进滚汤里，结成一团团化不开。",
    "大火久煮，豆腐被冲成碎渣汤色变浑。",
    "味噌放太多又加酱油，整锅咸得发苦。"
  ],
  "substitutions": [
    {
      "original": "味噌",
      "substitute": "日式酱油",
      "ratio": "60克:40毫升",
      "note": "风味更单薄，可加白糖五克。"
    },
    {
      "original": "木鱼花",
      "substitute": "昆布",
      "ratio": "10克:20克",
      "note": "纯素高汤，泡的时间延长十分钟。"
    }
  ],
  "variations": [
    "加几片薄切的猪肉同煮，鲜味会更足。",
    "起锅前放一把菠菜，颜色和口感都更好。"
  ],
  "serving_suggestion": "连砂锅端上桌，热汤配米饭吃，冬天可分食一锅。",
  "storage": "冷藏一天，复热时加少量清水，味噌不要重复久煮。",
