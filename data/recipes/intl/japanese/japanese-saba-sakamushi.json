  "equipment": [
    "蒸锅",
    "深盘",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲭鱼去头去内脏，把腹腔内的黑膜刮干净，鱼身两面各划两刀方便入味。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黑膜是腥味最重的地方，一定要刮到见白，这一步千万别省。",
      "visual_cue": "鱼身洁净，腹腔不见黑膜，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "鱼身内外抹一层薄盐，静置十分钟后用水冲净，再用厨房纸把表面水分吸干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "薄盐逼出血水再冲掉，蒸出来才不腥，火候和顺序都要留神。",
      "visual_cue": "鱼皮干爽，表面不见水痕，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "昆布用湿布擦净铺在深盘底，鲭鱼放在昆布上，鱼身铺姜丝和一半大葱段。",
      "time_min": 4,
      "heat": "无火",
      "tip": "昆布垫底不接触水，靠蒸汽出鲜也防粘盘，提前把配料备好再动手更稳。",
      "visual_cue": "鱼身摆正，姜丝铺匀，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "沿盘边淋入米酒和生抽，让汁水从边缘流下，不要直接浇在鱼身上。",
      "time_min": 3,
      "heat": "无火",
      "tip": "沿边淋汁保住鱼皮的完整和表面的调味，这一步千万别省。",
      "visual_cue": "盘底有汁，鱼身干爽，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "蒸锅水开后放入深盘，盖盖中火蒸十分钟，关火后再焖两分钟取出。",
      "time_min": 14,
      "heat": "中火",
      "tip": "水开后再放盘，鱼肉受热快，肉质才嫩，火候和顺序都要留神。",
      "visual_cue": "鱼眼发白突出，鱼皮微鼓，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "倒掉盘中多余汁水，铺上剩下的大葱段和新鲜姜丝，淋一勺盘底清汁上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "旧汁腥味重，换上新葱姜再淋汁才清爽，提前把配料备好再动手更稳。",
      "visual_cue": "鱼身雪白，葱姜翠绿，颜色和形态变化明显"
    }
  ],
  "tips": [
    "鲭鱼腥味重，鱼身内外抹薄盐静置十分钟再冲净，血水去掉了才不腥。",
    "蒸鱼的酒一定要沿盘边淋，直接浇在鱼身上会把表面的盐和鲜味冲掉。",
    "蒸好后别立刻开盖，多焖两分钟让鱼肉利用余温定型，肉不易散。"
  ],
  "common_mistakes": [
    "鱼没有去净腹内黑膜，蒸出来整盘带苦腥味，怎么调味都压不住。",
    "大火蒸了十五分钟，鱼肉纤维收缩挤出水分，吃起来又干又柴。",
    "昆布和鱼一起冷水下锅慢蒸，昆布黏液析出，汤汁发黏不清爽。"
  ],
  "substitutions": [
    {
      "original": "鲭鱼",
      "substitute": "鳕鱼",
      "ratio": "400克:400克",
      "note": "鳕鱼肉更松，蒸的时间减少三分钟。"
    },
    {
      "original": "米酒",
      "substitute": "白葡萄酒",
      "ratio": "60毫升:60毫升",
      "note": "果酸更明显，可省去生抽改撒盐。"
    }
  ],
  "variations": [
    "盘底垫两片柚子同蒸，果皮的清香能压住鱼的腥气，是日式料理店的常见做法。",
    "把酒换成味噌调开的汤，做成味噌蒸鲭鱼，咸香更厚。"
  ],
  "serving_suggestion": "连盘上桌，撒姜丝和葱段，淋一勺盘底的汤汁，配白米饭和腌萝卜。",
  "storage": "冷藏可放一天，回热用蒸锅复蒸四分钟，微波会让鱼肉发硬失去水分。",
