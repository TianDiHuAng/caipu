    "savory"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 150,
          "unit": "g",
          "note": "三枚,常温",
          "optional": false
        },
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 350,
          "unit": "ml",
          "note": "放凉,昆布柴鱼高汤",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "虾仁",
          "name_en": "peeled shrimp",
          "amount": 60,
          "unit": "g",
          "note": "去壳",
          "optional": false
        },
        {
          "name": "香菇",
          "name_en": "shiitake mushroom",
          "amount": 50,
          "unit": "g",
          "note": "切薄片",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "味醂",
          "name_en": "mirin",
          "amount": 10,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 8,
          "unit": "g",
          "note": "切细末",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "茶碗或小碗",
    "蒸锅",
    "筛网",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打散但不要打出泡沫，用筷子贴着碗底划散蛋液。",
      "time_min": 4,
      "heat": "无火",
      "tip": "动作轻一点，起泡会让成品表面坑洼。",
      "visual_cue": "蛋液均匀，表面几乎无泡"
    },
    {
      "n": 2,
      "text": "放凉的高汤加生抽、味醂与盐调匀，缓缓倒入蛋液中拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "高汤必须放凉，热汤会把蛋液烫成蛋花。",
      "visual_cue": "混合液颜色均匀，表面无泡沫"
    },
    {
      "n": 3,
      "text": "混合液过筛两遍，滤掉系带和气泡，得到细腻蛋液。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过筛是表面光滑的关键步骤，别省。",
      "visual_cue": "滤网上留下絮状物，液体顺滑"
    },
    {
      "n": 4,
      "text": "蛋液分装到茶碗中，约七分满，表面泡沫用勺子撇掉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "只装七分满，蒸时膨胀才不会溢出。",
      "visual_cue": "液面平整，无泡沫"
    },
    {
      "n": 5,
      "text": "虾仁与香菇片用沸水焯半分钟，轻轻放入蛋液中。",
      "time_min": 3,
      "heat": "中火",
      "tip": "配料先焯过，蒸时才不会出水。",
      "visual_cue": "配料沉在碗中，浮在表面"
    },
    {
      "n": 6,
      "text": "碗口盖保鲜膜或小盘，放入上汽的蒸锅中小火蒸十二分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "必须小火，大蒸汽会让蛋液起蜂窝。",
      "visual_cue": "蛋面平滑如镜，轻晃微颤"
    },
    {
      "n": 7,
      "text": "取出茶碗撒上小葱末，趁热用小勺一口一口挖着吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蒸好后焖一分钟再开盖，避免骤然回缩。",
      "visual_cue": "表面光滑，点缀翠绿"
    }
  ],
  "tips": [
    "蛋液与高汤的比例约一比二点三，口感最嫩。",
    "一定要用小火，水沸腾太猛蛋就会起孔洞。",
    "盖保鲜膜能防止锅盖水滴落，表面才平滑。"
  ],
  "common_mistakes": [
    "高汤没放凉就倒进蛋液，直接烫成蛋花汤。",
    "大火蒸导致蛋面起满蜂窝，口感粗糙发老。",
    "蛋液没过筛，成品表面坑洼还带腥味。"
  ],
  "substitutions": [
    {
      "original": "高汤",
      "substitute": "清水加鸡精",
      "ratio": "350 毫升:350 毫升",
      "note": "鲜味稍弱，可多加五毫升生抽。"
    },
    {
      "original": "虾仁",
      "substitute": "蟹肉棒",
      "ratio": "60 克:60 克",
      "note": "撕成细丝，蒸制时间缩短两分钟。"
    }
  ],
  "variations": [
    "加一片银杏或百合，是日式料理店的常见版本。",
    "把虾换成鸡腿肉切小丁，口感更扎实也更饱腹。"
  ],
  "serving_suggestion": "趁热用小勺挖食，配一小碟柚子醋或直接吃。",
  "storage": "现蒸现吃最佳；冷藏一天后复蒸五分钟，口感会略老。",
