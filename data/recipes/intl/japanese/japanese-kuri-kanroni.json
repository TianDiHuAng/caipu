          "name_en": "water",
          "amount": 600,
          "unit": "ml",
          "note": "煮制与浸泡",
          "optional": false
        },
        {
          "name": "味醂",
          "name_en": "mirin",
          "amount": 20,
          "unit": "ml",
          "note": "增亮",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "衬托甜味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "小刀",
    "漏勺",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "栗子外壳划一道口，放沸水里煮五分钟，趁热剥掉硬壳与褐色内膜。",
      "time_min": 10,
      "heat": "大火",
      "tip": "趁热剥内膜最容易，凉了就粘在果肉上。",
      "visual_cue": "栗子果肉完整，表面干净无内膜"
    },
    {
      "n": 2,
      "text": "剥好的栗子泡进清水里十分钟，去掉表面残留的涩味与碎屑。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡水能让颜色更干净，煮出来不发黑。",
      "visual_cue": "水面清亮，栗子表面干净"
    },
    {
      "n": 3,
      "text": "汤锅加四百毫升清水与白糖，小火加热到糖完全化开成糖水。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖要完全化开再下栗子，否则甜度不均。",
      "visual_cue": "糖水清亮，锅底没有糖粒"
    },
    {
      "n": 4,
      "text": "放入栗子，保持小火煮十五分钟，中间用漏勺轻轻推动防止粘底。",
      "time_min": 15,
      "heat": "小火",
      "tip": "全程小火慢慢煨，大火会把栗子煮散。",
      "visual_cue": "栗子完整饱满，糖水微微发黄"
    },
    {
      "n": 5,
      "text": "加味醂与盐，继续小火煮十分钟，让糖水收到栗子高度的一半。",
      "time_min": 10,
      "heat": "小火",
      "tip": "盐只要一点点，能把甜味托起来更耐吃。",
      "visual_cue": "糖水变稠挂勺，栗子表面发亮"
    },
    {
      "n": 6,
      "text": "关火后让栗子泡在糖水里放凉，装罐冷藏，第二天风味更透。",
      "time_min": 3,
      "heat": "无火",
      "tip": "泡一夜甜味才进心，急着吃只有表面甜。",
      "visual_cue": "糖水呈琥珀色，栗子色泽金黄"
    }
  ],
  "tips": [
    "买带壳生栗子自己剥，比现成去壳的更香。",
    "糖水里的味醂可以用等量清酒代替。",
    "煮好的糖水别倒，浇在冰淇淋上很好吃。",
    "密封冷藏可以存一周，越发入味。"
  ],
  "common_mistakes": [
    "栗子内膜没剥净，煮出来带明显苦味。",
    "大火猛煮，栗子散成碎块，糖水也变浑浊。",
    "糖水没过栗子太多还收得急，栗子被煮烂。"
  ],
  "substitutions": [
    {
      "original": "栗子",
      "substitute": "红薯",
      "ratio": "300克:300克",
      "note": "切滚刀块，煮的时间缩短到二十分钟。"
    },
    {
      "original": "味醂",
      "substitute": "清酒",
      "ratio": "20毫升:20毫升",
      "note": "甜味略淡，白糖可多加五克。"
    }
  ],
  "variations": [
    "加一片紫苏叶同煮，能带出一点清香味。",
    "把白糖换成黑糖，做成黑糖风味的甘露煮。"
  ],
  "serving_suggestion": "装在玻璃小碗里，琥珀色的栗子泡在浓糖水里，配一杯热茶，一颗一颗慢慢吃最有滋味。",
  "storage": "连糖水装进密封罐冷藏可存一周，取用时用干净无水无油的勺子。",
