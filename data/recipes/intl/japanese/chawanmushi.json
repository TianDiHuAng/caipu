  "equipment": [
    "茶碗",
    "蒸锅",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切 2cm 块，用 10ml 料酒抓匀腌 10 分钟；虾去虾线后切半。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鸡肉块小才和蛋液同步熟。",
      "visual_cue": "鸡肉表面微黏、无血水"
    },
    {
      "n": 2,
      "text": "鸡蛋打散但不打发，加 450ml 高汤、10ml 生抽、15ml 味醂与 3g 盐轻轻拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "不要打出气泡，气泡会让成品有孔洞。",
      "visual_cue": "蛋液呈均匀浅黄、表面少泡"
    },
    {
      "n": 3,
      "text": "蛋液过筛两遍，滤掉系带与泡沫，静置 3 分钟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛是成品光滑如布丁的关键。",
      "visual_cue": "蛋液细腻无杂质、泡沫浮于表面被撇去"
    },
    {
      "n": 4,
      "text": "茶碗中放入鸡块、香菇片与虾，倒入蛋液至八分满，盖一层锡纸。",
      "time_min": 5,
      "heat": "无火",
      "tip": "只倒八分满，蒸时膨胀才不外溢。",
      "visual_cue": "配料沉底、液面平整"
    },
    {
      "n": 5,
      "text": "蒸锅水开后放入茶碗，中小火蒸 12 分钟，锅盖留一条缝。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "留缝能降气压，蛋面才不起蜂窝。",
      "visual_cue": "表面凝固轻晃会颤、无蜂窝孔"
    },
    {
      "n": 6,
      "text": "取出静置 2 分钟，淋少许生抽与香油，趁热食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置后内部温度均匀，口感最嫩。",
      "visual_cue": "蛋羹如布丁般细腻、勺子插入不塌"
    }
  ],
  "tips": [
    "蛋液与高汤比例约 1:3，成品最嫩滑。",
    "火不能大，中小火并留缝是防蜂窝的核心。",
    "配料先用热水烫一下，可避免下沉底部的半熟。"
  ],
  "common_mistakes": [
    "蛋液没过滤网直接蒸，表面布满小孔像马蜂窝。",
    "大火猛蒸，蛋液沸腾后内部组织被冲散成渣。",
    "高汤温度太高直接冲蛋液，蛋液直接结块。"
  ],
  "substitutions": [
    {
      "original": "高汤",
      "substitute": "清水加鸡精",
      "ratio": "450ml 对 450ml 加 3g 鸡精",
      "note": "风味稍薄，可加 5ml 生抽补味。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "120g 对 120g",
      "note": "鸡胸更瘦，切 1.5cm 小块防柴。"
    }
  ],
  "variations": [
    "蟹肉版：面上铺 60g 蟹肉棒丝，鲜甜更突出。",
    "银杏版：加 6 颗银杏果，是日式秋季吃法。"
  ],
  "serving_suggestion": "作为日式定食的前菜，用木勺舀食，配清汤与渍物。",
  "storage": "现蒸现吃，冷藏后蛋羹会出水失嫩，不建议隔夜。",
