          "optional": false
        },
        {
          "name": "味醂",
          "name_en": "mirin",
          "amount": 15,
          "unit": "ml",
          "note": "增甜香",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 3,
          "unit": "g",
