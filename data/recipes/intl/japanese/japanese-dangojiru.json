  "steps": [
    {
      "n": 1,
      "text": "面粉倒进盆里，分次加清水揉成偏硬的面团，盖上湿布醒十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团要比饺子面硬一点，软了揪下锅就散，煮成一锅浆糊。",
      "visual_cue": "面团光洁不粘手，按下去回弹"
    },
    {
      "n": 2,
      "text": "醒好的面团擀成半厘米厚的面片，切成两指宽的条，再揪成小段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面片别擀太薄，煮的时候要经得住滚，薄了下锅就烂。",
      "visual_cue": "面片厚薄均匀，边缘利落"
    },
    {
      "n": 3,
      "text": "清水入锅烧开，下白萝卜与胡萝卜片煮八分钟至萝卜半透明。",
      "time_min": 8,
      "heat": "中火",
      "tip": "萝卜先煮透，甜味才进到汤里，后面团子下去汤才有底味。",
      "visual_cue": "萝卜片半透明，汤色微乳白"
    },
    {
      "n": 4,
      "text": "把面片抖散下锅煮三分钟，加香菇、豆腐与生抽再煮五分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "面片下锅后用勺子推一下锅底，粘底的那几片最容易煮烂。",
      "visual_cue": "面片全部浮起，边缘煮到微软"
    },
    {
      "n": 5,
      "text": "转小火把味噌用汤化开淋回锅里，撒大葱段，一滚即关火。",
      "time_min": 6,
      "heat": "小火",
      "tip": "味噌最后放且不要大滚，煮开太久发酵的香气会跑光。",
      "visual_cue": "汤色淡酱褐，葱段翠绿"
    }
  ],
  "tips": [
    "团子汤是日本宫崎和大分的家常汤，冬天一家人围着一锅吃。",
    "面片揪成不规则形状才好，边缘粗糙更容易挂汤。",
    "加一勺芝麻油在汤面，香气更足，是九州一带的吃法。"
  ],
  "common_mistakes": [
    "面团揉得太软，下锅全散，汤变成一锅面糊。",
    "味噌一开始就下锅煮半小时，汤发苦，豆香也失去了。",
    "面片一次性全倒进锅，粘成一坨，煮出来是面疙瘩。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "糯米粉",
      "ratio": "200克:200克",
      "note": "糯米粉版口感更糯，需多煮两分钟。"
    },
    {
      "original": "味噌",
      "substitute": "黄豆酱",
      "ratio": "50克:55克",
      "note": "黄豆酱咸度高，生抽可省。"
    }
  ],
  "variations": [
    "加几片五花肉同煮，汤更油润，是山里农家的丰盛版本。",
    "把面片换成手擀乌冬条，做成口感更筋道的版本。"
  ],
  "serving_suggestion": "盛进深碗，撒一点葱花，冬天配一小碟腌萝卜最暖胃。",
  "storage": "冷藏可存一天，面片会吸汤变软，复热需另加清水与少许味噌。",
