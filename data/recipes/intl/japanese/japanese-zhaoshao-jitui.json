  "equipment": [
    "平底锅",
    "菜刀",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用刀在厚处划几刀压平，用厨房纸吸干表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划刀让厚薄一致，煎时才熟得匀。",
      "visual_cue": "鸡腿肉平整、厚度约两厘米"
    },
    {
      "n": 2,
      "text": "生抽、米酒、白糖、老抽加清水调成照烧汁，搅到糖完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汁先调好，收汁时才不会手忙脚乱。",
      "visual_cue": "照烧汁均匀、颜色深褐"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油，鸡皮朝下入锅，中小火煎六分钟逼出鸡油。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "鸡皮朝下先煎，皮才酥脆不油腻。",
      "visual_cue": "鸡皮金黄、锅底见鸡油"
    },
    {
      "n": 4,
      "text": "翻面再煎四分钟，用铲子压住鸡肉让受热均匀。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "压一压鸡肉，肉厚的部分才熟透。",
      "visual_cue": "两面金黄、按压有弹性"
    },
    {
      "n": 5,
      "text": "倒掉多余鸡油，放入姜片，倒入照烧汁，中小火煮到汁液变浓稠。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "汁收浓时会很快焦，要盯着翻面。",
      "visual_cue": "汁液挂勺、鸡皮发亮"
    },
    {
      "n": 6,
      "text": "取出鸡腿切成条状摆盘，淋上锅里的照烧汁，撒白芝麻与葱丝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "切之前静置两分钟，肉汁不流失。",
      "visual_cue": "切面白嫩、表面酱亮"
    }
  ],
  "tips": [
    "没有米酒可用料酒加一点白糖替代，味道接近。",
    "收汁到能挂住勺背就好，太稠会发苦。",
    "鸡腿肉比鸡胸更耐煎，别用鸡胸代替。"
  ],
  "common_mistakes": [
    "鸡皮朝上先煎，鸡皮卷起缩成一团。",
    "大火收汁，糖分在锅底烧焦发黑带苦味。",
    "鸡肉没划刀，煎完中间还带血水。"
  ],
  "substitutions": [
    {
      "original": "米酒",
      "substitute": "清酒",
      "ratio": "30ml 对 30ml",
      "note": "清酒甜度低，白糖加到 15g。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅中",
      "ratio": "400g 对 500g",
      "note": "鸡翅煎的时间要加三分钟。"
    }
  ],
  "variations": [
    "照烧汁里加一勺蜂蜜，光泽更漂亮。",
    "出锅前撒一点七味粉，带一丝微辣更解腻。"
  ],
  "serving_suggestion": "铺在白饭上做成照烧鸡腿饭，配一份蔬菜即可。",
  "storage": "冷藏两天，复热用平底锅小火两面各煎一分钟。",
