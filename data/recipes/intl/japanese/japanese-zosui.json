  "equipment": [
    "砂锅",
    "打蛋器",
    "碗",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "米饭用清水冲一遍，洗掉表面黏性。，全程留意火候，别贪快。",
      "time_min": 4,
      "heat": "无火",
      "tip": "洗去黏性，杂炊才清爽不糊。，火大了就离锅远一点。",
      "visual_cue": "米粒分散，水变浑，成败就在这一步。"
    },
    {
      "n": 2,
      "text": "砂锅里高汤烧开，加生抽和盐调味。，火别开太大，稳着来。",
      "time_min": 6,
      "heat": "大火",
      "tip": "汤味要略淡，米会吸走咸味。，锅温要匀，别忽高忽低。",
      "visual_cue": "汤面翻滚，香气上涌"
    },
    {
      "n": 3,
      "text": "下米饭用汤勺轻轻拨散，别用力压。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "中火",
      "tip": "拨散就好，压了就成糊。，火候宁小勿大，慢慢推进。",
      "visual_cue": "米粒散开，汤色微黄"
    },
    {
      "n": 4,
      "text": "小火煮八分钟，让米粒吸饱汤汁。，注意锅里温度别掉下来。",
      "time_min": 9,
      "heat": "小火",
      "tip": "小火慢煮，米粒才不烂。，始终中小火，别心急。",
      "visual_cue": "米粒饱满，汤面微沸"
    },
    {
      "n": 5,
      "text": "鸡蛋打散，沿锅边绕圈淋进去。，火要均匀，食材才不糊。",
      "time_min": 3,
      "heat": "小火",
      "tip": "淋成细线，蛋花才漂亮。，看住火，别让它失控。",
      "visual_cue": "蛋液铺开，边缘凝固"
    },
    {
      "n": 6,
      "text": "盖锅焖一分钟，让蛋花定型。，全程留意火候，别贪快。",
      "time_min": 2,
      "heat": "小火",
      "tip": "焖一下，蛋花才嫩不散。，火大了就离锅远一点。",
      "visual_cue": "蛋花成形，汤面平静"
    },
    {
      "n": 7,
      "text": "撒小葱、紫菜和白胡椒，连锅端上桌。，火别开太大，稳着来。",
      "time_min": 2,
      "heat": "无火",
      "tip": "白胡椒去腥，别省。，锅温要匀，别忽高忽低。",
      "visual_cue": "葱花翠绿，热气腾腾"
    }
  ],
  "tips": [
    "米饭先冲洗，杂炊才清爽。，这点要注意。",
    "汤味调淡，米会吸咸。，这是关键点。",
    "蛋液淋成细线，蛋花才嫩。，别嫌麻烦，做完它。"
  ],
  "common_mistakes": [
    "用力搅动，米饭糊成团。，这一步别省。",
    "汤太咸，煮完无法入口。，别跳过这步。",
    "蛋液一次倒完，结成一块。，这步最关键。"
  ],
  "substitutions": [
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "1000 毫升:1000 毫升",
      "note": "需多加生抽提味。"
    },
    {
      "original": "米饭",
      "substitute": "大米",
      "ratio": "400 克:150 克",
      "note": "煮的时间加十分钟。"
    }
  ],
  "variations": [
    "加几片鸡肉，鲜味更足。，很多人在这里出错。",
    "加一点姜丝，暖身更好。，这里最容易翻车。"
  ],
  "serving_suggestion": "连锅上桌，配一碟腌萝卜。，别小看这一步。",
  "storage": "冷藏一天，复热加水调稀。，成败就在这一步。",
