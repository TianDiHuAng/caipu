        }
      ]
    }
  ],
  "equipment": [
    "小碗",
    "电饭锅",
    "打蛋器",
    "量勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋从冷藏取出放十分钟回温，磕进小碗里打散。",
      "time_min": 12,
      "heat": "无火",
      "tip": "回温过的蛋更容易打匀，也不会有腥味。",
      "visual_cue": "蛋液颜色均匀，蛋清完全看不见"
    },
    {
      "n": 2,
      "text": "日式酱油与味醂混匀成调味汁，芝麻小火炒香备用。",
      "time_min": 4,
      "heat": "小火",
      "tip": "芝麻一响就离火，颜色变深就是炒过头了。",
      "visual_cue": "芝麻微微跳动，闻到坚果香"
    },
    {
      "n": 3,
      "text": "热米饭盛进碗里，用饭勺轻轻拨松让蒸汽散开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "饭拨松后蛋液才挂得均匀，不会一坨一坨。",
      "visual_cue": "米饭松散有光泽，表面不再冒大团热气"
    },
    {
      "n": 4,
      "text": "把蛋液绕着圈淋在热饭上，靠饭的温度让它半凝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "饭要够烫，蛋液才能被烫到微微发白。",
      "visual_cue": "蛋液在饭面流动，边缘开始变白"
    },
    {
      "n": 5,
      "text": "淋上调味汁，撒小葱圈、海苔丝与炒香的芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "调味汁沿碗边淋一圈，味道分布更均匀。",
      "visual_cue": "酱色在蛋液上晕开，葱花芝麻点缀"
    },
    {
      "n": 6,
      "text": "用筷子从碗底往上翻拌，让蛋黄裹住每一粒米饭。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌到饭粒泛着蛋液光泽的时候就该吃了。",
      "visual_cue": "米饭泛金黄光泽，粒粒分明不发黏"
    }
  ],
  "tips": [
    "鸡蛋一定要新鲜，生食风险才可控。",
    "饭越热越好吃，最好刚出锅就拌。",
    "加几滴香油进去，香气会更立体。",
    "没有海苔就用紫菜片剪碎，口感相近。"
  ],
  "common_mistakes": [
    "用冷饭拌蛋，蛋液挂在饭上黏糊糊还带腥味。",
    "蛋液没有打匀，碗里混着成块的蛋清。",
    "调味汁一次倒太多，整碗饭咸得吃不下。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "豆腐",
      "ratio": "120克:200克",
      "note": "素版用嫩豆腐拌饭，须加热后食用。"
    },
    {
      "original": "日式酱油",
      "substitute": "盐",
      "ratio": "20毫升:3克",
      "note": "咸味更单纯，需加几滴香油补香。"
    }
  ],
  "variations": [
    "加一小块黄油拌开，奶香和蛋香很搭。",
    "再撒上一点七味粉上去，风味更刺激。"
  ],
  "serving_suggestion": "刚拌好立刻吃，配一碗味噌汤和一小碟腌菜就是完整早餐。",
  "storage": "现做现吃，不宜存放，拌好的饭放置超过两小时就不要再吃。",
