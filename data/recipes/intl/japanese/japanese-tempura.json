  "equipment": [
    "深锅",
    "油温计",
    "长筷",
    "沥油网架"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾去壳保留尾节，在腹部横切三四刀并轻压拉直，防止炸制时卷曲，用厨房纸吸干表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腹部断筋是虾保持笔直的关键，切口浅一些不要切断。",
      "visual_cue": "虾身笔直挺立，表面干爽不黏"
    },
    {
      "n": 2,
      "text": "茄子斜切成扇形薄片，南瓜切成三毫米厚的片，青椒去籽切条，所有蔬菜摊在盘中晾干表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蔬菜表面带水会让面衣脱落，也会让油剧烈起泡。",
      "visual_cue": "蔬菜片厚薄一致，切面没有水珠"
    },
    {
      "n": 3,
      "text": "清水与鸡蛋轻轻搅匀成蛋液，倒入低筋面粉后用筷子划几下，保留粉粒与结块，面糊呈稀薄流动状。",
      "time_min": 3,
      "heat": "无火",
      "tip": "面糊切忌搅顺滑，起筋后炸出的面衣会发硬发油。",
      "visual_cue": "面糊稀薄，里面能看见细小粉疙瘩"
    },
    {
      "n": 4,
      "text": "植物油倒入深锅烧到一百七十度，虾先拍少量干粉再裹面糊，尾部捏住垂直下锅，分两批炸约九十秒到面衣浅金且硬挺。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温可用面糊滴入测试，沉底后立刻浮起即合适。",
      "visual_cue": "面衣迅速膨起，油面气泡均匀密集"
    },
    {
      "n": 5,
      "text": "蔬菜依次裹糊下锅，茄子与青椒炸约一分钟，南瓜炸约一分半，捞出立在网架上沥油，不要叠压。",
      "time_min": 6,
      "heat": "中火",
      "tip": "立着沥油能让多余油滴落，平铺会积油变软。",
      "visual_cue": "面衣轻盈蓬松，敲击有清脆声响"
    },
    {
      "n": 6,
      "text": "高汤、生抽与味醂小火煮开，加盐调味做成蘸汁，白萝卜擦成泥稍挤水分放入汁中，天妇罗出锅即食。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蘸汁不要久煮，沸腾过久咸味会变重。",
      "visual_cue": "蘸汁呈清澈的琥珀色，表面无浮沫"
    }
  ],
  "tips": [
    "面糊要现调现炸，放置十分钟以上会出面筋，面衣不再轻盈。",
    "每炸完一批要捞出油中碎屑，否则会烧焦发苦。"
  ],
  "common_mistakes": [
    "面糊搅拌过度至顺滑，成品面衣厚重发硬且吸油。",
    "一次下太多食材导致油温骤降，面衣吸油呈软塌状态。"
  ],
  "substitutions": [
    {
      "original": "低筋面粉",
      "substitute": "天妇罗专用粉",
      "ratio": "150g 对 150g",
      "note": "专用粉蓬松度更好，面衣更轻。"
    },
    {
      "original": "基围虾",
      "substitute": "白虾",
      "ratio": "400g 对 400g",
      "note": "白虾个头小，炸制时间缩短至一分钟。"
    }
  ],
  "variations": [
    "加入紫苏叶或香菇做成素天妇罗拼盘。",
    "蘸汁里加少量姜泥，风味更清爽。"
  ],
  "serving_suggestion": "作为主菜配米饭与味噌汤，或作为面食的浇头。",
  "storage": "炸物最好现炸现吃，冷藏后复热需用烤箱两百度烤五分钟恢复脆度。",
