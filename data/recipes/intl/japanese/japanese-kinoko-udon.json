  "equipment": [
    "汤锅",
    "平底锅",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "昆布冷水泡二十分钟后加木鱼花小火煮三分钟，过滤成高汤。",
      "time_min": 26,
      "heat": "小火",
      "tip": "昆布不要煮滚，边缘冒泡就捞出，汤才清。",
      "visual_cue": "汤色浅金，滤网下没有碎屑"
    },
    {
      "n": 2,
      "text": "平底锅中火放少量油，洋葱丝炒到透明发软出甜香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱先炒透了，汤底的甜味才有层次。",
      "visual_cue": "洋葱丝透明塌软，锅底微微上色"
    },
    {
      "n": 3,
      "text": "下香菇片摊开煎到边缘微卷，闻到浓郁的菌香。",
      "time_min": 7,
      "heat": "中火",
      "tip": "香菇别急着翻动，煎出焦边香气最足。",
      "visual_cue": "香菇片边缘卷起，表面出现浅焦斑"
    },
    {
      "n": 4,
      "text": "倒入高汤、日式酱油与味醂，小火煮五分钟让味道融合。",
      "time_min": 7,
      "heat": "小火",
      "tip": "全程都用小火慢煮，汤才不会越煮越咸。",
      "visual_cue": "汤色转琥珀，香菇吸饱汤汁变沉"
    },
    {
      "n": 5,
      "text": "另起锅烧水，乌冬面抖散下锅煮到中心不发白。",
      "time_min": 6,
      "heat": "大火",
      "tip": "乌冬先抖散再下锅，煮好不会粘成团。",
      "visual_cue": "乌冬面浮起散开，掐开中心无白点"
    },
    {
      "n": 6,
      "text": "乌冬面捞进碗里，浇上热菌菇汤，撒上小葱段与少许盐调味完成。",
      "time_min": 3,
      "heat": "无火",
      "tip": "碗先用热水烫过一遍，上桌时汤才够烫。",
      "visual_cue": "汤面清亮油润，葱花碧绿浮面"
    }
  ],
  "tips": [
    "香菇混一点平菇，口感层次更丰富。",
    "乌冬煮好过一下冷水，乌冬面更弹。",
    "汤里加一小勺味噌，风味会更厚。",
    "剩下的汤底拿来泡米饭也很好吃。"
  ],
  "common_mistakes": [
    "香菇直接下汤煮，菌香出不来汤发寡。",
    "乌冬煮过头变得软烂，筷子一夹就断。",
    "酱油和盐一起下得太重，汤咸得发涩。"
  ],
  "substitutions": [
    {
      "original": "香菇",
      "substitute": "蘑菇",
      "ratio": "200克:200克",
      "note": "香气稍淡，可加一点干香菇泡发水。"
    },
    {
      "original": "乌冬面",
      "substitute": "面粉",
      "ratio": "400克:300克",
      "note": "需自制乌冬面，工序更长。"
    }
  ],
  "variations": [
    "加一勺黄油一起煮，菌香更浓也更圆润。",
    "起锅前打一颗蛋，做成蛋花菌菇乌冬。"
  ],
  "serving_suggestion": "装深碗趁热吃，先喝汤再吃面，配一碟腌萝卜清爽收尾。",
  "storage": "面与汤分开冷藏一天，复热汤须煮开后再浇面。",
