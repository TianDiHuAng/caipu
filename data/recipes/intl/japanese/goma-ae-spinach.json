          "name_en": "sesame seeds",
          "amount": 40,
          "unit": "g",
          "note": "炒香后磨碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "提甜",
          "optional": false
        },
        {
          "name": "味醂",
          "name_en": "mirin",
          "amount": 10,
          "unit": "ml",
          "note": "增加光泽",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "焯水用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "研钵",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜 400g 洗净去根，切成 5 厘米长的段，茎和叶分开放置。",
      "time_min": 4,
      "heat": "无火",
      "tip": "茎叶分开烫，成熟度才一致。",
      "visual_cue": "菠菜段整齐、茎叶分堆"
    },
    {
      "n": 2,
      "text": "锅中水烧开加 3g 盐，先下菠菜茎焯 40 秒，再下叶片焯 30 秒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "加盐焯水，菠菜颜色更翠绿。",
      "visual_cue": "菠菜转深绿、茎部微软"
    },
    {
      "n": 3,
      "text": "捞出立刻放入冰水中过凉，攥干水分后轻轻抖散。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冰水过凉能锁住颜色和脆度。",
      "visual_cue": "菠菜翠绿、挤不出水"
    },
    {
      "n": 4,
      "text": "白芝麻 40g 用小火干炒 2 分钟至香气冒出，取一半放入研钵磨碎。",
      "time_min": 4,
      "heat": "小火",
      "tip": "磨到出油最香，别磨成糊。",
      "visual_cue": "芝麻香气浓、研磨后微出油"
    },
    {
      "n": 5,
      "text": "磨碎的芝麻加 20ml 生抽、10g 白糖与 10ml 味醂拌成浓稠芝麻酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱要稠一些，才能挂在菠菜上。",
      "visual_cue": "芝麻酱浓稠、颜色浅褐"
    },
    {
      "n": 6,
      "text": "把菠菜段拌入芝麻酱中，最后撒上剩余整粒白芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "上桌前再拌，菠菜才不会出水。",
      "visual_cue": "菠菜裹满芝麻酱、粒粒分明"
    }
  ],
  "tips": [
    "菠菜焯完立刻过冰水，颜色和口感都能保住。",
    "芝麻现炒现磨，香气比买现成的强很多。",
    "拌好尽快吃，放久了菠菜会出水变淡。"
  ],
  "common_mistakes": [
    "焯水时间过长，菠菜烂成糊状没口感。",
    "芝麻磨成酱糊，拌出来黏成一团。",
    "提前拌好放冰箱，出水后味道全淡了。"
  ],
  "substitutions": [
    {
      "original": "菠菜",
      "substitute": "小油菜",
      "ratio": "400g 对 400g",
      "note": "焯水时间加 30 秒，口感更脆。"
    },
    {
      "original": "白芝麻",
      "substitute": "黑芝麻",
      "ratio": "40g 对 40g",
      "note": "香气更浓，酱色偏深。"
    }
  ],
  "variations": [
    "加 10g 花生碎，口感更丰富。",
    "淋 3ml 米醋，酸香更清爽。"
  ],
  "serving_suggestion": "装小碟作为定食配菜，冷食风味最佳。",
  "storage": "冷藏可存 1 天，芝麻酱与菠菜分开保存，吃前再拌。",
