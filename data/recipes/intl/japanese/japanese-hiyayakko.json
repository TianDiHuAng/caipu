  "equipment": [
    "小碗",
    "刀",
    "厨房纸",
    "小碟"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐从盒中取出，用厨房纸包住静置五分钟吸掉表面水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水一定要吸掉，留着表面水，酱汁一淋就被稀释成淡汤。",
      "visual_cue": "豆腐表面干爽，纸变湿"
    },
    {
      "n": 2,
      "text": "豆腐切成两厘米见方的块，放进冰水里浸三分钟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冰水浸过豆腐更紧实，切面光滑不塌，口感也清爽。",
      "visual_cue": "豆腐块挺立，边缘平整"
    },
    {
      "n": 3,
      "text": "捞出豆腐沥干水，摆放在小碟中，块与块之间留缝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "留点缝隙酱汁能渗到缝里，堆成一坨只有表面有味。",
      "visual_cue": "豆腐摆稳立住，碟底没有积水"
    },
    {
      "n": 4,
      "text": "葱花、姜泥与紫菜丝分别放在豆腐上，淋生抽与香油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱汁上桌前再淋，提前淋好豆腐会出水，碟底全是淡汤。",
      "visual_cue": "配料点缀均匀，酱汁微亮"
    }
  ],
  "tips": [
    "凉拌豆腐是日本夏天的家常小菜，简单到只需好豆腐和好酱油。",
    "豆腐选嫩而不散的绢豆腐，口感才滑。",
    "加一点木鱼花和芥末，味道更接近日本居酒屋。"
  ],
  "common_mistakes": [
    "豆腐不吸水直接淋酱，碟底很快变成一汪淡汤。",
    "用老豆腐做，口感发硬，完全失了滑嫩的意思。",
    "酱汁提前淋好放半小时，豆腐出水，味道全淡了。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "内酯豆腐",
      "ratio": "300克:300克",
      "note": "内酯豆腐更嫩，切块时用刀背轻推不易碎。"
    },
    {
      "original": "生抽",
      "substitute": "淡酱油",
      "ratio": "20毫升:22毫升",
      "note": "淡酱油咸度低，可略增用量。"
    }
  ],
  "variations": [
    "放一勺芝麻酱调开，做成芝麻凉豆腐，香气更浓。",
    "加几只剥壳的熟虾仁，做成海鲜版，适合夏天当下酒菜。"
  ],
  "serving_suggestion": "冰镇后上桌，配一杯冰啤酒或清酒，当开胃小菜。",
  "storage": "现做现吃，冷藏超过半天豆腐会出水变硬，风味下降。",
