  "equipment": [
    "烤箱",
    "烤盘",
    "锡纸",
    "刀",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲭鱼两面用厨房纸吸干水，鱼皮划两刀。，火要均匀，食材才不糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划刀能让盐和热透进鱼肉。，看住火，别让它失控。",
      "visual_cue": "鱼皮干爽，刀口整齐"
    },
    {
      "n": 2,
      "text": "鱼身两面抹匀清酒，静置五分钟去腥。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "无火",
      "tip": "清酒比料酒更清，腥味去得干净。，火大了就离锅远一点。",
      "visual_cue": "表面湿润，酒香淡淡"
    },
    {
      "n": 3,
      "text": "撒盐抹匀鱼身，鱼皮朝上腌十分钟。，火别开太大，稳着来。",
      "time_min": 11,
      "heat": "无火",
      "tip": "盐别抹太厚，烤后容易过咸。，锅温要匀，别忽高忽低。",
      "visual_cue": "盐粒附着，鱼皮微亮"
    },
    {
      "n": 4,
      "text": "烤盘铺锡纸刷一层植物油，放姜丝垫底。，火力保持中等，慢慢来。",
      "time_min": 3,
      "heat": "无火",
      "tip": "垫姜丝能防止鱼皮粘在锡纸上。，火候宁小勿大，慢慢推进。",
      "visual_cue": "锡纸油亮，姜丝铺平"
    },
    {
      "n": 5,
      "text": "鲭鱼皮朝上放好，烤箱两百度烤十二分钟。，注意锅里温度别掉下来。",
      "time_min": 13,
      "heat": "无火",
      "tip": "鱼皮朝上，烤出来才脆。，始终中小火，别心急。",
      "visual_cue": "鱼皮起泡，边缘微焦"
    },
    {
      "n": 6,
      "text": "取出观察鱼皮是否鼓起发脆，再补烤三分钟。，火要均匀，食材才不糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鱼皮鼓泡就够，别烤到发干，植物油别刷多。，看住火，别让它失控。",
      "visual_cue": "表面金黄，油光泛出"
    },
    {
      "n": 7,
      "text": "挤上柠檬汁，趁热配白饭上桌。，全程留意火候，别贪快。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬最后挤，酸香才不散。，火大了就离锅远一点。",
      "visual_cue": "汁水滑落，香气清爽"
    }
  ],
  "tips": [
    "鱼身要吸干水，烤出来皮才脆。，别小看这一步。",
    "盐别抹太厚，鲭鱼本身有咸味。，成败就在这一步。",
    "垫姜丝防粘，也去腥气。，这点要注意。"
  ],
  "common_mistakes": [
    "鱼皮没吸干，烤完软塌塌。，这是关键点。",
    "盐抹太多，鱼肉发苦发咸。，别嫌麻烦，做完它。",
    "烤过头，鱼肉变柴出油。，这一步别省。"
  ],
  "substitutions": [
    {
      "original": "鲭鱼",
      "substitute": "秋刀鱼",
      "ratio": "500 克:500 克",
      "note": "烤的时间减三分钟。"
    },
    {
      "original": "清酒",
      "substitute": "料酒",
      "ratio": "30 毫升:25 毫升",
      "note": "味道略重，姜可多加。"
    }
  ],
  "variations": [
    "撒一点白芝麻，香气更足。，别跳过这步。",
    "配萝卜泥一起吃，解腻。，这步最关键。"
  ],
  "serving_suggestion": "配白饭和味噌汤，是标准的日式定食。",
  "storage": "冷藏两天，复热用烤箱不微波。，很多人在这里出错。",
