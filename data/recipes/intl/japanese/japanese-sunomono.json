          "optional": false
        },
        {
          "name": "米醋",
          "name_en": "rice vinegar",
          "amount": 45,
          "unit": "ml",
          "note": "调汁",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 20,
          "unit": "g",
          "note": "调汁",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "杀水",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "熟白芝麻",
          "name_en": "toasted white sesame",
          "amount": 10,
          "unit": "g",
          "note": "撒面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "刀",
    "砧板",
    "大碗",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净后切成薄片，撒上盐抓匀，静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐杀过水，黄瓜片才会脆而不出汤。",
      "visual_cue": "黄瓜片变软，碗底有汁"
    },
    {
      "n": 2,
      "text": "干海带用清水泡发二十分钟，泡好后切成细丝。",
      "time_min": 15,
      "heat": "无火",
      "tip": "海带泡到完全舒展，口感才不硬。",
      "visual_cue": "海带柔软，颜色转深绿"
    },
    {
      "n": 3,
      "text": "米醋、白糖和生抽放进小锅，小火加热到糖化开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "汁只要温热化糖，不要煮到滚开。",
      "visual_cue": "糖完全融化，汁液清亮"
    },
    {
      "n": 4,
      "text": "调好的醋汁倒进碗里，彻底放凉以后再来拌黄瓜。",
      "time_min": 3,
      "heat": "无火",
      "tip": "醋汁必须放凉再拌，否则黄瓜会软。",
      "visual_cue": "汁液摸着不烫手，清亮没有杂质"
    },
    {
      "n": 5,
      "text": "黄瓜片用手挤干水分，和海带丝一起放进大碗里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "黄瓜要挤到没有水滴，拌好才不会稀。",
      "visual_cue": "黄瓜片干爽，海带丝整齐"
    },
    {
      "n": 6,
      "text": "倒入放凉的醋汁抓匀，撒上熟白芝麻即可食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌好冷藏十分钟更入味，芝麻最后撒。",
      "visual_cue": "表面芝麻均匀，黄瓜透亮"
    }
  ],
  "tips": [
    "黄瓜先用盐杀水，拌好才不会出一碗汤。",
    "醋汁要放凉再拌，热汁会把黄瓜烫软。",
    "拌好后冷藏十分钟再吃，各种味道会更融合。"
  ],
  "common_mistakes": [
    "黄瓜没挤干水分，拌好变成一汪水。",
    "醋汁趁热浇上，黄瓜片立刻发软。",
    "海带泡发不彻底，吃起来又硬又腥。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "45 毫升:40 毫升",
      "note": "酸味更冲，糖量加五克。"
    },
    {
      "original": "海带",
      "substitute": "裙带菜",
      "ratio": "30 克:20 克",
      "note": "泡发更快，口感更嫩。"
    }
  ],
  "variations": [
    "放一点芥末酱一起拌，辛辣味道更开胃。"
  ],
  "serving_suggestion": "装小碟当配菜，配烤鱼或白饭都很清爽。",
  "storage": "冷藏一天内吃完，久放黄瓜会出水变软。",
  "nutrition_estimate": {
    "basis": "每份约 130 克",
