  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "把白萝卜切成薄片，胡萝卜切成小花片备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "萝卜切薄一点，煮十分钟就软透了。",
      "visual_cue": "萝卜片薄，边缘透光"
    },
    {
      "n": 2,
      "text": "香菇切片，平菇撕成条，北豆腐切成麻将大小的块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆腐切大块些，煮的时候才不散。",
      "visual_cue": "豆腐块方整，香菇和平菇大小均匀"
    },
    {
      "n": 3,
      "text": "汤锅放植物油烧热，下白萝卜片和胡萝卜片翻炒。",
      "time_min": 4,
      "heat": "中火",
      "tip": "先把蔬菜炒一遍，汤的味道会更加厚实。",
      "visual_cue": "蔬菜表面泛油，边缘微软"
    },
    {
      "n": 4,
      "text": "加入香菇片和平菇条一起翻炒，炒到出水变软。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菇和平菇要先炒出水分，鲜味才会进到汤里。",
      "visual_cue": "香菇和平菇缩小，锅中有汁"
    },
    {
      "n": 5,
      "text": "倒入清水大火烧开，再转小火慢慢煮十分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "小火煮到萝卜变透明，自然的甜味才会出来。",
      "visual_cue": "萝卜透明，汤色清亮"
    },
    {
      "n": 6,
      "text": "放入北豆腐块，再继续煮三分钟让豆腐吸味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆腐最后放进去，煮久了容易碎成渣。",
      "visual_cue": "豆腐浮起，棱角完整"
    },
    {
      "n": 7,
      "text": "味噌用少量汤化开后倒回锅里，加生抽调味撒小葱关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "味噌化开再下锅，汤才不会结块。",
      "visual_cue": "汤色乳白微黄，葱花翠绿"
    }
  ],
  "tips": [
    "味噌先用汤化开再倒回锅，汤才不会结块。",
    "蔬菜先炒一遍再加水，汤味更厚实。",
    "豆腐要最后才放进汤里，煮久了容易碎成渣。"
  ],
  "common_mistakes": [
    "味噌直接下锅不化开，汤里全是小疙瘩。",
    "大火滚煮味噌汤，香气全跑掉了。",
    "豆腐放得太早，久煮以后碎在锅里。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "油豆腐",
      "ratio": "300 克:200 克",
      "note": "吸汤更足，需先焯水去油。"
    },
    {
      "original": "白萝卜",
      "substitute": "冬瓜",
      "ratio": "200 克:200 克",
      "note": "更易软烂，煮制时间减半。"
    }
  ],
  "variations": [
    "出锅前点一点生抽，鲜味会更足一些。",
    "放几片海带一起同煮，汤会更加鲜美。"
  ],
  "serving_suggestion": "配一碗白饭和一小碟腌菜，就是日本寺院的精进料理吃法。",
  "storage": "冷藏两天，复热时小火加热不要煮沸太久；味噌汤不宜冷冻。",
