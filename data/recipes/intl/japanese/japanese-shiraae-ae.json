  "equipment": [
    "小锅",
    "研钵",
    "纱布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐用纱布包起，放在漏网上压十五分钟，挤出多余水分。",
      "time_min": 16,
      "heat": "无火",
      "tip": "压到纱布不滴水，豆腐泥才拌得稠。这一步别省，成品口感差别很明显。",
      "visual_cue": "豆腐塌实，纱布无水，锅里状态一目了然。"
    },
    {
      "n": 2,
      "text": "白芝麻倒进干锅小火炒两分钟，出香后倒进研钵磨成粗粒。",
      "time_min": 5,
      "heat": "小火",
      "tip": "炒到有香味就停，别炒到发黑发苦。火候和顺序都要留神，别图快。",
      "visual_cue": "芝麻微黄，油光渗出，颜色和形态变化清楚。"
    },
    {
      "n": 3,
      "text": "研钵里加细砂糖和生抽，继续磨到芝麻出油、变成黏稠的糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "磨到能用勺子挑起成团才算到位。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "糊体发亮，能挂勺，锅里状态一目了然。"
    },
    {
      "n": 4,
      "text": "菠菜洗净，滚水里加盐焯四十秒，捞出立刻投入冷水降温。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水里放盐，叶色更绿更透亮。这一步别省，成品口感差别很明显。",
      "visual_cue": "菜叶翠绿，梗已断生，颜色和形态变化清楚。"
    },
    {
      "n": 5,
      "text": "菠菜挤干水分，切成四厘米长的段，再轻轻挤一次去掉余水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "挤水要轻，太用力菜叶会烂。火候和顺序都要留神，别图快。",
      "visual_cue": "菜段成束，手捏不出水"
    },
    {
      "n": 6,
      "text": "豆腐泥和芝麻糊拌在一起，再和马菠菜段翻拌均匀，装小钵冷藏。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌的时候用切拌，别把菜叶搅烂。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "酱体均匀，菜叶完整，颜色和形态变化清楚。"
    }
  ],
  "tips": [
    "豆腐要用纱布包起来压十五分钟，水分挤干拌出来才不稀。",
    "芝麻现炒现磨，磨到出油发黏，香气才立得住。",
    "菠菜焯完立刻过冷水，颜色才锁得住翠绿。"
  ],
  "common_mistakes": [
    "豆腐不压水就拌，装盘五分钟盆底积一层白汤，卖相全毁。",
    "芝麻整粒拌进去，吃不到那股油润香，只剩颗粒感。",
    "菠菜焯完在锅里闷着，叶色发黄发暗，摆盘看着像剩菜。"
  ],
  "substitutions": [
    {
      "original": "菠菜",
      "substitute": "小油菜",
      "ratio": "250克:250克",
      "note": "梗更厚，焯水时间加二十秒。"
    },
    {
      "original": "白芝麻",
      "substitute": "花生",
      "ratio": "30克:30克",
      "note": "磨成粗粒，香气更浓但颜色偏黄。"
    }
  ],
  "variations": [
    "加一勺味噌同拌，咸鲜更厚，冬天配热饭很合适。",
    "拌入几片煎过的香菇，口感和香气都更足，适合当宴客前菜。"
  ],
  "serving_suggestion": "装小钵堆成小山，撒几粒熟芝麻，冷藏十分钟后上桌当清口前菜。",
  "storage": "冷藏可放一天，芝麻香会变淡，菠菜出水增多，建议当天吃完。",
