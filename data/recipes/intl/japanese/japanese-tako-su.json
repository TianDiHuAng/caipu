    }
  ],
  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "拌菜盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "章鱼脚放进沸水煮三分钟，捞出过凉水，擦干后斜切成薄片。",
      "time_min": 6,
      "heat": "大火",
      "tip": "煮到触须卷起就够了，久煮会变硬像橡胶。",
      "visual_cue": "章鱼片呈淡粉色，边缘卷曲"
    },
    {
      "n": 2,
      "text": "黄瓜切成薄片，撒一半盐抓匀，静置十分钟后挤掉渗出的水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黄瓜一定要挤干水，拌好才不会稀释醋汁。",
      "visual_cue": "黄瓜片变软，挤干后体积缩小"
    },
    {
      "n": 3,
      "text": "米醋、白糖、剩下的盐与生抽放进碗里，搅到糖和盐完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖和盐化开再拌，味道才不会一块咸一块甜。",
      "visual_cue": "醋汁清澈，尝起来酸甜平衡"
    },
    {
      "n": 4,
      "text": "把章鱼片与黄瓜片放进拌菜盆，倒入醋汁轻轻拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌的动作一定要轻，章鱼片一用力就碎。",
      "visual_cue": "材料挂满醋汁，盆底留少量汁"
    },
    {
      "n": 5,
      "text": "拌好后冷藏十分钟，让味道渗进材料里更清爽。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冷藏这一步能让酸味更柔和，急吃也行但味道偏冲。",
      "visual_cue": "整体冰凉透亮，醋香明显"
    },
    {
      "n": 6,
      "text": "装盘后撒上紫菜丝，即刻上桌当成开胃凉菜食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "紫菜丝最后再撒，放早了会吸汁变软塌。",
      "visual_cue": "表面紫黑细丝点缀，色泽清亮"
    }
  ],
  "tips": [
    "买现成煮好的章鱼可以省去处理时间。",
    "黄瓜换成海带或白萝卜片同样合适。",
    "醋汁里加一点姜汁，去腥效果更好。",
    "拌好后两小时内吃完，口感最脆。"
  ],
  "common_mistakes": [
    "章鱼煮太久，切片后咬起来又硬又韧。",
    "黄瓜没挤水，拌好一会儿就泡在汁水里。",
    "醋汁里的糖没化开，吃起来有明显的颗粒感。"
  ],
  "substitutions": [
    {
      "original": "章鱼",
      "substitute": "鱿鱼",
      "ratio": "250克:250克",
      "note": "煮一分钟就够，口感更嫩。"
    },
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "40毫升:35毫升",
      "note": "酸味更冲，白糖可略加。"
    }
  ],
  "variations": [
    "加几片柠檬同拌，酸味会变得更清亮。",
    "换成甜醋加芥末，做成带冲劲的版本。"
  ],
  "serving_suggestion": "装进小碟里冰着上，章鱼弹牙、黄瓜清脆，一口下去酸甜开胃，配一杯清酒或冰啤酒都合适。",
  "storage": "冷藏可存一天，醋汁会让材料继续软化，第二天口感偏软但仍可食用。",
