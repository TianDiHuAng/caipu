  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "木薯粉",
          "name_en": "cassava flour",
          "amount": 160,
          "unit": "g",
          "note": "做饼体主体",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄豆粉",
          "name_en": "roasted soybean flour",
          "amount": 30,
          "unit": "g",
          "note": "裹面用",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 40,
          "unit": "g",
          "note": "熬黑糖蜜",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 420,
          "unit": "ml",
          "note": "调粉与熬蜜",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 30,
          "unit": "g",
          "note": "调饼体甜味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "不粘锅",
    "刮刀",
    "保鲜盒",
    "筛网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "木薯粉过筛进大碗，加白糖与三百毫升清水，用刮刀搅到完全没有粉粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一定搅到看不见干粉，否则成品会有硬疙瘩。",
      "visual_cue": "粉浆顺滑如米汤，碗底无沉淀"
    },
    {
      "n": 2,
      "text": "把粉浆倒进不粘锅，开最小火，用刮刀不停从锅底翻拌。",
      "time_min": 10,
      "heat": "小火",
      "tip": "全程小火并不停刮底，一停就会结块糊锅。",
      "visual_cue": "粉浆逐渐变稠，能拉起半透明的丝"
    },
    {
      "n": 3,
      "text": "继续翻拌到整体变成半透明、有弹性的团状，表面不再有白色。",
      "time_min": 8,
      "heat": "小火",
      "tip": "变成整团后还要再拌一分钟，把生粉味煮透。",
      "visual_cue": "面团结成一体，按压有回弹"
    },
    {
      "n": 4,
      "text": "把面团倒进铺了薄水或湿布的保鲜盒，抹平表面，室温放凉十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "表面抹平并贴一层水膜，冷却后不会干硬。",
      "visual_cue": "表面平整发亮，按压弹手不粘"
    },
    {
      "n": 5,
      "text": "红糖加剩下的一百二十毫升清水，小火煮到略稠，关火放凉成黑糖蜜。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖蜜别熬得太稠，凉下来之后还会继续变浓。",
      "visual_cue": "糖蜜呈琥珀色，能缓慢流动"
    },
    {
      "n": 6,
      "text": "手上蘸水把饼团揪成小块，滚上黄豆粉，淋黑糖蜜即可食用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "手和刀都要蘸水，饼团才不会粘成一片。",
      "visual_cue": "小块裹满黄豆粉，断面半透明"
    }
  ],
  "tips": [
    "木薯粉要买细粉，粗颗粒口感会发硬。",
    "熬蜜时加一小撮盐，甜味更有层次。",
    "饼团冷藏一小时再切，形状会更整齐。",
    "黄豆粉提前干锅烘一烘，香气更足。"
  ],
  "common_mistakes": [
    "粉浆没搅匀就下锅，成品里夹着白色硬块。",
    "火候开大想催熟，锅底立刻焦糊还带苦味。",
    "饼团没盖膜冷却，表面风干开裂发硬。"
  ],
  "substitutions": [
    {
      "original": "木薯粉",
      "substitute": "糯米粉",
      "ratio": "160克:150克",
      "note": "质地更软糯，水量减少二十毫升。"
    },
    {
      "original": "黄豆粉",
      "substitute": "芝麻",
      "ratio": "30克:30克",
      "note": "炒香后磨成粉，风味更浓。"
    }
  ],
  "variations": [
    "裹抹茶粉与白糖，做成抹茶口味的蕨饼。",
    "加一勺红豆沙包进饼团，做成夹心版本。"
  ],
  "serving_suggestion": "装在浅碟里，半透明的饼块裹着淡黄的粉，淋上深褐色的糖蜜，入口冰凉滑弹，甜香在嘴里化开。",
  "storage": "冷藏可存两天，用保鲜膜貼面覆盖防止风干，食用前再裹粉与淋蜜。",
