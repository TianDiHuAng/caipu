  "steps": [
    {
      "n": 1,
      "text": "乌冬面先按包装煮熟，捞出用冷水冲去表面黏液后沥干。",
      "time_min": 8,
      "heat": "中火",
      "tip": "面先煮过再入锅，汤才不会被面的粉浆弄浑。",
      "visual_cue": "乌冬面分明不粘连，手感滑爽"
    },
    {
      "n": 2,
      "text": "高汤加酱油、味淋、清酒与盐煮开，放入鸡腿肉小火煮六分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "鸡肉小火煮才嫩，大火一滚就柴。",
      "visual_cue": "鸡肉浮起变白，汤色清亮"
    },
    {
      "n": 3,
      "text": "加入香菇与大葱段继续煮四分钟，煮到香菇变软出香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "香菇划十字花刀，受热更均匀也更入味。",
      "visual_cue": "香菇伞面饱满，汤面浮着油花"
    },
    {
      "n": 4,
      "text": "把煮好的乌冬面放进砂锅，倒入汤汁与配料，中火加热到微沸。",
      "time_min": 6,
      "heat": "中火",
      "tip": "面最后放，久煮会失去弹性变得软烂。",
      "visual_cue": "乌冬面在汤中舒展，砂锅边缘冒小泡"
    },
    {
      "n": 5,
      "text": "打入整颗鸡蛋，盖盖小火焖三分钟至蛋白凝固，撒葱花连砂锅上桌。",
      "time_min": 5,
      "heat": "小火",
      "tip": "鸡蛋焖到蛋白凝固蛋黄半流，口感最好。",
      "visual_cue": "蛋黄半凝微颤，蛋白雪白定型"
    }
  ],
  "tips": [
    "乌冬面先煮后冲冷水，口感才弹牙不发黏。",
    "用砂锅上桌能持续保温，吃到最后一口汤还是热的。",
    "鸡蛋一定最后打，焖三分钟刚好是半熟蛋黄。",
    "汤底用昆布木鱼花现煮，比市售高汤块清爽得多。"
  ],
  "common_mistakes": [
    "乌冬面直接下汤锅煮，汤浑面糊一锅黏。",
    "鸡蛋一开始就打进去，煮到全熟变硬。",
    "火太大滚太久，乌冬面吸汤胀成软条。",
    "大葱切得太细，久煮后完全化在汤里。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "虾仁",
      "ratio": "160克:160克",
      "note": "海鲜版煮三分钟即可，别久煮。"
    },
    {
      "original": "香菇",
      "substitute": "金针菇",
      "ratio": "80克:100克",
      "note": "更易熟，煮两分钟就够。"
    }
  ],
  "variations": [
    "加两片炸豆腐皮，吸汤后味道更足。",
    "放一小块黄油进汤里，北海道风味更浓。",
    "加一把水菜或菠菜，最后烫三十秒即可。"
  ],
  "serving_suggestion": "整锅端上桌，撒葱花与少许辣椒粉，趁热吸溜着吃，汤和面一起见底才算过瘾。",
  "storage": "面条与汤分开冷藏可放一天，复热时汤单独煮开再放面，避免面泡烂。",
