  },
  "servings": 2,
  "flavor": [
    "fragrant",
    "savory",
    "light"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 130,
          "unit": "g",
          "note": "炒香后磨碎",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "木薯粉",
          "name_en": "cassava flour",
          "amount": 60,
          "unit": "g",
          "note": "代替葛粉定型",
          "optional": false
        },
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 400,
          "unit": "ml",
          "note": "调浆",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "佐食",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "研钵",
    "汤锅",
    "方模",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芝麻倒进干锅小火炒三分钟，炒到颗粒跳动、香气浓烈时盛出放凉。",
      "time_min": 5,
      "heat": "小火",
      "tip": "芝麻要不停翻动，炒糊一点整锅都带苦。",
      "visual_cue": "芝麻色泽微深，香气扑鼻"
    },
    {
      "n": 2,
      "text": "炒好的芝麻放进研钵，耐心磨成出油的细糊，加盐拌匀。",
      "time_min": 12,
      "heat": "无火",
      "tip": "磨到能拉出油光才算够，粗了口感发渣。",
      "visual_cue": "芝麻糊细腻发亮，能缓缓流动"
    },
    {
      "n": 3,
      "text": "木薯粉加一半高汤搅开，再倒入剩下的高汤与芝麻糊，搅到没有颗粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "粉一定要先用冷汤化开，否则下锅立刻结块。",
      "visual_cue": "浆液均匀，呈浅灰褐色"
    },
    {
      "n": 4,
      "text": "浆液倒进汤锅，小火加热并持续搅动，约八分钟变稠成膏状。",
      "time_min": 8,
      "heat": "小火",
      "tip": "锅底要一直刮，糊底只要一点就带焦味。",
      "visual_cue": "木勺划过能留下清晰痕迹"
    },
    {
      "n": 5,
      "text": "趁热倒进抹过水的方模，抹平表面，室温放凉后冷藏一小时定型。",
      "time_min": 3,
      "heat": "无火",
      "tip": "表面抹平并冷却到位，切块才不掉边。",
      "visual_cue": "表面光滑平整，按压有弹性"
    },
    {
      "n": 6,
      "text": "脱模切成两厘米厚块，装碟淋少许生抽即可当凉菜上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "刀面蘸一点水再切，切口才会平整不发黏。",
      "visual_cue": "切块方正有光泽，边缘不塌"
    }
  ],
  "tips": [
    "芝麻磨得越细，成品的口感越像奶酪般顺滑。",
    "没有研钵可用料理机分次打碎，中途刮壁。",
    "冷藏后风味更清爽，夏天吃特别合适。",
    "表面撒一点紫菜丝，鲜味会更足也更雅致。"
  ],
  "common_mistakes": [
    "芝麻炒过头，成品会带明显的苦焦味道。",
    "粉浆没搅匀就加热，锅里结满小硬块。",
    "没有冷藏定型就切，切块软塌不成形。"
  ],
  "substitutions": [
    {
      "original": "木薯粉",
      "substitute": "玉米淀粉",
      "ratio": "60克:60克",
      "note": "定型稍弱，冷藏时间需延长半小时。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "400毫升:400毫升",
      "note": "味道偏淡，生抽可略加。"
    }
  ],
  "variations": [
    "芝麻换成黑芝麻做黑白双色，摆盘更好看。",
    "表面刷一层薄薄的味噌酱，烤一下做成烤芝麻豆腐。"
  ],
  "serving_suggestion": "切成小方块摆进浅碟，淋一圈生抽，表面撒几根紫菜丝，入口绵密带浓香，是很雅致的开胃菜。",
  "storage": "冷藏密封可存两天，切块后建议当日吃完，久放表面会析水。",
