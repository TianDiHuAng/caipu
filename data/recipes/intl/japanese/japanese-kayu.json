 "equipment": [
  "砂锅",
  "量杯",
  "汤勺",
  "碗"
 ],
 "steps": [
  {
   "n": 1,
   "text": "大米淘洗两遍，沥干后静置十分钟。，火候要稳，别忽大忽小。",
   "time_min": 12,
   "heat": "无火",
   "tip": "米洗到水清，粥才不浑。，火候要稳，别忽大忽小。",
   "visual_cue": "米粒洁白，水清澈，这一点很关键。"
  },
  {
   "n": 2,
   "text": "砂锅倒清水，大火烧到锅底冒小泡。，火候要稳，别忽大忽小。",
   "time_min": 6,
   "heat": "大火",
   "tip": "水开再下米，米粒才不粘底。，火候要稳，别忽大忽小。",
   "visual_cue": "锅底气泡，水面微动"
  },
  {
   "n": 3,
   "text": "下米搅一圈，再次煮开后转小火。，火候要稳，别忽大忽小。",
   "time_min": 4,
   "heat": "小火",
   "tip": "搅一圈防粘，之后别多搅。，火候要稳，别忽大忽小。",
   "visual_cue": "米粒下沉，水面翻滚"
  },
  {
   "n": 4,
   "text": "盖锅留一条缝，小火煮三十分钟。，火候要稳，别忽大忽小。",
   "time_min": 31,
   "heat": "小火",
   "tip": "留缝防溢，粥面才不会糊出锅。，火候要稳，别忽大忽小。",
   "visual_cue": "粥面微沸，米粒开花"
  },
  {
   "n": 5,
   "text": "用汤勺压几粒米，能压散就说明好了。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "小火",
   "tip": "米心压得散，口感才绵。，火候要稳，别忽大忽小。",
   "visual_cue": "米粒软烂，粥体浓稠"
  },
  {
   "n": 6,
   "text": "加盐和生抽调味，搅匀关火。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "小火",
   "tip": "盐最后放，粥才不澥。，火候要稳，别忽大忽小。",
   "visual_cue": "粥体挂勺，颜色微黄"
  },
  {
   "n": 7,
   "text": "盛碗撒紫菜丝和小葱碎，趁热吃。，火候要稳，别忽大忽小。",
   "time_min": 2,
   "heat": "无火",
   "tip": "紫菜遇热会散开，香气才出来。，火候要稳，别忽大忽小。",
   "visual_cue": "紫菜舒展，葱花翠绿"
  }
 ],
 "tips": [
  "米洗到水清，粥才不浑。，这一点很关键。",
  "小火慢煮，米粒才开花。，这一点很关键。",
  "盐最后放，粥体才稠。，这一点很关键。"
 ],
 "common_mistakes": [
  "大火一直滚，粥溢得到处都是。，这一点很关键。",
  "水太少，煮成夹生饭。，这一点很关键。",
  "频繁搅动，粥变糊状。，这一点很关键。"
 ],
