  "equipment": [
    "砂锅",
    "量杯",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍，沥干后静置十分钟。，火要均匀，食材才不糊。",
      "time_min": 12,
      "heat": "无火",
      "tip": "米洗到水清，粥才不浑。，看住火，别让它失控。",
      "visual_cue": "米粒洁白，水清澈，这步最关键。"
    },
    {
      "n": 2,
      "text": "砂锅倒清水，大火烧到锅底冒小泡。，全程留意火候，别贪快。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水开再下米，米粒才不粘底。，火大了就离锅远一点。",
      "visual_cue": "锅底气泡，水面微动"
    },
    {
      "n": 3,
      "text": "下米搅一圈，再次煮开后转小火。，火别开太大，稳着来。",
      "time_min": 4,
      "heat": "小火",
      "tip": "搅一圈防粘，之后别多搅。，锅温要匀，别忽高忽低。",
      "visual_cue": "米粒下沉，水面翻滚"
    },
    {
      "n": 4,
      "text": "盖锅留一条缝，小火煮三十分钟。，火力保持中等，慢慢来。",
      "time_min": 31,
      "heat": "小火",
      "tip": "留缝防溢，粥面才不会糊出锅。，火候宁小勿大，慢慢推进。",
      "visual_cue": "粥面微沸，米粒开花"
    },
    {
      "n": 5,
      "text": "用汤勺压几粒米，能压散就说明好了。，注意锅里温度别掉下来。",
      "time_min": 2,
      "heat": "小火",
      "tip": "米心压得散，口感才绵。，始终中小火，别心急。",
      "visual_cue": "米粒软烂，粥体浓稠"
    },
    {
      "n": 6,
      "text": "加盐和生抽调味，搅匀关火。，火要均匀，食材才不糊。",
      "time_min": 2,
      "heat": "小火",
      "tip": "盐最后放，粥才不澥。，看住火，别让它失控。",
      "visual_cue": "粥体挂勺，颜色微黄"
    },
    {
      "n": 7,
      "text": "盛碗撒紫菜丝和小葱碎，趁热吃。，全程留意火候，别贪快。",
      "time_min": 2,
      "heat": "无火",
      "tip": "紫菜遇热会散开，香气才出来。，火大了就离锅远一点。",
      "visual_cue": "紫菜舒展，葱花翠绿"
    }
  ],
  "tips": [
    "米洗到水清，粥才不浑。，很多人在这里出错。",
    "小火慢煮，米粒才开花。，这里最容易翻车。",
    "盐最后放，粥体才稠。，别小看这一步。"
  ],
  "common_mistakes": [
    "大火一直滚，粥溢得到处都是。，成败就在这一步。",
    "水太少，煮成夹生饭。，这点要注意。",
    "频繁搅动，粥变糊状。，这是关键点。"
  ],
  "substitutions": [
    {
      "original": "大米",
      "substitute": "米饭",
      "ratio": "150 克:300 克",
      "note": "煮的时间减到十五分钟。"
    },
    {
      "original": "清水",
      "substitute": "高汤",
      "ratio": "1500 毫升:1500 毫升",
      "note": "鲜味更足，盐可减半。"
    }
  ],
  "variations": [
    "打一个鸡蛋进去，做成蛋粥。，别嫌麻烦，做完它。",
    "加一块梅干，酸味解腻。，这一步别省。"
  ],
  "serving_suggestion": "配腌菜或一小碟纳豆。，别跳过这步。",
  "storage": "冷藏两天，复热加水调稀。，这步最关键。",
