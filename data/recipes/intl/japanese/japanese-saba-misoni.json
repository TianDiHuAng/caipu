  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "铝箔纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲭鱼去骨切成四厘米厚的块，鱼皮一面划两刀，用热水快速淋一遍去腥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "热水淋皮能去腥收紧，别泡太久否则肉会散。",
      "visual_cue": "鱼皮收紧发亮，表面无血污"
    },
    {
      "n": 2,
      "text": "平底锅铺一张铝箔纸，倒入清水、清酒、味醂与白糖，中火煮开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "锅里垫一层铝箔能防粘底，鱼皮也不容易被铲破。",
      "visual_cue": "煮汁滚开，糖完全化开"
    },
    {
      "n": 3,
      "text": "把鲭鱼块皮朝上摆进锅里，加姜片，转小火加盖煮八分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "鱼皮朝上摆，煮出来形状完整不脱皮。",
      "visual_cue": "鱼肉变白紧实，煮汁微滚"
    },
    {
      "n": 4,
      "text": "味噌用少量煮汁在小碗里化开，再倒回锅中，轻轻晃动锅让它散开。",
      "time_min": 3,
      "heat": "小火",
      "tip": "味噌化开再入锅，才不会沉底结块发苦。",
      "visual_cue": "煮汁呈黄褐色，酱香明显"
    },
    {
      "n": 5,
      "text": "放入大葱段，继续小火煮五分钟，边煮边用勺把煮汁淋在鱼肉上。",
      "time_min": 5,
      "heat": "小火",
      "tip": "淋汁比翻面好，鱼肉不易碎又能均匀入味。",
      "visual_cue": "葱段变软，鱼肉挂上酱色"
    },
    {
      "n": 6,
      "text": "关火静置三分钟让味道回渗，连汁盛盘，配一碗热饭一起上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "关火静置是关键，鱼肉会把汁吸回去更入味。",
      "visual_cue": "鱼肉断面入味呈浅褐色"
    }
  ],
  "tips": [
    "鲭鱼选新鲜的，眼睛清亮、鱼身有弹性。",
    "煮汁别收太干，拌饭是这道菜的精华。",
    "味噌用红味噌与白味噌混合，咸甜更加平衡。",
    "加几片牛蒡同煮，香气会变得更沉稳厚实。"
  ],
  "common_mistakes": [
    "鱼皮朝下煮，翻动时皮破肉散卖相差。",
    "全程大火滚煮，鱼肉散开，煮汁也会变浑浊。",
    "味噌一次全部倒入，结成硬块根本化不开。"
  ],
  "substitutions": [
    {
      "original": "鲭鱼",
      "substitute": "三文鱼",
      "ratio": "400克:400克",
      "note": "肉质更紧实，煮的时间加两分钟。"
    },
    {
      "original": "味噌",
      "substitute": "生抽",
      "ratio": "45克:35毫升",
      "note": "少了酱香，白糖可略加平衡咸度。"
    }
  ],
  "variations": [
    "换成味噌加番茄同煮，酸甜里带一层果香。",
    "把煮汁收浓淋在鱼上，做成照烧风味。"
  ],
  "serving_suggestion": "把鱼块摆在盘里，浇上浓稠的煮汁再放葱段，鱼肉软嫩带酱香，一口鱼一口白饭最舒服。",
  "storage": "冷藏可存一天，连煮汁一起存放，复热时小火加少量水煮开三分钟。",
