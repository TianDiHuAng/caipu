    "刀",
    "砧板",
    "碗",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼撕去外皮，掏出内脏与软骨，冲洗干净后用厨房纸充分吸干水分。",
      "time_min": 14,
      "heat": "无火",
      "tip": "外皮撕干净烤出来才不韧，水分吸干才上色。",
      "visual_cue": "鱿鱼筒干爽完整，表皮呈雪白色"
    },
    {
      "n": 2,
      "text": "酱油、味淋、清酒、白砂糖与姜末调成照烧汁，搅到糖完全化开。",
      "time_min": 4,
      "heat": "无火",
      "tip": "调好的照烧汁先尝一口，甜咸要平衡。",
      "visual_cue": "照烧汁呈深琥珀色，质地清亮"
    },
    {
      "n": 3,
      "text": "鱿鱼平铺在烤网上，表面先刷一层照烧汁，腌十分钟入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切口处也要刷到，烤出来颜色才均匀。",
      "visual_cue": "鱿鱼表面挂汁均匀，微微发亮"
    },
    {
      "n": 4,
      "text": "烤箱预热二百度，鱿鱼烤八分钟后翻面再刷汁，继续烤五分钟。",
      "time_min": 15,
      "heat": "中火",
      "tip": "中途一定要翻面补刷，否则一面焦一面白。",
      "visual_cue": "表面焦褐发亮，鱿鱼筒微微鼓起"
    },
    {
      "n": 5,
      "text": "出炉趁热切成一厘米宽的圈，摆盘撒葱花、配柠檬角挤汁食用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "趁热切段才不散，凉了肉质会变紧。",
      "visual_cue": "切面洁白有弹性，边缘红褐焦香"
    }
  ],
  "tips": [
    "鱿鱼一定要彻底吸干水分，否则烤的时候只会出水不上色。",
    "照烧汁分两次刷，第一次入味，第二次负责上色发亮。",
    "烤的时间别超过十五分钟，久了肉质会硬得像橡皮。",
    "配一杯冰啤酒或热清酒，是居酒屋最经典的吃法。"
  ],
  "common_mistakes": [
    "鱿鱼没擦干就进烤箱，全程只出汤不上色。",
    "烤的时间太久，鱿鱼缩成硬圈，咬都咬不动。",
    "照烧汁只刷一次，成品颜色浅，甜咸味也不够。",
    "内脏没掏干净，烤出来带着明显的腥苦味。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "墨鱼",
      "ratio": "600克:600克",
      "note": "肉质更厚，烤的时间加三分钟。"
    },
    {
      "original": "味淋",
      "substitute": "料酒加糖",
      "ratio": "30毫升:30毫升加5克糖",
      "note": "甜度接近，香气略薄。"
    }
  ],
  "variations": [
    "烤好后撒一层白芝麻，香气更浓也更像店里的样子。",
    "照烧汁里加一小勺蒜泥，风味更重，适合下酒。",
    "整只不切直接上桌，吃的时候自己剪开更有气氛。"
  ],
  "serving_suggestion": "切好的鱿鱼圈摆在长盘里，撒葱花与白芝麻，旁边放柠檬角，淋上烤盘里剩下的照烧汁。",
  "storage": "冷藏可放一天，复热用平底锅小火两面各煎三十秒，微波加热会让肉质变韧。",
