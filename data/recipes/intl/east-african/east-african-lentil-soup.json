  "equipment": [
    "汤锅",
    "木勺",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扁豆冲洗两遍后泡三十分钟，泡到豆皮微微发皱。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡过的扁豆煮得更快更均匀。",
      "visual_cue": "豆子饱满，水面有少量浮沫"
    },
    {
      "n": 2,
      "text": "汤锅倒植物油，中火炒洋葱丁与胡萝卜丁三分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蔬菜先炒过，汤的甜味才出来。",
      "visual_cue": "洋葱透明，胡萝卜颜色变深"
    },
    {
      "n": 3,
      "text": "加姜末、蒜末、孜然与咖喱粉，小火炒四十秒出香。",
      "time_min": 1,
      "heat": "小火",
      "tip": "香料小火炒，焦了会发苦。",
      "visual_cue": "粉末结块散开，香气扑鼻"
    },
    {
      "n": 4,
      "text": "下番茄块炒三分钟，炒到番茄软烂渗出红色汁水。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄炒透，汤底才有厚度。",
      "visual_cue": "番茄塌软，锅底有红汁"
    },
    {
      "n": 5,
      "text": "倒入扁豆与八百毫升清水，大火煮开后转小火。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水一次加够，中途别添冷水。",
      "visual_cue": "水面翻滚，扁豆随水翻动"
    },
    {
      "n": 6,
      "text": "盖盖小火煮三十分钟，煮到扁豆完全开花变软。",
      "time_min": 30,
      "heat": "小火",
      "tip": "扁豆要煮到一按就散，口感才绵。",
      "visual_cue": "豆子开花，汤体变得浑厚"
    },
    {
      "n": 7,
      "text": "加盐调味，挤入柠檬汁搅匀后尝味再补一次盐。",
      "time_min": 2,
      "heat": "小火",
      "tip": "酸味最后加，汤的层次立刻起来。",
      "visual_cue": "汤色橙黄，酸香明显"
    },
    {
      "n": 8,
      "text": "盛碗后撒上香菜碎，趁热搭配主食一起食用。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香菜最后撒，香气才不会被烫散。",
      "visual_cue": "汤面点缀翠绿，浓稠挂勺"
    }
  ],
  "tips": [
    "扁豆提前泡过，煮三十分钟就能开花。",
    "柠檬汁是点睛，缺了整锅汤会显得闷。",
    "水一次加够，中途添水汤会变稀。"
  ],
  "common_mistakes": [
    "扁豆没泡直接煮，煮一小时还带硬芯。",
    "香料用大火炒，整锅汤带一股焦苦味。",
    "盐下得太早，扁豆煮再久也不软。"
  ],
  "substitutions": [
    {
      "original": "扁豆",
      "substitute": "鹰嘴豆",
      "ratio": "300 克:300 克",
      "note": "需泡两小时，煮制延长二十分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "30 克:30 克",
      "note": "酸味更冲，用量减到二十克。"
    }
  ],
  "variations": [
    "最后撒一撮辣椒粉，微辣更开胃。",
    "加半个土豆同煮，汤体更浓稠绵密。"
  ],
  "serving_suggestion": "配烤面饼或白米饭，撒香菜趁热食用。",
  "storage": "冷藏三天、冷冻一个月，复热加清水调稀。",
