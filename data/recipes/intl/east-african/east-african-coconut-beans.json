  "steps": [
    {
      "n": 1,
      "text": "白豆提前泡六小时，煮到软而不烂后沥干。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "煮到轻压即碎，炖的时候才入味。，注意火候。",
      "visual_cue": "豆粒饱满，轻压即碎，状态稳定"
    },
    {
      "n": 2,
      "text": "洋葱切小丁，番茄切块，蒜和姜切成细末。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丁切小一点，炖完口感才顺。，注意火候。",
      "visual_cue": "颗粒细小，均匀一致，状态稳定"
    },
    {
      "n": 3,
      "text": "汤锅倒植物油烧热，下洋葱丁小火炒到透明发软。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒透，汤的甜味就出来了。，注意火候。",
      "visual_cue": "洋葱透明，香气升起，状态稳定"
    },
    {
      "n": 4,
      "text": "加蒜末、姜末和咖喱粉炒三十秒到出香。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香料遇油出味，别炒到发黑。，注意火候。",
      "visual_cue": "香气冲鼻，油色微黄，状态稳定"
    },
    {
      "n": 5,
      "text": "放番茄块中火炒三分钟，炒到出汁软烂。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒软，汤才有厚度。，注意火候。",
      "visual_cue": "番茄化开，汁水泛红，状态稳定"
    },
    {
      "n": 6,
      "text": "倒入椰奶和半碗清水，放入白豆小火煮十五分钟。",
      "time_min": 16,
      "heat": "小火",
      "tip": "小火慢煮，椰奶才不会油水分离。，注意火候。",
      "visual_cue": "汤色奶白，豆已入味，状态稳定"
    },
    {
      "n": 7,
      "text": "加盐调味，挤入青柠汁搅匀。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "青柠最后加，酸香才留得住。，注意火候。",
      "visual_cue": "汤汁浓稠，酸香清新，状态稳定"
    },
    {
      "n": 8,
      "text": "撒香菜碎后盛出，配米饭或面饼吃。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，香气不散。，注意火候。",
      "visual_cue": "汤面油亮，香气复合，状态稳定"
    }
  ],
  "tips": [
    "白豆煮到轻压即碎，炖时才入味。，值得留意。",
    "椰奶小火煮，大火容易油水分离。，值得留意。",
    "青柠汁最后挤，酸香才不挥发。，值得留意。"
  ],
  "common_mistakes": [
    "豆子没泡透就炖，煮完还是硬的。，值得留意。",
    "椰奶大火滚，汤分层看着发花。，值得留意。",
    "咖喱粉炒过头，整锅发苦。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "白豆",
      "substitute": "红腰豆",
      "ratio": "450 克:450 克",
      "note": "口感更沙，炖制时间加五分钟。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "300 毫升:300 毫升",
      "note": "更清爽，可多加少许盐。"
    }
  ],
  "variations": [
    "加一把菠菜同炖，颜色更绿。，值得留意。",
    "放一小勺花生酱，汤更浓稠。，值得留意。"
  ],
  "serving_suggestion": "配白饭或恰巴提饼，浇上汤汁一起吃。，效果更稳定。",
  "storage": "冷藏两天，复热加少量水小火煮开。，效果更稳定。",
