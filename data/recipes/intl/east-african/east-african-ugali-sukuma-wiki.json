  "equipment": [
    "厚底锅",
    "木勺",
    "炒锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "厚底锅烧开七百毫升清水，加一半盐，把玉米面慢慢撒入水中并持续搅拌。",
      "time_min": 6,
      "heat": "中火",
      "tip": "玉米面要一把一把撒，撒完再撒下一把，否则结块。",
      "visual_cue": "面糊逐渐变稠，没有干粉颗粒"
    },
    {
      "n": 2,
      "text": "转小火继续用木勺不断搅动二十分钟，直到面糊成团、能整块脱离锅壁。",
      "time_min": 20,
      "heat": "小火",
      "tip": "这二十分钟不能停手，搅得越久越细腻有弹性。",
      "visual_cue": "面团结成光滑一团，边缘不粘锅"
    },
    {
      "n": 3,
      "text": "把面团整形成圆饼状盛盘，表面抹平，盖上保温备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "整形时手上沾点水，面团就不粘手。",
      "visual_cue": "表面圆润光滑，像一块厚饼"
    },
    {
      "n": 4,
      "text": "炒锅下植物油炒洋葱丁与蒜末五分钟至透明，加番茄丁炒出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄要炒到出汁，菜丝才有酸甜底味。",
      "visual_cue": "番茄塌软，锅里有红色汁水"
    },
    {
      "n": 5,
      "text": "下芥蓝细丝大火翻炒三分钟，加盐、黑胡椒与咖喱粉调味。",
      "time_min": 4,
      "heat": "大火",
      "tip": "菜丝只要炒到塌软颜色变深，久炒会发黄。",
      "visual_cue": "菜丝深绿油亮，体积缩小一半"
    },
    {
      "n": 6,
      "text": "关火挤入青柠汁拌匀，配玉米糊一起上桌，用手团着吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠最后挤，酸香才不挥发。",
      "visual_cue": "菜丝带酸香，盘边配玉米糊团"
    }
  ],
  "tips": [
    "玉米面要用细磨的，粗粒口感会发硬。",
    "传统吃法是右手团一小块玉米糊，蘸着菜汁吃。",
    "配烤鸡或炖豆子是完整的东非一餐。"
  ],
  "common_mistakes": [
    "玉米面一次全倒进水里，搅不开全是疙瘩。",
    "搅动不够，面糊里外生熟不均、带粉味。",
    "青菜煮太久，颜色发黄、口感软烂。",
    "水量没控制好，糊太稀摊不成团。"
  ],
  "substitutions": [
    {
      "original": "玉米面",
      "substitute": "玉米糁",
      "ratio": "300 克:300 克",
      "note": "需多煮十分钟并多搅动，口感更粗。"
    },
    {
      "original": "芥蓝",
      "substitute": "菠菜",
      "ratio": "500 克:500 克",
      "note": "菠菜出水多，炒制时间减到两分钟。"
    }
  ],
  "variations": [
    "青菜可换成南瓜叶或芥菜，风味各有特色。"
  ],
  "serving_suggestion": "玉米糊团配炒菜丝，可另配烤鸡。",
  "storage": "玉米糊冷藏两天，复热加少量水重新搅匀；青菜建议现炒现吃。",
