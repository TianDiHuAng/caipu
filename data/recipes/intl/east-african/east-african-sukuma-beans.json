      "ratio": "300 克:300 克",
      "note": "口感更粉，需多焖五分钟。"
    }
  ],
  "variations": [
    "加一点咖喱粉，风味更浓。，保持中小火，咸淡才好把握。",
    "加炒鸡蛋同拌，做成早餐。，火别太大，细节才到位。"
  ],
  "serving_suggestion": "配乌伽黎或米饭，一起吃。，汤汁别收太干，食材才不糊。",
  "storage": "冷藏两天，复热加少量水。，锅温要匀，味道才不闷。",
