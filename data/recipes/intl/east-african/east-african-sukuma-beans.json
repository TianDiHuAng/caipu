  "steps": [
    {
      "n": 1,
      "text": "卷心菜切细丝，洗净沥干。，注意别让汤汁烧干。，火别太大，稳着来。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切细一点，才易入味。，这步别省。，手法轻些，别弄散。",
      "visual_cue": "丝细均匀，水沥干，锅温要匀，别忽高忽低。"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，洋葱丁炒到透明。，味道最后调最稳。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒软，菜才甜。，慢慢来，别心急。，翻动放轻，别压碎。",
      "visual_cue": "洋葱透明，香气散出，全程中小火，食材才不糊。"
    },
    {
      "n": 3,
      "text": "加蒜末和姜泥炒香。，很多人在这里出错。，起锅前尝一口定咸淡。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "姜蒜先炒，去腥提香。，试一下咸淡再上桌。",
      "visual_cue": "香气散出，油面微泡，料别一次下太多，味道才进得去。"
    },
    {
      "n": 4,
      "text": "下番茄块炒到出汁。，时间掐准，形状才完整。，别用力搅，香气才不跑。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出汁，菜才不干。，慢慢来别急，整道菜才立得住。",
      "visual_cue": "汁水泛红，番茄软塌，保持中小火，形状才完整。"
    },
    {
      "n": 5,
      "text": "倒入卷心菜丝，大火翻炒两分钟。，保持中小火，成品才好看。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火快炒，菜才脆。，火别太大，火候才均匀。",
      "visual_cue": "菜丝变软，颜色转深，锅温要匀，食材才不糊。"
    },
    {
      "n": 6,
      "text": "加清水，盖盖焖八分钟。，锅温要匀，细节才到位。，火别太大，口感才不发柴。",
      "time_min": 9,
      "heat": "中火",
      "tip": "焖一下，卷心菜菜叶才熟透。，时间掐准，味道才进得去。",
      "visual_cue": "菜叶软塌，锅内有汁，起锅前尝味，口感才有层次。"
    },
    {
      "n": 7,
      "text": "加熟红腰豆，翻炒均匀。，火别太大，味道才进得去。",
      "time_min": 3,
      "heat": "中火",
      "tip": "豆子后放，才不会烂。，翻动放轻，食材才不糊。",
      "visual_cue": "豆粒完整，菜豆混匀，火别太大，咸淡才好把握。"
    },
    {
      "n": 8,
      "text": "加盐、黑胡椒和柠檬汁调味。，别用力搅，锅气才足。",
      "time_min": 3,
      "heat": "中火",
      "tip": "柠檬提鲜，酸味才活。，火别太大，整道菜才立得住。",
      "visual_cue": "酸香清亮，咸淡合适，手法轻些，口感才有层次。"
    },
    {
      "n": 9,
      "text": "收汁两分钟，出锅装盘。，留意锅底，锅气才足。，翻动放轻，细节才到位。",
      "time_min": 3,
      "heat": "中火",
      "tip": "别收太干，留点汤汁配饭。，注意别烧干，味道才不闷。",
      "visual_cue": "汤汁微浓，菜色深绿，时间掐准，口感才不发柴。"
    }
  ],
  "tips": [
    "大火快炒，菜才保持脆度。，手法轻些，形状才完整。",
    "豆子最后放，才不会炒烂。，汤汁别收太干，香气才不跑。",
    "柠檬汁提鲜，酸味别省。，盖盖焖一会儿，食材才不糊。"
  ],
  "common_mistakes": [
    "炒太久，菜叶发黄。，锅温要匀，锅气才足。",
    "豆子早放，全被炒碎。，料别一次下太多，食材才不糊。",
    "水太多，变成一锅汤。，汤汁别收太干，味道才不闷。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "菠菜",
