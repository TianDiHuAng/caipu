  "equipment": [
    "炖锅",
    "刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆提前煮到用手一捏就碎，捞出沥干备用。",
      "time_min": 5,
      "heat": "中火",
      "tip": "豆子煮到一捏就碎，焖的时候才不夹生。",
      "visual_cue": "红豆软烂，捏开无硬芯"
    },
    {
      "n": 2,
      "text": "玉米剥下颗粒，胡萝卜和番茄切成大小相近的丁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丁块切得差不多大，熟度才一致。",
      "visual_cue": "各色丁块大小均匀"
    },
    {
      "n": 3,
      "text": "炖锅放植物油烧热，下洋葱末炒到边缘透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒出甜味，整锅焖菜的底味才够香。",
      "visual_cue": "洋葱透明发亮，锅底起香"
    },
    {
      "n": 4,
      "text": "加入番茄丁炒三分钟，炒到番茄出汁变软塌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄要炒出红汁，焖菜才有底色。",
      "visual_cue": "番茄塌软，锅里有红汁"
    },
    {
      "n": 5,
      "text": "把玉米粒、胡萝卜丁和红豆一起倒进锅里翻炒均匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "先翻炒让食材裹上油，再加水焖。",
      "visual_cue": "食材裹油发亮，颜色分明"
    },
    {
      "n": 6,
      "text": "加清水、盐和辣椒粉，盖盖小火焖二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "水要没过食材一指，焖到玉米断生。",
      "visual_cue": "汤汁微滚，玉米粒饱满"
    },
    {
      "n": 7,
      "text": "开盖把汤汁收一收，撒上香菜碎就可以端上桌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "收汁留一点汤，拌饭拌玉米糊都好吃。",
      "visual_cue": "汤汁略稠，香菜翠绿"
    }
  ],
  "tips": [
    "红豆先煮到软烂再焖，成品才不至于夹生。",
    "番茄炒出红汁，焖菜的底味才够厚。",
    "收汁时留一点汤汁，拌饭或者拌玉米糊都顺口。"
  ],
  "common_mistakes": [
    "红豆没泡没煮直接下锅，焖两小时还是硬的。",
    "番茄没炒出红汁就加水，整锅汤色寡淡。",
    "清水加得太多，最后煮成了一锅红豆玉米汤。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "红腰豆",
      "ratio": "200 克:200 克",
      "note": "口感更绵，煮制时间减五分钟。"
    },
    {
      "original": "玉米",
      "substitute": "甜玉米粒罐头",
      "ratio": "300 克:300 克",
      "note": "省去剥粒，糖分更高。"
    }
  ],
  "variations": [
    "加一把牛肉丁同焖，荤素版本更扛饿。",
    "拌入炒香的洋葱和辣椒，做成更重口的印度洋风味。"
  ],
  "serving_suggestion": "配玉米糊或者白饭一起吃，也能当素食主菜单独装盘。",
  "storage": "冷藏三天，复热时加少量水小火焖五分钟。",
