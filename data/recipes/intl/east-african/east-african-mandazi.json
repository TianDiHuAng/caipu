  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 180,
          "unit": "ml",
          "note": "温热",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 6,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 260,
          "unit": "ml",
          "note": "炸制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "深锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温椰奶加白糖与酵母搅匀，静置十分钟等它起泡。",
      "time_min": 12,
      "heat": "无火",
      "tip": "酵母先活化，面团才发得起来。火候要盯住。",
      "visual_cue": "液面浮起一层细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉加盐拌匀，倒入酵母椰奶液，边倒边搅成絮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "液体分次倒，才好控制面团软硬。",
      "visual_cue": "面絮均匀，盆里没有干粉"
    },
    {
      "n": 3,
      "text": "揉成柔软不粘手的面团，盖湿布放温暖处发酵。",
      "time_min": 6,
      "heat": "无火",
      "tip": "揉到光滑，炸出来表面才平整。多练两次就熟。",
      "visual_cue": "面团光滑，按压后能回弹"
    },
    {
      "n": 4,
      "text": "发酵一小时到体积翻倍，用手指戳洞不回缩即可。",
      "time_min": 62,
      "heat": "无火",
      "tip": "发到两倍大，内部才有细密气孔。",
      "visual_cue": "面团鼓起，表面布满小气泡"
    },
    {
      "n": 5,
      "text": "把面团擀成一厘米厚的面片，切成三角或菱形块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚度一致，炸的时候才一起熟。细节决定成败。",
      "visual_cue": "面片平整，切块大小均匀"
    },
    {
      "n": 6,
      "text": "切好的面块盖布再醒十五分钟，让它们松一松。",
      "time_min": 17,
      "heat": "无火",
      "tip": "二次醒发，炸的时候才蓬起来。这一步别省。",
      "visual_cue": "面块微微鼓起，手按有弹性"
    },
    {
      "n": 7,
      "text": "深锅倒入植物油，中火烧到一百六十度左右。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温别太高，外面焦了里面还生。",
      "visual_cue": "油面微动，筷子插入冒小泡"
    },
    {
      "n": 8,
      "text": "下面块一次四五个，中火炸两分钟到浮起。手上别停以免粘锅。",
      "time_min": 4,
      "heat": "中火",
      "tip": "一次别下多，油温掉了就吸油。顺序别颠倒。",
      "visual_cue": "面块浮起，鼓起成金黄色"
    },
    {
      "n": 9,
      "text": "翻面再炸一分钟，捞出沥油后趁热吃。过程中注意火候变化。",
      "time_min": 4,
      "heat": "中火",
      "tip": "两面金黄就捞，久炸会发硬。火候要盯住。",
      "visual_cue": "两面颜色一致，油滴回落"
    }
  ],
  "tips": [
    "酵母先用温椰奶活化，面团才发得起来。",
    "面片一厘米厚正好，太厚炸不透。",
    "二次醒发十五分钟，成品才蓬松不硬。",
    "油温一百六十度，炸出的面饼不吸油。"
  ],
  "common_mistakes": [
    "椰奶太烫就放酵母，酵母被烫死发不起来。",
    "油温太高，外面焦黑里面还是生面。",
    "面块下锅后不停翻动，形状全塌。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "180 毫升:180 毫升",
      "note": "奶香更淡，可多加十克糖。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "60 克:70 克",
      "note": "风味更润，面团稍黏。"
    }
  ],
  "variations": [
    "面团里加一小勺豆蔻粉，香气更足。",
    "出锅后滚一层白糖，甜味更直接。"
  ],
  "serving_suggestion": "趁热配一杯加糖红茶，东非人早餐或下午茶都少不了它。",
  "storage": "常温密封一天，冷藏三天，复热用烤箱一百七十度烤四分钟。",
