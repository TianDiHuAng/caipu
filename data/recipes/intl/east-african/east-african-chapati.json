  },
  "servings": 4,
  "flavor": [
    "savory",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 240,
          "unit": "ml",
          "note": "温水",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 60,
          "unit": "ml",
          "note": "抹面与煎制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "平底锅",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐与白糖拌匀，慢慢倒入温水搅成絮状。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水别一次倒完，留一点看面团软硬。",
      "visual_cue": "面絮均匀，盆底无干粉"
    },
    {
      "n": 2,
      "text": "揉成光滑面团，盖保鲜膜静置二十分钟。翻动要轻别弄碎。",
      "time_min": 23,
      "heat": "无火",
      "tip": "揉到盆光手光，面筋才够细腻。这一步别省。",
      "visual_cue": "面团光滑有弹性，按下去回弹"
    },
    {
      "n": 3,
      "text": "分成八个等份，每个搓圆后抹一层植物油。手上别停以免粘锅。",
      "time_min": 8,
      "heat": "无火",
      "tip": "每份抹油，叠起来才不会粘。顺序别颠倒。",
      "visual_cue": "小圆球大小一致，表面油润"
    },
    {
      "n": 4,
      "text": "盖上保鲜膜再醒二十分钟，让面团彻底松弛。",
      "time_min": 22,
      "heat": "无火",
      "tip": "醒够时间，擀的时候才不回缩。火候要盯住。",
      "visual_cue": "面团按下去软塌，边缘圆润"
    },
    {
      "n": 5,
      "text": "取一份擀成直径十八厘米的薄圆片，越薄越好。",
      "time_min": 6,
      "heat": "无火",
      "tip": "擀薄是关键，层次才出得来。多练两次就熟。",
      "visual_cue": "面片透光，厚薄均匀"
    },
    {
      "n": 6,
      "text": "面片表面刷油，从一边卷成细长条再盘成螺旋。",
      "time_min": 6,
      "heat": "无火",
      "tip": "卷得紧一点，层次才密。细节决定成败。",
      "visual_cue": "长条紧实，螺旋纹路清楚"
    },
    {
      "n": 7,
      "text": "把螺旋用手压扁，再擀成十二厘米的圆饼。过程中注意火候变化。",
      "time_min": 5,
      "heat": "无火",
      "tip": "轻轻压再擀，别把层次擀破。这一步别省。",
      "visual_cue": "圆饼厚约三毫米，纹路隐约"
    },
    {
      "n": 8,
      "text": "平底锅中火烧热，不放油，下饼烙一分半钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "锅要够热，饼才会鼓起来。顺序别颠倒。",
      "visual_cue": "饼面鼓起小泡，底部出现焦点"
    },
    {
      "n": 9,
      "text": "翻面刷一层薄油，再烙一分钟至两面金黄。动作要快别拖延。",
      "time_min": 3,
      "heat": "中火",
      "tip": "刷油后翻面，饼皮才酥软分层。火候要盯住。",
      "visual_cue": "两面金黄，边缘微焦起层"
    },
    {
      "n": 10,
      "text": "出锅后趁热拍松两下，让层次散开再叠放。随时观察锅里的状态。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拍两下层次就开，趁热叠布保温。",
      "visual_cue": "饼层松开，用手一撕能看到层"
    }
  ],
  "tips": [
    "面团要醒两遍，擀的时候才不回缩。",
    "面片擀得越薄，烙出的层次越多。",
    "锅里不放油只刷表面，饼才不硬。",
    "出锅拍两下，层次立刻散开。多练两次就熟。"
  ],
  "common_mistakes": [
    "面团没醒够，擀开就缩回去。细节决定成败。",
    "面片擀太厚，烙完中间不熟还发硬。",
    "火太小烙太久，饼失水变得又干又韧。"
  ],
  "substitutions": [
    {
      "original": "清水",
      "substitute": "牛奶",
      "ratio": "240 毫升:250 毫升",
      "note": "奶香更浓，面团稍软。"
    },
    {
      "original": "植物油",
      "substitute": "黄油",
      "ratio": "60 毫升:60 克",
      "note": "香气更足，需融化后用。"
    }
  ],
  "variations": [
    "面团里加一勺孜然粉，香气更浓。",
    "卷的时候撒少量面粉，层次更分明。"
  ],
  "serving_suggestion": "趁热撕开配炖豆或咖喱吃，东非人习惯用手撕下一角蘸汤汁。",
  "storage": "密封常温一天，冷藏三天，复热用平底锅干烙两分钟。",
