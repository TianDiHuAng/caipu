          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 45,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 6,
          "unit": "g",
          "note": "发面",
          "optional": false
        },
        {
          "name": "豆蔻",
          "name_en": "cardamom",
          "amount": 2,
          "unit": "g",
          "note": "研磨",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 300,
          "unit": "ml",
          "note": "炸制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "平底锅",
    "刀",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温椰奶加白糖和酵母，静置十分钟到表面起泡。",
      "time_min": 12,
      "heat": "无火",
      "tip": "酵母起泡说明还活着，发得起来。，注意火候。",
      "visual_cue": "液面浮沫，甜香微出，状态稳定"
    },
    {
      "n": 2,
      "text": "面粉过筛，加盐和研磨的豆蔻粉拌匀。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆蔻现磨，香气才够冲。，注意火候。",
      "visual_cue": "粉质松细，香气清甜，状态稳定"
    },
    {
      "n": 3,
      "text": "把酵母椰奶慢慢倒进面粉，边倒边搅成絮状。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "慢慢倒，水量才好控制。，注意火候。",
      "visual_cue": "面絮均匀，无干粉，状态稳定"
    },
    {
      "n": 4,
      "text": "揉成光滑面团，盖布放温暖处发酵一小时。这一步不要着急。",
      "time_min": 62,
      "heat": "无火",
      "tip": "发到两倍大，炸出来才蓬松。，注意火候。",
      "visual_cue": "体积膨胀，指压回弹，状态稳定"
    },
    {
      "n": 5,
      "text": "面团排气后擀成半厘米厚，切成三角或菱形。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切得大小一致，炸的时间才好控。，注意火候。",
      "visual_cue": "形状整齐，厚薄一致，状态稳定"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油烧到一百六十度，下坯子中火炸。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温别太高，外面焦了里面还没熟。，注意火候。",
      "visual_cue": "油面细泡，坯子浮起，状态稳定"
    },
    {
      "n": 7,
      "text": "两面各炸两分钟到金黄鼓起，捞出吸油。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "翻面轻一点，别把鼓起的壳压塌。，注意火候。",
      "visual_cue": "两面金黄，体积鼓起，状态稳定"
    }
  ],
  "tips": [
    "椰奶温热再化酵母，太烫会烫死。，值得留意。",
    "面团发到两倍大，炸出来才蓬松。，值得留意。",
    "油温一百六十度下锅，里外一起熟。，值得留意。"
  ],
  "common_mistakes": [
    "椰奶太烫，酵母全烫死发不起来。，值得留意。",
    "面团没发够就炸，成品又硬又实。，值得留意。",
    "坯子切太厚，中间还是生面。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "200 毫升:200 毫升",
      "note": "奶香更淡，糖可减五克。"
    },
    {
      "original": "豆蔻",
      "substitute": "肉桂",
      "ratio": "2 克:2 克",
      "note": "香气更暖，用量可略减。"
    }
  ],
  "variations": [
    "面团里加一小勺姜粉，风味更暖。，值得留意。",
    "表面撒少许芝麻，香气更足。，值得留意。"
  ],
  "serving_suggestion": "配椰香扁豆炖或者奶茶当早餐，趁热吃最松软。",
  "storage": "冷藏两天，复热用蒸锅蒸三分钟。，效果更稳定。",
