  "equipment": [
    "平底锅",
    "木勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼切厚段，抹盐和柠檬汁腌十分钟。，翻动放轻，别压碎。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌一下去腥，肉也更紧。，全程中小火，食材才不糊。",
      "visual_cue": "鱼皮发亮，腥味变淡，注意别让汤汁烧干。"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油，鱼段两面煎定型。，火别太大，稳着来。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎定型再炖，鱼才不散。，这步别省。，慢慢来，别心急。",
      "visual_cue": "两面微黄，鱼皮完整，起锅前尝一口定咸淡。"
    },
    {
      "n": 3,
      "text": "盛出鱼段，余油炒洋葱丝到软。，很多人在这里出错。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒透，咖喱才甜。，试一下咸淡再上桌。",
      "visual_cue": "洋葱透明，香气散出，味道最后调最稳。"
    },
    {
      "n": 4,
      "text": "加蒜末、姜泥、咖喱粉和辣椒粉炒香。，手法轻些，别弄散。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "香料炒香，咖喱才不涩。，锅温要匀，别忽高忽低。",
      "visual_cue": "香气冲鼻，油色变黄，火别太大，食材才不糊。"
    },
    {
      "n": 5,
      "text": "下番茄块炒到出汁。，翻动放轻，咸淡才好把握。，注意别烧干，口感才有层次。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒出汁，汤才浓。，注意别烧干，整道菜才立得住。",
      "visual_cue": "汁水泛红，番茄软塌，注意别烧干，锅气才足。"
    },
    {
      "n": 6,
      "text": "倒椰浆，小火煮五分钟成咖喱汁。，慢慢来别急，口感才有层次。",
      "time_min": 7,
      "heat": "小火",
      "tip": "椰浆别大火滚，会分层。，注意别烧干，火候才均匀。",
      "visual_cue": "汁色乳白，香气甜润，时间掐准，香气才不跑。"
    },
    {
      "n": 7,
      "text": "放回鱼段，小火煮六分钟。，料别一次下太多，味道才不闷。",
      "time_min": 7,
      "heat": "小火",
      "tip": "别翻动，用勺淋汁。，手法轻些，咸淡才好把握。",
      "visual_cue": "鱼段完整，汁浓挂勺，留意锅底，细节才到位。"
    },
    {
      "n": 8,
      "text": "加盐调味，挤柠檬汁。，锅温要匀，形状才完整。，保持中小火，味道才进得去。",
      "time_min": 2,
      "heat": "小火",
      "tip": "柠檬提鲜，别煮太久。，盖盖焖一会儿，口感才不发柴。",
      "visual_cue": "酸香清亮，咸淡合适，时间掐准，咸淡才好把握。"
    },
    {
      "n": 9,
      "text": "撒香菜碎，关火焖两分钟。，留意锅底，成品才好看。",
      "time_min": 4,
      "heat": "无火",
      "tip": "关火焖，香气才沉。，慢慢来别急，香气才不跑。",
      "visual_cue": "香菜浮面，汁色奶白，手法轻些，口感才不发柴。"
    }
  ],
  "tips": [
    "鱼先煎定型，炖时才不散。，火别太大，口感才有层次。",
    "椰浆小火煮，才不会分层。，起锅前尝味，口感才不发柴。",
    "柠檬汁最后加，酸香才清。，时间掐准，食材才不糊。"
  ],
  "common_mistakes": [
    "鱼直接下锅炖，肉散成渣。，别用力搅，食材才不糊。",
    "椰浆大火滚，油水分离。，注意别烧干，细节才到位。",
    "咖喱粉没炒，味道发涩。，汤汁别收太干，火候才均匀。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "罗非鱼",
      "ratio": "800 克:800 克",
      "note": "肉更紧实，炖制时间加两分钟。"
    },
    {
      "original": "椰浆",
      "substitute": "牛奶",
      "ratio": "250 毫升:250 毫升",
      "note": "奶香更淡，需加黄油十克。"
    }
  ],
  "variations": [
    "加一点酸角汁，酸味更地道。，别用力搅，咸淡才好把握。",
    "加土豆块同炖，汤汁更稠。，起锅前尝味，成品才好看。"
  ],
  "serving_suggestion": "配白米饭或薄饼，浇上咖喱汁。，盖盖焖一会儿，火候才均匀。",
  "storage": "冷藏一天，复热小火加热。，手法轻些，锅气才足。",
