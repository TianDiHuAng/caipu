        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "刷肉",
          "optional": false
        },
        {
          "name": "香菜",
          "name_en": "cilantro",
          "amount": 15,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "小米辣",
          "name_en": "bird's eye chili",
          "amount": 10,
          "unit": "g",
          "note": "切圈",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤架",
    "炭火",
    "刀",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉整块修去多余筋膜，用粗盐和黑胡椒在表面抹匀腌二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "整块烤再切，肉汁才封得住不外流。",
      "visual_cue": "肉块表面均匀挂盐，微微出水"
    },
    {
      "n": 2,
      "text": "炭火烧到通红且没有明火，再把烤架架高约十厘米。",
      "time_min": 10,
      "heat": "大火",
      "tip": "炭要烧到表面覆一层白灰，明火容易烧焦表皮。",
      "visual_cue": "炭块通红,表面白灰覆盖"
    },
    {
      "n": 3,
      "text": "牛肉整块放上烤架，先用大火烤五分钟封住表面。",
      "time_min": 5,
      "heat": "大火",
      "tip": "高温封表面锁汁，是整块烤法的关键。",
      "visual_cue": "表面焦褐，肉汁不出"
    },
    {
      "n": 4,
      "text": "翻面后刷一层植物油，转中火慢烤十五分钟。",
      "time_min": 16,
      "heat": "中火",
      "tip": "刷油能防止表面干裂，也让盐香附着。",
      "visual_cue": "表面油亮，肉香溢出"
    },
    {
      "n": 5,
      "text": "再次翻面烤十分钟，用刀刺入最厚处确认熟度。",
      "time_min": 10,
      "heat": "中火",
      "tip": "刺入流出的汁应清不红，才是全熟。",
      "visual_cue": "刀口流出清汁，肉块回弹"
    },
    {
      "n": 6,
      "text": "离火静置八分钟，让肉汁重新分布再切成薄片。",
      "time_min": 9,
      "heat": "无火",
      "tip": "静置是整块烤肉最重要的一步，别急着切。",
      "visual_cue": "切面湿润，汁水不外渗"
    },
    {
      "n": 7,
      "text": "撒香菜与小米辣圈，配番茄片、洋葱圈和柠檬角上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "柠汁挤在热肉上，酸香立刻被激出来。",
      "visual_cue": "肉片粉褐多汁，配菜清爽"
    }
  ],
  "tips": [
    "选带筋膜的肋条，烤后胶质香而不柴。",
    "没有炭火用烤箱二百二十度烤二十分钟翻面再十分钟。",
    "切肉时逆纹切薄片，嚼起来才不费劲。"
  ],
  "common_mistakes": [
    "明火直接烧，表面焦黑里面还是血水。",
    "烤完立刻切，肉汁流满砧板肉变干。",
    "全程大火不刷油，表面干硬像木炭。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "1000 克:1000 克",
      "note": "加孜然五克，烤制时间延长五分钟。"
    },
    {
      "original": "植物油",
      "substitute": "黄油",
      "ratio": "30 毫升:25 克",
      "note": "刷肉时奶香更浓，需中小火避免焦化。"
    }
  ],
  "variations": [
    "搭配乌咖喱和炒甘蓝，就是肯尼亚最标准的一餐。",
    "把肉切小块串起来烤，更快熟也更入味。"
  ],
  "serving_suggestion": "配乌咖喱、番茄洋葱沙拉和辣椒柠檬汁同食，用手抓着吃。",
  "storage": "冷藏三天；复热用烤箱一百八十度六分钟，切片后加一勺肉汁防干。",
  "nutrition_estimate": {
    "basis": "每份约 280 克",
    "calories_kcal": 640,
    "protein_g": 48,
    "fat_g": 44,
    "carbs_g": 8,
