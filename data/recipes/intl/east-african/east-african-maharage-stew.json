  "steps": [
    {
      "n": 1,
      "text": "红腰豆提前泡八小时，冲洗沥干。，很多人在这里出错。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡足时间，豆才易软。，锅温要匀，别忽高忽低。",
      "visual_cue": "豆粒饱满，表皮起皱，起锅前尝一口定咸淡。"
    },
    {
      "n": 2,
      "text": "豆子加清水煮开，撇去浮沫。，试一下咸淡再上桌。，全程中小火，食材才不糊。",
      "time_min": 8,
      "heat": "大火",
      "tip": "先煮豆，汤才不浑。，这步别省。，翻动放轻，别压碎。",
      "visual_cue": "浮沫上浮，汤面翻涌，注意别让汤汁烧干。"
    },
    {
      "n": 3,
      "text": "转小火炖三十分钟到豆半软。，手法轻些，别弄散。，慢慢来，别心急。",
      "time_min": 32,
      "heat": "小火",
      "tip": "豆先炖软，再下其他料。，火别太大，稳着来。",
      "visual_cue": "豆皮开裂，捏得动，味道最后调最稳。"
    },
    {
      "n": 4,
      "text": "炖锅另倒植物油，炒洋葱丁到透明。，别用力搅，整道菜才立得住。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒软，味道才甜。，手法轻些，成品才好看。",
      "visual_cue": "洋葱透明，香气散出，火别太大，成品才好看。"
    },
    {
      "n": 5,
      "text": "加蒜末、姜泥、咖喱粉和辣椒粉炒香。，时间掐准，整道菜才立得住。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "香料炒过，才不涩。，慢慢来别急，锅气才足。",
      "visual_cue": "香气冲鼻，油色变黄，锅温要匀，整道菜才立得住。"
    },
    {
      "n": 6,
      "text": "下番茄丁炒到出汁。，锅温要匀，口感才不发柴。，起锅前尝味，细节才到位。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄炒出汁，汤才红亮。，慢慢来别急，颜色才够亮。",
      "visual_cue": "汁水泛红，皮卷起，火别太大，味道才不闷。"
    },
    {
      "n": 7,
      "text": "加胡萝卜丁翻炒两分钟。，汤汁别收太干，咸淡才好把握。",
      "time_min": 3,
      "heat": "中火",
      "tip": "胡萝卜切小，熟得快。，慢慢来别急，口感才不发柴。",
      "visual_cue": "丁块油亮，颜色鲜明，锅温要匀，颜色才够亮。"
    },
    {
      "n": 8,
      "text": "把豆子和汤一起倒入锅中。，料别一次下太多，形状才完整。",
      "time_min": 3,
      "heat": "中火",
      "tip": "连汤倒入，味道才融合。，料别一次下太多，细节才到位。",
      "visual_cue": "豆汤合锅，颜色发红，盖盖焖一会儿，形状才完整。"
    },
    {
      "n": 9,
      "text": "小火盖盖炖十五分钟，加盐和黑胡椒。，别用力搅，细节才到位。",
      "time_min": 17,
      "heat": "小火",
      "tip": "最后加盐，豆子才不会硬。，料别一次下太多，咸淡才好把握。",
      "visual_cue": "汤汁浓稠，豆粒软糯，起锅前尝味，形状才完整。"
    },
    {
      "n": 10,
      "text": "撒香菜碎，关火焖两分钟。，料别一次下太多，火候才均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "关火焖一下，香气才沉。，注意别烧干，食材才不糊。",
      "visual_cue": "香草浮面，汤色深红，起锅前尝味，锅气才足。"
    }
  ],
  "tips": [
    "豆子泡足八小时，炖起来才省时。，盖盖焖一会儿，颜色才够亮。",
    "盐最后加，豆皮才不会硬。，留意锅底，形状才完整。",
    "香料先炒香，味道才透。，别用力搅，味道才进得去。"
  ],
  "common_mistakes": [
    "豆子没泡就煮，硬心难消。，保持中小火，味道才不闷。",
    "盐放太早，豆子久煮不软。，翻动放轻，口感才不发柴。",
    "火太猛，把豆煮成泥。，汤汁别收太干，颜色才够亮。"
  ],
  "substitutions": [
