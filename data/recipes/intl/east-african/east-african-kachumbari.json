  "equipment": [
    "刀",
    "砧板",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄去蒂切成半厘米厚片，再切成小块，保留汁水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "番茄别挤汁，汁水就是这道沙拉的酱。",
      "visual_cue": "番茄块整齐，盘中带汁"
    },
    {
      "n": 2,
      "text": "洋葱横切成极薄的圈，用冰水泡十分钟去掉辛味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冰水泡过洋葱才不冲鼻，甜味更明显。",
      "visual_cue": "洋葱圈透亮，辛味变淡"
    },
    {
      "n": 3,
      "text": "洋葱彻底沥干水分，再与番茄块一起放进大碗。",
      "time_min": 2,
      "heat": "无火",
      "tip": "洋葱一定沥干，带水会稀释味道。",
      "visual_cue": "碗中干爽，无积水"
    },
    {
      "n": 4,
      "text": "加盐与黑胡椒，用手轻轻翻拌三十秒让味道渗进去。",
      "time_min": 1,
      "heat": "无火",
      "tip": "用手拌比勺子温柔，番茄不易压烂。",
      "visual_cue": "番茄表面微微出水"
    },
    {
      "n": 5,
      "text": "挤入青柠汁，撒香菜碎与小米辣圈，再拌两下即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青柠汁上桌前才挤，香气才不散。",
      "visual_cue": "沙拉清亮，香菜翠绿"
    }
  ],
  "tips": [
    "紫皮洋葱比白洋葱甜，生吃更合适。",
    "加一勺烤花生碎，口感更接近东非街头版本。",
    "拌好静置五分钟再吃，味道更融合。"
  ],
  "common_mistakes": [
    "洋葱没泡水直接拌，辣得盖住番茄的甜。",
    "番茄切得太碎，拌完变成一滩汁。",
    "盐放得太多，蔬菜急速出水，整碗变成汤水。"
  ],
  "substitutions": [
    {
      "original": "青柠",
      "substitute": "柠檬",
      "ratio": "80 克:80 克",
      "note": "酸度接近，香气稍柔。"
    },
    {
      "original": "小米辣",
      "substitute": "辣椒粉",
      "ratio": "8 克:2 克",
      "note": "辣味更均匀，没有鲜辣感。"
    }
  ],
  "variations": [
    "加牛油果块，做成更饱腹的版本。",
    "拌入烤牛肉薄片，直接当主菜吃。"
  ],
  "serving_suggestion": "配烤牛肉、乌伽黎或米饭，作为解腻的凉菜。",
  "storage": "冷藏一天内吃完，久放会大量出水、香菜发黑。",
