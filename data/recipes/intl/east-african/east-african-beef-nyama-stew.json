  "steps": [
    {
      "n": 1,
      "text": "牛肉切大块，用盐和黑胡椒抓匀。，锅温要匀，别忽高忽低。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉块擦干再煎，才出焦香。，这步别省。，翻动放轻，别压碎。",
      "visual_cue": "肉块干爽，调料均匀，慢慢来，别心急。"
    },
    {
      "n": 2,
      "text": "炖锅倒植物油，牛肉分批煎上色。，很多人在这里出错。",
      "time_min": 10,
      "heat": "大火",
      "tip": "分批煎，温度才不会掉。，试一下咸淡再上桌。",
      "visual_cue": "表面焦褐，锅底留香，注意别让汤汁烧干。"
    },
    {
      "n": 3,
      "text": "盛出牛肉，余油炒洋葱丝到软。，火别太大，稳着来。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒透，汤底才甜。，手法轻些，别弄散。",
      "visual_cue": "洋葱透明，边缘金黄，起锅前尝一口定咸淡。"
    },
    {
      "n": 4,
      "text": "加蒜末、姜泥、咖喱粉和红椒粉炒香。，味道最后调最稳。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "香料遇油才出味。，全程中小火，食材才不糊。",
      "visual_cue": "油色泛红，香气浓郁，料别一次下太多，香气才不跑。"
    },
    {
      "n": 5,
      "text": "下番茄块炒到出汁变稠。，料别一次下太多，颜色才够亮。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒出沙，汤才浓。，料别一次下太多，整道菜才立得住。",
      "visual_cue": "汁水红亮，番茄软塌，手法轻些，味道才进得去。"
    },
    {
      "n": 6,
      "text": "放回牛肉，加胡萝卜和清水煮开。，时间掐准，细节才到位。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水开撇沫，汤才清。，锅温要匀，火候才均匀。",
      "visual_cue": "汤面翻涌，浮沫上浮，料别一次下太多，口感才有层次。"
    },
    {
      "n": 7,
      "text": "转小火盖盖炖五十分钟。，留意锅底，火候才均匀。，手法轻些，食材才不糊。",
      "time_min": 52,
      "heat": "小火",
      "tip": "小火慢炖，肉才软烂。，翻动放轻，整道菜才立得住。",
      "visual_cue": "肉一戳就散，汤色深红，注意别烧干，香气才不跑。"
    },
    {
      "n": 8,
      "text": "加土豆块，再炖十五分钟。，锅温要匀，口感才有层次。",
      "time_min": 16,
      "heat": "小火",
      "tip": "土豆后放，才不会煮化。，保持中小火，口感才不发柴。",
      "visual_cue": "土豆透亮，边缘圆润，翻动放轻，香气才不跑。"
    },
    {
      "n": 9,
      "text": "加盐调味，开盖收汁五分钟。，起锅前尝味，味道才进得去。",
      "time_min": 7,
      "heat": "中火",
      "tip": "收汁别太干，拌饭才好吃。，保持中小火，食材才不糊。",
      "visual_cue": "汤汁浓稠，油光浮动，时间掐准，味道才不闷。"
    },
    {
      "n": 10,
      "text": "撒香菜碎，趁热盛盘。，留意锅底，味道才不闷。，火别太大，颜色才够亮。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香菜最后放，颜色才绿。，汤汁别收太干，成品才好看。",
      "visual_cue": "香气扑鼻，汤色红亮，锅温要匀，香气才不跑。"
    }
  ],
  "tips": [
    "牛肉分批煎，焦香才足。，留意锅底，食材才不糊。",
    "土豆后放，才不会煮成糊。，翻动放轻，口感才有层次。",
    "收汁留一点，拌饭最香。，注意别烧干，口感才不发柴。"
  ],
  "common_mistakes": [
    "火大滚煮，肉质发柴。，火别太大，锅气才足。",
    "番茄没炒透，汤味发涩。，汤汁别收太干，口感才有层次。",
    "水加太多，汤变成稀水。，时间掐准，锅气才足。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊腿肉",
      "ratio": "800 克:800 克",
      "note": "风味更重，可加咖喱粉一克。"
    },
    {
      "original": "土豆",
      "substitute": "山药",
      "ratio": "200 克:200 克",
      "note": "口感更糯，炖制时间减三分钟。"
    }
  ],
  "variations": [
    "加一把青豆同炖，颜色更鲜。，留意锅底，味道才进得去。",
    "喜欢辣的可加辣椒粉，味道更冲。，留意锅底，整道菜才立得住。"
  ],
  "serving_suggestion": "配乌伽黎或米饭，浇上汤汁。，盖盖焖一会儿，细节才到位。",
  "storage": "冷藏三天，复热加少量水。，慢慢来别急，咸淡才好把握。",
