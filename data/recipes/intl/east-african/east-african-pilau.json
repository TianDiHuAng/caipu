  "steps": [
    {
      "n": 1,
      "text": "大米淘洗后泡十分钟，捞出沥干备用。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡过的大米煮起来粒粒分明。，注意火候。",
      "visual_cue": "米粒白净，水已沥干，状态稳定"
    },
    {
      "n": 2,
      "text": "牛肉切成两厘米的块，洋葱切丝，番茄切丁。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "牛肉块别太小，炖完才不柴。，注意火候。",
      "visual_cue": "肉块方正，洋葱丝细，状态稳定"
    },
    {
      "n": 3,
      "text": "深锅倒植物油，下孜然、肉桂、豆蔻和丁香小火炒香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "整粒香料先炒，香气才彻底出来。，注意火候。",
      "visual_cue": "香气浓烈，油色微黄，状态稳定"
    },
    {
      "n": 4,
      "text": "加洋葱丝中火炒到金黄，再下蒜末和姜末炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒到金黄，甜味才够。，注意火候。",
      "visual_cue": "洋葱焦黄，边缘微脆，状态稳定"
    },
    {
      "n": 5,
      "text": "放入牛肉块翻炒到表面变色，加番茄丁炒出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "牛肉炒上色，饭底才够香。，注意火候。",
      "visual_cue": "肉块上色，汁水泛红，状态稳定"
    },
    {
      "n": 6,
      "text": "加盐和黑胡椒，倒一碗清水，小火炖十五分钟。",
      "time_min": 16,
      "heat": "小火",
      "tip": "先把肉炖到半软，再和米同煮。，注意火候。",
      "visual_cue": "汤汁略收，肉已半软，状态稳定"
    },
    {
      "n": 7,
      "text": "倒入大米和两倍清水，搅匀后大火烧开。这一步不要着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "水和米齐平稍高一点，煮干才不夹生。",
      "visual_cue": "液面齐平，米粒浮起，状态稳定"
    },
    {
      "n": 8,
      "text": "转最小火盖紧锅盖焖十五分钟，中途不开盖。这一步不要着急。",
      "time_min": 16,
      "heat": "小火",
      "tip": "中途开盖，蒸汽跑了饭就夹生。，注意火候。",
      "visual_cue": "液面收干，饭面起孔，状态稳定"
    },
    {
      "n": 9,
      "text": "关火焖五分钟，撒香菜碎后翻松盛出。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "关火再焖，米芯才彻底熟透。，注意火候。",
      "visual_cue": "米粒松散，香气浓烈，状态稳定"
    }
  ],
  "tips": [
    "大米先泡十分钟，煮出来粒粒分明。，值得留意。",
    "整粒香料先小火炒，香气才彻底。，值得留意。",
    "焖饭中途不开盖，蒸汽一跑就夹生。，值得留意。"
  ],
  "common_mistakes": [
    "水加太多，饭炖成一锅糊。，值得留意。",
    "香料大火炒，几秒就发苦。，值得留意。",
    "中途开盖看，饭夹生还夹硬芯。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡腿",
      "ratio": "350 克:350 克",
      "note": "炖制时间减五分钟。"
    },
    {
      "original": "肉桂",
      "substitute": "桂皮",
      "ratio": "3 克:3 克",
      "note": "香气更粗犷，用量可略减。"
    }
  ],
  "variations": [
    "加几颗葡萄干，甜咸更东非。，值得留意。",
    "配香蕉片一起吃，甜味解辣。，值得留意。"
  ],
  "serving_suggestion": "配烤牛肉和番茄洋葱沙拉，是东非节庆的标准组合。",
  "storage": "冷藏两天，复热加一勺水小火焖五分钟。，效果更稳定。",
