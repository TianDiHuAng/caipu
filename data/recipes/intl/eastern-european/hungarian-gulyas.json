  "equipment": [
    "汤锅",
    "木勺",
    "砧板",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩切两厘米方块，用厨房纸吸干表面水分，撒一点盐抓匀。",
      "time_min": 7,
      "heat": "无火",
      "tip": "表面吸干再煎，肉才会上色而不是出水。",
      "visual_cue": "肉块干爽，表面微白"
    },
    {
      "n": 2,
      "text": "汤锅放植物油中火烧热，牛腩分批下锅煎到六面焦褐后取出。",
      "time_min": 12,
      "heat": "中火",
      "tip": "分批煎，锅温才不掉，焦褐色是汤香的来源。",
      "visual_cue": "肉块焦褐，锅底留香"
    },
    {
      "n": 3,
      "text": "原锅下洋葱丁，中小火炒五分钟到软塌透明，锅底焦屑刮起。",
      "time_min": 7,
      "heat": "小火",
      "tip": "洋葱炒透，甜味出来汤才不寡淡。",
      "visual_cue": "洋葱软塌，锅底刮净"
    },
    {
      "n": 4,
      "text": "锅离火，撒入甜椒粉快速拌匀，让红粉在余温里散开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "甜椒粉遇高温会发苦，离火拌是保命的一步。",
      "visual_cue": "洋葱裹上红粉，香气冲鼻"
    },
    {
      "n": 5,
      "text": "放回牛腩，加番茄块、番茄膏、香菜籽和香叶翻匀上色。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄和番茄膏一起炒，汤色才红得透亮。",
      "visual_cue": "肉块挂红，锅里冒香"
    },
    {
      "n": 6,
      "text": "倒高汤没过肉块，烧开后转小火炖七十五分钟到肉变软。",
      "time_min": 78,
      "heat": "小火",
      "tip": "小火慢炖，汤只冒小泡，肉才酥而不散。",
      "visual_cue": "汤面微沸，肉块轻压即开"
    },
    {
      "n": 7,
      "text": "加土豆块、胡萝卜片和青椒条，中火煮二十分钟到土豆软透。",
      "time_min": 22,
      "heat": "中火",
      "tip": "土豆后放，早放会化成泥把汤弄糊。",
      "visual_cue": "土豆软透，汤体略稠"
    },
    {
      "n": 8,
      "text": "加盐和黑胡椒调味，关火撒切碎的大蒜和欧芹碎，静置三分钟再盛。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置几分钟让味道融合，热着喝反而冲。",
      "visual_cue": "汤色红亮，油花浮面"
    }
  ],
  "tips": [
    "匈牙利人把这道汤当主菜，配面包就是一顿完整的饭。",
    "甜椒粉分两次放，一半炒香一半出锅前撒，香气层次更好。",
    "汤要稠而不糊，土豆贡献的淀粉刚好够。"
  ],
  "common_mistakes": [
    "甜椒粉在滚油里炒，瞬间发黑，整锅汤带焦苦味。",
    "牛腩没煎上色就加水，汤色灰白，一点肉香都没有。",
    "土豆和肉同时下锅，等肉软了土豆早化成泥。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛小腿肉",
      "ratio": "600克:600克",
      "note": "小腿肉胶质多，炖的时间需延长十五分钟，汤更浓。"
    },
    {
      "original": "青椒",
      "substitute": "甜椒",
      "ratio": "150克:150克",
      "note": "甜椒版更甜不辣，孩子更容易接受。"
    }
  ],
  "variations": [
    "加一把小面疙瘩一起煮，汤变成主食，是农家常见吃法。",
    "最后淋一勺酸奶油，酸香压住油腻，口感更圆。"
  ],
  "serving_suggestion": "用厚陶碗盛，撒欧芹碎，配一块乡村面包蘸汤吃。",
  "storage": "冷藏可存三天，冷冻可存一个月；复热时补少量高汤，别反复烧开。",
