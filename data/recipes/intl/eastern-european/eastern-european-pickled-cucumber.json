        }
      ]
    }
  ],
  "equipment": [
    "玻璃罐",
    "小锅",
    "刀",
    "重物"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小黄瓜洗净后泡在凉水里半小时，去掉表面的泥土和热气。",
      "time_min": 32,
      "heat": "无火",
      "tip": "泡过凉水的黄瓜更脆，腌出来不软。",
      "visual_cue": "黄瓜挺实，表皮清亮"
    },
    {
      "n": 2,
      "text": "黄瓜两端切掉一小片，让盐水更快渗进瓜肉里。",
      "time_min": 6,
      "heat": "无火",
      "tip": "两端切开一道口，腌得快也更入味。",
      "visual_cue": "切口平整，瓜身完整"
    },
    {
      "n": 3,
      "text": "清水加盐煮开后彻底放凉，调成约百分之四的盐水。",
      "time_min": 8,
      "heat": "中火",
      "tip": "盐水一定要凉透，热盐水会把瓜烫软。",
      "visual_cue": "盐粒完全溶解无沉淀"
    },
    {
      "n": 4,
      "text": "玻璃罐底先铺一层莳萝、大蒜、小米辣和黑胡椒粒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香料铺在罐底，香气从下往上渗透。",
      "visual_cue": "罐底铺满一层香料"
    },
    {
      "n": 5,
      "text": "黄瓜竖着码进罐子里，尽量挤紧不留多余空隙。",
      "time_min": 5,
      "heat": "无火",
      "tip": "码得越紧实，浮起来的可能越小。",
      "visual_cue": "瓜身直立，紧密排列"
    },
    {
      "n": 6,
      "text": "倒入凉盐水完全淹没黄瓜，压上重物后盖好盖子。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄瓜必须全部浸在盐水里，露出就会发霉。",
      "visual_cue": "液面高出瓜身两指"
    },
    {
      "n": 7,
      "text": "室温静置一天起泡发酸，再移入冰箱冷藏继续发酵两周。",
      "time_min": 720,
      "heat": "无火",
      "tip": "每天开盖放一次气，避免罐内压力过大。",
      "visual_cue": "液体浑浊，气味发酸"
    }
  ],
  "tips": [
    "盐水必须完全放凉再用，热盐水会把黄瓜烫软。",
    "黄瓜要全部浸在液面下，露出水面容易长白膜。",
    "发酵期间每天开盖放气，避免罐内压力过大。"
  ],
  "common_mistakes": [
    "用碘盐或加氯的自来水，发酵迟迟不起泡。",
    "黄瓜露出液面，几天后表面长出白霉。",
    "罐子没洗净带油，整罐发臭腐败。"
  ],
  "substitutions": [
    {
      "original": "小米辣",
      "substitute": "黑胡椒",
      "ratio": "10 克:3 克",
      "note": "辣味更柔和，香气不同。"
    },
    {
      "original": "莳萝",
      "substitute": "小茴香",
      "ratio": "20 克:20 克",
      "note": "香气接近，略带甘草甜。"
    }
  ],
  "variations": [
    "切片而不是整根腌，两天就能吃了。"
  ],
  "serving_suggestion": "配烤肉、土豆泥或三明治，是东欧餐桌全年不断的开胃小菜。",
  "storage": "连盐水冷藏可存两个月，取用时用干净筷子，液面下降可补凉盐水。",
