    "电动打蛋器",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶油奶酪提前两小时从冰箱取出，切块放盆里软化到手指能压出坑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "奶酪一定要回温，冷的打出来会有小疙瘩。",
      "visual_cue": "奶酪软塌，表面油润"
    },
    {
      "n": 2,
      "text": "模具内壁刷一层黄油，底部铺烘焙纸，外层再裹两层锡纸防进水。",
      "time_min": 9,
      "heat": "无火",
      "tip": "锡纸包严实，水浴时才不会渗进模具。",
      "visual_cue": "模具服帖，锡纸包边"
    },
    {
      "n": 3,
      "text": "奶酪用打蛋器低速打散，分三次加白糖，打到顺滑无颗粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "全程低速，打进空气烤完会塌陷开裂。",
      "visual_cue": "糊体细腻，能顺滑流动"
    },
    {
      "n": 4,
      "text": "鸡蛋一个一个加入，每次都搅到完全融合再加下一个。",
      "time_min": 10,
      "heat": "无火",
      "tip": "一次加太多蛋，糊体容易油水分离。",
      "visual_cue": "蛋液吸收，颜色均匀"
    },
    {
      "n": 5,
      "text": "加酸奶油、融化黄油、柠檬皮屑和香草精拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "柠檬皮只刮黄色那层，白色会发苦。",
      "visual_cue": "糊体浓稠，闻着有柠檬香"
    },
    {
      "n": 6,
      "text": "面粉过筛拌进去，再放泡软沥干的葡萄干，轻轻翻匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌到看不见干面粉就停，过度搅拌会出筋变硬。",
      "visual_cue": "面糊顺滑，葡萄干均匀"
    },
    {
      "n": 7,
      "text": "面糊倒进模具抹平，放进烤盘注入热水，一百六十度水浴烤七十分钟。",
      "time_min": 73,
      "heat": "中火",
      "tip": "水浴让温度温和，蛋糕才细腻不开裂。",
      "visual_cue": "表面微鼓，中心轻晃"
    },
    {
      "n": 8,
      "text": "关火后留一条缝，让蛋糕在烤箱里慢慢降温一小时再取出。",
      "time_min": 62,
      "heat": "无火",
      "tip": "骤然降温会塌陷，慢慢凉是保命的一步。",
      "visual_cue": "表面平整，边缘略收"
    },
    {
      "n": 9,
      "text": "冷藏四小时以上，脱模切块，刀口用热水烫过更利落。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冷藏一夜风味最好，芝士味会更融合。",
      "visual_cue": "切面细腻，无气孔"
    }
  ],
  "tips": [
    "这道芝士蛋糕是波兰节日和复活节的必备甜点。",
    "全程低速搅拌是核心，气泡是芝士蛋糕最大的敌人。",
    "冷藏过夜再切，味道和质地都好上一个台阶。"
  ],
  "common_mistakes": [
    "奶酪没回温就打，糊体一直有小颗粒，烤完口感粗糙。",
    "高速猛打带入大量空气，出炉后中间塌出一个坑。",
    "烤完立刻取出，温差太大，表面裂成蛛网。"
  ],
  "substitutions": [
    {
      "original": "奶油奶酪",
      "substitute": "农夫奶酪",
      "ratio": "800克:800克",
      "note": "农夫奶酪是传统选择，需过筛两次才够细。"
    },
    {
      "original": "葡萄干",
      "substitute": "蔓越莓干",
      "ratio": "60克:60克",
      "note": "蔓越莓更酸，能中和甜度，用量相同即可。"
    }
  ],
  "variations": [
    "表面淋一层巧克力淋面，是波兰孩子最爱的版本。",
    "加两勺可可粉做成可可味，颜色深，甜味也更收敛。"
  ],
  "serving_suggestion": "切厚片配一杯红茶或咖啡，冷藏后风味最佳。",
  "storage": "冷藏可存四天，冷冻可存一个月；解冻后冷藏回温再吃。",
