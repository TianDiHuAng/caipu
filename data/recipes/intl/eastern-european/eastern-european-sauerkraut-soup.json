  "steps": [
    {
      "n": 1,
      "text": "五花肉切块冷水下锅焯三分钟，撇去浮沫后捞出冲洗干净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "焯水去腥，汤才清亮不带动物的杂味。",
      "visual_cue": "肉块表面变白，浮沫撇净"
    },
    {
      "n": 2,
      "text": "汤锅放植物油，中火炒洋葱丁和胡萝卜丁五分钟到洋葱透明。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先把蔬菜炒出甜味，汤底才不会寡淡。",
      "visual_cue": "洋葱透明，胡萝卜变软"
    },
    {
      "n": 3,
      "text": "下五花肉块同炒两分钟，倒入一千五百毫升清水大火烧开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水要一次加足，中途加水汤味会淡。",
      "visual_cue": "水面滚开，肉块沉底"
    },
    {
      "n": 4,
      "text": "放入香叶和黑胡椒粒，转小火盖盖慢煮三十分钟。",
      "time_min": 30,
      "heat": "小火",
      "tip": "小火慢慢煨，肉块才软烂而不散开。",
      "visual_cue": "肉块变软，汤色微黄"
    },
    {
      "n": 5,
      "text": "加入酸菜和土豆块，继续小火煮二十分钟到土豆软透。",
      "time_min": 21,
      "heat": "小火",
      "tip": "酸菜后下，煮久了酸味会盖过肉香。",
      "visual_cue": "土豆边缘化开，汤变稠"
    },
    {
      "n": 6,
      "text": "加盐调味，挑出香叶，关火静置十分钟再盛。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置十分钟，酸味和肉味才会融合在一起。",
      "visual_cue": "汤色乳黄，酸香扑鼻"
    }
  ],
  "tips": [
    "酸菜别挤太干，留一点汁水汤才有层次。",
    "香叶和整粒黑胡椒是东欧汤的底香，别省。",
    "土豆后下煮到边缘化开，汤自然变稠。"
  ],
  "common_mistakes": [
    "酸菜一开始就下锅，煮到只剩单调的酸。",
    "五花肉没有焯水，汤里带着明显的腥味。",
    "水加太少中途补水，汤味被彻底冲淡。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "香肠",
      "ratio": "300 克:300 克",
      "note": "切厚片，最后十五分钟再下。"
    },
    {
      "original": "酸菜",
      "substitute": "卷心菜加米醋",
      "ratio": "400 克:400 克+30 毫升",
      "note": "酸度更轻，需多煮十分钟。"
    }
  ],
  "variations": [
    "加一勺酸奶油，汤体更醇厚顺滑。",
    "加一小把干蘑菇同煮，香气更浓郁。"
  ],
  "serving_suggestion": "盛进深碗，配一片黑麦面包或一勺酸奶油，东欧人冬天常拿它当正餐。",
  "storage": "冷藏三天、冷冻一个月，复热后酸味会更明显，可加少许糖平衡。",
