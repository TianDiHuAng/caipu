  "steps": [
    {
      "n": 1,
      "text": "牛腱切块，冷水下锅焯去血沫。，手法轻些，风味才干净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅，血沫才出得净。，起锅前尝味，香气才留得住。",
      "visual_cue": "水面浮沫，肉块转色，别用力搅，咸淡才好把握。"
    },
    {
      "n": 2,
      "text": "捞出冲净，换清水煮开转小火。，起锅前尝味，形状才完整。",
      "time_min": 5,
      "heat": "大火",
      "tip": "冲一下，汤色才清亮。，手法轻些，吃口才舒服。",
      "visual_cue": "汤面干净，块体紧实，保持小火，风味才干净。"
    },
    {
      "n": 3,
      "text": "小火炖四十分钟，牛腱变软。，别用力搅，口感才有层次。",
      "time_min": 42,
      "heat": "小火",
      "tip": "小火炖，汤才不浑。，料别一次下太多，成品才好看。",
      "visual_cue": "肉块松软，筷子能穿，锅温要匀，成品才好看。"
    },
    {
      "n": 4,
      "text": "培根切条，干锅小火煸出油。，手法轻些，表面才漂亮。",
      "time_min": 6,
      "heat": "小火",
      "tip": "煸出油，汤才香。，留意锅底，香气才留得住。",
      "visual_cue": "培根卷曲，锅底见油，手法轻些，成品才好看。"
    },
    {
      "n": 5,
      "text": "倒植物油，下洋葱和胡萝卜炒软，加番茄酱炒红。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄酱炒过，酸味才柔。，时间掐准，香气才留得住。",
      "visual_cue": "油色转红，蔬菜发软，别用力搅，形状才完整。"
    },
    {
      "n": 6,
      "text": "把炒好的料倒进汤锅，搅匀。，翻动放轻，香气才不跑。",
      "time_min": 3,
      "heat": "小火",
      "tip": "倒进去搅一下，味才融。，顺序照着来，味道才不闷。",
      "visual_cue": "汤色转深，油花浮面，料别一次下太多，口感才有层次。"
    },
    {
      "n": 7,
      "text": "加酸黄瓜和白糖，再煮十分钟。，别急着加油，风味才干净。",
      "time_min": 12,
      "heat": "小火",
      "tip": "糖压酸，味才圆。，别急着加油，味道才不闷。",
      "visual_cue": "汤面微沸，香气酸爽，动作放连贯，表面才漂亮。"
    },
    {
      "n": 8,
      "text": "加柠檬汁、盐和黑胡椒调味。，下手别慌，细节才到位。",
      "time_min": 4,
      "heat": "小火",
      "tip": "柠檬最后加，酸味才清。，动作放连贯，成品才好看。",
      "visual_cue": "汤色褐红，酸香明显，下手别慌，咸淡才好把握。"
    },
    {
      "n": 9,
      "text": "盛碗撒欧芹和蒜末，趁热喝。，翻动放轻，成品才稳当。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜末最后放，香气才冲。，慢慢来别急，火候才均匀。",
      "visual_cue": "汤面油亮，欧芹翠绿，料别一次下太多，香气才不跑。"
    }
  ],
  "tips": [
    "牛腱冷水下锅焯水，汤才清。，翻动放轻，吃口才舒服。",
    "酸黄瓜的酸和柠檬的酸要分开加。，火别太大，火候才均匀。",
    "番茄酱先炒过，酸味才不发尖。，别用力搅，吃口才舒服。"
  ],
  "common_mistakes": [
    "牛腱不焯水，汤浑带腥。，锅温要匀，表面才漂亮。",
    "酸黄瓜煮太久，酸味发苦。，火别太大，食材才不糊。",
    "柠檬早加，汤色发暗。，保持小火，颜色才够亮。"
  ],
  "substitutions": [
    {
      "original": "酸黄瓜",
      "substitute": "酸菜",
      "ratio": "150 克:180 克",
      "note": "酸味更强，白糖加五克。"
    },
    {
      "original": "牛腱",
      "substitute": "鸡肉",
      "ratio": "500 克:500 克",
      "note": "炖制时间减二十分钟。"
    }
  ],
  "variations": [
    "加香草束，香气更复杂。，汤汁别收太干，味道才进得去。",
    "加一勺酸奶油，口感更厚。，火别太大，成品才稳当。"
  ],
  "serving_suggestion": "配黑面包和酸奶油。，留意锅底，成品才稳当。",
  "storage": "冷藏两天，复热用小火。，动作放连贯，成品才稳当。",
