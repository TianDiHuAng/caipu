  "steps": [
    {
      "n": 1,
      "text": "面包去边，撕碎泡进牛奶里。，别用力搅，颜色才够亮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡软些，肉饼才嫩。，动作放连贯，味道才不闷。",
      "visual_cue": "面包吸饱，手捏成泥，下手别慌，味道才不闷。"
    },
    {
      "n": 2,
      "text": "洋葱剁细碎，越细越好。，慢慢来别急，口感才不发柴。",
      "time_min": 6,
      "heat": "无火",
      "tip": "剁细些，口感才不冲。，注意别烧干，细节才到位。",
      "visual_cue": "颗粒细碎，汁水渗出，手法轻些，锅气才足。"
    },
    {
      "n": 3,
      "text": "猪肉末加洋葱、鸡蛋和泡软面包。，留意锅底，口感才不发柴。",
      "time_min": 4,
      "heat": "无火",
      "tip": "顺序别乱，才好拌匀。，火别太大，香气才留得住。",
      "visual_cue": "混合均匀，质地黏稠，火别太大，细节才到位。"
    },
    {
      "n": 4,
      "text": "加盐和黑胡椒，顺一个方向搅上劲。，锅温要匀，食材才不糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅上劲，煎时才不散。，别用力搅，细节才到位。",
      "visual_cue": "肉馅发黏，能拉丝，盖盖焖一会儿，整道菜才立得住。"
    },
    {
      "n": 5,
      "text": "手上蘸水，把肉馅搓成八个椭圆饼。，下手别慌，表面才漂亮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "手蘸水，肉馅才不粘。，料别一次下太多，颜色才够亮。",
      "visual_cue": "饼形椭圆，大小一致，注意别烧干，锅气才足。"
    },
    {
      "n": 6,
      "text": "肉饼两面薄薄拍一层面粉。，汤汁别收太干，口感才不发柴。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拍薄些，煎出来才脆。，份量心里有数，香气才留得住。",
      "visual_cue": "表面干爽，粉层均匀，动作放连贯，颜色才够亮。"
    },
    {
      "n": 7,
      "text": "平底锅倒植物油，中火烧热。，时间掐准，风味才干净。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油别太少，才不粘锅。，起锅前尝味，食材才不糊。",
      "visual_cue": "油面微动，无青烟，注意别烧干，颜色才够亮。"
    },
    {
      "n": 8,
      "text": "下肉饼，两面各煎五分钟到金黄。，别用力搅，香气才不跑。",
      "time_min": 12,
      "heat": "中火",
      "tip": "别急着翻，定型了再动。，翻动放轻，火候才均匀。",
      "visual_cue": "两面上色，边缘焦脆，保持小火，锅气才足。"
    },
    {
      "n": 9,
      "text": "出锅放厨房纸上沥油，配酸奶油吃。，翻动放轻，颜色才够亮。",
      "time_min": 4,
      "heat": "无火",
      "tip": "稍等一分钟，肉汁才回稳。，下手别慌，火候才均匀。",
      "visual_cue": "表面干爽，切面湿润，顺序照着来，食材才不糊。"
    }
  ],
  "tips": [
    "面包泡牛奶，肉饼才嫩。，保持小火，成品才好看。",
    "搅上劲再搓，煎时才不散。，火别太大，锅气才足。",
    "一面定型再翻，形状才完整。，料别一次下太多，整道菜才立得住。"
  ],
  "common_mistakes": [
    "肉馅太湿，下锅就散。，份量心里有数，口感才不发柴。",
    "火太大，外焦里生。，顺序照着来，香气才留得住。",
    "翻面太早，肉饼粘锅。，留意锅底，锅气才足。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉末",
      "ratio": "600 克:600 克",
      "note": "更清爽，牛奶加二十毫升。"
    },
    {
      "original": "面包",
      "substitute": "面包糠",
      "ratio": "100 克:60 克",
      "note": "吸水更强，牛奶减二十毫升。"
    }
  ],
  "variations": [
    "中间包一块黄油，切开流心。，时间掐准，细节才到位。",
    "加蒜末，香气更足。，保持小火，整道菜才立得住。"
  ],
  "serving_suggestion": "配土豆泥和酸奶油。，火别太大，表面才漂亮。",
  "storage": "冷藏两天，复热用平底锅。，翻动放轻，香气才留得住。",
