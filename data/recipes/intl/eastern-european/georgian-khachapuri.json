        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 100,
          "unit": "g",
          "note": "两枚，一枚和面一枚打面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大盆",
    "擀面杖",
    "烤盘",
    "烤箱",
    "小碗",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温牛奶加白糖与酵母静置十分钟，表面起一层细密泡沫后使用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "牛奶摸起来温而不烫，太热会把酵母烫死。",
      "visual_cue": "液面浮起奶白色泡沫层"
    },
    {
      "n": 2,
      "text": "面粉加盐拌匀，倒入酵母牛奶与一枚鸡蛋，揉成光滑面团后放入抹了橄榄油的盆中，盖湿布发酵至两倍大。",
      "time_min": 80,
      "heat": "无火",
      "tip": "盆底抹油能让面团光滑不粘，取出时也不易破皮。",
      "visual_cue": "面团体积涨到两倍，指压缓慢回弹"
    },
    {
      "n": 3,
      "text": "发好的面团轻压排气，分成四份，擀成三十厘米长的椭圆薄片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别用力擀太薄，边缘留厚一点才撑得住奶酪。",
      "visual_cue": "面片边缘厚、中间略薄"
    },
    {
      "n": 4,
      "text": "面片两端卷起并向内折成船形，边缘捏紧压实，摆上烤盘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "卷边要捏死，否则烤的时候奶酪会从缝里流出来。",
      "visual_cue": "船形两头尖，边缘结实不开口"
    },
    {
      "n": 5,
      "text": "把马苏里拉丝铺进船心，四周刷上融化的黄油，送入二百二十度烤箱烤十五分钟。",
      "time_min": 15,
      "heat": "大火",
      "tip": "奶酪铺满但不压实，烤出的空隙让它自己融化。",
      "visual_cue": "面壳金黄，奶酪鼓泡流动"
    },
    {
      "n": 6,
      "text": "取出后趁热在奶酪中央打入一枚鸡蛋，再回炉烤两分钟至蛋白发白。",
      "time_min": 5,
      "heat": "大火",
      "tip": "蛋黄要留软心，回炉时间看蛋白凝固程度决定。",
      "visual_cue": "蛋黄居中半凝，蛋白刚凝住"
    },
    {
      "n": 7,
      "text": "出炉后趁热拌开软心奶酪与蛋黄，切段趁热食用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拌开这一步是灵魂，让蛋黄和奶酪融成一体。",
      "visual_cue": "奶酪拉丝，软心顺滑流动"
    }
  ],
  "tips": [
    "烤箱要提前充分预热，高温才烤得出脆壳。",
    "没有马苏里拉可用一半莫扎里拉一半咸味奶酪。",
    "趁热吃风味最好，凉了面壳会发硬。"
  ],
  "common_mistakes": [
    "面团没发起来就整形，烤出的面壳像石头一样硬。",
    "奶酪塞太满，烤时溢出铺满烤盘。",
    "回炉时间过长，蛋黄完全凝固失去软心。"
  ],
  "substitutions": [
    {
      "original": "马苏里拉",
      "substitute": "高温拉丝奶酪",
      "ratio": "350 克:350 克",
      "note": "拉丝效果接近，咸度略有不同。"
    },
    {
      "original": "牛奶",
      "substitute": "水",
      "ratio": "250 毫升:230 毫升",
      "note": "香气变淡，面团稍硬。"
    }
  ],
  "variations": [
    "做成圆形填奶酪的 Imeruli 版本，切成扇形食用。",
    "在奶酪里加入五十克煎香的培根粒，风味更浓更咸香。"
  ],
  "serving_suggestion": "切成四段，配一碗清汤或蔬菜沙拉同食。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤五分钟恢复脆壳。",
