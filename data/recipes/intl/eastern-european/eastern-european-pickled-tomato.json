  "equipment": [
    "玻璃罐",
    "锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄洗净擦干，逐个用叉子扎两下。，下手别慌，香气才不跑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "扎孔入味，也防胀裂。，慢慢来别急，香气才留得住。",
      "visual_cue": "表皮有孔，果身干爽，慢慢来别急，颜色才够亮。"
    },
    {
      "n": 2,
      "text": "玻璃罐用开水烫过，晾干备用。，汤汁别收太干，香气才不跑。",
      "time_min": 6,
      "heat": "大火",
      "tip": "罐子无水无油，才不坏。，留意锅底，整道菜才立得住。",
      "visual_cue": "罐壁干爽，无水珠，顺序照着来，火候才均匀。"
    },
    {
      "n": 3,
      "text": "罐底铺莳萝、蒜片、黑胡椒和红辣椒。，顺序照着来，细节才到位。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香料垫底，味才透上来。，留意锅底，颜色才够亮。",
      "visual_cue": "香料铺满，分布均匀，动作放连贯，细节才到位。"
    },
    {
      "n": 4,
      "text": "番茄紧密码进罐里，别压破。，保持小火，香气才留得住。",
      "time_min": 6,
      "heat": "无火",
      "tip": "码紧些，才不浮起来。，下手别慌，香气才留得住。",
      "visual_cue": "果身齐整，罐口留空，手法轻些，味道才进得去。"
    },
    {
      "n": 5,
      "text": "清水加盐和白糖煮开，搅到化开。，份量心里有数，成品才好看。",
      "time_min": 6,
      "heat": "大火",
      "tip": "卤水要滚，才能杀菌。，别急着加油，颜色才够亮。",
      "visual_cue": "液面翻滚，颗粒消失，手法轻些，食材才不糊。"
    },
    {
      "n": 6,
      "text": "趁热把卤水浇进罐里，淹没番茄。，手法轻些，咸淡才好把握。",
      "time_min": 3,
      "heat": "无火",
      "tip": "热卤水浇，罐子别骤冷。，时间掐准，火候才均匀。",
      "visual_cue": "液面没过果身，注意别烧干，口感才不散。"
    },
    {
      "n": 7,
      "text": "盖紧盖子，室温放两天后冷藏。，起锅前尝味，锅气才足。",
      "time_min": 5,
      "heat": "无火",
      "tip": "两天后再冷藏，发酵才起头。，留意锅底，味道才不闷。",
      "visual_cue": "盖子微紧，罐内无气泡，盖盖焖一会儿，成品才好看。"
    },
    {
      "n": 8,
      "text": "冷藏一周后开罐，酸味清爽即可食用。，先试试温度，口感才不散。",
      "time_min": 4,
      "heat": "无火",
      "tip": "开罐先闻一下，酸香才对。，别急着加油，细节才到位。",
      "visual_cue": "酸味清亮，果肉紧实，注意别烧干，形状才完整。"
    }
  ],
  "tips": [
    "番茄要挑硬实的，腌后才不烂。，注意别烧干，味道才进得去。",
    "罐子必须无水无油，否则容易坏。，动作放连贯，食材才不糊。",
    "卤水趁热浇，杀菌效果才好。，下手别慌，形状才完整。"
  ],
  "common_mistakes": [
    "番茄太软，腌完化在罐里。，慢慢来别急，成品才好看。",
    "罐子带水，表面长白膜。，盖盖焖一会儿，香气才留得住。",
    "盐太少，酸味发闷。，盖盖焖一会儿，锅气才足。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "黄瓜",
      "ratio": "800 克:800 克",
      "note": "口感更脆，腌制时间减两天。"
    },
    {
      "original": "莳萝",
      "substitute": "欧芹",
      "ratio": "20 克:20 克",
      "note": "香气更平，用量可略增。"
    }
  ],
  "variations": [
    "加一片辣根，风味更冲。，慢慢来别急，成品才稳当。",
    "加苹果片，酸味更柔。，起锅前尝味，风味才干净。"
  ],
  "serving_suggestion": "配烤肉或土豆泥解腻。，盖盖焖一会儿，香气才不跑。",
  "storage": "冷藏一个月，取用需干净筷子。，汤汁别收太干，咸淡才好把握。",
