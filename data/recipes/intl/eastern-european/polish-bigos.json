  "equipment": [
    "厚底砂锅",
    "刀",
    "砧板",
    "木勺",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉块冷水下锅焯两分钟，捞出洗净血沫沥干。",
      "time_min": 12,
      "heat": "大火",
      "tip": "焯水能带走腥气，炖出来的汤才清亮不浑。",
      "visual_cue": "肉块表面变白，水中浮起灰白沫"
    },
    {
      "n": 2,
      "text": "炒锅下植物油，把五花肉块中火煎至四面微黄出油。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煎出油脂后炖菜更香，也不腻。",
      "visual_cue": "肉块边缘焦黄，锅底有油"
    },
    {
      "n": 3,
      "text": "下洋葱丁与香肠片，中火炒到洋葱变软、香肠出油卷边。",
      "time_min": 8,
      "heat": "中火",
      "tip": "香肠先煎一下，香味会渗进整锅炖菜。",
      "visual_cue": "洋葱透明，香肠边缘上色"
    },
    {
      "n": 4,
      "text": "把酸菜、香菇条与月桂叶倒入厚底砂锅，加入炒好的肉料与白葡萄酒。",
      "time_min": 10,
      "heat": "中火",
      "tip": "白葡萄酒趁锅热淋入，酒气挥发后只留果香。",
      "visual_cue": "砂锅内食材齐平，热气上升"
    },
    {
      "n": 5,
      "text": "加番茄酱、盐与黑胡椒拌匀，加盖小火炖四十五分钟。",
      "time_min": 45,
      "heat": "小火",
      "tip": "中途翻两次，酸菜容易沉底糊锅。",
      "visual_cue": "酸菜变软发暗，汤汁浓稠"
    },
    {
      "n": 6,
      "text": "揭盖转中火再炖二十五分钟，收去多余水分让风味融合。",
      "time_min": 25,
      "heat": "中火",
      "tip": "开盖收汁能让酸味变得圆润不尖锐。",
      "visual_cue": "汤汁几乎收干，油光透亮"
    },
    {
      "n": 7,
      "text": "关火静置五分钟，挑出月桂叶后盛入碗中，配酸黄瓜同食。",
      "time_min": 5,
      "heat": "无火",
      "tip": "越放越入味，第二天回锅风味更融合。",
      "visual_cue": "表面泛油光，酸香扑鼻"
    }
  ],
  "tips": [
    "酸菜偏酸时先用清水冲一遍再挤干。",
    "用砂锅小火慢炖，比大火快炖更醇厚。",
    "隔夜回锅两三次越炖越香，是波兰人的传统做法。"
  ],
  "common_mistakes": [
    "酸菜不挤干直接下锅，成品汤水太多像汤菜。",
    "火候猛收汁，锅底酸菜焦糊带苦味。",
    "香肠和肉一起久炖，香肠散成碎末没有口感。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "牛腩",
      "ratio": "400 克:400 克",
      "note": "炖制时间延长二十分钟。"
    },
    {
      "original": "白葡萄酒",
      "substitute": "苹果汁",
      "ratio": "150 毫升:120 毫升",
      "note": "酸度降低，甜味更明显。"
    }
  ],
  "variations": [
    "加五十克去核李子干，酸中带果甜更接近老派做法。",
    "把普通香肠换成烟熏香肠，成品的烟熏香气会更重一些。"
  ],
  "serving_suggestion": "盛在粗陶碗中，配黑麦面包和一杯冰啤酒。",
  "storage": "冷藏四天、冷冻两个月；回锅复热每次都会更入味。",
