  "equipment": [
    "大碗",
    "平底锅",
    "打蛋器",
    "锅铲",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温牛奶加酵母和白糖，静置十分钟到表面起沫。",
      "time_min": 12,
      "heat": "无火",
      "tip": "酵母起沫说明活性好，饼才发得起来。",
      "visual_cue": "液面浮沫，甜香微出，状态稳定"
    },
    {
      "n": 2,
      "text": "面粉过筛加盐，倒入酵母牛奶搅成顺滑面糊。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅到无干粉就好，过度搅拌会起筋。，注意火候。",
      "visual_cue": "面糊顺滑，能流动，状态稳定"
    },
    {
      "n": 3,
      "text": "盖布放温暖处发酵一小时，面糊会膨胀起泡。这一步不要着急。",
      "time_min": 62,
      "heat": "无火",
      "tip": "发到表面布满气泡，煎出来才松软。，注意火候。",
      "visual_cue": "体积膨胀，气泡密布，状态稳定"
    },
    {
      "n": 4,
      "text": "蛋黄与融化黄油拌匀，拌进发酵好的面糊。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "轻轻拌，别把气泡全搅掉。，注意火候。",
      "visual_cue": "面糊细腻，颜色微黄，状态稳定"
    },
    {
      "n": 5,
      "text": "蛋白打到软性发泡，分两次翻拌进面糊。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "翻拌而不是搅，气泡才留得住。，注意火候。",
      "visual_cue": "面糊蓬松，体积略增，状态稳定"
    },
    {
      "n": 6,
      "text": "平底锅刷一层植物油烧热，舀一勺面糊摊成小圆饼。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "锅别太热，薄饼才上色均匀。，注意火候。",
      "visual_cue": "面糊摊开，边缘定型，状态稳定"
    },
    {
      "n": 7,
      "text": "煎两分钟到表面起泡，翻面再煎一分钟。这一步不要着急。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "表面起泡再翻，饼才不裂。，注意火候。",
      "visual_cue": "两面金黄，饼身松软，状态稳定"
    },
    {
      "n": 8,
      "text": "叠放在盘中保温，配一勺酸奶油一起吃。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盖上布保温，饼才不会变干。，注意火候。",
      "visual_cue": "饼身柔软，香气奶香，状态稳定"
    }
  ],
  "tips": [
    "酵母先起沫再用，饼才发得起来。，值得留意。",
    "蛋白最后翻拌，气泡留住才松软。，值得留意。",
    "锅别太热，薄饼上色才均匀。，值得留意。"
  ],
  "common_mistakes": [
    "面糊没发就煎，饼又硬又扁。，值得留意。",
    "蛋白搅过头，面糊消泡变稀。，值得留意。",
    "火太大，饼外焦里生。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "酸奶",
      "ratio": "100 克:100 克",
      "note": "更清爽，可加少许盐。"
    },
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "350 毫升:350 毫升",
      "note": "带椰香，糖可减五克。"
    }
  ],
  "variations": [
    "面糊里加一勺荞麦粉，风味更俄式。，值得留意。",
    "配鱼子酱和洋葱碎，做成节庆前菜。，值得留意。"
  ],
  "serving_suggestion": "配酸奶油、果酱或烟熏鱼，早餐或前菜都合适。",
  "storage": "冷藏两天，复热用平底锅小火两面各烘二十秒。",
