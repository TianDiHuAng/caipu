  ],
  "equipment": [
    "烤箱",
    "打蛋器",
    "大碗",
    "擀面杖",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蜂蜜和白糖放进小锅小火加热到糖完全化开，离火放温。",
      "time_min": 8,
      "heat": "小火",
      "tip": "加热到糖完全化开就好，别烧到焦黑。",
      "visual_cue": "糖液顺滑，颜色呈琥珀"
    },
    {
      "n": 2,
      "text": "糖液里加入鸡蛋、融化的黄油、肉桂和盐搅匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糖液要放温再加鸡蛋，否则烫成蛋花。",
      "visual_cue": "液体顺滑，没有颗粒"
    },
    {
      "n": 3,
      "text": "面粉和泡打粉混合过筛，分两次拌进液体里揉成面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团偏软就好，揉过头会出筋变硬。",
      "visual_cue": "面团光滑，不粘住手指"
    },
    {
      "n": 4,
      "text": "面团盖上保鲜膜冷藏三十分钟，让它稍微变硬好擀。",
      "time_min": 32,
      "heat": "无火",
      "tip": "冷藏后擀起来不粘，饼皮才薄得均匀。",
      "visual_cue": "面团不粘手，按下去回弹"
    },
    {
      "n": 5,
      "text": "面团分成八份，每份在烘焙纸上擀成两毫米厚的圆片。",
      "time_min": 18,
      "heat": "无火",
      "tip": "直接擀在纸上，转移的时候才不会破。",
      "visual_cue": "圆片薄而完整，边缘圆整"
    },
    {
      "n": 6,
      "text": "烤箱一百八十度预热，逐片烤六分钟到边缘微黄。",
      "time_min": 30,
      "heat": "无火",
      "tip": "边缘上色就取出，烤久了会发苦。",
      "visual_cue": "饼皮金黄，边缘略深"
    },
    {
      "n": 7,
      "text": "酸奶油和奶油一起打发，打到能挂住打蛋器。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打到有纹路就停，打过头会油水分离。",
      "visual_cue": "奶油浓稠，留有纹路"
    },
    {
      "n": 8,
      "text": "一层饼皮抹一层奶油叠起来，最上面盖一张饼皮。",
      "time_min": 10,
      "heat": "无火",
      "tip": "每层奶油抹匀，叠起来才不会歪。",
      "visual_cue": "叠层平整，高度一致"
    },
    {
      "n": 9,
      "text": "整只蛋糕冷藏六小时以上，让饼皮吸软后再切块。",
      "time_min": 360,
      "heat": "无火",
      "tip": "必须冷藏够久，饼皮软化后口感才融合。",
      "visual_cue": "切面层次分明，饼皮柔软"
    }
  ],
  "tips": [
    "面团冷藏三十分钟再擀，饼皮才薄得均匀。",
    "饼皮烤到边缘上色就取出，烤久会发苦。",
    "冷藏六小时以上，饼皮吸软后才是最好吃的状态。"
  ],
  "common_mistakes": [
    "糖液没放温就打鸡蛋，直接烫成蛋花。",
    "饼皮擀得太厚，冷藏后仍然硬得嚼不动。",
    "奶油打过头油水分离，抹层变得粗糙。"
  ],
  "substitutions": [
    {
      "original": "酸奶油",
      "substitute": "酸奶",
      "ratio": "600 克:600 克",
      "note": "需沥去乳清，酸味更明显。"
    },
    {
      "original": "蜂蜜",
      "substitute": "糖浆",
      "ratio": "120 克:130 克",
      "note": "香气较淡，颜色更浅。"
    }
  ],
  "variations": [
    "夹层里加一层碾碎的核桃，口感更丰富。",
    "表面撒一层可可粉，苦甜更均衡。"
  ],
  "serving_suggestion": "切厚块配无糖红茶，是东欧家庭过节时的必备甜点。",
  "storage": "冷藏三天，冷冻一个月；冷藏保存能让饼皮持续软化，风味更佳。",
