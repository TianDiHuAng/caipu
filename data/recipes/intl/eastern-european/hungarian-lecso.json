  "equipment": [
    "平底锅",
    "木勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "甜椒去蒂去籽，切成两厘米宽的粗条，皮厚的一面朝下先放。",
      "time_min": 10,
      "heat": "无火",
      "tip": "甜椒切粗一点，炖完还有口感，不会烂成泥。",
      "visual_cue": "条状匀整，籽已去净"
    },
    {
      "n": 2,
      "text": "番茄划十字，用开水烫两分钟撕去外皮，切成大块备用。",
      "time_min": 8,
      "heat": "大火",
      "tip": "去皮后汤更顺滑，皮卷在汤里影响口感。",
      "visual_cue": "外皮卷起，果肉完整"
    },
    {
      "n": 3,
      "text": "平底锅放植物油，小火下洋葱丁炒五分钟到透明发甜。",
      "time_min": 7,
      "heat": "小火",
      "tip": "小火慢炒，洋葱的甜味才出得来。",
      "visual_cue": "洋葱透明，锅底泛光"
    },
    {
      "n": 4,
      "text": "锅离火撒入甜椒粉拌三十秒，让红粉在余温里散开不焦。",
      "time_min": 2,
      "heat": "无火",
      "tip": "甜椒粉一遇高温就苦，离火拌最稳。",
      "visual_cue": "洋葱裹红，香气冲鼻"
    },
    {
      "n": 5,
      "text": "放回火上，下甜椒条翻炒四分钟，炒到边缘变软。",
      "time_min": 6,
      "heat": "中火",
      "tip": "甜椒先炒出水分，炖的时候汤才够味。",
      "visual_cue": "椒条变软，颜色更艳"
    },
    {
      "n": 6,
      "text": "加番茄块、盐、白糖和黑胡椒，中小火炖十五分钟。",
      "time_min": 17,
      "heat": "小火",
      "tip": "炖到番茄化开、汤汁浓稠，甜椒也吸饱了汁。",
      "visual_cue": "汤汁浓稠，椒条软亮"
    },
    {
      "n": 7,
      "text": "想加鸡蛋就在中间挖个窝打进去，盖盖小火焖四分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "鸡蛋要焖到蛋白凝固、蛋黄还软，才算到位。",
      "visual_cue": "蛋白雪白，蛋黄微晃"
    },
    {
      "n": 8,
      "text": "关火撒切碎的大蒜和欧芹碎，静置两分钟再盛盘。",
      "time_min": 4,
      "heat": "无火",
      "tip": "大蒜关火后放，辛香更明显也不发苦。",
      "visual_cue": "表面点缀绿，颜色红亮"
    }
  ],
  "tips": [
    "甜椒炖菜是匈牙利夏天的家常菜，配面包或香肠都好。",
    "甜椒和番茄比例大约一比一，甜酸才平衡。",
    "加鸡蛋就是主食版，不加就是配菜，两种都常见。"
  ],
  "common_mistakes": [
    "甜椒粉在滚油里炒，瞬间发黑，整锅带焦苦味。",
    "番茄炖太久化成水，甜椒泡在汤里失去口感。",
    "鸡蛋焖过头，蛋黄全熟发干，没有流心的层次。"
  ],
  "substitutions": [
    {
      "original": "甜椒",
      "substitute": "青椒",
      "ratio": "500克:500克",
      "note": "青椒版偏清爽带一点苦，白糖可多加两克。"
    },
    {
      "original": "鸡蛋",
      "substitute": "培根",
      "ratio": "200克:150克",
      "note": "培根先煎出油再炒洋葱，咸香更足，盐要少放。"
    }
  ],
  "variations": [
    "加一根切片香肠同炖，油香渗进蔬菜，是最常见的家常版。",
    "炖好后拌进煮好的米饭，做成烩饭式的吃法也很受欢迎。"
  ],
  "serving_suggestion": "连锅端上桌，配一块乡村面包或一碗米饭，热吃最香。",
  "storage": "冷藏可存两天，复热用平底锅小火加热，别加水稀释。",
