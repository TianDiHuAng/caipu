  "steps": [
    {
      "n": 1,
      "text": "牛奶温热，加白糖和一半鸡蛋搅匀。，起锅前尝味，口感才有层次。",
      "time_min": 5,
      "heat": "无火",
      "tip": "温而不烫，酵母才活。，手法轻些，口感才不散。",
      "visual_cue": "液体微温，糖已化开，汤汁别收太干，成品才稳当。"
    },
    {
      "n": 2,
      "text": "倒面粉和盐，揉成光滑面团。，起锅前尝味，成品才好看。",
      "time_min": 10,
      "heat": "无火",
      "tip": "揉到不粘手，膜才起。，动作放连贯，口感才有层次。",
      "visual_cue": "面团光滑，按压回弹，别急着加油，成品才稳当。"
    },
    {
      "n": 3,
      "text": "加软化黄油再揉五分钟，盖布发酵。，先试试温度，成品才稳当。",
      "time_min": 65,
      "heat": "无火",
      "tip": "黄油后加，面团才柔软。，慢慢来别急，锅气才足。",
      "visual_cue": "面团膨大，指压回慢，份量心里有数，香气才不跑。"
    },
    {
      "n": 4,
      "text": "洋葱剁碎，用植物油小火炒软。，注意别烧干，成品才好看。",
      "time_min": 6,
      "heat": "小火",
      "tip": "炒软出甜，馅才不冲。，先试试温度，火候才均匀。",
      "visual_cue": "洋葱透明，香气升起，保持小火，形状才完整。"
    },
    {
      "n": 5,
      "text": "下猪肉末炒散，加盐和黑胡椒调味。，注意别烧干，风味才干净。",
      "time_min": 8,
      "heat": "中火",
      "tip": "炒到无粉色，馅才安全。，顺序照着来，口感才有层次。",
      "visual_cue": "肉末散开，颜色转褐，火别太大，形状才完整。"
    },
    {
      "n": 6,
      "text": "面团分成十份，擀成椭圆片。，慢慢来别急，口感才不散。",
      "time_min": 10,
      "heat": "无火",
      "tip": "中间厚些，包馅才不破。，顺序照着来，锅气才足。",
      "visual_cue": "片形椭圆，边缘略薄，起锅前尝味，香气才不跑。"
    },
    {
      "n": 7,
      "text": "放一勺馅，对折捏紧边缘成月牙形。，份量心里有数，火候才均匀。",
      "time_min": 12,
      "heat": "无火",
      "tip": "接口捏牢，烤时才不张嘴。，慢慢来别急，吃口才舒服。",
      "visual_cue": "边缘压花，形状饱满，锅温要匀，咸淡才好把握。"
    },
    {
      "n": 8,
      "text": "刷蛋液，烤盘两百度烤十八分钟。，翻动放轻，口感才不散。",
      "time_min": 20,
      "heat": "无火",
      "tip": "刷蛋液，表面才亮。，份量心里有数，吃口才舒服。",
      "visual_cue": "表皮金黄，体积鼓起，起锅前尝味，颜色才够亮。"
    }
  ],
  "tips": [
    "面团发酵到两倍大，成品才松。，别用力搅，口感才不散。",
    "馅要炒到无粉色，包着才安全。，锅温要匀，整道菜才立得住。",
    "接口一定要捏牢，否则烤时漏馅。，锅温要匀，形状才完整。"
  ],
  "common_mistakes": [
    "面团没发酵，烤出来发硬。，别急着加油，整道菜才立得住。",
    "馅太湿，烤时浸破面皮。，慢慢来别急，咸淡才好把握。",
    "接口没捏紧，烤时咧嘴。，别急着加油，表面才漂亮。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡腿肉",
      "ratio": "400 克:400 克",
      "note": "剁碎替代，炒制时间减两分钟。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "60 克:55 毫升",
      "note": "口感略硬，牛奶加十毫升。"
    }
  ],
  "variations": [
    "馅里加煮蛋碎，口感更丰富。，时间掐准，味道才进得去。",
    "加一点莳萝，香气更清。，起锅前尝味，表面才漂亮。"
  ],
  "serving_suggestion": "趁热配汤或酸奶油。，下手别慌，整道菜才立得住。",
  "storage": "冷藏两天，复热用烤箱。，别急着加油，味道才进得去。",
