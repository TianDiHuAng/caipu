  "steps": [
    {
      "n": 1,
      "text": "整棵卷心菜去芯，整棵放进沸水煮八分钟到叶变软。",
      "time_min": 12,
      "heat": "中火",
      "tip": "煮到叶片能弯不裂，包的时候才不破。",
      "visual_cue": "叶片柔软，能弯不断，状态稳定"
    },
    {
      "n": 2,
      "text": "捞出晾凉，逐片剥下叶子，削平根部硬梗。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "硬梗削平，卷起来才服帖。，注意火候。",
      "visual_cue": "叶片完整，梗已削薄，状态稳定"
    },
    {
      "n": 3,
      "text": "牛里脊剁成细腻馅料，洋葱切碎，大米煮到半熟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "馅料剁细一点，口感才细腻。，注意火候。",
      "visual_cue": "细馅黏稠，颗粒细小，状态稳定"
    },
    {
      "n": 4,
      "text": "馅料加洋葱、半熟米饭、植物油、盐和黑胡椒拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌到发黏上劲，煮的时候才不散。，注意火候。",
      "visual_cue": "馅料黏稠，能抱团，状态稳定"
    },
    {
      "n": 5,
      "text": "每片叶子放一勺馅，先折两侧再卷紧，用牙签固定。",
      "time_min": 12,
      "heat": "无火",
      "tip": "卷紧一点，煮的时候馅才不会跑。，注意火候。",
      "visual_cue": "卷形紧实，封口朝下，状态稳定"
    },
    {
      "n": 6,
      "text": "锅底铺剩余菜叶，摆入菜卷，加番茄丁和胡萝卜丝。",
      "time_min": 6,
      "heat": "无火",
      "tip": "底部垫叶，防止菜卷粘锅糊底。，注意火候。",
      "visual_cue": "菜卷排列整齐，状态稳定"
    },
    {
      "n": 7,
      "text": "番茄酱兑水调匀倒入，加月桂叶，小火炖三十五分钟。",
      "time_min": 37,
      "heat": "小火",
      "tip": "汤汁没过一半就够，小火慢炖才入味。",
      "visual_cue": "汤汁微沸，菜卷变软，状态稳定"
    },
    {
      "n": 8,
      "text": "盛出配一勺酸奶油，浇上炖汁。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶油最后加，酸香配肉最解腻。，注意火候。",
      "visual_cue": "菜卷饱满，汁色红亮，状态稳定"
    }
  ],
  "tips": [
    "菜叶煮到能弯不裂，包的时候才不破。，值得留意。",
    "馅料拌到发黏上劲，炖时才不散。，值得留意。",
    "锅底垫菜叶，防止菜卷粘锅。，值得留意。"
  ],
  "common_mistakes": [
    "菜叶煮太烂，一卷就破。，值得留意。",
    "馅太湿，炖完菜卷全散开。，值得留意。",
    "火太大，汤汁收干糊底。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "鸡腿肉",
      "ratio": "350 克:350 克",
      "note": "口感更嫩，炖制时间减十分钟。"
    },
    {
      "original": "卷心菜",
      "substitute": "白菜",
      "ratio": "700 克:700 克",
      "note": "叶更脆，煮制时间减三分钟。"
    }
  ],
  "variations": [
    "用酸菜叶代替卷心菜，酸味更东欧。，值得留意。",
    "入烤箱两百度烤二十分钟，表面更香。，值得留意。"
  ],
  "serving_suggestion": "配酸奶油和黑面包，汤汁浇在米饭上也很好。",
  "storage": "冷藏三天，复热加少量水小火炖十分钟。，效果更稳定。",
