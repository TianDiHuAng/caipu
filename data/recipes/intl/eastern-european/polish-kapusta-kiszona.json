          "name_en": "bay leaf",
          "amount": 2,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 3,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大盆",
    "玻璃罐",
    "重物",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "卷心菜剥掉外层老叶，对半切开挖去硬芯，切成两毫米细丝。",
      "time_min": 18,
      "heat": "无火",
      "tip": "切得越细，出水和发酵越均匀，成品越脆。",
      "visual_cue": "细丝匀整，菜梗不留大块"
    },
    {
      "n": 2,
      "text": "菜丝放大盆，撒盐用手抓揉十分钟，揉到出水变软。",
      "time_min": 12,
      "heat": "无火",
      "tip": "抓揉要用力，把细胞壁揉破才会自己出卤水。",
      "visual_cue": "菜丝软塌，盆底见水"
    },
    {
      "n": 3,
      "text": "加胡萝卜丝、洋葱丝、香菜籽、香叶和黑胡椒拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香料不用多，一点点就够撑起发酵的底味。",
      "visual_cue": "菜丝均匀，香料散布"
    },
    {
      "n": 4,
      "text": "把菜丝分批塞进干净玻璃罐，每层用拳压实，压到卤水没过菜面。",
      "time_min": 12,
      "heat": "无火",
      "tip": "一定要压实，露出液面的部分容易发霉。",
      "visual_cue": "菜面平整，卤水漫过"
    },
    {
      "n": 5,
      "text": "罐口盖一层保鲜膜，压上重物，放在十八到二十二度避光处。",
      "time_min": 5,
      "heat": "无火",
      "tip": "温度过高会发黏，过低则不发酵，十八度最稳。",
      "visual_cue": "菜面被压住，无气泡"
    },
    {
      "n": 6,
      "text": "每天开盖放气一次，用干净筷子把上浮的菜压回卤水下面。",
      "time_min": 8,
      "heat": "无火",
      "tip": "前三天产气最猛，不放气会溢罐。",
      "visual_cue": "气泡冒出，酸味渐浓"
    },
    {
      "n": 7,
      "text": "发酵七到十天，尝到清爽的酸味、菜丝变半透明即可。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酸度到自己喜欢的程度就转冷藏，继续放着会过酸。",
      "visual_cue": "菜丝透亮，酸香扑鼻"
    }
  ],
  "tips": [
    "腌酸白菜是东欧过冬的储备，一缸能吃整个冬天。",
    "全程不能沾油，筷子手都要干净，一沾油就易生霉。",
    "卤水浑浊但无异味是正常的，表层发霉才要处理。"
  ],
  "common_mistakes": [
    "盐放太少，菜丝不脱水，罐里干着发不起来还长霉。",
    "菜没压实，露出液面的一半发黑发臭。",
    "用金属罐腌制，酸水腐蚀金属，成品带铁锈味。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "大白菜",
      "ratio": "1500克:1500克",
      "note": "大白菜版更嫩，盐量减到二十五克，发酵时间缩短两天。"
    },
    {
      "original": "香菜籽",
      "substitute": "杜松子",
      "ratio": "3克:3克",
      "note": "杜松子香气更冷冽，压碎后用量减半即可。"
    }
  ],
  "variations": [
    "加一个苹果切块同腌，酸味更柔和，还带果香。",
    "拌入少量辣椒段，做出带辣的版本，配烤肉特别对味。"
  ],
  "serving_suggestion": "捞出挤干卤水，切短一点装碟，配烤香肠、炖肉或饺子吃。",
  "storage": "连卤水装罐冷藏可存半年，取用时用干净无油的筷子夹取。",
