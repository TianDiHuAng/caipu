          "amount": 300,
          "unit": "g",
          "note": "原味奶渣",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 100,
          "unit": "g",
          "note": "约两枚",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 60,
          "unit": "g",
          "note": "另备裹面",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 20,
          "unit": "g",
          "note": "起锅增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "盆",
    "刀",
    "铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶酪倒进盆里压散成细粒，如果太湿先用纱布挤掉多余水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "奶渣要干一点，湿了加多少面粉都粘手。",
      "visual_cue": "奶渣松散且不成团"
    },
    {
      "n": 2,
      "text": "加鸡蛋和白糖搅匀，再分次筛入面粉，拌成能成团的软糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面粉分次加，糊能成团就停，多了发硬。",
      "visual_cue": "面糊能捏成形不粘盆"
    },
    {
      "n": 3,
      "text": "手上抹点植物油，把面糊揪成五十克一个的圆饼，两面拍薄层干面粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "饼别压太薄，两厘米厚煎完才外脆内软。",
      "visual_cue": "圆饼厚薄一致不塌"
    },
    {
      "n": 4,
      "text": "平底锅放植物油中火烧热，饼坯摆进去，中间留出空隙。",
      "time_min": 2,
      "heat": "中火",
      "tip": "饼要留间距，挤在一起会粘成一大块。",
      "visual_cue": "饼坯下锅边缘冒小泡"
    },
    {
      "n": 5,
      "text": "中小火煎四分钟到底面金黄，翻面再煎三分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "翻面只翻一次，翻多了饼会散开。",
      "visual_cue": "两面金黄，饼身微微鼓起"
    },
    {
      "n": 6,
      "text": "起锅前加一小块黄油晃匀，让饼表面裹一层奶香，趁热装盘。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油最后加，早放高温会烧焦发苦。",
      "visual_cue": "表面油亮，奶香明显"
    }
  ],
  "tips": [
    "奶渣一定要挤干水，否则面糊散不成形。",
    "面粉分次加入，糊能成团就立刻停手。",
    "煎的时候保持中小火，火大外焦内凉。"
  ],
  "common_mistakes": [
    "奶渣太湿，加了很多面粉，成品硬得像石头。",
    "饼压得太薄，煎完干瘪没有软心。",
    "火太大，表面焦黑里面还是凉糊。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "希腊酸奶滤干",
      "ratio": "300 克:400 克",
      "note": "需提前一晚吊干，酸味更明显。"
    },
    {
      "original": "面粉",
      "substitute": "玉米淀粉",
      "ratio": "60 克:50 克",
      "note": "更嫩，但不易成形，要现煎。"
    }
  ],
  "variations": [
    "配一勺酸奶油和果酱，冷热对比更好吃。",
    "面糊里加少许柠檬皮屑，香气更清爽。"
  ],
  "serving_suggestion": "装盘后淋一勺酸奶油或蜂蜜，撒几颗新鲜浆果，趁热当早餐或下午甜点。",
  "storage": "冷藏一天，复热用平底锅干煎两分钟，微波会变软塌。",
