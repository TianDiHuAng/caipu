    "小锅",
    "牙签",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄用清水洗净，蒂头摘掉，每个用牙签在表皮扎两三个小孔。",
      "time_min": 15,
      "heat": "无火",
      "tip": "扎孔能让盐水渗进去，皮也不容易在发酵时胀裂。",
      "visual_cue": "表皮有小孔，果实完整"
    },
    {
      "n": 2,
      "text": "玻璃罐用开水烫过晾干，罐底铺一层莳萝茎、蒜片和洋葱圈。",
      "time_min": 8,
      "heat": "无火",
      "tip": "罐子必须无油无水，否则几天就长霉。",
      "visual_cue": "罐内干燥，铺料平整"
    },
    {
      "n": 3,
      "text": "番茄一个个码进罐里，中间塞入剩余蒜片、洋葱、香叶和干辣椒。",
      "time_min": 10,
      "heat": "无火",
      "tip": "码紧一点，番茄浮起来接触空气就容易坏。",
      "visual_cue": "果实紧密，空隙填满"
    },
    {
      "n": 4,
      "text": "小锅烧一升水，加盐、白糖、白醋、黑胡椒和香菜籽煮开两分钟。",
      "time_min": 8,
      "heat": "大火",
      "tip": "卤水要完全放凉再倒，热汤会把番茄烫软。",
      "visual_cue": "卤水清澈，香料飘香"
    },
    {
      "n": 5,
      "text": "卤水放凉到室温后倒进罐里，务必完全没过番茄表面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "露出的番茄会发白长霉，一定压到液面下。",
      "visual_cue": "液面高出果实两指"
    },
    {
      "n": 6,
      "text": "罐口盖紧，放在室温避光处发酵五天，每天开盖放一次气。",
      "time_min": 10,
      "heat": "无火",
      "tip": "室温二十度左右最合适，夏天两天就够。",
      "visual_cue": "罐内起小泡，酸味渐出"
    },
    {
      "n": 7,
      "text": "番茄皮起皱、酸味清爽时移入冰箱，冷藏两天后风味更融合。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷藏会停止发酵，酸度就锁在这个程度。",
      "visual_cue": "果皮微皱，卤水略浑"
    }
  ],
  "tips": [
    "腌番茄是俄罗斯人冬天配伏特加和烤肉的小菜。",
    "番茄选偏硬的品种，软的一腌就烂成糊。",
    "卤水咸度要够，尝起来明显偏咸才对，淡了容易坏。"
  ],
  "common_mistakes": [
    "番茄没扎孔，盐味进不去，只有表面咸里面还是生的。",
    "卤水太淡，三天后表面起一层白膜，整罐只能倒掉。",
    "用熟透的大番茄，腌完软烂出水，完全失去口感。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "青番茄",
      "ratio": "1200克:1200克",
      "note": "青番茄更脆更酸，是传统做法，发酵时间要多两天。"
    },
    {
      "original": "白醋",
      "substitute": "苹果醋",
      "ratio": "30毫升:30毫升",
      "note": "苹果醋带果香，酸味更柔，用量相同即可。"
    }
  ],
  "variations": [
    "加一小把辣根片同腌，辛香更冲，配烤肉非常合适。",
    "换成小黄瓜同法腌制，就是最常见的俄式酸黄瓜。"
  ],
  "serving_suggestion": "捞出切块，淋一点卤水和植物油，配烤肉、土豆泥或黑麦面包。",
  "storage": "连卤水冷藏可存三个月，取用须用干净无油的筷子。",
