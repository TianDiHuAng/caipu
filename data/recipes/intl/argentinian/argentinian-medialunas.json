  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 500,
          "unit": "g",
          "note": "高筋面粉",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 160,
          "unit": "g",
          "note": "分两次用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 220,
          "unit": "ml",
          "note": "温牛奶",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 7,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 90,
          "unit": "g",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "一个入面团",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 40,
          "unit": "g",
          "note": "刷面糖浆",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "糖粉",
          "name_en": "powdered sugar",
          "amount": 20,
          "unit": "g",
          "note": "装饰",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "擀面杖",
    "刷子",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温牛奶加一勺白糖与酵母静置五分钟，表面起泡说明活化。",
      "time_min": 5,
      "heat": "无火",
      "tip": "牛奶别太烫，超过四十度会杀死酵母。",
      "visual_cue": "表面浮起一层细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉加剩余白糖与盐拌匀，倒入酵母牛奶与一个鸡蛋。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐别直接碰酵母，会影响发酵。",
      "visual_cue": "面团粗糙，无干粉"
    },
    {
      "n": 3,
      "text": "揉面十分钟到表面光滑能拉出薄膜，盖布发酵一小时。",
      "time_min": 70,
      "heat": "无火",
      "tip": "揉到出膜，层次才细密。",
      "visual_cue": "面团光滑，体积明显变大"
    },
    {
      "n": 4,
      "text": "面团排气后擀成半厘米厚的长方形面片，冷藏二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏让黄油不易融化，好操作。",
      "visual_cue": "面片平整，触感偏凉"
    },
    {
      "n": 5,
      "text": "软化黄油拌入两勺面粉抹在面片上，留出一边不抹。",
      "time_min": 6,
      "heat": "无火",
      "tip": "留边便于封口，卷的时候不溢油。",
      "visual_cue": "黄油层均匀，边缘干净"
    },
    {
      "n": 6,
      "text": "面片三折后擀开，再重复一次三折，冷藏二十分钟。",
      "time_min": 25,
      "heat": "无火",
      "tip": "两次三折就够，折多了黄油会破。",
      "visual_cue": "面片层次可见，厚度均匀"
    },
    {
      "n": 7,
      "text": "擀成四毫米厚，切成底边十厘米的等腰三角形。",
      "time_min": 8,
      "heat": "无火",
      "tip": "三角形切得均匀，成品大小才一致。",
      "visual_cue": "三角形整齐，底边宽一致"
    },
    {
      "n": 8,
      "text": "从底边卷起成牛角形，卷得紧一些但别拉扯面皮。",
      "time_min": 10,
      "heat": "无火",
      "tip": "卷太松烤的时候会散开。",
      "visual_cue": "牛角形状饱满，边缘贴合"
    },
    {
      "n": 9,
      "text": "排进烤盘刷蛋液，盖布二次发酵四十分钟到体积膨大。",
      "time_min": 40,
      "heat": "无火",
      "tip": "二发到位，烤出来才松软。",
      "visual_cue": "体积近两倍，轻按慢回弹"
    },
    {
      "n": 10,
      "text": "烤箱一百八十度烤二十分钟，烤到表面金黄上色。",
      "time_min": 20,
      "heat": "中火",
      "tip": "中途转向一次，上色更均匀。",
      "visual_cue": "表面金黄，层次分明"
    },
    {
      "n": 11,
      "text": "蜂蜜加一勺热水调成糖浆，趁热刷在牛角包表面。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热刷，糖浆才挂得住有光泽。",
      "visual_cue": "表面油亮，糖浆薄薄一层"
    },
    {
      "n": 12,
      "text": "稍凉后筛上一层糖粉，温热时食用口感最好。",
      "time_min": 3,
      "heat": "无火",
      "tip": "太凉糖浆会硬，口感变差。",
      "visual_cue": "表面泛光，撒粉均匀"
    }
  ],
  "tips": [
    "牛奶温度控制在四十度以内，酵母才活跃。",
    "两次三折就足够，折太多黄油会破层。",
    "趁热刷蜂蜜糖浆，表面才油亮诱人。"
  ],
  "common_mistakes": [
    "牛奶太烫，酵母被烫死，面团发不起来。",
    "黄油抹得太软，擀的时候全挤出来。",
    "二发时间不够，烤出来又硬又小。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "160 克:120 毫升",
      "note": "层次会变差，口感偏扎实。"
    },
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "40 克:50 克",
      "note": "需加二十毫升水煮成糖浆。"
    }
  ],
  "variations": [
    "面团里加一勺香草精，香气更甜。",
    "出炉后撒少许橙皮屑，清爽解腻。"
  ],
  "serving_suggestion": "温热时配咖啡或马黛茶，当作早餐。",
  "storage": "室温密封两天，冷冻一个月，复热后刷糖浆。",
