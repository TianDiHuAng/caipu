  "equipment": [
    "小碗",
    "打蛋器",
    "刀",
    "砧板",
    "量勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛋黄酱倒进小碗，用打蛋器搅到顺滑无结块。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先搅顺再加料，酱体才细腻。，注意火候。",
      "visual_cue": "质地顺滑，颜色乳白，状态稳定"
    },
    {
      "n": 2,
      "text": "分两次加入番茄酱，每次都搅到完全融合。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "分次加，颜色才均匀不结成纹路。，注意火候。",
      "visual_cue": "颜色橘粉，色调均匀，状态稳定"
    },
    {
      "n": 3,
      "text": "挤入柠檬汁搅匀，酱体会稍微变稀。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "柠檬汁能解腻，也让颜色更亮。，注意火候。",
      "visual_cue": "酱体流动，酸香微出，状态稳定"
    },
    {
      "n": 4,
      "text": "加蒜泥、辣椒粉、盐和黑胡椒，搅到调味均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜压成泥，味道才融得进去。，注意火候。",
      "visual_cue": "蒜香明显，色泽粉亮，状态稳定"
    },
    {
      "n": 5,
      "text": "静置五分钟让味道融合，撒欧芹碎点缀。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置一下，酸和甜才抱在一起。，注意火候。",
      "visual_cue": "酱体浓稠，香气复合，状态稳定"
    }
  ],
  "tips": [
    "番茄酱分两次加，颜色才均匀。，值得留意。",
    "蒜压成泥而不是切末，味道更融。，值得留意。",
    "静置五分钟，酸甜才融合得自然。，值得留意。"
  ],
  "common_mistakes": [
    "一次倒完番茄酱，酱体出现红白条纹。，值得留意。",
    "柠檬汁挤太多，酱稀得挂不住。，值得留意。",
    "蒜切太粗，吃到一口辛辣。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "番茄酱",
      "substitute": "番茄膏",
      "ratio": "60 克:40 克",
      "note": "味道更浓，需多加少许柠檬汁。"
    },
    {
      "original": "蛋黄酱",
      "substitute": "酸奶",
      "ratio": "200 克:200 克",
      "note": "更清爽，可省去柠檬汁。"
    }
  ],
  "variations": [
    "加一勺辣酱，酸辣更适合配炸物。，值得留意。",
    "拌入少许酸豆碎，酸味更有层次。，值得留意。"
  ],
  "serving_suggestion": "配炸肉排、烤奶酪或薯条，阿根廷餐桌上的万能蘸酱。",
  "storage": "冷藏三天，食用前搅匀。，效果更稳定。",
