    "砧板",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香芹洗净彻底晾干，摘下叶子切成细末，茎部切得再碎一些。",
      "time_min": 8,
      "heat": "无火",
      "tip": "叶子必须晾干，带水会让酱很快变质。",
      "visual_cue": "香芹末细绿且干爽"
    },
    {
      "n": 2,
      "text": "香菜同样晾干切末，和大蒜末一起放进大碗里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "大蒜要切成细末，太大块会辣口抢味。",
      "visual_cue": "蒜末细匀，香气刺鼻"
    },
    {
      "n": 3,
      "text": "碗里加入辣椒粉、盐、黑胡椒和白醋，轻轻拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先把干料拌匀再倒油，味道分布才均匀。",
      "visual_cue": "干料均匀裹在草末上"
    },
    {
      "n": 4,
      "text": "倒入橄榄油没过所有材料，用勺子从底往上翻拌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "油要完全没过料，接触空气容易氧化。",
      "visual_cue": "油面平滑，草末沉底"
    },
    {
      "n": 5,
      "text": "室温静置三十分钟让风味融合，中途再翻拌一次。",
      "time_min": 30,
      "heat": "无火",
      "tip": "至少静置半小时，否则只剩生蒜味。",
      "visual_cue": "酱色深绿，香气浓郁"
    },
    {
      "n": 6,
      "text": "装进干净玻璃罐，油面高出材料一厘米盖好冷藏。",
      "time_min": 3,
      "heat": "无火",
      "tip": "每次用干净勺子取，别把生水带进去。",
      "visual_cue": "罐内草末压实，油封顶"
    }
  ],
  "tips": [
    "香芹和香菜都要彻底晾干，带水会让酱迅速变质。",
    "静置半小时以上，蒜香和草香才会融合。",
    "油必须完全没过材料，风味的保存期才长。"
  ],
  "common_mistakes": [
    "草末带水下油，两天就发酸变味。",
    "大蒜切得太粗，吃起来辣口抢味。",
    "油没没过材料，上层草末氧化发黑。"
  ],
  "substitutions": [
    {
      "original": "白醋",
      "substitute": "柠檬汁",
      "ratio": "10 毫升:15 毫升",
      "note": "酸味更清爽，香气更明亮。"
    },
    {
      "original": "香芹",
      "substitute": "欧芹",
      "ratio": "120 克:120 克",
      "note": "风味接近，叶片更细。"
    }
  ],
  "variations": [
    "加半颗洋葱碎，辛辣感更有层次。",
    "用牛至替换部分香芹，香气温和更像烤肉店版本。"
  ],
  "serving_suggestion": "淋在刚烤好的牛排或香肠上，也可以直接蘸面包吃，是阿根廷烤肉桌上必备的一碗。",
  "storage": "密封冷藏一周，每次用干净勺取；油层变浑浊或发酸即弃用。",
