  "equipment": [
    "汤锅",
    "木勺",
    "碗",
    "刨刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米用清水冲洗两遍，沥干备用。，先试试温度，细节才到位。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洗去表面淀粉，才不糊。，时间掐准，火候才均匀。",
      "visual_cue": "水色变清，米粒干爽，火别太大，锅气才足。"
    },
    {
      "n": 2,
      "text": "汤锅倒牛奶，小火加热到微冒气。，起锅前尝味，锅气才足。",
      "time_min": 5,
      "heat": "小火",
      "tip": "别煮沸，奶才不扑锅。，先试试温度，吃口才舒服。",
      "visual_cue": "锅边起小泡，慢慢来别急，锅气才足。"
    },
    {
      "n": 3,
      "text": "下大米和盐，搅匀后小火慢煮。，注意别烧干，成品才好看。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盐提味，甜才不闷。，时间掐准，食材才不糊。",
      "visual_cue": "米粒散开，液面平稳，翻动放轻，咸淡才好把握。"
    },
    {
      "n": 4,
      "text": "煮三十分钟，每五分钟搅一次。，份量心里有数，形状才完整。",
      "time_min": 32,
      "heat": "小火",
      "tip": "勤搅，锅底才不粘。，起锅前尝味，香气才留得住。",
      "visual_cue": "米粒开花，奶液变稠，顺序照着来，咸淡才好把握。"
    },
    {
      "n": 5,
      "text": "加白糖和柠檬皮屑，搅到糖化开。，下手别慌，香气才不跑。",
      "time_min": 4,
      "heat": "小火",
      "tip": "柠檬皮只取黄皮，白皮发苦。，先试试温度，成品才稳当。",
      "visual_cue": "香气清亮，糖已化开，别用力搅，整道菜才立得住。"
    },
    {
      "n": 6,
      "text": "加黄油搅匀，关火焖五分钟。，下手别慌，锅气才足。",
      "time_min": 7,
      "heat": "小火",
      "tip": "黄油让口感更顺。，顺序照着来，口感才不散。",
      "visual_cue": "糊体发亮，质地细腻，留意锅底，成品才好看。"
    },
    {
      "n": 7,
      "text": "盛入碗中放凉，撒肉桂粉装饰。，时间掐准，口感才不散。",
      "time_min": 6,
      "heat": "无火",
      "tip": "凉了更稠，趁温热吃也香。，份量心里有数，吃口才舒服。",
      "visual_cue": "表面平整，肉桂铺开，翻动放轻，食材才不糊。"
    }
  ],
  "tips": [
    "小火慢煮勤搅，锅底才不糊。，留意锅底，味道才不闷。",
    "柠檬只取黄色表皮，白皮会苦。，盖盖焖一会儿，味道才不闷。",
    "凉了会变稠，出锅时留点稀。，份量心里有数，口感才不散。"
  ],
  "common_mistakes": [
    "火太大，牛奶扑锅。，盖盖焖一会儿，咸淡才好把握。",
    "不搅拌，锅底结焦。，汤汁别收太干，表面才漂亮。",
    "柠檬白皮擦进去，成品发苦。，注意别烧干，吃口才舒服。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "900 毫升:900 毫升",
      "note": "更清爽，白糖可减十克。"
    },
    {
      "original": "大米",
      "substitute": "糯米",
      "ratio": "180 克:180 克",
      "note": "口感更黏，牛奶加一百毫升。"
    }
  ],
  "variations": [
    "加葡萄干，口感更丰富。，锅温要匀，口感才有层次。",
    "淋焦糖奶酱，甜味更浓。，料别一次下太多，风味才干净。"
  ],
  "serving_suggestion": "温热或冷藏后食用。，注意别烧干，咸淡才好把握。",
  "storage": "冷藏两天，复热加牛奶。，保持小火，火候才均匀。",
