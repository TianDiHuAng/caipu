  "steps": [
    {
      "n": 1,
      "text": "白豆提前泡水六小时，牛腩切成三厘米的块。这一步不要着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆子泡透才煮得绵，牛腩块别太小。，注意火候。",
      "visual_cue": "豆子饱满，肉块方正，状态稳定"
    },
    {
      "n": 2,
      "text": "牛腩冷水下锅焯五分钟，撇掉浮沫后捞出冲洗。",
      "time_min": 8,
      "heat": "中火",
      "tip": "冷水下锅血沫才逼得干净。，注意火候。",
      "visual_cue": "浮沫撇净，肉色发白，状态稳定"
    },
    {
      "n": 3,
      "text": "厚底锅倒植物油，下培根丁小火煎到出油微焦。",
      "time_min": 5,
      "heat": "小火",
      "tip": "培根煎出油，整锅的底味就有了。，注意火候。",
      "visual_cue": "培根卷边，油脂清亮，状态稳定"
    },
    {
      "n": 4,
      "text": "加洋葱丁和蒜末炒到透明，再放番茄丁炒出汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄炒软，汤色才红亮。，注意火候。",
      "visual_cue": "洋葱透明，汁水泛红，状态稳定"
    },
    {
      "n": 5,
      "text": "下牛腩块翻炒两分钟，撒辣椒粉和孜然炒匀。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料遇油才出味，别炒到发苦。，注意火候。",
      "visual_cue": "肉块上色，香气浓烈，状态稳定"
    },
    {
      "n": 6,
      "text": "加入白豆、玉米粒和南瓜块，倒清水没过食材。",
      "time_min": 5,
      "heat": "中火",
      "tip": "南瓜后放，煮太久会全化在汤里。，注意火候。",
      "visual_cue": "食材浸没，汤面平整，状态稳定"
    },
    {
      "n": 7,
      "text": "大火烧开转小火炖三十五分钟到牛腩软烂。这一步不要着急。",
      "time_min": 37,
      "heat": "小火",
      "tip": "小火慢炖，肉才酥而不柴。，注意火候。",
      "visual_cue": "汤色浓稠，肉已软烂，状态稳定"
    },
    {
      "n": 8,
      "text": "加盐调味，撒欧芹碎后盛出，直接端上桌蘸汤。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后加，豆子和培根都带咸。，注意火候。",
      "visual_cue": "汤汁浓稠，香气扑鼻，状态稳定"
    }
  ],
  "tips": [
    "白豆泡够六小时，煮起来才绵软。，值得留意。",
    "牛腩冷水下锅焯，血沫才逼得干净。，值得留意。",
    "小火慢炖半小时以上，肉才酥烂。，值得留意。"
  ],
  "common_mistakes": [
    "豆子没泡就炖，煮两小时还是硬的。，值得留意。",
    "南瓜下太早，全化在汤里没形状。，值得留意。",
    "一直大火滚，汤汁糊底还发苦。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "猪五花肉",
      "ratio": "500 克:500 克",
      "note": "油脂更足，炖制时间减十分钟。"
    },
    {
      "original": "白豆",
      "substitute": "鹰嘴豆",
      "ratio": "200 克:200 克",
      "note": "口感更绵，需多炖十分钟。"
    }
  ],
  "variations": [
    "加一勺辣酱，辣味更过瘾。，值得留意。",
    "放几片香肠同炖，烟熏味更足。，值得留意。"
  ],
  "serving_suggestion": "盛在深碗里配硬面包，冬天吃最暖。，效果更稳定。",
  "storage": "冷藏三天，复热加少量水小火煮开。，效果更稳定。",
