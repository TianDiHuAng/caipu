  "steps": [
    {
      "n": 1,
      "text": "牛腩切成两厘米的丁，南瓜、红薯和土豆切成大块。",
      "time_min": 12,
      "heat": "无火",
      "tip": "块切大一点，久炖才不会全化掉。，注意火候。",
      "visual_cue": "块状均匀，大小一致，状态稳定"
    },
    {
      "n": 2,
      "text": "厚底锅倒植物油烧热，下牛腩丁大火煎到表面焦黄。",
      "time_min": 6,
      "heat": "大火",
      "tip": "大火煎出焦色，汤的味道才厚。，注意火候。",
      "visual_cue": "肉丁焦黄，锅底有焦香"
    },
    {
      "n": 3,
      "text": "加洋葱丁和蒜末炒软，再放甜椒丁炒两分钟。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱炒透，甜味才进到汤里。，注意火候。",
      "visual_cue": "洋葱透明，甜椒变软，状态稳定"
    },
    {
      "n": 4,
      "text": "放番茄丁炒出汁，加盐和黑胡椒调味。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒软出汁，汤色才红。，注意火候。",
      "visual_cue": "汁水泛红，番茄化开，状态稳定"
    },
    {
      "n": 5,
      "text": "倒清水没过食材，大火烧开转小火炖二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "先炖肉，后下根茎才不会糊。，注意火候。",
      "visual_cue": "汤面微沸，肉开始变软"
    },
    {
      "n": 6,
      "text": "放入南瓜、红薯和土豆块，再炖十五分钟。这一步不要着急。",
      "time_min": 16,
      "heat": "小火",
      "tip": "根茎类后放，才保住形状不散。，注意火候。",
      "visual_cue": "块状完整，边缘微软，状态稳定"
    },
    {
      "n": 7,
      "text": "撒入大米搅匀，盖盖小火煮十分钟到米粒开花。",
      "time_min": 11,
      "heat": "小火",
      "tip": "米粒吸汤，汤汁才会浓稠起来。，注意火候。",
      "visual_cue": "米粒开花，汤汁浓稠，状态稳定"
    },
    {
      "n": 8,
      "text": "尝味补盐，撒欧芹碎后盛在深碗里。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "收尾尝一下咸淡，根茎带甜容易淡。，注意火候。",
      "visual_cue": "汤汁浓稠，香气甜润，状态稳定"
    }
  ],
  "tips": [
    "根茎类后放，久炖才不会全化掉。，值得留意。",
    "大米最后下，汤汁才会浓稠。，值得留意。",
    "块切大一点，成菜才有口感层次。，值得留意。"
  ],
  "common_mistakes": [
    "土豆下太早，炖完找不到块。，值得留意。",
    "水加太少，米一入锅就糊底。，值得留意。",
    "全程大火，南瓜散成泥汤。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "胡萝卜",
      "ratio": "400 克:400 克",
      "note": "甜味稍减，可加少许白糖。"
    },
    {
      "original": "牛腩",
      "substitute": "羊腿肉",
      "ratio": "500 克:500 克",
      "note": "风味更浓，可加少许孜然。"
    }
  ],
  "variations": [
    "用牛肉汤替代清水，鲜味更厚。，值得留意。",
    "加几颗李子干，酸甜更有层次。，值得留意。"
  ],
  "serving_suggestion": "用深碗盛出，配硬面包或直接当一餐。，效果更稳定。",
  "storage": "冷藏三天，复热加少量水小火煮开。，效果更稳定。",
