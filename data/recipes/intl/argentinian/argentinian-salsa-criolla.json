  "steps": [
    {
      "n": 1,
      "text": "番茄对半切开，挖掉籽再切小丁。，份量心里有数，风味才干净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "去籽才不出水，酱才不稀。，手法轻些，咸淡才好把握。",
      "visual_cue": "果肉干爽，丁形均匀，别急着加油，味道才进得去。"
    },
    {
      "n": 2,
      "text": "洋葱切成同样大小的细丁。，汤汁别收太干，口感才有层次。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切一样大，口感才匀。，份量心里有数，食材才不糊。",
      "visual_cue": "颗粒细碎，大小一致，火别太大，咸淡才好把握。"
    },
    {
      "n": 3,
      "text": "红辣椒去籽切丁，欧芹剁碎。，手法轻些，形状才完整。",
      "time_min": 5,
      "heat": "无火",
      "tip": "辣椒籽去掉，辣味才温和。，汤汁别收太干，咸淡才好把握。",
      "visual_cue": "碎末均匀，颜色鲜亮，顺序照着来，风味才干净。"
    },
    {
      "n": 4,
      "text": "所有蔬菜放碗里，加蒜末和牛至。，留意锅底，口感才有层次。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先拌干料，油才好挂。，别急着加油，颜色才够亮。",
      "visual_cue": "混合均匀，颜色缤纷，慢慢来别急，香气才留得住。"
    },
    {
      "n": 5,
      "text": "倒橄榄油和柠檬汁，撒盐和黑胡椒。，慢慢来别急，吃口才舒服。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油要能裹住所有料。，慢慢来别急，咸淡才好把握。",
      "visual_cue": "料体油亮，汁水不多，保持小火，整道菜才立得住。"
    },
    {
      "n": 6,
      "text": "拌匀后静置十分钟，让味融合。，注意别烧干，食材才不糊。",
      "time_min": 12,
      "heat": "无火",
      "tip": "静置一会儿，味才进去。，时间掐准，细节才到位。",
      "visual_cue": "汁水析出，香气清爽，锅温要匀，香气才不跑。"
    },
    {
      "n": 7,
      "text": "尝味补盐，配烤肉食用。，慢慢来别急，口感才不散。",
      "time_min": 3,
      "heat": "无火",
      "tip": "咸淡要偏淡，配肉才不抢。，动作放连贯，味道才不闷。",
      "visual_cue": "咸淡适口，酸香明显，留意锅底，成品才稳当。"
    }
  ],
  "tips": [
    "番茄去籽，酱才不会出水。，手法轻些，口感才不散。",
    "所有料切一样大，口感才匀。，起锅前尝味，味道才不闷。",
    "静置十分钟，味才融得好。，手法轻些，颜色才够亮。"
  ],
  "common_mistakes": [
    "番茄带籽，拌完一汪水。，注意别烧干，锅气才足。",
    "洋葱切太粗，口感发冲。，动作放连贯，口感才有层次。",
    "油太少，酱体发干。，留意锅底，吃口才舒服。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "彩椒",
      "ratio": "400 克:400 克",
      "note": "更脆，柠檬汁可减半。"
    },
    {
