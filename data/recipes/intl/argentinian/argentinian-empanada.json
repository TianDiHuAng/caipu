  "equipment": [
    "平底锅",
    "烤箱",
    "擀面杖",
    "叉子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉与盐混合，加入冷藏黄油丁用手指搓成粗砂状。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄油要冷，搓出来的酥粒才让饼皮起层。",
      "visual_cue": "面粉呈粗砂颗粒，不见大块黄油"
    },
    {
      "n": 2,
      "text": "加水和成柔软面团，包保鲜膜冷藏松弛半小时。",
      "time_min": 30,
      "heat": "无火",
      "tip": "冷藏能让面筋放松，擀皮时不回缩。",
      "visual_cue": "面团光滑柔软，按下去慢慢回弹"
    },
    {
      "n": 3,
      "text": "平底锅下植物油炒香洋葱丁，炒到透明略带甜味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "洋葱切得越细越好，馅料才抱团。",
      "visual_cue": "洋葱透明发软，锅中甜香"
    },
    {
      "n": 4,
      "text": "下牛肉丁炒散至变色，加孜然、盐与黑胡椒调味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "牛肉丁要炒散，结块会影响包制。",
      "visual_cue": "肉丁松散上色，不出水"
    },
    {
      "n": 5,
      "text": "加红椒丁与番茄丁炒两分钟，倒高汤小火收到几乎没有汤汁。",
      "time_min": 8,
      "heat": "小火",
      "tip": "馅料必须收干，湿馅会泡破饼皮。",
      "visual_cue": "馅料湿润但不流动"
    },
    {
      "n": 6,
      "text": "馅料盛出放凉，拌入一枚鸡蛋的蛋液增加黏合。",
      "time_min": 10,
      "heat": "无火",
      "tip": "馅料必须完全放凉，热馅会让黄油面团化开。",
      "visual_cue": "馅料抱团，凉透不冒热气"
    },
    {
      "n": 7,
      "text": "面团分成小剂子擀成圆皮，包入馅料对折，边缘压紧捏出麻花褶。",
      "time_min": 20,
      "heat": "无火",
      "tip": "边缘一定要捏紧，否则烤时爆开流汁。",
      "visual_cue": "边缘密实，褶子整齐"
    },
    {
      "n": 8,
      "text": "饼面刷蛋液，二百二十度烤十五分钟至金黄起酥。",
      "time_min": 15,
      "heat": "无火",
      "tip": "刷蛋液能让表面光亮上色。",
      "visual_cue": "表面金黄酥脆，边缘鼓起"
    }
  ],
  "tips": [
    "黄油冷藏后再搓，饼皮才有层次酥松的口感。",
    "馅料彻底收干放凉，是成败关键。",
    "没有烤箱可用平底锅小火干烙，两面各五分钟。"
  ],
  "common_mistakes": [
    "馅料带汤就包，烤的时候从封口漏出来。",
    "边缘没捏紧，出炉后全部开口散馅。",
    "饼皮太厚，一口咬下去全是面没有馅。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡胸肉",
      "ratio": "400 克:400 克",
      "note": "切更小的丁，炒制时间缩短两分钟。"
    },
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "100 克:80 毫升",
      "note": "饼皮不够酥，但操作更容易。"
    }
  ],
  "variations": [
    "加几粒去核橄榄与葡萄干，是阿根廷西北部的甜咸版本。",
    "把牛肉换成南瓜泥和奶酪，做成素食馅饼。"
  ],
  "serving_suggestion": "趁热吃，配一杯冰啤酒或 chimichurri 酱汁。",
  "storage": "生坯冷冻两个月，烤时无需解冻多加五分钟；熟饼冷藏两天，复烤五分钟。",
