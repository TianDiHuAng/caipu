  "steps": [
    {
      "n": 1,
      "text": "牛里脊切成一厘米厚的大片，用刀背拍松。，时间掐准，风味才干净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "拍松些，炸后才软嫩。，翻动放轻，味道才不闷。",
      "visual_cue": "肉片变大，厚薄均匀，慢慢来别急，火候才均匀。"
    },
    {
      "n": 2,
      "text": "两面撒盐和黑胡椒，静置五分钟。，料别一次下太多，形状才完整。",
      "time_min": 6,
      "heat": "无火",
      "tip": "撒匀些，味才进得去。，别用力搅，香气才留得住。",
      "visual_cue": "表面挂盐，肉色转深，手法轻些，味道才不闷。"
    },
    {
      "n": 3,
      "text": "肉片先拍面粉，再蘸蛋液，最后裹面包糠。，下手别慌，成品才好看。",
      "time_min": 8,
      "heat": "无火",
      "tip": "三层裹匀，外壳才不脱。，动作放连贯，形状才完整。",
      "visual_cue": "表面干爽，裹层厚实，慢慢来别急，颜色才够亮。"
    },
    {
      "n": 4,
      "text": "平底锅倒植物油，中火烧到六成热。，手法轻些，整道菜才立得住。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温别太高，外壳才不焦。，注意别烧干，口感才不发柴。",
      "visual_cue": "筷子入油起小泡，保持小火，香气才不跑。"
    },
    {
      "n": 5,
      "text": "肉排下锅，两面各煎三分钟到金黄。，翻动放轻，吃口才舒服。",
      "time_min": 8,
      "heat": "中火",
      "tip": "一面定型再翻，裹层才不掉。，先试试温度，锅气才足。",
      "visual_cue": "两面上色，边缘酥脆，翻动放轻，成品才好看。"
    },
    {
      "n": 6,
      "text": "捞出沥油，摆进烤盘。，慢慢来别急，风味才干净。，锅温要匀，表面才漂亮。",
      "time_min": 4,
      "heat": "无火",
      "tip": "沥干油，成品才不腻。，顺序照着来，香气才不跑。",
      "visual_cue": "表面干爽，油迹不多，别急着加油，形状才完整。"
    },
    {
      "n": 7,
      "text": "番茄片铺在肉排上，撒蒜末和欧芹。，时间掐准，成品才好看。",
      "time_min": 5,
      "heat": "无火",
      "tip": "铺满些，汁水才足。，火别太大，成品才好看。",
      "visual_cue": "番茄平铺，蒜末均匀，料别一次下太多，香气才留得住。"
    },
    {
      "n": 8,
      "text": "盖上奶酪片，撒牛至，两百度烤八分钟。，盖盖焖一会儿，成品才稳当。",
      "time_min": 12,
      "heat": "无火",
      "tip": "奶酪化开就够，别烤干。，时间掐准，吃口才舒服。",
      "visual_cue": "奶酪融化，边缘微黄，料别一次下太多，火候才均匀。"
    },
    {
      "n": 9,
      "text": "取出稍凉，配炸薯条一起吃。，注意别烧干，风味才干净。",
      "time_min": 4,
      "heat": "无火",
      "tip": "稍凉一下，奶酪才不流。，别急着加油，味道才不闷。",
      "visual_cue": "奶酪成膜，切面分层，别急着加油，香气才留得住。"
    }
  ],
  "tips": [
    "肉片要拍松，炸后才软。，先试试温度，形状才完整。",
    "三层裹料顺序别乱，外壳才牢。，手法轻些，食材才不糊。",
    "奶酪化开就出炉，烤久会发硬。，留意锅底，细节才到位。"
  ],
  "common_mistakes": [
    "肉片太厚，外焦里生。，动作放连贯，味道才进得去。",
    "裹层不匀，煎时脱落。，先试试温度，颜色才够亮。",
    "奶酪烤太久，表面结成硬壳。，保持小火，表面才漂亮。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "鸡胸肉",
      "ratio": "600 克:600 克",
      "note": "拍薄些，煎制时间减两分钟。"
    },
    {
      "original": "奶酪",
      "substitute": "马苏里拉奶酪",
      "ratio": "200 克:200 克",
      "note": "拉丝更好，烤制时间减两分钟。"
    }
  ],
  "variations": [
    "加一层火腿，咸香更足。，先试试温度，口感才不发柴。",
    "淋一点番茄酱，味道更浓。，锅温要匀，成品才好看。"
  ],
  "serving_suggestion": "配炸薯条和柠檬角。，汤汁别收太干，成品才稳当。",
  "storage": "冷藏一天，复热用烤箱。，手法轻些，口感才不发柴。",
