  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "奶酪",
          "name_en": "cheese",
          "amount": 400,
          "unit": "g",
          "note": "选半硬质奶酪，切两厘米厚片",
          "optional": false
        },
        {
          "name": "面包",
          "name_en": "bread",
          "amount": 200,
          "unit": "g",
          "note": "切片烤脆",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "橄榄油",
          "name_en": "olive oil",
          "amount": 20,
          "unit": "ml",
          "note": "刷盘防粘",
          "optional": false
        },
        {
          "name": "牛至",
          "name_en": "oregano",
          "amount": 3,
          "unit": "g",
          "note": "干牛至揉碎",
          "optional": false
        },
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 200,
          "unit": "g",
          "note": "切薄片铺面",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "薄薄一层",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "铸铁小盘",
    "烤箱",
    "刀",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "奶酪切成两厘米厚的圆片，用厨房纸吸掉表面多余水汽。",
      "time_min": 3,
      "heat": "无火",
      "tip": "太薄的片一烤就流成一片。",
      "visual_cue": "厚度均匀，边缘平整"
    },
    {
      "n": 2,
      "text": "铸铁小盘刷一层橄榄油，把奶酪片平铺在盘中央。",
      "time_min": 2,
      "heat": "无火",
      "tip": "油要刷到盘边，不然奶酪粘底。",
      "visual_cue": "盘底油光均匀，铺满一层"
    },
    {
      "n": 3,
      "text": "奶酪表面撒牛至、盐与黑胡椒，静置五分钟入味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "牛至先揉碎，香气才出得来。",
      "visual_cue": "调料均匀附着在奶酪表面"
    },
    {
      "n": 4,
      "text": "烤箱预热到二百二十度，奶酪连盘送入上层烤六分钟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "上层近火，表面才会上色。",
      "visual_cue": "边缘冒泡，表面微焦"
    },
    {
      "n": 5,
      "text": "取出铺上番茄薄片，再送回烤箱上层烤三分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄后放才不会出水冲淡奶酪。",
      "visual_cue": "番茄边缘卷起，微微出汁"
    },
    {
      "n": 6,
      "text": "出炉淋上少许橄榄油，趁热配烤面包片一起吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热拉丝状态最好。",
      "visual_cue": "奶酪柔软，叉起能拉出丝"
    }
  ],
  "tips": [
    "选半硬质奶酪，太软的会整片塌掉。",
    "铸铁盘必须耐高温，玻璃盘不适合空烧。",
    "一定要配烤面包片一起吃，单吃偏咸。"
  ],
  "common_mistakes": [
    "奶酪切得太薄，烤完只剩一层油。",
    "烤箱温度不够，奶酪只是变软没有焦边。",
    "番茄一开始就铺上，出水把奶酪泡散。"
  ],
  "substitutions": [
    {
      "original": "奶酪",
      "substitute": "马苏里拉",
      "ratio": "400 克:400 克",
      "note": "拉丝更好，但咸味偏淡，盐要略增。"
    },
    {
      "original": "牛至",
      "substitute": "百里香",
      "ratio": "3 克:3 克",
      "note": "香气更清雅，适合配番茄。"
    }
  ],
  "variations": [
    "表面撒一层辣椒碎，做成微辣版本。",
    "出炉后淋一勺蜂蜜，咸甜交错更顺口。"
  ],
  "serving_suggestion": "连铸铁盘上桌，配烤面包片与一杯红酒。",
  "storage": "现做现吃，冷藏后奶酪会变硬，复烤一百八十度五分钟可回软。",
