        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 3,
          "unit": "g",
          "note": "现磨",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "肉锤",
    "三个浅盘",
    "平底锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊横切成八毫米厚的片，用肉锤两面敲松到均匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "敲到厚薄一致，受热才均匀。",
      "visual_cue": "肉片变薄变宽，边缘完整"
    },
    {
      "n": 2,
      "text": "肉片两面撒盐与黑胡椒，静置十分钟让底味进去。",
      "time_min": 10,
      "heat": "无火",
      "tip": "先调味再裹粉，味道才在肉里。",
      "visual_cue": "肉片表面微微出水"
    },
    {
      "n": 3,
      "text": "准备三个浅盘，分别放面粉、蛋液和面包糠。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液里加蒜泥，香味更足。",
      "visual_cue": "三盘顺序摆好，蛋液打匀"
    },
    {
      "n": 4,
      "text": "肉片先裹一层面粉，抖掉多余的粉，只留薄薄一层。",
      "time_min": 3,
      "heat": "无火",
      "tip": "粉太厚，炸完外壳会脱落。",
      "visual_cue": "肉片表面均匀挂白"
    },
    {
      "n": 5,
      "text": "再蘸一层蛋液，让整片肉都湿透，边缘也要裹到。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液裹满，面包糠才粘得牢。",
      "visual_cue": "肉片湿润，蛋液不滴落"
    },
    {
      "n": 6,
      "text": "最后压入面包糠，用手掌轻轻压紧，让糠层粘牢。",
      "time_min": 4,
      "heat": "无火",
      "tip": "压紧实，炸的时候才不会掉渣。",
      "visual_cue": "表面覆满糠，没有露出肉色"
    },
    {
      "n": 7,
      "text": "裹好的肉片放十分钟回潮，糠层稳定不易脱落。",
      "time_min": 10,
      "heat": "无火",
      "tip": "回潮这一步能让外壳更完整。",
      "visual_cue": "糠层贴合，表面略干"
    },
    {
      "n": 8,
      "text": "平底锅倒植物油，中火烧到筷子插入冒小泡。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温不够会吸油，太高会焦壳生肉。",
      "visual_cue": "筷子周围冒密集小泡"
    },
    {
      "n": 9,
      "text": "下肉片浅炸两分半，边缘金黄后翻面再炸两分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一次炸两片，油温才稳得住。",
      "visual_cue": "两面金黄，外壳鼓起"
    },
    {
      "n": 10,
      "text": "捞出沥掉多余的油，配柠檬角趁热食用，挤汁解腻。",
      "time_min": 2,
      "heat": "无火",
      "tip": "挤柠檬汁能提味，也让外壳更脆。",
      "visual_cue": "外壳酥脆，切开肉汁清亮"
    }
  ],
  "tips": [
    "肉片敲到厚薄一致，煎炸时受热才均匀。",
    "裹糠后静置十分钟回潮，外壳不掉渣。",
    "油温保持中火，外壳金黄时里面刚好熟。"
  ],
  "common_mistakes": [
    "肉片没有敲松，炸完口感又硬又韧。",
    "裹糠后立刻下锅，外壳整片脱落。",
    "油温过高，外壳焦黑里面还是生的。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "鸡胸肉",
      "ratio": "600 克:600 克",
      "note": "敲得更薄，炸制时间各减半分钟。"
    },
    {
      "original": "面包糠",
      "substitute": "玉米面",
      "ratio": "150 克:150 克",
      "note": "外壳更粗，口感偏硬脆。"
    }
  ],
  "variations": [
    "上面放一个煎蛋，就是阿根廷的经典组合。",
    "配一碟番茄洋葱沙拉，酸香解腻。"
  ],
  "serving_suggestion": "配炸薯条和柠檬角，或夹在面包里做成三明治。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤六分钟恢复酥脆。",
