  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 1000,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 300,
          "unit": "g",
          "note": "分次加入",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小苏打",
          "name_en": "baking soda",
          "amount": 2,
          "unit": "g",
          "note": "助褐变",
          "optional": false
        },
        {
          "name": "香草荚",
          "name_en": "vanilla pod",
          "amount": 5,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底锅",
    "木勺",
    "玻璃罐",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "厚底锅倒入牛奶和白糖，中火加热并不断搅拌到糖完全化开。",
      "time_min": 8,
      "heat": "中火",
      "tip": "糖要先化开，不然容易在锅底结块。",
      "visual_cue": "液体顺滑，无糖粒"
    },
    {
      "n": 2,
      "text": "加小苏打和盐搅匀，转小火保持微沸不再搅拌。",
      "time_min": 4,
      "heat": "小火",
      "tip": "小苏打让颜色变深，只要一点点就够。",
      "visual_cue": "液面微沸，起细泡"
    },
    {
      "n": 3,
      "text": "小火慢熬八十分钟，每十分钟用木勺刮一次锅底。",
      "time_min": 80,
      "heat": "小火",
      "tip": "一定要刮底，糖奶沉底就会焦糊。",
      "visual_cue": "颜色由白转为浅棕"
    },
    {
      "n": 4,
      "text": "熬到液体变稠、颜色像焦糖，用温度计测到一百零五度。",
      "time_min": 6,
      "heat": "小火",
      "tip": "温度到一百零五度就够，再熬会发硬。",
      "visual_cue": "酱体浓稠，能挂住勺"
    },
    {
      "n": 5,
      "text": "离火加香草精拌匀，稍微放凉后装进干净玻璃罐。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁温热装罐，冷却后会变得更稠。",
      "visual_cue": "酱色深棕，表面光滑"
    }
  ],
  "tips": [
    "一定要用厚底锅，薄锅容易在底部焦糊。",
    "全程小火并定期刮底，糖奶沉底就会发苦。",
    "熬到颜色像焦糖、能挂勺就可以离火。"
  ],
  "common_mistakes": [
    "火太大不搅拌，锅底结一层焦黑的硬块。",
    "熬的时间太短，酱体稀得挂不住面包。",
    "小苏打放多了，成品带一股碱味。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "1000 毫升:800 毫升",
      "note": "更浓郁，熬的时间缩短二十分钟。"
    },
    {
      "original": "香草精",
      "substitute": "香草荚",
      "ratio": "5 毫升:半根",
      "note": "香气更自然，需剖开取籽。"
    }
  ],
  "variations": [
    "加一小撮咖啡粉，做成咖啡焦糖风味。",
    "用羊奶代替牛奶，做成更接近南美的土腥香版本。"
  ],
  "serving_suggestion": "涂在吐司、松饼或夹进阿尔法霍尔饼干里，是阿根廷人早餐和下午茶必备的甜酱。",
  "storage": "玻璃罐冷藏可存三周；取用须用干净无水的勺子，避免发霉。",
