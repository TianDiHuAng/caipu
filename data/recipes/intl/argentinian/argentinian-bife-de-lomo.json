  "steps": [
    {
      "n": 1,
      "text": "牛里脊提前二十分钟室温回温。，动作放连贯，食材才不糊。",
      "time_min": 22,
      "heat": "无火",
      "tip": "回温到位，中心才不生。，锅温要匀，口感才不散。",
      "visual_cue": "肉表不冰，手感柔，保持小火，颜色才够亮。"
    },
    {
      "n": 2,
      "text": "用盐和黑胡椒把整条肉抹匀。，动作放连贯，颜色才够亮。",
      "time_min": 4,
      "heat": "无火",
      "tip": "抹到每个面，味才一致。，顺序照着来，表面才漂亮。",
      "visual_cue": "表面挂料，分布均匀，别用力搅，火候才均匀。"
    },
    {
      "n": 3,
      "text": "平底锅倒橄榄油，大火烧到冒烟。，料别一次下太多，味道才进得去。",
      "time_min": 4,
      "heat": "大火",
      "tip": "锅要够热，肉才封得住汁。，保持小火，香气才留得住。",
      "visual_cue": "油面泛光，微微冒烟，动作放连贯，表面才漂亮。"
    },
    {
      "n": 4,
      "text": "下牛里脊和大蒜，每面煎两分钟上色。，翻动放轻，香气才留得住。",
      "time_min": 9,
      "heat": "大火",
      "tip": "四面都煎，颜色才立体。，顺序照着来，形状才完整。",
      "visual_cue": "表面焦褐，香气浓，起锅前尝味，口感才不发柴。"
    },
    {
      "n": 5,
      "text": "加黄油和百里香，用勺子把油浇在肉上。，顺序照着来，锅气才足。",
      "time_min": 4,
      "heat": "中火",
      "tip": "浇油增香，肉才润。，下手别慌，口感才有层次。",
      "visual_cue": "泡沫细腻，香气上升，料别一次下太多，吃口才舒服。"
    },
    {
      "n": 6,
      "text": "转中火再煎三分钟，达到五分熟。，手法轻些，味道才进得去。",
      "time_min": 4,
      "heat": "中火",
      "tip": "按压有弹性就差不多了。，先试试温度，火候才均匀。",
      "visual_cue": "肉面紧实，回弹明显，翻动放轻，整道菜才立得住。"
    },
    {
      "n": 7,
      "text": "取出静置八分钟，肉汁才回稳。，起锅前尝味，味道才进得去。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置不可省，切时才不流汁。，盖盖焖一会儿，口感才有层次。",
      "visual_cue": "表面微干，按压柔软，料别一次下太多，锅气才足。"
    },
    {
      "n": 8,
      "text": "土豆条用剩余油煎到金黄，撒盐。，翻动放轻，口感才不散。",
      "time_min": 10,
      "heat": "中火",
      "tip": "别挤在一起，才煎得脆。，火别太大，香气才不跑。",
      "visual_cue": "外皮金黄，内里松软，份量心里有数，成品才好看。"
    },
    {
      "n": 9,
      "text": "鸡蛋单面煎熟，和切片牛里脊装盘撒欧芹。，料别一次下太多，细节才到位。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蛋要小火煎，蛋黄才嫩。，保持小火，风味才干净。",
      "visual_cue": "蛋白凝固，蛋黄微颤，顺序照着来，火候才均匀。"
    }
  ],
  "tips": [
    "牛里脊回温后再煎，中心温度才匀。，下手别慌，食材才不糊。",
    "静置八分钟，切时肉汁才不会流。，翻动放轻，口感才有层次。",
    "煎蛋用小火，蛋黄才不破。，火别太大，火候才均匀。"
  ],
  "common_mistakes": [
    "肉直接从冰箱下锅，中心夹生。，别急着加油，香气才不跑。",
    "不静置就切，肉汁流一盘。，顺序照着来，口感才不发柴。",
    "大火煎蛋，边缘焦硬。，慢慢来别急，成品才好看。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "西冷牛排",
      "ratio": "700 克:700 克",
      "note": "油花更多，煎制时间减一分钟。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "30 克:30 毫升",
      "note": "香气略淡，可加蒜增香。"
    }
  ],
  "variations": [
    "配青酱，酸香更足。，慢慢来别急，味道才进得去。",
    "撒粗盐片，口感更有层次。，火别太大，口感才不发柴。"
  ],
  "serving_suggestion": "配煎蛋和炸土豆条。，汤汁别收太干，食材才不糊。",
  "storage": "冷藏一天，复热用平底锅。，动作放连贯，火候才均匀。",
