          "name_en": "sugar",
          "amount": 110,
          "unit": "g",
          "note": "分次用",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "室温",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 40,
          "unit": "g",
          "note": "调馅",
          "optional": false
        },
        {
          "name": "可可粉",
          "name_en": "cocoa powder",
          "amount": 20,
          "unit": "g",
          "note": "上色",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 80,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "烤箱",
    "裱花袋"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油室温软化后加白糖，用打蛋器打到颜色发白蓬松。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄油打到位，饼干才酥不硬。细节决定成败。",
      "visual_cue": "黄油蓬松发白，体积明显变大"
    },
    {
      "n": 2,
      "text": "分两次加入鸡蛋液，每次都搅到完全吸收再加下一次。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液分次加，油水才不分离。别怕麻烦。",
      "visual_cue": "蛋液被吸收，糊体顺滑有光"
    },
    {
      "n": 3,
      "text": "加入蜂蜜搅匀，再筛入面粉与十克可可粉。过程中注意火候变化。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面粉过筛，饼干表面才细腻。这一步别省。",
      "visual_cue": "粉料落下蓬松，糊体开始成团"
    },
    {
      "n": 4,
      "text": "用刮刀翻拌成团，不揉搓，包好冷藏松弛三十分钟。",
      "time_min": 35,
      "heat": "无火",
      "tip": "拌成团就停手，揉多了会起筋发硬。",
      "visual_cue": "面团光滑不粘手，按下去有弹性"
    },
    {
      "n": 5,
      "text": "面团擀成四毫米厚，用圆模压出直径五厘米的圆片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚度一致，烤出来生熟才均匀。顺序别颠倒。",
      "visual_cue": "圆片大小一致，边角料可回收"
    },
    {
      "n": 6,
      "text": "烤箱预热一百八十度，烤十二分钟至边缘微黄。",
      "time_min": 13,
      "heat": "中火",
      "tip": "刚出炉偏软是正常的，凉了才脆。",
      "visual_cue": "饼干边缘浅金，表面平整"
    },
    {
      "n": 7,
      "text": "饼干完全放凉，同时把剩余可可粉与牛奶白糖煮成稠酱。",
      "time_min": 10,
      "heat": "小火",
      "tip": "酱煮到挂勺就关火，太稠抹不开。",
      "visual_cue": "酱体乌亮，勺背能挂一层"
    },
    {
      "n": 8,
      "text": "取一片饼干抹上厚厚一层可可酱，盖上另一片轻压。",
      "time_min": 6,
      "heat": "无火",
      "tip": "酱抹厚一点，夹心才够味。火候要盯住。",
      "visual_cue": "夹心微微溢出，两片对齐"
    },
    {
      "n": 9,
      "text": "把饼干侧边在可可酱里滚一圈，再沾满椰蓉或糖粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "侧边滚一圈，外形才像店里的。多练两次就熟。",
      "visual_cue": "边缘整齐裹满，手摸不粘"
    },
    {
      "n": 10,
      "text": "做好后静置两小时，等饼干吸了酱变软再吃。",
      "time_min": 122,
      "heat": "无火",
      "tip": "放一夜最好，饼干回软才正宗。细节决定成败。",
      "visual_cue": "饼干变软，夹心紧贴不分层"
    }
  ],
  "tips": [
    "黄油要打到发白蓬松，饼干口感才酥松。",
    "面团冷藏后再擀，压模时不粘也不变形。",
    "做好放一夜回软，夹心和饼干才融成一体。"
  ],
  "common_mistakes": [
    "面团反复揉搓，烤出的饼干硬得像瓦片。",
    "饼干没放凉就抹酱，酱化开流得到处都是。",
    "夹心太稀，压上另一片就整块滑掉。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "40 克:45 克",
      "note": "风味略薄，需多加点牛奶。"
    },
    {
      "original": "可可粉",
      "substitute": "咖啡粉",
      "ratio": "20 克:12 克",
      "note": "苦味更明显，糖可多加十克。"
    }
  ],
  "variations": [
    "夹心换成焦糖牛奶酱，是最经典的南美口味。",
    "外层裹白巧克力，甜度更高。别怕麻烦。"
  ],
  "serving_suggestion": "配一杯浓缩咖啡或热牛奶，下午茶时掰开吃，夹心会慢慢流出。",
  "storage": "密封常温放四天，冷藏可放一周，冷藏后回温再吃更软。",
