          "amount": 600,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 220,
          "unit": "g",
          "note": "分两次用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 60,
          "unit": "g",
          "note": "代替焦糖酱",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cinnamon",
          "amount": 2,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 60,
          "unit": "ml",
          "note": "熬焦糖",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "布丁模",
    "盆",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "取一百克白糖加六十毫升清水，中小火熬到琥珀色，趁热倒进模具底部。",
      "time_min": 10,
      "heat": "中小火",
      "tip": "糖色一变成深琥珀就离火，再熬就发苦。",
      "visual_cue": "糖浆呈琥珀色，冒细泡"
    },
    {
      "n": 2,
      "text": "牛奶加剩余白糖小火加热到糖化，温度约六十度，不要沸腾。",
      "time_min": 8,
      "heat": "小火",
      "tip": "牛奶只需温热，煮沸会把蛋液烫成蛋花。",
      "visual_cue": "糖完全融化，锅边冒小泡"
    },
    {
      "n": 3,
      "text": "鸡蛋打散但不打发，缓缓倒入温牛奶，边倒边搅。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蛋液别打发，起泡会让布丁表面粗糙。",
      "visual_cue": "液体混合均匀无蛋块"
    },
    {
      "n": 4,
      "text": "加肉桂搅匀，整体过筛两遍去掉泡沫和杂质。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一定过筛两遍，成品才细腻没有气孔。",
      "visual_cue": "蛋奶液顺滑无泡沫"
    },
    {
      "n": 5,
      "text": "蛋奶液倒进模具，模具放进深烤盘，烤盘注入热水至模具一半高。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水浴高度到模具一半，受热才均匀。",
      "visual_cue": "模具稳放，水面过半"
    },
    {
      "n": 6,
      "text": "一百六十度烤五十分钟，中心轻晃有微微颤动即可。",
      "time_min": 50,
      "heat": "中火",
      "tip": "中心微微晃就出炉，烤到完全凝固就是老了。",
      "visual_cue": "表面平整，中心轻颤"
    },
    {
      "n": 7,
      "text": "取出放凉后冷藏四小时，倒扣脱模淋上蜂蜜再切块。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏定型后再脱模，热的时候一定碎。",
      "visual_cue": "焦糖流下，切口平整"
    }
  ],
  "tips": [
    "熬焦糖要盯紧颜色，深琥珀色一出现就离火。",
    "牛奶温热不沸，倒进蛋液里才不会结块。",
    "水浴烤制温度温和，布丁才没有气孔。"
  ],
  "common_mistakes": [
    "焦糖熬过头，整盘布丁带明显苦味。",
    "牛奶煮沸冲进蛋液，直接变蛋花汤。",
    "没有冷藏就脱模，布丁碎成一团。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "炼乳",
      "ratio": "60 克:60 克",
      "note": "更甜更稠，白糖可减二十克。"
    },
    {
      "original": "牛奶",
      "substitute": "淡奶油加牛奶",
      "ratio": "600 毫升:200 毫升+400 毫升",
      "note": "更浓郁，烤的时间多五分钟。"
    }
  ],
  "variations": [
    "表面加一勺焦糖牛奶酱，更接近阿根廷本地风味。",
    "加少许橙皮屑，柑橘香气更清爽。"
  ],
  "serving_suggestion": "冷藏后切块，淋上焦糖牛奶酱，配一杯浓缩咖啡，是阿根廷餐厅的固定甜点。",
  "storage": "冷藏三天，密封保存避免吸附冰箱异味。",
