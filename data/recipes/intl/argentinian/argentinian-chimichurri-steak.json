  ],
  "equipment": [
    "铸铁煎锅",
    "夹子",
    "刀",
    "砧板",
    "研钵"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊切四厘米厚排，提前三十分钟从冷藏取出回温，两面撒粗盐和黑胡椒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷肉下锅外层焦了里面还是生的，回温这步不能省。",
      "visual_cue": "肉色转为暗红，按下去有弹性"
    },
    {
      "n": 2,
      "text": "欧芹叶切得很碎，与蒜末、牛至、干辣椒碎一起放进碗里。",
      "time_min": 8,
      "heat": "无火",
      "tip": "欧芹要切碎而不打泥，青酱讲究颗粒感。",
      "visual_cue": "香草碎散开，不结团"
    },
    {
      "n": 3,
      "text": "倒入白醋和橄榄油，加两克盐搅匀，静置二十分钟让味道融合。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青酱做好要放一会儿再用，醋和油融合后酸香才顺。",
      "visual_cue": "油色泛绿，香草沉在碗底"
    },
    {
      "n": 4,
      "text": "铸铁锅大火烧到冒烟，刷薄薄一层植物油，牛排下锅单面煎三分钟不动。",
      "time_min": 4,
      "heat": "大火",
      "tip": "下锅后别急着动，等焦壳形成肉才不粘锅。",
      "visual_cue": "接触面成深褐色脆壳，锅内冒白烟"
    },
    {
      "n": 5,
      "text": "翻面再煎三分钟，用夹子把侧边立起各煎三十秒，煎出油脂。",
      "time_min": 4,
      "heat": "大火",
      "tip": "侧边那层脂肪要单独煎，油脂化开才香。",
      "visual_cue": "四边都上色，肉排略微鼓起"
    },
    {
      "n": 6,
      "text": "牛排放盘静置六分钟，切片后淋上大量青酱，剩余青酱装小碗另配。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置时间差不多等于煎的时间，肉汁才不会流失。",
      "visual_cue": "切面呈粉红，盘底只有少量血水"
    }
  ],
  "tips": [
    "青酱现做现用最好，冷藏过夜颜色会变暗但风味更融合。",
    "牛排厚度决定时间，两厘米厚每面煎一分半即可。",
    "粗粒海盐在切片后再补一点，口感更立体。"
  ],
  "common_mistakes": [
    "肉没回温就下锅，外层焦苦内里冰凉。",
    "青酱用料理机打成泥，失去颗粒口感和鲜活的香草味。",
    "煎完立刻切，肉汁全流在盘底，肉质发干。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "西冷",
      "ratio": "800 克:800 克",
      "note": "带油边更香，煎制时间相同。"
    },
    {
      "original": "白醋",
      "substitute": "苹果醋",
      "ratio": "40 毫升:40 毫升",
      "note": "酸味更柔和，果香明显。"
    }
  ],
  "variations": [
    "青酱也可淋在烤鸡或烤蔬菜上，是阿根廷餐桌的通用蘸酱。"
  ],
  "serving_suggestion": "配烤土豆块、烤甜椒与一杯干红，牛排切片后淋青酱。",
  "storage": "牛排冷藏两天，青酱冷藏五天；青酱回温后再用，勿微波加热。",
