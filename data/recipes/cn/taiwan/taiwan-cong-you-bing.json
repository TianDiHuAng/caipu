  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 150,
          "unit": "g",
          "note": "切花",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "猪油",
          "name_en": "lard",
          "amount": 50,
          "unit": "g",
          "note": "做油酥",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 10,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "五香粉",
          "name_en": "five spice powder",
          "amount": 3,
          "unit": "g",
          "note": "提香",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 280,
          "unit": "ml",
          "note": "分次加入",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "大碗",
    "刷子",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉先用开水烫成絮状，再慢慢加剩余清水揉成团。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "开水烫面加剩余清水，皮才酥中带软。，看准状态再往下做。",
      "visual_cue": "面团成团，手感柔软"
    },
    {
      "n": 2,
      "text": "面团盖上湿布醒三十分钟，让面筋松弛。，看准状态再往下做。",
      "time_min": 32,
      "heat": "无火",
      "tip": "醒不够，擀的时候会回缩。，看准状态再往下做。",
      "visual_cue": "面团延展，按压有弹性"
    },
    {
      "n": 3,
      "text": "猪油加面粉、盐和五香粉拌成油酥。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "油酥调成糊状，抹开才均匀。，看准状态再往下做。",
      "visual_cue": "油酥顺滑，咸香扑鼻"
    },
    {
      "n": 4,
      "text": "小葱洗净沥干，切成细葱花备用。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "葱要沥干，带水抹油酥会出水。，看准状态再往下做。",
      "visual_cue": "葱花细匀，干爽松散"
    },
    {
      "n": 5,
      "text": "面团擀成大薄片，均匀抹一层油酥。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "边缘也要抹到，层次才分明。，看准状态再往下做。",
      "visual_cue": "薄片透光，油酥铺满"
    },
    {
      "n": 6,
      "text": "撒满葱花，从一边卷成长条再盘成团。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "卷紧一点，里面的空气才少。，看准状态再往下做。",
      "visual_cue": "条状紧实，层次可见"
    },
    {
      "n": 7,
      "text": "盘好的面团压扁，轻轻擀成圆饼。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "轻擀别用力，否则层次会压死。，看准状态再往下做。",
      "visual_cue": "饼坯厚薄均匀，这一点很关键。"
    },
    {
      "n": 8,
      "text": "平底锅刷植物油，中小火两面各煎四分钟。，看准状态再往下做。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "中小火慢煎，里面才熟透。，看准状态再往下做。",
      "visual_cue": "两面金黄，饼身鼓起"
    },
    {
      "n": 9,
      "text": "出锅用铲子拍松，切成小块趁热吃。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拍松层次才散开，口感更酥。，看准状态再往下做。",
      "visual_cue": "层层分离，葱香扑鼻"
    }
  ],
  "tips": [
    "半烫面是关键，皮才外酥内软。，这一点很关键。",
    "油酥要抹匀，层次才起得好。，这一点很关键。",
    "中小火煎，火大了外焦内生。，这一点很关键。"
  ],
  "common_mistakes": [
    "面团不醒就擀，一擀就回缩。，这一点很关键。",
    "葱花带水，饼里出水发黏。，这一点很关键。",
    "大火煎，外面焦黑里面生的。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "50 克:45 克",
      "note": "香气稍淡，层次略差。"
    },
    {
      "original": "小葱",
      "substitute": "韭菜",
      "ratio": "150 克:150 克",
      "note": "辛香更冲，用量可减半。"
    }
  ],
  "variations": [
    "加一个鸡蛋摊成蛋饼，更饱腹。，这一点很关键。",
    "撒点黑胡椒，风味更西式。，这一点很关键。"
  ],
  "serving_suggestion": "早餐配豆浆，或夹蛋夹肉。，这一点很关键。",
  "storage": "冷藏两天，冷冻两周；复热平底锅小火煎。",
