          "name_en": "water",
          "amount": 300,
          "unit": "ml",
          "note": "调浆",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "防粘",
          "optional": false
        },
        {
          "name": "花生",
          "name_en": "peanut",
          "amount": 80,
          "unit": "g",
          "note": "炒香碾碎",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 20,
          "unit": "g",
          "note": "炒香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "盆",
    "刀",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉加白糖混合，分次倒入三百毫升清水，搅成没有颗粒的稀浆。",
      "time_min": 8,
      "heat": "无火",
      "tip": "浆要搅到顺滑无疙瘩，蒸出来才细腻。",
      "visual_cue": "粉浆浓稠能挂住筷子"
    },
    {
      "n": 2,
      "text": "粉浆过一遍筛，倒进抹了植物油的浅盘，表面盖一层保鲜膜。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛去颗粒，盖膜是防止水汽滴进去。",
      "visual_cue": "浆面平整没有气泡"
    },
    {
      "n": 3,
      "text": "蒸锅水开后上笼，大火蒸二十分钟，中途不要开盖。",
      "time_min": 20,
      "heat": "大火",
      "tip": "中途开盖会塌陷，耐心等足二十分钟。",
      "visual_cue": "粉浆凝固成半透明团"
    },
    {
      "n": 4,
      "text": "蒸好取出稍晾五分钟，用抹了油的铲子翻拌，让面团更筋道。",
      "time_min": 6,
      "heat": "无火",
      "tip": "趁热翻拌才起筋，凉了就拌不动。",
      "visual_cue": "面团能拉长且不断"
    },
    {
      "n": 5,
      "text": "花生用平底锅小火炒香，去皮碾成粗粒，和芝麻、白糖拌成蘸粉。",
      "time_min": 6,
      "heat": "小火",
      "tip": "花生别炒过，颜色一变深就发苦。",
      "visual_cue": "花生碎带颗粒，香气冲鼻"
    },
    {
      "n": 6,
      "text": "手上抹油揪成三十克一个的剂子，搓圆后滚一圈蘸粉装盘。",
      "time_min": 5,
      "heat": "无火",
      "tip": "手和刀都要抹油，否则粘得没法下手。",
      "visual_cue": "麻糬圆整，外层裹满粉"
    }
  ],
  "tips": [
    "粉浆一定过筛，蒸出来才细腻不夹生。",
    "蒸的时候盖保鲜膜，避免水汽把表面蒸稀。",
    "手抹油再揪剂子，操作起来不粘手。"
  ],
  "common_mistakes": [
    "粉浆有颗粒没筛，麻糬里带硬芯。",
    "中途开盖去看，麻糬塌陷回缩变形。",
    "花生炒糊了，整盘蘸粉都带苦味。"
  ],
  "substitutions": [
    {
      "original": "花生",
      "substitute": "黑芝麻",
      "ratio": "80 克:60 克",
      "note": "香气更浓，需减少十克白糖。"
    },
    {
      "original": "清水",
      "substitute": "牛奶",
      "ratio": "300 毫升:300 毫升",
      "note": "更香浓，蒸的时间多两分钟。"
    }
  ],
  "variations": [
    "包一小块红豆沙进麻糬里，做成夹心版本。",
    "蘸粉里加少许盐，甜咸对比更明显。"
  ],
  "serving_suggestion": "装盘后撒满花生芝麻粉，配一杯无糖乌龙茶，台湾夜市常见这种吃法。",
  "storage": "密封冷藏两天，变硬后蒸三分钟或微波二十秒回软。",
