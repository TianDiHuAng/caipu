        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "锅铲",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉剁成四厘米见方的块，用清水冲去血水后沥干备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "冲去血水，炖出来的汤才清不腥。",
      "visual_cue": "鸡块干净，表面无血水"
    },
    {
      "n": 2,
      "text": "砂锅倒入香油，小火把姜片煸到边缘卷起发干。",
      "time_min": 4,
      "heat": "小火",
      "tip": "姜片煸干，香气才完全释放。",
      "visual_cue": "姜片边缘卷曲，颜色金黄"
    },
    {
      "n": 3,
      "text": "下大蒜粒与干辣椒段炒三十秒，炒到蒜香冒出即可。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜别炒焦，焦了会带苦味。",
      "visual_cue": "蒜粒微黄，辣椒出香"
    },
    {
      "n": 4,
      "text": "转中火下鸡块，翻炒六分钟至表面变白收紧。",
      "time_min": 6,
      "heat": "中火",
      "tip": "鸡肉先煸出油，口感才不腻。",
      "visual_cue": "鸡皮微黄，表面紧实"
    },
    {
      "n": 5,
      "text": "沿锅边淋入生抽与米酒，加白糖后翻匀上色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "沿锅边淋，酱香更容易激出来。",
      "visual_cue": "鸡块均匀上色，锅底有汁"
    },
    {
      "n": 6,
      "text": "盖盖转小火焖十五分钟，中途翻动一次让味道均匀。",
      "time_min": 15,
      "heat": "小火",
      "tip": "小火焖，鸡肉才嫩不柴。",
      "visual_cue": "鸡肉软嫩，能用筷子扎透"
    },
    {
      "n": 7,
      "text": "开盖转大火收汁，收到汤汁浓稠裹在鸡块表面。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁时勤翻动，糖分容易糊底。",
      "visual_cue": "汤汁浓稠发亮，几乎收干"
    },
    {
      "n": 8,
      "text": "关火撒小葱段，利用余温焖一分钟让葱香散开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱最后放，香气才新鲜。",
      "visual_cue": "葱段翠绿，香气扑鼻"
    },
    {
      "n": 9,
      "text": "连砂锅一起端上桌，配一份爽口小菜趁热食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "砂锅保温，吃到后面还是热的。",
      "visual_cue": "鸡块油亮，锅底留少量汁"
    }
  ],
  "tips": [
    "姜片要小火煸到卷边，香气才够浓。",
    "全程用小火慢焖，鸡肉才软嫩不发柴。",
    "收汁要收到裹住鸡块，味道才集中。"
  ],
  "common_mistakes": [
    "姜片没煸干就下鸡，香味出不来。",
    "大火猛焖，鸡肉外层老了里面还生。",
    "收汁收到锅底焦黑，整锅带苦味。"
  ],
  "substitutions": [
    {
      "original": "米酒",
      "substitute": "料酒",
      "ratio": "60 毫升:60 毫升",
      "note": "香气略淡，可加一勺冰糖。"
    },
    {
      "original": "香油",
      "substitute": "植物油",
      "ratio": "50 毫升:45 毫升",
      "note": "少了芝麻香，需加几滴香油提味。"
    }
  ],
  "variations": [
    "加一把九层塔同焖，香气更台式。",
    "喜欢辣可在收汁时补一勺辣椒酱。"
  ],
  "serving_suggestion": "连锅上桌配爽口小菜，也可配一小碗热汤同吃。",
  "storage": "冷藏两天，复热加一小勺水小火焖五分钟。",
