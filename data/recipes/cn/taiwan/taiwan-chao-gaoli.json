  "steps": [
    {
      "n": 1,
      "text": "卷心菜剥去外层老叶，用手撕成巴掌大的片，洗净后甩干水分备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "手撕的断口不规则，比刀切的更容易挂汁入味。",
      "visual_cue": "菜叶边缘毛糙，叶梗厚薄分明"
    },
    {
      "n": 2,
      "text": "炒锅烧热倒植物油，下红葱头碎小火慢煸到边缘金黄出香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "红葱头是台式炒菜的灵魂，煸到金黄香味才出得来。",
      "visual_cue": "葱碎边缘焦黄，油面泛红"
    },
    {
      "n": 3,
      "text": "下蒜片和干辣椒段爆香十秒，转大火倒入卷心菜片快速翻炒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "菜下锅前锅一定要够热，温锅炒菜会出一汪水。",
      "visual_cue": "菜叶边缘微微透亮发软"
    },
    {
      "n": 4,
      "text": "沿锅边淋米酒和酱油，继续大火翻炒一分钟让菜叶均匀裹上油汁。",
      "time_min": 4,
      "heat": "大火",
      "tip": "酒沿锅边淋才激得出香气，直接浇菜上会发酸。",
      "visual_cue": "酒气上冲，菜叶油亮挂汁"
    },
    {
      "n": 5,
      "text": "加盐快速翻匀，看到菜梗断生变透明就立刻关火出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "全程不超过三分钟，炒久了菜叶发黄出水。",
      "visual_cue": "菜梗半透，盘底几乎无汤水"
    },
    {
      "n": 6,
      "text": "装盘趁热吃，盘底只留一层薄油和少量清汁，不要泡在汤里。",
      "time_min": 2,
      "heat": "无火",
      "tip": "出锅马上装盘，留在热锅里会继续软化。",
      "visual_cue": "叶色翠绿，盘底清爽无汤"
    }
  ],
  "tips": [
    "卷心菜一定要手撕，刀切会切断细胞出水多，炒出来软塌塌的没有脆感。",
    "红葱头和蒜分两次下锅，红葱头先煸出香，蒜片后放才不糊。这两样都不能省。",
    "火要大、时间要短，从菜下锅到出锅三分钟以内。台式快炒讲究的就是猛火锁水。",
    "洗完的菜必须甩干，带水下锅油温骤降，成品就是一盘水煮菜，锅气全无。"
  ],
  "common_mistakes": [
    "卷心菜洗完不沥干直接下锅，炒出一盘汤水。下锅前一定要甩干或晾干表面水分。",
    "红葱头大火炸，几秒钟就黑，整盘菜带焦苦味。必须小火慢煸到金黄。",
    "盐放太早，菜叶迅速出水变软。盐要在出锅前最后一步才下。",
    "菜梗和菜叶一起炒，梗还硬叶已烂。梗厚的可以先下锅三十秒再放叶片。"
  ],
  "substitutions": [
    {
      "original": "卷心菜",
      "substitute": "包菜心",
      "ratio": "600克:600克",
      "note": "更嫩更甜，炒制时间可再短半分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "白胡椒粉",
      "ratio": "3克:2克",
      "note": "辣味换成辛香，孩子也能吃。"
    }
  ],
  "variations": [
    "加一把泡软的虾米同炒，鲜味更足。台式家常最常见的加料版本。",
    "用猪油代替植物油炒，香气厚重得多。老派台菜馆子基本都这么干。",
    "最后撒一点香油和切段的韭菜，收尾更香。适合配卤肉饭一起吃。"
  ],
  "serving_suggestion": "趁热装盘当配菜，配卤肉饭、鸡肉饭或白饭都合适，脆嫩清甜、油香不腻，是台菜馆的常备青菜。",
  "storage": "冷藏可放一天，复热用大火快炒三十秒；微波会让菜叶出水变软，不建议使用。",
