  "equipment": [
    "蒸锅",
    "盆",
    "擀面杖",
    "刀",
    "砧板",
    "汤锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芋头去皮切成两厘米厚的片，上锅大火蒸二十分钟至筷子能轻松插透。",
      "time_min": 22,
      "heat": "大火",
      "tip": "芋头要蒸到完全软烂，压泥才细腻无颗粒。",
      "visual_cue": "芋头片裂开，边缘粉糯"
    },
    {
      "n": 2,
      "text": "趁热把芋头压成细腻的泥，加二十克白砂糖拌匀，晾到不烫手。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一定要趁热压泥，凉了芋头会变硬压不散。",
      "visual_cue": "芋泥细腻顺滑，没有结块"
    },
    {
      "n": 3,
      "text": "芋泥里分三次加入红薯淀粉和木薯粉，揉成不粘手的面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "粉要分次加，一次全倒会干裂揉不成团。",
      "visual_cue": "面团光滑，按压有弹性"
    },
    {
      "n": 4,
      "text": "面团搓成一厘米粗的长条，切成小块，撒干粉防粘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "条要搓得粗细一致，煮的时候才同熟。",
      "visual_cue": "小段大小均匀，不粘连"
    },
    {
      "n": 5,
      "text": "汤锅加清水、姜片和冰糖煮开，转小火煮五分钟出姜味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "姜不要放得太多，主要提香不抢甜味。",
      "visual_cue": "汤色清亮微黄，姜香带一点辛"
    },
    {
      "n": 6,
      "text": "另锅水大滚下芋圆，煮到芋圆浮起后再煮两分钟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "芋圆浮起才算熟，浮起后再煮两分钟更透。",
      "visual_cue": "芋圆全部浮起，体积膨大"
    },
    {
      "n": 7,
      "text": "捞出的芋圆过一遍凉开水，再放进甜汤里，加剩余白砂糖调甜度。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过一遍凉水能让芋圆更弹，千万别省略。",
      "visual_cue": "芋圆外滑内韧，汤色微浑"
    }
  ],
  "tips": [
    "芋头要选粉质重的，蒸出来压泥才够细腻。水芋太黏，做芋圆口感发死。",
    "红薯淀粉和木薯粉搭配使用，前者提供芋香、后者提供弹性。只用一种口感会偏。",
    "煮芋圆另起一锅水，直接在甜汤里煮会让汤变糊。煮好过凉水再放进汤里。",
    "芋圆一次可以多做，切好后撒干粉冷冻，随吃随煮不用解冻，很方便。"
  ],
  "common_mistakes": [
    "芋头没蒸透就压泥，芋圆里全是硬颗粒。必须蒸到筷子轻松插透。",
    "粉一次全倒进芋泥，揉成一团干裂的面疙瘩。必须分三次加。",
    "芋圆在甜汤里直接煮，汤变浑浊发黏。必须另锅清水煮，捞出来再放汤里。",
    "煮好的芋圆泡在汤里放太久，泡软失去弹性。吃前再组合，别提前泡。"
  ],
  "substitutions": [
    {
      "original": "芋头",
      "substitute": "紫薯",
      "ratio": "400克:400克",
      "note": "颜色更艳，需多加二十克红薯淀粉。"
    },
    {
      "original": "红薯淀粉",
      "substitute": "木薯粉",
      "ratio": "200克:220克",
      "note": "更弹更透明，芋香略淡。"
    }
  ],
  "variations": [
    "加一勺红豆和仙草冻同吃，就是台湾刨冰店的标准配料组合。",
    "汤底换成椰浆或牛奶，做成南洋风味的芋圆甜品。孩子更喜欢这个版本。",
    "芋圆里包一小块红豆沙，做成包馅芋圆。口感层次更丰富，适合宴客。"
  ],
  "serving_suggestion": "盛碗连汤带芋圆一起吃，温热吃软糯、加冰吃弹牙，是台湾夜市甜品摊最经典的一味。",
  "storage": "生芋圆撒粉冷冻可存一个月，煮熟的不建议冷冻；甜汤冷藏两天内吃完，复热加少量水。",
