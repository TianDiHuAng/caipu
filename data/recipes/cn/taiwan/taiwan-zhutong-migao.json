  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗干净，用清水浸泡两小时至米粒发白。，看准状态再往下做。",
      "time_min": 125,
      "heat": "无火",
      "tip": "泡透的糯米蒸出来才糯不夹生。，看准状态再往下做。",
      "visual_cue": "米粒饱满，一捏即碎"
    },
    {
      "n": 2,
      "text": "香菇和虾米分别用温水泡软，香菇切小丁。，看准状态再往下做。",
      "time_min": 15,
      "heat": "无火",
      "tip": "泡香菇的水留着，蒸饭更香。，看准状态再往下做。",
      "visual_cue": "香菇回软，虾米舒展"
    },
    {
      "n": 3,
      "text": "五花肉切小丁，炒锅倒植物油下肉丁煸香。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煸出油，米糕才不干不腻。，看准状态再往下做。",
      "visual_cue": "肉丁缩小，油析出，这一点很关键。"
    },
    {
      "n": 4,
      "text": "下香菇丁和虾米炒香，加生抽老抽白糖五香粉。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酱料炒匀，米粒上色才漂亮。，看准状态再往下做。",
      "visual_cue": "料丁裹色，香气浓，这一点很关键。"
    },
    {
      "n": 5,
      "text": "倒入沥干的糯米，中火翻炒到米粒微透。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "炒到米粒透明，蒸时更易熟。，看准状态再往下做。",
      "visual_cue": "米粒油亮，颗颗分明"
    },
    {
      "n": 6,
      "text": "加清水和盐拌匀，让米粒吸收汤汁。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "水别多，糯米泡过已经含水。，看准状态再往下做。",
      "visual_cue": "米粒湿润，锅底无汤"
    },
    {
      "n": 7,
      "text": "小杯内壁抹油，先放肉料再铺满糯米压实。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "先放料再铺米，倒扣出来才好看。，看准状态再往下做。",
      "visual_cue": "杯内平整，压实无孔"
    },
    {
      "n": 8,
      "text": "放进蒸锅大火蒸四十分钟，焖五分钟再开盖。，看准状态再往下做。",
      "time_min": 45,
      "heat": "大火",
      "tip": "焖五分钟，米糕才不粘杯。，看准状态再往下做。",
      "visual_cue": "香气溢出，表面油亮"
    },
    {
      "n": 9,
      "text": "倒扣脱模，撒香菜趁热吃。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热脱模，凉了会粘住杯壁。，看准状态再往下做。",
      "visual_cue": "形状完整，米粒透亮"
    }
  ],
  "tips": [
    "糯米必须泡透，否则蒸出来有硬芯。",
    "杯壁抹油，脱模才完整不粘。，这一点很关键。",
    "蒸好焖五分钟，米糕更紧实。，这一点很关键。"
  ],
  "common_mistakes": [
    "糯米没泡，蒸两小时还是硬的。，这一点很关键。",
    "水加太多，米糕变成烂饭。，这一点很关键。",
    "杯不抹油，脱模全碎。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "糯米",
      "substitute": "圆糯米",
      "ratio": "400 克:400 克",
      "note": "更黏，水要减五十毫升。"
    },
    {
      "original": "五花肉",
      "substitute": "腊肠",
      "ratio": "250 克:200 克",
      "note": "更香，盐要减半。"
    }
  ],
  "variations": [
    "加半个咸蛋黄，风味更足。，这一点很关键。",
    "淋一勺甜辣酱，台南吃法。，这一点很关键。"
  ],
  "serving_suggestion": "配一碗四神汤或味噌汤。，这一点很关键。",
  "storage": "冷藏两天，冷冻两周；复热蒸十五分钟。",
