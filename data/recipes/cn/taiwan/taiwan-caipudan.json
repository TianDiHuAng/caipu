  ],
  "steps": [
    {
      "n": 1,
      "text": "萝卜干用清水泡十分钟去掉多余盐分，捞出挤干后切成细末。",
      "time_min": 13,
      "heat": "无火",
      "tip": "泡水时间看咸度，太咸的多泡五分钟。",
      "visual_cue": "萝卜干变软，挤出的水清澈"
    },
    {
      "n": 2,
      "text": "平底锅不放油，小火把萝卜干末干煸三分钟至水分收干出香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "干煸能把萝卜干的陈味炒掉，只剩甘香。",
      "visual_cue": "碎末干爽松散，香味扑鼻"
    },
    {
      "n": 3,
      "text": "煸好的萝卜干加白砂糖、白胡椒和蒜末拌匀，晾到不烫手。",
      "time_min": 4,
      "heat": "无火",
      "tip": "一定要晾凉再打进蛋液，热的下锅会结块。",
      "visual_cue": "碎末粒粒分明，不结团"
    },
    {
      "n": 4,
      "text": "鸡蛋打入碗中，加酱油和葱花打散，再拌入萝卜干末搅匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液要打到表面起细泡，煎出来才蓬松。",
      "visual_cue": "蛋液颜色均匀，表面气泡细密"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油烧至五成热，倒入蛋液转小火慢煎三分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "油温别太高，蛋液下去要能慢慢凝固。",
      "visual_cue": "蛋液边缘先凝，中间微鼓"
    },
    {
      "n": 6,
      "text": "底面定型金黄后用盘子翻面，再煎两分钟至两面金黄熟透。",
      "time_min": 5,
      "heat": "小火",
      "tip": "用盘子扣住翻面最稳，铲子翻容易碎。",
      "visual_cue": "两面金黄，蛋饼鼓起有弹性"
    },
    {
      "n": 7,
      "text": "出锅切成六块装盘，趁热吃外层微焦、内里软嫩。",
      "time_min": 3,
      "heat": "无火",
      "tip": "切块前先晾一分钟左右，太烫容易散。",
      "visual_cue": "切面蓬松鼓起，气孔细密均匀"
    }
  ],
  "tips": [
    "萝卜干必须泡水，直接下锅咸得没法吃。泡完一定要挤干水分，不然煎的时候出水。",
    "萝卜干先干煸再拌蛋液，这一步是菜脯蛋香不香的关键，能去掉腌制时的陈味。",
    "蛋液下锅后火要小，慢慢煎。大火外面焦了里面还是稀的，翻面就散。",
    "加一点白砂糖不是为了甜，是为了中和萝卜干的咸涩。三克刚好，尝不出甜味。"
  ],
  "common_mistakes": [
    "萝卜干不泡水直接用，整盘咸到发苦。泡十分钟挤干再切末。",
    "蛋液里加太多水，煎出来散成一摊。要嫩可以加一勺牛奶或米酒。",
    "大火煎蛋，底面焦黑上面还流。小火慢煎，耐心等它凝固。",
    "翻面用铲子硬铲，蛋饼碎成块。用盘子扣住翻转最稳当。"
  ],
  "substitutions": [
    {
      "original": "萝卜干",
      "substitute": "榨菜",
      "ratio": "70克:70克",
      "note": "口感更脆，咸度更需泡水调整。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "240克:250克",
      "note": "蛋香更浓，口感略韧。"
    }
  ],
  "variations": [
    "蛋液里加一把虾米或碎油条，口感更丰富。台式早餐店的升级版。",
    "把蛋饼煎厚一点做成烘蛋，切面更高更蓬松。宴客时更上镜。",
    "加半勺辣椒酱同煎，做成辣味菜脯蛋。配白粥是最经典的台式早餐组合。"
  ],
  "serving_suggestion": "切块配白粥吃，蛋香、葱香和萝卜干的甘咸混在一起，是台湾早餐店最经典的一味，也是家家会做的家常菜。",
  "storage": "冷藏可放一天，复热用平底锅小火干烙两分钟；不建议微波，蛋饼会变韧出水。",
