  "steps": [
    {
      "n": 1,
      "text": "鲈鱼刮鳞去内脏洗净，在鱼身两面各划三刀，深至鱼骨。",
      "time_min": 9,
      "heat": "无火",
      "tip": "划刀让热气进得去，鱼肉受热才均匀。",
      "visual_cue": "鱼身刀口整齐，鱼腹无血污"
    },
    {
      "n": 2,
      "text": "鱼身内外抹米酒，鱼肚塞姜片和葱段，静置十分钟去腥。",
      "time_min": 12,
      "heat": "无火",
      "tip": "米酒抹一遍就够，泡久了鱼肉会发柴。",
      "visual_cue": "鱼皮微润，腥味明显变淡"
    },
    {
      "n": 3,
      "text": "黄豆酱加酱油、白砂糖和两勺清水调成稀糊状备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "豆酱要调稀才抹得匀，太稠会盖住鱼鲜。",
      "visual_cue": "酱糊顺滑无颗粒，颜色呈深褐红"
    },
    {
      "n": 4,
      "text": "蒸盘底铺葱段和姜片，把鲈鱼放上去，鱼身抹满调好的豆酱糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "底下垫葱姜，蒸汽才能从鱼腹下穿过。",
      "visual_cue": "鱼身酱色均匀，垫料铺满盘底"
    },
    {
      "n": 5,
      "text": "蒸锅水大滚后放入蒸盘，大火蒸八分钟，关火焖两分钟。",
      "time_min": 12,
      "heat": "大火",
      "tip": "水必须大滚再上锅，冷水起蒸鱼肉会老。",
      "visual_cue": "鱼眼凸出变白，鱼皮微微裂开"
    },
    {
      "n": 6,
      "text": "取出倒掉盘中腥水，撒上葱丝和香菜段，淋一勺滚热的植物油。",
      "time_min": 4,
      "heat": "大火",
      "tip": "盘里的汤水必须倒掉，那是腥味最重的地方。",
      "visual_cue": "葱丝遇热卷曲，香气扑鼻"
    },
    {
      "n": 7,
      "text": "趁热上桌，用筷子从鱼背最厚处插入，能轻松分开即是熟透。",
      "time_min": 2,
      "heat": "无火",
      "tip": "筷子插最厚处能分开就熟了，别蒸过头。",
      "visual_cue": "鱼肉雪白分层，骨肉易分离"
    }
  ],
  "tips": [
    "蒸鱼的关键是水滚上锅，火要大、时间要准。六百克的鱼八分钟正好，多一分钟肉就柴。",
    "盘底的葱姜不只是去腥，还能把鱼架空，让蒸汽从底下循环。垫料铺满效果最好。",
    "蒸出来的汤水一定要倒掉再淋油，那汤是腥味的集中地。倒了鱼肉才清甜。",
    "黄豆酱本身有咸味，酱油只放一点提色。宁淡勿咸，吃的时候还能蘸酱汁。"
  ],
  "common_mistakes": [
    "冷水上锅蒸鱼，鱼肉从外到内慢慢受热，蒸足十五分钟还是老。必须等水大滚。",
    "鱼身不划刀，厚处蒸不熟薄处已经老了。划三刀让热力均匀进入。",
    "蒸好不焖直接开盖，鱼肉骤遇冷空气会收缩变硬。关火焖两分钟更嫩。",
    "豆酱抹得太厚，压住鱼本身的鲜甜。薄薄一层就够，吃的是酱香衬鱼鲜。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "金目鲈",
      "ratio": "600克:600克",
      "note": "肉质更紧，蒸制时间加一分钟。"
    },
    {
      "original": "黄豆酱",
      "substitute": "豆瓣酱",
      "ratio": "30克:25克",
      "note": "带辣味，用量要减，咸度更高。"
    }
  ],
  "variations": [
    "用破布子代替黄豆酱，做成破布子蒸鱼。甘咸回甜，台南人的经典做法。",
    "鱼换成午仔鱼或赤鯮，肉质更细。海鱼蒸出来鲜味更足。",
    "蒸好后淋一勺热香油而不是植物油，香气更浓。台式老馆子常用这个做法。"
  ],
  "serving_suggestion": "整条上桌，鱼肉雪白细嫩，蘸盘底的豆酱汁吃，配白饭或地瓜粥都合适，是台菜宴客的常见主菜。",
  "storage": "冷藏可放一天，复热用蒸锅大火蒸五分钟；鱼肉隔夜易腥，建议当餐吃完。",
