  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "肉锤",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪排骨用肉锤两面敲松，敲到厚度均匀。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "敲断筋膜，炸后不回缩。，看准状态再往下做。",
      "visual_cue": "肉片变薄，面积变大"
    },
    {
      "n": 2,
      "text": "排骨加生抽、米酒、蒜末、五香粉和白胡椒粉腌半小时。",
      "time_min": 35,
      "heat": "无火",
      "tip": "腌够时间，里面才有味道。，看准状态再往下做。",
      "visual_cue": "表面湿润，香气明显"
    },
    {
      "n": 3,
      "text": "腌好的排骨先拍一层红薯淀粉，再裹蛋液。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先粉后蛋，炸衣才贴得牢。，看准状态再往下做。",
      "visual_cue": "表面均匀，无干粉块"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到六成热，下排骨中火炸。，看准状态再往下做。",
      "time_min": 7,
      "heat": "中火",
      "tip": "油温不够，炸衣会脱落。，看准状态再往下做。",
      "visual_cue": "周围冒泡，颜色渐黄"
    },
    {
      "n": 5,
      "text": "一面炸三分钟翻面，再炸两分钟到金黄。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "翻面一次就够，反复翻会掉浆。，看准状态再往下做。",
      "visual_cue": "两面金黄，外壳酥硬"
    },
    {
      "n": 6,
      "text": "捞出沥油，静置两分钟让肉汁回流。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置后再切，肉汁才不流失。，看准状态再往下做。",
      "visual_cue": "外壳干爽，油滴落下"
    },
    {
      "n": 7,
      "text": "酸菜切碎，用锅里余油快速炒香。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酸菜炒过才不涩，配饭更香。，看准状态再往下做。",
      "visual_cue": "酸菜松散，颜色微深"
    },
    {
      "n": 8,
      "text": "米饭盛进碗里，摆上排骨和酸菜，撒白胡椒粉。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "饭要热，排骨香才透出来。，看准状态再往下做。",
      "visual_cue": "饭白肉金，酸菜翠黄"
    }
  ],
  "tips": [
    "大排要锤松，炸后才不韧。，这一点很关键。",
    "先拍粉再裹蛋，炸衣才不脱。，这一点很关键。",
    "炸好静置两分钟，肉汁才回稳。，这一点很关键。"
  ],
  "common_mistakes": [
    "不锤直接炸，肉片缩成硬块。，这一点很关键。",
    "油温太低，炸衣全掉在锅里。，这一点很关键。",
    "炸完立刻切，肉汁流一盘子。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪大排",
      "substitute": "鸡腿排",
      "ratio": "400 克:400 克",
      "note": "更嫩，炸的时间减两分钟。"
    },
    {
      "original": "红薯淀粉",
      "substitute": "玉米淀粉",
      "ratio": "50 克:50 克",
      "note": "外壳稍薄，酥度略减。"
    }
  ],
  "variations": [
    "淋一勺卤汁在饭上，更入味。，这一点很关键。",
    "撒椒盐，做成椒盐排骨饭。，这一点很关键。"
  ],
  "serving_suggestion": "一人一碗米饭，配一碗味噌汤。，这一点很关键。",
  "storage": "排骨冷藏两天，复热用烤箱两百度八分钟。",
