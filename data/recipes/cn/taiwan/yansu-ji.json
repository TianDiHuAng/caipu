  "equipment": [
    "炒锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成三厘米见方的块，大小尽量一致。",
      "time_min": 12,
      "heat": "无火",
      "tip": "块小一点更容易炸透。",
      "visual_cue": "鸡块大小均匀、肉质完整"
    },
    {
      "n": 2,
      "text": "鸡块加生抽、料酒、白糖、盐、白胡椒与五香粉抓匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "腌料要抓进肉里，才有底味。",
      "visual_cue": "鸡块上色均匀、碗底见少量汁"
    },
    {
      "n": 3,
      "text": "打入蛋液抓拌到完全吸收，腌二十分钟入味。",
      "time_min": 20,
      "heat": "无火",
      "tip": "蛋液能让粉粘得更牢。",
      "visual_cue": "鸡块表面湿亮、不见流动蛋液"
    },
    {
      "n": 4,
      "text": "九层塔摘取嫩叶洗净，用厨房纸吸干表面水分备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "叶子带水下锅会剧烈炸油。",
      "visual_cue": "叶片干爽、无水滴"
    },
    {
      "n": 5,
      "text": "鸡块放入红薯淀粉中，逐块按压裹匀后静置回潮三分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "回潮后炸出来外皮才不脱。",
      "visual_cue": "鸡块表面挂满干粉、不见湿斑"
    },
    {
      "n": 6,
      "text": "锅中倒植物油烧到六成热，逐块下鸡块中小火炸四分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "分批下锅，油温才不骤降。",
      "visual_cue": "鸡块浮起、外壳浅金黄"
    },
    {
      "n": 7,
      "text": "捞出鸡块沥油，把油温升到八成热准备复炸。",
      "time_min": 2,
      "heat": "大火",
      "tip": "复炸是酥脆的关键一步。",
      "visual_cue": "油面微微冒烟、泛起细纹"
    },
    {
      "n": 8,
      "text": "鸡块倒回植物油中复炸四十秒，捞出沥净油分。",
      "time_min": 1,
      "heat": "大火",
      "tip": "复炸时间短，久了肉会干。",
      "visual_cue": "外壳金黄酥硬、油滴清亮"
    },
    {
      "n": 9,
      "text": "锅中留少许底油，下蒜末与姜片小火炒出香味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末炒到微黄最香。",
      "visual_cue": "蒜末金黄、香气散出"
    },
    {
      "n": 10,
      "text": "关火下九层塔叶炸十秒，与鸡块同炒并撒椒盐粉。",
      "time_min": 1,
      "heat": "小火",
      "tip": "叶子一脆就出锅，久炒会发黑。",
      "visual_cue": "叶片墨绿酥脆、鸡块挂满椒盐"
    }
  ],
  "tips": [
    "用鸡腿肉比鸡胸更嫩，不易炸干。",
    "红薯淀粉炸出的外壳比玉米淀粉更酥。",
    "椒盐可以自己用盐与白胡椒小火炒香。"
  ],
  "common_mistakes": [
    "油温太低就下鸡块，外壳吸油发软。",
    "一次下太多鸡块，油温骤降粘成一团。",
    "九层塔带着水下锅，油花会四处飞溅。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "500g 对 500g",
      "note": "肉质更瘦，腌时多加一勺油。"
    },
    {
      "original": "九层塔",
      "substitute": "罗勒",
      "ratio": "20g 对 20g",
      "note": "香气相近，甜味略重。"
    }
  ],
  "variations": [
    "撒一把炸过的蒜酥，台湾夜市味更足。",
    "加辣椒粉与花椒粉同撒，做成麻辣版。"
  ],
  "serving_suggestion": "刚出锅最酥，趁热撒椒盐吃最香。",
  "storage": "冷藏可放两天，复热用空气炸锅一百八十度烤五分钟。",
