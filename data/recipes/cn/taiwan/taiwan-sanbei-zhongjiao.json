    "菜刀",
    "厨纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼去内脏与软骨，撕掉外层薄膜，洗净后切成两厘米宽的圈。",
      "time_min": 8,
      "heat": "无火",
      "tip": "外膜撕干净，口感才不韧。",
      "visual_cue": "鱿鱼圈均匀、表面白净"
    },
    {
      "n": 2,
      "text": "鱿鱼圈用厨纸吸干水分，加一勺米酒抓匀腌五分钟去腥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水分吸干，煸的时候才不会出水。",
      "visual_cue": "鱿鱼圈干爽不滴水"
    },
    {
      "n": 3,
      "text": "炒锅下芝麻油，冷油放姜片与大蒜，小火慢煸到姜片边缘卷曲。",
      "time_min": 4,
      "heat": "小火",
      "tip": "冷油慢煸，麻油才不会发苦。",
      "visual_cue": "姜片卷边、蒜粒微黄"
    },
    {
      "n": 4,
      "text": "转大火倒入鱿鱼圈，快速翻炒到卷曲变白，加小米辣同炒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "鱿鱼一遇高温就卷，炒久了变橡皮。",
      "visual_cue": "鱿鱼卷曲、颜色转乳白"
    },
    {
      "n": 5,
      "text": "沿锅边淋入米酒与生抽，加白糖，转中小火烧两分钟收汁。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "汁收到挂身即停，收干会咸。",
      "visual_cue": "酱汁浓亮、鱿鱼裹色"
    },
    {
      "n": 6,
      "text": "关火前抓一把九层塔丢进锅里，用余温拌到叶片微塌即起锅。",
      "time_min": 1,
      "heat": "无火",
      "tip": "九层塔最后放，香气才不散。",
      "visual_cue": "叶片翠绿微塌、香气浓"
    }
  ],
  "tips": [
    "鱿鱼下锅前一定要擦干，避免麻油飞溅。",
    "三杯比例可按口味调整，麻油别减太多。",
    "三杯的比例可按口味微调，但麻油别减太多。"
  ],
  "common_mistakes": [
    "鱿鱼久炒不收手，肉质变得像橡皮筋。",
    "麻油大火烧到冒烟，整锅带焦苦味。",
    "九层塔一开始就下锅，炒成黑叶子。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "小管",
      "ratio": "450g 对 450g",
      "note": "小管肉更厚，翻炒时间加一分钟。"
    },
    {
      "original": "米酒",
      "substitute": "绍兴黄酒",
      "ratio": "30ml 对 30ml",
      "note": "黄酒偏甜，白糖减到 5g。"
    }
  ],
  "variations": [
    "加几片杏鲍菇同烧，吸汁后很下饭。",
    "喜欢辣的可把小米辣加倍，做成麻辣三杯。"
  ],
  "serving_suggestion": "连汁带料盛进砂锅，配白饭或啤酒都合适。",
  "storage": "冷藏一天，复热用炒锅大火快炒一分钟。",
