  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "黄豆",
          "name_en": "soybean",
          "amount": 200,
          "unit": "g",
          "note": "提前泡发",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1400,
          "unit": "ml",
          "note": "打浆与煮制",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "吉利丁",
          "name_en": "gelatin",
          "amount": 10,
          "unit": "g",
          "note": "凝固用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 70,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "红豆",
          "name_en": "adzuki bean",
          "amount": 120,
          "unit": "g",
          "note": "煮软作配料",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "搅拌机",
    "汤锅",
    "滤布",
    "模具"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄豆提前用清水泡八小时，泡到豆瓣掰开变平没有硬心。",
      "time_min": 480,
      "heat": "无火",
      "tip": "泡透才好打浆，出浆率也高。",
      "visual_cue": "豆粒饱满，掰开无硬芯"
    },
    {
      "n": 2,
      "text": "泡好的黄豆加清水放进搅拌机，打成细腻的生浆液。",
      "time_min": 6,
      "heat": "无火",
      "tip": "分两次打，浆才够细。",
      "visual_cue": "浆液乳白，几乎无颗粒"
    },
    {
      "n": 3,
      "text": "浆液倒进滤布中挤出豆渣，滤出顺滑的浓浆液。",
      "time_min": 8,
      "heat": "无火",
      "tip": "滤两遍口感更细。",
      "visual_cue": "滤出的浆液顺滑无渣"
    },
    {
      "n": 4,
      "text": "浆液倒进汤锅中火加热，边煮边搅防止糊底。",
      "time_min": 10,
      "heat": "中火",
      "tip": "一定要搅拌，浆液极易糊锅。",
      "visual_cue": "浆液翻滚，表面浮起泡沫"
    },
    {
      "n": 5,
      "text": "煮沸后转小火再煮五分钟，彻底煮透后撇去浮沫。",
      "time_min": 5,
      "heat": "小火",
      "tip": "浆液必须煮透，生浆液不能喝。",
      "visual_cue": "泡沫消失，豆香浓郁"
    },
    {
      "n": 6,
      "text": "吉利丁用冷水泡软，捞出挤干水分后放进热浆液里搅化。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁浆液温热加入才好融化。",
      "visual_cue": "吉利丁完全化开，无胶粒"
    },
    {
      "n": 7,
      "text": "加入白糖搅到化开，再把浆液过筛一遍后分装进小碗。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛去掉气泡，成品才细滑。",
      "visual_cue": "浆液细腻，表面无浮沫"
    },
    {
      "n": 8,
      "text": "小碗放凉后冷藏三小时，凝固成颤动的豆花。",
      "time_min": 180,
      "heat": "无火",
      "tip": "冷藏够时间才会成形。",
      "visual_cue": "轻晃小碗，豆花微微颤动"
    },
    {
      "n": 9,
      "text": "红豆加白糖与少量清水小火煮二十分钟到软糯。",
      "time_min": 20,
      "heat": "小火",
      "tip": "红豆提前泡软，煮起来更快。",
      "visual_cue": "红豆软糯，糖水浓稠"
    },
    {
      "n": 10,
      "text": "豆花上舀一勺蜜红豆和少量糖水，冰镇后食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "现做现吃，放久会出水。",
      "visual_cue": "豆花细滑，糖水清亮"
    }
  ],
  "tips": [
    "黄豆要泡到完全没有硬心，浆液才出得足。",
    "浆液必须彻底煮沸之后再用来做豆花。",
    "吉利丁趁热化开，豆花凝固才够均匀。"
  ],
  "common_mistakes": [
    "浆液没煮透就做豆花，吃了容易闹肚子。",
    "吉利丁没泡软直接下锅，成品会有胶粒。",
    "冷藏时间不够，豆花凝不起来还是液体。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "绿豆",
      "ratio": "120 克:120 克",
      "note": "口感更清爽，糖可多加十克。"
    },
    {
      "original": "吉利丁",
      "substitute": "琼脂",
      "ratio": "10 克:6 克",
      "note": "口感更脆，凝固力更强。"
    }
  ],
  "variations": [
    "糖水换成黑糖水，香气会更浓郁。",
    "表面加一勺花生碎，口感更有层次。"
  ],
  "serving_suggestion": "冰镇后配蜜红豆，夏天当甜品最解暑。",
  "storage": "冷藏两天内吃完，表面盖膜防结皮。",
  "nutrition_estimate": {
    "basis": "每份约 300 克",
