  "steps": [
    {
      "n": 1,
      "text": "苦瓜对半剖开，用勺子刮净内瓤和白膜，切成两毫米薄片。",
      "time_min": 9,
      "heat": "无火",
      "tip": "白膜是苦味的来源，刮干净苦味能减一半。",
      "visual_cue": "瓜片薄透，内壁干净无白絮"
    },
    {
      "n": 2,
      "text": "苦瓜片加两克盐抓匀腌十分钟，挤掉渗出的苦水再冲洗一遍。",
      "time_min": 12,
      "heat": "无火",
      "tip": "抓盐出水能带走大部分苦味，别省这一步。",
      "visual_cue": "瓜片变软，挤出的水发绿"
    },
    {
      "n": 3,
      "text": "咸蛋黄蒸五分钟至凝固，用刀面压成细碎末备用。",
      "time_min": 6,
      "heat": "大火",
      "tip": "蒸过的咸蛋黄才压得散，冷蛋黄会结块。",
      "visual_cue": "蛋黄碎沙松，颜色橙红"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，下苦瓜片大火翻炒三分钟至断生盛出。",
      "time_min": 5,
      "heat": "大火",
      "tip": "苦瓜先单独炒到断生，回锅时才不出水。",
      "visual_cue": "瓜片边缘透明，颜色转深绿"
    },
    {
      "n": 5,
      "text": "锅内留底油小火下蒜末和咸蛋黄末，慢慢炒到起泡冒沙。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋黄必须小火炒到起泡，这样才裹得住瓜片。",
      "visual_cue": "蛋黄起密集泡沫，油色变橙"
    },
    {
      "n": 6,
      "text": "倒回苦瓜片大火翻炒，让蛋黄均匀裹上，加盐和白胡椒调味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "这一步要快，蛋黄炒久了会发干发硬。",
      "visual_cue": "瓜片表面挂满橙金色的蛋黄沙"
    },
    {
      "n": 7,
      "text": "沿锅边淋一圈米酒，撒上葱花翻匀立即关火装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "米酒沿锅边下，酒气挥发只留香不留酸。",
      "visual_cue": "葱花翠绿，盘底金光点点"
    }
  ],
  "tips": [
    "苦瓜去瓤一定要刮到见白肉，那层白膜最苦。用勺子背刮比刀削干净得多。",
    "咸蛋黄要炒到起泡冒沙才能裹住瓜片，这一步急不得，小火慢炒两分钟见泡。",
    "苦瓜先单独炒断生盛出，最后再回锅裹蛋黄。一起炒的话瓜片出水，蛋黄裹不上。",
    "选绿皮粗纹的苦瓜，苦味适中口感脆。白玉苦瓜太软，炒完容易化成糊。"
  ],
  "common_mistakes": [
    "苦瓜切片直接下锅，整盘苦得下不了口。腌盐挤水这一步不能省。",
    "咸蛋黄没蒸就压，结成一坨坨的硬块。必须蒸熟或烤熟再压碎。",
    "蛋黄大火炒，十秒钟就焦黑发苦。全程小火慢炒，看到起泡才算到位。",
    "盐放多了，咸蛋黄本身就有咸味。调味前先尝一口再决定加不加盐。"
  ],
  "substitutions": [
    {
      "original": "咸蛋黄",
      "substitute": "咸蛋",
      "ratio": "60克:1个约55克",
      "note": "需自行分离取黄，咸度略高。"
    },
    {
      "original": "苦瓜",
      "substitute": "山苦瓜",
      "ratio": "500克:450克",
      "note": "苦味更重，腌盐时间延长五分钟。"
    }
  ],
  "variations": [
    "加一把泡软的虾米同炒，鲜味更上一层。台式热炒店的常见做法。",
    "苦瓜换成杏鲍菇或南瓜，做成金沙杏鲍菇，口感更讨喜。孩子也能吃。",
    "加半勺辣椒碎炒出红油，做成金沙辣苦瓜。下饭程度直接翻倍。"
  ],
  "serving_suggestion": "趁热装盘，橙黄金沙裹着翠绿瓜片，配白饭能多吃一碗，也是台式热炒店最受欢迎的下酒菜之一。",
  "storage": "冷藏可放一天，复热用炒锅小火加一勺水翻热；不建议微波，蛋黄会变干发散。",
