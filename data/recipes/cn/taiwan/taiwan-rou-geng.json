  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "碗",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊逆纹切成粗条，加生抽和白糖抓匀腌十分钟。",
      "time_min": 14,
      "heat": "无火",
      "tip": "逆纹切，肉条才嫩不塞牙。，看准状态再往下做。",
      "visual_cue": "条状均匀，表面发亮"
    },
    {
      "n": 2,
      "text": "腌好的肉条裹一层红薯淀粉，静置五分钟。，看准状态再往下做。",
      "time_min": 7,
      "heat": "无火",
      "tip": "裹粉后静置，煮时才不脱浆。，看准状态再往下做。",
      "visual_cue": "表面干粉，手感滑，这一点很关键。"
    },
    {
      "n": 3,
      "text": "香菇泡发后切细丝，笋切成同样的丝。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丝要粗细一致，口感才协调。，看准状态再往下做。",
      "visual_cue": "丝条匀整，颜色分明"
    },
    {
      "n": 4,
      "text": "汤锅倒清水烧开，下香菇丝和笋丝煮五分钟。，看准状态再往下做。",
      "time_min": 8,
      "heat": "中火",
      "tip": "先煮配料出鲜，汤底才有层次。，看准状态再往下做。",
      "visual_cue": "汤色微黄，香气升起"
    },
    {
      "n": 5,
      "text": "转小火，把肉条一条条下锅不要粘连。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "一条条下，肉条才不粘成团。，看准状态再往下做。",
      "visual_cue": "肉条分散，汤面轻沸"
    },
    {
      "n": 6,
      "text": "肉条浮起后煮三分钟，撇去表面浮沫。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "浮沫撇净，汤才清不腥。，看准状态再往下做。",
      "visual_cue": "汤清见底，肉条洁白"
    },
    {
      "n": 7,
      "text": "红薯淀粉加水调匀，慢慢淋入勾芡。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "边淋边搅，芡汁才不结块。，看准状态再往下做。",
      "visual_cue": "汤呈薄糊，勺背挂汁"
    },
    {
      "n": 8,
      "text": "加盐、香醋和白胡椒粉调味，撒香菜淋香油。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "醋最后放，酸香才不挥发。，看准状态再往下做。",
      "visual_cue": "汤色清亮，香菜翠绿"
    }
  ],
  "tips": [
    "肉条裹红薯淀粉，口感才滑嫩。，这一点很关键。",
    "勾芡边淋边搅，芡汁才顺滑。，这一点很关键。",
    "醋最后放，酸味才留得住。，这一点很关键。"
  ],
  "common_mistakes": [
    "肉条一起下锅，粘成一大团。，这一点很关键。",
    "芡粉一次倒完，结成一坨。，这一点很关键。",
    "醋早放，酸味全跑光。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "350 克:350 克",
      "note": "更清淡，腌时多加一勺油。"
    },
    {
      "original": "笋",
      "substitute": "茭白",
      "ratio": "100 克:100 克",
      "note": "口感更嫩，煮的时间减两分钟。"
    }
  ],
  "variations": [
    "加面或米粉，做成肉羹面。，这一点很关键。",
    "放一点沙茶酱，风味更浓。，这一点很关键。"
  ],
  "serving_suggestion": "配一碗卤肉饭，就是标准台湾套餐。",
  "storage": "冷藏两天，复热小火加热并补少量水。",
