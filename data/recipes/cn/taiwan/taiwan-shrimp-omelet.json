  "equipment": [
    "平底锅",
    "碗",
    "打蛋器",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁从背部开刀挑净肠线，加盐和白胡椒抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "把背部那条肠线挑干净，腥味就能少掉一半。",
      "visual_cue": "虾仁卷曲，表面发亮"
    },
    {
      "n": 2,
      "text": "淀粉加清水调成稀粉浆，鸡蛋打散后与粉浆混合。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉浆要调稀一点，煎出来才嫩滑。",
      "visual_cue": "浆液顺滑，无颗粒"
    },
    {
      "n": 3,
      "text": "平底锅放一半植物油中火烧热，下处理好的虾仁煎到两面变红。",
      "time_min": 5,
      "heat": "中火",
      "tip": "虾仁先煎一煎定型，裹进蛋液才不会沉底。",
      "visual_cue": "虾仁变红，卷曲起来"
    },
    {
      "n": 4,
      "text": "倒入调好的蛋粉浆，转中小火让浆液铺满整个锅底。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "转成小火再倒粉浆，锅底才不容易煎焦。",
      "visual_cue": "浆液铺平，边缘定型"
    },
    {
      "n": 5,
      "text": "撒上葱花，煎三分钟到底面金黄，用锅铲翻面再煎两分钟。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "翻面动作要快，用盘子扣住翻更完整。",
      "visual_cue": "两面金黄，边缘微焦"
    },
    {
      "n": 6,
      "text": "生抽、番茄酱和白糖调成蘸酱，淋在煎好的蛋饼上即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蘸酱提前调好，趁热吃口感最好。",
      "visual_cue": "酱色红亮，蛋饼软嫩"
    }
  ],
  "tips": [
    "粉浆调稀一点，煎出来才滑嫩不硬。",
    "虾仁先煎定型，裹进蛋液里才不会沉底。",
    "翻面时用盘子扣住翻，整片不会破。"
  ],
  "common_mistakes": [
    "粉浆太稠，煎出来像一块硬面饼。",
    "火太大下浆，底部焦了中间还是生的。",
    "翻面翻得太急，整片蛋饼散成碎块。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鱿鱼丁",
      "ratio": "300 克:300 克",
      "note": "口感更弹，煎的时间延长一分钟。"
    },
    {
      "original": "番茄酱",
      "substitute": "甜辣酱",
      "ratio": "30 克:30 克",
      "note": "风味道地，甜度略高。"
    }
  ],
  "variations": [
    "加一把豆芽一起煎，口感会更清爽。",
    "出锅撒一层柴鱼片，鲜味会更加突出。"
  ],
  "serving_suggestion": "趁热切块，淋上红亮的蘸酱，是台湾夜市里最受欢迎的现煎小吃之一。",
  "storage": "现煎现吃最好，冷藏一天复热用平底锅小火两面各煎一分钟。",
