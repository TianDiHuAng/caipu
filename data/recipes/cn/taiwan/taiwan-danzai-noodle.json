  "equipment": [
    "炒锅",
    "汤锅",
    "漏勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "炒锅放植物油，下大蒜末小火炒到边缘微微发黄。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末炒黄就够，焦了整锅会发苦。",
      "visual_cue": "蒜末金黄，油带蒜香"
    },
    {
      "n": 2,
      "text": "倒入猪肉末中火煸炒，炒到肉色变白且颗粒散开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉末要炒散，别让它们结成一团大块。",
      "visual_cue": "肉末松散，锅里有油光"
    },
    {
      "n": 3,
      "text": "加生抽、料酒和白糖炒匀，倒入一半清水焖十分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "加水后小火焖，肉燥才入味不干柴。",
      "visual_cue": "肉燥油亮，汤汁浓稠"
    },
    {
      "n": 4,
      "text": "另起汤锅烧开水，把面条下锅煮到刚刚断生为止。",
      "time_min": 5,
      "heat": "大火",
      "tip": "面煮到中间还有一点白芯就捞，泡汤才不烂。",
      "visual_cue": "面条能夹断，中心略有白点"
    },
    {
      "n": 5,
      "text": "同一锅水烫熟豆芽和虾仁，各烫一分钟捞出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "虾仁变红卷曲就捞，久煮会变硬。",
      "visual_cue": "虾仁卷曲变红，豆芽脆挺"
    },
    {
      "n": 6,
      "text": "碗底放豆芽，放上面条，浇上肉燥再加盐调味。",
      "time_min": 3,
      "heat": "无火",
      "tip": "清水烧开再浇，汤面清爽不油腻。",
      "visual_cue": "汤面有油花，肉燥铺在中央"
    },
    {
      "n": 7,
      "text": "摆上虾仁，撒大蒜末和香菜，趁热拌匀就可以开吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "上桌前再撒香菜，香气最足也最好看。",
      "visual_cue": "虾仁红亮，香菜翠绿"
    }
  ],
  "tips": [
    "肉燥小火焖十分钟，味道才渗进肉里。",
    "面条煮到略硬就捞，泡汤后口感刚好。",
    "虾仁烫到卷曲立刻捞出，久煮发硬。"
  ],
  "common_mistakes": [
    "肉末下锅不炒散，最后结成一团大块。",
    "面煮太软再泡汤，端上桌就烂了。",
    "汤底全用焖肉燥的浓汁，整碗油腻发腻。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡肉末",
      "ratio": "150 克:150 克",
      "note": "更清爽，需多加五毫升生抽。"
    },
    {
      "original": "虾仁",
      "substitute": "鲜虾",
      "ratio": "100 克:150 克",
      "note": "需自行剥壳去虾线。"
    }
  ],
  "variations": [
    "加一颗卤蛋和几片贡丸，做成更丰盛的版本。",
    "汤底换成大骨高汤，整体鲜味会更厚一些。"
  ],
  "serving_suggestion": "趁热吃，配一碟烫青菜和卤蛋就是台南的一餐。",
  "storage": "肉燥冷藏三天，面条现煮现吃不宜存放。",
