  "steps": [
    {
      "n": 1,
      "text": "丝瓜削去外皮，切掉两端，再切成三厘米见方的滚刀块备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "外皮要削得干净，留青筋会发苦发硬。",
      "visual_cue": "瓜肉白皙，切面湿润微微透光"
    },
    {
      "n": 2,
      "text": "姜切成细丝，枸杞用温水泡两分钟后捞出沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "姜丝切得细才出味，粗姜条会抢口感。",
      "visual_cue": "姜丝细如发，色泽淡黄"
    },
    {
      "n": 3,
      "text": "炒锅小火倒香油，下姜丝慢煸两分钟至姜丝卷曲出香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "香油怕大火，一冒烟就发苦，全程小火。",
      "visual_cue": "姜丝卷边，油面香气上冲"
    },
    {
      "n": 4,
      "text": "转中火倒入丝瓜块翻炒一分钟，让每块都裹上一层香油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "丝瓜先裹油再盖盖焖，才不出水不发黑。",
      "visual_cue": "瓜块表面油亮，边缘微透"
    },
    {
      "n": 5,
      "text": "沿锅边淋米酒，盖盖小火焖五分钟至丝瓜软塌出汁。",
      "time_min": 7,
      "heat": "小火",
      "tip": "盖盖焖是让丝瓜自己出水，不用加水。",
      "visual_cue": "锅内积起乳白瓜汁，瓜块塌软"
    },
    {
      "n": 6,
      "text": "加盐和泡好的枸杞翻匀，再煮一分钟关火连汁盛碗。",
      "time_min": 3,
      "heat": "小火",
      "tip": "枸杞一定要最后再放，久煮会烂成渣。",
      "visual_cue": "汤汁乳白，枸杞红艳饱满"
    }
  ],
  "tips": [
    "丝瓜本身水分足，全程不要加水。盖盖焖出来的瓜汁才是这道菜的精华，拌饭特别香。",
    "香油要用小火慢慢煸姜，油温一高就出苦味。看到姜丝卷边发黄就是最佳状态。",
    "丝瓜削皮后容易氧化发黑，切好马上下锅。要放一会儿就先泡淡盐水。",
    "丝瓜不要炒到完全化成水，七八分软就够了。留一点口感，吃起来才有层次。"
  ],
  "common_mistakes": [
    "大火烧香油，油一冒烟整锅发苦。香油必须小火，见油烟就说明已经过头。",
    "炒丝瓜先加水，煮成一锅寡淡的汤。丝瓜靠自身水分出汁，加水就废了。",
    "姜丝省掉只用蒜，风味完全不同。麻油丝瓜的香全靠姜，蒜替代不了。",
    "丝瓜削皮留青筋，吃起来发柴带涩。削到见白肉为止才够嫩。"
  ],
  "substitutions": [
    {
      "original": "丝瓜",
      "substitute": "蒲瓜",
      "ratio": "600克:600克",
      "note": "口感更软，焖的时间缩短两分钟。"
    },
    {
      "original": "香油",
      "substitute": "苦茶油",
      "ratio": "30毫升:30毫升",
      "note": "香气更清，台湾客家常见做法。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同焖，做成麻油丝瓜粉丝。汤汁全被粉丝吸走，一锅就够一顿饭。",
    "起锅前打一个鸡蛋进去搅散，做成蛋花丝瓜汤。蛋白质上来了，老人孩子都合适。",
    "换成麻油川七或麻油红凤菜，是台湾坐月子餐桌上的经典组合。"
  ],
  "serving_suggestion": "连汤汁一起盛碗，配白饭或面线都好。汤汁乳白带姜香，丝瓜软嫩清甜，夏天吃很清爽。",
  "storage": "冷藏可放一天，复热时加两勺水小火加热；丝瓜隔夜易出水发酸，建议当餐吃完。",
