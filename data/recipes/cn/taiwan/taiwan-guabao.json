  "steps": [
    {
      "n": 1,
      "text": "面粉加酵母、白糖和清水揉成光滑面团，盖布发酵。",
      "time_min": 52,
      "heat": "无火",
      "tip": "面团要揉到光滑，蒸出来才白。，看准状态再往下做。",
      "visual_cue": "面团膨胀，指压回弹"
    },
    {
      "n": 2,
      "text": "五花肉整块冷水下锅焯十分钟，捞出洗净。，看准状态再往下做。",
      "time_min": 13,
      "heat": "大火",
      "tip": "整块焯水，肉形才不散。，看准状态再往下做。",
      "visual_cue": "表面收紧，浮沫撇净"
    },
    {
      "n": 3,
      "text": "锅里放生抽、老抽、冰糖、八角和五香粉，加清水烧开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "卤汁要能没过肉块一半。，看准状态再往下做。",
      "visual_cue": "汤色红亮，香气升起"
    },
    {
      "n": 4,
      "text": "五花肉下锅小火卤四十分钟，中途翻面一次。，看准状态再往下做。",
      "time_min": 42,
      "heat": "小火",
      "tip": "小火慢卤，肥肉才糯不腻。，看准状态再往下做。",
      "visual_cue": "肉皮发亮，筷子可插"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油，下酸菜碎炒干水分。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "酸菜炒干，口感才脆不酸涩。，看准状态再往下做。",
      "visual_cue": "酸菜松散，香气下压"
    },
    {
      "n": 6,
      "text": "面团分成八份，擀成椭圆，对折后压一道印。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "对折后压印，蒸好才能张开。，看准状态再往下做。",
      "visual_cue": "面皮均匀，印痕清晰"
    },
    {
      "n": 7,
      "text": "刈包放蒸笼静置十分钟，大火蒸十二分钟。，看准状态再往下做。",
      "time_min": 23,
      "heat": "大火",
      "tip": "二次醒发后蒸，面皮才蓬松。，看准状态再往下做。",
      "visual_cue": "面皮鼓起，按压回弹"
    },
    {
      "n": 8,
      "text": "卤肉切厚片，花生碾碎，香菜切段备好。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "肉片切厚一点，夹起来才有口感。，看准状态再往下做。",
      "visual_cue": "肉片方正，肥瘦相间"
    },
    {
      "n": 9,
      "text": "刈包摊开，塞卤肉、酸菜、花生碎和香菜。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "料别塞太满，合起来才不会撑破。，看准状态再往下做。",
      "visual_cue": "包身鼓胀，料不外溢"
    }
  ],
  "tips": [
    "面团发酵到两倍大再整形，皮才松软。",
    "卤肉要小火慢卤，肥肉才化口不腻。",
    "酸菜先炒干水，夹进包里不出汤。，这一点很关键。"
  ],
  "common_mistakes": [
    "面团没发酵好，蒸出来像石头。，这一点很关键。",
    "肉卤得太干，咬下去发柴。，这一点很关键。",
    "酸菜不炒，包底被汁水泡烂。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪梅花肉",
      "ratio": "600 克:600 克",
      "note": "更瘦，卤的时间加十分钟。"
    },
    {
      "original": "花生",
      "substitute": "花生酱",
      "ratio": "50 克:40 克",
      "note": "抹一层即可，更顺滑。"
    }
  ],
  "variations": [
    "加一勺甜辣酱，甜咸更平衡。，这一点很关键。",
    "用卤牛肉替换猪肉，做成牛肉刈包。"
  ],
  "serving_suggestion": "热着吃，配一碗四神汤。，这一点很关键。",
  "storage": "刈包冷藏一天，卤肉冷藏三天；复热蒸十分钟。",
