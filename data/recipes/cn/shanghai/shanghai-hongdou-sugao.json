  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "红豆",
          "name_en": "adzuki bean",
          "amount": 250,
          "unit": "g",
          "note": "提前泡四小时",
          "optional": false
        },
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 150,
          "unit": "g",
          "note": "增加黏性",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 100,
          "unit": "g",
          "note": "分两次用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "炒豆沙与抹模",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 600,
          "unit": "ml",
          "note": "煮豆",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "方模",
    "料理机",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆先用清水浸泡四小时后加清水煮三十分钟，煮到豆粒一捏就烂。",
      "time_min": 32,
      "heat": "中火",
      "tip": "泡足时间才煮得烂，省火又不夹生。",
      "visual_cue": "豆粒开花，一捏成泥"
    },
    {
      "n": 2,
      "text": "煮好的红豆沥干水，用料理机打成粗泥，保留少量颗粒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "留一点豆粒颗粒，口感比全泥更丰富。",
      "visual_cue": "豆泥粗稠，带颗粒"
    },
    {
      "n": 3,
      "text": "炒锅放植物油，中小火下豆泥和一半白糖，翻炒十分钟收干水分。",
      "time_min": 11,
      "heat": "中小火",
      "tip": "不停翻炒防糊底，豆沙要炒到抱团。",
      "visual_cue": "豆沙抱团，铲起不掉"
    },
    {
      "n": 4,
      "text": "糯米粉加剩余白糖和一百毫升清水，搅成没有颗粒的稀糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉糊要稀一点，蒸完才软糯不硬。",
      "visual_cue": "糊体顺滑，能流动"
    },
    {
      "n": 5,
      "text": "把粉糊倒进炒好的豆沙里拌匀，成为厚实的糕糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豆沙别太热，烫的时候拌粉会结块。",
      "visual_cue": "糕糊均匀，颜色暗红"
    },
    {
      "n": 6,
      "text": "糕糊倒进抹油的方模，刮平表面，上锅大火蒸三十分钟。",
      "time_min": 32,
      "heat": "大火",
      "tip": "表面一定要刮平，蒸完切块才好看。",
      "visual_cue": "表面平整，牙签插入不粘"
    },
    {
      "n": 7,
      "text": "蒸好取出彻底放凉，切块后可直接吃或冷藏定型。",
      "time_min": 20,
      "heat": "无火",
      "tip": "必须凉透再切，热切会粘刀散块。",
      "visual_cue": "切块方正，边缘不塌"
    }
  ],
  "tips": [
    "红豆泡足四小时，煮出来才软烂起沙。",
    "豆沙要炒到抱团，否则蒸完糕体会散。",
    "彻底凉透再切块，切口才平整好看。"
  ],
  "common_mistakes": [
    "红豆泡得时间不够，煮完还有硬芯。",
    "豆沙水分太多，成品软塌不成形。",
    "热的时候切块，整块粘刀全散了。"
  ],
  "substitutions": [
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "100 克:100 克",
      "note": "颜色更深，焦香更明显。"
    },
    {
      "original": "红豆",
      "substitute": "红豆沙",
      "ratio": "250 克:300 克",
      "note": "省去煮豆步骤，糖量减半。"
    }
  ],
  "variations": [
    "加一勺桂花酱，香气更有江南味道。",
    "表面撒一层熟芝麻，增加香气与口感。"
  ],
  "serving_suggestion": "切成小方块当茶点，配一壶龙井或普洱，甜而不腻。",
  "storage": "冷藏三天，冷藏后糕体会变硬，蒸五分钟回软再吃。",
