    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾剪去虾枪虾须，挑出虾线，用清水洗净后用厨房纸充分吸干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水分吸得越干，下锅越不溅油、壳越脆。",
      "visual_cue": "虾身干爽、虾壳透亮"
    },
    {
      "n": 2,
      "text": "虾加料酒与 1g 盐抓匀，腌 5 分钟后再次吸干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "腌后回干是爆虾壳脆的关键步骤。",
      "visual_cue": "虾表面无液体残留"
    },
    {
      "n": 3,
      "text": "炒锅下 200ml 植物油烧至七成热，虾分批下锅炸 40 秒至壳红脆，捞出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油温要高，虾下锅应立刻冒大泡。",
      "visual_cue": "虾壳膨起、颜色鲜红"
    },
    {
      "n": 4,
      "text": "锅中留 15ml 底油，下姜丝与葱段爆香，加生抽、白糖、香醋与 30ml 清水烧开。",
      "time_min": 2,
      "heat": "中火",
      "tip": "本帮油爆虾的汁要甜中带咸，糖不可减。",
      "visual_cue": "汁液起小泡、葱姜香气浓"
    },
    {
      "n": 5,
      "text": "倒回虾大火翻炒 40 秒，让每只虾裹上浓汁后立即出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "回锅时间要短，久了虾肉变老。",
      "visual_cue": "虾身油亮、盘底只剩薄汁"
    }
  ],
  "tips": [
    "用中小型河虾最正宗，壳薄易爆脆、连壳可嚼。",
    "复炸一次口感更脆，但油温要升到八成热。",
    "剩下的葱油可拌面，是本帮菜的常见吃法。"
  ],
  "common_mistakes": [
    "虾带水下锅，油花四溅且虾壳软塌不脆。",
    "回锅后久炒收汁，虾肉缩水发柴。",
    "白糖放得太少，失去本帮菜浓油赤酱的甜香。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "河虾",
      "ratio": "600g 基围虾 ≈ 500g 河虾",
      "note": "河虾个头小，炸制时间减到 30 秒。"
    },
    {
      "original": "植物油",
      "substitute": "菜籽油",
      "ratio": "1:1",
      "note": "菜籽油需先烧去除生味。"
    }
  ],
  "variations": [
    "家庭简化版：减少油量到 80ml，用半煎半炸的方式，省油且同样脆。",
    "本帮宴客版：加 10g 话梅同烧，甜味更有层次。"
  ],
  "serving_suggestion": "冷吃热吃皆宜，作下酒菜或冷盘头菜。",
  "storage": "冷藏 1 天，复热用 180℃ 烤箱烤 3 分钟恢复脆度。",
