  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去骨取净肉，斜刀片成六毫米厚的鱼片，用厨房纸吸干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "片鱼刀要斜着走，鱼片才够薄且不易断。",
      "visual_cue": "鱼片半透明，厚薄均匀"
    },
    {
      "n": 2,
      "text": "鱼片加盐、绍兴酒、蛋清与淀粉抓匀，静置十分钟上浆。",
      "time_min": 8,
      "heat": "无火",
      "tip": "浆要抓到鱼片发黏，太稀下锅会脱浆。",
      "visual_cue": "鱼片表面挂一层薄浆，手感滑"
    },
    {
      "n": 3,
      "text": "锅中水烧到微沸，鱼片逐片下锅汆三十秒，捞出沥干。",
      "time_min": 6,
      "heat": "小火",
      "tip": "水面只要微微起泡，大滚会把鱼片冲散。",
      "visual_cue": "鱼片转白定型，边缘微微卷起"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油下姜丝炒香，加清水、糟卤、白糖与盐烧开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "糟卤不耐久煮，烧开后马上勾芡，香气才留得住。",
      "visual_cue": "汤汁清亮见底，糟香扑鼻而来"
    },
    {
      "n": 5,
      "text": "淋淀粉水勾薄芡，倒入鱼片轻推裹汁，撒葱段出锅。",
      "time_min": 4,
      "heat": "小火",
      "tip": "鱼片入锅只能推不能翻，铲子一压就碎。",
      "visual_cue": "芡汁透明挂鱼片，盘中不见汤水"
    }
  ],
  "tips": [
    "糟卤本身有咸味，盐要少放，尝过再补。",
    "鱼片汆水代替滑油，成品更清爽不腻。",
    "没有糟卤可用香糟加绍兴酒调开过滤后代替。",
    "勾芡要薄，芡厚了糟香全被盖住。"
  ],
  "common_mistakes": [
    "鱼片切太薄，汆水后碎成一片片。",
    "上浆没抓到发黏，下锅就脱浆成了鱼汤。",
    "水大滚才下鱼片，鱼片冲散还带腥味。",
    "糟卤早放久煮，香气全跑光只剩咸味。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "黑鱼",
      "ratio": "600克:600克",
      "note": "肉质更紧，片得薄也不易碎。"
    },
    {
      "original": "糟卤",
      "substitute": "香糟加绍兴酒",
      "ratio": "60毫升:30克加30毫升",
      "note": "需调开过滤后使用。"
    }
  ],
  "variations": [
    "加几片火腿同炒，鲜味更足，是老派做法。",
    "换成桂鱼片，肉更细，汆的时间减五秒。",
    "加一小勺糖桂花，尾韵带一点甜香。"
  ],
  "serving_suggestion": "装白盘，鱼片堆成小山，淋上芡汁，配一碗白饭，糟香清爽很适合配黄酒。",
  "storage": "冷藏可放一天，复热用蒸锅蒸三分钟，不要下锅翻炒以免鱼片碎。",
