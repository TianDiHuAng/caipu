  "equipment": [
    "汤锅",
    "剪刀",
    "漏勺",
    "保鲜盒"
  ],
  "steps": [
    {
      "n": 1,
      "text": "毛豆逐个剪去两头尖角，用清水搓洗两遍沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "剪口是为了让糟卤进去，不剪泡一夜也不入味。",
      "visual_cue": "每颗毛豆两端见小口，表面干净"
    },
    {
      "n": 2,
      "text": "清水加盐、姜片、八角与干辣椒烧开，下毛豆煮五分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煮五分钟豆子熟而仍脆，煮久了豆荚发黄变软。",
      "visual_cue": "豆荚转深绿，豆粒饱满鼓起"
    },
    {
      "n": 3,
      "text": "捞出后立刻放进冰水降温，沥干水分再装进保鲜盒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过冰水能锁住翠绿与脆感，别自然放凉。",
      "visual_cue": "豆荚颜色鲜绿，摸起来紧实"
    },
    {
      "n": 4,
      "text": "倒入糟卤与白糖拌匀，盖盖冷藏四小时以上即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷藏四小时才入味，中途翻一次更均匀。",
      "visual_cue": "糟卤浸没豆荚，闻着酒香清冽"
    }
  ],
  "tips": [
    "毛豆要买荚色翠绿、豆粒不突出的，太鼓就老了。",
    "煮的时间看豆子老嫩，嫩的四分钟就够。",
    "糟卤本身咸，煮豆的盐水别放太重。",
    "泡一晚味道更足，但豆荚会略微发黄。"
  ],
  "common_mistakes": [
    "毛豆没剪口，泡一夜里面还是淡的。",
    "煮好自然放凉，豆荚发黄发暗卖相全无。",
    "糟卤泡超过两天，豆子过咸还带苦。",
    "用煮豆的盐水直接泡糟卤，咸得下不了口。"
  ],
  "substitutions": [
    {
      "original": "糟卤",
      "substitute": "料酒加香糟",
      "ratio": "150毫升:100毫升加30克",
      "note": "需调匀过滤后再泡。"
    },
    {
      "original": "毛豆",
      "substitute": "蚕豆",
      "ratio": "500克:500克",
      "note": "带荚同样剪口，煮的时间加两分钟。"
    }
  ],
  "variations": [
    "加几粒花椒同泡，麻辣清爽，是夏日版。",
    "糟卤里加一小勺白酒，酒香更冲，回味更长。",
    "换成糟花生同泡，两小时就能吃，越嚼越香。"
  ],
  "serving_suggestion": "冷藏后连糟卤一起上桌，配冰啤酒或黄酒，是上海夏天的经典小碟。",
  "storage": "冷藏可放两天，糟卤不要反复使用；豆荚发黏或发酸即弃。",
