  "steps": [
    {
      "n": 1,
      "text": "鸭洗净沥干，剪去尾部油脂块与颈部淋巴，用厨房纸把表皮水分擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表皮越干，后面煎皮越容易上色且不爆油。",
      "visual_cue": "鸭皮干爽、按压无水分渗出"
    },
    {
      "n": 2,
      "text": "锅中下 20ml 植物油，鸭皮朝下小火煎 5 分钟至微黄，翻面再煎 3 分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "煎出部分皮下脂肪，成品不腻也更容易上色。",
      "visual_cue": "鸭皮金黄、锅底积出鸭油"
    },
    {
      "n": 3,
      "text": "下姜片、葱结、八角、桂皮、香叶炒香，烹入料酒，加生抽、老抽、冰糖与清水。",
      "time_min": 3,
      "heat": "中火",
      "tip": "冰糖先放能让酱汁更亮，颜色也更透。",
      "visual_cue": "酱汁呈深琥珀色、香气浓郁"
    },
    {
      "n": 4,
      "text": "大火烧开后转小火加 3g 盐后加盖焖 45 分钟，中途翻面两次，让鸭身均匀吸色。",
      "time_min": 46,
      "heat": "小火",
      "tip": "保持汤面微沸，火大鸭肉易柴。",
      "visual_cue": "鸭腿能轻松转动、筷子插入无血水"
    },
    {
      "n": 5,
      "text": "开盖转中火收汁，用汤勺反复把酱汁浇淋鸭身 8 分钟至浓稠挂壁。",
      "time_min": 9,
      "heat": "中火",
      "tip": "浇淋比翻动更均匀，也不会弄破鸭皮。",
      "visual_cue": "鸭身油亮发红、酱汁能挂住勺背"
    },
    {
      "n": 6,
      "text": "取出放凉 30 分钟再斩件装盘，剩余酱汁淋上。",
      "time_min": 30,
      "heat": "无火",
      "tip": "凉透再斩，切面整齐不散架。",
      "visual_cue": "切面整齐、皮与肉不分离"
    }
  ],
  "tips": [
    "酱鸭冷吃风味最好，晾凉后冷藏 2 小时再切更成型。",
    "收汁到剩约 150ml 即可，太干会发苦。",
    "剩下的酱汁可卤蛋或豆干，风味极佳。"
  ],
  "common_mistakes": [
    "大火焖煮，鸭皮破裂、肉质发柴。",
    "收汁时不停翻动，鸭皮刮破卖相变差。",
    "热的时候斩件，肉汁流失、切面毛糙。"
  ],
  "substitutions": [
    {
      "original": "鸭",
      "substitute": "鸭腿",
      "ratio": "1400g 整鸭 ≈ 900g 鸭腿",
      "note": "焖制时间减到 30 分钟，更易操作。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "60g 冰糖 ≈ 50g 白糖",
      "note": "色泽略浅，可加 5ml 老抽补色。"
    }
  ],
  "variations": [
    "家庭简化版：用电饭锅焖 40 分钟再收汁，火候更稳。",
    "苏式版：加 30g 红曲米同煮，颜色更红亮。"
  ],
  "serving_suggestion": "切块作冷盘，配黄酒；也可夹馒头或拌面。",
  "storage": "冷藏 4 天，风味随浸汁时间加深；冷冻 1 个月，解冻后蒸 10 分钟。",
