  "equipment": [
    "炒锅",
    "漏勺",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草鱼去鳞去内脏洗净，取中段横切成两厘米厚的块。",
      "time_min": 14,
      "heat": "无火",
      "tip": "鱼块厚薄一致，炸的时候才同时熟。",
      "visual_cue": "鱼块厚薄均匀，边缘整齐"
    },
    {
      "n": 2,
      "text": "鱼块用生抽、料酒、盐、姜片和小葱结抓匀，腌二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "腌够时间鱼肉才紧实，炸时不易碎开。",
      "visual_cue": "鱼块表面泛着光泽"
    },
    {
      "n": 3,
      "text": "炒锅放清水、白糖、老抽、米醋、八角和生姜片，小火熬成浓汁。",
      "time_min": 12,
      "heat": "小火",
      "tip": "汁要熬到挂勺，鱼块泡进去才入味。",
      "visual_cue": "汤汁浓稠，能挂住勺背"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到七成热，鱼块擦干水分逐块下锅。",
      "time_min": 6,
      "heat": "大火",
      "tip": "鱼块一定要擦干，带水下锅会猛烈溅油。",
      "visual_cue": "鱼块下锅立刻起密泡"
    },
    {
      "n": 5,
      "text": "中火炸四分钟到定型金黄，用漏勺捞出沥油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "刚下锅别翻动，等定型再动才不散。",
      "visual_cue": "鱼块金黄，外壳硬挺"
    },
    {
      "n": 6,
      "text": "油温升到八成热，鱼块回锅复炸一分钟到外壳酥脆。",
      "time_min": 4,
      "heat": "大火",
      "tip": "复炸让外壳更脆，泡汁后也不软塌。",
      "visual_cue": "外壳深金黄，敲着发脆"
    },
    {
      "n": 7,
      "text": "趁热把鱼块浸入熬好的浓汁里，翻动让两面裹匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热浸汁，鱼块才吸得进去味道。",
      "visual_cue": "鱼块表面挂满酱色"
    },
    {
      "n": 8,
      "text": "捞出摆盘，浇上剩余的汤汁，放凉后风味更佳。",
      "time_min": 3,
      "heat": "无火",
      "tip": "放凉之后汤汁收紧，味道会更浓。",
      "visual_cue": "鱼块油亮，酱汁微凝"
    }
  ],
  "tips": [
    "鱼块下锅前必须擦干水分，避免热油飞溅。",
    "复炸一次外壳更脆，浸汁后也不会软塌。",
    "酱汁要熬到挂勺，鱼块才吸得住味道。"
  ],
  "common_mistakes": [
    "鱼块带水下锅，油花四溅还粘锅。",
    "酱汁没熬浓就浸鱼，成品湿软不入味。",
    "炸好放凉才浸汁，鱼块吸不进味道。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲈鱼",
      "ratio": "700 克:700 克",
      "note": "刺更少，肉质更细。"
    },
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "20 毫升:20 毫升",
      "note": "酸味更冲，用量减半。"
    }
  ],
  "variations": [
    "汁里加一小块桂皮，香气更有层次。",
    "撒少许五香粉，风味更接近老上海做法。"
  ],
  "serving_suggestion": "冷盘上桌，配一碗黄酒，是本帮菜馆最常见的开胃前菜。",
  "storage": "冷藏三天，冷食风味最佳；不建议冷冻，复热会失去酥壳。",
