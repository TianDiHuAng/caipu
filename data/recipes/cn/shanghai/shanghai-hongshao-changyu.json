  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲳鱼去鳞去鳃去内脏，撕净腹腔黑膜，两面各斜划两刀，用盐抹匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腹腔那层黑膜最腥，一定要撕干净，划刀是为了入味。",
      "visual_cue": "鱼身干爽无血水，刀口整齐"
    },
    {
      "n": 2,
      "text": "用厨房纸把鱼身内外彻底擦干，静置五分钟让表皮收紧。",
      "time_min": 5,
      "heat": "无火",
      "tip": "鱼皮不干下锅必破，这一步比什么技巧都重要。",
      "visual_cue": "鱼皮干爽不黏手，鱼身挺立"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，提着鱼尾沿锅边滑入，中火煎三分钟定型。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鱼下锅后别急着动，等皮结壳再晃锅，鱼皮才不破。",
      "visual_cue": "鱼皮金黄结壳，晃动锅子鱼能滑动"
    },
    {
      "n": 4,
      "text": "用两把铲子托住鱼身轻轻翻过来，再煎三分钟到两面金黄后盛出备用。",
      "time_min": 4,
      "heat": "中火",
      "tip": "翻面用两把铲子托着翻，鱼身才不会断。",
      "visual_cue": "两面金黄均匀，鱼身完整"
    },
    {
      "n": 5,
      "text": "锅中留底油下姜片、蒜与干辣椒煸香，烹黄酒，加生抽、老抽、白糖与清水烧开。",
      "time_min": 4,
      "heat": "中火",
      "tip": "水别多，鱼已经煎熟大半，靠收汁入味就够。",
      "visual_cue": "汤汁红亮翻滚，香气散出"
    },
    {
      "n": 6,
      "text": "放回鲳鱼，加盖小火烧六分钟，中途把汤汁往鱼身上浇。",
      "time_min": 7,
      "heat": "小火",
      "tip": "用浇汁代替翻面，鱼身才完整不散，汤汁也能均匀渗进鱼肉里。",
      "visual_cue": "鱼身染上红亮酱色，汤汁减半"
    },
    {
      "n": 7,
      "text": "转大火把汤汁收到浓稠，起锅前淋几滴米醋提鲜，撒葱末就能装盘了。",
      "time_min": 2,
      "heat": "大火",
      "tip": "起锅前几滴醋，鲜味立刻跳出来，吃不出酸。",
      "visual_cue": "酱汁浓稠挂在鱼身，油亮红润"
    }
  ],
  "tips": [
    "鲳鱼选一斤左右的，太小肉薄易老，太大肉厚难熟。",
    "煎鱼前在油里撒一小撮盐，防粘效果明显。",
    "葱烤鲳鱼的升级版是加一把小葱同烧，葱香压过鱼腥。"
  ],
  "common_mistakes": [
    "鱼皮不擦干就下锅，粘锅破皮，最后成了一锅鱼碎。",
    "鱼一入锅就用铲子翻动，鱼皮整片脱落。",
    "老抽放太多又收太干，成品发黑发苦。"
  ],
  "substitutions": [
    {
      "original": "鲳鱼",
      "substitute": "黄鱼",
      "ratio": "500克:500克",
      "note": "黄鱼更嫩，烧的时间减两分钟。"
    },
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "5毫升:5毫升",
      "note": "香醋味更浓，只需三毫升即可。"
    }
  ],
  "variations": [
    "加一把小葱垫底同烧，就是本帮名菜葱烤鲳鱼，葱香浓郁。",
    "把鲳鱼换成带鱼段，同样红烧，是上海人家的常见做法。"
  ],
  "serving_suggestion": "趁热吃，酱汁拌饭极香，配一碗白粥也很合适。",
  "storage": "冷藏可存一天，复热须上锅蒸八分钟，微波会令鱼肉发硬。",
