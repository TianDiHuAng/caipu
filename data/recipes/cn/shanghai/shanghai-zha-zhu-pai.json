    "砧板",
    "三个盘子",
    "炒锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊横切成三片约一厘米厚，用肉锤两面轻轻敲松到八毫米。",
      "time_min": 5,
      "heat": "无火",
      "tip": "敲松能断纤维，但别敲破，破了炸时肉汁全跑掉。",
      "visual_cue": "肉片厚薄一致，表面出现细密凹陷"
    },
    {
      "n": 2,
      "text": "肉片加盐、白胡椒、绍兴酒与生抽抓匀，静置十分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "咸味要在这步给足，裹粉后就补不进味道了。",
      "visual_cue": "肉片表面有薄薄一层料汁"
    },
    {
      "n": 3,
      "text": "依次拍面粉、裹蛋液、压面包糠，用手轻压让糠粘牢。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面包糠要压不要撒，松散的糠一炸就掉。",
      "visual_cue": "表面裹满糠粒，边角无裸露"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到一百七十度，下猪排炸三分钟至两面金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温别太高，糠容易先焦而里面的肉还没熟透。",
      "visual_cue": "油面细密起泡，猪排浮起上色"
    },
    {
      "n": 5,
      "text": "捞出放厨房纸吸油，静置两分钟再切条，配辣酱油上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置两分钟让肉汁回收，立刻切会流失一半。",
      "visual_cue": "切面肉色浅粉，外壳不脱落"
    }
  ],
  "tips": [
    "猪排厚度控制在一厘米左右，太厚炸不透。",
    "面包糠选粗粒的，炸出来才够酥够脆。",
    "油温可用一小块面包糠试，立刻浮起就够了。",
    "切条时刀要垂直下压，别来回拉锯，糠会掉。"
  ],
  "common_mistakes": [
    "肉片没敲松纤维，炸完硬得像鞋底，咬不动。",
    "油温太低，外壳吸油发软，咬一口满嘴油。",
    "裹好糠放着等太久，糠回潮，下锅炸不酥。",
    "炸完直接切，肉汁流一盘，肉变干。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡腿肉",
      "ratio": "450克:450克",
      "note": "去骨压平，炸的时间减一分钟。"
    },
    {
      "original": "面包糠",
      "substitute": "苏打饼干碎",
      "ratio": "100克:100克",
      "note": "更酥，咸度略高需减盐。"
    }
  ],
  "variations": [
    "腌料里加一点五香粉，香气更接近老式炸猪排。",
    "改用半煎半炸，油量减到一百毫升也能成型。",
    "配一小碟辣酱油与番茄酱双拼，是上海老店的做法。"
  ],
  "serving_suggestion": "切成两指宽的条，配辣酱油与一碗罗宋汤，是上海西餐社的经典组合。",
  "storage": "冷藏可放一天，复热用烤箱两百度烤六分钟，微波会让外壳发软。",
