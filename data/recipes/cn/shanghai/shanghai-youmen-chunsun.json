  "steps": [
    {
      "n": 1,
      "text": "春笋从根部往上剥壳，削去老硬部分，切滚刀块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "根部老硬要削掉，切面见白嫩才算好。",
      "visual_cue": "笋块大小均匀，切面白净"
    },
    {
      "n": 2,
      "text": "笋块冷水下锅煮五分钟，捞出用清水冲一遍去涩。",
      "time_min": 6,
      "heat": "中火",
      "tip": "焯水能去掉草酸与涩味，这一步千万别省掉。",
      "visual_cue": "笋块微透，闻着无生涩味"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油下姜丝炒香，倒入笋块中火翻炒三分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "笋要先煸到边缘微焦，才吸得住酱汁。",
      "visual_cue": "笋块表面带浅金边，油光均匀"
    },
    {
      "n": 4,
      "text": "加生抽、老抽、冰糖、盐与清水，烧开后转小火焖十五分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "火一定要小，焖到笋入味而仍保留一点脆感。",
      "visual_cue": "汤汁转红亮，笋块微微发软"
    },
    {
      "n": 5,
      "text": "开大火收汁到浓稠挂笋，撒葱段翻匀即可出锅。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁时要不停翻动，糖分沉底很容易糊锅。",
      "visual_cue": "汁液紧裹笋块，盘底无余汤"
    }
  ],
  "tips": [
    "春笋要选笋尖紧闭、笋身沉重的，空心的就别买。",
    "焯过水再焖，涩味去得干净，口感也更脆。",
    "用冰糖比白糖好，收汁后油亮不发暗。",
    "喜欢吃辣可以加两只干辣椒同焖。"
  ],
  "common_mistakes": [
    "笋没焯水直接烧，吃出明显涩味。",
    "全程开大火，笋块外面焦了里面还生，锅也糊了。",
    "酱油一次倒太多，颜色发黑发苦。",
    "收汁收到干，笋块发干失去脆感。"
  ],
  "substitutions": [
    {
      "original": "春笋",
      "substitute": "冬笋",
      "ratio": "500克:500克",
      "note": "更嫩，焖的时间减三分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "20克:15克",
      "note": "甜度更高，色泽略浅。"
    }
  ],
  "variations": [
    "加几片火腿同焖，鲜味更上一层。",
    "加一勺猪油代替植物油，本帮风味更浓。",
    "加一小把咸菜同烧，咸鲜味更突出，很下饭。"
  ],
  "serving_suggestion": "装浅盘，笋块码整齐淋上浓汁，配白饭，是春天最下饭的一碟素菜。",
  "storage": "冷藏可放两天，复热加少量清水小火焖三分钟；笋久放会发酸，尽快吃完。",
