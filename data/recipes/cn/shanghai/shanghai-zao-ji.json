  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "保鲜盒",
    "冰水盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉用盐与绍兴酒抹匀，静置十分钟后用清水冲净。",
      "time_min": 5,
      "heat": "无火",
      "tip": "薄盐腌一下能让皮更紧实，冲净免得成品过咸。",
      "visual_cue": "鸡皮收紧，表面无余盐"
    },
    {
      "n": 2,
      "text": "清水加姜片、葱结、八角与花椒烧开，放入鸡腿肉。",
      "time_min": 5,
      "heat": "中火",
      "tip": "水必须烧开再下鸡，冷水下锅腥味跑不掉。",
      "visual_cue": "水面滚起，鸡皮立刻收紧"
    },
    {
      "n": 3,
      "text": "转小火保持微沸煮十八分钟，关火再焖五分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "全程微沸不翻滚，鸡皮才不会破，肉也更嫩。",
      "visual_cue": "鸡腿浮起，筷子插入无血水"
    },
    {
      "n": 4,
      "text": "捞出立即泡冰水十分钟至完全冷却，取出沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冰水能让鸡皮脆弹，不泡直接切就会散架。",
      "visual_cue": "鸡皮紧实发亮，按下去有弹性"
    },
    {
      "n": 5,
      "text": "倒入糟卤与白糖，冷藏六小时，取出斩件淋糟卤即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷藏六小时才入味，斩件用快刀一次到底。",
      "visual_cue": "切面白嫩带汁，糟香清冽"
    }
  ],
  "tips": [
    "糟卤别兑水，兑了就寡淡，白糖只要一点点。",
    "煮好的鸡一定要冰水激，皮才脆。",
    "鸡腿比整鸡好操作，量少也容易煮透。",
    "糟卤用过一次就不要重复泡别的食材。"
  ],
  "common_mistakes": [
    "全程大火煮，鸡皮破成一片片，肉也发柴。",
    "捞出自然冷却，鸡皮发皱颜色发暗。",
    "泡糟卤时间不够，切开里面还是白味。",
    "斩件时来回拉锯，鸡肉碎成一团。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "三黄鸡",
      "ratio": "600克:半只约700克",
      "note": "煮的时间加五分钟，需冰水激透。"
    },
    {
      "original": "糟卤",
      "substitute": "香糟加绍兴酒",
      "ratio": "200毫升:100克加100毫升",
      "note": "调开过滤后使用，香气更自然。"
    }
  ],
  "variations": [
    "加几片金华火腿同泡，咸鲜层次更浓。",
    "糟卤里加一点糖桂花，尾韵带甜香。",
    "用鸡汤代替清水来煮，鸡肉味更厚实。"
  ],
  "serving_suggestion": "斩成两厘米宽的条，码在白盘里淋糟卤，配糟毛豆与黄酒，是上海夏夜的标准开胃菜。",
  "storage": "冷藏可放两天，糟卤淹没鸡肉；切件后当餐吃完，不要反复回温。",
