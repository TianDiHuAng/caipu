  "equipment": [
    "砂锅",
    "炒锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "霉干菜用温水泡二十分钟，反复淘洗到水清，挤干切碎。",
      "time_min": 6,
      "heat": "无火",
      "tip": "霉干菜沙多，洗到水清才不硌牙，一定要挤干。",
      "visual_cue": "菜碎干爽松散，无泥沙沉底"
    },
    {
      "n": 2,
      "text": "五花肉冷水下锅，加姜片与绍兴酒煮开三分钟，捞出冲净浮沫。",
      "time_min": 8,
      "heat": "中火",
      "tip": "冷水下锅才能把血水逼出来，热水下锅肉会紧。",
      "visual_cue": "肉块表面转白，水面浮起灰沫"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下冰糖小火炒到枣红起泡，倒入五花肉翻炒上色。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖色变枣红立刻下肉，再等就发苦发黑。",
      "visual_cue": "肉块均匀裹上琥珀色糖色"
    },
    {
      "n": 4,
      "text": "加生抽、老抽、八角与清水，大火烧开后转小火焖四十分钟。",
      "time_min": 40,
      "heat": "小火",
      "tip": "水面刚没过肉，火太大汤汁很快烧干会糊底。",
      "visual_cue": "汤汁微沸冒小泡，肉块轻晃"
    },
    {
      "n": 5,
      "text": "下霉干菜拌匀再焖二十分钟至肉酥，撒葱结收汁即可。",
      "time_min": 20,
      "heat": "小火",
      "tip": "霉干菜后放才吸得住油，早放会煮成糊。",
      "visual_cue": "汤汁浓稠挂勺，肉皮透亮微颤"
    }
  ],
  "tips": [
    "霉干菜要选颜色深、闻着有陈香的，太绿的是新菜不香。",
    "糖色别炒过头，宁浅勿深，深了整锅发苦。",
    "焖的时候火要小，砂锅比铁锅更不容易糊底。",
    "剩下的汤汁拌饭极好，千万别急着倒掉。"
  ],
  "common_mistakes": [
    "霉干菜没泡透就下锅，吃出满口沙。",
    "糖色炒黑还硬着头皮下肉，整锅苦得没法吃。",
    "全程大火收汁，锅底糊了肉还硬。",
    "霉干菜一开始就下，最后煮成一团黑糊。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "600克:600克",
      "note": "肥肉少一些，需多焖十分钟。"
    },
    {
      "original": "霉干菜",
      "substitute": "梅干菜",
      "ratio": "80克:80克",
      "note": "风味相近，沙略少好洗。"
    }
  ],
  "variations": [
    "加几片香干同烧，吸油后特别香。",
    "换成排骨同烧，肉更易脱骨，时间减十五分钟。",
    "最后加一勺白糖提亮，颜色更红润。"
  ],
  "serving_suggestion": "盛在深盘里，肉块摆在菜上，配白饭与一碗清汤，是本帮家常的重头戏。",
  "storage": "冷藏可放三天，越放越入味；复热加少量清水小火焖十分钟，不要用微波。",
