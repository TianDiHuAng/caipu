  "steps": [
    {
      "n": 1,
      "text": "面条煮到八成熟，捞出过冷水后彻底沥干，拌少许植物油防粘。",
      "time_min": 5,
      "heat": "中火",
      "tip": "只煮八成熟，后面还要煎，全熟就坨了。",
      "visual_cue": "面条根根分明，表面不粘连"
    },
    {
      "n": 2,
      "text": "不粘锅倒植物油烧热，面条摊成圆饼，用铲子压平。",
      "time_min": 5,
      "heat": "中火",
      "tip": "摊成薄饼才煎得透，堆太厚中间是软的。",
      "visual_cue": "面条压平成饼，边缘整齐"
    },
    {
      "n": 3,
      "text": "小火煎六分钟至底面金黄结硬壳，翻面再煎四分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "煎的时候别频繁翻动，等结壳才翻得完整。",
      "visual_cue": "两面金黄，晃动锅面饼整体移动"
    },
    {
      "n": 4,
      "text": "另起锅炒散猪里脊丝，加香菇、生抽、老抽、白糖与清水烧开。",
      "time_min": 8,
      "heat": "中火",
      "tip": "肉丝先炒到变色再调味，肉质才嫩不发柴。",
      "visual_cue": "肉丝转白，汤汁颜色红亮"
    },
    {
      "n": 5,
      "text": "淋淀粉水勾芡，下韭黄与葱段拌匀，趁热浇在面饼上即可。",
      "time_min": 4,
      "heat": "中火",
      "tip": "韭黄最后下，翻两下就关火，久炒发黄。",
      "visual_cue": "浇头浓稠挂面，韭黄翠绿"
    }
  ],
  "tips": [
    "面条选细的碱水面，煎出来的饼更脆。",
    "面饼要压薄，厚度一厘米左右最容易外脆内软。",
    "浇头要现做现浇，面条泡久了就不脆了。",
    "没有韭黄可用蒜黄代替，香气接近。"
  ],
  "common_mistakes": [
    "面条煮太软，下锅一压就成面糊。",
    "锅里油放太少，面饼粘锅底，撕得稀碎不成形。",
    "一直大火煎，底面焦黑里面还是软的。",
    "浇头提前做好，面饼泡软失去脆感。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "虾",
      "ratio": "150克:150克",
      "note": "虾需去壳切丁，炒的时间减一分钟。"
    },
    {
      "original": "韭黄",
      "substitute": "小葱",
      "ratio": "100克:80克",
      "note": "香气略淡，用量可稍多。"
    }
  ],
  "variations": [
    "浇头换成三鲜，加虾仁与豌豆，鲜味更足。",
    "煎面饼时加一个鸡蛋液，饼更酥更香。",
    "做成小份，切成三角块，当下午茶点心更合适。"
  ],
  "serving_suggestion": "整块面饼装盘，浇头连汁浇在上面，趁脆的时候吃，配一碗清汤解腻。",
  "storage": "冷藏可放一天，复热用不粘锅小火两面各煎两分钟，微波会让面饼发韧。",
