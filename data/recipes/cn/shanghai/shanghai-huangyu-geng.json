  "steps": [
    {
      "n": 1,
      "text": "黄鱼去鳞去内脏洗净，用厨房纸吸干水分，两面各划两刀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼身必须擦干，下锅才不粘皮，也不会溅油。",
      "visual_cue": "鱼皮干爽完整，刀口整齐"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油，下姜片爆香后放鱼，中火煎至两面微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎定型再翻面，鱼肉才不散，后面拆肉也整齐。",
      "visual_cue": "两面结起金黄薄皮，鱼身完整"
    },
    {
      "n": 3,
      "text": "烹入黄酒，加清水与葱结，小火煮八分钟后把鱼捞出晾凉。",
      "time_min": 10,
      "heat": "小火",
      "tip": "汤别丢，鱼肉拆完还要倒回这锅汤里煮。",
      "visual_cue": "汤色转白，鱼眼发白凸出"
    },
    {
      "n": 4,
      "text": "鱼稍凉后用手拆下鱼肉，仔细挑净细刺，鱼皮与骨弃去。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拆肉时顺着鱼刺方向摸一遍，细刺最容易漏。",
      "visual_cue": "鱼肉成小块，指腹摸不到硬刺"
    },
    {
      "n": 5,
      "text": "鱼汤滤净回锅，加香菇丝与火腿末煮三分钟，再放回鱼肉。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鱼肉要等到最后才放回锅里，煮久了会碎成渣，汤也变浑。",
      "visual_cue": "汤面浮起香菇丝，香气变厚"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，淀粉调水勾芡，淋入蛋清推成蛋花，撒葱末与香油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋清要在勾芡后淋，蛋花才浮在汤面不沉底。",
      "visual_cue": "汤体浓滑挂勺，蛋花如雪片漂浮"
    }
  ],
  "tips": [
    "黄鱼选新鲜的，眼睛清亮、鳃色鲜红，冷冻鱼腥味重须多加姜。",
    "拆骨时可戴上手套，既防扎手又不易漏刺。",
    "加一勺猪油同煮，汤更浓白，是本帮老做法。"
  ],
  "common_mistakes": [
    "鱼不擦干就下锅煎，鱼皮粘锅撕烂，后面全是碎肉。",
    "拆肉时粗心漏刺，吃的时候卡喉咙，非常危险。",
    "芡勾太厚，羹结成块，完全失去滑润的口感。"
  ],
  "substitutions": [
    {
      "original": "黄鱼",
      "substitute": "鲈鱼",
      "ratio": "400克:400克",
      "note": "鲈鱼刺少，更适合新手操作。"
    },
    {
      "original": "火腿",
      "substitute": "金华火腿片",
      "ratio": "25克:25克",
      "note": "咸味重，盐量须减一克。"
    }
  ],
  "variations": [
    "加一把莼菜同煮，就是江南名菜莼菜黄鱼羹，滑润清鲜。",
    "把黄鱼换成鳜鱼，肉更细嫩，羹也更鲜甜。"
  ],
  "serving_suggestion": "热食最佳，作为宴席汤羹或家常配汤都合适，佐醋更提鲜。",
  "storage": "冷藏可存一天，复热须小火加两勺水慢搅，芡会变稠需补汤。",
