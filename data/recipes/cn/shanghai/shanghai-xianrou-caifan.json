  "steps": [
    {
      "n": 1,
      "text": "做米饭的米淘洗两遍后加水浸泡二十分钟，水量比平时煮饭略少一成。",
      "time_min": 20,
      "heat": "无火",
      "tip": "青菜会出水，水多了饭就烂，宁少不多。",
      "visual_cue": "米粒吸水发白，水面刚没过米"
    },
    {
      "n": 2,
      "text": "咸肉切成半厘米见方的小丁，用温水泡五分钟去掉表面浮盐。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡一泡咸度更均匀，不然一口咸一口淡。",
      "visual_cue": "肉丁肥瘦分明，水略发浑"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下咸肉丁小火煸出油脂，加姜末与黄酒炒香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "咸肉要煸出油，饭才香，但别煸干成油渣。",
      "visual_cue": "肉丁边缘微卷，锅底渗出清亮油"
    },
    {
      "n": 4,
      "text": "青菜碎下锅大火翻炒一分钟至塌软，加盐翻匀后关火。",
      "time_min": 2,
      "heat": "大火",
      "tip": "青菜只炒到半熟，靠焖饭的热度熟透，才不发黄。",
      "visual_cue": "菜叶塌软收缩，颜色深绿"
    },
    {
      "n": 5,
      "text": "把炒好的咸肉与青菜连油一起倒进煮米饭的锅里，铺平后按煮饭键。",
      "time_min": 30,
      "heat": "无火",
      "tip": "料铺在米上别搅拌，煮好再拌，米粒才分明。",
      "visual_cue": "料均匀铺满米面，不见米粒露出"
    },
    {
      "n": 6,
      "text": "跳闸后焖十分钟，开盖加猪油与葱末，用饭勺翻拌均匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "猪油最后拌入，香气最足，饭粒也更油润。",
      "visual_cue": "饭粒油亮松散，菜与肉分布均匀"
    }
  ],
  "tips": [
    "用上海青或矮脚青菜最好，梗叶分明、出水少。",
    "加几片香肠同煮，甜咸交织，是江南冬天的豪华版。",
    "锅底那层微焦的锅巴最好吃，别扔，铲下来当零嘴。"
  ],
  "common_mistakes": [
    "青菜一开始就和米同煮，焖到发黄发烂，一点口感都没有。",
    "水放多了，饭变成一锅菜粥，完全没了粒感。",
    "咸肉不泡直接下锅，成品咸得没法入口。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "香肠",
      "ratio": "120克:120克",
      "note": "香肠偏甜，盐可减到一克。"
    },
    {
      "original": "青菜",
      "substitute": "大白菜",
      "ratio": "250克:250克",
      "note": "大白菜出水多，煮饭的水须再减两成。"
    }
  ],
  "variations": [
    "改用砂锅焖，锅底能结出一层金黄锅巴，是上海人最惦记的部分。",
    "加一勺豆瓣酱同炒咸肉，咸香里带一丝辣，更适合年轻人。"
  ],
  "serving_suggestion": "趁热吃最香，配一碗紫菜蛋汤就是标准的上海家常一餐。",
  "storage": "冷藏可存两天，复热须加一勺水用蒸锅蒸十分钟，微波会令青菜发黄。",
