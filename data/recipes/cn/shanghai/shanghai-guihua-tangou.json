  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "莲藕",
          "name_en": "lotus root",
          "amount": 600,
          "unit": "g",
          "note": "选粗直中段",
          "optional": false
        },
        {
          "name": "糯米",
          "name_en": "glutinous rice",
          "amount": 150,
          "unit": "g",
          "note": "提前浸泡",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "桂花",
          "name_en": "osmanthus flower",
          "amount": 5,
          "unit": "g",
          "note": "干桂花",
          "optional": false
        },
        {
          "name": "红枣",
          "name_en": "red date",
          "amount": 60,
          "unit": "g",
          "note": "去核",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1500,
          "unit": "ml",
          "note": "煮制",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "冰糖",
          "name_en": "rock sugar",
          "amount": 120,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 60,
          "unit": "g",
          "note": "上色",
          "optional": false
        },
        {
          "name": "糖桂花",
          "name_en": "osmanthus syrup",
          "amount": 30,
          "unit": "g",
          "note": "最后淋面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "筷子",
    "牙签",
    "刀",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗后泡水两小时，捞出沥干至表面不滴水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡到手指能碾碎米粒，太硬灌不进藕孔。",
      "visual_cue": "米粒吸水饱满，捏之可碎"
    },
    {
      "n": 2,
      "text": "莲藕削皮，从一端两厘米处切开当盖，露出藕孔。",
      "time_min": 6,
      "heat": "无火",
      "tip": "藕孔里常有泥，切前先对着水冲一遍。",
      "visual_cue": "藕孔洁白，无黑泥残留"
    },
    {
      "n": 3,
      "text": "把糯米一点点灌进藕孔，边灌边用筷子戳实，装满后盖回切下的藕盖。",
      "time_min": 10,
      "heat": "无火",
      "tip": "灌到孔口齐平即可，米会膨胀，塞太满会撑裂。",
      "visual_cue": "藕孔填满不见空隙，盖片贴合"
    },
    {
      "n": 4,
      "text": "用牙签把藕盖固定四角，放入砂锅加清水、冰糖、红糖与红枣。",
      "time_min": 6,
      "heat": "中火",
      "tip": "牙签要斜着插进藕盖四角，煮的时候才不会散开。",
      "visual_cue": "藕身完整，牙签固定牢固"
    },
    {
      "n": 5,
      "text": "大火烧开转小火煮九十分钟，中途翻面一次，至藕酥糖汁浓稠。",
      "time_min": 70,
      "heat": "小火",
      "tip": "小火慢煮才酥透，水要没过藕身，少了就补热水。",
      "visual_cue": "筷子能轻松插透整段藕身"
    },
    {
      "n": 6,
      "text": "关火浸泡两小时，取出切片，淋糖桂花与锅中糖汁即可。",
      "time_min": 5,
      "heat": "无火",
      "tip": "浸泡越久颜色越红亮，冷藏过夜风味更好。",
      "visual_cue": "切片藕孔糯米饱满，糖汁挂亮"
    }
  ],
  "tips": [
    "选粗直的中段藕，孔大易灌米，两端带节的更好。",
    "糯米一定泡透，否则煮两小时还是夹生。",
    "糖汁要小火收，火大糖容易焦苦。",
    "切片前冷藏半小时，切面更整齐不散。"
  ],
  "common_mistakes": [
    "糯米没泡直接灌，煮完藕孔里还是硬芯。",
    "藕孔灌太满，煮的时候藕身裂开。",
    "一直大火猛煮，糖汁先焦发苦而藕芯还是硬的。",
    "热的时候切片，糯米散落不成形。"
  ],
  "substitutions": [
    {
      "original": "糯米",
      "substitute": "黑糯米",
      "ratio": "150克:150克",
      "note": "颜色更深，泡的时间加三十分钟。"
    },
    {
      "original": "红糖",
      "substitute": "片糖",
      "ratio": "60克:55克",
      "note": "甜度略低，冰糖可稍加。"
    }
  ],
  "variations": [
    "加一小把干桂花同煮，花香更浓。",
    "用压力锅压二十分钟代替慢煮，省时但色泽略浅。",
    "糖汁收干后裹一层，做成糖藕片当茶点。"
  ],
  "serving_suggestion": "切片码盘，淋上红亮糖汁与糖桂花，冷食更清爽，是上海年夜饭的收尾甜点。",
  "storage": "冷藏可放三天，糖汁一起保存更润；切片后加盖防串味。",
