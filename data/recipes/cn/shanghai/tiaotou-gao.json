  "name": {
    "zh": "上海条头糕",
    "en": "Shanghai Sweet Rice Stick Cake"
  },
  "cuisine": {
    "region": "cn",
    "style": "shanghai"
  },
  "category": [
    "dessert",
    "snack"
  ],
  "difficulty": 1,
  "time": {
    "prep_min": 20,
    "cook_min": 30,
    "total_min": 50
  },
  "servings": 6,
  "flavor": [
    "sweet",
    "light"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 200,
          "unit": "g",
          "note": "水磨粉更细",
          "optional": false
        },
        {
          "name": "粘米粉",
          "name_en": "rice flour",
          "amount": 60,
          "unit": "g",
          "note": "降低黏度成型",
          "optional": false
        },
        {
          "name": "红豆沙",
          "name_en": "red bean paste",
          "amount": 200,
          "unit": "g",
          "note": "细腻油豆沙",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 45,
          "unit": "g",
          "note": "和粉用",
          "optional": false
        },
        {
          "name": "桂花",
          "name_en": "osmanthus flower",
          "amount": 3,
          "unit": "g",
          "note": "糖桂花增香",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 240,
          "unit": "ml",
          "note": "调粉浆",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 10,
          "unit": "ml",
          "note": "抹模防粘",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸盘",
    "保鲜膜",
    "刮板",
    "细刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉与粘米粉混合，加白糖与清水搅成顺滑粉浆，静置十分钟让粉充分吸水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "加粘米粉是条头糕不粘牙的关键，全糯米会软塌。",
      "visual_cue": "粉浆细腻流动、盆底无沉粉"
    },
    {
      "n": 2,
      "text": "蒸盘抹一层植物油，倒入粉浆铺成约一厘米厚，盖保鲜膜中火蒸十五分钟至透明。",
      "time_min": 15,
      "heat": "中火",
      "tip": "粉浆要一次倒匀，厚薄不一会蒸出软硬不同的两层。",
      "visual_cue": "糕体半透明、表面平整无气泡"
    },
    {
      "n": 3,
      "text": "取出稍晾到温热，在糕面上均匀抹一层红豆沙，用刮板刮平。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆沙抹得越薄越匀，卷起来层次才漂亮。",
      "visual_cue": "豆沙层厚度一致、与糕体贴合"
    },
    {
      "n": 4,
      "text": "从一端慢慢卷成圆筒，边卷边轻压，让豆沙与糕体粘紧不留空隙。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用保鲜膜带住卷，手不沾糕，卷出的筒更紧实。",
      "visual_cue": "糕卷紧密圆润、两端齐平"
    },
    {
      "n": 5,
      "text": "卷好的糕条搓成直径三厘米的长条，表面刷一层糖桂花增香。",
      "time_min": 5,
      "heat": "无火",
      "tip": "桂花要刷在微温的糕上，冷了粘不住会滑落。",
      "visual_cue": "表面挂满桂花、香味清甜"
    },
    {
      "n": 6,
      "text": "用细刀切成六厘米长的段，刀口抹凉水切，摆盘时切口朝上。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切段要一刀到底，来回拉锯会把豆沙挤出来。",
      "visual_cue": "切口平整、豆沙与糕体分层清楚"
    }
  ],
  "tips": [
    "粉浆里加粘米粉比例约三比一，口感软糯又不粘牙。",
    "蒸发时间以完全透明为准，中心发白说明还没熟透。",
    "条头糕温热时最好吃，冷藏后会变硬，需回蒸软化。"
  ],
  "common_mistakes": [
    "只用糯米粉，糕体过软黏牙，卷的时候直接塌成一团。",
    "粉浆调得太稀，蒸出的糕片太薄，抹豆沙时一碰就破。",
    "豆沙抹到边缘，卷起后从两端溢出，成品卖相差。"
  ],
  "substitutions": [
    {
      "original": "红豆沙",
      "substitute": "黑芝麻馅",
      "ratio": "200g 对 180g",
      "note": "黑芝麻馅更油润，需减少桂花用量。"
    },
    {
      "original": "桂花",
      "substitute": "蜂蜜",
      "ratio": "3g 对 10g",
      "note": "用蜂蜜代替糖桂花，甜味更直接但少花香。"
    }
  ],
  "variations": [
    "把红豆沙换成枣泥，做成枣泥条头糕，甜味更厚重。",
    "糕浆里加入少量抹茶粉调色，做成双色条头糕，切面更好看。"
  ],
  "serving_suggestion": "切段摆盘，撒少许干桂花，配清茶作为下午茶点心。",
  "storage": "常温放一天，冷藏两天，食用前回蒸三分钟恢复软糯。",
