  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "烤麸",
          "name_en": "wheat gluten puff",
          "amount": 400,
          "unit": "g",
          "note": "选干烤麸，泡发后挤干水分撕成 3 厘米块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
