        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "擀面杖",
    "烤箱",
    "毛刷"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉二百五十克加酵母、白糖、清水与猪油三十克揉成光滑水油皮，盖布醒三十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "水油皮要揉到能拉出薄膜，起酥时才不破皮。",
      "visual_cue": "面团光滑有延展性、按下去缓慢回弹"
    },
    {
      "n": 2,
      "text": "余下一百五十克面粉加一百克猪油搓成油酥，抓捏成团后冷藏十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "油酥只用搓不用揉，揉出筋性烤后就不酥了。",
      "visual_cue": "油酥成团不散、手指一捏能成块"
    },
    {
      "n": 3,
      "text": "小葱绿切细，加盐与植物油拌成葱油馅，静置十分钟让葱出水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "葱绿切好先拌油再放盐，葱香更浓且不易发黑。",
      "visual_cue": "葱碎油亮、渗出少量绿色汁水"
    },
    {
      "n": 4,
      "text": "水油皮包入油酥，擀成长方形薄片，三折两次后再擀开卷成筒，切成八个剂子。",
      "time_min": 20,
      "heat": "无火",
      "tip": "每次折叠后松驰十分钟，擀开时油酥才不会挤出来。",
      "visual_cue": "面片层次分明、切面可见酥层"
    },
    {
      "n": 5,
      "text": "剂子压扁擀圆，包入一勺葱油馅收口按成椭圆，刷水蘸满芝麻。",
      "time_min": 12,
      "heat": "无火",
      "tip": "收口一定捏紧朝下放，烤时漏馅会让饼鼓不起来。",
      "visual_cue": "饼胚饱满椭圆、芝麻均匀粘满"
    },
    {
      "n": 6,
      "text": "烤箱上下火两百度预热，饼胚排入烤盘烤十八分钟至表面金黄鼓起。",
      "time_min": 18,
      "heat": "无火",
      "tip": "最后三分钟转一百八十度，防止芝麻烤焦发苦。",
      "visual_cue": "表面金黄微凸、侧面见层、轻敲有空响"
    }
  ],
  "tips": [
    "猪油是蟹壳黄酥松的核心，换黄油虽香但层次会偏硬。",
    "折叠次数不要超过三次，层次过多烤后容易散成碎屑。",
    "出炉后放网架上散热，留在烤盘里底部会被水汽闷软。"
  ],
  "common_mistakes": [
    "油酥里加水面粉，烤出的饼硬如石子，完全没有酥层。",
    "收口没捏紧，烤制中馅料外流，饼身塌陷成片。",
    "烤箱温度偏低，饼在炉内慢慢失水，成品干硬不发。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "黄油",
      "ratio": "130g 对 130g",
      "note": "黄油需冷藏后使用，起酥层次略差但奶香更重。"
    },
    {
      "original": "小葱",
      "substitute": "咸肉",
      "ratio": "40g 对 60g",
      "note": "换成咸肉丁做成咸味蟹壳黄，需减少盐量。"
    }
  ],
  "variations": [
    "馅料换成白糖拌面粉，做成甜味蟹壳黄，表面撒芝麻更香。",
    "加入一小勺猪油渣与葱一起拌馅，油香更足，接近老上海摊头味。"
  ],
  "serving_suggestion": "趁温热配一碗豆浆或咸豆浆，作为上海式早点最合适。",
  "storage": "常温密封放两天，吃前一百八十度回烤五分钟恢复酥脆。",
