          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "煎蛋皮",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 20,
          "unit": "ml",
