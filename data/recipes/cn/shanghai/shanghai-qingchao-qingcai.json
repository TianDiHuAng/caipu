    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青菜掰成单叶，用流水冲净根部的泥沙，沥干后从中间对半剖开。",
      "time_min": 6,
      "heat": "无火",
      "tip": "根部最容易藏泥，要一片片掰开冲，整棵洗不干净。",
      "visual_cue": "叶片完整无黄边，根部不见泥沙"
    },
    {
      "n": 2,
      "text": "炒锅烧到微微冒烟，倒植物油下蒜与姜丝小火爆香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "锅要烧够热再下菜，温锅冷油炒青菜必出水。",
      "visual_cue": "蒜末浮在油面，香气升起"
    },
    {
      "n": 3,
      "text": "转大火倒入青菜，快速翻炒到叶片开始塌软、颜色加深。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火不盖盖，盖了菜叶发黄出水。",
      "visual_cue": "菜叶由浅转深绿，体积明显缩小"
    },
    {
      "n": 4,
      "text": "加盐与白糖翻匀，沿锅边淋一勺清水激出蒸汽焖十秒。",
      "time_min": 1,
      "heat": "大火",
      "tip": "淋一点水让蒸汽把根部焖熟，梗才不会生硬。",
      "visual_cue": "锅中腾起白汽，菜梗转透亮"
    },
    {
      "n": 5,
      "text": "淋香油翻匀立刻出锅，装盘时把菜梗朝外码齐。",
      "time_min": 1,
      "heat": "大火",
      "tip": "出锅要快，余温还会继续加热，炒久了就发黄。",
      "visual_cue": "菜身油亮翠绿，盘底汁水很少"
    }
  ],
  "tips": [
    "青菜挑根部饱满、叶片挺立的，发蔫的炒出来只剩水。",
    "加一勺猪油代替部分植物油，上海味立刻出来。",
    "炒前把菜梗和菜叶分开，先下梗炒十秒再下叶，熟度更一致。"
  ],
  "common_mistakes": [
    "青菜洗完不沥干就下锅，油溅得满灶台，菜也变成水煮。",
    "小火慢炒，青菜出水发黄，一点脆感都没有。",
    "盖上锅盖焖，叶绿素被闷掉，成品暗黄难看。"
  ],
  "substitutions": [
    {
      "original": "青菜",
      "substitute": "菜心",
      "ratio": "350克:350克",
      "note": "菜心梗更粗，须先下梗多炒十秒。"
    },
    {
      "original": "植物油",
      "substitute": "猪油",
      "ratio": "25毫升:20克",
      "note": "猪油更香，用量可略减。"
    }
  ],
  "variations": [
    "加几片香菇同炒，菌香配菜香，是上海家常的香菇青菜。",
    "把青菜换成鸡毛菜快炒二十秒，更嫩更清甜。"
  ],
  "serving_suggestion": "趁热吃最脆嫩，作为家常配菜与红烧肉、糖醋排骨都很搭。",
  "storage": "建议当餐吃完，冷藏后复热会发黄出水，口感大打折扣。",
