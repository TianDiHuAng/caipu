  "steps": [
    {
      "n": 1,
      "text": "大白菜掰开洗净，取中间嫩心部分切成一指宽的长条，菜梗菜叶分开。",
      "time_min": 8,
      "heat": "无火",
      "tip": "嫩心比外叶甜，做上汤别用老帮子，纤维粗煮不烂。",
      "visual_cue": "菜条白绿分明，切口平整"
    },
    {
      "n": 2,
      "text": "皮蛋切成小丁，火腿切细丝，香菇切片，蒜拍碎备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "皮蛋切丁前刀上蘸点水，不会粘刀也不易碎。",
      "visual_cue": "皮蛋丁完整不糊，蛋心呈墨绿"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下蒜碎与姜片小火煸到蒜末金黄出香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜要煸到金黄，上汤的香气有一半来自这步。",
      "visual_cue": "蒜末金黄浮起，油面香气浓"
    },
    {
      "n": 4,
      "text": "下皮蛋丁、火腿丝与香菇片翻炒，加两碗清水大火烧开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "皮蛋下锅炒一下，汤色才会转白，鲜味也出来。",
      "visual_cue": "汤色转成乳白，翻滚冒泡"
    },
    {
      "n": 5,
      "text": "先放菜梗煮三分钟，再下菜叶煮两分钟至完全变软。",
      "time_min": 5,
      "heat": "中火",
      "tip": "汤滚起来之后再放菜，猛火快煮菜才碧绿，冷水下菜会发黄变软。",
      "visual_cue": "菜梗透亮发软，菜叶塌入汤中"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，撒葱段淋香油，连汤盛入深碗。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐最后放，汤的鲜味才不会被咸味压住。",
      "visual_cue": "汤色奶白，菜条浮在汤面"
    }
  ],
  "tips": [
    "加一勺猪油同煮，汤色更白更浓，是馆子里的做法。",
    "用鸡汤代替清水，鲜味直接上一个档，但要减盐。",
    "皮蛋选溏心的，切丁后更易化入汤里。"
  ],
  "common_mistakes": [
    "大白菜整棵下锅，外面烂了里面还是生的。",
    "火太小慢慢煮，汤一直清寡，出不来奶白色。",
    "煮的时间太长，菜叶化在汤里，完全失了口感。"
  ],
  "substitutions": [
    {
      "original": "大白菜",
      "substitute": "娃娃菜",
      "ratio": "500克:400克",
      "note": "娃娃菜更嫩，煮的时间各减一分钟。"
    },
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "30克:30克",
      "note": "咸肉更咸，盐量须减两克。"
    }
  ],
  "variations": [
    "把大白菜换成菠菜或豆苗，就是上海常见的上汤时蔬。",
    "加几颗干贝同煮，鲜味更厚，适合宴客时做。"
  ],
  "serving_suggestion": "连汤带菜一起上桌，作为家宴的清口菜或汤菜都合适。",
  "storage": "冷藏可存一天，复热须小火加两勺水慢煮，汤色会更浑。",
