  "equipment": [
    "炒锅",
    "汤锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切成半厘米见方的小丁，加少许盐与生抽抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "丁切得越小越入味，也和大小的面丁更协调。",
      "visual_cue": "肉丁大小一致，表面泛黏"
    },
    {
      "n": 2,
      "text": "汤锅烧开水，面条下锅煮到八分熟，捞出过凉水后切成两厘米短段。",
      "time_min": 10,
      "heat": "大火",
      "tip": "面煮八分就捞，后面还要回锅炒，煮烂了就成糊。",
      "visual_cue": "面条掰断中心略有白芯"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下牛肉丁大火煸到变色出香，盛出备用。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火快煸锁住肉汁，久炒牛肉就柴了。",
      "visual_cue": "肉丁焦边变色，锅底无血水"
    },
    {
      "n": 4,
      "text": "原锅下洋葱丁、蒜末与干辣椒炒香，加番茄丁炒到出红汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄一定要炒到化开出红汁，汤汁才裹得住面段，不然面淡肉咸。",
      "visual_cue": "番茄软塌出汁，锅中泛红"
    },
    {
      "n": 5,
      "text": "加番茄酱、辣椒粉与孜然翻匀，倒回牛肉丁，下青椒丁炒半分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "孜然要后放，靠锅里余温一激香气就冲上来了，早炒反而发苦。",
      "visual_cue": "酱汁红亮冒泡，青椒翠绿"
    },
    {
      "n": 6,
      "text": "倒入面段大火翻炒两分钟，让每段面都裹上酱汁，试味补盐。",
      "time_min": 3,
      "heat": "大火",
      "tip": "面段下锅后要不停地翻动，一停就粘锅，粘住的底马上焦黑。",
      "visual_cue": "面段油亮裹汁，锅中不见汤水"
    },
    {
      "n": 7,
      "text": "最后撒上香菜段翻匀就出锅，趁热吃面的口感最筋道也最香。",
      "time_min": 2,
      "heat": "大火",
      "tip": "香菜一烫就出香，炒久了只剩一股草气，颜色也会发暗发黄。",
      "visual_cue": "香菜翠绿，面丁分明不粘连"
    }
  ],
  "tips": [
    "面条选宽的，切段后炒不易断，口感也更筋。",
    "加一把泡软的葡萄干同炒，酸甜解辣，是南疆的做法。",
    "牛肉换羊肉更地道，膻香与孜然最配。"
  ],
  "common_mistakes": [
    "面煮到全熟再炒，回锅一翻就断成一锅面糊。",
    "番茄不炒化就下面，酱汁挂不上，面淡肉咸。",
    "火太小慢慢炒，面吸油出水，出锅一汪油。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "250克:250克",
      "note": "羊肉更膻也更香，腌时可多放洋葱。"
    },
    {
      "original": "面条",
      "substitute": "米粉",
      "ratio": "350克:350克",
      "note": "米粉不吸汁，煮的时间减两分钟。"
    }
  ],
  "variations": [
    "把面段换成揪片，就是新疆的炒揪片子，口感更厚实。",
    "加一勺豆瓣酱同炒，酱香更重，适合重口味的人。"
  ],
  "serving_suggestion": "一盘就管饱，配一碗酸奶或者一碗热砖茶解腻都正好。",
  "storage": "冷藏可存一天，复热须大火快炒，加水会令面发黏。",
