  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子切成滚刀块，撒少许盐抓匀腌十分钟，挤掉渗出的水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "先腌出水，茄子下锅就不那么吸油了。",
      "visual_cue": "茄块变软出水，颜色转深"
    },
    {
      "n": 2,
      "text": "羊肉切成薄片，加少许盐与生抽抓匀，腌五分钟让它先入个底味。",
      "time_min": 7,
      "heat": "无火",
      "tip": "薄片腌一下更嫩，炒的时候也不容易老。",
      "visual_cue": "肉片发黏上浆，边缘整齐"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，茄块下锅中火煎到表面微黄发软，盛出沥油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "茄子先煎到定型，后面回锅烧的时候才不会散架，也不至于烂成泥。",
      "visual_cue": "茄块表面金黄，边缘软塌"
    },
    {
      "n": 4,
      "text": "倒出多余油留底油，下羊肉片大火快炒至变色，盛出备用。",
      "time_min": 3,
      "heat": "大火",
      "tip": "羊肉只用大火快炒，炒久了膻味重还发柴。",
      "visual_cue": "肉片变白卷边，锅底无血水"
    },
    {
      "n": 5,
      "text": "原锅下洋葱、姜末、蒜末炒香，加番茄块炒出红汁，放番茄酱、孜然与辣椒粉。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒化汤汁才浓，茄子才挂得住味。",
      "visual_cue": "番茄化开出汁，锅中泛红"
    },
    {
      "n": 6,
      "text": "倒回茄块与羊肉片，加小半碗水小火焖八分钟，让茄子吸饱汤汁。",
      "time_min": 9,
      "heat": "小火",
      "tip": "茄子极能吃汤，水别放得太少，焖到茄块鼓胀软糯才算到位。",
      "visual_cue": "茄块鼓胀吸汁，汤汁剩一半"
    },
    {
      "n": 7,
      "text": "下青椒块大火收汁一分钟，试味补盐，撒香菜段出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "青椒断生就起锅，久炒不光发黄失脆，清香味也全跑光了。",
      "visual_cue": "汤汁浓亮裹块，青椒翠绿"
    }
  ],
  "tips": [
    "茄子选长形的紫皮茄，肉厚籽少，烧出来不苦。",
    "茄子腌后挤水再煎，能省一半油，也不腻口。",
    "加一个番茄同烧，颜色红亮，酸味解羊肉的膻。"
  ],
  "common_mistakes": [
    "茄子不腌直接下锅，吸油吸到锅干，成品一咬一嘴油。",
    "羊肉和茄子一起炖，羊肉老了，茄子烂成泥。",
    "水加太多收不干，茄子泡在汤里，味道全散了。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "250克:250克",
      "note": "牛肉更瘦，腌时可加少许油锁水。"
    },
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "450克:450克",
      "note": "西葫芦出水多，焖的时间减三分钟。"
    }
  ],
  "variations": [
    "把茄子换成豆角同烧，口感更脆，是新疆家庭的常见搭配。",
    "加一勺豆瓣酱同烧，酱香厚重，更下饭。"
  ],
  "serving_suggestion": "连汁浇在米饭上或者拌进面里都香，配一块馕蘸汤吃更是地道。",
  "storage": "冷藏可存两天，复热须小火加少许水焖三分钟。",
