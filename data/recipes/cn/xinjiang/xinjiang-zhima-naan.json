  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 500,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 5,
          "unit": "g",
          "note": "温水化开",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 25,
          "unit": "g",
          "note": "表面撒用",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 60,
          "unit": "g",
          "note": "切碎泡水取汁",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "和面调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "抹面与刷盘",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "擀面杖",
    "烤盘",
    "碗",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母与白糖用两百六十毫升温水化开，静置五分钟至表面浮起细泡。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水温摸着温不烫手最合适，烫了酵母就烫死了。",
      "visual_cue": "水面浮起一层细密的小气泡"
    },
    {
      "n": 2,
      "text": "面粉加盐拌匀，倒入酵母水揉成光滑面团，盖上湿布醒十分钟。",
      "time_min": 14,
      "heat": "无火",
      "tip": "先揉到盆光手光面光，成品的筋道全靠这一通揉，偷懒就会发硬。",
      "visual_cue": "面团光滑不粘手，按压回弹"
    },
    {
      "n": 3,
      "text": "面团移到案板继续揉五分钟，抹一层植物油，盖布发酵至两倍大。",
      "time_min": 70,
      "heat": "无火",
      "tip": "室温低的时候可以放到暖气旁边，发酵到位面团才够松软。",
      "visual_cue": "面团膨起两倍，指按留窝不回缩"
    },
    {
      "n": 4,
      "text": "洋葱碎用温水泡十分钟，滤出洋葱水，加少许盐调成刷面水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "洋葱水是表面那股焦香的关键，别省，用淡盐水代替味道就平了。",
      "visual_cue": "水色微黄，闻着有葱香"
    },
    {
      "n": 5,
      "text": "面团分成四份滚圆，用擀面杖擀成中间薄边缘厚的圆饼，用叉子在中间扎满小孔。",
      "time_min": 10,
      "heat": "无火",
      "tip": "中间扎孔防止鼓包，边缘留厚才有一圈软边。",
      "visual_cue": "饼坯中间薄透，边缘厚实隆起"
    },
    {
      "n": 6,
      "text": "饼坯表面刷洋葱水，撒满芝麻并轻压固定，静置十五分钟二次醒发。",
      "time_min": 18,
      "heat": "无火",
      "tip": "芝麻要按压一下，烤完才不会掉一烤盘。",
      "visual_cue": "芝麻均匀密布，饼坯略膨起"
    },
    {
      "n": 7,
      "text": "烤箱预热两百度，烤盘刷油放上饼坯，烤十二分钟至表面金黄鼓起。",
      "time_min": 14,
      "heat": "大火",
      "tip": "烤到边缘上色、中间鼓包就好，过火会硬得咬不动。",
      "visual_cue": "表面金黄，边缘一圈焦褐色"
    }
  ],
  "tips": [
    "和面时加两勺牛奶，成品更酥香，放凉了也不会硬得咬不动。",
    "烤好趁热刷一层薄油，表面油亮更好看。",
    "没有洋葱水可用淡盐水代替，香味略淡。"
  ],
  "common_mistakes": [
    "水太烫把酵母烫死，面团发不起来，烤出来像石头。",
    "中间不扎孔，烤的时候鼓成大球，中间空心。",
    "烤盘忘了刷油，饼一揭就碎成几块，整盘都拿不起来。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "全麦面粉",
      "ratio": "500克:500克",
      "note": "全麦吸水多，水加二十毫升。"
    },
    {
      "original": "芝麻",
      "substitute": "孜然",
      "ratio": "25克:12克",
      "note": "孜然馕更冲，是南疆的常见做法。"
    }
  ],
  "variations": [
    "在饼中间按一个窝，打入鸡蛋同烤，是喀什的早点吃法。",
    "面团里揉进牛肉末与洋葱碎，做成肉饼同烤，更接近烤包子的风味。"
  ],
  "serving_suggestion": "趁热掰开配奶茶或羊肉汤，凉了可回炉烤三分钟复脆。",
  "storage": "常温干燥处可存三天，密封冷冻可存一个月，回烤后风味接近新鲜。",
