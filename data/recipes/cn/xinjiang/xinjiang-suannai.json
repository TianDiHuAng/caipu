  ],
  "difficulty": 1,
  "time": {
    "prep_min": 15,
    "cook_min": 75,
    "total_min": 90
  },
  "servings": 4,
  "flavor": [
    "sour",
    "sweet",
    "light"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 500,
          "unit": "g",
          "note": "原味无糖",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 300,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 45,
          "unit": "g",
          "note": "调节酸甜",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "搅拌碗",
    "打蛋器",
    "玻璃杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酸奶从冰箱取出放十分钟回温，搅散成顺滑的糊状。",
      "time_min": 10,
      "heat": "无火",
      "tip": "回温后更好搅开，不易结块。",
      "visual_cue": "酸奶顺滑，无大块凝乳"
    },
    {
      "n": 2,
      "text": "牛奶倒进小锅小火加热到微温约四十度就离火。",
      "time_min": 5,
      "heat": "小火",
      "tip": "只加热到微温，煮开会破坏风味。",
      "visual_cue": "锅边冒细小气泡，手感温热"
    },
    {
      "n": 3,
      "text": "把温牛奶分三次倒进酸奶中，每次都搅到完全融合。",
      "time_min": 4,
      "heat": "无火",
      "tip": "分次加，酸奶才不会被冲散。",
      "visual_cue": "液体均匀，颜色一致"
    },
    {
      "n": 4,
      "text": "加入白糖与盐搅到完全化开，尝一下酸甜是否平衡。",
      "time_min": 2,
      "heat": "无火",
      "tip": "一点点盐能把奶香提出来。",
      "visual_cue": "甜味柔和，带轻微咸鲜"
    },
    {
      "n": 5,
      "text": "用打蛋器快速搅三十秒，让表面浮起细密泡沫。",
      "time_min": 1,
      "heat": "无火",
      "tip": "打出泡沫，口感更轻盈。",
      "visual_cue": "表面浮起一层细密泡沫"
    },
    {
      "n": 6,
      "text": "倒进玻璃杯，冷藏一小时以上，冰镇后风味更清爽。",
      "time_min": 60,
      "heat": "无火",
      "tip": "冰镇后酸甜更平衡。",
      "visual_cue": "杯壁结水雾，饮子浓稠"
    },
    {
      "n": 7,
      "text": "饮用前撒少量白糖或滴几滴蜂蜜，搅匀再喝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "喝前搅一下，糖沉底会太甜。",
      "visual_cue": "表面泡沫细密，甜味均匀"
    }
  ],
  "tips": [
    "牛奶只加热到微温，煮开会破坏酸奶风味。",
    "温牛奶分次加入，酸奶才不会被冲散。",
    "加一点点盐进去，奶香会更明显。"
  ],
  "common_mistakes": [
    "牛奶煮到滚烫直接冲进酸奶，结成一坨絮状。",
    "糖一次加太多，酸味被完全盖住。",
    "做好后常温放着，酸奶很快就会变酸。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "300 毫升:300 毫升",
      "note": "奶香更浓，甜度可略减。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "45 克:40 克",
      "note": "香气更足，需在温时加入。"
    }
  ],
  "variations": [
    "加少量柠檬汁进去，酸味会更加活泼。",
    "撒一把葡萄干或坚果碎，口感更丰富。"
  ],
  "serving_suggestion": "冰镇后倒入玻璃杯，配烤肉解腻最合适。",
  "storage": "冷藏两天内喝完，密封保存防串味。",
