      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "烤箱",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱切碎后用纱布挤出汁，汁留用，渣另放一小碟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "洋葱汁和面能让饼更软，还能延长回软时间。",
      "visual_cue": "汁液微白，渣粒均匀"
    },
    {
      "n": 2,
      "text": "洋葱汁加温水化开酵母，静置五分钟到表面起细泡。",
      "time_min": 7,
      "heat": "无火",
      "tip": "酵母先活化，面团发得才稳。",
      "visual_cue": "表面浮沫，闻着微甜"
    },
    {
      "n": 3,
      "text": "倒进面粉，加盐和二十毫升植物油，揉成偏硬的面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团要偏硬，烤出来才有嚼头不软塌。",
      "visual_cue": "面团紧实，按下去慢回弹"
    },
    {
      "n": 4,
      "text": "盖布发酵四十分钟，面团涨到一倍半大即可。",
      "time_min": 42,
      "heat": "无火",
      "tip": "饼不用发太足，发过了烤时容易鼓成大泡。",
      "visual_cue": "体积变大，内部有气孔"
    },
    {
      "n": 5,
      "text": "面团分四份，擀成一厘米厚中间薄边缘厚的圆饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "中间薄边缘厚，烤完边缘有脆边，中间不硬。",
      "visual_cue": "圆饼匀整，边缘成环"
    },
    {
      "n": 6,
      "text": "饼面刷油，撒洋葱渣、芝麻和孜然，用手指在中间按几个窝。",
      "time_min": 6,
      "heat": "无火",
      "tip": "按窝能防止烤时中间鼓包。",
      "visual_cue": "表面有窝，料粒粘牢"
    },
    {
      "n": 7,
      "text": "烤箱两百二十度预热，烤十二分钟到表面金黄鼓起。",
      "time_min": 15,
      "heat": "大火",
      "tip": "高温短烤，饼才外脆内软，低温会把水分烤干。",
      "visual_cue": "表面金黄，边缘焦香"
    },
    {
      "n": 8,
      "text": "出炉趁热刷一层薄油，盖布焖三分钟让表皮回软一点。",
      "time_min": 4,
      "heat": "无火",
      "tip": "焖一下表皮不会硬得咬不动。",
      "visual_cue": "表面油亮，按压柔软"
    }
  ],
  "tips": [
    "饼是新疆人的主食，油饼比普通饼更香也更耐放。",
    "洋葱汁别浪费，和面用掉，香气全在里头。",
    "烤好的饼盖布放凉，能存好几天。"
  ],
  "common_mistakes": [
    "面团揉得太软，烤完中间塌陷，没有该有的挺括。",
    "烤箱温度不够，饼烤成白饼，一点都不脆。",
    "不按窝直接烤，中间鼓起一个大球，切开全空。"
  ],
  "substitutions": [
    {
      "original": "芝麻",
      "substitute": "黑芝麻",
      "ratio": "20克:20克",
      "note": "黑芝麻更香，撒之前轻压一下才粘得牢。"
    },
    {
      "original": "植物油",
      "substitute": "黄油",
      "ratio": "60毫升:55克",
      "note": "黄油版奶香更重，烤温可降十度防焦。"
    }
  ],
  "variations": [
    "洋葱渣里拌一点辣椒面一起撒，做出微辣版本。",
    "面团里加一勺酸奶，饼心更松软，适合牙口不好的老人。"
  ],
  "serving_suggestion": "掰成小块配烤肉、咸奶茶，或者直接抹一层酸奶当早饭。",
  "storage": "常温布盖可存三天，冷冻一个月；复热用烤箱一百八十度烤五分钟。",
