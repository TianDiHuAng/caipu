        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 150,
          "unit": "g",
          "note": "切丝",
          "optional": false
        },
        {
          "name": "葡萄干",
          "name_en": "raisin",
          "amount": 60,
