  "equipment": [
    "炒锅",
    "汤锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "洋葱与青椒洗净，洋葱切成细丝，青椒剖开去籽切成长条备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "青椒籽要去净，残留会让整盘发苦。",
      "visual_cue": "洋葱丝散开，青椒条粗细一致"
    },
    {
      "n": 2,
      "text": "牛肉逆着纹理切成薄片，加生抽抓匀腌制十分钟让底味吃进去。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纹切才不塞牙，腌足时间肉质更松。",
      "visual_cue": "肉片薄到透光，表面挂满酱汁"
    },
    {
      "n": 3,
      "text": "番茄顶部划十字，用滚开水烫两分钟后撕掉外皮切成小块。",
      "time_min": 6,
      "heat": "中火",
      "tip": "烫到皮卷起就捞出，久烫番茄肉会发软。",
      "visual_cue": "番茄皮整片卷起剥离"
    },
    {
      "n": 4,
      "text": "汤锅加水烧开，下入面条煮到八分熟捞出，过一遍凉水沥干。",
      "time_min": 8,
      "heat": "大火",
      "tip": "八分熟就起锅，回锅还有第二次加热。",
      "visual_cue": "面条中心留一点白芯"
    },
    {
      "n": 5,
      "text": "炒锅烧热倒入植物油，下牛肉片用大火滑散，变色后立刻盛出。",
      "time_min": 4,
      "heat": "大火",
      "tip": "肉片别久炒，一变白就盛出，回锅再熟。",
      "visual_cue": "肉片卷边，锅底留红油"
    },
    {
      "n": 6,
      "text": "锅内留底油，下洋葱丝、大蒜末和番茄块，中火炒到番茄出红汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄要炒出汁才叫过油肉，干炒只是配菜。",
      "visual_cue": "番茄塌软，锅内汤汁变稠"
    },
    {
      "n": 7,
      "text": "放回牛肉片，加青椒条、盐和孜然，转大火翻炒一分钟出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "孜然最后放，早放会被炒糊发苦。",
      "visual_cue": "青椒翠绿，孜然香气扑鼻"
    },
    {
      "n": 8,
      "text": "把炒好的浇头连汤汁一起浇在面条上，用筷子挑散拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌的时候从下往上翻，酱汁才裹得均匀。",
      "visual_cue": "每根面条都挂上红汁"
    }
  ],
  "tips": [
    "面条煮到八分熟过凉水，口感才筋道不坨。",
    "番茄要炒出红汁再回肉，浇头才挂得住面。",
    "孜然务必在出锅前放，香气才够冲。"
  ],
  "common_mistakes": [
    "牛肉顺纹切，嚼起来塞牙还发柴。",
    "面条煮过头再拌，一夹就断成小段。",
    "番茄没炒出汁，浇头干巴巴裹不上面。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "150 克:150 克",
      "note": "更接近新疆本地口味，膻香更足。"
    },
    {
      "original": "青椒",
      "substitute": "芹菜",
      "ratio": "100 克:100 克",
      "note": "脆感相似，清香更明显。"
    }
  ],
  "variations": [
    "加一勺辣椒油，酸辣口吃起来更过瘾。",
    "面条换成宽面，挂住更多浇头汁水。"
  ],
  "serving_suggestion": "面条盛盘后浇上热浇头，趁热从下往上拌开，配一碟生蒜更地道。",
  "storage": "浇头与面条分开冷藏，两天内吃完，复热时浇头单独回锅。",
