  "steps": [
    {
      "n": 1,
      "text": "羊肉切小块，冷水浸泡二十分钟去血水，捞出沥干备用。",
      "time_min": 22,
      "heat": "无火",
      "tip": "小块泡得快，血水去净，膻味就轻一半。",
      "visual_cue": "肉块发白，表面不见血丝"
    },
    {
      "n": 2,
      "text": "炖锅倒植物油烧热，下姜片、蒜与干辣椒炒香，倒入羊肉中火煸到表面焦黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "羊肉先煸出油，炖出来的汤才香不腥。",
      "visual_cue": "肉块边缘焦黄，锅底渗羊油"
    },
    {
      "n": 3,
      "text": "加洋葱块、番茄块炒软出汁，放孜然、辣椒粉、生抽与白糖翻匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出红汁，是这道菜汤色的来源。",
      "visual_cue": "番茄化开成汁，锅中泛红色"
    },
    {
      "n": 4,
      "text": "加开水没过羊肉，大火烧开转小火炖二十五分钟。",
      "time_min": 32,
      "heat": "小火",
      "tip": "水要一次加够量，中途再添水会把汤味冲淡，肉也不容易炖软。",
      "visual_cue": "汤面微沸，羊肉开始变软"
    },
    {
      "n": 5,
      "text": "下土豆块继续炖十五分钟，至土豆绵软、汤汁收浓。",
      "time_min": 16,
      "heat": "小火",
      "tip": "土豆后放，早了会炖化把汤糊成一锅浆。",
      "visual_cue": "土豆棱角变圆，筷子能插透"
    },
    {
      "n": 6,
      "text": "馕掰成大块铺在盘底，把滚烫的羊肉连汤一起浇上去，让它浸两分钟吸味。",
      "time_min": 22,
      "heat": "无火",
      "tip": "馕要现掰现浇，滚烫的汤一泡才软中带韧，提前泡就散成糊了。",
      "visual_cue": "馕块吸汤汁变深，边缘仍挺立"
    },
    {
      "n": 7,
      "text": "最后撒上青椒块与香菜段，试着味道补一点盐，翻匀之后就可以上桌了。",
      "time_min": 2,
      "heat": "无火",
      "tip": "青椒生脆解腻，最后放才有清香味，早炒就软塌发黄了。",
      "visual_cue": "青椒翠绿，汤汁裹满馕块"
    }
  ],
  "tips": [
    "馕选偏硬的老馕，泡汤不散，口感更筋道。",
    "加一把鹰嘴豆同炖，粉糯香甜，是南疆的做法。",
    "汤汁宁可多留一些，馕极能吃汤，浇少了底下那层还是干的。"
  ],
  "common_mistakes": [
    "馕提前泡在水里，上桌就成了一坨面糊。",
    "羊肉不煸直接炖，汤腥且表面浮一层白沫。",
    "土豆和羊肉同下锅，最后土豆全化在汤里。"
  ],
  "substitutions": [
    {
      "original": "馕",
      "substitute": "面粉",
      "ratio": "300克:200克",
      "note": "可用烙饼代替，吸汤稍慢。"
    },
    {
      "original": "羊肉",
      "substitute": "羊排",
      "ratio": "500克:600克",
      "note": "羊排带骨更香，炖的时间延长十分钟。"
    }
  ],
  "variations": [
    "把羊肉换成牛肉同炖，汤更浓，适合不吃羊肉的人。",
    "加一勺番茄酱增色，汤汁更红亮，是餐馆的做法。"
  ],
  "serving_suggestion": "馕吸饱汤汁是最好吃的部分，配一碗酸奶解腻刚好。",
  "storage": "冷藏可存两天，复热须把馕与汤分开加热，馕后放避免泡烂。",
