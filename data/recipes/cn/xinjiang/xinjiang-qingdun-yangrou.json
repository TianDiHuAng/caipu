  "equipment": [
    "汤锅",
    "刀",
    "汤勺",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉切成大块，用清水浸泡三十分钟泡出血水。",
      "time_min": 32,
      "heat": "无火",
      "tip": "先泡出血水，汤才清亮而且不发腥。",
      "visual_cue": "水色微红，肉块发白"
    },
    {
      "n": 2,
      "text": "羊肉冷水下锅，加姜片煮开，撇净表面浮沫。",
      "time_min": 15,
      "heat": "大火",
      "tip": "必须冷水下锅，热水会把血沫锁在肉里。",
      "visual_cue": "浮沫撇净，汤面清亮"
    },
    {
      "n": 3,
      "text": "捞出羊肉用温水冲洗干净，锅也洗净重新加水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "用温水冲，冷水一激肉质会变紧。",
      "visual_cue": "肉块干净，没有浮沫"
    },
    {
      "n": 4,
      "text": "羊肉和姜片放回锅里，加够清水大火烧开转小火炖六十分钟。",
      "time_min": 62,
      "heat": "小火",
      "tip": "水一次加足，中途加水汤味会淡。",
      "visual_cue": "汤色微白，肉香飘出"
    },
    {
      "n": 5,
      "text": "放入白萝卜块和洋葱，继续小火炖二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "白萝卜要后放，炖久了会烂成泥。",
      "visual_cue": "萝卜半透明，筷子可插透"
    },
    {
      "n": 6,
      "text": "加盐和黑胡椒调味，撒香菜末后连汤一起盛出。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盐一定要最后加，早加肉会变硬。",
      "visual_cue": "汤清肉烂，香气清甜"
    }
  ],
  "tips": [
    "羊肉冷水下锅焯，血沫才能彻底煮出来。",
    "水一次加足，中途加水汤味会明显变淡。",
    "盐要最后加，早放会让肉质收紧变硬。"
  ],
  "common_mistakes": [
    "热水下锅焯肉，血沫全锁在肉里带腥。",
    "全程大火猛煮，汤浑肉柴还发腥。",
    "萝卜一开始就下锅，炖到最后全化成泥。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "羊排",
      "ratio": "1000 克:1100 克",
      "note": "带骨更香，炖的时间略短。"
    },
    {
      "original": "白萝卜",
      "substitute": "胡萝卜",
      "ratio": "400 克:350 克",
      "note": "汤色更甜，风味更清。"
    }
  ],
  "variations": [
    "加一小把枸杞进去，汤色更漂亮好看。",
    "最后撒一把洋葱丝，辛香更接近新疆本地做法。"
  ],
  "serving_suggestion": "连汤带肉盛进大碗，配馕或手抓饭一起吃，是新疆待客最实在的一道。",
  "storage": "冷藏两天，复热时撇去表面浮油，小火加热至滚开。",
