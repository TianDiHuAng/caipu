  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 300,
          "unit": "g",
          "note": "切块",
          "optional": false
        },
        {
          "name": "洋葱",
          "name_en": "onion",
          "amount": 150,
          "unit": "g",
          "note": "切丝",
          "optional": false
        },
        {
          "name": "青椒",
          "name_en": "green bell pepper",
          "amount": 150,
          "unit": "g",
          "note": "切丝",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "米醋",
          "name_en": "rice vinegar",
          "amount": 20,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 2,
          "unit": "g",
          "note": "增辣",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 15,
          "unit": "ml",
          "note": "泼油",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "刀",
    "砧板",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄洗净去蒂切成月牙块，撒上盐腌五分钟出汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "番茄先腌出汁，拌好才有自然的酸甜汤。",
      "visual_cue": "番茄块渗出红色汁水"
    },
    {
      "n": 2,
      "text": "洋葱剥去外皮切成细丝，放入冰水泡五分钟。",
      "time_min": 7,
      "heat": "无火",
      "tip": "冰水泡过的洋葱，辛辣味会温和很多。",
      "visual_cue": "洋葱丝挺立，颜色发亮"
    },
    {
      "n": 3,
      "text": "青椒去掉籽和筋，切成和洋葱差不多粗细的细丝。",
      "time_min": 4,
      "heat": "无火",
      "tip": "青椒丝切细一点，口感才不生硬。",
      "visual_cue": "青椒丝均匀，颜色翠绿"
    },
    {
      "n": 4,
      "text": "把番茄块、洋葱丝和青椒丝一起放进大碗里。",
      "time_min": 2,
      "heat": "无火",
      "tip": "三种材料分开放再拌，颜色更好看。",
      "visual_cue": "三种材料分层摆放，颜色分明"
    },
    {
      "n": 5,
      "text": "淋入米醋和辣椒粉，用勺子轻轻翻拌让味道均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻拌就行，番茄拌碎会出太多水。",
      "visual_cue": "材料拌匀，表面泛着红汁"
    },
    {
      "n": 6,
      "text": "植物油烧热后趁热泼在辣椒粉上激香，再整体拌匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "热油泼上辣椒粉，香气立刻就出来。",
      "visual_cue": "油光挂在蔬菜表面"
    }
  ],
  "tips": [
    "番茄先用盐腌一下，出汁后拌出来更入味。",
    "洋葱用冰水泡过，辛辣味会柔和很多。",
    "热油泼在辣椒粉上，香气比直接拌更足。"
  ],
  "common_mistakes": [
    "番茄和洋葱都不腌不泡，成品辛辣又寡淡。",
    "用力翻拌把番茄搅烂，沙拉成了汤水。",
    "热油温度不够，泼上去激不出香味。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "20 毫升:20 毫升",
      "note": "酸味更冲，用量可减半。"
    },
    {
      "original": "青椒",
      "substitute": "螺丝椒",
      "ratio": "150 克:150 克",
      "note": "辣度更高，适合嗜辣者。"
    }
  ],
  "variations": [
    "加一点香菜碎，风味更接近新疆本地做法。",
    "挤半个柠檬代替米醋，酸味更清爽。"
  ],
  "serving_suggestion": "配大盘鸡、手抓饭或者烤肉一起吃，解腻又开胃。",
  "storage": "冷藏一天，出水后食用前重新拌匀；不建议冷冻，蔬菜会软烂。",
  "nutrition_estimate": {
    "basis": "每份约 150 克",
    "calories_kcal": 80,
    "protein_g": 2,
    "fat_g": 4,
    "carbs_g": 9,
