  "equipment": [
    "大碗",
    "炒锅",
    "汤锅",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和清水揉成光滑面团，盖布醒三十分钟。",
      "time_min": 34,
      "heat": "无火",
      "tip": "醒过的面擀开不缩，切出的面片才匀。",
      "visual_cue": "面团柔软，表面光洁"
    },
    {
      "n": 2,
      "text": "面团擀成两毫米薄片，切成三厘米见方的面片，撒干面粉防粘。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切好要撒粉抖散，不然会粘成一坨。",
      "visual_cue": "面片匀整，互不粘连"
    },
    {
      "n": 3,
      "text": "汤锅烧水，面片下锅煮两分钟到浮起，捞出过凉水沥干。",
      "time_min": 8,
      "heat": "大火",
      "tip": "煮到八分熟就好，后面还要下锅炒。",
      "visual_cue": "面片浮起，边缘半透"
    },
    {
      "n": 4,
      "text": "牛肉逆着纹理切薄片，用生抽抓匀腌十分钟去腥。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌过的牛肉炒出来更嫩，也不带腥味。",
      "visual_cue": "肉片薄匀，微微发亮"
    },
    {
      "n": 5,
      "text": "炒锅放植物油烧热，牛肉下锅大火滑炒两分钟到变色盛出。",
      "time_min": 5,
      "heat": "大火",
      "tip": "大火快炒，肉片才不会出水变柴。",
      "visual_cue": "肉片变色，锅底焦香"
    },
    {
      "n": 6,
      "text": "原锅下洋葱丝炒软，加番茄块炒三分钟到出汁。",
      "time_min": 5,
      "heat": "大火",
      "tip": "番茄炒出汁，面片才有东西挂。",
      "visual_cue": "汤汁发红，洋葱软塌"
    },
    {
      "n": 7,
      "text": "放青椒块和煮好的面片，加辣椒面、孜然和盐大火翻炒三分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "面片下锅要不停翻，不然贴锅底糊掉。",
      "visual_cue": "面片裹汁，颜色红亮"
    },
    {
      "n": 8,
      "text": "倒回牛肉，撒大蒜片和香菜段翻匀，出锅装盘。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蒜和香菜最后放，香气才清亮。",
      "visual_cue": "蒜香扑鼻，面片油亮"
    }
  ],
  "tips": [
    "炒面片是新疆家常饭，剩的面片和一点肉就能炒一盘。",
    "面片先煮到八分熟，炒的时候才不会烂。",
    "番茄一定要炒出汁，干炒的面片没人爱。"
  ],
  "common_mistakes": [
    "面片煮到全熟再炒，一翻就断，最后成糊。",
    "面片沥水不干就下锅，锅里全是水，炒变成煮。",
    "全程小火慢炒，面片吸油又发硬。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "300克:300克",
      "note": "羊肉版更贴近本地风味，腌时可加一点洋葱汁去膻。"
    },
    {
      "original": "青椒",
      "substitute": "甜椒",
      "ratio": "100克:100克",
      "note": "甜椒不辣，孩子更容易接受，辣椒面可减半。"
    }
  ],
  "variations": [
    "加一把泡软的干辣椒同炒，做出香辣版本。",
    "把番茄换成番茄膏，颜色更浓，酸味更集中。"
  ],
  "serving_suggestion": "装盘后撒一点香菜，配一碗面汤原汤化原食。",
  "storage": "冷藏两天，复热用炒锅大火快炒，别用微波炉会发硬。",
