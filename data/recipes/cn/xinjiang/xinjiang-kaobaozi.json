  "equipment": [
    "烤箱",
    "擀面杖",
    "盆",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加三克盐和一百八十毫升清水，揉成偏硬的面团，盖布醒三十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "面要和得偏硬，烤完皮才脆不软。",
      "visual_cue": "面团光滑，按压有回弹"
    },
    {
      "n": 2,
      "text": "羊肉切成小方丁，洋葱切同样大小的细丁，一起放进盆里。",
      "time_min": 8,
      "heat": "无火",
      "tip": "羊肉别剁成泥，小丁咬起来才有肉感。",
      "visual_cue": "肉丁与洋葱丁大小一致"
    },
    {
      "n": 3,
      "text": "馅里加孜然、黑胡椒、剩余盐和二十毫升植物油，抓拌均匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "孜然先炒香再磨，香气比生孜然强很多。",
      "visual_cue": "馅料油润，香气扑鼻"
    },
    {
      "n": 4,
      "text": "面团分成十份，每份擀成中间厚边缘薄的方形面片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "中间厚一点，底部才不会被馅汁泡破。",
      "visual_cue": "面片方正，中间略厚"
    },
    {
      "n": 5,
      "text": "面片中间放一勺羊肉丁，四边对折成长方形，捏紧收口压出花边。",
      "time_min": 10,
      "heat": "无火",
      "tip": "收口一定捏死，烤的时候汁水才不会流。",
      "visual_cue": "形状方正，收口紧实"
    },
    {
      "n": 6,
      "text": "包好的包子表面刷一层植物油，摆进烤盘留出间距。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷一层油烤出来才亮，皮也更脆。",
      "visual_cue": "表面油亮，排列不粘"
    },
    {
      "n": 7,
      "text": "烤箱两百度预热后烤二十分钟，表面金黄、底部微焦即可出炉。",
      "time_min": 23,
      "heat": "中火",
      "tip": "烤到皮鼓起、底部干爽，馅才熟透。",
      "visual_cue": "表皮金黄鼓起，底部微焦"
    }
  ],
  "tips": [
    "面和得偏硬，烤出来的皮才够脆。",
    "羊肉切小丁不要剁泥，口感才扎实。",
    "收口一定要捏紧，否则烤的时候汤汁全流出来。"
  ],
  "common_mistakes": [
    "面揉得太软，包的时候整个塌成一片。",
    "收口没有捏紧，烤完馅料全漏在烤盘上。",
    "馅里水分太多，底部烤完湿软不脆。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "350 克:350 克",
      "note": "更紧实，需多加十毫升油。"
    },
    {
      "original": "孜然",
      "substitute": "孜然粉",
      "ratio": "6 克:6 克",
      "note": "省去研磨，香气略淡。"
    }
  ],
  "variations": [
    "馅里加一小块羊尾油，烤出来汁水更足更香。",
    "表面撒一层白芝麻，烤完香气更浓。"
  ],
  "serving_suggestion": "趁热从烤盘上直接拿，配一碗酸奶或砖茶，是新疆巴扎上最热卖的小吃。",
  "storage": "冷藏两天，复热用两百度烤八分钟，微波会让皮变韧。",
