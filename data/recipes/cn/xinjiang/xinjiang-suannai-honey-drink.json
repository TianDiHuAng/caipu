  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 800,
          "unit": "g",
          "note": "浓稠原味",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 60,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 200,
          "unit": "ml",
          "note": "调稀",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "打蛋器",
    "冰箱",
    "玻璃杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酸奶从冰箱取出倒进大碗，用打蛋器搅三十秒到完全顺滑无块。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先搅顺再兑奶，饮品的质地才细腻。",
      "visual_cue": "酸奶顺滑，无结块"
    },
    {
      "n": 2,
      "text": "分次倒入冷牛奶，边倒边搅，调到能顺畅流动的稠度。",
      "time_min": 4,
      "heat": "无火",
      "tip": "牛奶别一次倒完，太稀就失了酸奶的厚度。",
      "visual_cue": "液体顺滑，挂壁缓慢"
    },
    {
      "n": 3,
      "text": "加蜂蜜和一小撮盐，搅到蜂蜜完全化开、甜味均匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "一点盐能把甜味托起来，喝起来不腻。",
      "visual_cue": "色泽米白，闻着清甜"
    },
    {
      "n": 4,
      "text": "碗口盖住放进冰箱冷藏三十分钟，让味道融合、口感变凉。",
      "time_min": 33,
      "heat": "无火",
      "tip": "冷藏后质地更稠，风味也更圆。",
      "visual_cue": "表面细滑，碗身挂霜"
    },
    {
      "n": 5,
      "text": "喝前再搅一次，倒进玻璃杯，喜欢的话加两块冰。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冰别加太多，化开会把酸奶稀释成水。",
      "visual_cue": "杯壁挂雾，奶面平稳"
    }
  ],
  "tips": [
    "这是新疆夏天最常见的解暑饮品，饭后来一杯最舒服。",
    "酸奶要选浓稠型，稀的兑奶后像水一样没口感。",
    "蜂蜜可用白糖代替，但要先化在少量温牛奶里再拌。"
  ],
  "common_mistakes": [
    "酸奶没搅顺就兑奶，杯里挂着一团团奶块。",
    "牛奶倒太多，饮品稀得挂不住杯壁。",
    "冰加太多，喝到一半全化成稀汤。"
  ],
  "substitutions": [
    {
      "original": "蜂蜜",
      "substitute": "白糖",
      "ratio": "60克:50克",
      "note": "白糖需先用少量温牛奶化开，否则沉底不匀。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "200毫升:180毫升",
      "note": "加水版更清爽，适合配油腻的烤肉。"
    }
  ],
  "variations": [
    "加一勺切碎的苹果丁，口感更丰富，也更适合待客。",
    "换成羊奶发酵的酸奶，酸味更重，需多加十克蜂蜜。"
  ],
  "serving_suggestion": "配手抓饭或烤羊肉串，油腻之后一口下去很解腻。",
  "storage": "冷藏可存两天，久放会继续变酸；饮前搅匀再喝。",
  "nutrition_estimate": {
    "basis": "按四人份估算",
    "calories_kcal": 180,
    "protein_g": 9,
