  "equipment": [
    "炒锅",
    "砂锅",
    "深盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉切 4cm 见方块，用清水冲净血水后沥干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冲净血水，成品膻味轻。",
      "visual_cue": "羊肉色泽发白、无血水渗出"
    },
    {
      "n": 2,
      "text": "炒锅下 40ml 植物油，中火炒香洋葱丝与姜片至透明。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒到微黄，甜味才出来。",
      "visual_cue": "洋葱透明微黄、香气上扬"
    },
    {
      "n": 3,
      "text": "下羊肉块大火翻炒 5 分钟至表面收紧，加 30ml 料酒炒至酒气挥发。",
      "time_min": 6,
      "heat": "大火",
      "tip": "羊肉先炒锁汁，再炖才不柴。",
      "visual_cue": "肉块表面焦香、无酒味"
    },
    {
      "n": 4,
      "text": "加番茄酱、生抽、一半孜然与辣椒粉炒 1 分钟上色。",
      "time_min": 2,
      "heat": "中火",
      "tip": "番茄酱要炒出红油，颜色才亮。",
      "visual_cue": "肉块裹满红亮酱色"
    },
    {
      "n": 5,
      "text": "倒 700ml 清水，下胡萝卜块，大火烧开转小火炖 35 分钟，加 8g 盐调味。",
      "time_min": 38,
      "heat": "小火",
      "tip": "炖到筷子能插入羊肉即可，胡萝卜后放。",
      "visual_cue": "羊肉软烂、汤汁浓稠红亮"
    },
    {
      "n": 6,
      "text": "馕掰成 8 块铺在深盘底，浇上羊肉与汤汁，撒剩余孜然，稍浸 2 分钟再吃。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馕要最后浇汁，早了会泡烂。",
      "visual_cue": "馕块吸饱汤汁、边缘仍带脆"
    }
  ],
  "tips": [
    "馕最好是刚出炉的，脆边吸汁后仍有余香。",
    "孜然分两次放，一半炒、一半出锅撒，香气有层次。",
    "新疆做法常加一勺酸奶，解腻又添奶香。"
  ],
  "common_mistakes": [
    "羊肉不先炒过就直接加水炖，汤腥肉散、口感发柴。",
    "馕提前泡在汤里，端上桌已经糊成一团。",
    "孜然一次性全下锅，久炖后香气尽失。"
  ],
  "substitutions": [
    {
      "original": "馕",
      "substitute": "法棍",
      "ratio": "2 个馕 ≈ 半根法棍",
      "note": "法棍切片烤脆后代用，吸汁效果接近。"
    },
    {
      "original": "羊肉",
      "substitute": "牛腩",
      "ratio": "700g 羊肉 ≈ 700g 牛腩",
      "note": "牛腩需炖 50 分钟。"
    }
  ],
  "variations": [
    "家庭简化版：羊肉用高压锅压 15 分钟，再回锅收汁。",
    "南疆版：加 100g 鹰嘴豆同炖，口感更绵密。"
  ],
  "serving_suggestion": "整盘上桌，馕垫底羊肉盖面，汤汁浇在馕上，一手抓馕一手夹肉。",
  "storage": "羊肉冷藏 2 天、冷冻 1 个月；馕单独密封，食用前再浇汁。",
