  "equipment": [
    "大碗",
    "炒锅",
    "汤锅",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加盐和清水揉成偏硬的面团，反复揉十分钟到表面光滑。",
      "time_min": 14,
      "heat": "无火",
      "tip": "面要硬一点，揉透了拉的时候才不断。",
      "visual_cue": "面团紧实，表面光洁"
    },
    {
      "n": 2,
      "text": "面团盖布醒四十分钟，中途再揉一次，让面筋完全松弛。",
      "time_min": 44,
      "heat": "无火",
      "tip": "醒面不足，拉条子一拉就回缩断条。",
      "visual_cue": "面团柔软，按下去慢回弹"
    },
    {
      "n": 3,
      "text": "面团搓成粗条刷油，盘在盆里再醒二十分钟。",
      "time_min": 23,
      "heat": "无火",
      "tip": "每根都刷到油，盘着放不会粘连。",
      "visual_cue": "条面油亮，盘放整齐"
    },
    {
      "n": 4,
      "text": "羊肉切薄片，用一点生抽抓匀腌十分钟去膻。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切得越薄，炒的时候越嫩，也不容易柴。",
      "visual_cue": "肉片薄匀，表面微黏"
    },
    {
      "n": 5,
      "text": "炒锅放植物油烧到七成热，羊肉下锅大火滑炒两分钟到变色盛出。",
      "time_min": 6,
      "heat": "大火",
      "tip": "大火快炒锁住肉汁，炒久了肉就老。",
      "visual_cue": "肉片变色，边缘微焦"
    },
    {
      "n": 6,
      "text": "原锅下洋葱丝炒一分钟，加番茄块和番茄膏炒三分钟出红汁。",
      "time_min": 7,
      "heat": "大火",
      "tip": "番茄炒出汁再下别的菜，拌面才有汁挂。",
      "visual_cue": "汤汁发红，锅里冒泡"
    },
    {
      "n": 7,
      "text": "放青椒块和芹菜段炒两分钟，倒回羊肉，加孜然、辣椒面和盐炒匀。",
      "time_min": 5,
      "heat": "大火",
      "tip": "孜然最后放，香气才冲，早放会炒糊。",
      "visual_cue": "菜色鲜亮，孜然飘香"
    },
    {
      "n": 8,
      "text": "汤锅烧水，面拉细下锅煮三分钟，捞出过一下热水装碗。",
      "time_min": 8,
      "heat": "大火",
      "tip": "拉细一点好熟，煮到没有硬芯就捞。",
      "visual_cue": "拉面浮起，色白透亮"
    },
    {
      "n": 9,
      "text": "把炒好的菜连汁浇在面上，撒大蒜片，拌开吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汁要够，拌的时候每根面都裹上红汤。",
      "visual_cue": "面碗红亮，蒜香扑鼻"
    }
  ],
  "tips": [
    "拌面是新疆人的工作餐，面和菜分开做，吃时再拌。",
    "面和硬、醒透、刷油，三步做到拉条子就不断。",
    "炒菜的汁要留多一点，拌面全靠这口汤。"
  ],
  "common_mistakes": [
    "面和得太软，拉条子下锅就断成短截。",
    "面没醒够就拉，一拉回缩，越拉越粗。",
    "菜炒得太干，拌面时面坨成一团拌不开。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "300克:300克",
      "note": "牛肉版更常见于家常，腌时加一点油防柴。"
    },
    {
      "original": "芹菜",
      "substitute": "豇豆",
      "ratio": "100克:100克",
      "note": "豇豆需先焯两分钟再炒，口感更脆。"
    }
  ],
  "variations": [
    "把面拉成宽条，做成大盘鸡拌面那样的宽面，更挂汁。",
    "菜里加一把泡软的干辣椒同炒，做出重辣版本。"
  ],
  "serving_suggestion": "面和菜分装，吃前把菜汁浇上去拌开，配一瓣生蒜。",
  "storage": "面与菜分开冷藏，各存两天；复热时面过热水、菜单独回锅。",
