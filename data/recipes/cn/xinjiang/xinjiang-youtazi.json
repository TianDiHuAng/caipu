  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 500,
          "unit": "g",
          "note": "中筋，分两份用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 5,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 260,
          "unit": "ml",
          "note": "约四十度",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 80,
          "unit": "ml",
          "note": "抹层用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "花椒",
          "name_en": "Sichuan peppercorn",
          "amount": 2,
          "unit": "g",
          "note": "磨成粉",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "蒸锅",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母用温水化开静置五分钟，倒进面粉里揉成光滑面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水别超过四十度，烫了酵母就不发。",
      "visual_cue": "面团光滑，不粘手"
    },
    {
      "n": 2,
      "text": "面团盖湿布放温暖处发酵一小时，涨到原来一倍半大。",
      "time_min": 62,
      "heat": "无火",
      "tip": "不用发到两倍，半发状态卷层才不塌。",
      "visual_cue": "体积变大，指压回弹"
    },
    {
      "n": 3,
      "text": "面团擀成三毫米厚的大薄片，越薄层次越多。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擀薄是油塔子起层的关键，厚了就是死面饼。",
      "visual_cue": "面片匀薄，透光可见"
    },
    {
      "n": 4,
      "text": "面片上刷一层植物油，均匀撒上盐和花椒粉，边角别漏。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油要刷匀，撒料后用手抹一遍才不结块。",
      "visual_cue": "表面油亮，料粉均匀"
    },
    {
      "n": 5,
      "text": "面片从一边卷成紧实长条，切成六厘米长的段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "卷得紧一点，蒸出来层次才分明不散。",
      "visual_cue": "卷条紧实，切开见层"
    },
    {
      "n": 6,
      "text": "每段竖着立起，用筷子从中间压下成塔形，摆进蒸笼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "压一下让层次张开，蒸的时候蒸汽才进得去。",
      "visual_cue": "塔形张开，层次分明"
    },
    {
      "n": 7,
      "text": "蒸锅上汽后放笼，大火蒸二十分钟，关火焖三分钟再揭盖。",
      "time_min": 25,
      "heat": "大火",
      "tip": "焖几分钟再开盖，避免骤冷回缩变硬。",
      "visual_cue": "表面白亮，层次鼓起"
    }
  ],
  "tips": [
    "油塔子是新疆人配奶茶吃的层酥主食，掰开一层层撕着吃。",
    "面片擀得越薄，层数越多，口感越松。",
    "蒸好后趁热吃，凉了层会粘在一起。"
  ],
  "common_mistakes": [
    "面团发过头，蒸出来酸味重还塌成一团。",
    "油刷得太少，层与层粘死，撕不开也咬不动。",
    "蒸好立刻开盖，冷气一激表面起皱发硬。"
  ],
  "substitutions": [
    {
      "original": "植物油",
      "substitute": "羊油",
      "ratio": "80毫升:70毫升",
      "note": "羊油版香味更浓，是传统做法，量要略减。"
    },
    {
      "original": "花椒",
      "substitute": "黑胡椒",
      "ratio": "2克:2克",
      "note": "黑胡椒更清亮，用量相同即可。"
    }
  ],
  "variations": [
    "卷的时候撒一层切碎的洋葱，蒸出来带葱香。",
    "把盐换成糖做成甜油塔，配咸奶茶也很对味。"
  ],
  "serving_suggestion": "掰开撕成层片，配一碗滚烫的咸奶茶，或者就着羊肉汤一起吃。",
  "storage": "冷藏两天，复蒸五分钟回软；不建议冷冻，层次会压塌。",
