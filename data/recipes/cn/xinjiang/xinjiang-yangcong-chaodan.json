  "equipment": [
    "炒锅",
    "打蛋盆",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进碗里加一点盐打散，打到蛋液均匀无明显的蛋清丝。",
      "time_min": 5,
      "heat": "无火",
      "tip": "多打几下，蛋液均匀炒出来才蓬松一致。",
      "visual_cue": "蛋液均匀，表面有细泡"
    },
    {
      "n": 2,
      "text": "番茄洗净去蒂切滚刀块，洋葱切成三毫米粗的丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "番茄切大块一点，炒完还有果肉，不会全化水。",
      "visual_cue": "番茄成块，洋葱丝匀"
    },
    {
      "n": 3,
      "text": "炒锅烧热放一半植物油，蛋液倒入，等底部凝固后推成大块盛出。",
      "time_min": 4,
      "heat": "大火",
      "tip": "油温够高蛋才蓬松，别急着搅，等它自己凝。",
      "visual_cue": "蛋块金黄，中间微嫩"
    },
    {
      "n": 4,
      "text": "锅补余油，洋葱丝下锅中火炒三分钟到边缘透明发甜。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒透才甜，这点是新疆炒蛋和别处不同的地方。",
      "visual_cue": "洋葱软塌，甜香出来"
    },
    {
      "n": 5,
      "text": "放番茄块，加盐和白糖，中火炒三分钟到番茄出汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一点糖压住番茄的酸，整体味道更圆。",
      "visual_cue": "番茄出汁，汤汁发红"
    },
    {
      "n": 6,
      "text": "倒回蛋块，翻炒一分钟让蛋吸进汤汁，撒黑胡椒和葱花出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蛋块回锅别久炒，吸了汁就够，久了会碎。",
      "visual_cue": "蛋块裹红汁，葱花翠绿"
    }
  ],
  "tips": [
    "洋葱和番茄是新疆菜里的黄金搭配，炒蛋也不例外。",
    "蛋要嫩、汁要红，两个要点决定成败。",
    "配馕或拌面都合适，剩了也能当第二天早饭。"
  ],
  "common_mistakes": [
    "蛋液下锅就猛搅，炒成碎渣，一点块都留不住。",
    "番茄炒到全化开成了汤，蛋块泡在里头没了口感。",
    "不放糖只放盐，酸味尖，吃着不舒服。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "番茄膏",
      "ratio": "300克:60克",
      "note": "番茄膏版颜色更浓，需多加五十毫升清水。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "240克:250克",
      "note": "鸭蛋更香但略腥，可多加一点黑胡椒压味。"
    }
  ],
  "variations": [
    "加一个青椒切丝同炒，颜色和味道都更立体。",
    "把洋葱换成大葱段，香气更冲，是偏北疆的做法。"
  ],
  "serving_suggestion": "趁热配馕吃，或者直接盖在拉条子上当浇头，都很下饭。",
  "storage": "冷藏可存一天，复热用炒锅小火回温，不要再加水。",
