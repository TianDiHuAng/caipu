  "steps": [
    {
      "n": 1,
      "text": "羊排用清水浸泡半小时泡出血水，捞出后用厨房纸把表面水分擦干。",
      "time_min": 32,
      "heat": "无火",
      "tip": "泡去血水羊排才不膻，水分擦干才挂得住腌料。",
      "visual_cue": "羊排发白，表面干爽不泛水光"
    },
    {
      "n": 2,
      "text": "洋葱丝挤出汁水，与蒜末、姜末、一半孜然、辣椒粉、盐和黑胡椒拌成腌料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱汁比料酒管用得多，能把羊排的膻味压得干干净净。",
      "visual_cue": "腌料呈湿润的红色糊状"
    },
    {
      "n": 3,
      "text": "把腌料均匀抹遍羊排两面，装袋冷藏腌两小时，中途翻面一次。",
      "time_min": 115,
      "heat": "无火",
      "tip": "腌足两小时，香料才走得进肉里，急不得。",
      "visual_cue": "羊排表面裹满红色腌料"
    },
    {
      "n": 4,
      "text": "平底锅烧热倒植物油，羊排下锅中大火把两面各煎两分钟封住肉汁。",
      "time_min": 5,
      "heat": "中火",
      "tip": "先煎出焦壳锁住肉汁，后面烤才不会干柴。",
      "visual_cue": "两面焦褐上色，锅底渗出羊油"
    },
    {
      "n": 5,
      "text": "煎好的羊排移到烤盘，刷一层植物油，撒上剩下的孜然，送入两百度烤箱烤十分钟。",
      "time_min": 12,
      "heat": "大火",
      "tip": "烤箱提前预热到位，温度不够烤出来是焖熟的。",
      "visual_cue": "表面油亮焦香，边缘微焦卷起"
    },
    {
      "n": 6,
      "text": "出炉静置三分钟再切条，撒香菜段与少许盐，趁热装盘上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置三分钟让肉汁回流，切的时候不流血水。",
      "visual_cue": "断面肉色粉白，肉汁充盈"
    }
  ],
  "tips": [
    "羊排要挑带一点肥油的部位，烤出来才够香，纯瘦的烤完发柴。",
    "孜然分两次放，腌的时候入味，出锅撒的才够冲。",
    "喜欢更焦香的，可以在出炉前把上火打开多烤两分钟，表皮会更脆。"
  ],
  "common_mistakes": [
    "羊排不泡血水直接腌，烤出来膻味压不住。",
    "全程都用小火慢慢煎，羊排在锅里一点点出水，最后又老又柴，完全咬不动。",
    "烤完立刻切，肉汁全流在盘底，肉块发干。"
  ],
  "substitutions": [
    {
      "original": "羊排",
      "substitute": "羊肉",
      "ratio": "750克:700克",
      "note": "羊肉切大块，烤的时间减两分钟。"
    },
    {
      "original": "辣椒粉",
      "substitute": "辣椒酱",
      "ratio": "8克:20克",
      "note": "辣椒酱含水，腌的时间缩短到一小时。"
    }
  ],
  "variations": [
    "把羊排切成小块穿成串，用炭火烤更香，是巴扎上最常见的吃法。",
    "腌料里加一勺酸奶同腌，肉质更嫩，膻味也更淡。"
  ],
  "serving_suggestion": "趁热吃最香，配馕与洋葱丝，再来一碗酸奶解腻。",
  "storage": "冷藏可存两天，复热须烤箱一百八十度烤五分钟，微波会令肉质发硬。",
