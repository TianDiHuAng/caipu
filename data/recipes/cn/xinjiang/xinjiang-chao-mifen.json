  "equipment": [
    "炒锅",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "米粉用温水泡 40 分钟至能用指甲掐断，捞出沥干。",
      "time_min": 40,
      "heat": "无火",
      "tip": "粗米粉必须泡透，否则炒时吸水不均、夹生。",
      "visual_cue": "米粉柔软可弯折、无硬芯"
    },
    {
      "n": 2,
      "text": "牛肉片加料酒、玉米淀粉与 1g 盐抓匀腌 10 分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "上浆后牛肉炒制不易老。",
      "visual_cue": "牛肉片表面挂薄浆、手感滑"
    },
    {
      "n": 3,
      "text": "炒锅下 30ml 植物油烧热，大火下牛肉片快速滑散至变色盛出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "牛肉只炒到七成熟，回锅再炒才嫩。",
      "visual_cue": "牛肉片表面变褐、边缘微卷"
    },
    {
      "n": 4,
      "text": "锅中下干辣椒、蒜末与洋葱丝炒香，加芹菜段翻炒 1 分钟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "洋葱炒到半透才有甜味，芹菜要保持脆。",
      "visual_cue": "洋葱边缘透明、芹菜颜色转深绿"
    },
    {
      "n": 5,
      "text": "下米粉与牛肉，加生抽、老抽、盐与辣椒油，转大火翻炒 2 分钟至均匀上色。",
      "time_min": 3,
      "heat": "大火",
      "tip": "米粉易粘锅，油量要够并不断翻炒。",
      "visual_cue": "米粉根根分明、油亮发红"
    },
    {
      "n": 6,
      "text": "沿锅边淋 30ml 清水，加盖焖 1 分钟让米粉吸味，开盖收干即可。",
      "time_min": 2,
      "heat": "大火",
      "tip": "少量水焖一下，米粉更入味不干硬。",
      "visual_cue": "锅中无余水、米粉软而弹"
    }
  ],
  "tips": [
    "米粉选新疆本地的粗米粉，用挂面或河粉替代口感差别较大。",
    "辣椒油按口味增减，正宗做法油亮偏辣。",
    "配一份酸奶或凉皮，是新疆人吃炒米粉的标配。"
  ],
  "common_mistakes": [
    "米粉没泡透就下锅，成品夹生且吸干锅中油水。",
    "全程用小火炒，米粉很快粘成一团。",
    "牛肉炒到全熟再回锅，出锅时已经发柴。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "鸡腿肉",
      "ratio": "150g 牛肉 ≈ 150g 鸡腿肉",
      "note": "鸡肉更易熟，炒制时间减半。"
    },
    {
      "original": "米粉",
      "substitute": "河粉",
      "ratio": "250g 米粉 ≈ 300g 河粉",
      "note": "河粉易断，改用筷子轻推翻炒。"
    }
  ],
  "variations": [
    "家庭简化版：米粉泡好后用开水烫 30 秒，再下锅炒，缩短炒制时间。",
    "干煸版：不加水焖，全程大火干炒，米粉更香更有嚼劲。"
  ],
  "serving_suggestion": "作为一餐主食，配馕或酸奶；新疆本地常配一份凉皮同食。",
  "storage": "冷藏 1 天，复热加 20ml 清水大火翻炒 2 分钟。",
