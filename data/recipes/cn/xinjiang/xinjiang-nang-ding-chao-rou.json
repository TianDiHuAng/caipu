  "equipment": [
    "炒锅",
    "菜刀",
    "砧板",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "馕掰成两厘米见方的小丁，边缘硬的部分也留着一起用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "隔夜馕水分少，炒完才脆不软塌。",
      "visual_cue": "馕丁干爽，大小均匀"
    },
    {
      "n": 2,
      "text": "羊肉切成与馕丁相近的小丁，用生抽抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉丁切小一点，和馕同口大小才好一起嚼。",
      "visual_cue": "肉丁匀整，表面微黏"
    },
    {
      "n": 3,
      "text": "炒锅放一半植物油烧热，馕丁下锅中火炒四分钟到边缘微焦。",
      "time_min": 6,
      "heat": "中火",
      "tip": "馕丁先单独炒脆，后面拌进汁里才不会烂。",
      "visual_cue": "馕丁焦黄，咬着发脆"
    },
    {
      "n": 4,
      "text": "馕丁盛出，锅补余下的油，羊肉丁下锅大火炒三分钟到出油。",
      "time_min": 4,
      "heat": "大火",
      "tip": "羊肉炒到边缘卷起、锅内出油，香才够。",
      "visual_cue": "肉丁焦边，锅里见油"
    },
    {
      "n": 5,
      "text": "加洋葱丁炒两分钟到软，再放青椒丁炒一分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "洋葱炒软出甜，青椒只炒断生保脆。",
      "visual_cue": "洋葱软塌，青椒翠绿"
    },
    {
      "n": 6,
      "text": "撒孜然、辣椒面和盐翻匀，把馕丁倒回锅里。",
      "time_min": 3,
      "heat": "大火",
      "tip": "香料先和肉菜拌匀，再下馕丁，味才均匀。",
      "visual_cue": "香料裹匀，锅气腾腾"
    },
    {
      "n": 7,
      "text": "大火翻炒一分钟让馕丁裹上油和香料，撒大蒜片和香菜出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "馕丁回锅只翻短时间，久了吸味变软就不好吃了。",
      "visual_cue": "馕丁油亮，蒜香扑鼻"
    }
  ],
  "tips": [
    "馕丁炒肉是新疆人处理隔夜馕最常见的办法。",
    "馕丁先炒脆是本菜的关键，一步决定口感。",
    "配一碗酸奶或奶茶，解腻又顶饱。"
  ],
  "common_mistakes": [
    "用新出炉的馕直接炒，吸水后软成一团糊。",
    "馕丁和肉一起下锅，馕吸满肉汁，一点都不脆。",
    "香料放得太早，孜然在锅里炒糊，整盘带苦味。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "300克:300克",
      "note": "牛肉丁炒的时间加一分钟，口感略硬更有嚼劲。"
    },
    {
      "original": "馕",
      "substitute": "烤饼",
      "ratio": "400克:400克",
      "note": "烤饼需先烤干水分再切丁，否则炒完发软。"
    }
  ],
  "variations": [
    "加一把炸过的花生同炒，口感更丰富，适合当酒菜。",
    "把辣椒面换成整粒干辣椒，香气更冲但辣度更低。"
  ],
  "serving_suggestion": "装盘撒香菜，配冰镇酸奶或咸奶茶，当主食或下酒菜都合适。",
  "storage": "冷藏一天，复热用炒锅大火快炒一分钟，别加液体。",
