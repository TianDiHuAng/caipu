  "equipment": [
    "炒锅",
    "炖锅",
    "擀面杖",
    "大平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉斩成 4 厘米块，冷水下锅焯 5 分钟，撇去浮沫后捞出冲净沥干。",
      "time_min": 8,
      "heat": "中火",
      "tip": "焯水去血沫，炖出的汤才不浑。",
      "visual_cue": "鸡块表面变白，浮沫不再冒出"
    },
    {
      "n": 2,
      "text": "锅中下植物油与白糖，小火炒到糖化呈枣红色，倒入鸡块翻炒上色。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖色炒到起小泡立即下鸡，晚了会发苦。",
      "visual_cue": "鸡块均匀裹上红亮糖色，闻到焦糖香"
    },
    {
      "n": 3,
      "text": "下姜蒜、花椒、干辣椒与豆瓣酱炒出红油，沿锅边淋料酒，加生抽与老抽炒匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆瓣酱要炒到油色发红，辣味才不冲。",
      "visual_cue": "油色红亮，锅中有明显辣香"
    },
    {
      "n": 4,
      "text": "倒清水没过鸡块，大火烧开转小火炖 20 分钟，再下土豆块炖 12 分钟。",
      "time_min": 34,
      "heat": "小火",
      "tip": "土豆后放，久炖会化在汤里。",
      "visual_cue": "筷子能轻松插透土豆，鸡块骨肉易分离"
    },
    {
      "n": 5,
      "text": "面粉加盐与 150 毫升清水揉成光滑面团，醒 20 分钟后擀成宽面片，扯成皮带面煮熟。",
      "time_min": 25,
      "heat": "大火",
      "tip": "面醒够才扯得开，不断条。",
      "visual_cue": "皮带面宽而薄，煮后透明有弹性"
    },
    {
      "n": 6,
      "text": "鸡肉锅中下洋葱与青椒块，大火收汁 3 分钟，把扯好的皮带面片铺在大盘底部，连汁浇上。",
      "time_min": 5,
      "heat": "大火",
      "tip": "皮带面垫底吸汁，是这道菜的标准吃法。",
      "visual_cue": "汤汁浓稠挂勺，青椒翠绿未软"
    }
  ],
  "tips": [
    "炒糖色用小火，颜色到枣红立即下鸡块，过头会发苦。",
    "土豆选表皮光滑的黄心土豆，炖后粉糯不散。",
    "皮带面要现扯现煮，放久会粘连。"
  ],
  "common_mistakes": [
    "糖色炒到发黑才下鸡，整锅带苦味。",
    "土豆与鸡同时下锅，最后化在汤里变成糊。"
  ],
  "substitutions": [
    {
      "original": "皮带面",
      "substitute": "宽挂面或手抓饼",
      "ratio": "1:1",
      "note": "挂面省事但吸汁差，手抓饼更接近餐厅吃法。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "三黄鸡整只",
      "ratio": "按重量 1:1",
      "note": "整鸡需斩块，炖制时间延长 10 分钟。"
    }
  ],
  "variations": [
    "加 200 毫升啤酒代替部分清水，麦香更浓。",
    "沙湾传统版本最后加一把馕块同炖，吸汁更好吃。"
  ],
  "serving_suggestion": "大盘上桌，鸡肉土豆在下、皮带面垫底，拌汁一起吃。",
  "storage": "冷藏 2 天，冷冻 1 个月；皮带面单独存放，复热时再拌入。",
