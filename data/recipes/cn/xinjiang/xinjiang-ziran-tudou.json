  "steps": [
    {
      "n": 1,
      "text": "土豆削去外皮切成滚刀块，泡在清水里洗去表面的粉质，再捞出沥干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "洗掉表面的粉质，煎出来才外脆里糯，块与块之间也不粘连。",
      "visual_cue": "水变清，土豆块表面不再滑腻"
    },
    {
      "n": 2,
      "text": "汤锅烧开水，土豆块下锅煮五分钟，捞出摊开晾干水汽。",
      "time_min": 8,
      "heat": "大火",
      "tip": "先煮后煎，里面熟透外面才脆，省油也省时。",
      "visual_cue": "土豆边缘发透，筷子能插进一半"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，土豆块下锅半煎半炸，中火翻动至四面金黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "土豆块下锅后先别急着翻动，等底面结起硬壳再动，才不会破皮粘锅。",
      "visual_cue": "四面结起金黄硬壳，边缘微焦"
    },
    {
      "n": 4,
      "text": "倒出多余油，留底油下洋葱丁、蒜末与干辣椒炒香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "洋葱炒出甜味，能把孜然的冲劲托起来。",
      "visual_cue": "洋葱透明卷边，锅中飘香"
    },
    {
      "n": 5,
      "text": "撒孜然、辣椒粉、盐与白糖，转大火快速翻锅，让每块土豆都裹上香料。",
      "time_min": 2,
      "heat": "大火",
      "tip": "香料要最后再撒，依靠锅里的高温一激，孜然的香气才会一下炸开。",
      "visual_cue": "土豆块油亮泛红，香料均匀附着"
    },
    {
      "n": 6,
      "text": "撒上芝麻与香菜段快速翻匀，立刻出锅装盘，趁热吃最脆最香。",
      "time_min": 1,
      "heat": "大火",
      "tip": "香菜断生就可以，久炒会发黄失香，只剩一股青草味。",
      "visual_cue": "香菜翠绿，表面芝麻密布"
    }
  ],
  "tips": [
    "土豆选黄心的，口感更粉糯，适合煎。",
    "最后撒一小撮生孜然，香气更冲，是摊主的秘诀。",
    "喜欢更辣可加辣椒酱同炒，颜色也更红。"
  ],
  "common_mistakes": [
    "土豆不煮直接煎，外面焦了里面还是硬的。",
    "油温不够就下锅，土豆吸一肚子油，吃起来满嘴腻。",
    "香料早早下锅炒，孜然糊了发苦，辣味也散了。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "500克:500克",
      "note": "红薯更甜，糖可省去，煎的时间减两分钟。"
    },
    {
      "original": "孜然",
      "substitute": "五香粉",
      "ratio": "8克:6克",
      "note": "五香粉味更柔，辣味可稍加。"
    }
  ],
  "variations": [
    "把土豆换成土豆条先炸后炒，就是街边的狼牙土豆。",
    "加羊肉丁同炒，荤香更足，可当一道下饭菜。"
  ],
  "serving_suggestion": "趁热吃最脆，作为下酒小菜或街头零食都合适。",
  "storage": "冷藏可存一天，复热须回锅干煸两分钟，微波会回软。",
