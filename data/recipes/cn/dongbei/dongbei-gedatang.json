  "equipment": [
    "汤锅",
    "大碗",
    "筷子",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉放大碗里，一边淋少量清水一边用筷子搅。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水要一点点淋，才能搅出小疙瘩。，看准状态再往下做。",
      "visual_cue": "面粉成均匀小絮，这一点很关键。"
    },
    {
      "n": 2,
      "text": "搅到没有干粉、颗粒像黄豆大小为止。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "颗粒太大里面会夹生，再用筷子打散。",
      "visual_cue": "疙瘩松散，无干面，这一点很关键。"
    },
    {
      "n": 3,
      "text": "西红柿顶部划十字，用开水烫一下去皮。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "去皮后汤更顺滑，口感才细腻。，看准状态再往下做。",
      "visual_cue": "表皮卷起，轻松撕下"
    },
    {
      "n": 4,
      "text": "西红柿切小块，汤锅倒植物油炒出沙。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "炒到出沙，汤才红亮有酸甜味。，看准状态再往下做。",
      "visual_cue": "果肉化开，汁水浓稠"
    },
    {
      "n": 5,
      "text": "加生抽炒匀，倒清水大火烧开。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水开再下疙瘩，汤才清。，看准状态再往下做。",
      "visual_cue": "汤色橙红，翻滚冒泡"
    },
    {
      "n": 6,
      "text": "把疙瘩分次撒进汤里，边撒边搅防粘。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "一次撒太多会粘成一大坨。，看准状态再往下做。",
      "visual_cue": "疙瘩分散，颗颗浮起"
    },
    {
      "n": 7,
      "text": "煮三分钟到疙瘩熟透，淋入蛋液画圈。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蛋液淋细线，蛋花才漂亮。，看准状态再往下做。",
      "visual_cue": "蛋花漂浮，汤面起伏"
    },
    {
      "n": 8,
      "text": "加盐调味，撒葱花淋香油关火。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后放，酸甜才平衡。，看准状态再往下做。",
      "visual_cue": "汤色红亮，葱花翠绿"
    }
  ],
  "tips": [
    "水要一点点淋进面粉，才能搅出细小疙瘩。",
    "西红柿炒出沙，汤才有浓度和酸甜味。",
    "蛋液沿锅边细线淋入，蛋花才成片。"
  ],
  "common_mistakes": [
    "一次倒水，面粉全结成大团。，这一点很关键。",
    "疙瘩下锅不搅，粘成一块面饼。，这一点很关键。",
    "盐放太早，西红柿不出汁。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "西红柿",
      "substitute": "菠菜",
      "ratio": "200 克:200 克",
      "note": "更清爽，酸味减少。"
    },
    {
      "original": "面粉",
      "substitute": "玉米面",
      "ratio": "200 克:180 克",
      "note": "口感粗一些，需多加五十毫升水。"
    }
  ],
  "variations": [
    "加一勺肉末，鲜味更浓。，这一点很关键。",
    "放几片白菜叶，冬天吃更熨帖。，这一点很关键。"
  ],
  "serving_suggestion": "热汤配咸菜，早餐或夜宵都合适。，这一点很关键。",
  "storage": "冷藏一天，复热加水煮开。，这一点很关键。",
