  "equipment": [
    "汤锅",
    "炒锅",
    "刀",
    "砧板",
    "汤勺",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪骨用清水泡三十分钟去血水，中途换一次水。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡过的骨头熬出来汤清，腥味也小。",
      "visual_cue": "骨头颜色发白，水微红"
    },
    {
      "n": 2,
      "text": "猪骨冷水下锅，加料酒与两片姜煮开，撇净浮沫后捞出冲净。",
      "time_min": 10,
      "heat": "大火",
      "tip": "一定要冷水下锅，热水下锅血沫锁在骨头里。",
      "visual_cue": "浮沫撇净，骨头表面干净"
    },
    {
      "n": 3,
      "text": "汤锅加两升清水放猪骨，大火烧开后转小火炖四十分钟。",
      "time_min": 42,
      "heat": "小火",
      "tip": "汤底是这锅菜的基础，时间不能省。",
      "visual_cue": "汤色微白，骨头能出味"
    },
    {
      "n": 4,
      "text": "酸菜切成细丝，用清水漂洗两遍去掉过分酸味，攥干水分。",
      "time_min": 9,
      "heat": "无火",
      "tip": "洗两遍去过分酸味，攥干才不会把汤搞稀。",
      "visual_cue": "酸菜丝干爽，酸味柔和"
    },
    {
      "n": 5,
      "text": "五花肉切成半厘米厚的大片，血肠切三厘米长的段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "五花肉带皮切，炖出来才香糯。",
      "visual_cue": "肉片厚度一致，血肠段完整"
    },
    {
      "n": 6,
      "text": "炒锅倒植物油，下姜片、蒜与干辣椒炒香，倒入酸菜丝炒三分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酸菜先炒去生酸味，炖出来才醇。",
      "visual_cue": "酸菜丝断生，酸香浓"
    },
    {
      "n": 7,
      "text": "把炒好的酸菜倒进骨头汤，加五花肉片，小火炖二十五分钟。",
      "time_min": 26,
      "heat": "小火",
      "tip": "肉和酸菜一起炖，酸味才会渗进肉里。",
      "visual_cue": "五花肉酥软，汤面浮油"
    },
    {
      "n": 8,
      "text": "放入血肠段，保持小火焖八分钟，水面微沸即可别让它滚开。",
      "time_min": 9,
      "heat": "小火",
      "tip": "血肠一滚就散，只能小火浸透。",
      "visual_cue": "血肠鼓起完整，表皮不破"
    },
    {
      "n": 9,
      "text": "加盐、生抽与白胡椒调味，撒葱段即可连锅端上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先喝一口汤再补盐，酸菜本身带咸。",
      "visual_cue": "汤色奶白微黄，浮着油花"
    }
  ],
  "tips": [
    "正宗杀猪菜还有白肉、血肠、拆骨肉，家常做这三样就够。",
    "酸菜一次可以多切点，冷藏能放一周，随时添。",
    "血肠买现成的就行，切片后别久煮。",
    "剩下的汤第二天煮手擀面，比什么都香。"
  ],
  "common_mistakes": [
    "酸菜不炒直接下汤，生酸味冲，汤也不香。",
    "血肠跟肉一起下锅炖，煮到后面全散成渣。",
    "全程大火滚，血肠破裂、汤也浑。"
  ],
  "substitutions": [
    {
      "original": "血肠",
      "substitute": "猪血",
      "ratio": "300克:300克",
      "note": "切成厚片，焖制时间减三分钟。"
    },
    {
      "original": "猪骨",
      "substitute": "排骨",
      "ratio": "500克:600克",
      "note": "炖制时间减十分钟，肉可同吃。"
    }
  ],
  "variations": [
    "加一把冻豆腐同炖，吸满汤汁，比肉还受欢迎。",
    "把五花肉换成拆骨肉，更接近东北杀猪当天的吃法。"
  ],
  "serving_suggestion": "四人份一大锅，配蒜泥和一碗米饭，冬天最实在。",
  "storage": "冷藏两天内吃完，复热须滚透；血肠不宜反复加热，第二次吃时最后再下。",
