  "equipment": [
    "铁锅",
    "砧板",
    "刀",
    "锅铲",
    "汤勺",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鹅肉剁成大块，冷水浸泡一小时，中途换两次水，把血水泡出来。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡血水是去腥的第一关，泡不透的鹅肉炖出来会发腥发柴。",
      "visual_cue": "泡肉的水由淡红转为清浅"
    },
    {
      "n": 2,
      "text": "鹅肉冷水下锅，加料酒与姜片，大火煮开撇净浮沫，捞出用温水冲净。",
      "time_min": 12,
      "heat": "大火",
      "tip": "浮沫一定要撇到水清，这层沫子就是腥味的来源。",
      "visual_cue": "水面浮起一层灰褐色的沫"
    },
    {
      "n": 3,
      "text": "铁锅放植物油烧至微热，下葱段、姜片、大蒜炒香，加黄豆酱、八角、干辣椒与花椒炒出酱香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "酱要炒透才出香，火大了容易糊锅发苦，宁可小火慢炒。",
      "visual_cue": "酱料起小泡，香味直冲鼻子"
    },
    {
      "n": 4,
      "text": "倒入鹅肉块大火翻炒五分钟，让每块肉都裹上酱色，加冰糖、生抽与老抽炒匀。",
      "time_min": 7,
      "heat": "大火",
      "tip": "翻炒要勤，让酱色挂匀每一块，颜色才统一好看。",
      "visual_cue": "鹅肉块表面泛出油亮的红褐色"
    },
    {
      "n": 5,
      "text": "加清水没过鹅肉，大火烧开后转小火慢炖五十分钟，中途撇一次浮油。",
      "time_min": 55,
      "heat": "小火",
      "tip": "老鹅肉纤维粗，炖足时间才咬得动，火候太小也要保持微沸。",
      "visual_cue": "汤面微微冒泡，鹅肉用筷子能扎进"
    },
    {
      "n": 6,
      "text": "土豆去皮切滚刀块下锅，继续小火炖二十分钟，炖到土豆边缘发沙。",
      "time_min": 22,
      "heat": "小火",
      "tip": "土豆后放不容易煮散，边缘发沙就是吸足了汤汁。",
      "visual_cue": "土豆棱角变圆，边缘一戳就碎"
    },
    {
      "n": 7,
      "text": "粉条用温水泡软后下锅，再炖十分钟至粉条透明，加盐调味。",
      "time_min": 13,
      "heat": "小火",
      "tip": "粉条最后放，放早了会吸干汤汁，糊成一团。",
      "visual_cue": "粉条通体透明，汤色浓稠"
    },
    {
      "n": 8,
      "text": "撒上香菜，连锅端上桌，锅边可以贴一圈饼子一起焖。",
      "time_min": 2,
      "heat": "无火",
      "tip": "铁锅保温好，端上桌还在咕嘟，吃到后半程更入味。",
      "visual_cue": "热气腾腾，香菜翠绿浮在汤面"
    }
  ],
  "tips": [
    "东北人炖大鹅讲究用大铁锅，锅壁厚、受热匀，炖出来的汤不糊底。",
    "鹅肉比鸡肉耐炖，一岁以上的老鹅至少要炖一小时以上才烂。",
    "剩下的汤别倒，第二天下面条或者炖土豆都是极好的浇头。"
  ],
  "common_mistakes": [
    "鹅肉没泡血水直接下锅，炖出来的汤发黑发腥，怎么补救都盖不住。",
    "火候一直用大火猛滚，汤汁很快收干，鹅肉外面烂里面还硬。",
    "粉条和土豆同时下锅，土豆没熟粉条已经糊成糊状。"
  ],
  "substitutions": [
    {
      "original": "鹅肉",
      "substitute": "土鸡",
      "ratio": "2000克:1800克",
      "note": "土鸡更容易熟，炖的时间减到三十五分钟。"
    },
    {
      "original": "粉条",
      "substitute": "粉丝",
      "ratio": "200克:150克",
      "note": "粉丝更细，下锅后只需煮三分钟。"
    }
  ],
  "variations": [
    "喜欢辣味的可以在炒酱时加两勺豆瓣酱，汤色更红，咸香更重。",
    "把土豆换成酸菜同炖，酸味解腻，是黑龙江一带的吃法。"
  ],
  "serving_suggestion": "端上桌趁热吃，先喝一碗汤再动肉，配一碗白米饭或者贴饼子都是东北人的标配。",
  "storage": "冷藏可存三天，冷冻可存一个月；复热时加半碗清水，小火慢烧到滚开，别用微波炉直接打。",
