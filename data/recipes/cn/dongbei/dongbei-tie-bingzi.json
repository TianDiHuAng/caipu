  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "玉米面",
          "name_en": "cornmeal",
          "amount": 300,
          "unit": "g",
          "note": "细玉米面",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 100,
          "unit": "g",
          "note": "中筋",
          "optional": false
        }
      ]
    },
    {
