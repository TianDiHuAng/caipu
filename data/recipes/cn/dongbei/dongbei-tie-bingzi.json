          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "刷锅防粘",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "铁锅",
    "大碗",
    "锅铲",
    "蒸布",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米面与面粉倒进大碗，加白砂糖与盐，用筷子搅匀至没有结块。",
      "time_min": 3,
      "heat": "无火",
      "tip": "两种面粉先混匀再加水，不然玉米面容易结小疙瘩。",
      "visual_cue": "粉料颜色均匀，无干粉团"
    },
    {
      "n": 2,
      "text": "酵母用三十度左右的温水化开，倒进粉料里边倒边搅成絮状。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水温用手背试，温热不烫就行，太烫会把酵母烫死。",
      "visual_cue": "面团呈絮状，松散不粘碗壁"
    },
    {
      "n": 3,
      "text": "揉成光滑面团，盖上湿布放在温暖处发酵到两倍大，内部布满气孔。",
      "time_min": 60,
      "heat": "无火",
      "tip": "冬天放暖气边或者温水锅上，温度低就多发一会儿。",
      "visual_cue": "面团鼓起，按下去缓慢回弹"
    },
    {
      "n": 4,
      "text": "面团取出揉两分钟排气，分成八个小剂子，搓圆后压成一厘米厚的饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "排气揉透了饼才不塌，剂子大小一致熟得才均匀。",
      "visual_cue": "饼坯厚薄一致，表面光滑"
    },
    {
      "n": 5,
      "text": "铁锅底部刷一层植物油，饼坯贴锅边摆一圈，加半碗清水盖盖焖十五分钟。",
      "time_min": 18,
      "heat": "小火",
      "tip": "水别多，半碗刚好，靠蒸汽把饼焖熟，水干了容易糊底。",
      "visual_cue": "锅边滋滋响，饼底结薄壳"
    },
    {
      "n": 6,
      "text": "开盖转中火烙两分钟，让饼底结出金黄焦壳，用铲子轻推能滑动即可。",
      "time_min": 4,
      "heat": "中火",
      "tip": "最后这一步是脆底的关键，火太大会焦苦，中小火慢慢来。",
      "visual_cue": "饼底金黄，边缘微微翘起"
    }
  ],
  "tips": [
    "贴饼子讲究一半玉米面一半白面，全用玉米面会硬得咬不动。",
    "锅边贴饼子时手上抹点水，饼坯不容易粘手，贴得也更服帖。",
    "贴饼子最配炖菜，锅底炖大鹅或者炖鱼，饼子吸汤最香。"
  ],
  "common_mistakes": [
    "酵母用滚水化开，面团发不起来，烙出来是死面饼，硬得硌牙。",
    "面团发好后不排气，饼里全是大气孔，切开像蜂窝。",
    "焖的时候水放太多，饼底泡在汤里，出不来焦壳。"
  ],
  "substitutions": [
    {
      "original": "玉米面",
      "substitute": "小米面",
      "ratio": "300克:300克",
      "note": "小米面更细腻，口感偏软，水要少加两勺。"
    },
    {
      "original": "白砂糖",
      "substitute": "蜂蜜",
      "ratio": "10克:12克",
      "note": "蜂蜜先用水化开再和面，发酵更快。"
    }
  ],
  "variations": [
    "掺一把豆面进去，豆香更足，是吉林农村常见的老做法。",
    "把饼坯擀薄做成薄脆饼，烙到两面金黄，卷菜吃更有嚼头。"
  ],
  "serving_suggestion": "刚出锅的贴饼子掰开冒热气，配一碗炖菜或者疙瘩汤，就是东北人最踏实的一顿。",
  "storage": "常温放一天，冷藏可存三天；复热时蒸五分钟或者用平底锅小火烘一下，能找回脆底。",
