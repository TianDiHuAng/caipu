    "刀",
    "砧板",
    "漏勺",
    "盘子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红薯削皮，切成滚刀块，大小尽量一致。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "大小一致，炸的时间才同步。，看准状态再往下做。",
      "visual_cue": "块形方正，无碎渣，这一点很关键。"
    },
    {
      "n": 2,
      "text": "切好的红薯用清水冲一遍，沥干表面水分。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "带水下油锅会溅油，务必沥干。，看准状态再往下做。",
      "visual_cue": "表面干爽，不滴水，这一点很关键。"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，下红薯中火炸。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "中火慢炸，里面才粉糯。，看准状态再往下做。",
      "visual_cue": "表面定型，边缘起泡"
    },
    {
      "n": 4,
      "text": "炸到筷子能轻松插入，捞出沥油。，看准状态再往下做。",
      "time_min": 7,
      "heat": "中火",
      "tip": "能插透就熟，炸过头会发干。，看准状态再往下做。",
      "visual_cue": "外皮金黄，手感轻软"
    },
    {
      "n": 5,
      "text": "另起锅放白糖和清水，小火慢慢熬化。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "水别多，糖水约四比一。，看准状态再往下做。",
      "visual_cue": "糖水清亮，气泡细密"
    },
    {
      "n": 6,
      "text": "熬到糖浆变浅黄、能拉出细丝就关小火。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "颜色一变黄就下料，深了发苦。，看准状态再往下做。",
      "visual_cue": "糖浆金黄，拉丝不断"
    },
    {
      "n": 7,
      "text": "倒入红薯块快速翻拌，让糖浆均匀裹住。，看准状态再往下做。",
      "time_min": 2,
      "heat": "小火",
      "tip": "动作要快，糖凉了裹不匀。，看准状态再往下做。",
      "visual_cue": "块块亮晶晶，糖丝拉长"
    },
    {
      "n": 8,
      "text": "撒白芝麻，盛在抹了油的盘子里上桌。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘子抹油，凉了才不粘底。，看准状态再往下做。",
      "visual_cue": "糖丝可拉长，芝麻均匀"
    }
  ],
  "tips": [
    "红薯沥干水下锅，避免热油飞溅。，这一点很关键。",
    "糖浆变浅黄立刻下料，颜色深了发苦。",
    "装盘前把盘子抹一层油，凉了不粘。"
  ],
  "common_mistakes": [
    "糖熬过头，整盘带焦苦味。，这一点很关键。",
    "红薯没炸透，里面还硬。，这一点很关键。",
    "盘子不抹油，凉了抠不下来。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "红薯",
      "substitute": "土豆",
      "ratio": "700 克:700 克",
      "note": "口感更粉，炸的时间加两分钟。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "130 克:140 克",
      "note": "糖丝更长，化得慢。"
    }
  ],
  "variations": [
    "换成香蕉，做成拔丝香蕉。，这一点很关键。",
    "蘸凉开水吃，糖壳更脆。，这一点很关键。"
  ],
  "serving_suggestion": "趁热上桌，配一碗凉水蘸着吃。，这一点很关键。",
  "storage": "当日吃完，冷藏后糖壳返砂。，这一点很关键。",
