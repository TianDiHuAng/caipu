  "steps": [
    {
      "n": 1,
      "text": "干豆腐切成十五厘米见方的片，用开水焯三十秒捞出晾凉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "焯过水干豆腐变软有韧性，卷的时候不易裂。",
      "visual_cue": "豆腐片柔软发亮，无豆腥"
    },
    {
      "n": 2,
      "text": "五花肉剁成带颗粒的粗粒，姜剁末，小葱切碎一起装碗。",
      "time_min": 7,
      "heat": "无火",
      "tip": "馅料剁粗一点，卷起来更有口感。",
      "visual_cue": "馅料带颗粒，葱姜拌匀"
    },
    {
      "n": 3,
      "text": "粗粒肉加生抽、盐、白胡椒与淀粉，顺一个方向搅打上劲。",
      "time_min": 5,
      "heat": "无火",
      "tip": "加淀粉能让馅料蒸后抱团，不会散在豆腐皮里。",
      "visual_cue": "馅料发黏上劲，能整团提起"
    },
    {
      "n": 4,
      "text": "胡萝卜切细丝，香菜切段，蒜剁末，放入香油拌成一小碟配菜。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蒜末最后拌，香油能封住辛辣，更香不冲。",
      "visual_cue": "小菜油亮，丝条均匀"
    },
    {
      "n": 5,
      "text": "豆腐片摊开，靠一侧铺一层调好的粗粒肉，再放胡萝卜丝与香菜。",
      "time_min": 8,
      "heat": "无火",
      "tip": "馅别铺太满，留出两厘米边缘才好卷。",
      "visual_cue": "馅料平整铺开，边缘留白"
    },
    {
      "n": 6,
      "text": "从铺馅的一侧卷起，卷紧成筒，接口朝下用牙签固定。",
      "time_min": 5,
      "heat": "无火",
      "tip": "卷得紧蒸后才不散，接口朝下能自己粘住。",
      "visual_cue": "豆卷紧实挺立，两端不漏馅"
    },
    {
      "n": 7,
      "text": "蒸锅水烧开，豆卷摆进蒸屉，中火蒸十分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "水开后再上锅，馅料才嫩不柴。",
      "visual_cue": "蒸汽充足，豆卷鼓起"
    },
    {
      "n": 8,
      "text": "取出豆卷晾五分钟，拔掉牙签，斜刀切成两厘米厚的段。",
      "time_min": 7,
      "heat": "无火",
      "tip": "晾一会再切，切面才整齐不留碎渣。",
      "visual_cue": "切面平整，馅料与豆皮层次分明"
    },
    {
      "n": 9,
      "text": "豆卷段摆盘，淋上生抽与香油，配辣椒油蘸碟上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蘸汁另放，吃的时候再蘸才不软。",
      "visual_cue": "卷段整齐码放，酱汁清亮"
    }
  ],
  "tips": [
    "干豆腐要挑薄的，厚的卷不动，也蒸不透。",
    "馅料可以换成素的，香菇胡萝卜木耳拌一起也香。",
    "一次多做几卷冷藏，吃前蒸五分钟即可。",
    "蘸料除了辣椒油，加点蒜泥和醋更解腻。"
  ],
  "common_mistakes": [
    "馅料铺太厚，卷起来中间蒸不透，还会撑破豆皮。",
    "馅料铺太厚，卷起来中间蒸不透，还会撑破豆皮。",
    "蒸完立刻切，馅料烫软，切面全散。"
  ],
