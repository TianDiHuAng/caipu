  "equipment": [
    "大碗",
    "刀",
    "砧板",
    "筷子",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净，先斜切片再改刀成细丝。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "现切现拌，黄瓜才脆不出水。，看准状态再往下做。",
      "visual_cue": "丝条均匀，断面水润"
    },
    {
      "n": 2,
      "text": "青椒去籽去筋，切成细丝备用。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "去净白筋，辣味才不冲。，看准状态再往下做。",
      "visual_cue": "丝条细长，颜色翠绿"
    },
    {
      "n": 3,
      "text": "大葱只取葱白，切成细丝抖散。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "葱白辛辣带甜，是这道菜的灵魂。，看准状态再往下做。",
      "visual_cue": "丝条蓬松，不粘连，这一点很关键。"
    },
    {
      "n": 4,
      "text": "香菜洗净切段，大蒜剁成细末。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜末剁细，味道才融进汁里。，看准状态再往下做。",
      "visual_cue": "末粒均匀，香气扑鼻"
    },
    {
      "n": 5,
      "text": "小碗放生抽、香醋、白糖和盐搅匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要搅化，酸甜才平衡。，看准状态再往下做。",
      "visual_cue": "汁色清亮，无糖粒，这一点很关键。"
    },
    {
      "n": 6,
      "text": "黄瓜丝、青椒丝和葱丝放一起，淋调味汁。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先淋汁抓匀，让丝条都沾上味。，看准状态再往下做。",
      "visual_cue": "丝条挂汁，颜色鲜亮"
    },
    {
      "n": 7,
      "text": "加蒜末、辣椒油和香油，快速拌匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "辣椒油最后放，香气才冲。，看准状态再往下做。",
      "visual_cue": "油光发亮，红油浮面"
    },
    {
      "n": 8,
      "text": "撒香菜段装盘，拌好就吃不要久放。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "久放出水，脆感全无。，看准状态再往下做。",
      "visual_cue": "盘中干爽，颜色分明"
    }
  ],
  "tips": [
    "黄瓜现切现拌，放久了会出水变软。",
    "葱白要抖散，粘在一起影响口感。，这一点很关键。",
    "辣椒油最后淋，香气更冲。，这一点很关键。"
  ],
  "common_mistakes": [
    "提前拌好，出水变成一盘汤。，这一点很关键。",
    "青椒不去筋，辣得下不去口。，这一点很关键。",
    "葱丝切太粗，嚼起来冲鼻。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "尖椒",
      "ratio": "150 克:150 克",
      "note": "更辣，用量可减半。"
    },
    {
      "original": "香醋",
      "substitute": "陈醋",
      "ratio": "20 毫升:18 毫升",
      "note": "颜色深，酸味更厚。"
    }
  ],
  "variations": [
    "加一把花生米，口感更丰富。，这一点很关键。",
    "放几片熟肉丝，荤素搭配。，这一点很关键。"
  ],
  "serving_suggestion": "配烧烤或大肉菜解腻最好。，这一点很关键。",
  "storage": "冷藏半天，吃前倒掉汤汁。，这一点很关键。",
