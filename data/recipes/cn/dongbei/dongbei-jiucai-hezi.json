  "equipment": [
    "平底锅",
    "大碗",
    "擀面杖",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒进盆里，一边倒开水一边用筷子搅成絮。，看准状态再往下做。",
      "time_min": 7,
      "heat": "无火",
      "tip": "开水烫面，皮才软不硬。，看准状态再往下做。",
      "visual_cue": "面粉成团，无干粉，这一点很关键。"
    },
    {
      "n": 2,
      "text": "稍凉后揉成光滑面团，盖布醒三十分钟。，看准状态再往下做。",
      "time_min": 32,
      "heat": "无火",
      "tip": "醒够时间，擀的时候才不回缩。，看准状态再往下做。",
      "visual_cue": "面团柔软，表面光洁"
    },
    {
      "n": 3,
      "text": "粉丝用温水泡软，捞出沥干切成小段。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "粉丝切短，包的时候不扎破皮。，看准状态再往下做。",
      "visual_cue": "粉丝柔软，段长均匀"
    },
    {
      "n": 4,
      "text": "鸡蛋打散炒成碎块，放凉备用。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蛋要放凉再拌，热的会把韭菜烫黄。，看准状态再往下做。",
      "visual_cue": "蛋碎松散，颜色金黄"
    },
    {
      "n": 5,
      "text": "韭菜切末，先拌香油再和粉丝鸡蛋混合。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "先裹油锁水，韭菜才不出汤。，看准状态再往下做。",
      "visual_cue": "馅料油润，不出水，这一点很关键。"
    },
    {
      "n": 6,
      "text": "加盐和五香粉拌匀，尝一下咸淡。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后放，早放韭菜就塌了。，看准状态再往下做。",
      "visual_cue": "馅料松散，咸香扑鼻"
    },
    {
      "n": 7,
      "text": "面团搓条切段，擀成中间厚边缘薄的圆皮。，看准状态再往下做。",
      "time_min": 9,
      "heat": "无火",
      "tip": "中间厚一点，包馅才不破底。，看准状态再往下做。",
      "visual_cue": "皮薄透光，边缘略薄"
    },
    {
      "n": 8,
      "text": "包入馅料对折，边缘捏紧再捏出花边。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "边缘捏牢，煎的时候才不会漏汤。，看准状态再往下做。",
      "visual_cue": "半月形饱满，边缘紧实"
    },
    {
      "n": 9,
      "text": "平底锅抹植物油，中小火两面各煎三分钟。，看准状态再往下做。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "中小火煎，皮才酥里面熟。，看准状态再往下做。",
      "visual_cue": "两面金黄，皮起小泡"
    }
  ],
  "tips": [
    "用开水烫面，皮凉了也不硬。，这一点很关键。",
    "韭菜先拌香油锁水，包的时候才不出汤。",
    "中小火慢煎，火大了皮焦馅不熟。，这一点很关键。"
  ],
  "common_mistakes": [
    "盐早放，韭菜出水把皮泡烂。，这一点很关键。",
    "皮擀太薄，包的时候全破。，这一点很关键。",
    "大火煎，外皮焦黑里面还是生的。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "小白菜",
      "ratio": "350 克:350 克",
      "note": "需挤干水分，加一勺油。"
    },
    {
      "original": "粉丝",
      "substitute": "木耳",
      "ratio": "60 克:60 克",
      "note": "泡发切碎，口感更脆。"
    }
  ],
  "variations": [
    "加一把虾皮，鲜味更足。，这一点很关键。",
    "馅里放点猪肉末，更香更饱腹。，这一点很关键。"
  ],
  "serving_suggestion": "趁热吃，配一碗小米粥。，这一点很关键。",
  "storage": "冷藏两天，冷冻两周；复热平底锅小火煎或蒸五分钟。",
