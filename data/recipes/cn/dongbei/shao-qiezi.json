    "笊篱",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净去蒂，切成三厘米左右的滚刀块放入盆中。",
      "time_min": 8,
      "heat": "无火",
      "tip": "滚刀块受热面多，烧出来更入味。",
      "visual_cue": "块形不规则、大小接近"
    },
    {
      "n": 2,
      "text": "茄子块撒上盐抓匀，静置十分钟逼出内部水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "杀水后茄子不易吸油也更软。",
      "visual_cue": "茄块出水塌软、体积缩小"
    },
    {
      "n": 3,
      "text": "把茄块捞出挤干水分，撒上玉米淀粉抓匀裹一层薄粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄粉是少吸油的关键一步。",
      "visual_cue": "茄块干爽、表面泛白粉层"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到五成热，茄块下锅中火煎到表面发软。",
      "time_min": 5,
      "heat": "中火",
      "tip": "别急着翻，底面定型再动。",
      "visual_cue": "茄块金黄、筷子能轻松戳透"
    },
    {
      "n": 5,
      "text": "把煎好的茄块拨到锅边，用余油煸香蒜片与青椒块。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蒜片煸出香味再下调味料。",
      "visual_cue": "蒜片微黄、青椒断生"
    },
    {
      "n": 6,
      "text": "加生抽、老抽、白糖与清水烧开，翻匀让茄块上色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "糖只要一点，用来提鲜不显甜。",
      "visual_cue": "汤汁红褐、茄块吸色均匀"
    },
    {
      "n": 7,
      "text": "转中小火烧三分钟收汁，汤汁浓稠时撒葱花出锅。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "收汁到挂勺就停，久烧茄子要烂。",
      "visual_cue": "汤汁浓稠挂块、茄块完整不散"
    }
  ],
  "tips": [
    "长茄子皮薄肉嫩，比圆茄子更适合烧。",
    "茄子先用盐杀水，能省一半的油。",
    "出锅前淋几滴香油，整盘菜的香味会更浓一些。"
  ],
  "common_mistakes": [
    "茄子不杀水直接下锅，一锅油全被吸干。",
    "一直大火猛烧，茄子散成泥糊在锅底。",
    "盐和生抽一起放太多，成品咸得发苦。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "豆角",
      "ratio": "500g 对 350g",
      "note": "需先焯水两分钟再烧。"
    },
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "60g 对 60g",
      "note": "甜度更高，辣味更淡。"
    }
  ],
  "variations": [
    "加一勺黄豆酱同烧，酱香更浓更下饭。",
    "最后撒一把蒜末，蒜香冲鼻更开胃。"
  ],
  "serving_suggestion": "浇在热米饭上吃最香，茄子软糯吸汁最下饭。",
  "storage": "冷藏可放两天，复热后加一点水防干锅。",
