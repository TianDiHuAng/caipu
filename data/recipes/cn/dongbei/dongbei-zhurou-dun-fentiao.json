  "steps": [
    {
      "n": 1,
      "text": "干粉丝用温水泡三十分钟，泡到能弯折不断。，看准状态再往下做。",
      "time_min": 34,
      "heat": "无火",
      "tip": "粉丝提前泡软，炖的时候才不吸干汤。",
      "visual_cue": "粉丝柔软透明，有弹性"
    },
    {
      "n": 2,
      "text": "五花肉切成三厘米见方的块，肥瘦分开。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块别太小，炖久了会缩水散架。，看准状态再往下做。",
      "visual_cue": "块形方正，肥瘦分明"
    },
    {
      "n": 3,
      "text": "炖锅倒植物油，先下肥肉块小火煸出油。，看准状态再往下做。",
      "time_min": 6,
      "heat": "小火",
      "tip": "煸出猪油，炖出来才香不腻。，看准状态再往下做。",
      "visual_cue": "肉块边缘微黄，油析出"
    },
    {
      "n": 4,
      "text": "下瘦肉块炒到变色，加冰糖炒出糖色。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "糖色炒到枣红就下料，过了发苦。，看准状态再往下做。",
      "visual_cue": "肉块裹色，油面红亮"
    },
    {
      "n": 5,
      "text": "加姜片、葱段和八角炒香，淋料酒和生抽老抽。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "料酒沿锅边淋，去腥更彻底。，看准状态再往下做。",
      "visual_cue": "酱香扑鼻，肉块上色"
    },
    {
      "n": 6,
      "text": "倒清水没过肉块，大火烧开转小火炖二十分钟。，看准状态再往下做。",
      "time_min": 24,
      "heat": "小火",
      "tip": "水一次加够，中途加水汤就淡了。，看准状态再往下做。",
      "visual_cue": "汤面微沸，肉块上浮"
    },
    {
      "n": 7,
      "text": "下泡好的粉丝，小火再炖十五分钟。，看准状态再往下做。",
      "time_min": 16,
      "heat": "小火",
      "tip": "粉丝后放，久炖就烂成糊。，看准状态再往下做。",
      "visual_cue": "粉丝透明，吸饱汤汁"
    },
    {
      "n": 8,
      "text": "加盐调味，转中火收浓汤汁。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "粉丝吸盐快，盐要最后补。，看准状态再往下做。",
      "visual_cue": "汤汁浓稠，挂勺不流"
    },
    {
      "n": 9,
      "text": "撒葱段，盛出连汤带粉一起上桌。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃，粉丝凉了就坨。，看准状态再往下做。",
      "visual_cue": "汤色酱红，粉丝油亮"
    }
  ],
  "tips": [
    "粉丝要提前泡软，直接下锅会吸干汤。",
    "五花肉先煸出油，成品才香不腻。，这一点很关键。",
    "粉丝后放十五分钟即可，久炖易烂。"
  ],
  "common_mistakes": [
    "粉丝没泡直接炖，汤全被吸干。，这一点很关键。",
    "糖色炒过头，整锅发苦。，这一点很关键。",
    "水加太少，中途添水汤味变淡。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "500 克:500 克",
      "note": "更瘦，煸油时补一勺植物油。"
    },
    {
      "original": "粉条",
      "substitute": "宽粉",
      "ratio": "200 克:200 克",
      "note": "更耐炖，可多炖五分钟。"
    }
  ],
  "variations": [
    "加半棵酸菜同炖，酸香解腻。，这一点很关键。",
    "放几个干辣椒，微辣更下饭。，这一点很关键。"
  ],
  "serving_suggestion": "盛一大碗，配米饭或贴饼子。，这一点很关键。",
  "storage": "冷藏两天，冷冻两周；复热加水小火煮开。",
