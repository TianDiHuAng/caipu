  "steps": [
    {
      "n": 1,
      "text": "干豆腐放进开水里烫三十秒去豆腥，捞出立刻过凉水，沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "烫的时间别长，久了干豆腐发硬，拌出来像嚼皮筋。",
      "visual_cue": "干豆腐变软，表面不再黏手"
    },
    {
      "n": 2,
      "text": "把干豆腐叠起来切成两毫米宽的细丝，切好后用手轻轻抖散装盆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刀要快，一刀到底，来回拉锯会把丝切得毛糙发碎。",
      "visual_cue": "丝条粗细一致，不粘不结块"
    },
    {
      "n": 3,
      "text": "黄瓜切细丝，香菜切段，大蒜拍碎切末，葱白切细丝备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄瓜现切现拌，切早了会出水，把料汁冲淡。",
      "visual_cue": "黄瓜丝挺括，切面水润"
    },
    {
      "n": 4,
      "text": "生抽、米醋、白砂糖、盐与蒜末调成料汁，搅到糖和盐完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖盐先化开再拌，不然咸淡不匀，底下咸上面淡。",
      "visual_cue": "料汁清亮，碗底不见未化的颗粒"
    },
    {
      "n": 5,
      "text": "干豆腐丝与黄瓜丝倒入料汁拌匀，静置五分钟让丝吸足味道。",
      "time_min": 7,
      "heat": "无火",
      "tip": "静置这五分钟很关键，刚拌好不入味，等一会儿咸香才匀。",
      "visual_cue": "丝条颜色变深，盆底见少量汁"
    },
    {
      "n": 6,
      "text": "淋上辣椒油与香油，撒香菜与葱丝，再翻拌两下装盘上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "油最后淋，香气才留得住，早淋会被料汁冲散。",
      "visual_cue": "红油挂丝，葱丝香菜翠绿"
    }
  ],
  "tips": [
    "干豆腐要买厚一点的，太薄的烫完就烂，切丝也立不住。",
    "料汁的酸甜比按四比三调，喜欢酸口的米醋可以再添半勺。",
    "拌好放冰箱冷藏十分钟，吃起来更清口，夏天尤其合适。"
  ],
  "common_mistakes": [
    "干豆腐不烫直接拌，豆腥味明显，吃到嘴里发闷。",
    "料汁一股脑倒进去不搅，糖沉底，吃到最后一口特别咸。",
    "黄瓜提前一小时切好放着，出水后整盘菜变成汤。"
  ],
  "substitutions": [
    {
      "original": "干豆腐",
      "substitute": "豆腐皮",
      "ratio": "400克:400克",
      "note": "豆腐皮更薄，烫十秒即可，拌时轻一些防碎。"
    },
    {
      "original": "辣椒油",
      "substitute": "辣椒面",
      "ratio": "25毫升:10克",
      "note": "用辣椒面需浇一勺热油泼香再拌。"
    }
  ],
  "variations": [
    "加一把焯过水的木耳丝，口感更丰富，颜色也更好看。",
    "喜欢麻味的可以加半勺花椒油，与辣椒油一起淋，麻辣清爽。"
  ],
  "serving_suggestion": "作为冷盘先上，配粥、配面、配大米饭都合适，夏天冰镇后更受欢迎。",
  "storage": "冷藏可存一天，隔夜后黄瓜会出水，味道变淡；不建议冷冻，解冻后干豆腐发渣。",
