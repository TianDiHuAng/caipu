  "steps": [
    {
      "n": 1,
      "text": "五花肉整块放在案板上，用刀把皮上的残毛刮净，冷水浸泡三十分钟去血水。",
      "time_min": 30,
      "heat": "无火",
      "tip": "皮刮得越干净，成菜越没有毛腥味，刮完再冲一遍。",
      "visual_cue": "泡肉的水由浅粉转为微清，肉色发白"
    },
    {
      "n": 2,
      "text": "肉块冷水下锅，加料酒与姜片，大火煮十五分钟定形，捞出用厨房纸擦干表皮。",
      "time_min": 18,
      "heat": "大火",
      "tip": "表皮一定要擦干，带水下锅煎会炸油溅手。",
      "visual_cue": "肉块表面收紧，按压有弹性"
    },
    {
      "n": 3,
      "text": "锅内放植物油，肉皮朝下小火煎到金黄起小泡，四边也翻面煎一下。",
      "time_min": 8,
      "heat": "小火",
      "tip": "这一步煎出皮下的油脂，皮才会起皱吸汁，别用大火。",
      "visual_cue": "肉皮煎到金黄，表面鼓起细小气泡"
    },
    {
      "n": 4,
      "text": "另起锅放少量清水与冰糖，小火熬成枣红色糖色，冒细密小泡时即可。",
      "time_min": 8,
      "heat": "小火",
      "tip": "糖色炒过头发苦，颜色到枣红就立刻冲水降温。",
      "visual_cue": "糖浆枣红透亮，泡小且密"
    },
    {
      "n": 5,
      "text": "糖色中冲入清水，加生抽、老抽、葱段、姜片、大蒜、八角、桂皮、香叶与盐，放入肉块。",
      "time_min": 10,
      "heat": "大火",
      "tip": "香料别放太多，压过肉香就成了卤味，量按方子来。",
      "visual_cue": "汤色红亮，香料浮在汤面"
    },
    {
      "n": 6,
      "text": "大火烧开后转小火炖九十分钟，中途给肉块翻面两次，让上下都上色。",
      "time_min": 92,
      "heat": "小火",
      "tip": "保持汤面微微冒泡，翻面能避免贴锅的一面颜色发黑。",
      "visual_cue": "筷子能轻松插透肉块，拔出不留阻力"
    },
    {
      "n": 7,
      "text": "肉块取出晾两分钟，切成一厘米厚的大片装盘，原汤大火收浓浇在肉上。",
      "time_min": 8,
      "heat": "中火",
      "tip": "收汁收到挂勺即可，太稠会凝固成胶，浇上去发暗。",
      "visual_cue": "汤汁浓稠挂勺，肉片油亮"
    }
  ],
  "tips": [
    "扒肉是东北八大碗的头牌，讲究皮糯肉烂、肥而不腻、入口即化。",
    "糖色是这道菜的色，宁可浅一点也别炒糊，糊了整锅都是苦味。",
    "切肉片时刀要快，一刀到底，压着切会让肥瘦分离。"
  ],
  "common_mistakes": [
    "肉皮没煎直接炖，皮软塌不吸汁，吃起来像一块白煮肉。",
    "糖色炒成深褐色才冲水，成品发苦，汤色也发黑。",
    "炖的时间不够就切片，肉片散开不成形，摆盘全塌。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "前腿肉",
      "ratio": "1200克:1200克",
      "note": "前腿肉瘦一些，炖的时间减到七十分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白砂糖",
      "ratio": "40克:40克",
      "note": "白砂糖上色更快，要盯紧火候防焦。"
    }
  ],
  "variations": [
    "把肉块换成肘子，炖的时间加四十分钟，就是东北的扒肘子。",
    "收汁时加一勺蜂蜜，成品表面更亮，甜味也更柔和。"
  ],
  "serving_suggestion": "切片装盘后浇汁，配荷叶饼或者白米饭吃，旁边放一碟拍黄瓜解腻正好。",
  "storage": "连汤冷藏可存四天，冷冻可存一个月；复热时蒸十五分钟，比下锅烧更不容易散。",
