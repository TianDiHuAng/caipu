  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "韭菜",
          "name_en": "Chinese chives",
          "amount": 250,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 4,
          "unit": "piece",
          "note": "打散",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 150,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 180,
          "unit": "ml",
          "note": "调面糊",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "煎饼",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "大碗",
    "刀",
    "砧板",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "韭菜择洗干净后充分沥干，切成半厘米长的小段。",
      "time_min": 12,
      "heat": "无火",
      "tip": "韭菜一定要沥干，水分多面糊会稀。",
      "visual_cue": "韭菜段翠绿，表面没有水珠"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加入面粉、清水、盐和生抽搅成顺滑面糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面糊调到能流动又挂得住勺的状态。",
      "visual_cue": "面糊顺滑，无干粉颗粒"
    },
    {
      "n": 3,
      "text": "把韭菜段倒进面糊里，用刮刀轻轻翻拌均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻轻拌，别用力搅，免得韭菜出水。",
      "visual_cue": "韭菜均匀裹上面糊"
    },
    {
      "n": 4,
      "text": "平底锅放植物油小火加热，舀一勺面糊摊成薄饼。",
      "time_min": 5,
      "heat": "小火",
      "tip": "面糊摊薄一点，中间才容易熟透。",
      "visual_cue": "饼面均匀摊开，边缘整齐"
    },
    {
      "n": 5,
      "text": "小火煎三分钟到饼底金黄定型，再用铲子翻面。",
      "time_min": 6,
      "heat": "小火",
      "tip": "面糊摊得薄一点，饼中间才容易熟透。",
      "visual_cue": "饼底金黄，边缘微微翘起"
    },
    {
      "n": 6,
      "text": "另一面再煎两分钟，煎到两面都均匀金黄上色。",
      "time_min": 4,
      "heat": "小火",
      "tip": "两面都煎透，里面的蛋液才凝固。",
      "visual_cue": "两面金黄，饼身鼓起"
    },
    {
      "n": 7,
      "text": "把煎好的饼切成四小块装进盘子，趁热吃最香脆。",
      "time_min": 3,
      "heat": "无火",
      "tip": "切开看看断面，没有湿面糊才算熟。",
      "visual_cue": "切面干爽，韭菜翠绿"
    }
  ],
  "tips": [
    "韭菜洗后一定要沥干，水分多面糊会稀。",
    "面糊调成能流动又挂勺的状态最好摊。",
    "小火慢煎定型后再翻面，饼才不破。"
  ],
  "common_mistakes": [
    "韭菜没沥干，面糊稀得摊不成形。",
    "火太大急着翻面，饼全碎在锅里。",
    "面糊摊得太厚，外面焦了里面还是生糊。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "香菜",
      "ratio": "250 克:150 克",
      "note": "香气更冲，用量减少。"
    },
    {
      "original": "面粉",
      "substitute": "玉米面",
      "ratio": "150 克:150 克",
      "note": "口感更粗，需多加清水。"
    }
  ],
  "variations": [
    "面糊里加一把虾皮，鲜味明显提升。",
    "淋一点辣椒油，风味更接近东北家常。"
  ],
  "serving_suggestion": "配一碗小米粥就是东北人的经典早餐，也可以卷起来当主食。",
  "storage": "冷藏一天，复热用平底锅小火两面各煎一分钟。",
