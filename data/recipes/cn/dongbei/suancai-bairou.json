  "equipment": [
    "汤锅",
    "炒锅",
    "漏勺",
    "快刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加姜片、葱段、八角和料酒，大火烧开撇沫后小火煮 45 分钟。",
      "time_min": 50,
      "heat": "小火",
      "tip": "整块煮再切，肉片才不会卷缩。",
      "visual_cue": "筷子能穿透肉皮、肉心不发红"
    },
    {
      "n": 2,
      "text": "酸菜丝用清水泡洗两遍，挤干水分，尝一片确认酸咸适中。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洗掉多余盐分，汤才不齁。",
      "visual_cue": "酸菜丝不滴水、酸味清爽"
    },
    {
      "n": 3,
      "text": "炒锅下 15ml 底油，放酸菜丝与干辣椒中火炒 5 分钟至酸香四溢。",
      "time_min": 6,
      "heat": "中火",
      "tip": "酸菜先炒再煮，酸香才被逼出来。",
      "visual_cue": "酸菜丝干爽、酸味浓郁"
    },
    {
      "n": 4,
      "text": "煮好的五花肉捞出晾 5 分钟，切成 0.3cm 的薄片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉晾凉爽手再切，片才薄而整齐。",
      "visual_cue": "肉片透光、肥瘦相连不散"
    },
    {
      "n": 5,
      "text": "把炒好的酸菜与肉片放入原汤中，加盐与白胡椒小火炖 20 分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "小火慢炖，肉片才软而不烂。",
      "visual_cue": "汤色乳白、酸香扑鼻"
    },
    {
      "n": 6,
      "text": "出锅前淋 8ml 香油，连汤带肉盛入大碗即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油别早放，出锅点香最明显。",
      "visual_cue": "汤面浮油薄亮、肉片层层码放"
    }
  ],
  "tips": [
    "五花肉整块煮再切，片薄且不卷。",
    "酸菜先炒后炖，酸香比直接下锅浓一倍。",
    "煮肉的汤不要倒，是这道菜的底汤。"
  ],
  "common_mistakes": [
    "生肉直接切片下锅，肉片又厚又硬。",
    "酸菜不泡洗直接煮，整锅汤咸到发苦。",
    "大火滚炖，肉片散开、汤变浑。，成品口感会明显变差。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "前腿肉",
      "ratio": "500g 对 500g",
      "note": "脂肪少些，炖的时间减 5 分钟。"
    },
    {
      "original": "酸菜",
      "substitute": "酸白菜",
      "ratio": "400g 对 400g",
      "note": "酸度柔和，泡洗一次即可。"
    }
  ],
  "variations": [
    "血肠版：加 200g 血肠同炖，是东北杀猪菜做法。",
    "粉丝版：加 100g 泡软粉丝，最后 5 分钟下锅。"
  ],
  "serving_suggestion": "配上蒜泥蘸碟，肉片蘸着吃最地道。",
  "storage": "冷藏 2 天，冷冻 1 周；复热加少量水小火炖开。",
