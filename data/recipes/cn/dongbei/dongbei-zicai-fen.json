  "steps": [
    {
      "n": 1,
      "text": "粉条用温水泡二十分钟至完全变软，用剪刀剪成十五厘米长的段，沥干水。",
      "time_min": 22,
      "heat": "无火",
      "tip": "粉条用温水不用开水，开水一泡就外烂内硬，条也不成形。",
      "visual_cue": "粉条柔软能弯，透亮不发白"
    },
    {
      "n": 2,
      "text": "酸菜洗净后双手挤干水分，切成细丝；五花肉切成筷子粗的细条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "酸菜挤得越干，下锅越能吃进油和汤，酸味也更集中。",
      "visual_cue": "酸菜丝干爽，肉条粗细均匀"
    },
    {
      "n": 3,
      "text": "锅烧热放植物油，下五花肉条小火煸出油脂，加葱段、姜丝、大蒜、干辣椒与花椒炒香。",
      "time_min": 7,
      "heat": "小火",
      "tip": "煸肉要有耐心，把肥油逼出来，菜才有底味，不腻也不柴。",
      "visual_cue": "肉条边缘焦香，锅里浮着亮油"
    },
    {
      "n": 4,
      "text": "倒入酸菜丝转中火翻炒三分钟，把酸菜的水汽炒干，炒出酸香味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "酸菜一定要炒透，生酸味发冲，炒透了才是醇厚的酸香。",
      "visual_cue": "酸菜丝油润发亮，酸香满锅"
    },
    {
      "n": 5,
      "text": "加生抽与半碗清水，下粉条翻匀铺平，盖上锅盖小火焖五分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "水别多，粉条本身吸水，水多了容易糊成一锅。",
      "visual_cue": "汤被粉条吸干，条身发亮"
    },
    {
      "n": 6,
      "text": "开盖转大火收干汤汁，加盐调味，快速翻炒两下出锅装盘。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁要快，翻久了粉条容易断，装盘前尝一下咸淡。",
      "visual_cue": "锅底无汤，粉条根根分明"
    }
  ],
  "tips": [
    "渍菜粉的渍菜就是东北酸菜，讲究酸得干净，不能有馊味。",
    "粉条吸味全靠那半碗水，水多了发糊，水少了不入味。",
    "这道菜第二天回锅更好吃，粉条把汤吸透了，味道更浓。"
  ],
  "common_mistakes": [
    "粉条用开水泡，外面糊了中间还硬，炒出来夹生。",
    "酸菜没挤干水分，下锅后一直在出水，粉条泡成糊状。",
    "全程小火慢炒，粉条粘成一坨，铲都铲不开。"
  ],
  "substitutions": [
    {
      "original": "粉条",
      "substitute": "粉丝",
      "ratio": "200克:150克",
      "note": "粉丝更细，泡十分钟即可，焖的时间减到三分钟。"
    },
    {
      "original": "酸菜",
      "substitute": "雪里蕻",
      "ratio": "400克:350克",
      "note": "雪里蕻更咸，要多洗两遍并减盐。"
    }
  ],
  "variations": [
    "加一把炒香的黄豆，脆感更足，是辽宁一些馆子的做法。",
    "把五花肉换成猪油渣同炒，香味更浓，是十足的老派口味。"
  ],
  "serving_suggestion": "盛盘趁热吃，配大米饭或者就着贴饼子，酸香下饭，一顿能吃两碗。",
  "storage": "冷藏可存两天，复热时加一勺清水小火翻炒，别干锅加热；不建议冷冻，粉条回软后发糟。",
