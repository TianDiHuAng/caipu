  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成三厘米的滚刀块，泡清水防氧化。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切好泡水，表面淀粉洗掉不易粘锅。，看准状态再往下做。",
      "visual_cue": "块形均匀，水色微白"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧热，下土豆块中火煎。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先煎一遍，表面定型才不散。，看准状态再往下做。",
      "visual_cue": "底面金黄，边缘微焦"
    },
    {
      "n": 3,
      "text": "翻面把土豆块煎到四面微黄，盛出备用。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "四面都煎过，口感更粉香。，看准状态再往下做。",
      "visual_cue": "表皮起皱，颜色金黄"
    },
    {
      "n": 4,
      "text": "锅里留底油，下葱段、蒜和干辣椒炒香。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "辣椒炒出红油，酱香才够劲。，看准状态再往下做。",
      "visual_cue": "辣椒转深红，香气冲出"
    },
    {
      "n": 5,
      "text": "加黄豆酱小火炒出酱香，注意别炒糊。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酱要炒透才不腥，火大易糊。，看准状态再往下做。",
      "visual_cue": "酱色发亮，油红，这一点很关键。"
    },
    {
      "n": 6,
      "text": "倒回土豆块翻匀，让每块都裹上酱。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "翻匀再加水，味道才进得去。，看准状态再往下做。",
      "visual_cue": "块块裹酱，色泽酱红"
    },
    {
      "n": 7,
      "text": "加生抽、白糖和清水，大火烧开转小火焖。，看准状态再往下做。",
      "time_min": 20,
      "heat": "小火",
      "tip": "水到土豆一半就够，焖到收汁。，看准状态再往下做。",
      "visual_cue": "汤汁微沸，土豆变软"
    },
    {
      "n": 8,
      "text": "开盖大火收汁，撒香菜段出锅。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "收汁时轻推别翻，土豆易碎。，看准状态再往下做。",
      "visual_cue": "汁浓挂块，香菜翠绿"
    }
  ],
  "tips": [
    "土豆先煎后焖，块形才完整不散。，这一点很关键。",
    "黄豆酱要小火炒透，去豆腥才香。，这一点很关键。",
    "收汁时轻推锅，别用铲子大力翻。，这一点很关键。"
  ],
  "common_mistakes": [
    "土豆不煎直接焖，出锅一夹就碎。，这一点很关键。",
    "酱没炒透，一股生豆味。，这一点很关键。",
    "水加太多，炖成土豆糊。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "黄豆酱",
      "substitute": "甜面酱",
      "ratio": "40 克:40 克",
      "note": "甜一些，白糖减半。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "600 克:600 克",
      "note": "更甜，焖的时间减五分钟。"
    }
  ],
  "variations": [
    "加几块排骨同焖，荤素都有。，这一点很关键。",
    "放一把豆角，口感更丰富。，这一点很关键。"
  ],
  "serving_suggestion": "配大米饭，酱汁拌饭特别香。，这一点很关键。",
  "storage": "冷藏两天，复热加少量水焖热。，这一点很关键。",
