  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水浸泡二十分钟，泡出血水后用清水冲净表面。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡过的肉煮出来汤不浑，白肉切面也更干净。",
      "visual_cue": "泡肉的水微微泛红，表面浮着少量血水"
    },
    {
      "n": 2,
      "text": "五花肉冷水下锅，加料酒、姜片与八角，中火煮二十五分钟至七分熟，捞出晾凉。",
      "time_min": 28,
      "heat": "中火",
      "tip": "煮到筷子能扎透表皮即可，煮太烂切片会碎。",
      "visual_cue": "肉块紧实，筷子能扎进皮"
    },
    {
      "n": 3,
      "text": "血肠斜刀切成厚片，用温水轻轻冲一下表面，沥干水分备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "血肠很嫩，只能轻冲不能搓，否则一刀下去就散。",
      "visual_cue": "血肠片切面平整、暗红发亮"
    },
    {
      "n": 4,
      "text": "酸菜洗净挤干水分，切成细丝，太酸的多洗一遍再挤干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "挤干水分的酸菜下锅才香，带水下锅只能煮出一锅酸汤。",
      "visual_cue": "酸菜丝干爽，攥在手里不滴水"
    },
    {
      "n": 5,
      "text": "锅中放植物油，下葱段、姜片与干辣椒煸香，倒入酸菜丝中火炒三分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "酸菜要炒到出酸香再加水，这一步决定汤的底味。",
      "visual_cue": "酸菜丝油润发亮，酸香扑鼻"
    },
    {
      "n": 6,
      "text": "加清水大火烧开，放入白肉片转小火煮十分钟，让肉片吸足酸香。",
      "time_min": 13,
      "heat": "小火",
      "tip": "白肉后放，久煮会散，十分钟刚好入味又成形。",
      "visual_cue": "汤色乳白，肉片边缘卷起"
    },
    {
      "n": 7,
      "text": "下血肠片小火煮五分钟至全部热透，加盐与白胡椒，撒香菜与蒜末出锅。",
      "time_min": 6,
      "heat": "小火",
      "tip": "血肠只需热透，煮久了表面起孔发柴，口感全无。",
      "visual_cue": "血肠片颜色转深，汤面浮油花"
    }
  ],
  "tips": [
    "血肠要买当天做的，切面暗红发亮、按下去有弹性的才是新鲜的。",
    "白肉切得越薄越好，两毫米左右，卷起来透光才叫刀工。",
    "蒜末最后撒，热汤一冲蒜香就出来了，提前下锅蒜味会发闷。"
  ],
  "common_mistakes": [
    "血肠一下锅就大火猛煮，表面煮出蜂窝，口感又老又柴。",
    "酸菜没挤干直接下锅，汤水寡淡，酸味也不集中。",
    "白肉煮到全熟再切片，肉片松散，一夹就断。"
  ],
  "substitutions": [
    {
      "original": "血肠",
      "substitute": "猪血",
      "ratio": "500克:400克",
      "note": "用猪血代替要切块，下锅煮八分钟至完全凝固。"
    },
    {
      "original": "酸菜",
      "substitute": "白菜",
      "ratio": "300克:400克",
      "note": "用白菜就没有酸香，需要加两勺米醋补味。"
    }
  ],
  "variations": [
    "喜欢重口的可以另配一碟蒜泥酱油蘸白肉，这是黑龙江常见的吃法。",
    "把酸菜换成渍菜同煮，酸味更冲，汤也更开胃。"
  ],
  "serving_suggestion": "盛在大碗里连汤带肉一起上，先喝汤再吃肉，配一碗高粱米饭最对味。",
  "storage": "冷藏可存两天，血肠不建议冷冻，冻后口感发渣；复热时小火慢烧到滚开即可。",
