  "equipment": [
    "炒锅",
    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切成拇指大小的方块，用清水抓洗一遍去血水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块要匀，炸时才能同时熟。",
      "visual_cue": "肉块方正均匀、表面发白"
    },
    {
      "n": 2,
      "text": "肉块加盐与料酒抓匀腌十分钟，让底味吃进去。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌过再炸，肉心才有味道。",
      "visual_cue": "肉块微黏、带酒香"
    },
    {
      "n": 3,
      "text": "玉米淀粉加清水调成能挂住的稠糊，淋少许植物油拌开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "加一点油，糊炸出来更酥脆。",
      "visual_cue": "糊稠能挂勺、落地不断线"
    },
    {
      "n": 4,
      "text": "肉块倒入糊中抓匀，让每个面都裹上厚薄一致的外皮。",
      "time_min": 3,
      "heat": "无火",
      "tip": "逐块裹匀，粘连要掰开。",
      "visual_cue": "肉块球形完整、互不粘手"
    },
    {
      "n": 5,
      "text": "锅中倒植物油烧到六成热，肉块逐个下锅中火炸到定型。",
      "time_min": 5,
      "heat": "中火",
      "tip": "沿锅边下，避免溅油。",
      "visual_cue": "肉块浮起、外壳浅黄定型"
    },
    {
      "n": 6,
      "text": "捞出后把油温升到八成热，回锅复炸四十秒逼出余油。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "复炸让外皮酥脆不回软。",
      "visual_cue": "外壳金黄、敲之脆响"
    },
    {
      "n": 7,
      "text": "小碗放生抽、老抽、白糖、盐与清水调成味汁备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "提前调匀，后面改火候不慌。",
      "visual_cue": "味汁颜色均匀、糖盐化开"
    },
    {
      "n": 8,
      "text": "另起锅下少许油爆香葱姜蒜，再下青椒与胡萝卜炒断生。",
      "time_min": 3,
      "heat": "中火",
      "tip": "配菜断生即可，保持脆感。",
      "visual_cue": "青椒翠绿、胡萝卜微微发亮"
    },
    {
      "n": 9,
      "text": "倒入味汁烧开，淋淀粉水勾成薄芡，滴香醋提香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "芡要薄，能挂住肉块就够。",
      "visual_cue": "芡汁透明挂勺、酸香上扬"
    },
    {
      "n": 10,
      "text": "炸好的肉块倒入锅中快速翻匀，裹满芡汁后立刻出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "翻匀就出锅，久炒外皮回软。",
      "visual_cue": "肉块油亮挂汁、盘底不见汤水"
    }
  ],
  "tips": [
    "糊用玉米淀粉配少量清水，炸出来才脆不硬。",
    "复炸一次是关键，酥脆度差别很明显。",
    "芡汁里加半勺蚝油，鲜味更厚重。"
  ],
  "common_mistakes": [
    "糊挂得太薄，炸出来肉块光秃不酥。",
    "油温不够就下锅，肉块脱糊还吸油。",
    "勾好芡才下肉，翻两下外皮就软塌。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡腿肉",
      "ratio": "300g 对 300g",
      "note": "带皮更香，需去骨切块。"
    },
    {
      "original": "胡萝卜",
      "substitute": "彩椒",
      "ratio": "50g 对 60g",
      "note": "甜味更足，炒制时间减半。"
    }
  ],
  "variations": [
    "把芡汁换成糖醋口，就是东北的糖醋肉段。",
    "加一把蒜末出锅前拌入，蒜香更突出。"
  ],
  "serving_suggestion": "趁热吃外壳最脆，配一碗米饭和酸菜汤刚好。",
  "storage": "当天吃完，冷藏后外皮会完全回软。",
