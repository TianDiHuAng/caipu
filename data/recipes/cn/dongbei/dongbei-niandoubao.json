  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 400,
          "unit": "g",
          "note": "黄米面更佳",
          "optional": false
        },
        {
          "name": "红豆",
          "name_en": "adzuki bean",
          "amount": 250,
          "unit": "g",
          "note": "做豆馅",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "拌馅",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 260,
          "unit": "ml",
          "note": "和面",
          "optional": false
        },
        {
          "name": "玉米面",
          "name_en": "cornmeal",
          "amount": 60,
          "unit": "g",
          "note": "垫底防粘",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "蒸布",
    "大碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆洗净泡两小时，加水煮四十分钟到一捏就烂。",
      "time_min": 160,
      "heat": "中火",
      "tip": "红豆煮到开花，压出来的馅才细腻。",
      "visual_cue": "豆皮开裂，豆沙松软"
    },
    {
      "n": 2,
      "text": "煮好的红豆趁热压成豆泥，拌入白糖放凉备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "留一点豆粒口感更好，别压得太细。",
      "visual_cue": "豆泥湿润能够成团"
    },
    {
      "n": 3,
      "text": "糯米粉分次加温水，揉成不粘手、能捏成团的面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水要一点点加，面团偏硬才不塌。",
      "visual_cue": "面团光滑，不粘手"
    },
    {
      "n": 4,
      "text": "面团分成小份，压成圆片包入豆馅，收口捏紧搓圆。",
      "time_min": 18,
      "heat": "无火",
      "tip": "收口一定要捏紧，蒸的时候才不会漏馅。",
      "visual_cue": "圆球饱满，收口平整"
    },
    {
      "n": 5,
      "text": "蒸屉撒一层玉米面，豆包摆开留空隙，中火蒸二十分钟。",
      "time_min": 22,
      "heat": "中火",
      "tip": "摆的时候留空隙，蒸大了一圈会粘在一起。",
      "visual_cue": "表皮透亮，微微鼓起"
    },
    {
      "n": 6,
      "text": "关火后再焖三分钟才开盖，趁热蘸着白糖吃。",
      "time_min": 5,
      "heat": "无火",
      "tip": "关火后再焖上三分钟开盖，表皮才不会回缩。",
      "visual_cue": "豆包不塌，表皮光滑"
    }
  ],
  "tips": [
    "糯米粉用温水和面，面团偏硬才立得住。",
    "豆馅要放凉再包，热馅容易把面团烫软。",
    "蒸好焖三分钟再开盖，表皮不回缩。"
  ],
  "common_mistakes": [
    "水加多了面团太软，蒸好塌成一摊。",
    "收口没捏紧，蒸的时候豆馅流出来。",
    "蒸好立刻开盖，豆包表皮皱缩发硬。"
  ],
  "substitutions": [
    {
      "original": "糯米粉",
      "substitute": "黄米面",
      "ratio": "400 克:400 克",
      "note": "东北传统做法，颜色金黄更香。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "60 克:55 克",
      "note": "色泽更深，风味偏焦糖。"
    }
  ],
  "variations": [
    "豆馅里加一点干桂花，香气会更加清雅。",
    "包好后滚一层干粉再蒸，表面更干爽。"
  ],
  "serving_suggestion": "趁热蘸白糖或配一碗酸菜汤，是东北冬天最实在的一口热乎。",
  "storage": "冷冻一个月，复蒸十五分钟；冷藏三天，表皮会变硬须蒸透。",
  "nutrition_estimate": {
