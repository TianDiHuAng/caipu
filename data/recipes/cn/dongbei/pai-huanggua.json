    "砧板",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净去两头，用刀面拍裂后切成 3cm 长的段。",
      "time_min": 4,
      "heat": "无火",
      "tip": "拍裂的断面粗糙，比切片更挂汁。",
      "visual_cue": "黄瓜自然裂开、断面不规则"
    },
    {
      "n": 2,
      "text": "黄瓜段加 3g 盐抓匀，静置 8 分钟杀出水分，倒掉析出的水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "杀水后口感更脆，也不会有生涩味。",
      "visual_cue": "碗底积出明显水分、黄瓜变软"
    },
    {
      "n": 3,
      "text": "蒜末、生抽、香醋、白糖、香油与辣椒油调成料汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "糖能压住醋的尖酸，比例约醋糖 4:1。",
      "visual_cue": "料汁融合、色泽棕红"
    },
    {
      "n": 4,
      "text": "黄瓜倒入料汁中拌匀，撒香菜段，冷藏 10 分钟后食用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冷藏后更爽口，蒜香也更融合。",
      "visual_cue": "黄瓜裹满料汁、清爽油亮"
    }
  ],
  "tips": [
    "黄瓜选顶花带刺的嫩瓜，籽少更脆。",
    "现拍现拌最好吃，放久会出水变淡。",
    "喜欢麻酱口可加 15g 芝麻酱与 10ml 温水调开。"
  ],
  "common_mistakes": [
    "黄瓜切片不拍，表面光滑挂不住料汁。",
    "不杀水直接拌，拌好后盘底出水、味道寡淡。",
    "提前几小时拌好，黄瓜失水变软塌。"
  ],
  "substitutions": [
    {
      "original": "黄瓜",
      "substitute": "莴笋",
      "ratio": "400g 黄瓜 ≈ 400g 莴笋",
      "note": "莴笋需去皮切条，杀水时间延长到 12 分钟。"
    },
    {
      "original": "香醋",
      "substitute": "陈醋",
      "ratio": "1:1",
      "note": "酸味更厚重，白糖可加到 5g。"
    }
  ],
  "variations": [
    "家庭简化版：加 20g 熟花生碎与蒜末同拌，口感更丰富。",
    "麻酱版：以芝麻酱为主调，做成麻酱拍黄瓜。"
  ],
  "serving_suggestion": "配烧烤、饺子或啤酒；东北餐桌上的常备凉菜。",
  "storage": "冷藏 1 天，吃前补 5ml 生抽与香油。",
