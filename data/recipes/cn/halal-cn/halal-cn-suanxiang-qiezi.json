    "刀",
    "砧板",
    "碗",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净去蒂，切成两厘米粗的长条，泡在淡盐水里十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "盐水泡过茄子不易吸油，也不发黑。",
      "visual_cue": "茄条表面略软，水微微发浑"
    },
    {
      "n": 2,
      "text": "茄条捞出攥干水分，摊在案板上晾五分钟去掉表面水。",
      "time_min": 7,
      "heat": "无火",
      "tip": "水分攥干，煎的时候才不炸锅也不吸油。",
      "visual_cue": "茄条干爽，攥后体积缩小"
    },
    {
      "n": 3,
      "text": "炒锅倒花生油中火烧热，茄条平铺下锅煎四分钟至两面金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "铺平一层煎，受热均匀也不粘连。",
      "visual_cue": "茄条两面金黄，边缘发软"
    },
    {
      "n": 4,
      "text": "茄条盛出，锅留少量油下蒜末与小米椒圈炒出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末一定要小火炒，糊了整盘发苦。",
      "visual_cue": "蒜末微黄，香气扑鼻"
    },
    {
      "n": 5,
      "text": "倒回茄条大火翻炒，加生抽、盐与白糖翻匀让茄条吸味。",
      "time_min": 4,
      "heat": "大火",
      "tip": "茄条吸味很快，翻匀就可以进入下一步。",
      "visual_cue": "茄条裹上酱色，锅底微干"
    },
    {
      "n": 6,
      "text": "沿锅边淋香醋，撒葱花翻两下出锅，装盘时淋上锅里余油。",
      "time_min": 3,
      "heat": "大火",
      "tip": "醋沿锅边淋，酸香更清亮不压蒜味。",
      "visual_cue": "葱花翠绿，茄条油亮柔软"
    }
  ],
  "tips": [
    "茄条先用淡盐水泡，既防氧化也不那么吸油。",
    "攥干表面水分再煎，下锅才不炸油也不溅。",
    "蒜末一定要小火慢炒，大火容易焦苦。",
    "香醋沿锅边淋，酸香能提亮整道菜。"
  ],
  "common_mistakes": [
    "茄子不泡盐水，切开就发黑，成品颜色暗沉。",
    "茄条带水直接煎，热油四溅还煎不软。",
    "蒜末大火炒，十秒焦黑，整盘带苦味。",
    "茄条煎过头，里面全化成泥，一点口感都没有。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "长茄子",
      "ratio": "600克:600克",
      "note": "皮更薄，煎的时间减一分钟。"
    },
    {
      "original": "小米椒",
      "substitute": "干辣椒",
      "ratio": "10克:5克",
      "note": "辣味更沉，香气偏干。"
    }
  ],
  "variations": [
    "加一勺剁碎的豆豉同炒，酱香更厚重。",
    "最后淋一勺滚油激香蒜末，蒜香更冲。",
    "换成烤茄子做法，蒸软后浇蒜蓉汁更清爽。"
  ],
  "serving_suggestion": "盛盘后撒葱花趁热上桌，茄条软糯、蒜香浓，汤汁拌饭也很香。",
  "storage": "冷藏可放一天，复热用小火翻热三分钟，久加热茄条会散成泥。",
