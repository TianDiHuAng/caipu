  "equipment": [
    "铁签或竹签",
    "烤架",
    "刷子",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉切成两厘米见方的块，肥瘦分开摆放，方便搭配穿串。",
      "time_min": 12,
      "heat": "无火",
      "tip": "每块带一点肥，烤出来才不干柴。",
      "visual_cue": "肉块方正，油脂乳白"
    },
    {
      "n": 2,
      "text": "洋葱擦成泥，与蒜末、一半孜然、一半盐和十毫升植物油拌成腌料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洋葱泥比洋葱丝更贴肉，能软化纤维。",
      "visual_cue": "腌料湿亮，辛香明显"
    },
    {
      "n": 3,
      "text": "肉块与腌料彻底抓匀，盖好保鲜膜冷藏四十分钟。",
      "time_min": 42,
      "heat": "无火",
      "tip": "中途翻一次，让每块都泡到汁。",
      "visual_cue": "肉块表面泛光，汁液清亮"
    },
    {
      "n": 4,
      "text": "竹签泡水后擦干，按一肥一瘦的顺序穿肉，每串五块左右。",
      "time_min": 10,
      "heat": "无火",
      "tip": "穿松一点留缝，受热均匀不夹生。",
      "visual_cue": "肉串饱满，签尖露出"
    },
    {
      "n": 5,
      "text": "烤架烧到微冒烟，肉串上架先烤五分钟，中途翻面。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先大火定型封汁，再转中火烤透。",
      "visual_cue": "表面变色，油脂开始渗出"
    },
    {
      "n": 6,
      "text": "刷一层植物油，撒辣椒粉与剩余孜然，再烤五分钟至边缘焦黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香料靠后撒才不会焦黑发苦。",
      "visual_cue": "肉串焦边，香料贴面"
    },
    {
      "n": 7,
      "text": "起锅前补撒剩余盐与芝麻，趁热装盘端上桌。",
      "time_min": 2,
      "heat": "中火",
      "tip": "盐最后撒，肉汁才不流失。",
      "visual_cue": "芝麻泛白，盐粒闪亮"
    }
  ],
  "tips": [
    "选带肥的羊腿肉，纯瘦肉烤后发柴。",
    "没有烤架可用烤箱二百二十度烤十二分钟，中途翻面。",
    "孜然一半腌一半撒，香气分出两层。"
  ],
  "common_mistakes": [
    "肉块切得太大，外面焦了里面还带血色。",
    "腌料里放生抽，炭火一烤就发黑发苦。",
    "烤完才撒孜然，香料没被热气激开。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "800 克:800 克",
      "note": "选带油的牛肋条，腌制时间延长二十分钟。"
    },
    {
      "original": "辣椒粉",
      "substitute": "辣椒碎",
      "ratio": "8 克:8 克",
      "note": "辣味更粗犷，颗粒感明显。"
    }
  ],
  "variations": [
    "夹在馕里吃，做成新疆街头常见的肉串夹饼。",
    "改用炭火烤，烟熏味比燃气炉更足。"
  ],
  "serving_suggestion": "装盘配馕、洋葱丝与冰镇酸奶，趁热吃。",
  "storage": "生肉腌好冷藏一夜；熟串冷藏两天，复热用烤箱一百八十度烤五分钟。",
