  "equipment": [
    "砂锅",
    "炒锅",
    "砧板",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉斩成四厘米见方的块，用清水泡十分钟洗去血水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡出血水，焖出来汤才清亮不腥。",
      "visual_cue": "水色泛红，肉块发白"
    },
    {
      "n": 2,
      "text": "鸡块冷水下锅，加姜片与料酒，大火烧开焯两分钟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "冷水下锅才能把血沫逼出来。",
      "visual_cue": "水面浮起灰褐色血沫"
    },
    {
      "n": 3,
      "text": "捞出鸡块用温水冲净表面浮沫，沥干水分备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用温水冲，冷水一激肉会变紧。",
      "visual_cue": "肉块表面干净无沫"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，下白糖小火炒到糖化成琥珀色。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖色一变深就发苦，动作要快。",
      "visual_cue": "糖浆枣红，泛起细泡"
    },
    {
      "n": 5,
      "text": "倒入鸡块翻炒裹上糖色，加姜片、大蒜、八角与干辣椒炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "炒到鸡皮微焦，香气才进得去。",
      "visual_cue": "鸡块表面红亮，香气扑鼻"
    },
    {
      "n": 6,
      "text": "加浓口酱油与盐翻匀，倒入没过鸡块的热水。",
      "time_min": 3,
      "heat": "大火",
      "tip": "一定加热水，冷水会让肉质发柴。",
      "visual_cue": "汤色深褐，鸡块没入"
    },
    {
      "n": 7,
      "text": "转入砂锅加香菇与土豆，烧开后转小火焖二十五分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "小火慢焖，肉才脱骨不散。",
      "visual_cue": "汤汁收半，肉一戳就透"
    },
    {
      "n": 8,
      "text": "开盖下青椒片煮两分钟，撒上小葱段端上桌开吃。",
      "time_min": 2,
      "heat": "中火",
      "tip": "青椒最后放，保持脆生和翠绿。",
      "visual_cue": "青椒翠绿，汤汁浓稠"
    }
  ],
  "tips": [
    "鸡块先焯水再炒糖色，汤清不腥。",
    "焖的时候水一次加够，中途加水会冲淡味道。",
    "砂锅保温好，关火后余温还能再焖五分钟。"
  ],
  "common_mistakes": [
    "糖色炒过了头，整锅带着一股焦苦味。",
    "焯水用热水下锅，血沫锁在肉里腥味重。",
    "青椒早放久煮，颜色发黄口感发绵。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "整鸡",
      "ratio": "700 克:1000 克",
      "note": "斩块后同法焖制，时间延长五分钟。"
    },
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "80 克:60 克",
      "note": "提前泡发洗净，口感更脆。"
    }
  ],
  "variations": [
    "加一把粉丝同焖，吸足汤汁更下饭。",
    "喜欢辣味可多放两个干辣椒，出锅前淋辣椒油。"
  ],
  "serving_suggestion": "连砂锅端上桌，配一碗白米饭，浇汤汁拌着吃。",
  "storage": "冷藏两天，复热时加少量清水小火焖透，味道更融合。",
