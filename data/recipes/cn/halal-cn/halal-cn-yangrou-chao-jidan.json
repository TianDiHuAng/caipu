  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "锅铲",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊腿肉逆着纹理切成细丝，加白胡椒和盐抓匀腌十分钟。",
      "time_min": 14,
      "heat": "无火",
      "tip": "逆纹切才不塞牙，腌十分钟能压住膻味。",
      "visual_cue": "羊丝细匀，抓后微微发黏"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进碗里加一克盐打散，大葱斜切成丝，姜切细丝。",
      "time_min": 6,
      "heat": "无火",
      "tip": "葱丝切得粗一点，炒完还有脆劲。",
      "visual_cue": "蛋液均匀，葱丝长短一致"
    },
    {
      "n": 3,
      "text": "炒锅倒二十毫升花生油烧热，倒蛋液炒成大块蛋片盛出。",
      "time_min": 4,
      "heat": "大火",
      "tip": "蛋片炒到七分熟就盛出，回锅还会再熟。",
      "visual_cue": "蛋片金黄鼓起，中心略湿"
    },
    {
      "n": 4,
      "text": "锅里补油下姜丝爆香，倒入羊丝大火快速划散炒两分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "羊丝下锅别急着翻，等定型再划开才不粘。",
      "visual_cue": "羊丝变色散开，不见血水"
    },
    {
      "n": 5,
      "text": "加生抽与剩下的盐翻匀，倒回蛋片和大葱丝，大火翻炒一分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "葱丝最后放，炒久了发甜出水。",
      "visual_cue": "葱丝翠绿微塌，锅里香气冲鼻"
    },
    {
      "n": 6,
      "text": "沿锅边淋一小勺清水激一下，翻匀立刻出锅装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "淋水激锅能让羊肉更嫩，也能带走锅气。",
      "visual_cue": "汤汁微收，盘底不见汪水"
    }
  ],
  "tips": [
    "羊腿肉逆纹切丝，炒出来才嫩不塞牙。",
    "腌羊肉时加白胡椒，膻味能压下去大半。",
    "蛋片先炒到七分熟盛出，回锅才不老。",
    "葱丝最后下，炒久了甜味盖过羊肉香。"
  ],
  "common_mistakes": [
    "羊肉顺纹切，炒完嚼起来像嚼皮筋。",
    "羊肉和鸡蛋一起下锅，最后糊成一团。",
    "全程小火慢煸，羊肉出水变柴，膻味反而更重。",
    "葱丝早放久炒，出水发甜，整道菜口味发腻。"
  ],
  "substitutions": [
    {
      "original": "羊腿肉",
      "substitute": "牛里脊",
      "ratio": "200克:200克",
      "note": "膻味更轻，腌的时间减半。"
    },
    {
      "original": "大葱",
      "substitute": "洋葱",
      "ratio": "80克:100克",
      "note": "甜味更足，炒的时间加半分钟。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同炒，吸汁后特别香。",
    "喜欢吃辣的可以放两个干辣椒段一起爆锅。",
    "换成羊里脊更嫩，炒的时间减半分钟。"
  ],
  "serving_suggestion": "盛盘趁热上桌，羊丝嫩、蛋片香、葱丝脆，配一张死面饼卷着吃最地道。",
  "storage": "冷藏可放一天，复热用大火快炒一分钟，久加热羊肉会变柴。",
