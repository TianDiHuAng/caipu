        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "大碗",
    "砧板",
    "刀",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩剔去筋膜，先切片再剁成细腻的馅料，约二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "手工剁的馅料比机器打的更有黏性。",
      "visual_cue": "馅料细腻，略有颗粒感"
    },
    {
      "n": 2,
      "text": "馅料加盐、料酒、姜末、蛋清与土豆淀粉，顺一个方向搅打。",
      "time_min": 5,
      "heat": "无火",
      "tip": "始终朝一个方向搅，馅料才会起胶。",
      "visual_cue": "馅料发黏，能拉出丝"
    },
    {
      "n": 3,
      "text": "分三次加入两勺清水继续搅打，直到馅料抱团上劲。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打水让丸子嫩，水多则散，宁少勿多。",
      "visual_cue": "馅料光亮，插筷不倒"
    },
    {
      "n": 4,
      "text": "汤锅倒植物油，下番茄块中火炒到出沙变软。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出沙，汤底才带自然的酸甜。",
      "visual_cue": "番茄塌软，油色泛红"
    },
    {
      "n": 5,
      "text": "加姜片、青花椒与足量清水，大火烧开后转小火。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水保持微沸，丸子才不散。",
      "visual_cue": "水面小泡翻动，不滚腾"
    },
    {
      "n": 6,
      "text": "虎口挤出馅料，用勺子舀成丸子逐个下锅定型。",
      "time_min": 8,
      "heat": "小火",
      "tip": "下锅别急着搅，定型后再推动。",
      "visual_cue": "丸子浮面，表面发白"
    },
    {
      "n": 7,
      "text": "下泡软的粉丝煮三分钟，加盐调味后立即关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "粉丝吸汤快，煮久会糊。",
      "visual_cue": "粉丝透明，柔软不烂"
    },
    {
      "n": 8,
      "text": "盛入碗中撒上葱花与香菜碎，趁热端上桌喝。",
      "time_min": 1,
      "heat": "无火",
      "tip": "葱花最后撒，香气最足。",
      "visual_cue": "汤面浮着绿色碎末"
    }
  ],
  "tips": [
    "馅料手剁比机器打更弹，口感差很多。",
    "打水要分次加，一次加多了丸子就散。",
    "丸子下锅时汤要微沸，滚开会把丸子冲散。"
  ],
  "common_mistakes": [
    "馅料没搅上劲就下锅，丸子一入水就散开。",
    "汤大开时下丸子，全冲成肉末汤。",
    "淀粉放太多，丸子口感发硬像橡皮。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛里脊",
      "ratio": "500 克:500 克",
      "note": "脂肪更少，需多打两勺水保持嫩度。"
    },
    {
      "original": "粉丝",
      "substitute": "通心粉",
      "ratio": "60 克:70 克",
      "note": "煮制时间延长至八分钟。"
    }
  ],
  "variations": [
    "汤里加几片冬瓜同煮，清甜又解腻。",
    "换成羊馅料做成羊肉丸子汤，香气更重。"
  ],
  "serving_suggestion": "一碗汤配两个烤饼，撒点白胡椒更暖身。",
  "storage": "汤与丸子分开冷藏两天，丸子久泡会散，复热时再加。",
