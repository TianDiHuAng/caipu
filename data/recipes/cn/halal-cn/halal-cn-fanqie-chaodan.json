  "equipment": [
    "炒锅",
    "碗",
    "打蛋器",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄洗净去蒂，切成滚刀块，大块的可以再对半切开。",
      "time_min": 8,
      "heat": "无火",
      "tip": "番茄切得大小均匀，下锅受热才一致。",
      "visual_cue": "番茄块大小一致，汁水不外流"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进碗里，加两克盐打散，打到蛋液表面浮起细泡。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液打进空气，炒出来才蓬松柔软。",
      "visual_cue": "蛋液颜色均匀，表面一层细泡"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒三十毫升花生油，油温六成热时倒入蛋液。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油要热但别冒烟，蛋液下锅才能立刻鼓起。",
      "visual_cue": "蛋液边缘迅速凝固起泡"
    },
    {
      "n": 4,
      "text": "等蛋液底部凝固就用锅铲从边缘往中间推，成大块蛋片后盛出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "推着炒不用翻面，蛋片才整块不碎。",
      "visual_cue": "蛋片金黄蓬松，表面还带湿光"
    },
    {
      "n": 5,
      "text": "锅里补剩下的油，下番茄块大火翻炒三分钟至出汁变软。",
      "time_min": 5,
      "heat": "大火",
      "tip": "番茄要炒到出红汁，味道才浓。",
      "visual_cue": "番茄塌软出汁，锅底一层红汤"
    },
    {
      "n": 6,
      "text": "加盐与白糖炒匀，倒回蛋片翻两下让蛋吸汁，撒葱花点香油出锅。",
      "time_min": 4,
      "heat": "大火",
      "tip": "蛋片回锅只翻两下，久了就炒老发硬。",
      "visual_cue": "蛋片裹上红汁，汤汁微微收浓"
    }
  ],
  "tips": [
    "鸡蛋多打一会儿打进空气，炒出来才蓬松。",
    "番茄要炒到出红汁，这道菜的鲜味全在这层汁里。",
    "白糖不是为甜，是用来压番茄的酸涩。",
    "蛋片回锅只翻两下就出锅，炒久了发硬。"
  ],
  "common_mistakes": [
    "鸡蛋下锅就猛搅，最后变成一碗碎蛋渣。",
    "番茄没炒出汁就回蛋，成品又干又寡淡。",
    "全程小火，蛋片吸油发硬，番茄也不出汁。",
    "盐放太早，番茄出水过多，整盘变成汤。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "500克:400克",
      "note": "酸度更高，白糖加三克。"
    },
    {
      "original": "花生油",
      "substitute": "植物油",
      "ratio": "40毫升:40毫升",
      "note": "味道更中性，清真家庭常用。"
    }
  ],
  "variations": [
    "加一把泡软的木耳同炒，口感更丰富。",
    "喜欢汤汁多的可以在番茄里加两勺清水。",
    "换成洋葱丝打底，炒出来的甜味更足。"
  ],
  "serving_suggestion": "盛盘趁热上桌，红黄相间，蛋片吸饱番茄汁，配米饭或拌面都很合适。",
  "storage": "冷藏可放一天，复热用小火翻热两分钟，微波加热蛋片会变硬。",
