  "equipment": [
    "炒锅",
    "锅铲",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白菜掰开洗净，菜帮斜刀片成薄片，菜叶撕成大块分开放。",
      "time_min": 9,
      "heat": "无火",
      "tip": "菜帮斜片更容易熟，也更挂得住味，这一步别省。",
      "visual_cue": "菜帮薄片透光，菜叶成块，颜色清爽"
    },
    {
      "n": 2,
      "text": "米醋、生抽、白糖和盐倒进小碗，搅到糖盐化开调成碗汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调好汁，下锅后一气呵成，菜才脆。",
      "visual_cue": "碗汁均匀，无颗粒，看着就有食欲"
    },
    {
      "n": 3,
      "text": "炒锅烧热放植物油，下花椒和干辣椒段小火炝出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒别炒黑，一见转深红就下菜，否则发苦。",
      "visual_cue": "辣椒转红，花椒浮起，香气已出"
    },
    {
      "n": 4,
      "text": "下蒜片和葱花炒香，立刻倒入菜帮片大火翻炒一分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "先炒菜帮，它需要更多火候才软中带脆。",
      "visual_cue": "菜帮边缘透明，锅气上升，层次分明"
    },
    {
      "n": 5,
      "text": "沿锅边淋一半碗汁，大火快炒三十秒让酸香冲出来。",
      "time_min": 2,
      "heat": "大火",
      "tip": "沿锅边淋，醋遇热锅汽化，酸香才够冲。",
      "visual_cue": "白汽腾起，酸香扑鼻，火候刚好"
    },
    {
      "n": 6,
      "text": "放菜叶，倒入剩下的碗汁，大火翻炒四十秒到叶子软塌。",
      "time_min": 2,
      "heat": "大火",
      "tip": "菜叶一软就停，久炒出水就成炖菜了。",
      "visual_cue": "菜叶软塌，汤汁略挂，一目了然"
    },
    {
      "n": 7,
      "text": "尝一下咸酸，按口味补一点盐，翻匀后立刻关火。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火要快，余温还会继续把菜焖软，这一步别省。",
      "visual_cue": "菜色油亮，酸香透出，火候正好"
    },
    {
      "n": 8,
      "text": "盛盘时把锅里的汤汁一起浇在菜上，趁热吃最脆爽。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘底汤汁别倒掉，拌米饭特别香，这一步别省。",
      "visual_cue": "菜帮透白，菜叶翠绿，状态到位"
    }
  ],
  "tips": [
    "清真素菜讲究清爽，醋溜白菜只用花椒辣椒炝锅，不加荤油。",
    "醋分两次下，第一次取香，第二次取酸。",
    "白菜帮和叶分开下锅，熟度才一致。"
  ],
  "common_mistakes": [
    "醋一次倒完，酸味全跑光，只剩一股酸涩。",
    "小火慢炒，白菜出水，最后成了一锅汤。",
    "菜帮菜叶同时下锅，叶子烂了帮还硬。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "25毫升:25毫升",
      "note": "香醋颜色深，酸味柔和，成菜颜色会偏褐。"
    },
    {
      "original": "干辣椒",
      "substitute": "小米辣",
      "ratio": "3克:5克",
      "note": "小米辣更辣更鲜，切片下锅，炝锅时间要缩短。"
    }
  ],
  "variations": [
    "加一小把粉丝同炒，粉丝吸汁，酸香更集中。",
    "把白菜换成圆白菜，口感更脆，炒的时间要缩短半分钟。"
  ],
  "serving_suggestion": "盛盘后配米饭或馒头，酸甜汁拌饭很下饭，吃起来很下饭。",
  "storage": "冷藏可存一天，复热用大火快炒，微波会出水变软。",
