    "锅铲",
    "汤勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉片加料酒和白胡椒抓匀，放十分钟去膻入味。",
      "time_min": 11,
      "heat": "无火",
      "tip": "抓的时候轻一点，薄片容易抓碎，拌匀就行。",
      "visual_cue": "肉片挂薄汁，手感滑润，火候正好"
    },
    {
      "n": 2,
      "text": "冬瓜削皮去瓤，切成半厘米厚的大片，边缘修整齐。",
      "time_min": 9,
      "heat": "无火",
      "tip": "切太薄一煮就化，厚片才能保持形状。",
      "visual_cue": "瓜片透亮，边缘齐整，状态到位"
    },
    {
      "n": 3,
      "text": "汤锅放植物油烧热，下姜丝和葱段小火煸出香味。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "姜丝煸到微卷，去膻的劲才足，这一步别省。",
      "visual_cue": "姜丝卷边，油面浮香，颜色清爽"
    },
    {
      "n": 4,
      "text": "加清水一千四百毫升大火烧开，煮出葱姜的底味。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水烧开再下瓜，瓜片才不容易煮烂，这一步别省。",
      "visual_cue": "汤面翻滚，葱段浮起，看着就有食欲"
    },
    {
      "n": 5,
      "text": "下冬瓜片中火煮八分钟，到瓜片变透明、边角发软。",
      "time_min": 9,
      "heat": "中火",
      "tip": "瓜片透明就熟了，煮过头会化成汤，这一步别省。",
      "visual_cue": "瓜片透明，筷子可插透，香气已出"
    },
    {
      "n": 6,
      "text": "羊肉片一片片下锅，用汤勺轻推散开，别成团沉底。",
      "time_min": 3,
      "heat": "中火",
      "tip": "一片片下不会粘在一起，受热也均匀。",
      "visual_cue": "肉片分散，汤色转浅，层次分明"
    },
    {
      "n": 7,
      "text": "肉片变色后加盐和白胡椒，煮两分钟关火即可。",
      "time_min": 3,
      "heat": "中火",
      "tip": "肉片变色就够，多煮两分钟就老了，这一步别省。",
      "visual_cue": "肉片泛白，汤清见底，火候刚好"
    },
    {
      "n": 8,
      "text": "撒香菜末，盛进汤碗趁热喝，汤比肉还鲜即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，热气一冲香味就出来，这一步别省。",
      "visual_cue": "汤面浮绿，油花细小，一目了然"
    }
  ],
  "tips": [
    "冬瓜配羊肉是清真家常的清汤搭法，一荤一素不腻口。",
    "羊肉片提前腌一下，汤里就不会有膻味。",
    "冬瓜皮别削太深，靠皮那层最清甜。"
  ],
  "common_mistakes": [
    "冬瓜切太薄，煮十分钟就化在汤里，只剩一锅浑水。",
    "羊肉片冻着下锅，外面老里面还没化。",
    "早放盐，冬瓜出水变软，汤味也发死。"
  ],
  "substitutions": [
    {
      "original": "冬瓜",
      "substitute": "白萝卜",
      "ratio": "500克:450克",
      "note": "萝卜版更清甜，煮的时间要多三分钟才软。"
    },
    {
      "original": "羊肉片",
      "substitute": "牛肉片",
      "ratio": "300克:300克",
      "note": "牛肉版汤色略深，加一片姜去腥更好。"
    }
  ],
  "variations": [
    "加几粒枸杞同煮，汤色更好看，冬天喝更暖。",
    "最后淋几滴香油，香气更足，适合配馒头吃。"
  ],
  "serving_suggestion": "用白瓷汤碗盛，撒香菜，配烙饼或米饭都合适。",
  "storage": "冷藏可存两天，冬瓜会继续出水，复热时补少量清水。",
