  "steps": [
    {
      "n": 1,
      "text": "豆角掐去两头撕掉筋，掰成五厘米长的段，洗净后彻底沥干水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆角必须沥干，带水下锅会溅油也煸不皱。",
      "visual_cue": "豆角段表面无水，筋络撕净"
    },
    {
      "n": 2,
      "text": "牛肉切成米粒大的小粒，大蒜与姜切末，干辣椒掰成段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "牛肉粒切小才能煸得干香，颗粒大了发硬。",
      "visual_cue": "牛肉粒大小一致，辣椒段干净"
    },
    {
      "n": 3,
      "text": "炒锅倒花生油烧至六成热，下豆角中火炸三分钟至表皮起皱发白。",
      "time_min": 6,
      "heat": "中火",
      "tip": "炸到表皮起皱才算到位，里面也断生了。",
      "visual_cue": "豆角表皮起白皱，颜色转深绿"
    },
    {
      "n": 4,
      "text": "豆角捞出沥油，锅留花生油下牛肉粒小火煸至干香出油。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛肉小火慢煸，水分煸干才有嚼劲。",
      "visual_cue": "牛肉粒收缩干香，锅底见油"
    },
    {
      "n": 5,
      "text": "下花椒、干辣椒段与姜蒜末炒出香味，注意别炒糊。",
      "time_min": 2,
      "heat": "小火",
      "tip": "辣椒一变深红就得下豆角，糊了整锅发苦。",
      "visual_cue": "辣椒深红发亮，香味冲鼻"
    },
    {
      "n": 6,
      "text": "倒回豆角大火翻炒，加生抽、盐与白糖翻匀，炒一分钟后出锅。",
      "time_min": 4,
      "heat": "大火",
      "tip": "最后大火翻匀，让豆角裹上调味和油香。",
      "visual_cue": "豆角干香起皱，表面泛油光"
    }
  ],
  "tips": [
    "豆角一定要沥干水再下锅，否则溅油还煸不皱。",
    "炸到表皮起皱发白，里面才算断生。",
    "牛肉粒切小粒小火煸干，才有干香的嚼劲。",
    "辣椒炒到深红就下豆角，炒糊了整盘发苦。"
  ],
  "common_mistakes": [
    "豆角没炸透就炒，吃起来夹生还有豆腥味。",
    "带水下锅，油花四溅，豆角也煸不出皱皮。",
    "干辣椒大火炒，几秒就发黑，整盘带焦苦味。",
    "豆角炸过头变成干柴，一口咬下去全是油。"
  ],
  "substitutions": [
    {
      "original": "豆角",
      "substitute": "四季豆",
      "ratio": "600克:600克",
      "note": "口感更嫩，炸的时间减一分钟。"
    },
    {
      "original": "牛肉",
      "substitute": "羊腿肉",
      "ratio": "100克:100克",
      "note": "膻香更浓，多加一克白胡椒。"
    }
  ],
  "variations": [
    "加一勺豆瓣酱同炒，酱香更浓也更有层次。",
    "不放肉做成纯素版，加几粒蒜片一样好吃。",
    "最后撒一把炒熟的白芝麻，香气更足。"
  ],
  "serving_suggestion": "盛盘趁热吃，豆角外皱内嫩，牛肉粒干香，配米饭能多吃一碗。",
  "storage": "冷藏可放两天，复热用干锅小火煸两分钟，微波加热会回软。",
