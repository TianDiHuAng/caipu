          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
          "note": "去膻提香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉片用生抽、料酒和白胡椒抓匀，腌十分钟让味道渗进去。",
      "time_min": 11,
      "heat": "无火",
      "tip": "腌的时候用手抓两分钟，肉片表面起黏性更容易吸味。",
      "visual_cue": "肉片挂上浅褐汁水，手感发黏"
    },
    {
      "n": 2,
      "text": "大葱斜刀切成马耳段，葱白和葱绿分开放进两个碗里。",
      "time_min": 6,
      "heat": "无火",
      "tip": "斜刀切的断面大，下锅几秒就出甜味，比直段香。",
      "visual_cue": "葱段断面宽大，葱白葱绿分开"
    },
    {
      "n": 3,
      "text": "炒锅烧到微微冒烟，倒植物油晃开，让油铺满锅底。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅一定烧透再下油，不粘锅的关键就在这一步。",
      "visual_cue": "锅底泛白烟，油面起细纹，火候正好"
    },
    {
      "n": 4,
      "text": "羊肉片下锅摊平，大火快炒四十秒到表面变色断生。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火，肉片摊开别叠，出水前就要炒到变色。",
      "visual_cue": "肉片卷曲泛白，锅底干爽，状态到位"
    },
    {
      "n": 5,
      "text": "下葱白段转中大火翻炒三十秒，把葱香炒进羊肉里。",
      "time_min": 2,
      "heat": "大火",
      "tip": "先下葱白，它的辛辣味需要多炒一会儿才变甜。",
      "visual_cue": "葱白边缘透明，香气冲鼻，颜色清爽"
    },
    {
      "n": 6,
      "text": "放葱绿段、盐，沿锅边淋生抽，快速翻炒二十秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱绿后下才保翠绿，久炒会发黄发苦。",
      "visual_cue": "葱绿转深，酱香浮起，看着就有食欲"
    },
    {
      "n": 7,
      "text": "淋香油翻两下立刻关火，靠余温把香味收进肉里。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油别早放，高温一炒香味就跑光了。",
      "visual_cue": "油光锃亮，葱香混着羊肉香"
    },
    {
      "n": 8,
      "text": "趁热盛盘，盘底尽量不留汤汁，热吃最香即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "这道菜放三分钟就出水，端上桌立刻动筷子。",
      "visual_cue": "葱绿肉白，盘底清亮，香气已出"
    }
  ],
  "tips": [
    "清真菜讲究本味，葱爆羊肉只用盐、生抽和香油，不加重香料。",
    "羊肉片要切得薄，厚片下锅容易出水变成炖菜。",
    "大葱用量别省，葱比肉多才叫葱爆。"
  ],
  "common_mistakes": [
    "锅没烧透就下肉，羊肉粘锅出水，炒成一片糊底。",
    "小火慢炒，羊肉越炒越硬，葱也炒烂了。",
    "盐放太早，羊肉迅速出水，锅温掉下来再也炒不香。"
  ],
  "substitutions": [
    {
      "original": "羊肉片",
      "substitute": "牛肉片",
      "ratio": "400克:400克",
      "note": "牛肉版要加一点清水抓打，炒出来才不发柴。"
    },
    {
      "original": "大葱",
      "substitute": "洋葱",
      "ratio": "250克:250克",
      "note": "洋葱版甜味更重，炒的时间要多半分钟。"
    }
  ],
  "variations": [
    "加一把新疆辣皮子同炒，辛香更冲，配馍吃很过瘾。",
    "最后撒一把香菜梗，清香味立刻上一个层次。"
  ],
  "serving_suggestion": "盛盘后配烙饼或拌面条吃，盘里的葱油别浪费。",
  "storage": "冷藏可存一天，复热用大火快炒三十秒，微波会让羊肉发硬。",
