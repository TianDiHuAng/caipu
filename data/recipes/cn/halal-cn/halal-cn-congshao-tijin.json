  "steps": [
    {
      "n": 1,
      "text": "蹄筋冲洗干净，冷水下锅加姜片焯五分钟去腥。",
      "time_min": 12,
      "heat": "大火",
      "tip": "焯水去腥，蹄筋后面烧出来才没有异味。",
      "visual_cue": "水面浮沫撇净，蹄筋紧缩"
    },
    {
      "n": 2,
      "text": "蹄筋移入高压锅，加水没过，上汽后压二十五分钟至软烂。",
      "time_min": 32,
      "heat": "中火",
      "tip": "压到筷子能轻松扎透，后面烧才入味。",
      "visual_cue": "蹄筋透明软糯，筷子一扎就进"
    },
    {
      "n": 3,
      "text": "压好的蹄筋捞出晾到不烫手，切成五厘米长的段。",
      "time_min": 10,
      "heat": "无火",
      "tip": "晾凉再切，热的时候切容易黏刀拉丝。",
      "visual_cue": "蹄筋段齐整，切面透亮"
    },
    {
      "n": 4,
      "text": "大葱切成五厘米长的段，姜切片，锅烧热倒花生油下葱段小火煎香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "葱段小火慢煎出葱油，这是这道菜的香味底子。",
      "visual_cue": "葱段两面微黄，葱香浓"
    },
    {
      "n": 5,
      "text": "葱段盛出，下姜片爆香，倒入蹄筋与高汤，加生抽、老抽、白糖和盐。",
      "time_min": 5,
      "heat": "中火",
      "tip": "汤要没过蹄筋一半，烧的时候才吸得进味。",
      "visual_cue": "蹄筋浸在酱色汤里，微微冒泡"
    },
    {
      "n": 6,
      "text": "转小火烧十五分钟至汤汁剩三分之一，倒回葱段翻匀。",
      "time_min": 17,
      "heat": "小火",
      "tip": "小火慢烧，蹄筋才软糯入味不发硬。",
      "visual_cue": "汤汁收浓挂勺，蹄筋油亮"
    },
    {
      "n": 7,
      "text": "玉米淀粉兑水勾薄芡，晃锅让汤汁裹匀，出锅装盘。",
      "time_min": 4,
      "heat": "中火",
      "tip": "薄芡让汤汁挂在蹄筋上，看着亮吃起来也润。",
      "visual_cue": "汤汁透亮裹身，盘底不见汤水"
    }
  ],
  "tips": [
    "蹄筋先焯水再压，去腥又省时间。",
    "葱段小火煎出葱油，是这道菜的灵魂香味。",
    "烧的时候汤汁别太多，收浓才挂得住。",
    "最后勾一层薄芡，蹄筋表面才油亮。"
  ],
  "common_mistakes": [
    "蹄筋不焯水直接烧，腥味压不住。",
    "压的时间不够，蹄筋咬着像橡皮筋。",
    "大葱大火炒焦，葱油发苦整道菜毁掉。",
    "汤汁没收浓就勾芡，成品稀汤寡水挂不住。"
  ],
  "substitutions": [
    {
      "original": "蹄筋",
      "substitute": "牛筋",
      "ratio": "500克:550克",
      "note": "压的时间加十分钟。"
    },
    {
      "original": "大葱",
      "substitute": "京葱",
      "ratio": "200克:200克",
      "note": "甜味更足，煎的时间略短。"
    }
  ],
  "variations": [
    "加几片香菇同烧，菌香让味道更厚。",
    "收汁前淋半勺香醋，解腻又提鲜。",
    "换成红烧做法加冰糖，颜色更红亮。"
  ],
  "serving_suggestion": "装盘后把葱段摆在蹄筋上，配一碗米饭，蹄筋软糯带韧，汤汁拌饭极香。",
  "storage": "冷藏可放两天，复热加两勺高汤小火焖五分钟，口感恢复软糯。",
