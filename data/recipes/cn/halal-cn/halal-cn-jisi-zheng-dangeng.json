    "保鲜膜",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉冷水下锅，加姜片煮十二分钟至熟透，捞出晾凉。",
      "time_min": 15,
      "heat": "中火",
      "tip": "煮到能用筷子轻松扎透，里面才没有血水。",
      "visual_cue": "鸡肉发白紧实，筷子扎入无血水"
    },
    {
      "n": 2,
      "text": "晾凉的鸡胸肉顺着纹理撕成细丝，撕好盖住防止风干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "顺纹撕口感嫩，横着撕容易碎成渣。",
      "visual_cue": "鸡丝细长均匀，不见粗块"
    },
    {
      "n": 3,
      "text": "鸡蛋磕进碗里加盐打散，倒入温水搅匀，水与蛋液约一比一点五。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一定用温水，冷水蒸出来有蜂窝，开水会冲成蛋花。",
      "visual_cue": "蛋液与水完全融合，颜色乳黄"
    },
    {
      "n": 4,
      "text": "蛋液过筛两遍滤掉气泡与系带，静置三分钟让表面气泡消掉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛是蛋羹光滑的关键，气泡蒸出来就是坑。",
      "visual_cue": "蛋液细腻无泡，筛网留下絮状物"
    },
    {
      "n": 5,
      "text": "碗口蒙一层保鲜膜并扎几个小孔，水开后中小火蒸十分钟。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "中小火慢蒸，蛋羹才嫩得像蒸水蛋。",
      "visual_cue": "膜内鼓起，蛋羹表面平整"
    },
    {
      "n": 6,
      "text": "取出揭膜，铺上鸡丝，淋生抽与香油，撒葱花即成。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鸡丝蒸好后再铺，一起蒸会沉底发老。",
      "visual_cue": "鸡丝铺面均匀，蛋羹颤而不散"
    }
  ],
  "tips": [
    "兑蛋液用温水，比例一比一点五口感最嫩。",
    "蛋液过筛两遍，蒸出来才没有蜂窝小孔。",
    "蒙保鲜膜中小火蒸，表面平整不起皱。",
    "鸡丝蒸完再铺，同蒸会沉底变柴。"
  ],
  "common_mistakes": [
    "用冷水兑蛋液，蒸出来一肚子蜂窝孔。",
    "大火猛蒸，蛋羹鼓成海绵，口感又老又糙。",
    "不过筛直接蒸，表面一层粗糙的蛋白块。",
    "鸡丝和蛋液一起下锅，全沉在碗底发硬。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "120克:130克",
      "note": "更嫩滑，煮的时间加三分钟。"
    },
    {
      "original": "温水",
      "substitute": "高汤",
      "ratio": "300毫升:300毫升",
      "note": "鲜味更浓，盐减一克。"
    }
  ],
  "variations": [
    "蛋羹里埋几粒泡发的干贝，鲜味更足。",
    "表面淋一勺熬好的葱油，葱香更浓。",
    "换成羊骨高汤兑蛋液，做成清真风味的咸蛋羹。"
  ],
  "serving_suggestion": "用小勺从边缘舀着吃，蛋羹嫩滑、鸡丝鲜香，配一碗小米粥就是舒服的一顿早饭。",
  "storage": "当天吃完最好，冷藏不超过一天，复热上锅蒸五分钟。",
