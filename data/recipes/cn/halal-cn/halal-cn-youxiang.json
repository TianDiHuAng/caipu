  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 1,
          "unit": "piece",
          "note": "增加酥松",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 500,
          "unit": "ml",
          "note": "炸制用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 15,
          "unit": "g",
          "note": "助发酵上色",
          "optional": false
        },
        {
          "name": "五香粉",
          "name_en": "five spice powder",
          "amount": 3,
          "unit": "g",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "擀面杖",
    "深锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒入盆中，加盐、白糖与五香粉拌匀，中间扒出小窝。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香料先和面粉拌匀，味道才均匀。",
      "visual_cue": "粉料颜色一致无结块"
    },
    {
      "n": 2,
      "text": "打入鸡蛋拌匀，分次加温水揉成偏软的光滑面团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水温三十度左右，太烫会把面烫死。",
      "visual_cue": "面团光滑，按下去能回弹"
    },
    {
      "n": 3,
      "text": "面团盖湿布静置一小时，中途翻揉一次排气。",
      "time_min": 60,
      "heat": "无火",
      "tip": "醒好的面延展性好，擀的时候不回缩。",
      "visual_cue": "面团膨大，指按缓慢回弹"
    },
    {
      "n": 4,
      "text": "面团搓成长条，均匀分成六个等大的面剂子。",
      "time_min": 4,
      "heat": "无火",
      "tip": "剂子大小一致，炸的时候熟度才同步。",
      "visual_cue": "六个剂子个头相当"
    },
    {
      "n": 5,
      "text": "每个剂子擀成厚约半厘米的圆饼，中间用刀划两道口。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划口让热气逸出，饼才不鼓包。",
      "visual_cue": "饼坯圆整，刀口清晰"
    },
    {
      "n": 6,
      "text": "深锅倒植物油烧到六成热，下饼坯中小火慢炸。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温太高外焦内生，六成热最稳。",
      "visual_cue": "饼坯浮起，边缘起小泡"
    },
    {
      "n": 7,
      "text": "一面炸到金黄后翻面，两面金黄即捞出沥油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "一次别下太多，油温掉了饼就发硬。",
      "visual_cue": "两面金黄，敲起来发脆"
    },
    {
      "n": 8,
      "text": "放在吸油纸上控油两分钟，趁温热时吃最香。",
      "time_min": 2,
      "heat": "无火",
      "tip": "刚出锅外脆内软，放凉会变韧。",
      "visual_cue": "表面干爽，不挂多余油"
    }
  ],
  "tips": [
    "面团要偏软，硬面团炸出来发艮。",
    "油温保持六成热，用一小块面坯试油。",
    "饼坯划口是为了排气，不划容易鼓起大泡。"
  ],
  "common_mistakes": [
    "面团揉太硬，炸出来外皮硬得像石头。",
    "油温过高，外皮焦了里面还是生面团。",
    "饼坯太厚没划口，下锅鼓成大球中间夹生。"
  ],
  "substitutions": [
    {
      "original": "五香粉",
      "substitute": "椒盐",
      "ratio": "3 克:4 克",
      "note": "咸香更直接，适合配汤吃。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "15 克:20 克",
      "note": "上色更快，需减少五克温水。"
    }
  ],
  "variations": [
    "面团里加一勺芝麻，炸出来香气更足。",
    "做成小剂子炸成油香圈，孩子更爱吃。"
  ],
  "serving_suggestion": "趁热配牛肉丸子汤或盖碗茶，掰开蘸汤最好吃。",
  "storage": "常温密封一天，冷冻两周；复热用烤箱一百六十度烤五分钟。",
