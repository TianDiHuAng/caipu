  "steps": [
    {
      "n": 1,
      "text": "羊肉块泡水半小时去血水，捞出沥干备用即可。",
      "time_min": 32,
      "heat": "无火",
      "tip": "泡过的羊肉炖出来汤不浑，膻味也淡一半。",
      "visual_cue": "肉色转白，水底见血丝，一目了然"
    },
    {
      "n": 2,
      "text": "粉丝用温水泡十五分钟到软，剪成巴掌长的段。",
      "time_min": 17,
      "heat": "无火",
      "tip": "粉丝剪短一点，舀起来才不缠成一团。",
      "visual_cue": "粉丝透明柔软，能弯折，火候正好"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧热，下姜片、葱段、八角和花椒小火煸香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "香料小火煸，油温太高会立刻发苦，这一步别省。",
      "visual_cue": "香料浮起，油面起细泡，状态到位"
    },
    {
      "n": 4,
      "text": "倒入羊肉块中火翻炒五分钟，把表面炒到微焦收紧。",
      "time_min": 6,
      "heat": "中火",
      "tip": "羊肉先炒出油，汤才白，膻味也压得住。",
      "visual_cue": "肉块上色，锅底见油，颜色清爽"
    },
    {
      "n": 5,
      "text": "沿锅边淋生抽炒匀，加清水一千八百毫升大火烧开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "加热水不加冷水，冷水会让肉块骤缩发硬。",
      "visual_cue": "汤色转深，热气直冒，看着就有食欲"
    },
    {
      "n": 6,
      "text": "撇净浮沫后转小火炖五十分钟，到羊肉用筷子能插透。",
      "time_min": 52,
      "heat": "小火",
      "tip": "汤面只冒小泡最好，滚太猛汤会浑，这一步别省。",
      "visual_cue": "汤色乳白，肉块轻晃，香气已出"
    },
    {
      "n": 7,
      "text": "另起锅烧水，宽面条下锅煮到八分熟捞出即可。",
      "time_min": 8,
      "heat": "大火",
      "tip": "面条煮八分熟就好，剩两分熟交给汤锅。",
      "visual_cue": "面条浮起，边缘略透明，层次分明"
    },
    {
      "n": 8,
      "text": "面片放进羊肉汤里，加粉丝和盐中火烩三分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "烩的过程让面条吸汤，味才进得去，这一步别省。",
      "visual_cue": "面条膨胀，汤汁略稠，火候刚好"
    },
    {
      "n": 9,
      "text": "撒白胡椒和香菜末，连汤带面盛进大碗上桌即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "白胡椒最后放，香味才冲得出来，这一步别省。",
      "visual_cue": "汤面浮香菜，面条宽厚，一目了然"
    }
  ],
  "tips": [
    "烩面的关键是汤，羊汤炖得白，面条才有味道。",
    "面条别煮太软，烩三分钟刚好，泡久了就糊。",
    "配一碟蒜和一点辣椒油，是河南清真馆子的标准吃法。"
  ],
  "common_mistakes": [
    "羊肉没炒就直接炖，汤色发灰，膻味压不住。",
    "面条提前煮到全熟，烩完软塌没咬劲。",
    "汤滚着大火炖一小时，汤浑得像面糊。"
  ],
  "substitutions": [
    {
      "original": "羊肉块",
      "substitute": "牛肉",
      "ratio": "350克:350克",
      "note": "牛肉版炖四十分钟就够，加一片山楂更容易烂。"
    },
    {
      "original": "面条",
      "substitute": "手擀面",
      "ratio": "350克:380克",
      "note": "手擀面更耐煮，烩五分钟也不烂。"
    }
  ],
  "variations": [
    "加一把豆皮和海带丝一起烩，口感层次更丰富。",
    "汤里放两个番茄同炖，酸香开胃，孩子更爱吃。"
  ],
  "serving_suggestion": "用大碗盛面，浇足羊汤，配糖蒜和辣椒油一起吃。",
  "storage": "汤和面分开冷藏可存两天；复热时汤先烧开再放面，别整锅回锅。",
