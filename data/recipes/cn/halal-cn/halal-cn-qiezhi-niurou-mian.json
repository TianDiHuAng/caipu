  "equipment": [
    "汤锅",
    "炒锅",
    "刀",
    "砧板",
    "锅铲",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切成三厘米见方的块，冷水下锅加姜片焯三分钟，撇净浮沫。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅焯，血水才慢慢逼出来。",
      "visual_cue": "浮沫撇净，牛肉块紧缩发白"
    },
    {
      "n": 2,
      "text": "番茄切块，洋葱切丁，姜切片，小葱切葱花备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱丁切小一点，炒化后汤才稠。",
      "visual_cue": "洋葱丁均匀，番茄块带汁"
    },
    {
      "n": 3,
      "text": "炒锅倒花生油下洋葱丁和姜片中火炒三分钟至洋葱透明发甜。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒到透明，甜味出来汤才厚重。",
      "visual_cue": "洋葱软塌透明，锅底微黄"
    },
    {
      "n": 4,
      "text": "下番茄块大火炒五分钟，炒到番茄化成糊状出红油。",
      "time_min": 7,
      "heat": "大火",
      "tip": "番茄一定要炒化，这是汤色的来源。",
      "visual_cue": "番茄完全塌软，锅底一层红汤"
    },
    {
      "n": 5,
      "text": "倒入牛肉块翻匀，加生抽、白糖、八角和清水，大火烧开转小火炖六十分钟。",
      "time_min": 66,
      "heat": "小火",
      "tip": "小火慢炖，牛肉才酥烂不柴，汤也浓。",
      "visual_cue": "牛肉能用筷子扎透，汤色红亮"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，另起锅煮面三分钟，捞进碗里浇汤撒葱花。",
      "time_min": 10,
      "heat": "大火",
      "tip": "面要单独煮，直接下面汤会发浑变黏。",
      "visual_cue": "面条断生，浇上红汤浮着油花"
    }
  ],
  "tips": [
    "牛肉冷水下锅焯，血沫才去得干净。",
    "番茄必须炒化成糊，汤的红亮颜色全靠它。",
    "小火炖足一小时，牛肉才酥烂入味。",
    "面条单独煮，汤才不会浑成一锅糊。"
  ],
  "common_mistakes": [
    "牛肉直接下锅炒，汤浑浊还带腥味。",
    "番茄只炒两下就加水，汤色发白没有酸甜味。",
    "大火猛炖，牛肉外老内柴，汤也收干了。",
    "面条直接下进牛肉汤里煮，最后成了糊汤面。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛腩",
      "ratio": "250克:280克",
      "note": "更油润，炖的时间减十分钟。"
    },
    {
      "original": "面条",
      "substitute": "宽面",
      "ratio": "240克:240克",
      "note": "更挂汤，煮的时间加一分钟。"
    }
  ],
  "variations": [
    "加一根胡萝卜同炖，汤会带自然的甜味。",
    "喜欢辣的可以在炒番茄时加一勺辣椒面。",
    "用高压锅压二十分钟，出门前也能吃上一碗。"
  ],
  "serving_suggestion": "面装碗后浇上滚烫的牛肉汤，撒葱花，配一勺油泼辣子，红汤配白面最过瘾。",
  "storage": "汤底冷藏可放两天，面条现煮现吃，复热汤须煮沸三分钟。",
