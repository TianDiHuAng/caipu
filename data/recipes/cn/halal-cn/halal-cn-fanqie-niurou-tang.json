    "砧板",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆纹切薄片，加姜片和白胡椒抓匀腌十分钟。",
      "time_min": 13,
      "heat": "无火",
      "tip": "逆纹切薄片，煮出来才嫩不塞牙。",
      "visual_cue": "肉片薄透均匀，抓后微黏"
    },
    {
      "n": 2,
      "text": "番茄去蒂切成小块，洋葱切成细丝，姜切成薄片，全部放进盘里备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "番茄切小块些，容易煮化出汁。",
      "visual_cue": "番茄块带汁，洋葱丝均匀"
    },
    {
      "n": 3,
      "text": "汤锅倒花生油下洋葱丝与姜片小火炒三分钟至洋葱变软出甜味。",
      "time_min": 5,
      "heat": "小火",
      "tip": "洋葱炒软，汤底才有自然的甜。",
      "visual_cue": "洋葱软塌透明，闻到甜香"
    },
    {
      "n": 4,
      "text": "下番茄块中火炒五分钟，边炒边压，炒到化成浓稠的糊。",
      "time_min": 7,
      "heat": "中火",
      "tip": "番茄压烂出汁，汤才浓不寡淡。",
      "visual_cue": "番茄完全化开，锅底一层红浆"
    },
    {
      "n": 5,
      "text": "倒入清水大火烧开，转中小火煮十分钟让汤味融合。",
      "time_min": 13,
      "heat": "中小火",
      "tip": "先煮十分钟，番茄的酸味才融进汤里。",
      "visual_cue": "汤色红亮，表面浮着细沫"
    },
    {
      "n": 6,
      "text": "加盐与生抽调味，把牛肉片一片片抖散下锅，煮三分钟至变色。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉片抖散下锅不粘连，煮到变色就够。",
      "visual_cue": "肉片舒展泛白，汤面微微翻滚"
    },
    {
      "n": 7,
      "text": "撇去浮沫，撒白胡椒与葱花，关火盛进汤碗。",
      "time_min": 3,
      "heat": "无火",
      "tip": "出锅前撇沫，汤才清亮好看。",
      "visual_cue": "汤清亮红润，葱花浮在表面"
    }
  ],
  "tips": [
    "牛肉逆纹切薄片，煮三分钟就嫩。",
    "番茄炒化再加水，汤才浓稠有滋味。",
    "肉片一片片抖散下锅，不会粘成一坨。",
    "出锅前撇净表面浮沫，汤色才清亮好看。"
  ],
  "common_mistakes": [
    "牛肉厚切下锅久煮，吃起来又老又柴。",
    "番茄不炒直接加水煮，汤水寡淡没有红亮色。",
    "肉片整把丢进锅，粘成一团外面老里面生。",
    "不撇浮沫就端上桌，汤面一层灰白沫子。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛腩",
      "ratio": "300克:320克",
      "note": "需炖四十分钟才软烂。"
    },
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "400克:320克",
      "note": "酸味更浓，盐减一克。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝，汤更有饱腹感。",
    "放两片香叶同煮，香气更有层次。",
    "换成羊肉片，做成番茄羊肉汤，膻香配酸味很搭。"
  ],
  "serving_suggestion": "盛进汤碗撒葱花，饭前喝一碗开胃，泡馍或配米饭都合适。",
  "storage": "冷藏可放两天，复热须煮沸三分钟，肉片不宜反复加热。",
