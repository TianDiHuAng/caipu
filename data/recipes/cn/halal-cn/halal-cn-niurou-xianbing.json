        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "擀面杖",
    "平底锅",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加两克盐拌匀，倒温水边倒边搅，揉成偏软的面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面团要比饺子面软，太硬煎出来咬不动。",
      "visual_cue": "面团柔软，盆壁干净，火候正好"
    },
    {
      "n": 2,
      "text": "面团表面刷一层植物油，盖湿布醒四十分钟即可。",
      "time_min": 42,
      "heat": "无火",
      "tip": "刷油醒面，擀的时候延展性好，包馅不破。",
      "visual_cue": "面团油润，按压慢慢回弹，状态到位"
    },
    {
      "n": 3,
      "text": "花椒用温水泡十分钟，滤出花椒水放凉备用即可。",
      "time_min": 11,
      "heat": "无火",
      "tip": "花椒水去腥，牛馅料尤其需要，这一步别省。",
      "visual_cue": "水色微黄，花椒味冲，颜色清爽"
    },
    {
      "n": 4,
      "text": "牛肉分三次加花椒水，顺一个方向搅到黏稠上劲。",
      "time_min": 8,
      "heat": "无火",
      "tip": "每次都等水吸干再加，馅料才抱团不出水。",
      "visual_cue": "馅料发亮，能拉出细丝，看着就有食欲"
    },
    {
      "n": 5,
      "text": "洋葱切细丁，用纱布裹住挤掉一部分水分即可。",
      "time_min": 9,
      "heat": "无火",
      "tip": "挤到半干就好，全干就没汁了，饼也不香。",
      "visual_cue": "洋葱丁松散，不见积水，香气已出"
    },
    {
      "n": 6,
      "text": "馅料加姜末、生抽、盐和白胡椒拌匀，再拌入洋葱。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱最后拌，早拌会一直出水，包的时候难收口。",
      "visual_cue": "馅料黏手，颜色均匀，层次分明"
    },
    {
      "n": 7,
      "text": "面团分成六个剂子，擀成中间厚四周薄的圆皮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮别擀太薄，包上馅一煎容易破，这一步别省。",
      "visual_cue": "圆皮匀整，中心略厚，火候刚好"
    },
    {
      "n": 8,
      "text": "放一大勺馅，像包包子一样收口，收口朝下按扁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "馅要包足，按扁时用手掌轻压，别用擀面杖。",
      "visual_cue": "饼坯鼓圆，收口紧实，一目了然"
    },
    {
      "n": 9,
      "text": "平底锅刷油小火烧热，饼坯下锅盖盖煎五分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盖盖煎能让热气把馅焖熟，皮也不发硬。",
      "visual_cue": "底面金黄，饼身鼓起，火候正好"
    },
    {
      "n": 10,
      "text": "翻面再煎四分钟，两面金黄后刷一层薄油出锅。",
      "time_min": 5,
      "heat": "小火",
      "tip": "最后一层薄油让表皮发脆，凉了也不回软。",
      "visual_cue": "两面焦黄，表皮起脆，状态到位"
    }
  ],
  "tips": [
    "清真馅饼只用牛羊肉，洋葱配牛肉是最常见的家常馅。",
    "面团偏软、醒足时间，饼皮才薄而不破。",
    "一次可多包几个，生坯冷冻，早上直接煎很方便。"
  ],
  "common_mistakes": [
    "面团太硬，煎出来的饼边咬不动，像在嚼面片。",
    "洋葱没挤水直接拌馅，饼一煎就漏汤，糊锅底。",
    "大火煎，皮焦了里面的牛肉还是生的。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "350克:350克",
      "note": "羊肉版要多加一点姜末和白胡椒来压膻。"
    },
    {
      "original": "洋葱",
      "substitute": "大葱",
      "ratio": "250克:200克",
      "note": "大葱版葱香更冲，切得越细越好。"
    }
  ],
  "variations": [
    "馅里加一勺孜然粉，立刻变成西北风味的烤肉馅饼。",
    "改成小个头的锅贴状，煎好蘸米醋吃，更适合当早餐。"
  ],
  "serving_suggestion": "出锅稍晾两分钟再吃，配一碗羊汤或豆浆，早餐最合适。",
  "storage": "生坯冷冻可存一个月，冷冻后直接下锅小火慢煎；熟饼冷藏两天，复煎两分钟回脆。",
  "nutrition_estimate": {
    "basis": "按三人份估算",
    "calories_kcal": 680,
    "protein_g": 32,
