  "equipment": [
    "炒锅",
    "汤锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉切成三毫米粗的丝，加五毫升生抽抓匀腌八分钟。",
      "time_min": 9,
      "heat": "无火",
      "tip": "牛肉丝别切太细，下锅一炒就发老。",
      "visual_cue": "肉丝粗细均匀，表面挂汁"
    },
    {
      "n": 2,
      "text": "青椒和洋葱洗净切成丝，大蒜切薄片装小碟备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "青椒洋葱切同宽，成熟时间才一致。",
      "visual_cue": "三样丝宽窄基本接近"
    },
    {
      "n": 3,
      "text": "汤锅加水烧开，下面条煮到七分熟捞出过凉，拌几滴植物油防粘。",
      "time_min": 8,
      "heat": "大火",
      "tip": "七分熟就起锅，炒的时候还会继续熟。",
      "visual_cue": "面条断口有小芯，根根分明"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒烟倒植物油，下牛肉丝大火快炒到变色盛出。",
      "time_min": 4,
      "heat": "大火",
      "tip": "油要够热，牛肉丝下锅才不粘成块。",
      "visual_cue": "肉丝散开边缘微卷"
    },
    {
      "n": 5,
      "text": "锅内下蒜片、洋葱丝炒香，放青椒丝翻炒半分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蒜片炒到微黄就下料，发焦就苦了。",
      "visual_cue": "蒜片金黄，洋葱边缘透明"
    },
    {
      "n": 6,
      "text": "倒回牛肉丝，加生抽、老抽、盐和辣椒粉，翻炒均匀上色。",
      "time_min": 2,
      "heat": "大火",
      "tip": "老抽只负责上色，多放会发黑发咸。",
      "visual_cue": "肉丝酱油色均匀发亮"
    },
    {
      "n": 7,
      "text": "下入面条，用筷子挑散翻炒一分钟，让每根面裹上酱汁。",
      "time_min": 2,
      "heat": "大火",
      "tip": "用筷子挑比铲子好，面条不容易断。",
      "visual_cue": "面条根根挂色，锅底无汤"
    }
  ],
  "tips": [
    "面条煮七分熟过凉拌油，炒时根根分明不粘。",
    "牛肉分两次下锅，先炒香再回锅，肉嫩不柴。",
    "老抽只负责上色，放多了整盘发黑发苦。"
  ],
  "common_mistakes": [
    "面条煮全熟再炒，一炒就烂成面团。",
    "牛肉和配菜一起下锅，肉老菜还生。",
    "油温不够就下牛肉，粘锅又出一锅水。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "芹菜",
      "ratio": "100 克:100 克",
      "note": "清香更重，脆感更好。"
    },
    {
      "original": "面条",
      "substitute": "拉面",
      "ratio": "300 克:300 克",
      "note": "更筋道，炒的时间要多半分钟。"
    }
  ],
  "variations": [
    "加一把豆芽同炒，口感更脆更爽口。",
    "最后淋一勺辣椒油，辣香味道更足。"
  ],
  "serving_suggestion": "趁热盛盘，配一碗清汤和几瓣生蒜，是清真面馆最常见的搭配。",
  "storage": "冷藏一天，复热用炒锅干炒两分钟，微波会变软塌。",
