  "steps": [
    {
      "n": 1,
      "text": "羊肉块在清水里泡一小时，中途换两次水把血水泡出来。",
      "time_min": 62,
      "heat": "无火",
      "tip": "泡够时间，煮出来的汤才清，肉也不带膻味。",
      "visual_cue": "水色泛红，肉块转白，层次分明"
    },
    {
      "n": 2,
      "text": "羊肉冷水下锅，水开后撇净浮沫，捞出用温水冲一遍。",
      "time_min": 10,
      "heat": "大火",
      "tip": "一定要用温水冲，冷水一激肉纤维收紧就发柴。",
      "visual_cue": "肉块干净，表面无沫，火候刚好"
    },
    {
      "n": 3,
      "text": "锅里重新加清水两升半，放羊肉、姜片、葱段和花椒八角。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香料别多，花椒八角各一点就够，多了盖住肉香。",
      "visual_cue": "水面浮起香料，肉块浸没，一目了然"
    },
    {
      "n": 4,
      "text": "大火烧开后转小火，盖盖炖七十分钟到筷子能轻松插透。",
      "time_min": 72,
      "heat": "小火",
      "tip": "小火慢炖汤面只冒小泡，肉才酥而不散。",
      "visual_cue": "汤色微白，肉块微微晃动，火候正好"
    },
    {
      "n": 5,
      "text": "加盐再炖十分钟让咸味进到肉里，然后关火即可。",
      "time_min": 12,
      "heat": "小火",
      "tip": "盐最后放，早放肉会紧，炖再久也不烂。",
      "visual_cue": "汤味转咸，肉色略深，状态到位"
    },
    {
      "n": 6,
      "text": "羊肉捞出晾到不烫手，用保鲜膜包紧放进冰箱冷藏一小时。",
      "time_min": 65,
      "heat": "无火",
      "tip": "冷藏后肉更紧实，切薄片才不会碎，这一步别省。",
      "visual_cue": "肉块收紧，表面干爽，颜色清爽"
    },
    {
      "n": 7,
      "text": "取出羊肉逆着纹理切成两毫米厚的片，整齐码在盘里。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切才咬得断，顺纹切越嚼越塞牙。",
      "visual_cue": "肉片薄透，纹理清晰，看着就有食欲"
    },
    {
      "n": 8,
      "text": "生抽、香油、香菜末调成蘸碟，羊肉片夹着蘸吃。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蘸碟里加一勺煮肉的热汤，味道更融洽。",
      "visual_cue": "蘸汁油亮，香菜浮面，香气已出"
    }
  ],
  "tips": [
    "白切羊肉吃的是本味，香料越少越好，煮出来的汤还能下面。",
    "冷藏定型这一步别省，热着切肉片一定散。",
    "剩下的羊汤撒点盐和香菜，就是一碗清汤。"
  ],
  "common_mistakes": [
    "羊肉没泡血水直接煮，汤浑肉膻，蘸料都盖不住。",
    "全程大火煮，肉外层烂了里面还带红。",
    "肉热着就切片，一夹就散成肉碎，这一条最常犯。"
  ],
  "substitutions": [
    {
      "original": "羊肉块",
      "substitute": "羊排",
      "ratio": "900克:950克",
      "note": "羊排煮五十分钟就够，带骨更香但切片略难。"
    },
    {
      "original": "生抽",
      "substitute": "盐",
      "ratio": "20毫升:6克",
      "note": "只用盐更接近原味，配蒜泥吃也很地道。"
    }
  ],
  "variations": [
    "蘸碟换成蒜泥加米醋，酸香解腻，夏天吃最舒服。",
    "肉片铺在热米饭上，浇一勺羊汤，就是一碗羊肉泡饭。"
  ],
  "serving_suggestion": "肉片码盘，配蘸碟和一碗热羊汤，冬天吃最暖。",
  "storage": "冷藏可存三天，肉片浸泡在少量羊汤里防干；复热用汤烫热，别用微波。",
