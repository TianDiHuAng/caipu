  "equipment": [
    "汤锅",
    "漏勺",
    "刀",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊排斩成大块，用清水浸泡二十分钟逼出血水。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡出血水，煮出来的汤才清亮不腥。",
      "visual_cue": "水面浮出血沫，羊排发白"
    },
    {
      "n": 2,
      "text": "冷水下锅，加料酒和姜片煮开，撇净浮沫后捞出。",
      "time_min": 10,
      "heat": "大火",
      "tip": "必须冷水下锅，血沫才会随温度慢慢逼出。",
      "visual_cue": "浮沫撇净，汤面清亮"
    },
    {
      "n": 3,
      "text": "羊排重新放回汤锅，加入足量清水和小葱结。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水一次加够，中途加水汤味会变淡。",
      "visual_cue": "羊排完全浸在水下"
    },
    {
      "n": 4,
      "text": "放入花椒和八角，大火烧开以后转成小火慢煮。",
      "time_min": 3,
      "heat": "大火",
      "tip": "香料别放多，压过羊味就失了本味。",
      "visual_cue": "汤面微滚，香料浮在表面"
    },
    {
      "n": 5,
      "text": "用小火煮四十分钟，中途撇两次浮油和浮沫。",
      "time_min": 40,
      "heat": "小火",
      "tip": "火要小到汤面只冒小泡，肉才酥而不散。",
      "visual_cue": "羊排酥软，汤色乳白"
    },
    {
      "n": 6,
      "text": "加盐再煮十分钟，让咸味慢慢渗到肉块里面。",
      "time_min": 10,
      "heat": "小火",
      "tip": "盐要最后再放，肉才更容易酥烂入味。",
      "visual_cue": "汤有咸味，肉块微缩"
    },
    {
      "n": 7,
      "text": "大蒜切末加生抽调成蘸汁，羊排捞出趁热上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蘸汁不要加醋，会盖掉羊排本身的鲜味。",
      "visual_cue": "羊排堆盘，配小碗蘸汁"
    }
  ],
  "tips": [
    "羊排冷水下锅焯水，血沫才逼得干净。",
    "全程用小火慢煮，肉酥烂又不至于散形。",
    "盐最后十分钟放，肉质更容易酥软。"
  ],
  "common_mistakes": [
    "热水下锅焯，血沫锁在肉里带腥味。",
    "全程大火滚煮一小时，肉柴汤还发浑。",
    "盐一开始就放，肉煮两小时还发硬。"
  ],
  "substitutions": [
    {
      "original": "羊排",
      "substitute": "羊腿肉",
      "ratio": "800 克:800 克",
      "note": "更瘦，煮制时间减十分钟。"
    },
    {
      "original": "花椒",
      "substitute": "白胡椒粒",
      "ratio": "5 克:5 克",
      "note": "去膻弱一些，香气更柔和。"
    }
  ],
  "variations": [
    "煮好撒一层椒盐再干烤十分钟，外焦里嫩。",
    "汤里加白萝卜同煮，整锅汤会更清甜。"
  ],
  "serving_suggestion": "手抓着吃最地道，配一碟蘸汁和一碗羊排汤。",
  "storage": "冷藏三天，复热时连汤一起小火煮十分钟。",
