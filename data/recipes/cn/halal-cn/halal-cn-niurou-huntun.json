 "equipment": [
  "盆",
  "擀面杖",
  "刀",
  "砧板",
  "汤锅"
 ],
 "steps": [
  {
   "n": 1,
   "text": "中筋面粉加一小撮盐，分次倒入清水，揉成偏硬的面团。",
   "time_min": 10,
   "heat": "无火",
   "tip": "面团要硬一点，擀出的皮才不破。",
   "visual_cue": "面团光滑，按压不留指痕"
  },
  {
   "n": 2,
   "text": "面团盖湿布静置，让面筋松弛，方便后面擀薄。",
   "time_min": 15,
   "heat": "无火",
   "tip": "静置时间不够，擀皮会不断回缩。",
   "visual_cue": "面团按下去缓慢回弹"
  },
  {
   "n": 3,
   "text": "牛里脊剁成细肉料，加入大葱末、姜末、生抽、盐和香油。",
   "time_min": 8,
   "heat": "无火",
   "tip": "肉料剁得细一些，馅才紧实不散。",
   "visual_cue": "肉料细腻，与调料拌成黏团"
  },
  {
   "n": 4,
   "text": "朝一个方向搅打肉料，分两次淋入少量清水，让馅吸足水分。",
   "time_min": 5,
   "heat": "无火",
   "tip": "同一方向搅上劲，煮出来才成团。",
   "visual_cue": "馅料发黏，挑起能成团"
  },
  {
   "n": 5,
   "text": "面团擀成薄大片，切成方形薄面皮，边缘略薄中间稍厚。",
   "time_min": 6,
   "heat": "无火",
   "tip": "皮别擀太厚，薄皮馄饨才好吃，能透光最好。",
   "visual_cue": "透光可见手掌轮廓"
  },
  {
   "n": 6,
   "text": "取一张皮放上馅料，对折捏紧两角，包成元宝形的馄饨。",
   "time_min": 15,
   "heat": "无火",
   "tip": "收口捏实，煮的时候才不开口漏馅，两角要压紧。",
   "visual_cue": "馄饨饱满，边角捏合紧密"
  },
  {
   "n": 7,
   "text": "汤锅水烧开，下馄饨煮到浮起，加一次凉水再煮开。",
   "time_min": 6,
   "heat": "大火",
   "tip": "点一次凉水，皮熟馅也熟，别一直大火滚煮。",
   "visual_cue": "馄饨全部浮起，皮呈半透明"
  },
  {
   "n": 8,
   "text": "碗里放香菜末和少许生抽，冲入煮馄饨的热汤，捞入馄饨，另配一碟香醋蘸食即可。",
   "time_min": 2,
   "heat": "无火",
   "tip": "汤底别加太多调料，突出牛里脊本味。",
   "visual_cue": "汤色清亮，浮着翠绿香菜"
  }
 ],
 "tips": [
  "面团偏硬并静置充分，擀皮才薄而不破。",
  "肉馅顺一个方向搅上劲，煮后抱团不散。",
  "煮馄饨点一次凉水，皮和馅同时熟透。"
 ],
 "common_mistakes": [
  "面团太软，皮擀薄就破，煮成一锅片汤。",
  "肉馅乱搅方向，煮出来散成肉末。",
  "馄饨一直大火滚，皮烂了馅还没熟。"
 ],
 "substitutions": [
  {
   "original": "牛里脊",
   "substitute": "羊腿肉",
   "ratio": "300 克:300 克",
   "note": "清真餐馆常见做法，膻香更足，姜末可多加。"
  },
  {
   "original": "中筋面粉",
   "substitute": "馄饨皮现成",
   "ratio": "300 克:300 克",
   "note": "省去和面时间，皮偏薄，煮制时间缩短三十秒。"
  }
 ],
 "variations": [
  "汤里加紫菜和虾皮同煮，鲜味更足也更清口。",
  "喜欢重口可在蘸碟里加蒜泥和辣椒油。"
 ],
 "serving_suggestion": "连汤盛入碗中，撒香菜，另配一碟香醋蘸着吃。",
 "storage": "生馄饨撒粉后冷冻保存一周，煮时无需解冻，水开直接下锅。",
