  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "春笋剥掉外层硬壳，切掉根部老硬的部位，只留中段嫩芯。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部用手掐一下，掐不动的部分都切掉。",
      "visual_cue": "笋身白嫩，切面没有纤维丝"
    },
    {
      "n": 2,
      "text": "笋切成滚刀块，大小尽量一致，方便受热均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "块别切太小，焖完会缩水变柴，三厘米正好。",
      "visual_cue": "块约三厘米见方，大小一致"
    },
    {
      "n": 3,
      "text": "锅里烧开水加盐，下笋块焯水去掉涩味和草酸。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯水不能省，不焯的笋发涩扎嘴。",
      "visual_cue": "笋块颜色转深，水微微发黄"
    },
    {
      "n": 4,
      "text": "炒锅放植物油烧到六成热，下笋块中火煸炒到表面微微起皱。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煸到边缘泛黄，笋的香气才出来。",
      "visual_cue": "笋块边缘金黄，表面起细皱"
    },
    {
      "n": 5,
      "text": "加生抽、老抽和白糖翻炒上色，倒入清水没过一半笋块。",
      "time_min": 3,
      "heat": "中火",
      "tip": "老抽只为上色，多了整锅发黑，五毫升就够。",
      "visual_cue": "笋块均匀挂上酱色"
    },
    {
      "n": 6,
      "text": "盖盖转小火焖到汤汁剩三分之一，笋块吸饱味道。",
      "time_min": 8,
      "heat": "小火",
      "tip": "小火慢焖才入味，火大汤汁很快烧干。",
      "visual_cue": "汤汁浓稠，笋块发亮"
    },
    {
      "n": 7,
      "text": "开盖转中火收汁，撒葱段翻匀，立刻出锅装盘。",
      "time_min": 3,
      "heat": "中火",
      "tip": "收汁到汤汁挂勺就停火，再收糖会发苦。",
      "visual_cue": "汤汁裹在笋上，锅底无流动汁水"
    }
  ],
  "tips": [
    "笋先焯水去涩，口感才清甜不扎嘴。",
    "煸炒到边缘起皱再下调料，香气更足。",
    "收汁到挂勺就停火，久收糖会发苦。"
  ],
  "common_mistakes": [
    "省掉焯水直接下锅，成品又涩又扎嘴。",
    "大火焖煮，汤汁烧干笋还没入味。",
    "糖放太多又久收，整盘发苦发黑。"
  ],
  "substitutions": [
    {
      "original": "春笋",
      "substitute": "冬笋",
      "ratio": "500 克:500 克",
      "note": "口感更细嫩，涩味轻，焯水时间可减半。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "15 克:18 克",
      "note": "甜味更圆润，需敲碎才好化开。"
    }
  ],
  "variations": [
    "加几片咸肉同焖，鲜咸味更足更下饭。",
    "起锅前淋几滴香油，闽式做法更润口。"
  ],
  "serving_suggestion": "热食最佳，剩下的冷吃也别有风味，配白粥或干饭都合适。",
  "storage": "冷藏两天，复热加少许清水小火焖三分钟回软。",
