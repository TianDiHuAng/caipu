  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芥蓝掰去老叶，用削皮刀削掉茎部粗硬外皮，斜切成段。",
      "time_min": 10,
      "heat": "无火",
      "tip": "粗皮不削，炒完咬着全是筋。 这一步别图省事。",
      "visual_cue": "茎段切口露出嫩绿，手指能掐动。"
    },
    {
      "n": 2,
      "text": "芥蓝洗净后在淡盐水中泡五分钟，捞出沥干水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "菜叶褶皱易藏沙，泡过再冲更干净。 火候宁小勿大。",
      "visual_cue": "叶片挺括，甩一下不见水珠。"
    },
    {
      "n": 3,
      "text": "大蒜拍碎切末，姜切成细丝，分开放好备用。注意不要着急，稳一点更好。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜末别剁太细，拍碎更出香。 别急着省时间。",
      "visual_cue": "蒜末颗粒分明，姜丝细长。"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒白烟，下花生油滑锅后放蒜末姜丝爆香。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅够热菜才脆，温锅下菜会出汤。 手快也要稳。",
      "visual_cue": "蒜末微黄，油面翻起细密气泡。"
    },
    {
      "n": 5,
      "text": "倒入芥蓝大火快炒两分钟，沿锅边淋料酒去涩。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火，翻炒要快，叶子一塌就出锅。",
      "visual_cue": "菜叶由浅绿转深绿，油光发亮。"
    },
    {
      "n": 6,
      "text": "加盐与白糖翻匀，再炒三十秒立刻装盘。注意不要着急，稳一点更好。",
      "time_min": 1,
      "heat": "大火",
      "tip": "盐最后放，早了菜会出水变软。 顺序别颠倒。",
      "visual_cue": "盘中菜茎挺立，底不积水。"
    }
  ],
  "tips": [
    "芥蓝选茎细叶小的，粗茎的苦味重、纤维也硬。",
    "斜切能扩大断面，受热均匀，也更容易入味。",
    "炒菜前把锅烧到冒烟，这是菜脆的关键一步。"
  ],
  "common_mistakes": [
    "小火慢炒，芥蓝出水变黄，一盘菜全塌下去。",
    "盐下太早，菜汁大量渗出，炒成了煮菜。"
  ],
  "substitutions": [
    {
      "original": "芥蓝",
      "substitute": "菜心",
      "ratio": "1:1",
      "note": "菜心更嫩，炒制时间缩短到一分半。"
    }
  ],
  "variations": [
    "闽南家庭会加一勺蒜蓉酱同炒，蒜香更浓，配粥也合适。"
  ],
  "serving_suggestion": "趁热上桌配白粥或卤面都好，也可作荤菜旁的一碟清口菜。",
  "storage": "建议现炒现吃，冷藏后再热会发黄出水，口感大打折扣。",
