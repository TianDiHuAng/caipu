  "equipment": [
    "蒸锅",
    "碗",
    "筷子",
    "炒锅",
    "筛网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进大碗，加盐与一半生抽，用筷子充分打散。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液打匀后过筛，蒸出来才没有蜂窝。",
      "visual_cue": "蛋液颜色一致，表面浮起细密小泡。"
    },
    {
      "n": 2,
      "text": "蛋液按一比一点五加温水搅匀，过筛滤掉泡沫。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一定要用温水，冷水蒸出来分层。 顺序别颠倒。",
      "visual_cue": "碗中蛋液平滑，看不见明显气泡。"
    },
    {
      "n": 3,
      "text": "炒锅下花生油，放姜末炒香，再下猪肉馅炒散。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉末要炒到粒粒分明，不要结成大块。",
      "visual_cue": "肉末由粉转白，锅里油色变亮。"
    },
    {
      "n": 4,
      "text": "肉末加料酒与剩余生抽、白糖炒到出油，盛出备用。",
      "time_min": 3,
      "heat": "中火",
      "tip": "炒到略干，铺在蛋液上才不会沉底。 份量要称准。",
      "visual_cue": "肉末干香松散，锅底留少量油。"
    },
    {
      "n": 5,
      "text": "蛋液碗盖上保鲜膜或扣一个盘子，放进上汽的蒸锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "盖住能防止水汽滴落，表面才平整。 这一步别图省事。",
      "visual_cue": "锅盖缝隙冒白汽，锅内有水声。"
    },
    {
      "n": 6,
      "text": "中火蒸十分钟，见表面凝固定型后揭开盖子。注意不要着急，稳一点更好。",
      "time_min": 10,
      "heat": "中火",
      "tip": "火太大蛋会起蜂窝，中小火最稳。 火候宁小勿大。",
      "visual_cue": "蛋面平滑如镜，轻晃碗有微微颤动。"
    },
    {
      "n": 7,
      "text": "铺上炒好的肉末再蒸两分钟，出锅淋香油撒葱花。",
      "time_min": 2,
      "heat": "中火",
      "tip": "肉末后放，蛋才不会压出坑。 别急着省时间。",
      "visual_cue": "肉末贴在蛋面上，香气扑鼻。"
    }
  ],
  "tips": [
    "蛋水比例一比一点五最嫩，比例太大会蒸不成型。",
    "温水调蛋液是关键，冷水容易分层，开水会直接烫熟。",
    "过筛这一步别省，滤掉的泡沫就是蜂窝的来源。"
  ],
  "common_mistakes": [
    "蛋液不盖直接蒸，水汽滴进去表面坑坑洼洼。",
    "大火猛蒸二十分钟，蛋体老化出水，口感像海绵。"
  ],
  "substitutions": [
    {
      "original": "猪肉馅",
      "substitute": "鸡肉馅",
      "ratio": "1:1",
      "note": "鸡肉更瘦，炒制时补一勺油防干。"
    }
  ],
  "variations": [
    "闽南人家会把肉末换成虾仁与香菇丁，鲜味更足，也更清爽。"
  ],
  "serving_suggestion": "浇一勺热油激香葱花再上桌，配米饭能把汤汁全拌掉。",
  "storage": "冷藏一天内吃完，复蒸五分钟回温，不要微波以免出水。",
