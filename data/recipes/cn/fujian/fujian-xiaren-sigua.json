  "steps": [
    {
      "n": 1,
      "text": "虾仁挑掉背上的肠线，用少许盐和淀粉抓洗一遍，冲净以后吸干表面的水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "抓洗能去黏液和腥味，虾仁炒出来才爽脆透亮。",
      "visual_cue": "虾仁发白透亮，表面干爽不黏"
    },
    {
      "n": 2,
      "text": "虾仁加进米酒、盐和淀粉抓匀，放在一边腌上五分钟让它入味上浆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "上浆后炒的虾仁更嫩，也不容易炒老。",
      "visual_cue": "虾仁裹上薄浆，手感滑润"
    },
    {
      "n": 3,
      "text": "丝瓜削去外皮，切成滚刀块，切好立刻备用不要久放。",
      "time_min": 4,
      "heat": "无火",
      "tip": "丝瓜切开放久了会氧化发黑，切完就下锅。",
      "visual_cue": "块形均匀，切面青白有水光"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，下姜丝与蒜片爆香，倒入虾仁快炒到变色盛出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "虾仁先炒后盛出，最后回锅才嫩，久炒就缩成小团。",
      "visual_cue": "虾仁卷曲变粉红，锅底见汁"
    },
    {
      "n": 5,
      "text": "原锅下入丝瓜块大火翻炒两分钟，再加进盐和白胡椒调味，炒到丝瓜发软。",
      "time_min": 3,
      "heat": "大火",
      "tip": "丝瓜会出水，全程大火快炒，不用另外加水。",
      "visual_cue": "丝瓜变软透明，锅中渗出清汁"
    },
    {
      "n": 6,
      "text": "把炒好的虾仁倒回锅里，撒上葱段，淋几滴香油翻匀后立刻出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "回锅后只翻两下就出锅，虾仁才不老。",
      "visual_cue": "丝瓜翠绿透亮，虾仁粉白分明"
    }
  ],
  "tips": [
    "丝瓜选细长、捏着硬的，软塌的水多味淡。",
    "虾仁用厨房纸吸干水分，上浆才挂得住。",
    "加一勺蛤汤同炒，鲜味更足，是闽南沿海的吃法。"
  ],
  "common_mistakes": [
    "虾仁不挑肠线就下锅，腥味很重，吃的时候还带沙。",
    "丝瓜切好放着不管，下锅前已经黑了一圈。",
    "小火慢炒，丝瓜出水变成汤，虾仁也炒老发柴。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "蛤肉",
      "ratio": "150克:200克",
      "note": "蛤肉更鲜，炒的时间减一分钟。"
    },
    {
      "original": "丝瓜",
      "substitute": "节瓜",
      "ratio": "400克:400克",
      "note": "节瓜出水少，须加两勺清水同炒。"
    }
  ],
  "variations": [
    "加一把粉丝同炒，粉丝吸了汤汁，鲜得下饭。",
    "把虾仁换成鸡蛋，先炒蛋再下丝瓜，是家常的丝瓜炒蛋。"
  ],
  "serving_suggestion": "趁热吃最清鲜，作为夏季家常菜配米饭正合适。",
  "storage": "建议当餐吃完，丝瓜隔夜易发黑出水，口感全无。",
