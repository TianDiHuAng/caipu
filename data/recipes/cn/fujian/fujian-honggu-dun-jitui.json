  "equipment": [
    "砂锅",
    "刀",
    "砧板",
    "漏勺",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红菇用温水泡十分钟，轻轻搓洗掉根部泥沙。这一步别着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡的水沉淀后可以一起下锅，香味更足。",
      "visual_cue": "菇伞舒展，水色转红，状态稳定"
    },
    {
      "n": 2,
      "text": "鸡腿斩成四厘米块，冷水下锅焯到浮沫涌起。这一步别着急。",
      "time_min": 9,
      "heat": "中火",
      "tip": "冷水下锅，血水才逼得出来。，注意火候。",
      "visual_cue": "浮沫灰白，肉块收紧，状态稳定"
    },
    {
      "n": 3,
      "text": "捞出鸡块用温水冲洗，去掉附着的浮沫。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用温水洗，肉才不会骤缩发柴。，注意火候。",
      "visual_cue": "鸡块干净，无浮沫，状态稳定"
    },
    {
      "n": 4,
      "text": "砂锅倒清水，放鸡块和姜片大火烧开。这一步别着急。",
      "time_min": 7,
      "heat": "大火",
      "tip": "水一次加够，中途不添水。，注意火候。",
      "visual_cue": "汤面翻滚，姜香散出，状态稳定"
    },
    {
      "n": 5,
      "text": "烹入料酒，撇净浮沫后转小火炖三十分钟。这一步别着急。",
      "time_min": 32,
      "heat": "小火",
      "tip": "盖盖慢炖，汤才清亮。，注意火候。",
      "visual_cue": "汤色微黄，鸡块变软，状态稳定"
    },
    {
      "n": 6,
      "text": "放红菇连泡菇水一起倒入，小火再炖十五分钟。这一步别着急。",
      "time_min": 16,
      "heat": "小火",
      "tip": "红菇后放，香味才不散尽。，注意火候。",
      "visual_cue": "汤色转淡红，菇香浓，状态稳定"
    },
    {
      "n": 7,
      "text": "加盐调味，撒枸杞焖两分钟即可。这一步别着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盐最后放，肉才不紧。，注意火候。",
      "visual_cue": "枸杞饱满，汤清味厚，状态稳定"
    }
  ],
  "tips": [
    "泡红菇的水沉淀后一起下锅，香味更足。",
    "鸡块冷水焯过，汤才不腥。，值得留意。",
    "小火慢炖，汤色才清亮不浑。，值得留意。"
  ],
  "common_mistakes": [
    "红菇泡洗太狠，香味全跑掉。，值得留意。",
    "全程大火，汤浑肉柴。，值得留意。",
    "过早放盐，鸡肉发紧不烂。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "红菇",
      "substitute": "香菇",
      "ratio": "40 克:50 克",
      "note": "汤色不红，但同样鲜。"
    },
    {
      "original": "鸡腿",
      "substitute": "鸡半只",
      "ratio": "600 克:900 克",
      "note": "炖的时间加十分钟。"
    }
  ],
  "variations": [
    "加几颗红枣，汤更甜润。，值得留意。",
    "放一把干贝，鲜味更浓。，值得留意。"
  ],
  "serving_suggestion": "连汤带肉盛碗，配白米饭。，效果更稳定。",
  "storage": "冷藏两天，复热小火煮开。，效果更稳定。",
