        }
      ]
    }
  ],
  "equipment": [
    "盆",
    "打蛋器",
    "筛网",
    "保鲜膜",
    "小碗",
    "蒸锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "粘米粉与白糖倒进盆里，分三次加温水，边加边搅成没有颗粒的米浆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水别一次倒完，分次搅才不起疙瘩。",
      "visual_cue": "米浆顺滑，舀起能连成线。"
    },
    {
      "n": 2,
      "text": "米浆过一次筛，撇掉表面的浮沫，静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛这步决定糕面细不细，别省。",
      "visual_cue": "筛网上只剩粗粒，浆面平整。"
    },
    {
      "n": 3,
      "text": "酵母用两勺温水化开，倒进米浆里搅匀，让酵母分布均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酵母先用温水化开唤醒，发酵才快也才匀。",
      "visual_cue": "浆面出现细小气泡。"
    },
    {
      "n": 4,
      "text": "盆口盖保鲜膜，放温暖处发酵一个半小时，米浆膨胀到原来一倍半。",
      "time_min": 90,
      "heat": "无火",
      "tip": "温度低就延长发酵，看状态不看时间。",
      "visual_cue": "浆面布满气泡，闻起来有淡淡酒香。"
    },
    {
      "n": 5,
      "text": "发酵好的米浆加小苏打搅匀，静置十分钟散掉酸味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "小苏打别多，多了成品发黄还带涩味。",
      "visual_cue": "酸味变淡，浆面重新平整。"
    },
    {
      "n": 6,
      "text": "小碗内壁刷一层花生油，把米浆舀到七分满，轻震两下排出气泡。",
      "time_min": 10,
      "heat": "无火",
      "tip": "只装七分满，蒸的时候还要往上发。",
      "visual_cue": "碗壁挂油，浆面没有大泡。"
    },
    {
      "n": 7,
      "text": "蒸锅水开后放入小碗，大火蒸十五分钟，关火焖三分钟再开盖。",
      "time_min": 18,
      "heat": "大火",
      "tip": "中途别开盖，塌下去就发不起来了。",
      "visual_cue": "糕面隆起开裂像花，竹签插入不粘。"
    }
  ],
  "tips": [
    "米浆发酵到有酒香、表面起泡才算到位，发不够蒸出来是死糕。",
    "碗糕讲究裂口，裂得开才是发得好，别怕难看。",
    "用粘米粉比现磨米浆省事，口感差别不大。"
  ],
  "common_mistakes": [
    "米浆太稀，蒸出来中间塌成凹坑。",
    "发酵过头酸味重，靠小苏打也压不住。"
  ],
  "substitutions": [
    {
      "original": "粘米粉",
      "substitute": "大米粉",
      "ratio": "250g 对 250g",
      "note": "现磨米浆要用 300g 大米泡一夜再打成浆。"
    }
  ],
  "variations": [
    "闽南人做碗糕会在浆里拌一勺红糖，蒸出来是琥珀色的红糖碗糕，拜拜时更常见。"
  ],
  "serving_suggestion": "放凉后从碗里倒扣出来，配豆浆或茶当早餐，热吃松软凉吃紧实。",
  "storage": "冷藏两天，复蒸五分钟回软，凉透再密封免得返潮。",
