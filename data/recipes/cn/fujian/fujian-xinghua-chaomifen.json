  "steps": [
    {
      "n": 1,
      "text": "干米粉提前二十分钟用冷水泡软，捞出抖散沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "米粉只能用冷水泡，热水一泡就断。",
      "visual_cue": "粉条柔软有弹性，掐一段不见白芯。"
    },
    {
      "n": 2,
      "text": "五花肉切细丝，加料酒与白胡椒粉抓匀，静置十分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "肉丝切细些，炒的时候才和米粉同步熟。",
      "visual_cue": "肉丝根根分离，不见粘连。"
    },
    {
      "n": 3,
      "text": "干香菇泡发切细丝，胡萝卜切丝，豆芽掐去根须洗净，葱蒜切末。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香菇丝要顺着纹理切，嚼起来不柴。",
      "visual_cue": "配菜丝细均匀，豆芽干净。"
    },
    {
      "n": 4,
      "text": "花生油烧热，下五花肉丝煸出油脂，加葱蒜末、香菇丝与虾米炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉丝煸到微焦，米粉炒出来才够香。",
      "visual_cue": "肉丝卷曲，锅里有香菇与油脂的混合香气。"
    },
    {
      "n": 5,
      "text": "下胡萝卜丝与豆芽大火快炒半分钟，加生抽、盐与白糖炒匀。",
      "time_min": 5,
      "heat": "大火",
      "tip": "蔬菜只炒断生，后面还要和米粉一起翻。",
      "visual_cue": "菜丝颜色鲜亮，锅底不见多余的汤水。"
    },
    {
      "n": 6,
      "text": "倒入泡软的米粉，转中火用筷子翻拌到每根上色入味，撒葱绿出锅。",
      "time_min": 4,
      "heat": "中火",
      "tip": "用筷子比铲子好使，翻拌不容易断粉。",
      "visual_cue": "米粉根根分明，颜色均匀不结团。"
    }
  ],
  "tips": [
    "兴化米粉细如发丝，泡发时间宁短勿长，泡过头一炒就断。",
    "炒米粉怕粘锅，油量要比平时炒菜多一勺。",
    "配菜可以换，但水分大的菜要先炒干再下粉。"
  ],
  "common_mistakes": [
    "用热水泡米粉，下锅前就断成一截截。",
    "一次下太多米粉，锅温骤降，炒出来湿软发黏。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "虾仁",
      "ratio": "100g 对 120g",
      "note": "海鲜版要减盐，虾仁本身带咸味。"
    }
  ],
  "variations": [
    "莆田人炒米粉喜欢加一勺红菇汤上色，红汤米粉是酒席上的常客，颜色喜气。"
  ],
  "serving_suggestion": "装盘趁热吃，配一碗紫菜汤，干湿搭配正好。",
  "storage": "冷藏一天，复热用平底锅干炒两分钟，微波会让米粉发硬。",
