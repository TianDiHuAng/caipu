  "steps": [
    {
      "n": 1,
      "text": "鱿鱼撕掉外膜，掏出内脏与透明软骨，冲洗干净后切成零点五厘米宽的圈。",
      "time_min": 8,
      "heat": "无火",
      "tip": "外膜不撕会发韧，圈切均匀才一起熟。",
      "visual_cue": "鱿鱼圈白净，大小一致。"
    },
    {
      "n": 2,
      "text": "姜切丝，蒜切片，小米辣切成圈，小葱切成寸段备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "姜蒜都切薄片，香味出得快也不容易炒焦。",
      "visual_cue": "姜丝蒜片分装齐整，颜色分明。"
    },
    {
      "n": 3,
      "text": "花生油下锅炒香姜丝与蒜片，倒生抽、老抽、白糖与清水烧开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "酱油水下锅要先烧开再放海鲜，腥味才不锁在肉里。",
      "visual_cue": "汤汁酱红起小泡。"
    },
    {
      "n": 4,
      "text": "下鱿鱼圈，中火煮三分钟，看到圈身卷起就关火。",
      "time_min": 4,
      "heat": "中火",
      "tip": "三分钟是上限，多煮一分钟就嚼不动。",
      "visual_cue": "鱿鱼圈卷成小卷，颜色转白。"
    },
    {
      "n": 5,
      "text": "撒小米辣圈与小葱段，连汤汁一起装盘上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "汤汁别收干，闽南人喜欢拿它拌饭。",
      "visual_cue": "盘里见半碗酱汁，葱绿点缀。"
    }
  ],
  "tips": [
    "酱油水的核心是咸鲜带一点甜，糖别省。",
    "鱿鱼要最后下锅，煮的时间越短鱼肉越嫩。",
    "剩下的酱油水别倒，拌白饭或拌面线比菜还抢口。"
  ],
  "common_mistakes": [
    "鱿鱼冷水下锅慢慢煮，肉质越煮越硬。",
    "老抽放得太多，整盘菜乌黑发苦还压住鲜味。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "小管",
      "ratio": "400g 对 400g",
      "note": "小管整只下锅，煮的时间缩到两分钟。"
    }
  ],
  "variations": [
    "东山岛的做法会加一小勺猪油与几粒豆豉，酱汁更厚，用来拌面线一绝。"
  ],
  "serving_suggestion": "连汁装盘，配白饭或拌面线，趁热吃最嫩。",
  "storage": "冷藏一天，复热只需小火烫热，不要久煮。",
