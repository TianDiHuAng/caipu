    "刀",
    "砧板",
    "漏勺",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸭块冷水下锅，加姜片和料酒焯五分钟。这一步别着急。",
      "time_min": 8,
      "heat": "中火",
      "tip": "冷水下锅，腥味才逼得净。，注意火候。",
      "visual_cue": "浮沫厚积，鸭块收紧，状态稳定"
    },
    {
      "n": 2,
      "text": "捞出鸭块用温水冲洗干净备用。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冲掉浮沫，汤才不浑。，注意火候。",
      "visual_cue": "鸭块光洁，无杂质，状态稳定"
    },
    {
      "n": 3,
      "text": "酸菜切段，用清水泡十分钟挤干。这一步别着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡去多余咸酸，汤才不齁。，注意火候。",
      "visual_cue": "菜梗软化，咸味变淡，状态稳定"
    },
    {
      "n": 4,
      "text": "砂锅倒植物油，下姜片和酸菜炒出酸香。这一步别着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酸菜炒过，酸味更柔。，注意火候。",
      "visual_cue": "酸香散出，菜叶油亮，状态稳定"
    },
    {
      "n": 5,
      "text": "放鸭块翻炒两分钟，让鸭皮略出油。这一步别着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "鸭皮煎一下，汤才不腻。，注意火候。",
      "visual_cue": "鸭皮微黄，油脂渗出，状态稳定"
    },
    {
      "n": 6,
      "text": "倒清水大火烧开，撇净浮沫。这一步别着急。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水要一次加够，中途别添。，注意火候。",
      "visual_cue": "汤面清亮，浮沫聚边，状态稳定"
    },
    {
      "n": 7,
      "text": "转小火炖六十分钟，直到鸭肉微软。这一步别着急。",
      "time_min": 62,
      "heat": "小火",
      "tip": "小火慢炖，鸭肉才不柴。，注意火候。",
      "visual_cue": "鸭肉离骨，汤色微黄，状态稳定"
    },
    {
      "n": 8,
      "text": "加盐和白胡椒粉调味，再煮三分钟。这一步别着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "酸菜有咸味，盐要少放。，注意火候。",
      "visual_cue": "汤味酸鲜，胡椒提香，状态稳定"
    }
  ],
  "tips": [
    "酸菜先泡再挤，酸咸才适中。，值得留意。",
    "鸭块焯透，汤才没腥味。，值得留意。",
    "小火慢炖一小时，鸭肉才软而不烂。，值得留意。"
  ],
  "common_mistakes": [
    "酸菜没泡，汤咸得下不了口。，值得留意。",
    "大火猛煮，鸭肉发柴汤浑。，值得留意。",
    "水加少了，中途添水汤味变淡。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鸭",
      "substitute": "鸭腿",
      "ratio": "1200 克:800 克",
      "note": "更易炖烂，时间缩短十五分钟。"
    },
    {
      "original": "酸菜",
      "substitute": "酸萝卜",
      "ratio": "250 克:250 克",
      "note": "酸味更柔和。"
    }
  ],
  "variations": [
    "加一把粉丝，汤更饱腹。，值得留意。",
    "放几片笋干，鲜味更立体。，值得留意。"
  ],
  "serving_suggestion": "热汤配米饭，冬天最合适。，效果更稳定。",
  "storage": "冷藏两天，复热须煮开。，效果更稳定。",
