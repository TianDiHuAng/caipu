  "equipment": [
    "砂锅",
    "刀",
    "砧板",
    "漏勺",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茶树菇剪掉根部老硬部分，用温水泡十五分钟，换水冲洗两遍。",
      "time_min": 15,
      "heat": "无火",
      "tip": "泡菇水静置后取上层，炖汤鲜味翻倍。",
      "visual_cue": "菇柄由硬变软，盆底细沙沉落。"
    },
    {
      "n": 2,
      "text": "猪排骨冷水下锅，加料酒焯到浮沫大量涌起后捞出。",
      "time_min": 12,
      "heat": "中大火",
      "tip": "冷水下锅焯水，血水才慢慢逼出来，肉也不腥。",
      "visual_cue": "浮沫灰白浮起，排骨表面变白。"
    },
    {
      "n": 3,
      "text": "排骨捞出后用温水冲净浮沫，沥干水分，放在一旁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冲洗一定用温水，冷水会让肉纤维骤缩发柴。",
      "visual_cue": "骨段干净，断面不见血丝。"
    },
    {
      "n": 4,
      "text": "砂锅放排骨、姜片与清水，大火烧到汤面强烈翻滚。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水一次加够，中途别添冷水，否则汤味会变淡。",
      "visual_cue": "汤面大滚，姜味随蒸汽散出。"
    },
    {
      "n": 5,
      "text": "撇净浮沫后转小火炖五十分钟，汤色渐转乳白。",
      "time_min": 50,
      "heat": "小火",
      "tip": "盖盖留一条缝，汤不溢又不浑，水汽也不回流。",
      "visual_cue": "排骨轻推能脱骨，汤面浮一层薄油。"
    },
    {
      "n": 6,
      "text": "放入茶树菇连上层泡菇水，续炖十五分钟出香。",
      "time_min": 15,
      "heat": "小火",
      "tip": "茶树菇后放，香气才不被炖散，菇体也更完整。",
      "visual_cue": "菇体吸饱汤汁变得饱满，汤色转深。"
    },
    {
      "n": 7,
      "text": "加盐调味，撒入枸杞再焖三分钟即可关火出锅。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盐最后放，肉才不紧汤才不咸，咸淡更好掌握。",
      "visual_cue": "枸杞鼓胀，汤面清亮不浊。"
    }
  ],
  "tips": [
    "干茶树菇比鲜的香，选菌柄细长、颜色金黄的。",
    "排骨选带一点软骨的肋排，炖完汤甜肉嫩。",
    "撇油时用勺背贴着汤面推，油花聚得更快。"
  ],
  "common_mistakes": [
    "茶树菇泡完不冲洗直接下锅，汤里带泥沙，喝起来牙碜。",
    "全程大火催，汤水耗掉一半，味道浓得发苦。"
  ],
  "substitutions": [
    {
      "original": "茶树菇",
      "substitute": "香菇",
      "ratio": "1:1.5",
      "note": "香菇泡发时间缩短到十分钟即可。"
    }
  ],
  "variations": [
    "闽西人家会加两片当归同炖，汤带药香，冬天喝更暖。"
  ],
  "serving_suggestion": "先喝汤再吃肉，配一碟酱油蘸排骨，剩汤可下面条。",
  "storage": "冷藏两日，复热时撇掉表面凝固的油层再煮开。",
