  "equipment": [
    "砂锅",
    "刀",
    "砧板",
    "漏勺",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "海蚌放淡盐水里静养两小时，中途换两次水，让泥沙吐净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水里滴两滴香油，海蚌吐沙更快也更彻底。",
      "visual_cue": "盆底见到细沙沉落，水色转清。"
    },
    {
      "n": 2,
      "text": "鸡腿肉剁成小块，冷水下锅焯到浮沫涌起后捞出。",
      "time_min": 10,
      "heat": "中火",
      "tip": "冷水下锅血水才逼得出来，热水下锅肉会锁住腥味。",
      "visual_cue": "浮沫灰白成团，肉块收紧变色。"
    },
    {
      "n": 3,
      "text": "鸡块与姜片放进砂锅，加清水与料酒，大火烧开后转小火炖五十分钟。",
      "time_min": 55,
      "heat": "小火",
      "tip": "全程小火，汤才清亮不浑，别让汤大滚。",
      "visual_cue": "汤色转浅金，鸡块轻轻一碰就脱骨。"
    },
    {
      "n": 4,
      "text": "撇净表面浮油，加盐调味，保持汤在微微沸腾的状态。",
      "time_min": 5,
      "heat": "小火",
      "tip": "油撇干净，冲蚌时才不腥，汤面也更清亮。",
      "visual_cue": "汤面清亮见底，油花只有薄薄一层。"
    },
    {
      "n": 5,
      "text": "海蚌刷净外壳，取肉片成两毫米薄片，平铺在汤碗碗底。",
      "time_min": 7,
      "heat": "无火",
      "tip": "片得越薄越均匀，冲汤时才容易一次熟透。",
      "visual_cue": "蚌片透光，边缘微微卷起。"
    },
    {
      "n": 6,
      "text": "滚汤趁沸一次冲入碗中，汆到蚌肉卷边，撒白胡椒与葱花。",
      "time_min": 3,
      "heat": "大火",
      "tip": "汤必须滚沸再冲，温度不够蚌肉发韧。",
      "visual_cue": "蚌肉由透明转乳白并卷成小卷。"
    }
  ],
  "tips": [
    "海蚌吐沙时间宁长勿短，两小时是底限。",
    "冲汤用大汤勺从高处落，冲击力让蚌片瞬间断生。",
    "盐在炖汤阶段就调好，冲碗时不再加。"
  ],
  "common_mistakes": [
    "把海蚌跟鸡块一起下锅煮，蚌肉缩成橡皮筋，鲜味也进了汤渣。",
    "汤不滚就冲，蚌片半生带腥，口感发黏。"
  ],
  "substitutions": [
    {
      "original": "海蚌",
      "substitute": "蛏子",
      "ratio": "1:1",
      "note": "蛏子同样需吐沙，冲汤时间缩短一半。"
    }
  ],
  "variations": [
    "闽南做法会在碗底垫两片薄姜，去腥同时多一层辛香。"
  ],
  "serving_suggestion": "现冲现吃，配一小碟虾油蘸蚌片，汤要趁热喝第一口。",
  "storage": "蚌片不可隔夜，汤可冷藏一日，复热后另冲新蚌片。",
