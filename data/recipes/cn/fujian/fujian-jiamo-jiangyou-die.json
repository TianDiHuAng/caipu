  "equipment": [
    "小碗",
    "小锅",
    "汤匙",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄芥末倒进小碗，加温水少许，顺一个方向搅成稠糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水一点一点加，芥末糊才细腻不结块。",
      "visual_cue": "芥末糊光滑无颗粒，挑起能缓慢流下。"
    },
    {
      "n": 2,
      "text": "芥末糊盖上碗盖静置十分钟，让辛辣充分发出来。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置时间越长辣味越冲，按口味调整。",
      "visual_cue": "揭开盖子一股冲鼻的辛辣直往上冲。"
    },
    {
      "n": 3,
      "text": "小锅倒入生抽与米醋，加白糖与盐小火加热到糖化开。",
      "time_min": 3,
      "heat": "小火",
      "tip": "只加热到糖化就好，煮沸会让酱油发苦。",
      "visual_cue": "锅边冒小泡，糖粒完全消失。"
    },
    {
      "n": 4,
      "text": "调好的酱油汁离火晾到温热，再倒入芥末糊拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁太烫会把芥末的辣味冲散，温热即可。",
      "visual_cue": "酱汁呈浅琥珀色，芥末均匀悬浮。"
    },
    {
      "n": 5,
      "text": "淋香油，撒葱花碎，装碟或装罐冷藏保存就行。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油一定要最后淋，香气才不被热气带走。",
      "visual_cue": "碟面浮一层油光，葱花零星点缀。"
    }
  ],
  "tips": [
    "黄芥末与水的比例约一比一，太稀挂不住食材。",
    "调好的酱碟静置半小时再用，辣度与咸度更融合。",
    "吃白灼海鲜时酱碟别倒太多，蘸一下即可。"
  ],
  "common_mistakes": [
    "芥末糊用开水冲，辣味被破坏，只剩一股粉味。",
    "酱油汁烧到大滚，酱香变糊味，蘸起来发苦。"
  ],
  "substitutions": [
    {
      "original": "黄芥末",
      "substitute": "第戎芥末",
      "ratio": "1:1.2",
      "note": "第戎芥末已调味，白糖可减半。"
    }
  ],
  "variations": [
    "闽南沿海吃白灼章鱼时会加一勺蒜蓉，辛辣之外多一层蒜香。"
  ],
  "serving_suggestion": "配白灼虾、白灼章鱼或烫螺片最合适，也常与生鱼片同碟上桌。",
  "storage": "密封冷藏可存一个月，芥末辣度会随时间减弱，两周内风味最佳。",
