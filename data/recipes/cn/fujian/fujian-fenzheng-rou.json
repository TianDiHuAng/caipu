  "equipment": [
    "蒸锅",
    "深碗",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成一厘米厚的大片，装进碗里准备腌制。",
      "time_min": 8,
      "heat": "无火",
      "tip": "片要够厚，蒸久了才不会缩成渣。 火候宁小勿大。",
      "visual_cue": "肉片大小一致，肥瘦相间。"
    },
    {
      "n": 2,
      "text": "肉片加生抽、料酒、腐乳与白糖抓匀，冷藏腌四十分钟。",
      "time_min": 40,
      "heat": "无火",
      "tip": "腐乳要压碎再拌，味道才均匀。 别急着省时间。",
      "visual_cue": "肉片染上酱色，表面发亮。"
    },
    {
      "n": 3,
      "text": "花椒下干锅小火焙香，倒出用刀背碾成粗末。注意不要着急，稳一点更好。",
      "time_min": 3,
      "heat": "小火",
      "tip": "花椒一变色就出锅，焦了会发苦。 手快也要稳。",
      "visual_cue": "花椒脆响，碾开香气直冲鼻子。"
    },
    {
      "n": 4,
      "text": "蒸肉米粉与花椒末拌进肉片，淋花生油抓匀让粉吸住。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉要裹到每片发干，蒸出来才松散。 顺序别颠倒。",
      "visual_cue": "肉片表面一层粗粉，盆底无积水。"
    },
    {
      "n": 5,
      "text": "红薯块铺在深碗底部，肉片皮朝下码在上面，压平。",
      "time_min": 5,
      "heat": "无火",
      "tip": "红薯垫底吸油，蒸完比肉还香。 份量要称准。",
      "visual_cue": "碗内肉片紧实平齐，红薯在底下。"
    },
    {
      "n": 6,
      "text": "蒸锅加水烧开，放入深碗大火蒸七十分钟，中途补热水。",
      "time_min": 70,
      "heat": "大火",
      "tip": "水一定加到足量，干锅会把碗蒸裂。 这一步别图省事。",
      "visual_cue": "厨房里满是米香，碗边渗出油脂。"
    },
    {
      "n": 7,
      "text": "出锅撒葱花，趁热连红薯一起翻拌上桌。注意不要着急，稳一点更好。",
      "time_min": 2,
      "heat": "无火",
      "tip": "翻拌要在碗里做，避免汤汁洒出。 火候宁小勿大。",
      "visual_cue": "米粉吸饱油汁，红薯软糯发亮。"
    }
  ],
  "tips": [
    "蒸肉米粉自己炒米打碎更香，颗粒粗一点口感更好。",
    "腌肉时间给足四十分钟，粉蒸肉的味道全靠这一步。",
    "蒸锅水要一次加够，中途加冷水会让米粉夹生。"
  ],
  "common_mistakes": [
    "米粉裹得太湿，蒸完结成硬块，一夹就散。",
    "红薯切得太小，蒸到最后化成泥，整碗卖相差。"
  ],
  "substitutions": [
    {
      "original": "蒸肉米粉",
      "substitute": "大米",
      "ratio": "100g 对 120g",
      "note": "大米干锅炒黄后打碎，香味更足。"
    }
  ],
  "variations": [
    "闽北版本会在米粉里掺一点糯米粉，成品更黏糯，也更容易裹紧。"
  ],
  "serving_suggestion": "连碗上桌，配一碟酸菜或凉拌黄瓜解腻，是冬日里的家常硬菜。",
  "storage": "冷藏三天，复蒸二十分钟回软；冷冻可存两周。",
