  "steps": [
    {
      "n": 1,
      "text": "冬瓜去皮去瓤，切成三厘米见方、两厘米厚的块，表面划十字花刀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "划花刀能让酱汁渗进去，冬瓜本身不爱入味。",
      "visual_cue": "块形方正，刀口深约一厘米"
    },
    {
      "n": 2,
      "text": "炒锅倒进植物油烧热，把冬瓜块摆进去用中火煎到两面微微发黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎过再烧的冬瓜不容易散块，还能多出一层焦香，味道更厚。",
      "visual_cue": "两面结起浅黄色的薄皮，块形完整挺立不塌"
    },
    {
      "n": 3,
      "text": "把煎好的冬瓜拨到锅的一边，下入蒜末和干辣椒段炒出香味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蒜末要先炒香再和冬瓜合炒，这样整道菜才有扎实的底味。",
      "visual_cue": "蒜末边缘微微发黄，香辣的气味明显散出来"
    },
    {
      "n": 4,
      "text": "加进生抽、老抽、白糖和小半碗清水，翻匀以后盖上锅盖烧六分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "水别多，冬瓜自身会出水，烧到收汁才进味。",
      "visual_cue": "冬瓜吸汁变深，锅底汤汁减半"
    },
    {
      "n": 5,
      "text": "淀粉加清水调成薄芡淋进锅里，撒上盐和葱段，翻匀以后就可以出锅装盘了。",
      "time_min": 3,
      "heat": "大火",
      "tip": "勾芡让酱汁挂住冬瓜，看着油亮吃着有味。",
      "visual_cue": "酱汁浓亮裹身，葱段翠绿"
    }
  ],
  "tips": [
    "冬瓜皮削厚一些，靠近皮的部分最硬，煮不烂。",
    "加几片五花肉同烧，冬瓜吸了肉香，比肉好吃。",
    "喜欢清淡的可省去老抽，只用生抽与盐，颜色更素雅。"
  ],
  "common_mistakes": [
    "冬瓜切太薄，一烧就烂成泥，全无口感。",
    "水放太多又不收汁，做成了一锅冬瓜汤。",
    "直接下锅就烧不先煎，冬瓜散得快，还寡淡无味。"
  ],
  "substitutions": [
    {
      "original": "冬瓜",
      "substitute": "节瓜",
      "ratio": "600克:600克",
      "note": "节瓜更紧实，烧的时间延长两分钟。"
    },
    {
      "original": "生抽",
      "substitute": "鱼露",
      "ratio": "20毫升:15毫升",
      "note": "鱼露更咸鲜，盐可省去。"
    }
  ],
  "variations": [
    "加一勺虾米同烧，鲜味立刻上一个档，是闽南人的做法。",
    "把冬瓜换成萝卜同烧，冬天吃更清甜软糯。"
  ],
  "serving_suggestion": "连汁浇在米饭上，作为家常配菜搭配荤菜正好。",
  "storage": "冷藏可存两天，复热须小火加两勺水焖三分钟。",
