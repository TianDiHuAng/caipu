  "steps": [
    {
      "n": 1,
      "text": "干燕皮用湿布盖住回软 20 分钟，取出切成 8 厘米见方的方片。",
      "time_min": 22,
      "heat": "无火",
      "tip": "湿布别太湿，燕皮吸水多了会烂。",
      "visual_cue": "燕皮柔软可折叠、边缘不发脆"
    },
    {
      "n": 2,
      "text": "五花肉剁成细泥，加姜末、20ml 生抽、15ml 料酒、2g 盐与白胡椒粉搅打上劲。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺一个方向搅，肉泥才抱团不散。",
      "visual_cue": "肉泥黏稠挂勺、颜色发亮"
    },
    {
      "n": 3,
      "text": "取一张燕皮放掌心，挑一勺肉泥包成小馄饨状，捏紧收口。",
      "time_min": 10,
      "heat": "无火",
      "tip": "收口一定要捏紧，煮时肉料才不会跑。",
      "visual_cue": "燕饺饱满、收口处紧实"
    },
    {
      "n": 4,
      "text": "汤锅加 1200ml 清水烧开，下燕饺中火煮 6 分钟至全部浮起。",
      "time_min": 8,
      "heat": "中火",
      "tip": "水保持微沸，滚太猛会把皮冲破。",
      "visual_cue": "燕饺浮起、皮呈半透明"
    },
    {
      "n": 5,
      "text": "放入鹌鹑蛋、紫菜与剩余 4g 盐，再煮 2 分钟让味道融合。",
      "time_min": 3,
      "heat": "中火",
      "tip": "紫菜最后放，久煮会发黏。",
      "visual_cue": "汤色清亮、紫菜舒展"
    },
    {
      "n": 6,
      "text": "关火撒葱花与白胡椒粉，盛碗时先舀燕饺再浇汤。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花关火后放，香气才留得住。",
      "visual_cue": "汤面清爽、葱花翠绿"
    }
  ],
  "tips": [
    "燕皮回软到能折叠就好，过软会包不住肉料。",
    "肉泥必须搅打上劲，煮出来才弹牙不散。",
    "汤保持微沸，猛火烧会把燕皮冲破。"
  ],
  "common_mistakes": [
    "燕皮泡水回软，包的时候一碰就破。",
    "肉泥没搅打，下锅后馅料全散在汤里。",
    "大火滚煮，燕饺皮开肉绽卖相全毁。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "鸡腿肉",
      "ratio": "300g 对 300g",
      "note": "口感更清爽，需补 10ml 食用油。"
    },
    {
      "original": "鹌鹑蛋",
      "substitute": "鸡蛋",
      "ratio": "6 个 对 3 个",
      "note": "煮熟切半再放。"
    }
  ],
  "variations": [
    "酸辣版：起锅加 20ml 香醋与 5g 辣椒油。",
    "海鲜版：加 100g 鲜虾仁同煮。"
  ],
  "serving_suggestion": "作为福州宴席的开场汤，配一碟红糟蘸食。",
  "storage": "生燕饺冷冻 1 个月，熟汤冷藏 1 天，不可反复加热。",
