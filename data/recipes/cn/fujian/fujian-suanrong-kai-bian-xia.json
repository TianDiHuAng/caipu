    "刀",
    "砧板",
    "小碗",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "基围虾剪去虾枪与虾须，背部剖开但不切断，挑净泥肠。",
      "time_min": 10,
      "heat": "无火",
      "tip": "剖开别切断，虾身才能摊平受热均匀。",
      "visual_cue": "虾背张开呈蝴蝶状，泥肠清空。"
    },
    {
      "n": 2,
      "text": "大蒜剁成蓉，取一半下花生油小火炒到微黄成金蒜。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蒜蓉一变色就关火，余温还会继续上色。",
      "visual_cue": "蒜蓉浮起，颜色由白转浅金。"
    },
    {
      "n": 3,
      "text": "金蒜与生蒜蓉拌匀，加盐与生抽调成蒜蓉酱汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "生熟蒜各半，香味才既有冲劲又柔和。",
      "visual_cue": "酱料黏稠能挂勺，蒜香扑鼻。"
    },
    {
      "n": 4,
      "text": "虾背朝上摆入盘中，把蒜蓉酱一一填进开好的虾背。",
      "time_min": 5,
      "heat": "无火",
      "tip": "每只虾背都要填满蒜蓉，蒸出来才够入味。",
      "visual_cue": "虾背鼓起，蒜蓉铺满不溢出。"
    },
    {
      "n": 5,
      "text": "水开后上锅大火蒸六分钟，见虾身卷曲变红即熟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "六分钟已经是上限，蒸久了虾肉就发柴。",
      "visual_cue": "虾壳通体橙红，虾肉由透明转白。"
    },
    {
      "n": 6,
      "text": "出锅撒葱花，另烧少量花生油浇在葱花上激香即可。",
      "time_min": 3,
      "heat": "大火",
      "tip": "激香用的油量少一些，别把蒜蓉全冲散了。",
      "visual_cue": "葱花蜷曲变色，热油滋滋作响。"
    }
  ],
  "tips": [
    "虾开背后用刀背轻拍两下，摊得更平，蒸时受热均匀。",
    "蒜蓉一半炒一半生，是这道菜不放味精也鲜的关键。",
    "蒸盘里垫两片姜，底味更干净，也不易粘盘。"
  ],
  "common_mistakes": [
    "蒜蓉全用生的直接蒸，蒜辣味呛口，香气也出不来。",
    "蒸的时间超过八分钟，虾肉脱水变硬，壳肉粘连。"
  ],
  "substitutions": [
    {
      "original": "基围虾",
      "substitute": "明虾",
      "ratio": "1:1",
      "note": "明虾个头更大，蒸制时间延长一分钟。"
    }
  ],
  "variations": [
    "闽南版本会在蒜蓉里加一勺沙茶酱，风味更浓，带一点南洋气息。"
  ],
  "serving_suggestion": "连盘上桌，趁热连蒜蓉一起吃，配一碗白饭最合适。",
  "storage": "冷藏一日，复蒸三分钟，蒜蓉会回软但仍可食用。",
