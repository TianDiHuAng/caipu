  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐横刀片成一厘米厚的方块，用厨房纸压去水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "压十分钟，水分去得越多煎得越脆。 这一步别图快。",
      "visual_cue": "豆腐片挺括，纸上留大片水痕。"
    },
    {
      "n": 2,
      "text": "豆腐两面薄薄撒盐，静置五分钟让底味渗进去。",
      "time_min": 5,
      "heat": "无火",
      "tip": "撒盐后表面会出水，煎前再吸一次。 火候宁小勿大。",
      "visual_cue": "豆腐表面微微发亮，盐粒化开。"
    },
    {
      "n": 3,
      "text": "小碗里放生抽、白糖与两勺清水，调成淋汁备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汁先调好，煎好立刻淋，豆腐才吸得住。",
      "visual_cue": "碗中汁液清亮，糖完全化开。"
    },
    {
      "n": 4,
      "text": "平底锅下花生油烧到六成热，豆腐片平铺入锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "豆腐之间留缝，挤在一起会粘成一片。",
      "visual_cue": "油面泛起细纹，豆腐边缘冒小泡。"
    },
    {
      "n": 5,
      "text": "中小火煎四分钟至底面金黄结壳，用铲子托底翻面。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "没结壳就翻，豆腐必然破皮粘锅。 次序不能颠倒。",
      "visual_cue": "底面均匀金黄，晃动锅豆腐会滑动。"
    },
    {
      "n": 6,
      "text": "另一面再煎四分钟，两面都焦黄时沿锅边淋入调好的汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "汁从锅边淋，香味被热油激出来。 手上动作要稳。",
      "visual_cue": "酱汁在锅里滚开，裹上豆腐。"
    },
    {
      "n": 7,
      "text": "收汁一分钟撒蒜末与葱花，盛出装盘趁热吃。注意火候，不要着急。",
      "time_min": 1,
      "heat": "小火",
      "tip": "葱花最后撒，颜色才翠绿。 量要称准。",
      "visual_cue": "豆腐表面亮泽，葱蒜香气冲鼻。"
    }
  ],
  "tips": [
    "一定要用北豆腐，嫩豆腐一煎就散。，这一点要记住。",
    "锅要烧透再下油，热锅凉油豆腐才不粘。",
    "煎到一面定型再翻，耐心比技巧重要。"
  ],
  "common_mistakes": [
    "豆腐带水下锅，油花四溅还粘得满锅都是。",
    "频繁翻面，豆腐皮破了，卖相与口感全毁。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "老豆腐",
      "ratio": "1:1",
      "note": "老豆腐质地更紧，煎制时间可略缩短。"
    }
  ],
  "variations": [
    "闽西客家人会撒一把韭菜段同煎，出锅前淋一勺红糟，香气更浓。"
  ],
  "serving_suggestion": "配白粥或米饭，也可当早餐小菜，冷吃外皮依旧有嚼头。",
  "storage": "冷藏两天，复热用平底锅小火干煎，微波会让外皮发韧。",
