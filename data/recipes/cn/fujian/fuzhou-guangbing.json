  "equipment": [
    "面盆",
    "烤箱",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "4g 酵母用 260ml 温水化开，倒入 500g 面粉搅成絮状后揉成光滑面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水温别超过体温，太烫会烫死酵母。",
      "visual_cue": "面团光滑不粘手、盆壁干净"
    },
    {
      "n": 2,
      "text": "面团盖湿布放置温暖处发酵 90 分钟，至体积膨胀到两倍大。",
      "time_min": 95,
      "heat": "无火",
      "tip": "发到手指按压回弹即发好，别发过头。",
      "visual_cue": "体积两倍、内部呈蜂窝孔"
    },
    {
      "n": 3,
      "text": "五花肉剁成的肉丁加 15ml 生抽、6g 盐与 2g 五香粉拌匀，再拌入 60g 葱花。",
      "time_min": 6,
      "heat": "无火",
      "tip": "葱花最后拌，提前拌会出水发酸。",
      "visual_cue": "五花肉粒黏稠、葱绿分布均匀"
    },
    {
      "n": 4,
      "text": "发好的面团排气后搓条，切成每个约 50g 的剂子，擀成中间厚边缘薄的面皮。",
      "time_min": 10,
      "heat": "无火",
      "tip": "中间厚是为了托住馅料不漏底。",
      "visual_cue": "面皮直径约 10cm、边缘轻按不破"
    },
    {
      "n": 5,
      "text": "包入约 20g 肉丁收口捏紧，压扁成直径 8cm 的圆饼，刷清水后粘满 20g 熟白芝麻。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刷水粘芝麻才粘得牢，一烤不掉。",
      "visual_cue": "饼坯扁平规整、芝麻铺满表面"
    },
    {
      "n": 6,
      "text": "烤箱上下火 200℃ 预热，饼坯入中下层烤 22 分钟至表面金黄鼓起。",
      "time_min": 25,
      "heat": "中火",
      "tip": "最后三分钟开热风，底壳更脆。",
      "visual_cue": "饼面金黄、底部干爽不软"
    }
  ],
  "tips": [
    "面团要比做包子略硬一些，烤出来才脆。",
    "饼坯压得越扁越好，中间鼓起就说明火候到位。",
    "烤好的光饼冷却后密封回软会变韧，建议当天吃完。"
  ],
  "common_mistakes": [
    "面团发酵过头，成品带明显酸味。",
    "五花肉粒包得太满，边缘被撑破，烤的时候漏油",
    "烤箱温度不够，饼面发白不脆，咬着像馒头"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪油渣",
      "ratio": "150g 对 100g",
      "note": "更古老的做法，香脆带劲。"
    },
    {
      "original": "五香粉",
      "substitute": "花椒粉",
      "ratio": "2g 对 1.5g",
      "note": "麻香更突出，是闽北变体。"
    }
  ],
  "variations": [
    "光饼夹蚶版：饼胚侧切夹入炒蛤，是福州馆子的吃法。",
    "甜光饼版：五花肉粒换成红糖芝麻，作茶点。"
  ],
  "serving_suggestion": "趁热横切夹入炒油菜或卤肉，配稀粥就是福州人的早餐。",
  "storage": "密封常温存 2 天，冷冻可存 2 周，复烤 5 分钟回脆。",
