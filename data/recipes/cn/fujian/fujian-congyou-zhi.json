  ],
  "equipment": [
    "小锅",
    "滤网",
    "密封罐",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小葱 200g 洗净后彻底晾干，葱白切成 5 厘米段，葱绿单独切成长段备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "葱必须晾干，带水下油锅会爆溅。",
      "visual_cue": "葱段表面无水、切口齐整"
    },
    {
      "n": 2,
      "text": "小锅倒入 200ml 植物油，冷油下葱白与洋葱丝，开小火慢熬。",
      "time_min": 3,
      "heat": "小火",
      "tip": "冷油下葱，香味才慢慢浸出来。",
      "visual_cue": "油面平静、葱段开始冒小泡"
    },
    {
      "n": 3,
      "text": "保持小火熬 10 分钟，其间翻动两次，至葱白发黄、洋葱丝变软金黄。",
      "time_min": 11,
      "heat": "小火",
      "tip": "全程小火，火大葱会焦苦。",
      "visual_cue": "葱白浅金、洋葱丝透明发黄"
    },
    {
      "n": 4,
      "text": "放入葱绿段继续小火熬 3 分钟至葱绿变深绿微卷，立即关火。",
      "time_min": 4,
      "heat": "小火",
      "tip": "葱绿最后放，久熬会发黑。",
      "visual_cue": "葱绿变深、香气浓烈"
    },
    {
      "n": 5,
      "text": "用滤网把葱油滤入耐热碗，葱渣留用；另取小碗放 60ml 生抽、10g 白糖与 3g 盐拌至溶解。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油温高时别直接倒酱油，会溅。",
      "visual_cue": "葱油透亮金黄、酱汁糖已化开"
    },
    {
      "n": 6,
      "text": "食用时按 3 份葱油配 1 份酱汁搅匀，可撒少许葱渣增香。",
      "time_min": 2,
      "heat": "无火",
      "tip": "现拌现用，久放酱香会散。",
      "visual_cue": "油汁融合、表面浮葱香"
    }
  ],
  "tips": [
    "葱一定要晾干再下锅，否则热油会剧烈飞溅。",
    "全程小火慢熬，葱香才会被油完整带走。",
    "葱油与酱汁分开存，吃的时候再混合。"
  ],
  "common_mistakes": [
    "大火熬葱，葱段几秒钟就焦黑发苦。",
    "葱带水下油锅，热油四溅烫到手。",
    "葱油与酱油一起久煮，酱香变咸涩。"
  ],
  "substitutions": [
    {
      "original": "小葱",
      "substitute": "大葱",
      "ratio": "200g 对 250g",
      "note": "葱味更冲，需多熬 2 分钟。"
    },
    {
      "original": "生抽",
      "substitute": "酱油",
      "ratio": "60ml 对 55ml",
      "note": "咸度更高，盐可省去。"
    }
  ],
  "variations": [
    "虾油版：加 20ml 虾油同熬，鲜味更足。",
    "辣味版：油中加 5g 干辣椒段同熬。"
  ],
  "serving_suggestion": "拌面、淋白灼青菜或蘸白切鸡都合适。",
  "storage": "葱油冷藏可存 2 周，酱汁冷藏 1 周。",
