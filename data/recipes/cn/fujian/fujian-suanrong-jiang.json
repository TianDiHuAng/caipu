  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 200,
          "unit": "g",
          "note": "一半剁蓉一半切末",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 200,
          "unit": "ml",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 30,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "提鲜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小锅",
    "碗",
    "漏勺",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蒜 200g 剥皮去蒂，一半剁成细蓉，一半切成粗末，分开装碗。",
      "time_min": 8,
      "heat": "无火",
      "tip": "粗细分开，口感层次差很多。",
      "visual_cue": "细蓉与粗末分装两碗、颗粒分明"
    },
    {
      "n": 2,
      "text": "小锅倒 120ml 植物油，冷油下蒜蓉，小火慢炸 8 分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "冷油下锅，蒜香才慢慢出来不发苦。",
      "visual_cue": "蒜蓉浮起、颜色浅金"
    },
    {
      "n": 3,
      "text": "炸至蒜蓉变浅金色时连油一起倒出，静置放凉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "浅金就起锅，余温会继续加深颜色。",
      "visual_cue": "蒜蓉浅金、油色清亮"
    },
    {
      "n": 4,
      "text": "另取 80ml 植物油烧至冒烟，浇在粗蒜末上激出香气。",
      "time_min": 3,
      "heat": "中火",
      "tip": "热油要够热，蒜末才会瞬间爆香。",
      "visual_cue": "蒜末翻滚、香气浓烈"
    },
    {
      "n": 5,
      "text": "把炸蒜蓉与浇油蒜末混合，加 8g 盐、30ml 生抽与 5g 白糖拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖只为提鲜，吃不出甜味才对。",
      "visual_cue": "酱体油润、蒜粒均匀分布"
    },
    {
      "n": 6,
      "text": "装入干燥密封罐，冷藏静置 1 小时后风味更融合。",
      "time_min": 2,
      "heat": "无火",
      "tip": "罐子必须无水，否则容易霉变。",
      "visual_cue": "表面覆一层清油、无气泡"
    }
  ],
  "tips": [
    "一半炸一半生蒜，香气和辛辣才平衡。",
    "炸蒜用冷油下锅，火大就会发苦。",
    "装罐一定要无水无油，能存更久。"
  ],
  "common_mistakes": [
    "全程大火炸蒜，颜色瞬间焦黑发苦。",
    "一次放入过量盐，蘸任何食材都过咸。",
    "装酱的罐子带水，几天后表面就长霉。"
  ],
  "substitutions": [
    {
      "original": "蒜",
      "substitute": "红葱头",
      "ratio": "200g 对 200g",
      "note": "香气偏甜，闽南风味更浓。"
    },
    {
      "original": "植物油",
      "substitute": "花生油",
      "ratio": "200ml 对 200ml",
      "note": "坚果香更突出。"
    }
  ],
  "variations": [
    "加 10g 沙茶酱同拌，变成沙茶蒜蓉酱。",
    "加 5g 剁椒，做成蒜蓉辣酱。"
  ],
  "serving_suggestion": "配白灼海鲜、蒸菜或拌面，也可作火锅蘸料。",
  "storage": "冷藏可存 2 周，取用请用干净干勺。",
