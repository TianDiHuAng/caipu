  "steps": [
    {
      "n": 1,
      "text": "大蒜剁成细蓉，红辣椒去蒂切碎，一起放进小碗备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "辣椒籽可留一半，成品的辣度层次更有变化。",
      "visual_cue": "蒜蓉与辣椒碎混匀，颜色红白相间。"
    },
    {
      "n": 2,
      "text": "小锅倒入番茄酱与辣椒酱，小火慢炒到颜色变深。",
      "time_min": 4,
      "heat": "小火",
      "tip": "酱要炒过才没生番茄味，颜色也更红亮。",
      "visual_cue": "酱体由亮红转成暗红，香气发甜。"
    },
    {
      "n": 3,
      "text": "下蒜蓉与辣椒碎同炒，闻到蒜香后加白糖与盐。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜蓉千万别炒焦，一旦焦了整锅都是糊味。",
      "visual_cue": "蒜蓉边缘微黄，酱面冒小泡。"
    },
    {
      "n": 4,
      "text": "倒入米醋搅匀，玉米淀粉加水调开，慢慢淋进锅里。",
      "time_min": 3,
      "heat": "小火",
      "tip": "淀粉水要边淋边搅，否则下锅就成了疙瘩。",
      "visual_cue": "酱汁明显变稠，能挂住锅铲。"
    },
    {
      "n": 5,
      "text": "继续小火翻搅到冒大泡、酱体发亮，关火晾到温热。",
      "time_min": 2,
      "heat": "小火",
      "tip": "冒大泡说明淀粉完全糊化，装罐才不返稀。",
      "visual_cue": "酱面大泡鼓起又破，颜色像山楂糕。"
    }
  ],
  "tips": [
    "甜辣酱的甜要压住辣，白糖可按口味加到三十克。",
    "番茄酱选无添加的纯酱，成品颜色与风味都更干净。",
    "装罐前罐子用开水烫过晾干，能延长保存时间。"
  ],
  "common_mistakes": [
    "淀粉水一次全倒进去，酱里结出一颗颗透明疙瘩。",
    "炒酱时火太大，糖分焦化，甜辣酱带明显苦底。"
  ],
  "substitutions": [
    {
      "original": "辣椒酱",
      "substitute": "剁椒",
      "ratio": "1:1",
      "note": "剁椒含水多，炒制时间延长两分钟收干。"
    }
  ],
  "variations": [
    "闽南版本会加一勺酸梅酱，酸甜更立体，配炸物特别解腻。"
  ],
  "serving_suggestion": "配炸五香、海蛎饼、炸醋肉都合适，也可作为白灼海鲜的第二碟蘸酱。",
  "storage": "密封冷藏可存三周，开封后两周内用完，表面返水可小火回锅收稠。",
