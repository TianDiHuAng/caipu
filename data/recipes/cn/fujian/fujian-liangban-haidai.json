  "steps": [
    {
      "n": 1,
      "text": "干海带用清水浸泡三十分钟，中途换两次水，泡到整片完全舒展柔软。",
      "time_min": 32,
      "heat": "无火",
      "tip": "海带表面的白霜是甘露醇，别用力搓掉，那是鲜味来源。",
      "visual_cue": "海带整片舒展肥厚，水色微绿"
    },
    {
      "n": 2,
      "text": "泡好的海带卷成筒状，切成细丝，再放入清水里漂洗两遍。",
      "time_min": 10,
      "heat": "无火",
      "tip": "卷起来切又快又匀，切太粗口感发韧，细丝才爽口。",
      "visual_cue": "丝条粗细均匀，宽约三毫米"
    },
    {
      "n": 3,
      "text": "汤锅烧开水，下海带丝焯三分钟，捞出立刻放入冰水中浸凉。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯水能去腥去涩，冰水一激口感才爽脆。",
      "visual_cue": "丝条卷曲发亮，捏起来有弹性"
    },
    {
      "n": 4,
      "text": "碗中放蒜末、干辣椒丝与葱末，把植物油烧到微微冒烟泼进去激香。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油一定要烧热再泼，蒜末的香气才完全释放出来。",
      "visual_cue": "蒜末滋滋作响，辣香冲鼻"
    },
    {
      "n": 5,
      "text": "碗里加米醋、生抽、白糖、盐与香油搅匀，尝味调到酸咸略重。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁要调得比平常稍重，拌上带水的海带才刚好。",
      "visual_cue": "调味汁深褐透亮，酸香明显"
    },
    {
      "n": 6,
      "text": "海带丝沥干放入大盆，倒进调味汁与香菜段拌匀，冷藏半小时更入味。",
      "time_min": 30,
      "heat": "无火",
      "tip": "拌好后冷藏一会儿，酸辣味才渗进丝条内部。",
      "visual_cue": "丝条裹满酱汁，油亮不流水"
    }
  ],
  "tips": [
    "买现成的鲜海带丝更省事，但也要焯一遍水去腥。",
    "加一把炒香的白芝麻同拌，香气更足，是闽南的常见吃法。",
    "爱吃辣的可换成小米椒，辣度更冲，配粥很爽。"
  ],
  "common_mistakes": [
    "海带不泡透就下锅，又咸又硬，怎么焯都咬不动。",
    "焯水后不过凉水，余温把海带焖得发软，一点都不脆。",
    "用力搓洗海带表面的白霜，鲜味全被洗掉了。"
  ],
  "substitutions": [
    {
      "original": "干海带",
      "substitute": "鲜海带丝",
      "ratio": "300克:400克",
      "note": "鲜海带不用泡，焯水时间缩短到一分半。"
    },
    {
      "original": "米醋",
      "substitute": "陈醋",
      "ratio": "30毫升:26毫升",
      "note": "陈醋颜色深，白糖可多加两克。"
    }
  ],
  "variations": [
    "加胡萝卜丝与黄瓜丝同拌，颜色更漂亮，口感也更清爽。",
    "换成闽南风味，加一勺沙茶酱同拌，咸香带一点甜。"
  ],
  "serving_suggestion": "冰镇后作为开胃小菜最合适，配粥、配酒、配卤味都很搭。",
  "storage": "密封冷藏可存两天，取食须用干净筷子，久放会出水变淡。",
