  "equipment": [
    "炒锅",
    "锅铲",
    "碗",
    "刀",
    "砧板",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肝整块用清水冲洗，撕掉表面筋膜，泡十分钟换两次水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡去血水，肝才不腥也不发黑。 这一步别图省事。",
      "visual_cue": "泡过的肝片颜色转浅，水不再泛红。"
    },
    {
      "n": 2,
      "text": "猪肝切成一厘米厚的片，用厨房纸吸干表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "带水下锅会溅油，也煎不出焦边。 火候宁小勿大。",
      "visual_cue": "肝片干爽，按压不留水痕。"
    },
    {
      "n": 3,
      "text": "肝片两面薄薄裹一层面粉，抖掉多余的粉。注意不要着急，稳一点更好。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉太厚会糊成壳，薄薄一层就够。 别急着省时间。",
      "visual_cue": "表面呈现均匀的哑光白色。"
    },
    {
      "n": 4,
      "text": "花生油烧到五成热，肝片平铺入锅，中火煎到底面定型。",
      "time_min": 3,
      "heat": "中火",
      "tip": "中途别急着翻，等定型再动才不破。 手快也要稳。",
      "visual_cue": "边缘焦黄，锅里有轻微滋响声。"
    },
    {
      "n": 5,
      "text": "翻面继续煎一分钟，盛出控油，锅内留底油。注意不要着急，稳一点更好。",
      "time_min": 2,
      "heat": "中火",
      "tip": "两面各煎一次就够，久煎会变硬。 顺序别颠倒。",
      "visual_cue": "两面均呈浅褐色，按压有弹性。"
    },
    {
      "n": 6,
      "text": "下姜末、蒜末与葱段爆香，加生抽、白糖、料酒与香醋烧开。",
      "time_min": 2,
      "heat": "中火",
      "tip": "醋最后加，酸味才留得住。 份量要称准。",
      "visual_cue": "锅里酱汁冒泡，香气冲鼻。"
    },
    {
      "n": 7,
      "text": "倒入煎好的猪肝翻匀挂汁，淋香油立刻出锅。注意不要着急，稳一点更好。",
      "time_min": 1,
      "heat": "大火",
      "tip": "挂汁不超过一分钟，肝才嫩滑。 这一步别图省事。",
      "visual_cue": "每片肝都裹上亮汁，盘底不积水。"
    }
  ],
  "tips": [
    "猪肝切片要厚一点，太薄一煎就老，口感发渣。",
    "香醋是南煎肝的灵魂，出锅前沿着锅边淋最提味。",
    "肝片下锅前回温到室温，冷肝下锅容易外老内生。"
  ],
  "common_mistakes": [
    "猪肝泡水时间不足，成品带明显腥气，甜酸也压不住。",
    "大火猛煎太久，肝片收缩发硬，咬着像橡皮。"
  ],
  "substitutions": [
    {
      "original": "猪肝",
      "substitute": "鸡肝",
      "ratio": "450g 对 400g",
      "note": "鸡肝更细腻，煎制时间缩短一半。"
    }
  ],
  "variations": [
    "福州老店会加一小勺红糟同烧，颜色更红，糟香也更足。"
  ],
  "serving_suggestion": "趁热上桌配白米饭，肝片挂汁拌饭是福州人的家常享受。",
  "storage": "冷藏一天内吃完，复热用小火回锅，勿用微波炉以免变硬。",
