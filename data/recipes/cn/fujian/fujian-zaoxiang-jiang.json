  "equipment": [
    "小锅",
    "锅铲",
    "细滤网",
    "密封罐",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "香糟放进细滤网，用温水慢慢淋洗，接住滤出的糟汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水别一次倒太多，糟汁太稀就没了糟香。",
      "visual_cue": "滤出的糟汁呈米白色，闻着有清酒香。"
    },
    {
      "n": 2,
      "text": "姜切细末、小葱切成葱末，分开放好，别混在一起。",
      "time_min": 5,
      "heat": "无火",
      "tip": "姜末务必剁细，煸香的时候才不硌口。",
      "visual_cue": "姜末细碎均匀，葱末翠绿松散。"
    },
    {
      "n": 3,
      "text": "小锅下花生油，放姜末小火煸到边缘微黄出香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "姜末一泛黄就下糟汁，煸久了会有苦味。",
      "visual_cue": "姜末浮在油面，厨房里满是姜香。"
    },
    {
      "n": 4,
      "text": "倒入糟汁与料酒，加生抽、白糖，小火慢熬五分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "熬到酒气散开、酱面微微变稠时就该收火。",
      "visual_cue": "酱汁从稀薄变稠，表面冒细密小孔。"
    },
    {
      "n": 5,
      "text": "撒葱末拌匀，晾到温热装罐，冷藏可存一周左右。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱末最后撒进去，久熬会发黄并失去清香。",
      "visual_cue": "酱面浮一层油，葱末点缀其上。"
    }
  ],
  "tips": [
    "香糟选糯米糟，酒香清亮；红糟颜色深，可另做一款红糟酱。",
    "糟汁滤的时候别用力压，压出来的渣会让酱发涩。",
    "这款酱熬好后可当炒菜的底味，也可直接淋白切肉。"
  ],
  "common_mistakes": [
    "糟汁不过滤直接下锅，酱里全是粗渣，口感发糙。",
    "大火久熬把酒香全赶跑，只剩一股酸糟味。"
  ],
  "substitutions": [
    {
      "original": "香糟",
      "substitute": "酒酿汁",
      "ratio": "180g对200g",
      "note": "酒酿汁更甜，白糖减到八克。"
    }
  ],
  "variations": [
    "福州家庭版会加一小块冰糖同熬，酱汁更亮，收口也更润。"
  ],
  "serving_suggestion": "淋在白切鸡、白灼虾上，或作炒螺片、炒蛏子的调味底酱。",
  "storage": "密封冷藏一周内用完，取用务必用干勺，遇生水容易发酸。",
