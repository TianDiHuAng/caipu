  "steps": [
    {
      "n": 1,
      "text": "蛏子放淡盐水里静养，中途换两次水，让泥沙彻底吐净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水里加一勺粗海盐，蛏子吐沙才够积极。",
      "visual_cue": "盆底沉下细沙，水色变清。"
    },
    {
      "n": 2,
      "text": "烧一锅水，蛏子下锅汆十秒，见壳缝微启立刻捞出取肉。",
      "time_min": 4,
      "heat": "大火",
      "tip": "开口就捞，多煮一秒蛏肉就缩成皮筋。",
      "visual_cue": "壳缝张开，蛏肉边缘微微卷起。"
    },
    {
      "n": 3,
      "text": "香糟用温水调开，滤去粗渣，加白糖与料酒拌成糟汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糟渣一定要滤干净，成菜才不会发涩。",
      "visual_cue": "碗里是米白色细滑糟汁，无颗粒。"
    },
    {
      "n": 4,
      "text": "炒锅烧热下花生油，放姜末用小火慢慢煸出香味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "姜末别煸糊，一旦糊了整道菜都发苦。",
      "visual_cue": "姜末浮在油面，边缘微微泛黄。"
    },
    {
      "n": 5,
      "text": "倒入蛏肉大火快炒十秒，随即淋入糟汁快速翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火短炒，糟汁遇热才能逼出酒香。",
      "visual_cue": "蛏肉裹上米白糟汁，锅气直冲。"
    },
    {
      "n": 6,
      "text": "用玉米淀粉加水勾薄芡，撒小葱段与盐，翻两下出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "芡要薄，挂一圈就够，勾厚了满口糊嘴。",
      "visual_cue": "汤汁收紧挂在蛏肉上，葱段翠绿。"
    }
  ],
  "tips": [
    "蛏子选壳面发亮、碰一下会缩的活体，壳口常开的不要。",
    "糟汁分两次淋，一半炒香一半起锅前提味。",
    "铁锅炒贝类容易发黑，换不粘锅更稳妥。"
  ],
  "common_mistakes": [
    "蛏子汆水时间过长，肉缩成一小粒，嚼起来像橡皮。",
    "糟汁提前倒进锅久炒，酒香全挥发，只剩一股酸味。"
  ],
  "substitutions": [
    {
      "original": "香糟",
      "substitute": "红糟",
      "ratio": "1:1",
      "note": "红糟色泽更艳，成菜偏红，酒香更重。"
    }
  ],
  "variations": [
    "闽东版本会加一把韭黄同炒，辛香解腻，颜色也更好看。"
  ],
  "serving_suggestion": "趁热上桌，糟香最浓时下筷，配白粥或干饭都合适。",
  "storage": "建议现做现吃，冷藏后蛏肉会出水发硬，最多存一日。",
