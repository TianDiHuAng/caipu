  "steps": [
    {
      "n": 1,
      "text": "普宁豆酱用勺背在碗里压成细泥，挑掉粗大的豆瓣颗粒。",
      "time_min": 7,
      "heat": "无火",
      "tip": "压得细一点，酱汁的口感才顺滑不硌牙。",
      "visual_cue": "豆酱成细腻泥状，颜色褐亮。"
    },
    {
      "n": 2,
      "text": "大蒜切末，小葱切葱花，红辣椒去蒂切薄圈备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "配料切得小一些，炒的时候香气释放更快。",
      "visual_cue": "蒜末细小均匀，辣椒圈薄而完整。"
    },
    {
      "n": 3,
      "text": "小锅下花生油，放蒜末与辣椒圈小火煸出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末一泛金黄就下豆酱，久煸会发苦。",
      "visual_cue": "蒜末浮起，油面泛起细密气泡。"
    },
    {
      "n": 4,
      "text": "倒入豆酱泥小火慢炒，加白糖与生抽翻匀调味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆酱本身已经很咸，白糖主要用来压咸提鲜。",
      "visual_cue": "酱体由干散转为油润，颜色加深。"
    },
    {
      "n": 5,
      "text": "撒葱花拌匀，晾到温热装罐，冷藏可存约两周。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花最后放进去，久炒会发黄并失去香气。",
      "visual_cue": "酱面油亮，葱花点缀其间。"
    }
  ],
  "tips": [
    "普宁豆酱咸度极高，炒之前先尝一口再决定糖量。",
    "这款酱炒空心菜、炒豆角也好吃，一勺就能提味。",
    "装罐后表面淋一层油封住，能延缓氧化变味。"
  ],
  "common_mistakes": [
    "豆酱不压细直接下锅，酱里全是硬豆瓣，蘸食硌牙。",
    "忘了加糖，酱汁过咸发死，只能靠加量稀释救场。"
  ],
  "substitutions": [
    {
      "original": "普宁豆酱",
      "substitute": "黄豆酱",
      "ratio": "1:1",
      "note": "黄豆酱更甜更稀，白糖减到八克。"
    }
  ],
  "variations": [
    "潮汕与闽南交界一带会加一勺沙茶酱同炒，鲜味更浓，带一点南洋风味。"
  ],
  "serving_suggestion": "配白粥、拌面、蘸白灼蔬菜都合适，也常作炒空心菜的调味酱。",
  "storage": "密封冷藏两周内用完，取用用干勺，表面油封可延缓变味。",
