  "equipment": [
    "汤锅",
    "汤勺",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "海蛎放淡盐水里轻轻打散，洗去碎壳，捞出沥干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洗海蛎动作要轻，破肚就带腥味。",
      "visual_cue": "海蛎饱满完整、不见碎壳"
    },
    {
      "n": 2,
      "text": "北豆腐切成两厘米见方的块，放淡盐水里泡五分钟去豆腥。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐泡盐水，煮时不易碎。",
      "visual_cue": "豆腐块棱角完整、手感略紧"
    },
    {
      "n": 3,
      "text": "汤锅下植物油，放姜丝小火煸香，加清水大火烧开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "姜丝煸过再煮，汤不腥还更鲜。",
      "visual_cue": "汤面翻滚、姜香浮起"
    },
    {
      "n": 4,
      "text": "放入豆腐块，转中火煮四分钟，让豆腐吸足汤味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "豆腐先煮透，后面下海蛎才不碎。",
      "visual_cue": "豆腐浮起、表面出现小孔"
    },
    {
      "n": 5,
      "text": "下海蛎与料酒，煮一分钟至海蛎边缘卷起，加盐与白胡椒调味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "海蛎一熟就关火，煮久缩水发硬。",
      "visual_cue": "海蛎边缘卷曲、汤色转奶白"
    },
    {
      "n": 6,
      "text": "撒上葱花，盛入碗中趁热喝，海蛎的鲜味最足。",
      "time_min": 1,
      "heat": "无火",
      "tip": "葱花最后撒，香气才清新。",
      "visual_cue": "汤清而白、葱绿浮面"
    }
  ],
  "tips": [
    "海蛎要买当天开的，闻起来带海水味最好。",
    "白胡椒多放一点，去腥效果比料酒明显。",
    "用北豆腐更耐煮，嫩豆腐容易碎在汤里。"
  ],
  "common_mistakes": [
    "海蛎洗得太用力，蛎肉破口汤就发腥。",
    "海蛎下锅后长时间滚煮，缩成小丁还发柴。",
    "豆腐切得太小，煮一会儿就散在汤里。"
  ],
  "substitutions": [
    {
      "original": "海蛎",
      "substitute": "花蛤",
      "ratio": "200g 对 300g",
      "note": "需提前吐沙，煮制时间加两分钟。"
    },
    {
      "original": "北豆腐",
      "substitute": "嫩豆腐",
      "ratio": "300g 对 300g",
      "note": "口感更滑，切大块且少搅动。"
    }
  ],
  "variations": [
    "加一把小青菜同煮，汤头更清爽解腻。",
    "把清水换成骨头汤，汤底更厚实甜润。"
  ],
  "serving_suggestion": "趁热配米饭或直接当汤喝，撒白胡椒更香。",
  "storage": "当天喝完最佳，海产汤隔夜腥味会加重。",
