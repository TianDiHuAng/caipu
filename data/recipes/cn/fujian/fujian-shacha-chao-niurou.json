  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆着纹理切成一毫米左右的薄片，装碗备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切断筋络，炒出来才不塞牙。 这一步别图省事。",
      "visual_cue": "肉片薄而透光，纹理被横断。"
    },
    {
      "n": 2,
      "text": "肉片加生抽、白糖与玉米淀粉抓匀，再淋一勺花生油封住。",
      "time_min": 5,
      "heat": "无火",
      "tip": "封油能让肉片下锅不粘连，也更嫩。 火候宁小勿大。",
      "visual_cue": "每片肉都裹上薄浆，手感发滑。"
    },
    {
      "n": 3,
      "text": "大蒜与姜切末，蒜苗斜切段，红辣椒切圈分别放好。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜苗白与绿分开，白段先下锅爆香。 别急着省时间。",
      "visual_cue": "配料切好，颜色分明地排在盘中。"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒烟下花生油，油热后倒入肉片快速滑散。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅一定要够热，温锅下肉就会出水。 手快也要稳。",
      "visual_cue": "肉片迅速变白，边缘微微卷起。"
    },
    {
      "n": 5,
      "text": "肉片七成熟即盛出，锅里留底油下姜末蒜末与红辣椒爆香。",
      "time_min": 1,
      "heat": "中火",
      "tip": "肉先盛出，回锅时才不会老。 顺序别颠倒。",
      "visual_cue": "锅中油色泛红，蒜末浮起。"
    },
    {
      "n": 6,
      "text": "加入沙茶酱小火炒出红油，再倒回肉片与蒜苗段大火翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "沙茶酱易糊，炒的时候火不能太大。 份量要称准。",
      "visual_cue": "酱色红亮，裹住每片肉。"
    }
  ],
  "tips": [
    "沙茶酱本身含花生与虾干，咸鲜很足，生抽要少放。",
    "牛肉冷冻二十分钟再切，能切得更薄更匀。",
    "全程不超过三分钟，牛肉嫩不嫩全看这一口气。"
  ],
  "common_mistakes": [
    "肉片顺纹切，炒完又老又硬，嚼得腮帮子疼。",
    "沙茶酱大火干炒，锅底结一层黑糊，整盘发苦。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "猪里脊",
      "ratio": "1:1",
      "note": "猪肉更嫩，滑炒时间缩短到半分钟。"
    }
  ],
  "variations": [
    "厦门街头版本会加一把芥蓝同炒，脆嫩解腻，也更有家常味。"
  ],
  "serving_suggestion": "趁热盖在米饭或沙茶面上，酱汁拌饭格外香。，趁热吃最香。",
  "storage": "冷藏一天内吃完，复热用大火快炒十秒，不要久煮。",
