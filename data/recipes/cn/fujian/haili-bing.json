  ],
  "equipment": [
    "圆型铁模",
    "油锅",
    "大碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米粉与黄豆粉混匀，分次加 260ml 清水搅成能缓慢流动的稀糊，静置 20 分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "糊要稀一点，太稠炸出来发硬。",
      "visual_cue": "粉糊顺滑无颗粒、能挂勺"
    },
    {
      "n": 2,
      "text": "海蛎洗净沥干，加 2g 盐与白胡椒粉轻轻拌匀，不要用力抓。",
      "time_min": 4,
      "heat": "无火",
      "tip": "海蛎轻拌就行，抓破会流失鲜汁。",
      "visual_cue": "海蛎颗颗饱满、无碎壳"
    },
    {
      "n": 3,
      "text": "五花肉丁下锅小火煸出油，与包菜丝、葱花和剩余 4g 盐拌成馅料。",
      "time_min": 6,
      "heat": "小火",
      "tip": "肉丁煸出油，饼里才够香。",
      "visual_cue": "肉丁微焦、包菜丝变软"
    },
    {
      "n": 4,
      "text": "铁模里先舀一勺粉糊垫底，铺一层馅料与几颗海蛎，再盖一勺粉糊封口。",
      "time_min": 6,
      "heat": "无火",
      "tip": "封口的糊要盖满，炸时才不漏馅。",
      "visual_cue": "模具内馅料居中、表面平整"
    },
    {
      "n": 5,
      "text": "油锅倒入 270ml 植物油烧至六成热，连模下锅炸 3 分钟定型后脱模，翻面再炸 4 分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温六成热，下锅能立刻冒小泡。",
      "visual_cue": "饼身鼓起、两面金黄"
    },
    {
      "n": 6,
      "text": "捞出沥油，放在厨房纸上吸去表面浮油，趁热食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "沥油一分钟，吃起来才不腻。",
      "visual_cue": "表面酥脆、油光收敛"
    }
  ],
  "tips": [
    "粉糊要静置 20 分钟，粉粒吸饱水才不硬。",
    "海蛎轻拌不抓，鲜汁留住了才够味。",
    "油温六成热下锅，太低会吸油发软。"
  ],
  "common_mistakes": [
    "粉糊调得太稠，炸出来的饼硬得咬不动。",
    "海蛎用力抓洗，鲜味全跑到水里。",
    "油温不够就下锅，饼吸满油发腻。"
  ],
  "substitutions": [
    {
      "original": "海蛎",
      "substitute": "鲜虾仁",
      "ratio": "250g 对 250g",
      "note": "切小段再包，炸制时间不变。"
    },
    {
      "original": "五花肉",
      "substitute": "培根",
      "ratio": "80g 对 70g",
      "note": "咸味更重，盐减 1g。"
    }
  ],
  "variations": [
    "加紫菜版：馅料里拌 5g 紫菜碎，海味更足。",
    "素版：去掉五花肉与海蛎，改用香菇丁。"
  ],
  "serving_suggestion": "刚出锅时对半剪开，配甜辣酱或蒜蓉酱。",
  "storage": "冷藏 1 天，复热用烤箱 180 度烤 6 分钟恢复酥脆。",
