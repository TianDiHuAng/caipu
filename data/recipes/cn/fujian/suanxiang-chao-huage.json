  "steps": [
    {
      "n": 1,
      "text": "花蛤 750g 放入淡盐水中静置 30 分钟吐沙，中途换两次水，再用清水搓洗外壳。",
      "time_min": 35,
      "heat": "无火",
      "tip": "水里滴几滴油，吐沙更快。",
      "visual_cue": "盆底沉沙、蛤壳表面干净"
    },
    {
      "n": 2,
      "text": "锅中烧开水，下花蛤焯 40 秒，壳一开口立即捞出沥干，没开口的挑出丢掉。",
      "time_min": 6,
      "heat": "大火",
      "tip": "开口就捞，久煮肉会缩成硬粒。",
      "visual_cue": "蛤壳张开、蛤肉饱满"
    },
    {
      "n": 3,
      "text": "炒锅倒 25ml 植物油烧热，下蒜末与姜丝小火炒到香味出来、蒜末微黄。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末小火炒，火大立刻发苦。",
      "visual_cue": "蒜末金黄、香味明显"
    },
    {
      "n": 4,
      "text": "转大火放入花蛤与青椒丝翻炒 30 秒，沿锅边淋 15ml 料酒与 15ml 生抽。",
      "time_min": 3,
      "heat": "大火",
      "tip": "沿锅边淋酒，香气才起得来。",
      "visual_cue": "蛤壳均匀裹上酱色"
    },
    {
      "n": 5,
      "text": "加 3g 白糖与 2g 盐翻匀，撒小葱段，颠锅两下立刻出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程快炒，蛤肉才嫩。",
      "visual_cue": "汤汁微收、葱段翠绿"
    }
  ],
  "tips": [
    "花蛤一定先吐沙，否则吃起来满口沙。",
    "焯水时间只到开口，多一秒肉就老。",
    "蒜末全程用小火炒香，大火会立刻爆糊发苦。"
  ],
  "common_mistakes": [
    "花蛤没有吐沙就直接下锅，吃起来满口牙碜。",
    "焯水时间拖得太久，蛤肉缩水变得又硬又小。",
    "盐放多又加生抽，咸得盖住鲜味。"
  ],
  "substitutions": [
    {
      "original": "花蛤",
      "substitute": "蛤蜊",
      "ratio": "750g 对 750g",
      "note": "个头小，焯水缩到 30 秒。"
    },
    {
      "original": "青椒",
      "substitute": "红椒",
      "ratio": "50g 对 50g",
      "note": "颜色更亮，辣度更低。"
    }
  ],
  "variations": [
    "辣炒版：加 10g 干辣椒段同炒。",
    "福建酒香版：改用 20ml 福建老酒。"
  ],
  "serving_suggestion": "连汤汁一起装盘，配一碗白粥或米线。",
  "storage": "现炒现吃，冷藏后再热蛤肉会变硬。",
