  "equipment": [
    "炒锅",
    "锅铲",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "粘米粉加三百毫升清水调成稀米浆，静置二十分钟让粉粒吸足水。",
      "time_min": 22,
      "heat": "无火",
      "tip": "米浆调到能挂住勺背的稀度正好。",
      "visual_cue": "米浆顺滑、无结块"
    },
    {
      "n": 2,
      "text": "五花肉丝下锅用十毫升植物油煸出油，加姜末与香菇丝炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "五花肉煸出油，汤头才够香。",
      "visual_cue": "肉丝微焦、香菇出香"
    },
    {
      "n": 3,
      "text": "倒入九百毫升清水烧开，加盐与生抽调味，保持微沸状态。",
      "time_min": 6,
      "heat": "中火",
      "tip": "汤保持微沸，米浆才挂得住锅边。",
      "visual_cue": "汤面小泡翻滚、香气上浮"
    },
    {
      "n": 4,
      "text": "沿锅边淋一圈米浆，加盖焖三十秒至米浆凝结成片。",
      "time_min": 1,
      "heat": "中火",
      "tip": "锅边要热透，米浆才不滑落。",
      "visual_cue": "锅边米浆凝固起边"
    },
    {
      "n": 5,
      "text": "用铲把米浆片铲入汤中，重复淋浆三次，最后下海蛎煮一分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "海蛎最后放，久煮缩水发硬。",
      "visual_cue": "米浆片卷曲、海蛎饱满"
    },
    {
      "n": 6,
      "text": "淋入二十毫升植物油搅匀，盛碗趁热食用，汤面油亮。",
      "time_min": 1,
      "heat": "小火",
      "tip": "起锅淋油，汤面油亮不寡。",
      "visual_cue": "汤色微稠、浆片薄而完整"
    }
  ],
  "tips": [
    "米浆要现调现用，放久了会沉底分层。",
    "锅边一定要烧到烫手，浆片才挂得住。",
    "洗海蛎时动作轻一点，破肚就带腥味。"
  ],
  "common_mistakes": [
    "米浆调得太稠，铲下来结成硬块。",
    "锅边温度不够，米浆顺着锅壁滑进汤里。",
    "海蛎下锅煮太久，缩成一小团还发柴。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "咸肉",
      "ratio": "80g 对 70g",
      "note": "自带咸味，盐要减两克。"
    }
  ],
  "variations": [
    "淋浆时锅要一直保持微沸，浆片才薄而完整。",
    "把汤底换成骨汤同法制作，鲜味更厚实。"
  ],
  "serving_suggestion": "盛碗后撒少许白胡椒提味，趁热喝最鲜。",
  "storage": "当天吃完，米浆制品隔夜容易发酸。",
