  "steps": [
    {
      "n": 1,
      "text": "大白菜掰开叶片，冲洗干净后切成五厘米长的段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "菜帮与菜叶分开切，熟度才一致。 火候宁小勿大。",
      "visual_cue": "菜段翠白分明，沥水后不滴水。"
    },
    {
      "n": 2,
      "text": "北豆腐切厚片，用厨房纸吸干表面水分。注意火候，不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "吸干水再煎，豆腐才不粘锅。 次序不能颠倒。",
      "visual_cue": "豆腐片挺括，纸上水痕明显。"
    },
    {
      "n": 3,
      "text": "平底锅下花生油，豆腐片中火煎到两面浅黄盛出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎过的豆腐耐焖，吸汁后依然完整。 手上动作要稳。",
      "visual_cue": "两面均匀浅黄，边缘略脆。"
    },
    {
      "n": 4,
      "text": "炒锅留底油，下蒜片与虾米小火炒出香味。注意火候，不要着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "虾米一炒就香，但很容易焦。 量要称准。",
      "visual_cue": "虾米转金黄，蒜片边缘起泡。"
    },
    {
      "n": 5,
      "text": "先下白菜帮炒两分钟，再下菜叶炒到微微塌软。",
      "time_min": 3,
      "heat": "中火",
      "tip": "帮子难熟先下，叶子后放才不会烂。 水汽要控住。",
      "visual_cue": "菜帮透明，叶片刚软。"
    },
    {
      "n": 6,
      "text": "放回豆腐片，加生抽、盐与白糖，加半碗清水烧开。",
      "time_min": 3,
      "heat": "中火",
      "tip": "水别多，白菜本身会出水。 时间别硬压。",
      "visual_cue": "汤汁刚好没过食材的一半高度。"
    },
    {
      "n": 7,
      "text": "转小火焖十分钟，汤汁收浓撒葱段出锅。注意火候，不要着急。",
      "time_min": 10,
      "heat": "小火",
      "tip": "焖的时候不要翻，晃锅让汤汁流动。 这一步别图快。",
      "visual_cue": "豆腐饱胀，汤汁剩小半碗。"
    }
  ],
  "tips": [
    "大白菜选叶片紧实、帮子薄的，焖出来的汤汁更鲜甜。",
    "虾米是这道菜的鲜味来源，没有的话可以换一小勺蚝油。",
    "豆腐先煎后焖，能保持形状又吸足菜汁。"
  ],
  "common_mistakes": [
    "一锅全下不按顺序，菜叶烂成泥菜帮还夹生。",
    "汤汁加太多，最后成了寡淡的白菜豆腐汤。"
  ],
  "substitutions": [
    {
      "original": "大白菜",
      "substitute": "天津青麻叶",
      "ratio": "400g 对 450g",
      "note": "青麻叶帮厚，需要多炒两分钟再焖。"
    }
  ],
  "variations": [
    "闽南人家会加一把粉丝同焖，吸饱汤汁的粉丝比豆腐还抢手。"
  ],
  "serving_suggestion": "连汁盛出，配米饭或馒头都合适，冬天吃最熨帖。",
  "storage": "冷藏两天，复热小火回焖，别用大火把豆腐煮散。",
