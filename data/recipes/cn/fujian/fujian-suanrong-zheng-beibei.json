  "steps": [
    {
      "n": 1,
      "text": "扇贝用硬刷刷净外壳，用刀沿壳缝撬开，取出贝肉去掉黑色内脏后洗净。",
      "time_min": 10,
      "heat": "无火",
      "tip": "内脏和腮要去净，留着会带泥腥。",
      "visual_cue": "贝壳洁白，贝肉完整。"
    },
    {
      "n": 2,
      "text": "粉丝用清水泡到能弯折，捞出剪成两段，垫在每只贝壳底部。",
      "time_min": 6,
      "heat": "无火",
      "tip": "粉丝别泡烂，蒸的时候还要吸汁。",
      "visual_cue": "粉丝柔软有弹性。"
    },
    {
      "n": 3,
      "text": "蒜剁成末分两份，一半用花生油小火炸到金黄，与生蒜末、生抽、盐、白糖拌成蒜蓉酱。",
      "time_min": 7,
      "heat": "小火",
      "tip": "半生半熟蒜才香，全炸焦了发苦。",
      "visual_cue": "蒜蓉酱金黄带白，香气冲鼻。"
    },
    {
      "n": 4,
      "text": "贝肉放回壳里，铺上一勺蒜蓉酱，再淋小半勺泡过粉丝的清水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "淋一点清水，粉丝蒸出来才不干硬。",
      "visual_cue": "蒜蓉盖住贝肉，壳内有汁。"
    },
    {
      "n": 5,
      "text": "水开后上锅，大火蒸五分钟，取出撒葱花与小米辣圈。",
      "time_min": 5,
      "heat": "大火",
      "tip": "五分钟足够，蒸久了贝肉缩成橡皮。",
      "visual_cue": "贝肉鼓起，汤汁在壳里打转。"
    },
    {
      "n": 6,
      "text": "花生油烧到微微冒烟，趁热泼在葱花上激出香气，立刻上桌。",
      "time_min": 4,
      "heat": "大火",
      "tip": "泼油要听到响，油不够热激不出葱蒜的香。",
      "visual_cue": "葱花滋滋作响，油香盖过蒜香。"
    }
  ],
  "tips": [
    "扇贝要挑活的，壳闭得紧、敲一下会动的才新鲜。",
    "蒜蓉一半生一半炸，是闽南蒸海鲜的通用做法，香而不苦。",
    "垫底的粉丝吸饱蒜油与贝汁，往往比贝肉更抢手。"
  ],
  "common_mistakes": [
    "蒜蓉全用生蒜，蒸出来辛辣冲鼻。",
    "蒸的时间超过八分钟，贝肉又老又硬。"
  ],
  "substitutions": [
    {
      "original": "扇贝",
      "substitute": "生蚝",
      "ratio": "600g 对 600g",
      "note": "生蚝蒸四分钟即可，时间要缩短。"
    }
  ],
  "variations": [
    "厦门大排档会在蒜蓉里加一勺沙茶酱，蒸出来咸香带微辣，配冰啤酒最对味。"
  ],
  "serving_suggestion": "连壳上桌，一人两只，配粉丝一起吃，汁水别浪费。",
  "storage": "现蒸现吃，冷藏不超过一天，复蒸会变老。",
