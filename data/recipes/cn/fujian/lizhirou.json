  "equipment": [
    "炒锅",
    "漏勺",
    "松肉锤",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切 2cm 厚片，两面剞十字花刀，深度到肉厚三分之二，切成 3cm 方块。",
      "time_min": 15,
      "heat": "无火",
      "tip": "花刀剞到位，炸后才卷成荔枝状。",
      "visual_cue": "肉块展开如花、纹路整齐"
    },
    {
      "n": 2,
      "text": "肉块加盐与料酒抓匀腌 10 分钟，再逐块拍满淀粉，抖去浮粉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "淀粉要拍到刀缝里，炸后才膨松。",
      "visual_cue": "肉块干爽、缝隙填满淀粉"
    },
    {
      "n": 3,
      "text": "炒锅倒 260ml 植物油烧至六成热，下肉块中火炸 3 分钟定型捞出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油温六成下锅，低了会脱粉。",
      "visual_cue": "肉块卷曲成球、表面浅金黄"
    },
    {
      "n": 4,
      "text": "油温升到八成，复炸 40 秒至外壳金黄酥脆，捞出沥油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "复炸一次，外壳才响脆。",
      "visual_cue": "外壳深金、敲起来有声"
    },
    {
      "n": 5,
      "text": "锅留 15ml 底油，下蒜末与荸荠块炒 1 分钟，加番茄酱、白糖、香醋与 50ml 水熬成黏汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "糖醋汁熬到起大泡才够稠。",
      "visual_cue": "酱汁红亮、勺背挂浆"
    },
    {
      "n": 6,
      "text": "倒入炸好的肉块与葱段，快速翻匀让每块裹上酱汁，立即出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "裹汁不超过 30 秒，久翻就软。",
      "visual_cue": "肉块红亮、盘底不见汤汁"
    }
  ],
  "tips": [
    "十字花刀深度要够，才能炸出荔枝纹。",
    "复炸是外壳酥脆的关键，不能省。",
    "糖醋汁熬到起泡再下肉，裹得才匀。"
  ],
  "common_mistakes": [
    "花刀太浅，炸完还是肉片状。，成品口感会明显变差。",
    "直接在淀粉糊里滚，炸后外壳厚重发硬。",
    "肉块在锅里久翻，外壳吸水变软。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡腿肉",
      "ratio": "400g 对 400g",
      "note": "更嫩，炸的时间减 30 秒。"
    },
    {
      "original": "荸荠",
      "substitute": "菠萝块",
      "ratio": "100g 对 120g",
      "note": "果酸更足，白糖加 5g。"
    }
  ],
  "variations": [
    "荔枝版：盛盘时配 6 颗鲜荔枝，卖相呼应菜名。",
    "咕咾版：加青红椒块，做成咕咾肉风味。"
  ],
  "serving_suggestion": "趁热吃外壳最脆，配甜辣酱或直接上桌。",
  "storage": "冷藏 1 天，复热用 180 度烤箱烤 6 分钟恢复脆度。",
