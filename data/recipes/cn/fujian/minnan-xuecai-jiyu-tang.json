  "steps": [
    {
      "n": 1,
      "text": "鲫鱼去鳞去内脏，刮净腹内黑膜，鱼身两面各打两刀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腹内黑膜不去净，汤会发腥甚至发苦。",
      "visual_cue": "鱼身干爽，刀口整齐"
    },
    {
      "n": 2,
      "text": "鱼身抹薄盐和黄酒，塞入姜片腌十分钟，再用厨房纸吸干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "下锅前必须擦干，否则溅油破皮。",
      "visual_cue": "鱼皮干爽，表面不见水光"
    },
    {
      "n": 3,
      "text": "雪菜用清水泡五分钟挤干切碎，去掉多余咸味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "雪菜先泡五分钟，汤才不会过咸发齁。",
      "visual_cue": "雪菜碎干爽，咸味变柔和"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，鲫鱼下锅中火煎到两面微黄定型。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鱼皮结壳了再翻面，鱼身才能保持完整。",
      "visual_cue": "鱼皮金黄完整，晃动会滑锅"
    },
    {
      "n": 5,
      "text": "冲入开水没过鱼身，大火滚煮到汤色转成奶白。",
      "time_min": 8,
      "heat": "大火",
      "tip": "一定用开水，冷水冲汤色发白不透。",
      "visual_cue": "汤色乳白，浮着一层油花"
    },
    {
      "n": 6,
      "text": "转成小火后放雪菜同煮，让咸鲜味慢慢融进汤里。",
      "time_min": 8,
      "heat": "小火",
      "tip": "雪菜后放，久煮会发酸也失去脆感。",
      "visual_cue": "雪菜浮在汤面，汤色微黄"
    },
    {
      "n": 7,
      "text": "加盐和白胡椒粉调味，撒上葱段关火盛入汤碗。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先尝再放盐，雪菜本身已经带咸味。",
      "visual_cue": "汤色奶白带黄，葱段翠绿"
    }
  ],
  "tips": [
    "冲汤要用开水，汤色才奶白浓香。",
    "雪菜先泡过再下锅，汤的咸度才刚好。",
    "雪菜要先泡过再下锅，免得整锅汤过咸。"
  ],
  "common_mistakes": [
    "用冷水冲汤，煮出来汤色灰白发浑。",
    "鱼不擦干就下锅，油花四溅还破皮。",
    "雪菜煮太久，汤发酸雪菜也烂了。"
  ],
  "substitutions": [
    {
      "original": "雪菜",
      "substitute": "芥菜",
      "ratio": "120 克:150 克",
      "note": "需补三克盐，鲜味略淡。"
    },
    {
      "original": "鲫鱼",
      "substitute": "小黄鱼",
      "ratio": "600 克:600 克",
      "note": "刺更细，煮制时间缩短三分钟。"
    }
  ],
  "variations": [
    "加几块嫩豆腐同煮，汤更浓也更饱腹。",
    "放两只煎蛋一起滚，汤色更快转白。"
  ],
  "serving_suggestion": "趁热喝汤吃肉，配米饭或面线都好。",
  "storage": "冷藏一天，复热小火加热至滚，鱼汤不宜反复加热。",
