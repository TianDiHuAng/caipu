  "equipment": [
    "平底锅",
    "厨房纸",
    "刀",
    "砧板",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "带鱼段剪去鳍边，刮掉腹腔黑膜，用清水冲洗干净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鳍边和腹腔黑膜最腥，必须处理得干干净净。",
      "visual_cue": "鱼段边缘整齐，腹腔洁白无黑痕。"
    },
    {
      "n": 2,
      "text": "带鱼段加盐、料酒与姜丝抓匀，腌十五分钟入味。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌够时间鱼肉才紧实，下锅煎时不容易散。",
      "visual_cue": "鱼段表面微出水，姜丝贴附其上。"
    },
    {
      "n": 3,
      "text": "用厨房纸吸干表面水分，两面薄薄拍一层玉米淀粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水分不吸干就下锅，必定爆油，还会溅到手。",
      "visual_cue": "鱼段表面干爽，粉层薄而均匀。"
    },
    {
      "n": 4,
      "text": "平底锅烧热下花生油，油温六成热时逐段放入带鱼。",
      "time_min": 3,
      "heat": "中火",
      "tip": "筷子插进油里冒出小泡，说明油温刚好够了。",
      "visual_cue": "油面无大烟，鱼段下锅立刻起细泡。"
    },
    {
      "n": 5,
      "text": "转中小火煎到贴锅一面金黄定型，再翻面煎另一面。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "别急着翻面，煎定型的鱼皮才不会破。",
      "visual_cue": "底面结出金黄脆壳，边缘微微卷起。"
    },
    {
      "n": 6,
      "text": "两面金黄后撒白胡椒与小葱段，出锅放在厨房纸上沥油。",
      "time_min": 2,
      "heat": "小火",
      "tip": "葱段最后才放，煎久了会发焦，味道发苦。",
      "visual_cue": "鱼段两面同色，纸上有明显油印。"
    }
  ],
  "tips": [
    "带鱼选眼睛清亮、银膜完整的，银膜别刮掉，那是鲜味来源。",
    "煎之前锅要烧透再下油，鱼皮才不粘。",
    "一次别下太多，锅面留空隙才煎得脆。"
  ],
  "common_mistakes": [
    "鱼段没吸干水就下锅，油花四溅，鱼皮也粘锅撕破。",
    "用大火猛煎，外面焦了里面还生，腥味没走掉。"
  ],
  "substitutions": [
    {
      "original": "带鱼",
      "substitute": "鲳鱼",
      "ratio": "1:1",
      "note": "鲳鱼更厚，煎制时间每面多两分钟。"
    }
  ],
  "variations": [
    "闽南人喜欢煎好后淋一勺香醋，酸香解腻，冷吃也有味。"
  ],
  "serving_suggestion": "出锅即吃最脆，配稀饭或下酒都好，凉了可回锅小火复煎。",
  "storage": "冷藏两日，复热用平底锅干煎，别用蒸锅回软。",
