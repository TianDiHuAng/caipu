  "equipment": [
    "砂锅",
    "炒锅",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸭肉剁成三厘米见方的块，冷水下锅煮开焯去血沫，捞出用温水冲洗干净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅血沫才逼得干净。",
      "visual_cue": "水面浮起褐色沫、鸭块收紧"
    },
    {
      "n": 2,
      "text": "老姜刷洗干净带皮切成半厘米厚的片，大蒜整瓣去皮备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "姜皮留着不上火，别削掉。",
      "visual_cue": "姜片厚薄均匀、边缘完整"
    },
    {
      "n": 3,
      "text": "砂锅倒入芝麻油，小火下姜片慢煸到边缘卷起发干、姜香浓烈。",
      "time_min": 8,
      "heat": "小火",
      "tip": "姜要煸透，整锅的香底全靠它。",
      "visual_cue": "姜片边缘金黄卷曲"
    },
    {
      "n": 4,
      "text": "下大蒜与鸭块转中火翻炒，把鸭皮下的油逼出来，表面炒到微黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸭皮朝下先煎，腥味跟着油走。",
      "visual_cue": "鸭块表面金黄、锅底见油"
    },
    {
      "n": 5,
      "text": "沿锅边淋入黄酒，加生抽、老抽、冰糖与清水，盖盖小火焖四十分钟。",
      "time_min": 40,
      "heat": "小火",
      "tip": "全程小火，汤面只冒小泡。",
      "visual_cue": "汤汁咕嘟、鸭肉可用筷子插入"
    },
    {
      "n": 6,
      "text": "开盖转大火收汁，汤汁浓稠挂勺后补盐调味，连砂锅端上桌。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁时勤翻动，防止姜片粘底。",
      "visual_cue": "汤汁油亮、鸭块裹满酱色"
    }
  ],
  "tips": [
    "姜母鸭讲究姜多酒足，老姜至少要一百克。",
    "用砂锅焖比铁锅受热均匀，鸭肉更酥。",
    "吃完鸭肉剩下的汤汁拌面线，是闽南人的吃法。"
  ],
  "common_mistakes": [
    "芝麻油烧到冒烟才下姜，整锅发苦。",
    "姜片切得太薄，下锅煸两下就焦黑发苦，整锅香气全毁。",
    "焖到一半加冷水，鸭肉遇冷骤缩，肉质发柴汤也变腥。"
  ],
  "substitutions": [
    {
      "original": "鸭肉",
      "substitute": "鸡腿",
      "ratio": "600g 对 600g",
      "note": "鸡肉易熟，焖制时间缩短到二十五分钟。"
    },
    {
      "original": "黄酒",
      "substitute": "米酒",
      "ratio": "100ml 对 100ml",
      "note": "米酒更甜，冰糖减到五克。"
    }
  ],
  "variations": [
    "加一把当归与枸杞同焖，药膳风味更浓。",
    "收汁后转干锅小火慢焙，做成干香版。"
  ],
  "serving_suggestion": "砂锅直接上桌，配一碗面线或白饭，汤汁别浪费。",
  "storage": "冷藏两天，复热时加两勺黄酒小火煨透。",
