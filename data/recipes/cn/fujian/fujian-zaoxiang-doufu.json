  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成三厘米方块，用淡盐水浸五分钟去掉豆腥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐水泡过豆腐更紧实，也去豆味。 手上动作要稳。",
      "visual_cue": "豆腐块完整，水微浑。"
    },
    {
      "n": 2,
      "text": "香糟加料酒与白糖调开，用手指捏散成细腻的糟泥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糟块要捏散，下锅才不会结坨。 量要称准。",
      "visual_cue": "糟泥细腻，呈均匀的暗红色。"
    },
    {
      "n": 3,
      "text": "炒锅下花生油烧热，放豆腐块中火煎到两面微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎过的豆腐更耐烧，吸糟汁也不易碎。",
      "visual_cue": "豆腐表面起薄壳，颜色金黄。"
    },
    {
      "n": 4,
      "text": "把豆腐拨到锅边，下姜末与糟泥小火炒出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糟怕大火，一焦就发苦。 水汽要控住。",
      "visual_cue": "锅里泛红，酒糟香直冒。"
    },
    {
      "n": 5,
      "text": "倒入高汤与生抽，轻轻推匀，让糟汁裹上豆腐。",
      "time_min": 2,
      "heat": "中火",
      "tip": "用推的方式拌，别翻炒。 时间别硬压。",
      "visual_cue": "汤汁呈红褐色，豆腐染上糟色。"
    },
    {
      "n": 6,
      "text": "小火烧八分钟，中途晃锅两次，让豆腐均匀入味。",
      "time_min": 8,
      "heat": "小火",
      "tip": "糟汁易糊底，晃锅比铲子更安全。 这一步别图快。",
      "visual_cue": "汤汁收到剩三分之一，豆腐鼓胀。"
    },
    {
      "n": 7,
      "text": "尝味后撒葱段，淋少许热油出锅装盘。注意火候，不要着急。",
      "time_min": 1,
      "heat": "无火",
      "tip": "糟本身带甜咸，最后再决定要不要加盐。",
      "visual_cue": "豆腐红亮，葱段翠绿点缀。"
    }
  ],
  "tips": [
    "香糟要用福州的酒糟，颜色红亮、酒香足，别用糟卤代替。",
    "糟泥先调开再下锅，整块糟遇热会炸锅。",
    "小火慢烧是糟菜的通则，大火只会苦。"
  ],
  "common_mistakes": [
    "香糟下锅就用大火炒，几秒钟发黑发苦，只能重做。",
    "豆腐不煎直接烧，糟汁一裹就散成豆腐渣。"
  ],
  "substitutions": [
    {
      "original": "香糟",
      "substitute": "糟卤",
      "ratio": "50g 对 60ml",
      "note": "糟卤咸度高，生抽减到五毫升。"
    }
  ],
  "variations": [
    "福州人家会把糟香豆腐做成糟香豆腐煲，加几片五花肉与笋片，冬天端上桌最暖。"
  ],
  "serving_suggestion": "配白米饭最合适，糟香微甜带酒气，也可作冷盘凉吃。",
  "storage": "冷藏两天，复热小火加少量水回烧，别用微波。",
