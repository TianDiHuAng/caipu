  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成四厘米长、两厘米厚的块，用厨房纸吸干表面水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆腐表面越干，煎的时候越不容易碎。",
      "visual_cue": "豆腐块整齐，纸上留下明显水痕。"
    },
    {
      "n": 2,
      "text": "用小勺在每块豆腐中央挖出一个浅坑，挖出的豆腐碎留着。",
      "time_min": 8,
      "heat": "无火",
      "tip": "坑别挖穿底，留一厘米厚的底托住肉馅。",
      "visual_cue": "每块中央凹下，边缘完整不断裂。"
    },
    {
      "n": 3,
      "text": "猪肉馅加香菇末、姜末、料酒、盐、一半生抽与玉米淀粉，顺一个方向搅打上劲。",
      "time_min": 8,
      "heat": "无火",
      "tip": "搅到肉馅发黏能挂住筷子，蒸煮才不散。",
      "visual_cue": "肉馅黏稠成团，筷子插住不倒。"
    },
    {
      "n": 4,
      "text": "把肉馅填入豆腐坑，抹平表面，撒少许干淀粉封口。",
      "time_min": 6,
      "heat": "无火",
      "tip": "淀粉能粘住肉馅，煎时不易脱落。 这一步别图快。",
      "visual_cue": "每块豆腐顶着一层平整肉馅。"
    },
    {
      "n": 5,
      "text": "平底锅下花生油，肉馅朝下小火煎到金黄定型。",
      "time_min": 5,
      "heat": "小火",
      "tip": "先煎有肉的一面，肉汁锁住豆腐才香。",
      "visual_cue": "肉馅面焦黄结壳，锅里有吱吱声。"
    },
    {
      "n": 6,
      "text": "翻面把豆腐底面也煎到微黄，码进砂锅，加入剩余生抽、蚝油与白糖。",
      "time_min": 5,
      "heat": "中火",
      "tip": "砂锅预热后再码，冷锅下豆腐容易粘底。",
      "visual_cue": "豆腐块在砂锅里排得整齐不重叠。"
    },
    {
      "n": 7,
      "text": "加清水没过豆腐一半，小火焖十五分钟，收汁撒葱花出锅。",
      "time_min": 15,
      "heat": "小火",
      "tip": "焖的过程中别翻动，晃锅代替翻炒。 火候宁小勿大。",
      "visual_cue": "汤汁收到半干，豆腐微微鼓胀。"
    }
  ],
  "tips": [
    "用老一点的北豆腐，嫩豆腐挖坑就散，撑不住肉馅。",
    "肉馅要搅上劲，入口才有弹性，松散的一夹就掉。",
    "砂锅焖比铁锅焖更均匀，豆腐不容易破。"
  ],
  "common_mistakes": [
    "豆腐不吸干水就下锅，油花四溅还把表皮粘掉。",
    "焖的时候用铲子翻动，豆腐全碎成渣，只剩一锅糊。"
  ],
  "substitutions": [
    {
      "original": "猪肉馅",
      "substitute": "鲮鱼肉馅",
      "ratio": "200g 对 220g",
      "note": "客家也有用鱼肉的版本，需加一勺淀粉增加黏性。"
    }
  ],
  "variations": [
    "梅州客家人会在焖汁里加一勺红曲米水，成品带淡红色，年节时更讨喜。"
  ],
  "serving_suggestion": "连砂锅端上桌，撒葱花趁热吃，汤汁拌饭最香。",
  "storage": "冷藏两天，复热加少量水小火焖透，不要微波以免豆腐发硬。",
