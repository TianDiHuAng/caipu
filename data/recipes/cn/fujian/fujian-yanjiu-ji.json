    "锅铲",
    "碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉洗净沥干，带皮切成三厘米见方的大块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块切大一些，久煮才不会缩水发柴。 别急着省时间。",
      "visual_cue": "鸡块大小均匀，皮面完整。"
    },
    {
      "n": 2,
      "text": "鸡块加盐抓匀腌十五分钟，让咸味渗进肉里。注意不要着急，稳一点更好。",
      "time_min": 15,
      "heat": "无火",
      "tip": "盐要一次抓匀，后补会只咸表面。 手快也要稳。",
      "visual_cue": "鸡皮微微出水，手感发紧。"
    },
    {
      "n": 3,
      "text": "砂锅下姜片小火干煸到边缘微焦，铺满锅底。注意不要着急，稳一点更好。",
      "time_min": 3,
      "heat": "小火",
      "tip": "姜片垫底防粘，也持续给汤汁提香。 顺序别颠倒。",
      "visual_cue": "姜片边卷起，锅里有姜香。"
    },
    {
      "n": 4,
      "text": "鸡块皮朝下摆进砂锅，中火煎到鸡皮出油上色。",
      "time_min": 5,
      "heat": "中火",
      "tip": "皮朝下先煎，鸡油逼出来汤更香。 份量要称准。",
      "visual_cue": "鸡皮金黄，锅底积起一层鸡油。"
    },
    {
      "n": 5,
      "text": "沿锅边倒入米酒，放葱结，大火烧开后转小火焖煮二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "米酒一次倒足，中途加水会冲淡酒香。",
      "visual_cue": "汤汁微沸，酒香混着鸡香散开。"
    },
    {
      "n": 6,
      "text": "开盖翻动鸡块，火略调大收汁到浓稠，淋香油出锅。",
      "time_min": 5,
      "heat": "中火",
      "tip": "收汁时多翻动，避免糖分沉底粘锅。 这一步别图省事。",
      "visual_cue": "汤汁挂在鸡块上，色泽油亮。"
    }
  ],
  "tips": [
    "米酒选客家娘酒或糯米酒，甜度高，盐要相应减量。",
    "砂锅保温好，关火后焖十分钟更入味。",
    "鸡皮朝下煎出油再下酒，香气层次会明显提升。"
  ],
  "common_mistakes": [
    "盐腌时间不够就下锅，鸡肉里外咸度不一致。",
    "全程大火煮，酒气跑光只剩酸味，鸡皮也糊了。"
  ],
  "substitutions": [
    {
      "original": "米酒",
      "substitute": "料酒加水",
      "ratio": "200ml 对 120ml 料酒加 80ml 水",
      "note": "料酒咸度高，盐减到六克。"
    }
  ],
  "variations": [
    "闽西人家会加一把干香菇同焖，汤汁更鲜，配米饭特别下口。"
  ],
  "serving_suggestion": "连锅上桌，汤汁浇在米饭上最香，冬天吃暖身又开胃。",
  "storage": "冷藏三天，复热原锅小火加热，别反复烧开以免酒香散尽。",
