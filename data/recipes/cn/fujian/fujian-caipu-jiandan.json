          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 10,
          "unit": "ml",
          "note": "去腥",
          "optional": false
        },
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 40,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "碗",
    "筷子",
    "刀",
    "砧板",
    "蒸锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "萝卜干用清水泡五分钟，挤干水分后切成细小的粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡一泡能去掉多余的盐分与土味。 这一步别图省事。",
      "visual_cue": "萝卜干粒小而匀，捏起来不滴水。"
    },
    {
      "n": 2,
      "text": "鸡蛋打进大碗，加料酒与白糖，用筷子打到蛋液均匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打到蛋白蛋黄完全融合，煎出来才嫩。",
      "visual_cue": "蛋液颜色一致，表面浮起细泡。"
    },
    {
      "n": 3,
      "text": "炒锅下少量花生油，把萝卜干粒小火炒到微微发干。",
      "time_min": 4,
      "heat": "小火",
      "tip": "炒过的萝卜干香气足，也不那么咸。 火候宁小勿大。",
      "visual_cue": "萝卜干粒边角泛黄，锅里满是酱香。"
    },
    {
      "n": 4,
      "text": "炒好的萝卜干倒进蛋液，撒葱花拌匀静置两分钟。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置让萝卜干的咸味渗进蛋液。 别急着省时间。",
      "visual_cue": "蛋液里萝卜干均匀分布，颜色分明。"
    },
    {
      "n": 5,
      "text": "锅洗净烧热下花生油，倒入蛋液转中小火慢煎。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "火别大，中间没凝固表面就焦了。 手快也要稳。",
      "visual_cue": "蛋液边缘先凝固，鼓起细小气泡。"
    },
    {
      "n": 6,
      "text": "底面金黄时用锅铲翻面，轻压让未凝固的蛋液流到锅底。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "翻面用盘子扣过来最省事，不易碎。 顺序别颠倒。",
      "visual_cue": "两面金黄，蛋饼厚薄均匀。"
    },
    {
      "n": 7,
      "text": "再煎一分钟到完全定型，出锅切块装盘即可。注意不要着急，稳一点更好。",
      "time_min": 1,
      "heat": "小火",
      "tip": "切开看断面没有流动蛋液才算熟透。 份量要称准。",
      "visual_cue": "蛋饼断面紧实，切块边缘整齐。"
    }
  ],
  "tips": [
    "萝卜干本身很咸，这道菜不用再放盐与酱油。",
    "蛋液加一点料酒去腥，比加清水更提香。",
    "小火慢煎出来的蛋饼更嫩，急火只会上焦内生。"
  ],
  "common_mistakes": [
    "萝卜干不泡直接下锅，成品咸得发苦，只能配粥硬吃。",
    "大火猛煎还一直翻面，蛋饼碎成小块，卖相全无。"
  ],
  "substitutions": [
    {
      "original": "萝卜干",
      "substitute": "榨菜",
      "ratio": "60g 对 70g",
      "note": "榨菜更脆，切粒后需要多泡两遍去咸。"
    }
  ],
  "variations": [
    "闽南人家会加一小把虾皮同煎，鲜味更足，配白粥最下口。"
  ],
  "serving_suggestion": "切块配白粥或米饭，是闽南早餐桌上的常客，也常夹馒头吃。",
  "storage": "冷藏一天内吃完，复热用平底锅小火回煎，微波会让蛋饼发韧。",
