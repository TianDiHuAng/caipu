  "equipment": [
    "小锅",
    "碗",
    "刀",
    "砧板",
    "密封罐"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小葱洗净彻底晾干，只留葱绿部分切成极细的葱花。",
      "time_min": 8,
      "heat": "无火",
      "tip": "葱一定要晾干，带水泼油会剧烈溅起。",
      "visual_cue": "葱花细碎松散，捏一下不粘手。"
    },
    {
      "n": 2,
      "text": "姜去皮后先切薄片，再切丝，最后剁成细腻姜末。",
      "time_min": 4,
      "heat": "无火",
      "tip": "姜末要比葱花更细，入口才不会硌到牙。",
      "visual_cue": "姜末细腻发白，含水但不滴汁。"
    },
    {
      "n": 3,
      "text": "葱花与姜末放进碗里，加盐拌匀，静置三分钟出汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先加盐能让姜葱出汁，泼油后更入味。",
      "visual_cue": "碗底积起一层浅绿汁水。"
    },
    {
      "n": 4,
      "text": "花生油下锅烧到冒青烟，离火晾十秒再泼进碗里。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油温太高会把葱烫糊，晾十秒刚刚好。",
      "visual_cue": "泼下去的瞬间葱姜翻滚，香气冲起。"
    },
    {
      "n": 5,
      "text": "淋香油拌匀，晾凉后装罐密封，冷藏保存即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "一定要晾凉再装罐，水汽凝结会让酱变稀。",
      "visual_cue": "酱体油润，葱绿姜白分明。"
    }
  ],
  "tips": [
    "葱姜蓉讲究现做现吃，冷藏三天内风味最好。",
    "泼油分两次，先泼一半拌开再泼剩下的一半。",
    "做白切鸡时留一勺原汤调进酱里，鲜味更足。"
  ],
  "common_mistakes": [
    "葱花带水就泼热油，油花四溅烫手，葱香也变闷味。",
    "姜末剁得太粗，蘸食时满口姜渣，口感很差。"
  ],
  "substitutions": [
    {
      "original": "花生油",
      "substitute": "菜籽油",
      "ratio": "1:1",
      "note": "菜籽油需先烧透去生味，风味更中性。"
    }
  ],
  "variations": [
    "闽南版本会加一勺虾油同泼，鲜味更重，配白灼海鲜非常对味。"
  ],
  "serving_suggestion": "配白切鸡、白灼虾、清蒸鱼都合适，也可拌热米饭与汤面。",
  "storage": "密封冷藏三天内用完，取用用干勺，避免生水导致葱末发酸。",
