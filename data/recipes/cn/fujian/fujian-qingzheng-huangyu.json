  "steps": [
    {
      "n": 1,
      "text": "黄鱼去鳞去内脏，刮净腹腔内的黑膜，两面各斜划三刀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黑膜不刮净腥味最重，划刀便于入味。",
      "visual_cue": "鱼身刀口整齐，腹腔内壁洁白无黑。"
    },
    {
      "n": 2,
      "text": "鱼身内外抹盐与料酒，鱼腹塞姜片，静置九分钟去腥。",
      "time_min": 9,
      "heat": "无火",
      "tip": "腌的时间够了才不腥，但别超过十五分钟。",
      "visual_cue": "鱼身表面微微出水，料酒味散开。"
    },
    {
      "n": 3,
      "text": "盘底垫几根小葱，鱼放上去，水开后上锅大火蒸八分钟。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水必须大开再上锅，冷水蒸鱼肉会老。",
      "visual_cue": "鱼眼凸出发白，鱼身微微隆起。"
    },
    {
      "n": 4,
      "text": "取出鱼盘，倒掉盘底腥水，拣掉姜片与垫底的葱段。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘里的腥水一定要倒掉，留着会毁掉整盘。",
      "visual_cue": "盘底无积水，鱼身干净完整。"
    },
    {
      "n": 5,
      "text": "鱼身先淋上生抽，再铺一层新切的葱丝与姜丝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生抽沿着盘边淋进去，鱼身颜色才均匀好看。",
      "visual_cue": "葱丝姜丝整齐铺在鱼背，生抽沉在盘底。"
    },
    {
      "n": 6,
      "text": "花生油烧到冒青烟，浇在葱姜丝上激香，滴香油即成。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油一定要烧透再浇，香气才炸得出来。",
      "visual_cue": "葱丝瞬间蜷曲，油香混着鱼鲜升起。"
    }
  ],
  "tips": [
    "选一斤二两左右的黄鱼，肉厚适中，蒸八分钟刚好。",
    "蒸好别急着开盖，焖半分钟鱼肉更松。",
    "盘底垫葱段让鱼离盘，受热均匀不粘底。"
  ],
  "common_mistakes": [
    "冷水上锅蒸，鱼肉纤维慢慢收紧，吃起来发柴带腥。",
    "蒸完不换葱姜直接浇油，旧葱带腥，香气也散不出来。"
  ],
  "substitutions": [
    {
      "original": "黄鱼",
      "substitute": "鲈鱼",
      "ratio": "1:1",
      "note": "鲈鱼蒸制时间相当，肉质更紧实。"
    }
  ],
  "variations": [
    "福鼎一带会在鱼腹塞两片咸菜同蒸，咸鲜里多一层发酵香。"
  ],
  "serving_suggestion": "趁热先尝鱼腹最嫩的一段，配米饭，淋盘底的豉汁拌饭。",
  "storage": "冷藏一日，复蒸三分钟即可，不要用微波炉高火。",
