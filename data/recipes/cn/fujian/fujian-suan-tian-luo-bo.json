  "steps": [
    {
      "n": 1,
      "text": "白萝卜去皮切两毫米薄片，越薄越入味。这一步别着急。",
      "time_min": 9,
      "heat": "无火",
      "tip": "片要均匀，腌出来口感才齐。，注意火候。",
      "visual_cue": "片薄半透，大小一致，状态稳定"
    },
    {
      "n": 2,
      "text": "萝卜片加盐抓匀，静置二十分钟杀水。这一步别着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "杀出水分，腌汁才不被稀释。，注意火候。",
      "visual_cue": "片身变软，出水明显，状态稳定"
    },
    {
      "n": 3,
      "text": "挤干萝卜片的水分，用凉开水冲一遍。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "挤得越干，成品越脆。，注意火候。",
      "visual_cue": "片身干爽，能弯不断，状态稳定"
    },
    {
      "n": 4,
      "text": "小锅倒清水和白醋，加白糖小火煮到化开。这一步别着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖化开就关火，别煮太久。，注意火候。",
      "visual_cue": "糖液清亮，微酸带甜，状态稳定"
    },
    {
      "n": 5,
      "text": "糖醋汁放凉到室温，尝一下酸甜是否平衡。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "热汁会把萝卜烫软，必须放凉。，注意火候。",
      "visual_cue": "汁液透明，酸甜适中，状态稳定"
    },
    {
      "n": 6,
      "text": "萝卜片装进干净玻璃罐，放小米椒圈。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "罐子要无油无水，不然会坏。，注意火候。",
      "visual_cue": "片层压实，辣椒点缀，状态稳定"
    },
    {
      "n": 7,
      "text": "倒入糖醋汁没过萝卜片，盖紧冷藏一夜。这一步别着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "汁要没过，露出的部分会变味。，注意火候。",
      "visual_cue": "汁液浸没，罐口干净，状态稳定"
    }
  ],
  "tips": [
    "萝卜片切薄一点，腌一夜就入味。，值得留意。",
    "杀水挤干，成品才脆不软。，值得留意。",
    "罐子必须无油无水，不然容易变质。，值得留意。"
  ],
  "common_mistakes": [
    "萝卜没杀水，腌出来一罐汤。，值得留意。",
    "糖醋汁热着倒，萝卜全软掉。，值得留意。",
    "罐子有油，两天就发酸变质。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "白萝卜",
      "substitute": "青萝卜",
      "ratio": "600 克:600 克",
      "note": "辛味略重，糖可加到 100 克。"
    },
    {
      "original": "白醋",
      "substitute": "米醋",
      "ratio": "120 毫升:120 毫升",
      "note": "酸味柔和，颜色偏黄。"
    }
  ],
  "variations": [
    "加几片柠檬，果香更清爽。，值得留意。",
    "换成胡萝卜和黄瓜，做成三色泡菜。，值得留意。"
  ],
  "serving_suggestion": "配炸物、卤肉或粥，解腻爽口。，效果更稳定。",
  "storage": "冷藏一周，取用须用干净筷子。，效果更稳定。",
