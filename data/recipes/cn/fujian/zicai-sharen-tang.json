  "equipment": [
    "汤锅",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁加 10g 淀粉与少许盐抓匀，静置 10 分钟再冲洗干净。",
      "time_min": 12,
      "heat": "无火",
      "tip": "淀粉能带走虾仁表面的黏液，口感更弹。",
      "visual_cue": "虾仁表面发亮、手感清爽"
    },
    {
      "n": 2,
      "text": "汤锅加 900ml 清水大火烧开，转中火放入虾仁煮 2 分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "虾仁变色就打卷，久煮会老。",
      "visual_cue": "虾仁卷曲变红、汤面微沸"
    },
    {
      "n": 3,
      "text": "撇净浮沫后放入紫菜片，用汤勺轻轻推散，避免结团。",
      "time_min": 2,
      "heat": "中火",
      "tip": "紫菜一烫就软，别久煮。",
      "visual_cue": "紫菜舒展开、汤色转深"
    },
    {
      "n": 4,
      "text": "转小火，把蛋液沿锅边细细淋入，静置 10 秒再轻推成蛋花。",
      "time_min": 2,
      "heat": "小火",
      "tip": "淋蛋液时别搅，蛋花才成片。",
      "visual_cue": "蛋花成薄片状浮起在汤面"
    },
    {
      "n": 5,
      "text": "加 3g 盐与 2g 白胡椒调味，关火淋 5ml 香油撒葱花。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油最后淋，香气才不散。",
      "visual_cue": "汤面泛油光、葱香冒出"
    }
  ],
  "tips": [
    "虾仁用淀粉抓洗，腥味去掉大半。",
    "紫菜下锅即熟，煮久了会烂成糊。",
    "蛋液沿锅边淋入不搅动，蛋花才漂亮。"
  ],
  "common_mistakes": [
    "虾仁煮到发白卷老，咬着像橡皮。",
    "紫菜冷水下锅久煮，汤变浑浊发苦。",
    "蛋液倒进滚汤猛搅，蛋花碎成絮状。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鲜贝",
      "ratio": "250g 对 250g",
      "note": "煮制时间减 1 分钟。"
    },
    {
      "original": "紫菜",
      "substitute": "裙带菜",
      "ratio": "20g 对 25g",
      "note": "需提前泡发 10 分钟。"
    }
  ],
  "variations": [
    "豆腐版：加 150g 嫩豆腐块同煮，汤更饱满。",
    "酸辣版：起锅前加 10ml 米醋与少许白胡椒。"
  ],
  "serving_suggestion": "饭前一碗，配拌面和卤味就是闽南人的一餐。",
  "storage": "建议现做现喝，冷藏不超过 1 天，复热须煮开。",
