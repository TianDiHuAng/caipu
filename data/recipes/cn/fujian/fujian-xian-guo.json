  "equipment": [
    "模具",
    "蒸锅",
    "锅",
    "锅铲",
    "擦丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米提前泡四小时，沥干后加四百毫升清水磨成细腻的米浆。",
      "time_min": 8,
      "heat": "无火",
      "tip": "米要泡到一捏就碎，磨出的浆才细。",
      "visual_cue": "米浆顺滑，勺背挂薄层。"
    },
    {
      "n": 2,
      "text": "白萝卜擦成细丝，加两克盐抓匀腌十分钟，用手挤干水分。",
      "time_min": 7,
      "heat": "无火",
      "tip": "萝卜水要挤干，否则米糊太稀不成形。",
      "visual_cue": "萝卜丝绵软，挤出一小碗水。"
    },
    {
      "n": 3,
      "text": "干香菇用温水泡软切成小丁，虾米略剁几刀，五花肉切成小丁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "干香菇须泡发后彻底加热至熟透，不要生食。",
      "visual_cue": "香菇丁均匀，虾米香气散出。"
    },
    {
      "n": 4,
      "text": "花生油煸五花肉丁与香菇丁出香，下虾米炒散，放萝卜丝炒到出水再收干。",
      "time_min": 9,
      "heat": "中火",
      "tip": "料要炒透，蒸出来的粿才有底味。",
      "visual_cue": "锅底见油，萝卜丝软塌。"
    },
    {
      "n": 5,
      "text": "加盐与白胡椒调味，倒入米浆，转小火不停搅成能立住的稠糊。",
      "time_min": 7,
      "heat": "小火",
      "tip": "搅糊不能停手，一停就结块糊底。",
      "visual_cue": "米糊浓稠，铲子立着不倒。"
    },
    {
      "n": 6,
      "text": "米糊装进抹过油的模具，用铲子压实抹平表面，大火蒸四十分钟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "蒸锅里的水一次加足，中途不要开盖看。",
      "visual_cue": "表面平滑，按压有弹性。"
    },
    {
      "n": 7,
      "text": "彻底放凉后脱模切块，可直接吃，也可下锅煎到两面焦香。",
      "time_min": 7,
      "heat": "中火",
      "tip": "一定等彻底放凉再切，热着切会整块散开。",
      "visual_cue": "切面平整，米粒感清楚。"
    }
  ],
  "tips": [
    "米与水的比例约一比二点三，浆太稀蒸不成型。",
    "咸粿要蒸足四十分钟，中间不能开盖，否则会回缩。",
    "煎着吃是闽南人的标准吃法，边缘焦脆、中间软糯。"
  ],
  "common_mistakes": [
    "米浆太稀，蒸出来一摊软泥切不成块。",
    "萝卜丝没挤干，成品内部湿黏发酸。"
  ],
  "substitutions": [
    {
      "original": "大米",
      "substitute": "粘米粉",
      "ratio": "300g 米 对 280g 粉",
      "note": "用粘米粉要减水五十毫升，浆要稠一些。"
    }
  ],
  "variations": [
    "泉州人做咸粿会加一把油葱酥与少许五香粉，香气更浓，切片煎到起壳配甜辣酱吃。"
  ],
  "serving_suggestion": "切片煎香配蒜泥酱油或甜辣酱，也可切块煮汤。",
  "storage": "冷藏三天，冷冻一个月；冷冻后复蒸十分钟再煎。",
