  "steps": [
    {
      "n": 1,
      "text": "梅花肉切成两指宽的条，加盐、白糖、生抽与料酒抓匀，腌二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "肉条粗细一致，炸的时候才同步熟。",
      "visual_cue": "肉条表面挂上酱色，盆底有汁。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散倒进肉条拌匀，再分次加红薯淀粉抓成薄浆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先蛋液后红薯淀粉，浆才粘得牢不掉渣。",
      "visual_cue": "每条都裹上厚浆，不见裸露的肉条。"
    },
    {
      "n": 3,
      "text": "花生油烧到六成热，肉条逐条下锅，中火炸到浅金黄捞出。",
      "time_min": 10,
      "heat": "中火",
      "tip": "一条条下锅，粘在一起就炸不透。",
      "visual_cue": "外壳定型，油面气泡均匀。"
    },
    {
      "n": 4,
      "text": "油温升到八成，肉条回锅复炸三十秒至外壳酥脆，捞出控油。",
      "time_min": 8,
      "heat": "大火",
      "tip": "复炸是酥的关键，时间短但别走开。",
      "visual_cue": "外壳深金黄，敲起来有声。"
    },
    {
      "n": 5,
      "text": "猪骨焯水后加姜片与清水熬四十分钟，滤渣留汤备用。",
      "time_min": 10,
      "heat": "小火",
      "tip": "汤要清亮，才压得住醋肉的酸甜味。",
      "visual_cue": "汤色微白，撇净浮油。"
    },
    {
      "n": 6,
      "text": "挂面下沸水煮到刚熟，捞进碗里，浇上滚汤，加生抽与盐调味。",
      "time_min": 6,
      "heat": "大火",
      "tip": "面别煮过头，泡在汤里还会继续软。",
      "visual_cue": "面条浮起，掐断见白芯刚消失。"
    },
    {
      "n": 7,
      "text": "面上摆炸好的醋肉，淋香醋，撒蒜末、葱末、芹菜末与白胡椒粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "醋最后淋，香气才在，早放就挥发掉了。",
      "visual_cue": "汤面浮着油花，酸香扑鼻。"
    }
  ],
  "tips": [
    "醋肉要现炸现吃，泡在汤里超过五分钟外壳就软了。",
    "香醋分两次用，腌肉时一点，出锅前淋一点，酸得更有层次。",
    "泉州人吃醋肉面爱配一小碟甜辣酱，酸甜打底。"
  ],
  "common_mistakes": [
    "肉条浆太薄，下锅就脱浆，油变浑肉变柴。",
    "醋一次倒太多，汤酸得发涩，压住海鲜与骨汤的鲜。"
  ],
  "substitutions": [
    {
      "original": "梅花肉",
      "substitute": "鸡胸肉",
      "ratio": "250g 对 250g",
      "note": "鸡胸肉要缩短炸制时间，三十秒就够。"
    }
  ],
  "variations": [
    "泉州石狮一带会把醋肉切小块，和面线一起煮成醋肉面线，酸香更浓，是夏日开胃的吃法。"
  ],
  "serving_suggestion": "连汤带面盛出，先把醋肉夹出来另放，吃一口面咬一口肉，脆感不丢。",
  "storage": "醋肉冷藏两天，复热用一百八十度烤五分钟；汤与面分开存，勿久泡。",
