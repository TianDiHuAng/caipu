  "equipment": [
    "蒸锅",
    "炒锅",
    "锅铲",
    "深盘",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加姜片与料酒，大火煮二十分钟至筷子能插入。",
      "time_min": 20,
      "heat": "大火",
      "tip": "煮到七成熟就够，太烂后面炸会散。 这一步别图省事。",
      "visual_cue": "肉皮变半透明，筷子插进有阻力。"
    },
    {
      "n": 2,
      "text": "捞出趁热在肉皮上抹老抽，静置晾到表面干爽不粘手。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮不干就下油锅，油会剧烈炸开。 火候宁小勿大。",
      "visual_cue": "肉皮呈深枣红色，摸上去发干。"
    },
    {
      "n": 3,
      "text": "花生油烧到六成热，肉块皮朝下入锅，中火炸至起泡。",
      "time_min": 8,
      "heat": "中火",
      "tip": "下锅后立刻盖锅盖防溅，听声再开盖。",
      "visual_cue": "肉皮鼓起密集小泡，呈虎皮状。"
    },
    {
      "n": 4,
      "text": "炸好的五花肉捞出泡进温水，泡到皮皱软再切成厚片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡水这一步让皮起皱，蒸出来才糯。 别急着省时间。",
      "visual_cue": "肉皮皱纹明显，切片边缘柔软。"
    },
    {
      "n": 5,
      "text": "芋头切成与肉片同厚的片，下油锅炸到表面结壳捞起。",
      "time_min": 8,
      "heat": "中火",
      "tip": "芋头炸过才不散，也不会吸走汤汁。 手快也要稳。",
      "visual_cue": "芋片表面金黄，边缘略硬。"
    },
    {
      "n": 6,
      "text": "肉片与芋头片交替码进深盘，皮朝下，撒冰糖、八角与盐。",
      "time_min": 6,
      "heat": "无火",
      "tip": "皮朝下码，蒸好后倒扣才好看。 顺序别颠倒。",
      "visual_cue": "盘里肉芋相间，缝隙紧密。"
    },
    {
      "n": 7,
      "text": "淋生抽与剩余料酒，铺上葱结，上蒸锅大火蒸一小时。",
      "time_min": 60,
      "heat": "大火",
      "tip": "中途加水要加热水，避免温差让蒸锅停火。",
      "visual_cue": "盘底积起深色汤汁，肉片轻推即晃。"
    }
  ],
  "tips": [
    "芋头选粉糯的槟榔芋，切开断面有紫红纹路的最好。",
    "蒸足一小时，肉与芋头才会软糯入味，不要提前揭盖。",
    "倒扣装盘时先用盘子盖紧再翻手，汤汁才不会洒。"
  ],
  "common_mistakes": [
    "肉皮没抹老抽就炸，成品颜色发白，看着没有食欲。",
    "芋头没炸直接码盘，蒸完化成糊，整盘菜都塌掉。"
  ],
  "substitutions": [
    {
      "original": "芋头",
      "substitute": "红薯",
      "ratio": "1:1",
      "note": "红薯甜度高，冰糖减到八克即可。"
    }
  ],
  "variations": [
    "闽西客家版会在盘底垫一层梅干菜，吸油之后格外下饭。"
  ],
  "serving_suggestion": "倒扣上桌后浇上原汁，配一碗白米饭与清炒时蔬最合适。",
  "storage": "冷藏可存三天，复蒸十五分钟回软，汤汁可单独收稠再浇。",
