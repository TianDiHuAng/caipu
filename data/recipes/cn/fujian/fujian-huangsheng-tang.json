          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1500,
          "unit": "ml",
          "note": "煮制",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 100,
          "unit": "ml",
          "note": "增香可选",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花生仁用开水烫几分钟，趁热搓掉外层红衣，露出白仁。",
      "time_min": 240,
      "heat": "无火",
      "tip": "红衣不去，煮出来汤色发红还带涩味。",
      "visual_cue": "花生仁白净完整，红衣脱落"
    },
    {
      "n": 2,
      "text": "去皮花生仁加清水浸泡到捏起来发软，中途换一次水。",
      "time_min": 60,
      "heat": "无火",
      "tip": "泡到能用指甲掐开，煮时才易烂。",
      "visual_cue": "花生仁鼓胀，一掐就裂"
    },
    {
      "n": 3,
      "text": "汤锅加清水放花生仁，大火烧开后撇去浮沫。",
      "time_min": 5,
      "heat": "大火",
      "tip": "浮沫撇干净，汤才清不浑，成品也更奶白。",
      "visual_cue": "水面无灰白沫，汤色乳白"
    },
    {
      "n": 4,
      "text": "转小火盖盖慢煮，直到花生仁完全酥烂、汤色浓白。",
      "time_min": 75,
      "heat": "小火",
      "tip": "小火久煮才出奶白汤，大火只会浑。",
      "visual_cue": "花生一抿就化，汤稠如奶"
    },
    {
      "n": 5,
      "text": "加冰糖搅拌到完全化开，尝一口再调整甜度。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖要后放，早放花生就不容易煮烂。",
      "visual_cue": "甜味清润，汤色奶白微透"
    },
    {
      "n": 6,
      "text": "关火前淋入牛奶搅匀，盛碗趁热或冰镇后食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "牛奶别久煮，最后淋入保持奶香。",
      "visual_cue": "汤面浮一层柔白，香气扑鼻"
    }
  ],
  "tips": [
    "花生红衣要去净，汤才白净不涩。",
    "小火慢煮到酥烂，汤色自然奶白。",
    "牛奶最后淋入，久煮会起皮失香。"
  ],
  "common_mistakes": [
    "花生不泡直接煮，两小时还是硬的。",
    "大火猛煮，汤浑花生却外烂内硬。",
    "糖放得太早，花生久煮也还是发硬。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "100 毫升:100 毫升",
      "note": "香气更浓，甜度需减少两成。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "100 克:85 克",
      "note": "甜味更直白，汤色略浅。"
    }
  ],
  "variations": [
    "加几粒红枣同煮，甜香更有层次。",
    "冰镇后加几块碎冰，夏天当冷饮喝更爽。"
  ],
  "serving_suggestion": "热喝绵密顺喉，夏天冰镇后更清爽。",
  "storage": "冷藏两天，复热小火加热并搅动，别烧沸太久。",
