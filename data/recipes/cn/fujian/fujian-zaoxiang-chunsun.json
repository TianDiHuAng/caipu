  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "竹笋剥去外壳削净老根，切成大小均匀的滚刀块备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "老根纤维粗，务必削到底部露出嫩芯。",
      "visual_cue": "笋块切面洁白，掐一下能留印。"
    },
    {
      "n": 2,
      "text": "笋块冷水下锅，加姜片与料酒煮八分钟捞出沥干。",
      "time_min": 10,
      "heat": "大火",
      "tip": "焯水去草酸与涩味，笋才不刺口。 这一步别图省事。",
      "visual_cue": "水面浮起白色泡沫，笋块由白转半透明。"
    },
    {
      "n": 3,
      "text": "香糟用纱布包成小包，放进小碗加温水泡出糟汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糟包轻捏即出汁，用力挤压会发涩。 火候宁小勿大。",
      "visual_cue": "碗中糟汁米白，闻着有清酒香。"
    },
    {
      "n": 4,
      "text": "炒锅下花生油，放姜片与葱段小火煸出香味。注意不要着急，稳一点更好。",
      "time_min": 2,
      "heat": "小火",
      "tip": "姜葱只煸香不煸焦，焦了整锅发苦。 别急着省时间。",
      "visual_cue": "姜片边缘卷起，油面浮起细泡。"
    },
    {
      "n": 5,
      "text": "倒入笋块大火翻炒两分钟，让每块都裹上油光。",
      "time_min": 2,
      "heat": "大火",
      "tip": "笋吸油，炒到表面发亮才好吃。 手快也要稳。",
      "visual_cue": "笋块油润透亮，锅里滋响不断。"
    },
    {
      "n": 6,
      "text": "倒入糟汁与白糖、盐，转小火盖盖焖六分钟。注意不要着急，稳一点更好。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糟汁易挥发，盖盖焖最留香。 顺序别颠倒。",
      "visual_cue": "锅气蒸腾，汤汁收掉大半。"
    },
    {
      "n": 7,
      "text": "开盖大火收汁，笋块挂上薄薄一层糟香即可装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "收汁别收干，留一点酱汁拌饭很香。 份量要称准。",
      "visual_cue": "笋块表面裹汁发亮，盘底微湿。"
    }
  ],
  "tips": [
    "春笋要选外壳紧实、笋尖发黄的，发青的笋苦味重。",
    "糟汁过滤后使用，渣子留进去会影响口感。",
    "笋类纤维粗，胃不好的人一次别吃太多。"
  ],
  "common_mistakes": [
    "笋不焯水直接炒，涩味压不住，糟香也被盖掉。",
    "糟汁一次全倒进去又大火猛烧，酒香散尽只剩酸味。"
  ],
  "substitutions": [
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "1:1",
      "note": "茭白水分多，焖制时间缩短两分钟。"
    }
  ],
  "variations": [
    "福州做法会加一小块红糟同焖，颜色转红，糟香也更厚重。"
  ],
  "serving_suggestion": "配白粥或米饭都合适，糟汁拌饭尤其香，也可作宴席的解腻素菜。",
  "storage": "冷藏两天内吃完，复热加一勺水小火回焖，避免直接干炒发柴。",
