  "steps": [
    {
      "n": 1,
      "text": "猪里脊切成小指粗的条，加盐与两勺清水抓到表面发黏。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺着一个方向抓，肉条才吃水发嫩，也不易柴。",
      "visual_cue": "肉条表面起黏，碗里不见游离水。"
    },
    {
      "n": 2,
      "text": "分三次加入玉米淀粉，抓匀到每根肉条都裹上厚浆。",
      "time_min": 6,
      "heat": "无火",
      "tip": "分次加粉才裹得匀，一次倒进去会结块。",
      "visual_cue": "肉条根根分明，粉层看不见干粉。"
    },
    {
      "n": 3,
      "text": "香菇与竹笋切细丝，放进高汤里煮五分钟出味。",
      "time_min": 7,
      "heat": "中火",
      "tip": "笋丝先焯水去涩，汤才清甜，不带土腥味。",
      "visual_cue": "汤面轻滚，笋丝变软由白转透。"
    },
    {
      "n": 4,
      "text": "转中小火，把肉条一根根下锅，先别搅动等浆定型。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "逐条下锅才不粘连，一下锅就搅会脱浆。",
      "visual_cue": "肉条表面浆层变白定型，不再粘筷子。"
    },
    {
      "n": 5,
      "text": "肉条浮起后轻推散开，再煮两分钟至中心熟透。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "保持微沸就好，滚太猛会把肉条上的浆冲散。",
      "visual_cue": "肉条鼓起浮在汤面，断面全白无粉红。"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，淋香油，撒香菜与葱花即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "白胡椒最后放，香气才不被煮散，辣味也更清。",
      "visual_cue": "汤体微稠挂勺，葱花香菜浮在表面。"
    }
  ],
  "tips": [
    "浆要厚一点，福州肉羹讲究滑而不散。",
    "汤底用高汤打底，换成清水味道差一大截。",
    "下肉时汤只能微沸，滚开就关小火等一等。"
  ],
  "common_mistakes": [
    "肉条下锅马上去搅，浆全脱进汤里，汤浑肉柴。",
    "淀粉一次全倒，肉条粘成一团，煮出来是肉饼不是肉羹。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "1:1",
      "note": "鸡胸肉需多加五克淀粉，口感更滑。"
    }
  ],
  "variations": [
    "福州街头版本会加一勺虾油与几段鱼丸同煮，鲜味更足。"
  ],
  "serving_suggestion": "盛碗后淋几滴虾油，配拌面或锅边糊是福州人的标准早饭。",
  "storage": "冷藏一日，复热时加少许高汤稀释，稠度会回软。",
