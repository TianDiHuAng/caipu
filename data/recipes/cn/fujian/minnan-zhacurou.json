  "equipment": [
    "炒锅",
    "菜刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊逆纹切成一指粗的条，用刀背轻拍几下让肉质松软。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纹切条，炸好才不塞牙。",
      "visual_cue": "肉条粗细均匀、按下去有弹性"
    },
    {
      "n": 2,
      "text": "肉条加米醋、生抽、白糖、五香粉、料酒、盐与蒜汁抓匀，腌二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "醋要一次放足，腌透才够味。",
      "visual_cue": "肉条吸干汁水、闻着酸香"
    },
    {
      "n": 3,
      "text": "腌好的肉条分次撒入玉米淀粉，翻拌到每条都裹上干爽的薄粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "撒粉别一次倒完，边拌边看干湿。",
      "visual_cue": "肉条表面干爽、互不粘连"
    },
    {
      "n": 4,
      "text": "炒锅倒入植物油烧至六成热，肉条逐条下锅炸到浅黄定型后捞出。",
      "time_min": 5,
      "heat": "中大火",
      "tip": "一条条下锅，避免黏成团。",
      "visual_cue": "肉条挺立、外壳浅黄"
    },
    {
      "n": 5,
      "text": "锅里植物油再加热到八成热，肉条回锅复炸三十秒逼出油分。",
      "time_min": 2,
      "heat": "大火",
      "tip": "复炸时间别长，否则肉里发干。",
      "visual_cue": "外壳金黄酥脆、有脆响"
    },
    {
      "n": 6,
      "text": "捞出沥油，趁热撒少许五香粉颠匀，装盘配上甜辣酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "出锅趁热吃，凉了外壳就回软。",
      "visual_cue": "外壳干爽不泛油光"
    }
  ],
  "tips": [
    "醋肉用米醋最对味，陈醋颜色太重会发黑。",
    "裹粉要薄，粉太厚炸出来像面壳。",
    "炸好的醋肉可撒椒盐或蘸甜辣酱，两种风味都常见。"
  ],
  "common_mistakes": [
    "肉条不腌直接炸，只有酸味没有底味。",
    "粉裹得太厚太湿，下锅结成一团。",
    "油温不够就下锅，炸出来含油发腻。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "五花肉",
      "ratio": "400g 对 400g",
      "note": "五花更香，复炸时间多十秒。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "地瓜粉",
      "ratio": "80g 对 80g",
      "note": "地瓜粉更粗，炸后外壳更酥。"
    }
  ],
  "variations": [
    "加一勺南乳汁同腌，颜色红艳带腐乳香。",
    "改成空气炸锅版，表面刷薄油两百度烤十五分钟。"
  ],
  "serving_suggestion": "热吃当菜，凉了当零嘴，配茶或啤酒都合适。",
  "storage": "冷藏两天，复热用烤箱一百八十度烤五分钟。",
