  "steps": [
    {
      "n": 1,
      "text": "花蛤放进淡盐水里养上两个小时吐沙，水里滴几滴植物油，中途再换一次清水。",
      "time_min": 120,
      "heat": "无火",
      "tip": "吐沙不彻底的话整盘菜都会带沙，吃起来完全没法下口，这一步不能省。",
      "visual_cue": "花蛤壳紧闭，盆底沉有一层细沙"
    },
    {
      "n": 2,
      "text": "吐好沙的花蛤要反复搓洗外壳，把壳缝里的泥搓掉，然后沥干水分备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "壳缝里面常常藏着泥沙，两只花蛤对着互相搓洗是最快的办法。",
      "visual_cue": "壳面洁净有光，互相碰撞声清脆"
    },
    {
      "n": 3,
      "text": "韭菜洗净以后充分沥干水分，切成长段，梗和叶子分开放着备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "韭菜一定要沥干，带水下锅会出汤变黄。",
      "visual_cue": "段长均匀，茎叶分明不粘连"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，下姜丝、蒜片与干辣椒段爆香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "姜蒜先下锅，去腥的底味就靠这一步。",
      "visual_cue": "蒜片边缘微黄，香辣味散出"
    },
    {
      "n": 5,
      "text": "倒入花蛤大火翻炒，烹入米酒，加盖焖两分钟至蛤壳开口。",
      "time_min": 3,
      "heat": "大火",
      "tip": "盖一下让蒸汽把壳逼开，不开口的挑出来扔掉。",
      "visual_cue": "蛤壳纷纷张开，渗出乳白汤汁"
    },
    {
      "n": 6,
      "text": "下韭菜梗先炒三十秒，再下韭菜叶与生抽、盐，翻匀立刻出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "韭菜下锅就熟，超过一分钟就发黄出水。",
      "visual_cue": "韭菜翠绿挺立，蛤肉饱满不缩"
    }
  ],
  "tips": [
    "买花蛤时挑张嘴的活蛤，敲一下会闭壳的才新鲜。",
    "蛤肉本身带咸鲜，盐要少放，生抽也只需一点点。",
    "炒的时候加一勺蛤汤，鲜味比任何高汤都强。"
  ],
  "common_mistakes": [
    "花蛤不吐沙直接炒，一咬满嘴沙，整盘报废。",
    "韭菜炒太久，出水发黄，一点脆劲都没有。",
    "不开口的花蛤舍不得扔，混进盘里全是死的。"
  ],
  "substitutions": [
    {
      "original": "花蛤",
      "substitute": "蛏子",
      "ratio": "500克:500克",
      "note": "蛏子吐沙快，养一小时即可，炒的时间减半分钟。"
    },
    {
      "original": "韭菜",
      "substitute": "小葱",
      "ratio": "150克:150克",
      "note": "小葱更温和，炒的时间可略长。"
    }
  ],
  "variations": [
    "加一把豆芽同炒，口感更脆，汤汁也更多。",
    "换成沙茶酱炒，咸香带甜，是厦门街边常见的做法。"
  ],
  "serving_suggestion": "趁热吃最鲜，汤汁拌饭很香，配冰啤酒也很搭。",
  "storage": "建议当餐吃完，贝类海鲜隔夜易变质，不宜冷藏保存。",
