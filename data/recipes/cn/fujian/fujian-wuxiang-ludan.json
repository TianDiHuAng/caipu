  "equipment": [
    "汤锅",
    "漏勺",
    "碗",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋从冷藏取出回温十分钟，用清水冲洗干净蛋壳。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冷蛋直接下锅容易煮裂，回温更稳妥。",
      "visual_cue": "蛋壳干爽，握在手心不觉冰冷。"
    },
    {
      "n": 2,
      "text": "鸡蛋冷水下锅，水开后再煮八分钟，中途轻推防粘底。",
      "time_min": 10,
      "heat": "大火",
      "tip": "计时从水开算起，八分钟蛋黄刚好凝固。",
      "visual_cue": "水面翻滚，蛋壳没出现裂纹。"
    },
    {
      "n": 3,
      "text": "捞出鸡蛋过凉水，趁凉剥壳，剥好的蛋放进碗里备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过凉水后蛋壳一碰就掉，剥得干净。 这一步别图省事。",
      "visual_cue": "蛋白光滑完整，没有坑洼。"
    },
    {
      "n": 4,
      "text": "汤锅放姜片、葱结、八角与桂皮，加生抽、老抽与料酒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料先煮出味，卤汁才够香。 火候宁小勿大。",
      "visual_cue": "锅里酱汁转深褐，香料浮在表面。"
    },
    {
      "n": 5,
      "text": "加冰糖、盐与足量清水烧开，放入剥好的鸡蛋。",
      "time_min": 2,
      "heat": "大火",
      "tip": "水要没过鸡蛋，卤到一半翻一次面。 别急着省时间。",
      "visual_cue": "鸡蛋浸在酱汁里，液面盖过顶部。"
    },
    {
      "n": 6,
      "text": "转小火卤四十分钟，关火后连汁浸泡两小时入味。",
      "time_min": 40,
      "heat": "小火",
      "tip": "泡比煮更入色，时间不够就多泡一会儿。",
      "visual_cue": "蛋表面呈深褐色，轻轻按压有弹性。"
    },
    {
      "n": 7,
      "text": "复热时连汁烧开两分钟，捞出控汁装盘，可切半摆盘。",
      "time_min": 2,
      "heat": "中火",
      "tip": "上桌前烧开一次更入味，也杀菌。 手快也要稳。",
      "visual_cue": "切开后卤色浸入蛋白约两毫米。"
    }
  ],
  "tips": [
    "鸡蛋煮好后立刻过凉水，剥壳更容易，蛋形也完整。",
    "卤汁可反复使用，每次补些生抽与香料，越卤越香。",
    "关火后浸泡是入味的关键，时间给足味道才进得去。"
  ],
  "common_mistakes": [
    "鸡蛋一直大火滚煮，蛋壳裂开蛋白流出，卖相全毁。",
    "卤好立刻捞出，表面有色里面发白，吃着寡淡。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "鹌鹑蛋",
      "ratio": "500g 对 400g",
      "note": "鹌鹑蛋煮四分钟即可，卤制时间缩短到二十分钟。"
    }
  ],
  "variations": [
    "闽南卤味店会往卤汁里加一勺红糟，蛋色红亮，糟香也浓。"
  ],
  "serving_suggestion": "冷热皆可，切片配粥、夹馒头或作卤味拼盘的一部分都合适。",
  "storage": "连卤汁冷藏可存五天，每次取用用干净筷子，避免卤汁变质。",
