  "steps": [
    {
      "n": 1,
      "text": "猪排骨剁成六厘米段，用清水泡二十分钟去血水，捞出沥干。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡出血水，炸出来才不发黑。",
      "visual_cue": "排骨颜色转浅、水不再泛红"
    },
    {
      "n": 2,
      "text": "排骨加生抽、料酒、白糖、盐、大蒜末、生姜末与一半五香粉抓匀，腌十五分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "腌够时间，香味才进到骨头缝。",
      "visual_cue": "排骨表面挂满酱色、略有黏性"
    },
    {
      "n": 3,
      "text": "加玉米淀粉抓匀，让每段排骨裹上薄薄一层粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "粉太厚炸出来发硬，薄层就够。",
      "visual_cue": "排骨表面干爽、不粘手"
    },
    {
      "n": 4,
      "text": "锅中倒植物油烧到六成热，下排骨中火炸五分钟捞出。",
      "time_min": 7,
      "heat": "中火",
      "tip": "油温不够排骨会吸油发腻。",
      "visual_cue": "排骨浮起、外壳浅金黄"
    },
    {
      "n": 5,
      "text": "植物油升温到八成热，排骨回锅复炸四十秒至外壳酥脆，捞出沥油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "复炸时间短，只为一层脆壳。",
      "visual_cue": "外壳深金、敲起来发脆"
    },
    {
      "n": 6,
      "text": "把剩下的五香粉撒在排骨上，趁热食用更香。",
      "time_min": 1,
      "heat": "无火",
      "tip": "出锅再撒一层，香气更冲。",
      "visual_cue": "表面均匀挂着香料"
    }
  ],
  "tips": [
    "排骨选肉厚的小排，炸完还带汁。",
    "腌料里加蒜末与姜末，去腥更彻底。",
    "复炸前把排骨回温，油温才不会骤降。"
  ],
  "common_mistakes": [
    "排骨带水下锅，油花四溅还炸不脆。",
    "全程大火炸，外壳黑了里面还带血。",
    "五香粉一次全放进腌料，成品香料味发闷。"
  ],
  "substitutions": [
    {
      "original": "猪排骨",
      "substitute": "鸡翅",
      "ratio": "500g 对 500g",
      "note": "更易熟，炸制时间减两分钟。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "土豆淀粉",
      "ratio": "15g 对 15g",
      "note": "外壳更脆，凉了也不易回软。"
    }
  ],
  "variations": [
    "炸好后与蒜末、辣椒碎回锅同炒，就是干香版。",
    "不上粉直接煎制，热量更低但脆度稍弱。"
  ],
  "serving_suggestion": "趁热上桌，配一杯冰啤或者酸梅汤都合适。",
  "storage": "冷藏可放两天，复热用烤箱两百度烤八分钟。",
