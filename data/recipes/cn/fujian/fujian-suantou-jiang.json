  "steps": [
    {
      "n": 1,
      "text": "大蒜逐瓣剥皮，用刀背拍松后再剁成带颗粒的粗蓉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "拍过再剁，蒜香才出得彻底且不飞溅。",
      "visual_cue": "蒜蓉粒粒分明，黏稠带汁。"
    },
    {
      "n": 2,
      "text": "红辣椒洗净去蒂，横切成薄薄的辣椒圈，籽可留一半备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "辣椒圈切薄一点，辣味渗得快也更匀。",
      "visual_cue": "辣椒圈大小一致，颜色鲜红透亮。"
    },
    {
      "n": 3,
      "text": "蒜蓉与辣椒圈放进碗里，加盐与白糖拌匀静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先加盐静置，蒜的辛辣会转成柔和的香。",
      "visual_cue": "碗底渗出少量蒜汁，蒜蓉微微塌下。"
    },
    {
      "n": 4,
      "text": "倒入生抽与米醋，用勺子搅匀让白糖彻底化开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生抽与醋约一比一最平衡，酸了可补糖。",
      "visual_cue": "酱汁呈浅褐色，表面浮着蒜粒。"
    },
    {
      "n": 5,
      "text": "撒入葱花，淋上香油，装罐密封冷藏半小时即成。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷藏半小时后风味融合，蒜辣会柔和许多。",
      "visual_cue": "罐中酱汁油亮，葱花漂浮在表面。"
    }
  ],
  "tips": [
    "蒜头酱吃的是生蒜的冲劲，所以全程不加热。",
    "用紫皮独头蒜做出来更辛香，白皮蒜偏甜一些。",
    "一次多做可冷藏两周，取用时用干净勺子。"
  ],
  "common_mistakes": [
    "蒜蓉剁得太细成泥，酱汁浑浊发苦，失去颗粒口感。",
    "醋一次倒太多，酸味压过蒜香，只能靠加糖硬拉回来。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "苹果醋",
      "ratio": "1:1",
      "note": "苹果醋带果香，酸度更柔和，用量可略减。"
    }
  ],
  "variations": [
    "闽南小吃摊会在酱里加一勺甜辣酱，颜色更红，甜辣层次也更足。"
  ],
  "serving_suggestion": "配白灼虾、炸五香卷或烫血蚶最对味，也可拌米粉与海蛎煎。",
  "storage": "密封冷藏可存两周，每次用干净无水的勺子取用，避免生水带入。",
