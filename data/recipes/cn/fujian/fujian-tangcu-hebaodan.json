      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "碗",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小碗里放白糖、香醋、生抽与盐，加两勺清水调成糖醋汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "汁先调好，下锅时手忙脚乱容易糊。 手快也要稳。",
      "visual_cue": "碗中汁液清亮，糖基本化开。"
    },
    {
      "n": 2,
      "text": "玉米淀粉加冷水调成水淀粉，小葱切花、姜切末。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水淀粉要现调现用，放久了会沉底。 顺序别颠倒。",
      "visual_cue": "淀粉水呈乳白色，均匀无颗粒。"
    },
    {
      "n": 3,
      "text": "炒锅下花生油烧到五成热，逐枚打入鸡蛋煎成荷包蛋。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蛋要一枚一枚下，靠得近会粘在一起。",
      "visual_cue": "蛋白凝固发白，边缘起焦边。"
    },
    {
      "n": 4,
      "text": "煎到蛋黄表面结膜、边缘金黄时盛出，全部煎好备用。",
      "time_min": 4,
      "heat": "中火",
      "tip": "喜欢流心的可以少煎一会儿，但别太生。",
      "visual_cue": "六枚荷包蛋大小均匀，边缘焦脆。"
    },
    {
      "n": 5,
      "text": "锅里留底油，下姜末爆香，倒入调好的糖醋汁烧开。",
      "time_min": 2,
      "heat": "中火",
      "tip": "糖醋汁一开就下蛋，久烧酸味会跑。 份量要称准。",
      "visual_cue": "汁液冒泡，酸甜味直冲鼻子。"
    },
    {
      "n": 6,
      "text": "放回荷包蛋，小火焖一分钟让蛋吸汁，中途翻一次面。",
      "time_min": 1,
      "heat": "小火",
      "tip": "翻面要轻，用铲子托着翻不容易破。 这一步别图省事。",
      "visual_cue": "蛋表面染上红亮酱色。"
    },
    {
      "n": 7,
      "text": "淋入水淀粉收浓，撒葱花出锅装盘，酱汁浇在蛋上。",
      "time_min": 1,
      "heat": "中火",
      "tip": "芡汁收到能挂勺即可，别收成糊。 火候宁小勿大。",
      "visual_cue": "酱汁红亮浓稠，裹住每枚蛋。"
    }
  ],
  "tips": [
    "糖醋比例一比一最好入口，喜欢酸一点就把醋加到三十毫升。",
    "荷包蛋煎得老一点更耐焖，太嫩翻面容易破。",
    "最后勾薄芡，酱汁才挂得住蛋，不会流成一片。"
  ],
  "common_mistakes": [
    "糖醋汁不调直接往锅里撒糖倒醋，味道忽酸忽甜不匀。",
    "芡汁收得太久，结成硬块，把蛋全糊在一起。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋更清亮，酸味稍尖，糖可加到三十克。"
    }
  ],
  "variations": [
    "福州做法会加一勺番茄酱，颜色更红，酸甜也更讨孩子喜欢。"
  ],
  "serving_suggestion": "连汁浇在米饭上最下饭，也可作面食浇头，酸甜开胃。",
  "storage": "冷藏一天内吃完，复热加一勺水小火回焖，别用大火干烧。",
