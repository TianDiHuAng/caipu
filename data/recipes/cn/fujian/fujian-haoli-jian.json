  "equipment": [
    "平底锅",
    "碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "海蛎放在淡盐水里轻轻淘洗，挑净壳渣后沥干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "别用力搓，海蛎破了就出浆发腥。",
      "visual_cue": "海蛎饱满完整，盆底无沙"
    },
    {
      "n": 2,
      "text": "地瓜粉加清水调成稀浆，静置十分钟让粉粒化开。",
      "time_min": 10,
      "heat": "无火",
      "tip": "浆要调到能顺勺流下的稀度，太稠煎出发硬。",
      "visual_cue": "浆液顺滑无颗粒，微稠"
    },
    {
      "n": 3,
      "text": "平底锅烧热倒植物油，倒入海蛎浆摊平，中火煎到边缘定型。",
      "time_min": 1,
      "heat": "无火",
      "tip": "拌的时候轻推，别把海蛎搅碎出浆发腥。",
      "visual_cue": "海蛎挂上一层薄浆"
    },
    {
      "n": 4,
      "text": "海蛎倒进粉浆里，加盐、白胡椒粉和小葱拌匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "下锅后先别动，等边缘定住再翻。",
      "visual_cue": "边缘金黄，浆面半凝"
    },
    {
      "n": 5,
      "text": "把打散的鸡蛋液沿锅边淋入，转动锅让蛋液铺匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蛋液淋在蛎浆上，煎出来才蓬松。",
      "visual_cue": "蛋液铺满表面，微起泡"
    },
    {
      "n": 6,
      "text": "待蛋液凝固、底部焦香时翻面，再煎一分钟出锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "翻面用大铲一次托起，免得散开。",
      "visual_cue": "两面金黄，边缘酥脆"
    },
    {
      "n": 7,
      "text": "煎好的饼切成三角块装盘，配一小碟生抽蘸着吃。",
      "time_min": 1,
      "heat": "无火",
      "tip": "趁热切块，凉了蛋饼容易碎成渣。",
      "visual_cue": "块形完整，切口断面嫩滑"
    }
  ],
  "tips": [
    "海蛎轻洗不要搓，破了出浆就发腥。",
    "粉浆调到能顺勺流下，太稠会发硬。",
    "鸡蛋液要后淋上去，饼才蓬松不发实心。"
  ],
  "common_mistakes": [
    "粉浆调太稠，煎出来像一块厚粉饼。",
    "海蛎一下锅就急着翻，饼散成碎渣。",
    "火太大煎出焦边，里头还是生浆。"
  ],
  "substitutions": [
    {
      "original": "海蛎",
      "substitute": "虾仁",
      "ratio": "250 克:250 克",
      "note": "腥味更轻，煎制时间缩短半分钟。"
    },
    {
      "original": "地瓜粉",
      "substitute": "木薯粉",
      "ratio": "80 克:80 克",
      "note": "口感更弹，浆需多加二十毫升水。"
    }
  ],
  "variations": [
    "加一把韭菜段同煎，香气更冲也更地道。",
    "淋一勺甜辣酱，闽南吃法更地道。"
  ],
  "serving_suggestion": "趁热切块上桌，配一碗汤或咸粥都合适。",
  "storage": "冷藏一天，复热用平底锅小火两面烘热，别用微波。",
