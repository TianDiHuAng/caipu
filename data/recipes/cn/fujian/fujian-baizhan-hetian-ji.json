          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "冰水盆",
    "刀",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡里外冲洗干净，掏出腔内的血块与多余脂肪，剪去鸡屁股。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腔内血块不去，煮出来的汤发腥。 份量要称准。",
      "visual_cue": "鸡身内外干净，表皮无血点。"
    },
    {
      "n": 2,
      "text": "汤锅加足量清水，放姜片与葱结、料酒，大火烧到微沸。",
      "time_min": 10,
      "heat": "大火",
      "tip": "水要没过整鸡，中途不加水。 这一步别图省事。",
      "visual_cue": "水面冒起小泡，锅边微微颤动。"
    },
    {
      "n": 3,
      "text": "手提鸡头把整鸡浸入沸水三秒再提起，重复三次让鸡皮收紧。",
      "time_min": 3,
      "heat": "中火",
      "tip": "三提三放让鸡皮紧实，成品更爽脆。 火候宁小勿大。",
      "visual_cue": "鸡皮由软塌变得紧绷发亮。"
    },
    {
      "n": 4,
      "text": "整鸡放入锅中，保持水面微微冒泡浸煮二十分钟后关火焖十分钟。",
      "time_min": 30,
      "heat": "小火",
      "tip": "全程不能大滚，滚了肉就发柴。 别急着省时间。",
      "visual_cue": "水面只有细密小泡，鸡身浮起。"
    },
    {
      "n": 5,
      "text": "用筷子插进鸡身最厚的部位，无血水渗出即捞出，立刻投入冰水。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冰水激过鸡皮才脆，肉也更紧实。 手快也要稳。",
      "visual_cue": "鸡皮骤缩发亮，表面油光凝住。"
    },
    {
      "n": 6,
      "text": "晾凉后斩成均匀块状，按原形码盘，撒葱花与姜蓉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刀要快，压刀会把肉压散。 顺序别颠倒。",
      "visual_cue": "鸡块皮肉相连，断面略带粉嫩。"
    },
    {
      "n": 7,
      "text": "生抽加少许盐与香油调成蘸碟，与鸡块一同上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蘸碟现调现用，放久了会发咸。 份量要称准。",
      "visual_cue": "碟中酱色清亮，油花聚在表面。"
    }
  ],
  "tips": [
    "鸡不要选太大，两斤左右肉质最嫩，浸煮时间也好控制。",
    "焖的时间宁短勿长，多焖五分钟肉就开始发木。",
    "斩鸡时皮朝下先片开，再斩块，皮肉不易分离。"
  ],
  "common_mistakes": [
    "全程大火滚煮，鸡皮破裂、肉质发柴，一咬全是渣。",
    "捞出后不冰镇直接斩，鸡皮黏刀，摆盘全塌。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "800g 对 700g",
      "note": "鸡腿肉浸煮时间缩短到十二分钟。"
    }
  ],
  "variations": [
    "闽西吃法会配一碟姜汁米酒，蘸着吃暖胃，冬天尤其受欢迎。"
  ],
  "serving_suggestion": "斩块上桌蘸葱姜或生抽碟，鸡汁可留着拌面或煮粥。",
  "storage": "冷藏两天内吃完，复热用蒸不用微波，避免肉质变干。",
