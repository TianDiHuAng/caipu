  "steps": [
    {
      "n": 1,
      "text": "草鱼去皮去骨取净肉 500g，用勺子刮下鱼茸，检查有无细刺。",
      "time_min": 20,
      "heat": "无火",
      "tip": "刮出的鱼茸比刀剁的更细，弹性更好。",
      "visual_cue": "鱼茸细腻发白、无刺感"
    },
    {
      "n": 2,
      "text": "鱼茸加 10g 盐、3g 白胡椒与姜汁，顺一个方向搅打 8 分钟至起胶发黏。",
      "time_min": 9,
      "heat": "无火",
      "tip": "盐先下才能打出胶质，顺序不能反。",
      "visual_cue": "鱼茸能整团提起、倒盆不落"
    },
    {
      "n": 3,
      "text": "分次加入 100ml 冰水与 1 个蛋清继续搅打，再拌入 40g 淀粉搅匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冰水分次加，一次倒多会稀散。",
      "visual_cue": "鱼浆细腻有光泽、挑起呈倒三角"
    },
    {
      "n": 4,
      "text": "五花肉 120g 剁成细馅，加 15ml 生抽、10ml 香油与少许葱末拌匀，搓成小肉丸。",
      "time_min": 10,
      "heat": "无火",
      "tip": "五花肉馅搓小一点，包进鱼浆才不容易破。",
      "visual_cue": "五花肉丸紧实、直径约 1.5cm"
    },
    {
      "n": 5,
      "text": "虎口挤出鱼浆，塞入一颗五花肉丸后收口，用湿勺舀入 60℃ 温水中定型。",
      "time_min": 15,
      "heat": "微火",
      "tip": "水温不能滚，滚水会把丸子冲散。",
      "visual_cue": "鱼丸浮起成球、表面光滑"
    },
    {
      "n": 6,
      "text": "全部挤完后加 30g 大葱段，转中火煮 5 分钟至鱼丸浮起饱满，捞出放清水保存。",
      "time_min": 7,
      "heat": "中火",
      "tip": "煮到鱼丸鼓胀有弹性即可，久煮会老。",
      "visual_cue": "鱼丸体积膨大、按之回弹"
    }
  ],
  "tips": [
    "鱼茸一定要刮不要剁，纤维不断裂弹性才足。",
    "搅打全程顺一个方向，反向会把胶质打散。",
    "煮鱼丸的水保持微沸，滚水易破皮。"
  ],
  "common_mistakes": [
    "鱼茸没打出胶就直接挤丸，下锅立刻散成一锅糊。",
    "冰水一次全倒入，鱼浆变稀无法成型。",
    "水温过高下丸子，表皮瞬间膨胀后开裂。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲅鱼",
      "ratio": "800g 对 800g",
      "note": "鲅鱼刺少肉厚，更适合新手。"
    },
    {
      "original": "淀粉",
      "substitute": "玉米淀粉",
      "ratio": "40g 对 45g",
      "note": "弹性稍弱，需多打 2 分钟。"
    }
  ],
  "variations": [
    "包心版：肉馅换成 80g 虾仁馅，鲜味更突出。",
    "汤丸版：与 300ml 高汤、紫菜同煮成汤。"
  ],
  "serving_suggestion": "配清汤与葱花做成鱼丸汤，或下火锅涮煮。",
  "storage": "冷藏 2 天，冷冻 1 个月；冷冻后直接冷水下锅煮。",
