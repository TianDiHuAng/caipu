  "equipment": [
    "蒸锅",
    "深碗",
    "筛网",
    "碗",
    "筷子",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕开，蛋清与蛋黄分装两个碗，蛋清里加盐打散。",
      "time_min": 6,
      "heat": "无火",
      "tip": "分蛋时蛋清里不能掺蛋黄，否则打不发。",
      "visual_cue": "蛋清透明，蛋黄完整不破。"
    },
    {
      "n": 2,
      "text": "咸蛋黄与皮蛋分别切成半厘米的小丁，大小尽量一致。",
      "time_min": 6,
      "heat": "无火",
      "tip": "丁切小一点，蒸出来分布才均匀。 别急着省时间。",
      "visual_cue": "两种蛋丁颗粒均匀，不粘连。"
    },
    {
      "n": 3,
      "text": "蛋清按一比一点五加温水搅匀，过筛滤去泡沫。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛后蒸出来才平滑无孔。 手快也要稳。",
      "visual_cue": "蛋清液清澈，筛网留下泡沫。"
    },
    {
      "n": 4,
      "text": "深碗里铺咸蛋黄丁与皮蛋丁，倒入蛋清液，轻轻晃平。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋丁铺底，倒液时沿碗边慢慢下。 顺序别颠倒。",
      "visual_cue": "蛋丁在碗底均匀分布，液面平整。"
    },
    {
      "n": 5,
      "text": "碗口盖保鲜膜，放进上汽蒸锅中小火蒸十二分钟。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "火别大，蛋清起泡就毁了镜面。 份量要称准。",
      "visual_cue": "蛋清层凝固发白，轻晃不流动。"
    },
    {
      "n": 6,
      "text": "蛋黄加料酒与一勺温水打散，过筛后倒在凝固的蛋清上。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋黄液要过筛，气泡会让表面粗糙。 这一步别图省事。",
      "visual_cue": "蛋黄液铺满整层，颜色橙黄。"
    },
    {
      "n": 7,
      "text": "再蒸八分钟至蛋黄凝固，取出淋生抽与香油，撒葱花。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "第二层也要盖保鲜膜，避免滴水生孔。",
      "visual_cue": "表面光滑，切开呈三层分明的花纹。"
    }
  ],
  "tips": [
    "分蛋要干净，蛋清里有一滴蛋黄都打不匀。",
    "两层都要盖保鲜膜，水汽滴落会让表面坑洼。",
    "中小火慢蒸，蛋体才细腻不起蜂窝。这一点要留意。"
  ],
  "common_mistakes": [
    "一次把蛋液全倒进去，蛋黄蛋清混在一起，切面没有层次。",
    "大火猛蒸，蛋体膨胀起大孔，口感老得像海绵。"
  ],
  "substitutions": [
    {
      "original": "皮蛋",
      "substitute": "咸蛋黄",
      "ratio": "80g 对 80g",
      "note": "全用咸蛋黄则盐减到两克，避免过咸。"
    }
  ],
  "variations": [
    "闽南宴席版会在蛋丁里拌入一点虾仁碎，鲜味更足，切面也更漂亮。"
  ],
  "serving_suggestion": "放凉后切块摆盘，是宴席上的冷盘常客，也可热食配米饭。",
  "storage": "冷藏两天，切块后复蒸五分钟，冷食风味更佳。",
