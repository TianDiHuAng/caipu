    "冰水盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼撕去表皮与内脏，抽出软骨，用清水反复冲洗至水清。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表皮不撕会带腥味，成品也不透亮。",
      "visual_cue": "小管通体乳白、腹腔干净无沙"
    },
    {
      "n": 2,
      "text": "锅中加 1500ml 清水，放姜片、葱段、20ml 料酒与 5g 盐，大火烧至滚沸。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水要足够多，下锅后温度才不会掉太快。",
      "visual_cue": "水面大滚、姜葱香气散出"
    },
    {
      "n": 3,
      "text": "鱿鱼整只下锅，保持大火汆 90 秒，见身体卷曲立刻捞出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "时间一长肉质就变韧，宁可略生。",
      "visual_cue": "小管卷成筒状、颜色转成雪白"
    },
    {
      "n": 4,
      "text": "捞出的鱿鱼立即投入冰水中浸 2 分钟，让肉质收紧变脆。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冰水激一下，口感差别很明显。",
      "visual_cue": "小管紧实弹手、表面干爽"
    },
    {
      "n": 5,
      "text": "沥干水分摆盘，铺上姜丝、葱丝与小米辣圈，浇 30ml 蒸鱼豉油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "摆盘前一定沥干，否则蘸汁会被稀释。",
      "visual_cue": "盘中不见积水、配料铺满管身"
    },
    {
      "n": 6,
      "text": "20ml 植物油烧至微微冒烟，均匀淋在姜葱上激出香味即可上桌。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油要滚烫，淋下去才有滋啦声。",
      "visual_cue": "姜葱受热卷曲、香气冲鼻"
    }
  ],
  "tips": [
    "鱿鱼越小越嫩，选手指长的最合适，汆水时间也更好控制。",
    "焯水锅里的盐不能省，能让肉质更紧实。",
    "没有蒸鱼豉油，可用 20ml 生抽加 5g 白糖调匀代替。"
  ],
  "common_mistakes": [
    "鱿鱼下锅后煮到完全卷紧才捞，肉已经老得嚼不动。",
    "焯完不冰镇直接装盘，余温继续加热导致过熟。",
    "内脏没清干净，一口咬到沙子整盘报废。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "章鱼",
      "ratio": "600g 对 600g",
      "note": "章鱼更韧，需先煮 20 分钟软化。"
    },
    {
      "original": "蒸鱼豉油",
      "substitute": "生抽加白糖",
      "ratio": "30ml 对 20ml 生抽加 5g 白糖",
      "note": "甜咸更柔和，适合不吃咸的人。"
    }
  ],
  "variations": [
    "闽南芥末版：蘸碟加 5g 黄芥末，辛香更突出。",
    "蒜蓉版：热油改淋蒜蓉，香气更浓。"
  ],
  "serving_suggestion": "整只蘸豉油食用，配一碗地瓜粥是闽南沿海的日常。",
  "storage": "冷藏 1 天，隔夜肉质会变硬，建议现做现吃。",
