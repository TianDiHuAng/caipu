  "equipment": [
    "炒锅",
    "料理机",
    "玻璃瓶",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾米用清水泡 15 分钟至回软，捞出沥干后剁成细碎。",
      "time_min": 15,
      "heat": "无火",
      "tip": "泡透的虾米剁起来才不出硬粒。",
      "visual_cue": "虾米回软、剁成细末"
    },
    {
      "n": 2,
      "text": "花生用小火干锅炒香，搓去红衣后压成粗碎粒。",
      "time_min": 8,
      "heat": "小火",
      "tip": "小火慢炒，花生才不糊。",
      "visual_cue": "花生微黄、香气散出"
    },
    {
      "n": 3,
      "text": "洋葱与大蒜分别切成细末，洋葱末尽量切得细而匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洋葱切细，炸时才不夹生。",
      "visual_cue": "洋葱末细匀、蒜末松散"
    },
    {
      "n": 4,
      "text": "炒锅倒 150ml 植物油，小火把洋葱末炸至金黄酥香。",
      "time_min": 12,
      "heat": "小火",
      "tip": "油温别高，洋葱才慢慢吐香。",
      "visual_cue": "洋葱浮起、色转金黄"
    },
    {
      "n": 5,
      "text": "下虾米碎与花生碎继续小火翻炒 8 分钟出香。",
      "time_min": 8,
      "heat": "小火",
      "tip": "全程小火，糊一点整锅就苦。",
      "visual_cue": "锅中油色变深、香味浓"
    },
    {
      "n": 6,
      "text": "加辣椒粉与盐炒匀，晾凉后装瓶，表面封一层油。",
      "time_min": 5,
      "heat": "小火",
      "tip": "封一层油能防氧化变质。",
      "visual_cue": "酱体油润、颜色红褐"
    }
  ],
  "tips": [
    "全程小火，任何一步炒糊都会发苦。",
    "洋葱要炸到金黄，甜味才出得来。",
    "装瓶后封一层油，冷藏能放一个月。"
  ],
  "common_mistakes": [
    "大火快炒导致花生与虾米焦黑发苦。",
    "洋葱没炸透就下辣椒粉，酱有生味。",
    "装瓶前没晾凉，水汽让酱很快变质。"
  ],
  "substitutions": [
    {
      "original": "虾米",
      "substitute": "干贝",
      "ratio": "50g 对 50g",
      "note": "干贝需提前泡软撕丝。"
    },
    {
      "original": "花生",
      "substitute": "腰果",
      "ratio": "150g 对 150g",
      "note": "腰果更甜，盐可减 1g。"
    }
  ],
  "variations": [
    "潮汕版：加 10g 五香粉与 5g 陈皮末，风味更厚。",
    "减辣版：辣椒粉减到 5g，适合拌面。"
  ],
  "serving_suggestion": "可作火锅蘸料，也可拌面、炒芥蓝，鲜辣咸香。",
  "storage": "装瓶冷藏可存 1 个月，每次用干净勺子取用。",
