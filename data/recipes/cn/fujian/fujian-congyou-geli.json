    "汤锅",
    "盘",
    "刷子",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛤蜊放淡盐水里静养，中途换两次水，让泥沙吐净。",
      "time_min": 20,
      "heat": "无火",
      "tip": "水要没过蛤蜊，盐度约尝起来微咸即可。",
      "visual_cue": "盆底沉一层细沙，水色转清。"
    },
    {
      "n": 2,
      "text": "蛤蜊外壳用刷子逐只刷净，冲掉表面附着的泥沙。",
      "time_min": 5,
      "heat": "无火",
      "tip": "壳面不刷净，最后浇的汤汁里全是泥沙。",
      "visual_cue": "壳面光滑无泥，花纹清楚。"
    },
    {
      "n": 3,
      "text": "锅中加水、姜片与料酒烧开，倒入蛤蜊煮到开口。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水开后下锅，蛤蜊开口快，肉也更嫩。",
      "visual_cue": "壳口陆续张开，水面浮起白沫。"
    },
    {
      "n": 4,
      "text": "开口后立刻捞出摆盘，留两勺煮蛤蜊的汤备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "不开壳的死蛤蜊要挑掉，别混进盘里。",
      "visual_cue": "盘中蛤蜊个个张口，壳内汤汁清亮。"
    },
    {
      "n": 5,
      "text": "小葱切长段铺在蛤蜊上，淋生抽并浇入两勺蛤蜊汤。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛤蜊本身带咸味，生抽别倒太多，免得过咸。",
      "visual_cue": "葱段铺满壳面，盘底积起浅褐汤汁。"
    },
    {
      "n": 6,
      "text": "花生油烧到冒青烟，趁热浇在葱段上激出香气即成。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油必须烧透，浇上去要听到响声才对。",
      "visual_cue": "葱段瞬间变软塌下，油香轰起。"
    }
  ],
  "tips": [
    "蛤蜊买回先用盐水养两小时，滴几滴油吐沙更快。",
    "煮蛤蜊的水别倒，滤净后当浇汁，鲜味最集中。",
    "浇油前把盘子边缘擦干，热油遇到水会炸。"
  ],
  "common_mistakes": [
    "蛤蜊冷水下锅慢慢烧，肉缩得又小又老，汤汁也浑。",
    "吐沙时间不够直接下锅，吃到嘴里满口砂砾。"
  ],
  "substitutions": [
    {
      "original": "蛤蜊",
      "substitute": "蛏子",
      "ratio": "1:1",
      "note": "蛏子开口更快，煮的时间缩短到一分钟。"
    }
  ],
  "variations": [
    "闽南做法会加一勺蒜蓉与辣椒圈，葱油之外多一层辛香。"
  ],
  "serving_suggestion": "趁热吃，先吸壳内的汤汁再取肉，配啤酒或稀饭都合适。",
  "storage": "蛤蜊不宜隔夜，冷藏后肉质回缩，最多存一日并彻底复热。",
