  "equipment": [
    "炒锅",
    "锅铲",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成小丁，香菇泡发后挤干切丁，胡萝卜切同样大小的丁。",
      "time_min": 12,
      "heat": "无火",
      "tip": "三种料切同样大，口感才协调。",
      "visual_cue": "各料丁块均匀、大小一致"
    },
    {
      "n": 2,
      "text": "虾米用温水泡五分钟，捞出沥干，泡虾米的水留着备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡虾米的水带鲜味，别倒掉。",
      "visual_cue": "虾米变软、水呈浅琥珀色"
    },
    {
      "n": 3,
      "text": "炒锅下植物油，五花肉丁中小火煸炒到出油、边缘微黄。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "把猪油煸出来，饭才够香。",
      "visual_cue": "肉丁收缩出油、色泽金黄"
    },
    {
      "n": 4,
      "text": "下香菇丁、虾米与胡萝卜丁翻炒两分钟，炒出菌菇香气。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菇炒过才出鲜味，别直接下饭。",
      "visual_cue": "香菇变软、锅里有明显鲜香"
    },
    {
      "n": 5,
      "text": "加生抽、盐、白糖与白胡椒炒匀，倒入米饭转中火翻炒。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米饭提前搓散，炒时才好上色。",
      "visual_cue": "米粒均匀染上酱色"
    },
    {
      "n": 6,
      "text": "淋入两勺泡虾米的水，加盖小火焖三分钟让米粒吸味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "少量水焖一下，饭更润更入味。",
      "visual_cue": "锅内水汽收干、饭粒饱满"
    },
    {
      "n": 7,
      "text": "开盖转大火翻炒收干，撒葱花拌匀即可出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "最后大火炒干，饭粒才不粘。",
      "visual_cue": "饭粒干爽跳动、葱香扑鼻"
    }
  ],
  "tips": [
    "五花肉选肥瘦相间的，煸出的油最香。",
    "香菇用干香菇，泡发后鲜味比鲜菇浓。",
    "加一勺红葱酥，是最地道的闽南味。"
  ],
  "common_mistakes": [
    "米饭太湿就下锅，炒成糊状一团。",
    "五花肉直接下锅不煸，饭油腻不清爽。",
    "泡虾米的水全倒进去，饭变成粥。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "腊肠",
      "ratio": "150g 对 120g",
      "note": "更香但偏咸，盐需减。"
    },
    {
      "original": "虾米",
      "substitute": "干贝",
      "ratio": "30g 对 25g",
      "note": "鲜味更高级，需提前泡发撕丝。"
    }
  ],
  "variations": [
    "加一把青豆与玉米，颜色更鲜艳。",
    "把米饭换成生米同焖，就是传统咸饭做法。"
  ],
  "serving_suggestion": "一碗咸饭配一碗清汤，是闽南人的日常。",
  "storage": "冷藏可放两天，复热时加一勺水蒸透。",
