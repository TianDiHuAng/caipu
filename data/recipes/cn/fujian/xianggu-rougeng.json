  "equipment": [
    "汤锅",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切细条，加生抽 10ml、白胡椒 1g 与 10g 玉米淀粉抓匀，腌 15 分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "上浆能锁住肉汁，煮后仍滑嫩不柴。",
      "visual_cue": "肉条表面挂浆、手感滑润"
    },
    {
      "n": 2,
      "text": "干香菇温水泡 30 分钟，泡菇水过滤留用，香菇切细丝；竹笋切同样粗细的丝。",
      "time_min": 32,
      "heat": "无火",
      "tip": "泡菇水是鲜味核心，底部沉淀不要倒入。",
      "visual_cue": "香菇丝与笋丝粗细一致"
    },
    {
      "n": 3,
      "text": "高汤加泡菇水煮沸，下香菇丝与笋丝煮 5 分钟，煮出鲜味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "笋丝先煮能去涩味，汤也更清甜。",
      "visual_cue": "汤色微黄、笋丝转嫩"
    },
    {
      "n": 4,
      "text": "转中小火，把肉条抖散下锅，煮 3 分钟至变色，撇去浮沫。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "肉条抖散下锅才不会粘成坨。",
      "visual_cue": "肉条根根分明、汤面浮沫少"
    },
    {
      "n": 5,
      "text": "20g 玉米淀粉加 80ml 清水调匀淋入，边淋边搅至羹体浓稠，加盐、白糖、生抽与香醋。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芡要分两次淋，浓稠度更好控制。",
      "visual_cue": "羹体浓稠挂勺、无结块"
    },
    {
      "n": 6,
      "text": "关火后淋上香油，撒蒜末与香菜末，趁热食用最香。",
      "time_min": 1,
      "heat": "无火",
      "tip": "蒜末最后撒，辛香才冲。",
      "visual_cue": "羹面油亮、蒜香明显"
    }
  ],
  "tips": [
    "闽南肉羹讲究酸香突出，香醋可按口味加到 20ml。",
    "肉羹配一碗米粉或油面，就是厦门街头的标准吃法。",
    "勾芡后不要再大火滚，容易澥芡变稀。"
  ],
  "common_mistakes": [
    "肉条不上浆直接下锅，成品干柴、汤也浑。",
    "淀粉水一次全倒入，羹中出现大块透明疙瘩。",
    "香醋早放久煮，酸味挥发只剩咸味。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡腿肉",
      "ratio": "250g 里脊 ≈ 250g 鸡腿肉",
      "note": "鸡腿肉需去皮切条，腌 10 分钟。"
    },
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "100g 笋 ≈ 120g 茭白",
      "note": "茭白更嫩，煮制时间减 2 分钟。"
    }
  ],
  "variations": [
    "家庭简化版：用现成高汤块与鲜香菇，30 分钟出锅。",
    "厦门街头版：加 50g 鱿鱼丝同煮，海味更足。"
  ],
  "serving_suggestion": "浇在米粉或油面上做成肉羹面，也可直接作汤品。",
  "storage": "冷藏 2 天，复热加 50ml 清水小火搅匀，起锅前补 5ml 香醋。",
