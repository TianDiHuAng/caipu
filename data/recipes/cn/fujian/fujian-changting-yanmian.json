  "steps": [
    {
      "n": 1,
      "text": "五花肉剁成粗末，加料酒与白胡椒粉拌匀备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "肉别剁得太细，留一点颗粒嚼着才香。",
      "visual_cue": "五花肉碎松散，不见大块肥膘。"
    },
    {
      "n": 2,
      "text": "葱切成葱花，蒜与姜切末，豆芽掐去根须，芹菜切成碎末。",
      "time_min": 5,
      "heat": "无火",
      "tip": "葱花分两份，一份炒酱一份最后撒。",
      "visual_cue": "配料分装整齐，葱花与葱绿另放。"
    },
    {
      "n": 3,
      "text": "猪油下锅化开，下五花肉碎炒散出油，加姜蒜末炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "猪油是腌面的底味，换别的油就少一层香。",
      "visual_cue": "五花肉碎金黄，锅里有猪油香。"
    },
    {
      "n": 4,
      "text": "加生抽、老抽、盐与白糖炒成油亮的酱料，盛出一半留用。",
      "time_min": 6,
      "heat": "小火",
      "tip": "酱要炒到冒小泡，咸甜才融在一起。",
      "visual_cue": "酱色红亮，铲起能挂住。"
    },
    {
      "n": 5,
      "text": "挂面下沸水煮熟，捞起沥干，趁热倒进锅里拌入酱料与葱花。",
      "time_min": 4,
      "heat": "大火",
      "tip": "面要沥得干，带水拌酱就成汤面了。",
      "visual_cue": "每根面都裹上酱色，碗底不见水。"
    },
    {
      "n": 6,
      "text": "面装碗，铺上豆芽与芹菜碎，淋香醋，撒白胡椒粉与剩余葱花。",
      "time_min": 4,
      "heat": "无火",
      "tip": "豆芽焯十秒就够，脆感全靠这一下留住。",
      "visual_cue": "面上有绿有白，香气冲鼻。"
    }
  ],
  "tips": [
    "腌面的酱要咸一点，面条本身没味，全靠酱带。",
    "猪油不可替代，这是客家腌面区别于拌面的关键。",
    "拌面一定要趁热，面一凉酱就挂不住了。"
  ],
  "common_mistakes": [
    "面煮好沥不干就拌，酱被水稀释，味道寡淡。",
    "酱炒得太干，拌面时结块挂不匀。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "花生油",
      "ratio": "30g 对 30ml",
      "note": "换植物油香气差一截，可加一勺葱油补味。"
    }
  ],
  "variations": [
    "长汀人吃腌面必配一碗汆猪肉汤，面干汤润，一咸一鲜，是当地早餐的固定组合。"
  ],
  "serving_suggestion": "拌好立刻吃，配一碗清汤或汆肉汤，面干了可以淋一勺汤拌开。",
  "storage": "现拌现吃，酱料可冷藏三天，复热后拌面；面条不要提前拌好存放。",
