  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "韭菜择洗净沥干，切成四厘米左右的段，根部和叶子分开放。",
      "time_min": 5,
      "heat": "无火",
      "tip": "根部和叶子分开下锅，熟度才能保持一致。",
      "visual_cue": "韭菜段整齐，摊开不见水"
    },
    {
      "n": 2,
      "text": "鸡蛋磕入碗中，加盐和黄酒打散到蛋液起细密小泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打散到起泡，炒出来才蓬松软嫩。",
      "visual_cue": "蛋液均匀，表面浮小泡"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒一半植物油，蛋液下锅，小火推炒成嫩块盛出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蛋液半凝固就盛出，余温还会继续熟。",
      "visual_cue": "蛋块金黄蓬松，内部微湿"
    },
    {
      "n": 4,
      "text": "原锅补油烧热，先下韭菜根部大火翻炒十几秒，再下叶子。",
      "time_min": 2,
      "heat": "大火",
      "tip": "韭菜遇热极易出水，全程不能超过一分钟。",
      "visual_cue": "韭菜变深绿，叶身挺立"
    },
    {
      "n": 5,
      "text": "倒回蛋块，加白糖快速翻匀，尝味补盐立即出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "翻两下就出锅，多炒韭菜就塌软出水。",
      "visual_cue": "蛋韭菜分明，盘底无汤水"
    }
  ],
  "tips": [
    "韭菜根叶分开下锅，火候才好掌握。",
    "蛋液炒到半凝就盛出，回锅后正好嫩。",
    "全程大火不超过一分钟，韭菜才不出水。"
  ],
  "common_mistakes": [
    "韭菜洗完不沥水，下锅立刻出一盘汤。",
    "鸡蛋炒到全熟发硬，回锅后更干。",
    "小火慢炒，韭菜塌软发黄没香味。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "韭黄",
      "ratio": "250 克:250 克",
      "note": "香气更柔，炒制时间缩短十秒。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4 个:4 个",
      "note": "口感更紧实，需多加五毫升油。"
    }
  ],
  "variations": [
    "加几只虾仁同炒，鲜味更足也更鲜甜。",
    "淋几滴香油再起锅，香气更浓更柔和。"
  ],
  "serving_suggestion": "现炒现吃，配白粥或米饭都很家常。",
  "storage": "不建议储存，韭菜隔餐会发黑出水，最好一次吃完。",
