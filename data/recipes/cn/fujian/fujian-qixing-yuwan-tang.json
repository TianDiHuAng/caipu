  "steps": [
    {
      "n": 1,
      "text": "草鱼去鳞去内脏，片下两侧鱼肉，用勺背刮下鱼泥，顺手挑净细刺。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刮比剁好，刮出的鱼泥不带筋，丸子弹而不柴。",
      "visual_cue": "鱼泥细腻能捏成团。"
    },
    {
      "n": 2,
      "text": "鱼泥加盐、玉米淀粉与五十毫升清水，顺一个方向搅到起胶、表面发亮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一定顺同一方向搅，反着搅胶就散了。",
      "visual_cue": "鱼泥黏手拉丝，甩盆不掉。"
    },
    {
      "n": 3,
      "text": "五花肉切成细丁，拌入姜末、生抽与部分葱花，调成抱团不散的五花肉馅料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "五花肉馅调得稍稠一点，包进鱼丸才不会渗水。",
      "visual_cue": "馅料抱团，筷子挑起成坨。"
    },
    {
      "n": 4,
      "text": "手心抹水，取一勺鱼泥摊开，包入一小团五花肉馅料，收口挤成两头尖的纺锤形鱼丸。",
      "time_min": 6,
      "heat": "无火",
      "tip": "手心一定要蘸水，不然鱼泥全粘在掌上捏不成形。",
      "visual_cue": "鱼丸表面光滑，大小均匀。"
    },
    {
      "n": 5,
      "text": "清水烧到锅底冒小泡但未翻滚，逐个下鱼丸，小火慢养到全部浮起。",
      "time_min": 6,
      "heat": "小火",
      "tip": "水不能大滚，一滚鱼丸就裂开散汤。",
      "visual_cue": "鱼丸鼓起泛白，浮在水面打转。"
    },
    {
      "n": 6,
      "text": "加盐、白糖与白胡椒调味，撒葱花淋香油，连汤盛进碗里。",
      "time_min": 3,
      "heat": "小火",
      "tip": "汤要清，别加酱油，否则失了福州汤的澄净。",
      "visual_cue": "汤色清亮，鱼丸饱满。"
    }
  ],
  "tips": [
    "七星鱼丸的关键是鱼泥打上劲，搅到能甩盆不落才算到位。",
    "包了五花肉馅的鱼丸咬开会有一包油润汤汁，所以汤底只放盐与白胡椒。",
    "福州老店会把鱼丸在掌心反复摔打几十次，弹性能明显更好。"
  ],
  "common_mistakes": [
    "鱼泥没打上劲就下锅，散成一锅碎渣。",
    "水滚着下鱼丸，丸子表面先定形、内部爆开。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲅鱼",
      "ratio": "400g 对 400g",
      "note": "鲅鱼肉更紧实，打浆时可多放五毫升水。"
    }
  ],
  "variations": [
    "连江一带的鱼丸会掺少量鳗鱼肉，口感更脆，汤里则加一勺虾油提鲜。"
  ],
  "serving_suggestion": "一人一碗连汤带丸，撒葱花趁热吃，冬日配一碗白饭最暖。",
  "storage": "鱼丸可冷冻一周，汤当天喝完；复热时小火，不要大火滚。",
