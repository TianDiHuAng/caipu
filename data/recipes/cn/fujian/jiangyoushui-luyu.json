  "equipment": [
    "炒锅",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼 700g 洗净擦干，两面各划三刀，抹 3g 盐腌 8 分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼身必须擦干，煎时才不粘锅破皮。",
      "visual_cue": "鱼皮干爽、刀口整齐"
    },
    {
      "n": 2,
      "text": "炒锅倒 40ml 植物油烧至微烟，下鲈鱼中火煎 5 分钟定型。",
      "time_min": 5,
      "heat": "中火",
      "tip": "下锅后别急着动，定型才不粘。",
      "visual_cue": "鱼皮金黄、边缘微焦"
    },
    {
      "n": 3,
      "text": "翻面再煎 3 分钟，把鱼推到锅边，下姜丝与蒜片炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "只翻一次，鱼身才完整。",
      "visual_cue": "两面金黄、香料出香"
    },
    {
      "n": 4,
      "text": "沿锅边淋 20ml 料酒，加 40ml 生抽、5ml 老抽与 5g 白糖。",
      "time_min": 3,
      "heat": "中火",
      "tip": "生抽先淋锅边激香，味道更立体。",
      "visual_cue": "酱汁冒泡、香气上扬"
    },
    {
      "n": 5,
      "text": "加 200ml 清水没过鱼身一半，放葱段，中火焖 8 分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "水只到半身，收汁后味道才浓。",
      "visual_cue": "汤汁微沸、鱼眼凸出"
    },
    {
      "n": 6,
      "text": "用锅铲把汤汁反复浇在鱼身上，中火收汁 3 分钟至浓稠。",
      "time_min": 3,
      "heat": "中火",
      "tip": "浇汁比翻面更容易保持鱼形完整。",
      "visual_cue": "汤汁红亮、挂在鱼身"
    },
    {
      "n": 7,
      "text": "连汁装盘，把锅底酱汁浇在鱼身上，撒葱段即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃，鱼肉最嫩。",
      "visual_cue": "鱼形完整、酱汁油亮"
    }
  ],
  "tips": [
    "鱼身擦干再煎，是保持完整的第一步。",
    "水只加半身，收汁后味道才进得去。",
    "全程用浇汁代替翻面，鱼身才不会散。"
  ],
  "common_mistakes": [
    "鱼身带水下锅，油花四溅还粘锅破皮。",
    "清水加太多，煮成鱼汤没有酱香。",
    "大火把汤汁收干，锅底焦糊带苦味。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "黄鱼",
      "ratio": "700g 对 700g",
      "note": "肉质更细，焖制时间减 2 分钟。"
    },
    {
      "original": "生抽",
      "substitute": "蒸鱼豉油",
      "ratio": "40ml 对 40ml",
      "note": "咸度略低，盐可不加。"
    }
  ],
  "variations": [
    "加 10g 豆豉同烧，咸香更重。",
    "起锅前淋 5ml 香油，香气更足。"
  ],
  "serving_suggestion": "连汁浇在米饭上，配一碟清炒时蔬。",
  "storage": "冷藏可存 1 天，复热时连汁小火加热。",
