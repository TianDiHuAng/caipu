  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苦瓜对半剖开，用勺子刮净瓤与白膜，切成薄片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "白膜是苦味大头，刮得越净越不苦。 这一步别图省事。",
      "visual_cue": "瓜片薄而透光，内壁干净无白瓤。"
    },
    {
      "n": 2,
      "text": "水烧开加盐，苦瓜片下锅焯一分钟捞出过凉水。",
      "time_min": 4,
      "heat": "大火",
      "tip": "焯水去部分苦味，也保住翠绿。 火候宁小勿大。",
      "visual_cue": "瓜片由浅绿转深绿，口感变脆。"
    },
    {
      "n": 3,
      "text": "焯好的苦瓜片用冷水冲凉，沥干水分装盘备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "过凉水能定色，炒的时候不易发黄。 别急着省时间。",
      "visual_cue": "瓜片挺括透亮，不粘手。"
    },
    {
      "n": 4,
      "text": "豆豉略剁几刀，大蒜切末，红辣椒切成薄圈。注意不要着急，稳一点更好。",
      "time_min": 4,
      "heat": "无火",
      "tip": "豆豉剁碎香气更出，咸味也更均匀。 手快也要稳。",
      "visual_cue": "豆豉颗粒略碎，蒜末细小。"
    },
    {
      "n": 5,
      "text": "炒锅下花生油，放豆豉、蒜末与辣椒圈小火炒香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "豆豉易糊，小火慢慢煸出酱香。 顺序别颠倒。",
      "visual_cue": "锅里豆豉跳动，香气发醇。"
    },
    {
      "n": 6,
      "text": "倒入苦瓜片转大火快炒两分钟，让酱香裹住瓜片。",
      "time_min": 2,
      "heat": "大火",
      "tip": "大火快炒，苦瓜才脆不出水。 份量要称准。",
      "visual_cue": "瓜片油亮，边缘微微起皱。"
    },
    {
      "n": 7,
      "text": "加生抽与白糖翻匀，再炒半分钟收干汤汁出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "白糖用来压苦，尝一下再决定是否加量。",
      "visual_cue": "盘中不见汤汁，瓜片挂酱。"
    }
  ],
  "tips": [
    "苦瓜籽周围的瓤要挖透，残留一点就苦一整天。",
    "喜欢吃苦味的可以省掉焯水，直接大火干炒。",
    "豆豉本身有咸味，生抽要少放，先尝再调。"
  ],
  "common_mistakes": [
    "白膜没刮净就下锅，苦得盖住所有其他味道。",
    "小火慢炒苦瓜，出水变黄，脆感全无。"
  ],
  "substitutions": [
    {
      "original": "豆豉",
      "substitute": "普宁豆酱",
      "ratio": "25g 对 30g",
      "note": "豆酱更咸，生抽可完全省略。"
    }
  ],
  "variations": [
    "闽南人家会加一小把虾皮同炒，鲜味压苦，孩子也肯吃。"
  ],
  "serving_suggestion": "配白粥或米饭最合适，夏天吃开胃下火，也常与卤肉同桌。",
  "storage": "冷藏两天，复热用炒锅快炒，避免久煮发黄出水。",
