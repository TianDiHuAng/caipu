  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茭白剥去外层老壳，削掉根部硬皮，切成滚刀大块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部老皮不削，焖完咬不动。 份量要称准。",
      "visual_cue": "茭白块切面洁白，边缘整齐。"
    },
    {
      "n": 2,
      "text": "切好的茭白放进淡盐水里泡五分钟，捞出沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡盐水能去掉土腥味，也让质地更紧。",
      "visual_cue": "茭白块表面水润，不挂水珠。"
    },
    {
      "n": 3,
      "text": "小葱切葱花，姜切片，分开放好备用。注意不要着急，稳一点更好。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花最后撒，姜片先下锅煸。 这一步别图省事。",
      "visual_cue": "葱花松散翠绿，姜片薄而透。"
    },
    {
      "n": 4,
      "text": "炒锅下花生油，放姜片小火煸香，再倒茭白转中火煎。",
      "time_min": 4,
      "heat": "中火",
      "tip": "茭白先煎到边缘焦黄，焖出来才香。 火候宁小勿大。",
      "visual_cue": "茭白块边缘金黄，锅里有滋响。"
    },
    {
      "n": 5,
      "text": "加生抽、老抽与白糖翻匀，让每块都染上酱色。",
      "time_min": 1,
      "heat": "中火",
      "tip": "酱色要匀，翻动时轻一点别弄碎。 别急着省时间。",
      "visual_cue": "茭白块呈红褐色，油光发亮。"
    },
    {
      "n": 6,
      "text": "倒小半碗清水，加盐，盖盖小火烧八分钟收汁。",
      "time_min": 8,
      "heat": "小火",
      "tip": "水别多，茭白本身会出水。 手快也要稳。",
      "visual_cue": "锅内汤汁收浓，咕嘟声变闷。"
    },
    {
      "n": 7,
      "text": "开盖大火收干汤汁，撒葱花翻匀即可装盘。注意不要着急，稳一点更好。",
      "time_min": 1,
      "heat": "大火",
      "tip": "汤汁一收干就要离火，糖分容易糊。 顺序别颠倒。",
      "visual_cue": "茭白挂满酱汁，盘底无汤。"
    }
  ],
  "tips": [
    "茭白要选白白胖胖、切开无黑点的，黑点说明已老化。",
    "油焖讲究糖与酱油的比例，甜味要能尝出来。",
    "收汁时多翻动，糖分沉底很容易糊锅。"
  ],
  "common_mistakes": [
    "茭白不煎直接下水焖，成品水塌塌的，没有焦香。",
    "老抽放多了，颜色发黑发苦，整盘菜都显脏。"
  ],
  "substitutions": [
    {
      "original": "茭白",
      "substitute": "竹笋",
      "ratio": "1:1",
      "note": "竹笋需先焯水八分钟去涩，再按同法焖制。"
    }
  ],
  "variations": [
    "闽北人家会加几片咸肉同焖，油脂渗进茭白里，鲜味翻倍。"
  ],
  "serving_suggestion": "配白米饭最好，酱汁拌饭一绝，也可作面食的浇头。",
  "storage": "冷藏两天，复热加一勺水小火回焖，避免干锅焦糊。",
