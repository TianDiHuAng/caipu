  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "空心菜掐掉老根，摘成七厘米长段，梗与叶分开放。",
      "time_min": 10,
      "heat": "无火",
      "tip": "梗叶分开下锅，熟度才一致。 份量要称准。",
      "visual_cue": "菜梗脆断，叶片完整不揉烂。"
    },
    {
      "n": 2,
      "text": "摘好的菜段用清水冲两遍，捞出沥到不滴水。注意不要着急，稳一点更好。",
      "time_min": 3,
      "heat": "无火",
      "tip": "带水下锅会溅油，也炒不出脆感。 这一步别图省事。",
      "visual_cue": "菜叶挺立，甩动无水珠。"
    },
    {
      "n": 3,
      "text": "腐乳连一点汁放进碗里，用勺背压成细腻的酱。",
      "time_min": 3,
      "heat": "无火",
      "tip": "压到看不见块状，味道才均匀。 火候宁小勿大。",
      "visual_cue": "碗中腐乳成糊状，颜色乳白带红。"
    },
    {
      "n": 4,
      "text": "大蒜拍碎切末，红辣椒切圈，与腐乳酱放在一起。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜末拍碎比利刀切更出香。 别急着省时间。",
      "visual_cue": "蒜末颗粒分明，辣椒圈薄。"
    },
    {
      "n": 5,
      "text": "炒锅烧到冒烟下花生油，先下蒜末辣椒圈爆香。",
      "time_min": 1,
      "heat": "大火",
      "tip": "油温够高，蒜末一进锅就香。 手快也要稳。",
      "visual_cue": "蒜末边缘泛黄，油面翻起气泡。"
    },
    {
      "n": 6,
      "text": "先下菜梗大火炒三十秒，再下菜叶与腐乳酱翻匀。",
      "time_min": 1,
      "heat": "大火",
      "tip": "腐乳下锅后要快炒，久炒会发苦。 顺序别颠倒。",
      "visual_cue": "菜梗转深绿，酱汁裹住叶片。"
    },
    {
      "n": 7,
      "text": "加白糖快速翻匀，见叶片刚塌就立刻出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "糖只需一点，用来收腐乳的咸。 份量要称准。",
      "visual_cue": "盘中菜色翠绿，底部渗少量白汁。"
    }
  ],
  "tips": [
    "腐乳本身很咸，这道菜不用再加盐与酱油。",
    "空心菜梗比叶难熟，先下锅三十秒最保险。",
    "用猪油炒比素油更香，闽南家常都这么做。"
  ],
  "common_mistakes": [
    "腐乳没压碎就下锅，炒出来一块块白疙瘩，咸淡不均。",
    "炒到菜叶发黄出水才起锅，一盘菜软塌没口感。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "菜心",
      "ratio": "1:1",
      "note": "菜心更嫩，腐乳用量减到三十克。"
    }
  ],
  "variations": [
    "加一勺虾油同炒，鲜味更重，是福州人的下粥吃法。"
  ],
  "serving_suggestion": "配白粥或米饭都极下饭，也适合搭配油腻的荤菜清口。",
  "storage": "现炒现吃，不建议隔夜，绿叶菜复热会变色出汤。",
