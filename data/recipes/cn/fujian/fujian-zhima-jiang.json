  "equipment": [
    "碗",
    "干锅",
    "勺",
    "搅拌器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芝麻酱舀进碗里，加温开水分四次调开，边加边顺一个方向搅。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水分次加是硬规矩，一次多了就结块。",
      "visual_cue": "酱体顺滑无颗粒，能缓慢流下。"
    },
    {
      "n": 2,
      "text": "白芝麻倒进干锅小火炒到微微跳动、香气冒出，倒出摊凉。",
      "time_min": 6,
      "heat": "小火",
      "tip": "芝麻极易焦，闻到香就立刻离火。",
      "visual_cue": "芝麻粒泛浅黄，锅里有香气。"
    },
    {
      "n": 3,
      "text": "往调开的芝麻酱里加生抽、香醋、白糖与盐搅匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖和盐先在小勺温水中化开更好融。",
      "visual_cue": "酱色浅褐，味道咸酸平衡。"
    },
    {
      "n": 4,
      "text": "淋香油搅匀，撒炒香的白芝麻，静置十分钟让味道融合后装碟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置十分钟，酸香与芝麻香会咬合得更好。",
      "visual_cue": "酱面浮着芝麻，闻着有焙香。"
    }
  ],
  "tips": [
    "芝麻酱要认纯芝麻研磨的，加了花生酱的成品不够香。",
    "香醋是闽南蘸料的点睛，酸能吊出芝麻的甜。",
    "调好的酱冷藏后会变稠，用前加一勺温水再搅。"
  ],
  "common_mistakes": [
    "芝麻酱直接兑冷水，越搅越散，最后结成团。",
    "醋一次性倒太多，酸味盖住芝麻香。"
  ],
  "substitutions": [
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "120g 对 120g",
      "note": "换花生酱要减糖，花生本身带甜。"
    }
  ],
  "variations": [
    "闽南茶楼里的小碟芝麻酱会加一点芥末与甜面酱，蘸白灼蔬菜时酸、辣、香一起上头。"
  ],
  "serving_suggestion": "装小碟配白灼青菜、白切鸡或凉拌面，用前搅匀。",
  "storage": "密封冷藏十天，表面析油属正常，搅匀即可使用。",
