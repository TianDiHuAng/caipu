        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲜虾从背部剖开挑出虾线，冲洗干净后用厨房纸吸干水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "虾线不挑净会有沙感，腥味也重。",
      "visual_cue": "虾背张开、虾线彻底清除"
    },
    {
      "n": 2,
      "text": "鲜虾加盐与料酒抓匀腌十分钟，再拍上一层薄薄的玉米淀粉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拍粉前务必吸干水，粉才挂得住。",
      "visual_cue": "鲜虾表面均匀裹粉、不结块"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到七成热，鲜虾逐只下锅炸一分半钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鲜虾卷曲变红就捞出，久炸就老了。",
      "visual_cue": "虾身卷成弯钩、外壳浅金"
    },
    {
      "n": 4,
      "text": "用漏勺捞出鲜虾沥油，植物油升温后再回锅复炸二十秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "复炸把外壳水分逼出，口感更酥。",
      "visual_cue": "外壳挺硬、碰撞有脆声"
    },
    {
      "n": 5,
      "text": "锅内留少许底油，下大蒜末与小米辣小火炒香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末小火炒，才能香而不苦。",
      "visual_cue": "蒜末金黄、锅里有辣香"
    },
    {
      "n": 6,
      "text": "倒回鲜虾转大火，撒盐与白胡椒快速翻炒，撒葱花出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "椒盐最后撒，香气才冲。",
      "visual_cue": "鲜虾裹满椒盐、葱花翠绿"
    }
  ],
  "tips": [
    "鲜虾开背既能彻底去掉腥味，也更容易入味。",
    "椒盐最好现炒，用盐与白胡椒小火炒香。",
    "没有鲜虾可用整只基围虾替代，炸制时间加半分钟。"
  ],
  "common_mistakes": [
    "鲜虾不吸干水就拍粉，下锅脱浆掉粉。",
    "炸制时间过长，鲜虾缩硬嚼不动。",
    "椒盐提前撒好，炸后只剩咸味没香气。"
  ],
  "substitutions": [
    {
      "original": "鲜虾",
      "substitute": "鱿鱼",
      "ratio": "400g 对 400g",
      "note": "切花刀更易熟，炸制时间减半分钟。"
    },
    {
      "original": "白胡椒",
      "substitute": "黑胡椒",
      "ratio": "3g 对 3g",
      "note": "香气更冲，用量可略减。"
    }
  ],
  "variations": [
    "加一把炸过的蒜末同拌，香味会更浓更足。",
    "把椒盐换成避风塘炒料，风味会变得更重。"
  ],
  "serving_suggestion": "趁热上桌，配一杯冰啤酒最过瘾。",
  "storage": "当天吃完，虾类隔夜口感明显变差。",
