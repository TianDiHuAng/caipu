  "equipment": [
    "炒锅",
    "锅盖",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青蟹用刷子刷净蟹壳与蟹脚缝隙，掀开蟹盖去鳃与胃囊，斩成四块保留蟹黄。",
      "time_min": 15,
      "heat": "无火",
      "tip": "蟹鳃与胃囊必须去净，腥味主要来自这里。",
      "visual_cue": "蟹块断面露出白肉与橙黄蟹膏"
    },
    {
      "n": 2,
      "text": "蟹块切面蘸一层薄淀粉封口，避免煎的时候蟹汁流失。",
      "time_min": 5,
      "heat": "无火",
      "tip": "只蘸切面，蟹壳不用蘸。",
      "visual_cue": "切面均匀挂上一层白粉"
    },
    {
      "n": 3,
      "text": "炒锅烧热下 80ml 植物油，姜片铺底，蟹块切面朝下中火煎 4 分钟至金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "切面朝下先煎，蟹黄才锁在肉里。",
      "visual_cue": "切面结壳金黄、姜片微焦"
    },
    {
      "n": 4,
      "text": "淋 40ml 料酒，加 20ml 生抽、4g 盐与 8g 白糖，倒入 100ml 清水，盖盖焖 8 分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "水量刚没过蟹块一半即可，太多会寡淡。",
      "visual_cue": "汤汁收至一半、蟹壳转红"
    },
    {
      "n": 5,
      "text": "开盖淋入打散的蛋液，转小火晃锅让蛋液铺满锅底，凝固后撒葱段。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋液要沿锅边淋，才能铺成蛋饼。",
      "visual_cue": "蛋液凝固成金黄蛋饼、边缘微焦"
    },
    {
      "n": 6,
      "text": "关火淋 10ml 香油，撒香菜段，连锅端上桌趁热拌开食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蛋饼拌着蟹汁吃才是精华。",
      "visual_cue": "蛋饼吸满红亮蟹汁"
    }
  ],
  "tips": [
    "蟹要选活的，死蟹肉质松散且有安全风险。",
    "煎蟹时不要频繁翻动，等切面结壳再动。",
    "蛋液最后淋，能吸尽锅底蟹汁不浪费。"
  ],
  "common_mistakes": [
    "蟹块切面没蘸淀粉，下锅蟹汁全流进油里。",
    "水加太多煮成汤，蟹肉失去紧实口感。",
    "火候过猛不盖盖，蟹壳焦黑里面还生。"
  ],
  "substitutions": [
    {
      "original": "青蟹",
      "substitute": "梭子蟹",
      "ratio": "900g 对 900g",
      "note": "壳薄肉甜，煎制时间缩短 2 分钟。"
    },
    {
      "original": "料酒",
      "substitute": "米酒",
      "ratio": "40ml 对 45ml",
      "note": "酒味更柔，适合不爱重酒味者。"
    }
  ],
  "variations": [
    "粉丝版：锅底铺 100g 泡软粉丝同焖，粉丝吸汁极鲜。",
    "黑椒版：起锅前撒 3g 现磨黑胡椒，风味更西式。"
  ],
  "serving_suggestion": "原锅上桌，配一碗白米饭与一碟福建蒜蓉酱。",
  "storage": "建议现做现吃，冷藏不超过 1 天，复热需加少量水焖透。",
