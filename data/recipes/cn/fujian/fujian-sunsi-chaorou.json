  "steps": [
    {
      "n": 1,
      "text": "冬笋剥壳洗净，切成火柴棍粗细的细丝，越匀越好。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺着笋的纹理切，丝才不散不断。",
      "visual_cue": "笋丝细长均匀，断面白净"
    },
    {
      "n": 2,
      "text": "笋丝下开水锅焯两分钟，捞出沥干去掉涩味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "焯过的笋丝清甜，不焯会涩口扎嘴。",
      "visual_cue": "笋丝略软，水色微黄"
    },
    {
      "n": 3,
      "text": "猪里脊逆着纹理切成细丝，加生抽和黄酒抓匀腌一会儿。",
      "time_min": 5,
      "heat": "无火",
      "tip": "逆纹切口感才嫩，顺纹切就发柴。",
      "visual_cue": "肉丝松散，表面挂汁发黏"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，下肉丝大火快速滑散到变色盛出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "肉丝下锅先别急着翻，等定住再炒散。",
      "visual_cue": "肉丝根根分开，色转白"
    },
    {
      "n": 5,
      "text": "原锅下蒜片爆香，倒入笋丝大火翻炒，沿锅边淋少许清水。",
      "time_min": 3,
      "heat": "大火",
      "tip": "笋丝吸水，加点水才不会炒干发焦。",
      "visual_cue": "笋丝油亮，锅里有清香"
    },
    {
      "n": 6,
      "text": "倒回肉丝，加盐和白糖炒匀，撒葱段翻两下出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "肉丝最后回锅，炒久了就发柴，三十秒足够。",
      "visual_cue": "笋丝与肉丝分明，葱段翠绿"
    }
  ],
  "tips": [
    "笋丝切好先焯水，涩味去掉才清甜。",
    "肉丝逆纹切、大火滑炒，口感才嫩。",
    "回锅时火力要足，快炒三十秒即可。"
  ],
  "common_mistakes": [
    "笋丝切得太粗，炒不入味还夹生。",
    "肉丝小火慢炒，出水后变得又老又硬。",
    "全程不加水，笋丝贴着锅底炒焦发苦。"
  ],
  "substitutions": [
    {
      "original": "冬笋",
      "substitute": "茭白",
      "ratio": "300 克:300 克",
      "note": "水分更多，需减少加水量并缩短炒制时间。"
    },
    {
      "original": "猪里脊",
      "substitute": "鸡腿肉",
      "ratio": "150 克:180 克",
      "note": "去骨切丝，腌时加少许油防粘。"
    }
  ],
  "variations": [
    "加几段干辣椒同炒，多了湘赣式的辣香。",
    "用咸肉丝代替里脊，咸鲜味更重需减盐。"
  ],
  "serving_suggestion": "热吃最香，配一碗白米饭或拌面都很下饭。",
  "storage": "冷藏一天，复热用炒锅大火快翻，别久煮。",
