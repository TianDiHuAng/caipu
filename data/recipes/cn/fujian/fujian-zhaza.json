    "蒸锅",
    "盆",
    "锅",
    "漏勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红薯去皮切成厚片，上锅大火蒸十五分钟至用筷子一戳就烂。",
      "time_min": 15,
      "heat": "大火",
      "tip": "红心红薯甜度高、水分足，成品更软。",
      "visual_cue": "薯片边缘开裂，一压就散。"
    },
    {
      "n": 2,
      "text": "趁热把红薯压成泥，加白糖搅到糖完全化开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "趁热加糖才化得开，凉了会起沙粒。",
      "visual_cue": "薯泥细腻发亮，尝起来甜匀。"
    },
    {
      "n": 3,
      "text": "分三次加入糯米粉，揉成光滑不粘手的面团，软硬像耳垂。",
      "time_min": 10,
      "heat": "无火",
      "tip": "粉分次加，看湿度增减，太干可加一勺温水。",
      "visual_cue": "面团不裂不粘，按下去有浅坑。"
    },
    {
      "n": 4,
      "text": "面团搓成手指粗的小长条，表面滚一层黑芝麻，静置五分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "滚芝麻前把手沾点水，芝麻才粘得牢。",
      "visual_cue": "条身均匀，芝麻铺满不掉。"
    },
    {
      "n": 5,
      "text": "花生油烧到六成热，下枣坯小火慢炸，浮起后勤翻动。",
      "time_min": 8,
      "heat": "小火",
      "tip": "油温别高，外皮焦了里面还没熟。",
      "visual_cue": "枣坯浮起膨胀，油面细泡不断。"
    },
    {
      "n": 6,
      "text": "炸到表皮金黄鼓起捞出，控油两分钟再装盘，趁热吃最香。",
      "time_min": 8,
      "heat": "中火",
      "tip": "出锅后颜色还会加深，别炸过头。",
      "visual_cue": "外壳金黄硬脆，敲着有声。"
    }
  ],
  "tips": [
    "红薯泥的水分决定粉量，同品牌红薯吸水差别很大，边揉边看。",
    "炸枣要小火慢炸，火大外壳硬、内心生。",
    "炸好放凉会回软，想保持脆感可以复炸十秒。"
  ],
  "common_mistakes": [
    "红薯泥太湿就猛加粉，成品硬得像石头。",
    "油温过高下锅，外皮立刻焦黑，里面还是生的。"
  ],
  "substitutions": [
    {
      "original": "红薯",
      "substitute": "南瓜",
      "ratio": "400g 对 420g",
      "note": "南瓜水分更多，糯米粉要加到 300g 左右。"
    }
  ],
  "variations": [
    "闽南人过年炸枣会包一小块豆沙或花生糖做馅，炸好裂开露出甜心，孩子最爱。"
  ],
  "serving_suggestion": "出锅稍凉就吃，外脆内软，配一杯铁观音解甜。",
  "storage": "常温放一天，冷藏三天，复热用一百八十度烤五分钟恢复脆壳。",
