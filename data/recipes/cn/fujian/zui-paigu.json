  "equipment": [
    "炒锅",
    "油温计",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切 3cm 方块，加 3g 盐、10ml 生抽与蒜末抓匀腌 10 分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "肉块大小一致才能同时炸透，切时可先修成长方条。",
      "visual_cue": "肉块表面微微发黏、调味均匀"
    },
    {
      "n": 2,
      "text": "面粉、玉米淀粉、蛋黄加 60ml 清水调成稠糊，把肉块逐块裹匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糊要能挂住肉块不滴落，太稀会脱浆。",
      "visual_cue": "肉块表面挂一层均匀厚浆"
    },
    {
      "n": 3,
      "text": "锅中倒入 270ml 植物油烧至 170℃，下肉块中火炸 3 分钟至浅黄捞出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "分批下锅，油温才不会骤降导致脱浆。",
      "visual_cue": "外壳定型微黄、肉块浮起"
    },
    {
      "n": 4,
      "text": "油温升至 190℃ 复炸 40 秒至金黄酥脆，捞出沥油。",
      "time_min": 1,
      "heat": "大火",
      "tip": "复炸是酥脆的关键，时间短但油温必须够。",
      "visual_cue": "外壳金黄硬脆，敲击有响声"
    },
    {
      "n": 5,
      "text": "锅留 15ml 底油，下番茄酱、白糖与 60ml 清水小火熬至起泡，加 10ml 生抽与剩余淀粉水勾薄芡。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芡汁要能挂住勺背但能流动，太稠会结块。",
      "visual_cue": "酱汁红亮浓稠、勺背挂一层薄膜"
    },
    {
      "n": 6,
      "text": "倒入肉块快速翻匀，沿锅边淋香醋，撒葱花立即出锅。",
      "time_min": 1,
      "heat": "中火",
      "tip": "醋最后放，酸香才冲；翻匀时间过长外壳会软。",
      "visual_cue": "每块肉均匀裹汁、醋香扑鼻"
    }
  ],
  "tips": [
    "肉块腌好后可冷藏 30 分钟，炸制时更不易脱浆。",
    "番茄酱与糖醋比例约 2:1:1，可按口味微调。",
    "炸好的肉块可提前完成，上桌前再复炸裹汁。"
  ],
  "common_mistakes": [
    "肉块裹糊后放置太久，糊层回软，炸出来不酥。",
    "油温不足就下锅，肉块吸油，成品油腻发软。",
    "芡汁收得过干，裹不上肉块，盘底只剩糖块。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡腿肉",
      "ratio": "400g 里脊 ≈ 400g 鸡腿肉",
      "note": "鸡肉更嫩，炸制时间减到 2 分半。"
    },
    {
      "original": "番茄酱",
      "substitute": "山楂酱",
      "ratio": "45g 番茄酱 ≈ 50g 山楂酱",
      "note": "酸味更果香，糖可减 5g。"
    }
  ],
  "variations": [
    "家庭简化版：肉块用空气炸锅 200℃ 烤 12 分钟，再裹汁，省油且不易失败。",
    "福州传统版：不加番茄酱，用糖、醋、酱油调「糖醋醉汁」，颜色偏褐。"
  ],
  "serving_suggestion": "热食为菜，凉后当冷盘也香；配白米饭或作为宴客冷盘。",
  "storage": "冷藏 2 天，复热用 180℃ 烤箱 5 分钟恢复脆度，不建议微波。",
