  "equipment": [
    "平底锅",
    "盆",
    "锅",
    "锅铲",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加一小撮盐与清水，揉成偏软的面团，盖上湿布醒半小时。",
      "time_min": 9,
      "heat": "无火",
      "tip": "面要和得比饺子面软，抹皮才挂得住。",
      "visual_cue": "面团光滑，按下去回弹慢。"
    },
    {
      "n": 2,
      "text": "面团反复摔打上劲，抓在手里能整块提起不往下淌。",
      "time_min": 8,
      "heat": "无火",
      "tip": "摔打到位，饼皮才能又薄又不破。",
      "visual_cue": "面团拉长不断，手感发黏。"
    },
    {
      "n": 3,
      "text": "平底锅烧到温热，抓一团面在锅面快速抹一圈又提起，烙出半透明薄饼皮。",
      "time_min": 9,
      "heat": "小火",
      "tip": "锅太热皮立刻定形抹不开，温热最好。",
      "visual_cue": "饼皮薄透，边缘微微卷起。"
    },
    {
      "n": 4,
      "text": "花生油煸香五花肉丝，加胡萝卜丝、卷心菜丝与豆腐干丝炒软，用生抽与盐调味。",
      "time_min": 10,
      "heat": "中火",
      "tip": "菜馅要炒到不出水，包的时候才不漏。",
      "visual_cue": "馅料软塌，锅底无汤。"
    },
    {
      "n": 5,
      "text": "豆芽焯十秒捞出挤干，紫菜剪碎，花生炒香碾碎拌上白糖。",
      "time_min": 6,
      "heat": "大火",
      "tip": "花生糖是润饼的灵魂，甜咸要撞得开。",
      "visual_cue": "花生碎拌糖，颗粒分明。"
    },
    {
      "n": 6,
      "text": "饼皮摊平铺上菜馅与豆芽，撒花生糖、紫菜与香菜，从下往上卷紧。",
      "time_min": 8,
      "heat": "无火",
      "tip": "菜别放太多，卷得紧一点才咬得利落。",
      "visual_cue": "卷成粗条，两头不漏。"
    }
  ],
  "tips": [
    "饼皮抹锅要快，手一停下来皮就厚薄不均。",
    "润饼的菜馅讲究炒得干，汤水多会把饼皮泡烂。",
    "花生糖、紫菜、香菜三样别省，缺一味就不像润饼了。"
  ],
  "common_mistakes": [
    "面团和得太硬，抹锅时一拉就断成两截。",
    "菜馅带汤直接包，饼皮两分钟就软塌。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "春卷皮",
      "ratio": "现成皮 12 张",
      "note": "用现成皮省去抹锅，但口感略硬，可先蒸一分钟回软。"
    }
  ],
  "variations": [
    "泉州润饼的另一派做法会加炒海苔丝与蛋皮丝，甜口还会放冬瓜糖与油酥，一卷能吃到七八种味。"
  ],
  "serving_suggestion": "卷好即食，配一碗清汤或热茶解腻。",
  "storage": "饼皮冷藏三天，菜馅当日吃完，卷好的润饼不要久放。",
