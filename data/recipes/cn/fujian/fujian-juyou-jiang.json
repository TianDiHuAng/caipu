  "equipment": [
    "小锅",
    "刀",
    "砧板",
    "碗",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "橘皮用刀片去内侧白色瓤层，切成细丝，泡清水十分钟去苦味。",
      "time_min": 8,
      "heat": "无火",
      "tip": "白瓤是苦味来源，片得越干净成品越香。",
      "visual_cue": "橘皮丝薄透，泡水后微微发亮。"
    },
    {
      "n": 2,
      "text": "橘皮丝下沸水焯一分钟，捞出用冷水冲凉后沥干。",
      "time_min": 3,
      "heat": "大火",
      "tip": "焯一遍能去掉涩口，也让皮丝更软。",
      "visual_cue": "皮丝颜色转深，摸起来柔韧。"
    },
    {
      "n": 3,
      "text": "生抽、清水与白糖倒进小锅，小火煮到糖完全化开，放橘皮丝煮两分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "火别开大，白糖一焦整锅酱都会带苦味。",
      "visual_cue": "酱汁微稠，橘皮丝浮在表面。"
    },
    {
      "n": 4,
      "text": "关火后加香醋与蒜末搅匀，淋香油，放凉后装瓶冷藏。",
      "time_min": 4,
      "heat": "无火",
      "tip": "醋要关火后再加，橘香与酸香才留得住。",
      "visual_cue": "酱色琥珀，闻着橘香带酸。"
    }
  ],
  "tips": [
    "橘皮选薄皮的砂糖橘或本地红橘，厚皮发苦。",
    "橘油酱在闽南多用来蘸白灼海鲜与炸物，解腻又开胃。",
    "做好的酱放一夜更入味，橘皮会变得柔软。"
  ],
  "common_mistakes": [
    "橘皮白瓤没片净，成品苦得没法入口。",
    "白糖熬过了头变成焦糖色，整锅酱都会带上糊味。"
  ],
  "substitutions": [
    {
      "original": "橘皮",
      "substitute": "柠檬皮",
      "ratio": "60g 对 60g",
      "note": "柠檬皮更酸，糖要加到三十克平衡。"
    }
  ],
  "variations": [
    "漳州人做橘油酱会加一小勺辣椒酱，酸甜里带辣，蘸炸五香卷最对味。"
  ],
  "serving_suggestion": "装小碟蘸白灼虾、炸五香或白切肉，也可淋在凉拌菜上。",
  "storage": "密封冷藏两周，取用用干净勺，避免生水混入。",
