    "砧板",
    "玻璃瓶"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆豉用刀略剁碎，小米辣切成圈，蒜剥皮切成细末。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆豉别剁成泥，留一半颗粒口感更好。",
      "visual_cue": "豆豉碎粒分明，蒜末细匀。"
    },
    {
      "n": 2,
      "text": "花生油烧到五成热，下豆豉小火慢炒到香味出来、油色变深。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火炒豆豉才不糊，糊了整锅发苦。",
      "visual_cue": "锅里冒小泡，豆豉香冲鼻。"
    },
    {
      "n": 3,
      "text": "加蒜末与小米辣圈炒半分钟，倒入生抽与白糖炒匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜末要后放，炒久了会发苦、口感发硬。",
      "visual_cue": "蒜末微黄，辣味散出。"
    },
    {
      "n": 4,
      "text": "加清水小半碗，小火煮三分钟收浓，放凉后装瓶冷藏。",
      "time_min": 5,
      "heat": "小火",
      "tip": "收浓到能挂住勺子，太稀的酱容易变质。",
      "visual_cue": "酱体浓稠油亮，铲起缓慢滴落。"
    }
  ],
  "tips": [
    "豆豉本身很咸，生抽要少放，尝过再补。",
    "油要盖过酱面，既能延长保存也让香气更足。",
    "蒸排骨、蒸鱼、拌面时挖一勺就够味了。"
  ],
  "common_mistakes": [
    "豆豉没剁开整粒下锅，炒不透还有硬芯。",
    "火大把豆豉炒糊，苦味压过豆香。"
  ],
  "substitutions": [
    {
      "original": "豆豉",
      "substitute": "豆瓣酱",
      "ratio": "120g 对 100g",
      "note": "豆瓣酱含辣椒与盐，小米辣要减半。"
    }
  ],
  "variations": [
    "闽南家庭的豆豉酱会加一勺虾米碎同炒，鲜味更足，用来蒸鱼连汤都想拌饭。"
  ],
  "serving_suggestion": "装瓶冷藏，蒸鱼、蒸排骨、拌面时挖一勺，也可直接配白粥。",
  "storage": "油封冷藏可放一个月，取用用干勺，避免生水。",
