  "steps": [
    {
      "n": 1,
      "text": "五花肉连皮切成半厘米的小丁，鸡蛋煮熟剥壳备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切小丁比绞肉更有嚼头，卤出来油亮不散。",
      "visual_cue": "肉丁大小均匀，肥瘦相连"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下五花肉丁小火煸十分钟，煸到出油微黄。",
      "time_min": 10,
      "heat": "小火",
      "tip": "煸出油是卤肉饭不腻的关键，煸到肉丁缩小发黄。",
      "visual_cue": "肉丁微卷出油，锅底油层清亮"
    },
    {
      "n": 3,
      "text": "加冰糖炒化，再下蒜末、姜片与香菇丁炒香，烹入米酒。",
      "time_min": 4,
      "heat": "中火",
      "tip": "冰糖炒化能挂色，卤出来的肉才红亮诱人。",
      "visual_cue": "糖色红亮裹肉，香气散出"
    },
    {
      "n": 4,
      "text": "加生抽、老抽、五香粉与开水没过肉丁，放入白煮蛋烧开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "一定加开水，冷水下锅肉会紧缩发柴。",
      "visual_cue": "汤汁深褐翻滚，蛋面沾满酱汁"
    },
    {
      "n": 5,
      "text": "转入砂锅小火卤四十五分钟，中途翻两次让蛋均匀上色。",
      "time_min": 47,
      "heat": "小火",
      "tip": "保持小火慢慢卤，肉里的胶质才会融进汤汁，浇在饭上才挂得住不渗干。",
      "visual_cue": "肉丁酥软，汤汁浓稠起泡"
    },
    {
      "n": 6,
      "text": "大火收汁到略稠，试味补盐，把热米饭盛进碗里，浇上卤肉与卤蛋，撒葱花香菜。",
      "time_min": 4,
      "heat": "大火",
      "tip": "最后的汁不要收得太干，浇饭全靠这一勺浓汁，收干了饭就发柴。",
      "visual_cue": "卤汁油亮浓稠，浇在饭上不马上渗干"
    }
  ],
  "tips": [
    "五花肉选肥瘦三层分明的，纯瘦肉卤出来发柴不香。",
    "加一勺红葱酥同卤，是闽南卤肉饭的灵魂香气。",
    "卤一锅分装冷冻，随取随热，比现做更入味。"
  ],
  "common_mistakes": [
    "肉丁煸得不够，卤出来满嘴油，吃两口就腻。",
    "老抽下手太重，卤肉黑得发苦，卖相全无。",
    "大火卤半小时就出锅，肉还硬，汁也不浓。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "500克:500克",
      "note": "前腿较瘦，须多放十毫升植物油。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "20克:18克",
      "note": "白糖上色更快，须看紧火候。"
    }
  ],
  "variations": [
    "加一把笋丁同卤，口感更丰富，是闽南山区的做法。",
    "把米饭换成面条，浇上卤肉就是闽南卤肉面。"
  ],
  "serving_suggestion": "热饭浇卤肉，配一颗卤蛋与一勺汤汁，是最经典的吃法。",
  "storage": "冷藏可存三天，冷冻可存两周，复热须加少量水小火煮开。",
