  "steps": [
    {
      "n": 1,
      "text": "草鱼去鳞去内脏冲洗干净，片下两侧净肉，剔净鱼刺与发红的鱼肉。",
      "time_min": 20,
      "heat": "无火",
      "tip": "红肌腥味重，宁可少取肉也要剔干净。",
      "visual_cue": "鱼肉片完整，摸不到硬刺。"
    },
    {
      "n": 2,
      "text": "鱼肉用刀背反复剁成细泥，中途用手掌按压挑出残留小刺。",
      "time_min": 15,
      "heat": "无火",
      "tip": "刀背剁比刀刃切更细，成品才弹。",
      "visual_cue": "鱼泥发白细腻，按压无硬点。"
    },
    {
      "n": 3,
      "text": "五花肉剁成肉泥，葱姜切末用温水泡出葱姜水备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "葱姜水比直接放末更均匀，也不留渣。",
      "visual_cue": "葱姜水微黄，肉泥松散。"
    },
    {
      "n": 4,
      "text": "鱼泥加盐顺一个方向搅打，分三次打入葱姜水，打到发黏上劲。",
      "time_min": 15,
      "heat": "无火",
      "tip": "上劲是关键，筷子插入不倒才算打好。",
      "visual_cue": "鱼泥抱团发亮，盆壁挂得住。"
    },
    {
      "n": 5,
      "text": "加入五花肉泥、鸡蛋、红薯淀粉、白糖与白胡椒粉拌匀，最后淋花生油锁润。",
      "time_min": 10,
      "heat": "无火",
      "tip": "淀粉别一次倒完，边拌边看稠度再增减。",
      "visual_cue": "混合浆稠厚，能挤成圆条不塌。"
    },
    {
      "n": 6,
      "text": "鱼浆铺在保鲜膜上，卷成手腕粗的圆条，两端扎紧收口。",
      "time_min": 10,
      "heat": "无火",
      "tip": "卷的时候边卷边压，排出空气才紧实。",
      "visual_cue": "圆条粗细一致，表面无气泡。"
    },
    {
      "n": 7,
      "text": "水开后中火蒸二十分钟，关火焖五分钟再取出放凉。",
      "time_min": 25,
      "heat": "中火",
      "tip": "水开后再放，冷水上锅会让鱼卷塌散。",
      "visual_cue": "鱼卷触感弹手，按压回弹。"
    },
    {
      "n": 8,
      "text": "放凉后拆开保鲜膜切厚片，可直接吃，也可下锅煎到两面金黄。",
      "time_min": 10,
      "heat": "中火",
      "tip": "热切会散，放凉再切才能片片完整。",
      "visual_cue": "切面细密，片上不见孔洞。"
    }
  ],
  "tips": [
    "草鱼要挑三斤以上的，肉厚出浆多，腥味也轻。",
    "打浆时加一勺猪肥膘，成品更润，这是崇武老手艺。",
    "蒸好的鱼卷冷藏过夜再切，片形更漂亮。"
  ],
  "common_mistakes": [
    "鱼肉没剔净刺，打浆后刺更碎，吃起来扎嘴。",
    "浆没上劲就下锅，蒸好一切就散成渣。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "海鳗鱼",
      "ratio": "700g 对 650g",
      "note": "用海鳗要减少葱姜水，鳗鱼肉本身出水多。"
    }
  ],
  "variations": [
    "惠安崇武的鱼卷常加一小块荸荠碎，咬下去有清脆的层次，是当地桌席的冷盘常客。"
  ],
  "serving_suggestion": "切片摆盘直接吃，或煎香后配蒜泥醋，也是下酒的好东西。",
  "storage": "冷藏三天，冷冻可放一个月，复热用蒸锅或平底锅回温，不要久煮。",
