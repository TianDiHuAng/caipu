  "steps": [
    {
      "n": 1,
      "text": "虾仁沿背部划开一刀，挑出黑色泥线，冲洗干净后沥干水分备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泥线不挑会有泥腥味，沿背部划一刀就能整条挑出。",
      "visual_cue": "虾仁干净透亮，背部开口整齐，捏起来有弹性。"
    },
    {
      "n": 2,
      "text": "虾仁加料酒、姜末与少许盐抓匀，静置十分钟去腥。",
      "time_min": 10,
      "heat": "无火",
      "tip": "抓拌时手上带点力，虾仁才紧实，也不容易碎。",
      "visual_cue": "虾仁表面裹上薄浆，颜色转半透明。"
    },
    {
      "n": 3,
      "text": "鸡蛋打进大碗，加盐与白胡椒粉，用筷子充分打散。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打蛋要打到蛋液完全顺滑，不见成块蛋白。",
      "visual_cue": "蛋液橙黄均匀，表面浮起细泡。"
    },
    {
      "n": 4,
      "text": "蛋液按一比一点五加温水搅匀，再过筛两遍滤去泡沫。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用温水不是凉水，蒸出来才细嫩不分层。",
      "visual_cue": "碗中蛋液平滑，看不到明显泡沫。"
    },
    {
      "n": 5,
      "text": "蛋液盖上保鲜膜，放进上汽的蒸锅中小火蒸八分钟。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "先蒸蛋后放虾仁，虾仁才不会被蒸老发硬。",
      "visual_cue": "蛋面平滑凝固，轻晃碗有微颤。"
    },
    {
      "n": 6,
      "text": "揭膜摆上腌好的虾仁，重新盖好再蒸五分钟至虾仁变红。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "虾仁铺平不重叠，受热才均匀一致，不会一半老一半生。",
      "visual_cue": "虾仁卷曲变红，蛋面仍然细嫩。"
    },
    {
      "n": 7,
      "text": "出锅淋生抽与香油，撒上葱花，趁热端上桌吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调味最后做，先放生抽会把蛋面压出坑。",
      "visual_cue": "酱汁在蛋面铺开，葱花香扑鼻。"
    }
  ],
  "tips": [
    "蛋水比例一比一点五，蒸出来嫩得能晃，但不会散。",
    "过筛两遍是镜面蛋羹的关键，泡沫一定要滤掉。",
    "虾仁不要一开始就下，后半程再放才不会老成橡皮。"
  ],
  "common_mistakes": [
    "蛋液不盖保鲜膜直接蒸，水汽滴进去表面全是麻点。",
    "大火猛蒸，蛋羹起大孔出水，口感粗糙像海绵。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鲜贝",
      "ratio": "120g 对 120g",
      "note": "鲜贝同样最后五分钟放入，蒸久了会缩水发硬。"
    }
  ],
  "variations": [
    "闽南人家会在蛋液里加一勺高汤替代清水，鲜味更浓，也更像宴席上的做法。"
  ],
  "serving_suggestion": "趁热用小勺挖着吃，配粥或配米饭都合适，孩子尤其喜欢。",
  "storage": "冷藏一天内吃完，复蒸五分钟回温，不要微波以免蛋羹出水。",
