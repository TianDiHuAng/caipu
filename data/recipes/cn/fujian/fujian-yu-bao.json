  ],
  "steps": [
    {
      "n": 1,
      "text": "芋头去皮切大块，上锅大火蒸二十分钟，筷子能轻松插透即可。",
      "time_min": 20,
      "heat": "大火",
      "tip": "戴手套削芋头，黏液沾到手上会发痒。",
      "visual_cue": "芋块边缘发虚，一插就透。"
    },
    {
      "n": 2,
      "text": "趁热把芋头压成细泥，加红薯淀粉与少许盐，揉成不粘手的面团。",
      "time_min": 15,
      "heat": "无火",
      "tip": "芋泥要趁热揉，凉了淀粉抱不成团。",
      "visual_cue": "面团光滑，按下去缓慢回弹。"
    },
    {
      "n": 3,
      "text": "干香菇泡发切末，虾米剁碎，冬菜洗净切细，葱切成葱花。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冬菜咸，洗一遍再切，免得成品过咸。",
      "visual_cue": "配料各自分装，香菇末干爽。"
    },
    {
      "n": 4,
      "text": "花生油下锅炒香葱花、香菇末、虾米与冬菜，再下猪肉馅炒散。",
      "time_min": 8,
      "heat": "中火",
      "tip": "馅要炒到出香出油，包进去才不寡淡。",
      "visual_cue": "肉馅粒粒分明，锅底见油。"
    },
    {
      "n": 5,
      "text": "加生抽、白糖与白胡椒粉炒匀成馅，盛出摊开放凉。",
      "time_min": 5,
      "heat": "小火",
      "tip": "馅太烫会烫熟芋泥皮，一定要放凉。",
      "visual_cue": "馅料油润发亮，不见汤汁。"
    },
    {
      "n": 6,
      "text": "芋泥面团分成十份，压成圆片包入馅料，收口捏成半月形。",
      "time_min": 20,
      "heat": "无火",
      "tip": "皮别压太薄，一厘米左右才不破。",
      "visual_cue": "半月形饱满，收口捏出褶。"
    },
    {
      "n": 7,
      "text": "蒸屉刷一层花生油，摆入芋包，大火蒸十五分钟至表皮透亮。",
      "time_min": 15,
      "heat": "大火",
      "tip": "芋包之间留缝，蒸后发胀会粘在一起。",
      "visual_cue": "表皮由灰转透亮，轻按有弹性。"
    }
  ],
  "tips": [
    "槟榔芋淀粉多、香味浓，做芋包比普通芋头更粉糯。",
    "芋泥里加淀粉是为了黏合，加多了会硬，揉到不粘手就停。",
    "包好后可冷冻，蒸之前不用解冻，多蒸五分钟。"
  ],
  "common_mistakes": [
    "芋泥没趁热揉，淀粉拌不开，蒸出来有硬粒。",
    "馅料带汤水就包，破口流汁，一屉都糊。"
  ],
  "substitutions": [
    {
      "original": "猪肉馅",
      "substitute": "香菇笋丁",
      "ratio": "150g 对 180g",
      "note": "纯素版本要加一勺生抽与半勺糖补味。"
    }
  ],
  "variations": [
    "厦门老摊会在芋包里塞半颗卤鹌鹑蛋，切开来有惊喜，也有人加一小块咸蛋黄。"
  ],
  "serving_suggestion": "出屉趁热吃，配甜辣酱或蒜泥酱油，凉了皮会变韧。",
  "storage": "冷藏两天，冷冻两周，复蒸十分钟至中心烫手即可。",
