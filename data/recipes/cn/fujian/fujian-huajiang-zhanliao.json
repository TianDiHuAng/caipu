  "equipment": [
    "碗",
    "研钵",
    "干锅",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花生仁放干锅小火炒到表皮发红，倒出摊凉后搓掉薄皮。",
      "time_min": 6,
      "heat": "小火",
      "tip": "花生一定要放凉再搓皮，热的时候皮撕不干净。",
      "visual_cue": "花生仁表面透红，皮一搓就掉。"
    },
    {
      "n": 2,
      "text": "去皮花生仁放进研钵，加一小撮盐捣成带颗粒的粗碎。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别捣成粉，留一点粗颗粒嚼起来才香。",
      "visual_cue": "碎粒大小不一，能闻到花生香。"
    },
    {
      "n": 3,
      "text": "花生酱舀进碗里，加温开水分三次调开，搅到顺滑能流动。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水分三次加，一次倒多了酱会结成硬块。",
      "visual_cue": "酱体顺滑，舀起能连成线。"
    },
    {
      "n": 4,
      "text": "调入生抽、白糖与香油搅匀，撒花生碎与小米辣圈，静置五分钟入味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置这步别省，糖化开后咸甜才匀。",
      "visual_cue": "酱面浮着花生碎，闻着有辣香。"
    }
  ],
  "tips": [
    "花生酱选带颗粒的，比纯滑的更香也更有口感。",
    "调酱要用温开水，冷水一搅就抱成团搅不开。",
    "蘸白灼肉、拌面、配春卷都合适，闽南人桌上常备一小碟。"
  ],
  "common_mistakes": [
    "水一次全倒进去，花生酱立刻结成疙瘩。",
    "糖没化开就上桌，吃着有沙粒感。"
  ],
  "substitutions": [
    {
      "original": "花生酱",
      "substitute": "芝麻酱",
      "ratio": "120g 对 120g",
      "note": "芝麻酱更稠，水要加到八十毫升才调得开。"
    }
  ],
  "variations": [
    "厦门街头的小碟花生酱会加一勺甜辣酱，甜中带辣，蘸白灼章鱼、白灼虾都很搭。"
  ],
  "serving_suggestion": "装小碟上桌，配白灼海鲜、春卷或拌面，用前搅一搅。",
  "storage": "密封冷藏一周，用前搅匀；表面析出的油是正常现象。",
