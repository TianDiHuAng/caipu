  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "芋头",
          "name_en": "taro",
          "amount": 500,
          "unit": "g",
          "note": "选粉糯的槟榔芋",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 60,
          "unit": "ml",
          "note": "调节稠度",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "炒制顺滑",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提味少许",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "压泥器",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芋头去皮切成两厘米厚的片，整齐摆在蒸架上。",
      "time_min": 12,
      "heat": "无火",
      "tip": "去皮时戴手套，芋头汁会让手发痒。",
      "visual_cue": "芋头片厚薄均匀、断面洁白"
    },
    {
      "n": 2,
      "text": "蒸锅水开后放入芋头，大火蒸二十分钟至用筷子轻松插入。",
      "time_min": 22,
      "heat": "大火",
      "tip": "一定要蒸到软烂，压泥才细腻。",
      "visual_cue": "芋头片一戳即透、边缘开裂"
    },
    {
      "n": 3,
      "text": "趁热用压泥器把芋头压成细泥，挑掉硬块与粗纤维。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁热压泥，冷了就压不细。",
      "visual_cue": "芋泥细腻无颗粒、手感绵软"
    },
    {
      "n": 4,
      "text": "炒锅下植物油，倒入芋泥与白糖、盐，小火不断翻炒。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火慢炒，糖分高容易焦底。",
      "visual_cue": "芋泥逐渐变得油亮顺滑"
    },
    {
      "n": 5,
      "text": "分两次淋入牛奶，边加边炒至芋泥能堆成小山不塌。",
      "time_min": 5,
      "heat": "小火",
      "tip": "牛奶分次加，一次加多会稀。",
      "visual_cue": "芋泥抱团、铲起不滴落"
    },
    {
      "n": 6,
      "text": "盛入碗中抹平表面，撒少许白糖入蒸锅复蒸五分钟即可。",
      "time_min": 7,
      "heat": "大火",
      "tip": "复蒸一次，表面糖化更香。",
      "visual_cue": "表面油润发亮、热气腾腾"
    }
  ],
  "tips": [
    "选槟榔芋，粉糯起沙，做芋泥最合适。",
    "处理芋头戴一次性手套，避免手部发痒。",
    "炒制全程小火，芋泥含糖多，极易糊锅。"
  ],
  "common_mistakes": [
    "芋头没蒸透就压泥，成品带硬颗粒。",
    "牛奶一次全倒入，芋泥稀得堆不起来。",
    "炒制时火太大，锅底结一层焦黑。"
  ],
  "substitutions": [
    {
      "original": "芋头",
      "substitute": "红薯",
      "ratio": "500g 对 500g",
      "note": "甜味更重，白糖减二十克。"
    },
    {
      "original": "牛奶",
      "substitute": "椰奶",
      "ratio": "60ml 对 60ml",
      "note": "椰香更浓，风味偏南洋。"
    }
  ],
  "variations": [
    "拌入炒香的白芝麻与少量熟油，香气更足。",
    "把芋泥包进酥皮里油炸，就是闽南的芋泥酥。"
  ],
  "serving_suggestion": "趁热吃最香，配一壶铁观音解甜。",
  "storage": "冷藏可放两天，复蒸五分钟回软。",
