  "steps": [
    {
      "n": 1,
      "text": "虾仁挑去背部的泥肠，用清水冲两遍，捞出沥干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泥肠不挑干净，炒出来的虾仁发苦还带沙。",
      "visual_cue": "虾仁背部干干净净，手感干爽不滑。"
    },
    {
      "n": 2,
      "text": "虾仁加盐、料酒与鸡蛋清抓匀，再拌入玉米淀粉上浆。",
      "time_min": 7,
      "heat": "无火",
      "tip": "抓的时候轻一点，虾肉碎了口感就散了。",
      "visual_cue": "每只虾仁都挂上一层薄白浆。"
    },
    {
      "n": 3,
      "text": "静置十分钟让虾仁吃透浆水，天热时放冰箱更稳。",
      "time_min": 10,
      "heat": "无火",
      "tip": "上浆后静置这一步不能省，滑炒时才不脱浆。",
      "visual_cue": "虾仁表面由湿转亮，浆层贴合。"
    },
    {
      "n": 4,
      "text": "炒锅烧热下花生油，油温四成热时下虾仁滑散。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油温太高浆会立刻结壳，里面却还没熟透。",
      "visual_cue": "虾仁在油里轻轻浮起，边缘泛白。"
    },
    {
      "n": 5,
      "text": "虾仁卷曲变色后立刻盛出，锅里留一点点底油。",
      "time_min": 2,
      "heat": "中火",
      "tip": "多炒十秒虾仁就老了，见到卷起立刻盛出。",
      "visual_cue": "虾仁卷成小弯弓，通体粉白透亮。"
    },
    {
      "n": 6,
      "text": "虾仁回锅，撒小葱段大火快翻两下，加盐调味出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "回锅只为裹上葱香，翻两下就够，别久炒。",
      "visual_cue": "葱段断生翠绿，虾仁表面油亮。"
    }
  ],
  "tips": [
    "虾仁买现剥的最好，冷冻的解冻后要用厨房纸吸干水。",
    "上浆加蛋清不加蛋黄，成品才清亮不发黄。",
    "滑炒油温宁可低一点，分两次下锅更保险。"
  ],
  "common_mistakes": [
    "虾仁不吸干水就上浆，浆挂不住，下锅全脱进油里。",
    "全程大火爆炒，虾仁表面焦里面生，口感发硬。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "河虾仁",
      "ratio": "1:1",
      "note": "河虾仁个头小，滑炒时间缩短到三十秒。"
    }
  ],
  "variations": [
    "福州酒楼版本会撒几粒熟豌豆同炒，配色清亮，口感更清甜。"
  ],
  "serving_suggestion": "装盘立即上桌，配白饭或拌面，虾仁凉了会回硬。",
  "storage": "冷藏一日内吃完，复热用小火快炒，别用蒸锅回软。",
