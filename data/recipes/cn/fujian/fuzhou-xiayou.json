  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "海米",
          "name_en": "dried shrimp",
          "amount": 400,
          "unit": "g",
          "note": "新鲜小虾晒制的干海米",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 30,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "大葱",
          "name_en": "Welsh onion",
          "amount": 40,
          "unit": "g",
          "note": "切段",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 15,
          "unit": "g",
          "note": "腌渍",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 200,
          "unit": "ml",
          "note": "调和基液",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "玻璃坛",
    "纱布",
    "汤锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "海米挑去杂鱼与杂质，用清水快速冲洗两遍后晾干表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冲洗要快，泡久了鲜味会流失。",
      "visual_cue": "海米松散不结块、手捏微干"
    },
    {
      "n": 2,
      "text": "海米拌入 15g 盐装入玻璃坛，压实后盖纱布，日晒发酵三天。",
      "time_min": 20,
      "heat": "无火",
      "tip": "坛口盖纱布透气，防虫又不会焐坏。",
      "visual_cue": "海米颜色转深、散发轻微发酵香"
    },
    {
      "n": 3,
      "text": "发酵好的海米倒入汤锅，加 200ml 生抽、姜片与葱段，小火浸煮 30 分钟。",
      "time_min": 35,
      "heat": "小火",
      "tip": "小火保温不沸腾，腥气才不会逼出来。",
      "visual_cue": "汁色深红、鲜香浓而不腥"
    },
    {
      "n": 4,
      "text": "煮好后关火浸泡 50 分钟，让海米的鲜味充分渗入酱油中。",
      "time_min": 55,
      "heat": "无火",
      "tip": "浸泡时间越久，鲜味越厚实。",
      "visual_cue": "酱汁挂壁、鲜香明显"
    },
    {
      "n": 5,
      "text": "用细纱布过滤掉海米与葱姜残渣，滤出的酱汁静置沉淀一夜。",
      "time_min": 30,
      "heat": "无火",
      "tip": "滤两遍，酱汁才够清亮。",
      "visual_cue": "液体透亮、底部有少量沉淀"
    },
    {
      "n": 6,
      "text": "取上层清液装瓶，密封冷藏，可作蘸料或炒菜的调味汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "装瓶前用开水烫过并晾干，能存更久。",
      "visual_cue": "瓶内清澈无悬浮物"
    }
  ],
  "tips": [
    "选个头小的干海米做酱汁，鲜味比大个的更集中。",
    "全程不加油，酱汁之名指的是虾的精华而非油脂。",
    "滤出的海米别扔，拌饭或炒青菜都很香。"
  ],
  "common_mistakes": [
    "海米没有晾干就腌，成品容易发酸变质。",
    "煮的时候大火翻滚，腥味被逼出整锅发臭。",
    "滤网孔太大，酱汁浑浊带渣，口感粗糙。"
  ],
  "substitutions": [
    {
      "original": "海米",
      "substitute": "小银鱼",
      "ratio": "400g 对 400g",
      "note": "鲜味更清甜，是闽东变体。"
    },
    {
      "original": "生抽",
      "substitute": "黄豆酱油",
      "ratio": "200ml 对 200ml",
      "note": "酱香更厚重，咸度略高需减盐。"
    }
  ],
  "variations": [
    "加蒜版：发酵时加 30g 蒜末，风味更冲。",
    "辣味版：加 20g 小米辣同浸，适合蘸海鲜。"
  ],
  "serving_suggestion": "作蘸料点白灼海鲜，或在炒芥蓝、炒面时加一勺提鲜。",
  "storage": "冷藏可存 3 个月，取用需用干燥勺子，避免生水污染。",
