  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成两厘米见方的块，用淡盐水浸泡几分钟去豆腥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "淡盐水泡过，豆腐更紧实不易碎。",
      "visual_cue": "豆腐块棱角完整，手感弹"
    },
    {
      "n": 2,
      "text": "香菇用温水泡软后切成小丁，泡香菇的水澄清备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡菇水是天然鲜味，别直接倒掉。",
      "visual_cue": "香菇软透，水色深黄"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，下豆腐块中火煎到表面微黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "一块块下锅，别一次倒进去挤在一起。",
      "visual_cue": "豆腐表面结皮，色浅金黄"
    },
    {
      "n": 4,
      "text": "把豆腐推边，下五花肉片煸出油，放蒜末和香菇丁炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉片煸出油，烧出来的豆腐才香。",
      "visual_cue": "肉片卷边，油清亮不浑"
    },
    {
      "n": 5,
      "text": "加生抽、老抽、白糖和泡菇水，再添清水，大火烧开。",
      "time_min": 2,
      "heat": "大火",
      "tip": "烧开后转小火，让豆腐慢慢吃味。",
      "visual_cue": "汤汁深红，咕嘟冒泡"
    },
    {
      "n": 6,
      "text": "转中小火盖盖烧到豆腐鼓胀入味，中途轻推一次防粘。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "用铲子托底推，别翻搅把豆腐戳烂。",
      "visual_cue": "豆腐鼓胀，筷子插有汁"
    },
    {
      "n": 7,
      "text": "加盐调味，撒葱段，收汁到浓稠挂勺即可出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "留一点汤汁拌饭最好，别收太干。",
      "visual_cue": "汤汁浓亮，豆腐表面油润"
    }
  ],
  "tips": [
    "豆腐用淡盐水泡过再煎，形状更完整。",
    "泡香菇的水代替清水，鲜味更自然。",
    "收汁留些汤汁，拌饭是精华所在。"
  ],
  "common_mistakes": [
    "用嫩豆腐直接下锅煎，一翻面就成碎渣。",
    "全程大火，汤汁烧干豆腐还没入味。",
    "调味过早放盐，豆腐出水变硬还不入味。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "火腿",
      "ratio": "60 克:45 克",
      "note": "咸鲜更强，盐量需减少一半。"
    },
    {
      "original": "香菇",
      "substitute": "干香菇脚",
      "ratio": "50 克:40 克",
      "note": "香气更浓，泡发时间延长十分钟。"
    }
  ],
  "variations": [
    "加几只虾干同烧，海味更足也更鲜甜。",
    "起锅前淋一勺葱油，香气更扑鼻也更亮。"
  ],
  "serving_suggestion": "连汁带豆腐浇在米饭上，是闽南人家最普通的家常味。",
  "storage": "冷藏两天，复热加少量水小火焖热，别用微波。",
