  "equipment": [
    "碗",
    "打蛋器",
    "锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进碗里，加盐与一勺温开水打散，打到蛋液表面起细泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "加一勺水蛋更嫩，打散要彻底不见蛋筋。",
      "visual_cue": "蛋液均匀，表面浮着细泡。"
    },
    {
      "n": 2,
      "text": "香糟加温开水调开成稀糊，小葱切成葱花备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香糟有颗粒，先调开才能均匀裹蛋。",
      "visual_cue": "糟糊顺滑，酒香散出。"
    },
    {
      "n": 3,
      "text": "花生油烧到六成热，倒蛋液，边缘凝固后用铲子推成大块。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要烧到够热，蛋液下锅才蓬松不粘底。",
      "visual_cue": "蛋块鼓起，边缘微黄。"
    },
    {
      "n": 4,
      "text": "蛋块刚凝固就倒糟糊，加生抽与白糖快速翻匀，让糟香裹住蛋块。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糟糊遇热容易糊底，这时要把火调小。",
      "visual_cue": "蛋块裹上浅褐色糟汁。"
    },
    {
      "n": 5,
      "text": "撒上葱花翻两下就出锅装盘，趁热吃糟香最足。",
      "time_min": 2,
      "heat": "小火",
      "tip": "葱花要最后放，清香才不会被炒散。",
      "visual_cue": "盘里蛋块油亮，葱绿点缀。"
    }
  ],
  "tips": [
    "香糟本身带酒味与咸味，生抽只要一点点提色。",
    "蛋不要炒得太老，嫩一点才吃得出糟香。",
    "闽南人做这道菜常配白粥，糟香配粥最顺口。"
  ],
  "common_mistakes": [
    "蛋炒老了再下糟，口感发柴像橡皮。",
    "糟糊下锅后大火猛炒，很快糊底发苦。"
  ],
  "substitutions": [
    {
      "original": "香糟",
      "substitute": "酒酿汁",
      "ratio": "40g 对 60ml",
      "note": "酒酿汁水分多，要先把蛋炒干一点再下。"
    }
  ],
  "variations": [
    "福州一带用红糟代替香糟，炒出来的蛋是漂亮的胭脂色，酒香更浓，是年节常见的家常菜。"
  ],
  "serving_suggestion": "盛盘趁热配白粥或米饭，也可夹馒头吃。",
  "storage": "冷藏一天，复热用小火轻推，不要微波以免变硬。",
