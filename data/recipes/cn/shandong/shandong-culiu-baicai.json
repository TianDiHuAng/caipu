  "steps": [
    {
      "n": 1,
      "text": "大白菜掰开洗净沥干，菜帮斜刀片成薄片，菜叶撕成大片，分两个盘装。",
      "time_min": 8,
      "heat": "无火",
      "tip": "帮叶分开下锅是关键，一起下帮还生、叶已烂。",
      "visual_cue": "菜帮薄而透光，菜叶成大片"
    },
    {
      "n": 2,
      "text": "大蒜切片，干辣椒剪成小段，玉米淀粉加两勺清水调成水淀粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水淀粉一定要现调现用，放久了淀粉沉底结成硬块。",
      "visual_cue": "水淀粉调匀，看不到干粉颗粒"
    },
    {
      "n": 3,
      "text": "花生油下锅烧到五成热，放蒜片和干辣椒段小火炒出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "干辣椒一变色就下菜，炒黑了整锅发苦。",
      "visual_cue": "蒜片边缘微黄，辣香飘出"
    },
    {
      "n": 4,
      "text": "先下白菜帮大火翻炒一分钟，再下白菜叶炒到叶子塌软出水。",
      "time_min": 6,
      "heat": "大火",
      "tip": "全程大火，火小了白菜会出一锅水，炒成炖菜。",
      "visual_cue": "菜帮半透明，菜叶塌软"
    },
    {
      "n": 5,
      "text": "沿锅边淋入香醋，加生抽、白糖和盐，大火翻匀让白菜裹上味汁。",
      "time_min": 4,
      "heat": "大火",
      "tip": "醋沿锅边淋才激得出香气，直接浇在菜上只剩酸味。",
      "visual_cue": "锅边冒白气，酸香扑鼻"
    },
    {
      "n": 6,
      "text": "淋入水淀粉勾薄芡，汤汁收紧后立刻关火装盘。",
      "time_min": 3,
      "heat": "中火",
      "tip": "勾芡后再补几滴香醋，酸味更有层次。",
      "visual_cue": "汤汁裹住菜叶，盘底不汪水"
    }
  ],
  "tips": [
    "白菜帮斜刀片薄，受热快也更挂汁。",
    "醋分两次放，一次炒香、一次提味，酸得有前有后。",
    "糖不能省，它把醋的尖酸磨圆，让咸酸更好入口。"
  ],
  "common_mistakes": [
    "菜帮菜叶一起下锅，帮还夹生叶已经炒成泥。",
    "醋一次全倒进锅里大火久煮，酸味挥发，成品只剩咸。",
    "不勾芡就起锅，盘底汪着半碗水，菜也挂不住味。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "30毫升:30毫升",
      "note": "米醋更清爽，酸味直白，糖可减到八克。"
    },
    {
      "original": "干辣椒",
      "substitute": "小米辣",
      "ratio": "5克:5克",
      "note": "想更辣就换新鲜小米辣，切圈后同样先炝锅。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同炒，吸汁后非常下饭。",
    "用猪油代替花生油，香气更足，是老派鲁菜的做法。"
  ],
  "serving_suggestion": "趁热装盘，配米饭或馒头都合适，作为大鱼大肉之后解腻的一道素菜上桌。",
  "storage": "冷藏可存一天，复热用大火快炒一分钟，别用微波炉，白菜会出水变软。",
