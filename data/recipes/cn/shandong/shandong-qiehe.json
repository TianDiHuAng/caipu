  "equipment": [
    "炒锅",
    "漏勺",
    "深碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净去蒂，切成两片相连的夹刀片，厚度约一厘米。",
      "time_min": 10,
      "heat": "无火",
      "tip": "两片之间不切断，才能夹住肉馅。",
      "visual_cue": "夹刀片成对相连、厚薄一致"
    },
    {
      "n": 2,
      "text": "猪肉末加葱花、生姜末、生抽、料酒、盐与白胡椒顺时针搅打上劲。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一直朝一个方向搅，肉馅才抱团。",
      "visual_cue": "肉馅黏稠上劲、能粘住筷子"
    },
    {
      "n": 3,
      "text": "把肉馅填进夹刀片中间，抹平表面，逐个做好摆在盘里。",
      "time_min": 10,
      "heat": "无火",
      "tip": "馅料不要填太满，炸时容易溢出。",
      "visual_cue": "茄盒饱满、边缘平整"
    },
    {
      "n": 4,
      "text": "面粉、玉米淀粉与鸡蛋液加清水调成浓稠的糊，静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糊静置一会儿，粉粒才能化开。",
      "visual_cue": "糊体细滑、能挂住筷子"
    },
    {
      "n": 5,
      "text": "茄盒逐个裹上调好的面糊，提起时抖掉多余的面糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "裹糊要匀，露出茄子会炸干。",
      "visual_cue": "茄盒被糊包裹、不见裸面"
    },
    {
      "n": 6,
      "text": "炒锅倒植物油烧到六成热，茄盒下锅中火炸四分钟至金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "下锅后先别翻动，等糊定型再翻。",
      "visual_cue": "外壳金黄、茄盒浮起"
    },
    {
      "n": 7,
      "text": "捞出沥油，植物油升温后再复炸四十秒，出锅撒盐即可。",
      "time_min": 4,
      "heat": "大火",
      "tip": "复炸让外壳更酥，内馅更紧实。",
      "visual_cue": "外壳酥脆有声、内馅熟透"
    }
  ],
  "tips": [
    "茄子选长条形嫩茄，籽少更绵软。",
    "肉馅里加一勺清水，炸出来更多汁。",
    "嫌油腻可以改用平底锅少油慢煎至两面金黄。"
  ],
  "common_mistakes": [
    "茄盒切得太厚，外壳焦了内馅还没熟。",
    "肉馅填得过满，下锅就胀破流汁。",
    "面糊调得太稀，炸出来挂不住皮还容易掉渣。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "虾仁",
      "ratio": "200g 对 200g",
      "note": "剁碎后更鲜，需补少许盐。"
    },
    {
      "original": "茄子",
      "substitute": "西葫芦",
      "ratio": "400g 对 400g",
      "note": "水分大，需先撒盐挤水。"
    }
  ],
  "variations": [
    "把炸好的茄盒下锅红烧，汁水更足。",
    "肉馅里加一点香菇末，鲜味更浓。"
  ],
  "serving_suggestion": "趁热吃外壳最脆，配椒盐或甜辣酱都行。",
  "storage": "冷藏可放两天，复炸或烤箱加热回脆。",
