  "equipment": [
    "汤锅",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲫鱼刮鳞去内脏，刮净腹腔黑膜，用料酒与姜片腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腹腔黑膜最腥，一定要刮干净。",
      "visual_cue": "鱼腹内壁洁白、无黑膜残留"
    },
    {
      "n": 2,
      "text": "用厨房纸把鱼身内外擦干，两面各划三刀方便入味。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鱼身擦干，煎时才不粘不溅。",
      "visual_cue": "鱼皮干爽、刀口整齐"
    },
    {
      "n": 3,
      "text": "汤锅下植物油烧热，鱼下锅中火煎到两面微黄定型。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煎透一面再翻，鱼皮才不破。",
      "visual_cue": "鱼皮金黄完整、锅底不粘"
    },
    {
      "n": 4,
      "text": "冲入沸水没过鱼身，加生姜片大火滚十分钟至汤色奶白。",
      "time_min": 12,
      "heat": "大火",
      "tip": "必须加开水，冷水一冲汤就不白了。",
      "visual_cue": "汤色乳白、鱼身完整"
    },
    {
      "n": 5,
      "text": "转中火再煮六分钟，加盐与白胡椒调味，撒葱花出锅。",
      "time_min": 7,
      "heat": "中火",
      "tip": "盐最后放，鱼肉才嫩。",
      "visual_cue": "汤面泛油光、葱绿点缀"
    }
  ],
  "tips": [
    "一定要冲沸水，汤色才奶白浓郁。",
    "鲫鱼刺多，喝汤时用细网筛过滤更安全。",
    "煎鱼时锅要热透再下油，鱼皮才完整。"
  ],
  "common_mistakes": [
    "加冷水煮汤，汤色清寡发灰，鲜味也出不来。",
    "鱼身没擦干就下锅，油花四溅鱼皮粘底。",
    "过早放盐，鱼肉紧缩发柴汤也不鲜。"
  ],
  "substitutions": [
    {
      "original": "鲫鱼",
      "substitute": "鲈鱼",
      "ratio": "500g 对 600g",
      "note": "刺少肉厚，煮制时间减三分钟。"
    },
    {
      "original": "白胡椒",
      "substitute": "黑胡椒",
      "ratio": "2g 对 2g",
      "note": "香气更冲，用量可略减。"
    }
  ],
  "variations": [
    "加一块嫩豆腐同煮，汤更鲜也更饱腹。",
    "起锅前打入一个蛋花，汤体更浓。"
  ],
  "serving_suggestion": "趁热喝汤吃肉，撒一点白胡椒更暖身。",
  "storage": "当天喝完最好，鱼汤隔夜腥味会明显加重。",
