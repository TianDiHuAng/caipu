  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 400,
          "unit": "g",
          "note": "切成一厘米厚的方片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "打散成蛋液",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 40,
          "unit": "g",
          "note": "裹豆腐用",
          "optional": false
        },
        {
          "name": "大葱",
          "name_en": "Welsh onion",
          "amount": 20,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        },
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 120,
          "unit": "ml",
          "note": "没有高汤可用清水加生抽",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "调味上色",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "分次调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 60,
          "unit": "ml",
          "note": "煎豆腐用",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 5,
          "unit": "ml",
          "note": "出锅前淋",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "锅铲",
    "浅盘",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成厚片，用厨房纸轻轻压去表面水分，两面薄薄拍上一层面粉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆腐水分一定要吸干，否则裹不住蛋液，下锅容易溅油脱皮。",
      "visual_cue": "豆腐片干爽，表面均匀挂一薄层粉。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加少许盐搅匀，把拍过面粉的豆腐片逐片放入蛋液里裹匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液要现裹现煎，泡久了会往豆腐里渗，煎出来发散发老。",
      "visual_cue": "豆腐片通体裹上淡黄色蛋液。"
    },
    {
      "n": 3,
      "text": "平底锅放植物油烧热，把豆腐片一片片码入锅中，小火煎到两面金黄。",
      "time_min": 8,
      "heat": "小火",
      "tip": "下锅后先别动，等底面定型发黄再翻，翻早了蛋皮会破。",
      "visual_cue": "两面金黄起壳，边缘微微翘起。"
    },
    {
      "n": 4,
      "text": "沿锅边烹入高汤和生抽，加盐调味，加盖小火把汤汁慢慢塌进豆腐里。",
      "time_min": 6,
      "heat": "小火",
      "tip": "汤汁不要多，刚好没过豆腐一半，塌到收干才算到位。",
      "visual_cue": "汤汁渐少，豆腐鼓起并吸饱汤汁。"
    },
    {
      "n": 5,
      "text": "汤汁收浓时撒上大葱丝，淋香油后连锅端出装盘。",
      "time_min": 2,
      "heat": "小火",
      "tip": "葱丝最后撒才够香，淋香油后立刻关火以免香气发苦。",
      "visual_cue": "葱丝翠绿铺面，汤汁浓稠挂壁。"
    }
  ],
  "tips": [
    "豆腐一定要先吸干水分再拍粉，蛋皮才贴得牢不脱落。",
    "全程小火慢塌，蛋皮才不会焦而里面还是凉心。",
    "高汤塌入后别急着翻动，让豆腐自己把汤吸进去更入味。"
  ],
  "common_mistakes": [
    "豆腐没吸干就下锅，热油四溅，蛋皮也全脱落散在锅里。",
    "用中大火煎塌，外皮焦黑而豆腐中间仍是凉的硬心。",
    "汤汁加得太多又不收干，成品泡在汤里毫无塌菜的浓香。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "豆腐",
      "ratio": "400克:400克",
      "note": "内酯豆腐太嫩会散，不适合做锅塌豆腐。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "120毫升:120毫升",
      "note": "清水版味道略淡，可多放五毫升生抽提鲜。"
    }
  ],
  "variations": [
    "有的师傅在蛋液里掺一点面粉，煎出的外皮更厚更酥脆。",
    "塌制时加几片香菇一起烧，鲜味更浓，汤汁也更稠。"
  ],
  "serving_suggestion": "锅塌豆腐趁热整块上桌，汤汁拌米饭特别香，适合配清汤或小米粥。",
  "storage": "冷藏可存两天，复热时用平底锅小火加两勺高汤焖两分钟，别用微波炉。",
