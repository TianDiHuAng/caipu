        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "刀",
    "砧板",
    "碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒进盆里，冲入一百毫升滚沸的清水快速搅成絮状，再兑七十毫升凉水揉成光滑面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "先用滚水烫掉部分筋性，饼皮才软，凉水补足延展性。",
      "visual_cue": "面团不粘手，表面细腻发亮"
    },
    {
      "n": 2,
      "text": "面团盖上湿布醒三十分钟，醒到按下去能慢慢回弹。",
      "time_min": 5,
      "heat": "无火",
      "tip": "醒不够的面团一擀就缩，层次也起不来。",
      "visual_cue": "面团松软，指坑缓慢回平"
    },
    {
      "n": 3,
      "text": "小葱切碎，鸡蛋磕进碗里加盐和小葱搅散；甜面酱加两勺清水调稀备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液打散到看不见成块的白，灌进饼里才匀。",
      "visual_cue": "蛋液淡黄起细泡，酱汁顺滑"
    },
    {
      "n": 4,
      "text": "面团分成四份，每份擀成薄圆片，刷一层花生油撒少许面粉，卷起后立起来按扁再擀开。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刷油卷起是起层的关键，卷得越紧，饼鼓起的气泡越大。",
      "visual_cue": "饼胚层次可见，直径约十八厘米"
    },
    {
      "n": 5,
      "text": "平底锅烧热刷薄薄一层花生油，下饼胚小火烙到表面鼓起大泡，翻面再烙一分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "火大了饼皮先焦硬，里面的气鼓不起来就灌不进蛋。",
      "visual_cue": "饼面鼓起成球，底面淡黄有斑点"
    },
    {
      "n": 6,
      "text": "用筷子在饼边戳开小口，把蛋液从口子灌进去，两面各烙一分钟，烙到蛋液完全凝固熟透。",
      "time_min": 4,
      "heat": "小火",
      "tip": "灌蛋后要轻压饼身，让蛋液铺满内层，中心温度够高才熟得透。",
      "visual_cue": "饼身鼓起发硬，切口不见流动蛋液"
    },
    {
      "n": 7,
      "text": "出锅抹一层甜面酱，夹上生菜叶卷起来，趁热吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生菜最后夹，靠饼的余温微微回软，咬着才不散。",
      "visual_cue": "饼皮金黄起层，生菜翠绿外露"
    }
  ],
  "tips": [
    "面粉选中筋，高筋擀起来回缩厉害，低筋则包不住蛋液。",
    "饼胚擀得薄一些，层次多，灌蛋后受热均匀，不会外熟内生。",
    "一次可以多擀几个饼胚，用油纸隔开冷冻，早上直接下锅省事。"
  ],
  "common_mistakes": [
    "全用冷水和面，饼皮发硬起层差，卷起来咔嚓断裂。",
    "火开太大，饼皮外层焦黑，里面的蛋液还是流动的。",
    "灌蛋后立刻翻面，蛋液从封口流出来，锅里一片蛋花。"
  ],
  "substitutions": [
    {
      "original": "甜面酱",
      "substitute": "黄豆酱",
      "ratio": "40克:40克",
      "note": "黄豆酱更咸，用量减到三十克，另加一点白糖和味。"
    },
    {
      "original": "生菜",
      "substitute": "黄瓜",
      "ratio": "60克:80克",
      "note": "黄瓜切细条夹入，口感更脆，出水稍多需沥干。"
    }
  ],
  "variations": [
    "蛋液里加一把虾仁和少许白胡椒，鲜味更足，接近胶东街头的做法。",
    "喜欢吃辣的刷一层辣椒油再抹甜面酱，辣香和酱香叠在一起。"
  ],
  "serving_suggestion": "饼卷成筒，外皮酥脆内里软嫩，配一碗小米粥或豆浆，是山东街头最常见的早点搭配。",
  "storage": "现做现吃最香，冷藏可放一天；复热用平底锅小火两面各烘一分钟，别用微波炉否则饼皮发韧。",
