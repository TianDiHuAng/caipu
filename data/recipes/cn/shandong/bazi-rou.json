  ],
  "equipment": [
    "砂锅",
    "汤锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成 2cm 厚的大片，冷水浸泡 20 分钟逼出血水，中途换一次水。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡水比焯水更能保住肉香。",
      "visual_cue": "肉片发白、水色变淡"
    },
    {
      "n": 2,
      "text": "肉片冷水下锅，加姜片与料酒大火烧开，焯 8 分钟撇净浮沫后捞出冲净。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅血沫才出得干净。",
      "visual_cue": "浮沫成灰褐色、肉片紧实"
    },
    {
      "n": 3,
      "text": "砂锅底铺小葱段、姜片、八角、香叶与桂皮，码放时留出缝隙。",
      "time_min": 4,
      "heat": "无火",
      "tip": "垫葱姜能防粘底，也让香气往上走。",
      "visual_cue": "锅底铺满、香料均匀"
    },
    {
      "n": 4,
      "text": "肉片皮朝上码入砂锅，加生抽、老抽、冰糖、盐与 600ml 清水，水面略低于肉面。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水不要没过肉，靠焖让味道渗进去。",
      "visual_cue": "汤汁刚及肉片八成"
    },
    {
      "n": 5,
      "text": "大火烧开后转小火焖 80 分钟，中途把肉片上下翻动一次。",
      "time_min": 82,
      "heat": "小火",
      "tip": "小火保持似开非开，肉才酥而不散。",
      "visual_cue": "筷子能扎透肉皮、汤汁浓稠"
    },
    {
      "n": 6,
      "text": "转中火收汁 8 分钟，边收边把汤汁淋在肉面上，至肉皮红亮即关火。",
      "time_min": 8,
      "heat": "中火",
      "tip": "收汁时勤淋汁，颜色才均匀发亮。",
      "visual_cue": "肉皮油亮、汤汁挂勺"
    }
  ],
  "tips": [
    "垫葱姜防粘底，取肉时整片不破。",
    "小火焖足 80 分钟，肥肉才入口即化。",
    "收汁阶段勤淋汁，成品才有镜面感。"
  ],
  "common_mistakes": [
    "全程大火猛煮，肉片迅速卷缩、口感发柴。",
    "水一次加得太多，成品汤汁味淡颜色也浅。",
    "收汁阶段直接出锅，肉面暗淡没有油亮感。"
  ],
  "substitutions": [
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "30g 对 25g",
      "note": "糖色略浅，需多收 2 分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "前腿肉",
      "ratio": "800g 对 800g",
      "note": "脂肪少，焖制时间减 15 分钟。"
    }
  ],
  "variations": [
    "加卤蛋版：同锅放入 4 个鸡蛋同焖，蛋黄吸汁更好吃。",
    "酱香版：加 20g 黄豆酱同焖，酱味更浓。"
  ],
  "serving_suggestion": "配米饭浇汁，一片肉一碗饭是济南人的吃法。",
  "storage": "冷藏 2 天，复热连汁小火蒸 10 分钟。",
