    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干香菇用温水泡二十分钟至软，泡菇的水沉淀后留用，香菇切厚片。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡菇水是这道菜的鲜味底子，倒掉就太可惜了。",
      "visual_cue": "香菇柔软有弹性，水色深褐发香"
    },
    {
      "n": 2,
      "text": "鸡腿肉斩成四厘米见方的块，冲洗血水后沥干，用料酒和五克生抽抓匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "斩块后冲一遍血水，焖出来的汤才不腥不浑。",
      "visual_cue": "鸡块干爽无血水，表面微黏"
    },
    {
      "n": 3,
      "text": "花生油烧热，下姜片和葱段爆香，倒入鸡块中火煸炒五分钟至表皮收紧。",
      "time_min": 6,
      "heat": "中火",
      "tip": "鸡块要煸到皮微焦，油逼出来才不腻。",
      "visual_cue": "鸡皮金黄紧实，锅底析出鸡油"
    },
    {
      "n": 4,
      "text": "把鸡块推到一边，下白糖小火炒成枣红色糖色，与鸡块翻匀上色。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖色一起泡就下鸡块，炒过头会发苦。",
      "visual_cue": "糖色枣红起小泡，鸡块油亮上色"
    },
    {
      "n": 5,
      "text": "放入香菇片翻炒，加生抽、老抽、盐、高汤和泡菇水，大火烧开后转小火焖二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "水要一次加够，中途添水会把味道冲淡了。",
      "visual_cue": "汤汁微沸，鸡块浮起，菌香浓郁"
    },
    {
      "n": 6,
      "text": "开盖转大火收汁三分钟至汤汁稠亮，撒葱段翻匀出锅。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁的时候多晃几下锅，糖分很容易糊底。",
      "visual_cue": "汤汁红亮挂鸡块，油光发亮"
    }
  ],
  "tips": [
    "用干香菇比鲜香菇香，泡菇水一定要沉淀后入锅。",
    "鸡腿肉比整鸡嫩，斩块后不去骨，焖出来的汁更浓。",
    "喜欢辣可加三只干辣椒同煸，香而不燥。"
  ],
  "common_mistakes": [
    "鸡块不煸直接下水焖，腥味重，汤汁也寡淡。",
    "糖色炒过头了，整锅都带苦味，颜色也发黑。",
    "全程大火焖，鸡肉收紧发柴，香菇也焖烂了。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅中",
      "ratio": "600克:600克",
      "note": "翅中表面划两刀，焖的时间缩短五分钟。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "300毫升:300毫升",
      "note": "清水版本把泡菇水全部用上补鲜。"
    }
  ],
  "variations": [
    "加一百克土豆块同焖，吸汁后格外绵软。",
    "收汁前加五十克青椒块，多一层清香与脆口。"
  ],
  "serving_suggestion": "连锅端上桌，汤汁浇米饭最香，配一碗清汤与凉拌菜就是一桌家常饭。",
  "storage": "冷藏可存两天，复热时加少量高汤小火焖五分钟；冷冻可存两周，鸡肉口感略降。",
