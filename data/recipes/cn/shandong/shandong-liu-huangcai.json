          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 200,
          "unit": "ml",
          "note": "调蛋液用",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 15,
          "unit": "g",
          "note": "勾芡与调浆",
          "optional": false
        },
        {
