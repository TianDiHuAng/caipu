        },
        {
          "name": "猪油",
          "name_en": "lard",
          "amount": 35,
          "unit": "g",
          "note": "炒制用",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切葱花点缀",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "荸荠去皮后切成米粒大小的细末，火腿同样切细末，两者分开放。",
      "time_min": 10,
      "heat": "无火",
      "tip": "荸荠末要细，太大颗会硌牙，也影响蛋羹的细腻度。",
      "visual_cue": "荸荠末均匀，火腿末细碎。"
    },
    {
      "n": 2,
      "text": "蛋黄打散，加高汤、盐和十克玉米淀粉搅匀，用细筛过滤一遍。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过滤能去掉蛋筋和气泡，成菜才细腻如脂。",
      "visual_cue": "蛋液顺滑无颗粒，滤网上留有少量蛋筋。"
    },
    {
      "n": 3,
      "text": "蛋液里拌入荸荠末，静置三分钟让淀粉充分吸水。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置后淀粉吸水，炒的时候才不结块。",
      "visual_cue": "蛋液略稠，荸荠末均匀悬浮。"
    },
    {
      "n": 4,
      "text": "炒锅烧热放猪油，转小火倒入蛋液，用锅铲不停推炒成稠糊状。",
      "time_min": 6,
      "heat": "小火",
      "tip": "全程小火慢慢推炒，火一大蛋液立刻结成硬块，就溜不出嫩滑的口感。",
      "visual_cue": "蛋糊浓稠发亮，能堆起小尖。"
    },
    {
      "n": 5,
      "text": "蛋糊推到不粘锅、能挂住铲子时盛入盘中，撒火腿末和葱花即可。",
      "time_min": 3,
      "heat": "小火",
      "tip": "火腿末要等蛋糊盛盘后再撒，颜色红亮好看，也不会被炒散变碎。",
      "visual_cue": "蛋糊表面光滑油润，火腿末红白分明。"
    }
  ],
  "tips": [
    "只用蛋黄不加蛋清，成菜颜色才金黄透亮有光泽。",
    "蛋液务必过筛，去掉蛋筋和气泡，口感才细腻。",
    "全程小火推炒，火大就结块，溜不出嫩滑的质地。"
  ],
  "common_mistakes": [
    "用了整颗鸡蛋不加挑拣，成菜发白发灰，口感也偏粗。",
    "蛋液没过筛就下锅，蛋筋结成硬丝，一嘴粗糙。",
    "中大火炒蛋液，几秒钟结成硬块，完全失去滑嫩。"
  ],
  "substitutions": [
    {
      "original": "荸荠",
      "substitute": "莲藕",
      "ratio": "80克:80克",
      "note": "用脆藕切细末代替，口感同样清甜带脆。"
    },
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "35克:30毫升",
      "note": "改用植物油更清爽，但少了猪油的醇香。"
    }
  ],
  "variations": [
    "讲究的做法会在蛋糊里加一小勺蟹黄或虾脑，鲜味直追蟹粉。",
    "把溜改成蒸，倒入浅碗蒸八分钟，就是细腻的蛋黄羹。"
  ],
  "serving_suggestion": "溜黄菜盛盘后趁热吃，配薄饼卷着吃或直接挖着吃都香，宴席上常作为一道讲究的素菜。",
  "storage": "冷藏可存一天，复热时加一勺高汤小火推匀，能恢复滑嫩。",
