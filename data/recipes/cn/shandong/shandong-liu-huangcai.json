      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 5,
          "unit": "piece",
          "note": "只用蛋黄，蛋清留作他用",
          "optional": false
        },
        {
          "name": "荸荠",
          "name_en": "water chestnut",
          "amount": 100,
          "unit": "g",
          "note": "去皮切细末",
          "optional": false
        },
        {
          "name": "火腿",
          "name_en": "ham",
          "amount": 40,
          "unit": "g",
