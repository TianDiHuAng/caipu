  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "绿豆芽掐去根须洗净沥干，菠菜和韭黄切成四厘米长的段备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆芽根须不掐净，嚼起来满口粗渣，卖相也差。",
      "visual_cue": "豆芽根净身白，菜段长短一致"
    },
    {
      "n": 2,
      "text": "木耳用温水泡发后切细丝，猪里脊切成同粗细的丝，加料酒抓匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "猪里脊丝上浆前先抓料酒，去腥又保水。",
      "visual_cue": "肉丝干爽不粘连，木耳丝乌黑"
    },
    {
      "n": 3,
      "text": "鸡蛋打散，炒锅刷薄油摊成薄蛋皮，晾凉后切成细丝备用。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蛋皮摊薄才切得成丝，厚了就成蛋块。",
      "visual_cue": "蛋皮浅黄透亮，切丝不断"
    },
    {
      "n": 4,
      "text": "花生油烧到六成热，下猪里脊丝快速滑散，变色即盛出。",
      "time_min": 2,
      "heat": "中火",
      "tip": "肉丝下锅别急着翻，等底部定型再滑开。",
      "visual_cue": "肉丝根根分明，色白发亮"
    },
    {
      "n": 5,
      "text": "原锅下大蒜片和小葱段爆香，先放木耳丝和绿豆芽大火翻炒一分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆芽必须大火快炒，小火只会炒出水。",
      "visual_cue": "豆芽挺立透亮，锅底不见汤水"
    },
    {
      "n": 6,
      "text": "下菠菜段、韭黄段和蛋皮丝，加生抽、盐和香醋翻匀，倒回肉丝炒匀出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "韭黄最后下锅，多炒十秒就会发黄发软。",
      "visual_cue": "菜色青黄分明，盘底干爽"
    }
  ],
  "tips": [
    "合菜讲究旺火快炒，全程不超过五分钟，菜才有脆劲。",
    "豆芽先干锅煸十秒再放油，出水少、更脆口。",
    "用春饼卷着吃是老济南立春的吃法，菜要炒得干一些。"
  ],
  "common_mistakes": [
    "豆芽下锅小火慢炒，出一盘水，菜全泡软了。",
    "肉丝和蔬菜一起下锅，肉老菜烂，两头不讨好。",
    "韭黄早下锅，出锅时已经黄软，香气也跑了。"
  ],
  "substitutions": [
    {
      "original": "韭黄",
      "substitute": "韭菜",
      "ratio": "80克:80克",
      "note": "韭菜味更冲，下锅时间再缩短十秒。"
    },
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "100克:100克",
      "note": "鸡胸肉切丝后加淀粉抓匀，滑油时间减半。"
    }
  ],
  "variations": [
    "加五十克泡软的粉丝同炒，卷饼时更顶饱。",
    "素版本去掉肉丝，加一把金针菇，鲜味也够。"
  ],
  "serving_suggestion": "趁热装盘，配春饼或单饼卷食，也可以直接配米饭，清爽解腻。",
  "storage": "现炒现吃最好，冷藏不超过一天；复热用大火快翻三十秒，久加热蔬菜会出水发黄。",
