  "equipment": [
    "炒锅",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪腰对半剖开，片净中间白色腰臊，再切成 0.3cm 厚的十字花刀块。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腰臊片不净，炒出来会有骚味。",
      "visual_cue": "腰块花纹清晰、无白膜"
    },
    {
      "n": 2,
      "text": "腰花放清水里反复抓洗到水色变清，沥干后加料酒与白胡椒抓匀腌 10 分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "多洗几遍能带走血水与腥气。",
      "visual_cue": "腰花卷曲、水色澄清"
    },
    {
      "n": 3,
      "text": "腌好的腰花加玉米淀粉抓匀上浆，木耳撕小朵，青椒切片，蒜姜葱切好。",
      "time_min": 5,
      "heat": "无火",
      "tip": "上浆后静置 2 分钟再炒更嫩。",
      "visual_cue": "腰花表面均匀挂一层薄浆"
    },
    {
      "n": 4,
      "text": "炒锅倒 50ml 植物油烧到冒烟，下腰花大火爆炒 40 秒至卷成花状盛出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅要够热，腰花才脆嫩不渗水。",
      "visual_cue": "腰花卷曲、表面变色"
    },
    {
      "n": 5,
      "text": "原锅留底油下姜蒜片炒香，加木耳与青椒片大火翻炒 1 分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "木耳下锅会有爆响，可先沥干水分。",
      "visual_cue": "青椒断生、木耳卷起"
    },
    {
      "n": 6,
      "text": "回锅腰花，烹入生抽与香醋，加盐快速翻匀，撒葱段立刻出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程不超过 5 分钟，久炒腰花就老。",
      "visual_cue": "酱色均匀、腰花挺脆"
    }
  ],
  "tips": [
    "腰臊必须片净，这是去腥的关键一步。",
    "腰花上浆后再爆炒，口感更滑嫩。",
    "全程大火快炒，出锅要快才够脆。"
  ],
  "common_mistakes": [
    "腰臊没片干净，成品带明显骚味。",
    "腰花在锅里炒太久，口感像硬橡皮。",
    "锅不够热就下腰花，出水变成煮腰花。"
  ],
  "substitutions": [
    {
      "original": "猪腰",
      "substitute": "鸡胗",
      "ratio": "500g 对 450g",
      "note": "鸡胗更韧，切薄片并多炒 30 秒。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "10ml 对 10ml",
      "note": "米醋味淡，可多加 2ml。"
    }
  ],
  "variations": [
    "酸辣版：加 10g 泡椒同炒，酸辣开胃。",
    "火爆版：加 5g 干辣椒段，锅气更足。"
  ],
  "serving_suggestion": "出锅立刻上桌，配米饭或下酒都合适。",
  "storage": "不建议隔夜，腰花回热后口感变硬。",
