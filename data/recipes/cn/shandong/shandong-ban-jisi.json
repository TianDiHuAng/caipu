  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉冷水下锅，放姜片和料酒，大火烧开后转小火煮十二分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "冷水下锅能让血水慢慢逼出，热水下锅外面老了里面还是生的。",
      "visual_cue": "水面浮沫撇净，鸡肉整体发白"
    },
    {
      "n": 2,
      "text": "关火后连汤焖五分钟，捞出鸡胸肉放到不烫手，顺着纹理撕成细丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺纹理撕出来的丝细长不碎，横着切会一咬就散。",
      "visual_cue": "鸡丝细长均匀，断面有纤维感"
    },
    {
      "n": 3,
      "text": "黄瓜切细丝铺在盘底，撒少许盐腌三分钟，倒掉渗出的水。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄瓜先杀水，拌好才不会把料汁冲淡。",
      "visual_cue": "黄瓜丝微软，盘底见水"
    },
    {
      "n": 4,
      "text": "小碗放生抽、香醋、白糖、盐、蒜泥和辣椒油调匀，撒入小葱碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要搅到完全化开，不然沉在碗底只有第一口甜。",
      "visual_cue": "料汁颜色红亮，蒜香扑鼻"
    },
    {
      "n": 5,
      "text": "鸡丝码在黄瓜丝上，淋上料汁，撒香菜段，吃前拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "上桌前再拌，鸡丝泡久了会失水发柴。",
      "visual_cue": "鸡丝裹满红亮料汁，盘底渗出一点点汁"
    }
  ],
  "tips": [
    "煮鸡全程小火，水只冒小泡，鸡肉才嫩而不柴。",
    "撕丝前用刀背把鸡胸拍松，撕起来更顺。",
    "黄瓜丝杀水后挤干，盘底清爽不汪水。"
  ],
  "common_mistakes": [
    "鸡胸大火滚煮十五分钟，切开粉白发干，撕都撕不动。",
    "黄瓜不杀水直接拌，十分钟后整盘变成汤汁。",
    "料汁一次全浇上又久放，鸡丝吸饱咸味，越吃越齁。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "400克:400克",
      "note": "鸡腿肉更滑嫩，煮的时间延长三分钟。"
    },
    {
      "original": "辣椒油",
      "substitute": "花椒油",
      "ratio": "15毫升:15毫升",
      "note": "想吃麻香就换花椒油，辣度归零。"
    }
  ],
  "variations": [
    "加一把泡发的木耳丝同拌，口感更脆。",
    "夏天可把鸡丝和黄瓜丝一起冰镇十分钟再拌，更清爽。"
  ],
  "serving_suggestion": "装浅盘堆成小山，顶上撒一层香菜和小葱，作为第一道凉菜上桌，开胃解腻。",
  "storage": "冷藏可存一天，料汁另装，吃前再拌；隔夜后鸡丝会略干，可补一勺鸡汤。",
