  "equipment": [
    "炒锅",
    "锅铲",
    "打蛋碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "韭菜择洗干净，控干水分后切成四厘米长的段，根部和叶子分开放。",
      "time_min": 6,
      "heat": "无火",
      "tip": "韭菜一定控干水，带水下锅会出一锅汤，蛋也发湿。",
      "visual_cue": "韭菜段干爽，根部与叶片分堆。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加一小撮盐和几滴清水，搅到蛋液均匀起细泡。",
      "time_min": 2,
      "heat": "无火",
      "tip": "加几滴清水能让蛋块更嫩，但不要加多否则炒不成形。",
      "visual_cue": "蛋液均匀，表面有小泡。"
    },
    {
      "n": 3,
      "text": "炒锅烧热放植物油，倒入蛋液，等底部凝固后推成大块盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋液下锅别马上搅，定住再翻，蛋块才蓬松成片。",
      "visual_cue": "蛋块金黄鼓胀，无流动蛋液。"
    },
    {
      "n": 4,
      "text": "锅中补少量油烧到冒烟，先下韭菜根部大火炒十秒，再下叶片。",
      "time_min": 2,
      "heat": "大火",
      "tip": "韭菜根部难熟、叶子一碰就软，必须分开下锅。",
      "visual_cue": "韭菜根部断生，叶片翠绿挺立。"
    },
    {
      "n": 5,
      "text": "倒回炒好的蛋块，加盐快速翻匀，淋上香油后立刻出锅装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "韭菜回锅不超过四十秒，久了就出水发黄。",
      "visual_cue": "韭菜翠绿，蛋块油亮不渗水。"
    }
  ],
  "tips": [
    "韭菜必须控干水分，这是不出汤的关键。",
    "韭菜根部和叶片分开下锅，成熟度才能一致。",
    "全程大火快炒，韭菜回锅时间越短越好。"
  ],
  "common_mistakes": [
    "韭菜没控干就下锅，炒出一盘汤，蛋块泡得发软。",
    "鸡蛋在锅里反复搅碎，出锅成了蛋渣不像蛋块。",
    "小火慢炒韭菜，叶子发黄出水，香气也跑光了。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "韭黄",
      "ratio": "250克:250克",
      "note": "换成韭黄更嫩更甜，炒的时间要再缩短一点。"
    },
    {
      "original": "植物油",
      "substitute": "猪油",
      "ratio": "35毫升:30克",
      "note": "用猪油炒，蛋香和韭香都更浓。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同炒，就是山东人家常的韭菜粉丝炒蛋。",
    "喜欢鲜味的可以加一小把虾皮，盐要相应减少。"
  ],
  "serving_suggestion": "韭菜炒鸡蛋配小米粥或大馒头都合适，做早餐、下酒或配面条都省事。",
  "storage": "不建议隔夜，韭菜复热会发黄出水，最好现炒现吃。",
