  "equipment": [
    "拌菜盆",
    "小碗",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净后用刀背拍裂，切成三厘米长的段，加盐腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "拍裂的黄瓜更容易吸住酱汁。",
      "visual_cue": "黄瓜断面毛糙、渗出水"
    },
    {
      "n": 2,
      "text": "把腌出的水倒掉，黄瓜段挤干水分放入拌菜盆。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水挤干，麻酱才挂得住。",
      "visual_cue": "黄瓜干爽、盆底不见积水"
    },
    {
      "n": 3,
      "text": "芝麻酱放小碗，加清水一点点搅开，调到能流动的稠度。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水要分次加，一次全倒会结块。",
      "visual_cue": "麻酱顺滑无颗粒、能挂勺"
    },
    {
      "n": 4,
      "text": "往澥开的芝麻酱里加生抽、香醋、白糖与大蒜末搅匀成酱料。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜末最后加，香味更冲。",
      "visual_cue": "酱料均匀、颜色浅褐"
    },
    {
      "n": 5,
      "text": "把酱料浇在黄瓜上，翻拌到每段都裹上麻酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌的时候从下往上翻，别压出水。",
      "visual_cue": "黄瓜油亮、酱料均匀附着"
    },
    {
      "n": 6,
      "text": "装盘静置五分钟入味，吃前再拌一次即可上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置一会儿黄瓜更入味。",
      "visual_cue": "盘底略见酱汁、香气扑鼻"
    }
  ],
  "tips": [
    "黄瓜提前放进冰箱冷藏，拌好之后更冰爽。",
    "芝麻酱选纯芝麻磨的，香气比调和酱浓。",
    "喜欢吃辣可以再加一勺辣椒油一起拌匀。"
  ],
  "common_mistakes": [
    "黄瓜没腌就拌，出汤把麻酱冲稀。",
    "芝麻酱一次加足水，怎么搅都结块。",
    "拌好后放置太久，黄瓜软塌还会不停出水。"
  ],
  "substitutions": [
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "35g 对 35g",
      "note": "甜香更重，白糖减半。"
    },
    {
      "original": "黄瓜",
      "substitute": "莴笋",
      "ratio": "400g 对 400g",
      "note": "更脆，需焯水十秒。"
    }
  ],
  "variations": [
    "加一把凉皮一起拌，直接就能当成主食吃。",
    "撒一点熟芝麻增香，口感更丰富。"
  ],
  "serving_suggestion": "冷藏后当开胃凉菜，配面食最搭。",
  "storage": "当天吃完，隔夜黄瓜会出水变软。",
