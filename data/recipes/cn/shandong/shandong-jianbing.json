          "name_en": "water",
          "amount": 500,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底鏊子",
    "刮板",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小米面与面粉混合，加 5g 盐，分次倒入 500ml 清水搅成能挂勺的稀糊，静置 4 小时。",
      "time_min": 240,
      "heat": "无火",
      "tip": "面糊静置够久，摊出来才不易破。",
      "visual_cue": "面糊顺滑无颗粒、舀起呈线状流下"
    },
    {
      "n": 2,
      "text": "平底鏊子烧热，用厨房纸蘸 30ml 植物油薄薄擦一层。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油多饼会软，薄薄一层就够。",
      "visual_cue": "鏊面泛油光、滴水成珠滚动"
    },
    {
      "n": 3,
      "text": "舀一勺面糊倒在鏊子中央，用刮板由内向外快速摊成薄圆片。",
      "time_min": 2,
      "heat": "中火",
      "tip": "刮板贴紧鏊面，动作要快。",
      "visual_cue": "饼皮薄至透光、边缘微翘"
    },
    {
      "n": 4,
      "text": "饼皮边缘翘起时打入 1 个鸡蛋，用刮板抹匀铺满饼面。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蛋液抹匀后更容易粘住配料。",
      "visual_cue": "蛋液凝固、颜色转为浅黄"
    },
    {
      "n": 5,
      "text": "翻面烙 40 秒，刷 20g 甜面酱，铺上葱丝与生菜。",
      "time_min": 2,
      "heat": "中火",
      "tip": "酱要刷匀但不汪，免得饼皮返潮。",
      "visual_cue": "饼面焦香、酱色均匀"
    },
    {
      "n": 6,
      "text": "用铲子从一侧卷起成筒，对折出锅，趁热食用。",
      "time_min": 1,
      "heat": "小火",
      "tip": "卷得紧一些，咬着才不散。",
      "visual_cue": "饼卷紧实、外层干脆"
    }
  ],
  "tips": [
    "面糊稠度以能流动又是线状为佳，太稠摊不开，太稀易破。",
    "鏊子温度保持中火，火大饼焦、火小饼皮发黏。",
    "煎饼要现摊现吃，凉了就会回软失去脆劲。"
  ],
  "common_mistakes": [
    "面糊不静置直接摊，饼皮一碰就裂。",
    "鏊子上的油刷得太厚，煎饼软塌一点都不脆。",
    "鸡蛋没抹开就翻面，蛋液流到鏊子上焦成黑点。"
  ],
  "substitutions": [
    {
      "original": "小米面",
      "substitute": "玉米面",
      "ratio": "200g 对 200g",
      "note": "玉米面略粗，可多加 50ml 水。"
    },
    {
      "original": "甜面酱",
      "substitute": "黄豆酱",
      "ratio": "40g 对 40g",
      "note": "咸度更高，酌减盐量。"
    }
  ],
  "variations": [
    "枣庄版：面糊里掺 50g 高粱面，饼皮更香更韧。",
    "薄脆版：摊得更薄，烙到完全干脆，可当干粮存放。"
  ],
  "serving_suggestion": "卷葱丝与生菜直接吃，配一碗小米粥最对味。",
  "storage": "晾凉后密封常温存 2 天，复热用干锅烘 1 分钟恢复脆感。",
