          "name_en": "sweet bean sauce",
          "amount": 40,
          "unit": "g",
          "note": "刷饼",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "刷鏊子",
          "optional": false
        },
        {
