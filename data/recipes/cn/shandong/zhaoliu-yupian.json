  "equipment": [
    "炒锅",
    "漏勺",
    "小碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳜鱼去皮去骨，斜刀片成 0.5cm 厚的薄片，片形完整不散。",
      "time_min": 12,
      "heat": "无火",
      "tip": "斜刀片出的鱼片更宽，受热均匀。",
      "visual_cue": "鱼片薄而完整、无碎刺"
    },
    {
      "n": 2,
      "text": "鱼片加盐、料酒与 8g 玉米淀粉抓匀，上浆静置 5 分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "抓出黏性再停，鱼片才不脱浆。",
      "visual_cue": "鱼片表面挂一层薄浆"
    },
    {
      "n": 3,
      "text": "香糟加 50ml 清水调开，静置后滤去渣滓只留糟汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "滤掉渣滓，成菜才清亮。",
      "visual_cue": "糟汁微浑、无粗渣"
    },
    {
      "n": 4,
      "text": "锅中倒 300ml 清水烧至微沸，下鱼片汆 40 秒后捞出。",
      "time_min": 4,
      "heat": "小火",
      "tip": "水面微沸就够，大滚会把鱼片冲散。",
      "visual_cue": "鱼片变白卷边、不发柴"
    },
    {
      "n": 5,
      "text": "另起锅倒糟汁、白糖与姜末小火煮开，勾芡后浇在鱼片上。",
      "time_min": 8,
      "heat": "小火",
      "tip": "勾芡要薄，汁能挂住鱼片就好。",
      "visual_cue": "芡汁清亮、裹住鱼片"
    }
  ],
  "tips": [
    "鱼片斜刀片薄，汆水时间才好控制。",
    "糟汁过滤后再用，成菜才清亮无渣。",
    "勾芡宜薄，芡厚了会把糟香全压住。"
  ],
  "common_mistakes": [
    "水大滚时下鱼片，鱼肉散成碎块不成形。",
    "上浆淀粉放太多，入口发黏糊嘴。",
    "糟汁不过滤直接下锅，成品发黑有渣。"
  ],
  "substitutions": [
    {
      "original": "鳜鱼",
      "substitute": "黑鱼",
      "ratio": "400g 对 400g",
      "note": "黑鱼肉更紧，汆水时间加 10 秒。"
    },
    {
      "original": "香糟",
      "substitute": "黄酒加酒糟卤",
      "ratio": "40g 对 50ml",
      "note": "味道略淡，糖可减 2g。"
    }
  ],
  "variations": [
    "糟熘鱼片加木耳：加 30g 泡发木耳同熘，口感更脆。",
    "糟香鸡片版：鱼片换鸡胸肉片，汆水时间延长到 1 分钟。"
  ],
  "serving_suggestion": "趁热上桌，糟香扑鼻，配一碗米饭刚好。",
  "storage": "建议现做现吃，冷藏后鱼片会回硬，复热需小火蒸 3 分钟。",
