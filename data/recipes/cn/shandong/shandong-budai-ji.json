  "steps": [
    {
      "n": 1,
      "text": "整鸡冲洗干净擦干水分，从颈部开口，用刀背贴着骨架把鸡肉与骨头分开，取出全部骨架，注意别戳破鸡皮。",
      "time_min": 25,
      "heat": "无火",
      "tip": "贴着骨头走刀最省力，摸到骨节就用刀尖挑开，鸡皮破了就兜不住馅。",
      "visual_cue": "整鸡只剩皮肉，鸡皮完整无破口"
    },
    {
      "n": 2,
      "text": "炒锅下花生油烧热，放猪肉馅炒散出油，加盐和料酒翻匀，再下香菇丁、竹笋丁、火腿丁同炒，关火拌入虾仁。",
      "time_min": 12,
      "heat": "中火",
      "tip": "肉馅炒到水分收干再下配料，馅太湿会让鸡皮发软破裂。",
      "visual_cue": "馅料油润松散，香气明显"
    },
    {
      "n": 3,
      "text": "把炒好的馅料从颈部开口填入鸡腹，只填七分满，用棉线把开口扎紧。",
      "time_min": 10,
      "heat": "无火",
      "tip": "填太满蒸的时候鸡皮会被撑破，七分满给馅料留出膨胀余地。",
      "visual_cue": "鸡身鼓胀而鸡皮不紧绷"
    },
    {
      "n": 4,
      "text": "填好的整鸡用滚开水从外皮淋一遍，鸡皮收紧后放进深盘，盘内加高汤、葱段和姜片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "淋开水能让鸡皮收紧定型，蒸出来纹路清楚不含糊。",
      "visual_cue": "鸡皮紧实发亮，毛孔收缩"
    },
    {
      "n": 5,
      "text": "深盘放进蒸锅，大火上汽后转中火蒸四十分钟，用筷子在胸部厚肉处扎一下确认无血水。",
      "time_min": 40,
      "heat": "中火",
      "tip": "蒸锅水量要足，中途缺水只能补开水，加冷水会让鸡皮皱缩。",
      "visual_cue": "鸡身熟透，筷子扎入无血水"
    },
    {
      "n": 6,
      "text": "整鸡移入盘中，盘内原汤倒进炒锅烧开，加生抽调味，用水淀粉勾薄芡淋在鸡身上，撒香菜段上桌。",
      "time_min": 8,
      "heat": "中火",
      "tip": "勾芡到能挂住勺背就好，太稠会盖住鸡皮的亮色。",
      "visual_cue": "汤汁透亮微稠，均匀挂在鸡身"
    }
  ],
  "tips": [
    "出骨时鸡翅和鸡腿的关节要掰断再剔，硬拽会把鸡皮扯破。",
    "馅料必须炒过再填，生馅蒸出来出水多、味道也闷。",
    "蒸好先别急着开盖，焖三分钟再取，鸡皮不容易回缩塌陷。"
  ],
  "common_mistakes": [
    "鸡皮被刀戳破还硬填馅，蒸完馅料漏了一盘，鸡只剩个空壳。",
    "馅料填到满溢，鸡皮在蒸锅里被撑裂，形状全散。",
    "蒸过头四十分钟以上不检查，鸡肉发柴，馅料也失去汁水。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "900克:800克",
      "note": "不想出骨就用去骨鸡腿肉卷起馅料，蒸三十分钟即可。"
    },
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "80克:80克",
      "note": "没有鲜笋用茭白代替，口感同样脆嫩。"
    }
  ],
  "variations": [
    "老派做法会在馅里加一小把糯米，蒸出来更像八宝布袋。",
    "喜欢浓味可把蒸好的鸡连汤收浓，再浇一层琥珀色浓汁。"
  ],
  "serving_suggestion": "布袋鸡讲究整只上桌，端上来先让客人看形，再由主人用筷子从中间剖开分食，配一碗清汤最得体。",
  "storage": "冷藏可存两天，复热时连原汤一起上锅蒸十五分钟；不建议冷冻，鸡皮解冻后容易散。",
