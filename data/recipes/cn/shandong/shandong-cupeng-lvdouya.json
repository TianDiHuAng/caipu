  "steps": [
    {
      "n": 1,
      "text": "绿豆芽掐去根部，放清水里淘洗两遍，捞出放在漏勺里沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "掐根虽费事，口感却脆得多，这一步别省。",
      "visual_cue": "豆芽颜色洁白发亮，盆底不见积水"
    },
    {
      "n": 2,
      "text": "炒锅烧到微热倒植物油，下花椒小火炸香，捞出花椒只留油。",
      "time_min": 2,
      "heat": "小火",
      "tip": "花椒一变色就捞，炸黑了整锅油都苦。",
      "visual_cue": "油面浮起细泡，花椒由红转深"
    },
    {
      "n": 3,
      "text": "转大火下干辣椒、姜丝与小葱段爆香，随即倒入绿豆芽快速翻炒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆芽怕焖，全程大火三十秒就够，久了就出水发软。",
      "visual_cue": "豆芽挺立不塌，锅气明显"
    },
    {
      "n": 4,
      "text": "加盐与白糖翻匀，沿锅边烹入香醋，颠两下锅立刻关火装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "香醋沿锅边淋，遇热激出酸香，直接倒在菜上只剩涩味。",
      "visual_cue": "豆芽透亮带光泽，酸香扑鼻"
    }
  ],
  "tips": [
    "豆芽要最后才洗，洗早了放着会塌水，炒出来一锅汤。",
    "喜欢酸爽可用陈醋代替香醋，颜色深些但味道更厚。",
    "加一把泡软的粉丝同炒，就是山东饭馆常见的醋烹豆芽粉丝。"
  ],
  "common_mistakes": [
    "豆芽下锅后盖锅盖焖，出水变软，脆感全失。",
    "醋早早就倒进锅里一起炒，酸味全挥发只剩苦味。",
    "火不够大，豆芽在锅里慢慢煨，炒出一大盘水。"
  ],
  "substitutions": [
    {
      "original": "绿豆芽",
      "substitute": "黄豆芽",
      "ratio": "250克:250克",
      "note": "黄豆芽须焯水一分钟再炒。"
    },
    {
      "original": "香醋",
      "substitute": "陈醋",
      "ratio": "20毫升:18毫升",
      "note": "陈醋酸度更高，用量略减。"
    }
  ],
  "variations": [
    "加少许韭菜段同炒，颜色碧绿，香气也更清爽。",
    "出锅前撒一撮炸香的虾皮，鲜味立刻拔高一层。"
  ],
  "serving_suggestion": "趁热吃最脆，配馒头、米饭或作面条浇头都合适，也可冷后当小菜。",
  "storage": "现炒现吃，冷藏不超过一天，复热须大火快炒二十秒，微波会全软。",
