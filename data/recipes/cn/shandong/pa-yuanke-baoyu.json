  "steps": [
    {
      "n": 1,
      "text": "鲍鱼用刷子刷净壳面与裙边黑膜，小刀沿壳壁取出鲍肉，去掉内脏与嘴部硬块。",
      "time_min": 20,
      "heat": "无火",
      "tip": "裙边黑膜必须刮净，否则带股腥涩味。",
      "visual_cue": "鲍肉白净、裙边无黑边残留"
    },
    {
      "n": 2,
      "text": "鲍壳入沸水煮 5 分钟消毒定型，捞出摆入深盘，鲍肉表面划十字花刀便于入味。",
      "time_min": 8,
      "heat": "大火",
      "tip": "划刀浅一些，深了蒸的时候会卷缩。",
      "visual_cue": "壳内壁发白、鲍肉刀纹均匀"
    },
    {
      "n": 3,
      "text": "整鸡斩块焯水，与火腿片、姜片、葱段加 1200ml 清水大火烧开，转小火吊 60 分钟成高汤。",
      "time_min": 70,
      "heat": "小火",
      "tip": "汤要吊到见底发亮，鲜味才够厚。",
      "visual_cue": "汤色清亮泛油、鸡块酥烂脱骨"
    },
    {
      "n": 4,
      "text": "鲍肉放回壳中，每只淋 10ml 高汤与少许料酒，上蒸屉大火蒸 12 分钟。",
      "time_min": 15,
      "heat": "大火",
      "tip": "蒸的时间宁短勿长，久了鲍肉发硬。",
      "visual_cue": "鲍肉微卷、按下有弹性"
    },
    {
      "n": 5,
      "text": "取 400ml 高汤加 15ml 生抽、5g 盐烧开，用 10g 淀粉加水调匀勾成薄芡。",
      "time_min": 6,
      "heat": "中火",
      "tip": "芡要稀，能挂勺即可，太稠糊住鲍肉。",
      "visual_cue": "芡汁透亮、能薄薄挂勺"
    },
    {
      "n": 6,
      "text": "西兰花氽水 1 分钟摆在鲍壳之间，将芡汁浇在鲍肉上，撒葱丝并淋少许烧热的花生油即可上桌。",
      "time_min": 5,
      "heat": "中火",
      "tip": "浇汁要趁热，冷芡结块就不好看了。",
      "visual_cue": "鲍面油亮、盘中不见积水"
    }
  ],
  "tips": [
    "鲍鱼要选活鲜，壳内壁发亮、触碰会收缩的最佳。",
    "吊高汤时不加盐，留到最后调味汤味更纯。",
    "蒸制时间按鲍鱼大小微调，每增大一号加 2 分钟。"
  ],
  "common_mistakes": [
    "内脏没有清除干净，成品带明显苦味。",
    "蒸过头十几分钟，鲍肉缩成硬球咬不动。",
    "芡粉放太多，酱汁糊成一层透明胶质。"
  ],
  "substitutions": [
    {
      "original": "鲍鱼",
      "substitute": "大连冰鲜鲍",
      "ratio": "8 只对 8 只",
      "note": "性价比更高，蒸制时间不变。"
    },
    {
      "original": "老母鸡",
      "substitute": "猪骨",
      "ratio": "300g 对 400g",
      "note": "汤更浓白，鲜味略厚重。"
    }
  ],
  "variations": [
    "蚝汁版：高汤改用蚝油调芡，味更浓。",
    "清蒸版：只用高汤不勾芡，突出鲍鱼本味。"
  ],
  "serving_suggestion": "原壳上桌，配小勺连汁一起食用，是鲁菜宴席的头道硬菜。",
  "storage": "建议现做现吃，冷藏不超过 1 天，复热需重新浇汁。",
