  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 450,
          "unit": "g",
          "note": "切成两厘米见方的块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "虾酱",
          "name_en": "shrimp paste",
          "amount": 30,
          "unit": "g",
          "note": "胶东产的发酵虾酱",
          "optional": false
        },
        {
          "name": "五花肉",
          "name_en": "pork belly",
          "amount": 60,
          "unit": "g",
          "note": "切细丁",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "葱白葱花分开",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 8,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 4,
          "unit": "g",
          "note": "中和虾酱的咸腥",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 6,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "炒酱用",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 200,
          "unit": "ml",
          "note": "炖煮用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "砂锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成两厘米见方的块，放入淡盐水里浸五分钟去豆腥后沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐块别切太小，炖的时候容易碎在汤里。",
      "visual_cue": "豆腐块完整，表面干爽。"
    },
    {
      "n": 2,
      "text": "锅中放植物油小火，下五花肉丁煸出油，再放姜末和葱白炒香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "肉丁煸到微焦再炒酱，油脂能带出虾酱的鲜味。",
      "visual_cue": "肉丁卷缩出油，葱白发香。"
    },
    {
      "n": 3,
      "text": "转小火放入虾酱慢炒到起小泡、香味散出，加白糖和生抽炒匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾酱一定要小火炒透，生酱有腥味，炒过才出鲜。",
      "visual_cue": "酱色油亮起泡，香气浓而不腥。"
    },
    {
      "n": 4,
      "text": "下豆腐块和清水，轻轻推匀后小火炖十分钟，让豆腐吸足酱香。",
      "time_min": 11,
      "heat": "小火",
      "tip": "豆腐下锅后只推不翻，用锅铲背推着走才不会散。",
      "visual_cue": "汤汁微稠呈酱色，豆腐鼓起入味。"
    },
    {
      "n": 5,
      "text": "汤汁收到剩一半时撒上葱花，连锅端上桌即可。",
      "time_min": 2,
      "heat": "小火",
      "tip": "收汁别收太干，留些汤汁拌饭才是这道菜的精髓。",
      "visual_cue": "锅里留薄薄一层浓汁，葱花翠绿。"
    }
  ],
  "tips": [
    "虾酱本身极咸，几乎不用另外放盐，靠白糖和生抽调平衡。",
    "虾酱必须小火炒透去腥，这是整道菜的关键步骤。",
    "豆腐块用锅铲背推着走，能保持形状完整。"
  ],
  "common_mistakes": [
    "虾酱没炒透直接下锅炖，整锅菜都带着生酱的腥臭味。",
    "另外加了盐，虾酱的咸味被叠上去，咸到没法下口。",
    "大火猛炖又不推勺，豆腐碎在汤里成了豆腐渣。"
  ],
  "substitutions": [
    {
      "original": "虾酱",
      "substitute": "蚝油",
      "ratio": "30克:20克",
      "note": "不吃虾酱可用蚝油代替，鲜味接近但少了发酵香。"
    },
    {
      "original": "北豆腐",
      "substitute": "豆腐皮",
      "ratio": "450克:250克",
      "note": "用豆腐皮结代替豆腐，吸汁更足且不易碎。"
    }
  ],
  "variations": [
    "胶东人家会加一把茼蒿或小白菜，荤素搭配更清爽。",
    "把豆腐换成冻豆腐，孔隙吸满虾酱汤汁，是冬天的下饭利器。"
  ],
  "serving_suggestion": "虾酱炖豆腐咸鲜浓烈，最适合配大馒头或贴饼子，一勺汤汁能拌下半碗饭。",
  "storage": "冷藏保存两天，复热时加两勺清水小火加热，避免越煮越咸。",
