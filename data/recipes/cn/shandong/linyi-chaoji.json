  "equipment": [
    "炒锅或铁锅",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡块用清水浸泡 10 分钟去血水，捞出沥干；姜切片、蒜拍散、干辣椒剪段。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鸡块一定沥干，带水下锅会溅油且不易上色。",
      "visual_cue": "鸡块表面无明显血水，摸起来不黏手"
    },
    {
      "n": 2,
      "text": "炒锅烧热下 40ml 植物油，鸡块皮朝下铺开，中大火煎至两面金黄。",
      "time_min": 6,
      "heat": "中大火",
      "tip": "先煎定型再翻动，鸡皮收紧后不易粘锅。",
      "visual_cue": "鸡皮金黄起小泡，锅底有焦香"
    },
    {
      "n": 3,
      "text": "下姜片、蒜、八角与干辣椒炒香，加甜面酱小火炒出酱色，与鸡块翻匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "甜面酱容易糊，必须小火并快速翻动。",
      "visual_cue": "鸡块均匀裹上酱色，香味浓郁"
    },
    {
      "n": 4,
      "text": "烹入料酒与生抽、老抽，加清水没过鸡块一半，大火烧开后转中小火焖 18 分钟。",
      "time_min": 20,
      "heat": "中小火",
      "tip": "焖的时间按鸡的老嫩调整，土鸡需延长到 25 分钟。",
      "visual_cue": "汤汁收去一半，鸡肉用筷子能轻松插入"
    },
    {
      "n": 5,
      "text": "下青椒块与盐，转大火收汁 3 分钟，撒香菜出锅。",
      "time_min": 4,
      "heat": "大火",
      "tip": "青椒最后下才脆，收汁到能挂住鸡块即可。",
      "visual_cue": "汤汁浓稠裹住鸡块，青椒仍翠绿"
    }
  ],
  "tips": [
    "鸡块剁小一点更易入味，带骨块比纯肉更香。",
    "收汁阶段勤翻动，甜面酱含糖容易糊底。",
    "喜麻可在爆香时加 2g 花椒，风味更接近鲁南做法。"
  ],
  "common_mistakes": [
    "鸡块焯水后再炒，表面蛋白质凝固，难以煎出焦香。",
    "全程大火猛烧，甜面酱容易糊锅，成品发苦带焦味。",
    "青椒与鸡同焖，出锅时已经软烂发黄。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "1200g 整鸡 ≈ 900g 鸡腿肉",
      "note": "鸡腿肉更嫩，焖制时间减到 12 分钟。"
    },
    {
      "original": "甜面酱",
      "substitute": "黄豆酱",
      "ratio": "25g 甜面酱 ≈ 25g 黄豆酱 + 5g 白糖",
      "note": "酱香更重，糖补回甜味。"
    }
  ],
  "variations": [
    "家庭简化版：鸡块先用高压锅压 8 分钟，再回锅收汁，总时长缩短一半。",
    "干炒版：不加水，靠鸡自身水分焖熟，成品更干香。"
  ],
  "serving_suggestion": "配山东煎饼或米饭，汤汁拌饭是本地吃法；也可作为下酒菜。",
  "storage": "冷藏 2 天，复热时加 50ml 清水小火焖 3 分钟，避免酱汁烧干。",
