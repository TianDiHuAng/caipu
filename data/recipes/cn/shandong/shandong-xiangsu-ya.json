  "steps": [
    {
      "n": 1,
      "text": "整鸭冲洗干净，剁去鸭尖和鸭脖留用，用厨房纸把鸭身内外擦干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鸭腔里的血水一定要冲净，残留血水是腥味的主要来源。",
      "visual_cue": "鸭皮干爽发紧，腔内无血水渗出"
    },
    {
      "n": 2,
      "text": "花椒和盐在干锅里小火炒到盐微黄、花椒出香，趁热搓遍鸭身内外，腌四十分钟。",
      "time_min": 45,
      "heat": "小火",
      "tip": "盐要下锅炒过才香，生盐只咸不透骨。",
      "visual_cue": "鸭皮表面均匀挂满椒盐粒"
    },
    {
      "n": 3,
      "text": "砂锅垫大葱段、姜片和八角，放入整鸭，加料酒、生抽、冰糖和高汤，汤面没过鸭身三分之二。",
      "time_min": 5,
      "heat": "中火",
      "tip": "垫葱姜是为了隔开锅底，鸭皮不粘不掉。",
      "visual_cue": "鸭身安稳躺在葱姜上，汤面微动"
    },
    {
      "n": 4,
      "text": "大火烧开后转小火卤六十分钟，中途翻一次身，关火再泡二十分钟。",
      "time_min": 80,
      "heat": "小火",
      "tip": "卤到筷子能轻松穿透鸭腿最厚处才算透。",
      "visual_cue": "鸭皮油亮，鸭腿轻推即穿"
    },
    {
      "n": 5,
      "text": "鸭子捞出沥干汤汁，趁温热在鸭皮上薄薄拍一层玉米淀粉，放通风处晾十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "皮面越干，淋炸后越酥，粉也只挂薄薄一层。",
      "visual_cue": "鸭皮干爽不粘手，粉层看不见白"
    },
    {
      "n": 6,
      "text": "花生油烧到七成热，用勺子舀油反复淋遍鸭身，淋到皮色金红、表皮起小泡。",
      "time_min": 6,
      "heat": "中火",
      "tip": "整鸭别下油锅，淋油受热更匀，也不怕溅油。",
      "visual_cue": "鸭皮金红发亮，表面密布小脆泡"
    },
    {
      "n": 7,
      "text": "鸭子稍凉后剁成一字条，按原形码盘，撒少许椒盐随桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "稍凉再剁，热的时候下刀鸭肉容易散。",
      "visual_cue": "鸭块皮肉相连，断面汁水清亮"
    }
  ],
  "tips": [
    "选两斤半左右的白条鸭，太大肉厚卤不易透。",
    "卤汤别倒，滤净冷冻，下次当老汤用，越卤越香。",
    "没有大油量条件就改淋炸，效果接近而更省油。"
  ],
  "common_mistakes": [
    "腌完直接下锅卤，椒盐没渗透，鸭肉里外咸淡不一。",
    "晾皮省了，鸭皮带水下油，溅得满灶台还炸不酥。",
    "卤好马上剁块，鸭肉烫手未定型，一刀下去全散。"
  ],
  "substitutions": [
    {
      "original": "整鸭",
      "substitute": "鸭腿",
      "ratio": "1200克:900克",
      "note": "鸭腿卤四十分钟就够，淋炸时间也相应缩短。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "1000毫升:1000毫升",
      "note": "用清水补十克冰糖和两片姜，卤香稍薄。"
    }
  ],
  "variations": [
    "卤汤里加一小块桂皮和两粒丁香，香气更复合，接近老字号的路子。",
    "喜欢果香可在卤制时放半个苹果，鸭肉更松软。"
  ],
  "serving_suggestion": "鸭块码成整鸭形，配椒盐碟和荷叶饼，先吃皮后吃肉，最后用饼卷着带骨的部分。",
  "storage": "冷藏可存两天，复热用烤箱一百八十度烤八分钟，皮能回脆；微波加热会让鸭皮发韧。",
