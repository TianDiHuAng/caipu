    "漏勺",
    "拌碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐皮切成三毫米宽的细丝，放入沸水里焯一分钟捞出过凉水沥干。",
      "time_min": 4,
      "heat": "大火",
      "tip": "焯过的豆腐皮去豆腥，口感也更柔韧不干硬。",
      "visual_cue": "豆腐皮丝柔软不粘连，闻着无豆腥。"
    },
    {
      "n": 2,
      "text": "菠菜洗净后入沸水快速焯三十秒，捞出立刻过凉水并挤干水分。",
      "time_min": 3,
      "heat": "大火",
      "tip": "菠菜焯水能去掉大部分草酸，口感也不涩口。",
      "visual_cue": "菠菜颜色翠绿，攥成团不滴水。"
    },
    {
      "n": 3,
      "text": "胡萝卜丝同样焯半分钟断生，与豆腐皮丝、菠菜一起放进拌碗。",
      "time_min": 2,
      "heat": "大火",
      "tip": "三样食材都要沥干，拌的时候才不会出半碗水。",
      "visual_cue": "碗里食材干爽，颜色分明。"
    },
    {
      "n": 4,
      "text": "加入生抽、香醋、白糖和盐，撒葱花后淋香油，用筷子从下往上翻拌均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先放调料后淋香油，油把味道封住，拌完更香。",
      "visual_cue": "食材挂上油光，颜色清爽不出水。"
    }
  ],
  "tips": [
    "三样食材焯完都要沥干，拌菜最怕碗底出水。",
    "白糖只用来中和醋的尖酸，别放到能吃出甜味。",
    "现拌现吃最好，放久了菠菜会塌软出水并发黄。"
  ],
  "common_mistakes": [
    "菠菜焯完没挤水就拌，上桌半碗汤，味道也被冲淡。",
    "豆腐皮直接用没焯水，豆腥味重且口感干硬。",
    "香醋一次倒太多，酸味压过豆香，吃着发冲。"
  ],
  "substitutions": [
    {
      "original": "豆腐皮",
      "substitute": "北豆腐",
      "ratio": "200克:300克",
      "note": "用北豆腐切条焯水代替，口感更嫩但要当天吃完。"
    },
    {
      "original": "菠菜",
      "substitute": "韭菜",
      "ratio": "300克:250克",
      "note": "没有菠菜时用焯过水的韭菜段，气味更冲。"
    }
  ],
  "variations": [
    "胶东人家会加一把泡发的海米或虾皮，鲜味更足。",
    "喜欢辣的可以泼一勺热辣椒油，酸辣开胃。"
  ],
  "serving_suggestion": "豆腐皮拌菠菜作为开胃凉菜上桌，配馒头、粥或烤肉解腻都合适。",
  "storage": "冷藏可放一天，菠菜久放会发黄出水，建议当天吃完。",
