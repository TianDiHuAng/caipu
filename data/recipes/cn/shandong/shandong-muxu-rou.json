    "菜刀",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊逆着纹理切成薄片，加料酒、玉米淀粉与一克盐抓匀上浆，静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "肉片上浆后炒出来才嫩滑。",
      "visual_cue": "肉片挂薄浆、手感滑"
    },
    {
      "n": 2,
      "text": "黑木耳提前用温水泡发，撕成小朵洗净，黄瓜斜切成片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "木耳要泡透并多洗两遍去沙。",
      "visual_cue": "木耳舒展、根部无硬结"
    },
    {
      "n": 3,
      "text": "鸡蛋磕碗里打散，炒锅下植物油烧到六成热，倒蛋液炒成块盛出。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "蛋块炒到八分熟就盛，回锅才不老。",
      "visual_cue": "蛋块金黄、块形完整"
    },
    {
      "n": 4,
      "text": "锅里补植物油下姜丝炝锅，倒入肉片大火滑炒到变色散开。",
      "time_min": 3,
      "heat": "大火",
      "tip": "肉片下锅就快速划散，避免粘连。",
      "visual_cue": "肉片发白卷边、不见血水"
    },
    {
      "n": 5,
      "text": "下木耳与黄瓜片同炒一分钟，加生抽与剩下的盐调匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "木耳下锅会响油，注意别烫到手。",
      "visual_cue": "黄瓜片透亮、木耳油润"
    },
    {
      "n": 6,
      "text": "倒回鸡蛋块，撒葱段大火翻炒半分钟，让蛋块吸收汤汁即出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "蛋块最后回锅，快炒才蓬松。",
      "visual_cue": "蛋块吸汁、色泽油亮"
    }
  ],
  "tips": [
    "上浆用的淀粉不要过量，薄薄一层就够。",
    "黄瓜切厚片，炒完仍带脆感不软塌。",
    "木耳泡发不要超过四小时，久泡易变质。"
  ],
  "common_mistakes": [
    "肉片不上浆直接下锅，炒出来又干又柴。",
    "木耳泡一整夜，口感发黏且不安全。",
    "三样食材一起下锅，鸡蛋炒老、黄瓜炒烂。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "250g 对 250g",
      "note": "鸡胸肉更易老，滑炒时间减半。"
    },
    {
      "original": "黄瓜",
      "substitute": "荷兰豆",
      "ratio": "100g 对 100g",
      "note": "荷兰豆需先焯水一分钟。"
    }
  ],
  "variations": [
    "加几片胡萝卜同炒，成菜颜色更鲜艳。",
    "换成韭菜段同炒，香气更冲，做成木须韭菜。"
  ],
  "serving_suggestion": "配米饭或卷薄饼吃，家常又下饭。",
  "storage": "冷藏一天，复热用炒锅干煸一分钟即可。",
