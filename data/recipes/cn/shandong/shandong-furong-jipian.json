  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉剔掉白膜和筋膜，片成三毫米厚的薄片，用刀背轻轻砸几下把纤维敲松。",
      "time_min": 8,
      "heat": "无火",
      "tip": "筋膜不剔净，滑油时会卷成硬团，口感全毁。",
      "visual_cue": "鸡片厚薄一致，按下去有弹性"
    },
    {
      "n": 2,
      "text": "鸡片加盐和料酒抓匀，再放蛋清和玉米淀粉顺一个方向搅到发黏，静置十分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "顺一个方向搅才上劲，蛋清和淀粉裹住水分，鸡片才嫩。",
      "visual_cue": "鸡片表面挂一层白浆，泛着光泽"
    },
    {
      "n": 3,
      "text": "高汤里放小葱段和姜片泡十分钟取味，滤掉葱姜，加盐和白胡椒调成清汤。",
      "time_min": 10,
      "heat": "无火",
      "tip": "葱姜只泡不煮，香味清透，煮过会有浊味。",
      "visual_cue": "清汤微黄透明，闻着有葱姜香"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，四成热时把鸡片逐片滑散，变白立刻捞出控油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温不能高，蛋清浆一遇高温就结块发黄，白嫩全失。",
      "visual_cue": "鸡片雪白浮起，边缘不见焦黄"
    },
    {
      "n": 5,
      "text": "锅里留少许底油，倒入调好的清汤烧开，用玉米淀粉加水调成的水淀粉勾薄芡。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芡要薄，能挂住鸡片而不结块，汤色依旧清亮。",
      "visual_cue": "汤汁微稠透亮，勺子舀起呈线状"
    },
    {
      "n": 6,
      "text": "倒回滑好的鸡片轻轻推匀，淋几滴植物油增亮，出锅装盘。",
      "time_min": 2,
      "heat": "小火",
      "tip": "推而不是翻，鸡片嫩，铲子一翻就碎。",
      "visual_cue": "鸡片裹着薄芡，盘面平整不出汤"
    }
  ],
  "tips": [
    "鸡胸肉提前放冰箱冻二十分钟再片，硬一点更容易切得薄而均匀。",
    "滑油用新油，反复用过的油带杂味，会把芙蓉的清鲜盖住。",
    "勾芡后不要再大火滚，芡汁一翻就澥，成菜显得水塌塌。"
  ],
  "common_mistakes": [
    "鸡片顺着纹理切，滑出来卷成筒，咬起来全是筋。",
    "油温升到七八成热才下鸡片，蛋清浆炸成黄壳，失去芙蓉的白。",
    "芡勾得太厚，成菜像糊糊，鸡片黏成一坨夹不开。"
  ],
  "substitutions": [
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "250毫升:250毫升",
      "note": "用清水需加少许盐和白胡椒提味，鲜度略降。"
    },
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "250克:250克",
      "note": "鸡腿肉更嫩但带筋，须彻底剔净，滑油时间缩短半分钟。"
    }
  ],
  "variations": [
    "加五十克虾仁同滑，白上加白，是宴席上的双白版本。",
    "起锅前撒少许火腿末，颜色跳一点，咸鲜也更立体。"
  ],
  "serving_suggestion": "鸡片雪白堆成小山，芡汁透亮挂身，配一小碟香醋蘸食，宴席上作为清口菜安排在荤菜之后。",
  "storage": "当天吃完最好，冷藏不超过一天；复热用蒸锅小火蒸三分钟，直接回锅炒会碎成渣。",
