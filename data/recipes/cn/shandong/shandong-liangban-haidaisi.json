  "steps": [
    {
      "n": 1,
      "text": "干海带用清水泡发两小时，中途换两次水，洗掉表面沙粒和黏液。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡海带别用热水，热水泡出的海带发软没脆劲。",
      "visual_cue": "海带舒展柔软，水色转清"
    },
    {
      "n": 2,
      "text": "泡好的海带卷起来切成三毫米宽的细丝，长度控制在六厘米左右。",
      "time_min": 5,
      "heat": "无火",
      "tip": "卷紧再切，丝才细得均匀，也快得多。",
      "visual_cue": "海带丝粗细一致，不打结"
    },
    {
      "n": 3,
      "text": "汤锅添清水烧开，下海带丝焯三分钟，捞出立刻过凉水沥干。",
      "time_min": 8,
      "heat": "大火",
      "tip": "焯完马上过一遍凉水，海带丝才脆得住。",
      "visual_cue": "海带丝颜色转深绿，手感爽滑"
    },
    {
      "n": 4,
      "text": "大蒜切末，与香醋、生抽、白糖、盐、芝麻油和辣椒油调成料汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "料汁先调好静置两分钟，蒜香才融进醋里。",
      "visual_cue": "料汁红亮，蒜末均匀悬浮"
    },
    {
      "n": 5,
      "text": "海带丝放进拌菜盆，倒入料汁抓拌均匀，撒香菜段和熟白芝麻装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "抓拌比翻拌入味，海带丝才能吃进酸辣味。",
      "visual_cue": "每根海带丝都挂着油亮料汁"
    }
  ],
  "tips": [
    "海带选厚实的根部，比薄叶部分更脆更有嚼头。",
    "焯水时滴几滴米醋，海带更绿也更软。",
    "拌好冷藏十分钟再吃，入味且更爽口。"
  ],
  "common_mistakes": [
    "海带泡得不够久，咬着发硬还带一股沙感。",
    "焯完直接装盘不过凉水，余温把海带焖得发软。",
    "料汁里不放白糖，酸咸冲突，吃着发涩。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "20毫升:20毫升",
      "note": "米醋酸味柔，适合口味清淡的人。"
    },
    {
      "original": "辣椒油",
      "substitute": "干辣椒",
      "ratio": "10毫升:3克",
      "note": "干辣椒剪段用热芝麻油泼香后再拌。"
    }
  ],
  "variations": [
    "加五十克焯熟的绿豆芽同拌，口感更清爽。",
    "喜欢麻香可加两克花椒面，即成麻辣海带丝。"
  ],
  "serving_suggestion": "装小碟上桌，作为开胃凉菜先上，配粥、配面、配酒都合适。",
  "storage": "冷藏可存两天，料汁会析出水分，吃前再拌一次；海带不宜久放，三天后口感发绵。",
