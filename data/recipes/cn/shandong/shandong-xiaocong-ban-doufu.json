  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 400,
          "unit": "g",
          "note": "当天新鲜的老豆腐",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 40,
          "unit": "g",
          "note": "只取葱绿切细丝",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 8,
          "unit": "ml",
          "note": "最后淋入",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "拌碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐整块放进淡盐水里小火煮三分钟，去掉生豆味后捞出沥干晾到温热。",
      "time_min": 4,
      "heat": "小火",
      "tip": "整块煮而不是切块煮，豆腐才不会吸进太多水而口感发水。",
      "visual_cue": "豆腐表面紧实，闻起来没有生豆味。"
    },
    {
      "n": 2,
      "text": "豆腐放凉到不烫手，用手在碗里掰成不规则的小块，比刀切更挂味。",
      "time_min": 3,
      "heat": "无火",
      "tip": "手掰的断面粗糙，更容易吸附盐和香油的味道。",
      "visual_cue": "豆腐块断面粗糙，大小均匀。"
    },
    {
      "n": 3,
      "text": "小葱洗净沥干，只取葱绿斜切成细丝，松松地铺在豆腐块上。",
      "time_min": 4,
      "heat": "无火",
      "tip": "葱绿切好别提前拌，现吃现拌才不塌不蔫。",
      "visual_cue": "葱丝翠绿蓬松，铺满豆腐表面。"
    },
    {
      "n": 4,
      "text": "撒盐后沿碗边淋入香油，上桌前用筷子从下往上轻翻两下拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌的时候动作要轻，翻两下就够，拌多了豆腐出水发碎。",
      "visual_cue": "豆腐挂上油光，葱丝均匀分布。"
    }
  ],
  "tips": [
    "选当天做的北豆腐，质地紧实，拌完也不出水。",
    "葱绿要切得细，比切段更容易和豆腐贴合入味。",
    "香油从碗边淋入，拌时才不会一下堆在豆腐上。"
  ],
  "common_mistakes": [
    "用内酯豆腐来拌，一搅就成糊，完全没有口感可言。",
    "葱丝切好提前拌进豆腐，上桌前已经塌软出水。",
    "盐直接撒在葱上没拌匀，一口咸一口淡很不均匀。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "豆腐皮",
      "ratio": "400克:200克",
      "note": "换成焯过的豆腐皮切丝，更有嚼劲也更耐放。"
    },
    {
      "original": "香油",
      "substitute": "花生油",
      "ratio": "8毫升:8毫升",
      "note": "烧热放凉的花生油也可，香气淡一些。"
    }
  ],
  "variations": [
    "春天加一把焯水的香椿末，就是清鲜的香椿拌豆腐。",
    "喜欢重口的可加一小勺虾酱，咸鲜味立刻浓起来。"
  ],
  "serving_suggestion": "小葱拌豆腐装浅盘即可上桌，作为夏天的开胃凉菜配粥最合适。",
  "storage": "拌好当餐吃完，冷藏过夜会出水发酸，不建议留到第二天。",
