  "equipment": [
    "炒锅",
    "漏勺",
    "厨房纸",
    "深盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小黄鱼刮鳞去鳃，从腹部划开取出内脏，冲洗干净后用厨房纸把鱼身内外擦干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱼腹里的黑膜一定要刮净，那是腥味最重的地方。",
      "visual_cue": "鱼身干爽，腹腔无黑膜"
    },
    {
      "n": 2,
      "text": "鱼身两面各划两刀，抹上盐、料酒和白胡椒，塞入姜丝与葱段腌十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "划两刀能让咸味渗进厚肉处，炸的时候也熟得均匀。",
      "visual_cue": "鱼身见细刀口，表面挂调味料"
    },
    {
      "n": 3,
      "text": "玉米淀粉和面粉按二比一混匀，把腌好的鱼逐条拍上一层干粉，抖掉多余的粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉要拍薄拍匀，裹太厚下锅会脱壳、里面还是湿的。",
      "visual_cue": "鱼身覆一层薄白粉，不结块"
    },
    {
      "n": 4,
      "text": "植物油烧到六成热，提着鱼尾逐条下锅，中火炸三分钟到定型金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅后别急着翻，等底面结壳再用筷子推，鱼皮才不破。",
      "visual_cue": "鱼身金黄浮起，外形挺直"
    },
    {
      "n": 5,
      "text": "捞出沥油，把植物油温升到七成，全部鱼回锅复炸四十秒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "复炸是酥的关键，油温够高才能把外壳里的油逼出来。",
      "visual_cue": "外壳深金黄，敲着有脆响"
    },
    {
      "n": 6,
      "text": "捞出放在厨房纸上吸掉浮油，装盘配一小碟椒盐上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热撒一点椒盐在鱼身上，比只蘸着吃更香。",
      "visual_cue": "鱼身干爽不渗油，椒盐雪白"
    }
  ],
  "tips": [
    "小黄鱼越小越嫩，选一斤六七条的个头最合适。",
    "腌鱼的葱姜别裹进锅里，容易炸焦发苦。",
    "炸两遍比一次炸透更酥，第一遍熟、第二遍脆。"
  ],
  "common_mistakes": [
    "鱼身带水就拍粉，粉层结成硬块，炸完一碰就掉。",
    "油温太低就下鱼，鱼皮粘锅，捞起来只剩半条。",
    "只炸一遍就上桌，放两分钟外壳回软，咬着发韧。"
  ],
  "substitutions": [
    {
      "original": "黄鱼",
      "substitute": "带鱼",
      "ratio": "600克:600克",
      "note": "带鱼切段同样拍粉酥炸，时间延长一分钟。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "红薯淀粉",
      "ratio": "60克:55克",
      "note": "红薯淀粉更脆，用量略减以免外壳过厚。"
    }
  ],
  "variations": [
    "喜欢重口可在粉里加辣椒粉和花椒面，做成香辣酥鱼。",
    "炸好浇一勺糖醋汁，就是另一道糖醋小黄鱼。"
  ],
  "serving_suggestion": "鱼头朝外摆成扇形，配椒盐和一小碟香醋，作为下酒菜或宴席的热菜上桌都合适。",
  "storage": "现炸现吃最佳，冷藏不超过一天；复热用烤箱二百度烤六分钟，别用微波炉。",
