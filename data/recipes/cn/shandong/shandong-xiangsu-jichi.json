  "steps": [
    {
      "n": 1,
      "text": "鸡翅洗净擦干，在厚肉处划两刀，方便入味也易熟透。",
      "time_min": 8,
      "heat": "无火",
      "tip": "划刀别太深，划破皮炸的时候会流失肉汁。",
      "visual_cue": "鸡翅表面有两道浅口，肉未翻出。"
    },
    {
      "n": 2,
      "text": "加生抽、料酒、盐、白胡椒、姜片、葱段和花椒抓匀，冷藏腌三十分钟。",
      "time_min": 30,
      "heat": "无火",
      "tip": "腌够半小时再炸，肉里才有底味，短了只是表面咸。",
      "visual_cue": "鸡翅裹满料汁，颜色微深。"
    },
    {
      "n": 3,
      "text": "腌好的鸡翅拣去葱姜，逐只拍上一层薄薄的玉米淀粉，静置五分钟回潮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拍淀粉后等回潮再炸，外壳才不会脱、外壳才酥。",
      "visual_cue": "鸡翅表面淀粉层薄而均匀，摸着微湿。"
    },
    {
      "n": 4,
      "text": "锅中放植物油烧到六成热，鸡翅逐个下锅，中火炸六分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温到六成再下，太低鸡翅吸油发腻，太高外焦里生。",
      "visual_cue": "鸡翅浮起，外壳浅金黄。"
    },
    {
      "n": 5,
      "text": "捞出沥油静置三分钟，再把油温升到八成热复炸一分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "复炸是外壳酥脆的关键，能让表皮的水汽逼出来。",
      "visual_cue": "外壳深金黄，敲着发脆响。"
    },
    {
      "n": 6,
      "text": "捞出放在厨房纸上吸油，趁热撒少许盐和花椒面装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热撒料才挂得住，凉了粉撒上去会掉。",
      "visual_cue": "鸡翅干爽不渗油，表面有细花椒面。"
    }
  ],
  "tips": [
    "鸡翅厚肉处划上两刀，既能让腌料入味，也能保证炸透。",
    "拍完薄粉后静置五分钟回潮，炸的时候外壳才不会脱粉。",
    "炸两遍：先中火炸熟，再大火复炸逼出水汽，皮才酥。"
  ],
  "common_mistakes": [
    "鸡翅没擦干就下油锅，油花四溅还容易溅伤人。",
    "粉拍得太厚，炸出来外壳硬得像壳子，咬着费劲。",
    "只炸一遍就出锅，凉两分钟皮就软塌，一点不酥。"
  ],
  "substitutions": [
    {
      "original": "玉米淀粉",
      "substitute": "玉米淀粉",
      "ratio": "30克:30克",
      "note": "换成红薯淀粉，炸出的壳更脆更持久。"
    },
    {
      "original": "鸡翅",
      "substitute": "鸡腿肉",
      "ratio": "800克:700克",
      "note": "用去骨鸡腿肉切条炸，做成香酥鸡柳，孩子更爱吃。"
    }
  ],
  "variations": [
    "腌料里加一小勺腐乳汁，炸出来带独特酱香。",
    "撒料换成椒盐和辣椒粉，就是街边风味的椒盐鸡翅。"
  ],
  "serving_suggestion": "香酥鸡翅炸好趁热吃，配一杯冰饮或一碟椒盐，是家里来客人时最受欢迎的零嘴。",
  "storage": "炸好的鸡翅冷藏可存一天，复热用烤箱二百度烤六分钟，别用微波炉。",
