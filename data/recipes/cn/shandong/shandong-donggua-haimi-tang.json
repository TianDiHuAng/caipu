  "steps": [
    {
      "n": 1,
      "text": "冬瓜去皮去瓤，切成两厘米厚的片，边缘修整齐。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冬瓜皮削厚一点，靠近皮的纤维硬。",
      "visual_cue": "冬瓜片半透明，表面水润。"
    },
    {
      "n": 2,
      "text": "虾米用温水泡十分钟，泡的水留着一起下锅。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡虾米的水是鲜味来源，别倒掉。",
      "visual_cue": "虾米变软，水呈淡黄色。"
    },
    {
      "n": 3,
      "text": "锅里倒花生油，下姜丝与虾米小火煸出香味。",
      "time_min": 6,
      "heat": "小火",
      "tip": "虾米煸过才香，火大容易焦苦。",
      "visual_cue": "虾米卷曲，锅里冒香气。"
    },
    {
      "n": 4,
      "text": "倒入泡虾米的水与高汤，煮开后放入冬瓜片同煮。",
      "time_min": 8,
      "heat": "中火",
      "tip": "汤要没过冬瓜，煮出来才透。",
      "visual_cue": "冬瓜片半浮在汤里。"
    },
    {
      "n": 5,
      "text": "中小火煮十二分钟，煮到冬瓜透明、用筷子能戳透。",
      "time_min": 14,
      "heat": "中小火",
      "tip": "冬瓜别煮烂，透明就差不多了。",
      "visual_cue": "冬瓜片透亮，边缘微融。"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，撒葱花与香菜，淋香油出锅。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冬瓜出水多，盐要比平时少。",
      "visual_cue": "汤清见底，葱花漂在面上。"
    }
  ],
  "tips": [
    "虾米选个头大、颜色金黄的，鲜味足。",
    "冬瓜切厚片更耐煮，薄片容易化在汤里。",
    "夏天喝可以不放高汤，清水加虾米也很鲜。"
  ],
  "common_mistakes": [
    "虾米不泡就下锅炒，又硬又咸，鲜味也出不来。",
    "冬瓜煮到完全化开，汤水变成一锅糨糊。"
  ],
  "substitutions": [
    {
      "original": "虾米",
      "substitute": "干贝",
      "ratio": "80g 对 60g",
      "note": "干贝须提前蒸软撕丝，鲜味更浓。"
    }
  ],
  "variations": [
    "加一把粉丝同煮，粉丝吸饱汤，一碗就能当饭。"
  ],
  "serving_suggestion": "清汤上桌，夏天配凉面，冬天配馒头。",
  "storage": "冷藏两天，复热时加少量清水，冬瓜会继续出水。",
