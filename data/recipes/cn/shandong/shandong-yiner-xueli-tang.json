  "equipment": [
    "汤锅",
    "剪刀",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "银耳用冷水泡发四十分钟，泡到完全舒展、根部发软。",
      "time_min": 40,
      "heat": "无火",
      "tip": "冷水泡发的银耳出胶更好，别用热水。",
      "visual_cue": "银耳体积涨大三倍，边缘半透明。"
    },
    {
      "n": 2,
      "text": "剪去银耳根部的黄色硬蒂，撕成小朵，越小越容易出胶。",
      "time_min": 10,
      "heat": "无火",
      "tip": "硬蒂不去掉，煮多久都不会糯。",
      "visual_cue": "银耳撕成拇指大的小朵。"
    },
    {
      "n": 3,
      "text": "梨洗净去核，带皮切成滚刀块，皮留着汤更香。",
      "time_min": 8,
      "heat": "无火",
      "tip": "梨皮有清润的香气，别削掉。",
      "visual_cue": "梨块白净，边缘完整。"
    },
    {
      "n": 4,
      "text": "锅里加清水，放银耳大火煮开后转小火炖三十分钟。",
      "time_min": 35,
      "heat": "小火",
      "tip": "这半小时是出胶关键，中途别加冷水。",
      "visual_cue": "汤汁开始变稠，银耳变软。"
    },
    {
      "n": 5,
      "text": "加梨块与红枣继续小火炖二十分钟至梨肉透明。",
      "time_min": 22,
      "heat": "小火",
      "tip": "梨炖到透明才算到位，汤会带梨香。",
      "visual_cue": "梨块半透明，汤色微黄。"
    },
    {
      "n": 6,
      "text": "放冰糖与枸杞，煮到冰糖完全融化，关火焖十分钟。",
      "time_min": 13,
      "heat": "小火",
      "tip": "冰糖最后放，甜味更清亮。",
      "visual_cue": "汤体挂勺，银耳软糯拉丝。"
    }
  ],
  "tips": [
    "银耳要选颜色微黄、朵大的，太白的可能熏过硫。",
    "撕得越碎越容易出胶，别嫌麻烦。",
    "冷藏后喝更清润，夏天可当甜品。"
  ],
  "common_mistakes": [
    "银耳泡发不充分就煮，怎么炖都是脆的。",
    "全程大火，汤汁蒸发快，银耳还没出胶。"
  ],
  "substitutions": [
    {
      "original": "冰糖",
      "substitute": "红糖",
      "ratio": "60g 对 50g",
      "note": "红糖版颜色发褐，风味更浓。"
    }
  ],
  "variations": [
    "加一小把百合或莲子同炖，清润的效果更好，是山东秋冬常见的搭配。"
  ],
  "serving_suggestion": "温热喝或冷藏后喝，作餐后甜汤。",
  "storage": "冷藏三天，银耳汤不宜反复加热，取用干净勺子。",
