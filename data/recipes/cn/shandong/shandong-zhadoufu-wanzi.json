  "equipment": [
    "炒锅",
    "漏勺",
    "大碗",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐放在漏盆里压上重物，静置二十分钟压出多余水分，再用手捏碎成豆腐泥。",
      "time_min": 22,
      "heat": "无火",
      "tip": "水分压得越干，丸子越不容易散，炸时也少溅油。",
      "visual_cue": "豆腐泥松散不滴水，捏一把能成团。"
    },
    {
      "n": 2,
      "text": "豆腐泥里加鸡蛋、葱花、姜末、胡萝卜末、盐和花椒粉，顺一个方向拌到起黏性。",
      "time_min": 6,
      "heat": "无火",
      "tip": "顺同一方向拌才上劲，来回乱拌丸子容易开裂。",
      "visual_cue": "豆腐泥黏稠抱团，拌起来明显费力。"
    },
    {
      "n": 3,
      "text": "分次撒入面粉继续拌匀，直到豆腐泥能轻松搓成乒乓球大小的丸子。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面粉分次加，太多丸子发硬，太少下锅就散。",
      "visual_cue": "丸子表面光滑，搓好不粘手。"
    },
    {
      "n": 4,
      "text": "锅中植物油烧到六成热，逐个下丸子，中小火炸到浮起并呈金黄色。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "下锅后先别急着推，等外壳定型再用漏勺轻轻拨开粘连。",
      "visual_cue": "丸子浮在油面，外壳金黄鼓胀。"
    },
    {
      "n": 5,
      "text": "捞出的丸子放在厨房纸上吸去浮油，趁热装盘即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "起锅后立着沥一会儿油，丸子外壳才不会回软。",
      "visual_cue": "丸子外壳干脆，纸巾上油迹不多。"
    }
  ],
  "tips": [
    "豆腐一定要压干水分，这是丸子能否成形最关键的一步。",
    "面粉分次加入，边加边试搓，手感比死记克数更可靠。",
    "油温控制在六成，太高外面焦黑里面还是湿的。"
  ],
  "common_mistakes": [
    "豆腐没压水就直接拌，丸子下锅立刻散成一锅渣。",
    "面粉一次倒太多，丸子又硬又死，吃不出豆腐的嫩。",
    "油温太高下锅，外壳焦黑而内部仍是生面糊状。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "北豆腐",
      "ratio": "500克:500克",
      "note": "也可掺三成豆腐皮碎，口感更松脆有层次。"
    },
    {
      "original": "面粉",
      "substitute": "玉米淀粉",
      "ratio": "60克:50克",
      "note": "用玉米淀粉代替面粉，外皮更脆且不含麸质。"
    }
  ],
  "variations": [
    "淄博人家会在丸子里拌入虾皮末，鲜味更足，盐要减半。",
    "把炸改成蒸，做成豆腐丸子汤，清爽不少，适合老人。"
  ],
  "serving_suggestion": "炸豆腐丸子趁热吃最香，可蘸椒盐或蒜泥汁，配小米粥解腻。",
  "storage": "冷藏两天，复热时用空气炸锅一百八十度烤五分钟，能恢复脆壳。",
