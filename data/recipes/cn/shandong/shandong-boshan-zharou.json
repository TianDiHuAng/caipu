  ],
  "equipment": [
    "炒锅",
    "漏勺",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊顺着纹理切成小指粗的条，加盐、拍碎的花椒和料酒抓匀腌二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "顺纹切条炸后才不散，逆纹切容易断成一截截。",
      "visual_cue": "肉条粗细均匀、表面发黏"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加淀粉和面粉搅成能挂住筷子的稠糊，静置五分钟消泡。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糊要稠到能挂住肉条，太稀炸出来只剩干皮。",
      "visual_cue": "糊体细腻、能挂住筷子"
    },
    {
      "n": 3,
      "text": "锅中倒植物油烧到六成热，筷子插进去周围冒起细密小泡。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温不够肉条吸油，太高则外焦里生。",
      "visual_cue": "筷子周围细密气泡"
    },
    {
      "n": 4,
      "text": "肉条逐根裹上糊下锅炸三分钟，浮起且外壳浅黄时捞出沥油。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "逐根下锅才不会粘成一团，条形也完整。",
      "visual_cue": "外壳浅金黄、肉条浮起"
    },
    {
      "n": 5,
      "text": "把油温升到七成热，倒回肉条复炸三十秒，捞出控干油分。",
      "time_min": 1,
      "heat": "大火",
      "tip": "复炸这三十秒是外酥里嫩的关键，别省这一步。",
      "visual_cue": "外壳深金黄、敲击有脆响"
    },
    {
      "n": 6,
      "text": "装盘后趁热撒上椒盐，上桌前一分钟撒完，趁热吃外壳最酥脆。",
      "time_min": 1,
      "heat": "无火",
      "tip": "椒盐撒早了会返潮，上桌前一分钟撒最好。",
      "visual_cue": "表面均匀挂上椒盐粒"
    }
  ],
  "tips": [
    "博山炸肉讲究糊薄肉厚，挂糊只要裹住表面一层就够。",
    "腌肉时花椒拍碎再拌，麻香才渗得进肉里。",
    "一次多炸些可冷冻保存，吃时复炸二十秒即可恢复酥脆。"
  ],
  "common_mistakes": [
    "糊调得太稀，下锅后糊浆脱落，成了干炸肉条。",
    "油温过低下锅，肉条吸满油，吃起来满口油腻。",
    "腌肉不放花椒只用盐，缺少博山炸肉特有的麻香。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "猪颈肉",
      "ratio": "350g 对 350g",
      "note": "猪颈肉带脂肪，炸后更嫩，需多炸半分钟。"
    },
    {
      "original": "椒盐",
      "substitute": "花椒粉加盐",
      "ratio": "5g 对 2g 加 3g",
      "note": "现炒花椒碾碎拌盐，香气比成品椒盐更足。"
    }
  ],
  "variations": [
    "糊里加一勺啤酒代替部分清水，外壳更蓬松。",
    "起锅前撒少许五香粉，做成五香炸肉。"
  ],
  "serving_suggestion": "垫吸油纸装盘，配山东煎饼卷食或直接下酒。",
  "storage": "冷藏两天，冷冻一个月，复炸后风味接近现炸。",
