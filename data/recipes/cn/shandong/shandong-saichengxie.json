  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛋黄和蛋清分别磕进两个碗里，各用筷子打散打匀，蛋黄碗里不要混进蛋清。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋黄和蛋清分开炒才有黄白两色，混在一起就只能算普通的炒法。",
      "visual_cue": "两碗颜色分明，表面起细泡"
    },
    {
      "n": 2,
      "text": "咸蛋黄用刀背压成细泥，加进蛋黄里搅匀，让颜色更深更黄亮。",
      "time_min": 3,
      "heat": "无火",
      "tip": "咸蛋黄压得越细越匀，成品颜色才够黄亮。",
      "visual_cue": "蛋黄液呈橙黄色，看不见颗粒"
    },
    {
      "n": 3,
      "text": "姜去皮切成极细的末，加香醋、白糖、盐和料酒调成姜醋汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "姜末要细到入口不硌牙，靠它撑起这道菜的鲜气。",
      "visual_cue": "姜醋汁酸香冲鼻，姜末沉在碗底"
    },
    {
      "n": 4,
      "text": "玉米淀粉加高汤调开，倒进姜醋汁里搅匀备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "芡汁先调好再下锅，边炒边调汤汁就老了。",
      "visual_cue": "汁液乳白微稠，无结块"
    },
    {
      "n": 5,
      "text": "炒锅烧热放一半花生油，倒入蛋黄小火推炒，炒到凝成小块、散出油香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "小火慢推，蛋黄才结成块状而不是变成碎渣。",
      "visual_cue": "蛋黄凝成橙黄小块，颗粒分明"
    },
    {
      "n": 6,
      "text": "补入剩下的花生油，倒入蛋清推炒到刚刚凝固发白，再把结好的蛋黄块倒回锅里。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蛋清一凝固就停手，炒过头会出水发硬。",
      "visual_cue": "蛋清雪白成片，与蛋黄块分明"
    },
    {
      "n": 7,
      "text": "淋入调好的姜醋汁快速翻匀，汤汁收紧裹住蛋黄块即可出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "醋汁最后下，翻两下就出锅，久炒酸味飞散只剩涩。",
      "visual_cue": "蛋黄块油亮，汤汁挂身不流盘"
    }
  ],
  "tips": [
    "咸蛋黄是提味的关键，没有它只有酸咸，缺那股蟹黄的厚味。",
    "姜末和香醋的比例约一比一点五，酸要压过辣，才有吃蟹蘸醋的感觉。",
    "锅用铁锅或不粘锅都行，但锅一定要烧透再下油，否则蛋液粘底。"
  ],
  "common_mistakes": [
    "两种蛋液混在一起炒，颜色一片淡黄，看着就不像蟹肉蟹黄。",
    "姜切成了姜丝，入口一咬满嘴辛辣，把鲜味全盖住。",
    "醋汁早早倒进锅里同炒，酸味挥发殆尽，只剩一股闷味。"
  ],
  "substitutions": [
    {
      "original": "咸蛋黄",
      "substitute": "咸鸭蛋",
      "ratio": "60克:1枚",
      "note": "整枚咸蛋取黄压泥，蛋白另作他用，咸度更足需减盐。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "30毫升:32毫升",
      "note": "米醋酸味柔和，可多加两毫升补足酸度。"
    }
  ],
  "variations": [
    "加五十克拆好的鱼肉同炒，鲜味更接近真蟹，是胶东沿海的做法。",
    "喜欢浓郁口感的，起锅前加一小块黄油化开，奶香与醋香撞出层次。"
  ],
  "serving_suggestion": "盛在浅盘里，黄白相间，趁热配米饭吃，一勺下去酸香扑鼻，最解腻。",
  "storage": "现炒现吃，冷藏可放一天；复热用不粘锅小火翻炒一分钟，微波炉加热会让蛋块出水发韧。",
