  "equipment": [
    "炒锅",
    "汤锅",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "木耳用温水泡发二十分钟，洗净后切成细丝备用。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡发到位才软糯，硬梗要摘掉。",
      "visual_cue": "木耳舒展柔软、无硬根"
    },
    {
      "n": 2,
      "text": "猪肉末加料酒与少许盐抓匀，静置十分钟让它入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "肉末先腌，卤汁才不腥。",
      "visual_cue": "肉末松散、带淡淡酒香"
    },
    {
      "n": 3,
      "text": "炒锅下植物油烧热，下猪肉末中火煸炒到变色出油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "炒到肉末粒粒分明再加料。",
      "visual_cue": "肉末散开、锅底见油"
    },
    {
      "n": 4,
      "text": "下生姜末与木耳丝一起翻炒两分钟，炒出香味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "木耳遇热会爆响，注意别被溅到。",
      "visual_cue": "木耳丝变软、香气散出"
    },
    {
      "n": 5,
      "text": "加生抽、老抽、白糖与盐，倒入清水烧开成卤汤。",
      "time_min": 4,
      "heat": "大火",
      "tip": "生抽调味老抽提色，比例别弄反。",
      "visual_cue": "汤色红褐、咸香扑鼻"
    },
    {
      "n": 6,
      "text": "转中火煮三分钟，玉米淀粉兑水淋入搅成浓稠卤汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "边淋边搅，卤才不会结块。",
      "visual_cue": "卤汁浓稠、勺背挂满浆"
    },
    {
      "n": 7,
      "text": "蛋液细线状淋入卤中推成蛋花，撒白胡椒与葱花离火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "卤汁要保持微沸，蛋花才成片。",
      "visual_cue": "蛋花成絮、卤面光亮"
    },
    {
      "n": 8,
      "text": "汤锅烧开清水加盐，面条下锅煮三分钟至熟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水里加盐，面条更有底味。",
      "visual_cue": "面条浮起、咬开无白芯"
    },
    {
      "n": 9,
      "text": "面条捞出沥干装碗，浇上滚烫的卤汁即可上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "卤要浇得满过面条，拌开才香。",
      "visual_cue": "卤汁覆盖面条、葱花点缀"
    }
  ],
  "tips": [
    "卤汁勾得稍稠些，浇在面上才挂得住。",
    "面条选手擀的粗面，拌卤不易断。",
    "加几朵金针菇同卤，口感更丰富一些。"
  ],
  "common_mistakes": [
    "卤汁勾得太稀，浇上去全流到碗底。",
    "蛋液在滚沸的卤里猛搅，蛋花碎成蛋渣。",
    "面条煮好过凉水，表面糊化层掉了不吃味。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "150g 对 150g",
      "note": "需加一勺清水，口感更嫩。"
    },
    {
      "original": "木耳",
      "substitute": "香菇",
      "ratio": "20g 对 80g",
      "note": "切丝后卤制，鲜味更浓。"
    }
  ],
  "variations": [
    "加一把黄花菜同卤，是最传统的山东做法。",
    "卤汁里加一小勺虾皮，鲜味层次更足。"
  ],
  "serving_suggestion": "卤汁要浇得厚，趁热拌开吃才最香。",
  "storage": "卤汁冷藏可放两天，面条须当天煮。",
