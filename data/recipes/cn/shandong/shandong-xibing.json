  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 3,
          "unit": "piece",
          "note": "打散备用，约一百五十克",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "喜饼偏甜，可按口味减",
          "optional": false
        },
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 80,
          "unit": "ml",
          "note": "和面用",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 100,
          "unit": "ml",
          "note": "温的，帮助发酵",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 5,
          "unit": "g",
          "note": "先用牛奶化开",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "案板",
    "擀面杖",
    "平底锅",
    "锅盖",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛奶加热到温热后化开酵母和白糖，静置到表面浮起细密泡沫。",
      "time_min": 8,
      "heat": "无火",
      "tip": "牛奶太烫会烫死酵母，手背试着温而不烫最合适。",
      "visual_cue": "表面浮起一层细泡，闻着有淡淡奶香。"
    },
    {
      "n": 2,
      "text": "面粉里倒入酵母牛奶、打散的鸡蛋和花生油，揉成偏软的光滑面团。",
      "time_min": 15,
      "heat": "无火",
      "tip": "喜饼面团比馒头软，油和蛋多，揉到能拉出薄膜更好。",
      "visual_cue": "面团柔软有光泽，按压留下明显手印。"
    },
    {
      "n": 3,
      "text": "面团盖布放在温暖处发酵到接近两倍大，内部呈均匀蜂窝状。",
      "time_min": 70,
      "heat": "无火",
      "tip": "发酵到八分就够，发过头会带酸味，压模时也容易塌。",
      "visual_cue": "体积明显变大，掰开内部气孔均匀。"
    },
    {
      "n": 4,
      "text": "发好的面团排气后分成四份，滚圆按扁擀成约一厘米厚的圆饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "擀的时候厚薄要匀，太薄烙完发硬，太厚中间不熟。",
      "visual_cue": "圆饼厚薄一致，边缘圆润。"
    },
    {
      "n": 5,
      "text": "平底锅小火把饼两面烙到浅黄定型，再移入一百七十度烤箱烤熟。",
      "time_min": 18,
      "heat": "小火",
      "tip": "先烙定型再烤，饼身能立住不塌，受热也更均匀。",
      "visual_cue": "两面浅金定型，饼身微微鼓起。"
    }
  ],
  "tips": [
    "喜饼面团油多蛋多，软一点成品才松软。",
    "发酵到八分足矣，发过头会有明显酸味。",
    "先在平底锅烙定型再进烤箱，饼形挺拔不会塌陷。"
  ],
  "common_mistakes": [
    "酵母被烫牛奶烫死，面团发了半天一点也不长。",
    "面团发过头带酸味，烤出来还有股酒气。",
    "全用大火烙，外皮焦黑而中心仍是湿面糊。"
  ],
  "substitutions": [
    {
      "original": "花生油",
      "substitute": "玉米油",
      "ratio": "80毫升:80毫升",
      "note": "玉米油味淡，不抢蛋香，适合口味清淡的人。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "100毫升:95毫升",
      "note": "用水替代奶味变淡，可加十克奶粉补香。"
    }
  ],
  "variations": [
    "有的做法在面团里加几粒炒熟的白芝麻，香气更足。",
    "胶东各地喜饼大小不一，小个头的更易烤透。"
  ],
  "serving_suggestion": "喜饼凉透后切片摆盘，配茶或豆浆，婚宴上也常成对送给亲友。",
  "storage": "密封常温存放三到五天，冷藏可一周；回温后口感更松软。",
