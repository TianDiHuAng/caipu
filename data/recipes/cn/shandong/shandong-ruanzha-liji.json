  "steps": [
    {
      "n": 1,
      "text": "猪里脊片成一厘米厚的大片，再改刀切成一厘米宽、五厘米长的条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆着肉的纹理下刀，炸出来才不塞牙。",
      "visual_cue": "肉条粗细一致，边角整齐"
    },
    {
      "n": 2,
      "text": "肉条加料酒、盐和白胡椒粉抓匀，静置十五分钟入味。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌够时间肉条里外才有味，短了只是表面咸。",
      "visual_cue": "肉条表面微微发黏，闻着有酒香"
    },
    {
      "n": 3,
      "text": "鸡蛋打散，加玉米淀粉和面粉拌成能挂住筷子的稠糊，静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糊调好后静置，粉粒吸水膨开，炸出来才软。",
      "visual_cue": "面糊顺滑无颗粒，能拉出短丝"
    },
    {
      "n": 4,
      "text": "花椒和盐下干锅小火炒到盐微黄、花椒出香，擀成椒盐备用。",
      "time_min": 3,
      "heat": "小火",
      "tip": "椒盐要现炒现擀，放久了只剩下咸味。",
      "visual_cue": "椒盐颗粒细匀，香气冲鼻"
    },
    {
      "n": 5,
      "text": "花生油烧到六成热，肉条逐根裹糊下锅，中火炸到浅黄浮起捞出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一根根分开下锅，粘成一坨就不好分开。",
      "visual_cue": "外壳浅黄挂匀，肉条根根分明"
    },
    {
      "n": 6,
      "text": "油温升到七成热，全部倒回锅里复炸四十秒，复炸用植物油，捞出沥油撒椒盐。",
      "time_min": 2,
      "heat": "大火",
      "tip": "复炸只求外壳脆，时间一长肉就柴了。",
      "visual_cue": "外壳金黄酥松，敲着发脆声"
    }
  ],
  "tips": [
    "里脊要选整条无筋膜的，筋膜炸后会硬。",
    "面糊里加半勺油，炸出来的壳更松脆。",
    "蘸料除椒盐外，配一碟甜面酱也很山东。"
  ],
  "common_mistakes": [
    "面糊调得太稀，挂不住肉条，一下锅就脱浆。",
    "油温不到就下锅，肉条沉底粘锅还吸满油。",
    "只炸一遍就上桌，凉两分钟外壳就软塌。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "400克:400克",
      "note": "鸡胸肉拍松再切条，腌制时加一勺清水保嫩。"
    },
    {
      "original": "花生油",
      "substitute": "玉米油",
      "ratio": "240毫升:240毫升",
      "note": "玉米油清亮无味，不影响椒盐香。"
    }
  ],
  "variations": [
    "面糊里加十克炒熟的芝麻，外壳更香更脆。",
    "换成里脊薄片做软炸肉片，炸制时间缩短到一分钟。"
  ],
  "serving_suggestion": "趁热装盘，配椒盐碟上桌，也可以蘸甜面酱或番茄酱，孩子更爱吃。",
  "storage": "现炸现吃最佳，冷藏可存一天，复热需用一百八十度烤箱烤六分钟回脆。",
