    "碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干木耳用温水泡四十分钟，泡开后撕成小朵并反复冲洗干净。",
      "time_min": 40,
      "heat": "无火",
      "tip": "木耳别用热水急泡，口感发软还带土腥味。",
      "visual_cue": "木耳舒展厚实，根部泥沙洗净"
    },
    {
      "n": 2,
      "text": "鸡蛋磕入碗中加料酒与少许盐打散，小葱切成三厘米长段。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液里加料酒，腥味散得干净还更蓬松。",
      "visual_cue": "蛋液均匀发亮，无成团蛋清"
    },
    {
      "n": 3,
      "text": "木耳下沸水焯一分钟捞出沥干，这一步能防下锅炸油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "不焯水的木耳一下锅就会噼里啪啦溅油。",
      "visual_cue": "木耳滑亮有弹性，水滴控干"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，倒入蛋液炒成大块蛋花后盛出备用。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蛋液半熟就要盛出，回锅再炒一下刚好嫩滑。",
      "visual_cue": "蛋花金黄蓬松，块大不碎"
    },
    {
      "n": 5,
      "text": "原锅留底油下姜丝与葱段爆香，倒入木耳大火翻炒一分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "木耳遇热会蹦，翻得勤一些并用锅盖挡一下。",
      "visual_cue": "木耳翻动弹跳，香气散出"
    },
    {
      "n": 6,
      "text": "倒回炒好的蛋花，加盐与生抽翻匀，淋香油出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "最后加盐，蛋花才不会提前出水发韧。",
      "visual_cue": "蛋花与木耳混匀，油亮不塌"
    }
  ],
  "tips": [
    "泡木耳的水里加一勺面粉，泥沙更容易洗掉。",
    "想让蛋更嫩，打蛋时加一勺清水一起打。",
    "加几片黄瓜同炒，颜色清亮，夏天吃更爽口。"
  ],
  "common_mistakes": [
    "木耳泡发时间过长甚至过夜，容易滋生细菌。",
    "油不够热就倒蛋液，蛋摊成一片不成花。",
    "木耳下锅前不焯水，热油四溅，容易烫手。"
  ],
  "substitutions": [
    {
      "original": "木耳",
      "substitute": "银耳",
      "ratio": "90克:90克",
      "note": "银耳泡发后略焯，口感更脆爽。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鹌鹑蛋",
      "ratio": "3个:9个",
      "note": "鹌鹑蛋先煮熟剥壳再下锅。"
    }
  ],
  "variations": [
    "加一把韭菜段一起炒，绿黄相间，山东人最爱这个搭配。",
    "把生抽换成蚝油，鲜味更厚，孩子更爱吃。"
  ],
  "serving_suggestion": "热吃最佳，配米饭、馒头或面条浇头都合适，也可夹进饼里。",
  "storage": "冷藏不超过一天，复热须回锅快炒，微波加热蛋花会变硬。",
