  "equipment": [
    "擀面杖",
    "大盆",
    "汤锅",
    "纱布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加 200ml 清水与 10ml 植物油揉成偏硬面团，盖湿布醒 30 分钟。",
      "time_min": 35,
      "heat": "无火",
      "tip": "面团偏硬，擀出的皮才不粘不破。",
      "visual_cue": "面团光滑不粘手、按压有回弹"
    },
    {
      "n": 2,
      "text": "鲅鱼去骨取净肉，用勺子顺一个方向刮成鱼泥，挑净残留细刺。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刮比剁更能保留鱼肉纤维的弹。",
      "visual_cue": "鱼泥细腻、无刺无皮"
    },
    {
      "n": 3,
      "text": "鱼泥加五花肉泥、姜末、葱末、白胡椒与料酒，分三次加 80ml 清水顺向搅打上劲。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水分次加，鱼肉才能吃足水变嫩。",
      "visual_cue": "馅料黏稠拉丝、能抱成团"
    },
    {
      "n": 4,
      "text": "加蛋清与 8g 盐继续搅 3 分钟，最后拌入韭菜末与香油，冷藏 20 分钟。",
      "time_min": 23,
      "heat": "无火",
      "tip": "韭菜最后拌，久拌会出水。",
      "visual_cue": "馅料泛白蓬松、闻着鲜不腥"
    },
    {
      "n": 5,
      "text": "面团搓条切 8g 小剂子，擀成薄圆皮，包入 12g 馅料对折捏紧成月牙形。",
      "time_min": 20,
      "heat": "无火",
      "tip": "皮薄馅大是鲅鱼饺子的特点。",
      "visual_cue": "饺子肚圆皮薄、封口紧实"
    },
    {
      "n": 6,
      "text": "汤锅加 2000ml 水烧开，下饺子用手勺背推散，浮起后点两次冷水再煮 3 分钟。",
      "time_min": 9,
      "heat": "大火",
      "tip": "点冷水能让馅熟透而皮不破。",
      "visual_cue": "饺子鼓起浮面、皮透出白肚"
    }
  ],
  "tips": [
    "鲅鱼一定要刮泥，剁出来的馅发柴。",
    "打水要分次，一次倒进去馅会散。",
    "韭菜最后拌，早了会出水让饺子破皮。"
  ],
  "common_mistakes": [
    "鱼肉不挑刺直接剁，吃时咬着硬刺。",
    "一次性加足水搅，鱼馅水馅分离搅不上劲。",
    "面皮擀得太薄，煮时全部破口漏汤。"
  ],
  "substitutions": [
    {
      "original": "鲅鱼",
      "substitute": "黄鱼",
      "ratio": "500g 对 500g",
      "note": "肉质更细，打水量减 20ml。"
    },
    {
      "original": "五花肉",
      "substitute": "猪肥膘",
      "ratio": "120g 对 100g",
      "note": "更油润，香油可减半。"
    }
  ],
  "variations": [
    "加虾版：拌入 100g 虾茸，鲜味层次更足。",
    "清汤版：饺子盛出后浇一勺紫菜虾皮清汤。"
  ],
  "serving_suggestion": "蘸上米醋配蒜泥，再配一碗饺子原汤一起享用。",
  "storage": "生饺子冷冻 2 周，熟饺子冷藏 1 天；复热用蒸或煎。",
