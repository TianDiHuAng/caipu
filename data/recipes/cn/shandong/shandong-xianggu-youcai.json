  "steps": [
    {
      "n": 1,
      "text": "油菜整棵洗净沥干，根部用刀划一个十字，便于受热均匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "菜根划十字，粗梗才能和菜叶一起熟透，卖相也整齐。",
      "visual_cue": "菜根裂开小口，菜叶完整不出水"
    },
    {
      "n": 2,
      "text": "鲜香菇去蒂切成半厘米厚的片，蒂部留作熬汤别扔。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香菇别切太薄，一炒就缩，厚片才有口感。",
      "visual_cue": "菇片厚薄一致，菌褶完整"
    },
    {
      "n": 3,
      "text": "锅中水烧沸加盐与几滴植物油，下油菜焯四十秒后立刻捞出过凉。",
      "time_min": 3,
      "heat": "大火",
      "tip": "加油焯水菜叶才绿亮，捞出过凉能锁住脆感。",
      "visual_cue": "菜叶油绿挺立，梗部转深绿"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油下姜末、葱段煸香，加香菇片大火翻炒至软身出水。",
      "time_min": 4,
      "heat": "大火",
      "tip": "香菇要炒到出水再把汁收干，鲜味才真正出来。",
      "visual_cue": "菇片变软出汁，锅底汁水收干"
    },
    {
      "n": 5,
      "text": "加蚝油、生抽与白糖炒匀，淀粉加水调开勾薄芡。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蚝油本身带咸味，加盐之前务必先尝一口汤汁。",
      "visual_cue": "酱汁浓稠挂勺，色泽红亮"
    },
    {
      "n": 6,
      "text": "油菜整齐码入盘中，浇上香菇与酱汁即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "菜根朝外码成一圈，卖相立刻整齐，请客时最见功夫。",
      "visual_cue": "菜形整齐成放射状，酱汁不漫盘"
    }
  ],
  "tips": [
    "焯好的油菜可先用冰水浸一下，颜色能绿得更久。",
    "没有蚝油可用生抽加一点白糖代替，风味略薄。",
    "香菇蒂撕碎与葱姜同炒，鲜味一点不浪费。"
  ],
  "common_mistakes": [
    "油菜焯水时间过长，叶子发黄烂软，摆盘就散了。",
    "香菇没炒透就急着勾芡，吃起来带一股生菌的闷味。",
    "芡汁勾得太厚，菜一凉就结成硬块，口感发黏。"
  ],
  "substitutions": [
    {
      "original": "油菜",
      "substitute": "娃娃菜",
      "ratio": "250克:250克",
      "note": "娃娃菜切四瓣，焯水时间延长二十秒。"
    },
    {
      "original": "鲜香菇",
      "substitute": "干香菇",
      "ratio": "150克:50克",
      "note": "干香菇须泡发两小时，泡菇水可代替清水调汁。"
    }
  ],
  "variations": [
    "加几粒泡软的枸杞点缀，颜色更喜庆，适合宴客。",
    "把香菇换成口蘑，味道更清，孩子更容易接受。"
  ],
  "serving_suggestion": "作为荤菜的配菜上桌，也可单独配米饭，清淡解腻。",
  "storage": "冷藏可存一天，复热须上锅蒸三分钟，回锅炒会出水。",
