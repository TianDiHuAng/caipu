    "锅铲",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉逆着纹理切成薄片，加料酒、生抽与玉米淀粉抓匀腌十五分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "逆纹切才不塞牙，淀粉锁住水分。",
      "visual_cue": "羊肉片挂浆均匀、表面发亮"
    },
    {
      "n": 2,
      "text": "大葱斜切成四厘米的段，生姜切末，大蒜切片备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "葱段斜切，受热快且不出水。",
      "visual_cue": "葱段断口平整、干爽不流汁"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟，下植物油滑锅，倒羊肉大火快速划散。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅一定要够热，羊肉才不出水。",
      "visual_cue": "羊肉片变色卷边、锅中不见水"
    },
    {
      "n": 4,
      "text": "羊肉七成熟时拨到一边，下姜末与蒜片炒香，再与羊肉翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "别把羊肉炒到全熟，后面还要回锅。",
      "visual_cue": "羊肉片边缘微焦、中心略粉"
    },
    {
      "n": 5,
      "text": "倒入大葱段与盐、白糖，大火爆炒三十秒至葱段断生。",
      "time_min": 1,
      "heat": "大火",
      "tip": "葱段只炒到断生，脆甜才在。",
      "visual_cue": "葱段翠绿微塌、香气冲鼻"
    },
    {
      "n": 6,
      "text": "沿锅边淋香醋与香油，快速翻匀后立刻出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "醋沿锅边淋，酸香才不冲。",
      "visual_cue": "羊肉干爽油亮、葱香带一点酸"
    }
  ],
  "tips": [
    "羊肉要选后腿肉，筋膜少易切片。",
    "切好的羊肉片可冷冻十分钟再下锅，切得更薄。",
    "全程大火快炒，锅里不要留汤水。"
  ],
  "common_mistakes": [
    "羊肉顺纹切片，炒出来咬不动还塞牙。",
    "锅不够热就下肉，羊肉出水变成水煮。",
    "大葱炒得太久，颜色发黄失去脆甜。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛里脊",
      "ratio": "400g 对 400g",
      "note": "膻味更轻，炒制时间相同。"
    },
    {
      "original": "大葱",
      "substitute": "洋葱",
      "ratio": "150g 对 180g",
      "note": "甜味更重，需多炒二十秒。"
    }
  ],
  "variations": [
    "加十克干辣椒同炒，辣香更足更过瘾。",
    "把羊肉片换成羊肉卷同炒，省去切片的功夫。"
  ],
  "serving_suggestion": "趁热上桌，配烧饼夹着吃是鲁地的老吃法。",
  "storage": "建议现炒现吃，冷藏后葱段会出水发软。",
