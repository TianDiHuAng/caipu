    "锅铲",
    "浅盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成三角厚片，用厨房纸吸去表面水分，两面薄薄撒一层干粉备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面干爽才煎得金黄，带水下锅容易粘锅破皮。",
      "visual_cue": "豆腐片干爽，表面有薄薄一层粉。"
    },
    {
      "n": 2,
      "text": "平底锅放植物油烧热，豆腐片下锅小火煎到两面金黄结壳后盛出。",
      "time_min": 8,
      "heat": "小火",
      "tip": "豆腐下锅后先定型再翻面，一面煎透再翻另一面才漂亮。",
      "visual_cue": "两面金黄起壳，边缘挺括不塌。"
    },
    {
      "n": 3,
      "text": "锅中留底油，下葱段和姜片炒香，放入香菇片大火炒到变软出水。",
      "time_min": 5,
      "heat": "大火",
      "tip": "香菇要先炒出水分，鲜味才会释放到后面的汤汁里。",
      "visual_cue": "香菇软塌出汁，香味浓郁。"
    },
    {
      "n": 4,
      "text": "放回豆腐片，加生抽、蚝油、白糖和清水，小火加盖烧八分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "烧的时候让豆腐片半浸在汤里，翻一次面两边都入味。",
      "visual_cue": "汤汁变稠转深，豆腐上色均匀。"
    },
    {
      "n": 5,
      "text": "玉米淀粉兑水勾薄芡，晃锅让汤汁裹匀豆腐后出锅装盘。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芡汁要薄，晃锅而不是猛翻，豆腐片才不破。",
      "visual_cue": "汤汁透亮裹在豆腐上，盘底不见积水。"
    }
  ],
  "tips": [
    "豆腐先煎出一层硬壳再烧，才能吸汁又不散形。",
    "香菇要大火炒到出水，鲜味才进得去汤汁。",
    "勾芡宁薄勿厚，芡太厚会把清鲜味糊住。"
  ],
  "common_mistakes": [
    "豆腐没吸干水分就下锅，粘锅破皮，煎成一锅碎块。",
    "香菇没炒透就加水，汤里带生菇味，鲜味也出不来。",
    "芡勾得太厚，豆腐片裹着一层浆糊，口感发黏。"
  ],
  "substitutions": [
    {
      "original": "香菇",
      "substitute": "口蘑",
      "ratio": "150克:150克",
      "note": "口蘑烧豆腐同样鲜美，切片厚度保持一致。"
    },
    {
      "original": "蚝油",
      "substitute": "生抽",
      "ratio": "8毫升:18毫升",
      "note": "不用蚝油可把生抽加到十八毫升，咸度相近。"
    }
  ],
  "variations": [
    "加一把泡发的木耳同烧，口感更丰富，颜色也更好看。",
    "喜欢浓口的可加半勺甜面酱，烧出来是济南家常味。"
  ],
  "serving_suggestion": "香菇烧豆腐整盘上桌，汤汁拌饭或浇在面上都好吃，配一份清炒青菜更均衡。",
  "storage": "冷藏两天，复热时加少量清水小火回烧三分钟，豆腐仍能保持完整。",
