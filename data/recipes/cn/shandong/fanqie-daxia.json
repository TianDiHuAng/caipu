  "steps": [
    {
      "n": 1,
      "text": "虾剪去虾枪与须脚，从背部划开挑出沙线，冲洗干净。",
      "time_min": 10,
      "heat": "无火",
      "tip": "沙线不挑，吃起来有泥沙感。",
      "visual_cue": "虾身干净、背缝清晰"
    },
    {
      "n": 2,
      "text": "番茄用热水烫过再去皮切块，大蒜切末，生姜切片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "番茄去皮，汤汁才不涩口。",
      "visual_cue": "番茄块软嫩、不见皮渣"
    },
    {
      "n": 3,
      "text": "炒锅下植物油烧热，放姜片与蒜末炒香，倒入虾煎到两面变红。",
      "time_min": 4,
      "heat": "中火",
      "tip": "虾先煎一下，鲜味才锁得住。",
      "visual_cue": "虾壳通红、锅中有虾的香气"
    },
    {
      "n": 4,
      "text": "加番茄块与番茄酱翻炒出汁，放白糖、盐与料酒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "番茄要炒到出沙，汤汁才够浓。",
      "visual_cue": "番茄化成糊状、汤汁泛红"
    },
    {
      "n": 5,
      "text": "加清水小火焖三分钟，转大火收汁至浓稠，起锅装盘。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁别收太干，留些汤汁拌饭。",
      "visual_cue": "汤汁红亮、均匀裹住虾身"
    }
  ],
  "tips": [
    "虾背划开更易入味，也方便挑沙线。",
    "番茄选熟透的，出沙多，甜味足。",
    "番茄酱只用来补色，放多了会盖住鲜味。"
  ],
  "common_mistakes": [
    "虾煎过了头，虾身发柴缩成一团。",
    "番茄没炒出沙就加水，汤汁稀而不浓。",
    "白糖放得太多，甜味压过了虾的鲜。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "虾仁",
      "ratio": "500g 对 350g",
      "note": "免去挑沙线，煎制时间减半。"
    },
    {
      "original": "番茄酱",
      "substitute": "番茄膏",
      "ratio": "30g 对 20g",
      "note": "酸度更高，白糖加三克。"
    }
  ],
  "variations": [
    "加两片香叶同焖，汤汁带一点西式的香气。",
    "把虾换成虾仁同法炒制，更适合拌面。"
  ],
  "serving_suggestion": "连汁一起上桌，汤汁拌饭或拌面都好。",
  "storage": "冷藏可放一天，复热时小火加热别用大火。",
