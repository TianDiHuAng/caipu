  "steps": [
    {
      "n": 1,
      "text": "冬笋剥去外层老皮，削掉根部发硬的纤维，切成一厘米见方、五厘米长的条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部老硬的部分必须削净，不然嚼起来满是粗纤维。",
      "visual_cue": "笋条粗细均匀，断面洁白无黑点"
    },
    {
      "n": 2,
      "text": "炒锅添清水烧开，下笋条煮六分钟去涩，捞出沥干水分备用。",
      "time_min": 8,
      "heat": "大火",
      "tip": "笋的草酸与涩味靠水煮去，煮过再烧才不扎嘴。",
      "visual_cue": "笋条由白转半透明，闻着没有生涩气"
    },
    {
      "n": 3,
      "text": "花生油烧到六成热，下姜末和小葱段中火煸出香味，捡出葱段不用。",
      "time_min": 2,
      "heat": "中火",
      "tip": "葱段只取香不留形，煸到边缘发黄就捞出。",
      "visual_cue": "油面泛出葱姜香气，油色微黄"
    },
    {
      "n": 4,
      "text": "倒入笋条中火翻炒三分钟，让每条笋都裹上油，边缘煎到微微发黄。",
      "time_min": 3,
      "heat": "中火",
      "tip": "笋条要摊开煎，堆在一起只出水不上色。",
      "visual_cue": "笋条边角转金黄，锅底干爽"
    },
    {
      "n": 5,
      "text": "加生抽、料酒、白糖和盐翻匀，倒入高汤烧开，转小火㸆十分钟收干汤汁。",
      "time_min": 10,
      "heat": "小火",
      "tip": "汤要收到看不见明汁，味道才全挂在笋上。",
      "visual_cue": "汤汁几乎收尽，笋条油亮"
    },
    {
      "n": 6,
      "text": "淋香醋和芝麻油翻两下起锅，撒上小葱段装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋沿锅边淋，酸香才冲得出来，直接浇笋上会发闷。",
      "visual_cue": "笋条油亮干香，盘底不见汤汁"
    }
  ],
  "tips": [
    "冬笋挑身形矮胖、笋尖紧包不散的，笋肉厚且涩味轻。",
    "煮笋的水里加一小把米，涩味走得更快。",
    "干烧讲究不见汤汁，收汁阶段要守着锅，一晃就糊。"
  ],
  "common_mistakes": [
    "省了水煮这一步，成菜涩口发麻，吃两口就放下筷子。",
    "笋条切得太细，煎炒后缩成硬筋，完全失了脆感。",
    "收汁用中大火，糖分先焦，笋条带出糊苦味。"
  ],
  "substitutions": [
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "150毫升:150毫升",
      "note": "用清水就补一撮白糖和几滴生抽，鲜味稍淡。"
    },
    {
      "original": "冬笋",
      "substitute": "春笋",
      "ratio": "400克:400克",
      "note": "春笋更嫩，水煮时间缩短到三分钟，烧制减两分钟。"
    }
  ],
  "variations": [
    "加五十克火腿片同烧，咸鲜更厚重，是胶东宴席的做法。",
    "口重的版本加五克干辣椒同煸，起锅前挑出，多一层辣香。"
  ],
  "serving_suggestion": "笋条码成一小堆，淋上锅底剩下的油汁，热吃脆、温吃香，配一碗小米粥最舒服。",
  "storage": "冷藏可放两天，复热时加两勺清水小火回㸆两分钟；不宜冷冻，笋条解冻后发绵。",
