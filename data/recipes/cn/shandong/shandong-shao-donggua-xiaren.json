  "steps": [
    {
      "n": 1,
      "text": "虾仁挑去背部的黑线，冲洗干净后用厨房纸吸干表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水分不吸干，上浆挂不住，一炒就脱浆出水。",
      "visual_cue": "虾仁干爽有光，不见水痕"
    },
    {
      "n": 2,
      "text": "虾仁加料酒、白胡椒和一半淀粉抓匀，静置十分钟入味上浆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "上浆是虾仁嫩的关键，手感发黏才算抓到位。",
      "visual_cue": "虾仁表面挂一层薄浆，微微发亮"
    },
    {
      "n": 3,
      "text": "冬瓜去皮去瓤，切成两厘米厚的方块，边缘削圆以免煮散。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切块比切片耐烧，久煮也不容易化在汤里。",
      "visual_cue": "瓜块方正均匀，断面白净"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油下姜末煸香，放入虾仁中火滑炒到变红卷曲后盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾仁一变色就盛出，回锅再烧才不会老。",
      "visual_cue": "虾仁弯成弓形，表面透红"
    },
    {
      "n": 5,
      "text": "原锅下冬瓜块翻炒两分钟，加清水至半没，加盖中火烧八分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "水别加太多，冬瓜自己会出水，汤多了味就淡。",
      "visual_cue": "瓜块边缘变透明，汤汁乳白"
    },
    {
      "n": 6,
      "text": "倒回虾仁，加盐调味，用余下的淀粉勾薄芡，淋香油撒葱花起锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芡要薄，能挂住汤汁就好，厚了糊嘴。",
      "visual_cue": "汤汁晶亮挂勺，葱花翠绿点缀"
    }
  ],
  "tips": [
    "冬瓜皮别削太深，留一点青皮烧出来更清甜。",
    "用高汤代替清水，鲜味能再上一个台阶。",
    "冬瓜切好后撒少许盐腌五分钟，烧的时候不易碎。"
  ],
  "common_mistakes": [
    "虾仁不吸干水就上浆，下锅脱浆，汤汁发浑。",
    "冬瓜和虾仁一起下锅久烧，虾仁老得咬不动。",
    "水加太多又不收汁，最后成了冬瓜汤。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "干贝",
      "ratio": "120克:40克",
      "note": "干贝须提前蒸软撕丝，鲜味更浓。"
    },
    {
      "original": "冬瓜",
      "substitute": "节瓜",
      "ratio": "400克:400克",
      "note": "节瓜质地更紧，烧的时间延长两分钟。"
    }
  ],
  "variations": [
    "加几片火腿同烧，咸鲜更足，是宴席上的升级版。",
    "把冬瓜挖成小球再烧，卖相精致，适合请客。"
  ],
  "serving_suggestion": "装深盘连汤汁一起上桌，浇在米饭上最鲜，夏天吃尤其清爽。",
  "storage": "冷藏可存两天，复热须小火加两勺水慢烧，避免冬瓜碎烂。",
