  "equipment": [
    "炒锅",
    "锅铲",
    "打蛋碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁挑去背上的黑线，用厨房纸吸干水分，加盐、料酒和玉米淀粉抓匀腌五分钟。",
      "time_min": 7,
      "heat": "无火",
      "tip": "虾仁一定要吸干再上浆，带水下锅会脱浆出水。",
      "visual_cue": "虾仁表面裹着薄浆，摸着滑手。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加一小撮盐和十五毫升清水，搅到蛋液完全融合无蛋清块。",
      "time_min": 3,
      "heat": "无火",
      "tip": "加清水是滑蛋嫩的关键，比例约每个蛋一小勺。",
      "visual_cue": "蛋液顺滑，看不到成块的蛋清。"
    },
    {
      "n": 3,
      "text": "炒锅烧热放植物油，下虾仁中火滑到变色卷曲立刻盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾仁一变红就打卷，多炒十秒口感就发柴。",
      "visual_cue": "虾仁卷曲透红，表面无透明生肉。"
    },
    {
      "n": 4,
      "text": "锅中留底油转小火，倒入蛋液，用锅铲从边缘往中间慢慢推。",
      "time_min": 2,
      "heat": "小火",
      "tip": "全程小火，蛋液凝固一半时就要停手，余温会继续焖熟。",
      "visual_cue": "蛋液成柔软的大片，表面还带湿润。"
    },
    {
      "n": 5,
      "text": "蛋液还有三成流动时倒回虾仁，快速推两下，撒葱花淋香油出锅。",
      "time_min": 2,
      "heat": "小火",
      "tip": "虾仁最后拌入，早放会被推散，也失去脆嫩。",
      "visual_cue": "蛋片滑嫩包裹虾仁，葱花翠绿。"
    }
  ],
  "tips": [
    "虾仁吸干水分再上浆，滑出来才脆嫩不出水。",
    "蛋液加清水打匀，是滑蛋嫩滑的关键一步。",
    "全程小火推炒，蛋液七成熟就停手，余温焖熟最嫩。"
  ],
  "common_mistakes": [
    "虾仁没吸干就下锅，锅里出一汪水，蛋也变稀。",
    "大火炒蛋，蛋液迅速结硬块，口感又老又干。",
    "在锅里反复猛搅，蛋和虾都碎成小块，卖相全无。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "干贝",
      "ratio": "150克:80克",
      "note": "换成泡发撕丝的干贝，鲜味更浓，需先蒸软。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "玉米淀粉",
      "ratio": "5克:5克",
      "note": "不加淀粉也可，但虾仁出水会多一些。"
    }
  ],
  "variations": [
    "加一小勺牛奶代替清水打蛋，蛋香更浓、颜色更白。",
    "出锅前撒少许白胡椒，去腥提鲜，味道更立体。"
  ],
  "serving_suggestion": "虾仁滑蛋要趁热吃，配一碗白米饭或拌面条都好，蛋滑虾脆是最讨喜的口感。",
  "storage": "不建议隔夜，复热后蛋会出水发硬，最好现做现吃。",
