  "equipment": [
    "蒸锅",
    "炒锅",
    "细筛",
    "浅盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干贝用温水加料酒泡两小时至回软，撕成细丝后连汤一起上锅蒸十分钟。",
      "time_min": 25,
      "heat": "中火",
      "tip": "干贝要泡透再蒸，蒸出的原汤别倒，那是这道菜的鲜味来源。",
      "visual_cue": "干贝丝柔软分明，蒸出的汤汁清亮。"
    },
    {
      "n": 2,
      "text": "蛋清打散，加一百五十毫升高汤和盐搅匀，用细筛过滤两遍。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蛋清一定要过筛去泡沫，否则蒸出来表面坑洼不平。",
      "visual_cue": "蛋液清亮无泡，滤网上有少量絮状物。"
    },
    {
      "n": 3,
      "text": "浅盘内壁抹一层猪油，倒入蛋液，盖上一层耐热保鲜膜。",
      "time_min": 3,
      "heat": "无火",
      "tip": "抹油和盖膜都是为了让表面平整如镜，不起蜂窝。",
      "visual_cue": "蛋液平整铺满盘底，膜下无气泡。"
    },
    {
      "n": 4,
      "text": "蒸锅水开后放盘，中小火蒸十分钟，取出静置两分钟再揭膜。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "中小火蒸，水滚得太猛蛋清会起蜂窝，口感变粗。",
      "visual_cue": "蛋面洁白平滑，轻晃有细微颤动。"
    },
    {
      "n": 5,
      "text": "锅中放剩余高汤烧开，下干贝丝略煮，用玉米淀粉勾薄芡后浇在蛋面上。",
      "time_min": 4,
      "heat": "中火",
      "tip": "芡要薄，能挂住勺背就够，太厚会盖住蛋清的嫩。",
      "visual_cue": "芡汁清亮透明，干贝丝均匀分布。"
    },
    {
      "n": 6,
      "text": "最后撒上葱花即可上桌，吃时用勺连蛋带汁一起舀。",
      "time_min": 1,
      "heat": "无火",
      "tip": "葱花只作点缀，撒多了会抢走干贝的清香。",
      "visual_cue": "蛋面如脂，干贝丝与葱花点缀其上。"
    }
  ],
  "tips": [
    "干贝泡发的水和蒸出的汤都要留用，是这道菜鲜味的根本。",
    "蛋清必须过筛并盖膜蒸，才能蒸出平滑如镜的表面。",
    "蒸的时候保持中小火，火太大蛋清必定起蜂窝变粗。"
  ],
  "common_mistakes": [
    "蛋清没过筛，蒸出来表面全是气泡孔，卖相全毁。",
    "用大火猛蒸，蛋清起了蜂窝，口感变粗变老。",
    "干贝泡发不彻底就蒸，咬着发硬，鲜味也出不来。"
  ],
  "substitutions": [
    {
      "original": "干贝",
      "substitute": "虾仁",
      "ratio": "80克:120克",
      "note": "用虾仁代替干贝，需先滑熟再勾芡，风味不同但同样鲜。"
    },
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "10克:10毫升",
      "note": "抹盘改用植物油，更适合不吃动物油的人。"
    }
  ],
  "variations": [
    "把干贝换成蟹肉，就是芙蓉蟹斗的简化版，鲜味更浓。",
    "加一小勺牛奶在蛋液里，蒸出的芙蓉更白更嫩。"
  ],
  "serving_suggestion": "芙蓉干贝汤清蛋嫩，作为宴席的头道热菜很合适，用小勺挖着吃最能体会蛋白的滑嫩。",
  "storage": "冷藏可存一天，复热时上锅重新蒸五分钟，不要用微波炉以免起蜂窝。",
