  "equipment": [
    "炒锅",
    "漏勺",
    "碗",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花生米挑去霉粒和碎壳，用清水快速冲一遍，捞出沥干并彻底晾干表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "花生必须干透再下油，带水下锅会爆油，也炸不酥。",
      "visual_cue": "花生表面干爽，手摸无湿感"
    },
    {
      "n": 2,
      "text": "冷锅倒入花生油，直接放花生米，开小火慢慢升温，用勺子不停推动。",
      "time_min": 6,
      "heat": "小火",
      "tip": "冷油下锅才炸得里外一致，热油下锅外面糊了里面还是生的。",
      "visual_cue": "油面均匀冒小泡，花生微微变色"
    },
    {
      "n": 3,
      "text": "花生米噼啪声变密、颜色转浅金时立刻捞出，摊在厨房纸上散热。",
      "time_min": 3,
      "heat": "小火",
      "tip": "捞的时候偏浅一点，余温还会再加深两成颜色。",
      "visual_cue": "花生浅金红，摊开时仍有噼啪声"
    },
    {
      "n": 4,
      "text": "小碗放香醋、生抽、白糖和盐搅到糖化开，撒入干辣椒圈。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要多搅一会儿，醋里糖化得慢，没化开只有酸。",
      "visual_cue": "味汁均匀，碗底无糖粒"
    },
    {
      "n": 5,
      "text": "花生米晾到完全凉透后倒进味汁，拌入小葱碎和香菜段，静置两分钟再上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "花生必须凉透再拌，热的时候吸汁会立刻回软。",
      "visual_cue": "花生裹上深色味汁，仍见脆壳"
    }
  ],
  "tips": [
    "冷油小火慢炸是花生酥脆的关键，急不得。",
    "炸好的花生晾凉后密封可存一周，吃前再拌汁。",
    "老醋花生的糖不能太少，酸甜平衡才不呛口。"
  ],
  "common_mistakes": [
    "热油下花生米，外面焦黑里面还是生的，一股苦味。",
    "花生没凉就拌汁，端上桌已经软塌，咬不出脆响。",
    "一次拌一大盆放着，两小时后花生全泡软，只剩酸味。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "40毫升:40毫升",
      "note": "米醋更清爽，糖可减到十克，酸味更直白。"
    },
    {
      "original": "花生",
      "substitute": "腰果",
      "ratio": "250克:230克",
      "note": "腰果炸制时间更短，一分半就要捞出。"
    }
  ],
  "variations": [
    "加一勺辣椒油和少许花椒面，做成麻辣老醋花生。",
    "拌入切碎的黄瓜丁，口感更清爽，适合夏天。"
  ],
  "serving_suggestion": "装小碟上桌，作为酒席的头道小菜，配白酒或啤酒都合适，酸香开胃最解腻。",
  "storage": "炸好的花生密封常温可存一周；拌汁后冷藏不超过一天，且会逐渐回软。",
