  "steps": [
    {
      "n": 1,
      "text": "海参、鱿鱼与虾仁分别洗净，虾仁挑去背部沙线，鱿鱼切十字花刀再切块。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱿鱼改花刀受热会卷成花，卖相更好。",
      "visual_cue": "鱿鱼块上布满菱形刀纹。"
    },
    {
      "n": 2,
      "text": "香菇切片，木耳撕成小朵，小白菜洗净切段备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "木耳要提前泡透，口感才脆。",
      "visual_cue": "木耳舒展开，厚实有弹性。"
    },
    {
      "n": 3,
      "text": "高汤倒入汤锅，加姜丝煮开，先下香菇与木耳煮五分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "香菇先煮，汤里才有菌菇的鲜。",
      "visual_cue": "汤面滚动，香菇浮起。"
    },
    {
      "n": 4,
      "text": "放海参与鱿鱼，加料酒，转中小火煮三分钟。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "海参久煮会缩，三分钟就够。",
      "visual_cue": "鱿鱼卷成花，海参变挺。"
    },
    {
      "n": 5,
      "text": "放入虾仁与小白菜，煮到虾仁卷曲变红即可关火。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "虾仁一变色就关火，煮久发硬。",
      "visual_cue": "虾仁通体粉红卷曲"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，淋香油，撒小葱花开锅上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "白胡椒最后放，辛辣香才在。",
      "visual_cue": "汤色清亮，葱花浮面。"
    }
  ],
  "tips": [
    "三鲜指海参、虾仁、鱿鱼，卤水点的北豆腐也可代一部分。",
    "高汤要提前吊好，清水做出来鲜味差一截。",
    "下海鲜后别再大火滚，汤会浑、料会老。"
  ],
  "common_mistakes": [
    "海鲜一起下锅久煮，鱿鱼橡皮、虾仁发柴。",
    "木耳没泡透就下锅，咬着有硬芯，口感发柴。"
  ],
  "substitutions": [
    {
      "original": "海参",
      "substitute": "水发花胶",
      "ratio": "200g 对 200g",
      "note": "花胶要提前泡发去腥，煮的时间加两分钟。"
    }
  ],
  "variations": [
    "胶东一带会加几片火腿同煮，汤色微红，鲜味更厚。"
  ],
  "serving_suggestion": "清汤上桌，配一小碟米醋蘸海鲜。",
  "storage": "冷藏一天，海鲜汤不宜久放，复热须彻底煮开。",
