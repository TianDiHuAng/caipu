  "steps": [
    {
      "n": 1,
      "text": "羊肉 800g 切成 5 厘米大块，用清水浸泡 90 分钟去血水，中途换水两次。",
      "time_min": 90,
      "heat": "无火",
      "tip": "泡够时间，汤才不发浑不带膻。",
      "visual_cue": "肉色转浅、水底见血水沉淀"
    },
    {
      "n": 2,
      "text": "羊肉冷水下锅，加姜 30g、葱 50g 与 5g 花椒，大火烧开后撇净浮沫。",
      "time_min": 12,
      "heat": "大火",
      "tip": "浮沫要撇干净，不然汤色发灰。",
      "visual_cue": "汤面浮沫打净、汤色转清"
    },
    {
      "n": 3,
      "text": "转小火炖 90 分钟，至羊肉用筷子一插即透、汤色乳白。",
      "time_min": 90,
      "heat": "小火",
      "tip": "全程小火微沸，汤才会熬成奶白色。",
      "visual_cue": "汤色乳白、肉块轻颤"
    },
    {
      "n": 4,
      "text": "捞出羊肉稍凉后切片，羊汤用细网筛滤去杂质与浮油。",
      "time_min": 6,
      "heat": "无火",
      "tip": "滤掉浮油，喝起来才不糊嘴。",
      "visual_cue": "汤体清亮乳白、无碎渣"
    },
    {
      "n": 5,
      "text": "羊汤回锅，加 3g 八角、6g 盐与 3g 白胡椒粉，中火煮开。",
      "time_min": 3,
      "heat": "中火",
      "tip": "盐最后放，肉才不会发紧。",
      "visual_cue": "汤面翻滚、胡椒香浮起"
    },
    {
      "n": 6,
      "text": "羊肉片放入碗中，浇上滚烫羊汤，撒 20g 香菜，淋 5ml 香油与 20ml 辣椒油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汤一定要滚烫地浇，肉片才嫩。",
      "visual_cue": "汤面浮红油、香菜翠绿"
    }
  ],
  "tips": [
    "羊肉先泡后炖，膻味能去掉大半。",
    "全程小火保持微沸，大火会把汤煮浑。",
    "喝前再放盐，肉嫩汤鲜都不受影响。"
  ],
  "common_mistakes": [
    "羊肉不泡直接下锅，汤膻得没法入口。",
    "全程大火滚煮两小时，汤浑肉还发柴。",
    "盐提前放进去，羊肉紧得像橡皮嚼不动。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "羊腿肉",
      "ratio": "800g 对 800g",
      "note": "脂肪少，汤色偏清，需加 50g 羊骨同炖。"
    },
    {
      "original": "辣椒油",
      "substitute": "辣椒粉",
      "ratio": "20ml 对 5g",
      "note": "直接撒入碗中，辣味更冲。"
    }
  ],
  "variations": [
    "加 100g 粉丝同煮，做成羊肉汤泡馍的吃法。",
    "加 30g 白萝卜块，汤更清甜。"
  ],
  "serving_suggestion": "配烧饼或烙饼，趁滚烫时喝，冬天最暖身。",
  "storage": "冷藏可存 3 天，复热时撇去表面凝固的羊油。",
