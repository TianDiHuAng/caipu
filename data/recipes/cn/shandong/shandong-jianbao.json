          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "煎底",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 10,
