          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "平底锅",
    "擀面杖",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母 3g 用 170ml 温水化开，加 300g 面粉揉成光滑面团，醒发 50 分钟。",
      "time_min": 60,
      "heat": "无火",
      "tip": "面团要揉到表面光滑，包子皮才细腻。",
      "visual_cue": "面团膨胀一圈、指按回弹"
    },
    {
      "n": 2,
      "text": "白菜 200g 剁碎撒少许盐腌 10 分钟，用纱布挤干水分备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水挤不干，包子底会被泡烂。",
      "visual_cue": "菜碎干爽、捏紧不出水"
    },
    {
      "n": 3,
      "text": "猪肉末 250g 加葱末 30g、姜末 10g、20ml 生抽与 4g 盐，顺一个方向搅上劲。",
      "time_min": 6,
      "heat": "无火",
      "tip": "肉馅搅上劲，包出来才抱团多汁。",
      "visual_cue": "肉馅黏稠、能拉出细丝"
    },
    {
      "n": 4,
      "text": "把挤干的白菜碎拌进肉馅，淋 5ml 植物油锁住水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油最后放，馅料才不出汤。",
      "visual_cue": "馅料湿润但不流动"
    },
    {
      "n": 5,
      "text": "面团分成 16 个剂子擀成圆皮，包入馅料捏紧收口。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮中间厚边缘薄，底才不破。",
      "visual_cue": "包子个头均匀、收口紧实"
    },
    {
      "n": 6,
      "text": "平底锅倒 30ml 植物油摆入包子，中火煎 3 分钟至底部金黄。",
      "time_min": 3,
      "heat": "中火",
      "tip": "包子之间留空隙，发起来不粘连。",
      "visual_cue": "底面结出金黄脆壳"
    },
    {
      "n": 7,
      "text": "10g 淀粉加 200ml 清水调匀沿锅边淋入，盖盖小火焖 12 分钟至水干。",
      "time_min": 12,
      "heat": "小火",
      "tip": "面水收到滋滋响，脆底才成型。",
      "visual_cue": "锅底水干、边缘结出薄脆"
    },
    {
      "n": 8,
      "text": "开盖撒上葱花，用铲子贴着锅底整块铲出装盘。",
      "time_min": 2,
      "heat": "中火",
      "tip": "铲的时候贴底走，脆皮才完整。",
      "visual_cue": "底部脆壳完整、包子松软"
    }
  ],
  "tips": [
    "白菜一定要挤干水，否则包子底软塌塌的。",
    "面水用淀粉调，出锅才有那层薄脆冰花。",
    "焖的时候保持小火，水才干得均匀不糊底。"
  ],
  "common_mistakes": [
    "面团发过头再包，蒸出来带酸味还塌陷。",
    "馅料水没挤干，煎的时候底全烂掉。",
    "火太大收水，脆底直接变成焦黑一片。"
  ],
  "substitutions": [
    {
      "original": "白菜",
      "substitute": "韭菜",
      "ratio": "200g 对 180g",
      "note": "不用挤水，但要最后拌入防出水。"
    },
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "250g 对 250g",
      "note": "需多加 20ml 清水搅打才不柴。"
    }
  ],
  "variations": [
    "馅里加 50g 虾仁丁，鲜味更足。",
    "面水里加 5g 面粉，冰花更厚更脆。"
  ],
  "serving_suggestion": "连脆底一起铲出，配一碗小米粥或豆浆。",
  "storage": "冷藏可存 2 天，复热时平底锅小火干煎 4 分钟回脆。",
