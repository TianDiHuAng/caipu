  },
  "servings": 3,
  "flavor": [
    "sour",
    "fragrant",
    "light"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "莲藕",
          "name_en": "lotus root",
          "amount": 400,
          "unit": "g",
          "note": "选九孔脆藕",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "姜汁",
          "name_en": "ginger juice",
          "amount": 30,
          "unit": "ml",
          "note": "用鲜姜现榨的浓姜汁",
          "optional": false
        },
        {
          "name": "香醋",
          "name_en": "black vinegar",
          "amount": 25,
          "unit": "ml",
          "note": "调酸味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 8,
          "unit": "g",
          "note": "中和醋的尖酸",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "焯水与调味",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 8,
          "unit": "g",
          "note": "切碎点缀",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "榨姜汁的原料",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "漏勺",
    "冰水盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "莲藕削去外皮，切成两毫米厚的藕片，泡在清水里冲掉表面渗出的白色浆水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "藕片越薄越入味，切好立刻泡水，不然几分钟就发黑。",
      "visual_cue": "藕片薄透均匀，水略发白"
    },
    {
      "n": 2,
      "text": "锅中水烧开加少许盐，下藕片焯两分钟，捞出立刻放进冰水过凉。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯完必须立刻过冰水，藕片才脆，晾着会闷软。",
      "visual_cue": "藕片由白转透，咬开有脆响"
    },
    {
      "n": 3,
      "text": "姜汁、香醋、盐和白糖放小碗搅到糖化开，调成姜汁味汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "姜汁要现榨，放久的姜汁辛辣味会散、只剩一股土味。",
      "visual_cue": "味汁清亮微黄，姜的辛辣味冲鼻"
    },
    {
      "n": 4,
      "text": "藕片沥干水分，倒进味汁拌匀，冷藏十分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冷藏这十分钟别省，冷透的藕片才够爽脆。",
      "visual_cue": "藕片吸足味汁，微微透出酱色"
    },
    {
      "n": 5,
      "text": "装盘后撒上小葱碎，再浇一勺拌藕剩下的原汁，让藕片表面油润发亮。",
      "time_min": 3,
      "heat": "无火",
      "tip": "补一勺原汁能让表面不发干，看着更有光泽。",
      "visual_cue": "藕片油润透亮，葱末翠绿"
    }
  ],
  "tips": [
    "选两头封口的九孔脆藕，孔大的粉藕焯完发面，不适合凉拌。",
    "焯水时间超过三分钟藕片就会失去脆度，掐着表起锅。",
    "姜汁与香醋的比例约一比一，姜味才压得住醋。"
  ],
  "common_mistakes": [
    "藕片切好不泡水，拌完端上桌已经氧化发黑，卖相全无。",
    "焯完直接晾着等凉，藕片外层发黏，口感发闷。",
    "姜汁用姜粉兑水代替，成品一股粉感，辛辣味也不对。"
  ],
  "substitutions": [
    {
      "original": "莲藕",
      "substitute": "山药",
      "ratio": "400克:400克",
      "note": "换成山药片同样焯水凉拌，口感更绵。"
    },
    {
      "original": "姜汁",
      "substitute": "姜",
      "ratio": "30毫升:30克",
      "note": "没有现成姜汁就把老姜磨碎挤出汁来用。"
    }
  ],
  "variations": [
    "减半香醋、加一勺花椒油，做成微麻版本。",
    "喜欢甜口可在味汁里换成白糖十五克，酸甜更明显。"
  ],
  "serving_suggestion": "码在白色浅盘里，藕片叠成扇形，淋一层清亮的姜汁，作为整桌酒席的头道凉碟。",
  "storage": "冷藏可存一天，味汁与藕片分开装，吃前拌匀；藕片久泡会失脆。",
