          "name_en": "vegetable oil",
          "amount": 350,
          "unit": "ml",
          "note": "油炸用，可过滤回收",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 90,
          "unit": "ml",
          "note": "调面糊",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅或深锅",
    "油温计",
    "厨房纸",
    "裱花袋"
  ],
  "steps": [
    {
      "n": 1,
      "text": "莲藕去皮切 3mm 薄片，切好后泡在清水中防止氧化变黑。",
      "time_min": 10,
      "heat": "无火",
      "tip": "第一刀不切断、第二刀切断，可做成夹子状更好装馅。",
      "visual_cue": "藕片切面洁白，孔洞清晰"
    },
    {
      "n": 2,
      "text": "猪肉末加葱末、姜末、生抽、料酒、白胡椒与 2g 盐，顺一个方向搅打上劲。",
      "time_min": 5,
      "heat": "无火",
      "tip": "搅到肉馅发黏能挂住筷子，炸后不易散。",
      "visual_cue": "肉馅黏稠成团，挑起不滴落"
    },
    {
      "n": 3,
      "text": "面粉、玉米淀粉、鸡蛋与 90ml 清水、3g 盐调成能挂住勺背的稠面糊。",
      "time_min": 3,
      "heat": "无火",
      "tip": "面糊太稀挂不住，太稠外壳厚；用勺背测试最直观。",
      "visual_cue": "面糊缓慢流下，勺背留一层薄膜"
    },
    {
      "n": 4,
      "text": "藕片夹入约 20g 肉馅压紧，全部做好后逐个裹面糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "藕片表面擦干再夹馅，否则面糊易脱落。",
      "visual_cue": "藕盒边缘有肉馅微鼓，外形平整"
    },
    {
      "n": 5,
      "text": "锅中倒入 350ml 植物油烧至 175℃，下藕盒中火炸 4 分钟至浅金黄捞出；升温到 190℃ 复炸 40 秒。",
      "time_min": 6,
      "heat": "中火",
      "tip": "复炸能让外壳酥脆并逼出多余油。",
      "visual_cue": "外壳金黄起脆壳，敲击有清脆声"
    }
  ],
  "tips": [
    "藕片切好后用淡盐水泡 5 分钟，口感更脆且不易断。",
    "肉馅可提前一天调好冷藏，更入味。",
    "炸好的藕盒放厨房纸上吸油 1 分钟再装盘，成品不油腻。"
  ],
  "common_mistakes": [
    "藕片切太厚，炸不透、内部生硬。",
    "油温过低就下锅，藕盒吸油发软，外皮容易脱落。",
    "一次下太多藕盒，油温骤降导致外皮脱落。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡肉末",
      "ratio": "250g 猪肉末 ≈ 250g 鸡肉末",
      "note": "鸡肉偏瘦，可加 10ml 植物油补润。"
    },
    {
      "original": "莲藕",
      "substitute": "茄子",
      "ratio": "500g 藕 ≈ 400g 长茄",
      "note": "茄子夹同样做法，炸制时间减到 3 分钟。"
    }
  ],
  "variations": [
    "空气炸锅版：表面刷油，200℃ 烤 12 分钟中途翻面，用油量大幅减少。",
    "糖醋版：炸好后淋 60ml 糖醋汁翻匀，做成糖醋藕盒。"
  ],
  "serving_suggestion": "趁热吃，配椒盐或蘸醋；作为年节炸货或便当配菜都合适。",
  "storage": "冷藏 2 天，复热用 180℃ 烤箱 6 分钟恢复脆度，不建议微波。",
