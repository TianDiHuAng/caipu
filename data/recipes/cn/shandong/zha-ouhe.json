          "amount": 1,
          "unit": "piece",
          "note": "约 50g，入面糊",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 8,
          "unit": "g",
          "note": "切末",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 15,
          "unit": "ml",
          "note": "肉馅调味",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 10,
          "unit": "ml",
          "note": "去腥",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "去腥提香",
