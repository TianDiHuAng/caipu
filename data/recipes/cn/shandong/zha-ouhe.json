        },
        {
          "name": "猪肉末",
          "name_en": "ground pork",
          "amount": 250,
          "unit": "g",
          "note": "三分肥七分瘦",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 100,
          "unit": "g",
          "note": "调面糊",
          "optional": false
        },
        {
          "name": "鸡蛋",
