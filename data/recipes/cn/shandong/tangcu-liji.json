  "equipment": [
    "炒锅",
    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊先片成厚片，再切成小拇指粗细的长条放碗中。",
      "time_min": 8,
      "heat": "无火",
      "tip": "条要切得粗细一致，炸时受热才均匀。",
      "visual_cue": "肉条粗细均匀、断口平整"
    },
    {
      "n": 2,
      "text": "肉条加盐与料酒抓匀，腌十分钟让底味吃进去。",
      "time_min": 10,
      "heat": "无火",
      "tip": "先上底味再裹糊，成品不寡淡。",
      "visual_cue": "肉条微微发黏、带酒香"
    },
    {
      "n": 3,
      "text": "蛋清打散倒入肉条中抓匀，让每根肉条都裹上蛋液。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋清能让淀粉糊牢牢粘住。",
      "visual_cue": "肉条表面湿润、泛蛋清光泽"
    },
    {
      "n": 4,
      "text": "玉米淀粉分两次拌入肉条，抓到手感发干、根根分明。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糊要挂得薄而匀，太厚炸出来像外壳。",
      "visual_cue": "肉条干爽、互不粘连"
    },
    {
      "n": 5,
      "text": "锅中倒植物油烧到六成热，肉条逐根下锅中火炸到定型。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一根根下锅，粘连后不好分开。",
      "visual_cue": "肉条浮起、外壳浅黄定型"
    },
    {
      "n": 6,
      "text": "捞出沥油后把油温升到八成热，回锅复炸四十秒逼出油分。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "复炸让外壳酥脆，还能少吸油。",
      "visual_cue": "外壳金黄、敲之发脆"
    },
    {
      "n": 7,
      "text": "另起锅加番茄酱、白糖、白醋与清水，小火搅匀烧开。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖醋汁要先烧开，酸味才柔和。",
      "visual_cue": "汁色红亮、糖完全化开"
    },
    {
      "n": 8,
      "text": "淀粉兑水淋入汁中勾成薄芡，翻炒到汁液能挂勺。",
      "time_min": 2,
      "heat": "小火",
      "tip": "芡别勾太稠，否则裹不匀还结块。",
      "visual_cue": "芡汁透亮、勺背挂上一层"
    },
    {
      "n": 9,
      "text": "炸好的肉条倒入锅中快速翻匀，撒芝麻后立刻出锅。",
      "time_min": 1,
      "heat": "中火",
      "tip": "翻匀就出锅，久炒外壳会回软。",
      "visual_cue": "每根肉条裹满亮汁、芝麻均匀"
    }
  ],
  "tips": [
    "肉条裹糊后静置两分钟，淀粉吸水才炸得酥。",
    "糖醋汁按番茄酱两份、白糖两份、白醋一份半调最稳。",
    "复炸时间别超过一分钟，否则肉心发柴。"
  ],
  "common_mistakes": [
    "糊挂得太厚，炸出来外壳硬、里面没味道。",
    "油温太低就下肉条，外壳脱糊还吸满油。",
    "糖醋汁没烧开就勾芡，酸味冲鼻不圆润。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "300g 对 300g",
      "note": "切条后需多腌五分钟入味。"
    },
    {
      "original": "白醋",
      "substitute": "香醋",
      "ratio": "30ml 对 30ml",
      "note": "颜色偏深，需减少老抽用量。"
    }
  ],
  "variations": [
    "把番茄酱换成山楂酱，酸甜味更有层次。",
    "糖醋汁里加几滴柠檬汁，果香更清爽。"
  ],
  "serving_suggestion": "趁热上桌最好吃，配一碗白饭酸甜解腻。",
  "storage": "冷藏可放两天，复热需用烤箱烘脆。",
