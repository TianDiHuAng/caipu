  "steps": [
    {
      "n": 1,
      "text": "鱿鱼撕掉外皮和内脏，冲洗干净后剖开摊平，在内面打上十字花刀，切成方块。",
      "time_min": 12,
      "heat": "无火",
      "tip": "花刀只划到三分之二深，划穿了焯水就卷不起来。",
      "visual_cue": "刀纹均匀，鱿鱼块透光"
    },
    {
      "n": 2,
      "text": "锅中水烧开加料酒，鱿鱼块下锅烫十秒，卷成花状立刻捞出沥干。",
      "time_min": 3,
      "heat": "大火",
      "tip": "焯到卷起就捞，多烫十秒肉质就变橡皮。",
      "visual_cue": "鱿鱼块卷成麦穗状，颜色转白"
    },
    {
      "n": 3,
      "text": "竹笋片焯水两分钟去涩，捞出过凉；青椒切菱形片，葱姜蒜切好备用。",
      "time_min": 5,
      "heat": "大火",
      "tip": "笋片不焯水会带一股涩味，压住鱿鱼的鲜。",
      "visual_cue": "笋片脆白，青椒片干爽"
    },
    {
      "n": 4,
      "text": "花生油烧到六成热，下葱段、姜丝、蒜片和白胡椒小火炒香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "葱姜蒜炒到出香就下料，炒黄了整盘带苦味。",
      "visual_cue": "锅里有明显的葱姜香气飘出"
    },
    {
      "n": 5,
      "text": "转大火下鱿鱼卷、竹笋片和青椒片快速翻炒，沿锅边淋料酒和生抽，加盐翻匀。",
      "time_min": 4,
      "heat": "大火",
      "tip": "全程大火二十秒内出锅，锅气足鱿鱼才脆嫩。",
      "visual_cue": "鱿鱼卷边缘微微卷曲，青椒翠绿"
    },
    {
      "n": 6,
      "text": "淋入水淀粉勾薄芡，翻两下让味汁裹住鱿鱼，立刻出锅装盘。",
      "time_min": 3,
      "heat": "大火",
      "tip": "芡要薄，厚了会糊住花刀纹路，看着不清爽。",
      "visual_cue": "味汁透亮裹身，盘底不见汤水"
    }
  ],
  "tips": [
    "鱿鱼打花刀前先用刀背拍松，卷得更漂亮。",
    "焯水与爆炒之间不要放凉，热鱿鱼下热锅才不出水。",
    "笋片和青椒提前备好，爆炒讲究一次下锅不手忙脚乱。"
  ],
  "common_mistakes": [
    "花刀划穿鱿鱼，焯完卷不起来，成了一盘鱿鱼片。",
    "焯水时间过长，鱿鱼缩成硬块，咬着像橡皮筋。",
    "火小慢炒，鱿鱼出一锅水，成品变成水煮鱿鱼。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "章鱼",
      "ratio": "450克:450克",
      "note": "章鱼须先煮二十分钟软化，再按同样方法爆炒。"
    },
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "80克:80克",
      "note": "没有鲜笋用茭白，口感同样脆嫩。"
    }
  ],
  "variations": [
    "加一勺辣椒油同炒，做成微辣版本。",
    "用韭菜段代替青椒，香味更冲，是胶东常见的配法。"
  ],
  "serving_suggestion": "装白盘趁热上桌，花刀张开像麦穗，配一碗米饭，从下锅到吃完不超过十分钟最好。",
  "storage": "冷藏可存一天，复热用大火快炒三十秒，别加水也别用微波炉。",
