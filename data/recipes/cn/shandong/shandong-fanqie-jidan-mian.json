    "汤锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫三十秒后撕去外皮，切成滚刀块。",
      "time_min": 6,
      "heat": "大火",
      "tip": "番茄去皮后汤才顺滑不挂渣，口感差别很明显。",
      "visual_cue": "番茄皮轻松撕下，果肉成块不流汁。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散后加一小撮盐搅匀，锅中放植物油烧热，倒入蛋液炒成大块盛出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "蛋液下锅别急着搅，等边缘凝固再推，蛋块才蓬松。",
      "visual_cue": "蛋块金黄蓬松，表面无流动蛋液。"
    },
    {
      "n": 3,
      "text": "锅中留底油下葱花炒香，倒入番茄块中火炒到出汁、边缘软塌。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄一定要炒出红汁，汤的酸甜味全靠这一步。",
      "visual_cue": "锅里番茄塌软，红汁漫出。"
    },
    {
      "n": 4,
      "text": "加清水烧开，用盐、白糖和生抽调味，尝一口应酸中带鲜。",
      "time_min": 4,
      "heat": "大火",
      "tip": "白糖只为压住尖酸，尝不到甜味就对了。",
      "visual_cue": "汤色橙红清亮，微微冒泡。"
    },
    {
      "n": 5,
      "text": "下入面条煮到断生，倒回炒好的鸡蛋块，撒葱花即可盛碗。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鸡蛋回锅后只煮半分钟，久煮会变老发硬。",
      "visual_cue": "面条浮起，蛋块吸了汤汁鼓胀。"
    }
  ],
  "tips": [
    "番茄去皮后再下锅炒，煮出的汤才顺滑细腻不挂渣。",
    "番茄要炒到出红汁再加水，汤的酸甜才有底味。",
    "鸡蛋先炒成块再回锅，蛋香浓又不散碎。"
  ],
  "common_mistakes": [
    "番茄没炒出汁就加水，汤清得像刷锅水，一点不鲜。",
    "鸡蛋在汤里久煮，蛋块缩水变硬，吃着发柴。",
    "盐放早了番茄不易出汁，汤会寡淡发酸。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "番茄",
      "ratio": "300克:300克",
      "note": "没有新鲜番茄可用四百克罐装番茄块，酸味更集中。"
    },
    {
      "original": "细面条",
      "substitute": "面片",
      "ratio": "300克:250克",
      "note": "换成面片做番茄鸡蛋面片，更适合小孩吃。"
    }
  ],
  "variations": [
    "加一小勺番茄酱一起炒，颜色更红、酸甜更足。",
    "最后淋几滴香油和一小撮白胡椒，汤的层次会更厚。"
  ],
  "serving_suggestion": "番茄鸡蛋面汤宽面细，一人一碗热腾腾端上桌，配一小碟咸菜就是最省事的家常饭。",
  "storage": "汤面冷藏可存一天，复热时加少量清水烧开，面条另煮口感更好。",
