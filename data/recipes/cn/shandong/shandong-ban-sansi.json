  "steps": [
    {
      "n": 1,
      "text": "粉丝用温水泡二十分钟到完全软化，剪成八厘米长的段备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "粉丝别用开水泡，开水一烫就断，吃着烂糊。",
      "visual_cue": "粉丝通体透亮，掐断无硬芯"
    },
    {
      "n": 2,
      "text": "大白菜剥去外层老帮，只留嫩心，顺着纹理切成两毫米宽的细丝。",
      "time_min": 6,
      "heat": "无火",
      "tip": "白菜心切丝前先片薄，切出来才细匀。",
      "visual_cue": "白丝细白蓬松，不粘连成团"
    },
    {
      "n": 3,
      "text": "胡萝卜去皮切薄片，再改刀成同样粗细的细丝，香菜切小段。",
      "time_min": 5,
      "heat": "无火",
      "tip": "胡萝卜先切片再切丝，粗细才跟白菜配得上。",
      "visual_cue": "胡萝卜丝橙红挺直，长短一致"
    },
    {
      "n": 4,
      "text": "汤锅烧开水，粉丝下锅焯四十秒捞出过凉水，再下胡萝卜丝焯三十秒。",
      "time_min": 5,
      "heat": "大火",
      "tip": "胡萝卜焯一下能去生味，颜色也更亮更好看。",
      "visual_cue": "粉丝根根分明，胡萝卜丝油亮"
    },
    {
      "n": 5,
      "text": "白菜丝、粉丝段、胡萝卜丝放进拌菜盆，加蒜末、香醋、生抽、盐、白糖和芝麻油抓拌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先用芝麻油抓一遍再放醋，菜丝才不塌。",
      "visual_cue": "三丝均匀挂汁，盆底不见积水"
    },
    {
      "n": 6,
      "text": "撒上香菜段，装盘后淋一勺辣椒油在顶部点缀。",
      "time_min": 1,
      "heat": "无火",
      "tip": "辣椒油最后淋面上，红亮好看也不串味。",
      "visual_cue": "红白橙三色分明，油光发亮"
    }
  ],
  "tips": [
    "白菜心比菜帮脆甜，拌三丝只用菜心口感最好。",
    "粉丝焯后过凉水能防粘，也可以拌前剪短省得缠牙。",
    "喜酸可把香醋加到三十毫升，静置五分钟更入味。"
  ],
  "common_mistakes": [
    "粉丝泡得太久，下锅就烂成糊，搅两下全断。",
    "白菜切好就拌，出水快，十分钟后整盘泡在汤里。",
    "调料一次全倒进去，醋先入导致菜丝脱水发软。"
  ],
  "substitutions": [
    {
      "original": "粉丝",
      "substitute": "粉皮",
      "ratio": "60克:120克",
      "note": "粉皮泡软切条，口感更筋道。"
    },
    {
      "original": "大白菜",
      "substitute": "圆白菜",
      "ratio": "300克:300克",
      "note": "圆白菜心更脆，焯水时间缩短一半。"
    }
  ],
  "variations": [
    "加五十克摊蛋皮切丝，三丝变四丝，荤香更足。",
    "加三十克海蜇丝同拌，是山东席面上的高级版本。"
  ],
  "serving_suggestion": "装浅盘上桌，作为凉菜首发，配烤肉、配酒、配馒头都清爽解腻。",
  "storage": "现拌现吃最好，冷藏可存一天；存放时把料汁分开，吃前再拌。",
