  "steps": [
    {
      "n": 1,
      "text": "莴笋削去外皮与内层白筋，斜刀切成菱形片，泡进清水备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "白筋一定要削净，留着嚼起来满口渣。",
      "visual_cue": "笋肉翠绿透亮，厚薄一致"
    },
    {
      "n": 2,
      "text": "泡发的木耳撕成小朵，下沸水焯一分钟捞出沥干水分。",
      "time_min": 3,
      "heat": "大火",
      "tip": "木耳先焯一遍水，炒的时候不炸锅也更爽脆。",
      "visual_cue": "木耳舒展发亮，卷边成形"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下姜丝与葱段小火煸出香味。",
      "time_min": 1,
      "heat": "小火",
      "tip": "姜葱只取香，别煸到发黄，颜色一深就带苦。",
      "visual_cue": "葱段转深绿，香味飘出"
    },
    {
      "n": 4,
      "text": "转大火下莴笋薄片与木耳快速翻炒，撒入盐与白糖炒匀。",
      "time_min": 3,
      "heat": "大火",
      "tip": "莴笋生吃都行，炒到断生就够，久了发黄发软。",
      "visual_cue": "笋肉仍翠绿，边缘略透"
    },
    {
      "n": 5,
      "text": "沿锅边淋入香油，颠锅两下让油裹匀，立刻出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "香油一定要最后淋，提前放会受热失香发苦。",
      "visual_cue": "菜面油亮，绿中夹黑卖相清爽"
    }
  ],
  "tips": [
    "莴笋叶别丢，洗净后蒜炒或做汤，比笋肉还清甜。",
    "切片后泡水十分钟，能去掉部分苦味，口感更脆。",
    "想更清爽可改成凉拌，用热油泼蒜末拌开即可。"
  ],
  "common_mistakes": [
    "莴笋皮削得太浅，白筋留在菜里，嚼着全是渣。",
    "火小慢慢炒，莴笋出水变软，颜色也发暗。",
    "盐下得太早，笋肉迅速出水，炒出来一盘汤。"
  ],
  "substitutions": [
    {
      "original": "莴笋",
      "substitute": "山药",
      "ratio": "350克:350克",
      "note": "山药须戴手套削皮，切片后泡水防黑。"
    },
    {
      "original": "木耳",
      "substitute": "香菇",
      "ratio": "30克:60克",
      "note": "香菇切片同炒，香气更浓。"
    }
  ],
  "variations": [
    "加几片腊肉同炒，荤素搭配，是山东冬天最常见的家常吃法。",
    "起锅前沿锅边加一小勺香醋，酸脆更开胃，配粥尤其好。"
  ],
  "serving_suggestion": "现炒现吃，作为油腻主菜的配菜最合宜，也可冷后当爽口小菜。",
  "storage": "冷藏可存一天，复热须大火快炒，久了颜色发黄、口感变韧。",
