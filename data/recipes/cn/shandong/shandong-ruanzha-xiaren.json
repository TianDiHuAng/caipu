        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "漏勺",
    "碗",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁挑掉背上的黑线，用盐和料酒抓洗一遍，冲净后用厨房纸吸干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "虾仁必须吸干水，带水下锅糊会脱壳、油也乱溅。",
      "visual_cue": "虾仁表面干爽，无黏液"
    },
    {
      "n": 2,
      "text": "虾仁加盐和白胡椒抓匀，静置腌五分钟，让底味渗进去、腥气散掉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "腌的时间别超过十分钟，久了虾肉发紧出水。",
      "visual_cue": "虾仁表面略见调味料附着，手感发滑"
    },
    {
      "n": 3,
      "text": "鸡蛋打散，加玉米淀粉搅成能缓慢流动的蛋糊，静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糊要稠到能挂住虾仁又不滴落，太稀就挂不住。",
      "visual_cue": "蛋糊用勺舀起能拉出缓慢的线"
    },
    {
      "n": 4,
      "text": "植物油烧到五成热，虾仁逐个裹满蛋糊下锅，中小火炸到蛋糊蓬起。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "油温五成最稳，太高外糊内生，太低糊会吸油发软。",
      "visual_cue": "外壳浅黄蓬松，虾仁卷曲"
    },
    {
      "n": 5,
      "text": "虾仁浮起后捞出，把植物油温升到七成复炸三十秒，捞出沥油装盘。",
      "time_min": 4,
      "heat": "大火",
      "tip": "复炸只为逼出余油、让外壳挺起来，三十秒足够。",
      "visual_cue": "外壳金黄挺脆，敲着有声"
    }
  ],
  "tips": [
    "虾仁分次下锅，一次下太多油温骤降，外壳会软塌。",
    "蛋糊里不加面粉，全靠玉米淀粉，炸出来才轻脆不发硬。",
    "复炸前把油里的碎糊捞净，否则碎渣会烧焦带苦味。"
  ],
  "common_mistakes": [
    "虾仁没吸干就裹糊，下锅后糊壳整片脱落，虾仁裸着被炸老。",
    "油温太低就下锅，外壳吸饱油，端上桌一按一层油。",
    "炸好堆在盘里盖上盖子焖着，水汽一闷外壳立刻回软。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "河虾仁",
      "ratio": "400克:400克",
      "note": "河虾仁更小更鲜甜，炸制时间缩短到一分半。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "红薯淀粉",
      "ratio": "50克:45克",
      "note": "红薯淀粉炸出来更脆，用量略减以免糊太稠。"
    }
  ],
  "variations": [
    "蘸椒盐吃是最常见的配法，也可配一小碟番茄酱给小孩。",
    "糊里加几滴料酒和少许白胡椒，去腥更彻底。"
  ],
  "serving_suggestion": "炸好立刻装盘，垫一层厨房纸或生菜叶，旁边放一小碟椒盐，趁热上桌。",
  "storage": "现炸现吃最好，冷藏不超过一天；复热用烤箱二百度烤五分钟，别用微波炉。",
