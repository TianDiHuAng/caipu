  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 600,
          "unit": "g",
          "note": "留一百克戗面用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 6,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "小苏打",
          "name_en": "baking soda",
          "amount": 2,
          "unit": "g",
          "note": "中和酸味",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 300,
          "unit": "ml",
          "note": "温水化酵母",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "不锈钢盆",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母与白糖用三百毫升温水化开，倒入五百克面粉中揉成光滑面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水温摸着微温就够，烫了酵母会死。",
      "visual_cue": "面团光滑、盆底不见散粉"
    },
    {
      "n": 2,
      "text": "面团盖布放在温暖处发酵至两倍大，约需九十分钟。",
      "time_min": 90,
      "heat": "无火",
      "tip": "天冷时可放进关火的烤箱里发。",
      "visual_cue": "体积膨大、内部呈蜂窝状"
    },
    {
      "n": 3,
      "text": "发好的面团加小苏打揉匀排气，再分次揉入剩下的一百克面粉。",
      "time_min": 20,
      "heat": "无火",
      "tip": "戗面要一点点加，揉到面团发硬。",
      "visual_cue": "面团紧实、切面细腻无气孔"
    },
    {
      "n": 4,
      "text": "面团搓成长条切成六个剂子，逐个揉圆成馒头坯，静置二十分钟。",
      "time_min": 25,
      "heat": "无火",
      "tip": "二次醒发到位，蒸出来才蓬松。",
      "visual_cue": "馒头坯轻按能回弹"
    },
    {
      "n": 5,
      "text": "蒸锅水开后放入馒头坯，大火蒸二十分钟，关火焖三分钟再开盖。",
      "time_min": 24,
      "heat": "大火",
      "tip": "关火别急着开盖，骤冷会塌陷。",
      "visual_cue": "馒头洁白饱满、表皮光滑"
    }
  ],
  "tips": [
    "戗面揉得越硬，蒸出来的层次越筋道。",
    "蒸锅水量一次给足，中途开盖会跑气。",
    "馒头凉透再装袋，否则表皮会发黏。"
  ],
  "common_mistakes": [
    "戗面一次全倒进去，面团揉不匀还开裂。",
    "发酵过了头带酸味，蒸出来一股酒气。",
    "关火立刻开盖，馒头遇冷收缩塌陷。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "高筋面粉",
      "ratio": "600g 对 600g",
      "note": "更筋道，需多揉五分钟。"
    },
    {
      "original": "小苏打",
      "substitute": "食用碱",
      "ratio": "2g 对 2g",
      "note": "须用少量水化开再揉。"
    }
  ],
  "variations": [
    "做成刀切馒头，剂子直接上锅更省事。",
    "把面团做成大个的饽饽，蒸制时间延长十分钟。"
  ],
  "serving_suggestion": "趁热掰开吃，配小菜或直接蘸酱都好。",
  "storage": "凉透后装袋冷冻，复蒸十分钟即恢复松软。",
