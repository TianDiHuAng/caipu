    "深盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉先切片再剁成粗粒，荸荠切成小粒备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "手工剁的肉料更有颗粒感。",
      "visual_cue": "肉料细腻带黏性、荸荠粒均匀"
    },
    {
      "n": 2,
      "text": "把剁好的五花肉加 1 个鸡蛋、3g 盐、30ml 生抽、15ml 料酒、葱姜末与 30g 玉米淀粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "顺一个方向搅，肉料才上劲不散。",
      "visual_cue": "肉料抱团起胶、表面发亮"
    },
    {
      "n": 3,
      "text": "顺一个方向搅打至起胶，拌入荸荠粒，双手沾水团成 4 个大丸子。",
      "time_min": 8,
      "heat": "无火",
      "tip": "摔打能让丸子紧实，炖时不裂。",
      "visual_cue": "丸子表面光滑圆整"
    },
    {
      "n": 4,
      "text": "炒锅倒 200ml 植物油烧至六成热，下丸子中火炸 6 分钟至表面金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温不够丸子会散，太热外焦里生。",
      "visual_cue": "丸子浮起、外壳金黄挺立"
    },
    {
      "n": 5,
      "text": "捞出丸子放入深盘，加 300ml 清水、5g 白糖与剩余生抽。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水量到丸子一半高即可。",
      "visual_cue": "汤汁没过丸子下半部分"
    },
    {
      "n": 6,
      "text": "上锅大火蒸 25 分钟，取出丸子装盘，蒸出的汤汁勾薄芡淋上。",
      "time_min": 28,
      "heat": "大火",
      "tip": "蒸比炖更能保住丸子形状。",
      "visual_cue": "丸子膨大松软、汤汁浓稠挂勺"
    }
  ],
  "tips": [
    "五花肉选肥三瘦七，蒸出来才不柴不腻。",
    "下锅前反复摔打排气，丸子才不会开裂。",
    "蒸出的原汤勾芡，比另调酱汁更鲜。"
  ],
  "common_mistakes": [
    "肉料全用瘦肉，蒸完干硬像肉饼。",
    "油温过低就下锅，丸子散在油里成肉渣。",
    "大火久蒸不收汁，丸子泡在汤里发淡。"
  ],
  "substitutions": [
    {
      "original": "荸荠",
      "substitute": "莲藕",
      "ratio": "100g 对 100g",
      "note": "口感更脆，需切得更细。"
    },
    {
      "original": "五花肉",
      "substitute": "梅花肉",
      "ratio": "500g 对 500g",
      "note": "脂肪略少，可加 20g 猪油。"
    }
  ],
  "variations": [
    "红烧版：炸后加酱油冰糖小火煨 40 分钟。",
    "清蒸版：不炸直接蒸 35 分钟，更清淡。"
  ],
  "serving_suggestion": "四个丸子寓意福禄寿喜，山东宴席上压轴出场，配青菜垫底。",
  "storage": "冷藏 2 天，复热时加少量清水蒸 10 分钟。",
