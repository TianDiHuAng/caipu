    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "紫菜撕成小片放碗底，用清水快速冲一遍，去掉表面浮沙后沥干。",
      "time_min": 3,
      "heat": "无火",
      "tip": "紫菜别久泡，泡久了鲜味全跑到水里去了。",
      "visual_cue": "紫菜片舒展，水色清亮无沙"
    },
    {
      "n": 2,
      "text": "嫩豆腐切成八毫米见方的小丁，放进淡盐水里浸两分钟捞出。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐水浸一下豆腐不易碎，还能去豆腥。",
      "visual_cue": "豆腐丁方正完整，边缘不塌"
    },
    {
      "n": 3,
      "text": "鸡汤倒入汤锅烧开，下豆腐丁小火煮三分钟让豆香融进汤里。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆腐先煮一会儿再下蛋液，汤才清而有味。",
      "visual_cue": "汤面微沸，豆腐丁浮起"
    },
    {
      "n": 4,
      "text": "鸡蛋打散，汤保持微沸，蛋液从高处细流淋入，静置十秒再推动。",
      "time_min": 1,
      "heat": "小火",
      "tip": "淋蛋液时别搅，等它自己凝成片再推。",
      "visual_cue": "蛋花成薄片状悬浮，汤色微黄"
    },
    {
      "n": 5,
      "text": "加盐和白胡椒粉调味，放入紫菜推匀，关火淋芝麻油撒小葱末。",
      "time_min": 2,
      "heat": "小火",
      "tip": "紫菜一定要最后放，久煮就会发黏发暗。",
      "visual_cue": "紫菜翠黑舒展，蛋花均匀不沉底"
    }
  ],
  "tips": [
    "蛋液里加半勺清水再打散，蛋花更嫩更蓬。",
    "紫菜选厚实的头水紫菜，一烫就散开，汤也鲜。",
    "喜欢酸辣可加五毫升香醋和少许辣椒油，即成酸辣版。"
  ],
  "common_mistakes": [
    "紫菜一开始就下锅煮，汤色发黑，紫菜变糊。",
    "蛋液倒进滚开的汤里猛搅，蛋花碎成末。",
    "白胡椒粉放太多，压住了紫菜本身的鲜味。"
  ],
  "substitutions": [
    {
      "original": "鸡汤",
      "substitute": "清水",
      "ratio": "700毫升:700毫升",
      "note": "清水版本加两克鸡精或十毫升生抽提鲜。"
    },
    {
      "original": "嫩豆腐",
      "substitute": "北豆腐",
      "ratio": "200克:200克",
      "note": "北豆腐口感更实，切丁后煮的时间加一分钟。"
    }
  ],
  "variations": [
    "加二十克泡发的虾皮同煮，鲜味更浓。",
    "出锅前撒一把香菜段，清香味更足更好闻。"
  ],
  "serving_suggestion": "盛碗后趁热喝，作为一餐的收尾汤，配饺子、包子或米饭都合适。",
  "storage": "现做现喝，冷藏不超过一天；复热时蛋花会散，紫菜变软，风味下降。",
