  "equipment": [
    "汤锅",
    "漏勺",
    "拌碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芝麻酱盛进碗里，分三次加清水，每次都顺同一方向搅到完全吸收。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水一定要分次加，一次倒多会把麻汁搅成疙瘩。",
      "visual_cue": "麻汁顺滑能挂勺，滴落成线。"
    },
    {
      "n": 2,
      "text": "调好的麻汁里加生抽、香醋和盐搅匀，尝一口应是咸酸适口。",
      "time_min": 3,
      "heat": "无火",
      "tip": "醋能解麻汁的腻，量按口味可在后面再加。",
      "visual_cue": "酱汁呈浅褐色，稀稠适中。"
    },
    {
      "n": 3,
      "text": "汤锅烧开大量清水，下面条煮到刚断生，捞出立刻过两遍凉开水。",
      "time_min": 6,
      "heat": "大火",
      "tip": "面要过凉水才爽滑不粘，凉水必须是可以直接喝的水。",
      "visual_cue": "面条根根清爽，摸着不粘手。"
    },
    {
      "n": 4,
      "text": "沥干的面条拌入植物油抖散，摊在大盘里晾到常温。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌一点油再晾，面条就不会粘成一大块。",
      "visual_cue": "面条松散分明，表面有淡淡油光。"
    },
    {
      "n": 5,
      "text": "面条装碗，铺上黄瓜丝，浇两大勺麻汁，淋香油后拌开食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "麻汁浇在黄瓜上再拌，黄瓜出水能稀释酱汁更好拌。",
      "visual_cue": "酱汁均匀裹住面条，黄瓜丝清脆。"
    }
  ],
  "tips": [
    "麻汁分次加水才调得开，一次加多必起疙瘩。",
    "面条过凉水要彻底，面身凉透才爽滑不粘。",
    "拌面前给面拌少许油抖散，摊开放凉不结块。"
  ],
  "common_mistakes": [
    "麻汁一次加太多水，搅成一碗稀汤，挂不住面条。",
    "面条捞出没过凉水就拌，粘成一大坨分不开。",
    "黄瓜丝切得太粗，拌起来不顺口，也压不住麻汁的腻。"
  ],
  "substitutions": [
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "60克:60克",
      "note": "花生酱更甜香，需少放一点盐。"
    },
    {
      "original": "黄瓜",
      "substitute": "胡萝卜",
      "ratio": "150克:120克",
      "note": "胡萝卜切细丝焯一下，颜色更漂亮。"
    }
  ],
  "variations": [
    "济南街头会额外加一勺蒜汁和香椿末，辛香更足。",
    "夏天把面条换成过凉水的荞麦面，口感更清爽。"
  ],
  "serving_suggestion": "麻汁凉面是济南夏天的当家主食，一碗面配一根黄瓜，酸香微咸，吃完整个人都凉快下来。",
  "storage": "麻汁可提前调好冷藏两天，面条现煮现拌，不建议隔夜。",
