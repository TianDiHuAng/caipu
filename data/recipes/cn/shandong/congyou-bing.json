  "id": "congyou-bing",
  "name": {
    "zh": "葱油饼",
    "en": "Scallion Pancake"
  },
  "cuisine": {
    "region": "cn",
    "style": "shandong"
  },
  "category": [
    "snack"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 40,
    "cook_min": 12,
    "total_min": 52
  },
  "servings": 3,
  "flavor": [
    "savory",
    "fragrant",
    "salty"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 60,
          "unit": "g",
          "note": "只用葱绿切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 70,
          "unit": "ml",
          "note": "做油酥与煎饼",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 180,
          "unit": "ml",
          "note": "温水和面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "揉面盆",
    "擀面杖",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加一百八十毫升温水，边倒边搅成絮状再揉成团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水温约四十度，面皮才软和。",
      "visual_cue": "面团成团、不粘盆壁"
    },
    {
      "n": 2,
      "text": "面团盖上湿布醒三十分钟，中途翻面一次防止发干。",
      "time_min": 32,
      "heat": "无火",
      "tip": "醒足时间，擀开才不回缩。",
      "visual_cue": "面团柔软、按压能留指印"
    },
    {
      "n": 3,
      "text": "取一小碗面粉，浇上烧热的植物油拌成流动的油酥。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油酥是起层的关键，别省这一步。",
      "visual_cue": "油酥顺滑无干粉、能流动"
    },
    {
      "n": 4,
      "text": "小葱只用葱绿切成细碎，加盐与白胡椒拌匀备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "葱绿最香，葱白留着炒菜。",
      "visual_cue": "葱花翠绿、颗粒均匀"
    },
    {
      "n": 5,
      "text": "面团擀成大薄片，抹匀油酥，撒满葱花后卷成长条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "油酥抹匀，饼才会层层起酥。",
      "visual_cue": "薄片透光、葱花铺满"
    },
    {
      "n": 6,
      "text": "长条盘成螺旋状压扁，再擀成半厘米厚的圆饼。",
      "time_min": 6,
      "heat": "无火",
      "tip": "轻轻擀，别把层次压死。",
      "visual_cue": "饼坯圆整、层次隐约可见"
    },
    {
      "n": 7,
      "text": "平底锅刷油烧热，饼坯下锅中火煎三分钟至底面金黄。",
      "time_min": 4,
      "heat": "中火",
      "tip": "锅要热，饼才不会吸油发硬。",
      "visual_cue": "底面金黄、饼身鼓起"
    },
    {
      "n": 8,
      "text": "翻面再煎三分钟，两面酥脆时用铲子轻拍几下出锅。",
      "time_min": 4,
      "heat": "中火",
      "tip": "轻拍饼身，层次会更松散。",
      "visual_cue": "两面酥黄、层次分明可揭开"
    }
  ],
  "tips": [
    "和面时加一勺油，饼皮更酥更香。",
    "葱绿切好后别久放，容易出水变蔫。",
    "煎好的饼切开吃，层次看得更清楚。"
  ],
  "common_mistakes": [
    "面没醒够就擀，一擀就回缩擀不开。",
    "葱花撒得太少，煎出来只有面味没葱香。",
    "煎的时候火太小，饼吸满油变得又腻又硬。"
  ],
  "substitutions": [
    {
      "original": "小葱",
      "substitute": "韭菜",
      "ratio": "60g 对 60g",
      "note": "香气不同，需挤干水分。"
    },
    {
      "original": "面粉",
      "substitute": "全麦粉",
      "ratio": "300g 对 260g",
      "note": "吸水量大，多加二十毫升水。"
    }
  ],
  "variations": [
    "油酥里加一勺五香粉，香气更有层次。",
    "卷饼时夹一片猪油，酥松程度立刻提升。"
  ],
  "serving_suggestion": "趁热切开吃，配豆浆或粥都合适。",
  "storage": "冷藏可放两天，复热用平底锅烘脆。",
  "nutrition_estimate": {
    "basis": "每份（约 150g）",
    "calories_kcal": 460,
