  "equipment": [
    "平底锅",
    "菜刀",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "带鱼剪去头尾与侧鳍，剖开腹部去掉内脏和黑膜，切成八厘米长的段，洗净后用厨房纸吸干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表面必须擦干，否则下锅溅油、脱皮。",
      "visual_cue": "鱼段干爽、不滴水"
    },
    {
      "n": 2,
      "text": "鱼段加盐、料酒、胡椒、姜片与花椒抓匀，腌十五分钟入味去腥。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌够时间才不腥，中途翻一次面。",
      "visual_cue": "鱼段略紧实、闻着有姜香"
    },
    {
      "n": 3,
      "text": "面粉倒在盘里，鱼段两面薄薄拍一层干粉，抖掉多余的粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉只拍薄薄一层，厚了像面壳。",
      "visual_cue": "鱼段表面干爽、能见鱼皮纹路"
    },
    {
      "n": 4,
      "text": "平底锅倒植物油烧到五成热，鱼段依次码入锅中，先别翻动，中火煎到边缘金黄结皮。",
      "time_min": 3,
      "heat": "中火",
      "tip": "下锅后别急着动，结皮自然脱锅。",
      "visual_cue": "鱼段边缘金黄、能推动"
    },
    {
      "n": 5,
      "text": "一面煎好后翻面继续煎，两面共煎八分钟到外壳酥硬。",
      "time_min": 8,
      "heat": "中火",
      "tip": "全程中火，火大外面糊里面生。",
      "visual_cue": "两面金黄、筷子敲有脆响"
    },
    {
      "n": 6,
      "text": "出锅前把葱段放进锅里，连锅颠一颠让葱香沾上鱼身，装盘即成。",
      "time_min": 2,
      "heat": "中火",
      "tip": "葱最后放，只用余温激香。",
      "visual_cue": "葱段翠绿、鱼身油亮"
    }
  ],
  "tips": [
    "带鱼表面的银膜别刮掉，那是鲜味最浓的部分。",
    "拍粉后用厨房纸轻压，煎出来更酥。",
    "煎好的鱼趁热吃，凉了腥味会回来。"
  ],
  "common_mistakes": [
    "鱼段没擦干就下锅，油爆四溅且鱼皮全破。",
    "油温不够下锅，鱼段泡在油里出不了脆壳。",
    "不停翻动鱼段，鱼身被铲散成几块，卖相全无。"
  ],
  "substitutions": [
    {
      "original": "带鱼",
      "substitute": "鲳鱼",
      "ratio": "500g 对 500g",
      "note": "鲳鱼更厚，煎制时间各加两分钟。"
    },
    {
      "original": "面粉",
      "substitute": "玉米淀粉",
      "ratio": "50g 对 50g",
      "note": "淀粉煎后更脆，但易回软。"
    }
  ],
  "variations": [
    "腌鱼时加一勺辣椒面，做成微麻辣的干煎版。",
    "煎好后加葱姜与醋同烧两分钟，改成红烧带鱼。"
  ],
  "serving_suggestion": "配一小碟椒盐或香醋蘸食，搭粥饭都合口。",
  "storage": "冷藏两天，复热用平底锅小火回煎三分钟。",
