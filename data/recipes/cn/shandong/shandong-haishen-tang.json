  "steps": [
    {
      "n": 1,
      "text": "水发海参用清水冲洗，片成半厘米厚的斜片，再用温水泡五分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "海参要选发得透的，摸着有弹性不软烂。",
      "visual_cue": "海参片厚薄均匀，表面光滑。"
    },
    {
      "n": 2,
      "text": "火腿切薄片，香菇切片，枸杞用清水冲净备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "火腿片薄一点，汤里才出味不夺味。",
      "visual_cue": "火腿片透光，边缘整齐。"
    },
    {
      "n": 3,
      "text": "高汤入锅，加姜丝与料酒煮开，下火腿片与香菇煮八分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "火腿先煮，汤底带咸鲜底味。",
      "visual_cue": "汤色微黄，香菇浮起。"
    },
    {
      "n": 4,
      "text": "放海参片，转小火煮五分钟让海参吸足汤味。",
      "time_min": 7,
      "heat": "小火",
      "tip": "小火慢煮，海参才不发硬收缩。",
      "visual_cue": "海参片微微透明。"
    },
    {
      "n": 5,
      "text": "加盐与白胡椒调味，撒入枸杞再煮一分钟左右。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盐要少放，火腿本身有咸味。",
      "visual_cue": "枸杞饱满，汤面清亮。"
    },
    {
      "n": 6,
      "text": "淋上香油，撒小葱花开锅，分装到汤碗里上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "香油最后淋，香气不散。",
      "visual_cue": "汤面一圈油光，葱花翠绿。"
    }
  ],
  "tips": [
    "海参本身无味，全靠高汤与火腿提鲜。",
    "水发海参买回来要先用温水泡去碱味。",
    "喜欢浓一点可以改用奶汤，汤色乳白更醇厚。"
  ],
  "common_mistakes": [
    "海参下锅大火久煮，缩水又发硬。",
    "盐放早了，海参出水，汤味变淡。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "金华火腿薄片",
      "ratio": "50g 对 45g",
      "note": "金华火腿更咸，盐要减到 3g。"
    }
  ],
  "variations": [
    "济南的老做法会在汤里加几片青笋与一小勺香醋，喝起来更清爽。"
  ],
  "serving_suggestion": "清汤上桌，餐前一人一小碗，配花卷。",
  "storage": "冷藏一天，复热时加少量高汤，不要久煮。",
