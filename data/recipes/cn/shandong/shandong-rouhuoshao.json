  ],
  "equipment": [
    "案板",
    "擀面杖",
    "平底锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加酵母和温水揉成偏软的面团，盖布醒发到半发状态。",
      "time_min": 10,
      "heat": "无火",
      "tip": "肉火烧讲究半发面，发得太足皮就松软不脆。",
      "visual_cue": "面团微膨松，按压有浅浅凹痕。"
    },
    {
      "n": 2,
      "text": "醒面期间把五花肉剁成小丁，加葱碎、姜末、生抽、五香粉和盐搅到起胶。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉丁别剁成泥，留颗粒才有咬劲，搅到发黏再拌油封住汁水。",
      "visual_cue": "五花肉丁黏稠抱团，闻着咸香。"
    },
    {
      "n": 3,
      "text": "面团醒好后分成四份，擀成中间厚边缘薄的圆皮，包入五花肉丁收口捏紧。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮边擀薄才不硌口，收口一定捏严，否则烙时漏汁。",
      "visual_cue": "皮薄馅饱，收口严密成小圆包。"
    },
    {
      "n": 4,
      "text": "包好的饼坯轻轻按扁，光面朝下放入刷了花生油的平底锅小火烙。",
      "time_min": 12,
      "heat": "小火",
      "tip": "按扁时用手掌从中间向外压，别用擀面杖把馅挤破。",
      "visual_cue": "饼坯扁圆，底面定型呈浅金色。"
    },
    {
      "n": 5,
      "text": "翻面后加盖焖烙到两面金黄鼓起，用锅铲按压有弹性即可出锅。",
      "time_min": 10,
      "heat": "小火",
      "tip": "加盖能让馅心熟透，两面各烙到金黄再出锅才脆。",
      "visual_cue": "两面金黄脆壳，按压回弹有弹性。"
    }
  ],
  "tips": [
    "半发面是肉火烧外脆内软的关键，别发过头。",
    "肉丁尽量手工剁成小粒，保留颗粒感才有潍坊肉火烧的咬劲。",
    "小火加盖慢慢烙，热量透进去馅心才能熟透，不会夹生带血。"
  ],
  "common_mistakes": [
    "面团发过头，烙出来皮厚发暄没有脆壳。",
    "五花肉丁调得太稀，包的时候汁水外漏，下锅还容易溅油烫手。",
    "大火急烙追求脆壳，结果外皮焦黑而里头的五花肉丁还带血色。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪肉糜",
      "ratio": "250克:250克",
      "note": "机器绞的肉泥更省事，但口感不如手工丁。"
    },
    {
      "original": "花生油",
      "substitute": "植物油",
      "ratio": "40毫升:40毫升",
      "note": "植物油更清淡，适合不吃花生味的人。"
    }
  ],
  "variations": [
    "有的摊子会在馅里加一勺木耳碎，口感更脆爽。",
    "换成牛肉丁加花椒水打馅，就是牛肉火烧。"
  ],
  "serving_suggestion": "刚出锅的肉火烧配一碗小米粥或豆浆，是潍坊人的标准早饭。",
  "storage": "凉后可冷藏一天，吃前用平底锅小火两面各烙两分钟回脆。",
