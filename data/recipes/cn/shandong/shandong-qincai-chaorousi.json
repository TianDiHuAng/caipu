  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芹菜摘去叶片，撕掉背面的粗筋，斜刀切成四厘米长的段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "背面粗筋一定要撕掉，不然嚼着塞牙。",
      "visual_cue": "芹菜段斜口整齐，筋络去净"
    },
    {
      "n": 2,
      "text": "猪里脊切成细丝，加料酒、玉米淀粉和一勺清水抓匀，静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "上浆时抓进一点清水，肉丝炒出来才够嫩。",
      "visual_cue": "肉丝表面裹着薄浆，互不粘连"
    },
    {
      "n": 3,
      "text": "木耳泡发后切丝，大蒜切片，姜切细丝，全部备好放在手边。",
      "time_min": 3,
      "heat": "无火",
      "tip": "炒菜火急，配料提前备齐才不手忙脚乱。",
      "visual_cue": "配料分开放置，量已备足"
    },
    {
      "n": 4,
      "text": "花生油烧到六成热，下肉丝快速滑散，全部变色后盛出备用。",
      "time_min": 2,
      "heat": "中火",
      "tip": "滑肉丝的油温别太高，六成热下锅最嫩。",
      "visual_cue": "肉丝松散发白，不见血水"
    },
    {
      "n": 5,
      "text": "原锅下姜丝、大蒜片爆香，放芹菜段和木耳丝大火翻炒两分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "芹菜要大火快炒，颜色才翠、口感才脆。",
      "visual_cue": "芹菜转深绿透亮，锅气十足"
    },
    {
      "n": 6,
      "text": "倒回滑好的肉丝，加生抽和盐快速翻匀，出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "盐一定要最后放，放早了芹菜会出水变软。",
      "visual_cue": "菜色青绿发亮，盘底不见汤汁"
    }
  ],
  "tips": [
    "芹菜选茎细的香芹，比粗梗西芹更香更脆。",
    "芹菜叶别扔，焯水后拌蒜泥是一道小凉菜。",
    "全程不超过四分钟，火候一过芹菜就绵了。"
  ],
  "common_mistakes": [
    "芹菜没撕筋，成菜咬不断，吃着塞牙。",
    "肉丝不上浆直接下锅炒，出锅又干又柴。",
    "小火慢炒五分钟，芹菜炒成黄绿色，脆劲全无。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "牛肉",
      "ratio": "150克:150克",
      "note": "牛肉丝上浆时加一勺清水，滑油时间缩短十秒。"
    },
    {
      "original": "芹菜",
      "substitute": "蒜薹",
      "ratio": "350克:350克",
      "note": "蒜薹需先焯水一分钟，炒制时间略长。"
    }
  ],
  "variations": [
    "加五个泡发的干辣椒同炒，多一层微辣。",
    "喜欢酱香可加十克黄豆酱同炒，咸鲜更厚重。"
  ],
  "serving_suggestion": "热吃最香，配米饭或馒头都合适，也可当作面条的浇头。",
  "storage": "冷藏可存一天，复热用大火快翻，久加热芹菜会发黄出水。",
