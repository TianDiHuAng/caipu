      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 60,
          "unit": "g",
          "note": "去皮白芝麻",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 3,
          "unit": "g",
          "note": "温水化开",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "抹面用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "擀面杖",
    "烤盘",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母 3g 用 180ml 温水化开，倒入 300g 面粉与 5g 盐，揉成光滑面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水别一次倒完，留一点调整软硬。",
      "visual_cue": "面团光滑、按下能缓慢回弹"
    },
    {
      "n": 2,
      "text": "面团盖上湿布静置醒发 40 分钟，至体积略微膨胀、手感变轻。",
      "time_min": 40,
      "heat": "无火",
      "tip": "这种饼不用发透，微发就够。",
      "visual_cue": "面团松软、指按有浅坑"
    },
    {
      "n": 3,
      "text": "把面团分成 8 个小剂子，逐个擀成直径约 12 厘米的薄圆片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "薄到能看见案板纹理最理想。",
      "visual_cue": "面片薄而均匀、边缘圆整"
    },
    {
      "n": 4,
      "text": "面片表面刷一层 40ml 植物油，撒上 60g 白芝麻并轻轻压实。",
      "time_min": 4,
      "heat": "无火",
      "tip": "芝麻压一下，烤好才不会脱落。",
      "visual_cue": "芝麻铺满表面、分布均匀"
    },
    {
      "n": 5,
      "text": "烤箱预热到 200 度，把面片放中层烤 12 分钟至边缘微焦。",
      "time_min": 12,
      "heat": "中火",
      "tip": "烤盘提前预热，饼底才够脆。",
      "visual_cue": "饼面金黄、边缘呈浅褐色"
    },
    {
      "n": 6,
      "text": "出炉后趁热把烧饼立起来散热，凉透再密封保存。",
      "time_min": 5,
      "heat": "无火",
      "tip": "立着散热，水汽不回流才酥。",
      "visual_cue": "饼身轻薄、敲击有声"
    }
  ],
  "tips": [
    "面团只醒到微发，发透了就成厚饼不再酥脆。",
    "面片擀得越薄越好，烤后才有层层的脆感。",
    "烤盘一定要预热，冷盘烤出的饼底发软。"
  ],
  "common_mistakes": [
    "面团发到两倍大再擀，成品又厚又韧咬不动。",
    "芝麻直接撒不压实，出炉掉得满盘都是。",
    "烤盘没预热，饼底湿软一点也不脆。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "全麦面粉",
      "ratio": "300g 对 300g",
      "note": "口感更粗，需多加 20ml 水。"
    },
    {
      "original": "白芝麻",
      "substitute": "黑芝麻",
      "ratio": "60g 对 60g",
      "note": "香气更浓，烤温可降 10 度。"
    }
  ],
  "variations": [
    "表面刷一层淡盐水再撒芝麻，咸香更明显。",
    "加 2g 花椒粉进面团，做成麻香口味。"
  ],
  "serving_suggestion": "趁热掰开吃，配一碗羊汤或豆腐脑都很合适。",
  "storage": "密封常温可存 7 天，受潮后回炉 150 度烤 5 分钟复脆。",
