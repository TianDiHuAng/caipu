  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "小米",
          "name_en": "millet",
          "amount": 100,
          "unit": "g",
          "note": "提前浸泡至用手指能掐碎",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 100,
          "unit": "g",
          "note": "中筋面粉，调节糊的筋度",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 45,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 40,
          "unit": "ml",
          "note": "刷鏊与调糊各半",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 260,
          "unit": "ml",
          "note": "磨浆用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "吊出甜味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "鏊子",
    "搅拌机",
    "刮板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小米淘洗干净后加清水浸泡到米粒一捏就碎，中途换一次水去掉浮尘。",
      "time_min": 120,
      "heat": "无火",
      "tip": "泡透是磨浆细腻的前提，米粒中间有硬芯就打不出顺滑的浆。",
      "visual_cue": "米粒饱胀发白，手指一捏即成粉。"
    },
    {
      "n": 2,
      "text": "泡好的小米连水一起打成细米浆，用细筛过滤掉粗渣。",
      "time_min": 8,
      "heat": "无火",
      "tip": "过滤这一步别省，粗渣留在浆里会让煎饼口感发糙。",
      "visual_cue": "米浆细腻顺滑，筛网上只剩少量粗渣。"
    },
    {
      "n": 3,
      "text": "米浆里加入面粉、白糖和盐搅匀，再淋入一半花生油拌成流动的稀糊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面糊要能顺刮板流下，太稠摊不薄，太稀一揭就碎。",
      "visual_cue": "面糊细腻能流动，舀起落下成细线。"
    },
    {
      "n": 4,
      "text": "鏊子小火烧热刷一层薄花生油，舀面糊用刮板快速刮成极薄的圆饼。",
      "time_min": 5,
      "heat": "小火",
      "tip": "鏊子温度要稳，太热面糊一贴就焦，太凉揭不下来。",
      "visual_cue": "薄饼均匀透亮，边缘自然翘起。"
    },
    {
      "n": 5,
      "text": "饼皮边缘翘起后翻面，烙到两面干脆发黄，趁热揭下趁热折叠定型。",
      "time_min": 6,
      "heat": "小火",
      "tip": "趁热折，凉了饼皮变脆一折就裂，形状也不好看。",
      "visual_cue": "饼身干脆金黄，折叠后棱角挺立。"
    }
  ],
  "tips": [
    "小米必须泡到一捏就碎，磨出的浆才够细。",
    "面糊要稀到能流，摊出来的饼才薄而脆。",
    "一定要趁热折叠定型，饼皮放凉再折必然会沿折痕开裂。"
  ],
  "common_mistakes": [
    "小米泡的时间不够，米浆带粗粒，煎饼发硬硌牙。",
    "面糊调得过稠，摊出的饼厚重不透，咬着发黏。",
    "烙好的饼放到全凉才折，脆皮一弯就断成碎片，卖相全无。"
  ],
  "substitutions": [
    {
      "original": "小米",
      "substitute": "玉米面",
      "ratio": "100克:100克",
      "note": "玉米面版省去浸泡，直接调糊摊制，香气更粗犷。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "45克:45克",
      "note": "红糖版颜色更深，焦糖香更明显。"
    }
  ],
  "variations": [
    "有的做法在面糊里加一小撮熟芝麻，香气更足。",
    "老式糖酥煎饼会做成卷筒状，出炉后插在架上卖。"
  ],
  "serving_suggestion": "糖酥煎饼掰成小块当茶点，也可以卷油条当早点吃。",
  "storage": "彻底凉透后装密封罐室温存放三天，受潮可用鏊子小火复烘两分钟。",
