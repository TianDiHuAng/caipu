  "equipment": [
    "蒸锅",
    "刀",
    "砧板",
    "蒜臼"
  ],
  "steps": [
    {
      "n": 1,
      "text": "长茄子洗净去蒂，顺长剖成两半，皮朝下摆进蒸屉里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "皮朝下放，紫皮不掉色，蒸出来颜色好看。",
      "visual_cue": "茄子剖面平贴屉布，码放整齐"
    },
    {
      "n": 2,
      "text": "蒸锅水开后上屉，大火蒸十二分钟，用筷子能轻松扎透就取出。",
      "time_min": 14,
      "heat": "大火",
      "tip": "蒸到筷子一扎到底不费劲，说明已经软透。",
      "visual_cue": "茄子皮发皱，筷子插入无阻力"
    },
    {
      "n": 3,
      "text": "蒸好的茄子摊在盘里晾到不烫手，用手撕成长条，挤掉多余水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "手撕比刀切更挂汁，断面粗糙才吃得进味。",
      "visual_cue": "茄条粗细不匀但软糯，盘底无积水"
    },
    {
      "n": 4,
      "text": "大蒜去皮放蒜臼里加一点盐，捣成细腻的蒜泥，越细辣香越足。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜泥捣好先放五分钟再用，蒜香才充分释放。",
      "visual_cue": "蒜泥乳白细腻，闻着冲鼻"
    },
    {
      "n": 5,
      "text": "蒜泥里加生抽、香醋、白糖、盐、芝麻油和辣椒油调匀，尝一下咸酸。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先把料汁调好再拌茄子，味道才均匀。",
      "visual_cue": "料汁红亮，蒜粒悬浮其中"
    },
    {
      "n": 6,
      "text": "茄条装盘，浇上料汁拌匀，撒香菜末和小葱末即可上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "拌好静置五分钟更入味，出桌前再撒香菜。",
      "visual_cue": "茄条裹满红亮料汁，葱花香菜点缀"
    }
  ],
  "tips": [
    "茄子选细长的紫皮嫩茄，籽少肉厚，蒸后不苦。",
    "蒸茄子别盖保鲜膜，水汽散得出去才不水塌塌。",
    "蒜泥一定要现捣现用，隔夜的蒜泥会发苦。"
  ],
  "common_mistakes": [
    "茄子蒸过二十分钟，肉全化成泥，拌的时候抓不成条。",
    "蒜用刀拍碎了事，颗粒粗糙，辣味冲而香不足。",
    "料汁里不放白糖，酸咸撞在一起，吃着发尖。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "15毫升:15毫升",
      "note": "米醋更柔和，酸味不冲，适合口轻的人。"
    },
    {
      "original": "辣椒油",
      "substitute": "辣椒面",
      "ratio": "10毫升:3克",
      "note": "用辣椒面则先用热芝麻油泼香再拌。"
    }
  ],
  "variations": [
    "加一勺芝麻酱同调，口感更厚，接近胶东的麻酱茄泥。",
    "把茄子换成蒸熟的豆角，同样用蒜泥拌，夏天更清爽。"
  ],
  "serving_suggestion": "茄条堆成小山，浇汁后撒葱花，凉着吃最解腻，配馒头或稀饭都合适。",
  "storage": "冷藏可存一天，拌好后当天吃完；蒜泥久放会发苦，不建议留到第二天。",
