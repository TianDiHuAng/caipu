  "equipment": [
    "炒锅",
    "汤锅",
    "刀",
    "砧板",
    "拌菜盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "生花生米挑去瘪粒和杂质，用清水冲一遍后彻底晾干表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "花生带水下油锅会炸得满灶台都是油点。",
      "visual_cue": "花生米干爽，颗粒饱满匀净"
    },
    {
      "n": 2,
      "text": "冷锅下花生油和花生米，小火慢炸六分钟，听到噼啪声变密即捞出。",
      "time_min": 7,
      "heat": "小火",
      "tip": "冷油下锅慢慢升温，花生米里外才一起酥。",
      "visual_cue": "花生皮转红发亮，声音清脆"
    },
    {
      "n": 3,
      "text": "炸好的花生米摊在盘里晾凉，凉透后才会脆，趁热拌只会发软。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刚出锅的花生是软的，凉透才有脆劲。",
      "visual_cue": "花生米外壳干爽，摇盘有声"
    },
    {
      "n": 4,
      "text": "菠菜切成长段，汤锅水开加两滴油，下菠菜焯四十秒捞出过凉水攥干。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水里滴几滴油，菠菜焯完颜色才翠绿好看。",
      "visual_cue": "菠菜叶色深绿，攥后不出水"
    },
    {
      "n": 5,
      "text": "菠菜抖散放进拌菜盆，加蒜末、香醋、生抽、盐、白糖和芝麻油拌开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "菠菜一定攥干再拌，带水拌出来就是一盆汤。",
      "visual_cue": "菠菜松散不结团，料汁挂匀"
    },
    {
      "n": 6,
      "text": "最后倒入凉透的花生米，轻轻翻两下装盘，上桌前不要再搅动。",
      "time_min": 1,
      "heat": "无火",
      "tip": "花生米必须最后放，拌早了吸潮就软了。",
      "visual_cue": "花生米颗颗分明，浮在菠菜表面"
    }
  ],
  "tips": [
    "花生米炸好可密封冷藏，随吃随取，省得每次现炸。",
    "菠菜根别全切掉，红色的根甜，洗净一起焯更香。",
    "喜欢麻酱味可用十五克芝麻酱加温水调开代替部分芝麻油。"
  ],
  "common_mistakes": [
    "菠菜焯完不攥水，拌好五分钟盘底一层绿水。",
    "花生米热着就拌进去，上桌时已经软塌不脆。",
    "花生米用大火炸，外皮焦黑里面还是生的。"
  ],
  "substitutions": [
    {
      "original": "花生",
      "substitute": "核桃仁",
      "ratio": "80克:80克",
      "note": "核桃仁用一百五十度烤八分钟，掰小块使用。"
    },
    {
      "original": "菠菜",
      "substitute": "苋菜",
      "ratio": "350克:350克",
      "note": "苋菜焯水时间缩短到二十秒，易烂。"
    }
  ],
  "variations": [
    "加五十克泡软的粉丝同拌，饱腹感更强。",
    "加一勺辣椒油和少许花椒面，做成麻辣拌菠菜。"
  ],
  "serving_suggestion": "装盘后立即上桌，作为开胃凉菜或配酒小菜都合适，配稀饭也很下口。",
  "storage": "冷藏可存一天，花生米须单独密封存放，吃前再混合以保脆度。",
