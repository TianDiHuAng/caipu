    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子洗净去蒂，切成三厘米见方的滚刀块，撒少许盐抓匀静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐腌逼出水分，炸的时候吸油少一半。",
      "visual_cue": "茄块表面渗出水珠，手感变软"
    },
    {
      "n": 2,
      "text": "攥干茄块水分，撒玉米淀粉抓匀，让每块都裹上薄薄一层粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉层能挡住油，茄子就不会变成油包。",
      "visual_cue": "茄块表面干爽，粉层薄而均匀"
    },
    {
      "n": 3,
      "text": "花生油烧到七成热，下茄块中火炸两分钟至金黄，捞出沥油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温要高，茄子下锅立刻封住表面才不吸油。",
      "visual_cue": "茄块金黄鼓起，外壳发硬"
    },
    {
      "n": 4,
      "text": "原锅留少许底油，下大蒜碎和小葱段爆香，添生抽、白糖、盐和高汤烧开。",
      "time_min": 2,
      "heat": "中火",
      "tip": "汤汁烧开后再下茄子，味道才挂得均匀。",
      "visual_cue": "汤汁酱红油亮，蒜香四溢"
    },
    {
      "n": 5,
      "text": "倒入炸好的茄块和青椒块，中火烧三分钟，中途轻推两次让茄块吸汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "用勺背推着翻，别用勺沿铲，茄子容易碎。",
      "visual_cue": "茄块吸汁饱满，青椒转翠绿"
    },
    {
      "n": 6,
      "text": "玉米淀粉加水调匀勾薄芡，沿锅边淋香醋，翻匀出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋沿着热锅边淋下去，酸香才冲得出来。",
      "visual_cue": "芡汁透亮挂茄，盘底不见汤水"
    }
  ],
  "tips": [
    "长茄子比圆茄子水分少，烧出来更香不水塌。",
    "茄子腌过再炸，既省油，炸完也不易回软。",
    "喜欢蒜味可留一半蒜碎在出锅前撒入，生蒜香更冲。"
  ],
  "common_mistakes": [
    "茄子不腌不拍粉，直接下锅，炸完满盘是油。",
    "油温只有五成，茄子慢慢吸油，一斤茄子吃进半斤油。",
    "勾芡后大火久煮，芡汁澥开，茄子泡在汤里。"
  ],
  "substitutions": [
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "100毫升:100毫升",
      "note": "清水版本加一勺蚝油补鲜。"
    },
    {
      "original": "青椒",
      "substitute": "尖椒",
      "ratio": "50克:50克",
      "note": "尖椒更辣，用量减到三十克。"
    }
  ],
  "variations": [
    "加五十克切薄的猪肉片同烧，荤香更足。",
    "起锅前撒一把蒜末，做成蒜香烧茄子，拌饭特别香。"
  ],
  "serving_suggestion": "装盘后浇上锅底芡汁，热吃最香，配米饭能连吃两碗。",
  "storage": "冷藏可存一天，复热时加两勺高汤小火回烧；不建议冷冻，茄子解冻后成糊状。",
