  "equipment": [
    "炒锅",
    "砂锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿斩成 4cm 见方的块，冷水浸泡 10 分钟去血水后沥干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡过血水的鸡块，炖出来汤才清。",
      "visual_cue": "鸡块发白、表面不见血丝"
    },
    {
      "n": 2,
      "text": "炒锅倒 35ml 植物油，下冰糖小火炒 2 分钟至融化冒小泡、呈焦糖色。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖色炒到枣红就停，过了会苦。",
      "visual_cue": "糖液深琥珀色、气泡细密"
    },
    {
      "n": 3,
      "text": "倒入鸡块大火翻炒 3 分钟，让每块均匀裹上糖色。",
      "time_min": 4,
      "heat": "大火",
      "tip": "鸡块要沥干再下锅，否则糖色溅油。",
      "visual_cue": "鸡块表面焦红、锅底泛亮"
    },
    {
      "n": 4,
      "text": "下姜片、蒜与干辣椒炒香，加生抽、老抽、蚝油与料酒炒匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "酱料先炒香再加水，味道才厚。",
      "visual_cue": "鸡块酱色均匀、香味浓郁"
    },
    {
      "n": 5,
      "text": "加 600ml 开水与香菇片，大火烧开转小火焖 20 分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "一定加开水，冷水会让鸡肉收紧发柴。",
      "visual_cue": "汤汁收至一半、鸡肉脱骨"
    },
    {
      "n": 6,
      "text": "放青椒块与 3g 盐，转大火收汁 3 分钟至汤汁浓稠裹鸡块即可。",
      "time_min": 4,
      "heat": "大火",
      "tip": "青椒后放，保持脆绿不出水。",
      "visual_cue": "汤汁浓稠挂勺、青椒翠绿"
    }
  ],
  "tips": [
    "炒糖色是黄焖鸡上色的关键，别炒糊。",
    "加开水而不是冷水，鸡肉才嫩。，会影响最终的口感层次与卖相。",
    "香菇用干香菇泡发，香味比鲜香菇浓。"
  ],
  "common_mistakes": [
    "糖色炒过头，整锅发苦发黑。，成品口感会明显变差。",
    "中途加冷水，鸡块紧缩变硬。，成品口感会明显变差。",
    "收汁不彻底，端上桌汤汁稀如水。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡翅根",
      "ratio": "700g 对 700g",
      "note": "更易入味，焖的时间加 5 分钟。"
    },
    {
      "original": "香菇",
      "substitute": "杏鲍菇",
      "ratio": "150g 对 180g",
      "note": "口感更脆，香气稍淡。"
    }
  ],
  "variations": [
    "土豆版：加 200g 土豆块同焖，汤汁更绵。",
    "加辣版：干辣椒加到 15g，做成香辣口味。"
  ],
  "serving_suggestion": "连汁浇在米饭上，就是经典的黄焖鸡米饭。",
  "storage": "冷藏 2 天，冷冻 1 周；复热加少量水小火焖热。",
