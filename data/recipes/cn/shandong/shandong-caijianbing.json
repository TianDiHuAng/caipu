  "equipment": [
    "鏊子",
    "刮板",
    "炒锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉与玉米面混匀，分次加清水搅成能流动的稀面糊，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面糊调到能挂住刮板又缓缓流下，太稠摊不开，太稀不成形。",
      "visual_cue": "面糊顺滑无颗粒，挑起能成线流下。"
    },
    {
      "n": 2,
      "text": "鏊子烧热刷薄薄一层植物油，舀一勺面糊用刮板迅速刮平成薄饼。",
      "time_min": 4,
      "heat": "中火",
      "tip": "刮的时候手要快，饼越薄越好，厚了卷起来发硬。",
      "visual_cue": "薄饼贴鏊透亮，边缘微翘。"
    },
    {
      "n": 3,
      "text": "薄饼上打入鸡蛋抹匀，翻面烙到两面微黄起脆边后取出备用。",
      "time_min": 3,
      "heat": "中火",
      "tip": "鸡蛋液要抹匀封住整张饼面，卷馅的时候才不容易破皮漏菜。",
      "visual_cue": "蛋液均匀铺满，饼面金黄有脆边。"
    },
    {
      "n": 4,
      "text": "另起炒锅放植物油，把豆腐皮丝、白菜丝、胡萝卜丝炒软，加粉丝和生抽调味。",
      "time_min": 6,
      "heat": "大火",
      "tip": "蔬菜要大火快炒，出水太多会把饼皮泡软。",
      "visual_cue": "菜丝断生色泽鲜亮，锅底几乎无汤。"
    },
    {
      "n": 5,
      "text": "关火拌入韭菜段和盐，趁热把菜馅铺在煎饼上卷紧，两头折起再回鏊子烙脆。",
      "time_min": 5,
      "heat": "中火",
      "tip": "韭菜最后拌才够香，回烙十几秒让饼皮重新变脆。",
      "visual_cue": "菜卷紧实不散，外皮金黄酥脆。"
    }
  ],
  "tips": [
    "面糊里掺玉米面，煎饼才有枣庄的粗粮香。",
    "菜馅要炒到不见汤水，否则饼皮很快回软。",
    "韭菜一定要最后下锅，靠余温断生才最鲜，久炒就发黄出水。"
  ],
  "common_mistakes": [
    "面糊调得太稠，摊出来的饼又厚又硬，卷起来还会断裂。",
    "菜馅炒完没控干水就卷，放一会儿饼皮就被泡得软烂。",
    "韭菜跟着一起久炒，颜色发黄出水，鲜味全跑光了。"
  ],
  "substitutions": [
    {
      "original": "豆腐皮",
      "substitute": "鸡蛋",
      "ratio": "150克:3个",
      "note": "鸡蛋摊成蛋皮切丝，蛋白质更高。"
    },
    {
      "original": "韭菜",
      "substitute": "小葱",
      "ratio": "100克:100克",
      "note": "不吃韭菜可换小葱，辛香柔和些。"
    }
  ],
  "variations": [
    "喜欢辣的可以在馅里加一勺辣椒油，风味更足。",
    "把豆腐皮换成摊好的鸡蛋皮切丝，口感更嫩也更滑。"
  ],
  "serving_suggestion": "菜煎饼卷好切段趁热吃，配一碗玉米面粥解腻。",
  "storage": "现卷现吃最佳，剩馅可冷藏一天；饼皮凉后回鏊子小火复烙两分钟。",
