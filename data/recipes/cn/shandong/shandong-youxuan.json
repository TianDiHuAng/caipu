  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 330,
          "unit": "g",
          "note": "普通中筋面粉，其中三十克留作油酥",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 4,
          "unit": "g",
          "note": "用温水化开",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 175,
          "unit": "ml",
          "note": "三十度左右温水",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "面团与油酥各半",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 35,
          "unit": "g",
          "note": "只取葱绿切细葱花",
          "optional": false
        },
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 45,
          "unit": "ml",
          "note": "调油酥与刷面用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "案板",
    "擀面杖",
    "平底锅",
    "烤箱",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加酵母、盐和温水揉成光滑面团，盖湿布在温暖处醒发到一倍半大。",
      "time_min": 15,
      "heat": "无火",
      "tip": "面团要揉到表面光滑，按下去能缓慢回弹才好擀。",
      "visual_cue": "面团光滑圆整，按压回弹缓慢。"
    },
    {
      "n": 2,
      "text": "醒好的面团留在盆中静置到体积明显膨胀，手指戳洞不回缩即可使用。",
      "time_min": 60,
      "heat": "无火",
      "tip": "醒发不足饼身发硬，醒过头会带酸味，看状态比看时间准。",
      "visual_cue": "面团膨松，戳洞边缘不塌。"
    },
    {
      "n": 3,
      "text": "取三十克面粉加盐，浇上烧热的花生油拌成稀油酥，另留少量花生油刷面。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油要烧到微微冒烟再浇，油酥才香而不生。",
      "visual_cue": "油酥顺滑能流动，闻着有熟油香。"
    },
    {
      "n": 4,
      "text": "面团擀成大薄片，抹匀油酥撒上葱花，从一边卷成长条再盘成螺旋状。",
      "time_min": 8,
      "heat": "无火",
      "tip": "卷的时候边卷边轻轻拉伸，层数越多成品越酥。",
      "visual_cue": "面卷层次分明，盘好呈蜗牛状。"
    },
    {
      "n": 5,
      "text": "把盘好的面卷按扁擀成厚约一厘米的圆饼，表面刷一层花生油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "擀的时候从中间向四周推，别把层次压死。",
      "visual_cue": "饼坯圆整厚薄均匀，层次隐约可见。"
    },
    {
      "n": 6,
      "text": "平底锅小火把饼两面烙到微黄定型，移入两百度烤箱烤到表面金黄鼓起。",
      "time_min": 14,
      "heat": "小火",
      "tip": "先烙后烤能让外层酥脆内里熟透，全程别用大火。",
      "visual_cue": "表面金黄起层，手指按压有脆响。"
    }
  ],
  "tips": [
    "油酥要现浇刚烧热的花生油，用凉油拌出来发死还带生味。",
    "卷面时要边卷边轻轻抻长面皮，层次才会又薄又多。",
    "先在平底锅烙定型再入烤箱，外层酥脆内里柔软才是济南味。"
  ],
  "common_mistakes": [
    "浇油酥的油温不够热，成品吃着有股生油味，香气也起不来。",
    "擀饼时用力过猛，辛苦卷出的层次被压死，烤完完全不起酥。",
    "全程用大火烙，外皮焦黑发苦，掰开里面还是生面糊。"
  ],
  "substitutions": [
    {
      "original": "花生油",
      "substitute": "植物油",
      "ratio": "45毫升:45毫升",
      "note": "气味清淡，不喜花生香可用植物油替代。"
    },
    {
      "original": "小葱",
      "substitute": "大葱",
      "ratio": "35克:40克",
      "note": "大葱葱白切碎也可，辛香更冲。"
    }
  ],
  "variations": [
    "有的做法在葱油里加少许五香粉，香气更复合。",
    "家庭版可省去烤箱，用厚底锅加盖小火烙熟。"
  ],
  "serving_suggestion": "油旋趁热上桌，配一碗甜沫或豆腐脑就是老济南早点。",
  "storage": "凉后外皮会回软，可入烤箱一百六十度复烤五分钟；冷藏两天内吃完。",
