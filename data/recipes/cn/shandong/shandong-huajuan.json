  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 5,
          "unit": "g",
          "note": "温水化开",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 215,
          "unit": "ml",
          "note": "三十度左右",
          "optional": false
        },
        {
          "name": "小苏打",
          "name_en": "baking soda",
          "amount": 2,
          "unit": "g",
          "note": "中和酸味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "撒面片用",
          "optional": false
        },
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 40,
          "unit": "ml",
          "note": "刷面片",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 45,
          "unit": "g",
          "note": "只取葱绿切细",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "案板",
    "擀面杖",
    "蒸笼布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加酵母和清水揉成光滑面团，盖湿布放到温暖处发酵。",
      "time_min": 15,
      "heat": "无火",
      "tip": "面团要揉到光滑不粘手，表面光滑蒸出来才白净。",
      "visual_cue": "面团圆整光滑，盆壁干净不粘面。"
    },
    {
      "n": 2,
      "text": "等待面团发酵到两倍大，手指戳洞不回缩、内部呈蜂窝状即可。",
      "time_min": 60,
      "heat": "无火",
      "tip": "发酵看状态不看时间，室温低就多等一会儿。",
      "visual_cue": "体积翻倍，戳洞边缘不塌，内部蜂窝细密。"
    },
    {
      "n": 3,
      "text": "发好的面团加小苏打揉匀排气，擀成半厘米厚的大长方片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "小苏打要揉匀，否则蒸出来会有黄斑和碱味。",
      "visual_cue": "面片厚薄均匀，表面细腻无大气泡。"
    },
    {
      "n": 4,
      "text": "面片刷一层花生油，撒盐和小葱绿，从长边卷起成条再切成小段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "花生油要刷匀但别刷太多，盐也要撒匀，卷起来才不齁咸。",
      "visual_cue": "面卷紧实，葱绿分布均匀。"
    },
    {
      "n": 5,
      "text": "两段面卷叠起用筷子在中间压出一道深痕，捏住两头略拉长后拧成花卷坯。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压痕要压到底，拧的时候轻拉，层次才漂亮不散。",
      "visual_cue": "花卷层次翻卷，形状饱满对称。"
    },
    {
      "n": 6,
      "text": "花卷坯入蒸笼二次醒发到明显变大，水开后大火蒸十二分钟关火焖三分钟。",
      "time_min": 15,
      "heat": "大火",
      "tip": "关火后必须焖足三分钟再开盖，骤冷会让白胖的花卷回缩塌陷。",
      "visual_cue": "花卷白胖蓬松，按下去能缓慢回弹。"
    }
  ],
  "tips": [
    "面团揉到光滑是花卷白净的前提，偷懒省力就会粗糙。",
    "葱绿先用一点点油拌过再撒，蒸出来的颜色更翠绿。",
    "蒸好关火焖三分钟再开盖，花卷才不会遇冷回缩塌下去。"
  ],
  "common_mistakes": [
    "面团发酵不足就上锅，蒸出来的花卷硬实一点也不蓬松。",
    "小苏打没揉匀，成品夹生黄斑还带碱味。",
    "关火立刻开盖，花卷遇冷迅速回缩塌下去。"
  ],
  "substitutions": [
    {
      "original": "花生油",
      "substitute": "猪油",
      "ratio": "40毫升:40克",
      "note": "刷猪油更香，葱味更突出，注意趁热刷开。"
    },
    {
      "original": "小葱",
      "substitute": "大葱",
      "ratio": "45克:55克",
      "note": "大葱葱白切细也可，辛香更冲一些。"
    }
  ],
  "variations": [
    "有人在葱油里拌一点花椒粉，辛香里带一丝麻。",
    "把葱绿换成韭菜碎，就是韭菜花卷，味道更冲。"
  ],
  "serving_suggestion": "葱油花卷趁热掰开配粥，也可以夹酱牛肉当早饭。",
  "storage": "凉透后装袋冷冻一周，吃前上锅蒸八分钟即恢复松软。",
