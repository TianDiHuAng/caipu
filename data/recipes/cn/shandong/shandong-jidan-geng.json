  "equipment": [
    "蒸锅",
    "打蛋盆",
    "细筛",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进打蛋盆，用筷子沿一个方向轻搅到蛋液顺滑，尽量不要打出气泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻轻搅散就行，打得起泡蒸出来满是蜂窝。",
      "visual_cue": "蛋液均匀无白筋，表面泡沫少"
    },
    {
      "n": 2,
      "text": "加入温热的鸡汤和盐搅匀，蛋液与鸡汤的比例掌握在一比一点五左右。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汤要温的，凉的难融合，烫的直接把蛋冲熟。",
      "visual_cue": "蛋液浅黄稀滑，盐已化开"
    },
    {
      "n": 3,
      "text": "蛋液用细筛过滤两遍进蒸碗，撇掉表面浮沫，盖上盘子或耐高温膜。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛两遍是蛋羹滑不滑的关键，别省这一步。",
      "visual_cue": "蛋液细腻无渣，表面平整"
    },
    {
      "n": 4,
      "text": "蒸锅水开后放入蒸碗，中火蒸十二分钟，关火再焖两分钟。",
      "time_min": 14,
      "heat": "中火",
      "tip": "水开再放入，火别太大，大火必出蜂窝。",
      "visual_cue": "蛋羹表面光滑如镜，轻晃微颤"
    },
    {
      "n": 5,
      "text": "取出揭盖，淋上生抽和芝麻油，撒小葱末即可上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "揭开盖时让水汽顺着边流走，别滴在蛋面上。",
      "visual_cue": "蛋面光洁无孔，汤汁清亮"
    }
  ],
  "tips": [
    "用温鸡汤代替清水，蛋羹的鲜味完全不是一个档次。",
    "蒸锅盖子下垫一块布，能挡水汽滴落，蛋面更平。",
    "碗口盖盘子蒸出的蛋羹最嫩，薄膜容易贴面留坑。"
  ],
  "common_mistakes": [
    "大火猛蒸，蛋面鼓成蜂窝，口感粗硬。",
    "蛋液没有过筛就上锅，蒸好碗底沉了一层白絮。",
    "冷水上锅慢慢加热，受热不均导致上下分层。"
  ],
  "substitutions": [
    {
      "original": "鸡汤",
      "substitute": "牛奶",
      "ratio": "300毫升:300毫升",
      "note": "做成奶香蛋羹，盐减到两克，适合孩子。"
    },
    {
      "original": "鸡汤",
      "substitute": "清水",
      "ratio": "300毫升:300毫升",
      "note": "清水版本需补半勺蚝油提鲜。"
    }
  ],
  "variations": [
    "蛋液里放三只洗净的虾仁同蒸，成虾仁蛋羹。",
    "蒸到第八分钟撒一把切碎的香菇丁，多一层菌香。"
  ],
  "serving_suggestion": "趁热用小勺挖着吃，配一碗白粥或一片馒头，是山东人家最常吃的早饭。",
  "storage": "现蒸现吃最好，冷藏不超过一天，复热需再蒸五分钟；反复加热会出水发老。",
