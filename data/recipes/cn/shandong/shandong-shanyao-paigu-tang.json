  "steps": [
    {
      "n": 1,
      "text": "排骨用清水泡三十分钟，中途换两次水泡出血水。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡过水的排骨，汤才清不腥。",
      "visual_cue": "水色由深红转为淡粉"
    },
    {
      "n": 2,
      "text": "排骨冷水下锅，加料酒与两片姜，煮开撇净浮沫后捞出冲净。",
      "time_min": 12,
      "heat": "大火",
      "tip": "浮沫撇干净，汤才透亮。",
      "visual_cue": "水面浮起灰褐色泡沫。"
    },
    {
      "n": 3,
      "text": "山药戴手套去皮，切成五厘米长的段，泡在清水里防氧化。",
      "time_min": 10,
      "heat": "无火",
      "tip": "山药的黏液沾手会痒，务必戴手套。",
      "visual_cue": "山药段洁白，泡水不发黑。"
    },
    {
      "n": 4,
      "text": "汤锅加清水，放排骨与姜片、葱结，大火煮开转小火炖五十分钟。",
      "time_min": 55,
      "heat": "小火",
      "tip": "小火慢炖，排骨才脱骨不柴。",
      "visual_cue": "汤面微微冒泡，香气散出。"
    },
    {
      "n": 5,
      "text": "捞出葱结，下山药段继续炖二十分钟至山药软糯。",
      "time_min": 22,
      "heat": "小火",
      "tip": "山药后放，久炖会化在汤里。",
      "visual_cue": "山药用筷子能轻松扎透。"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，撒枸杞与小葱花，焖两分钟出锅。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盐最后放，排骨才不会柴。",
      "visual_cue": "汤色清亮，山药完整。"
    }
  ],
  "tips": [
    "排骨选肋排，肉厚骨头小，炖出来不柴。",
    "山药挑铁棍山药，口感粉糯，久炖不散。",
    "汤炖好后撇去浮油，喝起来更清爽。"
  ],
  "common_mistakes": [
    "排骨不焯水直接炖，汤浑且带腥。",
    "山药下锅太早，炖到最后全化在汤里。"
  ],
  "substitutions": [
    {
      "original": "猪排骨",
      "substitute": "猪筒骨",
      "ratio": "800g 对 900g",
      "note": "筒骨炖的时间延长二十分钟，汤更浓。"
    }
  ],
  "variations": [
    "加几段玉米同炖，汤带自然甜味，孩子更爱喝。"
  ],
  "serving_suggestion": "配米饭或馒头都行，汤单独喝也很清甜。",
  "storage": "冷藏三天，撇去表面油脂后复热，山药会略化。",
