  "steps": [
    {
      "n": 1,
      "text": "面条煮到八成熟捞出，过凉水后拌入少许植物油抖散摊开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "煮八成熟就够，炒的时候还会继续受热，全熟下锅必烂。",
      "visual_cue": "面条根根分明，掐断中间有细白芯。"
    },
    {
      "n": 2,
      "text": "五花肉切成细丝，大白菜、青椒、胡萝卜分别切成与肉丝粗细相近的丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "所有丝都切得一样粗，才能在同样时间一起熟。",
      "visual_cue": "四样丝粗细均匀，码放整齐。"
    },
    {
      "n": 3,
      "text": "炒锅烧热放植物油，下葱丝姜末炒香，放肉丝大火煸到变色。",
      "time_min": 5,
      "heat": "大火",
      "tip": "锅要先烧到冒烟再下油，热锅凉油炒肉丝才不粘。",
      "visual_cue": "肉丝散开变色，葱香明显。"
    },
    {
      "n": 4,
      "text": "下胡萝卜丝和白菜丝大火翻炒两分钟，再放青椒丝炒匀。",
      "time_min": 4,
      "heat": "大火",
      "tip": "白菜丝会大量出水，先炒它再放青椒，青椒才不会炖黄。",
      "visual_cue": "菜丝软而仍有脆感，锅里有汤汁。"
    },
    {
      "n": 5,
      "text": "倒入面条，沿锅边淋生抽，用筷子抖散翻炒，让每根面都上色。",
      "time_min": 4,
      "heat": "中火",
      "tip": "炒面用筷子比锅铲好用，能把面条抖开而不是压断。",
      "visual_cue": "面条均匀上色，没有白色面芯。"
    },
    {
      "n": 6,
      "text": "视干湿情况沿锅边洒少量清水，加盐炒匀后出锅装盘。",
      "time_min": 3,
      "heat": "中火",
      "tip": "沿锅边洒水而不是直接浇在面上，蒸汽能把面回软又不糊。",
      "visual_cue": "面条干爽有光泽，盘底不出水。"
    }
  ],
  "tips": [
    "面条煮八成熟、过水拌油，是炒面不粘不烂的前提。",
    "炒面用筷子抖散，比锅铲更适合处理长面条。",
    "沿锅边洒少量清水，用蒸汽把面回软，比直接浇在面上更好。"
  ],
  "common_mistakes": [
    "面条煮到全熟再炒，一炒就断，出锅成了面糊。",
    "锅没烧热就下油，肉丝和面条全粘在锅底。",
    "水一次浇在面条上，面外侧糊化、里面还是干的。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "牛肉",
      "ratio": "150克:150克",
      "note": "换成牛里脊丝，先滑油再炒，口感更嫩。"
    },
    {
      "original": "青椒",
      "substitute": "芹菜",
      "ratio": "80克:100克",
      "note": "芹菜丝更清脆，但需提前焯一下断生。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同炒，就是山东人家常的杂拌面。",
    "喜欢重口的可以加一勺辣椒油，出锅前淋一圈更香。"
  ],
  "serving_suggestion": "肉丝炒面干香入味，配一碗紫菜蛋花汤或小米粥，就是踏实的一顿家常饭。",
  "storage": "冷藏可存一天，复热时用平底锅小火干烙两分钟，比微波炉更能恢复口感。",
