        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "菜刀",
    "擦丝器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成两毫米粗的细丝，放进清水里反复淘洗到水变清亮。",
      "time_min": 10,
      "heat": "无火",
      "tip": "表面黏液一定要洗掉，炒出来才不粘。",
      "visual_cue": "水清澈、土豆丝根根分明"
    },
    {
      "n": 2,
      "text": "淘好的土豆丝再泡五分钟，捞出沥干水分备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡过水更脆，沥干才不溅油。",
      "visual_cue": "土豆丝挺括、无积水"
    },
    {
      "n": 3,
      "text": "青椒去籽切丝，大蒜切片，干辣椒剪成小段，料头分别放好。",
      "time_min": 4,
      "heat": "无火",
      "tip": "干辣椒剪断后籽要抖掉，免得发苦。",
      "visual_cue": "料头齐备、辣椒段均匀"
    },
    {
      "n": 4,
      "text": "炒锅下植物油，冷油放花椒与干辣椒，小火煸出香味后捞出花椒。",
      "time_min": 3,
      "heat": "小火",
      "tip": "冷油下香料，香味才慢慢出来不焦。",
      "visual_cue": "油面浮香、辣椒微红"
    },
    {
      "n": 5,
      "text": "转大火下土豆丝快速翻炒一分钟，沿锅边淋一半米醋，让酸香激起来。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火快炒是脆的关键，别炒太久。",
      "visual_cue": "土豆丝透亮、边缘微透明"
    },
    {
      "n": 6,
      "text": "下青椒丝、蒜片、盐、生抽与白糖兜匀，再淋剩下的米醋，翻炒一分钟断生出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "第二遍醋出锅前放，酸味留得住。",
      "visual_cue": "土豆丝脆爽、盘底无汤水"
    }
  ],
  "tips": [
    "切丝比擦丝口感好，擦丝易断且出水多。",
    "醋分两次放，前一次去生味、后一次保酸香。",
    "炒前把锅烧到冒青烟再下油，土豆丝不粘锅。"
  ],
  "common_mistakes": [
    "土豆丝不淘洗干净，下锅就糊成一团。",
    "全程小火慢炒，土豆丝炒成软烂的条。",
    "醋一次性全倒进锅，酸味挥发只剩涩。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "莲藕",
      "ratio": "400g 对 400g",
      "note": "藕丝更脆，炒制时间减半。"
    },
    {
      "original": "米醋",
      "substitute": "陈醋",
      "ratio": "20ml 对 15ml",
      "note": "陈醋颜色深，用量要少。"
    }
  ],
  "variations": [
    "加几粒花椒油泼在出锅的土豆丝上，麻香更突出。",
    "配一把泡椒同炒，做成酸辣爽口的川式风味。"
  ],
  "serving_suggestion": "热吃当菜，凉了当小菜，配馒头米饭都下饭。",
  "storage": "现炒现吃，隔夜会出水变软，不建议久存。",
