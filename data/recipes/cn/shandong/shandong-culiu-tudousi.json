          "amount": 3,
          "unit": "g",
          "note": "中和酸味",
          "optional": false
        },
        {
          "name": "花椒",
          "name_en": "Sichuan peppercorn",
          "amount": 1,
          "unit": "g",
          "note": "煸香用",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
