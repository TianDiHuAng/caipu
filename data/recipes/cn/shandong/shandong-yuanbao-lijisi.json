  "steps": [
    {
      "n": 1,
      "text": "猪里脊顺着纹理切成细丝，加料酒、盐和玉米淀粉抓匀，腌十分钟上浆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "上浆要抓到每根肉丝都发黏，滑炒时才不粘连。",
      "visual_cue": "肉丝表面挂薄浆，手感发黏"
    },
    {
      "n": 2,
      "text": "香菜去根洗净切成三厘米长的香菜段，大葱切成细丝，大蒜切片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香菜梗和叶分开放，梗先下锅、叶最后撒。",
      "visual_cue": "香菜段整齐，葱丝细匀"
    },
    {
      "n": 3,
      "text": "花生油烧到六成热，下腌好的里脊丝快速滑散，肉丝变白立即盛出。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "肉丝下锅别急着翻，等底面定型再用铲子推散。",
      "visual_cue": "肉丝根根分明，通体发白"
    },
    {
      "n": 4,
      "text": "原锅倒去多余的油，留少许花生油，下大葱丝、蒜片和白胡椒炒香，倒回里脊丝大火翻炒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "葱丝炒到刚软就下肉，炒黄了会带焦苦味。",
      "visual_cue": "葱丝微软发甜，锅气直冲鼻子"
    },
    {
      "n": 5,
      "text": "淋入生抽和香醋，撒香菜段，颠锅翻两下立刻出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "香菜段下锅只翻两下，久炒会出一股烂菜味。",
      "visual_cue": "香菜叶刚塌，颜色翠绿"
    }
  ],
  "tips": [
    "里脊丝切三毫米粗最合适，太细滑炒时容易断。",
    "香醋只需几滴，作用是提香不是提酸，多了就抢香菜味。",
    "全程大火短炒，从下肉到出锅不超过两分钟。"
  ],
  "common_mistakes": [
    "肉丝没上浆就下锅，滑炒时粘成一团，铲都铲不开。",
    "香菜和肉一起久炒，端上桌已经发黄发软失去香气。",
    "火候小、锅温不够，肉丝出水，成品变成一锅肉汤。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "牛里脊",
      "ratio": "350克:350克",
      "note": "换牛肉就是芫爆牛肉丝，腌时加一勺清水更嫩。"
    },
    {
      "original": "香菜",
      "substitute": "小葱",
      "ratio": "100克:80克",
      "note": "不吃香菜可换小葱段，风味偏葱香而非芫香。"
    }
  ],
  "variations": [
    "加一把掐去头尾的绿豆芽同炒，脆爽更足。",
    "老派鲁菜会在出锅前淋几滴花椒油，麻香更明显。"
  ],
  "serving_suggestion": "装盘后立刻上桌，配一碗白米饭，热气带出香菜和葱的香味是最佳状态。",
  "storage": "不建议久存，冷藏一天内吃完；复热用大火快炒三十秒，别加水。",
