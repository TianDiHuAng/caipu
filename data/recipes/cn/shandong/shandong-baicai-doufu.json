  "equipment": [
    "炒锅",
    "砂锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成麻将块，放入加了少许盐的清水里浸五分钟去豆腥，捞出沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "盐水浸过的豆腐更紧实，久炖也不容易散成碎渣。",
      "visual_cue": "豆腐块完整挺括，表面干爽。"
    },
    {
      "n": 2,
      "text": "炒锅放猪油化开，下五花肉片小火煸到微卷出油，再放姜片和葱段炒香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "肉片煸到边缘卷起再下葱姜，油香才出得来。",
      "visual_cue": "肉片卷边微焦，锅里满是油香。"
    },
    {
      "n": 3,
      "text": "先下白菜帮大火翻炒到变软出水，再放白菜叶一起炒到整体塌秧。",
      "time_min": 6,
      "heat": "大火",
      "tip": "白菜帮先炒后放叶，帮子软了叶子才不至于烂成泥。",
      "visual_cue": "白菜整体塌软，锅底有明显汤汁。"
    },
    {
      "n": 4,
      "text": "加入豆腐块和清水，大火烧开后转小火，加盖慢炖十五分钟。",
      "time_min": 17,
      "heat": "小火",
      "tip": "豆腐下锅后用锅铲背轻推，别翻搅，免得碎成渣。",
      "visual_cue": "汤汁微白，豆腐吸饱汤汁微微鼓起。"
    },
    {
      "n": 5,
      "text": "放泡软的粉丝和生抽、盐调味，再炖五分钟到粉丝透亮即可出锅。",
      "time_min": 6,
      "heat": "小火",
      "tip": "粉丝最后放，久炖会糊汤，汤色发浑不好看。",
      "visual_cue": "粉丝透明柔韧，汤汁咸鲜不浑。"
    }
  ],
  "tips": [
    "白菜帮和叶分次下锅，是这道菜口感一致的关键。",
    "用猪油起锅，汤头才够香，冬天吃最舒坦。",
    "豆腐下锅后只推不翻，才能保持块形完整。"
  ],
  "common_mistakes": [
    "白菜一次性全倒进锅，帮子还硬叶子已经炖烂成泥。",
    "豆腐下锅后反复翻动，出锅全是碎块，卖相难看。",
    "粉丝提前下锅久炖，汤糊成一锅浆，失去清鲜味。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "25克:25毫升",
      "note": "植物油清爽些，但香气不及猪油厚重。"
    },
    {
      "original": "五花肉",
      "substitute": "海米",
      "ratio": "80克:20克",
      "note": "用泡发的海米提鲜，汤汁更有海味。"
    }
  ],
  "variations": [
    "胶东人家会加一把虾皮同炖，汤头更鲜，盐也要相应减量。",
    "把鲜豆腐换成冻豆腐，孔隙多、吸汤更足，是冬天的经典吃法。"
  ],
  "serving_suggestion": "白菜炖豆腐连汤带菜盛进砂锅，配戗面馒头或米饭，冬天最暖身。",
  "storage": "冷藏两天，隔夜更入味，复热时加少量清水防止汤干。",
