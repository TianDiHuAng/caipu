  "steps": [
    {
      "n": 1,
      "text": "蛏子放淡盐水里养两小时吐净泥沙，中途换两次水。",
      "time_min": 120,
      "heat": "无火",
      "tip": "水里滴几滴香油，吐沙更快。",
      "visual_cue": "盆底沉淀出细沙。"
    },
    {
      "n": 2,
      "text": "蛏子外壳用刷子逐一刷净，再放清水里冲两遍。",
      "time_min": 8,
      "heat": "无火",
      "tip": "壳缝里的泥沙要刷到，不然汤会碜牙。",
      "visual_cue": "蛏壳表面干净发亮。"
    },
    {
      "n": 3,
      "text": "北豆腐切三厘米方块，放淡盐水里泡五分钟去豆腥。",
      "time_min": 6,
      "heat": "无火",
      "tip": "盐水泡过的豆腐煮汤不易碎。",
      "visual_cue": "豆腐块边缘整齐不碎。"
    },
    {
      "n": 4,
      "text": "锅里加清水，放姜丝与料酒煮开，下豆腐块煮五分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "豆腐先煮定型，后面下蛏子才不碎。",
      "visual_cue": "豆腐浮起，汤面微滚。"
    },
    {
      "n": 5,
      "text": "倒入蛏子，盖上锅盖用大火煮三分钟至壳全部张开。",
      "time_min": 5,
      "heat": "大火",
      "tip": "壳不开的蛏子是死的，挑出来不要。",
      "visual_cue": "蛏壳大开，蛏肉饱满。"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，撒葱段与香菜，淋香油出锅。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛏子本身带咸，盐要少放。",
      "visual_cue": "汤色乳白，葱香扑鼻。"
    }
  ],
  "tips": [
    "蛏子买回来必须吐沙，这一步决定汤会不会碜牙。",
    "豆腐要选北豆腐，久煮不散，口感也更扎实。",
    "汤煮好后立即喝，蛏肉久泡会缩。"
  ],
  "common_mistakes": [
    "蛏子没吐沙就下锅，汤里全是细沙。",
    "蛏子煮太久，肉缩成一小团，鲜味也跑了。"
  ],
  "substitutions": [
    {
      "original": "蛏子",
      "substitute": "蛤蜊",
      "ratio": "800g 对 800g",
      "note": "蛤蜊吐沙时间可缩短到一小时。"
    }
  ],
  "variations": [
    "胶东沿海会加一把小白菜同煮，汤更清甜，颜色也好看。"
  ],
  "serving_suggestion": "连锅上桌，配馒头或米饭，汤泡饭很鲜。",
  "storage": "现做现吃，冷藏不超过一天，复热须煮开。",
