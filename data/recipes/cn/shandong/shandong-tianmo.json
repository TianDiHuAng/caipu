  "equipment": [
    "汤锅",
    "汤勺",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花生挑去瘪粒，用清水泡两小时，泡到颗粒饱满发胀，捞出沥干备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡透的花生煮出来才软糯，不泡直接下锅会是硬芯。",
      "visual_cue": "花生皮发皱，捏一下能陷进去"
    },
    {
      "n": 2,
      "text": "小米面倒进大碗，先加三百毫升清水慢慢搅开，搅到没有干粉疙瘩的稀面糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水要一点点加，一次倒多了面糊结块，越搅越难散。",
      "visual_cue": "面糊顺滑能流动，碗底无颗粒"
    },
    {
      "n": 3,
      "text": "粉丝用温水泡软，剪成五厘米长的小段；豆腐皮切细丝；菠菜放进沸水里烫半分钟捞出切段。",
      "time_min": 8,
      "heat": "大火",
      "tip": "粉丝别泡过头，软到能弯而不断就够，久煮会烂成糊。",
      "visual_cue": "粉丝透亮柔软，菠菜颜色翠绿"
    },
    {
      "n": 4,
      "text": "汤锅倒一千毫升清水烧开，下花生和姜末，转中火煮十分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "花生先煮出味，粥底才有底香，姜末这时下能压住豆腥。",
      "visual_cue": "水面咕嘟冒泡，花生颜色转浅"
    },
    {
      "n": 5,
      "text": "把小米面糊边搅边淋进锅里，转小火，用汤勺不停搅动十二分钟，防止糊底。",
      "time_min": 12,
      "heat": "小火",
      "tip": "下糊后必须一直搅，锅底一停就结痂，整锅带糊味。",
      "visual_cue": "粥体由稀变稠，勺子划过留痕"
    },
    {
      "n": 6,
      "text": "下粉丝和豆腐皮丝再煮三分钟，加盐和白胡椒调匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆腐皮下得早会煮散，最后三分钟放口感最好。",
      "visual_cue": "粉丝透明，豆腐皮丝浮在粥面"
    },
    {
      "n": 7,
      "text": "关火撒入菠菜段，淋上花生油搅匀，盛进碗里趁热喝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "菠菜关火后放，靠余温烫熟，颜色才不会发黄。",
      "visual_cue": "粥面浮一层油光，飘着菠菜清香"
    }
  ],
  "tips": [
    "济南甜沫其实是咸的，名字里的甜来自早年加粉丝粉条的老说法，调味全靠盐和白胡椒。",
    "小米面买现磨的细面，粗粒面煮出来的粥带砂感，挂不住勺。",
    "白胡椒要现磨现撒，提前放会失香，最后那口胡椒气才是甜沫的魂。"
  ],
  "common_mistakes": [
    "面糊一次全倒进锅，来不及搅就结成大疙瘩，煮再久也散不开。",
    "全程大火滚煮，粥面翻腾溢锅，锅底同时糊了一层。",
    "菠菜和豆腐皮一起早早下锅，煮到发黄发烂，粥色发暗。"
  ],
  "substitutions": [
    {
      "original": "小米面",
      "substitute": "玉米面",
      "ratio": "200克:200克",
      "note": "玉米面更粗更香，粥体偏黄，需多煮五分钟。"
    },
    {
      "original": "菠菜",
      "substitute": "小白菜",
      "ratio": "120克:120克",
      "note": "小白菜纤维更细，烫半分钟后切碎即可。"
    }
  ],
  "variations": [
    "加一小把泡软的粉条替代粉丝，口感更筋道，是章丘一带的做法。",
    "喜欢稠口的把小米面加到二百四十克，粥体立勺不倒，配油条吃。"
  ],
  "serving_suggestion": "盛进粗瓷碗里，撒一撮白胡椒，就着刚出锅的油条或烧饼，是济南人清早的标配。",
  "storage": "现煮现喝最好，冷藏可放一天；复热时加两勺清水小火搅开，稠了会糊底。",
