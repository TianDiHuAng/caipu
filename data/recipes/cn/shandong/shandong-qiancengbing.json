  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋面粉，和成半烫面",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 230,
          "unit": "ml",
          "note": "一半开水一半凉水",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "面团与油酥分次用",
          "optional": false
        },
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 60,
          "unit": "ml",
          "note": "调油酥与刷锅",
          "optional": false
        },
        {
          "name": "五香粉",
          "name_en": "five spice powder",
          "amount": 3,
          "unit": "g",
          "note": "拌入油酥增香",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "切细葱花",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "案板",
    "擀面杖",
    "平底锅",
    "锅盖",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉分成两份，一份用开水烫成絮状，另一份用凉水和匀，再合起来揉成光滑面团。",
      "time_min": 15,
      "heat": "无火",
      "tip": "半烫面既有烫面的柔软又有冷水的筋性，层次才分得开。",
      "visual_cue": "面团光滑柔软，按压能留下浅坑。"
    },
    {
      "n": 2,
      "text": "面团盖上湿布静置松弛，让面筋舒展，擀的时候才不会回缩。",
      "time_min": 20,
      "heat": "无火",
      "tip": "松弛到位面团才听话，硬擀会把层次压死。",
      "visual_cue": "面团柔软服帖，手指轻推即可延展。"
    },
    {
      "n": 3,
      "text": "取面粉加盐和五香粉，浇上烧热的花生油调成稠油酥，备用。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油酥要稠一点，抹在面片上才不会到处流。",
      "visual_cue": "油酥浓稠能挂住刮板，闻着有熟油与五香。"
    },
    {
      "n": 4,
      "text": "面团擀成大薄方片，抹匀油酥撒葱花，上下各切几刀后层层叠起。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切刀不要切透边缘，叠起来才能封住油酥不漏。",
      "visual_cue": "面片叠成方块，层次清楚边缘完整。"
    },
    {
      "n": 5,
      "text": "叠好的面坯轻轻按扁，擀成两厘米厚的饼，表面刷一层花生油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "只从中间往四周轻推，别来回擀，层次才不被压实。",
      "visual_cue": "饼坯方正厚实，层纹隐约可见。"
    },
    {
      "n": 6,
      "text": "平底锅小火把饼两面烙到金黄，加盖焖烙到内部熟透后出锅抖散。",
      "time_min": 15,
      "heat": "小火",
      "tip": "加盖焖烙能让厚饼内部熟透，出锅趁热抖一下层次更分明。",
      "visual_cue": "两面金黄酥脆，抖开层次分明不掉渣。"
    }
  ],
  "tips": [
    "半烫面是千层饼柔软又分层的基础，全冷水面会发硬。",
    "油酥要抹匀但别抹太多，多了叠起来会滑开。",
    "小火加盖焖烙，热量缓慢透进饼心，厚饼才能里外同熟。"
  ],
  "common_mistakes": [
    "全用冷水和面，饼烙好发硬，凉一点更是嚼不动。",
    "油酥抹得太少，叠起来粘成一块，抖不出层次。",
    "中大火急烙抢时间，外皮焦了里头还是夹生的死面。"
  ],
  "substitutions": [
    {
      "original": "花生油",
      "substitute": "猪油",
      "ratio": "60毫升:55克",
      "note": "猪油起层更明显，香气也更浓，注意减量防腻。"
    },
    {
      "original": "五香粉",
      "substitute": "花椒粉",
      "ratio": "3克:3克",
      "note": "换花椒粉麻香更冲，适合配羊汤。"
    }
  ],
  "variations": [
    "有的做法在油酥里加一勺熟芝麻，咬起来更香。",
    "家庭版可把饼烙好后切成小块再回锅烘干，脆感更足。"
  ],
  "serving_suggestion": "千层饼趁热抖散装盘，配一碗小米粥或羊汤，就是一顿热乎的山东早饭。",
  "storage": "凉后密封冷藏两天，吃前平底锅小火两面各烙两分钟即可回酥。",
