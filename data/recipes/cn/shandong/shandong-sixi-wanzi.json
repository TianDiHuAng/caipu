  "equipment": [
    "炒锅",
    "大碗",
    "砂锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肉末放盆里，加盐、料酒、葱姜末、鸡蛋和淀粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "肥瘦三七分最合适，全瘦肉丸子发柴。",
      "visual_cue": "肉馅落盆、配料齐备"
    },
    {
      "n": 2,
      "text": "顺着一个方向用力搅打五分钟，直到肉馅上劲发黏。",
      "time_min": 5,
      "heat": "无火",
      "tip": "上劲是丸子不散的关键，搅到能拉出细丝。",
      "visual_cue": "肉馅发黏、能拉出细丝"
    },
    {
      "n": 3,
      "text": "分次打入两勺清水，继续同向搅拌到水分全被吸收。",
      "time_min": 4,
      "heat": "无火",
      "tip": "分次打水，丸子才嫩而有汁，一次倒会澥。",
      "visual_cue": "肉馅光亮、按压回弹"
    },
    {
      "n": 4,
      "text": "双手沾水，把肉馅摔打成四个大丸子，每个约一百二十克。",
      "time_min": 6,
      "heat": "无火",
      "tip": "摔打十几下排出空气，丸子紧实不裂。",
      "visual_cue": "丸子浑圆、表面光洁"
    },
    {
      "n": 5,
      "text": "锅中倒植物油烧到六成热，放入丸子中火炸到表面金黄定型。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温稳住再下丸子，低了散、高了外焦内生。",
      "visual_cue": "丸子金黄定型、外壳略硬"
    },
    {
      "n": 6,
      "text": "砂锅放清水，加生抽、老抽、白糖和八角烧开，放入丸子。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水要没过丸子大半，炖时才不会露头变硬。",
      "visual_cue": "汤面翻滚、丸子半沉"
    },
    {
      "n": 7,
      "text": "转小火盖盖炖三十五分钟，中途翻动一次让四面入味。",
      "time_min": 35,
      "heat": "小火",
      "tip": "小火慢炖，丸子内部才熟透又不散。",
      "visual_cue": "丸子饱满、汤汁转浓"
    },
    {
      "n": 8,
      "text": "油菜焯水后摆在盘边，丸子盛中间，汤汁勾薄芡浇上。",
      "time_min": 5,
      "heat": "中火",
      "tip": "芡汁要薄，能挂住丸身即可，太厚糊嘴。",
      "visual_cue": "酱汁红亮、青菜翠绿"
    }
  ],
  "tips": [
    "肉末手剁的比机器打的更有颗粒感。",
    "没有砂锅可用厚底锅小火焖，时间加五分钟。",
    "丸子一次可多做，冷冻保存随吃随炖。"
  ],
  "common_mistakes": [
    "肉馅没上劲就团丸子，下锅一炖就散成肉末。",
    "炸丸子油温不够，外壳不成形还吸满油。",
    "炖煮火太大，丸子外表散开内部却没熟透。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "500g 对 500g",
      "note": "牛肉瘦，需多加一勺淀粉与清水。"
    },
    {
      "original": "油菜",
      "substitute": "上海青",
      "ratio": "150g 对 150g",
      "note": "口感相近，焯水时间略短。"
    }
  ],
  "variations": [
    "丸子中间包一颗鹌鹑蛋，做成藏心四喜丸子。",
    "加香菇末同拌，鲜味更足也更松软。"
  ],
  "serving_suggestion": "四个丸子整盘上桌，浇汁配青菜，是鲁菜宴席的压轴大菜。",
  "storage": "冷藏三天，冷冻一个月；复热连汁小火炖十分钟。",
