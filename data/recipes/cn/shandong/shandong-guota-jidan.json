  "equipment": [
    "平底锅",
    "锅铲",
    "碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕入碗中，加盐、料酒与葱末，用筷子充分打散到起细泡。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液打得越透，煎出的蛋饼越松软不起疙瘩。",
      "visual_cue": "蛋液均匀发亮，表面浮起细泡"
    },
    {
      "n": 2,
      "text": "平底锅倒一半植物油烧热，倒入蛋液转小火摊成厚蛋饼。",
      "time_min": 4,
      "heat": "小火",
      "tip": "火一定要小，蛋饼才摊得厚实不焦边。",
      "visual_cue": "蛋饼边缘凝固，中间仍微微晃动"
    },
    {
      "n": 3,
      "text": "蛋饼底面凝固后翻面再煎一分钟，盛出放凉切成长方块。",
      "time_min": 2,
      "heat": "小火",
      "tip": "切块前稍放凉定型，热着切容易散成碎块。",
      "visual_cue": "蛋饼两面金黄，切块边缘齐整"
    },
    {
      "n": 4,
      "text": "蛋块两面拍上一层面粉，抖掉多余的粉后放回锅中。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拍粉是为了挂住后面的汤汁，别拍太厚。",
      "visual_cue": "蛋块表面薄薄一层粉，不见干粉"
    },
    {
      "n": 5,
      "text": "锅中加生抽、白糖与半碗清水，下姜末小火烧两分钟让蛋块吸味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "汤汁要收到略稠挂在蛋块上，太稀就吸不进味。",
      "visual_cue": "汤汁减半，蛋块颜色转深"
    },
    {
      "n": 6,
      "text": "收汁至浓稠，沿锅边淋香油，撒余下的葱末出锅。",
      "time_min": 2,
      "heat": "小火",
      "tip": "香油一定要最后淋，提前下锅香气会被烧光。",
      "visual_cue": "汤汁紧裹蛋块，油亮不流"
    }
  ],
  "tips": [
    "摊蛋饼时锅要转一圈让蛋液铺匀，薄厚才一致。",
    "加一勺淀粉水进蛋液，出锅更挺括不易碎。",
    "想更鲜可加几片木耳或虾仁同塌，就是三鲜做法。"
  ],
  "common_mistakes": [
    "火太大摊蛋饼，底面焦黑上面还是液体。",
    "蛋块不拍粉直接塌，汤汁挂不住，吃起来寡淡。",
    "汁水收得太干，蛋块发硬，失去了软嫩口感。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4个:4个",
      "note": "鸭蛋腥味重，料酒加倍。"
    },
    {
      "original": "面粉",
      "substitute": "淀粉",
      "ratio": "30克:25克",
      "note": "淀粉挂汁更薄，口感更轻盈。"
    }
  ],
  "variations": [
    "把鸡蛋换成豆腐，就是山东名菜锅塌豆腐，做法一样只多一步煎。",
    "塌的时候加一勺香醋，酸香开胃，适合夏天吃。"
  ],
  "serving_suggestion": "切块装盘连汁上桌，配米饭佐粥都行，老人孩子都好入口。",
  "storage": "冷藏可存两天，复热须上锅蒸五分钟，回锅会变硬。",
