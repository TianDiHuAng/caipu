    "炒锅",
    "刀",
    "砧板",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大白菜掰开洗净，取嫩叶和菜帮切成四厘米长的段，菜帮斜刀片薄。",
      "time_min": 6,
      "heat": "无火",
      "tip": "菜帮片薄才和菜叶同时熟，省得一边烂一边生。",
      "visual_cue": "菜帮半透明，菜叶完整"
    },
    {
      "n": 2,
      "text": "炒锅放猪油小火化开，倒入中筋面粉不停搅拌炒成淡黄色油面。",
      "time_min": 4,
      "heat": "小火",
      "tip": "面粉要一直搅，停手就结块发苦。",
      "visual_cue": "油面顺滑无颗粒，色浅黄"
    },
    {
      "n": 3,
      "text": "冲入清水和鲜奶，边倒边用打蛋器搅匀，汤底立刻变浓白。",
      "time_min": 4,
      "heat": "中火",
      "tip": "先倒少量液体调开，再一次加足不结疙瘩。",
      "visual_cue": "汤色乳白，表面无粉疙瘩"
    },
    {
      "n": 4,
      "text": "汤底烧开后下姜末和白菜帮，中小火煮到菜帮变软。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "菜帮先下菜叶后下，熟度才一致。",
      "visual_cue": "菜帮半透明，能被筷子插入"
    },
    {
      "n": 5,
      "text": "放入菜叶继续煮到软烂，汤呈奶白浓稠的状态。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "菜叶久煮会发黄，软了马上调味。",
      "visual_cue": "菜叶深绿软塌，汤面微滚"
    },
    {
      "n": 6,
      "text": "加盐和白胡椒调味，撇掉浮沫，盛入汤碗中。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后放，早了白菜出水，汤味变淡。",
      "visual_cue": "汤白如奶，白菜清甜不发黄"
    }
  ],
  "tips": [
    "炒油面要小火慢炒，才能出奶白又不苦。",
    "液体分次加入，汤底才顺滑无疙瘩。",
    "盐最后放，白菜的清甜才留得住。"
  ],
  "common_mistakes": [
    "面粉大火炒，糊味盖过整锅汤，只能倒掉。",
    "一次倒入全部液体，油面结成硬疙瘩。",
    "白菜煮太久，菜叶发黄散在汤里。"
  ],
  "substitutions": [
    {
      "original": "鲜奶",
      "substitute": "淡奶油",
      "ratio": "150 毫升:60 毫升",
      "note": "更浓稠，奶香重，需加水稀释避免腻。"
    },
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "20 克:20 克",
      "note": "少了脂香，汤的醇厚感略降。"
    }
  ],
  "variations": [
    "加几片火腿同煮，咸鲜更有层次。",
    "放一小把虾皮同煮，海味更明显也更鲜。"
  ],
  "serving_suggestion": "盛入白瓷汤碗，趁热喝，配馒头或烧饼最对味。",
  "storage": "冷藏一天，复热小火加热并搅动，避免油面沉底糊锅。",
