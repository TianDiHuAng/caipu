    "炒锅",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪蹄膀用刀刮净表皮残毛和油泥，冷水下锅加料酒与姜片焯水，煮开撇沫后捞出冲洗。",
      "time_min": 12,
      "heat": "大火",
      "tip": "冷水下锅才能把血水逼出来，热水下锅血沫锁在肉里。",
      "visual_cue": "表面无浮沫、皮色发白"
    },
    {
      "n": 2,
      "text": "趁热用厨房纸擦干肘子，把老抽均匀抹在表皮上，静置五分钟让颜色吃进去。",
      "time_min": 5,
      "heat": "无火",
      "tip": "趁热抹老抽上色最牢，凉了皮收缩就挂不住色。",
      "visual_cue": "表皮呈均匀酱红色"
    },
    {
      "n": 3,
      "text": "炒锅放植物油，下冰糖用小火慢慢炒到完全溶化、冒起枣红色小泡。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖色一冒枣红泡就要立刻加水，晚了会发苦。",
      "visual_cue": "糖液枣红、泡沫细密"
    },
    {
      "n": 4,
      "text": "沿锅边冲入清水，加生抽、料酒、盐、八角、桂皮和香叶，大火烧开成卤汤。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水要一次加足，中途加水汤味会变淡。",
      "visual_cue": "汤色红亮、香气四溢"
    },
    {
      "n": 5,
      "text": "把肘子放进卤汤，皮朝下，小火加盖焖一小时，中途翻动一次防止粘底。",
      "time_min": 60,
      "heat": "小火",
      "tip": "全程保持汤面微沸冒小泡，滚太猛皮会破。",
      "visual_cue": "汤面微沸、肘子沉底不粘"
    },
    {
      "n": 6,
      "text": "把肘子翻成皮朝上，继续小火焖四十分钟，直到筷子能轻松戳透皮肉。",
      "time_min": 40,
      "heat": "小火",
      "tip": "筷子一戳即透就是烂了，戳不进说明还得再焖。",
      "visual_cue": "筷子轻松穿透皮肉"
    },
    {
      "n": 7,
      "text": "转大火收汁，边收边把汤汁浇在肘子上，收到浓稠挂勺后撒葱段装盘。",
      "time_min": 8,
      "heat": "大火",
      "tip": "收汁时勤浇汤，皮面才油亮不发干。",
      "visual_cue": "汤汁浓稠、能挂住勺背"
    }
  ],
  "tips": [
    "肘子选前肘皮厚胶质多，约一斤三两最合适，太大不易焖透。",
    "糖色只需炒到枣红，颜色过深会带焦苦味，整锅汤都救不回来。",
    "焖好后别急着捞，关火在汤里泡半小时，味道更透更润。"
  ],
  "common_mistakes": [
    "糖色炒糊才加水，成品发苦、颜色发黑。",
    "全程大火炖煮，猪皮破裂、肉散成块，卖相全无。",
    "盐放得太早，肉质紧缩，炖两小时还是发硬。"
  ],
  "substitutions": [
    {
      "original": "猪蹄膀",
      "substitute": "五花肉",
      "ratio": "650g 对 600g",
      "note": "五花肉易熟，焖制时间可缩短到七十分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "40g 对 35g",
      "note": "白糖上色更快，火候要更小以免焦化过头。"
    }
  ],
  "variations": [
    "卤汤里加两颗红枣和一小块陈皮，回甘更明显。",
    "收汁前加半勺蜂蜜，表皮更亮更黏。"
  ],
  "serving_suggestion": "整只上桌或切厚片码盘，淋汁配荷叶饼与白饭。",
  "storage": "冷藏可存三天，复热时连汤一起蒸二十分钟，皮不发硬。",
