  "equipment": [
    "炒锅",
    "蒸锅",
    "小勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成四厘米见方的块，入淡盐水浸泡十分钟后捞出沥干水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "淡盐水泡过的豆腐更紧实，后面挖洞时才不容易裂开。",
      "visual_cue": "豆腐块挺实，表面干爽不滴水。"
    },
    {
      "n": 2,
      "text": "锅中植物油烧至五成热，下豆腐块炸到表面金黄起硬壳后捞出控油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温五成下锅最稳，太热外面焦而里面没定型，挖洞会碎。",
      "visual_cue": "外壳金黄硬挺，敲着有脆响。"
    },
    {
      "n": 3,
      "text": "炸好的豆腐晾到不烫手，用刀在顶面切去薄薄一层作盖，再用小勺挖空内瓤。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切盖时要留一圈边，挖的时候贴着外壳走，别把底戳穿。",
      "visual_cue": "豆腐成空箱状，箱壁完整无破洞。"
    },
    {
      "n": 4,
      "text": "五花肉丁下锅炒出油脂，加香菇、木耳、胡萝卜、姜末炒香，用生抽和盐调味后填回豆腐箱。",
      "time_min": 8,
      "heat": "中火",
      "tip": "馅要炒到干香不出水，填的时候压实一点，蒸后才不塌。",
      "visual_cue": "馅料油亮喷香，豆腐箱装得鼓鼓的。"
    },
    {
      "n": 5,
      "text": "豆腐箱盖回原盖码入盘中，上蒸锅大火蒸十二分钟，取出把原汁滗出锅。",
      "time_min": 14,
      "heat": "大火",
      "tip": "蒸透再滗汁，原汁鲜味足，是后面勾汁的关键。",
      "visual_cue": "豆腐箱蒸后微微鼓起，盘底有清亮汤汁。"
    },
    {
      "n": 6,
      "text": "原汁加高汤烧开，用玉米淀粉兑水勾薄芡，撒小葱后浇在豆腐箱上即可。",
      "time_min": 4,
      "heat": "中火",
      "tip": "芡要勾得薄而亮，能挂住豆腐箱又不糊成一团。",
      "visual_cue": "浇汁透亮，均匀裹住每只豆腐箱。"
    }
  ],
  "tips": [
    "豆腐先炸后挖，外壳硬挺，装馅时不易破。",
    "挖出的豆腐瓤别扔，拌进馅里一起炒，口感更松。",
    "馅料炒得干一点，蒸后汤汁才不会把豆腐箱泡塌。"
  ],
  "common_mistakes": [
    "豆腐没炸透就挖洞，箱壁一碰就裂，馅料漏得满盘都是。",
    "馅料水分太多，蒸完豆腐箱软塌变形，卖相全无。",
    "勾芡过厚发糊，把豆腐箱糊成一团，看不出箱形。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "香菇",
      "ratio": "120克:120克",
      "note": "素版用香菇代替肉，需多加十毫升植物油补香。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "150毫升:150毫升",
      "note": "清水烧汁味薄，可加两滴蚝油提鲜。"
    }
  ],
  "variations": [
    "博山当地会把豆腐箱做成八个一组，取发财吉利的好口彩。",
    "有的家庭把蒸改成浇汁焖，豆腐箱更软嫩，汤汁更足。"
  ],
  "serving_suggestion": "博山豆腐箱整齐码盘上桌，浇汁后一人一只，配米饭或单吃都合适。",
  "storage": "冷藏保存两天，复热时上锅蒸八分钟，切勿大火久煮以免散形。",
