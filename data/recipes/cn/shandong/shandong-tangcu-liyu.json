  "equipment": [
    "炒锅",
    "漏勺",
    "大漏盘",
    "深盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲤鱼去鳞去鳃去内脏，洗净后撕掉腹内黑膜，用厨房纸擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黑膜和贴骨血是腥味来源，一定清干净。",
      "visual_cue": "鱼身干爽、腹内洁净"
    },
    {
      "n": 2,
      "text": "在鱼身两面每隔两厘米剞一字花刀，深至鱼骨但不切断。",
      "time_min": 6,
      "heat": "无火",
      "tip": "花刀深度到骨，炸后才会翻花定型好看。",
      "visual_cue": "刀口均匀、深至鱼骨"
    },
    {
      "n": 3,
      "text": "鱼身内外抹盐和料酒，塞入姜片葱段腌十五分钟去腥。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌鱼时间够，后面调味才不会被腥味压住。",
      "visual_cue": "鱼身微湿、葱姜贴服"
    },
    {
      "n": 4,
      "text": "淀粉、面粉、鸡蛋液加少许清水调成能挂住鱼身的面糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面糊调到提起勺子能缓慢流下，太稀挂不住、太厚发硬。",
      "visual_cue": "面糊顺滑、提起能拉线"
    },
    {
      "n": 5,
      "text": "提着鱼尾把面糊均匀淋满鱼身，刀口处要掰开灌满面糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刀口灌满面糊，炸时才会开出花形。",
      "visual_cue": "鱼身裹糊均匀、刀口饱满"
    },
    {
      "n": 6,
      "text": "锅中倒植物油烧到六成热，提着鱼尾先下鱼头炸定型，再整条滑入。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "先定型鱼头再放鱼身，鱼才不会粘成弯月。",
      "visual_cue": "鱼头定型、糊壳转浅黄"
    },
    {
      "n": 7,
      "text": "中火炸十分钟至外壳金黄酥脆，捞出控油装盘。",
      "time_min": 10,
      "heat": "中火",
      "tip": "炸的过程用勺把热油浇在鱼背上，受热才匀。",
      "visual_cue": "外壳金黄脆硬、鱼身挺立"
    },
    {
      "n": 8,
      "text": "另起锅放少许油，下番茄酱、白糖、香醋、生抽和半碗清水煮开。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酸甜汁先尝味道，酸了加糖、甜了加醋。",
      "visual_cue": "酱汁冒泡、颜色红亮"
    },
    {
      "n": 9,
      "text": "淋入水淀粉勾芡到能挂勺，浇一勺热油把汁推亮。",
      "time_min": 2,
      "heat": "中火",
      "tip": "明油让酱汁透亮，浇在鱼身上才漂亮。",
      "visual_cue": "酱汁浓稠透亮、无结块"
    },
    {
      "n": 10,
      "text": "趁热把糖醋汁浇满整条鱼身，撒上葱丝立刻端上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "汁一定要浇在刚炸好的鱼上，才有酥脆声。",
      "visual_cue": "汁液流挂鱼身、外壳仍脆"
    }
  ],
  "tips": [
    "鲤鱼选一斤半左右的活鱼，太大肉粗、太小刺多。",
    "面糊要稠到提起勺子能缓慢流下，太稀挂不住鱼身。",
    "糖醋汁比例约糖六醋四，可按口味微调。"
  ],
  "common_mistakes": [
    "花刀太浅，炸后鱼身不开花，造型扁塌。",
    "面糊太稀，下锅就滑落，炸出来皮不脆。",
    "糖醋汁勾芡过稠，浇上后结成硬块。"
  ],
  "substitutions": [
    {
      "original": "鲤鱼",
      "substitute": "草鱼",
      "ratio": "700g 对 700g",
      "note": "草鱼肉厚，剞刀要更深一些。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "40ml 对 40ml",
      "note": "米醋酸味更冲，白糖可略增。"
    }
  ],
  "variations": [
    "汁里加少许橙汁，做成橙香糖醋鲤鱼。",
    "改用整条鲈鱼，肉嫩刺少，更适合孩子。"
  ],
  "serving_suggestion": "整条上桌，趁热吃外壳酥、鱼肉嫩，配米饭解腻。",
  "storage": "不建议隔夜，回热后外壳回软，风味大减。",
