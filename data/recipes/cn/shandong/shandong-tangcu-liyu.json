  "equipment": [
    "炒锅",
    "菜刀",
    "漏勺",
    "大盆",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲤鱼去鳞去内脏后冲洗干净，两面各斜剞五六刀，深到鱼骨但不要切断。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刀口要斜着切，鱼肉遇热卷起来造型才好看",
      "visual_cue": "鱼身开出均匀花刀，刀口整齐不破皮"
    },
    {
      "n": 2,
      "text": "鱼身内外抹上盐和料酒，塞入姜片和葱段腌十五分钟去腥。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌好后把鱼身表面的血水擦干，挂糊才黏得牢",
      "visual_cue": "鱼身干爽，葱姜香味渗进肉里"
    },
    {
      "n": 3,
      "text": "面粉和淀粉加清水调成能挂住勺背的糊，把鱼整条裹匀，刀口处也要抹到。",
      "time_min": 8,
      "heat": "无火",
      "tip": "糊要稠到能挂住勺背，太稀挂不住，炸完不成形",
      "visual_cue": "鱼身裹满薄糊，提起来糊不往下滴"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到六成热，提着鱼尾先炸鱼头定型，再把整条鱼滑进油里。",
      "time_min": 6,
      "heat": "大火",
      "tip": "下锅时提着鱼尾让鱼身弯成弓形，炸出来造型才挺",
      "visual_cue": "鱼身弯成弓形定型，油面大滚"
    },
    {
      "n": 5,
      "text": "中火炸八分钟翻面再炸五分钟，炸到外壳硬脆捞出，放厨房纸上沥油。",
      "time_min": 14,
      "heat": "中火",
      "tip": "用勺子不断把热油淋在鱼身上，两面受热才均匀",
      "visual_cue": "外壳炸到金黄硬脆，敲上去发响"
    },
    {
      "n": 6,
      "text": "另起锅放白糖、米醋、生抽、老抽和清水熬开，加蒜末和姜丝勾芡，浇在鱼身上。",
      "time_min": 6,
      "heat": "中火",
      "tip": "糖醋汁熬到能挂住勺背再勾芡，浇上去才红亮",
      "visual_cue": "糖醋汁红亮黏稠，浇时滋滋作响"
    }
  ],
  "tips": [
    "鱼一定要选鲜活的，眼睛清亮、鳃色鲜红，炸出来肉才不散。",
    "花刀切到鱼骨但不切透，这样炸后鱼肉翻开，浇汁也能挂住。",
    "糖醋汁的酸甜比大约一比一，喜欢酸一点就把米醋加到八十毫升。"
  ],
  "common_mistakes": [
    "鱼身没擦干就挂糊，糊和水混在一起脱落，炸出来坑坑洼洼。",
    "油温不够就把鱼下锅，外壳吸满油发软，切开里面还带血丝。",
    "糖醋汁熬好才勾芡又大火收，芡汁结成硬块，浇在鱼身上一坨坨。"
  ],
  "substitutions": [
    {
      "original": "鲤鱼",
      "substitute": "草鱼",
      "ratio": "900克:900克",
      "note": "草鱼刺多，花刀要切得更密。"
    },
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "70毫升:70毫升",
      "note": "香醋味更厚，白糖可减到六十克。"
    }
  ],
  "variations": [
    "把番茄酱加到糖醋汁里，颜色更红，酸甜味更直接，孩子更爱。",
    "喜欢麻香的可以在浇汁前撒一把花椒粉，做成川式糖醋鱼口味。"
  ],
  "serving_suggestion": "整条鱼摆在长盘里，浇汁后立刻上桌，配米饭和一碗清汤，是宴席的主菜。",
  "storage": "炸好的鱼当天吃完最好，冷藏后回锅用一百八十度油炸两分钟复脆，再浇新熬的汁。",
