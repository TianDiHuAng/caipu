  "equipment": [
    "砂锅",
    "炒锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐切成两厘米见方的块，放进淡盐水里泡五分钟，捞出沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐水泡过的豆腐更紧实，下锅不容易碎。",
      "visual_cue": "豆腐块完整，表面不见水渍"
    },
    {
      "n": 2,
      "text": "香菇洗净去蒂切片，火腿切薄片，虾仁挑掉背上的黑线后擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "虾仁擦干水分再下锅，才不出水、不发腥。",
      "visual_cue": "配料切得厚薄一致，虾仁干爽"
    },
    {
      "n": 3,
      "text": "砂锅底垫姜片和小葱段，先铺香菇和火腿，再把豆腐块一块块码上去。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豆腐块别叠压，单层码开受热才均匀。",
      "visual_cue": "豆腐块整齐平铺，缝隙里嵌着香菇"
    },
    {
      "n": 4,
      "text": "倒入鸡汤没过豆腐，大火烧开后转小火炖十五分钟，让味道渗进豆腐。",
      "time_min": 18,
      "heat": "小火",
      "tip": "砂锅要冷水上灶慢慢升温，骤热容易炸裂。",
      "visual_cue": "汤面微微冒泡，豆腐浮起打颤"
    },
    {
      "n": 5,
      "text": "放虾仁再炖三分钟，加盐和白胡椒粉调味，淋玉米淀粉水勾一层薄芡。",
      "time_min": 4,
      "heat": "小火",
      "tip": "虾仁最后下锅，久煮会变硬如同橡皮。",
      "visual_cue": "虾仁卷曲变红，汤汁略稠挂勺"
    },
    {
      "n": 6,
      "text": "撒上小葱段、淋上芝麻油，连砂锅一起端上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "砂锅保温强，上桌后汤还在滚，吃时小心烫口。",
      "visual_cue": "汤面油光清亮，葱段翠绿"
    }
  ],
  "tips": [
    "砂锅首次使用前先用淘米水煮一遍，能防裂。",
    "豆腐选嫩豆腐，久炖后仍滑；北豆腐则更吸汤。",
    "火腿是提鲜关键，没有就用咸肉代替，盐量要相应减少。"
  ],
  "common_mistakes": [
    "砂锅空锅大火干烧，釉层受热不均直接裂开。",
    "豆腐和虾仁一起下，虾仁煮老，豆腐还没入味。",
    "勾芡后大火久滚，汤汁澥成水，砂锅底还结了薄糊。"
  ],
  "substitutions": [
    {
      "original": "鸡汤",
      "substitute": "清水",
      "ratio": "700毫升:700毫升",
      "note": "清水版本多放一片火腿补鲜。"
    },
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "40克:40克",
      "note": "咸肉先焯水去咸，盐量减到三克。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝垫底，粉丝吸汤后非常下饭。",
    "冬天可加几片大白菜同炖，汤更清甜。"
  ],
  "serving_suggestion": "砂锅直接上桌，先舀一勺汤尝咸淡，再连豆腐带虾仁一起盛进小碗，配米饭吃。",
  "storage": "冷藏可存两天，复热时倒回砂锅加少量鸡汤小火加热；豆腐不宜冷冻，解冻后呈蜂窝状。",
