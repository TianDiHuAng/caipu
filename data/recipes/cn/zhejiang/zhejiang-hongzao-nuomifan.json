      "group": "main",
      "items": [
        {
          "name": "糯米",
          "name_en": "glutinous rice",
          "amount": 300,
          "unit": "g",
          "note": "圆糯米更黏",
          "optional": false
        },
        {
          "name": "红枣",
          "name_en": "red date",
          "amount": 100,
          "unit": "g",
          "note": "去核撕成两半",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "猪油",
          "name_en": "lard",
          "amount": 20,
          "unit": "g",
          "note": "拌米增香",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "甜度可调",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 400,
          "unit": "ml",
          "note": "蒸制与泡米用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "深碗",
    "蒸屉",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗两遍，加清水没过两指，泡二十分钟到米粒一捏就碎。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡透的糯米蒸出来才软糯，没泡够的米蒸一小时还夹生。",
      "visual_cue": "米粒涨大饱满，手指一捏就碎"
    },
    {
      "n": 2,
      "text": "红枣用温水泡软，剪开去核，撕成两半，泡枣的水留着备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "枣核带燥性，去干净吃着不涩，甜味也更纯。",
      "visual_cue": "枣肉软胀发亮，枣核已去净"
    },
    {
      "n": 3,
      "text": "糯米沥干拌入猪油与白糖，抓匀后铺进深碗，枣肉一片片嵌在米面上。",
      "time_min": 8,
      "heat": "无火",
      "tip": "猪油别省，它让米粒发亮不粘碗，凉了也不硬。",
      "visual_cue": "米粒油亮，枣片排列整齐"
    },
    {
      "n": 4,
      "text": "碗里倒入泡枣的水与清水至与米齐平，放进蒸锅大火上汽后蒸四十分钟。",
      "time_min": 40,
      "heat": "大火",
      "tip": "水量刚齐米面最稳，多了成稀饭，少了中间夹生。",
      "visual_cue": "米面平整，水面刚过米一指节"
    },
    {
      "n": 5,
      "text": "关火焖五分钟再开盖，倒扣在盘里，趁热淋一勺糖水或撒白糖。",
      "time_min": 4,
      "heat": "无火",
      "tip": "焖五分钟让米粒回软定型，急着扣碗会散成一堆。",
      "visual_cue": "倒扣成型完整，米粒软糯"
    }
  ],
  "tips": [
    "这道甜饭在江浙是过年和喜事桌上的压轴，一勺挖下去枣香混着米香。",
    "喜欢更甜可以在蒸前铺一层红豆沙，切开有层次。",
    "糯米不易消化，老人小孩一次别吃超过一小碗。"
  ],
  "common_mistakes": [
    "糯米没泡就蒸，蒸一小时米心还是硬的，咬着硌牙。",
    "水一次倒太多，蒸出来一摊米糊，扣碗完全不成形。",
    "蒸好立刻开盖，遇冷回缩，米粒发硬且表面坑洼。"
  ],
  "substitutions": [
    {
      "original": "红枣",
      "substitute": "蜜枣",
      "ratio": "100克:90克",
      "note": "蜜枣自带糖，白糖减到二十克。"
    },
    {
      "original": "猪油",
      "substitute": "黄油",
      "ratio": "20克:20克",
      "note": "黄油版带奶香，适合西式口味。"
    }
  ],
  "variations": [
    "中间夹一层红豆沙再铺枣，切开成八宝样式，是酒席做法。",
    "改用南瓜泥拌米，颜色金黄，甜味更自然。"
  ],
  "serving_suggestion": "切块装盘，热吃软糯，凉了切片再蒸一次口感依旧。",
  "storage": "冷藏可存两天，复热时隔水蒸十分钟，勿用微波炉直接打会发硬。",
