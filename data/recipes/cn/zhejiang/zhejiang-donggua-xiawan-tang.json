  "steps": [
    {
      "n": 1,
      "text": "虾仁挑去背上的黑线，用刀背拍散后剁成细泥。",
      "time_min": 10,
      "heat": "无火",
      "tip": "刀背拍过再剁，虾仁泥才起胶。，看准状态再往下做。",
      "visual_cue": "虾仁泥细腻，颜色粉白"
    },
    {
      "n": 2,
      "text": "虾仁泥加蛋清、淀粉、盐和姜末，顺一个方向搅。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅到上劲，丸子才不散。，看准状态再往下做。",
      "visual_cue": "虾仁泥发黏，能立住筷子"
    },
    {
      "n": 3,
      "text": "分次加两勺清水，继续搅到虾仁泥发亮。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "加水分次打，丸子才嫩。，看准状态再往下做。",
      "visual_cue": "虾仁泥光泽，手感弹，这一点很关键。"
    },
    {
      "n": 4,
      "text": "冬瓜去皮去瓤，切成半厘米厚的薄片。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "片薄一点，煮软更快入味。，看准状态再往下做。",
      "visual_cue": "片形均匀，边缘透光"
    },
    {
      "n": 5,
      "text": "汤锅倒清水烧到微沸，转小火挤入虾仁丸。，看准状态再往下做。",
      "time_min": 7,
      "heat": "小火",
      "tip": "水微沸就好，滚水会把丸子冲散。，看准状态再往下做。",
      "visual_cue": "丸子浮起，形态圆整"
    },
    {
      "n": 6,
      "text": "丸子全部浮起后撇去浮沫，加冬瓜片。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "撇净浮沫，汤才清。，看准状态再往下做。",
      "visual_cue": "汤清见底，丸子洁白"
    },
    {
      "n": 7,
      "text": "煮到冬瓜透明变软，加盐和白胡椒粉。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "白胡椒去腥，别放太早。，看准状态再往下做。",
      "visual_cue": "冬瓜透明，汤色微白"
    },
    {
      "n": 8,
      "text": "撒葱花淋香油，关火盛碗。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油关火后淋，清香不散。，看准状态再往下做。",
      "visual_cue": "汤面油花，葱花翠绿"
    }
  ],
  "tips": [
    "虾仁泥要顺一个方向搅上劲，丸子才不散。",
    "水微沸下丸子，滚水一冲就散。，这一点很关键。",
    "冬瓜煮到透明才有甜味，别急着出锅。"
  ],
  "common_mistakes": [
    "虾仁泥没上劲，丸子下锅变虾仁糊。，这一点很关键。",
    "水大滚下丸子，全冲成碎末。，这一点很关键。",
    "冬瓜煮太久，化在汤里找不着。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鲈鱼肉",
      "ratio": "350 克:350 克",
      "note": "去刺剁泥，鲜味更淡。"
    },
    {
      "original": "冬瓜",
      "substitute": "丝瓜",
      "ratio": "500 克:450 克",
      "note": "煮的时间减三分钟。"
    }
  ],
  "variations": [
    "加几片番茄，汤色更红润。，这一点很关键。",
    "放一小把粉丝，饱腹感更强。，这一点很关键。"
  ],
  "serving_suggestion": "夏天喝一碗，清淡解暑。，这一点很关键。",
  "storage": "冷藏一天，复热小火慢煮。，这一点很关键。",
