  "equipment": [
    "炒锅",
    "滚刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "竹笋剥壳去老根，切成 4cm 长的滚刀块，粗段从中间剖开。",
      "time_min": 10,
      "heat": "无火",
      "tip": "笋的根部老硬部分要全部切掉，否则久煮仍咬不动。",
      "visual_cue": "切面呈浅黄白色，质地细密"
    },
    {
      "n": 2,
      "text": "笋块冷水下锅，加 2g 盐煮 5 分钟去涩，捞出沥干。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯水能去掉草酸与涩味，鲜笋尤其必要。",
      "visual_cue": "笋块颜色由白转微黄，尝起来无麻涩感"
    },
    {
      "n": 3,
      "text": "炒锅下 50ml 植物油，中火把笋块煸炒 3 分钟至边缘微黄。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油要略多，笋吸油后才有「油焖」的油润感。",
      "visual_cue": "笋块边缘出现金黄焦边"
    },
    {
      "n": 4,
      "text": "加生抽、老抽、冰糖与 200ml 清水，烧开后转小火加盖焖 12 分钟。",
      "time_min": 13,
      "heat": "小火",
      "tip": "中途翻动一两次，让笋块均匀吸色。",
      "visual_cue": "汤汁收至一半，笋块呈酱红色"
    },
    {
      "n": 5,
      "text": "开盖转大火收汁至浓稠挂勺，淋香油、撒葱段翻匀出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁时不停翻动，糖分高容易糊锅。",
      "visual_cue": "酱汁浓稠包裹笋块，表面油亮"
    }
  ],
  "tips": [
    "笋的涩味与品种有关，苦竹笋建议焯水时间延长到 8 分钟。",
    "冰糖可用白糖替代，但冰糖收汁后光泽更好。",
    "冷藏后的油焖笋更入味，当作冷盘小菜也好吃。"
  ],
  "common_mistakes": [
    "笋不焯水直接焖，成品发涩发麻。",
    "用油太少，笋块吸不到油，成品干柴没有油润感。",
    "收汁时间过长，糖分焦化，笋块带明显苦味。"
  ],
  "substitutions": [
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "500g 笋 ≈ 450g 茭白",
      "note": "茭白更嫩，焖制时间减到 8 分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "15g 冰糖 ≈ 12g 白糖",
      "note": "甜度略高，可减量。"
    }
  ],
  "variations": [
    "家庭简化版：用真空包装水煮笋，省略焯水步骤，直接煸炒。",
    "咸鲜版：减少冰糖至 5g，加 15ml 料酒，做成咸口油焖笋。"
  ],
  "serving_suggestion": "冷热皆宜，配白粥或米饭；也常作为面浇头。",
  "storage": "冷藏 3 天，风味会随时间加深；不建议冷冻，解冻后口感发绵。",
