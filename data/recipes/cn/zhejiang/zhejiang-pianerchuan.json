  "steps": [
    {
      "n": 1,
      "text": "猪里脊逆纹切成薄片，加生抽和黄酒抓匀腌十分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "肉片切薄一些，一烫就熟，口感也不会老。",
      "visual_cue": "肉片薄透挂汁，摊开不叠"
    },
    {
      "n": 2,
      "text": "雪菜挤干水分切碎，冬笋切薄片，分别装碗备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "雪菜要挤干，否则汤会发酸发浑。",
      "visual_cue": "雪菜碎干爽，笋片薄而匀"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下肉片大火滑炒到变色盛出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "肉片先炒后回锅，嫩度更好也不易炒老。",
      "visual_cue": "肉片断生发白，边缘微卷"
    },
    {
      "n": 4,
      "text": "原锅下雪菜和笋片煸炒出香，加清水大火烧开成汤底。",
      "time_min": 3,
      "heat": "大火",
      "tip": "雪菜煸过才出鲜香，直接下水味寡。",
      "visual_cue": "汤色微黄，闻到腌菜香"
    },
    {
      "n": 5,
      "text": "汤底转中火略煮，让笋片与雪菜的鲜味融进汤里。",
      "time_min": 3,
      "heat": "中火",
      "tip": "多煮上两分钟，汤头才够鲜，笋也更入味。",
      "visual_cue": "汤面微沸，笋片变软"
    },
    {
      "n": 6,
      "text": "另起锅烧开水下面条，煮到八成熟捞出沥干。",
      "time_min": 4,
      "heat": "大火",
      "tip": "面只煮八分，还要在汤里回煮一会儿。",
      "visual_cue": "面条有白芯但已软身"
    },
    {
      "n": 7,
      "text": "面条下入汤锅，加肉片同煮到面条断生，尝味补盐。",
      "time_min": 3,
      "heat": "中火",
      "tip": "面在汤里煮，能吸足鲜味，比过水面好吃。",
      "visual_cue": "面条软滑，汤色清亮"
    },
    {
      "n": 8,
      "text": "盛入大碗后撒上葱段，连汤带面一起端上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "先盛面再浇汤，面条才不会坨在一起。",
      "visual_cue": "汤没面条，笋片浮在面上"
    }
  ],
  "tips": [
    "雪菜要挤干再煸，汤才不酸不浑。",
    "面条煮到八分熟，留余地在汤里回煮。",
    "笋片和雪菜要先煸香，汤头才鲜。"
  ],
  "common_mistakes": [
    "雪菜不挤水直接下锅，汤又酸又浑。",
    "肉片炒得太久，回锅后就老得嚼不动。",
    "面条一次煮透再回锅，泡在汤里立刻发胀变糊。"
  ],
  "substitutions": [
    {
      "original": "雪菜",
      "substitute": "腌芥菜",
      "ratio": "100 克:100 克",
      "note": "咸度更高，需减少盐量并多泡一次。"
    },
    {
      "original": "冬笋",
      "substitute": "茭白",
      "ratio": "100 克:120 克",
      "note": "口感更嫩，煮制时间缩短一分钟。"
    }
  ],
  "variations": [
    "加几只河虾同煮，汤头更鲜更清甜。",
    "起锅放一勺猪油，香气更地道也更润。"
  ],
  "serving_suggestion": "趁热连汤吃，先喝一口汤再挑面。",
  "storage": "面条不建议隔夜，汤底可冷藏一天，复热烧滚再下面。",
