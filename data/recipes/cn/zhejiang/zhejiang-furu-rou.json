  "equipment": [
    "砂锅",
    "炒锅",
    "菜刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加姜片和料酒煮十分钟，捞出冲净浮沫切成方块。",
      "time_min": 14,
      "heat": "大火",
      "tip": "冷水下锅血水才出得干净，热水下锅肉会发紧",
      "visual_cue": "肉块焯到紧实，锅里的浮沫撇得干净"
    },
    {
      "n": 2,
      "text": "南乳连汁一起用勺子压成细泥，加生抽和两勺清水调成红亮的酱汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "南乳压得越细，裹在肉块上的颜色越均匀好看",
      "visual_cue": "酱汁红亮顺滑，看不到一点颗粒"
    },
    {
      "n": 3,
      "text": "炒锅放植物油，下冰糖小火炒到融化变枣红色，倒肉块翻炒上色。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖色一冒细泡就下肉，炒过头整锅都会发苦",
      "visual_cue": "肉块均匀挂上糖色，表面油光发亮"
    },
    {
      "n": 4,
      "text": "倒进调好的南乳酱汁翻炒两分钟，让每块肉都裹上酱色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酱汁里含糖很容易糊锅，翻炒要快手不能停顿",
      "visual_cue": "每块肉酱色均匀，厨房里满是酱香"
    },
    {
      "n": 5,
      "text": "把肉块移进砂锅，加清水没过肉面，放葱结、姜片和蒜，大火烧开转小火焖七十分钟。",
      "time_min": 72,
      "heat": "小火",
      "tip": "水面保持微微冒泡，火一大肉就炖得发柴发硬",
      "visual_cue": "汤汁收浓，肉皮已经起了细皱"
    },
    {
      "n": 6,
      "text": "焖到筷子能轻松插透肉皮，开盖中火收汁五分钟，汤汁挂勺即可关火。",
      "time_min": 7,
      "heat": "中火",
      "tip": "收汁时不断把汤汁淋在肉块上，成品颜色才红亮",
      "visual_cue": "汤汁挂住肉块，颜色红亮又油润"
    }
  ],
  "tips": [
    "五花肉选肥瘦三层分明的，太瘦炖出来发柴，太肥一锅油。",
    "南乳本身很咸，生抽只用来提鲜，量不要超过二十毫升。",
    "想肉皮更糯，焖的时间可以加到九十分钟，但要保持小火。"
  ],
  "common_mistakes": [
    "肉不焯水直接炖，汤里带血沫，腥气压不住，颜色也发暗。",
    "糖色炒到发黑才下肉，整锅带焦苦味，只能重新做。",
    "大火焖煮收汁，肉皮紧缩发硬，肥肉出油，吃着腻口。"
  ],
  "substitutions": [
    {
      "original": "南乳",
      "substitute": "红腐乳",
      "ratio": "60克:60克",
      "note": "红腐乳颜色更深，冰糖可减到二十克。"
    },
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "700克:700克",
      "note": "前腿肉瘦一些，焖的时间减到五十分钟。"
    }
  ],
  "variations": [
    "加两片山楂干同炖，肉更容易软烂，油腻感也轻一点。",
    "把南乳换成腐乳汁加一小勺玫瑰露酒，香气更雅，适合待客。"
  ],
  "serving_suggestion": "砂锅端上桌，配白米饭和一份清炒时蔬，汤汁拌饭是这道菜的精华。",
  "storage": "冷藏可放三天，回热时加少量清水小火焖热，汤汁会重新变稠。",
