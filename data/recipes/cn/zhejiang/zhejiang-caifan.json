          "name_en": "water",
          "amount": 330,
          "unit": "ml",
          "note": "煮饭",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 10,
          "unit": "ml",
          "note": "去腥",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "电饭锅",
    "炒锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后沥干，静置十分钟让米粒吸足表面水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "米先沥干再下水煮，饭粒才不软塌发黏。",
      "visual_cue": "米粒干爽松散，不粘手"
    },
    {
      "n": 2,
      "text": "咸肉切小丁，香肠切薄片，用黄酒抓匀去腥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "咸肉切小些，煮出来咸味才均匀。",
      "visual_cue": "肉丁大小一致，肥瘦分明"
    },
    {
      "n": 3,
      "text": "青菜洗净后切成碎末，菜梗和菜叶分开放置。",
      "time_min": 5,
      "heat": "无火",
      "tip": "菜梗菜叶分开，下锅时间才好控制。",
      "visual_cue": "菜碎翠绿，摊开不见水"
    },
    {
      "n": 4,
      "text": "炒锅烧热放猪油，下咸肉丁和香肠片煸出油香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "煸出油脂再下菜，饭才香而不觉得腻。",
      "visual_cue": "肉丁透明出油，锅底发亮"
    },
    {
      "n": 5,
      "text": "先下菜梗炒半分钟，再下菜叶炒到刚软即关火。",
      "time_min": 2,
      "heat": "大火",
      "tip": "青菜只炒半熟，靠焖饭的余热熟透。",
      "visual_cue": "菜梗翠绿微软，菜叶塌下"
    },
    {
      "n": 6,
      "text": "大米和清水放入电饭锅，把炒好的肉菜连油一起铺在米上。",
      "time_min": 2,
      "heat": "无火",
      "tip": "菜铺在米上别搅，煮好再拌饭才不烂。",
      "visual_cue": "米面被菜肉盖住，水量刚好"
    },
    {
      "n": 7,
      "text": "按下煮饭键煮到自动跳闸，再焖上十分钟开盖。",
      "time_min": 30,
      "heat": "无火",
      "tip": "跳闸后焖十分钟，米芯才彻底熟透。",
      "visual_cue": "饭面平整，青菜变深绿"
    },
    {
      "n": 8,
      "text": "加盐拌匀，尝过味道再补，盛碗后趁热吃掉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先尝再放盐，咸肉本身已经很咸了。",
      "visual_cue": "饭粒油亮分明，菜肉均匀"
    }
  ],
  "tips": [
    "青菜先炒半熟再焖，颜色和口感都好。",
    "菜肉铺在米上别搅动，米饭才不糊。",
    "跳闸后焖十分钟，米芯才不会夹生。"
  ],
  "common_mistakes": [
    "青菜和米一起煮半小时，出锅发黄发烂。",
    "水量放得太多，最后煮成一锅软烂菜粥。",
    "咸肉不煸直接下锅，饭里全是油腻味。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "腊肠",
      "ratio": "100 克:100 克",
      "note": "甜香更突出，盐可不加。"
    },
    {
      "original": "青菜",
      "substitute": "油菜",
      "ratio": "300 克:300 克",
      "note": "梗更粗，需多炒半分钟再焖。"
    }
  ],
  "variations": [
    "加一把笋丁同煮，口感层次更丰富。",
    "最后淋上一勺葱油，香气更足更诱人。"
  ],
  "serving_suggestion": "趁热盛碗，配一碗清汤或紫菜蛋汤最舒服。",
  "storage": "冷藏一天，复热用蒸锅或微波加少量水，避免干硬。",
