        },
        {
          "name": "腊肠",
          "name_en": "Cantonese sausage",
          "amount": 80,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "猪油",
          "name_en": "lard",
          "amount": 20,
          "unit": "g",
          "note": "增香",
