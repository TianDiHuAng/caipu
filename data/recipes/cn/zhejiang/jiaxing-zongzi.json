        }
      ]
    }
  ],
  "equipment": [
    "大汤锅",
    "剪刀",
    "棉线"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗后清水浸泡 4 小时，捞出沥干 20 分钟，拌入 30ml 生抽、10ml 老抽与 8g 盐。",
      "time_min": 260,
      "heat": "无火",
      "tip": "米要泡到手指一捏就碎，煮出来才糯。",
      "visual_cue": "米粒吸饱水发白、捏之易碎"
    },
    {
      "n": 2,
      "text": "五花肉切 3cm 见方的大块，加 30ml 生抽、10ml 老抽、20g 白糖、30ml 料酒与 5ml 白酒抓匀，冷藏腌 2 小时。",
      "time_min": 130,
      "heat": "无火",
      "tip": "肉块大才经得起久煮，切小了会柴。",
      "visual_cue": "肉块上色均匀、表面黏手"
    },
    {
      "n": 3,
      "text": "粽叶洗净后入沸水煮 5 分钟软化，捞出过凉水，剪去硬梗备用。",
      "time_min": 10,
      "heat": "大火",
      "tip": "煮过的叶子有韧性，包时不裂。",
      "visual_cue": "粽叶柔软发绿、折弯不出白痕"
    },
    {
      "n": 4,
      "text": "取两片粽叶交叠折成漏斗，舀一层糯米放入五花肉块，再盖一层米压实，折叶包成四角形用棉线扎紧。",
      "time_min": 20,
      "heat": "无火",
      "tip": "米只装八分满，煮时膨胀才不撑破。",
      "visual_cue": "粽身饱满四角分明、线绳勒紧不松"
    },
    {
      "n": 5,
      "text": "粽子排入汤锅，加冷水没过 5cm，大火煮开后转小火煮 3 小时，中途补一次热水。",
      "time_min": 190,
      "heat": "小火",
      "tip": "水要一直没过粽子，露头会夹生。",
      "visual_cue": "水面持续小滚、粽叶转为深绿"
    },
    {
      "n": 6,
      "text": "捞出粽子稍晾 10 分钟，剪去棉线剥叶食用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刚出锅太烫易散，晾一会儿更好剥。",
      "visual_cue": "糯米油亮黏连、肉块酥软"
    }
  ],
  "tips": [
    "糯米要泡透而不是久泡，超过 6 小时会发酸。",
    "粽叶先煮再包，折弯不裂也不漏米。",
    "煮粽中途只补热水，加冷水会让米芯回生。"
  ],
  "common_mistakes": [
    "米装太满扎得太紧，煮时粽叶被撑破漏米。",
    "水没没过粽身，露出水面的部分煮成硬心。",
    "肉块切太小又久煮，出锅只剩一堆碎渣。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "前腿肉",
      "ratio": "500g 对 500g",
      "note": "瘦多肥少，口感略干需多加 10ml 生抽。"
    },
    {
      "original": "糯米",
      "substitute": "长糯米",
      "ratio": "800g 对 800g",
      "note": "黏性略低，适合喜欢有嚼劲的口感。"
    }
  ],
  "variations": [
    "蛋黄版：每只粽加半个咸蛋黄，油润更香。",
    "碱水版：米中拌 5g 食用碱，色泽金黄更软糯。"
  ],
  "serving_suggestion": "剥叶后趁热吃，配一碗清汤或豆浆解腻。",
  "storage": "冷藏 3 天，冷冻 1 个月；复热需水煮 20 分钟或蒸 25 分钟。",
