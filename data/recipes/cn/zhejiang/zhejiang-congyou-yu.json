  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去鳃去内脏，用清水冲净腹腔血水，再用厨房纸吸干表面。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腹腔那层黑膜要刮净，腥味大部分藏在那里。",
      "visual_cue": "鱼身干爽，腹腔干净无血"
    },
    {
      "n": 2,
      "text": "在鱼身两面各划三刀，刀口深入一厘米，方便入味与受热。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刀口斜着划，蒸汽能进去，肉熟得均匀。",
      "visual_cue": "刀口整齐，深达骨边"
    },
    {
      "n": 3,
      "text": "用盐与料酒抹遍鱼身内外，塞入姜片，腌十分钟。",
      "time_min": 11,
      "heat": "无火",
      "tip": "腌十分钟足够，久了鱼肉发紧，鲜味也会掉。",
      "visual_cue": "鱼身泛光，姜片塞稳"
    },
    {
      "n": 4,
      "text": "蒸锅加足量水大火烧开，水滚后再把鱼盘放进去。",
      "time_min": 6,
      "heat": "大火",
      "tip": "必须水开上锅，冷水上锅鱼肉会散、腥味重。",
      "visual_cue": "锅盖边缘冒出浓白蒸汽"
    },
    {
      "n": 5,
      "text": "盖盖大火蒸八分钟，关火后焖两分钟再开盖。",
      "time_min": 10,
      "heat": "大火",
      "tip": "七分钟看鱼眼，眼珠凸出就熟，焖两分钟让肉更嫩。",
      "visual_cue": "鱼眼凸白，鱼皮微微鼓起"
    },
    {
      "n": 6,
      "text": "取出鱼盘，倒掉盘中腥水，撒上葱绿与姜丝铺满鱼身。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盘中水一定要倒掉，那是腥味最重的一碗汤。",
      "visual_cue": "鱼身铺满葱丝，盘底干净"
    },
    {
      "n": 7,
      "text": "小碗里把蒸鱼豉油与白糖调匀，沿鱼身边缘淋一圈。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁淋在盘底绕鱼一圈，不要直接浇在葱丝上，香味更清。",
      "visual_cue": "盘底酱汁均匀，呈浅褐色"
    },
    {
      "n": 8,
      "text": "炒锅烧植物油到冒青烟，趁热泼在葱丝与姜丝上激香。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油必须冒烟才泼，温度不够激不出葱香，还带生油味。",
      "visual_cue": "葱丝瞬间塌软，白烟腾起"
    }
  ],
  "tips": [
    "鲈鱼选一斤半左右最合适，太大肉老，太小没肉。",
    "蒸鱼时间按重量算，每五百克约七分钟，别一刀切。",
    "泼油的量要足，四十五毫升才够香，太少只有油味。",
    "蒸鱼豉油偏甜，加一点糖更柔和，不用再加盐。"
  ],
  "common_mistakes": [
    "冷水上锅蒸，鱼肉发柴、腥味重，鲜味全失。",
    "蒸好后不晾直接开盖，鱼皮回缩裂开，卖相难看。",
    "葱丝早铺在鱼上一起蒸，出锅全是黄叶，葱香也没了。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "黄鱼",
      "ratio": "700克:650克",
      "note": "肉质更细，蒸制时间减一分钟。"
    },
    {
      "original": "蒸鱼豉油",
      "substitute": "生抽",
      "ratio": "30毫升:25毫升",
      "note": "咸度更高，盐抹鱼时减一克。"
    }
  ],
  "variations": [
    "葱油里加几粒花椒炸香再泼，麻香更明显。",
    "把鱼换成鲳鱼或桂鱼，同样做法，风味各有不同。"
  ],
  "serving_suggestion": "三人份主菜，配白饭与清炒时蔬，鱼汁拌饭最佳。",
  "storage": "现蒸现吃最好，冷藏一夜后鱼肉发紧，复蒸三分钟即可，不建议冷冻。",
