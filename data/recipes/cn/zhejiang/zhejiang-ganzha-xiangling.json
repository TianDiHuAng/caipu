    "漏勺",
    "厨房纸",
    "刀",
    "蒸锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肉末加料酒、生抽、盐、白糖、白胡椒、姜末与葱末顺一个方向搅上劲。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺着一个方向搅到发黏，肉馅才会抱团不散。",
      "visual_cue": "肉馅黏稠成团，挑起能拉丝"
    },
    {
      "n": 2,
      "text": "豆腐皮用湿布擦软，切成二十厘米见方的片，边角留着补缝。",
      "time_min": 5,
      "heat": "无火",
      "tip": "油皮太干会裂，用湿布盖两分钟就软了。",
      "visual_cue": "皮子柔软有韧性，不见干硬白点"
    },
    {
      "n": 3,
      "text": "把肉馅搓成长条放在皮的一边，卷紧后在接口处抹蛋清粘合。",
      "time_min": 8,
      "heat": "无火",
      "tip": "卷的时候边卷边压紧，中间留空炸完会散。",
      "visual_cue": "卷身紧实均匀，接口平整不翘"
    },
    {
      "n": 4,
      "text": "卷好的响铃切成三厘米长的段，切口朝下摆盘备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刀要快，慢慢锯着切，肉馅才不会被挤出来。",
      "visual_cue": "段长一致，切口平整见肉馅"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧到六成热，下响铃段中火炸到浮起金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温不够皮会吸油发软，六成热下锅最稳。",
      "visual_cue": "段身鼓起浮起，颜色转浅金黄"
    },
    {
      "n": 6,
      "text": "捞出沥油，全部复炸二十秒逼出余油，配椒盐碟上桌。",
      "time_min": 4,
      "heat": "大火",
      "tip": "复炸只用十几秒就够，时间久了肉馅里的汁水会全干。",
      "visual_cue": "外壳脆硬，敲着有响声，不见油光"
    }
  ],
  "tips": [
    "响铃卷好可以冷冻半小时再切，切口更齐整不易散。",
    "炸前把每段表面的干粉拍净，油才清亮不起黑渣。",
    "没有椒盐可用花椒粉与盐现拌，香气比现成的更足。"
  ],
  "common_mistakes": [
    "肉馅没搅上劲直接卷，炸的时候馅从两头漏出来，锅里全是碎末。",
    "油温太低就下锅，响铃吸了半锅油，咬一口满嘴腻。",
    "一次下太多段，油温骤降，炸出来又软又白一点都不脆。"
  ],
  "substitutions": [
    {
      "original": "豆腐皮",
      "substitute": "春卷皮",
      "ratio": "150克:150克",
      "note": "春卷皮更薄，炸的时间缩短到一分钟。"
    },
    {
      "original": "猪肉末",
      "substitute": "虾仁",
      "ratio": "200克:200克",
      "note": "虾仁剁成粗粒，口感更弹。"
    }
  ],
  "variations": [
    "肉馅里加一勺剁碎的香菇，鲜味更足，也是寺庙素斋的常用做法。",
    "炸好后淋一勺糖醋汁，就是糖醋响铃，酸甜口更讨小孩喜欢。"
  ],
  "serving_suggestion": "趁热摆盘，配一小碟椒盐或甜面酱，作为第一道热菜上桌最醒胃。",
  "storage": "炸好的当天吃完最脆，剩下的冷藏后可回锅一百八十度复烤五分钟。",
