    "大碗",
    "炒锅",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "梅干菜用温水泡二十分钟，反复抓洗三次去掉泥沙。",
      "time_min": 22,
      "heat": "无火",
      "tip": "梅干菜根部藏沙最多，要一片片搓洗。",
      "visual_cue": "水由浑浊变清，菜叶松软展开"
    },
    {
      "n": 2,
      "text": "洗净的梅干菜挤干水分，切成半厘米长的小段备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "挤得越干，炒的时候越容易吸油出香。",
      "visual_cue": "菜段松散不粘连，手捏无水"
    },
    {
      "n": 3,
      "text": "五花肉切成一厘米厚的片，冷水下锅加姜片与料酒焯五分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "冷水下锅才能把血水逼出来，热水下锅会锁住腥味。",
      "visual_cue": "水面浮起褐色浮沫，肉片变白"
    },
    {
      "n": 4,
      "text": "肉片捞出用温水冲净浮沫，沥干后加生抽与老抽抓匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "趁热拌酱油更易上色，凉了颜色挂不住。",
      "visual_cue": "肉片表面泛红亮的酱色"
    },
    {
      "n": 5,
      "text": "炒锅小火放花生油，下姜片与干辣椒炒香，倒入梅干菜翻炒。",
      "time_min": 5,
      "heat": "小火",
      "tip": "梅干菜要小火慢炒，火大一下子就焦苦。",
      "visual_cue": "菜叶油亮发黑，闻到浓郁咸香"
    },
    {
      "n": 6,
      "text": "梅干菜里加白糖与少许盐炒匀，盛出一半备用。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖能压住梅干菜的涩，尝起来不该明显发甜。",
      "visual_cue": "菜段松散油润，咸香里带一点回甜"
    },
    {
      "n": 7,
      "text": "大碗底铺一层梅干菜，肉片皮朝下码整齐，再盖上剩下的菜。",
      "time_min": 6,
      "heat": "无火",
      "tip": "肉皮朝下码紧，蒸出的油会往下渗进菜里。",
      "visual_cue": "碗面平整，肉片层层叠压"
    },
    {
      "n": 8,
      "text": "碗口盖保鲜膜或扣一个盘子，上蒸锅大火蒸足九十分钟。",
      "time_min": 90,
      "heat": "大火",
      "tip": "时间不够肉不酥，宁可多蒸也不要少蒸。",
      "visual_cue": "筷子一插就能轻松穿透肉皮"
    },
    {
      "n": 9,
      "text": "取出倒扣进盘中，撒葱结，把碗底的汤汁淋回肉上。",
      "time_min": 4,
      "heat": "无火",
      "tip": "倒扣要趁热，凉了油凝住会粘碗脱不出来。",
      "visual_cue": "肉片完整翻出，酱汁流淌而下"
    }
  ],
  "tips": [
    "梅干菜有咸有淡，泡好后先尝一口再决定加多少盐。",
    "想更酥可以把蒸的时间延长到两小时。",
    "蒸出来的汤汁别倒掉，拌饭特别香。",
    "一次多做几碗冷冻，吃前回蒸四十分钟即可。"
  ],
  "common_mistakes": [
    "梅干菜没洗净就下锅，吃起来满口沙子。",
    "肉没焯水直接蒸，成品带腥味还有浮沫。",
    "蒸的时间太短，肉皮硬得根本咬不动。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "咸肉",
      "ratio": "500克:400克",
      "note": "盐要减掉，咸肉本身带咸。"
    },
    {
      "original": "梅干菜",
      "substitute": "雪菜",
      "ratio": "80克:120克",
      "note": "蒸的时间可缩短到四十分钟。"
    }
  ],
  "variations": [
    "加几片竹笋一起蒸，口感会更清口解腻。",
    "改用小盅分装来蒸，一人一份摆盘更好看。"
  ],
  "serving_suggestion": "趁热扣在盘里上桌，配一碗白米饭，把汤汁连菜一起拌进饭中。",
  "storage": "冷藏三天，冷冻两周，复蒸三十分钟即可恢复软糯。",
