  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉剁成三厘米见方的块，冷水下锅焯水两分钟，捞出冲净血沫。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅才能把血水逼出来，热水下锅肉表立刻收紧。",
      "visual_cue": "水沸腾浮起褐色沫，肉块发白收敛"
    },
    {
      "n": 2,
      "text": "板栗用刀划一小口，下沸水煮五分钟，趁热剥去外壳与里衣。",
      "time_min": 8,
      "heat": "大火",
      "tip": "趁热剥最省力，凉了里衣就黏在肉上撕不掉。",
      "visual_cue": "栗子仁金黄完整，不见残留薄衣"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油下冰糖小火炒到融化变枣红色，倒入鸡块翻炒上色。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖色一变枣红立刻下肉，再等就发苦。",
      "visual_cue": "糖浆起大泡转小泡，鸡块裹上红亮糖色"
    },
    {
      "n": 4,
      "text": "下姜片、八角与葱结煸香，烹入黄酒，加生抽老抽翻匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "黄酒沿锅边烹入，遇热激出的香气才正。",
      "visual_cue": "鸡块裹上均匀的酱色，锅边腾起明显酒气"
    },
    {
      "n": 5,
      "text": "加热水至没过鸡块，放入板栗，大火烧开转小火烧三十分钟。",
      "time_min": 32,
      "heat": "小火",
      "tip": "一定加热水，冷水会让肉质骤缩变柴。",
      "visual_cue": "汤汁微沸，栗子吸汁变深"
    },
    {
      "n": 6,
      "text": "开盖转大火收汁，加盐调味，汤汁浓稠时出锅装盘。",
      "time_min": 5,
      "heat": "大火",
      "tip": "收汁时轻推别翻炒，栗子容易被翻碎。",
      "visual_cue": "酱汁挂在鸡块上，油亮浓稠"
    }
  ],
  "tips": [
    "板栗买现成剥好的真空包装，省事且大小均匀。",
    "加两片山楂干同烧，肉烂得更快，栗子也更糯。",
    "用整只土鸡代替鸡腿肉风味更足，但烧的时间要延长二十分钟。"
  ],
  "common_mistakes": [
    "鸡块焯水用热水下锅，血沫锁在里面，成品腥味重。",
    "糖色炒过头发黑，整锅菜带明显焦苦。",
    "中途加冷水，鸡肉骤缩发紧，怎么烧都不酥烂。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "500克:500克",
      "note": "鸡翅胶质多，烧的时间可减五分钟。"
    },
    {
      "original": "板栗",
      "substitute": "芋头",
      "ratio": "150克:200克",
      "note": "芋头易碎，须最后十五分钟再下。"
    }
  ],
  "variations": [
    "加一把干香菇同烧，菌香与栗香交织，汤汁更浓。",
    "改用砂锅小火慢煨一小时，肉更酥，适合冬天吃。"
  ],
  "serving_suggestion": "连汁一起上桌，浇在米饭上是最经典的吃法，也可配馒头。",
  "storage": "冷藏可存两天，复热须小火加两勺水慢烧，栗子才不会碎。",
