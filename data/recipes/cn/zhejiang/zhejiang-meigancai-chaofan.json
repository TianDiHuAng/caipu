  "equipment": [
    "炒锅",
    "锅铲",
    "大碗",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "梅干菜温水泡十五分钟，反复抓洗到没有沙子，挤干切碎。",
      "time_min": 18,
      "heat": "无火",
      "tip": "切得越碎，炒饭时越能均匀挂在米粒上。",
      "visual_cue": "菜碎干燥松散，没有结块"
    },
    {
      "n": 2,
      "text": "冷饭用手充分抓散，把结块的米粒全部搓开弄松。",
      "time_min": 4,
      "heat": "无火",
      "tip": "饭粒不散开，炒的时候怎么翻都是坨。",
      "visual_cue": "米粒颗颗分开，碗里没有硬结"
    },
    {
      "n": 3,
      "text": "鸡蛋磕入碗中彻底打散，加一小撮盐搅匀备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蛋液打得越均匀，炒出来的蛋花越细。",
      "visual_cue": "蛋液颜色一致，表面有小气泡"
    },
    {
      "n": 4,
      "text": "炒锅大火烧热放花生油，倒入蛋液快速划散成小块盛出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油要烧够热，蛋下锅立刻膨起才够香。",
      "visual_cue": "蛋块蓬松金黄，盛出时不出水"
    },
    {
      "n": 5,
      "text": "锅里补少许花生油，下梅干菜小火炒两分钟炒出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "梅干菜必须炒透，生味会盖掉米饭的香。",
      "visual_cue": "菜碎油亮发黑，咸香明显"
    },
    {
      "n": 6,
      "text": "下火腿丁炒香，倒入米饭改大火不停翻炒三分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "用铲子压散再翻，让每粒米都沾到油。",
      "visual_cue": "米粒跳动弹起，锅里有噼啪声"
    },
    {
      "n": 7,
      "text": "把蛋块倒回锅中，淋生抽、撒白糖，翻炒到颜色均匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "生抽沿锅边淋，遇热才出酱香不返潮。",
      "visual_cue": "米粒呈浅褐色，颗颗油亮"
    },
    {
      "n": 8,
      "text": "尝味后按需补一点盐，撒上葱花翻两下立刻起锅装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱花最后放，翻两下就够，久炒发黄。",
      "visual_cue": "绿色葱花点缀其间，香气冲上来"
    }
  ],
  "tips": [
    "梅干菜本身带咸，生抽与盐都要减量。",
    "没有隔夜饭可以把新饭摊开吹凉半小时。",
    "加一勺猪油替代部分花生油，香味更足。",
    "火腿可换成咸肉丁，风味更咸鲜。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭来炒，饭粒会黏成一团。",
    "梅干菜没炒透就下饭，吃起来一股生涩味。",
    "全程用小火慢慢翻，饭越炒越湿越黏。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "40克:40克",
      "note": "咸味更重，盐可以完全不放。"
    },
    {
      "original": "鸡蛋",
      "substitute": "豆腐干",
      "ratio": "100克:100克",
      "note": "纯素版本，需多加一点油。"
    }
  ],
  "variations": [
    "加一勺辣椒酱一起炒，做成微辣的版本。",
    "起锅之前淋上几滴香油，香气更收口。"
  ],
  "serving_suggestion": "盛入碗中压实再扣出，配一碗紫菜汤或清茶，就是一顿利落的家常饭。",
  "storage": "现炒现吃，冷藏一天复热需用炒锅大火翻炒，微波会返潮。",
