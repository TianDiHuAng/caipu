  "steps": [
    {
      "n": 1,
      "text": "排骨斩成三厘米小段，冷水下锅加姜片焯三分钟，捞出冲净沥干。",
      "time_min": 10,
      "heat": "中火",
      "tip": "排骨切小一点才能和米饭同时熟透。",
      "visual_cue": "排骨无血水，块块干净利落"
    },
    {
      "n": 2,
      "text": "大米淘洗三遍至水变清，沥干后静置十分钟让米粒吸足表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "米洗好沥干静置，煮出来才粒粒分明。",
      "visual_cue": "米粒洁白松散，锅底无积水"
    },
    {
      "n": 3,
      "text": "炒锅下植物油中火，排骨煎到两面微黄，加生抽、老抽、绍兴酒、盐与白砂糖炒匀。",
      "time_min": 8,
      "heat": "中火",
      "tip": "排骨先煎香再焖，饭才带肉香不腥。",
      "visual_cue": "排骨裹满酱色，锅底红亮"
    },
    {
      "n": 4,
      "text": "下胡萝卜丁与香菇丁翻炒两分钟，连排骨带汁一起倒进装米的锅里。",
      "time_min": 4,
      "heat": "中火",
      "tip": "炒出的酱汁全部倒进去，饭才有味道。",
      "visual_cue": "配料铺在米上，酱汁渗进米层"
    },
    {
      "n": 5,
      "text": "加清水到没过所有食材一指，大火煮开转小火焖十八分钟，关火再焖八分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "关火焖八分钟，米芯才彻底熟透不夹生。",
      "visual_cue": "饭粒饱满油亮，锅边有薄锅巴"
    },
    {
      "n": 6,
      "text": "开盖撒葱花，用木勺从底部翻松拌匀，盛碗即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "翻松这一步让酱汁分布均匀，口感更好。",
      "visual_cue": "米饭松散不粘，排骨酱红油亮"
    }
  ],
  "tips": [
    "排骨切小段是焖饭的关键，太大块饭熟了肉还硬。",
    "水量比平时煮饭略少一点，排骨和菜会出水。",
    "关火焖八分钟，米芯才彻底熟透。",
    "用厚底锅焖，锅底那层锅巴是最好吃的部分。"
  ],
  "common_mistakes": [
    "排骨切太大块，饭熟了肉还是生的。",
    "水放太多，焖出来一锅稠粥不像饭。",
    "不焖直接开盖，米芯夹生还带硬粒。",
    "排骨不煎直接焖，饭带着明显腥味。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "五花肉",
      "ratio": "400克:350克",
      "note": "油脂更多，水量减二十毫升。"
    },
    {
      "original": "胡萝卜",
      "substitute": "山药",
      "ratio": "80克:80克",
      "note": "口感更粉，切丁要小而均匀。"
    }
  ],
  "variations": [
    "加一把剥好的毛豆同焖，颜色和口感更丰富。",
    "放两片腊肠一起焖，油脂渗进米饭，咸香比单放排骨更浓。",
    "出锅前淋一小勺猪油拌匀，香气立刻提升。"
  ],
  "serving_suggestion": "盛进碗里撒葱花，配一碗青菜汤，排骨和饭一起吃到碗底，是浙江人家最省事的午饭。",
  "storage": "冷藏可放一天，复热加一小勺水盖盖小火焖五分钟，口感接近现煮。",
