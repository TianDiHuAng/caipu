  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉洗净用厨房纸擦干，表面薄薄抹一层盐腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "只抹薄盐即可，后面醉卤里还有咸味。",
      "visual_cue": "鸡皮干爽，表面泛细盐粒"
    },
    {
      "n": 2,
      "text": "汤锅加水放姜片、葱结与八角，水开后下鸡腿煮十二分钟。",
      "time_min": 15,
      "heat": "中火",
      "tip": "水面保持小滚，滚太猛鸡皮会破、肉会柴。",
      "visual_cue": "鸡皮收紧发亮，筷子插入无血水"
    },
    {
      "n": 3,
      "text": "捞出鸡腿立刻浸入冰水，泡到完全凉透让鸡皮收紧。",
      "time_min": 15,
      "heat": "无火",
      "tip": "冰水这步决定皮脆不脆，别图省事自然放凉。",
      "visual_cue": "鸡皮紧实发亮，按压有弹性"
    },
    {
      "n": 4,
      "text": "料酒加冰糖和少许盐小火加热到糖化，放凉成醉卤备用。",
      "time_min": 5,
      "heat": "小火",
      "tip": "卤汁一定放凉再泡鸡，热泡肉会变老。",
      "visual_cue": "卤汁清亮，尝着咸鲜带酒香"
    },
    {
      "n": 5,
      "text": "鸡腿切成一厘米厚的块，码进保鲜盒倒入醉卤没过鸡肉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "鸡肉必须完全浸没，露在外面的部分会变味。",
      "visual_cue": "鸡块整齐码放，卤汁高过肉面"
    },
    {
      "n": 6,
      "text": "密封冷藏六小时以上，取出摆盘撒枸杞即可上桌。",
      "time_min": 350,
      "heat": "无火",
      "tip": "醉足六小时才入味，冷藏过夜风味最好。",
      "visual_cue": "鸡肉泛酒香，切面湿润有光泽"
    }
  ],
  "tips": [
    "用花雕酒代替普通料酒，香气更足，但须相应减少冰糖用量。",
    "醉卤可以重复用一次，第二次泡时加一勺新酒补香。",
    "鸡肉煮好后先用重物压半小时再切，切面更平整好看。"
  ],
  "common_mistakes": [
    "鸡腿煮过头再浸冰水，肉已经发柴，泡多久都救不回来。",
    "醉卤没放凉就倒进去，鸡肉外层熟透内层变硬，酒味也发苦。",
    "冷藏时间不够就切，鸡肉中心还是白的，完全没入味。"
  ],
  "substitutions": [
    {
      "original": "料酒",
      "substitute": "花雕酒",
      "ratio": "300毫升:280毫升",
      "note": "花雕更香，冰糖减到六克。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600克:600克",
      "note": "鸡胸更瘦，煮的时间缩到八分钟。"
    }
  ],
  "variations": [
    "醉卤里加两片话梅，酸甜味更明显，是江南夏天的常见做法。",
    "把鸡换成河虾或毛豆，用同一锅醉卤泡出来，就是一桌醉味拼盘。"
  ],
  "serving_suggestion": "切块冷盘上桌，作为开席第一道冷菜，配一小杯黄酒最对味。",
  "storage": "连卤冷藏可存三天，取食须用干净筷子，卤汁可留用一次。",
