    "碗",
    "平底锅",
    "擀面杖",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "南瓜去皮去籽切薄片，上蒸锅大火蒸十五分钟至软烂。",
      "time_min": 18,
      "heat": "大火",
      "tip": "南瓜切薄片蒸得更快，压泥也更细腻。",
      "visual_cue": "南瓜片一压就烂，筷子轻松穿透"
    },
    {
      "n": 2,
      "text": "蒸好的南瓜趁热压成泥，加白砂糖搅匀，放至不烫手。",
      "time_min": 8,
      "heat": "无火",
      "tip": "糖要趁热加才化得开，太烫会烫坏糯米粉。",
      "visual_cue": "南瓜泥细腻顺滑，甜香扑鼻"
    },
    {
      "n": 3,
      "text": "分次加入糯米粉揉成不粘手的面团，软硬像耳垂。",
      "time_min": 10,
      "heat": "无火",
      "tip": "糯米粉分次加，面团太软就补粉，太硬加点水。",
      "visual_cue": "面团光滑不粘手，按压有弹性"
    },
    {
      "n": 4,
      "text": "面团分成十二份，包入红豆沙收口压成圆饼，两面沾上白芝麻。",
      "time_min": 15,
      "heat": "无火",
      "tip": "饼别压太薄，煎的时候豆沙容易漏出来。",
      "visual_cue": "饼坯圆整厚薄一致，芝麻沾匀"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油烧到五成热，南瓜饼下锅小火煎四分钟至两面金黄。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火慢煎才透，大火外面焦里面还是生的。",
      "visual_cue": "两面金黄微鼓，芝麻香气冒出"
    }
  ],
  "tips": [
    "南瓜蒸好后要放凉再揉面，太烫会把糯米粉烫成疙瘩。",
    "糯米粉分次加，边揉边看状态比一次倒完更准。",
    "小火慢煎，厚饼才煎得透而不焦。",
    "趁热吃外脆内糯，凉了会变硬，复煎一下就恢复。"
  ],
  "common_mistakes": [
    "南瓜泥太烫就倒糯米粉，面团结块揉不匀。",
    "饼压得太薄，豆沙一煎就漏出来，锅里全是黑糊的糖色。",
    "大火煎，外面已经焦黑，里面还是带着生粉味的硬芯。",
    "面团太软没及时补粉，饼煎完塌成扁片。"
  ],
  "substitutions": [
    {
      "original": "红豆沙",
      "substitute": "黑芝麻馅",
      "ratio": "150克:150克",
      "note": "香气更浓，甜度更低。"
    },
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "500克:500克",
      "note": "水分更少，糯米粉可减二十克。"
    }
  ],
  "variations": [
    "面团里加一小勺桂花糖，香气更江南。",
    "表面裹一层面包糠再煎，外壳更酥，咬下去有咔哧的响声。",
    "做成小圆球油炸，外脆里糯更像点心。"
  ],
  "serving_suggestion": "煎好的南瓜饼摆盘，趁热吃最香，配一壶绿茶解甜，作为早饭或下午茶点心都合适。",
  "storage": "常温可放一天，冷藏两天，复热用平底锅小火两面各煎一分钟。",
