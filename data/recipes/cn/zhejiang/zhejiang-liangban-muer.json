  "steps": [
    {
      "n": 1,
      "text": "木耳放进冷水里泡发两小时，中途换一次清水。",
      "time_min": 62,
      "heat": "无火",
      "tip": "冷水泡的木耳才脆，热水泡会发软。，看准状态再往下做。",
      "visual_cue": "木耳舒展，厚度均匀"
    },
    {
      "n": 2,
      "text": "泡好的木耳剪去根部硬蒂，用手撕成均匀的小朵。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根蒂带沙，不剪吃着咯牙。，看准状态再往下做。",
      "visual_cue": "朵形完整，无硬根，这一点很关键。"
    },
    {
      "n": 3,
      "text": "汤锅烧开水，下木耳焯两分钟捞出。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "焯水杀菌，也能去掉土腥味。，看准状态再往下做。",
      "visual_cue": "木耳卷起，颜色发亮"
    },
    {
      "n": 4,
      "text": "立刻放进冰水里过凉，捞出沥干水分。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过凉水木耳才脆，口感差别很大。，看准状态再往下做。",
      "visual_cue": "木耳爽脆，水沥得干"
    },
    {
      "n": 5,
      "text": "大蒜剁末，小米辣切圈，香菜切段备用。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜末剁细，味道才融进汁里。，看准状态再往下做。",
      "visual_cue": "末粒均匀，香辛扑鼻"
    },
    {
      "n": 6,
      "text": "大碗放生抽、香醋、白糖和盐搅匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要化开，酸甜才平衡。，看准状态再往下做。",
      "visual_cue": "汁色清亮，糖粒消失"
    },
    {
      "n": 7,
      "text": "倒入木耳、蒜末和辣椒圈，抓拌均匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用手抓拌，木耳更容易入味。，看准状态再往下做。",
      "visual_cue": "木耳裹汁，油光发亮"
    },
    {
      "n": 8,
      "text": "淋香油，撒香菜段，冷藏十分钟再吃。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏一下更入味，口感也更脆。，看准状态再往下做。",
      "visual_cue": "香菜翠绿，汁水清亮"
    }
  ],
  "tips": [
    "木耳必须用冷水泡发，口感才脆。，这一点很关键。",
    "焯水后立刻过冰水，脆度差别明显。",
    "泡发时间不超过四小时，避免变质。"
  ],
  "common_mistakes": [
    "热水泡木耳，泡出来软塌没嚼头。，这一点很关键。",
    "根部不剪，吃着满口沙。，这一点很关键。",
    "提前几小时拌好，出水变淡。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "干木耳",
      "substitute": "银耳",
      "ratio": "40 克:40 克",
      "note": "泡发时间更短，口感更糯。"
    },
    {
      "original": "香醋",
      "substitute": "陈醋",
      "ratio": "20 毫升:18 毫升",
      "note": "颜色深，酸味更厚。"
    }
  ],
  "variations": [
    "加一把花生米，口感更丰富。，这一点很关键。",
    "放几片黄瓜，清爽度提升。，这一点很关键。"
  ],
  "serving_suggestion": "作为开胃凉菜，配粥或下酒。，这一点很关键。",
  "storage": "冷藏一天，隔夜会出水，吃前倒掉汤汁。",
