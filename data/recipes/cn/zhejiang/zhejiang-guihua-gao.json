          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "方形模具",
    "筛网",
    "大碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉和粘米粉混匀，过筛两遍。，看准状态再往下走。",
      "time_min": 7,
      "heat": "无火",
      "tip": "筛过两遍，糕体才细腻不结块。，这一点别省。",
      "visual_cue": "粉质蓬松，无颗粒，这一点很关键。"
    },
    {
      "n": 2,
      "text": "白糖加清水搅到完全化开成糖水。，看准状态再往下走。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖要化净，不然蒸好有斑点。，这一点别省。",
      "visual_cue": "水澄清，无糖粒，这一点很关键。"
    },
    {
      "n": 3,
      "text": "糖水分次倒进粉里，边倒边搓成粗粒。，看准状态再往下走。",
      "time_min": 8,
      "heat": "无火",
      "tip": "搓到能捏成团、一按就散。，这一点别省。",
      "visual_cue": "粉粒松散，手握成团"
    },
    {
      "n": 4,
      "text": "拌入一半糖桂花，轻轻翻匀。，看准状态再往下走。",
      "time_min": 3,
      "heat": "无火",
      "tip": "桂花别揉，会失去花瓣形状。，这一点别省。",
      "visual_cue": "花香散出，粉粒带黄"
    },
    {
      "n": 5,
      "text": "模具刷一层植物油，把粉筛进去铺平。，看准状态再往下走。",
      "time_min": 6,
      "heat": "无火",
      "tip": "筛进去更松，蒸好才起层。，这一点别省。",
      "visual_cue": "粉面平整，厚薄一致"
    },
    {
      "n": 6,
      "text": "表面摆红枣片，撒上剩余糖桂花。，看准状态再往下走。",
      "time_min": 3,
      "heat": "无火",
      "tip": "轻按一下，蒸好才不掉。，这一点别省。",
      "visual_cue": "枣片齐整，花色分明"
    },
    {
      "n": 7,
      "text": "水开后上锅，大火蒸三十五分钟。，看准状态再往下走。",
      "time_min": 37,
      "heat": "大火",
      "tip": "锅盖留缝，水汽才不滴落。，这一点别省。",
      "visual_cue": "糕体鼓起，竹签不粘"
    },
    {
      "n": 8,
      "text": "取出晾到温热，脱模切成方块。，看准状态再往下走。",
      "time_min": 14,
      "heat": "无火",
      "tip": "凉透再切，刀口才利落。，这一点别省。",
      "visual_cue": "块形方正，切面细腻"
    }
  ],
  "tips": [
    "粉要过筛两遍，糕体才细腻。，这一点很关键。",
    "糖水少量多次加，粉才搓得松。，这一点很关键。",
    "锅盖留缝蒸，表面才不起水泡。，这一点很关键。"
  ],
  "common_mistakes": [
    "水一次倒太多，粉结成团蒸不熟。，这一点很关键。",
    "火太猛盖子盖死，水汽滴成坑。，这一点很关键。",
    "热的时候切，糕体全塌下来。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "粘米粉",
      "substitute": "澄面",
      "ratio": "100 克:90 克",
      "note": "更透亮，口感偏弹。"
    },
    {
      "original": "糖桂花",
      "substitute": "干桂花加蜂蜜",
      "ratio": "40 克:10 克桂花配 30 克蜂蜜",
      "note": "香气更清，甜度略低。"
    }
  ],
  "variations": [
    "中间夹一层豆沙，层次更丰富。，这一点很关键。",
    "换成玫瑰酱，做成玫瑰糕。，这一点很关键。"
  ],
  "serving_suggestion": "切块装盘，配清茶当茶点。，这一点很关键。",
  "storage": "冷藏三天，冷藏后会变硬，复热蒸五分钟。",
