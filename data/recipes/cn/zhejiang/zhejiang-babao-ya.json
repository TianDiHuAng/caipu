  "equipment": [
    "蒸锅",
    "炒锅",
    "深盘",
    "刀",
    "砧板",
    "棉线"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸭里外冲洗干净，用黄酒与少许盐抹遍内外，腌二十分钟去腥。",
      "time_min": 20,
      "heat": "无火",
      "tip": "鸭腹腔里的血水一定要冲净，腥味八成来自这里。",
      "visual_cue": "鸭皮干爽，腹腔不见血水残留"
    },
    {
      "n": 2,
      "text": "糯米与薏米泡软，莲子去芯，香菇、冬笋、火腿、虾仁分别切小丁。",
      "time_min": 15,
      "heat": "无火",
      "tip": "所有填料切得一样大，蒸出来口感才统一。",
      "visual_cue": "各料丁粒大小一致，糯米发白发涨"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油下姜片爆香，倒入全部填料丁翻炒，加生抽与盐调味。",
      "time_min": 8,
      "heat": "中火",
      "tip": "馅料先炒到半熟，蒸的时候才不会夹生。",
      "visual_cue": "馅料油亮散香，颗粒分明不粘锅"
    },
    {
      "n": 4,
      "text": "把炒好的馅料塞进鸭腹，装到七分满，用棉线缝合开口。",
      "time_min": 15,
      "heat": "无火",
      "tip": "只装七分满，米受热会膨胀，塞满会撑破鸭皮。",
      "visual_cue": "鸭腹鼓起但皮不绷，缝口紧实"
    },
    {
      "n": 5,
      "text": "鸭身抹一层老抽上色，淋上植物油，放入深盘加姜葱与八角。",
      "time_min": 8,
      "heat": "无火",
      "tip": "老抽抹薄薄一层就够，厚了成品发黑。",
      "visual_cue": "鸭皮酱红均匀，油光亮泽"
    },
    {
      "n": 6,
      "text": "上汽后中火蒸一小时四十分钟，中途翻面一次并淋一遍盘中汤汁。",
      "time_min": 100,
      "heat": "中火",
      "tip": "中途淋汁能让皮色均匀，别开盖太勤跑掉蒸汽。",
      "visual_cue": "鸭身鼓胀，筷子能轻松穿透腿部"
    },
    {
      "n": 7,
      "text": "取出装盘，盘中原汁倒入锅中加冰糖收稠，浇在鸭身上即可。",
      "time_min": 8,
      "heat": "中火",
      "tip": "原汁本身够咸鲜，收汁只需加冰糖提亮。",
      "visual_cue": "酱汁稠亮挂勺，浇下能铺满鸭身"
    }
  ],
  "tips": [
    "买鸭选三斤左右的老鸭，肉紧味厚，比嫩鸭经得起久蒸。",
    "填料可提前一晚炒好冷藏，第二天上锅前再塞，省半小时。",
    "没有棉线可用牙签封口，蒸好后取出即可，不影响卖相。"
  ],
  "common_mistakes": [
    "馅料塞得太满，蒸时米粒膨胀把鸭皮撑裂，卖相全毁。",
    "蒸的时间不够，鸭腿根部发红带血，咬不动也不安全。",
    "老抽抹太多又淋汁，成品发黑发苦，看不出鸭皮本色。"
  ],
  "substitutions": [
    {
      "original": "糯米",
      "substitute": "大米",
      "ratio": "100克:100克",
      "note": "大米吸水性差，须减少两成水量。"
    },
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "40克:45克",
      "note": "咸肉更咸，盐量减半。"
    }
  ],
  "variations": [
    "把鸭换成童子鸡，蒸的时间减到七十分钟，就是八宝鸡。",
    "填料里加几粒栗子与干贝，更显丰盛，是宴席上的升级做法。"
  ],
  "serving_suggestion": "整只上桌当面拆开，用勺连馅带汁分食，作为宴席主菜最气派。",
  "storage": "冷藏可存两天，复热须上锅蒸二十分钟，微波会令鸭皮发韧。",
