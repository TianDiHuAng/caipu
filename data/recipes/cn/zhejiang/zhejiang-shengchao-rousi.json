  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊顺纹理切成细丝，粗细尽量一致。，看准状态再往下做。",
      "time_min": 9,
      "heat": "无火",
      "tip": "粗细一致，受热才均匀。，看准状态再往下做。",
      "visual_cue": "丝条均匀，断面光滑"
    },
    {
      "n": 2,
      "text": "肉丝加盐、料酒和淀粉抓匀，腌十分钟上浆。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "上浆锁水，炒出来才嫩。，看准状态再往下做。",
      "visual_cue": "肉丝发黏，表面浆亮"
    },
    {
      "n": 3,
      "text": "冬笋切细丝，放开水里焯一分钟去涩。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "笋不焯会带涩味，压住肉的鲜。，看准状态再往下做。",
      "visual_cue": "笋丝发白，涩味减轻"
    },
    {
      "n": 4,
      "text": "韭黄洗净切段，白段和绿段分开放。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "分开下锅，绿段才不会炒烂。，看准状态再往下做。",
      "visual_cue": "段长均匀，颜色分明"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧到五成热，下肉丝快速划散。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油温太高肉丝会粘成团。，看准状态再往下做。",
      "visual_cue": "肉丝根根分开，颜色转白"
    },
    {
      "n": 6,
      "text": "下笋丝同炒一分钟，让笋吸收肉香。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "笋丝先下，韧性才适口。，看准状态再往下做。",
      "visual_cue": "笋丝泛油，锅气足，这一点很关键。"
    },
    {
      "n": 7,
      "text": "加生抽翻匀，先下韭黄白段炒几下。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "白段耐炒，先下锅。，看准状态再往下做。",
      "visual_cue": "肉丝裹酱色，笋丝透亮"
    },
    {
      "n": 8,
      "text": "下韭黄绿段，淋香油翻两下立刻出锅。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "绿段断生就好，炒软就发黄。，看准状态再往下做。",
      "visual_cue": "韭黄翠绿，香气冲鼻"
    }
  ],
  "tips": [
    "肉丝上浆后静置十分钟，炒出来才嫩滑。",
    "冬笋要焯水去涩，不然整盘带麻嘴感。",
    "韭黄绿段最后十秒下锅，脆嫩才保得住。"
  ],
  "common_mistakes": [
    "肉丝没上浆，炒出来干柴。，这一点很关键。",
    "火不够大，肉丝出水变成煮肉丝。，这一点很关键。",
    "韭黄一起下锅，全炒成黄软条。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "猪后腿肉",
      "ratio": "350 克:350 克",
      "note": "纤维更粗，切丝要更细。"
    },
    {
      "original": "冬笋",
      "substitute": "茭白",
      "ratio": "150 克:180 克",
      "note": "不用焯，口感更嫩。"
    }
  ],
  "variations": [
    "加几片雪菜，咸鲜更下饭。，这一点很关键。",
    "放一勺糟卤，酒香更足。，这一点很关键。"
  ],
  "serving_suggestion": "配白米饭，趁热吃最嫩。，这一点很关键。",
  "storage": "冷藏一天，复热炒锅快炒。，这一点很关键。",
