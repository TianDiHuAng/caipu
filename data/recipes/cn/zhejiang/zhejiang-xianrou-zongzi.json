    "大锅",
    "棉线",
    "菜刀",
    "大盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗两遍后加清水浸泡四小时，泡到糯米粒一捻就碎，捞出沥干。",
      "time_min": 245,
      "heat": "无火",
      "tip": "天热时放冰箱冷藏泡，中途换一次水防止发酸",
      "visual_cue": "糯米泡到饱胀，手指一捻就碎"
    },
    {
      "n": 2,
      "text": "干粽叶放开水里煮五分钟，捞出用冷水冲净，剪去硬梗和破损的边。",
      "time_min": 10,
      "heat": "大火",
      "tip": "煮过的粽叶变软不容易裂，包的时候更听话",
      "visual_cue": "叶片煮得柔软，颜色由青绿转为深褐"
    },
    {
      "n": 3,
      "text": "咸肉切成一厘米见方的小块，加生抽和白糖抓匀，腌十分钟入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉块一定要带一点肥的，煮出来的糯米才够香",
      "visual_cue": "肉块大小均匀，表面泛着油光"
    },
    {
      "n": 4,
      "text": "沥干的糯米加生抽、老抽和盐拌匀，静置十分钟让糯米粒上色。",
      "time_min": 11,
      "heat": "无火",
      "tip": "拌好的糯米要马上包，放久了出水会浸湿粽叶",
      "visual_cue": "糯米粒粒挂上酱色，颜色棕红"
    },
    {
      "n": 5,
      "text": "取两张粽叶交叠折成漏斗，填一层米放两块咸肉再盖一层米，包紧后用棉线扎牢。",
      "time_min": 25,
      "heat": "无火",
      "tip": "米只装七分满，煮的时候糯米膨胀才不会撑破",
      "visual_cue": "粽身包得紧实，四个角都不漏米"
    },
    {
      "n": 6,
      "text": "粽子摆进大锅，加清水没过粽子三厘米，大火烧开转小火煮两小时。",
      "time_min": 130,
      "heat": "小火",
      "tip": "锅里的水要一直盖过粽子，中途添水也要用热水",
      "visual_cue": "粽叶颜色转深，满屋飘着糯米香"
    }
  ],
  "tips": [
    "圆糯米黏性最好，长糯米偏硬，包咸粽用圆糯米更合口味。",
    "咸肉别切太大，否则一块咬下去咸得齁，米也没有肉香。",
    "煮粽子的水要一次加够，中途开盖加水会让粽子夹生。"
  ],
  "common_mistakes": [
    "米泡的时间不够就直接包，煮两小时里面还是硬芯，吃着硌牙。",
    "粽叶不煮就用，包的时候一折就裂，下锅漏米，汤变浑浊。",
    "棉线扎得太松，粽子在锅里散开，最后煮成一锅咸粥。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "腊肉",
      "ratio": "200克:200克",
      "note": "腊肉先蒸十五分钟再切，咸度更高需减盐。"
    },
    {
      "original": "糯米",
      "substitute": "紫糯米",
      "ratio": "500克:500克",
      "note": "紫糯米需多泡一小时，煮的时间加二十分钟。"
    }
  ],
  "variations": [
    "加一颗咸蛋黄包进去，就是江南人爱吃的双拼咸粽。",
    "米里拌一勺猪油再包，煮出来的粽子油润发亮，香气更足。"
  ],
  "serving_suggestion": "趁热剥开粽叶直接吃，配一碟醋或者一杯热茶，端午和日常都合适。",
  "storage": "冷藏可放三天，冷冻可放一个月，回热时冷水下锅煮二十分钟或蒸十五分钟。",
