  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 200,
          "unit": "g",
          "note": "搓小圆子",
          "optional": false
        },
        {
          "name": "米酒",
          "name_en": "rice wine",
          "amount": 200,
          "unit": "ml",
          "note": "自酿甜酒酿",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 50,
          "unit": "g",
          "note": "打散",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 30,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 800,
          "unit": "ml",
          "note": "煮圆子用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉加一百五十毫升清水揉成光滑面团，搓成小指头大小的圆子。",
      "time_min": 15,
      "heat": "无火",
      "tip": "面团偏硬一点，圆子煮了才不塌。",
      "visual_cue": "面团光滑、不粘手也不裂"
    },
    {
      "n": 2,
      "text": "锅中加清水烧开，下小圆子煮到全部浮起，中途轻推防粘。",
      "time_min": 5,
      "heat": "大火",
      "tip": "浮起后再煮一分钟才透心。",
      "visual_cue": "圆子浮在水面、体积略胀"
    },
    {
      "n": 3,
      "text": "倒入米酒与白糖，小火煮两分钟，边搅边淋入打散的蛋液。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蛋液要细流淋入，蛋花才散得开。",
      "visual_cue": "蛋花成细丝、汤面泛起酒香"
    },
    {
      "n": 4,
      "text": "关火静置一分钟收味，盛入碗中趁热食用，圆子软糯不烂。",
      "time_min": 2,
      "heat": "无火",
      "tip": "米酒久煮会发酸，关火要果断。",
      "visual_cue": "汤汁清亮、圆子软糯"
    }
  ],
  "tips": [
    "圆子搓小一点，煮得快也更入味。",
    "米酒下锅后不要大开，滚久了酒香就跑光。",
    "想让汤汁浓稠，可用十克糯米粉调水勾薄芡。"
  ],
  "common_mistakes": [
    "圆子搓得太大，外面糊了里面还是硬心。",
    "米酒煮得太久，酸味压过了甜香。",
    "蛋液一次倒入，蛋花结成大块沉底。"
  ],
  "substitutions": [
    {
      "original": "糯米粉",
      "substitute": "粘米粉",
      "ratio": "200g 对 200g",
      "note": "口感偏硬，适合喜欢有嚼劲的。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "30g 对 35g",
      "note": "甜味更清，需提前敲碎。"
    }
  ],
  "variations": [
    "冬天可以在汤里加两片生姜同煮，暖胃更舒服。",
    "圆子换成现成的小汤圆同法煮，口感更弹。"
  ],
  "serving_suggestion": "趁热盛碗，撒少许干桂花香气更足。",
  "storage": "现煮现吃最好，冷藏后圆子会返硬。",
