  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成三厘米见方的块，放淡盐水里泡几分钟去掉豆腥。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用老豆腐，嫩豆腐一煎就碎，盐水泡过更紧实。",
      "visual_cue": "豆腐块棱角分明，手感紧实"
    },
    {
      "n": 2,
      "text": "香菇泡发后切成块，冬笋切片，五花肉切薄片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡香菇的水留着，后面烧豆腐更鲜。",
      "visual_cue": "香菇软透，笋片薄而完整"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，豆腐块下锅中火煎到四面微黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "一面煎定型再翻，别急着来回动。",
      "visual_cue": "豆腐六面结皮，色浅金黄"
    },
    {
      "n": 4,
      "text": "砂锅坐火，下五花肉片小火煸出油，加姜片和葱结炒香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "肉片煸出油，砂锅底就有了香味基础。",
      "visual_cue": "肉片卷边，油脂清亮"
    },
    {
      "n": 5,
      "text": "放入香菇块和冬笋片翻炒，淋黄酒炒出香气。",
      "time_min": 3,
      "heat": "中火",
      "tip": "黄酒淋下去要立刻翻，酒香才留在菜里。",
      "visual_cue": "闻到酒香与菌香混合"
    },
    {
      "n": 6,
      "text": "摆入煎好的豆腐，加生抽、老抽、白糖和清水，大火烧开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "豆腐一块块码放，别叠压太多，否则下面压碎。",
      "visual_cue": "汤汁微沸，豆腐染上酱色"
    },
    {
      "n": 7,
      "text": "转小火盖盖焖到豆腐吸足汤汁，中间翻动一次。",
      "time_min": 10,
      "heat": "小火",
      "tip": "翻动用铲子托底，别把豆腐戳破。",
      "visual_cue": "豆腐鼓胀，筷子插进去有汁"
    },
    {
      "n": 8,
      "text": "开盖尝味补盐，收汁到浓稠挂勺即可出锅上桌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "收汁别收干，留些汤汁拌饭最香。",
      "visual_cue": "汤汁浓亮，豆腐表面油润"
    }
  ],
  "tips": [
    "豆腐先泡盐水再煎，去腥又不易碎。",
    "用泡香菇的水烧豆腐，鲜味更足。",
    "小火焖透再收汁，豆腐才会鼓胀吸汁。"
  ],
  "common_mistakes": [
    "用嫩豆腐煎制，翻面就成了碎渣。",
    "大火焖烧，汤汁烧干豆腐还没入味。",
    "收汁过头，锅底发苦粘锅，豆腐带焦味。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "火腿",
      "ratio": "80 克:60 克",
      "note": "咸鲜更突出，盐量需减半。"
    },
    {
      "original": "冬笋",
      "substitute": "茭白",
      "ratio": "80 克:100 克",
      "note": "口感相近，烧制时间缩短两分钟。"
    }
  ],
  "variations": [
    "加几粒干贝同烧，鲜味更浓更像宴客菜。",
    "用鸡汤代替清水烧制，鲜味层次更厚。"
  ],
  "serving_suggestion": "连砂锅端上桌，配白饭浇汁，热腾腾最香。",
  "storage": "冷藏两天，复热时加少量清水小火焖热，不要微波。",
