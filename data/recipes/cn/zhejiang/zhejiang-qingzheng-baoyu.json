  "equipment": [
    "蒸锅",
    "刷子",
    "刀",
    "小碗",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲍鱼用刷子把裙边黑膜和壳内泥沙刷净。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "黑膜不刷，蒸出来一股腥苦味。，看准状态再往下做。",
      "visual_cue": "裙边泛白，壳内干净"
    },
    {
      "n": 2,
      "text": "取下鲍肉，去掉内脏和嘴部硬块。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "内脏带苦，嘴部老得嚼不动。，看准状态再往下做。",
      "visual_cue": "鲍肉完整，无杂物，这一点很关键。"
    },
    {
      "n": 3,
      "text": "在鲍肉表面切十字花刀，深度约三分之一。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "花刀浅一点，蒸后不卷成球。，看准状态再往下做。",
      "visual_cue": "刀纹整齐，肉形平整"
    },
    {
      "n": 4,
      "text": "鲍肉放回壳里，淋料酒撒姜丝腌五分钟。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "料酒去腥，姜丝提香。，看准状态再往下做。",
      "visual_cue": "肉面湿润，姜丝铺匀"
    },
    {
      "n": 5,
      "text": "蒸锅水大开后放进去，大火蒸六分钟。，看准状态再往下做。",
      "time_min": 7,
      "heat": "大火",
      "tip": "水开再上锅，蒸久了肉就韧。，看准状态再往下做。",
      "visual_cue": "鲍肉变白，边缘微微收缩"
    },
    {
      "n": 6,
      "text": "取出倒掉壳内积的汤汁，撒葱丝和蒜末。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "积水有腥味，必须倒掉。，看准状态再往下做。",
      "visual_cue": "壳内干爽，葱蒜铺面"
    },
    {
      "n": 7,
      "text": "小碗调生抽和白糖，淋在鲍鱼上。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁要温一点，凉汁压香气。，看准状态再往下做。",
      "visual_cue": "汁液清亮，铺满壳内"
    },
    {
      "n": 8,
      "text": "烧热植物油浇在葱丝上，激出香气。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油要冒烟才浇，香气才炸开。，看准状态再往下做。",
      "visual_cue": "油花四溅，葱丝卷起"
    }
  ],
  "tips": [
    "黑膜和内脏必须去净，否则带苦腥。",
    "蒸的时间控制在六分钟，久了像橡皮。",
    "热油浇葱丝这一步，香气全在这。，这一点很关键。"
  ],
  "common_mistakes": [
    "鲍鱼没刷黑膜，成品发苦。，这一点很关键。",
    "冷水上锅蒸，肉又老又硬。，这一点很关键。",
    "蒸完不倒掉壳里的水，一口腥。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鲍鱼",
      "substitute": "扇贝",
      "ratio": "450 克:500 克",
      "note": "蒸的时间减到四分钟。"
    },
    {
      "original": "生抽",
      "substitute": "蒸鱼豉油",
      "ratio": "30 毫升:30 毫升",
      "note": "鲜味更浓，糖可省。"
    }
  ],
  "variations": [
    "加一勺蒜蓉酱，做成蒜蓉蒸鲍鱼。，这一点很关键。",
    "淋一点绍酒，酒香更醇。，这一点很关键。"
  ],
  "serving_suggestion": "趁热吃，一个一口最鲜。，这一点很关键。",
  "storage": "冷藏一天，复热蒸三分钟。，这一点很关键。",
