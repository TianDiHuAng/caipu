  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "莲藕",
          "name_en": "lotus root",
          "amount": 600,
          "unit": "g",
          "note": "选粗短孔大的",
          "optional": false
        },
        {
          "name": "糯米",
          "name_en": "glutinous rice",
          "amount": 120,
          "unit": "g",
          "note": "提前浸泡",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "冰糖",
          "name_en": "rock sugar",
          "amount": 120,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "桂花",
          "name_en": "osmanthus flower",
          "amount": 3,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 20,
          "unit": "g",
          "note": "淋面",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1200,
          "unit": "ml",
          "note": "煮制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "筷子",
    "棉线"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗干净后加清水浸泡到手指能轻松碾碎米粒。",
      "time_min": 120,
      "heat": "无火",
      "tip": "泡透才容易塞进孔里，也容易煮糯。",
      "visual_cue": "米粒发白发软，一捏就碎"
    },
    {
      "n": 2,
      "text": "莲藕洗净削去外皮，从一端两厘米处切开当盖子。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切下的这截盖子别丢，最后要塞回去封住米粒。",
      "visual_cue": "藕身白净，切面平整"
    },
    {
      "n": 3,
      "text": "把泡好的糯米一点点塞进藕孔，边塞边用筷子戳实。",
      "time_min": 12,
      "heat": "无火",
      "tip": "每孔塞八分满，米煮胀了才不会顶开。",
      "visual_cue": "藕孔塞满，米面平整"
    },
    {
      "n": 4,
      "text": "盖上切下的藕盖，用棉线绕紧或用牙签扎牢固定。",
      "time_min": 4,
      "heat": "无火",
      "tip": "扎紧一点，煮的时候米才不会漏出来。",
      "visual_cue": "盖子贴合牢固，晃动不掉"
    },
    {
      "n": 5,
      "text": "汤锅放藕、冰糖和清水，水量没过藕身，大火烧开。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水要一次加足，中途加水会影响甜度。",
      "visual_cue": "水面滚开，冰糖融化"
    },
    {
      "n": 6,
      "text": "转小火盖盖慢煮，中途翻面一次让受热均匀。",
      "time_min": 80,
      "heat": "小火",
      "tip": "小火慢炖才酥而不烂，火大藕心易空。",
      "visual_cue": "藕身变深红，筷子能戳透"
    },
    {
      "n": 7,
      "text": "关火后连糖水一起浸泡放凉，让藕充分吸入甜味。",
      "time_min": 60,
      "heat": "无火",
      "tip": "浸泡这步决定甜度，别急着把藕捞出来。",
      "visual_cue": "藕色深亮，糖水渗入"
    },
    {
      "n": 8,
      "text": "取出藕段拆线切成厚片，淋蜂蜜撒桂花即可。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刀蘸一下凉水再切，切面才不粘米也不散。",
      "visual_cue": "切面糯米白净，藕片透红"
    }
  ],
  "tips": [
    "糯米必须泡到能碾碎，煮出来才软糯。",
    "藕孔塞八分满，煮胀后正好填实不顶盖。",
    "煮完浸泡放凉，甜味才能透到藕心。"
  ],
  "common_mistakes": [
    "糯米不泡直接塞，煮两小时还是硬芯。",
    "藕孔塞太满，煮时米涨把盖子顶开。",
    "大火猛煮两小时，藕煮散了米全漏进汤。"
  ],
  "substitutions": [
    {
      "original": "冰糖",
      "substitute": "红糖",
      "ratio": "120 克:100 克",
      "note": "颜色更深，带焦糖香，甜度略降。"
    },
    {
      "original": "桂花",
      "substitute": "玫瑰酱",
      "ratio": "3 克:15 克",
      "note": "香气更浓，需在淋面时再加。"
    }
  ],
  "variations": [
    "加两颗红枣同煮，甜味更有层次。",
    "煮好冷藏一夜再切，口感更紧实。"
  ],
  "serving_suggestion": "切片冷吃最清爽，冬天可温热上桌当甜品。",
  "storage": "连糖水冷藏三天，切片后当天吃完为佳。",
