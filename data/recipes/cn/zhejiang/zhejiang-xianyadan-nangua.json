  "steps": [
    {
      "n": 1,
      "text": "咸蛋黄放入蒸锅大火蒸八分钟至熟透，取出趁热用勺背压成细泥。",
      "time_min": 10,
      "heat": "大火",
      "tip": "压得越细，炒的时候越容易起沙裹匀。",
      "visual_cue": "蛋黄成细沙状，无颗粒结块"
    },
    {
      "n": 2,
      "text": "南瓜去皮去瓤，切成一厘米厚、六厘米长的条，撒少许盐抓匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "南瓜条切得粗一点，裹上蛋黄以后才不容易折断。",
      "visual_cue": "南瓜条粗细一致，表面微出水"
    },
    {
      "n": 3,
      "text": "南瓜条拍上一层薄淀粉，抖掉多余粉末，静置两分钟回潮。",
      "time_min": 3,
      "heat": "无火",
      "tip": "回潮后再下锅，粉才不脱落，裹得更牢。",
      "visual_cue": "条身均匀挂粉，不见干粉堆积"
    },
    {
      "n": 4,
      "text": "锅中倒植物油烧热，下南瓜条中火煎到四面金黄、内部熟透后捞出。",
      "time_min": 8,
      "heat": "中火",
      "tip": "筷子能轻松插透就是熟了，别只煎表面。",
      "visual_cue": "条身金黄挺立，表皮结壳不软塌"
    },
    {
      "n": 5,
      "text": "锅留底油下姜末爆香，倒入蛋黄泥小火炒到起泡发沙。",
      "time_min": 3,
      "heat": "小火",
      "tip": "火大蛋黄立刻结块发苦，一定要小火慢炒。",
      "visual_cue": "蛋黄冒细泡，泛出油亮的沙感"
    },
    {
      "n": 6,
      "text": "烹入料酒，加盐与白糖炒匀，倒入南瓜条快速翻裹，撒葱花出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "南瓜下锅后翻两下就起，久炒蛋黄会脱。",
      "visual_cue": "每条南瓜裹满金沙，葱花翠绿点缀"
    }
  ],
  "tips": [
    "咸蛋黄本身很咸，盐只放一小撮，试味后再补。",
    "南瓜选老南瓜，水分少、甜度高，焗出来不塌。",
    "没有咸蛋黄可用咸蛋黄酱，量减三成，起沙效果略差。"
  ],
  "common_mistakes": [
    "南瓜不裹粉直接煎，入锅就软，裹不住蛋黄。",
    "蛋黄用大火炒，瞬间焦黑发苦，整盘报废。",
    "南瓜没煎熟就裹蛋黄，咬着生硬，蛋黄却已炒老。"
  ],
  "substitutions": [
    {
      "original": "南瓜",
      "substitute": "红薯",
      "ratio": "300克:300克",
      "note": "红薯更甜，糖可减半。"
    },
    {
      "original": "咸蛋黄",
      "substitute": "咸蛋黄酱",
      "ratio": "60克:45克",
      "note": "酱料含油，底油须再减一半。"
    }
  ],
  "variations": [
    "加一点咖喱粉同炒蛋黄，风味更浓，是近年餐厅常见的做法。",
    "把南瓜换成苦瓜，先焯水去苦再焗，清苦回甘很解腻。"
  ],
  "serving_suggestion": "趁热吃，外层沙糯内里绵甜，作为宴客小菜或孩子的主菜都合适。",
  "storage": "冷藏可存一天，复热须用平底锅小火回煎，微波会让蛋黄出水脱壳。",
