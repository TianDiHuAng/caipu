          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 4,
          "unit": "piece",
          "note": "约两百克",
          "optional": false
        },
        {
          "name": "香菇",
          "name_en": "shiitake mushroom",
          "amount": 150,
          "unit": "g",
          "note": "鲜香菇切片",
