        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 40,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 8,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "去腥",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "打蛋碗",
    "锅铲",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进碗里加白胡椒和一小撮盐，打散成蛋液。",
      "time_min": 4,
      "heat": "无火",
      "tip": "白胡椒能压住蛋腥，比料酒更合适。，火候最关键。",
      "visual_cue": "蛋液颜色均匀，无成团蛋清"
    },
    {
      "n": 2,
      "text": "鲜香菇切去根部硬蒂，斜刀切成三毫米厚的片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "斜切面积大，炒的时候更容易出香出水。",
      "visual_cue": "香菇片厚薄一致，菌褶完整"
    },
    {
      "n": 3,
      "text": "炒锅大火烧热放一半花生油，倒入蛋液推炒成块。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油热再下蛋，蛋才鼓泡蓬松不粘锅。，时间要卡准些。",
      "visual_cue": "蛋液鼓泡凝固，颜色嫩黄"
    },
    {
      "n": 4,
      "text": "蛋块炒到七成熟就盛出，锅里补剩下的花生油。",
      "time_min": 1,
      "heat": "中火",
      "tip": "七成熟盛出，回锅炒完刚好不老。，顺序不能颠倒。",
      "visual_cue": "蛋块柔嫩带光泽，边缘微凝"
    },
    {
      "n": 5,
      "text": "下香菇片中火煸三分钟，把水分煸出来再收回去。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菇一定要煸透，生的菌菇有股土腥味。",
      "visual_cue": "香菇片边缘微焦，锅里香气浓"
    },
    {
      "n": 6,
      "text": "加生抽翻匀给香菇上色，再撒盐调味。，动作要轻一点。",
      "time_min": 1,
      "heat": "大火",
      "tip": "生抽沿锅边淋，遇热激出的酱香更足。",
      "visual_cue": "香菇片呈浅褐色，油亮不干"
    },
    {
      "n": 7,
      "text": "倒回蛋块转大火快速翻炒半分钟，让两者混匀。",
      "time_min": 1,
      "heat": "大火",
      "tip": "回锅只翻几下，炒久了蛋会出水变硬。",
      "visual_cue": "蛋块与香菇片均匀交错"
    },
    {
      "n": 8,
      "text": "撒葱花翻两下立刻出锅，趁热装盘上桌。，注意观察火候。",
      "time_min": 1,
      "heat": "大火",
      "tip": "葱花最后撒，香味最鲜颜色也绿。，量别放多。",
      "visual_cue": "蛋黄金亮，香菇褐亮，葱花翠绿"
    }
  ],
  "tips": [
    "鲜香菇比干货更适合这道菜，口感更弹。",
    "蛋液里加一勺清水，炒出来更嫩滑。",
    "香菇一定要煸透，否则有生菌味。",
    "喜欢浓味可以加两滴蚝油提鲜。，味道能更足。"
  ],
  "common_mistakes": [
    "香菇没煸透就下蛋，整盘带一股土腥味。",
    "蛋液炒到全熟才盛出，回锅后老得像橡皮。",
    "火太小慢慢炒，香菇出水把蛋泡软了。"
  ],
  "substitutions": [
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "150克:60克",
      "note": "干木耳泡发后撕小朵，炒的时间相同。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4个:3个",
      "note": "腥味略重，白胡椒加倍。"
    }
  ],
  "variations": [
    "加一把虾仁同炒，鲜味更足。，换个花样不单调。",
    "放几片火腿同炒，咸香层次更丰富。，口味层次更丰富。"
  ],
  "serving_suggestion": "装盘趁热吃，蛋嫩菇香，配米饭或面条都很搭。",
  "storage": "冷藏一天，复热用小火快炒，避免蛋变老出水。",
