  "steps": [
    {
      "n": 1,
      "text": "鱼胶提前用冷水泡软，泡到按压有弹性。，看准状态再往下走。",
      "time_min": 28,
      "heat": "无火",
      "tip": "泡不透会发硬，煮再久也咬不动。，这一点别省。",
      "visual_cue": "胶体柔软，能弯折，这一点很关键。"
    },
    {
      "n": 2,
      "text": "鱼胶切细丝，用姜丝和料酒抓匀去腥。，看准状态再往下走。",
      "time_min": 5,
      "heat": "无火",
      "tip": "抓过再冲一下，腥味更淡。，这一点别省。",
      "visual_cue": "丝条均匀，无黏液，这一点很关键。"
    },
    {
      "n": 3,
      "text": "鸡胸肉切细丝，加少许淀粉抓匀上浆。，看准状态再往下走。",
      "time_min": 5,
      "heat": "无火",
      "tip": "上浆后煮出来才嫩。，这一点别省。，经验就是这么来的。",
      "visual_cue": "肉丝滑手，根根分开"
    },
    {
      "n": 4,
      "text": "汤锅倒清水，放姜丝大火烧开。，看准状态再往下走。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水开再下料，汤才清。，这一点别省。",
      "visual_cue": "汤面翻滚，姜香出，这一点很关键。"
    },
    {
      "n": 5,
      "text": "下鱼胶丝煮十五分钟，煮到胶质变软。，看准状态再往下走。",
      "time_min": 17,
      "heat": "中小火",
      "tip": "中小火慢煮，胶质才化开。，这一点别省。",
      "visual_cue": "丝条透明，汤略稠，这一点很关键。"
    },
    {
      "n": 6,
      "text": "下鸡肉丝滑散，煮到肉丝变白浮起。，看准状态再往下走。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "肉丝一下锅就滑开，别结团。，这一点别省。",
      "visual_cue": "肉丝雪白，条条分明"
    },
    {
      "n": 7,
      "text": "加盐和白胡椒粉调味，撇净浮沫。，看准状态再往下走。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "胡椒最后放，香气才在。，这一点别省。",
      "visual_cue": "汤清味鲜，浮沫除净"
    },
    {
      "n": 8,
      "text": "淀粉加水调开，缓缓淋入勾薄芡。，看准状态再往下走。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "边淋边搅，芡才不结块。，这一点别省。",
      "visual_cue": "汤汁微稠，能挂勺，这一点很关键。"
    },
    {
      "n": 9,
      "text": "关火淋蛋清，轻轻推成蛋花。，看准状态再往下走。",
      "time_min": 2,
      "heat": "无火",
      "tip": "余温足够，蛋花才嫩。，这一点别省。",
      "visual_cue": "蛋花细白，浮在表面"
    },
    {
      "n": 10,
      "text": "淋香油，撒葱花盛碗。，看准状态再往下走。，动作轻一点别弄破。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油最后点，香气才清。，这一点别省。",
      "visual_cue": "表面油光，葱末翠绿"
    }
  ],
  "tips": [
    "鱼胶必须泡透，否则煮不软。，这一点很关键。",
    "勾芡要薄，太稠就成糊了。，这一点很关键。",
    "蛋清关火后淋，蛋花才嫩。，这一点很关键。"
  ],
  "common_mistakes": [
    "鱼胶没泡透，咬着像橡皮。，这一点很关键。",
    "芡粉直接下锅，凝成一坨。，这一点很关键。",
    "大火煮蛋清，蛋花发硬起泡。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鱼胶",
