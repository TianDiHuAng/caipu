        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "木铲",
    "砧板",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米与糯米混合淘洗两遍，沥干后静置十五分钟让米粒吸足表面水。",
      "time_min": 15,
      "heat": "无火",
      "tip": "两种米混着煮，全靠糯米那点黏，全用粳米煮出来发干不黏。",
      "visual_cue": "米粒干爽松散，不带水珠"
    },
    {
      "n": 2,
      "text": "咸肉切成一厘米小丁，冷锅下锅小火煸出油，煸到肥肉透明。",
      "time_min": 8,
      "heat": "小火",
      "tip": "咸肉先煸出油，饭才有肉香；直接和米一起煮，香味全被水冲淡。",
      "visual_cue": "肥肉透明，锅底一层清油"
    },
    {
      "n": 3,
      "text": "豌豆下锅与咸肉同炒两分钟，加猪油炒匀，让豆粒裹上油光。",
      "time_min": 7,
      "heat": "中火",
      "tip": "豌豆炒过再焖不易发黄，也能去掉那股生豆气。",
      "visual_cue": "豌豆翠绿油亮，豆皮不皱"
    },
    {
      "n": 4,
      "text": "米下锅与料翻匀，倒清水至刚没过米面，大火烧开转小火焖二十五分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "咸肉本身够咸，全程不要再放盐，否则一锅饭咸得下不了口。",
      "visual_cue": "水面齐米，锅边冒小泡"
    },
    {
      "n": 5,
      "text": "关火焖十分钟再开盖，用木铲从底翻松，把肉丁和豌豆拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "关火焖十分钟让米粒回软定型，开盖早饭会夹生。",
      "visual_cue": "饭粒油亮分明，豆肉分布均匀"
    }
  ],
  "tips": [
    "咸肉豌豆饭是江浙春天立夏前后的家常饭，一锅端上桌配碗蛋花汤。",
    "咸肉提前用温水泡十分钟能去一部分盐分，口味淡的人可以这么做。",
    "用砂锅焖饭锅底会结一层焦香锅巴，拌开吃特别香。"
  ],
  "common_mistakes": [
    "忘了咸肉本身咸，又按常规加盐，整锅饭咸得没法吃。",
    "豌豆和米一起下锅焖半小时，豆粒发黄发烂，一点不翠。",
    "大火烧开后还开着大滚，米汤溢出来，锅底糊一层。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "腊肠",
      "ratio": "150克:150克",
      "note": "腊肠版带甜味，油量可再减五克。"
    },
    {
      "original": "豌豆",
      "substitute": "蚕豆",
      "ratio": "150克:180克",
      "note": "蚕豆需剥去外皮，焖制时间相同。"
    }
  ],
  "variations": [
    "加一把切丁的春笋同焖，是浙北清明前后的吃法。",
    "把豌豆换成蚕豆米，加几粒咸蛋黄同焖，风味更浓。"
  ],
  "serving_suggestion": "盛碗后撒一点葱花，配一碗清汤或紫菜汤，就是一顿完整的家常饭。",
  "storage": "冷藏可存两天，复热时隔水蒸十分钟，微波易使米粒发硬。",
