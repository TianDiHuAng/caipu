  "equipment": [
    "炒锅",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾 400g 剪去虾枪虾须，沿背部挑出虾线，冲洗后用厨房纸吸干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "虾身一定要擦干，下锅才不溅油。",
      "visual_cue": "虾身干爽、背缝干净"
    },
    {
      "n": 2,
      "text": "葱 80g 的葱白切段、葱绿切细丝，姜 10g 切丝备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "葱白葱绿分开，下锅时间不一样。",
      "visual_cue": "葱白段整齐、葱绿丝细"
    },
    {
      "n": 3,
      "text": "炒锅倒 50ml 植物油，冷油下葱白段与姜丝，小火熬 6 分钟至葱白焦黄。",
      "time_min": 6,
      "heat": "小火",
      "tip": "冷油下葱，香味才慢慢逼出来。",
      "visual_cue": "葱白变浅褐、油色发青绿"
    },
    {
      "n": 4,
      "text": "转中大火下虾煎 3 分钟，两面转红后淋 15ml 料酒。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "虾下锅先别翻动，定型后才不粘。",
      "visual_cue": "虾身卷曲、两面红色"
    },
    {
      "n": 5,
      "text": "加 20ml 生抽、5g 白糖与 2g 盐，翻炒 2 分钟让汤汁裹住虾身。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "糖能压住生抽的咸，别省略。",
      "visual_cue": "虾壳油亮、酱汁收紧"
    },
    {
      "n": 6,
      "text": "关火后撒入葱绿丝，用锅里余温拌几下再装盘。",
      "time_min": 1,
      "heat": "无火",
      "tip": "葱绿遇高温会发黄，关火再放。",
      "visual_cue": "葱绿翠绿、香气冲鼻"
    }
  ],
  "tips": [
    "熬葱油用小火，火大葱白瞬间发黑发苦。",
    "虾开背不仅去虾线，还能让味道渗进去。",
    "全程控制在五分钟内，虾肉才不会老。"
  ],
  "common_mistakes": [
    "葱白大火炸，几秒钟就焦黑带苦味。",
    "虾带着水下锅，油花四溅还变成水煮虾。",
    "翻炒时间太长，虾肉缩成硬球咬不动。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "虾仁",
      "ratio": "400g 对 350g",
      "note": "省去开背，煎制时间减 1 分钟。"
    },
    {
      "original": "生抽",
      "substitute": "蒸鱼豉油",
      "ratio": "20ml 对 20ml",
      "note": "咸度更低，鲜味更突出。"
    }
  ],
  "variations": [
    "加 10g 干辣椒段同熬葱油，做成微辣版本。",
    "起锅前淋 5ml 香醋，酸香更开胃。"
  ],
  "serving_suggestion": "连油带虾一起盛盘，配白饭或啤酒都合适。",
  "storage": "现做现吃，冷藏后虾肉会变紧，建议 24 小时内吃完。",
