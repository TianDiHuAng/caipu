    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干贝加料酒与少量清水上锅蒸二十分钟，取出放凉后撕成细丝，蒸汁留用。",
      "heat": "中火",
      "tip": "干贝要蒸到能轻松撕开，鲜味才出得来。",
      "visual_cue": "干贝丝松散、纤维分明",
      "time_min": 22
    },
    {
      "n": 2,
      "text": "莼菜倒进漏勺用清水冲淋三遍，去掉瓶装带来的酸味，沥干备用。",
      "heat": "无火",
      "tip": "莼菜别用手搓，冲淋即可保持嫩芽完整。",
      "visual_cue": "莼菜滑亮、没有酸气",
      "time_min": 6
    },
    {
      "n": 3,
      "text": "清水加姜丝与干贝蒸汁烧开，撒入火腿末煮两分钟出鲜味。",
      "heat": "大火",
      "tip": "蒸汁是鲜味集中处，一定要一起倒进去。",
      "visual_cue": "汤色微黄、火腿末浮起",
      "time_min": 4
    },
    {
      "n": 4,
      "text": "汤里加盐调味，玉米淀粉加水调匀后缓缓淋入并不断搅动勾芡。",
      "heat": "中火",
      "tip": "芡要慢慢淋入并不断搅动，才不结块。",
      "visual_cue": "汤汁微稠、挂勺成线",
      "time_min": 2
    },
    {
      "n": 5,
      "text": "下莼菜煮一分钟，再放入干贝丝，淋入蛋清搅出细丝状。",
      "heat": "中小火",
      "tip": "莼菜久煮会化，一分钟就够。",
      "visual_cue": "莼菜舒展、蛋清成细丝",
      "time_min": 2
    },
    {
      "n": 6,
      "text": "关火淋芝麻油，盛入汤碗趁热食用，滑嫩清鲜。",
      "heat": "无火",
      "tip": "麻油最后淋，香气最清。",
      "visual_cue": "汤面油花细、色泽清亮",
      "time_min": 1
    }
  ],
  "tips": [
    "瓶装莼菜带酸味，多冲几遍会清爽很多。",
    "干贝泡发不要用热水，纤维会散成渣。",
    "勾芡用玉米淀粉，透明度比生粉更好。"
  ],
  "common_mistakes": [
    "莼菜下锅久煮，芽叶化在汤里不见了。",
    "芡粉一次性倒入汤中，结成一块块芡疙瘩。",
    "干贝没蒸透就下锅，口感又硬又柴。"
  ],
  "substitutions": [
    {
      "original": "莼菜",
      "substitute": "嫩豆腐丝",
      "ratio": "250g 对 200g",
      "note": "豆腐丝切细，口感接近但无滑润感。"
    },
    {
      "original": "干贝",
      "substitute": "干鱿鱼丝",
      "ratio": "60g 对 40g",
      "note": "鲜味更浓，盐要减到 1g。"
    }
  ],
  "variations": [
    "加几片鲜香菇同煮，菌香与海味很搭。",
    "勾芡前打散一个全蛋，做成蛋花莼菜羹。"
  ],
  "serving_suggestion": "饭前一碗热羹最开胃，配清淡小菜即可。",
  "storage": "冷藏一天，复热时加少量清水并重新勾薄芡。",
