    "打蛋器",
    "蒸锅",
    "筛网",
    "刀",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打散，加温水、盐与绍兴酒搅匀，水与蛋液比例约一比一点五。",
      "time_min": 7,
      "heat": "无火",
      "tip": "用温水调蛋液，蒸出来才滑不留孔。",
      "visual_cue": "蛋液淡黄均匀，表面浮着细沫"
    },
    {
      "n": 2,
      "text": "蛋液过筛两遍，滤掉泡沫和系带，静置三分钟消泡。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛两遍是滑嫩的关键，别嫌麻烦。",
      "visual_cue": "滤后蛋液细腻无泡，质地轻薄"
    },
    {
      "n": 3,
      "text": "虾仁用盐抓洗后吸干，香菇切小丁，火腿切末，一起铺在深盘底部。",
      "time_min": 10,
      "heat": "无火",
      "tip": "配料先铺底，蛋液盖上去蒸完分层更好看。",
      "visual_cue": "配料平铺均匀，盘底无积水"
    },
    {
      "n": 4,
      "text": "蛋液沿盘边缓缓倒入，盖上保鲜膜并在四角扎几个小孔透气。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盖膜防止水汽滴落，表面才平整。",
      "visual_cue": "蛋液没过配料，膜面平整"
    },
    {
      "n": 5,
      "text": "蒸锅水开后放入，中小火蒸十二分钟，关火焖两分钟取出。",
      "time_min": 16,
      "heat": "中小火",
      "tip": "中小火蒸才不起蜂窝，火大立刻粗糙。",
      "visual_cue": "蛋面平整如镜，轻晃不流动"
    },
    {
      "n": 6,
      "text": "撕掉保鲜膜，淋生抽与芝麻油，撒葱花即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "调味最后淋，蒸前加酱油颜色会发暗。",
      "visual_cue": "蛋面光滑油亮，配料隐约透出"
    }
  ],
  "tips": [
    "蛋液与温水比例一比一点五，蒸出来最嫩。",
    "过筛两遍并静置消泡，表面才会平整如镜。",
    "盖上保鲜膜防止水汽滴落，这是不起坑的秘诀。",
    "中小火蒸，火一大立刻出现蜂窝孔。"
  ],
  "common_mistakes": [
    "用冷水调蛋液，蒸出来发硬还分层。",
    "蛋液不过筛直接蒸，表面全是小气泡，口感粗得像海绵。",
    "大火猛蒸，蛋羹变成粗糙的蜂窝状。",
    "蒸的时间太长，蛋羹老了出水，盘底积一层清汤。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "蟹肉棒",
      "ratio": "120克:120克",
      "note": "切小块铺底，蒸的时间相同。"
    },
    {
      "original": "火腿",
      "substitute": "培根",
      "ratio": "40克:40克",
      "note": "咸度更高，盐可减一克。"
    }
  ],
  "variations": [
    "蛋液里加一勺高汤代替部分温水，鲜味更足。",
    "表面撒几粒泡软的枸杞，颜色更喜气，待客时也好看。",
    "放两片香菇在表面，蒸完卖相更精致。"
  ],
  "serving_suggestion": "连盘端上桌，撒葱花淋香油，用勺子舀着吃，配米饭或白粥都很合适，老人孩子都爱。",
  "storage": "冷藏可放一天，复热用蒸锅中小火蒸五分钟，微波加热会起孔。",
