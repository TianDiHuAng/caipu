  "equipment": [
    "汤锅",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆纹切小块后剁成细末，越细越好方便入口。",
      "time_min": 8,
      "heat": "无火",
      "tip": "剁得细，羹的口感才顺滑。",
      "visual_cue": "牛肉碎细匀、无筋膜"
    },
    {
      "n": 2,
      "text": "牛肉碎加料酒、生抽与少许盐抓匀，腌十分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "先腌后氽，牛肉碎才不老。",
      "visual_cue": "牛肉碎松散、带酱香"
    },
    {
      "n": 3,
      "text": "香菇去蒂切细丁，香菜与生姜分别切成细末备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香菇丁要与牛肉碎同样细才好融。",
      "visual_cue": "各料切丁均匀、大小一致"
    },
    {
      "n": 4,
      "text": "汤锅加清水烧开，放入香菇丁与姜末煮三分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "香菇先煮，鲜味才能溶进汤里。",
      "visual_cue": "汤色微黄、菇香冒头"
    },
    {
      "n": 5,
      "text": "转小火，把牛肉碎用筷子拨散着下锅，边下边搅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "拨散下锅，牛肉碎才不结成团。",
      "visual_cue": "牛肉碎粒粒分明浮在汤中"
    },
    {
      "n": 6,
      "text": "撇去表面浮沫，加盐与白胡椒调出清鲜汤底。",
      "time_min": 2,
      "heat": "小火",
      "tip": "浮沫撇净，羹色才清亮。",
      "visual_cue": "汤面干净无沫、咸鲜适口"
    },
    {
      "n": 7,
      "text": "玉米淀粉兑水调匀，缓慢淋入汤中并持续搅动成薄芡。",
      "time_min": 2,
      "heat": "中火",
      "tip": "边淋边搅，芡才没有疙瘩。",
      "visual_cue": "汤体微稠、勺背挂薄浆"
    },
    {
      "n": 8,
      "text": "蛋清打散后细线状淋入，静置五秒再轻推成蛋花。",
      "time_min": 2,
      "heat": "小火",
      "tip": "淋后先别搅，蛋花才成薄片。",
      "visual_cue": "蛋花薄白如絮、汤面光亮"
    },
    {
      "n": 9,
      "text": "关火淋香油，撒香菜末搅匀后盛入汤碗即可上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香油最后放，香气才不挥发。",
      "visual_cue": "羹面浮油点、香菜翠绿"
    }
  ],
  "tips": [
    "牛肉改用牛里脊，剁末后更嫩不柴。",
    "芡要勾得薄一些，羹才清爽不发糊。",
    "喜酸可撒少许陈醋，风味更开胃。"
  ],
  "common_mistakes": [
    "牛肉碎大团下锅，煮出来结成硬块。",
    "淀粉一次倒完，汤里全是白疙瘩。",
    "蛋清在滚沸的汤里猛搅，蛋花全散成碎末。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "猪里脊",
      "ratio": "200g 对 200g",
      "note": "味道更清，可减料酒用量。"
    },
    {
      "original": "香菇",
      "substitute": "口蘑",
      "ratio": "60g 对 70g",
      "note": "鲜味稍淡，可加少许蚝油。"
    }
  ],
  "variations": [
    "加少许嫩豆腐丁同煮，口感更滑顺。",
    "出锅撒一把松仁碎，香气更丰富。"
  ],
  "serving_suggestion": "饭前一碗最开胃，配小笼或烧卖都合适。",
  "storage": "当天喝完，冷藏后羹会变稠需加水调开。",
