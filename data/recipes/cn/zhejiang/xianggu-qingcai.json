    "锅铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小白菜逐棵掰开洗净泥沙，沥干后从中间对半切开。",
      "time_min": 8,
      "heat": "无火",
      "tip": "菜根处泥沙多，要掰开冲净。",
      "visual_cue": "菜叶干爽、根部洁白"
    },
    {
      "n": 2,
      "text": "香菇去蒂切成半厘米厚的片，大蒜切片、生姜切丝。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香菇蒂纤维粗，最好切掉不用。",
      "visual_cue": "香菇片厚薄均匀、切口平整"
    },
    {
      "n": 3,
      "text": "炒锅下植物油烧热，放生姜丝与大蒜片小火炒出香味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "小火炒姜蒜，香味才稳不焦。",
      "visual_cue": "姜蒜香气散出、颜色微黄"
    },
    {
      "n": 4,
      "text": "下香菇片中火翻炒两分钟，炒到香菇变软出水。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菇煸出水分，鲜味才释放。",
      "visual_cue": "香菇变软、锅里见明显汤汁"
    },
    {
      "n": 5,
      "text": "转大火下小白菜快速翻炒，菜叶塌下去就加盐、生抽与白糖。",
      "time_min": 3,
      "heat": "大火",
      "tip": "菜叶一塌就调味，久炒会发黄。",
      "visual_cue": "菜叶翠绿变软、香菇吸色"
    },
    {
      "n": 6,
      "text": "玉米淀粉兑清水淋入勾薄芡，翻炒两下裹匀即可出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "芡要薄，只让汤汁挂住菜叶。",
      "visual_cue": "菜叶油亮、盘底无积水"
    }
  ],
  "tips": [
    "香菇选厚肉的花菇，鲜味比薄菇足很多。",
    "小白菜对半切，熟得快也更入味。",
    "出锅前滴两滴香油，香气更上层。"
  ],
  "common_mistakes": [
    "菜叶与香菇同时下锅，菜叶烂了香菇还没熟。",
    "白菜没沥干就下锅，炒出一盘菜汤。",
    "盐放太早，菜叶出水后颜色发暗。"
  ],
  "substitutions": [
    {
      "original": "小白菜",
      "substitute": "菜心",
      "ratio": "400g 对 400g",
      "note": "梗更脆，需多炒半分钟。"
    },
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "150g 对 120g",
      "note": "口感更脆，须提前泡发。"
    }
  ],
  "variations": [
    "加几片胡萝卜同炒，颜色更鲜亮。",
    "把生抽换成蚝油，鲜味会更厚重一些。"
  ],
  "serving_suggestion": "趁热盛盘上桌，配着荤菜一起吃更解腻。",
  "storage": "当天吃完最好，复热后青菜容易发黄出水。",
