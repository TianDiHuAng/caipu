  "equipment": [
    "蒸锅",
    "打蛋盆",
    "滤网",
    "浅口碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁沿背部挑开，剔掉黑色细肠，加盐和料酒抓匀，静置去腥入味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "背部那条黑色细肠一定剔干净，不然会有泥腥味。",
      "visual_cue": "虾仁表面微亮，闻着无腥气"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进打蛋盆，加盐打散，蛋液要打到完全匀净没有筋膜。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打蛋别猛抽，起太多泡蒸出来有孔。",
      "visual_cue": "蛋液颜色一致，无透明块"
    },
    {
      "n": 3,
      "text": "往蛋液里倒入温水，蛋液和水的比例约一比一点二，搅匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用温水不用冷水，蒸出来才嫩滑。",
      "visual_cue": "蛋液稀薄均匀，表面浮小泡"
    },
    {
      "n": 4,
      "text": "蛋液过一遍滤网滤进浅口碗，撇掉表面的浮沫。",
      "time_min": 2,
      "heat": "无火",
      "tip": "过筛这一步决定表面平不平整，千万别跳过。",
      "visual_cue": "滤网上留下絮状筋膜"
    },
    {
      "n": 5,
      "text": "碗口盖一层保鲜膜并扎几个小孔，放进上汽的蒸锅中小火蒸。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "盖膜防水汽滴落，表面才光滑如镜。",
      "visual_cue": "蛋液凝固，晃动碗中心略颤"
    },
    {
      "n": 6,
      "text": "揭开保鲜膜摆上虾仁，重新盖好继续蒸到虾仁变红卷起。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "虾仁后放才不会老，蒸到卷起就够。",
      "visual_cue": "虾仁由青转红，蜷成弯月"
    },
    {
      "n": 7,
      "text": "出锅淋生抽和香油，撒上葱花，趁热端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调味最后淋，早放会让蛋面出水。",
      "visual_cue": "蛋面平整如镜，葱花翠绿"
    }
  ],
  "tips": [
    "蛋液过筛并盖膜蒸，表面才平滑无蜂窝。",
    "水温用温水，蒸出来口感更嫩不蜂窝。",
    "虾仁最后放，蒸到卷起就停火，久蒸发硬。"
  ],
  "common_mistakes": [
    "大火猛蒸，蛋面鼓成大孔像蜂窝。",
    "冷水调蛋液，蒸好出水塌成一层。",
    "虾仁和蛋液一起下锅，虾老蛋还不熟。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "蟹肉棒",
      "ratio": "150 克:120 克",
      "note": "成本更低，鲜味弱一些，蒸三分钟即可。"
    },
    {
      "original": "清水",
      "substitute": "鸡汤",
      "ratio": "300 毫升:300 毫升",
      "note": "鲜味更厚，需减少生抽用量避免过咸。"
    }
  ],
  "variations": [
    "蛋液里加两滴香油，蒸出来蛋香更浓。",
    "表面撒少许瑶柱丝，鲜味再上一层。"
  ],
  "serving_suggestion": "出锅趁热吃，用勺子从边缘挖起，配白饭最下饭。",
  "storage": "冷藏一天，复蒸五分钟回嫩，不建议冷冻否则出水。",
