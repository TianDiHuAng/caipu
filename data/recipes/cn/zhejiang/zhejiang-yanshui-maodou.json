  "steps": [
    {
      "n": 1,
      "text": "毛豆放清水里搓洗两遍，用剪刀剪去两端的尖角，便于入味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "剪掉两头，盐水才渗得进去，不然只有壳有味。",
      "visual_cue": "豆荚两端露出小口，表面绒毛洗净"
    },
    {
      "n": 2,
      "text": "锅中加水烧开，放盐、姜片、八角、花椒与干辣椒煮三分钟出香。",
      "time_min": 5,
      "heat": "大火",
      "tip": "香料先煮几分钟把味道煮出来，再下毛豆才香得透。",
      "visual_cue": "水色微黄，香气明显飘出"
    },
    {
      "n": 3,
      "text": "倒入毛豆，加料酒与植物油，保持大火煮八分钟不盖锅盖。",
      "time_min": 8,
      "heat": "大火",
      "tip": "全程不要盖锅盖，盖了豆荚会焖黄，颜色难看。",
      "visual_cue": "豆荚由浅绿转深绿，浮起在水面"
    },
    {
      "n": 4,
      "text": "关火后在原汤里浸泡十分钟，让盐味渗进豆粒。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡的过程比煮更关键，急着捞出来就是寡淡。",
      "visual_cue": "豆荚颜色深绿，捏着略有弹性"
    },
    {
      "n": 5,
      "text": "捞出毛豆沥干汤汁，装盘即可，冷食热食都很合适。",
      "time_min": 1,
      "heat": "无火",
      "tip": "一定要沥干再装盘，泡在汤里会越放越咸。",
      "visual_cue": "豆荚干爽油亮，不见积水"
    }
  ],
  "tips": [
    "煮毛豆时加一小撮小苏打，颜色能绿得更艳，但别多放。",
    "泡的时间可延长到半小时，味道更足，适合提前做好。",
    "爱吃辣的可在汤里多放几段干辣椒，冷藏后更入味。"
  ],
  "common_mistakes": [
    "毛豆不剪角直接煮，壳是咸的豆子没味。",
    "盖上锅盖煮，豆荚焖黄，卖相差了一大截。",
    "煮完立刻捞出，盐味只停在表面，凉了就寡淡。"
  ],
  "substitutions": [
    {
      "original": "毛豆",
      "substitute": "带壳花生",
      "ratio": "300克:300克",
      "note": "花生须煮二十五分钟才软糯。"
    },
    {
      "original": "盐",
      "substitute": "海盐",
      "ratio": "12克:12克",
      "note": "海盐颗粒粗，可略增两克。"
    }
  ],
  "variations": [
    "加一勺糟卤同泡，就是江南夏天的糟毛豆，酒香清雅。",
    "把香料换成桂皮与香叶，风味更温润，适合不爱辣的人。"
  ],
  "serving_suggestion": "冰镇后作开胃小菜或下酒菜最合适，也可作为便当配菜。",
  "storage": "连汤冷藏可存三天，取食时用干净筷子，避免汤汁变味。",
