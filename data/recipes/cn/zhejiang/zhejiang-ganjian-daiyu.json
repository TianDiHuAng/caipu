  "equipment": [
    "平底锅",
    "厨房纸",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "带鱼剪去头尾和鳍，剖开腹部去内脏，刮净腹内黑膜后切成六厘米长的段。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黑膜不刮净会发苦，是带鱼最常见的腥源，这一步千万别省。",
      "visual_cue": "鱼段齐整，腹腔干净，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "鱼段加盐、料酒和白胡椒抓匀，腌十分钟，再用厨房纸把表面水分彻底吸干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水分吸干才煎得脆，也避免油花四溅，火候和顺序都要留神。",
      "visual_cue": "鱼身干爽，表面不见水光，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "取一个平盘倒面粉，鱼段两面薄薄拍一层，抖掉多余干粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉薄薄一层就好，太厚会糊成一团，提前把配料备好再动手更稳。",
      "visual_cue": "鱼段挂薄粉，不再粘手，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "平底锅倒植物油烧至五成热，鱼段下锅，中火煎四分钟不要翻动。",
      "time_min": 6,
      "heat": "中火",
      "tip": "定型前别碰，鱼皮破了就煎不成整块，这一步千万别省。",
      "visual_cue": "边缘金黄，鱼皮脱锅，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "翻面再煎三分钟，放姜丝同煎，煎到两面金黄、鱼身轻按有弹性。",
      "time_min": 4,
      "heat": "中火",
      "tip": "第二面时间略短，避免肉质过老，火候和顺序都要留神。",
      "visual_cue": "两面金黄，鱼身微鼓，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "关火撒小葱段，撒少许盐提味，用余温把葱香烘出来即可装盘。",
      "time_min": 2,
      "heat": "小火",
      "tip": "葱段最后放，靠余温出香，不会焦黑，提前把配料备好再动手更稳。",
      "visual_cue": "葱段翠绿，油亮不焦，颜色和形态变化明显"
    }
  ],
  "tips": [
    "带鱼表面的银膜不要刮掉，那是鲜味所在，洗净擦干即可。",
    "拍一层薄面粉再煎，皮不粘锅也不爆油，出锅更脆。",
    "下锅后别急着翻，等边缘金黄自然脱锅再动，翻早了鱼皮全破。"
  ],
  "common_mistakes": [
    "带鱼带水下锅，油花四溅，鱼皮粘在锅底撕成碎块。",
    "盐腌时间太长，鱼肉出水变柴，煎完干硬像咸鱼。",
    "火太大油太少，表面焦了里面还带血水，吃着发腥。"
  ],
  "substitutions": [
    {
      "original": "带鱼",
      "substitute": "鲳鱼",
      "ratio": "600克:600克",
      "note": "鲳鱼肉厚，煎的时间每面加一分钟。"
    },
    {
      "original": "面粉",
      "substitute": "淀粉",
      "ratio": "40克:40克",
      "note": "淀粉更脆，但更易焦，火要小一点。"
    }
  ],
  "variations": [
    "煎好后另起锅用醋、糖和姜丝调一碗糖醋汁浇上，就是糖醋带鱼。",
    "加一把干辣椒和花椒同煎，做成椒盐带鱼，佐酒最合适。"
  ],
  "serving_suggestion": "趁热装盘，配一碗白粥或米饭，挤一点柠檬汁解腥提鲜。",
  "storage": "冷藏可放一天，回热用平底锅小火两面各煎一分钟，或用烤箱一百八十度烤五分钟。",
