  "steps": [
    {
      "n": 1,
      "text": "梭子蟹刷洗干净，掀开蟹壳去鳃去胃囊，斩成四块。",
      "time_min": 12,
      "heat": "无火",
      "tip": "蟹鳃和蟹胃要去干净，那是最腥的部分。",
      "visual_cue": "蟹块干净，切口齐整"
    },
    {
      "n": 2,
      "text": "蟹块切口处拍一层薄淀粉，防止下锅流失蟹汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拍粉锁汁，蟹肉才不会散在汤里。",
      "visual_cue": "切口挂着薄薄一层干粉"
    },
    {
      "n": 3,
      "text": "年糕切厚片，放开水里煮两分钟捞出过凉备用。",
      "time_min": 5,
      "heat": "大火",
      "tip": "年糕先煮软，炒的时候才不会有硬芯。",
      "visual_cue": "年糕片微软，边缘半透"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，蟹块切口朝下煎到变红定型。",
      "time_min": 3,
      "heat": "中火",
      "tip": "切口先煎锁住蟹黄，翻动一定要轻手。",
      "visual_cue": "切面金黄结壳，蟹壳转红"
    },
    {
      "n": 5,
      "text": "下姜片炒香，烹黄酒，加生抽、白糖和清水烧开。",
      "time_min": 2,
      "heat": "大火",
      "tip": "黄酒沿锅边淋下去，去腥效果更彻底。",
      "visual_cue": "汤汁微沸，酒香散开"
    },
    {
      "n": 6,
      "text": "放入年糕片铺在锅底，盖盖中火焖到年糕吸饱汤汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "年糕垫底吸汁，翻动太多容易碎。",
      "visual_cue": "年糕软糯染红，汤汁减半"
    },
    {
      "n": 7,
      "text": "开盖大火收汁，加盐调味，撒葱段翻匀出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁别收太干，留点拌年糕正好。",
      "visual_cue": "汤汁浓稠挂年糕，蟹壳红亮"
    }
  ],
  "tips": [
    "蟹块切口拍薄粉，煎时蟹汁不流失。",
    "年糕先煮软再炒，成品才不夹生。",
    "年糕垫底焖，吸汁比翻炒更入味。"
  ],
  "common_mistakes": [
    "蟹不拍粉直接下锅，蟹汁全跑进汤里。",
    "年糕生着下锅干炒，中心又硬又白。",
    "反复翻炒年糕，最后碎成一锅糊。"
  ],
  "substitutions": [
    {
      "original": "梭子蟹",
      "substitute": "青蟹",
      "ratio": "800 克:800 克",
      "note": "肉更厚，斩块焖制时间加两分钟。"
    },
    {
      "original": "年糕",
      "substitute": "宁波水磨年糕",
      "ratio": "300 克:300 克",
      "note": "更软糯，煮制时间缩短一分钟。"
    }
  ],
  "variations": [
    "加几只鲜虾同炒，海味更浓也更鲜甜。",
    "起锅前放一勺猪油，香气更厚重更地道。"
  ],
  "serving_suggestion": "趁热端上桌吃，年糕吸满蟹汤最抢手。",
  "storage": "冷藏一天，复热加少量水小火焖热，蟹肉不宜久煮。",
