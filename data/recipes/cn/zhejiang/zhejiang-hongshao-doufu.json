  "equipment": [
    "平底锅",
    "炒锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成三厘米见方的块，放进淡盐水里浸五分钟再捞出沥干。",
      "time_min": 7,
      "heat": "无火",
      "tip": "淡盐水浸五分钟能让豆腐收紧，煎的时候不容易散架。",
      "visual_cue": "豆腐块完整，表面无水光滑。"
    },
    {
      "n": 2,
      "text": "平底锅烧热倒一半植物油，把豆腐块留缝摆入，中火煎四分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "块与块之间留出缝隙，翻面时铲子才伸得进去不碰坏。",
      "visual_cue": "底面金黄结壳，边缘挺立不塌。"
    },
    {
      "n": 3,
      "text": "用铲子轻推能滑动再翻面，另一面同样煎四分钟至两面金黄盛出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "铲子一推能滑动才翻面，急着硬翻，豆腐皮必破。",
      "visual_cue": "两面焦黄，块形完整不碎。"
    },
    {
      "n": 4,
      "text": "炒锅留底油下蒜片和香菇片炒两分钟，加生抽、老抽、细砂糖和盐。",
      "time_min": 3,
      "heat": "中火",
      "tip": "老抽只管上色，倒多了整盘发黑发苦，一勺就够。",
      "visual_cue": "香菇变软，锅底酱汁红亮。"
    },
    {
      "n": 5,
      "text": "倒入两百毫升清水煮开，放回豆腐块小火焖四分钟让味道渗进去。",
      "time_min": 6,
      "heat": "小火",
      "tip": "焖的时候保持小火微沸，别让汤汁翻滚，豆腐才不会撞碎。",
      "visual_cue": "汤汁微沸，豆腐块鼓胀入味。"
    },
    {
      "n": 6,
      "text": "淀粉加两勺清水调匀淋入锅中，轻推至汤汁挂匀，撒小葱末装盘。",
      "time_min": 2,
      "heat": "中火",
      "tip": "淀粉水一下锅就变稠，轻推两下马上关火，久煮会回稀。",
      "visual_cue": "汤汁裹住豆腐，油亮不流盘。"
    }
  ],
  "tips": [
    "豆腐切好先用淡盐水浸五分钟，煎的时候才不容易碎。",
    "煎豆腐要等一面结壳定型再翻，急着翻必然破皮。",
    "勾芡的淀粉水要提前调匀，下锅后轻推两下就关火。"
  ],
  "common_mistakes": [
    "豆腐下锅就大火猛翻，整锅碎成小块，装盘像豆腐渣。",
    "老抽一次倒太多，整盘发黑发苦，完全吃不出豆香。",
    "淀粉水直接往锅里撒干粉，结成一粒粒白疙瘩挂不住汁。"
  ],
  "substitutions": [
    {
      "original": "老豆腐",
      "substitute": "豆干",
      "ratio": "450克:380克",
      "note": "更紧实，煎制时间缩短一分。"
    },
    {
      "original": "香菇",
      "substitute": "口蘑",
      "ratio": "60克:70克",
      "note": "出水更多，收汁时间加一分。"
    }
  ],
  "variations": [
    "加一把雪菜同烧，咸鲜更足，是浙江人配粥的常见做法。",
    "改用砂锅小火慢煨十分钟，豆腐里外都吸饱汤汁，冬天吃着暖和。"
  ],
  "serving_suggestion": "连汤汁一起装盘，撒小葱末，配一碗白饭，汤汁拌饭吃最香。",
  "storage": "冷藏可放两天，回锅小火加热并补两勺清水，不要大火收干变咸。",
