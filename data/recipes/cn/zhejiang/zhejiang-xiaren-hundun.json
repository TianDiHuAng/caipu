  "equipment": [
    "汤锅",
    "大碗",
    "擀面杖",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加少许盐和冷水揉成偏硬的面团，盖布醒二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "面团要和得比平常的面皮硬一些，擀出来才薄而不破。",
      "visual_cue": "面团光滑紧实，按压回弹快"
    },
    {
      "n": 2,
      "text": "虾仁挑去背上的黑线剁成粗粒，与猪肉末、姜末、料酒拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别用刀背拍成泥，留点颗粒咬着才弹牙。",
      "visual_cue": "虾肉颗粒分明，馅料黏稠有光"
    },
    {
      "n": 3,
      "text": "面团擀成薄如纸的大片，切成八厘米见方的皮，叠好备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "边擀边撒干粉，皮才不会粘在一起撕不开。",
      "visual_cue": "皮薄能透光，四角方正"
    },
    {
      "n": 4,
      "text": "取一张皮放少许馅，五指收拢捏成小馄饨，逐个摆开。",
      "time_min": 12,
      "heat": "无火",
      "tip": "馅只放一小勺，皮薄馅多煮的时候容易破。",
      "visual_cue": "馄饨形如小灯笼，收口紧实"
    },
    {
      "n": 5,
      "text": "鸡蛋摊成薄蛋皮切丝，碗底放紫菜、香油、盐与白胡椒。",
      "time_min": 5,
      "heat": "小火",
      "tip": "碗底调料先放好，热汤一冲香味立刻就出来。",
      "visual_cue": "蛋丝金黄细长，碗底调料铺匀"
    },
    {
      "n": 6,
      "text": "汤锅水大滚下馄饨，浮起后再煮一分钟，连汤冲入碗中撒葱末。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水必须大滚才下锅，温吞水煮出来皮会烂。",
      "visual_cue": "馄饨鼓胀浮起，皮透亮见馅"
    }
  ],
  "tips": [
    "一次多包些放冷冻，冻硬后装袋，随吃随煮不用解冻。",
    "汤底改用鸡汤或骨头汤，鲜味比清水强很多。",
    "馅里加一点荸荠碎，咬着有脆感，口感层次更丰富。"
  ],
  "common_mistakes": [
    "皮擀得太厚，煮出来像小饺子一样，一点没有馄饨的滑溜感。",
    "馅放太多，下锅一煮全部撑破，汤里漂满肉末。",
    "水没开就下馄饨，皮在锅里化开，捞起来只剩一团。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鱼肉",
      "ratio": "200克:200克",
      "note": "鱼肉须剁细并加一勺猪油防柴。"
    },
    {
      "original": "紫菜",
      "substitute": "海苔",
      "ratio": "5克:5克",
      "note": "海苔更易软，出锅前再放。"
    }
  ],
  "variations": [
    "汤底加一勺猪油和少许酱油，是最经典的江南弄堂做法。",
    "把馅换成荠菜肉馅，就是春天限定的荠菜小馄饨，清香更足。"
  ],
  "serving_suggestion": "连汤盛碗，撒上蛋丝与葱末，配一小碟米醋一起吃。",
  "storage": "生馄饨冷冻可存两周，煮时不必解冻；包好的当天煮口感最好。",
