  "equipment": [
    "炒锅",
    "大碗",
    "漏勺",
    "盘子",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉加白糖，分次倒温水搅成絮状。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水慢慢加，面团软硬才合适。，看准状态再往下做。",
      "visual_cue": "粉成絮状，无干粉，这一点很关键。"
    },
    {
      "n": 2,
      "text": "揉成光滑面团，盖湿布醒二十分钟。，看准状态再往下做。",
      "time_min": 25,
      "heat": "无火",
      "tip": "醒过的面团不裂，包馅才好捏。，看准状态再往下做。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 3,
      "text": "面团分成十二个小剂子，逐个搓圆按扁。，看准状态再往下做。",
      "time_min": 9,
      "heat": "无火",
      "tip": "大小一致，炸的时间才同步。，看准状态再往下做。",
      "visual_cue": "剂子圆整，边缘无裂"
    },
    {
      "n": 4,
      "text": "按扁的剂子包入一勺红豆沙，收口捏紧搓圆。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "收口捏牢，炸的时候才不会漏馅。，看准状态再往下做。",
      "visual_cue": "圆球光洁，无裂缝，这一点很关键。"
    },
    {
      "n": 5,
      "text": "圆球表面沾一层清水，滚上白芝麻。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "沾水芝麻才粘得牢，不掉进油锅。，看准状态再往下做。",
      "visual_cue": "芝麻裹满，分布均匀"
    },
    {
      "n": 6,
      "text": "炒锅倒植物油烧到四成热，下麻团小火炸。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "低油温慢慢炸，里面才熟外壳不焦。，看准状态再往下做。",
      "visual_cue": "麻团浮起，慢慢膨胀"
    },
    {
      "n": 7,
      "text": "用锅铲轻轻按压麻团，压一次鼓一次。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "边炸边压，麻团才会空心鼓大。，看准状态再往下做。",
      "visual_cue": "体积变大，表面圆鼓"
    },
    {
      "n": 8,
      "text": "炸到金黄浮起，捞出沥油。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "颜色金黄就捞出，再炸会发黑。，看准状态再往下做。",
      "visual_cue": "外壳金黄，芝麻喷香"
    }
  ],
  "tips": [
    "油温控制在四成热，太高外面焦里面生。",
    "边炸边用铲子压，麻团才鼓得又圆又空。",
    "表面沾水再滚芝麻，炸的时候不掉。"
  ],
  "common_mistakes": [
    "油温太高，麻团裂开漏馅。，这一点很关键。",
    "不压麻团，炸出来是实心硬球。，这一点很关键。",
    "收口没捏紧，炸时豆沙流进油里。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "红豆沙",
      "substitute": "黑芝麻馅",
      "ratio": "120 克:110 克",
      "note": "香气更浓，糖可减。"
    },
    {
      "original": "白芝麻",
      "substitute": "黑芝麻",
      "ratio": "80 克:80 克",
      "note": "颜色深，炸时不易看出焦。"
    }
  ],
  "variations": [
    "馅里加一小块猪油，更香润。，这一点很关键。",
    "换成芋泥馅，口感更绵。，这一点很关键。"
  ],
  "serving_suggestion": "趁热吃，配一杯豆浆。，这一点很关键。",
  "storage": "当日吃完，冷藏后外壳会软。，这一点很关键。",
