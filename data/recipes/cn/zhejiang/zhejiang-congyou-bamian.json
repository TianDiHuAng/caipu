          "name_en": "peanut oil",
          "amount": 70,
          "unit": "ml",
          "note": "熬葱油",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 30,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "老抽",
          "name_en": "dark soy sauce",
          "amount": 5,
          "unit": "ml",
          "note": "上色",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调节",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "汤锅",
    "漏勺",
    "拌面碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小葱洗净后彻底晾干，切成五厘米长的葱段备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "葱上带水下油锅会炸得四处溅，一定要晾干。",
      "visual_cue": "葱段干燥无水滴，长短整齐"
    },
    {
      "n": 2,
      "text": "炒锅倒花生油，冷油下葱段，开小火慢慢熬。，动作要轻一点。",
      "time_min": 3,
      "heat": "小火",
      "tip": "冷油下葱才熬得出香，热油下去一下就焦了。",
      "visual_cue": "葱段沉在油里，油面平静"
    },
    {
      "n": 3,
      "text": "小火熬八分钟，把葱段熬到深褐发脆再捞出。，注意观察火候。",
      "time_min": 8,
      "heat": "小火",
      "tip": "葱段颜色变深但别发黑，黑了整锅油都发苦。",
      "visual_cue": "葱段褐脆卷曲，油呈琥珀色"
    },
    {
      "n": 4,
      "text": "葱油里加生抽、老抽、盐与白糖，小火搅到糖完全化开。",
      "time_min": 2,
      "heat": "小火",
      "tip": "糖化开才算好，不然拌面会有颗粒感。",
      "visual_cue": "酱汁油亮，尝起来咸甜平衡"
    },
    {
      "n": 5,
      "text": "汤锅烧开水，下面条煮三分钟，中途点一次凉水。",
      "time_min": 5,
      "heat": "大火",
      "tip": "点凉水让面里外同熟，拌起来更弹牙。",
      "visual_cue": "面条浮起，断面无白芯"
    },
    {
      "n": 6,
      "text": "面捞出沥干水分，趁热倒进拌面碗里备用。，中间别急着翻动。",
      "time_min": 1,
      "heat": "无火",
      "tip": "一定要沥干，带水会把葱油和酱汁都冲淡。",
      "visual_cue": "面条松散，碗底不见积水"
    },
    {
      "n": 7,
      "text": "淋上两勺葱油与一勺酱汁，用筷子从下往上挑拌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "挑着拌才不会把面搅断，也拌得更匀。",
      "visual_cue": "面条根根油亮，颜色均匀"
    },
    {
      "n": 8,
      "text": "撒上熬好的脆葱段，趁热立刻上桌拌开吃。，保持锅里有底油。",
      "time_min": 1,
      "heat": "无火",
      "tip": "脆葱段最后放，早了会被面焖软不酥。",
      "visual_cue": "面上一撮褐脆葱段，香气直往上冒"
    }
  ],
  "tips": [
    "葱绿和葱白分开熬，葱白先下更不易焦。",
    "一次可以多熬些葱油，冷藏能存一周。",
    "面选细圆面，拌起来最容易挂油。",
    "加一小勺猪油，香气会更厚重。，口感会更好一些。"
  ],
  "common_mistakes": [
    "葱没晾干就下锅，油溅得灶台一片狼藉。",
    "大火熬葱，葱段一黑整锅油都发苦。，整锅味道都跟着毁了。",
    "面煮好不沥干，拌出来湿乎乎一股水味。"
  ],
  "substitutions": [
    {
      "original": "面条",
      "substitute": "米粉",
      "ratio": "250克:250克",
      "note": "煮两分钟即可，拌时多加点葱油。"
    },
    {
      "original": "生抽",
      "substitute": "酱油",
      "ratio": "30毫升:30毫升",
      "note": "咸味更重，盐可以不放。"
    }
  ],
  "variations": [
    "加一勺虾仁同拌，做成虾仁葱油面。，口味层次更丰富。",
    "撒一把熟芝麻，香气更足口感更丰富。"
  ],
  "serving_suggestion": "装碗后立刻拌开，葱香扑鼻面条油亮，配一碗清汤正好。",
  "storage": "葱油冷藏一周，面条当天吃完不留隔夜。复热时加两勺清水，口感能恢复。",
