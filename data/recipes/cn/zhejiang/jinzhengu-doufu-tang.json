  "equipment": [
    "汤锅",
    "汤勺",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "金针菇切掉老根，用手撕成小束，用清水冲洗干净沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "根部泥沙多，切掉一厘米更干净。",
      "visual_cue": "菇束松散、不见黑根"
    },
    {
      "n": 2,
      "text": "北豆腐切成两厘米见方的小块，放淡盐水里泡三分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐水泡过，豆腐煮时不易碎。",
      "visual_cue": "豆腐块紧实、表面光洁"
    },
    {
      "n": 3,
      "text": "汤锅下植物油烧热，放生姜丝小火煸出香味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "姜丝煸香再加水，汤底更清爽。",
      "visual_cue": "姜丝微卷、香气散出"
    },
    {
      "n": 4,
      "text": "倒入清水大火烧开，下豆腐块转中火煮三分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆腐先煮，汤里带上豆香。",
      "visual_cue": "豆腐浮起、汤面有小泡"
    },
    {
      "n": 5,
      "text": "下金针菇继续煮三分钟，煮到菇身变软发亮。",
      "time_min": 4,
      "heat": "中火",
      "tip": "金针菇必须煮熟透，生食有风险。",
      "visual_cue": "菇身变软、汤色微白"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，用汤勺轻轻推匀后立即关火。",
      "time_min": 1,
      "heat": "无火",
      "tip": "盐最后放，汤味才清鲜。",
      "visual_cue": "汤色清亮、咸淡适口"
    },
    {
      "n": 7,
      "text": "淋香油，撒葱花与香菜段，盛入汤碗即可上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香菜最后放，香气才不散。",
      "visual_cue": "葱绿点缀、汤面浮油花"
    }
  ],
  "tips": [
    "金针菇选菌盖小柄细的，口感更嫩。",
    "豆腐换成嫩豆腐也行，但下锅后别多搅。",
    "下锅前加几颗枸杞同煮，汤色会更清亮好看。"
  ],
  "common_mistakes": [
    "金针菇煮两分钟就出锅，嚼着脆生还带土味。",
    "豆腐下锅用勺猛搅，最后全成碎渣。",
    "盐放得太早，豆腐出水汤味变寡。"
  ],
  "substitutions": [
    {
      "original": "金针菇",
      "substitute": "香菇",
      "ratio": "150g 对 120g",
      "note": "切片后需多煮两分钟。"
    },
    {
      "original": "北豆腐",
      "substitute": "嫩豆腐",
      "ratio": "250g 对 250g",
      "note": "口感更滑，搅动要轻。"
    }
  ],
  "variations": [
    "加一把虾皮，鲜味立刻提升一档。",
    "打入一个鸡蛋的蛋花，汤会更有饱腹感一些。"
  ],
  "serving_suggestion": "饭前喝汤，或配主食当清口汤都合适。",
  "storage": "当天喝完，金针菇隔夜口感变韧。",
