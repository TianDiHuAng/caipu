    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "河虾放清水里养十分钟，吐掉泥沙后洗净。，看准状态再往下走。",
      "time_min": 12,
      "heat": "无火",
      "tip": "多换两次水，虾才干净没土味。，这一点别省。",
      "visual_cue": "虾身透亮，须脚完整"
    },
    {
      "n": 2,
      "text": "小锅倒绍兴酒、生抽和冰糖，小火煮到糖化开。，看准状态再往下走。",
      "time_min": 5,
      "heat": "小火",
      "tip": "汁一开就关火，酒香才不跑。，这一点别省。",
      "visual_cue": "糖化开，酒香清冽，这一点很关键。"
    },
    {
      "n": 3,
      "text": "汁里放姜丝，彻底放凉到室温备用。，看准状态再往下走。",
      "time_min": 8,
      "heat": "无火",
      "tip": "热汁会把虾烫熟，必须凉透。，这一点别省。",
      "visual_cue": "汁液澄澈，姜丝下沉"
    },
    {
      "n": 4,
      "text": "虾沥干水，剪掉虾枪和长须。，看准状态再往下走。",
      "time_min": 4,
      "heat": "无火",
      "tip": "剪过更好入口，也更易入味。，这一点别省。",
      "visual_cue": "虾枪平整，虾身完整"
    },
    {
      "n": 5,
      "text": "虾放进凉透的醉汁里，加香醋和盐拌匀。，看准状态再往下走。",
      "time_min": 3,
      "heat": "无火",
      "tip": "醋最后放，酸味才清亮。，这一点别省。",
      "visual_cue": "虾身浸没，汁面漂油花"
    },
    {
      "n": 6,
      "text": "密封冷藏腌三小时，中途翻动一次。，看准状态再往下走。",
      "time_min": 183,
      "heat": "无火",
      "tip": "时间不够味进不去，别心急。，这一点别省。",
      "visual_cue": "虾壳转红，汁色变深"
    },
    {
      "n": 7,
      "text": "取出摆盘，淋两勺醉汁，撒葱段。，看准状态再往下走。",
      "time_min": 3,
      "heat": "无火",
      "tip": "淋汁让表面也有酒香。，这一点别省。",
      "visual_cue": "虾壳油亮，葱段翠绿"
    }
  ],
  "tips": [
    "醉汁要彻底放凉再下虾，热汁会烫熟。",
    "冷藏腌三小时以上，味道才进得去。",
    "虾要活虾，肉才紧实弹牙。，这一点很关键。"
  ],
  "common_mistakes": [
    "热汁直接泡虾，虾肉全变白。，这一点很关键。",
    "腌的时间不够，只有咸味没酒香。，这一点很关键。",
    "虾没吐净泥沙，吃着有土味。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "河虾",
      "substitute": "基围虾",
      "ratio": "500 克:500 克",
      "note": "个头更大，腌的时间加一小时。"
    },
    {
      "original": "绍兴酒",
      "substitute": "花雕酒",
      "ratio": "250 毫升:250 毫升",
      "note": "香气更浓，甜度略高。"
    }
  ],
  "variations": [
    "加几片柠檬，果香更清爽。，这一点很关键。",
    "换成花螺同醉，口感更弹。，这一点很关键。"
  ],
  "serving_suggestion": "冰镇后上桌，配黄酒最好。，这一点很关键。",
  "storage": "冷藏不超过一天，隔夜虾肉会发软。",
