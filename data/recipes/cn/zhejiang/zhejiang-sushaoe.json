  "equipment": [
    "蒸锅",
    "平底锅",
    "纱布",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干豆腐皮用温水泡软，捞出摊平，用厨房纸吸掉表面水分。",
      "time_min": 15,
      "heat": "无火",
      "tip": "水分不吸干，卷的时候皮会滑开卷不紧。",
      "visual_cue": "豆腐皮柔软有韧劲，表面不滴水"
    },
    {
      "n": 2,
      "text": "香菇丝与笋丝用少许油炒香，加一半生抽与白糖炒匀盛出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "馅料要炒到没有水汽，否则卷里会返潮。",
      "visual_cue": "馅丝干香松散，颜色变深"
    },
    {
      "n": 3,
      "text": "把豆腐皮摊在纱布上，刷一层生抽与香油混合的酱汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷得均匀，成品的颜色才不会一块深一块浅。",
      "visual_cue": "皮面呈浅褐色，酱汁不堆积"
    },
    {
      "n": 4,
      "text": "在豆腐皮一侧铺上香菇笋丝，卷成手腕粗的长卷。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一边卷一边收紧，卷得紧切的时候才不散。",
      "visual_cue": "卷体紧实圆润，表面无皱褶"
    },
    {
      "n": 5,
      "text": "用纱布把卷包紧，两端折起扎牢，上蒸锅大火蒸十分钟。",
      "time_min": 12,
      "heat": "大火",
      "tip": "包紧再蒸，卷体才会定型成鹅颈般的圆柱。",
      "visual_cue": "卷体鼓起变硬，纱布外侧无水汽滴落"
    },
    {
      "n": 6,
      "text": "取出放凉十分钟，拆开纱布，表面刷老抽与五香粉混合的酱汁。",
      "time_min": 12,
      "heat": "无火",
      "tip": "一定要放凉之后再拆，热的卷一拆就塌。",
      "visual_cue": "卷体定型不回缩，表面染色均匀"
    },
    {
      "n": 7,
      "text": "平底锅中火放花生油，豆腐卷下锅滚动煎到各面金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "用筷子轻推着滚一圈，各面受热才均匀。",
      "visual_cue": "表面起金黄脆皮，有轻微噼啪声"
    },
    {
      "n": 8,
      "text": "锅里留少许油，加剩下的生抽与白糖、少量清水烧成薄汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汁要稀薄，只为挂味，太稠会把脆皮泡软。",
      "visual_cue": "汁液微稠发亮，冒细泡"
    },
    {
      "n": 9,
      "text": "豆腐卷放回锅中滚一遍汁，切片装盘，撒葱段。",
      "time_min": 4,
      "heat": "小火",
      "tip": "切片时刀要快，来回锯会把脆皮压碎。",
      "visual_cue": "切片断面分明，外皮红亮内里分层"
    }
  ],
  "tips": [
    "豆腐皮选薄而韧的，太厚卷起来容易裂。",
    "馅料可加一点笋干，口感更有嚼劲。",
    "想更香可以把五香粉换成十三香。",
    "冷藏后切片冷吃，也是不错的凉菜。"
  ],
  "common_mistakes": [
    "豆腐皮泡得太软，卷的时候一拉就破。",
    "卷得太松，切的时候馅料全都掉出来。",
    "蒸好后不晾凉就拆纱布，卷体塌成扁条。"
  ],
  "substitutions": [
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "60克:60克",
      "note": "切丝后口感更脆，香气略淡。"
    },
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "80克:100克",
      "note": "质地更嫩，炒的时间缩短一分钟。"
    }
  ],
  "variations": [
    "卷里加一层紫菜，切开的断面更好看。",
    "做成小卷下锅炸制，可以当作宴席的前菜。"
  ],
  "serving_suggestion": "切片摆盘，淋少许锅里的薄汁，冷热皆宜，作为素宴的头盘很体面。",
  "storage": "冷藏三天，冷冻一周，复热用平底锅小火两面各煎一分钟。",
