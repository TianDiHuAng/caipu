  "steps": [
    {
      "n": 1,
      "text": "冬笋剥壳去老根，切薄片后放沸水里焯三分钟去掉涩味。",
      "time_min": 10,
      "heat": "中火",
      "tip": "冬笋不焯会发涩，焯水这步省不得。",
      "visual_cue": "笋片颜色转浅，闻着没有生涩气"
    },
    {
      "n": 2,
      "text": "嫩豆腐切成三厘米方块，放淡盐水里泡五分钟让表面紧实。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐用淡盐水泡过，下锅不容易碎。",
      "visual_cue": "豆腐块完整不散，表面微微收紧"
    },
    {
      "n": 3,
      "text": "汤锅倒高汤，下姜丝与香菇片，中火煮开转小火煮五分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "香菇先煮能把鲜味煮进汤里。",
      "visual_cue": "汤色微黄清亮，香菇片舒展"
    },
    {
      "n": 4,
      "text": "放入笋片与豆腐块，小火煮六分钟，中途别用勺搅动。",
      "time_min": 7,
      "heat": "小火",
      "tip": "豆腐下锅后推锅不搅，块才能保持完整。",
      "visual_cue": "豆腐轻轻浮起，笋片沉在锅底"
    },
    {
      "n": 5,
      "text": "加盐、生抽与白胡椒粉调味，淋芝麻油，撒葱花即可出锅。",
      "time_min": 4,
      "heat": "无火",
      "tip": "调味最后放，早放盐豆腐会出水变老。",
      "visual_cue": "汤清味鲜，葱花翠绿浮面"
    }
  ],
  "tips": [
    "冬笋一定要焯水，涩味才去得干净。",
    "豆腐用淡盐水泡过，煮的时候不容易碎。",
    "全程小火，汤才不会浑，豆腐也不会散。",
    "白胡椒粉别省，提鲜去腥的效果很明显。"
  ],
  "common_mistakes": [
    "冬笋没焯水直接下锅，汤带一股涩味。",
    "用勺反复搅动，豆腐碎成一锅豆花。",
    "大火滚煮，汤浑豆腐老，笋片也没型。",
    "一开始就放盐，豆腐被盐逼出水，煮完又老又硬。"
  ],
  "substitutions": [
    {
      "original": "冬笋",
      "substitute": "春笋",
      "ratio": "200克:200克",
      "note": "春笋涩味更重，焯水加一分钟。"
    },
    {
      "original": "嫩豆腐",
      "substitute": "内酯豆腐",
      "ratio": "300克:300克",
      "note": "更嫩，煮的时间减两分钟。"
    }
  ],
  "variations": [
    "加几片火腿同煮，汤头立刻鲜上一层。",
    "放一小把洗净的青菜心，汤里多一抹绿色，看着更有食欲。",
    "换成鸡汤打底，鲜味更厚实，冬天喝起来也更暖身。"
  ],
  "serving_suggestion": "盛进白瓷汤碗，撒葱花与白胡椒粉，配一碗米饭，清淡又暖胃，很适合配油腻的主菜。",
  "storage": "冷藏可放一天，复热小火加热至微沸，豆腐不宜久煮。",
