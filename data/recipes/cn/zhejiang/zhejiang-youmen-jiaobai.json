  "steps": [
    {
      "n": 1,
      "text": "茭白剥去外层青壳，削掉根部老皮，切成三厘米见方的滚刀块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "根部老皮一定要削干净，留着嚼不动还发柴。",
      "visual_cue": "茭白切面洁白，块形均匀不散"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧到五成热，下茭白块中火煎到四面微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先煎出焦边，茭白才香，直接炖只会寡淡。",
      "visual_cue": "块面泛出金黄斑点，边缘收紧"
    },
    {
      "n": 3,
      "text": "下姜片与葱段煸香，烹入料酒去青气，加生抽与老抽翻匀上色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "料酒沿热锅烹入，青涩气才散得掉，直接倒进汤里没用。",
      "visual_cue": "茭白块裹上酱色，油光发亮"
    },
    {
      "n": 4,
      "text": "加白糖与半碗清水，加盖小火烧十分钟至汤汁减半。",
      "time_min": 10,
      "heat": "小火",
      "tip": "水别多，油焖靠的是油和糖慢慢收，不是汤煮。",
      "visual_cue": "汤汁变稠起泡，块身变软"
    },
    {
      "n": 5,
      "text": "开盖转大火收汁，不停翻动让酱汁裹匀每一块。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水不要多放，油焖靠的是油和糖慢慢收，不是用水去煮。",
      "visual_cue": "酱汁紧裹块面，锅底几乎无汤"
    },
    {
      "n": 6,
      "text": "淋入香油，撒上余下的葱段快速翻匀后即可出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "香油最后淋上，光泽和葱香都能完整保住不失。",
      "visual_cue": "色泽红亮油润，葱段翠绿"
    }
  ],
  "tips": [
    "茭白挑表皮青白、捏着硬实的，发软发空的里面已经糠了。",
    "加一勺猪油同焖，香气比纯植物油厚得多。",
    "想更清爽可把白糖减半，多加两勺高汤焖，口味偏咸鲜。"
  ],
  "common_mistakes": [
    "茭白不煎直接加汤焖，出不来焦香，吃着像水煮一样寡淡。",
    "白糖放得太多又懒得收汁，成品黏甜发腻，完全吃不出茭白的清鲜。",
    "用大火焖制，水干得太快，茭白外面焦里面还生。"
  ],
  "substitutions": [
    {
      "original": "茭白",
      "substitute": "冬笋",
      "ratio": "350克:350克",
      "note": "冬笋须先焯水五分钟去涩。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "8克:10克",
      "note": "冰糖化得慢，须提前加清水一起烧。"
    }
  ],
  "variations": [
    "加几片咸肉同焖，油润咸香，是江南春天的家常版本。",
    "把茭白切丝改成炒，两分钟出锅，口感更脆爽。"
  ],
  "serving_suggestion": "热吃最佳，酱汁拌饭极香，也适合冷后当小菜佐粥。",
  "storage": "冷藏可存两天，复热须加一勺水小火焖三分钟，避免发干。",
