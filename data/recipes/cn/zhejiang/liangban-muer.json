    "漏勺",
    "拌菜盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干木耳用冷水泡发两小时，中途换一次水，泡到完全舒展软弹。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷水泡发口感脆，热水泡会发黏。",
      "visual_cue": "木耳舒展成片、根部无硬芯"
    },
    {
      "n": 2,
      "text": "泡好的木耳剪去根部硬蒂，撕成入口大小的小朵。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部硬蒂嚼不动，必须剪干净。",
      "visual_cue": "朵形均匀、无黑色硬块"
    },
    {
      "n": 3,
      "text": "汤锅加清水与盐烧开，木耳下锅焯三分钟捞出。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯水能去土腥味，也让木耳更脆。",
      "visual_cue": "木耳卷边、水色微褐"
    },
    {
      "n": 4,
      "text": "焯好的木耳立刻过凉水降温，捞出彻底沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "沥干水才挂得住调料，否则味淡。",
      "visual_cue": "木耳干爽、盆底不见积水"
    },
    {
      "n": 5,
      "text": "胡萝卜丝与木耳、大蒜末、小米辣一起放入拌菜盆。",
      "time_min": 3,
      "heat": "无火",
      "tip": "胡萝卜切细些，生吃才不硬。",
      "visual_cue": "丝料分明、颜色红黑相间"
    },
    {
      "n": 6,
      "text": "植物油烧到冒烟泼在蒜末上激香，再加香醋、生抽与白糖拌匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "热油泼蒜才香，油温不够就发涩。",
      "visual_cue": "蒜香冲鼻、木耳油亮"
    },
    {
      "n": 7,
      "text": "撒上葱花拌匀，静置十分钟让调料入味后装盘。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置一会儿，酸辣味更透。",
      "visual_cue": "调味均匀、盘底略有汤汁"
    }
  ],
  "tips": [
    "冷天泡木耳要放足时间，泡透才脆。",
    "焯水后过凉水，口感会明显更弹。",
    "拌好后冷藏半小时，风味更清爽。"
  ],
  "common_mistakes": [
    "木耳用热水泡发，泡出来软塌发黏。",
    "根部硬蒂没有剪净，吃起来硌牙。",
    "焯水后不沥干就拌，调料全沉在盆底。"
  ],
  "substitutions": [
    {
      "original": "胡萝卜",
      "substitute": "黄瓜",
      "ratio": "60g 对 60g",
      "note": "更清爽，需提前撒盐杀水。"
    },
    {
      "original": "小米辣",
      "substitute": "辣椒油",
      "ratio": "8g 对 10ml",
      "note": "辣味更均匀，油量需减。"
    }
  ],
  "variations": [
    "加一把香菜同拌，香气会更足更清爽。",
    "把香醋换成陈醋，颜色深、酸味更厚。"
  ],
  "serving_suggestion": "冷藏后当开胃小菜，配粥配面都合适。",
  "storage": "密封冷藏可放两天，吃前再拌一次。",
