        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "料理机",
    "汤锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑芝麻小火炒到噼啪作响，倒进料理机打成细粉，加白糖与融化黄油拌成团。",
      "time_min": 10,
      "heat": "小火",
      "tip": "芝麻炒香再打，香味才足。",
      "visual_cue": "芝麻出油、馅料成团"
    },
    {
      "n": 2,
      "text": "馅料分成小份搓圆，冷藏十五分钟定型，包的时候才不粘手。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冷藏定型，包起来更容易。",
      "visual_cue": "馅球圆整、手感偏硬"
    },
    {
      "n": 3,
      "text": "糯米粉加温水揉成不粘手的面团，分成小剂子按扁，包入馅球收口搓圆。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面团软硬适中，收口才严。",
      "visual_cue": "汤圆光滑、收口无裂"
    },
    {
      "n": 4,
      "text": "水烧到大滚下汤圆，煮到浮起后加半碗冷水，再次浮起即熟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "点一次冷水，皮才不会破。",
      "visual_cue": "汤圆浮起、皮透亮"
    }
  ],
  "tips": [
    "芝麻馅要加足油脂，煮好咬开才会流心。",
    "糯米面团要用温水揉，皮才够软且久煮不裂。",
    "煮汤圆点一次冷水，内外受热均匀不易破皮。"
  ],
  "common_mistakes": [
    "馅料太干，煮好切开是硬块不流心。",
    "面团太硬，包的时候收口开裂露馅。",
    "全程大火滚煮，汤圆破皮漏馅成一锅糊。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "猪油",
      "ratio": "60g 对 60g",
      "note": "传统做法更香，冷却后偏硬。"
    },
    {
      "original": "黑芝麻",
      "substitute": "花生",
      "ratio": "100g 对 100g",
      "note": "换成花生馅，炒香后打碎。"
    }
  ],
  "variations": [
    "酒酿版：煮好后加两勺酒酿同煮。",
    "桂花版：出锅撒 2g 干桂花增香。"
  ],
  "serving_suggestion": "盛碗连汤一起上，撒少许干桂花，趁热吃。",
  "storage": "生汤圆冷冻可存 1 个月，煮时无需解冻。",
  "nutrition_estimate": {
    "basis": "每份（约 120g）",
