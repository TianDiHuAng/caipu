  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 400,
          "unit": "g",
          "note": "切厚片",
          "optional": false
        },
        {
          "name": "小白菜",
          "name_en": "bok choy",
          "amount": 250,
          "unit": "g",
          "note": "取嫩菜心洗净",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 40,
          "unit": "ml",
          "note": "煎豆腐",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 15,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调节",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 3,
          "unit": "g",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 10,
          "unit": "g",
          "note": "勾芡",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "漏勺",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成两厘米厚的方块，用厨房纸吸干表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "表面干爽才煎得金黄，带水下锅只会溅油。",
      "visual_cue": "豆腐块表面不见水光，纸已湿透"
    },
    {
      "n": 2,
      "text": "小白菜掰开叶片逐片冲洗，切成五厘米长的段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "菜梗根部最易藏泥，要掰开一片片洗。",
      "visual_cue": "菜叶干净，根部不见泥点"
    },
    {
      "n": 3,
      "text": "平底锅放一半花生油烧热，把豆腐块平铺进去。",
      "time_min": 2,
      "heat": "中火",
      "tip": "一块块分开摆，粘在一起翻面时就碎了。",
      "visual_cue": "豆腐块贴实锅面，油微微冒烟"
    },
    {
      "n": 4,
      "text": "中火煎四分钟到一面金黄定型，再翻面煎另一面。",
      "time_min": 6,
      "heat": "中火",
      "tip": "没定型别急着翻，等它自己脱锅才完整。",
      "visual_cue": "两面金黄结壳，边缘微微鼓起"
    },
    {
      "n": 5,
      "text": "煎好的豆腐盛出，锅里补油下菜心大火快炒。，保持锅里有底油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "菜心一定要大火，火小了出水发黄。，顺序不能颠倒。",
      "visual_cue": "菜梗颜色转深绿，叶片略塌"
    },
    {
      "n": 6,
      "text": "加生抽、白糖与半碗清水烧开，放回豆腐块。，手法稳一些更好。",
      "time_min": 2,
      "heat": "大火",
      "tip": "水别太多，收汁时才有浓味裹得住豆腐。",
      "visual_cue": "汤汁滚起呈浅酱色，豆腐浮起"
    },
    {
      "n": 7,
      "text": "转中小火烧五分钟，让豆腐把汤汁吸进去。，动作要轻一点。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "用勺背轻推，别用铲子翻，豆腐才不破。",
      "visual_cue": "汤汁收到一半，豆腐膨胀发亮"
    },
    {
      "n": 8,
      "text": "玉米淀粉加水调匀淋入，轻推到汤汁浓稠挂勺。",
      "time_min": 2,
      "heat": "中火",
      "tip": "芡汁浓一点才裹得住，太稀就滑走了。",
      "visual_cue": "汤汁浓稠挂勺，表面泛亮"
    },
    {
      "n": 9,
      "text": "加盐调味后起锅装盘，豆腐在下菜心在上。，注意观察火候。",
      "time_min": 1,
      "heat": "中火",
      "tip": "菜心摆面上颜色好看，也不会被压得发黄。",
      "visual_cue": "豆腐金黄，菜心翠绿，汁水清亮"
    }
  ],
  "tips": [
    "豆腐选北豆腐，煎的时候不容易散。",
    "菜心选嫩的，老梗要撕去外皮。，口感会更好一些。",
    "煎豆腐撒一层薄盐更入味也不粘锅。",
    "加几片香菇同烧，鲜味更足。，味道能更足。"
  ],
  "common_mistakes": [
    "豆腐带水下锅，油花四溅还粘得一塌糊涂。",
    "菜心小火炒，出水发黄一点不脆。，白忙一场很可惜。",
    "翻豆腐用铲子使劲推，最后全成豆腐碎。"
  ],
  "substitutions": [
    {
      "original": "小白菜",
      "substitute": "菠菜",
      "ratio": "250克:250克",
      "note": "菠菜先焯水去草酸再炒。"
    },
    {
      "original": "豆腐",
      "substitute": "油豆腐",
      "ratio": "400克:250克",
      "note": "吸汁力强，烧的时间减两分钟。"
    }
  ],
  "variations": [
    "加一把虾仁同烧，鲜味更足。，口味层次更丰富。",
    "放几个肉丸同烧，做成荤素搭配版。，家里人会更爱吃。"
  ],
  "serving_suggestion": "连汁装盘，豆腐外香里嫩，菜心清甜，配米饭最下饭。",
  "storage": "冷藏两天，复热加两勺水小火焖三分钟恢复软嫩。",
