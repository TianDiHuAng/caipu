        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "炒锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡斩成四厘米见方的块，用清水冲洗干净后沥干水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鸡块沥干再炒，下锅才不溅油。",
      "visual_cue": "鸡块干爽、表面无血水"
    },
    {
      "n": 2,
      "text": "大蒜拍破去皮，生姜切厚片，罗勒摘下叶片洗净备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蒜拍破才出味，整瓣太温和。",
      "visual_cue": "蒜瓣裂开、姜片厚薄一致"
    },
    {
      "n": 3,
      "text": "炒锅下香油，小火把大蒜与生姜片煎到表面金黄出香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "香油不耐高温，一定要小火。",
      "visual_cue": "蒜瓣金黄、姜片卷边"
    },
    {
      "n": 4,
      "text": "下鸡块转中火煎到两面金黄，逼出皮下的鸡油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "鸡皮煎香，成品才不腥不腻。",
      "visual_cue": "鸡皮金黄收缩、锅底有油"
    },
    {
      "n": 5,
      "text": "加生抽、米酒与冰糖翻匀，烧开后转小火加盖焖二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "全程不加一滴水，靠米酒焖熟。",
      "visual_cue": "汤汁冒小泡、鸡块上色"
    },
    {
      "n": 6,
      "text": "开盖转中火收汁，边收边翻让鸡块裹上浓亮的酱汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "收汁时勤翻，糖分容易糊底。",
      "visual_cue": "汤汁浓稠挂勺、鸡块红亮"
    },
    {
      "n": 7,
      "text": "关火撒入罗勒叶，盖上锅盖焖一分钟激出香气即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "罗勒靠余温焖香，久煮会发黑。",
      "visual_cue": "罗勒叶微蔫、香气浓郁"
    }
  ],
  "tips": [
    "用三黄鸡比肉鸡香，肉质更紧实。",
    "米酒换成黄酒也可以，只是甜味会稍弱一些。",
    "砂锅上桌保温性好，吃着更有仪式感。"
  ],
  "common_mistakes": [
    "焖的时候加水，汤汁稀释后味全散了。",
    "香油用大火煎蒜，油一变苦整锅都毁。",
    "收汁的时候走神，糖分焦掉整锅都带苦味。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "600g 对 600g",
      "note": "更嫩不柴，焖制时间减五分钟。"
    },
    {
      "original": "罗勒",
      "substitute": "香葱",
      "ratio": "15g 对 20g",
      "note": "香气不同，但同样清口。"
    }
  ],
  "variations": [
    "加几颗干辣椒同焖，多一层微辣。",
    "用砂锅从煎到焖一气呵成，香气更集中。"
  ],
  "serving_suggestion": "趁热连锅端上桌，配一碗白米饭最下饭。",
  "storage": "冷藏可放两天，复热后收汁更浓。",
