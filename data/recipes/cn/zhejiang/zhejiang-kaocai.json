    "锅铲",
    "刀",
    "砧板",
    "漏盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小白菜整棵掰开洗净，沥水后放在通风处晾到表面发蔫。",
      "time_min": 8,
      "heat": "无火",
      "tip": "菜要晾到微软，出水少了后面才烤得香。",
      "visual_cue": "叶片发蔫下垂，颜色转深绿"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，中火把姜片和八角炒出香味后捞出八角。",
      "time_min": 5,
      "heat": "中火",
      "tip": "八角炒香就捞，留久了会盖住菜的清甜。",
      "visual_cue": "油面泛香，姜片边缘微卷"
    },
    {
      "n": 3,
      "text": "下小白菜大火翻炒到全部塌软出水，体积缩到一半。",
      "time_min": 8,
      "heat": "大火",
      "tip": "这步要大火，炒出水分菜才不会发涩。",
      "visual_cue": "菜叶塌软贴锅，锅底见清汤"
    },
    {
      "n": 4,
      "text": "加生抽、老抽和冰糖翻匀，转小火加盖焖二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "中途翻一次，让上下层的菜都吃到酱汁。",
      "visual_cue": "菜叶染成酱色，汤汁明显变少"
    },
    {
      "n": 5,
      "text": "开盖转中火收汁，边收边翻，汁浓到挂住菜叶关火。",
      "time_min": 6,
      "heat": "中火",
      "tip": "收汁阶段要不停翻动，糖分沉在锅底很容易烧焦发苦。",
      "visual_cue": "菜叶油亮发黏，锅底只剩薄薄一层"
    },
    {
      "n": 6,
      "text": "淋香油翻匀，尝味补盐后装盘，凉透之后再吃风味最好。",
      "time_min": 2,
      "heat": "小火",
      "tip": "这道菜凉透后风味更浓，别急着趁热吃。",
      "visual_cue": "表面油润发亮，菜梗软而不烂"
    }
  ],
  "tips": [
    "用天菜心或油菜做更地道，买不到就用小白菜，口感接近。",
    "冰糖比白糖好，收出来的汁亮而不死甜。",
    "做好的烤菜冷藏一夜再吃，甜咸味完全渗进去，配粥最合适。"
  ],
  "common_mistakes": [
    "菜没晾干就下锅，一炒出半锅水，最后变成煮菜。",
    "冰糖一次放太多又收不干，菜甜得发腻还流汤。",
    "收汁时离开灶台，糖分糊底，整锅带焦苦味。"
  ],
  "substitutions": [
    {
      "original": "小白菜",
      "substitute": "油菜",
      "ratio": "700克:700克",
      "note": "油菜梗更厚，焖的时间延长五分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "20克:15克",
      "note": "白糖甜度更高，用量要减。"
    }
  ],
  "variations": [
    "加几块油豆腐同焖，吸饱酱汁后比肉还下饭。",
    "加一小勺海鲜酱同烧，鲜味更足，是宁波人家常用的做法。"
  ],
  "serving_suggestion": "凉透后装小碟，配白粥或泡饭，是宁波人早餐桌上的常客。",
  "storage": "冷藏可存四天，随吃随取，凉着吃风味最佳，不必回锅。",
