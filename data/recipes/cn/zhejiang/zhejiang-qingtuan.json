  "equipment": [
    "蒸笼",
    "盆",
    "料理机",
    "锅",
    "油纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菠菜洗净后下沸水焯半分钟，捞出立刻过凉水挤干。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯水去掉草酸，青团吃起来才不涩口。",
      "visual_cue": "菠菜叶软塌，颜色转深绿"
    },
    {
      "n": 2,
      "text": "菠菜加少量清水打成细泥，过筛滤出绿色菜汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打细再过筛，青团表面才细腻无渣。",
      "visual_cue": "菜汁浓绿，筛上只留粗纤维"
    },
    {
      "n": 3,
      "text": "糯米粉倒进盆里，加白糖拌匀后分次倒入菠菜汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "汁分三次倒，面团软硬才好掌握。",
      "visual_cue": "粉呈浅绿色颗粒团"
    },
    {
      "n": 4,
      "text": "揉成软硬适中的面团，盖上湿布静置醒十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "醒过的面团更柔，包馅不易开裂。",
      "visual_cue": "面团光滑柔软，按下去不粘手"
    },
    {
      "n": 5,
      "text": "面团分成三十克一个的剂子，压扁包入红豆沙收口。",
      "time_min": 10,
      "heat": "无火",
      "tip": "馅别贪多，收口捏紧否则蒸时会漏。",
      "visual_cue": "剂子大小一致，收口圆滑"
    },
    {
      "n": 6,
      "text": "搓圆后垫上油纸，摆进蒸笼留出一指宽的间隙。",
      "time_min": 5,
      "heat": "无火",
      "tip": "留出一指间隙，蒸时膨胀才不会粘在一起。",
      "visual_cue": "青团间距均匀，油纸平整"
    },
    {
      "n": 7,
      "text": "水开后大火蒸十二分钟，出笼趁热刷一层植物油。",
      "time_min": 12,
      "heat": "大火",
      "tip": "刷油锁住表面水分，放凉也不发干。",
      "visual_cue": "青团油亮饱满，按下去回弹"
    }
  ],
  "tips": [
    "菠菜汁要过筛，青团表面才会细腻光滑。",
    "面团软硬以不粘手为准，太软蒸完会塌。",
    "蒸好立刻刷油，放凉后表皮才不干硬。"
  ],
  "common_mistakes": [
    "菠菜不焯水直接打汁，青团带明显涩味。",
    "面团太湿就上笼，蒸出来摊成一片塌饼。",
    "蒸好敞着放凉不刷油，表皮干裂发硬。"
  ],
  "substitutions": [
    {
      "original": "菠菜",
      "substitute": "艾草",
      "ratio": "150 克:120 克",
      "note": "香气更传统，焯水时间加倍去苦。"
    },
    {
      "original": "红豆沙",
      "substitute": "芝麻馅",
      "ratio": "200 克:180 克",
      "note": "风味更浓，白糖减到三十克。"
    }
  ],
  "variations": [
    "馅里加一小块咸蛋黄，甜咸交织更受欢迎。",
    "面团加一勺猪油揉匀，口感更润更香。"
  ],
  "serving_suggestion": "温着吃最软糯，配一杯清茶解甜正好。",
  "storage": "常温放一天，冷藏三天，复蒸五分钟回软。",
