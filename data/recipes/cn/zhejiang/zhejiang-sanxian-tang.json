        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "砧板",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁挑净背上的黑线，加料酒与少许盐抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "抓的时候轻一点，用力会把虾仁的弹性破坏掉。",
      "visual_cue": "虾仁表面微微发亮，手感有黏性"
    },
    {
      "n": 2,
      "text": "竹笋切块后冷水下锅焯五分钟，捞起用清水冲凉。",
      "time_min": 8,
      "heat": "中火",
      "tip": "焯水能去掉笋里的涩味和草酸，汤才清甜。",
      "visual_cue": "笋块颜色转浅，闻不到生涩气"
    },
    {
      "n": 3,
      "text": "香菇切片，火腿切薄片，青菜洗净撕成小片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "火腿切薄才出味，太厚只能当肉块吃。",
      "visual_cue": "材料分门别类装盘待用"
    },
    {
      "n": 4,
      "text": "汤锅加清水与姜丝大火烧开，放入火腿片与笋块煮八分钟。",
      "time_min": 10,
      "heat": "大火",
      "tip": "火腿先煮能出鲜味，汤底不用另加高汤。",
      "visual_cue": "汤色转成浅浅的茶色，火腿香飘出"
    },
    {
      "n": 5,
      "text": "转小火放入香菇片煮三分钟，让汤味再厚一点。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香菇久煮会发软，三分钟刚好留住果肉感。",
      "visual_cue": "香菇边缘卷起，汤面浮起薄油"
    },
    {
      "n": 6,
      "text": "下入虾仁与青菜，煮到虾仁全部变成粉红色为止。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾仁一变红就关火，久煮会缩成硬粒。",
      "visual_cue": "虾仁弯成月牙状，颜色粉红不透明"
    },
    {
      "n": 7,
      "text": "加盐与白胡椒粉调味，起锅前淋香油，盛入汤碗。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油一定要离火后淋，煮过就失香了。",
      "visual_cue": "汤清见底，表面浮一层油光"
    }
  ],
  "tips": [
    "火腿本身咸，盐要在最后尝过再放。",
    "竹笋换成莼菜，就是另一种浙江风味。",
    "想让汤更浓可以加一小把开洋同煮。",
    "青菜一定要最后下，久煮会发黄失味。"
  ],
  "common_mistakes": [
    "笋不焯水直接煮，汤发涩还带草酸味。",
    "虾仁煮得太久，缩成硬粒完全没有弹性。",
    "一开始就放盐，火腿的咸味被估错，越煮越咸。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "50克:60克",
      "note": "咸味更重，盐几乎不用放。"
    },
    {
      "original": "虾仁",
      "substitute": "鱼圆",
      "ratio": "150克:150克",
      "note": "口感更软，煮的时间延到五分钟。"
    }
  ],
  "variations": [
    "加几颗鱼圆与蛋饺，做成更丰盛的三鲜砂锅。",
    "把清水换成鸡汤做底，成汤的鲜味更厚。"
  ],
  "serving_suggestion": "趁热盛入汤碗，先喝一口汤再尝料，配一小碟米醋蘸虾仁。",
  "storage": "冷藏两天，复热加少许清水小火煮开，虾仁口感会变硬。",
