  "equipment": [
    "汤锅",
    "打蛋器",
    "细网筛"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳜鱼丝加料酒、1 克盐与姜末抓匀，腌 8 分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺纹切丝，下锅才不散。",
      "visual_cue": "鱼丝发白、表面微黏"
    },
    {
      "n": 2,
      "text": "高汤烧开，下香菇丝、笋丝与火腿末煮 3 分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "笋丝先焯水，汤才不发涩。",
      "visual_cue": "汤面微泛白，闻到菌菇香"
    },
    {
      "n": 3,
      "text": "转小火，把鱼丝抖散下锅，用勺背轻推，煮 2 分钟至鱼丝变白。",
      "time_min": 2,
      "heat": "小火",
      "tip": "不要用力搅，鱼丝易碎。",
      "visual_cue": "鱼丝由透明转为乳白，筷子能夹起不散"
    },
    {
      "n": 4,
      "text": "调入生抽、白糖、白胡椒与剩余盐，水淀粉分两次淋入并搅拌至汤汁挂勺，再淋蛋清成蛋花。",
      "time_min": 3,
      "heat": "小火",
      "tip": "分两次勾芡，稠度更好控制。",
      "visual_cue": "汤汁能薄薄挂在勺背，蛋清呈絮状浮起"
    },
    {
      "n": 5,
      "text": "关火后淋入米醋，撒上小葱末，趁热分碗上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "醋最后放，酸香才不会挥发。",
      "visual_cue": "闻到明显醋酸香，汤色清亮"
    }
  ],
  "tips": [
    "鳜鱼刺少肉紧，是这道羹的首选；用鲈鱼也可，但需去净细刺。",
    "水淀粉要边淋边搅，避免结块成团。",
    "醋分两次放：勾芡时一半、上桌前一半，酸香更有层次。"
  ],
  "common_mistakes": [
    "一次倒入全部水淀粉，汤结成坨。",
    "大火久煮鱼丝，鱼肉变老发硬发柴。"
  ],
  "substitutions": [
    {
      "original": "鳜鱼",
      "substitute": "鲈鱼",
      "ratio": "按净肉重量 1:1",
      "note": "鲈鱼需仔细去细刺，适合老人小孩。"
    },
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "1:1",
      "note": "香醋酸味更厚重，用量减到 10 毫升。"
    }
  ],
  "variations": [
    "杭州老派做法加少许蟹肉同煮，鲜味更足。",
    "素食版以杏鲍菇丝代替鱼丝，高汤换菌菇汤。"
  ],
  "serving_suggestion": "饭前小碗上桌，撒少许白胡椒趁热喝。",
  "storage": "冷藏 1 天，复热时加少量高汤调稀，不要反复加热。",
