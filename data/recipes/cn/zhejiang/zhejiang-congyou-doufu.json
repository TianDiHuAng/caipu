  "steps": [
    {
      "n": 1,
      "text": "豆腐切成两厘米厚的方片，放入淡盐水中浸十分钟去豆腥。",
      "time_min": 10,
      "heat": "无火",
      "tip": "淡盐水浸过，豆腐更紧实，后面不易碎。",
      "visual_cue": "豆腐片完整挺立，表面不见碎屑"
    },
    {
      "n": 2,
      "text": "豆腐上锅大火蒸六分钟，取出后倒掉盘中析出的水。",
      "time_min": 7,
      "heat": "大火",
      "tip": "先蒸定型再调味，比直接下锅煎更嫩。",
      "visual_cue": "豆腐表面结起薄皮，盘中有少量出水"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油下葱白与姜丝，小火慢熬到葱白焦黄卷曲。",
      "time_min": 5,
      "heat": "小火",
      "tip": "葱油要小火慢熬，火大葱一黑油就苦了。",
      "visual_cue": "葱白变金黄蜷曲，油面泛出葱香"
    },
    {
      "n": 4,
      "text": "捞出葱渣，把热油浇在豆腐上，再淋生抽与香油。",
      "time_min": 2,
      "heat": "无火",
      "tip": "油要趁热浇，哧啦一声香味才冲出来。",
      "visual_cue": "豆腐表面油亮，酱汁沿缝隙渗入"
    },
    {
      "n": 5,
      "text": "撒上生的葱绿末与白糖，静置一分钟让味道融合即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱绿生的撒，颜色翠绿还有一股清辛。",
      "visual_cue": "葱末碧绿铺面，酱汁清亮不浑"
    }
  ],
  "tips": [
    "用嫩豆腐口感滑，用老豆腐更有嚼劲，各有各的好。",
    "葱油可一次多熬些，装瓶冷藏能放一周，拌面拌菜都香。",
    "加一小撮虾皮同熬葱油，鲜味立刻上一个层次。"
  ],
  "common_mistakes": [
    "葱段大火下锅，几秒钟就焦苦，整锅油都毁了。",
    "豆腐不蒸直接浇油，内部发凉，豆腥味压不住。",
    "生抽一次浇太多，豆腐泡在咸汁里，鲜味全被盖住。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "内酯豆腐",
      "ratio": "400克:400克",
      "note": "内酯豆腐更嫩，蒸的时间减到四分钟。"
    },
    {
      "original": "小葱",
      "substitute": "大葱",
      "ratio": "40克:50克",
      "note": "大葱辛辣味重，熬油时间延长两分钟。"
    }
  ],
  "variations": [
    "把豆腐换成蒸蛋，浇同样的葱油，就是江南的葱油蒸蛋。",
    "加一勺剁椒同浇，咸辣开胃，夏天吃尤其下饭。"
  ],
  "serving_suggestion": "热吃最香，作为家常小菜配米饭，也可冷后当凉菜上桌。",
  "storage": "冷藏可存一天，复热须上锅蒸五分钟，葱油会略失香。",
