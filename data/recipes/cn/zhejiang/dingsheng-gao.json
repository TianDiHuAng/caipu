          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "筛网",
    "糕模",
    "蒸布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉 120g 与大米粉 80g 混合，加 30g 白糖与 80ml 清水搓成粗颗粒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水要一点点加，粉能握成团就够。",
      "visual_cue": "粉粒湿润、握紧能成团"
    },
    {
      "n": 2,
      "text": "双手把粉团里的疙瘩搓散，再过 20 目筛网筛成松散的糕粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "筛过的粉才松，蒸出来不结块。",
      "visual_cue": "糕粉细腻蓬松、无颗粒"
    },
    {
      "n": 3,
      "text": "糕模内壁刷一层 5ml 植物油，先铺 1 厘米厚糕粉并轻压出浅坑。",
      "time_min": 3,
      "heat": "无火",
      "tip": "只轻压不压实，留空隙才松软。",
      "visual_cue": "糕粉平整、中间有凹坑"
    },
    {
      "n": 4,
      "text": "坑中放入 100g 豆沙，再盖一层糕粉抹平表面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "豆沙别铺到边缘，否则蒸时会漏。",
      "visual_cue": "表面平整、豆沙被完全包住"
    },
    {
      "n": 5,
      "text": "蒸锅上汽后大火蒸 18 分钟，出笼稍凉再脱模。",
      "time_min": 18,
      "heat": "大火",
      "tip": "刚出笼就脱模容易散，晾 3 分钟更完整。",
      "visual_cue": "糕体胀起、按压回弹"
    }
  ],
  "tips": [
    "粉类一定要过筛，糕体才松软不夹生。",
    "豆沙馅别贪多，铺太厚蒸不透还会漏。",
    "蒸前在模具上盖一层蒸布，防止滴水砸坑。"
  ],
  "common_mistakes": [
    "粉里加水太多，蒸出来是一坨黏团。",
    "糕粉压得太实，成品硬得像砖头咬不动。",
    "大火蒸完立刻脱模，糕体当场塌陷。"
  ],
  "substitutions": [
    {
      "original": "豆沙",
      "substitute": "枣泥",
      "ratio": "100g 对 100g",
      "note": "甜度更高，白糖减到 20g。"
    },
    {
      "original": "大米粉",
      "substitute": "粘米粉",
      "ratio": "80g 对 80g",
      "note": "口感一致，可等量替换。"
    }
  ],
  "variations": [
    "加 5g 红曲粉进糕粉，做出传统粉红色。",
    "表面撒 10g 糖桂花，香气更足。"
  ],
  "serving_suggestion": "趁温热吃，配一壶龙井，甜而不腻。",
  "storage": "密封冷藏可存 2 天，复蒸 6 分钟恢复松软。",
