      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 30,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 5,
          "unit": "ml",
