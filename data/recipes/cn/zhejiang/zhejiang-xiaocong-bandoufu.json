  "flavor": [
    "light",
    "savory"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "北豆腐",
          "name_en": "firm tofu",
          "amount": 400,
          "unit": "g",
          "note": "嫩豆腐",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 25,
          "unit": "g",
          "note": "切成细葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 10,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "拌盆",
    "砧板",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐整块放进淡盐水里浸五分钟，去掉豆腥味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "淡盐水浸一下，豆腐更紧实也不易碎。",
      "visual_cue": "豆腐表面收紧，水微微发浑"
    },
    {
      "n": 2,
      "text": "汤锅烧开水，把豆腐整块放进去焯两分钟。，中间别急着翻动。",
      "time_min": 3,
      "heat": "大火",
      "tip": "焯过的豆腐更卫生，口感也更滑嫩。，这一步别偷懒。",
      "visual_cue": "豆腐微微浮起，表面光滑"
    },
    {
      "n": 3,
      "text": "捞出豆腐沥干水，放凉后切成两厘米见方的块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "放凉再切才不散，热着切容易碎。，火候最关键。",
      "visual_cue": "豆腐块方正完整，切面细腻"
    },
    {
      "n": 4,
      "text": "小葱洗净晾干，切成细碎的葱花，越细越好。，保持锅里有底油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "葱切得细，香气才散得开，拌起来也更匀。",
      "visual_cue": "葱花细碎均匀，颜色翠绿"
    },
    {
      "n": 5,
      "text": "豆腐块放进拌盆，撒盐后轻轻晃动盆子拌匀。，手法稳一些更好。",
      "time_min": 2,
      "heat": "无火",
      "tip": "用晃盆代替翻拌，豆腐才不会被搅碎。",
      "visual_cue": "豆腐块完整，表面沾上薄盐"
    },
    {
      "n": 6,
      "text": "淋生抽与香油，再轻轻晃盆让调料均匀裹上。，动作要轻一点。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调料先淋在边沿再晃，比直接浇更好控制。",
      "visual_cue": "豆腐块油亮，盆底有浅色汁水"
    },
    {
      "n": 7,
      "text": "撒上葱花静置三分钟，让葱香渗进豆腐里。，注意观察火候。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置几分钟更入味，葱香也更明显。，时间要卡准些。",
      "visual_cue": "豆腐表面缀满葱花，香气清鲜"
    },
    {
      "n": 8,
      "text": "装盘时可以再淋几滴香油，趁凉上桌最好吃。，中间别急着翻动。",
      "time_min": 1,
      "heat": "无火",
      "tip": "这道菜吃的是清鲜，别加太多调料压味。",
      "visual_cue": "豆腐洁白，葱花翠绿，汁水清亮"
    }
  ],
  "tips": [
    "嫩豆腐口感最好，老豆腐更有豆香。",
    "葱要选小葱，大葱辛辣味太重。，家里做也很方便。",
    "拌的时候千万用晃动，用勺会搅成渣。",
    "夏天冰镇十分钟再拌更清爽。，新手也能掌握。"
  ],
  "common_mistakes": [
    "豆腐热着就切，一刀下去全碎成渣。，整锅味道都跟着毁了。",
    "葱花切得粗，吃起来一股生葱冲味。，口感差得很多。",
    "调料倒太多，盖住了豆腐本身的清甜。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "内酯豆腐",
      "ratio": "400克:400克",
      "note": "更嫩，拌的时候务必用晃盆。"
    },
    {
      "original": "小葱",
      "substitute": "香菜",
      "ratio": "25克:20克",
      "note": "风味更冲，适合喜香菜的人。"
    }
  ],
  "variations": [
    "加一勺皮蛋丁同拌，鲜味更足。，家里人会更爱吃。",
    "淋一勺辣椒油，做成带辣的版本。，换个花样不单调。"
  ],
  "serving_suggestion": "凉拌上桌，作为开胃小菜先吃，清鲜解腻最合适。",
  "storage": "当天吃完，豆腐隔夜会出水变味，不建议留。",
