          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 40,
          "unit": "ml",
          "note": "炒蛋",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "少量调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 3,
          "unit": "g",
          "note": "中和咸味",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 5,
          "unit": "ml",
          "note": "起锅淋",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "打蛋碗",
    "锅铲",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进碗里，加一小撮盐用筷子打散到起细泡。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打到蛋液起泡，炒出来才蓬松柔软。，量别放多。",
      "visual_cue": "蛋液均匀，表面浮着细密气泡"
    },
    {
      "n": 2,
      "text": "雪菜用清水冲洗两遍，挤干水分后切成细碎末。",
      "time_min": 6,
      "heat": "无火",
      "tip": "不冲会太咸，冲过头又没味，两遍刚好。",
      "visual_cue": "雪菜末细碎，挤出的水色偏淡"
    },
    {
      "n": 3,
      "text": "炒锅烧热放一半花生油，倒入蛋液用中火推炒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油要够热再倒蛋液，蛋才鼓得起大泡。",
      "visual_cue": "蛋液边缘凝固起泡，呈嫩黄色"
    },
    {
      "n": 4,
      "text": "蛋液半凝固时用铲子划成大块，盛出装盘备用。",
      "time_min": 1,
      "heat": "中火",
      "tip": "半熟就盛出，回锅再炒一次刚好全熟不老。",
      "visual_cue": "蛋块柔软湿润，还带一点光泽"
    },
    {
      "n": 5,
      "text": "锅里补剩下的花生油，下雪菜末中火煸两分钟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "雪菜煸干一点，那股腌菜的香才出得来。",
      "visual_cue": "雪菜末颜色转深，锅底无水"
    },
    {
      "n": 6,
      "text": "加白糖翻匀中和咸味，再撒一小撮盐调味。，保持锅里有底油。",
      "time_min": 1,
      "heat": "中火",
      "tip": "糖能压住雪菜的死咸，别省略这一步。",
      "visual_cue": "雪菜末油亮，闻着咸香不冲"
    },
    {
      "n": 7,
      "text": "倒回蛋块转大火快速翻炒半分钟，让味道拌匀。",
      "time_min": 1,
      "heat": "大火",
      "tip": "回锅时间要短，炒久了蛋就发硬发柴。",
      "visual_cue": "蛋块完整裹着雪菜末，颜色分明"
    },
    {
      "n": 8,
      "text": "淋香油撒葱花，翻两下立刻起锅装盘上桌。，手法稳一些更好。",
      "time_min": 1,
      "heat": "大火",
      "tip": "葱花最后放，香味才鲜不糊。，这一步别偷懒。",
      "visual_cue": "蛋黄金亮，雪菜深绿，葱花点缀"
    }
  ],
  "tips": [
    "雪菜选腌得透的，酸咸味才正。，新手也能掌握。",
    "蛋液里加一勺清水，炒出来更嫩。",
    "喜欢辣可以加两个干辣椒同煸。，口感会更好一些。",
    "炒蛋油要足，油少了蛋会又干又噎。"
  ],
  "common_mistakes": [
    "蛋液没打散就下锅，炒出来一块白一块黄。",
    "雪菜没冲直接炒，咸得只能配粥。，白忙一场很可惜。",
    "全程小火慢炒，蛋炒得又老又硬。，做出来完全变样。"
  ],
  "substitutions": [
    {
      "original": "雪菜",
      "substitute": "梅干菜",
      "ratio": "100克:80克",
      "note": "甜香更浓，糖可以少放。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4个:3个",
      "note": "蛋腥较重，加两滴料酒去腥。"
    }
  ],
  "variations": [
    "加一把虾仁同炒，鲜味更突出。，口味层次更丰富。",
    "放两片咸肉丁同煸，油香更足。，家里人会更爱吃。"
  ],
  "serving_suggestion": "盛盘趁热吃，配白粥或白饭都合适，咸香下饭。",
  "storage": "冷藏一天，复热用小火快炒一分钟，避免蛋变老。",
