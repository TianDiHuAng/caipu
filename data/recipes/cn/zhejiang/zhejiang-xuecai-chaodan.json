      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 4,
          "unit": "piece",
          "note": "约两百克",
          "optional": false
        },
        {
          "name": "雪菜",
          "name_en": "pickled potherb mustard",
          "amount": 100,
          "unit": "g",
          "note": "切碎",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
