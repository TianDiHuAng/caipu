  "steps": [
    {
      "n": 1,
      "text": "梅干菜用温水泡二十分钟，反复洗掉沙子。，看准状态再往下走。",
      "time_min": 22,
      "heat": "无火",
      "tip": "沙子洗不净，吃着硌牙。，这一点别省。",
      "visual_cue": "菜叶舒展，水色变深"
    },
    {
      "n": 2,
      "text": "挤干水分切碎，下锅倒植物油小火炒到出香。",
      "time_min": 7,
      "heat": "小火",
      "tip": "炒干水汽，香味才浓。，这一点别省。",
      "visual_cue": "菜末干爽，香气扑鼻"
    },
    {
      "n": 3,
      "text": "五花肉切小粒再略剁，保留一点颗粒感。，看准状态再往下走。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别剁成泥，咬着才香。，这一点别省。",
      "visual_cue": "肉粒均匀，肥瘦相间"
    },
    {
      "n": 4,
      "text": "肉粒加姜末、生抽、盐和白糖抓匀。，看准状态再往下走。",
      "time_min": 4,
      "heat": "无火",
      "tip": "抓到发黏，丸子才抱团。，这一点别省。",
      "visual_cue": "肉料黏手，颜色变深"
    },
    {
      "n": 5,
      "text": "加鸡蛋和淀粉，顺一个方向搅上劲。，看准状态再往下走。",
      "time_min": 5,
      "heat": "无火",
      "tip": "同一方向搅，丸子才不散。，这一点别省。",
      "visual_cue": "馅料起胶，能挂勺，这一点很关键。"
    },
    {
      "n": 6,
      "text": "拌入一半梅干菜碎，混合均匀。，看准状态再往下走。",
      "time_min": 3,
      "heat": "无火",
      "tip": "菜太多会散，一半刚好。，这一点别省。",
      "visual_cue": "菜肉均匀，馅色深，这一点很关键。"
    },
    {
      "n": 7,
      "text": "手上抹水，把馅团成拳头大的丸子。，看准状态再往下走。",
      "time_min": 7,
      "heat": "无火",
      "tip": "团紧一点，蒸好才不塌。，这一点别省。",
      "visual_cue": "丸子圆整，表面光滑"
    },
    {
      "n": 8,
      "text": "丸子摆进深碗，铺上剩余梅干菜，淋生抽和老抽。",
      "time_min": 4,
      "heat": "无火",
      "tip": "菜压在顶上，蒸汽香味往下走。，这一点别省。",
      "visual_cue": "菜末覆盖，丸子半露"
    },
    {
      "n": 9,
      "text": "淋生抽和清水，大火蒸四十五分钟。，看准状态再往下走。",
      "time_min": 47,
      "heat": "大火",
      "tip": "水要加够，中途别开盖。，这一点别省。",
      "visual_cue": "丸子鼓起，汤汁变深"
    },
    {
      "n": 10,
      "text": "取出倒扣装盘，浇上碗底汤汁。，看准状态再往下走。",
      "time_min": 3,
      "heat": "无火",
      "tip": "倒扣时用盘子压紧再翻。，这一点别省。",
      "visual_cue": "成形完整，汁色油亮"
    }
  ],
  "tips": [
    "梅干菜一定要洗净沙子，不然硌牙。",
    "肉别剁成泥，留颗粒口感才好。，这一点很关键。",
    "蒸的水要一次加够，中途开盖会塌。"
  ],
  "common_mistakes": [
    "肉料没搅上劲，蒸好散成渣。，这一点很关键。",
    "梅干菜没炒干，成品水塌塌。，这一点很关键。",
    "蒸的时间不够，中心发红。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "前腿肉",
      "ratio": "450 克:450 克",
      "note": "更瘦，可多加 10 克淀粉。"
    },
    {
      "original": "梅干菜",
      "substitute": "霉干菜",
      "ratio": "80 克:80 克",
      "note": "风味接近，泡发时间减五分钟。"
    }
  ],
  "variations": [
    "丸子中间塞一颗咸蛋黄，切开更香。",
    "底下垫几片芋头，吸汁很好吃。，这一点很关键。"
  ],
  "serving_suggestion": "倒扣上桌，配米饭连汁吃。，这一点很关键。",
  "storage": "冷藏两天，冷冻两周；复热蒸十五分钟。",
