    "削皮刀",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "荸荠洗净后逐个削皮，个头大的从中间对半切开。",
      "time_min": 10,
      "heat": "无火",
      "tip": "削皮要削到露出白肉，带黄的部分会发涩。",
      "visual_cue": "荸荠白净光滑，没有残留的表皮"
    },
    {
      "n": 2,
      "text": "削好的荸荠泡在清水里，可以防止表面氧化变黄。",
      "time_min": 5,
      "heat": "无火",
      "tip": "泡在清水里能保持脆白，下锅前再沥干。",
      "visual_cue": "荸荠浸在水中，颜色洁白"
    },
    {
      "n": 3,
      "text": "炒锅大火烧热放花生油，下姜丝与葱段炒出香味。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱姜只用一半，另一半留着最后提香。",
      "visual_cue": "葱段边缘起泡，香味散出"
    },
    {
      "n": 4,
      "text": "倒入沥干的荸荠，中火翻炒三分钟让表面裹上油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先炒出表面水分，后面焖的时候才不粘锅。",
      "visual_cue": "荸荠表面油亮，边缘略微透明"
    },
    {
      "n": 5,
      "text": "加料酒、生抽与白糖翻匀，倒入小半碗清水烧开。",
      "time_min": 3,
      "heat": "中火",
      "tip": "水不要多，没过荸荠三分之一就够，收汁才快。",
      "visual_cue": "锅内有浅浅的酱色汤汁在冒泡"
    },
    {
      "n": 6,
      "text": "盖盖中小火焖六分钟，中途翻动一次让入味均匀。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "焖到筷子能扎透但不软塌，脆感才留得住。",
      "visual_cue": "汤汁减少一半，荸荠呈浅酱色"
    },
    {
      "n": 7,
      "text": "开盖大火收汁，边收边翻，让糖汁裹住每一颗。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁的时候别走开，糖一焦整锅就发苦。",
      "visual_cue": "汤汁浓稠挂勺，表面亮得像上了釉"
    },
    {
      "n": 8,
      "text": "加盐调味，撒剩下的葱段，淋香油后起锅装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐一定要最后放，早放会让荸荠出水变软。",
      "visual_cue": "荸荠颗颗油亮，葱段翠绿"
    }
  ],
  "tips": [
    "荸荠选表皮完整、捏着硬的，软的有可能是坏的。",
    "想更甜可以用冰糖代替一半白糖。",
    "收汁留一点汤汁更好吃，别收得太干。",
    "冷藏之后当小菜吃，脆甜感更明显。"
  ],
  "common_mistakes": [
    "削皮没有削干净，吃起来会带一点涩味。",
    "水加太多焖太久，荸荠从脆变成软塌。",
    "收汁火太大又不翻动，糖焦成一层黑壳。"
  ],
  "substitutions": [
    {
      "original": "荸荠",
      "substitute": "莲藕",
      "ratio": "500克:500克",
      "note": "切厚片，焖的时间延长四分钟。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "20克:22克",
      "note": "甜味更清透，收汁更亮。"
    }
  ],
  "variations": [
    "加几片火腿一起焖，咸甜层次更复杂。",
    "做成凉菜版本，收好汁后冷藏再上桌。"
  ],
  "serving_suggestion": "装白盘，趁热吃脆甜，也可冷藏后作为冷盘小菜配粥。",
  "storage": "冷藏两天，复热用炒锅小火加一勺水翻热，保持脆感。",
