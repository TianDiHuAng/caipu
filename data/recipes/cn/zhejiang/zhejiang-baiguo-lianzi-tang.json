  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "白果",
          "name_en": "ginkgo nut",
          "amount": 100,
          "unit": "g",
          "note": "去壳去膜，去芯",
          "optional": false
        },
        {
          "name": "莲子",
          "name_en": "lotus seeds",
          "amount": 100,
          "unit": "g",
          "note": "干莲子提前泡软",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "红枣",
          "name_en": "red date",
          "amount": 60,
          "unit": "g",
          "note": "去核",
          "optional": false
        },
        {
          "name": "银耳",
          "name_en": "white fungus",
          "amount": 20,
          "unit": "g",
          "note": "提前泡发撕小朵",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "冰糖",
          "name_en": "rock sugar",
          "amount": 60,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "桂花",
          "name_en": "osmanthus flower",
          "amount": 2,
          "unit": "g",
          "note": "干桂花，最后撒",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "小碗",
    "漏勺",
    "牙签"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干莲子用温水泡两小时，泡到用手指能轻松掐断。",
      "time_min": 120,
      "heat": "无火",
      "tip": "泡不透的莲子，煮多久中间都带硬芯。",
      "visual_cue": "莲子鼓胀变软，表皮起皱"
    },
    {
      "n": 2,
      "text": "白果敲开外壳剥出果仁，用热水烫过撕掉那层薄皮。",
      "time_min": 10,
      "heat": "无火",
      "tip": "薄皮不撕会带苦味，煮出来的汤色也会发浑。",
      "visual_cue": "果仁呈淡黄色，表面光滑无膜"
    },
    {
      "n": 3,
      "text": "白果仁从中间剖开，用牙签把中间的绿芯挑掉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "绿芯是苦味与毒性的主要来源，必须去掉。",
      "visual_cue": "果仁内部空心，看不到绿色"
    },
    {
      "n": 4,
      "text": "银耳泡发后剪掉发黄的根部，再撕成小朵备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部又硬又不出胶，一定要剪得干干净净。",
      "visual_cue": "银耳成松散小朵，摸着有弹性"
    },
    {
      "n": 5,
      "text": "汤锅加清水，放莲子与红枣大火烧开后转小火炖四十分钟。",
      "time_min": 45,
      "heat": "小火",
      "tip": "小火慢炖莲子才会粉糯，大火只会煮散外皮。",
      "visual_cue": "莲子外形完整，一压即碎"
    },
    {
      "n": 6,
      "text": "加入白果与银耳之后，继续用小火炖二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "白果久煮会发苦，二十分钟刚好熟透。",
      "visual_cue": "银耳边缘变软，汤略见稠感"
    },
    {
      "n": 7,
      "text": "放冰糖煮到完全融化，关火撒桂花，盖盖焖三分钟。",
      "time_min": 5,
      "heat": "小火",
      "tip": "桂花靠余温出香，久煮香气就跑光了。",
      "visual_cue": "甜汤清亮微稠，浮着细碎桂花"
    }
  ],
  "tips": [
    "白果有小毒，成人一次不宜超过十颗。",
    "冰糖换成红糖，汤色更暖，风味更沉。",
    "冷藏之后当凉汤来吃，夏天很解腻。",
    "银耳想更出胶可以提前炖一小时。"
  ],
  "common_mistakes": [
    "莲子没泡透就下锅，煮一小时中间还是硬的。",
    "白果不去掉中间的绿芯，整锅汤都发苦。",
    "冰糖一开始就放，汤色变浑还容易糊底。"
  ],
  "substitutions": [
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "60克:50克",
      "note": "甜味更直，汤色略深。"
    },
    {
      "original": "白果",
      "substitute": "栗子",
      "ratio": "100克:120克",
      "note": "口感更粉甜，无毒性顾虑。"
    }
  ],
  "variations": [
    "再加几片百合进去，整体的清润感更强。",
    "放凉之后加一勺酒酿，做成酒香甜汤。"
  ],
  "serving_suggestion": "温热时装小碗，撒干桂花，作为饭后甜汤或下午茶点。",
  "storage": "冷藏三天，复热小火煮到微沸即可，银耳久煮会化成水。",
