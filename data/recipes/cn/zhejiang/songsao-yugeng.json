  "equipment": [
    "汤锅",
    "炒锅",
    "蒸锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳜鱼去鳞去内脏洗净，鱼身划两刀放姜丝与料酒。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鱼腹黑膜要刮净，去腥关键。",
      "visual_cue": "鱼身洁净、刀口整齐"
    },
    {
      "n": 2,
      "text": "蒸锅上汽后放入鳜鱼，大火蒸八分钟至鱼肉变白，取出放凉。",
      "time_min": 10,
      "heat": "大火",
      "tip": "蒸到鱼眼突出即熟。",
      "visual_cue": "鱼肉转白、鱼眼凸起"
    },
    {
      "n": 3,
      "text": "用手把鱼肉拆下，仔细挑净细刺后撕成细丝。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鳜鱼刺少，但仍要逐块检查。",
      "visual_cue": "鱼肉成丝、不见鱼刺"
    },
    {
      "n": 4,
      "text": "香菇、冬笋切细丝，金华火腿切末，小葱切花备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丝切得越细，口感越顺。",
      "visual_cue": "配料丝细匀、长短一致"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧热，下姜丝与火腿末小火炒出香味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "火腿末炒香能提汤的鲜。",
      "visual_cue": "火腿末酥香、油色微红"
    },
    {
      "n": 6,
      "text": "下香菇丝与冬笋丝翻炒一分钟，加清水烧开。",
      "time_min": 4,
      "heat": "中火",
      "tip": "笋丝先炒去涩味。",
      "visual_cue": "汤面微滚、配料软化"
    },
    {
      "n": 7,
      "text": "放入鱼肉丝，加生抽、盐与白胡椒小火煮三分钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "鱼肉已熟，久煮会散。",
      "visual_cue": "鱼丝舒展、汤色微白"
    },
    {
      "n": 8,
      "text": "玉米淀粉加清水调开，缓缓淋入汤中推匀勾薄芡。",
      "time_min": 3,
      "heat": "中火",
      "tip": "边淋边推，芡才不结块。",
      "visual_cue": "汤汁浓稠挂勺、无疙瘩"
    },
    {
      "n": 9,
      "text": "关小火沿锅边淋入蛋清，静置五秒后轻推成蛋花。",
      "time_min": 2,
      "heat": "微火",
      "tip": "淋完别马上搅，蛋花才成片。",
      "visual_cue": "蛋花成薄片漂浮在汤面"
    },
    {
      "n": 10,
      "text": "淋入香醋与香油，撒葱花搅匀后立刻离火装碗。",
      "time_min": 1,
      "heat": "无火",
      "tip": "醋最后放，酸香才不挥发。",
      "visual_cue": "汤面浮香油、酸香扑鼻"
    }
  ],
  "tips": [
    "用蒸鱼的原汁代替部分清水，鲜味更足。",
    "勾芡要薄一些，汤汁能缓缓流动才顺口。",
    "香醋选镇江香醋，酸味柔和且带米香。"
  ],
  "common_mistakes": [
    "鱼肉没挑净刺，喝汤时容易扎口。",
    "芡勾得太厚，汤凉了就结成糊块。",
    "蛋清倒入后立刻搅动，蛋花碎成渣。"
  ],
  "substitutions": [
    {
      "original": "鳜鱼",
      "substitute": "鲈鱼",
      "ratio": "500g 对 500g",
      "note": "肉质相近，蒸制时间延长两分钟。"
    },
    {
      "original": "冬笋",
      "substitute": "茭白",
      "ratio": "60g 对 60g",
      "note": "口感更嫩，无需提前去涩。"
    }
  ],
  "variations": [
    "加少许蟹肉同煮，就是更奢华的蟹粉鱼羹。",
    "喜欢更酸可把香醋加到四十毫升。"
  ],
  "serving_suggestion": "盛入小盅趁热喝，酸甜鲜香、鱼丝细嫩。",
  "storage": "当天喝完，隔夜芡会变稀且带腥味。",
