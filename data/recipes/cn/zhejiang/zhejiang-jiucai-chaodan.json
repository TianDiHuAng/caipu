  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 200,
          "unit": "g",
          "note": "约四枚",
          "optional": false
        },
        {
          "name": "韭菜",
          "name_en": "Chinese chives",
          "amount": 150,
          "unit": "g",
          "note": "切三厘米段",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "分两次用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 5,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "打蛋碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "韭菜择去老根黄叶，冲洗干净后甩干水，切成三厘米长的段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "洗好的韭菜一定要甩干水，带水下锅会炒出半碗汤。",
      "visual_cue": "韭菜干爽挺立，段长三厘米左右。"
    },
    {
      "n": 2,
      "text": "鸡蛋打进碗里，加两克盐打散到蛋液均匀无结块，静置一分钟。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打匀后静置一分钟，气泡消掉再下锅，蛋块才细嫩光滑。",
      "visual_cue": "蛋液均匀，颜色一致无结块。"
    },
    {
      "n": 3,
      "text": "炒锅大火烧热倒一半植物油，转中火倒入蛋液，等边缘凝固再推。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋液边缘定型再推，等七成凝固翻动，块才大而蓬松。",
      "visual_cue": "蛋液半凝固，边缘起泡发白。"
    },
    {
      "n": 4,
      "text": "用锅铲把蛋块推成大块盛出，锅里留底油，不要炒到全干。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蛋还带一点湿润就盛出，余温会继续把它焖熟。",
      "visual_cue": "蛋块金黄蓬松，中心还微润。"
    },
    {
      "n": 5,
      "text": "转大火下韭菜快速翻炒二十秒，加剩下的盐和生抽翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "韭菜下锅只炒二十秒，断生就行，炒久了发黄出水。",
      "visual_cue": "韭菜转深绿，仍然挺立不软塌。"
    },
    {
      "n": 6,
      "text": "倒回蛋块大火翻炒十秒，让蛋香和韭菜混匀，立即起锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "回锅只为拌匀，十秒足够，多炒一步蛋就变老发硬。",
      "visual_cue": "绿黄分明，盘底没有汤汁。"
    }
  ],
  "tips": [
    "韭菜洗后一定要甩干水，带水下锅会出一盘汤。",
    "蛋液下锅定型七成再翻，块大蓬松才好吃。",
    "韭菜下锅只炒二十秒，断生就出锅，久炒发黄出水。"
  ],
  "common_mistakes": [
    "韭菜和蛋液拌在一起下锅，炒出来又湿又散像糊。",
    "油温不够就倒蛋液，蛋液渗进锅底，铲起来又薄又碎。",
    "生抽沿锅边倒太多，蛋块染成深色，卖相发黑。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "韭黄",
      "ratio": "150克:150克",
      "note": "香气更柔，炒制时间再短十秒。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "200克:210克",
      "note": "腥味略重，可加几滴料酒。"
    }
  ],
  "variations": [
    "蛋液里加一勺清水再打散，炒出来的蛋块更嫩更蓬松。",
    "加一把泡软的粉丝同炒，吸饱蛋香和韭菜汁，很适合当主食配菜。"
  ],
  "serving_suggestion": "趁热装盘，配白粥或米饭，出锅到上桌别超过五分钟，韭菜最怕回软。",
  "storage": "建议当餐吃完，冷藏后韭菜发黄出水，回锅味道也会发闷。",
