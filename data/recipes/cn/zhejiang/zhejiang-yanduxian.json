  "equipment": [
    "砂锅",
    "汤勺",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "咸肉用温水泡二十分钟再去皮切块，泡出多余盐分备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "咸肉不泡直接炖，整锅汤会咸得下不了口。",
      "visual_cue": "肉块边缘发白，水微微泛浑"
    },
    {
      "n": 2,
      "text": "五花肉切块，冷水下锅加料酒与姜片焯水，撇净浮沫捞出。",
      "time_min": 10,
      "heat": "中火",
      "tip": "冷水下锅血沫才出得净，热水一烫就封在肉里。",
      "visual_cue": "水面浮起灰白泡沫，肉块紧缩"
    },
    {
      "n": 3,
      "text": "竹笋切滚刀块，下沸水煮五分钟去涩，捞出过凉水沥干。",
      "time_min": 8,
      "heat": "大火",
      "tip": "笋不焯水会带涩味，汤再鲜也会被这股涩压住。",
      "visual_cue": "笋块由白转半透，涩味明显减弱"
    },
    {
      "n": 4,
      "text": "砂锅里放咸肉、五花肉、姜片和葱结，加足量清水大火煮开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水一次加够，中途添水会把汤的鲜味冲淡。",
      "visual_cue": "汤面翻滚，浮沫聚在锅边"
    },
    {
      "n": 5,
      "text": "转小火加盖慢炖四十分钟，让咸肉与鲜肉的味道互相渗透。",
      "time_min": 40,
      "heat": "小火",
      "tip": "全程只冒小泡，滚太猛汤会浑、肉会柴。",
      "visual_cue": "汤色由清转乳白，肉块酥而不散"
    },
    {
      "n": 6,
      "text": "下竹笋块再炖二十分钟，起锅前尝咸淡补盐，撒白胡椒。",
      "time_min": 20,
      "heat": "小火",
      "tip": "盐最后尝了再加，咸肉的咸度事先说不准。",
      "visual_cue": "笋块吸饱汤汁沉底，汤面浮油花"
    }
  ],
  "tips": [
    "咸肉与鲜肉的比例以三比五最稳，太咸太淡都能靠这一比例拉回来。",
    "用砂锅比铁锅好，受热均匀，汤色更清亮不返铁味。",
    "剩下的一锅第二天加热更好喝，笋吸了一夜的汤，味道全进去了。"
  ],
  "common_mistakes": [
    "咸肉没泡就下锅，一锅汤咸到发苦，只能整锅倒掉。",
    "中途加冷水，肉块瞬间收紧，炖两小时还是硬的。",
    "全程大火猛滚，汤浑得像米汤，鲜味也散掉了。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "火腿",
      "ratio": "150克:120克",
      "note": "火腿更咸，泡水时间延长到半小时。"
    },
    {
      "original": "竹笋",
      "substitute": "莴笋",
      "ratio": "300克:300克",
      "note": "莴笋易烂，最后十分钟再下锅。"
    }
  ],
  "variations": [
    "加一把百叶结同炖，吸满汤后一咬爆汁，是上海弄堂里的家常版。",
    "加几片火腿脚圈同煮，汤更醇厚，宴客时最拿得出手。"
  ],
  "serving_suggestion": "连砂锅端上桌，先喝一碗原汤，肉块蘸酱油吃，配米饭正好。",
  "storage": "冷藏可存三天，复热时小火慢加热，别大火滚，否则肉会散。",
