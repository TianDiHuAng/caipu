  "steps": [
    {
      "n": 1,
      "text": "玉米粒放沸水里焯两分钟，捞出后彻底沥干水分备用。",
      "time_min": 6,
      "heat": "中火",
      "tip": "玉米先焯过，炒的时候不会溅油也不夹生。",
      "visual_cue": "玉米粒饱满透亮，水分沥干"
    },
    {
      "n": 2,
      "text": "胡萝卜切一厘米小丁，香菇切同样大小的丁，豌豆洗净备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "三样都切成同样大小，受热才均匀。",
      "visual_cue": "各料丁块大小一致，整齐好看"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下胡萝卜丁中火炒三分钟至边缘变软。",
      "time_min": 4,
      "heat": "中火",
      "tip": "胡萝卜过油才出胡萝卜素，也更容易熟。",
      "visual_cue": "胡萝卜丁颜色转深，边缘微透"
    },
    {
      "n": 4,
      "text": "下香菇丁与豌豆翻炒两分钟，再倒入玉米粒，加盐与白砂糖炒匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "玉米最后下，炒久了会爆开失去口感。",
      "visual_cue": "各料颜色分明，锅底无多余汤汁"
    },
    {
      "n": 5,
      "text": "淀粉加清水调成芡汁淋入，快速翻匀收亮，撒葱花即可出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "芡汁薄薄一层就够，太厚会糊成一团。",
      "visual_cue": "表面油亮挂汁，葱花翠绿点缀"
    }
  ],
  "tips": [
    "玉米先焯水再炒，不会溅油也不夹生。",
    "胡萝卜过油炒，胡萝卜素才吸收得好。",
    "玉米最后放，保持颗粒饱满的口感。",
    "薄芡让菜看着油亮，色泽也更有食欲。"
  ],
  "common_mistakes": [
    "玉米不焯直接下锅，油花四溅还夹生。",
    "三样一起下锅，胡萝卜还没熟玉米已经爆开。",
    "芡汁调得太稠，整盘菜糊成一坨，完全看不出颗粒。",
    "炒的时间太长，豌豆全变成暗黄色。"
  ],
  "substitutions": [
    {
      "original": "豌豆",
      "substitute": "青椒",
      "ratio": "100克:100克",
      "note": "切丁后最后放，炒一分钟即可。"
    },
    {
      "original": "玉米粒",
      "substitute": "甜豆",
      "ratio": "300克:280克",
      "note": "口感更脆，炒制时间相同。"
    }
  ],
  "variations": [
    "加一把松子同炒，香气和口感都升级。",
    "放几只虾仁，做成三鲜炒丁更下饭。",
    "用黄油代替植物油来炒，奶香更浓，孩子特别喜欢。"
  ],
  "serving_suggestion": "盛在浅盘里，红黄绿三色分明，配一碗白粥或米饭都合适，做便当配菜也不出水。",
  "storage": "冷藏可放一天，复热用炒锅大火快炒一分钟，微波加热会变软。",
