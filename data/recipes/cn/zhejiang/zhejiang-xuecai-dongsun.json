    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "冬笋剥壳切去老根，顺着纤维切成薄片，冷水下锅煮五分钟捞出。",
      "time_min": 8,
      "heat": "大火",
      "tip": "煮笋是为去草酸和涩味，水开后煮足五分钟才有效。",
      "visual_cue": "笋片由白转半透，涩味明显减淡"
    },
    {
      "n": 2,
      "text": "雪菜用清水泡三分钟挤干，切成半厘米长的小段备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "雪菜先泡再挤，咸得发苦的腌菜也能救回来。",
      "visual_cue": "雪菜挤得干爽成团，颜色青褐不抱水"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油下姜末与干辣椒段小火煸香，闻到辣气即可。",
      "time_min": 2,
      "heat": "小火",
      "tip": "干辣椒只取香，变色发黑就会带苦味。",
      "visual_cue": "油面泛起淡淡红色，干辣椒的辣香明显飘出"
    },
    {
      "n": 4,
      "text": "转大火下雪菜翻炒两分钟，把腌菜的酸香炒出来。",
      "time_min": 2,
      "heat": "大火",
      "tip": "雪菜先单炒，酸香出来了再下笋片才够味。",
      "visual_cue": "雪菜松散不结块，香气散出"
    },
    {
      "n": 5,
      "text": "倒入笋片同炒，加白糖与少许盐翻匀，加两勺清水焖两分钟收干。",
      "time_min": 3,
      "heat": "大火",
      "tip": "雪菜本身极咸，加盐前务必先尝一口。",
      "visual_cue": "汤汁收干，笋片油亮不发白"
    },
    {
      "n": 6,
      "text": "撒入余下的小葱段快速翻匀，沿锅边淋入香油后出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "香油一定要最后淋，提前下锅香气会被热量冲散。",
      "visual_cue": "菜面油亮润泽，青褐两色相间分明"
    }
  ],
  "tips": [
    "冬笋换成春笋亦可，春笋更嫩，煮的时间可减到三分钟。",
    "雪菜咸度差别大，泡水时间按口味增减，宁淡不咸。",
    "加一小块五花肉同炒，油脂渗进笋片，鲜得能多吃一碗饭。"
  ],
  "common_mistakes": [
    "冬笋不焯水直接下锅，炒出来涩口，怎么调都压不住。",
    "雪菜不挤水就炒，一锅咸汤，笋片全被腌得发死。",
    "全程小火慢炒，雪菜发黄发软，笋片也失了脆感。"
  ],
  "substitutions": [
    {
      "original": "冬笋",
      "substitute": "春笋",
      "ratio": "250克:250克",
      "note": "春笋须多焯一分钟去涩。"
    },
    {
      "original": "雪菜",
      "substitute": "梅干菜",
      "ratio": "150克:60克",
      "note": "梅干菜更干更香，需提前泡软切碎。"
    }
  ],
  "variations": [
    "加几片火腿同炒，咸鲜里带一点肉香，是杭帮馆子的做法。",
    "把笋片换成笋干泡发后同炒，风味更浓，适合冬天吃。"
  ],
  "serving_suggestion": "热吃最好，配白粥或米饭都合适，也可作面条浇头。",
  "storage": "冷藏可存两天，复热须回锅快炒，久蒸会出水变咸。",
