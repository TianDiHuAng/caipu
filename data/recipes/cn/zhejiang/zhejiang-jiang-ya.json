          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 30,
          "unit": "g",
          "note": "打成一个葱结",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 120,
          "unit": "ml",
          "note": "定咸味和底色",
          "optional": false
        },
        {
          "name": "冰糖",
          "name_en": "rock sugar",
          "amount": 50,
          "unit": "g",
          "note": "单晶冰糖敲碎",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "煸鸭用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "收尾补味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "去腥提香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "汤勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老鸭里外冲洗干净，撕掉腹腔内的肥油块，用厨房纸把表皮彻底擦干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腹腔内肥油不去，焖出来一层厚油浮在汁面，压住酱香。",
      "visual_cue": "表皮干爽不粘手，腹腔内没有残留血块。"
    },
    {
      "n": 2,
      "text": "砂锅倒植物油中火烧热，把老鸭放进去，两面各煎四分钟到皮紧缩。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎皮时用铲子轻压，让表皮整片贴锅，上色才均匀。",
      "visual_cue": "表皮金黄起细密小泡，锅底留一层渗出的油脂。"
    },
    {
      "n": 3,
      "text": "下姜片和小葱结在渗出的油脂里煸香，倒入一半生抽，让整只均匀裹上酱色。",
      "time_min": 4,
      "heat": "中火",
      "tip": "生抽顺着锅边淋，遇热汽化后酱香更足，直接浇整只会发腥。",
      "visual_cue": "表皮转深酱色，锅里飘出酱香。"
    },
    {
      "n": 4,
      "text": "加冰糖和清水到整只的三分之二高度，大火烧开后转小火盖盖焖。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水面别没过背脊，露出部分靠蒸汽焖熟，皮才不会烂。",
      "visual_cue": "汤汁沸腾，整只上半部露在液面外。"
    },
    {
      "n": 5,
      "text": "小火焖三十五分钟，中途翻一次身，让上下两面都泡到酱汁。",
      "time_min": 35,
      "heat": "小火",
      "tip": "翻面用两把铲子托住整只，直接夹容易破皮。",
      "visual_cue": "整只明显变小，筷子能轻松插透腿部。"
    },
    {
      "n": 6,
      "text": "开盖转大火收汁，补剩下的生抽、盐和白胡椒粉，边收边把汁浇在整只上。",
      "time_min": 5,
      "heat": "大火",
      "tip": "收汁时不停浇淋，表皮才挂得住亮汁不发干。",
      "visual_cue": "酱汁浓稠挂勺，整只油亮红褐。"
    }
  ],
  "tips": [
    "老鸭皮下脂肪厚，先用厨房纸吸干再下锅，煸出的油才不溅。",
    "生抽要分两次加，前一次入底味，后一次收汁时补色。",
    "小火焖够四十分钟再开盖，鸭肉才酥而不散，急火只会外咸内淡。"
  ],
  "common_mistakes": [
    "整鸭直接下锅焖，鸭皮出油被泡在汁里，皮软塌没有酱香。",
    "全程大火收汁，糖分烧焦发苦，鸭皮上挂一层黑亮的苦汁。",
    "焖好立刻切块，鸭肉纤维还没回缩稳定，切面全散成碎块。"
  ],
  "substitutions": [
    {
      "original": "老鸭",
      "substitute": "肉鸭",
      "ratio": "1000克:1000克",
      "note": "炖的时间缩短十分钟，肉质更嫩。"
    },
    {
      "original": "冰糖",
      "substitute": "红糖",
      "ratio": "50克:45克",
      "note": "颜色更深，甜味带焦香。"
    }
  ],
  "variations": [
    "加一把笋干同焖，笋干吸饱酱汁，比鸭肉还抢手。",
    "把生抽换成一半老抽一半生抽，酱色更浓，适合凉透后切片做冷盘。"
  ],
  "serving_suggestion": "整鸭焖好先放凉，斩成两指宽的块码盘，浇一勺收浓的酱汁，配黄酒或米饭都是江南冬天的正经吃法。",
  "storage": "冷藏可放三天，凉透后切片当下酒冷盘也好吃，回热用蒸锅比微波更能保住肉汁。",
