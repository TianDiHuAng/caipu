  "equipment": [
    "炒锅",
    "汤锅",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄鱼刮去鱼鳞掏净内脏，撕掉腹内黑膜，鱼身两面各划三刀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黑膜最腥，一定要撕干净。",
      "visual_cue": "鱼身干净、刀口整齐外翻"
    },
    {
      "n": 2,
      "text": "鱼身抹上料酒与少许盐，塞入姜片腌十分钟去腥。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌的时间别太久，鱼肉会散。",
      "visual_cue": "鱼皮微微收紧、表面见酒光"
    },
    {
      "n": 3,
      "text": "雪菜挤干水分切碎，冬笋切细丝，葱切段备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "雪菜挤得越干，汤越清不浑。",
      "visual_cue": "雪菜松散成粒、不见水汪"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，鱼身擦干后下锅，中小火煎到两面微黄定型。",
      "time_min": 6,
      "heat": "中火",
      "tip": "鱼皮擦干再下锅才不破皮。",
      "visual_cue": "鱼皮金黄完整、锅底不粘"
    },
    {
      "n": 5,
      "text": "把鱼拨到一边，下姜片、葱段、雪菜与冬笋丝煸出香味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "雪菜先炒过，酸香才出得来。",
      "visual_cue": "雪菜转深绿、锅中有咸香"
    },
    {
      "n": 6,
      "text": "冲入开水没过鱼身，大火滚十五分钟，中途不要搅动鱼身。",
      "time_min": 15,
      "heat": "大火",
      "tip": "必须用开水，汤色才会浓白。",
      "visual_cue": "汤色转乳白、鱼眼凸出"
    },
    {
      "n": 7,
      "text": "尝味后补盐，撒上白胡椒与葱段，连汤一起盛出。",
      "time_min": 2,
      "heat": "无火",
      "tip": "雪菜本身咸，盐要最后尝过再加。",
      "visual_cue": "汤面浮油清亮、咸鲜扑鼻"
    }
  ],
  "tips": [
    "黄鱼要选眼睛清亮、鱼鳃鲜红的当日鲜货。",
    "煎鱼前把锅烧到冒烟再下油，鱼皮不易粘。",
    "雪菜选带梗的整棵，比切碎的袋装货香得多。"
  ],
  "common_mistakes": [
    "用冷水煮鱼，汤色始终发灰不清。",
    "煎鱼时不停翻动，鱼身碎成几段。",
    "雪菜下锅前不挤水，整锅汤又咸又涩。"
  ],
  "substitutions": [
    {
      "original": "黄鱼",
      "substitute": "鲈鱼",
      "ratio": "600g 对 600g",
      "note": "鲈鱼肉更紧实，煮制时间延长三分钟。"
    },
    {
      "original": "雪菜",
      "substitute": "酸菜",
      "ratio": "80g 对 80g",
      "note": "酸味更重，盐可再减一克。"
    }
  ],
  "variations": [
    "加一把年糕片同煮，就是宁波人的雪菜黄鱼年糕汤。",
    "换成小黄鱼五六条同煮，鲜味更集中。"
  ],
  "serving_suggestion": "大碗盛汤，鱼肉蘸一点米醋吃更鲜。",
  "storage": "当天吃完最好，冷藏后再加热汤会略腥。",
