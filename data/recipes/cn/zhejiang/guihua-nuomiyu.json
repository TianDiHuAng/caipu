          "name_en": "red date",
          "amount": 40,
          "unit": "g",
          "note": "去核",
          "optional": false
        },
        {
          "name": "桂花",
          "name_en": "osmanthus flower",
          "amount": 5,
          "unit": "g",
          "note": "干桂花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "冰糖",
          "name_en": "rock sugar",
          "amount": 80,
          "unit": "g",
          "note": "黄冰糖更香",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1500,
          "unit": "ml",
          "note": "煮藕用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "牙签",
    "筷子",
    "棉线"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗干净后用清水泡 2 小时，捞出沥干水分备用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡到米粒一捏就碎，灌孔才不夹生。",
      "visual_cue": "糯米胀大、指捏易碎"
    },
    {
      "n": 2,
      "text": "莲藕去皮，从一端切下 3cm 的厚片当盖子，藕孔冲洗干净。",
      "time_min": 15,
      "heat": "无火",
      "tip": "藕孔里的泥要用流水冲干净。",
      "visual_cue": "藕孔通透、无泥沙"
    },
    {
      "n": 3,
      "text": "把糯米一点点灌进藕孔，边灌边用筷子戳实，盖回藕盖。",
      "time_min": 8,
      "heat": "无火",
      "tip": "米只灌八分满，煮时会胀。",
      "visual_cue": "藕孔填实、米不外溢"
    },
    {
      "n": 4,
      "text": "藕盖用牙签固定，砂锅放清水、冰糖与红枣，下莲藕小火煮 80 分钟。",
      "time_min": 85,
      "heat": "小火",
      "tip": "小火慢煮，藕才糯而不散。",
      "visual_cue": "汤汁转红、藕身变软"
    },
    {
      "n": 5,
      "text": "加桂花再煮 5 分钟，取出晾凉后切片，淋上锅里的甜汁。",
      "time_min": 10,
      "heat": "小火",
      "tip": "晾凉再切，切片才不散。",
      "visual_cue": "切片整齐、藕孔米粒饱满"
    }
  ],
  "tips": [
    "糯米泡足两小时，煮后米心才不生。",
    "米只灌八分满，煮的时候才不爆开。",
    "晾凉再切片，热切容易散成一团。"
  ],
  "common_mistakes": [
    "糯米没泡透就灌，煮完中心还是硬粒。",
    "藕孔灌太满，煮后米胀得满锅都是。",
    "热着就切片，藕片散碎完全不成形状。"
  ],
  "substitutions": [
    {
      "original": "冰糖",
      "substitute": "红糖",
      "ratio": "80g 对 80g",
      "note": "颜色更深，甜味更厚。"
    },
    {
      "original": "桂花",
      "substitute": "桂花蜜",
      "ratio": "5g 对 20g",
      "note": "出锅前淋上，香气更鲜。"
    }
  ],
  "variations": [
    "蜜汁版：煮好后淋 30g 蜂蜜，甜度更亮。",
    "加红豆版：糯米里拌入 30g 蜜红豆，口感更丰富。"
  ],
  "serving_suggestion": "切厚片上桌，淋一勺甜汁，冷热皆宜。",
  "storage": "冷藏 3 天，切片后复蒸 10 分钟回软。",
