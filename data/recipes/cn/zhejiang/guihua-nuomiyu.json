      "group": "main",
      "items": [
        {
          "name": "莲藕",
          "name_en": "lotus root",
          "amount": 600,
          "unit": "g",
          "note": "选粗壮七孔藕",
          "optional": false
        },
        {
          "name": "糯米",
          "name_en": "glutinous rice",
          "amount": 150,
