  "steps": [
    {
      "n": 1,
      "text": "河虾剪掉虾须和额剑，用牙签挑出虾线。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "虾线不挑，吃着有泥沙味。，看准状态再往下做。",
      "visual_cue": "虾身干净，虾线全净"
    },
    {
      "n": 2,
      "text": "洗净的河虾用厨房纸吸干表面水分。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "带水下油锅会爆油，务必吸干。，看准状态再往下做。",
      "visual_cue": "虾壳干爽，不滴水，这一点很关键。"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到八成热，下虾炸半分钟。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "油温够高，虾壳才一炸就脆。，看准状态再往下做。",
      "visual_cue": "虾身瞬间通红，壳起泡"
    },
    {
      "n": 4,
      "text": "捞出虾，把油温再升高后回锅复炸十秒。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "复炸一次，壳脆得能直接嚼。，看准状态再往下做。",
      "visual_cue": "虾壳发亮，触须卷曲"
    },
    {
      "n": 5,
      "text": "另起锅留底油，下姜末和葱段炒香。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "葱姜炒出香，甜酸汁才不寡。，看准状态再往下做。",
      "visual_cue": "葱段微黄，香气散出"
    },
    {
      "n": 6,
      "text": "加生抽、白糖、香醋和料酒，小火熬到微稠。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖化了汁才有挂力。，看准状态再往下做。",
      "visual_cue": "汤汁起泡，色泽红亮"
    },
    {
      "n": 7,
      "text": "倒入炸好的河虾，大火快速翻匀裹汁。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "虾下锅就翻，久了壳就软了。，看准状态再往下做。",
      "visual_cue": "每只虾都裹上红汁，这一点很关键。"
    },
    {
      "n": 8,
      "text": "淋香油出锅，趁热吃壳最脆。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油最后点，香气更清。，看准状态再往下做。",
      "visual_cue": "表面油亮，虾壳通红"
    }
  ],
  "tips": [
    "虾要吸干水分再下油锅，否则溅油厉害。",
    "复炸十秒，虾壳才脆到能嚼。，这一点很关键。",
    "汁熬到微稠再下虾，才能挂得住。，这一点很关键。"
  ],
  "common_mistakes": [
    "虾没剪须，吃的时候扎嘴。，这一点很关键。",
    "油温不够，虾壳软塌吸油。，这一点很关键。",
    "汁太稀，虾泡在汤里不脆。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "河虾",
      "substitute": "基围虾",
      "ratio": "500 克:500 克",
      "note": "个头大，炸的时间加二十秒。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "10 毫升:10 毫升",
      "note": "酸味更冲，糖可略加。"
    }
  ],
  "variations": [
    "加一点番茄酱，颜色更红亮。，这一点很关键。",
    "放几段干辣椒，甜中带辣。，这一点很关键。"
  ],
  "serving_suggestion": "连壳吃，配黄酒最对味。，这一点很关键。",
  "storage": "冷藏一天，复热用炒锅干煸回脆。，这一点很关键。",
