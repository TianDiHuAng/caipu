        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "汤勺",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸭腿斩成大块，冷水下锅加料酒汆八分钟，捞出用温水冲净。",
      "time_min": 12,
      "heat": "中火",
      "tip": "鸭腿腥气重，汆水要汆透再煲。",
      "visual_cue": "鸭腿皮收紧、水面浮起灰白浮沫"
    },
    {
      "n": 2,
      "text": "竹笋去壳切滚刀块，冷水下锅煮五分钟去掉涩味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "笋先焯水，汤才不发涩。",
      "visual_cue": "笋块色泽转浅、青涩味消散"
    },
    {
      "n": 3,
      "text": "砂锅加清水、生姜片与小葱结烧开，放入鸭腿块大火滚十分钟。",
      "time_min": 13,
      "heat": "大火",
      "tip": "先大火滚白，汤色才够浓。",
      "visual_cue": "汤色转奶白、香气上浮"
    },
    {
      "n": 4,
      "text": "转小火加盖慢煲八十分钟，中途撇两次浮油。",
      "time_min": 82,
      "heat": "小火",
      "tip": "小火慢煲，鸭腿肉才酥而不散。",
      "visual_cue": "鸭腿肉轻压即离骨、汤面油花清亮"
    },
    {
      "n": 5,
      "text": "放入竹笋继续煲二十分钟，加盐与白胡椒调味。",
      "time_min": 22,
      "heat": "小火",
      "tip": "笋后放，久煲会失掉脆感。",
      "visual_cue": "笋块吸汤、汤色清爽发亮"
    }
  ],
  "tips": [
    "鸭腿腥气较重，汆水时加几片生姜更干净。",
    "汤面的浮油撇两次，喝起来才不腻。",
    "砂锅蓄热好，关火后仍会继续沸腾，盐要早两分钟放。"
  ],
  "common_mistakes": [
    "鸭腿块没汆水就直接煲，汤腥还发灰。",
    "全程大火煲煮，鸭腿肉散烂汤也变浑浊。",
    "盐放得太早，鸭腿肉久煲不入味还发紧。"
  ],
  "substitutions": [
    {
      "original": "鸭腿",
      "substitute": "整鸡",
      "ratio": "600g 对 800g",
      "note": "腥气轻，煲制时间减三十分钟。"
    },
    {
      "original": "竹笋",
      "substitute": "冬瓜",
      "ratio": "150g 对 300g",
      "note": "更清爽，最后十五分钟放。"
    }
  ],
  "variations": [
    "加一小块咸肉同煲，汤更鲜，是江浙的常见做法。",
    "把竹笋换成笋衣同煲，汤带一点发酵的醇香。"
  ],
  "serving_suggestion": "盛碗先喝汤再吃肉，撒少许葱花提香。",
  "storage": "冷藏可放三天，复热须煮沸五分钟。",
