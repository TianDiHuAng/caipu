  "equipment": [
    "汤锅",
    "炒锅",
    "小刀",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋冷水下锅，水开后中小火煮八分钟，捞出泡冷水。",
      "time_min": 11,
      "heat": "中火",
      "tip": "冷水下锅不容易裂壳，煮好立刻过冷水好剥。",
      "visual_cue": "蛋壳完整不开裂，剥开后蛋面光滑"
    },
    {
      "n": 2,
      "text": "剥壳后的鸡蛋用小刀在表面竖着均匀划四道浅口。",
      "time_min": 4,
      "heat": "无火",
      "tip": "划口能让酱汁渗进去，划太深蛋会散。",
      "visual_cue": "蛋白上有细浅刀痕，蛋形仍完整"
    },
    {
      "n": 3,
      "text": "炒锅小火放花生油，下姜片、葱结与干辣椒煸出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香料只为打底，煸到出味就够了，别炒焦。",
      "visual_cue": "葱结泛黄，油里有明显香气"
    },
    {
      "n": 4,
      "text": "放入鸡蛋转中火，滚动着煎到表面起一层薄薄的虎皮。",
      "time_min": 5,
      "heat": "中火",
      "tip": "滚动煎比静置煎更均匀，蛋面才有细皱皮。",
      "visual_cue": "蛋白表面出现浅金细皱"
    },
    {
      "n": 5,
      "text": "加料酒、生抽、老抽与白糖，倒入没过蛋一半的热水。",
      "time_min": 2,
      "heat": "中火",
      "tip": "一定要加热水，冷水会让蛋皮突然收缩变硬。",
      "visual_cue": "汤汁呈深琥珀色，蛋半浸其中"
    },
    {
      "n": 6,
      "text": "盖盖小火焖十分钟，中途翻动两次让颜色均匀。",
      "time_min": 10,
      "heat": "小火",
      "tip": "小火慢焖才入味，大火会把汤汁煮干。",
      "visual_cue": "蛋面染成红褐色，汤汁减半"
    },
    {
      "n": 7,
      "text": "开盖后大火收汁，用勺把浓汁反复淋在蛋上面。",
      "time_min": 3,
      "heat": "大火",
      "tip": "淋汁比翻动更能保住蛋形，颜色也更亮。",
      "visual_cue": "汤汁浓稠挂勺，蛋面油亮如釉"
    },
    {
      "n": 8,
      "text": "尝味后按需加盐，出锅装盘，淋上剩余的酱汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生抽老抽都有咸味，盐多数时候可以不加。",
      "visual_cue": "盘中酱汁聚拢，蛋体红亮"
    }
  ],
  "tips": [
    "煮蛋时水里加一小勺盐，蛋壳不易破。",
    "想更入味可以把蛋在汤汁里泡一夜再收汁。",
    "加一块五花肉同烧，蛋会吸足肉香。",
    "放凉了吃也好吃，切片拌面很合适。"
  ],
  "common_mistakes": [
    "蛋煮好后没立刻过冷水，壳粘蛋白剥得坑坑洼洼。",
    "不划口直接烧，酱汁只停在表面，里面还是白味。",
    "大火猛烧不收汁，最后蛋皮又硬又咸。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "鹌鹑蛋",
      "ratio": "240克:240克",
      "note": "煮的时间缩短到四分钟，更易入味。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "18克:20克",
      "note": "收汁更亮，甜味更柔和。"
    }
  ],
  "variations": [
    "加几片豆腐干一起烧，做成卤味拼盘。",
    "收汁后撒白芝麻与葱花，卖相更精致。"
  ],
  "serving_suggestion": "装盘后浇上浓汁，配白饭或面条，也可冷切后当下酒小菜。",
  "storage": "冷藏三天，连汁一起保存，复热小火煮开即可。",
