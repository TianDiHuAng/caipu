  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草鱼去鳞去内脏洗净，切成五厘米见方的块，用盐和绍兴酒抓匀腌十分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "鱼块别切太小，煎的时候容易碎散。",
      "visual_cue": "鱼块洁白挺立，表面微微出水"
    },
    {
      "n": 2,
      "text": "鱼块用厨房纸吸干水分，两面薄薄拍一层淀粉，抖掉多余的粉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "拍薄粉锁住水分，煎时皮不破也不粘锅。",
      "visual_cue": "鱼块表面干爽，粉层薄而均匀"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，鱼块皮朝下摆入，中火煎到两面金黄。",
      "time_min": 10,
      "heat": "中火",
      "tip": "下锅后先别动，等定型再翻面才不会破皮。",
      "visual_cue": "鱼块两面金黄，边缘微焦挺括"
    },
    {
      "n": 4,
      "text": "拨开鱼块下姜片、蒜碎与葱白爆香，淋绍兴酒，加生抽、老抽和清水。",
      "time_min": 5,
      "heat": "中火",
      "tip": "调料沿锅边淋入，香气才激得出来。",
      "visual_cue": "酱汁沸腾冒泡，汤色红亮"
    },
    {
      "n": 5,
      "text": "加白砂糖转小火加盖烧十分钟，中途轻推锅底防粘，收汁撒葱段出锅。",
      "time_min": 12,
      "heat": "小火",
      "tip": "收汁用小火慢推，鱼块才完整不散。",
      "visual_cue": "汤汁浓稠挂勺，鱼块完整油亮"
    }
  ],
  "tips": [
    "鱼块一定要吸干水分再拍粉，否则下锅就粘。",
    "煎鱼时别急着翻面，等定型再动，皮才完整。",
    "烧的时候用小火，大火滚会把鱼块冲散。",
    "绍兴酒沿锅边淋入，去腥效果比直接倒进汤里强。"
  ],
  "common_mistakes": [
    "鱼块带水下锅，油花四溅还粘得锅底一层。",
    "反复翻动鱼块，最后全部碎成小块。",
    "淀粉拍得太厚，烧出来外皮糊嘟嘟的。",
    "大火收汁，汤汁糊底发苦还带焦味。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲤鱼",
      "ratio": "700克:700克",
      "note": "肉质更紧，烧的时间加两分钟。"
    },
    {
      "original": "绍兴酒",
      "substitute": "黄酒",
      "ratio": "30毫升:30毫升",
      "note": "香气略淡，去腥效果接近。"
    }
  ],
  "variations": [
    "烧的时候加一把泡软的干香菇，鲜味更足。",
    "最后淋一勺香醋，酸香解腻，很浙式的做法。",
    "改用鲫鱼整条烧，不去头尾，摆盘更有面子也更像宴客菜。"
  ],
  "serving_suggestion": "鱼块盛在长盘里，淋上锅里的红烧汁，撒葱段与少许胡椒粉，配米饭吃最下饭。",
  "storage": "冷藏可放一天，复热用小火加两勺水烧开，微波加热会让鱼肉变老。",
