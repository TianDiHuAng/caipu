  "equipment": [
    "蒸锅",
    "鱼盘",
    "小锅",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼洗净擦干，在鱼身两侧各划三刀，刀口深到贴骨处。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划刀让热气进得去，鱼厚的地方才不会夹生。",
      "visual_cue": "鱼身两面对称开出浅口，形完整"
    },
    {
      "n": 2,
      "text": "鱼身内外抹盐与料酒，鱼腹塞姜片与葱段腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "盐只需薄薄一层，抹多了鱼肉会发紧出水。",
      "visual_cue": "鱼身微湿，腹中塞满葱姜"
    },
    {
      "n": 3,
      "text": "盘底铺葱段与姜片，把鱼架在上面，鱼身放几片火腿。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鱼要架空，底部才能进蒸汽不泡在血水里。",
      "visual_cue": "鱼身离盘底有明显空隙"
    },
    {
      "n": 4,
      "text": "蒸锅水大火烧到翻滚冒大泡，再把鱼盘放进蒸格。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水必须先开再放鱼，冷水上锅鱼肉会老。",
      "visual_cue": "锅内蒸汽冲顶，锅盖边缘冒白气"
    },
    {
      "n": 5,
      "text": "大火足汽蒸八分钟，关火之后再虚蒸两分钟取出。",
      "time_min": 11,
      "heat": "大火",
      "tip": "一斤半左右的鱼八分钟刚好，越大要加时间。",
      "visual_cue": "鱼眼发白凸出，鱼皮微微开裂"
    },
    {
      "n": 6,
      "text": "取出鱼盘，倒掉盘里的腥水，夹走蒸过的葱姜。",
      "time_min": 2,
      "heat": "无火",
      "tip": "这盘水带腥味，不倒掉会把清鲜味盖住。",
      "visual_cue": "盘底积水倒净，只剩鱼身摆在盘中"
    },
    {
      "n": 7,
      "text": "鱼身铺新鲜葱丝与姜丝，小锅烧花生油到冒烟后泼上去。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油要烧到微微冒烟，泼下去才有滋啦声激香。",
      "visual_cue": "葱丝瞬间卷曲变色，香气冲上来"
    },
    {
      "n": 8,
      "text": "生抽加白糖与少许热水调匀，沿盘边淋入，再点几滴香油。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酱汁要沿盘边倒入，鱼肉颜色才干净好看。",
      "visual_cue": "盘底一层浅褐汁，鱼身仍然雪白"
    }
  ],
  "tips": [
    "鱼要选眼睛清亮、鳃色鲜红的新鲜货。",
    "蒸的时间按鱼的重量调整，每多二两加半分钟。",
    "火腿片能提鲜，家里没有也可以不放。",
    "上桌前别盖盖子，闷住会让葱丝发黄。"
  ],
  "common_mistakes": [
    "冷水上锅蒸鱼，鱼的肉质发柴还带着腥气。",
    "蒸好后不倒盘里的水，整道菜一股腥气压住鲜味。",
    "蒸过头鱼皮裂开鱼肉散成瓣，一夹就碎。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "鲳鱼",
      "ratio": "700克:600克",
      "note": "肉质更紧实，蒸的时间减一分钟。"
    },
    {
      "original": "料酒",
      "substitute": "米酒",
      "ratio": "20毫升:20毫升",
      "note": "香气更甜，去腥效果相近。"
    }
  ],
  "variations": [
    "鱼身铺几片火腿与竹笋，做成更讲究的三鲜蒸鱼。",
    "淋一勺蒸鱼豉油替代生抽，颜色更清亮。"
  ],
  "serving_suggestion": "端上桌后再把葱丝拨散，趁热用筷子从鱼背夹肉，蘸盘底的汁吃。",
  "storage": "现蒸现吃最好，冷藏一天后再蒸三分钟回热，口感会略干。",
