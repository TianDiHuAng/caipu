  "equipment": [
    "炖锅",
    "大碗",
    "细筛",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "银耳用冷水泡三十分钟，泡到完全舒展发软，剪掉根部黄色硬蒂。",
      "time_min": 30,
      "heat": "无火",
      "tip": "用冷水泡，热水泡容易外软内硬，出胶也少。",
      "visual_cue": "银耳舒展，根部硬蒂已去"
    },
    {
      "n": 2,
      "text": "泡好的银耳撕成小块，越碎越容易出胶，红枣用刀划开去核。",
      "time_min": 6,
      "heat": "无火",
      "tip": "撕得越碎越好，炖二十分钟就能起胶质",
      "visual_cue": "耳片碎小，枣肉完整不破"
    },
    {
      "n": 3,
      "text": "炖锅放银耳和清水，大火烧开后转小火，盖盖炖四十分钟。",
      "time_min": 42,
      "heat": "小火",
      "tip": "水要一次加足量，中途加水会冲淡胶质",
      "visual_cue": "汤色渐白，耳片浮起打转"
    },
    {
      "n": 4,
      "text": "放红枣继续小火炖二十分钟，炖到汤变稠、银耳边缘发亮。",
      "time_min": 20,
      "heat": "小火",
      "tip": "枣放太早会煮烂散形，后半程再加刚好",
      "visual_cue": "汤汁挂勺，枣形完整不散"
    },
    {
      "n": 5,
      "text": "加白糖搅到化开，撒入枸杞再煮三分钟，关火焖五分钟即可。",
      "time_min": 8,
      "heat": "小火",
      "tip": "枸杞久煮会发酸，最后放颜色也好看。",
      "visual_cue": "糖水清亮，枸杞红润完整"
    }
  ],
  "tips": [
    "银耳要出胶，靠的是冷水泡发和足够长的慢炖，急不来。",
    "撕得越碎越容易出胶，赶时间可以用剪刀剪成小片。",
    "甜度按口味调，但糖要在出锅前放，早放会影响出胶。"
  ],
  "common_mistakes": [
    "银耳泡十分钟就下锅，炖一小时也不出胶，汤清得像水。",
    "根部硬蒂没剪干净，炖完带一股生味，整锅汤都不清爽。",
    "红枣一开始就放进去，炖到最后全散了，汤色浑浊还带酸味。"
  ],
  "substitutions": [
    {
      "original": "银耳",
      "substitute": "丑耳",
      "ratio": "40克:35克",
      "note": "丑耳胶质更足，泡发时间可减到二十五分钟。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "30克:32克",
      "note": "冰糖甜味更清，喜欢浓稠可加到四十克。"
    }
  ],
  "variations": [
    "加几颗莲子和银耳同炖，口感更丰富，也更适合秋天。",
    "冷藏后拌一勺桂花糖，做成冰镇银耳羹，夏天当甜汤喝。"
  ],
  "serving_suggestion": "温热时盛小碗，饭后来一碗清口，也可以冷藏后当夏季甜汤饮用。",
  "storage": "冷藏可放三天，久放会变稀；回热时小火加热，出现酸味或拉丝异常须丢弃。",
