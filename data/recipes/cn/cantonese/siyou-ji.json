  "equipment": [
    "砂锅",
    "漏勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿洗净后擦干水分，在肉厚处浅划两刀，方便豉油味渗进去。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划刀不要太深，煮时肉才不会散。",
      "visual_cue": "鸡腿表面干爽、刀口整齐"
    },
    {
      "n": 2,
      "text": "砂锅中放生抽、老抽、冰糖、料酒与 500ml 清水，加姜片、葱段、八角与桂皮大火烧开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "豉油汁先烧开再下鸡腿，皮更紧实。",
      "visual_cue": "汤汁沸腾、香气四溢"
    },
    {
      "n": 3,
      "text": "放入鸡腿转小火，保持汤汁微沸浸煮 12 分钟，中途用勺淋汁。",
      "time_min": 12,
      "heat": "小火",
      "tip": "汤汁不能大滚，滚了鸡皮会破。",
      "visual_cue": "鸡皮收紧、表面酱色"
    },
    {
      "n": 4,
      "text": "把鸡腿翻面再浸煮 12 分钟，关火后加盖焖 10 分钟让肉中心熟透。",
      "time_min": 22,
      "heat": "小火",
      "tip": "关火焖是让肉嫩的关键一步。",
      "visual_cue": "筷子插入无血水渗出"
    },
    {
      "n": 5,
      "text": "鸡腿捞出稍凉后斩成块，原汤大火收浓至挂勺，按口味补 3g 盐成豉油汁。",
      "time_min": 8,
      "heat": "大火",
      "tip": "汁收浓一点，浇在鸡肉上才挂得住。",
      "visual_cue": "豉油汁浓稠、色深发亮"
    }
  ],
  "tips": [
    "汤汁保持微沸，鸡皮才完整不破。",
    "关火焖 10 分钟，肉中心才会熟而不柴。",
    "斩件后淋一勺热豉油汁，色泽更亮。"
  ],
  "common_mistakes": [
    "大火滚煮，鸡皮破裂、肉质变老。",
    "豉油汁兑水太多，成品味道寡淡。",
    "鸡腿一出锅就斩，肉汁流失、切面发干。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸡翅",
      "ratio": "900g 对 900g",
      "note": "鸡翅易熟，浸煮时间减 4 分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "片糖",
      "ratio": "40g 对 35g",
      "note": "片糖甜味更醇，色泽略深。"
    }
  ],
  "variations": [
    "玫瑰豉油版：豉油汁中加 20g 玫瑰露酒，香气更雅。",
    "白切对比版：同锅煮好不斩件，冰水一浸更爽弹。"
  ],
  "storage": "冷藏 2 天，复热隔水蒸 8 分钟，勿微波以免肉柴。",
