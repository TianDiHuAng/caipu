    "漏勺",
    "小奶锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芥蓝削去根部老皮，粗茎处纵向划一刀，洗净后沥干水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划刀能让粗茎与嫩叶同时熟，避免茎生叶烂。",
      "visual_cue": "茎部露出浅色嫩肉"
    },
    {
      "n": 2,
      "text": "清水加盐与 5ml 植物油烧开，先下芥蓝茎部烫 40 秒，再整棵入水烫 40 秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "水中加油能让菜叶保持翠绿发亮。",
      "visual_cue": "芥蓝由深绿转为鲜亮的翠绿"
    },
    {
      "n": 3,
      "text": "捞出立刻放入冰水或冷开水中过凉 30 秒，沥干后整齐码盘。",
      "time_min": 1,
      "heat": "无火",
      "tip": "过凉能锁住颜色与脆度，摆盘也更挺。",
      "visual_cue": "菜梗掰开有清脆声"
    },
    {
      "n": 4,
      "text": "小奶锅放生抽、蚝油、白糖与 20ml 清水小火煮开成豉油，浇在芥蓝上。",
      "time_min": 2,
      "heat": "小火",
      "tip": "豉油要煮开再用，生酱油有生涩味。",
      "visual_cue": "豉油微稠、表面泛起细泡"
    },
    {
      "n": 5,
      "text": "锅烧热 20ml 植物油至冒烟，铺上姜丝葱丝，热油浇在葱姜上激香。",
      "time_min": 1,
      "heat": "中大火",
      "tip": "油温要够高，浇下去能听到明显的滋啦声。",
      "visual_cue": "葱姜瞬间卷曲、香气冲起"
    }
  ],
  "tips": [
    "焯水时间按茎的粗细调整，粗茎可多烫 20 秒。",
    "豉油本身有咸味，焯水时盐只放 4g，避免过咸。",
    "没有芥蓝时可用菜心或西兰花，焯水时间相应缩短。"
  ],
  "common_mistakes": [
    "整棵直接下锅久煮，叶子发黄发烂、茎仍偏硬。",
    "焯完不过凉水，余温继续加热，颜色变暗。",
    "豉油直接浇生酱油，缺少煮开的醇厚感。"
  ],
  "substitutions": [
    {
      "original": "芥蓝",
      "substitute": "菜心",
      "ratio": "1:1",
      "note": "菜心更嫩，焯水时间减到 40 秒。"
    },
    {
      "original": "蚝油",
      "substitute": "蒸鱼豉油",
      "ratio": "10g 蚝油 ≈ 10ml 蒸鱼豉油",
      "note": "咸度更高，生抽减到 15ml。"
    }
  ],
  "variations": [
    "蒜蓉版：焯好后铺蒜末再泼油，辛香更足。",
    "上汤版：用 150ml 高汤加皮蛋碎煮开淋上，做成上汤芥蓝。"
  ],
  "serving_suggestion": "作为粤式家常餐桌的青菜位，配烧腊或煲仔饭最合适。",
  "storage": "现做现吃，冷藏后颜色会变暗；剩余可切碎做炒饭。",
