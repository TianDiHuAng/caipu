  "equipment": [
    "蒸锅",
    "小刀",
    "刷子",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扇贝用刷子把外壳两面刷干净，小刀沿壳缝撬开取出贝肉，去掉黑色内脏与腮，壳洗净留用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "外壳要刷到没有泥沙，摆盘才干净。",
      "visual_cue": "贝壳干净无泥、贝肉完整"
    },
    {
      "n": 2,
      "text": "粉丝用温水泡八分钟到变软，捞出剪成两段，盘进贝壳底部垫一层。",
      "time_min": 10,
      "heat": "无火",
      "tip": "粉丝别泡太久，蒸完会烂。",
      "visual_cue": "粉丝柔软能绕指、不碎"
    },
    {
      "n": 3,
      "text": "大蒜剁成蓉，一半用植物油小火炸到微黄，与另一半生蒜蓉、生抽、蚝油、白糖、盐和清水拌成蒜蓉酱。",
      "time_min": 8,
      "heat": "小火",
      "tip": "生熟蒜各半，香气才有层次。",
      "visual_cue": "蒜蓉酱稠稀适中、蒜香浓"
    },
    {
      "n": 4,
      "text": "贝肉放回贝壳，淋上料酒，再舀一勺蒜蓉酱盖在贝肉上，酱要铺满不外溢。",
      "time_min": 5,
      "heat": "无火",
      "tip": "贝肉先回壳再淋酱，蒸后才不缩。",
      "visual_cue": "每只扇贝酱量均匀"
    },
    {
      "n": 5,
      "text": "蒸锅水大开后把扇贝摆入，盖盖大火蒸五分钟，取出撒葱花与小米辣圈。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水开再上锅，五分钟足矣，久了发硬。",
      "visual_cue": "贝肉转白卷边、汤汁清"
    },
    {
      "n": 6,
      "text": "另起小锅把剩余的植物油烧到冒烟，逐只浇在葱花上激出香味即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "热油要浇在葱花上，香味才冲。",
      "visual_cue": "葱花滋滋作响、油香扑鼻"
    }
  ],
  "tips": [
    "扇贝买回来先用淡盐水养半小时，吐净泥沙再处理。",
    "粉丝垫底会吸汁，喜欢粉丝可加到八十克。",
    "没有蒸鱼豉油时用生抽加白糖替代，味道接近。"
  ],
  "common_mistakes": [
    "蒸的时间超过八分钟，贝肉缩成小块咬不动。",
    "蒜蓉全部炸熟，缺少生蒜的辛香层次。",
    "贝肉不摘内脏直接蒸，吃起来有沙腥味。"
  ],
  "substitutions": [
    {
      "original": "扇贝",
      "substitute": "带子",
      "ratio": "400g 对 400g",
      "note": "带子无壳，用粉丝垫小碟蒸。"
    },
    {
      "original": "粉丝",
      "substitute": "金针菇",
      "ratio": "60g 对 150g",
      "note": "金针菇出水多，蒸时少加清水。"
    }
  ],
  "variations": [
    "加一勺豆豉同蒸，做成豉汁蒜蓉双味版。",
    "把小米辣换成剁椒，颜色更红亮、辣味更直接。"
  ],
  "serving_suggestion": "每人两只连壳上桌，底下的粉丝拌汤汁一起吃。",
  "storage": "现蒸现吃，冷藏后复蒸两分钟口感会变硬。",
