  "steps": [
    {
      "n": 1,
      "text": "薏米和莲子分别淘洗干净，加清水泡到颗粒明显发胀。",
      "time_min": 55,
      "heat": "无火",
      "tip": "薏米难煮透，泡够时间汤才不夹生。",
      "visual_cue": "薏米捏得动，莲子发白鼓胀"
    },
    {
      "n": 2,
      "text": "排骨冷水下锅焯到浮沫浮起，捞出用温水冲净血污。",
      "time_min": 8,
      "heat": "中火",
      "tip": "冷水下锅才能把血水逼出来，汤才清。",
      "visual_cue": "浮沫成片浮起，排骨颜色变浅"
    },
    {
      "n": 3,
      "text": "姜切成薄片，红枣去核，蜜枣冲洗干净，枸杞单独留出。",
      "time_min": 3,
      "heat": "无火",
      "tip": "红枣去核煲出来不燥，汤味更甘润。",
      "visual_cue": "姜片整齐，红枣完好无碎"
    },
    {
      "n": 4,
      "text": "汤锅加清水，放排骨、姜片、薏米和莲子，大火烧开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水要一次加够，中途添水汤味会变淡。",
      "visual_cue": "水面滚开，浮沫聚在边缘"
    },
    {
      "n": 5,
      "text": "转小火盖盖煲一小时，中途撇掉浮油和浮沫。",
      "time_min": 60,
      "heat": "小火",
      "tip": "保持微微冒泡的状态，汤色才清不浑。",
      "visual_cue": "汤面轻滚，香气清甜"
    },
    {
      "n": 6,
      "text": "加红枣和蜜枣再煲二十分钟，汤色转成浅奶白。",
      "time_min": 20,
      "heat": "小火",
      "tip": "红枣后放，久煮会散烂发酸失香。",
      "visual_cue": "汤色浅奶白，枣香明显"
    },
    {
      "n": 7,
      "text": "加盐调味，撒入枸杞再煮两分钟关火盛碗上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "枸杞最后再下，久煮会发苦失香掉色。",
      "visual_cue": "枸杞饱满浮在汤面"
    }
  ],
  "tips": [
    "薏米莲子提前泡发，煲出来才软糯不夹生。",
    "全程小火慢煲，大火滚出来汤会浑。",
    "盐一定要最后再放，早放排骨容易柴硬。"
  ],
  "common_mistakes": [
    "排骨热水下锅焯，血水锁在里面汤发腥。",
    "大火滚足全程，汤变浑浊还容易烧干。",
    "盐一开始就下，肉质紧缩口感发柴。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "猪骨",
      "ratio": "400 克:450 克",
      "note": "胶质更多，汤更浓需延长二十分钟。"
    },
    {
      "original": "蜜枣",
      "substitute": "红枣",
      "ratio": "20 克:30 克",
      "note": "甜度降低，可加两克冰糖调和。"
    }
  ],
  "variations": [
    "加一小块陈皮同煲，清香解腻层次更足。",
    "放几粒白果一起煲，汤体更甘香润口。"
  ],
  "serving_suggestion": "趁热喝汤吃肉，配一碗白饭就是清润的一餐。",
  "storage": "冷藏可放两天，复热烧至滚沸再喝。",
