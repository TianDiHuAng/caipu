  "steps": [
    {
      "n": 1,
      "text": "隔夜冷饭用手把结块的米粒搓散，摊开晾十五分钟让表面水分再散掉一些。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷饭要搓散晾干，湿饭下锅只会炒成一团糊。",
      "visual_cue": "米粒松散不粘手，颗颗分明。"
    },
    {
      "n": 2,
      "text": "鸡腿肉切一厘米小粒，加料酒、生抽、白胡椒和玉米淀粉抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鸡粒切小才好与米粒同熟，大了会外老内生。",
      "visual_cue": "鸡粒均匀，表面薄薄挂浆。"
    },
    {
      "n": 3,
      "text": "咸鱼去骨切小粒，下锅用少量花生油小火煎到金黄出香，盛出留油。",
      "time_min": 5,
      "heat": "小火",
      "tip": "咸鱼煎透才不腥，留一点底油炒饭更香。",
      "visual_cue": "咸鱼粒焦黄，咸香溢出。"
    },
    {
      "n": 4,
      "text": "锅中补油烧热，下鸡粒中火炒到变白断生盛出，锅中留底油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鸡粒先炒后回锅，久炒会老，盛出后余温还会继续熟。",
      "visual_cue": "鸡粒表面金黄，中心不见粉红。"
    },
    {
      "n": 5,
      "text": "鸡蛋打散倒入锅中炒成蛋花，随即下冷饭大火翻炒，把米粒炒散炒热。",
      "time_min": 4,
      "heat": "大火",
      "tip": "蛋花半凝固就下饭，蛋液能裹住米粒更香。",
      "visual_cue": "米粒在锅里跳动，蛋花均匀分布。"
    },
    {
      "n": 6,
      "text": "倒回鸡粒与咸鱼粒，加盐和生抽快速翻炒均匀，撒葱花和姜末再翻两下出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "咸鱼本身够咸，盐和生抽减量，出锅前先尝一口。",
      "visual_cue": "饭粒油亮松散，葱绿点缀。"
    }
  ],
  "tips": [
    "炒饭一定要用隔夜冷饭，新煮的饭水分太多炒不散。",
    "咸鱼选梅香或马友，香气足，用量控制在四十克以内。",
    "全程大火快炒，锅气足饭才香，锅小可分两次炒。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭炒，米饭粘成坨，越炒越糊。",
    "咸鱼放太多，整盘只剩咸味，鸡粒的鲜都被盖住。",
    "火太小慢慢翻，饭粒被油浸软，吃着腻口。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "虾仁",
      "ratio": "1:1",
      "note": "换成虾仁即咸鱼虾粒炒饭，虾仁炒到卷曲变红即可。"
    },
    {
      "original": "咸鱼",
      "substitute": "虾米",
      "ratio": "40克:30克",
      "note": "不吃咸鱼用虾米代替，鲜味清一些，盐可正常放。"
    }
  ],
  "variations": [
    "有的师傅在饭里加一小把焯熟的豌豆，颜色更好看。",
    "澳门做法会加少许咖喱粉，炒出来带金黄和微辣。"
  ],
  "serving_suggestion": "盛盘堆成小山，配一碗清汤或冻柠茶；趁热吃，凉了咸腥味会重。",
  "storage": "现炒现吃，冷藏不超过一日；复热用炒锅大火快炒一分钟，别微波。",
