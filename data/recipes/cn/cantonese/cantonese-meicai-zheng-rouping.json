  "equipment": [
    "蒸锅",
    "菜刀",
    "大碗",
    "浅盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "梅干菜用温水泡二十分钟，反复抓洗三遍去掉沙粒，捞出挤干后切成碎末。",
      "time_min": 25,
      "heat": "无火",
      "tip": "梅干菜里沙多，一直洗到水清，否则吃着牙碜",
      "visual_cue": "菜末松散，抓洗到盆底不见沙粒"
    },
    {
      "n": 2,
      "text": "猪肉末放进大碗，加生抽、白糖和淀粉，顺一个方向搅到发黏。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一定要顺同一个方向搅，肉馅才上劲不发散",
      "visual_cue": "肉馅搅到黏稠，能拉出细细的丝"
    },
    {
      "n": 3,
      "text": "分三次加入清水，每次都搅到水被完全吸收，肉馅变得蓬松有弹性。",
      "time_min": 4,
      "heat": "无火",
      "tip": "打水能让肉饼蒸出来更嫩，水别一次全倒进去",
      "visual_cue": "肉馅吸饱水，体积看着明显变大"
    },
    {
      "n": 4,
      "text": "拌入梅干菜末、姜末和植物油，再搅半分钟，让菜和肉均匀混合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "植物油最后放，能把水分封在肉馅里不流失",
      "visual_cue": "菜和肉混合均匀，表面油润发亮"
    },
    {
      "n": 5,
      "text": "肉馅摊进浅盘压成一厘米厚的圆饼，用勺背抹平表面，中间略凹。",
      "time_min": 4,
      "heat": "无火",
      "tip": "中间压凹一点，蒸的时候受热均匀不会鼓包",
      "visual_cue": "饼面抹得平整，整盘厚薄处处一致"
    },
    {
      "n": 6,
      "text": "蒸锅水开后放盘，大火蒸十五分钟，出锅撒葱花，淋一勺盘里的汁。",
      "time_min": 17,
      "heat": "大火",
      "tip": "蒸够时间肉饼中心才熟透，可以用筷子插着试",
      "visual_cue": "饼身紧实不散，撒的葱花依然翠绿"
    }
  ],
  "tips": [
    "梅干菜本身带咸，生抽只放十五毫升，尝过再决定要不要加盐。",
    "肉末别选全瘦的，三成肥肉蒸出来才润，全瘦会发柴。",
    "打水是肉饼嫩的关键，四十毫升水分三次加，一次加多了肉馅会散。"
  ],
  "common_mistakes": [
    "梅干菜没泡透就切，蒸出来又硬又咸，肉饼整体发苦。",
    "肉馅乱搅一通，方向反反复复，蒸好后肉饼开裂出水。",
    "冷水上锅蒸，肉饼慢慢受热，表面塌陷，底部积一层水。"
  ],
  "substitutions": [
    {
      "original": "梅干菜",
      "substitute": "冬菜",
      "ratio": "60克:60克",
      "note": "冬菜咸度更高，需减到四十克。"
    },
    {
      "original": "猪肉末",
      "substitute": "鸡肉末",
      "ratio": "400克:400克",
      "note": "鸡肉瘦，打水量可增到六十毫升。"
    }
  ],
  "variations": [
    "肉饼上铺三片咸蛋黄同蒸，咸香更浓，卖相也更讨喜。",
    "把梅干菜换成香菇末和虾仁，做成鲜香版肉饼，孩子更爱吃。"
  ],
  "serving_suggestion": "连盘上桌，用勺子挖着吃，配白饭和一碟青菜，是粤式家常的经典搭配。",
  "storage": "冷藏可放两天，回热时蒸八分钟，不要用微波炉，否则肉饼会变硬。",
