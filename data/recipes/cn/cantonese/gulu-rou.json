  "equipment": [
    "炒锅",
    "漏勺",
    "深碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切成两厘米见方的块，加盐与生抽抓匀腌十五分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "肉块大小一致，炸出来才同步成熟。",
      "visual_cue": "肉块方整、表面微微发黏"
    },
    {
      "n": 2,
      "text": "玉米淀粉与面粉混合，加鸡蛋液和少量清水调成能流动的稠糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "糊要稠一些，才挂得住肉块。",
      "visual_cue": "糊提起呈缓慢下流的长条"
    },
    {
      "n": 3,
      "text": "肉块倒入糊中裹匀，静置五分钟让糊吃进肉里。",
      "time_min": 6,
      "heat": "无火",
      "tip": "静置一会儿，炸时糊不易脱。",
      "visual_cue": "每块肉都裹上厚糊、不见裸肉"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到六成热，肉块分散下锅炸四分钟捞出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉块不要一次下太多，油温会掉。",
      "visual_cue": "外壳浅黄、肉块浮起"
    },
    {
      "n": 5,
      "text": "植物油升温到八成热，肉块与荸荠下锅复炸一分钟捞出沥油。",
      "time_min": 3,
      "heat": "大火",
      "tip": "复炸让外壳酥脆，凉了也不回软。",
      "visual_cue": "外壳深金、敲击有脆声"
    },
    {
      "n": 6,
      "text": "锅内留底油炒香大蒜末，下番茄酱、白糖、香醋与清水熬到起泡。",
      "time_min": 4,
      "heat": "中火",
      "tip": "糖醋汁熬到起大泡才够浓。",
      "visual_cue": "汁色红亮、泡密而大"
    },
    {
      "n": 7,
      "text": "下青椒块与炸好的肉块、荸荠，大火快速翻匀裹上糖醋汁出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "翻匀立刻出锅，久炒外壳就软了。",
      "visual_cue": "汁水裹满肉块、青椒翠绿"
    }
  ],
  "tips": [
    "用猪里脊肉更嫩，喜欢肥香可换梅花肉。",
    "荸荠最后下锅，能保住清脆的口感。",
    "糖醋汁先调好备用，下锅时动作才从容。"
  ],
  "common_mistakes": [
    "肉块裹糊后立刻下锅，糊浆脱落只剩光肉。",
    "油温过低就下肉，外壳吸满油发腻。",
    "糖醋汁在锅里久煮，甜酸味变寡淡还发苦。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "五花肉",
      "ratio": "500g 对 450g",
      "note": "更香但油腻，需多沥油。"
    },
    {
      "original": "荸荠",
      "substitute": "菠萝",
      "ratio": "100g 对 150g",
      "note": "果香更浓，酸甜味更清爽。"
    }
  ],
  "variations": [
    "把青椒换成彩椒与洋葱，颜色更热闹。",
    "糖醋汁里加一勺话梅汁，酸味更有层次。"
  ],
  "serving_suggestion": "现炸现淋汁，趁热上桌外壳最脆。",
  "storage": "冷藏可放一天，复热需用烤箱而非微波。",
