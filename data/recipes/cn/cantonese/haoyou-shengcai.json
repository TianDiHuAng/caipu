  "equipment": [
    "炒锅",
    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "生菜逐片掰开洗净，用清水浸泡 5 分钟后沥干，大叶从中间撕成两半。",
      "time_min": 6,
      "heat": "无火",
      "tip": "撕比切好，断面不规则更容易挂汁。",
      "visual_cue": "叶片完整无泥沙，沥到不滴水"
    },
    {
      "n": 2,
      "text": "锅中烧 1.5L 清水，加 2g 盐与 10ml 植物油，水大开后下生菜焯 20 秒捞出装盘。",
      "time_min": 3,
      "heat": "大火",
      "tip": "加油和盐能让菜叶保持翠绿，时间绝不能长。",
      "visual_cue": "生菜颜色转为油亮的深绿"
    },
    {
      "n": 3,
      "text": "小碗中把蚝油、生抽、白糖、玉米淀粉与 60ml 清水调匀成汁。",
      "time_min": 1,
      "heat": "无火",
      "tip": "先调匀再下锅，避免淀粉结块。",
      "visual_cue": "碗中汁液均匀无颗粒"
    },
    {
      "n": 4,
      "text": "炒锅下 10ml 植物油，小火煸香蒜末，倒入调好的汁煮到冒泡变稠。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末只煸到微黄，焦了会发苦。",
      "visual_cue": "酱汁透亮能挂住勺背"
    },
    {
      "n": 5,
      "text": "把烧热的蚝油汁均匀淋在生菜上，趁热食用。",
      "time_min": 1,
      "heat": "无火",
      "tip": "淋汁后不要久放，生菜会出水变软。",
      "visual_cue": "菜叶油亮、盘底汁水不多"
    }
  ],
  "tips": [
    "生菜焯水后立刻淋汁，摆盘前可先卷成小卷更整齐。",
    "蚝油本身咸，盐主要用在焯水，汁里不必再加。",
    "换成菜心、芥蓝同样适用，焯水时间加到 40 秒。"
  ],
  "common_mistakes": [
    "生菜焯水超过 1 分钟，叶片软塌发黄、失去脆感。",
    "蒜末用大火爆香，几秒就焦黑发苦。",
    "汁不勾芡直接淋，盘底积水、味道寡淡。"
  ],
  "substitutions": [
    {
      "original": "生菜",
      "substitute": "菜心",
      "ratio": "400g 生菜 ≈ 400g 菜心",
      "note": "菜心梗较硬，焯水延长到 40 秒。"
    },
    {
      "original": "蚝油",
      "substitute": "蒸鱼豉油",
      "ratio": "20g 蚝油 ≈ 20ml 蒸鱼豉油",
      "note": "风味更清，白糖可减到 1g。"
    }
  ],
  "variations": [
    "家庭简化版：生菜微波高火 1 分钟替代焯水，再淋热汁。",
    "豉油版：不加蚝油，用蒸鱼豉油加姜丝，做成豉油生菜。"
  ],
  "serving_suggestion": "作为一餐中的清口蔬菜，配烧腊、煲仔饭最合适。",
  "storage": "现做现吃，不建议存放；冷藏后再加热会出水变软。",
