  "steps": [
    {
      "n": 1,
      "text": "干香菇用温水泡发半小时，泡到菌盖完全舒展，泡菇水静置沉淀后留上层清液。",
      "time_min": 35,
      "heat": "无火",
      "tip": "泡菇水是天然鲜味来源，滤掉沉底的沙再用。",
      "visual_cue": "香菇柔软有弹，泡菇水呈浅褐色。"
    },
    {
      "n": 2,
      "text": "大米淘净后浸泡十五分钟，沥干备用，香菇挤干水分切成厚片。",
      "time_min": 18,
      "heat": "无火",
      "tip": "香菇挤干再切片，不然腌鸡时出水，味道被稀释。",
      "visual_cue": "香菇片厚薄均匀，米粒饱满。"
    },
    {
      "n": 3,
      "text": "鸡腿肉切三厘米块，加生抽、蚝油、白糖、料酒、白胡椒、姜丝和玉米淀粉抓匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "抓到手感发黏再加香油封住，腌料才挂得牢。",
      "visual_cue": "鸡块挂满酱色，表面泛光。"
    },
    {
      "n": 4,
      "text": "把香菇片拌进鸡块，淋香油再拌一次，腌十分钟让菌香与鸡肉融合。",
      "time_min": 12,
      "heat": "无火",
      "tip": "香油最后下封住水分，蒸出来鸡块才滑嫩。",
      "visual_cue": "香菇吸饱腌料，鸡块油润。"
    },
    {
      "n": 5,
      "text": "砂锅刷花生油，下米与清水大火煮到收水冒孔，转小火焗八分钟。",
      "time_min": 12,
      "heat": "大火",
      "tip": "饭煮到八成熟再铺鸡，鸡肉才不会蒸老。",
      "visual_cue": "饭面布满小孔，锅边冒热气。"
    },
    {
      "n": 6,
      "text": "把腌好的鸡块与香菇片平铺在饭面，盖盖小火焗十二分钟，关火闷三分钟。",
      "time_min": 16,
      "heat": "小火",
      "tip": "鸡块摊平不叠，蒸汽才能均匀透进去。",
      "visual_cue": "鸡皮鼓起发亮，盘底汁水清亮。"
    },
    {
      "n": 7,
      "text": "开盖淋上用生抽、老抽和泡菇水调成的豉油，撒小葱粒，连锅上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豉油要热着淋，冷汁浇上去饭会一凉一软。",
      "visual_cue": "豉油渗入饭粒，葱粒翠绿。"
    }
  ],
  "tips": [
    "香菇选厚肉的干北菇，香气比鲜菇浓得多。",
    "鸡腿肉带皮蒸，皮下的油渗进饭里最香。",
    "泡菇水别倒，兑进豉油里鲜味翻倍。"
  ],
  "common_mistakes": [
    "香菇不挤干就拌进鸡块，腌料被水稀释，蒸出来寡淡。",
    "鸡块叠得太厚，外层已经老了内层还夹生，蒸的时候要摊平。",
    "饭没到八成熟就铺鸡，鸡肉蒸过头，饭还夹生。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "1:1.1",
      "note": "鸡翅对半剁开，焗十分钟即可，胶质多更滑。"
    },
    {
      "original": "香菇",
      "substitute": "干贝",
      "ratio": "50克:25克",
      "note": "换成干贝需提前蒸软撕丝，鲜味更清，成本较高。"
    }
  ],
  "variations": [
    "传统做法用瓦钵隔水蒸，鸡汁与菇汁都留在钵底，拌饭格外香。",
    "有的店家加几片腊肠同蒸，油香更足。"
  ],
  "serving_suggestion": "连锅上桌淋豉油拌开，配一碟焯青菜；鸡汁拌饭是精华。",
  "storage": "冷藏可存两日；复热盖盖小火焖六分钟，中途淋一勺清水。",
