  "steps": [
    {
      "n": 1,
      "text": "排骨剁成三厘米长的小块，放入清水浸泡半小时去血水。",
      "time_min": 30,
      "heat": "无火",
      "tip": "中途换两次水，血水去得更干净。",
      "visual_cue": "排骨发白、水色由红转清"
    },
    {
      "n": 2,
      "text": "排骨捞出沥干，用厨房纸反复按压吸去表面水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "排骨表面干爽，腌料才挂得住。",
      "visual_cue": "排骨表面干爽、不见水光"
    },
    {
      "n": 3,
      "text": "豆豉剁碎，大蒜与生姜切末，小米辣切成薄圈备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆豉剁碎更易出味。",
      "visual_cue": "豆豉成粗粒、蒜末均匀"
    },
    {
      "n": 4,
      "text": "排骨加生抽、蚝油、料酒、白糖、盐与白胡椒抓匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用手抓拌比筷子更入味。",
      "visual_cue": "排骨裹匀酱色、碗底见汁"
    },
    {
      "n": 5,
      "text": "加入豆豉碎、蒜末、姜末与植物油继续抓拌到发黏。",
      "time_min": 3,
      "heat": "无火",
      "tip": "最后加油能封住肉汁。",
      "visual_cue": "排骨表面油亮、手感黏滑"
    },
    {
      "n": 6,
      "text": "撒入玉米淀粉抓匀，静置腌制二十分钟入味。",
      "time_min": 20,
      "heat": "无火",
      "tip": "淀粉要最后放，才形成薄浆。",
      "visual_cue": "排骨裹上薄浆、不结干粉"
    },
    {
      "n": 7,
      "text": "排骨平铺在深盘中，尽量不要叠得太厚，撒上小米辣圈。",
      "time_min": 3,
      "heat": "无火",
      "tip": "平铺受热均匀，熟得更快。",
      "visual_cue": "排骨铺满盘底、单层摆放"
    },
    {
      "n": 8,
      "text": "蒸锅加清水大火烧开上汽，放入排骨盘盖严锅盖。",
      "time_min": 3,
      "heat": "大火",
      "tip": "一定要上汽后再放盘。",
      "visual_cue": "锅边冒出足量蒸汽"
    },
    {
      "n": 9,
      "text": "保持大火蒸十二分钟，用筷子戳排骨最厚处看是否熟透。",
      "time_min": 12,
      "heat": "大火",
      "tip": "蒸到骨肉易分离才算熟。",
      "visual_cue": "排骨颜色转浅、盘底出清汁"
    },
    {
      "n": 10,
      "text": "取出后淋上香油，撒少许葱花，趁热端上桌食用。",
      "time_min": 1,
      "heat": "无火",
      "tip": "趁热吃，凉了肉质会发紧。",
      "visual_cue": "排骨油亮、香气扑鼻"
    }
  ],
  "tips": [
    "排骨选肋排中段，肉厚骨小最好吃。",
    "豆豉本身有咸味，生抽要相应减量。",
    "蒸盘盖一层保鲜膜再蒸，水汽不会滴进去。"
  ],
  "common_mistakes": [
    "排骨没泡去血水就腌，蒸出来腥味重。",
    "淀粉放太早，蒸后盘底结成厚糊。",
    "排骨堆得太厚，中间那层还夹生。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "猪软骨",
      "ratio": "500g 对 500g",
      "note": "口感更脆，蒸制时间延长三分钟。"
    },
    {
      "original": "豆豉",
      "substitute": "豆豉酱",
      "ratio": "15g 对 20g",
      "note": "咸度更高，盐可省去。"
    }
  ],
  "variations": [
    "加一勺柱候酱同蒸，酱香会更加浓郁。",
    "把排骨换成凤爪同法蒸制，就是茶楼豉汁凤爪。"
  ],
  "serving_suggestion": "连盘带汁上桌，汁水拌饭很下饭。",
  "storage": "冷藏可放两天，复热需重新蒸五分钟。",
