  "equipment": [
    "蒸锅",
    "浅盘",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄鳝段用盐抓洗两遍去掉表面黏液，再用清水冲净沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "盐抓洗能去黏液和土腥味，冲不干净会有滑腻感。",
      "visual_cue": "鳝段表面清爽不黏手"
    },
    {
      "n": 2,
      "text": "豆豉剁碎，蒜剁成茸，姜切细丝，红辣椒切薄圈备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆豉剁碎香气才出得来，整粒蒸不透。",
      "visual_cue": "豆豉碎粒均匀、蒜茸细腻"
    },
    {
      "n": 3,
      "text": "鳝段加料酒、白糖、淀粉抓匀，静置十分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "淀粉薄薄一层就够，多了蒸后糊成一片。",
      "visual_cue": "鳝段表面挂一层薄白浆、不滴落"
    },
    {
      "n": 4,
      "text": "炒锅放一半植物油，小火炒香蒜茸与豆豉碎，盛出铺在鳝段上。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜茸炒到微黄就停，炒焦会带苦味。",
      "visual_cue": "蒜香扑鼻、蒜茸微黄"
    },
    {
      "n": 5,
      "text": "蒸锅上汽后放入鳝段，大火蒸八分钟，关火再焖一分钟。",
      "time_min": 10,
      "heat": "大火",
      "tip": "上汽后再放盘，八分钟足够，蒸久肉散。",
      "visual_cue": "鳝肉卷起、盘内汁水清亮"
    },
    {
      "n": 6,
      "text": "撒姜丝葱丝与辣椒圈，淋蒸鱼豉油，再浇上烧热的植物油激香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油要烧到冒烟再浇，葱姜香气才被逼出来。",
      "visual_cue": "葱丝微卷、油花四溅"
    }
  ],
  "tips": [
    "黄鳝要选拇指粗的活鳝，肉厚才经得起蒸；死鳝不可食用。",
    "豆豉选阳江豆豉，咸香足，盐就要相应减少。",
    "蒸盘浅一些受热更匀，鳝段别叠压成两层。"
  ],
  "common_mistakes": [
    "鳝段没抓洗黏液就上锅，成品带土腥味。",
    "蒸过头，鳝肉离骨发柴，鲜味全无。",
    "豆豉蒜茸直接生铺，香气没激发出来。"
  ],
  "substitutions": [
    {
      "original": "黄鳝",
      "substitute": "鳗鱼",
      "ratio": "500g 对 500g",
      "note": "鳗鱼肉更肥，蒸制时间加两分钟。"
    },
    {
      "original": "豆豉",
      "substitute": "豆豉酱",
      "ratio": "20g 对 25g",
      "note": "豆豉酱偏咸，盐可省略。"
    }
  ],
  "variations": [
    "底下垫一层粉丝同蒸，吸满豉汁更下饭。",
    "改用砂锅加姜葱焖，做成豉汁鳝煲。"
  ],
  "serving_suggestion": "原盘上桌，配白饭趁热吃，酱汁拌饭一绝。",
  "storage": "当天食用最佳，冷藏不超过一天，复蒸五分钟。",
