  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉修去多余筋膜和血块，用盐抹匀表面，静置十分钟让底味进去。",
      "time_min": 12,
      "heat": "无火",
      "tip": "盐别抹太多，后面蘸料也咸，容易过味。",
      "visual_cue": "鸡皮泛白，肉质紧实。"
    },
    {
      "n": 2,
      "text": "汤锅放清水、姜片、大葱段和料酒烧开，转小火把鸡腿肉带皮朝下浸入。",
      "time_min": 8,
      "heat": "小火",
      "tip": "水只冒小泡，滚大了鸡皮破，肉也发柴。",
      "visual_cue": "水面微沸，鸡皮紧绷。"
    },
    {
      "n": 3,
      "text": "小火浸煮十五分钟，捞出放进冰水浸三分钟，让鸡皮收紧变爽脆。",
      "time_min": 18,
      "heat": "小火",
      "tip": "冰镇让皮肉之间凝出一层薄胶，口感更滑。",
      "visual_cue": "鸡皮透亮紧实，按压回弹快。"
    },
    {
      "n": 4,
      "text": "沙姜剁成细蓉，加盐和生抽拌匀，植物油烧到冒烟浇入激香，淋香油调匀。",
      "time_min": 5,
      "heat": "大火",
      "tip": "沙姜蓉要剁细，颗粒太粗挂不住皮，香味也出不来。",
      "visual_cue": "沙姜蓉浮在油面，辛香浓烈。"
    },
    {
      "n": 5,
      "text": "鸡腿肉斩成两指宽的条块，皮朝上摆盘，把沙姜油均匀淋在鸡皮上。",
      "time_min": 5,
      "heat": "无火",
      "tip": "淋在皮上才香，浇在肉面香味进不去。",
      "visual_cue": "鸡皮油亮，沙姜蓉均匀铺开。"
    },
    {
      "n": 6,
      "text": "静置两分钟让沙姜油渗进鸡皮，趁温热上桌，剩下的沙姜汁可蘸食。",
      "time_min": 2,
      "heat": "无火",
      "tip": "静置一会儿味道更融，急着吃只有表面香。",
      "visual_cue": "香气上浮，盘底留有姜油。"
    }
  ],
  "tips": [
    "沙姜要选表皮灰褐、切面白中带紫的，香气最冲。",
    "鸡腿肉比整鸡好操作，皮厚肉嫩，浸十五分钟刚好熟。",
    "沙姜油可多做一点，拌面拌饭都香。"
  ],
  "common_mistakes": [
    "沙姜用刀拍碎就下锅，颗粒太粗，香气出不来还硌牙。",
    "鸡腿浸过头，肉纤维散开，切块一夹就碎。",
    "油温不够就淋沙姜，只有生油味，辛香全无。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "整鸡",
      "ratio": "1:1.3",
      "note": "用整鸡需浸二十分钟，斩件更费工，但皮更完整好看。"
    },
    {
      "original": "沙姜",
      "substitute": "姜",
      "ratio": "1:1.4",
      "note": "普通姜辛味偏冲、香气不足，用量加四成并加少许白胡椒。"
    }
  ],
  "variations": [
    "湛江做法把沙姜蓉塞进鸡皮下再浸，香气更深入。",
    "有的店家加一勺蚝油进沙姜汁，咸鲜更厚，配饭更下口。"
  ],
  "serving_suggestion": "斩件淋沙姜油，配白饭与一碟焯青菜；沙姜汁拌饭格外香。",
  "storage": "冷藏可存两日；复热隔水蒸八分钟，沙姜油另烧热再淋。",
