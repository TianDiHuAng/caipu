  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切两厘米见方的滚刀块，加盐与生抽抓匀，静置十五分钟入味。",
      "time_min": 17,
      "heat": "无火",
      "tip": "滚刀块受热面积大，炸出来外脆内嫩，比切方块更好吃。",
      "visual_cue": "肉块表面均匀裹上浅褐色汁水"
    },
    {
      "n": 2,
      "text": "肉块里加蛋液抓匀，再分次撒淀粉拌到每块都挂上干粉，抖动去掉多余粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "粉要挂薄而匀，太厚炸完像面团，太薄又不成脆壳。",
      "visual_cue": "肉块表面干爽不粘手，粉层薄白"
    },
    {
      "n": 3,
      "text": "小碗里放番茄酱、白醋、白糖、生抽与清水，搅匀成酸甜汁，另取淀粉加水调成芡汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "汁的比例按酸甜一比一最稳，尝起来应明显偏酸。",
      "visual_cue": "酸甜汁橙红透亮，无糖粒沉淀"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到一百七十度，逐块下肉块，中火炸三分钟到浅金色捞出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温不够粉会脱，肉块下锅要一块块放，避免粘成一坨。",
      "visual_cue": "肉块浮起，表面浅金色"
    },
    {
      "n": 5,
      "text": "升高油温复炸四十秒，其间用勺把热油反复淋在肉块上，炸到外壳金黄发硬捞出沥油。",
      "time_min": 3,
      "heat": "大火",
      "tip": "复炸是脆壳的关键，油温要高，时间要短否则肉会柴。",
      "visual_cue": "外壳金黄硬挺，敲起来有声"
    },
    {
      "n": 6,
      "text": "锅留两勺油，下洋葱与青椒块大火翻炒一分钟，边缘略微透亮即可。",
      "time_min": 3,
      "heat": "大火",
      "tip": "配菜只炒断生，久炒出水会把脆壳泡软。",
      "visual_cue": "青椒颜色鲜绿，洋葱边缘透明"
    },
    {
      "n": 7,
      "text": "倒入酸甜汁煮沸，淋入芡汁推匀，汁转浓稠挂勺时立刻关小火。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芡汁边倒边搅，一稠就停，太稠会把肉块裹成糊。",
      "visual_cue": "酱汁能挂住勺背，缓慢滴落"
    },
    {
      "n": 8,
      "text": "把炸好的肉块与配菜倒进锅里，大火快速翻匀让每块都裹上酱汁，立刻装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "翻拌不超过二十秒，久炒脆壳就软了。",
      "visual_cue": "肉块通体橙红油亮，盘底无积汁"
    }
  ],
  "tips": [
    "用里脊或梅花肉都行，前者嫩后者香，肥瘦各半最像老字号的味道。",
    "酸甜汁可以提前一晚调好冷藏，开火前取出，出菜更快。",
    "想吃更脆可以省略第七步的芡汁，直接让酱汁收浓裹肉。",
    "配菠萝块一起炒是老派做法，甜味更足。"
  ],
  "common_mistakes": [
    "肉块裹粉太厚或太湿，炸出来外皮硬如石头，里面还没熟。",
    "酱汁熬得太稠，倒进肉块后立刻凝成团，翻不开。",
    "配菜与肉一起下锅久炒，青椒软塌，脆壳全毁。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "梅花肉",
      "ratio": "450克:450克",
      "note": "带一点脂肪，炸后更香不干。"
    },
    {
      "original": "白醋",
      "substitute": "米醋",
      "ratio": "45毫升:50毫升",
      "note": "酸味更柔，糖量可减五克。"
    }
  ],
  "variations": [
    "用山楂或话梅水代替部分白醋，酸味更立体。",
    "把肉换成虾仁，做成咕噜虾球，炸制时间减到两分钟。"
  ],
  "serving_suggestion": "趁热配白饭，旁边放一小碟甜辣酱，或配一杯冰镇啤酒。",
  "storage": "现炸现吃最好，冷藏后脆壳会软；复热用两百度烤箱烤六分钟可部分恢复脆度。",
