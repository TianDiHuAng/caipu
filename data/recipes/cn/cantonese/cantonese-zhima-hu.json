          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "细筛",
    "炒锅",
    "料理机",
    "汤锅",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黑芝麻倒进细筛，用清水淘洗两遍，沥到不滴水再摊开晾。",
      "time_min": 5,
      "heat": "无火",
      "tip": "淘洗时轻轻搅动，沙粒会沉底随水冲走。",
      "visual_cue": "芝麻颗粒松散，握一把不结团"
    },
    {
      "n": 2,
      "text": "大米淘净后加清水泡二十分钟，泡到米粒用手指一捏就碎。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡透的米打浆更细，成品才不会发涩有渣。",
      "visual_cue": "米粒发白发胀，一捏即碎"
    },
    {
      "n": 3,
      "text": "干锅小火烧热，倒进黑芝麻不停翻炒到密集噼啪作响。",
      "time_min": 5,
      "heat": "小火",
      "tip": "芝麻极易糊，听到密集响声就要立刻离火。",
      "visual_cue": "芝麻鼓起发亮，香味直冒"
    },
    {
      "n": 4,
      "text": "炒好的黑芝麻和泡好的大米放进料理机，加清水打成细腻米浆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "分两次打，米浆才够细，不留粗颗粒。",
      "visual_cue": "米浆乌黑顺滑无颗粒"
    },
    {
      "n": 5,
      "text": "米浆过筛倒回汤锅，小火边煮边用木勺搅十分钟至浓稠。",
      "time_min": 10,
      "heat": "小火",
      "tip": "全程小火勤搅，糊底只需要几秒钟。",
      "visual_cue": "米糊能挂住勺背缓慢滴落"
    },
    {
      "n": 6,
      "text": "加冰糖搅到完全化开，再煮两分钟关火盛碗。",
      "time_min": 3,
      "heat": "小火",
      "tip": "冰糖最后放，煮久了糊会返稀变薄。",
      "visual_cue": "甜香浓稠，表面冒小泡"
    }
  ],
  "tips": [
    "黑芝麻一定要小火炒香，生芝麻打糊会有涩味。",
    "米浆过筛一遍，成品才细腻顺滑不刮口。",
    "煮糊时勺子要贴锅底搅，防糊底发苦。"
  ],
  "common_mistakes": [
    "芝麻大火猛炒，几秒就焦黑发苦整锅报废。",
    "米浆直接大火煮，锅底立刻结块搅不动。",
    "冰糖一开始就下锅，煮到后面糊会返稀。"
  ],
  "substitutions": [
    {
      "original": "黑芝麻",
      "substitute": "白芝麻",
      "ratio": "120 克:120 克",
      "note": "颜色变浅，香气更清淡，可加十克黑芝麻调色。"
    },
    {
      "original": "冰糖",
      "substitute": "红糖",
      "ratio": "70 克:60 克",
      "note": "风味更浓，甜度略高需减量。"
    }
  ],
  "variations": [
    "加一勺花生酱同打，糊体更厚重香浓。",
    "撒少许炒香的白芝麻在表面，口感更有层次。"
  ],
  "serving_suggestion": "趁热吃最香滑，配一根油条或咸煎饼正好。",
  "storage": "冷藏可放两天，复热时加少量清水小火搅匀。",
