        }
      ]
    }
  ],
  "equipment": [
    "汤煲",
    "刀",
    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "木耳用清水泡三十分钟泡到完全舒展，剪掉根部硬结再撕成小朵。",
      "time_min": 15,
      "heat": "无火",
      "tip": "泡木耳别超过两小时，久泡容易滋生细菌。",
      "visual_cue": "木耳完全展开，朵形软亮无硬芯"
    },
    {
      "n": 2,
      "text": "猪骨冷水下锅焯三分钟，撇净浮沫后捞出用清水冲干净备用。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅血水才出得来，热水下锅汤会腥。",
      "visual_cue": "骨块无血沫，汤面浮沫完全撇净"
    },
    {
      "n": 3,
      "text": "白萝卜削皮切成三厘米见方的滚刀块，边缘切面要平整。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切块别太小，煲一小时以上才不至于全化掉。",
      "visual_cue": "萝卜块大小均匀，切面白净"
    },
    {
      "n": 4,
      "text": "汤煲放猪骨、姜与蜜枣，加清水大火烧开后转小火煲四十五分钟。",
      "time_min": 45,
      "heat": "小火",
      "tip": "小火慢煲汤色才清，大滚会把骨渣煮散。",
      "visual_cue": "汤色浅白清亮，猪骨开始脱肉"
    },
    {
      "n": 5,
      "text": "下白萝卜与木耳再煲二十分钟，萝卜变透明、木耳软滑。",
      "time_min": 20,
      "heat": "小火",
      "tip": "木耳后放能保持一点脆感，早放会煮成软烂。",
      "visual_cue": "萝卜半透明，木耳浮沉于汤中"
    },
    {
      "n": 6,
      "text": "关火前加盐调味，撇去表面浮油，连汤带料一起盛出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐最后放，早放会让萝卜出水变软塌。",
      "visual_cue": "汤面清亮微油，萝卜与木耳层次分明"
    }
  ],
  "tips": [
    "木耳泡发后一定要剪掉根部，否则汤里会有细沙。",
    "白萝卜换成质地更软的根茎菜也行，汤体更绵不腻。",
    "煲的过程中撇两次浮沫，汤会更清爽。",
    "盐关火前放，汤味更鲜、肉也不会发柴。"
  ],
  "common_mistakes": [
    "木耳泡了一整夜才拿来用，口感发黏且有明显的安全风险。",
    "猪骨热水下锅，血水封在骨头里，汤腥得几乎难以下口。",
    "全程大火猛滚，汤色浑白还带一股说不清的焦味。",
    "白萝卜一开始就下锅，煲到最后全化成泥，捞不起来。"
  ],
  "substitutions": [
    {
      "original": "猪骨",
      "substitute": "鸡架",
      "ratio": "500克:600克",
      "note": "汤更清，煲的时间缩短十分钟。"
    },
    {
      "original": "白萝卜",
      "substitute": "冬瓜",
      "ratio": "300克:400克",
      "note": "更清润，最后十五分钟下即可。"
    }
  ],
  "variations": [
    "多放两颗蜜枣同煲，汤体更甘润，喝起来不寡。",
    "姜片多放两片去腥，香气更接近老式广府的煲汤路数。",
    "去掉猪骨就是素汤版本，汤体更清淡，适合配油腻的菜。"
  ],
  "serving_suggestion": "饭前一人一碗，萝卜吸足了骨汤，木耳滑脆，配白饭或蒸鱼都合适。",
  "storage": "冷藏可放两天，复热须彻底煮沸；木耳隔夜易变质，建议当天喝完。",
