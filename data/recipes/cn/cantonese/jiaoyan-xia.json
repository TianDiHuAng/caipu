  "equipment": [
    "炒锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲜虾剪去虾枪虾须，用剪刀在背部剪开一道口子挑去黑线。",
      "time_min": 10,
      "heat": "无火",
      "tip": "开背更入味，也方便挑线。",
      "visual_cue": "虾身完整、背部裂口整齐"
    },
    {
      "n": 2,
      "text": "处理好的虾用清水冲净，厨房纸吸干表面全部水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水分不干，炸时容易脱浆溅油。",
      "visual_cue": "虾壳干爽、不见水光"
    },
    {
      "n": 3,
      "text": "虾加盐、白胡椒与料酒抓匀，腌八分钟入味去腥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腌得短一些，虾肉才不会出水。",
      "visual_cue": "虾身微黏、带酒香"
    },
    {
      "n": 4,
      "text": "蛋清打散倒入虾中抓匀，再撒玉米淀粉让每只虾裹上薄粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉别裹太厚，薄薄一层更脆。",
      "visual_cue": "虾身均匀泛白、互不粘连"
    },
    {
      "n": 5,
      "text": "锅中倒植物油烧到七成热，虾逐只下锅中火炸两分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "沿锅边轻放，防止热油溅手。",
      "visual_cue": "虾壳转红、外壳定型"
    },
    {
      "n": 6,
      "text": "捞出沥油后把油温升到八成热，回锅复炸二十秒更酥。",
      "time_min": 1,
      "heat": "中大火",
      "tip": "复炸能逼出壳缝里的油。",
      "visual_cue": "虾壳通红干爽、敲之脆响"
    },
    {
      "n": 7,
      "text": "另起锅留少许底油，小火煸香蒜末与小米辣圈。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末炒到微黄香气最足。",
      "visual_cue": "蒜末金黄、辣味窜出"
    },
    {
      "n": 8,
      "text": "倒入炸好的虾转大火翻炒，撒盐与白胡椒快速翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "翻炒要快，虾肉久炒会老。",
      "visual_cue": "虾身裹满蒜粒、锅底干爽"
    },
    {
      "n": 9,
      "text": "撒一把葱花翻两下立刻出锅，趁热装盘上桌。",
      "time_min": 1,
      "heat": "大火",
      "tip": "葱花最后放，翠绿香气才在。",
      "visual_cue": "葱花翠绿、虾壳油亮"
    }
  ],
  "tips": [
    "选壳薄肉厚的基围虾，炸出来壳都能吃。",
    "复炸是外壳酥脆的关键，别省略。",
    "喜欢更麻的口感，可加少许花椒粉同炒。"
  ],
  "common_mistakes": [
    "虾没擦干就裹粉，炸的时候粉层大量脱落。",
    "油温太低就下虾，虾肉发柴还吸满油。",
    "蒜末大火猛炒，一瞬间糊成黑渣发苦。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "鱿鱼",
      "ratio": "500g 对 400g",
      "note": "切圈后炸制时间减半。"
    },
    {
      "original": "小米辣",
      "substitute": "干辣椒",
      "ratio": "12g 对 6g",
      "note": "辣味更干香，需先炒香。"
    }
  ],
  "variations": [
    "出锅前撒一把炸蒜酥，香气更浓。",
    "换成大虾开边做法，摆盘更大气。"
  ],
  "serving_suggestion": "趁热吃壳脆肉甜，配啤酒或汽水都很搭。",
  "storage": "当天吃完，冷藏后虾壳会回软，口感大打折扣。",
