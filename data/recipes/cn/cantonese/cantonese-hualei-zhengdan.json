          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 200,
          "unit": "ml",
          "note": "调蛋液与养蛤蜊",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "出锅淋",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 5,
          "unit": "ml",
          "note": "提香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "去腥",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "深盘",
    "滤网",
    "小碗",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛤蜊放淡盐水里养两小时吐净泥沙，中途换一次水并搓洗外壳。",
      "time_min": 10,
      "heat": "无火",
      "tip": "养蛤蜊的水里滴两滴植物油，吐沙会快很多。",
      "visual_cue": "盆底有细沙沉落，蛤蜊壳面干净"
    },
    {
      "n": 2,
      "text": "蛤蜊冷水下锅煮到壳刚张开就捞出，煮蛤蜊的汤静置后取上层澄清部分放温。",
      "time_min": 5,
      "heat": "中火",
      "tip": "壳一张就捞，煮久了蛤肉会缩成一小团发硬。",
      "visual_cue": "壳口张开，蛤肉饱满不缩水"
    },
    {
      "n": 3,
      "text": "鸡蛋打散后加清水和盐搅匀，用滤网过两遍去掉浮沫与系带。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蛋液与清水比例约一比一点五，过筛是蛋面光滑的关键。",
      "visual_cue": "蛋液澄净无泡，颜色均匀"
    },
    {
      "n": 4,
      "text": "蛤蜊摆进深盘，倒入蛋液到八分满，盖上保鲜膜并用牙签扎几个小孔。",
      "time_min": 3,
      "heat": "无火",
      "tip": "保鲜膜挡住水汽，蛋面才不会蒸出蜂窝孔。",
      "visual_cue": "蛤蜊半露在蛋液外，膜面平整"
    },
    {
      "n": 5,
      "text": "蒸锅水开后放入深盘，转中小火蒸十分钟，关火再焖两分钟取出。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "火太大会让蛋液沸腾起孔，中小火才嫩滑细腻。",
      "visual_cue": "蛋面平滑如镜，轻晃有弹性"
    },
    {
      "n": 6,
      "text": "揭掉保鲜膜撒葱花，淋生抽与香油，撒白胡椒即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酱油沿盘边淋下去，蛋面能保持完整好看。",
      "visual_cue": "蛋羹表面光洁，葱花翠绿点缀"
    }
  ],
  "tips": [
    "蛤蜊本身有咸鲜味，盐要少放，出锅前先尝一口再调。",
    "蒸的时候盘子上倒扣一个盘子也行，效果和保鲜膜一样。",
    "蛋液里加一勺煮蛤蜊的汤水，鲜味会翻倍提升。",
    "蒸锅水必须先烧开再放盘子，冷水上锅蛋容易变老。"
  ],
  "common_mistakes": [
    "蛤蜊没吐沙就下锅，吃一口满嘴都是沙粒。",
    "蛋液没有过筛，蒸出来表面浮着一层白沫。",
    "全程大火猛蒸，蛋面起满蜂窝孔像海绵一样。",
    "蛤蜊壳紧闭不开还继续煮，肉老得完全嚼不动。"
  ],
  "substitutions": [
    {
      "original": "蛤蜊",
      "substitute": "花蛤",
      "ratio": "300克:300克",
      "note": "同样需要吐沙，个头小一点更容易熟。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "3个:3个",
      "note": "蛋味更浓，蒸的时间多两分钟。"
    }
  ],
  "variations": [
    "蛋黄多留一个，颜色更金黄，蛋香也更浓一些。",
    "把生抽换成味道更柔和的淡酱油，咸鲜不抢蛤蜊的鲜。",
    "撒一点白胡椒在表面，去腥的同时提香。"
  ],
  "serving_suggestion": "连盘上桌，撒一把葱花，配白饭或直接当汤羹喝，趁热吃蛋最嫩滑。",
  "storage": "冷藏可放一天，复蒸五分钟；蛤蜊隔夜容易失鲜，建议当餐吃完。",
