  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 3,
          "unit": "piece",
          "note": "打散过筛",
          "optional": false
        },
        {
          "name": "蛤蜊",
          "name_en": "clam",
          "amount": 300,
          "unit": "g",
