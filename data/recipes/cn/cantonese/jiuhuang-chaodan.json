      ]
    }
  ],
  "equipment": [
    "炒锅",
    "打蛋碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "韭黄洗净沥干，切成五厘米长的段，梗与叶分开放。",
      "time_min": 6,
      "heat": "无火",
      "tip": "梗叶分开下锅，熟度才一致。",
      "visual_cue": "段落整齐、水分沥干"
    },
    {
      "n": 2,
      "text": "鸡蛋磕入碗中，加盐、白胡椒与料酒打散到起细泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打散到起泡，炒出来才蓬松。",
      "visual_cue": "蛋液均匀、表面有细密泡沫"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，油热后倒入蛋液转中火推炒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油要够热，蛋才蓬松不粘锅。",
      "visual_cue": "蛋液边缘凝固、鼓起大泡"
    },
    {
      "n": 4,
      "text": "蛋液七成凝固时用锅铲划成大块，盛出装盘待用。",
      "time_min": 1,
      "heat": "中火",
      "tip": "半熟盛出，回锅后再熟一遍。",
      "visual_cue": "蛋块嫩滑、中心略湿润"
    },
    {
      "n": 5,
      "text": "锅中补少许油，下韭黄梗大火翻炒三十秒至微微变软。",
      "time_min": 1,
      "heat": "大火",
      "tip": "先炒梗，梗不易熟。",
      "visual_cue": "梗部转深绿、仍带脆度"
    },
    {
      "n": 6,
      "text": "下韭黄叶继续大火快炒二十秒，撒少许盐翻匀。",
      "time_min": 1,
      "heat": "大火",
      "tip": "叶一变色就够，久炒出水发黄。",
      "visual_cue": "叶片变软塌、颜色翠黄"
    },
    {
      "n": 7,
      "text": "倒回蛋块大火翻匀，淋香油撒葱花后立刻出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "翻两下就停，蛋块才不老。",
      "visual_cue": "蛋块与韭黄裹匀、盘底干爽"
    }
  ],
  "tips": [
    "韭黄选根部粗壮发白的，香味更足。",
    "蛋液里加一勺清水，炒出来更嫩。",
    "全程大火快炒，韭黄才不出水，保持脆嫩。"
  ],
  "common_mistakes": [
    "韭黄炒太久，出水变软失去脆香。",
    "蛋液没打散就下锅，蛋白蛋黄分层。",
    "火太小慢慢炒蛋，蛋块又老又硬。"
  ],
  "substitutions": [
    {
      "original": "韭黄",
      "substitute": "韭菜",
      "ratio": "200g 对 200g",
      "note": "味道更冲，炒制时间减十秒。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "150g 对 150g",
      "note": "腥味稍重，可多加料酒。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同炒，口感更丰富。",
    "打蛋时加少许虾皮同炒，鲜味更足，咸度要减少。"
  ],
  "serving_suggestion": "热锅出锅就吃，配白粥或白饭都很家常。",
  "storage": "当天吃完，隔夜韭黄会发黄出水。",
