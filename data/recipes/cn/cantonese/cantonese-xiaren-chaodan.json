  "steps": [
    {
      "n": 1,
      "text": "虾仁从背部划开挑出肠线，冲洗干净后用厨房纸吸干，加生抽与白胡椒粉抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "吸干水分再腌，虾仁下锅才弹，不会出水把蛋炒老。",
      "visual_cue": "虾仁干爽不滴水，调料裹得均匀"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进碗里，加三克盐打散，打到蛋白蛋黄完全融合、表面有细小气泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "多打几下让蛋液里带气泡，炒出来才松软。",
      "visual_cue": "蛋液均匀，边缘有细泡"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟，倒一半植物油滑锅，油温五成热时下虾仁。",
      "time_min": 2,
      "heat": "大火",
      "tip": "热锅冷油是关键，虾仁不粘锅也不出水。",
      "visual_cue": "油面微微起纹，锅壁油亮"
    },
    {
      "n": 4,
      "text": "虾仁大火快炒一分半，炒到卷曲变红立刻盛出，虾油留在锅里。",
      "time_min": 2,
      "heat": "大火",
      "tip": "一变色就捞，回锅还要再受热，炒久了肉质发硬。",
      "visual_cue": "虾仁卷成弯月，颜色红亮"
    },
    {
      "n": 5,
      "text": "锅里补剩下的植物油，倒入蛋液，等三秒让底部略凝再开始推动。",
      "time_min": 2,
      "heat": "中火",
      "tip": "别一倒就搅，先让蛋液定一层底，出来才有层次感。",
      "visual_cue": "锅底结出一层均匀的厚蛋皮"
    },
    {
      "n": 6,
      "text": "用木铲从锅边往中间轻推，形成大片柔软的蛋块，仍带湿润时下虾仁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋要推到七成熟就下虾仁，靠余温把最后一点蛋液焖熟。",
      "visual_cue": "蛋块蓬松湿润，没有干硬焦边"
    },
    {
      "n": 7,
      "text": "加入姜丝与葱花，颠锅两下让虾仁与蛋块混匀，撒剩余盐调味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "葱花最后放才香，早了下锅会炒黄发苦，香味也散得快。",
      "visual_cue": "蛋块金黄，虾仁均匀分布"
    },
    {
      "n": 8,
      "text": "关火淋香油，盛盘趁热上桌，配一碗白饭最好。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火后再淋香油，香气不挥发，也不会受热变味。",
      "visual_cue": "表面油润发亮，香气清鲜"
    }
  ],
  "tips": [
    "虾仁提前腌过再炒，比直接下锅鲜得多，也不易缩水。",
    "蛋液里加一勺清水或牛奶，炒出来更嫩。",
    "全程不要放太多调料，这道菜吃的是虾和蛋的本味。",
    "用小葱的绿色部分切葱花，香气更清，也别炒太久。"
  ],
  "common_mistakes": [
    "虾仁不吸干就下锅，锅里出水，虾仁缩成小球，口感发韧。",
    "蛋液一下锅就猛搅，炒成碎粒状，完全没有块状的嫩滑。",
    "火太小炒蛋，水分慢慢蒸干，蛋块又老又干。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鲜贝",
      "ratio": "240克:240克",
      "note": "炒制时间缩短半分钟，其余相同。"
    },
    {
      "original": "小葱",
      "substitute": "韭菜",
      "ratio": "15克:30克",
      "note": "香气更冲，需与蛋液同时下锅略炒。"
    }
  ],
  "variations": [
    "加一小勺蚝油拌进蛋液，鲜味更浓，是茶餐厅的版本。",
    "铺在刚煮好的白饭上做成虾仁滑蛋饭，淋一勺生抽。"
  ],
  "serving_suggestion": "两人份主菜，配白饭与一碟清炒时蔬，是很标准的粤式家常一餐。",
  "storage": "建议现做现吃，冷藏后蛋会变硬出水，复热口感明显下降。",
