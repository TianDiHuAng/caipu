  "equipment": [
    "汤锅",
    "滤网",
    "厨房剪"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白菜干用温水泡 30 分钟至叶片回软，换两次水洗净沙粒，剪成 5cm 长段。",
      "time_min": 32,
      "heat": "无火",
      "tip": "菜干缝隙藏沙，洗到水清为止。",
      "visual_cue": "叶片舒展、捏之柔软无硬芯"
    },
    {
      "n": 2,
      "text": "猪筒骨冷水下锅，加姜片、大葱段与 20ml 料酒，中火煮 8 分钟撇净浮沫。",
      "time_min": 10,
      "heat": "中火",
      "tip": "冷水下锅血沫才出得干净。",
      "visual_cue": "水面浮起灰白沫、骨段表面变白"
    },
    {
      "n": 3,
      "text": "捞出猪筒骨用温水冲净表面血沫，逐块检查碎骨渣后沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冲洗用温水，冷水会让骨肉骤缩发柴。",
      "visual_cue": "骨段清爽无沫、汤不发浑"
    },
    {
      "n": 4,
      "text": "汤锅加 2500ml 清水，放入猪筒骨、白菜干、蜜枣、南杏与北杏，大火烧开。",
      "time_min": 10,
      "heat": "大火",
      "tip": "水量一次加足，中途补水会冲淡汤味。",
      "visual_cue": "汤面翻滚、菜干沉底"
    },
    {
      "n": 5,
      "text": "转小火加盖慢煲 100 分钟，中途撇去表面浮油两次，保持汤面小滚不沸。",
      "time_min": 102,
      "heat": "小火",
      "tip": "小火才能煲出清甜不浑的汤色。",
      "visual_cue": "汤色转浅褐、菜干软烂"
    },
    {
      "n": 6,
      "text": "开盖加 5g 盐与 1g 白胡椒，搅匀后再煲 3 分钟即可关火盛碗。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盐最后放，早放肉会紧实。",
      "visual_cue": "汤面清亮浮少量油花"
    }
  ],
  "tips": [
    "菜干一定要泡透洗净，带沙会毁掉整锅汤。",
    "筒骨先焯后冲，汤色清亮不腥。，会影响最终的口感层次与卖相。",
    "蜜枣与南杏是甜味来源，别用白糖替代。"
  ],
  "common_mistakes": [
    "猪筒骨不焯水直接煲，汤色浑浊且腥味重。",
    "全程大火滚煮，汤被煮成乳白浑浊的油水混合体。",
    "盐一开始就放，骨头肉收紧，汤味反而不甜。"
  ],
  "substitutions": [
    {
      "original": "猪筒骨",
      "substitute": "猪脊骨",
      "ratio": "800g 对 800g",
      "note": "骨髓少一些，汤味略淡需多加 1 颗蜜枣。"
    },
    {
      "original": "白菜干",
      "substitute": "霸王花干",
      "ratio": "80g 对 60g",
      "note": "同为粤式煲汤干货，口感更滑。"
    }
  ],
  "variations": [
    "清润版：加 20g 玉竹同煲，汤更润喉。",
    "浓香版：筒骨先煎至微黄再煲，汤色更深。"
  ],
  "serving_suggestion": "饭前趁热喝一小碗，汤渣蘸酱油吃也不浪费。",
  "storage": "冷藏 2 天，冷冻 2 周；复热时加水稀释并补少量盐。",
