  ],
  "equipment": [
    "厚底锅",
    "锡纸",
    "油纸",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡冲净血水沥干，用盐把鸡身内外抹匀，腔內塞姜片和大葱段，淋料酒腌二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "盐要抹到大腿内侧和翅下，这些地方最不容易入味。",
      "visual_cue": "鸡皮表面泛白，腔內塞满葱姜。"
    },
    {
      "n": 2,
      "text": "沙姜剁成蓉，与少许盐和香油拌成沙姜酱，一半抹在鸡腔內，一半留作蘸料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "沙姜现剁现用，放久了香气散尽，只剩一股土味。",
      "visual_cue": "沙姜蓉浅黄颗粒，辛香冲鼻。"
    },
    {
      "n": 3,
      "text": "鸡身抹一层薄植物油，先用油纸包一层，再用锡纸裹紧，收口朝上防漏汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "两层包裹先纸后锡，纸吸油气、锡锁水分，鸡皮才不糊。",
      "visual_cue": "鸡身被裹成紧实的包，无破口。"
    },
    {
      "n": 4,
      "text": "厚底锅铺一层粗海盐作传热层，把鸡包埋进盐里，盐层完全盖住鸡包。",
      "time_min": 8,
      "heat": "无火",
      "tip": "海盐只作传热介质不入菜，铺够厚度受热才均匀。",
      "visual_cue": "盐层漫过鸡包，表面平整。"
    },
    {
      "n": 5,
      "text": "盖盖中火焗二十分钟，转小火再焗二十五分钟，中途不要开盖。",
      "time_min": 47,
      "heat": "中火",
      "tip": "火候先中后小，一直大火锅底盐会焦，鸡还不熟。",
      "visual_cue": "锅边冒出咸香热气，无焦味。"
    },
    {
      "n": 6,
      "text": "关火闷五分钟再开盖，取出鸡包拆开，趁热斩件摆盘，配沙姜酱上桌。",
      "time_min": 8,
      "heat": "无火",
      "tip": "拆包时小心蒸汽，先剪一角放气再整个撕开。",
      "visual_cue": "鸡皮金黄干香，腹腔汁水微沸。"
    }
  ],
  "tips": [
    "鸡选两斤出头的嫩鸡，太大焗不透，腿肉会带血。",
    "沙姜是盐焗鸡的灵魂，没有时可用沙姜粉代替，但要减半。",
    "锅要选厚底的，薄锅受热不匀，底部盐先焦。"
  ],
  "common_mistakes": [
    "只用一层锡纸包，蒸汽从缝隙跑掉，鸡肉发干。",
    "盐层铺得太薄，鸡皮被锅底烙糊，还焗不熟。",
    "焗的过程中开盖查看，温度一掉，鸡肉紧实发柴。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "童子鸡",
      "ratio": "1:1",
      "note": "换成童子鸡焗足四十五分钟，肉厚处用刀划两下更易熟透。"
    },
    {
      "original": "沙姜",
      "substitute": "姜",
      "ratio": "1:1.3",
      "note": "普通姜香气不及沙姜，用量要加三成，另加少许白胡椒提味。"
    }
  ],
  "variations": [
    "客家老法用粗盐在铁锅里炒到滚烫，把鸡埋进去焗，锅气更足。",
    "有的家庭改用电饭锅焗，锅底垫盐、上面铺鸡，按两次煮饭键即可。"
  ],
  "serving_suggestion": "斩件后趁热吃，蘸沙姜酱最搭；剩下的鸡骨与盐粒煮粥，咸香入味。",
  "storage": "冷藏可存两日，冷冻一周；复热用锡纸包好一百八十度烤十分钟，别微波。",
