        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "漏勺",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡爪逐个剪去趾甲，用清水冲洗干净，冷水下锅加料酒汆水五分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "趾甲不剪干净，汤里会带一股腥气。",
      "visual_cue": "水面浮起灰白浮沫"
    },
    {
      "n": 2,
      "text": "花生提前浸泡两小时，捞出沥干，搓掉外层红衣备用。",
      "time_min": 120,
      "heat": "无火",
      "tip": "泡透的花生才容易煲到起沙。",
      "visual_cue": "花生颗粒饱满、能掐动"
    },
    {
      "n": 3,
      "text": "砂锅加清水与生姜片烧开，放入鸡爪与花生，转小火加盖煲八十分钟。",
      "time_min": 82,
      "heat": "小火",
      "tip": "全程保持小火，汤色才清不浑。",
      "visual_cue": "汤面微微冒泡、鸡爪开始脱骨"
    },
    {
      "n": 4,
      "text": "加盐调味后再煮两分钟，关火撇去表面浮油即可盛出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐最后放，过早放鸡爪不易软烂。",
      "visual_cue": "汤色奶白、花生起沙"
    }
  ],
  "tips": [
    "鸡爪先汆水再煲，汤里的腥气会少很多。",
    "花生泡足两小时，煲出来才有起沙的口感。",
    "水要一次加够，中途添水会把鲜味冲淡。"
  ],
  "common_mistakes": [
    "鸡爪没有汆水直接下锅，汤色发灰还带腥味。",
    "花生没泡透就煲，煲两小时依然煮不软。",
    "煲到一半加冷水，肉质突然收紧久煲不烂。"
  ],
  "substitutions": [
    {
      "original": "鸡爪",
      "substitute": "鸡翅",
      "ratio": "500g 对 500g",
      "note": "胶质略少，鲜味相近。"
    },
    {
      "original": "花生",
      "substitute": "鹰嘴豆",
      "ratio": "120g 对 120g",
      "note": "口感更粉，需多泡一小时。"
    }
  ],
  "variations": [
    "加 200g 猪骨同煲，汤底更厚，适合当成煲汤底使用。",
    "换成冬瓜同煲，汤更清爽，夏天喝不腻。"
  ],
  "serving_suggestion": "趁热盛碗喝汤吃肉，鸡爪胶质最好在温热时入口。",
  "storage": "冷藏可放两天，复热须煮沸三分钟再喝。",
