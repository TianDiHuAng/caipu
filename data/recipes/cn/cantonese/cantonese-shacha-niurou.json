  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆着纹路切成薄片，切好摊开检查厚薄均匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切才不塞牙，厚薄一致受热才匀。",
      "visual_cue": "肉片薄透，纹理整齐"
    },
    {
      "n": 2,
      "text": "牛里脊片加生抽、料酒和淀粉抓匀，腌十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "抓到手感发黏再停，浆上足了肉才嫩。",
      "visual_cue": "肉片表面起薄浆发亮"
    },
    {
      "n": 3,
      "text": "洋葱切丝，青椒切块，蒜切末，沙茶酱加清水调开。",
      "time_min": 6,
      "heat": "无火",
      "tip": "沙茶酱先用水化开，下锅才不会结团。",
      "visual_cue": "酱汁顺滑，配料切好分堆"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒烟倒植物油，下牛里脊片大火快速滑散。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅要够热，肉片下锅十秒再翻才不老。",
      "visual_cue": "肉片卷边变色，不见血水"
    },
    {
      "n": 5,
      "text": "牛里脊片盛出，原锅下蒜末、洋葱和青椒中火炒软。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒到透明才甜，青椒保持脆口。",
      "visual_cue": "洋葱透亮，青椒翠绿"
    },
    {
      "n": 6,
      "text": "倒回牛里脊片，淋沙茶酱汁和白糖，大火翻炒收汁。",
      "time_min": 3,
      "heat": "大火",
      "tip": "酱汁下锅要快炒，久煮牛里脊会变韧。",
      "visual_cue": "酱汁裹匀，锅里不见汤水"
    }
  ],
  "tips": [
    "牛肉一定要逆纹切，顺纹切嚼起来像橡皮。",
    "腌肉时抓出黏性，滑炒后才嫩而不柴。",
    "全程大火快炒，牛肉在锅里别超过两分钟。"
  ],
  "common_mistakes": [
    "牛肉顺纹切片，炒出来又韧又塞牙。",
    "锅不够热就下肉，肉片出水变灰发柴。",
    "沙茶酱直接下锅不调开，结成硬块粘底。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛霖",
      "ratio": "400 克:420 克",
      "note": "纤维略粗，腌时多加五克淀粉。"
    },
    {
      "original": "沙茶酱",
      "substitute": "沙嗲酱",
      "ratio": "30 克:30 克",
      "note": "辣度更高，白糖加到五克平衡。"
    }
  ],
  "variations": [
    "加一把芥蓝同炒，清苦解腻很配沙茶。",
    "起锅前撒少许白芝麻，香气更厚。"
  ],
  "serving_suggestion": "趁热配白饭，酱汁拌饭咸香浓郁。",
  "storage": "冷藏一天，复热需大火快炒不宜久煮。",
