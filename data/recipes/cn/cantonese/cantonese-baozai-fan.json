  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后加清水浸泡二十分钟，沥干备用，让米粒吸足水分。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过的米煮出来粒粒分明，不泡容易夹生。",
      "visual_cue": "米粒饱满发白，指压易碎。"
    },
    {
      "n": 2,
      "text": "腊肠斜切厚片，腊肉切薄片，两者先用热水冲一遍去掉表面浮油和灰尘。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腊味表面有浮油和灰尘，冲一遍蒸出来才不腥。",
      "visual_cue": "腊味切片透亮，肥瘦分明。"
    },
    {
      "n": 3,
      "text": "砂锅内壁刷一层花生油，放入泡好的大米与清水，大火煮到水面收干、冒大泡。",
      "time_min": 8,
      "heat": "大火",
      "tip": "锅底刷油是起锅巴的关键，油少了锅巴粘底刮不下来。",
      "visual_cue": "水泡密集，米饭表面出现小孔。"
    },
    {
      "n": 4,
      "text": "把腊肠片和腊肉片铺在饭面上，沿锅边淋一圈花生油，盖盖转小火焗十五分钟。",
      "time_min": 16,
      "heat": "小火",
      "tip": "腊味铺在饭面靠蒸汽焗熟，油脂顺着孔洞渗进米饭。",
      "visual_cue": "锅边冒出细密热气，腊味油亮。"
    },
    {
      "n": 5,
      "text": "另起小锅，把生抽、老抽、白糖、蚝油和两勺清水小火煮开，做成煲仔饭豉油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豉油煮过才不冲口，甜咸也更融合。",
      "visual_cue": "豉油微滚，色深红亮。"
    },
    {
      "n": 6,
      "text": "开盖在饭面打一个鸡蛋，盖上再焗三分钟，把焯熟的小白菜摆在旁边。",
      "time_min": 4,
      "heat": "小火",
      "tip": "鸡蛋焗三分钟是溏心，喜全熟的可多焗一分钟。",
      "visual_cue": "蛋白凝固、蛋黄半透。"
    },
    {
      "n": 7,
      "text": "淋上豉油和香油，静置两分钟再拌开，让锅巴与米饭混着吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "淋汁后静置，锅巴吸汁变脆香，立刻拌就软了。",
      "visual_cue": "锅底锅巴金黄，米饭油亮。"
    }
  ],
  "tips": [
    "米选油粘米或丝苗米，细长爽口，吸水少不易糊。",
    "砂锅要选厚壁的，受热均匀锅巴才整片不焦。",
    "腊味本身够咸，豉油少放，边吃边加。"
  ],
  "common_mistakes": [
    "米不泡就煮，外层烂了里面还是硬的。",
    "全程大火，锅底焦黑而饭还夹生。",
    "豉油一次全倒进去，饭泡软了，锅巴也没了脆劲。"
  ],
  "substitutions": [
    {
      "original": "腊肠",
      "substitute": "腊肉",
      "ratio": "1:1",
      "note": "只用腊肉也行，切薄片铺满饭面，油脂更足。"
    },
    {
      "original": "小白菜",
      "substitute": "菜心",
      "ratio": "1:1",
      "note": "菜心焯三十秒即可，脆嫩清甜，配腊味解腻。"
    }
  ],
  "variations": [
    "顺德一带会在饭快熟时沿锅边淋一勺猪油，锅巴更酥香。",
    "有的店家把腊味先蒸五分钟再铺上去，油更清、咸味也更柔。"
  ],
  "serving_suggestion": "整锅上桌，淋豉油后拌开，配一碟焯青菜和热茶；锅巴是最好吃的部分。",
  "storage": "现做现吃，冷藏可存一日；复热加一勺清水盖盖小火焖五分钟，锅巴能回脆。",
