  "steps": [
    {
      "n": 1,
      "text": "虾仁挑去肠泥后从背部划开，加盐、料酒、白胡椒和玉米淀粉抓匀，腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "开背后虾仁受热卷成球，卖相好也更易入味。",
      "visual_cue": "虾仁开背舒展，表面薄浆。"
    },
    {
      "n": 2,
      "text": "隔夜冷饭搓散摊开晾十分钟，胡萝卜切半厘米小丁，小葱切葱花备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "饭粒一定要搓散，结块下锅炒不开。",
      "visual_cue": "米粒粒粒松散，配料切丁均匀。"
    },
    {
      "n": 3,
      "text": "炒锅烧热放少量花生油，下虾仁中火滑炒到卷曲变红，立即盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "虾仁一变红就盛出，留在锅里会越炒越硬。",
      "visual_cue": "虾仁卷成球状，颜色橙红。"
    },
    {
      "n": 4,
      "text": "锅中补油，下胡萝卜丁小火炒软，倒入蛋液炒成蛋花，随即下冷饭大火翻炒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "蛋花半凝固就下饭，蛋液裹住饭粒才香。",
      "visual_cue": "饭粒裹蛋发亮，锅中跳动。"
    },
    {
      "n": 5,
      "text": "加盐和生抽快速翻匀，倒回虾仁同炒三十秒，让虾仁的鲜味融进饭里。",
      "time_min": 2,
      "heat": "大火",
      "tip": "虾仁最后回锅，早放会老、也会把饭弄湿。",
      "visual_cue": "米饭干爽油亮，虾仁均匀分布。"
    },
    {
      "n": 6,
      "text": "撒葱花翻两下立即出锅，盛盘时把虾仁挑几颗放在饭面。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱花下锅十秒就够，久炒发黄发苦。",
      "visual_cue": "葱花翠绿，饭粒金黄。"
    }
  ],
  "tips": [
    "虾仁自己去肠泥开背，比买现成的干净也更弹。",
    "冷饭要够干，捏一下能散开是最好的状态。",
    "盐要在出锅前才放，放早了虾仁出水，饭会变得湿黏不清爽。"
  ],
  "common_mistakes": [
    "虾仁不腌直接下锅，腥味重、口感发柴。",
    "饭太湿就下锅，炒出来黏成一团。",
    "火不够大，饭粒被油浸透，吃着油腻不清爽。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "1:1",
      "note": "换成鸡粒即鸡粒蛋炒饭，鸡粒须炒到全熟不见粉红。"
    },
    {
      "original": "胡萝卜",
      "substitute": "玉米粒",
      "ratio": "1:1",
      "note": "玉米粒甜味更明显，焯熟后最后拌入即可。"
    }
  ],
  "variations": [
    "有的师傅在饭里加一勺蚝油，咸鲜更厚，颜色也深。",
    "加一小把焯熟的青豆和玉米粒，就是茶餐厅的招牌扬州炒饭风格。"
  ],
  "serving_suggestion": "盛盘堆成圆顶，配一碗紫菜蛋花汤；趁热吃最香。",
  "storage": "现炒现吃，冷藏不超过一日；复热用炒锅大火快炒一分钟。",
