  "equipment": [
    "汤锅",
    "打蛋碗",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干紫菜用清水快速冲一遍，泡 1 分钟后沥干，去掉沙粒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "紫菜不要久泡，泡久会失去脆嫩口感。",
      "visual_cue": "紫菜舒展开、水色微绿"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加 5ml 清水搅匀至蛋液细腻无结块。",
      "time_min": 1,
      "heat": "无火",
      "tip": "加少量水蛋花更嫩、更易拉成片。",
      "visual_cue": "蛋液均匀、表面浮小泡"
    },
    {
      "n": 3,
      "text": "高汤加姜丝煮沸，下紫菜煮 1 分钟，加盐与白胡椒调味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "紫菜先煮出味，汤才鲜。",
      "visual_cue": "汤色微绿、紫菜飘起"
    },
    {
      "n": 4,
      "text": "转小火，蛋液沿锅边细线淋入，静置 10 秒再轻轻推散。",
      "time_min": 2,
      "heat": "小火",
      "tip": "淋蛋时火要小，蛋花才成片不碎。",
      "visual_cue": "汤面浮起大片蛋花"
    },
    {
      "n": 5,
      "text": "关火后淋上香油，撒上葱花，即可盛碗上桌食用。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香油最后加，香气才留得住。",
      "visual_cue": "汤清蛋嫩、葱花香明显"
    }
  ],
  "tips": [
    "紫菜本身带咸味，盐要比平常少放。",
    "想更鲜可加 5g 虾皮同煮，但需减少盐量。",
    "蛋花汤现做现喝，久放蛋花会沉底。"
  ],
  "common_mistakes": [
    "蛋液倒入时水大滚，蛋花被冲成碎絮。",
    "紫菜久煮 5 分钟以上，汤发暗、紫菜发烂。",
    "盐一次放足再放紫菜，成品过咸。"
  ],
  "substitutions": [
    {
      "original": "紫菜",
      "substitute": "海带芽",
      "ratio": "8g 紫菜 ≈ 20g 海带芽",
      "note": "海带芽需煮 3 分钟。"
    },
    {
      "original": "高汤",
      "substitute": "清水加鸡精",
      "ratio": "700ml 高汤 ≈ 700ml 水 + 3g 鸡精",
      "note": "相应减少 1g 盐。"
    }
  ],
  "variations": [
    "家常版：加 50g 嫩豆腐丁与 3g 虾皮，做三鲜蛋花汤。",
    "粤式版：以 3g 瑶柱丝提鲜，汤更清甜。"
  ],
  "serving_suggestion": "配米饭或作为套餐汤水，饭前一碗最开胃。",
  "storage": "建议现做现喝，冷藏不超过 1 天，复热需煮沸。",
