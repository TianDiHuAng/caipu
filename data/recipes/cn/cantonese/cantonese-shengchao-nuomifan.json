  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗两遍后加清水浸泡四小时，泡到米粒能用指甲轻松掐断，捞出沥干。",
      "time_min": 245,
      "heat": "无火",
      "tip": "泡透是生炒的前提，泡不够炒出来外软内生。",
      "visual_cue": "米粒发白膨胀，指甲可轻松掐断。"
    },
    {
      "n": 2,
      "text": "腊肠、腊肉切小粒，香菇泡发后切粒，虾米用温水泡软，泡菇水留用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "配料都切成米粒大小，与糯米同嚼口感才协调。",
      "visual_cue": "配料颗粒均匀，大小与米粒相近。"
    },
    {
      "n": 3,
      "text": "炒锅放一半花生油，下腊肠腊肉粒小火煸出油，再下香菇粒和虾米炒香盛出。",
      "time_min": 7,
      "heat": "小火",
      "tip": "腊味先煸出油，用它本身的油炒饭更香。",
      "visual_cue": "腊味出油透亮，香菇边缘微焦。"
    },
    {
      "n": 4,
      "text": "锅中补油，下沥干的糯米中火不停翻炒，米粒开始发干时洒两勺清水。",
      "time_min": 8,
      "heat": "中火",
      "tip": "洒水要少量多次，洒完立刻翻炒，米粒才均匀受热。",
      "visual_cue": "米粒表面发亮，锅底无积水。"
    },
    {
      "n": 5,
      "text": "重复洒水翻炒三到四轮，直到糯米由白转半透明、粒粒分开有弹性。",
      "time_min": 12,
      "heat": "中火",
      "tip": "全程约十五分钟，米粒透明且咬开无硬心才算炒透。",
      "visual_cue": "糯米半透明，颗颗松散有弹。"
    },
    {
      "n": 6,
      "text": "倒回腊味配料，加生抽、老抽、蚝油、白糖和盐翻炒上色，最后拌入蛋碎和葱花。",
      "time_min": 5,
      "heat": "中火",
      "tip": "调味料最后下，早放糖分容易焦锅发苦。",
      "visual_cue": "饭粒油亮红褐，配料分布均匀。"
    }
  ],
  "tips": [
    "圆糯米比长糯米黏性足，生炒出来更弹牙。",
    "洒水要用温水，冷水会让米粒表面骤然收缩，反而更难透。",
    "锅要选厚底的，受热均匀糯米才不粘不焦。"
  ],
  "common_mistakes": [
    "糯米没泡透就下锅，炒再久中间还是硬芯。",
    "一次把水全倒进去，糯米被泡成糊，成了糯米饭团。",
    "火太大不翻动，锅底焦了一层，米饭带焦苦味。"
  ],
  "substitutions": [
    {
      "original": "腊肠",
      "substitute": "腊肉",
      "ratio": "1:1",
      "note": "只用腊肉也行，切粒后煸出的油更多，炒饭更香。"
    },
    {
      "original": "虾米",
      "substitute": "干贝",
      "ratio": "1:1",
      "note": "干贝需提前蒸软撕丝，鲜味更清雅，成本也高些。"
    }
  ],
  "variations": [
    "冬至前后广东人常做腊味糯米饭，有的直接把糯米蒸熟再炒，省力但少了生炒的弹牙感。",
    "有的家庭加一小把花生米同炒，口感更丰富。"
  ],
  "serving_suggestion": "趁热盛碗，配一碗老火汤；冬天吃最暖胃，配热茶解腻。",
  "storage": "冷藏可存两日；复热用炒锅加一勺清水大火快炒，糯米回软不粘牙。",
