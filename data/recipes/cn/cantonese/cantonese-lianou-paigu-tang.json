  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "猪排骨",
          "name_en": "pork ribs",
          "amount": 500,
          "unit": "g",
          "note": "斩成小块",
          "optional": false
        },
        {
          "name": "莲藕",
          "name_en": "lotus root",
          "amount": 300,
          "unit": "g",
          "note": "选粉藕，孔大粉多",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "熟花生",
          "name_en": "roasted peanut",
          "amount": 50,
          "unit": "g",
          "note": "去皮花生米",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 10,
          "unit": "g",
          "note": "切片",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "起锅前调味",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 10,
          "unit": "ml",
          "note": "焯水去腥",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1500,
          "unit": "ml",
          "note": "炖汤用水",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "菜刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪排骨斩成小块，冷水下锅加料酒煮开，撇去浮沫后捞出用温水冲洗干净。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅血水才逼得出来。",
      "visual_cue": "水面浮沫撇净、排骨发白"
    },
    {
      "n": 2,
      "text": "莲藕刮去外皮切成滚刀块，立刻泡进清水里防止氧化发黑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切好就泡水，颜色才白。",
      "visual_cue": "藕块切面洁白、不返黑"
    },
    {
      "n": 3,
      "text": "汤锅倒入清水，下排骨、莲藕、姜片与熟花生，大火烧开后撇净浮沫。",
      "time_min": 8,
      "heat": "大火",
      "tip": "花生提前泡两小时更易炖烂。",
      "visual_cue": "汤面清亮、无褐色浮沫"
    },
    {
      "n": 4,
      "text": "转小火盖盖炖九十分钟，中途尽量不揭盖也不加冷水。",
      "time_min": 90,
      "heat": "小火",
      "tip": "中途加水会让汤变浑、肉发柴。",
      "visual_cue": "藕块用筷子能轻松插透"
    },
    {
      "n": 5,
      "text": "起锅前加盐调味，再小火煮三分钟让咸味融进汤里，关火即可。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐最后放，肉才不紧。",
      "visual_cue": "汤色奶白微粉、藕香清甜"
    }
  ],
  "tips": [
    "挑藕看孔，孔大且带粉霜的是粉藕，炖汤才起沙。",
    "怕油腻可在炖好后撇去表面浮油。",
    "花生换成赤小豆同炖，汤更清甜解腻。"
  ],
  "common_mistakes": [
    "一开始就放盐，排骨炖两小时还是发硬。",
    "莲藕切好不泡水，下锅前已经变黑。",
    "全程大火滚煮，汤浑藕碎不成形。"
  ],
  "substitutions": [
    {
      "original": "猪排骨",
      "substitute": "猪脊骨",
      "ratio": "500g 对 600g",
      "note": "脊骨出汤更甜，炖的时间加半小时。"
    },
    {
      "original": "熟花生",
      "substitute": "赤小豆",
      "ratio": "50g 对 60g",
      "note": "赤小豆需提前泡两小时。"
    }
  ],
  "variations": [
    "加一段玉米同炖，汤带自然的甜味。",
    "放两片陈皮，去油腻、汤更清香。"
  ],
  "serving_suggestion": "趁热盛碗，连汤带藕一起吃，作饭前汤最合适。",
  "storage": "冷藏三天，复热时小火加热不要滚沸太久。",
