  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "猪筒骨",
          "name_en": "pork marrow bone",
          "amount": 600,
          "unit": "g",
          "note": "斩块焯水",
          "optional": false
        },
        {
          "name": "苦瓜",
          "name_en": "bitter melon",
          "amount": 300,
          "unit": "g",
          "note": "去瓤切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "黄豆",
          "name_en": "soybean",
          "amount": 100,
          "unit": "g",
          "note": "清水提前泡发",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 15,
          "unit": "g",
          "note": "拍裂",
          "optional": false
        },
        {
          "name": "蜜枣",
          "name_en": "candied date",
          "amount": 20,
          "unit": "g",
          "note": "增甜",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "最后调",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1800,
          "unit": "ml",
          "note": "一次加足",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤煲",
    "刀",
    "砧板",
    "汤勺",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄豆提前用清水泡四小时，泡到豆子鼓胀、指甲能轻松掐动。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡豆的清水倒掉再煮，汤才不会带一股豆腥味。",
      "visual_cue": "豆粒饱满圆润，表皮微微起皱"
    },
    {
      "n": 2,
      "text": "猪骨冷水下锅，水开后撇净浮沫煮三分钟，捞出用清水冲去血沫。",
      "time_min": 8,
      "heat": "大火",
      "tip": "必须冷水下锅，热水下锅血水锁在骨头里，汤会腥。",
      "visual_cue": "骨块表面干净，汤面浮沫转白"
    },
    {
      "n": 3,
      "text": "苦瓜对半剖开刮掉白瓤，切成三厘米厚的骨牌块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "白瓤是苦味主要来源，刮得越干净汤越清甜。",
      "visual_cue": "瓜块边缘整齐，内壁白膜去净"
    },
    {
      "n": 4,
      "text": "汤煲放猪骨、黄豆、姜与蜜枣，加清水大火烧开后转小火煲五十分钟。",
      "time_min": 50,
      "heat": "小火",
      "tip": "水面保持微微翻滚就好，大滚会让汤变浑。",
      "visual_cue": "汤色转成浅奶白，黄豆开始发软"
    },
    {
      "n": 5,
      "text": "下苦瓜块继续小火煲二十五分钟，直到瓜块变软透亮。",
      "time_min": 25,
      "heat": "小火",
      "tip": "苦瓜一定要后放，久煮会失去形状与那点清香。",
      "visual_cue": "瓜块半透明，边缘微微发软"
    },
    {
      "n": 6,
      "text": "关火前加盐调味，撇去表面浮油，盛出连汤带料一起吃。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐一定要最后放，早放肉会紧、汤会涩口。",
      "visual_cue": "汤面清亮带薄油，苦瓜转黄绿色"
    }
  ],
  "tips": [
    "苦瓜选表皮瘤粒大而疏的，苦味更温和好入口。",
    "怕苦可以把瓜块先用盐抓五分钟再冲净，苦味减半。",
    "汤要一次加足水，中途加水味道会明显变薄。",
    "煲好的汤别久放，当天喝完最清润。"
  ],
  "common_mistakes": [
    "猪骨热水下锅，血水锁在骨里，满锅都是腥味。",
    "苦瓜白瓤没刮干净，汤苦到完全喝不下去。",
    "全程大火滚，汤浑味重还容易烧干锅底。",
    "盐一开始就放，骨肉发柴、汤也不清甜。"
  ],
  "substitutions": [
    {
      "original": "猪骨",
      "substitute": "排骨",
      "ratio": "600克:600克",
      "note": "油脂少一些，汤更清爽不腻。"
    },
    {
      "original": "黄豆",
      "substitute": "眉豆",
      "ratio": "100克:100克",
      "note": "更易煮软，汤体更绵密。"
    }
  ],
  "variations": [
    "多放两颗蜜枣同煲，汤的清甜感会更明显一些。",
    "姜多放两片去腥提香，味道更接近外面喝到的老火汤。",
    "苦瓜切得大块一点，苦味更淡，汤的清甜更突出。"
  ],
  "serving_suggestion": "饭前先喝一碗清汤，苦瓜与黄豆一起盛出，配白饭和蒸鱼就是一餐广式家常饭。",
  "storage": "冷藏可放两天，复热用小火煮到滚，苦味会随时间变重，建议尽早喝完。",
