  "equipment": [
    "汤锅",
    "漏勺",
    "小碟"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菜心掰开洗净，嫩梗上的老皮用刀刮去一层。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刮掉老皮，口感才嫩不塞牙。",
      "visual_cue": "菜心洁净、梗部光滑"
    },
    {
      "n": 2,
      "text": "小碟里倒蒸鱼豉油与生抽，加白糖搅匀成淋汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先调好汁，菜焯好就能淋。",
      "visual_cue": "汁液均匀、糖完全化开"
    },
    {
      "n": 3,
      "text": "汤锅倒入清水大火烧开，加盐与几滴植物油搅匀备用。",
      "time_min": 5,
      "heat": "大火",
      "tip": "加盐与油，菜心才翠绿油亮。",
      "visual_cue": "水大滚、水面浮油光"
    },
    {
      "n": 4,
      "text": "菜心梗部先下锅烫十秒，再把整棵推入水中焯煮。",
      "time_min": 2,
      "heat": "大火",
      "tip": "先烫梗，梗叶才同时熟。",
      "visual_cue": "菜心颜色由浅转深绿"
    },
    {
      "n": 5,
      "text": "焯约一分钟后立刻捞出，摆入盘中沥去多余水分。",
      "time_min": 1,
      "heat": "大火",
      "tip": "别焯过头，软塌就不好吃了。",
      "visual_cue": "梗部能掐断、叶片挺立"
    },
    {
      "n": 6,
      "text": "菜心上铺蒜末、姜丝与红椒丝，摆得整齐好看。",
      "time_min": 1,
      "heat": "无火",
      "tip": "丝切细，泼油后香气才出。",
      "visual_cue": "三丝铺满菜心中央"
    },
    {
      "n": 7,
      "text": "把淋汁沿盘边倒入，植物油烧到微冒烟后泼在三丝上。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油要够热，泼下去才有响声。",
      "visual_cue": "蒜香冲鼻、三丝微微卷曲"
    }
  ],
  "tips": [
    "焯水锅里加油，是菜心翠绿的小秘诀。",
    "菜心买回后泡冰水十分钟，口感更脆。",
    "淋汁要先倒盘边，避免冲淡蒜香。"
  ],
  "common_mistakes": [
    "焯水时间过长，菜心发黄软塌，失去脆嫩口感。",
    "水没烧开就下菜，菜心带生涩味。",
    "油温不够就泼，蒜末只有生蒜辣味。"
  ],
  "substitutions": [
    {
      "original": "菜心",
      "substitute": "芥蓝",
      "ratio": "400g 对 400g",
      "note": "梗更硬，焯水时间加二十秒。"
    },
    {
      "original": "蒸鱼豉油",
      "substitute": "生抽",
      "ratio": "25ml 对 20ml",
      "note": "需加少许白糖补鲜。"
    }
  ],
  "variations": [
    "换成蚝油淋汁，风味更厚实，更适合配肉类主菜。",
    "出锅撒一把炸蒜酥，香气更浓，口感也多一层脆。"
  ],
  "serving_suggestion": "趁热上桌最翠绿，作为宴客的青菜收尾最合适。",
  "storage": "当天吃完最好，隔夜菜心会发黄并渗出水分。",
