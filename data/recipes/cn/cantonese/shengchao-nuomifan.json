  "equipment": [
    "炒锅",
    "蒸屉",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗后浸泡 4 小时至米粒发白，捞出沥干 20 分钟，摊在蒸屉上大火蒸 25 分钟。",
      "time_min": 270,
      "heat": "大火",
      "tip": "泡够时间的米蒸出来才粒粒分明不粘连。",
      "visual_cue": "米粒透明饱满、捏之软而不烂"
    },
    {
      "n": 2,
      "text": "腊肠、腊肉切小丁，香菇与虾米泡软后切碎，泡菇水留 50ml 备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡菇水是鲜味来源，别倒掉。",
      "visual_cue": "腊味丁大小均匀、香菇碎干爽"
    },
    {
      "n": 3,
      "text": "炒锅下 20ml 植物油，中火把腊肠丁与腊肉丁煸 3 分钟出油，再下香菇碎、虾米炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "腊味先煸出油，整锅饭才够润。",
      "visual_cue": "腊味边缘微卷、锅底浮起油脂"
    },
    {
      "n": 4,
      "text": "鸡蛋打散倒入锅边炒成小块，加 20ml 生抽、5ml 老抽、3g 盐与 2g 白胡椒炒匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋液下锅后别急着翻，凝块再炒更香。",
      "visual_cue": "蛋块金黄、酱色均匀裹住配料"
    },
    {
      "n": 5,
      "text": "倒入蒸好的糯米与 50ml 泡菇水，转小火用铲子翻拌 6 分钟至米粒吸汁油亮。",
      "time_min": 8,
      "heat": "小火",
      "tip": "全程小火翻拌，大火会把米炒硬。",
      "visual_cue": "糯米粒粒上色、锅底无积水"
    },
    {
      "n": 6,
      "text": "撒入 30g 大葱大葱末再翻两下，关火装砂锅焖 2 分钟即可上桌。",
      "time_min": 3,
      "heat": "小火",
      "tip": "大葱末最后放，香气才不散。",
      "visual_cue": "葱绿点缀分明、饭面泛油光"
    }
  ],
  "tips": [
    "糯米必须泡足 4 小时，浸泡不足蒸出来会有硬芯。",
    "腊味本身很咸，盐量要比平时减半。",
    "用铲子背翻压而不是乱铲，米粒才不碎。"
  ],
  "common_mistakes": [
    "糯米没泡透直接生炒，米芯硬得咬不动。",
    "火太大又不加水，锅底结出一层焦壳。",
    "盐按普通炒饭的量放，腊味一咸整锅弃掉。"
  ],
  "substitutions": [
    {
      "original": "腊肠",
      "substitute": "广式腊肠王",
      "ratio": "80g 对 80g",
      "note": "酒香更浓，风味更接近茶楼版本。"
    },
    {
      "original": "虾米",
      "substitute": "干贝丝",
      "ratio": "20g 对 20g",
      "note": "鲜味更清雅，泡发时间需延长 10 分钟。"
    }
  ],
  "variations": [
    "腊味双拼版：另加 50g 腊鸭腿肉丁同炒。",
    "冬菇版：香菇换成泡发的花菇，香气更厚。"
  ],
  "serving_suggestion": "趁热盛入砂锅，配一碟芥蓝或一碗例汤是茶楼常见搭配。",
  "storage": "冷藏 1 天，复热时加一勺水盖盖焖 3 分钟，避免米粒发硬。",
