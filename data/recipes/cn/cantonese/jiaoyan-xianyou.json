    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼去内脏与软骨，撕掉外层紫膜，冲洗干净后切成 1.5 厘米宽的圈。",
      "time_min": 10,
      "heat": "无火",
      "tip": "紫膜撕干净，成菜才不发韧。",
      "visual_cue": "鱿鱼圈白净、无残留薄膜"
    },
    {
      "n": 2,
      "text": "鱿鱼圈用厨房纸彻底吸干水分，撒 1g 盐抓匀腌 10 分钟。",
      "time_min": 11,
      "heat": "无火",
      "tip": "鱿鱼必须擦干，否则炸时爆油。",
      "visual_cue": "鱿鱼表面干爽、手感略紧"
    },
    {
      "n": 3,
      "text": "5g 盐、3g 白胡椒粉与 2g 五香粉混匀做成椒盐，放小碟备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "椒盐现拌现用，香气最足。",
      "visual_cue": "粉末混匀、颜色浅褐"
    },
    {
      "n": 4,
      "text": "鱿鱼圈放入 80g 玉米淀粉中，抖匀让每圈都裹上薄粉，再抖掉多余粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "薄薄一层就够，粉厚会发硬。",
      "visual_cue": "鱿鱼圈表面干爽带粉感"
    },
    {
      "n": 5,
      "text": "锅中倒入 270ml 植物油烧至七成热，下鱿鱼圈炸 90 秒至卷起微黄，捞出沥油。",
      "time_min": 4,
      "heat": "大火",
      "tip": "七成热下锅，油温低了会吸油。",
      "visual_cue": "鱿鱼圈卷曲成花、表面微黄"
    },
    {
      "n": 6,
      "text": "锅留 15ml 植物油作底油，中火炒香蒜末、青椒粒与红椒粒，倒入鱿鱼圈大火翻匀，撒椒盐颠锅即可。",
      "time_min": 4,
      "heat": "大火",
      "tip": "撒椒盐后快速颠匀，别久炒。",
      "visual_cue": "鱿鱼裹满椒盐、椒粒分布均匀"
    }
  ],
  "tips": [
    "鱿鱼下锅前一定要擦干，带水下油锅会剧烈爆油。",
    "淀粉裹薄薄一层就够，粉太厚炸完发硬。",
    "椒盐一定要最后撒，炒久了香气会全部散掉。"
  ],
  "common_mistakes": [
    "鱿鱼没擦干就下锅，热油四处飞溅。",
    "油温不足就下锅，鱿鱼吸油变软塌。",
    "炸好后回锅久炒，鱿鱼圈缩水发硬。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "小章鱼",
      "ratio": "500g 对 500g",
      "note": "炸制时间加 30 秒。"
    },
    {
      "original": "青椒",
      "substitute": "尖椒",
      "ratio": "40g 对 40g",
      "note": "辣味更冲，椒盐可减 1g。"
    }
  ],
  "variations": [
    "避风塘版：起锅加 30g 面包糠炒至金黄。",
    "蒜香版：蒜末加倍，最后淋 10ml 蒜油。"
  ],
  "serving_suggestion": "趁热装盘，配一碟椒盐与柠檬角。",
  "storage": "建议现炸现吃，回潮后可用 200 度烤箱复烤 4 分钟。",
