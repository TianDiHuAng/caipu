      "group": "main",
      "items": [
        {
          "name": "猪排骨",
          "name_en": "pork ribs",
          "amount": 500,
          "unit": "g",
          "note": "斩小段",
          "optional": false
        },
        {
          "name": "冬瓜",
          "name_en": "winter melon",
          "amount": 500,
          "unit": "g",
          "note": "连皮切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
