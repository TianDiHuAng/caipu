          "name_en": "job's tears",
          "amount": 60,
          "unit": "g",
          "note": "提前泡 2 小时",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "拍裂",
          "optional": false
        },
        {
          "name": "蜜枣",
          "name_en": "candied date",
          "amount": 2,
          "unit": "piece",
          "note": "增甜润",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
