          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "出锅前调",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 15,
          "unit": "ml",
          "note": "焯水去腥",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
          "note": "提香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "砂锅",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "薏米淘净后用清水泡 2 小时，泡到手指一捏能裂开。",
      "time_min": 120,
      "heat": "无火",
      "tip": "泡透的薏米煮出来才软糯不夹生。",
      "visual_cue": "薏米粒饱满发白、指甲可掐动"
    },
    {
      "n": 2,
      "text": "猪排骨冷水下锅，加 15ml 料酒与两片生姜，煮开撇净浮沫后捞出冲净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅血水才出得干净。",
      "visual_cue": "浮沫呈褐色结块、汤面清亮"
    },
    {
      "n": 3,
      "text": "砂锅中放入排骨、薏米、姜块与蜜枣，注入 1800ml 清水，大火烧开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水一次加足，中途加水汤味会淡。",
      "visual_cue": "汤面翻滚、浮沫二次撇净"
    },
    {
      "n": 4,
      "text": "转小火盖盖慢煲 40 分钟，让排骨的鲜味与薏米的清香融进汤里。",
      "time_min": 40,
      "heat": "小火",
      "tip": "保持汤面微微冒泡即可，别大滚。",
      "visual_cue": "汤色转成浅乳白、排骨酥软"
    },
    {
      "n": 5,
      "text": "冬瓜去皮去瓤切 3cm 大块，连皮一起下锅再煮 20 分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "冬瓜后放，久煮会化成一锅糊。",
      "visual_cue": "冬瓜呈半透明、棱角略圆"
    },
    {
      "n": 6,
      "text": "加 6g 盐与 2g 白胡椒粉调味，关火焖 5 分钟后盛出。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐最后放，排骨更容易炖软。",
      "visual_cue": "汤清味鲜、冬瓜入口即化"
    }
  ],
  "tips": [
    "冬瓜皮利水，洗净一起煲，汤味更清甜。",
    "薏米性凉，怕寒的人可先干锅炒黄再用。",
    "撇沫要彻底，汤才清亮不腥、口感干净利落。"
  ],
  "common_mistakes": [
    "排骨没焯水直接煲，汤浑浊带腥味。",
    "冬瓜一开始就下锅，最后完全化掉找不到块。",
    "中途加冷水，肉质骤缩变柴，汤味也冲淡。"
  ],
  "substitutions": [
    {
      "original": "猪排骨",
      "substitute": "猪腱肉",
      "ratio": "500g 对 450g",
      "note": "腱肉更瘦，煲的时间延长 15 分钟。"
    },
    {
      "original": "薏米",
      "substitute": "赤小豆",
      "ratio": "60g 对 60g",
      "note": "祛湿效果相近，需同样提前泡发。"
    }
  ],
  "variations": [
    "老火版：煲足 2 小时，汤色更浓，适合秋冬。",
    "清淡版：薏米减半，加 200g 玉米段增甜。"
  ],
  "serving_suggestion": "饭前一碗，配白饭与青菜，就是家常的广式一餐。",
  "storage": "冷藏 2 天，复热至沸腾；冬瓜隔夜会出水，汤量会变多。",
