  "id": "mangguo-nuomici",
  "name": {
    "zh": "芒果糯米糍",
    "en": "Mango Glutinous Rice Dumplings"
  },
  "cuisine": {
    "region": "cn",
    "style": "cantonese"
  },
  "category": [
    "dessert"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 40,
    "cook_min": 10,
    "total_min": 50
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "rich",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 200,
          "unit": "g",
          "note": "做皮用",
          "optional": false
        },
        {
          "name": "芒果",
          "name_en": "mango",
          "amount": 300,
          "unit": "g",
          "note": "取果肉切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 100,
          "unit": "ml",
          "note": "调糊增香",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "调甜味",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 30,
          "unit": "g",
          "note": "降低黏性",
          "optional": false
        },
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 100,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 100,
          "unit": "ml",
          "note": "调糊",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "打蛋器",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉、玉米淀粉与白糖混合过筛，倒入牛奶、椰奶与清水搅成无颗粒面糊。",
      "time_min": 10,
      "heat": "无火",
      "tip": "过筛两次，面糊才细腻不结块。",
      "visual_cue": "面糊顺滑、提起打蛋器呈直线流下"
    },
    {
      "n": 2,
      "text": "面糊过筛倒入浅盘，盖上保鲜膜扎几个小孔，静置十分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "扎孔让蒸汽散出，表面才不会积水。",
      "visual_cue": "保鲜膜绷平、表面无气泡"
    },
    {
      "n": 3,
      "text": "蒸锅水开后放入，大火蒸十二分钟至面糊透明熟透。",
      "time_min": 12,
      "heat": "大火",
      "tip": "中间一定要蒸到全透明才算熟。",
      "visual_cue": "面糊透亮、中心无水浆"
    },
    {
      "n": 4,
      "text": "取出稍微放凉，趁温热把糯米面团揉匀搓成光滑长条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "太烫会粘手，太凉就揉不动了。",
      "visual_cue": "面团光滑不粘、手感柔软"
    },
    {
      "n": 5,
      "text": "面团分成四十克一个的小剂子，按扁后包入芒果肉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "芒果块切小些，收口才容易捏紧。",
      "visual_cue": "剂子均匀、芒果不外露"
    },
    {
      "n": 6,
      "text": "收口捏紧搓圆，在糯米粉里滚一圈防粘即可。",
      "time_min": 5,
      "heat": "无火",
      "tip": "滚粉前先抖掉多余粉，口感才清爽。",
      "visual_cue": "成品圆润洁白、表皮无裂口"
    }
  ],
  "tips": [
    "面团里加玉米淀粉，凉了也不硬。",
    "芒果选熟透的，甜味足且纤维少。",
    "手上抹一点植物油再包，比撒粉更好操作。"
  ],
  "common_mistakes": [
    "面糊没蒸透就包，中间还是稀浆。",
    "面团放凉后才揉，怎么揉都揉不光滑。",
    "保鲜膜没有扎孔，蒸汽滴水把面糊泡稀。"
  ],
  "substitutions": [
    {
      "original": "芒果",
      "substitute": "火龙果",
      "ratio": "300g 对 300g",
      "note": "颜色更艳，甜度略低。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "100ml 对 100ml",
      "note": "椰香变淡，可加五克白糖。"
    }
  ],
  "variations": [
    "芒果换成榴莲肉，就是榴莲控最爱的版本。",
    "外皮换成抹茶口味，加三克抹茶粉同调。"
  ],
  "serving_suggestion": "冷藏一小时后再吃，皮更弹牙、芒果更清甜。",
  "storage": "密封冷藏可放两天，表皮会略硬。",
