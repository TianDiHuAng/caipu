  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成三厘米见方的块，冲净血水后挤干水分，放深盘备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "挤干水分腌料才挂得住，蒸出来不至于一汪水。",
      "visual_cue": "鸡块表面干爽，大小均匀。"
    },
    {
      "n": 2,
      "text": "豆豉剁碎，与姜末下锅用少量植物油小火炒出香味，盛出摊凉。",
      "time_min": 6,
      "heat": "小火",
      "tip": "豆豉炒过才去生涩味，香气也更浓。",
      "visual_cue": "豆豉粒粒松散，豉香扑鼻。"
    },
    {
      "n": 3,
      "text": "鸡块加生抽、蚝油、白糖、料酒、盐、白胡椒和炒好的豆豉抓匀，腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "抓拌到鸡块发黏再停手，味道才吸得进去。",
      "visual_cue": "鸡块挂满酱色，表面发亮。"
    },
    {
      "n": 4,
      "text": "腌好的鸡块拌入玉米淀粉和植物油，摊平在深盘里，尽量不要叠太厚。",
      "time_min": 4,
      "heat": "无火",
      "tip": "淀粉锁汁、油防粘，摊平受热才均匀。",
      "visual_cue": "鸡块表面薄薄一层浆。"
    },
    {
      "n": 5,
      "text": "蒸锅大火上汽后放入深盘，中火蒸十二分钟，关火再闷两分钟。",
      "time_min": 14,
      "heat": "中火",
      "tip": "上汽后再放进去，冷水上锅蒸出来肉发柴、盘里都是水。",
      "visual_cue": "盘底汁水清亮，鸡皮鼓起。"
    },
    {
      "n": 6,
      "text": "取出撒小葱粒，淋香油和几滴热植物油激香，趁热连汁一起上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "葱粒最后撒，蒸过就发黄，卖相和香味都损。",
      "visual_cue": "葱绿点点，豉汁油亮。"
    }
  ],
  "tips": [
    "豆豉选阳江或罗定的，颗粒完整、豉香厚，别买碎末。",
    "鸡腿肉比鸡胸耐蒸，十二分钟刚熟不老。",
    "盘要深一点，蒸出的鸡汁是精华，拌饭极香。"
  ],
  "common_mistakes": [
    "豆豉不炒直接拌，生豉味重，蒸出来发涩。",
    "鸡块切得大小不一，小的老大的生。",
    "冷水上锅干蒸，鸡肉失水发柴，盘底一片汤水。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "1:1.1",
      "note": "鸡翅对半剁开蒸十分钟即可，胶质多、更滑嫩。"
    },
    {
      "original": "豆豉",
      "substitute": "生抽",
      "ratio": "25克:20毫升",
      "note": "缺豆豉时改用生抽加少许白糖，风味近似但少了豉香。"
    }
  ],
  "variations": [
    "有的做法在豉汁里加一勺辣椒酱，蒸出来微辣开胃。",
    "顺德一带会把鸡块换成排骨或鱼头，豉汁配方一致。"
  ],
  "serving_suggestion": "连盘上桌，用勺把豉汁淋在鸡块上，配白饭最下饭；豉汁拌面也香。",
  "storage": "冷藏可存两日；复热上锅蒸八分钟，不要微波炉直接打，鸡肉会发硬。",
