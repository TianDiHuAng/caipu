  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "木铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐切成两厘米见方的小块，放淡盐水里浸五分钟捞出沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐水浸过的嫩豆腐更紧实，炒的时候不容易碎。",
      "visual_cue": "豆腐块完整不碎，盘底不见积水"
    },
    {
      "n": 2,
      "text": "虾米用清水泡五分钟沥干水分，再用刀剁成细末备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "剁得越细，炒出来的虾米香分布越均匀。",
      "visual_cue": "虾米成细末状，颗粒大小一致"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油中小火，下虾米细末慢慢炒到颜色转深、香气浓烈。",
      "time_min": 5,
      "heat": "小火",
      "tip": "小火慢炒才出香，火大了十秒就焦苦变色。",
      "visual_cue": "细末呈深橙红色，锅内油色转红亮"
    },
    {
      "n": 4,
      "text": "倒入豆腐块轻轻推匀，加生抽、蚝油与盐，小火煮三分钟让豆腐入味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "用铲背推而不是铲尖翻，豆腐才保持完整。",
      "visual_cue": "豆腐边缘微微上色，汤汁渐浓"
    },
    {
      "n": 5,
      "text": "淋香油晃锅，撒葱花后关火装盘，把锅内红油一并浇上。",
      "time_min": 1,
      "heat": "小火",
      "tip": "香油最后淋，加热过头会失去那股清香。",
      "visual_cue": "表面油亮红润，葱花翠绿点缀"
    }
  ],
  "tips": [
    "虾米已经有咸味，盐要少放，最好先尝再决定用量。",
    "嫩豆腐下锅前沥干水，炒的时候才不会出一锅汤。",
    "喜欢更浓可以勾一点薄芡，汤汁能更好裹住，卖相也更亮。",
    "换用质地更硬的品种，翻动时更不易碎，但口感会偏粗。"
  ],
  "common_mistakes": [
    "虾米没剁细就下锅，吃起来扎口还分布不均。",
    "火大炒虾米，几秒钟就发黑带苦味全废掉。",
    "用铲子大力翻炒，端上桌全是碎块没有卖相。",
    "盐和蚝油一起放足，成品咸得发苦完全没法吃。"
  ],
  "substitutions": [
    {
      "original": "虾米",
      "substitute": "干贝",
      "ratio": "25克:20克",
      "note": "需提前泡软撕成细丝，鲜味更清雅。"
    },
    {
      "original": "嫩豆腐",
      "substitute": "鸡蛋豆腐",
      "ratio": "450克:450克",
      "note": "口感更滑嫩，翻动时要更轻。"
    }
  ],
  "variations": [
    "生抽换成味道更柔和的淡酱油，咸鲜层次更细腻。",
    "出锅前淋香油时撒一点小葱，香气更清新适合配粥。",
    "装进烧热的砂锅上桌，保温更久，冬天吃更暖。"
  ],
  "serving_suggestion": "装盘后浇上锅里的红油，配白饭最香，也可以当作白粥的配菜。",
  "storage": "冷藏可放一天，复热用小火加两勺水焖两分钟，嫩豆腐久放会出水变酸。",
