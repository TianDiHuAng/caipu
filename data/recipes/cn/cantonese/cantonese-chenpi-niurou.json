  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆着纹理切成两毫米薄片，拌入生抽、料酒与白胡椒抓匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纹切断肌肉纤维，炒出来才不会嚼成一根根筋。",
      "visual_cue": "肉片透光可见，表面吸饱酱汁"
    },
    {
      "n": 2,
      "text": "陈皮放清水里泡十分钟泡到回软，刮掉内层白瓤，切成细丝备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "内层白瓤带明显苦味，刮干净只留橘香。",
      "visual_cue": "橘皮丝呈深橙褐色，摸着柔韧"
    },
    {
      "n": 3,
      "text": "腌好的牛里脊片拌入淀粉与一勺植物油抓匀，让每片都裹上薄浆。",
      "time_min": 3,
      "heat": "无火",
      "tip": "淀粉加一勺油抓散，下锅才不会粘成一大块。",
      "visual_cue": "肉片表面泛浆，不互相粘连"
    },
    {
      "n": 4,
      "text": "炒锅烧到微微冒烟倒植物油，下姜丝与陈皮丝小火炒出橘香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "陈皮炒香只需十几秒，久了会发苦压住肉味。",
      "visual_cue": "锅里飘出清亮橘香，姜丝微黄"
    },
    {
      "n": 5,
      "text": "转大火下牛里脊片摊开快炒到表面变色，加蚝油与白糖翻匀。",
      "time_min": 4,
      "heat": "大火",
      "tip": "肉片下锅别急着翻，贴锅三秒再炒才有焦香。",
      "visual_cue": "肉片由红转褐，边缘带上焦色"
    },
    {
      "n": 6,
      "text": "下小葱快速翻两下断生，尝味补盐即可关火装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "小葱最后放，翻两下就要出锅，炒久发黄发蔫。",
      "visual_cue": "葱色翠绿，锅里没有多余汤汁"
    }
  ],
  "tips": [
    "陈皮选年份久的，香气沉而不发涩。",
    "牛里脊先冷冻二十分钟再切，更容易切出薄片。",
    "想更浓可以加一勺泡陈皮的水同炒，橘香更足。",
    "全程大火快炒，锅小就分两次炒，避免出水变成煮肉。"
  ],
  "common_mistakes": [
    "牛里脊顺纹切片，炒完嚼起来像橡皮条一样费牙。",
    "陈皮内层白瓤没刮，整道菜带一股药苦味。",
    "肉片下锅就猛翻，出水变成煮肉，锅底一汪汤。",
    "小葱一开始就下锅，端上来发黄发蔫没有香气。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛腩",
      "ratio": "400克:450克",
      "note": "需先焖软再快炒，时间要加四十分钟。"
    },
    {
      "original": "陈皮",
      "substitute": "橘皮",
      "ratio": "5克:8克",
      "note": "新鲜橘皮要刮净白瓤，香气更冲。"
    }
  ],
  "variations": [
    "多放一点姜丝同炒，辛香更明显也更解腻。",
    "收尾淋半勺植物油晃匀，光泽更亮，也贴近老派馆子的做法。"
  ],
  "serving_suggestion": "趁热装盘配白饭，牛里脊要连陈皮丝一起吃，橘香在口腔里才散得开。",
  "storage": "冷藏可放一天，复热用大火快炒三十秒，久加热肉质会明显变硬。",
