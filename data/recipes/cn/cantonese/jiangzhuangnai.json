  },
  "servings": 3,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 600,
          "unit": "ml",
          "note": "全脂水牛奶最佳",
          "optional": false
        },
        {
          "name": "姜汁",
          "name_en": "ginger juice",
          "amount": 45,
          "unit": "ml",
          "note": "现磨现用",
          "optional": false
        },
        {
          "name": "生姜",
          "name_en": "ginger",
          "amount": 120,
          "unit": "g",
          "optional": false,
          "note": "老姜，磨蓉挤汁"
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 45,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小奶锅",
    "温度计",
    "细网筛",
    "三个小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "生姜去皮磨成姜蓉，用纱布挤出 45ml 姜汁，分三份倒入三个小碗。",
      "time_min": 8,
      "heat": "无火",
      "tip": "姜汁必须现磨，久放会失去凝固力。",
      "visual_cue": "姜汁乳白微黄、气味辛辣"
    },
    {
      "n": 2,
      "text": "牛奶倒入奶锅，加 45g 白糖，小火加热并不断搅拌至糖化，温度到 70℃ 离火。",
      "time_min": 5,
      "heat": "小火",
      "tip": "超过 80℃ 姜汁酶会失活，撞不成型。",
      "visual_cue": "锅边冒小泡、糖完全溶解"
    },
    {
      "n": 3,
      "text": "把热牛奶从 20cm 高处快速冲入姜汁碗中，冲完不再搅动。",
      "time_min": 2,
      "heat": "无火",
      "tip": "高冲能让奶与姜汁充分混合。",
      "visual_cue": "表面迅速浮起细密泡沫"
    },
    {
      "n": 4,
      "text": "静置 8 分钟待其凝固，表面泡沫用勺子撇去即可食用。",
      "time_min": 9,
      "heat": "无火",
      "tip": "静置期间不要晃动，否则凝不成块。",
      "visual_cue": "勺背轻压不塌、边缘离碗"
    }
  ],
  "tips": [
    "必须用水牛奶或全脂奶，脂肪低了凝不住。",
    "牛奶温度控制在 65-75℃ 之间最关键。",
    "姜汁现挤现用，放半小时以上效果明显变差。"
  ],
  "common_mistakes": [
    "牛奶煮到沸腾再撞，姜汁酶被烫死，永远是液体。",
    "冲完后习惯性搅拌，凝固结构被打散。",
    "用低脂牛奶制作，成品稀软像奶汤。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "羊奶",
      "ratio": "600ml 对 600ml",
      "note": "奶味更浓，温度略降到 65℃。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "45g 对 40g",
      "note": "颜色偏褐，风味更厚。"
    }
  ],
  "variations": [
    "椰香版：牛奶换成椰奶 400ml 加牛奶 200ml。",
    "双皮版：先煮奶结皮再撞姜汁，层次更丰富。"
  ],
  "serving_suggestion": "温热时吃口感最滑，冷藏后更像布丁。",
  "storage": "冷藏 1 天，不可冷冻；复热会析水变稀。",
  "nutrition_estimate": {
    "basis": "每份（约 200ml）",
    "calories_kcal": 210,
    "protein_g": 8,
