  "equipment": [
    "炒锅",
    "锅铲",
    "刷子",
    "厨房剪"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花蟹用刷子刷净蟹壳缝隙，掀开蟹盖去掉蟹腮与胃囊，斩成 4 块，切口拍上 25g 淀粉。",
      "time_min": 20,
      "heat": "无火",
      "tip": "切口拍粉能锁住蟹汁不流失。",
      "visual_cue": "蟹块切口均匀裹粉、蟹腮清除干净"
    },
    {
      "n": 2,
      "text": "锅中倒 40ml 植物油烧至五成热，下姜片与蒜末小火煸 1 分钟出香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "姜片煸到边缘卷起，姜味才够。",
      "visual_cue": "姜片微焦、油面浮香"
    },
    {
      "n": 3,
      "text": "蟹块切口朝下入锅，中火煎 2 分钟至切口金黄定型，再翻面炒 1 分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "切口先煎定型，蟹肉才不散。",
      "visual_cue": "切口金黄结壳、蟹壳转红"
    },
    {
      "n": 4,
      "text": "沿锅边淋 20ml 料酒，加 20ml 生抽、5g 白糖、4g 盐与 80ml 清水，加盖焖 4 分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "水不要多，焖到刚好收干。",
      "visual_cue": "汤汁沸腾冒泡、蟹壳鲜红"
    },
    {
      "n": 5,
      "text": "开盖下葱白段翻炒 1 分钟，再撒葱绿段快速兜匀，汤汁收浓裹住蟹块即可出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "葱绿最后放，保持辛香与翠色。",
      "visual_cue": "汤汁浓稠挂蟹、葱段碧绿"
    }
  ],
  "tips": [
    "蟹块切口拍粉，煎后蟹汁会被牢牢锁住。",
    "全程不超过 10 分钟，蟹肉久炒会缩水变柴。",
    "葱白先葱绿后，香气分两次释放。"
  ],
  "common_mistakes": [
    "蟹块不拍粉直接下锅，蟹汁流出让锅里全是水。",
    "火候太小慢慢炒，蟹肉被焖老、壳内发干。",
    "葱段一开始就下锅，出锅时已经焦黑发苦。"
  ],
  "substitutions": [
    {
      "original": "花蟹",
      "substitute": "梭子蟹",
      "ratio": "900g 对 900g",
      "note": "壳薄肉多，焖的时间减 1 分钟。"
    },
    {
      "original": "料酒",
      "substitute": "米酒",
      "ratio": "20ml 对 25ml",
      "note": "香气更柔，适合清淡口味。"
    }
  ],
  "variations": [
    "避风塘版：加 40g 蒜蓉与 20g 面包糠同炒。",
    "咖喱版：焖时加 20g 咖喱酱，汤汁更浓。"
  ],
  "serving_suggestion": "趁热连汁上桌，蟹汁拌饭是粤式吃法的一大乐趣。",
  "storage": "现做现吃，冷藏不超过 1 天，复热需回锅加少量水焖 3 分钟。",
