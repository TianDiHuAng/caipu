        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "菜刀",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐用厨房纸吸干表面水分，切成两厘米厚的大片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐表面越干，煎的时候越不粘。",
      "visual_cue": "豆腐片完整、表面无水光"
    },
    {
      "n": 2,
      "text": "生抽、老抽、白糖、玉米淀粉加清水调成豉油汁，搅到糖化开无颗粒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "淀粉先用水化开，勾芡才不结块。",
      "visual_cue": "豉油汁均匀、颜色红褐"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油烧热，豆腐片平铺下锅，中火煎到一面金黄结壳。",
      "time_min": 4,
      "heat": "中火",
      "tip": "下锅后别急着翻，结壳才不碎。",
      "visual_cue": "底面金黄、能整片推动"
    },
    {
      "n": 4,
      "text": "翻面继续煎到两面金黄起硬皮，然后把豆腐片拨到锅边一侧。",
      "time_min": 5,
      "heat": "中火",
      "tip": "用铲子配合筷子翻面，免得碎角。",
      "visual_cue": "两面金黄、外皮微硬"
    },
    {
      "n": 5,
      "text": "下蒜末在锅中间煸香，倒入豉油汁烧开，让豆腐均匀裹上酱汁。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "汁一滚就转小火，久了豆腐出水。",
      "visual_cue": "酱汁冒泡、挂在豆腐表面"
    },
    {
      "n": 6,
      "text": "收汁到浓稠发亮，撒上葱花关火，装盘即可上桌。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "汁收到能挂住豆腐即停。",
      "visual_cue": "豆腐油亮、盘底无多余汤汁"
    }
  ],
  "tips": [
    "豆腐先蒸五分钟再煎，更紧实不易碎。",
    "豉油汁里加几滴麻油，香气更足。",
    "喜欢软嫩口感，可以省去勾薄芡这一步。"
  ],
  "common_mistakes": [
    "豆腐带着水下锅，油溅且粘锅破皮。",
    "火大急煎，外面焦了里面还是凉的。",
    "豉油汁一次倒太多，豆腐泡在汤里发软。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "板豆腐",
      "ratio": "450g 对 450g",
      "note": "板豆腐更硬，煎后更有嚼劲。"
    },
    {
      "original": "生抽",
      "substitute": "酱油膏",
      "ratio": "25ml 对 20g",
      "note": "酱油膏偏甜，白糖减到 3g。"
    }
  ],
  "variations": [
    "煎好后加一把豆芽垫底，吸汁又清爽。",
    "撒一撮白芝麻与辣椒丝，卖相更精致。"
  ],
  "serving_suggestion": "趁热上桌，配白饭或拌面都好吃。",
  "storage": "冷藏两天，复热用平底锅小火两面各煎一分钟。",
