  "equipment": [
    "炒锅",
    "漏勺",
    "保鲜盒"
  ],
  "steps": [
    {
      "n": 1,
      "text": "排骨用清水浸泡三十分钟，中途换水把血水泡干净。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡出血水，炸出来才不发黑。",
      "visual_cue": "排骨发白、水色变清"
    },
    {
      "n": 2,
      "text": "排骨捞出沥干，用厨房纸吸掉表面水分放入保鲜盒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "表面干爽，腌料才挂得住。",
      "visual_cue": "排骨干爽、不见血水"
    },
    {
      "n": 3,
      "text": "大蒜一半榨成蒜汁，另一半剁成蒜末，姜切片备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蒜汁拌入排骨，味道渗透得更快。",
      "visual_cue": "蒜汁清亮、蒜末细匀"
    },
    {
      "n": 4,
      "text": "排骨加蒜汁、生抽、蚝油、料酒、白糖、五香粉与白胡椒抓匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用手抓揉五分钟，味道才进骨头。",
      "visual_cue": "每块排骨裹满酱料、颜色红褐"
    },
    {
      "n": 5,
      "text": "保鲜盒盖好冷藏腌制一小时，中途翻拌一次。",
      "time_min": 45,
      "heat": "无火",
      "tip": "腌足时间，蒜香才能透进去。",
      "visual_cue": "肉质紧实、蒜香浓郁"
    },
    {
      "n": 6,
      "text": "腌好的排骨挑去姜片，撒玉米淀粉抓匀裹上薄粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "薄粉锁住肉汁，炸后更脆。",
      "visual_cue": "排骨表面淀粉层均匀、不粘手"
    },
    {
      "n": 7,
      "text": "锅中倒植物油烧到六成热，排骨逐块下锅中火炸四分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "下锅后先别翻动，定型再说。",
      "visual_cue": "排骨浮起、外壳浅棕"
    },
    {
      "n": 8,
      "text": "捞出沥油，油温升到八成热后回锅复炸四十秒至金黄。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "复炸逼油，外酥里嫩不油腻。",
      "visual_cue": "排骨深金、敲壳有声"
    },
    {
      "n": 9,
      "text": "另起锅下少许油小火煸香蒜末，倒入排骨大火翻炒，撒盐与葱花翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "蒜末一变色就下排骨，别炒糊。",
      "visual_cue": "排骨裹满蒜粒、葱花翠绿"
    }
  ],
  "tips": [
    "选带一点肥的肋排，炸后更香不柴。",
    "蒜汁与蒜末分开用，腌味和香气各有分工。",
    "买不到五香粉时，可用少许十三香代替。"
  ],
  "common_mistakes": [
    "排骨不泡血水直接腌，成品发黑还带腥味。",
    "腌制时间太短，只有表层有味道，里面寡淡无味。",
    "油温偏高直接下锅，外壳焦了里面还是生的。"
  ],
  "substitutions": [
    {
      "original": "猪排骨",
      "substitute": "鸡翅中",
      "ratio": "600g 对 600g",
      "note": "炸制时间减到三分钟。"
    },
    {
      "original": "五香粉",
      "substitute": "十三香",
      "ratio": "2g 对 2g",
      "note": "香气更复合，用量不宜多。"
    }
  ],
  "variations": [
    "腌料里加一勺南乳，风味更接近粤式老味道。",
    "出锅撒一把炸蒜片，蒜香更霸道。"
  ],
  "serving_suggestion": "趁热手抓着啃最香，配一杯冰镇饮料刚好。",
  "storage": "冷藏可放两天，复热用烤箱烘八分钟回脆。",
