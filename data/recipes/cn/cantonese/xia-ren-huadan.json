        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 12,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 8,
          "unit": "ml",
          "note": "虾仁去腥",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 5,
          "unit": "g",
          "note": "虾仁上浆",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "去腥提鲜",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "分两次",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "炒制用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "不粘锅或炒锅",
    "打蛋碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁加料酒、白胡椒、1g 盐与玉米淀粉抓匀，腌 10 分钟上浆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "上浆能锁住水分，炒后虾仁更弹。",
      "visual_cue": "虾仁表面挂一层薄浆、手感滑"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加 2g 盐与 15ml 清水搅匀至蛋液起细泡。",
      "time_min": 2,
      "heat": "无火",
      "tip": "加清水炒出的蛋更嫩，蛋液要充分打匀再下锅。",
      "visual_cue": "蛋液均匀、表面浮细密泡沫"
    },
    {
      "n": 3,
      "text": "锅烧热下 10ml 植物油，中火把虾仁煎到两面变色盛出。",
      "time_min": 2,
      "heat": "中火",
      "tip": "虾仁只需七成熟，回锅后会继续受热。",
      "visual_cue": "虾仁卷成弯月形、表面转粉白"
    },
    {
      "n": 4,
      "text": "锅转小火下 20ml 油，倒入蛋液，用锅铲由外向内慢推，蛋液半凝固时下虾仁。",
      "time_min": 2,
      "heat": "小火",
      "tip": "全程小火慢推是滑蛋的关键，大火立刻变老。",
      "visual_cue": "蛋液呈湿润的云朵状、底部不焦"
    },
    {
      "n": 5,
      "text": "撒葱花，蛋液还有少量流动时关火，用余温推匀出锅。",
      "time_min": 1,
      "heat": "无火",
      "tip": "关火早一步，装盘后余温刚好把蛋焖熟。",
      "visual_cue": "蛋体嫩滑微颤、无焦边"
    }
  ],
  "tips": [
    "虾仁用厨房纸吸干水分再上浆，浆才挂得住。",
    "鸡蛋选新鲜的，蛋香更浓、凝固更均匀。",
    "喜欢更滑的口感可加 10ml 淡奶油或 5g 玉米淀粉水。"
  ],
  "common_mistakes": [
    "大火炒蛋，蛋液迅速结块变老发干。",
    "虾仁不腌直接下锅，腥味明显且口感发柴。",
    "蛋液完全凝固才关火，装盘后继续受热变硬。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡胸肉丁",
      "ratio": "200g 虾仁 ≈ 200g 鸡丁",
      "note": "鸡丁需先滑炒至全熟再回锅。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4 个鸡蛋 ≈ 3 个鸭蛋",
      "note": "鸭蛋腥味略重，白胡椒加到 2g。"
    }
  ],
  "variations": [
    "家庭简化版：虾仁与蛋液直接同炒，省一步但嫩度略差。",
    "茶餐厅版：加 20ml 淡奶油与 3g 糖，做成奶香滑蛋虾仁。"
  ],
  "serving_suggestion": "配白米饭或作为早餐吐司配料；粤式茶餐厅多配一碗白饭。",
  "storage": "现做现吃，冷藏后蛋会变硬出水，不建议留存。",
