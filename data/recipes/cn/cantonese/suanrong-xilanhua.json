          "name_en": "broccoli",
          "amount": 400,
          "unit": "g",
          "note": "掰成均匀小朵",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 30,
          "unit": "g",
          "note": "一半切末一半拍碎",
          "optional": false
        },
        {
          "name": "小米辣",
          "name_en": "bird's eye chili",
          "amount": 5,
          "unit": "g",
          "note": "切圈，可省",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "焯水与调味各半",
          "optional": false
        },
        {
          "name": "蚝油",
          "name_en": "oyster sauce",
          "amount": 12,
          "unit": "g",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 5,
          "unit": "g",
          "note": "调薄芡",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "炒蒜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "西兰花掰成小朵，用淡盐水浸泡 8 分钟后冲洗干净，沥干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐水浸泡能带出花蕾里的杂质。",
      "visual_cue": "花朵紧实、沥水干爽"
    },
    {
      "n": 2,
      "text": "锅中水烧开加 2g 盐，下西兰花焯 90 秒，捞出立即过冷水。",
      "time_min": 3,
      "heat": "大火",
      "tip": "过冷水是保持翠绿的唯一办法。",
      "visual_cue": "颜色转深绿、梗部半透明"
    },
    {
      "n": 3,
      "text": "大蒜切末、小米辣切圈，玉米淀粉加 25ml 清水调成水淀粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜末现切现用，久放会发苦。",
      "visual_cue": "蒜末细匀、芡水无颗粒"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒 20ml 植物油，小火下蒜末与小米辣圈炒出香味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末小火炒，火大立刻焦苦。",
      "visual_cue": "蒜末金黄、香味扑鼻"
    },
    {
      "n": 5,
      "text": "转大火下西兰花翻炒 1 分钟，加蚝油与剩余 2g 盐，淋水淀粉翻匀收亮出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "芡汁一挂就停火，久炒会出水。",
      "visual_cue": "菜身油亮、芡汁薄薄挂住"
    }
  ],
  "tips": [
    "焯水时加少许盐，菜梗更容易吸味。",
    "蒜末分两次下锅，前一半炒香后一半生拌。",
    "出锅前再淋薄芡，酱汁才挂得住菜身。"
  ],
  "common_mistakes": [
    "焯水后不过冷水，西兰花很快发黄变软。",
    "蒜末用大火爆炒，几秒钟就炒成焦黑发苦。",
    "西兰花在锅里炒太久，花朵散碎并大量出水。"
  ],
  "substitutions": [
    {
      "original": "西兰花",
      "substitute": "菜心",
      "ratio": "400g 对 400g",
      "note": "菜心梗粗，焯水加 30 秒。"
    },
    {
      "original": "蚝油",
      "substitute": "生抽",
      "ratio": "12g 对 10ml",
      "note": "咸味略高，盐减 1g。"
    }
  ],
  "variations": [
    "蒜蓉蒸版：焯好后铺蒜末上锅蒸 4 分钟，清甜少油。",
    "加虾版：加 100g 虾仁同炒，鲜味更足。"
  ],
  "serving_suggestion": "作为荤菜的配菜上桌，清爽解腻。",
  "storage": "冷藏 1 天，复热用大火快炒 1 分钟。",
