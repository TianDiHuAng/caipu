    "炒锅",
    "刀",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘净后加清水浸泡二十分钟，捞出沥干，米粒吸足水煮出来才不夹生。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡米的水不要用来煮饭，倒掉换清水，饭味更清。",
      "visual_cue": "米粒饱满，指压即碎。"
    },
    {
      "n": 2,
      "text": "五花肉连皮切成两毫米薄片，加生抽、料酒、白糖和玉米淀粉抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "花腩带皮切薄片，蒸后皮软肉香，太厚不易熟。",
      "visual_cue": "肉片薄透，表面挂浆发亮。"
    },
    {
      "n": 3,
      "text": "咸鱼去骨切成小粒，用少量花生油小火煎到两面微黄、香气出来，盛出备用。",
      "time_min": 6,
      "heat": "小火",
      "tip": "咸鱼先煎能去腥提香，不煎直接蒸出来味道发闷。",
      "visual_cue": "咸鱼粒边缘焦黄，咸香浓烈。"
    },
    {
      "n": 4,
      "text": "砂锅刷花生油，下泡好的米与清水，大火煮到水收干、饭面冒细孔。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水刚好没过米一指节，水多饭烂，锅巴也结不成。",
      "visual_cue": "水面收干，饭面布满小孔。"
    },
    {
      "n": 5,
      "text": "把腌好的花腩片铺在饭面，撒上煎过的咸鱼粒和姜丝，沿锅边淋油盖盖小火焗十四分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "花腩铺平别叠太厚，蒸汽透不过去会有生肉。",
      "visual_cue": "油脂渗入饭面，锅边冒细密热气。"
    },
    {
      "n": 6,
      "text": "生抽、老抽、白糖加两勺清水小火煮开成豉油，开盖淋在饭面，撒小葱粒。",
      "time_min": 4,
      "heat": "小火",
      "tip": "咸鱼已经够咸，豉油要少淋，先尝后加。",
      "visual_cue": "豉油渗进饭粒，葱粒翠绿。"
    },
    {
      "n": 7,
      "text": "关火静置三分钟再拌开，让锅巴吸足豉油，趁热连锅上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置能让锅巴与肉汁融合，拌早了锅巴发软。",
      "visual_cue": "锅底锅巴金黄整片，饭粒油亮。"
    }
  ],
  "tips": [
    "咸鱼选梅香咸鱼，香气更足，用量要少，否则整锅过咸。",
    "花腩选肥瘦相间的下五花，蒸后油润不柴。",
    "锅底刷油宁多勿少，锅巴才结得整片不粘。"
  ],
  "common_mistakes": [
    "咸鱼不煎直接下锅，腥味重，咸味也散不开。",
    "花腩切得太厚，焗的时间不够，中间还是生的。",
    "豉油按常规量淋，加上咸鱼后整锅咸得吃不下。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪肩肉",
      "ratio": "1:1",
      "note": "梅花肉瘦一些，需多腌五分钟，焗的时间缩短两分钟。"
    },
    {
      "original": "咸鱼",
      "substitute": "虾米",
      "ratio": "60克:40克",
      "note": "不吃咸鱼可用虾米代替，鲜味近似但不咸，豉油可正常加。"
    }
  ],
  "variations": [
    "有的店家把咸鱼与花腩先上锅蒸五分钟再铺到饭上，肉更嫩、咸味更匀。",
    "中山一带会加一勺磨豉酱同焗，酱香更厚。"
  ],
  "serving_suggestion": "连锅上桌淋豉油，拌开后配一碗例汤；锅巴铲出来单独吃最香。",
  "storage": "现做现吃，冷藏不超过一日；复热盖盖小火焖五分钟，中途淋一勺清水。",
