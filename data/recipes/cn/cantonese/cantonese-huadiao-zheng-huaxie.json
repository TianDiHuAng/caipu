  "equipment": [
    "蒸锅",
    "蟹刷",
    "浅盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花蟹用刷子刷净壳缝与蟹脚绒毛，掀壳去净鳃和胃囊。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蟹鳃和蟹胃不能吃，掀壳后一次去净。",
      "visual_cue": "蟹身干净、鳃部掏空"
    },
    {
      "n": 2,
      "text": "把蟹身斩成四块，蟹钳用刀背轻拍出裂缝，方便入味也好剥。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蟹钳拍裂但不拍碎，蒸后不流黄。",
      "visual_cue": "蟹块带壳完整、钳有裂口"
    },
    {
      "n": 3,
      "text": "蟹块平铺在浅盘里，下面垫姜片和葱段，表面薄撒盐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "垫姜葱让蒸汽循环，蟹肉不泡在汤水里。",
      "visual_cue": "蟹块平铺、不叠压"
    },
    {
      "n": 4,
      "text": "沿盘边淋入花雕酒，蟹壳盖回蟹身上摆好造型。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酒沿盘边淋，直接浇蟹肉会冲淡鲜味。",
      "visual_cue": "酒香散出、壳位还原"
    },
    {
      "n": 5,
      "text": "蒸锅上汽后大火蒸十二分钟，关火焖两分钟再开盖。",
      "time_min": 14,
      "heat": "大火",
      "tip": "上汽后才放蟹，蒸出的肉才紧实弹牙。",
      "visual_cue": "蟹壳转红、蒸汽带酒香"
    },
    {
      "n": 6,
      "text": "撒上姜丝葱丝，淋上烧到冒烟的植物油激香，配蒸鱼豉油蘸食。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油要烧到冒烟再淋，葱姜香气才爆得出来。",
      "visual_cue": "葱丝微卷、油香扑鼻"
    }
  ],
  "tips": [
    "花蟹选腹部饱满、掂着压手的，肉才厚；死蟹一律不要。",
    "蒸的时间按大小调整，一斤左右十二分钟即可，久了肉缩。",
    "花雕酒三年陈的就够香，不必用太贵的年份酒。"
  ],
  "common_mistakes": [
    "冷水上锅蒸，蟹肉出水、口感发柴。",
    "蒸过头，蟹肉收缩贴壳，剥出来只剩一丝。",
    "没去掉蟹鳃就上桌，腥味重且不卫生。"
  ],
  "substitutions": [
    {
      "original": "花蟹",
      "substitute": "青蟹",
      "ratio": "600g 对 600g",
      "note": "青蟹壳硬肉厚，蒸制时间加三分钟。"
    },
    {
      "original": "花雕酒",
      "substitute": "黄酒",
      "ratio": "30ml 对 30ml",
      "note": "香气略淡，可加一片陈皮增香。"
    }
  ],
  "variations": [
    "加一勺虾酱同蒸，做成咸香的虾酱蒸蟹。",
    "蒸好后放入冰水急冷，做成潮式冻蟹。"
  ],
  "serving_suggestion": "原盘上桌，配姜醋汁或蒸鱼豉油，趁热拆食。",
  "storage": "当天吃完最好，冷藏不超过一天，复蒸五分钟即可。",
