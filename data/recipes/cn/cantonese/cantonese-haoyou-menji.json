  "steps": [
    {
      "n": 1,
      "text": "鸡腿剁成三厘米见方的块，冲净血水后沥干，加料酒和盐抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌的时候抓出黏性，焖出来肉更紧实入味。",
      "visual_cue": "鸡块表面微黏，颜色转浅。"
    },
    {
      "n": 2,
      "text": "炒锅放植物油烧到六成热，鸡块皮朝下摆入锅中，中火煎到两面金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "先煎定形再翻动，肉汁锁得住，皮也香。",
      "visual_cue": "鸡皮金黄起脆，锅中有亮油。"
    },
    {
      "n": 3,
      "text": "下姜片和大葱段煸香，加蚝油、生抽、老抽和冰糖翻炒，让鸡块均匀上色。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蚝油后下，久炒会焦糊发苦，甜味也变酸。",
      "visual_cue": "鸡块挂上酱色，香气升腾。"
    },
    {
      "n": 4,
      "text": "加清水没过鸡块大半，烧开后转小火加盖焖十八分钟，中途翻一次。",
      "time_min": 22,
      "heat": "小火",
      "tip": "水量只到鸡块大半，多了收不干，少了易糊。",
      "visual_cue": "汤汁微滚，鸡皮油亮。"
    },
    {
      "n": 5,
      "text": "玉米淀粉加水调成薄芡，淋入锅中推匀，让汤汁裹住鸡块，淋香油起锅。",
      "time_min": 4,
      "heat": "中火",
      "tip": "芡要薄，挂得住就停，厚了就成糊。",
      "visual_cue": "汤汁浓亮，紧裹鸡块。"
    },
    {
      "n": 6,
      "text": "盛入砂锅或深盘，撒大葱段，趁热配白饭上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "砂锅提前烧热，上桌还能保持咕嘟冒泡的状态。",
      "visual_cue": "汤汁微沸，葱段翠绿。"
    }
  ],
  "tips": [
    "蚝油选鲜蚝汁含量高的，颜色红亮、咸鲜自然。",
    "鸡腿带骨焖比去骨香，骨头的鲜味能进汤汁。",
    "冰糖只放一点，目的是提亮，别做成甜口。"
  ],
  "common_mistakes": [
    "蚝油一开始就下锅猛炒，焦糊发苦，整锅带苦味。",
    "水加太多，收汁时间长，鸡肉老得咬不动。",
    "芡勾得太厚，凉了结成块，口感发黏。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "1:1.1",
      "note": "鸡翅焖十五分钟即可，胶质多、汤汁更稠。"
    },
    {
      "original": "蚝油",
      "substitute": "生抽",
      "ratio": "40毫升:30毫升",
      "note": "缺蚝油时以生抽加少许白糖代替，鲜味略薄但可应急。"
    }
  ],
  "variations": [
    "有的做法加几朵香菇同焖，菌香与蚝油很配，汤汁更鲜。",
    "澳门式做法会加一小勺咖喱粉，风味近似葡国鸡。"
  ],
  "serving_suggestion": "连汁盛盘配白饭，汁多可拌面；配一碟焯青菜平衡油腻。",
  "storage": "冷藏可存两日，冷冻一周；复热加少量清水小火焖五分钟。",
