  "equipment": [
    "平底锅",
    "炒锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加清水与少许盐调成稀面糊，静置二十分钟醒浆。",
      "time_min": 25,
      "heat": "无火",
      "tip": "面糊要稀到能流动，皮才薄。",
      "visual_cue": "面糊顺滑无颗粒、能挂薄层"
    },
    {
      "n": 2,
      "text": "平底锅小火加热，抹一勺面糊摊成薄圆皮，十秒后揭起。",
      "time_min": 10,
      "heat": "小火",
      "tip": "锅温别高，皮才不起泡发脆。",
      "visual_cue": "薄皮透光、边缘翘起易揭"
    },
    {
      "n": 3,
      "text": "大白菜与胡萝卜切细丝，香菇切丝，小葱切葱花备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丝切得细，馅才好包不戳破皮。",
      "visual_cue": "各料丝细均匀、水分控干"
    },
    {
      "n": 4,
      "text": "炒锅下少量植物油，把猪肉末用中火煸炒到变色散开。",
      "time_min": 3,
      "heat": "中火",
      "tip": "肉末炒散，馅才不结块。",
      "visual_cue": "肉末粒粒分明、微微出油"
    },
    {
      "n": 5,
      "text": "下香菇丝、胡萝卜丝与白菜丝翻炒三分钟至变软出水。",
      "time_min": 4,
      "heat": "中火",
      "tip": "白菜出水多，要炒到收干。",
      "visual_cue": "蔬菜变软、锅内无积水"
    },
    {
      "n": 6,
      "text": "加生抽、蚝油、盐与白糖炒匀，淋淀粉水勾芡后盛出放凉。",
      "time_min": 3,
      "heat": "中火",
      "tip": "馅必须放凉再包，热馅会泡烂皮。",
      "visual_cue": "馅料黏稠不流汤、温度不烫手"
    },
    {
      "n": 7,
      "text": "薄面皮铺平放一勺馅，两头折起后卷紧，边缘抹淀粉水封口。",
      "time_min": 12,
      "heat": "无火",
      "tip": "卷紧不留空气，炸时才不鼓包。",
      "visual_cue": "卷体紧实、封口粘牢"
    },
    {
      "n": 8,
      "text": "锅中倒植物油烧到六成热，春卷下锅中小火炸到金黄。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "下锅先别翻动，定型后再拨。",
      "visual_cue": "外皮金黄、浮起冒细泡"
    },
    {
      "n": 9,
      "text": "捞出沥干油分，稍微放凉后切成小段装盘即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃最脆，放久会返软。",
      "visual_cue": "外皮酥脆、断面层次清晰"
    }
  ],
  "tips": [
    "薄面皮可以买现成的，省去摊皮这一步。",
    "馅料一定要收干汤汁，否则炸时爆皮。",
    "炸好放在厨房纸上吸油，口感更清爽。"
  ],
  "common_mistakes": [
    "馅带着汤汁就包，下油锅立刻炸开溅油。",
    "春卷卷得太松，炸出来空心不饱满。",
    "油温太低就下锅，春卷吸油变得软塌塌。"
  ],
  "substitutions": [
    {
      "original": "大白菜",
      "substitute": "卷心菜",
      "ratio": "200g 对 200g",
      "note": "出水少些，炒制时间可减一分钟。"
    },
    {
      "original": "猪肉末",
      "substitute": "虾仁",
      "ratio": "150g 对 150g",
      "note": "切丁后炒至变色，鲜味更足。"
    }
  ],
  "variations": [
    "馅料里加一把泡软的粉丝，吸汁后更饱满。",
    "包好后刷一层蛋液再炸，颜色更金黄。"
  ],
  "serving_suggestion": "趁热蘸甜酸酱吃，配一壶热茶最解腻。",
  "storage": "生坯冷冻可放半个月，熟品当天吃完。",
