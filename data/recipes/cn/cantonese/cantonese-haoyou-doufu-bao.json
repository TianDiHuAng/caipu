  "equipment": [
    "砂锅",
    "平底锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成两厘米厚、五厘米见方的片，用厨房纸吸干表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水分吸干才不会粘锅，也不容易煎碎。",
      "visual_cue": "豆腐片表面干爽，边角完整"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油烧热，下豆腐片中火煎到两面金黄后盛出。",
      "time_min": 10,
      "heat": "中火",
      "tip": "豆腐表面的水分一定要吸干，不然下锅既粘锅又溅油，很难煎成形。",
      "visual_cue": "两面结起金黄硬壳，片形挺立"
    },
    {
      "n": 3,
      "text": "砂锅中留少许底油，下姜片、蒜与香菇片煸香，加虾仁炒到变色。",
      "time_min": 4,
      "heat": "中火",
      "tip": "砂锅要小火预热后再下油，骤热容易裂。",
      "visual_cue": "香菇软身出汁，虾仁转红卷曲"
    },
    {
      "n": 4,
      "text": "烹入黄酒，加蚝油、生抽、白糖与半碗清水烧开，铺入煎好的豆腐。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆腐铺在上面别翻动，靠汤汁浸透更完整。",
      "visual_cue": "汤汁没过豆腐一半，翻滚冒泡"
    },
    {
      "n": 5,
      "text": "加盖小火焖八分钟，让豆腐吸饱蚝油汁，中途轻推锅底防粘。",
      "time_min": 8,
      "heat": "小火",
      "tip": "焖的时候只推不翻，豆腐才保持整片。",
      "visual_cue": "豆腐颜色转深，汤汁减至一半"
    },
    {
      "n": 6,
      "text": "淀粉调水勾薄芡，撒葱段淋香油，连砂锅上桌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芡要薄，砂锅余温还会继续收稠，厚了就糊嘴。",
      "visual_cue": "汤汁浓亮挂勺，葱段翠绿点缀"
    }
  ],
  "tips": [
    "用老豆腐更经得起煎焖，嫩豆腐一碰就散。",
    "砂锅上桌前先垫一块布，避免骤冷炸裂。",
    "加几片腊肠或烧肉同焖，油脂渗进豆腐，香得离谱。"
  ],
  "common_mistakes": [
    "豆腐不吸干水就下锅煎，油花四溅还粘得满锅都是。",
    "用大火焖，汤汁干得太快，豆腐外层咸内里淡。",
    "煎好的豆腐在锅里反复翻炒，全碎成渣。"
  ],
  "substitutions": [
    {
      "original": "老豆腐",
      "substitute": "油豆腐",
      "ratio": "400克:300克",
      "note": "油豆腐吸汁更强，焖的时间减三分钟。"
    },
    {
      "original": "虾仁",
      "substitute": "干贝",
      "ratio": "80克:25克",
      "note": "干贝须提前蒸软撕丝。"
    }
  ],
  "variations": [
    "改用柱侯酱代替蚝油，风味更浓，是粤式煲仔的另一种路子。",
    "加一把粉丝垫底，吸饱汤汁后比豆腐还抢手。"
  ],
  "serving_suggestion": "连砂锅端上桌，趁滚烫时舀出，配白饭最下饭。",
  "storage": "冷藏可存两天，复热须加两勺水小火焖五分钟，微波会令豆腐发硬。",
