  "equipment": [
    "炒锅",
    "砂锅",
    "刀",
    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸭块冲净血水后冷水下锅，加一半料酒焯五分钟，捞出冲净浮沫沥干。",
      "time_min": 12,
      "heat": "中火",
      "tip": "焯水去净血沫，鸭肉才不腥，汤色也清。",
      "visual_cue": "浮沫结块浮起，鸭皮收紧。"
    },
    {
      "n": 2,
      "text": "嫩姜刮去外皮切成两毫米厚片，用刀背轻拍一下，让姜的纤维松散更易出味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "姜片拍松再焖，辛香渗进鸭肉，比切片更入味。",
      "visual_cue": "姜片薄厚均匀，边缘微裂。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧热，下姜片小火煸到边缘卷起发黄，盛出一半留作后用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "姜要煸到卷边才够香，生薑片下锅焖出来辛辣刺口。",
      "visual_cue": "姜片卷边金黄，油色转黄。"
    },
    {
      "n": 4,
      "text": "下鸭块中火煸炒到表皮收紧出油，加生抽、老抽、蚝油和冰糖翻炒上色。",
      "time_min": 10,
      "heat": "中火",
      "tip": "鸭皮朝下先煸，逼出油脂后不腻，颜色也更亮。",
      "visual_cue": "鸭块表面金黄，锅里见亮油。"
    },
    {
      "n": 5,
      "text": "淋剩余料酒和米醋，加清水没过大半，转入砂锅小火焖三十五分钟。",
      "time_min": 37,
      "heat": "小火",
      "tip": "米醋早放能软化鸭肉纤维，焖出来更酥烂。",
      "visual_cue": "汤汁微滚，鸭块沉底。"
    },
    {
      "n": 6,
      "text": "开盖放回留出的姜片和大葱段，转中火收汁到浓稠挂勺，尝味补盐即可上桌。",
      "time_min": 10,
      "heat": "中火",
      "tip": "后放的姜片保留脆嫩口感，吃着辛香解腻。",
      "visual_cue": "汤汁红亮浓稠，鸭皮油润。"
    }
  ],
  "tips": [
    "鸭选嫩鸭，老鸭适合煲汤，焖出来肉质太韧。",
    "嫩姜用量要足，姜比鸭好吃是这道菜的常态。",
    "米醋别省，酸味能压住鸭的腥气，还能让肉更快酥。"
  ],
  "common_mistakes": [
    "鸭块不焯水直接焖，腥味重、汤汁浑。",
    "姜片煸得不够，成品辛辣冲口，香气不足。",
    "火太大汤汁早干，鸭肉还没酥就糊锅。"
  ],
  "substitutions": [
    {
      "original": "鸭",
      "substitute": "鸡腿肉",
      "ratio": "1:0.9",
      "note": "换成鸡腿焖二十分钟即可，腥味轻，酸姜味更突出。"
    },
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "1:1",
      "note": "香醋色深味醇，用量减五毫升，免得盖住姜香。"
    }
  ],
  "variations": [
    "广东家庭常加几块柱侯酱同焖，酱香更厚，颜色也更深。",
    "有的做法把嫩姜先用盐腌十分钟挤去辛辣水，再下锅焖，口感更温和。"
  ],
  "serving_suggestion": "砂锅直接上桌，配白饭最好；剩下的汤汁拌面或煮米粉都香。",
  "storage": "冷藏可存三日，冷冻两周；复热加少量清水小火焖十分钟，别用大火收干。",
