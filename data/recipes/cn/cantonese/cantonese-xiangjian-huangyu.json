  "equipment": [
    "平底锅",
    "厨房纸",
    "铲子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄鱼去鳞去内脏洗净，撕掉腹内黑膜，用厨房纸把里外彻底擦干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黑膜是腥味来源，鱼身擦干才不粘锅。",
      "visual_cue": "鱼身干爽、腹内无黑膜"
    },
    {
      "n": 2,
      "text": "鱼身两面各划两刀，抹上盐、料酒和白胡椒粉，腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "划刀让盐味进到肉里，也更容易煎透。",
      "visual_cue": "鱼身刀口整齐、表面微湿"
    },
    {
      "n": 3,
      "text": "腌好的鱼用厨房纸再吸一次水，两面薄薄拍一层面粉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拍粉能锁住水分，煎出的皮更脆更完整。",
      "visual_cue": "鱼身覆薄粉、不见干粉块"
    },
    {
      "n": 4,
      "text": "平底锅放植物油烧到六成热，下姜片擦锅后放入黄鱼。",
      "time_min": 2,
      "heat": "中火",
      "tip": "姜片擦锅底形成油膜，鱼皮不容易破。",
      "visual_cue": "油面微波动、姜片边缘起泡"
    },
    {
      "n": 5,
      "text": "中小火煎五分钟至底面金黄定型，用铲子整条翻面再煎四分钟。",
      "time_min": 9,
      "heat": "中小火",
      "tip": "煎的过程中别急着翻，等皮结痂自然离锅。",
      "visual_cue": "鱼皮金黄完整、边缘酥脆"
    },
    {
      "n": 6,
      "text": "放葱段在锅边煎出香味，关火把鱼盛盘，淋锅里的热油。",
      "time_min": 2,
      "heat": "小火",
      "tip": "葱段最后放，煎久了会焦苦。",
      "visual_cue": "葱段微焦、鱼身油亮"
    }
  ],
  "tips": [
    "黄鱼选眼睛清亮、鳃色鲜红的，肉质才紧实。",
    "鱼身拍粉要薄，粉厚了会吸油发腻。",
    "小鱼煎比大鱼好掌握，一斤左右的鱼最合适。"
  ],
  "common_mistakes": [
    "鱼身没擦干就下锅，油花四溅还粘掉整张皮。",
    "火太大急着翻面，鱼皮破成一块一块。",
    "盐腌时间太久，鱼肉失水，成品又咸又柴。"
  ],
  "substitutions": [
    {
      "original": "黄鱼",
      "substitute": "鲳鱼",
      "ratio": "500g 对 500g",
      "note": "鲳鱼肉厚，煎的时间每面加一分钟。"
    },
    {
      "original": "面粉",
      "substitute": "淀粉",
      "ratio": "30g 对 30g",
      "note": "淀粉煎后更脆，但容易脱糊。"
    }
  ],
  "variations": [
    "煎好后淋一勺豉油和热油，做成豉油煎黄鱼。",
    "加姜葱和少许水焖两分钟，做成姜葱焖黄鱼。"
  ],
  "serving_suggestion": "配白粥或米饭，挤几滴柠檬汁更鲜。",
  "storage": "冷藏一天，复热用平底锅小火回煎三分钟恢复脆皮。",
