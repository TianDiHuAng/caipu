  "equipment": [
    "炒锅",
    "硬毛刷",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蟹用硬毛刷在流水下刷洗蟹壳、蟹脚关节与腹部。",
      "time_min": 10,
      "heat": "无火",
      "tip": "关节处泥沙最多，要重点刷。",
      "visual_cue": "蟹壳洁净、无泥腥味"
    },
    {
      "n": 2,
      "text": "掀开蟹盖去掉蟹腮与胃囊，斩成四块，蟹钳用刀背拍裂。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蟹腮不能吃，务必去净。",
      "visual_cue": "蟹块整齐、蟹钳裂开"
    },
    {
      "n": 3,
      "text": "蟹块切口处拍上一层玉米淀粉，防止煎时肉汁流失。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拍粉封口，蟹肉才不散。",
      "visual_cue": "切口均匀裹粉、不见湿面"
    },
    {
      "n": 4,
      "text": "炒锅倒入植物油烧到六成热，蟹块切口朝下煎到定型变红。",
      "time_min": 4,
      "heat": "中火",
      "tip": "切口先煎，锁住蟹肉鲜汁。",
      "visual_cue": "切面金黄、蟹壳转红"
    },
    {
      "n": 5,
      "text": "把蟹块推到锅边，下姜片、蒜碎与葱白段小火煸香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "姜葱要多，才能压住蟹的寒气。",
      "visual_cue": "姜片微卷、葱香散出"
    },
    {
      "n": 6,
      "text": "沿锅边淋料酒爆香，加生抽、蚝油、白糖与清水。",
      "time_min": 2,
      "heat": "大火",
      "tip": "沿锅边淋酒，香气才挥发得开。",
      "visual_cue": "酒气腾起、汤汁微沸"
    },
    {
      "n": 7,
      "text": "盖上锅盖用中火焖三分钟，让蟹肉彻底熟透并吸收姜葱味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "焖到蟹壳全红，蟹肉才熟。",
      "visual_cue": "蟹壳通红、锅盖内布满水汽"
    },
    {
      "n": 8,
      "text": "开盖撒盐与白胡椒，下葱绿段转大火翻炒收汁。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱绿最后下，香气最鲜。",
      "visual_cue": "汤汁收浓、葱段翠绿"
    },
    {
      "n": 9,
      "text": "汁水均匀裹住蟹块后立刻出锅，连浓汁一起装盘上桌。",
      "time_min": 1,
      "heat": "大火",
      "tip": "汁别收太干，拌饭最香。",
      "visual_cue": "蟹块油亮挂汁、盘底少许浓汁"
    }
  ],
  "tips": [
    "选鲜活的花蟹或梭子蟹，肉质才紧实鲜甜。",
    "姜片切得厚一些，久炒也不容易焦糊。",
    "蟹钳拍裂更容易入味，也方便吃。"
  ],
  "common_mistakes": [
    "蟹块不拍粉就煎，蟹肉遇热收缩散开。",
    "姜葱炒糊了才下蟹，整锅带苦味。",
    "焖的时间太短，蟹肉中心还带水。"
  ],
  "substitutions": [
    {
      "original": "蟹",
      "substitute": "虾",
      "ratio": "700g 对 600g",
      "note": "炒制时间缩短两分钟。"
    },
    {
      "original": "大葱",
      "substitute": "小葱",
      "ratio": "60g 对 50g",
      "note": "香气更清，需全部最后下。"
    }
  ],
  "variations": [
    "加一勺咖喱粉同炒，就是南洋风味的咖喱蟹。",
    "出锅前淋一个蛋液，汁更浓稠挂口。"
  ],
  "serving_suggestion": "趁热上手吃，最后用浓汁拌一碗白饭收尾。",
  "storage": "当天吃完最好，隔夜蟹肉会发腥且口感变柴。",
