  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "红豆",
          "name_en": "adzuki bean",
          "amount": 250,
          "unit": "g",
          "note": "洗净浸泡",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "莲子",
          "name_en": "lotus seeds",
          "amount": 40,
          "unit": "g",
          "note": "去芯",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "冰糖",
          "name_en": "rock sugar",
          "amount": 80,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提甜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "汤勺",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆 250g 淘洗两遍，用清水浸泡 4 小时至豆粒明显膨胀。",
      "time_min": 15,
      "heat": "无火",
      "tip": "泡透的红豆更容易起沙。",
      "visual_cue": "红豆鼓起、表皮微皱"
    },
    {
      "n": 2,
      "text": "泡好的红豆连水倒入汤锅，补足 1500ml 清水，大火煮开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水一次加足，中途加水会冲淡豆沙。",
      "visual_cue": "水面沸腾、红豆上下翻滚"
    },
    {
      "n": 3,
      "text": "转小火加盖煮 45 分钟，其间搅动三次，至红豆开花软烂。",
      "time_min": 46,
      "heat": "小火",
      "tip": "小火慢煮，豆沙才绵密。",
      "visual_cue": "红豆裂开、汤色深红"
    },
    {
      "n": 4,
      "text": "加入 40g 去芯莲子同煮 20 分钟，至莲子软糯但外形完整。",
      "time_min": 21,
      "heat": "小火",
      "tip": "莲子后放，久煮会散成糊。",
      "visual_cue": "莲子软糯、轻压即碎"
    },
    {
      "n": 5,
      "text": "放入 80g 冰糖与 1g 盐，小火搅至糖完全溶化，再煮 5 分钟收浓。",
      "time_min": 7,
      "heat": "小火",
      "tip": "一小撮盐能把甜味托起来。",
      "visual_cue": "汤汁浓稠、豆沙起沙"
    }
  ],
  "tips": [
    "红豆提前泡 4 小时，煮出来才容易起沙。",
    "冰糖后放，早放会让红豆不容易煮烂。",
    "一小撮盐是甜汤的提味秘诀，别省略。"
  ],
  "common_mistakes": [
    "红豆不泡直接煮，煮一小时仍有硬芯。",
    "糖和豆一起下锅，豆皮变硬煮不烂。",
    "全程大火翻滚，红豆全散成糊没有颗粒。"
  ],
  "substitutions": [
    {
      "original": "冰糖",
      "substitute": "红糖",
      "ratio": "80g 对 75g",
      "note": "颜色更深，带焦糖香。"
    },
    {
      "original": "莲子",
      "substitute": "百合",
      "ratio": "40g 对 30g",
      "note": "煮 12 分钟即可。"
    }
  ],
  "variations": [
    "陈皮版：加 3g 泡软陈皮同煮，香气更古早。",
    "椰汁版：盛碗后淋 30ml 椰浆。"
  ],
  "serving_suggestion": "温热或冷藏后食用，夏天可加碎冰。",
  "storage": "冷藏 3 天，复热时加少量水搅匀。",
