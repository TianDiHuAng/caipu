{
  "schema_version": "1.0",
  "content_version": 1,
  "id": "cantonese-xia-ren-zheng-doufu",
  "name": {
    "zh": "粤式虾仁蒸豆腐",
    "en": "Cantonese Steamed Tofu with Shrimp",
    "original": "虾仁蒸豆腐"
  },
  "cuisine": {
    "region": "cn",
    "style": "cantonese"
  },
  "category": [
    "main-tofu"
  ],
  "difficulty": 1,
  "time": {
    "prep_min": 15,
    "cook_min": 10,
    "total_min": 25
  },
  "servings": 3,
  "flavor": [
    "salty",
    "savory"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "板豆腐",
          "name_en": "firm tofu",
          "amount": 400,
          "unit": "g",
          "note": "选卤水点的，压得住蒸汽不出水",
          "optional": false
        },
        {
          "name": "虾仁",
          "name_en": "peeled shrimp",
          "amount": 180,
          "unit": "g",
          "note": "中等个头，挑掉背上的黑线",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 10,
          "unit": "g",
          "note": "切细丝铺在虾仁上",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切葱花，最后撒",
          "optional": false
        },
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 60,
          "unit": "ml",
          "note": "调汁用，没有就换清水加一点生抽",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 15,
          "unit": "ml",
          "note": "蒸好后再淋，香气不被蒸汽冲散",
          "optional": false
        },
        {
          "name": "蚝油",
          "name_en": "oyster sauce",
          "amount": 10,
          "unit": "ml",
          "note": "调汁里加，让咸味更厚",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "腌虾仁用一点点",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 10,
          "unit": "ml",
          "note": "烧热后泼在葱花上",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "深盘",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "板豆腐横刀片成两片，再切成四厘米见方的块，用厨房纸吸干表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐表面的水不吸干，蒸完盘底会积一层白汤。",
      "visual_cue": "豆腐块棱角完整，表面不见水光。"
    },
    {
      "n": 2,
      "text": "虾仁挑掉背上的黑线，用盐抓洗后冲净吸干，加一点生抽抓匀静置。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黑线不挑掉会带土腥味，蒸出来整盘都受影响。",
      "visual_cue": "虾仁表面发黏发亮，颜色由灰转透。"
    },
    {
      "n": 3,
      "text": "豆腐块平码在深盘里，虾仁一只只放在豆腐上，姜丝撒在虾仁表面。",
      "time_min": 2,
      "heat": "无火",
      "tip": "虾仁别堆两层，上层蒸不透下层已经老了。",
      "visual_cue": "每块豆腐上都稳稳放着一只虾仁。"
    },
    {
      "n": 4,
      "text": "蒸锅水大滚后上锅，盖严大火蒸六分钟，关火再虚蒸一分钟取出。",
      "time_min": 7,
      "heat": "大火",
      "tip": "水不开就上锅，豆腐会慢慢渗水，蒸出来发酸。",
      "visual_cue": "虾仁通体转为粉白色，豆腐边缘微微鼓起。"
    },
    {
      "n": 5,
      "text": "倒掉盘底蒸出的水，淋上烧热的蚝油高汤汁和生抽，把植物油烧到冒烟泼在葱花上。",
      "time_min": 2,
      "heat": "中火",
      "tip": "盘底的水一定倒掉，否则再好的调味也被稀释。",
      "visual_cue": "调汁在豆腐表面挂成一层薄亮的光，葱花被热油激得翠绿卷起。"
    }
  ],
  "tips": [
    "板豆腐先横刀片成两片再切块，厚度一致才同时蒸透。",
    "虾仁用厨房纸吸干再腌，带水下锅会蒸出一盘稀汤。",
    "蒸的时间按水开后算，六分钟足够，久了豆腐起蜂窝。"
  ],
  "common_mistakes": [
    "豆腐切好直接上锅，盘底积水把味道全冲淡，吃起来寡淡无味。",
    "虾仁和豆腐一起从头蒸到尾，虾老成橡皮，豆腐却还没热透。",
    "生抽提前淋上去蒸，蒸汽把酱香冲掉，只剩一股生酱味。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "蟹肉",
      "ratio": "180克:150克",
      "note": "蒸的时间缩短一分钟，蟹肉更易老。"
    },
    {
      "original": "蚝油",
      "substitute": "素蚝油",
      "ratio": "10毫升:10毫升",
      "note": "素食版本用，咸鲜稍淡可加一点生抽。"
    }
  ],
  "variations": [
    "豆腐块中间挖小窝，把虾仁嵌进去，蒸好后虾仁不会滑落。",
    "换成一半虾仁一半干贝丝，鲜味更浓，适合过节端上桌。"
  ],
  "serving_suggestion": "豆腐码在深盘里，虾仁铺在上面，淋两勺热过的调汁，配白饭或粥都合适，粤式家常菜的清淡代表。",
  "storage": "冷藏可放一天，回蒸三分钟即可，别用微波，豆腐会出水变渣。",
  "nutrition_estimate": {
    "basis": "按三人份估算",
    "calories_kcal": 268,
    "protein_g": 26,
