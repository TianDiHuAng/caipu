    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加姜片和料酒煮二十分钟，煮到筷子能插入皮内，捞出擦干。",
      "time_min": 24,
      "heat": "中火",
      "tip": "煮过再炸，皮才起泡，肉也不会外熟内生，这一步千万别省。",
      "visual_cue": "肉皮收紧，表面不见血水，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "用叉子在皮上扎满小孔，抹一层生抽晾十分钟，让皮面干爽好起泡。",
      "time_min": 12,
      "heat": "无火",
      "tip": "扎孔是起虎皮的关键，孔越密泡越细，火候和顺序都要留神。",
      "visual_cue": "皮面密布小孔，泛着酱色，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧至六成热，肉皮朝下入锅，立刻盖盖中火炸五分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅马上盖盖，防油溅也防皮粘锅，提前把配料备好再动手更稳。",
      "visual_cue": "锅内噼啪作响，皮面鼓起，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "炸好的肉块放进温水泡十分钟，泡到皮面起皱软透，取出切成半厘米厚的片。",
      "time_min": 12,
      "heat": "无火",
      "tip": "温水泡软，切片时皮不会碎裂脱落，这一步千万别省。",
      "visual_cue": "皮层起皱发软，切片平整，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "南乳连汁压成泥，加生抽、冰糖、料酒和清水调匀，和蒜末一起把肉片逐片沾匀酱汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "逐片沾汁比整块泡更均匀，蒸后咸度一致，火候和顺序都要留神。",
      "visual_cue": "肉片挂满红色酱汁，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "藕片铺在大碗底，肉片皮朝下码紧，淋上剩余酱汁，上汽蒸九十分钟后倒扣装盘。",
      "time_min": 92,
      "heat": "中火",
      "tip": "皮朝下码，倒扣后皮才朝上好看，提前把配料备好再动手更稳。",
      "visual_cue": "肥肉透明，倒扣成形不散，颜色和形态变化明显"
    }
  ],
  "tips": [
    "五花肉先煮再炸皮，皮面起泡后用温水泡软，切片时皮不会裂开。",
    "南乳要连汁一起压成泥，只用块不连汁会缺那一层发酵的鲜。",
    "扣肉要蒸足一个半小时，肥肉化开成透明才不腻口。"
  ],
  "common_mistakes": [
    "热油直接下带水的肉皮，油花四溅还炸不开花，皮面只有零星焦斑。",
    "切得太薄，蒸完肉片散开夹不起来，一夹就断。",
    "南乳放太多又加生抽，咸得盖住肉香，只能配大量米饭。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "梅头肉",
      "ratio": "700克:700克",
      "note": "脂肪少，蒸的时间减少二十分钟。"
    },
    {
      "original": "藕",
      "substitute": "芋头",
      "ratio": "300克:300克",
      "note": "芋头吸汁更绵，蒸后更粉糯。"
    }
  ],
  "variations": [
    "垫底的藕换成干豆角，豆角吸了南乳汁和肉油，比肉还抢手。",
    "加一勺玫瑰露酒同蒸，香气更复合，是顺德一带的做法。"
  ],
  "serving_suggestion": "倒扣在大盘里，把蒸汁勾薄芡淋上，配白饭和一碗清菜汤，肥瘦相间最下饭。",
  "storage": "冷藏可放三天，回热用蒸锅蒸二十分钟，微波会让肥肉出油变硬。",
