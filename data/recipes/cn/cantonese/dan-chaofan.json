        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜米饭用手抓散，把结块的米粒一一搓开备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "米粒搓散，炒出来才颗颗分明。",
      "visual_cue": "米粒松散、不见黏块"
    },
    {
      "n": 2,
      "text": "鸡蛋磕入碗中打散，加白胡椒搅匀；小葱切葱花，火腿切小丁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蛋液多打几下，炒出来更蓬松。",
      "visual_cue": "蛋液均匀、表面有细泡"
    },
    {
      "n": 3,
      "text": "炒锅烧热下植物油，油温升高后倒入蛋液快速划散。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅要够热，蛋液才不粘锅底。",
      "visual_cue": "蛋液鼓起大泡、凝固成块"
    },
    {
      "n": 4,
      "text": "鸡蛋炒到半凝固时立刻倒入米饭，转中火快速翻炒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋半熟时下饭，蛋香能裹住米粒。",
      "visual_cue": "蛋块与米粒混匀、锅内无水汽"
    },
    {
      "n": 5,
      "text": "加盐与生抽继续翻炒，把米粒炒到干爽跳动。",
      "time_min": 2,
      "heat": "中火",
      "tip": "盐沿锅边撒，才不会结块。",
      "visual_cue": "米粒在锅里弹跳、锅气上扬"
    },
    {
      "n": 6,
      "text": "下火腿丁与葱花大火翻炒半分钟，闻到葱香即可出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "葱花最后下，香气最鲜。",
      "visual_cue": "葱花翠绿、米粒金黄透亮"
    }
  ],
  "tips": [
    "冷饭提前冷藏一晚，水分少更好炒。",
    "锅要烧到冒烟再下油，炒饭才不粘。",
    "想更香的话，可以加一小勺猪油一起炒。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭炒，出锅黏成一团。",
    "锅里油放得太少，米粒粘锅底还炒不香。",
    "小火慢慢翻，饭被烘得干硬没有锅气。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "叉烧",
      "ratio": "60g 对 60g",
      "note": "更甜香，盐量略减。"
    },
    {
      "original": "鸡蛋",
      "substitute": "咸蛋黄",
      "ratio": "150g 对 90g",
      "note": "金沙口感，需压碎再炒。"
    }
  ],
  "variations": [
    "加一把青豆与玉米粒，颜色更好看。",
    "把火腿换成泡软的虾米，鲜味会更突出。"
  ],
  "serving_suggestion": "现炒现吃口感最好，配一碗清汤最合适。",
  "storage": "当天吃完最好，冷藏之后米粒会返硬回生。",
