  "equipment": [
    "平底锅",
    "厨房纸",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大明虾剪去虾枪虾须，从背部剪开一道口挑出虾线，冲洗干净后沥水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "背部剪开既方便挑虾线，也能让虾更快入味。",
      "visual_cue": "虾背开口整齐、虾线去净"
    },
    {
      "n": 2,
      "text": "用料酒、盐和姜丝抓匀腌十分钟，再用厨房纸把虾身水分彻底吸干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "下锅前一定吸干水，否则油花四溅还会脱壳。",
      "visual_cue": "虾壳干爽、不见汁水"
    },
    {
      "n": 3,
      "text": "平底锅烧热植物油，把虾一只只摆进锅里，中火先煎一面两分钟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "虾要平铺不叠放，受热均匀壳才会整只变脆。",
      "visual_cue": "虾壳转红、边缘微焦"
    },
    {
      "n": 4,
      "text": "翻面再煎两分钟，用锅铲轻轻压虾头，把虾头里的红油压出来。",
      "time_min": 2,
      "heat": "中火",
      "tip": "压一压虾头能逼出虾膏，煎出的油格外鲜香。",
      "visual_cue": "锅中油色泛红、虾膏溢出"
    },
    {
      "n": 5,
      "text": "撒入蒜片和葱段爆香，烹入生抽与白糖，晃动锅子让酱汁裹匀虾身。",
      "time_min": 1,
      "heat": "中大火",
      "tip": "酱汁不要多，晃锅裹匀就够，多了就成煮虾了。",
      "visual_cue": "虾壳油亮、均匀挂汁"
    },
    {
      "n": 6,
      "text": "收干汁水后撒上葱绿即可出锅，摆盘时虾头朝外码整齐。",
      "time_min": 1,
      "heat": "中火",
      "tip": "汁一收干就得离火，再煎虾肉就柴了。",
      "visual_cue": "锅底无流动汤汁、虾壳油亮"
    }
  ],
  "tips": [
    "大明虾壳厚难熟，煎的时候压一压虾身，虾肉才容易熟透。",
    "生抽与白糖的比例约二比一，成品咸中带甜最像粤式口味。",
    "虾忌久煎，全程不超过五分钟，肉一收紧就说明老了。"
  ],
  "common_mistakes": [
    "虾没擦干就下锅，油爆得满灶台，壳还不脆。",
    "只顾煎两面忘了压虾头，虾膏出不来，鲜味大打折扣。",
    "中途加了一大勺水去焖，虾肉软塌，失去干煎的干香。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "基围虾",
      "ratio": "400g 对 400g",
      "note": "基围虾个头小，煎制时间缩短到三分钟。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "5g 对 6g",
      "note": "先敲碎再下锅，更容易化开裹匀。"
    }
  ],
  "variations": [
    "起锅前沿锅边淋一勺豉油皇，颜色更亮更香。",
    "表面撒少许椒盐代替生抽，做成椒盐风味。"
  ],
  "serving_suggestion": "摆盘后撒葱绿，配柠檬角与白饭。",
  "storage": "冷藏可存一天，复热用平底锅干煎，别用微波炉。",
