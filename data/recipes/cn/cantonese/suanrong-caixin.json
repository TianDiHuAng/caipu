  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "菜心",
          "name_en": "choy sum",
          "amount": 400,
          "unit": "g",
          "note": "选梗细嫩的",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 25,
          "unit": "g",
          "note": "一半切末一半拍碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 25,
          "unit": "ml",
          "note": "炒制用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "分两次",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 8,
          "unit": "ml",
          "note": "沿锅边淋入",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 5,
          "unit": "ml",
          "note": "去青味",
          "optional": false
        },
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 40,
          "unit": "ml",
          "note": "保持翠绿与鲜味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "菜心剪去老根黄叶，粗梗从中间划一刀，用清水洗净沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "梗上划刀能让粗梗与叶同时熟。",
      "visual_cue": "菜心长短一致、梗部切开"
    },
    {
      "n": 2,
      "text": "锅中水烧开加 1g 盐与 5ml 植物油，菜心下锅焯 30 秒捞出过凉水。",
      "time_min": 3,
      "heat": "大火",
      "tip": "过凉水能锁住翠绿，也让口感更脆。",
      "visual_cue": "菜心梗变半透明、颜色碧绿"
    },
    {
      "n": 3,
      "text": "炒锅烧热下 20ml 植物油，小火把蒜末煸到微黄出香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜分两次用，一半炒香、一半最后下保留蒜辣香。",
      "visual_cue": "蒜末金黄、油面浮出蒜香"
    },
    {
      "n": 4,
      "text": "转大火下菜心快炒 40 秒，沿锅边淋料酒与生抽，加 2g 盐与高汤翻匀。",
      "time_min": 1,
      "heat": "大火",
      "tip": "全程大火短炒，锅气足才不出水。",
      "visual_cue": "菜叶油亮、锅中有爆响"
    },
    {
      "n": 5,
      "text": "下剩余拍碎的蒜，翻炒 10 秒立即出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "生蒜最后放，辣香更冲、层次更明显。",
      "visual_cue": "蒜香扑鼻、菜梗挺而不软"
    }
  ],
  "tips": [
    "菜心买回来先泡 10 分钟，泥沙多藏在叶柄内侧。",
    "没有高汤可用 40ml 清水加 3g 蚝油代替。",
    "炒锅一定要烧到冒烟再下油，避免蔬菜出水变黄。"
  ],
  "common_mistakes": [
    "小火慢炒，菜心出水变成「煮菜」，颜色发黄。",
    "蒜末一次性全下并用大火，几秒就发苦。",
    "焯水后不过凉水，余温让菜叶过熟发暗。"
  ],
  "substitutions": [
    {
      "original": "菜心",
      "substitute": "空心菜",
      "ratio": "400g 菜心 ≈ 400g 空心菜",
      "note": "空心菜更易熟，炒制时间减到 30 秒。"
    },
    {
      "original": "高汤",
      "substitute": "清水加蚝油",
      "ratio": "40ml 高汤 ≈ 40ml 清水 + 3g 蚝油",
      "note": "鲜味更直接，盐可减 1g。"
    }
  ],
  "variations": [
    "家庭简化版：省略焯水，直接大火炒 90 秒，口感更生脆。",
    "加料版：加 20g 泡软的虾米同炒，鲜味更足。"
  ],
  "serving_suggestion": "配白粥、烧鹅或煲仔饭，是粤式家常的标配青菜。",
  "storage": "冷藏 1 天，复热用大火快炒 20 秒，避免久热出水。",
