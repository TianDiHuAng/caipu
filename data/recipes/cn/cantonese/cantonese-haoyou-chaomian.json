  "equipment": [
    "炒锅",
    "锅铲",
    "漏勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面条放进沸水煮到八分熟，捞出过冷水沥干。",
      "time_min": 6,
      "heat": "大火",
      "tip": "面煮到中心还有一点硬芯，炒时才不会烂。",
      "visual_cue": "面条弹而不断，根根分开"
    },
    {
      "n": 2,
      "text": "沥干的面条拌少许植物油，抖散摊开放凉备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌油能防粘，炒的时候更容易抖散。",
      "visual_cue": "面条根根松散，不粘成块"
    },
    {
      "n": 3,
      "text": "豆芽掐去根部洗净，洋葱切细丝，小葱切段。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆芽去根口感才清爽，不去会有豆腥味。",
      "visual_cue": "豆芽白净，洋葱丝细长"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，下洋葱丝中火炒到变软出香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "锅要烧到冒烟再下油，面才不粘底。",
      "visual_cue": "洋葱丝透明发软，香气冒出"
    },
    {
      "n": 5,
      "text": "加豆芽翻炒半分钟，倒入面条淋生抽和蚝油抖炒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "面条用筷子抖散翻拌，比铲子更不容易断。",
      "visual_cue": "面条均匀上色，豆芽脆挺"
    },
    {
      "n": 6,
      "text": "顺锅边淋入清水，加盐炒匀，撒小葱段出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "沿锅边淋水产生蒸汽，面条更润不干。",
      "visual_cue": "锅底干爽，葱段翠绿"
    }
  ],
  "tips": [
    "面煮八分熟就捞，留余温在锅里炒熟。",
    "面条先拌油再炒，下锅不容易粘成团。",
    "蚝油和生抽都有咸味，盐最后尝过再补。"
  ],
  "common_mistakes": [
    "面条煮到全软再炒，翻两下就断成碎段。",
    "锅不够热就下面，粘底糊锅一片黑。",
    "一次性倒进全部调料，咸得发苦没法吃。"
  ],
  "substitutions": [
    {
      "original": "面条",
      "substitute": "米粉",
      "ratio": "300 克:300 克",
      "note": "不需煮，泡软直接炒，炒制快一分钟。"
    },
    {
      "original": "豆芽",
      "substitute": "韭黄",
      "ratio": "150 克:150 克",
      "note": "香气更浓，下锅时间缩短到二十秒。"
    }
  ],
  "variations": [
    "加叉烧丝同炒，就是茶餐厅的经典配法。",
    "出锅前淋几滴香油，葱香更足不抢味。"
  ],
  "serving_suggestion": "趁热吃最香，配一碗例汤就是标准茶餐厅一餐。",
  "storage": "冷藏一天，复热加少许清水抖炒回软。",
