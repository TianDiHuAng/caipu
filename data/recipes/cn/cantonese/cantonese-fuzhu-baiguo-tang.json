          "name_en": "cooking wine",
          "amount": 15,
          "unit": "ml",
          "note": "焯水去腥",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
