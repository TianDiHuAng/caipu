          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪骨用清水浸泡二十分钟去血水，中途换一次水。",
      "time_min": 20,
      "heat": "无火",
      "tip": "骨头先泡过再焯水，煲出来的汤色才清亮，不带那种闷腥气。",
      "visual_cue": "骨块发白，血水明显减少"
    },
    {
      "n": 2,
      "text": "冷水下锅加姜片与料酒，大火烧开后撇净浮沫，煮三分钟捞出冲净。",
      "time_min": 6,
      "heat": "大火",
      "tip": "浮沫撇得越干净，最后煲出来的汤就越清甜，别嫌麻烦多撇两遍。",
      "visual_cue": "水面浮起厚灰沫，骨缝不见血丝"
    },
    {
      "n": 3,
      "text": "白果去壳后用沸水烫两分钟，剥去薄衣并挑出中间的芯。",
      "time_min": 5,
      "heat": "大火",
      "tip": "芯最苦，一定要挑净，否则整锅汤都发涩。",
      "visual_cue": "果仁金黄完整，不见绿芯残留"
    },
    {
      "n": 4,
      "text": "汤锅加足量清水，放骨块、姜片与胡萝卜，大火烧开转小火煲一小时。",
      "time_min": 62,
      "heat": "小火",
      "tip": "水一定要一次加够，中途添水汤味就淡了，实在要加只能加热水。",
      "visual_cue": "汤色转乳白，骨香明显"
    },
    {
      "n": 5,
      "text": "放入白果继续煲十五分钟，再加泡软的腐竹煮八分钟。",
      "time_min": 23,
      "heat": "小火",
      "tip": "腐竹最后放，久煮会化在汤里失了口感。",
      "visual_cue": "白果软糯，腐竹舒展不碎"
    },
    {
      "n": 6,
      "text": "最后加盐与白胡椒调味，关火后焖五分钟，就可以盛出来喝了。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐一定要最后放，早放肉会发柴，汤也不容易煲出胶质。",
      "visual_cue": "汤色清亮微白，油花浮在表层"
    }
  ],
  "tips": [
    "想汤更白可先把骨块煎至微黄再煲，胶质析出更快。",
    "白果每人每天不宜超过十粒，一锅放四十克刚好。",
    "加两根蜜枣同煲，汤色更亮，甜味更自然。"
  ],
  "common_mistakes": [
    "骨块不焯水直接煲，汤浑带腥，浮沫撇不干净。",
    "白果不挑芯就下锅，整锅汤苦得没法入口，白白浪费一锅好骨汤。",
    "腐竹一开始就和骨同煲，最后全化没了。"
  ],
  "substitutions": [
    {
      "original": "猪骨",
      "substitute": "鸡骨架",
      "ratio": "500克:500克",
      "note": "鸡架出汤快，煲的时间可减到四十分钟。"
    },
    {
      "original": "腐竹",
      "substitute": "豆腐皮",
      "ratio": "80克:80克",
      "note": "豆腐皮更薄，最后五分钟下即可。"
    }
  ],
  "variations": [
    "加一把薏米或芡实同煲，祛湿效果更好，是广东春天的常用搭配。",
    "把白果换成莲子，汤更清甜，孩子更爱喝。"
  ],
  "serving_suggestion": "饭前喝一小碗最养胃，也可作为晚餐的主汤配白饭。",
  "storage": "冷藏可存两天，复热须小火慢煮十分钟，腐竹会略软。",
