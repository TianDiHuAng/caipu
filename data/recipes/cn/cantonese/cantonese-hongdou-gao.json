    "dessert"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 25,
    "cook_min": 40,
    "total_min": 65
  },
  "servings": 6,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "红豆",
          "name_en": "adzuki bean",
          "amount": 200,
          "unit": "g",
          "note": "提前泡四小时",
          "optional": false
        },
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 150,
          "unit": "g",
          "note": "水磨糯米粉",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 40,
          "unit": "g",
          "note": "增加透明度",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 350,
          "unit": "ml",
          "note": "调浆与煮豆",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "方形模具",
    "细筛",
    "汤锅",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆提前泡四小时，加清水煮二十分钟至豆粒开花但还完整。",
      "time_min": 20,
      "heat": "中火",
      "tip": "豆子煮到开花不烂最好，煮成豆泥就吃不出颗粒感了。",
      "visual_cue": "豆粒裂口开花，汤汁泛红"
    },
    {
      "n": 2,
      "text": "煮好的红豆倒进筛里沥干水分，另留一小碗煮豆的红汤备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "煮豆的汤带颜色和豆香，别全倒掉，调浆时加进去更香。",
      "visual_cue": "红豆沥干不滴水，留出的豆汤红亮"
    },
    {
      "n": 3,
      "text": "糯米粉与玉米淀粉过筛混匀，加清水与豆汤搅成无颗粒的稀浆。",
      "time_min": 7,
      "heat": "无火",
      "tip": "浆一定要搅到没有粉粒，带疙瘩蒸出来就是一块块硬心。",
      "visual_cue": "粉浆顺滑，能挂住刮刀"
    },
    {
      "n": 4,
      "text": "红豆与白糖倒进粉浆拌匀，倒进抹油的方模，抹平表面。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆和浆拌匀后别久放，粉会沉底，蒸出来上层全是清浆。",
      "visual_cue": "豆粒均匀分布，表面平整"
    },
    {
      "n": 5,
      "text": "模具上锅大火蒸三十分钟，取出彻底放凉再脱模切块。",
      "time_min": 5,
      "heat": "大火",
      "tip": "凉透才切，热着切会粘刀，切口也塌成一片糊。",
      "visual_cue": "糕体半透明，边缘不粘模"
    }
  ],
  "tips": [
    "广式红豆糕讲究软糯带弹，切开能看见一颗颗红豆才算合格。",
    "喜欢更清甜可以减少糖量，用一半冰糖替代白糖，口感更爽。",
    "蒸的时候锅盖包一层布，防止冷凝水滴在糕面留下坑洞。"
  ],
  "common_mistakes": [
    "红豆煮成豆泥再拌浆，蒸出来是一块均匀的红砖，没有颗粒。",
    "粉浆没过筛就上锅，糕里有粉疙瘩，咬着硌牙。",
    "蒸好马上脱模，糕体还软，一倒就塌成一摊。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "绿豆",
      "ratio": "200克:200克",
      "note": "绿豆不需久泡，煮十五分钟即可。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "木薯淀粉",
      "ratio": "40克:40克",
      "note": "木薯版更透明，弹度更高。"
    }
  ],
  "variations": [
    "加一勺椰浆同调，糕体带椰香，是港式茶楼的常见版本。",
    "表面撒炒香的白芝麻再蒸，多一层坚果香。"
  ],
  "serving_suggestion": "切方块装碟，配一壶普洱，冷吃热吃都可以。",
  "storage": "冷藏可存三天，食用前蒸五分钟回软，冷冻可存两周。",
