  "equipment": [
    "炒锅",
    "刷子",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲜鲍鱼用刷子刷净壳面与裙边黑膜，挖出鲍肉去掉内脏团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "裙边黑膜最腥，刷到发白才算干净。",
      "visual_cue": "鲍肉洁白、裙边无黑膜"
    },
    {
      "n": 2,
      "text": "在鲍鱼肉厚处剞十字花刀，深度到三分之二但不切断。",
      "time_min": 5,
      "heat": "无火",
      "tip": "剞花刀让鲍肉受热均匀，也更容易入味。",
      "visual_cue": "花刀均匀、鲍肉不散"
    },
    {
      "n": 3,
      "text": "锅中水烧开加料酒和姜片，鲍鱼焯三十秒后捞出过凉水。",
      "time_min": 3,
      "heat": "大火",
      "tip": "焯水时间短，久了鲍肉会缩成硬块。",
      "visual_cue": "鲍肉微卷、表面收紧"
    },
    {
      "n": 4,
      "text": "炒锅放植物油，下姜片、蒜和葱段小火爆香，加冰糖炒到化开。",
      "time_min": 3,
      "heat": "小火",
      "tip": "冰糖炒到浅琥珀色，成菜才红亮不发黑。",
      "visual_cue": "糖色浅褐、香气散出"
    },
    {
      "n": 5,
      "text": "倒入清水，加蚝油、生抽、老抽和料酒煮开成卤汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "卤汁先调好再下鲍鱼，味道才均匀。",
      "visual_cue": "卤汁红亮、咸香扑鼻"
    },
    {
      "n": 6,
      "text": "放入鲍鱼小火焖二十五分钟，中途翻面一次让两面入味。",
      "time_min": 25,
      "heat": "小火",
      "tip": "小火慢焖，鲍肉才软糯不韧。",
      "visual_cue": "鲍肉软弹、筷子能插入"
    },
    {
      "n": 7,
      "text": "开大火把汁收到浓稠，淋水淀粉勾薄芡，浇在鲍鱼上装盘。",
      "time_min": 3,
      "heat": "大火",
      "tip": "芡要薄，能挂住鲍身即可，太厚糊口。",
      "visual_cue": "酱汁浓亮挂身、盘底少汁"
    }
  ],
  "tips": [
    "鲜鲍选肉质厚、裙边紧实的，按压有弹性最新鲜。",
    "干鲍需提前泡发三天，本做法不适用。",
    "没有冰糖可用白糖，但上色和亮度略差。"
  ],
  "common_mistakes": [
    "内脏没去净就下锅，成品带苦味和腥气。",
    "全程大火焖煮，鲍肉紧成橡皮，嚼不动。",
    "糖色炒得过头发黑，卤汁带上焦苦味，颜色也发暗。"
  ],
  "substitutions": [
    {
      "original": "鲍鱼",
      "substitute": "杏鲍菇",
      "ratio": "500g 对 400g",
      "note": "素做口感接近，焖煮时间减半。"
    },
    {
      "original": "蚝油",
      "substitute": "鲍鱼汁",
      "ratio": "20ml 对 20ml",
      "note": "鲜味更集中，生抽可略减。"
    }
  ],
  "variations": [
    "加几片金华火腿同焖，鲜味更立体也更咸香。",
    "配焯水西兰花围边，做成年夜饭上的整只摆盘。"
  ],
  "serving_suggestion": "整只盛盘淋汁，配白饭或作宴席头菜。",
  "storage": "冷藏两天，复热加少许清水小火焖五分钟。",
