  "steps": [
    {
      "n": 1,
      "text": "整鸡去净腔内血块与多余油脂，剪去爪尖，用清水冲净后沥干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鸡身沥干再下卤，带水入锅会稀释卤水、上色不匀。",
      "visual_cue": "鸡皮干爽，腔內无血水。"
    },
    {
      "n": 2,
      "text": "深锅放清水、生抽、老抽、冰糖、料酒以及八角、桂皮、香叶、姜片和大葱段，大火烧开转小火熬十分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "卤水先熬出香味再下鸡，冰糖化开颜色才红亮。",
      "visual_cue": "卤水红褐透亮，香料浮在表面。"
    },
    {
      "n": 3,
      "text": "把整鸡放入卤水，用汤勺舀卤水反复淋遍鸡身，让表皮先定色。",
      "time_min": 5,
      "heat": "小火",
      "tip": "先淋后浸，鸡皮上色均匀，不会一块深一块浅。",
      "visual_cue": "鸡皮转为浅红褐色。"
    },
    {
      "n": 4,
      "text": "加盖小火浸煮二十五分钟，每隔八分钟翻一次身，让卤水进到腔內。",
      "time_min": 27,
      "heat": "小火",
      "tip": "卤水只冒小泡不翻滚，火大了鸡皮破、肉发柴。",
      "visual_cue": "鸡身鼓胀，卤水色泽渐深。"
    },
    {
      "n": 5,
      "text": "关火后让鸡在卤水里再浸十分钟，捞出沥干，刷一层卤水表面的鸡油增亮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "关火浸泡让咸味渗透均匀，急着捞出来里面还是白的。",
      "visual_cue": "鸡皮油亮红褐，卤香浓郁。"
    },
    {
      "n": 6,
      "text": "鸡晾到温热后斩件摆盘，淋两勺热卤水，配一碟姜蓉上桌。",
      "time_min": 8,
      "heat": "无火",
      "tip": "温的时候斩块，肉汁不流失，切面油润。",
      "visual_cue": "切面白嫩带汁，皮色枣红。"
    }
  ],
  "tips": [
    "卤水比例大约生抽一份、清水六份，太浓会咸得发苦。",
    "卤水可留下冷冻复用，越用越香，每次补少量生抽和冰糖。",
    "鸡要选两斤半上下的，太大卤不透，太小肉少骨多。"
  ],
  "common_mistakes": [
    "卤水滚着下鸡，鸡皮破裂，卤水变浑。",
    "全程大火煮，鸡肉紧缩发柴，切开一包干渣。",
    "卤好后立刻捞出，鸡腔里还是白肉，咸味没进去。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "1:0.8",
      "note": "用鸡腿卤十五分钟再浸五分钟，肉更嫩，做便当最方便。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "1:1",
      "note": "白糖上色快，用量减十克，免得卤水发苦。"
    }
  ],
  "variations": [
    "玫瑰豉油鸡在卤水里加一小勺玫瑰露酒，香气更雅。",
    "有的店家把卤好的鸡挂起吹干半小时，皮更爽、切面更干香。"
  ],
  "serving_suggestion": "斩件后淋热卤，配白饭和一碟青菜；卤汁拌饭是本地人的吃法。",
  "storage": "冷藏可存三日，冷冻两周；复热隔水蒸八分钟，卤汁另烧热再淋。",
