  "equipment": [
    "砂锅（带盖）",
    "小奶锅",
    "厨房温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后浸泡 30 分钟，捞出沥干；腊肠腊肉用温水冲洗表面油污，斜切成片。",
      "time_min": 20,
      "heat": "无火",
      "tip": "米泡透才不易夹生，泡米水倒掉以免饭发酸。",
      "visual_cue": "米粒吸水后由透明转为乳白"
    },
    {
      "n": 2,
      "text": "砂锅内壁刷一层香油，放入大米与 260ml 清水，大火煮开，边煮边用筷子搅动防粘底。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水与米的比例约 1.3:1，太多会煮成烂饭。",
      "visual_cue": "水面沸腾、米粒开始翻滚"
    },
    {
      "n": 3,
      "text": "水快收干、表面出现蜂窝状小孔时，铺上腊肠片、腊肉片与姜丝，转最小火加盖焖 12 分钟。",
      "time_min": 12,
      "heat": "微火",
      "tip": "转小火前可在锅边淋 10ml 植物油，帮助形成锅巴。",
      "visual_cue": "锅盖缝隙冒出白色蒸汽，能闻到腊味香"
    },
    {
      "n": 4,
      "text": "沿锅边淋入剩下的植物油，转动砂锅让锅底四个方向各烧 1 分钟，形成均匀锅巴。",
      "time_min": 4,
      "heat": "小火",
      "tip": "转动锅身而不是提高火力，锅巴才金黄不焦黑。",
      "visual_cue": "锅底传出轻微噼啪声，闻到焦香"
    },
    {
      "n": 5,
      "text": "关火后不开盖焖 8 分钟；另将生抽、老抽、蚝油、白糖加 15ml 清水小火煮开成豉油，菜心用盐水焯 30 秒。",
      "time_min": 8,
      "heat": "小火",
      "tip": "豉油要煮开再用，生酱油拌饭有生味。",
      "visual_cue": "豉油微微浓稠、能挂勺"
    },
    {
      "n": 6,
      "text": "开盖铺上菜心，淋豉油，用饭勺从底部翻起拌匀，让锅巴与腊味油脂混入米饭。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌的时候把锅巴敲碎成小块，口感更均匀。",
      "visual_cue": "锅巴呈金黄色，米饭粒粒油亮"
    }
  ],
  "tips": [
    "腊味本身很咸，豉油要少淋，先尝一口再决定用量。",
    "用厚底砂锅受热更均匀，薄锅容易糊底。",
    "焖饭期间不要频繁开盖，蒸汽跑掉饭会夹生。"
  ],
  "common_mistakes": [
    "米不浸泡直接煮，外软内硬，中心夹生。",
    "全程大火，锅底焦黑而米饭未熟。",
    "豉油一次倒太多，饭变湿咸，失去干香。"
  ],
  "substitutions": [
    {
      "original": "腊肠",
      "substitute": "腊鸭腿",
      "ratio": "80g 腊肠 ≈ 1 只腊鸭腿",
      "note": "腊鸭腿需先蒸 15 分钟再切块铺面。"
    },
    {
      "original": "菜心",
      "substitute": "小白菜",
      "ratio": "1:1",
      "note": "焯水时间同为 30 秒。"
    }
  ],
  "variations": [
    "家庭简化版：用电饭锅煮饭，跳闸后铺腊味再按一次煮饭键，最后用平底锅单独煎锅巴。",
    "窝蛋版：焖饭最后 5 分钟在中间打入一个鸡蛋，做成腊味窝蛋煲仔饭。"
  ],
  "serving_suggestion": "整锅上桌，拌好后分装小碗；配一壶普洱或菊花茶解腻。",
  "storage": "冷藏 1 天，复热时加 10ml 清水盖盖小火焖 5 分钟；锅巴会变软，不建议冷冻。",
