    "汤锅",
    "漏勺",
    "刀",
    "砧板",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅烧一锅开水，下面条煮到八成熟，约两分钟，捞出立刻过冷水冲掉表面的白色浆水。",
      "time_min": 5,
      "heat": "大火",
      "tip": "煮到八成就捞，回锅还要炒，煮透了面一炒就断。",
      "visual_cue": "面条略带硬芯，冲水后根根分明"
    },
    {
      "n": 2,
      "text": "面条沥干后拌入一勺植物油抖散，摊开晾两分钟把表面水汽吹干。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌油抖散是炒面不粘的关键，湿面条下锅一定糊。",
      "visual_cue": "面条油亮松散，不结团"
    },
    {
      "n": 3,
      "text": "虾仁开背去肠线，洗净吸干，加少许盐与生抽抓匀腌五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "虾仁吸干水再腌，下锅才弹，也不会出一锅水。",
      "visual_cue": "虾仁表面干爽，调料裹匀"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒烟倒油滑锅，下虾仁大火快炒一分半，卷曲变红就盛出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "虾仁一变色就捞，回锅再受热，久炒会变硬。",
      "visual_cue": "虾仁卷成弯月，颜色红亮"
    },
    {
      "n": 5,
      "text": "锅里留油下姜丝与葱段爆香，再下豆芽大火翻炒三十秒，炒到略软。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆芽只需断生，炒久了出水，面就发软。",
      "visual_cue": "豆芽微软，锅底仍干爽"
    },
    {
      "n": 6,
      "text": "倒入面条，用筷子配合铲子抖散翻炒两分钟，让面身均匀受热。",
      "time_min": 3,
      "heat": "大火",
      "tip": "筷子挑散比铲子压好，面条不易断也更透气。",
      "visual_cue": "面条松散，开始出现焦边"
    },
    {
      "n": 7,
      "text": "沿锅边淋生抽与蚝油，加白糖与剩余盐，快速翻炒四十秒上色均匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "酱汁沿锅边淋才带焦香，直接浇面上下色不匀。",
      "visual_cue": "面条酱色均匀，锅气明显"
    },
    {
      "n": 8,
      "text": "回锅虾仁，加韭黄段翻炒二十秒，关火淋香油，装盘趁热吃。",
      "time_min": 2,
      "heat": "大火",
      "tip": "韭黄最后放，二十秒断生就够，久了发黄出水。",
      "visual_cue": "韭黄翠绿，面身油润不粘"
    }
  ],
  "tips": [
    "碱水面最适合炒，普通挂面容易断，可换成宽面。",
    "面煮好不要盖着，闷在锅里会返潮粘成块。",
    "豆芽与韭黄是粤式炒面的标配，口感层次全靠它们。",
    "锅一定要烧透再下油，粘锅的面怎么炒都会碎。"
  ],
  "common_mistakes": [
    "面煮全熟再炒，回锅一翻就断，成品碎成面渣。",
    "面不沥干就下锅，锅里冒白汽，炒出来软塌一大片。",
    "酱汁一次全倒进去，面条吸味不均，底下的咸上头的淡。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "叉烧片",
      "ratio": "200克:200克",
      "note": "叉烧本身带甜，糖可减半。"
    },
    {
      "original": "韭黄",
      "substitute": "韭菜",
      "ratio": "80克:80克",
      "note": "香气更冲，需多炒十秒。"
    }
  ],
  "variations": [
    "加两只打散的蛋液同炒，做成虾仁蛋炒面。",
    "用XO酱替一半生抽，酱香更浓，是茶餐厅的高配版本。"
  ],
  "serving_suggestion": "两人份主食，配一碗清汤与一小碟辣椒酱，就是粤式的午餐一套。",
  "storage": "现炒现吃最好，冷藏后复热需用大火快炒，微波加热面会粘连。",
