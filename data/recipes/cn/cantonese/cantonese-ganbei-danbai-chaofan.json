  "equipment": [
    "炒锅",
    "蒸锅",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干贝加料酒和两勺清水，上锅蒸二十分钟至软，取出晾凉后顺纹撕成细丝。",
      "time_min": 25,
      "heat": "中火",
      "tip": "干贝蒸软再撕，丝才细，炒出来口感才匀。",
      "visual_cue": "干贝松软可撕，纤维分明。"
    },
    {
      "n": 2,
      "text": "隔夜冷饭用手搓散结块，摊开晾十分钟，让表面水分再散掉一些。",
      "time_min": 10,
      "heat": "无火",
      "tip": "饭越干爽炒出来越松散，湿饭下锅只会成坨。",
      "visual_cue": "米粒颗颗分明，不粘手。"
    },
    {
      "n": 3,
      "text": "鸡蛋磕开只取蛋白，加少许盐打散，蛋白要打到看不见明显蛋筋。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋白打散不打发，起泡会让炒饭出水发黏。",
      "visual_cue": "蛋白均匀无结块。"
    },
    {
      "n": 4,
      "text": "炒锅烧热放一半花生油，下干贝丝小火炒到微干出香，盛出一半留作撒面。",
      "time_min": 5,
      "heat": "小火",
      "tip": "干贝丝炒干一点更香，但别炒焦，焦了就发苦。",
      "visual_cue": "干贝丝金黄蓬松，鲜香浓。"
    },
    {
      "n": 5,
      "text": "锅中补油，下冷饭大火翻炒到米粒跳动，把蛋白倒入迅速翻拌裹住饭粒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "蛋白下锅要快炒，火小了会结块成蛋饼。",
      "visual_cue": "饭粒裹上蛋白发白，锅中跳动。"
    },
    {
      "n": 6,
      "text": "加盐和白胡椒调味，倒回干贝丝翻匀，撒葱花和剩余干贝丝即可出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "盐早放会出水，最后调味饭粒才保干爽。",
      "visual_cue": "饭粒雪白松散，干贝丝点缀其上。"
    }
  ],
  "tips": [
    "干贝选大颗的瑶柱，蒸后撕丝才够香够甜。",
    "只用蛋白炒，颜色雪白清雅，配干贝的鲜最搭。",
    "炒饭油要够热，冷油下饭米粒容易粘锅。"
  ],
  "common_mistakes": [
    "干贝不蒸直接下锅炒，硬得咬不动，鲜味也出不来。",
    "蛋白没打散就倒进锅，结成一团团蛋块，拌不开。",
    "用新煮的米饭炒，饭粘成团，怎么炒都不散。"
  ],
  "substitutions": [
    {
      "original": "干贝",
      "substitute": "虾米",
      "ratio": "40克:30克",
      "note": "虾米泡软切碎即可，成本低很多，鲜味偏咸香。"
    },
    {
      "original": "鸡蛋",
      "substitute": "蟹肉",
      "ratio": "4个:150克",
      "note": "换成熟蟹肉即蟹肉蛋白炒饭，鲜味更高级。"
    }
  ],
  "variations": [
    "有的师傅在炒饭里加一勺上汤，饭粒更润，但火候要更猛。",
    "宴席版会把炒饭装进蟹盖同蒸，卖相更讲究。"
  ],
  "serving_suggestion": "盛入小碗扣出成圆顶，撒剩余干贝丝；配一碟清口小菜，作为宴席主食很得体。",
  "storage": "现炒现吃，冷藏不超过一日；复热用炒锅大火快炒，别加水。",
