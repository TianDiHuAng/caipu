  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "玉米",
          "name_en": "sweet corn",
          "amount": 400,
          "unit": "g",
          "note": "两只，切段",
          "optional": false
        },
        {
          "name": "猪排骨",
          "name_en": "pork ribs",
          "amount": 500,
          "unit": "g",
          "note": "斩小块",
          "optional": false
        },
        {
          "name": "胡萝卜",
          "name_en": "carrot",
          "amount": 300,
          "unit": "g",
          "note": "切滚刀块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 15,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "蜜枣",
          "name_en": "candied date",
          "amount": 30,
          "unit": "g",
          "note": "两只，可省略",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 7,
          "unit": "g",
          "note": "出锅前调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 2000,
          "unit": "ml",
          "note": "一次加足",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "滤网",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "排骨用清水泡二十分钟，中途换两次水，把血水泡出来，汤才清不腥。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡血水比焯水更能保住肉的鲜味，汤也更清。",
      "visual_cue": "水面浮起淡红血水，排骨颜色变浅"
    },
    {
      "n": 2,
      "text": "泡好的排骨冷水下锅，加两片姜，小火加热到微沸，撇净浮沫后捞出冲净。",
      "time_min": 8,
      "heat": "中火",
      "tip": "水要冷水起锅，血沫才会随温度升高慢慢析出。",
      "visual_cue": "浮沫聚成灰褐色一层，排骨表面干净"
    },
    {
      "n": 3,
      "text": "玉米剥去外叶与须，切成四厘米厚的段；胡萝卜去皮切滚刀块，大小约三厘米。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切块别太小，久煮会化在汤里，只剩渣。",
      "visual_cue": "玉米段整齐，胡萝卜块大小一致"
    },
    {
      "n": 4,
      "text": "汤锅加清水，放入排骨与姜片，大火烧开后转小火，撇一次浮沫，盖盖炖四十分钟。",
      "time_min": 45,
      "heat": "小火",
      "tip": "全程小火保持汤面微滚即可，火大了汤色会变浑，喝起来也不清爽。",
      "visual_cue": "汤面微微冒泡，水面清亮"
    },
    {
      "n": 5,
      "text": "加玉米段、胡萝卜块与蜜枣，继续小火炖三十分钟，让甜味慢慢渗进汤里。",
      "time_min": 32,
      "heat": "小火",
      "tip": "玉米和胡萝卜后放，久煮会散，甜味也会发闷。",
      "visual_cue": "玉米转深黄，胡萝卜边缘变软"
    },
    {
      "n": 6,
      "text": "用筷子戳胡萝卜，能轻松穿透说明已炖透，此时汤色转成浅琥珀色。",
      "time_min": 3,
      "heat": "小火",
      "tip": "胡萝卜炖透汤才甜，硬芯说明时间不够。",
      "visual_cue": "筷子一戳即透，汤色浅金"
    },
    {
      "n": 7,
      "text": "关火前加盐调味，先加一半尝味再补，撒少许白胡椒提香。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐一定最后加，早加会让排骨肉质变紧，汤也不易出甜味。",
      "visual_cue": "汤味鲜甜微咸，无生盐味"
    },
    {
      "n": 8,
      "text": "盛出时先舀汤，再放排骨与蔬菜，撇掉表面浮油，喝起来更清爽。",
      "time_min": 3,
      "heat": "无火",
      "tip": "撇油后汤更清甜，想喝浓一点可以留一部分油。",
      "visual_cue": "汤面清亮，浮油薄薄一层"
    }
  ],
  "tips": [
    "蜜枣是粤式汤的隐形配角，能让甜味更圆润，没有可省。",
    "想汤更浓甜可以用老玉米，嫩玉米甜但汤味偏淡。",
    "炖汤全程别开盖频繁搅动，香气会跑掉。",
    "剩下的汤第二天煮面条，鲜甜味比清水汤底强得多。"
  ],
  "common_mistakes": [
    "排骨不泡血水直接炖，汤浑带腥，怎么撇都救不回。",
    "全程大火滚煮，汤色发白浑浊，喝着不清爽。",
    "盐提前加进锅里炖，排骨发柴，汤的甜味也被压住。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "猪瘦肉",
      "ratio": "500克:450克",
      "note": "汤更清爽少油，炖制时间缩短十分钟。"
    },
    {
      "original": "玉米",
      "substitute": "玉米粒罐头",
      "ratio": "400克:350克",
      "note": "省去切段，但甜味偏平，需加半根胡萝卜补味。"
    }
  ],
  "variations": [
    "加一把去壳白果同炖，汤更润，是广东秋天的家常做法。",
    "把排骨换成鸡腿，做成粟米胡萝卜鸡汤，清爽不腻。"
  ],
  "serving_suggestion": "饭前先喝一碗，配白饭与时蔬；也可当汤底煮面，加青菜与蛋饺。",
  "storage": "冷藏三天内喝完，冷冻可放一个月；复热后建议当天喝完，不反复加热。",
