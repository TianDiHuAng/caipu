  "equipment": [
    "深汤锅",
    "漏勺",
    "冰盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡内外洗净，剪去脚趾尖，用盐把鸡腔内外抹匀腌十五分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "盐抹匀，鸡皮收紧后浸煮才滑。",
      "visual_cue": "鸡皮表面微干、盐粒看不见"
    },
    {
      "n": 2,
      "text": "汤锅加清水、生姜片与料酒烧开，提着鸡颈把整鸡浸入再提出三次。",
      "time_min": 4,
      "heat": "大火",
      "tip": "三提三放让鸡腔内外温度接近。",
      "visual_cue": "鸡皮反复收紧、鸡身略胀"
    },
    {
      "n": 3,
      "text": "整鸡放入锅中，水微沸后转小火浸煮二十五分钟，中途翻一次面。",
      "time_min": 26,
      "heat": "小火",
      "tip": "水面只冒小泡，滚开就把鸡肉煮柴。",
      "visual_cue": "鸡身略浮、关节能自由转动"
    },
    {
      "n": 4,
      "text": "捞出立刻放进冰水里浸十分钟，让鸡皮紧实爽脆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冰水一激，鸡皮才够弹。",
      "visual_cue": "鸡皮泛白紧实、表面光滑"
    },
    {
      "n": 5,
      "text": "生姜磨成蓉，小葱切花，与盐一起放碗中，浇上烧热的植物油拌成姜葱油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要烧到冒烟，浇上去才不会腥。",
      "visual_cue": "姜葱油碧绿喷香、油面泛光"
    },
    {
      "n": 6,
      "text": "鸡顺着关节斩成块摆盘，淋上姜葱油即可上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "斩件要顺着关节下刀，皮才不破。",
      "visual_cue": "鸡皮完整光亮、骨髓带一点红"
    }
  ],
  "tips": [
    "选一千克左右的嫩鸡，肉嫩不柴。",
    "浸煮时不要盖严，让腥气散出去。",
    "姜葱油里加一撮盐，咸鲜才立住。"
  ],
  "common_mistakes": [
    "水大开下锅猛煮，鸡肉发柴皮也破。",
    "煮好后直接斩件，鸡皮松散不紧实。",
    "姜葱油浇的油温不够，姜蓉带生辛味。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "1000g 对 800g",
      "note": "更易熟，浸煮时间减十分钟。"
    },
    {
      "original": "小葱",
      "substitute": "大葱",
      "ratio": "80g 对 100g",
      "note": "香气更冲，需切得极细。"
    }
  ],
  "variations": [
    "把姜葱油换成沙姜油，风味更接近粤西做法。",
    "剩下的鸡骨与鸡汤加米饭煮成鸡粥，一点不浪费。"
  ],
  "serving_suggestion": "斩件后趁温热食用，配姜葱油蘸食最佳。",
  "storage": "冷藏可放两天，鸡皮会稍软，复蒸后回温。",
