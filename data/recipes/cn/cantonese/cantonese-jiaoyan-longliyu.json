  "steps": [
    {
      "n": 1,
      "text": "龙利鱼柳解冻后用手挤干水分，切成两指宽的长条，用料酒和盐抓匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "鱼柳本身含水量很大，一定要用手挤干再切条。",
      "visual_cue": "鱼条干爽、能立住成形"
    },
    {
      "n": 2,
      "text": "加白胡椒粉和一半淀粉抓匀，再倒入蛋液裹匀，最后拍上剩余的淀粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先湿后干的裹粉顺序，炸出来的外壳才够脆。",
      "visual_cue": "鱼条表面干粉均匀不粘手"
    },
    {
      "n": 3,
      "text": "锅中倒植物油烧到六成热，筷子插进去周围冒小泡即可下鱼条。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温不够鱼条会吸油，太高则外糊里生。",
      "visual_cue": "筷子周围冒细密气泡"
    },
    {
      "n": 4,
      "text": "鱼条分批下锅炸三分钟，浮起且外壳微黄时捞出沥油。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "一次不要下太多，油温掉得快就炸不脆。",
      "visual_cue": "外壳淡金黄、鱼条浮起"
    },
    {
      "n": 5,
      "text": "锅留少量底油，下蒜末、红辣椒末和葱末，小火炒出香味。",
      "time_min": 1,
      "heat": "小火",
      "tip": "蒜末微微发黄就够，炒焦了整盘都发苦。",
      "visual_cue": "蒜末金黄、不见焦黑"
    },
    {
      "n": 6,
      "text": "倒回炸好的鱼条，撒入椒盐快速翻匀，让每条都沾上椒盐即可出锅。",
      "time_min": 1,
      "heat": "中火",
      "tip": "椒盐一定要最后撒，早放会沉底、遇热发苦。",
      "visual_cue": "鱼条表面挂满椒盐粒"
    }
  ],
  "tips": [
    "龙利鱼柳含水多，挤干水分是能不能炸脆的关键。",
    "想要外壳更脆，可把油温升到七成热复炸十秒。",
    "椒盐可自己用花椒粉与盐一比三小火炒香后碾碎，味道更活。"
  ],
  "common_mistakes": [
    "鱼柳没挤干水就裹粉，下锅脱浆、油花四溅。",
    "油温过低时下锅，鱼条吸满油，吃起来一嘴油腻。",
    "椒盐和蒜末一起久炒，椒盐发苦、蒜末变焦黑。"
  ],
  "substitutions": [
    {
      "original": "龙利鱼",
      "substitute": "鲈鱼柳",
      "ratio": "400g 对 400g",
      "note": "鲈鱼要自行片肉去刺，肉质更紧实。"
    },
    {
      "original": "椒盐",
      "substitute": "盐加花椒粉",
      "ratio": "6g 对 1.5g 加 4.5g",
      "note": "花椒现炒现碾，麻香比市售椒盐更足。"
    }
  ],
  "variations": [
    "裹粉前拍一层玉米片碎，外壳更酥更响。",
    "起锅撒少许五香粉，香气更接近大排档做法。"
  ],
  "serving_suggestion": "垫厨房纸吸油后装盘，配椒盐碟与柠檬角。",
  "storage": "炸物最好现炸现吃，冷藏后回锅复炸十秒可恢复脆度。",
