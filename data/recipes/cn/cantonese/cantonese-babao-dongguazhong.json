  "steps": [
    {
      "n": 1,
      "text": "冬瓜取中段一段，用刀在顶部切出一个盖子，边缘切成锯齿形花边。",
      "time_min": 15,
      "heat": "无火",
      "tip": "花边切口要均匀，蒸出来才好看，也能卡住盖子。",
      "visual_cue": "切口齐整如齿轮，盖子上留小柄"
    },
    {
      "n": 2,
      "text": "用勺子把冬瓜内瓤与籽全部挖净，留一厘米厚的瓜肉作盅壁。",
      "time_min": 12,
      "heat": "无火",
      "tip": "壁留得太薄蒸久了会塌，一厘米左右最稳妥。",
      "visual_cue": "内壁光滑平整，不见瓜子残留"
    },
    {
      "n": 3,
      "text": "冬瓜盅与盖子一起下沸水焯三分钟，捞出立刻用冷水冲凉定型。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯水能去青草气，也让瓜皮更挺括不易裂。",
      "visual_cue": "瓜皮转成透亮的浅绿，盅形完整"
    },
    {
      "n": 4,
      "text": "鸭肉丁冷水下锅焯两分钟去血沫，捞出冲净后沥干备用。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯水能去掉瓜的青草气，也让瓜皮更挺括，蒸的时候不容易裂开。",
      "visual_cue": "肉丁发白收缩，水面浮起褐色沫"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油下姜片爆香，放鸭肉丁、香菇、火腿、莲子、玉米粒翻炒，烹黄酒。",
      "time_min": 8,
      "heat": "中火",
      "tip": "料先炒香再入盅，蒸出来的汤才有层次。",
      "visual_cue": "料丁油亮出香，锅气明显"
    },
    {
      "n": 6,
      "text": "把炒好的料与干贝丝、虾仁粒一同装入冬瓜盅，加清水至八分满并调盐。",
      "time_min": 6,
      "heat": "无火",
      "tip": "只装八分满，蒸的时候汤会涨，太满必溢。",
      "visual_cue": "汤汁接近盅口下沿，料面露出"
    },
    {
      "n": 7,
      "text": "盖上瓜盖放入深盘，上汽后中火蒸一小时十分钟，取出撒上葱花与白胡椒。",
      "time_min": 75,
      "heat": "中火",
      "tip": "中途不揭盖，蒸足时间瓜肉才软糯吸味。",
      "visual_cue": "瓜皮发暗变软，盅内汤汁微浊起香"
    }
  ],
  "tips": [
    "冬瓜选老身、表皮带白霜的，蒸足一小时也不烂。",
    "清水换成上汤或鸡汤，鲜味能再提一层，是酒楼的做法。",
    "挖出的瓜肉别丢，切块煮汤或炒着吃，一点不浪费。"
  ],
  "common_mistakes": [
    "盅壁挖得太薄，蒸到一半瓜皮裂开，汤全漏进盘里。",
    "料装得太满又加满水，一沸就溢出，卖相全毁。",
    "蒸的时间不足，瓜肉发硬咬不动，还带着生青味。"
  ],
  "substitutions": [
    {
      "original": "鸭",
      "substitute": "鸡腿肉",
      "ratio": "150克:150克",
      "note": "鸡肉更清淡，蒸的时间可减十分钟。"
    },
    {
      "original": "干贝",
      "substitute": "虾米",
      "ratio": "20克:20克",
      "note": "虾米须提前泡软，咸味重需减盐。"
    }
  ],
  "variations": [
    "把冬瓜换成小南瓜，蒸出来甜香更浓，造型也讨喜。",
    "加几片瑶柱与蟹肉同蒸，鲜味翻倍，是宴席的顶级版本。"
  ],
  "serving_suggestion": "整盅端上桌，用汤勺连瓜肉一起舀出分食，是夏秋宴席的清鲜头菜。",
  "storage": "冷藏可存一天，复热须上锅蒸十五分钟，久放瓜肉会出水变淡。",
