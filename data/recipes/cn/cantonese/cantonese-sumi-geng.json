        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "打蛋器",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米粒取一半放入搅拌机，加两百毫升清水打成细腻的玉米浆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打得越细，羹才越顺滑，颗粒感靠剩下那一半。",
      "visual_cue": "浆液浓稠均匀，不见整粒残渣"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下玉米粒小火炒两分钟，炒出甜香后倒入汤锅。",
      "time_min": 4,
      "heat": "小火",
      "tip": "玉米粒先下锅炒一遍，甜味才被彻底激发出来，直接煮味道发闷。",
      "visual_cue": "玉米粒颜色转深，香气散出"
    },
    {
      "n": 3,
      "text": "汤锅加玉米浆与六百毫升清水，大火烧开后转中小火煮五分钟。",
      "time_min": 7,
      "heat": "大火",
      "tip": "煮的时候要边煮边搅动，玉米浆很容易沉底糊锅，一糊整锅带焦味。",
      "visual_cue": "汤色金黄浓稠，表面冒细泡"
    },
    {
      "n": 4,
      "text": "加盐、白糖与白胡椒调味，淀粉调水缓缓淋入并不断搅拌至浓稠。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "芡水要细流慢倒，一边倒一边搅，一次全倒进去必然结成粉团。",
      "visual_cue": "汤体挂勺顺滑，无白色粉团"
    },
    {
      "n": 5,
      "text": "关小火，蛋液呈细线状淋入，静置十秒后轻推成蛋花。",
      "time_min": 3,
      "heat": "小火",
      "tip": "淋完别马上搅，等蛋液定型再推，蛋花才成絮状。",
      "visual_cue": "蛋花成薄片絮状，汤面漂金丝"
    },
    {
      "n": 6,
      "text": "最后撒上火腿末与葱花，淋几滴香油，就可以盛出来上桌了。",
      "time_min": 1,
      "heat": "无火",
      "tip": "火腿末要最后放，煮久了咸香被煮散，只剩下死咸。",
      "visual_cue": "汤面金红点缀，芡亮不浊"
    }
  ],
  "tips": [
    "用现剥甜玉米最好，罐头玉米须减糖并沥干水分。",
    "想更鲜可加一小块鸡汤块，或用上汤代替清水。",
    "勾芡后不要再大火滚，否则芡会散成水。"
  ],
  "common_mistakes": [
    "玉米浆不搅动就煮，沉底糊锅，整锅带焦味。",
    "淀粉一次全倒进去，结成一个个粉团捞不出来。",
    "蛋液在滚沸时倒入又猛搅，蛋花全碎成渣。"
  ],
  "substitutions": [
    {
      "original": "玉米粒",
      "substitute": "南瓜",
      "ratio": "200克:250克",
      "note": "南瓜须蒸软打泥，糖可减半。"
    },
    {
      "original": "火腿",
      "substitute": "蟹肉",
      "ratio": "30克:40克",
      "note": "蟹肉最后放，煮久会散。"
    }
  ],
  "variations": [
    "加一把蟹肉做成蟹肉粟米羹，是粤式酒楼的常见升级版。",
    "换成鸡蓉同煮，就是鸡蓉粟米羹，更清淡适合孩子。"
  ],
  "serving_suggestion": "热食最佳，作为宴席的第二道汤羹或家常配汤都合适。",
  "storage": "冷藏可存一天，复热须小火加两勺水慢煮，浓稠度会变。",
