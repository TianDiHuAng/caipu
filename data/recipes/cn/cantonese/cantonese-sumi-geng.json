          "unit": "g",
          "note": "提甜",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "去腥提香",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 4,
          "unit": "ml",
          "note": "起锅淋入",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 10,
          "unit": "ml",
