          "amount": 30,
          "unit": "g",
          "note": "切细末",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 25,
          "unit": "g",
          "note": "调水勾芡",
          "optional": false
        },
        {
