          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 4,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "碗",
    "筛网",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕入大碗，加盐后用筷子顺一个方向打散，打到蛋液均匀不见蛋清。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液要打得细，蛋白没散开蒸出来会有白疙瘩。",
      "visual_cue": "蛋液颜色均匀，表面浮起细密小泡"
    },
    {
      "n": 2,
      "text": "兑入约四十度的温水，边倒边搅匀，水的量是蛋液的一点五倍。",
      "time_min": 3,
      "heat": "无火",
      "tip": "温水蒸出来最嫩，冷水会有蜂窝，开水直接冲成蛋花。",
      "visual_cue": "蛋水混合液呈淡黄色，质地稀薄"
    },
    {
      "n": 3,
      "text": "用细筛网把蛋液过滤两遍，滤去浮沫与未散的蛋筋。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过滤是滑嫩的关键，浮沫不去表面就会起蜂窝。",
      "visual_cue": "滤后液面平静无泡，筛上留少量蛋筋"
    },
    {
      "n": 4,
      "text": "蛋液倒入浅碗，表面盖一层保鲜膜，用牙签扎几个小孔透气。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盖膜是防蒸汽滴落，扎孔是为了不让膜鼓起。",
      "visual_cue": "膜面平整贴碗，边缘不见缝隙"
    },
    {
      "n": 5,
      "text": "水开后放入蒸锅，中小火蒸十分钟，关火再焖两分钟。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "火大必起蜂窝，中小火慢蒸才平滑如镜。",
      "visual_cue": "蛋面平整微颤，中心不流动"
    },
    {
      "n": 6,
      "text": "把碗取出揭开保鲜膜，淋上生抽与香油，撒一把小葱花就可以上桌了。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调味一定要趁热淋上去，酱香才渗得进蛋里，凉了就只浮在表面。",
      "visual_cue": "表面光洁如镜，酱汁薄薄铺开"
    }
  ],
  "tips": [
    "蛋水比例一比一点五最稳，喜欢硬些可减到一比一点二。",
    "没有保鲜膜可盖一个盘子，效果一样，还能省下塑料。",
    "加两滴料酒同蒸，蛋腥味去得更干净。"
  ],
  "common_mistakes": [
    "用冷水或开水兑蛋液，蒸出来不是蜂窝就是蛋水分离。",
    "大火猛蒸，表面坑坑洼洼像月球，完全谈不上嫩。",
    "不盖膜也不盖盘，蒸汽滴下来砸出一个个小坑。"
  ],
  "substitutions": [
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "180克:180克",
      "note": "鸭蛋腥味重，须加两滴料酒。"
    },
    {
      "original": "温水",
      "substitute": "鸡汤",
      "ratio": "270毫升:270毫升",
      "note": "用鸡汤可减盐一克，鲜味更足。"
    }
  ],
  "variations": [
    "蛋液里加虾仁粒或瑶柱丝同蒸，就是粤式的鲜虾蒸水蛋。",
    "蒸好后铺一层肉末芡汁，做成肉酱蒸蛋，更适合下饭。"
  ],
  "serving_suggestion": "趁热吃最嫩，配白饭或拌粥都合适，老人小孩都好入口。",
  "storage": "冷藏不超过一天，复热须上锅蒸五分钟，微波会让蛋体发硬出水。",
