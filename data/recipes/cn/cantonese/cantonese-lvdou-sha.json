    "汤锅",
    "搅拌机",
    "碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "绿豆挑去坏豆洗净，用清水泡两小时到发胀。",
      "time_min": 130,
      "heat": "无火",
      "tip": "泡到豆皮起皱就好，泡太久煮时全成糊。",
      "visual_cue": "豆粒饱满，豆皮起皱"
    },
    {
      "n": 2,
      "text": "海带泡软后反复洗净，切成五厘米长的细丝备用。",
      "time_min": 15,
      "heat": "无火",
      "tip": "海带多洗两遍去沙，不然汤里有渣。",
      "visual_cue": "海带丝柔韧，洗净无沙"
    },
    {
      "n": 3,
      "text": "汤锅放绿豆和清水大火烧开，转小火煮三十分钟。",
      "time_min": 32,
      "heat": "大火",
      "tip": "水一次加足，中途加水汤会变稀不沙。",
      "visual_cue": "绿豆开花，汤色转绿"
    },
    {
      "n": 4,
      "text": "加海带丝再煮十五分钟，豆沙完全煮到起沙。",
      "time_min": 15,
      "heat": "小火",
      "tip": "海带后下，久煮会化掉失去口感。",
      "visual_cue": "豆沙起沙，海带丝软"
    },
    {
      "n": 5,
      "text": "盛出一半豆汤用搅拌机打成细沙，再倒回锅里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打一半留一半，口感才既有沙又有豆粒。",
      "visual_cue": "汤体浓稠，能挂勺"
    },
    {
      "n": 6,
      "text": "加白糖和盐搅匀，再小火煮五分钟收浓即可。",
      "time_min": 5,
      "heat": "小火",
      "tip": "加一撮盐能吊出甜味，别多否则发咸。",
      "visual_cue": "甜香浓稠，豆香清正"
    }
  ],
  "tips": [
    "绿豆先泡两小时再煮，起沙快还省火。",
    "打一半留一半，口感有沙有粒最讨喜。",
    "加一撮盐提味，甜得更透不发寡。"
  ],
  "common_mistakes": [
    "绿豆不泡直接煮，煮一小时豆还硬。",
    "中途反复加冷水，汤色浑浊不起沙。",
    "白糖一开始就下锅，绿豆久煮不烂。"
  ],
  "substitutions": [
    {
      "original": "绿豆",
      "substitute": "红豆",
      "ratio": "250 克:250 克",
      "note": "需泡四小时，煮制时间延长二十分钟。"
    },
    {
      "original": "海带",
      "substitute": "百合",
      "ratio": "60 克:50 克",
      "note": "清润不腥，最后十五分钟下锅。"
    }
  ],
  "variations": [
    "加一小块陈皮同煮，香气更立体。",
    "放凉后加椰浆搅匀，做成冻绿豆沙。"
  ],
  "serving_suggestion": "热饮暖胃，放凉冷藏后当冰品更解暑。",
  "storage": "冷藏三天，复热加少量清水搅匀煮开。",
