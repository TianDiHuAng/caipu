  "equipment": [
    "炒锅",
    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉去皮切成两厘米见方的块，加盐与料酒腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉块大小一致，炸时受热均匀。",
      "visual_cue": "肉块方正、表面微黏"
    },
    {
      "n": 2,
      "text": "菠萝切成三角块，用淡盐水泡十分钟后沥干水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "淡盐水能去掉菠萝涩口的感觉。",
      "visual_cue": "菠萝块干爽、果香清甜"
    },
    {
      "n": 3,
      "text": "肉块加蛋液抓匀，再滚上玉米淀粉，用手轻压裹牢。",
      "time_min": 5,
      "heat": "无火",
      "tip": "裹粉按实，炸时粉才不会掉。",
      "visual_cue": "肉块表面干爽、粉层均匀"
    },
    {
      "n": 4,
      "text": "锅中倒植物油烧到六成热，肉块逐块下锅炸到浅金黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "一块块放，防止粘成团。",
      "visual_cue": "肉块浮起、外壳浅金黄"
    },
    {
      "n": 5,
      "text": "捞出稍凉后升油温复炸三十秒，让外壳更加酥脆。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "复炸是咕咾肉外脆的关键一步。",
      "visual_cue": "外壳深金、敲之脆响"
    },
    {
      "n": 6,
      "text": "另起锅下少许油，爆香蒜片与洋葱块炒到微微透亮。",
      "time_min": 2,
      "heat": "中火",
      "tip": "洋葱略炒就好，保留脆甜口感。",
      "visual_cue": "洋葱半透、香气散出"
    },
    {
      "n": 7,
      "text": "加番茄酱、白糖、白醋与清水烧开，搅成红亮的糖醋汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汁要先煮开再勾芡，酸味更顺口。",
      "visual_cue": "汁色红亮、甜酸味平衡"
    },
    {
      "n": 8,
      "text": "淋淀粉水勾薄芡，下红椒片与菠萝块快速翻炒几下。",
      "time_min": 2,
      "heat": "中火",
      "tip": "菠萝最后放，久炒会出水变酸。",
      "visual_cue": "芡汁透明挂勺、菠萝完整"
    },
    {
      "n": 9,
      "text": "倒入炸好的肉块大火翻匀，汁裹满立刻出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "翻匀即可，久炒外壳就软了。",
      "visual_cue": "肉块油亮、盘底不见汤汁"
    }
  ],
  "tips": [
    "用梅花肉代替五花肉，肥瘦更均匀不腻。",
    "糖醋汁里加一勺菠萝汁，果香更突出。",
    "红椒只作配色，最后下锅保持鲜艳。"
  ],
  "common_mistakes": [
    "肉块裹粉后久放，粉返潮炸出来不脆。",
    "只炸一遍就浇汁，外壳很快被泡软。",
    "菠萝和肉一起长时间翻炒，出水冲淡酸甜味。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "梅花肉",
      "ratio": "300g 对 300g",
      "note": "油脂少些，可少炸三十秒。"
    },
    {
      "original": "菠萝",
      "substitute": "芒果",
      "ratio": "200g 对 200g",
      "note": "更软，需最后下锅拌两下。"
    }
  ],
  "variations": [
    "加几块青红椒和洋葱同炒，颜色更热闹。",
    "糖醋汁里加少许话梅粉，酸甜更有回甘。"
  ],
  "serving_suggestion": "趁热吃最脆，配一杯冰镇饮料很解腻。",
  "storage": "当天吃完，隔夜外壳会彻底回软。",
