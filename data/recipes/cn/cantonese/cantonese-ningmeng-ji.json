    "刀",
    "砧板",
    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成三厘米见方的小块，洗净沥干水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鸡块大小一致才受热均匀，厚的地方片薄再切。",
      "visual_cue": "鸡块方整，表面无水下滴"
    },
    {
      "n": 2,
      "text": "鸡块加盐和生抽抓匀，腌十入味后拌入鸡蛋淀粉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "挂糊前先把腌汁抓进去，糊才粘得牢不脱壳。",
      "visual_cue": "鸡块裹上薄糊，不滴汁"
    },
    {
      "n": 3,
      "text": "柠檬挤出一百克汁，另取两片薄皮切成细丝备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "柠檬皮别擦白瓤，白瓤会带苦味。",
      "visual_cue": "柠檬丝金黄，果汁清亮"
    },
    {
      "n": 4,
      "text": "锅倒植物油烧五成热，鸡块下锅中小火煎到两面金黄。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "分批下锅别挤在一起，温度才不骤降。",
      "visual_cue": "鸡块两面金黄，边缘焦脆"
    },
    {
      "n": 5,
      "text": "煎好的鸡块盛出，锅里留少许油下柠檬丝炒香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "柠檬丝只炒十几秒，炒久会发苦涩口。",
      "visual_cue": "柠檬丝微卷，香气清酸"
    },
    {
      "n": 6,
      "text": "倒柠檬汁、清水、白糖和白醋烧开，下鸡块翻裹收汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "糖醋汁收到能挂勺就关火，久煮柠檬香会散。",
      "visual_cue": "鸡块裹满亮汁，盘底浓稠"
    }
  ],
  "tips": [
    "鸡块挂糊要薄，皮才脆而肉不柴。",
    "糖醋汁现调现淋，久放酸味会变淡。",
    "柠檬丝最后点缀，清香才不素不闷。"
  ],
  "common_mistakes": [
    "鸡块不挂糊直接煎，肉汁全跑光口感发干。",
    "糖醋汁不勾薄芡直接浇，盘底全是稀汤。",
    "柠檬连白瓤一起下锅，成品带明显苦味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600 克:600 克",
      "note": "更瘦，煎制时间缩短两分钟。"
    },
    {
      "original": "白醋",
      "substitute": "米醋",
      "ratio": "20 毫升:20 毫升",
      "note": "酸味更柔和，白糖可减五克。"
    }
  ],
  "variations": [
    "加一勺蜂蜜替换部分白糖，汁色更亮。",
    "撒一把炸芝麻，香气更足更下饭。"
  ],
  "serving_suggestion": "趁热连汁浇在鸡块上，配白饭或炒面都合适。",
  "storage": "冷藏一天，复热小火连汁翻热即可。",
