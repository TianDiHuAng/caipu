  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆纹切两毫米薄片，加生抽、料酒、白糖、白胡椒、玉米淀粉抓匀，再拌香油腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逆纹切才咬得动，顺纹切片炒出来像橡皮。",
      "visual_cue": "牛肉片薄而均匀，表面挂浆发亮。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加盐和两勺清水搅匀，蛋白蛋黄完全混合不见蛋筋。",
      "time_min": 3,
      "heat": "无火",
      "tip": "加少许清水蛋液更嫩，别加清水以外的液体，容易糊锅。",
      "visual_cue": "蛋液均匀，颜色浅黄。"
    },
    {
      "n": 3,
      "text": "炒锅烧热放一半花生油，下牛肉大火快炒到八成熟、仍带一点粉红时立即盛出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "牛肉只炒到八成熟，回锅后余温正好全熟，久炒就老。",
      "visual_cue": "牛肉边缘变色，中心微粉。"
    },
    {
      "n": 4,
      "text": "锅中补油转中小火，倒入蛋液稍等两秒再用锅铲从边缘推向中间，形成大片软蛋。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "蛋液半凝固就要推，全熟再推就成了碎蛋。",
      "visual_cue": "蛋液半凝，呈大片柔软状态。"
    },
    {
      "n": 5,
      "text": "蛋液还有流动性时倒回牛肉，加蚝油快速翻匀，蛋液裹住牛肉即可关火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "关火要早，余温会让蛋继续凝固，久了就成蛋饼。",
      "visual_cue": "蛋液湿润流动，牛肉被蛋包裹。"
    },
    {
      "n": 6,
      "text": "白饭盛进深碗，把滑蛋牛肉连汁浇在饭面，撒葱花和淋香油趁热上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "饭要热、汁要多，拌开才够滑。",
      "visual_cue": "蛋液自然流下，覆盖半个饭面。"
    }
  ],
  "tips": [
    "牛肉选里脊或吊龙，筋少肉嫩，炒久了也不至于太柴。",
    "蛋液加两勺清水是关键，成品才滑得像豆腐。",
    "全程火候宁小勿大，滑蛋最怕炒成干蛋块。"
  ],
  "common_mistakes": [
    "蛋液倒进锅就一直搅，蛋碎成渣，完全不成片。",
    "牛肉一次炒到全熟，回锅后老得嚼不动。",
    "饭不热就浇滑蛋，蛋液遇冷凝固，吃着发凉发腥。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "猪肩肉",
      "ratio": "1:1",
      "note": "梅花肉切薄片炒到全熟即可，猪肉须彻底熟透不能带粉红。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "3个:2个",
      "note": "鸭蛋腥味稍重，蛋液里加几滴料酒去腥。"
    }
  ],
  "variations": [
    "有的茶餐厅在蛋液里加一勺上汤，滑蛋更鲜更润。",
    "加几片洋葱丝同炒，甜味更明显，是日式滑蛋的做法。"
  ],
  "serving_suggestion": "浇在热白饭上趁热吃，配一杯冻奶茶；汁多可再添半碗饭。",
  "storage": "现做现吃，滑蛋不宜隔夜；牛肉可单独腌好冷藏一日内用完。",
