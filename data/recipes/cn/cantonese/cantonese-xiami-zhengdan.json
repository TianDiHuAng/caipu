  "equipment": [
    "蒸锅",
    "浅碗",
    "滤网",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾米用清水泡十分钟泡软，泡过的清水留着代替部分清水调蛋液。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡虾米的清水是鲜味所在，倒掉就浪费了。",
      "visual_cue": "虾米变软，泡水呈浅琥珀色"
    },
    {
      "n": 2,
      "text": "鸡蛋打散后加清水与泡虾米的水搅匀，加盐再用滤网过两遍。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛去掉浮沫与系带，蛋面蒸出来才像镜子。",
      "visual_cue": "蛋液澄净，表面没有气泡"
    },
    {
      "n": 3,
      "text": "蛋液倒入浅碗八分满，盖上盘子或保鲜膜扎孔，水开后中小火蒸八分钟。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "先蒸蛋再放虾米，虾米不会全部沉到碗底。",
      "visual_cue": "蛋面凝固，中间轻晃微颤"
    },
    {
      "n": 4,
      "text": "揭盖撒上虾米，继续蒸三分钟让鲜味慢慢渗进蛋里。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "虾米后放能保持口感，早放会沉底发硬。",
      "visual_cue": "虾米散落蛋面，颜色橙红"
    },
    {
      "n": 5,
      "text": "小锅烧热植物油淋在虾米上激出香气，撒葱花，再淋生抽与香油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "热油激在虾米上那一声响，就是这道菜的香气来源。",
      "visual_cue": "虾米表面泛油光，葱香冲鼻"
    }
  ],
  "tips": [
    "没有泡虾米的水就用温热清水，别用冷水，蛋羹会更嫩。",
    "蛋液与清水比例约一比一点二，蒸出来偏结实，适合拌饭吃。",
    "虾米本身带咸味，盐放一半的量就足够。",
    "蒸的时候锅盖留一条细缝，蛋面会更平整好看。"
  ],
  "common_mistakes": [
    "虾米不泡直接撒，蒸完硬得像小石子硌牙。",
    "冷水上锅蒸，蛋羹外层老了中间还是稀的。",
    "大火猛蒸，蛋面起满蜂窝孔，口感发柴。",
    "酱油一开始就加进蛋液，颜色发黑还盖住鲜味。"
  ],
  "substitutions": [
    {
      "original": "虾米",
      "substitute": "虾皮",
      "ratio": "20克:15克",
      "note": "更咸更小，盐要减半使用。"
    },
    {
      "original": "鸡蛋",
      "substitute": "嫩豆腐",
      "ratio": "3个:300克",
      "note": "做成豆腐蒸蛋，蒸的时间延长三分钟。"
    }
  ],
  "variations": [
    "生抽换成味道更柔和的淡酱油，咸鲜不压蛋香。",
    "出锅前再淋半勺香油，香气更足，配粥尤其合适。",
    "蛋液里再加一勺泡虾米的水，鲜味更复合有层次。"
  ],
  "serving_suggestion": "一勺下去蛋羹连着虾米，配白粥最舒服，也是最讨孩子喜欢的一道家常菜。",
  "storage": "冷藏可放一天，复蒸五分钟；虾米味道会随时间变重，当天吃完最佳。",
