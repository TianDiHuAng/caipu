  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉洗净血水，用盐抹匀表面腌十分钟，姜切片，小葱分葱白与葱绿切段。",
      "time_min": 12,
      "heat": "无火",
      "tip": "葱白葱绿分开用，葱白熬油、葱绿最后撒，香味才分层次。",
      "visual_cue": "鸡皮泛白，葱段长短一致。"
    },
    {
      "n": 2,
      "text": "汤锅放清水、姜片、料酒和一半葱白烧开，转小火把鸡腿浸入煮十五分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "水面只轻轻冒泡，滚大了鸡皮破、肉发柴。",
      "visual_cue": "鸡身鼓胀浮起，汤色清亮。"
    },
    {
      "n": 3,
      "text": "捞出鸡腿放凉，煮鸡的汤留一碗作葱油汁的底汤，其余撇油备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "鸡汤别倒，兑进葱油汁里鲜味翻倍。",
      "visual_cue": "鸡皮收紧，汤面浮一层薄油。"
    },
    {
      "n": 4,
      "text": "炒锅放植物油，下剩余葱白和姜丝，小火慢熬到葱段焦黄发干，捞出葱渣。",
      "time_min": 8,
      "heat": "小火",
      "tip": "全程小火，葱一焦黑整锅油都带苦味。",
      "visual_cue": "葱段缩水焦黄，油色转浅绿。"
    },
    {
      "n": 5,
      "text": "葱油里加生抽、盐和鸡底汤烧开，淋香油，撒入葱绿段烫出香味即成葱油汁。",
      "time_min": 4,
      "heat": "小火",
      "tip": "葱绿最后下，烫一下即可，煮久了发黄变味。",
      "visual_cue": "汁色浅褐，葱绿鲜亮。"
    },
    {
      "n": 6,
      "text": "鸡腿斩成两指宽条块摆盘，把葱油汁连葱一起浇在鸡皮上，静置片刻上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "浇汁后静置两分钟，让葱油渗进鸡皮更入味。",
      "visual_cue": "鸡皮油亮，葱段翠绿铺面。"
    }
  ],
  "tips": [
    "葱要多，油要足，葱油鸡的香全靠在油里慢慢熬出的葱味。",
    "鸡腿比鸡胸耐煮，浸十五分钟刚好断生又不柴。",
    "葱油汁里加一勺鸡底汤，鲜味更厚，还能省生抽。"
  ],
  "common_mistakes": [
    "熬葱油用大火，葱段瞬间焦黑，油带苦味。",
    "鸡腿煮太久，肉纤维散开，切块一夹就碎。",
    "葱油汁里不放底汤，只有咸味，缺少鸡的鲜。"
  ],
  "substitutions": [
    {
      "original": "小葱",
      "substitute": "大葱",
      "ratio": "1:1",
      "note": "大葱辛味更冲、甜味稍差，用量加两成，熬油时间延长两分钟。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "整鸡",
      "ratio": "1:1.3",
      "note": "整鸡浸十八分钟，斩件后可整盘浇汁，卖相更气派。"
    }
  ],
  "variations": [
    "有的做法在葱油里加一小把虾米同熬，鲜味更足。",
    "客家风味的葱油鸡会加两片沙姜进葱油，香气更霸道。"
  ],
  "serving_suggestion": "斩件浇葱油汁，配一碗白饭；葱油汁拌面也是一绝。",
  "storage": "冷藏可存两日，葱油汁单独装瓶冷藏可用一周；复热隔水蒸八分钟。",
