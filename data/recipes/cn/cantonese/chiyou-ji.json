  "steps": [
    {
      "n": 1,
      "text": "三黄鸡洗净擦干，剪去鸡屁股与脚爪，鸡腔内塞入姜片与葱结。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鸡身擦干，卤水才不会被稀释。",
      "visual_cue": "鸡皮干爽、腔内有姜葱"
    },
    {
      "n": 2,
      "text": "深锅加 1500ml 水、生抽、老抽、冰糖、料酒、盐、八角与桂皮，大火烧开转小火熬 5 分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "先熬香香料，卤水才有层次。",
      "visual_cue": "卤水呈红褐色、香气明显"
    },
    {
      "n": 3,
      "text": "提着鸡颈把整只鸡浸入卤水 10 秒再提起，重复 3 次让鸡皮收紧。",
      "time_min": 3,
      "heat": "小火",
      "tip": "三提三放让鸡皮紧实不破。",
      "visual_cue": "鸡皮收紧发亮、颜色均匀"
    },
    {
      "n": 4,
      "text": "整鸡放入卤水，保持微沸浸煮 18 分钟，中途翻面两次并用勺把卤水淋在鸡身上。",
      "time_min": 20,
      "heat": "小火",
      "tip": "水面只冒小泡，滚大了肉就柴。",
      "visual_cue": "最厚处能扎透、无血水"
    },
    {
      "n": 5,
      "text": "捞出整鸡立即放入冰水中浸 5 分钟，让鸡皮紧致爽脆。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冰水一激，鸡皮弹牙、肉汁锁住。",
      "visual_cue": "鸡皮起细密纹路、手感冰凉"
    },
    {
      "n": 6,
      "text": "沥干后刷一层香油，斩件摆盘，淋两勺过滤后的卤水即可。",
      "time_min": 8,
      "heat": "无火",
      "tip": "斩件时刀要快，切口才整齐。",
      "visual_cue": "皮色枣红油亮、骨内微红"
    }
  ],
  "tips": [
    "浸煮而不是大火煮，鸡肉才嫩滑。",
    "冰水激皮是粤式白切类菜的关键一步。",
    "卤水别扔，可冷藏留作下次的老卤。"
  ],
  "common_mistakes": [
    "全程大火滚煮，鸡肉发柴、鸡皮破裂。",
    "煮好不冰镇直接斩，鸡皮软塌没口感。",
    "卤水生抽放太多又久煮，成品过咸发黑。"
  ],
  "substitutions": [
    {
      "original": "三黄鸡",
      "substitute": "清远鸡",
      "ratio": "1000g 对 1000g",
      "note": "皮更薄，浸煮时间减 2 分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "麦芽糖",
      "ratio": "40g 对 30g",
      "note": "上色更亮，甜味更淡。"
    }
  ],
  "variations": [
    "玫瑰豉油鸡：卤水加 20ml 玫瑰露酒，香气更雅。",
    "电饭锅版：卤水与鸡放电饭锅，煮饭键跳起即熟。"
  ],
  "serving_suggestion": "斩件后淋卤水，配姜蓉或豉油碟蘸食。",
  "storage": "冷藏 2 天，冷冻 1 周；复热蒸 8 分钟，别用微波炉。",
