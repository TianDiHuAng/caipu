    "汤锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蛏子放进淡盐水里养两小时吐沙，中途换一次水，再用刷子刷净外壳。",
      "time_min": 120,
      "heat": "无火",
      "tip": "水里滴几滴香油，蛏子吐沙会更快更干净。",
      "visual_cue": "盆底沉下明显细沙"
    },
    {
      "n": 2,
      "text": "另烧一锅水，水开后下蛏子焯三十秒，贝壳刚张开就立刻捞出沥水。",
      "time_min": 4,
      "heat": "大火",
      "tip": "一开口就要捞出，多烫十秒蛏肉就缩成硬筋。",
      "visual_cue": "贝壳微张、蛏肉饱满"
    },
    {
      "n": 3,
      "text": "豆豉剁碎，蒜切末，姜切丝，红辣椒切圈，葱切段并分葱白葱绿备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "豆豉先剁碎再下锅，豉香才出得透、不夹颗。",
      "visual_cue": "配料颗粒大小均匀"
    },
    {
      "n": 4,
      "text": "炒锅烧热植物油，下豆豉、蒜末、姜丝、葱白和辣椒圈小火炒香。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "豆豉极容易糊，火要小，闻见豉香就够了。",
      "visual_cue": "油色转深、豉香扑鼻"
    },
    {
      "n": 5,
      "text": "转大火倒入蛏子，烹入料酒，加生抽、蚝油和白糖快速翻炒均匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火快炒，蛏肉才嫩且不会大量渗水。",
      "visual_cue": "蛏肉均匀裹上酱色"
    },
    {
      "n": 6,
      "text": "撒入葱绿段，尝味后视咸淡补少许盐，再翻两下立刻出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "蚝油和豆豉都很咸，盐要最后尝过再决定放不放。",
      "visual_cue": "葱绿翠亮、锅底无余汁"
    }
  ],
  "tips": [
    "蛏子必须吐净沙，泡水时加盐并滴几滴油，吐沙才彻底。",
    "焯水只是让贝壳张开，真正的熟度靠后面那两分钟爆炒完成。",
    "炒蛏子全程不加一滴水，蛏子自身出水足够，加水就没了锅气。"
  ],
  "common_mistakes": [
    "蛏子没吐沙就下锅，吃时满口细沙，整盘菜报废。",
    "焯水时间过长，蛏肉缩成一小团，嚼起来像橡皮筋。",
    "豆豉蚝油下锅后还额外补盐，成品咸得发苦。"
  ],
  "substitutions": [
    {
      "original": "蛏子",
      "substitute": "花蛤",
      "ratio": "500g 对 600g",
      "note": "花蛤壳厚，焯水时间要多加十秒才开口。"
    },
    {
      "original": "豆豉",
      "substitute": "豆瓣酱",
      "ratio": "15g 对 18g",
      "note": "豆瓣酱本身带辣带咸，盐量要减半。"
    }
  ],
  "variations": [
    "加一勺沙茶酱同炒，闽南风味更浓。",
    "起锅前淋半勺猪油，香气更厚更润。"
  ],
  "serving_suggestion": "趁热上桌，配冰啤酒或白粥都合适。",
  "storage": "现炒现吃，冷藏后再加热蛏肉发硬，不建议留存。",
