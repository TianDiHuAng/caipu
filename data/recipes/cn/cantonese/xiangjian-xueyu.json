  "equipment": [
    "平底锅",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼从冷藏取出回温十分钟，用厨房纸把两面水分吸干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱼身越干，煎出来的皮才越脆。",
      "visual_cue": "鱼身干爽、按下能回弹"
    },
    {
      "n": 2,
      "text": "鱼柳两面撒盐与黑胡椒，淋料酒抹匀后静置五分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "薄薄一层就够，鳕鱼味淡易盖住。",
      "visual_cue": "鱼身调味均匀、微微湿润"
    },
    {
      "n": 3,
      "text": "鱼柳两面拍一层薄薄的玉米淀粉，抖掉多余的粉。",
      "time_min": 2,
      "heat": "无火",
      "tip": "薄粉能锁汁，粉厚就变糊壳了。",
      "visual_cue": "鱼身泛白、不见干粉堆积"
    },
    {
      "n": 4,
      "text": "平底锅烧热倒植物油，放蒜片煸香后捞出蒜片留油。",
      "time_min": 2,
      "heat": "中火",
      "tip": "锅要热到冒青烟再下鱼。",
      "visual_cue": "蒜片微黄、油面微微起纹"
    },
    {
      "n": 5,
      "text": "鱼柳下锅先别动，中火煎三分钟让底面结出金黄脆壳。",
      "time_min": 3,
      "heat": "中火",
      "tip": "煎定型再翻，鱼肉才不会碎。",
      "visual_cue": "底面金黄、边缘由透明变白"
    },
    {
      "n": 6,
      "text": "用锅铲托住鱼身轻轻翻面，再煎两分钟至鱼肉全熟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "翻面用铲托而非戳，鱼柳才完整。",
      "visual_cue": "两面金黄、鱼肉层片可分开"
    },
    {
      "n": 7,
      "text": "关火放入黄油晃锅化开，让鱼身裹上一层黄油香气。",
      "time_min": 1,
      "heat": "小火",
      "tip": "黄油别烧焦，化开就关火。",
      "visual_cue": "锅中奶香散出、油色微黄"
    },
    {
      "n": 8,
      "text": "鱼柳盛盘，挤上柠檬汁再撒一把葱花即可上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "柠檬汁最后挤，酸香才清新。",
      "visual_cue": "鱼肉雪白分层、表面油亮"
    }
  ],
  "tips": [
    "鳕鱼选厚切的银鳕鱼，肉质更细嫩多汁。",
    "煎之前一定要擦干，水分是脆皮的敌人。",
    "没有黄油可用橄榄油加少许蒜末代替。"
  ],
  "common_mistakes": [
    "鱼身带水下锅，油花四溅还煎不脆。",
    "还没煎定型就急着翻面，鱼肉散成碎块。",
    "煎过头，鳕鱼纤维变干失去滑嫩口感。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "龙利鱼",
      "ratio": "300g 对 300g",
      "note": "更薄，煎制时间各减一分钟。"
    },
    {
      "original": "黄油",
      "substitute": "橄榄油",
      "ratio": "10g 对 10ml",
      "note": "风味更清爽，奶香会淡一些。"
    }
  ],
  "variations": [
    "出锅前淋一勺蒸鱼豉油，咸鲜更贴合中餐口味。",
    "配一小碟塔塔酱，风味更接近西式做法。"
  ],
  "serving_suggestion": "趁热吃最能吃到脆皮，配蔬菜沙拉或白饭都合适。",
  "storage": "冷藏可放一天，复热建议用平底锅回煎。",
