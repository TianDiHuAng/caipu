  "equipment": [
    "炒锅",
    "锅铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆着纹路切成两毫米薄片，用清水冲一遍挤干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逆纹切，牛肉才不塞牙。",
      "visual_cue": "肉片薄匀、表面无血水"
    },
    {
      "n": 2,
      "text": "牛肉加生抽、蚝油、料酒、白糖、白胡椒与淀粉抓匀腌十五分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "抓到发黏，浆才裹得牢。",
      "visual_cue": "肉片油润、浆膜均匀"
    },
    {
      "n": 3,
      "text": "鸡蛋打散，加盐、香油与一半葱花搅匀成蛋液。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液别打太狠，留点蛋筋更嫩。",
      "visual_cue": "蛋液均匀、葱花分布均匀"
    },
    {
      "n": 4,
      "text": "炒锅烧热下植物油，牛肉片摊开中大火滑炒到八成熟。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "八成熟就停，后面还要裹蛋液。",
      "visual_cue": "肉片变褐、边缘微卷"
    },
    {
      "n": 5,
      "text": "转小火倒入蛋液，用锅铲从底部轻推，让蛋液慢慢凝固。",
      "time_min": 3,
      "heat": "小火",
      "tip": "火要小，推得慢，蛋才滑嫩。",
      "visual_cue": "蛋液半凝、呈云絮状"
    },
    {
      "n": 6,
      "text": "蛋液还有一层湿润时就关火，撒剩余葱花与生姜末拌匀。",
      "time_min": 1,
      "heat": "无火",
      "tip": "余温会把蛋烘熟，别等全干。",
      "visual_cue": "蛋面湿润有光泽、肉片被裹住"
    },
    {
      "n": 7,
      "text": "趁热盛盘，淋上锅中剩余的蛋香油脂即可上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "立刻上桌，放久蛋就老了。",
      "visual_cue": "蛋体滑嫩、盘底微有油汁"
    }
  ],
  "tips": [
    "牛肉选里脊或牛柳，纤维细更嫩。",
    "蛋液里加一勺清水，成品更滑嫩。",
    "整道菜全程用小火慢慢推炒，是滑蛋的关键。"
  ],
  "common_mistakes": [
    "牛肉顺纹切，嚼起来又韧又费劲。",
    "火开得太大，蛋液一下锅就结成硬块。",
    "炒到蛋全干才关火，出锅又老又柴。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "猪里脊",
      "ratio": "250g 对 250g",
      "note": "更易熟，滑炒时间减半分钟。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "180g 对 180g",
      "note": "蛋香更浓，需多加少许料酒。"
    }
  ],
  "variations": [
    "加一把韭黄一起同炒，香气会更清雅。",
    "蛋液里加两勺牛奶，口感更绵滑。"
  ],
  "serving_suggestion": "趁热盖在米饭上，就是一碗滑蛋牛肉饭。",
  "storage": "当天吃完最好，复热之后蛋会变老发硬。",
