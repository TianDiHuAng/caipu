  "equipment": [
    "炒锅（最好碳钢锅）",
    "锅铲",
    "大平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆纹切 2mm 薄片，加盐、玉米淀粉、10ml 清水抓匀，再拌 10ml 植物油封住水分，腌 15 分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "油封能防止牛里脊下锅粘连，也让肉质更滑。",
      "visual_cue": "肉片表面发亮、每片都能分开"
    },
    {
      "n": 2,
      "text": "河粉用手轻轻抖散，若冷藏变硬，先微波 30 秒回软；调好生抽、老抽、蚝油、白糖与 10ml 清水的酱汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "河粉必须一条条分开，粘成块下锅必碎。",
      "visual_cue": "河粉根根分明，无粘连成块"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟，下 20ml 植物油，牛里脊片摊开大火煎 20 秒再翻面，八成熟立刻盛出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "锅一定要够热，牛里脊下锅不粘才算到位。",
      "visual_cue": "牛里脊边缘微焦、中心仍带一点粉"
    },
    {
      "n": 4,
      "text": "锅中补 15ml 油，下洋葱丝炒香，倒入河粉，用铲背轻推、快速翻匀，沿锅边淋入酱汁。",
      "time_min": 2,
      "heat": "大火",
      "tip": "不要用铲子切压河粉，用推和颠的方式翻，才不会断。",
      "visual_cue": "河粉均匀上色，透出油亮的酱色"
    },
    {
      "n": 5,
      "text": "加入豆芽、韭黄与牛里脊片回锅，大火颠炒 40 秒，撒葱段即可出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "豆芽韭黄最后放，保持脆口；出锅要快，久炒出水就变成湿炒。",
      "visual_cue": "豆芽仍挺直、盘底无积水"
    }
  ],
  "tips": [
    "成功的干炒牛河盘底应几乎无油无水，靠的是猛火与快速翻锅。",
    "河粉买回当天用最理想，冷藏超过两天会变硬易碎。",
    "家用炉火力不足时，把河粉分两次炒，锅温才降不下来。"
  ],
  "common_mistakes": [
    "锅不够热就下河粉，河粉粘锅碎裂，成品糊成一团。",
    "一次性倒入全部酱汁，河粉吸水变软，失去干香口感。",
    "牛里脊与河粉同炒到底，牛里脊过熟发柴。"
  ],
  "substitutions": [
    {
      "original": "河粉",
      "substitute": "宽米粉",
      "ratio": "1:1",
      "note": "宽米粉更耐炒，但吸汁少，酱汁可多加 5ml。"
    },
    {
      "original": "韭黄",
      "substitute": "韭菜",
      "ratio": "1:1",
      "note": "韭菜味更冲，用量减到 50g。"
    }
  ],
  "variations": [
    "家庭简化版：牛肉改用肥牛片，免腌制直接下锅，省 15 分钟。",
    "湿炒牛河：最后加 60ml 高汤与 5g 玉米淀粉勾薄芡，做成带汁版本。"
  ],
  "serving_suggestion": "出锅立即上桌，配一碟辣椒酱或喼汁；作为茶餐厅的午市主食最经典。",
  "storage": "现炒现吃，不建议保存；剩余河粉冷藏不超过 1 天，复热需重新下锅快炒。",
