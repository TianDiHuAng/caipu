  "equipment": [
    "炒锅",
    "锅铲",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆着纹理切成 0.2cm 薄片，加生抽、料酒与玉米淀粉抓匀腌 15 分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "逆纹切才咬得动，顺纹会发柴。",
      "visual_cue": "肉片挂浆、表面发亮"
    },
    {
      "n": 2,
      "text": "青椒去籽切菱形片，豆豉略剁碎，大蒜切末，姜切丝备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆豉剁碎更易出味。",
      "visual_cue": "配料切好、青椒片均匀"
    },
    {
      "n": 3,
      "text": "炒锅倒 30ml 植物油烧至五成热，下牛里脊片大火滑炒 40 秒至变色盛出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油温别太高，牛里脊滑散不结团。",
      "visual_cue": "牛里脊断生、片片自然分开"
    },
    {
      "n": 4,
      "text": "原锅加 15ml 植物油，小火炒香豆豉、蒜末与姜丝。",
      "time_min": 2,
      "heat": "小火",
      "tip": "豆豉小火炒，糊了会发苦。",
      "visual_cue": "豆豉出香、油色微深"
    },
    {
      "n": 5,
      "text": "转大火下青椒片翻炒 1 分钟至断生，回锅牛里脊片。",
      "time_min": 3,
      "heat": "大火",
      "tip": "青椒炒到断生就够，保持脆口。",
      "visual_cue": "青椒翠绿、边缘微软"
    },
    {
      "n": 6,
      "text": "加蚝油与盐快速翻匀，淋少许水淀粉收亮后立刻出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "回锅后不要久炒，牛里脊会老。",
      "visual_cue": "酱汁挂匀、肉片油亮"
    }
  ],
  "tips": [
    "牛里脊逆纹切薄片，口感才嫩不塞牙。",
    "上浆后静置几分钟，滑炒时不易脱浆。",
    "豆豉先炒香再下青椒，整道菜才有底味。"
  ],
  "common_mistakes": [
    "牛肉顺着纹理切，炒出来嚼不动还塞牙。",
    "滑炒油温过高，牛肉片黏成一坨。",
    "牛肉回锅后再久炒，出水变硬口感发柴。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛腿肉",
      "ratio": "400g 对 400g",
      "note": "腿肉筋膜多，需先剔净再切。"
    },
    {
      "original": "豆豉",
      "substitute": "豆豉酱",
      "ratio": "20g 对 25g",
      "note": "含盐高，盐减 1g。"
    }
  ],
  "variations": [
    "黑椒版：加 2g 黑胡椒碎同炒，风味更浓。",
    "加洋葱版：加 100g 洋葱片同炒，甜味更足。"
  ],
  "serving_suggestion": "配白米饭或炒河粉，粤式茶餐厅的经典组合。",
  "storage": "冷藏 1 天，复热用大火快炒 1 分钟。",
