    "小碗",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐连盒取出，倒扣在盘里切成两厘米见方的小块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "刀蘸水再切，豆腐边缘才整齐。",
      "visual_cue": "豆腐块方整、不散不碎"
    },
    {
      "n": 2,
      "text": "皮蛋剥去外壳，用细线或蘸过水的刀切成六瓣装盘备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刀蘸水再切，皮蛋的糖心才不粘刀。",
      "visual_cue": "皮蛋瓣完整、糖心不流散"
    },
    {
      "n": 3,
      "text": "小碗里放生抽、香醋、白糖与盐搅匀成调味汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调汁再摆盘，上桌动作更利落。",
      "visual_cue": "调味汁清亮、糖盐完全化开"
    },
    {
      "n": 4,
      "text": "把皮蛋瓣均匀摆在豆腐块周围，撒上大蒜末与葱花。",
      "time_min": 3,
      "heat": "无火",
      "tip": "皮蛋摆在豆腐外侧，卖相更好看。",
      "visual_cue": "黑白相间、摆盘紧凑"
    },
    {
      "n": 5,
      "text": "植物油烧到冒烟，趁热浇在蒜末上激出香味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "热油只浇蒜末，别浇在皮蛋上。",
      "visual_cue": "蒜香冲鼻、葱花微微卷起"
    },
    {
      "n": 6,
      "text": "淋上调好的味汁，静置五分钟入味即可上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置几分钟，豆腐才吃得住味。",
      "visual_cue": "汁水浸到盘底、豆腐边缘泛褐"
    }
  ],
  "tips": [
    "嫩豆腐提前冷藏，吃起来更爽口。",
    "皮蛋选溏心的，拌开之后口感更绵滑。",
    "没有香醋用陈醋替代，酸味稍重可减量。"
  ],
  "common_mistakes": [
    "豆腐直接用手掰，块形碎烂卖相差。",
    "皮蛋切得太大，拌的时候压碎豆腐。",
    "热油温度不够，蒜末激不出香味还发涩。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "内酯豆腐",
      "ratio": "350g 对 350g",
      "note": "更滑嫩，切块时动作要轻。"
    },
    {
      "original": "皮蛋",
      "substitute": "咸蛋",
      "ratio": "150g 对 120g",
      "note": "咸味更重，生抽减半。"
    }
  ],
  "variations": [
    "加一点辣椒油同拌，微辣更开胃。",
    "把皮蛋换成榨菜末，口感更清爽。"
  ],
  "serving_suggestion": "冷藏后当开胃凉菜，配粥或小酒都合适。",
  "storage": "当天吃完，隔夜豆腐会出水变味。",
