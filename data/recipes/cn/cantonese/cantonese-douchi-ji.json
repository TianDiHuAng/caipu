    "刀",
    "砧板",
    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成三厘米见方的块，用清水冲净血水后沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冲掉血水再沥干，煎的时候才不会出水。",
      "visual_cue": "鸡块干爽，颜色粉白"
    },
    {
      "n": 2,
      "text": "鸡块加料酒、生抽和淀粉抓匀，静置腌十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "淀粉锁住水分，焖出来鸡肉才嫩滑。",
      "visual_cue": "鸡块表面裹上薄浆"
    },
    {
      "n": 3,
      "text": "豆豉略冲一下沥干剁碎，蒜和姜切末，香葱切成段。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆豉剁碎香味才出得透，整粒容易咸口。",
      "visual_cue": "豆豉碎细，葱段青白分明"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，下姜末、蒜末和豆豉小火炒出香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆豉要小火慢炒，火大立刻发苦。",
      "visual_cue": "锅里油冒豉香，蒜末微黄"
    },
    {
      "n": 5,
      "text": "倒入鸡块转中火翻炒，炒到表面变白收紧定型。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡块下锅先别急着翻，定型后再炒才不粘。",
      "visual_cue": "鸡块表面转白，边缘微焦"
    },
    {
      "n": 6,
      "text": "加清水、蚝油和白糖拌匀，盖盖小火焖十二分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "水量只到鸡块一半，焖出来才浓稠不稀。",
      "visual_cue": "汤汁收浅，鸡肉吸饱颜色"
    },
    {
      "n": 7,
      "text": "开盖转大火收汁到浓稠裹住鸡块，撒香葱段出锅。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁时要不停翻炒，糖分容易糊锅底。",
      "visual_cue": "汤汁挂勺，鸡块油亮泛光"
    }
  ],
  "tips": [
    "豆豉本身很咸，生抽用量要比平时少一些。",
    "鸡块腌够时间，焖出来才嫩而有汁。",
    "收汁收到挂勺就停，过干会发柴发咸。"
  ],
  "common_mistakes": [
    "豆豉大火爆炒，几秒就焦苦整锅串味。",
    "鸡块下锅马上翻动，肉破皮粘锅成糊。",
    "清水加太多又收不干，成品像汤不像焖菜。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅中",
      "ratio": "600 克:650 克",
      "note": "胶质更多，焖制时间延长五分钟。"
    },
    {
      "original": "豆豉",
      "substitute": "豆瓣酱",
      "ratio": "30 克:35 克",
      "note": "辣味更明显，白糖减到三克。"
    }
  ],
  "variations": [
    "加几片香菇同焖，菌香与豉香很搭。",
    "起锅前淋几滴麻油，香气更立体。"
  ],
  "serving_suggestion": "配白饭最下饭，汁浇在饭上咸香浓。",
  "storage": "冷藏可放两天，复热加少量清水小火焖透。",
