  ],
  "equipment": [
    "汤锅",
    "冰水盆",
    "刀",
    "砧板",
    "挂钩"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡去净腔内的肺叶和血块，剪去爪尖和屁股，用清水冲洗干净后沥干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腔内血块是腥味来源，一定要抠净，冲到手感清爽。",
      "visual_cue": "鸡腔干净无血块，表皮泛白。"
    },
    {
      "n": 2,
      "text": "汤锅放清水、姜片、大葱结和料酒，大火烧到锅底冒细小气泡、水面尚未大滚。",
      "time_min": 10,
      "heat": "大火",
      "tip": "水不能滚开，一滚鸡皮就破，肉也发柴。",
      "visual_cue": "锅底冒细小气泡，水面微微晃动。"
    },
    {
      "n": 3,
      "text": "提着鸡脖子把整鸡浸入热水三秒再提起，反复三次让鸡皮均匀受热收紧。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "三提三放是鸡皮爽脆的关键，直接扔进去皮易破。",
      "visual_cue": "鸡皮由白转半透明，毛孔收紧。"
    },
    {
      "n": 4,
      "text": "整鸡浸入水中，保持水面似开非开浸煮十八分钟，中途翻一次身让受热均匀。",
      "time_min": 20,
      "heat": "微火",
      "tip": "两斤半的鸡浸十八分钟刚好断生，筷子插腿根能出清汁即可。",
      "visual_cue": "鸡身鼓胀浮起，腿根处轻按有弹性。"
    },
    {
      "n": 5,
      "text": "捞出整鸡立即放进冰水中浸十分钟，让鸡皮快速收缩定型，锁住肉汁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冰水要够冷够多，水温回升鸡皮就发软，失去爽脆感。",
      "visual_cue": "鸡皮紧绷透亮，皮下油脂凝白。"
    },
    {
      "n": 6,
      "text": "姜剁成蓉加盐拌匀，植物油烧到冒烟浇入姜蓉激香，做成姜葱蘸料。",
      "time_min": 5,
      "heat": "大火",
      "tip": "油要烧到冒烟再浇，姜的辛香才被激出来。",
      "visual_cue": "姜蓉滋滋作响，香气冲鼻。"
    },
    {
      "n": 7,
      "text": "鸡沥干后斩成两厘米宽的条块，按原形摆盘，配姜葱蘸料上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "斩鸡用重刀垂直下压，刀口整齐不流汁。",
      "visual_cue": "鸡皮金黄，切面骨边微红带汁。"
    }
  ],
  "tips": [
    "选两斤半左右的三黄鸡，皮薄肉嫩，太老的鸡浸出来发柴。",
    "浸鸡的水温保持在九十度上下，水面轻轻冒泡而不翻滚。",
    "冰镇这一步别省，皮爽肉滑全靠热胀冷缩。"
  ],
  "common_mistakes": [
    "水大滚时下鸡，鸡皮破裂、肉质紧缩，切开一盘碎皮。",
    "浸煮时间过长，腿肉发白无汁，吃起来像鸡胸。",
    "捞出后不冰镇，鸡皮软塌，蘸料也挂不住。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "1:0.8",
      "note": "用鸡腿浸十二分钟即可，皮少但肉更嫩，适合小家庭。"
    },
    {
      "original": "沙姜",
      "substitute": "姜",
      "ratio": "1:1",
      "note": "沙姜香气更霸道，没有时用普通姜加两滴香油代替。"
    }
  ],
  "variations": [
    "湛江白切鸡会在浸鸡水里加几片沙姜，皮香更足，蘸料也用沙姜蓉。",
    "有的店家把浸好的鸡挂起风干十分钟再斩，皮更爽、切面更干。"
  ],
  "serving_suggestion": "斩件摆盘后趁温热吃，配姜葱蓉和一碗鸡油拌饭；剩下的鸡架可煮粥。",
  "storage": "冷藏可存两日，斩件后密封冷冻一周；复热隔水蒸十分钟，别用微波炉久打。",
