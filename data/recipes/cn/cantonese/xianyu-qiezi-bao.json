    "砂锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "咸鱼用温水泡 15 分钟去咸，捞出沥干后撕成小块。",
      "time_min": 15,
      "heat": "无火",
      "tip": "泡过的咸鱼咸味柔和，不易死咸。",
      "visual_cue": "咸鱼回软、咸味减轻"
    },
    {
      "n": 2,
      "text": "茄子去蒂切 4cm 长条，泡在清水里防止氧化发黑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "茄条泡水后再炒，省油也不吸黑。",
      "visual_cue": "茄条洁白、不发黑"
    },
    {
      "n": 3,
      "text": "五花肉切小丁，大蒜拍碎，姜切丝，小葱切段备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "肉丁切小些，煸出的油才多。",
      "visual_cue": "配料切好、大小均匀"
    },
    {
      "n": 4,
      "text": "炒锅倒 40ml 植物油，中火把五花肉丁煸出油，下姜蒜炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉丁煸到微黄，整锅才有底香。",
      "visual_cue": "肉丁出油、边缘微黄"
    },
    {
      "n": 5,
      "text": "下咸鱼块中小火炒出香味，再放茄条翻炒至表面吸油。",
      "time_min": 5,
      "heat": "中火",
      "tip": "咸鱼先炒香，腥味才不会留在菜里。",
      "visual_cue": "咸鱼香浓、茄条微软"
    },
    {
      "n": 6,
      "text": "加生抽、蚝油与清水煮开，转砂锅小火焖 8 分钟，撒小葱段。",
      "time_min": 13,
      "heat": "小火",
      "tip": "转砂锅焖，热气均匀茄条才软透。",
      "visual_cue": "汤汁浓稠、茄条软糯"
    }
  ],
  "tips": [
    "咸鱼先泡水再炒，成菜咸度才好控制。",
    "茄条先泡清水，既能防氧化也少吸油。",
    "用砂锅小火焖，茄条更软糯入味。"
  ],
  "common_mistakes": [
    "咸鱼没泡水就下锅，整锅咸到发苦。",
    "茄子大火干炒，外焦内生还吸满油。",
    "焖煮时间不足，茄条硬芯没软透。"
  ],
  "substitutions": [
    {
      "original": "咸鱼",
      "substitute": "虾酱",
      "ratio": "80g 对 30g",
      "note": "虾酱更咸，生抽减半。"
    },
    {
      "original": "五花肉",
      "substitute": "腊肠",
      "ratio": "100g 对 100g",
      "note": "腊肠自带甜味，蚝油减 5g。"
    }
  ],
  "variations": [
    "素版：省去五花肉，改用 20g 香菇丁增香。",
    "加粉丝版：砂锅底部垫 80g 泡软粉丝同焖。"
  ],
  "serving_suggestion": "砂锅连盖端上桌，揭盖时香气最冲，配白饭最下饭。",
  "storage": "冷藏 1 天，复热加少许清水小火焖 5 分钟。",
