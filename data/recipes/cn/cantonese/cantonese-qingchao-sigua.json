  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "丝瓜用刀背刮去外层薄皮，保留一点青皮，切成滚刀块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "只刮薄皮别削太深，留青皮炒出来更挺不易烂。",
      "visual_cue": "块面青白相间，切块均匀"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧到微热，下蒜末与姜丝小火煸出香味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末小火煸香，火大立刻焦苦，整锅都毁。",
      "visual_cue": "蒜末转浅黄，香气明显"
    },
    {
      "n": 3,
      "text": "转大火倒入丝瓜块，快速翻炒到边缘变软出水。",
      "time_min": 3,
      "heat": "大火",
      "tip": "全程用大火快炒，丝瓜才会保持翠绿，火小了出水就发黑。",
      "visual_cue": "丝瓜边缘透明，锅底泛出清汁"
    },
    {
      "n": 4,
      "text": "加盐与白糖翻匀后加盖焖一分钟，让丝瓜自己出汁变软。",
      "time_min": 2,
      "heat": "中火",
      "tip": "焖一分钟刚刚好，时间一长丝瓜就化成泥，没了口感。",
      "visual_cue": "丝瓜软身出汁，颜色仍翠"
    },
    {
      "n": 5,
      "text": "淋上香油快速翻匀后马上出锅，连盘底的汤汁一起装。",
      "time_min": 1,
      "heat": "大火",
      "tip": "盘底那点汤汁是整道菜最鲜甜的部分，千万别倒掉。",
      "visual_cue": "瓜块碧绿透亮，汤汁清亮"
    }
  ],
  "tips": [
    "丝瓜切好马上下锅，放久了会氧化发黑。",
    "用铁锅炒容易发黑，改用不粘锅或炒锅擦净再用。",
    "加两个虾仁或一点瑶柱同炒，清甜里多一层鲜。"
  ],
  "common_mistakes": [
    "丝瓜削皮太深只剩白肉，炒出来软塌无口感。",
    "火太小慢慢炒，丝瓜出水变成一锅汤。",
    "提前切好放着不炒，氧化发黑，卖相全无。"
  ],
  "substitutions": [
    {
      "original": "丝瓜",
      "substitute": "冬瓜",
      "ratio": "350克:350克",
      "note": "冬瓜更耐炒，焖的时间延长两分钟。"
    },
    {
      "original": "蒜",
      "substitute": "小葱",
      "ratio": "12克:15克",
      "note": "用葱段爆香，风味更清雅。"
    }
  ],
  "variations": [
    "加几片瘦肉同炒，荤素搭配，是广东家常最常见的做法。",
    "把丝瓜换成节瓜，口感更紧实，适合焖煮。"
  ],
  "serving_suggestion": "趁热吃，汤汁清甜，作为夏天的主菜配白饭最舒服。",
  "storage": "冷藏可存一天，复热须回锅快炒，久放会出水发酸。",
