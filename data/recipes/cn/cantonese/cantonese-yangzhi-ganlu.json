        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "料理棒",
    "细筛",
    "玻璃碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "清水烧开，西米倒入锅中中火煮十五分钟，边煮边搅防止粘底。",
      "time_min": 15,
      "heat": "中火",
      "tip": "西米要水大开才下锅，冷水下锅会化成糊，煮不出一颗颗的透明珠。",
      "visual_cue": "西米中心剩小白点，外围透明"
    },
    {
      "n": 2,
      "text": "关火盖盖焖五分钟，西米完全透明后捞出过凉，沥干备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "焖比继续煮更稳，煮久了西米就烂成浆，焖到全透明才弹牙。",
      "visual_cue": "西米通体透明，粒粒分明"
    },
    {
      "n": 3,
      "text": "芒果去皮去核，三分之二果肉用料理棒打成细腻果泥，剩下的切小丁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "果泥打得越细口感越滑，留一部分切丁才有嚼头。",
      "visual_cue": "果泥细腻无颗粒，果丁整齐"
    },
    {
      "n": 4,
      "text": "果泥与椰浆、牛奶、白糖拌匀，尝味后加入西米与芒果丁，冷藏半小时。",
      "time_min": 8,
      "heat": "无火",
      "tip": "冷藏后甜味会变淡，拌的时候糖可以稍微多放一点。",
      "visual_cue": "甜品浓稠顺滑，果丁分布均匀"
    }
  ],
  "tips": [
    "杨枝甘露是香港酒楼的经典甜品，讲究芒果香、椰香和西米的弹牙三层口感。",
    "加一勺西柚果粒会多一分微苦的清酸，更接近茶餐厅版本。",
    "芒果选台农或小台芒，纤维少、甜度高，打泥最顺滑。"
  ],
  "common_mistakes": [
    "西米冷水下锅，煮成一锅浆糊，捞都捞不起来。",
    "芒果没熟透就拿来打泥，成品发酸带涩，只能靠加糖硬压。",
    "拌好后放冷冻想快点凉，冻成冰碴，西米口感全毁。"
  ],
  "substitutions": [
    {
      "original": "椰浆",
      "substitute": "椰奶",
      "ratio": "200毫升:220毫升",
      "note": "椰奶稀一些，牛奶可减到五十毫升。"
    },
    {
      "original": "西米",
      "substitute": "小汤圆",
      "ratio": "80克:100克",
      "note": "汤圆版需另煮，口感更糯。"
    }
  ],
  "variations": [
    "加一勺淡奶油同拌，质地更厚，接近酒店版本。",
    "把芒果换成木瓜与西柚，做成双色版本，酸甜层次更明显。"
  ],
  "serving_suggestion": "装进玻璃碗冷藏后食用，表面点几粒芒果丁，配一球香草冰淇淋更奢侈。",
  "storage": "冷藏当天吃完最佳，勿超过一天，西米久泡会返硬失弹。",
