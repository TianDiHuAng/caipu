  "equipment": [
    "炒锅",
    "蒸锅",
    "深碗",
    "刀",
    "砧板",
    "牙签"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加料酒与八角煮二十分钟，捞出趁热用牙签在表面密密扎孔。",
      "time_min": 20,
      "heat": "中火",
      "tip": "扎孔是为了让皮下油脂逼出来，成品才会起皱起泡。",
      "visual_cue": "五花肉表面布满细孔，肉块收紧"
    },
    {
      "n": 2,
      "text": "用厨房纸吸干五花肉表面的水分，抹一层老抽上色，静置五分钟让颜色吃进去。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面有水会炸油，务必吸干再下锅，安全第一。",
      "visual_cue": "肉面呈匀净的深酱色，摸着干爽"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，肉面朝下入锅盖上挡油盖，炸到起泡呈虎皮状。",
      "time_min": 8,
      "heat": "中火",
      "tip": "盖挡油盖是保命动作，炸的时候油会四处飞溅。",
      "visual_cue": "肉面鼓起密集小泡，色如深褐虎皮"
    },
    {
      "n": 4,
      "text": "炸好的肉块泡进清水里十分钟让表面回软，再切成半厘米厚的夹刀片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡清水能让虎皮软化，切片时不碎也不卷边。",
      "visual_cue": "肉面变软起皱，片形平整不散"
    },
    {
      "n": 5,
      "text": "腐乳压成泥拌入蒜末、生抽与冰糖调成酱汁，把肉片与芋头片分别裹匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腐乳本身够咸，生抽别多放，最好先尝一口再调。",
      "visual_cue": "每片肉与芋头都挂上红褐色酱汁"
    },
    {
      "n": 6,
      "text": "深碗里一片五花肉夹一片芋头码紧，肉面朝下压平，淋上剩下的酱汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "码得越紧蒸完越不容易散，倒扣出来才完整好看。",
      "visual_cue": "碗面平整紧实，酱汁漫到八分满"
    },
    {
      "n": 7,
      "text": "上锅大火蒸五十分钟至肉面软糯，取出滗出汤汁，倒扣在深盘上再淋回汤汁。",
      "time_min": 50,
      "heat": "大火",
      "tip": "蒸够时间肉才会一抿就化，中途尽量别开盖。",
      "visual_cue": "筷子能轻松穿透肉皮，芋头粉糯"
    }
  ],
  "tips": [
    "芋头选粉质的荔浦芋，蒸完才绵密不散成泥。",
    "炸肉的时候用锅盖挡着，安全永远是第一位的。",
    "滗出的汤汁勾一层薄芡再淋回去，卖相会更亮。",
    "隔夜再蒸一次更入味，这是年菜最常见的做法。"
  ],
  "common_mistakes": [
    "肉面没扎孔就下油锅，皮炸不起来依旧硬邦邦咬不动。",
    "炸之前表面没吸干水，油溅得整个灶台都是。",
    "芋头切得太薄，蒸完化成泥撑不住肉片。",
    "蒸的时间不够，肉皮咬不动、肥肉入口发腻。"
  ],
  "substitutions": [
    {
      "original": "芋头",
      "substitute": "土豆",
      "ratio": "400克:400克",
      "note": "口感偏软，蒸的时间可减十分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "梅花肉",
      "ratio": "600克:600克",
      "note": "肥肉少，蒸完偏干但没那么腻。"
    }
  ],
  "variations": [
    "把腐乳换成另一种咸香酱料，就走到了梅菜扣肉的路子上。",
    "多放两瓣大蒜同蒸，辛香压住油腻，回味更清爽。",
    "芋头切厚一点，蒸完更有嚼头，也不容易化在碗底。"
  ],
  "serving_suggestion": "倒扣上桌时肉面朝上，深褐油亮，配一碗白饭与清炒时蔬，一人两片刚刚好。",
  "storage": "冷藏可放三天，复蒸二十分钟即可上桌，风味比刚做好时更融合。",
