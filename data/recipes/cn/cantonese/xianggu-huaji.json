  "equipment": [
    "蒸锅",
    "深盘",
    "保鲜盒"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成三厘米块，用清水抓洗两遍去血水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "抓洗到水变清，蒸出来才不腥。",
      "visual_cue": "鸡块发白、水色清透"
    },
    {
      "n": 2,
      "text": "鸡块沥干后用厨房纸吸干水分，放入保鲜盒中。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水分吸干，腌料才挂得住。",
      "visual_cue": "鸡块干爽、不见水光"
    },
    {
      "n": 3,
      "text": "鸡块加生抽、蚝油、料酒、白糖、白胡椒与盐抓匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "抓揉到酱汁被完全吸收。",
      "visual_cue": "鸡块红褐油亮、盒底无汁"
    },
    {
      "n": 4,
      "text": "加姜丝与蒜片继续抓匀，冷藏腌二十分钟让味道进透。",
      "time_min": 20,
      "heat": "无火",
      "tip": "姜蒜同腌，能压住鸡肉腥味。",
      "visual_cue": "鸡块带姜蒜香、肉质紧实"
    },
    {
      "n": 5,
      "text": "香菇切厚片加入盒中抓匀，撒玉米淀粉拌到看不见干粉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "淀粉裹匀，蒸后肉汁才不流失。",
      "visual_cue": "鸡块与菇片均匀挂浆"
    },
    {
      "n": 6,
      "text": "最后淋植物油拌匀，把料平铺在深盘中不要堆太厚。",
      "time_min": 3,
      "heat": "无火",
      "tip": "铺平受热均匀，蒸得更透。",
      "visual_cue": "料面平整、盘中不见积水"
    },
    {
      "n": 7,
      "text": "蒸锅水烧开，上锅大火蒸十二分钟至鸡肉熟透。",
      "time_min": 15,
      "heat": "大火",
      "tip": "上汽后计时，别提前揭盖。",
      "visual_cue": "鸡肉转白、盘中见清亮汤汁"
    },
    {
      "n": 8,
      "text": "取出后撒上葱花，淋香油提香，趁热端上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "趁热吃最滑嫩，凉了肉质发紧。",
      "visual_cue": "鸡汤清亮、葱花翠绿"
    }
  ],
  "tips": [
    "用去骨鸡腿肉最滑嫩，鸡胸容易蒸老。",
    "腌好后加淀粉和油，是滑鸡的关键两步。",
    "盘底可垫两片姜，去腥还能防粘。"
  ],
  "common_mistakes": [
    "鸡块没吸干水分就腌，蒸出半盘水。",
    "料堆得太厚，外层熟了里面还带血。",
    "蒸过头，鸡肉缩水发柴失去滑嫩感。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "猪排骨",
      "ratio": "500g 对 500g",
      "note": "蒸制时间延长到十八分钟。"
    },
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "120g 对 20g",
      "note": "干木耳需提前泡发撕朵。"
    }
  ],
  "variations": [
    "加几片腊肠同蒸，油脂渗入更香。",
    "换成豆豉蒸，就是豉汁滑鸡风味。"
  ],
  "serving_suggestion": "连汤汁一起浇在白饭上，滑嫩鲜香最下饭。",
  "storage": "冷藏可放两天，复热需蒸五分钟回嫩。",
