    "蒸锅",
    "牙签"
  ],
  "steps": [
    {
      "n": 1,
      "text": "梅干菜用温水泡二十分钟，多次抓洗去沙，挤干后切碎，用植物油和蒜末煸香备用。",
      "time_min": 20,
      "heat": "中火",
      "tip": "干菜一定要洗到水清，不然满口沙。",
      "visual_cue": "干菜碎松散、带蒜香"
    },
    {
      "n": 2,
      "text": "五花肉整块冷水下锅，加姜片与料酒煮二十分钟至七分熟，捞出擦干，表皮用牙签密集扎孔。",
      "time_min": 22,
      "heat": "大火",
      "tip": "扎孔能让上色渗进去，炸时也易起虎皮。",
      "visual_cue": "肉皮密布小孔、表面干爽"
    },
    {
      "n": 3,
      "text": "趁热在老抽里滚一圈上色，肉皮朝下放入六成热油中炸三分钟起虎皮，取出泡温水十分钟。",
      "time_min": 15,
      "heat": "中大火",
      "tip": "下锅前擦干水分，否则油会爆溅。",
      "visual_cue": "肉皮起皱呈虎皮纹、颜色深红"
    },
    {
      "n": 4,
      "text": "肉块放凉后切成半厘米厚的片，肉皮朝下整齐码进深碗。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切薄一点，蒸后入口即化。",
      "visual_cue": "肉片厚薄一致、码放紧实"
    },
    {
      "n": 5,
      "text": "把煸香的梅干菜铺在肉片上压实，淋生抽与冰糖，倒入少量煮肉原汤。",
      "time_min": 4,
      "heat": "无火",
      "tip": "干菜压紧实，倒扣时才不散。",
      "visual_cue": "干菜铺满碗面、汤汁约齐碗沿"
    },
    {
      "n": 6,
      "text": "开盖尝味，按干菜咸度加盐，撒上葱段即可倒扣出盘。",
      "time_min": 90,
      "heat": "大火",
      "tip": "蒸够时间，肥肉才化成透明状。",
      "visual_cue": "倒扣完整、肉皮朝上红亮"
    }
  ],
  "tips": [
    "炸肉皮时锅盖半掩着，防止热油溅出来伤人。",
    "蒸好后汤汁可倒出勾薄芡再淋回，卖相更好。",
    "梅干菜咸度差异大，盐放到最后再决定。"
  ],
  "common_mistakes": [
    "肉皮不扎孔就炸，虎皮起不来也不上色。",
    "肉片切得太厚，蒸完仍然硬邦邦不入味。",
    "干菜没煸就直接蒸，味道寡淡出水。"
  ],
  "substitutions": [
    {
      "original": "梅干菜",
      "substitute": "干豆角",
      "ratio": "100g 对 100g",
      "note": "干豆角更耐蒸，需泡两小时。"
    },
    {
      "original": "五花肉",
      "substitute": "梅头肉",
      "ratio": "600g 对 600g",
      "note": "梅头肉更瘦，蒸的时间加到一百分钟。"
    }
  ],
  "variations": [
    "碗底垫几片芋头，吸汁后绵软香甜。",
    "加两颗八角同蒸，香气层次更足。"
  ],
  "serving_suggestion": "倒扣上桌趁热吃，配一碗白饭最香。",
  "storage": "冷藏三天，复热再蒸三十分钟口感恢复。",
