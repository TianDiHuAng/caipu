  "equipment": [
    "砂锅",
    "刀",
    "砧板",
    "碗",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿剁成四厘米见方的块，冲洗干净后沥干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鸡块带骨剁，炖出来的汤更鲜。",
      "visual_cue": "鸡块大小均匀，表面无血水"
    },
    {
      "n": 2,
      "text": "姜切成半厘米厚的大片，量要足，黄酒鸡靠姜压腥驱寒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "姜片厚才经得起长时间煸炒，不会焦。",
      "visual_cue": "姜片厚薄一致，约十五片"
    },
    {
      "n": 3,
      "text": "砂锅倒植物油，小火下姜片慢煸五分钟至边缘卷曲发黄。",
      "time_min": 6,
      "heat": "小火",
      "tip": "姜要煸透，姜味融进油里，整锅才暖。",
      "visual_cue": "姜片金黄卷边，姜香浓"
    },
    {
      "n": 4,
      "text": "转大火倒入鸡块，翻炒三分钟至表面变白收紧。",
      "time_min": 4,
      "heat": "大火",
      "tip": "鸡皮朝下先煎一下，出油更香。",
      "visual_cue": "鸡块表面变白，皮微黄"
    },
    {
      "n": 5,
      "text": "沿锅边淋生抽，加冰糖与盐，翻炒一分钟让鸡块上色。",
      "time_min": 2,
      "heat": "大火",
      "tip": "冰糖可省，但客家做法讲究一点回甜。",
      "visual_cue": "鸡块均匀上色，锅底油亮"
    },
    {
      "n": 6,
      "text": "倒入五百毫升黄酒，量基本没过鸡块，大火烧开后撇去浮沫。",
      "time_min": 4,
      "heat": "大火",
      "tip": "全程不加一滴水，全部用酒，味道才纯。",
      "visual_cue": "酒液翻滚，酒香冲鼻"
    },
    {
      "n": 7,
      "text": "转小火盖盖炖二十五分钟，让酒味与鸡肉充分融合。",
      "time_min": 27,
      "heat": "小火",
      "tip": "小火慢炖，酒味会变醇，不会冲。",
      "visual_cue": "汤色转深琥珀，鸡肉酥软"
    },
    {
      "n": 8,
      "text": "开盖撇去表面浮油，尝味补盐，撒葱段关火。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先尝再补盐，黄酒本身带一点甜咸。",
      "visual_cue": "汤汁油亮清透，葱段翠绿"
    }
  ],
  "tips": [
    "客家人用自酿的娘酒，买不到就用半甜型黄酒。",
    "姜量大是这道菜的特点，别嫌多，煸透了一点不辣。",
    "坐月子的版本会再加一只鸡蛋同炖，更补。",
    "剩下的汤拌饭或煮面线，一点都别浪费。"
  ],
  "common_mistakes": [
    "用料酒代替黄酒，酒味冲且发酸，完全没有醇香。",
    "加水中和酒味，汤变淡，菜也不香。",
    "姜片不煸直接炖，姜味生硬，去腥效果也差。"
  ],
  "substitutions": [
    {
      "original": "黄酒",
      "substitute": "米酒",
      "ratio": "500毫升:500毫升",
      "note": "甜度低，冰糖可加五克。"
    },
    {
      "original": "鸡腿",
      "substitute": "整鸡",
      "ratio": "800克:900克",
      "note": "炖制时间加十分钟。"
    }
  ],
  "variations": [
    "加一把枸杞同炖，颜色更亮，甜味更柔。",
    "把鸡块换成猪蹄，做成黄酒猪蹄，胶质更足。"
  ],
  "serving_suggestion": "三人份主菜兼汤，配白饭或面线，冬天吃最暖。",
  "storage": "冷藏两天内吃完，复热时加两勺黄酒补香；含酒菜肴不建议给儿童大量食用。",
