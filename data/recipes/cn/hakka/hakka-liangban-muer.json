  "steps": [
    {
      "n": 1,
      "text": "干木耳用冷水浸泡三十分钟至完全舒展，剪去根部硬蒂后撕成小朵。",
      "time_min": 32,
      "heat": "无火",
      "tip": "木耳只能用冷水泡，热水泡出来外烂内硬，口感全毁。",
      "visual_cue": "耳片舒展肥厚，根部硬块剪净"
    },
    {
      "n": 2,
      "text": "泡好的木耳用流水冲洗三遍，仔细搓洗褶皱里的细沙。",
      "time_min": 5,
      "heat": "无火",
      "tip": "褶皱里最容易藏沙，搓洗到水清才不牙碜。",
      "visual_cue": "耳片洁净透亮，盆底无沉沙"
    },
    {
      "n": 3,
      "text": "汤锅烧开水，下木耳焯三分钟，捞出立刻放入冰水中浸凉。",
      "time_min": 5,
      "heat": "大火",
      "tip": "木耳必须焯透才吃得安全，捞出后立刻放进冰水里激一下，口感会变得更加脆弹。",
      "visual_cue": "耳片卷曲发亮，捏起来有弹性"
    },
    {
      "n": 4,
      "text": "碗中放蒜末、小米椒圈与葱花，浇一勺烧到冒烟的植物油激出香味。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油一定要烧到微微冒烟再泼下去，蒜末的香味才炸得开，冷油泼只有生辣味。",
      "visual_cue": "蒜末滋滋作响，香气冲鼻"
    },
    {
      "n": 5,
      "text": "往碗里加米醋、生抽、白糖、盐与香油搅匀成调味汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调好的汁尝一口，酸咸要略重一点，拌上木耳才刚好。",
      "visual_cue": "汁液深褐透亮，酸香明显"
    },
    {
      "n": 6,
      "text": "沥干的木耳放入大碗，倒入调味汁与香菜段拌匀，冷藏半小时更入味。",
      "time_min": 30,
      "heat": "无火",
      "tip": "拌好后冷藏一会儿，酸辣味才渗进耳片里。",
      "visual_cue": "耳片裹满酱汁，颜色油亮"
    }
  ],
  "tips": [
    "木耳泡发别超过两小时，室温久泡容易滋生细菌。",
    "加一把炸花生米同拌，脆感翻倍，下酒极好。",
    "爱吃麻的可加几滴花椒油，风味更立体。"
  ],
  "common_mistakes": [
    "用热水泡木耳，外面烂软里面还是硬的。",
    "木耳不焯水直接凉拌，既不卫生也带土腥味。",
    "泡了一整夜才用，木耳发黏变味，有食品安全风险。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "陈醋",
      "ratio": "35毫升:30毫升",
      "note": "陈醋色深味厚，白糖可加两克。"
    },
    {
      "original": "小米椒",
      "substitute": "干辣椒",
      "ratio": "8克:6克",
      "note": "干辣椒须用热油泼香再用。"
    }
  ],
  "variations": [
    "加黄瓜丝与胡萝卜丝同拌，色彩更丰富，也更清爽。",
    "换成泰式口味，加鱼露与青柠汁，酸辣更明亮。"
  ],
  "serving_suggestion": "冰镇后作为开胃小菜最合适，配粥、配酒都很搭。",
  "storage": "密封冷藏可存两天，取食须用干净筷子，久放出水会变淡。",
