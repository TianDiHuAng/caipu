  "equipment": [
    "炒锅",
    "深碗",
    "蒸锅",
    "牙签"
  ],
  "steps": [
    {
      "n": 1,
      "text": "梅干菜用温水泡发三十分钟，反复揉洗掉泥沙后挤干。",
      "time_min": 30,
      "heat": "无火",
      "tip": "梅干菜沙多，至少洗三遍。",
      "visual_cue": "梅干菜舒展、水中不见泥沙"
    },
    {
      "n": 2,
      "text": "五花肉整块冷水下锅，加姜片、葱段与料酒煮二十分钟。",
      "time_min": 22,
      "heat": "中火",
      "tip": "煮到筷子能插透肉皮即可。",
      "visual_cue": "肉块紧实、肉皮变软"
    },
    {
      "n": 3,
      "text": "捞出肉块趁热用牙签在肉皮上密扎小孔，擦干表面水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "扎孔能让皮起泡更酥。",
      "visual_cue": "肉皮布满细孔、表面干爽"
    },
    {
      "n": 4,
      "text": "肉皮抹一层老抽上色，晾五分钟让颜色吃进皮里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "抹完要晾干，下锅才不炸油。",
      "visual_cue": "肉皮深红发亮、表面干爽"
    },
    {
      "n": 5,
      "text": "锅中倒植物油烧到六成热，肉皮朝下煎到起泡上色。",
      "time_min": 4,
      "heat": "中火",
      "tip": "盖上锅盖留缝，防油溅伤人。",
      "visual_cue": "肉皮起细密小泡、颜色枣红"
    },
    {
      "n": 6,
      "text": "肉块放凉后切成半厘米厚的大片，皮朝下码入深碗。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切得薄一些更易蒸透入味。",
      "visual_cue": "肉片均匀、皮肉相连不散"
    },
    {
      "n": 7,
      "text": "锅中留底油下梅干菜、八角与姜末炒香，加生抽、盐、白胡椒与冰糖调味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "梅干菜炒过才出酱香。",
      "visual_cue": "梅干菜干香、锅底无多余水分"
    },
    {
      "n": 8,
      "text": "炒好的梅干菜铺在肉片上压实，淋上料酒与少许清水。",
      "time_min": 3,
      "heat": "无火",
      "tip": "压紧实，蒸后倒扣才成型。",
      "visual_cue": "梅干菜盖满肉面、碗内见汁"
    },
    {
      "n": 9,
      "text": "蒸锅上汽后放入深碗，中火蒸九十分钟至肉软糯。",
      "time_min": 90,
      "heat": "中火",
      "tip": "蒸足时间，肉才入口即化。",
      "visual_cue": "筷子轻戳肉皮即透"
    },
    {
      "n": 10,
      "text": "取出滗出汤汁，倒扣在盘中，把汤汁回锅勾薄芡淋上。",
      "time_min": 4,
      "heat": "中火",
      "tip": "倒扣前先滗汁，才不洒得到处都是。",
      "visual_cue": "肉片整齐扣出、酱汁油亮"
    }
  ],
  "tips": [
    "梅干菜选颜色乌黑、香气浓的，甜梅菜偏淡。",
    "肉块煮好后压一块重物，切出的片更平整。",
    "蒸之前可以分碗装好冷冻，吃时直接蒸。"
  ],
  "common_mistakes": [
    "肉皮没擦干就下油锅，油花炸得满灶台。",
    "梅干菜没洗净沙，成品带牙碜感。",
    "蒸的时间不够，肉皮咬起来发硬不糯。"
  ],
  "substitutions": [
    {
      "original": "梅干菜",
      "substitute": "芽菜",
      "ratio": "80g 对 70g",
      "note": "咸度更高，生抽需减半。"
    },
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "600g 对 600g",
      "note": "脂肪少，蒸制时间缩短二十分钟。"
    }
  ],
  "variations": [
    "加几片芋头垫底同蒸，就是客家芋头扣肉。",
    "换成干豆角同蒸，风味更清甜也更有嚼劲。"
  ],
  "serving_suggestion": "倒扣上桌最有气势，配白饭连汁一起吃。",
  "storage": "冷藏可放三天，蒸热后风味更好。",
