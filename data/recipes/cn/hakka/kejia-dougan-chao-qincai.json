  "steps": [
    {
      "n": 1,
      "text": "豆腐干切成一厘米粗、五厘米长的条，切得粗细一致更容易入味。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆干切太细炒完发干，一厘米粗既能入味又有嚼头。",
      "visual_cue": "豆干条整齐，断面平整，长短基本一致"
    },
    {
      "n": 2,
      "text": "芹菜摘掉叶子只留茎，撕掉背面的粗纤维，切成四厘米长的段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "芹菜背面那层粗筋一定要撕掉，不然嚼着塞牙。",
      "visual_cue": "芹菜段翠绿，粗筋已撕净，切面水亮"
    },
    {
      "n": 3,
      "text": "芹菜段放进沸水里焯二十秒，捞出马上过凉水保持翠绿脆感。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯水去涩又能保色，时间不能超过三十秒。",
      "visual_cue": "芹菜段翠绿透亮，摸着脆，水汽已控干"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，下豆干条中火慢煸三分钟，煸到表面微黄起皱。",
      "time_min": 6,
      "heat": "中火",
      "tip": "豆干先煸香，煸出水分后才有豆香，直接炒会水塌塌的。",
      "visual_cue": "豆干条表面微黄起皱，边缘略卷"
    },
    {
      "n": 5,
      "text": "加姜丝、蒜片和小米辣圈，借豆干的油爆香，辣味渗进豆干里。",
      "time_min": 4,
      "heat": "中火",
      "tip": "小米辣要在油里爆一下才出香，最后撒只辣不香。",
      "visual_cue": "蒜片微黄，辣香冲鼻，油色微红"
    },
    {
      "n": 6,
      "text": "沿锅边淋生抽，加盐和白糖，倒清水焖一分钟让豆干吃进味道。",
      "time_min": 5,
      "heat": "中火",
      "tip": "加一点水焖，豆干才能真正吃味，干炒只是表面咸。",
      "visual_cue": "豆干条染上酱色，锅底水收干"
    },
    {
      "n": 7,
      "text": "倒入焯好的芹菜段转大火快炒一分钟，让芹菜和豆干翻匀。",
      "time_min": 3,
      "heat": "大火",
      "tip": "芹菜已经焯过，只需大火翻匀，久炒就软塌失脆。",
      "visual_cue": "芹菜翠绿挺直，豆干油亮，翻动有脆响"
    },
    {
      "n": 8,
      "text": "撒白胡椒翻两下关火装盘，趁热吃豆干有嚼头、芹菜最清脆。",
      "time_min": 2,
      "heat": "大火",
      "tip": "胡椒最后撒，香气不挥发，去豆腥又提鲜。",
      "visual_cue": "盘中无多余汤汁，色泽青黄相间"
    }
  ],
  "tips": [
    "豆干要先单独煸三分钟，表面微黄起皱才有豆香。和芹菜一起下锅，豆干出水，整盘菜都是水汽。",
    "芹菜背面那层粗纤维一定要撕掉，顺着撕到底，不然入口塞牙，再好味道也打折。",
    "芹菜焯水二十秒后必须过凉水，颜色才翠绿、口感才脆。焯久了发黄发软。",
    "豆干加一点清水焖一分钟才真正吃味。干炒只在表面挂咸，咬开里面还是淡的。"
  ],
  "common_mistakes": [
    "豆干和芹菜一起下锅炒，出水发塌。豆干要先煸香。",
    "芹菜没焯水直接炒，涩味重且颜色发暗。要焯二十秒过凉。",
    "只放生抽不加水，豆干里面没味。加四十毫升水焖一分钟。",
    "芹菜炒三分钟以上，软塌失色。焯过之后大火一分钟就够。"
  ],
  "substitutions": [
    {
      "original": "豆腐干",
      "substitute": "腐竹",
      "ratio": "300克:200克",
      "note": "需冷水泡发四十分钟，口感更软。"
    },
    {
      "original": "芹菜",
      "substitute": "蒜苗",
      "ratio": "250克:250克",
      "note": "辛香更重，炒制时间缩短到四十秒。"
    }
  ],
  "variations": [
    "加几片腊肉同炒，腊肉的烟熏香和豆干特别搭，是客家冬日的家常菜。",
    "把芹菜换成芥蓝，做成豆干炒芥蓝，苦甘味更明显，是客家山区的吃法。",
    "加一勺豆豉同炒，咸香更厚，配粥下饭都合适。"
  ],
  "serving_suggestion": "装盘上桌，豆干油亮微黄有嚼头，芹菜翠绿清脆带一点辣，咸鲜清爽，配白饭或配粥都很合适。",
  "storage": "冷藏可放一天，复热用炒锅大火快炒一分钟；芹菜隔夜会变黄，建议挑出再热。",
