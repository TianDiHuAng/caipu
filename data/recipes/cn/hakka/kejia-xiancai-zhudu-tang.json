  "id": "kejia-xiancai-zhudu-tang",
  "name": {
    "zh": "客家咸菜猪肚汤",
    "en": "Hakka Pork Tripe Soup with Pickled Mustard"
  },
  "cuisine": {
    "region": "cn",
