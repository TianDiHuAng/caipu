  "equipment": [
    "炒锅",
    "锅铲",
    "砂锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪手用清水浸泡三十分钟去血水，用刀刮净表皮残毛与污垢。",
      "time_min": 30,
      "heat": "无火",
      "tip": "表皮一定要刮干净，毛根留着煮出来有异味。",
      "visual_cue": "皮面白净无毛根，水色转清"
    },
    {
      "n": 2,
      "text": "冷水下锅，加姜片与一半米酒，大火烧开撇净浮沫后煮五分钟，捞出冲净。",
      "time_min": 9,
      "heat": "大火",
      "tip": "焯透才能去腥，浮沫要撇得干净，汤才不浑。",
      "visual_cue": "猪手发白收紧，水面浮沫撇清"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下冰糖小火炒至融化呈枣红色。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖色到枣红立即下料，再炒就发苦了。",
      "visual_cue": "糖液小泡密集，颜色红亮"
    },
    {
      "n": 4,
      "text": "倒入猪手块翻炒裹色，加姜、蒜、八角、桂皮、陈皮与干辣椒煸香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "火别太大，糖色遇高温容易糊，翻动要勤。",
      "visual_cue": "块块红亮，香料香气散出"
    },
    {
      "n": 5,
      "text": "烹入剩余米酒，加生抽、老抽与开水没过猪手，放葱结烧开。",
      "time_min": 5,
      "heat": "大火",
      "tip": "必须用开水，冷水会让猪手皮突然收缩，久煮不烂。",
      "visual_cue": "汤汁深红翻滚，酒香散开"
    },
    {
      "n": 6,
      "text": "转入砂锅小火焖一小时，中途翻动两次让上色均匀。",
      "time_min": 62,
      "heat": "小火",
      "tip": "全程都要保持小火慢焖，猪手里的胶质才会慢慢析出，做到皮糯肉酥又不会散架。",
      "visual_cue": "皮面起皱发亮，筷子能插入肉中"
    },
    {
      "n": 7,
      "text": "转大火收汁至浓稠油亮，试味后补盐，撒葱段出锅。",
      "time_min": 5,
      "heat": "大火",
      "tip": "收汁的时候要不停地翻动锅里的猪手，胶质浓稠很容易糊底，一糊整锅都发苦。",
      "visual_cue": "酱汁红亮挂身，表皮油光发润"
    }
  ],
  "tips": [
    "猪手选前蹄，肉多筋足，后蹄骨头大肉少。",
    "加几块白萝卜同焖，吸油解腻，汤汁也更清甜。",
    "用高压锅可省时间，上汽后压二十分钟再收汁。"
  ],
  "common_mistakes": [
    "猪手不刮皮直接焖，成品带毛腥，口感发涩。",
    "糖色炒糊，整锅发苦，糖的甜味全变成焦味。",
    "全程大火，汤汁烧干了皮还没烂，咬不动。"
  ],
  "substitutions": [
    {
      "original": "猪手",
      "substitute": "猪脚",
      "ratio": "1000克:1000克",
      "note": "两者同类，猪脚骨多须延长焖制时间。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "20克:18克",
      "note": "白糖上色更快，须更小心火候。"
    }
  ],
  "variations": [
    "加一大勺南乳同焖，就是客家南乳猪手，咸香更重。",
    "把猪手换成猪尾，胶质更足，焖的时间可减十五分钟。"
  ],
  "serving_suggestion": "连汁上桌，配白饭或拌面都极香，也是宴席的硬菜。",
  "storage": "冷藏可存三天，复热须加水小火焖十分钟，胶质会重新化开。",
