  "steps": [
    {
      "n": 1,
      "text": "五花肉切成三厘米见方的块，冷水下锅加姜片与少许米酒焯五分钟，捞出冲净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "整块先焯再切更整齐，切好再焯肉块容易缩成小球。",
      "visual_cue": "肉块发白收紧，水面浮起厚沫"
    },
    {
      "n": 2,
      "text": "南乳用勺子压碎，加两勺南乳汁、生抽、老抽与米酒调成酱汁备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "南乳一定要压成泥，整块下锅化不开，味道也不均匀。",
      "visual_cue": "酱汁呈深红稠糊状，无颗粒"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下冰糖小火炒至融化变枣红色。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糖色炒到枣红就要立刻下肉，炒黑了整锅发苦。",
      "visual_cue": "糖液起大泡转小泡，颜色枣红"
    },
    {
      "n": 4,
      "text": "倒入肉块快速翻炒裹上糖色，加姜、蒜、八角与桂皮煸出油。",
      "time_min": 5,
      "heat": "中火",
      "tip": "每块肉都裹上糖色，成品才红亮好看。",
      "visual_cue": "肉块表面油亮泛红，锅底渗出油脂"
    },
    {
      "n": 5,
      "text": "倒入调好的南乳酱汁炒匀，加开水没过肉块，放葱结烧开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "一定要加开水，冷水会让肉突然收紧变柴。",
      "visual_cue": "汤汁深红翻滚，南乳香散出"
    },
    {
      "n": 6,
      "text": "转砂锅小火焖四十分钟，中途翻动一次让肉均匀入味。",
      "time_min": 42,
      "heat": "小火",
      "tip": "小火慢焖，肉才酥而不烂，皮也软糯起胶。",
      "visual_cue": "肉皮透亮起皱，筷子能轻松插入"
    },
    {
      "n": 7,
      "text": "开盖转大火收汁至浓稠，尝味后可补少许盐，出锅装盘。",
      "time_min": 5,
      "heat": "大火",
      "tip": "南乳本身咸，收汁后味道会浓缩，盐要最后试再加。",
      "visual_cue": "酱汁红亮裹肉，油层浮在表面"
    }
  ],
  "tips": [
    "五花肉选肥瘦三层分明的，纯瘦的焖出来发柴。",
    "加几块炸豆腐或芋头同焖，吸汁比肉还香。",
    "焖好放一夜再吃，味道更透，客家人叫隔夜香。"
  ],
  "common_mistakes": [
    "南乳不压碎直接下锅，化不开还结块，味道忽咸忽淡。",
    "糖色炒过头，整锅肉带焦苦味，救不回来。",
    "全程大火滚煮，肉皮烂了肉还柴，汤汁也烧干。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "600克:600克",
      "note": "前腿较瘦，焖的时间延长十分钟。"
    },
    {
      "original": "南乳",
      "substitute": "腐乳",
      "ratio": "40克:40克",
      "note": "腐乳颜色浅，老抽可多加三毫升。"
    }
  ],
  "variations": [
    "加一把梅菜同焖，就是南乳梅菜肉，咸香更足。",
    "把肉换成猪手同法焖制，胶质更厚，适合冬天吃。"
  ],
  "serving_suggestion": "配白饭最下饭，也可夹入馒头或拌面，汤汁是精华。",
  "storage": "冷藏可存三天，复热须加少量水小火焖十分钟，风味反而更佳。",
