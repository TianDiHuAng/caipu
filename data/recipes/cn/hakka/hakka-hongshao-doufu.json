  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成两厘米厚的大片，用厨房纸吸干表面水分，撒少许盐腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "撒盐能逼出水分，煎的时候更不容易粘锅破皮。",
      "visual_cue": "豆腐表面泛出水珠，片形挺立"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧热，下豆腐片中火煎到两面金黄后盛出。",
      "time_min": 10,
      "heat": "中火",
      "tip": "一面煎定型再翻，急着翻必碎，油要够热才不粘。",
      "visual_cue": "两面结起金黄硬壳，边角挺立"
    },
    {
      "n": 3,
      "text": "锅中留底油，下五花肉片煸出油，加蒜、姜与香菇片炒香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "五花肉煸到微卷出油，整道菜的香底就靠这一层油。",
      "visual_cue": "肉片微卷透明，锅底渗出清油"
    },
    {
      "n": 4,
      "text": "加生抽、老抽、蚝油、白糖与小半碗清水烧开，铺入煎好的豆腐。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆腐铺进去之后就不要再翻动了，要靠着汤汁慢慢浸透，这样才能保持整片不散开。",
      "visual_cue": "汤汁红亮没过豆腐一半"
    },
    {
      "n": 5,
      "text": "盖上锅盖用小火焖上八分钟，中途只需要推动锅底防止粘锅，让豆腐充分吸饱酱汁。",
      "time_min": 8,
      "heat": "小火",
      "tip": "只推动锅底不要翻动豆腐，慢慢烧才能让酱汁渗进去，成品才会完整又好看。",
      "visual_cue": "豆腐颜色转深，汤汁收至一半"
    },
    {
      "n": 6,
      "text": "淀粉加清水调成薄芡淋进锅里，撒上葱段翻匀就可以出锅装盘了。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芡要薄，客家菜讲究汤汁挂身而不糊嘴。",
      "visual_cue": "汤汁浓亮挂勺，豆腐油润饱满"
    }
  ],
  "tips": [
    "用老豆腐或北豆腐，嫩豆腐一煎就散，撑不住红烧。",
    "加一勺豆豉同烧，咸香更浓，是客家山区的常见做法。",
    "五花肉可换成腊肉，风味更足，但盐量要减。"
  ],
  "common_mistakes": [
    "豆腐不吸干水就下锅，油花四溅还粘得满锅都是。",
    "大火烧，汤汁干得快，豆腐外面咸里面白。",
    "反复翻动豆腐，最后全碎成渣，卖相全无。"
  ],
  "substitutions": [
    {
      "original": "老豆腐",
      "substitute": "油豆腐",
      "ratio": "450克:300克",
      "note": "油豆腐吸汁更猛，烧的时间减三分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "80克:70克",
      "note": "腊肉咸，盐与生抽须各减一半。"
    }
  ],
  "variations": [
    "把豆腐换成煎过的豆干，口感更韧，适合下酒。",
    "加一把蒜苗同烧，辛香解腻，是客家家常的搭配。"
  ],
  "serving_suggestion": "连汁浇在米饭上最香，也可作为下酒菜冷吃。",
  "storage": "冷藏可存两天，复热须加两勺水小火焖五分钟，微波会令豆腐发硬。",
