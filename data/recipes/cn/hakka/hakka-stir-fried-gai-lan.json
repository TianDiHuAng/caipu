  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "把芥蓝掰开洗净，粗梗和嫩叶分开切成均匀的段。",
      "time_min": 12,
      "heat": "无火",
      "tip": "梗和叶分开切，下锅时间才不一样。",
      "visual_cue": "梗段整齐，叶片宽大"
    },
    {
      "n": 2,
      "text": "锅里清水烧开加盐，芥蓝梗先下锅焯一分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯一下水能去掉一部分苦味和涩口。",
      "visual_cue": "菜梗颜色转为深绿"
    },
    {
      "n": 3,
      "text": "再下芥蓝叶焯三十秒，一起捞出过凉水沥干。",
      "time_min": 4,
      "heat": "大火",
      "tip": "过凉水能保住脆感，也让颜色更绿。",
      "visual_cue": "菜叶翠绿，看着不发黄"
    },
    {
      "n": 4,
      "text": "炒锅烧热放植物油，下大蒜碎和豆豉小火炒香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆豉要炒出香气，但别炒糊发苦。",
      "visual_cue": "蒜末微黄，豆豉香气上扬"
    },
    {
      "n": 5,
      "text": "转大火下芥蓝梗翻炒一分钟，让菜梗先断生。",
      "time_min": 2,
      "heat": "大火",
      "tip": "大火快炒，水分才不会大量渗出。",
      "visual_cue": "菜梗油亮，边缘微软"
    },
    {
      "n": 6,
      "text": "再下芥蓝叶，淋上生抽快速翻炒到味道均匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "叶子最后下锅，久炒会发黄出水。",
      "visual_cue": "菜叶油润，颜色翠绿"
    },
    {
      "n": 7,
      "text": "尝一下味道补上盐，翻匀后立刻起锅装盘上桌。",
      "time_min": 1,
      "heat": "大火",
      "tip": "芥蓝本身带苦，盐别放多否则更涩。",
      "visual_cue": "菜叶挺立，盘底少汁"
    }
  ],
  "tips": [
    "菜梗和菜叶分开下锅，熟度才一致。",
    "焯水时加盐，能压住一部分苦味。",
    "全程大火快炒，芥蓝才不出水发黄。"
  ],
  "common_mistakes": [
    "芥蓝直接下锅炒，出水多而且发苦。",
    "炒的时间过长，菜叶发黄又软塌。",
    "豆豉炒糊了，整盘菜带上焦苦味。"
  ],
  "substitutions": [
    {
      "original": "芥菜",
      "substitute": "小白菜",
      "ratio": "600 克:600 克",
      "note": "几乎不苦，炒制时间减半。"
    },
    {
      "original": "豆豉",
      "substitute": "豆豉酱",
      "ratio": "10 克:15 克",
      "note": "咸味更重，盐要减量。"
    }
  ],
  "variations": [
    "加几片腊肉一起同炒，油香会更加浓郁。",
    "出锅前淋一点米酒，苦味会淡一些。"
  ],
  "serving_suggestion": "配白粥或白饭都很下饭，是客家人餐桌上的日常素菜。",
  "storage": "冷藏一天，复热用炒锅快炒一分钟；不建议久放，叶片会发黄。",
