  "equipment": [
    "平底锅",
    "小勺",
    "砂锅或深盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成 6cm×4cm×2.5cm 长方块，用勺子在中间挖出浅坑，挖出的豆腐留用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "坑不要挖穿，留 1cm 底，煎时才不会漏馅。",
      "visual_cue": "每块豆腐中央有整齐的小凹坑"
    },
    {
      "n": 2,
      "text": "猪肉末加香菇末、姜末、料酒、生抽 10ml、蚝油、白胡椒、2g 盐与挖出的豆腐碎，顺一个方向搅至上劲。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐碎能让肉馅更松软多汁，别丢掉。",
      "visual_cue": "肉馅黏稠抱团、颜色均匀"
    },
    {
      "n": 3,
      "text": "把肉馅填入豆腐坑中抹平，表面拍少许玉米淀粉增加黏合。",
      "time_min": 6,
      "heat": "无火",
      "tip": "馅料略高于豆腐表面，煎后会收缩回平。",
      "visual_cue": "馅料与豆腐边缘齐平、不塌陷"
    },
    {
      "n": 4,
      "text": "平底锅下 45ml 植物油，肉馅朝下中小火煎 4 分钟至金黄，翻面再煎 3 分钟。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "肉馅面先煎定型，翻面时才不会掉馅。",
      "visual_cue": "肉馅面结出金黄焦壳，豆腐底面微黄"
    },
    {
      "n": 5,
      "text": "移入砂锅，加高汤、剩余生抽与 2g 盐，小火焖 10 分钟让豆腐吸味。",
      "time_min": 11,
      "heat": "小火",
      "tip": "汤量到豆腐一半高即可，太多会变成汤菜。",
      "visual_cue": "豆腐体积略胀、汤汁渗入孔隙"
    },
    {
      "n": 6,
      "text": "开盖淋淀粉水勾薄芡，撒葱花，连砂锅上桌。",
      "time_min": 2,
      "heat": "中火",
      "tip": "勾芡后不要再久煮，芡汁会返稀。",
      "visual_cue": "汤汁浓稠挂勺、葱花翠绿"
    }
  ],
  "tips": [
    "豆腐选老一点的北豆腐，太嫩容易碎。",
    "煎好的酿豆腐可冷冻保存，吃时直接焖，不必解冻。",
    "没有高汤时用 250ml 清水加 5g 蚝油代替。"
  ],
  "common_mistakes": [
    "豆腐坑挖穿底，煎的时候肉馅和汁水一起漏掉。",
    "肉馅不搅打上劲，焖后散开成碎末。",
    "全程大火煎，豆腐外焦内生，馅还不熟。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鱼肉泥",
      "ratio": "200g 猪肉末 ≈ 220g 鱼肉泥",
      "note": "客家也有酿鱼豆腐版本，需加 5g 淀粉帮助成型。"
    },
    {
      "original": "北豆腐",
      "substitute": "油豆腐",
      "ratio": "450g 北豆腐 ≈ 300g 油豆腐",
      "note": "油豆腐直接剪口塞馅，省去挖坑步骤。"
    }
  ],
  "variations": [
    "家庭简化版：豆腐不煎，直接填馅上锅蒸 15 分钟，再淋芡汁。",
    "砂锅版：锅底垫白萝卜片同焖，汤汁更清甜。"
  ],
  "serving_suggestion": "配米饭，汤汁浇饭；客家人常与酿苦瓜、酿茄子同锅，合成「酿三宝」。",
  "storage": "冷藏 2 天，复热加 50ml 高汤小火焖 5 分钟；冷冻可存 1 个月。",
