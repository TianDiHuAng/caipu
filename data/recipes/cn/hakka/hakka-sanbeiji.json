  "equipment": [
    "砂锅",
    "炒锅",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿剁成三厘米见方的块，冷水下锅煮开焯去血沫，捞出冲洗干净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅血沫才出得干净。",
      "visual_cue": "水面浮起褐色浮沫、鸡块发白"
    },
    {
      "n": 2,
      "text": "生姜切厚片，大蒜整瓣去皮，九层塔摘下叶片洗净沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "姜片要厚，久煸才不焦。",
      "visual_cue": "配料分装备好、九层塔叶片完整"
    },
    {
      "n": 3,
      "text": "砂锅倒入芝麻油，小火下姜片慢煸至边缘卷起、香味散出。",
      "time_min": 5,
      "heat": "小火",
      "tip": "香油不能用大火，会发苦。",
      "visual_cue": "姜片边缘金黄卷曲"
    },
    {
      "n": 4,
      "text": "下大蒜与干辣椒炒出香味，倒入鸡块转中火翻炒到表面收紧上色。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡皮朝下先煎，逼出的油更香。",
      "visual_cue": "鸡块表面微黄、锅底见油"
    },
    {
      "n": 5,
      "text": "倒入黄酒、生抽与冰糖，加盐后盖盖转小火焖二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "全程不加水，靠酒和酱油焖熟。",
      "visual_cue": "汤汁咕嘟冒小泡、香气浓"
    },
    {
      "n": 6,
      "text": "开盖转大火收汁到浓稠挂勺，关火放入九层塔叶盖盖焖一分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "九层塔遇热即香，久煮会发黑。",
      "visual_cue": "汤汁挂勺、九层塔叶片变软"
    }
  ],
  "tips": [
    "三杯指香油、酱油、米酒各一杯，比例可按口味微调。",
    "用砂锅焖比铁锅更聚香，锅底不易糊。",
    "鸡腿带骨焖出来最香，纯肉反而少味。"
  ],
  "common_mistakes": [
    "香油烧到冒烟才下姜，整锅发苦。",
    "中途加水稀释，味道寡淡收不浓。",
    "九层塔一开始就下锅，煮成黑叶没有香气。"
  ],
  "substitutions": [
    {
      "original": "九层塔",
      "substitute": "罗勒",
      "ratio": "20g 对 20g",
      "note": "甜罗勒香气更柔，用量可略增。"
    },
    {
      "original": "黄酒",
      "substitute": "花雕酒",
      "ratio": "60ml 对 60ml",
      "note": "酒香更醇，冰糖减到五克。"
    }
  ],
  "variations": [
    "加一把泡发的干香菇一起焖，菌菇的香气会让汤汁更厚实。",
    "改用鸡翅中制作，焖制时间缩短到十五分钟。"
  ],
  "serving_suggestion": "砂锅直接上桌，汤汁拌饭一绝，配一杯米酒更地道。",
  "storage": "冷藏两天，复热加一勺米酒，香气可回。",
