  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "白萝卜",
          "name_en": "daikon radish",
          "amount": 1000,
          "unit": "g",
          "note": "选紧实沉手的新鲜萝卜",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "红辣椒",
          "name_en": "red chili",
          "amount": 30,
          "unit": "g",
          "note": "切圈增辣增色",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 25,
          "unit": "g",
          "note": "杀水用",
          "optional": false
        },
        {
          "name": "米醋",
          "name_en": "rice vinegar",
          "amount": 250,
          "unit": "ml",
          "note": "白米醋色泽清亮",
          "optional": false
        },
        {
          "name": "冰糖",
          "name_en": "rock sugar",
          "amount": 120,
          "unit": "g",
          "note": "增脆增亮",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 250,
          "unit": "ml",
          "note": "调腌汁",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "玻璃罐",
    "小锅",
    "刨刀",
    "干净筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白萝卜洗净不去皮，切成半厘米厚的薄片，皮保留才能保持脆度。",
      "time_min": 12,
      "heat": "无火",
      "tip": "带皮腌的萝卜更脆，去皮后容易腌软。",
      "visual_cue": "片厚均匀、边缘带一圈青皮"
    },
    {
      "n": 2,
      "text": "萝卜片撒盐抓匀，静置四十分钟杀出水分，中途翻动两次。",
      "time_min": 42,
      "heat": "无火",
      "tip": "杀水时间不足，腌出的汁会被稀释，酸味不够。",
      "visual_cue": "萝卜片变软弯折不断、盆底积满水"
    },
    {
      "n": 3,
      "text": "把萝卜片捞出用力挤干，再用凉开水快速冲一遍去掉表面浮盐。",
      "time_min": 6,
      "heat": "无火",
      "tip": "挤得越干，腌汁越能渗进去，成品越脆越入味。",
      "visual_cue": "萝卜片干爽、挤压不出水"
    },
    {
      "n": 4,
      "text": "小锅放清水与冰糖，小火煮到糖化开后关火，倒入米醋搅匀晾凉。",
      "time_min": 6,
      "heat": "小火",
      "tip": "醋不要一起煮，高温会让醋酸挥发，香气变淡。",
      "visual_cue": "糖水清亮、尝起来酸甜平衡"
    },
    {
      "n": 5,
      "text": "玻璃罐用开水烫过晾干，码入萝卜片与红辣椒圈，倒入完全晾凉的腌汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腌汁必须凉透，热汁会把萝卜烫软失去脆感。",
      "visual_cue": "腌汁没过萝卜、罐内无气泡"
    },
    {
      "n": 6,
      "text": "盖紧罐盖放冰箱冷藏腌二十四小时，第二天即可食用，两天后风味最佳。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷藏腌制比室温更脆，室温放久会发酸发软。",
      "visual_cue": "萝卜片半透明、汁水微红"
    }
  ],
  "tips": [
    "萝卜选秋冬季节的沙地萝卜，水分足、纤维细。",
    "酸甜比例可按口味调整，糖多则脆，醋多则爽。",
    "取食时用干净筷子，沾染生水会让整罐起白膜。"
  ],
  "common_mistakes": [
    "萝卜去皮再腌，成品软塌不脆，失去客家酸萝卜的特点。",
    "杀水后不挤干，腌汁被稀释，萝卜淡而无味。",
    "腌汁趁热倒入，萝卜被烫熟，颜色发白发软。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "陈醋",
      "ratio": "250ml 对 220ml",
      "note": "陈醋颜色深，成品发褐，风味更厚重。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "120g 对 100g",
      "note": "白糖甜度更高，用量需减少。"
    }
  ],
  "variations": [
    "腌汁里加少许话梅或柠檬片，做成带果香的酸甜萝卜。",
    "萝卜改切条状并加姜丝，做成客家萝卜条，口感更爽脆。"
  ],
  "serving_suggestion": "作为开胃小菜装碟上桌，也可切碎配粥、拌米粉。",
  "storage": "冷藏可存三周，汁水需始终没过萝卜，取食保持器具干燥。",
