  "equipment": [
    "蒸锅",
    "刀",
    "砧板",
    "深盘",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲩鱼去鳞去鳃去内脏，撕净腹腔黑膜，鱼身两面各斜划三刀，用盐与米酒抹匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腹腔黑膜最腥，一定要撕净，划刀能让鱼肉均匀受热。",
      "visual_cue": "鱼身干爽，刀口深至骨不见血水"
    },
    {
      "n": 2,
      "text": "盘底铺姜片与葱段，把鱼放上去，鱼腹内也塞两片姜。",
      "time_min": 3,
      "heat": "无火",
      "tip": "垫高让蒸汽循环，鱼底不会泡在汤水里发腥。",
      "visual_cue": "鱼身架起不贴盘，姜葱铺满盘底"
    },
    {
      "n": 3,
      "text": "等蒸锅里的水完全滚开之后再放入鱼盘，用大火蒸八分钟，关火后再继续焖上两分钟。",
      "time_min": 11,
      "heat": "大火",
      "tip": "一定要水开后再放鱼，冷水上锅鱼肉会发柴。",
      "visual_cue": "鱼眼凸出发白，鱼鳍立起"
    },
    {
      "n": 4,
      "text": "把鱼盘取出来，倒掉盘子里蒸出的腥水，再把垫在下面的姜片和葱段一并拣掉。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蒸出的水带腥味，一定要倒掉，否则整道菜都发腥。",
      "visual_cue": "盘中无积水，鱼身完整不散"
    },
    {
      "n": 5,
      "text": "鱼身铺上姜丝、葱丝与香菜，另将生抽与白糖调匀烧热后浇在鱼上。",
      "time_min": 2,
      "heat": "小火",
      "tip": "豉油要热浇，冷的浇上去只有咸味没有香。",
      "visual_cue": "酱汁沿鱼身铺开，配料分布均匀"
    },
    {
      "n": 6,
      "text": "小锅把植物油烧到冒烟，均匀泼在姜葱上激出香味即可。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油必须烧到冒烟，泼下去才有那种滋的一声。",
      "visual_cue": "葱姜瞬间卷起，香气冲鼻"
    }
  ],
  "tips": [
    "鲩鱼选两斤以内的，肉嫩刺少；太大的肉厚蒸不透。",
    "蒸的时间按鱼的大小调整，每斤约六分钟。",
    "用筷子插鱼背最厚的部位，能轻松插入就是熟了。"
  ],
  "common_mistakes": [
    "冷水上锅慢慢蒸，鱼肉变柴发白，一点不嫩。",
    "蒸出的腥水不倒，浇上豉油也压不住那股土腥。",
    "油不烧热就泼，葱姜生辣，完全没有香气。"
  ],
  "substitutions": [
    {
      "original": "鲩鱼",
      "substitute": "鲈鱼",
      "ratio": "600克:600克",
      "note": "鲈鱼刺少，蒸的时间减两分钟。"
    },
    {
      "original": "生抽",
      "substitute": "蒸鱼豉油",
      "ratio": "25毫升:25毫升",
      "note": "豉油更鲜，白糖可省去。"
    }
  ],
  "variations": [
    "把姜丝换成梅菜碎同蒸，咸香更浓，是客家的山乡版本。",
    "加几片火腿同蒸，鲜味叠加，适合宴客时做。"
  ],
  "serving_suggestion": "趁热吃最鲜，鱼肉蘸盘底的豉油汁，配白饭正好。",
  "storage": "建议当餐吃完，冷藏后复蒸会令鱼肉明显发柴，口感大打折扣。",
