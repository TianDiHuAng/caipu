  "steps": [
    {
      "n": 1,
      "text": "腐竹掰成五厘米长的段，用冷水泡四十分钟，泡到中心没有硬芯为止。",
      "time_min": 45,
      "heat": "无火",
      "tip": "腐竹只能用冷水泡，热水一泡外面烂了里面还是硬的。",
      "visual_cue": "腐竹段软胀，弯折不发脆，捏着有韧劲"
    },
    {
      "n": 2,
      "text": "五花肉切成三厘米见方的块，冷水下锅焯三分钟，撇净浮沫捞出冲洗。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅才能把血水逼出来，热水下锅肉一紧就腥在里面了。",
      "visual_cue": "肉块紧实，汤面浮沫撇净，水色转清"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，下白糖小火炒到融化冒小泡，立刻倒入五花肉翻炒。",
      "time_min": 7,
      "heat": "小火",
      "tip": "糖色炒到浅琥珀色就下肉，炒过头会发苦，整锅都救不回来。",
      "visual_cue": "肉块均匀裹上枣红色，锅底油亮发光"
    },
    {
      "n": 4,
      "text": "下姜片、大蒜和八角一起煸香，淋米酒翻匀，让酒气挥发掉腥味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "米酒沿锅边淋，遇热瞬间挥发带走腥味，比直接倒效果好。",
      "visual_cue": "酒气散尽，香气上来了，闻着没有腥味"
    },
    {
      "n": 5,
      "text": "加生抽、老抽和盐翻匀，倒入清水没过肉块，大火烧开后转小火焖二十分钟。",
      "time_min": 25,
      "heat": "小火",
      "tip": "水要一次加够，中途加水会让肉发紧，口感变柴。",
      "visual_cue": "汤面微沸，肉块上色均匀，油花聚到锅边"
    },
    {
      "n": 6,
      "text": "放入泡好的腐竹段和香菇片，轻轻压进汤里，继续小火焖十五分钟。",
      "time_min": 18,
      "heat": "小火",
      "tip": "腐竹后放，早放会焖成一锅糊，吸汤太久就散了。",
      "visual_cue": "腐竹吸饱汤汁，颜色转深，压下去能回弹"
    },
    {
      "n": 7,
      "text": "开盖转中火收汁，边收边晃锅，让腐竹和肉都裹上一层浓汁。",
      "time_min": 6,
      "heat": "中火",
      "tip": "收汁时别用铲子翻，晃锅就够，腐竹才不会碎。",
      "visual_cue": "汤汁挂勺，油光发亮，锅底沙沙作响"
    },
    {
      "n": 8,
      "text": "撒白胡椒和蒜苗段，翻两下关火，砂锅垫底上桌保温。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蒜苗断生就起锅，久炒发黄，辛香也全跑光了。",
      "visual_cue": "蒜苗翠绿挺直，盘底不汪油"
    }
  ],
  "tips": [
    "腐竹必须用冷水泡，四十分钟泡到中心无硬芯。热水或开水泡，外面烂成糊而芯还是生的。",
    "五花肉冷水下锅焯，血沫才能逼出来。热水下锅表面蛋白质一凝固，腥味就锁在肉里了。",
    "炒糖色是这道菜的颜色关键，小火炒到浅琥珀色就要立刻下肉，颜色再深就带苦味。",
    "腐竹要在肉焖到七分熟时才放，它吸汁很快，放早了会焖散、放晚了又不够入味。"
  ],
  "common_mistakes": [
    "腐竹用热水泡，外软内硬。必须冷水泡足四十分钟。",
    "糖色炒到发黑才下肉，整锅带苦味。浅琥珀色就得下肉。",
    "焖肉中途加水，肉块紧缩发柴。水要一次加足并保持小火。",
    "腐竹和肉一起下锅焖，出锅腐竹化成糊。腐竹要在后半程才放。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪排骨",
      "ratio": "300克:500克",
      "note": "油脂减少，需多加十毫升植物油补香。"
    },
    {
      "original": "腐竹",
      "substitute": "油豆腐",
      "ratio": "200克:250克",
      "note": "不用泡发，直接下锅焖十分钟即可。"
    }
  ],
  "variations": [
    "加两片南乳同焖，颜色更红亮，咸香里带一点发酵的回甜，是客家南乳焖肉的路子。",
    "把五花肉换成腊肉，做成腊肉焖腐竹，烟熏香和豆香混在一起，冬天吃最合适。",
    "加一把干笋同焖，山里风味更足，笋干吸油后比肉还抢手。"
  ],
  "serving_suggestion": "连砂锅上桌，五花肉红亮软糯，腐竹吸饱肉汁咬下去满口香，配一碗白饭，汤汁拌饭能吃两碗。",
  "storage": "冷藏可放两天，复热加少量清水小火焖五分钟；腐竹隔夜更入味，但蒜苗须挑出以免发黄。",
