  "equipment": [
    "平底锅",
    "砂锅",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉剁成粗肉料，加香菇末、大葱末和玉米淀粉拌成馅。",
      "time_min": 10,
      "heat": "无火",
      "tip": "肉料别剁成泥，保留一点颗粒更有口感。",
      "visual_cue": "馅料黏稠，能抱成团"
    },
    {
      "n": 2,
      "text": "肉料里加十毫升酱油和两克盐，顺一个方向搅到上劲。",
      "time_min": 5,
      "heat": "无火",
      "tip": "顺着一个方向搅，馅才抱团不散。",
      "visual_cue": "馅料发黏，能拉出丝"
    },
    {
      "n": 3,
      "text": "鸡蛋打散后过一遍筛，去掉蛋液里的系带和泡沫。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛之后，蛋皮更细腻也不容易破。",
      "visual_cue": "蛋液顺滑，没有泡沫"
    },
    {
      "n": 4,
      "text": "平底锅刷一层植物油，小火倒入一勺蛋液摊成圆皮，半凝时放馅。",
      "time_min": 8,
      "heat": "小火",
      "tip": "蛋皮半凝时放馅，边缘才能粘合。",
      "visual_cue": "蛋皮圆整，边缘未全熟"
    },
    {
      "n": 5,
      "text": "把蛋皮对折压紧边缘，煎到两面金黄后盛出备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "边缘用铲子压一下，焖的时候才不会漏。",
      "visual_cue": "蛋角金黄，边缘封口"
    },
    {
      "n": 6,
      "text": "砂锅下姜片和葱白爆香，铺白萝卜块，摆上蛋角。",
      "time_min": 5,
      "heat": "中火",
      "tip": "萝卜垫底吸汁，蛋角才不会粘锅。",
      "visual_cue": "蛋角整齐，排开不粘"
    },
    {
      "n": 7,
      "text": "加清水、剩下的酱油和蚝油，小火焖十五分钟收汁。",
      "time_min": 17,
      "heat": "小火",
      "tip": "小火慢慢焖，蛋角才入味又不会散。",
      "visual_cue": "汤汁浓稠，蛋角鼓胀"
    }
  ],
  "tips": [
    "蛋皮在边缘未完全凝固时放馅，对折才能封口。",
    "肉料保留一些颗粒感，口感比剁成细泥更好。",
    "白萝卜垫底吸汁，还能防止蛋角粘锅。"
  ],
  "common_mistakes": [
    "蛋皮摊得太厚，对折时折断漏馅。",
    "边缘没压实就下锅焖，煮到最后馅全散在汤里。",
    "大火猛焖，蛋角外壳发硬萝卜还没熟。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪里脊",
      "ratio": "250 克:250 克",
      "note": "更瘦，需多加油调馅。"
    },
    {
      "original": "白萝卜",
      "substitute": "冬瓜",
      "ratio": "300 克:300 克",
      "note": "更清淡，焖的时间缩短五分钟。"
    }
  ],
  "variations": [
    "加几只虾仁进馅料，鲜味会更足。"
  ],
  "serving_suggestion": "连砂锅端上桌，配白米饭，是客家年节和待客桌上常见的一道。",
  "storage": "冷藏两天，复热小火加少量清水焖五分钟，蛋皮才不会散。",
