  "equipment": [
    "炒锅",
    "筷子",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干米粉用冷水浸泡 20 分钟至变软，捞出沥干，剪成 15cm 长的段。",
      "time_min": 20,
      "heat": "无火",
      "tip": "只用冷水泡，热水泡会烂成一团。",
      "visual_cue": "米粉柔软可弯折、不断裂"
    },
    {
      "n": 2,
      "text": "五花肉切细丝，香菇泡发切丝，芹菜切段，胡萝卜切细丝，大蒜切末备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "所有配料切细，才能与米粉同步炒熟。",
      "visual_cue": "配料粗细均匀、分装备齐"
    },
    {
      "n": 3,
      "text": "锅下 50ml 植物油，中火煸五花肉丝 4 分钟至出油微黄，下蒜末与香菇丝炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "猪油是客家炒粉的香气来源，别急着盛出。",
      "visual_cue": "肉丝微黄卷曲、锅底有清油"
    },
    {
      "n": 4,
      "text": "加胡萝卜丝与芹菜段大火翻炒 1 分钟，加生抽、老抽、盐与白胡椒炒匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "蔬菜保持脆感，久炒会出水。",
      "visual_cue": "蔬菜断生、锅气明显"
    },
    {
      "n": 5,
      "text": "下米粉与 150ml 清水，用筷子抖散翻炒，让粉均匀吸汁上色。",
      "time_min": 4,
      "heat": "中火",
      "tip": "用筷子抖散比锅铲更好，粉不易断。",
      "visual_cue": "米粉均匀上色、无干粉结块"
    },
    {
      "n": 6,
      "text": "转大火收干汤汁，撒入芹菜叶翻匀即可出锅装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "收干才香，盘中不汪水。",
      "visual_cue": "米粉干爽蓬松、盘底无汤汁"
    }
  ],
  "tips": [
    "米粉泡到八分软即可，吸汁后还会继续变软。",
    "加 20g 泡软的虾米，鲜味更接近客家老做法。",
    "配一碟蒜蓉辣椒酱，是客家米粉的固定搭档。"
  ],
  "common_mistakes": [
    "米粉用热水泡，下锅一炒就断成碎渣。",
    "一次把米粉全倒进锅，翻不动且受热不均。",
    "汤汁没收干就出锅，米粉软塌、盘底积水。"
  ],
  "substitutions": [
    {
      "original": "米粉",
      "substitute": "河粉",
      "ratio": "300g 干米粉 ≈ 500g 鲜河粉",
      "note": "河粉不用泡，直接下锅炒制。"
    },
    {
      "original": "五花肉",
      "substitute": "腊肠",
      "ratio": "150g 五花肉 ≈ 120g 腊肠",
      "note": "腊肠本身有咸味，盐减 1g。"
    }
  ],
  "variations": [
    "家庭简化版：蔬菜统一用包菜丝，省去切配时间。",
    "客家宴席版：加 100g 猪肝片与 50g 鱿鱼丝，即成豪华版炒粉。"
  ],
  "serving_suggestion": "一出锅要趁热吃，配一碗紫菜蛋花汤最完整。",
  "storage": "冷藏 1 天，复热用炒锅加 20ml 水翻炒 2 分钟，勿用微波炉。",
