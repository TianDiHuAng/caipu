  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "铲",
    "碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾米挑去杂质，用温水泡十分钟，泡虾米的水留着后面焖豆腐用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡虾米的水是鲜味精华，别倒掉，滤一下当高汤用。",
      "visual_cue": "虾米软胀，水色微黄发浑，闻着有海味"
    },
    {
      "n": 2,
      "text": "嫩豆腐切成三厘米见方的块，放进淡盐水中浸五分钟再沥干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "淡盐水浸过的豆腐更紧实，煎的时候不容易碎。",
      "visual_cue": "豆腐块完整，边缘不塌，切面平整"
    },
    {
      "n": 3,
      "text": "香菇去柄切成半厘米厚的片，姜切丝，大蒜切末，蒜苗斜切段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香菇片别切太薄，炒过之后还要有咬劲才好。",
      "visual_cue": "香菇片厚薄一致，蒜苗段青白分明"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，豆腐块平铺下锅，中火煎到两面结一层薄皮。",
      "time_min": 8,
      "heat": "中火",
      "tip": "豆腐下锅后别急着翻，等底面结皮再动，不然就散了。",
      "visual_cue": "豆腐两面金黄，锅铲推得动"
    },
    {
      "n": 5,
      "text": "把豆腐拨到锅边，利用锅心余油下姜丝、蒜末和虾米小火炒香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "虾米要炒到出油发亮，那股海味才真正释放出来。",
      "visual_cue": "虾米卷曲发亮，香味扑鼻，油面泛起细泡"
    },
    {
      "n": 6,
      "text": "下香菇片一起翻炒一分钟，倒入泡虾米的水和清水，烧开后调味。",
      "time_min": 6,
      "heat": "大火",
      "tip": "泡虾米水先下，再加清水，鲜味的层次就从这里来。",
      "visual_cue": "汤汁沸腾，香菇开始变软，浮起白沫"
    },
    {
      "n": 7,
      "text": "加生抽、蚝油、盐和白糖，把豆腐轻轻推入汤中，转中小火焖六分钟。",
      "time_min": 9,
      "heat": "中小火",
      "tip": "焖的时候用锅铲背轻推，别翻动，豆腐才不会破相。",
      "visual_cue": "汤汁收到一半，豆腐吸饱发胀"
    },
    {
      "n": 8,
      "text": "淋入调好的玉米淀粉水，撒白胡椒，晃锅收汁，最后撒蒜苗段出锅。",
      "time_min": 4,
      "heat": "中火",
      "tip": "水淀粉分两次淋，汁才挂得住又不糊成一坨。",
      "visual_cue": "汤汁浓稠挂勺，蒜苗翠绿，锅边一圈亮油"
    }
  ],
  "tips": [
    "虾米要用温水泡，泡出来的水别倒，滤掉沉渣当高汤用，鲜味全靠它。用冷水泡不透，开水泡会把鲜味冲淡。",
    "嫩豆腐先用淡盐水浸五分钟，豆腥味减轻，质地也更紧实，下锅煎不容易碎。",
    "煎豆腐时不要频繁翻动，等一面结出薄薄的黄皮再翻，铲子一推能动就是好了。",
    "最后的水淀粉要分两次淋，一次淋完容易结成块。汁收到能挂勺就停，过火就糊了。"
  ],
  "common_mistakes": [
    "虾米没泡就下锅，咬着硬邦邦还有沙。必须温水泡足十分钟并挑去杂质。",
    "豆腐一下锅就翻，碎成渣。要中火定住底面结皮再翻面。",
    "泡虾米的水倒掉，整道菜鲜味掉一半。滤掉沉渣后要全部用上。",
    "水淀粉一次倒进去，汤汁结块。要分两次淋并边淋边晃锅。"
  ],
  "substitutions": [
    {
      "original": "虾米",
      "substitute": "干贝",
      "ratio": "60克:60克",
      "note": "鲜味更清甜，泡发时间需延长到二十分钟。"
    },
    {
      "original": "嫩豆腐",
      "substitute": "豆腐干",
      "ratio": "450克:350克",
      "note": "口感更扎实，煎制时间缩短两分钟。"
    }
  ],
  "variations": [
    "把虾米换成咸鱼粒，做成客家咸鱼豆腐煲，咸香更重，配白粥极好。",
    "加一把泡发的木耳同焖，口感更丰富，也是客家山区的常见做法。",
    "改用砂锅焖，收汁后连锅上桌，冬天吃着热乎，豆腐也更入味。"
  ],
  "serving_suggestion": "趁热上桌，豆腐外皮微黄吸饱汤汁，虾米的鲜和香菇的香都渗进豆腐里，舀一勺浇在米饭上最香。",
  "storage": "冷藏可放两天，复热加两勺清水小火焖三分钟；豆腐隔夜会更入味，但蒜苗须挑出再热。",
