  "equipment": [
    "蒸锅",
    "深盘",
    "细筛"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐切成一厘米厚的片，铺在深盘底部，稍微按平让表面平整。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆腐铺平蒸出来才不歪，切太薄容易碎，这一步千万别省。",
      "visual_cue": "豆腐铺满盘底，平整无缺口"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加盐，边倒温水边顺同一方向搅匀，兑到蛋液总量约五百毫升。",
      "time_min": 4,
      "heat": "无火",
      "tip": "温水能让蛋液更快凝固，冷水会延长蒸制时间。",
      "visual_cue": "蛋液匀净，颜色淡黄，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "蛋液过一次细筛倒进盘里，滤掉泡沫和系带，撇净表面的小泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过筛是镜面的关键，泡沫留着就成麻点，提前把配料备好再动手更稳。",
      "visual_cue": "蛋液清亮，表面无泡，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "盘口盖上保鲜膜或扣一只浅盘，放进上汽的蒸锅，中小火蒸十二分钟。",
      "time_min": 14,
      "heat": "中小火",
      "tip": "盖住防止水汽滴落打坑，火大蛋面会起蜂窝。",
      "visual_cue": "锅盖边缘冒细汽，蛋面微颤"
    },
    {
      "n": 5,
      "text": "取下覆盖物，用牙签插入中心，拔出不见蛋液带出就说明已经熟透。",
      "time_min": 2,
      "heat": "无火",
      "tip": "牙签判断比看时间准，盘厚时差好几分钟，火候和顺序都要留神。",
      "visual_cue": "牙签干净，蛋面平整如镜，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "淋上生抽和芝麻油，撒小葱葱花，趁热端上桌用勺子挖着吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调味料最后淋，蒸前放盐会让蛋羹出水，提前把配料备好再动手更稳。",
      "visual_cue": "酱色挂在表面，葱花翠绿，颜色和形态变化明显"
    }
  ],
  "tips": [
    "蛋液与温水按一比一点五兑，蒸出来才嫩滑不蜂窝。",
    "蛋液过一遍细筛，滤掉泡沫和系带，表面才平整如镜。",
    "蒸的时候盘子盖上保鲜膜或扣一只盘，水汽落下来不会打出坑。"
  ],
  "common_mistakes": [
    "直接加冷水兑蛋液，蒸了十五分钟中心还是晃动的，外层却已起蜂窝。",
    "大火猛蒸，蛋面鼓出一个个气孔，像马蜂窝一样粗糙。",
    "豆腐切好直接倒蛋液，豆腐沉底压成泥，成品分层不好看。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "玉子豆腐",
      "ratio": "300克:250克",
      "note": "口感更滑，蒸的时间缩短两分钟。"
    },
    {
      "original": "生抽",
      "substitute": "蒸鱼豉油",
      "ratio": "15毫升:15毫升",
      "note": "咸度略低，鲜味更足。"
    }
  ],
  "variations": [
    "蛋液里加一勺虾皮，鲜味更足，是安徽沿江一带的吃法。",
    "表面撒一把剁辣椒再蒸，做成微辣版，下饭更过瘾。"
  ],
  "serving_suggestion": "蒸好淋生抽和芝麻油，撒葱花，用勺子从边缘舀起，配米饭或粥都合适。",
  "storage": "冷藏可放一天，回热用蒸锅蒸五分钟，微波会让蛋羹出水变蜂窝。",
