  ],
  "steps": [
    {
      "n": 1,
      "text": "排骨放进清水里泡三十分钟，中途换一次水，泡掉骨缝里的血水。",
      "time_min": 32,
      "heat": "无火",
      "tip": "泡过的排骨焯水浮沫少，汤更清甜。",
      "visual_cue": "水色泛红，排骨发白"
    },
    {
      "n": 2,
      "text": "冷水下锅加姜片与料酒，中火煮开后撇净浮沫，再煮两分钟。",
      "time_min": 9,
      "heat": "中火",
      "tip": "必须冷水下锅，血水才随温度慢慢逼出来。",
      "visual_cue": "浮沫成片，汤色转清"
    },
    {
      "n": 3,
      "text": "捞出排骨用温水冲净表面浮沫，砂锅坐火烧开一锅清水。",
      "time_min": 6,
      "heat": "大火",
      "tip": "用温水冲洗，冷水一激肉会紧得咬不动。",
      "visual_cue": "排骨干净，水滚翻花"
    },
    {
      "n": 4,
      "text": "把排骨与姜片、葱结放进砂锅，转小火炖五十分钟。",
      "time_min": 52,
      "heat": "小火",
      "tip": "水面保持小泡微滚，大滚会把汤煮浑。",
      "visual_cue": "汤面微沸，肉香散出"
    },
    {
      "n": 5,
      "text": "山药去皮切成三厘米长的滚刀块，泡在清水里防止发黑。",
      "time_min": 7,
      "heat": "无火",
      "tip": "戴手套削山药，黏液沾手会痒得难受。",
      "visual_cue": "山药块白净，切口平整"
    },
    {
      "n": 6,
      "text": "捞出山药沥干，与红枣一起放进汤里继续炖二十分钟。",
      "time_min": 21,
      "heat": "小火",
      "tip": "山药后放，久炖会化成糊，汤也变浊。",
      "visual_cue": "山药变软，边缘透亮"
    },
    {
      "n": 7,
      "text": "加盐调味，撒白胡椒搅匀，再放枸杞煮三分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盐最后放，早放排骨不容易炖软。",
      "visual_cue": "汤色清亮，味道鲜甜"
    },
    {
      "n": 8,
      "text": "挑出葱结，连砂锅端上桌，按人头分碗趁热喝。",
      "time_min": 3,
      "heat": "无火",
      "tip": "砂锅蓄热好，喝到最后一口还是烫的。",
      "visual_cue": "汤面清透，飘着油花"
    }
  ],
  "tips": [
    "铁棍山药口感粉糯，炖汤最合适，普通山药偏水。",
    "排骨焯水后别用冷水冲，用温水才不会紧缩。",
    "汤要一次加够水，中途补水会让味道变淡。",
    "红枣去核再放，久炖不会带出苦味。"
  ],
  "common_mistakes": [
    "排骨不焯水直接炖，汤浑得发灰还带腥味。",
    "山药早放同炖，出锅只剩一锅糊。",
    "中途反复加冷水，汤味冲淡，肉也发柴。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "筒骨",
      "ratio": "600克:700克",
      "note": "汤更浓但肉少，炖制时间加二十分钟。"
    },
    {
      "original": "山药",
      "substitute": "莲藕",
      "ratio": "400克:400克",
      "note": "口感更脆，炖制时间加十分钟。"
    }
  ],
  "variations": [
    "加几片咸肉同炖，汤色转白，鲜味更足，是徽州常见的做法。",
    "加一把玉米段，汤更清甜，适合孩子喝。"
  ],
  "serving_suggestion": "四人份汤菜，配米饭与一碟腌菜，作为秋冬家常汤最滋养。",
  "storage": "冷藏两天内吃完，撇去表面油脂后复热；山药久放易发酸，不建议反复加热。",
