  "equipment": [
    "蒸锅",
    "和面盆",
    "擀面杖",
    "笼布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水化开酵母与白糖，静置五分钟到表面浮起一层细泡。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水温摸着温热就好，烫手会把酵母烫死。",
      "visual_cue": "水面浮起细密泡沫，闻得到淡淡酒香"
    },
    {
      "n": 2,
      "text": "面粉倒进盆里，分次加入酵母水，揉成光滑不粘手的面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水别一次倒完，留两勺看面团软硬再定。",
      "visual_cue": "面团表面光滑，盆壁干净光洁不粘手"
    },
    {
      "n": 3,
      "text": "盖湿布放在温暖处发酵一小时，面团膨到原来的两倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "用手指戳洞不回缩就是发好了，看状态别看时间。",
      "visual_cue": "体积翻倍，内部布满大小均匀的蜂窝"
    },
    {
      "n": 4,
      "text": "腊肉切成小丁，下锅用小火慢慢煸出油，再放姜末与小葱碎炒香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "腊肉本身咸，煸出油后咸味才均匀散开。",
      "visual_cue": "腊肉丁透亮出油，锅底积一层清亮的油"
    },
    {
      "n": 5,
      "text": "加入笋丁与香菇丁炒三分钟，淋生抽拌匀后关火放凉。",
      "time_min": 4,
      "heat": "中火",
      "tip": "馅料一定要放凉再包，太烫会把面团烫死。",
      "visual_cue": "馅料颜色深褐发亮，闻起来咸香扑鼻"
    },
    {
      "n": 6,
      "text": "面团排气后分成十个小剂子，擀成中间厚边缘薄的圆皮。",
      "time_min": 10,
      "heat": "无火",
      "tip": "边缘擀薄一点才好收口，中间留厚一些才托得住馅。",
      "visual_cue": "面皮圆整，中心略厚边缘薄到透光"
    },
    {
      "n": 7,
      "text": "每张皮包入一勺馅料，捏褶收口，摆在笼布上醒二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "包好要二次醒发，不然蒸出来是死面疙瘩。",
      "visual_cue": "包子胚明显变大，手按下去慢慢回弹"
    },
    {
      "n": 8,
      "text": "水开后上锅大火蒸十五分钟，关火焖三分钟再揭盖。",
      "time_min": 18,
      "heat": "大火",
      "tip": "关火别马上开盖，骤冷会让包子回缩。",
      "visual_cue": "包子白胖饱满，褶子清晰不塌"
    }
  ],
  "tips": [
    "腊肉先蒸十分钟再切，油分更容易煸出来。",
    "馅里加一点笋丁，能解腊肉的油腻。",
    "蒸的时候水里滴几滴醋，包子皮更白。",
    "剩的包子冷藏后复蒸六分钟，口感几乎不变。"
  ],
  "common_mistakes": [
    "馅料太湿直接包，蒸的时候汤汁把皮泡破。",
    "包子包好立刻上锅，没有二次醒发蒸出来发硬。",
    "关火马上开盖，白胖的包子瞬间回缩成皱皮。"
  ],
  "substitutions": [
    {
      "original": "腊肉",
      "substitute": "咸肉",
      "ratio": "150克:150克",
      "note": "咸度接近，可少放生抽。"
    },
    {
      "original": "竹笋",
      "substitute": "马蹄",
      "ratio": "120克:130克",
      "note": "口感更脆甜，解腻效果更好。"
    }
  ],
  "variations": [
    "馅里加一勺辣椒酱，做成微辣的版本。",
    "面团里揉进一点猪油，包子皮更松软洁白。"
  ],
  "serving_suggestion": "趁热配一碗白粥或清汤，是很实在的一顿早饭。",
  "storage": "冷藏两天，冷冻可放一个月，复蒸八分钟口感基本恢复。",
