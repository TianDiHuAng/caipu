        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "炒锅",
    "漏勺",
    "碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小葱洗净彻底晾干，切成五厘米长段，葱白与葱绿分开。",
      "time_min": 6,
      "heat": "无火",
      "tip": "葱必须干透，带水下油锅会炸得四处飞溅。",
      "visual_cue": "葱段干爽，长短一致"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，冷油下葱白，开最小火慢慢熬八分钟到出香。",
      "time_min": 9,
      "heat": "小火",
      "tip": "冷油下锅、小火慢熬，葱香一点点渗进油里，急不得。",
      "visual_cue": "葱白变浅黄，油面微冒泡"
    },
    {
      "n": 3,
      "text": "放入葱绿继续小火熬五分钟，熬到葱段干瘪卷曲、颜色转深褐。",
      "time_min": 6,
      "heat": "小火",
      "tip": "葱绿比葱白易焦，后放才不会苦。",
      "visual_cue": "葱段焦褐卷曲，香气浓烈"
    },
    {
      "n": 4,
      "text": "关火捞出葱段留用，锅里只剩葱油，加生抽、老抽与白糖。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁油温热把调料化开，糖才融得匀。",
      "visual_cue": "油与酱油混成深褐酱汁"
    },
    {
      "n": 5,
      "text": "汤锅烧一大锅水，加盐，水开后下面条煮到八分熟。",
      "time_min": 8,
      "heat": "大火",
      "tip": "面煮到中间留一丝白芯就捞，拌好后才筋道。",
      "visual_cue": "面条浮起，中间有白芯"
    },
    {
      "n": 6,
      "text": "面条捞进漏勺，过一遍凉开水，再甩干面条表面的水汽。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过凉水让面更爽滑，甩干才挂得住酱。",
      "visual_cue": "面条爽滑不粘，水沥干"
    },
    {
      "n": 7,
      "text": "面条装碗，舀两勺葱油酱汁淋上，放回焦葱段。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酱汁按口味加，先少后多，拌完尝一次最准。",
      "visual_cue": "面条裹上深褐酱汁"
    },
    {
      "n": 8,
      "text": "用筷子从碗底往上挑着拌匀，让每根面都沾上葱油。",
      "time_min": 2,
      "heat": "无火",
      "tip": "挑拌比搅拌更匀，面条也不易断。",
      "visual_cue": "根根油亮，葱香扑鼻"
    }
  ],
  "tips": [
    "葱油一次可以多熬些，装瓶冷藏能放半个月。",
    "加一勺猪油与葱油同拌，香气更厚，是江南的老吃法。",
    "面条选细的碱水面，挂酱最好，宽的会滑酱。",
    "拌好后撒一把白芝麻，口感更香。"
  ],
  "common_mistakes": [
    "葱带水下热油，油花四溅，还溅得灶台一片狼藉。",
    "大火熬葱，葱段一下焦黑，油里全是苦味。",
    "面条煮过头再拌，一搅就断，口感发糊。"
  ],
  "substitutions": [
    {
      "original": "小葱",
      "substitute": "大葱",
      "ratio": "120克:150克",
      "note": "葱味更冲，熬制时间延长三分钟。"
    },
    {
      "original": "植物油",
      "substitute": "花生油",
      "ratio": "80毫升:80毫升",
      "note": "坚果香更浓，注意花生过敏者不可食。"
    }
  ],
  "variations": [
    "加一勺开洋与葱同熬，鲜味更足，是上海版本的做法。",
    "加几滴香醋，酸香解腻，夏天吃更爽口。"
  ],
  "serving_suggestion": "两人份主食，配一碗清汤或一碟凉拌菜。",
  "storage": "葱油冷藏可存半个月，拌面时取用；煮好的面须现拌现吃，不宜久放。",
