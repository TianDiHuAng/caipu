  ],
  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "木铲",
    "小碗",
    "漏盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "空心菜择下嫩叶与茎，掐成五厘米长的段，老梗另放一旁不用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "梗和叶分开下锅，熟度才一致。",
      "visual_cue": "叶片完整，梗叶分堆"
    },
    {
      "n": 2,
      "text": "空心菜洗净后放进漏盆沥水，尽量甩干表面水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "带水下锅会溅油，炒出来也出水。",
      "visual_cue": "叶片干爽，无滴水"
    },
    {
      "n": 3,
      "text": "取三块腐乳放进小碗，加料酒与白糖压成细腻的酱糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "压得越细越好，结块会咸淡不匀。",
      "visual_cue": "酱糊顺滑，无颗粒"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒花生油，下姜丝、蒜末与干辣椒小火爆香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末一变色就下菜，别等焦了。",
      "visual_cue": "蒜香散出，油色微黄"
    },
    {
      "n": 5,
      "text": "转大火，先把空心菜梗倒进锅里翻炒一分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "梗先下锅，叶子后放，才不会一锅糊。",
      "visual_cue": "菜梗转为翠绿，略软"
    },
    {
      "n": 6,
      "text": "接着下叶片，大火快速翻炒一分钟至叶子塌软。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火，火小了菜会出一锅水。",
      "visual_cue": "叶片塌软，颜色深绿"
    },
    {
      "n": 7,
      "text": "淋入调好的腐乳酱，沿锅边快速翻拌三十秒让酱裹匀。",
      "time_min": 1,
      "heat": "大火",
      "tip": "酱一下锅就得快翻，否则容易糊底发苦。",
      "visual_cue": "菜叶挂酱，色呈暗红"
    },
    {
      "n": 8,
      "text": "尝味后按需补一点盐，立刻出锅装盘，趁热吃最脆。",
      "time_min": 2,
      "heat": "无火",
      "tip": "腐乳本身够咸，盐要尝过再决定加不加。",
      "visual_cue": "菜色油亮，盘底无汤"
    }
  ],
  "tips": [
    "空心菜选梗细叶嫩的，粗梗口感像草绳。",
    "红腐乳比白腐乳更适合，颜色和咸香都更足。",
    "炒之前把调料全部备好，下锅后没有停顿的余地。",
    "加几滴料酒能压住腐乳的发酵味。"
  ],
  "common_mistakes": [
    "空心菜洗完不沥水就下锅，炒完半盘都是汤水。",
    "火太小慢慢炒，菜叶发黄发暗，口感塞牙。",
    "腐乳不压碎直接下锅，一块咸得发苦，其余没味。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "菜心",
      "ratio": "400克:400克",
      "note": "口感更脆甜，炒制时间加半分钟。"
    },
    {
      "original": "腐乳",
      "substitute": "豆腐乳酱",
      "ratio": "3块:35克",
      "note": "咸度略低，盐可少量补加。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同炒，吸满酱汁后很入味。",
    "不加辣椒，改用腐乳汁小火焖一分钟，做成更清淡的版本。"
  ],
  "serving_suggestion": "两人份家常菜，配白粥或米饭，作为夏天的快手小炒最合适。",
  "storage": "建议现炒现吃，冷藏不超过一天；复热须大火快炒，久热菜叶会发黄出水。",
