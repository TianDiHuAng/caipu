  "steps": [
    {
      "n": 1,
      "text": "面粉加温水揉成软面团，盖布醒三十分钟。这一步不要着急。",
      "time_min": 34,
      "heat": "无火",
      "tip": "面团偏软，压出来才不裂。，注意火候。",
      "visual_cue": "面团光滑，按压回弹，状态稳定"
    },
    {
      "n": 2,
      "text": "梅干菜泡三十分钟洗净，挤干切碎。这一步不要着急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "洗到水清，成品才不牙碜。，注意火候。",
      "visual_cue": "菜末细碎，无硬梗，状态稳定"
    },
    {
      "n": 3,
      "text": "五花肉切小丁，冷锅小火煸出油加生抽。这一步不要着急。",
      "time_min": 7,
      "heat": "小火",
      "tip": "煸出油，馅才不干。，注意火候。",
      "visual_cue": "肉丁焦黄，酱色匀，状态稳定"
    },
    {
      "n": 4,
      "text": "下梅干菜碎炒香，加盐调味，撒小葱末拌匀后盛出晾凉。",
      "time_min": 6,
      "heat": "中火",
      "tip": "馅凉透再包，饼皮才不破。，注意火候。",
      "visual_cue": "馅料油亮，香气浓，状态稳定"
    },
    {
      "n": 5,
      "text": "面团擀成大薄片，抹猪油后卷起切段。这一步不要着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "抹油卷起，烙出来才分层。，注意火候。",
      "visual_cue": "层次分明，段口露圈，状态稳定"
    },
    {
      "n": 6,
      "text": "每段压扁包入馅料，收口后压成圆饼。这一步不要着急。",
      "time_min": 9,
      "heat": "无火",
      "tip": "收口捏紧压扁，馅才不会漏。，注意火候。",
      "visual_cue": "饼坯圆整，厚薄一致，状态稳定"
    },
    {
      "n": 7,
      "text": "平底锅铺一层洗净的鹅卵石，中火烧热。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "石头传热均匀，饼才烙得透。，注意火候。",
      "visual_cue": "石头烫手，微微冒烟，状态稳定"
    },
    {
      "n": 8,
      "text": "饼坯放石头上，压上另一层热石烙五分钟。这一步不要着急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "上下都受热，饼面才起焦斑。，注意火候。",
      "visual_cue": "两面焦斑，饼身鼓起，状态稳定"
    },
    {
      "n": 9,
      "text": "取出拍掉碎石屑，趁热吃最香。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "小心烫，掰开再咬。，注意火候。",
      "visual_cue": "外壳硬脆，内里柔软，状态稳定"
    }
  ],
  "tips": [
    "面团要软，石头压过才不裂。，值得留意。",
    "石头必须干净，先刷洗再烧热。，值得留意。",
    "火别太猛，饼厚容易外焦内生。，值得留意。"
  ],
  "common_mistakes": [
    "面团硬，压下去直接裂开。，值得留意。",
    "馅带水，烙的时候漏一锅。，值得留意。",
    "火太大，外壳焦了里面还是生面。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鹅卵石",
      "substitute": "厚铸铁锅",
      "ratio": "适量:1 口",
      "note": "没有石头就用厚锅压重物。"
    },
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "100 克:80 克",
      "note": "咸香更浓，盐要减。"
    }
  ],
  "variations": [
    "馅里加一点辣椒粉，微辣更开胃。，值得留意。",
    "用平底锅干烙，虽少焦香但更方便。，值得留意。"
  ],
  "serving_suggestion": "趁热配豆浆，或夹一根油条。，效果更稳定。",
  "storage": "冷藏两天，复热用平底锅干烙三分钟。，效果更稳定。",
