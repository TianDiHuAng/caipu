  "steps": [
    {
      "n": 1,
      "text": "排骨斩成四厘米小段，冷水泡二十分钟去血水。这一步别着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡出血水，蒸出来才不腥。，注意火候。",
      "visual_cue": "水色转红，排骨发白，状态稳定"
    },
    {
      "n": 2,
      "text": "大米洗净晾干，干锅小火炒到微黄。这一步别着急。",
      "time_min": 8,
      "heat": "小火",
      "tip": "炒到米粒泛黄，香味才出来。，注意火候。",
      "visual_cue": "米粒微黄，香气散出，状态稳定"
    },
    {
      "n": 3,
      "text": "炒好的米用擀面杖擀成粗米粉。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "带点颗粒，蒸好才有口感。，注意火候。",
      "visual_cue": "粉粒粗砂状，粗细不匀"
    },
    {
      "n": 4,
      "text": "排骨沥干，加生抽、老抽、料酒和豆瓣酱抓匀。这一步别着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用手抓才入味，别只拌表面。，注意火候。",
      "visual_cue": "排骨上色，酱料挂匀，状态稳定"
    },
    {
      "n": 5,
      "text": "加姜末、蒜末、白糖和盐，腌二十分钟。这一步别着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "腌够时间，味道才进肉里。，注意火候。",
      "visual_cue": "排骨湿润，香气明显，状态稳定"
    },
    {
      "n": 6,
      "text": "分次加入米粉和清水，拌到每块都裹上粉。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "粉太干蒸出来发硬，水要少量多次。，注意火候。",
      "visual_cue": "排骨裹粉均匀，不干不湿"
    },
    {
      "n": 7,
      "text": "码进大碗，肉厚的一面朝上，上锅大火烧开。这一步别着急。",
      "time_min": 6,
      "heat": "大火",
      "tip": "码紧一点，蒸的时候不易散。，注意火候。",
      "visual_cue": "碗内平实，水已沸腾，状态稳定"
    },
    {
      "n": 8,
      "text": "转中火蒸六十分钟，直到排骨脱骨。这一步别着急。",
      "time_min": 62,
      "heat": "中火",
      "tip": "中途别开盖，蒸汽跑了就蒸不酥。，注意火候。",
      "visual_cue": "排骨软烂，粉层油润，状态稳定"
    },
    {
      "n": 9,
      "text": "取出撒小葱末，趁热连粉带肉吃。这一步别着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "碗底的粉最香，别浪费。，注意火候。",
      "visual_cue": "表面葱绿，粉肉分明，状态稳定"
    }
  ],
  "tips": [
    "大米炒香再磨粉，香气才够。，值得留意。",
    "米粉加水分次拌，裹层才不干。，值得留意。",
    "蒸的过程别开盖，一次蒸透。，值得留意。"
  ],
  "common_mistakes": [
    "粉拌太干，蒸出来像石头。，值得留意。",
    "没腌够时间，肉里没味。，值得留意。",
    "中途开盖，蒸了两次也不烂。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "五花肉",
      "ratio": "600 克:600 克",
      "note": "更油润，蒸的时间缩短十分钟。"
    },
    {
      "original": "豆瓣酱",
      "substitute": "腐乳汁",
      "ratio": "20 克:25 克",
      "note": "风味更柔，盐要减。"
    }
  ],
  "variations": [
    "碗底垫一层南瓜或土豆，吸汁更好吃。，值得留意。",
    "加一勺辣椒粉，做成微辣版。，值得留意。"
  ],
  "serving_suggestion": "上桌连碗端，配米饭和青菜。，效果更稳定。",
  "storage": "冷藏两天，复热上锅蒸十五分钟。，效果更稳定。",
