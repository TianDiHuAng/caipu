  "equipment": [
    "陶罐",
    "砧板",
    "晒架",
    "重石"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆角挑去虫蛀和发黄的，掐掉两头，用清水冲洗两遍。",
      "time_min": 10,
      "heat": "无火",
      "tip": "有虫眼的挑出去，一颗坏的会让整罐变味。",
      "visual_cue": "豆角颜色翠绿，表面没有虫眼与黑斑"
    },
    {
      "n": 2,
      "text": "把豆角摊在竹筛上晒两小时，晒到表面水汽全干、略微软塌。",
      "time_min": 120,
      "heat": "无火",
      "tip": "表面不能带生水，见干就行不要晒到发白。",
      "visual_cue": "豆角皮起细皱，摸上去干爽不粘手"
    },
    {
      "n": 3,
      "text": "陶罐用开水烫过倒扣晾干，确保里面一点水都没有。",
      "time_min": 10,
      "heat": "无火",
      "tip": "罐子带油带水，腌出来会起一层白霉。",
      "visual_cue": "罐壁干燥，闻起来没有杂味"
    },
    {
      "n": 4,
      "text": "豆角与盐一起放进盆里，用手反复揉搓到颜色变深发亮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "揉到出水是关键，盐才能均匀进到豆角里。",
      "visual_cue": "豆角颜色转深绿，盆底见到少量水"
    },
    {
      "n": 5,
      "text": "豆角盘成小把塞进陶罐，中间夹入大蒜、姜片、干辣椒与花椒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一层豆角一层香料，味道才好得均匀。",
      "visual_cue": "罐内塞得紧实，香料均匀夹在缝隙里"
    },
    {
      "n": 6,
      "text": "撒上冰糖淋入料酒，压上重石让豆角完全浸在盐水里。",
      "time_min": 4,
      "heat": "无火",
      "tip": "豆角浮起来接触空气就会坏，重石别省。",
      "visual_cue": "液面高过豆角两指，重石压得稳稳的"
    },
    {
      "n": 7,
      "text": "盖盖放在阴凉处静置七天，期间每天开盖放一次气。",
      "time_min": 20,
      "heat": "无火",
      "tip": "天热会更快，第三天开始每天尝一根看酸度。",
      "visual_cue": "开盖时有气泡声，酸香明显但不冲鼻"
    }
  ],
  "tips": [
    "腌好的豇豆切碎炒肉末，是徽州最家常的吃法。",
    "取豆角时用干净无水的筷子，剩下的能放很久。",
    "喜欢脆口的腌五天就够，喜欢酸的可以放到十天。",
    "罐口淋一层白酒，能压住表面起的白膜。"
  ],
  "common_mistakes": [
    "豆角表面带生水就下罐，几天后整罐长毛发黏。",
    "盐放得太少，豆角会软烂发臭，而不是正常的酸香。",
    "重石太轻豆角浮在液面，露在外面的那截坏掉。"
  ],
  "substitutions": [
    {
      "original": "豆角",
      "substitute": "长豆角",
      "ratio": "500克:500克",
      "note": "越细的越脆，粗的要去筋。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "10克:10克",
      "note": "发酵速度更快，酸味稍直。"
    }
  ],
  "variations": [
    "加几片新鲜紫苏叶一起腌，酸香里多一层草木气。",
    "腌好后拌辣椒油与蒜末，直接当小菜上桌。"
  ],
  "serving_suggestion": "切碎炒腊肉，或者直接拌米饭，酸香解腻特别开胃。",
  "storage": "连罐冷藏可存三个月，取用时保持器具无水无油。",
