  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成三毫米粗的细丝，切好后立刻泡进清水里泡十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡掉表面的浆水，炒出来才根根分明不粘锅。",
      "visual_cue": "水变浑浊，丝条松散"
    },
    {
      "n": 2,
      "text": "泡好的土豆丝换两遍清水，冲洗到水基本清澈后沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水清说明浆水冲净，这一步别省，脆不脆全靠它。",
      "visual_cue": "水色清亮，丝条爽脆"
    },
    {
      "n": 3,
      "text": "青椒去籽切成与土豆丝同粗的丝，蒜切末备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粗细一致，受热才均匀，入口也整齐。",
      "visual_cue": "丝条均匀，配色分明"
    },
    {
      "n": 4,
      "text": "炒锅烧到微微冒烟，倒花生油与花椒，小火炸出香味后捞出花椒。",
      "time_min": 3,
      "heat": "小火",
      "tip": "花椒只要香味不要焦苦，颜色变深就捞。",
      "visual_cue": "油面起小泡，花椒浮起"
    },
    {
      "n": 5,
      "text": "下干辣椒段与蒜末爆香十秒，闻到辣味立刻下土豆丝。",
      "time_min": 2,
      "heat": "大火",
      "tip": "辣椒炒久了发黑发苦，动作要赶在变黑前。",
      "visual_cue": "辣香升起，油色微红"
    },
    {
      "n": 6,
      "text": "大火快速翻炒三分钟，让每根丝都裹上油光。",
      "time_min": 4,
      "heat": "大火",
      "tip": "全程大火快炒，火小了丝会出水变软。",
      "visual_cue": "丝条透亮，锅气明显"
    },
    {
      "n": 7,
      "text": "沿锅边淋白醋，加盐与白糖继续翻炒一分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋沿锅边淋才香，直接倒中间只剩酸味。",
      "visual_cue": "醋香冲起，丝条发亮"
    },
    {
      "n": 8,
      "text": "放青椒丝与葱段翻炒三十秒，断生立刻离火装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "青椒最后放，久炒会发黄失去脆感。",
      "visual_cue": "青椒翠绿，丝条爽脆"
    }
  ],
  "tips": [
    "土豆选黄心的，口感更脆也更甜。",
    "切丝比擦丝好，擦出来的丝边缘糊，口感软塌。",
    "喜欢更酸可以在出锅前再补几滴白醋。",
    "炒前把锅烧到冒烟，土豆丝才不容易粘。"
  ],
  "common_mistakes": [
    "土豆丝不泡水直接下锅，粘锅成坨，颜色也发暗发黑。",
    "火太小慢慢炒，丝条出水，最后成了土豆泥。",
    "醋一开始就倒，挥发光了只剩下酸涩味。"
  ],
  "substitutions": [
    {
      "original": "白醋",
      "substitute": "米醋",
      "ratio": "25毫升:25毫升",
      "note": "酸味更柔和，香气略淡。"
    },
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "60克:60克",
      "note": "辣味降低，颜色更鲜亮。"
    }
  ],
  "variations": [
    "加一把泡发的木耳丝同炒，口感层次更丰富。",
    "减辣椒加孜然，做成带西北风味的炒土豆丝。"
  ],
  "serving_suggestion": "三人份家常菜，配米饭、馒头或粥都合适，作为一桌菜里的解腻小炒最好。",
  "storage": "冷藏一天内吃完，复热用大火快炒一分钟；不建议久放，回软后口感全失。",
