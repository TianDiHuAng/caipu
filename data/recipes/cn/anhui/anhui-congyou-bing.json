  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "和面",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 80,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "清水",
          "name_en": "water",
          "amount": 180,
          "unit": "ml",
          "note": "四十度左右",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 60,
          "unit": "ml",
          "note": "做油酥",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "大碗",
    "刀",
    "砧板",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒进大碗，分三次加入温水，边加边用筷子搅成絮状。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水温手摸着温不烫，太烫会把面烫死。",
      "visual_cue": "面成絮状，无干粉"
    },
    {
      "n": 2,
      "text": "揉成光滑面团，盖上湿布醒三十分钟，中途再揉一次。",
      "time_min": 34,
      "heat": "无火",
      "tip": "醒够时间面才柔韧，擀开不回缩。",
      "visual_cue": "面团光滑，手压有弹性"
    },
    {
      "n": 3,
      "text": "另取三十克面粉加盐与白胡椒，浇入烧到冒烟的花生油拌成油酥。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油要够热才能把面粉烫香，酥层才明显。",
      "visual_cue": "油酥成糊，香气散出"
    },
    {
      "n": 4,
      "text": "小葱洗净沥干，切成细葱花，尽量只用葱绿的部分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "葱花带水会让饼皮破，务必沥干。",
      "visual_cue": "葱花细碎干爽，色翠绿"
    },
    {
      "n": 5,
      "text": "面团分成三份，取一份擀成两毫米厚的长方片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "擀得越薄，起层越多，口感越酥。",
      "visual_cue": "面片薄透，边缘整齐"
    },
    {
      "n": 6,
      "text": "在面片上刷满油酥，撒一层盐与葱花，卷成长条再盘成圆饼。",
      "time_min": 6,
      "heat": "无火",
      "tip": "卷的时候稍拉长，层次才分得开。",
      "visual_cue": "长条紧实，圆饼成形"
    },
    {
      "n": 7,
      "text": "把盘好的饼坯压扁，轻轻擀成八毫米厚的圆饼，别擀太薄。",
      "time_min": 4,
      "heat": "无火",
      "tip": "擀太薄会把层压死，烙出来是死面饼。",
      "visual_cue": "饼坯圆整，层次可见"
    },
    {
      "n": 8,
      "text": "平底锅刷一层薄花生油，中小火放饼，一面烙三分钟至金黄起层。",
      "time_min": 4,
      "heat": "小火",
      "tip": "火大了外面焦里面还生，一定中小火。",
      "visual_cue": "饼边鼓起，底面金黄"
    },
    {
      "n": 9,
      "text": "翻面再烙三分钟，用铲子轻压让层次散开，出锅趁热切块。",
      "time_min": 4,
      "heat": "小火",
      "tip": "压一压饼会更酥，层次也更好看。",
      "visual_cue": "两面金黄，层次分明"
    }
  ],
  "tips": [
    "油酥里加一点白芝麻，香气更浓也更好看。",
    "面团可以前一晚和好冷藏，早上直接擀更省时。",
    "葱花只用葱绿，葱白水分多容易把饼皮弄破。",
    "烙好的饼盖一块干净布，凉了也不会硬。"
  ],
  "common_mistakes": [
    "水太烫把面烫熟，揉出来一团死面，烙完又硬又韧。",
    "饼坯擀得太薄，层次全压死，成品像薄脆。",
    "平底锅大火烙，外面焦黑，里面还是生面。"
  ],
  "substitutions": [
    {
      "original": "中筋面粉",
      "substitute": "低筋面粉",
      "ratio": "300克:300克",
      "note": "口感更酥，但延展性略差。"
    },
    {
      "original": "花生油",
      "substitute": "猪油",
      "ratio": "60毫升:55克",
      "note": "层次更酥脆，香气也更浓。"
    }
  ],
  "variations": [
    "油酥里拌入一点五香粉，做成香料味更重的版本。",
    "加一层肉松或咸蛋黄碎，做成更豪华的夹馅葱油饼。"
  ],
  "serving_suggestion": "三人份主食，配一碗豆浆或小米粥，作为早餐或下午点心都合适。",
  "storage": "室温密封可放一天，冷藏两天；复热用平底锅干烙两分钟，能恢复酥脆。",
  "nutrition_estimate": {
    "basis": "按三人份估算",
    "calories_kcal": 480,
    "protein_g": 10,
