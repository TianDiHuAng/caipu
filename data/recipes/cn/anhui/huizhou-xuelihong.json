        }
      ]
    }
  ],
  "equipment": [
    "陶坛",
    "竹筛",
    "砧板",
    "干净石块"
  ],
  "steps": [
    {
      "n": 1,
      "text": "雪里蕻择去黄叶与老根，整棵冲洗干净泥沙。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部泥沙最多，要一棵棵掰开洗。",
      "visual_cue": "叶片舒展，根部不见泥点"
    },
    {
      "n": 2,
      "text": "洗净的雪里蕻挂在竹筛上晾半天，晾到叶子发软。",
      "time_min": 60,
      "heat": "无火",
      "tip": "晾软再腌，出水快也不易烂。",
      "visual_cue": "叶片蔫软，用手一折不断"
    },
    {
      "n": 3,
      "text": "晾好的雪里蕻切成两厘米长的段，摊开再晾半小时。",
      "time_min": 15,
      "heat": "无火",
      "tip": "切后晾一晾，表面水汽散掉更耐存。",
      "visual_cue": "菜段干爽，切口不发亮"
    },
    {
      "n": 4,
      "text": "陶坛用开水烫过并彻底晾干，坛底先撒上一层盐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "坛子必须干透，有一滴水就容易长霉。",
      "visual_cue": "坛内壁干燥，坛底盐粒均匀"
    },
    {
      "n": 5,
      "text": "一层菜段一层盐码进坛里，每层都用手压实。",
      "time_min": 8,
      "heat": "无火",
      "tip": "层层压实，把空气挤出去才不发酸臭。",
      "visual_cue": "菜层紧实，坛内渐见水汽"
    },
    {
      "n": 6,
      "text": "码到半坛时铺入干辣椒段与姜片，再继续码满。",
      "time_min": 3,
      "heat": "无火",
      "tip": "辣椒放中间，辣味渗得匀又不冲。",
      "visual_cue": "香料夹在菜层之间，颜色分明"
    },
    {
      "n": 7,
      "text": "最上层再撒一层厚盐，压上一块洗净的圆石块。",
      "time_min": 2,
      "heat": "无火",
      "tip": "石块压住，菜才不会浮起来发霉。",
      "visual_cue": "石块压稳，菜面低于坛口"
    },
    {
      "n": 8,
      "text": "沿坛口淋入白酒，盖严坛盖，阴凉处腌二十天。",
      "time_min": 2,
      "heat": "无火",
      "tip": "白酒封口杀菌，坛沿要常补水。",
      "visual_cue": "坛口酒香扑鼻，坛沿水清"
    },
    {
      "n": 9,
      "text": "二十天后取出，挤去多余盐水，切碎装盘即可。",
      "time_min": 4,
      "heat": "无火",
      "tip": "取用时用干净干筷，生水进去会坏坛。",
      "visual_cue": "菜色黄绿，闻着酸香带辣"
    }
  ],
  "tips": [
    "雪里蕻一定要晾到发软再腌，出水足，脆度也好。",
    "盐量按菜重的百分之四掌握，太少易坏，太多发苦。",
    "全程无油无生水，取菜用干筷，坛子能存上小半年。"
  ],
  "common_mistakes": [
    "菜没晾干就下坛，坛里很快起白沫发臭。",
    "盐撒得不匀，有的地方烂，有的地方咸得发苦。",
    "坛沿水干掉没补水，进了空气整坛菜发霉。"
  ],
  "substitutions": [
    {
      "original": "雪里蕻",
      "substitute": "芥菜",
      "ratio": "1500 克:1500 克",
      "note": "纤维更粗，腌好后适合炒肉末。"
    },
    {
      "original": "白酒",
      "substitute": "高度白酒",
      "ratio": "20 毫升:15 毫升",
      "note": "酒精度高，用量可少一些。"
    }
  ],
  "variations": [
    "腌好后切碎与腊肉同炒，就是皖南人下饭的雪菜腊肉。",
    "加点白糖与香油凉拌，酸辣爽口当小菜。"
  ],
  "serving_suggestion": "切碎淋香油直接下粥，或与肉末同炒做浇头。",
  "storage": "坛装阴凉处可存半年，取出的菜冷藏两周内吃完。",
