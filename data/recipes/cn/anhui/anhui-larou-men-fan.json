  "steps": [
    {
      "n": 1,
      "text": "米粒淘洗两遍后加清水浸泡二十分钟，捞出沥干水分，这样煮出来更易吸味。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过的米煮出来更饱满，也不容易夹生。",
      "visual_cue": "米粒发白膨胀，手指能捻断"
    },
    {
      "n": 2,
      "text": "腊肉切小丁，笋切同样大小的丁，香菇切丁，青菜洗净切段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丁切小一点，和米粒一起焖才同时熟。",
      "visual_cue": "各料丁块大小接近，约半厘米见方"
    },
    {
      "n": 3,
      "text": "砂锅倒植物油，下腊肉丁小火煸五分钟至出油微黄。",
      "time_min": 5,
      "heat": "小火",
      "tip": "腊肉先煸出油再下米，那一层烟熏的荤香才会渗进每一粒饭里。",
      "visual_cue": "肉丁透明微卷，锅底渗出清油"
    },
    {
      "n": 4,
      "text": "下姜末、香菇丁与笋丁炒香，烹入米酒，加生抽与白糖翻匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "笋丁先炒过一遍再焖，口感才会脆爽，否则在锅里会出一包水。",
      "visual_cue": "配料油亮出香，锅底见酱色"
    },
    {
      "n": 5,
      "text": "倒入沥干的米粒翻炒一分钟，加清水没过米面一厘米，大火烧开。",
      "time_min": 4,
      "heat": "大火",
      "tip": "水要比平常煮饭略少一些，腊肉和笋丁在焖的过程中还会不断出水。",
      "visual_cue": "米粒油亮裹色，水面刚好盖过米"
    },
    {
      "n": 6,
      "text": "转最小火加盖焖二十五分钟，中途不要开盖，最后五分钟铺上青菜段焖熟。",
      "time_min": 27,
      "heat": "小火",
      "tip": "整个过程千万不要开盖，蒸汽一跑光，底下的米就会夹生。",
      "visual_cue": "锅边冒小泡，能闻到米饭焦香"
    },
    {
      "n": 7,
      "text": "关火焖十分钟，开盖撒葱花，用饭勺从锅底翻拌均匀即可。",
      "time_min": 11,
      "heat": "无火",
      "tip": "关火再焖十分钟，锅底一层锅巴最香。",
      "visual_cue": "米粒分明油润，锅底结出金黄锅巴"
    }
  ],
  "tips": [
    "用砂锅焖比电饭锅更香，锅底结出的那层锅巴才是整锅饭的灵魂所在。",
    "腊肉的咸淡差别很大，生抽和盐都要先尝过味道再决定放多少。",
    "青菜最后五分钟放，才不会焖成黄叶。"
  ],
  "common_mistakes": [
    "米不泡直接焖，外软内硬，一口咬到生米。",
    "水加太多，焖成了稀饭，米粒全糊在一起。",
    "中途反复开盖查看，蒸汽跑光，饭夹生。"
  ],
  "substitutions": [
    {
      "original": "腊肉",
      "substitute": "咸肉",
      "ratio": "180克:180克",
      "note": "咸肉更咸，须先泡两小时再切。"
    },
    {
      "original": "笋",
      "substitute": "茭白",
      "ratio": "150克:150克",
      "note": "茭白水分多，焖饭的水要减两勺。"
    }
  ],
  "variations": [
    "加几颗栗子同焖，粉糯香甜，是秋冬季的时令版本。",
    "把腊肉换成腊肠，甜咸交错，孩子更爱吃。"
  ],
  "serving_suggestion": "整锅上桌，配一碟腌菜或清汤，就是徽州人的一顿饭。",
  "storage": "冷藏可存两天，复热须加一勺水小火焖五分钟。",
