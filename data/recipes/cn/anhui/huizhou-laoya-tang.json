        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
          "note": "提香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "汤锅",
    "漏勺",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "把老鸭的肉斩成四厘米见方的块，冲掉血水后沥干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "老鸭皮下脂肪厚，块要斩得均匀，炖的时候才好一起酥。",
      "visual_cue": "斩好的肉块大小一致，表面无血污"
    },
    {
      "n": 2,
      "text": "冷水下锅，加料酒与姜片，大火煮开撇净浮沫。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水慢慢加热，血水才逼得出来，汤才清。",
      "visual_cue": "浮沫由灰转白，撇净后汤色清亮"
    },
    {
      "n": 3,
      "text": "捞出肉块用温水冲一遍，把表面的浮沫渣洗干净。",
      "time_min": 3,
      "heat": "无火",
      "tip": "用温水不用冷水，冷水一激肉会紧得炖不烂。",
      "visual_cue": "斩好的肉块表面干净，不再挂沫"
    },
    {
      "n": 4,
      "text": "砂锅里放肉块、姜片与葱结，加足量开水没过肉块。",
      "time_min": 4,
      "heat": "大火",
      "tip": "水要一次加足，中途补水会把汤味冲淡。",
      "visual_cue": "水面高出斩好的肉块三指，浮着薄油"
    },
    {
      "n": 5,
      "text": "大火烧开后转小火慢炖一小时，保持汤面微沸。",
      "time_min": 60,
      "heat": "小火",
      "tip": "老鸭耐炖，火不能大，汤要似开非开才不浑。",
      "visual_cue": "汤面细密冒泡，香气浓郁"
    },
    {
      "n": 6,
      "text": "下竹笋块继续炖二十分钟，炖到老鸭的肉酥软脱骨。",
      "time_min": 20,
      "heat": "小火",
      "tip": "笋后放，炖久了会化掉，失去脆口感。",
      "visual_cue": "肉块轻扯即可离骨，笋块完整"
    },
    {
      "n": 7,
      "text": "先撇掉表面一层浮油，再加盐与白胡椒粉调味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "撇油这步别省，老鸭油多，撇了汤才清爽不腻。",
      "visual_cue": "汤面只留薄薄一层油光"
    },
    {
      "n": 8,
      "text": "撒枸杞再焖三分钟，关火后盛入汤碗即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "枸杞靠余温焖开就够，久煮会烂成渣。",
      "visual_cue": "汤色清亮微黄，枸杞浮在表面"
    }
  ],
  "tips": [
    "老鸭比嫩鸭更适合炖汤，久炖不散且味厚。",
    "想汤更清可以全程不开盖，只靠小火慢煨。",
    "加一小块火腿同炖，鲜味能提一档。",
    "笋块先焯一遍水去掉涩味，汤的味道会更纯。"
  ],
  "common_mistakes": [
    "用嫩鸭炖一小时，肉烂成渣，汤里全是碎骨。",
    "中途往里加冷水补水，汤味立刻就淡了。",
    "全程用大火滚煮，汤色浑浊还带一股腥气。"
  ],
  "substitutions": [
    {
      "original": "老鸭",
      "substitute": "老母鸡",
      "ratio": "1000克:1000克",
      "note": "炖的时间加二十分钟，汤更浓。"
    },
    {
      "original": "竹笋",
      "substitute": "冬瓜",
      "ratio": "150克:250克",
      "note": "清甜解腻，炖十五分钟即可。"
    }
  ],
  "variations": [
    "加一把笋衣与火腿片，做成徽州风味的双鲜汤。",
    "放几颗红枣一起炖，汤里会带一丝自然的甜味。"
  ],
  "serving_suggestion": "盛入大汤碗，先喝汤再吃肉，肉块蘸一点生抽吃更香。",
  "storage": "冷藏三天，撇掉表面凝固的老鸭的油再复热，风味更清爽。",
