  "steps": [
    {
      "n": 1,
      "text": "豆腐切成半厘米的小丁，放进淡盐水里泡五分钟去除豆腥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐水泡过豆腐不易碎，豆腥也淡。",
      "visual_cue": "豆腐丁白净完整，边缘不散"
    },
    {
      "n": 2,
      "text": "香菇去柄切同样大小的丁，姜切末，小葱切成细花。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香菇丁切小些，煮出来的羹才顺口。",
      "visual_cue": "香菇丁大小均匀，香气明显"
    },
    {
      "n": 3,
      "text": "汤锅倒植物油烧热，下姜末和香菇丁小火煸出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香菇先煸出香味，汤底才够浓够鲜。",
      "visual_cue": "香菇变软呈褐色，香气扑鼻"
    },
    {
      "n": 4,
      "text": "加清水和生抽烧开，放入豆腐丁转小火煮八分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "豆腐下锅后轻推别猛搅，免得碎。",
      "visual_cue": "汤色微褐，豆腐浮在汤面"
    },
    {
      "n": 5,
      "text": "淀粉加水调匀，边淋边搅，把汤勾到稀稠合适。",
      "time_min": 2,
      "heat": "小火",
      "tip": "芡要分两次淋，一次倒进去容易结块。",
      "visual_cue": "汤体透亮稠滑，能挂勺"
    },
    {
      "n": 6,
      "text": "蛋液细线般淋入搅出蛋花，加盐和白胡椒粉调味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蛋液用小火淋入，蛋花才薄而均匀漂亮。",
      "visual_cue": "蛋花飘浮成丝，汤色柔亮"
    },
    {
      "n": 7,
      "text": "撒上葱花搅匀，关火后盛入汤碗里趁热上桌喝。",
      "time_min": 1,
      "heat": "无火",
      "tip": "葱花在关火后放，香气才留得住不散。",
      "visual_cue": "汤面浮着翠绿葱花"
    }
  ],
  "tips": [
    "豆腐用淡盐水泡一会儿，不易碎且去豆腥。",
    "香菇先煸出香味，汤底才够浓郁鲜香。",
    "芡汁分两次淋，羹体才滑不结块。"
  ],
  "common_mistakes": [
    "豆腐直接大火煮，翻两下就碎成渣。",
    "淀粉一次全倒进去，整锅结成疙瘩。",
    "蛋液大火直接冲进去，蛋花又老又粗。"
  ],
  "substitutions": [
    {
      "original": "香菇",
      "substitute": "口蘑",
      "ratio": "60 克:80 克",
      "note": "香气更清，煸制时间缩短一分钟。"
    },
    {
      "original": "淀粉",
      "substitute": "藕粉",
      "ratio": "25 克:25 克",
      "note": "芡汁更透亮，需多加十毫升水调开。"
    }
  ],
  "variations": [
    "加几粒虾仁同煮，鲜味更上一层楼。",
    "放一点火腿末提味，咸香更浓更鲜。"
  ],
  "serving_suggestion": "趁热喝最柔滑，配一碗米饭或烧饼都合适。",
  "storage": "冷藏一天，复热要小火加热并不断搅动，避免糊底。",
