    "擀面杖",
    "烤箱",
    "烤盘",
    "油刷"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉取 200g 加酵母水、白糖与清水揉成软面团，盖布醒发二十分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "面团揉到光滑，饼才不裂。",
      "visual_cue": "面团光滑、按压回弹"
    },
    {
      "n": 2,
      "text": "剩余面粉与植物油、盐搓成油酥，分成八份搓圆备用。",
      "time_min": 15,
      "heat": "无火",
      "tip": "油酥要搓到能成团。",
      "visual_cue": "油酥成团、不散不粘"
    },
    {
      "n": 3,
      "text": "面团擀成长片，抹一层油酥卷起，压扁再擀成圆饼，两面刷水蘸白芝麻。",
      "time_min": 10,
      "heat": "无火",
      "tip": "卷起再擀，层次才多。",
      "visual_cue": "饼坯起层、芝麻粘牢"
    },
    {
      "n": 4,
      "text": "烤箱 200℃ 预热，饼坯摆烤盘烤十五分钟至鼓起、表面金黄。",
      "time_min": 15,
      "heat": "无火",
      "tip": "高温快烤，饼才酥脆。",
      "visual_cue": "饼身鼓起、芝麻焦香"
    },
    {
      "n": 5,
      "text": "出炉趁热拍一下散掉热气，稍放凉再吃会更酥脆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "热吃易烫，稍凉更脆。",
      "visual_cue": "外皮酥裂、层次分明"
    }
  ],
  "tips": [
    "油酥要搓到能捏成团，抹在面片上才起层。",
    "面团偏软一点，擀的时候才不回缩。",
    "烤箱要提前预热到 200℃，饼才鼓得起来。"
  ],
  "common_mistakes": [
    "面团太硬，擀的时候边缘开裂不成形。",
    "油酥抹太少，烤完是死面饼没有层次。",
    "烤箱温度不够，饼身塌陷烤不酥。"
  ],
  "substitutions": [
    {
      "original": "植物油",
      "substitute": "猪油",
      "ratio": "60ml 对 60g",
      "note": "传统做法更酥，冷却后偏硬。"
    },
    {
      "original": "白芝麻",
      "substitute": "黑芝麻",
      "ratio": "20g 对 20g",
      "note": "香气更浓。"
    }
  ],
  "variations": [
    "咸香版：油酥里加 5g 花椒粉。",
    "葱油版：油酥换成葱油与面粉搓匀。"
  ],
  "serving_suggestion": "趁热配豆浆或稀粥，也可夹卤肉当早点。",
  "storage": "常温密封可存 3 天，复烤 180℃ 五分钟恢复酥脆。",
