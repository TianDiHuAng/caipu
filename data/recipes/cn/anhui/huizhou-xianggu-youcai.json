  "steps": [
    {
      "n": 1,
      "text": "油菜掰开洗净，根部对半切以便受热均匀。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "根厚叶薄，切开才不会生熟不一。，注意火候。",
      "visual_cue": "菜叶完整，根部剖开，状态稳定"
    },
    {
      "n": 2,
      "text": "香菇去蒂切片，厚度保持五毫米左右。这一步别着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "厚薄一致，炒出来口感才齐。，注意火候。",
      "visual_cue": "菇片匀整，菇盖不碎，状态稳定"
    },
    {
      "n": 3,
      "text": "淀粉加清水调成水淀粉，生抽蚝油白糖调成汁。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先调好，炒的时候才不慌乱。，注意火候。",
      "visual_cue": "粉水均匀，无干粉，状态稳定"
    },
    {
      "n": 4,
      "text": "锅中水烧开，加油和盐，油菜焯三十秒。这一步别着急。",
      "time_min": 5,
      "heat": "大火",
      "tip": "加油焯水，菜叶才翠绿不黄。，注意火候。",
      "visual_cue": "菜叶鲜绿，根部断生，状态稳定"
    },
    {
      "n": 5,
      "text": "捞出立刻过凉水，挤掉多余水分。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过凉水锁色，摆盘才挺。，注意火候。",
      "visual_cue": "菜叶挺括，颜色油亮，状态稳定"
    },
    {
      "n": 6,
      "text": "炒锅倒植物油，下蒜片小火煸香。这一步别着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜片微黄就下菇，别炒焦。，注意火候。",
      "visual_cue": "蒜片金黄，香气散出，状态稳定"
    },
    {
      "n": 7,
      "text": "倒香菇片大火炒到变软出水。这一步别着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "香菇炒透，鲜味才出来。，注意火候。",
      "visual_cue": "菇片软塌，汁水渗出，状态稳定"
    },
    {
      "n": 8,
      "text": "倒入调味汁烧开，用水淀粉勾薄芡。这一步别着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芡要薄，裹住菇片就够。，注意火候。",
      "visual_cue": "汤汁微稠，能挂勺，状态稳定"
    },
    {
      "n": 9,
      "text": "油菜围边摆盘，香菇连汁浇在中间。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热浇，菜叶才吸味。，注意火候。",
      "visual_cue": "造型整齐，芡汁透亮，状态稳定"
    }
  ],
  "tips": [
    "焯油菜时加油和盐，颜色才翠绿。，值得留意。",
    "香菇要炒到出水，鲜味才足。，值得留意。",
    "芡薄一点，挂汁不透亮就不好看。，值得留意。"
  ],
  "common_mistakes": [
    "油菜焯久，叶子发黄发软。，值得留意。",
    "香菇没炒透，还有生菇味。，值得留意。",
    "芡太厚，整盘糊成一团。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "油菜",
      "substitute": "小白菜",
      "ratio": "400 克:400 克",
      "note": "更嫩，焯水时间缩短十秒。"
    },
    {
      "original": "香菇",
      "substitute": "口蘑",
      "ratio": "180 克:180 克",
      "note": "味淡些，蚝油可略加。"
    }
  ],
  "variations": [
    "加一把肉片同炒，荤素搭配更香。，值得留意。",
    "用高汤代替清水，鲜味更浓。，值得留意。"
  ],
  "serving_suggestion": "家常配饭，摆盘上桌也体面。，效果更稳定。",
  "storage": "冷藏一天，复热下锅快炒一分钟。，效果更稳定。",
