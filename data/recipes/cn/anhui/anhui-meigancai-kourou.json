  "steps": [
    {
      "n": 1,
      "text": "梅干菜用温水泡三十分钟，反复洗掉泥沙。这一步不要着急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "根部泥沙多，洗到水清才停。，注意火候。",
      "visual_cue": "菜叶舒展，水色转清，状态稳定"
    },
    {
      "n": 2,
      "text": "五花肉整块冷水下锅，加姜片和料酒煮十五分钟。",
      "time_min": 18,
      "heat": "中火",
      "tip": "煮到筷子能戳进皮，切的时候才不散。",
      "visual_cue": "表皮发白，肉块定型，状态稳定"
    },
    {
      "n": 3,
      "text": "捞出趁热在皮上抹老抽，晾到表面干爽。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮要抹匀，炸出来颜色才红亮。，注意火候。",
      "visual_cue": "皮面深红，微干，状态稳定"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，皮朝下小火煎到起泡上色。这一步不要着急。",
      "time_min": 7,
      "heat": "小火",
      "tip": "盖个锅盖防溅油，煎到皮起小泡。，注意火候。",
      "visual_cue": "表皮起泡，颜色枣红，状态稳定"
    },
    {
      "n": 5,
      "text": "肉块切成半厘米厚的大片，皮朝下码进大碗。这一步不要着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "厚薄一致，蒸完才齐整。，注意火候。",
      "visual_cue": "肉片匀整，皮朝下，状态稳定"
    },
    {
      "n": 6,
      "text": "梅干菜挤干水分，切碎后用底油炒香蒜末。这一步不要着急。",
      "time_min": 8,
      "heat": "中火",
      "tip": "挤干再炒，香味才浓。，注意火候。",
      "visual_cue": "菜末干爽，香气扑鼻，状态稳定"
    },
    {
      "n": 7,
      "text": "梅干菜加生抽、白糖和盐拌匀，铺在肉片上压紧。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压紧一点，蒸完倒扣才不塌。，注意火候。",
      "visual_cue": "菜层平整，酱油渗下，状态稳定"
    },
    {
      "n": 8,
      "text": "放八角，上锅大火烧开转中小火蒸八十分钟。这一步不要着急。",
      "time_min": 82,
      "heat": "中火",
      "tip": "时间不够肉不烂，宁可多蒸十分钟。，注意火候。",
      "visual_cue": "肉片软塌，油渗进菜里"
    },
    {
      "n": 9,
      "text": "取出倒扣到盘里，把碗底的汤汁浇回去。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "倒扣动作要快，别撒了汤汁。，注意火候。",
      "visual_cue": "扣肉成形，汁液浓亮，状态稳定"
    }
  ],
  "tips": [
    "梅干菜多洗几遍，泥沙才干净。，值得留意。",
    "肉皮煎过再蒸，口感才软糯起皱。，值得留意。",
    "蒸足八十分钟，肉才入口即化。，值得留意。"
  ],
  "common_mistakes": [
    "梅干菜没挤干，蒸完一汪水。，值得留意。",
    "肉皮没煎，扣肉颜色发白发灰。，值得留意。",
    "蒸的时间短，肉片嚼不动。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "600 克:600 克",
      "note": "更瘦，蒸的时间加十五分钟。"
    },
    {
      "original": "梅干菜",
      "substitute": "雪里蕻腌菜",
      "ratio": "120 克:150 克",
      "note": "咸味更重，盐要减半。"
    }
  ],
  "variations": [
    "加几片冬笋同蒸，清甜解腻。，值得留意。",
    "用砂锅小火煨一小时，香气更沉。，值得留意。"
  ],
  "serving_suggestion": "上桌倒扣，配一碗白米饭，把汤汁浇在饭上最香。",
  "storage": "冷藏三天，冷冻两周；复热上锅蒸二十分钟。",
