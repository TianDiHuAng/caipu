  "equipment": [
    "炒锅",
    "锅铲",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "山笋去壳切滚刀块，冷水下锅焯 5 分钟去掉涩味，捞出沥干。",
      "time_min": 8,
      "heat": "中火",
      "tip": "笋必须焯水，否则发涩麻口。",
      "visual_cue": "笋块颜色转浅、涩味散去"
    },
    {
      "n": 2,
      "text": "香菇去蒂切成厚片，姜切片，小葱切成长段放在案板上备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香菇蒂别丢，可以留着煮高汤。",
      "visual_cue": "香菇片厚薄一致、边缘完整"
    },
    {
      "n": 3,
      "text": "炒锅下 30ml 植物油，中火煸香姜片与葱段，倒入笋块翻炒 3 分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "笋块先煸一下，表面收紧更入味。",
      "visual_cue": "笋块边缘微黄、香气出来"
    },
    {
      "n": 4,
      "text": "加入香菇片同炒 2 分钟至香菇变软出水。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菇炒软才会释放鲜味。",
      "visual_cue": "香菇片塌软、锅底见少量汁水"
    },
    {
      "n": 5,
      "text": "淋 20ml 生抽与 6g 白糖翻匀上色，加 200ml 清水大火烧开转小火焖 12 分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "小火焖，笋才吸得进味道。",
      "visual_cue": "汤汁转深褐、笋块上色均匀"
    },
    {
      "n": 6,
      "text": "加 4g 盐调味，转大火收汁至浓稠挂匀，出锅装盘。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁时勤翻，避免锅底焦糊。",
      "visual_cue": "汤汁浓稠裹住笋块、锅底见油"
    }
  ],
  "tips": [
    "山笋焯水这一步不能省，涩味全靠它去掉。",
    "香菇先炒软再加水，鲜味才出得来。",
    "收汁到汤汁挂勺就停，收太干会发咸。"
  ],
  "common_mistakes": [
    "山笋不焯水直接烧，吃着涩口发麻。",
    "香菇和笋一起下锅，香菇出水笋不入味。",
    "大火从头焖到尾，笋块外面老里面硬。"
  ],
  "substitutions": [
    {
      "original": "山笋",
      "substitute": "茭白",
      "ratio": "400g 对 400g",
      "note": "不用焯水，焖制时间减 3 分钟。"
    },
    {
      "original": "香菇",
      "substitute": "口蘑",
      "ratio": "120g 对 150g",
      "note": "鲜味略淡，可加 5ml 生抽。"
    }
  ],
  "variations": [
    "油焖版：加 10ml 老抽与 10g 冰糖，做成浓油赤酱的油焖笋。",
    "腊味版：加 60g 咸肉片同烧，鲜味更足。"
  ],
  "serving_suggestion": "配白米饭上桌，汤汁拌饭尤其香。",
  "storage": "冷藏 2 天，复热时加 30ml 清水小火回烧。",
