          "name_en": "cooking wine",
          "amount": 15,
          "unit": "ml",
          "note": "去腌味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 3,
          "unit": "g",
          "note": "提鲜和味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "咸肉自带咸味，只需极少",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
          "note": "出锅前撒",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 900,
          "unit": "ml",
          "note": "蒸锅与浸泡用水",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "菜刀",
    "深盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "咸肉用温水反复刷洗表面盐霜，再放入清水浸泡四十分钟。",
      "time_min": 40,
      "heat": "无火",
      "tip": "浸泡能去掉多余盐分，肉质也会回软。",
      "visual_cue": "咸肉表面发白、水色微浑"
    },
    {
      "n": 2,
      "text": "泡好的咸肉捞出擦干，切成半厘米厚的薄片，肥瘦分开摆放。",
      "time_min": 5,
      "heat": "无火",
      "tip": "逆着纹理下刀，切面更整齐不散。",
      "visual_cue": "肉片厚薄一致、肥瘦分明"
    },
    {
      "n": 3,
      "text": "冬笋剥壳削去老根，切成滚刀块后放入沸水焯五分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯水能去掉笋的涩味与草酸。",
      "visual_cue": "笋块颜色转浅、闻不到生涩气"
    },
    {
      "n": 4,
      "text": "深盘底部铺冬笋块，上面依次码放咸肉片，放上生姜片与葱结。",
      "time_min": 5,
      "heat": "无火",
      "tip": "肉片斜叠摆放，蒸汽才能穿透。",
      "visual_cue": "肉片呈鱼鳞状铺满盘面"
    },
    {
      "n": 5,
      "text": "淋入料酒，蒸锅水开后放盘，盖严锅盖大火蒸三十五分钟。",
      "time_min": 35,
      "heat": "大火",
      "tip": "全程大火，蒸出的汤汁才清亮。",
      "visual_cue": "盘底积起浅琥珀色汤汁"
    },
    {
      "n": 6,
      "text": "取出拣去葱姜，撒上白糖、盐与白胡椒，趁热连盘上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "咸肉本身够咸，盐只需点到为止。",
      "visual_cue": "肉片油亮透光、笋块吸饱肉汁"
    }
  ],
  "tips": [
    "咸肉选徽州火腿或刀板香原块，肥膘透亮的最好。",
    "冬笋垫底能吸走油脂，蒸好后比肉还受欢迎。",
    "咸肉浸泡时间按咸度调整，太咸可延长到一小时。"
  ],
  "common_mistakes": [
    "咸肉不泡直接蒸，成品咸得发苦还带腌味。",
    "笋块不焯水就上锅，吃起来涩口发麻。",
    "蒸制中途反复开盖，蒸汽跑掉肉质变柴。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "金华火腿",
      "ratio": "350g 对 250g",
      "note": "火腿更咸，泡水时间延长至一小时。"
    },
    {
      "original": "冬笋",
      "substitute": "春笋",
      "ratio": "250g 对 250g",
      "note": "春笋更嫩，焯水时间缩短为三分钟。"
    }
  ],
  "variations": [
    "盘底改铺百叶结，吸汁后豆香混着肉香。",
    "蒸好后撒一把葱花，再淋一勺热油激香。"
  ],
  "serving_suggestion": "整盘端上桌，肉片夹笋块一起吃，配米饭最香。",
  "storage": "冷藏可存三天，复蒸八分钟即可恢复软糯。",
