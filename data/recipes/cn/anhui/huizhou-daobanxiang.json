          "name_en": "ginger",
          "amount": 10,
          "unit": "g",
          "note": "切成薄片",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "挽成葱结",
