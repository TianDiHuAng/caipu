          "name_en": "salt-cured pork belly",
          "amount": 350,
          "unit": "g",
          "note": "选肥瘦相间的五花咸肉",
          "optional": false
        },
        {
          "name": "竹笋",
          "name_en": "bamboo shoot",
          "amount": 250,
          "unit": "g",
          "note": "取中段嫩尖",
          "optional": false
        }
      ]
    },
    {
