  "steps": [
    {
      "n": 1,
      "text": "冬笋剥壳去老根，切成薄片。这一步不要着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "根部老，切掉一截口感才嫩。，注意火候。",
      "visual_cue": "笋片匀薄，颜色玉白，状态稳定"
    },
    {
      "n": 2,
      "text": "笋片入开水焯三分钟，捞出沥干。这一步不要着急。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯水去涩，炒出来才清甜。，注意火候。",
      "visual_cue": "笋片透亮，涩味散出，状态稳定"
    },
    {
      "n": 3,
      "text": "香菇去蒂切片，厚的对半再切。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "厚薄一致，受热才均匀。，注意火候。",
      "visual_cue": "菇片匀整，菇盖完整，状态稳定"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，五花肉丝小火煸出油。这一步不要着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "煸出油，笋片才不寡淡。，注意火候。",
      "visual_cue": "肉丝微黄，油光泛出，状态稳定"
    },
    {
      "n": 5,
      "text": "下蒜片炒香，倒笋片大火翻炒三分钟。这一步不要着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火快炒，笋片才脆。，注意火候。",
      "visual_cue": "笋片干爽，边缘微卷，状态稳定"
    },
    {
      "n": 6,
      "text": "放香菇片炒到变软出汁，菇片软塌、锅里多出一点汤水，香气散出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香菇炒软才出鲜味。，注意火候。",
      "visual_cue": "菇片软塌，汁水渗出，状态稳定"
    },
    {
      "n": 7,
      "text": "加生抽、蚝油、白糖和盐炒匀。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蚝油提鲜，别放太多。，注意火候。",
      "visual_cue": "酱色均匀，香气浓，状态稳定"
    },
    {
      "n": 8,
      "text": "撒下小葱段翻两下就出锅装盘，趁热吃质地最好，凉了笋片会回软。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱段最后放，颜色才绿。，注意火候。",
      "visual_cue": "葱绿点缀，菜色油亮，状态稳定"
    }
  ],
  "tips": [
    "冬笋一定焯水，涩味才去得掉。，值得留意。",
    "五花肉先煸出油，素菜才香。，值得留意。",
    "大火快炒，笋片才保脆。，值得留意。"
  ],
  "common_mistakes": [
    "笋片没焯，吃着发涩。，值得留意。",
    "炒得过久，笋片变软失去脆感。，值得留意。",
    "香菇没炒透，还有生菇味。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "冬笋",
      "substitute": "春笋",
      "ratio": "350 克:350 克",
      "note": "焯水时间加到五分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "火腿片",
      "ratio": "60 克:50 克",
      "note": "鲜味更足，盐要减。"
    }
  ],
  "variations": [
    "加一把青蒜苗，香气更冲。，值得留意。",
    "改素炒，用香菇水代替蚝油提鲜。，值得留意。"
  ],
  "serving_suggestion": "配白米饭，清爽又下饭。，效果更稳定。",
  "storage": "冷藏两天，复热下锅快炒一分钟。，效果更稳定。",
