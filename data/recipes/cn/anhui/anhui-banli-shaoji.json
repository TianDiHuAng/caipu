  "equipment": [
    "炒锅",
    "砂锅",
    "锅铲",
    "削皮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成三厘米见方的块，冲净血水后沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鸡块切得均匀，焖的时候熟度才会一致。",
      "visual_cue": "鸡块大小一致，表面无血丝"
    },
    {
      "n": 2,
      "text": "鸡块加料酒与姜片抓匀，腌十分钟充分去掉腥味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌过的鸡块腥味轻，煎的时候也更容易上色。",
      "visual_cue": "鸡块略收紧，盆底有淡色汁水"
    },
    {
      "n": 3,
      "text": "栗子用刀划一道口，下开水煮五分钟再剥壳去膜。",
      "time_min": 8,
      "heat": "大火",
      "tip": "煮过再剥，壳和内膜一起掉，省事又完整。",
      "visual_cue": "栗子整颗脱壳，表面呈金黄色"
    },
    {
      "n": 4,
      "text": "炒锅放花生油烧热，把鸡块皮朝下用中火煎到金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先把鸡皮煎出油来，鸡肉才香而且不腻。",
      "visual_cue": "鸡皮金黄微焦，锅底有鸡油"
    },
    {
      "n": 5,
      "text": "下姜片与干辣椒炒香，加冰糖炒到融化起小泡。",
      "time_min": 3,
      "heat": "中火",
      "tip": "冰糖化开就够了，炒到深褐色整锅都会发苦。",
      "visual_cue": "糖液起细密小泡，颜色浅琥珀"
    },
    {
      "n": 6,
      "text": "淋生抽与老抽翻匀上色，倒入热水没过鸡块一半。",
      "time_min": 3,
      "heat": "大火",
      "tip": "加热水，冷水会让鸡肉突然收紧发柴。",
      "visual_cue": "鸡块呈红亮酱色，汤汁微滚"
    },
    {
      "n": 7,
      "text": "放葱结与栗子，再次烧开后转小火焖二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "栗子要后放，跟着一起久炖会散成泥糊。",
      "visual_cue": "栗子饱满，汤汁收到一半"
    },
    {
      "n": 8,
      "text": "开盖转大火收汁，边收边翻动，让酱汁均匀裹住鸡块。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁的时候轻一点翻，栗子容易碎不要用力压。",
      "visual_cue": "汤汁浓稠挂勺，鸡块油亮"
    },
    {
      "n": 9,
      "text": "尝一下咸淡再决定要不要加盐，撒上葱花起锅装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生抽本身就有咸味，盐一定要尝过之后再放。",
      "visual_cue": "盘中酱汁聚拢，葱花翠绿"
    }
  ],
  "tips": [
    "栗子买现成去壳的省事，冷冻的也可直接用。",
    "鸡腿肉比整鸡好操作，肉嫩不易柴。",
    "炒糖色火要小，宁可浅一点也别炒苦。",
    "加几片香菇一起焖，鲜味会更厚一层。"
  ],
  "common_mistakes": [
    "栗子一起下锅久焖，最后化在汤里成糊。",
    "糖色炒过了头，整锅都带一股焦苦味。",
    "中途加冷水进去，鸡肉会紧得咬都咬不动。"
  ],
  "substitutions": [
    {
      "original": "栗子",
      "substitute": "土豆",
      "ratio": "250克:300克",
      "note": "口感更粉，焖的时间减五分钟。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "五花肉",
      "ratio": "500克:500克",
      "note": "油脂更多，焖的时间加十分钟。"
    }
  ],
  "variations": [
    "加一把笋块一起烧，皖南风味更足一些。",
    "改用砂锅小火慢煨，收汁后更入味也更香。"
  ],
  "serving_suggestion": "连汁装盘，栗子粉糯、鸡肉入味，配一碗白饭把酱汁浇上去。",
  "storage": "冷藏两天，复热加少量水小火焖五分钟，栗子易碎要轻推。",
