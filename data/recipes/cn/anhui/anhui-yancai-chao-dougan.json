  "steps": [
    {
      "n": 1,
      "text": "腌雪里蕻用清水反复冲洗几遍，挤干水分后切成半厘米的小段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腌菜咸度很高，多洗两遍并尝一下。",
      "visual_cue": "菜梗切得细碎，手握不出水"
    },
    {
      "n": 2,
      "text": "香干切成筷子粗的细条，猪里脊逆纹切丝备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "香干条别切太细，炒久了容易断，筷子粗正好。",
      "visual_cue": "香干条长短一致，肉丝分明"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下肉丝中火滑炒到变色散开，盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "肉丝下锅先别翻，等定型再拨散。",
      "visual_cue": "肉丝由红转白，根根分离"
    },
    {
      "n": 4,
      "text": "锅内留底油下姜末、蒜片和干辣椒段，小火炒出香味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "干辣椒容易糊，小火炸到颜色变深就够。",
      "visual_cue": "油面泛红，闻到蒜香和辣香"
    },
    {
      "n": 5,
      "text": "倒入雪菜碎中火煸炒，把腌菜的水汽炒干、香气炒出来。",
      "time_min": 4,
      "heat": "中火",
      "tip": "雪菜一定要炒干水汽，不然带一股生涩味。",
      "visual_cue": "雪菜颜色转深，锅底无积水"
    },
    {
      "n": 6,
      "text": "下香干条和肉丝翻炒，加生抽和白糖，淋清水翻匀略煸。",
      "time_min": 3,
      "heat": "中火",
      "tip": "白糖只为中和咸酸，一点点就够。",
      "visual_cue": "香干条裹上酱色，汤汁被吸干"
    }
  ],
  "tips": [
    "雪菜先冲洗再挤干，咸度可控不齁人。",
    "香干条切粗一点，炒完才有嚼劲。",
    "最后放少许白糖，能中和腌菜的酸咸。"
  ],
  "common_mistakes": [
    "雪菜不洗直接下锅，整盘咸得下不了口。",
    "火太小吃不住水汽，成品湿塌塌的。",
    "香干炒太久，条状断成碎渣，没有嚼劲。"
  ],
  "substitutions": [
    {
      "original": "雪菜",
      "substitute": "梅干菜",
      "ratio": "250 克:150 克",
      "note": "需提前泡软切碎，咸味更重，糖可略增。"
    },
    {
      "original": "香干",
      "substitute": "豆干",
      "ratio": "200 克:200 克",
      "note": "质地更硬，煸炒时间延长一分钟。"
    }
  ],
  "variations": [
    "加一把毛豆同炒，口感更丰富也更清甜。",
    "换成腊肉丝代替里脊，徽州风味更足。"
  ],
  "serving_suggestion": "热食配白粥或干饭都合适，作下饭小菜也很扎口。",
  "storage": "冷藏两天，复热时加少许清水小火翻炒回软。",
