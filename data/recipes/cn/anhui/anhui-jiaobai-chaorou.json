  "steps": [
    {
      "n": 1,
      "text": "茭白剥去外层老壳削掉根部老皮，切成火柴棍粗细的丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "外皮一定要削净，留着炒出来发韧。",
      "visual_cue": "茭白丝白净匀称，断面水润"
    },
    {
      "n": 2,
      "text": "猪里脊逆着纹理切细丝，加生抽和黄酒抓匀腌上十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纹切口感才嫩，顺纹切嚼不动。",
      "visual_cue": "肉丝松散挂汁，碗底无血水"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，下肉丝大火滑散，变色后盛出备用。",
      "time_min": 2,
      "heat": "大火",
      "tip": "肉丝下锅别急着翻，定住后再炒才不粘。",
      "visual_cue": "肉丝根根分开，色转浅白"
    },
    {
      "n": 4,
      "text": "原锅下蒜片爆香，倒入茭白丝大火翻炒到边缘变透明。",
      "time_min": 3,
      "heat": "大火",
      "tip": "茭白含水多，大火快炒才脆不塌。",
      "visual_cue": "茭白丝透亮，锅里有清甜气"
    },
    {
      "n": 5,
      "text": "沿锅边淋少许清水略焖，加盐和白糖翻匀提味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "少量水焖一下，茭白才不会外软内生。",
      "visual_cue": "水汽收干，丝身油亮"
    },
    {
      "n": 6,
      "text": "倒回肉丝炒匀，撒葱段翻两下立刻出锅装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "肉丝回锅只炒三十秒，久了发柴。",
      "visual_cue": "肉丝与茭白分明，葱段翠绿"
    }
  ],
  "tips": [
    "茭白外层老壳要削净，否则口感发韧。",
    "肉丝逆纹切、大火滑炒，嫩度差很多。",
    "茭白含水多，全程大火不盖盖才脆。"
  ],
  "common_mistakes": [
    "茭白不削皮直接切丝，成品嚼着像草。",
    "肉丝小火慢炒，出水后变得又老又硬。",
    "炒茭白时盖盖焖久，丝全软塌发黄。"
  ],
  "substitutions": [
    {
      "original": "茭白",
      "substitute": "冬笋",
      "ratio": "350 克:350 克",
      "note": "口感更脆，需先焯水去涩再炒。"
    },
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "150 克:150 克",
      "note": "脂肪更少，腌时加少许油防干柴。"
    }
  ],
  "variations": [
    "加几只虾仁同炒，鲜味更足也更清爽。",
    "放一点红椒丝配色，卖相更清爽。"
  ],
  "serving_suggestion": "热吃最鲜，配米饭或稀粥都清爽下饭。",
  "storage": "冷藏一天，复热用炒锅大火快翻，别加水久煮。",
