  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成两厘米厚的方块，用厨房纸吸干水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "吸水后煎才不溅油。，注意火候。",
      "visual_cue": "表面干爽，块形整齐，状态稳定"
    },
    {
      "n": 2,
      "text": "平底锅倒植物油烧热，豆腐块下锅小火煎。这一步不要着急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "别急着翻，定型了再动。，注意火候。",
      "visual_cue": "底面金黄，边缘定型，状态稳定"
    },
    {
      "n": 3,
      "text": "翻面煎到两面金黄，盛出控油。这一步不要着急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "两面焦皮，烧的时候才不散。，注意火候。",
      "visual_cue": "两面金黄，外壳微硬，状态稳定"
    },
    {
      "n": 4,
      "text": "锅里留底油，下蒜片和干辣椒段炒香。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒别炒黑，会发苦。，注意火候。",
      "visual_cue": "蒜片微黄，辣香散出，状态稳定"
    },
    {
      "n": 5,
      "text": "倒雪里蕻碎中火炒两分钟，炒出酸香。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "腌菜先炒，味道才浓。，注意火候。",
      "visual_cue": "菜末油亮，酸香明显，状态稳定"
    },
    {
      "n": 6,
      "text": "加生抽和白糖，倒清水烧开。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汤汁先调好味，豆腐才好吸。，注意火候。",
      "visual_cue": "汤色酱红，微微沸腾，状态稳定"
    },
    {
      "n": 7,
      "text": "放回豆腐块，小火焖八分钟入味。这一步不要着急。",
      "time_min": 9,
      "heat": "小火",
      "tip": "别翻动太勤，豆腐才不碎。，注意火候。",
      "visual_cue": "豆腐鼓起，汤汁减少，状态稳定"
    },
    {
      "n": 8,
      "text": "大火收汁，撒小葱末出锅。这一步不要着急。",
      "time_min": 3,
      "heat": "大火",
      "tip": "留一点汤汁拌饭最好。，注意火候。",
      "visual_cue": "汤汁浓亮，豆腐油润，状态稳定"
    }
  ],
  "tips": [
    "豆腐先吸干水，煎的时候不溅油。，值得留意。",
    "腌菜先炒香，烧出来才有底味。，值得留意。",
    "焖的时候少翻动，豆腐才完整。，值得留意。"
  ],
  "common_mistakes": [
    "豆腐带水下锅，油溅得厉害。，值得留意。",
    "翻动太勤，豆腐全碎。，值得留意。",
    "腌菜放太多，咸到发苦。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "老豆腐",
      "substitute": "豆腐干",
      "ratio": "500 克:300 克",
      "note": "口感更韧，焖的时间缩短三分钟。"
    },
    {
      "original": "雪里蕻",
      "substitute": "酸菜",
      "ratio": "100 克:100 克",
      "note": "酸味更冲，糖加一点。"
    }
  ],
  "variations": [
    "加一把毛豆同烧，口感更丰富。，值得留意。",
    "放几片五花肉，油脂更香。，值得留意。"
  ],
  "serving_suggestion": "配米饭，汤汁浇饭特别下饭。，效果更稳定。",
  "storage": "冷藏两天，复热下锅加少量水焖三分钟。，效果更稳定。",
