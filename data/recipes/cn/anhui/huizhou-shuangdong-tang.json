  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "竹笋",
          "name_en": "bamboo shoot",
          "amount": 300,
          "unit": "g",
          "note": "剥壳后切滚刀块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "香菇",
          "name_en": "shiitake mushroom",
          "amount": 100,
          "unit": "g",
          "note": "干香菇提前泡开",
          "optional": false
        },
        {
          "name": "火腿",
          "name_en": "ham",
          "amount": 50,
          "unit": "g",
          "note": "切薄片",
          "optional": false
        },
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 900,
          "unit": "ml",
          "note": "炖汤用",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 20,
          "unit": "ml",
          "note": "煸香用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "起锅前调",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 10,
          "unit": "ml",
          "note": "去腥",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "砧板",
    "炒锅",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干香菇放进温水里泡三十分钟，泡到整朵变软，捞出挤干水分。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡香菇的水静置后取上层，比清水更鲜。",
      "visual_cue": "香菇用手一捏就软，菌褶完全展开"
    },
    {
      "n": 2,
      "text": "竹笋剥去外层的硬壳削掉老根，切成大小均匀的滚刀块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "笋根纤维粗，切得比笋尖小一些才好熟。",
      "visual_cue": "块形差不多大，切面白净无发黑的点"
    },
    {
      "n": 3,
      "text": "水烧开后放竹笋块煮三分钟，捞出用清水冲洗掉涩味。",
      "time_min": 4,
      "heat": "大火",
      "tip": "竹笋不焯水会带涩口，这一步千万别图省事跳过。",
      "visual_cue": "笋块颜色由白转浅黄，闻不到生笋的涩气"
    },
    {
      "n": 4,
      "text": "炒锅下花生油，把火腿片小火煸到边缘微卷、油色泛红。",
      "time_min": 3,
      "heat": "小火",
      "tip": "火腿煸出油再炖，整锅汤的底味才厚。",
      "visual_cue": "火腿边缘卷起，锅里油色变浅红"
    },
    {
      "n": 5,
      "text": "倒进香菇和竹笋块一起翻炒两分钟，沿锅边淋入料酒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "材料先煸过再下水，汤才够香而且不会发浑。",
      "visual_cue": "香菇吸油发亮，料酒一淋散出香气"
    },
    {
      "n": 6,
      "text": "倒入高汤大火烧开，撇掉表面的浮沫后转小火炖四十分钟。",
      "time_min": 40,
      "heat": "小火",
      "tip": "火力小到汤面只轻轻冒泡，汤色才清。",
      "visual_cue": "汤面小泡连绵，颜色呈清亮的浅琥珀"
    },
    {
      "n": 7,
      "text": "起锅前加盐调味，尝一口咸淡再决定是否补一点。",
      "time_min": 2,
      "heat": "无火",
      "tip": "火腿本身带咸味，盐一定要最后加，免得整锅汤发死。",
      "visual_cue": "汤味鲜中带回甘，咸度刚好不压味"
    }
  ],
  "tips": [
    "用砂锅炖比铁锅更聚香，也更适合这种清汤。",
    "笋块换成春笋口感更嫩，炖的时间可以减十分钟。",
    "加几片薄火腿骨一起炖，汤色会更漂亮。",
    "最后撒一小把葱花，香气立刻活起来。"
  ],
  "common_mistakes": [
    "竹笋没有焯水直接下锅，整锅汤都带涩味。",
    "高汤烧开后一直用大火煮，汤色浑成乳白。",
    "盐放早了，炖久了笋块发硬不够松软。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "50克:55克",
      "note": "咸味更重，盐要减半。"
    },
    {
      "original": "高汤",
      "substitute": "清水加香菇泡汁",
      "ratio": "900毫升:900毫升",
      "note": "鲜味稍弱，适合素食。"
    }
  ],
  "variations": [
    "汤里加几块豆腐结，吸饱汤汁很下饭。",
    "用老母鸡汤打底，汤体更厚实，适合天冷的时候喝。"
  ],
  "serving_suggestion": "盛在浅碗里先喝汤再吃料，配一碗白米饭刚好。",
  "storage": "冷藏两天，复热时补少量高汤，避免越煮越咸。",
