    "炒锅",
    "锅铲",
    "饭勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后加清水浸泡三十分钟，捞出沥干。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡过的米吸水均匀，焖出来粒粒分明不夹生。",
      "visual_cue": "米粒发白饱满，一捏就断"
    },
    {
      "n": 2,
      "text": "竹笋剥壳后切成小丁，下开水锅焯三分钟去掉涩味。",
      "time_min": 8,
      "heat": "大火",
      "tip": "笋丁焯过水才不涩口，焖饭也不发苦。",
      "visual_cue": "笋丁由白转半透明，浮沫撇净"
    },
    {
      "n": 3,
      "text": "咸肉切小丁，香菇泡发后挤干水分切成同样大小。",
      "time_min": 6,
      "heat": "无火",
      "tip": "三样丁大小接近，吃起来口感才协调。",
      "visual_cue": "三种丁均匀，香菇水留用"
    },
    {
      "n": 4,
      "text": "炒锅放花生油，下咸肉丁用小火慢慢煸出油和香气。",
      "time_min": 4,
      "heat": "小火",
      "tip": "咸肉煸到微焦，油香才出来，饭才不寡淡。",
      "visual_cue": "肉丁边缘微焦，锅里油变多"
    },
    {
      "n": 5,
      "text": "下笋丁与香菇丁翻炒两分钟，加生抽与盐调味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "配料先炒香再焖，饭的味道才有层次。",
      "visual_cue": "丁料裹上浅酱色，香气浓"
    },
    {
      "n": 6,
      "text": "倒入沥干的大米翻炒一分钟，让每粒米都裹上一层油。",
      "time_min": 1,
      "heat": "中火",
      "tip": "米粒裹油焖出来更松散，也不易粘锅底。",
      "visual_cue": "米粒油亮，颗颗分开不粘连"
    },
    {
      "n": 7,
      "text": "把炒好的料转入砂锅，加清水，水面高出米面一指。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水量比平时焖饭略少，配料本身带水。",
      "visual_cue": "水面刚没过米面一指节"
    },
    {
      "n": 8,
      "text": "大火烧开后转小火焖十八分钟，中途不要开盖。",
      "time_min": 20,
      "heat": "小火",
      "tip": "中途一开盖热气就跑了，饭很容易夹生。",
      "visual_cue": "锅边冒白气，听见轻微滋滋声"
    },
    {
      "n": 9,
      "text": "关火撒白胡椒粉与葱花，盖盖焖五分钟再拌匀盛出。",
      "time_min": 5,
      "heat": "无火",
      "tip": "焖五分钟让水汽回匀，米饭才不粘勺。",
      "visual_cue": "米粒油亮松散，配料分布均匀"
    }
  ],
  "tips": [
    "用砂锅焖饭锅气足，电饭锅也能做但香味淡。",
    "咸肉本身有咸味，盐要少量多次尝着加。",
    "想更香可以把米换成糯米加泰国香米混合。",
    "锅底结出的那层锅巴拌开吃最香。"
  ],
  "common_mistakes": [
    "米没泡直接焖，外面糊了里面还是硬芯。",
    "水加得太多，焖出来就是一锅稠糊的粥。",
    "中途频繁开盖查看，热气跑光饭就夹生了。"
  ],
  "substitutions": [
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "200克:200克",
      "note": "更嫩，可省去焯水。"
    },
    {
      "original": "咸肉",
      "substitute": "腊肠",
      "ratio": "80克:80克",
      "note": "甜咸风味，盐要减半。"
    }
  ],
  "variations": [
    "加一把豌豆一起焖，颜色和口感都更好看。",
    "用泡香菇的水代替清水焖饭，鲜味更浓。"
  ],
  "serving_suggestion": "盛出后配一碗清汤，锅巴部分铲起来单独吃最香。",
  "storage": "冷藏两天，复热加一勺水用蒸锅蒸十分钟恢复松软。",
