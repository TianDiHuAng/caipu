  "steps": [
    {
      "n": 1,
      "text": "雪里蕻洗净晾到叶面干爽，切碎。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "晾干水分，腌的时候才不烂。，注意火候。",
      "visual_cue": "菜叶干爽，切口整齐，状态稳定"
    },
    {
      "n": 2,
      "text": "菜碎加盐揉五分钟，装进干净坛子压紧。这一步不要着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "盐按菜重的百分之三放，压紧排气。，注意火候。",
      "visual_cue": "菜体出水，坛内压实，状态稳定"
    },
    {
      "n": 3,
      "text": "常温腌五天，闻到酸香即可取出。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "坛口盖好，别沾生水。，注意火候。",
      "visual_cue": "酸香明显，菜色转黄，状态稳定"
    },
    {
      "n": 4,
      "text": "腌菜挤干水分，五花肉切薄片。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "挤干再炒，锅里才不出水。，注意火候。",
      "visual_cue": "菜末干爽，肉片匀薄，状态稳定"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油，肉片小火煸到卷边出油。这一步不要着急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "煸到卷边，油脂才香。，注意火候。",
      "visual_cue": "肉片卷起，边缘焦黄，状态稳定"
    },
    {
      "n": 6,
      "text": "下蒜片和干辣椒段炒出香味。这一步不要着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "辣椒炒香别炒黑。，注意火候。",
      "visual_cue": "蒜香辣香混出，状态稳定"
    },
    {
      "n": 7,
      "text": "倒腌菜碎大火翻炒三分钟。这一步不要着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火快炒，酸香才不闷。，注意火候。",
      "visual_cue": "菜末油亮，干爽不粘，状态稳定"
    },
    {
      "n": 8,
      "text": "加生抽、白糖和盐调味，撒小葱段出锅。这一步不要着急。",
      "time_min": 3,
      "heat": "大火",
      "tip": "糖能压酸，尝一口再补盐。，注意火候。",
      "visual_cue": "酱色均匀，葱绿点缀，状态稳定"
    }
  ],
  "tips": [
    "腌菜晾干再腌，坛里才不烂。，值得留意。",
    "盐按菜重百分之三，多了发苦。，值得留意。",
    "腌菜挤干再炒，锅气才足。，值得留意。"
  ],
  "common_mistakes": [
    "坛子沾生水，腌菜发霉。，值得留意。",
    "盐放太多，成品咸得发苦。，值得留意。",
    "腌菜没挤干，炒出来一锅汤。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "200 克:150 克",
      "note": "咸香更浓，盐可省。"
    },
    {
      "original": "雪里蕻",
      "substitute": "芥菜",
      "ratio": "300 克:300 克",
      "note": "腌制时间加到七天，苦味更少。"
    }
  ],
  "variations": [
    "加一勺辣椒酱，酸辣更开胃。，值得留意。",
    "炒好后拌入米粉蒸，做成腌菜扣肉。，值得留意。"
  ],
  "serving_suggestion": "配白粥或米饭，酸香解腻。，效果更稳定。",
  "storage": "腌菜冷藏可存两周，炒好的菜冷藏两天。，效果更稳定。",
