  "steps": [
    {
      "n": 1,
      "text": "干豆腐皮用温水泡二十分钟至完全回软，捞出挤干水分，切成长细丝。",
      "time_min": 22,
      "heat": "无火",
      "tip": "水温不要太高，热水泡的豆腐皮外面烂里面还是硬的。",
      "visual_cue": "豆皮柔软可卷，切丝不断"
    },
    {
      "n": 2,
      "text": "鲜笋剥壳削去老根，切成与豆腐皮同样粗细的细丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丝要切得一样细，炒的时候才同时熟。",
      "visual_cue": "丝条均匀细长，切面乳白"
    },
    {
      "n": 3,
      "text": "汤锅烧开水，笋丝下锅焯三分钟去涩，捞出沥干。",
      "time_min": 5,
      "heat": "大火",
      "tip": "鲜笋不焯水吃起来会发麻涩口，这一步千万不要为了省时间跳过。",
      "visual_cue": "笋丝由白转透，涩味明显减弱"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，下蒜末与香菇丝炒香，倒入笋丝大火翻炒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "香菇要先炒出香味，这样整道菜的底味才够扎实，笋丝也更香。",
      "visual_cue": "香菇丝变软出香，锅底油亮"
    },
    {
      "n": 5,
      "text": "下豆腐皮丝，加生抽、盐与白糖，翻炒两分钟让丝条均匀吸味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "豆腐皮吸味快，调料早点放，最后收干即可。",
      "visual_cue": "丝条油润发亮，锅中无多余汤汁"
    },
    {
      "n": 6,
      "text": "撒上葱段翻匀后立即出锅，装盘时用筷子稍加整理让丝条分明不粘连。",
      "time_min": 2,
      "heat": "大火",
      "tip": "起锅淋香油提香，别在锅里久炒，香气会跑掉。",
      "visual_cue": "丝条分明不粘连，葱段翠绿"
    }
  ],
  "tips": [
    "豆腐皮泡到软而不烂最好，泡过头一炒就断。",
    "加一把火腿丝同炒，鲜味立刻厚一层。",
    "喜欢浓味的可改用蚝油代替生抽，颜色更深。"
  ],
  "common_mistakes": [
    "豆腐皮用开水泡，外层糊了里面还是干硬的。",
    "笋丝不焯直接炒，涩口发麻，整盘都毁了。",
    "全程小火慢炒，豆腐皮出水变黏，丝全粘在一起。"
  ],
  "substitutions": [
    {
      "original": "豆腐皮",
      "substitute": "千张",
      "ratio": "150克:150克",
      "note": "千张更厚，泡的时间延长五分钟。"
    },
    {
      "original": "鲜笋",
      "substitute": "茭白",
      "ratio": "250克:250克",
      "note": "茭白更嫩，焯水时间缩短到一分钟。"
    }
  ],
  "variations": [
    "加青椒丝同炒，颜色清亮，辛香更足。",
    "把笋丝换成笋干丝，须泡发一夜，风味更浓更耐嚼。"
  ],
  "serving_suggestion": "作为家常素菜配米饭，也可冷吃当作下酒小菜。",
  "storage": "冷藏可存两天，复热须大火快炒，久蒸豆腐皮会发黏。",
