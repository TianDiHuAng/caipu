  "equipment": [
    "平底锅",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "毛豆腐用厨房纸轻轻吸干表面水分，切成 4cm 见方的方块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别用力压，白毛压塌就不好煎。",
      "visual_cue": "豆腐块完整、表面干爽"
    },
    {
      "n": 2,
      "text": "平底锅倒 60ml 植物油烧至五成热，摆入毛豆腐中小火慢煎。",
      "time_min": 8,
      "heat": "中火",
      "tip": "一块块摆开，留缝隙才煎得透。",
      "visual_cue": "底面结壳、边缘微黄"
    },
    {
      "n": 3,
      "text": "煎至两面金黄起脆壳，沿锅边淋入生抽让味道渗进去。",
      "time_min": 2,
      "heat": "中火",
      "tip": "沿锅边淋，酱香才被激出来。",
      "visual_cue": "两面金黄、酱色均匀"
    },
    {
      "n": 4,
      "text": "加辣椒酱、蒜末与盐翻匀，撒小葱后立刻出锅装盘。",
      "time_min": 5,
      "heat": "大火",
      "tip": "蒜末最后放，香味才冲。",
      "visual_cue": "酱料裹匀、葱花翠绿"
    }
  ],
  "tips": [
    "毛豆腐表面水分吸干，煎时才不粘锅。",
    "中小火慢煎到两面结壳，外脆里嫩才对味。",
    "辣椒酱按口味增减，蘸着吃也很香。"
  ],
  "common_mistakes": [
    "油温过高下锅，外壳焦了里面还凉。",
    "频繁翻动豆腐块，表面碎成一团。",
    "毛豆腐久放不煎，白毛塌软发酸。"
  ],
  "substitutions": [
    {
      "original": "毛豆腐",
      "substitute": "臭豆腐",
      "ratio": "400g 对 400g",
      "note": "气味更冲，煎制时间略短。"
    },
    {
      "original": "辣椒酱",
      "substitute": "豆瓣酱",
      "ratio": "30g 对 25g",
      "note": "豆瓣酱更咸，盐可省。"
    }
  ],
  "variations": [
    "红烧版：煎好后加 100ml 清水与生抽小火焖 3 分钟。",
    "铁板版：改用铁板煎，边缘更焦香。"
  ],
  "serving_suggestion": "趁热上桌，配一小碟辣椒酱蘸食，外脆内嫩。",
  "storage": "冷藏 3 天，复热用平底锅小火煎 3 分钟恢复脆壳。",
