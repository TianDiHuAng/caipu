  "equipment": [
    "烤箱",
    "擀面杖",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉一百八十克加温水九十毫升和细砂糖，揉成光滑面团醒二十分钟。",
      "time_min": 25,
      "heat": "无火",
      "tip": "面团揉到表面光滑，醒后才擀得开。这一步别省，成品口感差别很明显。",
      "visual_cue": "面团光润，按压回弹，锅里状态一目了然。"
    },
    {
      "n": 2,
      "text": "梅干菜温水泡二十分钟，反复冲洗去掉细沙，挤干后剁成碎末。",
      "time_min": 22,
      "heat": "无火",
      "tip": "多冲两遍去沙，口感才不牙碜。火候和顺序都要留神，别图快。",
      "visual_cue": "菜末松散，无沙粒，颜色和形态变化清楚。"
    },
    {
      "n": 3,
      "text": "五花肉丁小火煸出油，下梅干菜同炒三分钟，加生抽和盐炒匀晾凉。",
      "time_min": 8,
      "heat": "小火",
      "tip": "馅要炒到干香不出水，凉透再包。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "馅料干爽，油光裹面，锅里状态一目了然。"
    },
    {
      "n": 4,
      "text": "剩余面粉加猪油搓成油酥，分成八份，醒好的面团也分成八份包入油酥。",
      "time_min": 12,
      "heat": "无火",
      "tip": "油酥包严不漏，擀时才不起层散开。这一步别省，成品口感差别很明显。",
      "visual_cue": "酥团均匀，收口紧实，颜色和形态变化清楚。"
    },
    {
      "n": 5,
      "text": "把酥团擀成牛舌状卷起再擀平，包入馅料收口按扁，刷一层植物油再撒白芝麻。",
      "time_min": 15,
      "heat": "无火",
      "tip": "卷两次层次更多，收口一定要捏紧。火候和顺序都要留神，别图快。",
      "visual_cue": "饼坯圆整，芝麻铺满，锅里状态一目了然。"
    },
    {
      "n": 6,
      "text": "平底锅小火烙两分钟定形，转入二百度烤箱烤十五分钟至金黄鼓起。",
      "time_min": 18,
      "heat": "中火",
      "tip": "先烙再烤，饼底不塌皮更酥。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "饼面金黄，侧边起层，颜色和形态变化清楚。"
    }
  ],
  "tips": [
    "梅干菜要泡软再剁碎并挤干水，湿的馅料会把饼皮泡软。",
    "油酥里的猪油要冷透再用，擀开时才不粘手不断层。",
    "先平底锅烙定形再入烤箱，饼皮才酥得起来又不塌。"
  ],
  "common_mistakes": [
    "馅料水分没挤干，烤完饼底发软塌陷，一口下去全是水汽。",
    "猪油油酥抹得太厚，擀的时候全部挤出来，起不了酥层。",
    "火候过大烤到十分钟就关，外皮焦黑内里还是死面。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "火腿",
      "ratio": "150克:130克",
      "note": "火腿更咸，盐可减两克。"
    },
    {
      "original": "猪油",
      "substitute": "黄油",
      "ratio": "60克:65克",
      "note": "奶香明显，酥感稍弱于猪油版。"
    }
  ],
  "variations": [
    "馅里加一勺辣椒粉同炒，做成微辣版，配稀饭更下口。",
    "做成小号一口酥，烤十分钟即熟，晾凉装罐当茶点待客。"
  ],
  "serving_suggestion": "出炉晾三分钟趁热吃，配一碗小米粥或一杯绿茶，一次两枚刚好。",
  "storage": "常温密封可放三天，回炉一百六十度烤五分钟恢复酥脆，冷藏会返潮变软。",
