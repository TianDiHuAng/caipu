  "equipment": [
    "竹簸箕",
    "竹屉",
    "玻璃罐",
    "炒锅",
    "干净纱布",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐切成三厘米见方的块，摊在竹簸箕上，盖一层纱布放阴凉通风处晾一天。",
      "time_min": 15,
      "heat": "无火",
      "tip": "晾到表面结一层干皮，霉化时才不容易长杂菌，成品也更紧实。",
      "visual_cue": "豆腐块边缘发硬，表面无明水"
    },
    {
      "n": 2,
      "text": "竹屉底部铺一层干净稻草，豆腐块摆上，块与块之间留两指宽距离，盖盖放避光处。",
      "time_min": 10,
      "heat": "无火",
      "tip": "稻草上的天然菌种是引子，没有稻草可用干净竹叶代替，但别用塑料屉。",
      "visual_cue": "豆腐块表面开始出现细白绒"
    },
    {
      "n": 3,
      "text": "五天后豆腐块表面长满白色绒毛，用筷子夹起在料酒里滚一遍。",
      "time_min": 8,
      "heat": "无火",
      "tip": "绒毛发白发亮是好的，出现黑点或绿斑说明杂菌污染，整批都要扔掉。",
      "visual_cue": "白绒均匀，闻着有股清香味"
    },
    {
      "n": 4,
      "text": "辣椒粉与花椒下锅小火炒香，晾凉后拌入盐和白糖，做成裹料。",
      "time_min": 10,
      "heat": "小火",
      "tip": "辣椒粉炒过才出红油香，火大了会发苦，颜色也会变黑。",
      "visual_cue": "裹料颜色红亮，香气辛辣"
    },
    {
      "n": 5,
      "text": "豆腐块在裹料里滚匀，一块块码进干净无水的玻璃罐，层层压紧。",
      "time_min": 12,
      "heat": "无火",
      "tip": "罐子必须无油无水，一滴生水就能让整罐长霉，白忙一个月。",
      "visual_cue": "豆腐块之间没有空隙，裹料饱满"
    },
    {
      "n": 6,
      "text": "倒入料酒没过豆腐块，淋一层植物油封住表面，盖盖放阴凉处发酵二十天。",
      "time_min": 8,
      "heat": "无火",
      "tip": "油封是隔绝空气的关键，油层太薄会起白膜，味道发酸。",
      "visual_cue": "油层完整覆盖，罐口无气泡"
    }
  ],
  "tips": [
    "自制豆腐乳的关键是干净，所有器具都要开水烫过再晾干，不能沾生水。",
    "霉菌长成白色绒毛才算成功，颜色杂了就是坏了，宁可整批倒掉重做。",
    "发酵二十天后尝一块，咸鲜带香就成，太淡可以补一点盐再封几天。"
  ],
  "common_mistakes": [
    "豆腐没晾干就装屉，水汽留在表面，霉没长出来先长出黏手的杂菌。",
    "罐子里留下生水或油星，二十天后打开一股腐臭味，全部报废。",
    "盐放太少压不住杂菌，表面浮起一层白膜，豆腐化成糊状。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "北豆腐",
      "ratio": "600克:600克",
      "note": "北豆腐水分少，晾制时间可缩短到半天。"
    },
    {
      "original": "料酒",
      "substitute": "白酒",
      "ratio": "30毫升:30毫升",
      "note": "白酒杀菌更强，风味更冲，用量可减到二十毫升。"
    }
  ],
  "variations": [
    "裹料里加一勺五香粉，风味更复合，是皖南山区过年的做法。",
    "加红曲粉同腌，成品红亮，就是江浙一带的红方腐乳。"
  ],
  "serving_suggestion": "取两块腐乳配一碗热粥或蒸饼，佐一点罐里的油汁，是最省事的早饭。",
  "storage": "阴凉处可存半年，取用时用干净干筷，别沾生水；开封后冷藏保存。",
