  "steps": [
    {
      "n": 1,
      "text": "五花肉切三厘米见方的块，冷水下锅焯水。这一步不要着急。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅，血沫才逼得出来。，注意火候。",
      "visual_cue": "浮沫浮起，肉块收紧，状态稳定"
    },
    {
      "n": 2,
      "text": "捞出用温水冲净浮沫，沥干水分。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用温水冲，肉才不紧缩。，注意火候。",
      "visual_cue": "肉块干净，表面微干，状态稳定"
    },
    {
      "n": 3,
      "text": "砂锅倒植物油，下冰糖小火炒到琥珀色。这一步不要着急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖色变琥珀就下肉，深了会苦。，注意火候。",
      "visual_cue": "糖液冒泡，颜色枣红，状态稳定"
    },
    {
      "n": 4,
      "text": "倒入肉块翻炒上色，每块都裹上糖色。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "快翻别停，糖色容易糊。，注意火候。",
      "visual_cue": "肉块红亮，油光明显，状态稳定"
    },
    {
      "n": 5,
      "text": "加姜片、八角和桂皮炒出香味。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料炒香，腥味才压得住。，注意火候。",
      "visual_cue": "香气散出，锅底干爽，状态稳定"
    },
    {
      "n": 6,
      "text": "烹入料酒，加生抽、老抽和清水烧开。这一步不要着急。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水要没过肉面，焖的时候不干锅。，注意火候。",
      "visual_cue": "汤面翻滚，酱色均匀，状态稳定"
    },
    {
      "n": 7,
      "text": "转小火焖四十分钟，肉开始变软。这一步不要着急。",
      "time_min": 42,
      "heat": "小火",
      "tip": "小火慢焖，肉才酥而不散。，注意火候。",
      "visual_cue": "汤汁减少，肉质松软，状态稳定"
    },
    {
      "n": 8,
      "text": "放栗子继续焖二十分钟，让栗子吸汁。这一步不要着急。",
      "time_min": 22,
      "heat": "小火",
      "tip": "栗子后放，才不会焖成糊。，注意火候。",
      "visual_cue": "栗子鼓胀，表面发亮，状态稳定"
    },
    {
      "n": 9,
      "text": "加盐调味，大火收汁到浓稠挂勺。这一步不要着急。",
      "time_min": 5,
      "heat": "大火",
      "tip": "收汁时轻推，别把栗子搅碎。，注意火候。",
      "visual_cue": "汤汁浓亮，栗子完整，状态稳定"
    }
  ],
  "tips": [
    "冰糖炒到琥珀色就下肉，深了发苦。，值得留意。",
    "栗子后放二十分钟，才不会焖散。，值得留意。",
    "小火慢焖，肉才酥而不柴。，值得留意。"
  ],
  "common_mistakes": [
    "糖色炒过头，整锅发苦。，值得留意。",
    "栗子一开始就下锅，最后全成泥。，值得留意。",
    "大火久煮，肉块紧缩发硬。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "栗子",
      "substitute": "红薯",
      "ratio": "300 克:350 克",
      "note": "更甜，焖的时间缩短五分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "600 克:600 克",
      "note": "更瘦，焖的时间加十五分钟。"
    }
  ],
  "variations": [
    "加几片冬笋同焖，清甜解腻。，值得留意。",
    "放一小块腐乳，风味更厚。，值得留意。"
  ],
  "serving_suggestion": "配白米饭，汤汁拌饭一绝。，效果更稳定。",
  "storage": "冷藏三天，复热加少量水小火焖十分钟。，效果更稳定。",
