  "equipment": [
    "蒸锅",
    "碗",
    "刀",
    "砧板",
    "深盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐切成两厘米厚的方片，摆进深盘，静置十分钟让多余的水分渗出。",
      "time_min": 12,
      "heat": "无火",
      "tip": "豆腐出水多，不倒掉盘底的水，蒸出来会一汪汤。",
      "visual_cue": "盘底积起一层清水，豆腐片挺立"
    },
    {
      "n": 2,
      "text": "猪肉末加香菇末、姜末、米酒、生抽、盐、白胡椒与淀粉，顺一个方向搅打上劲。",
      "time_min": 6,
      "heat": "无火",
      "tip": "肉馅要搅到黏手能拉出丝，铺在豆腐上蒸完才不会散开掉渣。",
      "visual_cue": "肉馅黏亮成团，插筷不倒"
    },
    {
      "n": 3,
      "text": "把肉馅均匀铺在豆腐片上，用勺子背轻轻压平，边缘留一圈空隙。",
      "time_min": 4,
      "heat": "无火",
      "tip": "肉馅铺平压实，蒸的时候受热才均匀，也不会从豆腐边上滑下去。",
      "visual_cue": "肉馅平整贴合，厚度约一厘米"
    },
    {
      "n": 4,
      "text": "蒸锅水大开后放入深盘，大火蒸十二分钟至肉馅熟透。",
      "time_min": 13,
      "heat": "大火",
      "tip": "必须水开上锅，豆腐才嫩、肉馅才不柴。",
      "visual_cue": "肉馅收紧发白，盘底有清汤"
    },
    {
      "n": 5,
      "text": "取出后撒上葱花，把植物油烧到微微冒烟，连同几滴香油一起泼在葱花上激出香味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "热油一泼，葱香立刻冲出来，这是整道菜的收尾。",
      "visual_cue": "葱末卷起放香，油光浮在表面"
    }
  ],
  "tips": [
    "嫩豆腐口感更滑，老豆腐更耐蒸，两者都行。",
    "肉馅里拌进两勺剁碎的虾米同蒸，鲜味会更足，也不用另外加味精。",
    "蒸出来的那点汤汁不要倒掉，鲜味全在里面，拌饭特别香。"
  ],
  "common_mistakes": [
    "豆腐不静置出水，蒸出来盘里全是汤，味道也淡。",
    "肉馅铺太厚，外面老了中间还没熟透。",
    "蒸的时间太长，豆腐起蜂窝发硬，肉末也柴得嚼不动了。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "日本豆腐",
      "ratio": "400克:350克",
      "note": "日本豆腐更嫩，蒸的时间减两分钟。"
    },
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "150克:150克",
      "note": "牛肉较瘦，香油可多加三毫升。"
    }
  ],
  "variations": [
    "加一勺剁碎的腊肉同蒸，咸香更浓，是徽州的冬天做法。",
    "把豆腐换成毛豆腐同蒸，风味更冲，适合爱吃发酵味的人。"
  ],
  "serving_suggestion": "连盘上桌，舀一勺肉末豆腐浇在饭上，是最家常的吃法。",
  "storage": "冷藏可存两天，复热须上锅蒸八分钟，微波会令豆腐发硬。",
