          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "汤锅",
    "锅铲",
    "打蛋碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "春笋剥去外壳，削掉根部老硬的部分，只留嫩芯。",
      "time_min": 6,
      "heat": "无火",
      "tip": "掐得动的才是嫩芯，硬的部分煮多久都发柴。",
      "visual_cue": "笋身洁白，尖端紧实不松散"
    },
    {
      "n": 2,
      "text": "把笋切成细丝，越细越好，切好后立刻泡进清水里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "笋丝见空气容易发黄发涩，泡水能保持脆白。",
      "visual_cue": "笋丝细长均匀，浸在水里洁白"
    },
    {
      "n": 3,
      "text": "汤锅烧开水，笋丝下锅焯三分钟去掉草酸与涩味。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯水这一步不能省，省了菜会带一股涩口。",
      "visual_cue": "笋丝由白转半透明，水面浮起细沫"
    },
    {
      "n": 4,
      "text": "捞出笋丝过一遍凉水，再用手把水分彻底挤干。",
      "time_min": 3,
      "heat": "无火",
      "tip": "挤干水才炒得香，带着水下锅会出一锅汤。",
      "visual_cue": "笋丝成团，挤出的水清亮"
    },
    {
      "n": 5,
      "text": "鸡蛋打散后加料酒与少许盐，搅到颜色完全均匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "加点料酒能压住蛋的腥气，炒出来更香。",
      "visual_cue": "蛋液细腻，表面有细小气泡"
    },
    {
      "n": 6,
      "text": "炒锅大火烧热放一半花生油，倒入蛋液炒成大块盛出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "蛋只炒到七成熟就盛出，回锅才不老。",
      "visual_cue": "蛋块金黄鼓胀，中心微湿"
    },
    {
      "n": 7,
      "text": "锅里补一点花生油，下笋丝用中火翻炒两分钟炒出笋香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "笋丝要炒到边缘微焦，香味才出得来。",
      "visual_cue": "笋丝边缘略黄，锅里香气清甜"
    },
    {
      "n": 8,
      "text": "加生抽与盐翻匀，倒回蛋块，撒葱花大火兜匀出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "最后兜两下就够，多炒蛋块会散成碎末。",
      "visual_cue": "笋丝裹上浅酱色，蛋块完整"
    }
  ],
  "tips": [
    "春笋买回来尽快吃，放两天就发老。",
    "笋丝焯水时加一小勺盐，去涩效果更好。",
    "蛋液里加半勺清水，炒出来更嫩。",
    "喜欢更鲜的味道，可以加一勺猪油一起炒。"
  ],
  "common_mistakes": [
    "笋没焯水直接炒，整盘菜带一股麻嘴的涩味。",
    "笋丝切得太粗，炒到蛋老了笋还没熟。",
    "鸡蛋炒到全熟才盛出，回锅后干得像橡皮。"
  ],
  "substitutions": [
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "250克:250克",
      "note": "涩味少，可省去焯水。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "150克:160克",
      "note": "颜色更黄，腥味略重需多加料酒。"
    }
  ],
  "variations": [
    "加一小把火腿末一起炒，鲜味会更厚实。",
    "换成雪菜一起炒，做成雪菜笋丝炒蛋。"
  ],
  "serving_suggestion": "趁热装盘，笋脆蛋香，配米饭或拌面都合适。",
  "storage": "当天吃完，冷藏后笋丝会返涩，不建议隔夜。",
