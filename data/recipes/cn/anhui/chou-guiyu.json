  "equipment": [
    "炒锅",
    "砂锅",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "臭鳜鱼冲洗净表面盐分与黏液，用厨房纸吸干，两面各划两刀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洗到闻起来只有淡淡发酵香，不再刺鼻。",
      "visual_cue": "鱼身干爽，鱼皮不再黏手"
    },
    {
      "n": 2,
      "text": "菜籽油烧热滑锅，鱼下锅中小火煎 6 分钟至两面金黄，盛出。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "热锅热油再下鱼，鱼皮才不破。",
      "visual_cue": "鱼皮金黄起脆，晃动锅时鱼能整体滑动"
    },
    {
      "n": 3,
      "text": "锅留底油炒香五花肉片，下姜蒜、小米辣与豆瓣酱炒出红油，再下笋片翻炒。",
      "time_min": 4,
      "heat": "中火",
      "tip": "五花肉煸出油，烧出的鱼更香。",
      "visual_cue": "豆瓣酱颜色转暗红，油色发红"
    },
    {
      "n": 4,
      "text": "放回鳜鱼，沿锅边淋料酒，加生抽、老抽、白糖与高汤，小火炖 12 分钟，中途舀汁浇淋鱼身。",
      "time_min": 14,
      "heat": "小火",
      "tip": "不要翻面，用浇汁代替，鱼肉才不散。",
      "visual_cue": "汤汁收到一半，鱼肉纹理清晰鼓起"
    },
    {
      "n": 5,
      "text": "转大火收汁至浓稠挂勺，撒葱段后连锅端上桌。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁时不断舀汁浇淋，表面才亮。",
      "visual_cue": "汤汁挂勺，鱼身油亮红润"
    }
  ],
  "tips": [
    "腌好的臭鳜鱼本身有咸味，先洗后调味，避免过咸。",
    "用砂锅小火炖，受热均匀不易碎。",
    "竹笋焯水后能吸收汤汁，比直接下锅更入味。"
  ],
  "common_mistakes": [
    "鱼不擦干就下锅，热油飞溅且鱼皮粘锅。",
    "中途翻面导致鱼身断裂，卖相全毁。"
  ],
  "substitutions": [
    {
      "original": "鳜鱼",
      "substitute": "鲈鱼",
      "ratio": "1:1",
      "note": "鲈鱼刺少，但肉质偏软，炖制缩短到 8 分钟。"
    },
    {
      "original": "豆瓣酱",
      "substitute": "剁椒",
      "ratio": "1:1.2",
      "note": "风味转为鲜辣，白糖减半。"
    }
  ],
  "variations": [
    "徽州老做法全程用猪油，香气更浓。",
    "家庭版先用烤箱 200°C 烤 8 分钟定型，再入锅烧，减少破皮风险。"
  ],
  "serving_suggestion": "连锅上桌，配米饭，汤汁拌饭风味最佳。",
  "storage": "冷藏 2 天，复热加少量高汤小火煨 5 分钟。未烹调的腌鱼需冷藏并在 5 天内食用。",
