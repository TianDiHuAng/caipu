    "砂锅",
    "漏勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪蹄用镊子拔净残毛，剁成四厘米见方的块，冲洗干净。",
      "time_min": 12,
      "heat": "无火",
      "tip": "残毛不拔净，炖好会有焦味。",
      "visual_cue": "表皮白净，无黑色毛根"
    },
    {
      "n": 2,
      "text": "冷水下锅，加料酒与一半姜片，大火煮开焯五分钟。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅，血沫才逼得出来。",
      "visual_cue": "水面浮起褐色沫，撇净"
    },
    {
      "n": 3,
      "text": "捞出猪蹄用温水冲净表面浮沫，沥干水分后备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用温水冲，肉皮不会骤然收紧。",
      "visual_cue": "猪蹄表面干净，块块分明"
    },
    {
      "n": 4,
      "text": "炒锅下少量油，放冰糖小火炒到融化变枣红色。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖色到枣红就下料，晚了会发苦。",
      "visual_cue": "糖液冒小泡，颜色红亮"
    },
    {
      "n": 5,
      "text": "猪蹄下锅后快速翻炒，让每一块都均匀裹上糖色。",
      "time_min": 4,
      "heat": "中火",
      "tip": "翻炒要快，糖色才挂得均匀。",
      "visual_cue": "猪蹄通体红亮，锅底泛油光"
    },
    {
      "n": 6,
      "text": "加入姜片、八角与桂皮炒香，淋入料酒炝锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "料酒沿锅边淋，香气才起得来。",
      "visual_cue": "锅内腾起酒香，滋啦作响"
    },
    {
      "n": 7,
      "text": "加生抽酱油与老抽酱油翻匀，倒入清水没过猪蹄。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水一次加足，中途加水汤会变腥。",
      "visual_cue": "汤汁呈深红褐色，浮着香料"
    },
    {
      "n": 8,
      "text": "大火烧开后转小火，加盖炖一小时二十分钟。",
      "time_min": 80,
      "heat": "小火",
      "tip": "小火慢炖，胶质才化得开。",
      "visual_cue": "汤汁微沸，猪蹄渐软"
    },
    {
      "n": 9,
      "text": "开盖加盐调好咸淡，转中火把汤汁收到浓稠挂勺。",
      "time_min": 15,
      "heat": "中火",
      "tip": "收汁时勤翻动，避免糊底。",
      "visual_cue": "汤汁浓稠，能挂在猪蹄表面"
    },
    {
      "n": 10,
      "text": "关火再焖五分钟才装盘，表面撒少许葱花点缀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "焖一会儿，味道回得更匀。",
      "visual_cue": "猪蹄油亮红润，酱汁晶亮"
    }
  ],
  "tips": [
    "糖色炒到枣红立即下料，再炒十秒就会带苦味。",
    "水一次加足，中途加水会把胶质冲散，汤也发腥。",
    "收汁阶段要不停翻动，糖分多容易粘锅糊底。"
  ],
  "common_mistakes": [
    "焯水用热水下锅，血沫锁在肉里，炖出来腥气重。",
    "全程大火猛炖，皮烂肉散，汤汁浑浊。",
    "收汁不收直接出锅，汤汁寡淡，挂不住味。"
  ],
  "substitutions": [
    {
      "original": "猪蹄",
      "substitute": "五花肉",
      "ratio": "1000 克:800 克",
      "note": "炖一小时即可，肥而不腻。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "40 克:35 克",
      "note": "糖色偏浅，需多炒半分钟。"
    }
  ],
  "variations": [
    "加一把笋同炖，吸饱肉汁后比肉还好吃。",
    "添两只干辣椒，甜中带一点辣，下饭更凶。"
  ],
  "serving_suggestion": "连汁带蹄盛进深盘，配米饭或拌面都合适。",
  "storage": "冷藏可放三天，汤汁会凝成胶冻，复热后风味更浓。",
