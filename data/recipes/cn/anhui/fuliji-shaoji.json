  "equipment": [
    "深锅",
    "漏勺",
    "食品夹"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡洗净沥干，用 40ml 生抽与 20ml 料酒把鸡身内外抹匀，腌 20 分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "鸡皮擦得越干，浇油后的颜色越匀。",
      "visual_cue": "鸡皮油亮、腌料均匀挂附"
    },
    {
      "n": 2,
      "text": "深锅倒 200ml 植物油烧至六成热，用食品夹提着鸡颈，把热油反复浇淋鸡身至皮色金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "家庭操作以浇淋代替整只浸炸，省油又安全。",
      "visual_cue": "鸡皮金黄收紧、油珠清亮"
    },
    {
      "n": 3,
      "text": "另起锅下少量底油，中火炒香姜片、大葱与大蒜，再放八角、桂皮与香叶炒 30 秒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料炒过才出香，直接下汤味道发闷。",
      "visual_cue": "香料颜色加深、香气明显"
    },
    {
      "n": 4,
      "text": "加 1500ml 清水、老抽 20ml、生抽 40ml、冰糖、40ml 料酒与 8g 盐，大火烧开成卤水。",
      "time_min": 5,
      "heat": "大火",
      "tip": "卤水要先调好咸甜，再放鸡。",
      "visual_cue": "卤水红亮、味道咸鲜回甜"
    },
    {
      "n": 5,
      "text": "放入整鸡，汤量没过鸡身一半，加盖小火卤 50 分钟，中途翻面两次。",
      "time_min": 52,
      "heat": "小火",
      "tip": "小火慢卤，鸡皮才完整不破。",
      "visual_cue": "鸡身色泽红亮、筷子可穿腿部"
    },
    {
      "n": 6,
      "text": "关火后让鸡在卤水中浸泡 10 分钟再捞出，晾至温热后斩件装盘。",
      "time_min": 12,
      "heat": "无火",
      "tip": "离火浸泡是入味的关键一步。",
      "visual_cue": "鸡肉紧实多汁、骨中带红"
    }
  ],
  "tips": [
    "选用 1.2kg 左右的仔鸡，太大不易入味、太小易烂。",
    "卤水可留作老卤，反复使用三到五次风味最佳。",
    "斩件时刀要利，顺关节下刀鸡块才整齐。"
  ],
  "common_mistakes": [
    "鸡不沥干就下油锅，油花四溅、鸡皮破裂。",
    "大火猛卤，鸡皮破裂、肉质发柴。",
    "卤好后立刻捞出，表皮未回色、内部不入味。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "1200g 整鸡 ≈ 900g 鸡腿肉",
      "note": "鸡腿肉卤 25 分钟即可，无需浇油。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "20g 冰糖 ≈ 18g 白糖",
      "note": "白糖易焦，炒制时火要小。"
    }
  ],
  "variations": [
    "家庭简化版：不浇油，直接卤制后刷一层蜂蜜水，色泽同样好看。",
    "符离集传统版卤水加冰糖上色，成品皮色红亮带脆感。"
  ],
  "serving_suggestion": "晾凉斩件，配一碟蒜泥或卤汁蘸食，安徽宴客的冷盘主角。",
  "storage": "冷藏 2 天、冷冻 1 个月；复热蒸 8 分钟，肉质可恢复。",
