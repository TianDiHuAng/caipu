  "equipment": [
    "平底锅",
    "擀面杖",
    "大碗",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "梅干菜 120g 用清水泡 30 分钟，反复淘洗至水清，挤干水分后切碎。",
      "time_min": 32,
      "heat": "无火",
      "tip": "多洗几遍去沙，否则牙碜。",
      "visual_cue": "梅干菜无沙粒、颜色深褐"
    },
    {
      "n": 2,
      "text": "350g 面粉加 4g 盐与 190ml 温水，揉成光滑面团，盖湿布饧 25 分钟。",
      "time_min": 28,
      "heat": "无火",
      "tip": "水温约 40 度，面团更柔软。",
      "visual_cue": "面团光滑不粘手、表面细腻"
    },
    {
      "n": 3,
      "text": "炒锅放 20ml 植物油，下五花肉丁小火煸出油，至肉丁微黄出香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火慢煸，猪油出来馅才香。",
      "visual_cue": "肉丁金黄、锅中有清亮猪油"
    },
    {
      "n": 4,
      "text": "放入梅干菜碎翻炒 3 分钟，加 15ml 生抽、5g 白糖翻匀，撒小葱碎炒匀放凉。",
      "time_min": 5,
      "heat": "中火",
      "tip": "馅要放凉再包，热馅会烫破皮。",
      "visual_cue": "梅干菜油亮、香味浓郁"
    },
    {
      "n": 5,
      "text": "面团分成 8 份擀成薄圆片，包入一勺馅料，收口捏紧后按扁擀成 8 毫米厚的饼。",
      "time_min": 10,
      "heat": "无火",
      "tip": "收口捏严再擀，避免露馅。",
      "visual_cue": "饼胚圆整、厚薄均匀"
    },
    {
      "n": 6,
      "text": "平底锅刷剩余 20ml 植物油，中小火下饼胚烙 3 分钟至底面金黄，翻面再烙 3 分钟。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "中小火慢烙，里面才熟得透。",
      "visual_cue": "两面金黄带焦斑、饼身鼓起"
    }
  ],
  "tips": [
    "梅干菜一定多洗几遍，沙子洗不干净整口牙碜。",
    "馅料放凉再包，热气会让饼皮破裂。",
    "中小火慢烙，火大容易外焦里生。"
  ],
  "common_mistakes": [
    "梅干菜没泡透就下锅，口感粗硬带沙。",
    "馅料调得太湿，擀饼时从边上漏出来。",
    "锅太热直接烙，饼皮焦了馅还是凉的。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "200g 对 180g",
      "note": "咸味更重，盐减到 2g。"
    },
    {
      "original": "梅干菜",
      "substitute": "雪菜",
      "ratio": "120g 对 150g",
      "note": "泡洗时间缩短到 10 分钟。"
    }
  ],
  "variations": [
    "笋干版：梅干菜换成泡发笋干碎。",
    "辣味版：馅中加 8g 辣椒粉。"
  ],
  "serving_suggestion": "趁热切开，配一碗米粥或热豆浆一起食用。",
  "storage": "冷藏 2 天，复热用平底锅干烙 2 分钟。",
