  "steps": [
    {
      "n": 1,
      "text": "面粉加温水揉成柔软面团，盖布醒三十分钟。这一步不要着急。",
      "time_min": 35,
      "heat": "无火",
      "tip": "水温四十度左右，面团才软。，注意火候。",
      "visual_cue": "面团光滑，按压回弹，状态稳定"
    },
    {
      "n": 2,
      "text": "梅干菜泡三十分钟，反复洗净挤干切碎。这一步不要着急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "洗到水不浑，成品才不牙碜。，注意火候。",
      "visual_cue": "菜末细碎，无硬梗，状态稳定"
    },
    {
      "n": 3,
      "text": "五花肉切小丁，冷锅小火煸出油。这一步不要着急。",
      "time_min": 7,
      "heat": "小火",
      "tip": "煸到肉丁微焦，香味才出来。，注意火候。",
      "visual_cue": "肉丁出油，边缘微黄，状态稳定"
    },
    {
      "n": 4,
      "text": "下梅干菜碎炒干水汽，加生抽、白糖和盐。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "炒到菜末发亮不粘锅。，注意火候。",
      "visual_cue": "菜末油亮，香气浓，状态稳定"
    },
    {
      "n": 5,
      "text": "关火撒小葱末拌匀，盛出晾凉。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "馅要凉透再包，不然面皮会破。，注意火候。",
      "visual_cue": "馅料松散，葱绿点缀，状态稳定"
    },
    {
      "n": 6,
      "text": "面团分成六份，擀成中间厚边缘薄的圆片。这一步不要着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "边缘薄，收口才不堆面。，注意火候。",
      "visual_cue": "圆片匀称，边缘略薄，状态稳定"
    },
    {
      "n": 7,
      "text": "包入馅料，像包子一样收口后压扁。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "收口捏紧，擀的时候才不会漏。，注意火候。",
      "visual_cue": "饼坯圆鼓，收口封住，状态稳定"
    },
    {
      "n": 8,
      "text": "轻擀成十五厘米的薄饼，两面刷植物油。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "轻推慢擀，别把馅挤出来。，注意火候。",
      "visual_cue": "饼薄见馅，边缘完整，状态稳定"
    },
    {
      "n": 9,
      "text": "平底锅中小火烙四分钟，两面金黄即可。这一步不要着急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "烙的时候压一压，受热才匀。，注意火候。",
      "visual_cue": "两面焦斑，饼身鼓起，状态稳定"
    }
  ],
  "tips": [
    "面团要软，擀薄了才不裂。，值得留意。",
    "梅干菜炒干水汽，馅才够香。，值得留意。",
    "馅凉透再包，饼皮不破。，值得留意。"
  ],
  "common_mistakes": [
    "面团太硬，擀开就裂口。，值得留意。",
    "馅里带水，烙的时候漏油。，值得留意。",
    "火太大，外面糊了里面生。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪油渣",
      "ratio": "120 克:80 克",
      "note": "更香，油要减半。"
    },
    {
      "original": "梅干菜",
      "substitute": "雪里蕻腌菜",
      "ratio": "100 克:120 克",
      "note": "咸度高，盐可省。"
    }
  ],
  "variations": [
    "加一点辣椒粉，做成微辣口。，值得留意。",
    "用烤箱两百度烤十分钟，更酥脆。，值得留意。"
  ],
  "serving_suggestion": "趁热吃，配一碗粥或豆浆就是徽州人的早饭。",
  "storage": "冷藏两天，复热用平底锅干烙两分钟。，效果更稳定。",
