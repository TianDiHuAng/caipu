    "蒸锅",
    "打蛋盆",
    "滤网",
    "深盘",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "火腿切成一毫米厚的薄片，用温水泡几分钟去掉多余的咸味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "火腿咸度差别大，先尝一片再定盐量。",
      "visual_cue": "火腿片变软，泡水微微泛红"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进盆里加盐打散，蛋液打到看不见明显的蛋筋。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐要少放，火腿本身带咸味，先尝再定。",
      "visual_cue": "蛋液均匀，颜色一致"
    },
    {
      "n": 3,
      "text": "倒入温水搅匀，蛋液和水的比例约一比一点二。",
      "time_min": 2,
      "heat": "无火",
      "tip": "温水蒸出来嫩，冷水容易出蜂窝。",
      "visual_cue": "蛋液稀薄，表面有细泡"
    },
    {
      "n": 4,
      "text": "蛋液过筛倒进深盘，撇净浮沫，把火腿片一片片铺在表面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛去掉筋膜，蛋面才平整好看。",
      "visual_cue": "火腿片平贴蛋面不下沉"
    },
    {
      "n": 5,
      "text": "深盘放进上汽的蒸锅，中小火蒸到蛋液凝固、火腿边缘卷起。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "火别太大，蛋液一沸就出蜂窝孔，影响卖相。",
      "visual_cue": "轻晃盘面中心微颤不流动"
    },
    {
      "n": 6,
      "text": "出锅淋上香油，撒一把葱花，即可趁热端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油最后淋，久蒸香味会跑掉，葱花提色。",
      "visual_cue": "蛋面光滑，火腿油亮泛红"
    }
  ],
  "tips": [
    "火腿先泡水减咸，蒸出来才不齁。",
    "蛋液过筛再蒸，表面平滑不起孔。",
    "中小火蒸制，蛋液微颤即可停火。"
  ],
  "common_mistakes": [
    "火腿不泡直接蒸，成品咸得发苦。",
    "大火蒸蛋，表面鼓起一圈蜂窝孔，口感发老。",
    "盐按平常量放，忘了火腿本身很咸。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "金华火腿",
      "ratio": "80 克:80 克",
      "note": "香气更浓，咸度略低，可适量补盐。"
    },
    {
      "original": "清水",
      "substitute": "鸡汤",
      "ratio": "250 毫升:250 毫升",
      "note": "鲜味更足，盐要减到一克。"
    }
  ],
  "variations": [
    "铺火腿时夹几片笋片，清鲜解腻。",
    "出锅撒少许白胡椒，暖香更明显。"
  ],
  "serving_suggestion": "趁热用勺挖着吃，火腿的咸香混着嫩蛋，配白粥最合适。",
  "storage": "冷藏一天，复蒸五分钟，别冷冻否则蛋体出水变散。",
  "nutrition_estimate": {
    "basis": "每份约 180 克",
