  "equipment": [
    "汤锅",
    "炒锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切细丝，加料酒、淀粉和少许盐抓匀。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "上浆后肉丝才滑嫩不柴。，注意火候。",
      "visual_cue": "肉丝挂浆，手感顺滑，状态稳定"
    },
    {
      "n": 2,
      "text": "雪里蕻洗净切碎，挤掉多余水分。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腌菜挤干，汤才不齁咸。，注意火候。",
      "visual_cue": "菜末干爽，颜色翠黄，状态稳定"
    },
    {
      "n": 3,
      "text": "汤锅倒清水烧开，转小火备用。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "水先烧上，炒好料直接下锅。，注意火候。",
      "visual_cue": "水面微沸，无大滚，状态稳定"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油，下姜丝小火煸香。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "姜丝煸出味，汤才不腥。，注意火候。",
      "visual_cue": "姜丝微卷，香气散出，状态稳定"
    },
    {
      "n": 5,
      "text": "放雪里蕻碎中火炒两分钟，炒出腌菜香。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "炒过的腌菜比直接煮更香。，注意火候。",
      "visual_cue": "菜末油亮，酸香明显，状态稳定"
    },
    {
      "n": 6,
      "text": "倒入开水，放豆腐块煮五分钟。这一步不要着急。",
      "time_min": 7,
      "heat": "中火",
      "tip": "用开水，汤色才清。，注意火候。",
      "visual_cue": "豆腐浮起，汤色微白，状态稳定"
    },
    {
      "n": 7,
      "text": "把肉丝抖散下锅，煮两分钟到变色。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "别一次倒成一团，抖散才不粘。，注意火候。",
      "visual_cue": "肉丝散开，颜色变白，状态稳定"
    },
    {
      "n": 8,
      "text": "加盐和白胡椒粉调味，撒小葱末出锅。这一步不要着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "胡椒最后放，香气才不跑。，注意火候。",
      "visual_cue": "表面浮葱，汤清味鲜，状态稳定"
    }
  ],
  "tips": [
    "肉丝上浆后再煮，口感才滑。，值得留意。",
    "雪里蕻先炒过，汤才够香。，值得留意。",
    "用开水冲汤，汤色才清亮。，值得留意。"
  ],
  "common_mistakes": [
    "肉丝没上浆，煮出来发柴。，值得留意。",
    "腌菜没挤干，汤咸得喝不下。，值得留意。",
    "冷水下锅，汤色发浑。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "鸡胸肉",
      "ratio": "250 克:250 克",
      "note": "更清淡，煮的时间缩短一分钟。"
    },
    {
      "original": "雪里蕻",
      "substitute": "酸菜",
      "ratio": "120 克:120 克",
      "note": "酸味更冲，盐要减半。"
    }
  ],
  "variations": [
    "下一把细面，就是雪菜肉丝面。，值得留意。",
    "加几片冬笋，汤更清鲜。，值得留意。"
  ],
  "serving_suggestion": "饭前一碗，酸香开胃；也可浇在米饭上做汤饭。",
  "storage": "冷藏两天，复热小火煮开即可。，效果更稳定。",
