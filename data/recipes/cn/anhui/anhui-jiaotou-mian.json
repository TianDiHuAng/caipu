  "equipment": [
    "汤锅",
    "炒锅",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成小方丁，冬笋和香干也切成同样大小的丁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "三样切得一样大，口感才整齐，烧制时间也好掌握。",
      "visual_cue": "三种丁大小相近，颗粒分明"
    },
    {
      "n": 2,
      "text": "木耳提前泡发洗净切成细丝，青菜择洗干净沥水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "木耳泡到完全舒展开，硬芯要掐掉。",
      "visual_cue": "木耳柔软有弹性，青菜无泥沙"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下五花肉丁中火煸炒到出油、边缘微焦。",
      "time_min": 6,
      "heat": "中火",
      "tip": "肉丁煸出油，浇头才香不腻，锅底要见清亮油。",
      "visual_cue": "肉丁收缩发黄，锅里有清亮油"
    },
    {
      "n": 4,
      "text": "加姜末和蒜末炒出香味，沿锅边淋黄酒翻匀去腥。",
      "time_min": 2,
      "heat": "中火",
      "tip": "黄酒沿锅边淋，酒气一挥腥味就散。",
      "visual_cue": "闻到酒香，肉丁表面油亮"
    },
    {
      "n": 5,
      "text": "下冬笋丁、香干丁和木耳丝翻炒，加生抽、老抽和清水烧开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "水要一次加够，中途加水味会淡。",
      "visual_cue": "汤汁微沸，浇头染上酱色"
    },
    {
      "n": 6,
      "text": "转小火焖到汤汁剩一半，加盐调味，浇头盛出备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "焖到笋丁入味，汤汁略稠最合适。",
      "visual_cue": "汤汁浓稠挂勺，浇头油亮"
    },
    {
      "n": 7,
      "text": "汤锅烧开水下面条，煮到八分熟时下青菜同煮。",
      "time_min": 5,
      "heat": "大火",
      "tip": "面别煮透，捞出后还会继续回软。",
      "visual_cue": "面条浮起，青菜颜色转深"
    },
    {
      "n": 8,
      "text": "面条和青菜捞入碗中，浇上浇头与汤汁，趁热拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "浇头连汁一起浇，面条才不干，拌开也更香。",
      "visual_cue": "面条油润，浇头铺满碗面"
    }
  ],
  "tips": [
    "浇头要连汤汁一起浇，面条才不干涩。",
    "五花肉煸出油再烧，浇头香而不腻。",
    "面条煮八分熟就捞，回软后口感刚好。"
  ],
  "common_mistakes": [
    "面条煮到全熟再捞，泡在汤里就烂了。",
    "浇头水加太少，拌面时干得拌不开。",
    "肉丁不煸直接烧，成品油腻发腻口。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪里脊",
      "ratio": "200 克:200 克",
      "note": "少油，需补一勺植物油同炒。"
    },
    {
      "original": "冬笋",
      "substitute": "春笋",
      "ratio": "100 克:100 克",
      "note": "需焯水去涩，口感更脆嫩。"
    }
  ],
  "variations": [
    "加几只河虾同烧，鲜味更足也更像宴席面。",
    "浇头换成笋干烧肉，更接近徽州老做法。"
  ],
  "serving_suggestion": "拌开后趁热吃，配一小碟辣椒酱更开胃。",
  "storage": "浇头冷藏两天，面条现煮；复热浇头加水少许烧开再浇。",
