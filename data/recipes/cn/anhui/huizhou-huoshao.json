        }
      ]
    }
  ],
  "equipment": [
    "大碗",
    "擀面杖",
    "平底锅",
    "刷子",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加温水和盐揉成偏软的面团，醒三十分钟。",
      "time_min": 35,
      "heat": "无火",
      "tip": "水多一点，火烧才外脆内软。，注意火候。",
      "visual_cue": "面团柔软，表面光滑，状态稳定"
    },
    {
      "n": 2,
      "text": "猪油隔水化开，拌入一半葱末和少许面粉成油酥。",
      "time_min": 6,
      "heat": "无火",
      "tip": "油酥稠一点，抹起来才不流。，注意火候。",
      "visual_cue": "油酥顺滑，葱香明显，状态稳定"
    },
    {
      "n": 3,
      "text": "面团擀成大薄片，均匀抹一层油酥。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "四边留一厘米，卷的时候不漏。，注意火候。",
      "visual_cue": "薄片透光，油酥均匀，状态稳定"
    },
    {
      "n": 4,
      "text": "撒上剩余葱末，从一边卷成紧实的长条。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "卷紧一点，层次才多。，注意火候。",
      "visual_cue": "长条紧实，葱末裹住，状态稳定"
    },
    {
      "n": 5,
      "text": "切成六段，两端捏紧，压扁成饼坯。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "捏紧两端，油酥才不跑。，注意火候。",
      "visual_cue": "饼坯圆整，层次可见，状态稳定"
    },
    {
      "n": 6,
      "text": "表面刷水撒白芝麻，轻擀到一厘米厚。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "芝麻刷水才粘得住。，注意火候。",
      "visual_cue": "芝麻密布，饼面平整，状态稳定"
    },
    {
      "n": 7,
      "text": "平底锅刷植物油，中小火烙三分钟。这一步不要着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盖盖烙，里面才熟得透。，注意火候。",
      "visual_cue": "底面金黄，饼身鼓起，状态稳定"
    },
    {
      "n": 8,
      "text": "翻面再烙三分钟，两面焦黄即可。这一步不要着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "两面都要焦香，别只烙一面。，注意火候。",
      "visual_cue": "两面焦斑，葱香扑鼻，状态稳定"
    }
  ],
  "tips": [
    "面团偏软，火烧才有层次。，值得留意。",
    "油酥要稠，抹的时候才不流。，值得留意。",
    "中小火烙，外面焦了里面还没熟。，值得留意。"
  ],
  "common_mistakes": [
    "面团太硬，烙出来像饼干。，值得留意。",
    "油酥太稀，卷的时候全流出来。，值得留意。",
    "火太大，皮焦了芯还生。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "50 克:45 毫升",
      "note": "起酥效果略差，但更清爽。"
    },
    {
      "original": "小葱",
      "substitute": "洋葱碎",
      "ratio": "60 克:60 克",
      "note": "甜味更重，香气不同。"
    }
  ],
  "variations": [
    "抹一层椒盐，咸香更明显。，值得留意。",
    "夹入卤肉片，做成肉夹火烧。，值得留意。"
  ],
  "serving_suggestion": "趁热掰开，配豆浆或小米粥。，效果更稳定。",
  "storage": "冷藏两天，复热用平底锅干烙两分钟。，效果更稳定。",
