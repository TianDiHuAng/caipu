  "steps": [
    {
      "n": 1,
      "text": "腊肉用温水刷洗干净表面的浮尘，放入蒸锅蒸十五分钟至皮软，取出晾凉。",
      "time_min": 18,
      "heat": "大火",
      "tip": "先蒸后切，皮软了好切，肉也不那么咸硬。",
      "visual_cue": "肉皮变软可掐，表面油亮"
    },
    {
      "n": 2,
      "text": "晾凉的腊肉切成两毫米厚的薄片，肥瘦分开摆放。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切得薄才好吃，厚片炒出来又咸又硬。",
      "visual_cue": "薄片透光，肥瘦界限分明"
    },
    {
      "n": 3,
      "text": "蒜苗洗净沥干，斜刀切成长段，梗和叶分开放。",
      "time_min": 5,
      "heat": "无火",
      "tip": "斜切断面大，更容易吸收腊肉的油香。",
      "visual_cue": "段长均匀，切口整齐不流汁"
    },
    {
      "n": 4,
      "text": "炒锅倒少许植物油，先下肥肉片小火煸出油，再下瘦肉片与姜蒜、干辣椒炒香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "肥肉先下锅把油煸出来，整道菜的香气全靠这层自出的荤油撑着。",
      "visual_cue": "肥片透明微卷，锅底渗出清油"
    },
    {
      "n": 5,
      "text": "烹入米酒，下蒜苗梗用大火翻炒一分钟，再加进生抽和白糖调味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蒜苗梗先下、叶子后下，两部分的熟度才能保持一致。",
      "visual_cue": "蒜苗梗由白转翠，锅中油光均匀"
    },
    {
      "n": 6,
      "text": "接着下入蒜苗叶，快速翻炒三十秒，一见叶子断生就立刻出锅装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "叶子一塌就得起锅，炒久了发黄出水，香气也会跟着跑掉。",
      "visual_cue": "蒜苗翠绿挺立，腊肉油亮微卷"
    }
  ],
  "tips": [
    "腊肉咸度差别很大，生抽要尝过再放。",
    "没有腊肉可用咸肉代替，须先泡两小时去咸。",
    "加一把干笋丝同炒，吸油又增香，是徽州人的搭配。"
  ],
  "common_mistakes": [
    "腊肉不蒸直接切，硬得切不动，还切得厚薄不匀。",
    "蒜苗梗和叶子一起下锅，叶子焖烂了梗还是生的。",
    "放太多油，腊肉本身出油，成品一汪油漂着。"
  ],
  "substitutions": [
    {
      "original": "腊肉",
      "substitute": "咸肉",
      "ratio": "200克:200克",
      "note": "咸肉更咸，须先泡水两小时再蒸。"
    },
    {
      "original": "蒜苗",
      "substitute": "韭菜",
      "ratio": "250克:250克",
      "note": "韭菜更易出水，炒的时间减半分钟。"
    }
  ],
  "variations": [
    "加干辣椒与花椒同炒，麻辣咸香，是山里人家的重口版本。",
    "把腊肉换成腊肠同炒，甜咸交错，孩子更爱吃。"
  ],
  "serving_suggestion": "趁热配白饭，腊肉的油香最能下饭，也可作为下酒菜。",
  "storage": "冷藏可存两天，复热须大火快炒，久蒸蒜苗会发黄。",
