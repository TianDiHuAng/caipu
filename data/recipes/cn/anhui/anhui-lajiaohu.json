  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "红椒",
          "name_en": "red bell pepper",
          "amount": 800,
          "unit": "g",
          "note": "选肉厚红辣椒洗净晾干",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 40,
          "unit": "g",
          "note": "去皮晾干",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 30,
          "unit": "g",
          "note": "去皮晾干",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 30,
          "unit": "g",
          "note": "腌制",
          "optional": false
        },
        {
          "name": "白酒",
          "name_en": "baijiu",
          "amount": 20,
          "unit": "ml",
          "note": "抑菌增香",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "料理机",
    "玻璃罐",
    "干净棉布",
    "无水菜板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红椒 800g 冲洗干净后摊在竹匾上晾 5 小时至表面全干，摘掉蒂部。",
      "time_min": 20,
      "heat": "无火",
      "tip": "辣椒必须完全晾干，带生水会发霉。",
      "visual_cue": "辣椒表面无水、表皮紧实"
    },
    {
      "n": 2,
      "text": "料理机把红椒打成粗碎，颗粒保留约 5 毫米，不要打成泥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粗碎口感更好，太细容易出水。",
      "visual_cue": "辣椒碎大小均匀、略有汁水"
    },
    {
      "n": 3,
      "text": "大蒜 40g 与姜 30g 分别打碎，与辣椒碎一起放入大盆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜姜也要晾干，水汽是发霉的主因。",
      "visual_cue": "蒜姜碎均匀混入辣椒"
    },
    {
      "n": 4,
      "text": "加入 40g 盐、10g 白糖与 20ml 白酒，戴手套充分拌匀至出汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "盐量按辣椒重量 5% 放，少了会坏。",
      "visual_cue": "混合物湿润出汁、咸香扑鼻"
    },
    {
      "n": 5,
      "text": "装入开水烫过并晾干的玻璃罐，边装边压实排气，罐口留 2 厘米空隙。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压实排出空气，发酵才均匀。",
      "visual_cue": "罐内无大空隙、表面平整"
    },
    {
      "n": 6,
      "text": "盖棉布再加盖，阴凉处静置 7 天，每天开盖放气一次，闻到酸香即成熟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "每天放气，避免罐内胀气顶开盖。",
      "visual_cue": "表面浮红油、气味酸辣"
    }
  ],
  "tips": [
    "辣椒、蒜、姜都必须晾干，一滴生水就可能整罐发霉。",
    "盐量按重量 5% 放，太少无法抑制杂菌。",
    "每天开盖放气，避免发酵产气把罐盖顶开。"
  ],
  "common_mistakes": [
    "辣椒没晾干就下盐，几天后表面长白霉。",
    "盐放得太少，辣椒糊很快发酸变味且难以保存。",
    "装罐时不压实，空气残留导致上层氧化发黑。"
  ],
  "substitutions": [
    {
      "original": "红椒",
      "substitute": "小米辣",
      "ratio": "800g 对 500g",
      "note": "辣度高，用量减半并多加 100g 红椒。"
    },
    {
      "original": "白酒",
      "substitute": "米酒",
      "ratio": "20ml 对 25ml",
      "note": "酒精度低，需冷藏保存。"
    }
  ],
  "variations": [
    "蒜香版：大蒜增至 80g，辛香更冲。",
    "豆豉版：拌入 50g 豆豉同腌。"
  ],
  "serving_suggestion": "佐粥、蘸白切肉或炒菜时加一勺提味。",
  "storage": "冷藏可存 3 个月，取用须用干净无水的勺子。",
