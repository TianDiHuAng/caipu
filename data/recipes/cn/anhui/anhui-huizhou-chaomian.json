  "equipment": [
    "炒锅",
    "汤锅",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切细丝，香菇温水泡二十分钟后挤干切丝，白菜洗净切粗丝。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡香菇的水别倒，留着炒面时加两勺，鲜味全靠它。",
      "visual_cue": "肉丝均匀，香菇挤干切成细条。"
    },
    {
      "n": 2,
      "text": "汤锅烧开水下面条，煮六分钟到八成熟，捞出过冷水后沥干拌一点油。",
      "time_min": 8,
      "heat": "大火",
      "tip": "煮到八成熟就捞，后面还要回锅炒，全熟了下锅必断面。",
      "visual_cue": "面条半透明，捞出后根根分明。"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，下五花肉丝中火煸三分钟至出油微黄。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉丝煸到边缘微焦出油，这层猪油就是整锅的香气底子。",
      "visual_cue": "肉丝出油微黄，锅底一层清油。"
    },
    {
      "n": 4,
      "text": "下香菇丝和白菜丝大火翻炒两分钟，加生抽和盐炒匀出香。",
      "time_min": 3,
      "heat": "大火",
      "tip": "白菜下锅炒到刚塌架就够，出水多了后面面条会发糊。",
      "visual_cue": "菜丝发亮微软，锅底还没有汤水。"
    },
    {
      "n": 5,
      "text": "倒入面条大火快速翻炒三分钟，用筷子抖散，沿锅边淋两勺香菇水。",
      "time_min": 4,
      "heat": "大火",
      "tip": "用筷子抖散比锅铲翻更不容易断面，动作要快火要大。",
      "visual_cue": "面条松散不结团，均匀裹上酱色。"
    },
    {
      "n": 6,
      "text": "撒白胡椒粉和小葱段，再翻炒三十秒收干水汽即可装碗。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱段最后三十秒下锅，炒久了发黄出水，香气也散没了。",
      "visual_cue": "面条干香油亮，葱段翠绿挺立。"
    }
  ],
  "tips": [
    "面条先煮到八成熟再过冷水，炒的时候才不粘连发坨。",
    "五花肉丝要煸出油再下配菜，整锅香气都靠这层猪油。",
    "全程大火快炒，锅里要有响声，出水多了就成了煮面。"
  ],
  "common_mistakes": [
    "面条煮到全熟再下锅炒，翻两下就断成一截一截。",
    "白菜一下锅就盖盖子焖，水汽散不掉，面泡在汤里发糊。",
    "盐和生抽一起下足，最后收不出干香，味道只剩咸。"
  ],
  "substitutions": [
    {
      "original": "白菜",
      "substitute": "小油菜",
      "ratio": "150克:150克",
      "note": "更易出水，火要更大。"
    },
    {
      "original": "五花肉",
      "substitute": "火腿",
      "ratio": "100克:90克",
      "note": "咸味更足，生抽减五毫升。"
    }
  ],
  "variations": [
    "加一勺梅干菜同炒，咸香里带一点回甘，是徽州山区的老做法。",
    "起锅前淋半勺猪油翻匀，面条油亮喷香，冬天吃最舒服。"
  ],
  "serving_suggestion": "趁热装碗，配一碗清汤或紫菜汤，吃完再喝口热茶解油。",
  "storage": "冷藏可放一天，回锅时加两勺清水大火翻炒，别用微波炉加热会发硬。",
