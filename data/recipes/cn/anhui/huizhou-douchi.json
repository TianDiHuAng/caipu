    "竹屉",
    "瓦罐",
    "汤锅",
    "干净纱布",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄豆挑去虫蛀与坏粒，用清水泡一夜，泡到豆瓣能轻松掐断为止。",
      "time_min": 12,
      "heat": "无火",
      "tip": "夏天泡豆要放冰箱，室温泡一夜容易发酸，豆子也就废了。",
      "visual_cue": "豆粒饱满涨大，豆瓣能掐断"
    },
    {
      "n": 2,
      "text": "泡好的黄豆下锅加清水没过三指，大火煮开转小火煮一小时至软烂。",
      "time_min": 60,
      "heat": "小火",
      "tip": "煮到手一捏就碎才够，豆子硬了后面发酵不透，口感发柴。",
      "visual_cue": "豆粒轻捏即散，汤色乳白"
    },
    {
      "n": 3,
      "text": "煮好的黄豆捞出沥干，摊在竹匾上晾到不烫手，撒面粉拌匀让每颗裹上薄粉。",
      "time_min": 15,
      "heat": "无火",
      "tip": "豆子太湿裹粉会结块，粉厚了霉层不透气，容易发黏变质。",
      "visual_cue": "每颗豆都挂一层白粉"
    },
    {
      "n": 4,
      "text": "裹好粉的黄豆铺进竹屉盖纱布，放温暖避光处发酵三天，长出黄绿色霉层。",
      "time_min": 12,
      "heat": "无火",
      "tip": "霉层发黄带绿是正常的曲子，出现黑斑就是坏曲，只能整批扔掉。",
      "visual_cue": "豆粒表面覆一层黄绿霉"
    },
    {
      "n": 5,
      "text": "霉好的黄豆加盐、辣椒粉、花椒与料酒拌匀，装进瓦罐层层压实。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐要一次放足，盐少了豆豉会酸败，后面再加也压不住。",
      "visual_cue": "豆粒裹匀料粉，罐内压实无空隙"
    },
    {
      "n": 6,
      "text": "罐口盖纱布放太阳下晒七天，每天翻拌一次，晒到豆粒干爽发皱即成。",
      "time_min": 8,
      "heat": "无火",
      "tip": "晒的时候防雨防露水，进一滴生水整罐就会发霉长毛。",
      "visual_cue": "豆粒干爽发皱，香味浓厚"
    }
  ],
  "tips": [
    "徽州豆豉靠自然制曲，气温二十五度左右最合适，冬天要放灶边保温。",
    "晒好的豆豉装坛密封能存一年，越存越香，炒菜时抓一把提味。",
    "做豆豉全程不能沾生水和油，器具都要提前用开水烫过晾干。"
  ],
  "common_mistakes": [
    "煮豆时间太短，豆心还硬就制曲，霉只长在表面，里面发酸。",
    "发酵时湿度过大，霉层变成黏手的白膜，闻着一股馊味。",
    "晒制期间忘了收，被雨淋过一次，整罐豆豉长出黑毛只能丢掉。"
  ],
  "substitutions": [
    {
      "original": "黄豆",
      "substitute": "黑豆",
      "ratio": "500克:500克",
      "note": "黑豆制曲时间略长，需多发酵半天。"
    },
    {
      "original": "辣椒粉",
      "substitute": "五香粉",
      "ratio": "15克:10克",
      "note": "五香粉版本辣味全无，适合不吃辣的家庭。"
    }
  ],
  "variations": [
    "拌料时加一勺白酒，豆豉香气更冲，是黄山一带农家做法。",
    "把晒好的豆豉与辣椒同炒成豆豉酱，拌面下饭都合适。"
  ],
  "serving_suggestion": "取一小碟豆豉佐粥，或用来炒腊肉、蒸鱼，一勺就能吊起整锅的鲜。",
  "storage": "密封坛装放阴凉处可存一年，每次取用须用干净干勺，避免生水进入。",
