  "equipment": [
    "平底锅",
    "夹子",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "毛豆腐从包装取出，用厨房纸轻轻吸掉表面水，切成三厘米见方的块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "别冲洗菌丝，吸干表面水就够。这一步别省，成品口感差别很明显。",
      "visual_cue": "菌丝完整，表面干爽，锅里状态一目了然。"
    },
    {
      "n": 2,
      "text": "平底锅烧到微冒烟，倒植物油铺满锅底，把豆腐块留出一指空隙摆入。",
      "time_min": 3,
      "heat": "中火",
      "tip": "块间留空，翻面时铲子才伸得进去。火候和顺序都要留神，别图快。",
      "visual_cue": "油面泛光，块距均匀，颜色和形态变化清楚。"
    },
    {
      "n": 3,
      "text": "中火煎三分钟至底面结出金黄硬壳，用夹子轻推一下能滑动再翻面。",
      "time_min": 4,
      "heat": "中火",
      "tip": "能推动才翻，硬翻必破皮。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "底面金黄，边缘定型，锅里状态一目了然。"
    },
    {
      "n": 4,
      "text": "翻面再煎三分钟，两面都结壳后转小火，盖上盖子焖两分钟透心。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盖盖让热透进去，中心才不凉。这一步别省，成品口感差别很明显。",
      "visual_cue": "两面焦黄，豆腐鼓起，颜色和形态变化清楚。"
    },
    {
      "n": 5,
      "text": "小碗里放辣椒酱、蒜末、生抽和一点盐，搅匀成蘸酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酱要略稀，才好挂在豆腐壳上。火候和顺序都要留神，别图快。",
      "visual_cue": "酱色红亮，蒜末均匀，锅里状态一目了然。"
    },
    {
      "n": 6,
      "text": "豆腐盛盘撒小葱末，趁热配蘸酱上桌，吃前每块蘸一下酱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃，凉了壳会返软。提前把材料备齐，操作起来更稳当。",
      "visual_cue": "壳脆色金，葱末翠绿，颜色和形态变化清楚。"
    }
  ],
  "tips": [
    "毛豆腐要挑菌丝密白、闻着带豆香的，发黑或有酸臭味的一律不要。",
    "锅要烧热再下豆腐，定型前别翻动，皮破了就出浆粘锅。",
    "蘸酱现调现吃，蒜末久放会发苦。这一步做对了，口感差别很明显。"
  ],
  "common_mistakes": [
    "冷锅冷油下豆腐，底面粘成一团，翻面时全碎在锅里。",
    "火太急煎成黑壳，里面的菌香全被焦味盖住。",
    "一次下太多块挤着煎，温度掉下来，豆腐出水变软不成形。"
  ],
  "substitutions": [
    {
      "original": "辣椒酱",
      "substitute": "豆瓣酱",
      "ratio": "30克:25克",
      "note": "咸度更高，生抽减半。"
    },
    {
      "original": "豆腐",
      "substitute": "豆干",
      "ratio": "450克:400克",
      "note": "质地更紧，煎制时间缩短一分钟。"
    }
  ],
  "variations": [
    "煎好后加一勺高汤小火焖两分钟，酱香更透，是屯溪馆子的做法。",
    "裹一层薄薄的米粉再煎，外皮更脆，配粥吃口感反差大。"
  ],
  "serving_suggestion": "趁热装盘，撒小葱末，配一小碟辣椒酱蘸着吃，再来一碗白粥。",
  "storage": "煎好的当天吃完最好，冷藏可放一天，回锅干煎一分钟恢复表皮，不要蒸。",
