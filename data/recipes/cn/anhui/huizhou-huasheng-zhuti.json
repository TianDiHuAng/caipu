    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪蹄块用清水泡三十分钟，泡出血水后冲洗干净。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡出血水是去腥的第一步，别省这一会儿。",
      "visual_cue": "水色变淡红，肉块表面发白"
    },
    {
      "n": 2,
      "text": "冷水下锅放猪蹄与姜片、料酒，煮开后撇净浮沫再煮三分钟。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅血沫才逼得出来，热水下锅会封住。",
      "visual_cue": "水面浮起厚厚一层灰褐浮沫，肉块收紧"
    },
    {
      "n": 3,
      "text": "捞出猪蹄，用温水把表面的浮沫彻底冲干净，沥干水备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冲的时候用温水，冷水会让皮突然收缩发硬。",
      "visual_cue": "猪蹄表面干净，皮面完整没有残沫"
    },
    {
      "n": 4,
      "text": "炒锅下冰糖小火炒到融化起小泡，倒入猪蹄翻炒上色。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖色炒到枣红色就好，再炒一会儿就会发苦发黑。",
      "visual_cue": "猪蹄均匀裹上红亮糖色，锅里没有结晶"
    },
    {
      "n": 5,
      "text": "沿锅边淋料酒与生抽，加姜片、八角、桂皮翻匀出香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "酱汁裹住肉再加水，颜色才亮不透水味。",
      "visual_cue": "肉块色泽深红发亮，香料香气散出"
    },
    {
      "n": 6,
      "text": "连汁倒入砂锅，加花生与高汤没过食材，大火烧开转小火。",
      "time_min": 5,
      "heat": "大火",
      "tip": "花生要提前泡过，否则炖再久也不粉。",
      "visual_cue": "液面高过食材两指，汤色红亮"
    },
    {
      "n": 7,
      "text": "小火慢炖一小时，炖到猪蹄皮糯、花生一抿就化。",
      "time_min": 60,
      "heat": "小火",
      "tip": "汤面保持微沸，火大了汤会浑也不好收汁。",
      "visual_cue": "筷子能轻松插入皮肉，花生外皮自然绽开"
    },
    {
      "n": 8,
      "text": "开盖转中火收汁，加盐调味，汤汁挂勺即可关火。",
      "time_min": 8,
      "heat": "中火",
      "tip": "收汁时人要守着勤翻，糖分重很容易糊底发苦。",
      "visual_cue": "汤汁浓稠挂勺，表面油亮不流散"
    }
  ],
  "tips": [
    "猪蹄选前蹄肉多筋粗，炖出来更糯更香。",
    "花生换成板栗同炖，口感同样粉糯。",
    "砂锅炖的保温好，关火后焖十分钟更入味。",
    "剩下的汤汁拌面，比什么浇头都实在。"
  ],
  "common_mistakes": [
    "猪蹄没焯水直接炖，整锅带明显腥味。",
    "炒糖色火太大，糖一下锅就发苦变黑。",
    "收汁时不看火，转身拿个盘子的工夫就粘锅发焦。"
  ],
  "substitutions": [
    {
      "original": "花生",
      "substitute": "板栗",
      "ratio": "120克:150克",
      "note": "炖的时间可缩短十分钟。"
    },
    {
      "original": "猪蹄",
      "substitute": "猪肘",
      "ratio": "900克:900克",
      "note": "皮更厚，需多炖二十分钟。"
    }
  ],
  "variations": [
    "加一把泡开的黄豆同炖，口感更丰富。",
    "收汁前加一勺腐乳汁，咸鲜里带豆香，更有徽州味道。"
  ],
  "serving_suggestion": "连砂锅直接上桌，汤汁拌白米饭是最下饭的吃法。",
  "storage": "冷藏三天，冷冻一个月，复热时加点高汤稀释。",
