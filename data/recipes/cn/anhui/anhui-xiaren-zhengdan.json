  "equipment": [
    "蒸锅",
    "深盘",
    "细筛",
    "保鲜膜",
    "碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁用料酒、姜丝与白胡椒抓匀，腌十分钟去掉腥味。",
      "time_min": 11,
      "heat": "无火",
      "tip": "虾仁腌过再蒸，腥气不会跑进蛋羹里。",
      "visual_cue": "虾仁发亮，姜丝均匀"
    },
    {
      "n": 2,
      "text": "鸡蛋打进碗里，加盐用筷子沿一个方向搅散成均匀蛋液。",
      "time_min": 3,
      "heat": "无火",
      "tip": "别打出太多泡沫，蒸完表面全是麻点。",
      "visual_cue": "蛋液均匀，色橙黄"
    },
    {
      "n": 3,
      "text": "按一份蛋液配一点五份温水，慢慢倒进蛋液里搅匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "水温四十度左右最好，热水会把蛋烫成絮。",
      "visual_cue": "蛋水融合，色浅黄"
    },
    {
      "n": 4,
      "text": "蛋液过筛两遍，滤掉泡沫与未打散的蛋清，倒进深盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过筛这步决定成品细不细，最多两遍就够。",
      "visual_cue": "蛋液顺滑，表面无泡"
    },
    {
      "n": 5,
      "text": "深盘盖上保鲜膜，用牙签扎几个小孔，蒸锅水开后放进去。",
      "time_min": 4,
      "heat": "大火",
      "tip": "盖膜能防蒸汽滴落，蛋面才会像镜面。",
      "visual_cue": "膜面绷平，水已沸腾"
    },
    {
      "n": 6,
      "text": "转中小火蒸八分钟，让蛋液慢慢凝固成嫩滑的布丁质地。",
      "time_min": 9,
      "heat": "小火",
      "tip": "火大蛋液会起蜂窝，口感粗糙发老。",
      "visual_cue": "蛋面凝固，晃动微颤"
    },
    {
      "n": 7,
      "text": "揭开保鲜膜，把腌好的虾仁摆上去，重新盖好再蒸四分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "虾仁后放才不会沉底，也保持弹牙。",
      "visual_cue": "虾仁卷曲变红，蛋面平滑"
    },
    {
      "n": 8,
      "text": "出锅淋生抽与香油，撒葱花，温热时端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "酱油淋在边缘更均匀，葱花用余温烫香。",
      "visual_cue": "蛋面光亮，虾仁透红"
    }
  ],
  "tips": [
    "蛋液和水的比例按重量算一点五倍，蒸出来最嫩。",
    "蒸锅盖子留一条小缝，能防止锅内温度过高。",
    "用浅盘比深碗更容易蒸透，八分钟就够。",
    "虾仁换成鲜香菇片，做成纯素的蒸蛋也很好吃。"
  ],
  "common_mistakes": [
    "大火猛蒸，蛋羹起满蜂窝孔，口感像海绵。",
    "不盖保鲜膜，蒸汽滴落砸出凹坑，表面坑坑洼洼。",
    "水加太多，蛋液蒸一小时仍不成型。"
  ],
  "substitutions": [
    {
      "original": "温水",
      "substitute": "高汤",
      "ratio": "270毫升:270毫升",
      "note": "鲜味更足，盐量可减一克。"
    },
    {
      "original": "虾仁",
      "substitute": "蟹肉",
      "ratio": "100克:100克",
      "note": "鲜味更浓，蒸制时间减一分钟。"
    }
  ],
  "variations": [
    "加一勺蒸熟的南瓜泥在底部，做成颜色漂亮的两层蒸蛋。",
    "表面铺几片火腿与香菇，做成宴客版的蒸蛋。"
  ],
  "serving_suggestion": "两人份主菜或配菜，配白米饭与青菜，适合老人和小孩食用。",
  "storage": "建议现蒸现吃，冷藏不超过一天；复蒸需盖膜小火三分钟，久热会出水。",
  "nutrition_estimate": {
    "basis": "按两人份估算",
