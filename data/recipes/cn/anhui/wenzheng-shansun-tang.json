  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "竹笋",
          "name_en": "bamboo shoot",
          "amount": 400,
          "unit": "g",
          "note": "问政山笋最佳，取嫩尖",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "火腿",
          "name_en": "ham",
          "amount": 80,
          "unit": "g",
          "note": "金华火腿，切薄片",
          "optional": false
        },
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 500,
          "unit": "ml",
          "note": "清鸡汤",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 500,
          "unit": "ml",
          "note": "稀释汤底",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 10,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "火腿有咸味，少放",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "汤勺",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "春笋剥去外壳，削掉根部老硬部分，切成大小均匀的滚刀块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "笋根老硬部分要去净，否则汤发苦。",
      "visual_cue": "笋块大小一致、断面白净"
    },
    {
      "n": 2,
      "text": "春笋冷水下锅焯 5 分钟，捞出用清水冲净涩味。",
      "time_min": 6,
      "heat": "大火",
      "tip": "冷水下锅焯，涩味才能跟着水走。",
      "visual_cue": "笋块微透、闻着不冲鼻"
    },
    {
      "n": 3,
      "text": "火腿切成薄片，姜切片，小葱切成葱花备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "火腿片切薄些，味道出得快。",
      "visual_cue": "火腿片切得薄而均匀"
    },
    {
      "n": 4,
      "text": "砂锅放鸡汤与清水、姜片烧开，下火腿转小火煮 20 分钟出味。",
      "time_min": 22,
      "heat": "小火",
      "tip": "火腿先煮出鲜味，汤底才厚。",
      "visual_cue": "汤色微黄、火腿香味散出"
    },
    {
      "n": 5,
      "text": "下春笋小火炖 10 分钟，加盐调味，撒小葱即可上桌。",
      "time_min": 12,
      "heat": "小火",
      "tip": "盐最后放，笋的清香才不被盖。",
      "visual_cue": "汤清见底、笋块嫩黄"
    }
  ],
  "tips": [
    "笋块先焯水去涩，这一步千万省不得。",
    "火腿先煮出鲜味再下春笋，汤才够厚。",
    "盐要最后放，鲜味才不被咸味压住。"
  ],
  "common_mistakes": [
    "春笋没焯水直接煮，汤发涩发苦。",
    "全程大火猛煮，汤色浑白、鲜味尽失。",
    "盐放得太早，笋的清甜全被盖住。"
  ],
  "substitutions": [
    {
      "original": "春笋",
      "substitute": "冬笋",
      "ratio": "400g 对 400g",
      "note": "冬笋更紧实，需多炖 5 分钟。"
    },
    {
      "original": "鸡汤",
      "substitute": "清水",
      "ratio": "500ml 对 500ml",
      "note": "鲜味稍淡，可加 2g 盐补味。"
    }
  ],
  "variations": [
    "火腿换咸肉：咸度更高，盐可省去。",
    "加百叶结：出锅前 5 分钟加 100g 百叶结，口感更丰富。"
  ],
  "serving_suggestion": "趁热连汤带笋盛入汤碗，饭前喝一碗最开胃。",
  "storage": "冷藏 2 天，复热小火煮开即可，笋久放会变酸。",
