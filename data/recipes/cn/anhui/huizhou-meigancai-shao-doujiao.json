  "steps": [
    {
      "n": 1,
      "text": "豇豆掐去两头，掰成五厘米长的段。这一步不要着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "掰断比刀切更入味。，注意火候。",
      "visual_cue": "豆段匀齐，纤维撕净，状态稳定"
    },
    {
      "n": 2,
      "text": "梅干菜泡二十分钟洗净，挤干切碎。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "洗净泥沙，咸味也更柔。，注意火候。",
      "visual_cue": "菜末黑亮，水清，状态稳定"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，五花肉切小丁冷锅小火煸出油。",
      "time_min": 6,
      "heat": "小火",
      "tip": "煸出油再炒豆角，豆角才不寡。，注意火候。",
      "visual_cue": "肉丁出油，微黄焦香，状态稳定"
    },
    {
      "n": 4,
      "text": "下蒜片和干辣椒段小火炒香。这一步不要着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒别炒黑，会发苦。，注意火候。",
      "visual_cue": "蒜片微黄，辣香散出，状态稳定"
    },
    {
      "n": 5,
      "text": "倒豇豆大火翻炒到表皮起皱发深绿。这一步不要着急。",
      "time_min": 6,
      "heat": "大火",
      "tip": "豆角炒到起皱，口感才不水。，注意火候。",
      "visual_cue": "表皮起皱，颜色转深，状态稳定"
    },
    {
      "n": 6,
      "text": "放梅干菜碎一起翻炒一分钟。这一步不要着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "菜和豆角炒匀，味道才融合。，注意火候。",
      "visual_cue": "菜末沾匀，锅底干爽，状态稳定"
    },
    {
      "n": 7,
      "text": "加生抽、白糖和盐，倒清水盖锅焖十分钟。这一步不要着急。",
      "time_min": 12,
      "heat": "中火",
      "tip": "焖到豆角软透，才不生涩。，注意火候。",
      "visual_cue": "豆角变软，汤汁减少，状态稳定"
    },
    {
      "n": 8,
      "text": "开盖大火收汁，汤汁挂在豆角上即可。这一步不要着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁要快翻，别糊底。，注意火候。",
      "visual_cue": "汤汁浓亮，豆角油润，状态稳定"
    }
  ],
  "tips": [
    "豇豆炒到起皱再焖，口感才不水。，值得留意。",
    "梅干菜洗两遍，咸味才不压主味。，值得留意。",
    "焖透再收汁，豆角才不生涩。，值得留意。"
  ],
  "common_mistakes": [
    "豆角没焖透，吃着生涩。，值得留意。",
    "梅干菜放太多，整盘齁咸。，值得留意。",
    "大火收汁不翻，锅底结焦。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "豇豆",
      "substitute": "四季豆",
      "ratio": "500 克:500 克",
      "note": "更脆，焖的时间加两分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "80 克:60 克",
      "note": "咸香更浓，盐要减半。"
    }
  ],
  "variations": [
    "加几片土豆同焖，吸味更足。，值得留意。",
    "放一小勺豆瓣酱，咸辣更下饭。，值得留意。"
  ],
  "serving_suggestion": "配白米饭，汤汁拌饭最香。，效果更稳定。",
  "storage": "冷藏两天，复热下锅加少量水翻炒。，效果更稳定。",
