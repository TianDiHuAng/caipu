  "equipment": [
    "砂锅",
    "平底锅",
    "刀",
    "砧板",
    "木铲",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成一厘米厚的方块，铺在厨房纸上压十分钟吸走表面水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "压过水的豆腐煎时不易碎，也更好吸味。",
      "visual_cue": "豆腐干爽，表面无积水"
    },
    {
      "n": 2,
      "text": "平底锅倒三十毫升花生油，中火把豆腐两面各煎三分钟至微黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "一面结壳再翻动，急着翻就会散。",
      "visual_cue": "两面金黄，边缘挺立"
    },
    {
      "n": 3,
      "text": "咸肉切薄片，冷锅小火干煸两分钟至边缘卷起出油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "咸肉先煸出油，砂锅的底味全靠它。",
      "visual_cue": "肉片透明卷边，油清亮"
    },
    {
      "n": 4,
      "text": "砂锅放少许底油，下姜片与咸肉片炒香，再下香菇与冬笋翻炒。",
      "time_min": 5,
      "heat": "中火",
      "tip": "冬笋先炒过能去掉涩味，汤更清甜。",
      "visual_cue": "菌笋断生，香气升起"
    },
    {
      "n": 5,
      "text": "淋料酒与生抽炒匀，倒入高汤煮开，转小火煮五分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "高汤要热着倒，砂锅骤冷骤热容易裂。",
      "visual_cue": "汤面翻滚，酱色均匀"
    },
    {
      "n": 6,
      "text": "把煎好的豆腐块轻轻码进砂锅，加葱结，小火炖十分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "轻放轻推，豆腐才不散成碎渣。",
      "visual_cue": "豆腐微鼓，汤汁渐浓"
    },
    {
      "n": 7,
      "text": "加盐与白胡椒调味，放青蒜段继续炖两分钟至香气透出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "青蒜最后下，久炖会发黄发软。",
      "visual_cue": "蒜叶翠绿，汤面泛油"
    },
    {
      "n": 8,
      "text": "挑出葱结，连砂锅端上桌，趁滚烫时盛到碗里。",
      "time_min": 2,
      "heat": "无火",
      "tip": "砂锅上桌保温久，越吃越入味。",
      "visual_cue": "汤汁微滚，豆腐完整"
    }
  ],
  "tips": [
    "豆腐选质地紧实的老豆腐，煎得住也炖不烂，不容易碎成渣。",
    "咸肉本身有咸味，加盐前先尝一口汤。",
    "加一勺猪油同炖，汤更浓更香，是徽州老做法。",
    "剩下的汤汁别倒，拌一碗白米饭最能尝出咸肉和笋的鲜味。"
  ],
  "common_mistakes": [
    "豆腐不压水就煎，下锅粘底碎成渣。",
    "砂锅空烧或骤加冷汤，锅体开裂漏汤。",
    "炖的时间太短，豆腐里面还是白味。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "火腿",
      "ratio": "60克:60克",
      "note": "咸度更高，盐量须减少。"
    },
    {
      "original": "冬笋",
      "substitute": "笋干",
      "ratio": "100克:50克",
      "note": "须提前泡发六小时，炖制时间加十分钟。"
    }
  ],
  "variations": [
    "加几只虾仁同炖，鲜味更足，是徽州宴席上的做法。",
    "把豆腐换成冻豆腐，孔隙更多，吸饱汤后一咬就爆汁。"
  ],
  "serving_suggestion": "三人份主菜，配米饭最下饭，也可作为火锅前的暖锅小菜。",
  "storage": "冷藏两天内吃完，复热须小火慢炖并补少量高汤；豆腐久放易发酸，不建议冷冻后再炖。",
