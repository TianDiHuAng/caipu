  },
  "servings": 4,
  "flavor": [
    "savory",
    "smoky",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 300,
          "unit": "g",
          "note": "粗磨",
          "optional": false
        },
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 100,
          "unit": "g",
          "note": "增加筋性",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "腊肉",
          "name_en": "cured pork",
          "amount": 80,
          "unit": "g",
          "note": "切小丁",
          "optional": false
        },
        {
          "name": "雪菜",
          "name_en": "pickled potherb mustard",
          "amount": 100,
          "unit": "g",
          "note": "切碎",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 260,
          "unit": "ml",
          "note": "和面",
          "optional": false
        },
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 20,
          "unit": "ml",
          "note": "煎制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "拌盆",
    "擀面杖",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米粉与面粉一起倒进拌盆，加盐后用筷子反复搅匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "两粉混匀，饼才不散也不硬。",
      "visual_cue": "粉体淡黄，盐粒分布均匀"
    },
    {
      "n": 2,
      "text": "清水烧到烫手，分次倒入粉中，边倒边搅成絮状。",
      "time_min": 5,
      "heat": "无火",
      "tip": "热水烫面，玉米粉才不噎人。",
      "visual_cue": "粉团成粗絮，冒着热气"
    },
    {
      "n": 3,
      "text": "揉成光滑面团，盖上湿布放在一旁醒二十分钟备用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "醒过面团更柔，擀开不易裂。",
      "visual_cue": "面团按下去缓慢回弹"
    },
    {
      "n": 4,
      "text": "腊肉切成指尖大小的丁，雪里蕻挤干水分后切成碎末。",
      "time_min": 8,
      "heat": "无火",
      "tip": "雪里蕻挤干，馅才不会出水。",
      "visual_cue": "腊肉丁油亮，菜碎干爽"
    },
    {
      "n": 5,
      "text": "平底锅不放油，把腊肉丁小火煸出油，再下雪里蕻炒香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "腊肉煸出油，馅才润而不腻。",
      "visual_cue": "锅内油亮，香味直冒"
    },
    {
      "n": 6,
      "text": "炒好的馅盛进碗里晾凉，再平均分成四份备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "馅太烫会把面皮烫破。",
      "visual_cue": "馅料成团，微微冒油"
    },
    {
      "n": 7,
      "text": "面团分成四块，擀成圆片，包入馅料后压成扁饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "边缘捏薄再压，切口才不厚。",
      "visual_cue": "饼坯圆整，厚薄均匀"
    },
    {
      "n": 8,
      "text": "平底锅刷花生油，饼坯下锅小火煎到底面金黄。",
      "time_min": 6,
      "heat": "小火",
      "tip": "火小一点，饼坯才不会外焦里生。",
      "visual_cue": "底面结出金黄硬壳"
    },
    {
      "n": 9,
      "text": "翻面再煎五分钟，等两面都煎出焦香硬壳后出锅。",
      "time_min": 5,
      "heat": "小火",
      "tip": "两面都煎透，饼心才熟。",
      "visual_cue": "两面金黄，敲着发脆"
    },
    {
      "n": 10,
      "text": "趁热用刀切成四瓣，摆进盘中，趁热端上桌开吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热切，饼皮才不会碎。",
      "visual_cue": "切面层次分明，馅料外露"
    }
  ],
  "tips": [
    "玉米粉先用热水烫过，饼才软而不噎，凉了也不发硬。",
    "腊肉先煸出油再炒菜，馅料自带油香，不用另加调料。",
    "全程小火慢煎，饼厚心不容易夹生。"
  ],
  "common_mistakes": [
    "只用玉米粉不加面粉，饼一压就裂，翻面即散。",
    "火开太大，外壳焦黑，里面还是生粉味。",
    "雪里蕻不挤水直接包，煎的时候出水，饼皮全烂。"
  ],
  "substitutions": [
    {
      "original": "雪里蕻",
      "substitute": "霉干菜",
      "ratio": "100 克:60 克",
      "note": "咸味更重，盐要减半。"
    },
    {
      "original": "腊肉",
      "substitute": "火腿",
      "ratio": "80 克:80 克",
      "note": "咸鲜更清，油香略薄，需多加半勺油。"
    }
  ],
  "variations": [
    "馅里加一把炒香的芝麻，香气更足。",
    "用猪油代替花生油煎，饼底更酥更香。"
  ],
  "serving_suggestion": "配一碗热粥或一碗笋汤，山里人的早饭就齐了。",
  "storage": "冷藏两天，复热时用平底锅小火干烙，饼皮能回脆。",
