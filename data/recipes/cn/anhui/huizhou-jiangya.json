    }
  ],
  "variations": [
    "加几片山楂，肉烂得更快。，值得留意。",
    "卤汁留起来卤鸡蛋，风味很足。，值得留意。"
  ],
  "serving_suggestion": "冷切装盘，配黄酒或米饭。，效果更稳定。",
  "storage": "冷藏三天，冷冻两周；复热蒸十分钟。，效果更稳定。",
