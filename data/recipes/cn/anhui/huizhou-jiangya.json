  "steps": [
    {
      "n": 1,
      "text": "鸭洗净擦干，用盐和料酒里外抹匀腌二十分钟。这一步别着急。",
      "time_min": 25,
      "heat": "无火",
      "tip": "皮要擦干，煎的时候才不溅油。，注意火候。",
      "visual_cue": "鸭皮干爽，盐粒均匀，状态稳定"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，鸭皮朝下小火煎到金黄。这一步别着急。",
      "time_min": 8,
      "heat": "小火",
      "tip": "煎出皮下脂肪，酱鸭才不腻。，注意火候。",
      "visual_cue": "鸭皮金黄，油脂析出，状态稳定"
    },
    {
      "n": 3,
      "text": "翻面略煎，把鸭身各面都煎上色。这一步别着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "边角也要煎到，颜色才匀。，注意火候。",
      "visual_cue": "通体浅褐，皮面收紧，状态稳定"
    },
    {
      "n": 4,
      "text": "下姜片、八角、桂皮、香叶和花椒炒香。这一步别着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料遇油才出味。，注意火候。",
      "visual_cue": "香气浓，锅底干爽，状态稳定"
    },
    {
      "n": 5,
      "text": "烹入料酒，加生抽、老抽和冰糖。这一步别着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "冰糖先化开，酱色才亮。，注意火候。",
      "visual_cue": "糖化开，酱汁红亮，状态稳定"
    },
    {
      "n": 6,
      "text": "倒清水没过鸭身三分之二，大火烧开。这一步别着急。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水量别太少，焖的过程中会收。，注意火候。",
      "visual_cue": "汤面翻滚，鸭身浮起，状态稳定"
    },
    {
      "n": 7,
      "text": "转小火盖盖焖五十分钟，中途翻一次面。这一步别着急。",
      "time_min": 52,
      "heat": "小火",
      "tip": "翻面让上下入味均匀。，注意火候。",
      "visual_cue": "鸭肉变软，汤汁减少，状态稳定"
    },
    {
      "n": 8,
      "text": "开盖中火收汁，边收边把酱汁淋在鸭身上。这一步别着急。",
      "time_min": 8,
      "heat": "中火",
      "tip": "淋汁让表面挂色，别糊底。，注意火候。",
      "visual_cue": "表皮油亮，酱汁浓稠，状态稳定"
    },
    {
      "n": 9,
      "text": "晾到温热后斩块，淋上锅里剩的酱汁。这一步别着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "凉一点再斩，块才不散。，注意火候。",
      "visual_cue": "块形整齐，酱色深厚，状态稳定"
    }
  ],
  "tips": [
    "鸭皮擦干再煎，才不会溅油。，值得留意。",
    "小火焖足五十分钟，肉才离骨。，值得留意。",
    "晾温再斩块，切面才整齐。，值得留意。"
  ],
  "common_mistakes": [
    "大火焖煮，鸭皮破裂肉发柴。，值得留意。",
    "收汁不收，酱汁寡淡挂不住。，值得留意。",
    "热的时候斩，肉全散开。，值得留意。"
  ],
