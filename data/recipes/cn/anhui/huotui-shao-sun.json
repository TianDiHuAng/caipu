  ],
  "equipment": [
    "炒锅",
    "漏勺",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "竹笋剥壳去老根，切滚刀块；火腿用温水洗一遍，切薄片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "火腿表面有一层氧化油，温水洗掉才不腥。",
      "visual_cue": "火腿片色红油亮、厚薄一致"
    },
    {
      "n": 2,
      "text": "笋块冷水下锅焯 5 分钟去涩，捞出沥干。",
      "time_min": 6,
      "heat": "大火",
      "tip": "笋焯水必须从冷水开始，涩味才能随水温升出。",
      "visual_cue": "笋块颜色转微黄、无麻涩味"
    },
    {
      "n": 3,
      "text": "炒锅下 25ml 植物油，小火煸香姜片与葱段，下火腿片煎到边缘卷曲出油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "火腿先煎出油，笋才有肉香。",
      "visual_cue": "火腿边缘微卷、锅底有红油"
    },
    {
      "n": 4,
      "text": "下笋块翻炒 2 分钟，烹料酒，加高汤与冰糖，烧开后转小火焖 12 分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "汤量到笋块一半即可，收汁后味更浓。",
      "visual_cue": "汤汁收到一半、笋块吸饱汤色"
    },
    {
      "n": 5,
      "text": "加 2g 盐调味，淋淀粉水勾薄芡，撒葱段出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "火腿本身够咸，盐先尝后放。",
      "visual_cue": "汤汁挂勺、笋块油润发亮"
    }
  ],
  "tips": [
    "金华火腿偏咸，用量控制在 80g 以内，切片后先焯水可减咸。",
    "用火腿骨与笋一起焖，鲜味更厚，汤也更清。",
    "笋选春笋更嫩，冬笋需多焖 5 分钟。"
  ],
  "common_mistakes": [
    "火腿不洗直接下锅，成品带哈喇味。",
    "笋块不焯水直接烧，吃起来麻嘴发涩。",
    "大火收汁过久，火腿变硬、笋块发柴。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "腊肉",
      "ratio": "80g 火腿 ≈ 90g 腊肉",
      "note": "腊肉更咸，盐可完全省略。"
    },
    {
      "original": "竹笋",
      "substitute": "莴笋",
      "ratio": "450g 竹笋 ≈ 400g 莴笋",
      "note": "莴笋易熟，焖制时间减到 5 分钟。"
    }
  ],
  "variations": [
    "家庭简化版：用真空水煮笋省去焯水，直接煸炒焖制。",
    "汤菜版：高汤加到 600ml，做成火腿笋汤，更适合冬季。"
  ],
  "serving_suggestion": "配米饭，汤汁拌饭；也可作为宴客菜中的素荤搭配。",
  "storage": "冷藏 2 天，复热加 50ml 高汤小火焖 3 分钟。",
