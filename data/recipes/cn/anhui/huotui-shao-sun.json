          "name_en": "scallion",
          "amount": 12,
          "unit": "g",
          "note": "切段",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 8,
          "unit": "g",
          "note": "切片",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 250,
          "unit": "ml",
          "note": "火腿骨或鸡骨吊的汤",
