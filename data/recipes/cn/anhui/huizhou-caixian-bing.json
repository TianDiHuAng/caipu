  "equipment": [
    "平底锅",
    "擀面杖",
    "和面盆",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒进盆里，分次加入温水，用筷子搅成絮状再揉成团。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面团和得软一点，擀的时候才不容易破。",
      "visual_cue": "面团柔软不粘手，按压留浅坑"
    },
    {
      "n": 2,
      "text": "面团盖上湿布静置醒二十分钟，让面筋彻底松弛下来。",
      "time_min": 20,
      "heat": "无火",
      "tip": "醒够时间再擀，饼皮才不会回缩变形。",
      "visual_cue": "面团明显更软，按下去回弹缓慢"
    },
    {
      "n": 3,
      "text": "小白菜洗净切碎，撒一点盐抓匀腌五分钟，再用手挤干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水分挤得干净，包的时候才不会漏汤。",
      "visual_cue": "菜碎颜色转深，捏成团不滴水"
    },
    {
      "n": 4,
      "text": "香菇丁下锅用花生油炒一分钟，再加入豆腐碎炒到微干。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香菇炒过才出香，豆腐炒干一点不出水。",
      "visual_cue": "锅里没有明显水汽，馅料松散发香"
    },
    {
      "n": 5,
      "text": "把菜碎、炒好的香菇豆腐与葱花拌在一起，加盐与香油调匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐一定要最后放，放早了菜会一直出水，馅就稀了。",
      "visual_cue": "馅料抱团而不湿黏，闻起来清香"
    },
    {
      "n": 6,
      "text": "面团分成六个剂子，擀成圆皮，放一勺馅对折捏紧边缘。",
      "time_min": 10,
      "heat": "无火",
      "tip": "边缘捏两道褶，煎的时候馅汁才不会漏。",
      "visual_cue": "半月形饼胚饱满，边缘封口严密"
    },
    {
      "n": 7,
      "text": "平底锅刷油小火煎，每面煎三分钟到金黄鼓起。",
      "time_min": 6,
      "heat": "小火",
      "tip": "用小火慢慢煎，皮熟透了里面的馅也刚好热透。",
      "visual_cue": "两面金黄带焦斑，饼身微微鼓起"
    }
  ],
  "tips": [
    "馅里加一把炒香的芝麻，香气更足。",
    "煎的时候盖一下锅盖，饼皮更软。",
    "面团里加一勺猪油，煎出来更酥。",
    "剩下的馅可以炒成小菜，不浪费。"
  ],
  "common_mistakes": [
    "菜馅没挤水就包，煎的时候汁水把饼皮泡破。",
    "火太大下锅，饼皮焦了里面还是生面。",
    "面团没醒够就擀，一擀就缩回去擀不开。"
  ],
  "substitutions": [
    {
      "original": "小白菜",
      "substitute": "菠菜",
      "ratio": "250克:250克",
      "note": "需焯水后再切，涩味更少。"
    },
    {
      "original": "北豆腐",
      "substitute": "香干",
      "ratio": "100克:90克",
      "note": "口感更硬，咸味更足。"
    }
  ],
  "variations": [
    "馅里加一小把炒碎的鸡蛋，口感层次会更丰富些。",
    "改用烫面做皮，可以做成皮更薄、边缘更脆的菜盒子。"
  ],
  "serving_suggestion": "趁热配一碗小米粥，就是很清爽又顶饱的一顿。",
  "storage": "冷藏两天，回锅小火干煎三分钟就能恢复表面的酥脆。",
