  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍，泡二十分钟后沥干。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过的米焖出来更松。，注意火候。",
      "visual_cue": "米粒饱满，水清，状态稳定"
    },
    {
      "n": 2,
      "text": "梅干菜泡三十分钟洗净，挤干切碎。这一步不要着急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "多洗几遍去泥沙，咸味也更柔。，注意火候。",
      "visual_cue": "菜末黑亮，水不浑，状态稳定"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，五花肉切小丁冷锅小火煸到出油微黄。",
      "time_min": 7,
      "heat": "小火",
      "tip": "煸出油再炒菜，饭才香。，注意火候。",
      "visual_cue": "肉丁出油，边缘焦黄，状态稳定"
    },
    {
      "n": 4,
      "text": "下香菇丁炒出香味，再放梅干菜碎翻炒。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香菇先炒，鲜味才出来。，注意火候。",
      "visual_cue": "香菇软塌，香气浓，状态稳定"
    },
    {
      "n": 5,
      "text": "加生抽、老抽和盐炒匀，倒入大米翻拌。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米粒裹上油和酱油，焖出来才匀。，注意火候。",
      "visual_cue": "米粒着色，油亮，状态稳定"
    },
    {
      "n": 6,
      "text": "全部转进电饭锅，加清水没过米面一厘米。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水量比白饭略少，菜里有汁。，注意火候。",
      "visual_cue": "水面齐平，米粒平整，状态稳定"
    },
    {
      "n": 7,
      "text": "按下煮饭键，跳起后再焖十分钟。这一步不要着急。",
      "time_min": 40,
      "heat": "无火",
      "tip": "跳起别立刻开盖，焖十分钟更透。，注意火候。",
      "visual_cue": "锅内无水声，香气溢出"
    },
    {
      "n": 8,
      "text": "开盖撒小葱末，用饭勺从底翻松。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻松让水汽散掉，饭才不粘。，注意火候。",
      "visual_cue": "米粒分明，油亮松散，状态稳定"
    }
  ],
  "tips": [
    "米先泡过，焖出来才松软。，值得留意。",
    "梅干菜多洗几遍，饭才不牙碜。，值得留意。",
    "水量比白饭少一点，菜会出水。，值得留意。"
  ],
  "common_mistakes": [
    "水放太多，焖成糊状。，值得留意。",
    "梅干菜没挤干，饭发苦。，值得留意。",
    "跳起立刻开盖，饭心还硬。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "150 克:120 克",
      "note": "咸香更浓，盐要减。"
    },
    {
      "original": "梅干菜",
      "substitute": "萝卜干",
      "ratio": "80 克:100 克",
      "note": "口感更脆，甜味不同。"
    }
  ],
  "variations": [
    "加几粒板栗同焖，甜香更足。，值得留意。",
    "用砂锅小火焖，锅巴更香。，值得留意。"
  ],
  "serving_suggestion": "配一碗青菜汤，就是徽州人家的一顿家常饭。",
  "storage": "冷藏两天，复热加一勺水微波或蒸十分钟。，效果更稳定。",
