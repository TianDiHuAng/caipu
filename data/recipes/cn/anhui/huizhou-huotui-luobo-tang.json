          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切花点缀",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "削皮刀",
    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "火腿用温水刷洗干净表皮，切成半厘米厚的薄片备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表皮刷干净，汤才不发黑也不带哈喇味。",
      "visual_cue": "火腿片肥瘦分明，表面没有灰白污渍"
    },
    {
      "n": 2,
      "text": "白萝卜削皮切成滚刀块，块头比火腿稍大一些。",
      "time_min": 6,
      "heat": "无火",
      "tip": "萝卜块大一点，久炖才不会化在汤里。",
      "visual_cue": "萝卜块棱角分明，大小相差不大"
    },
    {
      "n": 3,
      "text": "水烧开放火腿片焯一分钟，去掉表面的浮油与杂质。",
      "time_min": 3,
      "heat": "大火",
      "tip": "焯过一遍汤色会更清亮，火腿的咸味也能降下来一点。",
      "visual_cue": "水面浮起一层油沫，火腿颜色变亮"
    },
    {
      "n": 4,
      "text": "砂锅里放火腿、姜片与料酒，倒入高汤大火煮开。",
      "time_min": 5,
      "heat": "大火",
      "tip": "冷水下锅，火腿的咸味更容易一点点浸到汤里。",
      "visual_cue": "汤面滚开，飘出火腿与姜的香气"
    },
    {
      "n": 5,
      "text": "转小火盖上盖子炖三十分钟，让火腿的咸鲜慢慢融进汤里。",
      "time_min": 30,
      "heat": "小火",
      "tip": "这半小时决定底味的厚薄，别急着下萝卜。",
      "visual_cue": "汤色转为浅琥珀色，水面油花细碎"
    },
    {
      "n": 6,
      "text": "放入白萝卜块继续炖二十分钟，炖到萝卜能用筷子轻松戳穿。",
      "time_min": 20,
      "heat": "小火",
      "tip": "筷子一戳就透是熟透的标志，不是炖到散。",
      "visual_cue": "萝卜变得半透明，边缘圆润微塌"
    },
    {
      "n": 7,
      "text": "加盐调咸淡，撒上小葱碎，关火焖两分钟再盛出。",
      "time_min": 3,
      "heat": "无火",
      "tip": "火腿本身是咸的，先尝一口再决定要不要补盐。",
      "visual_cue": "汤清味鲜，萝卜透着琥珀色的光"
    }
  ],
  "tips": [
    "萝卜买水分足的白萝卜，炖完更甜更软。",
    "火腿皮别扔，切小块一起炖，汤头会变得更黏口。",
    "汤剩下第二天会更咸，复热时兑一点清水。",
    "撒一点白胡椒粉，暖胃的口感会更明显。"
  ],
  "common_mistakes": [
    "火腿没焯水直接炖，汤色发暗还带一股腥味。",
    "萝卜切得太小，炖到最后全化在汤里找不着。",
    "一开始就放盐，萝卜发苦而且不容易软烂。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "80克:90克",
      "note": "咸味更冲，炖的时间可缩短五分钟。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "1000毫升:1000毫升",
      "note": "鲜味变淡，可加两片干香菇提味。"
    }
  ],
  "variations": [
    "加一把泡开的黄豆同炖，口感更朴实。",
    "换成冬瓜同炖，汤更清爽，夏天喝起来也不腻。"
  ],
  "serving_suggestion": "热汤配一碗白米饭，或者放在最后当清口的汤水喝。",
  "storage": "冷藏三天，复热后加入新切的葱花香气更好。",
