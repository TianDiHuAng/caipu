  "steps": [
    {
      "n": 1,
      "text": "鲫鱼去鳞去内脏，刮净腹内黑膜，两面各打三刀方便入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黑膜一定要刮净，那是腥味主要来源。",
      "visual_cue": "鱼身干爽，刀口整齐"
    },
    {
      "n": 2,
      "text": "鱼身两面抹薄盐和黄酒，放姜片腌十分钟去腥。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌好要用厨房纸吸干水，煎时不易溅油。",
      "visual_cue": "鱼皮略干，表面不见水"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟倒植物油滑锅，鲫鱼下锅中小火煎到两面金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "下锅后别翻，等鱼皮结硬壳再动。",
      "visual_cue": "鱼皮完整焦黄，晃动锅会滑动"
    },
    {
      "n": 4,
      "text": "鱼推到锅边，下姜蒜和干辣椒段炒香，沿锅边烹黄酒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "黄酒沿锅边淋下，香气才冲得起来不腥。",
      "visual_cue": "闻到酒香，油面微起沫"
    },
    {
      "n": 5,
      "text": "加生抽、老抽、白糖、陈醋和清水，大火烧开转中小火焖。",
      "time_min": 1,
      "heat": "大火",
      "tip": "醋少量能去腥提鲜，别放多以免发酸。",
      "visual_cue": "汤汁深红，没过鱼身一半"
    },
    {
      "n": 6,
      "text": "中途用勺舀汤汁浇在鱼身上，不要翻鱼免得破碎。",
      "time_min": 10,
      "heat": "中小火",
      "tip": "浇汁代替翻面，鱼形才完整好看。",
      "visual_cue": "汤汁收浓，鱼眼凸出变白"
    },
    {
      "n": 7,
      "text": "尝味补盐，撒葱段，收汁到浓稠即可连锅上桌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "收汁留一点浇饭最香，别收到锅底发干。",
      "visual_cue": "汤汁挂勺，鱼身油亮"
    }
  ],
  "tips": [
    "鱼身擦干再煎，皮才不破也不溅油。",
    "煎时中小火等结壳再翻，鱼形完整。",
    "用浇汁代替翻鱼，成菜不散不碎。"
  ],
  "common_mistakes": [
    "鱼皮带水下锅，油花四溅还破皮。",
    "频繁翻面，鱼身碎成块没法装盘。",
    "大火一直烧到汤汁全干，锅底发苦发糊。"
  ],
  "substitutions": [
    {
      "original": "鲫鱼",
      "substitute": "鲈鱼",
      "ratio": "700 克:700 克",
      "note": "刺少肉厚，烧制时间缩短五分钟。"
    },
    {
      "original": "陈醋",
      "substitute": "黄酒",
      "ratio": "8 毫升:15 毫升",
      "note": "酸味更柔，去腥效果相近。"
    }
  ],
  "variations": [
    "加几块豆腐同烧，吸味又添份量。",
    "放一勺豆瓣酱，酱香更浓更下饭。"
  ],
  "serving_suggestion": "连汁上桌，鱼肉蘸汤吃最鲜，配米饭一绝。",
  "storage": "冷藏一天，复热加少量水小火焖热，不要翻动鱼肉。",
