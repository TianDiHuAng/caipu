  "steps": [
    {
      "n": 1,
      "text": "鲜笋剥去外壳，削掉根部老硬的部分，切成长方薄片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "根部老硬的部分纤维粗，留着怎么炒都咬不动。",
      "visual_cue": "笋片厚薄均匀，断面白净无黑点"
    },
    {
      "n": 2,
      "text": "汤锅烧开水，把笋片下锅焯五分钟，捞出沥干水分备用。",
      "time_min": 7,
      "heat": "大火",
      "tip": "笋含草酸，焯水能去涩，不焯会发麻口。",
      "visual_cue": "笋片由白转透，涩味明显减轻"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下豆豉、蒜末、姜末与干辣椒段小火炒香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆豉要小火炒出酱香，火大了发苦，豆腥味也压不住。",
      "visual_cue": "豆豉散开，锅里浮起酱色油"
    },
    {
      "n": 4,
      "text": "倒入笋片转大火翻炒两分钟，让笋片均匀裹上豆豉的香气。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火快炒，笋片才脆，久炒会出水发软。",
      "visual_cue": "笋片油亮裹酱，锅底无积水"
    },
    {
      "n": 5,
      "text": "加生抽、白糖与盐调味，撒葱段翻匀后立刻出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆豉与生抽都咸，盐要最后试了再放。",
      "visual_cue": "笋片金黄透亮，葱段翠绿挺立"
    }
  ],
  "tips": [
    "笋挑外壳紧、掂着沉的，空心的切开全是洞。",
    "加几片腊肉同炒，油脂润笋，香得更足。",
    "豆豉选干爽油润的，发黏带酸味的不要用。"
  ],
  "common_mistakes": [
    "笋不焯水直接炒，涩味重还带麻，整盘难以下咽。",
    "豆豉大火爆炒，一下子焦苦，酱香全无。",
    "笋片切得太厚，外面已经入味，里面还是寡淡无味的。"
  ],
  "substitutions": [
    {
      "original": "鲜笋",
      "substitute": "冬笋",
      "ratio": "400克:400克",
      "note": "冬笋更嫩，焯水时间缩短到三分钟。"
    },
    {
      "original": "豆豉",
      "substitute": "豆瓣酱",
      "ratio": "20克:18克",
      "note": "豆瓣酱更辣，干辣椒可省去。"
    }
  ],
  "variations": [
    "加一把青椒丝同炒，辛香解腻，下饭更快。",
    "把笋换成笋干，须泡发一夜再炒，风味更浓。"
  ],
  "serving_suggestion": "作为下饭菜配粥或米饭都很合适，冷吃也别有风味。",
  "storage": "冷藏可存两天，复热须大火快炒一分钟，久煮笋会发韧。",
