    "light"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "冬瓜",
          "name_en": "winter melon",
          "amount": 500,
          "unit": "g",
          "note": "去皮切厚片",
          "optional": false
        },
        {
          "name": "火腿",
          "name_en": "ham",
          "amount": 150,
          "unit": "g",
          "note": "切薄片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 10,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "火腿咸，少放",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1200,
          "unit": "ml",
          "note": "煮汤",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "汤勺",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "火腿切薄片，用温水浸泡 15 分钟去掉部分咸味，捞出沥干。",
      "time_min": 17,
      "heat": "无火",
      "tip": "火腿偏咸，泡一下汤才不齁。",
      "visual_cue": "火腿片变软、水色微黄"
    },
    {
      "n": 2,
      "text": "冬瓜去皮去瓤，切成 1 厘米厚的片，姜切片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冬瓜切厚片，煮久了也不散。",
      "visual_cue": "冬瓜片厚薄一致、边缘整齐"
    },
    {
      "n": 3,
      "text": "汤锅加 1200ml 清水，放火腿片与姜片，大火煮开转小火炖 25 分钟。",
      "time_min": 28,
      "heat": "小火",
      "tip": "小火慢炖，火腿的鲜味才全出来。",
      "visual_cue": "汤色转奶白、火腿香气浓"
    },
    {
      "n": 4,
      "text": "放入冬瓜片，中火再煮 10 分钟至冬瓜透明。",
      "time_min": 11,
      "heat": "中火",
      "tip": "冬瓜煮到透亮就熟，别煮成糊。",
      "visual_cue": "冬瓜边缘透明、筷子可轻松插入"
    },
    {
      "n": 5,
      "text": "加 4g 盐与白胡椒粉调味，撒葱花后关火盛碗。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先尝汤再放盐，火腿咸度差别很大。",
      "visual_cue": "汤汁清亮带奶白、葱花翠绿"
    }
  ],
  "tips": [
    "火腿先泡温水，汤的咸度才好控制。",
    "冬瓜最后下，煮过头会化在汤里。",
    "盐一定要尝过再加，火腿本身很咸。"
  ],
  "common_mistakes": [
    "火腿不泡直接下锅，整锅汤咸得发苦。",
    "冬瓜和火腿同时下，冬瓜煮成泥。",
    "加味精提鲜，压掉了火腿本身的香气。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "150g 对 150g",
      "note": "咸度相近，泡水时间加 5 分钟。"
    },
    {
      "original": "冬瓜",
      "substitute": "节瓜",
      "ratio": "500g 对 500g",
      "note": "口感更紧实，煮制加 3 分钟。"
    }
  ],
  "variations": [
    "开洋版：加 20g 海米同炖，鲜味更厚。",
    "笋干版：加 50g 泡发笋干，做成徽州风味的腌笃鲜。"
  ],
  "serving_suggestion": "饭前一碗，配一碟咸菜，是徽州人家夏天的餐桌标配。",
  "storage": "冷藏 2 天，复热时补少量清水，勿反复烧开。",
