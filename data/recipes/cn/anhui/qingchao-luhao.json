  "equipment": [
    "炒锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芦蒿掐去老根与黄叶，只留嫩茎，掰成 5cm 段后用清水冲洗两遍。",
      "time_min": 8,
      "heat": "无火",
      "tip": "老根纤维粗，掐不动的一律丢掉。",
      "visual_cue": "芦蒿段翠绿挺直、断口有汁"
    },
    {
      "n": 2,
      "text": "洗净的芦蒿沥干水分，摊在漏勺里晾 5 分钟，避免带水下锅。",
      "time_min": 6,
      "heat": "无火",
      "tip": "带水下锅会溅油且炒不出锅气。",
      "visual_cue": "表面无水珠、摸起来干爽"
    },
    {
      "n": 3,
      "text": "炒锅烧至冒烟下 30ml 植物油，放蒜片与干辣椒段小火爆香 30 秒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蒜片微黄就够，焦了会发苦。",
      "visual_cue": "蒜片边缘金黄、油面起香"
    },
    {
      "n": 4,
      "text": "转大火倒入芦蒿快速翻炒 90 秒，让每根都裹上油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火快炒，芦蒿才脆不发黄。",
      "visual_cue": "芦蒿颜色转深绿、体积略缩"
    },
    {
      "n": 5,
      "text": "加 5g 盐、3g 白糖与 10ml 生抽，翻炒 30 秒后立即关火。",
      "time_min": 1,
      "heat": "大火",
      "tip": "盐最后放，早放会出水变成炖菜。",
      "visual_cue": "调味均匀、锅底无汤汁"
    },
    {
      "n": 6,
      "text": "起锅装盘，趁热食用，凉后清香气会明显减弱。",
      "time_min": 1,
      "heat": "无火",
      "tip": "这道菜讲究现炒现吃，别等。",
      "visual_cue": "芦蒿油亮翠绿、蒜片分散"
    }
  ],
  "tips": [
    "芦蒿买回来先掐老根，嫩茎才脆嫩无渣。",
    "全程大火不超过三分钟，久炒必黄。",
    "盐最后放，才能保持芦蒿的脆度。"
  ],
  "common_mistakes": [
    "芦蒿洗完不沥干直接下锅，油花四溅。",
    "小火慢炒几分钟，芦蒿蔫成一片草绳。",
    "生抽放太多，盖住芦蒿本身的清香。"
  ],
  "substitutions": [
    {
      "original": "芦蒿",
      "substitute": "茼蒿",
      "ratio": "500g 对 500g",
      "note": "香气更浓但更易出水，需大火快炒。"
    },
    {
      "original": "干辣椒",
      "substitute": "小米辣",
      "ratio": "5g 对 8g",
      "note": "辣味更鲜爽，适合爱吃辣的口味。"
    }
  ],
  "variations": [
    "芦蒿炒香干版：加 100g 五香豆干丝同炒，是江南家常做法。",
    "腊肉版：加 60g 腊肉薄片煸香后再炒，咸香下饭。"
  ],
  "serving_suggestion": "作为清口素菜配米饭，与红烧类菜肴同席最搭。",
  "storage": "不宜存放，冷藏一夜后香气与脆度都会明显下降。",
