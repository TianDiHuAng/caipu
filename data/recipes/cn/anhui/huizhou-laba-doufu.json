  "equipment": [
    "菜刀",
    "烤架",
    "烤箱",
    "蒸锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成两厘米厚的大方片，平铺在竹筛上晾去表面水汽。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆腐表面越干，后面越容易吸味。",
      "visual_cue": "豆腐边缘略微收干、不粘手"
    },
    {
      "n": 2,
      "text": "豆腐两面均匀抹上盐与白糖，静置半小时让水分渗出。",
      "time_min": 30,
      "heat": "无火",
      "tip": "腌出的水要倒掉，否则成品发酸。",
      "visual_cue": "豆腐体积略缩、盘底积出淡黄水"
    },
    {
      "n": 3,
      "text": "把渗出的水倒净，用厨房纸逐片按压吸干表面水珠。",
      "time_min": 4,
      "heat": "无火",
      "tip": "吸干水汽是烘干定型的关键一步。",
      "visual_cue": "豆腐表面干爽、纸上有明显湿痕"
    },
    {
      "n": 4,
      "text": "辣椒粉、花椒碎、八角瓣与生姜丝混合，调入生抽与白酒拌成料糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "料糊稍稠一些才挂得住豆腐。",
      "visual_cue": "料糊呈深红色、香味冲鼻"
    },
    {
      "n": 5,
      "text": "每片豆腐六面都抹上料糊，摆在烤架上送入六十度烤箱热风烘两小时。",
      "time_min": 120,
      "heat": "小火",
      "tip": "烤箱门留一条缝，水汽才能散出去。",
      "visual_cue": "豆腐收硬、表面料糊干结成壳"
    },
    {
      "n": 6,
      "text": "取出豆腐放入蒸锅，上汽后大火蒸十分钟，出锅淋芝麻油。",
      "time_min": 10,
      "heat": "大火",
      "tip": "蒸一遍让香料回软，口感不干硬。",
      "visual_cue": "豆腐回软、油光发亮"
    }
  ],
  "tips": [
    "老豆腐比嫩豆腐更适合，压不出水才耐烘。",
    "烘好的豆腐放凉再装罐，可冷藏存放两周。",
    "喜欢更辣的口感，可把辣椒粉换成小米辣碎。"
  ],
  "common_mistakes": [
    "用嫩豆腐制作，烘烤途中就碎成一摊。",
    "盐抹不匀，有的片过咸有的片寡淡。",
    "烘烤温度过高，表面焦黑内部还湿。"
  ],
  "substitutions": [
    {
      "original": "老豆腐",
      "substitute": "豆腐干",
      "ratio": "500g 对 400g",
      "note": "豆腐干已脱水，腌渍时间缩短到十分钟。"
    },
    {
      "original": "白酒",
      "substitute": "花雕酒",
      "ratio": "20ml 对 25ml",
      "note": "香气更柔，防腐力稍弱需尽快吃完。"
    }
  ],
  "variations": [
    "料糊里加一勺豆瓣酱，发酵风味更接近老做法。",
    "烘好后用炭火烤至两面起泡，佐粥极佳。"
  ],
  "serving_suggestion": "切薄片直接佐粥，也可切片炒青椒当小炒。",
  "storage": "密封罐冷藏可存两周，取用时用干净筷子夹。",
