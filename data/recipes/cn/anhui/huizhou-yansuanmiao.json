        }
      ]
    }
  ],
  "equipment": [
    "玻璃罐",
    "砧板",
    "晾晒篮",
    "干净筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "蒜苗择去黄叶与老根，再切成五厘米长的小段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "段不要太短，腌完会缩水，太短就只剩渣。",
      "visual_cue": "蒜苗段长短一致，茎叶分明"
    },
    {
      "n": 2,
      "text": "用清水反复冲洗三遍，捞出摊在竹篮里晾两小时。",
      "time_min": 120,
      "heat": "无火",
      "tip": "表面必须彻底晾干，带生水腌出来会起白花。",
      "visual_cue": "蒜苗表面干爽，叶面微微发软"
    },
    {
      "n": 3,
      "text": "把晾干的蒜苗放进大盆里，撒上盐用手反复揉搓。",
      "time_min": 8,
      "heat": "无火",
      "tip": "揉到蒜苗出水变软，盐味才吃得进去。",
      "visual_cue": "蒜苗体积缩小，盆底积出绿色汁水"
    },
    {
      "n": 4,
      "text": "加白糖、米醋与料酒拌匀，再放入姜片与干辣椒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖能帮发酵，醋能压住辛辣，比例不要乱改。",
      "visual_cue": "蒜苗表面裹满调料，颜色转深"
    },
    {
      "n": 5,
      "text": "玻璃罐用开水烫过晾干，把蒜苗一层层压实装进去。",
      "time_min": 6,
      "heat": "无火",
      "tip": "装罐时一定压紧排掉空气，松着装进去容易坏。",
      "visual_cue": "蒜苗紧紧贴在一起，没有明显空隙"
    },
    {
      "n": 6,
      "text": "把盆里剩下的汁水倒进罐中，刚刚没过蒜苗即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汁水要盖过食材，露在空气里的部分会发霉。",
      "visual_cue": "液面高出蒜苗一指，浮着辣椒段"
    },
    {
      "n": 7,
      "text": "盖紧盖子放在阴凉处，室温腌制三天后转冷藏。",
      "time_min": 5,
      "heat": "无火",
      "tip": "前几天每天开盖放一次气，避免胀罐。",
      "visual_cue": "罐内出现细小气泡，酸香渐浓"
    },
    {
      "n": 8,
      "text": "冷藏一周后就可以取食，每次用干净无水的筷子夹取。",
      "time_min": 4,
      "heat": "无火",
      "tip": "沾油的筷子会让整罐发霉，务必用干筷。",
      "visual_cue": "蒜苗呈黄绿色，咬起来酸脆"
    }
  ],
  "tips": [
    "蒜苗要选茎粗叶少的，腌完脆度更好。",
    "想酸得快一点，可以多加两勺米醋。",
    "腌好的蒜苗切碎炒肉片，也很下饭。",
    "罐子务必烫过晾干，容器干净是成败关键。"
  ],
  "common_mistakes": [
    "蒜苗没晾干就装罐，几天后表面长出一层白花。",
    "盐放得太少，蒜苗会发软发臭，一点也不脆。",
    "用沾了油的筷子夹取，整罐很快就会坏掉。"
  ],
  "substitutions": [
    {
      "original": "蒜苗",
      "substitute": "蒜薹",
      "ratio": "500克:500克",
      "note": "口感更脆，腌制时间加两天。"
    },
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "60毫升:60毫升",
      "note": "酸味更柔，颜色略深。"
    }
  ],
  "variations": [
    "加几颗小米辣一起腌，味道更冲也更开胃。",
    "拌入一勺辣椒油，直接当凉菜吃也很下饭。"
  ],
  "serving_suggestion": "切成小段装碟，配粥、配面或炒腊肉都合适，酸脆解腻。",
  "storage": "冷藏可存一个月，取食时保持筷子干燥，液面下降可补少量凉开水与盐。",
