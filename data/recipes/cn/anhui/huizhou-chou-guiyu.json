  ],
  "steps": [
    {
      "n": 1,
      "text": "鳜鱼刮净鱼鳞掏去内脏，从背部剖开成连着的两片，用厨房纸擦干血水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼腹里的黑膜要刮干净，那是腥味最重的地方，留着腌出来发苦。",
      "visual_cue": "鱼身干爽无血水，腹膜白净"
    },
    {
      "n": 2,
      "text": "盐与花椒小火炒到微微发黄，趁温热从鱼皮到鱼腹内外擦匀，码进木桶压上石头。",
      "time_min": 10,
      "heat": "小火",
      "tip": "盐要炒过才出香，生盐腌出来只有死咸味，花椒香也不出来。",
      "visual_cue": "鱼身均匀裹满椒盐，桶底无积水"
    },
    {
      "n": 3,
      "text": "木桶盖严放阴凉处腌五天，天热时移进冰箱冷藏，中途翻一次身。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腌到鱼眼发白、鱼鳃泛红就成，闻着有股淡淡的发酵香却不臭。",
      "visual_cue": "鱼身紧实，按压有弹性"
    },
    {
      "n": 4,
      "text": "取出腌好的鱼用清水冲掉表面盐粒，沥干后再用厨房纸吸一遍，鱼身两面各划三刀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐粒不冲净烧出来会咸得发苦，划刀让汤汁进得去，肉也更入味。",
      "visual_cue": "鱼皮完整，刀口整齐不破"
    },
    {
      "n": 5,
      "text": "平底锅烧热植物油，鱼下锅中火煎到两面微黄定型，盛出备用。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎之前锅一定要热透，鱼皮才不粘；急着翻面会把鱼身弄碎。",
      "visual_cue": "鱼皮两面结起浅黄色硬皮"
    },
    {
      "n": 6,
      "text": "原锅下五花肉片煸出油，加姜片、大蒜与干辣椒段炒香，放竹笋片翻炒，淋料酒、生抽与老抽。",
      "time_min": 6,
      "heat": "中火",
      "tip": "五花肉煸出油脂再加笋片同炒，笋吸了肉香更脆，煸到透明卷边才下其他料。",
      "visual_cue": "肉片卷边出油，笋片裹上酱色"
    },
    {
      "n": 7,
      "text": "倒入高汤与白糖烧开，鱼放回锅中加盖小火烧十二分钟，中途舀汤汁浇鱼身。",
      "time_min": 14,
      "heat": "小火",
      "tip": "烧的时候别翻鱼，用勺子浇汁就够，一动鱼肉就散成碎块。",
      "visual_cue": "汤汁变稠，鱼身裹上酱色"
    },
    {
      "n": 8,
      "text": "转大火收汁到浓稠挂勺，撒小葱段连锅端上桌，趁热配米饭吃。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁要收到能挂住勺子，汁多了味淡，臭鳜鱼的香就显不出来。",
      "visual_cue": "汤汁油亮浓稠，葱段翠绿"
    }
  ],
  "tips": [
    "臭鳜鱼闻着有股发酵味，烧熟后却是蒜瓣肉、鲜香扑鼻，这是徽菜的招牌。",
    "腌鱼时压石头是为了把水分挤出来，鱼肉变紧才有那种一瓣一瓣的口感。",
    "煎鱼前把鱼身水分吸干，油锅里才不会溅，鱼皮也能保持完整。"
  ],
  "common_mistakes": [
    "腌鱼盐放太少，五天过去鱼身发黏变臭，只能整条丢掉。",
    "煎鱼时锅不够热就下鱼，鱼皮粘在锅底，翻面时碎成两半。",
    "烧鱼时反复翻动，鱼肉散成小块，端上桌看不出是一条鱼。"
  ],
  "substitutions": [
    {
      "original": "鳜鱼",
      "substitute": "鲈鱼",
      "ratio": "800克:800克",
      "note": "鲈鱼肉薄，腌四天即可，烧的时间减到十分钟。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "300毫升:300毫升",
      "note": "用清水需多加五毫升生抽补味。"
    }
  ],
  "variations": [
    "加一勺辣椒酱同烧，汤色红亮，是黄山脚下农家馆子的重口做法。",
    "把五花肉换成咸肉，咸香更浓，与发酵的鱼味更合。"
  ],
  "serving_suggestion": "烧好的臭鳜鱼连锅端上桌，配一碟清爽的时蔬，鱼肉蘸汤汁吃最下饭。",
  "storage": "冷藏可存两天，复热时加两勺高汤小火煨透；不建议冷冻，鱼肉纤维会散，口感发渣。",
