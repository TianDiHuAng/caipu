      "group": "main",
      "items": [
        {
          "name": "竹笋",
          "name_en": "bamboo shoot",
          "amount": 400,
          "unit": "g",
          "note": "切长条",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "咸肉",
          "name_en": "salt-cured pork belly",
          "amount": 120,
          "unit": "g",
          "note": "切薄片",
          "optional": false
        },
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 80,
          "unit": "ml",
          "note": "淋盘增鲜",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 15,
          "unit": "ml",
          "note": "去腥",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 10,
          "unit": "g",
          "note": "切丝",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切花",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 3,
          "unit": "g",
          "note": "平衡咸味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "砧板",
    "深盘",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "竹笋剥壳削掉老根，切成半厘米厚的长片备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部老的地方多削一点，吃起来才不塞牙。",
      "visual_cue": "笋片厚薄一致，切面白净"
    },
    {
      "n": 2,
      "text": "水烧开后下笋片焯三分钟，去掉草酸与涩味后捞出沥干。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯过水的笋再上锅蒸，口感才会清甜而不涩口。",
      "visual_cue": "笋片变得柔韧，闻不到生涩气味"
    },
    {
      "n": 3,
      "text": "咸肉用温水洗去表面盐分，切成薄片，太咸可先泡十分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "咸肉咸得厉害就多泡一会儿，别指望蒸完会变淡。",
      "visual_cue": "咸肉片肥瘦分明，摸上去不再发黏"
    },
    {
      "n": 4,
      "text": "笋片整齐铺在深盘底层，咸肉片一片压一片地码在上面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "咸肉铺在上面，蒸出的油才会往下渗进笋里。",
      "visual_cue": "笋片铺满盘底，咸肉排列平整不重叠"
    },
    {
      "n": 5,
      "text": "撒上姜丝与白糖，淋料酒与高汤，盘口盖一层锡纸。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盖上锡纸能锁住蒸汽，笋片才不会被蒸得发干。",
      "visual_cue": "液体刚漫到笋片一半，锡纸包住盘口"
    },
    {
      "n": 6,
      "text": "水开后上锅大火蒸二十五分钟，蒸到咸肉变透明。",
      "time_min": 25,
      "heat": "大火",
      "tip": "中途千万别开盖，蒸汽一跑笋片立刻就发柴。",
      "visual_cue": "咸肉肥的部分透明发亮，笋片吸足油脂"
    },
    {
      "n": 7,
      "text": "取出盘子，撒上一把小葱花，趁热连盘底的汤汁一起端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘底的汤汁最鲜，千万别倒掉，留着拌饭正好。",
      "visual_cue": "汤汁清亮泛油光，葱花点缀翠绿"
    }
  ],
  "tips": [
    "用冬笋比春笋更嫩，蒸的时间可以缩到二十分钟。",
    "咸肉换成火腿薄片，咸鲜味更清雅，也不那么咸。",
    "盘底垫两片姜，蒸出来的汤更香。",
    "剩下的汤汁拌饭，一口就能吃完半碗。"
  ],
  "common_mistakes": [
    "笋没焯水直接蒸，吃到嘴里涩口发麻。",
    "咸肉切得太厚，蒸不透，吃到嘴里又咸又硬。",
    "不盖锡纸就蒸，笋片表面发干缩成一团。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "火腿",
      "ratio": "120克:120克",
      "note": "咸度更低，可省去泡水。"
    },
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "400克:400克",
      "note": "口感更软糯，蒸十八分钟即可。"
    }
  ],
  "variations": [
    "咸肉下面垫一层百叶结，吸足油分后比肉还香。",
    "加几颗干辣椒同蒸，多一层微辣的香，更下饭。"
  ],
  "serving_suggestion": "作为主菜上桌，配白粥或者白米饭都很合适下口。",
  "storage": "冷藏两天，复蒸十分钟即可，不建议反复加热太久。",
