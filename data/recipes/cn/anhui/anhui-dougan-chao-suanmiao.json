        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐干先片成两毫米厚的薄片，再切成三厘米长的条。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切薄一点才容易吸汁，太厚炒出来发硬。",
      "visual_cue": "豆腐干条厚薄一致，边角整齐"
    },
    {
      "n": 2,
      "text": "蒜苗择去老叶，斜切成四厘米长的段，茎叶分开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "斜切的截面更大，更容易吸味，摆盘也更好看。",
      "visual_cue": "蒜苗段斜口整齐，茎白叶绿"
    },
    {
      "n": 3,
      "text": "炒锅大火烧热放花生油，下豆腐干中小火煸两分钟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "豆腐干先煸到边缘微焦，口感才香不柴。",
      "visual_cue": "豆干边缘泛金，锅里有豆香"
    },
    {
      "n": 4,
      "text": "下干辣椒与蒜苗茎，转大火翻炒一分钟炒出辛香。",
      "time_min": 1,
      "heat": "大火",
      "tip": "蒜苗茎耐炒先下，叶子最后放才不会发黄。",
      "visual_cue": "蒜苗茎颜色转深绿，香气升腾"
    },
    {
      "n": 5,
      "text": "加生抽、白糖与盐翻炒均匀，让豆干均匀上色。",
      "time_min": 1,
      "heat": "大火",
      "tip": "生抽沿着锅边淋下去，遇热激出的香味更足。",
      "visual_cue": "豆干呈浅酱色，油光发亮"
    },
    {
      "n": 6,
      "text": "下蒜苗叶，大火快炒三十秒，叶片刚软就关火。",
      "time_min": 1,
      "heat": "大火",
      "tip": "叶子炒久了出水发黄，刚断生就要关火。",
      "visual_cue": "叶片翠绿柔软，锅底无汤汁"
    },
    {
      "n": 7,
      "text": "淋上香油再翻两下，就可以起锅装盘端上桌了。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香油一定要最后淋，香气才留得住不散。",
      "visual_cue": "盘中干爽，豆干与蒜苗分明"
    }
  ],
  "tips": [
    "豆腐干选压得紧实的，煸过更有嚼劲。",
    "蒜苗要新鲜才好，蔫掉的炒起来会出水。",
    "怕辣可以不放干辣椒，用少许白胡椒代替。",
    "加一点腌菜一起炒，咸鲜味更下饭。"
  ],
  "common_mistakes": [
    "豆干切得太厚，炒完外面咸里面淡，口感还发硬。",
    "蒜苗叶和茎一起下锅，叶烂了茎还生。",
    "全程小火，豆干吸油变软没有一点焦香。"
  ],
  "substitutions": [
    {
      "original": "豆腐干",
      "substitute": "板豆腐",
      "ratio": "250克:300克",
      "note": "先煎到两面金黄再炒，不易碎。"
    },
    {
      "original": "蒜苗",
      "substitute": "韭菜",
      "ratio": "200克:200克",
      "note": "辛香更浓，炒的时间更短。"
    }
  ],
  "variations": [
    "加一把腊肉片一起炒，咸香会更浓一些。",
    "把干辣椒换成豆豉同炒，风味会更浓重一些。"
  ],
  "serving_suggestion": "趁热装盘，配米饭或粥都合适，下酒也不错。",
  "storage": "冷藏两天，复热用大火快炒，避免久煮发软。",
