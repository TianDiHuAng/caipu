          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 5,
          "unit": "ml",
          "note": "去腥",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 4,
          "unit": "ml",
          "note": "起锅淋",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "打蛋碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "韭菜择去老叶和黄叶，根部的老硬一段切掉不要。",
      "time_min": 5,
      "heat": "无火",
      "tip": "根部老硬还带泥，切掉一截口感才嫩。",
      "visual_cue": "韭菜叶面干净，根段整齐"
    },
    {
      "n": 2,
      "text": "洗净后摊开晾一会儿，把表面的水分尽量控干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "带水下锅会溅油，还会把蛋炒得发水。",
      "visual_cue": "叶面不见水珠，摸着微湿"
    },
    {
      "n": 3,
      "text": "切成三厘米长的段，把茎和叶子分开放进两个盘里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "茎叶成熟时间不同，分开下锅才不会叶烂茎生。",
      "visual_cue": "茎段与叶片分装两处，清楚不混"
    },
    {
      "n": 4,
      "text": "鸡蛋磕进碗里，加料酒与一小撮盐，用筷子充分打散。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打到蛋液看不见明显蛋筋，炒出来才蓬松细腻。",
      "visual_cue": "蛋液颜色均匀，表面有一层细泡"
    },
    {
      "n": 5,
      "text": "炒锅大火烧热放一半花生油，倒入蛋液划散成大块。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油热再倒蛋液，蛋块才鼓得起来不发死。",
      "visual_cue": "蛋液边缘迅速凝固鼓起"
    },
    {
      "n": 6,
      "text": "蛋块炒到七成熟，表面还略带湿润时盛出备用。",
      "time_min": 1,
      "heat": "中火",
      "tip": "留一点湿气在蛋里，回锅后口感才嫩而不老。",
      "visual_cue": "蛋块金黄，中间略见湿润"
    },
    {
      "n": 7,
      "text": "锅里补剩下的花生油，下韭菜茎大火翻炒四十秒。",
      "time_min": 1,
      "heat": "大火",
      "tip": "茎段先下，炒到断生才放叶，熟度才一致。",
      "visual_cue": "茎段颜色转深绿，体积略缩"
    },
    {
      "n": 8,
      "text": "下韭菜叶与盐快速翻匀，倒回蛋块一起兜两下。",
      "time_min": 1,
      "heat": "大火",
      "tip": "全程不超过一分钟，韭菜炒久会出汤发黄。",
      "visual_cue": "叶片刚变软，锅底没有汤汁"
    },
    {
      "n": 9,
      "text": "淋上香油后立刻起锅装盘，趁热端上桌吃最香。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香油后淋提香，早放会被高温烧掉香气。",
      "visual_cue": "盘中干爽，蛋块与韭菜分明"
    }
  ],
  "tips": [
    "韭菜要选窄叶的，香味更浓也更嫩。",
    "蛋液里加几滴水，炒出来更松软。",
    "炒韭菜一定要大火，锅气足才不出水。",
    "剩的韭菜不要隔夜，第二天就发黄变味。"
  ],
  "common_mistakes": [
    "蛋液没打散就下锅，炒出来一块块结着蛋筋。",
    "韭菜洗好带水下锅，整盘菜泡在一汪汤里。",
    "全程小火慢慢炒，鸡蛋又干又硬，韭菜发黄发蔫。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "蒜苗",
      "ratio": "250克:250克",
      "note": "辛香更冲，炒的时间要稍长一点。"
    },
    {
      "original": "花生油",
      "substitute": "菜籽油",
      "ratio": "40毫升:40毫升",
      "note": "颜色偏深，油烟略重。"
    }
  ],
  "variations": [
    "加一小把虾米一起炒，鲜味会更足一些。",
    "把鸡蛋换成鸭蛋，成品颜色更黄也更香。"
  ],
  "serving_suggestion": "刚出锅就上桌，配一碗白粥或米饭，蛋香混着韭香最下饭。",
  "storage": "当天吃完，冷藏后复热会出水，不建议隔夜。",
