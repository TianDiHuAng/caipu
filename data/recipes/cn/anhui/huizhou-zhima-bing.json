  "equipment": [
    "大碗",
    "平底锅",
    "擀面杖",
    "刷子",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加温水和盐揉成光滑面团，醒三十分钟。这一步别着急。",
      "time_min": 34,
      "heat": "无火",
      "tip": "面团偏软，擀的时候才不回缩。，注意火候。",
      "visual_cue": "面团光滑，按压回弹，状态稳定"
    },
    {
      "n": 2,
      "text": "黑芝麻小火炒香，一半磨碎一半留整粒。这一步别着急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "磨碎出油，馅才香得透。，注意火候。",
      "visual_cue": "芝麻香气浓，微微跳动"
    },
    {
      "n": 3,
      "text": "磨碎的芝麻拌白糖和猪油，调成馅料。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "猪油让馅抱团，不散不漏。，注意火候。",
      "visual_cue": "馅料能捏成小团，状态稳定"
    },
    {
      "n": 4,
      "text": "面团擀成大薄片，抹猪油后卷起切段。这一步别着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "卷紧一点，层次才分明。，注意火候。",
      "visual_cue": "切面见到螺旋纹，状态稳定"
    },
    {
      "n": 5,
      "text": "每段压扁包入芝麻馅，收口捏紧。这一步别着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "收口捏牢，烙时馅才不会流。，注意火候。",
      "visual_cue": "饼坯圆整，收口平滑，状态稳定"
    },
    {
      "n": 6,
      "text": "表面刷水，蘸上整粒黑芝麻。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷水芝麻才粘得牢。，注意火候。",
      "visual_cue": "芝麻密布，按压不落，状态稳定"
    },
    {
      "n": 7,
      "text": "轻擀成一厘米厚的圆饼，静置五分钟。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "轻擀慢推，馅别挤到边。，注意火候。",
      "visual_cue": "饼坯匀整，芝麻完好，状态稳定"
    },
    {
      "n": 8,
      "text": "平底锅刷植物油，小火烙八分钟两面金黄。这一步别着急。",
      "time_min": 9,
      "heat": "小火",
      "tip": "盖盖烙，里面才熟得透。，注意火候。",
      "visual_cue": "两面焦黄，饼身鼓起，状态稳定"
    }
  ],
  "tips": [
    "芝麻炒香再拌馅，甜香才足。，值得留意。",
    "面团软一点，擀薄了才不裂。，值得留意。",
    "小火慢烙，外脆内软。，值得留意。"
  ],
  "common_mistakes": [
    "芝麻没炒，吃着生涩。，值得留意。",
    "收口没捏紧，烙时糖馅流一锅。，值得留意。",
    "火太大，芝麻先焦了饼还生。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "黑芝麻",
      "substitute": "白芝麻",
      "ratio": "60 克:60 克",
      "note": "香气略淡，颜色更清爽。"
    },
    {
      "original": "猪油",
      "substitute": "黄油",
      "ratio": "40 克:40 克",
      "note": "奶香更浓，风味偏西式。"
    }
  ],
  "variations": [
    "馅里加一点桂花，香气更雅。，值得留意。",
    "用烤箱一百八十度烤十五分钟，更干香。"
  ],
  "serving_suggestion": "配豆浆或茶，当早饭或下午茶点心。，效果更稳定。",
  "storage": "密封常温两天，冷冻两周；复热用平底锅干烙两分钟。",
