  "equipment": [
    "和面盆",
    "擀面杖",
    "炒锅",
    "蒸锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "中筋面粉加一小撮盐，分次倒入清水搅成絮状，再揉成光滑面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水别一次倒完，面团偏硬更好擀。",
      "visual_cue": "面团表面光滑、按下去回弹"
    },
    {
      "n": 2,
      "text": "面团盖上湿布静置醒发三十分钟，让面筋松弛。",
      "time_min": 30,
      "heat": "无火",
      "tip": "醒好的面团擀皮不回缩。",
      "visual_cue": "面团体积略松、手指按压有浅坑"
    },
    {
      "n": 3,
      "text": "冬笋与香菇分别切成细丁，青菜焯水后挤干水分剁碎。",
      "time_min": 8,
      "heat": "无火",
      "tip": "青菜一定要挤干，不然馅会出水。",
      "visual_cue": "菜碎干爽成团、不滴汁"
    },
    {
      "n": 4,
      "text": "炒锅下油把猪肉末炒散，加冬笋、香菇、青菜、生抽与料酒炒香，撒盐与白胡椒盛出。",
      "time_min": 8,
      "heat": "中火",
      "tip": "馅料炒过再包，蒸出来更香不出水。",
      "visual_cue": "肉末松散上色、馅料油润"
    },
    {
      "n": 5,
      "text": "面团搓条切剂，擀成中间厚边缘薄的方皮，包入馅料对折成包袱状，用蛋液抹边捏紧。",
      "time_min": 22,
      "heat": "无火",
      "tip": "四角向中间收拢，形似包袱才正宗。",
      "visual_cue": "饺子鼓起、封口不见缝隙"
    },
    {
      "n": 6,
      "text": "蒸屉刷油摆入包袱饺，水开后大火蒸十二分钟，关火焖两分钟。",
      "time_min": 12,
      "heat": "大火",
      "tip": "关火焖一会皮不塌陷。",
      "visual_cue": "饺皮半透明、透着馅料颜色"
    },
    {
      "n": 7,
      "text": "出锅趁热刷一层芝麻油，连蒸屉一起端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "刷油能防皮子风干开裂。",
      "visual_cue": "表面油亮、提起不破"
    }
  ],
  "tips": [
    "馅料必须放凉再包，热馅会把面皮烫软。",
    "方皮比圆皮好包，四个角收拢就是包袱形。",
    "蒸屉铺一层纱布，比刷油更防粘。"
  ],
  "common_mistakes": [
    "青菜不挤水，蒸的时候馅汤把饺皮泡破。",
    "面皮擀得太薄，收口处一蒸就裂开。",
    "冷水上锅慢慢蒸，皮子发硬口感差。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "猪里脊",
      "ratio": "250g 对 250g",
      "note": "手工剁成粗粒，口感更有嚼头。"
    },
    {
      "original": "冬笋",
      "substitute": "茭白",
      "ratio": "80g 对 80g",
      "note": "茭白更清甜，出水也略多。"
    }
  ],
  "variations": [
    "馅里加一把虾皮，鲜味立刻上一个层次。",
    "改用煎法，锅底淋水盖盖焖熟，就是徽州煎包袱。"
  ],
  "serving_suggestion": "一屉六个，配一碗紫菜汤，就是山里人的一顿正餐。",
  "storage": "生坯冷冻可存一个月，蒸时不用解冻直接上锅。",
