  "steps": [
    {
      "n": 1,
      "text": "咸肉用温水泡二十分钟，刮掉表面盐霜。这一步别着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过汤才不会齁咸。，注意火候。",
      "visual_cue": "肉片发白，盐霜洗净，状态稳定"
    },
    {
      "n": 2,
      "text": "冬瓜去皮去瓤，切成三厘米见方的块。这一步别着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "瓤去净，煮出来才不糊。，注意火候。",
      "visual_cue": "块形整齐，切口水润，状态稳定"
    },
    {
      "n": 3,
      "text": "砂锅倒清水，放咸肉片和姜片大火烧开。这一步别着急。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅，血沫才逼出来。，注意火候。",
      "visual_cue": "汤面浮沫聚集，状态稳定"
    },
    {
      "n": 4,
      "text": "撇净浮沫，烹入料酒转小火炖二十五分钟。这一步别着急。",
      "time_min": 27,
      "heat": "小火",
      "tip": "小火炖，咸肉的香才散得匀。，注意火候。",
      "visual_cue": "汤色清亮，肉片卷起，状态稳定"
    },
    {
      "n": 5,
      "text": "放入冬瓜块，继续小火煮十分钟。这一步别着急。",
      "time_min": 11,
      "heat": "小火",
      "tip": "冬瓜后放，才不会煮成泥。，注意火候。",
      "visual_cue": "冬瓜透明，边缘微化，状态稳定"
    },
    {
      "n": 6,
      "text": "加盐和白胡椒粉，撒小葱末即可。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "咸肉有咸味，盐先尝再放。，注意火候。",
      "visual_cue": "汤清料明，胡椒微香，状态稳定"
    }
  ],
  "tips": [
    "咸肉先泡水，汤的咸淡才好控制。，值得留意。",
    "冬瓜后放，煮到透明就停火。，值得留意。",
    "小火慢炖，汤色才清不浑。，值得留意。"
  ],
  "common_mistakes": [
    "咸肉没泡，汤咸得喝不下。，值得留意。",
    "冬瓜煮过头，全化在汤里。，值得留意。",
    "全程大火，汤色浑白。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "火腿",
      "ratio": "150 克:120 克",
      "note": "更鲜，盐几乎不用放。"
    },
    {
      "original": "冬瓜",
      "substitute": "节瓜",
      "ratio": "500 克:500 克",
      "note": "质地更紧，煮的时间加三分钟。"
    }
  ],
  "variations": [
    "加几粒干贝同炖，鲜味更足。，值得留意。",
    "放一把粉丝，汤更饱腹。，值得留意。"
  ],
  "serving_suggestion": "夏天饭前喝一碗，清口解腻。，效果更稳定。",
  "storage": "冷藏两天，复热小火煮开。，效果更稳定。",
