  "steps": [
    {
      "n": 1,
      "text": "咸肉用温水泡二十分钟，洗去表面盐霜。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡过再煮，汤才不会过咸。，注意火候。",
      "visual_cue": "肉片发白，盐霜洗净，状态稳定"
    },
    {
      "n": 2,
      "text": "冬笋剥壳去老根，切两毫米薄片。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部老，切掉一截口感才嫩。，注意火候。",
      "visual_cue": "笋片匀薄，颜色玉白，状态稳定"
    },
    {
      "n": 3,
      "text": "笋片入开水焯三分钟，捞出冲凉。这一步不要着急。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯水去涩，汤才清甜。，注意火候。",
      "visual_cue": "笋片转亮，涩味散出，状态稳定"
    },
    {
      "n": 4,
      "text": "砂锅放清水，下咸肉片和姜片大火烧开。这一步不要着急。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅，血沫才逼得出来。，注意火候。",
      "visual_cue": "浮沫聚集，汤色微浑，状态稳定"
    },
    {
      "n": 5,
      "text": "撇净浮沫，加料酒和小葱结转小火炖三十五分钟。",
      "time_min": 38,
      "heat": "小火",
      "tip": "小火慢炖，咸肉的香味才散开。，注意火候。",
      "visual_cue": "汤色清亮，肉片卷起，状态稳定"
    },
    {
      "n": 6,
      "text": "放入笋片继续小火煮十分钟。这一步不要着急。",
      "time_min": 11,
      "heat": "小火",
      "tip": "笋片后放，才保脆嫩。，注意火候。",
      "visual_cue": "笋片浮起，汤面泛油，状态稳定"
    },
    {
      "n": 7,
      "text": "挑出葱结和姜片，加盐和白胡椒粉调味。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "咸肉自带咸味，盐要少放。，注意火候。",
      "visual_cue": "汤清见底，胡椒微香，状态稳定"
    }
  ],
  "tips": [
    "咸肉先泡，汤咸淡才好控制。，值得留意。",
    "笋片焯过去涩，汤才清甜。，值得留意。",
    "小火慢炖，汤色才清亮。，值得留意。"
  ],
  "common_mistakes": [
    "咸肉没泡，汤咸得下不了口。，值得留意。",
    "大火滚煮，汤色浑白不清。，值得留意。",
    "笋片久煮，脆感全没了。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "火腿",
      "ratio": "200 克:150 克",
      "note": "更鲜，盐要减到极少。"
    },
    {
      "original": "冬笋",
      "substitute": "春笋",
      "ratio": "300 克:300 克",
      "note": "涩味重些，焯水加到五分钟。"
    }
  ],
  "variations": [
    "加几片豆腐皮，汤更有豆香。，值得留意。",
    "放一小块金华火腿骨，鲜味更浓。，值得留意。"
  ],
  "serving_suggestion": "饭前喝一碗，冬天配米饭最舒服。，效果更稳定。",
  "storage": "冷藏两天，复热小火煮开即可。，效果更稳定。",
