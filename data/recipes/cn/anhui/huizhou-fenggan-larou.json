    "挂钩",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成三指宽的长条，用料酒把整条皮面反复擦洗干净。",
      "time_min": 12,
      "heat": "无火",
      "tip": "皮上的油污与毛根要刮净，否则腌出来带异味。",
      "visual_cue": "肉皮白净，摸上去没有黏液"
    },
    {
      "n": 2,
      "text": "盐与花椒、八角、桂皮一起下干锅小火炒两分钟，炒出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "盐炒到微微发黄就够，炒糊了会带苦。",
      "visual_cue": "盐粒发黄松散，锅里香气明显上冲"
    },
    {
      "n": 3,
      "text": "炒好的香料盐趁热均匀抹遍每条肉，边角与皮面都要抹到。",
      "time_min": 10,
      "heat": "无火",
      "tip": "手上要用力反复揉搓，让盐真正吃进肉里而不是浮在表面。",
      "visual_cue": "肉表面均匀裹上盐粒，按压有轻微出水"
    },
    {
      "n": 4,
      "text": "肉条码进陶缸，皮朝下压紧，淋上生抽与冰糖盖好。",
      "time_min": 6,
      "heat": "无火",
      "tip": "缸口盖严压重物，让肉完全浸在自己出的卤水里。",
      "visual_cue": "卤水刚漫过肉面，缸内的肉码得平整"
    },
    {
      "n": 5,
      "text": "阴凉处腌五天，每天翻动一次，把上面的肉换到下面。",
      "time_min": 15,
      "heat": "无火",
      "tip": "翻缸是防止上下咸淡不均，别省略这一步。",
      "visual_cue": "肉色由粉转深红，肉质变紧实有弹性"
    },
    {
      "n": 6,
      "text": "取出肉条用温水冲掉表面的盐粒与香料，穿绳挂到通风处。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冲洗要快，冲完立刻挂起，别让肉泡水。",
      "visual_cue": "肉面干净，绳结牢靠挂起不下滑"
    },
    {
      "n": 7,
      "text": "挂在阴凉通风处风干十到十五天，直到表面干硬、按下去不出水。",
      "time_min": 20,
      "heat": "无火",
      "tip": "避开日晒与潮气，风干比晒干更香更耐放。",
      "visual_cue": "表皮干硬发亮，按压不回软、有腊香"
    }
  ],
  "tips": [
    "风干好的腊肉切薄片蒸二十分钟，肥肉透明最好吃。",
    "炒菜时先用小火把腊肉煸出油，再下配料更香。",
    "腊肉表面抹一层白酒再挂，能防虫也更耐存。",
    "天冷时风干效果最好，梅雨季不建议做。"
  ],
  "common_mistakes": [
    "盐抹得太少，风干途中肉条发黏变味。",
    "挂在太阳下暴晒，外层干硬里面还软，容易坏。",
    "腌制时不翻缸，同一缸里咸淡相差很多。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "后腿肉",
      "ratio": "900克:900克",
      "note": "瘦肉更多，风干后偏硬。"
    },
    {
      "original": "花椒",
      "substitute": "花椒粉",
      "ratio": "8克:6克",
      "note": "更易附着，香气略冲。"
    }
  ],
  "variations": [
    "腌料里加一勺甜面酱，做成酱香更重的版本。",
    "用柏树枝熏两小时再风干，得到带烟熏味的腊肉。"
  ],
  "serving_suggestion": "切薄片蒸熟直接上桌，或炒蒜苗、炒干菜都很合适。",
  "storage": "悬挂通风处可存三个月，切块冷冻可放半年。",
