  "steps": [
    {
      "n": 1,
      "text": "羊肉切成两毫米薄片，加料酒、生抽与生粉抓匀腌十五分钟。",
      "time_min": 17,
      "heat": "无火",
      "tip": "羊肉片薄一点，大火一炒就熟，不会出汤。",
      "visual_cue": "肉片薄而透光，表面带薄浆"
    },
    {
      "n": 2,
      "text": "大葱斜切成马耳段，葱白与葱绿分开放，姜切细丝备用。",
      "time_min": 9,
      "heat": "无火",
      "tip": "斜切断面大，葱香才容易炒出来。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "葱段断面呈斜面，层次分明"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟倒植物油，下姜丝与葱白段大火爆出香味。",
      "time_min": 4,
      "heat": "大火",
      "tip": "油要够热，葱白下锅要听见响才够香。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "葱白边缘微黄，香气冲鼻"
    },
    {
      "n": 4,
      "text": "下羊肉片大火快速翻炒，肉片一变色立刻沿锅边淋陈醋。",
      "time_min": 4,
      "heat": "大火",
      "tip": "羊肉变色就淋醋，醋气一冲膻味全散。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "肉片由红转灰白，锅气明显"
    },
    {
      "n": 5,
      "text": "下葱绿段，加盐与生抽大火翻炒三十秒，淋香油出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "葱绿最后放，翻两下就出锅，颜色才翠。",
      "visual_cue": "葱绿刚塌，肉片油亮不出一滴水"
    }
  ],
  "tips": [
    "羊肉逆纹切薄片，口感才嫩不柴。火候与时间都要盯紧，宁可略短也别过头。",
    "全程大火，锅气足才压得住膻味。做之前把料备齐，下锅后就没空切配了。",
    "沿锅边淋醋是京味做法，去膻又提香。这几步照顺序来，味道才会一层层叠上去。",
    "葱的量要足，葱比肉多才够味。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "羊肉切太厚，外面老了里面还生。结果往往一锅好料全被这一步毁掉。",
    "小火慢炒，羊肉出水变成炖羊肉。很多人就在这里翻车，出菜后才发现。",
    "葱一次全下锅，葱绿炒黄发苦。账面上看是小疏忽，入口立刻能尝出来。",
    "醋倒得太早，酸味挥发不掉发冲。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "羊腿肉",
      "ratio": "500克:500克",
      "note": "更瘦，上浆时多抓一会儿。"
    },
    {
      "original": "大葱",
      "substitute": "洋葱",
      "ratio": "250克:220克",
      "note": "甜味更重，醋可减半。"
    }
  ],
  "variations": [
    "加一把香菜段同炒，香气更野。口味会更厚一些，适合重口的人。",
    "加干辣椒炝锅，辣味更直接。做法不复杂，家常灶台就能完成。",
    "配烧饼夹着吃，京味更足。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装盘趁热吃，羊肉嫩、葱香冲，配一张芝麻烧饼或一碗米饭，是北京馆子里最常见的爆炒。",
  "storage": "冷藏不超过一天，复热用大火快炒四十秒，久热羊肉会柴。",
