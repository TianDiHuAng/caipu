  "steps": [
    {
      "n": 1,
      "text": "四季豆掐去两头的筋，掰成五厘米长的段，用清水洗净后彻底擦干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面水分一定要擦干，带水下油锅会剧烈溅油。",
      "visual_cue": "豆角干爽发亮，断口整齐"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧到六成热，豆角下锅中火煸到表皮起皱发白，捞出沥油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煸到皮起虎皮皱才够香，也确保熟透。",
      "visual_cue": "豆角表皮起白皱，颜色转深绿"
    },
    {
      "n": 3,
      "text": "倒出多余油留底油，下猪肉末中火煸炒到变色出油，烹入料酒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "肉末要煸到微微发干，香气才出得来。",
      "visual_cue": "肉末散成小粒，锅底渗油"
    },
    {
      "n": 4,
      "text": "下姜末、蒜末、干辣椒段与花椒，小火炒出香味，注意别炒糊。",
      "time_min": 2,
      "heat": "小火",
      "tip": "辣椒一变色就下豆角，炒黑了整盘发苦。",
      "visual_cue": "干辣椒转暗红，香气冲鼻"
    },
    {
      "n": 5,
      "text": "倒回豆角转大火翻炒，加生抽、盐与白糖，快速翻锅两分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火快翻，豆角才不回软，味道也裹得匀。",
      "visual_cue": "豆角油亮发亮，锅中不见汤水"
    },
    {
      "n": 6,
      "text": "试味后补少许盐，出锅装盘，趁热吃口感最佳。",
      "time_min": 1,
      "heat": "大火",
      "tip": "咸淡最后调一次，前面生抽已经带了盐分，别放重了。",
      "visual_cue": "豆角干香，起虎皮不软塌"
    }
  ],
  "tips": [
    "豆角选细长新鲜的，老豆角纤维粗，煸完也咬不动。",
    "没有肉末时可换成芽菜或榨菜末，同样出味。",
    "煸豆角时油量要够，油少了只会炒成水煮豆角。"
  ],
  "common_mistakes": [
    "豆角不擦干就下油锅，油花四溅，容易烫伤手脸。",
    "豆角只炒到变色就起锅，半生的四季豆吃了会中毒。",
    "小火慢慢炒，豆角吸油出水，成品软塌一盘油。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "120克:120克",
      "note": "牛肉末更干香，可多放一点油。"
    },
    {
      "original": "豆角",
      "substitute": "豇豆",
      "ratio": "450克:450克",
      "note": "豇豆更细，煸的时间减两分钟。"
    }
  ],
  "variations": [
    "加一把泡软的干辣椒段同煸，辣味更重，是川味的干煸做法。",
    "把肉末换成虾米同煸，鲜味更足，适合不吃肉的人。"
  ],
  "serving_suggestion": "下饭最合适，配一碗白粥或米饭都能吃两碗。",
  "storage": "冷藏可存一天，复热须大火干煸，久热豆角会发黄。",
