        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "炒锅",
    "漏勺",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪大肠用土豆淀粉和盐反复搓洗三遍，剪开去除内壁脂肪，冲水到没有异味。",
      "time_min": 30,
      "heat": "无火",
      "tip": "洗肠时加一勺白醋，去腥效果比单用盐更好。",
      "visual_cue": "肠壁发白发涩、水冲洗后无油膜"
    },
    {
      "n": 2,
      "text": "洗净的猪大肠冷水下锅，加料酒与姜片，小火煮一小时至筷子能穿透。",
      "time_min": 60,
      "heat": "小火",
      "tip": "煮肠全程小火，大火会把肠壁煮得发硬缩成筋。",
      "visual_cue": "筷子能轻松穿透肠壁、无血水"
    },
    {
      "n": 3,
      "text": "煮好的猪大肠捞出晾凉，切成半厘米宽的菱形小块，汤水留用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "晾凉再切，热肠软塌切出来厚薄不一。",
      "visual_cue": "肠块大小均匀、断面平整"
    },
    {
      "n": 4,
      "text": "猪肝切成三角片，用清水泡十分钟换两遍水，泡出血水后沥干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡水时别用力抓，肝片易碎，轻轻翻洗即可。",
      "visual_cue": "肝片颜色转浅、水面无血沫"
    },
    {
      "n": 5,
      "text": "锅中放留用的肠汤烧开，加黄豆酱与生抽化开，倒入肠块小火煮十分钟。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "酱要先用少量热汤化开再倒回锅，避免结块。",
      "visual_cue": "汤汁呈浅褐色、酱香散出"
    },
    {
      "n": 6,
      "text": "下猪肝片煮到边缘变白，再缓缓淋入水淀粉，边淋边搅至汤汁浓稠发亮。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "淀粉要分两次淋，一次倒完容易结块挂不均。",
      "visual_cue": "汤汁能挂住勺背、肝片刚断生"
    },
    {
      "n": 7,
      "text": "关火后调入蒜泥与盐，装碗时撒上生蒜末，趁热用小勺连汤带料吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜泥关火后才放，久煮蒜香会发闷发苦。",
      "visual_cue": "碗面蒜香扑鼻、汤汁凝而不流"
    }
  ],
  "tips": [
    "炒肝其实是煮加勾芡，全程几乎不炒，火候以汤汁挂勺为准。",
    "蒜要用新蒜捣泥，辛辣清亮，老蒜发苦会盖住酱香。",
    "勾芡后的炒肝不能久放，凉了凝成块，需重新加热稀开。"
  ],
  "common_mistakes": [
    "猪大肠没洗净，成品带脏器味，怎么加蒜都压不住。",
    "猪肝一开始就下锅久煮，口感发柴像胶皮。",
    "淀粉一次倒入且不搅动，汤汁结成透明硬疙瘩。"
  ],
  "substitutions": [
    {
      "original": "猪大肠",
      "substitute": "猪肚",
      "ratio": "400g 对 400g",
      "note": "猪肚更厚实，煮制时间需延长二十分钟。"
    },
    {
      "original": "黄豆酱",
      "substitute": "甜面酱",
      "ratio": "40g 对 45g",
      "note": "甜面酱偏甜，需减少或不放盐。"
    }
  ],
  "variations": [
    "加入煮软的猪肺块，做成老北京摊子上更齐全的炒肝配肺。",
    "把水淀粉换成藕粉勾芡，汤汁更透亮，口感偏清爽。"
  ],
  "serving_suggestion": "装小碗带勺子，配两个芝麻烧饼或包子一起吃，就是地道北京早点。",
  "storage": "冷藏两天，复热时加少量清水小火化开，不要用大火直接煮。",
