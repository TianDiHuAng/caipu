      "group": "main",
      "items": [
        {
          "name": "猪大肠",
          "name_en": "pork intestine",
          "amount": 400,
          "unit": "g",
          "note": "选肠头肥厚段，翻洗去油",
          "optional": false
        },
        {
          "name": "猪肝",
          "name_en": "pork liver",
          "amount": 200,
          "unit": "g",
          "note": "切成一厘米厚的三角片",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 40,
          "unit": "g",
          "note": "一半捣成蒜泥",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 10,
          "unit": "g",
          "note": "切姜片煮肠用",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄豆酱",
          "name_en": "soybean paste",
          "amount": 40,
