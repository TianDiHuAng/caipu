          "note": "黄酱化开",
          "optional": false
        },
        {
          "name": "土豆淀粉",
          "name_en": "potato starch",
          "amount": 50,
          "unit": "g",
          "note": "加水调成水淀粉",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 30,
          "unit": "ml",
          "note": "去腥",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "按口味调整",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 900,
          "unit": "ml",
          "note": "煮肠与勾芡",
