        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "大碗",
    "刷子",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母用温水化开，倒进面粉里揉成柔软面团。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面软一点，烤出来才不干硬。，注意火候。",
      "visual_cue": "面团柔软，表面光滑，状态稳定"
    },
    {
      "n": 2,
      "text": "盖布放温暖处发酵四十分钟到略膨胀。这一步不要着急。",
      "time_min": 42,
      "heat": "无火",
      "tip": "半发面就够，发太足层次会糊。，注意火候。",
      "visual_cue": "体积略增，指压回弹，状态稳定"
    },
    {
      "n": 3,
      "text": "植物油加面粉、盐和五香粉调成稀油酥。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油酥调稀一点，抹开才均匀。，注意火候。",
      "visual_cue": "糊状顺滑，香气浓，状态稳定"
    },
    {
      "n": 4,
      "text": "面团擀成大片，均匀抹一层油酥。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "边缘留白，卷的时候才不漏。，注意火候。",
      "visual_cue": "油酥抹匀，薄厚一致，状态稳定"
    },
    {
      "n": 5,
      "text": "从一边卷成长条，切成八段后两头捏紧。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "两头捏紧，油酥才不会漏出来。，注意火候。",
      "visual_cue": "分段均匀，封口严实，状态稳定"
    },
    {
      "n": 6,
      "text": "每段按扁，收口朝下擀成圆饼，刷酱油沾芝麻。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刷酱油再沾，芝麻烤完不掉。，注意火候。",
      "visual_cue": "芝麻密布，饼形圆整，状态稳定"
    },
    {
      "n": 7,
      "text": "平底锅小火干烙两面各两分钟定型。这一步不要着急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "先烙定型，饼才不会塌。，注意火候。",
      "visual_cue": "两面微黄，饼身鼓起，状态稳定"
    },
    {
      "n": 8,
      "text": "移入两百度烤箱烤十二分钟到外皮酥脆。这一步不要着急。",
      "time_min": 13,
      "heat": "-",
      "tip": "烤过才酥，只烙会偏硬。，注意火候。",
      "visual_cue": "表皮起层，芝麻焦香，状态稳定"
    }
  ],
  "tips": [
    "半发面最好，发太过层次会糊在一起。，值得留意。",
    "油酥抹匀，卷出来才层层分明。，值得留意。",
    "刷层酱油再沾芝麻，烤完不掉粒。，值得留意。"
  ],
  "common_mistakes": [
    "面发过头，饼烤完塌成一片。，值得留意。",
    "油酥抹太少，吃起来干硬没层。，值得留意。",
    "火太大，芝麻先焦饼还生。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "五香粉",
      "substitute": "花椒粉",
      "ratio": "4 克:3 克",
      "note": "麻香更突出，盐可略增。"
    },
    {
      "original": "植物油",
      "substitute": "猪油",
      "ratio": "50 毫升:50 克",
      "note": "层次更酥，香气更浓。"
    }
  ],
  "variations": [
    "中间夹卤牛肉，做成烧饼夹肉。，值得留意。",
    "表面撒少许孜然粒，风味更西北。，值得留意。"
  ],
  "serving_suggestion": "配豆汁或羊杂汤，是老北京的经典早餐。，效果更稳定。",
  "storage": "冷冻两周，复热用烤箱一百八十度烤六分钟。",
