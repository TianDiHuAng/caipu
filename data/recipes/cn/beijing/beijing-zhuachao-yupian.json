  "steps": [
    {
      "n": 1,
      "text": "草鱼去骨去皮，取净肉片成半厘米厚的片，用清水冲两遍沥干。",
      "time_min": 14,
      "heat": "无火",
      "tip": "片要顺着鱼肉的纹理斜切，薄厚一致才好熟。",
      "visual_cue": "鱼片完整均匀，颜色洁白"
    },
    {
      "n": 2,
      "text": "鱼片加盐、料酒与半个蛋清抓匀，再拌淀粉上浆，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "先蛋清后淀粉，浆才裹得牢，滑油不掉浆。",
      "visual_cue": "鱼片表面挂一层薄浆发亮"
    },
    {
      "n": 3,
      "text": "碗里放白糖、米醋、生抽与淀粉，加四十毫升清水调成碗汁备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "碗汁先调好，出锅时来不及一样样加。",
      "visual_cue": "碗汁呈浅琥珀色，无干粉颗粒"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到四成热，鱼片逐片下锅滑到变白，立刻捞出沥油。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "油温四成即可，鱼片下锅慢慢变白，油一热肉就发老。",
      "visual_cue": "鱼片卷成小卷，通体雪白"
    },
    {
      "n": 5,
      "text": "锅留底油下葱段、姜末、蒜末炒香，倒入碗汁中火搅到冒泡变稠。",
      "time_min": 2,
      "heat": "中火",
      "tip": "汁烧开变稠才能裹住鱼片，稀汁一浇就流走。",
      "visual_cue": "汁面鼓起大泡，稠度能挂勺"
    },
    {
      "n": 6,
      "text": "倒回鱼片快速翻锅，让每片都裹上汁，淋少许热油出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "翻动要轻巧，鱼片嫩得一碰就碎，用铲背推比翻更好。",
      "visual_cue": "鱼片油亮裹汁，锅中不留汤"
    }
  ],
  "tips": [
    "草鱼换鲈鱼也可以，刺少肉嫩，成本高些。",
    "抓炒讲究的是封汁，汁量宁少勿多，多了就成烩。",
    "酸甜比按糖一醋零点九配，京菜的抓炒偏爱偏甜。"
  ],
  "common_mistakes": [
    "鱼片不上浆直接滑油，下锅肉质发柴还带腥。",
    "油温过高下鱼片，表面立刻焦黄，里面还是生的。",
    "碗汁勾芡太厚，鱼片裹成一坨，吃起来满口糊。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲈鱼",
      "ratio": "500克:500克",
      "note": "鲈鱼刺少，片的时候更方便。"
    },
    {
      "original": "米醋",
      "substitute": "陈醋",
      "ratio": "18毫升:15毫升",
      "note": "陈醋色深味重，糖可稍减。"
    }
  ],
  "variations": [
    "把鱼片换成鸡片，就是抓炒鸡片，京菜馆常见。",
    "加几片冬笋同炒，口感更脆，汤汁也更清。"
  ],
  "serving_suggestion": "趁热上桌，酸甜汁裹着嫩鱼片，宴席上很镇得住场。",
  "storage": "不宜久存，冷藏不超过一天，复热须小火回锅，微波会令鱼片发散。",
