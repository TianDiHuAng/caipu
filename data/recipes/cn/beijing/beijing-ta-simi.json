  "steps": [
    {
      "n": 1,
      "text": "羊肉顶刀切成柳叶片，加料酒、盐与少量生抽抓匀腌十分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "顶刀切断纤维，羊肉才嚼得烂。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "肉片薄而长，表面带薄浆"
    },
    {
      "n": 2,
      "text": "加生粉抓匀挂一层薄糊，再拌一勺植物油防止粘连。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糊别太厚，薄薄一层滑出来才嫩。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "每片肉都裹上白糊，片片分开"
    },
    {
      "n": 3,
      "text": "白糖、陈醋、生抽与清水调成甜酸汁，加生粉搅匀备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "汁先调好，下锅后没时间一样样加。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "汁液浅棕色，底部无沉淀"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到六成热，下羊肉片滑散，变色后捞出控油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "油温别太高，肉片下锅要能立刻散开。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "肉片浮起变白，彼此不粘连"
    },
    {
      "n": 5,
      "text": "锅留底油下姜末蒜末炒香，倒入甜酸汁小火熬到起泡变稠。",
      "time_min": 4,
      "heat": "小火",
      "tip": "汁熬到起大泡才够稠，挂得住肉片。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汁液稠亮，铲子划过能留痕"
    },
    {
      "n": 6,
      "text": "下羊肉片大火快速翻匀裹汁，淋香油出锅装盘即可。",
      "time_min": 3,
      "heat": "大火",
      "tip": "裹汁动作要快，久炒糊会发硬。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "肉片油亮挂汁，盘底不留汤"
    }
  ],
  "tips": [
    "羊肉顶刀切，入口才不费牙。火候与时间都要盯紧，宁可略短也别过头。",
    "挂糊要薄，厚了滑油后发硬。做之前把料备齐，下锅后就没空切配了。",
    "汁熬到起大泡再下肉，才挂得住。这几步照顺序来，味道才会一层层叠上去。",
    "甜酸比例按四比二，甜在前酸在后。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "肉片顺纹切，嚼起来像皮筋。结果往往一锅好料全被这一步毁掉。",
    "糊挂太厚，滑完油外壳发硬。很多人就在这里翻车，出菜后才发现。",
    "汁没熬稠就下肉，出锅成一盘汤。账面上看是小疏忽，入口立刻能尝出来。",
    "醋放太多，盖过甜味变得发酸。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛里脊",
      "ratio": "500克:500克",
      "note": "换成牛肉即为它似蜜的牛肉版。"
    },
    {
      "original": "陈醋",
      "substitute": "香醋",
      "ratio": "20毫升:20毫升",
      "note": "酸味柔和，糖可减五克。"
    }
  ],
  "variations": [
    "加一把熟芝麻，香气更足。口味会更厚一些，适合重口的人。",
    "把糖减半做成咸鲜版，更下饭。做法不复杂，家常灶台就能完成。",
    "加几片山楂同烧，解腻又增果香。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "盘底垫几片生菜，把挂汁的肉片堆上去，甜咸交织、外滑内嫩，是京菜宴席上最讨喜的一道。",
  "storage": "冷藏不超过一天，复热用炒锅小火加两勺清水翻匀，避免糖汁焦底。",
