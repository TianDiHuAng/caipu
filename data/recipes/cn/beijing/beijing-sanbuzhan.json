  "equipment": [
    "炒锅",
    "锅铲",
    "大碗",
    "筛网",
    "打蛋器"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕开取蛋黄，打散后过筛两遍去掉筋络。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "过筛两遍，糊才细腻不起疙瘩。，注意火候。",
      "visual_cue": "蛋黄细腻，无筋膜，状态稳定"
    },
    {
      "n": 2,
      "text": "玉米淀粉加清水化开，静置五分钟后搅匀。这一步不要着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "淀粉先化水，下锅才不会结块。，注意火候。",
      "visual_cue": "浆水均匀，无颗粒，状态稳定"
    },
    {
      "n": 3,
      "text": "蛋黄液与淀粉浆混合，加白糖搅到糖化开。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖先化开，炒的时候才不返砂。，注意火候。",
      "visual_cue": "液体顺滑，甜味均匀，状态稳定"
    },
    {
      "n": 4,
      "text": "炒锅烧热放猪油，油化开后转小火倒入蛋糊。这一步不要着急。",
      "time_min": 2,
      "heat": "小火",
      "tip": "全程小火，火大蛋糊立刻结块。，注意火候。",
      "visual_cue": "猪油清澈，蛋糊摊开，状态稳定"
    },
    {
      "n": 5,
      "text": "用锅铲不停推炒，让蛋糊慢慢变稠。这一步不要着急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "不停推，一停就糊底起块。，注意火候。",
      "visual_cue": "糊体变稠，铲过留痕，状态稳定"
    },
    {
      "n": 6,
      "text": "分两次补加猪油，继续翻炒到糊体发亮抱团。这一步不要着急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "油分次加，成品才滑不腻。，注意火候。",
      "visual_cue": "糊体油亮，能抱成团，状态稳定"
    },
    {
      "n": 7,
      "text": "炒到不粘锅、不粘勺、不粘盘三不粘即可出锅。",
      "time_min": 4,
      "heat": "小火",
      "tip": "三不粘是标准，锅底干净就对了。，注意火候。",
      "visual_cue": "锅底光洁，糊体滑亮，状态稳定"
    },
    {
      "n": 8,
      "text": "盛入抹油的盘中，顶部点缀山楂糕细丝。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "山楂丝解腻，颜色也更喜庆。，注意火候。",
      "visual_cue": "表面平滑，色泽金黄，状态稳定"
    }
  ],
  "tips": [
    "全程小火，火大蛋糊立刻结块。，值得留意。",
    "淀粉水先化开，下锅才不起疙瘩。，值得留意。",
    "猪油分次补，成品才又滑又亮。，值得留意。"
  ],
  "common_mistakes": [
    "火太大，蛋糊结成一团疙瘩。，值得留意。",
    "淀粉没化开，成品里全是硬粒。，值得留意。",
    "翻炒间隔太久，锅底糊一层发苦。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "黄油",
      "ratio": "60 克:60 克",
      "note": "奶香更明显，甜味略重。"
    },
    {
      "original": "山楂糕",
      "substitute": "蜜饯橙皮",
      "ratio": "40 克:40 克",
      "note": "香气更柑橘，酸度更低。"
    }
  ],
  "variations": [
    "撒少许桂花糖，香气更清雅。，值得留意。",
    "用鸭蛋黄代替鸡蛋黄，颜色更浓。，值得留意。"
  ],
  "serving_suggestion": "趁温热盛在小碟里，配一杯清茶最好。，效果更稳定。",
  "storage": "冷藏一天，复蒸三分钟可恢复软滑。，效果更稳定。",
