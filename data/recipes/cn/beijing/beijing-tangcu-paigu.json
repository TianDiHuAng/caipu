  "steps": [
    {
      "n": 1,
      "text": "排骨剁成四厘米长段，冷水浸泡三十分钟泡去血水，捞出沥干。",
      "time_min": 32,
      "heat": "无火",
      "tip": "泡透血水，炸出来才不腥，油也不发黑。",
      "visual_cue": "排骨颜色发白，水色由深红转淡"
    },
    {
      "n": 2,
      "text": "排骨冷水下锅，加姜片与料酒煮开，撇去浮沫后煮三分钟捞出冲净。",
      "time_min": 9,
      "heat": "大火",
      "tip": "先焯后炸，肉紧实不散，也去净血沫。",
      "visual_cue": "浮沫撇净，骨头断面不见血"
    },
    {
      "n": 3,
      "text": "排骨加生抽与少许盐抓匀，腌十五分钟入味，再用厨房纸吸干表面水分。",
      "time_min": 18,
      "heat": "无火",
      "tip": "表面一定要擦干，带水下油锅会炸得一塌糊涂。",
      "visual_cue": "排骨表面干爽，颜色微深"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到六成热，排骨分批下锅炸六分钟，捞出后升温复炸两分钟。",
      "time_min": 11,
      "heat": "中火",
      "tip": "复炸一次，外壳才酥，凉了也不回软。",
      "visual_cue": "排骨金黄结壳，敲击有脆响"
    },
    {
      "n": 5,
      "text": "另起锅放白糖与三十毫升水，小火熬到糖化起小泡，加生抽与一半米醋搅匀。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖水熬到微稠再下醋，酸甜才挂得住。",
      "visual_cue": "糖汁微黄起泡，能拉出细丝"
    },
    {
      "n": 6,
      "text": "倒入排骨中火翻炒，让每块都裹上糖醋汁，加葱段与姜片同炒。",
      "time_min": 3,
      "heat": "中火",
      "tip": "翻动要匀，糖汁受热快，一处没翻到就发黑。",
      "visual_cue": "排骨油亮裹汁，颜色枣红"
    },
    {
      "n": 7,
      "text": "临出锅淋入剩下的米醋，快速翻匀撒芝麻即可装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋分两次放，前面入甜，后面提酸香。",
      "visual_cue": "汁亮不流，表面撒的芝麻挂得牢"
    }
  ],
  "tips": [
    "排骨选肋排，肉厚骨小，炸出来最好吃。",
    "糖醋比按糖五十克配醋四十毫升，京味偏甜一点。",
    "没有温度计时可丢一小块葱白，周围冒小泡即为六成热。"
  ],
  "common_mistakes": [
    "排骨带水下油锅，油花四溅，手上容易被烫。",
    "不焯水直接炸，血沫封在里面，咬开一股腥味。",
    "糖汁熬过头变焦糖，倒进排骨满锅发苦。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "猪里脊",
      "ratio": "800克:700克",
      "note": "里脊无骨，炸四分钟即可，口感更嫩。"
    },
    {
      "original": "米醋",
      "substitute": "陈醋",
      "ratio": "40毫升:32毫升",
      "note": "陈醋色深，糖可减十克。"
    }
  ],
  "variations": [
    "把排骨换成鸡翅，做糖醋鸡翅，时间缩短一半。",
    "收汁时加一勺番茄酱，颜色红亮，酸甜更柔和。"
  ],
  "serving_suggestion": "热吃酥甜，凉吃有嚼劲，宴客和哄孩子都合适。",
  "storage": "冷藏可存两天，复热须下锅干煸两分钟再淋少许醋，微波会回软。",
