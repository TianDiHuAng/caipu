  "steps": [
    {
      "n": 1,
      "text": "黄鱼取净肉去皮，切成小丁，加料酒、盐与玉米淀粉抓匀腌十分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "鱼肉切小丁，口感才像海味白肉粒。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "鱼丁大小一致，表面带薄浆"
    },
    {
      "n": 2,
      "text": "鸡蛋蛋清与蛋黄分装两个碗，分别打散备用。趁热操作更顺手。",
      "time_min": 6,
      "heat": "无火",
      "tip": "分开炒才有白色蛋块与海味黄的两种口感。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "两碗蛋液颜色分明，无蛋筋"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下鱼丁中火滑炒到变白盛出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鱼丁一白就盛出，久炒就柴了。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "鱼丁发白不散，锅底无汤"
    },
    {
      "n": 4,
      "text": "锅留底油倒蛋清液，小火边推边炒成雪花状，加鱼丁与一半姜末炒匀。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蛋清小火慢推，才炒得雪白细嫩。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "蛋清成小雪花块，颜色洁白"
    },
    {
      "n": 5,
      "text": "盛出后另起锅倒蛋黄液，小火推炒成碎块，倒回蛋清锅中。",
      "time_min": 5,
      "heat": "小火",
      "tip": "蛋黄只要碎小块，炒老了像蛋皮。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "蛋黄呈橙黄色细碎颗粒"
    },
    {
      "n": 6,
      "text": "加香醋、白糖、盐与余下姜末快速翻匀，撒葱末出锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "醋和姜是赛螃海味的关键，缺一不像。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "成菜黄白相间，闻着有海味鲜香"
    }
  ],
  "tips": [
    "蛋清蛋黄分开炒，口感才像海味白肉海味黄。火候与时间都要盯紧，宁可略短也别过头。",
    "姜末和香醋是灵魂，别省。做之前把料备齐，下锅后就没空切配了。",
    "全程小火推炒，蛋才嫩不结块。这几步照顺序来，味道才会一层层叠上去。",
    "鱼肉可省，但加了更像海味白肉。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "蛋清蛋黄一起炒，口感单一还发黄。结果往往一锅好料全被这一步毁掉。",
    "大火炒蛋，块大又老像蛋皮。很多人就在这里翻车，出菜后才发现。",
    "没放醋和姜，吃起来只是炒鸡蛋。账面上看是小疏忽，入口立刻能尝出来。",
    "鱼丁久炒，干得像鸡肉丝。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "黄鱼",
      "substitute": "鲈鱼",
      "ratio": "250克:250克",
      "note": "肉质更嫩，滑炒时间缩短。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "20毫升:20毫升",
      "note": "酸味更清爽。"
    }
  ],
  "variations": [
    "不加鱼肉，纯用鸡蛋做素版。口味会更厚一些，适合重口的人。",
    "加一点海味菇，鲜味更接近海味白肉。做法不复杂，家常灶台就能完成。",
    "加两勺高汤同炒，口感更滑润。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装盘黄白相间，蘸一点姜醋吃，鲜味逼真，是老北京饭馆里哄孩子吃鱼的一道巧菜。",
  "storage": "冷藏不超过一天，复热用小火快炒一分钟，不宜久热。",
