  "equipment": [
    "锅",
    "盆",
    "裱花袋",
    "漏勺",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "清水、牛奶与黄油倒入锅中，加二十克白糖烧开至黄油化开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "要完全烧开再下面，烫不透会炸不鼓。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "液体翻滚，黄油完全融化无浮块"
    },
    {
      "n": 2,
      "text": "关火倒入全部面粉，用木铲快速搅拌成不粘锅的烫面团。",
      "time_min": 5,
      "heat": "无火",
      "tip": "顺着一个方向搅，面才上劲不散。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "面团成团脱离锅底，表面光滑"
    },
    {
      "n": 3,
      "text": "面团稍微放凉，分五次加蛋液，每次都搅到完全吸收。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蛋液必须一点点加，一次倒多会稀成糊。",
      "visual_cue": "面团软而能立住，铲子挑起缓慢垂落"
    },
    {
      "n": 4,
      "text": "面团装进带花嘴的裱花袋，挤成直径四厘米的小圆球备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "挤的时候大小要匀，炸的时候才同时熟。",
      "visual_cue": "圆球大小一致，花纹清晰"
    },
    {
      "n": 5,
      "text": "锅中植物油烧到五成热，下圆球小火炸三分钟至浮起。",
      "time_min": 5,
      "heat": "小火",
      "tip": "油温低一点慢慢炸，里面才熟得透。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "圆球浮起鼓胀，颜色浅黄"
    },
    {
      "n": 6,
      "text": "转中火再炸两分钟到金黄，捞出沥油滚上白糖即可。",
      "time_min": 3,
      "heat": "中火",
      "tip": "最后提高火力上色，表皮才脆。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "表面金黄酥脆，裹上白糖粒"
    }
  ],
  "tips": [
    "液体必须烧开再倒面，烫透才蓬松。火候与时间都要盯紧，宁可略短也别过头。",
    "蛋液分次加，面团才不稀。做之前把料备齐，下锅后就没空切配了。",
    "小火慢炸，里面才能熟透。这几步照顺序来，味道才会一层层叠上去。",
    "滚白糖要趁热，糖才粘得住。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "液体没开就倒面，炸出来又硬又小。结果往往一锅好料全被这一步毁掉。",
    "蛋液一次全倒，面团稀得挤不成形。很多人就在这里翻车，出菜后才发现。",
    "油温太高，外面焦了里面还是生面。账面上看是小疏忽，入口立刻能尝出来。",
    "炸好放凉才滚糖，糖粘不上。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "植物油",
      "ratio": "40克:35毫升",
      "note": "香气略淡，牛奶加十毫升。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "150毫升:150毫升",
      "note": "更清淡，甜度可加十克。"
    }
  ],
  "variations": [
    "面团里加一点香草精，香气更足。口味会更厚一些，适合重口的人。",
    "挤成大一点的圈状，做成炸糕圈。做法不复杂，家常灶台就能完成。",
    "滚糖换成滚糖粉与肉桂粉，风味更洋气。"
  ],
  "serving_suggestion": "趁热装盘，外壳酥脆、内里蓬松带奶香，配一杯红茶，是北京老点心铺里的招牌之一。",
  "storage": "当天吃完最好，剩下的密封冷藏可放一天，回温后用一百八十度烤四分钟恢复酥脆。",
