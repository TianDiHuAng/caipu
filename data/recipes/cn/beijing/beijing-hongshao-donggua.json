  "steps": [
    {
      "n": 1,
      "text": "冬瓜去皮去瓤，切成三厘米见方的块，表面切十字花刀便于入味。",
      "time_min": 12,
      "heat": "无火",
      "tip": "表面划刀口，冬瓜才吃得进酱味。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "瓜块棱角分明，表面有浅刀纹"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧热，下冬瓜块中火煎至表面微黄。",
      "time_min": 7,
      "heat": "中火",
      "tip": "先煎出焦边，冬瓜才不易煮烂。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "瓜块边缘金黄，体积略缩"
    },
    {
      "n": 3,
      "text": "下蒜片与姜末炒香，加生抽、老抽、蚝油与白糖翻匀上色。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酱料裹匀再加水，颜色才红亮。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "瓜块均匀上色，锅底油亮"
    },
    {
      "n": 4,
      "text": "加清水没过瓜块一半，大火烧开转中小火焖八分钟。",
      "time_min": 10,
      "heat": "中小火",
      "tip": "水别没过瓜块，焖出来才不水塌。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "汤汁微沸，瓜块半透明"
    },
    {
      "n": 5,
      "text": "加盐调味，淋玉米淀粉水勾薄芡，撒葱末出锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "薄芡裹住瓜块，酱汁才挂得住。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汤汁浓稠透亮，瓜块油润"
    }
  ],
  "tips": [
    "冬瓜先煎再烧，口感才不软塌。火候与时间都要盯紧，宁可略短也别过头。",
    "十字花刀让酱汁进得去。做之前把料备齐，下锅后就没空切配了。",
    "水量只到瓜块一半，收汁才快。这几步照顺序来，味道才会一层层叠上去。",
    "薄芡就好，厚了糊嘴。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "冬瓜没煎直接烧，出锅一夹就烂。结果往往一锅好料全被这一步毁掉。",
    "水加太多，烧成一锅冬瓜汤。很多人就在这里翻车，出菜后才发现。",
    "老抽放多，颜色发黑像酱菜。账面上看是小疏忽，入口立刻能尝出来。",
    "大火猛烧，瓜块碎成糊。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "冬瓜",
      "substitute": "节瓜",
      "ratio": "800克:800克",
      "note": "更紧实，焖的时间加三分钟。"
    },
    {
      "original": "蚝油",
      "substitute": "生抽",
      "ratio": "12毫升:12毫升",
      "note": "咸度更高，盐可省。"
    }
  ],
  "variations": [
    "加几片火腿同烧，鲜味更厚。口味会更厚一些，适合重口的人。",
    "加一把虾皮，海味更明显。做法不复杂，家常灶台就能完成。",
    "加一勺豆瓣酱，变成下饭的酱香版。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装盘撒葱花，瓜块软糯透明、酱汁红亮，配米饭能吃出肉味。",
  "storage": "冷藏可放一天，复热用小火加两勺清水焖三分钟。",
