  "equipment": [
    "炒锅",
    "砂锅",
    "刀",
    "砧板",
    "碗",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲍鱼用刷子刷净表面黑膜，取出内脏后冲洗干净，表面划十字花刀。",
      "time_min": 14,
      "heat": "无火",
      "tip": "黑膜一定要刷掉，不然汤会发苦。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "鲍鱼表面白净，花刀整齐"
    },
    {
      "n": 2,
      "text": "五花肉切三厘米方块，冷水下锅加料酒焯五分钟捞出冲净。",
      "time_min": 12,
      "heat": "大火",
      "tip": "冷水下锅焯，血沫出得净，汤才清。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "肉块发白，水面浮沫被撇净"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油下冰糖小火炒出褐色细泡，下五花肉翻炒上色。",
      "time_min": 7,
      "heat": "小火",
      "tip": "糖色到位再下肉，成色才红亮好看。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "肉块挂上均匀的枣红色"
    },
    {
      "n": 4,
      "text": "下姜片、葱段与八角炒香，加生抽、老抽、料酒与蚝油翻匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酱料先炒香再加汤，味道才厚不寡。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "肉块颜色深红，香气浓"
    },
    {
      "n": 5,
      "text": "加清水没过肉，大火烧开转小火加盖焖四十分钟。",
      "time_min": 43,
      "heat": "小火",
      "tip": "小火慢焖，五花肉才酥而不散。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汤汁小滚，肉块轻晃有弹性"
    },
    {
      "n": 6,
      "text": "下鲍鱼继续小火焖十二分钟，加盐调味后转大火收汁。",
      "time_min": 15,
      "heat": "大火",
      "tip": "鲍鱼后放，久煮会缩成硬块。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "鲍鱼卷曲成花，汤汁浓稠油亮"
    }
  ],
  "tips": [
    "鲍鱼黑膜必须刷净，否则带苦味。火候与时间都要盯紧，宁可略短也别过头。",
    "鲍鱼最后放，煮久就咬不动了。做之前把料备齐，下锅后就没空切配了。",
    "肉先焖到八分烂再下鲍鱼，两者口感才对。",
    "收汁用大火，汤汁才挂得住。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "鲍鱼没刷黑膜，整锅汤带苦。结果往往一锅好料全被这一步毁掉。",
    "鲍鱼一开始就下锅，缩成硬疙瘩。很多人就在这里翻车，出菜后才发现。",
    "糖色炒糊，红烧味变成焦苦味。账面上看是小疏忽，入口立刻能尝出来。",
    "收汁不收，端上桌成一碗汤。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "鲍鱼",
      "substitute": "鲜香菇",
      "ratio": "400克:200克",
      "note": "口感不同，但汤汁同样鲜。"
    },
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "500克:500克",
      "note": "更瘦，焖的时间加十分钟。"
    }
  ],
  "variations": [
    "加几片金华火腿同烧，鲜味更足。口味会更厚一些，适合重口的人。",
    "加一把西兰花垫底，摆盘更清爽。做法不复杂，家常灶台就能完成。",
    "改用整只鲍鱼不切花，上桌更有排面。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "砂锅上桌，鲍鱼弹牙、五花肉酥烂，酱汁拌饭一绝，是京味宴客桌上最拿得出手的一道。",
  "storage": "冷藏可放两天，复热加少量清水小火焖八分钟；鲍鱼不宜反复加热。",
