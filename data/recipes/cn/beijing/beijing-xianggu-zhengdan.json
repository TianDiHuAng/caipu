  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕入大碗打散，加盐搅匀后分次加温水，边加边搅。",
      "time_min": 8,
      "heat": "无火",
      "tip": "用温水调蛋液，蒸出来才嫩滑无孔。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "蛋液颜色均匀，表面浮细泡"
    },
    {
      "n": 2,
      "text": "蛋液过筛两遍去掉泡沫与蛋筋，静置三分钟。趁热操作更顺手。",
      "time_min": 6,
      "heat": "无火",
      "tip": "过筛是蛋面光滑的关键，别偷懒。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "蛋液细腻无泡，碗壁干净"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，下姜末与香菇末小火炒两分钟出香，加生抽炒匀。",
      "time_min": 5,
      "heat": "小火",
      "tip": "香菇先炒香再蒸，鲜味才透出来。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "香菇末油亮，香气浓色泽分明状态稳定"
    },
    {
      "n": 4,
      "text": "把香菇末铺在碗底，倒入蛋液，表面盖一层保鲜膜扎几个小孔。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盖膜防止水汽滴落，蛋面才平整。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "膜面绷平，扎孔分布均匀"
    },
    {
      "n": 5,
      "text": "蒸锅水烧开后放入碗，中小火蒸十二分钟。趁热操作更顺手。",
      "time_min": 15,
      "heat": "中小火",
      "tip": "水开后再上锅，中小火蒸蛋才不老。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "蛋面凝固平滑，轻晃不流动"
    },
    {
      "n": 6,
      "text": "取出揭膜，淋生抽与香油，撒葱花即可。趁热操作更顺手。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调味最后淋，蛋面才不会被冲花。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "蛋面镜面光滑，葱花点缀"
    }
  ],
  "tips": [
    "温水调蛋液，比例约一比一点五。火候与时间都要盯紧，宁可略短也别过头。",
    "过筛两遍，蛋面才像布丁。做之前把料备齐，下锅后就没空切配了。",
    "盖保鲜膜扎孔，防止水汽滴落。这几步照顺序来，味道才会一层层叠上去。",
    "中小火蒸，火大就成蜂窝。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "用冷水调蛋液，蒸出来发硬有孔。结果往往一锅好料全被这一步毁掉。",
    "不过筛，蛋面坑坑洼洼。很多人就在这里翻车，出菜后才发现。",
    "大火蒸，蛋液起大泡变蜂窝。账面上看是小疏忽，入口立刻能尝出来。",
    "蒸过头，蛋体出水与碗分离。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "香菇",
      "substitute": "口蘑",
      "ratio": "100克:100克",
      "note": "鲜味略淡，可加半勺蚝油。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "300克:320克",
      "note": "蛋香更浓，需多加五十毫升水。"
    }
  ],
  "variations": [
    "加几只虾仁同蒸，鲜味更足。口味会更厚一些，适合重口的人。",
    "加一勺剁椒同蒸，变成微辣版。做法不复杂，家常灶台就能完成。",
    "用高汤代替清水，味道更厚。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "端上桌时淋一勺热油，蛋面镜亮、菇香扑鼻，一勺挖下去嫩得颤。",
  "storage": "冷藏不超过一天，复热用蒸锅蒸五分钟，微波易起泡不建议。",
