  "steps": [
    {
      "n": 1,
      "text": "大葱切成长段，小葱切段，葱白葱绿分开摆放备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "葱白耐熬先下，葱绿易焦后下。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "葱段整齐，白绿分明色泽分明状态稳定"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，冷油下葱白，小火慢慢熬八分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "冷油下葱，香气才慢慢渗进油里。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "葱白转金黄，油面浮小泡"
    },
    {
      "n": 3,
      "text": "下葱绿继续小火熬四分钟，熬到葱段干瘪发黄后捞出。",
      "time_min": 6,
      "heat": "小火",
      "tip": "葱段一焦就要捞，焦了整锅油发苦。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "葱段干瘪焦黄，油色淡绿透亮"
    },
    {
      "n": 4,
      "text": "葱油里加生抽、老抽、白糖与盐，小火煮一分钟至糖化开。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酱汁入油会溅，火小一点慢慢搅。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "酱汁与油融合，颜色棕红"
    },
    {
      "n": 5,
      "text": "另锅水烧开下面条煮到刚断生，捞进碗里趁热浇葱油拌匀。",
      "time_min": 9,
      "heat": "大火",
      "tip": "面要趁热拌，热的才吃得进葱油。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "面条油亮棕红，根根分明"
    }
  ],
  "tips": [
    "葱油必须小火慢熬，大火会焦苦。火候与时间都要盯紧，宁可略短也别过头。",
    "葱白葱绿分开熬，香气层次才足。做之前把料备齐，下锅后就没空切配了。",
    "面趁热拌，凉了拌不进去油。这几步照顺序来，味道才会一层层叠上去。",
    "葱油多做一点，冷藏能放一周。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "大火熬葱，几秒就糊成黑色发苦。结果往往一锅好料全被这一步毁掉。",
    "葱段焦了不捞，整锅油都带焦味。很多人就在这里翻车，出菜后才发现。",
    "面条煮过头，拌完全断成碎段。账面上看是小疏忽，入口立刻能尝出来。",
    "面凉了才拌，油浮在表面吃不进去。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "大葱",
      "substitute": "小葱",
      "ratio": "200克:250克",
      "note": "香气更清，熬的时间缩短两分钟。"
    },
    {
      "original": "面条",
      "substitute": "细挂面",
      "ratio": "480克:400克",
      "note": "吸油多，葱油可多留一勺。"
    }
  ],
  "variations": [
    "加一勺猪油同熬，香气更厚。口味会更厚一些，适合重口的人。",
    "加几粒花椒同熬，回味带麻。做法不复杂，家常灶台就能完成。",
    "拌好后加一个煎蛋，一碗就顶饱。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "拌匀后趁热吃，面条油亮、葱香满口，配一碗紫菜蛋花汤就是一餐。",
  "storage": "葱油与面分开保存，葱油冷藏可放一周；面条现煮现拌最好吃。",
