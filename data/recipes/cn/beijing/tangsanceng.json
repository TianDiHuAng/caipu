{
  "schema_version": "1.0",
  "content_version": 1,
  "id": "tangsanceng",
  "name": {
    "zh": "糖三角",
    "en": "Steamed Brown Sugar Buns"
  },
  "cuisine": {
    "region": "cn",
    "style": "beijing"
  },
  "category": [
    "staple-bread"
  ],
  "difficulty": 2,
  "time": {
    "prep_min": 115,
    "cook_min": 20,
    "total_min": 135
  },
  "servings": 5,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 500,
          "unit": "g",
          "note": "普通面粉即可",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 5,
          "unit": "g",
          "note": "耐高糖酵母",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 250,
          "unit": "ml",
          "note": "约 35℃ 温水",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 120,
          "unit": "g",
          "note": "碾碎过筛",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "帮助发酵",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "蒸笼",
    "擀面杖",
    "湿布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "中筋面粉与酵母、白糖混匀，分次加清水揉成光滑不粘手的面团。",
      "time_min": 15,
      "heat": "无火",
      "tip": "水别一次倒完，面团偏硬才好塑形。",
      "visual_cue": "面团光滑、盆壁干净"
    },
    {
      "n": 2,
      "text": "面团盖湿布放在温暖处发酵 60 分钟，涨到原来两倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "温度 28℃ 左右发酵最稳。",
      "visual_cue": "体积两倍大、指压回弹慢"
    },
    {
      "n": 3,
      "text": "红糖用擀面杖碾碎过筛，拌入少许面粉调成糖馅备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糖里拌点面粉，蒸时不易流汁。",
      "visual_cue": "糖馅细腻、无硬块"
    },
    {
      "n": 4,
      "text": "面团排气后搓条，切成 10 个剂子，逐个擀成中间厚边缘薄的圆皮。",
      "time_min": 10,
      "heat": "无火",
      "tip": "中间留厚，捏三角时不破底。",
      "visual_cue": "圆皮大小一致、边缘略薄"
    },
    {
      "n": 5,
      "text": "每张圆皮放一勺糖馅，捏成三角形并把三条边收口捏紧。",
      "time_min": 12,
      "heat": "无火",
      "tip": "收口一定要捏严，否则糖会流出。",
      "visual_cue": "三角挺立、收口闭合"
    },
    {
      "n": 6,
      "text": "生坯摆入蒸笼醒发 15 分钟，水开后大火蒸 12 分钟，关火焖 3 分钟。",
      "time_min": 30,
      "heat": "大火",
      "tip": "关火焖三分钟再揭盖，表面不回缩。",
      "visual_cue": "表面白胖、按下去能弹回"
    }
  ],
  "tips": [
    "糖馅里拌少许面粉，蒸熟后不会四处流汁。",
    "收口捏紧是关键，露缝就会漏糖。",
    "关火后焖三分钟再揭盖，表皮不回缩。"
  ],
  "common_mistakes": [
    "面团没发透就上锅，成品硬实不发。",
    "三角收口没捏紧，蒸完糖汁流光。",
    "蒸好马上揭盖，馒头表面塌陷起皱。"
  ],
  "substitutions": [
    {
      "original": "红糖",
      "substitute": "黑糖",
      "ratio": "120g 对 120g",
      "note": "黑糖颜色更深、风味更浓。"
    },
    {
      "original": "中筋面粉",
      "substitute": "低筋面粉",
      "ratio": "500g 对 500g",
      "note": "口感更松软，但支撑力稍弱。"
    }
  ],
  "variations": [
    "芝麻糖馅版：红糖里加 30g 熟芝麻，香气更足。",
    "南瓜版：清水换成 260g 南瓜泥，色泽金黄。"
  ],
  "serving_suggestion": "趁热吃最香，配一碗小米粥就是一顿早饭。",
  "storage": "冷藏 2 天，复蒸 8 分钟即可恢复松软。",
