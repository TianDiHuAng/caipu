  "steps": [
    {
      "n": 1,
      "text": "芝麻酱放碗里，分四五次加清水，每次顺一个方向搅到完全吸收。",
      "time_min": 9,
      "heat": "无火",
      "tip": "水要一点点加，一次倒多就澥不开成疙瘩。",
      "visual_cue": "酱体顺滑能流动，挑起呈线状"
    },
    {
      "n": 2,
      "text": "酱里加生抽、盐、白糖与香油搅匀，蒜捣成泥用少量水调开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜泥用水调开再拌，味道才均匀不冲。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "酱汁浓稠顺滑，蒜水清亮"
    },
    {
      "n": 3,
      "text": "锅中水烧开，下面条煮到刚断生，捞出立刻过凉水冲两遍。",
      "time_min": 9,
      "heat": "大火",
      "tip": "面煮到刚断生就捞，过凉水才筋道不坨。",
      "visual_cue": "面条根根分明，表面不黏手"
    },
    {
      "n": 4,
      "text": "豆芽下开水烫三十秒捞出过凉，黄瓜切细丝备用。",
      "time_min": 4,
      "heat": "大火",
      "tip": "豆芽只烫一下，保持脆感才好吃。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "豆芽透亮，黄瓜丝均匀"
    },
    {
      "n": 5,
      "text": "面条沥干装碗，铺黄瓜丝与豆芽，浇麻酱、蒜水与陈醋拌匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "吃前再拌，面条才不会泡软。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "面条裹满麻酱，色泽浅褐油亮"
    }
  ],
  "tips": [
    "澥麻酱要一点点加水，急不得。火候与时间都要盯紧，宁可略短也别过头。",
    "面条过凉水冲两遍，才够筋道。做之前把料备齐，下锅后就没空切配了。",
    "蒜水用水调开，比直接放蒜泥温和。这几步照顺序来，味道才会一层层叠上去。",
    "吃前再拌，放久了面会坨。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "一次加太多水，麻酱结成疙瘩澥不开。结果往往一锅好料全被这一步毁掉。",
    "面条煮过头，拌完全断成小段。很多人就在这里翻车，出菜后才发现。",
    "不过凉水，面条黏成一坨夹不开。账面上看是小疏忽，入口立刻能尝出来。",
    "酱太稠直接拌，入口糊嘴还发干。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "120克:120克",
      "note": "甜味更重，盐可少放。"
    },
    {
      "original": "陈醋",
      "substitute": "香醋",
      "ratio": "25毫升:25毫升",
      "note": "酸味更柔，适合不喜酸的人。"
    }
  ],
  "variations": [
    "加一勺辣椒油，变成川味凉面。口味会更厚一些，适合重口的人。",
    "加几丝熟鸡肉，一碗顶饱。做法不复杂，家常灶台就能完成。",
    "加一勺芥末酱，京味更冲更开胃。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装碗后撒一把熟芝麻，拌开就吃，麻酱香、醋味酸、黄瓜脆，是北京夏天最解暑的一碗面。",
  "storage": "面与酱分开冷藏，可放一天；面条复热前用开水烫十秒再拌。",
