  "steps": [
    {
      "n": 1,
      "text": "牛肉块切成三厘米见方的块，冷水浸泡四十分钟去血水，中途换两次水。",
      "time_min": 42,
      "heat": "无火",
      "tip": "牛肉块血水多，泡透了炖出来的汤才清，腥味也去得干净。",
      "visual_cue": "肉块发白，水色转淡红"
    },
    {
      "n": 2,
      "text": "冷水下锅，加姜片与料酒，大火煮开撇净浮沫，煮五分钟捞出冲净。",
      "time_min": 9,
      "heat": "大火",
      "tip": "浮沫撇干净，汤才清亮，腥味也去得干净。",
      "visual_cue": "水面浮起厚厚一层灰白沫"
    },
    {
      "n": 3,
      "text": "炖锅倒植物油，下白糖小火炒到起泡变枣红，倒入牛肉块翻炒上色。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖色一冒小泡就下肉，炒老了整锅发苦。",
      "visual_cue": "糖浆枣红起泡，肉块裹色均匀"
    },
    {
      "n": 4,
      "text": "下葱段、姜片、蒜、八角、桂皮与香叶炒香，烹入料酒、生抽与老抽。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料提前炒一遍，靠热油把香气逼出来，比直接炖强。",
      "visual_cue": "香料飘香，肉块颜色深红"
    },
    {
      "n": 5,
      "text": "加开水没过牛肉，大火烧开转小火加盖炖一小时。",
      "time_min": 62,
      "heat": "小火",
      "tip": "必须加开水，冷水一激牛肉就紧，炖再久也发柴。",
      "visual_cue": "汤面微微冒泡，肉块浮起转动"
    },
    {
      "n": 6,
      "text": "下白萝卜块继续炖二十分钟，至萝卜透明、牛肉酥软。",
      "time_min": 22,
      "heat": "小火",
      "tip": "萝卜后放，久炖会烂在汤里，只剩甜水味。",
      "visual_cue": "萝卜透亮，筷子能插透牛肉"
    },
    {
      "n": 7,
      "text": "加盐调味，转大火收汁八分钟，汤汁浓亮后撒香菜出锅。",
      "time_min": 9,
      "heat": "大火",
      "tip": "收汁时要勤翻动，糖分多容易糊底，一糊整锅都苦。",
      "visual_cue": "汤汁浓稠挂肉，油光发亮"
    }
  ],
  "tips": [
    "牛肉块选带筋膜的，炖软后胶质丰厚，汤也更稠。",
    "炖的时候放两颗红枣，回甘更明显，颜色也深。",
    "第二天回锅再热一次，味道更透，汤能拌两碗饭。"
  ],
  "common_mistakes": [
    "牛肉不泡不焯直接炖，汤浑发腥，一股血味散不掉。",
    "中途加冷水，牛肉纤维骤然收缩，炖两小时还是硬。",
    "糖色炒过头才下肉，整锅发苦，怎么加糖都救不回。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "1000克:1000克",
      "note": "羊肉更嫩，炖的时间减二十分钟。"
    },
    {
      "original": "白萝卜",
      "substitute": "土豆",
      "ratio": "250克:300克",
      "note": "土豆易烂，炖的时间减到十分钟。"
    }
  ],
  "variations": [
    "把汤收得更干，做成京味的干烧牛肉，配饼夹着吃很香。",
    "加一把泡软的粉丝同炖，粉丝吸饱汤汁，比肉还抢手。"
  ],
  "serving_suggestion": "连汁浇在米饭上最香，也可以配馒头或面条，汤汁一点不浪费。",
  "storage": "冷藏可存三天，冷冻可存一个月，复热须小火加开水烧开。",
