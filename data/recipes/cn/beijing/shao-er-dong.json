  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "竹笋",
          "name_en": "bamboo shoot",
          "amount": 300,
          "unit": "g",
          "note": "选冬笋，切滚刀块",
          "optional": false
        },
        {
          "name": "香菇",
          "name_en": "shiitake mushroom",
          "amount": 150,
          "unit": "g",
          "note": "厚肉鲜菇，一切为二",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "提咸鲜",
          "optional": false
        },
        {
          "name": "蚝油",
          "name_en": "oyster sauce",
          "amount": 15,
          "unit": "g",
          "note": "增厚味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 6,
          "unit": "g",
          "note": "吊鲜",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 10,
          "unit": "g",
          "note": "切姜片",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 25,
          "unit": "ml",
          "note": "煸炒",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 200,
          "unit": "ml",
          "note": "烧制用",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 5,
          "unit": "ml",
          "note": "起锅增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅盖",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "竹笋去壳切滚刀块，冷水下锅煮八分钟去掉草酸与涩味，捞出冲凉。",
      "time_min": 10,
      "heat": "中火",
      "tip": "笋不焯水会发涩，煮到能插入筷子才算透。",
      "visual_cue": "笋块颜色转浅、闻起来没有生涩味"
    },
    {
      "n": 2,
      "text": "香菇洗净去蒂，大朵的一分为二，用干布吸去表面水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香菇水分擦干，下锅才煎得出香味不出水。",
      "visual_cue": "菇面干爽、菌褶完整"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到五成热，下姜片煸出香味后捞出不要。",
      "time_min": 3,
      "heat": "中火",
      "tip": "姜片煸香后取出，留香不留渣，成品更清爽。",
      "visual_cue": "油面有细纹、闻到姜香"
    },
    {
      "n": 4,
      "text": "下香菇中火煸炒三分钟到边缘微黄出香，再放笋块一同翻炒。",
      "time_min": 6,
      "heat": "中火",
      "tip": "香菇先单独煸，出水后再放笋，香味层次更清楚。",
      "visual_cue": "菇边金黄、锅底出现少量褐色汁"
    },
    {
      "n": 5,
      "text": "加生抽、蚝油、白糖与清水，大火烧开后转中小火盖盖烧十分钟。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "汤汁没过食材三分之二即可，太多收不干味会淡。",
      "visual_cue": "汤汁剩一半、笋块上色均匀"
    },
    {
      "n": 6,
      "text": "开盖转大火收汁到浓稠挂勺，淋香油翻匀出锅装盘。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁最后三十秒要不停翻，蚝油含糖极易糊底。",
      "visual_cue": "汤汁油亮裹住食材、锅底无余汁"
    }
  ],
  "tips": [
    "冬笋比春笋更紧实清甜，买不到时用春笋需多焯两分钟。",
    "香菇选肉厚未开伞的，香味浓且烧后不缩成薄片。",
    "全程不放蒜与辣椒，这道菜吃的是笋与菇的本味。"
  ],
  "common_mistakes": [
    "冬笋没有焯水，成品发涩，回味带麻。",
    "香菇水没擦干就下锅，煸的时候出水变成水煮。",
    "收汁时走开没看火，蚝油焦糖化发苦，整锅带糊味。"
  ],
  "substitutions": [
    {
      "original": "竹笋",
      "substitute": "茭白",
      "ratio": "300g 对 300g",
      "note": "茭白更嫩，烧制时间缩短到六分钟。"
    },
    {
      "original": "香菇",
      "substitute": "口蘑",
      "ratio": "150g 对 150g",
      "note": "口蘑水分多，需先干煸去水再烧。"
    }
  ],
  "variations": [
    "加一把百叶结同烧，做成素烧二冬加百叶，口感更丰富。",
    "改用鸡汤代替清水烧制，鲜味更厚，适合宴客版本。"
  ],
  "serving_suggestion": "装浅盘淋上锅里的浓汁，配白米饭或作为宴席素菜上桌。",
  "storage": "冷藏两天，复热时加少量清水小火回烧，不要用微波直接加热。",
