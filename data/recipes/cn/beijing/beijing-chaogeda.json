  "steps": [
    {
      "n": 1,
      "text": "面粉加清水和一小撮盐，揉成偏硬的面团。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面和硬一点，疙瘩才筋道。，注意火候。",
      "visual_cue": "面团紧实，按压回弹，状态稳定"
    },
    {
      "n": 2,
      "text": "面团盖布醒二十分钟，中途再揉一次。这一步不要着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "醒透再切，疙瘩才不粘刀。，注意火候。",
      "visual_cue": "面团光滑，手感柔韧，状态稳定"
    },
    {
      "n": 3,
      "text": "面团擀成半厘米厚片，切成小方丁，撒面防粘。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切小丁，煮的时候才容易熟透。，注意火候。",
      "visual_cue": "方丁均匀，粒粒分开，状态稳定"
    },
    {
      "n": 4,
      "text": "水烧开下疙瘩，煮到全部浮起再煮两分钟。这一步不要着急。",
      "time_min": 6,
      "heat": "大火",
      "tip": "浮起后再煮两分钟，中心才不夹生。，注意火候。",
      "visual_cue": "疙瘩浮面，捏着有弹性"
    },
    {
      "n": 5,
      "text": "捞出过一遍凉水，沥干后拌少许植物油。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过凉水让疙瘩更筋道不粘连。，注意火候。",
      "visual_cue": "颗粒松散，表面滑爽，状态稳定"
    },
    {
      "n": 6,
      "text": "炒锅倒植物油，下五花肉丁煸到出油微黄。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉丁煸出油，炒出来的疙瘩才香。，注意火候。",
      "visual_cue": "肉丁卷边，油脂清亮，状态稳定"
    },
    {
      "n": 7,
      "text": "加蒜末炒香，放胡萝卜丁和卷心菜丁大火翻炒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "蔬菜大火快炒，口感才脆。，注意火候。",
      "visual_cue": "菜色鲜亮，锅气足，状态稳定"
    },
    {
      "n": 8,
      "text": "倒入疙瘩，加酱油和盐翻炒到颜色均匀。这一步不要着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "酱油沿锅边淋，香气才激出来。，注意火候。",
      "visual_cue": "颜色均匀，颗粒分明，状态稳定"
    }
  ],
  "tips": [
    "面和硬一点，疙瘩煮完才筋道。，值得留意。",
    "过一遍凉水，颗粒不粘连。，值得留意。",
    "蔬菜大火快炒，脆感才留得住。，值得留意。"
  ],
  "common_mistakes": [
    "面和太软，疙瘩下锅就化成一团。，值得留意。",
    "煮过头，疙瘩外面糊里面散。，值得留意。",
    "蔬菜炒太久，出水变软。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "鸡腿肉",
      "ratio": "150 克:150 克",
      "note": "更清淡，可多加少许酱油。"
    },
    {
      "original": "卷心菜",
      "substitute": "白菜",
      "ratio": "200 克:200 克",
      "note": "出水更多，盐可略减。"
    }
  ],
  "variations": [
    "加一把青豆同炒，颜色更鲜。，值得留意。",
    "放一勺辣椒油，口味更重。，值得留意。"
  ],
  "serving_suggestion": "趁热装盘，配一碟醋蒜最地道。，效果更稳定。",
  "storage": "冷藏一天，复热用平底锅小火炒散。，效果更稳定。",
