  "steps": [
    {
      "n": 1,
      "text": "葱姜切末用三十毫升清水泡十分钟，滤出葱姜水；马蹄拍碎后切成细末。",
      "time_min": 14,
      "heat": "无火",
      "tip": "葱姜水比葱姜末更匀，肉馅里吃不出颗粒。",
      "visual_cue": "葱姜水色微黄，闻着辛香扑鼻"
    },
    {
      "n": 2,
      "text": "猪肉末加盐、生抽、料酒，分三次打入葱姜水，顺一个方向搅到上劲。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水要分次加，一次倒进去肉馅就稀了。",
      "visual_cue": "肉馅发黏拉丝，挑起不易掉"
    },
    {
      "n": 3,
      "text": "打入鸡蛋，加淀粉与马蹄末继续搅匀，摔打十几次排出空气。",
      "time_min": 8,
      "heat": "无火",
      "tip": "反复摔打能排出肉馅里的空气，丸子下锅才不会裂开。",
      "visual_cue": "肉馅细腻有弹性，按下去回弹"
    },
    {
      "n": 4,
      "text": "手上蘸水，把肉馅团成四个拳头大的丸子，两手来回摔成圆形。",
      "time_min": 6,
      "heat": "无火",
      "tip": "大小一致才一起熟，四喜讲究四个分明的圆。",
      "visual_cue": "丸子圆整光滑，表面无裂缝"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧到六成热，丸子沿锅边滑入，中火煎至四面金黄定型。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油要能没过丸子一半，煎定型才不怕散。",
      "visual_cue": "丸子表面结起金黄硬壳，定型不塌"
    },
    {
      "n": 6,
      "text": "砂锅底部铺白菜叶，摆入丸子，加开水至一半高，放八角、生抽、老抽与白糖。",
      "time_min": 6,
      "heat": "无火",
      "tip": "白菜叶垫在锅底防粘，还能吸掉一部分浮油，吃着不腻。",
      "visual_cue": "丸子稳稳坐在菜叶上，汤汁微红"
    },
    {
      "n": 7,
      "text": "大火烧开转小火加盖焖三十分钟，中途翻一次身，让上下都入味。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢焖才里外熟透，大火只会把外层煮散。",
      "visual_cue": "丸子膨起，筷子能插透"
    },
    {
      "n": 8,
      "text": "丸子盛入盘中，原汤过滤后加淀粉水勾薄芡，浇在丸子上撒香菜。",
      "time_min": 5,
      "heat": "中火",
      "tip": "芡要勾得薄，能挂住丸子又不糊口，这是京菜讲究的亮汁。",
      "visual_cue": "汤汁透亮微稠，浇下缓缓流淌"
    }
  ],
  "tips": [
    "肉馅选三肥七瘦，全瘦的丸子是柴的，肥的才香。",
    "马蹄可用莲藕代替，脆感一样，还多一股清甜。",
    "一次多做几个，冷冻起来蒸一蒸就是一盘待客菜。"
  ],
  "common_mistakes": [
    "葱姜水一次全倒进去，肉馅稀得团不成球，一煎就散。",
    "不摔打直接下锅，丸子中间有空洞，切开全是缝。",
    "大火猛炖，外层煮散在汤里，只剩一团碎肉。"
  ],
  "substitutions": [
    {
      "original": "马蹄",
      "substitute": "莲藕",
      "ratio": "80克:80克",
      "note": "莲藕水分少些，葱姜水可多加十毫升。"
    },
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "500克:500克",
      "note": "牛肉末更瘦，需多加淀粉十克防散。"
    }
  ],
  "variations": [
    "把丸子做成小个上锅蒸二十分钟，就是宴席上的清蒸小丸子。",
    "汤汁里加一勺蚝油同烧，酱香更浓，颜色也更亮。"
  ],
  "serving_suggestion": "四个丸子一盘上桌，取福禄寿喜之意，配米饭或馒头都合适。",
  "storage": "冷藏可存三天，冷冻可存一个月，复热须蒸十五分钟，风味接近现做。",
