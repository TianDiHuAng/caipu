  "steps": [
    {
      "n": 1,
      "text": "大白菜洗净，菜帮斜刀片成薄片，菜叶撕成大片分开放。",
      "time_min": 10,
      "heat": "无火",
      "tip": "菜帮斜片才易熟，菜叶后放不出水。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "菜帮薄片透光，菜叶分开摆放"
    },
    {
      "n": 2,
      "text": "香醋、生抽、白糖、盐与玉米淀粉加两勺清水调成碗汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "碗汁先调好，醋溜讲究一气呵成。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "碗汁浅棕透亮，碗底无沉淀"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下干辣椒段、姜末与蒜片小火炒香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "干辣椒小火炒，大火一糊就发苦。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "辣椒转深红色，香气冲鼻"
    },
    {
      "n": 4,
      "text": "转大火下白菜帮翻炒两分钟至边缘变透明。趁热操作更顺手。",
      "time_min": 4,
      "heat": "大火",
      "tip": "全程大火，白菜才脆不出水。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "菜帮边缘透明，锅里有少量水"
    },
    {
      "n": 5,
      "text": "下白菜叶大火翻炒一分钟至叶子塌软。趁热操作更顺手。",
      "time_min": 2,
      "heat": "大火",
      "tip": "菜叶一塌就倒汁，炒久就黄了。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "菜叶变深绿塌软，体积减半"
    },
    {
      "n": 6,
      "text": "顺着锅边倒入碗汁，快速翻炒至汤汁浓稠，淋香油出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "汁一稠立即关火，久炒醋味全跑。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "汤汁裹住菜叶，盘底不见汤"
    }
  ],
  "tips": [
    "菜帮斜片、菜叶手撕，口感才对。火候与时间都要盯紧，宁可略短也别过头。",
    "全程大火，白菜才脆。做之前把料备齐，下锅后就没空切配了。",
    "碗汁最后倒，醋香才留得住。这几步照顺序来，味道才会一层层叠上去。",
    "糖的作用是压酸，尝不出甜为准。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "小火慢炒，白菜出一锅水变成炖菜。结果往往一锅好料全被这一步毁掉。",
    "醋早放，酸味挥发只剩涩。很多人就在这里翻车，出菜后才发现。",
    "菜帮菜叶一起下锅，叶子烂了帮还硬。账面上看是小疏忽，入口立刻能尝出来。",
    "芡勾太厚，凉了结成一坨。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "陈醋",
      "ratio": "30毫升:28毫升",
      "note": "颜色更深，糖加三克。"
    },
    {
      "original": "大白菜",
      "substitute": "娃娃菜",
      "ratio": "700克:600克",
      "note": "更嫩，炒的时间缩短一分钟。"
    }
  ],
  "variations": [
    "加几片五花肉同炒，香气更足。口味会更厚一些，适合重口的人。",
    "加一把泡发木耳，口感层次更多。做法不复杂，家常灶台就能完成。",
    "加少许花椒油，麻香更京味。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "趁热装盘，菜帮脆、菜叶软、酸香开胃，配红烧肉或元宝肉解腻最合适。",
  "storage": "冷藏可放一天，复热用大火快炒一分钟，久热会出水发酸。",
