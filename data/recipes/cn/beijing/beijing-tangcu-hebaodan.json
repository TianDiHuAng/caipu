  "steps": [
    {
      "n": 1,
      "text": "平底锅倒植物油烧热，逐个磕入鸡蛋，中小火煎成荷包蛋。",
      "time_min": 9,
      "heat": "中小火",
      "tip": "蛋磕进锅里别动，等底部结壳再挪。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "蛋形完整圆润，边缘微焦"
    },
    {
      "n": 2,
      "text": "煎好的荷包蛋逐个盛出放在盘里，保持蛋黄半熟。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋黄半熟，后面裹汁才不会干。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "蛋黄表面有一层薄膜色泽分明状态稳定"
    },
    {
      "n": 3,
      "text": "番茄酱、白糖、香醋、生抽、盐与清水调成糖醋汁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "汁先调匀，裹汁时才有时间控制火候。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "汁液橙红透亮，无结块"
    },
    {
      "n": 4,
      "text": "锅留底油下姜末与蒜末小火炒香。趁热操作更顺手。",
      "time_min": 3,
      "heat": "小火",
      "tip": "姜蒜炒香打底，糖醋味才有层次。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "蒜末微黄，香气散出色泽分明状态稳定"
    },
    {
      "n": 5,
      "text": "倒入糖醋汁小火煮到冒泡，淋玉米淀粉水勾成薄芡。",
      "time_min": 4,
      "heat": "小火",
      "tip": "汁熬到起泡再下蛋，才裹得住。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汁液浓稠发亮，铲子划过留痕"
    },
    {
      "n": 6,
      "text": "把荷包蛋放回锅中，小火两面各裹汁三十秒，撒葱花出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "轻轻推锅别用铲子翻，蛋才不破。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "蛋面裹满红亮酱汁，葱花点缀"
    }
  ],
  "tips": [
    "蛋煎得边缘微焦，口感才对。火候与时间都要盯紧，宁可略短也别过头。",
    "糖醋比例按三比二，甜在前酸在后。做之前把料备齐，下锅后就没空切配了。",
    "裹汁用推锅的方式，蛋不容易破。这几步照顺序来，味道才会一层层叠上去。",
    "酱汁勾薄芡，挂得住又不糊嘴。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "蛋煎得太老，蛋黄全干没口感。结果往往一锅好料全被这一步毁掉。",
    "大火煮糖醋汁，一下就糊底发苦。很多人就在这里翻车，出菜后才发现。",
    "用铲子猛翻，荷包蛋全破成碎块。账面上看是小疏忽，入口立刻能尝出来。",
    "醋放太早煮久，酸味跑光只剩甜。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "番茄酱",
      "substitute": "番茄沙司",
      "ratio": "40克:40克",
      "note": "更甜，糖可减五克。"
    },
    {
      "original": "香醋",
      "substitute": "苹果醋",
      "ratio": "25毫升:25毫升",
      "note": "果香更明显。"
    }
  ],
  "variations": [
    "加一点辣椒酱，做成甜辣版。口味会更厚一些，适合重口的人。",
    "配白饭盖成蛋盖饭，孩子最爱。做法不复杂，家常灶台就能完成。",
    "加几片洋葱同炒，甜味更自然。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装盘浇上红亮酱汁，蛋黄半熟一戳就流，酸甜汁拌饭能吃两碗。",
  "storage": "冷藏不超过一天，复热用小火加两勺清水焖两分钟。",
