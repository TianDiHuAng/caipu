        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "蒸锅",
    "刀",
    "漏勺",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "淀粉加少许盐，分次倒入五百毫升清水搅成完全无颗粒的稀糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "一定要搅到没有疙瘩，蒸出来才细腻。",
      "visual_cue": "糊体顺滑，舀起能连成线"
    },
    {
      "n": 2,
      "text": "稀糊倒入抹了油的平盘，厚度约三厘米，表面刮平。",
      "time_min": 4,
      "heat": "无火",
      "tip": "厚度要一致，太厚中心蒸不透，太薄切不成形。",
      "visual_cue": "糊面平整光滑，盘边擦得干净"
    },
    {
      "n": 3,
      "text": "上蒸锅大火蒸四十分钟，至完全透明、按压有弹性。",
      "time_min": 41,
      "heat": "大火",
      "tip": "蒸到全透明才算熟，中间发白就是没透。",
      "visual_cue": "整块透亮如琥珀，按下去回弹"
    },
    {
      "n": 4,
      "text": "蒸好的粉块取出彻底放凉，凉透后才好切，切成半厘米厚的斜片。",
      "time_min": 12,
      "heat": "无火",
      "tip": "热着切必定粘刀，等完全凉透再下刀，片形才整齐利落。",
      "visual_cue": "片形完整，边缘光滑不拉丝"
    },
    {
      "n": 5,
      "text": "蒜捣成泥，加生抽、米醋与少许凉开水调成蒜汁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜要用捣的不要切，捣出来的蒜泥才够冲，切的味道发闷。",
      "visual_cue": "蒜汁乳白微稠，辛香直冲鼻子"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油烧热，粉片逐片下锅，中火煎到两面鼓起起泡。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎到表面起小泡、边缘卷起，外脆里软才正宗。",
      "visual_cue": "两面金黄起泡，边缘微微卷"
    },
    {
      "n": 7,
      "text": "煎好的灌肠码进盘中，趁热把蒜汁浇上去即可食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蒜汁要现浇现吃，凉了就没那股冲劲。",
      "visual_cue": "蒜汁浸入孔隙，表面泛光"
    }
  ],
  "tips": [
    "红薯淀粉做的灌肠口感最弹，玉米淀粉偏脆。",
    "煎的时候用铲子轻压，能让粉片受热更均匀。",
    "老北京吃法是用竹签扎着蘸蒜汁，一口一片。"
  ],
  "common_mistakes": [
    "粉糊没搅匀就上锅蒸，成品里全是白疙瘩。",
    "粉块没凉透就切，刀一压就粘成一片，切不出形。",
    "油温太高下锅，外面焦了里面还是凉的。"
  ],
  "substitutions": [
    {
      "original": "淀粉",
      "substitute": "绿豆淀粉",
      "ratio": "250克:250克",
      "note": "绿豆淀粉更透亮，口感偏脆。"
    },
    {
      "original": "米醋",
      "substitute": "陈醋",
      "ratio": "5毫升:4毫升",
      "note": "陈醋味重，蒜汁里可多兑点水。"
    }
  ],
  "variations": [
    "把蒜汁换成麻酱加韭菜花，是老北京另一种吃法。",
    "粉糊里加少许五香粉，风味更足，接近早年灌肠的味道。"
  ],
  "serving_suggestion": "趁热蘸蒜汁吃，配一碗豆汁或面茶，就是老北京的早点组合。",
  "storage": "粉块冷藏可存三天，切片后现煎现吃，久放会返生发硬。",
