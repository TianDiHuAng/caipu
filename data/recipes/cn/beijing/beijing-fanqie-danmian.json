  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用开水烫一分钟后去皮，切成小块。",
      "time_min": 9,
      "heat": "无火",
      "tip": "去皮后汤才顺滑，不会有卷起的皮。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "番茄皮轻松撕下，果肉切块出汁"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加两克盐搅匀，炒锅倒植物油烧热后倒入蛋液炒成块盛出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "蛋液下锅先别动，等底部凝固再翻。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "蛋块蓬松金黄，块形完整"
    },
    {
      "n": 3,
      "text": "锅留底油下姜末炒香，倒番茄块中火炒到出汁变软。",
      "time_min": 5,
      "heat": "中火",
      "tip": "番茄要炒出红汤，汤底才有酸甜底味。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "番茄塌软出红汁，锅底无整块"
    },
    {
      "n": 4,
      "text": "加清水烧开，放生抽、盐与白糖，小火煮三分钟成汤。",
      "time_min": 7,
      "heat": "大火",
      "tip": "糖只为平衡酸味，尝一口别吃出甜。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "汤色红亮，浮着细碎番茄块"
    },
    {
      "n": 5,
      "text": "另锅烧水煮面条至刚断生，捞进碗里。趁热操作更顺手。",
      "time_min": 8,
      "heat": "大火",
      "tip": "面煮到刚断生就捞，泡汤里还会再熟。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "面条散开，掐断中间留白点"
    },
    {
      "n": 6,
      "text": "汤里倒回蛋块煮一分钟，把汤浇在面上，撒葱花淋香油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋块最后回锅，久了会散成絮状。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "蛋块完整浮在汤面，汤色红黄分明"
    }
  ],
  "tips": [
    "番茄去皮，汤才顺滑不挂皮。火候与时间都要盯紧，宁可略短也别过头。",
    "番茄多炒一会儿，红汤才够浓。做之前把料备齐，下锅后就没空切配了。",
    "糖是平衡酸味的关键，别省。这几步照顺序来，味道才会一层层叠上去。",
    "面与汤分开煮，汤才清不糊。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "番茄没炒出汁就加水，汤味寡淡。结果往往一锅好料全被这一步毁掉。",
    "鸡蛋炒得太老，回锅后发硬。很多人就在这里翻车，出菜后才发现。",
    "面条直接下汤锅，汤变稠发糊。账面上看是小疏忽，入口立刻能尝出来。",
    "糖放太多，变成一道甜品汤。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "500克:400克",
      "note": "酸度更稳，糖可少放。"
    },
    {
      "original": "面条",
      "substitute": "挂面",
      "ratio": "450克:400克",
      "note": "吸汤多，汤要多加一百毫升。"
    }
  ],
  "variations": [
    "加一把青菜心同煮，一餐更完整。口味会更厚一些，适合重口的人。",
    "加半勺番茄酱，汤色更红更浓。做法不复杂，家常灶台就能完成。",
    "换成疙瘩汤做法，更适合冬天。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "盛碗后撒葱花，红汤黄蛋、面条筋道，早上或加班回来煮一碗都合适。",
  "storage": "汤与面分开冷藏可放一天；复热汤须烧沸，面条另煮以免糊软。",
