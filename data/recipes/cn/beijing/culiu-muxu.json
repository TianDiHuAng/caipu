  "equipment": [
    "炒锅",
    "锅铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆纹切 2mm 薄片，加料酒、5g 玉米淀粉与 1g 盐抓匀，腌 10 分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纹切才嫩，淀粉上浆锁住肉汁。",
      "visual_cue": "肉片薄而均匀、表面挂浆"
    },
    {
      "n": 2,
      "text": "木耳泡发后撕小朵，焯水 1 分钟捞出；鸡蛋打散加少许盐备用。",
      "time_min": 4,
      "heat": "中火",
      "tip": "木耳焯水可去杂质，也更易炒熟。",
      "visual_cue": "木耳卷曲、沥干无积水"
    },
    {
      "n": 3,
      "text": "小碗中调入香醋、生抽、白糖、3g 玉米淀粉与 60ml 清水，搅匀成碗汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "碗汁先调好，旺火快炒才不慌乱。",
      "visual_cue": "碗汁无颗粒、色泽棕褐"
    },
    {
      "n": 4,
      "text": "锅烧热下 20ml 植物油，倒入蛋液炒成大块蛋片盛出。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蛋块炒得稍老一点，回锅后不易碎。",
      "visual_cue": "蛋块金黄、体积膨松"
    },
    {
      "n": 5,
      "text": "补 25ml 油，大火下牛肉片滑散，变色后下姜末与木耳翻炒 1 分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "牛肉七成熟即可，回锅还会再受热。",
      "visual_cue": "牛肉变色、锅底无血水"
    },
    {
      "n": 6,
      "text": "倒回蛋块与葱段，淋碗汁快速翻炒至汁浓挂料，出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "碗汁入锅前再搅一次，淀粉易沉底。",
      "visual_cue": "汁浓发亮、酸香扑鼻"
    }
  ],
  "tips": [
    "醋香是灵魂，香醋要在碗汁中加足，久炒会挥发。",
    "木耳可用 100g 黄瓜片替代，做成黄瓜木须。",
    "北京馆子的木须讲究「三色」，蛋黄、肉褐、木耳黑。"
  ],
  "common_mistakes": [
    "碗汁不勾芡，出锅后汤汁稀散挂不住料。",
    "牛肉不按逆纹切，炒出来嚼不动、口感发柴。",
    "蛋与肉一起下锅猛炒，蛋碎成渣、肉变老。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "猪里脊",
      "ratio": "150g 牛肉 ≈ 150g 猪里脊",
      "note": "猪里脊更嫩，腌 5 分钟即可。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋酸味更柔，白糖加到 8g。"
    }
  ],
  "variations": [
    "家庭简化版：不勾芡，把碗汁收干成干香口味。",
    "清真版：不加木耳改用 100g 黄花菜，同样经典。"
  ],
  "serving_suggestion": "配米饭或荷叶饼，北京家常馆子的经典下饭菜。",
  "storage": "冷藏 1 天，复热加 20ml 清水与 3ml 香醋回锅，补回酸味。",
