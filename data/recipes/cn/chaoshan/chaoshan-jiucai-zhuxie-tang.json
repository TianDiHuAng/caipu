  "equipment": [
    "汤锅",
    "砧板",
    "刀",
    "汤勺",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪血切成两厘米见方的块，放入清水中泡五分钟，洗去表面血水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡一下再煮，汤才清亮，不会有那股铁腥味。",
      "visual_cue": "血块表面干净，水色微红"
    },
    {
      "n": 2,
      "text": "汤锅放植物油，下姜丝小火煸出香味，加清水九百毫升转大火烧开。",
      "time_min": 5,
      "heat": "大火",
      "tip": "姜丝先下锅煮两分钟，去腥的底味才出来。",
      "visual_cue": "水面翻滚，姜香与油香飘出"
    },
    {
      "n": 3,
      "text": "下猪血块，转中火煮八分钟，其间用汤勺撇净表面浮沫。",
      "time_min": 9,
      "heat": "中火",
      "tip": "猪血要煮透，中心不能见红，煮不透吃着不安全。",
      "visual_cue": "血块颜色转深，浮沫撇净"
    },
    {
      "n": 4,
      "text": "加盐与鱼露调味，搅匀后先尝一口汤的咸淡，再决定是否补盐。",
      "time_min": 1,
      "heat": "中火",
      "tip": "鱼露带咸，盐要少放，宁淡勿咸，后面还能补。",
      "visual_cue": "汤色清亮见底，咸鲜适口"
    },
    {
      "n": 5,
      "text": "韭菜段下锅，保持中火煮一分半，见叶片转深绿立刻关火。",
      "time_min": 2,
      "heat": "中火",
      "tip": "韭菜一烫就熟，煮久了发黄发软，香气也没了。",
      "visual_cue": "韭菜碧绿挺立，汤面浮起油花"
    },
    {
      "n": 6,
      "text": "淋香油，撒白胡椒与小葱切成的葱花，盛入大碗趁热喝。",
      "time_min": 1,
      "heat": "无火",
      "tip": "白胡椒现磨才够冲，去腥暖胃，粉状的差一截。",
      "visual_cue": "热气腾腾，胡椒与葱香扑鼻"
    }
  ],
  "tips": [
    "猪血买回来先泡水，煮的时候撇沫，汤才清不腥。",
    "韭菜分两次下，一半煮出香味，一半关火前放，颜色才好看。",
    "潮汕人喝这碗汤爱配一勺普宁豆酱，咸鲜里多一点豆香。"
  ],
  "common_mistakes": [
    "猪血切太薄，一煮就碎成渣，捞都捞不起来。",
    "韭菜和猪血一起下锅，等猪血熟透韭菜已经化成黄泥。",
    "省略撇沫这一步，汤浑味腥，怎么调味都盖不住。"
  ],
  "substitutions": [
    {
      "original": "猪血",
      "substitute": "鸭血",
      "ratio": "400克:400克",
      "note": "鸭血质地更嫩，煮六分钟即可。"
    },
    {
      "original": "韭菜",
      "substitute": "小白菜",
      "ratio": "150克:180克",
      "note": "小白菜耐煮一些，可多煮三十秒。"
    }
  ],
  "variations": [
    "加一把粉丝同煮，汤水变成主食，是潮汕夜宵摊的做法。",
    "换成猪红配豆芽，酸辣口味，加一勺米醋更开胃。"
  ],
  "serving_suggestion": "趁滚烫盛碗上桌，撒白胡椒，配一碗白粥或粿条就是一顿宵夜。",
  "storage": "建议现做现喝，冷藏不超过一天；复热须彻底煮沸，猪血久放易变质。",
