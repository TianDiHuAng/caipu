  "equipment": [
    "汤锅",
    "蒸屉",
    "刀",
    "砧板",
    "盘子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去腮，从腹部开小口取出内脏不用水冲。",
      "time_min": 12,
      "heat": "无火",
      "tip": "潮汕做法不冲水，鱼肉更鲜甜。，看准状态再往下做。",
      "visual_cue": "鱼身完整，腹内干净"
    },
    {
      "n": 2,
      "text": "用盐把鱼身内外抹一遍，腌十五分钟。，看准状态再往下做。",
      "time_min": 18,
      "heat": "无火",
      "tip": "盐能紧肉，也让鱼皮不易破。，看准状态再往下做。",
      "visual_cue": "鱼身微湿，盐粒化开"
    },
    {
      "n": 3,
      "text": "汤锅放清水、姜片和葱结，大火烧开。，看准状态再往下做。",
      "time_min": 7,
      "heat": "大火",
      "tip": "水要够多，鱼才浸得均匀。，看准状态再往下做。",
      "visual_cue": "水面翻滚，香气散出"
    },
    {
      "n": 4,
      "text": "鱼放进锅里，水保持将开未开的状态。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "水大滚鱼皮就破，肉也散。，看准状态再往下做。",
      "visual_cue": "水面微动，鱼身浸没"
    },
    {
      "n": 5,
      "text": "小火浸煮十二分钟，用筷子插背鳍处试熟。，看准状态再往下做。",
      "time_min": 14,
      "heat": "小火",
      "tip": "插进去无血水就是熟了。，看准状态再往下做。",
      "visual_cue": "鱼肉发白，鱼眼凸出"
    },
    {
      "n": 6,
      "text": "捞出鱼放凉，让鱼肉收紧再切块。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "凉了再切，肉块才整。，看准状态再往下做。",
      "visual_cue": "鱼皮紧实，肉不散，这一点很关键。"
    },
    {
      "n": 7,
      "text": "鱼切成厚块码盘，皮朝上摆整齐。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切厚一点，口感才饱满。，看准状态再往下做。",
      "visual_cue": "块形方正，皮面完整"
    },
    {
      "n": 8,
      "text": "普宁豆酱加香油调成蘸碟，配鱼上桌。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豆酱咸，蘸一点就够。，看准状态再往下做。",
      "visual_cue": "酱色浅褐，香气清咸"
    }
  ],
  "tips": [
    "鱼不用剖腹冲水，鲜味才留得住。，这一点很关键。",
    "水保持微沸浸熟，鱼肉才嫩不散。，这一点很关键。",
    "放凉再切，鱼块才成型。，这一点很关键。"
  ],
  "common_mistakes": [
    "水大滚下鱼，鱼皮全破。，这一点很关键。",
    "煮过头，鱼肉散成渣。，这一点很关键。",
    "热的时候切，肉块全碎。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "巴浪鱼",
      "ratio": "800 克:700 克",
      "note": "更小，浸煮时间减到八分钟。"
    },
    {
      "original": "普宁豆酱",
      "substitute": "黄豆酱",
      "ratio": "30 克:30 克",
      "note": "甜一些，咸度略低。"
    }
  ],
  "variations": [
    "鱼放凉后冷藏一夜，做成冻鱼饭。，这一点很关键。",
    "蘸桔油吃，酸甜解腻。，这一点很关键。"
  ],
  "serving_suggestion": "配白粥，就是潮汕人的一餐。，这一点很关键。",
  "storage": "冷藏两天，冷冻两周；复热蒸五分钟。",
