  "equipment": [
    "砂锅",
    "漏勺",
    "砧板",
    "刀",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成两厘米厚的方块，用厨房纸吸干表面水分，静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆腐表面越干，下锅越不粘，也越容易煎出硬壳。",
      "visual_cue": "豆腐表面无水光，边缘齐整"
    },
    {
      "n": 2,
      "text": "炒锅放植物油烧到五成热，豆腐块下锅中小火煎至两面金黄，捞出沥油。",
      "time_min": 9,
      "heat": "中火",
      "tip": "煎出硬壳再卤，豆腐才不散，也更能吃进卤汁。",
      "visual_cue": "两面金黄，边缘挺立不塌"
    },
    {
      "n": 3,
      "text": "砂锅放少许底油，下大蒜、姜片与小葱结小火炒香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "香料只炒到出味就够，炒焦了整个卤汁都带苦。",
      "visual_cue": "蒜瓣边缘微黄，香味散开"
    },
    {
      "n": 4,
      "text": "加清水、生抽、老抽、冰糖、八角、桂皮与香叶，大火烧开后转小火煮十分钟出味。",
      "time_min": 13,
      "heat": "小火",
      "tip": "卤汁先熬十分钟再下豆腐，香料味才融得进汤里。",
      "visual_cue": "汤色红亮油润，香料香气浓郁"
    },
    {
      "n": 5,
      "text": "放入煎好的豆腐，小火卤十二分钟，中途轻轻推动两次防粘底。",
      "time_min": 13,
      "heat": "小火",
      "tip": "推动要用锅铲背贴着锅底推，翻动太猛豆腐会碎。",
      "visual_cue": "豆腐吸汁鼓起，表面油亮"
    },
    {
      "n": 6,
      "text": "加盐调咸淡，转大火收汁三分钟，让卤汁挂在豆腐表面。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁时别走开，糖分高，一晃神就糊底发苦。",
      "visual_cue": "卤汁浓稠挂勺，豆腐色泽深褐"
    },
    {
      "n": 7,
      "text": "关火撒上香菜段，连砂锅端上桌，趁热吃最香。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香菜最后放，砂锅余温一烫就香，早放就烂了。",
      "visual_cue": "砂锅冒热气，香菜翠绿"
    }
  ],
  "tips": [
    "卤水豆腐用北豆腐，老豆腐质地紧实，卤久了也不散。",
    "老卤水越用越香，用完滤渣冷藏，下次补点香料与生抽即可。",
    "豆腐先煎后卤，表面有硬壳，咬开里面还是嫩的，口感才有层次。"
  ],
  "common_mistakes": [
    "豆腐不吸干水就下锅，油花四溅，煎出来还粘成一坨。",
    "卤汁调得太咸，收汁后味道更集中，整锅咸得下不了口。",
    "大火卤制，豆腐外皮被冲散，最后捞起来只剩碎块。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "豆腐皮",
      "ratio": "600克:200克",
      "note": "豆腐皮易入味，卤八分钟即可。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "20克:15克",
      "note": "白糖甜度高，用量减少以免发齁。"
    }
  ],
  "variations": [
    "卤豆腐里加几个水煮蛋同卤，就是潮汕卤味摊的常见搭配。",
    "把豆腐换成豆干，卤后切片冷吃，是下酒的小菜。"
  ],
  "serving_suggestion": "砂锅端上桌配白饭，卤汁浇饭最香；也可放凉切片当冷盘，佐工夫茶。",
  "storage": "冷藏可存三天，卤汁与豆腐一起密封更入味；复热时加两勺清水小火煮开，防止越煮越咸。",
