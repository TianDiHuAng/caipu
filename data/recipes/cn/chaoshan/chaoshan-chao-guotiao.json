  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "筷子",
    "盘子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆纹切成薄片，加淀粉和一点生抽抓匀。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切才有嫩度，顺纹嚼不动。，看准状态再往下做。",
      "visual_cue": "片薄均匀，表面浆亮"
    },
    {
      "n": 2,
      "text": "河粉用手轻轻抖散，粘连的地方撕开。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "提前抖散，下锅才不结块。，看准状态再往下做。",
      "visual_cue": "条条分开，不断不碎"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟，倒植物油滑一遍锅再倒出。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "热锅滑油，河粉才不粘锅底。，看准状态再往下做。",
      "visual_cue": "锅壁挂油，光可鉴人"
    },
    {
      "n": 4,
      "text": "补油下牛肉片，大火快速划散盛出。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "牛肉断生就盛，回锅还要再炒。，看准状态再往下做。",
      "visual_cue": "肉片变色，边缘微卷"
    },
    {
      "n": 5,
      "text": "锅里倒蛋液炒成蛋块，盛出备用。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蛋炒得嫩一点，回锅不散。，看准状态再往下做。",
      "visual_cue": "蛋块蓬松，颜色金黄"
    },
    {
      "n": 6,
      "text": "下河粉，用筷子抖散翻炒，沿锅边淋清水。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "淋水防粘，一次别倒太多。，看准状态再往下做。",
      "visual_cue": "河粉松开，锅气升腾"
    },
    {
      "n": 7,
      "text": "加生抽、老抽和沙茶酱，快速翻匀上色。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "酱要沿锅边淋，香气更冲。，看准状态再往下做。",
      "visual_cue": "河粉裹色，色泽酱红"
    },
    {
      "n": 8,
      "text": "倒回牛肉、蛋块，加豆芽和韭菜大火翻匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "韭菜最后十秒，脆嫩才好吃。，看准状态再往下做。",
      "visual_cue": "豆芽断生，韭菜翠绿"
    },
    {
      "n": 9,
      "text": "尝味补盐，出锅装盘趁热吃。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "河粉吸味，盐要最后放。，看准状态再往下做。",
      "visual_cue": "干爽不粘，油亮诱人"
    }
  ],
  "tips": [
    "热锅滑油再炒，河粉才不粘成团。，这一点很关键。",
    "用筷子抖散比锅铲翻更不易断。，这一点很关键。",
    "沙茶酱是潮汕炒粿条的关键风味。，这一点很关键。"
  ],
  "common_mistakes": [
    "锅不够热，河粉全粘在锅底。，这一点很关键。",
    "一次下太多，河粉炒不透。，这一点很关键。",
    "韭菜早放，炒成黄软条。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "河粉",
      "substitute": "米粉",
      "ratio": "400 克:350 克",
      "note": "更细，炒的时间减一分钟。"
    },
    {
      "original": "牛肉",
      "substitute": "猪肉",
      "ratio": "150 克:150 克",
      "note": "口感更软，腌时多加淀粉。"
    }
  ],
  "variations": [
    "加几只鲜虾，升级成海鲜炒粿条。，这一点很关键。",
    "淋一勺沙茶酱在盘边，蘸着吃。，这一点很关键。"
  ],
  "serving_suggestion": "趁热吃，配一碗清汤。，这一点很关键。",
  "storage": "冷藏一天，复热炒锅快炒。，这一点很关键。",
