    "锅铲",
    "砧板",
    "刀",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白鲳鱼刮净表面细鳞，剖腹去内脏与黑膜，冲洗干净后在鱼身两面各划三刀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腹腔黑膜要去净，那是腥味的来源，划刀则让咸味吃进去。",
      "visual_cue": "鱼身干爽无水光，刀口齐整"
    },
    {
      "n": 2,
      "text": "用厨房纸把鱼身内外彻底擦干，抹薄薄一层盐，静置八分钟。",
      "time_min": 9,
      "heat": "无火",
      "tip": "鱼皮必须擦干，带水下锅必粘，一翻面就破皮。",
      "visual_cue": "鱼皮无水光，手感干涩"
    },
    {
      "n": 3,
      "text": "普宁豆酱剁细，加生抽、白砂糖与六十毫升清水调匀成酱汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豆酱颗粒粗，剁细了才挂得住鱼身，也不会一口咸一口淡。",
      "visual_cue": "酱汁呈黄褐色，质地均匀"
    },
    {
      "n": 4,
      "text": "炒锅烧热放植物油，转动锅让油铺满锅底，下白鲳鱼中小火煎四分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鱼下锅后别急着翻，等它自己脱锅，硬翻必然破皮。",
      "visual_cue": "鱼皮金黄定型，边缘翘起"
    },
    {
      "n": 5,
      "text": "用两把铲子轻轻翻面，再煎三分钟至两面金黄，盛出备用。",
      "time_min": 4,
      "heat": "中火",
      "tip": "两把铲子托着翻，鱼身完整不散，这是煎鱼的老办法。",
      "visual_cue": "两面金黄焦香，鱼身完整不破"
    },
    {
      "n": 6,
      "text": "原锅留底油，下姜片、大蒜末与红辣椒圈小火炒香，倒入酱汁烧开。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆酱下锅容易糊，火要小，闻到酱香就加水。",
      "visual_cue": "酱汁冒小泡，香味浓郁"
    },
    {
      "n": 7,
      "text": "放回白鲳鱼，加料酒与清水两百二十毫升，中小火焖十分钟，中途舀汁淋面两次。",
      "time_min": 12,
      "heat": "中火",
      "tip": "不要翻动鱼身，用勺子把汁淋上去，鱼才不散。",
      "visual_cue": "汤汁收至一半，鱼眼凸出"
    },
    {
      "n": 8,
      "text": "撒小葱段与姜丝，转大火收汁两分钟，连汁一起滑入盘中。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁要晃锅不要铲，铲子一推鱼尾就断。",
      "visual_cue": "汤汁浓稠挂鱼身，油光发亮"
    }
  ],
  "tips": [
    "普宁豆酱是潮汕三宝之一，咸香带一点发酵的甜，焖鱼最能出彩。",
    "鱼要选一斤半左右的白鲳，肉厚刺少，焖完不散。",
    "煎鱼前把锅烧到冒烟再下油，锅热鱼才不粘，这比不粘锅更管用。"
  ],
  "common_mistakes": [
    "鱼没擦干就下锅，油花四溅，鱼皮粘在锅底撕不下来。",
    "豆酱直接下锅炒，火一大就发黑发苦，整锅酱味变糊味。",
    "焖的时候不停翻鱼，最后端上桌只剩鱼头鱼尾，中间全是碎肉。"
  ],
  "substitutions": [
    {
      "original": "白鲳鱼",
      "substitute": "黄鱼",
      "ratio": "900克:900克",
      "note": "黄鱼肉质更嫩，焖制时间缩到八分钟。"
    },
    {
      "original": "普宁豆酱",
      "substitute": "黄豆酱",
      "ratio": "35克:40克",
      "note": "黄豆酱偏甜，白砂糖可减到两克。"
    }
  ],
  "variations": [
    "加一把潮州咸菜同焖，酸咸解腻，是汕头人家的做法。",
    "把鱼换成鲳鱼块先煎后焖，更容易入味，适合新手。"
  ],
  "serving_suggestion": "整条鱼连汁上桌，配白饭浇汁最下饭，另备一碟青菜平衡咸味。",
  "storage": "冷藏可存一天，复热时加两勺清水小火焖三分钟；鱼肉不耐久放，不建议冷冻后再焖。",
