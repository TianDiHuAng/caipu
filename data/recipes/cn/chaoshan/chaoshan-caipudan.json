  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "萝卜干切成小丁，用清水泡十分钟去掉多余盐分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡一下减咸，不然整盘发齁。，看准状态再往下做。",
      "visual_cue": "萝卜干回软，水色微黄"
    },
    {
      "n": 2,
      "text": "挤干萝卜干的水分，用手攥得越干越好。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水分挤干，下锅才不会爆油。，看准状态再往下做。",
      "visual_cue": "干爽成团，体积缩小"
    },
    {
      "n": 3,
      "text": "鸡蛋打进碗里，加白糖和白胡椒粉打散。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糖提鲜，胡椒压蛋腥。，看准状态再往下做。",
      "visual_cue": "蛋液起泡，颜色均匀"
    },
    {
      "n": 4,
      "text": "平底锅倒一半植物油，中火下萝卜干丁炒香。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "萝卜干先炒，香气才出得来。，看准状态再往下做。",
      "visual_cue": "丁粒微焦，咸香扑鼻"
    },
    {
      "n": 5,
      "text": "炒好的萝卜干倒进蛋液里，撒葱花拌匀。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热拌，蛋液吸收萝卜干的香。，看准状态再往下做。",
      "visual_cue": "蛋液裹料，分布均匀"
    },
    {
      "n": 6,
      "text": "锅里补剩下的植物油，转小火倒入蛋液。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "小火慢煎，底面才金黄不焦。，看准状态再往下做。",
      "visual_cue": "蛋液铺满锅底，这一点很关键。"
    },
    {
      "n": 7,
      "text": "底面凝固后翻面，再煎一分钟至全熟。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "翻面前晃锅，蛋饼能动才好翻。，看准状态再往下做。",
      "visual_cue": "两面金黄，边缘微焦"
    },
    {
      "n": 8,
      "text": "出锅切块，趁热配粥吃。，看准状态再往下做。，动作要轻，别把食材弄碎。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃，蛋香最浓。，看准状态再往下做。",
      "visual_cue": "块形方正，蛋香扑鼻"
    }
  ],
  "tips": [
    "萝卜干先泡再挤干，咸淡才适中。，这一点很关键。",
    "全程小火煎，火大了外面焦里面生。",
    "蛋液里加一点糖，鲜味更突出。，这一点很关键。"
  ],
  "common_mistakes": [
    "萝卜干不泡，咸得下不去口。，这一点很关键。",
    "大火煎，底面焦黑里面还流汁。，这一点很关键。",
    "翻面太早，蛋饼碎成块。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "萝卜干",
      "substitute": "梅菜",
      "ratio": "80 克:80 克",
      "note": "甜一些，糖可减半。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4 个:4 个",
      "note": "蛋香更浓，腥味也重。"
    }
  ],
  "variations": [
    "加一勺虾米，鲜味更足。，这一点很关键。",
    "放几粒豆豉，咸香更浓。，这一点很关键。"
  ],
  "serving_suggestion": "早餐配白粥，简单又满足。，这一点很关键。",
  "storage": "冷藏一天，复热用平底锅小火。，这一点很关键。",
