  "steps": [
    {
      "n": 1,
      "text": "猪蹄用刀刮净表皮残毛，斩成四厘米见方的块。，看准状态再往下做。",
      "time_min": 15,
      "heat": "无火",
      "tip": "刮净表皮，成品才没有异味。，看准状态再往下做。",
      "visual_cue": "表皮发白，块形方正"
    },
    {
      "n": 2,
      "text": "冷水下锅焯水，加姜片煮五分钟去血沫。，看准状态再往下做。",
      "time_min": 9,
      "heat": "大火",
      "tip": "冷水下锅，血沫才逼得干净。，看准状态再往下做。",
      "visual_cue": "浮沫聚边，汤色发浑"
    },
    {
      "n": 3,
      "text": "捞出用温水冲洗，把附着的浮沫全部洗掉。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "不冲净，卤水很快变浑发腥。，看准状态再往下做。",
      "visual_cue": "块面干净，水清，这一点很关键。"
    },
    {
      "n": 4,
      "text": "汤锅放清水、生抽、老抽、冰糖和盐烧开。，看准状态再往下做。",
      "time_min": 8,
      "heat": "大火",
      "tip": "调味先烧开，咸淡才试得准。，看准状态再往下做。",
      "visual_cue": "汤色红亮，咸香扑鼻"
    },
    {
      "n": 5,
      "text": "加八角、桂皮、姜和蒜，小火煮十分钟出味。，看准状态再往下做。",
      "time_min": 12,
      "heat": "小火",
      "tip": "香料先煮，卤水才带底香。，看准状态再往下做。",
      "visual_cue": "香气浓郁，汤面轻沸"
    },
    {
      "n": 6,
      "text": "下猪蹄大火烧开，转小火卤三十分钟。，看准状态再往下做。",
      "time_min": 33,
      "heat": "小火",
      "tip": "小火慢卤，胶质才糯不散。，看准状态再往下做。",
      "visual_cue": "表皮发亮，汤色渐深"
    },
    {
      "n": 7,
      "text": "翻动一次，再卤二十分钟让味道吃进肉里。，看准状态再往下做。",
      "time_min": 21,
      "heat": "小火",
      "tip": "翻动让上下咸淡一致。，看准状态再往下做。",
      "visual_cue": "肉质软糯，筷子可插"
    },
    {
      "n": 8,
      "text": "大火收浓汤汁，让猪蹄挂上一层亮汁。，看准状态再往下做。",
      "time_min": 8,
      "heat": "大火",
      "tip": "收汁时勤翻，糖分容易糊底。，看准状态再往下做。",
      "visual_cue": "汁液浓稠，皮面油亮"
    },
    {
      "n": 9,
      "text": "捞出放凉，斩小块串成圈状上桌。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "稍凉再切，胶质才不粘刀。，看准状态再往下做。",
      "visual_cue": "块形整齐，胶质透亮"
    }
  ],
  "tips": [
    "表皮要刮净，不然成品带毛腥味。，这一点很关键。",
    "小火慢卤，胶质才糯而不散。，这一点很关键。",
    "收汁时勤翻，糖分容易糊锅。，这一点很关键。"
  ],
  "common_mistakes": [
    "大火卤，猪皮裂开肉散。，这一点很关键。",
    "焯水不冲净，卤水发腥。，这一点很关键。",
    "收汁不收，汁水汪汪不挂味。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪蹄",
      "substitute": "猪肘",
      "ratio": "900 克:900 克",
      "note": "肉多胶质少，卤的时间加十分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "红糖",
      "ratio": "25 克:25 克",
      "note": "颜色更深，焦香更重。"
    }
  ],
  "variations": [
    "加两个干辣椒，微辣更开胃。，这一点很关键。",
    "卤好后再炸一遍，皮更酥。，这一点很关键。"
  ],
  "serving_suggestion": "当零食啃，或配啤酒。，这一点很关键。",
  "storage": "冷藏三天，冷冻一个月；复热蒸十分钟。",
