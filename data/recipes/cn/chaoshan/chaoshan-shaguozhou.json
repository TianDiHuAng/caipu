          "note": "潮汕冬菜，切碎，可用榨菜末替代",
          "optional": false
        },
        {
          "name": "猪里脊",
          "name_en": "pork tenderloin",
          "amount": 100,
          "unit": "g",
          "note": "切片，用少许生抽与淀粉抓匀",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 1800,
          "unit": "ml",
          "note": "鸡汤或清水，清水更清甜",
          "optional": false
        },
        {
          "name": "盐",
