          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
