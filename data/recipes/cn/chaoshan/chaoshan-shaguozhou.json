        }
      ]
    }
  ],
  "equipment": [
    "砂锅",
    "木勺",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后泡 30 分钟，沥干后拌入 5 毫升植物油，静置 10 分钟。",
      "time_min": 40,
      "heat": "无火",
      "tip": "拌油能让米粒分明，粥体不糊。",
      "visual_cue": "米粒表面泛油光，粒粒分散"
    },
    {
      "n": 2,
      "text": "砂锅倒高汤烧开，下米粒，用木勺顺时针搅动防止粘底，中火煮 25 分钟。",
      "time_min": 27,
      "heat": "中火",
      "tip": "猪里脊片先用生抽与玉米淀粉抓匀，煮后才嫩滑不柴。",
      "visual_cue": "米粒开花、粥体浓稠，勺背挂一层米浆"
    },
    {
      "n": 3,
      "text": "猪里脊片与姜丝下锅，煮 3 分钟至肉片完全变白断生。",
      "time_min": 3,
      "heat": "中火",
      "tip": "肉片切薄，久煮会老。",
      "visual_cue": "肉片蜷起变白，粥面重新冒泡"
    },
    {
      "n": 4,
      "text": "放入虾与冬菜，煮 2 分钟至虾身卷曲变红、壳色转橘红。",
      "time_min": 2,
      "heat": "中火",
      "tip": "虾最后放，煮久肉质发硬。",
      "visual_cue": "虾壳转橘红、虾身弯成 C 形"
    },
    {
      "n": 5,
      "text": "加盐与白胡椒调味，淋香油，撒葱花与香菜，离火静置 3 分钟后食用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "离火静置让粥体收稠，温度也适口。",
      "visual_cue": "粥面浮一层米油，香气浓而不腥"
    }
  ],
  "tips": [
    "米泡过再煮，20 多分钟就能开花。",
    "全程用木勺搅动，砂锅底才不会结焦。",
    "冬菜是潮汕粥的隐形调味，别一次放太多。"
  ],
  "common_mistakes": [
    "冷水下米且中途不搅，粥底结焦发苦。",
    "虾与肉同时下锅久煮，海鲜老、肉片柴。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "蟹或蛤蜊",
      "ratio": "按重量 1:1",
      "note": "蟹需先斩件炒香，蛤蜊要吐沙 2 小时。"
    },
    {
      "original": "冬菜",
      "substitute": "榨菜末",
      "ratio": "1:1",
      "note": "榨菜更咸，盐量需减 2 克。"
    }
  ],
  "variations": [
    "加膏蟹做成潮汕蟹粥，鲜味更浓。",
    "加干贝与蚝豉做成干货版，适合冬季。"
  ],
  "serving_suggestion": "砂锅直接上桌，配一小碟鱼露辣椒与油条。",
  "storage": "冷藏 1 天，复热加 100 毫升清水小火煮开，粥会越煮越稠。",
