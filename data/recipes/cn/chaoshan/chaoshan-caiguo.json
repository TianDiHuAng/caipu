        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "炒锅",
    "盆",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "粘米粉倒进盆里，冲入三百五十毫升烧滚的清水，边冲边用筷子搅成絮状。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水必须滚开，粉才烫得熟、皮才透亮。",
      "visual_cue": "粉团成絮，没有干粉颗粒"
    },
    {
      "n": 2,
      "text": "稍凉后用手揉成光滑粉团，盖上湿布防干裂，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "粉团偏软才包得住馅，硬了会开裂。",
      "visual_cue": "粉团按下去有弹性"
    },
    {
      "n": 3,
      "text": "韭菜洗净晾干水分切成碎末，虾米用温水泡软后切碎。",
      "time_min": 10,
      "heat": "无火",
      "tip": "韭菜一定晾干，带水下馅会出汤破皮。",
      "visual_cue": "韭菜末松散不结团"
    },
    {
      "n": 4,
      "text": "韭菜末、虾米碎加猪油、盐和白胡椒拌匀，静置五分钟入味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "猪油是灵魂，别换成其他油，香气完全不同。",
      "visual_cue": "馅料油润发亮有光泽"
    },
    {
      "n": 5,
      "text": "粉团揪成三十克一个的剂子，压成中间厚边缘薄的圆皮。",
      "time_min": 6,
      "heat": "无火",
      "tip": "边缘薄才捏得紧，厚了蒸完有硬边。",
      "visual_cue": "皮子圆整，中间略厚"
    },
    {
      "n": 6,
      "text": "包入馅料捏成半月形，收口捏紧，摆进刷了油的蒸笼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "馅别塞太满，蒸的时候会被顶破露馅。",
      "visual_cue": "收口严密，形状饱满"
    },
    {
      "n": 7,
      "text": "蒸锅水开后上笼，大火蒸十二分钟，出锅刷一层薄猪油。",
      "time_min": 15,
      "heat": "大火",
      "tip": "水开再上笼，冷水上锅粿皮会塌陷。",
      "visual_cue": "粿皮半透明能看到馅"
    }
  ],
  "tips": [
    "烫粉的水必须是刚烧开的滚水，粉才熟透。",
    "韭菜提前晾干水分，馅不出汤皮就不破。",
    "蒸好趁热刷一层薄猪油，皮亮而且不粘。"
  ],
  "common_mistakes": [
    "用温水烫粉，粉团粗糙包不住馅。",
    "韭菜带水下馅，蒸完皮全破成花。",
    "馅塞太满，收口被顶开直接露馅。"
  ],
  "substitutions": [
    {
      "original": "虾米",
      "substitute": "干香菇",
      "ratio": "30 克:30 克",
      "note": "泡软切碎，素食版本香气也足。"
    },
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "25 克:25 克",
      "note": "香气稍淡，皮光泽差一些。"
    }
  ],
  "variations": [
    "馅里加少许炒香的花生碎，口感更脆。",
    "包好后用平底锅煎一下，做成煎粿更香。"
  ],
  "serving_suggestion": "趁热装盘，配一碟辣椒酱或鱼露蘸着吃，潮汕人常当早点或下午茶。",
  "storage": "冷藏两天，复热用蒸锅蒸五分钟或平底锅煎至两面微焦。",
