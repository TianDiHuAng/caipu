  "steps": [
    {
      "n": 1,
      "text": "整只鹅冲洗干净，拔净细毛，剪去尾部油脂腺。，看准状态再往下做。",
      "time_min": 18,
      "heat": "无火",
      "tip": "尾腺不去，卤出来有一股腥臊味。，看准状态再往下做。",
      "visual_cue": "鹅皮光洁，无残毛，这一点很关键。"
    },
    {
      "n": 2,
      "text": "鹅放冷水锅里焯水，加姜片和料酒去腥。，看准状态再往下做。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅，血沫才会慢慢逼出来。，看准状态再往下做。",
      "visual_cue": "浮沫厚厚一层，汤变浑"
    },
    {
      "n": 3,
      "text": "捞出鹅用温水冲净浮沫，擦干表面水分。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冲净浮沫，卤水才清不腥。，看准状态再往下做。",
      "visual_cue": "鹅身干净，皮面紧实"
    },
    {
      "n": 4,
      "text": "汤锅放清水、生抽、老抽、冰糖和盐烧开。，看准状态再往下做。",
      "time_min": 8,
      "heat": "大火",
      "tip": "先调味再下鹅，咸淡才好掌握。，看准状态再往下做。",
      "visual_cue": "汤色深褐，咸香扑鼻"
    },
    {
      "n": 5,
      "text": "下八角、桂皮、花椒、姜、蒜和葱结，小火煮十分钟。",
      "time_min": 12,
      "heat": "小火",
      "tip": "香料先煮出味，卤水才够香。，看准状态再往下做。",
      "visual_cue": "香气浓郁，汤面微沸"
    },
    {
      "n": 6,
      "text": "整鹅放进卤水，大火烧开后转最小火卤。，看准状态再往下做。",
      "time_min": 8,
      "heat": "小火",
      "tip": "水面只冒小泡，滚大了肉就柴。，看准状态再往下做。",
      "visual_cue": "鹅身浸没，汤面轻晃"
    },
    {
      "n": 7,
      "text": "卤四十分钟翻一次面，让两面都入味。，看准状态再往下做。",
      "time_min": 45,
      "heat": "小火",
      "tip": "翻面一次，上下咸淡才均匀。，看准状态再往下做。",
      "visual_cue": "鹅皮上色，颜色渐深"
    },
    {
      "n": 8,
      "text": "再卤四十分钟，用筷子插腿根看有无血水。，看准状态再往下做。",
      "time_min": 45,
      "heat": "小火",
      "tip": "插不进或冒血水都要再卤。，看准状态再往下做。",
      "visual_cue": "汁水清亮，鹅肉熟透"
    },
    {
      "n": 9,
      "text": "关火让鹅在卤水里浸泡半小时，捞出晾凉。，看准状态再往下做。",
      "time_min": 32,
      "heat": "无火",
      "tip": "泡着入味，凉了再切才不散。，看准状态再往下做。",
      "visual_cue": "鹅皮发亮，肉质紧实"
    },
    {
      "n": 10,
      "text": "鹅斩成整齐的块，摆盘淋一勺卤水。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刀要快，一刀断骨肉才好看。，看准状态再往下做。",
      "visual_cue": "块形方正，皮色红亮"
    }
  ],
  "tips": [
    "卤水保持微沸，滚大了鹅肉就柴。，这一点很关键。",
    "关火后泡半小时，味道才进得去。，这一点很关键。",
    "斩件前一定要晾凉，热切肉会散。，这一点很关键。"
  ],
  "common_mistakes": [
    "一直大火卤，鹅肉又老又硬。，这一点很关键。",
    "尾腺没剪，整锅带腥臊。，这一点很关键。",
    "热的时候斩件，肉碎不成块。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鹅肉",
      "substitute": "鸭肉",
      "ratio": "1500 克:1300 克",
      "note": "卤的时间减三十分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "40 克:35 克",
      "note": "上色稍浅，甜味相近。"
    }
  ],
  "variations": [
    "卤水里加一勺南姜末，潮汕味更正。",
    "卤好的鹅用卤水泡一夜，更入味。，这一点很关键。"
  ],
  "serving_suggestion": "斩件配蒜泥醋，或夹馒头吃。，这一点很关键。",
  "storage": "冷藏三天，冷冻一个月；复热蒸十分钟或淋卤水煮热。",
