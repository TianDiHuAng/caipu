      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "盆",
    "刀",
    "砧板",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "韭菜洗净沥干，切成三毫米的碎段，摊开备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "韭菜一定沥干水，湿的会把粿皮泡软。",
      "visual_cue": "韭菜碎松散不结团"
    },
    {
      "n": 2,
      "text": "虾米用温水泡软，捞出沥干水分后切成小粒备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "泡虾米的水留着，可以代替部分清水。",
      "visual_cue": "虾米变软，颗粒分明"
    },
    {
      "n": 3,
      "text": "粘米粉和玉米淀粉混匀，冲入滚烫的清水，边冲边用筷子快速搅成团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水必须是滚开的，才能把粉烫熟成团。",
      "visual_cue": "粉团成型，表面略带光泽"
    },
    {
      "n": 4,
      "text": "趁热加入猪油和盐，揉成不粘手的光滑粉团。",
      "time_min": 5,
      "heat": "无火",
      "tip": "手上抹点植物油，揉的时候不粘。",
      "visual_cue": "粉团光滑，按压有弹性"
    },
    {
      "n": 5,
      "text": "韭菜碎拌入虾米粒和少许盐，淋上植物油拌匀成馅。",
      "time_min": 5,
      "heat": "无火",
      "tip": "馅最后再拌，早了会出水，粿皮容易塌陷。",
      "visual_cue": "馅料干爽，颜色翠绿"
    },
    {
      "n": 6,
      "text": "粉团分成乒乓球大小的剂子，压成中间厚四周薄的圆皮，包入韭菜馅收口。",
      "time_min": 12,
      "heat": "无火",
      "tip": "收口要捏紧，蒸的时候才不会漏馅。",
      "visual_cue": "粿坯饱满，收口平整"
    },
    {
      "n": 7,
      "text": "蒸屉铺湿布，粿坯间留出空隙，大火蒸到表皮透明。",
      "time_min": 10,
      "heat": "大火",
      "tip": "蒸的时间别不足，皮不透明就是没熟。",
      "visual_cue": "粿皮半透明，能隐约看见绿色"
    }
  ],
  "tips": [
    "烫面一定要用滚水，粉团才够黏能包。",
    "韭菜最后拌馅，出水少、颜色绿。",
    "蒸屉留足空隙，粿坯涨开会粘在一起。"
  ],
  "common_mistakes": [
    "用温水烫粉，粉团散得包不住馅。",
    "韭菜提前拌盐，蒸完一屉粿皮全泡烂。",
    "收口没捏紧，蒸出来馅全跑光，粿皮只剩个空壳。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "包菜",
      "ratio": "300 克:300 克",
      "note": "口感更清甜，需切碎后挤干水分。"
    },
    {
      "original": "虾米",
      "substitute": "干香菇",
      "ratio": "30 克:40 克",
      "note": "素馅版本，香菇要泡软切细丁。"
    }
  ],
  "variations": [
    "馅里加一勺沙茶酱，潮汕味更浓。",
    "喜欢荤口可加少量炒香的猪肉粒。"
  ],
  "serving_suggestion": "蒸好趁热吃，蘸一小碟沙茶酱或辣椒酱，皮糯馅香。",
  "storage": "冷藏两天，复蒸五分钟回软，也可冷锅少油煎到两面微焦。",
