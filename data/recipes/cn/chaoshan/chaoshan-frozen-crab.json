  "equipment": [
    "蒸锅",
    "冰箱",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青蟹用刷子刷净蟹壳与蟹脚缝隙，冲洗后沥干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "缝隙里泥沙多，要多刷两遍。",
      "visual_cue": "蟹壳干净，无泥沙残留"
    },
    {
      "n": 2,
      "text": "蒸锅加水放姜片与葱结，大火烧到蒸汽充足上汽。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水先烧开再放蟹，肉才紧实。",
      "visual_cue": "锅盖边缘冒大量白汽"
    },
    {
      "n": 3,
      "text": "蟹腹朝上摆进蒸锅，淋上米酒，盖盖大火蒸十二分钟。",
      "time_min": 12,
      "heat": "大火",
      "tip": "蟹腹朝上，切面才不会流失。",
      "visual_cue": "蟹壳转红，蟹脚收紧"
    },
    {
      "n": 4,
      "text": "关火后焖三分钟再开盖，让蟹肉内部温度均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "焖一下，蟹肉中心才完全熟透。",
      "visual_cue": "蟹壳鲜红，蒸汽带蟹香"
    },
    {
      "n": 5,
      "text": "蒸好的蟹盛出摊开放凉，不要立刻冷藏免得回腥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先放凉再冰，肉质才紧不腥。",
      "visual_cue": "蟹身不烫手，表面干爽"
    },
    {
      "n": 6,
      "text": "放凉后装盘盖保鲜膜，冷藏两小时让肉质收紧。",
      "time_min": 120,
      "heat": "无火",
      "tip": "冷藏后蟹肉更弹，风味更清。",
      "visual_cue": "蟹身冰凉，肉质紧实"
    },
    {
      "n": 7,
      "text": "姜末、生抽、香醋、白糖与干辣椒圈调成蘸汁静置。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蘸汁提前调，姜味才渗出来。",
      "visual_cue": "蘸汁红褐，浮着姜末"
    },
    {
      "n": 8,
      "text": "取出冻蟹斩成两半，摆盘后撒上香菜碎点缀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "刀要快，切面才整齐不散。",
      "visual_cue": "蟹肉雪白，切面透亮"
    }
  ],
  "tips": [
    "蟹一定要鲜活，死蟹不适合蒸食。",
    "蒸好先放凉再冷藏，肉质才紧实不腥。",
    "冷藏两小时风味最佳，时间过长肉会发干。"
  ],
  "common_mistakes": [
    "蟹没有刷洗干净，吃起来会带沙。",
    "蒸好直接进冰箱，蟹肉回腥发软。",
    "冷藏超过一夜，蟹肉失水变得发柴。"
  ],
  "substitutions": [
    {
      "original": "青蟹",
      "substitute": "青蟹",
      "ratio": "900 克:900 克",
      "note": "肉质更厚，蒸制时间加三分钟。"
    },
    {
      "original": "香醋",
      "substitute": "浙醋",
      "ratio": "15 毫升:15 毫升",
      "note": "酸味更柔和，甜感更明显。"
    }
  ],
  "variations": [
    "蘸汁里加一勺蒜末，辛香的味道更足。",
    "喜欢重口味可以在蘸汁里多放干辣椒。"
  ],
  "serving_suggestion": "冰镇后斩块摆盘，配姜醋汁当冷盘。",
  "storage": "冷藏不超过一天，隔夜须彻底加热后再食。",
