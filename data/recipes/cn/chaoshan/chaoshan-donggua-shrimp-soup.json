  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "冬瓜",
          "name_en": "winter melon",
          "amount": 500,
          "unit": "g",
          "note": "去皮切块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "虾仁",
          "name_en": "peeled shrimp",
          "amount": 200,
          "unit": "g",
          "note": "去虾线",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1200,
          "unit": "ml",
          "note": "煮汤",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 15,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "砧板",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "冬瓜削去外皮与内瓤，切成两厘米厚的方块备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "瓤去干净，汤才清不浑。",
      "visual_cue": "冬瓜块大小均匀，无软瓤"
    },
    {
      "n": 2,
      "text": "虾仁挑去背部的黑线，用清水冲洗干净后沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "背部的黑线一定挑掉，否则带土腥。",
      "visual_cue": "虾仁通透，表面干爽"
    },
    {
      "n": 3,
      "text": "虾仁加少许盐与白胡椒抓匀，腌十分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "短腌即可，腌久肉质会发紧。",
      "visual_cue": "虾仁表面微黏，略有光泽"
    },
    {
      "n": 4,
      "text": "汤锅加清水与姜片大火烧开，水开后下冬瓜块。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水开再下冬瓜，汤味更清。",
      "visual_cue": "冬瓜块在沸水中翻滚"
    },
    {
      "n": 5,
      "text": "转中火煮十分钟，煮到冬瓜边缘变透明、能用筷子插入。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煮到透而不烂，口感才好。",
      "visual_cue": "冬瓜透明，筷子能轻松插入"
    },
    {
      "n": 6,
      "text": "把腌好的虾仁分散下锅，煮到卷曲变红大约两分钟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "虾仁久煮会老，变红就够。",
      "visual_cue": "虾仁卷曲，颜色转粉红"
    },
    {
      "n": 7,
      "text": "加盐与白胡椒调味，撇去表面的浮沫后关火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "盐最后放，冬瓜才不会发柴。",
      "visual_cue": "汤色清亮，浮沫撇净"
    },
    {
      "n": 8,
      "text": "盛出以后撒上一把葱花，趁热上桌连汤一起喝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花最后撒，香气才鲜活。",
      "visual_cue": "汤面浮着翠绿葱花"
    }
  ],
  "tips": [
    "冬瓜要去净内瓤，煮出来的汤色才清亮。",
    "盐一定要最后才放，冬瓜才不容易煮烂。"
  ],
  "common_mistakes": [
    "背部的黑线没有挑干净，整锅汤都带腥味。",
    "冬瓜和虾仁一起下锅，虾老了冬瓜还没透。",
    "盐放得太早，冬瓜出水变软没有口感。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "干贝",
      "ratio": "200 克:80 克",
      "note": "鲜味更浓，需提前泡软撕丝。"
    },
    {
      "original": "冬瓜",
      "substitute": "节瓜",
      "ratio": "500 克:500 克",
      "note": "口感更清甜，煮制时间略短。"
    }
  ],
  "variations": [
    "加几片瘦肉一同煮，汤味会更鲜甜。",
    "出锅撒少许香菜碎，清香气更足一些。"
  ],
  "serving_suggestion": "夏天当清汤喝，配一碗白粥最舒服。",
  "storage": "冷藏一天，复热时小火加热至沸腾。",
