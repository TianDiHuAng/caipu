  "equipment": [
    "锋利鱼刀",
    "砧板",
    "厨房纸",
    "大瓷盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草鱼放血后片下两侧背肉，去皮去红肌，只留白净鱼肉。",
      "time_min": 15,
      "heat": "无火",
      "tip": "红肌腥味重，一定要片干净。",
      "visual_cue": "鱼肉雪白，无血丝"
    },
    {
      "n": 2,
      "text": "鱼肉用厨房纸包紧，冷藏二十分钟让肉质收紧。",
      "time_min": 20,
      "heat": "无火",
      "tip": "冷藏后更好切薄片，不易散。",
      "visual_cue": "鱼肉紧实有弹性，按下回弹"
    },
    {
      "n": 3,
      "text": "鱼刀斜刀片成两毫米薄片，一片片平铺在冰镇瓷盘上。",
      "time_min": 10,
      "heat": "无火",
      "tip": "刀要锋利，一刀到底不来回拉。",
      "visual_cue": "鱼片透光，边缘整齐"
    },
    {
      "n": 4,
      "text": "姜切极细丝，大蒜切片，香菜切段，花生压成粗碎。",
      "time_min": 8,
      "heat": "无火",
      "tip": "姜丝越细，辛辣越柔。",
      "visual_cue": "姜丝细如发丝，根根分明"
    },
    {
      "n": 5,
      "text": "植物油烧到微微冒烟，淋在姜丝与蒜片上激出香气。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油温不足激不出香，过热会把姜炸苦。",
      "visual_cue": "姜丝卷边，香气冲起"
    },
    {
      "n": 6,
      "text": "生抽加少许盐调成蘸汁，撒上芝麻与花生碎。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蘸汁要淡，才吃得出鱼的本味。",
      "visual_cue": "酱汁清亮，浮着芝麻"
    },
    {
      "n": 7,
      "text": "鱼片配姜丝蒜片香菜上桌，夹一片蘸汁后立刻入口。",
      "time_min": 1,
      "heat": "无火",
      "tip": "上桌后十五分钟内吃完，鲜度最佳。",
      "visual_cue": "鱼片微凉，配料齐整"
    }
  ],
  "tips": [
    "必须用活鱼现杀，冰鲜鱼不适合生食。",
    "全程刀具砧板沸水烫过，生熟严格分开。",
    "鱼片越薄越好，厚了嚼不动还带腥。"
  ],
  "common_mistakes": [
    "鱼片带红肌，吃起来腥味压不住。",
    "配料提前拌进鱼片，出水把鲜味冲掉。",
    "刀不够快，来回拉刀把鱼肉压散。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲈鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更细，腥味更轻，片切难度低。"
    },
    {
      "original": "花生",
      "substitute": "芝麻",
      "ratio": "50 克:50 克",
      "note": "少一层颗粒感，香气更集中。"
    }
  ],
  "variations": [
    "配一碟普宁豆酱蘸食，咸鲜更浓。",
    "加一勺辣椒油，做成微辣版本，更下饭。"
  ],
  "serving_suggestion": "鱼片铺盘，配料分小碟摆放，边夹边蘸，配白粥同食。",
  "storage": "生鱼片现做现吃，不建议冷藏过夜；配料可冷藏一天。",
