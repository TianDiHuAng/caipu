  "equipment": [
    "炒锅",
    "锅铲",
    "料理机",
    "玻璃罐",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红辣椒去蒂洗净，摊在竹筛上晾两小时至表面完全干爽。",
      "time_min": 125,
      "heat": "无火",
      "tip": "辣椒必须晾干，带生水下酱容易长霉，几天就坏。",
      "visual_cue": "辣椒表皮干爽，手感不粘"
    },
    {
      "n": 2,
      "text": "大蒜剥皮去蒂，姜切片，与红辣椒一起放进料理机打成粗粒，不要打成泥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打成粗粒才有嚼头，打成泥会出水，酱体发稀。",
      "visual_cue": "颗粒均匀，约米粒大小"
    },
    {
      "n": 3,
      "text": "打好的辣椒蒜粒倒入大碗，加盐、白砂糖、米醋与生抽拌匀，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "先拌调料再泼油，盐糖化开才均匀，不会结块。",
      "visual_cue": "酱体颜色均匀，渗出少量汁水"
    },
    {
      "n": 4,
      "text": "炒锅放植物油烧到六成热，插入筷子周围冒细密小泡即可。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温太高会把蒜粒炸苦，六成热刚好激出香味。",
      "visual_cue": "油面微微冒烟，筷子周围起泡"
    },
    {
      "n": 5,
      "text": "把热油分三次淋入辣椒蒜粒中，每淋一次都搅拌一下，让香气均匀释放。",
      "time_min": 4,
      "heat": "无火",
      "tip": "分次泼油温度递降，蒜香辣香层层出来，一次倒完容易糊。",
      "visual_cue": "油面浮起红亮辣油，香气冲鼻"
    },
    {
      "n": 6,
      "text": "撒入炒香的白芝麻拌匀，趁热装入干净玻璃罐，表面淋一层油封住。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油封能隔绝空气，罐子必须无水无油，否则很快变质。",
      "visual_cue": "罐口油层清澈，酱体红亮"
    },
    {
      "n": 7,
      "text": "放凉后盖紧，冷藏静置一夜让味道融合，第二天再取用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置一夜辣味变柔和，蒜香融进油里，味道更圆。",
      "visual_cue": "酱体分层，上层红油清亮"
    }
  ],
  "tips": [
    "辣椒选红美人椒或指天椒，前者香后者辣，混着用风味更立体。",
    "全程不能碰生水，罐子、勺子都要开水烫过擦干，这是久存的关键。",
    "做好的辣酱配潮汕牛肉丸、炒粿条或白粥都合适，一勺下去提味。"
  ],
  "common_mistakes": [
    "辣椒洗完直接打，水汽带进酱里，三天就长白毛。",
    "油烧到冒大烟才泼，蒜末瞬间变黑，整罐酱发苦。",
    "盐放少了想靠冷藏补救，结果一周后酱体发酸，只能整罐倒掉。"
  ],
  "substitutions": [
    {
      "original": "红辣椒",
      "substitute": "小米辣",
      "ratio": "300克:200克",
      "note": "小米辣更辣，用量减三分之一，糖可略增。"
    },
    {
      "original": "米醋",
      "substitute": "柠檬",
      "ratio": "20毫升:半个",
      "note": "挤柠檬汁替代，酸味更清亮。"
    }
  ],
  "variations": [
    "加一把炸过的虾米同打，就是潮汕的虾米辣酱，鲜味更足。",
    "把部分辣椒换成青辣椒，红绿相间，辣度低一些。"
  ],
  "serving_suggestion": "装小碟作蘸料，配牛肉丸、白切鸡或炒粿条；也可直接拌饭拌面。",
  "storage": "冷藏可存一个月，取用须用干燥无水的勺子；表面油层变薄时补淋一层热油。",
