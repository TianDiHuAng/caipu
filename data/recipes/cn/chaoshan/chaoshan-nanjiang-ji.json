  "equipment": [
    "汤锅",
    "砧板",
    "刀",
    "大盆",
    "漏勺",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡里外抹盐十克，腹腔塞入南姜碎、小葱结与姜片，腌二十分钟。",
      "time_min": 23,
      "heat": "无火",
      "tip": "盐只抹薄薄一层，腌久了肉会紧，煮出来发柴。",
      "visual_cue": "鸡皮泛微光，腹腔香味透出"
    },
    {
      "n": 2,
      "text": "大盆备冰水三升，加少许盐搅匀，放一旁待用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冰水要提前备好，鸡一出锅就得进冰，皮才脆。",
      "visual_cue": "冰水清澈见底，盆壁凝出一层薄霜"
    },
    {
      "n": 3,
      "text": "汤锅加清水两千五百毫升烧至九十度，放入红葱头与剩下的南姜片，提着鸡头把整鸡三提三放。",
      "time_min": 6,
      "heat": "中火",
      "tip": "三提三放让腹腔内外温度一致，鸡腔里的血水才逼得出来。",
      "visual_cue": "水面微冒小泡，鸡身均匀收紧"
    },
    {
      "n": 4,
      "text": "整鸡没入水中，保持水面将沸不沸，浸煮二十五分钟，其间翻面两次。",
      "time_min": 26,
      "heat": "小火",
      "tip": "水面只能微微冒小泡，一旦大滚鸡皮就破，肉也老。",
      "visual_cue": "鸡身关节处渗出清亮汁水"
    },
    {
      "n": 5,
      "text": "用筷子扎鸡身最厚处，流出清汁无血水即熟，捞出立刻放入冰水中浸十分钟。",
      "time_min": 11,
      "heat": "无火",
      "tip": "冰水浸是白切鸡的关键，皮脆肉滑全在这一步。",
      "visual_cue": "鸡皮紧致发亮，按压回弹快"
    },
    {
      "n": 6,
      "text": "南姜磨成细末，加盐八克、鱼露、白胡椒与香油调成蘸料，另备一小碟原汤。",
      "time_min": 5,
      "heat": "无火",
      "tip": "南姜要现磨，磨好放久会发黑，香气也散了。",
      "visual_cue": "蘸料呈浅黄色，姜末细腻"
    },
    {
      "n": 7,
      "text": "鸡沥干斩件，按原形摆盘，鸡皮上刷一层香油，配南姜蘸料上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "斩件时刀要直落，压着切会把皮肉挤散，摆盘就不成形。",
      "visual_cue": "骨断面见微红，肉白皮黄"
    }
  ],
  "tips": [
    "白切鸡讲究皮爽肉滑骨带血，煮到刚熟就停，多煮两分钟口感就变了。",
    "南姜比普通生姜更辛香带甜，潮汕人拿它配禽肉，去腥又提香。",
    "冰水浸鸡别省，温差越大鸡皮越脆，肉汁也锁得住。"
  ],
  "common_mistakes": [
    "全程大火滚煮，鸡皮破成一朵朵，肉纤维收缩发硬。",
    "鸡煮好直接放凉不回冰水，鸡皮发黏不脆，切的时候还容易破。",
    "蘸料里的南姜用普通姜代替，香气完全不同，只剩一股冲辣。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "1500克:900克",
      "note": "用鸡腿肉浸煮时间缩到十五分钟，更易掌控火候。"
    },
    {
      "original": "南姜",
      "substitute": "沙姜",
      "ratio": "80克:60克",
      "note": "沙姜香气更清，用量可略减。"
    }
  ],
  "variations": [
    "把鸡放凉后撕成条，拌南姜末与香油，就是潮汕的手撕鸡。",
    "剩下的鸡架加原汤煮粥，一点不浪费，是家常的吃法。"
  ],
  "serving_suggestion": "斩件摆盘后配南姜蘸料，佐一碗鸡油饭或白粥，饭后来杯工夫茶解腻。",
  "storage": "冷藏可存两天，鸡肉与蘸料分开密封；复热用原汤小火浸五分钟，别蒸，蒸过皮就烂了。",
