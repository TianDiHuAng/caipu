    "砧板",
    "大碗",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去骨去皮，只留白肉，用刀背反复捶打。，看准状态再往下做。",
      "time_min": 18,
      "heat": "无火",
      "tip": "捶打出胶，鱼丸才弹。，看准状态再往下做。",
      "visual_cue": "鱼肉成泥，纤维松散"
    },
    {
      "n": 2,
      "text": "把鱼肉刮下来，挑净残留的细刺。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "细刺挑干净，吃着才不扎。，看准状态再往下做。",
      "visual_cue": "鱼泥细腻，无硬块，这一点很关键。"
    },
    {
      "n": 3,
      "text": "鱼泥加盐、淀粉、姜末和白胡椒粉，顺向搅打。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐先加，鱼肉才起胶上劲。，看准状态再往下做。",
      "visual_cue": "鱼泥发黏，能拉出丝"
    },
    {
      "n": 4,
      "text": "分三次加少量清水，每次都搅到完全吸收。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水分次加，鱼丸才嫩不散。，看准状态再往下做。",
      "visual_cue": "鱼泥发亮，手感弹，这一点很关键。"
    },
    {
      "n": 5,
      "text": "汤锅倒清水烧到微沸，转小火。，看准状态再往下做。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水微沸下丸子，滚水会冲散。，看准状态再往下做。",
      "visual_cue": "锅底冒小泡，水面平静"
    },
    {
      "n": 6,
      "text": "用虎口挤出丸子，用勺舀进锅里。，看准状态再往下做。",
      "time_min": 8,
      "heat": "小火",
      "tip": "挤一个舀一个，动作要连贯。，看准状态再往下做。",
      "visual_cue": "丸子圆整，浮在水面"
    },
    {
      "n": 7,
      "text": "全部浮起后撇去浮沫，加紫菜煮两分钟。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "浮沫撇净，汤才清亮。，看准状态再往下做。",
      "visual_cue": "汤清见底，丸子洁白"
    },
    {
      "n": 8,
      "text": "加盐和白胡椒粉调味，撒葱花淋香油。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "调味最后放，鲜味才准。，看准状态再往下做。",
      "visual_cue": "汤面油花，葱花翠绿"
    }
  ],
  "tips": [
    "鱼肉要用刀背捶打，出胶才弹牙。，这一点很关键。",
    "鱼泥顺一个方向搅，丸子才不散。，这一点很关键。",
    "水微沸下丸子，滚水一冲就成鱼糊。"
  ],
  "common_mistakes": [
    "鱼泥没上劲，丸子下锅散成糊。，这一点很关键。",
    "水大滚下丸子，全冲成碎末。，这一点很关键。",
    "淀粉加太多，丸子发硬没鱼味。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "鳗鱼",
      "ratio": "500 克:500 克",
      "note": "更弹，捶打时间加五分钟。"
    },
    {
      "original": "紫菜",
      "substitute": "生菜",
      "ratio": "5 克:80 克",
      "note": "更清爽，煮的时间减一分钟。"
    }
  ],
  "variations": [
    "加几粒牛肉丸同煮，双丸汤更丰富。",
    "放一点芹菜末，香气更清。，这一点很关键。"
  ],
  "serving_suggestion": "趁热喝，配一碗粿条。，这一点很关键。",
  "storage": "冷藏一天，冷冻两周；复热小火煮开。",
