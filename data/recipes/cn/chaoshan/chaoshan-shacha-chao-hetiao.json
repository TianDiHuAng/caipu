  "equipment": [
    "炒锅",
    "锅铲",
    "砧板",
    "刀",
    "大碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆着纹理切成两毫米的薄片，加生抽五毫升、玉米淀粉与十毫升清水抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逆纹切才咬得动，顺着纹切片，炒完像嚼橡皮。",
      "visual_cue": "肉片表面发黏，光泽透亮"
    },
    {
      "n": 2,
      "text": "沙茶酱用六十毫升清水化开，加剩下的生抽、老抽与白砂糖搅匀成酱汁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "沙茶酱先化开再下锅，直接入锅容易炒糊发苦。",
      "visual_cue": "酱汁呈浅褐色，无结块"
    },
    {
      "n": 3,
      "text": "河粉用手轻轻撕成宽条，抖散结块，别用刀切，切了容易断。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粿条是蒸出来的，手撕才留得住筋道，刀切断面一炒就碎。",
      "visual_cue": "条条分明，不粘不结团"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒白烟，放植物油三十毫升，下河粉摊平，中大火煎四十秒再翻面煎四十秒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅要够热再下粉，锅不热粿条直接粘底，一铲就烂。",
      "visual_cue": "粉边微焦，条身透亮弹手"
    },
    {
      "n": 5,
      "text": "将河粉拨到锅边，下牛肉片大火快炒二十秒至变色，与河粉一起翻匀盛出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "牛肉只要变色就够，炒久了汁水全跑，咬着发干。",
      "visual_cue": "牛肉片边缘卷起，断面见粉红"
    },
    {
      "n": 6,
      "text": "锅中补十毫升植物油，下大蒜末与红葱头片爆香，倒入芥蓝与豆芽大火炒四十秒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "芥蓝要大火快炒，断生就够，炒软了出水会把粿条泡塌。",
      "visual_cue": "芥蓝翠绿挺立，豆芽略塌微软"
    },
    {
      "n": 7,
      "text": "倒回河粉与牛肉，沿锅边淋入酱汁，用筷子抖散快速翻匀，收干汤汁即可出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "用筷子抖比用铲子翻更不容易断条，动作要快，三十秒内出锅。",
      "visual_cue": "酱色均匀裹条，盘底不见汤汁"
    }
  ],
  "tips": [
    "潮汕炒粿条讲镬气，锅必须烧到冒烟，火力不足炒出来是湿软的。",
    "沙茶酱本身带咸带甜，生抽与糖要按量来，多放一点整盘就齁。",
    "粿条手撕比刀切好，撕出来的毛边更容易挂住酱汁。"
  ],
  "common_mistakes": [
    "锅没烧热就下粿条，黏成一坨铲都铲不动，断条糊底全占。",
    "牛肉提前腌好放着不冷藏，淀粉出水，下锅变成一锅浆糊。",
    "酱汁一次全倒进去，粿条泡在汤里，炒粿条变成汤粿条。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛肉末",
      "ratio": "200克:180克",
      "note": "用肉末更易入味，炒散后与粿条同拌。"
    },
    {
      "original": "芥蓝",
      "substitute": "小白菜",
      "ratio": "150克:150克",
      "note": "小白菜叶薄，下锅二十秒即可。"
    }
  ],
  "variations": [
    "把牛肉换成鲜虾仁，就是潮汕街头的沙茶虾仁炒粿条。",
    "加一勺辣椒酱同炒，辣中带甜，是嗜辣者的吃法。"
  ],
  "serving_suggestion": "装盘趁热吃，配一碗清汤或者一杯工夫茶解腻，辣酱另碟自取。",
  "storage": "冷藏可存一天，复热时用炒锅大火快炒三十秒，别用微波炉，粿条会发硬。",
