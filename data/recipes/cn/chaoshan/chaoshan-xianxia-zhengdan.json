        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "淋面",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 320,
          "unit": "ml",
          "note": "调蛋液",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 10,
          "unit": "ml",
          "note": "淋面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "浅盘",
    "滤网",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾仁挑出背上的黑色沙线，用淡盐水抓洗两遍。",
      "time_min": 8,
      "heat": "无火",
      "tip": "沙线不挑，腥味重，口感也发沙。",
      "visual_cue": "虾仁透亮，背沟干净无黑线"
    },
    {
      "n": 2,
      "text": "洗好的虾仁用厨纸吸干水分，加少许盐抓匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "吸干水分，蒸时才不出一盘水。",
      "visual_cue": "虾仁干爽，表面微微发黏"
    },
    {
      "n": 3,
      "text": "鸡蛋打散，加盐与清水搅匀，比例约一比一点五。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水多一点蛋才嫩，多了又不成形。",
      "visual_cue": "蛋液均匀，表面浮着细泡"
    },
    {
      "n": 4,
      "text": "蛋液用细滤网过两遍，滤掉表面的泡沫与系带。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过筛是蛋面光滑的关键，别省。",
      "visual_cue": "滤后蛋液澄净，几乎无泡"
    },
    {
      "n": 5,
      "text": "蛋液倒进浅盘，盖上一层扎了小孔的保鲜膜。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盖膜挡住水汽，表面才不会起蜂窝。",
      "visual_cue": "膜面平整，小孔均匀分布"
    },
    {
      "n": 6,
      "text": "蒸锅水开后放入，中小火蒸八分钟至半凝固。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "火太大蛋会老，中小火才滑嫩。",
      "visual_cue": "蛋面微颤，边缘已定型"
    },
    {
      "n": 7,
      "text": "揭开保鲜膜摆上虾仁，再盖回膜继续蒸四分钟。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "虾仁后放，久蒸会缩水变硬。",
      "visual_cue": "虾仁转红卷曲，嵌在蛋面"
    },
    {
      "n": 8,
      "text": "出锅后淋上生抽与热植物油，撒上葱花就可以上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "热植物油一浇，葱香和虾仁鲜一起冲出来。",
      "visual_cue": "蛋面镜亮，虾仁红润饱满"
    }
  ],
  "tips": [
    "蛋液与清水按一比一点五调，蒸出来滑嫩不散。",
    "过筛两遍再加盖保鲜膜，蛋面才平如镜。",
    "虾仁最后四分钟放，久蒸缩水变硬。"
  ],
  "common_mistakes": [
    "蛋液不过筛，表面全是蜂窝小孔。",
    "大火猛蒸，蛋体起泡变老，中间还夹生。",
    "虾仁跟蛋液一起下锅，蒸完又小又韧。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "扇贝肉",
      "ratio": "300 克:300 克",
      "note": "鲜甜更浓，蒸的时间相同。"
    },
    {
      "original": "生抽",
      "substitute": "蒸鱼豉油",
      "ratio": "20 毫升:20 毫升",
      "note": "咸鲜更突出，用量可略减。"
    }
  ],
  "variations": [
    "蛋液里加两勺高汤同蒸，鲜味更厚实。",
    "撒少许陈皮末，潮汕人爱的果香清口。"
  ],
  "serving_suggestion": "配一碗白粥或米饭，淋点酱汁拌开，是老少都爱的家常味。",
  "storage": "现蒸现吃，冷藏不超过一天，复蒸三分钟。",
