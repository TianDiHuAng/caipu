  "steps": [
    {
      "n": 1,
      "text": "草鱼片成三毫米薄片，加料酒、盐和玉米淀粉抓匀上浆，静置十分钟让鱼片吸足水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "上浆抓到手感发黏，鱼片煮后才滑嫩不柴。",
      "visual_cue": "鱼片透亮挂浆，手感顺滑。"
    },
    {
      "n": 2,
      "text": "豆芽焯水一分钟捞出铺在深碗底部，青花椒取一半留着泼油用。",
      "time_min": 3,
      "heat": "中火",
      "tip": "豆芽垫底既吸汤又添脆口，焯水一分钟别过头。",
      "visual_cue": "豆芽断生仍脆，铺满碗底。"
    },
    {
      "n": 3,
      "text": "炒锅放四十毫升植物油，下姜片蒜片和泡椒小火炒香，加清水烧开后放盐调味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "泡椒先小火炒出酸香，汤底才有层次不发寡。",
      "visual_cue": "汤色微红，酸香扑鼻。"
    },
    {
      "n": 4,
      "text": "把鱼片一片片抖散下锅，煮到变白卷曲即关火，连汤倒入铺好豆芽的碗中。",
      "time_min": 3,
      "heat": "中火",
      "tip": "鱼片下锅别搅动，等定型再轻推才不碎。",
      "visual_cue": "鱼片雪白卷曲，浮在汤面。"
    },
    {
      "n": 5,
      "text": "锅洗净烧热三十毫升植物油，下剩余青花椒小火炸出麻香，趁热浇在鱼片上，撒葱段即成。",
      "time_min": 3,
      "heat": "中火",
      "tip": "青花椒不能炸糊，出香立刻离火，否则发苦。",
      "visual_cue": "花椒在油面浮起，麻香冲鼻。"
    }
  ],
  "tips": [
    "上浆抓到手感发黏，鱼片才够滑嫩。",
    "青花椒要用小火慢炸出麻香，炸到发黑就带焦苦味",
    "豆芽垫底既吸汤又添脆口，别焯过头。",
    "花椒泼油要现炸现浇，麻香才清冽。"
  ],
  "common_mistakes": [
    "鱼片没上浆直接下锅，煮后老硬发散。",
    "青花椒在热油里炸糊了，整碗汤都带苦味。",
    "鱼片在锅里反复搅拌，碎成渣捞不起来。",
    "豆芽焯水太久，垫底软塌没有口感。"
  ],
  "substitutions": [
    {
      "original": "青花椒",
      "substitute": "花椒",
      "ratio": "15克:10克",
      "note": "干红花椒麻香偏沉，用量减三分之一，泼油时加两段干辣椒补香。"
    },
    {
      "original": "草鱼",
      "substitute": "鲈鱼",
      "ratio": "500克:500克",
      "note": "鲈鱼肉更紧实，煮制时间缩短半分钟。"
    }
  ],
  "variations": [
    "有的做法在汤里加泡萝卜片，酸爽更突出。",
    "汉源一带会用鲜花椒现炸，麻香清冽扑鼻。"
  ],
  "serving_suggestion": "端上桌趁热吃，先舀鱼片再喝汤，麻香清爽不油腻，配米饭正好。",
  "storage": "冷藏可存一日，复热需小火加热到微沸；青花椒香气易挥发，复热后建议补撒少许花椒粉。",
