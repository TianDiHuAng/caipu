  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐切两厘米方块，放入加盐的开水中浸泡三分钟定形，捞出沥水。",
      "time_min": 6,
      "heat": "小火",
      "tip": "嫩豆腐易碎，盐水浸泡比焯更温和，也能去豆腥。",
      "visual_cue": "豆腐块完整，表面紧实。"
    },
    {
      "n": 2,
      "text": "泡椒斜切成段，姜切末，小葱切葱花，泡椒汁留两勺备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "泡椒切开才出味，整颗下锅只有酸没有辣。",
      "visual_cue": "泡椒段红亮，籽粒可见。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧热，下泡椒段和花椒小火煸出红油和酸辣香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "泡椒要小火慢煸，火大了发苦，酸味也变冲。",
      "visual_cue": "油色转红，酸香冲鼻。"
    },
    {
      "n": 4,
      "text": "下姜末炒香，加清水、生抽、白糖和两勺泡椒汁烧开，放入豆腐块小火煨五分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "用勺背推锅，别用锅铲翻，豆腐才不碎。",
      "visual_cue": "汤汁红亮，豆腐浮沉。"
    },
    {
      "n": 5,
      "text": "加盐调味，水淀粉化开后缓缓淋入，轻推至汤汁挂勺，撒葱花出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "泡椒本身有咸味，盐最后尝了再放。",
      "visual_cue": "芡汁红亮微稠，豆腐完整。"
    }
  ],
  "tips": [
    "泡椒选灯笼椒泡的，酸辣柔和，比野山椒更适口。",
    "泡椒汁是提味法宝，留两勺下锅，酸香更立体。",
    "嫩豆腐定形后再烧，成品才完整好看。"
  ],
  "common_mistakes": [
    "泡椒不切直接下锅，味道出不来。",
    "大火猛烧，豆腐碎成渣，汤汁发浑。",
    "盐按常规放，泡椒的咸味被忽略，成品过咸。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "北豆腐",
      "ratio": "1:1",
      "note": "换成北豆腐更有嚼劲，需多煨两分钟入味，也不易碎。"
    },
    {
      "original": "泡椒",
      "substitute": "豆瓣酱",
      "ratio": "50克:35克",
      "note": "无泡椒可用豆瓣酱，风味转为酱香辣，酸味需另加香醋五毫升。"
    }
  ],
  "variations": [
    "加几片五花肉同烧，油香更足，是川南的做法。",
    "有的家庭加一勺醪糟，酸辣中带一点回甜。"
  ],
  "serving_suggestion": "连汁装盘撒葱花，配白饭最下饭；剩下的汤汁拌面也好吃。",
  "storage": "冷藏可存两日，复热用小火加少量清水煨开，切勿大火。",
