        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜米饭用勺子压散，拌入 5ml 植物油让米粒颗颗分开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷饭的水分少，炒出来才粒粒分明。",
      "visual_cue": "米粒松散、没有结块"
    },
    {
      "n": 2,
      "text": "腊肉丁冷水下锅煮 3 分钟捞出，去除表面浮盐与烟熏杂味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "先焯一遍，炒出的饭不齁咸。",
      "visual_cue": "水面浮起白沫、腊肉略软"
    },
    {
      "n": 3,
      "text": "炒锅烧热下 15ml 植物油，倒入蛋液大火快速炒成蛋块盛出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蛋液半凝就盛，回锅才不老。",
      "visual_cue": "蛋块蓬松微黄，边缘略带焦边"
    },
    {
      "n": 4,
      "text": "锅中补 10ml 植物油，下腊肉丁小火煸 3 分钟至出油微焦。",
      "time_min": 4,
      "heat": "中火",
      "tip": "把腊肉的油逼出来，饭才香。",
      "visual_cue": "腊肉边缘微焦、锅底见红油"
    },
    {
      "n": 5,
      "text": "下青椒丁炒 1 分钟，倒入米饭大火翻炒，边炒边压散结块。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火快炒，米粒才不粘锅。",
      "visual_cue": "米粒跳动、表面泛油光"
    },
    {
      "n": 6,
      "text": "淋 15ml 酱油与 2g 盐炒匀，倒回蛋块撒小葱，翻两下出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "酱油沿锅边淋，焦香更足。",
      "visual_cue": "饭粒均匀上色、葱香冒出"
    }
  ],
  "tips": [
    "饭要冷、锅要热，这是炒饭好不好的分水岭。",
    "腊肉先焯水再煸，咸度与烟味都更柔和。",
    "青椒最后下，保住脆爽口感，早放会炒软发黄。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭下锅，炒出一坨黏团。",
    "腊肉直接下锅，咸味全渗进饭里发苦。",
    "小火慢炒，饭粒被压得又软又油。"
  ],
  "substitutions": [
    {
      "original": "腊肉",
      "substitute": "腊肠",
      "ratio": "120g 对 120g",
      "note": "更甜口，盐可再减 1g。"
    },
    {
      "original": "青椒",
      "substitute": "青豆",
      "ratio": "60g 对 60g",
      "note": "需先焯水 1 分钟。"
    }
  ],
  "variations": [
    "芽菜版：加 40g 宜宾芽菜同炒更咸香。",
    "加辣版：起锅前淋 10ml 红油提香。"
  ],
  "serving_suggestion": "配一碗紫菜蛋花汤，作为一人食的快速午餐。",
  "storage": "冷藏 1 天，复热用炒锅大火翻炒 2 分钟。",
