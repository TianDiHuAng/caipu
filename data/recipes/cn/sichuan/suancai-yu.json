        }
      ]
    }
  ],
  "equipment": [
    "片鱼刀",
    "炒锅",
    "汤盆",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草鱼去骨取肉，斜刀片成 3mm 厚的鱼片，鱼骨剁段；鱼片用清水抓洗两遍至水清，挤干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "抓洗能去掉表面血水与黏液，鱼片才不腥、汤才清。",
      "visual_cue": "鱼片由暗红转为粉白，水不再浑浊"
    },
    {
      "n": 2,
      "text": "鱼片加盐 2g、白胡椒、料酒抓匀，再加蛋清与土豆淀粉上浆，静置 15 分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "上浆后不要反复搅动，淀粉层破了鱼片容易散。",
      "visual_cue": "鱼片表面裹上一层薄薄的半透明浆"
    },
    {
      "n": 3,
      "text": "炒锅下植物油 40ml，中小火炒香姜片、大蒜、泡椒与干辣椒的一半，再下酸菜翻炒 3 分钟至出酸香。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "酸菜一定要炒透，酸味才醇厚，不炒会有生涩味。",
      "visual_cue": "酸菜边缘微微焦边，锅中飘出明显酸香"
    },
    {
      "n": 4,
      "text": "倒入高汤与鱼骨，大火烧开后转中火煮 8 分钟，让汤色转白、酸味融进汤里。",
      "time_min": 8,
      "heat": "中火",
      "tip": "汤要滚起来再下鱼片，温度够高鱼片才嫩。",
      "visual_cue": "汤色由清转乳白，表面浮着红油点"
    },
    {
      "n": 5,
      "text": "转小火，把鱼片一片片滑入汤中，保持汤面微沸 90 秒，鱼片变白卷曲立即连汤倒入汤盆。",
      "time_min": 3,
      "heat": "小火",
      "tip": "鱼片下锅后不要翻动，晃锅让汤汁浸过即可。",
      "visual_cue": "鱼片由透明变白、边缘卷起"
    },
    {
      "n": 6,
      "text": "另起锅烧热剩下的植物油，下剩余干辣椒与花椒炸 10 秒，趁热泼在鱼片上。",
      "time_min": 2,
      "heat": "中大火",
      "tip": "油温约 180℃，辣椒下锅立即起泡但不焦黑。",
      "visual_cue": "泼油时滋啦作响，辣椒瞬间变暗红"
    }
  ],
  "tips": [
    "鱼片厚度控制在 3mm 左右，太厚不易熟透、太薄一煮就碎。",
    "酸菜本身有咸味，调味前先尝汤，盐量按酸菜咸度调整。",
    "剩下的鱼头鱼骨可以煎香后单独熬汤，不浪费且汤更鲜。"
  ],
  "common_mistakes": [
    "鱼片直接下滚水久煮，肉质变老发硬，一夹就散。",
    "酸菜没炒直接下水，汤有生涩味且不够酸香。",
    "上浆时淀粉放太多，汤变糊、失去清爽感。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "黑鱼",
      "ratio": "1:1",
      "note": "黑鱼肉质更紧实不易散，适合新手，价格略高。"
    },
    {
      "original": "酸菜",
      "substitute": "雪菜",
      "ratio": "1:0.9",
      "note": "雪菜咸度更高，需多冲洗两遍并减盐。"
    }
  ],
  "variations": [
    "家庭简化版：用市售酸菜鱼调料包代替泡椒与豆瓣调味，只需自备鱼片与酸菜。",
    "番茄酸汤版：以番茄与番茄膏代替一半酸菜，酸味更柔和，适合不吃辣的家庭成员。"
  ],
  "serving_suggestion": "趁热上桌，配白米饭；汤可以留着下面条，是川渝家庭的常见吃法。",
  "storage": "冷藏 1 天，鱼片与汤分开存放，复热时汤先烧开再下鱼片烫 1 分钟。",
