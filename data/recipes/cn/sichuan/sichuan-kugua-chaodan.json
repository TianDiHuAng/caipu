    "刀",
    "砧板",
    "打蛋碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苦瓜对半剖开，用勺子刮净中间的白色瓜瓤，斜刀切成两毫米厚的薄片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "白色瓜瓤是苦味来源，刮得越干净苦味越轻。",
      "visual_cue": "苦瓜片薄而透光，内壁白瓤去净。"
    },
    {
      "n": 2,
      "text": "苦瓜片撒两克盐抓匀腌五分钟，用手挤掉渗出的苦水，再用清水冲一遍沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "腌后挤水能去掉大半苦味，冲一遍避免过咸。",
      "visual_cue": "苦瓜片变软塌，颜色转深绿。"
    },
    {
      "n": 3,
      "text": "鸡蛋打散加一克盐搅匀，炒锅放三十毫升植物油烧到六成热，倒入蛋液炒成大块盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "蛋液下锅别急着搅，等底部凝住再翻，块才成形。",
      "visual_cue": "蛋块金黄蓬松，表面微焦。"
    },
    {
      "n": 4,
      "text": "锅内补十五毫升植物油，下蒜片和小米辣圈爆香，倒入苦瓜大火翻炒两分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "苦瓜要大火快炒，炒久了发黄发软，脆劲全无。",
      "visual_cue": "苦瓜颜色翠绿，锅气冲出。"
    },
    {
      "n": 5,
      "text": "倒回蛋块，加生抽和白糖翻匀，尝味后补盐即可出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "白糖只用来压苦，别放多，尝不出甜味才刚好。",
      "visual_cue": "蛋块与苦瓜均匀交叠，油亮不积水。"
    }
  ],
  "tips": [
    "苦瓜选表面瘤粒大的，肉厚而苦味淡。",
    "瓜瓤刮净再腌盐挤水，苦味能去掉大半。",
    "全程大火快炒保脆，出锅前才调味。"
  ],
  "common_mistakes": [
    "瓜瓤没刮净，整盘苦得咽不下去。",
    "苦瓜久炒变黄，口感发绵不脆爽。",
    "鸡蛋炒得太老，块硬发干噎喉咙。"
  ],
  "substitutions": [
    {
      "original": "苦瓜",
      "substitute": "丝瓜",
      "ratio": "250克:250克",
      "note": "丝瓜不苦、出水多，需大火快炒并省略腌盐步骤。"
    },
    {
      "original": "小米辣",
      "substitute": "干辣椒",
      "ratio": "5克:3克",
      "note": "干辣椒在爆香时下锅，辣味更沉，色泽偏红。"
    }
  ],
  "variations": [
    "有的家庭把苦瓜切薄片先焯十秒再过凉，苦味更淡、颜色更翠。",
    "川南做法会加一勺豆豉同炒，咸香压苦。"
  ],
  "serving_suggestion": "趁热配白饭最下饭，苦味回甘解暑，夏天吃格外清爽。",
  "storage": "冷藏可存一日，回锅大火复炒一分钟；苦瓜久放会出水变色，建议当餐吃完。",
