  "steps": [
    {
      "n": 1,
      "text": "米饭抓散成粒，鸡蛋打散，生抽、老抽、白糖和白胡椒粉在小碗里调成酱汁备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酱汁先调好，下锅才来得及，避免手忙脚乱饭炒老。",
      "visual_cue": "酱汁呈深褐色，无颗粒沉淀。"
    },
    {
      "n": 2,
      "text": "炒锅放猪油烧到融化起烟，倒蛋液快速划散成小碎块，推到锅边。",
      "time_min": 2,
      "heat": "中火",
      "tip": "猪油炒饭才够香，用植物油也可以但风味差一截。",
      "visual_cue": "蛋碎金黄，猪油泛亮。"
    },
    {
      "n": 3,
      "text": "倒入米饭大火翻炒压散，炒到米粒在锅里跳动、表面微微发干。",
      "time_min": 2,
      "heat": "大火",
      "tip": "听到米粒噼啪跳响就说明水分炒干了。",
      "visual_cue": "米粒跳动松散，锅底无粘连。"
    },
    {
      "n": 4,
      "text": "沿锅边淋入调好的酱汁，快速翻匀到每粒米饭都上色，撒葱花和盐即可出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "酱汁沿锅边淋，遇热激香，直接浇饭上会让米粒发秃发黏。",
      "visual_cue": "饭粒均匀酱色油亮，葱花翠绿。"
    }
  ],
  "tips": [
    "猪油是香味的底子，别全换成植物油。",
    "酱汁沿锅边淋，激出的酱香更浓。",
    "米饭要冷、要散，热饭炒不出颗粒感。"
  ],
  "common_mistakes": [
    "米饭没抓散就下锅，最后结成一坨。",
    "酱油直接浇在饭上，米粒黏成团。",
    "火太小慢慢炒，米饭出水发软无焦香。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "30克:30毫升",
      "note": "植物油清爽不腻但香气弱，可加几滴香油补香。"
    },
    {
      "original": "生抽",
      "substitute": "甜酱油",
      "ratio": "15毫升:15毫升",
      "note": "甜酱油上色更深、甜味明显，白糖可完全省略。"
    }
  ],
  "variations": [
    "有的做法在酱汁里加半勺蚝油，鲜味更厚。",
    "川渝小馆会加一勺辣椒面同炒，出锅红亮带辣。"
  ],
  "serving_suggestion": "一勺入口酱香裹着油润的米粒，配腌萝卜或酸菜汤最解腻。",
  "storage": "冷藏可存一日，回锅加少许清水大火翻炒一分钟即可恢复松散。",
