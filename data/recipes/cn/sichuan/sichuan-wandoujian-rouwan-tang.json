        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "汤勺",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肉末加姜末、料酒、蛋清、淀粉和一半的盐，顺着一个方向搅打上劲。",
      "time_min": 5,
      "heat": "无火",
      "tip": "必须始终朝一个方向搅，肉丸才抱团不散。",
      "visual_cue": "肉馅发黏、拉出细丝"
    },
    {
      "n": 2,
      "text": "搅好的肉馅在碗里反复摔打十几下排掉空气，盖保鲜膜静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "摔打能挤出内部空气，丸子下锅才不容易裂。",
      "visual_cue": "肉馅紧实、按压有弹性"
    },
    {
      "n": 3,
      "text": "锅中加清水和两片姜烧到微沸，水面冒小泡但还没有翻滚。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "水一定不能大滚，滚水会把肉丸冲得稀碎。",
      "visual_cue": "锅底细密小泡、水面微动"
    },
    {
      "n": 4,
      "text": "用虎口挤出圆丸子，汤勺蘸水后逐个挖入锅中，把肉馅全部下完。",
      "time_min": 6,
      "heat": "小火",
      "tip": "勺子先蘸一下水，肉馅才不会粘在勺上。",
      "visual_cue": "丸子圆整、逐个浮起"
    },
    {
      "n": 5,
      "text": "丸子全部浮起后撇净浮沫，转中火再煮三分钟让肉丸内部熟透。",
      "time_min": 3,
      "heat": "中火",
      "tip": "浮沫要撇干净，汤才会清亮不带腥气。",
      "visual_cue": "汤面清亮、丸子弹动"
    },
    {
      "n": 6,
      "text": "下豌豆尖烫三十秒，加剩下的盐和白胡椒粉，淋香油后关火。",
      "time_min": 1,
      "heat": "大火",
      "tip": "豌豆尖一变深绿就关火，久煮发黄发苦。",
      "visual_cue": "豌豆尖翠绿挺立、汤面清爽"
    }
  ],
  "tips": [
    "肉馅肥瘦三七最佳，全瘦的丸子煮出来又干又柴。",
    "豌豆尖只取顶端嫩尖三片叶，老梗留着会影响口感。",
    "汤底不必加高汤，清水加姜片最能衬出豌豆尖的清甜。"
  ],
  "common_mistakes": [
    "肉馅只搅不打，下锅立刻散成肉末，汤也变浑。",
    "水大滚时才下丸子，丸子被冲散，一锅成了肉末汤。",
    "豌豆尖下锅煮太久，颜色发黄、清香味全丢。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "鸡肉末",
      "ratio": "300g 对 300g",
      "note": "鸡肉偏瘦，需多加一勺淀粉才不柴。"
    },
    {
      "original": "豌豆尖",
      "substitute": "豌豆苗",
      "ratio": "150g 对 150g",
      "note": "口感更嫩，但清香气比豌豆尖略淡。"
    }
  ],
  "variations": [
    "汤里加几片番茄同煮，酸鲜更开胃。",
    "肉馅里包一小块荸荠碎，口感更脆爽。"
  ],
  "serving_suggestion": "连汤带丸盛入汤碗，撒葱花趁热喝。",
  "storage": "冷藏可存两天，丸子与汤分开存放，复热时再合并。",
