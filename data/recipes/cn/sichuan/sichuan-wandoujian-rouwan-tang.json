          "name_en": "cooking wine",
          "amount": 10,
          "unit": "ml",
          "note": "去腥",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1200,
          "unit": "ml",
          "note": "煮汤用",
