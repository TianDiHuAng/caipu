  "equipment": [
    "炒锅",
    "煮面锅",
    "面碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "炒锅烧热下植物油 20ml，放入猪肉末，中火煸炒至水分收干、肉末分散成颗粒。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉末下锅先别急着翻，等底部定型再炒散，才不粘锅。",
      "visual_cue": "肉末由粉红变褐、锅底渗出清亮油脂"
    },
    {
      "n": 2,
      "text": "加入冬菜碎与盐，继续小火炒 3 分钟至干香，淋 10ml 生抽翻匀，盛出即为臊子。",
      "time_min": 3,
      "heat": "小火",
      "tip": "冬菜本身有咸味，盐只放 3g 就够，宁淡勿咸。",
      "visual_cue": "臊子颗粒分明、油亮不湿"
    },
    {
      "n": 3,
      "text": "花椒用干锅小火焙 1 分钟至出香，碾成粉；芝麻酱用 20ml 温水搅成流动状。",
      "time_min": 2,
      "heat": "小火",
      "tip": "花椒焙到能闻到麻香即可，颜色变黑就苦了。",
      "visual_cue": "花椒一捏即碎，香气冲鼻"
    },
    {
      "n": 4,
      "text": "碗底调料：每碗放芝麻酱 20g、生抽 10ml、香醋 5ml、白糖 4g、蒜末、辣椒油 20ml、花椒粉，搅匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调料先放碗底，热面条落碗时能把香气激出来。",
      "visual_cue": "碗底呈红褐色浓稠酱汁"
    },
    {
      "n": 5,
      "text": "大火烧开清水，下挂面煮 3 分钟至断生，捞起沥水后放入碗中，铺上臊子、花生碎与葱花，拌开食用。",
      "time_min": 4,
      "heat": "大火",
      "tip": "面煮到中间留一点白芯就捞，拌的过程中余温会继续熟化。",
      "visual_cue": "面条挑起有弹性，咬开中心略带白点"
    }
  ],
  "tips": [
    "臊子可以一次炒 3 份量冷藏，早上煮面 3 分钟就能吃。",
    "没有宜宾芽菜时用冬菜或榨菜碎代替，但要先尝咸度再决定盐量。",
    "拌面时从碗底往上挑拌，让酱汁均匀裹住每根面。"
  ],
  "common_mistakes": [
    "肉末一下锅就大火猛炒，水分没干就结块，臊子发黏不香。",
    "芝麻酱直接用冷水调，结块调不开，应该用温水分次加。",
    "面条煮好后不过水直接堆在碗里，容易坨成一团。"
  ],
  "substitutions": [
    {
      "original": "挂面",
      "substitute": "碱水鲜面",
      "ratio": "200g 挂面 ≈ 240g 鲜面",
      "note": "鲜面煮 90 秒即可，口感更弹。"
    },
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "1:1",
      "note": "牛肉末需多加 5ml 植物油，避免炒干。"
    }
  ],
  "variations": [
    "家庭简化版：不炒臊子，用现成肉臊罐头加花生碎，5 分钟出餐。",
    "清汤担担面：碗底不加芝麻酱，改用 100ml 热高汤，做成汤面版本。"
  ],
  "serving_suggestion": "现拌现吃，配一碗清汤或酸菜汤解辣；一人食可作为快手午餐。",
  "storage": "臊子冷藏 4 天、冷冻 1 个月；调好的碗底酱汁当天用完，不宜久放。",
