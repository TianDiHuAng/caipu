  "equipment": [
    "汤锅",
    "打蛋器",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐先片成薄片再切细条，泡在清水里备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切豆腐刀蘸水，切面才光整。",
      "visual_cue": "豆腐条粗细均匀、不断裂"
    },
    {
      "n": 2,
      "text": "香菇切细丝，生姜切末，鸡蛋打散成蛋液备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香菇丝与豆腐条同粗细，口感才齐。",
      "visual_cue": "丝料均匀、蛋液无结块"
    },
    {
      "n": 3,
      "text": "汤锅下植物油烧热，放生姜末与香菇丝煸炒出香味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菇煸过才出鲜味，别直接下汤。",
      "visual_cue": "香菇变软、锅里有菌香"
    },
    {
      "n": 4,
      "text": "倒入清水烧开，加生抽、老抽、盐与白糖调味。",
      "time_min": 4,
      "heat": "大火",
      "tip": "先调味再勾芡，咸淡才均匀。",
      "visual_cue": "汤面微沸、颜色浅褐"
    },
    {
      "n": 5,
      "text": "下豆腐条煮两分钟，玉米淀粉调水慢慢淋入勾芡至微稠。",
      "time_min": 4,
      "heat": "中火",
      "tip": "边淋边搅，芡才不结疙瘩。",
      "visual_cue": "汤体挂勺、豆腐条完整"
    },
    {
      "n": 6,
      "text": "转小火，蛋液细线状淋入汤中，静置五秒再轻轻推开成蛋花。",
      "time_min": 2,
      "heat": "小火",
      "tip": "淋完别急着搅，蛋花才成片。",
      "visual_cue": "蛋花薄如云絮、汤面浮起"
    },
    {
      "n": 7,
      "text": "关火后加香醋与白胡椒搅匀，撒葱花盛碗即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "醋一定最后放，煮过就不酸了。",
      "visual_cue": "酸香扑鼻、汤色清亮微稠"
    }
  ],
  "tips": [
    "陈醋的酸味比白醋柔和，用香醋效果最佳。",
    "勾芡后要试一次咸淡，芡会带淡味道。",
    "白胡椒建议现磨，香气比粉状强得多。"
  ],
  "common_mistakes": [
    "把醋一开始就倒进锅里，煮到最后只剩涩味。",
    "蛋液大火下锅猛搅，蛋花碎成蛋渣。",
    "芡汁太厚，凉一会儿就凝成糊块。"
  ],
  "substitutions": [
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "60g 对 60g",
      "note": "口感更脆，需提前泡发。"
    },
    {
      "original": "嫩豆腐",
      "substitute": "北豆腐",
      "ratio": "250g 对 250g",
      "note": "不易碎，但口感偏硬。"
    }
  ],
  "variations": [
    "加一点猪肉末先炒散，汤更醇厚。",
    "喜欢辣可加一勺辣椒油，颜色更红亮。"
  ],
  "serving_suggestion": "趁热喝最舒服，配油条或煎饼都很搭。",
  "storage": "当天喝完最好，隔夜芡汁会返稀变淡。",
