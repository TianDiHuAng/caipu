  "steps": [
    {
      "n": 1,
      "text": "莲藕削皮后切成两毫米厚的薄片，切好立刻泡进加了少许盐的清水里，防止氧化发黑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "选两头完整、孔洞小的脆藕，切开的藕遇空气很快变色。",
      "visual_cue": "藕片洁白透亮，厚薄一致。"
    },
    {
      "n": 2,
      "text": "汤锅水烧开加盐，下藕片焯一分半钟，断生即用漏勺捞出，投入冰水中过凉。",
      "time_min": 5,
      "heat": "大火",
      "tip": "焯的时间宁短勿长，超过两分钟藕片就发面失去脆劲。",
      "visual_cue": "藕片由白转透，边缘略呈半透明。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到六成热，下干辣椒节和花椒炸到香味冲鼻，趁热泼在蒜末上。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温不够激不出香，冒烟就过头会苦，看到辣椒变暗红立刻关火。",
      "visual_cue": "蒜末边缘起泡，红油香气扑鼻。"
    },
    {
      "n": 4,
      "text": "大碗放生抽、香醋、白糖和盐搅匀，倒入泼好的蒜末红油与辣椒油拌匀成料汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先尝一口料汁再拌藕，酸辣要略重一点，藕片本身不带味。",
      "visual_cue": "料汁呈琥珀红色，糖盐完全化开。"
    },
    {
      "n": 5,
      "text": "藕片沥干水分倒入料汁中，加香菜段和葱花抓拌均匀，冷藏十分钟后装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "藕片一定要沥干，带水会把料汁冲淡；拌好静置十分钟更入味。",
      "visual_cue": "藕片均匀挂上红亮料汁，脆挺不软塌。"
    }
  ],
  "tips": [
    "脆藕看孔，九孔七孔都行，只要切开断面水分足。",
    "焯水后冰镇是保持脆度的关键步骤。",
    "料汁里加半勺糖，酸辣才不尖锐。"
  ],
  "common_mistakes": [
    "藕片切好泡在铁锅里，氧化后发黑发暗。",
    "焯水时间过长，藕片发面一拌就碎。",
    "干辣椒油温过高炸糊，整碗料汁带苦味。"
  ],
  "substitutions": [
    {
      "original": "莲藕",
      "substitute": "莴笋",
      "ratio": "500克:500克",
      "note": "莴笋切条后只需焯三十秒，口感更水嫩但要现拌现吃。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "18毫升:18毫升",
      "note": "米醋酸味更柔和，白糖可相应减到五克。"
    }
  ],
  "variations": [
    "成都街头版会加一勺花椒油，麻味更突出。",
    "有的做法把藕片换成藕丁，焯后更易入味，适合下酒。"
  ],
  "serving_suggestion": "冰镇后装浅盘，撒点熟芝麻更香，配啤酒或稀饭都合适，夏天当开胃小菜最好。",
  "storage": "冷藏密封可存两日，藕片会慢慢吸收料汁变深，食用前补一勺辣椒油提香。",
