  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "打蛋碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青蒜择洗干净，蒜白斜切成段、蒜叶切成三厘米长的段，分开放置备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜白蒜叶熟成时间差很多，分开下锅才不老不生。",
      "visual_cue": "蒜白断面雪白，蒜叶翠绿挺括。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加盐和白胡椒粉搅匀，炒锅放三十毫升植物油烧热，倒蛋液炒成大块盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "加白胡椒粉是去腥的老办法，比料酒更适合炒蛋。",
      "visual_cue": "蛋块金黄蓬松，边缘略微起泡。"
    },
    {
      "n": 3,
      "text": "锅内补十五毫升植物油，下干辣椒节小火炸出香味，先放蒜白大火炒一分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "干辣椒炸到颜色变深就下蒜白，炸黑了整锅发苦。",
      "visual_cue": "辣椒节深红，蒜白边缘透亮。"
    },
    {
      "n": 4,
      "text": "倒入蒜叶与蛋块，加生抽快速翻匀，蒜叶刚软就关火出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "蒜叶断生即可，多炒十秒就发黄失香。",
      "visual_cue": "蒜叶翠绿微软，蛋块裹上酱色。"
    }
  ],
  "tips": [
    "蒜白先下锅、蒜叶后放，成熟度才一致。",
    "炒蛋的油要够热，蛋块才蓬松不吸油。",
    "生抽出锅前才放，酱香立得住不糊锅。"
  ],
  "common_mistakes": [
    "蒜白蒜叶一起下锅，蒜叶烂了蒜白还生。",
    "油温不够就倒蛋液，蛋块又老又吸油。",
    "全程小火慢炒，青蒜出水发黄变蔫。"
  ],
  "substitutions": [
    {
      "original": "青蒜",
      "substitute": "大葱",
      "ratio": "150克:150克",
      "note": "大葱甜味更足、辛辣更淡，切段后同样分葱白葱绿下锅。"
    },
    {
      "original": "干辣椒",
      "substitute": "小米辣",
      "ratio": "3克:5克",
      "note": "小米辣鲜辣突出，可与蒜白同时下锅。"
    }
  ],
  "variations": [
    "川西做法会加少许豆豉同炒，酱香更厚。",
    "有的家庭把蒜白先用油煸到微焦再下蛋，香气更足。"
  ],
  "serving_suggestion": "热锅现炒现吃，配米饭、拌面或夹馒头都香，锅气最要紧。",
  "storage": "冷藏可存一日，复热时大火快炒三十秒；青蒜久放会发黄变味，建议当餐吃完。",
