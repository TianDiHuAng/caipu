  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "漏勺",
    "深盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成两厘米见方的块，放入加了盐和料酒的开水里小火焯三分钟捞出沥干。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盐水焯能去豆腥并让豆腐收紧不易碎。",
      "visual_cue": "豆腐块完整不散，表面微皱。"
    },
    {
      "n": 2,
      "text": "火腿切薄片，香菇切薄片，姜切片备用，香菇片用泡菇水略泡去杂味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香菇片要切得与豆腐块厚度相仿，口感才协调。",
      "visual_cue": "配料切片均匀，火腿透光。"
    },
    {
      "n": 3,
      "text": "炒锅放猪油小火化开到四成热，下姜片和火腿片煸出香味，不要上色。",
      "time_min": 4,
      "heat": "小火",
      "tip": "白油豆腐讲究油白不黄，全程小火，一见焦边就不白了。",
      "visual_cue": "猪油清亮，火腿片微微卷边。"
    },
    {
      "n": 4,
      "text": "加清水和料酒烧开，放入豆腐块和香菇片，转小火盖盖烧八分钟入味。",
      "time_min": 9,
      "heat": "小火",
      "tip": "下豆腐后不要大力翻动，用勺背推锅才不碎。",
      "visual_cue": "汤汁浅白，豆腐浮沉翻滚。"
    },
    {
      "n": 5,
      "text": "加盐、白糖和白胡椒调味，玉米淀粉加水化开后缓缓淋入，轻推至汤汁微稠挂勺。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芡要薄，白油豆腐吃的是清鲜，芡厚了就发糊。",
      "visual_cue": "汤汁透亮微稠，均匀裹住豆腐。"
    },
    {
      "n": 6,
      "text": "起锅装深盘，撒上葱花，趁热吃，汤汁可拌饭。",
      "time_min": 2,
      "heat": "无火",
      "tip": "装盘用深盘，汤汁多留一些才润口。",
      "visual_cue": "豆腐洁白，汤汁清亮。"
    }
  ],
  "tips": [
    "白油用的是猪油，油气白而香，用植物油做不出这个味道。",
    "豆腐必须盐水焯过，否则一烧就散，汤也浑。",
    "全程小火不出焦色，是这道菜成败的关键。"
  ],
  "common_mistakes": [
    "用大火炒香配料，锅底焦黄，汤汁发灰不发白。",
    "豆腐下锅就用锅铲翻，碎成小块不成形。",
    "勾芡太厚，清鲜的白油汁变成糊状。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "40克:35毫升",
      "note": "素食者可用植物油，但少了猪油的醇香，需另加少许香油补味。"
    },
    {
      "original": "火腿",
      "substitute": "香菇",
      "ratio": "40克:60克",
      "note": "不吃火腿可全用香菇，鲜味偏素雅，盐可略减。"
    }
  ],
  "variations": [
    "有的做法加几片冬笋同烧，口感更脆，鲜味更清。",
    "成都老馆子会加一勺奶汤，汤汁更白更浓。"
  ],
  "serving_suggestion": "连汁装深盘，撒葱花趁热吃；配白饭，一勺汤汁拌饭极香。",
  "storage": "冷藏可存两日，复热加少量清水小火煨开，别用大火翻动。",
