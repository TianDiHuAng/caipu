  "equipment": [
    "炒锅",
    "汤碗",
    "打蛋碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄划十字口，用开水烫三十秒后撕去外皮，切成滚刀块。",
      "time_min": 4,
      "heat": "无火",
      "tip": "去皮后汤更顺滑，不去皮会有卷曲的皮渣。",
      "visual_cue": "番茄皮完整撕下、块形均匀"
    },
    {
      "n": 2,
      "text": "鸡蛋磕入碗中加一小撮盐打散，打到蛋液均匀起细泡。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蛋液打匀起泡，煎出来才蓬松。",
      "visual_cue": "蛋液均匀、表面有细泡"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧热，倒入蛋液摊成厚蛋饼，两面煎到金黄。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "蛋饼煎厚一点，切块后更有嚼头。",
      "visual_cue": "蛋饼两面金黄、边缘微焦"
    },
    {
      "n": 4,
      "text": "把蛋饼铲成大块盛出，锅中留底油下番茄块中火翻炒出汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄要炒到软塌出红汁，汤色才红亮。",
      "visual_cue": "番茄软塌、锅底见红汁"
    },
    {
      "n": 5,
      "text": "冲入清水大火烧开，倒回蛋块，加盐和白胡椒粉煮三分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "蛋块后放，久煮会散成絮状。",
      "visual_cue": "汤色橙红、蛋块完整"
    },
    {
      "n": 6,
      "text": "关火后淋上香油、撒上葱花，盛入汤碗趁热喝最鲜。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香油关火后再淋，香气不挥发。",
      "visual_cue": "汤面浮香油花、葱花翠绿"
    }
  ],
  "tips": [
    "番茄选熟软沙瓤的，出汁多、酸味柔和。",
    "喜欢浓稠口感可把一半番茄剁碎先炒成番茄糊。",
    "蛋饼煎得老一些，泡在汤里也不容易散。"
  ],
  "common_mistakes": [
    "番茄没炒出汁就加水，汤色发白发淡。",
    "蛋液没打散就下锅，煎出来一块白一块黄。",
    "盐放太多，番茄的酸甜被压住，只剩咸味。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "300g 对 250g",
      "note": "罐头偏酸，糖可加一小撮平衡。"
    },
    {
      "original": "植物油",
      "substitute": "猪油",
      "ratio": "20ml 对 15g",
      "note": "猪油煎蛋更香，汤头更醇。"
    }
  ],
  "variations": [
    "加一把豌豆尖同煮，清香解腻，汤色更清爽。",
    "起锅前下一小把面条，做成番茄蛋汤面。"
  ],
  "serving_suggestion": "配米饭或馒头，酸鲜开胃，适合早餐或宵夜。",
  "storage": "冷藏一天，复热要煮开，蛋块易散不宜久煮。",
