  "equipment": [
    "炒锅",
    "汤锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "木耳提前泡发撕成小朵，花菜掰成小朵用清水冲净。",
      "time_min": 15,
      "heat": "无火",
      "tip": "花菜缝隙藏泥，要多冲几遍。",
      "visual_cue": "花菜成朵、木耳无硬根"
    },
    {
      "n": 2,
      "text": "五花肉切两毫米薄片，虾仁挑去背上的黑线后用料酒抓匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉片薄，炒出来才不腻。",
      "visual_cue": "肉片薄匀透光、虾仁干净"
    },
    {
      "n": 3,
      "text": "汤锅烧开水，花菜与木耳分别焯水两分钟后沥干。",
      "time_min": 6,
      "heat": "大火",
      "tip": "先焯水，后面炒制才不会出水。",
      "visual_cue": "花菜半透明、木耳更黑亮"
    },
    {
      "n": 4,
      "text": "炒锅下植物油，冷油放花椒、八角与桂皮小火炸出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "冷油下香料，香气才慢慢释放。",
      "visual_cue": "香料变色、油面飘香"
    },
    {
      "n": 5,
      "text": "下五花肉片中火爆到微焦出油，再下虾仁炒到变色。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "五花肉煸出油，香味才够厚。",
      "visual_cue": "肉片卷曲微焦、虾仁转红"
    },
    {
      "n": 6,
      "text": "加豆瓣酱与干辣椒段小火炒出红油，再下大葱段与姜蒜爆香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆瓣酱必须小火炒透才不苦。",
      "visual_cue": "锅中红油渗出、香气冲鼻"
    },
    {
      "n": 7,
      "text": "转大火下花菜、香菇与木耳翻炒两分钟裹匀底味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火快炒，蔬菜才脆不出水。",
      "visual_cue": "蔬菜油亮、表面挂满红油"
    },
    {
      "n": 8,
      "text": "加生抽、白糖与盐快速翻匀，试味后撒香菜段出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆瓣酱本身很咸，盐要少放。",
      "visual_cue": "锅底干爽无汤、香菜香气散出"
    }
  ],
  "tips": [
    "配菜按耐炒程度分批下，口感层次更好。",
    "香料炸香后可以捞出，避免吃到颗粒。",
    "喜欢更麻可在出锅前一分钟再撒花椒粉。"
  ],
  "common_mistakes": [
    "配菜没焯水直接炒，锅里出水变成炖菜。",
    "豆瓣酱大火快炒，一瞬间就糊出苦味。",
    "盐没有相应减量，豆瓣酱已经足够咸了。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "牛肉",
      "ratio": "200g 对 200g",
      "note": "逆纹切薄片，炒制时间要短。"
    },
    {
      "original": "虾仁",
      "substitute": "鸭血",
      "ratio": "150g 对 200g",
      "note": "需焯透，口感更滑嫩。"
    }
  ],
  "variations": [
    "喜欢重口可加一勺火锅底料同炒。",
    "加一把藕片和土豆片，更像川渝夜市风味。"
  ],
  "serving_suggestion": "配一碗白饭直接浇着吃，辣到冒汗才过瘾。",
  "storage": "冷藏可放两天，复热时加少许水炒开。",
