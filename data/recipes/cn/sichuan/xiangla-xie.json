  "equipment": [
    "炒锅",
    "锅铲",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花蟹用刷子刷净花蟹壳与花蟹脚，揭壳去鳃，斩成四块，花蟹钳拍裂。",
      "time_min": 12,
      "heat": "无火",
      "tip": "花蟹鳃与花蟹心都要去净，否则发腥。",
      "visual_cue": "花蟹壳干净、斩块断口整齐"
    },
    {
      "n": 2,
      "text": "花蟹块切面拍上玉米淀粉，抖掉多余的粉备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "切面拍粉，煎时花蟹汁不流失。",
      "visual_cue": "切面薄薄一层白粉、不结块"
    },
    {
      "n": 3,
      "text": "炒锅下植物油烧热，花蟹块切面朝下中火煎两分钟至定型。",
      "time_min": 5,
      "heat": "中火",
      "tip": "先煎切面，花蟹的肉才不会散。",
      "visual_cue": "切面金黄、花蟹壳转红"
    },
    {
      "n": 4,
      "text": "把花蟹块推到一边，下豆瓣酱小火炒出红油，再放生姜、大蒜与小米辣炒香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆瓣酱要小火炒，火大就发苦。",
      "visual_cue": "油色红亮、香辣味冲鼻"
    },
    {
      "n": 5,
      "text": "烹入料酒，加生抽、白糖、盐与半碗清水，加盖中火焖三分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "焖三分钟让花蟹的肉吸进辣味。",
      "visual_cue": "汤汁转红、花蟹壳油亮"
    },
    {
      "n": 6,
      "text": "放入大葱段转大火翻炒收汁，汁水裹住花蟹块即可出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "收汁要快，久炒花蟹的肉会老。",
      "visual_cue": "汤汁浓稠挂壳、葱段翠绿"
    }
  ],
  "tips": [
    "花蟹选活的，掂着沉手的肉更饱满。",
    "蟹钳用刀背拍裂，吃的时候好剥也易入味。",
    "怕辣可以把小米辣减半，多放一点葱段提香。"
  ],
  "common_mistakes": [
    "蟹块不拍粉直接下锅，蟹汁流失肉质发柴。",
    "豆瓣酱大火猛炒，红油没出色先出焦味。",
    "焖煮时间过长，蟹肉缩水变成一丝丝。"
  ],
  "substitutions": [
    {
      "original": "花蟹",
      "substitute": "梭子蟹",
      "ratio": "800g 对 800g",
      "note": "壳更硬，斩块时用厚刀背。"
    },
    {
      "original": "小米辣",
      "substitute": "辣椒酱",
      "ratio": "15g 对 20g",
      "note": "辣度更柔和，咸度需减盐。"
    }
  ],
  "variations": [
    "加一把年糕同焖，吸饱辣汁后特别好吃。",
    "把豆瓣酱换成蒜蓉与豆豉，就是另一路的豉香蟹。"
  ],
  "serving_suggestion": "趁热上桌，配啤酒或冰镇酸梅汤都合适。",
  "storage": "当天吃完，蟹类隔夜易生腥味不宜再食。",
