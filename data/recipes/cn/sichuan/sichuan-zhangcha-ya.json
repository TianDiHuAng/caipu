    "蒸锅",
    "烤盘",
    "烤箱",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "盐与花椒下干锅小火炒到微黄出香，趁热均匀抹遍鸭身内外。",
      "time_min": 8,
      "heat": "小火",
      "tip": "盐要炒过才香，生盐腌出来只有死咸没有香味。",
      "visual_cue": "盐粒泛黄，花椒香气明显"
    },
    {
      "n": 2,
      "text": "鸭肉抹匀料酒、八角、姜片与葱结，冷藏腌四小时以上，中途翻面一次。",
      "time_min": 240,
      "heat": "无火",
      "tip": "腌足时间才有底味，急着做的至少也要两小时。",
      "visual_cue": "鸭皮收紧，表面干爽不出水"
    },
    {
      "n": 3,
      "text": "腌好的鸭用清水冲掉表面盐粒，擦干后再抹一层老抽上色。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐要冲净，不然熏完咸得发苦、颜色也发黑。",
      "visual_cue": "鸭皮呈浅酱色，摸起来干爽不黏"
    },
    {
      "n": 4,
      "text": "鸭身上锅大火蒸四十分钟，蒸到骨边不见血水后取出晾干。",
      "time_min": 45,
      "heat": "大火",
      "tip": "蒸过的鸭肉才嫩，直接熏会又干又硬。",
      "visual_cue": "鸭腿轻晃即离骨，盘底积起清汤"
    },
    {
      "n": 5,
      "text": "炒锅垫锡纸放绿茶、白糖和少许干茶叶，架上篦子摆鸭盖严熏八分钟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "锅一定要盖严，烟跑光了就只剩一股焦味。",
      "visual_cue": "锅边冒白烟，鸭皮转成枣红色"
    },
    {
      "n": 6,
      "text": "熏好的鸭刷一层植物油，入两百度烤箱烤二十分钟至皮脆。",
      "time_min": 22,
      "heat": "大火",
      "tip": "刷油这步别省，皮烤出来才亮、才脆。",
      "visual_cue": "表皮油亮起酥，按压有脆响"
    }
  ],
  "tips": [
    "家里没有烤箱可改用热油淋皮，反复浇三分钟同样能起脆。",
    "熏料里加一小勺红糖，颜色更红亮，苦味也比白糖轻。",
    "樟树叶买不到就用绿茶代替，香气以茶香为主，一样好吃。"
  ],
  "common_mistakes": [
    "熏制时没盖严锅盖，烟全跑了，鸭皮一点颜色都没上。",
    "熏的时间太长，糖烧焦后整只鸭带苦味，只能扔掉。",
    "鸭没蒸透就进烤箱，外面烤干了里面还带血。"
  ],
  "substitutions": [
    {
      "original": "鸭",
      "substitute": "鸡",
      "ratio": "1000克:1000克",
      "note": "整鸡更易熟，蒸的时间缩到三十分钟。"
    },
    {
      "original": "绿茶",
      "substitute": "龙井茶",
      "ratio": "15克:15克",
      "note": "龙井香气更清，糖量可减五克。"
    }
  ],
  "variations": [
    "熏好斩块直接冷吃，是最传统的做法，皮脆肉香不上火。",
    "配荷叶饼、甜面酱与葱丝卷着吃，就是川式烤鸭的吃法。"
  ],
  "serving_suggestion": "斩成两厘米宽的条，皮朝上摆盘，配荷叶饼与甜面酱卷食。",
  "storage": "冷藏可存两天，复热用两百度烤箱烤八分钟，别用微波以免皮软。",
