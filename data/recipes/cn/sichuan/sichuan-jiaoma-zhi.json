  "equipment": [
    "石臼",
    "小碗",
    "炒锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花椒挑去黑籽和枝梗，只留红色果皮，用小火在干锅里焙三十秒出香后摊凉。",
      "time_min": 5,
      "heat": "小火",
      "tip": "花椒籽发苦，一定要挑净，只取果皮麻香才纯。",
      "visual_cue": "花椒壳脆易碎，麻香扑鼻。"
    },
    {
      "n": 2,
      "text": "小葱洗净沥干，只取葱叶切成碎末，葱白另行留作炒菜用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "葱叶香而不冲，葱白辛辣会盖住花椒的清麻。",
      "visual_cue": "葱叶细碎成末，颜色深绿。"
    },
    {
      "n": 3,
      "text": "把焙好的花椒与葱叶末一同放进石臼，加盐后用杵反复舂成细腻的椒麻泥。",
      "time_min": 6,
      "heat": "无火",
      "tip": "舂到看不见明显颗粒才好，机器打容易发热变味。",
      "visual_cue": "椒麻泥细腻发绿，麻香冲鼻。"
    },
    {
      "n": 4,
      "text": "椒麻泥移入小碗，加生抽、白糖、味精和清水调开，搅到盐糖完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先调稀再淋油，汁才会挂住食材不沉底。",
      "visual_cue": "汁色棕绿，质地顺滑。"
    },
    {
      "n": 5,
      "text": "香油烧到微微冒烟，趁热淋入椒麻汁中搅匀，激出麻香后静置五分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "热油激香是椒麻汁提味的关键，冷油淋只有生麻味。",
      "visual_cue": "油花浮面，麻香四溢。"
    }
  ],
  "tips": [
    "花椒选汉源清溪的，麻味正且回甜，不苦不涩。",
    "葱叶要沥干水再舂，带水容易出涩味。",
    "现舂现用最好，放久葱叶氧化发黄，香气也散。"
  ],
  "common_mistakes": [
    "花椒连籽一起舂，吃着发苦带沙感。",
    "葱叶切得太粗，挂不住食材，汁水分离。",
    "用冷香油直接拌，麻香出不来，只有一股生油味。"
  ],
  "substitutions": [
    {
      "original": "花椒",
      "substitute": "花椒",
      "ratio": "1:1",
      "note": "若无鲜花椒，可用花椒油两勺替代，但麻香较薄。"
    },
    {
      "original": "小葱",
      "substitute": "香菜",
      "ratio": "100克:60克",
      "note": "换成香菜即香菜麻汁，香气转清鲜，适合拌鸡丝。"
    }
  ],
  "variations": [
    "有的做法把葱叶与花椒用刀背剁成茸，口感更粗犷，麻味更冲。",
    "加一勺藤椒油可做成藤椒版，麻味更清冽。"
  ],
  "serving_suggestion": "淋在白切鸡、肚丝或嫩笋上；也可作凉面的调味汁，一勺就够。",
  "storage": "密封冷藏可存三日，葱叶会逐渐发黄；建议现做现用，不冷冻。",
