  "steps": [
    {
      "n": 1,
      "text": "虾仁背部划开挑出背部黑色肠线，用料酒和玉米淀粉抓匀上浆，静置十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "上浆能锁住虾仁水分，炒出来才弹嫩不柴。",
      "visual_cue": "虾仁挂一层薄浆，色泽透亮。"
    },
    {
      "n": 2,
      "text": "豆瓣酱剁细，泡椒切碎，大蒜和姜切末，小葱切葱花备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豆瓣酱剁细才不硌口，红油也更容易出。",
      "visual_cue": "酱料细腻，配料末状均匀。"
    },
    {
      "n": 3,
      "text": "炒锅烧热放六十毫升植物油，四成热下虾仁滑炒到变色立刻盛出控油。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油温四成就下虾仁，太高外表焦了里面还生。",
      "visual_cue": "虾仁变红卷曲，表面微亮。"
    },
    {
      "n": 4,
      "text": "锅内留底油，下豆瓣酱和泡椒小火炒出红油，再放姜末蒜末炒香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆瓣酱一定要小火慢炒，火大立刻发苦。",
      "visual_cue": "红油透亮翻砂，酱香扑鼻。"
    },
    {
      "n": 5,
      "text": "倒回虾仁，加生抽和白糖，大火快速翻炒三十秒裹匀酱汁，撒葱花出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "虾仁回锅只需裹匀酱汁，久炒就失去弹性。",
      "visual_cue": "虾仁红亮裹酱，盘中红油清亮。"
    }
  ],
  "tips": [
    "虾仁先抓浆再滑油，出锅口感才弹嫩不发柴",
    "豆瓣酱小火炒出红油，是川味基础。",
    "回锅裹汁三十秒，久炒虾仁发硬。",
    "滑油油温四成即可，油太热虾仁会焦。"
  ],
  "common_mistakes": [
    "虾仁不上浆就直接下锅炒，出水发柴不嫩。",
    "豆瓣酱大火炒糊，整盘味道发苦。",
    "虾仁在锅里反复翻炒，缩成小硬粒。",
    "酱料没炒出红油就把虾仁下锅，颜色发暗不香。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡腿肉",
      "ratio": "300克:300克",
      "note": "鸡腿肉切丁同样上浆，滑炒时间延长一分钟，即成豆瓣鸡丁。"
    },
    {
      "original": "泡椒",
      "substitute": "小米辣",
      "ratio": "20克:10克",
      "note": "小米辣只辣不酸，需补五毫升香醋提酸香。"
    }
  ],
  "variations": [
    "有的做法加一把熟花生同炒，脆香更丰富。",
    "加青笋丁或藕丁同炒，口感更清爽。"
  ],
  "serving_suggestion": "盛盘趁热吃，红油裹着虾仁，配白饭一勺酱汁就能吃下半碗。",
  "storage": "冷藏可存一日，复热用小火干炒一分钟；虾仁反复加热易硬，建议当餐吃完。",
