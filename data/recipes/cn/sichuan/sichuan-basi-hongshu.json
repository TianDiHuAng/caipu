  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "漏勺",
    "盘子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红薯削皮，切成三厘米见方的滚刀块。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块大小一致，炸和裹糖才同步。，看准状态再往下做。",
      "visual_cue": "块形方正，大小均匀"
    },
    {
      "n": 2,
      "text": "切好的红薯用清水冲一遍，沥干表面水分。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "带水下锅会溅油，务必沥干。，看准状态再往下做。",
      "visual_cue": "表面干爽，不滴水，这一点很关键。"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，下红薯块中火炸。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "中火慢炸，里面才糯不夹生。，看准状态再往下做。",
      "visual_cue": "表面定型，周边起泡"
    },
    {
      "n": 4,
      "text": "炸到筷子能轻松插入，捞出沥油。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "插得动就熟，别炸到发干。，看准状态再往下做。",
      "visual_cue": "外皮金黄，块体轻软"
    },
    {
      "n": 5,
      "text": "另起锅放白糖和清水，小火熬到糖化。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "水别多，糖水比例大概四比一。，看准状态再往下做。",
      "visual_cue": "糖水清亮，气泡细密"
    },
    {
      "n": 6,
      "text": "继续熬到糖浆变浅黄、能拉出细丝。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "颜色一变黄就下料，过了就苦。，看准状态再往下做。",
      "visual_cue": "糖浆金黄，拉丝不断"
    },
    {
      "n": 7,
      "text": "立刻倒入红薯块，快速翻拌让糖浆裹匀。，看准状态再往下做。",
      "time_min": 2,
      "heat": "小火",
      "tip": "动作要快，糖凉了就裹不上。，看准状态再往下做。",
      "visual_cue": "每块亮晶晶挂糖，这一点很关键。"
    },
    {
      "n": 8,
      "text": "撒白芝麻，盛入抹油的盘子里趁热吃。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘子抹油，凉了才不粘底。，看准状态再往下做。",
      "visual_cue": "糖丝可拉长，芝麻点缀"
    }
  ],
  "tips": [
    "红薯块要沥干水，下油锅才不溅。，这一点很关键。",
    "糖浆变浅黄就下料，深了发苦。，这一点很关键。",
    "出锅装抹油的盘子，不然凉了抠不下来。"
  ],
  "common_mistakes": [
    "糖熬过头变深褐，整盘带苦味。，这一点很关键。",
    "红薯没炸透，外面裹糖里面硬。，这一点很关键。",
    "装普通盘子，凉了粘成一块。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "红薯",
      "substitute": "山药",
      "ratio": "600 克:600 克",
      "note": "口感更粉，炸的时间加两分钟。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "120 克:130 克",
      "note": "糖丝更长，化得慢些。"
    }
  ],
  "variations": [
    "换成芋头，做成拔丝芋头。，这一点很关键。",
    "撒一点桂花，香气更雅。，这一点很关键。"
  ],
  "serving_suggestion": "趁热上桌，配一碗凉水蘸着吃。，这一点很关键。",
  "storage": "当日吃完，冷藏后糖壳返砂变硬。，这一点很关键。",
