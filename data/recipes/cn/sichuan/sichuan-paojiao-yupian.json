  "steps": [
    {
      "n": 1,
      "text": "草鱼去皮去骨斜刀片成三毫米薄片，加料酒、盐和玉米淀粉抓匀上浆，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "斜刀逆纹片，鱼片才嫩；淀粉抓匀锁住水分不散。",
      "visual_cue": "鱼片薄而透亮，表面挂一层薄浆。"
    },
    {
      "n": 2,
      "text": "泡椒切圈，芹菜切段，大蒜和姜切片，小葱切段备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "泡椒连一点泡椒水一起下，酸香才够正。",
      "visual_cue": "配料切好分堆，泡椒红亮。"
    },
    {
      "n": 3,
      "text": "炒锅放三十毫升植物油，下姜片蒜片和泡椒小火炒两分钟，炒出酸辣香气。",
      "time_min": 3,
      "heat": "小火",
      "tip": "泡椒小火炒，酸香慢慢释放，火大会发苦。",
      "visual_cue": "锅中红油微亮，酸辣味窜出。"
    },
    {
      "n": 4,
      "text": "加入清水烧开，放盐和白糖调味，下芹菜段煮一分钟后把鱼片一片片抖散滑入。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鱼片要一片片下锅，堆在一起会粘连成坨。",
      "visual_cue": "鱼片卷曲发白，汤汁微沸。"
    },
    {
      "n": 5,
      "text": "鱼片变白后立刻关火，补三十毫升植物油烧热浇在葱段上激香，连汤带片盛入碗中。",
      "time_min": 3,
      "heat": "中火",
      "tip": "鱼片一白就关火，多煮十秒肉质立刻变柴。",
      "visual_cue": "鱼片嫩白完整，汤面浮着红油。"
    }
  ],
  "tips": [
    "鱼片逆纹斜切成薄片，入口才嫩不散。",
    "泡椒连泡椒水一起下锅，酸香更正。",
    "鱼片一白立刻关火，多煮十秒就柴。",
    "上浆静置十分钟，鱼片吸足水分更滑嫩。"
  ],
  "common_mistakes": [
    "鱼片切得太厚，煮后外老内生嚼不动。",
    "泡椒用大火炒，酸香变成焦苦味。",
    "鱼片全部倒进锅里，粘成一坨捞不开。",
    "汤底一直大火滚，鱼片被冲散成碎渣。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲈鱼",
      "ratio": "500克:500克",
      "note": "鲈鱼刺少肉紧，上浆时间缩短到五分钟，口感更清爽。"
    },
    {
      "original": "泡椒",
      "substitute": "野山椒",
      "ratio": "60克:50克",
      "note": "野山椒辣度更冲、酸味略弱，白糖加到五克平衡。"
    }
  ],
  "variations": [
    "有的家庭加一把豆芽垫底，吸足汤汁更好吃。",
    "川东做法会撒花椒粉，麻辣带酸更开胃。"
  ],
  "serving_suggestion": "盛入深碗连汤上桌，鱼片滑嫩、汤汁酸辣，浇在米饭上尤其下饭。",
  "storage": "冷藏可存一日，回锅小火加热到微沸即关火；鱼片反复加热会散碎，不建议二次复热。",
