        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "虾仁",
          "name_en": "peeled shrimp",
          "amount": 100,
          "unit": "g",
          "note": "去虾线的鲜虾仁",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 270,
          "unit": "ml",
          "note": "约为蛋液的一点八倍",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调蛋液底味",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 5,
          "unit": "ml",
          "note": "腌虾去腥",
          "optional": false
        },
        {
