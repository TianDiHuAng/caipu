          "unit": "g",
          "note": "虾仁上浆",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 8,
          "unit": "ml",
          "note": "出锅淋面",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 3,
          "unit": "ml",
          "note": "出锅点香",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 8,
          "unit": "g",
          "note": "切细葱花",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "打蛋碗",
    "细筛",
    "小碗",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕入碗中打散，加盐和清水搅匀，用细筛过滤两遍去掉泡沫与系带。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过滤这一遍别省，蛋液细腻蒸出来才没有蜂窝孔洞。",
      "visual_cue": "蛋液呈浅黄色，表面没有气泡。"
    },
    {
      "n": 2,
      "text": "蛋液倒入浅口碗，盖上保鲜膜扎几个小孔，水开后中小火蒸八分钟。",
      "time_min": 9,
      "heat": "中小火",
      "tip": "全程中小火，火大蛋液翻滚就会蒸出蜂窝和腥味。",
      "visual_cue": "蛋面平整如镜，轻晃有嫩滑颤动。"
    },
    {
      "n": 3,
      "text": "虾仁挑去背部泥线，加料酒和生粉抓匀腌三分钟，另起锅焯三十秒捞出。",
      "time_min": 4,
      "heat": "中火",
      "tip": "虾仁焯到卷曲变红就好，久煮会缩成硬球。",
      "visual_cue": "虾仁卷成弯月，颜色转为粉红。"
    },
    {
      "n": 4,
      "text": "掀开保鲜膜把虾仁摆到蛋面，再盖回蒸三分钟，关火虚蒸两分钟取出。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "虚蒸两分钟让蛋羹定型，直接开盖容易回缩塌陷。",
      "visual_cue": "虾仁嵌在蛋面，蛋羹边缘不缩边。"
    },
    {
      "n": 5,
      "text": "淋上生抽和香油，撒小葱花的细末，趁热上桌用小勺挖着吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "生抽沿碗边淋，蛋面才不会被冲出一道沟。",
      "visual_cue": "酱汁在蛋面晕开，葱花翠绿点缀。"
    }
  ],
  "tips": [
    "蛋液与清水按一比一点八配，嫩度最稳。",
    "蒸碗选浅口宽底的，受热均匀不易夹生。",
    "盖保鲜膜扎孔，水汽就不会滴进蛋面。"
  ],
  "common_mistakes": [
    "大火猛蒸，蛋羹表面全是蜂窝孔洞。",
    "蛋液不过筛，蒸好底下沉一层硬块。",
    "盐直接撒在蛋面，咸味分布不均匀。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "干贝",
      "ratio": "100克:40克",
      "note": "干贝需提前泡发撕丝，鲜味更浓但成本更高。"
    },
    {
      "original": "清水",
      "substitute": "鸡汤",
      "ratio": "270毫升:270毫升",
      "note": "换成清鸡汤鲜味更足，盐要减到两克。"
    }
  ],
  "variations": [
    "川渝家常版会加一勺肉臊子做成臊子蒸蛋，咸鲜更浓。",
    "有的做法在蛋液里加两滴香醋，蛋羹更嫩且去腥。"
  ],
  "serving_suggestion": "用小勺从边缘挖着吃，配白粥或作为幼儿辅食都合适，趁热最嫩。",
  "storage": "冷藏可存一日，回蒸三分钟即恢复嫩滑；不建议冷冻，蛋羹会析水变渣。",
