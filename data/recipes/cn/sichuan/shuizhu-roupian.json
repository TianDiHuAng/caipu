  "steps": [
    {
      "n": 1,
      "text": "猪里脊逆着纹路切成两毫米厚的大薄片，用清水抓洗两遍挤干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逆纹切才不塞牙，洗去血水肉片更白。",
      "visual_cue": "肉片透光均匀、手指能推薄"
    },
    {
      "n": 2,
      "text": "肉片加盐、料酒、生抽抓匀，再拌入玉米淀粉上浆腌十五分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "淀粉裹住肉片，煮时才不老。",
      "visual_cue": "每片肉都挂上薄浆、不粘手"
    },
    {
      "n": 3,
      "text": "黄豆芽与莴苣片下沸水焯两分钟，捞出铺在深碗底部。",
      "time_min": 4,
      "heat": "大火",
      "tip": "蔬菜垫底吸收汤汁，比直接煮更香。",
      "visual_cue": "黄豆芽断生、莴苣片透亮"
    },
    {
      "n": 4,
      "text": "炒锅下植物油，中小火炒香豆瓣酱与生姜末，炒到出红油。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "豆瓣酱必须炒出红油才够香。",
      "visual_cue": "油色深红、豆瓣酥香"
    },
    {
      "n": 5,
      "text": "倒入清水烧开，加生抽与白糖调味，转小火保持微沸。",
      "time_min": 4,
      "heat": "中火",
      "tip": "汤要保持微沸，滚太猛肉片会散。",
      "visual_cue": "汤面细泡不断、颜色红亮"
    },
    {
      "n": 6,
      "text": "肉片逐片抖散下锅，煮到变色立刻关火，连汤倒在蔬菜上。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "肉片一变色就停，多煮十秒就柴。",
      "visual_cue": "肉片舒展变白、边缘微卷"
    },
    {
      "n": 7,
      "text": "表面撒辣椒粉、花椒、干辣椒段与大蒜末，植物油烧到冒烟浇上激香。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油要够热，泼下去才有滋啦声。",
      "visual_cue": "红油浮起、蒜香辣香冲鼻"
    }
  ],
  "tips": [
    "肉片冷冻半小时再切，薄片更容易成型。",
    "垫底的黄豆芽换成油麦菜也很搭。",
    "花椒先用小火焙香再碾碎，麻味更足。"
  ],
  "common_mistakes": [
    "肉片顺纹切，煮出来韧得嚼不动。",
    "肉片没有上浆就直接下锅，煮出来又老又柴。",
    "辣椒粉直接下锅炒，一下就糊发苦。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "牛里脊",
      "ratio": "400g 对 400g",
      "note": "煮制时间缩短，变色即可。"
    },
    {
      "original": "莴苣",
      "substitute": "油麦菜",
      "ratio": "150g 对 150g",
      "note": "更易熟，焯水时间减半。"
    }
  ],
  "variations": [
    "加一把红薯宽粉垫底，吸汁更好吃。",
    "把清水换成熬好的骨汤，汤底会更醇厚顺口。"
  ],
  "serving_suggestion": "配一大碗白米饭，汤汁拌饭最香。",
  "storage": "冷藏可放一天，复热时补少量清水。",
