  "steps": [
    {
      "n": 1,
      "text": "腐竹用温水泡 2 小时至完全回软，中途翻动两次，泡到中心没有硬芯为止。",
      "time_min": 120,
      "heat": "无火",
      "tip": "必须用温水不用开水，开水会让外层烂、内部仍硬。",
      "visual_cue": "腐竹整根柔软、弯折有韧性"
    },
    {
      "n": 2,
      "text": "泡好的腐竹切 4cm 段，木耳撕成小朵洗净。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切口斜切更易吸汁，卖相也更好。",
      "visual_cue": "腐竹段长短一致、无硬块"
    },
    {
      "n": 3,
      "text": "锅中水烧开加 2g 盐，先下木耳煮 2 分钟，再下腐竹煮 1 分钟，捞出过凉水沥干。",
      "time_min": 4,
      "heat": "大火",
      "tip": "木耳耐煮、腐竹易烂，必须分开时间下锅。",
      "visual_cue": "腐竹发胀但不断裂、木耳卷曲"
    },
    {
      "n": 4,
      "text": "碗中把蒜末、生抽、香醋、白糖、盐、辣椒油与香油调匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "调料先调匀再拌，味道更均匀。",
      "visual_cue": "料汁红亮、蒜末均匀分布"
    },
    {
      "n": 5,
      "text": "腐竹与木耳倒入料汁中拌匀，撒葱花与香菜，静置 10 分钟入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拌好冷藏 10 分钟更爽口。",
      "visual_cue": "每根腐竹都裹上红油"
    }
  ],
  "tips": [
    "腐竹泡发时压一个盘子，保证全部浸在水中。",
    "喜麻可加 2g 花椒粉，做成麻辣口。",
    "拌好后 2 小时内食用，久放会出水变淡。"
  ],
  "common_mistakes": [
    "用开水泡腐竹，外层泡烂、中心仍是硬芯。",
    "腐竹与木耳同时下锅，腐竹煮散成糊。",
    "拌好立刻吃，味道只在表面，不够入味。"
  ],
  "substitutions": [
    {
      "original": "腐竹",
      "substitute": "豆腐皮",
      "ratio": "120g 干腐竹 ≈ 200g 豆腐皮",
      "note": "豆腐皮不用泡发，焯水 30 秒即可。"
    },
    {
      "original": "辣椒油",
      "substitute": "辣椒面加热油",
      "ratio": "25ml 辣椒油 ≈ 8g 辣椒面 + 25ml 热油",
      "note": "现泼的辣椒油更香。"
    }
  ],
  "variations": [
    "家庭简化版：用温水加 3g 小苏打泡腐竹，30 分钟即可回软。",
    "川味版：加 30g 熟花生碎与 10g 花椒油，麻辣更足。"
  ],
  "serving_suggestion": "作为凉菜拼盘或下酒小菜，配粥、面条都合适。",
  "storage": "冷藏 2 天，吃前补 5ml 辣椒油提香。",
