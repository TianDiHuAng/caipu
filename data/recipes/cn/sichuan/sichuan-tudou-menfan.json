  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍沥干，土豆去皮切成两厘米见方的滚刀块，放入清水中浸五分钟去掉表面淀粉。",
      "time_min": 7,
      "heat": "无火",
      "tip": "土豆先浸清水去淀粉，焖出的饭才不糊不粘连。",
      "visual_cue": "土豆块棱角分明，水略浑浊。"
    },
    {
      "n": 2,
      "text": "炒锅放猪油烧化，下腊肉丁小火煸出油，再加干辣椒节炒出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "腊肉煸到微焦最好，油脂香全逼出来。",
      "visual_cue": "腊肉丁微卷出油，辣椒节深红。"
    },
    {
      "n": 3,
      "text": "倒入土豆块中火煎到表面微黄，再放大米同炒，加生抽和盐翻匀。",
      "time_min": 5,
      "heat": "中火",
      "tip": "土豆先煎出一层焦壳，焖后才不散不糊。",
      "visual_cue": "土豆边缘金黄，米粒裹上酱色。"
    },
    {
      "n": 4,
      "text": "倒入电饭煲加清水铺平，按煮饭键焖到跳闸，再保温十分钟。",
      "time_min": 20,
      "heat": "中火",
      "tip": "土豆含淀粉，水量要比白饭少一成，否则发黏。",
      "visual_cue": "水面略低于米面，土豆露出少许。"
    },
    {
      "n": 5,
      "text": "开盖撒葱花，用饭勺轻轻翻拌，注意别把土豆块捣碎，盛碗上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻拌要轻手，土豆块保持完整才好吃。",
      "visual_cue": "饭粒松散，土豆块完整金黄。"
    }
  ],
  "tips": [
    "土豆先煎后焖，外焦里粉而且不会散块。",
    "水量比白饭少一成，避免饭粒发黏糊口。",
    "翻拌要轻手，土豆块完整才好吃好看。"
  ],
  "common_mistakes": [
    "土豆不泡水去淀粉，焖出的饭又黏又糊。",
    "水放太多，土豆化成泥把饭泡烂。",
    "腊肉不煸直接焖，油腻而且香味不足。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "300克:300克",
      "note": "红薯甜糯，生抽减到十毫升，焖制时间缩短三分钟。"
    },
    {
      "original": "腊肉",
      "substitute": "香肠",
      "ratio": "80克:80克",
      "note": "香肠偏甜，可省去白糖类调料，风味更家常。"
    }
  ],
  "variations": [
    "有的家庭加一把豌豆同焖，颜色和口感更丰富。",
    "川东做法会撒花椒粉和葱花，麻香配上土豆特别搭。"
  ],
  "serving_suggestion": "一锅端上桌，土豆粉糯、饭粒油润，配一碗青菜汤就很满足。",
  "storage": "冷藏可存两日，回锅加少量清水焖三分钟；土豆久放易返生，建议尽快吃完。",
