  "equipment": [
    "汤锅",
    "面碗",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大蒜捣成泥，加两勺清水泡成蒜水备用。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜水比蒜末更均匀，不呛口。，看准状态再往下做。",
      "visual_cue": "蒜水微白，蒜香散出"
    },
    {
      "n": 2,
      "text": "面碗里放辣椒油、花椒粉、生抽、香醋和猪油。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "调料先入碗，热汤一冲才香。，看准状态再往下做。",
      "visual_cue": "碗底红油发亮，这一点很关键。"
    },
    {
      "n": 3,
      "text": "加蒜水、芽菜和一半葱花，调料打底。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "芽菜带咸，后面的盐要少放。，看准状态再往下做。",
      "visual_cue": "碗中料层分明，这一点很关键。"
    },
    {
      "n": 4,
      "text": "汤锅烧大开，先舀一勺热汤冲进碗里化开。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "热汤冲料，红油和猪油才融。，看准状态再往下做。",
      "visual_cue": "汤面浮红油，香气冲出"
    },
    {
      "n": 5,
      "text": "下碱水面，用筷子轻轻拨散防粘。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "碱水面下锅就拨，粘一起就煮不透。，看准状态再往下做。",
      "visual_cue": "碱水面根根分明，这一点很关键。"
    },
    {
      "n": 6,
      "text": "煮两分钟后下油麦菜，一起烫三十秒。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "菜后放，烫软就好。，看准状态再往下做。",
      "visual_cue": "菜叶翠绿，碱水面转白"
    },
    {
      "n": 7,
      "text": "碱水面和油麦菜捞进碗里，浇上汤和调料。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "面别沥太干，带点汤才不坨。，看准状态再往下做。",
      "visual_cue": "碱水面浮面，汤汁红亮"
    },
    {
      "n": 8,
      "text": "撒剩下的葱花，趁热拌开吃。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌之前先喝一口汤，试试咸淡。，看准状态再往下做。",
      "visual_cue": "红油裹面，葱花点缀"
    }
  ],
  "tips": [
    "调料先放碗里用热汤冲，香气才出得来。",
    "碱水面煮两分钟足够，煮久就断。，这一点很关键。",
    "猪油是灵魂，别用植物油代替。，这一点很关键。"
  ],
  "common_mistakes": [
    "调料后放，拌开一股生酱油味。，这一点很关键。",
    "面煮过头，捞起来一夹就断。，这一点很关键。",
    "汤太多，变成一碗面汤泡面。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "碱水面",
      "substitute": "挂面",
      "ratio": "300 克:250 克",
      "note": "口感差些，煮的时间按包装。"
    },
    {
      "original": "猪油",
      "substitute": "香油",
      "ratio": "15 克:15 毫升",
      "note": "香气不同，更清爽。"
    }
  ],
  "variations": [
    "加一勺豌杂，做成豌杂面。，这一点很关键。",
    "放几片卤牛肉，升级成牛肉面。，这一点很关键。"
  ],
  "serving_suggestion": "早餐吃一碗，配一个煎蛋。，这一点很关键。",
  "storage": "现做现吃，冷藏后口感大减。，这一点很关键。",
