  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉洗净，用刀在厚处划两刀便于入味。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "划开厚处，煮的时候受热均匀。，看准状态再往下做。",
      "visual_cue": "肉面刀口浅而匀，这一点很关键。"
    },
    {
      "n": 2,
      "text": "冷水下锅，加姜片和料酒，中火煮开撇沫。，看准状态再往下做。",
      "time_min": 8,
      "heat": "中火",
      "tip": "冷水下锅，血水才逼得出来。，看准状态再往下做。",
      "visual_cue": "浮沫聚边，汤色转清"
    },
    {
      "n": 3,
      "text": "转小火煮十五分钟，关火焖十分钟。，看准状态再往下做。",
      "time_min": 26,
      "heat": "小火",
      "tip": "关火焖，肉才嫩且不带血。，看准状态再往下做。",
      "visual_cue": "筷子插入无血水，这一点很关键。"
    },
    {
      "n": 4,
      "text": "捞出放冰水里泡五分钟，让鸡皮收紧。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "冰水激一下，皮脆肉紧。，看准状态再往下做。",
      "visual_cue": "鸡皮发亮，肉质弹手"
    },
    {
      "n": 5,
      "text": "花椒放锅里小火焙香，用刀碾成粗末。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "花椒焙过才出麻香，别炒黑。，看准状态再往下做。",
      "visual_cue": "花椒出香，碎末油润"
    },
    {
      "n": 6,
      "text": "花椒末、葱花、盐、生抽、香醋和香油调成椒麻汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "先尝一口，麻味要压得住。，看准状态再往下做。",
      "visual_cue": "汁色清亮，麻香扑鼻"
    },
    {
      "n": 7,
      "text": "鸡肉切成半厘米厚的片，整齐码在盘里。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "逆着纹理切，口感才嫩。，看准状态再往下做。",
      "visual_cue": "片形完整，断面光滑"
    },
    {
      "n": 8,
      "text": "淋椒麻汁和辣椒油，撒葱花上桌。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "吃前再淋，鸡皮才不塌。，看准状态再往下做。",
      "visual_cue": "汁液铺底，红油浮面"
    }
  ],
  "tips": [
    "鸡肉煮后焖十分钟，肉熟透还不柴。",
    "冰水泡一下，鸡皮才紧实有弹性。，这一点很关键。",
    "花椒焙香再碾，麻味才干净不涩。，这一点很关键。"
  ],
  "common_mistakes": [
    "一直大火煮，鸡肉老得像柴。，这一点很关键。",
    "花椒直接生用，麻味发涩带土腥。，这一点很关键。",
    "切太早，肉还热就散成碎块。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "500 克:500 克",
      "note": "煮的时间减五分钟，容易柴。"
    },
    {
      "original": "辣椒油",
      "substitute": "花椒油",
      "ratio": "20 毫升:18 毫升",
      "note": "麻味更重，辣味变淡。"
    }
  ],
  "variations": [
    "加一勺芝麻酱，汁更浓稠。，这一点很关键。",
    "拌入黄瓜条，口感更清爽。，这一点很关键。"
  ],
  "serving_suggestion": "作为凉菜上桌，配米饭或下酒都行。",
  "storage": "冷藏一天，汁另装，吃前淋上。，这一点很关键。",
