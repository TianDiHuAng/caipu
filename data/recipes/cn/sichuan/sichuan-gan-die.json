  "equipment": [
    "炒锅",
    "石臼",
    "小碗",
    "筛网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干辣椒剪成短节，筛去大部分辣椒籽，留少量带籽的增香，籽多则辣得发燥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "辣椒籽要去掉大半，全留会辣得刺口还带苦。",
      "visual_cue": "辣椒节整齐，籽量约一成。"
    },
    {
      "n": 2,
      "text": "炒锅小火放入干辣椒节，不停翻炒到辣椒发脆、颜色转暗红、香气扑鼻。",
      "time_min": 4,
      "heat": "小火",
      "tip": "全程小火，辣椒一黑整碟都带焦苦味。",
      "visual_cue": "辣椒手捏即碎，暗红发脆。"
    },
    {
      "n": 3,
      "text": "花椒挑去黑籽与枝梗，用小火干焙三十秒出麻香，与辣椒一起摊凉。",
      "time_min": 3,
      "heat": "小火",
      "tip": "花椒很快出香，焙久了麻味变苦，要注意时间。",
      "visual_cue": "花椒壳脆，麻香清冽。"
    },
    {
      "n": 4,
      "text": "辣椒与花椒放进石臼舂成粗粒，别舂成细粉，粗粒才有咀嚼感和层次。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粗粒更香，全成粉的话蘸食时容易呛喉。",
      "visual_cue": "碎粒大小不一，红褐相间。"
    },
    {
      "n": 5,
      "text": "花生炸香去皮后用刀背压成碎粒，与辣椒花椒碎混合，加盐和味精拌匀装碟。",
      "time_min": 3,
      "heat": "无火",
      "tip": "花生碎最后拌入，早拌会被辣椒的味道盖住。",
      "visual_cue": "干碟红褐带黄，颗粒分明。"
    }
  ],
  "tips": [
    "二荆条增香、子弹头增辣，七三比例最适口。",
    "干碟要现舂现用，放久了香气散尽只剩辣。",
    "加一小撮熟白芝麻或花生碎，香味更足更有嚼头。"
  ],
  "common_mistakes": [
    "辣椒焙过头发黑，整碟带焦苦味，蘸什么都是苦的。",
    "舂得太细成粉，蘸食时容易呛到喉咙。",
    "盐放太多，蘸一次就咸得盖住食材本味。"
  ],
  "substitutions": [
    {
      "original": "花生",
      "substitute": "白芝麻",
      "ratio": "50克:25克",
      "note": "换成炒香白芝麻，颗粒更细，香气也清一些。"
    },
    {
      "original": "干辣椒",
      "substitute": "花椒",
      "ratio": "60克:20克",
      "note": "减辣可提高花椒比例，做成偏麻的干碟。"
    }
  ],
  "variations": [
    "贵州蘸水会在干碟里加折耳根碎与木姜子油，风味更野。",
    "西昌火盆烧烤的干碟会加黄豆粉与花生碎，香气更厚。"
  ],
  "serving_suggestion": "配烤肉、烤豆腐或白水煮肉，肉片先蘸干碟再蘸油碟，干香与油润并存。",
  "storage": "密封干燥保存可存两周，避免受潮结块；出现霉点立即丢弃。",
