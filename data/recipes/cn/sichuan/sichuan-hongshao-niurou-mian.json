  "equipment": [
    "汤锅",
    "炒锅",
    "汤勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩块冷水浸泡半小时去血水，再冷水下锅加料酒焯透捞出。",
      "time_min": 35,
      "heat": "中火",
      "tip": "冷水下锅血沫才出得净，热水一烫就锁住了。",
      "visual_cue": "水面浮起厚厚灰白沫，肉块紧缩"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下豆瓣酱小火炒出红油，加姜片与干辣椒炒香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "豆瓣酱必须小火慢炒，火大使酱发苦整锅报废。",
      "visual_cue": "油色转红亮，香味冲鼻不呛"
    },
    {
      "n": 3,
      "text": "下牛腩块大火翻炒上色，淋料酒、生抽、老抽炒到酱色均匀。",
      "time_min": 6,
      "heat": "大火",
      "tip": "肉块炒到表面收紧再加水，炖出来才不散。",
      "visual_cue": "肉块表面焦香，颜色深红发亮"
    },
    {
      "n": 4,
      "text": "加足量热水没过肉块，放八角、桂皮、香叶、花椒、冰糖与葱结。",
      "time_min": 6,
      "heat": "大火",
      "tip": "一定加热水，冷水会让肉纤维瞬间紧缩变柴。",
      "visual_cue": "汤色棕红，香料浮在汤面"
    },
    {
      "n": 5,
      "text": "转小火加盖炖一百分半钟，炖到牛腩用筷子轻松戳透。",
      "time_min": 95,
      "heat": "小火",
      "tip": "全程只冒小泡，滚太猛汤会浑、肉会缩。",
      "visual_cue": "筷子插入即过，汤面浮一层红油"
    },
    {
      "n": 6,
      "text": "另起锅煮面，面条将熟时下小白菜烫三十秒，捞入碗中浇牛腩原汤，尝咸淡补盐撒葱末。",
      "time_min": 6,
      "heat": "大火",
      "tip": "面煮到八分熟就捞，泡在热汤里还会继续软。",
      "visual_cue": "面条透亮有弹性，菜叶翠绿"
    }
  ],
  "tips": [
    "炖好的牛腩汤可一次多做些，冷藏后撇掉浮油，分袋冷冻当备用汤底。",
    "加一小块陈皮同炖，牛腩更容易软，汤也不油腻。",
    "面碗先用热水烫一遍再盛面，端上桌不凉得快。"
  ],
  "common_mistakes": [
    "牛腩不焯水直接炖，汤浑得发黑还带腥味。",
    "中途加冷水，牛腩纤维一紧，炖两小时还是咬不动。",
    "面条煮到全熟才捞，等端上桌已经糊成一团。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "牛腱",
      "ratio": "500克:500克",
      "note": "牛腱更紧实，炖的时间延长二十分钟。"
    },
    {
      "original": "面条",
      "substitute": "米粉",
      "ratio": "300克:300克",
      "note": "米粉只需烫三十秒，别久煮。"
    }
  ],
  "variations": [
    "加几块白萝卜同炖，吸饱肉汤后清甜解腻。",
    "起锅前加一勺醋和辣椒油，酸辣开胃，是川东一带的吃法。"
  ],
  "serving_suggestion": "热汤宽面盛大碗，撒葱末与香菜，配一碟泡菜同食最地道。",
  "storage": "牛肉汤冷藏可存三天、冷冻可存一个月；面条须现煮现吃不宜存放。",
