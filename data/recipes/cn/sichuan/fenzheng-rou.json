    "蒸碗",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉洗净擦干，切成 0.5cm 厚的宽片，肥瘦相连不要切断。",
      "time_min": 10,
      "heat": "无火",
      "tip": "肉片别切太薄，蒸过之后容易发柴。",
      "visual_cue": "肉片厚薄均匀、肥瘦相连"
    },
    {
      "n": 2,
      "text": "肉片加姜末、料酒、生抽、豆瓣酱与盐抓匀，腌 15 分钟入味。",
      "time_min": 15,
      "heat": "无火",
      "tip": "抓拌到酱汁吸干，味道才进得去。",
      "visual_cue": "肉片吸匀酱汁、颜色变深"
    },
    {
      "n": 3,
      "text": "蒸肉米粉与花椒碎拌匀，把腌好的肉片逐片裹上一层干粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉裹薄薄一层，太厚蒸后发干。",
      "visual_cue": "每片肉挂满干粉、不见湿面"
    },
    {
      "n": 4,
      "text": "土豆去皮切滚刀块铺在蒸碗底部，肉片一片压一片码在上面。",
      "time_min": 6,
      "heat": "无火",
      "tip": "土豆垫底吸油，比肉还好吃。",
      "visual_cue": "肉片整齐码放、土豆垫在碗底"
    },
    {
      "n": 5,
      "text": "蒸锅水烧开，大火蒸 45 分钟至肉片软糯，关火再焖 5 分钟，出锅撒小葱。",
      "time_min": 50,
      "heat": "大火",
      "tip": "中途不揭盖，蒸汽足了肉才糯。",
      "visual_cue": "肉片透亮、筷子能轻松插入"
    }
  ],
  "tips": [
    "肉片切到 0.5cm 厚，蒸后软糯不柴。",
    "米粉裹薄薄一层就够，厚了口感发干。",
    "出锅前撒一把小葱，香气更清爽解腻。"
  ],
  "common_mistakes": [
    "肉片切得太薄，蒸完缩成硬邦邦一片。",
    "米粉裹得过厚，成品发干没有油润感。",
    "冷水上锅慢蒸，肉片久蒸不烂还出水。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "排骨",
      "ratio": "600g 对 700g",
      "note": "排骨需多蒸 15 分钟。"
    },
    {
      "original": "蒸肉米粉",
      "substitute": "大米炒香磨粉",
      "ratio": "100g 对 100g",
      "note": "自磨粉颗粒粗，更松散。"
    }
  ],
  "variations": [
    "加南瓜版：土豆换南瓜 300g，甜糯解腻。",
    "麻辣版：另加 5g 辣椒面与米粉同拌。"
  ],
  "serving_suggestion": "连碗上桌，配米饭吃，碗底的土豆最受欢迎。",
  "storage": "冷藏 2 天，复蒸 15 分钟回软，风味几乎不变。",
