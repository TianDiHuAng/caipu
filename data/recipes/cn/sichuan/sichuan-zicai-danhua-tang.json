  "equipment": [
    "汤锅",
    "汤勺",
    "汤碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干紫菜撕成小片放在碗里，用清水快速冲一遍洗去浮沙后沥干。",
      "time_min": 3,
      "heat": "无火",
      "tip": "紫菜只冲不泡，泡久了鲜味全跑进水里。",
      "visual_cue": "紫菜舒展、水色不浑"
    },
    {
      "n": 2,
      "text": "三枚鸡蛋打散，加一小勺清水搅匀，蛋液更细更嫩。",
      "time_min": 2,
      "heat": "无火",
      "tip": "加清水能稀释蛋白，蛋花才薄如云片。",
      "visual_cue": "蛋液均匀、表面无大气泡"
    },
    {
      "n": 3,
      "text": "汤锅加清水大火烧开，放入盐和生抽搅匀定好底味。",
      "time_min": 4,
      "heat": "大火",
      "tip": "汤先调好咸淡，后面下蛋花才不易碎。",
      "visual_cue": "汤面翻滚、咸味适中"
    },
    {
      "n": 4,
      "text": "转小火，一手缓缓淋入蛋液，一手用汤勺顺着一个方向轻推。",
      "time_min": 2,
      "heat": "小火",
      "tip": "小火慢淋，蛋液才成絮状而不浑浊。",
      "visual_cue": "蛋花成片浮起、汤色清亮"
    },
    {
      "n": 5,
      "text": "放入紫菜再煮一分钟，撒入白胡椒粉搅匀后尝味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "紫菜久煮发黏，一分钟足够出鲜味。",
      "visual_cue": "紫菜舒展、汤色微绿"
    },
    {
      "n": 6,
      "text": "关火后淋上香油、撒上葱花，盛入汤碗趁热喝最鲜。",
      "time_min": 1,
      "heat": "无火",
      "tip": "香油最后放，久煮会散掉香气。",
      "visual_cue": "汤面浮油花、葱花翠绿"
    }
  ],
  "tips": [
    "紫菜本身带咸味，加盐前先尝一口汤。",
    "蛋液里加清水或少许淀粉，蛋花更嫩滑。",
    "白胡椒粉是川式做法里的关键，别省。"
  ],
  "common_mistakes": [
    "水大滚时倒蛋液，蛋花冲成碎渣、汤变浑。",
    "紫菜一开始就下锅久煮，成品发黏带腥。",
    "盐放多了，紫菜的咸味全被压住。"
  ],
  "substitutions": [
    {
      "original": "紫菜",
      "substitute": "裙带菜",
      "ratio": "8g 对 10g",
      "note": "裙带菜更厚，需多煮一分钟。"
    },
    {
      "original": "香油",
      "substitute": "葱油",
      "ratio": "5ml 对 5ml",
      "note": "葱香更突出，葱花可减半。"
    }
  ],
  "variations": [
    "加一小把虾滑或肉末同煮，做成荤版蛋花汤。",
    "加几滴香醋，做成微酸开胃的酸汤蛋花。"
  ],
  "serving_suggestion": "配米饭和一道炒菜，是川渝家庭最常见的收尾汤。",
  "storage": "当天喝完，冷藏不超过一天，复热需重新煮沸。",
