  "equipment": [
    "小碗",
    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆瓣酱放砧板上剁成细茸，剁到看不见豆瓣颗粒，炒时才不硌口也不易糊。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆瓣剁细是鱼香汁红亮的前提，粗粒下锅容易焦。",
      "visual_cue": "豆瓣成均匀细茸，色深红。"
    },
    {
      "n": 2,
      "text": "小碗里放香醋、白糖、生抽、料酒、盐、玉米淀粉和清水，搅到无干粉颗粒。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖醋一比一略偏甜才合川味，淀粉先化开避免结块。",
      "visual_cue": "碗汁均匀，底部无沉淀。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到五成热，下豆瓣茸小火慢炒到出红油、香气浓郁。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆瓣一定要炒出红油，火大了发苦，火小了只有生豆瓣味。",
      "visual_cue": "油色转红亮，豆瓣酥香。"
    },
    {
      "n": 4,
      "text": "下姜末炒香，倒入调好的碗汁，中火加热并不断搅动，让淀粉均匀糊化。",
      "time_min": 3,
      "heat": "中火",
      "tip": "边倒边搅，芡才不会结块，汁体也顺滑有光泽。",
      "visual_cue": "汁体由稀转稠，冒小泡。"
    },
    {
      "n": 5,
      "text": "汁浓稠挂勺时撒葱花，翻两下立即离火，趁热浇在炸好的食材上。",
      "time_min": 2,
      "heat": "小火",
      "tip": "葱花最后下，久煮发黄失香，颜色也不好看。",
      "visual_cue": "汁红亮浓稠，葱花翠绿。"
    }
  ],
  "tips": [
    "糖醋比例一比一，略多一点糖更接近传统川味。",
    "豆瓣要选陈年郫县豆瓣，颜色红亮、酱香厚。",
    "碗汁提前调好，下锅一气呵成，火候才不慌。"
  ],
  "common_mistakes": [
    "豆瓣不剁细直接下锅，颗粒焦苦，汁也不亮。",
    "淀粉直接撒进锅里，结成一团团白疙瘩。",
    "葱花早下锅一起煮，成品发黄，葱香尽失。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋酸味直接，用量减五毫升，糖相应减三克。"
    },
    {
      "original": "豆瓣酱",
      "substitute": "蚝油",
      "ratio": "40克:30毫升",
      "note": "不吃辣可改用蚝油加少许老抽，成菜为咸鲜芡汁，非鱼香味。"
    }
  ],
  "variations": [
    "鱼香汁浇在炸茄盒上即鱼香茄盒，浇在肉丝上即鱼香肉丝。",
    "有的做法加少许泡椒末同炒，酸辣更立体。"
  ],
  "serving_suggestion": "趁热浇在刚炸好的茄盒、肉丝或豆腐上；配白饭，汁多可拌饭。",
  "storage": "现调现用最佳，冷藏可存两日；复热需加少量清水小火化开，避免糊底。",
