    "碗",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉 400g 整块冷水下锅，放入姜 15g、葱 30g 与 20ml 料酒。",
      "time_min": 5,
      "heat": "大火",
      "tip": "冷水下锅，血水才会慢慢逼出来。",
      "visual_cue": "水面浮起灰白浮沫"
    },
    {
      "n": 2,
      "text": "水开后撇净浮沫，转小火煮 34 分钟，至筷子能轻松插透肉皮。",
      "time_min": 34,
      "heat": "小火",
      "tip": "全程小火，大火会把肉煮柴。",
      "visual_cue": "肉皮透亮、筷子一插到底"
    },
    {
      "n": 3,
      "text": "捞出肉块放凉，用保鲜膜紧紧卷起，冷藏 15 分钟定型。",
      "time_min": 15,
      "heat": "无火",
      "tip": "卷紧再冷藏，切出的片才薄而完整。",
      "visual_cue": "肉卷紧实、形状规整"
    },
    {
      "n": 4,
      "text": "拆开保鲜膜，把肉切成 2 毫米厚的薄片，整齐码在盘中。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刀要锋利，肉片薄到透光才好入口。",
      "visual_cue": "肉片薄透、边缘完整"
    },
    {
      "n": 5,
      "text": "蒜 40g 拍碎捣成蒜泥，加 30ml 生抽、10ml 香醋、6g 白糖、30ml 辣椒油、2g 花椒粉与 10ml 香油搅匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "蒜泥现捣现用，久放会发苦。",
      "visual_cue": "蒜泥汁红亮、蒜香冲鼻"
    },
    {
      "n": 6,
      "text": "把蒜泥汁均匀浇在肉片上，静置 3 分钟让味道渗进肉里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "浇汁后等几分钟，比立刻吃入味得多。",
      "visual_cue": "肉片浸润红油、盘中见汁"
    }
  ],
  "tips": [
    "肉煮好后冷藏定型，才能切出薄如纸的片。",
    "蒜泥要捣不要切，捣出的蒜汁才够浓。",
    "辣椒油选带辣椒面的，红油挂肉更好看。"
  ],
  "common_mistakes": [
    "肉大火煮到底，切片就散还发柴。",
    "热肉直接切片，片厚且参差不齐还散。",
    "蒜泥切成了蒜粒，味道辛辣不融合。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪后腿肉",
      "ratio": "400g 对 400g",
      "note": "肥肉少，口感偏紧实，需多煮 5 分钟。"
    },
    {
      "original": "辣椒油",
      "substitute": "辣椒粉",
      "ratio": "30ml 对 8g",
      "note": "需用热油泼香后再拌。"
    }
  ],
  "variations": [
    "垫一层 100g 黄瓜片，清爽解腻。",
    "加 5g 熟白芝麻同拌，香气更立体。"
  ],
  "serving_suggestion": "肉片配黄瓜片卷起吃，配冰啤酒最合适。",
  "storage": "肉片冷藏可存 2 天，蒜泥汁现调现用，隔夜蒜味发苦。",
