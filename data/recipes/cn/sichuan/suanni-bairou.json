  "equipment": [
    "汤锅",
    "温度计",
    "片肉刀",
    "冰水盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加姜片、花椒、料酒与盐 2g，大火烧开后撇净浮沫。",
      "time_min": 5,
      "heat": "大火",
      "tip": "冷水下锅能让血水慢慢析出，肉腥味更少。",
      "visual_cue": "水面浮起灰白浮沫，撇净后汤色转清"
    },
    {
      "n": 2,
      "text": "转小火保持水面微沸煮 25 分钟，用温度计确认肉块中心达到 72℃ 以上。",
      "time_min": 25,
      "heat": "小火",
      "tip": "全程小火，大滚会让肉质变柴、肥肉散开。",
      "visual_cue": "竹签能轻松插入且无血水渗出"
    },
    {
      "n": 3,
      "text": "捞出肉块放入冰水浸泡 10 分钟，肉皮收紧后切成 1.5mm 薄片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冰镇后肉片更挺括好切，切面也更整齐。",
      "visual_cue": "肉片边缘紧实，肥瘦界线分明不散"
    },
    {
      "n": 4,
      "text": "蒜泥加生抽、白糖、香醋、辣椒油与余下的盐调成料汁，静置 5 分钟让蒜味渗出。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜泥要现捣，久放会发苦发绿。",
      "visual_cue": "料汁红亮，蒜香扑鼻"
    },
    {
      "n": 5,
      "text": "黄瓜片铺盘底，肉片呈扇形叠放，淋料汁后撒葱花与熟芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "肉片之间留缝，料汁才能渗进每一片。",
      "visual_cue": "料汁沿肉片缝隙渗入，盘底聚成红色汁水"
    }
  ],
  "tips": [
    "肉块煮好后压重物冷藏 20 分钟，切出的片更薄更均匀。",
    "蒜泥与辣椒油的比例可按吃辣程度调整，减油时补 5ml 生抽。",
    "剩下煮肉的原汤可加白菜煮汤，不浪费。"
  ],
  "common_mistakes": [
    "肉煮好后趁热切，肥瘦分离、片形散乱。",
    "蒜泥用刀剁而非捣，蒜香不足且出水多。",
    "料汁一次浇太多，肉片泡在汁里变咸。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "后腿肉",
      "ratio": "1:1",
      "note": "后腿肉瘦一些，煮制时间缩短到 20 分钟。"
    },
    {
      "original": "辣椒油",
      "substitute": "花椒油加辣椒粉",
      "ratio": "40ml 辣椒油 ≈ 30ml 花椒油 + 8g 辣椒粉",
      "note": "麻味更突出。"
    }
  ],
  "variations": [
    "家庭简化版：用现成蒜泥白肉调料包，蒜泥另加一勺现捣蒜，香气更足。",
    "卷饼版：肉片卷黄瓜条，蘸料汁吃，适合夏天。"
  ],
  "serving_suggestion": "冷盘上桌，配米饭或面食；宴客时可与口水鸡组成双拼冷盘。",
  "storage": "肉块冷藏 2 天，料汁单独存放；肉片不建议冷冻，解冻后会出水。",
