      "group": "main",
      "items": [
        {
          "name": "鸡胸肉",
          "name_en": "chicken breast",
          "amount": 300,
          "unit": "g",
          "note": "去筋剁茸",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 4,
          "unit": "piece",
          "note": "只取蛋清",
          "optional": false
        }
      ]
    },
    {
