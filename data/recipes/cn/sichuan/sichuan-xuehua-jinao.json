      "items": [
        {
          "name": "猪油",
          "name_en": "lard",
          "amount": 60,
          "unit": "g",
          "note": "炒制用",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 30,
          "unit": "g",
          "note": "调浆",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 120,
          "unit": "ml",
          "note": "调浆",
          "optional": false
        },
        {
          "name": "火腿",
          "name_en": "ham",
          "amount": 30,
          "unit": "g",
          "note": "切末点缀",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "打蛋器",
    "滤网",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉剔净筋膜，切成小块后放进清水泡十分钟去血水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "筋膜不剔净，鸡茸打不细，成品发粗。",
      "visual_cue": "鸡肉泛白发亮，水微微带红"
    },
    {
      "n": 2,
      "text": "捞出挤干水分，用刀背反复捶成细泥，再剁两遍。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刀背捶比直接剁更细，口感更滑。",
      "visual_cue": "肉泥细腻，用手指捻无颗粒"
    },
    {
      "n": 3,
      "text": "蛋清打进无油无水的碗里，用打蛋器打到起细密白泡。",
      "time_min": 6,
      "heat": "无火",
      "tip": "打到插筷子能立住，膨发才够。",
      "visual_cue": "蛋白霜白亮，提起有小尖角"
    },
    {
      "n": 4,
      "text": "鸡泥加清水与淀粉调成稀糊，用滤网过一遍。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛去掉残渣，成品才雪白细腻。",
      "visual_cue": "糊体顺滑，滤网上几乎无渣"
    },
    {
      "n": 5,
      "text": "分三次把蛋白霜拌进鸡糊，用刮刀从底往上翻。",
      "time_min": 6,
      "heat": "无火",
      "tip": "别画圈搅，蛋白消泡就不蓬了。",
      "visual_cue": "糊体轻盈，体积明显变大"
    },
    {
      "n": 6,
      "text": "炒锅烧热后下猪油，等油化开立刻转成小火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "猪油不能冒烟，温度高了立刻结块。",
      "visual_cue": "油面平静，微微泛起波纹"
    },
    {
      "n": 7,
      "text": "倒入鸡糊，用汤勺贴锅底慢慢推炒，不要翻搅。",
      "time_min": 4,
      "heat": "小火",
      "tip": "推炒成云朵状，越推越白。",
      "visual_cue": "糊体凝成雪白絮块"
    },
    {
      "n": 8,
      "text": "炒到鸡糊全部凝固成雪花状，撒盐后轻轻推匀。",
      "time_min": 2,
      "heat": "小火",
      "tip": "盐后放，早放会出水变老。",
      "visual_cue": "成品雪白蓬松，块块分明"
    },
    {
      "n": 9,
      "text": "盛盘后撒上切碎的火腿末，趁着热气端上桌享用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "火腿末只作点缀，撒多了抢味。",
      "visual_cue": "白雪般的鸡淖上点点红末"
    }
  ],
  "tips": [
    "鸡胸肉一定捶成茸再过筛，成品才细到入口即化。",
    "蛋白霜分次拌入，手法要轻，画圈搅会消泡成蛋饼。",
    "全程小火推炒，油温一高就结块发硬。"
  ],
  "common_mistakes": [
    "鸡糊调得太稠，下锅抱成一团，炒不散。",
    "油温过高下锅，鸡糊瞬间结块，颜色发黄。",
    "用大火快炒，蛋白消泡，成品塌成一摊。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "花生油",
      "ratio": "60 克:55 克",
      "note": "香气略薄，可加少许鸡油提味。"
    },
    {
      "original": "火腿",
      "substitute": "熟火腿",
      "ratio": "30 克:30 克",
      "note": "咸味更突出，盐要减一克。"
    }
  ],
  "variations": [
    "鸡糊里加两勺鲜奶，奶香更浓，颜色更白。",
    "拌入少许蟹黄同炒，就是升级版的雪花蟹斗。"
  ],
  "serving_suggestion": "盛在白瓷盘里，配一小碗米饭，清淡中见功夫。",
  "storage": "现炒现吃，不建议存放，回锅即散，口感全失。",
