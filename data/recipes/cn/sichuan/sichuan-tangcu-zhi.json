  "equipment": [
    "小碗",
    "小锅",
    "锅铲",
    "量杯"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小碗里放白糖、香醋、生抽、盐和清水，搅到糖盐完全溶化，尝味调整酸甜。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖醋比例约一比零点八，甜略突出才符合川式糖醋。",
      "visual_cue": "汁液清亮，尝起来酸甜均衡。"
    },
    {
      "n": 2,
      "text": "玉米淀粉加两勺冷水化开成水淀粉，静置备用，不要直接倒干粉进锅。",
      "time_min": 2,
      "heat": "无火",
      "tip": "水淀粉要现调现用，放久会沉底结块。",
      "visual_cue": "淀粉完全化开，无颗粒。"
    },
    {
      "n": 3,
      "text": "小锅放少量植物油，倒入调好的糖醋汁，中火烧到微微沸腾。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汁烧开再勾芡，酸味才稳定，芡也挂得住。",
      "visual_cue": "汁面冒小泡，蒸汽带酸甜香。"
    },
    {
      "n": 4,
      "text": "把水淀粉缓缓淋入，边淋边搅，让汁体慢慢变稠发亮，出现鱼眼泡即停。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "芡不要一次淋完，稠度到挂勺就停，过了会成糊。",
      "visual_cue": "汁体透亮挂勺，缓慢流下。"
    },
    {
      "n": 5,
      "text": "淋入少许植物油推匀增加光泽，撒葱花，趁热浇在炸好的食材上。",
      "time_min": 2,
      "heat": "小火",
      "tip": "最后淋油让汁面更亮，也让口感更润不粘牙。",
      "visual_cue": "汁面泛光，葱花翠绿。"
    }
  ],
  "tips": [
    "糖醋汁要甜中带酸，尝着偏甜才对，酸味会在勾芡后变突出。",
    "用香醋风味最正，白醋只剩尖酸，缺少醇厚。",
    "勾芡用水淀粉而非干粉，汁体才透亮不结块。"
  ],
  "common_mistakes": [
    "糖没化开就勾芡，成品带沙粒感，甜味不均。",
    "淀粉直接倒入热汁，立刻结成白疙瘩。",
    "汁煮太久，醋酸挥发，只剩甜味发腻。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋酸味更尖，用量减十毫升，另加五克白糖平衡。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "60克:65克",
      "note": "冰糖需先加水煮化，甜味更清，成品亮度也更好。"
    }
  ],
  "variations": [
    "川式糖醋偏酸甜平衡，粤式咕噜汁则加番茄酱与山楂，颜色更红。",
    "有的做法加少许蒜末同煮，香气更立体。"
  ],
  "serving_suggestion": "浇在糖醋里脊、糖醋排骨或炸藕盒上，趁热吃芡汁才亮；也可作春卷蘸汁。",
  "storage": "冷藏可存三日，复热加少量清水小火化开；芡汁久放会析水，搅匀再用。",
