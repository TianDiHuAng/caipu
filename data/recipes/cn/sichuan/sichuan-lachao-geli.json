  "steps": [
    {
      "n": 1,
      "text": "蛤蜊放淡盐水里滴几滴植物油静置两小时吐沙，中途换两次水，最后逐个搓洗外壳。",
      "time_min": 15,
      "heat": "无火",
      "tip": "滴油能让蛤蜊加速吐沙，换水两次才干净。",
      "visual_cue": "盆底沉沙明显，蛤蜊壳光亮。"
    },
    {
      "n": 2,
      "text": "干辣椒剪段去籽，大蒜切片，姜切丝，小葱切段，豆瓣酱剁细备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "干辣椒去籽辣度更稳，剪段才能炒出香气。",
      "visual_cue": "配料分堆摆放，辣椒段红亮。"
    },
    {
      "n": 3,
      "text": "炒锅烧热放六十毫升植物油，下花椒和干辣椒小火炸香，再加豆瓣酱炒出红油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "花椒和干辣椒必须小火炸，一糊整锅都发苦。",
      "visual_cue": "锅中红油翻砂，麻辣香窜出。"
    },
    {
      "n": 4,
      "text": "下姜丝蒜片炒香，倒入沥干的蛤蜊大火翻炒，沿锅边淋料酒去腥。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蛤蜊下锅前一定沥干，带水入锅炒不出香。",
      "visual_cue": "蛤蜊在锅中翻动，壳面沾满红油。"
    },
    {
      "n": 5,
      "text": "加生抽和白糖翻匀，盖盖焖两分钟到蛤蜊全部开口，撒小葱段翻匀出锅，未开口的挑出丢掉。",
      "time_min": 3,
      "heat": "中火",
      "tip": "不开口的死蛤蜊千万别吃，可能有泥沙和异味。",
      "visual_cue": "蛤蜊壳全开，盘底留一层红汤。"
    }
  ],
  "tips": [
    "淡盐水滴油吐沙，蛤蜊才不发碜。",
    "蛤蜊沥干再下锅，炒香不出一锅水。",
    "不开口的蛤蜊一律丢掉，别舍不得。",
    "焖两分钟即开口，久煮蛤蜊肉会缩硬。"
  ],
  "common_mistakes": [
    "吐沙时间不足，吃起来满口泥沙。",
    "大火猛炒太久，蛤蜊肉缩成硬粒。",
    "不看开口情况就上桌，死蛤混进盘里。",
    "蛤蜊带水下锅，炒出一锅水全无香气。"
  ],
  "substitutions": [
    {
      "original": "蛤蜊",
      "substitute": "花蛤",
      "ratio": "750克:750克",
      "note": "花蛤个小肉嫩，焖制时间缩短到一分半，更易开口。"
    },
    {
      "original": "豆瓣酱",
      "substitute": "泡椒",
      "ratio": "20克:40克",
      "note": "泡椒版酸辣更清爽，需补三克白糖平衡。"
    }
  ],
  "variations": [
    "有的做法加一把九层塔或紫苏同炒，香气独特。",
    "沿海家庭会加一勺啤酒代水焖，鲜味更足。"
  ],
  "serving_suggestion": "大盘上桌趁热吃，壳里那口汤汁最鲜，配冰啤或白粥都合适。",
  "storage": "冷藏可存一日，复热需小火加盖焖两分钟至热透；贝类隔夜风味下降明显，建议当餐吃完。",
