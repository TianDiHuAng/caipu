  "equipment": [
    "蒸锅",
    "打蛋碗",
    "细筛",
    "小碗",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "榨菜用清水冲一遍去掉表面盐分，挤干后切成细末，小葱切成葱花备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "榨菜先冲再切，咸度才好控制，切得越细分布越匀。",
      "visual_cue": "榨菜末细碎均匀，尝之咸淡适中。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，加盐、白胡椒粉和清水搅匀，用细筛过滤两遍去掉浮沫。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过滤能让蛋羹表面光滑，蒸出来像镜面一样。",
      "visual_cue": "蛋液浅黄澄澈，无泡沫与絮状物。"
    },
    {
      "n": 3,
      "text": "蛋液里拌入一半榨菜末，倒入浅口碗中，盖保鲜膜扎小孔，水开后中小火蒸十分钟。",
      "time_min": 11,
      "heat": "中小火",
      "tip": "榨菜末留一半最后撒，蒸过的香、后撒的脆。",
      "visual_cue": "蛋面平整，榨菜末均匀悬浮。"
    },
    {
      "n": 4,
      "text": "取出揭膜，把剩下的榨菜末和葱花撒在蛋面，淋生抽和香油即成。",
      "time_min": 2,
      "heat": "无火",
      "tip": "后撒的榨菜末带来脆感，是这道蛋羹最妙的一口。",
      "visual_cue": "蛋面点缀翠绿葱花与浅褐榨菜末。"
    }
  ],
  "tips": [
    "榨菜选清淡口，咸味重的一定要冲洗。",
    "蛋液过滤两遍，蒸出的蛋羹才无孔。",
    "中小火蒸制，火大表面必起蜂窝。"
  ],
  "common_mistakes": [
    "榨菜没冲洗就下锅，蛋羹咸得发苦。",
    "大火猛蒸，蛋面粗糙像一块海绵。",
    "不盖保鲜膜，水汽滴落砸出许多坑洞。"
  ],
  "substitutions": [
    {
      "original": "榨菜",
      "substitute": "冬菜",
      "ratio": "40克:35克",
      "note": "冬菜咸香更沉，需多冲一遍水，用量略减。"
    },
    {
      "original": "清水",
      "substitute": "鸡汤",
      "ratio": "270毫升:260毫升",
      "note": "用鸡汤鲜味更足，盐可完全省略。"
    }
  ],
  "variations": [
    "有人把榨菜换成芽菜末，川味更地道、香气更浓。",
    "加几滴辣椒油在表面，咸鲜里多一层辣香。"
  ],
  "serving_suggestion": "趁热用小勺挖着吃，配白粥或作为早餐主食都很合适。",
  "storage": "冷藏可存一日，回蒸三分钟恢复嫩滑；蛋羹冷冻后必出水，不建议冷冻。",
