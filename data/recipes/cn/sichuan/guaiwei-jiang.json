  "equipment": [
    "碗",
    "小锅",
    "勺子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "辣椒粉 8g 与花椒粉 3g 放碗中混匀，20ml 植物油烧至六成热后泼入并快速搅匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温六成热刚好，冒烟就糊了。",
      "visual_cue": "红油色泽透亮、香气冲鼻"
    },
    {
      "n": 2,
      "text": "芝麻酱 120g 加 30ml 温水，顺一个方向慢慢澥开至顺滑流动。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水要一点点加，一次倒多会结块。",
      "visual_cue": "酱体细腻、能顺勺流下"
    },
    {
      "n": 3,
      "text": "加 40ml 生抽、20ml 香醋、15g 白糖与 1g 味精，搅到糖完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖不化开，酱里会有颗粒感。",
      "visual_cue": "酱汁均匀、无糖粒"
    },
    {
      "n": 4,
      "text": "倒入泼好的红油与 10g 蒜末，充分搅拌至颜色红亮。",
      "time_min": 2,
      "heat": "无火",
      "tip": "红油连辣椒渣一起倒，香味才足。",
      "visual_cue": "酱色红亮、蒜末分布均匀"
    },
    {
      "n": 5,
      "text": "淋入 20ml 香油，撒 10g 白芝麻，静置 10 分钟让味道融合。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置后麻、辣、甜、酸才咬得整齐。",
      "visual_cue": "表面浮油光亮、芝麻沉底"
    }
  ],
  "tips": [
    "芝麻酱必须用温水澥，冷水澥不开还发涩。",
    "泼辣椒粉的油温控制在六成，太热会苦。",
    "静置十分钟再吃，各种味道才融在一起。"
  ],
  "common_mistakes": [
    "芝麻酱一次加水太多，搅成一坨疙瘩。",
    "油烧到冒青烟才泼，辣椒粉直接焦苦。",
    "醋和糖比例失衡，只剩一股酸味。"
  ],
  "substitutions": [
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "120g 对 120g",
      "note": "香味更浓，甜度略高，白糖减 3g。"
    },
    {
      "original": "香醋",
      "substitute": "陈醋",
      "ratio": "20ml 对 18ml",
      "note": "酸味更重，可加 2g 白糖平衡。"
    }
  ],
  "variations": [
    "加 10g 郫县豆瓣酱剁细同拌，酱体更厚重。",
    "加 5g 芥末油，做出冲鼻的怪味层次。"
  ],
  "serving_suggestion": "拌白肉、拌凉面、蘸白切鸡都合适，冷藏后风味更融合。",
  "storage": "密封冷藏可存 7 天，取用请用干净干勺，避免进水变质。",
