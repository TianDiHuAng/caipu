          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "玻璃罐",
    "漏勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡爪剪去爪尖指甲，从中间劈开成两半，冲洗干净。",
      "time_min": 12,
      "heat": "无火",
      "tip": "指甲不剪，泡出来发黑带腥。",
      "visual_cue": "鸡爪断面泛白，不见血水"
    },
    {
      "n": 2,
      "text": "冷水下锅，加姜片与料酒，大火煮开焯三分钟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "冷水下锅，腥水才出得干净。",
      "visual_cue": "水面浮起灰白泡沫，撇净"
    },
    {
      "n": 3,
      "text": "捞出鸡爪用冷水冲凉，逐个搓洗掉表面的浮油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冲凉后皮更弹，泡好咬着有劲。",
      "visual_cue": "鸡爪表皮紧实，不黏手"
    },
    {
      "n": 4,
      "text": "换一锅清水烧开，下鸡爪小火煮十分钟至断生。",
      "time_min": 12,
      "heat": "小火",
      "tip": "十到十二分钟正好，久了皮就烂了。",
      "visual_cue": "爪身弯曲，用筷能戳进关节"
    },
    {
      "n": 5,
      "text": "捞出后立刻投入冰水中，浸泡五分钟让表皮收紧。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冰水激一下，口感才脆弹。",
      "visual_cue": "鸡爪迅速降温，表皮紧绷"
    },
    {
      "n": 6,
      "text": "泡椒连泡椒水倒进玻璃罐，加米醋、白糖与盐搅拌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "泡椒水是味道的根，别倒掉。",
      "visual_cue": "罐内液体红亮，椒香冲鼻"
    },
    {
      "n": 7,
      "text": "放入姜片，把沥干的鸡爪全部浸入泡椒水中。",
      "time_min": 3,
      "heat": "无火",
      "tip": "鸡爪要完全浸没，露出的部分会变味。",
      "visual_cue": "鸡爪沉在液面下，无浮起"
    },
    {
      "n": 8,
      "text": "盖紧盖子冷藏腌制十二小时，中途翻动一次入味。",
      "time_min": 5,
      "heat": "无火",
      "tip": "中途翻动，入味才均匀。",
      "visual_cue": "液体微浑，鸡爪色泽转浅黄"
    },
    {
      "n": 9,
      "text": "取出装进盘中，淋少许泡椒水，撒上红亮的泡椒段。",
      "time_min": 3,
      "heat": "无火",
      "tip": "现取现吃，久放会过酸。",
      "visual_cue": "鸡爪透亮，表面挂满椒水"
    }
  ],
  "tips": [
    "煮好立刻过冰水，鸡爪皮才脆弹，泡一夜也不软烂。",
    "泡椒水一定要留着一起泡，光用泡椒味道差一半。",
    "腌制放冷藏，室温泡容易变质发酸。"
  ],
  "common_mistakes": [
    "鸡爪煮太久，皮烂脱骨，泡出来一夹就散。",
    "泡椒水倒掉只放干椒，味道寡淡不酸不辣。",
    "用金属容器腌制，酸液反应，味道发涩。"
  ],
  "substitutions": [
    {
      "original": "鸡爪",
      "substitute": "凤爪",
      "ratio": "800 克:800 克",
      "note": "同物异名，选肉质厚的。"
    },
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "60 毫升:55 毫升",
      "note": "酸味更冲，糖要多加五克。"
    }
  ],
  "variations": [
    "加两根拍碎的芹菜梗同泡，清香更足。",
    "添几片柠檬，酸香更清爽，颜色也亮。"
  ],
  "serving_suggestion": "冷藏后当零食或下酒小菜，越嚼越香。",
  "storage": "冷藏可存五天，取用用干净筷子，避免生水入罐。",
