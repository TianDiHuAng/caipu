  "equipment": [
    "汤锅",
    "小碗",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉冷水下锅，加生姜片与料酒，中火煮十分钟至熟透。",
      "time_min": 12,
      "heat": "中火",
      "tip": "水开转小火煮，肉才不发柴。",
      "visual_cue": "鸡胸按压有弹性、中心不见粉色"
    },
    {
      "n": 2,
      "text": "捞出后放凉，用手撕成细丝，越细越容易入味。",
      "time_min": 8,
      "heat": "无火",
      "tip": "手撕比刀切更容易挂住酱汁。",
      "visual_cue": "鸡丝纤维分明、粗细均匀"
    },
    {
      "n": 3,
      "text": "黄瓜洗净切细丝，小葱切葱花，大蒜剁成蒜末备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "黄瓜丝切得细，口感才够脆。",
      "visual_cue": "黄瓜丝断口整齐、不出水"
    },
    {
      "n": 4,
      "text": "碗中放生抽、香醋、白糖、辣椒油、香油与盐，加蒜末拌成红油味汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "味汁先调匀再浇，咸甜才均衡。",
      "visual_cue": "味汁红亮、油水不分层"
    },
    {
      "n": 5,
      "text": "花椒用小火干炒出香，碾碎后撒进红油味汁里。",
      "time_min": 3,
      "heat": "小火",
      "tip": "花椒炒香再碾，麻味才干净。",
      "visual_cue": "花椒颜色转深、香气窜出"
    },
    {
      "n": 6,
      "text": "黄瓜丝铺盘底，上面放鸡丝，浇上味汁撒葱花拌匀即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "吃前再拌，鸡丝才不会出水。",
      "visual_cue": "鸡丝红亮、盘底不见积水"
    }
  ],
  "tips": [
    "鸡胸肉煮好后焖五分钟再捞，更嫩。",
    "红油要带一点辣椒碎，才有嚼头。",
    "黄瓜丝提前用少许盐腌两分钟挤干，不稀汤。"
  ],
  "common_mistakes": [
    "鸡胸肉煮过头，撕出的丝又干又柴。",
    "味汁里醋放太多，酸得盖住了红油香。",
    "拌好后就放，久置出水变成一汪汤。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "400g 对 400g",
      "note": "更嫩滑，煮制时间加三分钟。"
    },
    {
      "original": "黄瓜",
      "substitute": "莴笋",
      "ratio": "100g 对 100g",
      "note": "更爽脆，需切细丝并略腌。"
    }
  ],
  "variations": [
    "加二十克花生碎一起拌，口感更丰富。",
    "把鸡丝换成手撕鸡腿肉，做成红油鸡片同样好吃。"
  ],
  "serving_suggestion": "冷藏二十分钟后风味更好，适合当开胃凉菜。",
  "storage": "冷藏可放一天，味汁与鸡丝分开存放更好。",
