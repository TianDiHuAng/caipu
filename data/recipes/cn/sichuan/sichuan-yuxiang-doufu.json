  "steps": [
    {
      "n": 1,
      "text": "北豆腐切两厘米方块，放入加盐的开水里焯两分钟去豆腥，捞出沥干水分。",
      "time_min": 6,
      "heat": "小火",
      "tip": "焯过的豆腐不易碎，煎的时候也不粘锅。",
      "visual_cue": "豆腐块完整，表面紧实无碎屑。"
    },
    {
      "n": 2,
      "text": "小碗放香醋、白糖、生抽、盐、玉米淀粉和清水，搅匀成鱼香碗汁备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖醋约一比一，淀粉先化开，下锅才不结块。",
      "visual_cue": "碗汁均匀，底部无沉淀。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到六成热，下豆腐块中火煎到四面金黄起壳，盛出备用。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎出硬壳再烧，豆腐外香内嫩还不易碎。",
      "visual_cue": "豆腐四面金黄，轻摇锅会滑动。"
    },
    {
      "n": 4,
      "text": "锅中留底油，下剁细的豆瓣酱小火炒出红油，再下姜末炒香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆瓣炒出红油才香，火大立刻发苦。",
      "visual_cue": "油色红亮，酱香浓。"
    },
    {
      "n": 5,
      "text": "倒入碗汁烧开，放回煎好的豆腐块，小火煨三分钟让豆腐吸味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "用勺背轻推，别用锅铲翻，豆腐才完整。",
      "visual_cue": "汤汁渐稠，豆腐挂上红亮酱汁。"
    },
    {
      "n": 6,
      "text": "汤汁浓稠挂勺时撒入葱花，翻匀后立即起锅装盘。",
      "time_min": 2,
      "heat": "小火",
      "tip": "葱花最后下，久煮发黄失香。",
      "visual_cue": "酱汁红亮，葱花翠绿。"
    }
  ],
  "tips": [
    "豆腐先煎再烧，能保住形状也更有豆香。",
    "豆瓣剁细是红亮的关键，粗粒容易焦。",
    "碗汁提前调好，下锅一气呵成不慌。"
  ],
  "common_mistakes": [
    "豆腐不煎直接下锅烧，翻动两下就碎成小块。",
    "豆瓣不剁细，成品带颗粒还发苦。",
    "醋下锅煮太久，酸味挥发只剩甜咸。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "嫩豆腐",
      "ratio": "1:1",
      "note": "嫩豆腐更滑，但须盐水泡定形且不要煎，直接烧更嫩。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋酸味更尖，用量减五毫升，糖相应减三克。"
    }
  ],
  "variations": [
    "同法可做鱼香茄盒、鱼香肉丝，碗汁配方通用。",
    "有的做法加少许泡椒末同炒，酸辣更立体。"
  ],
  "serving_suggestion": "连汁装盘，配白饭；酱汁拌饭是这道菜的精华。",
  "storage": "冷藏可存两日，复热加少量清水小火煨开，勿大火翻动。",
