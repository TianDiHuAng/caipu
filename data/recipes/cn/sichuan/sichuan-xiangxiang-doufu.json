  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成四厘米见方的厚块，用刀在顶面挖出一个两厘米深的方坑，边缘留一厘米。",
      "time_min": 8,
      "heat": "无火",
      "tip": "坑要挖得方正，边缘太薄一煎就断，太厚装不了馅。",
      "visual_cue": "豆腐块方正，顶面凹陷整齐。"
    },
    {
      "n": 2,
      "text": "猪肉末加火腿末、香菇末、姜末、生抽、料酒、盐、白胡椒和一半淀粉，顺向搅上劲。",
      "time_min": 6,
      "heat": "无火",
      "tip": "火腿剁粗粒保留口感，剁成泥反而不香。",
      "visual_cue": "肉馅粘稠抱团，可见火腿细末。"
    },
    {
      "n": 3,
      "text": "把小勺肉馅填进豆腐坑里抹平，表面薄薄拍一层玉米淀粉封口。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拍淀粉是煎时馅不脱的关键。",
      "visual_cue": "馅面平整，淀粉薄匀不结块。"
    },
    {
      "n": 4,
      "text": "炒锅放植物油烧到五成热，馅朝下放入豆腐块，中小火煎到肉馅金黄定形。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "先煎馅面定型再翻，直接翻豆腐会散架。",
      "visual_cue": "馅面金黄焦香，边缘不脱。"
    },
    {
      "n": 5,
      "text": "翻面把豆腐四面略煎上色，加清水、生抽和白糖，盖盖小火煨十分钟入味。",
      "time_min": 11,
      "heat": "小火",
      "tip": "水加到豆腐一半高，煨的时间让豆腐吸满汤汁。",
      "visual_cue": "汤汁渐少，豆腐外层微皱。"
    },
    {
      "n": 6,
      "text": "淋水淀粉勾薄芡，用勺把汁反复浇在豆腐上，撒葱花后连汁装盘。",
      "time_min": 3,
      "heat": "小火",
      "tip": "浇汁能让顶部馅料也沾上味道，卖相更亮。",
      "visual_cue": "芡汁红亮，豆腐方正完整。"
    }
  ],
  "tips": [
    "豆腐要选质地紧实的北豆腐，嫩豆腐挖坑就碎。",
    "馅料里加入火腿提鲜，比纯肉馅更清不腻。",
    "煎的时候馅面朝下，定型后再翻才不脱馅。"
  ],
  "common_mistakes": [
    "豆腐坑挖得太深穿透底部，馅料一煎就全部漏出来。",
    "不拍淀粉直接煎，肉馅和豆腐分家。",
    "全程大火煨，汤汁收干，豆腐外焦里还是凉的。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "香菇",
      "ratio": "60克:60克",
      "note": "不吃火腿可用香菇加量替代，鲜味偏素雅，盐可略减。"
    },
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "150克:150克",
      "note": "换成牛肉末需多加五毫升料酒，口感更紧实。"
    }
  ],
  "variations": [
    "有的做法把挖出的豆腐瓤拌进肉馅，一点不浪费，口感更嫩。",
    "加一勺豆瓣酱同煨，即成家常风味的箱箱豆腐。"
  ],
  "serving_suggestion": "一人一块装盘，浇汁撒葱花；配米饭，先咬开吸汁再吃肉馅最香。",
  "storage": "冷藏可存两日，复热上锅蒸六分钟；不建议冷冻，豆腐会出水变渣。",
