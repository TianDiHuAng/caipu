  "steps": [
    {
      "n": 1,
      "text": "排骨段用清水泡二十分钟去血水，捞出挤干水分装碗。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡出血水炸出来才不发黑，也不会有腥味。",
      "visual_cue": "排骨颜色转浅，水盆微微泛红"
    },
    {
      "n": 2,
      "text": "加料酒、生抽、姜末、白胡椒抓匀腌十五分钟入味。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌料抓到手感发黏，味道才挂得住骨头。",
      "visual_cue": "排骨表面湿润，酱色均匀"
    },
    {
      "n": 3,
      "text": "花椒与盐下干锅小火炒香，倒出碾碎成椒盐备用。",
      "time_min": 5,
      "heat": "小火",
      "tip": "花椒一变色就关火，炒黑了整碟都带苦。",
      "visual_cue": "花椒脆得一捻即碎，盐粒微黄"
    },
    {
      "n": 4,
      "text": "排骨先裹蛋液再滚一层面粉，抖掉多余干粉后静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "裹完放一会，粉回潮才不会炸时脱壳。",
      "visual_cue": "表面挂一层薄粉，不见干粉堆积"
    },
    {
      "n": 5,
      "text": "炒锅倒花生油烧到六成热，下排骨中火炸六分钟捞出沥油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油温不够粉会掉，六成热下锅外壳立刻定型。",
      "visual_cue": "外壳浅金黄，排骨浮起不再下沉"
    },
    {
      "n": 6,
      "text": "油温升到八成热复炸四十秒，捞出趁热撒椒盐、葱末与干辣椒翻匀。",
      "time_min": 4,
      "heat": "大火",
      "tip": "复炸逼油起脆，只几十秒，久了肉汁全干。",
      "visual_cue": "外壳金黄起泡，敲着有脆响"
    }
  ],
  "tips": [
    "排骨斩段时让摊主代劳，刀口整齐炸出来不易掉渣。",
    "椒盐可以一次多炒些，装瓶留着做椒盐虾、椒盐蘑菇。",
    "喜欢辣的可在椒盐里拌入少许辣椒粉，香辣更突出。"
  ],
  "common_mistakes": [
    "排骨没泡水就腌，炸出来颜色发黑还带腥味。",
    "裹粉后马上炸，粉层脱落，锅里全是白渣。",
    "只炸一次就上桌，凉两分钟外壳就软塌了。"
  ],
  "substitutions": [
    {
      "original": "猪排骨",
      "substitute": "鸡翅中",
      "ratio": "500克:500克",
      "note": "鸡翅更易熟，炸的时间缩到五分钟。"
    },
    {
      "original": "面粉",
      "substitute": "糯米粉",
      "ratio": "40克:40克",
      "note": "糯米粉更脆，凉了也不易回软。"
    }
  ],
  "variations": [
    "炸好后与蒜末、干辣椒同炒，就是蒜香辣子排骨，味道更冲。",
    "把椒盐换成孜然与辣椒面，立刻变成西北风味。"
  ],
  "serving_suggestion": "趁热装盘，配一碟椒盐与柠檬角，作为下酒菜或儿童餐主菜都合适。",
  "storage": "炸好的当天吃完最脆，剩下的冷藏后可回锅高温复炸一分钟。",
