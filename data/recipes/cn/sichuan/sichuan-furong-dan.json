  "equipment": [
    "打蛋碗",
    "蒸锅",
    "细筛",
    "炒锅",
    "小碗",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕开分蛋，蛋白放入碗中加两克盐，用筷子顺一个方向轻搅到起细密泡沫，静置消泡。",
      "time_min": 6,
      "heat": "无火",
      "tip": "只搅蛋白不打发，起泡后静置片刻，蒸出的芙蓉才细腻。",
      "visual_cue": "蛋白泛白起细泡，泡沫逐渐消散。"
    },
    {
      "n": 2,
      "text": "蛋白液加入一百五十毫升鸡汤搅匀，用细筛过滤一遍，倒入浅口碗盖膜扎孔。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鸡汤温度别高，温汤倒入蛋白才不会提前凝块。",
      "visual_cue": "蛋白液乳白细腻，无气泡浮面。"
    },
    {
      "n": 3,
      "text": "水开后中小火蒸十分钟，关火虚蒸三分钟，取出倒扣在深盘中划成菱形块。",
      "time_min": 12,
      "heat": "中小火",
      "tip": "虚蒸让蛋白定形，倒扣才不会塌散。",
      "visual_cue": "蛋白洁白如玉，表面平整光亮。"
    },
    {
      "n": 4,
      "text": "虾仁剁成细粒加料酒抓匀，与香菇丁一起下沸水焯一分钟捞出沥干。",
      "time_min": 5,
      "heat": "中火",
      "tip": "虾仁剁粒而非剁泥，吃时有颗粒感更有层次。",
      "visual_cue": "虾仁粒转粉红，香菇丁变软出香。"
    },
    {
      "n": 5,
      "text": "炒锅放剩余鸡汤烧开，下虾仁粒、香菇丁和豌豆，加盐与白胡椒粉调味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "用鸡汤打底做芡汁，鲜味才与蛋白呼应。",
      "visual_cue": "汤汁清亮，配料浮匀。"
    },
    {
      "n": 6,
      "text": "生粉加清水调匀淋入锅中推成薄芡，滴香油，浇在蛋白芙蓉上即成。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芡要薄而透亮，厚了会把蛋白压塌、口感发糊。",
      "visual_cue": "芡汁透明挂勺，浇后芙蓉莹润发亮。"
    }
  ],
  "tips": [
    "只取蛋白，蛋黄可以另做蛋花汤不浪费。",
    "鸡汤要滤净浮油，勾出的芡汁才清亮。",
    "芡汁薄一点，才衬得出蛋白的细嫩。"
  ],
  "common_mistakes": [
    "蛋白搅到打发，蒸后全是蜂窝气孔。",
    "大火猛蒸，蛋白表面粗糙发硬起皮。",
    "芡汁勾得太厚，整道菜糊成一团。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "火腿",
      "ratio": "60克:40克",
      "note": "火腿切细丁咸鲜突出，盐可减到两克。"
    },
    {
      "original": "鸡汤",
      "substitute": "清水",
      "ratio": "200毫升:200毫升",
      "note": "用清水需加一克鸡精提鲜，风味略薄。"
    }
  ],
  "variations": [
    "川菜宴席版会在芡汁里加少许蟹黄或咸蛋黄，色泽金黄更显贵气。",
    "有的做法把蛋白改成整蛋蒸成蛋羹，再浇同款芡汁，家常版更省事。"
  ],
  "serving_suggestion": "装深盘趁热上桌，用勺舀起莹润的芙蓉块，配清汤与米饭都是宴客的体面菜。",
  "storage": "冷藏可存一日，回蒸三分钟即可；芡汁与蛋白分开存放，复热后再浇。",
