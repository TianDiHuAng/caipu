  "steps": [
    {
      "n": 1,
      "text": "番茄底部划十字，浇开水烫三十秒后撕去外皮，切成滚刀小块备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "烫皮后番茄一撕就掉，炒出的汁才细滑不挂皮。",
      "visual_cue": "番茄块去净外皮，汁水红亮。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加一克盐和十毫升清水搅匀，生粉加三十毫升清水调成水淀粉备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液里加清水，炒出的蛋更嫩更水润。",
      "visual_cue": "蛋液均匀，水淀粉无颗粒沉淀。"
    },
    {
      "n": 3,
      "text": "炒锅放三十五毫升植物油烧到六成热，倒蛋液快速推炒成半凝固的软块，立即盛出。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蛋液七成凝固就盛，回锅还会继续熟。",
      "visual_cue": "蛋块湿润软嫩，中心仍带光泽。"
    },
    {
      "n": 4,
      "text": "锅内补十五毫升植物油，下蒜末爆香，倒入番茄块加白糖和盐，中火炒到出汁软烂。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄要炒到出红汁、块边塌软，味道才浓。",
      "visual_cue": "番茄软塌出汁，锅中汤色红亮。"
    },
    {
      "n": 5,
      "text": "淋入水淀粉推匀至汤汁微稠，倒回蛋块轻推翻匀，撒葱花出锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "勾芡后再回蛋，蛋块才裹得住汁又不散。",
      "visual_cue": "汤汁浓稠挂蛋，葱花翠绿点缀。"
    }
  ],
  "tips": [
    "沙瓤番茄汁多味浓，比硬番茄好吃得多。",
    "蛋液加水更嫩，七成凝固就盛出。",
    "勾薄芡让汤汁挂住蛋块，卖相口感都加分。"
  ],
  "common_mistakes": [
    "番茄不去皮，炒好卷起一层老皮。",
    "蛋炒到全干再回锅，口感发柴发硬。",
    "不放糖只加盐，酸味生硬刺口发尖。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "300克:250克",
      "note": "罐头番茄味浓汁多，白糖可减半，炒制时间缩短一分钟。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "3个:3个",
      "note": "鸭蛋腥味略重，需多加一克白胡椒粉并延长炒制时间。"
    }
  ],
  "variations": [
    "有的做法把蛋液直接滑在番茄汁上不翻动，做成滑蛋盖浇饭。",
    "川味版本会加半勺辣椒油，酸甜里多一层辣香。"
  ],
  "serving_suggestion": "连汁带蛋浇在热米饭上最好吃，也可以拌面、配馒头。",
  "storage": "冷藏可存一日，复热时小火加点水轻推；番茄久放会析水，建议当餐吃完。",
