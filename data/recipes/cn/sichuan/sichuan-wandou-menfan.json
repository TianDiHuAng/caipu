    "炒锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后沥干水分，腊肉切成八毫米见方的小丁，豌豆洗净挑去空壳。",
      "time_min": 6,
      "heat": "无火",
      "tip": "米一定要沥干，否则和腊肉同炒时会粘锅出水。",
      "visual_cue": "米粒干爽松散，腊肉丁肥瘦分明。"
    },
    {
      "n": 2,
      "text": "炒锅放猪油烧化，下腊肉丁小火煸三分钟，煸出油脂和咸香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "腊肉煸出油，整锅饭才香，别用大火以免焦糊。",
      "visual_cue": "腊肉丁边缘微卷，锅底渗出红亮油。"
    },
    {
      "n": 3,
      "text": "倒入豌豆翻炒一分钟，再放大米炒两分钟，加盐翻匀让米粒裹上油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "米粒先炒过再焖，饭粒才松散不糊底。",
      "visual_cue": "米粒油润透亮，豌豆转深绿。"
    },
    {
      "n": 4,
      "text": "全部倒入电饭煲，加清水搅匀铺平，按煮饭键焖至跳闸后保温十分钟。",
      "time_min": 22,
      "heat": "中火",
      "tip": "水比平时煮饭少一成，豌豆出水会补足水分。",
      "visual_cue": "水刚没过米面约半厘米。"
    },
    {
      "n": 5,
      "text": "开盖撒葱花，用饭勺从底部翻拌均匀，盛碗即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "焖好别急着开盖，虚焖十分钟米粒才透心。",
      "visual_cue": "饭粒饱满松散，豌豆翠绿点缀。"
    }
  ],
  "tips": [
    "腊肉先煸出油，整锅饭的香味才立得住。",
    "水量比白饭略少，豌豆出水会补足水分。",
    "跳闸后虚焖十分钟，米芯才能彻底熟透。"
  ],
  "common_mistakes": [
    "米没沥干就下锅炒，焖出来发黏成团。",
    "水放太多，焖成一锅软烂的糊饭。",
    "腊肉不煸直接焖，油腻而且香味不足。"
  ],
  "substitutions": [
    {
      "original": "腊肉",
      "substitute": "火腿",
      "ratio": "100克:100克",
      "note": "火腿咸鲜清爽、油脂少，猪油需加到三十克补香。"
    },
    {
      "original": "豌豆",
      "substitute": "蚕豆",
      "ratio": "200克:220克",
      "note": "蚕豆更粉糯，焖制时间延长三分钟，需去外皮。"
    }
  ],
  "variations": [
    "有的家庭加几块土豆同焖，粉糯吸味。",
    "川南做法会撒一把花椒粉，麻香更突出。"
  ],
  "serving_suggestion": "一锅端上桌，豌豆青翠、腊肉咸香，配一小碟泡菜正好。",
  "storage": "冷藏可存两日，加少许清水回锅焖五分钟；冷冻会影响米粒口感，不建议。",
