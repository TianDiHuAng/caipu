    "炒锅",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉斩成三厘米见方的块，冷水下锅加料酒，水开后煮两分钟撇净血沫捞出冲净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅焯才逼得出血水，鸡肉也不柴。",
      "visual_cue": "鸡块紧实无血水，浮沫呈灰褐色。"
    },
    {
      "n": 2,
      "text": "芋头戴手套削去外皮，切成与鸡块相仿的滚刀块，泡在清水里防止氧化发黑。",
      "time_min": 8,
      "heat": "无火",
      "tip": "芋头黏液刺手，削皮时一定要戴手套。",
      "visual_cue": "芋块洁白，切面平整。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到五成热，下鸡块中火煸炒到表皮收紧微黄、鸡油渗出。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸡块要煸到出油出香，汤才浓不腥。",
      "visual_cue": "鸡块表面金黄，锅底见油。"
    },
    {
      "n": 4,
      "text": "下豆瓣酱、姜片、干辣椒节和花椒，小火炒出红油和麻辣香，不要炒糊。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆瓣炒出红油是这道菜的底色，火大了立即发苦。",
      "visual_cue": "油色红亮，香气冲鼻。"
    },
    {
      "n": 5,
      "text": "加料酒、生抽、冰糖和清水没过鸡块，大火烧开后转小火炖十五分钟。",
      "time_min": 17,
      "heat": "小火",
      "tip": "先炖鸡再下芋头，两者成熟时间差得多。",
      "visual_cue": "汤汁红亮，鸡块上色均匀。"
    },
    {
      "n": 6,
      "text": "放入芋头块，加盐调味，继续小火炖十五分钟，到芋头能被筷子轻松扎透。",
      "time_min": 16,
      "heat": "小火",
      "tip": "芋头入锅后别频繁翻动，容易化在汤里。",
      "visual_cue": "芋块吸饱汤汁，筷子一扎即透。"
    },
    {
      "n": 7,
      "text": "转中火收浓汤汁，留约三分之一的汤量，连汤带料转入砂锅，撒葱花上桌。",
      "time_min": 6,
      "heat": "中火",
      "tip": "汤汁要留一些，芋头吸汤，上桌后还会继续浓稠。",
      "visual_cue": "汤汁浓稠挂勺，芋块完整不散。"
    }
  ],
  "tips": [
    "选粉质芋头，炖后绵软吸味，脆水芋口感差。",
    "鸡块先煸出油再烧，汤浓香且不油腻。",
    "芋头下锅后尽量少动锅，用勺背轻推即可。"
  ],
  "common_mistakes": [
    "芋头与鸡同时下锅，鸡肉还硬芋头已经化泥。",
    "豆瓣炒过头发黑，整锅汤都是焦苦味。",
    "收汁收得太干，芋头吸汤后发干噎口。"
  ],
  "substitutions": [
    {
      "original": "芋头",
      "substitute": "莴笋",
      "ratio": "500克:500克",
      "note": "换成莴笋需在最后十分钟下锅，口感脆爽，不吸汤。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600克:550克",
      "note": "鸡胸肉脂肪少易柴，炖的时间缩短五分钟左右。"
    }
  ],
  "variations": [
    "四川家常版会加几块猪排骨同炖，鲜味更厚。",
    "有的做法把芋头先油炸至表面结皮再下锅，炖时不易散。"
  ],
  "serving_suggestion": "连砂锅端上桌，先吃芋头再吃鸡，汤汁拌饭最香；冬天吃最暖。",
  "storage": "冷藏可存两日，复热加少量清水小火煨开；芋头久放会化，建议两日内吃完。",
