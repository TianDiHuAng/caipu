  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐 400g 切成 5 厘米长、1.5 厘米厚的长方块，放进淡盐水里浸 5 分钟。",
      "time_min": 7,
      "heat": "无火",
      "tip": "盐水浸过，煎的时候不容易碎。",
      "visual_cue": "豆腐块完整、表面微微发紧"
    },
    {
      "n": 2,
      "text": "蒜苗 50g 斜切成段，姜末 10g 与 25g 豆瓣酱分别装好备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豆瓣酱先剁细，炒出的红油更匀。",
      "visual_cue": "蒜苗段整齐、豆瓣酱细腻"
    },
    {
      "n": 3,
      "text": "炒锅倒 60ml 植物油烧至六成热，豆腐块逐块下锅煎 6 分钟至两面金黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅后别急着翻，定型再动。",
      "visual_cue": "豆腐两面结壳、呈浅金色"
    },
    {
      "n": 4,
      "text": "盛出豆腐，锅内留底油下猪肉末 80g 炒散，加豆瓣酱与姜末炒出红油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆瓣酱要炒到油色发红才够香。",
      "visual_cue": "肉末酥香、油色红亮"
    },
    {
      "n": 5,
      "text": "加 200ml 清水、15ml 生抽与 2g 盐烧开，放回豆腐小火焖 5 分钟。",
      "time_min": 6,
      "heat": "小火",
      "tip": "用推锅代替翻炒，豆腐才不会破。",
      "visual_cue": "汤汁微沸、豆腐吸饱汤色"
    },
    {
      "n": 6,
      "text": "下蒜苗段翻匀，用 6g 淀粉调水勾芡至汤汁浓稠，撒 2g 花椒粉出锅。",
      "time_min": 4,
      "heat": "中火",
      "tip": "芡汁要能挂住豆腐，太稀就成汤了。",
      "visual_cue": "汤汁裹匀、蒜苗翠绿"
    }
  ],
  "tips": [
    "豆腐先用盐水浸，煎的时候不易碎也不粘锅。",
    "豆瓣酱本身很咸，生抽和盐都要减量。",
    "勾芡分两次下，芡汁才均匀不结块。"
  ],
  "common_mistakes": [
    "豆腐一下锅就急着翻动，碎成一锅豆花。",
    "豆瓣酱没炒香就加水，整盘菜只有咸味。",
    "芡汁一次倒完，锅底结出一层糊块。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "80g 对 80g",
      "note": "口感更紧实，需多炒 1 分钟。"
    },
    {
      "original": "豆瓣酱",
      "substitute": "辣椒酱",
      "ratio": "25g 对 25g",
      "note": "辣度更高，盐要减 1g。"
    }
  ],
  "variations": [
    "加 50g 木耳同烧，口感更有层次。",
    "最后淋 5ml 辣椒油，辣香更冲。"
  ],
  "serving_suggestion": "连汁带豆腐浇在米饭上，配一碗冬瓜汤解辣。",
  "storage": "冷藏可存 2 天，复热时加少量清水，避免芡汁发糊。",
