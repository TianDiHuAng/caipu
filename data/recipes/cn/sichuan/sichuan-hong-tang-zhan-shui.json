  "steps": [
    {
      "n": 1,
      "text": "豆瓣酱剁成细茸，干辣椒与花椒分别小火焙香后碾成粉，姜切末备用。",
      "time_min": 6,
      "heat": "小火",
      "tip": "两样香料分开焙，火候不同，同锅易一焦一生。",
      "visual_cue": "豆瓣细茸红亮，香料粉香气分明。"
    },
    {
      "n": 2,
      "text": "炒锅放植物油烧到五成热，下豆瓣茸小火慢炒到出红油、酱香浓郁。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆瓣炒出红油才香，火大了立刻发苦。",
      "visual_cue": "油色红亮，豆瓣酥香不糊。"
    },
    {
      "n": 3,
      "text": "下姜末炒香，加清水、生抽、白糖和盐烧开，转小火煮三分钟让味道融合。",
      "time_min": 4,
      "heat": "小火",
      "tip": "水加足一点，蘸水要稀才挂得住食材，太稠会糊嘴。",
      "visual_cue": "汤汁微滚，颜色深红。"
    },
    {
      "n": 4,
      "text": "关火后加辣椒粉、花椒粉搅匀，让香料在余温中释放香气而不发苦。",
      "time_min": 2,
      "heat": "无火",
      "tip": "关火再加香料粉，煮久了辣味发闷、麻味全失。",
      "visual_cue": "汤面浮红油，香气冲鼻。"
    },
    {
      "n": 5,
      "text": "撒葱花、香菜碎和花生碎，分装小碗，配白水煮菜或涮肉蘸食。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花与香菜最后撒，久泡发黄失香。",
      "visual_cue": "红汤浮绿，花生碎点点。"
    }
  ],
  "tips": [
    "蘸水讲究稀而香，太稠只能挂住一层酱，吃不出层次。",
    "豆瓣选陈年郫县豆瓣，红油足、酱香厚。",
    "喜欢麻味可加几滴藤椒油，清麻更突出。"
  ],
  "common_mistakes": [
    "豆瓣不剁细直接炒，颗粒焦苦，蘸水发黑。",
    "香料粉早下锅久煮，麻辣变闷，只剩咸味。",
    "水放太少，蘸水过稠，食材蘸一次糊一层。"
  ],
  "substitutions": [
    {
      "original": "豆瓣酱",
      "substitute": "生抽",
      "ratio": "30克:40毫升",
      "note": "不吃辣可用生抽加少许老抽与白糖调成咸鲜蘸水。"
    },
    {
      "original": "花生",
      "substitute": "白芝麻",
      "ratio": "30克:15克",
      "note": "换成熟白芝麻，颗粒更细，香气清一些。"
    }
  ],
  "variations": [
    "云南蘸水会加糊辣椒面与折耳根，风味更粗犷。",
    "川南一带常加一勺香醋，酸辣开胃，配白肉最好。"
  ],
  "serving_suggestion": "配白水煮肉、煮青菜或火锅涮品，食材在蘸水里滚一圈即可；也可浇在凉面上。",
  "storage": "冷藏可存三日，花生碎与香菜建议食用前现加；出现酸味立即丢弃。",
