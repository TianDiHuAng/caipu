  "steps": [
    {
      "n": 1,
      "text": "猪肉馅加盐、料酒、姜末与 40ml 清水，顺一个方向搅打至起胶，再加香油拌匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "打水让肉馅嫩，起胶才抱团。",
      "visual_cue": "肉馅黏稠上劲、能整体挑起"
    },
    {
      "n": 2,
      "text": "取饺子皮包入约 8g 肉馅，对折捏紧封口，捏成月牙形，摆在撒了干粉的盘里。",
      "time_min": 20,
      "heat": "无火",
      "tip": "封口要捏实，煮时才不会散。",
      "visual_cue": "饺子饱满挺立、封口无缝隙"
    },
    {
      "n": 3,
      "text": "炒锅放生抽与红糖，小火熬 3 分钟至冒细泡、汁液略稠，倒出即复制酱油。",
      "time_min": 4,
      "heat": "小火",
      "tip": "红糖熬化后才有浓稠挂勺的甜香。",
      "visual_cue": "汁色深褐发亮、微黏"
    },
    {
      "n": 4,
      "text": "锅中加 2000ml 水烧开，下饺子用勺背推散，煮至全部浮起后点 2 次冷水。",
      "time_min": 8,
      "heat": "大火",
      "tip": "推锅用勺背，饺子皮才不破。",
      "visual_cue": "饺子鼓起浮面、皮透出肉色"
    },
    {
      "n": 5,
      "text": "捞出沥水装碗，淋复制酱油与蒜水，浇辣椒油撒花椒粉，最后撒小葱花。",
      "time_min": 4,
      "heat": "无火",
      "tip": "复制酱油多放些，甜咸是灵魂。",
      "visual_cue": "饺子浸在红褐汁中、油光发亮"
    }
  ],
  "tips": [
    "肉馅必须打水上劲，煮出来才嫩滑多汁。",
    "复制酱油是钟水饺的灵魂，红糖不能省。",
    "饺子不要包太大，一口一个最地道。"
  ],
  "common_mistakes": [
    "肉馅不调味直接包，煮出来寡淡发散。",
    "饺子皮封口没捏紧，下锅就开口漏馅。",
    "酱油与糖分开淋，甜咸分离不成味。"
  ],
  "substitutions": [
    {
      "original": "猪肉馅",
      "substitute": "牛肉馅",
      "ratio": "300g 对 300g",
      "note": "需多加 20ml 水，口感才不干。"
    },
    {
      "original": "饺子皮",
      "substitute": "馄饨皮",
      "ratio": "300g 对 300g",
      "note": "皮更薄，煮的时间减 1 分钟。"
    }
  ],
  "variations": [
    "红油版：辣椒油加到 60ml，麻辣更重。",
    "清汤版：不淋红油，用骨汤配酱油食用。"
  ],
  "serving_suggestion": "趁热拌开吃，配一碗原汤或酸辣汤。",
  "storage": "生饺子冷冻 2 周，熟饺子冷藏 1 天；复热用蒸或煎。",
