  "equipment": [
    "汤锅",
    "炒锅",
    "面碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "碎米芽菜用清水漂洗 5 分钟，挤干水分后切成细末备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "芽菜偏咸，冲洗能去掉多余盐分。",
      "visual_cue": "芽菜末松散不结团"
    },
    {
      "n": 2,
      "text": "炒锅不放油，小火把芽菜末慢慢炒干水分，炒到有干香时盛出。",
      "time_min": 5,
      "heat": "小火",
      "tip": "不放油干炒，芽菜才有脆香不回潮。",
      "visual_cue": "芽菜发干、香气明显"
    },
    {
      "n": 3,
      "text": "锅中另下花生碎与熟白芝麻，小火焙到微微冒香后盛出放凉。",
      "time_min": 4,
      "heat": "小火",
      "tip": "花生碎极易糊，闻到香就关火。",
      "visual_cue": "花生碎边缘微黄、芝麻跳动"
    },
    {
      "n": 4,
      "text": "汤锅水烧开，碱水面抖散下锅煮 2 分钟至刚断生。",
      "time_min": 4,
      "heat": "大火",
      "tip": "碱水面只煮断生，后面还要拌。",
      "visual_cue": "碱水面浮起、掐断无白心"
    },
    {
      "n": 5,
      "text": "碱水面捞出甩干水分，趁热加植物油、生抽与盐拌匀抖散。",
      "time_min": 3,
      "heat": "无火",
      "tip": "甩干水分是不粘不坨的关键。",
      "visual_cue": "碱水面根根松散发亮"
    },
    {
      "n": 6,
      "text": "面上铺芽菜末、辣椒粉、花生碎与芝麻，浇一勺烧到冒烟的热油，撒葱花拌开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "热油泼辣椒粉时才出红亮油香。",
      "visual_cue": "红油渗出、香气冲鼻"
    }
  ],
  "tips": [
    "碱水面煮好必须甩干水分，拌时才不坨。",
    "芽菜干炒去水分，吃起来才够脆香。",
    "热油要烧到微微冒烟，辣椒香气才炸得开。"
  ],
  "common_mistakes": [
    "碱水面带水下锅拌，成品黏成一坨。",
    "芽菜不洗直接下锅，整碗面咸到发苦。",
    "辣椒粉用温油泼，香味出不来只有生辣。"
  ],
  "substitutions": [
    {
      "original": "碱水面",
      "substitute": "细水面",
      "ratio": "300g 对 300g",
      "note": "细面易断，煮的时间减 30 秒。"
    },
    {
      "original": "芽菜",
      "substitute": "榨菜碎",
      "ratio": "40g 对 40g",
      "note": "榨菜更咸，需多漂洗一次。"
    }
  ],
  "variations": [
    "加肉臊版：拌面时加 60g 炒香的肉末，风味更足。",
    "全素版：省去生抽，用香菇粉提鲜。"
  ],
  "storage": "芽菜臊子可冷藏 3 天，碱水面现煮现拌。",
