  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成一点五厘米见方的丁，加盐、料酒、生抽和玉米淀粉抓匀上浆十分钟。",
      "time_min": 13,
      "heat": "无火",
      "tip": "上浆时多抓几下让淀粉吃进肉里，滑炒才嫩。",
      "visual_cue": "鸡丁挂浆均匀，手捏有黏性。"
    },
    {
      "n": 2,
      "text": "泡椒斜切成段，莴笋去皮切一厘米见方的丁，大葱切段，姜切末备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "莴笋丁与鸡丁大小相近，受热才一致。",
      "visual_cue": "配料丁块均匀，泡椒红亮。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到五成热，下鸡丁中火滑炒到变白散开，盛出沥油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鸡丁下锅先别搅，等定型再划开，才不粘连。",
      "visual_cue": "鸡丁粒粒分明，表面发白。"
    },
    {
      "n": 4,
      "text": "锅中留底油下泡椒段和姜末，小火煸出红油和酸辣香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "泡椒小火煸才出香，火大只酸不香。",
      "visual_cue": "油色转红，泡椒香气冲出。"
    },
    {
      "n": 5,
      "text": "下莴笋丁转中火炒一分钟，倒回鸡丁和葱段，加白糖与少许盐快炒翻匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "莴笋只炒到断生，脆感才在，久了出水。",
      "visual_cue": "莴笋翠绿透亮，鸡丁裹上红油。"
    },
    {
      "n": 6,
      "text": "玉米淀粉加水化开后沿锅边淋入，快速翻炒至汤汁挂满鸡丁即可出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "芡要薄而亮，厚了就失去滑炒的清爽。",
      "visual_cue": "芡汁透亮裹匀，盘底无余汁。"
    }
  ],
  "tips": [
    "鸡腿肉比鸡胸肉嫩，滑炒不易柴。",
    "泡椒汁留一勺同炒，酸辣味更立体。",
    "莴笋最后下，保持脆爽口感与翠绿颜色。"
  ],
  "common_mistakes": [
    "鸡丁不上浆直接炒，口感发柴且吸油。",
    "泡椒不切段整颗下，味道出不来。",
    "莴笋久炒出水，整盘菜变成汤水。"
  ],
  "substitutions": [
    {
      "original": "莴笋",
      "substitute": "芹菜",
      "ratio": "150克:120克",
      "note": "芹菜切段口感更脆，炒的时间缩短半分钟。"
    },
    {
      "original": "泡椒",
      "substitute": "豆瓣酱",
      "ratio": "50克:30克",
      "note": "换豆瓣酱需另加香醋五毫升补酸味，风味偏酱香。"
    }
  ],
  "variations": [
    "加一把泡姜同炒，酸辣更冲，是川南的做法。",
    "有的做法加几粒花椒爆香，麻味更立体。"
  ],
  "serving_suggestion": "装盘配白饭，酸辣开胃；剩汁可拌面，一点不浪费。",
  "storage": "冷藏可存一日，回锅小火快炒一分钟；莴笋久放会出水，建议当餐吃完。",
