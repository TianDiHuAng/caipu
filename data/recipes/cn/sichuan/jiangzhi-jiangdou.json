  "steps": [
    {
      "n": 1,
      "text": "豇豆掐去两头和老筋，洗净后理齐，切成八厘米长的段，粗细分拣开便于同时成熟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豇豆要挑细挺的，鼓粒发白的已经老了，焯完纤维粗难嚼。",
      "visual_cue": "豆段颜色翠绿，长短整齐。"
    },
    {
      "n": 2,
      "text": "汤锅清水烧开，加盐和植物油，下豇豆大火焯四分钟，直到豆身变软、能掐断无生芯。",
      "time_min": 6,
      "heat": "大火",
      "tip": "豇豆含皂苷，必须焯到完全熟透，宁可多煮一分钟也不能夹生。",
      "visual_cue": "豆色深绿发亮，掐断断面无白芯。"
    },
    {
      "n": 3,
      "text": "捞出豇豆立即投入冰水过凉，沥干水分后整齐码入盘中。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过凉能让豆皮收紧，颜色保持翠绿，口感也更脆。",
      "visual_cue": "豇豆表面干爽，颜色鲜绿。"
    },
    {
      "n": 4,
      "text": "姜剁成细蓉，用纱布挤出姜汁约十五毫升，与生抽、米醋、盐、白糖和香油调匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "姜汁现挤现用，放久了辛辣味会挥发，只剩寡淡的甜。",
      "visual_cue": "料汁微稠，姜香冲鼻不刺。"
    },
    {
      "n": 5,
      "text": "把姜汁均匀淋在豇豆上，静置五分钟让其入味，食用前轻轻拌匀即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "豇豆整段淋汁不如码好再淋，颜色和卖相都更好看。",
      "visual_cue": "豆段挂着浅褐色姜汁，盘底无积水。"
    }
  ],
  "tips": [
    "姜要选老姜，辛辣足、挤出的姜汁也更香浓。",
    "焯水时加几滴植物油，豇豆颜色更翠绿。",
    "姜汁料现拌现吃，久放会出水变淡。"
  ],
  "common_mistakes": [
    "豇豆焯得半生就上桌，吃着有生豆腥味。",
    "姜剁成粗末不挤汁，姜味浮在表面不入味。",
    "焯完不过凉，余温把豇豆焖成暗黄色。"
  ],
  "substitutions": [
    {
      "original": "豇豆",
      "substitute": "四季豆",
      "ratio": "400克:400克",
      "note": "四季豆更宽厚，焯水时间要延长到六分钟，务必彻底熟透。"
    },
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "15毫升:15毫升",
      "note": "香醋颜色深、酸味重，用量减到十毫升，避免压住姜香。"
    }
  ],
  "variations": [
    "成都老馆子会在姜汁里加一勺红油，酸辣姜香三味并存。",
    "有的做法把豇豆撕成细丝再焯，更易入味，适合牙口不好的人。"
  ],
  "serving_suggestion": "码成整齐的柴把状装盘，淋汁后撒几粒盐焗花生，配粥配面都很清爽。",
  "storage": "冷藏密封可存一日，姜汁易出水，建议豇豆与料汁分装，食用前再淋。",
