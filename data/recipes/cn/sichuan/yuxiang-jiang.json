  "steps": [
    {
      "n": 1,
      "text": "碗里放白糖、米醋、酱油、清水与淀粉，搅匀成碗汁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "淀粉先化开，勾芡才不结块。",
      "visual_cue": "碗汁均匀、无干粉"
    },
    {
      "n": 2,
      "text": "锅中倒植物油小火加热，下辣椒酱炒出红油，火别大以免炒焦。",
      "time_min": 3,
      "heat": "小火",
      "tip": "小火炒红油，颜色才亮。",
      "visual_cue": "油色红亮、香气冲鼻"
    },
    {
      "n": 3,
      "text": "加姜末与蒜末炒出香味，倒入碗汁转中火煮到冒泡变浓稠。",
      "time_min": 5,
      "heat": "中火",
      "tip": "边倒边搅，芡才均匀。",
      "visual_cue": "酱汁浓稠、气泡翻起"
    },
    {
      "n": 4,
      "text": "加盐调味，煮到酱体能挂勺即可关火装瓶保存。",
      "time_min": 3,
      "heat": "中火",
      "tip": "挂勺就停火，过了发硬。",
      "visual_cue": "酱体透亮、挂勺不流"
    }
  ],
  "tips": [
    "糖、醋、酱油的比例按 2:3:3 调，酸甜咸才平衡。",
    "辣椒酱要用小火炒出红油，火大就苦。",
    "淀粉水边倒边搅，芡汁才顺滑不结块。"
  ],
  "common_mistakes": [
    "辣椒酱大火炒，红油没出来先糊了锅。",
    "淀粉水一次性倒入，酱里全是白色疙瘩。",
    "醋放太早久煮，酸味挥发只剩咸甜。"
  ],
  "substitutions": [
    {
      "original": "辣椒酱",
      "substitute": "豆瓣酱",
      "ratio": "80g 对 80g",
      "note": "咸度更高，盐可减 1g。"
    },
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "30ml 对 30ml",
      "note": "酸味更直接。"
    }
  ],
  "variations": [
    "糖醋版：糖加至 30g，醋减至 20ml，口感更甜。",
    "蒜香版：蒜末加至 60g，出锅前再撒一把生蒜。"
  ],
  "serving_suggestion": "用来炒肉丝、茄子或豆腐，一勺就能出锅鱼香味。",
  "storage": "冷藏密封可存 10 天，取用须用干净勺子。",
