          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "打结",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "香醋",
          "name_en": "black vinegar",
          "amount": 60,
          "unit": "ml",
          "note": "腌萝卜用",
          "optional": false
        },
        {
