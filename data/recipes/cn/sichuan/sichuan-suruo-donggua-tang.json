  "equipment": [
    "炒锅",
    "汤锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切小指粗的条，加料酒、一半的盐和拍碎的花椒抓匀腌十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "花椒先用刀背拍碎，麻香才能渗进肉条里。",
      "visual_cue": "肉条表面发黏、有花椒香"
    },
    {
      "n": 2,
      "text": "打入鸡蛋，加入淀粉抓成薄糊，让每根肉条都均匀挂上一层糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糊要能挂住不往下滴，太稀可以再补一点淀粉。",
      "visual_cue": "肉条挂糊均匀、不滴浆"
    },
    {
      "n": 3,
      "text": "植物油烧到六成热，肉条逐根下锅炸四分钟至金黄，捞出沥油。",
      "time_min": 4,
      "heat": "中大火",
      "tip": "逐根下锅不容易粘连，炸出来条形才完整。",
      "visual_cue": "外壳金黄、筷子敲有脆响"
    },
    {
      "n": 4,
      "text": "冬瓜去皮去瓤，切成半厘米厚的片，姜切片、葱切段备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冬瓜片不要切太薄，久煮容易化成一摊水。",
      "visual_cue": "冬瓜片厚薄一致、边缘平整"
    },
    {
      "n": 5,
      "text": "锅中留少许底油炒香姜葱，加清水烧开，下炸好的酥肉煮八分钟。",
      "time_min": 8,
      "heat": "中火",
      "tip": "酥肉先煮一会儿，汤里才有足够的肉香。",
      "visual_cue": "汤色微白、酥肉回软"
    },
    {
      "n": 6,
      "text": "下冬瓜片煮五分钟至半透明，加剩下的盐和白胡椒粉，撒葱花出锅。",
      "time_min": 5,
      "heat": "中火",
      "tip": "冬瓜变透明就该关火，再煮就散架了。",
      "visual_cue": "冬瓜呈半透明、边缘完整"
    }
  ],
  "tips": [
    "酥肉可以一次多炸一些冷冻起来，随吃随取非常方便。",
    "冬瓜皮不要削太深，靠近皮的那层最清甜。",
    "想要汤色更白，下酥肉前先用猪油把姜葱炒香再加水。"
  ],
  "common_mistakes": [
    "挂糊太稀，炸的时候糊浆脱落，酥肉变成干炸肉条。",
    "冬瓜和酥肉同时下锅，冬瓜煮烂而酥肉还硬。",
    "汤里加酱油调色，清汤变浑，川式酥肉汤讲究汤白。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "五花肉",
      "ratio": "300g 对 300g",
      "note": "肥一点更香，但要多炸一分钟逼出油脂。"
    },
    {
      "original": "花椒",
      "substitute": "花椒粉",
      "ratio": "3g 对 1.5g",
      "note": "直接拌进腌料里，省去拍碎这一步。"
    }
  ],
  "variations": [
    "加一把豌豆尖同煮，汤更清香解腻。",
    "把冬瓜换成白萝卜，做成萝卜酥肉汤。"
  ],
  "serving_suggestion": "大碗盛出，撒葱花与少许白胡椒，配米饭。",
  "storage": "冷藏可存两天，酥肉与汤分开保存，复热后口感较好。",
