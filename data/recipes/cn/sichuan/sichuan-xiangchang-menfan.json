    "刀",
    "砧板",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍沥干，香肠斜切成两毫米薄片，香菇去蒂切成小丁，豌豆洗净备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香肠斜切更易出油，片薄才能焖得透。",
      "visual_cue": "香肠片肥瘦相间，边缘油润。"
    },
    {
      "n": 2,
      "text": "炒锅放植物油，下香菇丁中火煸到出水收干、边缘微焦。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菇煸干水分才有浓香，否则带土腥。",
      "visual_cue": "香菇丁收缩微焦，香气扑鼻。"
    },
    {
      "n": 3,
      "text": "放入香肠片和豌豆翻炒一分钟，再放大米同炒，加生抽和盐翻匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香肠炒出油就够了，久炒会变硬发柴。",
      "visual_cue": "米粒油亮分明，香肠泛红出油。"
    },
    {
      "n": 4,
      "text": "全部倒入电饭煲加清水铺平，按煮饭键焖到跳闸，保温十分钟。",
      "time_min": 20,
      "heat": "中火",
      "tip": "水量略低于白饭，香菇和豌豆都会出水。",
      "visual_cue": "水面刚好没过米面约半厘米。"
    },
    {
      "n": 5,
      "text": "开盖撒葱花，用饭勺翻拌均匀，让香肠的油汁裹住每粒饭。",
      "time_min": 3,
      "heat": "无火",
      "tip": "翻拌让油汁裹匀，每粒饭都带腊香。",
      "visual_cue": "饭粒油润泛红，葱花点缀。"
    }
  ],
  "tips": [
    "香肠斜切薄片，出油均匀而且容易入味。",
    "香菇先煸干水分才够香，别直接下锅焖。",
    "水量略少一些，配料出水正好补上。"
  ],
  "common_mistakes": [
    "香肠切得太厚，焖好后仍然发硬嚼不动。",
    "香菇不煸直接焖，饭里带着土腥味。",
    "水放太多，饭粒发黏丧失颗粒感。"
  ],
  "substitutions": [
    {
      "original": "香肠",
      "substitute": "腊肉",
      "ratio": "150克:150克",
      "note": "腊肉咸味更重，盐可完全省略，猪油量略增。"
    },
    {
      "original": "香菇",
      "substitute": "干香菇",
      "ratio": "60克:20克",
      "note": "干香菇需提前泡发，泡菇水可代替部分清水，香气更浓。"
    }
  ],
  "variations": [
    "有的做法把香肠换成广式腊肠加腊肉，咸甜交织。",
    "加一勺辣椒油拌进去，川味更足。"
  ],
  "serving_suggestion": "盛碗后撒点葱花，配清炒青菜或一碗番茄蛋汤，一餐齐活。",
  "storage": "冷藏可存两日，加少许清水回锅焖三分钟；香肠焖饭冷冻后饭粒易散，不建议。",
