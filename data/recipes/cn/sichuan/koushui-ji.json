  "equipment": [
    "汤锅",
    "温度计",
    "冰水盆",
    "斩刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉洗净，用盐 2g 与料酒抹匀，冷水下锅，加姜片与花椒，大火烧开后转小火保持水面微沸。",
      "time_min": 5,
      "heat": "大火",
      "tip": "大火烧开后立刻转小火，冷水下锅能让血水随温度上升慢慢析出，比热水下锅更干净。",
      "visual_cue": "水面浮起灰白浮沫时撇净"
    },
    {
      "n": 2,
      "text": "小火浸煮 15 分钟，用温度计插入鸡腿最厚处确认中心温度达到 74℃ 并保持 15 秒以上。",
      "time_min": 15,
      "heat": "小火",
      "tip": "全程不要大滚，剧烈沸腾会让鸡皮破裂、肉质发柴。",
      "visual_cue": "竹签插入无血水渗出，中心温度 74℃ 以上"
    },
    {
      "n": 3,
      "text": "捞出鸡腿立刻放入冰水中浸泡 5 分钟，让鸡皮收紧变脆，冷却后斩成 1.5cm 宽的条。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冰水要加足量冰块，水温低于 10℃ 效果最好。",
      "visual_cue": "鸡皮发亮紧实，按下去有回弹"
    },
    {
      "n": 4,
      "text": "黄瓜丝铺在盘底，鸡条皮朝上排好；芝麻酱用 30ml 温水调稀，与生抽、香醋、白糖、蒜末、姜末、辣椒油、余下的盐调成料汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "料汁先尝咸淡再淋，辣椒油最后加才能保持红亮。",
      "visual_cue": "料汁呈红亮油润的浓稠状，能挂住勺背"
    },
    {
      "n": 5,
      "text": "料汁浇在鸡条上，撒花生碎、熟芝麻、葱花与香菜段，静置 5 分钟入味后上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置一会儿更入味，但别放太久以免黄瓜出水稀释料汁。",
      "visual_cue": "盘底渗出红油与料汁的混合汁水"
    }
  ],
  "tips": [
    "鸡肉必须煮到中心 74℃ 以上再冰镇，全熟与嫩滑并不矛盾，关键是全程小火浸煮。",
    "红油用量按吃辣能力调整，减少辣椒油时同步补 5ml 生抽以免口味变淡。",
    "隔夜冷藏后鸡皮会变硬，复热只需在温水中浸泡 2 分钟再冰镇一次即可恢复。"
  ],
  "common_mistakes": [
    "把鸡腿大火滚煮 20 分钟以上，肉纤维收缩过度，切片时碎裂、口感发柴。",
    "省略冰镇步骤，鸡皮湿软不脆，料汁挂不住。",
    "料汁一次性全部倒入后久放，黄瓜出水把味道冲淡。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "三黄鸡整鸡",
      "ratio": "600g 鸡腿肉 ≈ 半只 700g 整鸡",
      "note": "整鸡煮的时间要延长到 22 分钟，务必用温度计确认最厚处熟透。"
    },
    {
      "original": "芝麻酱",
      "substitute": "花生酱",
      "ratio": "1:1",
      "note": "花生酱更甜，白糖要减到 5g。"
    }
  ],
  "variations": [
    "家庭简化版：用现成川式红油辣子加一勺花椒粉，省去自己炼红油。",
    "乐山风味：料汁里加 10ml 藤椒油，麻味更清亮。"
  ],
  "serving_suggestion": "作为凉菜上桌，配米饭或作为宴客冷盘的第一道；夏天可提前冷藏 30 分钟再上。",
  "storage": "冷藏保存 2 天，料汁与鸡肉分开存放，食用前再淋汁；不建议冷冻，鸡皮解冻后会出水。",
