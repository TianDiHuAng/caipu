  "equipment": [
    "蒸锅",
    "鱼盘",
    "刀",
    "小碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去内脏刮净腹内黑膜，两面各划两刀，用料酒和盐里外抹匀腌八分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黑膜一定要刮干净，那是腥味最重的地方。",
      "visual_cue": "鱼身干净无血水，刀口整齐。"
    },
    {
      "n": 2,
      "text": "盘底铺一半葱段和姜丝，把鱼摆上去，鱼腹里再塞少许葱姜。",
      "time_min": 3,
      "heat": "无火",
      "tip": "葱姜垫底让蒸汽循环，鱼身受热均匀还去腥。",
      "visual_cue": "鱼身平摆不歪，葱姜垫在身下。"
    },
    {
      "n": 3,
      "text": "蒸锅水大开后放入鱼盘，盖盖大火蒸八分钟，关火再虚焖两分钟。",
      "time_min": 10,
      "heat": "大火",
      "tip": "必须水开后再上锅，冷水上锅鱼肉容易发柴。",
      "visual_cue": "鱼眼凸出变白，鱼身微微翘起。"
    },
    {
      "n": 4,
      "text": "取出鱼盘倒掉盘中腥水，拣去葱姜，重新铺上葱丝和姜丝，淋上蒸鱼豉油。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘里的蒸鱼水一定倒掉，留着会有腥味。",
      "visual_cue": "鱼身覆满细葱丝，豉油沿盘边流下。"
    },
    {
      "n": 5,
      "text": "炒锅烧热植物油到冒青烟，放花椒炸香后捞出，把热油浇在葱丝上激出香味。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油要烧到冒烟才浇，滋啦一声香味才出得来。",
      "visual_cue": "葱丝遇油卷曲，香气直冲。"
    }
  ],
  "tips": [
    "蒸锅水大开之后再上锅，鱼肉才嫩滑不柴",
    "盘中的蒸鱼水必须倒掉，否则发腥。",
    "热油浇在葱丝上是提香的关键一步。",
    "蒸好虚焖两分钟，鱼骨附近的肉才熟透。"
  ],
  "common_mistakes": [
    "冷水上锅蒸，鱼肉发柴失去嫩滑。",
    "蒸好后不换盘，鱼浸在腥水里发腥。",
    "油没烧热就浇，葱香根本激不出来。",
    "蒸的时间超过十分钟，鱼肉松散脱骨。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "草鱼",
      "ratio": "600克:600克",
      "note": "草鱼刺多，需选肉厚中段，蒸制时间延长两分钟。"
    },
    {
      "original": "蒸鱼豉油",
      "substitute": "生抽",
      "ratio": "30毫升:25毫升",
      "note": "生抽咸味更直，需加三克白糖调匀再淋。"
    }
  ],
  "variations": [
    "川式做法会在葱丝上加几段泡椒，酸辣提味。",
    "有的家庭淋一勺豆瓣红油，麻辣版更下饭。"
  ],
  "serving_suggestion": "趁热上桌，用筷子从鱼背挑肉蘸盘底豉油吃，配一碗白饭刚好。",
  "storage": "冷藏可存一日，复热需隔水蒸五分钟；微波加热会使鱼肉发硬，不建议。",
