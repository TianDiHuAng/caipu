  "equipment": [
    "汤锅",
    "擀面杖",
    "刀",
    "砧板",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉冷水下锅，加姜片和盐，大火烧开后转小火浸煮二十分钟关火再焖十分钟。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火浸煮不滚破皮，肉才嫩且多汁。",
      "visual_cue": "鸡腿浮起，竹签插最厚处无血水。"
    },
    {
      "n": 2,
      "text": "捞出鸡腿立刻放进冰水里浸泡十分钟，让鸡皮收紧发脆，肉质更弹。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冰水急冷是鸡皮爽脆的关键，别省这一步。",
      "visual_cue": "鸡皮紧致光亮，表面凉透。"
    },
    {
      "n": 3,
      "text": "干辣椒剪节去籽，与植物油一同小火加热到辣椒暗红出香，滤出红油备用。",
      "time_min": 8,
      "heat": "小火",
      "tip": "油温别太高，辣椒一黑整碗油都苦。",
      "visual_cue": "红油透亮，辣椒沉底。"
    },
    {
      "n": 4,
      "text": "熟白芝麻小火炒香后放入石臼，加香油反复研磨成顺滑的芝麻酱。",
      "time_min": 8,
      "heat": "小火",
      "tip": "芝麻先炒香再磨，酱才浓香不寡淡。",
      "visual_cue": "芝麻酱顺滑流动，香气浓郁。"
    },
    {
      "n": 5,
      "text": "用擀面杖把鸡腿肉轻轻捶松，再顺纹理用手撕成筷子粗细的条，装盘。",
      "time_min": 8,
      "heat": "无火",
      "tip": "捶松再撕，纤维松散，拌酱才入味。",
      "visual_cue": "鸡肉撕成均匀长条，边缘带皮。"
    },
    {
      "n": 6,
      "text": "芝麻酱加生抽、香醋、白糖、盐和花椒粉调匀，分次加红油搅成浓稠酱汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "酱要调到能挂住鸡丝又不流汤，太稀就没味。",
      "visual_cue": "酱汁浓稠棕红，缓慢流下。"
    },
    {
      "n": 7,
      "text": "把酱汁淋在鸡丝上，撒葱花和少许熟白芝麻，吃前拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "现拌现吃，久放鸡丝会吸干酱汁发柴。",
      "visual_cue": "鸡丝裹满酱汁，红亮油润。"
    }
  ],
  "tips": [
    "鸡腿带皮煮，鸡皮爽脆是棒棒鸡的灵魂。",
    "冰水浸泡不能省，热度不收肉就发柴。",
    "用擀面杖捶松再撕，比刀切更入味。"
  ],
  "common_mistakes": [
    "大火滚煮鸡腿，皮破肉柴，卖相全无。",
    "煮好不冰镇直接撕，鸡肉松散出水。",
    "芝麻酱不炒香直接磨，酱味生涩寡淡。"
  ],
  "substitutions": [
    {
      "original": "熟白芝麻",
      "substitute": "花生",
      "ratio": "30克:40克",
      "note": "用炒香花生磨酱，口感更厚重，需多加十毫升香油调稀。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋酸味更尖，用量减三毫升，糖相应略增。"
    }
  ],
  "variations": [
    "有的做法把鸡丝与黄瓜丝同拌，口感更清爽。",
    "成都老馆子会在酱里加一勺芝麻酱与花椒油，麻香更厚。"
  ],
  "serving_suggestion": "装盘淋酱撒葱花，配白饭或凉面；也可卷入薄饼作凉菜拼盘。",
  "storage": "鸡丝与酱汁分开冷藏可存两日，食用前再拌，避免鸡丝吸干酱汁。",
