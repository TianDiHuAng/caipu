  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净去蒂，用刀面拍裂后切成三厘米长的段，撒盐拌匀腌五分钟杀出水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拍比切好，裂口粗糙才挂得住料汁；腌出的水一定要倒掉。",
      "visual_cue": "黄瓜断面开裂，碗底积出浅绿水。"
    },
    {
      "n": 2,
      "text": "大蒜剁成细泥放入小碗，植物油烧到冒青烟，趁热浇在蒜泥上激出香味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "热油泼蒜能去掉生蒜的呛辣，只留醇厚的蒜香。",
      "visual_cue": "蒜泥边缘起泡，蒜香浓郁不刺鼻。"
    },
    {
      "n": 3,
      "text": "碗中加生抽、米醋、白糖、香油和辣椒油，与蒜泥油一起搅匀成料汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "糖和醋先搅化再下油，味道更均匀。",
      "visual_cue": "料汁红亮，蒜香、醋香层次分明。"
    },
    {
      "n": 4,
      "text": "黄瓜倒掉腌出的水，淋上料汁抓拌均匀，静置三分钟入味后装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌好后别久放，黄瓜会持续出水，把味道冲淡。",
      "visual_cue": "黄瓜段裹满料汁，盘底不见积水。"
    }
  ],
  "tips": [
    "拍黄瓜选带刺的嫩瓜，籽少水多更脆。",
    "蒜泥要剁细，颗粒粗了辛辣不均。",
    "热油泼蒜是提香关键，别直接拌生蒜。"
  ],
  "common_mistakes": [
    "黄瓜不腌直接拌，出水把味道冲淡。",
    "蒜剁成大颗粒，吃一口全是生蒜辣。",
    "料汁里不放糖，只有酸和咸，口感发尖。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "12毫升:10毫升",
      "note": "香醋味浓色深，用量略减，白糖可加到五克平衡。"
    },
    {
      "original": "辣椒油",
      "substitute": "干辣椒",
      "ratio": "10毫升:5克",
      "note": "用干辣椒需在泼蒜的热油里先炸香，再一起拌入。"
    }
  ],
  "variations": [
    "川渝街头版会加一勺熟花生碎，脆感更足。",
    "有的做法用刀背把黄瓜砸成不规则块，边缘更毛糙、更入味。"
  ],
  "serving_suggestion": "现拌现吃最能体会脆劲，装深盘淋尽料汁，配烤肉或面食都解腻。",
  "storage": "不建议存放，黄瓜拌后半小时即大量出水，如需提前备料可把黄瓜与料汁分开冷藏。",
