  "steps": [
    {
      "n": 1,
      "text": "干木耳用冷水泡发四十分钟，泡到完全舒展、手感柔软，剪去根部硬蒂，撕成小朵洗净。",
      "time_min": 12,
      "heat": "无火",
      "tip": "木耳必须用冷水泡，热水泡发外面软里面还硬，口感发艮。",
      "visual_cue": "木耳舒展厚实，根部硬蒂清除干净。"
    },
    {
      "n": 2,
      "text": "汤锅清水烧开加盐，下木耳大火焯两分钟，捞出立即投入冰水过凉，沥干水分。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯透才能杀菌去土腥味，过凉则保住脆嫩弹牙的口感。",
      "visual_cue": "木耳颜色转深发亮，捏起来有弹性。"
    },
    {
      "n": 3,
      "text": "黄瓜切细丝铺在盘底，木耳撕成一口大小的块码在上面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "黄瓜垫底既清爽又好看，还能吸走木耳渗出的水。",
      "visual_cue": "黄瓜丝均匀铺平，木耳堆成小山。"
    },
    {
      "n": 4,
      "text": "蒜末放小碗，植物油烧到七成热泼上去激香，再加生抽、香醋、白糖、盐、辣椒油和香油调匀。",
      "time_min": 4,
      "heat": "中火",
      "tip": "热油泼蒜后再调醋，酸香才不会被油封住。",
      "visual_cue": "蒜香冲鼻，料汁红亮微稠。"
    },
    {
      "n": 5,
      "text": "料汁淋在木耳上，撒香菜段和葱花抓拌均匀，冷藏十分钟后食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌好冷藏一会儿更入味，但别超过半个小时，黄瓜会大量出水。",
      "visual_cue": "木耳裹满料汁，入口爽脆有声。"
    }
  ],
  "tips": [
    "选背面灰白、正面黑褐的秋耳，肉厚脆嫩。",
    "泡发别超过两小时，天热要放冰箱。",
    "焯后过冰水，木耳才弹牙不软塌。"
  ],
  "common_mistakes": [
    "用热水快速泡发，木耳外软内硬。",
    "木耳焯水后不沥干，拌好一盘水。",
    "泡发时间过长放在室温，木耳发黏变味。"
  ],
  "substitutions": [
    {
      "original": "黄瓜",
      "substitute": "莴笋",
      "ratio": "200克:200克",
      "note": "莴笋切细丝后需焯三十秒再过凉，口感更清甜。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "15毫升:15毫升",
      "note": "米醋酸味柔和，白糖可减到三克。"
    }
  ],
  "variations": [
    "川味版本会加一勺花椒油，麻香更突出。",
    "有的做法加胡萝卜丝与青椒丝配色，卖相更清爽。"
  ],
  "serving_suggestion": "冰镇后装浅盘，撒少许熟白芝麻，配粥、配面或作为火锅前的开胃小菜都很合适。",
  "storage": "冷藏密封可存一日，木耳久泡会变软失脆，建议当餐吃完。",
