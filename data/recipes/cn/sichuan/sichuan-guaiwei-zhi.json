  "steps": [
    {
      "n": 1,
      "text": "干辣椒去籽剪节，与花椒分别用小火焙香，摊凉后碾成细粉备用。",
      "time_min": 6,
      "heat": "小火",
      "tip": "两种香料分开焙，花椒易焦、辣椒耐火，同锅容易一焦一生。",
      "visual_cue": "辣椒粉暗红，花椒粉棕褐，香气分明。"
    },
    {
      "n": 2,
      "text": "芝麻酱倒入碗中，分三次加香油，每次都朝同一方向搅到完全吸收再加下一次。",
      "time_min": 5,
      "heat": "无火",
      "tip": "澥麻酱必须慢慢加油，一次倒多会结块澥不开。",
      "visual_cue": "麻酱顺滑流动，无颗粒结块。"
    },
    {
      "n": 3,
      "text": "小锅放生抽、香醋、白糖、盐和清水，小火加热搅到糖盐完全溶化后离火。",
      "time_min": 4,
      "heat": "小火",
      "tip": "只加热到化糖即可，煮滚了醋酸会挥发，酸味变淡。",
      "visual_cue": "汁液清亮，无糖粒沉积。"
    },
    {
      "n": 4,
      "text": "把调好的汁分次倒进澥开的芝麻酱里，边倒边搅，搅到酱汁融合呈流动状。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汁要慢慢加，快了麻酱会突然发稀分层。",
      "visual_cue": "酱汁顺滑挂勺，缓慢流下。"
    },
    {
      "n": 5,
      "text": "加辣椒粉、花椒粉、姜末、味精搅匀，最后撒花生碎，静置十分钟让味道融合。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香料粉最后加，早加会被咸酸味压住，香气也散。",
      "visual_cue": "酱汁棕红发亮，花生碎浮面。"
    }
  ],
  "tips": [
    "怪味讲究七味平衡，调好后尝一口，缺哪一味补哪一味。",
    "芝麻酱要用纯芝麻的，掺花生酱的澥开后味道发腻。",
    "糖和醋比例一比一最稳妥，喜甜可略增糖。"
  ],
  "common_mistakes": [
    "麻酱一次加足香油，澥成一坨疙瘩，怎么搅都不顺。",
    "醋和酱油一起煮久，酸味跑掉只剩咸。",
    "香料粉一开始就下锅煮，香气挥发殆尽，只剩辣味。"
  ],
  "substitutions": [
    {
      "original": "芝麻酱",
      "substitute": "花生",
      "ratio": "60克:60克",
      "note": "用花生酱代替更浓稠，需多兑二十毫升清水调稀。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋酸味更直，用量减五毫升，另加少许白糖平衡。"
    }
  ],
  "variations": [
    "重庆怪味胡豆的调味思路与此相同，拌上炸蚕豆即成小吃。",
    "有的师傅加少许腐乳汁，咸鲜更厚，风味更复合。"
  ],
  "serving_suggestion": "拌鸡丝、拌凉面或蘸白肉；也可作怪味鸡块的浇汁，一勺足够。",
  "storage": "密封冷藏可存五日，花生碎建议现撒；出现油酱分离严重时搅匀再用。",
