  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗后泡四小时，沥干铺在蒸布上，大火蒸二十分钟。",
      "time_min": 25,
      "heat": "大火",
      "tip": "米要泡到手指一捻就碎，不然蒸出来夹生。",
      "visual_cue": "米粒饱满透亮，粒粒分明不粘连"
    },
    {
      "n": 2,
      "text": "五花肉整块冷水下锅，加姜片、葱结与料酒煮十五分钟，捞出放凉。",
      "time_min": 20,
      "heat": "中火",
      "tip": "煮到筷子能穿皮即可，煮过头切片会散。",
      "visual_cue": "皮色转白，按压有弹性"
    },
    {
      "n": 3,
      "text": "肉块切成夹刀片，第一刀不切断、第二刀切断，成连刀薄片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "一刀浅一刀深，片片连皮又不散，夹沙才稳。",
      "visual_cue": "每片厚约三毫米，中间可张开成口"
    },
    {
      "n": 4,
      "text": "红豆沙分成小份，逐一夹进肉片中间，轻轻压平成夹沙肉片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆沙别塞太满，蒸的时候会挤出来糊成一片。",
      "visual_cue": "肉片夹层饱满，边缘不溢出豆沙"
    },
    {
      "n": 5,
      "text": "糯米趁热拌猪油、白糖与红糖，翻拌到每粒米都裹上油糖。",
      "time_min": 6,
      "heat": "无火",
      "tip": "米要趁热拌，冷了油糖裹不匀，蒸出来发干。",
      "visual_cue": "米粒油润发亮，颜色均匀棕红"
    },
    {
      "n": 6,
      "text": "夹沙肉片皮朝下码进碗底，铺满糯米压实，上汽蒸一小时二十分。",
      "time_min": 80,
      "heat": "中火",
      "tip": "蒸久一点没关系，糯米越蒸越糯、肉越蒸越化。",
      "visual_cue": "米面鼓起冒油，筷子一插到底"
    }
  ],
  "tips": [
    "出锅前撒一把炒香的白芝麻，香气更足也更好看。",
    "碗底垫一层荷叶或粽叶同蒸，清香能解腻。",
    "甜度可以按口味调整，老人吃可把白糖减到四十克。"
  ],
  "common_mistakes": [
    "糯米没泡透就上锅，蒸一小时中心还是硬的。",
    "豆沙夹太多，蒸的过程中全流到碗底，肉片变得寡淡。",
    "蒸的时间不够就倒扣，肉片和糯米全散在盘里。"
  ],
  "substitutions": [
    {
      "original": "红豆沙",
      "substitute": "莲蓉",
      "ratio": "120克:120克",
      "note": "莲蓉更甜，白糖相应减少十克。"
    },
    {
      "original": "糯米",
      "substitute": "黑糯米",
      "ratio": "200克:200克",
      "note": "黑糯米须泡六小时，蒸的时间延长十分钟。"
    }
  ],
  "variations": [
    "把豆沙换成枣泥，甜味更温润，是川北一带的常见做法。",
    "表面撒一层蜜饯果脯再蒸，卖相最喜庆，宴席上常用。"
  ],
  "serving_suggestion": "倒扣在盘里趁热上桌，一人一勺分食，配一杯清茶解甜腻。",
  "storage": "冷藏可存两天，复热须重新上锅蒸二十分钟，微波加热会让糯米发硬。",
