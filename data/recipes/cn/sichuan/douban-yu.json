  "equipment": [
    "炒锅",
    "锅铲",
    "鱼盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去内脏洗净，两面各斜划三刀，用料酒与 2g 盐抹匀腌 10 分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "花刀划到骨，入味快也易熟透。",
      "visual_cue": "鱼身干爽、刀口整齐"
    },
    {
      "n": 2,
      "text": "腌好的鱼用厨房纸吸干水分；豆瓣酱剁细，姜蒜切末，小葱切葱花。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鱼身越干，煎的时候越不粘锅。",
      "visual_cue": "鱼皮无水光、配料备齐"
    },
    {
      "n": 3,
      "text": "锅烧热下 70ml 植物油，鱼沿锅边滑入，中火煎 4 分钟至两面金黄定型。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煎鱼不要急着翻，定型后再动。",
      "visual_cue": "鱼皮金黄完整、轻推可滑动"
    },
    {
      "n": 4,
      "text": "把鱼推到一边，下豆瓣酱、姜末、蒜末小火炒 1 分钟出红油。",
      "time_min": 2,
      "heat": "小火",
      "tip": "豆瓣酱要小火炒透，才有醇厚的酱香。",
      "visual_cue": "锅中红油明显、酱香浓郁"
    },
    {
      "n": 5,
      "text": "加 300ml 清水与生抽、白糖，大火烧开后转中小火加盖烧 8 分钟，中途舀汁淋鱼身。",
      "time_min": 10,
      "heat": "中小火",
      "tip": "只淋汁不翻鱼，鱼身才完整。",
      "visual_cue": "汤汁收到原来一半、鱼眼凸出"
    },
    {
      "n": 6,
      "text": "把鱼盛入盘中，锅中汤汁加香醋，用 10g 玉米淀粉水勾薄芡，淋在鱼身上撒葱花。",
      "time_min": 3,
      "heat": "中火",
      "tip": "醋最后加，酸香才留得住。",
      "visual_cue": "芡汁红亮挂勺、鱼身裹汁"
    }
  ],
  "tips": [
    "郫县豆瓣要剁细，不然成品里会吃到生豆瓣粒。",
    "鱼选 700g 左右的鲈鱼，肉厚易熟；草鱼也行但要片得薄些。",
    "剩下的汤汁拌面或拌饭，是川渝人的隐藏吃法。"
  ],
  "common_mistakes": [
    "鱼身带水下锅，油爆皮粘、鱼皮全破。",
    "豆瓣酱大火干炒，瞬间焦糊发苦。",
    "全程大火烧，鱼身散架、汤汁也收得发死。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "鲤鱼",
      "ratio": "700g 鲈鱼 ≈ 800g 鲤鱼",
      "note": "鲤鱼土味重，需用姜片多腌 5 分钟。"
    },
    {
      "original": "豆瓣酱",
      "substitute": "泡椒",
      "ratio": "40g 豆瓣酱 ≈ 60g 泡椒",
      "note": "泡椒需搅成蓉，盐量减 1g。"
    }
  ],
  "variations": [
    "家庭简化版：鱼先用平底锅煎好再转炒锅烧，避免翻动破皮。",
    "川渝餐馆版：加 10g 醪糟同烧，酱香更厚。"
  ],
  "serving_suggestion": "整鱼盛盘上桌，配米饭；川菜馆常用长盘浇满红亮的汁。",
  "storage": "冷藏 1 天，复热加 50ml 清水小火焖 3 分钟，勿用微波炉。",
