        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "大碗",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成一指宽的长条，带一点肥肉更香。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肥瘦相间，炸出来才不柴。，看准状态再往下做。",
      "visual_cue": "肉条均匀，肥瘦分明"
    },
    {
      "n": 2,
      "text": "肉条加盐、料酒、姜末和花椒粉抓匀，腌十五分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "腌够时间，肉芯才有味道。，看准状态再往下做。",
      "visual_cue": "肉条微黏，香气散出"
    },
    {
      "n": 3,
      "text": "大碗里放红薯淀粉，打入鸡蛋搅成稠糊。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糊要能挂住筷子，太稀挂不上。，看准状态再往下做。",
      "visual_cue": "糊体顺滑，能拉出线"
    },
    {
      "n": 4,
      "text": "把腌好的肉条放进糊里，逐条裹匀。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "一条条裹，粘在一起会炸成坨。，看准状态再往下做。",
      "visual_cue": "每条挂糊均匀，这一点很关键。"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧到六成热，逐条下锅炸。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油温不够，糊会掉在锅里。，看准状态再往下做。",
      "visual_cue": "表面迅速定型，油面翻动"
    },
    {
      "n": 6,
      "text": "炸到定型微黄捞出，把粘连的分开。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "先定型再复炸，外壳才够脆。，看准状态再往下做。",
      "visual_cue": "外皮浅黄，条形分开"
    },
    {
      "n": 7,
      "text": "油温升到八成热，全部倒回复炸一分钟。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "复炸让外壳起酥，颜色也更亮。，看准状态再往下做。",
      "visual_cue": "外壳金黄，声音清脆"
    },
    {
      "n": 8,
      "text": "捞出沥油，撒花椒粉和盐趁热吃。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热撒椒盐，香气才冲。，看准状态再往下做。",
      "visual_cue": "表面干爽，椒盐附着"
    }
  ],
  "tips": [
    "红薯淀粉挂糊比面粉更酥，凉了也不软。",
    "肉条要逐条下锅，粘连在一起就炸不透。",
    "复炸一次外壳才起酥，这一步不能省。"
  ],
  "common_mistakes": [
    "糊太稀挂不住，下锅全掉进油里。，这一点很关键。",
    "油温太低，酥肉吸饱油发腻。，这一点很关键。",
    "一次下太多，油温骤降压成软坨。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "里脊肉",
      "ratio": "400 克:400 克",
      "note": "更瘦，腌时多加一勺油。"
    },
    {
      "original": "红薯淀粉",
      "substitute": "玉米淀粉",
      "ratio": "120 克:110 克",
      "note": "更脆但容易回软。"
    }
  ],
  "variations": [
    "加一勺豆瓣酱进糊，酱香更浓。，这一点很关键。",
    "炸好后再和青椒同炒，做成回锅酥肉。"
  ],
  "serving_suggestion": "趁热直接吃，或下火锅煮着吃。，这一点很关键。",
  "storage": "冷藏两天，冷冻两周；复热用空气炸锅一百八十度六分钟。",
