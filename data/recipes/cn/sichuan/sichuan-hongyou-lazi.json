  "equipment": [
    "耐热碗",
    "小锅",
    "温度计"
  ],
  "steps": [
    {
      "n": 1,
      "text": "辣椒面与花椒、盐、白糖、白芝麻一同放入耐热碗，滴入 10ml 米酒拌至微潮。",
      "time_min": 5,
      "heat": "无火",
      "tip": "辣椒面先用酒打湿，泼油时不容易糊。",
      "visual_cue": "辣椒面湿润抱团、颜色发亮"
    },
    {
      "n": 2,
      "text": "小锅倒入 400ml 植物油，下大葱段、姜片、八角、桂皮，开小火慢炸至葱段焦黄。",
      "time_min": 12,
      "heat": "小火",
      "tip": "全程小火，香料炸糊整锅油就发苦。",
      "visual_cue": "葱段边缘焦黄、香气浓郁"
    },
    {
      "n": 3,
      "text": "捞净香料渣，把油温升到 180℃，离火静置 1 分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油温太高泼下去辣椒面立刻发黑。",
      "visual_cue": "油面微微冒烟、筷入冒小泡"
    },
    {
      "n": 4,
      "text": "先取三分之一热油淋入辣椒碗，边淋边搅，让辣椒面受热均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "分次泼油激出的香更透。",
      "visual_cue": "辣椒面鼓起气泡、香气冲鼻"
    },
    {
      "n": 5,
      "text": "待油温降到 150℃左右，把余下热油全部倒入并持续搅拌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "慢搅能让红油色更亮。",
      "visual_cue": "红油色泽深红、辣椒面沉底"
    },
    {
      "n": 6,
      "text": "常温静置放凉后装瓶，表面封一层红油隔绝空气。",
      "time_min": 30,
      "heat": "无火",
      "tip": "静置一夜香气更融合。",
      "visual_cue": "油色透红、辣椒面香气沉稳"
    }
  ],
  "tips": [
    "菜籽油要烧到冒烟再降温，去掉生油味后香气才正。",
    "辣椒面粗细各半，细的出色、粗的出香。",
    "装瓶时油要没过辣椒面一指宽，能存放更久。"
  ],
  "common_mistakes": [
    "一次把滚油全倒入，辣椒面外层焦糊内里还生。",
    "香料炸过头，红油带上明显苦味。",
    "碗里有水就直接泼油，热油四溅极易烫伤。"
  ],
  "substitutions": [
    {
      "original": "菜籽油",
      "substitute": "花生油",
      "ratio": "400ml 对 400ml",
      "note": "香气稍淡，可加 10g 花生碎补香。"
    },
    {
      "original": "二荆条辣椒面",
      "substitute": "小米辣辣椒面",
      "ratio": "120g 对 100g",
      "note": "辣度更高，用量要减。"
    }
  ],
  "variations": [
    "藤椒版：把花椒换成等量藤椒，麻感更清亮。",
    "五香版：香料中加 2g 五香粉，适合拌凉面。"
  ],
  "serving_suggestion": "作为蘸料、凉拌汁底或拌面红油使用，每次 15-20ml 即可。",
  "storage": "密封冷藏可存 2 个月，取用需用干勺，避免进水变质。",
