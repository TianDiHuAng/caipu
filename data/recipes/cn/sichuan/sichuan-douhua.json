          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "花椒",
          "name_en": "Sichuan peppercorn",
          "amount": 4,
          "unit": "g",
          "note": "焙香碾末",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "氽水",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1500,
          "unit": "ml",
          "note": "氽煮",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "蘸碟",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐片去外层硬皮，切成四厘米见方的大块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "外皮片掉，豆花才嫩得一致。",
      "visual_cue": "豆腐块边缘光滑，不见蜂窝"
    },
    {
      "n": 2,
      "text": "汤锅加水烧到微沸，加盐后转小火保持不滚。",
      "time_min": 6,
      "heat": "小火",
      "tip": "水滚太猛会把豆腐冲散。",
      "visual_cue": "锅底冒小泡，水面微微颤动"
    },
    {
      "n": 3,
      "text": "豆腐块用汤勺托着轻轻滑入水中，不要直接丢。",
      "time_min": 4,
      "heat": "小火",
      "tip": "托着下水，块形完整不碎。",
      "visual_cue": "豆腐块浮在锅中，边缘不破"
    },
    {
      "n": 4,
      "text": "小火氽八分钟，让豆腐内部热透、豆腥味散出。",
      "time_min": 8,
      "heat": "小火",
      "tip": "小火慢氽，豆香出来，腥气跑掉。",
      "visual_cue": "豆腐块微胀，汤面浮起淡淡豆香"
    },
    {
      "n": 5,
      "text": "花椒放进干锅小火焙出香味，盛出后碾成粗末。",
      "time_min": 4,
      "heat": "小火",
      "tip": "焙到出香就起锅，久了发苦。",
      "visual_cue": "花椒一捏即碎，香气冲鼻"
    },
    {
      "n": 6,
      "text": "辣子油、生抽酱油与花椒末调成蘸水，撒入葱花。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蘸水先调好，豆腐出锅就吃最香。",
      "visual_cue": "蘸水红亮，浮着花椒末与葱花"
    },
    {
      "n": 7,
      "text": "用漏勺把豆腐块一块块轻轻捞出，沥去水分装碗。",
      "time_min": 4,
      "heat": "无火",
      "tip": "沥水要轻，别把豆腐压塌。",
      "visual_cue": "豆腐块完整，碗底不见积水"
    },
    {
      "n": 8,
      "text": "趁热浇上一勺蘸水，也可以夹起豆花蘸着吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热吃，豆香和辣香才咬得出来。",
      "visual_cue": "豆腐颤巍巍，红油顺着边缘淌"
    }
  ],
  "tips": [
    "氽豆腐的水只能微沸，滚起来豆腐就散成豆渣。",
    "花椒现焙现碾，麻香才活，用粉代替差一截。",
    "片掉外层硬皮，豆花口感才细滑一致。"
  ],
  "common_mistakes": [
    "水大滚时下豆腐，一锅碎成渣，捞不起来。",
    "豆腐氽太久，内部起蜂窝，口感发老。",
    "蘸水提前几小时调好，葱花发黄，香味散尽。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "内酯豆腐",
      "ratio": "800 克:800 克",
      "note": "更嫩，氽的时间减到五分钟。"
    },
    {
      "original": "辣子油",
      "substitute": "辣椒粉",
      "ratio": "30 毫升:12 克",
      "note": "需另烧热油泼香。"
    }
  ],
  "variations": [
    "蘸水加一勺甜面酱，咸香带甜，老少都爱。",
    "撒一把炒香的芝麻与花生碎，口感更丰富。"
  ],
  "serving_suggestion": "配一碗白米饭，把豆花连蘸水一起拌进去，是川人最家常的吃法。",
  "storage": "现做现吃，冷藏不超过一天，复热须用小火蒸。",
