      "group": "main",
      "items": [
        {
          "name": "嫩豆腐",
          "name_en": "silken tofu",
          "amount": 800,
          "unit": "g",
          "note": "切大块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "辣椒油",
          "name_en": "chili oil",
          "amount": 30,
          "unit": "ml",
