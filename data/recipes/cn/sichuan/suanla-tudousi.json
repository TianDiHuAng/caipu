  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成 0.2cm 薄片，再切成细丝，放入清水中反复抓洗两遍至水清。",
      "time_min": 12,
      "heat": "无火",
      "tip": "洗掉表面黏浆，炒时才不粘不发黑。",
      "visual_cue": "土豆丝根根分明、水色清澈"
    },
    {
      "n": 2,
      "text": "土豆丝泡在清水中，加 5ml 香醋浸 5 分钟后捞出沥干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "醋水浸泡能让土豆丝更脆。",
      "visual_cue": "土豆丝挺实、沥水不滴"
    },
    {
      "n": 3,
      "text": "炒锅倒 35ml 植物油烧热，下花椒炸 20 秒出香后捞出，再下干辣椒与蒜片爆香。",
      "time_min": 2,
      "heat": "大火",
      "tip": "花椒炸香后捞出，吃时不会咬到整粒。",
      "visual_cue": "辣椒变红、油面浮香"
    },
    {
      "n": 4,
      "text": "倒入土豆丝与青椒丝，大火快速翻炒 90 秒至略透明。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火，火小了就出水变软。",
      "visual_cue": "土豆丝透亮、锅底干爽"
    },
    {
      "n": 5,
      "text": "加盐、白糖与剩余 15ml 香醋，翻匀后撒小葱段立即出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "醋分两次放，酸味更有层次。",
      "visual_cue": "酸香冲鼻、土豆丝脆挺"
    }
  ],
  "tips": [
    "土豆丝切好必须洗去黏浆，这是脆的关键。",
    "全程大火快炒，超过 3 分钟就发软。",
    "醋分两次下，一次浸泡一次出锅，酸味更立体。"
  ],
  "common_mistakes": [
    "土豆丝不泡水直接炒，粘锅还发黑。",
    "小火慢炒，土豆丝绵软像土豆泥。",
    "醋只放一次且早放，酸味全部挥发。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "山药",
      "ratio": "400g 对 350g",
      "note": "更脆但易断，翻炒力度要轻。"
    },
    {
      "original": "香醋",
      "substitute": "白醋",
      "ratio": "20ml 对 18ml",
      "note": "酸味更冲，白糖加 2g。"
    }
  ],
  "variations": [
    "青椒版：青椒加到 80g，颜色更鲜亮。",
    "肉丝版：先炒 100g 猪肉丝，再下土豆丝。"
  ],
  "serving_suggestion": "趁热吃最脆，配白粥或米饭都合适。",
  "storage": "冷藏 1 天，复热大火快炒 1 分钟。",
