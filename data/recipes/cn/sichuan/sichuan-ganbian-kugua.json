  "steps": [
    {
      "n": 1,
      "text": "苦瓜竖着剖开，用勺子刮掉白色瓜瓤和籽。，看准状态再往下做。",
      "time_min": 7,
      "heat": "无火",
      "tip": "白瓤最苦，刮干净苦味轻一半。，看准状态再往下做。",
      "visual_cue": "瓜腔内壁发青，无白膜"
    },
    {
      "n": 2,
      "text": "切成半厘米厚的斜片，撒盐抓匀腌十分钟。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌出水再挤干，苦味会跟着走。，看准状态再往下做。",
      "visual_cue": "瓜片出水，质地变软"
    },
    {
      "n": 3,
      "text": "用手把瓜片的水分挤干，越干越好。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "挤得干，煸出来才有干香口感。，看准状态再往下做。",
      "visual_cue": "瓜片发干，体积缩小"
    },
    {
      "n": 4,
      "text": "炒锅烧热不放油，下瓜片中火干煸三分钟。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "先干煸去水汽，苦味再降一层。，看准状态再往下做。",
      "visual_cue": "瓜片边缘发皱，水汽收干"
    },
    {
      "n": 5,
      "text": "盛出瓜片，锅里倒植物油下干辣椒和花椒。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "辣椒花椒小火炒，糊了整锅发苦。，看准状态再往下做。",
      "visual_cue": "辣椒转深红，花椒出麻香"
    },
    {
      "n": 6,
      "text": "下蒜片炒香，倒回苦瓜大火翻炒。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火快炒，瓜片才脆不软。，看准状态再往下做。",
      "visual_cue": "瓜片泛油光，蒜香扑出"
    },
    {
      "n": 7,
      "text": "加生抽和白糖，翻匀让每片都沾上酱色。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "糖能压苦，别省。，看准状态再往下做。",
      "visual_cue": "瓜片裹色，油亮，这一点很关键。"
    },
    {
      "n": 8,
      "text": "尝味补盐，出锅装盘。，看准状态再往下做。，动作要轻，别把食材弄碎。",
      "time_min": 2,
      "heat": "无火",
      "tip": "腌过有咸味，盐最后放。，看准状态再往下做。",
      "visual_cue": "干爽少汁，颜色翠绿"
    }
  ],
  "tips": [
    "瓜瓤和白膜刮干净，苦味能减一半。",
    "先干煸出水，再下油炒，口感才够干香。",
    "糖不能省，是压苦味的关键。，这一点很关键。"
  ],
  "common_mistakes": [
    "直接下油炒，苦瓜出水变成煮苦瓜。",
    "辣椒花椒炒糊，整盘带焦苦味。，这一点很关键。",
    "盐放太早，瓜片软塌不脆。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "苦瓜",
      "substitute": "丝瓜",
      "ratio": "500 克:500 克",
      "note": "不苦，炒的时间减两分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "豆瓣酱",
      "ratio": "8 克:20 克",
      "note": "酱香更浓，盐要减。"
    }
  ],
  "variations": [
    "加几片腊肉同煸，油香压苦。，这一点很关键。",
    "放一勺豆豉，风味更厚。，这一点很关键。"
  ],
  "serving_suggestion": "配白粥或米饭，夏天最开胃。，这一点很关键。",
  "storage": "冷藏两天，复热炒锅快炒一分钟。，这一点很关键。",
