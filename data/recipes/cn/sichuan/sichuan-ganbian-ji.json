    "刀",
    "砧板",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成三厘米长的粗条，加盐、料酒和生抽抓匀腌十五分钟入味。",
      "time_min": 18,
      "heat": "无火",
      "tip": "腌到位才能干煸时不出水，也让鸡肉不柴。",
      "visual_cue": "鸡条均匀，表面润泽无汁水。"
    },
    {
      "n": 2,
      "text": "干辣椒剪成短节，抖掉大部分辣椒籽，花椒挑去黑籽，芹菜与大葱切段备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "辣椒籽去大半，成菜才香辣不燥。",
      "visual_cue": "辣椒节长短一致，籽量不多。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到六成热，下鸡条中火摊开煎到一面金黄，再翻面继续煸炒。",
      "time_min": 8,
      "heat": "中火",
      "tip": "先别急着翻，等一面定型再翻才不粘不碎。",
      "visual_cue": "鸡条表面金黄起壳，锅底少油。"
    },
    {
      "n": 4,
      "text": "转小火持续煸炒到鸡条水分收干、表面干香起皱，盛出多余的油。",
      "time_min": 6,
      "heat": "小火",
      "tip": "干煸的关键是耐心小火，把水分慢慢煸出去。",
      "visual_cue": "鸡条干香紧实，无汁水渗出。"
    },
    {
      "n": 5,
      "text": "锅中留少许底油，下干辣椒节和花椒小火炒香，再下姜丝、葱段炒出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒花椒要小火慢炒，一焦就整锅发苦。",
      "visual_cue": "辣椒转深红，花椒出麻香。"
    },
    {
      "n": 6,
      "text": "倒回鸡条转中火翻炒，加白糖和少许盐调味，下芹菜段炒到断生。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芹菜只炒到断生，脆感才在，久了发黄出水。",
      "visual_cue": "芹菜翠绿断生，鸡条均匀裹料。"
    },
    {
      "n": 7,
      "text": "起锅装盘，撒上熟白芝麻，趁热食用，凉了香气会散。",
      "time_min": 2,
      "heat": "无火",
      "tip": "白芝麻最后撒，久炒会发苦也会掉色。",
      "visual_cue": "鸡条干香红亮，芝麻点点。"
    }
  ],
  "tips": [
    "选鸡腿肉，脂肪适中，煸出来不干不柴。",
    "全程分两段火：中火煎香，小火煸干。",
    "芹菜只取梗，叶子下锅容易发苦发黑。"
  ],
  "common_mistakes": [
    "鸡条不腌直接煸，出水多，煸不出干香。",
    "一直大火猛炒，外面焦了里面还是生的。",
    "辣椒花椒炒糊，整盘菜带焦苦味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "500克:450克",
      "note": "鸡胸肉更干，腌时加一勺油锁水，煸的时间缩短两分钟。"
    },
    {
      "original": "芹菜",
      "substitute": "莴笋",
      "ratio": "60克:60克",
      "note": "莴笋切条口感更脆，需提前用盐腌两分钟去水。"
    }
  ],
  "variations": [
    "有的做法加一把炸花生同炒，酥脆解辣。",
    "川南版会把鸡条先过油再煸，成品更干香但更油腻。"
  ],
  "serving_suggestion": "装盘撒芝麻，配啤酒或白饭；凉了可回锅小火复煸一分钟。",
  "storage": "冷藏可存两日，回锅小火干煸一分钟回香，勿加水复热。",
