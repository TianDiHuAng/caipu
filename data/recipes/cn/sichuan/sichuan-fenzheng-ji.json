  "equipment": [
    "蒸锅",
    "竹蒸笼",
    "刀",
    "砧板",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉斩成四厘米见方的块，冷水下锅加料酒和葱段，水开后煮三分钟焯净血沫捞出。",
      "time_min": 10,
      "heat": "大火",
      "tip": "鸡腿肉腥味重，焯水要彻底，浮沫撇干净。",
      "visual_cue": "鸡块紧实，汤面无灰沫。"
    },
    {
      "n": 2,
      "text": "米粉放干锅小火炒到微黄出香，倒出摊凉后用擀面杖擀成粗颗粒状。",
      "time_min": 10,
      "heat": "小火",
      "tip": "米粉炒过再蒸才香，颗粒别太细，太细会糊成团。",
      "visual_cue": "米粉微黄，颗粒均匀如粗砂。"
    },
    {
      "n": 3,
      "text": "鸡块加豆瓣酱、姜末、花椒粉、生抽、盐、白糖、料酒抓匀腌二十分钟入味。",
      "time_min": 22,
      "heat": "无火",
      "tip": "腌的时间要够，鸡肉紧实，不入味就发柴。",
      "visual_cue": "鸡块均匀裹上酱料，颜色发红。"
    },
    {
      "n": 4,
      "text": "把炒好的米粉分次拌进鸡块，加植物油和清水抓匀，让每块鸡肉都裹上粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水要分次加，粉太干蒸不熟，太湿会结块。",
      "visual_cue": "鸡块表面挂上均匀的粗粉，湿润不滴。"
    },
    {
      "n": 5,
      "text": "芋头块铺在竹蒸笼底部，鸡块带皮朝上码在上面，不要压太紧，留出蒸汽通道。",
      "time_min": 5,
      "heat": "无火",
      "tip": "码太密蒸汽上不来，底下的芋头会夹生。",
      "visual_cue": "鸡块整齐码放，芋头垫底铺平。"
    },
    {
      "n": 6,
      "text": "蒸锅水开后放入蒸笼，大火蒸十分钟转中火再蒸五十分钟，到鸡肉酥软脱骨。",
      "time_min": 60,
      "heat": "中火",
      "tip": "中途别开盖，蒸汽一泄时间就不够了。",
      "visual_cue": "鸡肉酥软，筷子能轻松插入。"
    },
    {
      "n": 7,
      "text": "取出蒸笼撒葱花，原笼上桌，连芋头一起舀出食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "底下的芋头吸满鸡油与酱汁，别浪费。",
      "visual_cue": "鸡块红亮油润，芋头软糯入味。"
    }
  ],
  "tips": [
    "选带皮鸡腿肉，肉紧带香，长蒸后也不发柴。",
    "米粉自己炒自己擀，比买现成的香得多。",
    "蒸的时候火要足，中途不开盖是成败关键。"
  ],
  "common_mistakes": [
    "米粉直接拌不炒，蒸出来只有生米味。",
    "拌粉时一次加足水，粉结团，鸡肉裹不匀。",
    "蒸的时间不够，鸡肉咬不动，芋头也夹生。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡腿肉",
      "ratio": "800克:800克",
      "note": "换成鸡腿肉即粉蒸鸡，蒸的时间缩短至三十五分钟。"
    },
    {
      "original": "芋头",
      "substitute": "莴笋",
      "ratio": "300克:300克",
      "note": "垫底换成莴笋更清爽，但吸油少，需多淋一勺酱汁。"
    }
  ],
  "variations": [
    "有的做法在粉里加少许五香粉与干辣椒粉，香气更复合。",
    "川南一带会用荷叶垫底同蒸，多一股清香。"
  ],
  "serving_suggestion": "原笼上桌撒葱花，配白饭与一碗清汤；鸡肉蘸蒸出的汤汁最香。",
  "storage": "冷藏可存两日，复热上锅再蒸十分钟；不建议冷冻，芋头会变硬出水。",
