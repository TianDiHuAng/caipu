  "equipment": [
    "炒锅",
    "锅铲",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉切成一点五厘米见方的丁，加十毫升生抽与料酒抓匀腌十五分钟。",
      "time_min": 16,
      "heat": "无火",
      "tip": "丁要切得大小一致，成熟才齐。",
      "visual_cue": "鸡丁表面微黏、色泽转深"
    },
    {
      "n": 2,
      "text": "青椒与尖椒去蒂切丁，生姜切末、大蒜切片，分开放置。",
      "time_min": 4,
      "heat": "无火",
      "tip": "两种椒分开下锅，香气层次才分明。",
      "visual_cue": "椒丁干爽不流水、切面平整"
    },
    {
      "n": 3,
      "text": "炒锅烧热下四十毫升植物油，油温五成热时倒入鸡丁摊平煎两分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先煎定型再翻动，鸡丁才不会出水。",
      "visual_cue": "底面金黄、能整片推动"
    },
    {
      "n": 4,
      "text": "翻面继续煎一分钟至表面微焦，盛出装盘备用。",
      "time_min": 2,
      "heat": "中火",
      "tip": "表面煎出焦边，成菜才有干香。",
      "visual_cue": "鸡丁边缘焦黄、不见血色"
    },
    {
      "n": 5,
      "text": "锅留二十毫升底油下姜末与蒜片炒香，放青椒与尖椒大火炒四十秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "椒丁炒到断生就够，久了发黄。",
      "visual_cue": "椒丁翠绿、香气窜出"
    },
    {
      "n": 6,
      "text": "倒回鸡丁，加五毫升生抽、盐与白糖翻炒三十秒，起锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "白糖只提鲜，尝不出甜味才对。",
      "visual_cue": "鸡丁干爽油亮、盘底不见汤汁"
    }
  ],
  "tips": [
    "鸡肉选带皮的腿肉，煎出来才够香。",
    "腌鸡丁时不要加粉浆，否则煎不出焦边。",
    "分两次下锅煎，锅温不掉，鸡丁才干香。"
  ],
  "common_mistakes": [
    "鸡丁切得大小不一，小的焦了大的还带生。",
    "下锅后马上翻炒，鸡肉出水变成水煮鸡丁。",
    "椒丁炒过了头，颜色发黄口感发软。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "500g 对 500g",
      "note": "更嫩但易柴，煎制时间缩短半分钟。"
    },
    {
      "original": "尖椒",
      "substitute": "青椒",
      "ratio": "30g 对 40g",
      "note": "辣度大减，适合不吃辣的人。"
    }
  ],
  "variations": [
    "喜欢吃辣的可以在炒姜蒜时多加十克尖椒，辣度更足。",
    "把鸡丁换成鸡翅中同法煎制，啃着吃更过瘾。"
  ],
  "serving_suggestion": "趁热配米饭吃，鸡丁干香最适合下饭。",
  "storage": "冷藏可放一天，复热时用炒锅回锅，别用微波炉。",
