  "equipment": [
    "炒锅",
    "漏勺",
    "刀",
    "砧板",
    "深盘",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成三厘米长、两厘米宽的长方块，放在厨房纸上吸干表面水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面必须吸干，带水下油锅会爆油，也炸不鼓。",
      "visual_cue": "豆腐块表面干爽，无渗水。"
    },
    {
      "n": 2,
      "text": "植物油烧到一百六十度下豆腐块，中火炸到表皮金黄、内部鼓胀如口袋后捞出。",
      "time_min": 8,
      "heat": "中火",
      "tip": "炸到外壳鼓起才形成空心，这是口袋的关键。",
      "visual_cue": "豆腐块鼓胀漂浮，外壳金黄。"
    },
    {
      "n": 3,
      "text": "炸好的豆腐晾到不烫手，用刀在一端划开小口，掏出内部多余的嫩瓤，留壳备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "掏瓤要轻，壳薄易破，掏出后用勺背压平内壁。",
      "visual_cue": "豆腐壳空心完整，边缘不破。"
    },
    {
      "n": 4,
      "text": "猪肉末加香菇末、姜末、蛋清、生抽、料酒、盐、白胡椒和淀粉，顺一个方向搅到发黏。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅到肉馅起胶才抱团，蒸后不散、口感弹。",
      "visual_cue": "肉馅粘稠发亮，筷子挑得起整团。"
    },
    {
      "n": 5,
      "text": "用小勺把肉馅填进口袋豆腐里，八分满即可，填好后开口朝上摆进深盘。",
      "time_min": 6,
      "heat": "无火",
      "tip": "填八分满留膨胀余地，塞太满蒸时会撑破。",
      "visual_cue": "豆腐口袋饱满，表面平整。"
    },
    {
      "n": 6,
      "text": "深盘加清水和少许生抽，上汽后中火蒸十分钟，取出把盘底汤汁倒进炒锅。",
      "time_min": 12,
      "heat": "中火",
      "tip": "蒸出的汤汁是鲜味精华，别倒掉，用来勾芡正好。",
      "visual_cue": "豆腐口袋鼓胀，肉馅凝固变色。"
    },
    {
      "n": 7,
      "text": "汤汁烧开后加盐调味，淋水淀粉勾薄芡，浇在豆腐上撒葱花即成。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芡要薄亮，浇上去能挂住豆腐又不糊口。",
      "visual_cue": "芡汁透亮，豆腐口袋完整饱满。"
    }
  ],
  "tips": [
    "豆腐选老一点的北豆腐，水分少才炸得鼓。",
    "油温一百六十度最稳，低了不鼓，高了外焦内生。",
    "肉馅搅上劲再填，蒸出来才成团不散。"
  ],
  "common_mistakes": [
    "豆腐不吸干水分就下锅，油花四溅还炸不鼓。",
    "开口划得太大，填馅时壳整个裂开。",
    "肉馅塞满，蒸后把口袋撑破，卖相全毁。"
  ],
  "substitutions": [
    {
      "original": "猪肉末",
      "substitute": "虾仁",
      "ratio": "150克:180克",
      "note": "换成剁碎的虾仁即海鲜口袋豆腐，鲜味更清。"
    },
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "40克:30克",
      "note": "木耳切细末口感更脆，需剁得比香菇更细。"
    }
  ],
  "variations": [
    "有的做法不蒸而用高汤小火煨十分钟，豆腐更入味更软。",
    "宴席版会把口袋豆腐用上汤煨透再勾芡，汤汁更浓。"
  ],
  "serving_suggestion": "连汁装盘，一人两个，配清汤与白饭；咬开先吸汤汁再吃肉馅。",
  "storage": "冷藏可存两日，复热加少量高汤蒸五分钟；炸好的豆腐壳可冷冻存一周。",
