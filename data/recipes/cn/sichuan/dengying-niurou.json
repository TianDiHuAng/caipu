    "炒锅",
    "刀",
    "砧板",
    "保鲜膜",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腱子整块冷水浸泡一小时去血水，冷水下锅加料酒，大火烧开后转中小火煮四十分钟，捞出晾凉。",
      "time_min": 45,
      "heat": "大火",
      "tip": "煮到筷子能扎透即可，煮过头肉会散，切不出完整的薄片。",
      "visual_cue": "牛腱子紧实有弹性，表面无血水渗出。"
    },
    {
      "n": 2,
      "text": "晾凉的牛腱子顺纹理撕去表面筋膜，切成两毫米厚的大片，再用擀面杖轻轻擀到透光薄。",
      "time_min": 12,
      "heat": "无火",
      "tip": "半冻状态最好切，擀的时候垫保鲜膜，受力均匀不易破。",
      "visual_cue": "肉片薄到能透出灯光，边缘完整不碎。"
    },
    {
      "n": 3,
      "text": "肉片铺在竹筛上，放通风处晾两小时，表面收干微微发硬。",
      "time_min": 8,
      "heat": "无火",
      "tip": "晾得越干，炸后越脆；阴雨天可用烤箱五十度低温风干。",
      "visual_cue": "肉片干爽挺括，按压不回弹。"
    },
    {
      "n": 4,
      "text": "炒锅放植物油烧到六成热，下肉片中小火炸到深红发脆，捞出沥油。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "肉片下锅会立刻卷曲，一次别放太多，油温掉了就炸不透。",
      "visual_cue": "肉片深红透亮，敲击有脆响。"
    },
    {
      "n": 5,
      "text": "锅留底油，下辣椒面、花椒粉和五香粉小火炒出红油，加盐和白糖炒匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒面下锅就关小火，几秒钟就出香，慢一点就发黑变苦。",
      "visual_cue": "红油鲜亮，香料味冲鼻。"
    },
    {
      "n": 6,
      "text": "炸好的肉片趁热倒入锅中翻拌，让每片都裹上红油香料，撒熟白芝麻，晾凉后密封存放。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热拌油才挂得住，凉了油就凝不住，口感发干。",
      "visual_cue": "肉片油润红亮，芝麻均匀粘附。"
    }
  ],
  "tips": [
    "肉片擀得越薄，成菜越有灯影透光的脆感。",
    "炸制要分批下锅，油温才稳得住不发软。",
    "拌好的肉片晾凉密封，能脆上两三天。"
  ],
  "common_mistakes": [
    "牛肉煮得太烂，切片时直接碎成渣。",
    "肉片没晾干就下锅，油花四溅还炸不脆。",
    "辣椒面下锅火太大，整锅红油发黑带苦。"
  ],
  "substitutions": [
    {
      "original": "牛腱子",
      "substitute": "牛里脊",
      "ratio": "600克:550克",
      "note": "里脊筋膜少更易切薄片，但脂肪少，炸制时间要缩短一分钟。"
    },
    {
      "original": "辣椒面",
      "substitute": "辣椒油",
      "ratio": "10克:30毫升",
      "note": "用辣椒油可省去炒香料的步骤，直接趁热拌匀即可。"
    }
  ],
  "variations": [
    "达州老做法会把肉片夹在竹篾间烘烤，比油炸更干香。",
    "有的版本在红油里加少许冰糖粉，甜味更立体。"
  ],
  "serving_suggestion": "晾凉后装小碟，配一小杯白酒或作为冷盘拼盘的一角，越嚼越香。",
  "storage": "密封罐常温可存一周，受潮后可用烤箱一百二十度回脆三分钟；冷藏会返潮，不建议冷藏。",
