  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "砂锅",
    "棉线"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腱子冷水浸泡两小时，中途换两次水，泡到肉色发白后用棉线顺着长条捆紧。",
      "time_min": 15,
      "heat": "无火",
      "tip": "捆紧能让卤好的牛腱子切开纹路整齐，切片不散。",
      "visual_cue": "牛腱子表面发白，捆线勒出浅窝。"
    },
    {
      "n": 2,
      "text": "汤锅加水烧开，放入牛腱焯五分钟，撇净浮沫后捞出，用温水冲洗表面杂质。",
      "time_min": 8,
      "heat": "大火",
      "tip": "用温水冲洗，冷水一激牛腱子紧缩，后面很难卤透。",
      "visual_cue": "牛腱子表面清爽无浮沫挂壁。"
    },
    {
      "n": 3,
      "text": "八角、桂皮、香叶和花椒装进料包，与姜片、葱结一起放入砂锅，加清水、生抽、料酒和冰糖。",
      "time_min": 5,
      "heat": "中火",
      "tip": "香料装包才不会粘在肉上，吃起来也干净。",
      "visual_cue": "汤色浅褐，香料浮沉均匀。"
    },
    {
      "n": 4,
      "text": "放入牛腱大火烧开，转小火加盖卤六十分钟，保持汤面微微冒泡。",
      "time_min": 60,
      "heat": "小火",
      "tip": "全程小火，滚沸会让牛腱子纤维松散、切片发碎。",
      "visual_cue": "筷子能扎透但仍有阻力，肉香沉厚。"
    },
    {
      "n": 5,
      "text": "加盐调味，再小火卤十五分钟让咸味渗入，关火后在原汤里浸泡两小时。",
      "time_min": 18,
      "heat": "小火",
      "tip": "盐要后放，早放肉会紧；浸泡比久煮更能入味。",
      "visual_cue": "汤面平静，牛腱子颜色深褐均匀。"
    },
    {
      "n": 6,
      "text": "捞出牛腱子晾到完全凉透，拆去棉线，逆纹切成薄片，码盘后淋一勺原汤即可。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一定要凉透再切，热切必碎；刀口斜着下，片大而薄。",
      "visual_cue": "切面纹理细密，片形完整不散。"
    }
  ],
  "tips": [
    "牛腱要选筋膜分布均匀的金钱腱，切片最好看。",
    "卤汤可留作老卤，滤净冷冻能反复使用。",
    "凉透再切是成形关键，急冻十分钟更好切。"
  ],
  "common_mistakes": [
    "全程大火卤制，牛肉外烂内硬还发柴。",
    "热的时候切片，肉片全部碎散不成形。",
    "盐和生抽早早下重，肉紧不入味还发咸。"
  ],
  "substitutions": [
    {
      "original": "牛腱子",
      "substitute": "牛腩",
      "ratio": "800克:800克",
      "note": "牛腩脂肪多，卤好后口感更润，但切片易散，适合切块装盘。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "15克:12克",
      "note": "白糖上色更快，需注意火候，容易炒出焦味。"
    }
  ],
  "variations": [
    "川西做法会在料包里加一小块陈皮，去腻提香。",
    "有的家庭卤好后用纱布包紧压重物过夜，切片更像市售卤牛肉。"
  ],
  "serving_suggestion": "切薄片码成扇形，淋原汤或蘸干辣椒面，配白饭、拌面或当冷盘都合适。",
  "storage": "冷藏可存三日，原汤浸泡保存更润；冷冻可存一个月，解冻后切薄片即可。",
