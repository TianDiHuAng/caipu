  "steps": [
    {
      "n": 1,
      "text": "米饭用手抓散成粒，胡萝卜切成五毫米小丁，玉米粒和胡萝卜丁分别焯水一分钟捞出沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "配菜先焯熟，炒的时候才不会生硬。",
      "visual_cue": "胡萝卜丁微软，玉米粒饱满金黄。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加盐和白胡椒粉搅匀，炒锅放三十毫升植物油烧到六成热，倒蛋液炒散成块盛出。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蛋液下锅先别动，等底部凝住再划散，块才蓬松。",
      "visual_cue": "蛋块金黄嫩滑，边缘微焦。"
    },
    {
      "n": 3,
      "text": "锅内补十五毫升植物油，下胡萝卜丁和玉米粒中火翻炒一分钟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "配菜炒出水分再下饭，饭粒才不会返潮。",
      "visual_cue": "配菜表面油亮，香气升起。"
    },
    {
      "n": 4,
      "text": "倒入米饭大火翻炒压散，炒到米粒跳动、颗颗分明，倒回蛋块。",
      "time_min": 2,
      "heat": "大火",
      "tip": "大火快炒，米粒才有锅气和焦香。",
      "visual_cue": "米饭粒粒跳动，蓬松不粘。"
    },
    {
      "n": 5,
      "text": "淋生抽快速翻匀，撒葱花，尝味后补盐即可出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "生抽沿锅边淋，酱香更足且不使米粒发黏。",
      "visual_cue": "饭粒油润分明，葱花翠绿。"
    }
  ],
  "tips": [
    "冷饭抓散再下锅，是粒粒分明的关键。",
    "配菜先焯熟，避免生硬抢掉饭香。",
    "全程大火快炒，锅气足了饭才够香。"
  ],
  "common_mistakes": [
    "热饭直接下锅，最后炒成一团黏饭。",
    "蛋液和米饭一起下，蛋老饭湿没口感。",
    "火小油少，米饭粘锅还炒出焦黑。"
  ],
  "substitutions": [
    {
      "original": "玉米粒",
      "substitute": "豌豆",
      "ratio": "50克:50克",
      "note": "豌豆需多焯一分钟，口感更粉甜。"
    },
    {
      "original": "鸡蛋",
      "substitute": "咸蛋黄",
      "ratio": "3个:2个",
      "note": "咸蛋黄压碎炒散，沙沙的口感更香，盐需减到一克。"
    }
  ],
  "variations": [
    "加一小把火腿丁或虾仁，升级成什锦炒饭。",
    "出锅前撒一勺辣椒面同炒，川味更冲。",
    "有的家庭用猪油代替植物油，香气浓一倍。"
  ],
  "serving_suggestion": "趁热盛碗，配番茄蛋汤或紫菜汤，简单又满足。",
  "storage": "冷藏可存一日，回锅大火翻炒一分钟即可；不建议微波加热，饭粒会返潮。",
