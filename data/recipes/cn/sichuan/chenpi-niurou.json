  "steps": [
    {
      "n": 1,
      "text": "牛肉切成三厘米见方的块，冷水下锅加料酒和姜片，大火烧开撇净血沫，煮三分钟捞出冲洗干净。",
      "time_min": 12,
      "heat": "大火",
      "tip": "冷水下锅才能把血水慢慢逼出来，热水下锅肉一紧血沫就锁在里面。",
      "visual_cue": "牛肉表面灰白，汤面浮沫撇净。"
    },
    {
      "n": 2,
      "text": "陈皮用温水泡十分钟，泡软后刮掉内侧白瓤，切成细丝，泡陈皮的水留着备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "白瓤不刮会带苦味，年份久的陈皮香味更沉，用量可减半。",
      "visual_cue": "陈皮丝柔韧，水色呈浅琥珀。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到五成热，下牛肉块中火煸炒到表面收紧微黄、锅底见油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "牛肉先煸后烧，表面定型才不散，汤也更香浓。",
      "visual_cue": "肉块边缘焦黄，锅内油脂清亮。"
    },
    {
      "n": 4,
      "text": "下干辣椒节、花椒、姜片和陈皮丝，小火炒出香味，再加入生抽和白糖翻匀上色。",
      "time_min": 4,
      "heat": "小火",
      "tip": "陈皮与辣椒一起下锅，香味才融进油里，火大易糊。",
      "visual_cue": "油色转深红，陈皮香气明显。"
    },
    {
      "n": 5,
      "text": "倒入泡陈皮的水和清水没过牛肉，放葱结，大火烧开转小火加盖炖三十五分钟。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢炖，汤面只冒小泡，牛肉才酥而不柴。",
      "visual_cue": "筷子能扎透牛肉但仍带阻力。"
    },
    {
      "n": 6,
      "text": "开盖加盐调味，转中火收汁到汤汁浓稠裹住肉块，拣去葱结和姜片，晾凉后装盘。",
      "time_min": 8,
      "heat": "中火",
      "tip": "收汁时勤翻动，糖分容易粘底发焦；晾凉后风味更凝练。",
      "visual_cue": "汤汁红亮挂肉，盘底不见游离水分。"
    }
  ],
  "tips": [
    "陈皮年份越久香气越沉，三年以上的放五克就够。",
    "牛肉选带筋的部位，炖后有胶质感。",
    "晾凉再吃，陈皮的甘香会更清楚突出。"
  ],
  "common_mistakes": [
    "陈皮白瓤没刮，整锅带明显苦味。",
    "大火猛炖，牛肉外表烂了里面还是硬的。",
    "收汁时走开，糖分烧焦整锅发苦。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛腱子",
      "ratio": "600克:600克",
      "note": "牛腱筋膜多，炖的时间延长十分钟，切片后纹路更好看。"
    },
    {
      "original": "陈皮",
      "substitute": "鲜橘皮",
      "ratio": "10克:15克",
      "note": "鲜橘皮香气浮，需先用盐水泡十分钟去涩，用量略增。"
    }
  ],
  "variations": [
    "有的做法把牛肉先炸到表皮干香再烧，口感更接近牛肉干。",
    "成都冷碟版会收得更干，晾凉后当零食下酒。"
  ],
  "serving_suggestion": "晾凉后切厚片码盘，淋少许原汁，配白饭或当作下酒冷碟都合适。",
  "storage": "冷藏可存三日，原汁浸泡更入味；复热时加少量清水小火煨开，不要微波高火久打。",
