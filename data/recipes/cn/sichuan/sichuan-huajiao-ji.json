  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉去骨切成两厘米见方的丁，加盐、料酒、生抽和玉米淀粉抓匀上浆十分钟。",
      "time_min": 14,
      "heat": "无火",
      "tip": "上浆能让鸡丁滑嫩不老，淀粉薄薄一层就够。",
      "visual_cue": "鸡丁表面均匀挂浆，微微发亮。"
    },
    {
      "n": 2,
      "text": "花椒分成两份，一份用小火干焙后碾成粉，另一份留作整粒炒香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "焙过的花椒粉麻香更纯，出锅前撒效果最好。",
      "visual_cue": "花椒壳脆，研磨成棕褐粉末。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到五成热，下鸡丁中火滑炒到变白断生成形，盛出沥油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "滑到变白就盛出，后面还要回锅炒，别炒老。",
      "visual_cue": "鸡丁变白定型，表面挂浆光滑。"
    },
    {
      "n": 4,
      "text": "锅中留底油，下整粒花椒小火炒到出麻香，再加泡椒段和姜片炒出酸辣香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "花椒小火慢炒才出麻不苦，油冒烟就晚了。",
      "visual_cue": "花椒裂口，泡椒红亮出香。"
    },
    {
      "n": 5,
      "text": "下葱段炒香，倒回鸡丁转中火快炒，加白糖和少许盐调味翻匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "回锅要快，鸡丁才嫩，久炒就柴。",
      "visual_cue": "鸡丁裹上红亮油色，葱段翠绿。"
    },
    {
      "n": 6,
      "text": "关火撒入花椒粉翻匀，趁热装盘，麻香会随热气上冲。",
      "time_min": 2,
      "heat": "无火",
      "tip": "花椒粉关火后撒，遇高温久炒会发苦。",
      "visual_cue": "鸡丁红亮，表面均匀挂花椒粉。"
    }
  ],
  "tips": [
    "花椒分两次用，整粒炒出麻香，粉末收尾提麻。",
    "鸡腿肉比鸡胸肉更嫩，去骨后切丁大小要一致。",
    "泡椒是这道菜的酸辣底，泡椒汁可以留一勺同炒。"
  ],
  "common_mistakes": [
    "花椒一次全下锅久炒，麻味散尽只剩焦苦。",
    "鸡丁不上浆直接炒，口感发柴不滑嫩。",
    "鸡丁回锅后久炒，水分流失变成鸡米干。"
  ],
  "substitutions": [
    {
      "original": "花椒",
      "substitute": "香油",
      "ratio": "20克:20毫升",
      "note": "怕麻可用花椒油替代整粒炒制，麻味更淡，香气也柔。"
    },
    {
      "original": "泡椒",
      "substitute": "豆瓣酱",
      "ratio": "30克:25克",
      "note": "换豆瓣酱风味转为酱香辣，酸味需另加香醋五毫升补足。"
    }
  ],
  "variations": [
    "汉源一带的做法只用鲜花椒，麻香清冽，成菜带一股青草气。",
    "加一把青花椒即成藤椒鸡，麻味更凉更清。"
  ],
  "serving_suggestion": "装盘趁热吃，配白饭与冰啤酒；麻味重时可配一口甜饮料缓解。",
  "storage": "冷藏可存一日，回锅小火干炒一分钟；不建议冷冻，鸡丁会出水。",
