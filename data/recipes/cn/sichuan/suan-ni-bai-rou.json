  "equipment": [
    "汤锅",
    "快刀",
    "小碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加姜片、葱段、料酒与 4g 盐，大火烧开撇净浮沫。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅，血水才能慢慢逼出。",
      "visual_cue": "水面浮沫撇净、汤色转清"
    },
    {
      "n": 2,
      "text": "转小火浸煮 30 分钟，煮到筷子能轻松扎透肉皮。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火保持微沸，肉才不散不柴。",
      "visual_cue": "筷子一扎就进、肉皮软弹"
    },
    {
      "n": 3,
      "text": "肉捞出放凉至不烫手，用重物压 20 分钟压平形状。",
      "time_min": 21,
      "heat": "无火",
      "tip": "压过的肉切出来平整，片薄好看。",
      "visual_cue": "肉块方正紧实、厚度均匀"
    },
    {
      "n": 4,
      "text": "黄瓜切细丝铺在盘底；大蒜捣成泥，加生抽、白糖、香醋与辣椒油调成蒜泥红油汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蒜要捣成泥，蒜香才浓不发辣。",
      "visual_cue": "汁液红亮、蒜香冲鼻"
    },
    {
      "n": 5,
      "text": "五花肉切成 0.15cm 的薄片，整齐叠在黄瓜丝上。",
      "time_min": 6,
      "heat": "无火",
      "tip": "刀要薄锋利，肉凉透再切才不碎。",
      "visual_cue": "肉片透光、肥瘦分层清晰"
    },
    {
      "n": 6,
      "text": "把蒜泥红油汁均匀淋在肉片上，撒小葱花即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "淋汁前再切蒜，蒜香才鲜活。",
      "visual_cue": "红油顺着肉片流下、葱花点缀"
    }
  ],
  "tips": [
    "肉煮好要用重物压平，切片才整齐。",
    "蒜必须捣成泥，刀切的蒜香出不来。",
    "肉片凉透再切，热切一定碎。，会影响最终的口感层次与卖相。"
  ],
  "common_mistakes": [
    "大火滚煮，五花肉散成几块。，成品口感会明显变差。",
    "肉趁热切片，片厚且边缘毛糙。，成品口感会明显变差。",
    "蒜末切得太粗，蒜味辛辣刺口。，成品口感会明显变差。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "后腿肉",
      "ratio": "500g 对 450g",
      "note": "脂肪少，煮的时间减 5 分钟。"
    },
    {
      "original": "黄瓜",
      "substitute": "绿豆芽",
      "ratio": "150g 对 150g",
      "note": "需焯水过凉再垫底。"
    }
  ],
  "variations": [
    "卷饼版：肉片配薄饼卷黄瓜丝吃。",
    "加麻版：辣椒油中加 10ml 藤椒油，麻香更足。"
  ],
  "serving_suggestion": "冷食最佳，夹一片黄瓜丝同吃解腻。",
  "storage": "冷藏 1 天，肉片与料汁分开存放。",
