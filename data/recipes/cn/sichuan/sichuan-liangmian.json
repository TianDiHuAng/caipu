  "steps": [
    {
      "n": 1,
      "text": "面条抖散备用；绿豆芽入沸水氽 40 秒捞出过凉，沥干铺在碗底。",
      "time_min": 5,
      "heat": "大火",
      "tip": "豆芽断生即可，久煮会软塌。",
      "visual_cue": "豆芽透亮挺立、无豆腥味"
    },
    {
      "n": 2,
      "text": "锅中加 2000ml 水与 4g 盐，大火烧开后下面条，用筷子拨散煮 2 分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "水要宽，面才不粘连。",
      "visual_cue": "面条浮起、中心留一点白芯"
    },
    {
      "n": 3,
      "text": "面条捞出后立即摊在大盆里，淋 15ml 香油用筷子挑散，对着风扇吹 3 分钟至微凉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "边吹边挑，面条才有弹牙的筋道感。",
      "visual_cue": "面条根根分明、表面油亮不粘"
    },
    {
      "n": 4,
      "text": "大蒜 15g 加 20ml 凉开水泡成蒜水；生抽、香醋、白糖与花椒粉调成味汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜水比蒜末更均匀，辣味也更柔和。",
      "visual_cue": "味汁呈深褐色、无糖粒沉淀"
    },
    {
      "n": 5,
      "text": "凉面铺在豆芽上，浇味汁与蒜水，淋 40ml 辣椒油，撒熟花生碎与小葱花。",
      "time_min": 3,
      "heat": "无火",
      "tip": "辣椒油连辣椒面一起舀，香气才足。",
      "visual_cue": "面条裹上红亮油光、花生碎铺满"
    },
    {
      "n": 6,
      "text": "上桌前沿碗边补 10ml 香醋，吃前从底部翻拌均匀即可。",
      "time_min": 2,
      "heat": "无火",
      "tip": "尾醋最后加，酸香更清爽。",
      "visual_cue": "拌开后红油挂面、气味冲鼻"
    }
  ],
  "tips": [
    "面条煮好吹凉是凉面弹牙的关键，不能过冷水。",
    "花椒粉要现磨，瓶装的麻香几乎散尽。",
    "辣椒油与香醋分两次放，层次更分明。"
  ],
  "common_mistakes": [
    "面条煮好直接过冷水，表面淀粉被冲掉，拌不开还发硬。",
    "一次把醋全倒进去，久放后面条发酸发涩。",
    "豆芽煮过头，出水让碗底积汤冲淡味道。"
  ],
  "substitutions": [
    {
      "original": "面条",
      "substitute": "荞麦面",
      "ratio": "400g 对 380g",
      "note": "升糖更低，煮的时间多 1 分钟。"
    },
    {
      "original": "绿豆芽",
      "substitute": "黄瓜",
      "ratio": "150g 对 1 根",
      "note": "切丝铺底，口感更清脆。"
    }
  ],
  "variations": [
    "甜水面版：改用粗面条，味汁加 10g 红糖。",
    "鸡丝版：加 150g 手撕鸡胸肉，蛋白质更足。"
  ],
  "serving_suggestion": "盛碗后立刻拌开吃，配一碗冰镇绿豆汤最解辣。",
  "storage": "冷藏不超过 12 小时，面条与味汁分开存放。",
