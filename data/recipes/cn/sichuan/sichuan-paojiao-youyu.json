  "steps": [
    {
      "n": 1,
      "text": "鱿鱼去掉表皮薄膜和软骨，切成五厘米长的块，在内侧打十字花刀，深至三分之二不切断。",
      "time_min": 10,
      "heat": "无火",
      "tip": "花刀打在鱿鱼内侧，受热才卷成漂亮的麦穗形。",
      "visual_cue": "鱿鱼表面网格均匀，深而不透。"
    },
    {
      "n": 2,
      "text": "锅中烧开水，加料酒和两片姜，下鱿鱼快速焯十五秒立即捞出过凉水。",
      "time_min": 4,
      "heat": "大火",
      "tip": "焯水只为定型去腥，时间一长鱿鱼就变橡皮。",
      "visual_cue": "鱿鱼卷曲成花，色泽转白。"
    },
    {
      "n": 3,
      "text": "泡椒切圈，芹菜切段，大蒜切片，姜切丝，全部备好放在一旁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "泡椒连一点泡椒水一起下锅，酸香更浓。",
      "visual_cue": "配料分堆摆好，泡椒红亮。"
    },
    {
      "n": 4,
      "text": "炒锅烧热放五十毫升植物油，下姜丝蒜片和泡椒小火炒出酸香，再放芹菜段大火炒三十秒。",
      "time_min": 3,
      "heat": "小火",
      "tip": "泡椒小火炒香再下芹菜，顺序反了香味出不来。",
      "visual_cue": "锅中红油微亮，芹菜翠绿。"
    },
    {
      "n": 5,
      "text": "倒入焯好的鱿鱼，加生抽、白糖和盐，大火快速翻炒四十秒，卷曲入味立即出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火快炒，超过一分钟鱿鱼就发硬。",
      "visual_cue": "鱿鱼花卷匀称，酱汁裹匀发亮。"
    }
  ],
  "tips": [
    "鱿鱼焯水只十五秒，久了发橡皮。",
    "花刀打在鱿鱼内侧，受热才卷成花。",
    "泡椒先用小火炒出酸香，整道菜的辣味才立体不发闷",
    "鱿鱼下锅前沥干水分，炒出来才香不腥。"
  ],
  "common_mistakes": [
    "鱿鱼不撕表皮薄膜，腥味重还有韧劲。",
    "焯水时间过长，鱿鱼肉质收紧变得像橡皮嚼不动",
    "小火慢炒，鱿鱼出水变硬汤汁发浑。",
    "花刀打在鱿鱼外侧，受热后卷不起来。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "墨鱼仔",
      "ratio": "400克:400克",
      "note": "墨鱼仔肉质更厚嫩，焯水延长到二十秒，炒制时间不变。"
    },
    {
      "original": "芹菜",
      "substitute": "莴笋",
      "ratio": "100克:100克",
      "note": "莴笋切条口感更脆，炒制时间缩短十秒。"
    }
  ],
  "variations": [
    "有的做法加泡姜丝同炒，酸香更地道。",
    "川东家庭会加一勺豆瓣酱，红亮微辣更下饭。"
  ],
  "serving_suggestion": "趁热上桌，鱿鱼花卷、芹菜脆爽，配一碗米饭或一瓶冰啤都合适。",
  "storage": "冷藏可存一日，复热需大火快炒三十秒；久加热鱿鱼会变硬，建议当餐吃完。",
