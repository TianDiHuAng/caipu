  "equipment": [
    "平底锅",
    "炒锅",
    "打蛋盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋 5 个磕入盆中，加 3g 盐与 15ml 清水，用筷子顺一个方向搅打至起细密泡沫。",
      "time_min": 4,
      "heat": "无火",
      "tip": "加水让蛋饼更蓬松柔软。",
      "visual_cue": "蛋液表面浮起细泡、颜色均匀"
    },
    {
      "n": 2,
      "text": "平底锅倒 40ml 植物油烧至六成热，倒入蛋液转中小火，加盖烘 4 分钟至底面金黄膨胀。",
      "time_min": 5,
      "heat": "中小火",
      "tip": "加盖能让表面凝固而底部不焦。",
      "visual_cue": "蛋饼鼓起、边缘微微上卷"
    },
    {
      "n": 3,
      "text": "把蛋饼翻面再烘 2 分钟，取出切成 3cm 方块铺在盘中备用。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "切块比整块更挂汁。",
      "visual_cue": "两面金黄、断面呈蜂窝状"
    },
    {
      "n": 4,
      "text": "炒锅留 20ml 油，下泡椒末、蒜末与姜末，小火炒 2 分钟至红油析出。",
      "time_min": 3,
      "heat": "小火",
      "tip": "泡椒要小火慢炒，红油才红亮不苦。",
      "visual_cue": "油色红艳、香味刺鼻"
    },
    {
      "n": 5,
      "text": "加白糖、生抽与 60ml 清水烧开，倒入水淀粉收成浓芡，关火前倒香醋搅匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "醋最后下，酸香才透。",
      "visual_cue": "芡汁浓稠挂勺、色呈红琥珀"
    },
    {
      "n": 6,
      "text": "把调好的鱼香汁均匀浇在切块的蛋饼上，撒上小葱花即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "浇汁要趁热，蛋块才吸味。",
      "visual_cue": "汁液顺蛋块缝隙流下、葱花翠绿"
    }
  ],
  "tips": [
    "蛋液加水再打，烘出的蛋饼厚而嫩。",
    "泡椒一定要小火炒出红油，否则只有咸辣。",
    "鱼香汁勾芡要比炒菜略稀，才能渗进蛋孔。"
  ],
  "common_mistakes": [
    "蛋液不加水直接烘，成品干硬像煎蛋皮。",
    "泡椒大火爆炒，辣椒瞬间糊掉带苦味。",
    "芡汁勾得太稠，浇上去结块不便食用。"
  ],
  "substitutions": [
    {
      "original": "泡椒",
      "substitute": "郫县豆瓣酱",
      "ratio": "30g 对 25g",
      "note": "颜色更深，糖可减 2g。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "5 个对 4 个",
      "note": "蛋香更浓，烘的时间加 1 分钟。"
    }
  ],
  "variations": [
    "肉末版：加 80g 猪肉末先炒香，再调鱼香汁。",
    "素版：去掉泡椒改番茄 1 个，做成酸甜蛋。"
  ],
  "serving_suggestion": "趁热舀汁拌饭，酸甜微辣最下饭。",
  "storage": "冷藏 1 天，复热用蒸锅蒸 4 分钟保持嫩度。",
