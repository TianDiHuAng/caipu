  "steps": [
    {
      "n": 1,
      "text": "粉丝用温水泡十五分钟到软而不烂，捞出剪成两段，铺在深盘底部垫成一层。",
      "time_min": 15,
      "heat": "无火",
      "tip": "温水泡发粉丝更均匀，热水泡外层糊内里还硬。",
      "visual_cue": "粉丝柔软透明，能绕指不断。"
    },
    {
      "n": 2,
      "text": "虾仁从背部划开两毫米深，挑出背部黑色的肠线，用盐抓洗一遍再冲净沥干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "开背要浅，太深蒸后虾仁会卷成球缩水。",
      "visual_cue": "虾仁展开成片，背部肠线挑净。"
    },
    {
      "n": 3,
      "text": "大蒜一半切末用三十毫升植物油小火炒到微黄，与另一半生蒜末混合，加生抽、蚝油、白糖拌匀成蒜蓉汁。",
      "time_min": 4,
      "heat": "小火",
      "tip": "熟蒜加生蒜各半，香气厚而不冲，这是蒜蓉菜的关键。",
      "visual_cue": "蒜蓉一半金黄一半雪白，汁色微褐。"
    },
    {
      "n": 4,
      "text": "把炒好的蒜蓉汁一半抹在粉丝上，虾仁平铺在粉丝表面，剩余的蒜蓉和汁均匀盖在虾仁上，撒小米辣圈。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉丝先吸汁再摆虾仁，蒸出来底味才足。",
      "visual_cue": "虾仁整齐平铺，蒜蓉覆盖均匀。"
    },
    {
      "n": 5,
      "text": "蒸锅水大开后放入，盖盖大火蒸六分钟，取出撒葱花，再泼二十毫升烧到冒烟的热油激香。",
      "time_min": 6,
      "heat": "大火",
      "tip": "六分钟足够，蒸久了虾仁收紧变硬、粉丝也糊。",
      "visual_cue": "虾仁变红卷曲，蒜蓉金黄浮油。"
    }
  ],
  "tips": [
    "熟蒜配生蒜各半，蒜香层次最足。",
    "粉丝先铺底吸汁，蒸后底味更浓。",
    "水开上锅蒸六分钟，虾仁才不老。",
    "蒜蓉汁里加三克白糖，蒜辛味会柔和下来。",
    "粉丝先用温水泡到软而不烂，蒸后才有嚼劲。"
  ],
  "common_mistakes": [
    "虾仁不开背去线，吃时有土腥味。",
    "蒸过头，虾仁缩成硬球口感发柴。",
    "蒜蓉全用生蒜，辛味冲而且发苦。",
    "粉丝用热水泡发，蒸完就糊成一团结块。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "扇贝肉",
      "ratio": "300克:300克",
      "note": "扇贝肉蒸制时间缩短到五分钟，口感更清甜。"
    },
    {
      "original": "小米辣",
      "substitute": "干辣椒",
      "ratio": "10克:8克",
      "note": "干辣椒香气更沉，辣度略减，可用热油泼香替代。"
    }
  ],
  "variations": [
    "有的家庭在粉丝底下铺一层娃娃菜叶，吸汁更清爽。",
    "川渝馆子常在蒜蓉里加一勺豆瓣红油，麻辣版更下饭。"
  ],
  "serving_suggestion": "连盘上桌，先夹虾仁再拌粉丝，蒜蓉汁淋在饭上一点也不浪费。",
  "storage": "冷藏可存一日，复热需隔水蒸四分钟；虾仁反复加热易发硬，建议当餐吃完。",
