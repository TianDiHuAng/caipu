  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "打蛋碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "韭菜择去老根黄叶，用清水冲净泥沙后彻底沥干，切成三厘米长的段。",
      "time_min": 4,
      "heat": "无火",
      "tip": "韭菜必须沥干，带水下锅会出汤变蔫。",
      "visual_cue": "韭菜段干爽翠绿，根部无泥沙。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加盐和白胡椒粉搅匀，炒锅放三十毫升植物油烧到六成热，倒入蛋液炒成大块盛出。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要够热，蛋液一下锅就膨起来，块才松软。",
      "visual_cue": "蛋块金黄蓬松，表面略起焦边。"
    },
    {
      "n": 3,
      "text": "锅内补十五毫升植物油，下干辣椒节小火炸香，倒入韭菜梗部大火翻炒三十秒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "先炒梗部再放叶片，粗细不同熟得才一致。",
      "visual_cue": "韭菜梗转深绿，香气冲出。"
    },
    {
      "n": 4,
      "text": "放入韭菜叶和蛋块，加生抽快速翻匀，叶片刚软就立即出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程不超过一分钟，多炒一秒韭菜就出水发黄。",
      "visual_cue": "韭菜翠绿油亮，盘底无汤水。"
    }
  ],
  "tips": [
    "窄叶香韭香味浓，宽叶韭菜水多易出汤。",
    "炒韭菜全程大火，快进快出才够香。",
    "蛋块先盛出，回锅只翻两下就起锅。"
  ],
  "common_mistakes": [
    "韭菜没沥干就下锅，炒出一盘汤水。",
    "火太小慢慢炒，韭菜发黄发蔫失香。",
    "鸡蛋和韭菜一起下锅，蛋老韭烂。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "韭黄",
      "ratio": "180克:180克",
      "note": "韭黄辛香柔和、甜味更足，炒制时间再缩短二十秒。"
    },
    {
      "original": "干辣椒",
      "substitute": "小米辣",
      "ratio": "2克:4克",
      "note": "小米辣鲜辣清脆，可与韭菜梗同时下锅。"
    }
  ],
  "variations": [
    "川渝家常会在蛋液里加一勺淀粉水，蛋块更嫩更抱团。",
    "有的做法起锅前淋几滴香醋，韭菜的辛香更突出。"
  ],
  "serving_suggestion": "出锅即食最香，配米饭、拌面或做春卷馅料都合适。",
  "storage": "不建议存放，韭菜炒后极易出水变味，冷藏复热也会发黄，最好当餐吃完。",
