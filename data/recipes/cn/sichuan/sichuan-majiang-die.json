  "steps": [
    {
      "n": 1,
      "text": "芝麻酱倒入碗中，先用勺子压散表面结块的硬层，搅到质地均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "麻酱久放会沉底结硬块，先压散再澥才顺滑。",
      "visual_cue": "麻酱无干硬块，质地一致。"
    },
    {
      "n": 2,
      "text": "分三次加入香油，每次朝同一方向搅到完全吸收，麻酱逐渐变得顺滑流动。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油要慢慢加，一次倒多麻酱会突然结团澥不开。",
      "visual_cue": "麻酱顺滑挂勺，无颗粒。"
    },
    {
      "n": 3,
      "text": "清水分五六次少量加入，边加边搅，直到麻酱变成能缓慢流动的稀糊状。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水分次加是澥麻酱的核心，一次加水必分层。",
      "visual_cue": "酱体细腻流动，滴落成线。"
    },
    {
      "n": 4,
      "text": "加生抽、盐、白糖和味精搅匀，尝味调整咸淡，静置五分钟让味道融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "先尝再加盐，芝麻酱本身含盐量不同，容易过咸。",
      "visual_cue": "酱色浅褐，咸香适口。"
    },
    {
      "n": 5,
      "text": "撒葱花和香菜碎，淋几滴香油，拌火锅涮肉或蘸白肉食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花现撒现吃，放久会出水稀释麻酱。",
      "visual_cue": "葱绿点点，酱面泛油光。"
    }
  ],
  "tips": [
    "选配料表只有芝麻的纯芝麻酱，掺花生酱的香味发闷。",
    "澥麻酱用香油加水双管齐下，比单用水更香更顺。",
    "喜欢麻味可加半勺花椒粉，做成麻香碟。"
  ],
  "common_mistakes": [
    "一次加大量清水，麻酱立刻分层成油水两截。",
    "不压散硬块直接搅，成品带干硬小疙瘩。",
    "盐放太多，芝麻酱本身有底味，很容易过咸。"
  ],
  "substitutions": [
    {
      "original": "芝麻酱",
      "substitute": "花生",
      "ratio": "100克:100克",
      "note": "用花生酱代替需多兑三十毫升清水，另加少许香油提香。"
    },
    {
      "original": "香油",
      "substitute": "植物油",
      "ratio": "1:1",
      "note": "缺香油可用烧熟晾温的植物油澥酱，香气略逊但不影响口感。"
    }
  ],
  "variations": [
    "北方火锅麻酱碟会加腐乳汁和韭菜花，风味更复合。",
    "川式麻酱碟常加一勺红油辣子，变成麻辣麻酱双味碟。"
  ],
  "serving_suggestion": "作火锅蘸碟或白肉蘸料，配蒜泥红油碟一起上，荤素皆宜。",
  "storage": "密封冷藏可存三日，表面会结薄膜，搅匀即可；出现哈喇味立即丢弃。",
