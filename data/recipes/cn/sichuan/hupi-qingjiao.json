  "equipment": [
    "平底锅",
    "锅铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青椒去蒂，用刀面轻拍几下压裂，让椒身稍微扁平。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拍裂更易入味，别拍碎。",
      "visual_cue": "椒身扁平、表面出现裂缝"
    },
    {
      "n": 2,
      "text": "青椒籽与内膜一并刮掉，冲洗干净后彻底擦干表面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水分必须擦干，否则下锅溅油。",
      "visual_cue": "椒身干爽、内腔无籽"
    },
    {
      "n": 3,
      "text": "小碗里放生抽、香醋、白糖、盐与清水调成味汁备用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先调好汁，煎的时候不慌乱。",
      "visual_cue": "味汁均匀、糖盐化开"
    },
    {
      "n": 4,
      "text": "平底锅不放油烧热，青椒下锅小火干煎至起皱出斑。",
      "time_min": 5,
      "heat": "小火",
      "tip": "用锅铲轻压，椒皮才能贴锅起虎皮。",
      "visual_cue": "椒皮起白斑与焦痕、椒身变软"
    },
    {
      "n": 5,
      "text": "把青椒拨到锅边，中间倒植物油烧热后煸香蒜姜末。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油不用多，够煸香料即可。",
      "visual_cue": "蒜末微黄、香气窜鼻"
    },
    {
      "n": 6,
      "text": "下豆瓣酱炒出红油，与青椒一起翻炒让味道裹匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "豆瓣酱要炒透，生豆味才没有。",
      "visual_cue": "锅内见红油、椒身挂酱"
    },
    {
      "n": 7,
      "text": "倒入调好的味汁，中火翻动到汤汁几乎收干即可出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "收汁到椒身挂味就停，别烧糊。",
      "visual_cue": "汤汁浓稠、青椒油亮"
    }
  ],
  "tips": [
    "青椒选皮薄肉厚的螺丝椒，虎皮起得更漂亮。",
    "干煎时勤翻面，避免局部煎糊发苦。",
    "味汁里加半勺蚝油，鲜味会更厚一些。"
  ],
  "common_mistakes": [
    "青椒没擦干就下锅，油一溅满灶台。",
    "一直大火猛煎，皮焦了里面还是生的。",
    "味汁一次倒太多，青椒变成水煮发软。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "尖椒",
      "ratio": "400g 对 300g",
      "note": "辣度更高，用量减两成。"
    },
    {
      "original": "豆瓣酱",
      "substitute": "豆豉",
      "ratio": "10g 对 10g",
      "note": "需剁细，咸度略高。"
    }
  ],
  "variations": [
    "加一勺肉末同炒，鲜味更足更下饭。",
    "出锅前淋几滴香油，香气更立体。"
  ],
  "serving_suggestion": "趁热吃最香，配白粥或米饭都很下饭。",
  "storage": "冷藏可放一天，复热后椒皮会软一些。",
