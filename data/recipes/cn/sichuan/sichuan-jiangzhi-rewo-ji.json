  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉斩成三厘米见方的块，冷水下锅加料酒和姜片，水开后煮两分钟焯去血沫。",
      "time_min": 8,
      "heat": "大火",
      "tip": "焯水要冷水下锅，血沫才逼得干净。",
      "visual_cue": "鸡块紧实，浮沫撇净汤清。"
    },
    {
      "n": 2,
      "text": "姜一半切成细末，一半切片；泡椒切段，豆瓣酱剁细，小葱切葱花备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "姜末要切得极细，才能在汁里均匀散开。",
      "visual_cue": "姜末细如米粒，配料备齐。"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧到五成热，下鸡块中火煸炒到表面微黄、鸡皮出油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "鸡块煸出油再烧，汤更香而不腻。",
      "visual_cue": "鸡块表面金黄，锅底见清油。"
    },
    {
      "n": 4,
      "text": "下豆瓣酱、泡椒和姜片小火炒出红油与酸辣香，加清水烧开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "豆瓣炒出红油，汤汁才红亮好看。",
      "visual_cue": "汤色红亮，酸香扑鼻。"
    },
    {
      "n": 5,
      "text": "加生抽、白糖和盐调味，转小火盖盖炖二十分钟，到鸡块能被筷子轻松扎透。",
      "time_min": 21,
      "heat": "小火",
      "tip": "小火慢炖鸡肉才软嫩，大火会让肉发紧。",
      "visual_cue": "鸡块软嫩，汤色深红。"
    },
    {
      "n": 6,
      "text": "转中火加香醋和姜末，用水淀粉勾薄芡，边推边收汁到浓稠挂勺。",
      "time_min": 4,
      "heat": "中火",
      "tip": "醋和姜末最后加，久煮酸味挥发、姜香也散。",
      "visual_cue": "汤汁浓稠，姜末分布均匀。"
    },
    {
      "n": 7,
      "text": "转入烧热的砂锅，撒葱花，端上桌时还在咕嘟冒泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "砂锅先烧热再盛，热窝鸡讲究上桌滚烫。",
      "visual_cue": "汤汁翻滚冒泡，姜香四溢。"
    }
  ],
  "tips": [
    "姜要用老姜，香辣味足，嫩姜只有水汽没有劲。",
    "醋分两次用，一半炖时下、一半起锅前下，酸味更立体。",
    "上桌前砂锅要烧热，热窝鸡讲究的就是这股滚烫。"
  ],
  "common_mistakes": [
    "姜末一开始就下锅久煮，姜香散尽只剩渣。",
    "醋早放久煮，酸味挥发，成品只有咸辣。",
    "用大火猛收汤汁，汤色发浑鸡肉发紧，口感变柴。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋酸味更直接，用量减五毫升，白糖加两克平衡。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "鸡胸肉",
      "ratio": "600克:550克",
      "note": "鸡胸肉更易柴，炖的时间缩短五分钟并加一勺油锁水。"
    }
  ],
  "variations": [
    "有的家庭不加泡椒，只用姜醋调味，酸香更纯粹。",
    "川南做法会加一块拍破的老姜同炖，姜味冲得更足。"
  ],
  "serving_suggestion": "连砂锅端上桌，趁滚烫先喝一勺汤，再吃鸡块；汤汁拌饭极开胃。",
  "storage": "冷藏可存两日，复热加少量清水小火煨开；砂锅复热须小火慢升温避免炸裂。",
