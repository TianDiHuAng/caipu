  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉横刀片成三毫米厚的大薄片，用刀背轻拍松软，边缘不要拍破。",
      "time_min": 8,
      "heat": "无火",
      "tip": "拍松能把纤维打断，煎后不卷不柴。",
      "visual_cue": "鸡片厚薄均匀，边缘完整。"
    },
    {
      "n": 2,
      "text": "鸡片加盐、料酒、白胡椒、蛋清和玉米淀粉抓匀上浆，腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "蛋清与淀粉双管齐下，鸡片才滑嫩抱浆。",
      "visual_cue": "鸡片表面挂一层薄浆，湿润发亮。"
    },
    {
      "n": 3,
      "text": "把腌好的鸡片两面拍一层面粉，再均匀沾上熟白芝麻，轻压让芝麻粘牢。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先拍粉再沾芝麻，芝麻才不掉。",
      "visual_cue": "鸡片表面满布芝麻，轻抖不落。"
    },
    {
      "n": 4,
      "text": "炒锅放植物油烧到五成热，下鸡片中火煎到一面金黄定形再翻面。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅后先别动，等芝麻定型再翻，否则全掉锅里。",
      "visual_cue": "芝麻金黄，鸡片边缘微微卷起。"
    },
    {
      "n": 5,
      "text": "两面煎到金黄酥香后捞出沥油，撒姜末、葱花并淋少许生抽提味，装盘上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酱油只在出锅后淋几滴，多了会把芝麻泡软。",
      "visual_cue": "鸡片外酥内嫩，芝麻香气浓。"
    }
  ],
  "tips": [
    "鸡胸肉片得薄又拍松，才吃得嫩。",
    "芝麻要选熟的白芝麻，生芝麻煎香不足。",
    "油温五成最稳妥，太热芝麻焦了肉还生。"
  ],
  "common_mistakes": [
    "鸡片不拍松直接煎，一遇热就卷成筒。",
    "不拍粉只沾芝麻，芝麻全落在锅里。",
    "用大火煎，芝麻发黑发苦而肉不熟。"
  ],
  "substitutions": [
    {
      "original": "熟白芝麻",
      "substitute": "花生",
      "ratio": "40克:45克",
      "note": "换成压碎的花生同样酥香，颗粒更大，口感更有嚼头。"
    },
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "450克:450克",
      "note": "鸡腿肉更嫩但不易片薄，需先去骨冷冻十五分钟再片。"
    }
  ],
  "variations": [
    "有的做法在芝麻里混一半面包糠，外皮更酥。",
    "煎好后蘸椒盐或甜辣酱，两种风味都常见。"
  ],
  "serving_suggestion": "趁热装盘配椒盐或蘸红油碟，配啤酒与凉拌菜；凉了芝麻会回软，宜现做现吃。",
  "storage": "冷藏可存一日，复热用平底锅中火两面各煎一分钟回酥，勿微波。",
