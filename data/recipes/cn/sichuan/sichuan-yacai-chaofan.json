        {
          "name": "芽菜",
          "name_en": "preserved mustard sprout",
          "amount": 40,
          "unit": "g",
          "note": "宜宾碎米芽菜，挤干水",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "打散备用",
