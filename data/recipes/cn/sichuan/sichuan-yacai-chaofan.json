          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 45,
          "unit": "ml",
          "note": "分两次炒制",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "去蛋腥",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "打蛋碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜米饭用手抓散成粒，芽菜挤干水分剁细，小葱切成葱花、葱白葱绿分开放。",
      "time_min": 4,
      "heat": "无火",
      "tip": "米饭要抓散，结团下锅炒不匀，还会粘成块。",
      "visual_cue": "米饭松散成粒，无结块粘连。"
    },
    {
      "n": 2,
      "text": "鸡蛋打散加白胡椒粉和盐搅匀，炒锅放三十毫升植物油烧到六成热，倒蛋液炒散盛出。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蛋液下锅快速划散成小碎块，和米饭才拌得匀。",
      "visual_cue": "蛋碎呈嫩黄色，颗粒细小。"
    },
    {
      "n": 3,
      "text": "锅内补十五毫升植物油，下葱白和芽菜末小火煸两分钟，煸出咸香和酱色。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芽菜一定要煸透，煸出干香才不腥不发酸。",
      "visual_cue": "芽菜末干爽发亮，香气浓烈。"
    },
    {
      "n": 4,
      "text": "倒入米饭转大火翻炒，用锅铲压散翻匀，让每粒米饭都裹上芽菜。",
      "time_min": 2,
      "heat": "大火",
      "tip": "大火快炒，米饭才颗颗带焦香不发湿。",
      "visual_cue": "米饭粒粒分明，色泽微黄。"
    },
    {
      "n": 5,
      "text": "倒回蛋碎，淋生抽快速翻匀，撒葱绿和剩余盐调好咸淡即出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "生抽沿锅边淋才激出酱香，直接浇饭上会让米粒发黏。",
      "visual_cue": "饭粒油亮松散，葱花翠绿点点。"
    }
  ],
  "tips": [
    "隔夜冷饭水分少，炒出来才粒粒分明不粘连。",
    "芽菜先煸透，咸香足而且不会渗出酸水。",
    "盐要最后尝着放，芽菜本身已经带了咸味。"
  ],
  "common_mistakes": [
    "用新煮的热饭下锅炒，粘成一坨铲不动。",
    "芽菜没煸就直接下饭，腥味压不住。",
    "油放太少，米饭干硬粘锅还糊了底。"
  ],
  "substitutions": [
    {
      "original": "芽菜",
      "substitute": "冬菜",
      "ratio": "40克:40克",
      "note": "冬菜咸味更重、香气略沉，用量减到三十克并把盐完全省略。"
    },
    {
      "original": "鸡蛋",
      "substitute": "猪油渣",
      "ratio": "2个:30克",
      "note": "用猪油渣替代蛋碎，油润酥香更重口，油量可减十毫升。"
    }
  ],
  "variations": [
    "有的家庭最后淋一勺辣椒油，红亮微辣更下饭。",
    "加一把焯熟的豌豆同炒，豆香与饭粒相衬。"
  ],
  "serving_suggestion": "趁热盛碗，配一碗紫菜蛋花汤或泡菜就是完整的一餐。",
  "storage": "冷藏可存一日，复热用炒锅大火翻两分钟；微波炉加热易返潮发黏，不建议。",
