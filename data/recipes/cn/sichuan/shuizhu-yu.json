  "equipment": [
    "炒锅",
    "汤锅",
    "大漏勺",
    "片刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草鱼去骨取净肉，斜刀片成 0.3cm 厚的薄片，鱼骨斩段备用。",
      "time_min": 18,
      "heat": "无火",
      "tip": "逆着鱼纹斜片，口感才滑嫩。",
      "visual_cue": "鱼片透光、厚薄均匀"
    },
    {
      "n": 2,
      "text": "鱼片加 4g 盐、白胡椒、料酒与蛋清抓至发黏，再拌入 25g 淀粉腌 10 分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "上浆抓好才锁得住水，煮后不柴。",
      "visual_cue": "鱼片挂糊均匀、不粘连"
    },
    {
      "n": 3,
      "text": "豆芽下开水焯 1 分钟，捞出铺在大盆底部。",
      "time_min": 3,
      "heat": "大火",
      "tip": "豆芽垫底能吸油，也防止鱼片粘盆。",
      "visual_cue": "豆芽断生、颜色透明"
    },
    {
      "n": 4,
      "text": "炒锅倒 60ml 植物油，下豆瓣酱与姜片小火炒 2 分钟出红油，加 800ml 水烧开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "红油炒足，汤底才够香够红。",
      "visual_cue": "汤色红亮、表面浮油"
    },
    {
      "n": 5,
      "text": "先下鱼骨煮 3 分钟，再逐片放入鱼片，改小火烫 90 秒至变白立即关火。",
      "time_min": 6,
      "heat": "小火",
      "tip": "鱼片下锅别搅动，一搅就碎。",
      "visual_cue": "鱼片蜷曲发白、肉质弹嫩"
    },
    {
      "n": 6,
      "text": "连汤倒入铺豆芽的盆中，表面撒干辣椒段、花椒与蒜末。",
      "time_min": 3,
      "heat": "无火",
      "tip": "辣椒蒜末铺在最上层，泼油才能激香。",
      "visual_cue": "表层铺满辣椒花椒、层次分明"
    },
    {
      "n": 7,
      "text": "另起锅烧 90ml 植物油至冒青烟，分三次泼在辣椒蒜末上，撒小葱花即可。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油要烧到冒烟，激不出香就白做。",
      "visual_cue": "滋啦作响、红油翻滚香气冲鼻"
    }
  ],
  "tips": [
    "鱼片逆纹斜片，厚度控制在 0.3cm 最好。",
    "上浆加蛋清，煮出来滑得像豆腐。",
    "泼油的温度必须足够高，香气全靠这一下。"
  ],
  "common_mistakes": [
    "鱼片顺纹切片，煮后卷缩发硬。，成品口感会明显变差。",
    "鱼片下锅后用力搅拌，全部碎成小块。",
    "油温不够就泼，辣椒生涩、香味出不来。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "黑鱼",
      "ratio": "800g 对 700g",
      "note": "肉更紧实，烫的时间加 30 秒。"
    },
    {
      "original": "豆瓣酱",
      "substitute": "水煮鱼调料包",
      "ratio": "40g 对 1 包",
      "note": "咸度较高，盐减 3g。"
    }
  ],
  "variations": [
    "番茄版：去掉豆瓣酱用番茄炒底，做不辣版本。",
    "藤椒版：泼油时加 10g 鲜藤椒，麻香更清亮。"
  ],
  "serving_suggestion": "趁热上桌，鱼片蘸汤吃，配米饭绝佳。",
  "storage": "冷藏 1 天，复热需小火加热不可久煮。",
