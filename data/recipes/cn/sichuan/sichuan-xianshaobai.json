    "炒锅",
    "大碗",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加姜片、葱结、八角与料酒煮到七成熟。",
      "time_min": 25,
      "heat": "中火",
      "tip": "筷子能插入皮但带阻力就是七成熟，别煮过头。",
      "visual_cue": "肉块浮起，皮面能按出浅坑"
    },
    {
      "n": 2,
      "text": "捞出趁热用老抽把皮面抹匀，静置五分钟让颜色吃进皮里。",
      "time_min": 6,
      "heat": "无火",
      "tip": "肉要趁热抹，冷了就吃不上色，蒸出来发白。",
      "visual_cue": "皮面呈酱红发亮，不见白色斑块"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，把肉块皮朝下入锅，中小火煎到皮面起细密小泡。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "锅盖挡一下再下肉，油花会溅得很凶。",
      "visual_cue": "皮面鼓起小泡，颜色深红起皱"
    },
    {
      "n": 4,
      "text": "皮泡好的肉块泡进煮肉的汤里十分钟，表皮回软后切薄片。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡过汤皮才起虎皮纹，切片也不易碎。",
      "visual_cue": "皮面起皱如虎皮，切片时不掉渣"
    },
    {
      "n": 5,
      "text": "芽菜洗两遍挤干水分，下锅用少许油炒香，加生抽、白糖与盐拌匀。",
      "time_min": 6,
      "heat": "中火",
      "tip": "芽菜要洗净沙粒再炒，咸味也能炒得柔和。",
      "visual_cue": "芽菜松散不出水，香气明显上扬"
    },
    {
      "n": 6,
      "text": "肉片皮朝下整齐码进碗里，铺满芽菜压实，上汽蒸一个半小时。",
      "time_min": 85,
      "heat": "中火",
      "tip": "蒸足一个半小时肉才化渣，时间不够咬着费劲。",
      "visual_cue": "碗边渗出清亮油汁，肉片轻按即陷"
    }
  ],
  "tips": [
    "蒸好后倒扣进盘里再揭碗，肉片才完整不塌。",
    "芽菜别放太满，蒸的时候会膨胀，压太实油汁渗不下去。",
    "一次蒸两碗，一碗当天吃，另一碗隔天回蒸更入味。"
  ],
  "common_mistakes": [
    "肉只煮到断生就切，蒸完还是硬的，咬着像橡皮。",
    "煎皮时火太大，皮直接焦黑，整块肉带苦味。",
    "芽菜没洗就下锅，吃起来满口是沙，一口毁一碟。"
  ],
  "substitutions": [
    {
      "original": "芽菜",
      "substitute": "梅干菜",
      "ratio": "120克:120克",
      "note": "梅干菜更甜，白糖减到两克。"
    },
    {
      "original": "五花肉",
      "substitute": "猪后腿肉",
      "ratio": "400克:400克",
      "note": "后腿肉偏瘦，须多淋一勺猪油。"
    }
  ],
  "variations": [
    "碗底铺几片泡软的干豇豆，吸了油汁比肉还香。",
    "加两颗泡椒同蒸，咸香里带一丝酸辣，是重庆一带的做法。"
  ],
  "serving_suggestion": "倒扣上桌，配米饭或荷叶饼夹着吃，是川渝席面的传统九大碗之一。",
  "storage": "冷藏可存三天，复热须重新上锅蒸二十分钟，微波炉加热会发干。",
