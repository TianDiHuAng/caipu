  "equipment": [
    "炒锅",
    "漏勺",
    "厨房纸",
    "碗",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉顺着纹理切成手指粗的条，冷水下锅加姜片、葱结和料酒焯到浮沫出尽。",
      "time_min": 10,
      "heat": "中火",
      "tip": "顺纹切条煸干后才耐嚼不散，逆纹切容易碎成渣。",
      "visual_cue": "肉条表面变白，水面浮起褐色浮沫"
    },
    {
      "n": 2,
      "text": "捞出肉条用温水冲净浮沫，沥干后用厨房纸吸去表面水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "表面带水下锅会剧烈溅油，吸干水分才安全。",
      "visual_cue": "肉条干爽不挂水，颜色浅褐"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧热，下花椒和干辣椒段小火煸出香味，捞出备用。",
      "time_min": 4,
      "heat": "小火",
      "tip": "辣椒花椒下锅颜色一变深就要捞，焦了整锅发苦。",
      "visual_cue": "辣椒呈暗红色，油面泛出麻香"
    },
    {
      "n": 4,
      "text": "下牛肉条中火煸炒八分钟，炒到边缘收紧发干，加生抽、白糖和五香粉翻匀。",
      "time_min": 9,
      "heat": "中火",
      "tip": "耐心煸到肉条明显变小出油，水分不干就不入味。",
      "visual_cue": "肉条紧实收缩，锅底渗出透亮红油"
    },
    {
      "n": 5,
      "text": "倒回辣椒花椒，加盐翻匀，撒白芝麻炒十秒，关火摊开晾凉。",
      "time_min": 3,
      "heat": "小火",
      "tip": "晾凉后肉质会更干硬，热的时候尝起来偏软是正常的。",
      "visual_cue": "肉干表面裹满红油与白芝麻"
    }
  ],
  "tips": [
    "牛腱带筋，煸干后嚼劲足；牛后腿更瘦，成品更干脆。",
    "白糖不能省，回甜能中和麻辣的尖锐感。",
    "做好的肉干装罐冷藏一夜，香味会更透。"
  ],
  "common_mistakes": [
    "肉条没焯水直接煸，血沫锁在肉里带腥味。",
    "辣椒花椒煸到发黑，整锅肉干都带焦苦味。",
    "火候过猛水分一下炒干，肉条外焦内生咬不动。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛腱",
      "ratio": "1:1",
      "note": "筋膜多的部位更耐嚼，煸炒时间需延长三分钟。"
    },
    {
      "original": "花椒",
      "substitute": "藤椒油",
      "ratio": "8 克:15 毫升",
      "note": "出锅前淋入，麻味更清亮。"
    }
  ],
  "variations": [
    "收汁时加一勺辣椒面与熟花生碎，可做干香型版本，适合下酒。"
  ],
  "serving_suggestion": "晾凉后装盘，配啤酒或作为凉菜拼盘的一角。",
  "storage": "密封冷藏五天，冷冻可存一个月，回温后口感基本不变。",
