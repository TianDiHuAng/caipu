  "equipment": [
    "炒锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子切滚刀块，撒盐 3g 抓匀静置 10 分钟，挤掉渗出的水分，再用厨房纸吸干表面。",
      "time_min": 10,
      "heat": "无火",
      "tip": "杀水能减少吸油，也让茄子烧出来不塌不烂。",
      "visual_cue": "茄子块体积缩小、表面微微湿润发亮"
    },
    {
      "n": 2,
      "text": "碗汁：生抽、香醋、白糖、玉米淀粉与清水搅匀备用；泡椒与豆瓣酱剁细。",
      "time_min": 3,
      "heat": "无火",
      "tip": "碗汁提前调好，下锅后一次倒入，避免手忙脚乱糊锅。",
      "visual_cue": "碗汁呈浅褐色，淀粉无结块"
    },
    {
      "n": 3,
      "text": "炒锅下 50ml 植物油，中火把茄子块煎至四面微黄、内部变软，盛出控油。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎而不是炸，家庭做法用油少一半，只要煎到表皮起皱就够。",
      "visual_cue": "茄子表皮起细皱、按压能回弹"
    },
    {
      "n": 4,
      "text": "原锅留底油，下猪肉末炒散至变色，加泡椒、豆瓣酱、姜蒜末小火炒出红油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆瓣酱一定要小火炒，火大容易发苦。",
      "visual_cue": "锅中油脂变红亮、香气冲鼻"
    },
    {
      "n": 5,
      "text": "茄子回锅翻炒，倒入碗汁，中火烧 2 分钟至汁水裹住茄子，撒葱花出锅。",
      "time_min": 4,
      "heat": "中火",
      "tip": "汁收至能挂住茄子即可，太干会失去鱼香汁拌饭的乐趣。",
      "visual_cue": "酱汁浓稠发亮，茄子表面泛油光"
    }
  ],
  "tips": [
    "茄子先杀水再煎，能减少大半吸油量，成品更清爽。",
    "糖醋比例按 1:1 左右，偏甜可再加 5g 糖，偏酸加 10ml 醋。",
    "没有泡椒时用 10g 剁椒加 5ml 米醋代替，香气略有差异。"
  ],
  "common_mistakes": [
    "茄子不杀水直接下锅，吸油严重、成品油腻发苦。",
    "豆瓣酱大火炒糊，整锅带焦苦味。",
    "碗汁一次倒太多，茄子被煮烂成泥。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "长豆角",
      "ratio": "500g 茄子 ≈ 400g 豆角",
      "note": "豆角需先焯水 2 分钟再烧，确保熟透。"
    },
    {
      "original": "猪肉末",
      "substitute": "香菇末",
      "ratio": "80g 肉末 ≈ 100g 香菇",
      "note": "素版香气稍弱，可加 5g 蚝油补味。"
    }
  ],
  "variations": [
    "家庭简化版：茄子微波 4 分钟至软，省去煎制步骤，用油量减到 30ml。",
    "少油版：茄子切条蒸 8 分钟再烧，口感更清但缺焦香。"
  ],
  "serving_suggestion": "配白米饭最下饭；也可作为面浇头，拌面上桌。",
  "storage": "冷藏 2 天，复热时加 20ml 清水小火焖 2 分钟，避免干烧。",
