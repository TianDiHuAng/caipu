  "steps": [
    {
      "n": 1,
      "text": "内酯豆腐连盒放入温水中浸泡五分钟，取出后倒扣在深碗里，用勺子背划成大方块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "温水浸泡能去豆腥，也让豆腐温度接近热饭。",
      "visual_cue": "豆腐块完整白嫩，表面光滑如脂。"
    },
    {
      "n": 2,
      "text": "炒锅放植物油，下豆瓣酱和泡椒碎小火炒出红油，加蒜末炒香，倒入生抽和花椒粉调成蘸水。",
      "time_min": 5,
      "heat": "小火",
      "tip": "豆瓣酱必须小火慢炒出红油，火大就发苦。",
      "visual_cue": "油色红亮，酱香麻辣扑鼻。"
    },
    {
      "n": 3,
      "text": "蘸水盛入小碗，加香油和盐拌匀，撒入一半葱花，尝味调到咸辣适中。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蘸水要略咸一点，拌饭时才够味。",
      "visual_cue": "蘸水红亮浓稠，葱花浮面。"
    },
    {
      "n": 4,
      "text": "米饭盛入碗中压实，把豆腐块轻轻铺在饭上，撒剩余葱花。",
      "time_min": 3,
      "heat": "无火",
      "tip": "豆腐要轻放，压碎就失去嫩滑的口感。",
      "visual_cue": "白豆腐卧在热饭上，冒热气。"
    },
    {
      "n": 5,
      "text": "淋两勺蘸水在豆腐和饭上，剩余蘸水随碗上桌，吃时按口味添加。",
      "time_min": 2,
      "heat": "无火",
      "tip": "边吃边加蘸水，豆腐才不被泡得过咸。",
      "visual_cue": "红油顺豆腐流下渗进米饭。"
    }
  ],
  "tips": [
    "用内酯豆腐替代豆花，操作简单且够嫩滑。",
    "豆瓣酱必须小火炒出红油，川味的魂在这里。",
    "豆腐先用温水泡一下，豆腥味能去掉大半。"
  ],
  "common_mistakes": [
    "内酯豆腐直接下锅煮，一碰就碎成渣。",
    "豆瓣酱用大火炒，立刻发焦发苦发黑。",
    "蘸水调得太淡，拌饭完全没有味道。"
  ],
  "substitutions": [
    {
      "original": "内酯豆腐",
      "substitute": "嫩豆腐",
      "ratio": "300克:300克",
      "note": "嫩豆腐质地稍粗，需先焯水一分钟定型再铺饭。"
    },
    {
      "original": "泡椒",
      "substitute": "小米辣",
      "ratio": "20克:10克",
      "note": "小米辣辣度更直接，酸味需另加半勺香醋补。"
    }
  ],
  "variations": [
    "讲究的做法会用现点的胆水豆花，口感更绵密带豆香。",
    "有的家庭把蘸水换成豆瓣加蒜泥的干碟，风味更冲。"
  ],
  "serving_suggestion": "一勺豆腐连饭舀起，蘸着红油蘸水吃，配一碗素菜汤最解辣。",
  "storage": "豆腐与蘸水须分开冷藏，当日用完；米饭冷藏一日内复热食用。",
