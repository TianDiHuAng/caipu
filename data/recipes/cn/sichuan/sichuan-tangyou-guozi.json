  "equipment": [
    "炒锅",
    "大碗",
    "漏勺",
    "竹签",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉倒进大碗，加白糖，分次加温水搅拌成絮状。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水慢慢加，面团才不粘手。，看准状态再往下做。",
      "visual_cue": "粉成絮状，无干粉，这一点很关键。"
    },
    {
      "n": 2,
      "text": "揉成光滑面团，盖上湿布醒二十分钟。，看准状态再往下做。",
      "time_min": 25,
      "heat": "无火",
      "tip": "醒过的面团延展性好，搓的时候不裂。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 3,
      "text": "面团搓成长条，揪成乒乓球大小的剂子。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "大小一致，炸的时间才齐。，看准状态再往下做。",
      "visual_cue": "剂子圆整，表面光洁"
    },
    {
      "n": 4,
      "text": "剂子逐个搓圆，中间用竹签扎一个小孔。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "扎孔排气，炸的时候才不爆。，看准状态再往下做。",
      "visual_cue": "圆球饱满，孔洞居中"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油，冷油下果子中小火慢炸。，看准状态再往下做。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "冷油下锅，里面才炸得透。，看准状态再往下做。",
      "visual_cue": "果子浮起，慢慢膨胀"
    },
    {
      "n": 6,
      "text": "炸到表面金黄鼓起，捞出沥油。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "浮起再炸一分钟，外壳才硬。，看准状态再往下做。",
      "visual_cue": "外壳金黄，轻敲有声"
    },
    {
      "n": 7,
      "text": "另起锅放红糖和少量清水，小火熬成糖浆。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖浆起小泡就够，熬过头会发苦。，看准状态再往下做。",
      "visual_cue": "糖浆拉起细丝，这一点很关键。"
    },
    {
      "n": 8,
      "text": "倒回果子快速翻裹糖浆，撒芝麻用竹签串起。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖浆里翻两下就出锅，久了变硬。，看准状态再往下做。",
      "visual_cue": "果子裹糖，芝麻粘满"
    }
  ],
  "tips": [
    "冷油下锅慢炸，果子里面才熟透。，这一点很关键。",
    "扎孔排气，避免炸的时候爆开溅油。",
    "糖浆起细丝就下果子，熬过头会带苦味。"
  ],
  "common_mistakes": [
    "热油下锅，外面焦了里面还是生粉。",
    "糖浆熬成深褐色，裹上去一股焦苦。",
    "翻裹时间太长，糖壳厚得咬不动。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "红糖",
      "substitute": "黑糖",
      "ratio": "100 克:100 克",
      "note": "焦香更重，甜度接近。"
    },
    {
      "original": "糯米粉",
      "substitute": "糯米粉加粘米粉",
      "ratio": "250 克:200 克加 50 克",
      "note": "口感稍硬，不易塌。"
    }
  ],
  "variations": [
    "里面包一小块豆沙，咬开有惊喜。，这一点很关键。",
    "换成白糖熬浆，做成白糖油果子。，这一点很关键。"
  ],
  "serving_suggestion": "趁热用竹签串着吃，配豆浆。，这一点很关键。",
  "storage": "当日吃完，冷藏后糖壳会返潮。，这一点很关键。",
