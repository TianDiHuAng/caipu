    "平盘",
    "刀",
    "砧板",
    "厨房纸",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成一厘米厚、四厘米见方的大片，撒少许盐腌五分钟逼出水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腌出水再吸干，豆腐更紧实不易碎，也更好挂糊。",
      "visual_cue": "豆腐片表面微湿，边缘收紧。"
    },
    {
      "n": 2,
      "text": "用厨房纸把豆腐片两面水分吸干，再均匀拍上一层面粉，抖掉多余干粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "干粉要薄，厚了吃起来像面衣，盖住豆香。",
      "visual_cue": "豆腐表面薄薄一层白粉。"
    },
    {
      "n": 3,
      "text": "鸡蛋打散加盐和白胡椒搅匀，把拍过粉的豆腐片逐片放进蛋液里裹匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "裹蛋液马上入锅，久放蛋液回流会脱浆。",
      "visual_cue": "豆腐片裹满蛋液，边缘无漏处。"
    },
    {
      "n": 4,
      "text": "炒锅放植物油烧到五成热，下豆腐片中火煎到两面金黄、蛋衣鼓起。",
      "time_min": 6,
      "heat": "中火",
      "tip": "一次别放太多，挤在一起会粘连，蛋衣也破。",
      "visual_cue": "两面金黄，蛋衣酥脆鼓起。"
    },
    {
      "n": 5,
      "text": "捞出沥油，撒花椒粉和葱花，趁热上桌，可另配一碟蘸水。",
      "time_min": 3,
      "heat": "无火",
      "tip": "花椒粉现撒现吃，放久回潮就没了麻香。",
      "visual_cue": "外皮金黄酥香，葱花点缀。"
    }
  ],
  "tips": [
    "豆腐选北豆腐，含水少，煎出来的蛋衣才脆。",
    "拍粉再裹蛋液是蛋衣不脱落的关键，缺一步都会掉皮。",
    "油温五成最合适，太热蛋衣焦了豆腐还凉。"
  ],
  "common_mistakes": [
    "豆腐不吸干就拍粉，下锅立刻脱浆粘锅。",
    "不拍面粉直接裹蛋液，蛋液挂不住，一煎就散。",
    "火太大，蛋衣焦黑而豆腐中心还是凉的。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "玉米淀粉",
      "ratio": "40克:35克",
      "note": "换成淀粉蛋衣更脆，但容易回软，要现炸现吃。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "2个:2个",
      "note": "鸭蛋蛋液更稠，蛋衣更厚，需多加十毫升清水调稀。"
    }
  ],
  "variations": [
    "有的做法在蛋液里加一勺淀粉，蛋衣更酥脆持久。",
    "出锅后撒椒盐即是椒盐黄金豆腐，配啤酒最合适。"
  ],
  "serving_suggestion": "趁热装盘撒椒盐，配一碟红油蘸水与白饭；凉了蛋衣会回软，宜现做现吃。",
  "storage": "冷藏可存一日，复热用平底锅中火两面各煎一分钟回脆，勿微波。",
