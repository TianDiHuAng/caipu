    "漏勺",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆角掐去两头并撕掉两侧老筋，掰成五厘米长的段，洗净擦干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "老筋不撕会影响口感，还会塞牙缝。",
      "visual_cue": "豆角段长短一致、表面无水"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧到六成热，豆角下锅中火煸五分钟至表皮起皱。",
      "time_min": 6,
      "heat": "中火",
      "tip": "豆角一定要煸透，生豆角吃了会中毒。",
      "visual_cue": "表皮起白皱、颜色由翠绿转深绿"
    },
    {
      "n": 3,
      "text": "豆角捞出沥油，锅留底油把猪肉末下锅中火炒散。",
      "time_min": 3,
      "heat": "中火",
      "tip": "肉末炒到出油发干，香气才足。",
      "visual_cue": "肉末颗粒分明、颜色微焦"
    },
    {
      "n": 4,
      "text": "下豆瓣酱炒出红油，再放生姜末、大蒜末与小米辣炒香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆瓣酱要小火炒，火大就发苦。",
      "visual_cue": "油色红亮、辣香扑鼻"
    },
    {
      "n": 5,
      "text": "倒回豆角转大火翻炒，加生抽、白糖与盐炒匀。",
      "time_min": 3,
      "heat": "大火",
      "tip": "翻炒要快，豆角才不回软。",
      "visual_cue": "豆角裹满红油、干爽不塌"
    },
    {
      "n": 6,
      "text": "沿锅边淋少许清水焖一分钟，收干汤汁即可出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "少量水焖一下，豆角熟得更彻底。",
      "visual_cue": "锅底无汤汁、豆角油亮"
    }
  ],
  "tips": [
    "豆角选细长硬挺的，煸出来更脆嫩。",
    "煸豆角时油要多一点，火候才均匀。",
    "想更香可以加一小把芽菜一起同炒。"
  ],
  "common_mistakes": [
    "豆角只煸一会儿就出锅，夹生还有豆腥味。",
    "肉末冷水下锅，炒不散还会出汤。",
    "豆瓣酱大火猛炒，红油没出色先焦了。"
  ],
  "substitutions": [
    {
      "original": "豆角",
      "substitute": "四季豆",
      "ratio": "400g 对 400g",
      "note": "豆粒更饱满，煸制时间加一分钟。"
    },
    {
      "original": "猪肉末",
      "substitute": "芽菜",
      "ratio": "80g 对 60g",
      "note": "素版更清爽，盐量略减。"
    }
  ],
  "variations": [
    "加一把干辣椒段同煸，辣味会更冲更足。",
    "把猪肉末换成牛肉末，香气会更浓一些。"
  ],
  "serving_suggestion": "趁热配白米饭，干香下饭是最好吃的吃法。",
  "storage": "冷藏可放一天，复热时干锅再炒一次。",
