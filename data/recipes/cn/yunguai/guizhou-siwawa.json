  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "大盘",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加清水和一点盐调成稀面糊，静置十分钟。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面糊要能流动，摊出的皮才薄。，看准状态再往下做。",
      "visual_cue": "面糊顺滑，无颗粒，这一点很关键。"
    },
    {
      "n": 2,
      "text": "平底锅小火烧热，舀一勺面糊转成圆皮。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "锅不刷油，皮才不油不粘。，看准状态再往下做。",
      "visual_cue": "皮薄透明，边缘翘起"
    },
    {
      "n": 3,
      "text": "皮一面凝固就揭下，全部摊好晾凉。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "不用翻面，凝固即熟。，看准状态再往下做。",
      "visual_cue": "皮软有韧，颜色微白"
    },
    {
      "n": 4,
      "text": "黄瓜、胡萝卜切细丝，海带切丝焯水。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丝切得越细，卷起来越好咬。，看准状态再往下做。",
      "visual_cue": "丝条细匀，颜色鲜亮"
    },
    {
      "n": 5,
      "text": "绿豆芽焯十秒捞出过凉，韭菜焯软备用。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "豆芽焯短一点，保持脆感。，看准状态再往下做。",
      "visual_cue": "豆芽透亮，韭菜软绿"
    },
    {
      "n": 6,
      "text": "小碗放生抽、香醋、白糖和盐调成蘸水。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要先化开，味道才匀。，看准状态再往下做。",
      "visual_cue": "汁色清亮，无糖粒，这一点很关键。"
    },
    {
      "n": 7,
      "text": "蘸水里加辣椒油和花生碎，搅匀备用。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "辣椒油最后加，香气才足。，看准状态再往下做。",
      "visual_cue": "红油浮面，花生沉底"
    },
    {
      "n": 8,
      "text": "取一张面皮，铺上各色蔬菜丝卷起来。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "菜别放太多，卷起来才不破。，看准状态再往下做。",
      "visual_cue": "卷身紧实，色彩斑斓"
    },
    {
      "n": 9,
      "text": "卷好的丝娃娃蘸一下蘸水，一口吃掉。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "现卷现蘸，皮才不软塌。，看准状态再往下做。",
      "visual_cue": "蘸水挂皮，汁水欲滴"
    }
  ],
  "tips": [
    "面糊要稀一点，摊出的皮才薄。，这一点很关键。",
    "锅不刷油，皮才清爽不腻。，这一点很关键。",
    "蔬菜丝要切细，卷起来才好咬。，这一点很关键。"
  ],
  "common_mistakes": [
    "面糊太稠，摊出的皮厚如饼。，这一点很关键。",
    "菜放太多，一卷就破。，这一点很关键。",
    "蘸水不放糖，只有死咸。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "澄面",
      "ratio": "200 克:200 克",
      "note": "皮更透明，需用开水烫。"
    },
    {
      "original": "绿豆芽",
      "substitute": "黄豆芽",
      "ratio": "120 克:120 克",
      "note": "更脆，焯的时间加五秒。"
    }
  ],
  "variations": [
    "加一勺折耳根碎，贵州味更冲。，这一点很关键。",
    "卷里放点脆哨，口感更丰富。，这一点很关键。"
  ],
  "serving_suggestion": "当小吃或下午茶，一人能卷十个。，这一点很关键。",
  "storage": "皮与菜分开冷藏，当日吃完。，这一点很关键。",
