  "steps": [
    {
      "n": 1,
      "text": "竹笋削去外层老皮，切成薄片，放进沸水里焯三分钟去掉涩味。",
      "time_min": 10,
      "heat": "大火",
      "tip": "鲜笋含草酸，必须焯透，不然入口发涩还扎嘴。",
      "visual_cue": "笋片由白转浅黄，闻着有清香"
    },
    {
      "n": 2,
      "text": "焯好的笋片捞出沥干，再用清水冲一遍，挤干多余的水分备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冲水挤干能让笋片更脆，炒的时候也不出水。",
      "visual_cue": "笋片干爽不滴水，捏起来有弹性"
    },
    {
      "n": 3,
      "text": "腊肉切成两毫米的薄片，肥瘦相连的部分保留下来一起炒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腊肉切得薄才卷得起来，肥肉煸出的油是这道菜的底味。",
      "visual_cue": "肉片薄透见光，肥膘呈半透明"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，下腊肉片小火慢慢煸到出油、边缘卷起。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小火煸透，腊肉的烟熏香和油脂才完全释放出来。",
      "visual_cue": "肉片打卷，锅底浮一层红油"
    },
    {
      "n": 5,
      "text": "下姜丝、蒜片、干辣椒段和花椒，借腊肉油小火爆出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "香料必须借腊肉油爆香，用素油味道差一截。",
      "visual_cue": "辣椒转深红，花椒浮起冒香"
    },
    {
      "n": 6,
      "text": "倒入笋片转大火翻炒两分钟，让笋片把锅里的腊肉油吸进去。",
      "time_min": 4,
      "heat": "大火",
      "tip": "笋片吃油，煸过的腊肉油全被它吸走，香气才融进去。",
      "visual_cue": "笋片油亮发亮，边缘微微巻起"
    },
    {
      "n": 7,
      "text": "沿锅边淋生抽，加白糖和清水，盖上锅盖中火焖三分钟入味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "少加一点水焖，笋片才进味，不加会干巴巴的。",
      "visual_cue": "汤汁快收干，笋片染上酱色"
    },
    {
      "n": 8,
      "text": "开盖下蒜苗段大火翻炒四十秒，断生即可关火装盘上桌。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蒜苗最后下，断生就起锅，久炒发黄还失去辛香。",
      "visual_cue": "蒜苗翠绿挺直，盘底无汤水"
    }
  ],
  "tips": [
    "鲜竹笋一定要焯水，焯三分钟能去掉大部分草酸和涩味。这一步偷懒，整盘菜都带着涩口。",
    "腊肉先用小火煸出油再炒其他料，腊肉的烟熏香和油脂就是这道菜的底味，用素油代替不了。",
    "笋片下锅后要用大火快炒，让笋片把锅里的腊肉油吸进去。笋片吃油，吸饱了才香。",
    "蒜苗最后下，四十秒断生就够。炒久了发黄发软，那股辛香全跑光了。"
  ],
  "common_mistakes": [
    "竹笋不焯水直接炒，涩得难以下咽。必须沸水焯三分钟再冲水挤干。",
    "腊肉用大火煸，外面焦了里面油还没出。必须小火慢煸到卷边。",
    "全程不加水，笋片炒得干硬。加八十毫升清水焖三分钟，笋片才软嫩入味。",
    "蒜苗和笋片一起下锅，出锅时蒜苗已经烂成黄条。蒜苗必须最后放。"
  ],
  "substitutions": [
    {
      "original": "腊肉",
      "substitute": "五花肉",
      "ratio": "150克:150克",
      "note": "烟熏味消失，需多加五毫升生抽补味。"
    },
    {
      "original": "竹笋",
      "substitute": "冬笋",
      "ratio": "400克:400克",
      "note": "更嫩更甜，焯水时间缩短到两分钟。"
    }
  ],
  "variations": [
    "把笋片换成干笋泡发，做成干笋炒腊肉。干笋吸油更猛，香气更浓，是贵州山里最常见的做法。",
    "加一把干辣椒面同炒，辣味更冲。贵州人吃这道菜讲究辣得下饭。",
    "加一勺豆豉同炒，咸鲜味更厚重。这是黔北一带的常见变体。"
  ],
  "serving_suggestion": "趁热装盘，腊肉卷边透亮、笋片脆嫩吸油，咸香烟熏味和笋的清香互相衬着，配米饭能连吃两碗。",
  "storage": "冷藏可放两天，复热用炒锅大火快炒一分钟；笋片隔夜会更入味，但蒜苗须挑出。",
