  "steps": [
    {
      "n": 1,
      "text": "酸菜挤干水分，切成两厘米的段。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "挤干水，炒的时候才不出汤。，看准状态再往下做。",
      "visual_cue": "酸菜清爽，段长均匀"
    },
    {
      "n": 2,
      "text": "五花肉切薄片，肥瘦分开摆放。，看准状态再往下做。",
      "time_min": 7,
      "heat": "无火",
      "tip": "片切薄一点，炒出来才香不腻。，看准状态再往下做。",
      "visual_cue": "片薄均匀，肥瘦分明"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油，先下肥肉片小火煸出油。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "煸出猪油，酸菜才吸得进香。，看准状态再往下做。",
      "visual_cue": "肉片微卷，油析出，这一点很关键。"
    },
    {
      "n": 4,
      "text": "下瘦肉片大火炒到变色。，看准状态再往下做。，动作要轻，别把食材弄碎。",
      "time_min": 3,
      "heat": "大火",
      "tip": "瘦肉后下，炒久了会柴。，看准状态再往下做。",
      "visual_cue": "肉片发白，边缘微焦"
    },
    {
      "n": 5,
      "text": "加姜丝、蒜片和干辣椒炒出香味。，看准状态再往下做。",
      "time_min": 2,
      "heat": "中火",
      "tip": "辣椒炒出红油，酸辣才够味。，看准状态再往下做。",
      "visual_cue": "辣椒暗红，香气冲鼻"
    },
    {
      "n": 6,
      "text": "下酸菜段大火翻炒，让酸菜吸足油脂。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "酸菜要炒透，酸味才柔和不尖。，看准状态再往下做。",
      "visual_cue": "酸菜油亮，酸香散出"
    },
    {
      "n": 7,
      "text": "加生抽、白糖和盐炒匀，撒葱段出锅。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "糖能压酸，别放多。，看准状态再往下做。",
      "visual_cue": "颜色油亮，葱段翠绿"
    }
  ],
  "tips": [
    "酸菜挤干水再炒，才不会出汤。，这一点很关键。",
    "肥肉先煸出油，酸菜才够香。，这一点很关键。",
    "一点白糖能压住尖酸，别省。，这一点很关键。"
  ],
  "common_mistakes": [
    "酸菜不挤水，炒成一锅汤。，这一点很关键。",
    "瘦肉先下锅，炒得又干又柴。，这一点很关键。",
    "糖放太多，酸味全被盖住。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "300 克:250 克",
      "note": "更咸，盐可省略。"
    },
    {
      "original": "酸菜",
      "substitute": "盐酸菜",
      "ratio": "250 克:250 克",
      "note": "更酸，白糖加到八克。"
    }
  ],
  "variations": [
    "加一把青蒜苗，香气更足。，这一点很关键。",
    "用牛肉片替换，做成酸菜牛肉。，这一点很关键。"
  ],
  "serving_suggestion": "配白米饭，酸辣开胃。，这一点很关键。",
  "storage": "冷藏两天，复热炒锅快炒。，这一点很关键。",
