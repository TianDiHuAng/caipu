  "steps": [
    {
      "n": 1,
      "text": "香菇去蒂切片，口蘑对半切开，用清水快速冲净泥沙。",
      "time_min": 10,
      "heat": "无火",
      "tip": "菌菇别久泡，泡久了香气全跑到水里。",
      "visual_cue": "菇片干净，切面白净"
    },
    {
      "n": 2,
      "text": "鸡腿肉切薄片，加少许盐和白胡椒抓匀腌五分钟。",
      "time_min": 7,
      "heat": "无火",
      "tip": "肉片切薄一点，下锅一烫就熟不老。",
      "visual_cue": "肉片薄匀，略带黏性"
    },
    {
      "n": 3,
      "text": "汤锅放植物油小火，下姜片和葱段煸出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "姜葱煸香打底，煮出来的汤才不寡淡。",
      "visual_cue": "姜片微黄，香气散出"
    },
    {
      "n": 4,
      "text": "倒入清水大火烧开，放入香菇和口蘑煮十分钟。",
      "time_min": 14,
      "heat": "大火",
      "tip": "菌菇先煮出味道，汤底喝起来才够鲜。",
      "visual_cue": "汤色微黄，菇香上浮"
    },
    {
      "n": 5,
      "text": "下鸡肉片煮三分钟到完全变白，撇去表面浮末。",
      "time_min": 4,
      "heat": "中火",
      "tip": "鸡肉片一变白就熟了，煮久了会老。",
      "visual_cue": "肉片发白，汤面清爽"
    },
    {
      "n": 6,
      "text": "加盐和白胡椒调好味道，撒上香菜碎后关火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "盐最后放，菌菇的鲜味才不被压住。",
      "visual_cue": "汤清味鲜，香气扑鼻"
    }
  ],
  "tips": [
    "菌菇快速冲洗即可，久泡会把香气泡走。",
    "鸡肉片切薄，下锅三分钟就足够熟。",
    "盐放到最后再放，菌菇的鲜味更突出。"
  ],
  "common_mistakes": [
    "菌菇泡水太久，汤味寡淡没有鲜香。",
    "鸡肉片煮过头，口感变得又干又柴。",
    "盐放太早，汤的鲜味被咸味盖住。"
  ],
  "substitutions": [
    {
      "original": "口蘑",
      "substitute": "平菇",
      "ratio": "200 克:220 克",
      "note": "口感更软，煮的时间缩短两分钟。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "火腿片",
      "ratio": "200 克:120 克",
      "note": "咸鲜更浓，盐须减半。"
    }
  ],
  "variations": [
    "加几片宣威火腿同煮，汤更鲜香。",
    "放一把豌豆尖，出锅前烫十秒即可。"
  ],
  "serving_suggestion": "盛在白瓷碗里撒一点香菜，配米饭或米线，是云南人日常最家常的一碗鲜汤。",
  "storage": "冷藏两天，复热须彻底滚开；菌菇汤不建议反复加热多次。",
