  "equipment": [
    "汤锅",
    "碗",
    "勺",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干米粉用温水泡二十分钟，泡到能弯折。，看准状态再往下做。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡软再煮，米线才不断。，看准状态再往下做。",
      "visual_cue": "粉条柔软，有韧性，这一点很关键。"
    },
    {
      "n": 2,
      "text": "嫩豆腐放碗里，用勺背压成细碎豆花。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压得越细，口感越滑。，看准状态再往下做。",
      "visual_cue": "豆花细腻，无大块，这一点很关键。"
    },
    {
      "n": 3,
      "text": "汤锅倒清水烧开，下泡好的米粉煮两分钟。，看准状态再往下做。",
      "time_min": 5,
      "heat": "大火",
      "tip": "煮到透明就捞，久了会断。，看准状态再往下做。",
      "visual_cue": "米线透明，浮在水面"
    },
    {
      "n": 4,
      "text": "米粉捞出过一遍凉开水，沥干装碗。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过凉水，米线才爽滑不粘。，看准状态再往下做。",
      "visual_cue": "根根分明，不结块，这一点很关键。"
    },
    {
      "n": 5,
      "text": "豆花放小锅加一点盐，小火加热到微烫。，看准状态再往下做。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆花要热，浇上去才香。，看准状态再往下做。",
      "visual_cue": "豆花冒气，表面微颤"
    },
    {
      "n": 6,
      "text": "热豆花浇在米线上，铺一层酸菜碎。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "豆花盖住米线，保温又好看。，看准状态再往下做。",
      "visual_cue": "碗面雪白，酸菜点缀"
    },
    {
      "n": 7,
      "text": "淋生抽、香醋和辣椒油，撒花生碎。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "调料沿碗边淋，层次才分明。，看准状态再往下做。",
      "visual_cue": "红油浮面，花生铺开"
    },
    {
      "n": 8,
      "text": "撒葱花、香菜，滴香油拌开吃。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌开再吃，咸辣才均匀。，看准状态再往下做。",
      "visual_cue": "色彩丰富，香气扑鼻"
    }
  ],
  "tips": [
    "豆花要压细，口感才顺滑。，这一点很关键。",
    "米线煮好过凉水，才不粘连。，这一点很关键。",
    "豆花要热透再浇，凉了有豆腥味。，这一点很关键。"
  ],
  "common_mistakes": [
    "米线泡不够，煮出来硬芯。，这一点很关键。",
    "豆花太凉，浇上去一股豆腥。，这一点很关键。",
    "辣椒油放太多，盖住豆香。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "内酯豆腐",
      "ratio": "300 克:300 克",
      "note": "更嫩，压碎时更易出水。"
    },
    {
      "original": "米粉",
      "substitute": "河粉",
      "ratio": "300 克:300 克",
      "note": "更宽，煮的时间减一分钟。"
    }
  ],
  "variations": [
    "加一勺肉酱，做成豆花肉酱米线。，这一点很关键。",
    "放几片薄荷叶，云南风味更足。，这一点很关键。"
  ],
  "serving_suggestion": "冬天趁热吃，夏天放凉也好吃。，这一点很关键。",
  "storage": "当日吃完，豆花隔夜易发酸。，这一点很关键。",
