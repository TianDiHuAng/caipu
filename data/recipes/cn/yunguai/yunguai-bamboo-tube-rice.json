      "group": "main",
      "items": [
        {
          "name": "糯米",
          "name_en": "glutinous rice",
          "amount": 400,
          "unit": "g",
          "note": "提前浸泡",
          "optional": false
        },
        {
          "name": "腊肠",
          "name_en": "Cantonese sausage",
          "amount": 150,
          "unit": "g",
          "note": "切丁",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "香菇",
          "name_en": "shiitake mushroom",
          "amount": 60,
          "unit": "g",
          "note": "泡发切丁",
          "optional": false
        },
        {
          "name": "豌豆",
          "name_en": "green pea",
          "amount": 80,
          "unit": "g",
          "note": "鲜豌豆",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 15,
          "unit": "ml",
          "note": "拌米",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 300,
          "unit": "ml",
          "note": "蒸制",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "竹筒",
    "蒸锅",
    "刀",
    "砧板",
    "勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗干净后用清水浸泡四小时，泡到米粒能捏碎。",
      "time_min": 245,
      "heat": "无火",
      "tip": "泡够时间，米粒才容易彻底蒸透。",
      "visual_cue": "米粒饱满，一捏就碎"
    },
    {
      "n": 2,
      "text": "腊肠和泡发的香菇都切成小丁，豌豆洗净后沥干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "丁切小一点，和米粒一起才好熟透。",
      "visual_cue": "丁块大小接近米粒"
    },
    {
      "n": 3,
      "text": "泡好的糯米沥干水分，拌上生抽、盐和植物油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先拌油再装筒，米粒不会粘成一团。",
      "visual_cue": "米粒油亮，颜色均匀"
    },
    {
      "n": 4,
      "text": "把糯米、腊肠丁、香菇丁和豌豆一起混合拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "配料拌匀，每一口才都吃得到料。",
      "visual_cue": "混合均匀，颗粒分明"
    },
    {
      "n": 5,
      "text": "拌好的米料装进竹筒，只装到七分满留出膨胀空间。",
      "time_min": 8,
      "heat": "无火",
      "tip": "装太满蒸时米会顶出来，七分刚好。",
      "visual_cue": "米料平整，留有空隙"
    },
    {
      "n": 6,
      "text": "往竹筒里加清水到刚好没过米面，塞紧筒口。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水刚好没过米面，蒸出来才软糯。",
      "visual_cue": "水面刚好没过米面"
    },
    {
      "n": 7,
      "text": "竹筒竖着放进蒸锅，大火上汽后蒸五十分钟。",
      "time_min": 55,
      "heat": "大火",
      "tip": "中途看一次蒸锅水位，缺水要补热水。",
      "visual_cue": "竹香飘出，米粒饱满"
    },
    {
      "n": 8,
      "text": "把竹筒从蒸锅里取出稍稍放凉，用刀劈开就可以吃了。",
      "time_min": 6,
      "heat": "无火",
      "tip": "等两分钟再劈，避免烫手也更好脱模。",
      "visual_cue": "米饭成筒形，边缘带竹香"
    }
  ],
  "tips": [
    "糯米至少泡四小时，蒸出来才软糯不夹生。",
    "米料只装七分满，留出膨胀的空间。",
    "筒里的水刚好没过米面，蒸完不干也不烂。"
  ],
  "common_mistakes": [
    "糯米没泡够就装筒，蒸一小时还是硬的。",
    "米料装得太满，蒸的时候顶出筒口溢出。",
    "水加得太少，米饭蒸完干硬夹生。"
  ],
  "substitutions": [
    {
      "original": "腊肠",
      "substitute": "腊肉",
      "ratio": "150 克:150 克",
      "note": "咸味更重，盐要相应减少。"
    },
    {
      "original": "豌豆",
      "substitute": "毛豆",
      "ratio": "80 克:80 克",
      "note": "口感更绵，蒸制时间相同。"
    }
  ],
  "variations": [
    "加几片腊肉一同蒸制，油香渗进米饭更足。",
    "米料里拌一点辣椒粉，风味更接近云贵。"
  ],
  "serving_suggestion": "劈开竹筒直接挖着吃，配一碗酸汤或凉拌折耳根最地道。",
  "storage": "冷藏一天，复热隔水蒸十分钟；不建议冷食，糯米冷后发硬。",
