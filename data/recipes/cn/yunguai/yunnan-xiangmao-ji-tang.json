  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉斩成四厘米见方的块，用清水冲洗两遍去掉表面血水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "冲掉表面血水，汤才清亮，炖出来也不带一点腥气。",
      "visual_cue": "鸡块冲至发白，水基本清澈"
    },
    {
      "n": 2,
      "text": "鸡块冷水下锅，加姜片和米酒煮开，撇净浮沫后捞出冲净。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅焯，血沫才出得干净，这是清汤的第一步。",
      "visual_cue": "浮沫灰白成团，鸡块表面干净"
    },
    {
      "n": 3,
      "text": "香茅撕掉外层干皮，用刀背拍扁后切成五厘米长的段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "香茅必须拍扁，纤维拍断香气才出得来，整根下锅白搭。",
      "visual_cue": "香茅段断口散开，青草香气冒出来"
    },
    {
      "n": 4,
      "text": "柠檬用盐搓洗表皮，削下几片黄皮，挤出六十毫升柠檬汁备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "只取黄色表皮不取白色内皮，白皮发苦会毁掉整锅汤。",
      "visual_cue": "柠檬皮薄而黄，汁水清亮无渣"
    },
    {
      "n": 5,
      "text": "砂锅加清水，放鸡块、香茅段和姜片，大火烧开后转小火。",
      "time_min": 6,
      "heat": "大火",
      "tip": "香茅和鸡同时下锅炖，香气才能完全渗进汤里。",
      "visual_cue": "汤面翻滚冒泡，香茅段浮起打转"
    },
    {
      "n": 6,
      "text": "盖盖小火炖四十分钟，让香茅的青草香和鸡汤的鲜慢慢融合。",
      "time_min": 42,
      "heat": "小火",
      "tip": "全程小火微沸，汤清不浑，鸡肉也不柴。",
      "visual_cue": "汤色清亮微黄，鸡块酥软不散"
    },
    {
      "n": 7,
      "text": "加盐和白胡椒调味，放入小米椒段和柠檬皮再炖三分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "柠檬皮最后放，久煮会发苦，三分钟刚好出香。",
      "visual_cue": "汤带柠檬清香，辣味微微上冲"
    },
    {
      "n": 8,
      "text": "关火后淋入柠檬汁，撒芫荽段和薄荷叶，焖两分钟即可盛碗。",
      "time_min": 4,
      "heat": "无火",
      "tip": "柠檬汁一定关火后加，煮过就发苦，酸味也变得死板。",
      "visual_cue": "汤色清亮见底，薄荷芫荽翠绿浮面"
    }
  ],
  "tips": [
    "香茅一定要用刀背拍扁再切段，纤维拍断香气才散得出来。整根丢下去煮，汤几乎没有香茅味。",
    "柠檬只取黄色表皮，白色内皮是苦味来源，削进去整锅汤都会发苦。",
    "柠檬汁必须关火后再加，煮开过的柠檬汁会变苦，那股清新的酸也全没了。",
    "香茅和鸡一起冷水炖，香气才慢慢渗出来。中途加香茅，汤只有表层的一点浮香。"
  ],
  "common_mistakes": [
    "香茅不拍直接下锅，汤里几乎没味道。必须拍扁把纤维拍断。",
    "柠檬皮削得太深带上白皮，整锅汤发苦。只削最外那层薄黄皮。",
    "柠檬汁在锅里煮，酸味变苦。必须关火后加。",
    "全程大火滚，汤浑、鸡肉柴。小火微沸炖四十分钟才够清。"
  ],
  "substitutions": [
    {
      "original": "香茅",
      "substitute": "柠檬叶",
      "ratio": "60克:15克",
      "note": "香气更柔和，用量减半，炖二十分钟即可。"
    },
    {
      "original": "鸡腿肉",
      "substitute": "整鸡",
      "ratio": "600克:900克",
      "note": "带骨更香，炖制时间延长十五分钟。"
    }
  ],
  "variations": [
    "加几个小番茄同炖，汤的酸味更圆润。这是云南傣味的做法。",
    "把鸡腿肉换成鱼片，做成香茅鱼汤。鱼片最后三分钟下锅，肉嫩汤鲜。",
    "加一把香米同煮成粥底，做成香茅鸡粥。傣族人家常吃，暖胃又好消化。"
  ],
  "serving_suggestion": "汤盛在碗里清亮微黄，一股柠檬草的清香先扑上来，喝一口酸辣清爽、鸡肉酥软，是云南傣家菜里最舒服的一碗汤。",
  "storage": "冷藏可放两天，复热用汤锅小火煮开三分钟，起锅前再补一点柠檬汁；鸡肉隔夜易柴，建议当餐吃完。",
