  ],
  "equipment": [
    "电饭锅",
    "炒锅",
    "刀",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗后浸泡三十分钟，沥干备用。，看准状态再往下做。",
      "time_min": 32,
      "heat": "无火",
      "tip": "泡过再焖，米粒才软糯不夹生。，看准状态再往下做。",
      "visual_cue": "米粒发白，一捏即碎"
    },
    {
      "n": 2,
      "text": "火腿切小丁，肥瘦分开备用。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "火腿丁切小，香味才散得开。，看准状态再往下做。",
      "visual_cue": "丁粒方正，红白相间"
    },
    {
      "n": 3,
      "text": "土豆去皮切成两厘米的块，用清水冲去表面淀粉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "冲掉淀粉，焖的时候不易糊锅。，看准状态再往下做。",
      "visual_cue": "块形均匀，水色微白"
    },
    {
      "n": 4,
      "text": "炒锅放猪油，先下火腿肥丁小火煸出香。，看准状态再往下做。",
      "time_min": 5,
      "heat": "小火",
      "tip": "火腿肥丁煸香，米饭才够味。，看准状态再往下做。",
      "visual_cue": "油脂透明，香气浓，这一点很关键。"
    },
    {
      "n": 5,
      "text": "下土豆块中火煎到表面微黄。，看准状态再往下做。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎过的土豆焖了不散，带焦香。，看准状态再往下做。",
      "visual_cue": "表皮起皱，边缘金黄"
    },
    {
      "n": 6,
      "text": "倒糯米翻炒两分钟，让米粒裹上油脂。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "米粒裹油，焖出来才粒粒分明。，看准状态再往下做。",
      "visual_cue": "米粒油亮，颗颗分明"
    },
    {
      "n": 7,
      "text": "加生抽和盐炒匀，全部倒进电饭锅。，看准状态再往下做。",
      "time_min": 2,
      "heat": "中火",
      "tip": "锅底刮干净，焦香也别浪费。，看准状态再往下做。",
      "visual_cue": "颜色酱红，香气扑鼻"
    },
    {
      "n": 8,
      "text": "加清水到刚好没过米面，按煮饭键焖。，看准状态再往下做。",
      "time_min": 35,
      "heat": "无火",
      "tip": "水别多，糯米已泡过含水。，看准状态再往下做。",
      "visual_cue": "水面平稳，米粒铺平"
    },
    {
      "n": 9,
      "text": "跳闸后焖十分钟开盖，撒葱花拌匀。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "焖十分钟，米粒才透心。，看准状态再往下做。",
      "visual_cue": "饭粒油亮，土豆粉糯"
    }
  ],
  "tips": [
    "糯米先泡三十分钟，焖出来才软糯。",
    "土豆煎过再焖，块形完整带焦香。，这一点很关键。",
    "水别放多，糯米本身含水高。，这一点很关键。"
  ],
  "common_mistakes": [
    "水放太多，焖成一锅烂饭。，这一点很关键。",
    "土豆不煎，焖完化成泥。，这一点很关键。",
    "火腿不煸，整锅油腻无香。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "火腿",
      "substitute": "腊肉",
      "ratio": "150 克:150 克",
      "note": "更咸，盐可省略。"
    },
    {
      "original": "糯米",
      "substitute": "大米",
      "ratio": "350 克:350 克",
      "note": "口感更松散，水略减。"
    }
  ],
  "variations": [
    "加一把豌豆，颜色更好看。，这一点很关键。",
    "放几片香肠，风味更浓。，这一点很关键。"
  ],
  "serving_suggestion": "配一碗青菜汤，就是一顿饭。，这一点很关键。",
  "storage": "冷藏两天，复热蒸十分钟。，这一点很关键。",
