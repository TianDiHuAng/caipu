  "steps": [
    {
      "n": 1,
      "text": "牛肉逆着纹理切成两毫米薄片，切好摊开检查有无筋膜。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆纹切是牛肉嫩的第一关，顺着纹切怎么炒都嚼不动。",
      "visual_cue": "肉片薄透见光，白色纹理被横断"
    },
    {
      "n": 2,
      "text": "牛肉片加生抽、蚝油、白糖和米酒抓匀，抓到表面发黏。",
      "time_min": 6,
      "heat": "无火",
      "tip": "抓到发黏说明肉纤维已经上劲，这样炒出来才嫩。",
      "visual_cue": "肉片油润黏手，酱色均匀裹满"
    },
    {
      "n": 3,
      "text": "加玉米淀粉抓匀，最后淋一勺植物油封住表面，腌十五分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "淀粉锁水、油封表面，下锅不粘连还嫩滑。",
      "visual_cue": "肉片挂上一层薄浆，片片分开"
    },
    {
      "n": 4,
      "text": "小米椒切成斜圈，蒜苗斜切段，蒜白蒜叶分开，姜蒜切末备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "小米椒切斜圈出辣更均匀，整根下锅辣味分布不匀。",
      "visual_cue": "椒圈切得整齐，辣气直冲鼻腔"
    },
    {
      "n": 5,
      "text": "炒锅烧到冒烟倒植物油，油热后下牛肉片大火快速滑散。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅必须烧到冒烟，牛肉下锅才不粘，这是爆炒的铁律。",
      "visual_cue": "肉片迅速变色，锅气冲起带香"
    },
    {
      "n": 6,
      "text": "牛肉炒到七成熟立刻盛出，锅内留底油准备炒香料。",
      "time_min": 2,
      "heat": "大火",
      "tip": "七成熟就盛出，回锅再炒一次正好，一起炒就老了。",
      "visual_cue": "肉片边缘变色，中心还带一点粉"
    },
    {
      "n": 7,
      "text": "下姜蒜末和小米椒圈小火爆香，再放蒜白段炒出辛香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "小米椒小火爆，辣味才融进油里，大火只会焦糊。",
      "visual_cue": "椒圈转深红出香，油色红亮"
    },
    {
      "n": 8,
      "text": "倒回牛肉转大火，下蒜叶和薄荷叶翻炒二十秒，尝味补盐出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "回锅只要二十秒，翻匀就出锅，久炒牛肉就柴了。",
      "visual_cue": "肉片嫩滑油亮，蒜苗薄荷翠绿"
    }
  ],
  "tips": [
    "牛肉必须逆纹切，纹理横断了嚼起来才不费劲。切的时候能看清一条条白筋横着断就对了。",
    "腌牛肉要抓到发黏，再加淀粉锁水、油封表面。这三步做到位，牛肉嫩得像豆腐。",
    "锅一定要烧到冒烟再下油和肉，高温瞬间封住表面，肉汁不流失。温锅下肉只会出一盘水。",
    "牛肉分两次炒，第一次七成熟盛出，回锅只炒二十秒。一次炒到底，肉又老又柴。"
  ],
  "common_mistakes": [
    "牛肉顺纹切，怎么炒都嚼不动。必须逆纹横切断纤维。",
    "腌肉时淀粉和油放太早一起抓，浆挂不匀。先抓到发黏，再加淀粉，最后用油封。",
    "锅不够热就下肉，牛肉出水变成煮牛肉。锅必须烧到冒烟。",
    "牛肉在锅里一直炒到全熟，盛盘已经老得咬不动。七成熟盛出，回锅二十秒。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "牛里脊",
      "ratio": "400克:400克",
      "note": "更嫩，抓腌时间缩短到十分钟。"
    },
    {
      "original": "小米椒",
      "substitute": "干辣椒",
      "ratio": "40克:10克",
      "note": "辣味更香但少了鲜辣，用量减到十克。"
    }
  ],
  "variations": [
    "加一把折耳根段同炒，云南人最爱的腥香配牛肉，风味极其地道。",
    "把牛肉换成牛干巴，做成小米辣炒牛干巴。云南回族的经典吃法，越嚼越香。",
    "加一勺糟辣椒同炒，酸辣并重。这是滇东北一带的做法，特别下饭。"
  ],
  "serving_suggestion": "趁热装盘，牛肉嫩滑带汁、小米椒红艳辣爽，薄荷叶一拌还有股清凉的后味，配一碗白饭或米线都绝配。",
  "storage": "冷藏可放一天，复热用炒锅大火快炒四十秒；牛肉隔夜会变老，建议当餐吃完。",
