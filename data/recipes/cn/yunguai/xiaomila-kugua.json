  "equipment": [
    "炒锅",
    "漏盆",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "苦瓜纵向剖开，用勺子刮净白色瓜瓤与内膜，斜刀切成两毫米厚的薄片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "白色瓜瓤是苦味来源，刮得越干净成品越清爽。",
      "visual_cue": "瓜片薄而均匀、内壁露出青绿色"
    },
    {
      "n": 2,
      "text": "瓜片撒三克盐抓匀腌八分钟，出了苦水后用力挤干，再用清水冲一遍挤干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐腌挤水既去苦又让瓜片炒后保持脆口不软塌。",
      "visual_cue": "瓜片明显变软、挤出的水呈青绿色"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒青烟，倒入植物油滑锅，下蒜片与小米辣小火煸出辣香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "小米辣下锅后不要久炸，辣椒素挥发会呛得咳嗽。",
      "visual_cue": "蒜片边缘微黄、辣味直冲鼻子"
    },
    {
      "n": 4,
      "text": "转大火倒入苦瓜片快速翻炒两分钟，让每片都裹上辣椒油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火快炒，火小出水就变成焖苦瓜了。",
      "visual_cue": "瓜片油亮、边缘略微透明"
    },
    {
      "n": 5,
      "text": "沿锅边淋生抽，撒余下三克盐，翻匀十秒后立刻出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "生抽淋锅边激香，直接浇在菜上会让瓜片出水发黑。",
      "visual_cue": "酱香散出、盘底无多余汤汁"
    }
  ],
  "tips": [
    "苦瓜选表皮疙瘩小而密的，苦味轻、肉质脆。",
    "怕苦可把瓜片放冰水里浸十分钟，苦味再减一档。",
    "小米辣的用量按耐受度调整，去籽后辣度约减半。"
  ],
  "common_mistakes": [
    "瓜瓤没刮净，整盘菜发苦，只能靠加重调味遮掩。",
    "盐腌后不挤水，下锅迅速出水，炒成软塌的一锅汤。",
    "小火慢炒，瓜片颜色发黄发暗，失去脆感。"
  ],
  "substitutions": [
    {
      "original": "苦瓜",
      "substitute": "丝瓜",
      "ratio": "350g 对 350g",
      "note": "丝瓜不苦，炒制时间缩短到一分钟。"
    },
    {
      "original": "小米辣",
      "substitute": "干辣椒",
      "ratio": "20g 对 8g",
      "note": "干辣椒需先用温油煸香，辣味更沉。"
    }
  ],
  "variations": [
    "加入一勺豆豉同炒，做成豆豉小米辣炒苦瓜，咸香更重。",
    "以云南腌菜卤腐代替生抽调味，风味更接近滇西家常做法。"
  ],
  "serving_suggestion": "趁热装盘配白米饭，作为云南家常餐桌上的下饭小炒。",
  "storage": "冷藏一天，复热时大火快炒三十秒，久加热会失脆。",
