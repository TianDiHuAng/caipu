  "steps": [
    {
      "n": 1,
      "text": "玉米剥粒，用刀贴着玉米芯把颗粒整排削下来，颗粒越完整越好。",
      "time_min": 12,
      "heat": "无火",
      "tip": "整排削下来的玉米粒饱满，颗颗带胚芽，比乱切的好吃。",
      "visual_cue": "玉米粒成排完整，盘里没有碎渣"
    },
    {
      "n": 2,
      "text": "剥好的玉米粒用清水冲一遍，沥干水分摊在盘里备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冲一下去掉表面的浆水，炒的时候不容易糊锅。",
      "visual_cue": "玉米粒干爽松散，颗颗分明不粘连"
    },
    {
      "n": 3,
      "text": "酸菜切成半厘米碎丁，用手攥一下挤掉多余的酸水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "攥掉酸水，酸味才不会太重，整道菜清爽不涩。",
      "visual_cue": "酸菜碎干爽不滴水，酸香明显冲鼻"
    },
    {
      "n": 4,
      "text": "炒锅烧热下猪油化开，再倒植物油，下蒜末和干辣椒段小火爆香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "猪油配酸菜是云南老做法，那股荤香是素油给不了的。",
      "visual_cue": "蒜末微黄，猪油香气冒出来"
    },
    {
      "n": 5,
      "text": "倒入玉米粒转中火翻炒三分钟，炒到颗粒表面微微起皱发亮。",
      "time_min": 5,
      "heat": "中火",
      "tip": "玉米粒炒到起皱才算透，生玉米粒咬着硬且不甜。",
      "visual_cue": "玉米粒起皱，颜色深黄发亮"
    },
    {
      "n": 6,
      "text": "下酸菜碎一起翻炒两分钟，让酸菜的酸香和玉米的甜味融到一起。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酸菜后下，炒久了酸味跑光只剩皮，两分钟正好。",
      "visual_cue": "酸菜碎吸油，玉米染上浅褐色"
    },
    {
      "n": 7,
      "text": "加盐、白糖和生抽翻匀，白糖要放够才能压住酸菜的尖锐酸味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "糖是这道菜的关键，酸和甜平衡了才顺口。",
      "visual_cue": "味道酸甜平衡，没有尖酸感"
    },
    {
      "n": 8,
      "text": "撒葱花翻两下关火装盘，趁热吃玉米最甜、酸菜最香。",
      "time_min": 2,
      "heat": "大火",
      "tip": "葱花只负责提香，翻两下就出锅，炒软了发黄还失香。",
      "visual_cue": "葱花点缀其间，色泽黄绿相间"
    }
  ],
  "tips": [
    "玉米一定要整排削下来，颗粒完整才饱满甜脆。乱切会把玉米芯的硬块混进去。",
    "酸菜要攥掉酸水再用，不然整盘菜酸得发涩。攥出来的酸水还能留着调汤。",
    "加一小块猪油是云南老做法，酸菜吸了猪油那股腥香就变成荤香，味道立刻厚一层。",
    "白糖不能省，它是平衡酸味的关键。酸菜发酵的酸比较尖锐，加糖后变得圆润顺口。"
  ],
  "common_mistakes": [
    "玉米乱切一通，硬芯碎块混进去硌牙。必须贴着玉米芯整排削下。",
    "酸菜不攥水直接下锅，整盘酸得发涩。先攥掉多余酸水。",
    "不放糖，酸味尖锐冲口。五克白糖就能让味道圆润很多。",
    "玉米没炒透就下酸菜，玉米咬着还是生的。玉米要先炒三分钟起皱。"
  ],
  "substitutions": [
    {
      "original": "玉米",
      "substitute": "甜豆",
      "ratio": "400克:350克",
      "note": "更嫩更甜，炒制时间缩短一分钟。"
    },
    {
      "original": "酸菜",
      "substitute": "酸腌菜",
      "ratio": "120克:120克",
      "note": "云南本地酸腌菜风味更正，酸度略低。"
    }
  ],
  "variations": [
    "加一把青豆和玉米同炒，颜色更漂亮，口感也多一层。云南人叫这道菜金银双脆。",
    "把玉米换成糯玉米，口感更黏更香，是云南乡下的吃法。",
    "加几片腊肉丁一起炒，荤香更足。冬天配米饭最舒服。"
  ],
  "serving_suggestion": "盛盘趁热吃，玉米甜脆、酸菜酸香开胃，一勺一勺停不下来，是云南家庭夏天最常做的一道小炒。",
  "storage": "冷藏可放两天，复热用炒锅大火快炒一分钟；酸菜隔夜会更酸，建议当餐吃完。",
