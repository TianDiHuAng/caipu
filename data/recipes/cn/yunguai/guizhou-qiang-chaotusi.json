  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "锅铲",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成细丝，越细越好。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刀要稳，丝细才脆。，看准状态再往下做。",
      "visual_cue": "丝条均匀，断面平整"
    },
    {
      "n": 2,
      "text": "土豆丝放清水里抓洗两遍，洗掉表面浑水。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洗掉浑水，炒出来才爽脆不粘。，看准状态再往下做。",
      "visual_cue": "水变清，丝条分明，这一点很关键。"
    },
    {
      "n": 3,
      "text": "捞出沥干水分，越干越好。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "带水下锅会溅油，也炒不脆。，看准状态再往下做。",
      "visual_cue": "丝条干爽，不滴水，这一点很关键。"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，下干辣椒和花椒小火炝香。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒一变深红就下料，糊了发苦。，看准状态再往下做。",
      "visual_cue": "辣椒暗红，麻香冲出"
    },
    {
      "n": 5,
      "text": "下蒜片炒香，转大火下土豆丝快速翻炒。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火快炒，土豆丝才脆。，看准状态再往下做。",
      "visual_cue": "丝条翻动，锅气升腾"
    },
    {
      "n": 6,
      "text": "沿锅边淋香醋，加生抽和盐炒匀。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋沿锅边淋，酸香才冲。，看准状态再往下做。",
      "visual_cue": "酸气扑鼻，丝条透亮"
    },
    {
      "n": 7,
      "text": "炒到土豆丝断生仍带脆，撒葱段出锅。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "断生就出锅，炒久了发面。，看准状态再往下做。",
      "visual_cue": "丝条透明，根根分立"
    }
  ],
  "tips": [
    "土豆丝要洗掉浑水，炒出来才爽脆。",
    "干辣椒小火炝，火大一下就糊。，这一点很关键。",
    "醋沿锅边淋，酸香更冲。，这一点很关键。"
  ],
  "common_mistakes": [
    "不洗浑水，炒成一坨。，这一点很关键。",
    "辣椒炝糊了，整盘发苦。，这一点很关键。",
    "炒太久，土豆丝软成泥。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "藕",
      "ratio": "500 克:500 克",
      "note": "更脆，炒的时间加一分钟。"
    },
    {
      "original": "香醋",
      "substitute": "白醋",
      "ratio": "18 毫升:15 毫升",
      "note": "酸味更冲，香气略薄。"
    }
  ],
  "variations": [
    "加一勺糟辣椒，贵州风味更足。，这一点很关键。",
    "放几片腊肉同炒，更香。，这一点很关键。"
  ],
  "serving_suggestion": "配米饭，酸辣下饭。，这一点很关键。",
  "storage": "冷藏一天，复热炒锅快炒。，这一点很关键。",
