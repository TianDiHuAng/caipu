  "equipment": [
    "砂锅",
    "炒锅",
    "搅拌机",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草鱼段用盐与料酒抓匀腌 15 分钟，冲净血水后沥干。",
      "time_min": 15,
      "heat": "无火",
      "tip": "腌后冲洗，能去掉大部分土腥味。",
      "visual_cue": "鱼段表面发白，血水不再渗出"
    },
    {
      "n": 2,
      "text": "番茄一半切块、一半打成泥；炒锅下植物油，炒香姜蒜与豆瓣酱至出红油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆瓣酱要炒出红油，酸汤才有底色。",
      "visual_cue": "油色转红，闻到酱香与辣香"
    },
    {
      "n": 3,
      "text": "下番茄块炒到出汁软烂，再倒番茄泥、高汤与一半米醋，小火煮 15 分钟成酸汤。",
      "time_min": 17,
      "heat": "小火",
      "tip": "番茄炒出沙，汤才浓稠挂口。",
      "visual_cue": "汤汁浓稠呈橘红色，勺背挂一层薄浆"
    },
    {
      "n": 4,
      "text": "砂锅底铺黄豆芽，倒入酸汤烧开，放入鱼段小火煮 8 分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "鱼段下锅后不要翻动，用勺舀汤浇淋。",
      "visual_cue": "鱼肉由透明转白，鱼皮卷起、筷尖能轻插入"
    },
    {
      "n": 5,
      "text": "加盐、白糖与剩余米醋调味，撒小米辣、葱段与香菜，连锅上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "醋分两次放，起锅前的酸香最明亮。",
      "visual_cue": "汤面浮红油，酸香扑鼻，鱼肉完整不散"
    }
  ],
  "tips": [
    "番茄要选沙瓤熟透的，酸汤的自然酸味全靠它。",
    "鱼段煮制时间控制在 8 分钟，久了肉散。",
    "黄豆芽垫在锅底能防止鱼皮粘锅，还能吸收酸汤味道。"
  ],
  "common_mistakes": [
    "醋一次性全放，煮久后酸味挥发只剩咸味。",
    "鱼段下锅后频繁翻动，鱼肉碎散。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲈鱼或黑鱼",
      "ratio": "1:1",
      "note": "黑鱼肉紧不易散，煮制时间可延到 10 分钟。"
    },
    {
      "original": "番茄加米醋",
      "substitute": "罐装番茄加柠檬汁",
      "ratio": "400 克对 1 个柠檬",
      "note": "柠檬酸更清爽，白糖需减半。"
    }
  ],
  "variations": [
    "凯里传统做法用米汤发酵的红酸汤，风味更醇厚。",
    "加木姜子油 3 滴，得到贵州特有的柠檬香气。"
  ],
  "serving_suggestion": "配米饭，先喝汤再吃鱼，汤可续加涮蔬菜。",
  "storage": "冷藏 1 天，复热需煮沸 2 分钟；鱼肉不建议冷冻后再煮，口感会散。",
