  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "土豆",
          "name_en": "potato",
          "amount": 600,
          "unit": "g",
          "note": "选黄心面土豆",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 60,
          "unit": "g",
          "note": "增加黏合",
          "optional": false
        },
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 10,
          "unit": "g",
          "note": "蘸料用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "菜籽油",
          "name_en": "rapeseed oil",
          "amount": 60,
          "unit": "ml",
          "note": "半煎半炸",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "压泥器",
    "平底锅",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切厚片，上蒸锅大火蒸二十分钟，筷子能轻松插透即熟。",
      "time_min": 22,
      "heat": "大火",
      "tip": "蒸比水煮好，土豆不入水，泥更干爽易成形。",
      "visual_cue": "土豆片一插即透、边缘略起沙"
    },
    {
      "n": 2,
      "text": "趁热把土豆压成泥，越细越好，摊开散掉表面的水汽。",
      "time_min": 6,
      "heat": "无火",
      "tip": "土豆泥要趁热压，凉了有硬块压不散。",
      "visual_cue": "泥质细滑无颗粒、不冒热气"
    },
    {
      "n": 3,
      "text": "土豆泥里加糯米粉、盐与葱花揉成团，软硬像耳垂按下去能回弹。",
      "time_min": 8,
      "heat": "无火",
      "tip": "粉看干湿加，能成团不裂就够，多了口感发硬。",
      "visual_cue": "面团光滑不粘手、按压有回弹"
    },
    {
      "n": 4,
      "text": "揪成乒乓球大小的剂子，手心抹少许菜籽油，逐个压成一厘米厚的圆饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "压饼时厚薄一致，薄处容易焦、厚处夹生。",
      "visual_cue": "饼胚圆整、边缘无裂纹"
    },
    {
      "n": 5,
      "text": "平底锅倒菜籽油烧到六成热，饼胚下锅后中小火煎四分钟至底面上色。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "下锅后先别动，等底面结壳再翻，否则会碎。",
      "visual_cue": "底面金黄结壳、边缘冒出小泡"
    },
    {
      "n": 6,
      "text": "翻面再煎三分钟，两面金黄后用锅铲轻按表面，能弹回即成。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "出锅前压一下逼出多余油，吃着不腻。",
      "visual_cue": "两面焦黄、按压迅速回弹"
    },
    {
      "n": 7,
      "text": "辣椒粉加少许盐调成干蘸料，洋芋粑趁热蘸着吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "喜欢湿料可以加一勺折耳根碎与酱油拌成蘸水。",
      "visual_cue": "蘸料干爽鲜红、颗粒分明"
    }
  ],
  "tips": [
    "选黄心土豆淀粉含量高，压出的泥黏性好，饼不易散。",
    "糯米粉只是黏合剂，用量控制在土豆的五分之一以内。",
    "煎制用菜籽油，滇味更地道，也可用玉米油替代。"
  ],
  "common_mistakes": [
    "土豆用水煮，吸了水后泥太稀，只能不断加粉导致口感发硬。",
    "油温过低下锅，饼吸油变软塌，一翻面就碎。",
    "一次压得太薄，煎好外焦内生，中间还是粉团味。"
  ],
  "substitutions": [
    {
      "original": "糯米粉",
      "substitute": "面粉",
      "ratio": "60g 对 55g",
      "note": "用面粉成型性好但口感偏实，少了糯性。"
    },
    {
      "original": "辣椒粉",
      "substitute": "云南卤腐",
      "ratio": "10g 对 30g",
      "note": "换成卤腐蘸水，咸鲜带发酵香，需减盐。"
    }
  ],
  "variations": [
    "土豆泥里拌入炒香的腊肉丁与酸菜，做成咸香腊肉洋芋粑。",
    "压饼时包入一小块芝士，做成拉丝版本，孩子更喜欢。"
  ],
  "serving_suggestion": "趁热现煎现吃，配一碗豆浆或米线，作为云南的早点或街头小吃。",
  "storage": "生饼胚可冷冻一周，煎前无需解冻；煎熟后冷藏一天，回锅复煎恢复脆壳。",
