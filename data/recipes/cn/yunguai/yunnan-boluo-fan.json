        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "刀",
    "砧板",
    "碗",
    "勺子",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗两遍，加清水浸泡四小时，泡到米粒能捏碎。",
      "time_min": 240,
      "heat": "无火",
      "tip": "泡够时间的糯米蒸出来才糯，不夹生。",
      "visual_cue": "米粒饱满发白，一捏即碎"
    },
    {
      "n": 2,
      "text": "菠萝竖着切开，用小刀沿边划一圈，把果肉整块挖出。",
      "time_min": 10,
      "heat": "无火",
      "tip": "外壳要留一厘米厚，太薄蒸的时候会破。",
      "visual_cue": "菠萝壳完整，边缘整齐"
    },
    {
      "n": 3,
      "text": "挖出的菠萝肉切成小丁，一半留用，一半榨汁备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "菠萝汁用来拌米，甜香更透。",
      "visual_cue": "果丁大小均匀，汁水留出"
    },
    {
      "n": 4,
      "text": "糯米沥干，加椰浆、菠萝汁、白糖与一小撮盐拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐只放一撮，能把甜味提起来，吃不出咸。",
      "visual_cue": "米粒均匀吸汁，颜色微黄"
    },
    {
      "n": 5,
      "text": "拌好的糯米铺进蒸屉，中火蒸二十五分钟至熟透。",
      "time_min": 27,
      "heat": "中火",
      "tip": "中间用筷子戳几个孔，受热更均匀。",
      "visual_cue": "米粒透亮软糯，无白心"
    },
    {
      "n": 6,
      "text": "蒸好的糯米倒进大碗，趁热拌入菠萝丁、葡萄干与花生。",
      "time_min": 4,
      "heat": "无火",
      "tip": "趁热拌，果香才吃得进米里。",
      "visual_cue": "配料分布均匀，米粒松散"
    },
    {
      "n": 7,
      "text": "把拌好的糯米填回菠萝壳，装到八分满，轻轻压实但别压太紧。",
      "time_min": 4,
      "heat": "无火",
      "tip": "填八分满即可，蒸的时候米还会胀。",
      "visual_cue": "饭面平整，菠萝壳不倒"
    },
    {
      "n": 8,
      "text": "菠萝饭放回蒸锅，中火再蒸十分钟，让果香渗进去。",
      "time_min": 12,
      "heat": "中火",
      "tip": "这一步是灵魂，直接吃和回蒸过的香气差一倍。",
      "visual_cue": "菠萝壳发亮变软，香气浓"
    },
    {
      "n": 9,
      "text": "取出稍稍放凉，切块或用勺挖着吃，趁温热最香。",
      "time_min": 3,
      "heat": "无火",
      "tip": "放凉五分钟再吃，太烫会烫嘴，太凉糯米发硬。",
      "visual_cue": "饭粒晶莹，果香扑鼻"
    }
  ],
  "tips": [
    "糯米必须提前泡，赶时间可用温水泡两小时。",
    "菠萝选熟透的，酸味低、汁水多，蒸出来才甜。",
    "没有椰浆可用牛奶代替，但香气会淡一档。",
    "傣味版本会加一勺猪油，米粒更亮更香。"
  ],
  "common_mistakes": [
    "糯米不泡直接蒸，外面烂了里面还是硬芯。",
    "菠萝壳挖太薄，蒸的时候裂开，饭漏一锅。",
    "糖放太多盖住菠萝的酸香，变成纯甜的糯米饭。"
  ],
  "substitutions": [
    {
      "original": "糯米",
      "substitute": "大米",
      "ratio": "250克:250克",
      "note": "口感变松散，泡米时间减至一小时。"
    },
    {
      "original": "椰浆",
      "substitute": "牛奶",
      "ratio": "80毫升:80毫升",
      "note": "奶香更淡，糖可加五克。"
    }
  ],
  "variations": [
    "加一把菠萝蜜丝同拌，香气更浓，是西双版纳的做法。",
    "把菠萝换成南瓜盅，做成南瓜糯米饭，秋季常见。"
  ],
  "serving_suggestion": "三人份主食兼甜点，配一杯普洱茶解腻，当早餐或饭后甜点都合适。",
  "storage": "冷藏一天内吃完，复蒸八分钟回软；菠萝壳会出水，不建议存超过一天。",
