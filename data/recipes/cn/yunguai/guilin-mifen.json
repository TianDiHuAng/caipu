  "equipment": [
    "汤锅",
    "炒锅",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉整块冷水下锅焯 5 分钟，加料酒去腥，捞出冲净后切成薄片。",
      "time_min": 8,
      "heat": "大火",
      "tip": "整块焯再切片，肉片才不散。",
      "visual_cue": "牛肉表面发白、无血水"
    },
    {
      "n": 2,
      "text": "汤锅加 800ml 清水、生抽、老抽、八角、桂皮与盐，下牛肉小火卤 20 分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "卤牛肉的汤就是桂林米粉的卤水，别倒掉。",
      "visual_cue": "牛肉软而入味、卤水红亮"
    },
    {
      "n": 3,
      "text": "鲜米粉放入沸水中烫 40 秒，捞出抖散装碗。",
      "time_min": 3,
      "heat": "大火",
      "tip": "鲜米粉只需烫热，久煮会断。",
      "visual_cue": "米粉热透、根根分明"
    },
    {
      "n": 4,
      "text": "锅下 20ml 植物油，小火炸花生米 2 分钟至微黄，捞出晾凉。",
      "time_min": 3,
      "heat": "小火",
      "tip": "花生冷油下锅，内外熟度才一致。",
      "visual_cue": "花生微黄、响声清脆"
    },
    {
      "n": 5,
      "text": "米粉上铺牛肉片、酸豆粒、花生、蒜末、葱花与香菜末，浇两勺滚烫卤水。",
      "time_min": 3,
      "heat": "无火",
      "tip": "卤水要滚烫，浇下去香味才冲。",
      "visual_cue": "卤水没过米粉一半、香气扑鼻"
    },
    {
      "n": 6,
      "text": "按口味淋上辣椒油，用筷子从下往上充分拌匀即可食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "桂林米粉讲究干拌，先拌后配汤。",
      "visual_cue": "米粉均匀上色、油亮不粘"
    }
  ],
  "tips": [
    "桂林米粉是干拌吃法，另配一碗骨汤，吃完粉再喝汤。",
    "酸豆角是灵魂，没有就用酸菜代替但风味淡一点。",
    "卤水可反复卤制，越陈越香，每次用后煮沸冷藏。"
  ],
  "common_mistakes": [
    "米粉煮太久，捞起就断、失去弹性。",
    "卤水只用清水加酱油，没有香料层次，味道寡淡。",
    "拌之前不浇热卤水，米粉干涩拌不开。"
  ],
  "substitutions": [
    {
      "original": "米粉",
      "substitute": "河粉",
      "ratio": "400g 米粉 ≈ 450g 河粉",
      "note": "河粉更宽，烫 20 秒即可。"
    },
    {
      "original": "酸豆",
      "substitute": "酸菜",
      "ratio": "50g 酸豆 ≈ 60g 酸菜",
      "note": "酸菜需挤干水分再切碎。"
    }
  ],
  "variations": [
    "家庭简化版：卤水用现成卤肉饭酱汁加清水调制，省去香料。",
    "桂林街头版：加一勺锅烧（炸猪皮），香脆更足。"
  ],
  "serving_suggestion": "先干拌吃粉，再舀一碗骨汤兑卤水喝，是桂林人的标准流程。",
  "storage": "卤水冷藏 3 天、冷冻 1 个月；米粉当日食用最佳。",
