        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "汤勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐先整块放进淡盐水里泡五分钟，再切成三厘米见方的块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "淡盐水泡一下，豆腐不易碎，豆腥味也淡。",
      "visual_cue": "豆腐块方整，边缘不碎"
    },
    {
      "n": 2,
      "text": "香菇去蒂切片，姜切细丝，小葱切成葱花，分开放好。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香菇蒂硬，去掉口感更好，切片厚薄要一致。",
      "visual_cue": "香菇片均匀，葱姜备齐"
    },
    {
      "n": 3,
      "text": "汤锅倒鸡汤，放入姜丝与香菇片，大火烧开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "香菇先下能出鲜味，汤会更厚，比最后放香得多。",
      "visual_cue": "汤面翻滚，香菇浮起"
    },
    {
      "n": 4,
      "text": "转中小火煮五分钟，让香菇的鲜味完全融进汤里。",
      "time_min": 6,
      "heat": "小火",
      "tip": "这一步别省，香菇没煮透，汤就只是咸水。",
      "visual_cue": "汤色微黄，香菇香气冒出"
    },
    {
      "n": 5,
      "text": "轻轻放入豆腐块，用汤勺背推散，不要用勺搅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "用勺背推，豆腐才不破，搅几下就成豆花汤了。",
      "visual_cue": "豆腐块完整浮在汤面"
    },
    {
      "n": 6,
      "text": "保持小火煮四分钟，让豆腐吸足汤味，不要大滚。",
      "time_min": 5,
      "heat": "小火",
      "tip": "大滚会把豆腐煮出蜂窝，口感变粗。",
      "visual_cue": "豆腐微鼓，汤色清亮"
    },
    {
      "n": 7,
      "text": "加盐与白胡椒调味，尝一口汤，按口味补盐。",
      "time_min": 2,
      "heat": "小火",
      "tip": "豆腐本身淡，盐要比平时多一点点才够味。",
      "visual_cue": "汤咸淡适中，胡椒香微冲"
    },
    {
      "n": 8,
      "text": "关火，淋香油，撒上葱花，连汤带豆腐盛进碗里。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油关火后再淋，久煮会散香，只剩油腻。",
      "visual_cue": "汤面油花点点，葱花翠绿"
    }
  ],
  "tips": [
    "嫩豆腐口感滑，老豆腐豆香足，按喜好选。",
    "没有鸡汤用清水加两片火腿煮十分钟，鲜味也够。",
    "加一把豌豆尖或小青菜，汤更清甜。",
    "汤要小火慢煨，火大了豆腐碎，汤也浑。"
  ],
  "common_mistakes": [
    "豆腐下锅后拿勺搅，出锅全是碎渣，汤也变浑。",
    "大火滚煮，豆腐内部起孔，口感发柴。",
    "盐早放又久煮，豆腐脱水变硬，鲜味流失。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "内酯豆腐",
      "ratio": "400克:400克",
      "note": "更嫩，下锅后只能推不能搅。"
    },
    {
      "original": "鸡汤",
      "substitute": "清水",
      "ratio": "900毫升:900毫升",
      "note": "加两片火腿或一勺蚝油补鲜。"
    }
  ],
  "variations": [
    "加几片火腿同煮，咸鲜更浓，是云南家常的做法。",
    "把豆腐换成豆花，做成豆花汤，口感更细滑。"
  ],
  "serving_suggestion": "三人份汤菜，配米饭、饵块或米线，也适合当早餐汤。",
  "storage": "冷藏两天内喝完，复热用小火加热到微滚，别反复烧开。",
