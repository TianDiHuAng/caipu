  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "木铲",
    "漏盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小青菜逐棵掰开，用清水冲洗三遍，把梗根部的泥沙去净后沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "菜梗根部最容易藏泥，掰开一片片冲才干净。",
      "visual_cue": "菜叶清爽无水，根部干净"
    },
    {
      "n": 2,
      "text": "把菜梗与菜叶分开，梗切成两段，菜叶保持整片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "梗厚叶薄，分开下锅才能同时熟。",
      "visual_cue": "梗段整齐，叶片完整"
    },
    {
      "n": 3,
      "text": "蒜切成薄片，干辣椒剪成两段，抖掉里面的辣椒籽再备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "辣椒籽留在锅里容易焦苦，抖干净更香。",
      "visual_cue": "蒜片均匀，辣椒段无籽"
    },
    {
      "n": 4,
      "text": "炒锅大火烧热，倒植物油，下蒜片与干辣椒炒到蒜片边缘泛黄。",
      "time_min": 2,
      "heat": "大火",
      "tip": "蒜片微黄就下菜，炒到金黄就焦了，会有苦味。",
      "visual_cue": "蒜片泛黄，辣椒呈深红"
    },
    {
      "n": 5,
      "text": "倒入菜梗，大火翻炒一分钟，撒两克盐让梗出水。",
      "time_min": 2,
      "heat": "大火",
      "tip": "先撒一点盐，梗出水更快，炒出来更脆。",
      "visual_cue": "菜梗转深绿，锅底见少许汁"
    },
    {
      "n": 6,
      "text": "放菜叶，大火翻炒四十秒，淋入蚝油快速翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "菜叶一塌就够，久炒会发黄发软。",
      "visual_cue": "菜叶塌软，油光发亮"
    },
    {
      "n": 7,
      "text": "尝一根菜梗，按口味补盐，翻匀后立刻关火。",
      "time_min": 1,
      "heat": "大火",
      "tip": "关火要快，锅里余温还会继续加热，迟了就过火。",
      "visual_cue": "咸淡适中，香气清鲜"
    },
    {
      "n": 8,
      "text": "盛盘时把菜叶铺底、菜梗摆上，淋上锅里的汁即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘底的菜汁清甜，拌饭比酱汁还香。",
      "visual_cue": "菜色翠绿，盘底少许清汤"
    }
  ],
  "tips": [
    "小青菜买回来泡十分钟再冲，泥沙才去得干净。",
    "不喜欢辣可以省掉干辣椒，只用蒜片炒也很香。",
    "炒青菜要大火、锅要热，锅里干爽才脆。",
    "云南人家常会加一勺糟辣椒同炒，酸辣更开胃。"
  ],
  "common_mistakes": [
    "菜洗完不沥干就下锅，锅里瞬间出汤，变成水煮青菜。",
    "火小慢炒，菜叶发黄发软，颜色和口感都差。",
    "盐一次性早放太多，出锅时汁水太多，菜塌成一团。"
  ],
  "substitutions": [
    {
      "original": "小青菜",
      "substitute": "小白菜",
      "ratio": "500克:500克",
      "note": "叶片更嫩，炒制时间各减半分钟。"
    },
    {
      "original": "蚝油",
      "substitute": "生抽",
      "ratio": "8毫升:10毫升",
      "note": "咸度更高，盐需减一克。"
    }
  ],
  "variations": [
    "加一勺猪油替植物油，香气更足，是云南乡下的做法。",
    "加几片火腿同炒，咸鲜更浓，适合当下饭菜。"
  ],
  "serving_suggestion": "三人份配菜，配米饭、饵块或米线都合适。",
  "storage": "现炒现吃最好，冷藏一夜后复热会出水，颜色也会发暗。",
