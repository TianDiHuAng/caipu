  "steps": [
    {
      "n": 1,
      "text": "土豆削皮后切成两毫米厚的薄片，切好马上泡进清水里防止变黑。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切好就泡水，土豆接触空气一会儿就发黑，泡水还能洗掉表面白色浆水。",
      "visual_cue": "土豆片薄透均匀，水变浑浊"
    },
    {
      "n": 2,
      "text": "泡好的土豆片用手搓洗两遍，换水冲到水清，捞出沥干水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洗掉表面白色浆水，炒出来才是一片片的，不会粘成坨。",
      "visual_cue": "水色清透不浑，薯片干爽不粘连"
    },
    {
      "n": 3,
      "text": "干辣椒剪成两厘米长的段，抖掉里面的辣椒籽，大蒜切成薄片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "辣椒籽容易炒糊发苦，剪开抖掉，只留辣椒皮的香。",
      "visual_cue": "辣椒段长短整齐，籽已抖净"
    },
    {
      "n": 4,
      "text": "炒锅烧到微微冒烟倒植物油，下干辣椒段和花椒小火煸出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "辣椒花椒一定要小火，油温高了十秒就糊，整锅发苦。",
      "visual_cue": "辣椒转深红发亮，油面浮起香味"
    },
    {
      "n": 5,
      "text": "下蒜片和姜丝炒香，倒入沥干的土豆片转大火快速翻炒两分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "土豆片下锅前要沥干，带水下锅会溅油还不脆。",
      "visual_cue": "薯片边缘转透明，锅气冲起来"
    },
    {
      "n": 6,
      "text": "沿锅边淋生抽，撒盐和白糖，继续大火翻炒一分钟让薯片上色。",
      "time_min": 3,
      "heat": "大火",
      "tip": "盐要后放，早放土豆片出水变软，炒不出脆口。",
      "visual_cue": "薯片均匀染上一层浅浅的酱色"
    },
    {
      "n": 7,
      "text": "沿锅边淋香醋快速翻匀，下葱段炒十秒立刻关火出锅装盘。",
      "time_min": 3,
      "heat": "大火",
      "tip": "醋沿锅边淋遇热激香，直接浇薯片上会发酸。",
      "visual_cue": "薯片脆亮泛光，葱段翠绿挺直"
    }
  ],
  "tips": [
    "土豆片切好必须马上泡水，一是防氧化变黑，二是洗掉表面白色浆水，炒的时候才不会粘锅成团。",
    "洗到水变清是很关键的一步，白色浆水洗得越干净，成品越是片片分明、口感爽脆。",
    "干辣椒要小火煸，油温一高十秒就糊。看到辣椒转深红、闻到香味就立刻下别的料。",
    "醋要沿锅边淋，遇热激出醋香而留下酸味。直接浇在土豆片上，酸味生硬还容易出水。"
  ],
  "common_mistakes": [
    "土豆片不泡水直接炒，下锅就粘成一团。必须泡水洗到水清再沥干。",
    "干辣椒大火煸，糊成黑段整盘发苦。小火慢煸，颜色一变就下料。",
    "盐放太早，土豆片出水变软塌。盐要在快出锅前放。",
    "土豆片炒太久，软烂没脆劲。全程大火，从下锅到出锅不超过四分钟。"
  ],
  "substitutions": [
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "500克:500克",
      "note": "口感更甜更粉，炒制时间缩短一分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "小米椒",
      "ratio": "8克:30克",
      "note": "鲜辣味更冲，需在最后阶段下锅。"
    }
  ],
  "variations": [
    "加一勺糟辣椒同炒，酸辣味更正。这是贵州人最爱的做法，酸辣土豆片配白饭一绝。",
    "把土豆片换成土豆丝，做成干椒土豆丝。丝越细越脆，火候要更快。",
    "加几片腊肉一起煸，油脂和烟熏香渗进薯片里，风味立刻升一级。"
  ],
  "serving_suggestion": "趁热装盘，土豆片脆亮带辣、干椒的香气直往鼻子里钻，是最下饭的一道贵州家常菜，配白粥或米饭都好。",
  "storage": "冷藏可放一天，复热用炒锅大火快炒一分钟恢复脆感；微波会让薯片回软，不建议使用。",
