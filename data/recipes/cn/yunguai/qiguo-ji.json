        }
      ]
    }
  ],
  "equipment": [
    "汽锅",
    "大汤锅",
    "纱布或湿毛巾"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡剁成的鸡块冷水浸泡 30 分钟去血水，中途换水一次，捞出沥干。",
      "time_min": 30,
      "heat": "无火",
      "tip": "汽锅鸡不焯水，全靠浸泡去血水，汤才清亮。",
      "visual_cue": "鸡块颜色转浅、无血水渗出"
    },
    {
      "n": 2,
      "text": "鸡块加料酒、姜片与白胡椒抓匀腌 15 分钟，香菇泡发后挤干备用。",
      "time_min": 15,
      "heat": "无火",
      "tip": "香菇选小而厚的，久蒸不易烂。",
      "visual_cue": "鸡块表面均匀裹上调料"
    },
    {
      "n": 3,
      "text": "鸡块与香菇、葱结码入汽锅，不加一滴水，盖严锅盖。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汽锅的蒸汽冷凝成汤，加水就失去意义。",
      "visual_cue": "锅内食材码放平整、不超出锅沿"
    },
    {
      "n": 4,
      "text": "大汤锅加水至汽锅高度的 1/3，锅口用湿毛巾围封，坐入汽锅，大火烧开后转中火蒸 2 小时。",
      "time_min": 125,
      "heat": "中火",
      "tip": "中途检查外锅水位，水干需补沸水，避免干烧。",
      "visual_cue": "汽锅内汤汁升至食材八成高度"
    },
    {
      "n": 5,
      "text": "开盖加 5g 盐调味，撒少许葱花，连锅上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐最后放，早放会让鸡肉收紧变柴。",
      "visual_cue": "汤色清亮微黄、鸡肉轻压即散"
    }
  ],
  "tips": [
    "必须用带气嘴的建水汽锅，普通砂锅无法形成蒸汽回流。",
    "蒸制时间按鸡的老嫩调整，老母鸡需 3 小时。",
    "可加 10g 三七片或天麻同蒸，云南当地常见药膳做法。"
  ],
  "common_mistakes": [
    "汽锅内加水，变成普通炖鸡，失去清汤特色。",
    "外锅水烧干未补，锅体炸裂或鸡肉焦糊。",
    "中途频繁开盖，蒸汽流失，成汤量明显减少。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "1000g 整鸡 ≈ 800g 鸡腿肉",
      "note": "蒸制时间减到 90 分钟。"
    },
    {
      "original": "香菇",
      "substitute": "竹荪",
      "ratio": "40g 干香菇 ≈ 20g 干竹荪",
      "note": "竹荪需提前泡发并剪去根部。"
    }
  ],
  "variations": [
    "家庭简化版：用炖盅隔水蒸 2 小时，汤量略少但风味接近。",
    "药膳版：加 10g 三七片与 5 颗红枣，汤色更深，需标注孕妇慎用。"
  ],
  "serving_suggestion": "先喝汤再吃肉，配云南米线或米饭；冬季滋补首选。",
  "storage": "冷藏 2 天，撇去表面鸡油后复热；冷冻 1 个月。",
