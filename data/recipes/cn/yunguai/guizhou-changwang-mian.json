  "equipment": [
    "汤锅",
    "炒锅",
    "刀",
    "砧板",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面条用手轻轻抖散，摊在案板上备用，别让它们粘成一团。",
      "time_min": 4,
      "heat": "无火",
      "tip": "面团要和硬，擀出来才筋道。，看准状态再往下做。",
      "visual_cue": "条条分散，不结块"
    },
    {
      "n": 2,
      "text": "另起汤锅烧开清水，准备下面条煮制，水量要足。",
      "time_min": 6,
      "heat": "大火",
      "tip": "切前多撒干粉，面条才不粘。，看准状态再往下做。",
      "visual_cue": "水面翻滚，蒸汽腾起"
    },
    {
      "n": 3,
      "text": "五花肉切小丁，锅里少油小火慢慢煸干。，看准状态再往下做。",
      "time_min": 10,
      "heat": "小火",
      "tip": "煸到出油发脆，就是脆哨。，看准状态再往下做。",
      "visual_cue": "肉丁缩成小粒，颜色焦黄"
    },
    {
      "n": 4,
      "text": "猪大肠切段，加姜片和生抽小火卤二十分钟。，看准状态再往下做。",
      "time_min": 22,
      "heat": "小火",
      "tip": "大肠先卤入味，再下汤才香。，看准状态再往下做。",
      "visual_cue": "肠段软糯，酱色均匀"
    },
    {
      "n": 5,
      "text": "猪血切条，放开水里焯一分钟捞出。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "血制品焯透去腥，也定型。，看准状态再往下做。",
      "visual_cue": "血条变深，边缘紧实"
    },
    {
      "n": 6,
      "text": "炒锅倒植物油，下豆瓣酱、干辣椒和花椒炒香。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆瓣酱炒出红油，辣味才出。，看准状态再往下做。",
      "visual_cue": "油色红亮，香气冲鼻"
    },
    {
      "n": 7,
      "text": "加清水烧开，放生抽和盐调成汤底。，看准状态再往下做。",
      "time_min": 6,
      "heat": "大火",
      "tip": "汤底要够咸，面条才入味。，看准状态再往下做。",
      "visual_cue": "汤色红亮，咸香扑鼻"
    },
    {
      "n": 8,
      "text": "面条下锅煮两分钟，捞进碗里备用，别煮过头。",
      "time_min": 4,
      "heat": "大火",
      "tip": "面刚断生就捞，泡汤后还会软。，看准状态再往下做。",
      "visual_cue": "面条透明，筋道弹牙"
    },
    {
      "n": 9,
      "text": "碗里浇汤，铺血条、大肠、脆哨和酸菜。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "配料铺上面，汤才不被泡淡。，看准状态再往下做。",
      "visual_cue": "碗面丰盛，红油浮起"
    },
    {
      "n": 10,
      "text": "撒葱花，趁热拌开吃。，看准状态再往下做。，动作要轻，别把食材弄碎。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌开再吃，辣味才均匀。，看准状态再往下做。",
      "visual_cue": "汤面油亮，葱绿点点"
    }
  ],
  "tips": [
    "面团要和硬，擀出的面条才筋道。，这一点很关键。",
    "脆哨要小火煸干，才有酥脆口感。，这一点很关键。",
    "面条刚断生就捞，泡汤后正好。，这一点很关键。"
  ],
  "common_mistakes": [
    "面团太软，切出来粘成一团。，这一点很关键。",
    "猪血不焯水，汤里一股腥味。，这一点很关键。",
    "面煮太久，进碗就烂成糊。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪大肠",
      "substitute": "猪肚",
      "ratio": "300 克:300 克",
      "note": "卤的时间加十分钟。"
    },
    {
      "original": "猪血",
      "substitute": "鸭血",
      "ratio": "250 克:250 克",
      "note": "更嫩，焯水时间减半。"
    }
  ],
  "variations": [
    "加一个卤蛋，配料更丰富。，这一点很关键。",
    "放一勺糟辣椒，酸辣更地道。，这一点很关键。"
  ],
  "serving_suggestion": "贵阳人的早餐，一碗下肚管到中午。",
  "storage": "面条与配料分开冷藏，各不超过一天。",
