  "equipment": [
    "汤锅",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用沸水烫 30 秒后去皮切块；金针菇去根撕散洗净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "番茄去皮后汤才细腻不涩。",
      "visual_cue": "番茄皮完整剥落、果肉成块"
    },
    {
      "n": 2,
      "text": "锅下 25ml 植物油，中火炒香蒜末与小米辣，下酸菜段炒 1 分钟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "酸菜先炒出酸香，汤味才立体。",
      "visual_cue": "酸菜边缘微焦、酸香散出"
    },
    {
      "n": 3,
      "text": "下番茄块与番茄酱中火炒 3 分钟，炒到番茄软烂出红汤。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄要炒到出沙，汤才浓。",
      "visual_cue": "番茄化成糊状、锅底红亮"
    },
    {
      "n": 4,
      "text": "加 800ml 清水大火烧开，加盐、白糖与白胡椒，转中火煮 5 分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先调好底味，再下肥牛。",
      "visual_cue": "汤色橙红、味道酸鲜"
    },
    {
      "n": 5,
      "text": "下金针菇煮 2 分钟，再逐片下肥牛，烫至变色立刻关火，淋白醋。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肥牛只需烫 30 秒，久煮就老。",
      "visual_cue": "肥牛卷舒展变白、边缘微卷"
    },
    {
      "n": 6,
      "text": "盛入深碗，撒蒜末、小米辣圈与香菜末，趁热食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蒜末最后撒，辛香才冲。",
      "visual_cue": "汤面红亮、配料翠绿点缀"
    }
  ],
  "tips": [
    "贵州酸汤有红酸与白酸两种，家庭做红酸用番茄最快。",
    "肥牛选雪花多的部位，烫后不柴。",
    "剩下的酸汤煮一把米线，酸爽开胃。"
  ],
  "common_mistakes": [
    "肥牛整把下锅，粘成团且受热不均。",
    "番茄没炒出沙就加水，汤色发白且寡淡。",
    "白醋一开始就放，久煮后酸味全挥发。"
  ],
  "substitutions": [
    {
      "original": "肥牛",
      "substitute": "牛肉",
      "ratio": "400g 肥牛 ≈ 350g 牛里脊",
      "note": "牛里脊需逆纹切薄片，多烫 20 秒。"
    },
    {
      "original": "酸菜",
      "substitute": "酸豆",
      "ratio": "100g 酸菜 ≈ 100g 酸豆",
      "note": "酸豆酸度更高，白醋减半。"
    }
  ],
  "variations": [
    "家庭简化版：用市售酸汤底料加清水，10 分钟出锅。",
    "凯里版：用发酵米汤做的白酸汤，酸味更清爽。"
  ],
  "serving_suggestion": "大碗装汤配米饭，酸汤泡饭是贵州人的日常吃法。",
  "storage": "冷藏 1 天，复热加 100ml 清水小火煮开，肥牛另烫后再放入。",
