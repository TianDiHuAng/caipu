  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加姜片、花椒和米酒，中火煮二十分钟。",
      "time_min": 24,
      "heat": "中火",
      "tip": "煮到筷子能轻松插透肉皮就行，煮过头切片会碎。",
      "visual_cue": "筷子插透无阻力，肉皮发软"
    },
    {
      "n": 2,
      "text": "煮好的五花肉捞出，放进冰水里泡五分钟让肉皮收紧。",
      "time_min": 7,
      "heat": "无火",
      "tip": "冰水一激，肉皮紧实，切出来的片才薄而不烂。",
      "visual_cue": "肉块发凉，表皮紧实有弹性"
    },
    {
      "n": 3,
      "text": "把肉块修成方形，逆着纹理切成两毫米厚的薄片，肥瘦相连。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切、切得薄，炒的时候才卷成灯盏窝。",
      "visual_cue": "肉片薄透见光，肥膘半透明"
    },
    {
      "n": 4,
      "text": "蒜苗斜切成三厘米长的段，蒜白和蒜叶分开放，豆豉剁碎。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜白耐炒先下，蒜叶嫩后下，分开才不老。",
      "visual_cue": "蒜白段厚实饱满，蒜叶青绿鲜亮"
    },
    {
      "n": 5,
      "text": "炒锅烧热倒植物油，下肉片中火慢煸到出油、边缘卷起成窝。",
      "time_min": 7,
      "heat": "中火",
      "tip": "煸到卷边出油，多余的油倒出来，吃着才不腻。",
      "visual_cue": "肉片打卷成窝状，锅里的油清亮"
    },
    {
      "n": 6,
      "text": "下豆豉、干辣椒段、姜片和蒜片，借锅里的猪油小火爆香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆豉一定要借猪油爆香，那股酱香是回锅肉的魂。",
      "visual_cue": "豆豉散开化油，辣椒转成深红色"
    },
    {
      "n": 7,
      "text": "沿锅边淋生抽和老抽，加白糖和盐翻匀，让每片肉都裹上酱色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "老抽只上色，两三毫升就够，盐要在这一步补进去，多了发黑发苦。",
      "visual_cue": "肉片均匀酱红，油光发亮不焦"
    },
    {
      "n": 8,
      "text": "下蒜白段大火翻炒三十秒，再下蒜叶炒二十秒，断生即可出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蒜苗断生就起锅，炒软了那股辛香就没了。",
      "visual_cue": "蒜苗翠绿挺直，肉片油亮挂汁"
    }
  ],
  "tips": [
    "五花肉煮到筷子能轻松插透就好，煮过头肉质松散，切片时一碰就碎。",
    "煮好的肉要冰水激一下，肉皮收紧后切片才薄而不烂，炒出来才能卷成灯盏窝。",
    "肉片一定要逆纹切薄，两毫米最合适。切厚了不卷，切顺纹嚼不动。",
    "煸肉时把多余的油倒出来，一是吃起来不腻，二是留下的油正好爆香豆豉和辣椒。"
  ],
  "common_mistakes": [
    "五花肉煮太久，切片一碰就碎。筷子能插透就立刻捞出。",
    "肉片切太厚，炒不卷还油腻。两毫米薄片，逆纹切。",
    "豆豉直接下锅不爆香，整道菜有一股生酱味。必须借猪油小火爆香。",
    "蒜苗和肉一起下锅，出锅时蒜苗已经软塌发黄。蒜白蒜叶分开，最后三十秒下。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "后腿肉",
      "ratio": "450克:450克",
      "note": "瘦一些不腻，需多煸一分钟出油。"
    },
    {
      "original": "豆豉",
      "substitute": "豆瓣酱",
      "ratio": "15克:20克",
      "note": "颜色更红亮，盐量要再减。"
    }
  ],
  "variations": [
    "把蒜苗换成青椒，做成青椒回锅肉。青椒要炒到起虎皮才香。",
    "加一勺糟辣椒同炒，酸辣味更正。这是贵州版回锅肉和川版最大的区别。",
    "用腊肉代替五花肉，做成腊肉回锅。烟熏香和蒜苗是绝配，冬天吃最香。"
  ],
  "serving_suggestion": "趁热装盘，肉片卷成一个个小窝、酱红油亮，蒜苗翠绿挺脆，一口下去肥而不腻、辣香满口，配白饭能吃三碗。",
  "storage": "冷藏可放两天，复热用炒锅大火快炒一分钟；蒜苗隔夜会发黄，建议挑出后再热。",
