  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉切成两厘米小块，冷水下锅焯去血沫后捞出冲净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅才能把血沫逼出来，汤才清。",
      "visual_cue": "水面浮起灰褐色沫子"
    },
    {
      "n": 2,
      "text": "汤锅下植物油，炒香洋葱丝、姜片与蒜末至微微透明。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱炒出甜味，汤底才不寡淡。",
      "visual_cue": "洋葱软塌，锅中香气浓"
    },
    {
      "n": 3,
      "text": "下羊肉块煸炒到表面微焦，加生抽炒匀上色。",
      "time_min": 6,
      "heat": "中火",
      "tip": "羊肉先煸再炖，汤更香也更不腥。",
      "visual_cue": "肉块表面褐亮，锅底有焦香"
    },
    {
      "n": 4,
      "text": "倒高汤煮开，加土豆与胡萝卜块，转小火炖二十五分钟。",
      "time_min": 26,
      "heat": "小火",
      "tip": "土豆后放会散，先炖至能用筷子插入。",
      "visual_cue": "土豆边缘微软，汤色转浓"
    },
    {
      "n": 5,
      "text": "放入番茄块与小米辣圈再煮五分钟，调盐定味。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄煮出酸味能解羊肉的腻。",
      "visual_cue": "汤面浮红油，番茄化开"
    },
    {
      "n": 6,
      "text": "另起锅把面条煮到八分熟，捞进汤中同煮两分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "面条单独煮，汤才不糊不浑。",
      "visual_cue": "面条柔软带芯，吸饱汤汁"
    },
    {
      "n": 7,
      "text": "盛入大碗撒上香菜段，趁热连汤带面一起吃掉。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜最后撒，香气才留得住。",
      "visual_cue": "碗面浮着油花，香菜翠绿"
    }
  ],
  "tips": [
    "用羊肉汤代替清水，鲜味差别很大。",
    "面条选宽面或手擀面，耐煮不糊。",
    "喜欢浓稠口感可把部分土豆压碎化进汤里。"
  ],
  "common_mistakes": [
    "羊肉不焯水直接炖，汤浑浊还带腥味。",
    "面条和汤一起从生煮到熟，汤变糊成浆。",
    "土豆炖到完全散开，汤变成一锅土豆泥。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "300 克:300 克",
      "note": "炖制时间延长十分钟，汤味更浓。"
    },
    {
      "original": "面条",
      "substitute": "米饭",
      "ratio": "300 克:300 克",
      "note": "做成汤泡饭，汤汁要多留一些。"
    }
  ],
  "variations": [
    "加一勺酥油同煮，是藏北牧区的高热量版本。",
    "把面换成面片，随手揪进锅里更家常。"
  ],
  "serving_suggestion": "盛在大碗里连汤带面，配一碟腌萝卜同食。",
  "storage": "冷藏两天、冷冻一个月；复热需加少许高汤防止过稠。",
