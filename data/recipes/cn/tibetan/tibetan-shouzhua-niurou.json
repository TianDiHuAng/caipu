  "steps": [
    {
      "n": 1,
      "text": "牛肉切成两拳大的块，用清水浸泡四十分钟泡出血水，中途换两次水。",
      "time_min": 42,
      "heat": "无火",
      "tip": "高原牛肉纤维粗，泡足血水炖出来才不腥。",
      "visual_cue": "肉块发白，水色由深红转淡"
    },
    {
      "n": 2,
      "text": "牛肉冷水下锅，加姜片与花椒，大火煮开撇净浮沫后捞出冲净表面。",
      "time_min": 14,
      "heat": "大火",
      "tip": "浮沫撇干净，汤才清亮，膻味也去得彻底。",
      "visual_cue": "水面浮起灰白沫，肉块收紧"
    },
    {
      "n": 3,
      "text": "汤锅重新加满清水，放入牛肉、姜片、蒜与洋葱块，大火烧开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水要一次加足量，中途添水会把汤味冲淡，肉也不容易炖到酥软。",
      "visual_cue": "汤面翻滚沸腾，表面泛起浮油"
    },
    {
      "n": 4,
      "text": "转小火加盖慢炖一小时，保持汤面微微冒泡不翻滚。",
      "time_min": 62,
      "heat": "小火",
      "tip": "小火慢炖肉才酥而不散，大火只会把汤煮浑。",
      "visual_cue": "汤色转成浅褐，肉块浮起"
    },
    {
      "n": 5,
      "text": "下萝卜块继续炖二十分钟，至萝卜透明、牛肉用筷子能插透。",
      "time_min": 22,
      "heat": "小火",
      "tip": "萝卜后放，久炖会化在汤里只剩一股甜水。",
      "visual_cue": "萝卜透亮，筷子一插即入"
    },
    {
      "n": 6,
      "text": "加盐与黑胡椒调味，盛出撒葱花，辣椒粉另装小碟供蘸食。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐最后放，早放肉不易炖软，这是炖肉的常理。",
      "visual_cue": "汤色清亮，表面浮少许油花"
    }
  ],
  "tips": [
    "牛肉选带筋膜的部位，炖软后胶质丰厚，比纯瘦更香。",
    "蘸碟里加一勺原汤调开辣椒粉，味道更贴肉。",
    "炖好的汤别倒，第二天煮面片是一绝。"
  ],
  "common_mistakes": [
    "牛肉不泡不焯直接炖，汤浑发腥，一股血味压不住。",
    "全程大火滚煮，肉块外层散烂，里面还咬不动。",
    "炖到一半加冷水，肉纤维骤然收紧，怎么炖都硬。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "1200克:1200克",
      "note": "羊肉更嫩，炖的时间减二十分钟。"
    },
    {
      "original": "萝卜",
      "substitute": "土豆",
      "ratio": "300克:300克",
      "note": "土豆易烂，炖的时间减到十分钟。"
    }
  ],
  "variations": [
    "把牛肉切成小块穿成串，用炭火烤，就是牧区的烤肉吃法。",
    "炖好后把肉捞出蘸椒盐干吃，汤另作面片汤，一菜两吃。"
  ],
  "serving_suggestion": "上手抓着啃最有味道，配一碗原汤与糌粑就是一顿正经的牧区饭。",
  "storage": "冷藏可存三天，复热须连汤小火加热至沸腾，肉块可另切薄片做凉片。",
