  "steps": [
    {
      "n": 1,
      "text": "面粉加两克盐和一百八十毫升清水，揉成光滑面团，盖布醒三十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "面和得稍硬一点，揪面片时才不会粘手。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 2,
      "text": "牛肉逆着纹理切成薄片，加生抽抓匀腌十分钟备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "逆着纹理下刀，煮出来才不会塞牙。",
      "visual_cue": "肉片薄透，颜色均匀"
    },
    {
      "n": 3,
      "text": "汤锅放植物油烧热，下洋葱丝和大蒜末炒三分钟出香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱要炒到透明，汤底才有自然的甜味。",
      "visual_cue": "洋葱透明，香气明显"
    },
    {
      "n": 4,
      "text": "倒入牛肉片大火翻炒到变色，再加番茄块炒出红汤。",
      "time_min": 5,
      "heat": "大火",
      "tip": "番茄炒出汁再加水，汤色才红亮。",
      "visual_cue": "牛肉变色，番茄出汁"
    },
    {
      "n": 5,
      "text": "加入一千六百毫升清水和土豆条，大火烧开转小火煮十五分钟。",
      "time_min": 17,
      "heat": "小火",
      "tip": "土豆煮到筷子能轻松插透就可以。",
      "visual_cue": "土豆变软，汤面微沸"
    },
    {
      "n": 6,
      "text": "面团搓成长条，用手揪成指甲大的面片，边揪边下进汤里。",
      "time_min": 10,
      "heat": "中火",
      "tip": "面片揪薄一点，厚了中心煮不透。",
      "visual_cue": "面片大小均匀，浮在汤面"
    },
    {
      "n": 7,
      "text": "面片全部浮起后加盐调味，再煮三分钟撒香菜出锅。",
      "time_min": 6,
      "heat": "中火",
      "tip": "面片浮起再煮三分钟，中心才熟。",
      "visual_cue": "面片鼓起，汤色红亮"
    }
  ],
  "tips": [
    "面团醒足时间，揪出来的面片才不易断裂。",
    "番茄一定要炒出汁，汤底才有自然的酸甜。",
    "面片要揪得薄且大小一致，熟度才均匀。"
  ],
  "common_mistakes": [
    "面团和得太软，揪片的时候粘成一团。",
    "番茄没炒出汁就加水，汤色清淡无味。",
    "面片揪得太厚，外面烂了中间还有生面。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "300 克:300 克",
      "note": "风味更浓，需多加姜末去膻。"
    },
    {
      "original": "番茄",
      "substitute": "番茄酱",
      "ratio": "200 克:60 克",
      "note": "汤色更红，酸味更集中。"
    }
  ],
  "variations": [
    "加一把白萝卜丝同煮，汤味更清甜。",
    "出锅前淋一勺酥油，香气更藏式。"
  ],
  "serving_suggestion": "盛在木碗里连汤带面一起吃，配一壶酥油茶，是藏区最常见的一碗热汤面。",
  "storage": "面片冷藏易糊，建议现煮现吃；汤底可冷藏两天，复热后再下面片。",
