  "equipment": [
    "汤锅",
    "和面盆",
    "擀面杖",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加少许盐和清水，揉成偏硬的面团，盖布醒二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "面硬一点，揪出的疙瘩才筋道。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 2,
      "text": "羊肉切成一厘米小丁，白萝卜与胡萝卜也切成同样大小。",
      "time_min": 10,
      "heat": "无火",
      "tip": "大小一致，熟的时间才同步。",
      "visual_cue": "丁粒均匀，大小相近"
    },
    {
      "n": 3,
      "text": "汤锅烧热倒植物油，下羊肉丁中火煸到表面变色。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煸出油再炖，汤才不寡淡。",
      "visual_cue": "肉丁发白，锅底有油"
    },
    {
      "n": 4,
      "text": "下洋葱碎、蒜末与姜末炒香，再放生抽翻匀。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料炒透，汤头才不腥。",
      "visual_cue": "洋葱透明，香气上升"
    },
    {
      "n": 5,
      "text": "加入白萝卜丁与胡萝卜丁翻炒两分钟，倒入清水煮开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水一次加够，中途加水汤味会淡。",
      "visual_cue": "汤面翻滚，浮沫撇净"
    },
    {
      "n": 6,
      "text": "转小火炖十五分钟，把面团揪成指甲盖大的疙瘩下锅。",
      "time_min": 15,
      "heat": "小火",
      "tip": "揪一块下锅一块，防止粘成团。",
      "visual_cue": "疙瘩浮起，粒粒分明"
    },
    {
      "n": 7,
      "text": "再煮五分钟直到面疙瘩熟透，尝汤后加盐调味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "尝汤定咸淡，比尝疙瘩准。",
      "visual_cue": "疙瘩咬开没有白心"
    },
    {
      "n": 8,
      "text": "撒上小葱末与香菜末即可关火，盛入深碗趁热吃。",
      "time_min": 2,
      "heat": "小火",
      "tip": "葱末最后放，绿色才好看。",
      "visual_cue": "汤清不浑，浮着葱绿"
    }
  ],
  "tips": [
    "揪疙瘩时手上抹点油，不粘手也不粘连。",
    "羊肉带点肥膘，煨出来的汤才够香。",
    "面疙瘩下锅后不要马上搅，等定型再推。"
  ],
  "common_mistakes": [
    "面团和得太软，揪下锅就糊成一片。",
    "疙瘩下锅立刻搅动，全粘在一起。",
    "萝卜和肉一起下锅炖，萝卜烂成泥。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "300 克:300 克",
      "note": "选牛腩，炖制时间延长十分钟。"
    },
    {
      "original": "白萝卜",
      "substitute": "土豆",
      "ratio": "200 克:200 克",
      "note": "汤汁更稠，口感更绵。"
    }
  ],
  "variations": [
    "加一勺酥油，汤头更厚，接近牧区做法。",
    "放几个包了馅的小面球进去，象征团圆。"
  ],
  "serving_suggestion": "盛入深碗，撒葱花，配糌粑一起上桌。",
  "storage": "冷藏两天，复热时加清水，避免疙瘩吸汤发糊。",
