          "name_en": "onion",
          "amount": 200,
          "unit": "g",
          "note": "切细丁",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 15,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 7,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "拌馅",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 230,
          "unit": "ml",
          "note": "和面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸笼",
    "擀面杖",
    "和面盆",
    "蒸锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉倒进盆里，分次加清水，边加边用筷子搅成絮状。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水别一次倒完，面团软硬才好掌握。",
      "visual_cue": "面絮均匀，盆底无干粉"
    },
    {
      "n": 2,
      "text": "揉成光滑的面团，盖上湿布静置醒三十分钟。",
      "time_min": 30,
      "heat": "无火",
      "tip": "醒够时间，擀皮才不回缩。",
      "visual_cue": "面团细腻，按压缓慢回弹"
    },
    {
      "n": 3,
      "text": "羊肉剁成粗粒的羊肉粒，肥瘦相间，千万别剁成泥。",
      "time_min": 12,
      "heat": "无火",
      "tip": "粗粒有嚼头，蒸出来才多汁。",
      "visual_cue": "羊肉粒颗粒分明，略带黏性"
    },
    {
      "n": 4,
      "text": "洋葱切细丁，与姜末一起拌进羊肉粒，加盐与植物油搅匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "洋葱出水，馅才不干，汁水足。",
      "visual_cue": "馅料湿润发亮，闻着辛香"
    },
    {
      "n": 5,
      "text": "面团搓成长条，切成小剂子，再逐个按成圆扁片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "剂子大小一致，蒸的时间才好统一。",
      "visual_cue": "剂子圆整，大小相仿"
    },
    {
      "n": 6,
      "text": "擀成中间厚、边缘薄的圆皮，直径大约八厘米。",
      "time_min": 10,
      "heat": "无火",
      "tip": "中间厚托得住馅，边缘薄好捏合。",
      "visual_cue": "圆皮薄厚过渡自然，不破边"
    },
    {
      "n": 7,
      "text": "取一张皮放馅，捏出半月形褶子，收口捏紧。",
      "time_min": 12,
      "heat": "无火",
      "tip": "褶子捏密实，蒸时才不漏汤。",
      "visual_cue": "形如半月，褶纹均匀立挺"
    },
    {
      "n": 8,
      "text": "蒸笼铺湿布，馍馍之间留空隙，水开后大火蒸十五分钟。",
      "time_min": 15,
      "heat": "大火",
      "tip": "留空隙，蒸熟膨胀才不粘成一团。",
      "visual_cue": "馍馍鼓起发亮，皮透出肉色"
    },
    {
      "n": 9,
      "text": "关火后再焖三分钟才开盖，趁热蘸着辣酱吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "焖三分钟，皮不塌陷不回缩。",
      "visual_cue": "表皮光洁，拿起来不粘手"
    }
  ],
  "tips": [
    "面团要醒足半小时，擀皮才不回缩、不破口。",
    "羊肉剁粗粒别剁泥，蒸出来才有汁有嚼头。",
    "蒸好焖三分钟再开盖，皮面才不会骤然塌陷。"
  ],
  "common_mistakes": [
    "面没醒就擀，皮一擀就缩，包不住馅。",
    "馅里不放洋葱，蒸出来干柴没汁水。",
    "蒸好立刻开盖，冷气一激，馍馍全塌成扁的。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "羊排",
      "ratio": "500 克:500 克",
      "note": "带骨肉更香，馅里须剔除骨渣。"
    },
    {
      "original": "洋葱",
      "substitute": "蒜苗",
      "ratio": "200 克:150 克",
      "note": "辛香更冲，盐可略减。"
    }
  ],
  "variations": [
    "馅里加一勺融化酥油，香气更浓，是牧区做法。",
    "用牦牛腩做馅，味道更野，膻香更足。"
  ],
  "serving_suggestion": "配一碗酥油茶或辣酱，热气腾腾地吃，是拉萨街头的日常早点。",
  "storage": "生坯冷冻可存两周，蒸时不用解冻，多加五分钟。",
