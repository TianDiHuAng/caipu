    "汤锅",
    "擀面杖",
    "锅铲",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加少许盐，分次倒入温水揉成偏硬的面团，盖布醒二十分钟。",
      "time_min": 24,
      "heat": "无火",
      "tip": "面要和硬一些，揪片才筋道，煮了不烂。",
      "visual_cue": "面团紧实光滑，按压回弹快"
    },
    {
      "n": 2,
      "text": "牛肉切小薄片，加生抽抓匀腌十分钟；萝卜与青椒切片备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉片尽量切薄一些，短时间快炒也能熟透，不会外面焦里面生。",
      "visual_cue": "肉片薄而完整，表面泛黏"
    },
    {
      "n": 3,
      "text": "汤锅烧开水，面团搓成长条揪成指甲大的面片下锅，煮到浮起。",
      "time_min": 6,
      "heat": "大火",
      "tip": "揪得薄厚一致，一起熟，不然后面炒不透。",
      "visual_cue": "面片浮在水面，边缘透亮"
    },
    {
      "n": 4,
      "text": "面片捞出来过一遍凉水，沥干之后拌少许油防止粘连。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过凉水锁住筋道，拌油是为了不粘成坨。",
      "visual_cue": "面片分明不粘连，表面有油光"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧热，下牛肉片大火炒到变色，盛出备用。",
      "time_min": 3,
      "heat": "大火",
      "tip": "先把肉炒好盛出，再炒菜，肉的汁水也不会白白流失。",
      "visual_cue": "肉片卷边变色，锅底无血水"
    },
    {
      "n": 6,
      "text": "原锅下洋葱、蒜末炒香，加萝卜片与小半碗水焖三分钟至软。",
      "time_min": 4,
      "heat": "中火",
      "tip": "萝卜稍焖才软，硬着和面片一起炒会夹生。",
      "visual_cue": "萝卜片变得透明发软，边缘卷起"
    },
    {
      "n": 7,
      "text": "倒回牛肉片与面片，加生抽、辣椒粉与盐大火快炒两分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "面片下锅之后要不停地翻动，一停下来就会粘锅焦底。",
      "visual_cue": "面片裹上酱色，锅中不见汤水"
    },
    {
      "n": 8,
      "text": "下青椒块与葱段翻炒半分钟，关火拌入酥油出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "酥油最后拌，奶香不挥发，风味才正。",
      "visual_cue": "青椒翠绿挺立，面片油亮分明"
    }
  ],
  "tips": [
    "面片可一次揪好冷冻，随吃随煮，省事不少。",
    "加一勺糌粑同炒，汤汁收得更干，口感更厚。",
    "喜欢汤多的可少炒一会儿，留些汤汁更润口。"
  ],
  "common_mistakes": [
    "面和得太软，揪片下锅就散，捞起来一锅面糊。",
    "面片煮熟后不过凉水，炒的时候全粘成一团。",
    "火太小慢慢炒，面片吸油出水，出锅一汪油。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "面条",
      "ratio": "300克:300克",
      "note": "用宽面条切段代替，省去和面时间。"
    },
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "200克:200克",
      "note": "羊肉更香，腌时可省去生抽。"
    }
  ],
  "variations": [
    "把面片换成青稞面片，藏味更足，口感更粗粝。",
    "加一把泡软的粉丝同炒，吸汁后更滑口。"
  ],
  "serving_suggestion": "一盘顶饱，配一碗清汤或酥油茶，是牧区最常见的午饭。",
  "storage": "冷藏可存一天，复热须大火快炒，加水会令面片发黏。",
