  "steps": [
    {
      "n": 1,
      "text": "酵母用两百毫升温水化开，倒入面粉揉成柔软的面团，盖上湿布醒发。",
      "time_min": 15,
      "heat": "无火",
      "tip": "面团要比做馒头软一些，包馅才不容易破。",
      "visual_cue": "面团光滑柔软，按压留浅坑"
    },
    {
      "n": 2,
      "text": "牛肉剁成细腻的碎末，加盐、生抽、花椒粉、姜末与黑胡椒，顺一个方向搅到发黏。",
      "time_min": 12,
      "heat": "无火",
      "tip": "顺着一个方向搅打，牛肉才上劲，煎的时候不出汤水。",
      "visual_cue": "馅料黏稠抱团，挑起不散"
    },
    {
      "n": 3,
      "text": "洋葱切细末挤去部分水分，拌入牛肉碎里，撒葱花再充分拌匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "洋葱挤掉水防止出汤，留一点汁水肉才不干。",
      "visual_cue": "馅料湿润不流汤，洋葱粒分明"
    },
    {
      "n": 4,
      "text": "面团发酵至一倍半大，取出揉匀排气，分成八个大小相同的剂子。",
      "time_min": 60,
      "heat": "无火",
      "tip": "面团发到一倍半大就够，发过了头饼皮会带一点酸味。",
      "visual_cue": "面团膨起，指按留窝缓慢回弹"
    },
    {
      "n": 5,
      "text": "剂子擀成中间厚边缘薄的圆皮，包入馅料，收口捏紧后按成扁饼。",
      "time_min": 10,
      "heat": "无火",
      "tip": "收口一定要捏死，煎的时候漏汤就废了。",
      "visual_cue": "饼坯厚薄均匀，收口朝下平整"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油烧热，饼坯收口朝下摆入，小火煎十分钟至底面金黄。",
      "time_min": 11,
      "heat": "小火",
      "tip": "小火慢煎，皮才熟得透，火大外面焦里面生。",
      "visual_cue": "底面金黄结壳，饼身鼓起"
    },
    {
      "n": 7,
      "text": "翻面再煎八分钟，两面金黄、按压回弹即可出锅。",
      "time_min": 9,
      "heat": "小火",
      "tip": "用手指按压饼面，能立刻回弹就说明里面已经熟透了。",
      "visual_cue": "两面金黄，饼皮微微起层"
    }
  ],
  "tips": [
    "面团里加一勺酥油同揉，饼皮更酥，藏区都这样做。",
    "馅里加少许剁碎的萝卜，口感更清爽多汁，也不容易发干。",
    "一次可多做几个，冷冻后回锅干烙同样好吃。"
  ],
  "common_mistakes": [
    "面团太硬，擀开的皮包不住馅，一煎就裂。",
    "牛肉剁得太细又搅得过猛，包的时候直漏汤，饼底一片湿黏。",
    "全程大火，饼皮焦黑，咬开肉馅还是生的。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "300克:300克",
      "note": "羊肉馅更香，可省去花椒粉。"
    },
    {
      "original": "洋葱",
      "substitute": "韭黄",
      "ratio": "120克:100克",
      "note": "韭黄更清甜，拌馅时不用挤水。"
    }
  ],
  "variations": [
    "把饼坯做成小圆包上锅蒸，就是藏族的肉包子馍馍。",
    "馅里拌入炒熟的青稞粉，口感更扎实，是牧区的做法。"
  ],
  "serving_suggestion": "趁热咬开最好吃，配一碗酥油茶就是藏区的一顿正餐。",
  "storage": "冷藏可存两天，复热须平底锅小火干烙三分钟，微波会令饼皮发韧。",
