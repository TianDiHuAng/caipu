  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆纹切成筷子粗的条，加生抽与少许清水抓匀，腌十分钟上浆。",
      "time_min": 12,
      "heat": "无火",
      "tip": "加一点水抓进去，牛肉炒出来才嫩不发柴。",
      "visual_cue": "肉条发黏泛光，抓起不掉汁"
    },
    {
      "n": 2,
      "text": "芹菜撕去老筋，切成四厘米长的段，粗的从中间剖开。",
      "time_min": 8,
      "heat": "无火",
      "tip": "芹菜撕掉老筋再切段，嚼起来才脆爽，不会一根筋塞牙。",
      "visual_cue": "芹菜段青翠，断面平整"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到冒烟，下花椒粒爆香后捞出，倒入牛肉条大火快炒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅一定要烧到够热再下肉，肉条才焦香，不会在锅里出水。",
      "visual_cue": "肉条变色卷边，锅底无汤水"
    },
    {
      "n": 4,
      "text": "肉条变色后下姜末、蒜末与洋葱丝，翻炒到洋葱变软出甜味。",
      "time_min": 2,
      "heat": "大火",
      "tip": "洋葱炒软才有甜味，硬着下芹菜会抢味。",
      "visual_cue": "洋葱透明卷边，锅中飘香"
    },
    {
      "n": 5,
      "text": "倒入芹菜段大火翻炒一分钟，加辣椒粉与盐快速翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "芹菜只炒到断生，脆感才在，久炒发黄失味。",
      "visual_cue": "芹菜翠绿挺立，油光均匀"
    },
    {
      "n": 6,
      "text": "关火前放一小块酥油进去翻匀，趁热立刻出锅装盘上桌。",
      "time_min": 1,
      "heat": "小火",
      "tip": "酥油最后放，奶香才不挥发，这是藏式的点睛。",
      "visual_cue": "菜面挂着一层奶香油光，香气扑鼻"
    }
  ],
  "tips": [
    "芹菜叶别全扔，嫩的留一把最后撒上，香气更足。",
    "牛肉可先用小苏打抓两分钟再冲净，肉质更嫩。",
    "加一勺糌粑同炒，汤汁能收得更干，是牧区吃法。"
  ],
  "common_mistakes": [
    "牛肉顺纹切，炒好咬不动，一根筋卡在牙缝里。",
    "锅不热就下肉，牛肉在锅里慢慢出水，炒成炖肉。",
    "芹菜炒过头，颜色发黄发暗，脆劲全无。"
  ],
  "substitutions": [
    {
      "original": "芹菜",
      "substitute": "青椒",
      "ratio": "300克:250克",
      "note": "青椒更清甜，炒的时间减半分钟。"
    },
    {
      "original": "酥油",
      "substitute": "黄油",
      "ratio": "10克:10克",
      "note": "黄油奶香稍淡，可多加五克。"
    }
  ],
  "variations": [
    "把芹菜换成蒜苗同炒，辛香更冲，配酥油茶很搭。",
    "加一把泡软的粉丝同炒，吸汁后更下饭。"
  ],
  "serving_suggestion": "配米饭或糌粑都合适，牛肉的油香与芹菜的清口正互补。",
  "storage": "冷藏可存一天，复热须大火快炒，久热芹菜会发黄。",
