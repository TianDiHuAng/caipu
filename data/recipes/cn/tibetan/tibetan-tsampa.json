  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "青稞",
          "name_en": "highland barley",
          "amount": 300,
          "unit": "g",
          "note": "选干净饱满的青稞粒",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酥油",
          "name_en": "ghee",
          "amount": 60,
          "unit": "g",
          "note": "室温软化",
          "optional": false
        },
        {
          "name": "酥油茶",
          "name_en": "butter tea",
          "amount": 250,
          "unit": "ml",
          "note": "趁热用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 20,
          "unit": "g",
          "note": "依口味增减",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "少量提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "石磨或破壁机",
    "木碗",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青稞挑去杂质和空壳，用清水淘洗两遍后沥干水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "淘洗后一定要沥干，炒时才不粘锅。",
      "visual_cue": "青稞表面无浮尘与杂质"
    },
    {
      "n": 2,
      "text": "炒锅烧热不放油，青稞下锅小火干炒十分钟。",
      "time_min": 10,
      "heat": "小火",
      "tip": "不停翻动，炒到粒粒爆开才算好。",
      "visual_cue": "青稞微黄，不断爆响"
    },
    {
      "n": 3,
      "text": "炒好的青稞摊开在竹匾上晾凉，同时散去多余水汽。",
      "time_min": 5,
      "heat": "无火",
      "tip": "热着磨会返潮结块。",
      "visual_cue": "颗粒干爽，一捏即碎"
    },
    {
      "n": 4,
      "text": "青稞倒入石磨或破壁机，磨成带少许颗粒的细粉。",
      "time_min": 5,
      "heat": "无火",
      "tip": "磨得太细冲出来发黏，留点颗粒更香。",
      "visual_cue": "粉质均匀，有麦香"
    },
    {
      "n": 5,
      "text": "木碗里放青稞粉、酥油、白糖与少许盐，倒入热酥油茶。",
      "time_min": 3,
      "heat": "无火",
      "tip": "茶要八十五度以上，酥油才化得开。",
      "visual_cue": "酥油融化浮在表面"
    },
    {
      "n": 6,
      "text": "用食指沿碗边把粉往中间压，边压边转碗搅成团。",
      "time_min": 4,
      "heat": "无火",
      "tip": "手指贴着碗壁压，比勺子搅得匀。",
      "visual_cue": "粉团抱紧，碗壁干净"
    },
    {
      "n": 7,
      "text": "取一小块手捏成紧实的圆团，配一口热酥油茶送下。",
      "time_min": 3,
      "heat": "无火",
      "tip": "捏得紧才不掉渣，吃着方便。",
      "visual_cue": "团块紧实，不散不粘手"
    }
  ],
  "tips": [
    "青稞必须炒熟再磨，生粉冲出来又腥又黏。",
    "酥油茶要趁热倒，温度不够捏不成团。",
    "白糖可换成红糖，风味更浓一些。"
  ],
  "common_mistakes": [
    "青稞没炒透就磨，成品带生谷味。",
    "酥油茶倒太少，粉团干散捏不成形。",
    "一次倒的茶太多，糌粑直接变成稀糊。"
  ],
  "substitutions": [
    {
      "original": "青稞",
      "substitute": "燕麦",
      "ratio": "300 克:300 克",
      "note": "香气略淡，炒制时间缩短两分钟。"
    },
    {
      "original": "酥油",
      "substitute": "黄油",
      "ratio": "60 克:60 克",
      "note": "奶香更甜，但少了牦牛酥油的厚重。"
    }
  ],
  "variations": [
    "加一小把奶酪碎一起捏，咸香更突出。",
    "用红糖替代白糖，颜色偏褐，回味更深。"
  ],
  "serving_suggestion": "用木碗装着，配一壶热酥油茶，边捏边吃。",
  "storage": "青稞粉密封干燥存放一个月，捏好的糌粑当天吃完。",
