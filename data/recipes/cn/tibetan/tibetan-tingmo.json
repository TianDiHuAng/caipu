    "total_min": 130
  },
  "servings": 4,
  "flavor": [
    "light",
    "savory",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 6,
          "unit": "g",
          "note": "干酵母",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "帮助发酵",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 215,
          "unit": "ml",
          "note": "温水",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 10,
          "unit": "ml",
          "note": "抹面防粘",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "和面盆",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "温水中加白糖与酵母搅匀，静置八分钟到表面起泡沫。",
      "time_min": 8,
      "heat": "无火",
      "tip": "起泡说明酵母活跃，发酵才稳。",
      "visual_cue": "水面浮起一层细密泡沫"
    },
    {
      "n": 2,
      "text": "面粉加盐混匀，倒入酵母水，用筷子搅成面絮状。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐先与面粉拌，避免抑制酵母。",
      "visual_cue": "面粉搅成均匀的面絮状"
    },
    {
      "n": 3,
      "text": "揉成偏硬的面团，在案板上揉十分钟到表面光滑。",
      "time_min": 10,
      "heat": "无火",
      "tip": "面团偏硬，蒸出来才挺立不塌。",
      "visual_cue": "面团光滑，按压缓慢回弹"
    },
    {
      "n": 4,
      "text": "面团放回盆中盖湿布，温暖处发酵一小时到两倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "发到两倍，内部才有蜂窝孔。",
      "visual_cue": "体积翻倍，手指按压留浅坑"
    },
    {
      "n": 5,
      "text": "取出面团轻拍排气，擀成一厘米厚的长方片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "擀得均匀，卷起来层次才整齐。",
      "visual_cue": "面片各处厚薄完全一致"
    },
    {
      "n": 6,
      "text": "面片表面刷一层植物油，从长边卷成紧实的长条。",
      "time_min": 3,
      "heat": "无火",
      "tip": "卷紧一些，切出来层次才明显。",
      "visual_cue": "面卷紧实，无空隙"
    },
    {
      "n": 7,
      "text": "长条切成四段，切口朝上摆在蒸屉里，醒十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "二次醒发让面卷重新膨胀。",
      "visual_cue": "生坯略膨胀，手感变轻"
    },
    {
      "n": 8,
      "text": "蒸锅水开后放上蒸屉，盖盖大火蒸十八分钟左右。",
      "time_min": 18,
      "heat": "大火",
      "tip": "水开再上锅，蒸汽足才发得起来。",
      "visual_cue": "饼身膨胀，表面光滑发亮"
    },
    {
      "n": 9,
      "text": "关火后先焖三分钟再开盖，取出趁热撕开食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "焖三分钟，饼皮才不回缩。",
      "visual_cue": "饼体饱满，按压回弹"
    }
  ],
  "tips": [
    "面团和得偏硬一些，蒸好才挺立不塌。",
    "卷的时候尽量卷紧，层次才明显。",
    "蒸完焖三分钟再开盖，避免回缩。"
  ],
  "common_mistakes": [
    "面团太软，蒸出来扁塌没有层次。",
    "水没开就上锅，饼发不起来发硬。",
    "关火后立刻开盖，饼皮瞬间回缩变硬。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "全麦面粉",
      "ratio": "400 克:400 克",
      "note": "口感更粗，水要多加二十毫升。"
    },
    {
      "original": "植物油",
      "substitute": "黄油",
      "ratio": "10 毫升:10 克",
      "note": "奶香更浓，适合配肉菜。"
    }
  ],
  "variations": [
    "卷面时撒一层辣椒粉，风味更足。",
    "面片上刷一层酥油再卷，香气更浓郁。"
  ],
  "serving_suggestion": "撕开配炖肉或蘸汤汁，当主食吃。",
  "storage": "冷藏两天、冷冻一个月，复蒸后食用。",
