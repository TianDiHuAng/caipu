  "steps": [
    {
      "n": 1,
      "text": "牛肉逆着纹理切成薄片，用清水冲两遍洗去表面血水，沥干备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "逆纹切，纤维断得干净，薄片入口才不塞牙。",
      "visual_cue": "肉片薄而完整，颜色浅红"
    },
    {
      "n": 2,
      "text": "牛肉片加少许盐与生抽抓匀，再拌入一小勺清水，腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "拌一点水进去，肉片下锅才嫩而不柴。",
      "visual_cue": "肉片发黏上浆，表面泛光"
    },
    {
      "n": 3,
      "text": "汤锅加清水，放姜片与花椒烧开，转小火煮五分钟出味。",
      "time_min": 7,
      "heat": "大火",
      "tip": "先把姜和花椒的味煮出来，汤底才不寡。",
      "visual_cue": "水中飘出姜与花椒的辛香"
    },
    {
      "n": 4,
      "text": "下萝卜片与洋葱丝小火煮十分钟，至萝卜片透明发软。",
      "time_min": 11,
      "heat": "小火",
      "tip": "萝卜要先煮透，汤里才有那股清甜味，硬着下肉会夹生。",
      "visual_cue": "萝卜片透亮，边缘变圆"
    },
    {
      "n": 5,
      "text": "转大火让汤微滚，牛肉片一片片抖散下锅，煮两分钟至变色。",
      "time_min": 3,
      "heat": "大火",
      "tip": "肉片要抖散下，粘成一坨就煮不透也咬不烂。",
      "visual_cue": "肉片卷边变色，汤面浮沫很少"
    },
    {
      "n": 6,
      "text": "撇净浮沫，加盐与黑胡椒调味，撒葱花与香菜段即可出锅。",
      "time_min": 2,
      "heat": "小火",
      "tip": "浮沫一定撇掉，汤才清得能照见碗底。",
      "visual_cue": "汤色清亮，葱花浮在表面"
    }
  ],
  "tips": [
    "牛肉片厚薄要一致，厚了煮不透，薄了一烫就老。",
    "汤里加两片干姜比鲜姜更出味，高原上常用干姜。",
    "喜欢重口的可另配一碟辣椒粉蘸肉吃。"
  ],
  "common_mistakes": [
    "牛肉顺着纹理切，煮好咬不动，嚼半天还是筋。",
    "肉片冷水下锅慢慢煮，血水全渗进汤里，汤浑还发腥。",
    "大火滚煮太久，肉片缩成硬块，一咬全是渣。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "500克:500克",
      "note": "羊肉片更嫩，煮的时间减半分钟。"
    },
    {
      "original": "萝卜",
      "substitute": "白菜",
      "ratio": "250克:300克",
      "note": "白菜易熟，煮的时间减到五分钟。"
    }
  ],
  "variations": [
    "把肉片换成牛肉末捏的小丸子，汤更鲜，适合老人小孩。",
    "汤里下一把青稞面条，就成了藏区的牛肉面汤。"
  ],
  "serving_suggestion": "饭前先喝一碗暖胃，也可以浇在糌粑上拌着吃，都合适。",
  "storage": "冷藏可存两天，复热须小火加热至沸腾，肉片不宜久煮。",
