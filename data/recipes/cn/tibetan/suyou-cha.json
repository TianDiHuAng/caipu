      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "主调味",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 800,
          "unit": "ml",
          "note": "煮茶",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "茶壶",
    "酥油茶桶",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "砖茶掰成碎块，放入小锅，加 800ml 清水大火烧开后转小火熬 15 分钟。",
      "time_min": 18,
      "heat": "小火",
      "tip": "茶汤熬到深褐发黑，滋味才厚重。",
      "visual_cue": "茶汤深褐、茶香浓郁"
    },
    {
      "n": 2,
      "text": "用细筛把茶渣滤掉，只留约 500ml 浓茶汤备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "滤得干净，喝起来才不涩口。",
      "visual_cue": "茶汤清澈透亮、滤网上无茶渣残留"
    },
    {
      "n": 3,
      "text": "趁茶汤滚烫倒入酥油茶桶，加 50g 酥油、200ml 牛奶与 6g 盐。",
      "time_min": 2,
      "heat": "无火",
      "tip": "茶汤必须够烫，酥油才化得开。",
      "visual_cue": "酥油块浮在茶汤表面"
    },
    {
      "n": 4,
      "text": "用桶内的搅拌杆上下抽打 40 下，让茶、油、奶充分乳化成浅褐色。",
      "time_min": 5,
      "heat": "无火",
      "tip": "抽打不足会分层，浮油漂在表面。",
      "visual_cue": "茶汤乳化均匀、表面无油花"
    },
    {
      "n": 5,
      "text": "倒入铜壶或暖壶中保温，趁热分小杯饮用，喝完再续。",
      "time_min": 2,
      "heat": "无火",
      "tip": "藏族人讲究喝三碗，暖身又抗高寒。",
      "visual_cue": "茶汤顺滑、咸香回甘"
    }
  ],
  "tips": [
    "高原地区用的砖茶更粗老，熬煮时间可延长到 20 分钟。",
    "没有酥油茶桶可用料理机低速打 30 秒替代，效果接近。",
    "第一次喝不宜过量，酥油脂肪含量高、肠胃需适应。"
  ],
  "common_mistakes": [
    "茶汤不够烫就下酥油，油凝固结块、口感油腻。",
    "抽打时间不足，茶奶油分层发腥。",
    "盐放得太多，茶香被咸味完全盖住，只剩齁咸。"
  ],
  "substitutions": [
    {
      "original": "酥油",
      "substitute": "黄油",
      "ratio": "50g 酥油 ≈ 55g 无盐黄油",
      "note": "黄油奶香更重，风味略有差异。"
    },
    {
      "original": "砖茶",
      "substitute": "普洱熟茶",
      "ratio": "15g 砖茶 ≈ 18g 熟普",
      "note": "熟普滋味柔和，熬 10 分钟即可。"
    }
  ],
  "variations": [
    "甜味版：不放盐，改加 15g 白糖，适合初次尝试者。",
    "加料版：加 20g 糌粑同打，茶汤更稠、更抗饿。"
  ],
  "serving_suggestion": "铜壶暖着，小木碗逐碗斟饮，配糌粑与风干肉是藏家待客之道。",
  "storage": "现打现喝最好，保温壶可存 4 小时，久放会分层需重新抽打。",
