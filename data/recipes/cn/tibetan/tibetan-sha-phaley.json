        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "擀面杖",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加水和成较软的面团，盖布静置半小时以上。",
      "time_min": 35,
      "heat": "无火",
      "tip": "面团软一点，擀薄后煎出来才有酥软层次。",
      "visual_cue": "面团柔软光滑，不粘手"
    },
    {
      "n": 2,
      "text": "牛肉切成半厘米小丁，筋膜要剔干净免得太韧。",
      "time_min": 12,
      "heat": "无火",
      "tip": "牛肉丁切得越小越好，煎时容易熟透。",
      "visual_cue": "肉丁细碎均匀，无白色筋膜"
    },
    {
      "n": 3,
      "text": "洋葱切细丁，与姜末、盐和黑胡椒一起拌进牛肉馅里。",
      "time_min": 8,
      "heat": "无火",
      "tip": "姜末能压住牛肉的腥，别用姜粉代替。",
      "visual_cue": "馅料抱团，香气辛甜"
    },
    {
      "n": 4,
      "text": "面团分小剂子擀成薄圆皮，铺上一半馅料，对面折起成半月形。",
      "time_min": 15,
      "heat": "无火",
      "tip": "折成半月形后压边，用叉子压出花纹更牢固。",
      "visual_cue": "边缘压紧，馅料分布均匀"
    },
    {
      "n": 5,
      "text": "平底锅倒植物油，中小火下饼煎至底面金黄约四分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "油量到饼身三分之一高度，煎得透而不腻。",
      "visual_cue": "底面金黄，边缘起小泡"
    },
    {
      "n": 6,
      "text": "翻面加两大勺水加盖焖五分钟，再开盖收干水分。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "加水焖能让厚馅透熟，皮也不会焦。",
      "visual_cue": "锅内水干，饼身鼓起"
    },
    {
      "n": 7,
      "text": "出锅前再煎半分钟让表面回脆，切开趁热吃。",
      "time_min": 2,
      "heat": "中火",
      "tip": "回煎让被蒸汽软化的皮重新变脆。",
      "visual_cue": "两面焦脆，刀切有声"
    }
  ],
  "tips": [
    "牛肉可掺一小块牛脂肪，煎出来更香。",
    "加水加盖焖是关键，否则皮煎黑了而馅还是生的。",
    "饼别压得太扁，留点厚度才有汁水。"
  ],
  "common_mistakes": [
    "全程大火干煎，皮焦黑而馅还是生的。",
    "边缘没压牢，加水焖时馅料全流进锅里。",
    "面团太硬，擀开回缩难以延展包馅。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "400 克:400 克",
      "note": "加孜然三克去膻，风味更浓。"
    },
    {
      "original": "植物油",
      "substitute": "黄油",
      "ratio": "150 毫升:130 克",
      "note": "奶香突出，但需小火避免焦糊。"
    }
  ],
  "variations": [
    "馅料加一把切碎的小葱，辛香更冲。",
    "把半月形改成小圆饼，更容易压边不破。"
  ],
  "serving_suggestion": "趁热切开吃，配一碗酥油茶或咸奶茶。",
  "storage": "生坯冷冻一个月，煎时加水焖的时间延长三分钟；熟饼冷藏两天，复热干烙。",
