 "equipment": [
  "炒锅",
  "刀",
  "砧板",
  "碗"
 ],
 "steps": [
  {
   "n": 1,
   "text": "牛里脊逆着纹理切成两毫米厚的薄片，切好摊开备用。",
   "time_min": 8,
   "heat": "无火",
   "tip": "逆纹切，炒出来才嫩不塞牙，切好尽快下锅。",
   "visual_cue": "肉片薄而完整，纹理被切断"
  },
  {
   "n": 2,
   "text": "肉片加生抽、盐和一半黑胡椒抓匀，静置入味。",
   "time_min": 10,
   "heat": "无火",
   "tip": "抓到手感发黏，味道才挂得住，静置别少于十分钟。",
   "visual_cue": "肉片表面发亮，有黏性"
  },
  {
   "n": 3,
   "text": "炒锅烧到冒青烟，倒植物油滑锅，下牛里脊片大火快炒。",
   "time_min": 4,
   "heat": "大火",
   "tip": "锅一定要够热，肉片下锅才不出水。",
   "visual_cue": "肉片迅速变色，边缘焦香"
  },
  {
   "n": 4,
   "text": "肉片刚变白就下蒜末和干辣椒段，翻炒出香味。",
   "time_min": 3,
   "heat": "大火",
   "tip": "蒜末后下，早了会炒黑发苦，香味也差很多。",
   "visual_cue": "蒜末微黄，辣椒出香"
  },
  {
   "n": 5,
   "text": "倒入青椒丝和洋葱丝，继续大火翻炒到断生。",
   "time_min": 5,
   "heat": "大火",
   "tip": "配菜别炒过头，保持脆口更好吃。",
   "visual_cue": "青椒颜色鲜绿，洋葱略透明"
  },
  {
   "n": 6,
   "text": "撒剩下的黑胡椒和糌粑，快速翻匀让糌粑吸掉锅里的汤汁。",
   "time_min": 3,
   "heat": "中火",
   "tip": "糌粑分两次撒，一次撒多会结疙瘩。",
   "visual_cue": "锅内无流动汤汁，肉片挂薄芡"
  },
  {
   "n": 7,
   "text": "尝咸淡补盐，出锅装盘趁热吃，凉了肉会变紧。",
   "time_min": 2,
   "heat": "无火",
   "tip": "糌粑本身带咸味，补盐前先尝一口再决定。",
   "visual_cue": "色泽油亮，盘底无积水"
  }
 ],
 "tips": [
  "牛里脊逆纹切薄片，是这道菜嫩的关键。",
  "全程大火快炒，锅热油热才不出汤。",
  "糌粑分次撒入，收汁均匀不结块。"
 ],
 "common_mistakes": [
  "顺纹切肉，炒完又老又韧，咬着费劲还塞牙。",
  "锅没烧热就下肉片，出水一出就是一锅。",
  "糌粑一次全倒，锅里结满干粉疙瘩。"
 ],
 "substitutions": [
  {
   "original": "牛里脊",
   "substitute": "羊腿肉",
   "ratio": "500 克:500 克",
   "note": "牧区更常见的做法，膻香明显，炒制时间略短。"
  },
  {
   "original": "糌粑",
   "substitute": "玉米淀粉",
   "ratio": "30 克:10 克",
   "note": "只用来收汁，缺少青稞的焦香。"
  }
 ],
 "variations": [
  "加一把切段的蒜苗同炒，辛香更足也更清爽。",
  "喜欢更辣可换成小米椒，去掉干辣椒。"
 ],
 "serving_suggestion": "热盘盛出，配一壶酥油茶和一小份糌粑一起上桌。",
 "storage": "冷藏一天，复热用大火快炒三十秒，别久煮否则肉变柴。",
