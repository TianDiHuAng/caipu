  "steps": [
    {
      "n": 1,
      "text": "牛肉切成指甲盖大小的丁，用少许盐与生抽抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉丁切得小一些，短时间煮也能熟透入味，不至于夹生。",
      "visual_cue": "肉丁均匀，表面泛黏上浆"
    },
    {
      "n": 2,
      "text": "萝卜与蘑菇都切成同样大小的丁，洋葱与姜切末备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "几样料切得一样大，入口才有层次不乱。",
      "visual_cue": "各处丁块大小相近，堆在案上整齐"
    },
    {
      "n": 3,
      "text": "汤锅放酥油小火化开，下洋葱末与姜末炒到透明出香。",
      "time_min": 3,
      "heat": "小火",
      "tip": "酥油别烧到冒烟，一冒烟就带焦苦味。",
      "visual_cue": "洋葱透明卷边，锅中飘出奶香"
    },
    {
      "n": 4,
      "text": "下牛肉丁转中火炒到变色，加萝卜丁与蘑菇片翻炒一分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "牛肉先炒到变色再添水，煮出来的汤才香不腥，这点很关键。",
      "visual_cue": "肉丁变色收紧，蘑菇出水"
    },
    {
      "n": 5,
      "text": "加清水八百毫升烧开，转小火煮十分钟至萝卜丁软透。",
      "time_min": 12,
      "heat": "小火",
      "tip": "水别太多，后面还要下糌粑，太稀就成清汤了。",
      "visual_cue": "萝卜丁透明，汤色微黄"
    },
    {
      "n": 6,
      "text": "糌粑用少量凉水调成稀糊，缓缓淋入锅中，边淋边搅防结块。",
      "time_min": 3,
      "heat": "小火",
      "tip": "糌粑一定要先用凉水调开，直接撒进热汤必结疙瘩。",
      "visual_cue": "汤体变稠，看不见干粉颗粒"
    },
    {
      "n": 7,
      "text": "小火煮三分钟至汤浓稠，加盐与黑胡椒调味，撒葱花出锅。",
      "time_min": 4,
      "heat": "小火",
      "tip": "煮时要不停搅动，糌粑沉底极易糊锅。",
      "visual_cue": "汤面泛油光，稠度能挂勺"
    }
  ],
  "tips": [
    "糌粑选细磨的，调糊后口感顺滑，不会有粗颗粒。",
    "加一小块黄油同煮，奶香更浓，是牧区的做法。",
    "喜欢稠一点的可多放两勺糌粑，边加边看稠度。"
  ],
  "common_mistakes": [
    "糌粑直接撒进滚汤，结成一锅硬疙瘩，怎么搅都散不开。",
    "全程大火煮，糌粑沉底糊锅，一股焦味盖过所有香气。",
    "水加太多，成品稀得像汤水，喝不出糌粑的厚重。"
  ],
  "substitutions": [
    {
      "original": "糌粑",
      "substitute": "面粉",
      "ratio": "150克:130克",
      "note": "面粉更细，调糊时水要多一些。"
    },
    {
      "original": "蘑菇",
      "substitute": "香菇",
      "ratio": "80克:70克",
      "note": "香菇味更浓，可省去黑胡椒。"
    }
  ],
  "variations": [
    "把牛肉丁换成羊肉丁，膻香与酥油最搭，是藏北的吃法。",
    "汤里加一把青稞粒同煮，口感更有嚼劲。"
  ],
  "serving_suggestion": "趁热喝最暖胃，配一块干硬的饼或直接当一顿主食。",
  "storage": "冷藏可存一天，复热须加少量开水小火搅匀，糌粑久放会沉底结块。",
