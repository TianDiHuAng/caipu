          "amount": 800,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 600,
          "unit": "ml",
          "note": "煮茶",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 45,
          "unit": "g",
          "note": "按口味增减",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "一撮提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "细滤网",
    "茶壶",
    "马克杯",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅倒清水烧开，放入红茶，转小火煮五分钟到汤色深红。",
      "time_min": 8,
      "heat": "中火",
      "tip": "用碎茶出味快，茶汤才够浓，整叶茶要多煮两分钟。",
      "visual_cue": "茶汤深红透亮，茶香浓"
    },
    {
      "n": 2,
      "text": "用细滤网把茶叶滤掉，茶汤倒回干净的锅里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "滤得越干净口感越顺，茶渣留在里面会越煮越涩。",
      "visual_cue": "茶汤清澈透亮，滤网里留满茶渣"
    },
    {
      "n": 3,
      "text": "茶汤小火加热，倒入牛奶，边倒边用木勺搅动。",
      "time_min": 4,
      "heat": "小火",
      "tip": "慢慢倒、轻轻搅，奶与茶才融得匀，不会分层。",
      "visual_cue": "汤色转为奶褐，表面平滑"
    },
    {
      "n": 4,
      "text": "加白糖与一小撮盐，小火加热到边上冒小泡，不要滚沸。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盐只是提味，一小撮就够，多了整锅变咸奶茶。",
      "visual_cue": "表面冒细泡，甜香浮起"
    },
    {
      "n": 5,
      "text": "保持小火再煮三分钟，让茶与奶的味道彻底融合。",
      "time_min": 4,
      "heat": "小火",
      "tip": "这一步叫熬，时间短了味道分层，喝起来像兑水。",
      "visual_cue": "茶奶融合，气味醇厚"
    },
    {
      "n": 6,
      "text": "关火静置一分钟，撇去表面浮沫，再倒进茶壶。",
      "time_min": 3,
      "heat": "无火",
      "tip": "撇净浮沫口感更顺，倒的时候也好看。",
      "visual_cue": "液面干净，无浮沫"
    },
    {
      "n": 7,
      "text": "从茶壶倒进马克杯，趁热喝，喝前轻轻晃一下杯身。",
      "time_min": 2,
      "heat": "无火",
      "tip": "甜茶放到温热最香，太烫尝不出奶甜。",
      "visual_cue": "杯中奶褐色，热气袅袅"
    }
  ],
  "tips": [
    "红茶选碎滇红或阿萨姆，茶味压得住牛奶。",
    "喜欢更甜可以加到六十克糖，藏地口味偏甜。",
    "用全脂牛奶，脱脂的喝起来发薄，没有回甘。",
    "剩下的甜茶冷藏后当冰饮也好喝，风味更清爽。"
  ],
  "common_mistakes": [
    "茶煮得不够浓，加奶后只剩奶味，喝不出茶香。",
    "大火把奶煮滚，奶皮结块，整锅起渣。",
    "糖一次加太多，甜味盖掉茶香，喝两口就腻。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶",
      "ratio": "800毫升:500毫升",
      "note": "更浓稠，须另加三百毫升水。"
    },
    {
      "original": "红茶",
      "substitute": "砖茶",
      "ratio": "15克:20克",
      "note": "需煮十分钟以上，茶味更重。"
    }
  ],
  "variations": [
    "加两粒豆蔻同煮，香气更暖，是藏地家庭的常见做法。",
    "用红糖替白糖，焦香更浓，颜色也更深。"
  ],
  "serving_suggestion": "四杯热饮，配糌粑、藏面或油饼，是拉萨早晨的固定开场。",
  "storage": "冷藏两天内喝完，复热用小火加热到温热，不要煮沸。",
