          "name_en": "butter",
          "amount": 50,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "葡萄干",
          "name_en": "raisin",
          "amount": 60,
          "unit": "g",
          "note": "泡软",
          "optional": false
        },
        {
          "name": "杏仁",
          "name_en": "almond",
          "amount": 40,
          "unit": "g",
          "note": "切片",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 600,
          "unit": "ml",
          "note": "煮饭",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "木勺",
    "蒸锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后加清水浸泡二十分钟，米粒微微发白。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡过再煮，米粒更饱满。",
      "visual_cue": "米粒发白，手感略软"
    },
    {
      "n": 2,
      "text": "葡萄干用温水泡十分钟，泡软后沥干水分备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泡软才不会炒焦发苦。",
      "visual_cue": "葡萄干饱满，表面湿润"
    },
    {
      "n": 3,
      "text": "泡好的大米沥干，倒进汤锅加清水大火烧开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水量刚没过大米即可。",
      "visual_cue": "水面翻滚，米粒翻动"
    },
    {
      "n": 4,
      "text": "转小火盖盖焖十八分钟，焖到水分收干米粒熟透。",
      "time_min": 18,
      "heat": "小火",
      "tip": "中途别开盖，蒸汽跑了会夹生。",
      "visual_cue": "表面出现细孔，水已收干"
    },
    {
      "n": 5,
      "text": "关火以后再焖上五分钟，用木勺把米粒轻轻拨松。",
      "time_min": 5,
      "heat": "无火",
      "tip": "焖五分钟，米粒更松散。",
      "visual_cue": "米粒分明，不结团"
    },
    {
      "n": 6,
      "text": "黄油放小锅小火融化，倒入米饭中快速拌匀。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油化开就拌，奶香才挂得住。",
      "visual_cue": "每粒米都裹上一层油光"
    },
    {
      "n": 7,
      "text": "加入白糖、葡萄干与杏仁片，翻拌到糖完全化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热拌糖，甜味才均匀。",
      "visual_cue": "甜香明显，配料分布均匀"
    },
    {
      "n": 8,
      "text": "拌好的甜米饭装碗，上蒸锅再蒸五分钟让味道融合。",
      "time_min": 5,
      "heat": "中火",
      "tip": "复蒸一次，香气更浓。",
      "visual_cue": "米饭油亮，热气腾腾"
    }
  ],
  "tips": [
    "大米先泡二十分钟，煮出来才饱满。",
    "黄油化开就拌，奶香才挂得住米粒。",
    "拌好后复蒸五分钟，甜香更融合。"
  ],
  "common_mistakes": [
    "煮饭中途开盖，蒸汽跑掉米粒会夹生。",
    "黄油烧到焦再拌，整锅都带着苦味。",
    "白糖放得太多，甜味盖住了奶香。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "酥油",
      "ratio": "50 克:45 克",
      "note": "香气更浓，更接近藏地做法。"
    },
    {
      "original": "杏仁",
      "substitute": "核桃",
      "ratio": "40 克:40 克",
      "note": "口感更重，需切碎再用。"
    }
  ],
  "variations": [
    "加一小把红枣同蒸，甜味会更足。",
    "撒少许桂皮粉上去，香气更温暖。"
  ],
  "serving_suggestion": "过节或待客时盛一碗，配咸奶茶一起吃。",
  "storage": "冷藏两天之内吃完，复蒸十分钟回软。",
