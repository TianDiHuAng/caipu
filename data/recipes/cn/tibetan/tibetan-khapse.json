        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "擀面杖",
    "刀",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油隔热水化开，加牛奶、白糖、盐与打散的鸡蛋液搅到糖化开。",
      "time_min": 8,
      "heat": "无火",
      "tip": "糖要搅到看不见颗粒，面团才细腻不发硬。",
      "visual_cue": "液体微黄顺滑，无糖粒"
    },
    {
      "n": 2,
      "text": "液体分次倒入面粉，边倒边用筷子搅成絮状，再揉成偏硬的面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面要和得比饺子面硬一点，炸出来才脆不软。",
      "visual_cue": "面团光滑紧实，按压不粘手"
    },
    {
      "n": 3,
      "text": "面团盖上湿布静置二十分钟，让面筋松弛，擀的时候不回缩。",
      "time_min": 22,
      "heat": "无火",
      "tip": "醒面这一步省不得，面不松擀开就会缩回去。",
      "visual_cue": "面团柔软，轻按缓慢回弹"
    },
    {
      "n": 4,
      "text": "面团擀成半厘米厚的面片，切成两指宽的长条，再改刀成菱形块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄要一致，不然薄的炸焦了厚的还没熟。",
      "visual_cue": "面片厚薄均匀，切块大小相仿"
    },
    {
      "n": 5,
      "text": "面块表面刷少许水，撒上芝麻轻压固定，静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "面块表面刷一点水，芝麻才粘得牢，下锅炸的时候也不会掉。",
      "visual_cue": "芝麻密集附着，不脱落"
    },
    {
      "n": 6,
      "text": "炒锅倒植物油烧到五成热，面块分批下锅，小火慢炸至浮起。",
      "time_min": 8,
      "heat": "小火",
      "tip": "油温六成最合适，太热外焦里生，太凉吸油。",
      "visual_cue": "面块浮起膨胀，颜色转浅黄"
    },
    {
      "n": 7,
      "text": "炸到金黄酥脆捞出，沥油后放在厨房纸上吸去余油，凉透更脆。",
      "time_min": 5,
      "heat": "中火",
      "tip": "捞出后余温还会加深颜色，别炸到深褐再捞。",
      "visual_cue": "表面金黄，敲击有脆响"
    }
  ],
  "tips": [
    "面团里加一勺青稞粉，风味更接近藏区的做法。",
    "炸好的面果密封保存，能放半个月不软。",
    "喜欢咸口可将白糖减到二十克，加少许花椒粉。"
  ],
  "common_mistakes": [
    "面团和得太软，下锅就吸油，捞出来一咬满嘴油。",
    "油温太高下锅，外皮立刻焦黑，里面还是生面。",
    "面片厚薄不均，薄处焦了，厚处咬着发硬。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "酥油",
      "ratio": "40克:40克",
      "note": "酥油风味更纯正，奶香更足。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "120毫升:110毫升",
      "note": "清水版更脆，奶香略淡。"
    }
  ],
  "variations": [
    "把面片切成条状扭成麻花，炸过之后造型更讨喜。",
    "表面撒红糖粉再炸，颜色更深，甜味更有层次。"
  ],
  "serving_suggestion": "藏历新年待客必备，配酥油茶或甜茶，一甜一咸正好。",
  "storage": "凉透后密封常温可存十五天，受潮后回锅复炸一分钟即脆。",
