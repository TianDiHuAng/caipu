  "steps": [
    {
      "n": 1,
      "text": "面粉加两克盐和清水揉成偏硬面团，盖布醒三十分钟后面团再揉一遍。",
      "time_min": 34,
      "heat": "无火",
      "tip": "面团要硬一些，醒过再揉才光滑不粘手。",
      "visual_cue": "面团表面光滑，按压缓慢回弹"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧至微热，下羊肉小丁小火煸出油脂，加姜丝、蒜片和酱油炒到肉丁上色。",
      "time_min": 8,
      "heat": "中火",
      "tip": "肉丁先煸干水分，炒出来才不腥不柴。",
      "visual_cue": "肉丁边缘焦黄，锅底有清亮羊油"
    },
    {
      "n": 3,
      "text": "下西红柿块和土豆小丁翻炒三分钟，加一千二百毫升热水烧开煮十分钟。",
      "time_min": 14,
      "heat": "大火",
      "tip": "热水下锅汤才清，冷水会让肉丁紧缩发柴。",
      "visual_cue": "汤色微红，土豆丁边缘变软"
    },
    {
      "n": 4,
      "text": "面团擀成半厘米厚的面片，切成两指宽的条，再用手揪成小块下入滚汤。",
      "time_min": 9,
      "heat": "大火",
      "tip": "边揪边下锅，面片厚薄一致才同时熟透。",
      "visual_cue": "面片浮起，边缘微微卷起"
    },
    {
      "n": 5,
      "text": "面片煮五分钟后加盐调味，淋陈醋，撒香菜碎关火盛碗。",
      "time_min": 6,
      "heat": "中火",
      "tip": "陈醋一定要最后淋，早放酸味会被煮散。",
      "visual_cue": "汤面浮着一层油，香菜翠绿未塌"
    },
    {
      "n": 6,
      "text": "盛碗后按口味再点几滴陈醋，趁热连汤带面一起吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "碗要提前用热水烫热，西北天冷汤凉得快。",
      "visual_cue": "碗壁挂着汤汁，热气直往上冲"
    }
  ],
  "tips": [
    "醒面时间不足，揪出的面片一下锅就断。下面片前把面团揉到光滑不粘手。",
    "羊肉选带一点肥的腿肉，全瘦的煸不出油，汤头寡淡。脂肪太少汤会发清。",
    "土豆丁切小一点，和面片同熟；切大了面片烂了土豆还硬。大小要随面片走。",
    "汤要一次加够热水，中途补水会把汤味冲淡。实在要补也只加热水不加凉水。"
  ],
  "common_mistakes": [
    "面片直接下冷水锅，煮成一锅糊。下锅前水必须大滚，面片才会散开不粘。",
    "炒肉丁时火太大，姜蒜先糊肉还生。先把锅烧热再转中火下肉最稳。",
    "陈醋和酱油一起早放，汤色发黑发咸。酸甜要在收尾阶段分次调整。",
    "揪的面片大小不均，小的烂了大的还夹生。揪面时手劲要匀，宁小勿大。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "250克:250克",
      "note": "牛味更重，煸油时间延长两分钟。"
    },
    {
      "original": "土豆",
      "substitute": "胡萝卜",
      "ratio": "150克:150克",
      "note": "甜味更明显，煮的时间略短。"
    }
  ],
  "variations": [
    "加一勺辣椒面同炒，汤更红更冲。辣味上来后盐要相应减一点。",
    "面片换成手擀面条，省时间但口感偏软。适合赶时间的家常做法。",
    "最后撒一把蒜苗段，辛香更足。西北本地人喜欢这一口生蒜气。"
  ],
  "serving_suggestion": "盛进大碗连汤带面，表面撒香菜，喜欢重口的再淋一勺辣椒油，配一碟醋蒜正好。",
  "storage": "面片和汤分开存，冷藏可放两天；复热时汤先烧开再下面片，避免面片泡烂。",
