  "steps": [
    {
      "n": 1,
      "text": "芹菜段和白菜块用开水烫两分钟捞出，晾到手温后放入洗净的陶罐里。",
      "time_min": 12,
      "heat": "大火",
      "tip": "菜要晾到不烫手再入罐，太烫会把菌烫死。",
      "visual_cue": "菜叶变软，颜色转深绿"
    },
    {
      "n": 2,
      "text": "罐中倒入六百毫升凉开水，加三克盐搅匀，盖盖放在阴凉处发酵两天。",
      "time_min": 10,
      "heat": "无火",
      "tip": "罐口别封死，留一点缝让发酵的气跑出来。",
      "visual_cue": "液面起小泡，闻着有清酸味"
    },
    {
      "n": 3,
      "text": "面粉加两克盐和清水揉成硬面团，醒二十分钟后擀成两毫米厚的薄片。",
      "time_min": 26,
      "heat": "无火",
      "tip": "面团硬一点，擀出的面片才筋道不糊。",
      "visual_cue": "面片薄透，能看见案板纹路"
    },
    {
      "n": 4,
      "text": "面片叠起切成半厘米宽的面片，抖散摊开防止粘连。",
      "time_min": 6,
      "heat": "无火",
      "tip": "切好立刻抖散撒干面粉，粘一起就废了。",
      "visual_cue": "面片根根分明，不结团"
    },
    {
      "n": 5,
      "text": "炒锅放植物油烧热，下干辣椒和蒜片小火炝出香味，倒入两大勺浆水烧开。",
      "time_min": 7,
      "heat": "小火",
      "tip": "浆水要先炝后煮，生酸味才变得柔和。",
      "visual_cue": "油面浮起红油，酸香冲鼻而来"
    },
    {
      "n": 6,
      "text": "另锅水开下面片煮三分钟，捞入浆水汤里，加盐和陈醋调味即可。",
      "time_min": 6,
      "heat": "大火",
      "tip": "面片一定要另锅煮，浆水汤才清不发黏。",
      "visual_cue": "面片透亮，汤色乳白微浊"
    }
  ],
  "tips": [
    "浆水发酵靠的是蔬菜表面的乳酸菌，容器一定要无油。沾了油整罐都会发臭不能吃。",
    "发酵温度在二十度上下最合适，夏天一天就够，冬天要放到暖气边多等一天。酸度要尝。",
    "面片要擀得薄切得细，浆水汤不勾芡，全凭面片本身撑起口感。厚面片会压住酸香。",
    "浆水可以反复续用，每次吃完补凉开水和烫过的菜，老浆水的酸香比新做的更醇。"
  ],
  "common_mistakes": [
    "浆水罐沾油，表面起白毛整罐报废。取用时必须用干净无油的勺子。",
    "面片煮好后泡在锅里等汤，泡成一坨。面和汤必须分锅，吃前再合。",
    "浆水直接喝凉的，肠胃弱的人容易不舒服。浆水必须烧开后再浇面。",
    "干辣椒大火炸，一秒钟就发黑发苦。小火慢炝，辣椒出香不变色才行。"
  ],
  "substitutions": [
    {
      "original": "芹菜",
      "substitute": "芥菜",
      "ratio": "200克:200克",
      "note": "酸味更冲，发酵时间缩短半天。"
    },
    {
      "original": "白菜",
      "substitute": "包菜",
      "ratio": "300克:300克",
      "note": "口感更脆，酸味偏淡。"
    }
  ],
  "variations": [
    "浆水里加一勺面汤，酸味更圆润。老陕管这叫养浆水，越养越香。",
    "夏天把浆水面过一遍凉开水，做成凉浆水面。解暑效果比冰饮还直接。",
    "配一碟油泼辣子和蒜瓣吃，酸辣冲鼻。西北人夏天的标准吃法。"
  ],
  "serving_suggestion": "面片捞进碗里浇上滚开的浆水，撒一点香菜，配油泼辣子和生蒜，酸香清爽，暑天吃最舒服。",
  "storage": "浆水汤冷藏可放五天，每次取用要用干净勺子；面片现煮现吃，不建议隔夜。",
