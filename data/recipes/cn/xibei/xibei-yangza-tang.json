  "steps": [
    {
      "n": 1,
      "text": "羊肉用清水泡二十分钟，中途换两次水去掉血水。",
      "time_min": 20,
      "heat": "无火",
      "tip": "多换几次水，膻味能去掉大半。",
      "visual_cue": "肉质发白，水色变清"
    },
    {
      "n": 2,
      "text": "冷水下锅，加姜片、大葱与料酒焯水，撇沫后捞出冲净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅血沫才能慢慢逼出。",
      "visual_cue": "浮沫撇净，肉片干净"
    },
    {
      "n": 3,
      "text": "汤锅倒植物油，下姜片与青花椒小火煸出香味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "花椒煸香再加水，汤底才有回甘。",
      "visual_cue": "油面泛香，花椒变色"
    },
    {
      "n": 4,
      "text": "加足量清水与羊肉，大火烧开后转小火炖五十分钟。",
      "time_min": 55,
      "heat": "小火",
      "tip": "小火慢炖，汤色才乳白不浑。",
      "visual_cue": "汤色转白，肉香四溢"
    },
    {
      "n": 5,
      "text": "下入干辣椒与泡软的粉丝，中火煮三分钟至断生。",
      "time_min": 3,
      "heat": "中火",
      "tip": "粉丝久煮会糊，断生即可。",
      "visual_cue": "粉丝透明，柔软不断"
    },
    {
      "n": 6,
      "text": "加盐与白醋调味，尝一口后按口味再补少许。",
      "time_min": 2,
      "heat": "中火",
      "tip": "一点白醋能把膻味压下去。",
      "visual_cue": "汤味鲜咸，带着微酸"
    },
    {
      "n": 7,
      "text": "盛入大碗中，撒上香菜碎与小葱花即可开吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香菜葱花最后撒，香气不散。",
      "visual_cue": "汤面浮着翠绿葱花"
    }
  ],
  "tips": [
    "羊肉泡水要耐心，换水三遍膻味明显减轻。",
    "炖汤全程小火，大火会把汤煮浑。",
    "配一小碟椒盐蘸肉吃，味道更足。"
  ],
  "common_mistakes": [
    "没焯水直接炖，汤膻得下不去口。",
    "一直用中大火滚煮，汤色浑浊不清亮。",
    "盐放得太早，肉质发紧久炖也不烂。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "羊排",
      "ratio": "500 克:600 克",
      "note": "带骨炖汤更香，时间延长十分钟。"
    },
    {
      "original": "粉丝",
      "substitute": "通心粉",
      "ratio": "60 克:70 克",
      "note": "煮制时间延长至八分钟。"
    }
  ],
  "variations": [
    "加几片白萝卜同炖，汤更清甜解膻。",
    "喜欢重口可淋一勺辣椒油，撒点白胡椒。"
  ],
  "serving_suggestion": "一大碗汤配两个肉夹馍，冬天喝完全身发热。",
  "storage": "冷藏两天，撇去上层浮油再复热；不建议反复加热。",
