    "木勺",
    "刀",
    "砧板",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉切三厘米块，冷水下锅焯五分钟去血沫。这一步不要着急。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅，血沫才逼得出来。，注意火候。",
      "visual_cue": "浮沫上浮，汤色变清，状态稳定"
    },
    {
      "n": 2,
      "text": "捞出用温水冲净浮沫，沥干水分备用。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "用温水冲，肉才不会骤缩发柴。，注意火候。",
      "visual_cue": "肉块干净，表面干爽，状态稳定"
    },
    {
      "n": 3,
      "text": "厚底锅倒植物油，下姜片、蒜、八角和肉桂炒香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "香料小火炒，香气才不苦。，注意火候。",
      "visual_cue": "香气浓烈，油色微黄，状态稳定"
    },
    {
      "n": 4,
      "text": "放羊肉块转中火煸炒到表面收紧上色。这一步不要着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煸到边缘焦黄，成品才够香。，注意火候。",
      "visual_cue": "肉块焦边，油脂析出，状态稳定"
    },
    {
      "n": 5,
      "text": "沿锅边淋酱油炒匀，加白糖炒出酱色。这一步不要着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "酱油沿锅边淋，香气才激得出来。，注意火候。",
      "visual_cue": "颜色红亮，酱香浓，状态稳定"
    },
    {
      "n": 6,
      "text": "加清水没过羊肉，烧开后转小火炖三十分钟。这一步不要着急。",
      "time_min": 32,
      "heat": "小火",
      "tip": "小火慢炖，羊肉才酥而不散。，注意火候。",
      "visual_cue": "汤面微沸，肉已变软，状态稳定"
    },
    {
      "n": 7,
      "text": "放土豆、胡萝卜和洋葱块，再炖十五分钟。这一步不要着急。",
      "time_min": 16,
      "heat": "小火",
      "tip": "根茎后放，久炖才不会散成泥。，注意火候。",
      "visual_cue": "块状完整，叉子能插透"
    },
    {
      "n": 8,
      "text": "加盐调味，撒香菜碎后连汤盛出。这一步不要着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后加，肉才不会发紧。，注意火候。",
      "visual_cue": "汤汁浓稠，香气扑鼻，状态稳定"
    }
  ],
  "tips": [
    "羊肉冷水下锅焯，血沫才逼得干净。，值得留意。",
    "小火慢炖，肉才酥烂不柴。，值得留意。",
    "根茎后放，久炖才不化在汤里。，值得留意。"
  ],
  "common_mistakes": [
    "用热水焯肉，血水锁在里面发腥。，值得留意。",
    "大火炖到底，汤汁糊底发苦。，值得留意。",
    "盐下太早，羊肉紧缩发柴。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "600 克:600 克",
      "note": "炖制时间加十五分钟。"
    },
    {
      "original": "土豆",
      "substitute": "红薯",
      "ratio": "250 克:250 克",
      "note": "更甜，炖制时间减五分钟。"
    }
  ],
  "variations": [
    "加一勺辣椒面，风味更西北。，值得留意。",
    "放几颗红枣同炖，汤更回甜。，值得留意。"
  ],
  "serving_suggestion": "配手抓饭或泡馍，汤汁浇在饭上最香。，效果更稳定。",
  "storage": "冷藏三天，复热加少量水小火炖十分钟。，效果更稳定。",
