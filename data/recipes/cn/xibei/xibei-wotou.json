  "equipment": [
    "蒸锅",
    "大碗",
    "蒸屉",
    "筷子",
    "盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "玉米面倒进盆里，冲入滚水边倒边用筷子搅成絮。",
      "time_min": 5,
      "heat": "无火",
      "tip": "滚水烫面，玉米面才不粗糙扎口。，注意火候。",
      "visual_cue": "面絮松散，热气升起，状态稳定"
    },
    {
      "n": 2,
      "text": "面絮晾到不烫手，加面粉、酵母、白糖和盐。这一步不要着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "太烫会烫死酵母，一定放温。，注意火候。",
      "visual_cue": "面絮温热，粉料拌匀，状态稳定"
    },
    {
      "n": 3,
      "text": "揉成不粘手的面团，盖布醒发四十分钟。这一步不要着急。",
      "time_min": 42,
      "heat": "无火",
      "tip": "发到略膨就好，发太过会塌。，注意火候。",
      "visual_cue": "体积微增，手感柔软，状态稳定"
    },
    {
      "n": 4,
      "text": "面团分成八份，每份搓成圆球。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "大小一致，蒸的时候才一起熟。，注意火候。",
      "visual_cue": "球体圆整，大小均匀，状态稳定"
    },
    {
      "n": 5,
      "text": "拇指从底部顶进面团，边转边捏成中空窝头。这一步不要着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "窝头中间留空，蒸汽才进得去。，注意火候。",
      "visual_cue": "顶部尖，底部有窝，状态稳定"
    },
    {
      "n": 6,
      "text": "蒸屉铺湿布，窝头间隔摆好，二次醒十分钟。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "二次醒发，蒸出来才松软。，注意火候。",
      "visual_cue": "体积略增，表面干爽，状态稳定"
    },
    {
      "n": 7,
      "text": "水开后大火蒸二十分钟，关火焖三分钟。这一步不要着急。",
      "time_min": 24,
      "heat": "大火",
      "tip": "关火别急开盖，骤冷会回缩。，注意火候。",
      "visual_cue": "窝头饱满，表面光滑，状态稳定"
    }
  ],
  "tips": [
    "玉米面用滚水烫过，口感才不粗粝。，值得留意。",
    "窝头中间要留空，蒸汽才蒸得透。，值得留意。",
    "关火焖三分钟再开盖，才不回缩。，值得留意。"
  ],
  "common_mistakes": [
    "直接冷水和面，蒸出来又硬又散。，值得留意。",
    "窝头捏太实，中心熟不透。，值得留意。",
    "关火立刻开盖，表面全皱起来。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "玉米面",
      "substitute": "小米面",
      "ratio": "300 克:300 克",
      "note": "更细腻，水量可略减。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "20 克:22 克",
      "note": "颜色更深，风味更浓。"
    }
  ],
  "variations": [
    "面团里加一把红枣碎，甜味更自然。，值得留意。",
    "掺少许豆面，香气更复合。，值得留意。"
  ],
  "serving_suggestion": "配一碟咸菜或羊肉汤，是最朴实的西北主食。",
  "storage": "冷冻两周，复热用蒸锅蒸八分钟。，效果更稳定。",
