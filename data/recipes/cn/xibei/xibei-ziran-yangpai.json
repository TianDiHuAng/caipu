    "烤盘",
    "刷子",
    "刀",
    "砧板",
    "保鲜盒"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊排顺着骨缝切成条，用清水泡二十分钟去血水，捞出擦干。",
      "time_min": 22,
      "heat": "无火",
      "tip": "羊排带血水烤出来发腥，泡一下干净得多。",
      "visual_cue": "肉色转淡，骨头断面无血"
    },
    {
      "n": 2,
      "text": "洋葱切丝、姜切片、蒜切末，与盐、生抽一起抓拌羊排，腌一小时。",
      "time_min": 62,
      "heat": "无火",
      "tip": "洋葱汁能去膻，比单用料酒管用，腌够时间肉才松。",
      "visual_cue": "羊排表面泛湿，洋葱变软出水"
    },
    {
      "n": 3,
      "text": "烤箱预热两百度，羊排抖去洋葱，摆在烤架上，刷一层植物油。",
      "time_min": 8,
      "heat": "无火",
      "tip": "抖掉洋葱再烤，粘在肉上的洋葱容易焦黑。",
      "visual_cue": "羊排排布整齐，表面油亮"
    },
    {
      "n": 4,
      "text": "入炉烤十五分钟，翻面再烤八分钟，至表面焦褐、骨头边缘收缩。",
      "time_min": 24,
      "heat": "中火",
      "tip": "翻面时别刷酱，先烤干表面才能起焦壳。",
      "visual_cue": "表面焦褐起壳，油脂滋滋冒"
    },
    {
      "n": 5,
      "text": "取出撒孜然与辣椒粉，再回炉烤三分钟，让香料烤出香味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料最后撒，早撒烤久了会发苦，香味也跑光。",
      "visual_cue": "香料贴附表面，颜色红亮"
    },
    {
      "n": 6,
      "text": "出炉静置三分钟，撒芝麻与香菜，趁热上手撕着吃。",
      "time_min": 4,
      "heat": "无火",
      "tip": "静置三分钟能锁住肉汁，切的时候不流失，肉才嫩而不柴。",
      "visual_cue": "香料贴附表面，颜色红亮诱人"
    }
  ],
  "tips": [
    "羊排选肉质厚的肋排，太薄一烤就干。",
    "孜然分两次撒，一半烤香、一半上桌增香。",
    "没有烤箱可用平底锅大火煎，最后加盖焖两分钟。"
  ],
  "common_mistakes": [
    "羊排不泡不腌直接烤，膻味重得压不住。",
    "全程大火高温，外面焦了里面还带血。",
    "孜然一开始就撒，烤完只剩苦味没有香。"
  ],
  "substitutions": [
    {
      "original": "羊排",
      "substitute": "羊肉",
      "ratio": "900克:900克",
      "note": "羊肉切大块烤，时间减五分钟。"
    },
    {
      "original": "辣椒粉",
      "substitute": "干辣椒",
      "ratio": "8克:10克",
      "note": "干辣椒须剪碎，香气更冲。"
    }
  ],
  "variations": [
    "腌料里加一勺酸奶，肉质更嫩，带一点奶香。",
    "把羊排换成羊腿肉串成串，就是烤羊肉串的做法。"
  ],
  "serving_suggestion": "配一碗揪面片或烤饼，手撕着吃，配啤酒最痛快。",
  "storage": "冷藏可存两天，复热须烤箱一百八十度烤六分钟，微波会发韧。",
