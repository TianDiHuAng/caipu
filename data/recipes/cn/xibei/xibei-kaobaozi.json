  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加两克盐和清水揉成偏硬面团，盖布醒三十分钟，中途揉一次。",
      "time_min": 34,
      "heat": "无火",
      "tip": "面团和得硬一点，包住羊肉丁烤时才不出汤。",
      "visual_cue": "面团光滑紧实，按压回弹慢"
    },
    {
      "n": 2,
      "text": "羊肉切半厘米小丁，加洋葱碎、盐、孜然和黑胡椒抓匀腌十五分钟。",
      "time_min": 17,
      "heat": "无火",
      "tip": "羊肉一定要手工切丁，绞出来的口感发泥。",
      "visual_cue": "肉丁挂满调料，洋葱出水"
    },
    {
      "n": 3,
      "text": "腌好的羊肉丁淋植物油拌匀，让油脂裹住每一粒肉丁锁住水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油要拌到馅料发亮，烤出来才不会发干。",
      "visual_cue": "馅料油光发亮，肉粒颗颗分明"
    },
    {
      "n": 4,
      "text": "面团搓长条切成八个剂子，擀成中间厚边缘薄的方形面皮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面皮中间要擀得厚，包住羊肉丁才不破底。",
      "visual_cue": "面皮方正，四边薄中间略厚"
    },
    {
      "n": 5,
      "text": "面皮包入羊肉丁，对折成枕头状捏紧三边，表面刷一层植物油。",
      "time_min": 10,
      "heat": "无火",
      "tip": "三边各捏两道褶，烤时汤汁才不会流。",
      "visual_cue": "包子鼓胀饱满，封口严实无缝"
    },
    {
      "n": 6,
      "text": "烤箱两百二十度预热，烤盘放中层烤十八分钟至表面金黄鼓起。",
      "time_min": 22,
      "heat": "无火",
      "tip": "必须高温快烤，低温久烤外皮会发干硬。",
      "visual_cue": "表面金黄鼓起，底部焦黄干脆"
    }
  ],
  "tips": [
    "包子要包成扁枕头形，太厚中间烤不透。厚度控制在三厘米左右最稳。",
    "羊肉带一点肥的腿肉最合适，全瘦烤出来干柴。洋葱的水分也能让馅更润。",
    "封口一定要捏两道褶，第一道定型第二道密封。只捏一道烤的时候会爆开流汤。",
    "高温两百二十度烤，皮才能鼓起来且外脆内嫩。温度低了皮会硬得像饼干。"
  ],
  "common_mistakes": [
    "面皮擀得太薄，包馅时一捏就破。边缘要薄、中间要厚，这是包住馅的关键。",
    "羊肉丁提前炒熟再包，烤出来又干又柴。羊肉必须是生的，靠烤制过程出汁。",
    "馅里洋葱放太多，烤的时候出汤把底泡软。洋葱与肉的比例一比二最稳。",
    "烤盘中不放油纸，包子底粘住揭不下来。垫油纸或刷一层薄油都行。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "400克:400克",
      "note": "需多加十毫升油，牛馅更瘦。"
    },
    {
      "original": "孜然",
      "substitute": "小茴香",
      "ratio": "5克:5克",
      "note": "香气更柔，辛味淡一些。"
    }
  ],
  "variations": [
    "馅里加一把切碎的羊尾油，香得冲鼻。新疆老摊子的做法，趁热吃最妙。",
    "用馕坑或空气炸锅两百度烤十五分钟，底部更脆。家用设备也能量产。",
    "包好后表面撒芝麻再烤，多一层坚果香。孩子更爱吃这个版本。"
  ],
  "serving_suggestion": "出炉趁热咬开，先吸一口汤汁再吃羊肉丁，配一碗砖茶或酸奶，西北的早饭就这么扎实。",
  "storage": "冷藏可放两天，复热用烤箱一百八十度烤六分钟；微波会让面皮变韧，不建议使用。",
