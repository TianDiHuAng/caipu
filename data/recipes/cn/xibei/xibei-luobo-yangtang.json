  "steps": [
    {
      "n": 1,
      "text": "羊肉块用清水泡三十分钟，中途换两次水，把血水泡出来。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡水比焯水更温和，炖出的汤不容易浑。",
      "visual_cue": "肉块发白，水色变淡粉"
    },
    {
      "n": 2,
      "text": "羊肉冷水下锅，加料酒和一半姜片大火煮开，撇净浮沫后捞出冲净。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅血沫才能逼出来，热水下锅会锁住。",
      "visual_cue": "浮沫结块，汤面由浑转清"
    },
    {
      "n": 3,
      "text": "炖锅放羊肉、姜片和花椒，倒两千毫升热水，大火烧开转小火炖一小时。",
      "time_min": 64,
      "heat": "小火",
      "tip": "花椒去膻不抢味，别放多，三克足够。",
      "visual_cue": "汤色转乳白，肉块浮起"
    },
    {
      "n": 4,
      "text": "白萝卜切滚刀块，等羊肉炖到七成软时下锅，继续小火煮二十分钟。",
      "time_min": 22,
      "heat": "小火",
      "tip": "萝卜后下才不会炖化，还能吸足羊汤的香。",
      "visual_cue": "萝卜半透明，筷子能轻松插透"
    },
    {
      "n": 5,
      "text": "加盐调味，再煮三分钟让咸味渗进萝卜，关火前撒香菜碎。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盐要最后放，早放肉会变紧、汤会变寡。",
      "visual_cue": "汤面浮着一层油，香菜翠绿未塌"
    },
    {
      "n": 6,
      "text": "盛进汤碗，先喝一口清汤，再按口味撒白胡椒或加点陈醋。",
      "time_min": 2,
      "heat": "无火",
      "tip": "碗先用热水烫一遍，盛汤才不容易凉。",
      "visual_cue": "碗壁凝雾，汤面油花清亮"
    }
  ],
  "tips": [
    "羊肉选带一点骨头的腿肉，炖出的汤才有胶质和厚度。纯瘦肉炖出来只有咸味没有香。",
    "泡水这一步不能省，血水泡掉大半膻味就去了。赶时间的话至少泡十五分钟。",
    "炖汤全程小火，汤面只冒小泡。大火翻滚会把汤煮浑、肉煮散，卖相全毁。",
    "萝卜不要和羊肉同时下锅，羊肉要炖一小时，萝卜二十分钟就够，同时下锅必成糊。"
  ],
  "common_mistakes": [
    "焯水用热水下锅，血沫锁在肉里，汤一直发灰。必须冷水起锅慢慢加热。",
    "花椒放太多，汤里全是麻味盖住羊香。三克左右刚好，多了就抢戏。",
    "中途加冷水，汤温骤降肉纤维收紧，炖两小时都不烂。要补只加热水。",
    "盐提前放，羊肉越炖越硬。老规矩是关火前五分钟才调味。"
  ],
  "substitutions": [
    {
      "original": "白萝卜",
      "substitute": "胡萝卜",
      "ratio": "400克:400克",
      "note": "甜味更突出，汤色偏黄。"
    },
    {
      "original": "羊肉",
      "substitute": "羊排",
      "ratio": "600克:700克",
      "note": "带骨更香，炖的时间延长十五分钟。"
    }
  ],
  "variations": [
    "汤里加几颗红枣和枸杞，甜味更柔。适合冬天进补，孩子也爱喝。",
    "炖好后把肉捞出蘸蒜泥汁吃，汤另喝。一菜两吃，西北人家常做法。",
    "换成羊蝎子同炖，汤更浓更黏。需要延长炖煮时间到两小时。"
  ],
  "serving_suggestion": "热汤盛碗撒香菜，配一张锅盔或油酥馍蘸汤吃。汤清肉烂、萝卜吸饱油香，冬天最养人。",
  "storage": "冷藏可放两天，撇去表面凝固的羊油后复热；萝卜隔夜易发酸，建议当餐吃完。",
