  "steps": [
    {
      "n": 1,
      "text": "面粉加清水和一小撮盐，揉成偏硬的面团醒着。",
      "time_min": 8,
      "heat": "无火",
      "tip": "面和硬一点，皮才擀得薄不破。，注意火候。",
      "visual_cue": "面团紧实，表面光滑，状态稳定"
    },
    {
      "n": 2,
      "text": "面团盖布醒三十分钟，中途揉一次更光滑。这一步不要着急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "醒透的面才擀得开不回缩。，注意火候。",
      "visual_cue": "面团柔软，按压回弹，状态稳定"
    },
    {
      "n": 3,
      "text": "羊肉剁成细馅，洋葱和姜切末备用。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "羊肉剁细一点，口感才不柴。，注意火候。",
      "visual_cue": "馅料黏稠，颗粒细小，状态稳定"
    },
    {
      "n": 4,
      "text": "胡萝卜擦碎后略挤去水分，拌进馅料里。这一步不要着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "胡萝卜挤水，馅才不会出水。，注意火候。",
      "visual_cue": "馅料干爽，颜色橙红，状态稳定"
    },
    {
      "n": 5,
      "text": "加酱油、花椒粉、盐和植物油，顺一个方向搅上劲。",
      "time_min": 6,
      "heat": "无火",
      "tip": "搅到发黏起胶，煮的时候才不散。，注意火候。",
      "visual_cue": "馅料抱团，油光发亮，状态稳定"
    },
    {
      "n": 6,
      "text": "面团搓条切小段，擀成中间厚边缘薄的圆皮。这一步不要着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "中间厚一点，托得住馅不破底。，注意火候。",
      "visual_cue": "皮圆匀薄，边缘略薄，状态稳定"
    },
    {
      "n": 7,
      "text": "每张皮放一勺馅，捏紧封口成月牙形。这一步不要着急。",
      "time_min": 15,
      "heat": "无火",
      "tip": "封口捏紧，煮时才不会灌水。，注意火候。",
      "visual_cue": "褶子整齐，封口严实，状态稳定"
    },
    {
      "n": 8,
      "text": "水开下饺子，点两次凉水，浮起后再煮两分钟。",
      "time_min": 8,
      "heat": "大火",
      "tip": "点两次水，皮熟馅也透。，注意火候。",
      "visual_cue": "饺子鼓胀，浮在汤面，状态稳定"
    }
  ],
  "tips": [
    "胡萝卜挤去水分，馅才不出汤。，值得留意。",
    "馅料顺一个方向搅，煮时才不散。，值得留意。",
    "点两次凉水，皮和馅一起熟。，值得留意。"
  ],
  "common_mistakes": [
    "馅里水太多，包的时候皮就破。，值得留意。",
    "皮擀得中间也薄，煮完全露馅。，值得留意。",
    "火太大一直滚，饺子皮全裂开。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "400 克:400 克",
      "note": "口感更紧实，可多加一勺油。"
    },
    {
      "original": "胡萝卜",
      "substitute": "白菜",
      "ratio": "120 克:150 克",
      "note": "出水更多，须挤得更干。"
    }
  ],
  "variations": [
    "馅里加一勺花椒油，麻香更足。，值得留意。",
    "做成蒸饺，皮更筋道。，值得留意。"
  ],
  "serving_suggestion": "配一碟醋和蒜泥，趁热吃最香。，效果更稳定。",
  "storage": "生饺冷冻一个月，煮时无需解冻。，效果更稳定。",
