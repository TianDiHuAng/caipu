      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 500,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 2,
          "unit": "piece",
          "note": "打入面团",
          "optional": false
        },
        {
          "name": "小茴香",
          "name_en": "cumin seed",
          "amount": 5,
          "unit": "g",
          "note": "炒香碾碎",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 4,
          "unit": "g",
          "note": "发面用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 8,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "和面与刷面",
          "optional": false
        },
        {
          "name": "小苏打",
          "name_en": "baking soda",
          "amount": 2,
          "unit": "g",
          "note": "增酥",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "鹅卵石",
    "擀面杖",
    "大碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母用温水化开，倒入面粉，加鸡蛋、盐、小苏打与植物油揉成面团。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水别一次倒完，面团偏硬一点烤出来才酥。",
      "visual_cue": "面团光滑，按压缓慢回弹"
    },
    {
      "n": 2,
      "text": "盖布发酵四十分钟，面团涨到一倍半大，内部呈蜂窝状。",
      "time_min": 42,
      "heat": "无火",
      "tip": "发到一倍半就好，发过头会带酸味，烤出来一股馊气。",
      "visual_cue": "面团膨起，掰开有细密气孔"
    },
    {
      "n": 3,
      "text": "小茴香下干锅小火炒香，用擀面杖碾碎，拌入面团揉匀。",
      "time_min": 6,
      "heat": "小火",
      "tip": "小茴香炒过再碾，香气才出得来，生着拌只有草味。",
      "visual_cue": "香料碎分布均匀，面团飘香"
    },
    {
      "n": 4,
      "text": "面团分成八份，擀成一厘米厚的圆饼，用刀在表面划几道浅口。",
      "time_min": 12,
      "heat": "无火",
      "tip": "划口能防鼓包，也让热气散得匀，烙出来才不会空心。",
      "visual_cue": "饼坯圆整，表面划口清晰"
    },
    {
      "n": 5,
      "text": "平底锅铺一层洗净的鹅卵石，中火加热十分钟至石头烫手。",
      "time_min": 10,
      "heat": "中火",
      "tip": "石头要提前烧透，温度不够饼烙不熟。",
      "visual_cue": "石头烫手，滴水立刻蒸发"
    },
    {
      "n": 6,
      "text": "饼坯埋入热石子中，上面再盖一层石子，中火烙十二分钟。",
      "time_min": 13,
      "heat": "中火",
      "tip": "上下都要有石子，受热才均匀，饼面才有麻点。",
      "visual_cue": "石子缝隙冒白汽，麦香散出"
    },
    {
      "n": 7,
      "text": "取出抖掉表面的石子，刷一层薄油，趁热掰开食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷油能让表皮回软一点，不刷更脆，看个人口味。",
      "visual_cue": "表面坑洼有麻点，掰开层次分明"
    }
  ],
  "tips": [
    "石子要选光滑的鹅卵石，洗净晾干再用，第一次用可先空烧一遍。",
    "喜欢更酥的口感可多加十毫升油，喜欢硬脆就少放。",
    "没有石子可用厚底锅干烙，虽无麻点，味道也接近。"
  ],
  "common_mistakes": [
    "面团发过头带酸味，烤出来一股馊味。",
    "石子没烧透就埋饼，烙完中间还是生面。",
    "饼擀得太薄，埋在石子里压得变形，一掰就碎。"
  ],
  "substitutions": [
    {
      "original": "小茴香",
      "substitute": "孜然",
      "ratio": "5克:5克",
      "note": "孜然味更冲，用量可减到四克。"
    },
    {
      "original": "鸡蛋",
      "substitute": "牛奶",
      "ratio": "2个:120毫升",
      "note": "牛奶版更香软，水要相应减少。"
    }
  ],
  "variations": [
    "面团里揉入葱花与少许花椒粉，就是陕西的咸香石子馍。",
    "把饼擀薄如纸，烙出来脆得像饼干，可当零食。"
  ],
  "serving_suggestion": "趁热掰开吃，配羊肉汤或粉汤，是西北最经典的搭配。",
  "storage": "常温密封可存五天，凉后回锅干烙两分钟即恢复酥脆。",
