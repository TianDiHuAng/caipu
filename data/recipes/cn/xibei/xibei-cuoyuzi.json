  "steps": [
    {
      "n": 1,
      "text": "面粉加盐与约二百毫升清水揉成偏硬的面团，盖布醒二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "面要和得硬，搓出来的鱼子才筋道不软。",
      "visual_cue": "面团光滑不粘手，按下去回弹"
    },
    {
      "n": 2,
      "text": "醒好的面团擀成一厘米厚的片，再切成小指粗的条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切条要均匀，搓出来大小一致才好一起熟。",
      "visual_cue": "面棍粗细一致，断面方正平整"
    },
    {
      "n": 3,
      "text": "取一根粗面棍在案板上用手掌搓成两头尖、中间粗的小鱼形状，依次搓完。",
      "time_min": 18,
      "heat": "无火",
      "tip": "搓的时候手掌稍用力往前推，自然就成了鱼形。",
      "visual_cue": "成品两头尖细，形如小鱼"
    },
    {
      "n": 4,
      "text": "搓好的面鱼撒少许干面粉抖开，避免粘连成坨。",
      "time_min": 2,
      "heat": "无火",
      "tip": "撒粉要抖匀，粘在一起煮时就成一团。",
      "visual_cue": "面鱼颗颗分开，表面干爽"
    },
    {
      "n": 5,
      "text": "炒锅下植物油烧热，羊肉丁中火煸到变色出油，加蒜末与洋葱丁炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "羊肉要煸到出油，膻味才去得干净，锅里油也清亮。",
      "visual_cue": "羊肉丁边缘微焦，锅中油清亮"
    },
    {
      "n": 6,
      "text": "下土豆丁与番茄块同炒，加生抽与盐，倒一小碗水焖十分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "番茄炒出汁再焖，汤才浓郁不寡，颜色也红亮好看。",
      "visual_cue": "番茄化开，土豆边缘变软"
    },
    {
      "n": 7,
      "text": "另起锅烧水，面鱼下锅煮到全部浮起，再煮两分钟捞出。",
      "time_min": 6,
      "heat": "大火",
      "tip": "浮起来不等于熟，再多煮两分钟才透。",
      "visual_cue": "面鱼浮在水面，捞起弹手"
    },
    {
      "n": 8,
      "text": "面鱼趁热倒入炒锅，加青椒丝翻匀，淋米醋与辣椒油，撒香菜出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋最后淋，酸香才在，早放就挥发完了。",
      "visual_cue": "汤汁裹满面鱼，青椒翠绿不黄"
    }
  ],
  "tips": [
    "面里加一小撮盐能增筋，搓的时候不易断。",
    "没有羊肉可用牛肉丁，风味稍淡但一样好吃。",
    "也可以做成凉拌版，过凉水后拌蒜泥与辣油。"
  ],
  "common_mistakes": [
    "面和得太软，一搓就扁，下锅煮成面糊。",
    "面鱼搓好不及时撒粉，粘成一团没法下锅。",
    "菜卤水放太多，浇在面上汤汤水水，拌不开。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "200克:200克",
      "note": "牛肉更紧实，煸的时间加两分钟。"
    },
    {
      "original": "土豆",
      "substitute": "胡萝卜",
      "ratio": "200克:180克",
      "note": "胡萝卜更耐焖，可早放五分钟。"
    }
  ],
  "variations": [
    "把面鱼换成揪面片，就是甘肃的揪面片炒法。",
    "加一把泡软的粉条同焖，汤更稠，饱腹感更强。"
  ],
  "serving_suggestion": "一勺面鱼一勺菜卤，最后淋辣油，呼噜呼噜吃一碗很痛快。",
  "storage": "面鱼可冷冻半个月，菜卤冷藏两天，吃时现煮现拌。",
