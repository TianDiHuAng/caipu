  "equipment": [
    "炖锅",
    "和面盆",
    "平底锅",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛腩切成三厘米见方的块，冷水泡半小时洗去血水。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡透血水，炖出来的汤才不腥。",
      "visual_cue": "肉色变浅，水色泛红"
    },
    {
      "n": 2,
      "text": "牛腩冷水下锅，加姜片与料酒焯水，撇净浮沫后捞出。",
      "time_min": 8,
      "heat": "大火",
      "tip": "浮沫撇干净，卤汤才清。",
      "visual_cue": "浮沫撇净，汤色转清"
    },
    {
      "n": 3,
      "text": "炖锅倒植物油炒化白糖，再下牛腩块翻炒到均匀上色。",
      "time_min": 4,
      "heat": "中火",
      "tip": "糖色炒到枣红，肉块才红亮。",
      "visual_cue": "肉块均匀裹上糖色"
    },
    {
      "n": 4,
      "text": "加浓口酱油、盐、八角、桂皮、干辣椒、大葱与姜片炒出香味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香料炒过再炖，香气更透。",
      "visual_cue": "香味散出，锅底微稠"
    },
    {
      "n": 5,
      "text": "加热水没过肉块，烧开后转小火炖九十分钟。",
      "time_min": 90,
      "heat": "小火",
      "tip": "小火久炖，筋才软糯不柴。",
      "visual_cue": "筷子一插就透，汤汁收紧"
    },
    {
      "n": 6,
      "text": "面粉加酵母与水和成面团，盖布醒一小时至两倍大。",
      "time_min": 60,
      "heat": "无火",
      "tip": "面稍硬些，烤出的馍才有嚼头。",
      "visual_cue": "面团膨大，扯开有蜂窝"
    },
    {
      "n": 7,
      "text": "面团分成四份揉圆擀成圆饼，平底锅小火烙到两面金黄。",
      "time_min": 12,
      "heat": "小火",
      "tip": "小火干烙，饼皮才脆而不焦。",
      "visual_cue": "两面金黄，边缘有花纹"
    },
    {
      "n": 8,
      "text": "牛腩捞出剁碎拌青椒与香菜，馍横向剖开夹入肉碎浇汁。",
      "time_min": 5,
      "heat": "无火",
      "tip": "浇一勺卤汁，馍才不干。",
      "visual_cue": "馅料满溢，汁水渗进馍"
    }
  ],
  "tips": [
    "卤肉要炖够时间，筋膜软烂才是精髓。",
    "馍要现烙现夹，放凉后口感发硬咬不动。",
    "剁肉时拌一勺卤汁，吃起来更润。"
  ],
  "common_mistakes": [
    "牛腩没有焯水就直接炖，卤汤腥味很重。",
    "馍烙得太大太厚，夹肉后咬不动。",
    "肉剁得太碎成了肉泥，完全没有嚼头。"
  ],
  "substitutions": [
    {
      "original": "牛腩",
      "substitute": "羊肉",
      "ratio": "500 克:500 克",
      "note": "炖制时间缩短二十分钟，去腥多加姜。"
    },
    {
      "original": "青椒",
      "substitute": "香菜",
      "ratio": "50 克:30 克",
      "note": "不吃辣可全用香菜，香气更清新。"
    }
  ],
  "variations": [
    "加一勺辣椒油拌进肉里，做成辣味肉夹馍。",
    "馍表面刷一层薄油再烙，饼皮更酥。"
  ],
  "serving_suggestion": "一个热馍配一碗羊肉汤，再来碟糖蒜。",
  "storage": "卤肉连汁冷藏三天、冷冻一个月；馍冷冻保存，复热用平底锅干烙。",
