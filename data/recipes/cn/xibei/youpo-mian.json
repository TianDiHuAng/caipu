    "rich"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面条",
          "name_en": "wheat noodles",
          "amount": 300,
          "unit": "g",
          "note": "选 2 厘米宽的手擀宽面，或现扯的裤带面",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "青菜",
          "name_en": "bok choy",
          "amount": 120,
          "unit": "g",
          "note": "上海青或小油菜，最后与面同煮 30 秒",
          "optional": false
        },
        {
          "name": "大葱",
          "name_en": "welsh onion",
          "amount": 20,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
          "name": "蒜",
          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
          "note": "切末，泼油前铺在面上",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "辣椒面",
          "name_en": "chili flakes",
          "amount": 20,
          "unit": "g",
          "note": "选粗颗粒秦椒面，香而不燥",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 25,
          "unit": "ml",
          "note": "碗底调味",
          "optional": false
        },
        {
          "name": "香醋",
          "name_en": "black vinegar",
          "amount": 15,
          "unit": "ml",
          "note": "吃前淋入",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "面汤与碗底各半",
          "optional": false
        },
        {
          "name": "菜籽油",
          "name_en": "rapeseed oil",
          "amount": 80,
          "unit": "ml",
          "note": "泼油用，须烧到冒烟",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "深汤锅",
    "小奶锅",
    "大碗",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大碗中放 25 毫升生抽、1.5 克盐与 10 毫升清水调成碗底汁；蒜切末、大葱切大葱末备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "碗底先放液体调料，泼油后味道能顺面条渗下去。",
      "visual_cue": "碗底汁呈浅酱色、无未溶盐粒。"
    },
    {
      "n": 2,
      "text": "汤锅加 2 升水与 1.5 克盐烧开，下宽面大火煮 3 分钟，用筷子轻推防止粘连，起锅前 30 秒下青菜同煮。",
      "time_min": 4,
      "heat": "大火",
      "tip": "宽面下锅后水会降温，须保持大火让水快速回到沸腾。",
      "visual_cue": "面条浮起、边缘略透，掐断中心留一点白芯。"
    },
    {
      "n": 3,
      "text": "面条与青菜捞入碗中，铺上 20 克辣椒面、蒜末与大葱末，堆在面条中央。",
      "time_min": 1,
      "heat": "无火",
      "tip": "辣椒面要集中堆放，泼油时才能一次激透。",
      "visual_cue": "调料堆成小山状、覆盖住面条中心。"
    },
    {
      "n": 4,
      "text": "小奶锅倒 80 毫升菜籽油烧到冒青烟，分两次泼在辣椒面上，听到滋滋声后淋 15 毫升香醋，立即从碗底向上拌匀。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油温必须够高，油不冒烟泼下去只有生油味；分两次泼能避免辣椒面焦糊。",
      "visual_cue": "辣椒面由鲜红转为暗红油亮、空气中弥漫焦香与蒜香。"
    }
  ],
  "tips": [
    "泼油时油温是关键，烧到油面微微冒烟、插入筷子冒密集小泡即可。",
    "香醋在泼油后立刻淋，热油激出的醋酸香比直接拌更立体。"
  ],
  "common_mistakes": [
    "辣椒面受潮结块，泼油后一半焦一半生，香气不均。",
    "面条煮好后不沥干就装碗，碗底积水使料汁变淡。"
  ],
  "substitutions": [
    {
      "original": "辣椒面",
      "substitute": "辣椒油",
      "ratio": "20 克辣椒面对应 40 毫升辣椒油",
      "note": "用辣椒油则不需泼油，直接拌匀即可，香气略逊。"
    },
    {
      "original": "青菜",
      "substitute": "菠菜",
      "ratio": "1:1",
      "note": "菠菜需焯水去草酸，煮 20 秒即可。"
    }
  ],
  "variations": [
    "家庭简化版：用挂面替代宽面，煮 4 分钟，成品少了筋道但省去和面时间。",
    "西安街头版：加 50 克臊子肉末与 20 克豆芽，成为臊子油泼面。"
  ],
  "serving_suggestion": "2 人份，趁热拌开食用，配一瓣生蒜与面汤；不宜久放，面条会吸干油汁。",
  "storage": "现做现吃；油泼辣子可单独多做，冷藏保存 2 周。",
  "nutrition_estimate": {
    "basis": "每份（约 280 克成品）",
    "calories_kcal": 746,
    "protein_g": 18.4,
    "fat_g": 38.6,
    "carbs_g": 82.4,
