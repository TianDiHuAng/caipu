    "盆",
    "擀面杖",
    "刀",
    "案板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加酵母、三克盐和清水揉成软面团，盖布发酵四十分钟至体积变大。",
      "time_min": 44,
      "heat": "无火",
      "tip": "面团揉到盆光手光面光，发酵才均匀。",
      "visual_cue": "面团膨起，指按有浅坑"
    },
    {
      "n": 2,
      "text": "取六十克面粉放碗里，浇上烧热的植物油搅成流动的油酥，加五香粉和盐拌匀。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油要烧到微微冒烟再浇，生油味才去得掉。",
      "visual_cue": "油酥浓稠能挂勺，香气扑鼻"
    },
    {
      "n": 3,
      "text": "面团擀成大片，把油酥均匀抹满，撒一层面粉后从一边卷成紧实的长条。",
      "time_min": 7,
      "heat": "无火",
      "tip": "撒干面粉能隔层，卷起来层次才清楚。",
      "visual_cue": "面片上油酥分布均匀无空隙"
    },
    {
      "n": 4,
      "text": "长条切成四段，两头捏紧收口，竖起来按扁擀成一厘米厚的圆馍。",
      "time_min": 6,
      "heat": "无火",
      "tip": "收口一定捏紧，不然烙的时候油酥全漏出来。",
      "visual_cue": "圆馍厚薄一致，边缘整齐"
    },
    {
      "n": 5,
      "text": "馍面刷一层清水撒上芝麻，平底锅不放油，小火干烙六分钟至两面金黄。",
      "time_min": 8,
      "heat": "小火",
      "tip": "锅里不放油，干烙出来的馍才脆不腻。",
      "visual_cue": "两面金黄，芝麻微微鼓胀"
    },
    {
      "n": 6,
      "text": "烙好的馍立起来靠一会儿散热，表皮回脆后再装盘上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "立着放能散水汽，平放会把底面捂软。",
      "visual_cue": "表皮干爽，轻敲有脆响"
    }
  ],
  "tips": [
    "油酥要用热油泼面粉，凉油泼出来是死面疙瘩，抹不开也起不了层。油温要够。",
    "卷条时卷得越紧，烙出来的层次越多越脆。松松散散卷的馍切开只有实心一团。",
    "干烙全程小火，火一大外皮焦了里面还是生的。翻面要勤，六分钟里翻三次。",
    "馍烙好别马上装袋，水汽闷回去表皮就软了。立着晾几分钟再收，脆度能保住。"
  ],
  "common_mistakes": [
    "油酥里只放面粉不放盐，馍吃着发淡。盐和五香粉要在油酥里一起拌开才入味。",
    "面团发过头带酸味，烙出来的馍有股馊气。发到一点五倍大就该动手了。",
    "收口没捏紧，烙的时候油酥流到锅里，馍变成干饼。这一步最容易被忽略。",
    "芝麻撒完不按压，出锅全掉锅里。撒完用手掌轻按一遍才能粘牢。"
  ],
  "substitutions": [
    {
      "original": "五香粉",
      "substitute": "花椒粉",
      "ratio": "3克:3克",
      "note": "麻香更直接，西北风味更足。"
    },
    {
      "original": "植物油",
      "substitute": "羊油",
      "ratio": "80毫升:70克",
      "note": "更香更厚重，凉了会发硬。"
    }
  ],
  "variations": [
    "油酥里加一勺辣椒面，做成辣味油酥馍。配汤吃更带劲。",
    "馍烙好后从侧面剖开夹卤肉，就是西北家常的肉夹馍吃法。",
    "用烤箱两百度烤十五分钟代替干烙，受热更均匀。适合一次做多份。"
  ],
  "serving_suggestion": "趁热掰开吃，外层脆响、内里层层酥软，配一碗羊肉汤或豆浆，西北人的早饭就这么简单。",
  "storage": "密封常温放两天，吃前用平底锅干烙两分钟或烤箱一百六十度回烤五分钟即回脆。",
