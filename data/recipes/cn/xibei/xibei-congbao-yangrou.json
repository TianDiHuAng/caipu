  "steps": [
    {
      "n": 1,
      "text": "羊腿肉逆着纹理切成两毫米薄片，加生抽、白砂糖和一勺清水抓匀腌十分钟。",
      "time_min": 13,
      "heat": "无火",
      "tip": "逆着纹理切断纤维，羊肉才嫩不塞牙。",
      "visual_cue": "肉片薄透，表面挂一层酱色"
    },
    {
      "n": 2,
      "text": "大葱斜刀切三厘米长的段，葱白葱绿分开，蒜切片姜切丝备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "葱白先下锅，葱绿最后放才不会出水。",
      "visual_cue": "葱段粗细均匀，断面整齐"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟，倒植物油滑满锅壁后下羊肉片，大火快速翻炒四十秒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "锅一定要烧透，温锅下肉会出一锅水。",
      "visual_cue": "肉片卷边变色，锅气上冲"
    },
    {
      "n": 4,
      "text": "肉片七成熟时下姜丝、蒜片和葱白段，继续大火翻炒三十秒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "葱白下锅就要翻，炒久了甜味会变苦。",
      "visual_cue": "葱白微微透亮，边缘起焦"
    },
    {
      "n": 5,
      "text": "沿锅边淋陈醋，加盐和剩余的葱绿，快速翻匀后立刻出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "陈醋沿锅边淋，遇热激出的香气最足。",
      "visual_cue": "葱绿翠亮未塌，盘底无汤水"
    },
    {
      "n": 6,
      "text": "装盘后趁热吃，盘底只留薄薄一层油，不见多余汤汁最好。",
      "time_min": 2,
      "heat": "无火",
      "tip": "全程从下肉到出锅不要超过一分半钟。",
      "visual_cue": "盘底只漾一层油，葱段挺立"
    }
  ],
  "tips": [
    "羊肉片要薄，切之前把肉放冷冻室冻二十分钟，定型后更好切。切厚了只能靠久炒，肉就老了。",
    "腌肉时加一勺清水抓进去，肉片吸水后更嫩。抓到手感发黏再加淀粉会锁得更牢。",
    "大葱是主角不是配料，用量要足。葱少了压不住羊肉的膻气，整盘味道都散。",
    "全程大火快炒，锅不离火人不离锅。这菜讲究一个急火，火候一慢就出汤变炖菜。"
  ],
  "common_mistakes": [
    "羊肉片一下锅就翻个不停，肉全碎了。下锅后摊平静置十秒再翻才成型。",
    "葱和肉一起下锅，葱炒烂了肉还没熟。葱白要等肉七成熟时才进去。",
    "陈醋直接浇在肉上，酸味发闷。沿锅边淋让醋遇热汽化，香气才能飘出来。",
    "盐放早了肉出水，炒成泡肉。盐要在出锅前最后一刻下，味准肉也嫩。"
  ],
  "substitutions": [
    {
      "original": "羊腿肉",
      "substitute": "羊里脊",
      "ratio": "500克:500克",
      "note": "更嫩更瘦，炒制时间可再短十秒。"
    },
    {
      "original": "大葱",
      "substitute": "洋葱",
      "ratio": "200克:200克",
      "note": "甜味更重，辛香稍弱。"
    }
  ],
  "variations": [
    "加一把香菜段同炒，辛香更野。西北小馆常见这个版本，配馒头吃。",
    "用羊油代替植物油滑锅，膻香更重更正。怕膻的人慎用这个做法。",
    "加半勺辣椒面炒出红油，做成辣爆羊肉。下饭程度直接翻倍。"
  ],
  "serving_suggestion": "刚出锅就上桌，肉嫩葱香、盘底漾油，配手抓饭或白馒头都合适，最下饭的是拿汤汁拌米饭。",
  "storage": "冷藏可放一天，复热用大火快炒三十秒；不建议微波，肉片会变硬发柴。",
