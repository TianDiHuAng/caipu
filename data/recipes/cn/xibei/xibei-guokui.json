      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 400,
          "unit": "g",
          "note": "中筋面粉",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 5,
          "unit": "g",
          "note": "发面",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 220,
          "unit": "ml",
          "note": "和面",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 30,
          "unit": "ml",
          "note": "抹面",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 15,
          "unit": "g",
          "note": "撒面",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "平底锅",
    "盆",
    "擀面杖",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加酵母、盐和二百二十毫升清水揉成偏硬面团，盖布发酵三十分钟。",
      "time_min": 32,
      "heat": "无火",
      "tip": "水别一次倒完，留一点看面团软硬再补。",
      "visual_cue": "面团光滑，按压回弹"
    },
    {
      "n": 2,
      "text": "面团擀成大片，表面抹一层植物油，撒少许干面粉卷起成条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "抹油撒粉是起层的关键，别省这两步。",
      "visual_cue": "面片卷紧，层次分明"
    },
    {
      "n": 3,
      "text": "面卷切成四段，两边捏紧收口，竖着按扁再擀成两厘米厚的圆饼。",
      "time_min": 6,
      "heat": "无火",
      "tip": "厚度保持两厘米，太薄烤完发硬像饼干。",
      "visual_cue": "圆饼厚薄均匀，边缘齐整"
    },
    {
      "n": 4,
      "text": "饼面刷薄层清水，撒上芝麻轻按，让芝麻粘牢不掉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷水再撒芝麻才粘得住，干撒一翻面全掉。",
      "visual_cue": "芝麻密布，贴住不掉"
    },
    {
      "n": 5,
      "text": "平底锅小火烧热不放油，饼坯下锅加盖烙十分钟，一面定型再翻。",
      "time_min": 12,
      "heat": "小火",
      "tip": "全程小火慢烙，火大外面焦里面生。",
      "visual_cue": "底面浅黄，饼身微鼓"
    },
    {
      "n": 6,
      "text": "翻面再烙八分钟，两面都出现焦褐色斑点后出锅，稍凉切块。",
      "time_min": 10,
      "heat": "小火",
      "tip": "两面都烙透才脆，凉两分钟再切不塌。",
      "visual_cue": "两面焦斑均匀，掰开有层次"
    }
  ],
  "tips": [
    "面团偏硬才烙得出脆壳，软面只会烙成软饼。",
    "抹油卷条是起层的核心，省了就是一块死面。",
    "全程小火加盖，火大容易外焦内生。"
  ],
  "common_mistakes": [
    "面团太软，烙出来软塌没有脆壳。",
    "饼擀得太薄，出锅硬得根本咬不动。",
    "火开太大，表面焦黑里面还是生面。"
  ],
  "substitutions": [
    {
      "original": "面粉",
      "substitute": "全麦面粉",
      "ratio": "400 克:400 克",
      "note": "麦香更重，需多加二十毫升清水。"
    },
    {
      "original": "芝麻",
      "substitute": "孜然粒",
      "ratio": "15 克:10 克",
      "note": "香气更冲，西北风味更足。"
    }
  ],
  "variations": [
    "和面时加一勺猪油，层次更酥更香。",
    "饼里夹卤肉和青椒，就是西北肉夹馍。"
  ],
  "serving_suggestion": "切块趁热吃，掰开夹卤肉或就着羊肉汤，西北人常拿它当主食。",
  "storage": "密封常温放两天，吃前用平底锅干烙两分钟回脆。",
