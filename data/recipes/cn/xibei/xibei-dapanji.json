  "steps": [
    {
      "n": 1,
      "text": "整鸡剁成大块，冷水浸泡二十分钟去血水，捞出沥干水分。",
      "time_min": 22,
      "heat": "无火",
      "tip": "水要沥干，带水下锅会溅油，鸡皮也不易上色。",
      "visual_cue": "鸡块表面干爽，血色褪去"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下冰糖小火炒到融化成枣红色，倒入鸡块中火翻炒上色。",
      "time_min": 8,
      "heat": "小火",
      "tip": "鸡选两斤半的土鸡，肉质紧实耐炖，炖久了也不散。",
      "visual_cue": "鸡块均匀裹上红亮糖色"
    },
    {
      "n": 3,
      "text": "下姜片、蒜、葱段、干辣椒、花椒与桂皮炒香，烹入料酒。",
      "time_min": 4,
      "heat": "中火",
      "tip": "干辣椒别炒黑，一黑就苦，辣味也跑了。",
      "visual_cue": "香料飘香，辣椒转暗红"
    },
    {
      "n": 4,
      "text": "加生抽与老抽翻匀，倒入没过鸡块的热水，大火烧开转中火焖二十分钟。",
      "time_min": 23,
      "heat": "中火",
      "tip": "一定加热水，冷水会让鸡肉骤然收紧发柴。",
      "visual_cue": "汤汁翻滚呈深褐色，油花浮面"
    },
    {
      "n": 5,
      "text": "下土豆块继续焖十五分钟，至土豆边缘发软、汤汁变稠。",
      "time_min": 17,
      "heat": "中火",
      "tip": "土豆后放，早了会化在汤里，汤变糊就不好看了。",
      "visual_cue": "土豆外软内实，汤汁收浓"
    },
    {
      "n": 6,
      "text": "放青椒与洋葱块，加盐调味，大火翻炒三分钟收汁。",
      "time_min": 4,
      "heat": "大火",
      "tip": "青椒最后下，脆感才在，久煮就黄了。",
      "visual_cue": "青椒翠绿，汤汁裹料发亮"
    },
    {
      "n": 7,
      "text": "放青椒与洋葱块，加盐调味，转大火翻炒三分钟收浓汤汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汤别收太干，大盘鸡的精华就在这口汤。",
      "visual_cue": "青椒翠绿，汤汁裹料发亮光"
    }
  ],
  "tips": [
    "鸡选两斤半的土鸡，肉质紧实耐炖，炖久了也不散架发柴。",
    "土豆选黄心的，炖出来绵软带甜，白心的偏水不糯。",
    "吃完肉拌一把宽面进汤里，才是完整的大盘鸡吃法。"
  ],
  "common_mistakes": [
    "鸡块不沥干就下锅，油花四溅，鸡皮也上不了色。",
    "土豆和鸡一起下锅，炖到最后土豆化成了糊。",
    "干辣椒炒糊，整锅发苦，辣味只剩刺激没有香。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡腿肉",
      "ratio": "1200克:900克",
      "note": "鸡腿肉更嫩，焖的时间减到十五分钟。"
    },
    {
      "original": "土豆",
      "substitute": "胡萝卜",
      "ratio": "500克:400克",
      "note": "胡萝卜更耐焖，可早放五分钟。"
    }
  ],
  "variations": [
    "加一把皮带面同焖，面吸饱汤汁，就是新疆的拌面版本。",
    "把鸡换成羊排，做成大盘羊排，风味更浓。"
  ],
  "serving_suggestion": "连汤带肉盛在大盘里，一家人围着吃，最后拌面收尾。",
  "storage": "冷藏可存三天，复热须小火加少许水烧开，土豆会散要轻翻。",
