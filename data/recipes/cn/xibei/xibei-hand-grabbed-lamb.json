  "steps": [
    {
      "n": 1,
      "text": "羊排剁成带骨大块，放进清水里浸泡一小时，中途换两次水。",
      "time_min": 70,
      "heat": "无火",
      "tip": "血水泡得足够干净，膻味才不厚重。",
      "visual_cue": "水色清澈不再发红"
    },
    {
      "n": 2,
      "text": "羊排冷水下锅，大火烧开后撇净表面的浮沫，再捞出冲洗一遍。",
      "time_min": 10,
      "heat": "大火",
      "tip": "一定要冷水下锅，血沫才逼得出来。",
      "visual_cue": "浮沫撇净，肉色发白"
    },
    {
      "n": 3,
      "text": "羊排重新入锅，加清水、姜片、大葱段和花椒，大火烧开转小火。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水要一次加足，中途加水汤味会变淡。",
      "visual_cue": "汤面微沸，香气上浮"
    },
    {
      "n": 4,
      "text": "小火慢炖一小时，炖到筷子能轻松插进羊排最厚的地方。",
      "time_min": 65,
      "heat": "小火",
      "tip": "保持微沸状态，大火翻滚肉会散。",
      "visual_cue": "筷子一插就能穿透"
    },
    {
      "n": 5,
      "text": "加十克盐再煮五分钟，让咸味慢慢渗进羊排的肉里。",
      "time_min": 5,
      "heat": "小火",
      "tip": "盐要后放，肉才不会柴也不掉渣。",
      "visual_cue": "汤汁微咸，肉香浓郁"
    },
    {
      "n": 6,
      "text": "捞出羊排装盘，撒剩下的盐，配大蒜泥、小米辣和香菜上桌。",
      "time_min": 4,
      "heat": "无火",
      "tip": "一定要趁热吃，凉了膻味会回来。",
      "visual_cue": "肉色白净，骨肉分明"
    }
  ],
  "tips": [
    "羊排先泡够一小时血水，膻味能去掉大半。",
    "全程只加花椒和姜葱，调料多了反而盖住羊肉本身的香味。",
    "盐要后放，早放肉容易柴也容易掉渣。"
  ],
  "common_mistakes": [
    "羊排没泡水直接下锅，汤和肉都带一股膻味。",
    "用大火猛煮，肉块散开骨头都掉出来了。",
    "中途加冷水，肉质骤缩变得又硬又柴。"
  ],
  "substitutions": [
    {
      "original": "羊排",
      "substitute": "羊腿肉",
      "ratio": "1200 克:1200 克",
      "note": "更瘦，炖的时间缩短十分钟。"
    },
    {
      "original": "花椒",
      "substitute": "白胡椒",
      "ratio": "5 克:3 克",
      "note": "去膻效果相近，香气更清。"
    }
  ],
  "variations": [
    "加几块白萝卜同炖，汤汁更清甜。",
    "炖好后撒一把熟芝麻，香气更足。"
  ],
  "serving_suggestion": "大盘装肉，配蒜泥、韭菜花和一杯砖茶，是西北草原待客最实在的一道。",
  "storage": "冷藏两天，复热连汤小火煮十分钟；汤可单独下面或泡馍。",
