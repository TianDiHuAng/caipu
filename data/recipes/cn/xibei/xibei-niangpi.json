  "steps": [
    {
      "n": 1,
      "text": "面粉加两克盐和二百四十毫升清水揉成光滑面团，盖布醒三十分钟。",
      "time_min": 35,
      "heat": "无火",
      "tip": "面团要揉到表面光洁，洗面时才不出渣。",
      "visual_cue": "面团光滑，按压迅速回弹"
    },
    {
      "n": 2,
      "text": "面团放进盆里加清水反复抓洗，把洗出的白浆倒进另一个盆里静置。",
      "time_min": 15,
      "heat": "无火",
      "tip": "一直洗到水变清为止，面筋才够筋道。",
      "visual_cue": "面筋抱成一团，洗水由白转清"
    },
    {
      "n": 3,
      "text": "面浆静置四小时，倒掉上层清水，留底下浓稠的浆液加碱面搅匀。",
      "time_min": 245,
      "heat": "无火",
      "tip": "静置时间不够浆太稀，蒸出来软塌不筋。",
      "visual_cue": "浆液浓稠，勺背挂一层白膜"
    },
    {
      "n": 4,
      "text": "蒸盘刷一层植物油，舀一勺浆液转匀铺满，上锅大火蒸三分钟至起泡。",
      "time_min": 9,
      "heat": "大火",
      "tip": "蒸盘必须刷油，不然揭不下来会碎掉。",
      "visual_cue": "表面鼓起大泡，整片透亮"
    },
    {
      "n": 5,
      "text": "蒸好的酿皮连盘放凉水盆上降温，稍凉后揭下刷油铺平，依次蒸完剩余浆液。",
      "time_min": 8,
      "heat": "无火",
      "tip": "过凉水这一步能让酿皮更弹，千万别省略。",
      "visual_cue": "酿皮透亮有韧性，能整片揭起"
    },
    {
      "n": 6,
      "text": "酿皮切成一厘米宽的条，面筋切小块一起装碗，铺上黄瓜丝。",
      "time_min": 6,
      "heat": "无火",
      "tip": "刀上抹一点植物油再切，条才不粘刀。",
      "visual_cue": "切面整齐，一条条分明不粘"
    },
    {
      "n": 7,
      "text": "蒜泥加盐、陈醋和凉开水调成汁浇上，最后淋辣椒油拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "辣椒油要最后淋，颜色才红亮不浑浊。",
      "visual_cue": "红油裹住每条酿皮，色泽油亮"
    }
  ],
  "tips": [
    "洗面是酿皮的关键，水要少量多次加，洗出的面浆越浓蒸出来越筋。一次倒太多水浆就稀了。",
    "面浆静置至少四小时，夏天可放冰箱过夜。时间够了淀粉沉底，倒掉清水后浓度才对。",
    "蒸盘刷油要薄要匀，油多了浆液挂不住会滑开。用厨房纸擦一遍最均匀。",
    "蒸到表面鼓起大泡才算熟，提前揭会粘盘碎裂。看到泡起再等半分钟最稳。"
  ],
  "common_mistakes": [
    "面浆没静置直接蒸，酿皮软塌糊嘴。淀粉必须沉下来，浆浓才成片。",
    "蒸盘不刷油，酿皮揭下来碎成渣。每次蒸前都要重新刷一遍油。",
    "蒸好的酿皮堆着放，粘成一坨。必须一片片刷油摞起来或者摊开晾。",
    "蒜泥现捣现用，提前捣好会发绿变苦。蒜泥放着别超过半小时。"
  ],
  "substitutions": [
    {
      "original": "黄瓜",
      "substitute": "绿豆芽",
      "ratio": "100克:120克",
      "note": "需焯水十秒再过凉，口感更脆。"
    },
    {
      "original": "辣椒油",
      "substitute": "芝麻酱",
      "ratio": "30毫升:40克",
      "note": "香而不辣，适合不吃辣的人。"
    }
  ],
  "variations": [
    "面筋单独蒸熟切块，吸汁后比酿皮还香。西北老饕专挑面筋吃。",
    "调汁里加一勺芥末水，冲劲更足。兰州夏天的吃法，一口下去眼泪直流。",
    "换成荞麦面浆做荞酿皮，颜色发暗但麦香更浓。西北山区常见这个版本。"
  ],
  "serving_suggestion": "酿皮切条装碗，铺黄瓜丝和面筋，浇蒜汁和辣椒油拌匀，酸辣爽滑，夏天当凉菜或主食都合适。",
  "storage": "酿皮冷藏可放一天，拌汁要现吃现调；面筋冷冻可存一周，吃前蒸软再切。",
