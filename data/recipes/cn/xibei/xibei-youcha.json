  ],
  "steps": [
    {
      "n": 1,
      "text": "炒锅烧干，倒面粉小火不停翻炒十五分钟至面粉由白转浅黄。",
      "time_min": 17,
      "heat": "小火",
      "tip": "全程小火不停铲，一分钟不翻就糊底。",
      "visual_cue": "面粉呈浅杏黄色，麦香扑鼻"
    },
    {
      "n": 2,
      "text": "面粉炒好后拨到一边，倒植物油烧热，和面粉一起翻炒均匀成颗粒。",
      "time_min": 6,
      "heat": "小火",
      "tip": "油要完全炒进面粉里，结块才松散不粘。",
      "visual_cue": "面粒油润松散，不结大疙瘩"
    },
    {
      "n": 3,
      "text": "另起干锅小火炒香花生、芝麻和核桃碎，炒到芝麻跳起立即盛出。",
      "time_min": 6,
      "heat": "小火",
      "tip": "芝麻一跳起来就起锅，多炒十秒就会发苦。",
      "visual_cue": "花生酥脆，芝麻微微鼓胀"
    },
    {
      "n": 4,
      "text": "花椒小火干炒一分钟出香，晾凉后擀成细粉，与盐混合成调味粉。",
      "time_min": 4,
      "heat": "小火",
      "tip": "花椒炒到能闻到麻香就停，炒黑就废。",
      "visual_cue": "花椒颜色转深，一捏就碎成粉"
    },
    {
      "n": 5,
      "text": "炒好的面粒里拌入坚果碎和椒盐粉，翻匀后晾凉装进密封罐。",
      "time_min": 5,
      "heat": "无火",
      "tip": "必须完全晾凉再装罐，热的会返潮结块。",
      "visual_cue": "干爽松散，无结块粘连"
    },
    {
      "n": 6,
      "text": "喝时取三大勺油茶粉放碗里，冲入滚开的水边冲边搅成糊，静置一分钟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水必须大滚，冲的时候快速搅才不起疙瘩。",
      "visual_cue": "糊面顺滑，表面浮一层油光"
    }
  ],
  "tips": [
    "炒面粉是油茶的命门，火要小、铲要勤。面粉一旦糊底，整锅都带焦苦味只能扔。",
    "油分两次加更好操作：先倒一半把面炒散，再补一半让面粒油润。一次全倒容易结块。",
    "坚果炒好后要晾凉再拌，热的拌进去会把面粒捂软。凉透的坚果更脆。",
    "冲油茶的水必须是大滚的开水，八九十度的水冲出来是一碗疙瘩汤，搅不开。"
  ],
  "common_mistakes": [
    "面粉大火炒，一分钟就糊。必须小火，锅铲贴着锅底一直翻。",
    "冲油茶先用凉水调糊再冲热水，容易结块。直接滚水冲同时快速搅更顺滑。",
    "油茶粉受潮结块，冲不开还发霉。装罐必须晾凉密封，放阴凉干燥处。",
    "盐一次放太多，整罐咸得不能喝。椒盐粉按需拌，或喝时另加更灵活。"
  ],
  "substitutions": [
    {
      "original": "核桃",
      "substitute": "瓜子仁",
      "ratio": "40克:40克",
      "note": "香气更轻，适合不喜欢核桃的人。"
    },
    {
      "original": "植物油",
      "substitute": "羊油",
      "ratio": "60毫升:50克",
      "note": "更香更浓，西北牧区传统做法。"
    }
  ],
  "variations": [
    "冲好的油茶里泡一块锅盔或掰碎的馍，就是西北人的油茶泡馍。管饱又暖身。",
    "加一勺奶粉同冲，奶香更厚。孩子更容易接受这个味道。",
    "把椒盐粉换成糖和桂花，做成甜油茶。西北和晋南各有各的吃法。"
  ],
  "serving_suggestion": "取粉冲糊装碗，趁热小口喝，配油条、锅盔或直接当早饭粥，暖胃顶饱，冬天出门前喝一碗最实在。",
  "storage": "油茶粉密封常温可放一个月，注意防潮；冲好的油茶当餐喝完，隔夜会分层发酸。",
