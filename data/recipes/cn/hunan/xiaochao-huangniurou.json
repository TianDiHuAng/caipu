  "equipment": [
    "炒锅",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆纹切成 2mm 薄片，加盐 2g、料酒、白胡椒、玉米淀粉与 20ml 清水抓至发黏，最后拌 10ml 植物油，腌 15 分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "抓到肉片发黏再封油，水分才锁得住，炒出来才嫩。",
      "visual_cue": "肉片黏手、表面有光泽"
    },
    {
      "n": 2,
      "text": "小米辣、尖椒、芹菜、蒜苗、姜蒜全部切好分开放置；生抽、蚝油与余下的盐调成小碗汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "小炒讲究一气呵成，配料必须提前备齐，下锅前不能停手。",
      "visual_cue": "配料按用量分装成小碟"
    },
    {
      "n": 3,
      "text": "炒锅烧至冒烟，下 40ml 植物油，牛里脊片摊开大火煎 15 秒后快速划散，变色立刻盛出，锅里留油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "牛里脊只需七成熟就盛出，后面回锅还有余温继续加热。",
      "visual_cue": "牛里脊表面变褐、中心略粉"
    },
    {
      "n": 4,
      "text": "原锅下姜蒜与小米辣爆香 10 秒，加尖椒与芹菜大火翻炒 40 秒至断生。",
      "time_min": 1,
      "heat": "大火",
      "tip": "辣椒炒到边缘起虎皮斑最香，别炒软。",
      "visual_cue": "辣椒表皮微皱、散发呛香"
    },
    {
      "n": 5,
      "text": "牛里脊回锅，淋入小碗汁与剩下的植物油，下蒜苗，大火颠炒 20 秒立即出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "蒜苗最后放，保持翠绿与辛香。",
      "visual_cue": "蒜苗变翠绿、锅底酱汁收紧不流水"
    }
  ],
  "tips": [
    "牛里脊一定要逆纹切，切断长纤维，口感才嫩。",
    "全程大火短炒，锅要够热，否则牛里脊出水变成煮牛里脊。",
    "怕辣可把小米辣改用 15g，另加 5g 豆瓣酱补足香气。"
  ],
  "common_mistakes": [
    "牛里脊顺纹切片会保留长纤维，嚼起来像橡皮，务必逆纹切断。",
    "腌肉时水加太多又没抓匀，下锅出水，肉变柴。",
    "所有配料一起下锅，辣椒炒烂、牛里脊过熟。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "肥牛片",
      "ratio": "350g 牛里脊 ≈ 300g 肥牛",
      "note": "肥牛本身油脂多，植物油减到 30ml 即可。"
    },
    {
      "original": "蒜苗",
      "substitute": "青蒜",
      "ratio": "1:1",
      "note": "青蒜辛辣度接近，可直接替换。"
    }
  ],
  "variations": [
    "家庭简化版：用现成小炒肉酱料包代替生抽蚝油，减少备料时间。",
    "酸辣版：加 20g 泡椒与 10ml 香醋，酸辣开胃，更接近湘西口味。"
  ],
  "serving_suggestion": "趁热上桌，配白米饭是标准吃法；一盘小炒配一碗紫菜蛋汤即成家常一餐。",
  "storage": "冷藏 1 天，复热用大火快炒 30 秒，微波炉加热会让牛肉变硬。",
