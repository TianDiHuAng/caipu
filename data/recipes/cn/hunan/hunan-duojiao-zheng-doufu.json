  "equipment": [
    "蒸锅",
    "盘",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成两厘米厚的大片，用厨房纸吸去表面水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆腐先吸干表面水分，蒸完才不会出一盘汤。",
      "visual_cue": "豆腐片干爽，切口平整"
    },
    {
      "n": 2,
      "text": "豆腐片码进深盘里，一片压一片摆成整齐的扇形。",
      "time_min": 3,
      "heat": "无火",
      "tip": "摆得紧些汤汁才不会流散，蒸完更入味。",
      "visual_cue": "豆腐排齐，盘面平整"
    },
    {
      "n": 3,
      "text": "蒜切成细末后与剁辣椒、生抽和白糖拌成料汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "白糖一点点就够，用来压剁椒的死咸。",
      "visual_cue": "料汁红亮，蒜末均匀"
    },
    {
      "n": 4,
      "text": "料汁均匀铺在豆腐上，沿着盘边淋少许清水。",
      "time_min": 2,
      "heat": "无火",
      "tip": "沿边淋水能让底部也进味不干硬。",
      "visual_cue": "料铺均匀，盘底见汁"
    },
    {
      "n": 5,
      "text": "蒸锅水开后放入，中火蒸十二分钟至豆腐发胀。",
      "time_min": 13,
      "heat": "中火",
      "tip": "豆腐蒸到边角发胀鼓起来才算透。",
      "visual_cue": "豆腐鼓起，汤汁沸腾"
    },
    {
      "n": 6,
      "text": "取出淋上烧热的植物油，撒小葱碎即可上桌。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要烧到冒烟再淋，蒜香才被激出来。",
      "visual_cue": "热油滋响，葱末翠绿"
    }
  ],
  "tips": [
    "豆腐吸干水再蒸，成品不出汤更入味。",
    "热油最后淋，剁椒和蒜的香气才出来。",
    "选老一点的豆腐，蒸完不易碎还更入味。"
  ],
  "common_mistakes": [
    "豆腐不吸水就上锅，蒸出一盘稀汤。",
    "冷油直接淋，蒜末生辣呛口不香。",
    "大火蒸太久，豆腐脱水变成蜂窝状。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "日本豆腐",
      "ratio": "450 克:400 克",
      "note": "更嫩，蒸制时间缩短到八分钟。"
    },
    {
      "original": "剁辣椒",
      "substitute": "豆豉",
      "ratio": "40 克:30 克",
      "note": "不辣偏咸香，生抽减五毫升。"
    }
  ],
  "variations": [
    "底下垫一层泡软的粉丝，吸饱汤汁更好吃。",
    "表面撒少许花椒粉，麻香更有层次。"
  ],
  "serving_suggestion": "趁热连汁浇在白饭上，是最下饭的吃法。",
  "storage": "冷藏一天，复蒸五分钟回温即可。",
