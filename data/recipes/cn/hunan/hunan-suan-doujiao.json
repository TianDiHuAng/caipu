    "重石",
    "干净棉布",
    "无油锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豇豆掐去两头，挑掉有虫眼的，用清水冲洗两遍后摊在竹匾上晾 4 小时至表面全干。",
      "time_min": 20,
      "heat": "无火",
      "tip": "豆角必须完全晾干，带生水容易烂。",
      "visual_cue": "豆角表面无水珠、手感干爽"
    },
    {
      "n": 2,
      "text": "无油锅烧 800ml 清水，加 24g 盐与 10g 白糖煮开，关火放凉至完全冷却。",
      "time_min": 15,
      "heat": "中火",
      "tip": "卤水一定放凉再用，热卤会把豆角烫软。",
      "visual_cue": "卤水清澈、尝起来明显偏咸"
    },
    {
      "n": 3,
      "text": "玻璃坛用开水烫过晾干，把豇豆盘成圈塞入，放入姜片、大蒜，倒入冷却的卤水与 30ml 米醋。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆角要全部没入卤水，露出水面会发霉。",
      "visual_cue": "豆角浸没、卤水没过顶部"
    },
    {
      "n": 4,
      "text": "压上重石，坛口盖棉布再加盖，放在阴凉避光处静置 5 天。",
      "time_min": 5,
      "heat": "无火",
      "tip": "前三天别开盖，让乳酸菌安静工作。",
      "visual_cue": "第 3 天起坛内冒小泡、有酸香"
    },
    {
      "n": 5,
      "text": "第 5 天开盖闻酸香，豆角由翠绿转为黄绿、质地变脆即腌好，取出沥干切段。",
      "time_min": 5,
      "heat": "无火",
      "tip": "尝一根，酸度够了就取出冷藏。",
      "visual_cue": "豆角黄绿透亮、入口脆酸"
    }
  ],
  "tips": [
    "全程不能沾生水和油，这是腌菜成败的关键。",
    "盐量按豆角重量约 4% 放，太少容易坏。",
    "腌好的酸豆角冷藏保存，可放一个月。"
  ],
  "common_mistakes": [
    "豆角没晾干就入坛，几天后长白毛。",
    "卤水用热的下坛，豆角软塌不脆。",
    "坛子放在阳光下，温度过高发酸过头。"
  ],
  "substitutions": [
    {
      "original": "豇豆",
      "substitute": "四季豆",
      "ratio": "600g 对 600g",
      "note": "须选嫩荚，腌 6 天更入味。"
    },
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "30ml 对 25ml",
      "note": "酸味更冲，可减 5ml。"
    }
  ],
  "variations": [
    "辣味版：坛中加 30g 干辣椒同腌。",
    "肉末版：腌好后与肉末同炒成下饭菜。"
  ],
  "serving_suggestion": "切段直接佐粥，或与肉末、干辣椒同炒。",
  "storage": "冷藏可存 1 个月，取用时用干净无水的筷子。",
