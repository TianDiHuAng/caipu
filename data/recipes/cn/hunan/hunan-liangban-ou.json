  "steps": [
    {
      "n": 1,
      "text": "莲藕削去外皮，用刀切成两毫米厚的均匀薄片。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切薄片更脆，也更容易入味。",
      "visual_cue": "藕片薄而透光，孔眼完整。"
    },
    {
      "n": 2,
      "text": "藕片立刻泡进清水里，滴几滴米醋防氧化发黑。",
      "time_min": 5,
      "heat": "无火",
      "tip": "不泡水的话几分钟就变褐。",
      "visual_cue": "藕片洁白，水色清澈。"
    },
    {
      "n": 3,
      "text": "锅里烧水，水开后下藕片焯一分半钟，断生即捞出。",
      "time_min": 5,
      "heat": "大火",
      "tip": "时间久了藕片就粉,不脆。",
      "visual_cue": "藕片由白转半透明。"
    },
    {
      "n": 4,
      "text": "捞出藕片立刻放进冰水里浸三分钟，口感更脆。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冰水一激，脆度提升明显。",
      "visual_cue": "藕片冰凉，咬着发脆。"
    },
    {
      "n": 5,
      "text": "碗里放蒜末、小米辣、生抽、米醋、白糖、盐与辣椒油调匀。",
      "time_min": 4,
      "heat": "无火",
      "tip": "糖和醋的比例掌握在微甜的程度。",
      "visual_cue": "料汁酸香红亮，蒜末浮在表面"
    },
    {
      "n": 6,
      "text": "藕片沥干水分装盘，淋料汁拌匀，撒香菜、葱花与白芝麻，最后点几滴香油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌好静置十分钟入味更好吃。",
      "visual_cue": "藕片挂满红油，芝麻点缀。"
    }
  ],
  "tips": [
    "选表皮光滑、藕孔小的脆藕，凉拌才爽口。",
    "切好的藕片要立刻泡水，否则发黑。",
    "焯水时间宁短勿长，断生就够，久了口感会发粉。"
  ],
  "common_mistakes": [
    "藕片焯久了，口感发粉，凉拌就失去了脆劲。",
    "焯完不过冰水，余温让藕片继续软化。"
  ],
  "substitutions": [
    {
      "original": "莲藕",
      "substitute": "山药",
      "ratio": "700g 对 600g",
      "note": "山药版焯水四十秒即可，久了会散。"
    }
  ],
  "variations": [
    "湘西会加一勺擂辣椒同拌，辣香更冲，风味更像本地小馆。"
  ],
  "serving_suggestion": "作开胃凉菜，冷藏后更爽口，配辣菜正好解腻。",
  "storage": "冷藏一天，藕片久放出水口感变软。",
