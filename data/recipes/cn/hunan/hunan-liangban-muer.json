  "steps": [
    {
      "n": 1,
      "text": "干木耳用冷水泡发两小时，中途换一次水，泡到完全舒展。",
      "time_min": 125,
      "heat": "无火",
      "tip": "冷水泡的木耳更脆，泡发不超过四小时。",
      "visual_cue": "木耳涨大成朵，肉厚有弹性。"
    },
    {
      "n": 2,
      "text": "剪去木耳根部的硬蒂，撕成小朵，用清水冲洗两遍。",
      "time_min": 10,
      "heat": "无火",
      "tip": "根蒂有泥沙，一定剪掉。",
      "visual_cue": "木耳朵散开，水中无沙粒。"
    },
    {
      "n": 3,
      "text": "锅里烧水，水开后下木耳焯三分钟，彻底煮透。",
      "time_min": 5,
      "heat": "大火",
      "tip": "木耳必须煮透，不能只焯一下。",
      "visual_cue": "木耳卷边，色泽黑亮。"
    },
    {
      "n": 4,
      "text": "捞出木耳立刻过一遍凉水，沥干水分后放进大盆里。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水分沥干，料汁才不稀。",
      "visual_cue": "木耳干爽，盆底无水。"
    },
    {
      "n": 5,
      "text": "青椒切丝，与蒜末、小米辣、生抽、米醋、白糖、盐、辣椒油调成料汁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "青椒丝增加脆感和清香。",
      "visual_cue": "料汁红亮，配料色彩分明。"
    },
    {
      "n": 6,
      "text": "料汁倒进木耳盆里拌匀，撒香菜与葱花，点香油装盘。",
      "time_min": 5,
      "heat": "无火",
      "tip": "用手抓拌更容易让木耳裹匀。",
      "visual_cue": "木耳油润发亮，香菜点缀。"
    }
  ],
  "tips": [
    "木耳选朵小肉厚的秋耳，口感最脆。",
    "泡发时间别超过四小时，室温高时放冷藏泡。",
    "焯水时间足，木耳才没有生涩味。"
  ],
  "common_mistakes": [
    "木耳用热水快速泡发，外软内硬，口感差。",
    "焯水时间太短，木耳生涩，还可能有杂菌。"
  ],
  "substitutions": [
    {
      "original": "木耳",
      "substitute": "银耳",
      "ratio": "160g 对 150g",
      "note": "银耳版焯水一分钟即可，口感偏软。"
    }
  ],
  "variations": [
    "加一把炸花生米或腐竹同拌，层次更丰富。"
  ],
  "serving_suggestion": "装盘后冷藏十分钟，作下酒小菜。",
  "storage": "冷藏不超过一天，木耳久放易变质。",
