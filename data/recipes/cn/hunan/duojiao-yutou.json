        {
          "name": "剁椒",
          "name_en": "Hunan chopped pickled chili",
          "amount": 120,
          "unit": "g",
          "note": "沥去多余盐水，略剁碎",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 15,
          "unit": "g",
          "note": "一半切片垫底，一半切末",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 20,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 30,
          "unit": "g",
          "note": "切葱花，最后泼油用",
          "optional": false
        },
        {
          "name": "豆豉",
          "name_en": "fermented black beans",
          "amount": 10,
          "unit": "g",
          "note": "略剁碎，增发酵香",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "料酒",
          "name_en": "cooking wine",
          "amount": 20,
          "unit": "ml",
          "note": "10 毫升抹鱼去腥，余下炒剁椒",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 15,
          "unit": "ml",
          "note": "给剁椒打底味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 3,
          "unit": "g",
          "note": "和味，压住剁椒的尖咸",
          "optional": false
        },
        {
          "name": "菜籽油",
          "name_en": "rapeseed oil",
          "amount": 60,
          "unit": "ml",
          "note": "炒剁椒 40，泼葱 20",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
