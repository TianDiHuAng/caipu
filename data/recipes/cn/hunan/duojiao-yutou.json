      "items": [
        {
          "name": "鳙鱼",
          "name_en": "bighead carp",
          "amount": 1000,
          "unit": "g",
          "note": "选 1 公斤左右的鱼头，去鳃后从下颌剖开摊平，背部相连",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
