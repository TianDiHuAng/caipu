  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "红辣椒",
          "name_en": "red chili",
          "amount": 1000,
          "unit": "g",
          "note": "选肉厚的朝天椒",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 40,
          "unit": "g",
          "note": "占辣椒重量 8%",
          "optional": false
        },
        {
          "name": "白酒",
          "name_en": "baijiu",
          "amount": 30,
          "unit": "ml",
          "note": "50 度以上",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 60,
          "unit": "g",
          "note": "切末可选",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "大盆",
    "密封罐",
    "菜刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红辣椒洗净后摊开阴干 4 小时，直到表面完全无水，去掉蒂部。",
      "time_min": 240,
      "heat": "无火",
      "tip": "全程不能有生水，否则一整罐都会坏。",
      "visual_cue": "辣椒表皮干爽、蒂部无水珠"
    },
    {
      "n": 2,
      "text": "去蒂辣椒放在无水砧板上剁成 0.5cm 的粗碎，边剁边翻堆保持颗粒均匀。",
      "time_min": 20,
      "heat": "无火",
      "tip": "戴一次性手套操作，辣油会灼手。",
      "visual_cue": "辣椒碎大小均匀、能见到碎籽"
    },
    {
      "n": 3,
      "text": "剁好的辣椒放入大盆，加 80g 盐与 60g 蒜末，用手充分翻拌至出汁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐量按重量 8% 算，少了会发霉。",
      "visual_cue": "辣椒出水变软、盆底积红汁"
    },
    {
      "n": 4,
      "text": "拌好的辣椒装入无油无水的玻璃罐，边装边压实排出空气，装至八分满。",
      "time_min": 6,
      "heat": "无火",
      "tip": "压实能减少空气，发酵更均匀。",
      "visual_cue": "罐中无气泡、辣椒表面平整"
    },
    {
      "n": 5,
      "text": "表面淋 30ml 白酒封口，盖紧密封，置于阴凉处发酵 7 天即可取用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "白酒能抑菌并增香，不能省。",
      "visual_cue": "酒液浮于表面、罐盖无鼓胀"
    }
  ],
  "tips": [
    "选用肉质厚的朝天椒，剁出来才有脆度。",
    "盐按 8% 比例放足，太淡极易长白霉。",
    "取用时用干净无水的筷子，能存半年不坏。"
  ],
  "common_mistakes": [
    "辣椒带水下罐，几天后表面长出一层白霉。",
    "盐量不足，发酵时产生异味整罐报废。",
    "罐口没密封好，氧化后颜色发暗发黑。"
  ],
  "substitutions": [
    {
      "original": "红辣椒",
      "substitute": "小米辣",
      "ratio": "1000g 对 800g",
      "note": "小米辣更辣，用量减两成。"
    },
    {
      "original": "白酒",
      "substitute": "米酒",
      "ratio": "30ml 对 40ml",
      "note": "酒精度低，需冷藏保存。"
    }
  ],
  "variations": [
    "蒜香版：蒜末加到 120g，香气更冲。",
    "豆豉版：拌入 100g 豆豉同腌，风味更厚。"
  ],
  "serving_suggestion": "作为蘸碟或拌菜调料，蒸鱼、炒肉时加一勺最提味。",
  "storage": "密封冷藏可存 6 个月，取用需用干燥勺子。",
