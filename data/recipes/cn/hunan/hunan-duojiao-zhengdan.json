  "equipment": [
    "蒸锅",
    "碗",
    "筛网",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋打进大碗，加盐后用筷子顺一个方向打散。",
      "time_min": 5,
      "heat": "无火",
      "tip": "打到蛋白蛋黄完全融合，蛋液才细腻无筋。",
      "visual_cue": "蛋液均匀，不见蛋白团"
    },
    {
      "n": 2,
      "text": "兑入清水搅匀，用细筛网过滤两遍去掉表面泡沫。",
      "time_min": 5,
      "heat": "无火",
      "tip": "过筛去泡是蛋面光滑的关键，别省这步。",
      "visual_cue": "蛋液顺滑，表面无泡"
    },
    {
      "n": 3,
      "text": "蛋液倒进浅碗里，蒙上保鲜膜并用牙签扎几个小孔。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒙膜防水汽滴落，蛋面才平整不起坑。",
      "visual_cue": "膜面绷紧，气孔均匀"
    },
    {
      "n": 4,
      "text": "蒸锅水开后放进去，中小火蒸十二分钟至凝固。",
      "time_min": 13,
      "heat": "中小火",
      "tip": "火太大蛋液会起蜂窝，中小火才嫩滑。",
      "visual_cue": "蛋面平如镜，轻晃不流动"
    },
    {
      "n": 5,
      "text": "取出后撕掉保鲜膜，铺上剁辣椒淋生抽和植物油。",
      "time_min": 3,
      "heat": "无火",
      "tip": "剁辣椒铺匀但别压，红亮铺面才好看。",
      "visual_cue": "剁辣椒铺面，色泽鲜亮"
    },
    {
      "n": 6,
      "text": "撒上小葱碎，趁热端上桌拌开来吃更香更鲜。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌的时候从底部翻起，剁椒味才匀。",
      "visual_cue": "葱碎翠绿，蛋羹嫩滑"
    }
  ],
  "tips": [
    "蛋液和水的比例一比一，蒸出来最嫩。",
    "过筛去泡沫，蛋面才像镜面一样平。",
    "蒸时蒙膜或盖盘，水汽不滴落不起坑。"
  ],
  "common_mistakes": [
    "蛋液不加水直接蒸，成品硬得像蛋饼。",
    "大火猛蒸，蛋羹起满蜂窝又老又粗。",
    "不蒙保鲜膜，水汽滴落砸出一脸麻坑。"
  ],
  "substitutions": [
    {
      "original": "剁辣椒",
      "substitute": "辣椒酱",
      "ratio": "40 克:40 克",
      "note": "辣度更柔和，盐减一克。"
    },
    {
      "original": "鸡蛋",
      "substitute": "豆腐",
      "ratio": "300 克:400 克",
      "note": "做成剁椒蒸豆腐，蒸制时间延长五分钟。"
    }
  ],
  "variations": [
    "蛋液里加两勺鸡汤，鲜味更足更润口。",
    "表面铺几片腊肉同蒸，香气更浓。"
  ],
  "serving_suggestion": "趁热端锅上桌，配白饭吃最能压住辣。",
  "storage": "冷藏一天，复蒸五分钟回温，勿久放。",
