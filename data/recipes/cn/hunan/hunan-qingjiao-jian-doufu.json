  "equipment": [
    "平底锅",
    "炒锅",
    "锅铲",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成一厘米厚的大片，再斜刀切成三角形块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "三角块受热面积大，煎出来更香也好看。",
      "visual_cue": "豆腐片厚度一致，三角规整"
    },
    {
      "n": 2,
      "text": "豆腐块撒一层薄盐腌五分钟，再用厨房纸吸干水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先腌再吸干，煎时不粘锅还更入味。，这一步别偷懒。",
      "visual_cue": "豆腐表面微湿润，盐粒已溶"
    },
    {
      "n": 3,
      "text": "青椒去蒂去籽，斜刀切成两厘米长的段备用。，中间别急着翻动。",
      "time_min": 4,
      "heat": "无火",
      "tip": "斜切断面大，炒的时候更容易出香。，火候最关键。",
      "visual_cue": "青椒段断面宽大，籽已去净"
    },
    {
      "n": 4,
      "text": "平底锅放菜籽油烧热，豆腐块平铺下锅中火煎。",
      "time_min": 2,
      "heat": "中火",
      "tip": "一块块分开摆，粘在一起翻面就碎了。",
      "visual_cue": "豆腐块贴实锅面，油微微冒烟"
    },
    {
      "n": 5,
      "text": "煎五分钟到一面金黄结壳，翻面把另一面也煎黄。",
      "time_min": 10,
      "heat": "中火",
      "tip": "定型再翻，用铲子贴着锅底推才不破。",
      "visual_cue": "两面金黄微焦，边缘鼓起"
    },
    {
      "n": 6,
      "text": "煎好的豆腐盛出，锅里补油下干辣椒与蒜末炒香。",
      "time_min": 2,
      "heat": "中火",
      "tip": "辣椒别炒黑，一黑整锅油都发苦。，时间要卡准些。",
      "visual_cue": "辣椒暗红，蒜末微黄出香"
    },
    {
      "n": 7,
      "text": "下青椒段大火翻炒两分钟，炒到皮起皱断生。，保持锅里有底油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "炒到青椒皮微皱，那股虎皮香才出来。",
      "visual_cue": "青椒皮起皱发白，边缘略软"
    },
    {
      "n": 8,
      "text": "倒回豆腐块，加生抽与盐轻推翻匀入味。，手法稳一些更好。",
      "time_min": 2,
      "heat": "大火",
      "tip": "轻推别猛翻，豆腐块才保持完整。，顺序不能颠倒。",
      "visual_cue": "豆腐裹上酱色，青椒翠中带焦"
    },
    {
      "n": 9,
      "text": "撒葱段翻两下立刻出锅，趁热装盘上桌最好吃。",
      "time_min": 1,
      "heat": "大火",
      "tip": "葱花最后放，香味才鲜不糊。，量别放多。",
      "visual_cue": "豆腐金黄，青椒虎皮，葱花点缀"
    }
  ],
  "tips": [
    "豆腐一定要北豆腐，嫩豆腐煎不成形。",
    "煎之前撒盐腌一下，入味也防粘。",
    "青椒选薄皮的，容易炒出虎皮香。",
    "锅不够热就别下豆腐，粘锅就前功尽弃。"
  ],
  "common_mistakes": [
    "豆腐表面带水下锅，油花四溅还粘锅。",
    "青椒炒得太久，皮塌肉烂没有香味。，整锅味道都跟着毁了。",
    "急着翻面，豆腐全被铲碎在锅里。，口感差得很多。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "尖椒",
      "ratio": "150克:120克",
      "note": "辣度更高，可减少干辣椒用量。"
    },
    {
      "original": "豆腐",
      "substitute": "豆腐干",
      "ratio": "400克:250克",
      "note": "不用煎太久，两面各煎三分钟即可。"
    }
  ],
  "variations": [
    "加一勺豆豉同炒，豉香更浓。，换个花样不单调。",
    "淋一勺剁椒汁，做成酸辣版本。，口味层次更丰富。"
  ],
  "serving_suggestion": "装盘趁热吃，豆腐外焦里嫩，青椒带虎皮香，素菜也极下饭。",
  "storage": "冷藏两天，复热用平底锅小火两面各煎一分钟恢复脆壳。",
