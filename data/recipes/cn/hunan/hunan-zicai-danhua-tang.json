  ],
  "steps": [
    {
      "n": 1,
      "text": "紫菜撕成小片放进碗里，用清水快速冲一遍，去掉表面浮沙。",
      "time_min": 6,
      "heat": "无火",
      "tip": "紫菜只需快冲，泡久了会烂成糊还发苦。",
      "visual_cue": "紫菜舒展开，水里不见沙粒"
    },
    {
      "n": 2,
      "text": "鸡蛋磕进碗里打散，打到蛋液均匀不见成块的蛋白。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液打匀，倒进汤里才拉得出细蛋花。",
      "visual_cue": "蛋液颜色均匀，表面浮起小泡"
    },
    {
      "n": 3,
      "text": "汤锅倒清水大火烧开，下香菇丝煮三分钟让汤带上鲜味。",
      "time_min": 6,
      "heat": "大火",
      "tip": "香菇丝先煮出味，汤才鲜得有底子。",
      "visual_cue": "汤面微微翻花，闻到海味"
    },
    {
      "n": 4,
      "text": "加盐与白胡椒调味，用淀粉兑水勾一层薄芡，汤体略稠。",
      "time_min": 4,
      "heat": "中火",
      "tip": "勾薄芡蛋花才悬在汤里，不会全沉底。",
      "visual_cue": "汤体微微挂勺，颜色清亮"
    },
    {
      "n": 5,
      "text": "转小火，蛋液沿锅边细细淋入，静置十秒再用汤勺轻推。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蛋液淋进去别马上搅，等凝固才成蛋花。",
      "visual_cue": "蛋花成片浮起，丝缕分明"
    },
    {
      "n": 6,
      "text": "关火下紫菜，淋香油撒葱花，搅匀后盛进汤碗。",
      "time_min": 3,
      "heat": "无火",
      "tip": "紫菜关火后再放，久煮发苦颜色也发暗。",
      "visual_cue": "紫菜舒展，汤面浮着油花"
    }
  ],
  "tips": [
    "紫菜只用清水快冲，泡久了会烂还发苦。",
    "蛋液打匀再淋，蛋花才细不成块。",
    "先勾一层薄芡，蛋花才能悬在汤里。",
    "紫菜关火后放，颜色翠绿味道也清。"
  ],
  "common_mistakes": [
    "紫菜提前泡发，下锅立刻化成一团糊。",
    "蛋液倒进去就猛搅，最后成碎蛋渣。",
    "汤没有勾芡就直接倒蛋液，蛋花全部沉在锅底。",
    "紫菜大火煮五分钟，汤发黑还带苦味。"
  ],
  "substitutions": [
    {
      "original": "紫菜",
      "substitute": "裙带菜",
      "ratio": "15克:20克",
      "note": "口感更厚，需提前泡发五分钟。"
    }
  ],
  "variations": [
    "加半块嫩豆腐切小丁同煮，汤更有内容。",
    "滴几滴香醋，酸味让海味更清爽。",
    "换成番茄打底，酸甜口更适合夏天喝。"
  ],
  "serving_suggestion": "盛进汤碗撒葱花，饭前先喝一小碗，暖胃又开胃，配辣菜刚好解辣。",
  "storage": "当天喝完最好，冷藏不超过一天，复热后紫菜会变软，蛋花也易散。",
