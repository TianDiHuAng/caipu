  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐从盒里取出，切成两厘米厚的方片，整齐码进深盘里。",
      "time_min": 8,
      "heat": "无火",
      "tip": "用刀贴着盒边划一圈再倒，豆腐才不碎。",
      "visual_cue": "豆腐片完整不破，码放整齐"
    },
    {
      "n": 2,
      "text": "豆腐表面撒少许盐，静置十分钟让底部渗出的水倒掉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "先杀水，蒸的时候才不会稀释调味汁。",
      "visual_cue": "盘底积出一层浅水，豆腐略收紧"
    },
    {
      "n": 3,
      "text": "豆豉剁碎，与蒜末、小米椒圈、生抽和白糖拌成调味料。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆豉剁碎味道才散得开，整粒蒸不透。",
      "visual_cue": "调料混匀呈深褐色，椒圈分布均匀"
    },
    {
      "n": 4,
      "text": "把调味料均匀铺在豆腐片上，尽量盖住每一片表面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "铺匀了每片豆腐才都有味道，别堆在中间。",
      "visual_cue": "豆腐表面盖满深色酱料"
    },
    {
      "n": 5,
      "text": "淋上花生油，水开后上锅大火蒸八分钟至豆腐鼓起。",
      "time_min": 11,
      "heat": "大火",
      "tip": "蒸到豆腐表面鼓起小泡，说明里面已经热透。",
      "visual_cue": "豆腐边缘鼓起，酱料冒小泡"
    },
    {
      "n": 6,
      "text": "出锅撒葱花，趁热端上桌，配米饭用勺舀着吃。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花最后撒，热气一冲才有生香。",
      "visual_cue": "葱花翠绿，豆腐颤巍巍地晃动"
    }
  ],
  "tips": [
    "豆腐先撒盐杀水，蒸完调味不会被冲淡。",
    "豆豉一定剁碎，整粒蒸出来又硬又不入味。",
    "调料要铺匀每片豆腐，堆在中间会咸淡不均。",
    "蒸到豆腐表面鼓起小泡就已经热透，别蒸过头。"
  ],
  "common_mistakes": [
    "豆腐不杀水直接蒸，盘里一汪水，味道全散。",
    "豆豉整粒铺上去，吃到嘴里硬邦邦还有生豆味。",
    "小火慢蒸，豆腐外层老了里面还没热。",
    "蒸完久放不端上桌，豆腐回缩出水，酱料全沉底。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "内酯豆腐",
      "ratio": "600克:600克",
      "note": "更嫩，蒸的时间减两分钟。"
    },
    {
      "original": "豆豉",
      "substitute": "豆瓣酱",
      "ratio": "25克:20克",
      "note": "咸度更高，盐要减一克。"
    }
  ],
  "variations": [
    "豆腐下面垫一层泡软的粉丝，吸饱汤汁特别好吃。",
    "加一勺剁椒同蒸，颜色红亮，酸辣更开胃。",
    "出锅淋半勺热油激香，葱和椒的香气立刻窜出来。"
  ],
  "serving_suggestion": "连盘端上桌，撒葱花，用勺舀到米饭上，豆腐嫩滑带着豆豉的发酵香，很适合配粥。",
  "storage": "冷藏可放一天，复热上锅蒸五分钟，微波加热豆腐会出水变老。",
