          "note": "湘式发酵剁椒",
          "optional": false
        },
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 15,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 25,
          "unit": "ml",
          "note": "一半拌芋头一半泼面",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 2,
          "unit": "g",
          "note": "中和辣味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "剁椒有咸味，少量即可",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "深盘",
    "锡纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芋头去皮切 3cm 滚刀块，戴手套操作，切好后用清水冲去表面黏液。",
      "time_min": 10,
      "heat": "无火",
      "tip": "芋头黏液会让手发痒，务必戴手套或抹少许油。",
      "visual_cue": "芋头块大小均匀、表面不滑手"
    },
    {
      "n": 2,
      "text": "芋头块加 10ml 植物油、2g 盐与白糖拌匀，平铺在深盘中。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先拌油能让芋头蒸后更绵密不散。",
      "visual_cue": "每块芋头裹上薄油"
    },
    {
      "n": 3,
      "text": "剁椒与蒜末混合，加生抽拌匀后均匀铺在芋头上。",
      "time_min": 2,
      "heat": "无火",
      "tip": "剁椒铺薄薄一层即可，太厚会过咸。",
      "visual_cue": "剁椒覆盖均匀、露出部分芋头"
    },
    {
      "n": 4,
      "text": "水开后上锅大火蒸 20 分钟，至芋头用筷子能轻松插入。",
      "time_min": 22,
      "heat": "大火",
      "tip": "芋头必须蒸透，半熟会有麻口感。",
      "visual_cue": "筷子一插到底、芋头边缘微裂"
    },
    {
      "n": 5,
      "text": "取出撒葱花，把 15ml 植物油烧至冒烟泼在葱花上。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油要够热才能激出葱香，泼时离盘 20cm 高。",
      "visual_cue": "葱花瞬间变翠绿、香气冲起"
    }
  ],
  "tips": [
    "芋头选个头小的更粉糯，大芋头需延长蒸 5 分钟。",
    "蒸盘里的汤汁拌饭很香，别倒掉。",
    "剁椒咸度差异大，铺之前先尝一小口。"
  ],
  "common_mistakes": [
    "芋头没蒸透就出锅，吃起来发麻发涩。",
    "剁椒铺太厚不加油，蒸后干辣发苦。",
    "泼油温度不够，葱花香味激不出来。"
  ],
  "substitutions": [
    {
      "original": "芋头",
      "substitute": "南瓜",
      "ratio": "500g 芋头 ≈ 500g 南瓜",
      "note": "南瓜更易熟，蒸制时间减到 12 分钟。"
    },
    {
      "original": "剁椒",
      "substitute": "辣椒油",
      "ratio": "60g 剁椒 ≈ 40g 辣椒油 + 2g 盐",
      "note": "辣味更柔和，缺少发酵香气。"
    }
  ],
  "variations": [
    "家庭简化版：芋头切片缩短蒸制到 12 分钟，更易入味。",
    "肉末版：芋头上铺 100g 猪肉末同蒸，做成剁椒芋头蒸肉。"
  ],
  "serving_suggestion": "配米饭，汤汁拌饭；湘菜馆常作为蒸菜拼盘的一员。",
  "storage": "冷藏 2 天，复蒸 8 分钟；不建议冷冻，芋头解冻后口感发渣。",
