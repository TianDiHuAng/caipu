    "锅铲",
    "饭碗",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜冷饭用手抓散，把结块的饭团一点点捏开备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "饭抓散了炒出来才粒粒分明不粘连。，火候最关键。",
      "visual_cue": "米饭粒粒分开，盆底无结块"
    },
    {
      "n": 2,
      "text": "豆豉用刀略剁碎，青椒与小葱分别切丁切花备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "豆豉剁碎一点，香气散得开也不硌牙。",
      "visual_cue": "豆豉碎粒均匀，青椒丁大小一致"
    },
    {
      "n": 3,
      "text": "鸡蛋打进碗里加一小撮盐打散，打到起细泡为止。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液打得起泡，炒出来才蓬松柔软。，时间要卡准些。",
      "visual_cue": "蛋液均匀，表面浮着气泡"
    },
    {
      "n": 4,
      "text": "炒锅放一半菜籽油烧热，倒蛋液划炒成碎蛋块盛出。",
      "time_min": 2,
      "heat": "中火",
      "tip": "边倒边划散，蛋块才会又小又匀。，顺序不能颠倒。",
      "visual_cue": "蛋块细碎金黄，不结大团"
    },
    {
      "n": 5,
      "text": "锅里补油，下豆豉碎小火炒出浓郁的豉香。，保持锅里有底油。",
      "time_min": 2,
      "heat": "小火",
      "tip": "豆豉最怕大火，一炒糊就整锅发苦。，量别放多。",
      "visual_cue": "豆豉粒油亮，香气冲鼻"
    },
    {
      "n": 6,
      "text": "下青椒丁转大火炒半分钟，炒到断生带一点脆。",
      "time_min": 1,
      "heat": "大火",
      "tip": "青椒断生就好，炒久了出水发黄。，这一步别偷懒。",
      "visual_cue": "青椒丁色泽深绿，仍挺立"
    },
    {
      "n": 7,
      "text": "倒入米饭大火翻炒三分钟，边压边炒到饭粒干爽。",
      "time_min": 3,
      "heat": "大火",
      "tip": "用铲子压散再翻，饭粒才会颗颗裹油。",
      "visual_cue": "饭粒跳动有声，颗颗分明"
    },
    {
      "n": 8,
      "text": "倒回蛋块，加生抽、白糖与盐翻匀，撒葱花出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆豉很咸，盐一定要尝过再决定放多少。",
      "visual_cue": "饭色酱褐油亮，葱花点缀翠绿"
    }
  ],
  "tips": [
    "豆豉选湖南本地的干豆豉，香味更冲。",
    "加半勺剁椒同炒，辣香更有湘味。",
    "隔夜饭炒最好，新饭水分多容易黏。",
    "炒饭的油要稍多一点，太干不好吃。"
  ],
  "common_mistakes": [
    "豆豉大火炒糊，整锅饭带一股苦味。，整锅味道都跟着毁了。",
    "饭没抓散就下锅，一坨坨炒不匀。，口感差得很多。",
    "盐按常规量放，豆豉一咸整碗都下不了口。"
  ],
  "substitutions": [
    {
      "original": "豆豉",
      "substitute": "豆瓣酱",
      "ratio": "30克:25克",
      "note": "酱香更浓带辣，盐可少放。"
    },
    {
      "original": "米饭",
      "substitute": "小米饭",
      "ratio": "400克:350克",
      "note": "颗粒更细，炒的时候动作轻些。"
    }
  ],
  "variations": [
    "加一把腊肉丁同炒，荤香更足。，换个花样不单调。",
    "放几根豆角丁同炒，口感更丰富。，口味层次更丰富。"
  ],
  "serving_suggestion": "趁热装碗，豉香浓郁饭粒油亮，配一碗清汤正好。",
  "storage": "冷藏一天，复热用大火快炒一分钟恢复干香。",
