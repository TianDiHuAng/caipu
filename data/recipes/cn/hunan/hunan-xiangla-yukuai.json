  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗",
    "盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草鱼刮净鱼鳞去掉腹内黑膜，取中段切成三厘米见方的块，用盐与米酒抓匀腌十分钟。",
      "time_min": 14,
      "heat": "无火",
      "tip": "鱼块大小要切得一致，下锅后才同时熟透。",
      "visual_cue": "鱼块表面干爽，刀口白净无血水"
    },
    {
      "n": 2,
      "text": "腌好的鱼块用厨房纸吸干水分，逐块拍上一层薄薄的淀粉。",
      "time_min": 8,
      "heat": "无火",
      "tip": "薄薄一层就够，拍多了淀粉吸水发黏，下锅就掉粉。",
      "visual_cue": "鱼块表面挂上均匀白霜"
    },
    {
      "n": 3,
      "text": "炒锅倒菜籽油烧到微微冒烟，鱼块皮朝下摆入，中火煎到两面定形微黄后盛出。",
      "time_min": 9,
      "heat": "中火",
      "tip": "下锅别急着动，等底面结壳再翻，鱼皮才不会破。",
      "visual_cue": "两面结壳金黄，鱼皮完整"
    },
    {
      "n": 4,
      "text": "原锅留底油，下姜末、蒜末与剁碎的豆豉小火炒香，再放小米椒圈炒出辣味。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆豉要炒散出酱香，辣椒后放才不发苦。",
      "visual_cue": "锅中飘起酱香与辣气，油色转红"
    },
    {
      "n": 5,
      "text": "烹入米酒与生抽，加小半碗清水烧开，倒回鱼块转小火焖六分钟收味。",
      "time_min": 7,
      "heat": "小火",
      "tip": "焖时只推锅不翻动，用勺背把汤汁浇在鱼块上。",
      "visual_cue": "汤汁过半没鱼块，颜色深红发亮"
    },
    {
      "n": 6,
      "text": "下青椒块大火收一分钟，撒紫苏丝与葱段，再撒少许白胡椒，汤汁浓亮立即起锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "紫苏下锅就起，久炒香味全跑，只剩一股草气。",
      "visual_cue": "汤汁浓稠挂勺，青椒翠绿"
    }
  ],
  "tips": [
    "草鱼刺多，可在切块时先片去大刺，老人小孩更好入口。",
    "没有紫苏可换成薄荷嫩叶，湘西一带也这样吃。",
    "菜籽油要烧到冒烟再下料，否则有一股生油味。"
  ],
  "common_mistakes": [
    "鱼块不吸干就下锅，油花四溅还粘得满锅都是。",
    "全程大火猛翻，鱼块碎成鱼茸，卖相全无。",
    "小米椒和豆豉一起爆，辣椒糊了发苦，辣味也不香。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲈鱼",
      "ratio": "700克:600克",
      "note": "鲈鱼刺少，焖的时间减两分钟。"
    },
    {
      "original": "菜籽油",
      "substitute": "花生油",
      "ratio": "60毫升:60毫升",
      "note": "花生油更香，但少了那股湘味的厚重。"
    }
  ],
  "variations": [
    "把小米椒换成剁椒同烧，酸辣更冲，是湘南的做法。",
    "加一把泡软的干粉皮同烧，吸饱汤汁比鱼还抢口。"
  ],
  "serving_suggestion": "配白饭最下口，鱼块吃完剩下的汤汁拌饭一绝。",
  "storage": "冷藏可存一天，淡水鱼不宜久放，复热须小火加少许水焖透。",
