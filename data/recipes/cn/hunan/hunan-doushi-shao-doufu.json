  "equipment": [
    "炒锅",
    "锅铲",
    "漏勺",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成两厘米厚的方块，用厨房纸把表面水分吸干。",
      "time_min": 6,
      "heat": "无火",
      "tip": "表面干爽才煎得金黄，带水下锅准溅油。",
      "visual_cue": "豆腐块表面不见水光，纸已湿"
    },
    {
      "n": 2,
      "text": "豆豉用刀略剁碎，大蒜切末，青椒切成菱形薄片。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆豉剁碎香气才散得开，也不硌牙。，这一步别偷懒。",
      "visual_cue": "豆豉碎粒均匀，青椒片规整"
    },
    {
      "n": 3,
      "text": "炒锅放菜籽油烧热，豆腐块平铺下锅中火煎制。",
      "time_min": 2,
      "heat": "中火",
      "tip": "一块块分开摆，粘在一起翻面会碎。，火候最关键。",
      "visual_cue": "豆腐块贴实锅面，油轻微冒烟"
    },
    {
      "n": 4,
      "text": "煎四分钟到一面金黄结壳，再翻面把另一面煎黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "没定型别急着翻，等它自己脱锅才完整。",
      "visual_cue": "两面金黄，边缘微微鼓起"
    },
    {
      "n": 5,
      "text": "豆腐盛出，锅里留底油下豆豉与蒜末小火炒香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "豆豉怕大火，一炒糊整锅都带苦味。，时间要卡准些。",
      "visual_cue": "豆豉粒油亮，蒜末微黄出香"
    },
    {
      "n": 6,
      "text": "加生抽、老抽、白糖与半碗清水烧开，放回豆腐。",
      "time_min": 2,
      "heat": "大火",
      "tip": "水别太多，收汁要收得浓才挂得住。，顺序不能颠倒。",
      "visual_cue": "汤汁滚起呈深酱色，豆腐浮起"
    },
    {
      "n": 7,
      "text": "转中小火烧六分钟，让豆腐把豉香汤汁吸进去。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "用勺背轻推，别用铲子翻，豆腐才不破。",
      "visual_cue": "汤汁收到一半，豆腐膨大油亮"
    },
    {
      "n": 8,
      "text": "下青椒片烧一分钟，淋水淀粉勾芡到浓稠挂勺。",
      "time_min": 2,
      "heat": "中火",
      "tip": "青椒最后下，脆一点才解豆豉的咸。，量别放多。",
      "visual_cue": "汤汁浓稠裹住豆腐，青椒翠绿"
    },
    {
      "n": 9,
      "text": "加盐调味，撒葱段翻匀后起锅装盘上桌。，注意观察火候。",
      "time_min": 1,
      "heat": "中火",
      "tip": "豆豉本身很咸，盐要尝过再决定是否加。",
      "visual_cue": "豆腐酱亮，青椒葱花点缀"
    }
  ],
  "tips": [
    "豆腐选北豆腐，煎的时候不容易散。",
    "豆豉选干爽的本地豆豉，香气最冲。",
    "煎豆腐时撒一层薄盐，入味也不粘锅。",
    "加一勺剁椒同烧，辣香更足。，口感会更好一些。"
  ],
  "common_mistakes": [
    "豆腐带水下锅，油花四溅还粘得一塌糊涂。",
    "豆豉大火炒糊，整盘都是苦味。，白忙一场很可惜。",
    "汤汁没收浓就出锅，豆腐淡而无味。，做出来完全变样。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "豆腐干",
      "ratio": "400克:250克",
      "note": "切薄片烧，时间减两分钟。"
    },
    {
      "original": "豆豉",
      "substitute": "豆瓣酱",
      "ratio": "25克:20克",
      "note": "带辣，盐可完全不放。"
    }
  ],
  "variations": [
    "加几片五花肉同烧，荤香渗进豆腐里。",
    "放一把蒜苗同烧，辛香更足。，家里人会更爱吃。"
  ],
  "serving_suggestion": "连汁装盘，豆腐外香里嫩，豉香咸鲜，配白饭最下口。",
  "storage": "冷藏两天，复热加两勺水小火焖三分钟恢复软嫩。",
