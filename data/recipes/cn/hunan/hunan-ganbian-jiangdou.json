  "steps": [
    {
      "n": 1,
      "text": "豇豆掐去两头，掰成五厘米长段洗净晾干。这一步别着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "表面水要晾干，下锅才不溅油。，注意火候。",
      "visual_cue": "豆段干爽，颜色翠绿，状态稳定"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧到五成热，下豇豆中火煸。这一步别着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温别太高，慢慢煸出虎皮。，注意火候。",
      "visual_cue": "豆面起皱，颜色转深，状态稳定"
    },
    {
      "n": 3,
      "text": "煸六分钟到豆皮起皱发软，捞出控油。这一步别着急。",
      "time_min": 7,
      "heat": "中火",
      "tip": "煸透了才不涩，也更入味。，注意火候。",
      "visual_cue": "豆段软塌，表皮起泡，状态稳定"
    },
    {
      "n": 4,
      "text": "倒出多余油，留底油下五花肉小丁炒散。这一步别着急。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉丁炒到出油，香味才够。，注意火候。",
      "visual_cue": "肉丁酥香，油色发亮，状态稳定"
    },
    {
      "n": 5,
      "text": "放干辣椒段和蒜末，小火炒出辣香。这一步别着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末别炒黄，会发苦。，注意火候。",
      "visual_cue": "辣香冲鼻，蒜末雪白，状态稳定"
    },
    {
      "n": 6,
      "text": "倒回豇豆，转大火翻炒一分钟。这一步别着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "大火快炒，豆段才不吸水变软。，注意火候。",
      "visual_cue": "豆段干香，锅气足，状态稳定"
    },
    {
      "n": 7,
      "text": "加生抽、盐和白糖翻匀，炒到汁水收干。这一步别着急。",
      "time_min": 4,
      "heat": "大火",
      "tip": "糖只提鲜，别吃出甜味。，注意火候。",
      "visual_cue": "豆面油亮，无汤汁，状态稳定"
    }
  ],
  "tips": [
    "豇豆要煸到起虎皮，口感才不涩。，值得留意。",
    "表面晾干再下锅，避免溅油。，值得留意。",
    "最后大火收干，才有干香。，值得留意。"
  ],
  "common_mistakes": [
    "豇豆没煸透，吃着生涩发硬。，值得留意。",
    "火太小，豆段吸油变软塌。，值得留意。",
    "蒜末炒糊，整盘带苦味。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "豇豆",
      "substitute": "四季豆",
      "ratio": "450 克:450 克",
      "note": "更粗，煸的时间加两分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "100 克:80 克",
      "note": "咸香更足，盐要减半。"
    }
  ],
  "variations": [
    "加一把干虾米，鲜味更足。，值得留意。",
    "放一勺豆豉，做成豉香版。，值得留意。"
  ],
  "serving_suggestion": "配白米饭，最下饭的一道。，效果更稳定。",
  "storage": "冷藏一天，复热下锅干炒两分钟。，效果更稳定。",
