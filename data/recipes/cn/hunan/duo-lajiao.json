        {
          "name": "红辣椒",
          "name_en": "red chili",
          "amount": 1000,
          "unit": "g",
          "note": "小米椒或二荆条",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 40,
          "unit": "g",
          "note": "去皮切末",
          "optional": false
        },
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 30,
          "unit": "g",
          "note": "切末",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 55,
          "unit": "g",
          "note": "约占辣椒重量 5%",
          "optional": false
        },
        {
          "name": "白酒",
          "name_en": "baijiu",
          "amount": 30,
          "unit": "ml",
          "note": "50 度以上",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "竹匾",
    "干净菜刀",
    "玻璃坛",
    "一次性手套"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红辣椒洗净后摊在竹匾上晾干表面水分，摘去绿色蒂头。",
      "time_min": 15,
      "heat": "无火",
      "tip": "带生水下坛最容易生白花变质。",
      "visual_cue": "辣椒表面干爽、无水滴"
    },
    {
      "n": 2,
      "text": "红辣椒放在无油无水的砧板上剁成 0.5cm 粗粒，姜蒜切末。",
      "time_min": 10,
      "heat": "无火",
      "tip": "戴手套操作，辣手会留很久。",
      "visual_cue": "辣椒粒粗细均匀、不流汁"
    },
    {
      "n": 3,
      "text": "辣椒粒加盐与姜蒜末拌匀，倒入白酒再翻拌两遍。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐要按比例放足，少了容易坏。",
      "visual_cue": "辣椒出汁、盐粒化开"
    },
    {
      "n": 4,
      "text": "拌好的辣椒装入干净玻璃坛，边装边压实排出空气。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压实能减少气泡，发酵更均匀。",
      "visual_cue": "坛口留 2cm 空隙、表面平整"
    },
    {
      "n": 5,
      "text": "坛口盖盖密封，放在阴凉处静置发酵 7 天后食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "前三天每天开盖放一次气。",
      "visual_cue": "坛内起小泡、酸香渐浓"
    }
  ],
  "tips": [
    "所有器具必须无油无水，否则容易长霉。",
    "盐按辣椒重量 5% 放，太少会酸败。",
    "发酵前三天每天放气，坛内压力才不顶盖。"
  ],
  "common_mistakes": [
    "辣椒没晾干就剁，坛里很快起白花。",
    "盐放过少，辣椒发酸发臭不能吃。",
    "坛子用开水烫完立刻装辣椒，水汽结了霉。"
  ],
  "substitutions": [
    {
      "original": "红辣椒",
      "substitute": "朝天椒",
      "ratio": "1000g 对 1000g",
      "note": "辣度明显更高，用量减半更稳妥。"
    },
    {
      "original": "白酒",
      "substitute": "高度粮食酒",
      "ratio": "30ml 对 30ml",
      "note": "度数以 50 度以上为宜。"
    }
  ],
  "variations": [
    "蒜香版：大蒜加到 100g，蒜味更冲。",
    "豆豉版：拌入 100g 豆豉，蒸鱼更香。"
  ],
  "serving_suggestion": "取一勺拌饭、蒸鱼头或炒腊肉，酸辣开胃。",
  "storage": "密封冷藏可存半年，取用须用干净无水的勺子。",
