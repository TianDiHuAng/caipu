    "汤锅",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干粉丝用温水泡二十分钟，泡到能弯折却还带韧劲，捞出沥干剪成两段。",
      "time_min": 20,
      "heat": "无火",
      "tip": "粉丝剪短些好夹，太长一筷子挑起来能拖到桌上。",
      "visual_cue": "粉丝发白变软，根根分明不粘连"
    },
    {
      "n": 2,
      "text": "五花肉切成黄豆大小的碎粒，蒜和姜切末，小葱和香菜分别切段备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "肉粒切小一点，煸出来散在粉丝里，每一口都有肉。",
      "visual_cue": "肉粒大小匀称，配料切得齐整"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧热，下五花肉粒中火煸三分钟，煸到肉粒出油边缘微黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉粒煸到干香出油，粉丝才不粘锅也不油腻。",
      "visual_cue": "肉粒焦黄，锅底浮着一层油"
    },
    {
      "n": 4,
      "text": "加姜末、蒜末和干辣椒段小火炒半分钟，炒出辣椒的呛香和蒜香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "干辣椒小火炒，火大立刻焦黑发苦，这一步千万别省。",
      "visual_cue": "辣椒转深红，香气呛鼻，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "倒入粉丝转中火翻炒两分钟，边炒边淋生抽和细砂糖，让粉丝均匀上色。",
      "time_min": 3,
      "heat": "中火",
      "tip": "粉丝下锅要用筷子配合挑散，铲子压会粘成块。",
      "visual_cue": "粉丝深褐油亮，不再结团，状态和火候都看得清"
    },
    {
      "n": 6,
      "text": "沿锅边淋香醋和辣椒油，撒盐翻匀，关火后放小葱和香菜段拌匀出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "醋要离火前淋，酸味才保留得住，提前把配料备好再动手更稳。",
      "visual_cue": "酸香冲鼻，粉丝根根带汁，颜色和形态变化明显"
    }
  ],
  "tips": [
    "粉丝用温水泡软就好，泡到能弯折但还有韧劲，太软煮一下就烂了。",
    "最后淋醋要在关火前后加，高温久煮酸味会挥发，酸得不够透。",
    "五花肉切小粒先煸出油，粉丝吸的是肉油的香，比单纯用植物油香得多。"
  ],
  "common_mistakes": [
    "粉丝用开水泡了半小时，一炒就断成一截截的碎条，根本夹不起来。",
    "醋早早倒进锅里煮，酸味跑了大半，成品只有辣没有酸，味道发闷。",
    "一次下全部粉丝不停翻炒，锅底粘成一块，翻的时候整坨被带起。"
  ],
  "substitutions": [
    {
      "original": "粉丝",
      "substitute": "米粉",
      "ratio": "150克:150克",
      "note": "米粉更耐煮，泡的时间要延长五分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "榨菜",
      "ratio": "100克:60克",
      "note": "素食版可省生抽，咸味来自榨菜本身。"
    }
  ],
  "variations": [
    "加一把泡软的黄花菜同炒，湖南家常的酸辣粉丝常这么配。",
    "把香醋换成陈醋，酸香更厚重，适合喜欢老陈醋酸味的人。"
  ],
  "serving_suggestion": "装碗趁热吃，撒一把香菜，酸辣带汤汁，配一碗紫菜汤就是完整一餐。",
  "storage": "冷藏可放一天，回热用炒锅加两勺清水翻匀，不要微波否则粉丝发硬。",
