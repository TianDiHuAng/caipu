  "equipment": [
    "炒锅",
    "漏勺",
    "刀",
    "砧板",
    "碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉去皮切成小块，用刀剁成粗粒，剁到能抱团又不发黏。",
      "time_min": 12,
      "heat": "无火",
      "tip": "手工剁的保留颗粒感，机器打太细会发柴。",
      "visual_cue": "肉粒均匀，抓一把略带黏性"
    },
    {
      "n": 2,
      "text": "肉粒里加小葱末、姜末、盐、生抽、料酒和白胡椒，顺一个方向搅上劲。",
      "time_min": 6,
      "heat": "无火",
      "tip": "顺一个方向搅，肉糜才抱团，反着搅会出水。",
      "visual_cue": "肉糜发黏，挑起来能整团挂住"
    },
    {
      "n": 3,
      "text": "莲藕削皮切成半厘米厚的夹刀片，第一刀不断第二刀切断。",
      "time_min": 10,
      "heat": "无火",
      "tip": "片要薄而匀，太厚夹生，太薄一填就断。",
      "visual_cue": "藕夹张开，形似翻开的书页"
    },
    {
      "n": 4,
      "text": "把肉糜填进藕夹，抹平两面，轻压让馅料和藕片贴紧。",
      "time_min": 8,
      "heat": "无火",
      "tip": "馅别塞太满，炸的时候受热会顶开藕片。",
      "visual_cue": "藕夹饱满，边缘齐整不露馅"
    },
    {
      "n": 5,
      "text": "面粉加鸡蛋和清水调成糊，搅到能挂住筷子缓缓滴落。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糊太稠外壳厚，太稀挂不住藕片会掉渣。",
      "visual_cue": "面糊顺滑，看不见干粉疙瘩"
    },
    {
      "n": 6,
      "text": "炒锅倒植物油烧到六成热，藕夹逐个裹上面糊下锅。",
      "time_min": 6,
      "heat": "中火",
      "tip": "下锅前抖掉多余面糊，免得锅里结成硬块。",
      "visual_cue": "油面翻花，藕夹浮起慢慢打转"
    },
    {
      "n": 7,
      "text": "中火炸四分钟，炸到外壳定型发浅黄，用漏勺捞出。",
      "time_min": 6,
      "heat": "中火",
      "tip": "第一遍只求定型，颜色浅黄就捞，别求上色。",
      "visual_cue": "外壳浅黄，形状挺立不发塌"
    },
    {
      "n": 8,
      "text": "油温升到八成热，把藕夹回锅复炸一分钟逼出油分。",
      "time_min": 4,
      "heat": "大火",
      "tip": "复炸要用大火快炸，久炸肉糜会老、藕片发软。",
      "visual_cue": "外壳金黄，敲一下有脆响声"
    },
    {
      "n": 9,
      "text": "捞出沥油，趁热撒盐和一小撮白胡椒，摆盘上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热撒盐才挂得住，凉了盐粒全掉在盘底。",
      "visual_cue": "表面干爽，看不见浮油渗出"
    }
  ],
  "tips": [
    "藕片切好泡在清水里，加几滴白醋，防氧化发黑，也让藕片更脆。",
    "面糊里加鸡蛋能增加酥感，但别加太多，面糊太稠外壳会又厚又硬。",
    "复炸这一步不能省，第一次炸只定型，第二次大火一逼，外壳才真正酥脆不回软。",
    "炸好的藕盒立着放而不是平摊，底部不闷油，放十分钟外壳还是脆的。"
  ],
  "common_mistakes": [
    "肉糜塞得太满，下锅受热顶开藕片，肉糜散在油里。填七八分满就够。",
    "只炸一遍就上桌，外壳软塌吸油。要二次复炸才能酥。",
    "藕片切太薄，夹刀处一填就断。要切成半厘米厚再夹馅。",
    "油温只有三四成热就下锅，藕盒吸满油。要烧到六成热再下。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "鸡腿肉",
      "ratio": "300克:300克",
      "note": "脂肪少更清爽，需多加五毫升油防柴。"
    },
    {
      "original": "面粉",
      "substitute": "红薯淀粉",
      "ratio": "100克:90克",
      "note": "外壳更薄更脆，凉了也不易回软。"
    }
  ],
  "variations": [
    "在肉糜里加一勺剁椒，辣味渗进藕孔，是湘味更足的做法。",
    "把莲藕换成茄子夹肉，做成炸茄盒，质地更软，适合配番茄酱。",
    "面糊里加一勺白芝麻，炸出来外壳带芝麻香，颜色也更好看。"
  ],
  "serving_suggestion": "竹篮垫上吸油纸，藕盒金黄堆叠，咬开能看到藕孔里塞满肉馅，热气带着肉香扑出来。外皮咔嚓作响，藕片脆、肉馅嫩，一脆一软很过瘾。",
  "storage": "冷藏可放两天，复热用空气炸锅一百八十度烤五分钟，或回锅复炸三十秒。",
