  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 4,
          "unit": "piece",
          "note": "约两百克",
          "optional": false
        },
        {
          "name": "番茄",
          "name_en": "tomato",
          "amount": 400,
          "unit": "g",
          "note": "选熟透的",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "菜籽油",
          "name_en": "rapeseed oil",
          "amount": 40,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 8,
          "unit": "g",
          "note": "中和酸味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "打蛋碗",
    "锅铲",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄洗净去蒂，顶部划十字后用开水烫两分钟去皮。",
      "time_min": 5,
      "heat": "无火",
      "tip": "烫过之后皮一卷就掉，口感也更细腻。",
      "visual_cue": "番茄皮卷起，轻松整片撕下"
    },
    {
      "n": 2,
      "text": "去皮的番茄切成两厘米见方的块，汁水一起留着。",
      "time_min": 4,
      "heat": "无火",
      "tip": "汁水别倒，那是这道菜最鲜的部分。，这一步别偷懒。",
      "visual_cue": "番茄块大小均匀，砧板有红汁"
    },
    {
      "n": 3,
      "text": "鸡蛋打散加一小撮盐，用筷子搅到起细泡为止。",
      "time_min": 3,
      "heat": "无火",
      "tip": "打得越匀，炒出来颜色越金黄好看。，火候最关键。",
      "visual_cue": "蛋液均匀，表面浮着气泡"
    },
    {
      "n": 4,
      "text": "炒锅放一半菜籽油烧到微微冒烟，倒入蛋液。，中间别急着翻动。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油要够热，蛋液下去才能瞬间鼓起大泡。",
      "visual_cue": "蛋液迅速鼓起，边缘焦香"
    },
    {
      "n": 5,
      "text": "用铲子把蛋液划成大块，凝固后立刻盛出备着。",
      "time_min": 1,
      "heat": "中火",
      "tip": "半凝固就盛出，回锅再炒刚好嫩。，时间要卡准些。",
      "visual_cue": "蛋块蓬松金黄，中间还带湿润"
    },
    {
      "n": 6,
      "text": "锅里补油下番茄块，大火翻炒三分钟出汁。，保持锅里有底油。",
      "time_min": 3,
      "heat": "大火",
      "tip": "炒到番茄软塌出红汁，味道才濃。，顺序不能颠倒。",
      "visual_cue": "番茄块软塌，锅底积着红汁"
    },
    {
      "n": 7,
      "text": "加白糖与盐调味翻匀，让酸甜味调得刚好。，手法稳一些更好。",
      "time_min": 1,
      "heat": "大火",
      "tip": "糖能压住番茄的酸，别省这一步。，量别放多。",
      "visual_cue": "汤汁红亮，尝起来酸甜平衡"
    },
    {
      "n": 8,
      "text": "倒回蛋块轻轻推匀，撒葱花翻两下即可出锅。，动作要轻一点。",
      "time_min": 2,
      "heat": "中火",
      "tip": "轻轻推别乱翻，蛋块才保持完整不碎。",
      "visual_cue": "蛋块裹着红汁，葱花翠绿点缀"
    }
  ],
  "tips": [
    "番茄选沙瓤熟透的，炒出来才够甜。",
    "去皮这一步别省，口感差别很大。",
    "加一勺番茄酱，颜色和浓度都更足。",
    "蛋液别炒太老，嫩一点才好吃。，新手也能掌握。"
  ],
  "common_mistakes": [
    "番茄没去皮，吃的时候嚼到一层韧皮。",
    "蛋液小火慢炒，炒出来又老又干。，整锅味道都跟着毁了。",
    "不放糖只放盐，酸得发涩下不了口。，口感差得很多。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "番茄罐头",
      "ratio": "400克:350克",
      "note": "已调味，糖可减半。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4个:3个",
      "note": "蛋香更浓，腥味略重可加白胡椒。"
    }
  ],
  "variations": [
    "加一勺剁椒同炒，做成带辣的湘味版。",
    "出锅前淋几滴水淀粉，汤汁更浓稠。，口味层次更丰富。"
  ],
  "serving_suggestion": "连汁装盘趁热吃，蛋嫩茄软，酸甜汁水拌饭能吃两大碗。",
  "storage": "冷藏一天，复热用小火加两勺水焖两分钟。复热时加两勺清水，口感能恢复。",
