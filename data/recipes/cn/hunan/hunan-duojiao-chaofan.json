  "steps": [
    {
      "n": 1,
      "text": "隔夜冷饭用手抓散，把结块的米粒全部搓开备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷饭水分少才炒得粒粒分明，新饭易粘。",
      "visual_cue": "米粒松散无结块，颗粒分明"
    },
    {
      "n": 2,
      "text": "鸡蛋打散，青椒切小丁，蒜切末，小葱切成葱花备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "配料切小一点，才能和米粒一起吃进嘴。",
      "visual_cue": "配料丁细小均匀，蛋液匀"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，蛋液下锅炒散成小块后推至锅边。",
      "time_min": 2,
      "heat": "中火",
      "tip": "鸡蛋别炒太老，稍一凝固就推到一边备用。",
      "visual_cue": "蛋块嫩黄松散，油清亮"
    },
    {
      "n": 4,
      "text": "下蒜末和剁椒炒出红油，放青椒丁翻炒到断生。",
      "time_min": 2,
      "heat": "中火",
      "tip": "剁椒要炒出红油，辣香才进得去。",
      "visual_cue": "锅里泛起红油，辣香扑鼻"
    },
    {
      "n": 5,
      "text": "倒入米饭大火翻炒，用铲背压散，让每粒米都裹上红油。",
      "time_min": 3,
      "heat": "大火",
      "tip": "压散再翻，别用铲子乱剁把米压烂。",
      "visual_cue": "米粒油亮泛红，颗颗分明"
    },
    {
      "n": 6,
      "text": "加生抽和盐炒匀，撒葱花翻两下即可出锅装碗。",
      "time_min": 1,
      "heat": "大火",
      "tip": "剁椒本身有咸味，盐要少放先尝。",
      "visual_cue": "饭粒松散喷香，葱花点缀"
    }
  ],
  "tips": [
    "用隔夜冷饭，水分少才炒得颗粒分明。",
    "剁椒先炒出红油，辣香才透进米饭。",
    "盐要少放，剁椒本身咸味已经很足了。"
  ],
  "common_mistakes": [
    "用刚煮的热饭，下锅就粘成一团。",
    "剁椒不炒直接拌，生辣味冲鼻不香。",
    "用铲子乱剁米饭，炒出来像糊状一坨。"
  ],
  "substitutions": [
    {
      "original": "剁椒",
      "substitute": "辣椒酱",
      "ratio": "40 克:35 克",
      "note": "咸度更高，盐可省去不加。"
    },
    {
      "original": "米饭",
      "substitute": "糙米饭",
      "ratio": "400 克:400 克",
      "note": "口感更粗，需多加十毫升油防干。"
    }
  ],
  "variations": [
    "加一把腊肉丁同炒，湘味更足也更香。",
    "起锅前淋几滴香醋，解腻又提香。"
  ],
  "serving_suggestion": "趁热装碗，配一碗番茄蛋汤刚好平衡辣度。",
  "storage": "冷藏一天，复热用炒锅大火快翻，微波会让米粒发硬。",
