  "steps": [
    {
      "n": 1,
      "text": "猪里脊切成三毫米薄片，加料酒与生粉抓匀上浆，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切片薄一点更容易熟，入口也更嫩滑。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "肉片薄而均匀，表面带着薄浆"
    },
    {
      "n": 2,
      "text": "甜面酱、豆瓣酱与生抽、白糖加两勺清水调成酱汁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "酱先用水澥开，下锅才不会立刻炒糊。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "酱汁呈稀糊状，颜色棕红"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，下肉片大火滑炒到变白，盛出控油。",
      "time_min": 6,
      "heat": "大火",
      "tip": "肉片下锅先别翻，等边缘收紧再动就不粘。",
      "visual_cue": "肉片变色卷边，锅底无粘连"
    },
    {
      "n": 4,
      "text": "锅留底油，下姜末、蒜片炒香，加青椒与洋葱大火炒半分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "洋葱断生就够，炒软了会出水冲淡酱香。",
      "visual_cue": "洋葱边缘半透，青椒颜色变深"
    },
    {
      "n": 5,
      "text": "倒回肉片，淋入调好的酱汁，中火翻炒到酱汁裹匀即可出锅。",
      "time_min": 5,
      "heat": "中火",
      "tip": "酱汁一收干就关火，炒久了会发苦发咸。",
      "visual_cue": "肉片裹满酱色，锅底剩一层亮油"
    }
  ],
  "tips": [
    "酱料先用水澥开，是炒酱不糊的关键。火候与时间都要盯紧，宁可略短也别过头。",
    "肉片薄切上浆，滑炒后才嫩而不柴。做之前把料备齐，下锅后就没空切配了。",
    "酱本身够咸，盐基本可以不再加。这几步照顺序来，味道才会一层层叠上去。",
    "配白饭或拌面都很合适，酱汁很下饭。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "酱直接下干锅，几秒就糊成黑块发苦。结果往往一锅好料全被这一步毁掉。",
    "肉片切得太厚，外面老了里面还没熟。很多人就在这里翻车，出菜后才发现。",
    "洋葱炒得太久出水，酱汁被稀释变淡。账面上看是小疏忽，入口立刻能尝出来。",
    "收汁收得太干，肉片表面发硬咬不动。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "甜面酱",
      "substitute": "黄豆酱",
      "ratio": "30克:28克",
      "note": "咸度更高，生抽要减量。"
    },
    {
      "original": "猪里脊",
      "substitute": "猪梅肉",
      "ratio": "420克:420克",
      "note": "带一点脂肪，口感更润。"
    }
  ],
  "variations": [
    "加一勺剁椒同炒，辣味更直接。口味会更厚一些，适合重口的人。",
    "加几段干辣椒先炝锅，香气更冲。做法不复杂，家常灶台就能完成。",
    "配手擀面拌着吃，酱香全被面条吸走。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "盛盘时把酱汁一起浇上，配白饭和一碗青菜汤，咸香浓郁，是湘菜馆里最常见的下饭菜。",
  "storage": "冷藏可放一天，复热用炒锅小火加两勺清水翻匀，避免酱汁焦底。",
