  "steps": [
    {
      "n": 1,
      "text": "空心菜摘去老梗，嫩茎与叶子分开，洗净后充分沥干水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "水一定沥干，带水下锅会出一盘菜汤。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "菜叶干爽，茎叶分堆放好"
    },
    {
      "n": 2,
      "text": "大蒜拍碎切粗末，小米辣切圈，锅烧到冒青烟备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜末切粗一点，下锅才不容易焦糊。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "蒜末颗粒分明，锅温明显上升"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到微微冒烟，下蒜末与小米辣大火爆香。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油要够热，蒜香一冲出来就是湘菜的味道。",
      "visual_cue": "蒜末边缘起泡，油面香气冲鼻"
    },
    {
      "n": 4,
      "text": "先下菜茎翻炒三十秒，再下菜叶，沿锅边淋料酒继续大火翻炒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "茎和叶分开下，成熟度才一致不发黄。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "菜茎变深绿，菜叶刚塌下去"
    },
    {
      "n": 5,
      "text": "加盐与生抽快速翻匀，菜叶一软立刻关火出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "从下锅到出锅别超过两分钟，久了发黑。",
      "visual_cue": "菜色油绿发亮，盘底不出水"
    }
  ],
  "tips": [
    "空心菜要大火快炒，久炒必发黑。火候与时间都要盯紧，宁可略短也别过头。",
    "茎叶分开下锅，成熟度才一致。做之前把料备齐，下锅后就没空切配了。",
    "沿锅边淋一点料酒，菜色更翠绿。这几步照顺序来，味道才会一层层叠上去。",
    "锅要烧够热再下菜，锅气才足。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "菜没沥干就下锅，炒出一盘绿汤。结果往往一锅好料全被这一步毁掉。",
    "小火慢慢炒，菜叶发黄发蔫还出水。很多人就在这里翻车，出菜后才发现。",
    "蒜末炒到发黑才下菜，整盘带苦味。账面上看是小疏忽，入口立刻能尝出来。",
    "盐放太早，菜叶迅速出水变软。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "苋菜",
      "ratio": "600克:600克",
      "note": "更易出水，炒的时间更短。"
    },
    {
      "original": "小米辣",
      "substitute": "豆豉",
      "ratio": "10克:15克",
      "note": "咸香路线，盐要减一克。"
    }
  ],
  "variations": [
    "加一勺腐乳汁同炒，湘味更地道。口味会更厚一些，适合重口的人。",
    "加几段干辣椒炝锅，辣香更冲。做法不复杂，家常灶台就能完成。",
    "起锅前淋半勺猪油，香气更浓更润。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装盘立刻上桌，菜色油绿、蒜香直冲，配一碗白饭和一碟剁椒鱼，就是湖南人最熟悉的一餐。",
  "storage": "当餐吃完最好，冷藏不超过一天；复热用大火快炒四十秒，颜色会略暗。",
