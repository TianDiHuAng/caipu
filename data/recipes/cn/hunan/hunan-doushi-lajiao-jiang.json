      "items": [
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 120,
          "unit": "ml",
          "note": "封酱用",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 10,
          "unit": "g",
          "note": "调和咸辣",
          "optional": false
        },
        {
          "name": "白酒",
          "name_en": "baijiu",
          "amount": 15,
          "unit": "ml",
          "note": "防腐增香",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "按需补",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "搅拌机",
    "密封罐",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干豆豉用清水快速冲一遍，捞出沥干后粗粗剁碎。",
      "time_min": 8,
      "heat": "无火",
      "tip": "冲一下去浮尘但别久泡，泡软了没嚼头。",
      "visual_cue": "豆豉散开成小粒，手捏不发黏"
    },
    {
      "n": 2,
      "text": "炒锅倒一半花生油，小火把豆豉碎慢慢炒到出香。",
      "time_min": 8,
      "heat": "小火",
      "tip": "全程都要用小火，豆豉含糖多，一急就糊底。",
      "visual_cue": "豆豉粒油亮发亮，锅里飘出醇厚酱香"
    },
    {
      "n": 3,
      "text": "下蒜末继续用小火翻炒，炒到蒜香出来颜色微微发黄。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜末炒黄去生味，但绝不能炒到发褐。",
      "visual_cue": "蒜末散开成金黄色小粒，香气冲鼻"
    },
    {
      "n": 4,
      "text": "倒入剁椒与白糖，中火翻炒五分钟把水分炒掉一部分。",
      "time_min": 7,
      "heat": "中火",
      "tip": "炒到油色红亮、锅边见油就差不多了。",
      "visual_cue": "酱体变稠，红油浮在表面"
    },
    {
      "n": 5,
      "text": "加盐调味，沿锅边淋入白酒，再炒一分钟让酒气挥发。",
      "time_min": 3,
      "heat": "小火",
      "tip": "白酒能延长保质期，也会带出更干净的香气。",
      "visual_cue": "锅里酒气一闪即散，酱面油亮"
    },
    {
      "n": 6,
      "text": "关火略放凉，用搅拌机打成粗颗粒，保留一点豆豉的嚼感。",
      "time_min": 4,
      "heat": "无火",
      "tip": "不打碎也可以，打过的酱质地更细也更好抹开。",
      "visual_cue": "酱体呈粗泥状，能见到细小的豆粒"
    },
    {
      "n": 7,
      "text": "装进干净密封罐，表面淋上剩下的花生油封住酱面。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油封能隔开空气，颜色和味道都保持得更久。",
      "visual_cue": "油层薄薄铺在酱面，罐内无气泡"
    }
  ],
  "tips": [
    "蒸鱼、拌面、炒饭都能加一勺，非常提味。",
    "喜欢更辣可以用一半剁椒一半干辣椒。",
    "油封厚一点存放更久，取用后记得补油。",
    "打酱前彻底放凉，热酱进罐容易出水。"
  ],
  "common_mistakes": [
    "炒豆豉时火太大，几十秒就会糊出苦味。",
    "酱没放凉就装罐，水汽在罐里凝成水珠。",
    "取用用湿勺子，没过几天表面就起霉。"
  ],
  "substitutions": [
    {
      "original": "豆豉",
      "substitute": "黄豆酱",
      "ratio": "200克:200克",
      "note": "酱体更细，炒的时间缩短。"
    },
    {
      "original": "剁椒",
      "substitute": "干辣椒",
      "ratio": "150克:40克",
      "note": "辣味更硬，油要相应多加。"
    }
  ],
  "variations": [
    "加一小把虾皮同炒，鲜味会更足也更厚。",
    "放两片陈皮，回味带一点清苦的果香。"
  ],
  "serving_suggestion": "一小碟配白粥、蒸鱼或拌面，一小勺就够味。",
  "storage": "冷藏保存三个月，每次用干净无水的勺取用。",
