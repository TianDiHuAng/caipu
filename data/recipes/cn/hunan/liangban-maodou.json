  "steps": [
    {
      "n": 1,
      "text": "毛豆 500g 洗净，用剪刀剪去豆荚两端，方便入味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "剪口是关键，不剪味道进不去。",
      "visual_cue": "豆荚两端开口、颜色翠绿"
    },
    {
      "n": 2,
      "text": "锅中加水烧开，放 3g 盐与毛豆，中火煮 8 分钟至豆粒熟透。",
      "time_min": 10,
      "heat": "中火",
      "tip": "煮到豆粒能用指甲掐开即可。",
      "visual_cue": "豆粒饱满、豆荚转深绿"
    },
    {
      "n": 3,
      "text": "捞出毛豆立刻放入冰水中浸泡 3 分钟，捞出沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冰水过凉，口感才脆不发面。",
      "visual_cue": "毛豆翠绿、表面无水珠"
    },
    {
      "n": 4,
      "text": "碗中放蒜末 15g、干辣椒段 6g、花椒 2g，浇上烧至冒烟的热油。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油要烧到微微冒烟才激得出香。",
      "visual_cue": "辣椒变深红、香气冲鼻"
    },
    {
      "n": 5,
      "text": "加 20ml 生抽、15ml 香醋、5g 白糖与 2g 盐拌成调味汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "糖能压住醋的尖酸，别省。",
      "visual_cue": "调味汁颜色红褐、清亮不浑"
    },
    {
      "n": 6,
      "text": "把毛豆倒入调味汁中拌匀，淋 8ml 香油，冷藏 30 分钟后食用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冷藏半小时，味道才真正渗进去。",
      "visual_cue": "豆荚挂汁、色泽油亮"
    }
  ],
  "tips": [
    "毛豆剪口再煮，调味才吃得进去。",
    "煮好立刻过冰水，脆度差别很大。",
    "拌好冷藏半小时风味最好，现拌现吃偏淡。"
  ],
  "common_mistakes": [
    "整颗毛豆不剪口，拌完只有表面有味。",
    "毛豆煮过头，豆粒发面一拌就散。",
    "热毛豆直接拌汁，出水后味道全稀释。"
  ],
  "substitutions": [
    {
      "original": "毛豆",
      "substitute": "带壳花生",
      "ratio": "500g 对 400g",
      "note": "煮制时间延长到 25 分钟。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "15ml 对 15ml",
      "note": "酸味更柔和。"
    }
  ],
  "variations": [
    "撒上 5g 熟白芝麻，香气更足。",
    "拌入 10g 剁椒，辣味更鲜。"
  ],
  "serving_suggestion": "装盘冷藏上桌，配啤酒或作为饭前小菜。",
  "storage": "冷藏可存 2 天，汤汁会变深属正常现象。",
