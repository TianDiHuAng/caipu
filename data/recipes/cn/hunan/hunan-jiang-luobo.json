    "漏盆",
    "重物"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白萝卜洗净不去皮，先切成一厘米厚片再改刀成粗条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "带着皮切条才够脆，削了皮腌出来会发软。",
      "visual_cue": "萝卜条粗细均匀，长度约五厘米"
    },
    {
      "n": 2,
      "text": "萝卜条拌上盐抓匀，静置四十分钟让它慢慢渗出水分。",
      "time_min": 42,
      "heat": "无火",
      "tip": "出水越彻底，腌出来越脆，也更耐放不容易坏。",
      "visual_cue": "盆底积出大量水，萝卜条变软可弯"
    },
    {
      "n": 3,
      "text": "倒掉渗出的水，用手攥紧萝卜条挤去多余水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "攥得越干，酱汁就越容易被萝卜条吸进去。",
      "visual_cue": "萝卜条体积缩到原来的一半，表面发亮"
    },
    {
      "n": 4,
      "text": "生抽、白糖、白醋倒进小锅，小火加热到糖完全化开。",
      "time_min": 5,
      "heat": "小火",
      "tip": "酱汁只加热到冒小泡，煮沸会让风味变闷。",
      "visual_cue": "糖液透明无颗粒，闻起来酸甜带酱香"
    },
    {
      "n": 5,
      "text": "关火放凉，加蒜片、干辣椒段与花椒浸出香味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "一定要放凉再浇，热汁会把萝卜条烫软。",
      "visual_cue": "酱汁清凉，表面漂着辣椒与花椒"
    },
    {
      "n": 6,
      "text": "萝卜条装进干净无油的密封罐，倒入酱汁没过表面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "罐子要无油无水，沾了生水容易长白醭。",
      "visual_cue": "酱汁没过萝卜条，罐壁没有水痕"
    },
    {
      "n": 7,
      "text": "压上重物密封冷藏，腌四十八小时后即可食用。",
      "time_min": 48,
      "heat": "无火",
      "tip": "中间翻动一次让味道更均匀，冷藏至少两天。",
      "visual_cue": "萝卜条呈深琥珀色，咬下脆爽带汁"
    }
  ],
  "tips": [
    "腌好的萝卜条配粥最合适，咸鲜又开胃。",
    "糖量按口味增减，多一点会更像饭店口味。",
    "加两片香叶同腌，香气更有层次。",
    "一次可以多做些，冷藏密封能放一个月。"
  ],
  "common_mistakes": [
    "萝卜条没攥干水就腌，成品又软又寡淡。",
    "酱汁还热着就倒进去，萝卜条被烫得发韧。",
    "取用时不换干净筷子，整罐很快坏掉。"
  ],
  "substitutions": [
    {
      "original": "白萝卜",
      "substitute": "青萝卜",
      "ratio": "800克:800克",
      "note": "辣味略重，糖可多加十克。"
    },
    {
      "original": "白醋",
      "substitute": "柠檬汁",
      "ratio": "30毫升:35毫升",
      "note": "酸味柔和，香气更清新。"
    }
  ],
  "variations": [
    "加一勺辣椒油一起腌，辣香更突出也更开胃。",
    "萝卜条换成黄瓜条，脆感更强但只能放三天。"
  ],
  "serving_suggestion": "夹一小碟当开胃小菜，配白粥或米粉都合适。",
  "storage": "冷藏密封保存一个月，取用须用干净无水的筷子。",
