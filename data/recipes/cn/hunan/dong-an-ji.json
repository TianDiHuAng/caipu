  "equipment": [
    "炒锅",
    "汤锅",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿斩成 3 厘米见方的块，冷水下锅加 10ml 料酒焯 3 分钟捞出洗净。",
      "time_min": 6,
      "heat": "中火",
      "tip": "冷水下锅，血沫才能逼出来。",
      "visual_cue": "水面浮起灰白浮沫、鸡块紧缩"
    },
    {
      "n": 2,
      "text": "汤锅加 500ml 清水与姜丝，放入鸡块小火煮 10 分钟至七分熟，捞出留汤。",
      "time_min": 12,
      "heat": "小火",
      "tip": "煮到七分熟就捞，后面还要煸炒。",
      "visual_cue": "鸡肉断面略带粉色、汤色微黄"
    },
    {
      "n": 3,
      "text": "炒锅下 40ml 植物油，小火煸香花椒与干辣椒段至颜色转深。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒别炒黑，否则整道菜发苦。",
      "visual_cue": "辣椒段呈暗红色、花椒香气冒出"
    },
    {
      "n": 4,
      "text": "倒入鸡块中火翻炒 4 分钟，沿锅边淋 20ml 料酒与 20ml 生抽。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鸡块炒到边缘微黄更香。",
      "visual_cue": "鸡块表面收紧、上色均匀"
    },
    {
      "n": 5,
      "text": "加 150ml 煮鸡原汤与 60ml 米醋，小火焖 8 分钟让酸味渗进肉里。",
      "time_min": 9,
      "heat": "小火",
      "tip": "米醋分两次放，香气更立体。",
      "visual_cue": "汤汁收至一半、鸡块油亮"
    },
    {
      "n": 6,
      "text": "撒 3g 盐与葱段，再淋 10ml 米醋翻匀，大火收汁 1 分钟出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "起锅前补醋，酸香才冲。",
      "visual_cue": "汤汁浓稠挂肉、酸香扑鼻"
    }
  ],
  "tips": [
    "米醋要分两次下，第一次入味第二次提香。",
    "鸡肉煮到七分熟再炒，肉质才嫩不柴。",
    "干辣椒要用小火慢煸，火急了十秒就发苦。"
  ],
  "common_mistakes": [
    "鸡肉直接生炒下锅，肉质发老还带腥味。",
    "醋一次性倒完，酸味发冲没有层次。",
    "辣椒炒到发黑，整锅带着焦苦味。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "三黄鸡",
      "ratio": "600g 对 600g",
      "note": "肉质更嫩，煮制时间减 2 分钟。"
    },
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "60ml 对 55ml",
      "note": "香醋酸度略高，用量稍减。"
    }
  ],
  "variations": [
    "去骨版：用鸡腿肉去骨切块，吃起来更方便。",
    "加仔姜版：加 30g 仔姜丝同焖更清爽。"
  ],
  "serving_suggestion": "趁热上桌，酸辣汁拌饭极下饭，配一碗白米饭。",
  "storage": "冷藏 1 天，复热时加一勺原汤小火焖 3 分钟。",
