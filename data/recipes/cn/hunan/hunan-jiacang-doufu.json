  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成半厘米厚的三角块，放淡盐水里泡几分钟去豆腥。",
      "time_min": 6,
      "heat": "无火",
      "tip": "用老豆腐才煎得整，嫩豆腐一铲就碎。",
      "visual_cue": "豆腐块边缘硬挺，不散"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧热，豆腐块下锅摊开，中火煎到底面金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "刚下锅别急着翻，等定型再动，一铲就散。",
      "visual_cue": "底面金黄结壳，晃动锅块会滑动"
    },
    {
      "n": 3,
      "text": "翻面把另一面也煎到金黄，盛出沥掉多余的油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "两面都煎过才不吸汤汁，也不容易煮烂。",
      "visual_cue": "两面焦黄，外皮微硬"
    },
    {
      "n": 4,
      "text": "锅内留底油，下五花肉片煸炒到出油、边缘卷起。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉片煸出油，后面烧豆腐才够香，别煸太干。",
      "visual_cue": "肉片卷曲，锅里有清亮油脂"
    },
    {
      "n": 5,
      "text": "下姜末、蒜片、干辣椒段和豆瓣酱，小火炒出红油。",
      "time_min": 3,
      "heat": "小火",
      "tip": "豆瓣酱要小火炒，大火一糊整锅发苦。",
      "visual_cue": "油色红亮，香味冲鼻"
    },
    {
      "n": 6,
      "text": "倒回煎好的豆腐，加生抽和清水，轻推翻匀后小火烧。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "用铲子背推，别大力翻炒，豆腐容易碎。",
      "visual_cue": "汤汁微沸，豆腐吸色变深"
    },
    {
      "n": 7,
      "text": "放青椒片继续烧到断生，尝一下咸淡再补盐。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "青椒后放，保持翠绿脆口，久烧会发黄。",
      "visual_cue": "青椒颜色鲜亮，边缘微软"
    },
    {
      "n": 8,
      "text": "撒青蒜段翻匀，大火收一收汤汁，出锅装盘。",
      "time_min": 3,
      "heat": "中火",
      "tip": "青蒜断生就起锅，久炒发黄失去辛香。",
      "visual_cue": "汤汁挂勺，青蒜翠绿"
    }
  ],
  "tips": [
    "豆腐先用盐水泡再煎，去豆腥又不易碎。",
    "豆瓣酱要小火慢炒出红油，火大易糊发苦。",
    "收汁别收干，留点汤汁拌饭最好。"
  ],
  "common_mistakes": [
    "用嫩豆腐直接煎，翻面就碎成渣。",
    "豆瓣酱大火炒糊，整盘带焦苦味。",
    "豆腐下锅后大力翻炒，全成碎块。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "油豆腐",
      "ratio": "400 克:250 克",
      "note": "更吸汁，烧制时间缩短三分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "80 克:70 克",
      "note": "湘味更浓，需先蒸软再切片，盐要减量。"
    }
  ],
  "variations": [
    "加一勺剁椒同烧，酸辣味更开胃下饭。",
    "换成干锅做法，收干汤汁配酒精炉上桌。"
  ],
  "serving_suggestion": "连汁盛入深盘，撒青蒜，配米饭一勺一勺浇着吃。",
  "storage": "冷藏两天，复热加少量清水小火焖三分钟，别用微波否则豆腐发硬。",
