          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "底味",
