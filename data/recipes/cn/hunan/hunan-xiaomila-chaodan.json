          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "打蛋碗",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕进碗里加一克盐，用筷子充分打散到蛋液均匀起泡。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蛋液打散要打到起小泡，炒出来才蓬松。",
      "visual_cue": "蛋液均匀、表面有细密气泡"
    },
    {
      "n": 2,
      "text": "小米辣去蒂切成小圈，大蒜切片，葱切成段备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "小米辣籽留一部分，辣味更冲。",
      "visual_cue": "辣椒圈均匀、蒜片薄"
    },
    {
      "n": 3,
      "text": "炒锅烧热放一半植物油，倒入蛋液，待边缘凝固后用铲子推成大块盛出。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "蛋液半凝就盛出，回锅才嫩。",
      "visual_cue": "蛋块金黄蓬松、无焦边"
    },
    {
      "n": 4,
      "text": "锅里补剩下的油，下蒜片与小米辣小火煸出辣香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "辣椒别炒糊，糊了发苦。",
      "visual_cue": "辣椒转深红、辣香扑鼻"
    },
    {
      "n": 5,
      "text": "倒回蛋块，加生抽与剩下的盐，大火快速翻炒半分钟，撒葱段出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "回锅只能快炒，久了蛋变硬。",
      "visual_cue": "蛋块裹匀酱色、辣香浓"
    }
  ],
  "tips": [
    "蛋液里加一勺清水，炒出来更嫩滑。",
    "小米辣可换成青尖椒，辣味柔和些。",
    "用铁锅炒蛋前把锅烧透，不粘不糊。"
  ],
  "common_mistakes": [
    "蛋液不打散直接下锅，炒出来一坨坨不蓬松。",
    "鸡蛋炒到全熟才盛出，回锅后变得又干又硬。",
    "辣椒炒到发黑，整盘都带焦苦味。"
  ],
  "substitutions": [
    {
      "original": "小米辣",
      "substitute": "青尖椒",
      "ratio": "30g 对 50g",
      "note": "青椒水分多，煸的时间加半分钟。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4 个 对 4 个",
      "note": "鸭蛋腥味重，加两滴料酒去腥。"
    }
  ],
  "variations": [
    "加一勺剁椒同炒，酸辣开胃更像湘菜馆味道。",
    "放一把葱花在最后炒匀，葱香更突出。"
  ],
  "serving_suggestion": "配白米饭最好，一勺辣椒炒蛋能拌下两碗饭。",
  "storage": "现炒现吃，冷藏后蛋块回硬，口感变差。",
