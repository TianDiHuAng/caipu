  "steps": [
    {
      "n": 1,
      "text": "豆腐切一厘米厚片，用厨房纸吸干表面水分。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "吸干水，煎的时候才不粘锅。，注意火候。",
      "visual_cue": "片身干爽，边缘整齐，状态稳定"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧热，豆腐片平铺进去小火煎。这一步别着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "一片片铺开，别叠在一起。，注意火候。",
      "visual_cue": "底面微黄，边缘起壳，状态稳定"
    },
    {
      "n": 3,
      "text": "煎三分钟翻面，两面都煎到金黄盛出。这一步别着急。",
      "time_min": 6,
      "heat": "小火",
      "tip": "轻轻推，豆腐才不破。，注意火候。",
      "visual_cue": "两面金黄，块形完整，状态稳定"
    },
    {
      "n": 4,
      "text": "锅里留底油，下五花肉片炒到出油。这一步别着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "肉片炒出油，菜才够香。，注意火候。",
      "visual_cue": "肉片卷曲，油色清亮，状态稳定"
    },
    {
      "n": 5,
      "text": "放蒜片和豆豉炒香，再下青椒圈。这一步别着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "豆豉炒过才香，别直接下锅。，注意火候。",
      "visual_cue": "辣香冲鼻，青椒变深绿"
    },
    {
      "n": 6,
      "text": "倒回豆腐片，加生抽和盐轻推拌匀。这一步别着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "用铲子背推，豆腐才不碎。，注意火候。",
      "visual_cue": "豆腐挂色，青椒翠绿，状态稳定"
    },
    {
      "n": 7,
      "text": "加清水焖三分钟，让豆腐吸味。这一步别着急。",
      "time_min": 4,
      "heat": "中火",
      "tip": "水别多，收干就好。，注意火候。",
      "visual_cue": "汤汁收干，豆腐鼓胀，状态稳定"
    }
  ],
  "tips": [
    "豆腐吸干水再煎，才不粘锅破皮。，值得留意。",
    "豆豉先炒香，味道才厚重。，值得留意。",
    "用推不用铲，豆腐才完整。，值得留意。"
  ],
  "common_mistakes": [
    "豆腐没吸干水，下锅就粘。，值得留意。",
    "火太大，豆腐外面焦里面还是凉的。，值得留意。",
    "翻拌太用力，整盘碎成渣。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "北豆腐",
      "ratio": "400 克:400 克",
      "note": "更结实，煎时不易碎。"
    },
    {
      "original": "青椒",
      "substitute": "螺丝椒",
      "ratio": "150 克:150 克",
      "note": "更辣，用量可减到 100 克。"
    }
  ],
  "variations": [
    "加一勺剁椒，辣香更冲。，值得留意。",
    "最后撒一把蒜苗段，香气更足。，值得留意。"
  ],
  "serving_suggestion": "配米饭，汤汁拌饭最香。，效果更稳定。",
  "storage": "冷藏一天，复热下锅加少量水焖两分钟。，效果更稳定。",
