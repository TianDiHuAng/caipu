  "steps": [
    {
      "n": 1,
      "text": "海带用清水冲洗两遍，卷起来切成五厘米长的细丝。",
      "time_min": 9,
      "heat": "无火",
      "tip": "海带表面的黏液要冲掉，不然拌出来发滑。",
      "visual_cue": "海带丝宽窄均匀，表面不黏手"
    },
    {
      "n": 2,
      "text": "锅中水烧开，下海带丝煮四分钟去腥，捞出立刻过凉水。",
      "time_min": 7,
      "heat": "大火",
      "tip": "煮到能咬断就够，煮久了软塌没口感。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "海带丝柔软有弹性，颜色转深绿"
    },
    {
      "n": 3,
      "text": "海带丝充分沥干，用手轻压挤出多余水分装进大碗。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水挤干料汁才不被稀释，味道才够浓。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "海带丝松散不黏连，碗底无水"
    },
    {
      "n": 4,
      "text": "蒜末与小米辣放碗中，浇上烧到冒烟的植物油激出香气。",
      "time_min": 3,
      "heat": "无火",
      "tip": "油要烧到起烟再泼，蒜香才冲得出来。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "蒜末滋滋响，油面浮起细泡"
    },
    {
      "n": 5,
      "text": "加生抽、陈醋、盐、白糖、辣椒油与香油调匀，倒进海带碗拌好撒香菜。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌好后静置五分钟，酸辣味才吃进丝里。",
      "visual_cue": "海带丝红亮带光泽，料汁挂得匀"
    }
  ],
  "tips": [
    "海带焯水时间别长，要留一点嚼劲。火候与时间都要盯紧，宁可略短也别过头。",
    "热油泼蒜是香气来源，冷油不行。做之前把料备齐，下锅后就没空切配了。",
    "陈醋比白醋更对味，酸得圆润。这几步照顺序来，味道才会一层层叠上去。",
    "拌好冷藏十分钟，冰爽更下饭。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "海带泡不洗干净，吃起来有沙粒感。结果往往一锅好料全被这一步毁掉。",
    "焯水太久，海带软烂像面条。很多人就在这里翻车，出菜后才发现。",
    "不过凉水，海带余温继续变软。账面上看是小疏忽，入口立刻能尝出来。",
    "料汁没调匀就倒进去，咸酸不均。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "海带",
      "substitute": "海带结",
      "ratio": "400克:400克",
      "note": "切丝后同样做法，口感更厚。"
    },
    {
      "original": "辣椒油",
      "substitute": "剁椒",
      "ratio": "25毫升:30克",
      "note": "更湘式，盐减一克。"
    }
  ],
  "variations": [
    "加一把焯熟的黄豆芽，脆感更足。口味会更厚一些，适合重口的人。",
    "加一勺芝麻酱，酸辣里多一层醇厚。做法不复杂，家常灶台就能完成。",
    "加几段香菜和花生碎，香气层次更丰富。"
  ],
  "serving_suggestion": "装盘撒上香菜段，配啤酒或白粥都合适，是湖南小馆子里最先上桌的一碟凉菜。",
  "storage": "冷藏可放一天，吃前重新拌匀；海带出水后口味会变淡，可补几滴生抽。",
