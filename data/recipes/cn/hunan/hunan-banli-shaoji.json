  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉斩成三厘米块，冷水下锅加料酒焯水，撇沫后捞出冲净。",
      "time_min": 12,
      "heat": "大火",
      "tip": "焯水去腥，鸡块表面收紧再烧更香。",
      "visual_cue": "鸡块发白，浮沫撇净。"
    },
    {
      "n": 2,
      "text": "栗子去壳后用开水烫五分钟，剥去内层薄皮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "烫过再剥，那层薄膜一搓就掉。",
      "visual_cue": "栗子仁金黄完整。"
    },
    {
      "n": 3,
      "text": "锅里倒花生油，下姜片、八角与干辣椒小火煸香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "香料别炒糊，微微冒香就够。",
      "visual_cue": "姜片微卷，香味浮起。"
    },
    {
      "n": 4,
      "text": "倒入鸡块用大火翻炒到表面微黄，沿锅边烹入料酒去腥。",
      "time_min": 8,
      "heat": "大火",
      "tip": "鸡块炒到出油，成菜才香不腥。",
      "visual_cue": "鸡皮卷起，锅底见油。"
    },
    {
      "n": 5,
      "text": "加生抽、老抽与冰糖翻匀，加热水没过鸡块，放葱结煮开。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水一次加足，中途添水会冲淡味道。",
      "visual_cue": "汤汁酱红，鸡块上色均匀。"
    },
    {
      "n": 6,
      "text": "转小火炖二十分钟，再下栗子继续炖十五分钟。",
      "time_min": 37,
      "heat": "小火",
      "tip": "栗子后放，久炖会散成泥。",
      "visual_cue": "栗子软糯，鸡块酥嫩。"
    },
    {
      "n": 7,
      "text": "加盐调味，转大火收汁到浓稠，撒葱花装盘。",
      "time_min": 8,
      "heat": "大火",
      "tip": "收汁时勤翻动，糖分容易糊底。",
      "visual_cue": "汤汁挂勺，栗子油亮。"
    }
  ],
  "tips": [
    "板栗选个头均匀的油栗，粉糯不散。",
    "鸡用土鸡更香，老母鸡要炖足一小时。",
    "栗子可以先过油再炖，形状更完整。"
  ],
  "common_mistakes": [
    "栗子和鸡一起下锅，炖完只剩鸡块，栗子全化。",
    "冰糖炒过头变焦糖色，味道发苦。"
  ],
  "substitutions": [
    {
      "original": "栗子",
      "substitute": "芋头",
      "ratio": "300g 对 350g",
      "note": "芋头版汤汁更稠，炖的时间缩短五分钟。"
    }
  ],
  "variations": [
    "湘中一带会加几片腊肉同烧，油脂渗进栗子里，香得更彻底。"
  ],
  "serving_suggestion": "连汁带料装盘，配米饭，栗子最抢手。",
  "storage": "冷藏两天，复热时加少量热水，栗子会略散。",
