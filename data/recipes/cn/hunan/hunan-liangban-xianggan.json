  "steps": [
    {
      "n": 1,
      "text": "豆腐干切成半厘米厚的薄片，再切成两指宽的条。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切薄一点更容易入味。",
      "visual_cue": "香干条厚薄一致，边缘整齐。"
    },
    {
      "n": 2,
      "text": "锅里烧水，水开后下香干条焯一分钟，捞出沥干。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯一下能去豆腥，也让香干更软。",
      "visual_cue": "香干条发软，表面湿润。"
    },
    {
      "n": 3,
      "text": "青椒切圈，小米辣切圈，大蒜剁成细末备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "蒜末剁细，泼油后香气才出得来。",
      "visual_cue": "配料切好分装，颜色分明。"
    },
    {
      "n": 4,
      "text": "小碗放蒜末、小米辣、青椒圈与盐，把花生油烧热泼上去激香。",
      "time_min": 5,
      "heat": "大火",
      "tip": "油要冒青烟才够热，泼下去才有香味。",
      "visual_cue": "蒜末微黄，油面浮起小泡。"
    },
    {
      "n": 5,
      "text": "碗里加生抽、米醋、白糖与辣椒油，搅匀成料汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要先化开，味道才不齁。",
      "visual_cue": "料汁红亮，颗粒溶解。"
    },
    {
      "n": 6,
      "text": "香干条装盘，淋料汁拌匀，撒香菜与小葱花，点香油上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌好静置十分钟，香干吸足味道。",
      "visual_cue": "香干油润发亮，香菜点缀。"
    }
  ],
  "tips": [
    "香干选带点烟熏味的，风味更足。",
    "焯水后一定要沥干，不然料汁被冲淡。",
    "喜欢更辣可以把青椒换成剁椒，酸辣更冲。"
  ],
  "common_mistakes": [
    "香干不焯水直接拌，豆腥味明显。",
    "泼油温度不够，蒜末生涩，香味出不来。"
  ],
  "substitutions": [
    {
      "original": "豆腐干",
      "substitute": "腐竹",
      "ratio": "500g 对 300g 干品",
      "note": "腐竹须提前泡发并焯熟，口感更韧。"
    }
  ],
  "variations": [
    "湘南会加一勺豆豉同拌，咸香更厚，配粥也很好。"
  ],
  "serving_suggestion": "装白盘上桌，撒一把熟芝麻更香。",
  "storage": "冷藏两天，吃前翻拌一次，香菜另加。",
