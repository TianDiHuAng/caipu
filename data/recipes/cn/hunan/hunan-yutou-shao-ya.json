  "steps": [
    {
      "n": 1,
      "text": "鸭斩成四厘米块，冷水下锅加料酒焯水，撇沫后捞出冲净。",
      "time_min": 15,
      "heat": "大火",
      "tip": "焯水时别加盖，腥味才散得掉。",
      "visual_cue": "浮沫撇净，鸭块紧实。"
    },
    {
      "n": 2,
      "text": "芋头削皮切滚刀块，泡在清水里防止表面氧化发黑。",
      "time_min": 10,
      "heat": "无火",
      "tip": "芋头黏液沾手会痒，削皮戴手套。",
      "visual_cue": "芋头块洁白，泡水不发黑。"
    },
    {
      "n": 3,
      "text": "锅里倒花生油，下姜片、干辣椒与八角用小火慢慢煸出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "香料先下，油里带香再烧鸭。",
      "visual_cue": "姜片卷边，香味浮出。"
    },
    {
      "n": 4,
      "text": "倒入鸭块转大火翻炒到表皮微黄，沿锅边烹入料酒。",
      "time_min": 10,
      "heat": "大火",
      "tip": "鸭皮炒出油，烧出来才不腥不腻。",
      "visual_cue": "鸭块金黄，锅底有清油。"
    },
    {
      "n": 5,
      "text": "加生抽、老抽与冰糖炒匀上色，倒热水没过鸭块。",
      "time_min": 7,
      "heat": "大火",
      "tip": "热水下锅，鸭肉才不紧缩。",
      "visual_cue": "鸭块金黄，汤汁深酱色"
    },
    {
      "n": 6,
      "text": "大火煮开转小火炖三十五分钟，至鸭肉七成酥。",
      "time_min": 37,
      "heat": "小火",
      "tip": "先炖鸭再下芋头，两者熟度才一致。",
      "visual_cue": "鸭肉能被筷子戳动。"
    },
    {
      "n": 7,
      "text": "下芋头块继续炖十五分钟，加盐调味，大火收汁撒葱花。",
      "time_min": 18,
      "heat": "小火",
      "tip": "芋头易烂，翻动要轻，别用勺子搅。",
      "visual_cue": "芋头软糯，汤汁浓稠。"
    }
  ],
  "tips": [
    "芋头选小个的荔浦芋或毛芋，粉糯不易散。",
    "鸭肉脂肪多，炖好后撇去浮油更清爽。",
    "加一小块陈皮能压住鸭腥，风味更足。"
  ],
  "common_mistakes": [
    "芋头一开始就下锅，炖完化在汤里。",
    "鸭块焯水后不冲冷水，表面浮沫粘在肉上。"
  ],
  "substitutions": [
    {
      "original": "芋头",
      "substitute": "土豆",
      "ratio": "500g 对 500g",
      "note": "土豆版汤汁更稠，炖的时间缩短五分钟。"
    }
  ],
  "variations": [
    "湘南会加一把酸辣椒同烧，酸辣解腻，配米饭特别香。"
  ],
  "serving_suggestion": "连汤带料装深盘，配米饭，芋头吸汁最好吃。",
  "storage": "冷藏两天，复热时加少量热水，芋头会略化。",
