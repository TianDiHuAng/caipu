  "steps": [
    {
      "n": 1,
      "text": "冬瓜削去外皮，挖掉中间的瓜瓤与籽，切成一厘米厚的方块。",
      "time_min": 10,
      "heat": "无火",
      "tip": "瓜瓤一定要挖净，留着烧出来水多还带生味。",
      "visual_cue": "切块大小均匀，断面白净无瓤"
    },
    {
      "n": 2,
      "text": "切好的冬瓜块撒少许盐抓匀，静置五分钟让它出水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "先刹水再烧，冬瓜不容易煮成一锅汤。",
      "visual_cue": "块面渗出水珠，边角略微软"
    },
    {
      "n": 3,
      "text": "炒锅倒菜籽油烧热，下豆豉、蒜片、姜末与小米椒炒出香味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "豆豉炒散，香气才出得来，这是湘味的底子。",
      "visual_cue": "锅里飘出酱香，油色微微泛红"
    },
    {
      "n": 4,
      "text": "倒入冬瓜块转大火翻炒两分钟，让每块都裹上油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "冬瓜先炒过再烧，表面收紧，烧完不散不烂。",
      "visual_cue": "冬瓜表面微微透明，油光均匀"
    },
    {
      "n": 5,
      "text": "加生抽、老抽、白糖与小半碗清水，盖上锅盖小火焖八分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "水别多，冬瓜自己会出水，多了就成冬瓜汤。",
      "visual_cue": "汤汁微沸，冬瓜边缘发透"
    },
    {
      "n": 6,
      "text": "开盖转大火收汁，试味补盐，撒葱段翻匀后出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁时要轻轻推动锅体，别用铲子翻，冬瓜一搅就碎成泥了。",
      "visual_cue": "汤汁浓亮挂块，冬瓜透亮不塌"
    }
  ],
  "tips": [
    "冬瓜选表皮带白霜、掂着沉的，肉质紧实不空心。",
    "加一把虾皮同烧，鲜味更足，可以少放生抽。",
    "喜欢吃口感更软糯的，可以把焖制的时间再延长两分钟。"
  ],
  "common_mistakes": [
    "瓜瓤没挖净，烧出来一锅水还带生味。",
    "水加太多，冬瓜煮散成糊，卖相全无。",
    "大火久烧不收汁，味道全留在汤里，冬瓜寡淡。"
  ],
  "substitutions": [
    {
      "original": "冬瓜",
      "substitute": "丝瓜",
      "ratio": "600克:500克",
      "note": "丝瓜易熟，焖的时间减四分钟。"
    },
    {
      "original": "菜籽油",
      "substitute": "花生油",
      "ratio": "30毫升:30毫升",
      "note": "花生油更清爽，但湘味略淡。"
    }
  ],
  "variations": [
    "加几片腊肉同烧，油香压住冬瓜的清寡，是湖南冬天的做法。",
    "把冬瓜换成萝卜同烧，甜味更足，烧的时间延长五分钟。"
  ],
  "serving_suggestion": "连汁浇在米饭上，清爽解腻，适合配重口味的荤菜。",
  "storage": "冷藏可存两天，复热须小火加少许水焖三分钟。",
