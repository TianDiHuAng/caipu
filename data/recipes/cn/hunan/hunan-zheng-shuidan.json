  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 240,
          "unit": "g",
          "note": "约四枚，选新鲜的洋鸡蛋",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切极细的葱花",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 360,
          "unit": "ml",
          "note": "温水，与蛋液一比一点五",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "先化在水里再加蛋液",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "蒸好后沿碗边淋一圈",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 8,
          "unit": "ml",
          "note": "出锅泼在葱花上增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸碗",
    "细筛",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "清水加盐搅到完全化开，鸡蛋磕进碗里用筷子顺一个方向打散到不见成块蛋白。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液打散但别打出太多泡，泡多了表面全是孔。",
      "visual_cue": "蛋液颜色均匀，挑起筷子不见挂着的蛋白丝。"
    },
    {
      "n": 2,
      "text": "把淡盐水缓缓倒进蛋液边倒边搅，混合后用细筛过滤两遍到蒸碗里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "筛网能滤掉筋膜，这一步决定蛋羹细不细。",
      "visual_cue": "滤网上留下白色絮状物，碗里蛋液平滑无泡。"
    },
    {
      "n": 3,
      "text": "蒸碗盖上保鲜膜用牙签扎几个小孔，蒸锅水大滚后放进去大火蒸三分钟。",
      "time_min": 3,
      "heat": "大火",
      "tip": "不盖膜蒸汽滴下来，表面就是一片麻点。",
      "visual_cue": "碗内蛋液边缘先凝固，中心仍在轻晃。"
    },
    {
      "n": 4,
      "text": "转中小火继续蒸七分钟，关火后不开盖虚蒸两分钟再取出。",
      "time_min": 9,
      "heat": "中小火",
      "tip": "虚蒸让中心慢慢定住，直接开盖容易塌陷。",
      "visual_cue": "蛋羹整体凝固，轻晃碗面只有轻微颤动。"
    },
    {
      "n": 5,
      "text": "揭去保鲜膜倒掉碗边积水，淋生抽，把植物油烧热泼在葱花上，即可上桌。",
      "time_min": 2,
      "heat": "中火",
      "tip": "碗边积水倒掉，否则生抽一冲就发浑。",
      "visual_cue": "蛋羹表面平整如镜，酱色沿碗边渗开一圈。"
    }
  ],
  "tips": [
    "水温控制在四十度左右，太烫会把蛋液烫成蛋花，太凉蒸出来发腥。",
    "蛋液过筛两遍，滤掉筋膜和气泡，蒸面才平得像镜面。",
    "碗上盖一层保鲜膜或扣个盘子，蒸汽水滴不进去，表面就不会有坑。"
  ],
  "common_mistakes": [
    "蛋液和水随手一搅就上锅，蛋白没打散，蒸出来一块白一块黄。",
    "全程大火猛蒸，蛋液内部沸腾起蜂窝，口感粗得像海绵。",
    "蒸好就端出来，碗还烫手，蛋羹一晃就塌，边缘全是水。"
  ],
  "substitutions": [
    {
      "original": "清水",
      "substitute": "高汤",
      "ratio": "360毫升:360毫升",
      "note": "鲜味更足，盐要减到两克。"
    },
    {
      "original": "生抽",
      "substitute": "蒸鱼豉油",
      "ratio": "10毫升:10毫升",
      "note": "咸鲜更清爽，颜色略浅。"
    }
  ],
  "variations": [
    "表面撒一小把剁椒再蒸，酸辣味渗进蛋羹，是湘式家常吃法。",
    "蛋液里加两勺磨碎的猪肉糜，蒸出来更香，但蒸的时间要加两分钟。"
  ],
  "serving_suggestion": "蒸好的蛋羹淋生抽泼热油，撒葱花，用勺子挖着配白饭，老人小孩都好入口，湖南人家早餐桌上的常客。",
  "storage": "现蒸现吃最嫩，剩下的冷藏一天，回蒸三分钟，别用微波，蛋羹会起蜂窝。",
