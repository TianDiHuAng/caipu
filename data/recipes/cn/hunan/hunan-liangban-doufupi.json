  "steps": [
    {
      "n": 1,
      "text": "豆腐皮切成半厘米宽的细丝，长度控制在五厘米左右。",
      "time_min": 8,
      "heat": "无火",
      "tip": "丝切得均匀，拌的时候才一起入味。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "豆皮丝宽窄一致，边缘整齐"
    },
    {
      "n": 2,
      "text": "锅中水烧开，下豆皮丝焯两分钟去豆腥，捞出过凉水沥干。",
      "time_min": 7,
      "heat": "大火",
      "tip": "焯一下豆腥味就没了，过凉水更筋道。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "豆皮丝柔软有弹性，不粘连"
    },
    {
      "n": 3,
      "text": "黄瓜切细丝，香菜切段，大蒜切末，小米辣切圈备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "黄瓜丝切细一点，和豆皮一起入口才协调。",
      "visual_cue": "配菜丝条均匀，颜色分明"
    },
    {
      "n": 4,
      "text": "蒜末与小米辣放碗里，浇上烧到冒烟的植物油激出香味。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油一定要烧热再泼，蒜香才被激出来。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "蒜末滋滋作响，油面香气冲鼻"
    },
    {
      "n": 5,
      "text": "加生抽、陈醋、盐、白糖、辣椒油与香油调匀，倒入豆皮丝与配菜拌好。",
      "time_min": 5,
      "heat": "无火",
      "tip": "料汁先调匀再拌，味道才均匀不偏咸。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "豆皮丝色泽红亮，料汁裹得均匀"
    }
  ],
  "tips": [
    "豆皮焯水去豆腥，口感也更筋道。火候与时间都要盯紧，宁可略短也别过头。",
    "热油泼蒜是这道凉菜的灵魂，别省。做之前把料备齐，下锅后就没空切配了。",
    "料汁先调好再拌，咸淡更均匀。这几步照顺序来，味道才会一层层叠上去。",
    "拌好放十分钟再吃，入味最充分。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "豆皮不焯直接拌，一股生豆腥味。结果往往一锅好料全被这一步毁掉。",
    "焯完不过凉水，豆皮发软发黏。很多人就在这里翻车，出菜后才发现。",
    "冷油泼蒜，激不出香味还有生油味。账面上看是小疏忽，入口立刻能尝出来。",
    "料汁没调匀就倒进去，一口咸一口淡。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "豆腐皮",
      "substitute": "腐竹",
      "ratio": "300克:200克",
      "note": "需提前泡发四小时再焯。"
    },
    {
      "original": "辣椒油",
      "substitute": "剁椒",
      "ratio": "25毫升:30克",
      "note": "更酸辣，盐减一克。"
    }
  ],
  "variations": [
    "加一把焯熟的绿豆芽，口感更丰富。口味会更厚一些，适合重口的人。",
    "加一勺芝麻酱同拌，香气更厚。做法不复杂，家常灶台就能完成。",
    "加几根焯水的粉丝，变成一道凉拌拼盘。"
  ],
  "serving_suggestion": "装盘后撒一点香菜叶点缀，配冰啤酒或白粥都合适，是湖南夏天餐桌上最先空盘的一碟。",
  "storage": "冷藏可放一天，吃前重新拌匀；豆皮吸水后会变淡，可补几滴生抽。",
