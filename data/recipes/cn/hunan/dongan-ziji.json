  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "鸡腿",
          "name_en": "chicken leg",
          "amount": 600,
          "unit": "g",
          "note": "带骨鸡腿 2 只，剁成 3 厘米宽的条",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "切细丝",
          "optional": false
        },
        {
          "name": "大葱",
          "name_en": "welsh onion",
          "amount": 25,
          "unit": "g",
          "note": "切 4 厘米段",
          "optional": false
        },
        {
          "name": "干辣椒",
          "name_en": "dried red chili",
          "amount": 10,
          "unit": "g",
          "note": "剪段去籽，辣度可控",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "香醋",
          "name_en": "black vinegar",
          "amount": 40,
          "unit": "ml",
          "note": "分两次烹入，一半焖煮、一半出锅前提香",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "shaoxing wine",
          "amount": 20,
          "unit": "ml",
          "note": "去腥用",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "分两次加入",
          "optional": false
        },
        {
          "name": "花椒",
          "name_en": "sichuan peppercorn",
          "amount": 3,
          "unit": "g",
          "note": "整粒，最后挑出",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 15,
          "unit": "ml",
          "note": "补咸鲜",
          "optional": false
        },
        {
          "name": "菜籽油",
          "name_en": "rapeseed oil",
          "amount": 45,
          "unit": "ml",
          "note": "煸炒用，实耗约 25 毫升",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "漏勺",
    "砧板与剁刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿剁块后用清水冲净血水，沥干；锅中放 45 毫升菜籽油烧到六成热，下鸡块中火煸 6 分钟至表面微黄、鸡皮收紧。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鸡块下锅后先别急着翻动，等一面定型再翻，避免粘锅破皮。",
      "visual_cue": "鸡皮由白转金、边缘略卷，锅底出现清亮鸡油。"
    },
    {
      "n": 2,
      "text": "下姜丝、干辣椒段与花椒炒 40 秒出香，烹入 20 毫升料酒，加 15 毫升生抽、3 克盐与 200 毫升热水，大火烧开后转中小火焖 12 分钟。",
      "time_min": 13,
      "heat": "中小火",
      "tip": "水加到没过鸡块一半即可，焖到能用筷子插入鸡腿最厚处无血水。",
      "visual_cue": "汤汁收到一半、鸡块表面挂上浅酱色，锅边有明显的醋香与辣香。"
    },
    {
      "n": 3,
      "text": "沿锅边烹入 20 毫升香醋，转大火翻动 1 分钟让酸香裹住鸡块，尝味后补 2 克盐。",
      "time_min": 3,
      "heat": "大火",
      "tip": "醋要沿热锅边淋入，高温激出的醋香才不刺鼻。",
      "visual_cue": "锅中汁水浓稠挂勺、酸味冲鼻但入口柔和。"
    },
    {
      "n": 4,
      "text": "下葱段快速翻匀 20 秒，挑出花椒与部分干辣椒，装盘即可。",
      "time_min": 1,
      "heat": "大火",
      "tip": "葱段最后下，保持翠绿与辛香，久炒会发黄发甜。",
      "visual_cue": "葱段翠绿挺立、鸡块红亮，盘底无明显流汁。"
    }
  ],
  "tips": [
    "香醋分两次放是东安子鸡的关键，先放的醋入肉去腥，后放的醋提香，一次放完只剩酸味。",
    "鸡块带骨剁制更耐焖，纯鸡胸肉易柴，不建议替换。"
  ],
  "common_mistakes": [
    "鸡块冷水下锅焯水后再炒，肉质收紧、久焖也不酥。",
    "醋在焖煮初期一次加足，长时间加热后酸味挥发，成品只剩咸辣。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋酸度柔和，用量增加 10 毫升，成品香气偏清爽。"
    },
    {
      "original": "鸡腿",
      "substitute": "整鸡",
      "ratio": "600 克带骨鸡块",
      "note": "整鸡需剁成均匀小块，焖制时间延长 5 分钟。"
    }
  ],
  "variations": [
    "家庭简化版：鸡块先煎后加 100 毫升清水焖 8 分钟，省去撇沫步骤，成品汁水略多。",
    "永州老派版：加入 10 克豆豉与 5 克辣椒粉同焖，辣味更厚重。"
  ],
  "serving_suggestion": "3 人份，配米饭；酸辣汁可拌饭，另配一碟清炒青菜平衡辣度。",
  "storage": "冷藏密封 2 天，复热时加 20 毫升水小火焖 3 分钟；不建议冷冻，鸡皮解冻后口感变渣。",
