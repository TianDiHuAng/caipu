  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉剁成四厘米见方的块，清水泡十分钟去掉血水后沥干。",
      "time_min": 14,
      "heat": "无火",
      "tip": "泡出血水再焖，汤色才清亮不发腥。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "鸡块颜色粉白，表面无明显血水"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧热，下鸡块中火煸炒到表面微黄出油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "煸到鸡皮出油，后面焖出来的汤才香。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "鸡块边缘金黄，锅底积一层鸡油"
    },
    {
      "n": 3,
      "text": "下姜片、蒜和小米辣炒香，淋料酒、生抽与冰糖翻匀上色。",
      "time_min": 5,
      "heat": "中火",
      "tip": "料酒沿锅边淋，酒气一散腥味就带走。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "鸡块均匀裹上酱色，香气浓"
    },
    {
      "n": 4,
      "text": "加清水没过鸡块，大火烧开后转小火加盖焖二十五分钟。",
      "time_min": 27,
      "heat": "小火",
      "tip": "水一次加足，中途添水会让肉发紧。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "汤汁微沸，鸡块半浸在汤中"
    },
    {
      "n": 5,
      "text": "开盖下青椒块与紫苏叶，大火收汁五分钟，加盐调味即可。",
      "time_min": 6,
      "heat": "大火",
      "tip": "紫苏最后五分钟放，香气刚好留住。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "汤汁浓稠挂鸡块，紫苏叶变深绿"
    }
  ],
  "tips": [
    "鸡块先泡血水再焖，汤才清不发腥。火候与时间都要盯紧，宁可略短也别过头。",
    "鸡皮煸出油再加水，香气厚很多。做之前把料备齐，下锅后就没空切配了。",
    "紫苏最后放，久煮香气全跑掉。这几步照顺序来，味道才会一层层叠上去。",
    "配一碗白饭，汤汁拌饭最香。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "鸡块不泡血水直接焖，汤带着腥味。结果往往一锅好料全被这一步毁掉。",
    "鸡肉没煸香就加水，汤味寡淡。很多人就在这里翻车，出菜后才发现。",
    "大火一直滚，鸡肉外面散里面柴。账面上看是小疏忽，入口立刻能尝出来。",
    "紫苏早早下锅，颜色发黑没了香气。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "半只土鸡",
      "ratio": "700克:750克",
      "note": "剁小块，焖的时间加十分钟。"
    },
    {
      "original": "紫苏",
      "substitute": "九层塔",
      "ratio": "30克:20克",
      "note": "气味更冲，用量要减。"
    }
  ],
  "variations": [
    "加一把干辣椒同焖，辣味更能压住鸡腥。",
    "加几块土豆同焖，汤汁会被吸得干香。做法不复杂，家常灶台就能完成。",
    "加一勺剁椒同焖，酸辣味更开胃。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "连砂锅端上桌，撒一把紫苏叶，鸡肉酥烂、汤汁浓香，配白饭或米酒都很合适。",
  "storage": "冷藏可放一天，复热加少量清水小火焖八分钟；鸡肉不宜反复加热。",
