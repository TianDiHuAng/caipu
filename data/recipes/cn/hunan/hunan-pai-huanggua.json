  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净，用刀面拍裂后切成三厘米长的段，装进大碗。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拍裂比刀切更挂汁，断面粗糙才入味。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "瓜段断面粗裂，汁水微渗"
    },
    {
      "n": 2,
      "text": "撒盐抓匀腌八分钟，倒掉碗底渗出的水分。趁热操作更顺手。",
      "time_min": 10,
      "heat": "无火",
      "tip": "这一步不能省，水倒掉酱汁才不会被冲淡。",
      "visual_cue": "碗底积一层清水，瓜段略软"
    },
    {
      "n": 3,
      "text": "大蒜加一点盐捣成细腻蒜泥，小米辣切圈，香菜切段。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蒜捣成泥比切末更出味，也更容易挂住。",
      "visual_cue": "蒜泥黏稠，辣圈与香菜备好"
    },
    {
      "n": 4,
      "text": "碗中加陈醋、生抽、白糖、辣椒油与香油，搅到糖化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖先化开，酸咸才会圆润不冲。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "料汁棕红透亮，表面浮一层红油"
    },
    {
      "n": 5,
      "text": "把料汁与蒜泥倒进黄瓜碗，加香菜拌匀，静置五分钟入味。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌好稍等几分钟，味道才真正吃进去。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "瓜段裹满料汁，色泽红亮"
    }
  ],
  "tips": [
    "黄瓜拍裂不切，断面才挂得住料汁。火候与时间都要盯紧，宁可略短也别过头。",
    "腌出的水一定要倒掉，不然味道发淡。做之前把料备齐，下锅后就没空切配了。",
    "蒜泥比蒜末更香，捣的时候加一点盐。这几步照顺序来，味道才会一层层叠上去。",
    "拌好冷藏十分钟，冰爽更解辣。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "黄瓜用刀切段，断面光滑不入味。结果往往一锅好料全被这一步毁掉。",
    "腌出的水没倒，拌完一盘稀汤。很多人就在这里翻车，出菜后才发现。",
    "蒜切得太粗，吃起来辛辣冲口。账面上看是小疏忽，入口立刻能尝出来。",
    "拌好立刻吃，料汁还浮在表面没进去。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "陈醋",
      "substitute": "香醋",
      "ratio": "25毫升:25毫升",
      "note": "酸味柔和一些，糖减一克。"
    },
    {
      "original": "辣椒油",
      "substitute": "剁椒",
      "ratio": "20毫升:25克",
      "note": "更湘式，盐要相应减少。"
    }
  ],
  "variations": [
    "加一把炸花生米同拌，口感更丰富。口味会更厚一些，适合重口的人。",
    "加一勺剁椒同拌，酸辣更开胃。做法不复杂，家常灶台就能完成。",
    "加几片木耳，清脆感翻倍。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装盘冷藏十分钟后上桌，瓜段冰脆、蒜香辣味齐上，是湖南人饭前最先动筷子的一碟凉菜。",
  "storage": "冷藏可放一天，吃前把料汁重新拌一下；出水后口味会变淡。",
