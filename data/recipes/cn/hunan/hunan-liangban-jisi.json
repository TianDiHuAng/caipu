  "steps": [
    {
      "n": 1,
      "text": "鸡胸肉用清水冲洗干净，撕去表面白膜，用刀背轻拍几下让厚薄均匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "拍松肉纤维，煮出来口感更嫩。",
      "visual_cue": "鸡胸肉厚薄一致，表面平整。"
    },
    {
      "n": 2,
      "text": "锅里加清水放姜片，水微沸时下鸡胸肉，保持小火煮十二分钟。",
      "time_min": 14,
      "heat": "小火",
      "tip": "水不能大滚，滚了肉就柴。",
      "visual_cue": "水面细泡不断，鸡肉浮起。"
    },
    {
      "n": 3,
      "text": "关火后让鸡胸肉在汤里再焖五分钟，捞出放凉。",
      "time_min": 7,
      "heat": "无火",
      "tip": "焖五分钟能保证中心熟透又多汁。",
      "visual_cue": "鸡肉按下去有弹性不塌。"
    },
    {
      "n": 4,
      "text": "黄瓜切成细丝，均匀铺在盘底垫上薄薄一层备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黄瓜垫底既能解辣，又能撑起鸡丝。",
      "visual_cue": "黄瓜丝细长均匀，铺平一层。"
    },
    {
      "n": 5,
      "text": "鸡胸肉顺纹理撕成细丝，撕得细一点更入味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "顺纹理撕，肉丝才不散不断。",
      "visual_cue": "鸡丝根根分明，粗细相近。"
    },
    {
      "n": 6,
      "text": "小碗里放蒜末、小米辣、生抽、米醋、白糖、盐与辣椒油调匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "调料先调匀再淋，味道才均匀。",
      "visual_cue": "料汁红亮，蒜香扑鼻。"
    },
    {
      "n": 7,
      "text": "鸡丝铺在黄瓜上，淋料汁，撒香菜与小葱花，最后点香油。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌好静置五分钟更入味，但别放太久出水。",
      "visual_cue": "鸡丝挂满红油，香菜翠绿。"
    }
  ],
  "tips": [
    "鸡胸肉煮前拍松，口感差别很明显。",
    "料汁里加一点煮鸡的汤，鲜味更足。",
    "怕辣可以把辣椒油换成剁椒，酸辣更清爽。"
  ],
  "common_mistakes": [
    "鸡胸肉大火滚煮，肉纤维收缩，撕的时候散成渣。",
    "黄瓜和鸡丝一起拌好放久，出水把料汁冲淡。"
  ],
  "substitutions": [
    {
      "original": "鸡胸肉",
      "substitute": "鸡翅",
      "ratio": "500g 对 600g",
      "note": "鸡翅版去骨撕肉，煮的时间延长五分钟。"
    }
  ],
  "variations": [
    "湘西会加一勺山胡椒油，麻香独特，是最地道的湘味凉菜。"
  ],
  "serving_suggestion": "冷藏十分钟后上桌，作开胃菜或下酒菜。",
  "storage": "冷藏一天，料汁另装，吃前再拌。",
