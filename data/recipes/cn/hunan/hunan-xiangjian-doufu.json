  "steps": [
    {
      "n": 1,
      "text": "老豆腐切成半厘米厚的三角形片，摆在盘里撒少许盐，静置十分钟出水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "先让豆腐出一次水再下锅煎，既不粘锅，也不会在热油里爆溅起来。",
      "visual_cue": "盘底积水，豆腐片挺立不软塌"
    },
    {
      "n": 2,
      "text": "用厨房纸把豆腐片两面的水分彻底吸干，一片片摆开备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "吸干这一步省不得，否则煎出来全是软皮。",
      "visual_cue": "豆腐片表面干爽不泛水光"
    },
    {
      "n": 3,
      "text": "平底锅倒菜籽油烧热，豆腐片平铺进去，中火煎到一面金黄结壳。",
      "time_min": 6,
      "heat": "中火",
      "tip": "片与片之间留点缝，挤在一起会粘成一整块。",
      "visual_cue": "底面结起金黄硬壳，边缘挺立"
    },
    {
      "n": 4,
      "text": "逐片翻面再煎三分钟，两面都成金黄后盛出沥油。",
      "time_min": 4,
      "heat": "中火",
      "tip": "用铲子加筷子一起翻，不容易把片弄断。",
      "visual_cue": "两面金黄均匀，片形完整"
    },
    {
      "n": 5,
      "text": "原锅留底油，下蒜末、小米椒与豆豉小火炒香，加生抽、白糖与两勺水烧开。",
      "time_min": 3,
      "heat": "小火",
      "tip": "加两勺水调成味汁，豆腐才挂得住咸辣味。",
      "visual_cue": "味汁微沸，油色转深红"
    },
    {
      "n": 6,
      "text": "倒回豆腐片小火焖两分钟，撒青椒碎、紫苏丝与葱段，翻匀出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "青椒最后放，断生就好，炒久了发黄失脆。",
      "visual_cue": "豆腐吸饱味汁，表面油亮"
    }
  ],
  "tips": [
    "老豆腐含水少更耐煎，嫩豆腐一煎就散。",
    "煎好的豆腐立刻吃最脆，放久回软风味大减。",
    "喜欢更辣的可以在味汁里再添一勺辣椒油，辣味会更冲一些。"
  ],
  "common_mistakes": [
    "豆腐不吸干水分就下锅，粘锅不说还油花四溅。",
    "一次下太多片，锅温骤降，煎出来是白煮豆腐。",
    "全程都用大火煎，外皮焦黑发苦了，里面却还是凉透的。"
  ],
  "substitutions": [
    {
      "original": "老豆腐",
      "substitute": "豆干",
      "ratio": "450克:300克",
      "note": "豆干更硬实，煎的时间缩短一半。"
    },
    {
      "original": "紫苏",
      "substitute": "香菜",
      "ratio": "8克:10克",
      "note": "香菜清香不同，但同样解腻。"
    }
  ],
  "variations": [
    "把豆腐换成豆泡同煎，吸汁更彻底，口感更松软。",
    "加一勺剁椒同焖，酸辣冲鼻，是湘中的吃法。"
  ],
  "serving_suggestion": "作为下饭主菜配粥也合适，冷吃当小菜别有风味。",
  "storage": "冷藏可存两天，复热须回锅小火煎一分钟，微波会令外皮回软。",
