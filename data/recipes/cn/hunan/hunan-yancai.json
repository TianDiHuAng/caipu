  "steps": [
    {
      "n": 1,
      "text": "雪里蕻择去老叶和根部，摊在通风处晾到叶子发软。",
      "time_min": 60,
      "heat": "无火",
      "tip": "晾软是为了揉搓不碎，也带走表面生水。",
      "visual_cue": "叶片蔫软，捏起不出水"
    },
    {
      "n": 2,
      "text": "晾好的雪里蕻切成一厘米长的碎段，装进大盆。",
      "time_min": 10,
      "heat": "无火",
      "tip": "切得均匀腌出来口感一致，不夹大块。",
      "visual_cue": "碎段长短一致，堆在盆里"
    },
    {
      "n": 3,
      "text": "加盐用手反复揉搓，揉到菜叶出水变成深绿色。",
      "time_min": 10,
      "heat": "无火",
      "tip": "揉出水分是腌透的关键，别只用盐拌。",
      "visual_cue": "菜叶深绿下沉，盆底见水"
    },
    {
      "n": 4,
      "text": "蒜和姜切末，与辣椒粉、白糖一起拌进菜里。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌料要抓匀，每撮菜都沾到辣椒粉。",
      "visual_cue": "菜色红绿相间，香气冲鼻"
    },
    {
      "n": 5,
      "text": "拌好的菜装进干净坛子，层层压实后淋上白酒。",
      "time_min": 8,
      "heat": "无火",
      "tip": "压得越实坛里空气越少，不容易生白花。",
      "visual_cue": "坛口菜面平整被汁浸没"
    },
    {
      "n": 6,
      "text": "坛口封紧放在阴凉处腌七天，取出即可炒食。",
      "time_min": 5,
      "heat": "无火",
      "tip": "前三天别开坛，开盖进了生水容易坏。",
      "visual_cue": "坛沿有水封，闻着带酸香"
    }
  ],
  "tips": [
    "全程手和器具都不能沾油，沾油必生白花。",
    "晾到叶子发软再揉，腌菜才脆不烂。",
    "坛子压紧要压实，坛口用水封隔绝空气防坏。"
  ],
  "common_mistakes": [
    "菜没晾就直接揉盐，出水太多腌完发烂。",
    "坛子内壁带油没洗净，几天后整坛长白毛。",
    "盐放太少，腌出来发酸发臭而不是清爽酸。"
  ],
  "substitutions": [
    {
      "original": "雪里蕻",
      "substitute": "芥菜",
      "ratio": "800 克:800 克",
      "note": "苦味略重，揉盐时多加五克。"
    },
    {
      "original": "辣椒粉",
      "substitute": "小米椒",
      "ratio": "15 克:40 克",
      "note": "辣味更鲜，切碎后同揉。"
    }
  ],
  "variations": [
    "腌好后加腊肉丁同炒，咸香下饭最地道。",
    "拌入少许剁辣椒再腌三天，辣香更冲。"
  ],
  "serving_suggestion": "腌好取出切碎，配腊肉或肉末炒香即可上桌。",
  "storage": "坛内冷藏可存一月，取用时用干净无油的筷子。",
