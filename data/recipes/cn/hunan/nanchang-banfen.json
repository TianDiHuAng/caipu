  "equipment": [
    "汤锅",
    "炒锅",
    "拌碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干米粉放入温水中浸泡二十分钟，泡到能用指甲掐断。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡到芯里没硬点，煮时才不夹生。",
      "visual_cue": "米粉发软、可轻微弯折"
    },
    {
      "n": 2,
      "text": "花生米冷油下锅，小火慢炸到噼啪声变密，捞出摊凉去皮。",
      "time_min": 6,
      "heat": "小火",
      "tip": "冷油下锅花生才酥透不焦心。",
      "visual_cue": "花生红衣转深、锅中有脆响"
    },
    {
      "n": 3,
      "text": "大蒜切末、小米辣切圈与辣椒粉放碗中，浇上烧至冒烟的植物油激香。",
      "time_min": 4,
      "heat": "无火",
      "tip": "油要分两次浇，香味才冲。",
      "visual_cue": "碗中红油翻滚、辣香扑鼻"
    },
    {
      "n": 4,
      "text": "在辣椒油碗里加生抽、老抽、香醋、白糖与盐，搅匀调成拌汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "尝一口再调整咸酸比例。",
      "visual_cue": "拌汁呈深红褐色、咸酸平衡"
    },
    {
      "n": 5,
      "text": "汤锅烧开水，下米粉煮三分钟至断生，捞出沥干水分。",
      "time_min": 5,
      "heat": "大火",
      "tip": "煮好后不要过水，拌汁才挂得住。",
      "visual_cue": "米粉柔韧、挑起不断"
    },
    {
      "n": 6,
      "text": "米粉放入拌碗，加酸菜、花生米与拌汁，撒葱花彻底拌匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热拌，米粉吸味更均匀。",
      "visual_cue": "每根米粉都染上酱色"
    }
  ],
  "tips": [
    "江西米粉耐煮，泡软后再煮不易断。",
    "酸菜要挤干水分，否则拌出来出汤。",
    "喜欢重口可以额外加一勺剁椒或辣椒酱，味道更冲。"
  ],
  "common_mistakes": [
    "米粉不泡直接煮，外面烂了里面还硬。",
    "辣椒粉用温油泼，香气完全激不出来。",
    "拌汁一次倒太多，米粉泡得发胀。"
  ],
  "substitutions": [
    {
      "original": "米粉",
      "substitute": "米线",
      "ratio": "300g 对 300g",
      "note": "米线更细，泡十分钟即可。"
    },
    {
      "original": "酸菜",
      "substitute": "雪菜",
      "ratio": "50g 对 50g",
      "note": "雪菜更咸，盐可省去一半。"
    }
  ],
  "variations": [
    "加一勺肉末酱同拌，就是南昌的肉饼拌粉。",
    "做成汤粉，加滚烫骨头汤就是另一番吃法。"
  ],
  "serving_suggestion": "一碗拌粉配一盅瓦罐汤，是南昌人标准的早餐组合。",
  "storage": "现拌现吃，冷藏后米粉会发硬，不建议隔夜。",
