  "steps": [
    {
      "n": 1,
      "text": "包菜去根，用手撕成 4cm 见方的片，撕好后用清水冲一遍甩干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "手撕断口不规则，比刀切更易挂汁。",
      "visual_cue": "菜叶边沿毛糙、水分沥干"
    },
    {
      "n": 2,
      "text": "炒锅倒 35ml 植物油烧至七成热，下干辣椒段、蒜与姜片爆香 30 秒。",
      "time_min": 1,
      "heat": "大火",
      "tip": "油要够热，辣椒一炸就出糊香。",
      "visual_cue": "辣椒变色、蒜香冲鼻"
    },
    {
      "n": 3,
      "text": "倒入包菜片大火快速翻炒 2 分钟，让每片菜叶都裹上油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火，火小了出水变炖菜。",
      "visual_cue": "菜叶边缘微焦、颜色转翠绿"
    },
    {
      "n": 4,
      "text": "加盐、生抽与白糖继续翻 1 分钟，菜叶开始变软塌。",
      "time_min": 1,
      "heat": "大火",
      "tip": "盐后放，出水少、脆度保得住。",
      "visual_cue": "菜叶微软、锅底几无汤汁"
    },
    {
      "n": 5,
      "text": "沿锅边淋 12ml 香醋，快速翻两下立即出锅装盘。",
      "time_min": 1,
      "heat": "大火",
      "tip": "醋遇高温挥发，只留香气不留酸涩。",
      "visual_cue": "醋香扑鼻、菜叶油亮脆挺"
    }
  ],
  "tips": [
    "包菜一定手撕，刀切会让菜叶发软。",
    "全程大火，锅气是这道菜的灵魂。",
    "醋最后沿锅边淋，酸香才够突出。"
  ],
  "common_mistakes": [
    "小火慢炒，包菜出一锅水变成汤菜。",
    "盐放太早，菜叶迅速出水变蔫。，成品口感会明显变差。",
    "醋一开始就倒，酸味全挥发只剩涩。"
  ],
  "substitutions": [
    {
      "original": "包菜",
      "substitute": "紫甘蓝",
      "ratio": "500g 对 500g",
      "note": "颜色更好看，炒的时间减 30 秒。"
    },
    {
      "original": "干辣椒",
      "substitute": "鲜小米辣",
      "ratio": "8g 对 15g",
      "note": "辣味更鲜，香气略淡。"
    }
  ],
  "variations": [
    "腊肉版：先炒 80g 腊肉片出油，再下包菜。",
    "蒜香版：蒜末加到 25g，出锅前再撒一把生蒜。"
  ],
  "serving_suggestion": "趁热吃最脆，配米饭或作为油腻菜的配菜。",
  "storage": "冷藏 1 天，复热用大火快炒 1 分钟。",
