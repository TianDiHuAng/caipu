  "steps": [
    {
      "n": 1,
      "text": "香干切成两毫米厚的薄片，青椒去籽切片备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "香干切薄一些，炒完才不老不硬有弹性。",
      "visual_cue": "香干片薄而匀，边缘平整"
    },
    {
      "n": 2,
      "text": "五花肉切薄片，姜切丝，蒜切片，剁椒装小碗待用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "肉片切薄一点，煸出油来才香而不腻。",
      "visual_cue": "肉片薄透，肥瘦分明"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒一半植物油，下五花肉片中小火煸到出油卷边。",
      "time_min": 3,
      "heat": "中火",
      "tip": "煸出猪油再下香干，等于用猪油炒更香。",
      "visual_cue": "肉片微卷，锅底汪着清油"
    },
    {
      "n": 4,
      "text": "下姜蒜和剁椒炒出红油和香味，再烹黄酒翻匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "剁椒炒出红油，辣味才够正不发酸。",
      "visual_cue": "锅里泛红油，辣香扑鼻"
    },
    {
      "n": 5,
      "text": "倒入香干片大火翻炒，加生抽和清水略焖入味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "香干易吸水，加一点水焖过才嫩而不柴。",
      "visual_cue": "香干片吸汁变深，锅底微干"
    },
    {
      "n": 6,
      "text": "放入青椒片同炒，加盐炒匀，青椒断生立刻出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "青椒最后下，脆度和颜色都好看。",
      "visual_cue": "青椒翠绿，香干油亮"
    }
  ],
  "tips": [
    "香干要切得薄，炒出来才不会干硬难嚼。",
    "先煸五花肉出油，等于多了猪油香。",
    "青椒最后下锅，脆度和翠绿颜色都保得住。"
  ],
  "common_mistakes": [
    "香干切得太厚，炒完咬着像一片木片。",
    "全程大火干炒不加水，香干发柴。",
    "青椒早下锅炒久，颜色发黄出水。"
  ],
  "substitutions": [
    {
      "original": "香干",
      "substitute": "豆腐干",
      "ratio": "300 克:300 克",
      "note": "质地更紧实，焖制时间延长一分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "猪里脊",
      "ratio": "120 克:120 克",
      "note": "需补十毫升植物油，否则易粘锅。"
    }
  ],
  "variations": [
    "加几根蒜苗同炒，辛香味更足更下饭。",
    "放几个小米辣圈，辣度直接升一个等级。"
  ],
  "serving_suggestion": "趁热配米饭吃，香干吸了肉油格外香。",
  "storage": "冷藏一天，复热用炒锅大火快翻，加水会让香干软塌。",
