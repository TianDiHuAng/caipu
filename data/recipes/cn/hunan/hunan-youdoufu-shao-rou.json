  "steps": [
    {
      "n": 1,
      "text": "五花肉切麻将块，冷水下锅加料酒煮三分钟去腥捞出。",
      "time_min": 6,
      "heat": "大火",
      "tip": "肉块不要切得太小，炖久了会缩成硬粒。",
      "visual_cue": "肉块表面变白，锅里浮起灰白浮沫"
    },
    {
      "n": 2,
      "text": "锅里放花生油和白糖，小火炒到糖融化变成浅褐色。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖色浅一点更稳，深了整锅都会发苦。",
      "visual_cue": "糖液呈浅琥珀色，冒出细密小泡"
    },
    {
      "n": 3,
      "text": "倒入五花肉块翻炒上色，加姜片、八角与干辣椒炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "让每块肉都裹上糖色，成菜颜色才红亮。",
      "visual_cue": "肉块表面泛红亮油光，香料味散出"
    },
    {
      "n": 4,
      "text": "淋生抽与老抽，加开水没过肉块，大火烧开转小火炖四十分钟。",
      "time_min": 43,
      "heat": "小火",
      "tip": "中途不要加冷水，汤温骤降会让肉块发紧变柴。",
      "visual_cue": "汤面轻轻冒泡，肉块浮起微颤"
    },
    {
      "n": 5,
      "text": "油豆腐用筷子在每块上戳一个小口，方便吸进汤汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "戳口比切半更好，煮的时候不容易碎。",
      "visual_cue": "每块表面有一个小孔，挤压能回弹"
    },
    {
      "n": 6,
      "text": "把油豆腐放进锅里，轻轻压实让它们浸在汤中炖十五分钟。",
      "time_min": 16,
      "heat": "小火",
      "tip": "油豆腐浮起来就轻压一下，别大力搅动。",
      "visual_cue": "油豆腐颜色变深，按下去有汤汁渗出"
    },
    {
      "n": 7,
      "text": "加盐调味，撒青蒜段，大火收汁到汤汁浓稠即可。",
      "time_min": 5,
      "heat": "大火",
      "tip": "收汁别收得太干，留一点汤汁拌饭正好。",
      "visual_cue": "汤汁红亮挂勺，青蒜鲜绿微塌"
    }
  ],
  "tips": [
    "油豆腐选厚实的，煮久了也不容易破。",
    "加一把泡发的干香菇，鲜味更上一层。",
    "隔夜再热更好吃，油豆腐吸饱了汁。",
    "不喜欢猪油可以用五花肉先煸出油。"
  ],
  "common_mistakes": [
    "油豆腐没戳口就下锅，里面还是干的。",
    "糖色炒过了头，整锅都会带一股焦苦味。",
    "收汁时大火猛翻，油豆腐被搅得七零八落。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "排骨",
      "ratio": "400克:500克",
      "note": "炖的时间加到五十分钟。"
    },
    {
      "original": "油豆腐",
      "substitute": "千张结",
      "ratio": "300克:250克",
      "note": "口感更有嚼劲，吸汁稍慢。"
    }
  ],
  "variations": [
    "加一勺豆瓣酱同烧，酱香更浓也更下饭。",
    "放几块土豆同炖，一锅就是完整一餐。"
  ],
  "serving_suggestion": "连汤汁一起盛进砂锅，撒青蒜段配白米饭上桌。",
  "storage": "冷藏可放三天，复热时加少量水小火煨透再吃。",
