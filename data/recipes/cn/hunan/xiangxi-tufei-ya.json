  "equipment": [
    "铁锅",
    "锅盖",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸭腿斩 4cm 块，冷水下锅加姜片与 20ml 料酒焯 8 分钟，撇沫后捞出冲净沥干。",
      "time_min": 15,
      "heat": "中火",
      "tip": "焯水后一定要沥干，带水下锅会溅油。",
      "visual_cue": "鸭块表面变白、血沫浮起"
    },
    {
      "n": 2,
      "text": "铁锅烧热下 60ml 植物油，放 15g 冰糖小火炒至枣红色冒小泡。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖色到枣红立即下鸭，再等就发苦。",
      "visual_cue": "糖液起密集小泡、颜色转枣红"
    },
    {
      "n": 3,
      "text": "倒入鸭块转中火翻炒 6 分钟，让每块鸭肉均匀裹上糖色并逼出鸭油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "多煸一会儿，鸭腥味随油一起走掉。",
      "visual_cue": "鸭块红亮、锅底积出清亮鸭油"
    },
    {
      "n": 4,
      "text": "下姜片、大蒜、干辣椒段与八角炒香，加 20ml 料酒、30ml 生抽、10ml 老抽。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料先炒香再加水，味道才透。",
      "visual_cue": "香气冲鼻、鸭块上色均匀"
    },
    {
      "n": 5,
      "text": "倒入 600ml 热水没过鸭块，大火烧开转小火盖盖焖 45 分钟。",
      "time_min": 48,
      "heat": "小火",
      "tip": "一定加热水，冷水会让肉质收缩变柴。",
      "visual_cue": "鸭皮呈琥珀色、汤汁剩三分之一"
    },
    {
      "n": 6,
      "text": "开盖加 5g 盐与青椒段、葱段，转大火收汁 5 分钟至汤汁裹住鸭块。",
      "time_min": 7,
      "heat": "大火",
      "tip": "青椒最后放，久煮会失去脆感和颜色。",
      "visual_cue": "汤汁浓稠挂勺、青椒翠绿"
    }
  ],
  "tips": [
    "鸭块焯水后沥干再下锅，能减少溅油也更易上色。",
    "炒糖色宁早勿晚，发黑就只能整锅重来。",
    "收汁阶段要不停翻动，糖分高容易糊底。"
  ],
  "common_mistakes": [
    "糖色炒过头变黑，整锅鸭肉带焦苦味。",
    "加水加冷水，鸭肉骤缩嚼起来又老又韧。",
    "青椒早放久炖，成品只剩一团灰绿。"
  ],
  "substitutions": [
    {
      "original": "鸭腿",
      "substitute": "半只仔鸭",
      "ratio": "800g 对 900g",
      "note": "带骨更香，焖制时间延长 10 分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "小米辣",
      "ratio": "15g 对 20g",
      "note": "辣度更直接，去籽可减辣。"
    }
  ],
  "variations": [
    "啤酒版：清水换成 600ml 啤酒，麦香去腥效果更好。",
    "血粑版：加 200g 湘西血粑同焖，是凤凰古城吃法。"
  ],
  "serving_suggestion": "连锅上桌，配米饭把汤汁浇在饭上最香。",
  "storage": "冷藏 2 天，复热时加 50ml 水小火焖 5 分钟。",
