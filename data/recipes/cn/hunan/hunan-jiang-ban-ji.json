  "steps": [
    {
      "n": 1,
      "text": "鸡腿用盐和料酒抹匀，冷藏腌三十分钟。这一步别着急。",
      "time_min": 32,
      "heat": "无火",
      "tip": "腌过肉质更紧，卤时不易散。，注意火候。",
      "visual_cue": "表面湿润，盐粒化开，状态稳定"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下姜片、桂皮和八角炒香。这一步别着急。",
      "time_min": 4,
      "heat": "小火",
      "tip": "香料温油慢炒，香味才出得透。，注意火候。",
      "visual_cue": "香气浓，姜片微卷，状态稳定"
    },
    {
      "n": 3,
      "text": "放干辣椒段和花椒，小火炒到辣椒变色。这一步别着急。",
      "time_min": 3,
      "heat": "小火",
      "tip": "辣椒一变色就停，炒糊会发苦。，注意火候。",
      "visual_cue": "辣椒暗红，花椒跳动，状态稳定"
    },
    {
      "n": 4,
      "text": "鸡腿下锅，两面各煎三分钟上色。这一步别着急。",
      "time_min": 7,
      "heat": "中火",
      "tip": "煎出鸡皮的油，卤出来才不腻。，注意火候。",
      "visual_cue": "鸡皮金黄，锅底有油，状态稳定"
    },
    {
      "n": 5,
      "text": "烹入料酒，加生抽、老抽和冰糖。这一步别着急。",
      "time_min": 3,
      "heat": "中火",
      "tip": "冰糖先化，酱色才亮。，注意火候。",
      "visual_cue": "糖化开，汁色红亮，状态稳定"
    },
    {
      "n": 6,
      "text": "倒清水没过鸡腿，大火烧开。这一步别着急。",
      "time_min": 7,
      "heat": "大火",
      "tip": "水量要够，卤的过程会收。，注意火候。",
      "visual_cue": "汤面翻滚，浮沫聚边，状态稳定"
    },
    {
      "n": 7,
      "text": "转小火卤四十五分钟，中途翻一次面。这一步别着急。",
      "time_min": 47,
      "heat": "小火",
      "tip": "小火卤，肉才嫩不柴。，注意火候。",
      "visual_cue": "鸡腿变软，汤汁减半，状态稳定"
    },
    {
      "n": 8,
      "text": "关火浸泡二十分钟，让味道进到骨边。这一步别着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡比煮更入味，别省这一步。，注意火候。",
      "visual_cue": "色泽深红，皮面油亮，状态稳定"
    },
    {
      "n": 9,
      "text": "取出晾凉斩块，淋一勺卤汁。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "凉一点再斩，块才不散。，注意火候。",
      "visual_cue": "块形整齐，卤汁亮泽"
    }
  ],
  "tips": [
    "辣椒和花椒小火炒，糊了整锅发苦。，值得留意。",
    "关火后泡二十分钟，味道才进骨。，值得留意。",
    "晾凉再斩块，切面才整齐。，值得留意。"
  ],
  "common_mistakes": [
    "大火卤煮，鸡肉发柴。，值得留意。",
    "辣椒炒糊，卤汁带苦味。，值得留意。",
    "卤完立刻斩，肉全散开。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "鸭腿",
      "ratio": "800 克:800 克",
      "note": "更接近酱板鸭风味，卤的时间加十分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "辣椒粉",
      "ratio": "20 克:12 克",
      "note": "辣味更直接，注意别炒糊。"
    }
  ],
  "variations": [
    "卤好后用烤箱一百八十度烤八分钟，皮更干香。",
    "加一勺豆瓣酱，酱香更厚。，值得留意。"
  ],
  "serving_suggestion": "冷切装盘，配啤酒或米饭。，效果更稳定。",
  "storage": "冷藏三天，冷冻两周；复热蒸十分钟。，效果更稳定。",
