  "steps": [
    {
      "n": 1,
      "text": "鸡腿去骨切成两厘米小块，带皮一起切，皮朝上放不易滑刀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "带皮炒出来更香，皮里的油能润锅。",
      "visual_cue": "鸡块大小均匀，皮完整"
    },
    {
      "n": 2,
      "text": "鸡块加生抽和黄酒抓匀，腌到表面挂汁不流水。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌十分钟就够，时间久了鸡肉会发紧变柴。",
      "visual_cue": "鸡块挂汁发亮，碗底无积水"
    },
    {
      "n": 3,
      "text": "青椒斜切成段，姜蒜切片拍碎，干辣椒剪成小段备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "辣椒籽留着更辣，怕辣可以抖掉。",
      "visual_cue": "辣椒段整齐，青椒翠绿"
    },
    {
      "n": 4,
      "text": "炒锅烧热倒植物油，下鸡块中火煸炒到表皮收紧出油。",
      "time_min": 7,
      "heat": "中火",
      "tip": "鸡块先煸出油，成菜才不腻不腥。",
      "visual_cue": "鸡皮金黄卷缩，锅底有清油"
    },
    {
      "n": 5,
      "text": "下姜蒜、花椒和干辣椒段炒出香辣味，沿锅边烹入黄酒。",
      "time_min": 2,
      "heat": "中火",
      "tip": "香料别炒到发黑，糊了整锅菜都带苦味。",
      "visual_cue": "闻到辣香，油色转红"
    },
    {
      "n": 6,
      "text": "转大火下青椒段快速翻炒，加盐和白糖炒匀。",
      "time_min": 3,
      "heat": "大火",
      "tip": "青椒断生就好，炒软了没有脆感。",
      "visual_cue": "青椒表皮起泡，色仍翠绿"
    },
    {
      "n": 7,
      "text": "撒葱段再翻两下立刻关火，趁热装盘端上桌。",
      "time_min": 1,
      "heat": "大火",
      "tip": "关火后再翻两下，用余温把葱香激出来。",
      "visual_cue": "鸡块油亮，辣椒青翠分明"
    }
  ],
  "tips": [
    "鸡块带皮先煸出油，成菜才香不腻。",
    "干辣椒小火炒香，别炒到发黑发苦。",
    "青椒最后大火快炒，保持脆感和颜色。"
  ],
  "common_mistakes": [
    "鸡块切太大，外面焦了里面还没熟。",
    "辣椒炒糊再下鸡块，整盘带苦味。",
    "青椒下锅久炒出水，整盘菜变得水汪汪。"
  ],
  "substitutions": [
    {
      "original": "鸡腿",
      "substitute": "仔鸡",
      "ratio": "600 克:700 克",
      "note": "剁小块带骨炒，风味更足需多炒三分钟。"
    },
    {
      "original": "青椒",
      "substitute": "螺丝椒",
      "ratio": "150 克:150 克",
      "note": "辣度更高，干辣椒可减半。"
    }
  ],
  "variations": [
    "加一勺剁椒同炒，湘味更冲也更下饭。",
    "起锅前淋少许香醋，解腻又提鲜增香。"
  ],
  "serving_suggestion": "配一大碗白米饭最合适，辣味正好下饭。",
  "storage": "冷藏一天，复热用炒锅快炒，微波会让鸡肉发柴。",
