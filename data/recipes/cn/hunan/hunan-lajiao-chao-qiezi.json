  "steps": [
    {
      "n": 1,
      "text": "茄子去蒂切成手指粗的条，泡进淡盐水里抓一抓再沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐水抓过茄子不易吸油，颜色也白净。",
      "visual_cue": "茄条淡白，用手一攥略出水"
    },
    {
      "n": 2,
      "text": "青椒去籽切斜片，蒜拍碎切末，豆豉剁碎备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "豆豉剁碎香味才出得来，整粒不易出味。",
      "visual_cue": "配料备齐，豆豉成细粒"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，茄条下锅中火煸炒到表面微软。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油热再下锅，茄子才不吸油成海绵。",
      "visual_cue": "茄条变软出汁，边缘微焦"
    },
    {
      "n": 4,
      "text": "把茄子拨到锅边，下蒜末和豆豉炒出浓浓香味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "配料在油里炒过，酱香才够浓够透。",
      "visual_cue": "蒜末泛黄，豆豉香气冲鼻"
    },
    {
      "n": 5,
      "text": "加青椒片和茄条一起翻炒，沿锅边淋入生抽。",
      "time_min": 1,
      "heat": "大火",
      "tip": "生抽沿锅边淋，香味比直接倒更足。",
      "visual_cue": "青椒翠绿，茄条油亮"
    },
    {
      "n": 6,
      "text": "加清水略焖到茄子软透，放盐和白糖翻匀收汁出锅。",
      "time_min": 3,
      "heat": "中火",
      "tip": "少加水焖一下，茄子才软糯入味。",
      "visual_cue": "汤汁收干，茄条软而不烂"
    }
  ],
  "tips": [
    "茄子用盐水抓过，下锅不吸油也不发黑。",
    "油要烧热再下茄条，油温低就成海绵。",
    "豆豉剁碎再炒，酱香味才透得出来。"
  ],
  "common_mistakes": [
    "茄子不处理直接下锅，一盘能吸半瓶油。",
    "青椒和茄子同下锅，青椒炒黄茄子还硬。",
    "盐放太早，茄子出水后越炒越稀。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "长茄子",
      "ratio": "450 克:450 克",
      "note": "肉质更嫩，焖制时间缩短一分钟。"
    },
    {
      "original": "豆豉",
      "substitute": "豆瓣酱",
      "ratio": "10 克:15 克",
      "note": "咸度更高，盐需减少两克。"
    }
  ],
  "variations": [
    "加几片五花肉同炒，油香更足更好吃。",
    "起锅前淋几滴香醋，解腻又提味。"
  ],
  "serving_suggestion": "热吃最下饭，凉了会略出油，宜现炒现吃。",
  "storage": "冷藏一天，复热用炒锅大火快翻，别加水久煮。",
