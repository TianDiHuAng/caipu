          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "排骨斩成小块，用清水浸泡二十分钟泡出血水，中途换两次水。",
      "time_min": 22,
      "heat": "无火",
      "tip": "泡出血水，汤才清不腥，这一步比焯水更管用。",
      "visual_cue": "排骨发白，水色转淡红"
    },
    {
      "n": 2,
      "text": "泡好的排骨冷水下锅，加姜片与米酒，大火煮开撇净浮沫后捞出冲洗。",
      "time_min": 10,
      "heat": "大火",
      "tip": "浮沫一定要撇得干干净净，粘在肉块上会带出一股腥味。",
      "visual_cue": "水面浮起灰白沫，排骨收紧发白"
    },
    {
      "n": 3,
      "text": "苦瓜对半剖开刮净白瓤，切成长四厘米的段，用盐抓匀腌五分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "白瓤刮净苦味才不压汤，腌过再煮更柔。",
      "visual_cue": "瓜段变软出水，内壁青绿"
    },
    {
      "n": 4,
      "text": "汤锅加足量清水，放排骨与姜片、豆豉，大火烧开后转小火炖一小时。",
      "time_min": 62,
      "heat": "小火",
      "tip": "水要一次加足，中途再添水会把汤的味道冲淡、汤色也变浑。",
      "visual_cue": "汤面微沸不起大浪，排骨酥软"
    },
    {
      "n": 5,
      "text": "下苦瓜段继续炖二十分钟，至苦瓜透明软而不烂。",
      "time_min": 21,
      "heat": "小火",
      "tip": "苦瓜后放，久炖会化在汤里，只剩苦味没口感。",
      "visual_cue": "瓜段由绿转黄绿，断面透明"
    },
    {
      "n": 6,
      "text": "加盐与白胡椒调味，撒葱花，关火静置三分钟再盛出。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐要最后再放，放早了排骨不容易炖软，汤味也发紧。",
      "visual_cue": "汤色清亮微黄，表面浮少许油花"
    }
  ],
  "tips": [
    "排骨选肋排，肉厚骨小，炖出来汤更鲜。",
    "怕苦可把苦瓜先焯十秒再下锅，苦味能减一半。",
    "汤炖好后撇一次浮油，喝起来更清爽。"
  ],
  "common_mistakes": [
    "排骨不泡不焯直接炖，汤浑发腥，一股猪味。",
    "苦瓜和排骨同时下锅，炖到最后全化在汤里。",
    "中途加冷水，肉质骤缩发柴，汤味也散了。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "猪骨",
      "ratio": "500克:600克",
      "note": "猪骨汤更浓，炖的时间延长二十分钟。"
    },
    {
      "original": "苦瓜",
      "substitute": "冬瓜",
      "ratio": "350克:400克",
      "note": "冬瓜不苦，汤更清甜，炖的时间减五分钟。"
    }
  ],
  "variations": [
    "加一把黄豆同炖，汤更浓，湖南乡下常这样煲。",
    "加几粒蜜枣同炖，回甘明显，适合怕苦的人。"
  ],
  "serving_suggestion": "饭前一碗开胃，夏天喝最清火，也可作为汤菜配饭。",
  "storage": "冷藏可存两天，复热须小火加热至沸腾，撇去表面浮油。",
