  "steps": [
    {
      "n": 1,
      "text": "鸡蛋磕入碗中，加两克盐与一勺清水，用筷子充分打散。",
      "time_min": 6,
      "heat": "无火",
      "tip": "加一勺水蛋液更嫩，炒出来蓬松不干。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "蛋液颜色均匀，表面浮细泡"
    },
    {
      "n": 2,
      "text": "青椒去籽切小段，小米辣切圈，大蒜切末，小葱切段备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "青椒切小一点，才能和蛋块一起入口。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "配料颗粒均匀，青椒断面平整"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒三十毫升植物油，倒蛋液，中火煎到半凝固再划散盛出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "蛋液半凝固就划散，蛋块才嫩不发硬。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "蛋块蓬松金黄，内部仍带湿润"
    },
    {
      "n": 4,
      "text": "锅留底油下豆豉、蒜末与小米辣炒香，再下青椒大火炒一分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "豆豉先炒出香，整盘菜的底味就立住了。",
      "visual_cue": "豆豉香气散开，青椒边缘起虎皮"
    },
    {
      "n": 5,
      "text": "倒回蛋块，加生抽与盐，撒葱段大火翻炒三十秒出锅。",
      "time_min": 3,
      "heat": "大火",
      "tip": "蛋块回锅只翻两下，久炒会变老出水。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "蛋块裹上酱色，葱段翠绿"
    }
  ],
  "tips": [
    "蛋液加一勺水，炒出来更嫩更蓬松。火候与时间都要盯紧，宁可略短也别过头。",
    "豆豉是底味，别省，也别放太多。做之前把料备齐，下锅后就没空切配了。",
    "青椒大火快炒才香，小火会出水。这几步照顺序来，味道才会一层层叠上去。",
    "蛋块回锅后快翻快出，别恋锅。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "蛋液没打散就下锅，蛋白蛋黄分层。结果往往一锅好料全被这一步毁掉。",
    "鸡蛋煎到全干才划散，口感发硬。很多人就在这里翻车，出菜后才发现。",
    "青椒小火慢炒，出水发黄没了香气。账面上看是小疏忽，入口立刻能尝出来。",
    "盐在蛋液和菜里都重放，整体过咸。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "螺丝椒",
      "ratio": "150克:150克",
      "note": "辣香更冲，用量可减二十克。"
    },
    {
      "original": "豆豉",
      "substitute": "剁椒",
      "ratio": "15克:20克",
      "note": "酸辣路线，盐要减一克。"
    }
  ],
  "variations": [
    "加一把酸豆角同炒，酸辣更下饭。口味会更厚一些，适合重口的人。",
    "把鸡蛋换成鸭蛋，蛋香更浓。做法不复杂，家常灶台就能完成。",
    "加一勺辣椒油起锅前拌匀，湘味更足。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "趁热装盘，蛋块金黄、青椒翠绿、豆豉香在里头，配白粥或白饭都是湖南人的家常早饭。",
  "storage": "冷藏可放一天，复热用炒锅小火翻热两分钟，不建议微波以免蛋块变硬。",
