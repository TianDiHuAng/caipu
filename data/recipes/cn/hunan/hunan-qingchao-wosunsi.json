  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "莴笋削去外皮与粗纤维，先切薄片再改刀成均匀细丝。",
      "time_min": 12,
      "heat": "无火",
      "tip": "外皮和白色粗筋要去干净，否则口感发老。",
      "visual_cue": "笋丝翠绿透亮，粗细接近"
    },
    {
      "n": 2,
      "text": "切好的笋丝加两克盐抓匀，静置五分钟挤掉多余水分。",
      "time_min": 7,
      "heat": "无火",
      "tip": "挤水后下锅不出汤，炒出来才脆爽。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "笋丝变软一点，碗底积少量水"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，下蒜末与小米辣小火炒出香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "蒜末别炒黄，闻到香就够了，炒黄会发苦。",
      "visual_cue": "蒜末微黄，油面浮着细小气泡"
    },
    {
      "n": 4,
      "text": "转大火下笋丝快速翻炒两分钟，加盐、生抽与白胡椒粉炒匀。",
      "time_min": 4,
      "heat": "大火",
      "tip": "全程大火快炒，笋丝才脆不出水。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "笋丝颜色更绿，锅底几乎无汤"
    },
    {
      "n": 5,
      "text": "撒入葱段翻炒十秒，闻到葱香立刻出锅装盘。趁热操作更顺手。",
      "time_min": 1,
      "heat": "大火",
      "tip": "葱段最后放，翻两下就够，久炒发黄。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "葱段翠绿，笋丝油亮清爽"
    }
  ],
  "tips": [
    "莴笋丝一定要挤水，炒出来才脆。火候与时间都要盯紧，宁可略短也别过头。",
    "大火快炒，时间越短越有脆感。做之前把料备齐，下锅后就没空切配了。",
    "小米辣只是提香，不吃辣可以省掉。这几步照顺序来，味道才会一层层叠上去。",
    "笋叶别扔，焯水凉拌也很清口。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "笋丝切得太粗，炒不熟还带生味。结果往往一锅好料全被这一步毁掉。",
    "没挤水就下锅，炒出一锅菜汤。很多人就在这里翻车，出菜后才发现。",
    "小火慢炒，笋丝发黄变软没了脆劲。账面上看是小疏忽，入口立刻能尝出来。",
    "盐放太早，笋丝出水变蔫。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "莴笋",
      "substitute": "青笋",
      "ratio": "600克:600克",
      "note": "同一种菜，口感一致。"
    },
    {
      "original": "小米辣",
      "substitute": "干辣椒",
      "ratio": "8克:5克",
      "note": "香气更沉，辣度略降。"
    }
  ],
  "variations": [
    "加一把炒香的虾皮，鲜味更足。口味会更厚一些，适合重口的人。",
    "加几片腊肉同炒，湘味更浓。做法不复杂，家常灶台就能完成。",
    "起锅前滴几滴香油，清香更明显。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装盘后趁热吃，笋丝脆嫩爽口，配重口味的红烧菜正好解腻，是湖南家常桌上最常见的清口菜。",
  "storage": "冷藏可放一天，复热用大火快炒四十秒，久热会失去脆感。",
