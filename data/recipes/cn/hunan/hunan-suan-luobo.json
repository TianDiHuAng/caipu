  "equipment": [
    "密封罐",
    "汤锅",
    "菜刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白萝卜洗净带皮切成 0.5 厘米厚片，加 5g 盐抓匀静置 1 小时杀出水分。",
      "time_min": 60,
      "heat": "无火",
      "tip": "盐杀过水，萝卜才脆不软。",
      "visual_cue": "萝卜片出水变软、盆底积一层水"
    },
    {
      "n": 2,
      "text": "把萝卜片挤干水分，摊开晾 30 分钟让表面收干。",
      "time_min": 30,
      "heat": "无火",
      "tip": "表面干爽，泡汁才不会发浑。",
      "visual_cue": "萝卜片边缘略微发皱"
    },
    {
      "n": 3,
      "text": "汤锅加 300ml 清水、150ml 米醋、40g 白糖与 3g 盐煮开，放凉备用。",
      "time_min": 8,
      "heat": "中火",
      "tip": "泡汁必须完全放凉，热汁会把萝卜烫软。",
      "visual_cue": "糖盐完全化开、液体清亮"
    },
    {
      "n": 4,
      "text": "密封罐用开水烫过晾干，铺一层萝卜片放几段干辣椒与姜片，逐层码满。",
      "time_min": 5,
      "heat": "无火",
      "tip": "层层铺料，辣味分布才均匀。",
      "visual_cue": "萝卜片码放紧实、罐内无空隙"
    },
    {
      "n": 5,
      "text": "倒入放凉的泡汁没过萝卜，盖紧盖子冷藏 3 小时即可食用。",
      "time_min": 180,
      "heat": "无火",
      "tip": "冷藏泡足 3 小时，酸辣味才透。",
      "visual_cue": "萝卜片透亮、汁水微红"
    }
  ],
  "tips": [
    "萝卜一定带皮泡，皮是脆爽口感的关键所在。",
    "泡汁一定放凉再倒，热汁会让萝卜发软。",
    "容器必须无油无水，否则很快起白沫。"
  ],
  "common_mistakes": [
    "萝卜不杀水直接泡，出水稀释泡汁变淡。",
    "用热泡汁浇萝卜，成品软塌不脆。",
    "取用时用带油的筷子，几天就长霉。"
  ],
  "substitutions": [
    {
      "original": "白萝卜",
      "substitute": "青萝卜",
      "ratio": "600g 对 600g",
      "note": "辣味更冲，白糖加 10g。"
    },
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "150ml 对 140ml",
      "note": "白醋酸味更尖，糖略加。"
    }
  ],
  "variations": [
    "酸甜版：白糖增至 80g，做成糖醋萝卜。",
    "加蒜版：每层夹两瓣大蒜，风味更足。"
  ],
  "serving_suggestion": "切薄片上桌，配粥、配米粉或当作油腻菜的解腻小菜。",
  "storage": "冷藏可存 7 天，取用时用干净无油的筷子夹取。",
