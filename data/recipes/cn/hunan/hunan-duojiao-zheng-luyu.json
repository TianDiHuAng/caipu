    "鱼盘",
    "菜刀",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼两面各划三刀，用料酒和盐里外抹匀，鱼腹里塞姜片腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "划刀让热气进得去，鱼身厚的地方才不会夹生。",
      "visual_cue": "鱼身划口整齐，表面微湿，锅面和食材状态一目了然"
    },
    {
      "n": 2,
      "text": "腌好的鱼冲洗一遍，用厨房纸吸干水分，摆在鱼盘中央，底下垫两根姜丝。",
      "time_min": 4,
      "heat": "无火",
      "tip": "垫姜丝让底部透气，鱼身受热均匀还去腥，这一点影响成品口感。",
      "visual_cue": "鱼身干爽，架空摆稳，颜色与质地变化清楚可见"
    },
    {
      "n": 3,
      "text": "剁辣椒和蒜末、豆豉拌在一起，均匀铺满鱼身，边缘留出葱白位置。",
      "time_min": 4,
      "heat": "无火",
      "tip": "剁椒要铺平压实，蒸出来味道才进得去，这一点影响成品口感。",
      "visual_cue": "鱼身铺满剁辣椒，颜色鲜亮，香气和声音能说明进度"
    },
    {
      "n": 4,
      "text": "蒸锅加水大火烧到上汽，把鱼盘放进蒸屉，盖盖大火蒸八分钟。",
      "time_min": 11,
      "heat": "大火",
      "tip": "一定要水开上汽再放鱼，冷锅蒸鱼肉会发柴。",
      "visual_cue": "锅内蒸汽充足，盖子密合，整体火候状态清楚好判断"
    },
    {
      "n": 5,
      "text": "关火后焖两分钟再开盖，倒掉盘底积的腥水，撒上葱花和姜丝。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盘底水一定倒掉，留着会让整条鱼发腥，这一点影响成品口感。",
      "visual_cue": "盘底清空，葱花翠绿，表面变化看得出来已到位"
    },
    {
      "n": 6,
      "text": "小锅把植物油烧到微微冒烟，趁热浇在葱花和剁椒上，淋一圈蒸鱼豉油即可。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油必须烧到冒烟再浇，激不出香就白做了，这一点影响成品口感。",
      "visual_cue": "油花四溅，香气冲鼻，汤汁和食材状态清楚到位"
    }
  ],
  "tips": [
    "鲈鱼要选活的或冰鲜的，鱼眼清亮、按下去有弹性，蒸出来才鲜。",
    "蒸之前必须水开上汽，冷水上锅鱼肉慢慢受热，口感发柴还出水。",
    "蒸的时间按鱼的大小算，一斤左右的鱼八分钟正好，久了肉就散。",
    "盘底积的汁水是最腥的部分，蒸完一定倒掉，再浇热油调味。"
  ],
  "common_mistakes": [
    "鱼没吸干水就上锅蒸，盘里一汪水，鱼肉泡得发白发柴。",
    "蒸过头了才关火，鱼肉从骨架上脱落，一筷子夹起来全是碎块。",
    "热油没烧到冒烟就浇，葱花只有生味，剁椒的香气也没激出来。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "草鱼",
      "ratio": "600克:600克",
      "note": "草鱼刺多，蒸的时间加两分钟。"
    },
    {
      "original": "剁辣椒",
      "substitute": "泡椒",
      "ratio": "60克:60克",
      "note": "泡椒偏酸，可减少蒸鱼豉油的用量。"
    }
  ],
  "variations": [
    "把鲈鱼换成鱼头对半剖开，做成剁椒鱼头，蒸的时间加到十二分钟。",
    "铺料时加一勺腊八豆同蒸，湖南风味的发酵香更足，配米饭很下饭。"
  ],
  "serving_suggestion": "整条鱼连盘上桌，剁辣椒铺满鱼身，趁热用勺子把汁浇在米饭上，鲜辣开胃。",
  "storage": "冷藏可放一天，回热用蒸锅蒸五分钟，不要微波否则鱼肉变硬发柴。",
