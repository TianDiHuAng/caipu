        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "深盘",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "腊肉与腊肠用温水刷洗表面烟尘，腊鱼用清水泡 30 分钟去掉部分盐分。",
      "time_min": 32,
      "heat": "无火",
      "tip": "腊味表面烟灰必须刷净，否则发苦。",
      "visual_cue": "腊味表面光洁、泡鱼水色变黄"
    },
    {
      "n": 2,
      "text": "腊肉切 0.3cm 薄片，腊肠斜切厚片，腊鱼斩成 4cm 见方的块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致才同时蒸透。",
      "visual_cue": "片形整齐、肥瘦分明"
    },
    {
      "n": 3,
      "text": "三种腊味在深盘中码成三排，皮朝下整齐叠放，缝隙处撒姜丝与豆豉。",
      "time_min": 4,
      "heat": "无火",
      "tip": "皮朝下蒸，油脂渗出润泽整盘。",
      "visual_cue": "盘面铺满、层次分明"
    },
    {
      "n": 4,
      "text": "淋 20ml 料酒、撒 5g 白糖与干辣椒段，封保鲜膜防止水汽滴入。",
      "time_min": 3,
      "heat": "无火",
      "tip": "封膜能保住腊味本身的香气。",
      "visual_cue": "盘口封严、不见缝隙"
    },
    {
      "n": 5,
      "text": "蒸锅上汽后放入深盘，中火蒸 40 分钟至腊肉透明、腊鱼酥软。",
      "time_min": 42,
      "heat": "中火",
      "tip": "中途不揭盖，蒸汽一散就蒸不透。",
      "visual_cue": "腊肉呈半透明、油脂汪在盘底"
    },
    {
      "n": 6,
      "text": "取出淋 15ml 辣椒油，撒小葱花即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热淋油，辣香被油脂带出来。",
      "visual_cue": "油光红亮、葱花点缀其上"
    }
  ],
  "tips": [
    "腊鱼提前泡水，咸度才不压其他腊味。",
    "全程用蒸不用煮，腊味香气才不流失。",
    "盘底渗出的油汁别倒，拌饭最香。"
  ],
  "common_mistakes": [
    "腊味不洗直接蒸，烟尘味混进菜里。",
    "切得太厚，中间咸硬外围发干。，成品口感会明显变差。",
    "蒸的时间不足，腊肉嚼不动、腊鱼带腥。"
  ],
  "substitutions": [
    {
      "original": "腊鱼",
      "substitute": "腊鸡",
      "ratio": "200g 对 200g",
      "note": "肉质更紧，蒸的时间加 10 分钟。"
    },
    {
      "original": "腊肠",
      "substitute": "香肠",
      "ratio": "150g 对 150g",
      "note": "甜味更重，白糖可省。"
    }
  ],
  "variations": [
    "扣肉版：底部垫 100g 干豆角同蒸，吸油更下饭。",
    "辣味版：加 20g 剁椒同蒸，湘味更浓。"
  ],
  "serving_suggestion": "趁热上桌，配白饭或馒头夹着吃。",
  "storage": "冷藏 3 天，冷冻 2 周；复热蒸 10 分钟。",
