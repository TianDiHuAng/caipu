          "name_en": "cooking wine",
          "amount": 20,
          "unit": "ml",
          "note": "去咸腥",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "中和咸味",
          "optional": false
        },
        {
          "name": "辣椒油",
          "name_en": "chili oil",
          "amount": 15,
          "unit": "ml",
