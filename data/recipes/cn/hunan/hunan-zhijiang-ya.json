  "steps": [
    {
      "n": 1,
      "text": "鸭斩成三厘米见方的块，用清水泡二十分钟泡出血水。",
      "time_min": 20,
      "heat": "无火",
      "tip": "鸭肉腥味重，泡水比焯水更能保嫩。",
      "visual_cue": "水色变红，鸭块发白。"
    },
    {
      "n": 2,
      "text": "鸭块冷水下锅，加几片姜与料酒煮开，撇去浮沫后捞出冲净。",
      "time_min": 12,
      "heat": "大火",
      "tip": "浮沫要撇干净，汤才不腥。",
      "visual_cue": "水面浮起灰色泡沫。"
    },
    {
      "n": 3,
      "text": "锅里倒花生油，下姜片、八角与干辣椒小火煸香。",
      "time_min": 5,
      "heat": "小火",
      "tip": "香料先煸，油里带香再下鸭。",
      "visual_cue": "姜片边缘卷起，香味散出。"
    },
    {
      "n": 4,
      "text": "倒入鸭块转大火翻炒，炒到鸭皮出油、表面微黄。",
      "time_min": 12,
      "heat": "大火",
      "tip": "鸭皮炒出油，成菜才不腻。",
      "visual_cue": "鸭块表面金黄，锅里有清油。"
    },
    {
      "n": 5,
      "text": "烹入米酒，加生抽、老抽与冰糖翻匀，倒热水没过鸭块。",
      "time_min": 8,
      "heat": "大火",
      "tip": "一定加热水，冷水会让鸭肉紧缩。",
      "visual_cue": "鸭块金黄，酱汁红亮"
    },
    {
      "n": 6,
      "text": "大火煮开转小火炖四十分钟，炖到鸭肉用筷子能戳透。",
      "time_min": 42,
      "heat": "小火",
      "tip": "小火慢炖，鸭肉才酥而不烂。",
      "visual_cue": "鸭肉松软，汤汁收到一半。"
    },
    {
      "n": 7,
      "text": "放青椒段与紫苏，转大火收汁，加盐调味后撒葱结出锅。",
      "time_min": 10,
      "heat": "大火",
      "tip": "紫苏最后放，香气才不散。",
      "visual_cue": "汤汁浓稠裹住鸭块。"
    }
  ],
  "tips": [
    "芷江鸭用的是当地麻鸭，肉质紧实，炖的时间要足。",
    "紫苏是这道菜的灵魂，没有它就少了湘西的味道。",
    "米酒要用糯米酿的，甜香比料酒更合适。"
  ],
  "common_mistakes": [
    "鸭块不泡血水直接炖，腥味压不住。",
    "收汁时火太大又不翻动，锅底焦糊发苦。"
  ],
  "substitutions": [
    {
      "original": "鸭",
      "substitute": "鸭腿",
      "ratio": "1500g 对 1200g",
      "note": "鸭腿肉厚，炖的时间延长十分钟。"
    }
  ],
  "variations": [
    "怀化本地会加一把酸萝卜同炖，酸香解腻，汤汁更开胃。"
  ],
  "serving_suggestion": "连汤汁一起上桌，配米饭，剩下的汤可以拌面。",
  "storage": "冷藏三天，复热时加少量热水，紫苏可另撒新鲜的。",
