  "equipment": [
    "蒸锅",
    "小碗",
    "砧板",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "皮蛋剥壳后用清水冲净表面碎壳，用厨房纸吸干水分。",
      "time_min": 5,
      "heat": "无火",
      "tip": "剥前在手心滚一圈，壳更容易整片脱落。",
      "visual_cue": "蛋体完整光滑，表面呈深墨绿色"
    },
    {
      "n": 2,
      "text": "每只皮蛋切成四瓣，刀口蘸点水切才不会粘刀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "切前把刀过一遍冷水，切面干净不糊。",
      "visual_cue": "切面平整，蛋心呈半流心的墨绿"
    },
    {
      "n": 3,
      "text": "把皮蛋瓣按放射状摆进浅盘里，切面朝上铺开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "摆得松散一些，蒸的时候受热才均匀。",
      "visual_cue": "蛋瓣围成花形，中间留出空位"
    },
    {
      "n": 4,
      "text": "剁椒拌入蒜末、生抽与白糖，调匀后浇在皮蛋上。",
      "time_min": 3,
      "heat": "无火",
      "tip": "剁椒本身有咸味，生抽只用来提味不压盐。",
      "visual_cue": "酱料红亮，均匀盖住每瓣蛋"
    },
    {
      "n": 5,
      "text": "整盘放进上汽的蒸锅，中火蒸六分钟让味道融合。",
      "time_min": 8,
      "heat": "中火",
      "tip": "蒸到刚透就好，久蒸蛋心会完全化开。",
      "visual_cue": "盘中渗出红亮汤汁，辣香直冒"
    },
    {
      "n": 6,
      "text": "取出以后淋上芝麻油，撒一把葱花就可以上桌了。",
      "time_min": 2,
      "heat": "无火",
      "tip": "出锅以后再淋油，香气才够鲜亮不闷。",
      "visual_cue": "油光在蛋面滑动，葱花翠绿点缀"
    }
  ],
  "tips": [
    "蒸比凉拌更入味，怕凉伤胃的人也适合。",
    "加一勺蒸鱼豉油，鲜味会更厚一些。",
    "不吃辣的话可以把剁椒换成蒜蓉酱。",
    "皮蛋配白粥是湖南最常见的早饭组合。"
  ],
  "common_mistakes": [
    "皮蛋切得太碎，摆盘散乱还容易出水。",
    "蒸的时间太长，蛋心化成糊失去口感。",
    "剁椒本身有盐还另加盐，整盘咸得下不了口。"
  ],
  "substitutions": [
    {
      "original": "皮蛋",
      "substitute": "咸蛋黄",
      "ratio": "240克:240克",
      "note": "咸度更高，生抽要减半。"
    },
    {
      "original": "剁椒",
      "substitute": "泡椒",
      "ratio": "60克:60克",
      "note": "辣度相近，酸味更清亮。"
    }
  ],
  "variations": [
    "加一勺豆豉一起蒸，发酵的香气会更浓。",
    "表面撒一点辣椒粉再浇热油，香气更冲。"
  ],
  "serving_suggestion": "当作冷盘或下酒小菜，配白粥与米饭都很合适。",
  "storage": "冷藏后一天内吃完，复蒸时需要重新调一次味。",
