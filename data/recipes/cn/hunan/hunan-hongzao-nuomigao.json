    "碗",
    "蒸屉",
    "刀",
    "砧板",
    "刮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红枣用温水泡二十分钟至发软，捞出沥干，逐个剖开去掉枣核。",
      "time_min": 25,
      "heat": "无火",
      "tip": "枣核不去会硌牙，泡软后枣肉也更好压。",
      "visual_cue": "红枣胀大回软，枣肉能轻易撕开"
    },
    {
      "n": 2,
      "text": "糯米粉过筛进盆里，加白糖拌匀，再分三次倒入清水搅成絮状。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水分次加，面团才不会一下和得太湿。",
      "visual_cue": "粉里出现均匀的雪花絮片"
    },
    {
      "n": 3,
      "text": "把絮状面团揉成光滑不粘手的面团，盖上湿布静置十五分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "静置让粉充分吸水，蒸出来才不夹生。",
      "visual_cue": "面团光滑有弹性，按压回弹"
    },
    {
      "n": 4,
      "text": "蒸屉铺一层湿纱布并刷一层花生油，面团擀成两厘米厚的方片铺进去。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刷油防粘，蒸好整块才好完整揭下来。",
      "visual_cue": "面片厚薄一致，边缘齐整"
    },
    {
      "n": 5,
      "text": "枣肉切成两半，均匀按进面片表面，撒上白芝麻，水开后大火蒸二十分钟。",
      "time_min": 23,
      "heat": "大火",
      "tip": "枣肉按进去一点，蒸完才不会浮起来。",
      "visual_cue": "表面枣肉嵌进面里，颜色深红"
    },
    {
      "n": 6,
      "text": "关火焖三分钟再开盖，取出晾十分钟，切成方块装盘。",
      "time_min": 12,
      "heat": "无火",
      "tip": "焖三分钟再开盖，糕体不塌也不回缩。",
      "visual_cue": "切面细腻无干粉，枣香扑鼻"
    }
  ],
  "tips": [
    "糯米粉用水分次加，一次倒多容易和成稀糊。",
    "面团静置十五分钟再蒸，成品才不夹生。",
    "蒸屉一定要垫布刷油，否则整块揭不下来。",
    "蒸完焖三分钟再开盖，糕体才不塌陷。"
  ],
  "common_mistakes": [
    "水一次全倒进去，面团稀得捏不成形。",
    "面团不静置就上锅，蒸出来中间还有生粉块。",
    "蒸屉不垫布不刷油，取糕时碎成几块。",
    "关火立刻掀盖，热气一冲糕体塌成坑。"
  ],
  "substitutions": [
    {
      "original": "红枣",
      "substitute": "葡萄干",
      "ratio": "180克:150克",
      "note": "更酸甜，白糖可减十克。"
    },
    {
      "original": "清水",
      "substitute": "牛奶",
      "ratio": "380毫升:400毫升",
      "note": "奶香更浓，糖可略减。"
    }
  ],
  "variations": [
    "加一把核桃碎同蒸，口感更丰富。",
    "面团里拌入一小把桂花干，蒸出来的香气清雅不腻。",
    "枣泥夹在两层糯米面中间，做成夹心版本更好看。"
  ],
  "serving_suggestion": "切成小方块，温热时吃最软糯，凉透后口感微韧，配一杯清茶当下午点心很合适。",
  "storage": "冷藏可放三天，复热上锅蒸五分钟恢复软糯，凉吃会偏硬。",
