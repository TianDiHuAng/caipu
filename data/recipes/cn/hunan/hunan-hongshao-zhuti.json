  "steps": [
    {
      "n": 1,
      "text": "猪蹄冷水下锅，加姜片与料酒煮十分钟，撇净浮沫后捞出冲净。",
      "time_min": 15,
      "heat": "大火",
      "tip": "冷水下锅血水才慢慢逼出来，猪蹄不腥。",
      "visual_cue": "猪蹄表面干净，皮色发白微紧"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油下冰糖，小火炒到融化并冒起棕红小泡。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖色到枣红就下猪蹄，再等就发苦了。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "糖液棕红透亮，泡沫细密"
    },
    {
      "n": 3,
      "text": "下猪蹄翻炒裹上糖色，加姜片、蒜、干辣椒、八角与桂皮炒香。",
      "time_min": 6,
      "heat": "中火",
      "tip": "糖色裹匀再下香料，味道才能一层层贴上去。",
      "visual_cue": "猪蹄表面棕红油亮，香料香气上扬"
    },
    {
      "n": 4,
      "text": "淋料酒、生抽与老抽，加清水没过猪蹄，大火烧开转小火。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水要一次加够，中途加水会让皮肉发紧。",
      "visual_cue": "汤汁棕红，猪蹄全部浸在汤里"
    },
    {
      "n": 5,
      "text": "移入砂锅小火焖九十分钟至皮糯，加盐收汁到浓稠即可。",
      "time_min": 95,
      "heat": "小火",
      "tip": "焖到筷子能轻松插进皮里，口感才对。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "皮肉颤软脱骨，汤汁浓稠挂勺"
    }
  ],
  "tips": [
    "糖色炒到枣红就下料，过头会带苦味。火候与时间都要盯紧，宁可略短也别过头。",
    "焖的时间宁可长一点，猪蹄才够糯。做之前把料备齐，下锅后就没空切配了。",
    "老抽只用来上色，放多了会发黑。这几步照顺序来，味道才会一层层叠上去。",
    "收汁时勤翻动，避免贴锅底糊掉。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "糖色炒过头变黑，整锅都带焦苦味。结果往往一锅好料全被这一步毁掉。",
    "焯水后没冲净浮沫，汤面一直有杂味。很多人就在这里翻车，出菜后才发现。",
    "中途加冷水，猪皮瞬间收紧怎么焖都不软。",
    "大火猛滚收汁，汤汁浑掉还发咸。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "猪蹄",
      "substitute": "猪肘",
      "ratio": "1000克:1000克",
      "note": "肉更多，焖的时间加二十分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "30克:26克",
      "note": "焦香稍弱，糖色要炒得快。"
    }
  ],
  "variations": [
    "加一把干豆角同焖，吸满汤汁非常香。口味会更厚一些，适合重口的人。",
    "加两勺剁椒同焖，酸辣味更开胃。做法不复杂，家常灶台就能完成。",
    "收汁前加几段蒜苗，清香压住油腻。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "盛在砂锅里连汁上桌，撒一把葱花，皮糯肉香、酱色油亮，配白饭或米酒都合适。",
  "storage": "冷藏可放两天，复热加少量清水小火慢焖十分钟，口感可恢复软糯。",
