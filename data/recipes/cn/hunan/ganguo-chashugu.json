  "steps": [
    {
      "n": 1,
      "text": "干茶树菇用温水泡 20 分钟至回软，剪掉老根后反复洗净泥沙，挤出水分。",
      "time_min": 22,
      "heat": "无火",
      "tip": "根部泥沙多，剪掉老根更干净。",
      "visual_cue": "菇柄柔软、无硬根"
    },
    {
      "n": 2,
      "text": "五花肉切薄片，干辣椒剪成小段，大蒜拍碎，姜切片，小葱切段。",
      "time_min": 6,
      "heat": "无火",
      "tip": "五花肉切薄一点，更容易煸出油。",
      "visual_cue": "肉片透光、辣椒段完整"
    },
    {
      "n": 3,
      "text": "锅中倒 40ml 植物油，中火把五花肉片煸到边缘微焦、油脂渗出。",
      "time_min": 5,
      "heat": "中火",
      "tip": "煸出猪油后炒菇更香。",
      "visual_cue": "肉片卷边、锅底见油"
    },
    {
      "n": 4,
      "text": "转小火下豆瓣酱、干辣椒段、蒜与姜片，慢慢炒出红油与香味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆瓣酱小火炒，才不发苦。",
      "visual_cue": "油色红亮、辣香扑鼻"
    },
    {
      "n": 5,
      "text": "下茶树菇转大火翻炒 4 分钟，炒到表面收缩发干，加生抽与盐调味。",
      "time_min": 5,
      "heat": "大火",
      "tip": "大火快炒把水汽炒干，口感才像干锅。",
      "visual_cue": "菇身收紧、锅底无水"
    },
    {
      "n": 6,
      "text": "转小火加盖焖 2 分钟让味道渗入，开盖撒葱段翻匀即可上桌。",
      "time_min": 4,
      "heat": "小火",
      "tip": "焖两分钟足够，久了菇会回软。",
      "visual_cue": "菇体油亮、葱段翠绿"
    }
  ],
  "tips": [
    "茶树菇泡发后一定挤干水分，炒才香。",
    "五花肉先煸出油，是整锅香味的底子。",
    "全程不加水，干锅才够干香够辣。"
  ],
  "common_mistakes": [
    "泡发的菇带水下锅，炒成水煮菇。",
    "豆瓣酱大火爆炒，红油发黑带焦苦。",
    "全程小火慢炒，菇身不收缩、口感发韧。"
  ],
  "substitutions": [
    {
      "original": "茶树菇",
      "substitute": "杏鲍菇",
      "ratio": "300g 对 350g",
      "note": "鲜菇水分多，需多炒 2 分钟。"
    },
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "120g 对 100g",
      "note": "腊肉偏咸，盐减半。"
    }
  ],
  "variations": [
    "加藕片版：加 150g 藕片同炒，口感更丰富。",
    "全素版：省去五花肉，改用 30ml 植物油煸香。"
  ],
  "storage": "冷藏 2 天，复热用干锅或炒锅大火回炒 2 分钟。",
