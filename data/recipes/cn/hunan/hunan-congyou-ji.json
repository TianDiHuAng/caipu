  ],
  "equipment": [
    "深汤锅",
    "冰水盆",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "整鸡里外冲洗干净，用盐与料酒把鸡身内外抹匀，静置二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "盐要抹到鸡腔里，腥味才去得净。",
      "visual_cue": "鸡皮表面微微收紧。"
    },
    {
      "n": 2,
      "text": "鸡腔里塞入葱结与姜片，把两只脚用棉线绑住一起定型。",
      "time_min": 8,
      "heat": "无火",
      "tip": "把双脚绑在一起，煮的时候鸡形才完整不散。",
      "visual_cue": "鸡身收拢，双脚固定"
    },
    {
      "n": 3,
      "text": "大锅烧水到将沸未沸，提着鸡脖子把鸡浸入水中三次再整只放入。",
      "time_min": 6,
      "heat": "中火",
      "tip": "三提三放能让鸡腔内外温度一致。",
      "visual_cue": "鸡皮收紧，表面泛白。"
    },
    {
      "n": 4,
      "text": "保持水面微微冒泡煮二十五分钟，中途翻面一次。",
      "time_min": 27,
      "heat": "中小火",
      "tip": "水不能大滚，滚了鸡肉就柴。",
      "visual_cue": "水面细泡不断，鸡身浮起。"
    },
    {
      "n": 5,
      "text": "捞出整鸡立刻放入冰水中浸十分钟，让鸡皮收紧。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冰水一激，鸡皮爽脆，肉汁锁住。",
      "visual_cue": "鸡皮紧实发亮，手感冰凉"
    },
    {
      "n": 6,
      "text": "小葱丝与姜丝放碗里，加盐，把烧到冒烟的花生油泼上去激香。",
      "time_min": 6,
      "heat": "大火",
      "tip": "油要够热，泼下去才有滋啦声和香气。",
      "visual_cue": "葱丝瞬间变绿软化。"
    },
    {
      "n": 7,
      "text": "鸡斩件摆盘，淋上葱油与生抽、香油，趁热上桌。",
      "time_min": 8,
      "heat": "无火",
      "tip": "斩件时刀要快，皮肉才不散。",
      "visual_cue": "鸡块码放整齐，表面油亮"
    }
  ],
  "tips": [
    "选两斤半左右的走地鸡，肉质紧实有鸡味。",
    "煮鸡的水别倒，撇油后就是简易鸡汤。",
    "葱油可以多做一些，能用来拌饭或拌青菜。"
  ],
  "common_mistakes": [
    "水一直大滚着煮鸡，鸡皮煮破，肉也发柴。",
    "煮好不放冰水激，鸡皮发黏，切的时候容易散。"
  ],
  "substitutions": [
    {
      "original": "整鸡",
      "substitute": "鸡翅",
      "ratio": "1100g 对 900g",
      "note": "鸡翅版只需浸煮十分钟，冰水时间缩短到五分钟。"
    }
  ],
  "variations": [
    "湘南会加一勺剁椒在葱油里，辣香更足，颜色也红亮。"
  ],
  "serving_suggestion": "冷吃热吃都行，配姜葱油碟，剩下的鸡骨熬汤。",
  "storage": "冷藏两天，鸡肉冷藏后口感更紧，蘸料另装。",
