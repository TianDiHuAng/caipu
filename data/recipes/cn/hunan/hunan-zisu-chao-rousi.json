  "steps": [
    {
      "n": 1,
      "text": "猪里脊切成细丝，加生抽、料酒与生粉抓匀，静置十分钟上浆。",
      "time_min": 12,
      "heat": "无火",
      "tip": "抓到手上有点发黏，浆才算挂住了，炒出来才嫩。",
      "visual_cue": "肉丝表面裹一层薄浆，颜色发亮"
    },
    {
      "n": 2,
      "text": "青椒去籽切丝，紫苏取嫩叶切碎，小米辣切圈，大蒜切片，姜切丝。",
      "time_min": 9,
      "heat": "无火",
      "tip": "紫苏的梗要去掉，只用叶子，香气才清。",
      "visual_cue": "配料丝条均匀，紫苏碎松散不结团"
    },
    {
      "n": 3,
      "text": "炒锅烧到冒烟倒植物油，下肉丝快速滑散，变色立刻盛出。",
      "time_min": 6,
      "heat": "大火",
      "tip": "热锅冷油下肉丝，一根根散开不粘成坨。",
      "visual_cue": "肉丝根根分明，表面发白微黄"
    },
    {
      "n": 4,
      "text": "锅留底油下姜丝、蒜片与小米辣炒香，再下青椒丝大火翻炒一分钟。",
      "time_min": 5,
      "heat": "大火",
      "tip": "青椒要大火快炒，炒久了颜色发黄发软。",
      "visual_cue": "青椒丝翠绿带虎皮，锅气明显"
    },
    {
      "n": 5,
      "text": "倒回肉丝，加盐与紫苏碎，大火翻炒三十秒出锅。",
      "time_min": 4,
      "heat": "大火",
      "tip": "紫苏最后放，翻两下就出锅，香气最冲。",
      "visual_cue": "紫苏碎均匀裹在肉丝上，色泽鲜亮"
    }
  ],
  "tips": [
    "肉丝上浆后再炒，口感才滑嫩不柴。火候与时间都要盯紧，宁可略短也别过头。",
    "紫苏一定要最后放，久炒香气会散掉。做之前把料备齐，下锅后就没空切配了。",
    "全程大火，锅气足才是湘菜的味道。这几步照顺序来，味道才会一层层叠上去。",
    "青椒选薄皮的，辣香更冲也更挂味。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "肉丝没上浆就下锅，炒出来又干又硬。结果往往一锅好料全被这一步毁掉。",
    "肉丝在锅里久炒，水分全失变得发柴。很多人就在这里翻车，出菜后才发现。",
    "紫苏和肉丝一起下锅久炒，香气没了。账面上看是小疏忽，入口立刻能尝出来。",
    "青椒用小火慢慢炒，颜色发黄还出水。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "牛里脊",
      "ratio": "400克:400克",
      "note": "更接近湘西小炒的做法。"
    },
    {
      "original": "紫苏",
      "substitute": "九层塔",
      "ratio": "30克:25克",
      "note": "香气不同，用量要略减。"
    }
  ],
  "variations": [
    "加一把酸豆角同炒，酸辣更开胃。口味会更厚一些，适合重口的人。",
    "加一勺剁椒同炒，咸辣层次更厚。做法不复杂，家常灶台就能完成。",
    "换成五花肉片同炒，油香更足。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "装盘趁热上桌，配一碗白饭，肉丝滑嫩、紫苏香气冲鼻，是湘菜里最家常的一盘小炒。",
  "storage": "冷藏可放一天，复热用炒锅大火快翻一分钟，不要久热以免肉丝变柴。",
