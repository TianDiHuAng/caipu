  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "五花肉",
          "name_en": "pork belly",
          "amount": 700,
          "unit": "g",
          "note": "选三层分明的带皮五花，切成 3 厘米见方的块",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "姜",
          "name_en": "ginger",
          "amount": 20,
          "unit": "g",
          "note": "切片，铺在锅底防粘",
          "optional": false
        },
        {
          "name": "大葱",
          "name_en": "welsh onion",
          "amount": 30,
          "unit": "g",
          "note": "切段，与姜同用",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "冰糖",
          "name_en": "rock sugar",
          "amount": 30,
          "unit": "g",
          "note": "炒糖色用，敲成小块更易融化",
          "optional": false
        },
        {
          "name": "干辣椒",
          "name_en": "dried red chili",
          "amount": 8,
          "unit": "g",
          "note": "剪成段，去籽可减辣",
          "optional": false
        },
        {
          "name": "八角",
          "name_en": "star anise",
          "amount": 2,
          "unit": "piece",
          "note": "整颗使用，过量会发苦",
          "optional": false
        },
        {
          "name": "桂皮",
          "name_en": "cassia bark",
          "amount": 3,
          "unit": "g",
          "note": "选薄皮桂皮，香气清透",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 30,
          "unit": "ml",
          "note": "提供咸鲜底味",
          "optional": false
        },
        {
          "name": "料酒",
          "name_en": "shaoxing wine",
          "amount": 30,
          "unit": "ml",
          "note": "焯水与烧制各 15 毫升",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "最后收汁时按需补入",
          "optional": false
        },
        {
          "name": "菜籽油",
          "name_en": "rapeseed oil",
          "amount": 20,
          "unit": "ml",
          "note": "煸肉用，五花肉自身会出油",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "厚底炒锅",
    "砂锅或铸铁锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉块冷水下锅，加 15 毫升料酒与 10 克姜片，大火烧开后煮 5 分钟，撇净浮沫捞出，用温水冲净表面并吸干水分。",
      "time_min": 12,
      "heat": "大火",
      "tip": "焯水必须冷水下锅，热水下锅会把血水封在肉里。",
      "visual_cue": "肉块表面由粉红转为灰白、切口无血水渗出，浮沫呈灰褐色。"
    },
    {
      "n": 2,
      "text": "锅中放 20 毫升菜籽油，下肉块中火煸 8 分钟，逼出多余油脂至表面微黄，盛出备用，锅中留 15 毫升底油。",
      "time_min": 9,
      "heat": "中火",
      "tip": "煸到肉块四周起焦边、锅底积出一层清亮猪油即可，煸过头肉质会发柴。",
      "visual_cue": "肉皮起细密小泡、边缘呈浅金色，锅底油量明显增加。"
    },
    {
      "n": 3,
      "text": "底油中下 30 克冰糖，小火炒到融化并转为枣红色，倒入肉块快速翻炒，让每块都裹上糖色。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖色到枣红立即下肉，颜色再深就会发苦。",
      "visual_cue": "糖液呈透亮枣红、裹在肉上泛出油亮红光，无黑色焦粒。"
    },
    {
      "n": 4,
      "text": "加姜片、葱段、干辣椒段、八角、桂皮炒香，烹入 15 毫升料酒、30 毫升生抽，加 400 毫升热水没过肉块，大火烧开后转小火加盖焖 50 分钟。",
      "time_min": 52,
      "heat": "小火",
      "tip": "必须加热水，冷水会让肉质骤缩变硬；水面保持轻微冒泡即可。",
      "visual_cue": "汤汁由稀转稠、浮油呈清亮橙红，肉块能用筷子轻压出凹陷。"
    },
    {
      "n": 5,
      "text": "开盖转大火收汁，边收边翻动，汤汁收到能挂在肉面上时尝味，按需补 4 克盐，出锅前挑出香料。",
      "time_min": 6,
      "heat": "大火",
      "tip": "收汁阶段要不停翻动，糖分高容易糊底。",
      "visual_cue": "成品红亮油润、盘底只剩一层薄汁，肉皮颤而不散。"
    }
  ],
  "tips": [
    "五花肉先煸后烧，逼出的猪油可留作炒青菜，成品不腻且更香。",
    "糖色决定成品颜色，用冰糖比白糖色泽更透亮，炒制时火力必须小。"
  ],
  "common_mistakes": [
    "肉块焯水后直接下冷水冲，骤冷让肉质收紧，久炖也不酥烂。",
    "收汁时离开灶台，糖分在锅底迅速焦化，成品带明显苦味。"
  ],
  "substitutions": [
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "1:1",
      "note": "白糖上色更快，需把炒糖时间缩短 30 秒以免过火。"
    },
    {
      "original": "五花肉",
      "substitute": "梅花肉",
      "ratio": "1:1",
      "note": "梅花肉脂肪少、口感偏瘦，焖制时间缩短到 35 分钟。"
    }
  ],
  "variations": [
    "家庭简化版：省去煸油步骤，肉块直接焯水后下锅烧，成品略油，但操作时间省 10 分钟。",
    "韶山风味版：干辣椒增至 15 克并加 5 克豆豉同烧，辣味与酱香更突出。"
  ],
  "serving_suggestion": "4 人份，配米饭与小碟酸萝卜解腻，剩余的肉汁可拌面。",
  "storage": "冷藏密封 3 天，复热时加 30 毫升清水小火焖 5 分钟；冷冻可存 30 天，解冻后口感略松散。",
  "nutrition_estimate": {
    "basis": "每份（约 165 克成品）",
    "calories_kcal": 598,
