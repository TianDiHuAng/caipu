  "steps": [
    {
      "n": 1,
      "text": "粉丝用温水泡二十分钟，泡到能用指甲掐断。",
      "time_min": 22,
      "heat": "无火",
      "tip": "温水泡，别用开水，否则一泡就烂。",
      "visual_cue": "粉丝柔软透明，能掐断。"
    },
    {
      "n": 2,
      "text": "锅里烧水，水开后下粉丝煮一分钟，捞出过凉水沥干。",
      "time_min": 5,
      "heat": "大火",
      "tip": "煮一分钟就够，久了粉丝糊成一团。",
      "visual_cue": "粉丝根根分明，不发黏。"
    },
    {
      "n": 3,
      "text": "黄瓜与胡萝卜分别切成火柴梗粗细的均匀细丝。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切得粗细一致，拌起来才好看好吃。",
      "visual_cue": "三样丝粗细均匀。"
    },
    {
      "n": 4,
      "text": "胡萝卜丝下开水焯三十秒，捞出立刻过凉水沥干。",
      "time_min": 3,
      "heat": "大火",
      "tip": "胡萝卜焯一下更甜，也不生涩。",
      "visual_cue": "胡萝卜丝颜色更亮。"
    },
    {
      "n": 5,
      "text": "碗里放蒜末、小米辣、生抽、米醋、白糖、盐与辣椒油调成料汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "料汁先调好，拌的时候才均匀。",
      "visual_cue": "料汁酸甜红亮，颗粒完全溶解"
    },
    {
      "n": 6,
      "text": "三样主料放盆里淋料汁拌匀，撒香菜点香油装盘上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "粉丝吸水，拌好尽快上桌。",
      "visual_cue": "三色分明，油光红亮。"
    }
  ],
  "tips": [
    "粉丝泡到能掐断就行，泡太软拌的时候会断。",
    "三丝的比例可以按手边食材调整，黄瓜多点更清爽。",
    "料汁里加一勺芝麻酱，风味更厚。"
  ],
  "common_mistakes": [
    "粉丝用开水泡，外层烂成一坨，中间还硬。",
    "蔬菜丝切得太粗，拌不透，口感发硬。"
  ],
  "substitutions": [
    {
      "original": "粉丝",
      "substitute": "腐竹",
      "ratio": "150g 对 150g 干品",
      "note": "腐竹版须提前泡发并焯熟，切成细条。"
    }
  ],
  "variations": [
    "加一把焯过水的木耳丝，三丝变四丝，口感更丰富。"
  ],
  "serving_suggestion": "装盘后冷藏十分钟，夏天当凉面吃也合适。",
  "storage": "冷藏一天，粉丝会吸汁，吃前补少许料汁。",
