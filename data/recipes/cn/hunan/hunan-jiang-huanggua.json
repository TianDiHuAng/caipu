  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净切成长条，去瓤后加盐抓匀，压重物腌两小时。",
      "time_min": 125,
      "heat": "无火",
      "tip": "瓤要去掉，否则腌完软塌还出水。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "瓜条明显变软，碗底积大量水"
    },
    {
      "n": 2,
      "text": "倒掉腌出的水，把瓜条摊在竹筛上晾半小时表面收干。",
      "time_min": 32,
      "heat": "无火",
      "tip": "表面收干再入罐，腌汁才不会被稀释。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "瓜条表面干爽，颜色转深绿"
    },
    {
      "n": 3,
      "text": "生抽、陈醋、白糖加一百毫升清水煮开，放凉备用。",
      "time_min": 8,
      "heat": "大火",
      "tip": "腌汁必须完全放凉，热汁会把瓜条烫软。",
      "visual_cue": "料汁棕红透亮，摸碗壁不烫手"
    },
    {
      "n": 4,
      "text": "玻璃罐用开水烫过擦干，铺一层瓜条撒一层蒜片姜丝小米辣与花椒。",
      "time_min": 9,
      "heat": "无火",
      "tip": "罐子必须无水无油，否则几天就起白膜。",
      "visual_cue": "罐内层次分明，配料分布均匀"
    },
    {
      "n": 5,
      "text": "倒入放凉的腌汁没过瓜条，淋白酒，密封冷藏腌二十四小时。",
      "time_min": 5,
      "heat": "无火",
      "tip": "汁要完全没过，露出的部分容易发霉。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "瓜条全部浸没，罐口密封严实"
    }
  ],
  "tips": [
    "去瓤是脆的关键，瓤留着腌完发软。火候与时间都要盯紧，宁可略短也别过头。",
    "腌汁一定要放凉再倒，热汁会烫熟瓜条。",
    "罐子和筷子必须无水无油。这几步照顺序来，味道才会一层层叠上去。",
    "冷藏腌一天就能吃，三天风味最足。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "黄瓜不去瓤，腌完软塌塌没脆劲。结果往往一锅好料全被这一步毁掉。",
    "热腌汁直接倒入，瓜条变软发黄。很多人就在这里翻车，出菜后才发现。",
    "瓜条没压水就入罐，腌汁被冲淡。账面上看是小疏忽，入口立刻能尝出来。",
    "取用时用湿筷子，整罐很快长白膜。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "陈醋",
      "substitute": "白醋",
      "ratio": "50毫升:45毫升",
      "note": "酸味更直接，糖加五克。"
    },
    {
      "original": "黄瓜",
      "substitute": "小黄瓜",
      "ratio": "1000克:1000克",
      "note": "更脆，腌的时间可缩短四小时。"
    }
  ],
  "variations": [
    "加几段干辣椒，辣味更沉更好下粥。口味会更厚一些，适合重口的人。",
    "加一勺豆瓣酱进腌汁，酱香更厚。做法不复杂，家常灶台就能完成。",
    "换成萝卜条同法腌制，口感更爽脆。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "捞出沥汁装碟，配白粥、米粉或炒饭都合适，酸辣脆爽，是湖南人早餐桌上的一口小菜。",
  "storage": "密封冷藏可放两周，每次用干燥筷子取用，汁液浑浊或起白膜即须丢弃。",
