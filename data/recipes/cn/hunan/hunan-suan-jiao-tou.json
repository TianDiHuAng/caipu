  "steps": [
    {
      "n": 1,
      "text": "藠头切掉根须和顶端老皮，只留白嫩部分。这一步别着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "老皮不去，腌好会发韧。，注意火候。",
      "visual_cue": "藠头白净，颗粒完整，状态稳定"
    },
    {
      "n": 2,
      "text": "清水冲洗两遍，摊开晾到表面无生水。这一步别着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "带生水容易长白膜。，注意火候。",
      "visual_cue": "表面干爽，无水珠，状态稳定"
    },
    {
      "n": 3,
      "text": "藠头加盐拌匀，压重物腌两小时杀水。这一步别着急。",
      "time_min": 10,
      "heat": "无火",
      "tip": "盐腌逼出辛辣水，成品才脆。，注意火候。",
      "visual_cue": "颗粒变软，出水明显，状态稳定"
    },
    {
      "n": 4,
      "text": "小锅倒清水和白醋，加白糖小火煮化。这一步别着急。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖化开就关火，别煮酸味跑掉。，注意火候。",
      "visual_cue": "糖液清亮，微酸甜，状态稳定"
    },
    {
      "n": 5,
      "text": "糖醋汁彻底放凉，尝一下酸甜是否顺口。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "热汁会把藠头烫软。，注意火候。",
      "visual_cue": "汁液透明，凉透，状态稳定"
    },
    {
      "n": 6,
      "text": "藠头装进干净玻璃罐，放小米椒圈。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "罐子无油无水，否则易坏。，注意火候。",
      "visual_cue": "颗粒压实，椒圈点缀，状态稳定"
    },
    {
      "n": 7,
      "text": "倒糖醋汁没过藠头，盖紧密封冷藏三天。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "汁要没过，露出的部分会发黑。，注意火候。",
      "visual_cue": "汁面高过食材，罐口干净"
    }
  ],
  "tips": [
    "藠头老皮去净，腌好才脆。，值得留意。",
    "汁要彻底放凉再倒，不然会软。，值得留意。",
    "罐子无油无水，才能存得住。，值得留意。"
  ],
  "common_mistakes": [
    "藠头带生水下罐，几天就长白膜。，值得留意。",
    "糖醋汁热着倒，成品软塌不脆。，值得留意。",
    "盐放太少，腌出来发酸发臭。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "藠头",
      "substitute": "小洋葱",
      "ratio": "500 克:500 克",
      "note": "辛辣味淡，腌两天即可。"
    },
    {
      "original": "白醋",
      "substitute": "米醋",
      "ratio": "150 毫升:150 毫升",
      "note": "颜色偏黄，酸味柔和。"
    }
  ],
  "variations": [
    "加几粒花椒，香气更足。，值得留意。",
    "放一点辣椒油，做成酸辣版。，值得留意。"
  ],
  "serving_suggestion": "配粥、配米粉，或炒肉丝。，效果更稳定。",
  "storage": "冷藏一个月，取用须用干净筷子。，效果更稳定。",
