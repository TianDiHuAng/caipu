  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净，用刀背拍裂后切成四厘米段。这一步别着急。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拍裂比切片更挂汁。，注意火候。",
      "visual_cue": "瓜段开裂，断面粗糙，状态稳定"
    },
    {
      "n": 2,
      "text": "黄瓜段加盐抓匀，静置十分钟出水。这一步别着急。",
      "time_min": 12,
      "heat": "无火",
      "tip": "杀过水才脆，也不会冲淡调味。，注意火候。",
      "visual_cue": "碗底见水，瓜段变软，状态稳定"
    },
    {
      "n": 3,
      "text": "倒掉渗出的水，用手轻压挤掉多余水分。这一步别着急。",
      "time_min": 3,
      "heat": "无火",
      "tip": "挤干一点，拌好不出汤。，注意火候。",
      "visual_cue": "瓜段干爽，能弯不断，状态稳定"
    },
    {
      "n": 4,
      "text": "蒜捣成泥，干辣椒剪成小段放碗里。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜泥比蒜末更出味。，注意火候。",
      "visual_cue": "蒜泥细腻，辣段完整，状态稳定"
    },
    {
      "n": 5,
      "text": "植物油烧到冒烟，泼在蒜泥辣椒上激香。这一步别着急。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油要够热，泼下去才有响声。，注意火候。",
      "visual_cue": "蒜香冲鼻，油花翻滚，状态稳定"
    },
    {
      "n": 6,
      "text": "加生抽、香醋、白糖和香油调成料汁。这一步别着急。",
      "time_min": 2,
      "heat": "无火",
      "tip": "尝一下酸甜咸，按口味微调。，注意火候。",
      "visual_cue": "料汁均匀，油花漂浮，状态稳定"
    },
    {
      "n": 7,
      "text": "倒进黄瓜段拌匀，静置五分钟入味。这一步别着急。",
      "time_min": 6,
      "heat": "无火",
      "tip": "拌好等一会，味道才进得去。，注意火候。",
      "visual_cue": "瓜段油亮，汁水微红，状态稳定"
    }
  ],
  "tips": [
    "黄瓜拍裂再切，比切片更挂汁。，值得留意。",
    "杀水挤干，拌好才不出汤。，值得留意。",
    "热油泼蒜，香味才激得出来。，值得留意。"
  ],
  "common_mistakes": [
    "黄瓜没杀水，端上桌一碗汤。，值得留意。",
    "油不够热，蒜香出不来。，值得留意。",
    "拌好立刻吃，味道还没进去。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "黄瓜",
      "substitute": "莴笋",
      "ratio": "400 克:400 克",
      "note": "更脆，杀水时间加五分钟。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "15 毫升:15 毫升",
      "note": "酸味更柔和。"
    }
  ],
  "variations": [
    "加一把炸花生米，口感更丰富。，值得留意。",
    "放一勺辣椒油，辣味更直接。，值得留意。"
  ],
  "serving_suggestion": "冰镇后上桌，配油腻的肉菜最解腻。，效果更稳定。",
  "storage": "冷藏一天，吃前再拌一次。，效果更稳定。",
