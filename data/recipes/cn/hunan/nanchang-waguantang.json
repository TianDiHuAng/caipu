  "equipment": [
    "瓦罐",
    "蒸锅",
    "和馅盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肉末加盐、生抽、料酒、白胡椒与姜末，顺同一方向搅打上劲。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺一个方向搅，肉饼才抱团不散。",
      "visual_cue": "肉馅发黏上劲、能整团提起"
    },
    {
      "n": 2,
      "text": "肉馅分成两份团成圆饼，按压贴在瓦罐底部，中间压出一个小窝。",
      "time_min": 5,
      "heat": "无火",
      "tip": "小窝能让鸡蛋卧在里面不滑开。",
      "visual_cue": "肉饼紧贴罐底、中心有浅坑"
    },
    {
      "n": 3,
      "text": "香菇泡发后切碎撒在肉饼上，再往每个罐里打入一个鸡蛋。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鸡蛋不要打散，整颗卧进去更嫩。",
      "visual_cue": "蛋黄金黄完整、停在肉饼中央"
    },
    {
      "n": 4,
      "text": "沿罐壁缓缓注入清水至八分满，避免冲散肉饼与蛋。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水从罐边流下去，肉饼才不被冲开。",
      "visual_cue": "水面距离罐口约两指"
    },
    {
      "n": 5,
      "text": "瓦罐放入蒸锅，水开后转中小火隔水蒸六十分钟，中途不揭盖。",
      "time_min": 60,
      "heat": "中小火",
      "tip": "慢蒸才能把肉香逼进汤里。",
      "visual_cue": "汤色微浑、罐口冒细密蒸汽"
    },
    {
      "n": 6,
      "text": "取出瓦罐，先尝一口汤，按口味补少许盐，撒上葱花趁热端出。",
      "time_min": 2,
      "heat": "无火",
      "tip": "瓦罐很烫，取用要垫厚布。",
      "visual_cue": "汤面浮一层清油、葱花翠绿"
    }
  ],
  "tips": [
    "没有瓦罐可用带盖炖盅代替，效果接近。",
    "肉末自己剁比机器绞的更香更有颗粒感。",
    "蒸好后静置五分钟再开盖，汤更清不浑。"
  ],
  "common_mistakes": [
    "肉馅不打上劲，蒸好就散成一锅肉汤。",
    "蒸的过程中往锅里加冷水，温度骤降，汤会带上腥气。",
    "火开得太大让汤滚沸，鸡蛋被冲散，汤色也变得浑浊。"
  ],
  "substitutions": [
    {
      "original": "香菇",
      "substitute": "干贝",
      "ratio": "30g 对 10g",
      "note": "干贝需提前泡软撕丝，鲜味更浓。"
    },
    {
      "original": "猪肉末",
      "substitute": "猪里脊",
      "ratio": "300g 对 300g",
      "note": "瘦肉偏柴，可加一勺猪油增润。"
    }
  ],
  "variations": [
    "加几片山药或玉米段同蒸，汤头会更清甜一些。",
    "换成排骨与莲藕，延长蒸制到九十分钟。"
  ],
  "serving_suggestion": "一人一罐，配一碗南昌拌粉，就是地道南昌早餐。",
  "storage": "冷藏两天，复蒸十分钟即可，汤味更融合。",
