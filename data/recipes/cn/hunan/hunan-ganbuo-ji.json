  "equipment": [
    "炒锅",
    "干锅或砂锅",
    "刀",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉斩成小块，加料酒与少许盐抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "块切小一点，干锅才入味快。",
      "visual_cue": "鸡块表面泛光，腌料吸尽。"
    },
    {
      "n": 2,
      "text": "土豆去皮切粗条，泡清水五分钟洗去表面淀粉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "洗掉淀粉，土豆条炒时不粘锅。",
      "visual_cue": "水变浑浊，土豆条脆硬。"
    },
    {
      "n": 3,
      "text": "锅里倒花生油，土豆条中火煎到四面金黄盛出。",
      "time_min": 10,
      "heat": "中火",
      "tip": "土豆先煎定型，后面焖才不会烂。",
      "visual_cue": "土豆条边缘金黄起壳。"
    },
    {
      "n": 4,
      "text": "原锅下鸡块，大火煸炒到表面金黄、鸡皮出油。",
      "time_min": 10,
      "heat": "大火",
      "tip": "干锅讲究干香，鸡块要煸到位。",
      "visual_cue": "鸡块紧缩，锅里有明油。"
    },
    {
      "n": 5,
      "text": "放姜蒜、干辣椒、花椒与泡椒炒香，加生抽翻匀。",
      "time_min": 6,
      "heat": "中火",
      "tip": "泡椒自带咸酸，盐要少放。",
      "visual_cue": "红油渗出，香味冲鼻。"
    },
    {
      "n": 6,
      "text": "倒回土豆条与豆腐干，加清水焖八分钟收干。",
      "time_min": 10,
      "heat": "中火",
      "tip": "水别多，收干后才是干锅的样子。",
      "visual_cue": "汤汁基本收干，锅底吱吱响。"
    },
    {
      "n": 7,
      "text": "放青椒与蒜苗大火翻炒半分钟，加盐调味出锅装锅。",
      "time_min": 5,
      "heat": "大火",
      "tip": "蒜苗最后下，断生就好，香气足。",
      "visual_cue": "蒜苗翠绿，青椒微皱。"
    }
  ],
  "tips": [
    "干锅要用厚底锅，受热均匀不容易糊。",
    "土豆先煎后焖，外酥里粉，比直接焖好吃。",
    "家里做可以盛到砂锅里上桌，保温效果更好。"
  ],
  "common_mistakes": [
    "鸡块先焯水再煸，水分太多煸不香。",
    "一路大火不收汁，最后变成一锅汤。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "鸡翅",
      "ratio": "800g 对 800g",
      "note": "鸡翅斩半，焖的时间缩短两分钟。"
    }
  ],
  "variations": [
    "加一把藕片同炒，脆口解辣，是长沙干锅店的常见搭配。"
  ],
  "serving_suggestion": "装干锅或砂锅上桌，边加热边吃，配米饭。",
  "storage": "冷藏两天，复热时加一勺水盖盖焖三分钟。",
