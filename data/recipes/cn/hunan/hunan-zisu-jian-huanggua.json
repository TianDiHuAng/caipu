  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "碗",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄瓜洗净切成半厘米厚的斜片，撒三克盐抓匀腌十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "腌出水分再煎，才不会一锅水汽煎不香。",
      "visual_cue": "黄瓜片略软，表面渗出水珠"
    },
    {
      "n": 2,
      "text": "腌好的黄瓜片用厨房纸吸干水分，一片片摊开备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "表面一定要擦干，带水下锅会爆油。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "瓜片表面干爽，颜色仍翠绿"
    },
    {
      "n": 3,
      "text": "平底锅倒植物油中火烧热，把瓜片平铺下锅煎三分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "铺平别叠，让每片都贴到锅底才煎得香。",
      "visual_cue": "贴锅一面金黄微焦，边缘卷起"
    },
    {
      "n": 4,
      "text": "翻面再煎两分钟，推到锅边，下蒜末、小米辣与紫苏炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "紫苏遇热出香很快，炒十秒就够。锅和案板保持干爽，成菜口感差别很大。",
      "visual_cue": "蒜末微黄，紫苏叶卷缩出香"
    },
    {
      "n": 5,
      "text": "加生抽与白糖，把瓜片与配料翻炒均匀，收干汤汁即可。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汤汁一收干就关火，久炒瓜片会烂。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "瓜片裹上酱色，锅底干爽无汤"
    }
  ],
  "tips": [
    "黄瓜腌过再煎，口感才紧实不水。火候与时间都要盯紧，宁可略短也别过头。",
    "两面煎出焦边，是这道菜的香气来源。做之前把料备齐，下锅后就没空切配了。",
    "紫苏要最后下锅，香气才留得住。这几步照顺序来，味道才会一层层叠上去。",
    "配粥或白饭都很搭，凉了也好吃。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "黄瓜没腌就煎，出水把香味全冲掉。结果往往一锅好料全被这一步毁掉。",
    "瓜片叠在一起下锅，贴不到锅底煎不香。",
    "表面带水下锅，油花四溅还容易溅伤。账面上看是小疏忽，入口立刻能尝出来。",
    "紫苏炒得太久，颜色发黑香气尽失。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "黄瓜",
      "substitute": "丝瓜",
      "ratio": "600克:600克",
      "note": "更软嫩，煎的时间减两分钟。"
    },
    {
      "original": "紫苏",
      "substitute": "薄荷",
      "ratio": "25克:18克",
      "note": "清凉感强，用量要少。"
    }
  ],
  "variations": [
    "加一勺剁椒同炒，酸辣味更跳。口味会更厚一些，适合重口的人。",
    "加几片五花肉同煎，油香更厚。做法不复杂，家常灶台就能完成。",
    "煎好后淋一勺辣椒油，湘味更足。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "连锅端上桌，瓜片焦边带香、紫苏味冲，配白粥或米饭都合适，是湖南夏天最家常的一道小菜。",
  "storage": "冷藏可放一天，复热用平底锅小火两面各煎一分钟，可恢复焦香。",
