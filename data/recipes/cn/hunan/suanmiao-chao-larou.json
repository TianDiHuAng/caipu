  "equipment": [
    "炒锅",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "腊肉片用温水浸泡 15 分钟，再上锅蒸 10 分钟至半透明，取出沥干。",
      "time_min": 25,
      "heat": "中火",
      "tip": "先泡后蒸能去多余盐分，也让腊肉更好切、不柴。",
      "visual_cue": "腊肉片边缘透明、肥肉发亮"
    },
    {
      "n": 2,
      "text": "蒜苗洗净斜切成 3cm 长段，蒜苗梗与叶子分开放置。",
      "time_min": 3,
      "heat": "无火",
      "tip": "斜切断面大，更易吸附腊肉油脂。",
      "visual_cue": "蒜苗段长短一致、断面椭圆"
    },
    {
      "n": 3,
      "text": "炒锅下 20ml 植物油，中火把腊肉片煸 2 分钟至出油卷边。",
      "time_min": 3,
      "heat": "中火",
      "tip": "腊肉一定要煸出油，香味才足。",
      "visual_cue": "肥肉卷曲透明、锅底积油"
    },
    {
      "n": 4,
      "text": "下姜丝、蒜片与干辣椒段炒香，加料酒烹锅。",
      "time_min": 1,
      "heat": "中火",
      "tip": "料酒沿锅边淋，蒸汽带走腥味。",
      "visual_cue": "辣椒变暗红、酒气散出"
    },
    {
      "n": 5,
      "text": "先下蒜苗梗大火炒 1 分钟，再下蒜苗叶与生抽、白糖、盐，翻炒 1 分钟出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "蒜苗叶最后下，炒久会发黄发软。",
      "visual_cue": "蒜苗翠绿挺立、腊肉油亮"
    }
  ],
  "tips": [
    "腊肉偏咸，泡与蒸两步都不能省。",
    "蒜苗挑白根粗壮的，辛香味更浓。",
    "喜辣可加 15g 湖南剁椒同炒，咸味需相应减少。"
  ],
  "common_mistakes": [
    "腊肉不泡不蒸直接炒，成品过咸发硬。",
    "蒜苗一次全下锅，叶炒烂而梗还生。",
    "加盐不看腊肉咸度，整道菜咸得下不了口。"
  ],
  "substitutions": [
    {
      "original": "腊肉",
      "substitute": "腊肠",
      "ratio": "250g 腊肉 ≈ 250g 腊肠",
      "note": "腊肠更甜，省略白糖。"
    },
    {
      "original": "蒜苗",
      "substitute": "青蒜",
      "ratio": "1:1",
      "note": "青蒜叶更嫩，炒制时间减半。"
    }
  ],
  "variations": [
    "家庭简化版：腊肉直接蒸熟切片，与蒜苗快炒 2 分钟，省去浸泡。",
    "湘西版：加 20g 干豆豉同炒，酱香更重。"
  ],
  "serving_suggestion": "配白米饭，腊肉油脂拌饭最香；亦可作下酒菜。",
  "storage": "冷藏 2 天，复热加 20ml 清水快炒，避免蒜苗发黄。",
