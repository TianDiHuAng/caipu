  "steps": [
    {
      "n": 1,
      "text": "五花肉切成一元硬币厚的薄片，泡椒切三厘米长的段，青蒜斜切成段。",
      "time_min": 8,
      "heat": "无火",
      "tip": "肉片薄一点更容易煸出油，口感也不腻，这一点影响成品口感。",
      "visual_cue": "肉片薄透，泡椒段齐整，锅面和食材状态一目了然"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油烧到六成热，下五花肉片中火煸三分钟，煸到边缘微卷出油。",
      "time_min": 5,
      "heat": "中火",
      "tip": "把肥肉里的油煸出来，菜才香而不腻，这一点影响成品口感。",
      "visual_cue": "肉片卷边，锅底一层油，颜色与质地变化清楚可见"
    },
    {
      "n": 3,
      "text": "淋料酒翻匀去腥，加姜丝和蒜片炒半分钟，炒出葱蒜的香气。",
      "time_min": 3,
      "heat": "中火",
      "tip": "料酒沿锅边淋，遇热酒气散得快，去腥更彻底。",
      "visual_cue": "酒气散尽，蒜片微黄，香气和声音能说明进度"
    },
    {
      "n": 4,
      "text": "倒入泡椒段和小米辣，中火炒两分钟，炒出酸辣的发酵香气。",
      "time_min": 4,
      "heat": "中火",
      "tip": "泡椒要炒透，酸味变柔和，辣味才不冲，这一点影响成品口感。",
      "visual_cue": "酸香扑鼻，锅内泛红，整体火候状态清楚好判断"
    },
    {
      "n": 5,
      "text": "加生抽和盐调味，转大火翻炒半分钟，让肉片均匀上色。",
      "time_min": 3,
      "heat": "大火",
      "tip": "生抽有咸味，盐少放，尝过再补，这一点影响成品口感。",
      "visual_cue": "肉片上色，油亮红润，表面变化看得出来已到位"
    },
    {
      "n": 6,
      "text": "最后放青蒜段，大火快炒三十秒断生，撒白胡椒翻匀出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "青蒜炒久了发黄发软，断生就得出锅，这一点影响成品口感。",
      "visual_cue": "青蒜翠绿，肉片油润，汤汁和食材状态清楚到位"
    }
  ],
  "tips": [
    "五花肉选三层分明的，肥瘦相间煸出来才香，全瘦的太柴。",
    "泡椒是这道菜的灵魂，湖南坛子泡出来的酸辣最地道，别用小米辣代替。",
    "全程中大火快炒，火小了肉片出水，炒出来是煮肉不是炒肉。",
    "青蒜最后放，断生即出锅，翠绿的颜色是这道菜的卖相所在。"
  ],
  "common_mistakes": [
    "肉片切太厚就下锅，煸不干水分，炒出来油腻发柴。",
    "泡椒没炒透就加水，酸味发冲带着生辣，吃完嘴里不舒服。",
    "青蒜早早扔进锅里，炒到发黄发蔫，颜色和脆劲全没了。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "瘦肉",
      "ratio": "300克:250克",
      "note": "瘦肉需先加淀粉抓匀，炒的时间减半。"
    },
    {
      "original": "泡椒",
      "substitute": "剁辣椒",
      "ratio": "80克:60克",
      "note": "剁辣椒更碎，炒时容易糊，火要小一点。"
    }
  ],
  "variations": [
    "加一把切段的猪肝同炒，做成泡椒炒猪肝，嫩滑带酸很下饭。",
    "把肉换成鸡蛋或豆腐干，做成素食版泡椒小炒，同样酸辣开胃。"
  ],
  "serving_suggestion": "盛在热盘里，配一碗湖南米饭，泡椒的酸辣裹着肉片，越吃越开胃。",
  "storage": "冷藏可放两天，回热用炒锅大火快炒一分钟，不要加水，否则泡椒味会散。",
