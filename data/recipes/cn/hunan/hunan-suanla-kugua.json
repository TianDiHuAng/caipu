  "steps": [
    {
      "n": 1,
      "text": "苦瓜对半剖开，用勺子刮净里面的白瓤，再斜刀切成薄片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "白瓤是苦味的大头，刮得越净，成品越清爽。",
      "visual_cue": "内壁露出青绿瓜肉，看不到白膜"
    },
    {
      "n": 2,
      "text": "苦瓜片撒盐抓匀腌五分钟，挤去渗出的苦水，再用清水冲一遍。",
      "time_min": 7,
      "heat": "无火",
      "tip": "盐腌能带走一部分苦味，但别腌太久，脆劲会没。",
      "visual_cue": "瓜片变软出水，颜色转深绿"
    },
    {
      "n": 3,
      "text": "炒锅倒菜籽油烧到冒烟，下姜末、蒜末与泡椒碎炒香。",
      "time_min": 2,
      "heat": "大火",
      "tip": "泡椒炒出酸香，这道菜的酸味底子就有了。",
      "visual_cue": "锅中飘出酸辣气，油色微红"
    },
    {
      "n": 4,
      "text": "倒入苦瓜片大火快炒两分钟，让瓜片均匀沾上油与泡椒。",
      "time_min": 2,
      "heat": "大火",
      "tip": "全程大火，苦瓜才脆绿，小火会焖出黄水。",
      "visual_cue": "瓜片翠绿油亮，锅底无积水"
    },
    {
      "n": 5,
      "text": "加生抽、白糖与米醋，撒小米椒圈翻炒半分钟。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋要最后放，早放酸味全挥发，只剩涩口。",
      "visual_cue": "瓜片透亮，酸辣气冲鼻"
    },
    {
      "n": 6,
      "text": "下葱段翻匀立刻出锅，装盘摊开散热保持脆度。",
      "time_min": 1,
      "heat": "大火",
      "tip": "摊开散热，堆在一起会把脆劲焖没了。",
      "visual_cue": "瓜片青翠挺立，盘中不见汤汁"
    }
  ],
  "tips": [
    "苦瓜挑表面瘤粒大而饱满的，苦味较淡。",
    "怕苦可先焯十秒再炒，但脆感会弱一些。",
    "加一勺豆豉同炒，咸鲜更厚，苦味也更柔。"
  ],
  "common_mistakes": [
    "白瓤没刮净就下锅，苦得整盘没人动筷。",
    "小火慢炒，苦瓜出水发黄，脆劲全无。",
    "醋和辣椒一起下锅久炒，酸味挥发只剩辣。"
  ],
  "substitutions": [
    {
      "original": "苦瓜",
      "substitute": "丝瓜",
      "ratio": "400克:400克",
      "note": "丝瓜不苦，炒的时间减半分钟。"
    },
    {
      "original": "泡椒",
      "substitute": "剁椒",
      "ratio": "30克:25克",
      "note": "剁椒更咸，盐要减半。"
    }
  ],
  "variations": [
    "加几片腊肉同炒，油脂压苦味，是湖南乡下的家常做法。",
    "把苦瓜换成苦瓜干，泡发后同炒，苦味更沉更香。"
  ],
  "serving_suggestion": "夏天配粥或米饭都清爽，作为油腻菜的解口小炒最合适。",
  "storage": "冷藏可存一天，复热须大火快炒，久放会发黄出水。",
