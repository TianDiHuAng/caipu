  "equipment": [
    "蒸锅",
    "擂钵",
    "擂棍",
    "炒锅",
    "漏盆",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子去蒂对半切开，切面朝上放进蒸锅，大火蒸十五分钟。",
      "time_min": 17,
      "heat": "大火",
      "tip": "茄子皮朝下贴盘摆放，紫皮不容易褪色发黄。",
      "visual_cue": "茄身软塌，筷子轻轻一插就透"
    },
    {
      "n": 2,
      "text": "蒸好的茄子取出放凉，用手撕成筷子粗的长条，堆在漏盆里沥水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "用手撕不用刀切，断面粗糙才挂得住酱汁。",
      "visual_cue": "茄条软糯不散，盆底积出水"
    },
    {
      "n": 3,
      "text": "青椒去蒂放进干锅，中火干煸到表皮起泡发白发皱。",
      "time_min": 8,
      "heat": "中火",
      "tip": "干锅不放油，表皮烤出焦斑才有那股烟火香。",
      "visual_cue": "青椒表皮起白泡，皱得发软"
    },
    {
      "n": 4,
      "text": "烤好的青椒趁热装进碗里盖住，焖五分钟让皮肉自然分离。",
      "time_min": 6,
      "heat": "无火",
      "tip": "趁热焖一会儿皮好撕，辣味也会柔和一些。",
      "visual_cue": "青椒塌软，皮和肉自然分开"
    },
    {
      "n": 5,
      "text": "撕掉青椒外层薄皮，和茄条一起放进擂钵，加大蒜和小米辣。",
      "time_min": 6,
      "heat": "无火",
      "tip": "皮撕不干净会留渣，影响整道菜的顺滑口感。",
      "visual_cue": "青椒肉厚软烂，看不到硬皮"
    },
    {
      "n": 6,
      "text": "用擂棍把配料捣三十下，捣到青椒成粗泥、茄条微微断开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "捣到出汁就停手，全捣成泥就失去口感层次。",
      "visual_cue": "混合成粗泥，能见茄条纤维"
    },
    {
      "n": 7,
      "text": "加生抽、香醋、盐、白糖和植物油拌匀，尝一口咸淡再补盐。",
      "time_min": 3,
      "heat": "无火",
      "tip": "醋别一次倒够，青椒出水后味道会变淡。",
      "visual_cue": "酱汁渗进茄条，颜色发暗红"
    },
    {
      "n": 8,
      "text": "装盘淋香油撒小葱段，冷藏十分钟再上桌更爽口。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏后味道融合，但别放超过半天，会出水。",
      "visual_cue": "表面油亮，葱花翠绿不发黄"
    }
  ],
  "tips": [
    "茄子蒸之前不要泡水，泡过的茄子吸水太多，蒸出来一碗汤，味道全被稀释。",
    "青椒要干煸到表皮起泡，那层焦斑才是擂椒的灵魂，图省事直接炒软会差一大截。",
    "捣的时候先捣青椒再放茄条，青椒出汁均匀，茄条也不至于被捣成一团泥。",
    "拌好后冷藏十分钟再吃，味道更融合，夏天当开胃凉菜上桌最受欢迎。"
  ],
  "common_mistakes": [
    "茄子蒸完直接拌，水没挤干，拌出来一盆汤。要放漏盆沥水后再调味。",
    "青椒不干煸直接切碎拌，只有生辣没有焦香。要干锅煸到表皮起泡。",
    "大蒜和青椒一起下擂钵前先炒香，反而盖掉了清香味。生蒜直接捣最对味。",
    "一次把醋倒足，青椒和茄子出水后整道菜发酸。要留一半最后尝味再补。"
  ],
  "substitutions": [
    {
      "original": "茄子",
      "substitute": "长豆角",
      "ratio": "600克:500克",
      "note": "需先焯水断生，口感更脆爽。"
    },
    {
      "original": "青椒",
      "substitute": "彩椒",
      "ratio": "180克:200克",
      "note": "几乎不辣，适合不吃辣的人。"
    }
  ],
  "variations": [
    "加一个烤过去皮的西红柿同擂，酸味更自然，颜色也更红亮。",
    "把茄子换成蒸软的土豆块，做成擂椒土豆泥，绵密顺口，配粥很好。",
    "拌好后撒一把炒香的芝麻和花生碎，香气更浓，口感也多一层脆。"
  ],
  "serving_suggestion": "粗陶碗里紫褐与青绿相间的泥状凉菜，油光点点，蒜香和焦辣味先冲上来。舀一勺配白饭，酸辣软糯，很解腻。",
  "storage": "冷藏可放一天，第二天出水较多，食用前拌匀并补少许盐和香油。",
