  "steps": [
    {
      "n": 1,
      "text": "腊肉用温水刷洗表面浮尘，整块上锅蒸十五分钟至皮软，取出晾到不烫手。",
      "time_min": 18,
      "heat": "大火",
      "tip": "先蒸后切，肉皮软了好下刀，也不会切得七零八落。",
      "visual_cue": "肉皮变软可掐，表面油亮"
    },
    {
      "n": 2,
      "text": "晾凉的腊肉切成两毫米薄片，香干切成同样厚薄的方片。",
      "time_min": 8,
      "heat": "无火",
      "tip": "两样切得一样薄，蒸出来口感才协调。",
      "visual_cue": "薄片几乎透光，片形大小相仿"
    },
    {
      "n": 3,
      "text": "香干片在盘底铺一层，撒上豆豉、姜丝与蒜片，再铺腊肉片。",
      "time_min": 4,
      "heat": "无火",
      "tip": "腊肉铺在上面，蒸时油往下渗，香干才入味。",
      "visual_cue": "腊肉片覆盖整齐，肥瘦相间"
    },
    {
      "n": 4,
      "text": "淋上生抽、米酒与白糖，撒小米椒圈，上锅大火蒸二十分钟。",
      "time_min": 21,
      "heat": "大火",
      "tip": "必须水开上锅，蒸足时间腊肉的油才渗得进香干。",
      "visual_cue": "盘中积起清亮的油汁，香气冲鼻"
    },
    {
      "n": 5,
      "text": "取出撒上葱花，把菜籽油烧到冒烟泼在葱花上激香即可上桌。",
      "time_min": 3,
      "heat": "大火",
      "tip": "热油一泼，豆豉和葱的香气立刻炸开。",
      "visual_cue": "葱花卷起放香，油光浮在表面"
    }
  ],
  "tips": [
    "腊肉咸，生抽要少放，先尝咸淡再调。",
    "香干选压得紧实的，蒸完不散还更有嚼头。",
    "加几片笋干垫底，吸油又增脆，是湘西的做法。"
  ],
  "common_mistakes": [
    "腊肉不蒸直接切，硬得切不动还厚薄不匀。",
    "香干铺在腊肉上面，油渗不下去，底下全是干片。",
    "蒸的时间不够，腊肉发硬、香干还是寡淡的。"
  ],
  "substitutions": [
    {
      "original": "香干",
      "substitute": "豆干",
      "ratio": "250克:250克",
      "note": "豆干更薄，蒸的时间减三分钟。"
    },
    {
      "original": "腊肉",
      "substitute": "腊肠",
      "ratio": "200克:200克",
      "note": "腊肠偏甜，白糖可以省去。"
    }
  ],
  "variations": [
    "把香干换成霉干菜同蒸，吸油后咸香浓，是湘中老做法。",
    "加一勺剁椒在表面同蒸，酸辣更开胃。"
  ],
  "serving_suggestion": "趁热端上桌，腊肉渗出的油汁浇在米饭上最下饭，配一碗清汤也刚好。",
  "storage": "冷藏可存两天，复热须上锅蒸十分钟，微波会令香干变硬。",
