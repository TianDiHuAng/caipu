      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "莲藕去皮切 1.5cm 见方丁，泡在加了几滴醋的清水中 5 分钟，捞出沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "泡醋水能防氧化变黑，也让藕丁更脆。",
      "visual_cue": "藕丁洁白、表面无黏液"
    },
    {
      "n": 2,
      "text": "小碗把香醋 15ml、生抽、白糖、盐、玉米淀粉与 30ml 清水调成碗汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "碗汁提前调好，藕丁下锅后要快炒不能停。",
      "visual_cue": "碗汁均匀、无淀粉疙瘩"
    },
    {
      "n": 3,
      "text": "炒锅下 25ml 植物油烧到五成热，下干辣椒段与蒜片小火煸出辣香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "干辣椒变色即可，焦黑会有糊味。",
      "visual_cue": "辣椒转深红、油色微红"
    },
    {
      "n": 4,
      "text": "转大火下藕丁翻炒 90 秒至表面断生，倒入碗汁快速翻匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "藕丁追求脆口，炒过头会粉软。",
      "visual_cue": "藕丁边缘透明、汁液裹匀"
    },
    {
      "n": 5,
      "text": "汁收稠后沿锅边淋剩余 10ml 香醋，撒葱段翻两下出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "第二次淋醋补酸香，热菜更冲。",
      "visual_cue": "酸香扑鼻、藕丁干爽不塌"
    }
  ],
  "tips": [
    "脆藕七孔、粉藕九孔，这道菜要用七孔脆藕。",
    "全程大火短炒，锅气足才够香，出水量也最少。",
    "喜欢麻辣可在煸辣椒时加 2g 花椒增香。"
  ],
  "common_mistakes": [
    "藕丁切好不泡水，下锅前已氧化发黑。",
    "小火慢炒导致藕丁出水，成品软塌不脆。",
    "醋一次全放，热炒后酸味挥发只剩咸味。"
  ],
  "substitutions": [
    {
      "original": "莲藕",
      "substitute": "山药",
      "ratio": "400g 莲藕 ≈ 400g 山药",
      "note": "山药更绵，炒制时间减到 60 秒。"
    },
    {
      "original": "香醋",
      "substitute": "陈醋",
      "ratio": "1:1",
      "note": "酸味更厚重，白糖可加到 7g。"
    }
  ],
  "variations": [
    "家庭简化版：藕丁焯水 40 秒再炒，可缩短炒制时间并保证脆度。",
    "糖醋版：减少干辣椒，醋糖比例加大，做成糖醋藕丁。"
  ],
  "serving_suggestion": "冷热皆宜，配米饭或作为下酒小菜。",
  "storage": "冷藏 2 天，凉食风味更足；不建议冷冻，藕丁会失去脆感。",
