  "steps": [
    {
      "n": 1,
      "text": "牛里脊逆纹切成薄片，加料酒、生抽与少量生粉抓匀腌十分钟。",
      "time_min": 14,
      "heat": "无火",
      "tip": "逆着纹理切，牛里脊才咬得动不塞牙。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "肉片薄而透光，表面带薄浆"
    },
    {
      "n": 2,
      "text": "炒锅倒植物油，下姜片、蒜末、干辣椒与八角炒香，加豆瓣酱炒红油。",
      "time_min": 5,
      "heat": "中火",
      "tip": "豆瓣酱一定要炒出红油，汤底才够香。做之前把料备齐，下锅后就没空切配了。",
      "visual_cue": "锅底浮起红油，香料气味浓"
    },
    {
      "n": 3,
      "text": "加清水烧开，放生抽、老抽与盐调味，转小火熬二十分钟成汤底。",
      "time_min": 25,
      "heat": "小火",
      "tip": "汤底多熬一会儿，香料味才融进水里。这几步照顺序来，味道才会一层层叠上去。",
      "visual_cue": "汤色棕红透亮，表面浮薄油"
    },
    {
      "n": 4,
      "text": "另起锅烧水，下面条煮到八分熟，捞出过一下热水保持筋道。",
      "time_min": 8,
      "heat": "大火",
      "tip": "面条八分熟就捞，泡在汤里还会继续熟。",
      "visual_cue": "面条散开不粘连，掐断中间留白点"
    },
    {
      "n": 5,
      "text": "汤底转大火，下牛里脊片烫四十秒至变色，再下小白菜烫软。",
      "time_min": 4,
      "heat": "大火",
      "tip": "牛里脊片一变色就关火，久煮就柴了。调味宁少勿多，出锅前尝一口再补。",
      "visual_cue": "肉片由红转灰白，边缘微卷"
    },
    {
      "n": 6,
      "text": "面条装碗浇上汤与牛里脊，撒葱花与香菜，淋一勺红油即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "碗要先烫热，面条上桌才不结坨。火候与时间都要盯紧，宁可略短也别过头。",
      "visual_cue": "碗面油光红亮，葱花翠绿点缀"
    }
  ],
  "tips": [
    "牛里脊逆纹切薄片，口感才嫩。火候与时间都要盯紧，宁可略短也别过头。",
    "面条八分熟捞出，泡汤里刚好。做之前把料备齐，下锅后就没空切配了。",
    "汤底先熬香再下面，比一起煮好喝。这几步照顺序来，味道才会一层层叠上去。",
    "碗提前烫热，面条不结坨。锅和案板保持干爽，成菜口感差别很大。"
  ],
  "common_mistakes": [
    "牛里脊顺纹切，怎么煮都咬不动。结果往往一锅好料全被这一步毁掉。",
    "面条煮到全熟再泡汤，上桌就糊了。很多人就在这里翻车，出菜后才发现。",
    "汤底香料没炒香就加水，喝起来寡淡。账面上看是小疏忽，入口立刻能尝出来。",
    "牛里脊下锅后大火久煮，片片发柴。这道菜之所以失败，多半栽在这一步上。"
  ],
  "substitutions": [
    {
      "original": "牛里脊",
      "substitute": "牛腱子",
      "ratio": "400克:400克",
      "note": "需提前炖一小时再切片。"
    },
    {
      "original": "面条",
      "substitute": "米粉",
      "ratio": "500克:500克",
      "note": "更湘式，米粉煮前先泡软。"
    }
  ],
  "variations": [
    "加一个煎蛋卧在面上，早餐更顶饱。口味会更厚一些，适合重口的人。",
    "加一勺剁椒，酸辣味更直接。做法不复杂，家常灶台就能完成。",
    "换成红烧牛里脊块做浇头，更有存在感。风味走向变了，但步骤基本不用改。"
  ],
  "serving_suggestion": "趁热端上桌，先喝一勺汤再拌面，牛里脊嫩、汤头辣，配一碟腌黄瓜条最合适。",
  "storage": "汤与面分开冷藏可放一天；复热汤须烧沸，面条另煮以免糊软。",
