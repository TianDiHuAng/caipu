  "steps": [
    {
      "n": 1,
      "text": "腐竹用温水泡发两小时，泡到完全变软、中间没有硬芯。",
      "time_min": 125,
      "heat": "无火",
      "tip": "温水泡发比冷水快，也不会外烂内硬。",
      "visual_cue": "腐竹柔软，弯曲不折断。"
    },
    {
      "n": 2,
      "text": "泡好的腐竹切成五厘米长的段，用手轻轻挤干多余水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "水分挤干，料汁才挂得住。",
      "visual_cue": "腐竹段干爽，切口整齐。"
    },
    {
      "n": 3,
      "text": "锅里烧水，水开后下腐竹段焯两分钟，捞出过凉水。",
      "time_min": 6,
      "heat": "大火",
      "tip": "焯过再拌，口感更韧也更卫生。",
      "visual_cue": "腐竹段发亮，弹性好。"
    },
    {
      "n": 4,
      "text": "胡萝卜与黄瓜切细丝，用少许盐抓一下杀出水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "杀过水的蔬菜拌好不出汤。",
      "visual_cue": "蔬菜丝变软，盘底有水。"
    },
    {
      "n": 5,
      "text": "碗里放蒜末、小米辣、生抽、米醋、白糖、盐与辣椒油调成料汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "醋和糖的比例可按口味微调。",
      "visual_cue": "料汁酸甜带辣，颜色红亮。"
    },
    {
      "n": 6,
      "text": "腐竹与蔬菜丝放盆里，淋料汁拌匀，撒香菜点香油装盘。",
      "time_min": 5,
      "heat": "无火",
      "tip": "拌的时候用手抓匀，比筷子更均匀。",
      "visual_cue": "每根腐竹都裹上红油。"
    }
  ],
  "tips": [
    "腐竹要选淡黄色、闻着有豆香的，颜色过白可能漂过。",
    "泡发途中换一次清水，能去掉大部分豆腥味。",
    "拌好后冷藏半小时再上桌，入味更透，口感更爽。"
  ],
  "common_mistakes": [
    "用开水泡腐竹，外层烂了里面还是硬的。",
    "腐竹泡好不挤水，拌完盘底全是汤。"
  ],
  "substitutions": [
    {
      "original": "腐竹",
      "substitute": "豆腐皮",
      "ratio": "300g 对 250g",
      "note": "豆腐皮泡发快，只需二十分钟。"
    }
  ],
  "variations": [
    "湖南有的馆子会加一把炸花生米，脆香解辣。"
  ],
  "serving_suggestion": "装盘后撒熟芝麻，作开胃凉菜或配酒。",
  "storage": "冷藏两天，蔬菜出水后倒掉多余汤汁再拌。",
