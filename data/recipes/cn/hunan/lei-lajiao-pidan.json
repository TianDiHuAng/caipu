  "equipment": [
    "炒锅",
    "擂钵",
    "擀面杖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "青椒去蒂洗净擦干水分，整只用刀背轻拍至微微开裂，方便受热起皮。",
      "time_min": 4,
      "heat": "无火",
      "tip": "青椒一定要擦干，下锅才不起油爆。",
      "visual_cue": "青椒表面出现细裂纹、手感变软"
    },
    {
      "n": 2,
      "text": "干锅烧热不放油，把青椒放入中火干煸 6 分钟，边煸边用铲子按压。",
      "time_min": 8,
      "heat": "中火",
      "tip": "按压能让青椒贴锅起虎皮，香味才足。",
      "visual_cue": "青椒表面出现焦黑虎皮、整体塌软"
    },
    {
      "n": 3,
      "text": "煸好的青椒放进擂钵，加 25g 大蒜与 3g 盐，用擀面杖反复捣压成粗泥。",
      "time_min": 5,
      "heat": "无火",
      "tip": "保留一点颗粒感，口感比全泥更好。",
      "visual_cue": "青椒成粗泥、蒜香明显"
    },
    {
      "n": 4,
      "text": "皮蛋剥壳切成 6 瓣，铺在辣椒泥上，撒 15g 小米辣圈。",
      "time_min": 3,
      "heat": "无火",
      "tip": "皮蛋最后放，避免捣压时流失溏心。",
      "visual_cue": "皮蛋块完整、溏心不外流"
    },
    {
      "n": 5,
      "text": "淋入 20ml 生抽、15ml 香醋、10ml 香油与 3g 白糖，上桌前拌开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌的时候轻推，别把皮蛋搅碎。",
      "visual_cue": "酱汁均匀挂住辣椒泥、颜色油亮"
    }
  ],
  "tips": [
    "青椒要选皮薄肉厚的螺丝椒，干煸后香味最冲。",
    "擂的时候加盐同捣，青椒出水更快也更入味。",
    "皮蛋选溏心的，拌开后有膏状口感，比硬心的香。"
  ],
  "common_mistakes": [
    "青椒没擦干就下锅，油星四溅还煸不出虎皮。",
    "全程大火猛煸，青椒外皮焦黑里面还是生的。",
    "把皮蛋和辣椒一起猛捣，成品糊成一团没有层次。"
  ],
  "substitutions": [
    {
      "original": "青椒",
      "substitute": "尖椒",
      "ratio": "300g 对 280g",
      "note": "尖椒更辣，怕辣可去籽。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "15ml 对 15ml",
      "note": "酸味更清爽，适合夏天。"
    }
  ],
  "variations": [
    "蒸制版：青椒上锅蒸 8 分钟再擂，辣味更柔和。",
    "加茄子版：同擂 150g 蒸软茄子，口感更绵。"
  ],
  "serving_suggestion": "作为开胃凉菜上桌，配白饭或拌面条都很下饭。",
  "storage": "冷藏 1 天，皮蛋久泡会发硬，建议当天吃完。",
