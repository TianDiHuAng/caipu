  "steps": [
    {
      "n": 1,
      "text": "豆腐用纱布包好压二十分钟，挤掉多余水分。这一步别着急。",
      "time_min": 22,
      "heat": "无火",
      "tip": "水压不干，丸子就捏不成形。，注意火候。",
      "visual_cue": "豆腐紧实，手按不塌，状态稳定"
    },
    {
      "n": 2,
      "text": "五花肉切半厘米小丁，肥瘦分开。这一步别着急。",
      "time_min": 7,
      "heat": "无火",
      "tip": "丁要小，丸子切开才好看。，注意火候。",
      "visual_cue": "肉丁均匀，肥瘦分明，状态稳定"
    },
    {
      "n": 3,
      "text": "豆腐捏碎，加猪血、肉丁、姜末和盐抓匀。这一步别着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "抓到颜色均匀，馅才抱团。，注意火候。",
      "visual_cue": "馅色深红，质地黏稠，状态稳定"
    },
    {
      "n": 4,
      "text": "加干辣椒碎、五香粉和橘皮末拌匀。这一步别着急。",
      "time_min": 4,
      "heat": "无火",
      "tip": "橘皮去腥提香，别放多。，注意火候。",
      "visual_cue": "香料均匀，香气冲鼻，状态稳定"
    },
    {
      "n": 5,
      "text": "手上抹油，把馅捏成拳头大小的圆球。这一步别着急。",
      "time_min": 8,
      "heat": "无火",
      "tip": "反复摔打几下，丸子才紧实。，注意火候。",
      "visual_cue": "丸子圆整，表面光滑，状态稳定"
    },
    {
      "n": 6,
      "text": "丸子摆进蒸锅，大火蒸四十分钟。这一步别着急。",
      "time_min": 42,
      "heat": "大火",
      "tip": "蒸到按下去有弹性就熟。，注意火候。",
      "visual_cue": "丸子变硬，表面泛油，状态稳定"
    },
    {
      "n": 7,
      "text": "取出晾到完全凉透，再切成半厘米厚的片备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "晾凉再切，切面才不散。，注意火候。",
      "visual_cue": "切面平整，红白相间，状态稳定"
    },
    {
      "n": 8,
      "text": "炒锅倒植物油，把丸子片煎到两面焦香。这一步别着急。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎出焦边，香味才足。，注意火候。",
      "visual_cue": "两面焦褐，油脂渗出，状态稳定"
    }
  ],
  "tips": [
    "豆腐一定要压干，不然丸子捏不紧。，值得留意。",
    "馅要摔打几下，蒸好才不散。，值得留意。",
    "晾凉再切片，切面才整齐。，值得留意。"
  ],
  "common_mistakes": [
    "豆腐水多，丸子一蒸就塌。，值得留意。",
    "盐放少了，晒干的丸子会发酸。，值得留意。",
    "蒸的时间不够，切开还有生血。，值得留意。"
  ],
  "substitutions": [
    {
      "original": "猪血",
      "substitute": "鸭血",
      "ratio": "200 克:200 克",
      "note": "颜色略浅，口感更嫩。"
    },
    {
      "original": "五花肉",
      "substitute": "前腿肉",
      "ratio": "250 克:250 克",
      "note": "更瘦，可多加一点植物油。"
    }
  ],
  "variations": [
    "加一点橘皮和白酒，风味更接近湘西做法。",
    "切片后和蒜苗同炒，更下饭。，值得留意。"
  ],
  "serving_suggestion": "切片煎香配米饭，或炒蒜苗。，效果更稳定。",
  "storage": "冷藏三天，冷冻一个月；复热蒸十分钟。，效果更稳定。",
