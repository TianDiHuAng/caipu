      "items": [
        {
          "name": "辣椒粉",
          "name_en": "chili powder",
          "amount": 30,
          "unit": "g",
          "note": "裹面",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 30,
          "unit": "g",
          "note": "腌制",
          "optional": false
        },
        {
          "name": "白酒",
          "name_en": "baijiu",
          "amount": 30,
          "unit": "ml",
          "note": "杀菌增香",
          "optional": false
        },
        {
          "name": "花椒",
          "name_en": "Sichuan peppercorn",
          "amount": 3,
          "unit": "g",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "竹匾",
    "玻璃罐",
    "干净棉布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "老豆腐 800g 切成 3 厘米见方的块，摆在竹匾上，块与块之间留两指宽空隙。",
      "time_min": 8,
      "heat": "无火",
      "tip": "老豆腐水分少，霉得更好。",
      "visual_cue": "豆腐块大小一致、表面平整"
    },
    {
      "n": 2,
      "text": "豆腐表面盖一层干净棉布，放在阴凉通风处静置 3 天，至表面长出白色绒毛。",
      "time_min": 5,
      "heat": "无火",
      "tip": "温度 20 度左右最合适，太热会发黏。",
      "visual_cue": "豆腐表面覆白色绒毛、无杂色斑"
    },
    {
      "n": 3,
      "text": "白毛豆腐逐块在 30g 盐里滚一圈，让每面都裹上薄薄一层盐。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐要裹匀，少盐的地方容易坏。",
      "visual_cue": "豆腐表面均匀挂盐"
    },
    {
      "n": 4,
      "text": "辣椒粉 30g 与花椒 3g 混匀，把裹盐的豆腐块放进去滚一圈裹满。",
      "time_min": 6,
      "heat": "无火",
      "tip": "辣椒粉裹满才够香，别吝啬。",
      "visual_cue": "豆腐块通体裹满红亮辣椒粉"
    },
    {
      "n": 5,
      "text": "玻璃罐用开水烫过晾干，码入豆腐块，每层撒少许姜末，淋 30ml 白酒。",
      "time_min": 6,
      "heat": "无火",
      "tip": "白酒杀菌，还能让香味更立体。",
      "visual_cue": "豆腐码放紧实、酒香浮出"
    },
    {
      "n": 6,
      "text": "加盖密封，阴凉处继续腌 10 天，至豆腐内部软化入味即可食用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "腌足日子才够软糯，中途别开盖。",
      "visual_cue": "豆腐软糯、红油析出"
    }
  ],
  "tips": [
    "豆腐霉制温度控制在 20 度左右，太热会发黏变臭。",
    "盐要裹匀，任何一角缺盐都可能长杂菌。",
    "全程器具无油无水，这是腌制的底线。"
  ],
  "common_mistakes": [
    "豆腐表面出现黑绿斑点还继续用，已经污染。",
    "盐裹得太少，几天后整罐发臭只能全部丢弃。",
    "罐子沾油没洗净，霉豆腐整罐报废。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "嫩豆腐",
      "ratio": "800g 对 900g",
      "note": "需先压重物脱水 2 小时。"
    },
    {
      "original": "辣椒粉",
      "substitute": "辣椒碎",
      "ratio": "30g 对 35g",
      "note": "颗粒更粗，口感更脆。"
    }
  ],
  "variations": [
    "茶油版：装罐时淋 50ml 茶油浸没，风味更醇。",
    "麻辣版：辣椒粉中拌入 5g 花椒粉。"
  ],
  "serving_suggestion": "配白粥、夹馒头或拌面条，一次取一两块。",
  "storage": "冷藏可存 6 个月，取用须用干净无水的筷子。",
