  "equipment": [
    "炒锅",
    "打蛋碗",
    "漏勺",
    "平盘"
  ],
  "steps": [
    {
      "n": 1,
      "text": "干木耳用温水泡发四十分钟，泡到完全舒展开。",
      "time_min": 45,
      "heat": "无火",
      "tip": "泡发时间不能太长，超过四小时易滋生细菌。",
      "visual_cue": "木耳舒展变厚，捏起来有弹性"
    },
    {
      "n": 2,
      "text": "泡好的木耳剪去根部硬蒂，大朵的撕成小片备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部硬蒂嚼不烂，一定要剪干净。，火候最关键。",
      "visual_cue": "木耳片大小均匀，不见硬蒂"
    },
    {
      "n": 3,
      "text": "汤锅烧开水，木耳下锅焯两分钟捞出沥干。，手法稳一些更好。",
      "time_min": 4,
      "heat": "大火",
      "tip": "焯过的木耳更卫生，炒的时候也不炸锅。",
      "visual_cue": "木耳片颜色转深，表面泛亮"
    },
    {
      "n": 4,
      "text": "鸡蛋打散加白胡椒，打匀到蛋清蛋黄完全融合。",
      "time_min": 3,
      "heat": "无火",
      "tip": "白胡椒去蛋腥，比料酒更适合这道菜。",
      "visual_cue": "蛋液颜色均匀，无成团蛋清"
    },
    {
      "n": 5,
      "text": "炒锅放一半菜籽油烧热，倒蛋液推炒成嫩蛋块盛出。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油热再下蛋，蛋才鼓泡蓬松不发硬。，时间要卡准些。",
      "visual_cue": "蛋块金黄蓬松，边缘起泡"
    },
    {
      "n": 6,
      "text": "锅里补油，下青椒丝大火炒半分钟炒出香味。，动作要轻一点。",
      "time_min": 1,
      "heat": "大火",
      "tip": "青椒先炒出香，整盘味道才立体。，顺序不能颠倒。",
      "visual_cue": "青椒丝颜色深绿，边缘略软"
    },
    {
      "n": 7,
      "text": "下木耳片大火翻炒两分钟，注意木耳会弹溅。，注意观察火候。",
      "time_min": 2,
      "heat": "大火",
      "tip": "木耳受热会炸响，翻动时离锅远一点。",
      "visual_cue": "木耳片弹跳作响，锅底有水汽"
    },
    {
      "n": 8,
      "text": "倒回蛋块加生抽与盐翻匀，撒葱花即可出锅装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "回锅只翻几下，炒久了蛋会老。，量别放多。",
      "visual_cue": "蛋块与木耳均匀交错，葱花翠绿"
    }
  ],
  "tips": [
    "木耳泡发后一定要焯水，口感更脆也安全。",
    "蛋液里加一勺清水，炒出来更嫩。",
    "木耳会炸锅，下锅前尽量沥干水分。",
    "加几片胡萝卜配色更漂亮。，家里做也很方便。"
  ],
  "common_mistakes": [
    "木耳泡了一整夜，泡出异味只能倒掉。",
    "木耳带水直接下锅，油溅得满灶台。，白忙一场很可惜。",
    "蛋炒得太老，吃起来又干又硬。，做出来完全变样。"
  ],
  "substitutions": [
    {
      "original": "木耳",
      "substitute": "香菇",
      "ratio": "60克:100克",
      "note": "鲜香菇切片，炒的时间相同。"
    },
    {
      "original": "鸡蛋",
      "substitute": "鸭蛋",
      "ratio": "4个:3个",
      "note": "腥味略重，白胡椒加倍。"
    }
  ],
  "variations": [
    "加一把韭菜段同炒，辛香更足。，家里人会更爱吃。",
    "放几片腊肉同炒，荤香更浓。，换个花样不单调。"
  ],
  "serving_suggestion": "装盘趁热吃，蛋嫩耳脆，清淡中带着酱香，配粥配饭都合适。",
  "storage": "冷藏一天，复热用小火快炒，木耳不宜反复加热。",
