  "steps": [
    {
      "n": 1,
      "text": "鸡腿肉斩成两厘米见方的带骨小块，用清水冲去血水后沥干。",
      "time_min": 15,
      "heat": "无火",
      "tip": "带骨斩块更香，块要大小一致。",
      "visual_cue": "鸡块表面发白，没有血水渗出。"
    },
    {
      "n": 2,
      "text": "鸡块加盐、料酒与玉米淀粉抓匀，腌十五分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "淀粉抓匀能锁住肉汁，炸出来更嫩。",
      "visual_cue": "鸡块表面裹上一层薄浆。"
    },
    {
      "n": 3,
      "text": "干辣椒剪成段，抖去辣椒籽，花椒挑去杂质备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "辣椒籽炸糊会发苦，尽量抖干净。",
      "visual_cue": "辣椒段红亮，籽基本清空。"
    },
    {
      "n": 4,
      "text": "锅里倒花生油烧到六成热，下鸡块炸至表面金黄捞出。",
      "time_min": 12,
      "heat": "大火",
      "tip": "鸡块下锅别急着翻，定型后再动。",
      "visual_cue": "鸡块表面金黄，边缘微焦。"
    },
    {
      "n": 5,
      "text": "油温升高，鸡块回锅复炸四十秒，捞出沥油。",
      "time_min": 5,
      "heat": "大火",
      "tip": "复炸一次外壳才脆，里面还嫩。",
      "visual_cue": "外皮起小泡，敲着发响。"
    },
    {
      "n": 6,
      "text": "锅留底油，下花椒与干辣椒小火煸出香味，再放蒜姜炒香。",
      "time_min": 6,
      "heat": "小火",
      "tip": "辣椒花椒要用小火，糊了整锅发苦。",
      "visual_cue": "锅里红油浮起，香味冲鼻。"
    },
    {
      "n": 7,
      "text": "倒入鸡块与青椒段，转大火快速翻炒，加生抽与小葱段翻匀，淋香油出锅。",
      "time_min": 5,
      "heat": "大火",
      "tip": "最后大火快炒，让辣香挂上鸡块。",
      "visual_cue": "鸡块红亮油润，辣椒铺满。"
    }
  ],
  "tips": [
    "仔鸡选一斤半左右的小公鸡，肉质嫩、骨头软。",
    "辣椒和花椒的比例按口味调，湖南本地多用朝天椒。",
    "复炸这一步别省，外壳酥、里面还带汁。"
  ],
  "common_mistakes": [
    "鸡块焯水再炸，肉质发柴，鲜味也流失。",
    "辣椒花椒大火干煸，糊味压过一切。"
  ],
  "substitutions": [
    {
      "original": "鸡腿肉",
      "substitute": "整鸡",
      "ratio": "650g 对 800g",
      "note": "整鸡斩块要带骨，炸制时间延长一分钟。"
    }
  ],
  "variations": [
    "湘西一带会加一勺剁椒同炒，酸辣更突出，颜色也更红。"
  ],
  "serving_suggestion": "趁热上桌，配米饭或啤酒，辣椒可挑出不食。",
  "storage": "冷藏两天，回锅干煸一下比微波加热好吃。",
