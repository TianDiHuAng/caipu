  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "滤盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆削皮后切成两毫米粗细的细丝，粗细尽量一致。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刀要快，切得慢丝就粗细不匀，影响受热。",
      "visual_cue": "丝细而匀，断面白净"
    },
    {
      "n": 2,
      "text": "切好的土豆丝立刻泡进清水，反复淘洗到水变清。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洗掉表面的白色浆水，炒出来才爽脆不粘锅。",
      "visual_cue": "水由白浊变清澈，丝不粘连"
    },
    {
      "n": 3,
      "text": "捞出土豆丝充分沥干水分，用手抖散，避免下锅粘连。",
      "time_min": 2,
      "heat": "无火",
      "tip": "水一定要沥干，带水下锅会溅油。",
      "visual_cue": "丝散开不抱团，滤盆无积水"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒烟倒植物油，下花椒和干辣椒段小火炸香后捞出。",
      "time_min": 2,
      "heat": "小火",
      "tip": "花椒炸黑要捞出，留在锅里会带苦味。",
      "visual_cue": "油色微红，香味冲出"
    },
    {
      "n": 5,
      "text": "转大火下蒜片爆香，立刻倒入土豆丝快速翻炒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "全程大火快炒，火小了丝就软塌。",
      "visual_cue": "丝色透亮，翻锅声响脆"
    },
    {
      "n": 6,
      "text": "沿锅边烹入陈醋，加盐和白糖，快速翻匀让味进去。",
      "time_min": 2,
      "heat": "大火",
      "tip": "醋沿锅边淋，香气才冲得起来，不涩口。",
      "visual_cue": "闻到醋酸香，丝身油亮"
    },
    {
      "n": 7,
      "text": "撒葱段翻两下立刻出锅，趁脆劲上桌最好吃。",
      "time_min": 1,
      "heat": "大火",
      "tip": "断生即出锅，多炒一分钟就不脆。",
      "visual_cue": "丝根根分明，咬着带响"
    }
  ],
  "tips": [
    "土豆丝切完要泡洗掉白色浆水，炒后才清爽。",
    "全程大火快炒，时间越短丝越脆，别炒过两分钟。",
    "醋沿锅边淋一圈，酸香更冲，成菜不发涩。"
  ],
  "common_mistakes": [
    "不泡水直接下锅，浆水糊化粘成一坨。",
    "中途转小火慢炒，丝软得没了口感。",
    "醋一次倒太多，酸味盖住土豆香。"
  ],
  "substitutions": [
    {
      "original": "陈醋",
      "substitute": "米醋",
      "ratio": "20 毫升:20 毫升",
      "note": "酸味更柔，颜色浅，需补少许老抽上色。"
    },
    {
      "original": "土豆",
      "substitute": "藕",
      "ratio": "450 克:450 克",
      "note": "口感更脆，炒制时间缩短一分钟。"
    }
  ],
  "variations": [
    "加青椒丝同炒，颜色更好看也添清香。",
    "放一勺剁椒代替干辣椒，湘味更足。"
  ],
  "serving_suggestion": "现炒现吃，脆感最佳，配米饭或粥都合适。",
  "storage": "不建议久放，冷藏一天后再炒会发软，可改作汤料。",
