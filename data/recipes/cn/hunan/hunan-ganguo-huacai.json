  "equipment": [
    "干锅",
    "炒锅",
    "砧板",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "花菜掰成小朵，用淡盐水泡十分钟后沥干水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "泡盐水能逼出缝隙里的小虫，冲净再用。",
      "visual_cue": "花菜花朵紧实，表面不带水珠"
    },
    {
      "n": 2,
      "text": "炒锅烧热不放油，花菜下锅干煸五分钟到边缘微焦。",
      "time_min": 6,
      "heat": "中火",
      "tip": "干煸是这道菜的关键，逼走水分才够香。",
      "visual_cue": "花菜边缘出现焦黄斑点，体积缩小"
    },
    {
      "n": 3,
      "text": "把花菜推到锅边，倒花生油下五花肉片煸到出油卷边。",
      "time_min": 5,
      "heat": "中火",
      "tip": "肉片煸干一点，油脂出来才带得住香味。",
      "visual_cue": "肉片卷成小碗状，锅底积出一层油"
    },
    {
      "n": 4,
      "text": "下干辣椒、蒜片与豆瓣酱，小火炒出红油和酱香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "豆瓣酱最怕大火，一糊就发苦还会发黑。",
      "visual_cue": "油色转红，锅里飘出酱香与辣味"
    },
    {
      "n": 5,
      "text": "把花菜拨回锅中央一起翻炒，淋上生抽与白糖炒匀。",
      "time_min": 3,
      "heat": "大火",
      "tip": "火要开到最大，快炒才能保住花菜的脆感。",
      "visual_cue": "花菜均匀裹上红油，锅气明显"
    },
    {
      "n": 6,
      "text": "加两勺清水，盖上锅盖焖两分钟，让花菜吃进酱汁味道。",
      "time_min": 3,
      "heat": "中火",
      "tip": "干锅底部先刷一层薄油，上桌还能继续加热。",
      "visual_cue": "水汽在锅里打转，花菜变软但仍挺立"
    },
    {
      "n": 7,
      "text": "开盖加盐调味，撒青蒜段翻匀后盛进干锅上桌。",
      "time_min": 3,
      "heat": "大火",
      "tip": "干锅先烧热再盛入，上桌后端下去还能继续加热。",
      "visual_cue": "青蒜翠绿微塌，红油在锅底轻轻晃动"
    }
  ],
  "tips": [
    "花菜先干煸再炒，比直接下锅香得多。",
    "换成腊肉代替五花肉，风味更接近湘西做法。",
    "加一把泡软的干辣椒段，辣香更立体。",
    "剩的干锅加点高汤煮面，一点不浪费。"
  ],
  "common_mistakes": [
    "花菜水分没沥干就下锅，煸不出焦香。",
    "豆瓣酱用大火炒，糊锅后整盘带苦味。",
    "加水太多加盖久焖，花菜软塌没了口感。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "腊肉",
      "ratio": "100克:100克",
      "note": "需先蒸软再切，咸味更重。"
    },
    {
      "original": "花菜",
      "substitute": "西兰花",
      "ratio": "600克:600克",
      "note": "易熟，干煸时间减两分钟。"
    }
  ],
  "variations": [
    "加几片切薄的藕一起炒，口感层次会更丰富。",
    "最后淋一勺辣椒油，颜色和辣度都更足。"
  ],
  "serving_suggestion": "盛进小干锅里端上桌，边加热边吃味道最足。",
  "storage": "冷藏可放两天，复热用炒锅干煸比微波炉好得多。",
