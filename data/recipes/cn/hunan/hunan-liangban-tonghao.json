          "optional": false
        },
        {
          "name": "香醋",
          "name_en": "black vinegar",
          "amount": 10,
          "unit": "ml",
          "note": "提酸",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 8,
          "unit": "ml",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砧板",
    "小锅",
    "擂钵"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茼蒿掐下嫩尖与嫩叶，老梗另作他用，冲洗干净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "只留嫩尖，凉拌才不老不塞牙。",
      "visual_cue": "嫩叶舒展，梗断口泛白"
    },
    {
      "n": 2,
      "text": "小锅烧开清水，茼蒿下锅烫十五秒立刻捞出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "十五秒足够，久烫就塌成一团。",
      "visual_cue": "叶片由灰绿转为深绿"
    },
    {
      "n": 3,
      "text": "捞出的茼蒿马上过一遍凉水，挤干水分后切段。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过凉定色，挤干才不会拌出汤。",
      "visual_cue": "茼蒿成团不滴水，颜色青翠"
    },
    {
      "n": 4,
      "text": "干辣椒剪成小段，大蒜拍碎后剁成米粒大小的粗粒。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蒜要粗剁，细了会呛喉。",
      "visual_cue": "蒜粒大小如米，辣椒段红亮"
    },
    {
      "n": 5,
      "text": "擂钵里放进蒜粒与干辣椒段，加盐一起捣成粗泥。",
      "time_min": 4,
      "heat": "无火",
      "tip": "捣出蒜汁辣油，味道才冲得起来。",
      "visual_cue": "泥体泛红，蒜香扑鼻"
    },
    {
      "n": 6,
      "text": "往擂钵里加入生抽酱油与香醋，用小勺搅匀成料汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "醋后放，香味才留得住。",
      "visual_cue": "料汁红褐，浮着蒜粒"
    },
    {
      "n": 7,
      "text": "茼蒿段放进大碗，浇上料汁与香油，翻拌均匀。",
      "time_min": 3,
      "heat": "无火",
      "tip": "从下往上翻，叶片才不会压烂。",
      "visual_cue": "每片叶子都裹上红亮料汁"
    },
    {
      "n": 8,
      "text": "装盘后静置三分钟，让蒜辣味慢慢渗进菜叶里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "静置片刻，辣味更服帖。",
      "visual_cue": "盘底微见汁水，香气冲鼻"
    }
  ],
  "tips": [
    "茼蒿只取嫩尖，老梗纤维粗，凉拌嚼不烂。",
    "烫十五秒立刻过凉，颜色翠绿，口感也脆。",
    "蒜和辣椒用擂钵捣，比刀切更出味，辣香更立体。"
  ],
  "common_mistakes": [
    "茼蒿烫过头，叶片发黄塌软，拌完全是水。",
    "蒜切得太细，辣味一下冲上来，压住了茼蒿的清香。",
    "料汁提前半小时拌好，醋香散尽，只剩死酸。"
  ],
  "substitutions": [
    {
      "original": "茼蒿",
      "substitute": "菠菜",
      "ratio": "350 克:350 克",
      "note": "菠菜需多烫五秒去草酸。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "10 毫升:10 毫升",
      "note": "酸味更柔，颜色更浅。"
    }
  ],
  "variations": [
    "加一勺剁辣椒同拌，湘味更足，颜色也更红亮。",
    "撒一把炒香的花生碎，口感多一层脆。"
  ],
  "serving_suggestion": "作为开胃前菜，配重口味的腊味菜最解腻。",
  "storage": "现拌现吃，冷藏不超过四小时，久放会出水变黄。",
