  "steps": [
    {
      "n": 1,
      "text": "包菜剥掉外层老叶，用手撕成巴掌大的片，菜梗用刀拍裂。",
      "time_min": 10,
      "heat": "无火",
      "tip": "手撕的断面粗糙，比刀切更挂汁也更好吃。",
      "visual_cue": "菜叶片片分明，菜梗拍出裂纹"
    },
    {
      "n": 2,
      "text": "撕好的包菜放清水里冲洗两遍，捞出沥干水，尽量甩掉叶片上的水。",
      "time_min": 6,
      "heat": "无火",
      "tip": "水分甩干，下锅才炒得脆，不然一锅水汽。",
      "visual_cue": "菜叶表面不见水珠，沥水篮里不积水"
    },
    {
      "n": 3,
      "text": "炒锅大火烧到冒烟，倒花生油，下干辣椒段与蒜片爆出香味。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅要烧透再下油，辣椒才不会只出油不出香。",
      "visual_cue": "辣椒转深红，蒜片边缘起小泡"
    },
    {
      "n": 4,
      "text": "包菜下锅大火快速翻炒两分钟，让每片菜叶都沾上油并受热变软。",
      "time_min": 4,
      "heat": "大火",
      "tip": "全程大火快炒，包菜才脆不出水。",
      "visual_cue": "菜叶由硬变软，边缘微微透明"
    },
    {
      "n": 5,
      "text": "沿锅边淋入香醋，加生抽、盐与白糖，继续大火翻炒一分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "醋沿锅边淋，遇热汽化才带出酸香。",
      "visual_cue": "锅里腾起白气，酸香冲鼻"
    },
    {
      "n": 6,
      "text": "撒葱段翻两下立刻出锅，装盘时不要盖住，保持脆口。",
      "time_min": 2,
      "heat": "大火",
      "tip": "出锅要快，多炒半分钟就塌软出水。",
      "visual_cue": "菜叶油亮脆挺，盘底几乎不见汤汁"
    }
  ],
  "tips": [
    "包菜用手撕不用刀切，断面粗糙更挂汁。",
    "洗完一定要沥干水，带水下锅只会焖出一锅汤。",
    "全程大火快炒，包菜才脆甜不出水。",
    "香醋沿锅边淋下去，酸香才被热气逼出来。"
  ],
  "common_mistakes": [
    "包菜洗完带水下锅，炒出来软塌塌还一汪水。",
    "小火慢炒，包菜出水变黄，完全没有脆感。",
    "醋直接浇在菜上，酸味发闷还有生醋气。",
    "炒好盖着盘子焖着，上桌时已经变成软菜泥。"
  ],
  "substitutions": [
    {
      "original": "包菜",
      "substitute": "娃娃菜",
      "ratio": "600克:600克",
      "note": "更嫩，炒的时间减半分钟。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "25毫升:25毫升",
      "note": "酸味更柔和，糖可减一克。"
    }
  ],
  "variations": [
    "加一小把腊肉片同炒，油脂渗进菜叶里更香。",
    "放几粒花椒一起爆香，麻味更足。",
    "喜欢更辣的可以加两勺剁椒，酸辣翻倍。"
  ],
  "serving_suggestion": "趁热装盘，配白粥或米饭都合适，酸辣开胃，湖南人常拿它当下饭的第一道菜。",
  "storage": "冷藏可放一天，复热用大火快炒一分钟，久了会出水变软。",
