          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 500,
          "unit": "ml",
          "note": "炸制用",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "擀面杖",
    "刀",
    "深锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母倒进温热牛奶里化开，静置五分钟看是否起泡。",
      "time_min": 5,
      "heat": "无火",
      "tip": "牛奶太烫会烫死酵母，手温最好。",
      "visual_cue": "表面浮起细密小泡"
    },
    {
      "n": 2,
      "text": "面粉、白糖、盐混合，中间挖坑倒入蛋液、黄油与酵母牛奶。",
      "time_min": 5,
      "heat": "无火",
      "tip": "黄油要放凉再加，否则会烫结面团。",
      "visual_cue": "粉料聚成粗糙絮状"
    },
    {
      "n": 3,
      "text": "揉成偏硬的面团，盖布在温暖处醒发一小时。",
      "time_min": 60,
      "heat": "无火",
      "tip": "面要揉到光滑，炸出来才不裂。",
      "visual_cue": "面团体积略胀，按压回弹"
    },
    {
      "n": 4,
      "text": "面团擀成一厘米厚的面片，切成两厘米宽的条。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚度均匀，炸色才一致。",
      "visual_cue": "面片平整，条宽一致"
    },
    {
      "n": 5,
      "text": "每条面两端对折，编成简单的麻花或打结形状。",
      "time_min": 12,
      "heat": "无火",
      "tip": "接口捏紧，下锅才不会散。",
      "visual_cue": "形状规整，接口扎实"
    },
    {
      "n": 6,
      "text": "深锅倒植物油烧到一百七十度，下面果小火慢炸。",
      "time_min": 8,
      "heat": "中小火",
      "tip": "油温太高外面焦里面生。",
      "visual_cue": "面果浮起，四周冒小泡"
    },
    {
      "n": 7,
      "text": "翻面炸到两面金黄，用漏勺捞出放在漏网上沥油。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "颜色比想要的金黄略浅时就捞出。",
      "visual_cue": "通体金黄，油珠直落"
    },
    {
      "n": 8,
      "text": "稍放凉后撒一层白糖，堆在盘中即可端上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁温热撒糖，能粘住不滑落。",
      "visual_cue": "表面挂薄薄一层糖霜"
    }
  ],
  "tips": [
    "面团偏硬一点，炸出来才酥不掉渣。",
    "一次别下太多，油温掉下来会吃油。",
    "放凉后密封保存，能保持脆口三天不软。"
  ],
  "common_mistakes": [
    "面团揉得太软，下锅后膨胀变形还吃油。",
    "油温过高，外面焦黑里面还是生的。",
    "炸完堆在一起不沥油，底部回软。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "羊油",
      "ratio": "60 克:60 克",
      "note": "更接近牧区风味，凉后略硬。"
    },
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "150 毫升:140 毫升",
      "note": "奶香变淡，需多加十克糖。"
    }
  ],
  "variations": [
    "面团里加一把芝麻，越嚼越香，口感更丰富。",
    "做成手指粗的短条，配奶茶吃更方便。"
  ],
  "serving_suggestion": "堆成小山装盘，配咸奶茶蘸着吃。",
  "storage": "密封常温存放三天，受潮后可用烤箱一百五十度复烤五分钟。",
