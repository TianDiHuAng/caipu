  "steps": [
    {
      "n": 1,
      "text": "面粉里分次加一百毫升清水，揉成偏硬的光滑面团，盖上湿布醒二十分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "面要硬一点，擀出的面片煮了才不烂。",
      "visual_cue": "面团按下去能回弹"
    },
    {
      "n": 2,
      "text": "羊肉切成两厘米小块，土豆和胡萝卜去皮切丁，洋葱切成细丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "土豆丁切均匀，免得有的烂有的夹生。",
      "visual_cue": "三种料大小接近，码放整齐"
    },
    {
      "n": 3,
      "text": "炒锅放植物油烧热，下羊肉块中火煸到表面收紧微微焦黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "羊肉先煸出油再煮汤，膻味会轻很多。",
      "visual_cue": "肉块表面焦黄，锅内有羊油"
    },
    {
      "n": 4,
      "text": "放洋葱丝炒到透明，再加土豆丁和胡萝卜丁翻炒两分钟。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软才出甜味，这是汤底的底子。",
      "visual_cue": "洋葱透明，蔬菜裹上油光"
    },
    {
      "n": 5,
      "text": "倒入一千一百毫升清水大火烧开，撇净浮沫转中火炖十五分钟。",
      "time_min": 14,
      "heat": "中火",
      "tip": "浮沫一定撇干净，汤才清不发浑。",
      "visual_cue": "汤面几乎无沫，蔬菜开始变软"
    },
    {
      "n": 6,
      "text": "面团擀成薄片切成菱形，抖散下锅煮五分钟，加盐和白胡椒撒小葱。",
      "time_min": 5,
      "heat": "中火",
      "tip": "面片下锅要抖散，粘成坨就煮不透。",
      "visual_cue": "面片浮起，边缘透亮不夹生"
    }
  ],
  "tips": [
    "面团偏硬是关键，软面片下锅立刻糊汤。",
    "羊肉先煸后炖，膻味至少能降下一半来。",
    "白胡椒出锅前放，辛香味道才留得住。"
  ],
  "common_mistakes": [
    "面揉得太软，下锅就散成一锅糊。",
    "羊肉直接下清水，汤色发浑膻味偏重。",
    "土豆和胡萝卜切得大小不一，熟得不一样。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "250 克:250 克",
      "note": "膻味更淡，需多炖十分钟。"
    },
    {
      "original": "面粉",
      "substitute": "现成饺子皮",
      "ratio": "200 克:200 克",
      "note": "省去揉面，切成条直接用。"
    }
  ],
  "variations": [
    "加一把干蘑菇同炖，汤味更厚更鲜。",
    "撒少许孜然粉，风味更接近草原做法。"
  ],
  "serving_suggestion": "连汤带面片盛进大碗，撒小葱趁热喝，配一块馕更顶饱。",
  "storage": "冷藏两天，复热时补少量清水，避免面片吸干汤汁。",
