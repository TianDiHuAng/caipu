  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "酸奶",
          "name_en": "yogurt",
          "amount": 600,
          "unit": "g",
          "note": "原味无糖",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "苹果",
          "name_en": "apple",
          "amount": 120,
          "unit": "g",
          "note": "切小丁",
          "optional": false
        },
        {
          "name": "葡萄干",
          "name_en": "raisin",
          "amount": 30,
          "unit": "g",
          "note": "温水泡软",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 25,
          "unit": "g",
          "note": "按酸度调整",
          "optional": false
        },
        {
          "name": "蜂蜜",
          "name_en": "honey",
          "amount": 15,
          "unit": "g",
          "note": "淋面用",
          "optional": false
        },
        {
          "name": "肉桂粉",
          "name_en": "ground cinnamon",
          "amount": 1,
          "unit": "g",
          "note": "少许增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "滤网",
    "纱布",
    "大碗",
    "小勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酸奶倒在铺了纱布的滤网上，下面架碗接住滤出的乳清。",
      "time_min": 6,
      "heat": "无火",
      "tip": "纱布先用水打湿再铺，酸奶不会粘在布上浪费。",
      "visual_cue": "酸奶堆成小山，布面绷紧，状态分明"
    },
    {
      "n": 2,
      "text": "连碗一起放进冰箱冷藏两小时，滤出水分让质地变浓稠。",
      "time_min": 125,
      "heat": "无火",
      "tip": "滤两小时的酸奶稠得像膏，滤四小时就浓得能切块。",
      "visual_cue": "体积缩小，表面出现细纹，火候正好"
    },
    {
      "n": 3,
      "text": "葡萄干用温水泡十分钟，泡软后沥干水备用即可。",
      "time_min": 11,
      "heat": "无火",
      "tip": "泡过的葡萄干不硬，咬开还有汁，口感差别很大。",
      "visual_cue": "果干鼓胀，颜色转亮，状态到位"
    },
    {
      "n": 4,
      "text": "苹果去皮去核，切成半厘米见方的小丁，泡淡盐水防变色。",
      "time_min": 9,
      "heat": "无火",
      "tip": "苹果丁别切太大，勺子一舀才能和酸奶一起吃。",
      "visual_cue": "果丁均匀，切口不易发褐，颜色清爽"
    },
    {
      "n": 5,
      "text": "滤好的酸奶取出，用勺背压平，表面抹出一层平整的底。",
      "time_min": 3,
      "heat": "无火",
      "tip": "压平是为了铺料好看，也让甜味分布均匀。",
      "visual_cue": "酸奶浓稠，勺压出纹路，看着就有食欲"
    },
    {
      "n": 6,
      "text": "加白糖搅匀，尝一口按酸度调整糖量，别一次加足。",
      "time_min": 3,
      "heat": "无火",
      "tip": "酸奶酸度差别大，尝过再加糖才不会甜得发腻。",
      "visual_cue": "甜酸平衡，质地顺滑，香气已出"
    },
    {
      "n": 7,
      "text": "把苹果丁与葡萄干铺在酸奶表面，摆出分明的两层。",
      "time_min": 4,
      "heat": "无火",
      "tip": "料后铺不拌，吃的时候一勺带一层，口感才有层次。",
      "visual_cue": "果料铺满，颜色分明，层次分明"
    },
    {
      "n": 8,
      "text": "淋蜂蜜、撒肉桂粉，冷藏十分钟后取出上桌即可。",
      "time_min": 13,
      "heat": "无火",
      "tip": "蜂蜜沿勺背淋才成细线，直接倒会堆成一坨。",
      "visual_cue": "蜜线亮泽，粉末轻撒，凉气扑面"
    }
  ],
  "tips": [
    "内蒙牧民把酸奶叫塔日格，滤得越干越稠，酸甜味也更集中。",
    "水果可以按季节替换，蓝莓、桃子都很合适。",
    "滤出的乳清别倒，可以直接喝，也能用来和面。"
  ],
  "common_mistakes": [
    "酸奶没滤直接加水果，十分钟就出汤，碗底全是水。",
    "糖一次加太多，酸味被盖住，吃起来甜得发腻。",
    "苹果丁切好放太久没泡盐水，表面变成褐色。"
  ],
  "substitutions": [
    {
      "original": "酸奶",
      "substitute": "希腊酸奶",
      "ratio": "600克:500克",
      "note": "希腊酸奶本身浓稠，滤一小时就够。"
    },
    {
      "original": "蜂蜜",
      "substitute": "红糖",
      "ratio": "15克:18克",
      "note": "红糖版带焦香，撒上去更像草原风味。"
    }
  ],
  "variations": [
    "加一把炒香的燕麦片，脆感更强，当早餐吃也够饱。",
    "撒一点炒米进去，奶香里多一层谷物焦香，很内蒙。"
  ],
  "serving_suggestion": "装透明玻璃杯分层摆放，配炸馃子和一杯咸奶茶。",
  "storage": "冷藏密封只能存一天，水果出水后会变稀，建议现做现吃。",
