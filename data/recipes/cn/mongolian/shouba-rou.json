  "equipment": [
    "汤锅",
    "漏勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊排剁成 8cm 见方的大块，用清水浸泡 20 分钟泡出血水，中途换水一次。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡出血水，汤才清、膻味才淡。",
      "visual_cue": "水色微红、羊排发白"
    },
    {
      "n": 2,
      "text": "羊排冷水下锅，加料酒与 15g 姜片，大火煮开撇净浮沫。",
      "time_min": 8,
      "heat": "大火",
      "tip": "必须冷水下锅，血沫才随温度升高逼出。",
      "visual_cue": "汤面浮沫撇净、汤色转清"
    },
    {
      "n": 3,
      "text": "转小火加盖煮 50 分钟，中途只撇沫不加水，保持汤面微沸。",
      "time_min": 50,
      "heat": "小火",
      "tip": "全程不加冷水，肉才不柴。",
      "visual_cue": "筷子能轻插进肉、汤色乳白"
    },
    {
      "n": 4,
      "text": "加 12g 盐续煮 5 分钟，让咸味渗入肉中。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盐最后放，肉更易软烂。",
      "visual_cue": "汤味咸鲜、肉块微软"
    },
    {
      "n": 5,
      "text": "大蒜切成细末，加生抽与香醋调成简单的蘸料碟。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蘸碟只放三样，突出羊排本身的鲜味。",
      "visual_cue": "蘸料蒜香浓、色清"
    },
    {
      "n": 6,
      "text": "捞出羊排装盘，撒葱段，浇一勺原汤，趁热蘸料食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "原汤浇肉，肉不干、香气足。",
      "visual_cue": "羊排油亮、肉骨易分离"
    }
  ],
  "tips": [
    "选内蒙草原羔羊排，膻味小、肉质更嫩。",
    "煮肉的原汤撒点葱花就是一碗羊汤，别浪费。",
    "手把肉讲究手抓着啃，配一壶砖茶解腻最地道。"
  ],
  "common_mistakes": [
    "羊排热水下锅，蛋白质瞬间凝固、血水锁在肉里发腥。",
    "中途加冷水，肉质骤然收缩变硬。",
    "一开始就放盐，肉质久煮不烂、口感发柴。"
  ],
  "substitutions": [
    {
      "original": "羊排",
      "substitute": "羊腿肉",
      "ratio": "1200g 羊排 ≈ 1000g 羊腿肉",
      "note": "羊腿肉更瘦，煮制时间减 15 分钟。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋味更柔和，适合不喜酸者。"
    }
  ],
  "variations": [
    "家庭简化版：用高压锅上汽后压 20 分钟，省时且肉更烂。",
    "内蒙牧区版：只用清水与盐，不放姜与料酒，突出羊肉本味。"
  ],
  "serving_suggestion": "大盘装肉，配蘸碟与一碗羊汤，用手抓食最有风味。",
  "storage": "冷藏 2 天，复热加原汤小火煮 5 分钟，勿用微波炉干热。",
