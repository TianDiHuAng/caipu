  "equipment": [
    "汤锅",
    "炒锅",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "口蘑切半厘米厚片，大葱切段，胡萝卜切成筷子粗的丝。",
      "time_min": 10,
      "heat": "无火",
      "tip": "口蘑切厚片才煎得出焦边，切薄了遇热就缩成一片。",
      "visual_cue": "菇片厚薄一致，切面干爽，看着就有食欲"
    },
    {
      "n": 2,
      "text": "炒锅烧热放植物油，油纹散开下羊肉片摊开煎到变色。",
      "time_min": 5,
      "heat": "大火",
      "tip": "羊肉先煎出油，汤才香，肉片摊平别挤成一堆。",
      "visual_cue": "肉片泛白，锅底见油，香气已出"
    },
    {
      "n": 3,
      "text": "羊肉推到锅边，下大葱段和胡萝卜丝炒出香味。",
      "time_min": 4,
      "heat": "中火",
      "tip": "葱段炒出甜味再加水，汤头会明显厚一层。",
      "visual_cue": "葱段透明，胡萝卜上色，层次分明"
    },
    {
      "n": 4,
      "text": "倒入口蘑片翻炒三分钟，让菇面煎出焦边并吸走油香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "口蘑要先煎透到塌下去，生菇味才会散掉。",
      "visual_cue": "菇片塌软，边缘转褐，火候刚好"
    },
    {
      "n": 5,
      "text": "沿锅边淋生抽炒匀，加热水一千二百毫升烧开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "一定加热水，冷水下去肉片会紧，汤也不鲜。",
      "visual_cue": "汤色转琥珀，热气翻腾，状态分明"
    },
    {
      "n": 6,
      "text": "汤滚后撇净浮沫，加盐与黑胡椒，小火煮十分钟出味。",
      "time_min": 12,
      "heat": "小火",
      "tip": "浮沫撇干净汤才清，不撇会有一股膻味。",
      "visual_cue": "汤面清亮，浮沫成团，火候正好"
    },
    {
      "n": 7,
      "text": "另一锅烧水，面条下锅按包装时间煮到八分熟。",
      "time_min": 8,
      "heat": "大火",
      "tip": "面煮八分熟就捞，剩下两分熟交给汤锅吸味。",
      "visual_cue": "面条浮起，中间留一点白心"
    },
    {
      "n": 8,
      "text": "面条捞进汤锅，中火再煮两分钟让面条吸饱汤汁。",
      "time_min": 3,
      "heat": "中火",
      "tip": "面和汤一起煮这两分钟，味才进得去，不是分开装。",
      "visual_cue": "面条膨胀，汤略收稠，状态到位"
    },
    {
      "n": 9,
      "text": "撒一把葱段，连汤带面盛进大碗，趁热端上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "碗先用热水烫过，面上桌不至于三分钟就凉。",
      "visual_cue": "汤面浮葱绿，面条宽厚有光"
    }
  ],
  "tips": [
    "内蒙人吃面讲究汤厚面宽，一碗下去能顶半天放牧的体力。",
    "口蘑换成白蘑也行，鲜味其实是菌菇本身撑起来的。",
    "羊肉片别切太厚，薄片一烫就熟，口感才滑。"
  ],
  "common_mistakes": [
    "口蘑没煎透直接下水，汤里一股生菌味，怎么调味都压不住。",
    "面条煮到全熟再进汤，盛出来发软没嚼劲。",
    "加冷水续汤，肉片骤缩变硬，汤也不甜了。"
  ],
  "substitutions": [
    {
      "original": "羊肉片",
      "substitute": "羊肉块",
      "ratio": "250克:260克",
      "note": "羊肉块要先炖二十分钟再下面，否则咬不动。"
    },
    {
      "original": "生抽",
      "substitute": "盐",
      "ratio": "15毫升:5克",
      "note": "只用盐汤色清亮，但鲜味会薄一点。"
    }
  ],
  "variations": [
    "加一勺辣椒油和一点香菜，汤味立刻冲起来，冬天吃最舒服。",
    "换成荞麦面，口感更硬，也更贴草原的粗粮吃法。"
  ],
  "serving_suggestion": "用大碗盛汤面，撒葱段，配一碟蒜泥和一碗奶茶。",
  "storage": "冷藏可存两天，汤面分开存放；复热时汤先烧开再下面，别整碗微波。",
