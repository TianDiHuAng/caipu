    "total_min": 30
  },
  "servings": 4,
  "flavor": [
    "savory",
    "rich",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 800,
          "unit": "ml",
          "note": "全脂",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 600,
          "unit": "ml",
          "note": "煮茶",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "绿茶",
          "name_en": "green tea",
          "amount": 12,
          "unit": "g",
          "note": "代替砖茶",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 15,
          "unit": "g",
          "note": "增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "滤网",
    "木勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "清水倒进汤锅大火烧开，水翻滚后放入绿茶。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水开再下茶，茶味出得匀。",
      "visual_cue": "水面翻滚，茶叶舒展开"
    },
    {
      "n": 2,
      "text": "转小火煮八分钟，把茶汤煮到颜色深黄带微苦。",
      "time_min": 8,
      "heat": "小火",
      "tip": "茶要煮浓，兑奶后才有骨。",
      "visual_cue": "茶汤深黄，茶香浓烈"
    },
    {
      "n": 3,
      "text": "用滤网滤掉茶叶，茶汤倒回锅里继续保持小火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "滤净茶叶，口感才顺滑。",
      "visual_cue": "茶汤清亮，无茶渣"
    },
    {
      "n": 4,
      "text": "倒入牛奶慢慢搅匀，让茶汤与牛奶完全融合。",
      "time_min": 3,
      "heat": "小火",
      "tip": "边倒边搅，奶才不结皮。",
      "visual_cue": "汤色转为浅奶茶色"
    },
    {
      "n": 5,
      "text": "加盐搅到化开，尝一下咸味是否托得住奶香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "盐少量多次加，宁淡不咸。",
      "visual_cue": "咸味轻微，奶香更突出"
    },
    {
      "n": 6,
      "text": "放入黄油搅到完全融化，让茶面浮起一层油光。",
      "time_min": 2,
      "heat": "小火",
      "tip": "黄油增香，别用大火煮。",
      "visual_cue": "表面浮一层薄油光"
    },
    {
      "n": 7,
      "text": "小火再煮三分钟，让奶与茶的味道充分融合。",
      "time_min": 3,
      "heat": "小火",
      "tip": "微微冒泡就好，别煮开滚。",
      "visual_cue": "饮子浓稠，香气醇厚"
    },
    {
      "n": 8,
      "text": "关火后趁热舀进碗里，配着油炸面食一起喝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热喝，凉了奶味会发闷。",
      "visual_cue": "碗面浮油，热气腾腾"
    }
  ],
  "tips": [
    "茶一定要煮浓，兑奶后才不会被奶味盖住。",
    "盐少量多次加，咸淡以刚好托出奶香为准。",
    "全程小火，牛奶煮开会起皮分层。"
  ],
  "common_mistakes": [
    "茶煮得太淡，喝起来像兑水牛奶。",
    "盐一次放得太多，整锅咸得发苦。",
    "大火把奶煮滚，表面结一层厚奶皮。"
  ],
  "substitutions": [
    {
      "original": "绿茶",
      "substitute": "普洱茶",
      "ratio": "12 克:12 克",
      "note": "汤色更深，茶味更厚。"
    },
    {
      "original": "黄油",
      "substitute": "奶油",
      "ratio": "15 克:20 克",
      "note": "奶香更浓，口感更厚。"
    }
  ],
  "variations": [
    "加一小把炒米进去，喝起来会更香。",
    "撒少许白胡椒粉，暖身效果更好。"
  ],
  "serving_suggestion": "配油炸面食当早茶，暖胃又顶饱。",
  "storage": "冷藏一天，复热时小火加热不要煮沸。",
