  "equipment": [
    "厚底锅",
    "石块",
    "刀",
    "盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鹅卵石洗净后放锅里干烧二十分钟，烧到石头通红发烫。",
      "time_min": 22,
      "heat": "大火",
      "tip": "石头必须烧到通红，全靠它的蓄热把肉焖熟。",
      "visual_cue": "石头通红，滴水立刻汽化"
    },
    {
      "n": 2,
      "text": "羊排和羊腿肉切成拳头大的块，用盐、孜然和黑胡椒抓匀腌二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "肉块要切得大小一致，熟的时间才整齐。",
      "visual_cue": "肉块均匀，表面裹满调料"
    },
    {
      "n": 3,
      "text": "厚底锅底铺一层烧热的石块，码上羊肉块，撒一层盐。",
      "time_min": 6,
      "heat": "无火",
      "tip": "石头一层肉一层码放，别压得太实。",
      "visual_cue": "石块铺满锅底，肉块平铺"
    },
    {
      "n": 4,
      "text": "羊肉上铺土豆、洋葱和胡萝卜，再压上一层烧热的石块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "上层的石头也要烧热，上下夹着焖熟。",
      "visual_cue": "食材铺平，石块盖满"
    },
    {
      "n": 5,
      "text": "沿锅边淋入二百毫升清水，盖严锅盖，中小火焖六十分钟。",
      "time_min": 62,
      "heat": "中小火",
      "tip": "水只淋锅边，别浇在石头上以免炸裂。",
      "visual_cue": "锅边冒白气，无焦味"
    },
    {
      "n": 6,
      "text": "开盖检查羊肉是否脱骨，再盖盖焖二十分钟收干汤汁。",
      "time_min": 22,
      "heat": "小火",
      "tip": "中途尽量不开盖，跑气就焖不烂。",
      "visual_cue": "羊肉一戳就离骨脱骨"
    },
    {
      "n": 7,
      "text": "拣出石块，把肉和蔬菜盛盘，浇上锅底肉汁即可。",
      "time_min": 5,
      "heat": "无火",
      "tip": "石头温度很高，用夹子取千万别用手。",
      "visual_cue": "肉色褐亮，肉汁浓稠"
    }
  ],
  "tips": [
    "石头要先烧透再下锅，靠蓄热把肉焖烂。",
    "肉块大小要一致，否则小的烂了大的还生。",
    "全程尽量不开盖，蒸汽跑掉肉就柴了。"
  ],
  "common_mistakes": [
    "石头没烧热就下锅，肉焖了两小时还是硬。",
    "锅边不加水，锅底干烧出焦糊味。",
    "中途反复开盖，热气跑光肉一直不烂。"
  ],
  "substitutions": [
    {
      "original": "羊排",
      "substitute": "羊腿肉",
      "ratio": "1200 克:1200 克",
      "note": "更瘦，焖的时间缩短十分钟。"
    },
    {
      "original": "土豆",
      "substitute": "南瓜",
      "ratio": "500 克:500 克",
      "note": "更甜，容易焖成泥。"
    }
  ],
  "variations": [
    "锅底垫一层羊尾油，烤出来的肉香更浓。",
    "加一把干辣椒，辛香气味更明显。"
  ],
  "serving_suggestion": "连肉带土豆盛在大盘里，配一碗蒙古奶茶和手抓饼，是草原上的待客大菜。",
  "storage": "冷藏两天，复热加少量清水小火焖十分钟，肉质回软。",
