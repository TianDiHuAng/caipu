        }
      ]
    }
  ],
  "equipment": [
    "炖锅",
    "汤勺",
    "砧板",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉块用清水浸泡二十分钟，泡出血水后捞出沥干。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡出血水，汤才清不腥。",
      "visual_cue": "羊肉颜色变浅，水发红"
    },
    {
      "n": 2,
      "text": "炖锅倒植物油，中火下羊肉块煎到表面变色收紧。",
      "time_min": 6,
      "heat": "中火",
      "tip": "先煎一下，汤味更浓不腥。",
      "visual_cue": "羊肉表面发白微黄"
    },
    {
      "n": 3,
      "text": "加姜片、蒜与洋葱块同炒三分钟，炒出香味。",
      "time_min": 3,
      "heat": "中火",
      "tip": "洋葱炒软，汤底才带甜。",
      "visual_cue": "洋葱变软，香气明显"
    },
    {
      "n": 4,
      "text": "倒入清水后大火烧开，用汤勺撇净表面的浮沫。",
      "time_min": 8,
      "heat": "大火",
      "tip": "浮沫撇干净，汤才透亮。",
      "visual_cue": "汤面清澈，无灰色浮沫"
    },
    {
      "n": 5,
      "text": "转小火盖盖炖四十分钟，中途不要频繁开盖。",
      "time_min": 40,
      "heat": "小火",
      "tip": "小火慢炖，羊肉才软烂不柴。",
      "visual_cue": "羊肉能用筷子扎透"
    },
    {
      "n": 6,
      "text": "放入胡萝卜块与土豆块，继续小火炖十五分钟。",
      "time_min": 15,
      "heat": "小火",
      "tip": "根茎后放，才不会炖成泥。",
      "visual_cue": "土豆软透，边缘略化"
    },
    {
      "n": 7,
      "text": "加盐与黑胡椒调味，搅匀后再用小火煮上三分钟入味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "盐最后放，羊肉才容易炖烂。",
      "visual_cue": "汤味咸鲜，胡椒香冒出"
    },
    {
      "n": 8,
      "text": "关火后撒少量黑胡椒，盛入深碗里趁热食用。",
      "time_min": 2,
      "heat": "无火",
      "tip": "趁热喝，膻味最淡。",
      "visual_cue": "汤色清亮，肉块完整"
    }
  ],
  "tips": [
    "羊肉先泡出血水并煎透，汤才不腥。",
    "浮沫一定要撇干净，汤色才会清亮。",
    "盐最后放，羊肉才容易炖得软烂。"
  ],
  "common_mistakes": [
    "羊肉不泡水就直接炖，汤又腥又浑。",
    "全程开大火，羊肉发柴汤也被煮少。",
    "一开始就放盐，羊肉久炖也炖不烂。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "700 克:700 克",
      "note": "风味更淡，可多放姜片。"
    },
    {
      "original": "土豆",
      "substitute": "白萝卜",
      "ratio": "250 克:250 克",
      "note": "清甜解腻，炖制时间减五分钟。"
    }
  ],
  "variations": [
    "加一把手擀面片同煮，直接当主食。",
    "放少量孜然粒，风味更接近草原做法。"
  ],
  "serving_suggestion": "配咸奶茶与面饼，冬天喝最暖身。",
  "storage": "冷藏三天、冷冻一个月，复热后小火煮开。",
