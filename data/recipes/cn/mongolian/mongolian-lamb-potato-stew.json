          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "铁锅",
    "汤勺",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊肉切成四厘米块，带一点肥膘，用清水泡半小时。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡水去血，膻味能减掉一半。",
      "visual_cue": "水泛淡红，羊肉颜色变浅"
    },
    {
      "n": 2,
      "text": "冷水下锅，加姜片大火煮开，撇净浮沫后捞出。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水起锅，血沫才慢慢逼出来。",
      "visual_cue": "浮沫灰白成片，汤色转清"
    },
    {
      "n": 3,
      "text": "铁锅烧热，把羊肉块下锅干煸到表面收紧出油。",
      "time_min": 8,
      "heat": "中火",
      "tip": "干煸逼出羊油，膻气跟着油跑掉。",
      "visual_cue": "肉块表面焦黄，锅底见油"
    },
    {
      "n": 4,
      "text": "下洋葱块与姜片同炒，炒到洋葱变软微微发甜。",
      "time_min": 5,
      "heat": "中火",
      "tip": "洋葱的甜能压住羊膻，别省这一步。",
      "visual_cue": "洋葱透明出汁，香气冲鼻"
    },
    {
      "n": 5,
      "text": "注入清水没过羊肉，大火烧开后转小火炖五十分钟。",
      "time_min": 55,
      "heat": "小火",
      "tip": "小火微沸，汤清肉不柴。",
      "visual_cue": "汤面偶冒小泡，肉香浓"
    },
    {
      "n": 6,
      "text": "下土豆块与胡萝卜片，继续用小火炖二十分钟。",
      "time_min": 20,
      "heat": "小火",
      "tip": "土豆后放，久炖会散在汤里。",
      "visual_cue": "土豆边缘变钝，筷子能戳透"
    },
    {
      "n": 7,
      "text": "加盐调好味，转中火收汤五分钟让味道更厚实。",
      "time_min": 5,
      "heat": "中火",
      "tip": "收一收汤，味道挂在肉上更香。",
      "visual_cue": "汤汁浓稠，锅边起细密油泡"
    },
    {
      "n": 8,
      "text": "关火前撒少许洋葱碎，连锅端上桌趁热开吃。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热吃，羊油不凝，香气最足。",
      "visual_cue": "汤色琥珀，油花清亮"
    }
  ],
  "tips": [
    "羊肉先泡再冷水焯，膻味去得干净。",
    "干煸这一步别省，逼出羊油，汤才香不腥。",
    "土豆后放，早了会炖化，汤变糊。"
  ],
  "common_mistakes": [
    "羊肉直接下锅炖，浮沫混在汤里，膻味重。",
    "全程大火滚，羊肉发柴，汤色浑浊。",
    "土豆一开始就下锅，最后化在汤里找不着。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "羊排",
      "ratio": "900 克:1000 克",
      "note": "带骨更香，炖制时间多十分钟。"
    },
    {
      "original": "土豆",
      "substitute": "山药",
      "ratio": "450 克:450 克",
      "note": "口感更绵，汤更清甜。"
    }
  ],
  "variations": [
    "加一把干辣椒同炖，辣香更热烈，适合冷天。",
    "起锅前撒一把炒米，多了草原的焦香。"
  ],
  "serving_suggestion": "连锅端上，配手把肉与咸奶茶，就是草原上的一顿正餐。",
  "storage": "冷藏三天，复热添少许清水小火慢炖。",
