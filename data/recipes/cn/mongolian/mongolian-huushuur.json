  "equipment": [
    "擀面杖",
    "平底锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加水揉成光滑面团，盖湿布静置半小时让面筋松弛。",
      "time_min": 33,
      "heat": "无火",
      "tip": "面要和得软硬适中，擀开不缩才好包。",
      "visual_cue": "面团光滑细腻，按压回弹慢"
    },
    {
      "n": 2,
      "text": "羊肉切成半厘米小丁，带些肥肉煎出来才不干。",
      "time_min": 12,
      "heat": "无火",
      "tip": "肉丁比绞肉有嚼感，油也更容易渗进面皮。",
      "visual_cue": "肉丁细小均匀，带白色脂肪"
    },
    {
      "n": 3,
      "text": "洋葱切细丁与蒜末一起拌进羊肉，加孜然、盐和黑胡椒抓匀。",
      "time_min": 10,
      "heat": "无火",
      "tip": "孜然是蒙古肉饼的灵魂，别省这一步。",
      "visual_cue": "馅料湿润抱团，香气辛香"
    },
    {
      "n": 4,
      "text": "面团搓条切成小剂子，擀成直径约十五厘米的薄圆皮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "皮要擀得薄，煎出来才酥脆不硬。",
      "visual_cue": "皮薄透光，边缘略薄"
    },
    {
      "n": 5,
      "text": "每张皮摊上一层馅料铺平，边留一指宽，另取一张皮盖上压紧。",
      "time_min": 15,
      "heat": "无火",
      "tip": "两张皮夹馅，压边要用碗口压实防漏油。",
      "visual_cue": "边缘密实，中间平整鼓胀"
    },
    {
      "n": 6,
      "text": "平底锅倒植物油烧至六成热，肉饼下锅半煎半炸五分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "油量到饼身一半高度即可，太多会油腻。",
      "visual_cue": "饼边起小泡，底部金黄"
    },
    {
      "n": 7,
      "text": "翻面再炸四分钟至两面金黄鼓起，捞出沥油趁热吃。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鼓起说明里面已经熟透，没鼓就再炸两分钟。",
      "visual_cue": "两面金黄酥脆，切开冒热气"
    }
  ],
  "tips": [
    "馅料别铺太厚，否则皮焦了馅还没熟。",
    "油温六成热下锅，太低会吸油变韧。",
    "炸好后立着放沥油，平放会积油发软。"
  ],
  "common_mistakes": [
    "两张皮边缘没压紧，下锅后油从缝里灌进去。",
    "油温过低，饼皮吸满油，咬一口都是油腻味。",
    "馅料铺太满太厚，皮煎糊了里面还带生。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "500 克:500 克",
      "note": "加十克油补脂肪，口感稍紧。"
    },
    {
      "original": "孜然",
      "substitute": "花椒粉",
      "ratio": "6 克:5 克",
      "note": "换成麻香，更接近家常口味。"
    }
  ],
  "variations": [
    "馅里加一把切碎的小葱，香气更清亮。",
    "把半煎半炸改成干烙，热量低很多。"
  ],
  "serving_suggestion": "趁热吃，配一碗咸奶茶或清汤解油。",
  "storage": "生坯冷冻两个月，煎时无需解冻多煎三分钟；熟饼冷藏两天，复热用平底锅干烙。",
