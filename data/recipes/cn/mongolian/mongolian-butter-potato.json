        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 40,
          "unit": "g",
          "note": "煎香主力",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 15,
          "unit": "ml",
          "note": "防黄油烧焦",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 6,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "黑胡椒",
          "name_en": "black pepper",
          "amount": 2,
          "unit": "g",
          "note": "现磨",
          "optional": false
        },
        {
          "name": "孜然",
          "name_en": "cumin",
          "amount": 2,
          "unit": "g",
          "note": "少许增香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "平底锅",
    "锅铲",
    "削皮刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "土豆去皮切成三厘米见方的滚刀块，切好泡冷水防氧化。",
      "time_min": 12,
      "heat": "无火",
      "tip": "滚刀块受热面多，比厚片更容易煎出脆皮。",
      "visual_cue": "块形带棱角，大小均匀，切面湿润"
    },
    {
      "n": 2,
      "text": "汤锅烧开水加一小勺盐，土豆块下锅煮八分钟到半熟。",
      "time_min": 10,
      "heat": "中火",
      "tip": "先煮到半熟，煎的时候里面才熟，外面也不焦。",
      "visual_cue": "块边变软，筷子能插进表层"
    },
    {
      "n": 3,
      "text": "捞出沥干水，摊在盘子里晾五分钟让表面水分蒸发。",
      "time_min": 7,
      "heat": "无火",
      "tip": "表面湿的下锅只会炸油，晾干才有那种脆壳。",
      "visual_cue": "块面干爽，不见水汽，层次分明"
    },
    {
      "n": 4,
      "text": "平底锅放黄油与植物油，小火让黄油化开起细泡。",
      "time_min": 3,
      "heat": "小火",
      "tip": "黄油加一点植物油，奶香留住还不容易烧黑。",
      "visual_cue": "黄油化开，泡沫细密，奶香浮起"
    },
    {
      "n": 5,
      "text": "土豆块平铺进锅，中小火煎六分钟，中途别翻动。",
      "time_min": 8,
      "heat": "中火",
      "tip": "下锅先别动，等底面结一层金黄硬壳再翻才不破。",
      "visual_cue": "底面结壳，边缘金黄，油花翻起"
    },
    {
      "n": 6,
      "text": "翻面继续煎五分钟，让每一面都煎到焦黄发脆。",
      "time_min": 6,
      "heat": "中火",
      "tip": "翻两三次就够，翻太勤块面容易碎成渣。",
      "visual_cue": "各面金黄，边角发脆，香气浓郁"
    },
    {
      "n": 7,
      "text": "撒盐、黑胡椒与孜然，快速翻匀让调料裹在脆壳上。",
      "time_min": 3,
      "heat": "中火",
      "tip": "孜然最后放，早放遇高温会发苦，香味也跑掉。",
      "visual_cue": "调料裹面，颜色深浅不一，火候刚好"
    },
    {
      "n": 8,
      "text": "关火撒葱花，利用锅温把葱香激出来，连锅端桌上。",
      "time_min": 2,
      "heat": "无火",
      "tip": "葱花不要下锅炒，靠余温烫香才够清新。",
      "visual_cue": "葱花翠绿，油光匀亮，奶香混葱香"
    }
  ],
  "tips": [
    "草原上奶食多，黄油煎土豆是牧民家里最省事的一道配菜。",
    "土豆先煮再煎是关键，省掉这一步很难外脆里松。",
    "配手把肉和咸奶茶一起吃，奶香和肉香很搭。"
  ],
  "common_mistakes": [
    "土豆没煮熟就煎，外面焦了里面还是硬的。",
    "黄油大火烧到变色，整锅带一股焦苦味。",
    "土豆下锅就急着翻，块面碎了变成土豆碎。"
  ],
  "substitutions": [
    {
      "original": "黄油",
      "substitute": "羊油",
      "ratio": "40克:35克",
      "note": "羊油版更贴近草原风味，膻香重，配羊肉最合适。"
    },
    {
      "original": "孜然",
      "substitute": "辣椒粉",
      "ratio": "2克:2克",
      "note": "换成辣椒粉就是香辣口，孩子吃可以省掉。"
    }
  ],
  "variations": [
    "加一把切片的培根同煎，咸香更足，可以当主菜吃。",
    "出锅前撒一把奶酪碎，进烤箱烤三分钟做成焗土豆。"
  ],
  "serving_suggestion": "连锅端上桌，配手把肉、奶豆腐和一碗热奶茶。",
  "storage": "冷藏可存两天，复热用平底锅干煎三分钟，微波炉会让它变软塌。",
