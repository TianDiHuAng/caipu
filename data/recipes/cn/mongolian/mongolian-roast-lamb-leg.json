  "equipment": [
    "烤箱",
    "烤盘",
    "锡纸",
    "刷子",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "羊腿肉用厨房纸吸干表面血水，用叉子在两面扎出小孔。",
      "time_min": 10,
      "heat": "无火",
      "tip": "扎孔是为了让盐和孜然进到肉里，别只在表面抹一层。",
      "visual_cue": "肉面布满细孔，血水吸净，手感干爽"
    },
    {
      "n": 2,
      "text": "盐、一半孜然、黑胡椒与红椒粉混合，均匀抹在整块羊肉上。",
      "time_min": 8,
      "heat": "无火",
      "tip": "盐要一次抹足，中途再加就只停在表面，进不去肉里。",
      "visual_cue": "肉面裹满红褐粉料，颜色均匀"
    },
    {
      "n": 3,
      "text": "抹好的羊肉盖上保鲜膜，冷藏腌制两小时让味道渗进去。",
      "time_min": 125,
      "heat": "无火",
      "tip": "时间紧也要腌四十分钟，不然只是表面有咸味。",
      "visual_cue": "肉色转深，表面微微出水，火候正好"
    },
    {
      "n": 4,
      "text": "烤箱预热到二百二十度，烤盘铺锡纸，铺上洋葱片、大蒜与大葱段。",
      "time_min": 12,
      "heat": "无火",
      "tip": "葱和洋葱垫在肉下面，能防粘还能把羊膻味吸走。",
      "visual_cue": "烤盘铺满葱段，热气升腾，状态到位"
    },
    {
      "n": 5,
      "text": "羊肉放在葱上，表面刷一层植物油，放进烤箱中层。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷油是把水分封在肉里，烤完切开才不会发柴。",
      "visual_cue": "肉面油光发亮，烤盘入炉，颜色清爽"
    },
    {
      "n": 6,
      "text": "二百二十度烤二十分钟让表面定型上色，逼出表层油脂。",
      "time_min": 21,
      "heat": "大火",
      "tip": "先高温定型，后面转低温慢烤才外焦里嫩。",
      "visual_cue": "表面焦褐，盘底积出羊油，看着就有食欲"
    },
    {
      "n": 7,
      "text": "温度降到一百七十度，盖锡纸再烤四十分钟到内部熟透。",
      "time_min": 42,
      "heat": "中火",
      "tip": "盖锡纸能挡住上火，肉不会烤干，里外熟得均匀。",
      "visual_cue": "锡纸鼓起，香气从缝里冒出"
    },
    {
      "n": 8,
      "text": "揭掉锡纸，撒剩下的孜然，再烤十分钟把表皮烤脆。",
      "time_min": 12,
      "heat": "中火",
      "tip": "最后这十分钟别走开，孜然很容易烤焦发苦。",
      "visual_cue": "表皮起脆壳，孜然香扑鼻，香气已出"
    },
    {
      "n": 9,
      "text": "出炉静置十分钟再切厚片，让肉汁在切面上重新分布。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刚出炉就切，肉汁全流到盘里，肉片会发干。",
      "visual_cue": "切面微粉，肉汁锁在纤维里"
    }
  ],
  "tips": [
    "草原烤羊腿讲究外皮焦脆、里面带汁，全程不用水煮。",
    "配一碟蒜泥和一杯咸奶茶，是最接近草原的吃法。",
    "羊腿肉尽量选带一点筋膜的，烤完更香也不发干。"
  ],
  "common_mistakes": [
    "羊肉没吸干水就抹料，烤的时候出水，表面一直不上色。",
    "全程大火烤，外皮焦黑，里面还是生的。",
    "出炉立刻切，肉汁全流出来，切片干得像柴。"
  ],
  "substitutions": [
    {
      "original": "羊腿肉",
      "substitute": "羊肉块",
      "ratio": "1200克:1100克",
      "note": "用羊肉块要缩到三十五分钟，块小熟得快。"
    },
    {
      "original": "红椒粉",
      "substitute": "辣椒粉",
      "ratio": "4克:3克",
      "note": "辣椒粉更辣，家里人怕辣可以省掉不放。"
    }
  ],
  "variations": [
    "腌料里加一勺酸奶，肉会更嫩，膻味也淡一层。",
    "烤到最后十分钟刷一层蜂蜜水，表皮焦糖化，颜色更漂亮。"
  ],
  "serving_suggestion": "切厚片上桌，配蒜泥、孜然碟和一碗热咸奶茶。",
  "storage": "冷藏可存三天，冷冻一个月；复热用烤箱一百八十度烤八分钟，别用微波。",
