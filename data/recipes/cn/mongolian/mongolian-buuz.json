    "刀",
    "砧板",
    "大碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加水和成偏硬的面团，盖上湿布静置半小时让面筋松弛。",
      "time_min": 35,
      "heat": "无火",
      "tip": "面团要和得比饺子皮稍硬，蒸后才不塌。",
      "visual_cue": "面团光滑，按压回弹慢"
    },
    {
      "n": 2,
      "text": "羊肉切成一厘米以下的细丁，肥瘦比例约三比七更有汁水。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切丁比绞碎更香，嚼得到肉的颗粒感。",
      "visual_cue": "肉丁细而均匀，带白色脂肪"
    },
    {
      "n": 3,
      "text": "洋葱切细丁，与蒜末、孜然、盐和黑胡椒一起拌进羊肉里。",
      "time_min": 10,
      "heat": "无火",
      "tip": "洋葱出水能代替额外加水，馅才不干。",
      "visual_cue": "馅料湿润抱团，香气辛香"
    },
    {
      "n": 4,
      "text": "馅料淋植物油拌匀，冷藏十分钟让调味融合。",
      "time_min": 10,
      "heat": "无火",
      "tip": "冷藏能让脂肪凝固，包的时候更好操作。",
      "visual_cue": "馅料紧实，不出水"
    },
    {
      "n": 5,
      "text": "面团搓条切小剂子，擀成中间厚边缘薄的圆皮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "皮中间留厚，兜住肉汁才不破底。",
      "visual_cue": "皮圆而薄，中心略厚"
    },
    {
      "n": 6,
      "text": "每张皮放一勺馅，捏出褶子收口成小包子状，顶部留一个小孔。",
      "time_min": 20,
      "heat": "无火",
      "tip": "顶部留孔是蒙古蒸饺的标志，蒸汽能排出。",
      "visual_cue": "褶子均匀，顶部有指头大的口"
    },
    {
      "n": 7,
      "text": "蒸笼铺湿布摆入生坯，水开后大火蒸十八分钟，关火焖两分钟取出。",
      "time_min": 20,
      "heat": "大火",
      "tip": "焖两分钟再开盖，皮不会骤然回缩发硬。",
      "visual_cue": "皮半透明，底部干爽不粘"
    }
  ],
  "tips": [
    "羊肉的肥瘦比例很关键，太多瘦肉蒸出来发柴。",
    "面团偏硬比偏软好，软了蒸完会瘫成饼。",
    "蒸笼布要打湿拧干，否则底皮粘住撕破。"
  ],
  "common_mistakes": [
    "面团和得太软，蒸好后全部塌陷流汁。",
    "羊肉切得太大块，皮薄馅大蒸不透。",
    "馅料一次加太多汤汁，包的时候漏底烂皮。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "牛肉",
      "ratio": "500 克:500 克",
      "note": "加十毫升油补足脂肪，口感稍紧实。"
    },
    {
      "original": "孜然",
      "substitute": "花椒粉",
      "ratio": "6 克:5 克",
      "note": "香气换成麻香，更接近中式风味。"
    }
  ],
  "variations": [
    "馅里加一小块羊尾油，蒸出来更油润多汁。",
    "把蒸改成煎，底部煎脆再加水焖，就是锅贴做法。"
  ],
  "serving_suggestion": "趁热连蒸笼上桌，配一碗奶茶或清茶解腻。",
  "storage": "生坯可冷冻一个月，蒸时无需解冻多蒸五分钟；熟饺冷藏两天，复蒸五分钟。",
