  "steps": [
    {
      "n": 1,
      "text": "五花肉整方冷水下锅，加一半料酒和几片姜，中火煮十五分钟捞出，刮净皮上残毛。",
      "time_min": 20,
      "heat": "中火",
      "tip": "整方先焯定形，炖的时候才不塌，切块也方正。",
      "visual_cue": "肉皮收紧发白，表面无毛茬。"
    },
    {
      "n": 2,
      "text": "砂锅底垫大葱段和姜片，肉皮朝下放入方肉，加清水没过肉面三分之二。",
      "time_min": 5,
      "heat": "无火",
      "tip": "垫葱姜防粘底，也让肉不直接接触锅壁，受热更匀。",
      "visual_cue": "方肉稳放锅中，水面漫过肉块大半。"
    },
    {
      "n": 3,
      "text": "加入生抽、老抽、剩余料酒、八角、桂皮和盐，大火烧开后撇净浮沫。",
      "time_min": 10,
      "heat": "大火",
      "tip": "浮沫撇净汤才亮，后面收汁才红润不浑。",
      "visual_cue": "汤色深红，浮沫聚在锅边。"
    },
    {
      "n": 4,
      "text": "转小火加盖炖九十分钟，把方肉翻面让皮朝上，加一半冰糖再炖六十分钟。",
      "time_min": 155,
      "heat": "小火",
      "tip": "冰糖分两次下，前一半入底味，后一半提亮增稠。",
      "visual_cue": "肉皮微颤，汤汁收到一半。"
    },
    {
      "n": 5,
      "text": "加剩余冰糖和香醋，开中火收汁，边收边用勺把汤汁淋在肉面上，收到浓稠挂勺。",
      "time_min": 15,
      "heat": "中火",
      "tip": "收汁时勤淋汁，肉面才红亮，别让锅底焦掉。",
      "visual_cue": "汤汁红亮浓稠，肉面泛光。"
    },
    {
      "n": 6,
      "text": "方肉盛进深盘，浇上浓汁，配焯熟的时令菜上桌，吃时用勺分块。",
      "time_min": 5,
      "heat": "无火",
      "tip": "别急着切，整方上桌用勺分，肉汁不流失。",
      "visual_cue": "肉方颤而不散，皮面油亮红褐。"
    }
  ],
  "tips": [
    "方肉选肥瘦相间、皮厚的下五花，炖足时间才酥而不烂。",
    "冰糖用量别省，苏式酱方讲究甜出头、咸收口。",
    "砂锅比铁锅保温稳，小火慢炖两小时肉才入口即化。"
  ],
  "common_mistakes": [
    "火太大一直滚，肉皮破裂、肥肉化尽，只剩一堆瘦肉渣。",
    "冰糖一次全放，前期糖分焦化，汤汁发苦。",
    "收汁时不管锅，糖分沉底糊锅，整锅带焦味。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪蹄膀",
      "ratio": "1:1.1",
      "note": "蹄膀胶质更多，炖的时间延长三十分钟，油要撇净。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "1:1",
      "note": "白糖上色快，收汁时缩短三分钟，免得过甜发腻。"
    }
  ],
  "variations": [
    "苏州老法在锅底垫一层猪皮同炖，胶质更厚，汤汁挂得更牢。",
    "有的店家加一小把干山楂同炖，肉更易酥，还能解腻。"
  ],
  "serving_suggestion": "整方上桌用勺分食，配白饭与一盘清炒时蔬；剩下的汤汁拌面极香。",
  "storage": "冷藏可存三日，冷冻两周；复热上锅蒸二十分钟，汤汁另收浓再淋。",
