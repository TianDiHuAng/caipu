  "equipment": [
    "炒锅",
    "锅铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄鳝用开水烫三十秒去黏沫，冲净后去骨切成五厘米长的丝。",
      "time_min": 12,
      "heat": "无火",
      "tip": "烫到表皮发白就捞出，久了肉散。",
      "visual_cue": "鳝丝表面洁白、不见黏液"
    },
    {
      "n": 2,
      "text": "鳝丝加料酒与少许盐抓匀腌十分钟，生姜与大蒜切末备用。",
      "time_min": 11,
      "heat": "无火",
      "tip": "腌十分钟去腥，别腌太久出水。",
      "visual_cue": "鳝丝表面微黏、闻不到土腥味"
    },
    {
      "n": 3,
      "text": "炒锅下四十毫升植物油烧热，放姜末与蒜末炒香，倒入鳝丝大火煸炒两分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "锅要够热，鳝丝才不断不碎。",
      "visual_cue": "鳝丝卷曲发亮、锅底无汤水"
    },
    {
      "n": 4,
      "text": "加生抽、老抽、白糖与清水烧开，转中火烧三分钟至入味。",
      "time_min": 5,
      "heat": "中火",
      "tip": "汤汁收到一半就够，留汁才润。",
      "visual_cue": "鳝丝呈酱红、汤汁微微发稠"
    },
    {
      "n": 5,
      "text": "淋香醋、香油与白胡椒翻匀，盛入盘中，中间扒出一个小坑。",
      "time_min": 2,
      "heat": "中火",
      "tip": "醋最后放，酸香才不挥发。",
      "visual_cue": "鳝糊油润发亮、坑中可见汤汁"
    },
    {
      "n": 6,
      "text": "鳝糊中间撒葱花与姜丝，浇上烧至冒烟的二十毫升植物油，趁热上桌。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油一定要烧到冒烟，浇下去才有响声。",
      "visual_cue": "盘中吱吱作响、葱香冲鼻"
    }
  ],
  "tips": [
    "买鳝丝时选粗细均匀的，煸炒才一齐成熟。",
    "汤汁不要收太干，鳝糊讲究油润。",
    "响油要当着客人的面浇，声音就是招牌。"
  ],
  "common_mistakes": [
    "鳝丝下锅时油温不够，出水变成煮鳝丝。",
    "翻动太用力，鳝丝断成碎末不成形。",
    "响油的油温不足，浇上去没有响声还带生油味。"
  ],
  "substitutions": [
    {
      "original": "黄鳝",
      "substitute": "虾仁",
      "ratio": "500g 对 350g",
      "note": "口感不同，炒制时间减半。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "10ml 对 10ml",
      "note": "酸味更直，用量可略减。"
    }
  ],
  "variations": [
    "加二十克笋丝同炒，口感更脆爽。",
    "把鳝丝换成鳝段红烧，是另一路的浓油赤酱做法。"
  ],
  "serving_suggestion": "趁热吃，配米饭或拌阳春面都非常合适。",
  "storage": "当天吃完最佳，鳝类隔夜后腥味会加重。",
