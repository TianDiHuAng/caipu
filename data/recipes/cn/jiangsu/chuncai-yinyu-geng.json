  "equipment": [
    "汤锅",
    "滤网",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "莼菜 200g 用清水反复冲洗三遍，去掉罐藏的酸味，泡在清水中备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "莼菜表面黏液要留住，别用力搓。",
      "visual_cue": "莼菜卷曲、水清无酸味"
    },
    {
      "n": 2,
      "text": "银鱼 150g 用淡盐水轻洗两遍，挑去杂质后沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "银鱼很嫩，冲洗时动作要轻。",
      "visual_cue": "银鱼雪白、无泥沙"
    },
    {
      "n": 3,
      "text": "汤锅倒 900ml 高汤与姜片烧开，捞出姜片后下银鱼煮 3 分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "银鱼一下锅变白就熟，别久煮。",
      "visual_cue": "银鱼浮起、汤面微白"
    },
    {
      "n": 4,
      "text": "撇去汤面浮沫，加 4g 盐与 2g 白胡椒粉调味，再下莼菜煮 2 分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "莼菜久煮会失去滑嫩口感。",
      "visual_cue": "莼菜舒展、汤色清亮"
    },
    {
      "n": 5,
      "text": "12g 淀粉调水分次淋入勾薄芡，边倒边搅至汤体微微浓稠。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芡要薄，太厚会压住莼菜的滑。",
      "visual_cue": "汤体透亮、勺背挂薄芡"
    },
    {
      "n": 6,
      "text": "2 个鸡蛋取蛋清打散，关火后慢慢淋入汤中轻推成蛋花，淋 5ml 香油。",
      "time_min": 2,
      "heat": "无火",
      "tip": "蛋清要关火淋，蛋花才细嫩不散。",
      "visual_cue": "蛋花成细丝、汤面浮油光"
    }
  ],
  "tips": [
    "莼菜只用清水冲，搓洗会把滑嫩的黏液洗掉。",
    "银鱼下锅变白即熟，久煮就散成渣。",
    "蛋清关火后淋，蛋花才细如云絮。"
  ],
  "common_mistakes": [
    "莼菜泡太久，特有的清香全跑光。",
    "银鱼大火滚煮，鱼肉散得汤里全是碎末。",
    "芡勾得太厚，整锅汤直接变成糊状。"
  ],
  "substitutions": [
    {
      "original": "银鱼",
      "substitute": "虾仁",
      "ratio": "150g 对 150g",
      "note": "需切小丁，煮制时间加 1 分钟。"
    },
    {
      "original": "高汤",
      "substitute": "清水",
      "ratio": "900ml 对 900ml",
      "note": "鲜味变淡，盐可加 1g。"
    }
  ],
  "variations": [
    "加 30g 火腿丝同煮，汤里多一层咸鲜。",
    "起锅前滴 3ml 香醋，酸香解腻。"
  ],
  "serving_suggestion": "趁热盛碗，配一只蟹粉小笼，是江南春天的标准搭配。",
  "storage": "现做现吃，莼菜隔夜会失去滑嫩口感。",
