  "steps": [
    {
      "n": 1,
      "text": "大米淘洗两遍后加清水浸泡三十分钟，捞出沥干。",
      "time_min": 30,
      "heat": "无火",
      "tip": "泡过的米吸水均匀，焖出来粒粒分明不夹生。",
      "visual_cue": "米粒发白饱满，用手一捏就断"
    },
    {
      "n": 2,
      "text": "莲藕削皮，先切厚片再改刀成一厘米见方的小丁。",
      "time_min": 8,
      "heat": "无火",
      "tip": "藕丁大小要和咸肉丁接近，熟度才一致。",
      "visual_cue": "藕丁大小均匀，切面洁白"
    },
    {
      "n": 3,
      "text": "切好的藕丁立刻泡进清水里，防止氧化发黑备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "藕丁见空气就发黑，泡水能保持颜色。",
      "visual_cue": "藕丁浸在水中，颜色白净"
    },
    {
      "n": 4,
      "text": "咸肉切小丁，香菇泡发后挤干切成同样大小的丁。",
      "time_min": 6,
      "heat": "无火",
      "tip": "三样丁大小接近，吃起来口感才协调。",
      "visual_cue": "三种丁均匀，香菇水留用"
    },
    {
      "n": 5,
      "text": "炒锅放花生油，下咸肉丁用小火慢慢煸出油和香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "咸肉煸到微焦，油香才出来，饭才不寡淡。",
      "visual_cue": "肉丁边缘微焦，锅里油明显增多"
    },
    {
      "n": 6,
      "text": "下藕丁与香菇丁翻炒两分钟，加生抽与盐调味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "配料先炒香再焖，饭的味道才有层次。",
      "visual_cue": "丁料裹上浅酱色，香气浓"
    },
    {
      "n": 7,
      "text": "倒入沥干的大米翻炒一分钟，让每粒米都裹上油。",
      "time_min": 1,
      "heat": "中火",
      "tip": "米粒裹油焖出来更松散，也不容易粘锅底。",
      "visual_cue": "米粒油亮，颗颗分散不黏"
    },
    {
      "n": 8,
      "text": "全部转进砂锅，加清水到水面高出米面约一指节。",
      "time_min": 3,
      "heat": "无火",
      "tip": "水量比平时焖饭略少，配料本身也带水分。",
      "visual_cue": "水面刚没过米面约一指节"
    },
    {
      "n": 9,
      "text": "大火烧开后转小火焖十八分钟，中途不要开盖。",
      "time_min": 20,
      "heat": "小火",
      "tip": "中途千万别开盖，热气一跑饭就焖成夹生。",
      "visual_cue": "锅边冒白气，听见轻微滋滋声"
    },
    {
      "n": 10,
      "text": "关火撒白胡椒与葱花，盖盖焖五分钟再拌匀盛出。",
      "time_min": 5,
      "heat": "无火",
      "tip": "焖五分钟让水汽回匀，米饭才不粘勺。",
      "visual_cue": "米粒油亮松散，藕丁香脆可见"
    }
  ],
  "tips": [
    "藕丁别切太碎，焖过之后留一点脆口感最好。",
    "咸肉本身有咸味，盐要少量多次尝着加。",
    "用砂锅焖饭锅气足，电饭锅也能做但香味淡。",
    "锅底结出的那层锅巴别扔，拌开吃又香又脆。"
  ],
  "common_mistakes": [
    "米没泡直接焖，外面糊了里面还是硬芯。",
    "水加得太多，焖出来就是一锅稠糊的粥。",
    "藕丁切好搁着不泡水，焖出来整锅都会发黑发灰。"
  ],
  "substitutions": [
    {
      "original": "莲藕",
      "substitute": "荸荠",
      "ratio": "200克:200克",
      "note": "更清甜，焖的时间不变。"
    },
    {
      "original": "咸肉",
      "substitute": "腊肠",
      "ratio": "80克:80克",
      "note": "甜咸风味，盐要减半。"
    }
  ],
  "variations": [
    "再抓一把青豌豆一起同焖，颜色更好看也更清甜。",
    "用泡香菇的水代替清水焖饭，鲜味更浓。"
  ],
  "serving_suggestion": "盛出后配一碗清汤，藕丁脆糯米粒油亮，一口一个层次。",
  "storage": "冷藏两天，复热加一勺水用蒸锅蒸十分钟恢复松软。",
