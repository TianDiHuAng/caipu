  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "小铁勺",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "熟鳝丝用清水冲净血水沥干，切成八厘米长段，粗的顺纹改刀成两半。",
      "time_min": 10,
      "heat": "无火",
      "tip": "鳝丝带血水会有土腥味，冲两遍再下锅才干净。",
      "visual_cue": "鳝丝表面清爽，水色由浑转清。"
    },
    {
      "n": 2,
      "text": "玉米淀粉加清水调成湿芡备用，生抽、老抽、白糖、料酒和盐兑成调味汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "调味汁先兑好，炒鳝丝火大，临时调料容易糊锅。",
      "visual_cue": "汁水调匀呈深红色，芡汁无颗粒。"
    },
    {
      "n": 3,
      "text": "炒锅烧热放植物油，下姜丝小火煸出香味，再下鳝丝转中火翻炒两分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "姜丝先下锅打底，鳝丝的腥气能被姜香压住。",
      "visual_cue": "鳝丝卷曲发亮，姜丝微黄。"
    },
    {
      "n": 4,
      "text": "淋入调味汁和清水，转小火煨三分钟让鳝丝吸味，汤汁收到一半。",
      "time_min": 5,
      "heat": "小火",
      "tip": "清水别多，汤汁过多勾芡后成稀糊，挂不住鳝丝。",
      "visual_cue": "汤汁淹没一半鳝丝，颜色转深。"
    },
    {
      "n": 5,
      "text": "淋入湿芡推匀，加香醋和白胡椒翻两下，盛进深盘中间按出一个小窝。",
      "time_min": 3,
      "heat": "小火",
      "tip": "醋最后放，早放酸味挥发，只剩涩口。",
      "visual_cue": "鳝糊发亮成团，盘心凹陷。"
    },
    {
      "n": 6,
      "text": "鳝糊中间铺上切碎的小葱，香油和少量植物油烧到冒青烟，趁热浇在葱花上发出响声。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油要烧到冒烟再浇，浇不出响声就不叫响油了。",
      "visual_cue": "葱花滋滋作响，香气冲起。"
    }
  ],
  "tips": [
    "鳝丝买现成烫杀去骨的，自己烫鳝容易过火，肉一煮就老。",
    "油温不够浇上去只有油味，务必烧到表面冒青烟。",
    "想吃更浓的鳝香，可把一半植物油换成猪油。"
  ],
  "common_mistakes": [
    "鳝丝没有沥干下锅，油花四溅，鳝丝表面出水发白。",
    "芡汁一次倒太多，鳝糊稠成一坨，凉后结硬块。",
    "响油的油温太低，浇上去没声响，葱香也激不出来。"
  ],
  "substitutions": [
    {
      "original": "黄鳝",
      "substitute": "鳝鱼",
      "ratio": "1:1",
      "note": "两者相同，选粗细均匀的熟鳝丝，粗细混着炒易老嫩不均。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "1:1",
      "note": "米醋酸味更直，用量减两毫升，免得盖住鳝香。"
    }
  ],
  "variations": [
    "苏州店家会在葱花香油里加几只虾米同爆，鲜味更足。",
    "有的做法勾芡前加一小勺糟油，酸香更有层次。"
  ],
  "serving_suggestion": "趁热拌开吃，配一碗白饭最好；也可当面条浇头，汤汁裹面格外香。",
  "storage": "现炒现吃，冷藏可存一日；复热加少量清水小火推散，别大火久煮。",
