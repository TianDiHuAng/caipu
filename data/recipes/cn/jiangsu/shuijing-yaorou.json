    "重物",
    "方形模具"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪蹄膀刮净毛根，用 25g 盐与炒香的花椒反复揉搓，冷藏腌 12 小时。",
      "time_min": 30,
      "heat": "无火",
      "tip": "揉搓要用力，盐才能渗进肉里。",
      "visual_cue": "肉表面发紧、渗出少量血水"
    },
    {
      "n": 2,
      "text": "腌好的蹄膀用清水冲去表面盐粒，冷水下锅焯 5 分钟，捞出刮洗干净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冲洗不到位成品会过咸。",
      "visual_cue": "表皮白净、无浮沫附着"
    },
    {
      "n": 3,
      "text": "猪皮焯水后刮净内侧肥油，切条备用，肥油不刮干净汤汁会浑。",
      "time_min": 10,
      "heat": "中火",
      "tip": "猪皮只留胶质层，成品才透亮。",
      "visual_cue": "猪皮半透明、手感爽滑"
    },
    {
      "n": 4,
      "text": "深锅中放蹄膀、猪皮、葱段、姜片、八角与 30ml 料酒，加水没过，大火烧开撇沫。",
      "time_min": 8,
      "heat": "大火",
      "tip": "水要一次加足，中途不添水。",
      "visual_cue": "汤面浮沫撇净、汤色微清"
    },
    {
      "n": 5,
      "text": "转最小火焖煮 2 小时，直到筷子能轻松穿透肉块。",
      "time_min": 120,
      "heat": "小火",
      "tip": "全程似开非开，大火会把肉煮散。",
      "visual_cue": "筷子一插即透、肉不散架"
    },
    {
      "n": 6,
      "text": "取出蹄膀压平放入方形模具，汤汁过滤后加 5g 盐与 5g 白糖调匀倒入，没过肉面。",
      "time_min": 10,
      "heat": "无火",
      "tip": "汤汁要滤两遍，成品才无渣。",
      "visual_cue": "汤汁清亮、肉块平整铺满"
    },
    {
      "n": 7,
      "text": "表面铺保鲜膜压上重物，冷藏 6 小时至完全凝固定型，切片装盘。",
      "time_min": 240,
      "heat": "无火",
      "tip": "重物压实，切面才紧密不留孔洞。",
      "visual_cue": "冻体弹手不晃、切片透光"
    }
  ],
  "tips": [
    "腌肉时间不要省，12 小时是咸鲜透骨的关键。",
    "切片前把刀用热水烫一下，切面更光滑。",
    "蘸镇江香醋配姜丝，是镇江人的标准吃法。"
  ],
  "common_mistakes": [
    "腌盐过多又没冲净，成品咸得发苦。",
    "猪皮肥油没刮，冷冻后上层浮一层白油。",
    "火候过大把肉煮散，切片时碎成渣。"
  ],
  "substitutions": [
    {
      "original": "猪蹄膀",
      "substitute": "猪前腿肉",
      "ratio": "900g 对 800g",
      "note": "瘦肉多，需加 100g 猪皮补胶质。"
    },
    {
      "original": "花椒",
      "substitute": "花椒粉",
      "ratio": "8g 对 5g",
      "note": "直接拌盐揉搓，省去炒制。"
    }
  ],
  "variations": [
    "镇江传统版：腌料里加 2g 亚硝酸盐替代物不用，改加 10ml 白酒提香。",
    "简易版：用压力锅压 40 分钟代替小火焖 2 小时。"
  ],
  "serving_suggestion": "切 0.3cm 薄片码盘，配镇江香醋与细姜丝同食。",
  "storage": "冷藏 3 天，切片后密封防干；不建议冷冻，解冻后胶质会出水。",
