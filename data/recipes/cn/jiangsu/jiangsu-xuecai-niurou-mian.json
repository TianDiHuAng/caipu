  "steps": [
    {
      "n": 1,
      "text": "牛肉逆着纹理切成两毫米厚的薄片，装碗备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "逆纹切才咬得断，顺纹切出来嚼不动。",
      "visual_cue": "肉片薄而完整，纹理呈横向"
    },
    {
      "n": 2,
      "text": "牛肉片加料酒、姜丝与白胡椒抓匀，腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "腌过的牛肉口感滑嫩，下锅烫一下也不容易发老。",
      "visual_cue": "肉片表面发黏，闻着有姜香"
    },
    {
      "n": 3,
      "text": "雪菜用清水冲洗两遍，挤干水分后再切成细末备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "雪菜本身很咸，冲洗能去一部分盐分。",
      "visual_cue": "雪菜末均匀，挤出的水略带咸味"
    },
    {
      "n": 4,
      "text": "炒锅放花生油烧热，下雪菜末用中小火慢慢煸香。",
      "time_min": 4,
      "heat": "中火",
      "tip": "雪菜要煸干一点，酸咸味才集中不冲。",
      "visual_cue": "雪菜末颜色转深，锅底干爽"
    },
    {
      "n": 5,
      "text": "汤锅倒高汤烧开，把煸好的雪菜末倒进去煮五分钟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "雪菜下汤多煮一会儿，鲜味才彻底融进汤里。",
      "visual_cue": "汤面微微滚起，汤色呈清亮的淡褐色"
    },
    {
      "n": 6,
      "text": "汤里加生抽与盐调味，先尝一下咸淡再决定盐量。",
      "time_min": 2,
      "heat": "中火",
      "tip": "雪菜自带咸味，盐要少放，不然整碗发苦。",
      "visual_cue": "汤色清亮见底，咸鲜味直扑鼻子"
    },
    {
      "n": 7,
      "text": "另起锅烧开水下面条，煮三分钟捞出沥干装碗。",
      "time_min": 6,
      "heat": "大火",
      "tip": "面煮好后一定要沥干，带水倒进碗里会冲淡汤味。",
      "visual_cue": "面条浮起松散，断面无白芯"
    },
    {
      "n": 8,
      "text": "把腌好的牛肉片下进滚汤，烫四十秒变色即关火。",
      "time_min": 1,
      "heat": "大火",
      "tip": "牛肉片薄，一变色就熟，久煮立刻发柴。",
      "visual_cue": "肉片由红转褐，边缘微卷"
    },
    {
      "n": 9,
      "text": "把汤与牛肉浇在面上，撒葱花淋香油即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "汤要滚着浇，牛肉的香气才被激出来。",
      "visual_cue": "碗中汤清面白，牛肉片浮在汤面"
    }
  ],
  "tips": [
    "牛肉最嫩，也可以用肥牛片代替更省事。",
    "雪菜要选腌得透的，酸咸味才正。",
    "汤底用牛骨汤最配，没有就用清水加一勺蚝油。",
    "喜欢辣的最后淋一勺辣椒油，香气一下提起来。"
  ],
  "common_mistakes": [
    "牛肉片切得太厚，下汤烫不透，咬起来还很费牙。",
    "雪菜没冲直接下锅，整碗汤咸得发苦。",
    "面煮好泡在清水里等汤浇，很快就软成一团。"
  ],
  "substitutions": [
    {
      "original": "牛肉",
      "substitute": "羊肉",
      "ratio": "250克:250克",
      "note": "腥味略重，姜丝与料酒加量。"
    },
    {
      "original": "雪菜",
      "substitute": "梅干菜",
      "ratio": "120克:100克",
      "note": "需多泡洗两遍，甜香更浓。"
    }
  ],
  "variations": [
    "加一只荷包蛋卧在面上，更有饱足感。",
    "把雪菜换成腌白菜，酸味更柔和也更清口。"
  ],
  "serving_suggestion": "热汤热面端上桌，先喝汤再吃面，配一碟醋更开胃。",
  "storage": "汤与面分开冷藏两天，复热汤滚开后再下面。",
