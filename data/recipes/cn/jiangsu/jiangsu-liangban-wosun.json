          "name_en": "salt",
          "amount": 4,
          "unit": "g",
          "note": "杀水",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 6,
          "unit": "g",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 10,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 15,
          "unit": "ml",
          "note": "调味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "砧板",
    "小锅",
    "拌碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "莴笋削去外皮与内层粗筋，切成长六厘米的细丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "粗筋不削净，嚼起来会有渣。",
      "visual_cue": "笋丝通体淡绿，断面透着水光"
    },
    {
      "n": 2,
      "text": "笋丝放进拌碗，撒盐抓匀，静置十分钟杀出水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "杀过水的笋丝才脆，拌好不出汤。",
      "visual_cue": "碗底积起一层浅绿水"
    },
    {
      "n": 3,
      "text": "把杀出的水倒掉，用手轻轻挤干笋丝多余水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "挤太狠会发柴，留一点水分更嫩。",
      "visual_cue": "笋丝变得柔软有弹性"
    },
    {
      "n": 4,
      "text": "小锅烧少量清水，水开后把笋丝快速焯十秒捞出。",
      "time_min": 2,
      "heat": "大火",
      "tip": "只焯十秒，久了就失脆。",
      "visual_cue": "笋丝颜色变深绿，捞出立刻过凉"
    },
    {
      "n": 5,
      "text": "焯过的笋丝摊在盘里晾凉，凉透再拌才不会发软。",
      "time_min": 5,
      "heat": "无火",
      "tip": "摊开散热比堆着凉得快得多。",
      "visual_cue": "笋丝根根分明，不粘连"
    },
    {
      "n": 6,
      "text": "生抽酱油、白糖、香油在小碗里调匀成料汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "糖要先化开，否则拌完底部发甜。",
      "visual_cue": "料汁呈浅褐色，闻着咸香带甜"
    },
    {
      "n": 7,
      "text": "料汁浇在笋丝上，用筷子从下往上翻拌均匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "翻拌别按压，笋丝才不断。",
      "visual_cue": "每根笋丝都挂着薄薄一层汁"
    },
    {
      "n": 8,
      "text": "装盘后静置五分钟让咸味入进去，吃前再拌一下。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置五分钟，咸味才进得去。",
      "visual_cue": "盘底无积水，笋丝油亮"
    }
  ],
  "tips": [
    "莴笋只取中段，头尾纤维粗，凉拌口感差一截。",
    "杀水后再焯十秒，笋丝脆而不生，也没有土腥味。",
    "料汁里的糖一定要先化开，拌出来咸甜才均匀。"
  ],
  "common_mistakes": [
    "莴笋切好直接拌，出水把味道冲淡，盘底一汪汤。",
    "焯水超过半分钟，笋丝发软发黄，脆劲全无。",
    "香油最后淋在表面不拌开，一根咸一根淡。"
  ],
  "substitutions": [
    {
      "original": "莴笋",
      "substitute": "青笋",
      "ratio": "400 克:400 克",
      "note": "同科不同名，口感一致。"
    },
    {
      "original": "香油",
      "substitute": "花生油",
      "ratio": "10 毫升:10 毫升",
      "note": "香气弱一些，可加几滴藤椒油提味。"
    }
  ],
  "variations": [
    "淋一勺辣椒油改成川式口味，麻香更足。",
    "加几丝金华火腿同拌，鲜味更上层楼。"
  ],
  "serving_suggestion": "冰镇十分钟后上桌，作为夏日前菜最清爽。",
  "storage": "冷藏可放一天，超过一天笋丝会发软出水，不建议久存。",
