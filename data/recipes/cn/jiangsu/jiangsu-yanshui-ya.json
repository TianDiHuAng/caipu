  "steps": [
    {
      "n": 1,
      "text": "鸭子去净内脏、尾脂和喉管，用清水冲净血水后挂在通风处沥干表皮。",
      "time_min": 15,
      "heat": "无火",
      "tip": "表皮越干越容易挂住花椒盐，腌出来才够味不腥。",
      "visual_cue": "鸭皮干爽发紧，摸上去不粘手。"
    },
    {
      "n": 2,
      "text": "炒锅烧热下盐和花椒，小火炒到盐粒微黄、花椒出香，倒出摊凉备用。",
      "time_min": 6,
      "heat": "小火",
      "tip": "盐炒到微黄即可，炒焦了会发苦，整只鸭子都带苦味。",
      "visual_cue": "盐粒泛浅黄，花椒香气冲鼻。"
    },
    {
      "n": 3,
      "text": "把花椒盐均匀抹遍鸭子内外，胸腿肉厚处多揉几下，装盆压重物冷藏腌制四小时。",
      "time_min": 240,
      "heat": "无火",
      "tip": "腌制中途翻一次面，让盐水渗出再被吸收，咸度才匀。",
      "visual_cue": "鸭身渗出血水，皮色转浅黄。"
    },
    {
      "n": 4,
      "text": "腌好的鸭子冲掉表面盐粒，放入冷水锅，加姜片、大葱段、八角和料酒煮开撇沫。",
      "time_min": 12,
      "heat": "中火",
      "tip": "表面盐粒要冲净，否则卤水越煮越咸，成品发齁。",
      "visual_cue": "浮沫成块浮起，鸭皮收紧。"
    },
    {
      "n": 5,
      "text": "转微火保持汤面似开非开，浸煮三十分钟后翻面再浸十分钟，全程不要大滚。",
      "time_min": 40,
      "heat": "微火",
      "tip": "水一滚鸭皮就破、肉也发柴，微火浸熟才嫩。",
      "visual_cue": "汤面只有小气泡，鸭身鼓胀发白。"
    },
    {
      "n": 6,
      "text": "捞出鸭子晾凉后斩成一指宽的条块，浇一勺原卤，配姜丝米醋上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "一定要凉透再斩，热的时候下刀肉散不成形。",
      "visual_cue": "鸭肉切面白嫩，皮色微黄透亮。"
    }
  ],
  "tips": [
    "鸭子选三斤左右的嫩鸭，肉嫩油少，腌一天就够入味。",
    "卤水里加一个八角同煮，香气更足，但别多放，免得抢走鸭香。",
    "斩鸭时刀刃垂直下压，斜切会让皮肉分离，摆盘难看。"
  ],
  "common_mistakes": [
    "鸭子表面没沥干就抹盐，盐粒化水流出，腌了一夜还是淡。",
    "浸煮时用大火滚，鸭皮破裂、肉纤维紧缩，口感发柴。",
    "热的时候斩块，肉汁流失，切面发灰不成形。"
  ],
  "substitutions": [
    {
      "original": "鸭",
      "substitute": "鸭腿",
      "ratio": "1:1",
      "note": "用鸭腿更省事，腌制时间缩短到两小时，浸煮二十分钟即可。"
    },
    {
      "original": "花椒",
      "substitute": "青花椒",
      "ratio": "1:1",
      "note": "青花椒清麻更冲，用量减两克，免得麻味压过咸香。"
    }
  ],
  "variations": [
    "南京老店讲究用百年老卤，卤水越陈越香，家庭可留一部分原卤冷冻续用。",
    "有的做法腌好后风干半日再浸煮，皮更紧实，切片更挺括。"
  ],
  "serving_suggestion": "凉透后斩条装盘，配姜丝和米醋碟；当冷盘或下酒菜都宜，配一碗鸭油烧饼更地道。",
  "storage": "冷藏可存三日，斩块后密封冷冻两周；复热隔水蒸八分钟，别用微波炉久打。",
