    "擀面杖",
    "擦丝器",
    "案板",
    "大盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白萝卜削皮擦成细丝，加三克盐抓匀腌十五分钟，挤干水分备用。",
      "time_min": 18,
      "heat": "无火",
      "tip": "萝卜丝要挤到发干，水分留多了烤的时候会漏汤，饼皮也鼓不起来。",
      "visual_cue": "萝卜丝干爽成团，盆底无积水"
    },
    {
      "n": 2,
      "text": "火腿切细末，小葱切葱花，与萝卜丝拌匀，加剩下的盐和白胡椒调味。",
      "time_min": 8,
      "heat": "无火",
      "tip": "火腿本身有咸味，调味前先尝一口，盐要少放防过咸。",
      "visual_cue": "馅料松散不黏手，颜色红绿相间"
    },
    {
      "n": 3,
      "text": "取一百八十克面粉加四十克猪油和九十毫升温水，揉成水油皮面团醒二十分钟。",
      "time_min": 22,
      "heat": "无火",
      "tip": "水油皮要揉到出膜，起酥时才不容易破皮漏油。",
      "visual_cue": "面团光滑柔软，拉得开薄膜"
    },
    {
      "n": 4,
      "text": "剩下的一百二十克面粉与六十克猪油搓成油酥，分成四份待用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "油酥搓到能捏成团即可，搓过头会出油，酥层反而层次不清。",
      "visual_cue": "油酥成团，手指一按就散"
    },
    {
      "n": 5,
      "text": "水油皮擀成长方片，铺上油酥卷起，再擀开折叠三次，静置十分钟。",
      "time_min": 12,
      "heat": "无火",
      "tip": "每折一次都要松弛，面团紧着擀会把酥层压死，成品不酥。",
      "visual_cue": "面卷层次分明，表面不破"
    },
    {
      "n": 6,
      "text": "面卷切成四段，按扁擀成圆皮，包入萝卜馅收口捏紧，轻压成扁圆饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "收口一定要捏严，煎的时候馅里的汁水从缝隙冒出来就会炸油。",
      "visual_cue": "饼坯圆整，收口朝下压平"
    },
    {
      "n": 7,
      "text": "平底锅倒植物油烧到五成热，下饼坯中小火煎到两面金黄，中途翻两次。",
      "time_min": 15,
      "heat": "中小火",
      "tip": "油温五成下锅最稳，太热外皮焦了里面还是生面，太凉会吸油。",
      "visual_cue": "两面金黄，边缘起酥层"
    }
  ],
  "tips": [
    "萝卜丝酥饼的酥靠三次折叠，层次到位才能一咬掉渣。",
    "煎的时候别急着翻面，等底面定住再动，饼皮才不会破。",
    "萝卜选沉的、皮薄的，水分足、辣味轻，做馅比老萝卜香得多。"
  ],
  "common_mistakes": [
    "萝卜丝没挤水就包，煎时汁水流出，饼皮吸油发软，一点不酥。",
    "油酥和水油皮软硬不一致，擀的时候酥层被推跑，成品只有两层。",
    "全程大火煎，外皮焦黑里面还是生面，只能切开回锅重煎。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "黄油",
      "ratio": "100克:100克",
      "note": "黄油版奶香浓，起酥效果接近，需冷藏后再用。"
    },
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "40克:40克",
      "note": "咸肉要先蒸熟切丁，咸度更高需减盐。"
    }
  ],
  "variations": [
    "把火腿换成虾仁，做成虾仁萝卜酥，鲜味更清，是镇江一带的做法。",
    "馅里加一勺猪油渣，油香厚重，是老扬州茶楼的私房配方。"
  ],
  "serving_suggestion": "刚出锅的酥饼配一碗豆浆或绿茶，趁热吃最酥；凉了回炉烤三分钟可回脆。",
  "storage": "生坯冷冻可存两周，煎时直接下锅加两分钟；熟饼冷藏一天，回烤箱一百六十度烤五分钟。",
