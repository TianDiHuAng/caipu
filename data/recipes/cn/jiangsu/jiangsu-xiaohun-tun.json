  "steps": [
    {
      "n": 1,
      "text": "猪前腿肉剁成细泥，中途加少许清水打上劲。，看准状态再往下做。",
      "time_min": 10,
      "heat": "无火",
      "tip": "加水分次打，肉才嫩滑不柴。，看准状态再往下做。",
      "visual_cue": "肉浆细腻，能挂住刀背"
    },
    {
      "n": 2,
      "text": "肉浆加姜末、生抽、盐和白糖，顺一个方向搅。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "同一方向搅，肉料才起胶抱团。，看准状态再往下做。",
      "visual_cue": "肉浆发黏，颜色变浅"
    },
    {
      "n": 3,
      "text": "拌入一半葱花和香油，搅匀后冷藏十分钟。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "冷藏定型，包的时候不粘手。，看准状态再往下做。",
      "visual_cue": "馅料紧实，油光可见"
    },
    {
      "n": 4,
      "text": "云吞皮摊在手心，抹一小勺肉料在中间。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "馅别贪多，皮薄撑破就散了。，看准状态再往下做。",
      "visual_cue": "皮面平整，馅料居中"
    },
    {
      "n": 5,
      "text": "四角往中间一捏，捏成小元宝形状。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "指尖沾水，捏口才粘得牢。，看准状态再往下做。",
      "visual_cue": "形如元宝，封口紧实"
    },
    {
      "n": 6,
      "text": "汤锅烧水，水大开后下馄饨轻推防粘。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "下锅后用勺背推，别用勺尖戳。，看准状态再往下做。",
      "visual_cue": "馄饨浮起，皮色透亮"
    },
    {
      "n": 7,
      "text": "煮到馄饨全部浮起再煮一分钟捞出。，看准状态再往下做。",
      "time_min": 2,
      "heat": "大火",
      "tip": "浮起就熟，煮久皮烂馅老。，看准状态再往下做。",
      "visual_cue": "皮薄透馅，形态完整"
    },
    {
      "n": 8,
      "text": "碗里放紫菜、虾米和葱花，冲入热汤下馄饨。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "先冲汤再放馄饨，皮才不糊。，看准状态再往下做。",
      "visual_cue": "汤清见底，馄饨浮面"
    }
  ],
  "tips": [
    "肉浆要分次加水打上劲，口感才嫩。",
    "捏口时指尖沾点水，煮的时候不开口。",
    "汤底用紫菜虾米冲，鲜味最简单也最对。"
  ],
  "common_mistakes": [
    "料放太多，皮撑破煮成肉汤。，这一点很关键。",
    "水不开就下馄饨，全粘在锅底。，这一点很关键。",
    "煮过头，皮化在汤里找不着。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "猪前腿肉",
      "substitute": "鸡胸肉",
      "ratio": "250 克:250 克",
      "note": "加一勺淀粉，口感才不柴。"
    },
    {
      "original": "紫菜",
      "substitute": "蛋皮丝",
      "ratio": "5 克:1 个蛋",
      "note": "摊薄切丝，汤更香。"
    }
  ],
  "variations": [
    "汤里加一勺猪油，香气立刻不一样。",
    "包成大馄饨，配红汤更饱腹。，这一点很关键。"
  ],
  "serving_suggestion": "早餐或宵夜吃一碗，配醋和辣油。，这一点很关键。",
  "storage": "生馄饨冷冻两周，冷藏不超过一天；汤现做现喝。",
