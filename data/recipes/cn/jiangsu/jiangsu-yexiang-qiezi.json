    "漏勺",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茄子切滚刀块，撒盐拌匀腌十分钟出水。，看准状态再往下做。",
      "time_min": 12,
      "heat": "无火",
      "tip": "杀过水，炸的时候才不吸一碗油。，看准状态再往下做。",
      "visual_cue": "茄块微软，表面渗水"
    },
    {
      "n": 2,
      "text": "用手轻压茄块挤出水分，用厨房纸吸干。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "压出水，茄子才更容易吸味。，看准状态再往下做。",
      "visual_cue": "茄块干爽，体积缩小"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，下茄块中火炸。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "油温不够茄子会吸油成海绵。，看准状态再往下做。",
      "visual_cue": "边缘起泡，表面微黄"
    },
    {
      "n": 4,
      "text": "炸到茄块表面微黄变软，捞出沥油。，看准状态再往下做。",
      "time_min": 5,
      "heat": "中火",
      "tip": "炸过再过一遍，外皮才不塌。，看准状态再往下做。",
      "visual_cue": "茄块金黄，筷子能插入"
    },
    {
      "n": 5,
      "text": "锅里留底油，下蒜末小火炒到微黄出香。，看准状态再往下做。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末炒黄才香，焦了就发苦。，看准状态再往下做。",
      "visual_cue": "蒜末金黄，香气浓郁"
    },
    {
      "n": 6,
      "text": "倒回茄块，加生抽、老抽和白糖翻炒上色。，看准状态再往下做。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先上色再加汤汁，颜色才匀。，看准状态再往下做。",
      "visual_cue": "茄块裹色，油光明亮"
    },
    {
      "n": 7,
      "text": "加清水大火烧开，转中小火焖五分钟。，看准状态再往下做。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "焖的过程让茄子吸满汤汁。，看准状态再往下做。",
      "visual_cue": "汤汁减半，茄块软糯"
    },
    {
      "n": 8,
      "text": "开大火收汁，撒葱花装盘。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁留一点，拌饭最好吃。，看准状态再往下做。",
      "visual_cue": "汁浓挂茄，葱花点缀"
    }
  ],
  "tips": [
    "茄子先撒盐杀水，炸的时候不吸油。",
    "油温六成热再下锅，茄子才不软塌。",
    "收汁留一点汤汁，拌饭特别香。，这一点很关键。"
  ],
  "common_mistakes": [
    "茄子直接下冷油，吸油吸成海绵。，这一点很关键。",
    "盐早放太多，咸得发苦。，这一点很关键。",
    "焖的时间太长，茄子烂成糊。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "长茄子",
      "substitute": "圆茄子",
      "ratio": "600 克:600 克",
      "note": "肉更厚，炸的时间加两分钟。"
    },
    {
      "original": "植物油",
      "substitute": "猪油",
      "ratio": "120 毫升:100 克",
      "note": "更香，冷却后会凝。"
    }
  ],
  "variations": [
    "加一把肉粒同焖，荤香更足。，这一点很关键。",
    "放几段干辣椒，微辣更下饭。，这一点很关键。"
  ],
  "serving_suggestion": "配白米饭，连汁拌着吃。，这一点很关键。",
  "storage": "冷藏两天，复热蒸五分钟更软。，这一点很关键。",
