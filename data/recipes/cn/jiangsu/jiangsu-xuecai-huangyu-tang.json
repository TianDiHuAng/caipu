  "steps": [
    {
      "n": 1,
      "text": "小黄鱼刮鳞去鳃掏净内脏，撕掉腹内黑膜，用厨房纸把鱼身内外擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黑膜和血线是腥味根源，撕净后汤才清鲜不苦。",
      "visual_cue": "鱼身干爽，腹腔干净无血污。"
    },
    {
      "n": 2,
      "text": "炒锅烧热放植物油，小黄鱼逐条下锅中火煎到两面金黄结皮。",
      "time_min": 8,
      "heat": "中火",
      "tip": "鱼身擦干再下锅，油温够了就不粘，翻面只翻一次。",
      "visual_cue": "鱼皮金黄完整，边缘微微卷起。"
    },
    {
      "n": 3,
      "text": "沿锅边淋入料酒，放姜丝，随即冲入开水没过鱼身，大火滚五分钟。",
      "time_min": 7,
      "heat": "大火",
      "tip": "冲开水是汤色奶白的关键，冷水会让汤变灰发腥。",
      "visual_cue": "汤面翻滚，汤色转成浅乳白。"
    },
    {
      "n": 4,
      "text": "雪菜碎下锅同煮十分钟，让咸香渗进汤里，汤色渐浓。",
      "time_min": 11,
      "heat": "中火",
      "tip": "雪菜先尝咸淡，太咸可先泡水十分钟再下锅。",
      "visual_cue": "雪菜沉底，汤色加深呈米汤白。"
    },
    {
      "n": 5,
      "text": "加盐和白胡椒调味，撒小葱葱花，关火后连汤和鱼一起盛进汤碗。",
      "time_min": 4,
      "heat": "无火",
      "tip": "盐要少放，雪菜本身带咸，稍不留神就过咸。",
      "visual_cue": "汤色乳白带青，鱼身完整不散。"
    }
  ],
  "tips": [
    "小黄鱼比大黄鱼肉更嫩，做汤更鲜，选眼睛清亮、鳃色鲜红的。",
    "雪菜先炒一下再下汤，香气更足，汤也更浓。",
    "想汤更厚可加一小把粉丝同煮，吸汤后特别好吃。"
  ],
  "common_mistakes": [
    "鱼没擦干就下锅，鱼皮粘锅破碎，汤里全是碎渣。",
    "加冷水煮鱼，汤色发灰，腥味反而被锁在汤里。",
    "雪菜放太多又不尝咸淡，成品咸得喝不下。"
  ],
  "substitutions": [
    {
      "original": "小黄鱼",
      "substitute": "黄鱼",
      "ratio": "1:1",
      "note": "大黄鱼需切成段，煎制时间延长两分钟。"
    },
    {
      "original": "雪菜",
      "substitute": "雪里蕻",
      "ratio": "1:1",
      "note": "雪里蕻腌得更咸，先泡水十分钟再切碎。"
    }
  ],
  "variations": [
    "宁波一带爱加几片咸肉同煮，汤更咸鲜，称为咸鲜合璧。",
    "有的家庭把黄鱼先拆成鱼片，汤熬好后再下鱼片汆熟，鱼肉更嫩。"
  ],
  "serving_suggestion": "汤鱼同食，配一碗白饭最下饭；也可只喝汤，鱼肉蘸醋吃。",
  "storage": "冷藏可存一日，冷冻一周；复热加少量开水小火温开，别久煮。",
