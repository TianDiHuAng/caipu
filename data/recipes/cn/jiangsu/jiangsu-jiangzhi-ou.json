  "equipment": [
    "汤锅",
    "炒锅",
    "冰水盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "藕削去外皮，切成两毫米厚的薄片，泡在清水里并反复冲洗孔内泥沙。",
      "time_min": 8,
      "heat": "无火",
      "tip": "切好立刻泡水，能挡住氧化发黄，这一步千万别省。",
      "visual_cue": "藕片洁白，水清不浑，状态和火候都看得清"
    },
    {
      "n": 2,
      "text": "汤锅烧开水加几滴香醋，倒入藕片焯三十秒，藕片一变透明立刻捞出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "水里加醋，藕片更白也更脆，火候和顺序都要留神。",
      "visual_cue": "藕片透亮，边缘不塌，颜色和形态变化明显"
    },
    {
      "n": 3,
      "text": "捞出后立即放入冰水盆浸泡三分钟，彻底凉透后沥干水分。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冰水锁脆，这道菜成败全在这一步，提前把配料备好再动手更稳。",
      "visual_cue": "藕片凉透，脆硬有光泽，气味的浓淡也说明进度"
    },
    {
      "n": 4,
      "text": "碗里放生抽、香醋、细砂糖、芝麻油和蒜末，搅到糖完全化开静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "糖先化开再拌，否则颗粒沉底咸酸不均，这一步千万别省。",
      "visual_cue": "酱汁均匀，不见糖粒，锅里整体状态一目了然"
    },
    {
      "n": 5,
      "text": "把藕片和酱汁拌匀，装盘后撒小米辣圈、葱花和白芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "拌好后静置五分钟再吃，让藕片吃进味道，火候和顺序都要留神。",
      "visual_cue": "酱汁均匀挂在藕片上，状态和火候都看得清"
    }
  ],
  "tips": [
    "选七孔藕，节短体圆，切出来脆嫩不粉，凉拌才爽口。",
    "焯水只三十秒，捞出立刻过冰水，藕片保住脆度也去掉涩味。",
    "酱汁要提前调匀静置五分钟，让糖化开再拌，味道才均匀。"
  ],
  "common_mistakes": [
    "用九孔粉藕做凉拌，焯完一咬就是面渣，口感全无。",
    "焯水时间过长，藕片发黄发软，拌起来碎成小片。",
    "醋最后才淋，酸味浮在表面，藕片里层没味道。"
  ],
  "substitutions": [
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "20毫升:20毫升",
      "note": "米醋酸味更直接，糖可减三克。"
    },
    {
      "original": "藕",
      "substitute": "莴笋",
      "ratio": "400克:400克",
      "note": "莴笋更脆，焯水时间缩短到十五秒。"
    }
  ],
  "variations": [
    "把酱汁换成芝麻酱加生抽和醋调开，就是麻酱藕片，口感更厚。",
    "加一把炸花生米同拌，脆上加脆，是江苏一带家宴的常见做法。"
  ],
  "serving_suggestion": "装白盘堆成小山，撒白芝麻和葱花，冷藏十分钟后上桌最爽脆。",
  "storage": "冷藏可放两天，藕片会随泡制变酸，食用前沥干，勿在室温久放。",
