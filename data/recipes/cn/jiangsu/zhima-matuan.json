  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 250,
          "unit": "g",
          "note": "水磨糯米粉",
          "optional": false
        },
        {
          "name": "红豆",
          "name_en": "adzuki bean",
          "amount": 100,
          "unit": "g",
          "note": "煮成豆沙做馅",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 40,
          "unit": "g",
          "note": "白芝麻裹面用",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 40,
          "unit": "g",
          "note": "豆沙与面团",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 250,
          "unit": "ml",
          "note": "炸制用油",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 200,
          "unit": "ml",
          "note": "和面与煮豆",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "揉面盆",
    "炒锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "红豆提前泡软，加水用中火煮十八分钟到一捏就烂。",
      "time_min": 18,
      "heat": "中火",
      "tip": "豆要煮到起沙，豆沙才细腻。",
      "visual_cue": "豆粒开花、手指一捻即散"
    },
    {
      "n": 2,
      "text": "煮好的红豆沥去多余水分，趁热加二十克白糖压成泥。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁热压泥，糖化得更均匀。",
      "visual_cue": "豆沙细腻、能团成小球"
    },
    {
      "n": 3,
      "text": "把豆沙分成二十个小球，摊开放凉之后备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "豆沙凉了才好包，不粘手。",
      "visual_cue": "豆沙球圆整、表面不粘"
    },
    {
      "n": 4,
      "text": "糯米粉加剩余白糖，分次加温水揉成光滑不粘手的面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水要一点点加，面团软硬适中。",
      "visual_cue": "面团光滑、按下去有弹性"
    },
    {
      "n": 5,
      "text": "面团分成与豆沙等量的剂子，逐个按扁包入豆沙球搓圆。",
      "time_min": 12,
      "heat": "无火",
      "tip": "皮要包得均匀，别露馅。",
      "visual_cue": "圆球光滑、不见豆沙"
    },
    {
      "n": 6,
      "text": "圆球表面蘸一层清水，再滚满白芝麻用手轻轻按实。",
      "time_min": 5,
      "heat": "无火",
      "tip": "蘸水芝麻才粘得牢，炸时不掉。",
      "visual_cue": "芝麻裹满、按之不掉"
    },
    {
      "n": 7,
      "text": "锅中倒植物油烧到四成热，下麻团小火慢炸并不断推动。",
      "time_min": 6,
      "heat": "小火",
      "tip": "油温低些，麻团才有时间膨胀。",
      "visual_cue": "麻团浮起、体积变大"
    },
    {
      "n": 8,
      "text": "炸到表面金黄、外壳发硬捞出，沥油后趁热食用。",
      "time_min": 4,
      "heat": "中小火",
      "tip": "外壳硬了就可以捞，别炸到发黑。",
      "visual_cue": "外壳金黄酥脆、敲之有脆响"
    }
  ],
  "tips": [
    "糯米粉选水磨的，做出来的成品更软糯。",
    "炸的时候用勺背轻推，麻团才圆不塌。",
    "豆沙里加一小块猪油，香气更浓。"
  ],
  "common_mistakes": [
    "油温太高下锅，麻团外皮瞬间定型鼓不起来。",
    "包的时候皮太薄，炸的时候豆沙漏出来。",
    "芝麻没有按实，下油锅就散落一片。"
  ],
  "substitutions": [
    {
      "original": "红豆",
      "substitute": "黑芝麻馅",
      "ratio": "100g 对 80g",
      "note": "更香，白糖需减十克。"
    },
    {
      "original": "糯米粉",
      "substitute": "南瓜糯米粉",
      "ratio": "250g 对 250g",
      "note": "需减少加水量，颜色更黄。"
    }
  ],
  "variations": [
    "面团里掺一点紫薯泥，颜色更好看。",
    "把豆沙换成莲蓉馅，口感会更加细腻。"
  ],
  "serving_suggestion": "趁热吃外脆内糯，配一壶清茶最合适。",
  "storage": "当天吃完最好，隔夜之后外壳会回软。",
  "nutrition_estimate": {
    "basis": "每份（约 180g）",
    "calories_kcal": 560,
