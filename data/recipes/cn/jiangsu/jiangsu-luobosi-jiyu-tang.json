  "equipment": [
    "炒锅",
    "汤锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲫鱼去鳞去内脏，刮净腹内黑膜，鱼身两面各划两刀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黑膜不刮干净，汤再好也带一股土腥味。",
      "visual_cue": "鱼腹内壁洁白，鱼身刀口整齐"
    },
    {
      "n": 2,
      "text": "鱼身抹少许盐与料酒，塞入姜片腌十分钟去腥。",
      "time_min": 11,
      "heat": "无火",
      "tip": "盐能让鱼肉紧一点，煎的时候不容易破皮。",
      "visual_cue": "鱼身微湿，腹中塞着姜片"
    },
    {
      "n": 3,
      "text": "白萝卜去皮切成火柴梗粗细的丝，泡水五分钟沥干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "萝卜丝切得细而均匀，煮出来才会软而不烂。",
      "visual_cue": "萝卜丝粗细一致，洁白透亮"
    },
    {
      "n": 4,
      "text": "腌好的鲫鱼用厨房纸把鱼身表面的水分彻底擦干。",
      "time_min": 3,
      "heat": "无火",
      "tip": "这一步直接决定煎鱼的时候会不会粘锅破皮。",
      "visual_cue": "鱼皮干爽，纸巾不见水印"
    },
    {
      "n": 5,
      "text": "炒锅大火烧热放花生油，转中火把鲫鱼两面各煎三分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "锅要够热、油要够，鱼下锅后先别动。",
      "visual_cue": "鱼皮金黄完整，贴着锅面能滑动"
    },
    {
      "n": 6,
      "text": "沿锅边淋料酒，倒入滚烫的开水，放葱结与姜片。",
      "time_min": 3,
      "heat": "大火",
      "tip": "必须冲开水，汤才会瞬间乳白；冷水只会煮出清汤。",
      "visual_cue": "汤色立刻转成浓白，浮起油花"
    },
    {
      "n": 7,
      "text": "保持大火滚足八分钟，让汤色彻底变浓、白得透亮。",
      "time_min": 8,
      "heat": "大火",
      "tip": "大火滚才能把鱼油与胶质乳化，汤才白得彻底。",
      "visual_cue": "汤面翻滚，颜色乳白浓稠"
    },
    {
      "n": 8,
      "text": "下萝卜丝转中火煮十分钟，煮到丝软透而不断。",
      "time_min": 10,
      "heat": "中火",
      "tip": "萝卜丝煮过头会化掉，煮到能咬断就够。",
      "visual_cue": "萝卜丝透明柔软，仍保持丝形"
    },
    {
      "n": 9,
      "text": "加盐与白胡椒粉调味，淋上香油，撒葱花即可出锅。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐最后放，早放会让鱼肉发紧、汤不易变白。",
      "visual_cue": "汤白如奶，葱花浮在表面"
    }
  ],
  "tips": [
    "鲫鱼刺多，煮汤时不要大力翻动，避免细刺混进汤里。",
    "想汤更白可以在煎鱼时多煎一会儿，让鱼皮更焦香。",
    "萝卜丝也可换成莴笋丝，汤更清甜。",
    "汤要一次加足水，中途加水会冲淡白色。"
  ],
  "common_mistakes": [
    "鱼身没擦干就直接下锅，粘锅破皮还会溅起热油。",
    "中途加冷水煮汤，汤色会一直清汤寡水煮不白。",
    "小火慢炖两小时，鱼肉散开细刺浮了满锅。"
  ],
  "substitutions": [
    {
      "original": "鲫鱼",
      "substitute": "鳜鱼",
      "ratio": "600克:600克",
      "note": "刺少肉厚，更适合老人小孩。"
    },
    {
      "original": "白萝卜",
      "substitute": "茭白",
      "ratio": "300克:300克",
      "note": "口感更嫩，煮的时间减三分钟。"
    }
  ],
  "variations": [
    "加几片火腿一起煮，汤的鲜味会更厚实。",
    "最后撒一把新鲜豆苗进去，汤色和卖相都更漂亮。"
  ],
  "serving_suggestion": "盛入汤碗，先喝一口奶白汤，再挑鱼肉蘸少许生抽，配米饭或单独喝都合适。",
  "storage": "冷藏两天，复热小火煮开即可，鱼肉会略老。",
