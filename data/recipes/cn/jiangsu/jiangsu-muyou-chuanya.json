  "steps": [
    {
      "n": 1,
      "text": "鸭去内脏冲净血水，用厨房纸吸干表皮水分，鸭腿与鸭翅用棉线捆拢固定。",
      "time_min": 20,
      "heat": "无火",
      "tip": "四肢捆拢后焖煮不易变形，装盘时鸭型周正，待客更体面。",
      "visual_cue": "鸭身干爽挺立，四肢收拢。"
    },
    {
      "n": 2,
      "text": "汤锅加冷水和料酒，放入鸭焯水八分钟，撇净浮沫后捞出用温水冲净。",
      "time_min": 15,
      "heat": "中火",
      "tip": "冷水下锅血沫才逼得净，热水下锅腥味锁在里面。",
      "visual_cue": "水面浮起厚厚一层沫，鸭皮收紧。"
    },
    {
      "n": 3,
      "text": "砂锅底铺大葱段与姜片，鸭腹部朝上放进去，倒生抽、老抽、冰糖和清水。",
      "time_min": 8,
      "heat": "无火",
      "tip": "锅底垫葱姜，鸭皮不粘锅，翻动时也不破。",
      "visual_cue": "汤汁没过鸭身大半，酱色均匀。"
    },
    {
      "n": 4,
      "text": "加八角、桂皮和橘皮，大火烧开后转最小火，盖盖焖五十分钟。",
      "time_min": 55,
      "heat": "小火",
      "tip": "只要汤面微微冒泡就够，火大鸭皮会破。",
      "visual_cue": "汤汁微滚，鸭皮渐渐染成酱红。"
    },
    {
      "n": 5,
      "text": "把鸭翻面再焖四十分钟，加盐调味后继续焖十分钟，让咸味渗进鸭肉。",
      "time_min": 52,
      "heat": "小火",
      "tip": "翻面时用两把铲子托住鸭身，别用筷子夹皮。",
      "visual_cue": "筷子能扎穿鸭腿，鸭身柔软下塌。"
    },
    {
      "n": 6,
      "text": "鸭子整只盛进深盘，原汤滤净香料后浇在鸭身上，撒大葱丝趁热上桌。",
      "time_min": 6,
      "heat": "无火",
      "tip": "汤汁别收太干，这道菜讲究汤宽味厚，拌饭极香。",
      "visual_cue": "鸭身完整油亮，汤色红润透亮。"
    }
  ],
  "tips": [
    "母油是旧时酱油的头道原汁，家里可用生抽加一小勺老抽替代。",
    "选两斤半的嫩鸭，焖熟只需一小时多，老鸭要延长时间。",
    "焖好后放凉再复热一次，鸭肉更入味，汤也更浓。"
  ],
  "common_mistakes": [
    "焯水时用热水下锅，鸭腥味锁在肉里，成品带土腥。",
    "火太大猛滚，鸭皮破裂、鸭身散架，装盘不成形。",
    "汤汁收干，鸭肉表面发干，失去汤宽味厚的特点。"
  ],
  "substitutions": [
    {
      "original": "鸭",
      "substitute": "鸭腿",
      "ratio": "1:1.2",
      "note": "鸭腿焖四十分钟即可，汤汁相应减少五百毫升。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "1:1",
      "note": "白糖上色浅，老抽可多加五毫升补色。"
    }
  ],
  "variations": [
    "太湖船菜的做法在鸭腹里塞糯米与笋丁，焖后鸭肉带米香，切片更好看。",
    "有的家庭改用砂锅小火煨足两小时，汤更浓，鸭肉一夹就脱骨。"
  ],
  "serving_suggestion": "整鸭上桌后由主人拆开，鸭肉配原汤吃，剩下的汤拌白饭或下面条都很鲜。",
  "storage": "连汤冷藏可存三日，冷冻两周；复热连汤小火加热，别把鸭身翻散。",
