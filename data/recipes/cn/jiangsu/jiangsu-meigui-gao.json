  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 180,
          "unit": "g",
          "note": "过筛",
          "optional": false
        },
        {
          "name": "粘米粉",
          "name_en": "rice flour",
          "amount": 120,
          "unit": "g",
          "note": "过筛",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "化水",
          "optional": false
        },
        {
          "name": "玫瑰酱",
          "name_en": "rose jam",
          "amount": 50,
          "unit": "g",
          "note": "增香",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 190,
          "unit": "ml",
          "note": "调粉",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 15,
          "unit": "ml",
          "note": "刷模",
          "optional": false
        },
        {
          "name": "糖桂花",
          "name_en": "osmanthus syrup",
          "amount": 20,
          "unit": "g",
          "note": "点缀",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "方形模具",
    "筛网",
    "大碗",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米粉和粘米粉混合均匀，过筛两遍备用。，看准状态再往下做。",
      "time_min": 8,
      "heat": "无火",
      "tip": "筛过两遍，糕体才细腻不夹生块。，看准状态再往下做。",
      "visual_cue": "粉质蓬松，无结块，这一点很关键。"
    },
    {
      "n": 2,
      "text": "白糖加清水搅至完全融化，成清亮糖水。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糖化不净，蒸好表面有白点。，看准状态再往下做。",
      "visual_cue": "水质清亮，无糖粒，这一点很关键。"
    },
    {
      "n": 3,
      "text": "糖水分三次倒进粉里，边倒边搓成粗粒状。，看准状态再往下做。",
      "time_min": 9,
      "heat": "无火",
      "tip": "搓到能捏成团、一按就散最好。，看准状态再往下做。",
      "visual_cue": "粉粒松散，手握成团"
    },
    {
      "n": 4,
      "text": "拌入玫瑰酱，轻轻翻拌到颜色均匀。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "玫瑰酱别用力揉，香气会散。，看准状态再往下做。",
      "visual_cue": "粉呈淡粉，花香浓郁"
    },
    {
      "n": 5,
      "text": "模具内壁刷植物油，把粉过筛铺进模具。，看准状态再往下做。",
      "time_min": 7,
      "heat": "无火",
      "tip": "筛进去更松，蒸好才有层次。，看准状态再往下做。",
      "visual_cue": "粉面平整，厚度一致"
    },
    {
      "n": 6,
      "text": "表面撒糖桂花，轻轻按平不要压实。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "按实了糕会硬，轻按即可。，看准状态再往下做。",
      "visual_cue": "花粒均匀，表面平整"
    },
    {
      "n": 7,
      "text": "水开后上锅，大火蒸三十分钟。，看准状态再往下做。",
      "time_min": 32,
      "heat": "大火",
      "tip": "锅盖留一条缝，水汽才不滴落。，看准状态再往下做。",
      "visual_cue": "糕体鼓起，竹签不粘"
    },
    {
      "n": 8,
      "text": "取出晾到温热，脱模切成方块。，看准状态再往下做。",
      "time_min": 15,
      "heat": "无火",
      "tip": "凉透再切，刀口才利落整齐。，看准状态再往下做。",
      "visual_cue": "块形方正，切面细腻"
    }
  ],
  "tips": [
    "粉要过筛两遍，糕体才细腻。，这一点很关键。",
    "糖水分次加，粉才搓得松散。，这一点很关键。",
    "锅盖留缝蒸，表面才不起水泡。，这一点很关键。"
  ],
  "common_mistakes": [
    "水一次倒太多，粉结团蒸不熟。，这一点很关键。",
    "盖严盖子，水汽滴出一个个坑。，这一点很关键。",
    "热的时候切，糕体全塌成一团。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "玫瑰酱",
      "substitute": "糖桂花",
      "ratio": "50 克:40 克",
      "note": "香气不同，颜色更浅。"
    },
    {
      "original": "粘米粉",
      "substitute": "澄面",
      "ratio": "120 克:110 克",
      "note": "更透亮，口感偏弹。"
    }
  ],
  "variations": [
    "中间夹一层豆沙，层次更丰富。，这一点很关键。",
    "换成茉莉花酱，做茉莉花糕。，这一点很关键。"
  ],
  "serving_suggestion": "切块装盘，配绿茶当茶点。，这一点很关键。",
  "storage": "冷藏三天，冷藏后变硬，复热蒸五分钟。",
