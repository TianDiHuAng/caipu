    "砂锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉切成四厘米见方的块，冷水下锅加料酒焯水，煮开撇沫后捞出冲净。",
      "time_min": 15,
      "heat": "中火",
      "tip": "肉块大小要一致，焖的时候才同时软烂。",
      "visual_cue": "肉块收紧发白，浮沫贴锅边。"
    },
    {
      "n": 2,
      "text": "炒锅小火放冰糖和少量清水，熬到糖液起大泡转成琥珀色的糖色。",
      "time_min": 8,
      "heat": "小火",
      "tip": "糖色一到枣红立刻下肉，再等就发苦。",
      "visual_cue": "糖液冒细泡，颜色像琥珀。"
    },
    {
      "n": 3,
      "text": "肉块倒入糖色里翻炒上色，加姜片、大葱段、八角、桂皮和老抽炒匀。",
      "time_min": 6,
      "heat": "中火",
      "tip": "每块肉都要翻到，上色不匀成品就花脸。",
      "visual_cue": "肉块通体红亮，锅底油泛红色。"
    },
    {
      "n": 4,
      "text": "倒入生抽和清水，水面没过肉块，大火烧开后转小火焖七十分钟。",
      "time_min": 72,
      "heat": "小火",
      "tip": "水一次加足，中途加水肉会紧、汤汁也变淡。",
      "visual_cue": "汤面小泡微滚，肉皮轻轻颤动。"
    },
    {
      "n": 5,
      "text": "加盐调味后开中火收汁，不停翻动肉块，让酱汁均匀裹在每一块上。",
      "time_min": 15,
      "heat": "中火",
      "tip": "收汁时火别开大，糖分沉底极易糊锅，见汁稠就关小火。",
      "visual_cue": "酱汁浓稠挂肉，锅底只剩薄薄一层。"
    },
    {
      "n": 6,
      "text": "关火后让肉在锅里静置十分钟回汁，再盛盘浇上酱汁，配白饭上桌。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置这几分钟让肉心回软回汁，切块时不散，盘里也不会流一滩汤。",
      "visual_cue": "肉皮透亮微颤，酱汁缓缓渗下。"
    }
  ],
  "tips": [
    "五花肉选三层分明、皮薄的，焖后肥而不腻，切片也好看。",
    "冰糖用量别减，苏式酱汁肉讲究甜出头、咸收口。",
    "隔夜冷藏后再蒸热，味道更融合，肉也更入味。"
  ],
  "common_mistakes": [
    "糖色熬过头，酱汁带焦苦味，颜色发黑。",
    "全程大火焖煮，肉块外烂内生，肥肉化成一锅油。",
    "收汁时不翻动，锅底结焦，酱汁带上糊味。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "1:1",
      "note": "前腿肉瘦多，焖的时间延长十分钟，口感稍紧。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "1:1",
      "note": "白糖易焦，糖色火候要再小一档。"
    }
  ],
  "variations": [
    "苏州老店会在卤汁里加一小块红曲调色，成品红如樱桃，卖相更艳。",
    "有的家庭把肉块切得更大，焖足两小时，吃起来更酥烂。"
  ],
  "serving_suggestion": "连汁浇在白饭上最经典，也可夹荷叶饼吃，配一碗青菜汤解腻。",
  "storage": "冷藏可存三日，冷冻两周；复热连汁蒸十五分钟，别用大火翻煮。",
