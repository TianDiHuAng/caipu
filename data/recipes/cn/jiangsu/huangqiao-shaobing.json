  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "中筋面粉，分成面团与油酥两份",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 40,
          "unit": "g",
          "note": "只用葱绿，切细",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 20,
          "unit": "g",
          "note": "白芝麻，撒面用",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 3,
          "unit": "g",
          "note": "温水化开",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "猪油",
          "name_en": "lard",
          "amount": 60,
          "unit": "g",
          "note": "做油酥用",
          "optional": false
        },
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 20,
          "unit": "ml",
          "note": "刷烤盘",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 5,
          "unit": "g",
          "note": "助发酵",
          "optional": false
        },
        {
          "name": "五香粉",
          "name_en": "five spice powder",
          "amount": 2,
          "unit": "g",
          "note": "增香，可选",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "擀面杖",
    "烤盘",
    "刷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母与白糖用三十度左右的温水化开，静置五分钟起小泡。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水温摸着温不烫手最合适，太烫会把酵母烫死。",
      "visual_cue": "水面浮起细密气泡，闻得到淡淡酒香"
    },
    {
      "n": 2,
      "text": "把酵母水倒进两百克面粉里，边倒边搅成棉絮状。",
      "time_min": 4,
      "heat": "无火",
      "tip": "水要一点点加，一次倒完容易和成稀泥。",
      "visual_cue": "面粉结成松散的小团，盆底无干粉"
    },
    {
      "n": 3,
      "text": "揉成光滑面团，盖上湿布在温暖处醒发四十分钟。",
      "time_min": 40,
      "heat": "无火",
      "tip": "醒到手指按下去凹坑慢慢回弹就够了。",
      "visual_cue": "面团体积涨到原来一倍半，按痕缓慢回弹"
    },
    {
      "n": 4,
      "text": "另取一百克面粉加猪油与盐、五香粉，搓成油酥团。",
      "time_min": 6,
      "heat": "无火",
      "tip": "油酥要搓到能捏成团又不粘手，太稀烤时会流出来。",
      "visual_cue": "油酥成团，捏一下能留指印"
    },
    {
      "n": 5,
      "text": "醒好的面团擀成大薄片，把油酥均匀抹在上面。",
      "time_min": 5,
      "heat": "无火",
      "tip": "油酥抹得越均匀，烤出来的层次就越薄越酥。",
      "visual_cue": "面片上覆盖一层均匀油酥，不见空白"
    },
    {
      "n": 6,
      "text": "从一边卷成长条，切成六个剂子，两端捏紧收口。",
      "time_min": 6,
      "heat": "无火",
      "tip": "收口一定捏紧，否则擀的时候油酥会从边缝挤出来。",
      "visual_cue": "剂子大小一致，切口能看到旋涡纹"
    },
    {
      "n": 7,
      "text": "每个剂子按扁擀成牛舌形，撒葱绿后卷起再按成圆饼。",
      "time_min": 8,
      "heat": "无火",
      "tip": "卷两次层次更多，葱绿分两层包进去不易焦。",
      "visual_cue": "饼坯厚薄一致，表面光滑"
    },
    {
      "n": 8,
      "text": "饼面刷一层清水，粘上芝麻，摆在刷过花生油的烤盘上。",
      "time_min": 4,
      "heat": "无火",
      "tip": "刷水再粘芝麻才粘得牢，烤完不会掉一片。",
      "visual_cue": "芝麻均匀铺满饼面，轻按不脱落"
    },
    {
      "n": 9,
      "text": "烤箱上下火两百度预热后烤十五分钟，表面金黄即可。",
      "time_min": 17,
      "heat": "大火",
      "tip": "最后三分钟盯着看，芝麻一上色就该出炉。",
      "visual_cue": "饼面鼓起，芝麻与饼皮呈金褐色"
    }
  ],
  "tips": [
    "猪油是起层的关键，换植物油层次会差一截。",
    "葱绿要擦干水再包，带水会让饼皮发韧。",
    "烤箱温度差异大，第一次烤先看十分钟的状态。",
    "出炉放凉五分钟再吃，里层才够酥不烫嘴。"
  ],
  "common_mistakes": [
    "油酥抹得太少，烤出来是死面饼没有层次。",
    "饼坯擀得太薄，油酥被挤出来，烤盘一层焦油。",
    "还没预热就把饼送进去，饼皮先干硬后不上色。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "黄油",
      "ratio": "60克:60克",
      "note": "香气偏西式，起层效果接近。"
    },
    {
      "original": "面粉",
      "substitute": "低筋面粉",
      "ratio": "300克:300克",
      "note": "口感更松，但面团不易成形。"
    }
  ],
  "variations": [
    "包入一小块咸肉丁与火腿末，做成咸鲜版本。",
    "撒黑芝麻与少许花椒粉，风味更麻香。"
  ],
  "serving_suggestion": "出炉温热时掰开，配一碗豆浆或豆腐脑当早饭，冷了就回炉烤三分钟。",
  "storage": "密封常温放两天，冷冻一周，复烤一百八十度五分钟即恢复酥脆。",
