  "steps": [
    {
      "n": 1,
      "text": "五花肉切成三厘米见方的块，冷水下锅加姜片与一半绍兴酒，煮开撇沫后捞出。",
      "time_min": 16,
      "heat": "中火",
      "tip": "冷水下锅焯，血水才逼得干净，肉也不腥。",
      "visual_cue": "肉块断面无血水，浮沫撇得干净"
    },
    {
      "n": 2,
      "text": "焯好的肉块用温水冲洗一遍，逐块擦干表面水分备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "温水冲不缩肉，肉块擦干才好炒糖色。",
      "visual_cue": "肉块表面干爽，皮上无残毛"
    },
    {
      "n": 3,
      "text": "炒锅下植物油与冰糖，小火慢慢炒到糖化开变成枣红色的糖浆。",
      "time_min": 6,
      "heat": "小火",
      "tip": "糖色到枣红就要立刻下肉，颜色一深就发苦。",
      "visual_cue": "糖浆枣红透亮，表面起细密小泡"
    },
    {
      "n": 4,
      "text": "倒入肉块快速翻炒，让每块都裹上糖色，加姜片、葱结与生抽老抽。",
      "time_min": 6,
      "heat": "中火",
      "tip": "翻炒要快，糖色裹匀成品才红亮诱人。",
      "visual_cue": "肉块通体红亮，锅底酱汁油润"
    },
    {
      "n": 5,
      "text": "淋入剩余绍兴酒与清水没过肉块，大火煮开转小火加盖焖六十分钟。",
      "time_min": 64,
      "heat": "小火",
      "tip": "苏式红烧肉讲究酥而不烂，小火一小时刚好。",
      "visual_cue": "肉块浮在汤中，皮面微微颤动"
    },
    {
      "n": 6,
      "text": "开盖转中火收汁，边收边翻动让酱汁裹匀，加盐调整咸淡后出锅。",
      "time_min": 12,
      "heat": "中火",
      "tip": "收汁到汤汁能挂住肉块就停，过了会发黏。",
      "visual_cue": "汤汁浓稠发亮，肉块油光红润"
    }
  ],
  "tips": [
    "五花肉焯水后用温水冲，肉不会突然收缩变硬。",
    "炒糖色宁浅勿深，颜色一过整锅都带苦味。",
    "绍兴酒下足八十毫升，酒香是苏式红烧肉的灵魂。",
    "小火慢焖一小时，肥肉才化而不腻，瘦肉也不柴。"
  ],
  "common_mistakes": [
    "肉块带水下糖色，油花四溅还溅得满灶台。",
    "糖色炒过头变成黑色，整锅肉都带着焦苦味。",
    "全程大火焖，肉外面烂了里面还硬。",
    "收汁收得太干，肉块黏成一团，酱汁发苦。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "前腿肉",
      "ratio": "900克:900克",
      "note": "瘦一些，焖的时间加十分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "黄冰糖",
      "ratio": "60克:60克",
      "note": "甜味更醇，上色更亮。"
    }
  ],
  "variations": [
    "加几颗剥壳的熟鸡蛋同焖，卤蛋吸满肉汁特别香。",
    "放一小段桂皮和两片香叶，香气更复合，更像老字号的味道。",
    "收汁前加一勺蜂蜜，表面更亮，甜味也更圆润。"
  ],
  "serving_suggestion": "肉块码在深盘里，浇上浓稠的酱汁，配一碗白米饭和一碟青菜，是苏州人家过年必备的一道。",
  "storage": "冷藏可放三天，复热加两勺水小火焖八分钟，蒸热的更软糯。",
