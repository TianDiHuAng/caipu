  "equipment": [
    "电饭锅",
    "炒锅",
    "菜刀",
    "木铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "咸肉切成半厘米见方的小丁，青菜洗净沥干后切成碎末，菜梗菜叶分开装。",
      "time_min": 8,
      "heat": "无火",
      "tip": "咸肉本身带咸味，盐要最后尝过再放，宁少不多",
      "visual_cue": "肉丁切得齐整，菜末干爽不滴水"
    },
    {
      "n": 2,
      "text": "炒锅放植物油烧热，下咸肉丁小火慢慢煸五分钟，煸到肥肉透明出油。",
      "time_min": 6,
      "heat": "小火",
      "tip": "青菜炒到刚塌软就停，靠焖的过程焖熟，颜色才绿",
      "visual_cue": "肉丁透亮，锅底已经煸出一层油"
    },
    {
      "n": 3,
      "text": "先下青菜梗大火炒一分钟，再下菜叶炒到塌软出水，加白糖和盐炒匀。",
      "time_min": 4,
      "heat": "大火",
      "tip": "用隔夜冷饭做也可以，但要先洒两勺清水回软",
      "visual_cue": "菜末炒到塌软，颜色依然翠绿好看"
    },
    {
      "n": 4,
      "text": "把炒好的青菜和咸肉连汤汁一起倒进电饭锅，铺在刚煮好的热米饭上面。",
      "time_min": 3,
      "heat": "无火",
      "tip": "米饭要趁热拌，凉了菜汁就吸不进饭粒里",
      "visual_cue": "菜和肉铺在饭面上，汁水慢慢往下渗"
    },
    {
      "n": 5,
      "text": "盖盖按保温键焖五分钟，让菜汁和油脂渗进米粒，打开后从底部翻拌均匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "焖五分钟就够，时间再长青菜就发黄发暗了",
      "visual_cue": "饭粒油亮，锅里全是菜香和肉香"
    },
    {
      "n": 6,
      "text": "拌好的菜饭盛入碗中压实，喜欢锅巴的可以再按一次煮饭键烘三分钟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "想烘出锅巴要守在锅边，闻到焦香就立刻关火",
      "visual_cue": "底部结一层微焦锅巴，饭粒颗颗分明"
    }
  ],
  "tips": [
    "咸肉本身有咸味，盐一定要最后尝过再放，宁少不多。",
    "青菜炒到刚塌软就停，靠焖的过程把它焖熟，颜色才绿。",
    "用隔夜冷饭做也可以，但要先加两勺清水回软，否则拌不匀。"
  ],
  "common_mistakes": [
    "咸肉不煸直接和饭拌，肥肉吃起来发腻，菜饭也少了那股荤香。",
    "青菜炒得太烂再拌饭，成品整锅发黄，看着就没有食欲。",
    "盐和咸肉一起下锅还按平时量放，菜饭咸得下不了口。"
  ],
  "substitutions": [
    {
      "original": "咸肉",
      "substitute": "腊肉",
      "ratio": "150克:150克",
      "note": "腊肉更硬，需先蒸十分钟再切丁。"
    },
    {
      "original": "青菜",
      "substitute": "小油菜",
      "ratio": "300克:300克",
      "note": "小油菜水分少，焖的时间可缩到三分钟。"
    }
  ],
  "variations": [
    "加一把泡软的干香菇丁同炒，香气更足，素菜饭也能吃两碗。",
    "把咸肉换成广式腊肠，甜香更明显，适合孩子口味。"
  ],
  "serving_suggestion": "热腾腾盛一大碗，配一碗紫菜汤或者腌萝卜，就是江南人冬天的家常午饭。",
  "storage": "冷藏可放两天，回热时加一勺清水盖盖焖三分钟，或直接用平底锅炒散加热。",
