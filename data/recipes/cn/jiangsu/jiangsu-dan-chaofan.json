  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "米饭",
          "name_en": "steamed rice",
          "amount": 400,
          "unit": "g",
          "note": "隔夜冷饭，粒粒分开的最好",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 120,
          "unit": "g",
          "note": "两枚，蛋黄蛋白分开打",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 20,
          "unit": "g",
          "note": "切葱花，分两次下",
          "optional": false
        },
        {
          "name": "胡萝卜",
          "name_en": "carrot",
          "amount": 40,
          "unit": "g",
          "note": "切细丁，只为配色和脆口",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "分两次下，锅要够滑才不粘",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "分两次撒，第一次给蛋第二次给饭",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 8,
          "unit": "ml",
          "note": "沿锅边淋，增香不增色",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "饭勺",
    "打蛋碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "隔夜米饭用手抓散到没有结块，蛋黄打散倒进饭里拌匀，蛋白单独留着。",
      "time_min": 5,
      "heat": "无火",
      "tip": "饭要抓散到每粒分开，不然下锅压不散。",
      "visual_cue": "米粒裹上蛋黄后呈均匀的浅金色，没有白块。"
    },
    {
      "n": 2,
      "text": "炒锅烧到冒轻烟倒一半植物油滑锅，倒蛋白炒成嫩块盛出备用。",
      "time_min": 1,
      "heat": "大火",
      "tip": "锅不够热蛋白会粘底，炒出来一片碎渣。",
      "visual_cue": "蛋白凝成蓬松的白块，锅底干净不粘。"
    },
    {
      "n": 3,
      "text": "补剩下的油下胡萝卜丁炒半分钟，倒入拌好蛋黄的米饭大火翻炒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "米饭下锅后用铲背压散，别用铲刃切，会把米粒切断。",
      "visual_cue": "饭粒在锅里跳动，颗颗分离不粘连。"
    },
    {
      "n": 4,
      "text": "撒第一次盐和一半葱花，继续翻炒到饭粒表面微微发干有香气。",
      "time_min": 2,
      "heat": "大火",
      "tip": "盐分两次撒，一次撒完容易下面咸上面淡。",
      "visual_cue": "饭粒表面干爽泛油光，锅里腾起明显白汽。"
    },
    {
      "n": 5,
      "text": "倒回蛋白，沿锅边淋生抽，撒剩下的盐和葱花，翻两下出锅。",
      "time_min": 1,
      "heat": "大火",
      "tip": "生抽淋锅边不淋饭上，酱香被热锅激出来才不腥。",
      "visual_cue": "饭粒金黄带浅酱色，葱花翠绿未蔫。"
    }
  ],
  "tips": [
    "隔夜饭提前用手抓散，下锅才不会结成一团压不散。",
    "蛋黄先和冷饭拌匀再下锅，每颗米粒都裹上蛋液，炒出来金黄透亮。",
    "炒饭全程大火快炒，锅气一足，饭粒才弹而不湿。"
  ],
  "common_mistakes": [
    "用刚煮好的热饭下锅，水汽太大，炒出来黏成一坨。",
    "蛋液和饭一起倒进去同炒，蛋成碎渣，饭也不香。",
    "小火慢炒怕糊，饭粒被反复翻压，最后变成一团软的米饭。"
  ],
  "substitutions": [
    {
      "original": "胡萝卜",
      "substitute": "豌豆",
      "ratio": "40克:50克",
      "note": "要先焯一分钟再下锅，否则夹生。"
    },
    {
      "original": "生抽",
      "substitute": "盐",
      "ratio": "8毫升:2克",
      "note": "只留咸味，颜色更白净。"
    }
  ],
  "variations": [
    "加一把虾仁和一点火腿丁，就成了家常版扬州炒饭的路子。",
    "出锅前淋半勺葱油，香气更足，冷了也不发硬。"
  ],
  "serving_suggestion": "炒好的饭堆成小山盛盘，撒葱绿，配一碗清汤或一杯豆浆，江苏人家最常见的早餐和夜宵。",
  "storage": "炒饭冷藏可放一天，回锅要大火重新炒透，别微波加热，饭粒会回软发黏。",
