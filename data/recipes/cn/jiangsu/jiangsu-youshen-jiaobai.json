    "砧板",
    "碗",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "茭白剥去外层老壳，切掉底部老根，切成滚刀块备用。",
      "time_min": 10,
      "heat": "无火",
      "tip": "外层的绿壳和老根要去干净，否则带着柴感。",
      "visual_cue": "茭白块洁白饱满，切口平整"
    },
    {
      "n": 2,
      "text": "切好的茭白放沸水里焯两分钟，捞出沥干水分。",
      "time_min": 5,
      "heat": "中火",
      "tip": "焯过水能去掉草酸涩味，也更容易吸味。",
      "visual_cue": "茭白块微微透明，表面不带黏液"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，下茭白块中火煎到四面微黄。",
      "time_min": 6,
      "heat": "中火",
      "tip": "煎到表面起壳，焖完才会外香里嫩。",
      "visual_cue": "茭白块边缘金黄，体积略缩"
    },
    {
      "n": 4,
      "text": "下姜丝炒香，加生抽、老抽、白砂糖与清水，翻匀后加盖小火焖六分钟。",
      "time_min": 9,
      "heat": "小火",
      "tip": "水别太多，焖到刚好收干味道才浓。",
      "visual_cue": "汤汁浸到茭白一半高度，锅盖边缘冒气"
    },
    {
      "n": 5,
      "text": "开盖转大火收汁，边收边翻动让酱汁裹匀，加盐调整咸淡。",
      "time_min": 4,
      "heat": "大火",
      "tip": "收汁要不停翻，糖分容易糊在锅底。",
      "visual_cue": "汤汁浓亮裹住茭白，表面油润"
    },
    {
      "n": 6,
      "text": "淋一圈芝麻油，撒上葱花，快速翻两下即可出锅装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "芝麻油最后淋，香气才留得住。",
      "visual_cue": "葱花翠绿，茭白油亮诱人"
    }
  ],
  "tips": [
    "茭白外层绿壳和底部老根都要去干净，口感才嫩。",
    "焯水这一步能去涩味，别嫌麻烦省掉。",
    "先煎出焦边再焖，吃起来外香里嫩层次更好。",
    "焖的水不要多，收汁时才能紧紧裹住茭白。"
  ],
  "common_mistakes": [
    "茭白没去掉底部老根，吃起来一口渣，白费了好料。",
    "不焯水直接焖，成品带涩味还有草腥。",
    "水加太多焖成一锅汤，茭白寡淡无味。",
    "大火收汁不翻动，锅底糊了整盘带苦味。"
  ],
  "substitutions": [
    {
      "original": "茭白",
      "substitute": "冬笋",
      "ratio": "500克:450克",
      "note": "笋要先焯三分钟去涩，焖的时间加两分钟。"
    },
    {
      "original": "白砂糖",
      "substitute": "冰糖",
      "ratio": "12克:12克",
      "note": "甜味更圆润，收汁更亮。"
    }
  ],
  "variations": [
    "加几片咸肉同焖，油脂渗进茭白，鲜得不一样。",
    "放两只干辣椒一起焖，微辣更下饭。",
    "收汁前撒一把虾米，咸香层次更丰富。"
  ],
  "serving_suggestion": "茭白盛盘，淋上浓亮的酱汁，撒葱花，配白粥或米饭都合适，凉了当小菜也很好吃。",
  "storage": "冷藏可放两天，复热用炒锅大火快炒一分钟，微波加热会出水变软。",
