  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加姜片、大葱段和料酒，中火煮二十分钟捞出放凉。",
      "time_min": 25,
      "heat": "中火",
      "tip": "肉皮用筷子能戳透就捞出，煮久了切片易碎不成形。",
      "visual_cue": "肉皮转透明，压下去有弹性。"
    },
    {
      "n": 2,
      "text": "趁热在肉皮上抹一层生抽，皮朝下放进热锅煎到起小泡、颜色红亮，取出切厚片。",
      "time_min": 12,
      "heat": "中火",
      "tip": "擦干肉皮再煎，起泡才均匀，切出来更好看。",
      "visual_cue": "肉皮金黄起细密小泡，切面红白分明。"
    },
    {
      "n": 3,
      "text": "香糟加少量温水调成稠糊，与生抽、冰糖、盐拌成糟汁，尝一下咸甜再定用量。",
      "time_min": 8,
      "heat": "无火",
      "tip": "糟卤牌子咸淡差别大，先尝再调，宁淡不咸。",
      "visual_cue": "糟汁呈浅褐色，酒香扑鼻。"
    },
    {
      "n": 4,
      "text": "肉片皮朝下整齐码进扣碗，铺上剩余姜片和糟汁，让每片都裹上糟香。",
      "time_min": 6,
      "heat": "无火",
      "tip": "皮朝下摆，蒸好后扣出来皮面朝上，卖相才正。",
      "visual_cue": "肉片层层叠放，糟汁没过底部。"
    },
    {
      "n": 5,
      "text": "扣碗放进蒸锅，大火上汽后转中火蒸九十分钟，中途不揭盖，让糟香慢慢渗进肉里。",
      "time_min": 92,
      "heat": "中火",
      "tip": "蒸够时间肉才酥烂，中途揭盖温度一掉，肉就发紧。",
      "visual_cue": "蒸汽不断，碗边渗出琥珀色油汁。"
    },
    {
      "n": 6,
      "text": "取出扣碗倒出原汁，扣入深盘，原汁勾薄芡淋在肉上，撒葱段即可上桌。",
      "time_min": 8,
      "heat": "小火",
      "tip": "勾芡要薄，能挂住肉片就停，厚了像糊。",
      "visual_cue": "肉皮油亮红褐，汁液顺肉片流下。"
    }
  ],
  "tips": [
    "五花肉选肥瘦三七的方肉，全瘦蒸出来发柴，太肥又腻。",
    "香糟本身带咸，盐要少放，尝过糟汁再加。",
    "蒸的时间可长不可短，两小时肉更酥，筷子一夹就断。"
  ],
  "common_mistakes": [
    "肉煮得过头，切片时肥瘦分离，蒸后散成一团。",
    "肉皮没擦干就下锅煎，油花四溅还不起泡。",
    "糟汁调得太咸，蒸后咸味被浓缩，整碗都吃不下。"
  ],
  "substitutions": [
    {
      "original": "香糟",
      "substitute": "酒糟",
      "ratio": "1:1",
      "note": "酒糟颗粒粗，需用纱布包着挤出糟汁再用，渣子不用。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "1:1",
      "note": "白糖回甜快但光泽略差，用量减五克。"
    }
  ],
  "variations": [
    "常州人家常加几片笋干垫底，吸饱糟汁后比肉还抢手。",
    "有的做法把肉先炸后蒸，皮更皱、更吸味，但油要撇净。"
  ],
  "serving_suggestion": "扣入深盘趁热上桌，配一碗白饭；剩下的糟汁拌饭，是本地人的吃法。",
  "storage": "冷藏可存三日，冷冻两周；复热上锅蒸十五分钟，别用微波炉直接打。",
