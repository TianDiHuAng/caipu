  ],
  "equipment": [
    "蒸锅",
    "鱼盘",
    "小锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去内脏洗净，在鱼身两面各斜划三刀，用料酒和盐抹匀腌十分钟。",
      "time_min": 10,
      "heat": "无火",
      "tip": "划刀处深至骨，热气才能透进去。",
      "visual_cue": "鱼身划口均匀、表面微湿"
    },
    {
      "n": 2,
      "text": "鱼盘底部铺姜片与葱段，把鲈鱼架在上面，鱼腹内也塞几片姜。",
      "time_min": 3,
      "heat": "无火",
      "tip": "垫起来蒸，鱼身受热更均匀。",
      "visual_cue": "鱼身平稳、不贴盘底"
    },
    {
      "n": 3,
      "text": "蒸锅水烧大开后放鱼盘，加盖大火蒸八分钟，关火虚蒸两分钟。",
      "time_min": 10,
      "heat": "大火",
      "tip": "水开再上锅，鱼肉才嫩不腥。",
      "visual_cue": "鱼眼凸白、鱼身骨肉微离"
    },
    {
      "n": 4,
      "text": "取出鱼盘倒掉蒸出的腥水，拣掉姜葱，重新铺上葱丝与姜丝。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘里的水一定要倒掉，否则腥味重。",
      "visual_cue": "盘中清爽、没有积水"
    },
    {
      "n": 5,
      "text": "小锅烧热植物油到微微冒烟，均匀浇在葱姜丝上激出香味。",
      "time_min": 1,
      "heat": "大火",
      "tip": "油要够热，浇下去要有响声。",
      "visual_cue": "葱丝卷曲、香气四溢"
    },
    {
      "n": 6,
      "text": "沿盘边淋入蒸鱼豉油，趁热上桌，吃时蘸汁夹肉。",
      "time_min": 1,
      "heat": "无火",
      "tip": "豉油沿盘边淋，鱼皮不受潮。",
      "visual_cue": "盘底酱汁清亮、鱼肉雪白"
    }
  ],
  "tips": [
    "一斤左右的鱼蒸八分钟最嫩，鱼大要加时间。",
    "蒸鱼豉油可自己用生抽加糖和水调。",
    "千万别提前淋豉油再蒸，肉会变柴。"
  ],
  "common_mistakes": [
    "冷水上锅蒸，鱼肉外层老、里面还带生。",
    "蒸好后不倒腥水，整道菜带土腥味。",
    "大火蒸过了头，鱼肉散成一片片夹不住。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "鲳鱼",
      "ratio": "600g 对 600g",
      "note": "鲳鱼蒸六分钟即可，肉质更紧。"
    },
    {
      "original": "蒸鱼豉油",
      "substitute": "生抽加白糖",
      "ratio": "30ml 对 25ml 加 3g",
      "note": "加少量清水稀释，咸度接近。"
    }
  ],
  "variations": [
    "鱼身下铺几片火腿，鲜味更上一层。",
    "出锅前淋一勺猪油代替植物油，香气更浓。"
  ],
  "serving_suggestion": "整条鱼上桌趁热吃，配白饭与清炒青菜。",
  "storage": "现蒸现吃，冷藏后鱼肉回生，不建议存放。",
