  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗后浸泡六小时以上，泡到米粒捏得碎、手一搓就散。",
      "time_min": 370,
      "heat": "无火",
      "tip": "糯米必须泡透，蒸出来才软糯不夹生。",
      "visual_cue": "米粒发白膨胀，指甲一掐即断"
    },
    {
      "n": 2,
      "text": "泡好的糯米沥干水分，铺在垫了纱布的蒸屉上，戳几个孔透气。",
      "time_min": 8,
      "heat": "无火",
      "tip": "米层别铺太厚，戳孔让蒸汽上来才蒸得匀。",
      "visual_cue": "米层厚薄一致，气孔分布均匀"
    },
    {
      "n": 3,
      "text": "大火蒸二十五分钟至米粒透明软糯，取出稍微放凉到不烫手。",
      "time_min": 28,
      "heat": "大火",
      "tip": "蒸到米粒透亮就是熟了，别蒸过头变糊。",
      "visual_cue": "米粒透亮黏连，铲起来能成团"
    },
    {
      "n": 4,
      "text": "油条回锅复炸一分钟至酥脆，捞出沥油，掰成四厘米长的段。",
      "time_min": 3,
      "heat": "中火",
      "tip": "油条回炸才脆，软油条包进去口感会发韧。",
      "visual_cue": "油条金黄酥脆，掰断有清脆响声"
    },
    {
      "n": 5,
      "text": "保鲜膜上铺一层糯米饭压平，依次放油条、咸蛋黄碎、榨菜与葱花。",
      "time_min": 10,
      "heat": "无火",
      "tip": "饭层别压太薄，包的时候容易破。",
      "visual_cue": "饭层厚薄均匀，配料排在中间"
    },
    {
      "n": 6,
      "text": "撒白砂糖与少许盐，淋芝麻油，借保鲜膜把饭卷紧成圆柱状。",
      "time_min": 6,
      "heat": "无火",
      "tip": "卷的时候一边压一边收，饭团才紧实不散。",
      "visual_cue": "饭团紧实滚圆，两端米粒不外露"
    }
  ],
  "tips": [
    "糯米泡足六小时，蒸出来才软糯有嚼劲。",
    "油条一定要复炸，脆的油条才是粢饭团的灵魂。",
    "卷的时候边压边收，饭团切开才不散。",
    "甜咸可以自己做主，加糖是苏州吃法，加榨菜更咸香。"
  ],
  "common_mistakes": [
    "糯米没泡透就蒸，饭粒硬得咬不动。",
    "油条不炸直接用，包进去软塌塌像面团。",
    "饭层压太薄，一卷就破，配料全漏出来。",
    "趁热就卷，糯米太黏手，饭团捏不成形。"
  ],
  "substitutions": [
    {
      "original": "咸蛋黄",
      "substitute": "肉松",
      "ratio": "3个:60克",
      "note": "咸香口感更松散，用量可略多。"
    },
    {
      "original": "榨菜",
      "substitute": "酸豆角",
      "ratio": "60克:60克",
      "note": "酸味更重，糖可多加五克。"
    }
  ],
  "variations": [
    "包一根火腿肠进去，是学生党最爱的加料版本。",
    "甜口的只放白砂糖和芝麻，不加咸配料，苏州人从小吃这个。",
    "外层裹一层炒香的黑芝麻，香气和卖相都升级。"
  ],
  "serving_suggestion": "卷好后连保鲜膜对半切开，切口朝上摆盘，配一碗豆浆或咸豆花就是标准的江南早饭。",
  "storage": "常温当天吃完，冷藏可放一天，复热用蒸锅蒸五分钟或微波三十秒。",
