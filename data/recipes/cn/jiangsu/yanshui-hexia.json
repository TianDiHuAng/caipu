      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "剪刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾剪去须脚与额剑，用清水冲洗两遍，沥干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "须脚不剪，成菜看着杂乱。",
      "visual_cue": "虾身干爽、外壳透亮"
    },
    {
      "n": 2,
      "text": "锅中加清水，放生姜片与小葱结，大火烧开煮三分钟出味。",
      "time_min": 4,
      "heat": "大火",
      "tip": "姜葱先煮出味，汤底才不寡淡。",
      "visual_cue": "水面翻滚、闻到姜与葱的香气"
    },
    {
      "n": 3,
      "text": "加盐与料酒，倒入虾，保持大火煮九十秒至虾身弯曲变红。",
      "time_min": 2,
      "heat": "大火",
      "tip": "一变色就关火，多煮十秒就老。",
      "visual_cue": "外壳通红、虾身蜷成弧形"
    },
    {
      "n": 4,
      "text": "关火后在原汤里浸两分钟再捞出装盘，淋两勺原汤上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "离火浸一会儿，虾身更入味。",
      "visual_cue": "虾身紧实弹牙、汤色清亮"
    }
  ],
  "tips": [
    "要选活虾，死虾煮出来发散发柴。",
    "盐比平时炒菜重一点，汤里才有味。",
    "煮虾的原汤别倒，留着拌面很鲜。"
  ],
  "common_mistakes": [
    "煮的时间过长，虾身缩成一小团咬不动。",
    "水没开就下锅，虾身松散还带腥味。",
    "盐放得太少，虾身淡而无味，蘸醋也补不回来。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "基围虾",
      "ratio": "500g 对 500g",
      "note": "个头更大，煮制时间加三十秒。"
    },
    {
      "original": "小葱",
      "substitute": "大葱",
      "ratio": "20g 对 30g",
      "note": "香气更冲，需多煮一分钟。"
    }
  ],
  "variations": [
    "煮的时候加十克花椒，香味更足，是淮扬馆子的常见做法。",
    "换成个头更大的海产同法煮，鲜味更浓。"
  ],
  "serving_suggestion": "捞出立刻上桌，配一小碟香醋蘸食。",
  "storage": "不建议存放，凉了再热虾身会发柴。",
