  "steps": [
    {
      "n": 1,
      "text": "老鸭斩成四厘米见方的块，去掉尾部油脂与喉管，冷水浸泡二十分钟去血水。",
      "time_min": 22,
      "heat": "无火",
      "tip": "老鸭尾部与厚油块腥味最重，宁可多切掉一些。",
      "visual_cue": "血水渗出，老鸭块颜色变浅。"
    },
    {
      "n": 2,
      "text": "老鸭块冷水下锅，加料酒和一半姜片，煮开撇净浮沫后捞出用温水冲洗干净。",
      "time_min": 15,
      "heat": "中火",
      "tip": "温水冲老鸭块，冷水冲会让肉骤紧，炖后发柴。",
      "visual_cue": "浮沫结块，老鸭皮收紧发白。"
    },
    {
      "n": 3,
      "text": "白果用刀背轻拍去壳，剥掉褐色薄衣，剖开去掉中间绿芯后冲洗干净。",
      "time_min": 10,
      "heat": "无火",
      "tip": "白果的绿芯带微毒和苦味，必须去净，用量别超二十粒。",
      "visual_cue": "白果仁乳白完整，芯子全部挑出。"
    },
    {
      "n": 4,
      "text": "砂锅放老鸭块、剩余姜片、大葱段和清水，大火烧开后撇沫转小火炖七十分钟。",
      "time_min": 75,
      "heat": "小火",
      "tip": "小火只冒小泡，汤才清不浑；大滚会让汤变白浊。",
      "visual_cue": "汤面微滚，老鸭块沉底，汤色转浅金。"
    },
    {
      "n": 5,
      "text": "下白果和红枣继续炖二十分钟，让白果吸足老鸭汤，口感由脆转糯。",
      "time_min": 22,
      "heat": "小火",
      "tip": "白果炖足时间才软糯，时间短了发硬还带涩味。",
      "visual_cue": "白果由乳白转半透明，老鸭肉轻推离骨。"
    },
    {
      "n": 6,
      "text": "加盐调味，撒枸杞再焖三分钟，撇去表面浮油后连汤盛出上桌。",
      "time_min": 6,
      "heat": "微火",
      "tip": "枸杞最后放，久煮发酸变色，汤也发暗。",
      "visual_cue": "汤色金黄清亮，浮油薄薄一层。"
    }
  ],
  "tips": [
    "老鸭肉质紧实、炖出的汤更浓，选两斤半上下、养足三年的老鸭最合适。",
    "想汤更清可把老鸭皮全部撕掉，油脂少了汤更透。",
    "红枣去核再炖，汤不发酸，甜味也更纯。"
  ],
  "common_mistakes": [
    "白果没去芯就下锅，汤发苦，多吃还容易不适。",
    "炖汤时大火猛滚，汤色浑浊，老鸭肉也散成碎块。",
    "盐在炖煮中途加入，老鸭肉紧缩，炖一小时还是发硬。"
  ],
  "substitutions": [
    {
      "original": "白果",
      "substitute": "莲子",
      "ratio": "1:1",
      "note": "莲子需提前泡两小时，炖的时间延长十分钟。"
    },
    {
      "original": "老鸭",
      "substitute": "老鸭",
      "ratio": "1:1.1",
      "note": "肉质更易炖烂，炖的时间缩短到五十分钟。"
    }
  ],
  "variations": [
    "苏南人家常加一小把薏米同炖，汤更清润，夏天喝最舒服。",
    "有的做法把老鸭块先干锅煸出油再炖，汤更香浓、油也少些。"
  ],
  "serving_suggestion": "饭前喝一碗热汤，老鸭肉蘸姜醋汁吃；汤头清爽，配一碗白饭就是一顿。",
  "storage": "冷藏可存三日，冷冻两周；复热撇净浮油，小火温开即可。",
