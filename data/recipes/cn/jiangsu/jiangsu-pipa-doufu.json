  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐用纱布包好压十分钟去水，再放到细筛上刮成细腻的豆腐泥。",
      "time_min": 15,
      "heat": "无火",
      "tip": "豆腐泥越细，成品口感越滑，刮筛这步别省。",
      "visual_cue": "豆腐泥细腻无颗粒，纱布几乎拧不出水"
    },
    {
      "n": 2,
      "text": "虾仁剔掉背上的黑线剁成细茸，加绍兴酒、盐与白胡椒粉搅到发黏。",
      "time_min": 8,
      "heat": "无火",
      "tip": "虾仁茸要剁细并搅上劲，蒸完才弹牙。",
      "visual_cue": "虾仁茸黏稠成团，颜色粉白发亮"
    },
    {
      "n": 3,
      "text": "豆腐泥与虾仁茸混合，加蛋清与一半淀粉，顺一个方向搅成细腻的糊。",
      "time_min": 8,
      "heat": "无火",
      "tip": "同方向搅才不出水，糊越细成品越嫩。",
      "visual_cue": "混合糊细腻稠滑，能挂在勺背上"
    },
    {
      "n": 4,
      "text": "取瓷勺抹油，把豆腐糊填成琵琶形状，用香菇丝摆出琴弦的样子。",
      "time_min": 12,
      "heat": "无火",
      "tip": "造型抹平一点，蒸完才不会塌变形。",
      "visual_cue": "坯体饱满如琵琶，香菇丝排列整齐"
    },
    {
      "n": 5,
      "text": "上蒸锅中小火蒸十分钟，取出小心脱勺摆盘。",
      "time_min": 14,
      "heat": "中小火",
      "tip": "中小火蒸才不起蜂窝，火大表面会粗糙。",
      "visual_cue": "豆腐坯洁白光滑，轻晃微颤"
    },
    {
      "n": 6,
      "text": "高汤加盐烧开，用剩余淀粉勾薄芡，淋芝麻油浇在豆腐上撒葱花。",
      "time_min": 6,
      "heat": "中火",
      "tip": "芡汁要薄要亮，太厚会盖住豆腐的细嫩。",
      "visual_cue": "芡汁透明发亮，缓缓挂在豆腐表面"
    }
  ],
  "tips": [
    "豆腐一定要压水，水多蒸完就塌成一片。",
    "虾仁茸要剁得极细并搅上劲，弹性和鲜味全靠这一步。",
    "中小火蒸十分钟，火大会起蜂窝影响卖相。",
    "薄芡是这道菜的门面，芡厚了就失了清雅。"
  ],
  "common_mistakes": [
    "豆腐没压水就拌，蒸完塌成不成形的一滩。",
    "大火蒸，表面起蜂窝，琵琶的造型全毁。",
    "虾仁茸没剁细，成品里硌牙还有腥味。",
    "芡汁勾得太稠，糊在豆腐上像一层浆糊。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "鸡胸肉",
      "ratio": "150克:150克",
      "note": "剁茸后加少许猪油，口感更润。"
    },
    {
      "original": "嫩豆腐",
      "substitute": "内酯豆腐",
      "ratio": "400克:400克",
      "note": "更嫩但更易碎，脱模要轻。"
    }
  ],
  "variations": [
    "点缀几粒熟青豆当琴轴，造型更完整。",
    "浇汁里加几丝火腿末，鲜味和颜色都提升。",
    "蒸好后放进高汤里小火煨两分钟，更入味。"
  ],
  "serving_suggestion": "琵琶豆腐整齐摆在白盘里，浇上透明薄芡，撒葱花与少许火腿末，作为宴客的头道热菜很体面。",
  "storage": "冷藏可放一天，复热用蒸锅中小火蒸五分钟，微波加热会让豆腐出水塌形。",
