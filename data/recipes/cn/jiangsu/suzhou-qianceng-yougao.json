  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 300,
          "unit": "g",
          "note": "中筋面粉过筛",
          "optional": false
        },
        {
          "name": "糯米粉",
          "name_en": "glutinous rice flour",
          "amount": 60,
          "unit": "g",
          "note": "掺入增加软糯",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "猪油",
          "name_en": "lard",
          "amount": 60,
          "unit": "g",
          "note": "化开刷层",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "分层撒用",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 4,
          "unit": "g",
          "note": "发面用",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "泡打粉",
          "name_en": "baking powder",
          "amount": 3,
          "unit": "g",
          "note": "辅助膨松",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 15,
          "unit": "g",
          "note": "表面撒",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 180,
          "unit": "ml",
          "note": "温水化酵母",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸笼",
    "擀面杖",
    "案板",
    "大盆",
    "湿布"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉与糯米粉一起过筛到大盆里，加酵母和泡打粉拌匀，慢慢倒入温水搅成絮状。",
      "time_min": 10,
      "heat": "无火",
      "tip": "糯米粉掺进去糕体才软糯，全用面粉蒸出来发硬。",
      "visual_cue": "盆里没有干粉，絮状面团抱团"
    },
    {
      "n": 2,
      "text": "下手揉成光滑面团，盖上湿布放在温暖处醒发到体积两倍大，手指戳洞不回缩。",
      "time_min": 40,
      "heat": "无火",
      "tip": "冬天室温低，可以把盆放进三十度的温水锅里，发得更快。",
      "visual_cue": "面团鼓起，戳洞不回弹"
    },
    {
      "n": 3,
      "text": "猪油隔水化开，取一半刷在案板上防粘，面团擀成半厘米厚的长方片。",
      "time_min": 12,
      "heat": "无火",
      "tip": "面片擀得越薄层次越多，但要均匀，厚薄不一会擀破。",
      "visual_cue": "面片透光，边缘整齐"
    },
    {
      "n": 4,
      "text": "在面片上刷一层猪油，均匀撒上白糖，从长边卷起成筒，再压扁擀成长片，重复一次折叠。",
      "time_min": 12,
      "heat": "无火",
      "tip": "每卷一次都要刷油撒糖，层次才分明，糖别撒到边缘会漏。",
      "visual_cue": "面片半透明，边缘整齐无破口"
    },
    {
      "n": 5,
      "text": "折好的糕坯放进垫了湿布的蒸笼，盖上盖醒二十分钟，冷水上锅中大火蒸三十分钟。",
      "time_min": 32,
      "heat": "中大火",
      "tip": "蒸的时候不要掀盖，一冷一热糕面就塌，出现凹陷的坑。",
      "visual_cue": "糕体膨起，表面白净有光"
    },
    {
      "n": 6,
      "text": "关火焖三分钟再开盖，趁热撒上芝麻，稍凉后切成菱形块装盘。",
      "time_min": 5,
      "heat": "无火",
      "tip": "焖三分钟让糕体定型，急着开盖会回缩，切块也容易塌。",
      "visual_cue": "切面层次分明，芝麻均匀"
    }
  ],
  "tips": [
    "千层油糕的关键在折，卷得层次多，蒸出来才有层层的酥软口感。",
    "猪油要提前化开但不能烫手，太热会把酵母烫死，面就发不起来。",
    "切块用抹了油的刀，切口光滑不粘，卖相比拉扯着切开的好得多。"
  ],
  "common_mistakes": [
    "用滚水化猪油直接倒进面里，酵母被烫死，蒸出来是一块死面硬疙瘩。",
    "只卷一次就上锅，层次少，吃起来像普通发糕，没有千层油糕的松软。",
    "蒸好立刻开盖，冷空气一冲糕体回缩塌陷，表面全是月球坑。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "黄油",
      "ratio": "60克:60克",
      "note": "黄油版奶香更重，需提前软化再刷。"
    },
    {
      "original": "白糖",
      "substitute": "红糖",
      "ratio": "80克:70克",
      "note": "红糖甜度低，颜色偏深，风味更浓。"
    }
  ],
  "variations": [
    "在糖层里拌入炒香的芝麻和少许桂花糖，就是苏州老字号的桂花千层糕。",
    "把白糖换成红豆沙抹层，做成豆沙千层糕，孩子更爱吃，甜度也更柔和。"
  ],
  "serving_suggestion": "切块后趁温热吃最松软，配一壶碧螺春解甜；凉透后回蒸五分钟，口感能恢复大半。",
  "storage": "密封冷藏可存两天，吃前上锅回蒸五分钟；不要用微波炉，糕体容易发硬发干。",
