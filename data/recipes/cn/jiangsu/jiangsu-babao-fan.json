  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗干净后浸泡四小时，泡到米粒用手指一碾就碎的程度。",
      "time_min": 245,
      "heat": "无火",
      "tip": "糯米泡透才蒸得软，泡不够蒸完夹生。",
      "visual_cue": "米粒发白饱满，一碾即成粉"
    },
    {
      "n": 2,
      "text": "泡好的糯米沥干，上蒸锅大火蒸三十分钟，蒸锅里的清水要一次加足。",
      "time_min": 34,
      "heat": "大火",
      "tip": "米要摊开蒸，铺太厚中间蒸不透。",
      "visual_cue": "米粒透亮软糯，无白色硬芯"
    },
    {
      "n": 3,
      "text": "趁热把白砂糖与猪油拌进糯米里，搅到米粒颗颗油亮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "趁热拌糖和猪油才化得开，凉了就拌不匀。",
      "visual_cue": "米粒裹着油光，甜香扑鼻"
    },
    {
      "n": 4,
      "text": "碗内壁抹一层猪油，把红枣、莲子与葡萄干在碗底摆成整齐的花样。",
      "time_min": 12,
      "heat": "无火",
      "tip": "碗壁抹油才脱得干净，花样摆紧一点更好看。",
      "visual_cue": "果料在碗底排列成对称图案"
    },
    {
      "n": 5,
      "text": "铺一层拌好的糯米压平，中间放红豆沙，再盖一层糯米压紧实。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆沙别铺到碗边，否则蒸完会溢出来。",
      "visual_cue": "表面平整，米层包住豆沙不外露"
    },
    {
      "n": 6,
      "text": "上蒸锅大火蒸四十分钟，倒扣在盘里脱模，用玉米淀粉勾薄芡淋上即可。",
      "time_min": 44,
      "heat": "大火",
      "tip": "蒸足四十分钟米和豆沙才融在一起。",
      "visual_cue": "扣出后花纹完整，米面油润发亮"
    }
  ],
  "tips": [
    "糯米泡足四小时，蒸出来才软糯不夹生。",
    "糖和猪油要趁热拌，米粒才会油亮香甜。",
    "碗底抹猪油，脱模的时候一扣就完整下来。",
    "豆沙别铺到碗边，蒸的时候会往外溢，卖相就毁了。"
  ],
  "common_mistakes": [
    "糯米没泡透就蒸，蒸完中间还是硬芯。",
    "不抹油直接装碗，倒扣时整块粘在碗上。",
    "糯米层压得不实，扣出来散成一片。",
    "蒸的时间不足，豆沙和米是分离的两层。"
  ],
  "substitutions": [
    {
      "original": "猪油",
      "substitute": "玉米油",
      "ratio": "40克:35克",
      "note": "少了香气，口感略清爽。"
    },
    {
      "original": "红豆沙",
      "substitute": "白莲蓉",
      "ratio": "200克:200克",
      "note": "甜度更高，糖可减十五克。"
    }
  ],
  "variations": [
    "果料里加几片糖冬瓜和蜜枣，更像老式八宝饭的样子。",
    "豆沙里拌一点桂花糖，香气更江南。",
    "做成小碗单份，宴客时一人一份更精致。"
  ],
  "serving_suggestion": "扣出的八宝饭摆盘，花纹朝上，淋一层薄薄的糖芡，趁热吃米糯馅甜最香。",
  "storage": "冷藏可放两天，复热用蒸锅大火蒸十五分钟，微波加热会让米粒变硬。",
