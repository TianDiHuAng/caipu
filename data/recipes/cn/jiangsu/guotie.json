  "equipment": [
    "揉面盆",
    "擀面杖",
    "平底锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉加一百五十毫升清水揉成光滑面团，盖湿布醒半小时。",
      "time_min": 35,
      "heat": "无火",
      "tip": "醒面到位，面皮擀开才不回缩。",
      "visual_cue": "面团光滑不粘手、按压慢回弹"
    },
    {
      "n": 2,
      "text": "猪肉末加生抽、料酒、盐、白胡椒与生姜末顺时针搅打上劲。",
      "time_min": 8,
      "heat": "无火",
      "tip": "搅到发黏，馅才抱团不出汤。",
      "visual_cue": "肉馅黏稠起胶、筷子能立住"
    },
    {
      "n": 3,
      "text": "韭菜碎拌入香油锁住水分，再与肉馅、葱花一起拌匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "韭菜先用香油拌，久放也不出水。",
      "visual_cue": "馅料湿润油亮、韭菜翠绿"
    },
    {
      "n": 4,
      "text": "面团搓成长条，切成小剂子，擀成中间稍厚边缘薄的圆皮。",
      "time_min": 15,
      "heat": "无火",
      "tip": "中间厚才兜得住馅，边缘薄好收口。",
      "visual_cue": "面皮圆整、中间略厚"
    },
    {
      "n": 5,
      "text": "每张皮放一勺馅，对折捏紧中间，两头留口成锅贴生坯。",
      "time_min": 15,
      "heat": "无火",
      "tip": "两头不封口，煎时才透气不鼓。",
      "visual_cue": "生坯两头敞开、捏口紧实"
    },
    {
      "n": 6,
      "text": "平底锅刷植物油，生坯码放整齐，中火煎两分钟至底面微黄。",
      "time_min": 3,
      "heat": "中火",
      "tip": "锅贴之间留缝，煎熟后不易粘连。",
      "visual_cue": "底面结壳、颜色浅金"
    },
    {
      "n": 7,
      "text": "沿锅边淋入清水至三分之一高，盖盖中火焖六分钟收干。",
      "time_min": 7,
      "heat": "中火",
      "tip": "水汽焖熟馅，底部才脆不焦。",
      "visual_cue": "锅内水声变小、盖子微掀见干"
    },
    {
      "n": 8,
      "text": "开盖转小火把底煎脆，撒葱花与熟芝麻即可出锅。",
      "time_min": 3,
      "heat": "小火",
      "tip": "最后小火烘脆，别急着铲。",
      "visual_cue": "底面金黄酥脆、边缘透亮"
    }
  ],
  "tips": [
    "面团用温水和，皮更软更好擀开。",
    "猪肉末选肥瘦相间的，煎出来汁水足。",
    "一次多做些生坯，冷冻后直接煎很方便。"
  ],
  "common_mistakes": [
    "面皮擀得太薄，包馅的时候一捏就破皮。",
    "韭菜早早拌进肉馅，出水把馅泡散。",
    "煎的时候一直大火，底部焦了馅还没熟。"
  ],
  "substitutions": [
    {
      "original": "韭菜",
      "substitute": "白菜",
      "ratio": "120g 对 150g",
      "note": "需先撒盐挤水，避免出汤。"
    },
    {
      "original": "猪肉末",
      "substitute": "牛肉末",
      "ratio": "250g 对 250g",
      "note": "需多加一勺清水，馅才不柴。"
    }
  ],
  "variations": [
    "把韭菜换成韭黄，馅的香气会更清雅一些。",
    "煎的时候加一勺面粉水，能出冰花脆底。"
  ],
  "serving_suggestion": "趁热吃底脆馅香，配一碗蛋花汤正好。",
  "storage": "生坯冷冻可放半个月，熟品当天吃完。",
