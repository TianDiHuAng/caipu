    "细孔筛",
    "炒锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐干先片成 1mm 薄片，再切成 1mm 粗细的丝，放入清水中轻轻拨散。",
      "time_min": 15,
      "heat": "无火",
      "tip": "刀要薄而稳，切丝粗细一致才能同时熟。",
      "visual_cue": "干丝根根分明，长短一致"
    },
    {
      "n": 2,
      "text": "干丝用沸水浸烫 2 分钟，去除豆腥味，捞出沥干备用。",
      "time_min": 3,
      "heat": "大火",
      "tip": "烫的时间不要太长，干丝会断、失去韧性。",
      "visual_cue": "干丝变软但仍挺括，水略发白"
    },
    {
      "n": 3,
      "text": "虾仁加料酒、白胡椒与 2g 盐抓匀腌 5 分钟；火腿丝、笋丝用高汤焯 1 分钟。",
      "time_min": 6,
      "heat": "中火",
      "tip": "火腿本身有咸味，先焯一次可避免汤过咸。",
      "visual_cue": "火腿丝颜色转浅红，笋丝断生"
    },
    {
      "n": 4,
      "text": "炒锅下猪油化开，下姜片、葱段煸香，倒入高汤烧开，捞出葱姜。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "猪油是这道菜的灵魂，缺了汤会寡淡。",
      "visual_cue": "汤面泛油光，香气清鲜"
    },
    {
      "n": 5,
      "text": "下干丝与笋丝小火煮 8 分钟，再下虾仁、火腿丝煮 2 分钟，调盐出锅。",
      "time_min": 10,
      "heat": "小火",
      "tip": "小火慢煮让干丝吸足汤味，汤面保持微沸不翻滚。",
      "visual_cue": "干丝吸饱汤汁变沉，汤色乳白微黄"
    }
  ],
  "tips": [
    "干丝切得越细越考验刀工，家庭可用擦片器先片薄再切丝。",
    "高汤建议提前吊好，清水代替会明显寡淡。",
    "盛碗时先放干丝再浇汤，表面堆火腿丝与虾仁更好看。"
  ],
  "common_mistakes": [
    "干丝不烫直接下锅，豆腥味盖住汤鲜。",
    "盐一次放太多，火腿与高汤本身已有咸味，汤会过咸。",
    "盐一次放多，火腿与高汤本身已有咸味。"
  ],
  "substitutions": [
    {
      "original": "豆腐干",
      "substitute": "嫩豆腐",
      "ratio": "300g 干丝 ≈ 350g 嫩豆腐（切条）",
      "note": "口感更嫩但不成丝，属家庭简易版。"
    },
    {
      "original": "河虾仁",
      "substitute": "虾仁",
      "ratio": "1:1",
      "note": "大虾仁切小段，煮制时间不变。"
    }
  ],
  "variations": [
    "家庭简化版：用现成干丝（真空包装）代替手工切丝，省 10 分钟。",
    "蟹粉版：起锅前加 30g 蟹粉，做成蟹粉干丝，鲜味更浓。"
  ],
  "serving_suggestion": "作为早茶或宴席的头道汤菜，配小笼包、汤包同食最经典。",
  "storage": "冷藏 1 天，复热需加 100ml 高汤稀释，干丝久放会吸干汤汁。",
