  "equipment": [
    "平底锅",
    "擀面杖",
    "湿布",
    "汤锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪皮焯水后刮净油脂，加 500ml 水小火熬 60 分钟至汤汁浓稠，冷藏成皮冻后切 0.5cm 小丁。",
      "time_min": 70,
      "heat": "小火",
      "tip": "皮冻是汤汁的来源，熬到挂勺才够浓。",
      "visual_cue": "汤汁冷却后能整块脱模"
    },
    {
      "n": 2,
      "text": "酵母用 200ml 温水化开，倒进面粉揉成光滑面团，盖湿布醒发 60 分钟至两倍大。",
      "time_min": 65,
      "heat": "无火",
      "tip": "水温 35℃ 左右，太烫会把酵母烫死。",
      "visual_cue": "面团戳洞不回缩、内部呈蜂窝状"
    },
    {
      "n": 3,
      "text": "猪肉馅加盐、生抽、白糖、料酒与姜末搅打上劲，拌入 100g 皮冻丁与香油。",
      "time_min": 8,
      "heat": "无火",
      "tip": "皮冻丁别剁太碎，煎化后才有汤。",
      "visual_cue": "馅料黏稠发亮、皮冻分布均匀"
    },
    {
      "n": 4,
      "text": "面团排气后搓条，切成 25g 一个的剂子，擀成中间厚边缘薄的圆皮。",
      "time_min": 12,
      "heat": "无火",
      "tip": "边缘薄才不厚皮，中间厚才不漏汤。",
      "visual_cue": "皮呈碗状、中心明显较厚"
    },
    {
      "n": 5,
      "text": "每张皮包入 15g 馅料，捏褶收口朝下摆放，二次醒发 15 分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "二次醒发到位，煎出来才蓬松。",
      "visual_cue": "生胚明显变大、手感轻飘"
    },
    {
      "n": 6,
      "text": "平底锅倒 40ml 植物油，收口朝下摆入生胚，中火煎 3 分钟至底部金黄，沿锅边淋 100ml 清水盖盖焖 8 分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "水要沿锅边淋，别直接浇在包子上。",
      "visual_cue": "底部结硬壳、锅内水声变小"
    },
    {
      "n": 7,
      "text": "开盖撒黑芝麻与小葱花，再煎 1 分钟收干水汽即可出锅。",
      "time_min": 2,
      "heat": "中火",
      "tip": "最后收干水汽，底部才够脆。",
      "visual_cue": "包底焦脆、表面芝麻葱花密布"
    }
  ],
  "tips": [
    "皮冻必须熬浓，否则煎后没有汤汁。",
    "煎的时间别太长，底部一焦就发苦。",
    "收口一定朝下先煎，包子才饱满不塌。"
  ],
  "common_mistakes": [
    "皮冻熬得太稀，包子里全是水没有胶质汤汁。",
    "面团没醒到位就包，煎出来死面发硬。",
    "直接大火盖盖焖，水汽太大把底部泡软。"
  ],
  "substitutions": [
    {
      "original": "猪肉馅",
      "substitute": "虾仁猪肉馅",
      "ratio": "250g 对 200g+80g",
      "note": "鲜味更足，盐减 1g。"
    },
    {
      "original": "猪皮",
      "substitute": "鸡爪",
      "ratio": "150g 对 200g",
      "note": "同样能出胶，汤色更清。"
    }
  ],
  "variations": [
    "虾仁版：馅里加 80g 虾仁丁，鲜度翻倍。",
    "素煎包：用白菜香菇粉丝做馅，不加皮冻。"
  ],
  "serving_suggestion": "出锅趁热吃，配一碗蛋皮汤或豆浆。",
  "storage": "生胚冷冻 1 周，熟包冷藏 1 天；复热用平底锅加少量水焖 4 分钟。",
