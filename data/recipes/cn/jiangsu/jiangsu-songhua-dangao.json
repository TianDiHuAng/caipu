    "砧板",
    "小碗",
    "盘",
    "牙线"
  ],
  "steps": [
    {
      "n": 1,
      "text": "松花蛋剥壳，用清水冲掉表面碎壳和灰渣。，看准状态再往下做。",
      "time_min": 5,
      "heat": "无火",
      "tip": "壳渣冲不净，吃着硌牙。，看准状态再往下做。",
      "visual_cue": "蛋体完整，表面光洁"
    },
    {
      "n": 2,
      "text": "用细线或牙线把松花蛋勒成六瓣，刀切会粘。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "线勒的切面平整，蛋心不糊刀。，看准状态再往下做。",
      "visual_cue": "花瓣完整，蛋心不散"
    },
    {
      "n": 3,
      "text": "姜切末，小葱切花，小米辣切圈备用。，看准状态再往下做。",
      "time_min": 4,
      "heat": "无火",
      "tip": "姜末要多一点，压蛋的碱味。，看准状态再往下做。",
      "visual_cue": "末粒均匀，颜色分明"
    },
    {
      "n": 4,
      "text": "小碗里放生抽、香醋、白糖和香油调匀。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "糖要化开，酸甜才不冲。，看准状态再往下做。",
      "visual_cue": "汁色透亮，油花漂浮"
    },
    {
      "n": 5,
      "text": "蛋瓣摆盘，中间放姜末和辣椒圈。，看准状态再往下做。",
      "time_min": 3,
      "heat": "无火",
      "tip": "摆成放射状，上桌更好看。，看准状态再往下做。",
      "visual_cue": "花形整齐，色彩分明"
    },
    {
      "n": 6,
      "text": "淋上调好的汁，撒葱花即可。，看准状态再往下做。",
      "time_min": 2,
      "heat": "无火",
      "tip": "吃前再淋，蛋才不发硬。，看准状态再往下做。",
      "visual_cue": "汁液铺满，葱花点缀"
    }
  ],
  "tips": [
    "用线勒蛋，切面平整不糊刀。，这一点很关键。",
    "姜末必须给足，能压住蛋的碱味。，这一点很关键。",
    "汁临上桌再淋，蛋久泡会变硬。，这一点很关键。"
  ],
  "common_mistakes": [
    "用刀切，蛋心全粘在刀上。，这一点很关键。",
    "不放姜末，碱味冲得吃不下。，这一点很关键。",
    "提前浇汁放太久，蛋体发硬。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "松花蛋",
      "substitute": "咸鸭蛋",
      "ratio": "3 个:3 个",
      "note": "不用加盐，糖可以略减。"
    },
    {
      "original": "香醋",
      "substitute": "镇江香醋",
      "ratio": "15 毫升:15 毫升",
      "note": "酸味更柔，回甘明显。"
    }
  ],
  "variations": [
    "加一勺豆腐乳调汁，风味更重。，这一点很关键。",
    "配嫩豆腐一起拌，做成皮蛋豆腐。，这一点很关键。"
  ],
  "serving_suggestion": "配粥或作为下酒凉菜。，这一点很关键。",
  "storage": "冷藏一天，汁水另装，吃前再淋。，这一点很关键。",
