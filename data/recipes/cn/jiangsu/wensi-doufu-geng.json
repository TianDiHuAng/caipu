  "steps": [
    {
      "n": 1,
      "text": "豆腐 300g 先片成 0.3 厘米薄片，再切成细如发丝的豆腐丝，泡在清水里备用。",
      "time_min": 12,
      "heat": "无火",
      "tip": "刀蘸水再切，豆腐不易粘刀。",
      "visual_cue": "豆腐丝细匀、水中散开不碎"
    },
    {
      "n": 2,
      "text": "鸡胸肉 60g、火腿 30g、香菇 30g 与笋 40g 分别切成同样粗细的细丝。",
      "time_min": 8,
      "heat": "无火",
      "tip": "所有丝粗细一致，成熟时间才同步。",
      "visual_cue": "四色细丝整齐、长短相近"
    },
    {
      "n": 3,
      "text": "汤锅倒入 900ml 高汤烧开，先下鸡丝、火腿丝、香菇丝与笋丝煮 5 分钟。",
      "time_min": 5,
      "heat": "中火",
      "tip": "配料先煮出味，汤才够鲜。",
      "visual_cue": "汤色微浑、配料浮起"
    },
    {
      "n": 4,
      "text": "轻轻推入豆腐丝，转小火煮 3 分钟，用勺背推散避免结团。",
      "time_min": 3,
      "heat": "小火",
      "tip": "千万别用勺搅，豆腐丝一搅就断。",
      "visual_cue": "豆腐丝散开、汤面浮起细丝"
    },
    {
      "n": 5,
      "text": "加 4g 盐与 2g 白胡椒粉调味，15g 淀粉调水分两次勾芡至汤呈薄糊状。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芡分两次下，浓度才好控制。",
      "visual_cue": "汤体透亮、勺背能挂一层薄芡"
    },
    {
      "n": 6,
      "text": "关火淋 5ml 香油，轻轻推匀后盛入汤碗。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油关火后放，香气才不散。",
      "visual_cue": "汤面泛油光、丝缕分明"
    }
  ],
  "tips": [
    "豆腐切丝前先片薄，刀身蘸水切更顺滑。",
    "勾芡分两次，芡汁才不会结块发糊。",
    "全程用勺背推，豆腐丝才能保持完整。"
  ],
  "common_mistakes": [
    "豆腐直接切丝不片薄，切出来粗细不匀。",
    "用勺大力搅动，豆腐丝全断成碎渣。",
    "一次把芡倒完，汤瞬间凝成稠糊。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "内酯豆腐",
      "ratio": "300g 对 300g",
      "note": "更嫩更易碎，切丝动作要更轻。"
    },
    {
      "original": "鸡胸肉",
      "substitute": "鸡腿肉",
      "ratio": "60g 对 60g",
      "note": "口感更滑，煮制时间减 1 分钟。"
    }
  ],
  "variations": [
    "加 20g 熟蟹肉同煮，鲜味更上一层。",
    "最后撒 5g 香菜末，颜色更清爽。"
  ],
  "serving_suggestion": "盛在浅口白瓷碗中，清澈见丝，配一碟小点。",
  "storage": "现做现吃，冷藏后豆腐丝易碎，不建议隔夜。",
