  "equipment": [
    "炒锅",
    "大汤锅",
    "厨房纸",
    "刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸭 1200g 冲洗干净去掉内脏残血，用厨房纸把鸭身内外彻底擦干。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表皮必须干，椒盐才抹得住。",
      "visual_cue": "鸭皮干爽、无血水渗出"
    },
    {
      "n": 2,
      "text": "盐 22g 与 8g 花椒下锅，小火炒 3 分钟至花椒出香、盐粒微黄。",
      "time_min": 3,
      "heat": "小火",
      "tip": "炒到盐微微发黄，香气才出得来。",
      "visual_cue": "盐粒泛黄、花椒香气冲鼻"
    },
    {
      "n": 3,
      "text": "趁热把花椒盐抹遍鸭身内外并轻揉，装袋冷藏腌 4 小时。",
      "time_min": 240,
      "heat": "无火",
      "tip": "鸭腿和胸肉厚处要多揉几下。",
      "visual_cue": "鸭身均匀挂盐、表皮发紧"
    },
    {
      "n": 4,
      "text": "取出鸭子用冷水冲掉表面椒盐，鸭腹塞入姜 20g 与葱 40g。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐冲不干净，成品会过咸发苦。",
      "visual_cue": "鸭皮洁净、腹腔填满葱姜"
    },
    {
      "n": 5,
      "text": "大锅加清水、4g 八角与 30ml 料酒烧至微沸，放入鸭子小火浸煮 45 分钟。",
      "time_min": 48,
      "heat": "小火",
      "tip": "水面只冒小泡，滚沸会把鸭皮煮破。",
      "visual_cue": "鸭皮完整、汤面微微颤动"
    },
    {
      "n": 6,
      "text": "捞出鸭子彻底晾凉至室温，再斩成均匀的块状装盘。",
      "time_min": 3,
      "heat": "无火",
      "tip": "彻底晾凉再斩，肉汁才不会流失。",
      "visual_cue": "鸭肉白嫩、骨缝带微红"
    }
  ],
  "tips": [
    "腌足四小时，鸭肉才有由内而外的咸香。",
    "浸煮时水不能滚沸，否则鸭皮开裂。",
    "鸭子一定要彻底晾凉再斩件，否则肉汁全流走。"
  ],
  "common_mistakes": [
    "椒盐没炒香就抹，只有死咸没有香气。",
    "全程大火滚煮，鸭皮破相不说肉质还发柴。",
    "腌完不冲洗表面椒盐，咸得只能配粥咽下去。"
  ],
  "substitutions": [
    {
      "original": "鸭",
      "substitute": "鸭腿",
      "ratio": "1200g 对 900g",
      "note": "更易熟，浸煮时间减到 30 分钟。"
    },
    {
      "original": "花椒",
      "substitute": "花椒粉",
      "ratio": "8g 对 5g",
      "note": "直接混盐，注意别炒糊。"
    }
  ],
  "variations": [
    "加 2g 香叶同煮，香气更复合。",
    "蘸 10ml 香醋加蒜末，酸香解咸。"
  ],
  "serving_suggestion": "斩件冷食，配一碟香醋姜丝，佐黄酒最佳。",
  "storage": "冷藏可存 3 天，食用前回温 20 分钟，风味更佳。",
