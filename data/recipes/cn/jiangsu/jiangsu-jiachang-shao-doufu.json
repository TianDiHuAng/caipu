  "equipment": [
    "炒锅",
    "锅铲",
    "平盘",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐切成两厘米厚的方块，用厨房纸吸干表面水分。",
      "time_min": 6,
      "heat": "无火",
      "tip": "表面干爽才煎得金黄，带水下锅只会溅油粘锅。",
      "visual_cue": "豆腐块表面不见水光，纸已湿透"
    },
    {
      "n": 2,
      "text": "平底锅放一半花生油烧热，把豆腐块平铺进去。",
      "time_min": 2,
      "heat": "中火",
      "tip": "一块块分开摆，粘在一起翻面时就碎了。",
      "visual_cue": "豆腐块底面与锅面贴实，油微微冒烟"
    },
    {
      "n": 3,
      "text": "中火煎四分钟到一面金黄定型，再翻面煎另一面。",
      "time_min": 6,
      "heat": "中火",
      "tip": "没定型别急着翻，等它自己脱锅才完整。",
      "visual_cue": "两面金黄结壳，边缘微微鼓起"
    },
    {
      "n": 4,
      "text": "煎好的豆腐块盛出，锅里留底油下香菇片炒香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菇炒到边缘微微焦黄，那股菌香味才出得来。",
      "visual_cue": "香菇片变软出香，锅底油亮"
    },
    {
      "n": 5,
      "text": "加生抽、老抽与白糖翻匀，倒入半碗清水烧开。",
      "time_min": 3,
      "heat": "大火",
      "tip": "生抽负责调味、老抽只管上色，两者比例别弄反。",
      "visual_cue": "汤汁呈深琥珀色，滚起小泡"
    },
    {
      "n": 6,
      "text": "把煎好的豆腐块放回锅里，转中小火烧六分钟吸味。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "用勺背轻推，别用铲子翻，豆腐才不破。",
      "visual_cue": "汤汁收到一半，豆腐膨胀发亮"
    },
    {
      "n": 7,
      "text": "玉米淀粉加水调匀淋入，轻推至汤汁浓稠挂勺。",
      "time_min": 2,
      "heat": "中火",
      "tip": "芡汁浓一点才裹得住豆腐，太稀就滑走了。",
      "visual_cue": "汤汁浓稠挂勺，表面泛亮"
    },
    {
      "n": 8,
      "text": "下蒜苗段翻两下，加盐调味，撒葱花起锅装盘。",
      "time_min": 2,
      "heat": "大火",
      "tip": "蒜苗只要断生就好，炒久了会发黄出水。",
      "visual_cue": "蒜苗翠绿挺立，豆腐块完整不碎"
    }
  ],
  "tips": [
    "豆腐选北豆腐，煎的时候不容易散。",
    "煎之前撒一层薄盐，豆腐更入味也不粘。",
    "喜欢浓一点可以收汁收到锅底只剩油。",
    "加几片薄切五花肉一起同烧，荤香会更足一些。"
  ],
  "common_mistakes": [
    "豆腐带水下锅，油花四溅还粘得一塌糊涂。",
    "全程大火猛烧，豆腐外面老里面还是凉的。",
    "用铲子来回翻，最后变成一锅豆腐碎。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "油豆腐",
      "ratio": "400克:250克",
      "note": "吸汁力强，烧的时间减两分钟。"
    },
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "50克:30克",
      "note": "泡发后撕小朵，口感更脆。"
    }
  ],
  "variations": [
    "加一勺豆瓣酱同烧，变成带辣的家常味。",
    "放几个手打肉丸一起同烧，就成了豆腐烧肉丸。"
  ],
  "serving_suggestion": "连汁装盘，配米饭把酱汁浇上去，一块豆腐能下半碗饭。",
  "storage": "冷藏两天，复热加两勺水小火焖三分钟，避免豆腐变硬。",
