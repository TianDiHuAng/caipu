  "steps": [
    {
      "n": 1,
      "text": "五花肉整块冷水下锅，加生姜片与料酒汆十分钟，捞出用温水冲净浮沫。",
      "time_min": 12,
      "heat": "中火",
      "tip": "汆水后用温水冲，肉不会骤缩发紧。",
      "visual_cue": "肉皮变白发紧、表面无浮沫"
    },
    {
      "n": 2,
      "text": "五花肉修成三厘米见方的块，肉皮上剞十字花刀，深至肉皮一半。",
      "time_min": 8,
      "heat": "无火",
      "tip": "花刀划浅不成樱桃纹，划深会散。",
      "visual_cue": "皮面呈整齐网格、肉块方正"
    },
    {
      "n": 3,
      "text": "砂锅底垫小葱结与生姜片，肉块皮朝下摆好，加清水没过肉面。",
      "time_min": 5,
      "heat": "中火",
      "tip": "葱姜垫底，肉皮才不会粘锅。",
      "visual_cue": "肉块排列整齐、水面高过肉面"
    },
    {
      "n": 4,
      "text": "加冰糖、生抽、老抽与盐，大火烧开转小火焖九十分钟。",
      "time_min": 92,
      "heat": "小火",
      "tip": "全程小火慢焖，肉皮才透亮起胶。",
      "visual_cue": "汤汁浓稠、肉皮呈琥珀色"
    },
    {
      "n": 5,
      "text": "加香醋再焖两分钟，转大火收汁，把汤汁反复浇在肉皮上至油亮。",
      "time_min": 5,
      "heat": "大火",
      "tip": "醋最后放，酸香才留得住。",
      "visual_cue": "汤汁挂壁、肉皮红亮如果冻"
    }
  ],
  "tips": [
    "五花肉选五层分明的，焖完才不散。",
    "糖色炒到枣红就下肉，炒久了会苦。",
    "收汁时把锅倾斜，用勺把汁浇在肉皮上。"
  ],
  "common_mistakes": [
    "大火焖煮，肉皮破开、瘦肉发柴。",
    "老抽放得太多，成品发黑不见樱桃红。",
    "收汁收得过干，糖分结底带焦苦味。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪蹄膀",
      "ratio": "600g 对 700g",
      "note": "胶质更厚，焖制时间加二十分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "40g 对 35g",
      "note": "色泽略浅，需多炒一分钟糖色。"
    }
  ],
  "variations": [
    "用红曲米水代替部分老抽上色，是苏州馆子的老做法。",
    "肉块切成小方丁焖制，成菜更快也更入味。"
  ],
  "serving_suggestion": "配米饭吃，浇一勺浓汁在饭上最香。",
  "storage": "冷藏可放三天，复热时加少量清水小火慢煨。",
