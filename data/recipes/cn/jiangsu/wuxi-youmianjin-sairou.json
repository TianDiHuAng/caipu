  "equipment": [
    "炒锅",
    "和馅盆",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪肉末加盐、生抽、料酒、白胡椒、姜末与玉米淀粉，顺同一方向搅打到发黏上劲。",
      "time_min": 8,
      "heat": "无火",
      "tip": "顺一个方向搅，肉馅才抱团不散。",
      "visual_cue": "肉馅黏手、能整团提起"
    },
    {
      "n": 2,
      "text": "油面筋用筷子在表面戳一个小洞，手指伸进去把内部组织轻轻压出空腔。",
      "time_min": 5,
      "heat": "无火",
      "tip": "洞别戳大，否则塞馅时裂开。",
      "visual_cue": "面筋外壳完整、内部有空腔"
    },
    {
      "n": 3,
      "text": "用小勺把肉馅一点点塞进面筋里，塞到八分满，洞口用肉馅抹平封住。",
      "time_min": 10,
      "heat": "无火",
      "tip": "只塞八分满，焖煮时面筋会涨。",
      "visual_cue": "面筋圆鼓、洞口肉馅平整"
    },
    {
      "n": 4,
      "text": "炒锅下植物油烧热，放葱段小火煸出香味，加清水、生抽、老抽与冰糖煮开。",
      "time_min": 5,
      "heat": "中火",
      "tip": "汤先调好味，面筋才入味均匀。",
      "visual_cue": "汤色红亮、葱段微焦香"
    },
    {
      "n": 5,
      "text": "面筋洞口朝下码入锅中，中小火盖盖焖二十分钟，中途轻翻一次面。",
      "time_min": 20,
      "heat": "中小火",
      "tip": "洞口朝下先定型，肉馅才不会掉出来。",
      "visual_cue": "面筋吸饱汤汁、体积胀大"
    },
    {
      "n": 6,
      "text": "开盖转大火收汁，汤汁浓稠裹住面筋后撒葱花出锅。",
      "time_min": 5,
      "heat": "大火",
      "tip": "收汁时晃锅别用铲，防破皮。",
      "visual_cue": "汤汁挂壁、面筋油亮"
    }
  ],
  "tips": [
    "油面筋挑外壳干爽的，摸着发软的已经回潮。",
    "肉馅塞好后可先蒸十分钟再焖，形状更完整。",
    "喜欢甜口可把冰糖加到十五克，收汁更亮。"
  ],
  "common_mistakes": [
    "肉馅塞得太满，焖煮时面筋胀裂露馅。",
    "全程大火猛煮，面筋外皮煮烂成一锅糊。",
    "肉馅不搅打上劲，咬开是散渣状。"
  ],
  "substitutions": [
    {
      "original": "油面筋",
      "substitute": "油豆腐",
      "ratio": "200g 对 200g",
      "note": "油豆腐孔大，肉馅要调得稠一些。"
    },
    {
      "original": "猪肉末",
      "substitute": "虾仁",
      "ratio": "300g 对 300g",
      "note": "虾仁剁粗粒，鲜味更清爽。"
    }
  ],
  "variations": [
    "换成番茄底汤同焖，酸甜口味更适合夏天。",
    "加几片冬笋同烧，口感层次更丰富。"
  ],
  "serving_suggestion": "连汁装盘，一人两三个，配白饭吃最下饭。",
  "storage": "冷藏两天，复热加少许清水小火煨透。",
