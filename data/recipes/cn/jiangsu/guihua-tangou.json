  ],
  "difficulty": 2,
  "time": {
    "prep_min": 30,
    "cook_min": 90,
    "total_min": 120
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "fragrant"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "莲藕",
          "name_en": "lotus root",
          "amount": 700,
          "unit": "g",
          "note": "选粗短七孔藕",
          "optional": false
        },
        {
          "name": "糯米",
          "name_en": "glutinous rice",
          "amount": 150,
          "unit": "g",
          "note": "提前泡 4 小时",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "桂花",
          "name_en": "osmanthus flower",
          "amount": 5,
          "unit": "g",
          "note": "干桂花或糖桂花",
          "optional": false
        },
        {
          "name": "红枣",
          "name_en": "red date",
          "amount": 40,
          "unit": "g",
          "note": "增加甜香",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "冰糖",
          "name_en": "rock sugar",
          "amount": 100,
          "unit": "g",
          "note": "分两次下",
          "optional": false
        },
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 40,
          "unit": "g",
          "note": "上色",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 2,
          "unit": "g",
          "note": "提甜",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "高压锅",
    "细竹签",
    "棉线",
    "深锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "糯米淘洗后加清水泡 4 小时，沥干水备用，米粒要能一捏就碎。",
      "time_min": 150,
      "heat": "无火",
      "tip": "泡透的糯米灌进去才不会夹生。",
      "visual_cue": "米粒吸饱水、指压即碎"
    },
    {
      "n": 2,
      "text": "莲藕去皮，从一端 3cm 处切下藕盖，用筷子把糯米一点点捅进藕孔，边捅边振动。",
      "time_min": 9,
      "heat": "无火",
      "tip": "每孔不要塞太满，糯米煮熟会膨胀。",
      "visual_cue": "藕孔填至九成、米面平整"
    },
    {
      "n": 3,
      "text": "盖回藕盖用竹签固定，再缠棉线扎紧，防止煮时米粒漏出。",
      "time_min": 4,
      "heat": "无火",
      "tip": "不扎紧米会散到汤里。",
      "visual_cue": "藕身箍紧、轻摇不散"
    },
    {
      "n": 4,
      "text": "高压锅加 1500ml 清水，放莲藕、红枣、60g 冰糖与红糖，上汽后压 40 分钟。",
      "time_min": 29,
      "heat": "中火",
      "tip": "用红糖打底，藕色才会红亮。",
      "visual_cue": "藕段沉底、汤色转深红"
    },
    {
      "n": 5,
      "text": "排气开盖，加剩余 40g 冰糖与 5g 盐，小火收汁 25 分钟至汤汁挂藕。",
      "time_min": 17,
      "heat": "小火",
      "tip": "二次加糖让甜味有层次，盐能提甜。",
      "visual_cue": "汤汁浓稠拉丝、藕身油亮"
    },
    {
      "n": 6,
      "text": "取出放凉后拆线切片，摆盘淋上收好的糖汁并撒干桂花。",
      "time_min": 7,
      "heat": "无火",
      "tip": "彻底放凉再切，切面才整齐不散。",
      "visual_cue": "切片糯米饱满、糖汁透亮"
    }
  ],
  "tips": [
    "选七孔藕，粉质足、易煮糯。，会影响最终的口感层次与卖相。",
    "糯米只填九成满，留出膨胀空间。",
    "放凉后切片，切面才平整不塌。，会影响最终的口感层次与卖相。"
  ],
  "common_mistakes": [
    "糯米不泡直接灌，煮两小时中间仍是生硬米粒。",
    "藕孔塞得死紧，糯米膨胀把藕身胀裂。",
    "热的时候急切片，糯米散开、切片不成型。"
  ],
  "substitutions": [
    {
      "original": "冰糖",
      "substitute": "麦芽糖",
      "ratio": "100g 对 80g",
      "note": "糖汁更粘稠，适合凉吃。"
    },
    {
      "original": "干桂花",
      "substitute": "糖桂花",
      "ratio": "5g 对 20g",
      "note": "本身带甜，冰糖减 20g。"
    }
  ],
  "variations": [
    "酒酿版：收汁时加 100g 酒酿，带轻微酒香。",
    "咸甜版：糖量减半，加 3g 盐做成咸甜口。"
  ],
  "serving_suggestion": "冷藏后切片当凉菜或甜品，配一杯热茶最合适。",
  "storage": "连汁冷藏 4 天，冷冻可存 1 个月；复热蒸 10 分钟。",
