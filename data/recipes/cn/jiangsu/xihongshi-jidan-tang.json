        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "番茄顶部划十字，用沸水烫三十秒后撕去外皮，切成小块。",
      "time_min": 6,
      "heat": "无火",
      "tip": "去皮后汤才顺口，不会有卷边。",
      "visual_cue": "番茄皮整片脱落、果肉软"
    },
    {
      "n": 2,
      "text": "鸡蛋磕入碗中打散，小葱切葱花，生姜切成细丝备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液打匀，蛋花才薄而不结。",
      "visual_cue": "蛋液均匀、无粘连蛋清"
    },
    {
      "n": 3,
      "text": "汤锅下植物油烧热，放生姜丝与番茄块中火炒出红色汤汁。",
      "time_min": 4,
      "heat": "中火",
      "tip": "番茄炒出沙，汤色才红亮。",
      "visual_cue": "番茄化成糊状、锅底见红汁"
    },
    {
      "n": 4,
      "text": "倒入清水大火烧开，加盐与白糖调味，煮三分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "白糖少量就够，只为压酸味。",
      "visual_cue": "汤色橙红、番茄块浮起"
    },
    {
      "n": 5,
      "text": "玉米淀粉兑水淋入汤中勾薄芡，边淋边搅防止结块。",
      "time_min": 2,
      "heat": "中火",
      "tip": "芡要稀，汤才清爽不糊口。",
      "visual_cue": "汤体微稠、勺背挂薄浆"
    },
    {
      "n": 6,
      "text": "转小火把蛋液细线状淋入，静置五秒后轻推开成蛋花。",
      "time_min": 2,
      "heat": "小火",
      "tip": "淋完别急着搅，蛋花才成片。",
      "visual_cue": "蛋花浮起、呈薄片云絮状"
    },
    {
      "n": 7,
      "text": "关火后撒上白胡椒与葱花，盛入汤碗里即可上桌。",
      "time_min": 1,
      "heat": "无火",
      "tip": "胡椒最后撒，香气才不散。",
      "visual_cue": "葱花翠绿、汤面泛油花"
    }
  ],
  "tips": [
    "番茄选沙瓤的，炒出来的汤色更浓更红。",
    "番茄先用油炒过再加水，味道比直接煮香。",
    "喜欢浓汤可把一半番茄先打成泥。"
  ],
  "common_mistakes": [
    "番茄不去皮，汤里卷着硬皮影响口感。",
    "蛋液在滚汤里猛搅，蛋花碎成蛋渣。",
    "清水加得太多，汤色寡淡喝着像刷锅水。"
  ],
  "substitutions": [
    {
      "original": "番茄",
      "substitute": "罐装番茄",
      "ratio": "300g 对 250g",
      "note": "酸味更集中，白糖可略增。"
    },
    {
      "original": "鸡蛋",
      "substitute": "嫩豆腐",
      "ratio": "100g 对 200g",
      "note": "素版更清爽，需切小块后下。"
    }
  ],
  "variations": [
    "加几片菠菜或青菜，颜色更鲜活。",
    "把清水换成鸡汤，整锅汤的鲜味会更厚。"
  ],
  "serving_suggestion": "饭前喝一碗开胃，配面食也合适。",
  "storage": "当天喝完最好，隔夜的蛋花会变老变硬。",
