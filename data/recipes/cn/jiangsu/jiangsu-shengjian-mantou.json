  "equipment": [
    "平底锅",
    "擀面杖",
    "面盆",
    "锅盖"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母用温水化开静置五分钟，倒进面粉里揉成面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水别太烫，手摸温热就行，烫了酵母就死了。",
      "visual_cue": "面团成型，盆壁干净不粘面"
    },
    {
      "n": 2,
      "text": "盖上湿布放在温暖处发酵四十分钟，涨到两倍大。",
      "time_min": 40,
      "heat": "无火",
      "tip": "发到手指一戳洞不回缩的程度，面才算真正发好。",
      "visual_cue": "面团膨起两倍，表面有细密气孔"
    },
    {
      "n": 3,
      "text": "五花肉剁成馅，加姜末、生抽、料酒、盐与白糖搅上劲。",
      "time_min": 10,
      "heat": "无火",
      "tip": "顺着一个方向搅，绞碎的肉才黏得住不出水。",
      "visual_cue": "绞碎的肉发黏成团，能立住不塌"
    },
    {
      "n": 4,
      "text": "拌入香油与一半葱花，搅匀后冷藏十五分钟定型。",
      "time_min": 15,
      "heat": "无火",
      "tip": "冷藏过的绞碎的肉更好包，煎的时候也不容易漏汁。",
      "visual_cue": "绞碎的肉油亮紧实，葱香扑鼻"
    },
    {
      "n": 5,
      "text": "面团排气后搓成长条，切成二十克左右的小剂子。",
      "time_min": 6,
      "heat": "无火",
      "tip": "剂子大小要一致，同一锅煎的时候才能同时熟。",
      "visual_cue": "剂子大小均匀，切面平整"
    },
    {
      "n": 6,
      "text": "把剂子擀成中间厚边缘薄的圆皮，包入一勺绞碎的肉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "中间厚才托得住馅，边缘薄褶子才好看。",
      "visual_cue": "面皮中间厚边缘薄，馅料居中"
    },
    {
      "n": 7,
      "text": "捏出十六道褶子收口朝下，逐个摆在撒了粉的盘里。",
      "time_min": 8,
      "heat": "无火",
      "tip": "收口一定要捏紧，煎的时候汤汁才不会往外漏。",
      "visual_cue": "馒头圆鼓，褶纹清晰收口紧"
    },
    {
      "n": 8,
      "text": "平底锅放花生油，馒头收口朝下摆入，中火煎三分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "底部煎到金黄结硬壳，才有那层咬起来响的脆底。",
      "visual_cue": "底面金黄结硬壳，香味四溢"
    },
    {
      "n": 9,
      "text": "沿锅边淋入半碗清水，盖盖中火焖八分钟收干。",
      "time_min": 8,
      "heat": "中火",
      "tip": "加水焖这一步是让内里熟透的关键，千万不能省。",
      "visual_cue": "锅内水声由响转小，盖子边缘无水汽"
    },
    {
      "n": 10,
      "text": "开盖撒上芝麻与剩下的葱花，再煎一分钟即可出锅。",
      "time_min": 1,
      "heat": "小火",
      "tip": "最后再煎一分钟，把刚才焖软的底部脆感找回来。",
      "visual_cue": "底部焦脆，芝麻葱花均匀铺面"
    }
  ],
  "tips": [
    "肉馅选三分肥七分瘦，汁水才足。",
    "包好可以冷冻，吃前直接下锅不用解冻。",
    "煎的时候火别大，底糊了里面还没熟。",
    "出锅要趁热吃，凉了之后脆底回软就不脆了。"
  ],
  "common_mistakes": [
    "收口没捏紧，一加水焖汤汁就全漏进锅里了。",
    "全程大火猛煎，底部焦黑了里面还是生面团。",
    "面没发起来就上锅，煎出来像块死面饼。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "鸡腿肉",
      "ratio": "300克:300克",
      "note": "口感更清爽，需多加一勺油。"
    },
    {
      "original": "面粉",
      "substitute": "高筋面粉",
      "ratio": "300克:300克",
      "note": "皮更有嚼劲，发酵时间加十分钟。"
    }
  ],
  "variations": [
    "馅里拌进一勺皮冻，煎出来的馒头就带汤汁。",
    "做成虾仁生煎，一只馒头里包一整个大虾仁。"
  ],
  "serving_suggestion": "出锅立刻上桌，配一碟米醋，先咬小口吸汁再蘸醋吃。",
  "storage": "冷藏一天，复热用平底锅小火加两勺水焖三分钟恢复脆底。",
