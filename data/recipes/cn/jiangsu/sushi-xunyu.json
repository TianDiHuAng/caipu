  "steps": [
    {
      "n": 1,
      "text": "草鱼刮鳞去内脏洗净，取中段横切成两厘米厚的片，沥干水分。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鱼片厚度要一致，炸时才一齐上色。",
      "visual_cue": "鱼片厚薄均匀、表面不见血水"
    },
    {
      "n": 2,
      "text": "鱼片加料酒、盐与生姜片抓匀，腌十五分钟去腥。",
      "time_min": 16,
      "heat": "无火",
      "tip": "腌够时间，鱼腥味才压得住。",
      "visual_cue": "鱼片表面微紧、闻不到土腥味"
    },
    {
      "n": 3,
      "text": "另起锅加清水、生抽、老抽、白糖、香醋、八角与小葱结烧开，小火熬成浓卤。",
      "time_min": 8,
      "heat": "小火",
      "tip": "卤汁要熬到微稠，才能挂住鱼块。",
      "visual_cue": "卤汁冒细泡、颜色深红透亮"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到六成热，鱼片下锅炸三分钟至外壳金黄。",
      "time_min": 5,
      "heat": "中火",
      "tip": "鱼片分散下锅，粘连就成块了。",
      "visual_cue": "鱼片浮起、外壳呈浅金色"
    },
    {
      "n": 5,
      "text": "植物油升温到八成热，鱼片下锅复炸四十秒，捞出沥油。",
      "time_min": 2,
      "heat": "大火",
      "tip": "复炸一次骨头才酥，凉了也脆。",
      "visual_cue": "外壳深金、鱼骨敲上去发脆"
    },
    {
      "n": 6,
      "text": "趁热把鱼片浸入卤汁十秒，捞出装盘，浇一勺卤汁即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "热鱼浸冷卤，响一声才算入味。",
      "visual_cue": "鱼片吸汁发亮、外脆里嫩"
    }
  ],
  "tips": [
    "草鱼要选新鲜的，鱼眼清亮的最好。",
    "鱼片厚薄一致，炸制时间才统一。",
    "卤汁可以提前熬好放凉，热的鱼块吸汁更均匀。"
  ],
  "common_mistakes": [
    "鱼片没沥干就下锅，油花四溅还炸不透。",
    "只在卤汁里泡一泡，鱼块外咸里淡。",
    "油温不够就下鱼，鱼片吸油发腻不清脆。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲈鱼",
      "ratio": "600g 对 600g",
      "note": "肉更细嫩，炸制时间减一分钟。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "40g 对 45g",
      "note": "卤汁光泽更好，需多熬两分钟。"
    }
  ],
  "variations": [
    "加一点五香粉进卤汁，香气更接近老苏州做法。",
    "把鱼换成小黄鱼同法熏制，成菜更小巧。"
  ],
  "serving_suggestion": "放凉后当冷菜吃，甜咸相济最下饭。",
  "storage": "冷藏可放三天，密封保存不易回软。",
