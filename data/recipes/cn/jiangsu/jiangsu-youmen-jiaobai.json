  "steps": [
    {
      "n": 1,
      "text": "茭白剥掉外层青壳，削去根部老硬的部分和外侧筋皮。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部一掐就断以上的位置都能吃，筋皮不削会塞牙。",
      "visual_cue": "茭白呈乳白色，表面光滑无硬皮"
    },
    {
      "n": 2,
      "text": "把茭白切成三厘米左右的滚刀块，块形尽量大小一致。",
      "time_min": 4,
      "heat": "无火",
      "tip": "滚刀块受热均匀，棱角处也更容易挂汁。",
      "visual_cue": "块形棱角分明，大小接近"
    },
    {
      "n": 3,
      "text": "切好的茭白立刻泡进清水，防止表面氧化发黄。",
      "time_min": 5,
      "heat": "无火",
      "tip": "茭白含多酚类物质，见空气很快变色，泡水能保持洁白。",
      "visual_cue": "茭白浸在水中，颜色白净"
    },
    {
      "n": 4,
      "text": "炒锅大火烧热放花生油，下姜丝与一半葱段炒出香味。",
      "time_min": 2,
      "heat": "大火",
      "tip": "姜葱只为打底，炒出香味就够，别炒到焦。",
      "visual_cue": "葱段边缘起泡，油里香气明显"
    },
    {
      "n": 5,
      "text": "倒入沥干的茭白块，中火翻炒三分钟炒到边缘微透明。",
      "time_min": 3,
      "heat": "中火",
      "tip": "先把表面水分炒掉，后面焖的时候才不粘锅不出水。",
      "visual_cue": "茭白边缘发亮微透，锅里没有积水"
    },
    {
      "n": 6,
      "text": "加料酒、生抽与白糖翻匀，倒入小半碗清水烧开。",
      "time_min": 3,
      "heat": "中火",
      "tip": "水量只需没过三分之一，收汁才容易收得住。",
      "visual_cue": "锅底有浅酱色汤汁在冒泡"
    },
    {
      "n": 7,
      "text": "盖盖中小火焖七分钟，中途翻动一次让入味均匀。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "焖到筷子能插透就够，久焖会失去脆嫩。",
      "visual_cue": "汤汁减少一半，茭白色转浅褐"
    },
    {
      "n": 8,
      "text": "开盖转大火收汁，边收边晃锅，让糖汁均匀裹满茭白。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁的时候别走开，糖一炒焦整锅都会发苦。",
      "visual_cue": "汤汁黏稠挂勺，表面油亮如釉"
    },
    {
      "n": 9,
      "text": "加盐调味，撒剩下的葱段，淋香油后起锅装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐一定最后放，放早了会让茭白出水，口感变软。",
      "visual_cue": "茭白油亮，葱段翠绿点缀"
    }
  ],
  "tips": [
    "茭白挑外皮紧实、切开不见黑点的，有黑心的已经老了。",
    "想味道更鲜可以加一小块火腿一起焖。",
    "收汁时留一点浓汤汁，拌饭吃最香。",
    "冷藏以后当冷菜吃，咸甜的风味会更集中。"
  ],
  "common_mistakes": [
    "根部老硬部分没削，吃起来满口纤维渣。",
    "水加太多焖太久，茭白从脆嫩变成软塌。",
    "收汁火太大不晃锅，糖结在锅底变成一层焦斑。"
  ],
  "substitutions": [
    {
      "original": "茭白",
      "substitute": "竹笋",
      "ratio": "450克:450克",
      "note": "先焯水去涩，焖的时间加两分钟。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "15克:16克",
      "note": "甜味更清透，收汁更亮。"
    }
  ],
  "variations": [
    "加几片咸肉同焖，咸香与清甜形成对比。",
    "也可以做成凉菜版本，收好汁后冷藏再上桌。"
  ],
  "serving_suggestion": "装白盘趁热吃，茭白脆嫩带汁，作为主菜的配菜或素菜主角都合适。",
  "storage": "冷藏两天，复热用小火加一勺水翻热，保持脆嫩。",
