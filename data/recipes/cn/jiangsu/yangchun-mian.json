  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面条",
          "name_en": "wheat noodles",
          "amount": 250,
          "unit": "g",
          "note": "细碱水面或龙须面",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 25,
          "unit": "g",
          "note": "葱白切段、葱绿切末",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "猪油",
          "name_en": "lard",
          "amount": 20,
          "unit": "g",
          "note": "汤底灵魂，不可省",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 15,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "分两次",
          "optional": false
        },
        {
          "name": "高汤",
          "name_en": "stock",
          "amount": 500,
          "unit": "ml",
          "note": "鸡骨汤或清汤",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 20,
          "unit": "ml",
          "note": "熬葱油",
          "optional": false
        },
        {
          "name": "白胡椒",
          "name_en": "white pepper",
          "amount": 1,
          "unit": "g",
          "note": "提香",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "小锅",
    "面碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小锅下 20ml 植物油与葱白段，小火慢熬 6 分钟至葱白焦黄，滤出葱油。",
      "time_min": 7,
      "heat": "小火",
      "tip": "葱白熬到深黄才香，发黑就苦了。",
      "visual_cue": "葱白卷曲焦黄、油色微绿"
    },
    {
      "n": 2,
      "text": "碗中放猪油、生抽、盐、白胡椒与 10ml 葱油，冲入 250ml 滚烫高汤化开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "必须用滚汤冲，猪油才能完全化开挂香。",
      "visual_cue": "汤面浮一层油花、香气散出"
    },
    {
      "n": 3,
      "text": "锅中烧 2L 水，加 3g 盐，水大开后下面条，用筷子轻轻拨散。",
      "time_min": 1,
      "heat": "大火",
      "tip": "水量要足，面汤才不会浑。",
      "visual_cue": "面条散开不粘连、水面翻滚"
    },
    {
      "n": 4,
      "text": "煮 2 分半至面条刚断生，捞出沥去面汤，放入调好的汤碗中。",
      "time_min": 3,
      "heat": "大火",
      "tip": "面捞出时可过一下凉水，口感更弹。",
      "visual_cue": "面条中心无白芯、挑起有弹性"
    },
    {
      "n": 5,
      "text": "撒上葱绿末，再淋 5ml 葱油，趁热上桌食用。",
      "time_min": 1,
      "heat": "无火",
      "tip": "葱绿最后撒，颜色才翠。",
      "visual_cue": "葱末翠绿浮在汤面"
    }
  ],
  "tips": [
    "猪油是阳春面的关键，可用 10g 猪油加 10g 葱油折中。",
    "面与汤分开煮，汤底才清亮不浑。",
    "面量按每人 120g 干面计算，汤宽面少才正宗。"
  ],
  "common_mistakes": [
    "面条在汤底里同煮，汤变浑浊发黏。",
    "葱油熬到发黑，整碗面带明显苦味。",
    "省略猪油，只剩酱油味，失去苏式面香气。"
  ],
  "substitutions": [
    {
      "original": "面条",
      "substitute": "挂面",
      "ratio": "1:1",
      "note": "挂面更易熟，煮制时间减到 2 分钟。"
    },
    {
      "original": "猪油",
      "substitute": "鸡油",
      "ratio": "1:1",
      "note": "香气更清，适合不吃猪油者。"
    }
  ],
  "variations": [
    "家庭简化版：葱油提前熬好冷藏，每次取 10ml 使用。",
    "浇头版：加一份焖肉或爆鱼，即成苏式汤面。"
  ],
  "serving_suggestion": "作为早餐或宵夜，配一碟酱菜或荷包蛋。",
  "storage": "面条现煮现吃；葱油冷藏可存 2 周。",
