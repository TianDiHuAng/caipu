  "steps": [
    {
      "n": 1,
      "text": "小白菜掰开洗净，烧一锅水加少许盐，下锅烫三十秒立刻捞出过冷水。",
      "time_min": 10,
      "heat": "大火",
      "tip": "烫菜时间短，断生就捞，烫久了叶子发黄，香味也跟着跑掉。",
      "visual_cue": "菜叶翠绿挺立，梗变软"
    },
    {
      "n": 2,
      "text": "烫好的小白菜挤干水分后切碎，再用力挤一遍，拌入猪油、香油、白糖、盐和香菇末。",
      "time_min": 10,
      "heat": "无火",
      "tip": "水挤得越干馅越香，香菇末最后拌进去，鲜味才不会被猪油盖住。",
      "visual_cue": "菜馅干爽成团，不滴水"
    },
    {
      "n": 3,
      "text": "面粉与澄面混合，冲入沸水用筷子搅成雪花状，稍凉后揉成光滑面团醒十分钟。",
      "time_min": 15,
      "heat": "无火",
      "tip": "澄面必须用滚水烫透才透明，水温不够皮子蒸出来发白不亮。",
      "visual_cue": "面团洁白细腻，按下去有弹性"
    },
    {
      "n": 4,
      "text": "面团搓条下剂，擀成直径十厘米的圆皮，包入菜馅和虾仁碎，收口捏成花瓶形。",
      "time_min": 18,
      "heat": "无火",
      "tip": "收口留一截菜馅露在外面，蒸出来才是翡翠色的花蕊样子。",
      "visual_cue": "烧卖生坯挺立，顶部露出绿馅"
    },
    {
      "n": 5,
      "text": "蒸笼垫湿布摆入烧卖，水开后大火蒸八分钟，关火焖一分钟取出。",
      "time_min": 9,
      "heat": "大火",
      "tip": "蒸的时间别超十分钟，皮薄馅嫩，多蒸一分钟皮就发黏。",
      "visual_cue": "皮薄透亮，能看见里面绿馅"
    }
  ],
  "tips": [
    "翡翠烧卖的绿来自小白菜，选叶多梗少的嫩菜，颜色才够鲜亮。",
    "澄面烫熟后要趁热揉，凉了结块就揉不开，皮子上会有小疙瘩。",
    "虾仁切成小粒别剁成泥，颗粒感在嘴里一咬才弹，剁碎就没魂了。"
  ],
  "common_mistakes": [
    "小白菜烫完不挤水，馅里全是汤，包好的烧卖一蒸就塌成扁片。",
    "用冷水和面，皮子蒸出来灰白不透明，完全吃不出翡翠烧卖的样子。",
    "馅里加酱油调色，菜叶被染成暗褐色，翠绿全毁，只能重做一笼。"
  ],
  "substitutions": [
    {
      "original": "小白菜",
      "substitute": "小油菜",
      "ratio": "400克:400克",
      "note": "小油菜梗多，烫制时间要延长二十秒。"
    },
    {
      "original": "虾仁",
      "substitute": "干贝丝",
      "ratio": "120克:60克",
      "note": "干贝需提前泡发撕丝，鲜味更集中。"
    }
  ],
  "variations": [
    "把菜馅换成荠菜，春天做出来带一股清香，是扬州的时令吃法。",
    "馅里拌入火腿末与香菇丁，鲜味更足，就是富春茶社的双色烧卖。"
  ],
  "serving_suggestion": "烧卖现蒸现吃，配一壶绿杨春茶，蘸一点镇江香醋更解腻。",
  "storage": "生坯可冷冻一周，蒸时不用解冻，多加三分钟；熟烧卖回蒸三分钟即可。",
