          "name_en": "scallion",
          "amount": 60,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        },
        {
          "name": "芝麻",
          "name_en": "sesame seeds",
          "amount": 30,
          "unit": "g",
          "note": "撒面",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 70,
          "unit": "ml",
          "note": "做油酥",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 5,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "酵母",
          "name_en": "yeast",
          "amount": 3,
          "unit": "g",
          "note": "温水化开",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "和面盆",
    "擀面杖",
    "平底锅",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "酵母 3g 用 160ml 温水化开，加 200g 面粉与 3g 盐揉成面团，醒 30 分钟。",
      "time_min": 40,
      "heat": "无火",
      "tip": "面团偏软一点，擀开时才不回缩。",
      "visual_cue": "面团柔软、表面光滑"
    },
    {
      "n": 2,
      "text": "剩下 100g 面粉加 2g 盐拌匀，倒入 50ml 烧热的植物油搅成油酥放凉。",
      "time_min": 8,
      "heat": "中火",
      "tip": "油要烧热再泼，油酥才够香。",
      "visual_cue": "油酥呈细沙状、能捏成团"
    },
    {
      "n": 3,
      "text": "面团擀成长方形薄片，均匀抹上油酥，撒满 60g 葱花。",
      "time_min": 5,
      "heat": "无火",
      "tip": "葱花撒匀，卷起来每一层都有料。",
      "visual_cue": "面片薄、油酥与葱花铺满"
    },
    {
      "n": 4,
      "text": "从长边卷起成条，切成 4 段，两端收口捏紧后按扁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "收口要捏严，油酥才不会漏。",
      "visual_cue": "剂子整齐、不漏酥"
    },
    {
      "n": 5,
      "text": "每个剂子擀成 1 厘米厚的圆饼，表面刷水撒 30g 白芝麻。",
      "time_min": 3,
      "heat": "无火",
      "tip": "刷水再撒芝麻，烤好才粘得牢。",
      "visual_cue": "饼坯圆整、芝麻密布"
    },
    {
      "n": 6,
      "text": "平底锅倒 20ml 植物油，中小火两面各煎 4 分钟至金黄鼓起。",
      "time_min": 8,
      "heat": "小火",
      "tip": "小火慢煎，里面才熟透不起生。",
      "visual_cue": "饼身鼓起、两面金黄"
    },
    {
      "n": 7,
      "text": "转烤箱 180 度烤 8 分钟，让外壳彻底酥脆。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎后再烤，酥层才立得住。",
      "visual_cue": "外壳层层起酥、一掰掉渣"
    }
  ],
  "tips": [
    "油酥要用热油泼，冷油拌出来不香也不酥。",
    "卷得越紧层数越多，成品才层次分明。",
    "煎完再烤一遍，外酥内软的对比最明显。"
  ],
  "common_mistakes": [
    "油酥用冷油拌，烤出来是死面饼。",
    "葱花撒得太早，卷的时候全被挤出来。",
    "只煎不烤，外壳软塌一点也不酥。"
  ],
  "substitutions": [
    {
      "original": "植物油",
      "substitute": "猪油",
      "ratio": "70ml 对 60g",
      "note": "酥性更好，香气也更浓。"
    },
    {
      "original": "白芝麻",
      "substitute": "黑芝麻",
      "ratio": "30g 对 30g",
      "note": "香气略重，烤温降 10 度。"
    }
  ],
  "variations": [
    "油酥里加 2g 花椒粉，做成椒香口味。",
    "表面刷一层蛋液再撒芝麻，颜色更亮。"
  ],
  "serving_suggestion": "趁热掰开吃，配豆浆或豆花都很对味。",
  "storage": "密封常温存 3 天，回炉 160 度烤 5 分钟恢复酥脆。",
