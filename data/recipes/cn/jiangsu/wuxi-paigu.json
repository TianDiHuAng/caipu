  "equipment": [
    "炒锅",
    "砂锅",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "排骨剁成 5cm 长段，用冷水浸泡 20 分钟逼出血水，中途换一次水。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡到水色变淡，腥味才去得干净。",
      "visual_cue": "排骨发白、水色微粉"
    },
    {
      "n": 2,
      "text": "排骨冷水下锅，加姜片与料酒大火烧开，焯 8 分钟撇净浮沫后捞出冲净。",
      "time_min": 10,
      "heat": "大火",
      "tip": "冷水下锅才能把血沫带出来。",
      "visual_cue": "浮沫成灰褐色、排骨紧实"
    },
    {
      "n": 3,
      "text": "炒锅放冰糖与 50ml 清水，小火慢慢熬到糖液变成枣红色。",
      "time_min": 8,
      "heat": "小火",
      "tip": "糖色熬到起小泡就该下肉，过火会苦。",
      "visual_cue": "糖液枣红、表面细密小泡"
    },
    {
      "n": 4,
      "text": "下排骨中火翻炒，让每段都裹上糖色，再放葱段、姜片、八角、桂皮与香叶炒香。",
      "time_min": 5,
      "heat": "中火",
      "tip": "翻炒要快，糖色久炒会发黑。",
      "visual_cue": "排骨表面红亮、香料出香"
    },
    {
      "n": 5,
      "text": "加生抽、老抽、料酒、盐与 700ml 清水，大火烧开后撇去浮沫。",
      "time_min": 5,
      "heat": "大火",
      "tip": "水量以刚没过排骨为准，别一次太多。",
      "visual_cue": "汤汁沸腾、颜色深红"
    },
    {
      "n": 6,
      "text": "转小火加盖焖 60 分钟，中途翻动两次让咸甜味均匀渗入。",
      "time_min": 60,
      "heat": "小火",
      "tip": "小火慢焖，肉才酥而不脱骨。",
      "visual_cue": "筷子能轻松插入肉层"
    },
    {
      "n": 7,
      "text": "开盖转中火收汁 10 分钟，边收边把汤汁淋在排骨上至油亮挂汁。",
      "time_min": 10,
      "heat": "中火",
      "tip": "收汁勤淋，成品才有镜面光泽。",
      "visual_cue": "汤汁浓稠挂勺、排骨油亮"
    }
  ],
  "tips": [
    "冰糖炒出的糖色比老抽上色更透亮好看。",
    "焖制全程小火，排骨才酥而不散。",
    "收汁时勤淋汤汁，表面才有糖亮层。"
  ],
  "common_mistakes": [
    "糖色炒过火，成品带明显焦苦味。",
    "水加得太满，最后收汁时间不够、味道寡淡。",
    "大火焖煮，排骨脱骨散形、肉质发柴。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "猪小排",
      "ratio": "1000g 对 1000g",
      "note": "小排更嫩，焖制时间减 10 分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "60g 对 50g",
      "note": "白糖易焦，糖色时间缩短。"
    }
  ],
  "variations": [
    "酱香版：加 20g 黄豆酱同焖，咸鲜更浓。",
    "微辣版：加 3 个干辣椒同焖，甜中带辣。"
  ],
  "storage": "冷藏 2 天，复热加少量清水小火蒸 10 分钟。",
