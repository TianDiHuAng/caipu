        }
      ]
    }
  ],
  "equipment": [
    "梅花模具",
    "毛刷",
    "蒸锅",
    "竹签",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "面粉与糯米粉混合过筛，加白糖、酵母和泡打粉，慢慢倒入清水搅成稀糊。",
      "time_min": 12,
      "heat": "无火",
      "tip": "糊要搅到没有干粉颗粒，稠度能顺勺背慢慢流下，太稠蒸出来发死。",
      "visual_cue": "面糊顺滑无颗粒，能挂住勺子"
    },
    {
      "n": 2,
      "text": "面糊盖上保鲜膜放温暖处发酵四十分钟，表面出现密集小气泡即可。",
      "time_min": 40,
      "heat": "无火",
      "tip": "发到表面鼓起小泡就够，发过头会有酸味，得补一点碱面中和。",
      "visual_cue": "面糊涨起，表面布满气泡"
    },
    {
      "n": 3,
      "text": "梅花模具用刷子均匀刷一层猪油，每个孔都刷到，防粘最关键。",
      "time_min": 6,
      "heat": "无火",
      "tip": "模具缝隙多，猪油要刷进每个花瓣角落，漏刷一处脱模就破相。",
      "visual_cue": "模具内壁油亮，每个花瓣都刷到"
    },
    {
      "n": 4,
      "text": "面糊倒进模具至三分满，中间放一小团红豆沙，再倒面糊盖住豆沙。",
      "time_min": 8,
      "heat": "无火",
      "tip": "豆沙别贪多，放太多压不住，蒸的时候会沉底粘在模具上。",
      "visual_cue": "每个孔面糊平整，豆沙被完全覆盖"
    },
    {
      "n": 5,
      "text": "静置十分钟让面糊回发，上锅大火蒸二十五分钟，中途不要开盖。",
      "time_min": 30,
      "heat": "大火",
      "tip": "回发这一步不能省，直接蒸糕体不够蓬松，口感发硬。",
      "visual_cue": "糕体鼓起，顶面白胖有光"
    },
    {
      "n": 6,
      "text": "关火焖两分钟取出，趁热撒芝麻，稍凉用竹签沿边缘划一圈脱模。",
      "time_min": 4,
      "heat": "无火",
      "tip": "脱模要趁温热，凉透了糖分黏住模具，硬撬就把花瓣掰断。",
      "visual_cue": "梅花形状完整，边缘光滑"
    }
  ],
  "tips": [
    "梅花糕的灵魂在模具，铜模导热均匀，蒸出来的花瓣棱角最清楚。",
    "面糊里加糯米粉是为了软糯，比例超过三分之一就发黏，撑不住形状。",
    "豆沙自己炒最好，糖少油少，甜度可控，买的成品往往过甜。"
  ],
  "common_mistakes": [
    "模具没刷油就倒糊，蒸熟后整块粘在孔里，只能挖出来当碎糕吃。",
    "面糊发过头直接上锅，蒸出来带酸味，颜色也发暗，卖相全无。",
    "蒸的过程中掀盖看，冷气进去糕体塌陷，花瓣中间凹成一个个坑。"
  ],
  "substitutions": [
    {
      "original": "红豆沙",
      "substitute": "枣泥",
      "ratio": "200克:200克",
      "note": "枣泥更甜，白糖可减十克，风味偏北方。"
    },
    {
      "original": "猪油",
      "substitute": "植物油",
      "ratio": "30克:25克",
      "note": "植物油防粘效果略差，需刷两遍。"
    }
  ],
  "variations": [
    "豆沙里拌入糖桂花，蒸好带一股桂花香，是南京秋天的时令做法。",
    "表面撒松子仁或瓜子仁再蒸，口感更丰富，也多一层坚果香。"
  ],
  "serving_suggestion": "脱模后趁温热吃，外皮微韧内里软糯，配一碗桂花糖粥是苏州人的早点搭配。",
  "storage": "冷藏可存两天，回蒸五分钟恢复软糯；冷冻后口感变渣，不建议久存。",
