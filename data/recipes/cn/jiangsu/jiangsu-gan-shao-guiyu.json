  "equipment": [
    "炒锅",
    "刀",
    "砧板",
    "碗",
    "锅铲",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳜鱼去鳞去内脏洗净，两面各划三刀，用盐和绍兴酒抹匀腌十分钟去腥。",
      "time_min": 16,
      "heat": "无火",
      "tip": "鱼身划刀既入味又防煎的时候卷边变形。",
      "visual_cue": "鱼身刀口整齐，表面微微发润"
    },
    {
      "n": 2,
      "text": "用厨房纸把鱼身内外彻底擦干，特别是刀口和鱼腹里侧的水分。",
      "time_min": 7,
      "heat": "无火",
      "tip": "鱼皮必须擦干，下锅才有可能完整不破。",
      "visual_cue": "鱼皮干爽发紧，纸巾上无水痕"
    },
    {
      "n": 3,
      "text": "炒锅倒植物油烧到六成热，提着鱼尾滑入锅中，中火煎至两面金黄。",
      "time_min": 12,
      "heat": "中火",
      "tip": "鱼下锅后四分钟内不要翻动，等结壳自然离锅。",
      "visual_cue": "鱼皮金黄完整，边缘微卷起脆"
    },
    {
      "n": 4,
      "text": "把鱼拨到锅边，下五花肉丁小火煸出油，再放姜末蒜末与豆瓣酱炒香。",
      "time_min": 8,
      "heat": "小火",
      "tip": "肉丁煸出油再下酱，香味才够厚实。",
      "visual_cue": "肉丁微焦出油，酱色红亮冒香"
    },
    {
      "n": 5,
      "text": "沿锅边淋绍兴酒，加生抽、白砂糖与清水，大火煮开后转小火焖十二分钟。",
      "time_min": 16,
      "heat": "小火",
      "tip": "水加到鱼身一半高度即可，中途舀汤汁淋鱼背。",
      "visual_cue": "汤汁微滚，鱼身完整浮在汤中"
    },
    {
      "n": 6,
      "text": "转大火收汁，边收边把浓汁淋在鱼身上，撒葱段即可出锅装盘。",
      "time_min": 8,
      "heat": "大火",
      "tip": "收汁阶段别翻鱼，只淋不翻才能保持完整。",
      "visual_cue": "汤汁浓稠红亮，紧紧裹住鱼身"
    }
  ],
  "tips": [
    "鱼皮一定要擦干再下锅，这是煎鱼不破皮的第一步。",
    "煎鱼下锅后先别动，等它自己离锅再翻面。",
    "加五花肉丁是苏式干烧的特色，油脂让酱汁更香。",
    "收汁时只淋不翻，整条鱼才能完完整整上桌。"
  ],
  "common_mistakes": [
    "鱼皮带水下锅，一进油就粘锅破皮，整条鱼碎成几段。",
    "急着翻面，鱼皮被铲子撕掉一大块，卖相全无。",
    "火太大烧干汤汁，锅底焦糊，鱼带着苦味。",
    "收汁时反复翻动，鱼肉散开，端上桌只剩一堆碎块。"
  ],
  "substitutions": [
    {
      "original": "鳜鱼",
      "substitute": "鲈鱼",
      "ratio": "750克:700克",
      "note": "肉质更嫩，焖的时间减三分钟。"
    },
    {
      "original": "豆瓣酱",
      "substitute": "辣椒酱",
      "ratio": "20克:18克",
      "note": "辣度更高，糖可加三克。"
    }
  ],
  "variations": [
    "加一把泡软的干香菇同烧，鲜味层次更丰富，汤汁也更浓。",
    "收汁前淋一小勺香醋，酸香解腻，是江南人偏爱的吃法。",
    "把鱼换成黄鱼，肉更细，烧的时间减三分钟。"
  ],
  "serving_suggestion": "整条鱼摆在长盘里，把锅里的肉丁和浓汁一起浇上去，撒葱段，配米饭吃最下饭。",
  "storage": "冷藏可放一天，复热加两勺水小火焖三分钟，微波加热会让鱼肉发柴。",
