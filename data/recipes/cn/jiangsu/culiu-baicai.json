  "equipment": [
    "炒锅",
    "锅铲",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大白菜掰开洗净，菜帮斜刀片成薄片，菜叶撕成大片分开放。",
      "time_min": 8,
      "heat": "无火",
      "tip": "菜帮斜片更易熟，菜叶单独留着后下。",
      "visual_cue": "菜帮薄片透光、菜叶完整"
    },
    {
      "n": 2,
      "text": "小碗里放香醋、生抽、白糖、盐、玉米淀粉与清水调成芡汁。",
      "time_min": 3,
      "heat": "无火",
      "tip": "芡汁提前调好，下锅才不慌乱。",
      "visual_cue": "芡汁均匀、淀粉无颗粒"
    },
    {
      "n": 3,
      "text": "炒锅下植物油烧热，放大蒜片与小米辣小火炒香。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜片炒到微黄就够，别炒焦。",
      "visual_cue": "蒜香散出、蒜片边缘发黄"
    },
    {
      "n": 4,
      "text": "转大火下菜帮翻炒两分钟，炒到菜帮边缘变透明。",
      "time_min": 3,
      "heat": "大火",
      "tip": "菜帮先炒，叶后放才不出水。",
      "visual_cue": "菜帮变软透亮、锅气足"
    },
    {
      "n": 5,
      "text": "放入菜叶快速翻炒一分钟，菜叶刚塌下去即可。",
      "time_min": 2,
      "heat": "大火",
      "tip": "菜叶久炒会发黄出水。",
      "visual_cue": "菜叶翠绿变软、体积缩小"
    },
    {
      "n": 6,
      "text": "沿锅边淋入芡汁快速翻炒，汤汁变亮裹住菜叶即可出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "芡汁一开就关火，酸味才不挥发。",
      "visual_cue": "菜叶油亮、盘底不见汤水"
    }
  ],
  "tips": [
    "菜帮与菜叶分开下锅，成熟度才一致。",
    "醋分两次放，起锅前沿锅边补一点更香。",
    "喜欢酸口可以把白糖减到八克左右。"
  ],
  "common_mistakes": [
    "白菜下锅就撒盐，出水后变成水煮白菜。",
    "芡汁一次全倒入，锅温骤降菜叶发软。",
    "醋早放久煮，酸味挥发只剩涩味。"
  ],
  "substitutions": [
    {
      "original": "大白菜",
      "substitute": "娃娃菜",
      "ratio": "500g 对 450g",
      "note": "更嫩甜，炒制时间减一分钟。"
    },
    {
      "original": "香醋",
      "substitute": "陈醋",
      "ratio": "25ml 对 22ml",
      "note": "颜色深，酸味更厚重。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝同炒，吸汁更入味。",
    "把小米辣换成干辣椒段，香气更干爽。"
  ],
  "serving_suggestion": "趁热吃口感最好，配粥或配米饭都很清爽。",
  "storage": "当天吃完，复热后菜叶会出水变软。",
