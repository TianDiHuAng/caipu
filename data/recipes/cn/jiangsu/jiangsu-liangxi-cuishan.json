    "漏勺",
    "刀",
    "砧板",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳝丝用清水冲两遍去净血水，沥干后用厨房纸吸去表面水分，切成十厘米长段。",
      "time_min": 12,
      "heat": "无火",
      "tip": "鳝丝一定要吸干，带水下锅会炸溅，也炸不脆。",
      "visual_cue": "鳝丝表面干爽，颜色由暗红转浅。"
    },
    {
      "n": 2,
      "text": "炒锅放宽植物油烧到七成热，鳝丝分两批下锅，中火炸三分钟定型捞出。",
      "time_min": 10,
      "heat": "中火",
      "tip": "分批下锅油温才稳，一次倒满油温骤降，鳝丝会发软。",
      "visual_cue": "鳝丝卷缩发硬，颜色转深黄。"
    },
    {
      "n": 3,
      "text": "油温升到八成热，鳝丝回锅复炸一分半钟，炸到外皮起泡发脆立即捞出沥油。",
      "time_min": 6,
      "heat": "大火",
      "tip": "复炸是脆的关键，炸到轻敲有脆响就起锅，过火会发苦。",
      "visual_cue": "鳝丝乌黑发亮，相互碰撞有脆响。"
    },
    {
      "n": 4,
      "text": "另起净锅，放生抽、白糖、香醋、料酒和清水，小火熬到糖化汁浓能挂勺。",
      "time_min": 6,
      "heat": "小火",
      "tip": "汁熬到起细密小泡、舀起能挂一层再下鳝丝，否则挂不住。",
      "visual_cue": "汁色红亮，勺背挂一层薄浆。"
    },
    {
      "n": 5,
      "text": "下姜丝和炸好的鳝丝，中火快速翻拌让每根裹上糖醋汁，淋香油出锅。",
      "time_min": 4,
      "heat": "中火",
      "tip": "翻拌要快，动作慢了脆壳被汁泡软，就成了软塌塌的烧鳝。",
      "visual_cue": "鳝丝油亮红褐，盘底不见流汁。"
    },
    {
      "n": 6,
      "text": "装盘后撒芝麻和剩余大葱段，趁热吃，凉了脆感会明显下降。",
      "time_min": 2,
      "heat": "无火",
      "tip": "芝麻最后撒，下锅炒会发糊带苦味。",
      "visual_cue": "表面芝麻点点，色泽乌亮红润。"
    }
  ],
  "tips": [
    "鳝丝选手指粗细的笔杆鳝，肉厚耐炸，细鳝一炸就干。",
    "第一次炸定型、第二次炸上色，两遍油温别省，脆度全靠它。",
    "糖醋汁比例大约糖四、醋一、酱油二点五，甜中带咸才地道。"
  ],
  "common_mistakes": [
    "鳝丝没吸干水下锅，油花四溅，皮也炸不出脆壳。",
    "只炸一遍就调汁，成品软塌，放凉后更是咬不动。",
    "糖汁熬得太稀，浇上去挂不住，盘底一片汪水。"
  ],
  "substitutions": [
    {
      "original": "黄鳝",
      "substitute": "鳝鱼",
      "ratio": "1:1",
      "note": "两者本质相同，买现成烫杀去骨的鳝丝最省事。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "1:1.1",
      "note": "冰糖需先敲碎，熬汁时间延长一分钟，光泽更亮。"
    }
  ],
  "variations": [
    "无锡老法会把鳝丝炸到全干，再浇热糖醋汁，脆得能听见响，称重脆鳝。",
    "有的家庭加一小勺番茄酱调色，汁色更红，但酸甜比例要相应调整。"
  ],
  "serving_suggestion": "作冷盘或热菜都宜，摆盘时堆成小山状，配一壶黄酒最对味。",
  "storage": "现炸现吃最好，冷藏可存两日；复热用一百八十度烤箱烤三分钟，别回锅炒。",
