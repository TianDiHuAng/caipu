    "汤勺",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "豆腐先片成一厘米厚的片，再斜刀切成菱形小块。",
      "time_min": 8,
      "heat": "无火",
      "tip": "斜刀切出来的块受热均匀，也更容易挂住汤汁。",
      "visual_cue": "豆腐块呈整齐的菱形，边角完整"
    },
    {
      "n": 2,
      "text": "切好的豆腐块放进淡盐水里浸十分钟，去掉豆腥味。",
      "time_min": 10,
      "heat": "无火",
      "tip": "淡盐水能让豆腐收紧，煮的时候不容易碎。",
      "visual_cue": "豆腐块表面微微收紧，水略浑"
    },
    {
      "n": 3,
      "text": "香菇用温水泡开，挤干水分后再切成细丝备用。",
      "time_min": 20,
      "heat": "无火",
      "tip": "泡香菇的水别倒，滤净后加进汤里更鲜。",
      "visual_cue": "香菇丝柔软，泡香菇的水呈褐色"
    },
    {
      "n": 4,
      "text": "火腿切成细末，小葱切成葱花，两样分开放好备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "火腿末越细越容易释放咸鲜，汤味才透。",
      "visual_cue": "火腿末细碎均匀，葱花翠绿"
    },
    {
      "n": 5,
      "text": "砂锅里倒进高汤烧开，下香菇丝转小火煮五分钟。",
      "time_min": 6,
      "heat": "中小火",
      "tip": "先把香菇的香味煮进汤里，再下豆腐才不乱。",
      "visual_cue": "汤面微滚，能闻到明显菌香"
    },
    {
      "n": 6,
      "text": "轻轻推入豆腐块，转小火煨八分钟不要大力搅动。",
      "time_min": 8,
      "heat": "小火",
      "tip": "用勺背轻推防粘底，搅快了豆腐就散成渣。",
      "visual_cue": "豆腐块完整浮在汤中，汤色微白"
    },
    {
      "n": 7,
      "text": "玉米淀粉加清水调匀，分两次淋入汤里勾一层薄芡。",
      "time_min": 3,
      "heat": "小火",
      "tip": "分两次勾芡汤才会匀，一次倒下去容易结块。",
      "visual_cue": "汤汁挂勺，表面泛出细腻光泽"
    },
    {
      "n": 8,
      "text": "加盐与白胡椒调味，撒火腿末和葱花，淋香油离火。",
      "time_min": 2,
      "heat": "小火",
      "tip": "火腿本身有咸味，盐要在勾芡之后尝过再放。",
      "visual_cue": "汤面浮着火腿末与葱花，香气扑鼻"
    },
    {
      "n": 9,
      "text": "盛入汤碗后稍晾两分钟再端上桌，避免烫到嘴。",
      "time_min": 2,
      "heat": "无火",
      "tip": "勾过芡的汤保温性强，表面不冒气其实很烫。",
      "visual_cue": "汤面平整，芡汁透亮不浑浊"
    }
  ],
  "tips": [
    "豆腐选老一点的北豆腐，煨久了也不易碎。",
    "高汤用鸡汤最正，没有就用猪骨汤代替。",
    "火腿一定要选咸香的金华火腿，味道才够。",
    "勾芡后不要久煮，否则芡汁会返稀变水。"
  ],
  "common_mistakes": [
    "豆腐切得太薄，一煨就碎成一片豆花汤。",
    "勾芡一次全倒进去，汤里结出一团团粉块。",
    "端着就喝，勾芡的汤表面不冒热气却极烫。"
  ],
  "substitutions": [
    {
      "original": "豆腐",
      "substitute": "内酯豆腐",
      "ratio": "400克:400克",
      "note": "更嫩，但下锅后只能推不能翻。"
    },
    {
      "original": "火腿",
      "substitute": "咸肉",
      "ratio": "40克:40克",
      "note": "咸味更重，盐要减半。"
    }
  ],
  "variations": [
    "再抓一把虾仁一起同煨，汤的鲜味能更上一层。",
    "撒少许蟹黄，做成更讲究的宴席版本。"
  ],
  "serving_suggestion": "盛在白瓷汤碗里，撒一把葱花，趁热一勺一勺喝最鲜。",
  "storage": "当天喝完，隔夜豆腐会出水，汤味也容易发酸。",
