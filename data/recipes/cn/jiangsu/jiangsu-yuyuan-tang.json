  "equipment": [
    "汤锅",
    "刀",
    "砧板",
    "料理机",
    "汤勺",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草鱼去鳞去内脏洗净，片下两侧鱼肉，剔除鱼皮与红肉，再逐块摸查拔掉细刺。",
      "time_min": 18,
      "heat": "无火",
      "tip": "红肉和鱼皮腥味重必须去净，细刺用手摸一遍最保险。",
      "visual_cue": "鱼肉洁白无红，摸不到硬刺。"
    },
    {
      "n": 2,
      "text": "鱼肉切小块放进料理机，加姜水、蛋清、料酒和一半盐，打成细腻的鱼茸。",
      "time_min": 10,
      "heat": "无火",
      "tip": "姜水分次加，鱼茸能吸足水，成丸才嫩不柴。",
      "visual_cue": "鱼茸细腻发亮，挑起能缓慢流下。"
    },
    {
      "n": 3,
      "text": "鱼茸倒进碗里加玉米淀粉和白胡椒，顺一个方向搅打上劲，摔打十余次排气。",
      "time_min": 8,
      "heat": "无火",
      "tip": "搅到鱼茸抱团不散、插筷子能立住，鱼圆才不散。",
      "visual_cue": "鱼茸胶质拉丝，表面光滑有弹性。"
    },
    {
      "n": 4,
      "text": "汤锅放清水加姜片烧到微沸，用虎口挤出鱼圆下锅，全部浮起后撇去浮沫。",
      "time_min": 10,
      "heat": "微火",
      "tip": "水只能微沸，滚了就散；浮起说明已定型。",
      "visual_cue": "鱼圆雪白饱满，浮在汤面轻轻晃动。"
    },
    {
      "n": 5,
      "text": "鱼圆小火氽三分钟，放青菜烫到叶片变深绿，加剩余盐调味。",
      "time_min": 4,
      "heat": "小火",
      "tip": "鱼圆氽透后按压有回弹，中间不塌就熟了。",
      "visual_cue": "鱼圆轻按回弹，青菜叶色深绿。"
    },
    {
      "n": 6,
      "text": "连汤盛进深碗，淋香油撒小葱葱花和白胡椒，趁热上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "汤要清，别加酱油；胡椒粉最后撒，香气才冲。",
      "visual_cue": "汤色清亮，鱼圆洁白如雪。"
    }
  ],
  "tips": [
    "鱼圆讲究细嫩，鱼肉与水的比例约二比一，水少了发硬。",
    "打鱼茸时碗底垫冰块，温度低鱼茸更易上劲。",
    "一次做多吃不完，氽熟后冷冻，下次直接下汤。"
  ],
  "common_mistakes": [
    "细刺没拔净，鱼圆吃起来扎嘴，毁掉整锅。",
    "水大滚时下鱼圆，鱼圆被冲散，汤里全是碎渣。",
    "搅打不到位就挤丸，下锅立刻散开成鱼糊。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲈鱼",
      "ratio": "1:1",
      "note": "鲈鱼肉质更紧实，需多加二十毫升姜水保持嫩度。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "土豆淀粉",
      "ratio": "1:1",
      "note": "土豆淀粉黏性更强，用量减五克，免得口感发粉。"
    }
  ],
  "variations": [
    "苏州老菜把鱼圆做成乒乓球大小，内藏一小团肉馅，咬开有汤汁，称为藏心鱼圆。",
    "有的家庭在鱼茸里加一勺猪油，鱼圆更滑，汤也带脂香。"
  ],
  "serving_suggestion": "清汤鱼圆当汤菜上桌，配一碗米饭和一只炒青菜；也可作宴席中的清口汤。",
  "storage": "鱼圆氽熟后冷藏可存两日，冷冻两周；汤现做现喝，复热用小火温开。",
