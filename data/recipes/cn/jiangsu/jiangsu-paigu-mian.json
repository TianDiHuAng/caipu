  "steps": [
    {
      "n": 1,
      "text": "排骨斩成小块，冷水下锅加姜片焯三分钟，捞出用温水冲净浮沫。",
      "time_min": 12,
      "heat": "中火",
      "tip": "排骨块切小一点，容易烧透也方便入口。",
      "visual_cue": "排骨断面无血水，块块干净"
    },
    {
      "n": 2,
      "text": "炒锅下植物油，排骨煎到表面微黄，加生抽、老抽、绍兴酒与冰糖炒匀。",
      "time_min": 8,
      "heat": "中火",
      "tip": "排骨先煎香再烧，汤头才带肉香不发腥。",
      "visual_cue": "排骨通体酱红，锅底油亮"
    },
    {
      "n": 3,
      "text": "倒入八百毫升清水，大火煮开转小火焖三十分钟至排骨酥软。",
      "time_min": 33,
      "heat": "小火",
      "tip": "小火焖足半小时，肉才酥得能抿下来。",
      "visual_cue": "筷子能插入肉层，汤色红亮"
    },
    {
      "n": 4,
      "text": "另起汤锅烧水煮面，面条下锅煮三分钟至断生，捞出过一下凉水。",
      "time_min": 6,
      "heat": "大火",
      "tip": "面煮到刚断生就捞出，泡在汤里还会继续软。",
      "visual_cue": "面条洁白有弹性，不粘连"
    },
    {
      "n": 5,
      "text": "面碗里放猪油、少许盐与生抽，冲入两勺滚烫的排骨汤化开。",
      "time_min": 3,
      "heat": "无火",
      "tip": "碗底先调好味再冲汤，这是苏式汤面的规矩。",
      "visual_cue": "汤面浮着油花，香气扑鼻"
    },
    {
      "n": 6,
      "text": "面条放进碗中，铺上排骨，烫两棵青菜，撒葱花即可。",
      "time_min": 5,
      "heat": "中火",
      "tip": "青菜最后烫，保持翠绿，摆盘也好看。",
      "visual_cue": "排骨堆在面上，青菜点缀一侧"
    }
  ],
  "tips": [
    "苏式汤面讲究碗底先调味再冲汤，味道才匀。",
    "排骨焖足半小时，肉才酥到能轻轻一抿就下来。",
    "面条煮到断生就捞，泡在热汤里会继续变软。",
    "一勺猪油是汤面的灵魂，别省这一口香。"
  ],
  "common_mistakes": [
    "排骨不焯水直接烧，汤浑浊还带腥。",
    "面煮得太软再入汤，端上桌就糊成一团。",
    "碗里不先调味，冲汤后咸淡不均。",
    "青菜和面一起煮，菜叶发黄汤也发浑。"
  ],
  "substitutions": [
    {
      "original": "排骨",
      "substitute": "五花肉",
      "ratio": "400克:350克",
      "note": "更油润，焖的时间减十分钟。"
    },
    {
      "original": "细面",
      "substitute": "宽面",
      "ratio": "300克:300克",
      "note": "更耐泡，煮的时间加一分钟。"
    }
  ],
  "variations": [
    "红烧排骨换成爆鱼，就是苏式爆鱼面，风味完全不同。",
    "汤里加一勺雪菜末，酸香开胃，是浙江一带的吃法。",
    "撒一把蒜叶末代替葱花，香气更冲。"
  ],
  "serving_suggestion": "面盛进大碗，排骨整齐摆在面上，青菜放一边，趁热吃面喝汤，一碗下去很满足。",
  "storage": "汤与面分开冷藏可放一天，复热汤单独煮开再放面，避免面泡烂。",
