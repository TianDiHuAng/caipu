  "equipment": [
    "炒锅",
    "锅铲",
    "砧板",
    "砂锅"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄鳝段用温水冲洗掉表面黏液，再撒一把盐抓两分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "盐能带走黏液和腥味，抓完冲净手感就不滑了。",
      "visual_cue": "表面黏液减少，肉段颜色转浅"
    },
    {
      "n": 2,
      "text": "冲净的黄鳝段加料酒与姜片抓匀，腌十分钟去腥。",
      "time_min": 11,
      "heat": "无火",
      "tip": "黄鳝腥味重，这一步省不得，腌过的肉更紧实。",
      "visual_cue": "肉段微微收紧，盆底有淡色血水"
    },
    {
      "n": 3,
      "text": "炒锅大火烧热放花生油，下整瓣大蒜小火煸到表面金黄。",
      "time_min": 5,
      "heat": "小火",
      "tip": "大蒜煸透才不辣口，煸到金黄捞出备用。",
      "visual_cue": "蒜瓣鼓起泛金，油里满是蒜香"
    },
    {
      "n": 4,
      "text": "转大火下姜片与干辣椒炒香，倒入黄鳝段快速翻炒。",
      "time_min": 4,
      "heat": "大火",
      "tip": "黄鳝一定要大火快炒，火小了会出一锅水，肉也变老。",
      "visual_cue": "肉段卷曲发白，锅底略有焦香"
    },
    {
      "n": 5,
      "text": "淋料酒沿锅边一圈，加生抽、老抽与白糖翻匀上色。",
      "time_min": 3,
      "heat": "大火",
      "tip": "料酒沿锅边淋遇热才挥发出香气，直接浇肉上会留味。",
      "visual_cue": "肉段呈红亮酱色，酒气散去"
    },
    {
      "n": 6,
      "text": "倒入没过一半的热水，放回蒜瓣与葱结，烧开后转小火。",
      "time_min": 4,
      "heat": "中火",
      "tip": "一定要加热水，冷水会让鳝肉突然收缩发柴。",
      "visual_cue": "汤汁没过肉段一半，表面浮油"
    },
    {
      "n": 7,
      "text": "盖盖小火焖十二分钟，中途翻动一次让入味均匀。",
      "time_min": 12,
      "heat": "小火",
      "tip": "焖到筷子能轻松插透就够了，久焖肉会散。",
      "visual_cue": "汤汁减半，肉段酥软不烂"
    },
    {
      "n": 8,
      "text": "开盖大火收汁，边收边晃锅，让酱汁裹住每一段。",
      "time_min": 3,
      "heat": "大火",
      "tip": "收汁时别用铲子猛翻，晃锅才不会把肉段弄碎。",
      "visual_cue": "汤汁浓稠挂勺，肉段油亮如釉"
    },
    {
      "n": 9,
      "text": "撒白胡椒粉与盐调味，淋香油，撒葱花起锅装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "白胡椒最后撒才有辛香，早早放进去会被焖得没味。",
      "visual_cue": "盘中酱汁聚拢，葱花翠绿点缀"
    }
  ],
  "tips": [
    "黄鳝要买活的现杀，肉质才够弹。",
    "大蒜多放不嫌多，焖软后比鳝肉还香。",
    "汤汁别收太干，留一点拌饭极香。",
    "加一小块五花肉同烧，鲜味更厚。"
  ],
  "common_mistakes": [
    "黄鳝没抓洗黏液就下锅，整道菜一股土腥味。",
    "小火慢炒，鳝段出一锅水，肉又老又柴。",
    "收汁时用铲子猛翻，肉段碎成小块卖相差。"
  ],
  "substitutions": [
    {
      "original": "黄鳝",
      "substitute": "泥鳅",
      "ratio": "500克:500克",
      "note": "肉质更细，焖的时间加三分钟。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "15克:16克",
      "note": "收汁更亮，甜味更柔。"
    }
  ],
  "variations": [
    "加一把竹笋段同烧，口感层次更丰富。",
    "收汁后转入砂锅小火煨五分钟，上桌更热乎。"
  ],
  "serving_suggestion": "趁热连汁装盘，配白米饭，把浓汁浇在饭上，蒜瓣也要一起吃。",
  "storage": "冷藏两天，复热加一勺水小火焖五分钟，肉质会略紧。",
