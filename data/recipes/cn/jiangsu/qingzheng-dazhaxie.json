  "equipment": [
    "蒸锅",
    "毛刷",
    "小碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "大闸蟹用毛刷在流水下刷净蟹壳、蟹钳与腹部的泥沙，绑绳不要解开。",
      "time_min": 12,
      "heat": "无火",
      "tip": "绑着蒸蟹腿才不会脱落，蟹黄也不流失。",
      "visual_cue": "蟹壳青亮、缝隙无泥沙"
    },
    {
      "n": 2,
      "text": "蒸锅加 1500ml 清水，水里倒 20ml 绍兴酒，铺上紫苏叶与 20g 姜片，大火烧开。",
      "time_min": 6,
      "heat": "大火",
      "tip": "水开后再放蟹，蟹肉才紧实不腥。",
      "visual_cue": "蒸锅上汽、香气散出"
    },
    {
      "n": 3,
      "text": "蟹腹部朝上摆入蒸屉，每只之间留出空隙，加盖大火蒸 15 分钟。",
      "time_min": 15,
      "heat": "大火",
      "tip": "腹朝上能让蟹黄稳稳留在壳里。",
      "visual_cue": "蟹壳转为均匀的橙红色"
    },
    {
      "n": 4,
      "text": "蒸蟹时把剩余 20g 姜切成细末，加香醋、生抽与白糖调成蘸碟。",
      "time_min": 4,
      "heat": "无火",
      "tip": "姜末切得越细，蘸碟越香且不呛。",
      "visual_cue": "蘸碟姜末细腻、味道酸甜咸"
    },
    {
      "n": 5,
      "text": "关火后焖 2 分钟再开盖，取出蟹剪去绑绳，趁热配蘸碟上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "关火焖 2 分钟，蟹黄更凝实。",
      "visual_cue": "蟹黄红亮、蟹肉雪白饱满"
    }
  ],
  "tips": [
    "农历九月吃母蟹、十月吃公蟹，膏黄最饱满。",
    "吃蟹配姜茶或黄酒，能中和寒性。",
    "蟹心、蟹腮、蟹胃、蟹肠四样务必去掉不吃。"
  ],
  "common_mistakes": [
    "冷水就把蟹放进去蒸，蟹腿在挣扎中脱落、腥味重。",
    "蒸太久超过 20 分钟，蟹肉发柴、鲜甜尽失。",
    "蟹腹朝下摆，蟹黄受热后从缝隙流走。"
  ],
  "substitutions": [
    {
      "original": "蟹",
      "substitute": "梭子蟹",
      "ratio": "900g 大闸蟹 ≈ 900g 梭子蟹",
      "note": "梭子蟹壳薄，蒸制时间减至 12 分钟。"
    },
    {
      "original": "绍兴酒",
      "substitute": "料酒",
      "ratio": "1:1",
      "note": "料酒香味略冲，用量减半。"
    }
  ],
  "variations": [
    "家庭简化版：不铺紫苏，用 3 片姜与 1 根葱段垫底，同样去腥。",
    "江南宴席版：蘸碟加 5g 白糖熬成姜汁糖醋，味道更醇厚。"
  ],
  "serving_suggestion": "三只蟹配一碟姜醋，饭后一碗姜茶；江浙人家的秋季家宴标配。",
  "storage": "蟹必须现蒸现吃，隔夜蟹肉易生细菌，不建议保存。",
