  "equipment": [
    "大汤锅",
    "棉线",
    "刀",
    "砧板",
    "漏勺",
    "保鲜膜"
  ],
  "steps": [
    {
      "n": 1,
      "text": "带皮羊腿肉冷水浸泡三十分钟去血水，捞出用棉线捆成紧实的圆柱形。",
      "time_min": 35,
      "heat": "无火",
      "tip": "捆得越紧切片越圆整，煮后不会散成块。",
      "visual_cue": "肉卷紧实成柱，棉线勒出浅沟。"
    },
    {
      "n": 2,
      "text": "羊肉冷水下锅，加料酒和一半姜片，中火煮开撇净浮沫后捞出冲洗。",
      "time_min": 15,
      "heat": "中火",
      "tip": "飞水的水要倒掉，膻味大半在这一步。",
      "visual_cue": "浮沫结块浮起，羊肉表面发白。"
    },
    {
      "n": 3,
      "text": "汤锅重新加清水，放羊肉、姜片、大葱段、白萝卜块和花椒料包，大火烧开。",
      "time_min": 12,
      "heat": "大火",
      "tip": "白萝卜同煮能吸膻，煮完可以丢掉不吃。",
      "visual_cue": "汤色转乳白，膻味变淡。"
    },
    {
      "n": 4,
      "text": "转小火保持微滚九十分钟，煮到筷子能轻松扎透羊皮和瘦肉。",
      "time_min": 90,
      "heat": "小火",
      "tip": "全程只冒细泡，滚猛了羊肉发柴、皮会破。",
      "visual_cue": "筷子直插无阻，羊皮起胶发亮。"
    },
    {
      "n": 5,
      "text": "加盐调味后再焖十分钟，捞出肉卷用保鲜膜裹紧，压上重物放凉四小时。",
      "time_min": 20,
      "heat": "微火",
      "tip": "盐后放肉才嫩，重物压过切面才平整。",
      "visual_cue": "肉卷收紧变方，按压有回弹。"
    },
    {
      "n": 6,
      "text": "肉卷切成两毫米薄片码盘，生抽、米醋和香油调蘸碟，撒白胡椒上桌。",
      "time_min": 8,
      "heat": "无火",
      "tip": "刀要快、片要薄，两毫米最好，厚了口感发木也不易挂汁。",
      "visual_cue": "薄片透光，皮冻层呈半透明。"
    }
  ],
  "tips": [
    "藏书羊肉讲究用山羊，肉质紧、膻味轻，绵羊做出来偏油。",
    "煮肉的汤撇净浮油就是羊汤，加粉丝和青菜又是一顿。",
    "冷藏一夜再切片，肉质更紧，片形完整不粘刀。"
  ],
  "common_mistakes": [
    "羊肉没捆就下锅，煮后散开，切片全是不规则碎块。",
    "中大火滚煮，羊肉纤维紧缩发柴，羊皮破裂。",
    "热肉直接切片，肉汁流失，片上又干又散。"
  ],
  "substitutions": [
    {
      "original": "羊肉",
      "substitute": "羊腿肉",
      "ratio": "1:1",
      "note": "去骨羊腿卷制更方便，煮的时间缩短一刻钟。"
    },
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "1:1",
      "note": "香醋酸味柔和，蘸碟里糖可以少放两克。"
    }
  ],
  "variations": [
    "苏州藏书一带冬天把羊肉连汤冻成羊糕，切片后带一层琥珀色肉冻，冷吃最鲜。",
    "有的店家在蘸碟里加一勺辣酱和蒜末，膻香压得更净。"
  ],
  "serving_suggestion": "薄片冷吃最能尝出羊肉本味，配一碗滚热的羊汤和一小碟醋汁正好。",
  "storage": "冷藏可存三日，冷冻两周；复热连原汤蒸十分钟，别用大火煮。",
