    "平底锅",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "娃娃菜纵向切成四瓣，用清水冲洗干净后沥干水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "纵向切能保住菜帮，煮时不易散。",
      "visual_cue": "菜瓣完整、根部相连"
    },
    {
      "n": 2,
      "text": "平底锅刷一层薄油，倒入蛋液摊成薄蛋皮，晾凉后切细丝。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蛋液摊得越薄，蛋皮丝越好看。",
      "visual_cue": "蛋皮金黄均匀、边缘不焦"
    },
    {
      "n": 3,
      "text": "炒锅下植物油，大蒜拍破后小火煎至表面金黄出香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "大蒜煎黄才出甜香，别煎焦。",
      "visual_cue": "蒜瓣金黄、锅里蒜香浓"
    },
    {
      "n": 4,
      "text": "加生姜片与清水烧开，放娃娃菜加盖中火煮五分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "菜帮朝下摆，受热更均匀。",
      "visual_cue": "菜帮变透明、汤色清亮"
    },
    {
      "n": 5,
      "text": "加盐与白胡椒调味，撒入蛋皮丝再煮一分钟。",
      "time_min": 2,
      "heat": "中火",
      "tip": "蛋皮丝最后放，久煮会散。",
      "visual_cue": "蛋皮丝浮在汤面、菜叶翠绿"
    },
    {
      "n": 6,
      "text": "连汤带菜盛入深盘，先摆菜瓣再浇汤，撒葱花即可上桌。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盛盘时先摆菜再浇汤，卖相更好。",
      "visual_cue": "菜瓣整齐、汤面泛油光"
    }
  ],
  "tips": [
    "没有高汤用清水加煎蒜，也有淡淡奶香。",
    "娃娃菜选小棵紧实的，帮薄味甜。",
    "蛋皮丝可以提前摊好，上桌前再撒。"
  ],
  "common_mistakes": [
    "娃娃菜久煮不收手，菜帮烂成糊。",
    "大蒜用大火煎，外焦里生还带着苦味。",
    "汤里放酱油，清淡的奶白汤色被毁掉。"
  ],
  "substitutions": [
    {
      "original": "娃娃菜",
      "substitute": "大白菜",
      "ratio": "500g 对 500g",
      "note": "取菜心部分，煮制时间加两分钟。"
    },
    {
      "original": "鸡蛋",
      "substitute": "咸蛋",
      "ratio": "100g 对 80g",
      "note": "汤更鲜，盐量要减。"
    }
  ],
  "variations": [
    "加几只虾仁同煮，鲜味直接翻倍。",
    "把清水换成鸡清汤，就是标准的酒楼版本。"
  ],
  "serving_suggestion": "连汤一起盛碗，配米饭清爽解腻。",
  "storage": "冷藏可放一天，复热时补少量清水。",
