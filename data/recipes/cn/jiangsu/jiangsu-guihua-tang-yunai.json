  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "芋头",
          "name_en": "taro",
          "amount": 450,
          "unit": "g",
          "note": "选小个头芋艿，去皮",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "红枣",
          "name_en": "red date",
          "amount": 40,
          "unit": "g",
          "note": "去核，可选",
          "optional": false
        },
        {
          "name": "桂花",
          "name_en": "osmanthus flower",
          "amount": 3,
          "unit": "g",
          "note": "干桂花，最后撒",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "红糖",
          "name_en": "brown sugar",
          "amount": 50,
          "unit": "g",
          "note": "上色提香",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 20,
          "unit": "g",
          "note": "补甜",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 5,
          "unit": "g",
          "note": "调薄芡",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "小碗",
    "牙签"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芋头洗净后上锅蒸十分钟，放凉到不烫手再动手剥皮。",
      "time_min": 12,
      "heat": "中火",
      "tip": "先蒸后剥，皮一撕就掉，手也不会发痒。",
      "visual_cue": "表皮起皱，轻捏能整片剥落"
    },
    {
      "n": 2,
      "text": "剥好的芋头切成三厘米见方的滚刀块，大小尽量一致。",
      "time_min": 5,
      "heat": "无火",
      "tip": "块形一致才会同时煮透，不然小的烂了大的还硬。",
      "visual_cue": "芋块棱角分明，断面呈乳白色"
    },
    {
      "n": 3,
      "text": "另起汤锅加足清水大火烧开，放入芋头块与去核红枣。",
      "time_min": 5,
      "heat": "大火",
      "tip": "芋头一定热水下锅，冷水煮容易散成糊。",
      "visual_cue": "水面翻滚，芋块浮沉翻动"
    },
    {
      "n": 4,
      "text": "转小火煮二十分钟，煮到筷子能轻松扎透芋块。",
      "time_min": 20,
      "heat": "小火",
      "tip": "小火慢煮芋块才完整，大火会把它冲散。",
      "visual_cue": "芋块表面微透，筷子一插即入"
    },
    {
      "n": 5,
      "text": "加进红糖与白糖，用勺背轻轻推动让糖完全化开。",
      "time_min": 4,
      "heat": "小火",
      "tip": "糖要分两次加，先少后多，甜度才好控制。",
      "visual_cue": "汤汁转为琥珀色，甜香散出"
    },
    {
      "n": 6,
      "text": "玉米淀粉加两勺冷水调开，缓缓淋入锅中勾薄芡。",
      "time_min": 3,
      "heat": "小火",
      "tip": "芡不能厚，只需让汤汁略挂勺，太稠就成糊了。",
      "visual_cue": "汤色透亮微稠，勺背挂一层薄汁"
    },
    {
      "n": 7,
      "text": "关火后撒干桂花，盖盖焖三分钟让香气落进汤里。",
      "time_min": 4,
      "heat": "无火",
      "tip": "桂花全靠余温出香，跟着一起煮就只剩苦涩味。",
      "visual_cue": "汤面浮着细碎金黄桂花"
    }
  ],
  "tips": [
    "芋艿选小个头的，粉糯度高，大芋头偏水。",
    "剥芋头怕手痒可以戴手套，或先用醋水洗手。",
    "红糖上色，白糖提甜，两者比例可按口味调。",
    "冷藏后当凉甜汤吃，桂花香更明显。"
  ],
  "common_mistakes": [
    "芋头冷水下锅，煮到一半就散成一锅糊。",
    "糖一次全放还大火猛煮，锅底结了一层焦糖。",
    "桂花跟着一起煮，香气跑光只剩涩味。"
  ],
  "substitutions": [
    {
      "original": "红糖",
      "substitute": "冰糖",
      "ratio": "50克:45克",
      "note": "汤色更清，甜味更干净。"
    },
    {
      "original": "芋头",
      "substitute": "红薯",
      "ratio": "450克:450克",
      "note": "甜度更高，糖可减三分之一。"
    }
  ],
  "variations": [
    "加一小把糯米小圆子同煮，做成桂花芋艿圆子。",
    "用桂花糖替代干桂花，香气更浓但甜度要减。"
  ],
  "serving_suggestion": "装小碗温热吃，芋块粉糯、汤汁甜润，作为下午点心或饭后甜汤都合适。",
  "storage": "冷藏三天，复热加少量清水小火煮开，芋块久煮会散要轻推。",
