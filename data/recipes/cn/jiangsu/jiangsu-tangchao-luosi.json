  "equipment": [
    "炒锅",
    "剪刀",
    "大碗",
    "锅铲",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "螺蛳放清水里养一天，滴两滴香油促吐沙。，看准状态再往下做。",
      "time_min": 62,
      "heat": "无火",
      "tip": "养够时间，泥沙才吐得干净。，看准状态再往下做。",
      "visual_cue": "水底沉沙，螺口张开"
    },
    {
      "n": 2,
      "text": "用剪刀剪掉螺蛳尾部尖端，方便吸出螺肉。，看准状态再往下做。",
      "time_min": 15,
      "heat": "无火",
      "tip": "尾部不剪，吃的时候根本吸不出来。，看准状态再往下做。",
      "visual_cue": "尾部平整，螺壳完整"
    },
    {
      "n": 3,
      "text": "剪好的螺蛳再冲洗两遍，沥干水分。，看准状态再往下做。",
      "time_min": 6,
      "heat": "无火",
      "tip": "多冲两遍，壳缝里的沙才干净。，看准状态再往下做。",
      "visual_cue": "外壳洁净，无泥沙，这一点很关键。"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧热，下姜片蒜末干辣椒炒香。，看准状态再往下做。",
      "time_min": 4,
      "heat": "中火",
      "tip": "香料炒出味再下螺，香气才足。，看准状态再往下做。",
      "visual_cue": "蒜末微黄，辣香冲出"
    },
    {
      "n": 5,
      "text": "倒螺蛳大火翻炒两分钟，烹入料酒。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火快炒，螺肉才不老。，看准状态再往下做。",
      "visual_cue": "螺壳泛光，酒气散开"
    },
    {
      "n": 6,
      "text": "加生抽、老抽和白糖翻炒上色。，看准状态再往下做。",
      "time_min": 3,
      "heat": "大火",
      "tip": "糖能让螺肉更鲜甜。，看准状态再往下做。",
      "visual_cue": "壳面裹色，油光明亮"
    },
    {
      "n": 7,
      "text": "加清水烧开，加盖中火焖八分钟。，看准状态再往下做。",
      "time_min": 9,
      "heat": "中火",
      "tip": "焖一下入味，螺肉也不会缩。，看准状态再往下做。",
      "visual_cue": "汤汁减半，香气浓郁"
    },
    {
      "n": 8,
      "text": "开大火收汁，撒葱段翻匀出锅。，看准状态再往下做。",
      "time_min": 4,
      "heat": "大火",
      "tip": "留点汤汁，蘸着吃更香。，看准状态再往下做。",
      "visual_cue": "汁浓挂壳，葱段翠绿"
    }
  ],
  "tips": [
    "螺蛳要养够时间吐沙，不然吃着满口沙。",
    "尾部必须剪掉，否则吸不出螺肉。，这一点很关键。",
    "糖不能省，甜味托鲜，螺肉才不发苦。"
  ],
  "common_mistakes": [
    "吐沙时间不够，一盘都是沙。，这一点很关键。",
    "尾部没剪，吃的时候干着急。，这一点很关键。",
    "焖太久，螺肉缩成一点点。，这一点很关键。"
  ],
  "substitutions": [
    {
      "original": "螺蛳",
      "substitute": "田螺",
      "ratio": "800 克:800 克",
      "note": "个头更大，焖的时间加三分钟。"
    },
    {
      "original": "干辣椒",
      "substitute": "辣椒酱",
      "ratio": "10 克:15 克",
      "note": "辣味更厚，糖可略加。"
    }
  ],
  "variations": [
    "加一把紫苏，香气更特别。，这一点很关键。",
    "放几片咸肉同炒，鲜味更足。，这一点很关键。"
  ],
  "serving_suggestion": "配冰啤酒，夏天夜里最惬意。，这一点很关键。",
  "storage": "冷藏一天，复热加少许清水煮开。，这一点很关键。",
