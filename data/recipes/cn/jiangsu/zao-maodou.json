        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "保鲜盒",
    "剪刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "毛豆用清水反复搓洗，洗去表面绒毛，再用剪刀逐只剪去两端尖角。",
      "time_min": 12,
      "heat": "无火",
      "tip": "剪角才入味，这是糟毛豆的门槛。",
      "visual_cue": "每只毛豆两端露出豆粒"
    },
    {
      "n": 2,
      "text": "汤锅加足量清水烧开，放 5g 盐、2g 花椒与八角，煮出香味。",
      "time_min": 6,
      "heat": "大火",
      "tip": "先煮香料水，豆子才有底味。",
      "visual_cue": "水面翻滚、香料味明显"
    },
    {
      "n": 3,
      "text": "下毛豆中火煮 8 分钟，全程不加盖保持翠绿。",
      "time_min": 8,
      "heat": "中火",
      "tip": "加盖会焖黄，颜色就不好看了。",
      "visual_cue": "毛豆浮起、豆粒变软"
    },
    {
      "n": 4,
      "text": "捞出毛豆立刻浸入冰水中冷却 3 分钟，锁住口感与颜色。",
      "time_min": 4,
      "heat": "无火",
      "tip": "过冰水后豆子更脆更绿。",
      "visual_cue": "毛豆迅速降温、颜色鲜绿"
    },
    {
      "n": 5,
      "text": "沥干毛豆放入保鲜盒，倒入 250ml 糟卤没过豆子，冷藏浸泡 2 小时。",
      "time_min": 122,
      "heat": "无火",
      "tip": "糟卤要完全没过，入味才均匀。",
      "visual_cue": "毛豆吸足卤汁、香气清冽"
    }
  ],
  "tips": [
    "毛豆两端必须剪开，否则糟卤进不去。",
    "煮豆不加盖，颜色才翠绿不发黄。",
    "糟卤别兑水，兑淡了就没有糟香。"
  ],
  "common_mistakes": [
    "毛豆没煮熟，豆腥味重且不易消化。",
    "煮好不过冰水，豆子发软失去脆感。",
    "用煮豆的水兑糟卤，成品浑浊发酸。"
  ],
  "substitutions": [
    {
      "original": "糟卤",
      "substitute": "花雕酒加盐",
      "ratio": "250ml 对 200ml 加 6g",
      "note": "香气略薄，需冷藏 4 小时。"
    },
    {
      "original": "毛豆",
      "substitute": "蚕豆",
      "ratio": "500g 对 500g",
      "note": "需剥壳，煮制时间减 2 分钟。"
    }
  ],
  "variations": [
    "辣糟版：糟卤里加 3 根小米辣同泡。",
    "毛豆花生版：加 200g 熟花生米一起糟。"
  ],
  "serving_suggestion": "冷藏后沥干装碟，作为夏天下酒或配粥的小菜。",
  "storage": "冷藏浸泡可存 3 天，取食时用干净筷子夹取。",
