  "equipment": [
    "刀",
    "砧板",
    "砂锅",
    "汤勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "五花肉 500g 先切薄片再切成石榴粒大小的肉粒，用刀略剁几下保持颗粒感。",
      "time_min": 12,
      "heat": "无火",
      "tip": "千万不要绞成肉泥，颗粒才松软。",
      "visual_cue": "肉粒均匀、肥瘦分明"
    },
    {
      "n": 2,
      "text": "荸荠 80g 拍碎切细粒，加到肉粒里，加葱末 30g、姜末 15g 拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "荸荠提供清甜和脆感，别省。",
      "visual_cue": "馅料拌匀、颗粒分明"
    },
    {
      "n": 3,
      "text": "加 5g 盐、20ml 料酒、2g 白胡椒粉、2 个蛋清与 15g 淀粉，顺一个方向搅打 5 分钟。",
      "time_min": 5,
      "heat": "无火",
      "tip": "搅到上劲，丸子下锅才不散。",
      "visual_cue": "肉料黏稠、能抱成团"
    },
    {
      "n": 4,
      "text": "把肉料分成四份，双手来回摔打成直径 6 厘米的大丸子。",
      "time_min": 5,
      "heat": "无火",
      "tip": "摔打能排出空气，丸子更紧实。",
      "visual_cue": "丸子表面光滑、大小一致"
    },
    {
      "n": 5,
      "text": "砂锅倒 900ml 高汤烧至微沸，轻轻放入丸子，水面保持似开未开。",
      "time_min": 6,
      "heat": "中火",
      "tip": "水只能微沸，滚开就把丸子冲散。",
      "visual_cue": "丸子浮起、汤面细泡"
    },
    {
      "n": 6,
      "text": "转小火盖上锅盖炖 70 分钟，中途撇去表面浮油两次。",
      "time_min": 70,
      "heat": "小火",
      "tip": "小火慢炖，丸子才酥软不柴。",
      "visual_cue": "丸子弹嫩、汤色清亮"
    },
    {
      "n": 7,
      "text": "尝味后补少许盐，连汤带丸盛入汤碗，撒上葱花即可上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "盐最后补，早放肉质会发紧发柴。",
      "visual_cue": "汤清丸嫩、浮油稀少"
    }
  ],
  "tips": [
    "肉一定要切成颗粒，绞肉机打出来的口感完全不同。",
    "下丸子时汤面只能微沸，滚沸会把丸子冲散。",
    "炖的过程中撇两次油，汤才清而不腻。"
  ],
  "common_mistakes": [
    "肉粒剁得太细，炖出来像肉饼一点也不松软。",
    "大火滚煮，丸子表面破碎汤里全是渣。",
    "盐放太早，肉质收缩变得又紧又柴。"
  ],
  "substitutions": [
    {
      "original": "五花肉",
      "substitute": "猪前腿肉",
      "ratio": "500g 对 500g",
      "note": "脂肪少，需加 20ml 高汤调馅。"
    },
    {
      "original": "荸荠",
      "substitute": "莲藕",
      "ratio": "80g 对 80g",
      "note": "脆度相近，切得再碎一些。"
    }
  ],
  "variations": [
    "加 30g 蟹肉同拌，做成蟹粉狮子头。",
    "丸子里塞一颗咸蛋黄，切开有惊喜。"
  ],
  "serving_suggestion": "连汤装碗，撒少许葱花，配米饭或直接喝汤。",
  "storage": "冷藏可存 2 天，复热时连汤小火加热，别用微波炉。",
