        }
      ]
    }
  ],
  "equipment": [
    "砧板",
    "小碗",
    "细线",
    "筷子"
  ],
  "steps": [
    {
      "n": 1,
      "text": "皮蛋剥壳前先在案板上轻轻滚一圈，让壳与胶质之间松开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "滚壳能让蛋壳整片剥落，胶质表面不会被抠出坑洼。",
      "visual_cue": "蛋壳出现细密裂纹，仍完整裹住蛋体"
    },
    {
      "n": 2,
      "text": "剥掉蛋壳后用清水冲一下，再用厨房纸把表面黏液擦干净。",
      "time_min": 2,
      "heat": "无火",
      "tip": "表面黏液带碱味，擦干净切的时候刀才不打滑。",
      "visual_cue": "蛋体表面干爽，呈深褐透亮的胶质"
    },
    {
      "n": 3,
      "text": "用细线在皮蛋上绕一圈勒紧，把蛋勒成均匀的六瓣。",
      "time_min": 4,
      "heat": "无火",
      "tip": "细线比刀好用，溏心不会被压糊，切面也更干净。",
      "visual_cue": "瓣形完整，中心呈墨绿溏心"
    },
    {
      "n": 4,
      "text": "生姜去皮后磨成细末，越细越好，装进小碗备用。",
      "time_min": 3,
      "heat": "无火",
      "tip": "姜末磨得细，才能均匀挂在蛋面上不扎口。",
      "visual_cue": "姜末成细腻湿润的蓉状"
    },
    {
      "n": 5,
      "text": "碗里加生抽、香醋、白糖与盐，顺着一个方向搅到糖化开。",
      "time_min": 2,
      "heat": "无火",
      "tip": "糖只用来压碱味，尝起来不该有明显的甜。",
      "visual_cue": "酱汁呈红褐色，碗底无颗粒"
    },
    {
      "n": 6,
      "text": "把姜末与小米辣拌进酱汁，最后淋香油调匀成姜汁。",
      "time_min": 2,
      "heat": "无火",
      "tip": "香油一定要最后淋进去，香气才会浮在表面不散。",
      "visual_cue": "表面浮一层油光，姜末均匀悬浮"
    },
    {
      "n": 7,
      "text": "皮蛋瓣码在盘中摆成花瓣形，把姜汁均匀浇在每一瓣上。",
      "time_min": 2,
      "heat": "无火",
      "tip": "浇汁要一片片淋，整盘倒下去底下的瓣就泡得发咸。",
      "visual_cue": "每瓣表面都挂着酱汁与姜末"
    },
    {
      "n": 8,
      "text": "静置五分钟让味道渗进去，撒上葱花即可上桌。",
      "time_min": 5,
      "heat": "无火",
      "tip": "静置一会儿姜的辛香与醋味才融得住，拌好立刻吃会偏冲。",
      "visual_cue": "盘中酱汁略被吸收，葱绿点点"
    }
  ],
  "tips": [
    "皮蛋挑胶质透亮、捏着有弹性的，发白发硬的碱味重。",
    "怕碱味可以先把皮蛋蒸五分钟再切，口感更温润。",
    "姜末换成嫩姜，辛辣感更柔和，适合不嗜辣的人。",
    "这道菜凉着吃最合适，上桌前再浇汁。"
  ],
  "common_mistakes": [
    "用刀直接切皮蛋，溏心粘刀把切面全糊住。",
    "姜末磨得太粗，吃起来一颗颗扎口还发苦。",
    "酱汁提前久泡，皮蛋被醋泡得发硬失去溏心感。"
  ],
  "substitutions": [
    {
      "original": "皮蛋",
      "substitute": "咸蛋",
      "ratio": "180克:180克",
      "note": "咸味更重，盐可以完全不放。"
    },
    {
      "original": "香醋",
      "substitute": "米醋",
      "ratio": "15毫升:15毫升",
      "note": "酸味更清，颜色更浅。"
    }
  ],
  "variations": [
    "加一勺镇江香醋与少许姜丝，做成更传统的镇江口味。",
    "把皮蛋与嫩豆腐同盘，做成皮蛋豆腐双拼。"
  ],
  "serving_suggestion": "当作开胃冷盘上桌，用筷子夹起一瓣蘸盘底的姜汁，配粥或黄酒都合适。",
  "storage": "拌好的皮蛋当天吃完，冷藏不超过一天，久放会出水变硬。",
