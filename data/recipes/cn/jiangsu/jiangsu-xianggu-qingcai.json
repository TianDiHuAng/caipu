  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "小白菜",
          "name_en": "bok choy",
          "amount": 400,
          "unit": "g",
          "note": "洗净切段",
          "optional": false
        },
        {
          "name": "香菇",
          "name_en": "shiitake mushroom",
          "amount": 150,
          "unit": "g",
          "note": "鲜香菇切片",
          "optional": false
        }
      ]
    },
    {
      "group": "seasoning",
      "items": [
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 30,
          "unit": "ml",
          "note": "炒制",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 10,
          "unit": "ml",
          "note": "提鲜",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 2,
          "unit": "g",
          "note": "提味",
          "optional": false
        },
        {
          "name": "玉米淀粉",
          "name_en": "cornstarch",
          "amount": 8,
          "unit": "g",
          "note": "勾薄芡",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "炒锅",
    "锅铲",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "小白菜掰开叶片，在流水下逐片冲洗干净泥沙。",
      "time_min": 8,
      "heat": "无火",
      "tip": "菜梗根部最容易藏泥，要掰开一片片洗。",
      "visual_cue": "叶片干净，根部不见泥点"
    },
    {
      "n": 2,
      "text": "洗好的青菜沥干水分，切成五厘米长的段备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "带水下锅会炒出一锅汤，菜色也跟着发黄难看。",
      "visual_cue": "菜段长短整齐，表面无水珠"
    },
    {
      "n": 3,
      "text": "鲜香菇切去根部硬蒂，斜刀切成三毫米厚的薄片。",
      "time_min": 5,
      "heat": "无火",
      "tip": "斜切面积大，炒的时候更容易出香出水。",
      "visual_cue": "香菇片厚薄一致，菌褶朝下"
    },
    {
      "n": 4,
      "text": "炒锅大火烧热放花生油，下香菇片中火煸三分钟。",
      "time_min": 3,
      "heat": "中火",
      "tip": "把香菇的水分煸出来再收回去，香味才浓。",
      "visual_cue": "香菇片边缘微焦，锅里香气浓郁"
    },
    {
      "n": 5,
      "text": "加生抽与白糖快速翻匀，让每片香菇都裹上酱色。",
      "time_min": 1,
      "heat": "大火",
      "tip": "生抽顺着锅边淋下去，遇热激出的酱香更足。",
      "visual_cue": "香菇片呈浅褐色，油光发亮"
    },
    {
      "n": 6,
      "text": "转大火下青菜段快速翻炒，炒到菜梗略软断生。",
      "time_min": 2,
      "heat": "大火",
      "tip": "青菜一定要大火，火小了会出水发黄。",
      "visual_cue": "菜梗颜色转深绿，叶片略塌"
    },
    {
      "n": 7,
      "text": "玉米淀粉加清水调匀，沿锅边淋进去勾一层薄芡。",
      "time_min": 1,
      "heat": "大火",
      "tip": "薄芡能把汤汁裹在菜上，不至于盘底一汪水。",
      "visual_cue": "汤汁透明微稠，裹在菜叶表面"
    },
    {
      "n": 8,
      "text": "加盐调味快速翻匀，立即起锅装盘趁热吃最香。",
      "time_min": 1,
      "heat": "大火",
      "tip": "盐一定要最后放，放早了青菜会出水变得软塌。",
      "visual_cue": "菜色翠绿油亮，盘中不见多余汤汁"
    }
  ],
  "tips": [
    "香菇选肉厚的鲜菇，口感比干货更弹。",
    "青菜洗完一定要沥干，否则炒成一锅汤。",
    "想更鲜一点可以加一小勺蚝油，同时把盐减半。",
    "全程保持大火，锅气足才不出水。"
  ],
  "common_mistakes": [
    "青菜带水下锅，最后整盘泡在一汪汤里。",
    "香菇没煸透就下青菜，菌香出不来还发水。",
    "全程小火慢慢炒，青菜发黄发蔫，一点脆感都没有。"
  ],
  "substitutions": [
    {
      "original": "小白菜",
      "substitute": "菠菜",
      "ratio": "400克:400克",
      "note": "菠菜先焯水去草酸再炒。"
    },
    {
      "original": "香菇",
      "substitute": "木耳",
      "ratio": "150克:60克",
      "note": "干木耳泡发后撕小朵。"
    }
  ],
  "variations": [
    "加几片金华火腿一起同炒，咸鲜味会更厚实。",
    "用一勺鸡汤代替生抽调味，整体味道更清雅。"
  ],
  "serving_suggestion": "趁热装盘，青菜翠绿香菇滑嫩，配米饭或粥都清爽。",
  "storage": "当天吃完，青菜隔夜会发黄出水，不建议留。",
