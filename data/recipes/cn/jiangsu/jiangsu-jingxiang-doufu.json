  "equipment": [
    "炒锅",
    "平底锅",
    "刀",
    "砧板",
    "小勺",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成六块三厘米厚的长方块，用厨房纸吸干表面水分备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "块要方正厚实三厘米，挖空后才立得住，薄了烧时就塌。",
      "visual_cue": "豆腐块表面干爽，棱角分明。"
    },
    {
      "n": 2,
      "text": "猪肉末加生抽、料酒、白糖、盐和白胡椒，顺一个方向搅到起胶成馅。",
      "time_min": 6,
      "heat": "无火",
      "tip": "肉馅搅上劲再塞，煎的时候才不会掉出来。",
      "visual_cue": "肉馅发亮抱团，按下去有弹性。"
    },
    {
      "n": 3,
      "text": "平底锅放植物油烧到六成热，豆腐块小火煎到六面金黄，起一层硬壳盛出。",
      "time_min": 10,
      "heat": "中小火",
      "tip": "煎出硬壳再挖空，豆腐才不散不塌，油温六成热最合适。",
      "visual_cue": "六面金黄，筷子敲上去有脆响。"
    },
    {
      "n": 4,
      "text": "豆腐块从侧面切去一小片，用小勺挖出中间部分，做成带盖的小箱。",
      "time_min": 8,
      "heat": "无火",
      "tip": "四壁留半厘米厚，挖太薄一烧就破，箱底尤其要留足。",
      "visual_cue": "箱体空心规整，箱壁厚薄一致。"
    },
    {
      "n": 5,
      "text": "把肉馅塞进箱内，上面压一只虾仁，切口抹玉米淀粉，盖上豆腐片封口。",
      "time_min": 8,
      "heat": "无火",
      "tip": "封口抹淀粉糊，烧时箱盖才不会翻起。",
      "visual_cue": "箱盖严丝合缝，虾仁朝上突出。"
    },
    {
      "n": 6,
      "text": "炒锅放清水、生抽和剩余虾仁烧开，豆腐箱小火煨八分钟，勾芡撒葱花。",
      "time_min": 10,
      "heat": "小火",
      "tip": "煨时别翻动，晃锅让汤汁流动就够，翻一次箱盖就散了。",
      "visual_cue": "汤汁变稠裹住豆腐，虾仁转红。"
    }
  ],
  "tips": [
    "豆腐选老一点的北豆腐，嫩豆腐一煎就碎，做不成箱形。",
    "挖出的豆腐碎别丢，拌进肉馅里更嫩，也更省料。",
    "虾仁一半剁馅一半留整，口感有层次，卖相也好。"
  ],
  "common_mistakes": [
    "豆腐没吸干水就下锅，油花四溅还煎不出硬壳。",
    "箱壁挖得太薄，烧的时候塌陷变形，馅也漏出来。",
    "勾芡过早，汤汁糊在锅底，豆腐还没入味。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "蟹肉",
      "ratio": "1:1",
      "note": "蟹肉更鲜甜，用量减一成，免得太抢味。"
    },
    {
      "original": "猪肉末",
      "substitute": "鸡肉末",
      "ratio": "1:1",
      "note": "鸡肉瘦，需多加五毫升植物油保持嫩度。"
    }
  ],
  "variations": [
    "无锡老做法会用鸡汤代替清水煨制，鲜味更厚，汤汁也更浓。",
    "有的店家在封口前塞入一小块蟹黄，蒸后油润通红，卖相更讲究。"
  ],
  "serving_suggestion": "整箱上桌，用勺连汁挖着吃，配一碗米饭或清汤面都合适。",
  "storage": "冷藏可存两日，复热用蒸锅八分钟，别用微波炉久加热会散。",
