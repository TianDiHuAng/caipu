  "equipment": [
    "汤锅",
    "炒锅",
    "刀",
    "砧板",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鲫鱼刮鳞去内脏，撕掉腹内黑膜，鱼身两面各划两刀。",
      "time_min": 7,
      "heat": "无火",
      "tip": "黑膜不去汤会发苦，一定要刮干净。",
      "visual_cue": "鱼身干净无血污，刀口整齐"
    },
    {
      "n": 2,
      "text": "鱼身抹上料酒和少许盐，腹内塞姜片和小葱结腌一会。",
      "time_min": 5,
      "heat": "无火",
      "tip": "腌十分钟，腥味去得更彻底，别超半小时。",
      "visual_cue": "鱼身微湿，闻到酒香"
    },
    {
      "n": 3,
      "text": "炒锅烧热倒植物油，用姜片擦一遍锅底再下鱼。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "姜片擦锅能防粘皮，鱼皮才完整。",
      "visual_cue": "鱼下锅不粘，边缘发出声响"
    },
    {
      "n": 4,
      "text": "中大火把鱼两面煎到金黄定型，别频繁翻动。",
      "time_min": 8,
      "heat": "中大火",
      "tip": "一面煎定型再翻，翻早了鱼皮全破。",
      "visual_cue": "鱼皮金黄起皱，鱼身挺立"
    },
    {
      "n": 5,
      "text": "冲入滚开的清水，加姜片大火煮到汤色发白。",
      "time_min": 10,
      "heat": "大火",
      "tip": "必须用滚水，冷水冲汤色永远白不了。",
      "visual_cue": "汤色由清转乳白，浮起油花"
    },
    {
      "n": 6,
      "text": "转中火放入豆腐块，轻轻推动，煮到豆腐浮起。",
      "time_min": 10,
      "heat": "中火",
      "tip": "豆腐沿锅边滑入，别直接砸进汤里。",
      "visual_cue": "豆腐块完整，汤面微滚"
    },
    {
      "n": 7,
      "text": "加盐和白胡椒调味，撒葱花，关火盛出装碗。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盐最后放，早放鱼肉会紧缩变柴。",
      "visual_cue": "汤色奶白，葱花翠绿浮面"
    }
  ],
  "tips": [
    "煎鱼前用姜片擦锅，鱼皮完整不粘。",
    "必须冲滚水，汤色才能熬成奶白。",
    "盐最后放，鱼肉才嫩不紧，汤也更清甜。"
  ],
  "common_mistakes": [
    "用冷水冲鱼，汤色始终清汤寡水。",
    "频繁翻动鱼身，煎完只剩碎块和破皮。",
    "大火久煮豆腐，全碎成渣沉在锅底。"
  ],
  "substitutions": [
    {
      "original": "鲫鱼",
      "substitute": "黑鱼",
      "ratio": "600 克:600 克",
      "note": "肉质更紧，刺少，煎制时间延长两分钟。"
    },
    {
      "original": "豆腐",
      "substitute": "冻豆腐",
      "ratio": "300 克:300 克",
      "note": "更吸汤，需提前解冻挤干水分。"
    }
  ],
  "variations": [
    "加一把枸杞同煮，汤色好看，也带点清甜。",
    "起锅前淋几滴香油，香气更柔和。"
  ],
  "serving_suggestion": "连汤带料盛入大碗，先喝一口原汤，再吃鱼和豆腐。",
  "storage": "冷藏一天，复热小火加热到滚，别反复烧开否则鱼肉散。",
