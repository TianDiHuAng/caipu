  "equipment": [
    "炒锅",
    "漏勺",
    "大盆",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "草鱼去鳞去内脏洗净，横切成两厘米厚的块，加姜片和料酒抓匀腌十五分钟。",
      "time_min": 18,
      "heat": "无火",
      "tip": "鱼块厚薄必须一致，下锅炸的时候熟度才同步",
      "visual_cue": "鱼块切得齐整，表面干爽不粘手"
    },
    {
      "n": 2,
      "text": "小锅放清水、生抽、老抽、冰糖、米醋、八角和桂皮，小火熬二十分钟成卤汁。",
      "time_min": 20,
      "heat": "小火",
      "tip": "卤汁熬到只剩原来三分之二，味道才够浓够厚",
      "visual_cue": "卤汁深红透亮，香气浓郁扑鼻"
    },
    {
      "n": 3,
      "text": "腌好的鱼块用厨房纸吸干表面水分，避免下油锅时爆油。",
      "time_min": 4,
      "heat": "无火",
      "tip": "鱼皮一定要擦到干透，带水下锅会油星四溅",
      "visual_cue": "鱼块表面干爽，一点水汽都没有"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到七成热，鱼块分批下锅，炸五分钟到外壳金黄捞出。",
      "time_min": 7,
      "heat": "大火",
      "tip": "一次别下太多鱼块，油温一掉鱼就炸得软塌",
      "visual_cue": "外壳炸到金黄，鱼块挺实不下塌"
    },
    {
      "n": 5,
      "text": "全部炸完后再把油烧热，鱼块回锅复炸一分钟，逼出多余油分，捞出沥油。",
      "time_min": 3,
      "heat": "大火",
      "tip": "复炸一分钟能让外壳更脆，浸卤后也不容易散",
      "visual_cue": "外壳酥硬，用筷子敲上去有响声"
    },
    {
      "n": 6,
      "text": "趁热把鱼块浸进放凉的卤汁里，泡三分钟翻面再泡两分钟，捞出装盘。",
      "time_min": 6,
      "heat": "无火",
      "tip": "趁着热鱼进冷卤，一冷一热汁水才吸得进去",
      "visual_cue": "鱼块挂满卤汁，颜色红亮油润"
    }
  ],
  "tips": [
    "卤汁一定要提前熬好并放凉，热卤泡鱼会把外壳泡软。",
    "鱼块复炸这一步不能省，外壳够脆，浸卤后才不会烂成糊。",
    "喜欢甜口的可以把冰糖加到六十克，江浙人吃熏鱼讲究甜出头、咸收口。"
  ],
  "common_mistakes": [
    "鱼块带水下油锅，热油飞溅，鱼皮也被炸破，卖相差。",
    "油温不够就下鱼，鱼块吸饱油，吃着腻，也不脆。",
    "卤汁是热的就泡鱼，外壳立刻回软，成品软塌塌没有口感。"
  ],
  "substitutions": [
    {
      "original": "草鱼",
      "substitute": "鲈鱼",
      "ratio": "800克:800克",
      "note": "鲈鱼肉嫩，炸的时间减到四分钟。"
    },
    {
      "original": "冰糖",
      "substitute": "白糖",
      "ratio": "45克:40克",
      "note": "白糖色浅，可加两毫升老抽补色。"
    }
  ],
  "variations": [
    "卤汁里加一小勺五香粉，香气更像老式熏鱼，配粥一流。",
    "把鱼换成带鱼段，做成熏带鱼，骨少肉厚，孩子也能吃。"
  ],
  "serving_suggestion": "冷吃热吃都行，冷后入味更足，配黄酒或白粥，是江南人待客的冷盘。",
  "storage": "冷藏可放三天，取出直接冷食，不要回锅加热，回热外壳会软。",
