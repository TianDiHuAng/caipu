          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "香油",
          "name_en": "sesame oil",
          "amount": 8,
          "unit": "ml",
          "note": "增香",
          "optional": false
        },
        {
          "name": "花生油",
          "name_en": "peanut oil",
          "amount": 15,
          "unit": "ml",
          "note": "泼辣段",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "漏勺",
    "拌盆",
    "砧板"
  ],
  "steps": [
    {
      "n": 1,
      "text": "莲藕削去外皮，切掉两头的节，露出洁白的藕身。",
      "time_min": 6,
      "heat": "无火",
      "tip": "两头的节老硬又多泥，切掉一截口感才好。",
      "visual_cue": "藕身洁白光滑，切口平整"
    },
    {
      "n": 2,
      "text": "顺着藕孔切成两毫米厚的薄片，尽量切得均匀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "厚薄一致才能一起熟，切太厚中间会夹生口感差。",
      "visual_cue": "藕片薄而透光，孔洞完整"
    },
    {
      "n": 3,
      "text": "切好的藕片立刻泡进清水，防止接触空气变黑。",
      "time_min": 2,
      "heat": "无火",
      "tip": "藕遇空气就发黑，泡水这一步别偷懒。",
      "visual_cue": "藕片浸在水中，颜色保持洁白"
    },
    {
      "n": 4,
      "text": "汤锅烧开水后滴几滴米醋，再下藕片焯两分钟。",
      "time_min": 4,
      "heat": "大火",
      "tip": "加醋焯能让藕片更白更脆，不易发黏。",
      "visual_cue": "藕片由白转半透明，边缘略卷"
    },
    {
      "n": 5,
      "text": "捞出藕片立刻放进凉水里，彻底凉透再沥干水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过凉水是为了锁住脆感，热着拌会发软。",
      "visual_cue": "藕片凉透，咬起来清脆有声"
    },
    {
      "n": 6,
      "text": "干辣椒段放碗里，烧热花生油泼上去激出香味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油要烧到微微冒烟再泼，辣椒香才出来。",
      "visual_cue": "辣椒段颜色变深，油面浮起香气"
    },
    {
      "n": 7,
      "text": "藕片放进拌盆，加米醋、白糖、盐与香油拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先放白糖搅到化开再放米醋，酸甜味才融得匀。",
      "visual_cue": "藕片裹上浅色汁水，油光发亮"
    },
    {
      "n": 8,
      "text": "淋上泼好的辣椒油，撒葱花再拌一遍即可装盘。",
      "time_min": 2,
      "heat": "无火",
      "tip": "辣椒油一定要最后加，颜色才鲜亮不会发暗。",
      "visual_cue": "藕片白亮，缀着红辣椒与绿葱花"
    }
  ],
  "tips": [
    "藕选七孔藕更脆，九孔藕偏粉不适合凉拌。",
    "焯水别超过两分钟，久了就不脆了。",
    "拌好放冰箱冰十分钟，口感更爽。",
    "喜欢麻口味的可以另外加几滴现炸的花椒油。"
  ],
  "common_mistakes": [
    "藕片切好放着不泡水，切面全变黑褐色。",
    "焯水时间太久，藕片软塌塌的一点脆劲都没有。",
    "热藕片直接拌，调料吃不进去还出水。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "香醋",
      "ratio": "25毫升:25毫升",
      "note": "酸味更柔，颜色会略深。"
    },
    {
      "original": "莲藕",
      "substitute": "荸荠",
      "ratio": "400克:300克",
      "note": "切片后不用焯太久，一分钟即可。"
    }
  ],
  "variations": [
    "加一把泡发的木耳同拌，口感更有层次。",
    "拌好撒上一把炒香的熟芝麻，香气更足也好看。"
  ],
  "serving_suggestion": "冰镇后装盘，作为开胃小菜先上，酸甜脆爽最解腻。",
  "storage": "冷藏一天，隔夜后藕片会吸汁变咸，吃前可补几片新藕。",
