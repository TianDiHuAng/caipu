          "unit": "g",
          "note": "剪成小段",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 10,
          "unit": "g",
          "note": "切葱花",
          "optional": false
        }
      ]
    },
    {
