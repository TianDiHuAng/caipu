  "equipment": [
    "汤锅",
    "漏勺",
    "砧板",
    "拌菜盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "芦蒿择去叶子和发硬的根部，只留下手指长的嫩茎部分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "根部用手一折就断的位置以下全是老梗，留着嚼不烂。",
      "visual_cue": "嫩段整齐，掐断处能见水润断面"
    },
    {
      "n": 2,
      "text": "把嫩茎放进清水里泡五分钟，再冲洗两遍去掉泥沙。",
      "time_min": 7,
      "heat": "无火",
      "tip": "芦蒿贴地生长，叶腋处最容易藏泥沙，要逐根搓洗。",
      "visual_cue": "水面无浮泥，茎身颜色鲜亮"
    },
    {
      "n": 3,
      "text": "汤锅烧开一大锅水，加一小勺盐和几滴花生油。",
      "time_min": 4,
      "heat": "大火",
      "tip": "加盐加油能锁住颜色，焯出来的茎梗翠绿不发黄。",
      "visual_cue": "水面翻滚，浮着一层薄油"
    },
    {
      "n": 4,
      "text": "芦蒿下锅焯四十秒，茎身变深绿立刻用漏勺捞出。",
      "time_min": 1,
      "heat": "大火",
      "tip": "时间一长就软塌失脆，宁可欠一点也不要过。",
      "visual_cue": "茎身由浅绿转为鲜亮的深绿"
    },
    {
      "n": 5,
      "text": "捞出后马上放进冰水里浸泡两分钟，彻底过凉。",
      "time_min": 3,
      "heat": "无火",
      "tip": "冰水定色又定脆，是凉拌菜不发黄的关键一步。",
      "visual_cue": "茎梗挺直有脆感，颜色更翠"
    },
    {
      "n": 6,
      "text": "沥干水分，切成四厘米长的段，码进拌菜盆里。",
      "time_min": 3,
      "heat": "无火",
      "tip": "切之前要甩干水，带水拌出来底下一汪汤。",
      "visual_cue": "段长均匀，盆底不见积水"
    },
    {
      "n": 7,
      "text": "小锅把花生油烧到微微冒烟，趁热泼在蒜末与葱花上。",
      "time_min": 2,
      "heat": "大火",
      "tip": "油温不够激不出蒜香，泼完能听到细密的滋啦声。",
      "visual_cue": "蒜末边缘卷起，香味立刻散开"
    },
    {
      "n": 8,
      "text": "碗里加生抽、香油、盐与白糖调匀，倒入芦蒿轻轻拌匀。",
      "time_min": 2,
      "heat": "无火",
      "tip": "拌的时候用筷子挑着翻，压着拌会把茎梗压出水。",
      "visual_cue": "茎段表面油亮，颜色翠绿"
    }
  ],
  "tips": [
    "芦蒿越新鲜越脆，买回来当天吃最好。",
    "喜欢蒜味重可以把一半蒜末留生的，拌进去更冲。",
    "焯水锅要大、水要多，下菜后水温才不掉。",
    "拌好后冷藏十分钟再吃，口感更清爽。"
  ],
  "common_mistakes": [
    "芦蒿焯水时间过长，捞出来软塌成一根根草。",
    "焯完不投凉水，余温把茎梗闷黄发蔫。",
    "带着水下调味，拌好一会儿盆底就积了一层汤。"
  ],
  "substitutions": [
    {
      "original": "芦蒿",
      "substitute": "茼蒿",
      "ratio": "300克:300克",
      "note": "香气更冲，焯水时间减到三十秒。"
    },
    {
      "original": "花生油",
      "substitute": "香油",
      "ratio": "15毫升:12毫升",
      "note": "直接用香油拌，省去泼油一步。"
    }
  ],
  "variations": [
    "加一把焯过的豆干丝同拌，口感更丰富。",
    "换成蒜泥加香醋的调味，做成酸香版本。"
  ],
  "serving_suggestion": "装盘后即可上桌，作为油腻主菜前的开胃小碟，配粥或配饭都清爽。",
  "storage": "冷藏保存一天，吃前把析出的水倒掉再补几滴香油拌匀。",
