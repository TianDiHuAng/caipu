    "剪刀",
    "漏勺"
  ],
  "steps": [
    {
      "n": 1,
      "text": "虾剪去须脚与额剑，用牙签从背部第二节挑出泥肠，冲洗干净后沥干水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "泥肠不挑干净会有沙腥味。",
      "visual_cue": "虾身干净、背部无黑线"
    },
    {
      "n": 2,
      "text": "姜切细丝，葱切段；生抽、白糖、料酒、米醋、盐加两勺清水调成味汁备用。",
      "time_min": 4,
      "heat": "无火",
      "tip": "味汁先调好，下锅才不手忙脚乱。",
      "visual_cue": "味汁均匀、糖已化开"
    },
    {
      "n": 3,
      "text": "炒锅倒入植物油烧到七成热，虾分批下锅炸三十秒，壳变红立即捞出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油要够热，虾壳一炸就脆。",
      "visual_cue": "虾壳鲜红、虾身卷曲"
    },
    {
      "n": 4,
      "text": "锅留少许底油，下姜丝与葱段小火煸出香味。",
      "time_min": 2,
      "heat": "中火",
      "tip": "底油别多，否则成菜发腻。",
      "visual_cue": "姜丝微黄、葱香散出"
    },
    {
      "n": 5,
      "text": "倒回虾，沿锅边淋入味汁，大火快速翻炒让酱汁裹住每只虾。",
      "time_min": 3,
      "heat": "大火",
      "tip": "大火快翻，虾肉才不老。",
      "visual_cue": "虾身油亮、酱汁均匀挂壳"
    },
    {
      "n": 6,
      "text": "汤汁收到浓稠冒大泡时关火，装盘后把锅底余汁淋在虾上。",
      "time_min": 1,
      "heat": "大火",
      "tip": "收汁别收干，留一点浇面更香。",
      "visual_cue": "盘底见少量红亮汤汁"
    }
  ],
  "tips": [
    "虾买回来先养在清水里吐净泥沙，鲜味更纯。",
    "爆虾的油温要够高，虾壳酥脆才连壳一起吃。",
    "甜度按口味调，苏式偏甜可把白糖加到十二克。"
  ],
  "common_mistakes": [
    "虾没沥干就下油锅，热油爆溅烫手。",
    "炸的时间过长，虾肉收紧发柴，壳也不脆了。",
    "味汁一次性倒太多，虾泡在汤里不脆。"
  ],
  "substitutions": [
    {
      "original": "虾",
      "substitute": "河虾仁",
      "ratio": "400g 对 300g",
      "note": "虾仁易熟，炸十秒即可。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "8g 对 10g",
      "note": "冰糖化开后汤汁更亮。"
    }
  ],
  "variations": [
    "加一勺番茄酱同炒，做成酸甜口的番茄爆虾。",
    "出锅前撒一把白芝麻，香气和卖相都更足。"
  ],
  "serving_suggestion": "连壳一起吃，配一碗白粥或当作下酒菜都合适。",
  "storage": "冷藏一天，复热用炒锅干煸一分钟恢复脆感。",
