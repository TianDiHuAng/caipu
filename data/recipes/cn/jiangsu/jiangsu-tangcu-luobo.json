  "equipment": [
    "玻璃罐",
    "刀",
    "砧板",
    "小锅",
    "重物"
  ],
  "steps": [
    {
      "n": 1,
      "text": "白萝卜去皮切成三毫米厚薄片，撒盐抓匀后静置一小时，让萝卜片出水变软。",
      "time_min": 62,
      "heat": "无火",
      "tip": "盐抓匀后压个盘子，出水更快，脆度也更好。",
      "visual_cue": "萝卜片变软弯曲，盆底积出淡盐水。"
    },
    {
      "n": 2,
      "text": "把萝卜片挤干水分，摊在干净纱布上压重物半小时，再挤一次水备用。",
      "time_min": 35,
      "heat": "无火",
      "tip": "水挤得越干，腌好越脆，也不容易发酸。",
      "visual_cue": "萝卜片干瘪透明，捏不出水。"
    },
    {
      "n": 3,
      "text": "小锅放清水、白糖和生抽小火煮到糖化开，关火后倒入米醋搅匀晾凉。",
      "time_min": 8,
      "heat": "小火",
      "tip": "醋要关火后再加，煮过的醋香味会散掉。",
      "visual_cue": "糖汁清亮微稠，酸香不冲鼻。"
    },
    {
      "n": 4,
      "text": "干辣椒剪段、大蒜切片，与萝卜片一起装进无水无油的玻璃罐。",
      "time_min": 5,
      "heat": "无火",
      "tip": "罐子必须无水无油，有一滴水就容易起白花。",
      "visual_cue": "萝卜片层层叠紧，辣椒段夹在中间。"
    },
    {
      "n": 5,
      "text": "倒入晾凉的糖醋汁，汁要没过萝卜片，盖盖冷藏腌两小时以上。",
      "time_min": 120,
      "heat": "无火",
      "tip": "汁不够就补点米醋和凉白开，别加自来水。",
      "visual_cue": "液面高出萝卜片一指，颜色透亮。"
    },
    {
      "n": 6,
      "text": "腌好的萝卜片夹出码盘，淋两勺原汁，冷藏状态下当冷盘上桌。",
      "time_min": 3,
      "heat": "无火",
      "tip": "夹取要用干净无水的筷子，沾了生水整罐都容易坏。",
      "visual_cue": "萝卜片半透明，汁色淡金。"
    }
  ],
  "tips": [
    "萝卜片别切太薄，三毫米最合适，腌后仍有脆劲。",
    "糖醋汁可以一次多熬些，冷藏备用，腌黄瓜、嫩姜都好用。",
    "想吃更酸爽，腌一夜再吃，酸味会明显更透。"
  ],
  "common_mistakes": [
    "萝卜片盐杀水后没挤干就泡汁，成品发软、汁水很快变浑。",
    "糖醋汁趁热倒进罐里，萝卜被烫软，脆劲全无。",
    "罐子带生水，腌两三天就起白沫发酸。"
  ],
  "substitutions": [
    {
      "original": "米醋",
      "substitute": "白醋",
      "ratio": "1:1",
      "note": "白醋酸味更直，白糖多加十克平衡。"
    },
    {
      "original": "白萝卜",
      "substitute": "胡萝卜",
      "ratio": "1:1",
      "note": "胡萝卜质地硬，杀水时间延长二十分钟。"
    }
  ],
  "variations": [
    "镇江家庭常把萝卜切成连刀片再腌，摆盘展开像扇面，卖相更讲究。",
    "有的做法加几粒花椒同腌，麻香淡淡，配粥特别开胃。"
  ],
  "serving_suggestion": "冷藏后取一小碟佐粥或配油腻的红烧菜，酸甜脆爽最解腻。",
  "storage": "密封冷藏可存两周，取用时用干净无水的筷子，汁水变浑就不要再吃。",
