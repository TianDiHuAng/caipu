  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "面粉",
          "name_en": "all-purpose flour",
          "amount": 220,
          "unit": "g",
          "note": "中筋",
          "optional": false
        },
        {
          "name": "黄油",
          "name_en": "butter",
          "amount": 130,
          "unit": "g",
          "note": "冷藏切丁",
          "optional": false
        },
        {
          "name": "鸡蛋",
          "name_en": "egg",
          "amount": 150,
          "unit": "g",
          "note": "塔水用",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "牛奶",
          "name_en": "milk",
          "amount": 120,
          "unit": "ml",
          "note": "塔水",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 80,
          "unit": "g",
          "note": "化开",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 200,
          "unit": "ml",
          "note": "塔水与面团",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 1,
          "unit": "g",
          "note": "提味",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "烤箱",
    "蛋挞模",
    "擀面杖",
    "盆"
  ],
  "steps": [
    {
      "n": 1,
      "text": "黄油丁和面粉用手搓成粗砂状，加一克盐和五十毫升清水揉成面团。",
      "time_min": 10,
      "heat": "无火",
      "tip": "黄油要冰凉，手温一化酥皮就不起层。",
      "visual_cue": "面团粗糙但能成团"
    },
    {
      "n": 2,
      "text": "面团包好冷藏三十分钟，让黄油重新变硬定型。",
      "time_min": 30,
      "heat": "无火",
      "tip": "冷藏足时间，擀的时候才不粘手。",
      "visual_cue": "面团变硬，按压不回弹"
    },
    {
      "n": 3,
      "text": "面团分成十二份，每份压进蛋挞模，从底部往边缘推成薄壳。",
      "time_min": 12,
      "heat": "无火",
      "tip": "边缘一定要推薄一些，烤完才酥不厚重。",
      "visual_cue": "壳厚薄均匀，贴合模具"
    },
    {
      "n": 4,
      "text": "白糖加一百五十毫升清水小火煮到糖化，晾到温热。",
      "time_min": 5,
      "heat": "小火",
      "tip": "糖水别煮沸太久，水少了塔水会偏甜。",
      "visual_cue": "糖水清澈，没有糖粒"
    },
    {
      "n": 5,
      "text": "鸡蛋打散倒入糖水和牛奶搅匀，过筛两遍去掉泡沫。",
      "time_min": 6,
      "heat": "无火",
      "tip": "一定要过筛，泡沫会让塔面粗糙。",
      "visual_cue": "塔水淡黄且顺滑无泡"
    },
    {
      "n": 6,
      "text": "塔水倒进挞壳七分满，摆进烤盘送入预热好的烤箱。",
      "time_min": 4,
      "heat": "无火",
      "tip": "只能倒七分满，烤时会膨胀溢出。",
      "visual_cue": "液面平稳，无气泡"
    },
    {
      "n": 7,
      "text": "两百度烤十分钟让酥皮起层，转一百八十度烤十二分钟到塔面凝固。",
      "time_min": 23,
      "heat": "中火",
      "tip": "先高温起酥再降温，塔面才光滑不裂。",
      "visual_cue": "塔面光滑微颤，边缘金黄"
    },
    {
      "n": 8,
      "text": "出炉放五分钟再脱模，温热时吃酥皮最脆，凉后回软。",
      "time_min": 6,
      "heat": "无火",
      "tip": "稍晾一会儿，热的时候脱模容易碎。",
      "visual_cue": "挞壳脱模完整，酥皮分层"
    }
  ],
  "tips": [
    "黄油保持冰凉，酥皮烤完才有明显的层次。",
    "塔水过筛两遍，塔面才会像镜面一样光滑。",
    "先高温后降温，酥皮起层而塔水不裂。"
  ],
  "common_mistakes": [
    "黄油软化了才搓，烤完酥皮硬成一块。",
    "塔水倒太满，烤的时候全溢在烤盘上。",
    "只用高温烤到底，塔面全部开裂。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "淡奶油",
      "ratio": "120 毫升:120 毫升",
      "note": "更香浓，白糖可减十克。"
    },
    {
      "original": "黄油",
      "substitute": "起酥油",
      "ratio": "130 克:130 克",
      "note": "起层更明显，风味偏淡。"
    }
  ],
  "variations": [
    "塔水里加几滴香草精，香气更像茶餐厅版本。",
    "表面撒少许肉桂粉，风味更有层次。"
  ],
  "serving_suggestion": "温热时配一杯港式奶茶，是香港茶餐厅下午茶的固定组合。",
  "storage": "常温放一天，冷藏两天，回脆用一百六十度烤五分钟。",
