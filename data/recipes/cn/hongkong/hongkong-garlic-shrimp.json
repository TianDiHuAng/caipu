      "items": [
        {
          "name": "大蒜",
          "name_en": "garlic",
          "amount": 40,
          "unit": "g",
          "note": "切末",
          "optional": false
        },
        {
          "name": "生抽",
          "name_en": "light soy sauce",
          "amount": 20,
          "unit": "ml",
          "note": "调味",
          "optional": false
        },
        {
          "name": "植物油",
          "name_en": "vegetable oil",
          "amount": 40,
          "unit": "ml",
          "note": "泼蒜",
          "optional": false
        },
        {
          "name": "盐",
          "name_en": "salt",
          "amount": 3,
          "unit": "g",
          "note": "调味",
          "optional": false
        },
        {
          "name": "小葱",
          "name_en": "scallion",
          "amount": 15,
          "unit": "g",
          "note": "切花",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "蒸锅",
    "浅盘",
    "炒锅",
    "剪刀"
  ],
  "steps": [
    {
      "n": 1,
      "text": "粉丝用温水泡十五分钟，泡到用手能掐断无硬芯。",
      "time_min": 15,
      "heat": "无火",
      "tip": "泡到发软即可，泡过头蒸完就烂。",
      "visual_cue": "粉丝透亮柔软，折之不断"
    },
    {
      "n": 2,
      "text": "虾仁从背上划开不切断，挑出背上的黑线，保留尾节。",
      "time_min": 8,
      "heat": "无火",
      "tip": "开背既好入味，蒸完也卷成漂亮花形。",
      "visual_cue": "虾仁背翻开，背上的黑线完整抽出"
    },
    {
      "n": 3,
      "text": "处理好的虾仁再冲洗一遍，用厨纸吸干表面水分。",
      "time_min": 3,
      "heat": "无火",
      "tip": "沥干水，蒸出来才不出汤。",
      "visual_cue": "虾仁干爽，尾巴完整"
    },
    {
      "n": 4,
      "text": "粉丝剪成短段铺在盘底，摊成厚薄均匀的一层。",
      "time_min": 3,
      "heat": "无火",
      "tip": "铺平受热均匀，也托得住虾仁。",
      "visual_cue": "盘底粉丝平展，厚度一致"
    },
    {
      "n": 5,
      "text": "虾仁背朝上摆在粉丝上，尾巴立起来摆成扇形。",
      "time_min": 4,
      "heat": "无火",
      "tip": "摆得松一点，蒸汽才进得去。",
      "visual_cue": "虾仁排列整齐，尾巴翘起"
    },
    {
      "n": 6,
      "text": "蒜末分两份，一份冷油小火炒到金黄，与生蒜合并。",
      "time_min": 6,
      "heat": "小火",
      "tip": "半生半熟蒜，香而不冲，这是关键。",
      "visual_cue": "蒜末一半金黄一半雪白"
    },
    {
      "n": 7,
      "text": "蒜蓉里加盐与生抽拌匀，连油一起铺在虾仁背上。",
      "time_min": 3,
      "heat": "无火",
      "tip": "蒜蓉铺在虾仁背，味道才进得去。",
      "visual_cue": "每只虾仁背都盖着蒜蓉"
    },
    {
      "n": 8,
      "text": "蒸锅里的水大开之后再放入，大火蒸六分钟。",
      "time_min": 6,
      "heat": "大火",
      "tip": "虾仁变红卷曲就熟了，多蒸就老。",
      "visual_cue": "虾仁卷曲通红，蒜香扑鼻"
    },
    {
      "n": 9,
      "text": "出锅撒上葱花，浇一勺烧到冒烟的热植物油激香。",
      "time_min": 3,
      "heat": "无火",
      "tip": "热植物油泼葱花，香气一下被激出来。",
      "visual_cue": "葱绿鲜亮，油在虾仁上滋滋响"
    }
  ],
  "tips": [
    "粉丝先泡软再蒸，干粉丝直接蒸会硬芯。",
    "蒜一半炒香一半生用，香味有层次不冲口。",
    "水大开再上锅，大火六分钟，虾仁肉才弹。"
  ],
  "common_mistakes": [
    "虾仁不开背，蒜蓉只盖在表面，吃不出味。",
    "蒸过头，虾仁缩成一小团，咬着发柴。",
    "蒜蓉全用生蒜，辣味冲，没有那股炒香。"
  ],
  "substitutions": [
    {
      "original": "虾仁",
      "substitute": "基围虾",
      "ratio": "500 克:600 克",
      "note": "带壳蒸更鲜，需剪开虾背。"
    },
    {
      "original": "粉丝",
      "substitute": "河粉",
      "ratio": "80 克:150 克",
      "note": "更宽更滑，蒸的时间多一分钟。"
    }
  ],
  "variations": [
    "加一勺豆豉同蒸，咸香更浓，是港式茶楼常见做法。",
    "底下垫两片丝瓜，吸饱虾仁汁后最鲜甜。"
  ],
  "serving_suggestion": "整盘端上桌，粉丝吸足虾仁汁与蒜香，拌着吃最过瘾。",
  "storage": "现蒸现吃，冷藏不超过一天，复蒸三分钟。",
