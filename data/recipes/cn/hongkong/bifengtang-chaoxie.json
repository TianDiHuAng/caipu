  "equipment": [
    "炒锅",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "肉蟹刷净斩件，蟹钳拍裂，切口处拍上 30g 玉米淀粉封住蟹肉。",
      "time_min": 12,
      "heat": "无火",
      "tip": "切口拍粉，炸时蟹肉才不会流失。",
      "visual_cue": "蟹块切口均匀挂粉"
    },
    {
      "n": 2,
      "text": "炒锅下 250ml 植物油烧至七成热，蟹块分批炸 3 分钟至外壳橙红，捞出沥油。",
      "time_min": 5,
      "heat": "大火",
      "tip": "油温要够，蟹壳才酥、肉才嫩。",
      "visual_cue": "蟹壳红亮、蟹钳开口"
    },
    {
      "n": 3,
      "text": "锅中留 30ml 底油，小火下 80g 大蒜蓉慢炸 5 分钟至金黄酥香，捞出备用。",
      "time_min": 6,
      "heat": "小火",
      "tip": "蒜蓉必须小火慢炸，火大立刻发苦。",
      "visual_cue": "蒜蓉金黄松散、香气扑鼻"
    },
    {
      "n": 4,
      "text": "原锅下豆豉、干辣椒炒 30 秒，倒入 60g 面包糠小火炒至金黄酥脆。",
      "time_min": 3,
      "heat": "小火",
      "tip": "面包糠极易焦，需不停翻动。",
      "visual_cue": "面包糠金黄颗粒分明"
    },
    {
      "n": 5,
      "text": "倒回蟹块与炸蒜蓉，转大火翻炒 1 分钟，加 3g 盐、5g 白糖与 2g 白胡椒炒匀。",
      "time_min": 2,
      "heat": "大火",
      "tip": "大火快炒让金沙裹住蟹壳。",
      "visual_cue": "蟹块表面裹满金黄蒜糠"
    },
    {
      "n": 6,
      "text": "最后下小葱段翻两下立刻出锅，趁热端上桌食用，金沙才够酥脆。",
      "time_min": 1,
      "heat": "大火",
      "tip": "小葱最后放，翠绿不塌。",
      "visual_cue": "葱段青翠、金沙干爽不油"
    }
  ],
  "tips": [
    "大蒜与面包糠的比例约为 4:3，蒜香才压得住蟹味。",
    "炸蒜蓉可一次多做，密封冷藏 3 天随取随用。",
    "吃完蟹剩下的金沙拌饭，是港式的隐藏吃法。"
  ],
  "common_mistakes": [
    "蒜蓉大火炸，几十秒就焦黑发苦。",
    "蟹块不拍粉直接炸，蟹肉失水变干。",
    "面包糠与蟹同炒太久，吸油回软失去酥感。"
  ],
  "substitutions": [
    {
      "original": "蟹",
      "substitute": "大虾",
      "ratio": "900g 蟹 ≈ 700g 大虾",
      "note": "大虾开背去虾线，炸 2 分钟即可。"
    },
    {
      "original": "面包糠",
      "substitute": "馒头屑",
      "ratio": "60g 面包糠 ≈ 80g 馒头屑",
      "note": "馒头屑需晒干搓碎，炒制时间加 1 分钟。"
    }
  ],
  "variations": [
    "家庭简化版：蟹块用空气炸锅 200℃ 烤 10 分钟，省油且不溅。",
    "港式酒楼版：加 15g 虾米碎同炒，鲜味更足。"
  ],
  "serving_suggestion": "大盘装盛，金沙铺满蟹身，配冰啤酒最过瘾。",
  "storage": "现炸现吃最佳，冷藏后金沙回软、风味全失。",
