  "steps": [
    {
      "n": 1,
      "text": "猪里脊顺长切成长条，用叉子在表面扎些小孔，方便腌料渗进去。",
      "time_min": 8,
      "heat": "无火",
      "tip": "扎孔能让味道进到肉芯，不扎只有表面有味。",
      "visual_cue": "肉条表面布满细孔，纤维完整"
    },
    {
      "n": 2,
      "text": "叉烧酱、生抽、老抽、蚝油、白糖、料酒、五香粉与小葱段、蒜姜末一起拌成腌料。",
      "time_min": 6,
      "heat": "无火",
      "tip": "腌料先拌匀再下肉，味道才均匀一致。",
      "visual_cue": "腌料黏稠呈深枣红色，闻着酱香"
    },
    {
      "n": 3,
      "text": "肉条与腌料充分抓匀装盒，冷藏腌制两小时，中途翻面两次。",
      "time_min": 124,
      "heat": "无火",
      "tip": "腌足两小时才入味，赶时间最少也要一小时。",
      "visual_cue": "肉条通体裹酱，颜色深红"
    },
    {
      "n": 4,
      "text": "烤箱预热两百度，肉条架在烤网上，下层垫烤盘接油，先烤二十分钟。",
      "time_min": 22,
      "heat": "中火",
      "tip": "架高烤才受热均匀，贴着烤盘的一面容易糊。",
      "visual_cue": "表面收紧上色，油脂滴落"
    },
    {
      "n": 5,
      "text": "取出翻面刷一层蜂蜜，再烤十分钟，最后再刷一次蜂蜜烤五分钟上色。",
      "time_min": 17,
      "heat": "中火",
      "tip": "蜂蜜要分次刷，一次刷太厚会焦成黑壳。",
      "visual_cue": "表面油亮红润，边缘微焦"
    },
    {
      "n": 6,
      "text": "出炉静置十分钟再切片，逆纹切厚片，摆盘淋少许烤汁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "静置能让肉汁回流，切的时候不流一砧板。",
      "visual_cue": "切面微粉，肉汁饱满不发干"
    }
  ],
  "tips": [
    "选带一点肥边的梅头肉更香，全瘦的里脊口感偏干。",
    "腌料里加一勺南乳，风味更接近老式烧腊。",
    "没有烤箱可用平底锅小火煎，最后刷蜜收汁，效果接近。"
  ],
  "common_mistakes": [
    "腌的时间不够就烤，切开一看中间发白，只有表面有味。",
    "蜂蜜刷太早，糖分在高温下焦化，成品一层黑壳。",
    "烤好立刻切片，肉汁全流走，叉烧吃起来又干又柴。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "梅花肉",
      "ratio": "800克:800克",
      "note": "梅花肉肥瘦相间，烤出来更香更嫩。"
    },
    {
      "original": "蜂蜜",
      "substitute": "麦芽糖",
      "ratio": "40克:40克",
      "note": "麦芽糖挂色更亮，需隔水化开再用。"
    }
  ],
  "variations": [
    "把叉烧切丁包进酥皮，就是港式叉烧酥。",
    "剩下的叉烧切丝炒蛋或做叉烧饭，隔夜更入味。"
  ],
  "serving_suggestion": "切片配白饭与一条青菜就是叉烧饭，也可以夹菠萝包做菠萝叉烧包。",
  "storage": "冷藏可存三天，冷冻一个月，复热须烤箱一百八十度烤五分钟，微波会发柴。",
