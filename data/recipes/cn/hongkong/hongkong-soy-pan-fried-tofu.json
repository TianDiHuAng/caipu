  "equipment": [
    "平底锅",
    "刀",
    "砧板",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "北豆腐切成两厘米厚的片，用厨房纸吸干表面水分。",
      "time_min": 10,
      "heat": "无火",
      "tip": "豆腐吸干水，煎的时候才不粘锅。",
      "visual_cue": "豆腐片干爽，表面无明水"
    },
    {
      "n": 2,
      "text": "平底锅放植物油烧热，豆腐片平铺下锅小火煎。",
      "time_min": 4,
      "heat": "小火",
      "tip": "一片片平铺，别叠着，才煎得均匀。",
      "visual_cue": "豆腐片边缘开始变黄"
    },
    {
      "n": 3,
      "text": "小火煎四分钟到底面金黄，翻面再煎三分钟。",
      "time_min": 8,
      "heat": "小火",
      "tip": "别急着翻面，等底面结壳再动才不碎。",
      "visual_cue": "两面金黄，外壳结硬"
    },
    {
      "n": 4,
      "text": "把煎好的豆腐推到锅边，下大蒜末炒出香味。",
      "time_min": 2,
      "heat": "小火",
      "tip": "蒜末别煎糊，微微发黄就够香了。",
      "visual_cue": "蒜末微黄，香气出来"
    },
    {
      "n": 5,
      "text": "清水、生抽、老抽和白糖调匀，倒进锅里烧开。",
      "time_min": 3,
      "heat": "中火",
      "tip": "汁先调匀再下锅，成品颜色才均匀。",
      "visual_cue": "汤汁浅酱色，微微冒泡"
    },
    {
      "n": 6,
      "text": "中火烧两分钟让豆腐吸进味道，中途翻一次面。",
      "time_min": 4,
      "heat": "中火",
      "tip": "只翻一次面，翻多了豆腐容易破。",
      "visual_cue": "豆腐吸满汤汁，颜色加深"
    },
    {
      "n": 7,
      "text": "淀粉加水调匀淋入勾薄芡，撒上小葱花开火。",
      "time_min": 3,
      "heat": "中火",
      "tip": "芡要薄，挂在豆腐上才亮而不糊。",
      "visual_cue": "汤汁挂亮，葱花翠绿"
    }
  ],
  "tips": [
    "豆腐先用厨房纸吸干水，煎时才不粘锅。",
    "等底面结壳再翻面，豆腐才完整不碎。",
    "芡汁调薄一点，挂汁才亮而不糊。"
  ],
  "common_mistakes": [
    "火太大油又少，豆腐外面焦了里面还凉。",
    "芡勾得太厚，成品像糊上一层浆。",
    "豆腐煎好就出锅，没吸够汤汁不入味。"
  ],
  "substitutions": [
    {
      "original": "北豆腐",
      "substitute": "老豆腐",
      "ratio": "500 克:500 克",
      "note": "质地更紧，煎制不易碎。"
    },
    {
      "original": "白糖",
      "substitute": "冰糖",
      "ratio": "8 克:10 克",
      "note": "甜味更柔和，需先化开。"
    }
  ],
  "variations": [
    "撒一点白胡椒粉，风味更接近港式。",
    "淋一勺热油和葱花，香气更加足。"
  ],
  "serving_suggestion": "趁热配白饭，浇一点汁在饭上，是香港茶餐厅常见的家常菜。",
  "storage": "冷藏两天，复热用平底锅小火煎两分钟；不建议冷冻，豆腐会失水变渣。",
