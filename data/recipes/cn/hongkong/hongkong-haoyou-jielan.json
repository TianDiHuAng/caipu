  "steps": [
    {
      "n": 1,
      "text": "芥蓝削去根部老皮，粗梗用刀划开一道，摘成十厘米长的段。",
      "time_min": 10,
      "heat": "无火",
      "tip": "粗梗划开才和嫩叶同熟，不划的话梗硬叶烂。",
      "visual_cue": "梗部断面露出浅绿嫩肉，老皮已去净"
    },
    {
      "n": 2,
      "text": "清水烧开加盐和几滴植物油，芥蓝下锅焯四十秒立刻捞出。",
      "time_min": 7,
      "heat": "大火",
      "tip": "水里的油能锁住菜色，焯出来翠绿发亮不发黄。",
      "visual_cue": "菜叶翠绿发亮，梗部转为更深的绿"
    },
    {
      "n": 3,
      "text": "焯好的芥蓝马上过一遍凉开水，沥干后整齐码在盘中。",
      "time_min": 4,
      "heat": "无火",
      "tip": "焯好马上过一遍凉开水定色定脆，直接摊着放凉余温会把菜焖黄。",
      "visual_cue": "菜色鲜绿透亮，梗脆叶不塌软"
    },
    {
      "n": 4,
      "text": "碗里放蚝油、白糖、米酒和清水调匀，加玉米淀粉搅成芡汁。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蚝油先用水调开，直接下锅会糊底结块。",
      "visual_cue": "芡汁顺滑无颗粒，颜色呈深褐色"
    },
    {
      "n": 5,
      "text": "炒锅倒植物油烧到温热，下蒜末和姜丝用小火爆香约十秒钟。",
      "time_min": 3,
      "heat": "小火",
      "tip": "蒜末别炒黄，微香就下芡汁，炒黄会发苦。",
      "visual_cue": "蒜末微微发黄，油面飘出香味"
    },
    {
      "n": 6,
      "text": "倒入调好的芡汁，中火煮到冒泡变稠，尝一下咸淡再关火。",
      "time_min": 4,
      "heat": "中火",
      "tip": "芡汁要煮到起泡才够稠，能挂住菜梗不流底。",
      "visual_cue": "芡汁起泡浓稠，挂勺不滴"
    },
    {
      "n": 7,
      "text": "把热腾腾的芡汁均匀淋在码好的芥蓝上，趁热端上桌即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "淋汁要浇在菜梗上，叶子吸多了汁容易发咸，梗才是重点。",
      "visual_cue": "菜梗挂满浓汁，光泽油润"
    }
  ],
  "tips": [
    "芥蓝焯水时加盐和几滴油，菜的翠绿色就锁住了。这一步比什么都重要，没加油焯出来是暗黄的。",
    "焯完立刻过凉水，颜色和脆度都能定住。直接摊着放凉，余温会把菜焖软焖黄。",
    "蚝油汁要提前用水调开再加淀粉，直接往锅里挤蚝油容易糊底，还结块化不开。",
    "粗梗一定要划刀，不然梗还硬着叶子已经烂了。划一到两刀，深度到梗的一半即可。"
  ],
  "common_mistakes": [
    "焯水不放油，芥蓝焯出来发黄发暗。水里加几滴植物油和一小撮盐。",
    "焯好不过凉水，菜在盆里焖着继续受热，端上桌已经软塌塌。",
    "蚝油直接下热锅，瞬间糊底结黑块。必须先用清水调开再加淀粉。",
    "芡汁太稠，淋上去像胶水糊住菜。淀粉只要五克，汁能挂住梗就行。"
  ],
  "substitutions": [
    {
      "original": "芥蓝",
      "substitute": "菜心",
      "ratio": "450克:450克",
      "note": "口感更嫩，焯水时间缩短十秒。"
    },
    {
      "original": "蚝油",
      "substitute": "素蚝油",
      "ratio": "25克:25克",
      "note": "纯素版本，鲜味略淡但适合素食者。"
    }
  ],
  "variations": [
    "把芥蓝换成焯水的菜心或生菜，同样淋蚝油芡汁，就是港式茶餐厅最常见的灼菜三宝。",
    "加一勺蒜蓉辣酱同炒，做成辣味蚝油芥蓝。喜欢重口味的人会喜欢这个版本。",
    "焯好后淋一勺滚烫的猪油再浇蚝油汁，香气厚重。老派粤菜馆子的做法。"
  ],
  "serving_suggestion": "整齐码盘淋汁上桌，梗脆叶嫩、蚝油汁咸鲜回甜，是港式茶餐厅和粤菜馆最常见的青菜，配烧腊饭必点。",
  "storage": "冷藏可放一天，复热用沸水快速烫二十秒再淋新调的蚝油汁；不建议微波，菜叶会变黄。",
