  "steps": [
    {
      "n": 1,
      "text": "鲈鱼去鳞去内脏洗净，刮净鱼腹内的黑膜，两面各斜划三刀。",
      "time_min": 8,
      "heat": "无火",
      "tip": "腹内黑膜是腥味来源，一定要刮干净。",
      "visual_cue": "鱼身干净无血，刀口整齐"
    },
    {
      "n": 2,
      "text": "鱼身抹薄盐与料酒，鱼腹塞姜片与葱段，盘底垫两根葱，静置五分钟。",
      "time_min": 6,
      "heat": "无火",
      "tip": "垫葱让鱼身离开盘底，蒸汽才能从下面过去。",
      "visual_cue": "鱼身微微收紧，垫葱整齐"
    },
    {
      "n": 3,
      "text": "蒸锅大火烧到上汽，鱼盘入锅盖严，蒸八分钟关火再虚蒸两分钟。",
      "time_min": 11,
      "heat": "大火",
      "tip": "一斤二两的鱼八分钟刚好，多一分钟肉就发柴。",
      "visual_cue": "鱼眼凸出发白，鱼皮绽开"
    },
    {
      "n": 4,
      "text": "取出鱼盘，倒掉盘里的腥水，夹走葱姜，重新铺上葱丝姜丝与香菜。",
      "time_min": 2,
      "heat": "无火",
      "tip": "盘里的水一定倒掉，那是腥味的根源。",
      "visual_cue": "盘中干爽，葱丝堆在鱼身上"
    },
    {
      "n": 5,
      "text": "小锅烧热花生油至冒烟，均匀泼在葱丝上，再沿盘边淋入蒸鱼豉油。",
      "time_min": 2,
      "heat": "中火",
      "tip": "油要烧到冒烟再泼，激出的葱香才够冲。",
      "visual_cue": "葱丝卷曲发亮，香气四散"
    }
  ],
  "tips": [
    "鱼要现杀现蒸，冰过的鱼肉质松散，蒸出来不鲜。",
    "豉油沿盘边淋，不要直接浇在鱼身上，鱼皮才完整。",
    "没有蒸锅可用平底锅加蒸架，水开后再放鱼。"
  ],
  "common_mistakes": [
    "冷水上锅慢慢蒸，鱼肉被蒸得又老又柴。",
    "蒸好不虚蒸，直接开盖，鱼肉突然遇冷收缩发硬。",
    "盘里的腥水不倒掉，淋上豉油也压不住那股味。"
  ],
  "substitutions": [
    {
      "original": "鲈鱼",
      "substitute": "石斑鱼",
      "ratio": "600克:600克",
      "note": "石斑肉质更紧，蒸的时间加两分钟。"
    },
    {
      "original": "蒸鱼豉油",
      "substitute": "生抽",
      "ratio": "30毫升:25毫升",
      "note": "生抽偏咸，可加半勺糖调和。"
    }
  ],
  "variations": [
    "鱼身铺一层豆豉同蒸，就是港式的豉汁蒸鱼。",
    "改用姜葱蓉铺满鱼身再泼油，葱姜味更浓。"
  ],
  "serving_suggestion": "上桌趁热吃，先夹鱼背最厚的那块，肉最嫩。",
  "storage": "冷藏可存一天，复热须蒸三分钟，久蒸肉质发散。",
