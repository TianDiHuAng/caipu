  "equipment": [
    "砂锅",
    "平底锅",
    "刀",
    "砧板",
    "铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "嫩豆腐切成两厘米厚的方片，用厨房纸吸干表面的水分。",
      "time_min": 8,
      "heat": "无火",
      "tip": "表面水一定要吸干，不然下锅就溅油还粘锅。",
      "visual_cue": "豆腐片完整不破，表面吸得干干爽爽"
    },
    {
      "n": 2,
      "text": "平底锅倒一半植物油烧热，豆腐片下锅中火煎至两面金黄。",
      "time_min": 8,
      "heat": "中火",
      "tip": "煎定型再翻面，一面煎足三分钟才不散。",
      "visual_cue": "两面煎到金黄，边缘微微焦脆"
    },
    {
      "n": 3,
      "text": "煎好的豆腐盛出，香菇泡软切片，胡萝卜切薄片备用。",
      "time_min": 6,
      "heat": "无火",
      "tip": "香菇泡软的水留着，烧豆腐时加进去更鲜。",
      "visual_cue": "菇片软韧，胡萝卜片薄透"
    },
    {
      "n": 4,
      "text": "砂锅倒剩余植物油，下蒜末、姜片和葱白段小火爆香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "砂锅要先小火慢慢预热，骤热容易炸裂，这是砂锅菜的第一道关。",
      "visual_cue": "葱姜蒜出香，油面微冒烟"
    },
    {
      "n": 5,
      "text": "下香菇片和胡萝卜片翻炒一分钟，让菇片吸油出香。",
      "time_min": 3,
      "heat": "中火",
      "tip": "香菇先炒出香，烧出来的汤汁才有菌菇的鲜。",
      "visual_cue": "菇片吸油发亮，边缘微卷"
    },
    {
      "n": 6,
      "text": "把煎好的豆腐片码进砂锅，加生抽、老抽、蚝油、白糖和清水。",
      "time_min": 5,
      "heat": "中火",
      "tip": "豆腐在砂锅里码放不要叠太厚，叠薄一点汤汁才浸得透。",
      "visual_cue": "汤面微沸，豆腐浸在汁里"
    },
    {
      "n": 7,
      "text": "盖上砂锅盖转小火焖十分钟，中途轻推一下锅底防止粘底。",
      "time_min": 12,
      "heat": "小火",
      "tip": "全程保持小火，砂锅大火容易糊底，还可能把锅烧裂。",
      "visual_cue": "汤汁收得浓稠，豆腐微微鼓起"
    },
    {
      "n": 8,
      "text": "用玉米淀粉加水勾薄芡，淋香油撒葱段，连砂锅端上桌。",
      "time_min": 4,
      "heat": "中火",
      "tip": "芡要薄，汤汁裹住豆腐就够，太稠像糊。",
      "visual_cue": "汤汁浓亮挂勺，葱段翠绿"
    }
  ],
  "tips": [
    "豆腐一定要先煎定型，皮焦了才烧得住。不煎直接烧，豆腐一碰就碎。",
    "煎豆腐要有耐心，一面煎足三分钟定型再翻。心急翻面，豆腐就散在锅里。",
    "砂锅烧豆腐开小火，砂锅导热慢、蓄热强，大火容易糊底还可能裂锅。",
    "用香菇泡发的水代替清水烧豆腐，鲜味翻倍。静置后取上层清液，底下有沙不要。"
  ],
  "common_mistakes": [
    "豆腐不煎直接下锅烧，碎成一锅豆腐渣。必须先煎到两面金黄定型。",
    "砂锅开大火烧，糊底还容易裂锅。砂锅一定小火慢焖。",
    "汤汁收太干，豆腐发硬还粘锅。留一点浓汁，拌饭才香。",
    "老抽放多，豆腐变成黑褐色发苦。五毫升只够上个浅红色。"
  ],
  "substitutions": [
    {
      "original": "嫩豆腐",
      "substitute": "北豆腐",
      "ratio": "500克:500克",
      "note": "更结实不易碎，煎的时间延长两分钟。"
    },
    {
      "original": "香菇",
      "substitute": "杏鲍菇",
      "ratio": "60克:80克",
      "note": "口感更脆，出水较多需减清水三十毫升。"
    }
  ],
  "variations": [
    "加一把泡软的粉丝铺底，做成粉丝豆腐煲。粉丝吸饱汤汁比豆腐还好吃。",
    "加几片五花肉先煸出油再烧，猪油香气厚重得多。这是客家豆腐煲的做法。",
    "把豆腐换成油豆腐泡，做成红烧油豆腐。吸汁更猛，一口爆汁。"
  ],
  "serving_suggestion": "连砂锅端上桌，豆腐外焦内嫩、汤汁浓稠带菇香，舀一勺连汁拌饭是这道菜最正确的吃法。",
  "storage": "冷藏可放一天，复热加两勺水小火焖五分钟；豆腐隔夜会出水，建议当餐吃完。",
