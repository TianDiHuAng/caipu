  "equipment": [
    "焗盘",
    "平底锅",
    "刀",
    "砧板",
    "烤箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪里脊切成一厘米厚片，用刀背轻拍松，加生抽、盐与黑胡椒腌二十分钟。",
      "time_min": 20,
      "heat": "无火",
      "tip": "拍松能断筋，煎后不卷边。",
      "visual_cue": "肉片变薄，边缘平整"
    },
    {
      "n": 2,
      "text": "隔夜米饭加蛋液抓匀，让每粒米都裹上薄薄一层。",
      "time_min": 4,
      "heat": "无火",
      "tip": "蛋液裹饭，炒出来才金黄不粘。",
      "visual_cue": "米粒松散，颜色微黄"
    },
    {
      "n": 3,
      "text": "平底锅烧热倒植物油，米饭下锅中大火炒到松散跳动。",
      "time_min": 5,
      "heat": "中大火",
      "tip": "锅要够热，饭才不粘底。",
      "visual_cue": "米粒跳动，颗颗分明"
    },
    {
      "n": 4,
      "text": "炒好的饭盛进焗盘，用勺背轻轻压平作为底层。",
      "time_min": 3,
      "heat": "无火",
      "tip": "压平但别压实，留点空隙吸汁。",
      "visual_cue": "饭层平整，厚度一致"
    },
    {
      "n": 5,
      "text": "猪扒两面拍薄面粉，平底锅少油中火每面煎三分钟。",
      "time_min": 7,
      "heat": "中火",
      "tip": "拍粉锁汁，煎出来外脆内嫩。",
      "visual_cue": "两面金黄，肉汁微渗"
    },
    {
      "n": 6,
      "text": "煎好的猪扒切条，铺在饭面上，余油爆香洋葱丝。",
      "time_min": 4,
      "heat": "中火",
      "tip": "洋葱炒软出甜，是酱汁的底。",
      "visual_cue": "洋葱透明，香气上扬"
    },
    {
      "n": 7,
      "text": "下番茄块与番茄膏炒三分钟，加白糖、盐与少量清水煮成酱。",
      "time_min": 6,
      "heat": "中火",
      "tip": "番茄膏先炒过，酸味才不刺。",
      "visual_cue": "酱汁浓稠，颜色红亮"
    },
    {
      "n": 8,
      "text": "酱汁浇在猪扒上，铺奶酪丝，二百二十度焗十分钟。",
      "time_min": 10,
      "heat": "大火",
      "tip": "奶酪铺满边缘，焗到起泡才香。",
      "visual_cue": "奶酪融化，表面微焦"
    }
  ],
  "tips": [
    "隔夜饭水分少，焗完不会糊成一坨。",
    "猪扒别煎太久，后面还要焗，容易柴。",
    "酱汁要比平时稍咸，因为米饭会吸味。"
  ],
  "common_mistakes": [
    "用新煮的饭来做，焗完又湿又软粘牙。",
    "酱汁熬得太稀，把底下的饭泡成粥。",
    "奶酪铺太少，焗完露着猪扒发干。"
  ],
  "substitutions": [
    {
      "original": "猪里脊",
      "substitute": "猪排骨",
      "ratio": "500 克:600 克",
      "note": "带骨更香，需先煎至八分熟。"
    },
    {
      "original": "番茄膏",
      "substitute": "番茄酱",
      "ratio": "30 克:40 克",
      "note": "甜味更足，白糖减至五克。"
    }
  ],
  "variations": [
    "酱汁里加一勺蚝油，鲜味更厚更港式。",
    "换成鸡肉做焗鸡扒饭，做法一致。"
  ],
  "serving_suggestion": "连焗盘端上桌，配一杯冻柠茶解腻。",
  "storage": "冷藏两天，复热盖锡纸烤一百八十度十分钟，避免表面焦干。",
