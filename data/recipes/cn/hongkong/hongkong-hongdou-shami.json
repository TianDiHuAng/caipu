  "steps": [
    {
      "n": 1,
      "text": "红豆挑去坏豆，用清水浸泡一小时，泡到豆皮发皱、捏起来变软。",
      "time_min": 62,
      "heat": "无火",
      "tip": "泡足时间煮起来才快，不泡要煮上两小时。",
      "visual_cue": "豆粒胀大两倍，豆皮起皱发软"
    },
    {
      "n": 2,
      "text": "红豆加足量清水大火烧开，转小火加盖煮四十分钟至豆子开花。",
      "time_min": 42,
      "heat": "小火",
      "tip": "水要一次加足，中途添水豆沙会发稀，味道也冲淡。",
      "visual_cue": "豆皮裂开，汤色深红发暗"
    },
    {
      "n": 3,
      "text": "取一半红豆连汤用搅拌机打成细沙，倒回锅中与整粒红豆同煮。",
      "time_min": 6,
      "heat": "小火",
      "tip": "留一半整粒，口感才有层次，全是沙反而寡。",
      "visual_cue": "汤体转为浓稠的豆沙色，香气扑鼻"
    },
    {
      "n": 4,
      "text": "加冰糖与一小撮盐，小火搅到糖化开，豆沙稠到能挂勺。",
      "time_min": 8,
      "heat": "小火",
      "tip": "一点盐能把甜味提起来，甜汤都这么做。",
      "visual_cue": "汤面泛光，勺子挂一层沙"
    },
    {
      "n": 5,
      "text": "另起锅烧水，西米倒入煮十分钟至中心剩小白点，关火焖五分钟。",
      "time_min": 12,
      "heat": "中火",
      "tip": "关火焖比一直煮更省事，中心的小白点也能焖透。",
      "visual_cue": "西米通体透明，看不见白心"
    },
    {
      "n": 6,
      "text": "西米捞出过凉水沥干，倒入豆沙中拌匀，盛碗淋上椰奶即可。",
      "time_min": 3,
      "heat": "无火",
      "tip": "西米过凉水才弹，直接下锅会糊成一团。",
      "visual_cue": "西米颗颗分明，椰奶浮在表面"
    }
  ],
  "tips": [
    "红豆选当年新豆，陈豆不易煮烂，泡再久也硬。",
    "想更绵密可全部打沙，想要口感就留三分之一整粒。",
    "冷藏后风味更浓，夏天吃冰镇的最舒服。"
  ],
  "common_mistakes": [
    "红豆不泡直接煮，煮两小时豆心还是硬的。",
    "糖和豆一起下锅煮，豆子被糖封住，怎么煮都不烂。",
    "西米煮好不过凉水，黏成一大坨，拌进豆沙全是疙瘩。"
  ],
  "substitutions": [
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "150毫升:150毫升",
      "note": "牛奶版更清爽，奶香略淡。"
    },
    {
      "original": "冰糖",
      "substitute": "红糖",
      "ratio": "80克:70克",
      "note": "红糖版颜色更深，带一股焦香。"
    }
  ],
  "variations": [
    "加一小把汤圆同煮，就是港式红豆沙汤圆，冬天最常见。",
    "豆沙里加两片陈皮同煮，香气更清，是老式糖水的做法。"
  ],
  "serving_suggestion": "热吃暖胃，冰镇后更清爽，饭后一碗正好解腻。",
  "storage": "冷藏可存三天，西米隔夜会返硬，最好现煮现加。",
