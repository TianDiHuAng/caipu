  "equipment": [
    "汤锅",
    "漏勺",
    "面碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "猪骨冷水下锅焯五分钟，撇净血沫后捞出用温水冲净。",
      "time_min": 8,
      "heat": "大火",
      "tip": "冷水下锅焯，血沫才出得净。",
      "visual_cue": "骨面灰白、水面浮沫撇净"
    },
    {
      "n": 2,
      "text": "汤锅加清水放猪骨与姜丝，小火熬四十分钟成汤底。",
      "time_min": 40,
      "heat": "小火",
      "tip": "汤底可提前熬好冷藏备用。",
      "visual_cue": "汤色微白、浮起少量油花"
    },
    {
      "n": 3,
      "text": "虾仁剁成粗粒，与猪肉末、蚝油、料酒、盐、白胡椒拌匀。",
      "time_min": 6,
      "heat": "无火",
      "tip": "虾仁别剁太细，才有弹牙感。",
      "visual_cue": "馅料黏连、虾仁粒清晰可见"
    },
    {
      "n": 4,
      "text": "馅料加玉米淀粉与香油顺一个方向搅打上劲。",
      "time_min": 3,
      "heat": "无火",
      "tip": "同向搅打，馅才紧实不散。",
      "visual_cue": "馅料抱团、表面泛油光"
    },
    {
      "n": 5,
      "text": "云吞皮中间放一小勺馅，四角对折捏紧，逐个包好。",
      "time_min": 12,
      "heat": "无火",
      "tip": "馅别放太多，皮才不破。",
      "visual_cue": "云吞饱满、收口紧实"
    },
    {
      "n": 6,
      "text": "汤底加生抽、白糖与盐调味，撒白胡椒与香油保温。",
      "time_min": 3,
      "heat": "小火",
      "tip": "汤底要略咸，配面才够味。",
      "visual_cue": "汤色清亮、咸鲜适口"
    },
    {
      "n": 7,
      "text": "另起锅烧清水，水滚后下云吞煮三分钟至浮起。",
      "time_min": 4,
      "heat": "大火",
      "tip": "云吞浮起再煮半分钟才熟透。",
      "visual_cue": "云吞鼓起浮面、皮透亮"
    },
    {
      "n": 8,
      "text": "同一锅水下碱水面煮九十秒，同时焯小青菜。",
      "time_min": 2,
      "heat": "大火",
      "tip": "碱水面煮久会发软失弹。",
      "visual_cue": "碱水面松散、青菜翠绿"
    },
    {
      "n": 9,
      "text": "碱水面捞入碗中，依次摆上云吞、小青菜与韭黄段。",
      "time_min": 2,
      "heat": "无火",
      "tip": "韭黄最后放，靠汤温略微烫熟。",
      "visual_cue": "碗中面云吞菜码齐整"
    },
    {
      "n": 10,
      "text": "浇上滚热的汤底，趁热把碱水面与云吞拌匀后食用。",
      "time_min": 1,
      "heat": "无火",
      "tip": "汤要滚烫浇下去才够香。",
      "visual_cue": "汤面浮油、热气腾腾"
    }
  ],
  "tips": [
    "碱水面先过一遍滚水，碱味会淡一些。",
    "馅料打上劲后冷藏十分钟更好包。",
    "汤底可加少许大地鱼粉提鲜，港式味更足。"
  ],
  "common_mistakes": [
    "云吞皮太薄又放太多馅，一煮就破。",
    "面与云吞同锅久煮，碱水面糊成一团。",
    "汤底调味过淡，配上碱水面几乎没有味道。"
  ],
  "substitutions": [
    {
      "original": "碱水面",
      "substitute": "细鸡蛋面",
      "ratio": "200g 对 200g",
      "note": "碱味更淡，煮制时间缩短二十秒。"
    },
    {
      "original": "虾仁",
      "substitute": "干贝",
      "ratio": "150g 对 100g",
      "note": "需提前泡发半小时。"
    }
  ],
  "variations": [
    "加一勺牛腩汁就是港式牛腩云吞面。",
    "云吞改成油炸，做成炸云吞配汤面。"
  ],
  "serving_suggestion": "汤、面、云吞一起上桌，先喝汤再拌面最地道。",
  "storage": "云吞可冷冻保存一个月，汤底冷藏三天。",
