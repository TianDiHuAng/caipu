  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "绿茶",
          "name_en": "green tea",
          "amount": 15,
          "unit": "g",
          "note": "茶叶",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 1200,
          "unit": "ml",
          "note": "冲泡",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "柠檬",
          "name_en": "lemon",
          "amount": 200,
          "unit": "g",
          "note": "切厚片",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 90,
          "unit": "g",
          "note": "煮糖水",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "玻璃壶",
    "捣棒",
    "滤网"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅加清水烧到微沸后关火，放入绿茶闷泡四分钟。",
      "time_min": 4,
      "heat": "小火",
      "tip": "不要久煮茶叶，否则带涩。",
      "visual_cue": "茶汤转黄绿，香气清扬"
    },
    {
      "n": 2,
      "text": "用滤网把茶叶全部滤出去，茶汤自然放凉到室温。",
      "time_min": 4,
      "heat": "无火",
      "tip": "滤净茶叶，避免越泡越苦。",
      "visual_cue": "茶汤清澈，无茶叶残留"
    },
    {
      "n": 3,
      "text": "另取小锅加白糖与少量清水，小火煮成透明糖浆。",
      "time_min": 5,
      "heat": "小火",
      "tip": "煮到糖完全化开就够，别熬焦。",
      "visual_cue": "糖浆透亮，勺底无颗粒"
    },
    {
      "n": 4,
      "text": "柠檬用盐搓洗表皮后冲净，擦干水分再切片。",
      "time_min": 4,
      "heat": "无火",
      "tip": "连皮切片，香气才足。",
      "visual_cue": "柠檬片厚薄一致，果皮油亮"
    },
    {
      "n": 5,
      "text": "取一半柠檬片放进壶里，用捣棒压出果汁与香气。",
      "time_min": 2,
      "heat": "无火",
      "tip": "轻压出汁就好，压太狠会发苦。",
      "visual_cue": "柠檬片变软，壶底有果汁"
    },
    {
      "n": 6,
      "text": "倒入放凉的茶汤与糖浆，搅匀后尝一下酸甜比例。",
      "time_min": 2,
      "heat": "无火",
      "tip": "先少放糖，酸度可按喜好调。",
      "visual_cue": "茶汤色泽均匀，甜酸平衡"
    },
    {
      "n": 7,
      "text": "剩下的柠檬片放进壶中，冷藏两小时让味道融合。",
      "time_min": 120,
      "heat": "无火",
      "tip": "冷藏入味，比加冰块更不冲淡。",
      "visual_cue": "茶汤冰凉，柠檬片浮沉"
    },
    {
      "n": 8,
      "text": "饮用之前再搅一下，倒进杯中配一片新鲜柠檬。",
      "time_min": 2,
      "heat": "无火",
      "tip": "喝前搅匀，甜味才均匀。",
      "visual_cue": "杯壁结水雾，茶汤透亮"
    }
  ],
  "tips": [
    "茶叶闷泡四分钟就够，煮久会发涩。",
    "柠檬连皮切片，香气比只取果汁更足。",
    "用冷藏代替加冰块，味道不会被冲淡。"
  ],
  "common_mistakes": [
    "茶叶在锅里一直煮，茶汤发黑带苦。",
    "柠檬皮没洗干净，喝起来有涩味。",
    "糖浆熬过了头，冷却后会结成硬块。"
  ],
  "substitutions": [
    {
      "original": "绿茶",
      "substitute": "乌龙茶",
      "ratio": "15 克:15 克",
      "note": "茶味更厚，闷泡时间加一分钟。"
    },
    {
      "original": "白糖",
      "substitute": "蜂蜜",
      "ratio": "90 克:80 克",
      "note": "香气更柔，需在茶汤温热时加。"
    }
  ],
  "variations": [
    "加两片薄荷叶进去，清凉感更强。",
    "用青柠替换一半柠檬，酸味更利落。"
  ],
  "serving_suggestion": "冰镇后配菠萝包，港式下午茶标配。",
  "storage": "冷藏两天内喝完，柠檬片建议当天取出。",
