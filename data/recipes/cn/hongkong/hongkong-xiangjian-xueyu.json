  "equipment": [
    "平底锅",
    "厨房纸",
    "锅铲"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鳕鱼柳解冻后用厨房纸反复吸干水分，切成长段，用料酒抹匀静置五分钟。",
      "time_min": 8,
      "heat": "无火",
      "tip": "鱼柳水分多，越干煎出来越香。",
      "visual_cue": "鱼柳干爽、按压不出水"
    },
    {
      "n": 2,
      "text": "两面均匀撒盐与黑胡椒，再薄薄拍一层玉米淀粉，抖掉多余粉末。",
      "time_min": 4,
      "heat": "无火",
      "tip": "淀粉只拍薄薄一层，厚了会糊。",
      "visual_cue": "鱼柳表面哑光、无干粉堆积"
    },
    {
      "n": 3,
      "text": "平底锅烧热倒植物油，转中小火，鳕鱼柳下锅后先别动，煎三分钟定型。",
      "time_min": 3,
      "heat": "中小火",
      "tip": "下锅就翻必碎，等结壳再动。",
      "visual_cue": "底面金黄、边缘收紧"
    },
    {
      "n": 4,
      "text": "用锅铲配合筷子小心翻面，再煎两分钟到两面金黄。",
      "time_min": 2,
      "heat": "中小火",
      "tip": "翻面用两件工具，鱼柳才不散。",
      "visual_cue": "两面金黄、鱼身不散"
    },
    {
      "n": 5,
      "text": "把蒜末撒在锅边空白处煸香，晃动锅子让蒜香油裹住鳕鱼柳。",
      "time_min": 1,
      "heat": "小火",
      "tip": "蒜末别撒在鱼身上，容易焦黑。",
      "visual_cue": "蒜末金黄、香气扑鼻"
    },
    {
      "n": 6,
      "text": "盛盘后挤上柠檬汁，趁热食用，可再撒少许黑胡椒。",
      "time_min": 1,
      "heat": "无火",
      "tip": "柠檬汁最后挤，酸香才清爽。",
      "visual_cue": "鱼肉雪白分层、外皮微脆"
    }
  ],
  "tips": [
    "鳕鱼解冻要放冷藏慢慢化，别用热水冲。",
    "锅一定要烧热再下油，鱼皮才不粘。",
    "家里没有柠檬，可以用少许白醋替代挤在鱼上。"
  ],
  "common_mistakes": [
    "鳕鱼带着水下锅，油花四溅还粘锅。",
    "全程都用大火煎，结果是外焦里生不好吃。",
    "翻面翻得太勤快，鱼肉散成小块不成形。"
  ],
  "substitutions": [
    {
      "original": "鳕鱼",
      "substitute": "龙利鱼",
      "ratio": "400g 对 400g",
      "note": "龙利鱼更嫩，煎的时间减半分钟。"
    },
    {
      "original": "柠檬",
      "substitute": "青柠",
      "ratio": "30g 对 30g",
      "note": "青柠酸度更高，用量减半。"
    }
  ],
  "variations": [
    "煎好后淋一勺豉油，做成港式豉油煎鱼。",
    "配一份塔塔酱，接近西式煎鱼风味。"
  ],
  "serving_suggestion": "配一份白饭与时蔬，或夹面包做鱼柳三明治。",
  "storage": "冷藏一天，复热用平底锅小火两面各煎一分钟。",
