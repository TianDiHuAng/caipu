    "刀",
    "砧板",
    "铲",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "空心菜摘去老梗，把梗和叶分开，各切成五厘米长的段，洗净沥干。",
      "time_min": 10,
      "heat": "无火",
      "tip": "梗叶分开下锅，梗先叶后，熟度才一致。",
      "visual_cue": "梗段挺直饱满，叶片完整没有破损"
    },
    {
      "n": 2,
      "text": "腐乳两块放碗里，加清水和白糖压成顺滑的酱汁，搅到没有颗粒。",
      "time_min": 5,
      "heat": "无火",
      "tip": "腐乳必须压到无颗粒，否则炒的时候会结成咸块。",
      "visual_cue": "酱汁顺滑无颗粒，颜色呈淡褐色"
    },
    {
      "n": 3,
      "text": "炒锅烧到微微冒烟倒植物油，下蒜末和干辣椒段小火爆香。",
      "time_min": 4,
      "heat": "小火",
      "tip": "锅一定要烧热再下油，蒜末才炒得香而不糊，冷锅下蒜会发白出水。",
      "visual_cue": "蒜末金黄，干辣椒也泛出红色"
    },
    {
      "n": 4,
      "text": "先下空心菜梗转大火翻炒四十秒，让梗先受热变软。",
      "time_min": 3,
      "heat": "大火",
      "tip": "梗要先下锅，这是整道菜不出水的关键，梗硬叶嫩不能同下。",
      "visual_cue": "梗段颜色转深，表面油亮"
    },
    {
      "n": 5,
      "text": "再下菜叶一起大火翻炒三十秒，看到叶子刚塌下去。",
      "time_min": 3,
      "heat": "大火",
      "tip": "菜叶一塌下去就够火候了，多炒十秒立刻出一盘汤水。",
      "visual_cue": "叶片塌软，颜色转为深绿"
    },
    {
      "n": 6,
      "text": "沿锅边淋入腐乳酱汁，快速翻炒让每段菜都裹上酱。",
      "time_min": 3,
      "heat": "大火",
      "tip": "酱汁沿锅边淋，遇热激香，直接浇叶上会积咸。",
      "visual_cue": "每段菜都均匀挂上褐色的酱汁"
    },
    {
      "n": 7,
      "text": "沿锅边淋米酒，翻两下立刻关火装盘，盘底不留汤汁。",
      "time_min": 3,
      "heat": "大火",
      "tip": "米酒最后沿锅边淋，酒气一散只留香气，早放会留下涩味。",
      "visual_cue": "盘底干爽无水，菜色油亮翠绿"
    }
  ],
  "tips": [
    "空心菜梗和叶一定要分开下锅，梗先炒四十秒再下叶。一起下锅的话梗还生叶已烂。",
    "腐乳要加清水和白糖压成顺滑酱汁再下锅，整块丢进去炒不化，吃到大块咸得要命。",
    "全程大火，锅烧到冒烟再下油。空心菜水汽重，火小了立刻出一盘汤。",
    "炒空心菜最忌盖盖，一盖就焖黄。敞开大火快炒，三十秒出锅，颜色才翠绿。"
  ],
  "common_mistakes": [
    "空心菜盖盖焖炒，出锅一盘黄叶。全程敞着锅大火快炒。",
    "腐乳整块下锅，炒不化还结成咸疙瘩。必须压碎加清水调成酱。",
    "火太小炒空心菜，菜叶出水变成汤。锅要烧到冒烟，全程大火。",
    "炒太久，空心菜变黑变软。从下梗到出锅不超过两分钟。"
  ],
  "substitutions": [
    {
      "original": "空心菜",
      "substitute": "通菜梗",
      "ratio": "500克:450克",
      "note": "只用梗更脆，需多炒三十秒。"
    },
    {
      "original": "腐乳",
      "substitute": "虾酱",
      "ratio": "30克:20克",
      "note": "鲜味更浓，咸度更高，白砂糖加到五克。"
    }
  ],
  "variations": [
    "加一勺辣椒油或豆瓣酱同炒，做成辣味腐乳通菜。下饭程度直接翻倍。",
    "腐乳换成南乳，颜色更红亮、味道更甘。这是广东顺德的传统做法。",
    "加几片五花肉先煸出油再炒菜，猪油炒空心菜香气厚重得多。"
  ],
  "serving_suggestion": "趁热装盘，菜梗脆嫩、腐乳咸香回甘，配白粥或白饭都很合适，是粤港家常和茶餐厅最常见的青菜。",
  "storage": "冷藏可放一天，复热用大火快炒三十秒；空心菜隔夜易发黑，建议当餐吃完。",
