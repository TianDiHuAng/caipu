  "equipment": [
    "炒锅",
    "刀",
    "漏勺",
    "厨房纸"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鱿鱼去内脏和软骨，撕掉表面紫膜，切成两厘米宽的圈。",
      "time_min": 10,
      "heat": "无火",
      "tip": "紫膜不撕会发韧，切圈厚薄要一致。",
      "visual_cue": "鱿鱼圈洁白，切得整齐"
    },
    {
      "n": 2,
      "text": "鱿鱼圈用厨房纸彻底吸干水分，加两克盐抓匀。",
      "time_min": 5,
      "heat": "无火",
      "tip": "水分不吸干的话，裹粉会结块脱壳。",
      "visual_cue": "表面干爽，摸起来不粘手"
    },
    {
      "n": 3,
      "text": "玉米淀粉倒进碗里，把鱿鱼圈逐条裹上一层薄粉。",
      "time_min": 6,
      "heat": "无火",
      "tip": "薄薄一层就够，裹太厚炸完发硬。",
      "visual_cue": "表面均匀挂上一层白粉"
    },
    {
      "n": 4,
      "text": "炒锅倒植物油烧到一百八十度，下鱿鱼圈炸九十秒。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油温一定要够高，低温炸会吸满油。",
      "visual_cue": "入锅立刻起密集气泡"
    },
    {
      "n": 5,
      "text": "捞出沥油，把油温再升高，回锅复炸三十秒至外壳酥脆。",
      "time_min": 3,
      "heat": "大火",
      "tip": "复炸这一步能让外壳久放不回软。",
      "visual_cue": "外壳金黄，边缘微卷"
    },
    {
      "n": 6,
      "text": "另起锅留少量底油，小火炒香大蒜末、姜末和青椒丁。",
      "time_min": 3,
      "heat": "小火",
      "tip": "大蒜末要用小火慢炒，炒焦了整盘都苦。",
      "visual_cue": "蒜末浅金，香气扑鼻"
    },
    {
      "n": 7,
      "text": "倒入炸好的鱿鱼，撒盐、白胡椒和辣椒粉快速翻匀。",
      "time_min": 2,
      "heat": "中火",
      "tip": "调料从锅边撒入，分布才更加均匀。",
      "visual_cue": "表面挂满椒盐颗粒"
    }
  ],
  "tips": [
    "鱿鱼表面必须吸干，裹粉才不会结块脱壳。",
    "复炸三十秒是酥脆的关键，别省略这一步。",
    "椒盐最后从锅边撒入，附着更均匀。"
  ],
  "common_mistakes": [
    "油温太低就下锅，鱿鱼吸满油又发软。",
    "淀粉裹得太厚，炸完外壳发硬咬不动。",
    "蒜末炒到发黑，整盘带上明显苦味。"
  ],
  "substitutions": [
    {
      "original": "鱿鱼",
      "substitute": "墨鱼",
      "ratio": "500 克:500 克",
      "note": "肉质更厚，炸的时间加三十秒。"
    },
    {
      "original": "玉米淀粉",
      "substitute": "面粉",
      "ratio": "80 克:90 克",
      "note": "外壳更厚实，酥脆度略低。"
    }
  ],
  "variations": [
    "加一小把炸蒜片，蒜香更浓更接近大排档风味。",
    "用空气炸锅两百度烤十分钟，油量大幅减少。"
  ],
  "serving_suggestion": "趁热上桌，配一碟白粥或啤酒，是香港大排档宵夜最常见的下酒菜。",
  "storage": "冷藏一天，复热用两百度烤箱五分钟，微波会让外壳回软。",
