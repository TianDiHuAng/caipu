  "equipment": [
    "炒锅",
    "锅铲",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "牛肉逆着纹理切成薄片，加生抽、料酒与淀粉抓匀，腌十分钟上浆。",
      "time_min": 11,
      "heat": "无火",
      "tip": "逆纹切是嫩的关键，顺纹切再好的牛肉也嚼不动。",
      "visual_cue": "肉片薄而完整，表面挂薄浆"
    },
    {
      "n": 2,
      "text": "河粉用手轻轻抖散，结块的地方撕开，别用水冲以免发黏。",
      "time_min": 3,
      "heat": "无火",
      "tip": "河粉抖散了才好炒，粘成团下锅必断。",
      "visual_cue": "河粉根根分明，不断不碎"
    },
    {
      "n": 3,
      "text": "碗里调好生抽、老抽、蚝油与白糖，搅匀备用，避免炒时手忙脚乱。",
      "time_min": 2,
      "heat": "无火",
      "tip": "碗汁先调好，牛河讲究一气呵成，中途停不得。",
      "visual_cue": "碗汁深褐色，糖已化开"
    },
    {
      "n": 4,
      "text": "炒锅烧到冒烟，下花生油滑锅，牛肉片大火快炒到变色盛出。",
      "time_min": 3,
      "heat": "大火",
      "tip": "锅一定要烧到冒烟，镬气才够，这是牛河的命根。",
      "visual_cue": "肉片卷边变色，锅底干爽"
    },
    {
      "n": 5,
      "text": "原锅下洋葱丝与姜丝炒香，加豆芽大火翻炒二十秒，盛出备用。",
      "time_min": 2,
      "heat": "大火",
      "tip": "豆芽只炒到断生，脆感才在，久炒出水就毁了整锅。",
      "visual_cue": "豆芽挺立透亮，不出水"
    },
    {
      "n": 6,
      "text": "锅中补油下河粉，用铲子摊开中大火煎炒两分钟，让河粉边缘微焦。",
      "time_min": 3,
      "heat": "中大火",
      "tip": "河粉要摊开煎，别急着翻，一翻就碎。",
      "visual_cue": "河粉边缘微焦，透明发亮"
    },
    {
      "n": 7,
      "text": "倒回牛肉与豆芽，淋碗汁快速翻匀，撒葱段颠锅两下出锅。",
      "time_min": 2,
      "heat": "大火",
      "tip": "汁沿锅边淋，遇热成香，直接浇在粉上就湿了。",
      "visual_cue": "河粉干爽油亮，盘中无汤"
    }
  ],
  "tips": [
    "河粉要买当天新鲜的，冷藏过的发硬，一炒就断。",
    "全程大火，锅气足才叫干炒，火小了只能叫湿炒。",
    "油量要够但不能多，盘底不留油才是合格的干炒牛河。"
  ],
  "common_mistakes": [
    "河粉下锅就猛翻，河粉断成一截截，卖相全无。",
    "豆芽炒的时间太长出水，整盘变成汤河粉，镬气全没了。",
    "牛肉腌的时候不放淀粉，炒出来又干又硬。"
  ],
  "substitutions": [
    {
      "original": "河粉",
      "substitute": "米粉",
      "ratio": "450克:400克",
      "note": "米粉更细，炒的时间减半分钟。"
    },
    {
      "original": "牛肉",
      "substitute": "猪里脊",
      "ratio": "250克:250克",
      "note": "猪里脊更嫩，腌的时间减到五分钟。"
    }
  ],
  "variations": [
    "加一勺咖喱粉同炒，就是港式茶餐厅的咖喱牛河。",
    "把牛肉换成虾仁与鱿鱼，做成干炒海鲜河，鲜味更足。"
  ],
  "serving_suggestion": "趁热上桌，配一杯冻柠茶，就是最地道的茶餐厅午餐。",
  "storage": "不宜久存，冷藏不超过一天，复热须大火快炒，微波会让河粉发黏。",
