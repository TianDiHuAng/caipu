  "equipment": [
    "蒸锅",
    "蒸盘",
    "刷子",
    "刀",
    "砧板",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "扇贝用刷子刷净外壳的泥沙，用小刀沿壳边划开取出贝肉。",
      "time_min": 10,
      "heat": "无火",
      "tip": "刷壳要在开壳前做，开了壳再刷容易弄破贝肉。",
      "visual_cue": "壳面刷洗得干干净净，贝肉完整无破损"
    },
    {
      "n": 2,
      "text": "撕掉贝肉周围的黑色肠线，只留白色闭壳肌和橙色裙边，冲洗干净。",
      "time_min": 8,
      "heat": "无火",
      "tip": "黑色肠线是腥味来源，撕干净蒸出来才清甜。",
      "visual_cue": "贝肉白净透亮，边缘没有黑线残留"
    },
    {
      "n": 3,
      "text": "壳洗净后按原来的样子摆盘，每个壳里放回一块贝肉备用。",
      "time_min": 5,
      "heat": "无火",
      "tip": "壳要留着当容器，蒸出来的汁水才不流失。",
      "visual_cue": "壳内贝肉居中，排列整齐"
    },
    {
      "n": 4,
      "text": "豆豉剁碎，大蒜切末，与姜末一起下锅小火用植物油炒香成豉汁。",
      "time_min": 6,
      "heat": "小火",
      "tip": "豆豉蒜末要小火炒香，炒糊了整盘发苦。",
      "visual_cue": "豉蒜末炒到金黄，锅里的油色发亮"
    },
    {
      "n": 5,
      "text": "炒好的豉汁加生抽、蚝油、白糖和米酒调匀，用玉米淀粉勾薄芡。",
      "time_min": 4,
      "heat": "无火",
      "tip": "芡要薄，太稠会糊在贝肉表面盖住鲜味。",
      "visual_cue": "汁液能挂住勺子，但仍会缓慢流动"
    },
    {
      "n": 6,
      "text": "每个扇贝上舀一小勺豉汁均匀铺平，静置五分钟让咸香渗进贝肉里。",
      "time_min": 7,
      "heat": "无火",
      "tip": "豉汁别铺太厚，咸味会压过扇贝的清甜。",
      "visual_cue": "豉汁薄薄一层，均匀覆盖每块贝肉"
    },
    {
      "n": 7,
      "text": "蒸锅水大滚后放入蒸盘，大火蒸五分钟，贝肉变白卷边即关火。",
      "time_min": 9,
      "heat": "大火",
      "tip": "五分钟足够，蒸久了贝肉缩成硬块咬不动。",
      "visual_cue": "贝肉变白卷边，壳内积清汁"
    },
    {
      "n": 8,
      "text": "取出撒葱花，另起锅烧热剩余的植物油淋在葱花上激香即可。",
      "time_min": 3,
      "heat": "大火",
      "tip": "油一定要烧到冒青烟再淋上葱花，那股葱香才激得出来。",
      "visual_cue": "葱花遇油滋响，香气冲鼻"
    }
  ],
  "tips": [
    "扇贝一定要刷净外壳再开壳，泥沙藏在壳缝里，不刷干净整盘都是沙。",
    "黑色肠线必须撕掉，那是腥味的根源。只留白色闭壳肌和橙色裙边，蒸出来才清甜。",
    "蒸的时间只要五分钟，贝肉一缩就老了。看到变白卷边就立刻关火，余温还会继续加热。",
    "豉汁要现炒现用，蒜末豆豉小火炒香后调汁。直接用生豆豉铺上去，味道生硬还发苦。"
  ],
  "common_mistakes": [
    "扇贝蒸太久，贝肉缩成硬橡皮。五分钟足够，多一分钟口感就差一个等级。",
    "豉汁铺太厚，咸味完全盖住扇贝的鲜甜。每个只要一小勺，薄薄一层。",
    "肠线没撕干净，整盘带腥带沙。开壳后一定要仔细清理。",
    "冷水上锅蒸，贝肉慢慢受热出水，蒸出来一壳汤。水大滚再放进去。"
  ],
  "substitutions": [
    {
      "original": "扇贝",
      "substitute": "带子肉",
      "ratio": "600克:300克",
      "note": "免处理，直接铺盘，蒸四分钟即可。"
    },
    {
      "original": "豆豉",
      "substitute": "豆豉酱",
      "ratio": "25克:20克",
      "note": "咸度更高，生抽要减半。"
    }
  ],
  "variations": [
    "贝肉下面铺一层泡软的粉丝，粉丝吸饱豉汁和贝汁，比贝肉还好吃。",
    "把蒜末加大量做成蒜蓉蒸扇贝，蒜香更冲。这是粤菜酒楼最畅销的做法。",
    "改用豉汁蒸蛏子或蒸花蛤，做法完全一样，贝类都能套用这个豉汁配方。"
  ],
  "serving_suggestion": "每人一只连壳上桌，贝肉鲜甜弹牙、豉汁咸香带蒜味，壳里那口汁水最鲜，是粤式酒楼宴客的常见前菜。",
  "storage": "冷藏可放一天，复热用蒸锅大火蒸三分钟；贝类隔夜易变味，建议当餐吃完。",
