      ]
    }
  ],
  "equipment": [
    "鸡蛋仔模具",
    "打蛋器",
    "大碗",
    "量杯",
    "晾架"
  ],
  "steps": [
    {
      "n": 1,
      "text": "鸡蛋加白糖用打蛋器搅到发白起泡，糖基本化开。",
      "time_min": 5,
      "heat": "无火",
      "tip": "糖要搅化，否则烤出来表面有焦黑小点。",
      "visual_cue": "蛋液泛白发泡，体积略膨"
    },
    {
      "n": 2,
      "text": "加入牛奶与炼乳拌匀，再筛入面粉与木薯粉，搅成顺滑无颗粒的面糊。",
      "time_min": 4,
      "heat": "无火",
      "tip": "粉一定要过筛，结块的面糊烤出来有硬粒。",
      "visual_cue": "面糊顺滑流动，舀起能连成线"
    },
    {
      "n": 3,
      "text": "倒入化开的黄油搅匀，盖保鲜膜静置十分钟，让粉充分吸水。",
      "time_min": 11,
      "heat": "无火",
      "tip": "静置这一步让成品更松软，急着烤会偏硬。",
      "visual_cue": "面糊微微变稠，表面有小气泡"
    },
    {
      "n": 4,
      "text": "鸡蛋仔模具两面刷一层植物油，中火预热两分钟，倒入面糊至八分满。",
      "time_min": 3,
      "heat": "中火",
      "tip": "倒八分满就好，装满合模时面糊会从缝里溢出来。",
      "visual_cue": "模具冒热气，面糊边缘开始定型"
    },
    {
      "n": 5,
      "text": "合模翻面，中小火每面各烤三分钟，中途翻两次，至两面金黄。",
      "time_min": 7,
      "heat": "中小火",
      "tip": "火不能大，外焦里生的鸡蛋仔一咬全是生糊。",
      "visual_cue": "模具缝隙冒出白汽，香气散出"
    },
    {
      "n": 6,
      "text": "开模取出，趁热用筷子卷成筒状，放在晾架上散热定型。",
      "time_min": 3,
      "heat": "无火",
      "tip": "趁热卷才卷得动，凉透了会脆得裂开，卷不成筒。",
      "visual_cue": "成品蜂窝饱满，边缘微脆"
    }
  ],
  "tips": [
    "木薯粉不能省，那是鸡蛋仔外脆内韧的关键。",
    "面糊静置后可放冰箱冷藏一夜，烤出来更松。",
    "喜欢巧克力味的可加一勺可可粉，糖量略增。"
  ],
  "common_mistakes": [
    "火太大，外面焦黑，里面还是流动的面糊。",
    "面糊不静置直接烤，成品扁塌，咬起来发硬。",
    "模具不刷油，出炉时整片粘住，撕下来全碎。"
  ],
  "substitutions": [
    {
      "original": "牛奶",
      "substitute": "清水",
      "ratio": "120毫升:110毫升",
      "note": "清水版更清爽，奶香略淡。"
    },
    {
      "original": "炼乳",
      "substitute": "白糖",
      "ratio": "20克:15克",
      "note": "糖版甜味更直接，可加少许奶粉。"
    }
  ],
  "variations": [
    "面糊里拌入巧克力豆或肉松，就是港式街头的新派吃法。",
    "把成品夹一球冰淇淋，冷热交替，夏天最受欢迎。"
  ],
  "serving_suggestion": "刚出炉最脆，卷成筒拿在手上边走边吃，是香港街头的经典画面。",
  "storage": "常温可存半天，凉透后密封可存一天，回炉一百六十度烤三分钟即脆。",
