        }
      ]
    }
  ],
  "equipment": [
    "汤锅",
    "搅拌机",
    "刀",
    "碗"
  ],
  "steps": [
    {
      "n": 1,
      "text": "汤锅倒八百毫升清水烧开，倒入西米中火煮十二分钟，中途不停搅拌。",
      "time_min": 14,
      "heat": "中火",
      "tip": "水要多，西米才不糊底，搅拌别停。",
      "visual_cue": "西米外圈透明，中心留小白点"
    },
    {
      "n": 2,
      "text": "关火加盖焖五分钟，捞到凉开水里冲散，沥干备用。",
      "time_min": 7,
      "heat": "无火",
      "tip": "焖到白点消失才透，冲凉水才爽滑不粘。",
      "visual_cue": "西米颗颗透明，无粘连"
    },
    {
      "n": 3,
      "text": "芒果去皮去核取果肉，三百克打成细腻果泥，一百克切一厘米小丁。",
      "time_min": 10,
      "heat": "无火",
      "tip": "果泥打细一点，口感才滑；果丁留颗粒感。",
      "visual_cue": "果泥顺滑无块，果丁方正"
    },
    {
      "n": 4,
      "text": "芒果泥里加椰奶、淡奶油和白糖，用勺子搅到糖完全化开。",
      "time_min": 4,
      "heat": "无火",
      "tip": "椰奶和淡奶油提前冷藏，成品更凉更好吃。",
      "visual_cue": "混合液呈浓稠奶黄"
    },
    {
      "n": 5,
      "text": "柚子剥出果粒，搓散成一粒一粒，去掉白膜和苦芯。",
      "time_min": 6,
      "heat": "无火",
      "tip": "白膜一定去干净，一点苦味就毁掉整碗。",
      "visual_cue": "柚子粒颗颗饱满散开"
    },
    {
      "n": 6,
      "text": "拌入西米、芒果丁和柚子粒，装碗后冷藏一小时再吃。",
      "time_min": 4,
      "heat": "无火",
      "tip": "冷藏到冰手才够爽，急着吃口感发腻。",
      "visual_cue": "碗壁挂着淡黄色奶浆"
    }
  ],
  "tips": [
    "西米煮到中心剩小白点就关火焖，别一直煮。",
    "柚子的白膜要撕净，苦味一进去就压不住。",
    "淡奶油和椰奶都冷藏过再拌，成品更冰凉顺口。"
  ],
  "common_mistakes": [
    "西米一直煮不焖，最后烂成一锅糊。",
    "柚子白膜没去干净，整碗都带苦味。",
    "用热牛奶直接拌，糖化开了但口感温吞。"
  ],
  "substitutions": [
    {
      "original": "淡奶油",
      "substitute": "椰奶",
      "ratio": "100 毫升:100 毫升",
      "note": "更清爽，少了奶香厚度。"
    },
    {
      "original": "柚子",
      "substitute": "西柚",
      "ratio": "100 克:100 克",
      "note": "微苦回甘，风味更接近港式原版。"
    }
  ],
  "variations": [
    "加一勺椰浆冰淇淋，做成冰沙版本更消暑。",
    "底部铺一层芒果冰沙，层次更丰富。"
  ],
  "serving_suggestion": "装进透明玻璃碗，表面点几粒芒果丁和柚子粒，冷藏到碗壁挂霜再端上桌。",
  "storage": "密封冷藏一天内吃完，西米会吸水变硬，别超过二十四小时。",
