    "total_min": 290
  },
  "servings": 4,
  "flavor": [
    "sweet",
    "fragrant",
    "light"
  ],
  "ingredients": [
    {
      "group": "main",
      "items": [
        {
          "name": "芒果",
          "name_en": "mango",
          "amount": 450,
          "unit": "g",
          "note": "取果肉，留少量切丁",
          "optional": false
        },
        {
          "name": "椰奶",
          "name_en": "coconut milk",
          "amount": 200,
          "unit": "ml",
          "note": "增香",
          "optional": false
        }
      ]
    },
    {
      "group": "aux",
      "items": [
        {
          "name": "淡奶油",
          "name_en": "heavy cream",
          "amount": 150,
          "unit": "ml",
          "note": "增加奶香",
          "optional": false
        },
        {
          "name": "白糖",
          "name_en": "sugar",
          "amount": 60,
          "unit": "g",
          "note": "调节甜度",
          "optional": false
        },
        {
          "name": "吉利丁",
          "name_en": "gelatin",
          "amount": 10,
          "unit": "g",
          "note": "凝固用",
          "optional": false
        },
        {
          "name": "清水",
          "name_en": "water",
          "amount": 80,
          "unit": "ml",
          "note": "泡软吉利丁",
          "optional": false
        },
        {
          "name": "薄荷",
          "name_en": "mint",
          "amount": 5,
          "unit": "g",
          "note": "装饰",
          "optional": false
        }
      ]
    }
  ],
  "equipment": [
    "小锅",
    "搅拌机",
    "模具",
    "冰箱"
  ],
  "steps": [
    {
      "n": 1,
      "text": "吉利丁片放入清水中泡五分钟，泡到完全变软后捞出挤干。",
      "time_min": 5,
      "heat": "无火",
      "tip": "冷水泡软，别用温水否则会化掉。",
      "visual_cue": "吉利丁柔软透明，能弯折"
    },
    {
      "n": 2,
      "text": "芒果去皮去核，取大部分果肉切块，留少量切成小丁备用。",
      "time_min": 8,
      "heat": "无火",
      "tip": "留一点果肉丁，成品口感更有层次。",
      "visual_cue": "果肉分两份，一份成块一份成丁"
    },
    {
      "n": 3,
      "text": "芒果块与椰奶、白糖一起倒进搅拌机，打三十秒成细腻果泥。",
      "time_min": 2,
      "heat": "无火",
      "tip": "打得越细，口感越顺滑。",
      "visual_cue": "果泥顺滑无颗粒，颜色橙黄"
    },
    {
      "n": 4,
      "text": "果泥倒进小锅，小火加热到微温约四十度就离火。",
      "time_min": 3,
      "heat": "小火",
      "tip": "只加热到微温，煮开会破坏果香。",
      "visual_cue": "果泥温热，锅边冒小泡"
    },
    {
      "n": 5,
      "text": "把泡软的吉利丁放进温果泥中搅到完全融化无颗粒。",
      "time_min": 2,
      "heat": "无火",
      "tip": "温度太低吉利丁会结块，要趁温搅。",
      "visual_cue": "果泥顺滑，看不到胶粒"
    },
    {
      "n": 6,
      "text": "加入淡奶油搅匀，再拌入芒果丁，做成布甸液。",
      "time_min": 2,
      "heat": "无火",
      "tip": "淡奶油最后加，奶香才不会被热散掉。",
      "visual_cue": "液体均匀，能看到果肉丁"
    },
    {
      "n": 7,
      "text": "布甸液过一遍细筛，滤掉气泡与粗颗粒后分装进模具。",
      "time_min": 3,
      "heat": "无火",
      "tip": "过筛能去掉泡沫，成品才光滑。",
      "visual_cue": "液体细腻，表面无浮沫"
    },
    {
      "n": 8,
      "text": "模具盖保鲜膜，放冰箱冷藏四小时以上到完全凝固。",
      "time_min": 240,
      "heat": "无火",
      "tip": "冷藏时间够，脱模才不塌。",
      "visual_cue": "轻晃模具，中心不流动"
    },
    {
      "n": 9,
      "text": "取出模具在温水中浸五秒，倒扣脱模装进盘中。",
      "time_min": 2,
      "heat": "无火",
      "tip": "模具外壁浸温水，脱模更完整。",
      "visual_cue": "布甸完整脱出，边缘光滑"
    },
    {
      "n": 10,
      "text": "顶部放芒果丁与薄荷叶点缀，冷藏后食用口感最佳。",
      "time_min": 2,
      "heat": "无火",
      "tip": "现做现吃，放久会出水。",
      "visual_cue": "布甸颤而不散，表面光亮"
    }
  ],
  "tips": [
    "吉利丁只用冷水泡软，温水会提前化掉。",
    "果泥加热到微温即可，煮开会失去果香。",
    "冷藏至少四小时，时间不够脱模就塌。"
  ],
  "common_mistakes": [
    "果泥煮到沸腾，吉利丁凝固力下降变成稀糊。",
    "吉利丁没泡透就下锅，成品里有硬胶粒。",
    "冷藏时间太短，脱模后立刻垮掉。"
  ],
  "substitutions": [
    {
      "original": "芒果",
      "substitute": "木瓜",
      "ratio": "450 克:450 克",
      "note": "甜度略低，糖可多加十克。"
    },
    {
      "original": "椰奶",
      "substitute": "牛奶",
      "ratio": "200 毫升:200 毫升",
      "note": "奶香更淡，果味更突出。"
    }
  ],
  "variations": [
    "果泥里加一勺柠檬汁，酸甜更清爽。",
    "表面淋一层芒果果酱，果味更浓郁。"
  ],
  "serving_suggestion": "冰镇后切块装盘，配薄荷叶当饭后甜品。",
  "storage": "冷藏两天内吃完，表面盖保鲜膜防串味。",
