  "steps": [
   {
    "n": 1,
    "t": "五花肉切成三厘米见方的块，冷水下锅焯到表面变白捞出洗净。",
    "time": 12,
    "heat": "大火",
    "tip": "冷水下锅焯，血水才逼得出来。",
    "cue": "肉块紧实，水面浮灰白沫"
   },
   {
    "n": 2,
    "t": "笋切滚刀块，冷水下锅煮五分钟去涩，捞出沥干备用。",
    "time": 10,
    "heat": "大火",
    "tip": "鲜笋先焯水，涩味才去得干净。",
    "cue": "笋块微透，闻着没有生涩气"
   },
   {
    "n": 3,
    "t": "炒锅倒植物油，下冰糖小火炒到化开变琥珀色。",
    "time": 3,
    "heat": "小火",
    "tip": "糖色到枣红就下肉，再炒就发苦。",
    "cue": "糖液起小泡，色如琥珀"
   },
   {
    "n": 4,
    "t": "倒入五花肉快速翻炒，让每块肉都裹上糖色。",
    "time": 3,
    "heat": "中火",
    "tip": "糖色裹匀再放水，成品才红亮。",
    "cue": "肉块油亮红润，锅底无焦"
   },
   {
    "n": 5,
    "t": "下姜蒜炒香，烹黄酒，加生抽老抽和清水没过肉块。",
    "time": 2,
    "heat": "中火",
    "tip": "水要一次加够，中途加水汤就浑了。",
    "cue": "汤汁深褐，浮着一层油"
   },
   {
    "n": 6,
    "t": "大火烧开撇沫，转小火盖盖焖半小时让肉酥软。",
    "time": 30,
    "heat": "小火",
    "tip": "小火慢焖，肉才酥而不散。",
    "cue": "汤面微微冒泡，肉块轻颤"
   },
   {
    "n": 7,
    "t": "放入笋块和葱结，继续小火焖到笋入味、汤汁减半。",
    "time": 10,
    "heat": "小火",
    "tip": "笋后放，久煮会吸光所有咸味。",
    "cue": "笋块染上酱色，筷子能扎透"
   },
   {
    "n": 8,
    "t": "开盖大火收汁，尝味补盐，汤汁浓稠即可装盘。",
    "time": 3,
    "heat": "大火",
    "tip": "收汁时不断翻动，免得锅底糊。",
    "cue": "汤汁挂勺，肉笋油亮"
   }
  ],
  "tips": [
   "五花肉冷水下锅焯，血沫去净才不腥。",
   "鲜笋先焯五分钟，涩味明显减淡。",
   "笋块后放，久煮会把咸味全吸光。"
