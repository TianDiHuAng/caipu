    "steps": [
      {
        "t": "羊肉切成拳头大的块，用厨房纸吸干表面的水分。",
        "time": 10,
        "heat": "无火",
        "tip": "表面越干，烤出来的焦香越足。",
        "cue": "肉块表面干爽，无血水"
      },
      {
        "t": "盐、黑胡椒、孜然与牛至混匀，均匀抹遍每一块羊肉。",
        "time": 6,
        "heat": "无火",
        "tip": "抹完静置二十分钟，让盐分渗进去。",
        "cue": "肉块表面均匀挂料"
      },
      {
        "t": "墨西哥辣椒切段，大蒜拍裂，洋葱切成厚厚的圆片备用。",
        "time": 7,
        "heat": "无火",
        "tip": "洋葱片既垫底又出汁，别切太薄。",
        "cue": "洋葱厚片铺满烤盘"
      },
      {
        "t": "烤盘铺锡纸，洋葱片铺底，羊肉块码在上面，放蒜、月桂叶与墨西哥辣椒。",
        "time": 5,
        "heat": "无火",
        "tip": "肉别贴盘底，靠洋葱垫着才不会糊。",
        "cue": "肉块不重叠，配料散开"
      },
      {
        "t": "淋橄榄油与白醋，再浇上一半青柠汁，把锡纸包紧。",
        "time": 4,
        "heat": "无火",
        "tip": "酸能软化纤维，带筋的肩肉才烤得烂。",
        "cue": "锡纸包严，汁水不流"
      },
      {
        "t": "烤箱预热一百六十度，中层烤两小时四十分钟。",
        "time": 162,
        "heat": "中火",
        "tip": "低温慢烤是关键，高温只会外焦内生。",
        "cue": "锡纸鼓起，香气往外冒"
      },
      {
        "t": "取出稍放凉，撕开锡纸，把肉拆成大块并拌入盘里的汁。",
        "time": 10,
        "heat": "无火",
        "tip": "用两把叉子顺着纹理拆，别切碎。",
        "cue": "肉块一撕就散，纤维分明"
      },
      {
        "t": "拆好的肉淋剩下的青柠汁，撒香菜，卷饼或配饭食用。",
        "time": 3,
        "heat": "无火",
        "tip": "青柠最后加，酸香才明亮不闷。",
        "cue": "肉块油润发亮，香菜翠绿"
      }
    ],
    "tips": [
      "羊肉带一点筋最好，纯瘦的烤久了会柴。",
      "没有墨西哥辣椒，用普通青椒加一撮辣椒粉也行。",
      "剩的肉第二天夹玉米饼，比第一天还入味。",
      "烤盘底的汁别倒掉，拌肉全靠它提味。"
    ],
    "mistakes": [
      "高温快烤，外面焦了里面还带血。",
      "锡纸没包严，水分跑光，肉烤成肉干。",
      "盐抹完立刻烤，咸味只留在表面。"
    ],
    "subs": [
