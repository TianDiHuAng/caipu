[
 {
  "id": "kaishui-baicai",
  "zh": "开水白菜",
  "en": "Napa Cabbage in Clear Consomme",
  "cuisine": "sichuan",
  "category": [
   "soup",
   "banquet"
  ],
  "difficulty": 4,
  "prep": 25,
  "cook": 95,
  "servings": 3,
  "flavor": [
   "light",
   "umami",
   "fragrant"
  ],
  "ingredients": [
   {
    "group": "main",
    "items": [
     {
      "n": "娃娃菜",
      "a": 600,
      "u": "g",
      "note": "只取菜心，剖成四瓣"
     }
    ]
   },
   {
    "group": "aux",
    "items": [
     {
      "n": "鸡胸肉",
      "a": 120,
      "u": "g",
      "note": "剁成细茸，用于扫汤"
     },
     {
      "n": "干贝",
      "a": 15,
      "u": "g",
      "note": "提前温水泡发"
     },
     {
      "n": "姜",
      "a": 10,
      "u": "g",
      "note": "切片"
     },
     {
      "n": "小葱",
      "a": 20,
      "u": "g",
      "note": "一半煮汤一半切丝"
     },
     {
      "n": "枸杞",
      "a": 5,
      "u": "g",
      "note": "温水略泡"
     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "鸡汤",
      "a": 1200,
      "u": "ml",
      "note": "清鸡汤，撇净浮油"
     },
     {
      "n": "料酒",
      "a": 10,
      "u": "ml",
      "note": "去腥"
     },
     {
      "n": "盐",
      "a": 6,
      "u": "g",
      "note": "分次调味"
     }
    ]
   }
  ],
  "equipment": [
   "汤锅",
   "细筛",
   "蒸笼",
   "汤碗"
  ],
  "steps": [
   {
    "t": "娃娃菜剖成四瓣，只留菜心，修掉老梗，冷水浸泡 10 分钟捞出沥干。",
    "time": 10,
    "heat": "无火",
    "tip": "菜心要整瓣不散，修梗时从根部斜切。",
    "cue": "菜心完整、水分散尽"
   },
   {
    "t": "鸡胸肉剁成细茸，分次加 100ml 鸡汤解散成稀浆状。",
    "time": 8,
    "heat": "无火",
    "tip": "肉茸越细，扫出的汤越清。",
    "cue": "肉茸呈细腻浆状"
   },
   {
    "t": "鸡汤倒入汤锅，加姜片、葱段与料酒大火烧开，撇净浮沫后转小火。",
    "time": 12,
    "heat": "大火",
    "tip": "浮沫必须撇净，汤才不腥。",
    "cue": "汤面浮沫除尽、汤色清亮"
   },
   {
    "t": "把鸡胸肉茸浆缓缓倒入汤中，边倒边搅，小火微沸 30 分钟让肉茸吸附杂质。",
    "time": 30,
    "heat": "小火",
    "tip": "全程不能让汤翻滚，否则汤浑。",
    "cue": "肉茸结成灰白絮团浮起"
   },
   {
    "t": "用细筛滤出肉茸，汤回锅加盐、干贝与枸杞，小火保温备用。",
    "time": 5,
    "heat": "小火",
    "tip": "滤汤时不要挤压肉茸，避免汤色发浑。",
    "cue": "汤色清澈见底、咸鲜适口"
   },
   {
    "t": "菜心放进沸水焯 40 秒，立刻捞出过凉水定色。",
    "time": 4,
    "heat": "大火",
    "tip": "焯水时间宁短勿长，菜心要保持脆嫩。",
    "cue": "菜心翠绿透亮"
   },
   {
    "t": "菜心整齐码进汤碗，舀入清汤没过菜心，上蒸笼中火蒸 20 分钟。",
    "time": 20,
    "heat": "中火",
    "tip": "蒸制让菜心吸汤，比直接煮更清甜。",
    "cue": "菜心软嫩、汤面平静"
   },
   {
    "t": "出笼后重新淋一勺滚烫清汤，撒上葱丝即可上桌。",
    "time": 3,
    "heat": "无火",
    "tip": "二次淋汤冲开香气，是这道菜的关键仪式。",
    "cue": "汤清菜绿、葱丝浮面"
   }
  ],
  "tips": [
   "扫汤全程小火，汤一滚就浑。",
   "菜心焯水后必须过凉，颜色才翠绿。",
   "上桌前二次淋汤，香气才冲得出来。"
  ],
  "mistakes": [
   "汤大火滚煮，成品浑浊不清。",
   "菜心焯水太久，入口软塌无脆感。",
   "盐一次加太多，掩盖汤的鲜甜。"
  ],
  "subs": [
   {
    "orig": "娃娃菜",
    "sub": "大白菜心",
    "ratio": "600g 对 700g",
    "note": "大白菜梗厚，蒸制时间加 5 分钟。"
   },
   {
    "orig": "鸡汤",
    "sub": "鸡架高汤",
    "ratio": "1200ml 对 1200ml",
    "note": "需多撇两次浮油。"
   }
  ],
  "variations": [
   "加料版：清汤中加 10g 火腿片同滤，鲜味更厚。",
   "素版：鸡汤换菌菇高汤，用蛋清代替鸡胸肉扫汤。"
  ],
  "serving": "趁热喝汤吃菜，汤先入口最能体会清鲜。",
  "storage": "当天食用最佳，冷藏不超过 1 天，复热需隔水蒸。",
  "nutrition": {
   "basis": "每份（约 250g）",
   "kcal": 95,
   "protein": 10,
   "fat": 3,
   "carbs": 6,
   "sodium": 820
  },
  "safety": [
   "鸡汤需彻底烧开撇沫，禽类汤汁必须完全熟制。",
   "菜心焯水后立即食用或冷藏，避免长时间室温放置。",
   "干贝属贝类，过敏人群需替换为香菇。"
  ],
  "origin": "开水白菜是川菜清汤的代表作，看似白菜泡水，实则用鸡茸反复扫汤，把一锅浓汤吊成见底的清汤，是川菜里最难的家常菜。",
  "tags": [
   "川菜",
   "国宴",
   "清汤",
   "娃娃菜"
  ],
  "related_ids": [
   "mapo-doufu",
   "dandan-mian",
   "fuzhou-yuwan"
  ]
 },
 {
  "id": "suanrong-xilanhua",
  "zh": "蒜蓉西兰花",
  "en": "Broccoli with Garlic Sauce",
  "cuisine": "cantonese",
  "category": [
   "main-vegetable"
  ],
  "difficulty": 1,
  "prep": 12,
  "cook": 8,
  "servings": 2,
  "flavor": [
   "light",
   "fragrant",
   "umami"
  ],
  "ingredients": [
   {
    "group": "main",
    "items": [
     {
      "n": "西兰花",
      "a": 400,
      "u": "g",
      "note": "掰成均匀小朵"
     }
    ]
   },
   {
    "group": "aux",
    "items": [
     {
      "n": "大蒜",
      "a": 30,
      "u": "g",
      "note": "一半切末一半拍碎"
     },
     {
      "n": "小米辣",
      "a": 5,
      "u": "g",
      "note": "切圈，可省"
     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "盐",
      "a": 4,
      "u": "g",
      "note": "焯水与调味各半"
     },
     {
      "n": "蚝油",
      "a": 12,
      "u": "g",
      "note": "提鲜"
     },
     {
      "n": "玉米淀粉",
      "a": 5,
      "u": "g",
      "note": "调薄芡"
     },
     {
      "n": "植物油",
      "a": 20,
      "u": "ml",
      "note": "炒蒜"
     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "锅铲",
   "漏勺"
  ],
  "steps": [
   {
    "t": "西兰花掰成小朵，用淡盐水浸泡 8 分钟后冲洗干净，沥干水分。",
    "time": 8,
    "heat": "无火",
    "tip": "盐水浸泡能带出花蕾里的杂质。",
    "cue": "花朵紧实、沥水干爽"
   },
   {
    "t": "锅中水烧开加 2g 盐，下西兰花焯 90 秒，捞出立即过冷水。",
    "time": 3,
    "heat": "大火",
    "tip": "过冷水是保持翠绿的唯一办法。",
    "cue": "颜色转深绿、梗部半透明"
   },
   {
    "t": "大蒜切末、小米辣切圈，玉米淀粉加 25ml 清水调成水淀粉。",
    "time": 3,
    "heat": "无火",
    "tip": "蒜末现切现用，久放会发苦。",
    "cue": "蒜末细匀、芡水无颗粒"
   },
   {
    "t": "炒锅烧热倒 20ml 植物油，小火下蒜末与小米辣圈炒出香味。",
    "time": 2,
    "heat": "小火",
    "tip": "蒜末小火炒，火大立刻焦苦。",
    "cue": "蒜末金黄、香味扑鼻"
   },
   {
    "t": "转大火下西兰花翻炒 1 分钟，加蚝油与剩余 2g 盐，淋水淀粉翻匀收亮出锅。",
    "time": 2,
    "heat": "大火",
    "tip": "芡汁一挂就停火，久炒会出水。",
    "cue": "菜身油亮、芡汁薄薄挂住"
   }
  ],
  "tips": [
   "焯水加盐，菜梗更容易入味。",
   "蒜末分两次下锅，蒜香更立体。",
   "出锅前淋芡，汁能挂住不流盘。"
  ],
  "mistakes": [
   "焯水后不过冷水，颜色发黄。",
   "蒜末大火爆炒，直接炒成焦黑。",
   "西兰花炒太久，花朵散碎出水。"
  ],
  "subs": [
   {
    "orig": "西兰花",
    "sub": "菜心",
    "ratio": "400g 对 400g",
    "note": "菜心梗粗，焯水加 30 秒。"
   },
   {
    "orig": "蚝油",
    "sub": "生抽",
    "ratio": "12g 对 10ml",
    "note": "咸味略高，盐减 1g。"
   }
  ],
  "variations": [
   "蒜蓉蒸版：焯好后铺蒜末上锅蒸 4 分钟，清甜少油。",
   "加虾版：加 100g 虾仁同炒，鲜味更足。"
  ],
  "serving": "作为荤菜的配菜上桌，清爽解腻。",
  "storage": "冷藏 1 天，复热用大火快炒 1 分钟。",
  "nutrition": {
   "basis": "每份（约 230g）",
   "kcal": 145,
   "protein": 8,
   "fat": 10,
   "carbs": 12,
   "sodium": 720
  },
  "safety": [
   "西兰花需用盐水浸泡清洗，去除花蕾内泥沙。",
   "焯水后的西兰花需沥干再炒，防止溅油。",
   "蚝油含贝类成分，过敏人群改用生抽。"
  ],
  "origin": "蒜蓉西兰花是粤式家常菜里的清口担当，靠蒜香与薄芡把蔬菜的甜味提出来，做法简单但火候与芡汁很考功夫。",
  "tags": [
   "粤菜",
   "素菜",
   "快手",
   "蒜香"
  ],
  "related_ids": [
   "baizhuo-jielan",
   "haoyou-shengcai",
   "ganguo-huacai"
  ]
 },
 {
  "id": "congbaogui",
  "zh": "葱包桧",
  "en": "Scallion and Youtiao Roll",
  "cuisine": "zhejiang",
  "category": [
   "snack",
   "breakfast"
  ],
  "difficulty": 2,
  "prep": 15,
  "cook": 12,
  "servings": 3,
  "flavor": [
   "salty",
   "fragrant",
   "savory"
  ],
  "ingredients": [
   {
    "group": "main",
    "items": [
     {
      "n": "春卷皮",
      "a": 210,
      "u": "g",
      "note": "6 张，直径约 20cm"
     }
    ]
   },
   {
    "group": "aux",
    "items": [
     {
      "n": "油条",
      "a": 150,
      "u": "g",
      "note": "切成 12cm 长段"
     },
     {
      "n": "小葱",
      "a": 60,
      "u": "g",
      "note": "切 10cm 长段"
     },
     {
      "n": "甜面酱",
      "a": 40,
      "u": "g",
      "note": "涂抹与蘸食"
     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "植物油",
      "a": 30,
      "u": "ml",
      "note": "煎制"
     },
     {
      "n": "盐",
      "a": 2,
      "u": "g",
      "note": "葱段略撒"
     }
    ]
   }
  ],
  "equipment": [
   "平底锅",
   "锅铲",
   "砧板"
  ],
  "steps": [
   {
    "t": "小葱洗净沥干切成 10cm 长段，撒 2g 盐略腌 5 分钟；油条切成长段。",
    "time": 6,
    "heat": "无火",
    "tip": "葱段必须晾干，湿葱会把皮泡软。",
    "cue": "葱段挺直、表面无水"
   },
   {
    "t": "春卷皮平铺，抹一层甜面酱，放入油条与三四根葱段，卷紧后接口抹水粘牢。",
    "time": 6,
    "heat": "无火",
    "tip": "卷的时候两端折进来，煎时馅才不会掉。",
    "cue": "卷身紧实、接口贴合"
   },
   {
    "t": "平底锅刷 30ml 植物油，中火把春卷摆入，煎 4 分钟至底面金黄。",
    "time": 5,
    "heat": "中火",
    "tip": "油不要多，干煎才脆。",
    "cue": "底面出现金黄斑"
   },
   {
    "t": "翻面后用铲子逐个压扁，继续煎 3 分钟把两面压到起脆壳。",
    "time": 3,
    "heat": "中火",
    "tip": "压扁能让皮与馅贴紧，口感更脆。",
    "cue": "外皮薄脆、能听到沙沙声"
   },
   {
    "t": "出锅切成两段，趁热蘸剩余甜面酱食用。",
    "time": 2,
    "heat": "无火",
    "tip": "切的时候刀口要快，避免压散。",
    "cue": "断面层次分明、酱香扑鼻"
   }
  ],
  "tips": [
   "压扁这一步不能省，压过才脆。",
   "葱一定晾干，湿葱会让皮软塌。",
   "甜面酱先抹一层，卷里才够味。"
  ],
  "mistakes": [
   "油倒太多变成炸，外皮发硬吸油。",
   "春卷卷得太松，煎时馅料散出。",
   "小火慢煎，皮干硬不回软。"
  ],
  "subs": [
   {
    "orig": "油条",
    "sub": "春卷炸条",
    "ratio": "150g 对 150g",
    "note": "口感更脆，煎的时间减 1 分钟。"
   },
   {
    "orig": "春卷皮",
    "sub": "薄饼皮",
    "ratio": "210g 对 210g",
    "note": "薄饼皮更软，需多煎 1 分钟。"
   }
  ],
  "variations": [
   "加蛋版：卷好后浸一层蛋液再煎，外层更香。",
   "辣酱版：甜面酱换一半辣酱，甜辣交织。"
  ],
  "serving": "现煎现吃，配一碗豆浆就是杭州式早餐。",
  "storage": "当天吃完，冷藏后回锅干煎 2 分钟可回脆。",
  "nutrition": {
   "basis": "每份（约 150g）",
   "kcal": 330,
   "protein": 7,
   "fat": 18,
   "carbs": 36,
   "sodium": 690
  },
  "safety": [
   "煎制时油温较高，卷内可能有热汽，咬开时注意烫口。",
   "油条为油炸食品，需确认无哈喇味再使用。",
   "小葱需彻底洗净，生食部分注意清洁。"
  ],
  "origin": "葱包桧是杭州的街头早点，用春卷皮裹油条与小葱，压扁煎脆，名字里带着老百姓对秦桧的调侃，是很有烟火气的杭州味道。",
  "tags": [
   "浙菜",
   "小吃",
   "早餐",
   "杭州"
  ],
  "related_ids": [
   "shengjian-bao",
   "congyou-banmian",
   "shandong-jianbing"
  ]
 },
