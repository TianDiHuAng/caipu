     },
     {
      "n": "番茄酱",
      "a": 20,
      "u": "ml",
      "note": "蘸汁"
     },
     {
      "n": "生抽",
      "a": 10,
      "u": "ml",
      "note": "蘸汁"
     }
    ]
   }
