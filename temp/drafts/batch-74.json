    "time": 2,
    "heat": "小火",
    "tip": "小火慢淋，蛋液才成絮状而不浑浊。",
    "cue": "蛋花成片浮起、汤色清亮"
   },
   {
    "t": "放入紫菜再煮一分钟，撒入白胡椒粉搅匀后尝味。",
    "time": 2,
    "heat": "小火",
    "tip": "紫菜久煮发黏，一分钟足够出鲜味。",
    "cue": "紫菜舒展、汤色微绿"
   },
   {
    "t": "关火后淋上香油、撒上葱花，盛入汤碗趁热喝最鲜。",
    "time": 1,
    "heat": "无火",
    "tip": "香油最后放，久煮会散掉香气。",
    "cue": "汤面浮油花、葱花翠绿"
