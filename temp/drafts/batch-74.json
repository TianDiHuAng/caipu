   {
    "t": "鲤鱼去鳞去鳃去内脏，洗净后撕掉腹内黑膜，用厨房纸擦干。",
    "time": 8,
    "heat": "无火",
    "tip": "黑膜和贴骨血是腥味来源，一定清干净。",
    "cue": "鱼身干爽、腹内洁净"
   },
   {
    "t": "在鱼身两面每隔两厘米剞一字花刀，深至鱼骨但不切断。",
    "time": 6,
    "heat": "无火",
    "tip": "花刀深度到骨，炸后才会翻花定型好看。",
    "cue": "刀口均匀、深至鱼骨"
   },
   {
    "t": "鱼身内外抹盐和料酒，塞入姜片葱段腌十五分钟去腥。",
    "time": 15,
    "heat": "无火",
    "tip": "腌鱼时间够，后面调味才不会被腥味压住。",
    "cue": "鱼身微湿、葱姜贴服"
   },
   {
    "t": "淀粉、面粉、鸡蛋液加少许清水调成能挂住鱼身的面糊。",
    "time": 4,
    "heat": "无火",
    "tip": "面糊调到提起勺子能缓慢流下，太稀挂不住、太厚发硬。",
    "cue": "面糊顺滑、提起能拉线"
   },
   {
    "t": "提着鱼尾把面糊均匀淋满鱼身，刀口处要掰开灌满面糊。",
    "time": 4,
    "heat": "无火",
    "tip": "刀口灌满面糊，炸时才会开出花形。",
    "cue": "鱼身裹糊均匀、刀口饱满"
   },
   {
    "t": "锅中倒植物油烧到六成热，提着鱼尾先下鱼头炸定型，再整条滑入。",
    "time": 3,
    "heat": "中大火",
    "tip": "先定型鱼头再放鱼身，鱼才不会粘成弯月。",
    "cue": "鱼头定型、糊壳转浅黄"
   },
   {
    "t": "中火炸十分钟至外壳金黄酥脆，捞出控油装盘。",
    "time": 10,
    "heat": "中火",
    "tip": "炸的过程用勺把热油浇在鱼背上，受热才匀。",
    "cue": "外壳金黄脆硬、鱼身挺立"
   },
   {
    "t": "另起锅放少许油，下番茄酱、白糖、香醋、生抽和半碗清水煮开。",
    "time": 3,
    "heat": "中火",
    "tip": "酸甜汁先尝味道，酸了加糖、甜了加醋。",
    "cue": "酱汁冒泡、颜色红亮"
   },
   {
    "t": "淋入水淀粉勾芡到能挂勺，浇一勺热油把汁推亮。",
    "time": 2,
    "heat": "中火",
    "tip": "明油让酱汁透亮，浇在鱼身上才漂亮。",
    "cue": "酱汁浓稠透亮、无结块"
   },
   {
    "t": "趁热把糖醋汁浇满整条鱼身，撒上葱丝立刻端上桌。",
    "time": 1,
    "heat": "无火",
    "tip": "汁一定要浇在刚炸好的鱼上，才有酥脆声。",
    "cue": "汁液流挂鱼身、外壳仍脆"
   }
  ],
  "tips": [
   "鲤鱼选一斤半左右的活鱼，太大肉粗、太小刺多。",
   "面糊要稠到提起勺子能缓慢流下，太稀挂不住鱼身。",
   "糖醋汁比例约糖六醋四，可按口味微调。"
  ],
  "mistakes": [
   "花刀太浅，炸后鱼身不开花，造型扁塌。",
   "面糊太稀，下锅就滑落，炸出来皮不脆。",
   "糖醋汁勾芡过稠，浇上后结成硬块。"
