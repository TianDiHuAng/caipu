  ],
  "steps": [
   {
    "t": "鲜鲍鱼用刷子刷净壳面与裙边黑膜，挖出鲍肉去掉内脏团。",
    "time": 8,
    "heat": "无火",
    "tip": "裙边黑膜最腥，刷到发白才算干净。",
    "cue": "鲍肉洁白、裙边无黑膜"
   },
   {
    "t": "在鲍鱼肉厚处剞十字花刀，深度到三分之二但不切断。",
    "time": 5,
    "heat": "无火",
    "tip": "剞花刀让鲍肉受热均匀，也更容易入味。",
    "cue": "花刀均匀、鲍肉不散"
   },
   {
    "t": "锅中水烧开加料酒和姜片，鲍鱼焯三十秒后捞出过凉水。",
    "time": 3,
    "heat": "大火",
    "tip": "焯水时间短，久了鲍肉会缩成硬块。",
    "cue": "鲍肉微卷、表面收紧"
   },
   {
    "t": "炒锅放植物油，下姜片、蒜和葱段小火爆香，加冰糖炒到化开。",
    "time": 3,
    "heat": "小火",
    "tip": "冰糖炒到浅琥珀色，成菜才红亮不发黑。",
    "cue": "糖色浅褐、香气散出"
   },
   {
    "t": "倒入清水，加蚝油、生抽、老抽和料酒煮开成卤汁。",
    "time": 3,
    "heat": "中火",
    "tip": "卤汁先调好再下鲍鱼，味道才均匀。",
    "cue": "卤汁红亮、咸香扑鼻"
   },
   {
    "t": "放入鲍鱼小火焖二十五分钟，中途翻面一次让两面入味。",
    "time": 25,
    "heat": "小火",
    "tip": "小火慢焖，鲍肉才软糯不韧。",
    "cue": "鲍肉软弹、筷子能插入"
   },
   {
    "t": "开大火把汁收到浓稠，淋水淀粉勾薄芡，浇在鲍鱼上装盘。",
    "time": 3,
    "heat": "大火",
    "tip": "芡要薄，能挂住鲍身即可，太厚糊口。",
    "cue": "酱汁浓亮挂身、盘底少汁"
   }
  ],
  "tips": [
   "鲜鲍选肉质厚、裙边紧实的，按压有弹性最新鲜。",
   "干鲍需提前泡发三天，本做法不适用。",
   "没有冰糖可用白糖，但上色和亮度略差。"
  ],
  "mistakes": [
   "内脏没去净就下锅，成品带苦味和腥气。",
   "全程大火焖煮，鲍肉紧成橡皮，嚼不动。",
   "糖色炒得过头发黑，卤汁带上焦苦味，颜色也发暗。"
  ],
  "subs": [
   {
    "orig": "鲍鱼",
    "sub": "杏鲍菇",
    "ratio": "500g 对 400g",
    "note": "素做口感接近，焖煮时间减半。"
   },
   {
    "orig": "蚝油",
    "sub": "鲍鱼汁",
    "ratio": "20ml 对 20ml",
    "note": "鲜味更集中，生抽可略减。"
   }
  ],
  "variations": [
   "加几片金华火腿同焖，鲜味更立体也更咸香。",
   "配焯水西兰花围边，做成年夜饭上的整只摆盘。"
  ],
  "serving": "整只盛盘淋汁，配白饭或作宴席头菜。",
  "storage": "冷藏两天，复热加少许清水小火焖五分钟。",
  "nutrition": {
   "basis": "每份（约 170g）",
   "kcal": 210,
   "protein": 26,
   "fat": 8,
   "carbs": 8,
   "sodium": 900
  },
  "safety": [
   "鲍鱼必须彻底加热至肉质软弹、中心熟透，生食有寄生虫风险。",
   "死鲍、异味鲍不得使用，内脏团必须清除干净。",
   "贝类属高致敏食材，过敏体质者慎食；成品冷藏不超过两天。"
  ],
  "origin": "红烧鲍鱼是粤菜宴席上的重头戏，讲究「鲍汁扣」的做法。鲜鲍刷净去内脏，剞花刀焯水，用蚝油冰糖小火慢焖，收汁勾薄芡。成菜鲍肉软滑弹牙，酱汁浓郁，是广东人过节必点的一道好意头菜。",
  "tags": [
   "粤菜",
   "焖",
   "海鲜",
   "宴客"
  ],
  "related": [
   "baiqie-ji",
