    "steps": [
      {
        "t": "老鸭剁成三厘米小块，用清水冲两遍去血水，沥干备用。",
        "time": 12,
        "heat": "无火",
        "tip": "老老鸭块剁小些才容易炒透，鸭血才挂得住。",
        "cue": "老鸭块大小均匀，水清不浑"
      },
      {
        "t": "鸭血倒进碗里，加米醋与两勺清水搅匀，防止凝固成块。",
        "time": 4,
        "heat": "无火",
        "tip": "醋能让鸭血保持流动，倒进锅里才能裹匀每块肉。",
        "cue": "鸭血呈暗红流动状，无凝块"
      },
      {
        "t": "姜切片，蒜拍碎，小米辣切圈，紫苏与青蒜切好分开装。",
        "time": 7,
        "heat": "无火",
        "tip": "紫苏是这锅菜的魂，少了就只剩辣味。",
        "cue": "配料分色码放，紫苏碎翠紫"
      },
      {
        "t": "炒锅倒植物油烧热，下姜片与蒜爆香三十秒。",
        "time": 2,
        "heat": "中火",
        "tip": "姜蒜先炝锅，肉腥味能压掉大半。",
        "cue": "姜片卷边，蒜香冒出"
      },
      {
        "t": "倒入老老鸭块大火翻炒，炒到表面变白、水分收干。",
        "time": 8,
        "heat": "大火",
        "tip": "老老鸭块水汽一定炒干，不然最后的血汁会稀。",
        "cue": "表皮收紧发黄，锅底无汤水"
      },
      {
        "t": "沿锅边淋料酒，加生抽、老抽与盐，翻炒两分钟上色。",
        "time": 3,
        "heat": "大火",
        "tip": "老抽只为上色，多了整锅发黑。",
        "cue": "老老鸭块均匀上酱色，油光发亮"
      },
      {
        "t": "加两百毫升热水，盖盖中小火焖十五分钟至老老鸭肉将熟。",
        "time": 16,
        "heat": "中火",
        "tip": "水别多，焖完要留一点底汤给鸭血用。",
        "cue": "汤汁剩三分之一，肉质能用筷子戳动"
      },
      {
        "t": "开盖下小米辣，大火收汁至汤汁略稠，翻炒一分钟。",
        "time": 3,
        "heat": "大火",
        "tip": "辣椒后放，辣味清亮不闷。",
        "cue": "汤汁浓稠挂勺，辣香冲鼻"
      },
      {
        "t": "转小火，把鸭血分三次淋入锅中，边淋边快速翻炒。",
        "time": 4,
        "heat": "小火",
        "tip": "必须小火分次淋，一次倒进去血就结块了。",
        "cue": "鸭血裹满老老鸭块，颜色转深红亮"
      },
      {
        "t": "血汁裹匀后关火，撒紫苏与青蒜段，再撒白胡椒，翻两下盛盘。",
        "time": 2,
        "heat": "无火",
        "tip": "紫苏靠余温激香，久炒发黑发苦。",
        "cue": "老老鸭块暗红油亮，紫苏青蒜点缀"
      }
    ],
    "tips": [
      "鸭血要现杀现接，凝固久了的血做不出这种挂浆效果。",
      "老鸭肉选两年的，肉紧味浓，过嫩的反而没嚼头。",
      "全程别加水太多，这道菜讲究干香，汁多就成血汤了。",
      "怕辣可减小米辣，但紫苏不能省。"
    ],
    "mistakes": [
      "鸭血直接倒进大火锅里，瞬间凝成块，裹不上老老鸭块。",
      "老老鸭块水汽没炒干就加水焖，最后的血汁稀得像汤。",
      "紫苏下锅早炒，颜色发黑，香气也散了。"
    ],
