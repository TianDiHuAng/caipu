    "steps": [
      {
        "t": "虾仁挑去背上的肠线，用少许盐抓洗后冲净，厨房纸吸干。",
        "time": 8,
        "heat": "无火",
        "tip": "虾仁用盐抓洗能去黏液，汤才不会腥。",
        "cue": "虾仁透亮，表面干爽"
      },
      {
        "t": "猪里脊逆纹切成两毫米薄片，加料酒与淀粉抓匀上浆。",
        "time": 6,
        "heat": "无火",
        "tip": "上浆后肉片下锅才嫩，煮久了也不柴。",
        "cue": "肉片薄透挂浆，碗底无余水"
      },
      {
        "t": "白菜洗净切片，香菇切片，姜切丝，火腿切成薄片。",
        "time": 7,
        "heat": "无火",
        "tip": "火腿切薄片更容易出味，咸鲜是汤底的主力。",
        "cue": "配料切配整齐，分盘摆放"
      },
      {
        "t": "汤锅倒植物油烧热，下姜丝小火炒三十秒，炒出姜香。",
        "time": 2,
        "heat": "小火",
        "tip": "姜丝炒过再用，去腥效果比直接煮强得多。",
        "cue": "姜丝微卷，香味飘出"
      },
      {
        "t": "倒入八毫升清水烧开，下白菜与香菇，中火煮五分钟。",
        "time": 7,
        "heat": "中火",
        "tip": "白菜先煮出甜味，汤底才清鲜不寡淡。",
        "cue": "白菜变软透明，汤色微白"
      },
      {
        "t": "转小火，把肉片一片片抖散下锅，煮两分钟至变色。",
        "time": 3,
        "heat": "小火",
        "tip": "肉片逐片下，一坨倒进去会粘成一块。",
        "cue": "肉片浮起，颜色转浅"
      },
      {
        "t": "下虾仁与火腿片，中火煮三分钟，虾仁卷曲变红即可。",
        "time": 4,
        "heat": "中火",
        "tip": "虾仁久煮会老，卷成弯月形就关火。",
        "cue": "虾仁卷曲发红，火腿片卷边"
      },
      {
        "t": "撇去汤面浮沫，加盐与白胡椒调味，撒葱段关火。",
        "time": 3,
        "heat": "无火",
        "tip": "盐最后放，早了虾仁和肉片都会发紧。",
        "cue": "汤色清亮，葱花翠绿"
      }
    ],
    "tips": [
      "三鲜没有固定搭配，虾、肉、火腿是最常见的组合。",
      "想更鲜可加两片金华火腿，汤底立刻上一个层次。",
      "白菜换成娃娃菜更甜，煮的时间可减两分钟。",
      "汤要清就别大火滚，中小火保持微沸最稳。"
    ],
    "mistakes": [
      "虾仁不下锅前处理，腥味全留在汤里。",
      "肉片一次全倒进去，粘成一坨，汤也变浑。",
      "煮的时间过长，虾仁缩成硬球，肉片发柴。"
    ],
    "subs": [
      {
        "orig": "火腿",
        "sub": "咸肉",
        "ratio": "80克:80克",
        "note": "需先焯水去咸，煮制时间加五分钟。"
      },
      {
        "orig": "白菜",
        "sub": "娃娃菜",
        "ratio": "200克:200克",
        "note": "更甜，煮制时间减两分钟。"
      }
    ],
    "variations": [
      "加一把粉丝同煮，做成汤粉，能当一顿饭。",
      "把清汤换成高汤打底，鲜味更厚，是宴席版本。"
    ],
    "serving": "三人份汤菜，饭前先喝一碗，或配米饭作为一餐。",
    "storage": "冷藏一天内喝完，复热要滚开；虾仁复热后会稍老，建议现做现喝。",
    "nutrition": {
      "basis": "按三人份估算",
      "kcal": 210,
