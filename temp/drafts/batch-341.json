  "steps": [
   {
    "t": "牛腩切两厘米方块，用厨房纸吸干表面水分，撒一点盐抓匀。",
    "time": 7,
    "heat": "无火",
    "tip": "表面吸干再煎，肉才会上色而不是出水。",
    "cue": "肉块干爽，表面微白"
   },
   {
    "t": "汤锅放植物油中火烧热，牛腩分批下锅煎到六面焦褐后取出。",
    "time": 12,
    "heat": "中火",
    "tip": "分批煎，锅温才不掉，焦褐色是汤香的来源。",
    "cue": "肉块焦褐，锅底留香"
   },
   {
    "t": "原锅下洋葱丁，中小火炒五分钟到软塌透明，锅底焦屑刮起。",
