  "tags": [
   "东欧菜",
   "乌克兰",
   "汤",
   "牛肉",
   "甜菜根"
  ],
  "safety": [
   "牛腩须炖至中心熟透、能轻松咬断；汤品冷藏后复热须彻底煮沸，酸奶油须冷藏保存并在盛碗后加入。"
  ],
  "origin": "罗宋汤在乌克兰家家有自己的配方，甜菜根给出那抹标志性的艳红。牛腩先炖出汤底，甜菜根和番茄膏炒出颜色，最后放土豆和卷心菜。盛碗时一勺酸奶油化在红汤里，是当地冬天的日常。",
  "prep": 8,
  "cook": 108,
  "overwrite": true
 },
