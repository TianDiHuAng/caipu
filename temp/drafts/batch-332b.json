  "steps": [
   {
    "t": "草鱼去鳞去内脏洗净，取中段斜切成两厘米厚的鱼块。",
    "time": 8,
    "heat": "无火",
    "tip": "沿鱼骨方向斜切，鱼块带一层皮才炸得住，纯肉块一炸就散。",
    "cue": "鱼块厚薄一致，带皮完整"
   },
   {
    "t": "鱼块加盐、料酒与姜片抓匀，腌二十分钟去腥。",
    "time": 12,
    "heat": "无火",
    "tip": "腌够时间鱼肉才紧，腌短了下锅易碎，腥味也带不进卤里。",
    "cue": "鱼块表面发紧，盆底有汁"
   },
   {
    "t": "生抽、冰糖、香醋、八角、桂皮与清水煮开，小火熬成浓卤汁放凉。",
    "time": 8,
    "heat": "小火",
    "tip": "卤汁必须熬到微稠并彻底放凉，热卤泡鱼会烫软鱼皮。",
    "cue": "卤汁挂勺，颜色深红发亮"
   },
   {
    "t": "植物油烧至六成热，鱼块擦干水分下锅，中火炸五分钟捞出。",
    "time": 10,
    "heat": "中火",
    "tip": "鱼块下锅前一定擦干，带水下油锅会猛烈爆溅，手背易被烫伤。",
    "cue": "鱼块金黄，表面结硬壳"
   },
   {
    "t": "油温回升后复炸一分钟，趁热浸入凉卤汁，泡三分钟捞出装盘。",
    "time": 10,
    "heat": "大火",
    "tip": "复炸用植物油再炸一分钟，外壳更脆，热鱼入凉卤才吸得进味。",
    "cue": "鱼皮起泡，卤汁渗入肉纹"
   }
  ],
  "tips": [
   "熏鱼其实不熏，是炸过再浸卤，苏式做法讲究甜中带酸。",
   "卤汁一次可以多熬些，冷藏起来下次直接用。",
   "用青鱼做更传统，肉质更厚，浸卤后更入味。"
  ],
  "mistakes": [
   "鱼块没擦干就下油锅，油花四溅还炸不脆。",
   "卤汁是热的就泡鱼，鱼皮软烂，一点脆劲都没有。",
   "只炸一遍就浸卤，外壳吸汁后立刻回软，口感发绵。"
  ],
  "subs": [
