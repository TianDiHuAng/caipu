     }
    ]
   }
  ],
  "equipment": [
   "蒸锅",
   "鱼盘",
   "小锅"
  ],
  "steps": [
   {
    "t": "鲈鱼去鳞去内脏洗净，在鱼身两面各斜划三刀，用料酒和盐抹匀腌十分钟。",
    "time": 10,
    "heat": "无火",
    "tip": "划刀处深至骨，热气才能透进去。",
    "cue": "鱼身划口均匀、表面微湿"
   },
   {
    "t": "鱼盘底部铺姜片与葱段，把鲈鱼架在上面，鱼腹内也塞几片姜。",
    "time": 3,
    "heat": "无火",
    "tip": "垫起来蒸，鱼身受热更均匀。",
    "cue": "鱼身平稳、不贴盘底"
   },
   {
    "t": "蒸锅水烧大开后放鱼盘，加盖大火蒸八分钟，关火虚蒸两分钟。",
    "time": 10,
    "heat": "大火",
    "tip": "水开再上锅，鱼肉才嫩不腥。",
    "cue": "鱼眼凸白、鱼身骨肉微离"
   },
   {
    "t": "取出鱼盘倒掉蒸出的腥水，拣掉姜葱，重新铺上葱丝与姜丝。",
    "time": 2,
    "heat": "无火",
    "tip": "盘里的水一定要倒掉，否则腥味重。",
    "cue": "盘中清爽无积水"
   },
   {
    "t": "小锅烧热植物油到微微冒烟，均匀浇在葱姜丝上激出香味。",
    "time": 1,
    "heat": "大火",
    "tip": "油要够热，浇下去要有响声。",
    "cue": "葱丝卷曲、香气四溢"
   },
   {
    "t": "沿盘边淋入蒸鱼豉油，趁热上桌，吃时蘸汁夹肉。",
    "time": 1,
    "heat": "无火",
    "tip": "豉油沿盘边淋，鱼皮不受潮。",
    "cue": "盘底酱汁清亮、鱼肉雪白"
   }
  ],
  "tips": [
   "一斤左右的鱼蒸八分钟最嫩，鱼大要加时间。",
   "蒸鱼豉油可自己用生抽加糖和水调。",
   "千万别提前淋豉油再蒸，肉会变柴。"
  ],
  "mistakes": [
   "冷水上锅蒸，鱼肉外老内生。",
   "蒸好后不倒腥水，整道菜带土腥味。",
   "大火蒸过头，鱼肉散成一片片。"
  ],
  "subs": [
   {
    "orig": "鲈鱼",
    "sub": "鲳鱼",
    "ratio": "600g 对 600g",
    "note": "鲳鱼蒸六分钟即可，肉质更紧。"
   },
   {
    "orig": "蒸鱼豉油",
    "sub": "生抽加白糖",
    "ratio": "30ml 对 25ml 加 3g",
    "note": "加少量清水稀释，咸度接近。"
   }
  ],
  "variations": [
   "鱼身下铺几片火腿，鲜味更上一层。",
   "出锅前淋一勺猪油代替植物油，香气更浓。"
  ],
  "serving": "整条上桌，配白饭与清炒青菜。",
  "storage": "现蒸现吃，冷藏后鱼肉回生，不建议存放。",
  "nutrition": {
   "basis": "每份（约 200g）",
   "kcal": 260,
   "protein": 34,
   "fat": 12,
   "carbs": 3,
   "sodium": 720
  },
  "safety": [
   "鲈鱼必须蒸至鱼肉完全变白、骨肉分离，不可带生。",
   "处理活鱼时注意鱼鳍扎手，刀具与案板用后清洗。",
   "鱼类易变质，冷藏保存不超过一天。"
  ],
  "origin": "清蒸鲈鱼是苏帮菜里最见功夫的一道，讲究水宽火旺、一气蒸成。鱼身划刀、垫姜葱、沸水入锅，出锅倒腥水、铺新葱丝、浇滚油、淋豉油，四步做对，鱼肉雪白细嫩，一点不腥。",
  "tags": [
   "苏菜",
   "蒸",
   "鲜",
   "宴客"
  ],
  "related": [
   "cantonese-suanrong-fensi-zheng-shanbei",
   "shandong-ganjian-daiyu"
  ]
 },
