  "steps": [
   {
    "t": "牛肩肉整块放进汤锅，加半个洋葱、蒜和清水，小火煮四十分钟。",
    "time": 45,
    "heat": "小火",
    "tip": "整块煮再撕丝，肉纤维长，口感才有嚼头。",
    "cue": "汤面微滚，肉色转灰"
   },
   {
    "t": "肉煮到筷子能轻松扎透就捞出，晾十分钟到不烫手。",
    "time": 13,
    "heat": "无火",
    "tip": "晾一下再撕，太烫撕不细，凉透又撕不动。",
    "cue": "肉块松软，按压回弹"
   },
   {
    "t": "顺着纹理把肉撕成细丝，粗的地方用手撕开，别用刀切。",
    "time": 10,
    "heat": "无火",
    "tip": "手撕的断面毛糙，挂酱比刀切的好得多。",
    "cue": "肉丝细长，断面毛糙"
   },
   {
    "t": "番茄切块用搅拌机打成泥，洋葱切丝，辣椒切圈备用。",
    "time": 8,
    "heat": "无火",
    "tip": "番茄打成泥，炒的时候出汁快，颜色也匀。",
    "cue": "番茄泥顺滑，色红"
   },
   {
    "t": "炒锅放植物油烧热，下洋葱丝炒四分钟到软甜发亮。",
    "time": 5,
    "heat": "中火",
    "tip": "洋葱炒透出甜，是汀加底味的关键。",
    "cue": "洋葱透明，锅底微焦"
   },
   {
    "t": "加番茄膏和辣椒圈炒一分钟出红油，倒番茄泥炒五分钟收浓。",
    "time": 7,
    "heat": "中火",
    "tip": "番茄膏先炒出红油，颜色才深，不然发粉。",
    "cue": "酱汁浓稠，油色发红"
   },
   {
    "t": "把肉丝倒进酱里，加牛至、孜然和盐，中火翻拌六分钟入味。",
    "time": 7,
    "heat": "中火",
    "tip": "多翻几下让每根肉丝都裹上酱，干一点更香。",
    "cue": "肉丝裹酱，锅里无水"
   },
   {
    "t": "盛盘后放牛油果片和香菜碎，配玉米饼或者放在脆饼上吃。",
    "time": 4,
    "heat": "无火",
    "tip": "牛油果最后切，早切会氧化发黑。",
    "cue": "酱色深红，牛油果翠绿"
   }
  ],
  "tips": [
   "汀加是把煮软的肉撕丝再回锅炒酱，鸡肉版更常见，牛肉版更浓。",
   "肉丝一定要手撕，刀切的断面光，挂不住酱。",
   "炒到锅底没有明显汤汁为止，干香才对。"
  ],
  "mistakes": [
   "肉煮过头，撕的时候全烂成一团泥。",
   "酱汁没炒干就起锅，装盘一放就流一滩汤。",
   "辣椒放太多，辣味盖住番茄和肉的香。"
  ],
  "subs": [
