    "ratio": "100克:80克",
    "note": "酸奶油更清凉，配辣酱很解辣。"
   }
  ],
  "variations": [
   "把肉丝和酱一起夹进玉米饼，做成汀加塔可，最受欢迎。",
   "加一勺黑豆泥同炒，酱更厚，也能多喂一个人。"
  ],
  "serving": "铺在脆饼上做成托斯塔达，或者夹玉米饼配酸奶油一起吃。",
  "storage": "冷藏三天，冷冻一个月；复热用炒锅小火加一勺清水回软。",
