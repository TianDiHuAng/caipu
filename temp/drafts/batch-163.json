  "steps": [
   {
    "n": 1,
    "t": "茭白剥去外层老壳削掉根部老皮，切成火柴棍粗细的丝。",
    "time": 8,
    "heat": "无火",
    "tip": "外皮一定要削净，留着炒出来发韧。",
    "cue": "茭白丝白净匀称，断面水润"
   },
   {
    "n": 2,
    "t": "猪里脊逆着纹理切细丝，加生抽和黄酒抓匀腌上十分钟。",
    "time": 10,
    "heat": "无火",
    "tip": "逆纹切口感才嫩，顺纹切嚼不动。",
    "cue": "肉丝松散挂汁，碗底无血水"
   },
   {
    "n": 3,
    "t": "炒锅烧热倒植物油，下肉丝大火滑散，变色后盛出备用。",
    "time": 2,
    "heat": "大火",
    "tip": "肉丝下锅别急着翻，定住后再炒才不粘。",
    "cue": "肉丝根根分开，色转浅白"
   },
   {
    "n": 4,
    "t": "原锅下蒜片爆香，倒入茭白丝大火翻炒到边缘变透明。",
    "time": 3,
    "heat": "大火",
    "tip": "茭白含水多，大火快炒才脆不塌。",
    "cue": "茭白丝透亮，锅里有清甜气"
   },
   {
    "n": 5,
    "t": "沿锅边淋少许清水略焖，加盐和白糖翻匀提味。",
    "time": 3,
    "heat": "大火",
    "tip": "少量水焖一下，茭白才不会外软内生。",
    "cue": "水汽收干，丝身油亮"
   },
   {
    "n": 6,
    "t": "倒回肉丝炒匀，撒葱段翻两下立刻出锅装盘。",
    "time": 2,
    "heat": "大火",
    "tip": "肉丝回锅只炒三十秒，久了发柴。",
    "cue": "肉丝与茭白分明，葱段翠绿"
   }
  ],
  "tips": [
   "茭白外层老壳要削净，否则口感发韧。",
   "肉丝逆纹切、大火滑炒，嫩度差很多。",
   "茭白含水多，全程大火不盖盖才脆。"
  ],
  "mistakes": [
   "茭白不削皮直接切丝，成品嚼着像草。",
   "肉丝小火慢炒，出水后变得又老又硬。",
   "炒茭白时盖盖焖久，丝全软塌发黄。"
  ],
  "subs": [
   {
    "orig": "茭白",
    "sub": "冬笋",
    "ratio": "350 克:350 克",
    "note": "口感更脆，需先焯水去涩再炒。"
   },
   {
    "orig": "猪里脊",
    "sub": "鸡胸肉",
    "ratio": "150 克:150 克",
    "note": "脂肪更少，腌时加少许油防干柴。"
   }
  ],
  "variations": [
   "加几只虾仁同炒，鲜味更足也更清爽。",
   "放一点红椒丝配色，卖相更清爽。"
  ],
  "serving": "热吃最鲜，配米饭或稀粥都清爽下饭。",
  "storage": "冷藏一天，复热用炒锅大火快翻，别加水久煮。",
  "allergens": [
   "soy"
  ],
  "nutrition": {
   "basis": "每份约 180 克",
   "kcal": 220,
   "protein": 17,
   "fat": 14,
   "carbs": 6,
   "sodium": 560
  },
  "safety": [
   "茭白属水生蔬菜，需削净外皮并充分加热；肉丝须炒到完全变色，剩菜冷藏一天内复热透。"
  ],
  "origin": "皖南水乡的家常菜，茭白一上市就配肉丝快炒。安徽人做这菜讲三点：茭白削净皮、肉丝逆纹切、全程大火，做出来清甜爽口，比肉还抢手。",
  "tags": [
   "安徽",
   "茭白",
   "肉丝",
   "家常"
  ]
