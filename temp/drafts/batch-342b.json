  "steps": [
   {
    "t": "面粉加盐和清水揉成偏硬的面团，反复揉十分钟到表面光滑。",
    "time": 14,
    "heat": "无火",
    "tip": "面要硬一点，揉透了拉的时候才不断。",
    "cue": "面团紧实，表面光洁"
   },
   {
    "t": "面团盖布醒四十分钟，中途再揉一次，让面筋完全松弛。",
    "time": 44,
    "heat": "无火",
    "tip": "醒面不足，拉条子一拉就回缩断条。",
    "cue": "面团柔软，按下去慢回弹"
   },
   {
    "t": "面团搓成粗条刷油，盘在盆里再醒二十分钟。",
    "time": 23,
    "heat": "无火",
    "tip": "每根都刷到油，盘着放不会粘连。",
    "cue": "条面油亮，盘放整齐"
   },
   {
    "t": "羊肉切薄片，用一点生抽抓匀腌十分钟去膻。",
    "time": 12,
    "heat": "无火",
    "tip": "切得越薄，炒的时候越嫩，也不容易柴。",
    "cue": "肉片薄匀，表面微黏"
   },
   {
    "t": "炒锅放植物油烧到七成热，羊肉下锅大火滑炒两分钟到变色盛出。",
    "time": 6,
    "heat": "大火",
    "tip": "大火快炒锁住肉汁，炒久了肉就老。",
    "cue": "肉片变色，边缘微焦"
   },
   {
    "t": "原锅下洋葱丝炒一分钟，加番茄块和番茄膏炒三分钟出红汁。",
    "time": 7,
    "heat": "大火",
    "tip": "番茄炒出汁再下别的菜，拌面才有汁挂。",
    "cue": "汤汁发红，锅里冒泡"
   },
   {
    "t": "放青椒块和芹菜段炒两分钟，倒回羊肉，加孜然、辣椒面和盐炒匀。",
    "time": 5,
    "heat": "大火",
    "tip": "孜然最后放，香气才冲，早放会炒糊。",
    "cue": "菜色鲜亮，孜然飘香"
   },
   {
    "t": "汤锅烧水，面条拉细下锅煮三分钟，捞出过一下热水装碗。",
    "time": 8,
    "heat": "大火",
    "tip": "拉细一点好熟，煮到没有硬芯就捞。",
    "cue": "面条浮起，色白透亮"
   },
   {
    "t": "把炒好的菜连汁浇在面上，撒大蒜片，拌开吃。",
    "time": 3,
    "heat": "无火",
    "tip": "汁要够，拌的时候每根面都裹上红汤。",
    "cue": "面碗红亮，蒜香扑鼻"
   }
  ],
  "tips": [
   "拌面是新疆人的工作餐，面和菜分开做，吃时再拌。",
   "面和硬、醒透、刷油，三步做到拉条子就不断。",
   "炒菜的汁要留多一点，拌面全靠这口汤。"
  ],
  "mistakes": [
