    "time": 4,
    "heat": "中火",
    "tip": "先翻炒让食材裹上油，再加水焖。",
    "cue": "食材裹油发亮，颜色分明"
   },
   {
    "n": 6,
    "t": "加清水、盐和辣椒粉，盖盖小火焖二十分钟。",
    "time": 20,
    "heat": "小火",
    "tip": "水要没过食材一指，焖到玉米断生。",
    "cue": "汤汁微滚，玉米粒饱满"
   },
   {
    "n": 7,
    "t": "开盖把汤汁收一收，撒上香菜碎就可以端上桌。",
    "time": 3,
    "heat": "中火",
    "tip": "收汁留一点汤，拌饭拌玉米糊都好吃。",
    "cue": "汤汁略稠，香菜翠绿"
   }
