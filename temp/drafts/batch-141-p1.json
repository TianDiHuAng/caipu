  "steps": [
   {
    "n": 1,
    "t": "花生用干锅小火炒八分钟到表皮起斑，晾凉后搓掉外皮。",
    "time": 10,
    "heat": "小火",
    "tip": "炒到表皮开裂就好，炒过头会发苦。",
    "cue": "花生表皮起褐色斑点"
