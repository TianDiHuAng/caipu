  "steps": [
   {
    "n": 1,
    "t": "面粉加盐和白糖拌匀，分次倒入二百六十毫升清水，揉成偏软的面团。",
    "time": 10,
    "heat": "无火",
    "tip": "水要分三次倒，一次倒完很难揉匀。",
    "cue": "面团成团，盆里无干粉"
   },
   {
    "n": 2,
    "t": "面团移到抹了植物油的案板，反复揉十分钟到表面光滑有弹性。",
    "time": 11,
    "heat": "无火",
    "tip": "揉到能拉出半透明的薄片，饼才有层次。",
    "cue": "面团光滑，按压回弹"
   },
   {
    "n": 3,
    "t": "面团分成八份滚圆，每份抹一层植物油，盖布醒二十分钟。",
    "time": 20,
    "heat": "无火",
    "tip": "一定要抹油盖布，暴露在空气里会结皮。",
    "cue": "面团柔软，按压不粘手"
   },
   {
    "n": 4,
    "t": "取一份面团用手压成薄片，尽量推得薄，刷一层融化黄油。",
    "time": 5,
    "heat": "无火",
    "tip": "手推比擀更容易出层次，别用力压破。",
    "cue": "薄片透光，边缘略卷"
   },
   {
    "n": 5,
    "t": "把薄片像折信纸一样折成方块，再轻轻压扁成一厘米厚。",
    "time": 5,
    "heat": "无火",
    "tip": "折叠时把四边往里收，层数才多。",
    "cue": "方块整齐，边缘封住"
   },
   {
    "n": 6,
    "t": "平底锅中火烧热，不放油，把饼坯放进去烙三分钟到底面金黄。",
    "time": 4,
    "heat": "中火",
    "tip": "干锅烙，刷油就成煎饼了，层次会糊死。",
    "cue": "底面金黄，鼓起小泡"
   },
   {
    "n": 7,
    "t": "翻面再烙三分钟，两面金黄后取出，趁热用手拍松。",
    "time": 4,
    "heat": "中火",
    "tip": "出锅趁热拍两下，层次立刻分开。",
    "cue": "两面金黄，轻拍即散层"
   }
  ],
  "tips": [
   "面团要和得偏软，硬面团烙出来像死面饼。",
   "每层面片都刷黄油，这是出层次的关键。",
   "干锅不放油烙，饼皮才会起泡发脆。"
  ],
  "mistakes": [
   "面团揉得太硬，烙完咬不动也没层次。",
   "折叠时没锁边，下锅就散成一张饼。",
   "火太大，外面焦了中间还是生面。"
  ],
  "subs": [
