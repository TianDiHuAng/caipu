  "steps": [
   {
    "t": "鸡腿肉切成两厘米见方的丁，加盐抓匀静置十分钟入味。",
    "time": 12,
    "heat": "无火",
    "tip": "切得匀一点，炒的时候才一起熟。",
    "cue": "鸡丁大小一致，表面微黏"
   },
   {
    "t": "四季豆掐去两头撕掉筋络，掰成四厘米长的段洗净沥干。",
    "time": 4,
    "heat": "无火",
    "tip": "筋络一定要撕掉，不然嚼起来塞牙。",
    "cue": "豆段整齐，表面无水"
   },
   {
    "t": "朝天椒和红葱头拍碎，大蒜切粗粒，用杵臼略捣出香气。",
    "time": 6,
    "heat": "无火",
    "tip": "略捣一下辣味更容易出来，但别捣成泥。",
    "cue": "料碎带汁，香气冲鼻"
   },
   {
    "t": "炒锅烧到冒烟倒植物油，下捣好的辣料小火炒四十秒。",
    "time": 2,
    "heat": "小火",
    "tip": "辣料用小火，火大容易焦苦。",
    "cue": "锅中油变红，香味浓"
   },
   {
    "t": "转中大火下鸡丁，摊平煎两分钟再翻炒至表面变白定型。",
    "time": 5,
    "heat": "中大火",
    "tip": "先摊平煎再翻，鸡肉表面才焦香。",
    "cue": "鸡丁表面发白带焦边"
   },
   {
    "t": "下四季豆段翻炒三分钟，炒到豆段表面起皱颜色变深绿。",
    "time": 4,
    "heat": "中大火",
    "tip": "四季豆要炒到起皱，才彻底断生不夹生。",
    "cue": "豆段深绿起皱，锅气足"
   },
   {
    "t": "淋鱼露和酱油，撒棕榈糖，快炒一分半让酱汁裹匀。",
    "time": 2,
    "heat": "大火",
    "tip": "糖要最后撒，才不会先焦在锅底。",
    "cue": "酱汁亮红，均匀裹在食材上"
   },
   {
    "t": "关火抓一把罗勒叶翻两下，挤青柠汁，趁热配米饭上桌。",
    "time": 2,
    "heat": "无火",
    "tip": "罗勒靠余温出香，久炒会发黑。",
    "cue": "罗勒翠绿微卷，酱汁油亮"
   }
  ],
  "tips": [
   "鸡丁切得匀，受热一致才不会老的生嫩的生。",
   "辣料用小火炒出红色，火大只会焦苦。",
   "四季豆要炒到起皱，彻底断生才安全。",
   "罗勒关火再下，靠余温出香不发黑。"
  ],
  "mistakes": [
   "鸡丁切得大小不一，小的柴了大的还生。",
   "辣料大火爆香，整锅泛出焦苦味。",
   "四季豆炒两下就起锅，豆腥味重还有生味。",
   "罗勒一早就下锅，出锅全变成黑片。"
