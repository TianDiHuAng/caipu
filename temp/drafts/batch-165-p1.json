  "steps": [
   {
    "n": 1,
    "t": "豆腐切成半厘米的小丁，放进淡盐水里泡五分钟去除豆腥。",
    "time": 5,
    "heat": "无火",
    "tip": "盐水泡过豆腐不易碎，豆腥也淡。",
    "cue": "豆腐丁白净完整，边缘不散"
   },
   {
    "n": 2,
    "t": "香菇去柄切同样大小的丁，姜切末，小葱切成细花。",
    "time": 5,
    "heat": "无火",
    "tip": "香菇丁切小些，煮出来的羹才顺口。",
    "cue": "香菇丁大小均匀，香气明显"
   },
   {
    "n": 3,
    "t": "汤锅倒植物油烧热，下姜末和香菇丁小火煸出香味。",
    "time": 3,
    "heat": "小火",
    "tip": "香菇先煸，汤头才有浓香底味。",
    "cue": "香菇变软呈褐色，香气扑鼻"
   },
   {
    "n": 4,
    "t": "加清水和生抽烧开，放入豆腐丁转小火煮八分钟。",
    "time": 8,
    "heat": "小火",
    "tip": "豆腐下锅后轻推别猛搅，免得碎。",
    "cue": "汤色微褐，豆腐浮在汤面"
   },
   {
    "n": 5,
    "t": "淀粉加水调匀，边淋边搅，把汤勾到稀稠合适。",
    "time": 2,
    "heat": "小火",
    "tip": "芡要分两次淋，一次倒进去容易结块。",
    "cue": "汤体透亮稠滑，能挂勺"
   },
   {
    "n": 6,
    "t": "蛋液细线般淋入搅出蛋花，加盐和白胡椒粉调味。",
    "time": 2,
    "heat": "小火",
    "tip": "蛋液小火淋，蛋花才薄而匀。",
    "cue": "蛋花飘浮成丝，汤色柔亮"
   },
   {
    "n": 7,
    "t": "撒上葱花搅匀，关火盛入汤碗趁热上桌。",
    "time": 1,
    "heat": "无火",
    "tip": "葱花关火后放，香气才留得住。",
    "cue": "汤面浮着翠绿葱花"
   }
  ],
  "tips": [
   "豆腐用淡盐水泡一会儿，不易碎且去豆腥。",
   "香菇先煸出香味，汤底才够浓。",
   "芡汁分两次淋，羹体才滑不结块。"
  ],
  "mistakes": [
