     },
     {
      "n": "香油",
      "a": 10,
      "u": "ml",
      "note": "出锅刷面"
     }
    ]
   }
  ],
  "equipment": [
   "深锅",
   "汤勺",
   "冰水盆",
   "砧板"
  ],
  "steps": [
   {
    "t": "三黄鸡洗净擦干，剪去鸡屁股与脚爪，鸡腔内塞入姜片与葱结。",
    "time": 10,
    "heat": "无火",
    "tip": "鸡身擦干，卤水才不会被稀释。",
    "cue": "鸡皮干爽、腔内有姜葱"
   },
   {
    "t": "深锅加 1500ml 水、生抽、老抽、冰糖、料酒、盐、八角与桂皮，大火烧开转小火熬 5 分钟。",
    "time": 10,
    "heat": "中火",
    "tip": "先熬香香料，卤水才有层次。",
    "cue": "卤水呈红褐色、香气明显"
   },
   {
    "t": "提着鸡颈把整只鸡浸入卤水 10 秒再提起，重复 3 次让鸡皮收紧。",
    "time": 3,
    "heat": "小火",
    "tip": "三提三放让鸡皮紧实不破。",
    "cue": "鸡皮收紧发亮、颜色均匀"
   },
   {
    "t": "整鸡放入卤水，保持微沸浸煮 18 分钟，中途翻面两次并用勺把卤水淋在鸡身上。",
    "time": 20,
    "heat": "小火",
    "tip": "水面只冒小泡，滚大了肉就柴。",
    "cue": "鸡腿最厚处能扎透、无血水"
   },
   {
    "t": "捞出整鸡立即放入冰水中浸 5 分钟，让鸡皮紧致爽脆。",
    "time": 6,
    "heat": "无火",
    "tip": "冰水一激，鸡皮弹牙、肉汁锁住。",
    "cue": "鸡皮起细密纹路、手感冰凉"
   },
   {
    "t": "沥干后刷一层香油，斩件摆盘，淋两勺过滤后的卤水即可。",
    "time": 8,
    "heat": "无火",
    "tip": "斩件时刀要快，切口才整齐。",
    "cue": "皮色枣红油亮、骨内微红"
   }
  ],
  "tips": [
   "浸煮而不是大火煮，鸡肉才嫩滑。",
   "冰水激皮是粤式白切类菜的关键一步。",
   "卤水别扔，可冷藏留作下次的老卤。"
  ],
  "mistakes": [
   "全程大火滚煮，鸡肉发柴、鸡皮破裂。",
   "煮好不冰镇直接斩，鸡皮软塌没口感。",
   "卤水生抽放太多又久煮，成品过咸发黑。"
  ],
  "subs": [
   {
    "orig": "三黄鸡",
    "sub": "清远鸡",
    "ratio": "1000g 对 1000g",
    "note": "皮更薄，浸煮时间减 2 分钟。"
   },
   {
    "orig": "冰糖",
    "sub": "麦芽糖",
    "ratio": "40g 对 30g",
    "note": "上色更亮，甜味更淡。"
   }
  ],
  "variations": [
   "玫瑰豉油鸡：卤水加 20ml 玫瑰露酒，香气更雅。",
   "电饭锅版：卤水与鸡放电饭锅，煮饭键跳起即熟。"
  ],
  "serving": "斩件后淋卤水，配姜蓉或豉油碟蘸食。",
  "storage": "冷藏 2 天，冷冻 1 周；复热蒸 8 分钟，别用微波炉。",
  "nutrition": {
   "basis": "每份（约 250g 带骨）",
   "kcal": 420,
   "protein": 38,
   "fat": 24,
   "carbs": 10,
   "sodium": 1050
  },
  "safety": [
   "鸡肉必须浸煮至骨缝无血水，中心温度达 75℃。",
   "斩件用的砧板需与生食分开，避免交叉污染。",
   "卤水重复使用需每次烧开并冷藏保存。"
  ],
  "origin": "豉油鸡是广东烧腊铺的招牌之一，整鸡在豉油卤水中浸熟再冰镇，皮爽肉滑、酱香回甜，切件后淋一勺卤水便是最地道的吃法。",
  "tags": [
