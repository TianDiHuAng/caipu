   "锅铲"
  ],
  "steps": [
   {
    "t": "豆腐切 1cm 厚的三角片，锅中加水与 3g 盐烧开，下豆腐焯 1 分钟捞出沥干。",
    "time": 5,
    "heat": "中火",
    "tip": "盐水焯过豆腐不易碎，还能去豆腥。",
    "cue": "豆腐片微挺、表面不见水"
   },
   {
    "t": "平底锅倒 70ml 植物油烧至五成热，豆腐片平铺下锅，中火煎 5 分钟至两面金黄。",
    "time": 7,
    "heat": "中火",
    "tip": "下锅后别急着翻，定型了自然离锅。",
    "cue": "两面结金黄硬壳、边缘微鼓"
   },
   {
    "t": "炒锅留 15ml 底油，下猪肉末中火炒散 3 分钟至微焦出油。",
    "time": 4,
    "heat": "中火",
    "tip": "肉末炒到发干才香。",
    "cue": "肉末颗粒分明、锅底见油"
   },
   {
    "t": "加豆瓣酱、姜末与蒜片，小火炒 1 分钟至红油渗出，加生抽、白糖与 120ml 清水烧开。",
    "time": 3,
    "heat": "小火",
    "tip": "豆瓣酱必须小火炒，否则发苦。",
    "cue": "汤汁红亮、香味浓郁"
   },
   {
    "t": "下煎好的豆腐与青椒片，中小火烧 4 分钟，让豆腐吸饱汤汁。",
    "time": 5,
    "heat": "中小火",
    "tip": "用晃锅代替铲子，豆腐才不散。",
    "cue": "豆腐鼓起、汤汁略收"
   },
   {
    "t": "淋水淀粉勾薄芡，撒小葱段兜匀即可出锅装盘。",
    "time": 2,
    "heat": "中火",
    "tip": "芡要薄，能挂住豆腐就好。",
    "cue": "汤汁包裹豆腐、葱花翠绿"
   }
  ],
  "tips": [
   "豆腐先盐水焯再煎，不易碎且没豆腥。",
   "煎豆腐时不要频繁翻动，等结壳再翻。",
   "豆瓣酱与生抽都有咸味，盐要少放。"
  ],
  "mistakes": [
   "豆腐直接下锅煎，一翻就碎成渣。",
   "豆瓣酱大火爆炒，辣味变苦味。",
   "汤汁加太多且不收，成品像豆腐汤。"
  ],
  "subs": [
   {
    "orig": "豆腐",
    "sub": "北豆腐",
    "ratio": "500g 对 500g",
    "note": "质地更硬，煎时更不易碎。"
   },
   {
    "orig": "猪肉末",
    "sub": "香菇末",
    "ratio": "120g 对 120g",
    "note": "素版更清爽，需加 5ml 生抽。"
   }
  ],
  "variations": [
   "干锅版：煎好后放干锅底部垫洋葱，边加热边吃。",
   "鱼香版：调汁时加 15ml 香醋，酸甜更开胃。"
  ],
  "serving": "连汁浇在米饭上，咸鲜微辣最下饭。",
  "storage": "冷藏 2 天，复热加少量水小火焖 3 分钟。",
  "nutrition": {
   "basis": "每份（约 1/4 盘）",
   "kcal": 380,
   "protein": 20,
   "fat": 28,
   "carbs": 10,
   "sodium": 860
  },
  "safety": [
   "豆腐富含水分，煎制时油易溅，下锅前尽量沥干。",
   "猪肉末需炒至完全变色熟透。",
   "含大豆制品，大豆过敏人群请替换为鸡蛋豆腐以外的食材。"
  ],
  "origin": "家常豆腐是川渝人家灶台上的常客，豆腐煎出金黄硬壳再与豆瓣肉末同烧，外韧内嫩、汁浓味厚，是最朴实的下饭菜。",
  "tags": [
   "川菜",
