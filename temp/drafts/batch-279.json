        "time": 8,
        "heat": "中小火",
        "tip": "不刷油干烙，饼面起小泡才地道。",
        "cue": "饼面鼓起焦斑，边缘发硬。"
      },
      {
        "t": "两面刷上酥油，再烙半分钟至边缘微脆，趁热叠放上桌。",
        "time": 6,
        "heat": "中小火",
        "tip": "酥油最后刷，香气温和不焦。",
        "cue": "表面油亮，焦斑均匀。"
      }
