            "u": "g",
            "note": "切一厘米小丁"
          }
        ]
      },
      {
        "group": "aux",
        "items": [
          {
            "n": "洋葱",
            "a": 100,
            "u": "g",
            "note": "切细丝"
          },
          {
            "n": "青椒",
            "a": 80,
            "u": "g",
            "note": "切小丁"
          },
          {
            "n": "蒜",
            "a": 10,
            "u": "g",
            "note": "剁末"
          }
        ]
      },
      {
        "group": "seasoning",
        "items": [
          {
            "n": "橄榄油",
            "a": 120,
            "u": "ml",
            "note": "煎土豆用，可回收再用"
          },
          {
            "n": "盐",
            "a": 6,
            "u": "g",
            "note": "分层撒"
          },
          {
            "n": "黑胡椒",
            "a": 2,
            "u": "g",
            "note": "现磨"
          }
        ]
      }
    ],
    "steps": [
      {
        "t": "土豆削皮切成一厘米见方的小丁，泡在清水里冲掉表面的浆水，捞出用布擦干。",
        "time": 8,
        "heat": "无火",
        "tip": "擦干再下锅才不会溅油，表面浆水去净也更不容易粘锅底。",
        "cue": "土豆丁干爽，切口整齐"
      },
      {
        "t": "平底锅倒橄榄油，中小火下土豆丁，慢煎十分钟到软而不上色，用漏勺捞出沥油。",
        "time": 12,
        "heat": "中小火",
        "tip": "土豆要煎软不要煎脆，脆了蛋饼就合不起来。",
        "cue": "土豆丁微软，筷子能扎透"
      },
      {
        "t": "锅里留两勺油，下洋葱丝炒到透明发甜，再加青椒丁与蒜末炒两分钟。",
        "time": 6,
        "heat": "中火",
        "tip": "洋葱炒到透明甜味才出来，别急着上色。",
        "cue": "洋葱变软透明，青椒颜色转深"
      },
      {
        "t": "鸡蛋磕进大盆，加盐与黑胡椒打散，倒入沥好油的土豆丁，轻轻拌到每块都裹上蛋液。",
        "time": 4,
        "heat": "无火",
        "tip": "拌的时候别搅碎土豆，块状口感才是乡村蛋饼的灵魂。",
        "cue": "蛋液里均匀分布土豆丁"
      },
      {
        "t": "把蛋液土豆倒回锅里，先静置半分钟等底部定型，再用铲子把边缘往中间推压出圆边。",
        "time": 4,
        "heat": "中小火",
        "tip": "边缘往里推能让蛋饼外高内低，翻面时不容易散。",
        "cue": "蛋饼边缘成型，成为厚圆饼"
      },
      {
        "t": "保持中小火煎四分钟，盖盖焖三分钟让中心慢慢凝固，别急着翻动。",
        "time": 7,
        "heat": "中小火",
        "tip": "盖盖能让上层靠蒸汽凝固，翻面时就不怕漏生蛋液。",
        "cue": "表面七成凝固，晃锅时能整体移动"
      },
      {
        "t": "用一个大盘子扣在锅上，一手压盘一手翻锅，把蛋饼倒到盘里再滑回锅中煎另一面。",
        "time": 3,
        "heat": "中小火",
        "tip": "盘子要大于锅口，动作一次到位，犹豫就容易破。",
        "cue": "蛋饼完整翻转，未破裂"
      },
      {
        "t": "另一面煎四分钟到金黄，出锅静置三分钟再切块，可热吃也可放凉当冷盘。",
        "time": 7,
        "heat": "中小火",
        "tip": "静置让内部余温收尾，切的时候截面才平整好看。",
        "cue": "两面金黄，切面紧密无流液"
      }
    ],
    "tips": [
      "土豆先煎软再拌蛋液，是西班牙蛋饼和普通煎蛋最大的区别。",
      "喜欢蛋液湿润就缩短一分钟，但要确保中心已无流动蛋液。",
      "橄榄油用量大是为了炸土豆，用后可过滤冷藏，下次继续用。",
      "放凉后夹在面包里吃，是西班牙酒吧常见的吃法。"
    ],
    "mistakes": [
      "土豆切好不擦干就下锅，油花四溅，蛋饼也带水气。",
      "大火煎到底面焦黑，中心却还是流动生蛋液。",
      "翻面时用铲子硬推，蛋饼从中间裂开，形状全毁。"
    ],
    "subs": [
      {
        "orig": "青椒",
        "sub": "红甜椒",
        "ratio": "80克:80克",
        "note": "辣度为零，颜色更亮，甜味略高。"
      },
      {
        "orig": "土豆",
        "sub": "红薯",
        "ratio": "350克:350克",
        "note": "甜味明显，煎制时间延长三分钟。"
      }
    ],
    "variations": [
      "加一把煮熟的青豆与火腿丁，做成更丰盛的版本。",
      "把橄榄油换成黄油，奶香更浓，但风味会更偏法式。"
    ],
    "serving": "切成六块当作餐前小食或配一杯干红，也可以夹在面包片里当午餐。",
    "storage": "冷藏三天内吃完，复热用平底锅小火两面各煎两分钟；冷食风味也不错。",
    "nutrition": {
      "basis": "按三人份估算",
      "kcal": 420,
      "protein": 19,
      "fat": 30,
      "carbs": 20,
      "sodium": 560
    },
    "diet": [
      "vegetarian",
      "gluten-free"
    ],
    "tags": [
      "西班牙",
      "蛋饼",
      "土豆",
      "家常"
    ],
    "safety": [
      "鸡蛋须彻底加热至完全凝固、中心无流动蛋液后食用；含蛋菜品冷藏保存不超过两天，复热须彻底加热。"
    ],
    "origin": "西班牙酒吧里和土豆蛋饼齐名的乡村版，除了土豆还加洋葱与青椒，蛋液裹着软土豆煎成一指厚的大饼，切块当小食或配面包，是家常桌上的常客。",
    "prep": 45,
    "cook": 40,
    "overwrite": true
  },
  {
    "id": "korean-mayak-gyeran",
    "zh": "韩式麻药鸡蛋",
    "en": "Korean Marinated Eggs",
