[
  {
    "id": "spanish-tortilla-paisana",
    "zh": "西班牙乡村蛋饼",
    "en": "Spanish Country Omelette",
    "original": "Tortilla paisana",
    "cuisine": "spanish",
    "category": [
      "main-egg"
    ],
    "difficulty": 1,
    "servings": 3,
    "flavor": [
      "savory",
      "salty",
      "rich"
    ],
    "equipment": [
      "不粘锅",
      "打蛋盆",
      "刀",
      "砧板",
      "木铲"
    ],
    "related": [
      "spanish-tortilla-espanola",
      "spanish-patatas-bravas"
    ],
    "ingredients": [
