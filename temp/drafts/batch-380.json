  {
    "id": "cantonese-corn-carrot-soup",
    "zh": "粤式粟米红萝卜汤",
    "en": "Cantonese Corn and Carrot Soup",
    "original": "粟米紅蘿蔔湯",
    "cuisine": "cantonese",
    "category": [
      "soup"
    ],
    "difficulty": 1,
    "servings": 4,
    "flavor": [
      "sweet",
      "savory",
      "light"
    ],
    "equipment": [
      "汤锅",
      "刀",
      "砧板",
      "滤网",
      "汤勺"
    ],
    "related": [
      "cantonese-lianou-paigu-tang",
      "cantonese-fuzhu-baiguo-tang"
    ],
    "ingredients": [
      {
        "group": "main",
        "items": [
          {
            "n": "玉米",
            "a": 400,
            "u": "g",
            "note": "两只，切段"
          },
          {
            "n": "排骨",
            "a": 500,
            "u": "g",
            "note": "斩小块"
          },
          {
            "n": "胡萝卜",
            "a": 300,
            "u": "g",
            "note": "切滚刀块"
          }
        ]
      },
      {
        "group": "aux",
        "items": [
          {
            "n": "姜",
            "a": 15,
            "u": "g",
            "note": "切片"
          },
          {
            "n": "蜜枣",
            "a": 30,
            "u": "g",
            "note": "两只，可省略"
          }
        ]
      },
      {
        "group": "seasoning",
        "items": [
          {
            "n": "盐",
            "a": 7,
            "u": "g",
            "note": "出锅前调味"
          },
          {
            "n": "清水",
            "a": 2000,
            "u": "ml",
            "note": "一次加足"
          }
        ]
      }
    ],
    "steps": [
      {
        "t": "排骨用清水泡二十分钟，中途换两次水，把血水泡出来，汤才清不腥。",
        "time": 22,
        "heat": "无火",
        "tip": "泡血水比焯水更能保住肉的鲜味，汤也更清。",
        "cue": "水面浮起淡红血水，排骨颜色变浅"
      },
      {
        "t": "泡好的排骨冷水下锅，加两片姜，小火加热到微沸，撇净浮沫后捞出冲净。",
        "time": 8,
        "heat": "中火",
        "tip": "水要冷水起锅，血沫才会随温度升高慢慢析出。",
        "cue": "浮沫聚成灰褐色一层，排骨表面干净"
      },
      {
        "t": "玉米剥去外叶与须，切成四厘米厚的段；胡萝卜去皮切滚刀块，大小约三厘米。",
        "time": 8,
        "heat": "无火",
        "tip": "切块别太小，久煮会化在汤里，只剩渣。",
        "cue": "玉米段整齐，胡萝卜块大小一致"
      },
      {
        "t": "汤锅加清水，放入排骨与姜片，大火烧开后转小火，撇一次浮沫，盖盖炖四十分钟。",
        "time": 45,
        "heat": "小火",
        "tip": "全程小火保持汤面微滚即可，火大了汤色会变浑，喝起来也不清爽。",
        "cue": "汤面微微冒泡，水面清亮"
      },
      {
        "t": "加玉米段、胡萝卜块与蜜枣，继续小火炖三十分钟，让甜味慢慢渗进汤里。",
        "time": 32,
        "heat": "小火",
        "tip": "玉米和胡萝卜后放，久煮会散，甜味也会发闷。",
        "cue": "玉米转深黄，胡萝卜边缘变软"
      },
      {
        "t": "用筷子戳胡萝卜，能轻松穿透说明已炖透，此时汤色转成浅琥珀色。",
