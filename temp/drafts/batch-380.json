            "n": "生抽",
            "a": 90,
            "u": "ml",
            "note": "腌汁主体"
          },
          {
            "n": "白糖",
            "a": 25,
            "u": "g",
            "note": "平衡咸味"
          },
          {
            "n": "香油",
            "a": 10,
            "u": "ml",
            "note": "增香"
          },
          {
            "n": "清水",
            "a": 150,
            "u": "ml",
            "note": "稀释腌汁"
          },
          {
            "n": "白醋",
            "a": 15,
            "u": "ml",
            "note": "煮蛋时防裂"
          }
        ]
      }
    ],
    "steps": [
      {
        "t": "鸡蛋从冰箱取出放常温二十分钟，让蛋温回升，煮的时候不容易破壳。",
        "time": 20,
        "heat": "无火",
        "tip": "冷蛋直接下锅最易爆壳，回温这一步很关键。",
        "cue": "蛋壳表面无冷凝水，手感接近室温"
      },
      {
        "t": "汤锅加水烧沸，放白醋，用勺背把鸡蛋一枚枚轻轻送进锅里，避免磕碰。",
        "time": 4,
        "heat": "大火",
        "tip": "醋能让蛋白遇破口迅速凝固，减少流白。",
        "cue": "水面微滚，鸡蛋全部沉底"
      },
      {
        "t": "转中火煮六分半，中途用勺子轻推鸡蛋转动，让蛋黄居中不偏。",
        "time": 7,
        "heat": "中火",
        "tip": "六分半是溏心的分界，超过七分半蛋黄就全实了。",
        "cue": "计时结束，蛋壳无裂开"
      },
      {
        "t": "立刻捞出放进冰水里泡五分钟，彻底降温后再剥壳，蛋面才光滑。",
        "time": 6,
        "heat": "无火",
        "tip": "冰水能让蛋白收缩脱离蛋壳，剥起来整片脱落。",
        "cue": "蛋壳一剥就掉，蛋面光滑无坑"
      },
      {
        "t": "小碗里放生抽、清水、白糖、蒜末、红辣椒圈与香油，搅到糖完全化开成腌汁。",
        "time": 4,
        "heat": "无火",
        "tip": "腌汁要尝起来偏咸一点，蛋在里面泡着才不会寡淡。",
        "cue": "腌汁深褐透亮，蒜末分布均匀"
      },
      {
        "t": "鸡蛋放进保鲜盒，倒入腌汁没过蛋面，撒上葱圈与焙香的白芝麻。",
        "time": 3,
        "heat": "无火",
        "tip": "蛋要完全浸没，露出的部分会颜色不均。",
        "cue": "蛋全部被腌汁淹没，表面浮着葱花"
      },
      {
        "t": "盖好冷藏腌六小时以上，隔夜风味最足，中途翻一次面让上色均匀。",
        "time": 360,
        "heat": "无火",
        "tip": "腌四小时能吃，腌一夜蛋白才会染成琥珀色。",
        "cue": "蛋白表面染成浅褐色，闻起来咸香带蒜味"
      },
      {
        "t": "取出的蛋用刀对半切开，蛋黄微微流动，淋一勺腌汁，撒剩下的葱花即可。",
        "time": 3,
        "heat": "无火",
        "tip": "切蛋时刀一定要沾点水，切面才会干净不粘，蛋黄也不易压破。",
        "cue": "切面蛋黄橙黄半凝，蛋身褐亮"
      }
    ],
    "tips": [
      "用可生食级别的鸡蛋做溏心最安心，普通蛋建议煮到八分钟。",
      "腌汁可以重复使用一次，再泡一批蛋或腌黄瓜都好吃。",
      "加一勺辣椒粉或半勺鱼露，咸鲜层次会更厚。",
      "配一碗热米饭就是韩剧里最常见的吃法，蛋黄拌饭格外香。"
    ],
    "mistakes": [
      "冷水下锅就开始计时，煮的时间不准，剥开蛋黄全熟发干。",
      "煮好不冰镇直接剥壳，蛋白粘住蛋壳，剥得坑坑洼洼。",
      "腌汁不加水直接用生抽，蛋白泡一天后咸得没法入口。"
    ],
    "subs": [
      {
        "orig": "生抽",
        "sub": "淡酱油加盐",
        "ratio": "90毫升:100毫升加1克盐",
        "note": "咸度更轻，适合口味清淡的人。"
      },
      {
        "orig": "白醋",
        "sub": "盐",
        "ratio": "15毫升:5克",
        "note": "同样能减少破壳流白，但效果略弱。"
      }
    ],
    "variations": [
      "腌汁里加一勺辣椒酱与蜂蜜，做成甜辣版本，更下饭。",
      "把蛋换成溏心鹌鹑蛋，腌三小时即可入味，适合做便当配菜。"
    ],
    "serving": "对半切开摆在米饭上，淋一勺腌汁撒葱花与芝麻，配泡菜与海苔一起吃。",
    "storage": "冷藏腌三到四天内吃完，蛋须始终浸在腌汁中；溏心蛋不建议超过二十四小时再食用。",
    "nutrition": {
      "basis": "按三人份估算",
      "kcal": 230,
      "protein": 14,
      "fat": 14,
      "carbs": 10,
      "sodium": 900
    },
    "diet": [
      "vegetarian",
      "dairy-free"
    ],
    "tags": [
      "韩国",
      "鸡蛋",
      "小菜",
      "腌制"
    ],
    "safety": [
      "溏心蛋须使用可生食级别鸡蛋并在冷藏下二十四小时内食用；若蛋源不明须彻底加热至蛋黄完全凝固，腌汁每次取用须用干净筷子。"
    ],
    "origin": "韩国便利店和家常餐桌都常见的麻药鸡蛋，名字说的是吃一口就上瘾。蛋煮成溏心后泡进酱油蒜末调的汁里腌一夜，切开蛋黄半流动，拌饭特别香。",
