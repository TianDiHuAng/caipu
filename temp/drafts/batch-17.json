    "note": "梭子蟹壳薄，蒸制时间减至 12 分钟。"
   },
   {
    "orig": "绍兴酒",
    "sub": "料酒",
    "ratio": "1:1",
    "note": "料酒香味略冲，用量减半。"
   }
  ],
  "variations": [
   "家庭简化版：不铺紫苏，用 3 片姜与 1 根葱段垫底，同样去腥。",
   "江南宴席版：蘸碟加 5g 白糖熬成姜汁糖醋，味道更醇厚。"
  ],
  "serving": "三只蟹配一碟姜醋，饭后一碗姜茶；江浙人家的秋季家宴标配。",
  "storage": "蟹必须现蒸现吃，隔夜蟹肉易生细菌，不建议保存。",
  "nutrition": {
   "basis": "每份（约 1/3 量，一只蟹）",
   "kcal": 220,
   "protein": 34,
   "fat": 6,
   "carbs": 5,
   "sodium": 760
  },
  "safety": [
   "蟹必须彻底蒸熟，中心温度 75℃ 以上、壳色转红才可食用。",
   "死蟹与隔夜蟹会产生组胺，一律不得食用。",
   "蟹性寒，脾胃虚寒与痛风人群应少量食用。"
  ],
  "origin": "清蒸大闸蟹是江南吃蟹的最高礼遇，只用紫苏、姜与黄酒去腥，不加任何重味调料，全凭蟹本身的鲜甜，讲究「九月圆脐十月尖」。",
  "tags": [
