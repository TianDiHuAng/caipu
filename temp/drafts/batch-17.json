  "steps": [
   {
    "t": "大闸蟹用毛刷在流水下刷净蟹壳、蟹钳与腹部的泥沙，绑绳不要解开。",
    "time": 12,
    "heat": "无火",
    "tip": "绑着蒸蟹腿才不会脱落，蟹黄也不流失。",
    "cue": "蟹壳青亮、缝隙无泥沙"
   },
   {
    "t": "蒸锅加 1500ml 清水，水里倒 20ml 绍兴酒，铺上紫苏叶与 20g 姜片，大火烧开。",
    "time": 6,
    "heat": "大火",
    "tip": "水开后再放蟹，蟹肉才紧实不腥。",
    "cue": "蒸锅上汽、香气散出"
   },
   {
    "t": "蟹腹部朝上摆入蒸屉，每只之间留出空隙，加盖大火蒸 15 分钟。",
    "time": 15,
    "heat": "大火",
    "tip": "腹朝上能让蟹黄稳稳留在壳里。",
    "cue": "蟹壳转为均匀的橙红色"
   },
   {
    "t": "蒸蟹时把剩余 20g 姜切成细末，加香醋、生抽与白糖调成蘸碟。",
    "time": 4,
    "heat": "无火",
    "tip": "姜末切得越细，蘸碟越香且不呛。",
    "cue": "蘸碟姜末细腻、味道酸甜咸"
   },
   {
    "t": "关火后焖 2 分钟再开盖，取出蟹剪去绑绳，趁热配蘸碟上桌。",
    "time": 3,
    "heat": "无火",
    "tip": "关火焖 2 分钟，蟹黄更凝实。",
    "cue": "蟹黄红亮、蟹肉雪白饱满"
   }
  ],
  "tips": [
   "农历九月吃母蟹、十月吃公蟹，膏黄最饱满。",
   "吃蟹配姜茶或黄酒，能中和寒性。",
   "蟹心、蟹腮、蟹胃、蟹肠四样务必去掉不吃。"
  ],
  "mistakes": [
   "冷水就把蟹放进去蒸，蟹腿在挣扎中脱落、腥味重。",
   "蒸太久超过 20 分钟，蟹肉发柴、鲜甜尽失。",
   "蟹腹朝下摆，蟹黄受热后从缝隙流走。"
  ],
  "subs": [
