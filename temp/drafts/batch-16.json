   "汤勺"
  ],
  "steps": [
   {
    "t": "牛里脊剁成细末，加料酒、5g 玉米淀粉与 1g 盐抓匀，腌 10 分钟。",
    "time": 10,
    "heat": "无火",
    "tip": "肉末剁得越细，羹的口感越顺滑。",
    "cue": "肉末细腻无筋膜、颜色均匀"
   },
   {
    "t": "高汤加姜末煮沸，把牛肉末抖散下锅，用勺子推散防结块。",
    "time": 3,
    "heat": "中火",
    "tip": "肉末要抖散着下，成团就成肉丸了。",
    "cue": "汤中肉末均匀悬浮"
   },
   {
    "t": "撇去浮沫，加盐与白胡椒调味，转小火煮 3 分钟。",
