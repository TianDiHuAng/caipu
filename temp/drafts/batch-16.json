     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "漏勺",
   "厨房纸"
  ],
  "steps": [
   {
    "t": "虾剪去虾枪虾须，挑出虾线，用清水洗净后用厨房纸充分吸干水分。",
    "time": 10,
    "heat": "无火",
    "tip": "水分吸得越干，下锅越不溅油、壳越脆。",
    "cue": "虾身干爽、虾壳透亮"
   },
   {
    "t": "虾加料酒与 1g 盐抓匀，腌 5 分钟后再次吸干。",
    "time": 5,
    "heat": "无火",
    "tip": "腌后回干是爆虾壳脆的关键步骤。",
    "cue": "虾表面无液体残留"
   },
   {
    "t": "炒锅下 200ml 植物油烧至七成热，虾分批下锅炸 40 秒至壳红脆，捞出。",
    "time": 3,
    "heat": "大火",
    "tip": "油温要高，虾下锅应立刻冒大泡。",
    "cue": "虾壳膨起、颜色鲜红"
   },
   {
    "t": "锅中留 15ml 底油，下姜丝与葱段爆香，加生抽、白糖、香醋与 30ml 清水烧开。",
    "time": 2,
    "heat": "中火",
    "tip": "本帮油爆虾的汁要甜中带咸，糖不可减。",
    "cue": "汁液起小泡、葱姜香气浓"
   },
   {
    "t": "倒回虾大火翻炒 40 秒，让每只虾裹上浓汁后立即出锅。",
    "time": 1,
    "heat": "大火",
    "tip": "回锅时间要短，久了虾肉变老。",
    "cue": "虾身油亮、盘底只剩薄汁"
   }
  ],
  "tips": [
   "用中小型河虾最正宗，壳薄易爆脆、连壳可嚼。",
   "复炸一次口感更脆，但油温要升到八成热。",
   "剩下的葱油可拌面，是本帮菜的常见吃法。"
  ],
  "mistakes": [
   "虾带水下锅，油花四溅且虾壳软塌不脆。",
   "回锅后久炒收汁，虾肉缩水发柴。",
   "白糖放得太少，失去本帮菜浓油赤酱的甜香。"
  ],
  "subs": [
   {
    "orig": "虾",
    "sub": "河虾",
    "ratio": "600g 基围虾 ≈ 500g 河虾",
    "note": "河虾个头小，炸制时间减到 30 秒。"
   },
   {
    "orig": "植物油",
    "sub": "菜籽油",
    "ratio": "1:1",
    "note": "菜籽油需先烧去除生味。"
   }
  ],
  "variations": [
   "家庭简化版：减少油量到 80ml，用半煎半炸的方式，省油且同样脆。",
   "本帮宴客版：加 10g 话梅同烧，甜味更有层次。"
  ],
  "serving": "冷吃热吃皆宜，作下酒菜或冷盘头菜。",
  "storage": "冷藏 1 天，复热用 180℃ 烤箱烤 3 分钟恢复脆度。",
  "nutrition": {
   "basis": "每份（约 1/3 量）",
   "kcal": 300,
   "protein": 28,
   "fat": 16,
   "carbs": 8,
   "sodium": 900
  },
  "safety": [
   "虾需炸至完全变红、肉质不透明，中心温度 63℃ 以上。",
   "高温油炸需控温，油面冒青烟时应立即降温。",
   "海鲜过敏人群禁食，用过的油不宜反复高温使用。"
  ],
  "origin": "油爆虾是上海本帮菜的招牌冷盘，讲究「壳脆肉嫩、甜咸适口」，早年是弄堂人家逢年过节的硬菜。",
  "tags": [
   "上海菜",
   "海鲜",
   "冷盘",
   "下酒菜"
  ],
  "related": [
   "youmen-daxia",
   "baizhuo-xia",
   "xia-ren-huadan"
  ]
