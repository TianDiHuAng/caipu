   {
    "t": "15g 玉米淀粉加 60ml 清水调匀，缓缓淋入汤中并不断搅拌至浓稠。",
    "time": 2,
    "heat": "小火",
    "tip": "淀粉水要边搅边淋，否则会结块。",
    "cue": "汤体浓稠、勺子挂薄芡"
   },
   {
    "t": "转最小火，蛋清打散后细线淋入，静置 10 秒推成蛋花，关火淋香油撒香菜末。",
    "time": 2,
    "heat": "小火",
    "tip": "蛋清要最后下，火大就会变絮状。",
    "cue": "蛋花洁白成片、羹面平滑"
   }
  ],
  "tips": [
   "勾芡后再淋蛋清，蛋花才成片浮在羹面。",
   "汤要滚而不沸时勾芡，芡汁才均匀不结块。",
   "喜酸可加 5ml 香醋，风味更接近餐馆版本。"
  ],
  "mistakes": [
   "牛肉末直接下冷水锅，肉末沉底成团。",
   "淀粉一次倒入不搅拌，羹中出现透明硬块。",
   "蛋清下锅后大火滚煮，蛋花碎成絮条。"
  ],
  "subs": [
   {
    "orig": "牛肉",
    "sub": "鸡胸肉",
    "ratio": "200g 牛肉 ≈ 200g 鸡胸肉",
    "note": "鸡胸肉更清淡，煮制时间减 1 分钟。"
   },
   {
    "orig": "高汤",
    "sub": "清水加鸡精",
    "ratio": "800ml 高汤 ≈ 800ml 水 + 4g 鸡精",
    "note": "盐量相应减 1g。"
   }
  ],
  "variations": [
   "家庭简化版：牛肉末改用市售牛肉馅，省去剁肉时间。",
   "杭帮餐馆版：加 30g 嫩豆腐丁与 10g 火腿末，口感更丰富。"
  ],
  "serving": "作为宴席第二道汤羹，饭前一碗最开胃。",
  "storage": "冷藏 1 天，复热需加 50ml 清水并小火搅动，防止糊底。",
  "nutrition": {
   "basis": "每份（约 1/3 量）",
   "kcal": 180,
   "protein": 20,
   "fat": 6,
   "carbs": 10,
   "sodium": 980
  },
  "safety": [
   "牛肉需煮至完全变色，中心温度 71℃ 以上，避免半生。",
   "蛋清需加热至完全凝固，儿童与孕妇不宜食用半熟蛋清。",
   "羹类隔夜复热必须彻底煮沸并持续搅动。"
  ],
  "origin": "西湖牛肉羹是杭帮菜中的经典汤羹，以牛肉末、蛋清与薄芡做出细腻口感，因形似西湖水色而得名，常见于江南宴席。",
  "tags": [
