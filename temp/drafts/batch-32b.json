  "steps": [
   {
    "t": "牛肉切成 4cm 见方的大块，用厨房纸把表面水分彻底吸干，撒盐与黑胡椒。",
    "time": 10,
    "heat": "无火",
    "tip": "表面越干，煎出的焦壳越香。",
    "cue": "肉块干爽、调味均匀"
   },
   {
    "t": "厚底锅倒油烧至冒烟，牛肉分批下锅大火煎至六面焦褐，盛出备用。",
    "time": 15,
    "heat": "大火",
    "tip": "分批煎，锅不降温才上色。",
    "cue": "肉块六面焦褐、锅底留褐色焦渣"
   },
   {
    "t": "原锅下洋葱与胡萝卜中火炒 5 分钟，撒面粉翻匀再炒 2 分钟。",
    "time": 8,
    "heat": "中火",
    "tip": "面粉炒过才没有生粉味。",
    "cue": "蔬菜变软、面粉裹匀"
   },
   {
    "t": "倒红酒煮开，用木铲刮起锅底焦渣，加番茄膏、百里香与香叶。",
    "time": 8,
    "heat": "中火",
    "tip": "焦渣是风味精华，一定要刮起来。",
    "cue": "汤汁红亮、锅底干净"
   },
   {
    "t": "牛肉回锅，加盖小火炖 120 分钟，中途翻动两次防粘底。",
    "time": 122,
    "heat": "小火",
    "tip": "保持微沸，大滚肉会柴。",
    "cue": "牛肉能用筷子轻松插入"
   },
   {
    "t": "下蘑菇再炖 10 分钟，开盖收汁，尝味后补盐出锅。",
    "time": 12,
    "heat": "中火",
    "tip": "收汁到能挂勺就够，别收干。",
    "cue": "汤汁浓稠、色深红亮"
   }
  ],
  "tips": [
   "牛肉下锅前务必吸干水分，才煎得出焦香外壳。",
   "红酒要选干型，甜酒会让整锅发腻。",
   "用小火慢炖两小时，牛肉才酥烂而不散形。"
  ],
  "mistakes": [
   "牛肉一次全倒进锅，温度骤降变成水煮，毫无焦香。",
   "红酒大火滚煮太久，酸味被煮得格外尖锐。",
   "收汁收得太干，酱汁变成糊状粘在锅底。"
  ],
  "subs": [
   {
    "orig": "红酒",
    "sub": "干白葡萄酒",
    "ratio": "400ml 对 400ml",
    "note": "风味更清爽，颜色偏浅。"
   },
   {
    "orig": "牛肉",
    "sub": "牛腱子",
    "ratio": "800g 对 800g",
    "note": "胶质更多，炖足两小时更糯。"
   }
  ],
  "variations": [
   "培根版：先用 60g 培根煎出油再煎牛肉，烟熏味更足。",
   "加小洋葱版：最后 30 分钟加 100g 珍珠洋葱，甜味更突出。"
  ],
  "serving": "盛在深盘里，配土豆泥或法棍蘸汁，撒一点欧芹碎。",
  "storage": "冷藏 3 天风味更佳，冷冻可存 2 个月，复热小火慢煮。",
  "nutrition": {
   "basis": "每份（约 350g）",
   "kcal": 560,
   "protein": 42,
   "fat": 32,
   "carbs": 14,
   "sodium": 780
  },
  "safety": [
   "炖煮须保持微沸并确保牛肉完全熟透软烂。",
   "红酒含酒精与亚硫酸盐，酒精敏感人群慎食。",
   "铸铁锅炖好后锅体温度高，取用需垫手套。"
  ],
  "origin": "红酒炖牛肉是勃艮第农家的看家菜，用当地干红把牛肉炖到酥烂，酒香沉进肉里，胡萝卜与蘑菇吸饱汤汁，是法式炖菜里最扎实的一锅。",
  "tags": [
   "法国菜",
