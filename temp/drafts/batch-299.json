      {
        "t": "北豆腐切成厚片，用厨房纸轻轻压去表面水分，两面薄薄拍上一层面粉。",
        "time": 8,
        "heat": "无火",
        "tip": "豆腐水分一定要吸干，否则裹不住蛋液，下锅容易溅油脱皮。",
        "cue": "豆腐片干爽，表面均匀挂一薄层粉。"
      },
      {
        "t": "鸡蛋打散加少许盐搅匀，把拍过面粉的豆腐片逐片放入蛋液里裹匀。",
        "time": 4,
        "heat": "无火",
        "tip": "蛋液要现裹现煎，泡久了会往豆腐里渗，煎出来发散发老。",
        "cue": "豆腐片通体裹上淡黄色蛋液。"
      },
      {
        "t": "平底锅放植物油烧热，把豆腐片一片片码入锅中，小火煎到两面金黄。",
        "time": 8,
        "heat": "小火",
        "tip": "下锅后先别动，等底面定型发黄再翻，翻早了蛋皮会破。",
        "cue": "两面金黄起壳，边缘微微翘起。"
      },
      {
        "t": "沿锅边烹入高汤和生抽，加盐调味，加盖小火把汤汁慢慢塌进豆腐里。",
        "time": 6,
        "heat": "小火",
        "tip": "汤汁不要多，刚好没过豆腐一半，塌到收干才算到位。",
        "cue": "汤汁渐少，豆腐鼓起并吸饱汤汁。"
      },
      {
        "t": "汤汁收浓时撒上大葱丝，淋香油后连锅端出装盘。",
        "time": 2,
        "heat": "小火",
        "tip": "葱丝最后撒才够香，淋香油后立刻关火以免香气发苦。",
        "cue": "葱丝翠绿铺面，汤汁浓稠挂壁。"
      }
