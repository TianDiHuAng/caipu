     },
     {
      "n": "清水",
      "a": 320,
      "u": "ml",
      "note": "和面"
     }
    ]
   }
  ],
  "steps": [
   {
    "n": 1,
    "t": "温清水化开白糖和酵母，静置十分钟到表面浮起一层泡沫。",
    "time": 12,
    "heat": "无火",
    "tip": "酵母水起泡说明活性好，没泡就要换。",
    "cue": "水面浮起细密泡沫"
   },
   {
    "n": 2,
    "t": "面粉加盐拌匀，倒入酵母水和橄榄油揉成偏硬的面团。",
    "time": 12,
    "heat": "无火",
    "tip": "面团偏硬一点，烤出来才有嚼劲。",
    "cue": "面团光滑，按压回弹"
   },
   {
    "n": 3,
    "t": "盖布室温发酵六十分钟，体积涨到原来的一倍半。",
    "time": 62,
    "heat": "无火",
    "tip": "发到一倍半就够，发过头会有酸味。",
    "cue": "体积膨胀，戳洞不回缩"
   },
   {
    "n": 4,
    "t": "面团排气后分成六份，搓成长条再圈成圆环捏紧接口。",
    "time": 15,
    "heat": "无火",
    "tip": "接口一定要捏紧，否则烤时会散开。",
    "cue": "圆环粗细均匀，接口收紧"
   },
   {
