     },
     {
      "n": "黑胡椒",
      "a": 1,
      "u": "g",
      "note": "调味"
     }
    ]
   }
  ],
  "steps": [
   {
    "n": 1,
    "t": "牛油果对半切开去核，用勺子把果肉整块挖进研钵里。",
    "time": 8,
    "heat": "无火",
    "tip": "挑熟软的牛油果，按下去微微陷才够香。",
    "cue": "果肉色泽均匀，无黑斑"
   },
   {
    "n": 2,
    "t": "用叉子把果肉压成带颗粒的粗泥，别压得太细。",
    "time": 5,
    "heat": "无火",
    "tip": "留一点颗粒感，吃起来口感才有层次。",
    "cue": "粗泥状，带小块果肉"
   },
   {
    "n": 3,
    "t": "立刻挤进青柠汁拌匀，让果肉表面都裹上酸汁。",
    "time": 4,
    "heat": "无火",
    "tip": "柠檬汁能防氧化，拌好半小时都不发黑。",
    "cue": "果泥颜色保持鲜绿"
   },
   {
    "n": 4,
    "t": "洋葱切细末，番茄去籽切小丁，香菜和小米椒切碎。",
    "time": 7,
    "heat": "无火",
    "tip": "番茄一定要去籽，否则酱会出水。",
    "cue": "配料细碎，大小均匀"
   },
   {
    "n": 5,
    "t": "把配料倒进果泥里，加盐和黑胡椒翻拌均匀。",
    "time": 4,
    "heat": "无火",
    "tip": "拌的时候从底部翻起，别把果肉压烂。",
    "cue": "酱体浓稠，颜色翠绿"
   },
   {
    "n": 6,
    "t": "尝味补盐或补青柠汁，盛碗后压平表面即可上桌。",
    "time": 2,
    "heat": "无火",
    "tip": "咸淡和酸度要平衡，太淡会显得油腻。",
    "cue": "表面平整，点缀香菜叶"
   }
  ],
  "tips": [
   "挑按下去微微发软的熟牛油果，香气最足。",
   "青柠汁要立刻拌进去，防止果肉氧化发黑。",
   "番茄务必去籽，酱才不会出水变稀。"
  ],
  "mistakes": [
   "牛油果没熟就压泥，又硬又没味道。",
   "压得太细成了一碗糊，丢掉颗粒口感。",
   "拌好不盖膜，半小时表面就发黑。"
  ],
  "subs": [
   {
    "orig": "青柠",
    "sub": "柠檬",
    "ratio": "2 个:1 个",
    "note": "酸度稍弱，用量可略增。"
   },
   {
    "orig": "小米椒",
    "sub": "甜椒粉",
    "ratio": "5 克:3 克",
    "note": "不辣版本，香气更温和。"
   }
  ],
  "variations": [
   "加一勺酸奶油，口感会更加绵密。",
   "拌入少量烤玉米粒，甜味更突出。"
  ],
  "serving": "配玉米片、烤玉米和卷饼同吃，是得州墨式餐厅每桌必点的一份蘸酱。",
  "storage": "表面贴保鲜膜冷藏一天，食用前挤少许青柠汁拌匀。",
  "nutrition": {
   "basis": "每份约 120 克",
   "kcal": 180,
   "protein": 3,
   "fat": 15,
   "carbs": 9,
   "sodium": 260
  },
  "safety": [
   "牛油果与生食配料须洗净处理，做好后冷藏保存并在一天内吃完；表面贴膜可减缓氧化发黑。"
  ],
  "origin": "阿兹特克人传下来的牛油果酱，只用牛油果、青柠和辣椒捣成，如今是得州墨式餐桌上的标配蘸料。",
  "tags": [
   "得州墨式",
   "蘸酱",
   "牛油果",
   "素食"
  ],
  "overwrite": true
 },
 {
