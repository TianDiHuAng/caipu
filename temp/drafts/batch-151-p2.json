  "steps": [
   {
    "n": 1,
    "t": "大米洗净后加八百毫升清水，中火煮十五分钟到米粒开花。",
    "time": 20,
    "heat": "中火",
    "tip": "大米先煮到开花，汤才带自然稠度。",
    "cue": "米粒开花，汤色发白"
   },
   {
    "n": 2,
    "t": "酸奶放到室温回温，加面粉和鸡蛋黄用打蛋器搅到顺滑无颗粒。",
    "time": 6,
    "heat": "无火",
    "tip": "酸奶必须回温，冰冷下锅必结块。",
    "cue": "酸奶糊顺滑，无小疙瘩"
   },
   {
    "n": 3,
    "t": "舀两大勺热米汤慢慢淋进酸奶糊里，边淋边快速搅匀。",
    "time": 5,
    "heat": "无火",
    "tip": "这叫回温调稀，让酸奶先适应温度。",
    "cue": "酸奶糊变温，质地均匀"
   },
   {
    "n": 4,
    "t": "把调好的酸奶糊倒回汤锅，小火加热并持续搅拌。",
    "time": 8,
    "heat": "小火",
    "tip": "全程小火不停搅，一停就可能结块。",
    "cue": "汤体变稠，表面微微冒泡"
   },
   {
    "n": 5,
    "t": "加盐调味，保持小火再煮三分钟，汤汁变得浓稠顺滑。",
    "time": 4,
    "heat": "小火",
    "tip": "汤微沸就够，煮滚会让酸奶分层。",
    "cue": "汤浓稠挂勺，没有颗粒"
   },
   {
    "n": 6,
    "t": "小锅化开黄油，下干薄荷碎用小火炸出浓郁香味。",
    "time": 3,
    "heat": "小火",
    "tip": "薄荷一下锅就关火，炸久了会发黑。",
    "cue": "黄油浮起，薄荷飘香"
   },
   {
    "n": 7,
    "t": "盛碗后把薄荷黄油淋在汤面上，趁热食用风味最好。",
    "time": 2,
    "heat": "无火",
    "tip": "淋在表面不搅开，香气最有层次。",
    "cue": "汤面浮一层金黄油花"
   }
  ],
  "tips": [
   "酸奶务必回温，冰冷下锅一定会结块。",
   "先用热汤把酸奶调稀，再倒回锅里最稳妥。",
   "全程小火并不断搅拌，汤才不会分离。"
  ],
  "mistakes": [
   "酸奶从冰箱拿出来直接倒进热汤，瞬间结块。",
   "用大火煮开，酸奶蛋白质分离变成絮状。",
   "薄荷黄油用大火炸，几秒钟就发黑发苦。"
  ],
  "subs": [
   {
    "orig": "酸奶",
    "sub": "酸奶油",
    "ratio": "400 克:350 克",
    "note": "更浓稠，需多加两百毫升水。"
   },
   {
    "orig": "黄油",
    "sub": "橄榄油",
    "ratio": "25 克:20 毫升",
    "note": "风味更清爽。"
   }
  ],
  "variations": [
   "汤里加几颗小肉丸，做成更饱腹的版本。",
   "最后撒少许甜椒粉，颜色更红亮。"
  ],
  "serving": "配热面包和一小碟橄榄同吃，是土耳其家庭和学校食堂最常见的一道暖胃汤。",
  "storage": "冷藏两天，复热必须小火慢加热并不停搅拌，切勿大火煮沸。",
  "nutrition": {
   "basis": "每碗约 320 克",
   "kcal": 210,
   "protein": 8,
   "fat": 9,
   "carbs": 24,
   "sodium": 640
  },
  "safety": [
   "含乳制品与鸡蛋，过敏者须避免；酸奶汤加热须保持小火，避免蛋白质分离；剩汤冷藏两天内彻底加热后食用。"
  ],
  "origin": "土耳其高原牧场的家常汤，用酸奶、大米和蛋黄慢慢加热成浓汤，淋上薄荷黄油，酸香又暖胃。",
  "tags": [
   "土耳其",
