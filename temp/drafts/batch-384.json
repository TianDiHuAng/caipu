        "time": 1,
        "heat": "大火",
        "tip": "鱼露最后沿锅边淋，遇热激出香味，直接倒菜上会有生腥味。",
        "cue": "锅里冒出咸香白汽"
      },
      {
        "t": "盛盘时把菜梗垫底、菜叶铺上，淋上锅里的汤汁即可上桌。",
        "time": 2,
        "heat": "无火",
        "tip": "盘底会有少量汤汁，拌饭很香，别倒掉。",
        "cue": "菜色油绿，盘底微汤"
      }
    ],
    "tips": [
      "空心菜买回来当天吃最好，放一夜梗就发空，炒出来不脆。",
      "没有鱼露可用生抽加一点盐替，鲜味会差一截。",
      "喜欢吃辣可以加两个小米辣与蒜同爆香。",
      "锅小就分两次炒，一次炒太多会出汤变成煮菜。"
    ],
    "mistakes": [
      "火不够大就下菜，锅里出一滩绿水，口感发绵。",
      "蒜末一开始就炒到焦黑，整盘菜带苦味。",
      "菜叶菜梗一起下锅，叶子烂了梗还没熟。"
    ],
