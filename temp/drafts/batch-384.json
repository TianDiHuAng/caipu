      {
        "t": "用清水加盐把菜段泡五分钟，再换水冲洗两遍，沥干水分。",
        "time": 7,
        "heat": "无火",
        "tip": "空心菜易带泥沙，盐水泡一遍再冲，泥沙才出得净。",
        "cue": "水面清澈，菜段无泥"
      },
      {
        "t": "蒜拍碎后剁成粗粒，分成均等的两份，分别装碟备用。",
        "time": 4,
        "heat": "无火",
        "tip": "一半爆香打底，一半最后下锅留生蒜的冲劲。",
        "cue": "蒜末粗粒均匀，两份分开"
      },
      {
        "t": "炒锅烧到微微冒烟，倒植物油，下第一份蒜末爆香十秒。",
        "time": 2,
        "heat": "大火",
        "tip": "锅要够热，蒜末下锅立刻出香不焦，这是这道菜的关键。",
        "cue": "蒜末边缘泛黄，香气冲出"
      },
      {
        "t": "倒入菜梗，大火快速翻炒一分钟，让梗断生保持脆感。",
        "time": 2,
        "heat": "大火",
        "tip": "全程大火，锅气足才不出水，一炒软就没了口感。",
        "cue": "菜梗转深绿，锅底几乎无水"
      },
      {
        "t": "放入菜叶与第二份蒜末，继续大火翻炒四十秒。",
        "time": 2,
        "heat": "大火",
        "tip": "叶子一塌就够，多炒十秒就发黄出水。",
        "cue": "菜叶塌软，颜色油绿"
      },
