  "steps": [
   {
    "t": "红茶掰成小块，放进壶里冲入刚烧开的清水，盖盖焖八分钟出浓汤。",
    "time": 11,
    "heat": "大火",
    "tip": "茶要焖够时间，颜色深红味道才够压得住奶。",
    "cue": "茶汤深红，香气微苦"
   },
   {
    "t": "茶汤用细滤网过进小锅，滤掉茶叶渣，只留清亮的茶汤。",
    "time": 4,
    "heat": "无火",
    "tip": "渣子滤干净，喝起来才不挂喉咙。",
    "cue": "茶汤透亮，无碎叶"
   },
   {
    "t": "小锅上火，倒入牛奶，中小火加热到锅边冒细密小泡。",
    "time": 8,
    "heat": "小火",
    "tip": "牛奶不能大滚，沸起来会溢锅还带腥味。",
    "cue": "锅边起泡，表面浮膜"
   },
   {
    "t": "把茶汤缓缓冲进牛奶里，边倒边搅，让两色完全融匀。",
    "time": 4,
    "heat": "小火",
    "tip": "茶往奶里冲，奶不容易结皮，融合也更顺。",
    "cue": "汤色浅褐，无分层"
   },
   {
    "t": "加盐和黄油，小火搅到黄油化开，尝一下咸淡再微调。",
    "time": 4,
    "heat": "小火",
    "tip": "盐分次加，咸度到微咸回甘就停。",
    "cue": "表面泛油光，咸香扑鼻"
   },
   {
    "t": "盛进厚瓷碗，趁热喝，让碗面浮着一层薄薄的奶皮。",
    "time": 3,
    "heat": "无火",
    "tip": "奶茶凉了腥味会上来，趁热一口喝完最舒服。",
    "cue": "热气升腾，奶面细滑"
   }
  ],
  "tips": [
   "咸奶茶是新疆牧区待客的第一碗，配馕就是一顿早饭。",
   "茶要煮得浓，奶要全脂，咸淡按口味微调，别一开始就放足盐。",
   "没有砖茶时用普通红茶，多放两克也能出厚度。"
  ],
  "mistakes": [
   "牛奶烧到沸腾溢锅，奶皮糊在锅底带焦味。",
   "茶汤没滤干净，喝时一口碎叶，口感全毁。",
   "盐一次放太多，整锅奶只能倒掉，前功尽弃。"
  ],
  "subs": [
   {
    "orig": "黄油",
    "sub": "羊油",
    "ratio": "20克:20克",
    "note": "羊油版更传统，香味重，量要减到十五克。"
   },
   {
    "orig": "牛奶",
    "sub": "羊奶",
    "ratio": "1000毫升:1000毫升",
    "note": "羊奶味更浓，需多加一点盐压膻。"
   }
  ],
  "variations": [
   "加一小勺烤香的芝麻同煮，喝起来多一层坚果香。",
   "把盐换成白糖做成甜奶茶，孩子更容易接受。"
  ],
  "serving": "配刚出炉的馕或烤包子，趁热喝，一碗下去浑身发暖。",
  "storage": "现煮现喝，冷藏可存一天，复热须小火加热不要煮沸。",
  "nutrition": {
   "basis": "按四人份估算",
   "kcal": 170,
   "protein": 8,
   "fat": 10,
   "carbs": 12,
   "sodium": 520
  },
  "diet": [
   "vegetarian",
   "gluten-free"
  ],
  "tags": [
   "新疆菜",
   "饮品",
   "奶茶",
   "牛奶",
   "红茶"
  ],
  "safety": [
   "牛奶须加热至微沸并持续搅动防溢锅；冷藏的奶茶复热须彻底加热，出现异味或分层则不可饮用。"
  ],
  "origin": "咸奶茶在新疆牧区是每天的第一碗，砖茶敲碎煮出浓汤，冲进鲜奶里加盐和黄油。奶香里带一点茶的苦涩，喝完配一块馕，就是牧民出门前的早饭。客人进门，先端上来的也是这一碗。",
  "prep": 7,
  "cook": 27,
  "overwrite": true
