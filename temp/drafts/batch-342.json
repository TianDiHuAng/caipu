    "time": 8,
    "heat": "无火",
    "tip": "压一下让层次张开，蒸的时候蒸汽才进得去。",
    "cue": "塔形张开，层次分明"
   },
   {
    "t": "蒸锅上汽后放笼，大火蒸二十分钟，关火焖三分钟再揭盖。",
    "time": 25,
    "heat": "大火",
    "tip": "焖几分钟再开盖，避免骤冷回缩变硬。",
    "cue": "表面白亮，层次鼓起"
   }
  ],
  "tips": [
   "油塔子是新疆人配奶茶吃的层酥主食，掰开一层层撕着吃。",
   "面片擀得越薄，层数越多，口感越松。",
   "蒸好后趁热吃，凉了层会粘在一起。"
  ],
  "mistakes": [
   "面团发过头，蒸出来酸味重还塌成一团。",
   "油刷得太少，层与层粘死，撕不开也咬不动。",
   "蒸好立刻开盖，冷气一激表面起皱发硬。"
  ],
  "subs": [
   {
    "orig": "植物油",
    "sub": "羊油",
    "ratio": "80毫升:70毫升",
    "note": "羊油版香味更浓，是传统做法，量要略减。"
   },
   {
    "orig": "花椒",
    "sub": "黑胡椒",
    "ratio": "2克:2克",
    "note": "黑胡椒更清亮，用量相同即可。"
   }
  ],
  "variations": [
   "卷的时候撒一层切碎的洋葱，蒸出来带葱香。",
   "把盐换成糖做成甜油塔，配咸奶茶也很对味。"
  ],
  "serving": "掰开撕成层片，配一碗滚烫的咸奶茶，或者就着羊肉汤一起吃。",
  "storage": "冷藏两天，复蒸五分钟回软；不建议冷冻，层次会压塌。",
  "nutrition": {
   "basis": "按四人份估算",
   "kcal": 520,
   "protein": 13,
   "fat": 18,
   "carbs": 74,
   "sodium": 680
  },
  "diet": [
