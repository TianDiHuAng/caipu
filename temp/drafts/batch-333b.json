  "steps": [
   {
    "t": "香蕉剥皮掰成小段，挑掉果肉两端的黑丝。",
    "time": 3,
    "heat": "无火",
    "tip": "香蕉皮上带黑斑才够甜，青皮的打出来发涩，还带一股生味。",
    "cue": "香蕉段柔软，果香明显"
   },
   {
    "t": "香蕉段、冷牛奶与清水一起倒进搅拌机。",
    "time": 2,
    "heat": "无火",
    "tip": "牛奶要用冰箱里的冷的，温牛奶打出来起泡又带腥。",
    "cue": "液体淹过香蕉，杯壁结水雾"
   },
   {
    "t": "加蜂蜜与肉桂粉，高速搅打四十秒到完全顺滑。",
    "time": 2,
    "heat": "无火",
    "tip": "肉桂只要一点点，多了会盖掉香蕉的甜香，变成药味。",
    "cue": "液体顺滑无颗粒，颜色米黄"
   },
   {
    "t": "倒入长杯，表面再撒少许肉桂粉，冰镇后饮用。",
    "time": 3,
    "heat": "无火",
    "tip": "打好马上喝，放十分钟就分层，下面沉上面起泡。",
    "cue": "杯面细沫均匀，颜色均匀"
   }
  ],
  "tips": [
   "香蕉牛奶是墨西哥街头早餐摊的常客，一杯配一个面包就是一餐。",
   "香蕉先冷冻再打，口感更接近奶昔，夏天更解暑。",
   "想更香可以加一勺花生酱，是墨西哥北部的喝法。"
  ],
  "mistakes": [
   "用青香蕉打，甜度不够还发涩，只能靠加糖硬压。",
   "牛奶是热的，打出来腥味重，泡沫也消不掉。",
   "打好放太久才喝，出现分层，喝起来像兑水的糊。"
  ],
  "subs": [
   {
