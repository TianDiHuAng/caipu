    "steps": [
      {
        "t": "大米淘洗两遍后加清水浸泡二十分钟，沥干备用，让米粒吸足水分。",
        "time": 22,
        "heat": "无火",
        "tip": "泡过的米煮出来粒粒分明，不泡容易夹生。",
        "cue": "米粒饱满发白，指压易碎。"
      },
      {
        "t": "腊肠斜切厚片，腊肉切薄片，两者先用热水冲一遍去掉表面浮油和灰尘。",
        "time": 6,
        "heat": "无火",
        "tip": "腊味表面有浮油和灰尘，冲一遍蒸出来才不腥。",
        "cue": "腊味切片透亮，肥瘦分明。"
      },
      {
        "t": "砂锅内壁刷一层花生油，放入泡好的大米与清水，大火煮到水面收干、冒大泡。",
        "time": 8,
        "heat": "大火",
        "tip": "锅底刷油是起锅巴的关键，油少了锅巴粘底刮不下来。",
        "cue": "水泡密集，米饭表面出现小孔。"
      },
      {
        "t": "把腊肠片和腊肉片铺在饭面上，沿锅边淋一圈花生油，盖盖转小火焗十五分钟。",
        "time": 16,
        "heat": "小火",
        "tip": "腊味铺在饭面靠蒸汽焗熟，油脂顺着孔洞渗进米饭。",
        "cue": "锅边冒出细密热气，腊味油亮。"
      },
      {
        "t": "另起小锅，把生抽、老抽、白糖、蚝油和两勺清水小火煮开，做成煲仔饭豉油。",
        "time": 4,
        "heat": "小火",
        "tip": "豉油煮过才不冲口，甜咸也更融合。",
        "cue": "豉油微滚，色深红亮。"
      },
      {
        "t": "开盖在饭面打一个鸡蛋，盖上再焗三分钟，把焯熟的小白菜摆在旁边。",
        "time": 4,
        "heat": "小火",
        "tip": "鸡蛋焗三分钟是溏心，喜全熟的可多焗一分钟。",
        "cue": "蛋白凝固、蛋黄半透。"
      },
      {
        "t": "淋上豉油和香油，静置两分钟再拌开，让锅巴与米饭混着吃。",
        "time": 3,
        "heat": "无火",
        "tip": "淋汁后静置，锅巴吸汁变脆香，立刻拌就软了。",
        "cue": "锅底锅巴金黄，米饭油亮。"
      }
    ],
    "tips": [
      "米选油粘米或丝苗米，细长爽口，吸水少不易糊。",
      "砂锅要选厚壁的，受热均匀锅巴才整片不焦。",
      "腊味本身够咸，豉油少放，边吃边加。"
    ],
    "mistakes": [
      "米不泡就煮，外层烂了里面还是硬的。",
      "全程大火，锅底焦黑而饭还夹生。",
      "豉油一次全倒进去，饭泡软了，锅巴也没了脆劲。"
    ],
    "subs": [
      {
        "orig": "腊肠",
        "sub": "腊肉",
        "ratio": "1:1",
        "note": "只用腊肉也行，切薄片铺满饭面，油脂更足。"
      },
      {
        "orig": "小白菜",
        "sub": "菜心",
        "ratio": "1:1",
        "note": "菜心焯三十秒即可，脆嫩清甜，配腊味解腻。"
      }
    ],
    "variations": [
      "顺德一带会在饭快熟时沿锅边淋一勺猪油，锅巴更酥香。",
      "有的店家把腊味先蒸五分钟再铺上去，油更清、咸味也更柔。"
    ],
    "serving": "整锅上桌，淋豉油后拌开，配一碟焯青菜和热茶；锅巴是最好吃的部分。",
    "storage": "现做现吃，冷藏可存一日；复热加一勺清水盖盖小火焖五分钟，锅巴能回脆。",
