  "steps": [
   {
    "t": "青柠用盐搓洗表皮，冲净后切去两端再切成八瓣。",
    "time": 4,
    "heat": "无火",
    "tip": "表皮要洗净，白色筋络别留太多。",
    "cue": "表皮洁净，切块均匀"
   },
   {
    "t": "青柠块连皮放入榨汁机，加三百毫升清水一起打十秒。",
    "time": 2,
    "heat": "无火",
    "tip": "只打十秒，打久了皮油发苦。",
    "cue": "液体翠绿，果肉打散"
   },
   {
    "t": "用细网滤网过滤到壶中，用勺背压出剩余汁水。",
    "time": 3,
    "heat": "无火",
    "tip": "压的时候别太用力，白瓤会带苦味。",
    "cue": "滤液清澈，渣滓留在网上"
   },
   {
    "t": "加白糖与炼乳搅到完全化开，尝一口调整甜度。",
    "time": 2,
    "heat": "无火",
    "tip": "先少放糖，青柠酸度差异很大。",
    "cue": "甜酸平衡，颜色奶绿"
   },
   {
    "t": "倒入余下的清水搅拌均匀，冷藏半小时后再饮用。",
    "time": 30,
    "heat": "无火",
    "tip": "冷藏后风味更融合，酸味更柔和。",
    "cue": "液体顺滑，凉透壶壁"
   },
   {
    "t": "壶身冰镇好后倒入玻璃杯，放一片青柠片装饰即可。",
    "time": 1,
    "heat": "无火",
    "tip": "杯子也提前冷藏，喝起来更清爽。",
    "cue": "杯壁挂霜，颜色清新"
   }
  ],
  "tips": [
   "青柠连皮打会带一点苦香，这是它的特色。",
   "炼乳能让酸味更圆润，别省这一步。",
   "打好尽快喝，放久会分层并带出皮油苦味。"
  ],
  "mistakes": [
   "榨汁机打太久，皮油析出整杯发苦。",
   "糖一次性放太多，酸甜完全失衡只剩甜味。",
   "滤网孔太粗，喝起来满口果渣影响口感。"
  ],
