  "steps": [
   {
    "n": 1,
    "t": "老豆腐切成半厘米厚的方片，放淡盐水里浸泡几分钟去掉豆腥味。",
    "time": 6,
    "heat": "无火",
    "tip": "用老豆腐才煎得挺，嫩豆腐一碰就碎。",
    "cue": "豆腐片边缘紧实，不塌不裂"
   },
   {
    "n": 2,
    "t": "冬笋剥壳切片，放进开水里焯一下去掉涩味和草酸。",
    "time": 5,
    "heat": "大火",
    "tip": "笋片不焯会涩口扎嘴，这步不能省。",
    "cue": "笋片颜色转深，闻着清甜"
   },
   {
    "n": 3,
    "t": "平底锅倒植物油烧热，豆腐片平铺下锅，中火煎到两面金黄。",
    "time": 8,
    "heat": "中火",
    "tip": "下锅后先别动，等底面结皮再翻面。",
    "cue": "两面焦黄结皮，晃动锅会滑动"
   },
   {
    "n": 4,
    "t": "把豆腐片拨到锅边，下姜末炒香，放笋片中火煸炒。",
    "time": 3,
    "heat": "中火",
    "tip": "笋片煸到边缘发干，香气才出得来。",
    "cue": "笋片边缘微黄，锅里有清香"
   },
   {
    "n": 5,
    "t": "加生抽、白糖和清水，与豆腐一起中小火烧到入味。",
    "time": 5,
    "heat": "中小火",
    "tip": "水别多，略烧一下让豆腐吃味就好。",
    "cue": "汤汁微沸，豆腐吸色变深"
   },
   {
    "n": 6,
    "t": "尝味补盐，撒葱段翻匀，收干汤汁出锅装盘。",
    "time": 3,
    "heat": "中火",
    "tip": "收汁到锅底无流动汤汁最香口。",
    "cue": "汤汁收干，豆腐油润发亮"
   }
  ],
  "tips": [
   "豆腐用淡盐水泡过再煎，不易碎也去豆腥。",
   "笋片必须焯水，去掉涩味口感才清甜。",
   "煎豆腐要有耐心，结皮后再翻面才完整。"
  ],
  "mistakes": [
   "用嫩豆腐煎，翻面就碎成小块。",
   "笋片不焯直接炒，成品涩口发麻。",
   "煎时频繁翻动，豆腐皮全破了。"
  ],
  "subs": [
   {
    "orig": "冬笋",
    "sub": "春笋",
    "ratio": "150 克:150 克",
    "note": "口感更嫩，焯水时间减半即可。"
   },
   {
    "orig": "豆腐",
    "sub": "老豆腐干",
    "ratio": "450 克:300 克",
    "note": "更耐煎，需先泡软再切片。"
   }
  ],
  "variations": [
   "加几片咸肉同煎，徽州风味更足。",
   "起锅前淋几滴香油，香气更柔和。"
  ],
  "serving": "热食最佳，配米饭或稀饭都很合适。",
  "storage": "冷藏两天，复热加少许清水小火焖热，别用微波否则发硬。",
  "nutrition": {
   "basis": "每份约 220 克",
   "kcal": 280,
   "protein": 18,
   "fat": 20,
   "carbs": 9,
   "sodium": 640
  },
  "allergens": [
   "soy"
  ],
  "safety": [
   "煎制时油温较高，豆腐片含水易溅油，下锅时沿锅边轻放；剩菜冷藏两天内复热烧透。"
  ],
  "origin": "皖南山区春天的家常做法，新笋配老豆腐，一煎一烧，笋的清甜渗进豆腐里。徽州人做这道菜讲究笋要新、豆腐要老、火要稳，三样齐了才对味。",
  "tags": [
   "安徽",
   "豆腐",
   "笋",
   "家常"
  ]
