    "steps": [
      {
        "t": "鸡腿肉切三厘米块，用厨房纸吸干表面水分，撒三克盐与黑胡椒抓匀腌十分钟。",
        "time": 12,
        "heat": "无火",
        "tip": "吸干水分再下锅才容易上色，湿的鸡肉只会白白出水。",
        "cue": "鸡肉表面干爽，调料均匀附着"
      },
      {
        "t": "厚底锅放橄榄油，中火把鸡皮朝下煎四分钟到金黄，翻面再煎两分钟盛出。",
        "time": 7,
        "heat": "中火",
        "tip": "鸡皮先煎出油，后面煮饭的汤汁才香而不腻。",
        "cue": "鸡皮金黄微焦，锅底留下一层油"
      },
      {
        "t": "锅里下洋葱碎与蒜末，中小火炒到洋葱透明发软，约三分钟。",
        "time": 4,
        "heat": "中小火",
        "tip": "洋葱炒透了饭才有甜底味，这一步别省时间。",
        "cue": "洋葱透明，蒜香明显但不焦"
      },
      {
        "t": "倒入米粒翻炒两分钟，让每粒米都裹上一层油，边缘略透亮。",
        "time": 3,
        "heat": "中火",
        "tip": "生米先炒过，煮出来粒粒分明不黏糊。",
        "cue": "米粒油亮，锅里有轻微噼啪声"
      },
      {
        "t": "加青椒条、香叶与剩余的盐翻匀，倒入热高汤，汤面要盖过米约一厘米。",
        "time": 4,
        "heat": "中火",
        "tip": "高汤必须是热的，冷水会让米粒外层骤缩，煮出来夹生。",
        "cue": "汤面平稳，米粒分布均匀"
      },
      {
        "t": "把煎好的鸡块铺在饭面，番茄厚片摆在鸡块之间，整锅推到炉上煮五分钟。",
        "time": 6,
        "heat": "中火",
        "tip": "番茄摆上层，烤的时候汁水会往下渗，饭更湿润。",
        "cue": "鸡块与番茄交替排列，汤面微滚"
      },
      {
        "t": "整锅送进两百度烤箱烤二十分钟，让表层结出薄薄一层微焦的饭壳。",
        "time": 20,
        "heat": "大火",
        "tip": "烤箱的高温是这道菜的关键，表层焦香底层湿润才对。",
        "cue": "表层米粒微焦，番茄边缘起皱"
      },
      {
        "t": "出炉盖布静置八分钟，让水分重新分布，再用勺子从锅边挖开分装。",
        "time": 10,
        "heat": "无火",
        "tip": "静置能让饭心定型，急着盛会散成一锅稠粥。",
        "cue": "饭粒分明，锅边有一圈焦脆饭壳"
      }
    ],
    "tips": [
      "用短粒米或西班牙米最好，长粒米吸汤少，容易煮成硬芯。",
      "没有烤箱可以把锅盖紧用小火焖二十分钟，底部会形成一层锅巴。",
      "高汤换成海鲜汤底，再加几只虾仁就是海鲜版本。",
      "锅底的焦饭壳是最好吃的部分，别丢掉。"
    ],
    "mistakes": [
      "高汤一次加太多，烤完变成一锅稠粥，完全失去粒粒分明的口感。",
      "米不炒直接加汤，煮出来黏成一团，香气也弱。",
      "烤完立刻开盖盛饭，水汽没散，饭粒又黏又软。"
    ],
    "subs": [
      {
        "orig": "鸡腿肉",
        "sub": "猪排骨",
        "ratio": "300克:350克",
        "note": "需先焯水去血沫，烤制时间延长十分钟。"
      },
      {
        "orig": "高汤",
        "sub": "清水加鸡精",
        "ratio": "800毫升:800毫升加5克",
        "note": "鲜味折半，需多加一片香叶提香。"
      }
    ],
    "variations": [
      "加一把泡发的白豆与血肠片，做成瓦伦西亚乡下的丰盛版本。",
      "全素版把鸡肉换成蘑菇与彩椒，高汤改用蔬菜汤。"
    ],
    "serving": "直接端锅上桌，配一碟蒜香蛋黄酱与酸黄瓜，四人均分。",
    "storage": "冷藏两天内吃完，复热时加一勺高汤盖锡纸烤十分钟；不建议冷冻，米粒会返生。",
    "nutrition": {
