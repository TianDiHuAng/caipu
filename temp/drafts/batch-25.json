  ],
  "steps": [
   {
    "t": "草鱼去骨取净肉，斜刀片成 0.3cm 厚的薄片，鱼骨斩段备用。",
    "time": 18,
    "heat": "无火",
    "tip": "逆着鱼纹斜片，口感才滑嫩。",
    "cue": "鱼片透光、厚薄均匀"
   },
   {
    "t": "鱼片加 4g 盐、白胡椒、料酒与蛋清抓至发黏，再拌入 25g 淀粉腌 10 分钟。",
    "time": 12,
    "heat": "无火",
    "tip": "上浆抓好才锁得住水，煮后不柴。",
    "cue": "鱼片挂糊均匀、不粘连"
   },
   {
    "t": "豆芽下开水焯 1 分钟，捞出铺在大盆底部。",
    "time": 3,
    "heat": "大火",
    "tip": "豆芽垫底能吸油，也防止鱼片粘盆。",
    "cue": "豆芽断生、颜色透明"
   },
   {
    "t": "炒锅倒 60ml 植物油，下豆瓣酱与姜片小火炒 2 分钟出红油，加 800ml 水烧开。",
    "time": 5,
    "heat": "小火",
    "tip": "红油炒足，汤底才够香够红。",
    "cue": "汤色红亮、表面浮油"
   },
   {
    "t": "先下鱼骨煮 3 分钟，再逐片放入鱼片，改小火烫 90 秒至变白立即关火。",
    "time": 6,
    "heat": "小火",
    "tip": "鱼片下锅别搅动，一搅就碎。",
    "cue": "鱼片蜷曲发白、肉质弹嫩"
   },
   {
    "t": "连汤倒入铺豆芽的盆中，表面撒干辣椒段、花椒与蒜末。",
    "time": 3,
    "heat": "无火",
    "tip": "辣椒蒜末铺在最上层，泼油才能激香。",
    "cue": "表层铺满辣椒花椒、层次分明"
   },
   {
    "t": "另起锅烧 90ml 植物油至冒青烟，分三次泼在辣椒蒜末上，撒小葱花即可。",
    "time": 3,
    "heat": "大火",
    "tip": "油要烧到冒烟，激不出香就白做。",
    "cue": "滋啦作响、红油翻滚香气冲鼻"
   }
  ],
  "tips": [
   "鱼片逆纹斜片，厚度控制在 0.3cm 最好。",
   "上浆加蛋清，煮出来滑得像豆腐。",
   "泼油的温度必须足够高，香气全靠这一下。"
  ],
  "mistakes": [
   "鱼片顺纹切片，煮后卷缩发硬。",
   "鱼片下锅后用力搅拌，全部碎成小块。",
   "油温不够就泼，辣椒生涩、香味出不来。"
  ],
  "subs": [
   {
    "orig": "草鱼",
    "sub": "黑鱼",
    "ratio": "800g 对 700g",
    "note": "肉更紧实，烫的时间加 30 秒。"
   },
   {
    "orig": "豆瓣酱",
    "sub": "水煮鱼调料包",
    "ratio": "40g 对 1 包",
    "note": "咸度较高，盐减 3g。"
   }
  ],
  "variations": [
   "番茄版：去掉豆瓣酱用番茄炒底，做不辣版本。",
   "藤椒版：泼油时加 10g 鲜藤椒，麻香更清亮。"
  ],
  "serving": "趁热上桌，鱼片蘸汤吃，配米饭绝佳。",
  "storage": "冷藏 1 天，复热需小火加热不可久煮。",
  "nutrition": {
   "basis": "每份（约 200g 鱼片）",
   "kcal": 460,
   "protein": 34,
   "fat": 30,
   "carbs": 10,
   "sodium": 1100
  },
  "safety": [
   "淡水鱼刺较多，给儿童食用前需仔细挑净细刺。",
   "泼热油时油温极高，操作时远离面部并保持锅具稳定。",
   "鱼片必须烫至完全变白熟透，不可生食。"
  ],
  "origin": "水煮鱼源自重庆江边渔家，把鱼片在豆瓣红汤中烫熟再泼上滚油辣椒，麻辣鲜香直冲鼻腔，是川菜里最具视觉冲击的一道鱼菜。",
  "tags": [
