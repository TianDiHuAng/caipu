      "note": "隔夜白面包"
     }
    ]
   },
   {
    "group": "aux",
    "items": [
     {
      "n": "大蒜",
      "a": 10,
      "u": "g",
      "note": "去皮"
     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "橄榄油",
      "a": 100,
      "u": "ml",
      "note": "乳化"
     },
     {
      "n": "白醋",
      "a": 15,
      "u": "ml",
      "note": "调味"
     },
     {
      "n": "盐",
      "a": 5,
      "u": "g",
      "note": "调味"
     }
    ]
   }
  ],
  "equipment": [
   "搅拌机",
   "汤锅",
   "碗"
  ],
  "steps": [
   {
    "t": "番茄 800g 顶部划十字，用开水烫 30 秒后撕去表皮，切成大块。",
    "time": 8,
    "heat": "无火",
    "tip": "烫 30 秒就好，久了肉质变散。",
    "cue": "番茄皮轻松撕下、果肉完整"
   },
   {
    "t": "隔夜白面包 100g 撕成小块，用少量清水浸软后挤干水分。",
    "time": 5,
    "heat": "无火",
    "tip": "隔夜面包吸水性更好。",
    "cue": "面包块软塌、捏之成团"
   },
   {
    "t": "番茄块、面包、10g 大蒜与 5g 盐放入搅拌机，高速打 2 分钟至顺滑。",
    "time": 4,
    "heat": "无火",
    "tip": "打久一点，质地才细腻。",
    "cue": "糊体顺滑、无颗粒感"
   },
   {
    "t": "保持搅拌，从投料口分次淋入 100ml 橄榄油，打到酱体发亮变稠。",
    "time": 4,
    "heat": "无火",
    "tip": "油缓慢淋入才能乳化。",
    "cue": "酱体浓稠发亮、能挂勺"
   },
   {
    "t": "加 15ml 白醋搅匀，尝味后按需补盐，冷藏 30 分钟风味更融合。",
    "time": 3,
    "heat": "无火",
    "tip": "冷藏后酸味会变柔和。",
    "cue": "酱色橙红、质地细腻"
   }
  ],
  "tips": [
   "番茄必须撕皮，否则酱体带渣影响口感。",
   "橄榄油要缓慢淋入，一次倒完会油水分离。",
   "冷藏半小时再吃，酸味和蒜味会更融合。"
  ],
  "mistakes": [
   "番茄带皮直接打，酱里全是细小皮渣。",
   "橄榄油一次倒入，酱体表面浮一层油。",
   "大蒜放太多，辛辣味压过番茄的清甜。"
  ],
  "subs": [
   {
    "orig": "面包",
    "sub": "无麸质面包",
    "ratio": "100g 对 100g",
    "note": "口感略粗，需多打 30 秒。"
   },
   {
    "orig": "白醋",
    "sub": "雪莉醋",
    "ratio": "15ml 对 15ml",
    "note": "风味更接近安达卢西亚原版。"
   }
  ],
  "variations": [
   "浓稠版：面包加到 150g 做成蘸酱。",
   "加料版：表面撒切碎的水煮蛋与火腿丁。"
  ],
  "serving": "盛入碗中，淋少许橄榄油，配面包块或炸面包丁。",
  "storage": "冷藏 2 天，食用前搅匀即可。",
  "nutrition": {
   "basis": "每份（约 230g）",
   "kcal": 290,
   "protein": 4,
   "fat": 26,
   "carbs": 12,
   "sodium": 520
  },
  "allergens": [
   "gluten"
  ],
  "diet_tags": [],
  "safety": [
   "酱料为生拌冷食，须冷藏保存并在 2 天内食用完。",
   "番茄烫皮时注意开水温度，避免烫手。"
  ],
  "tags": [
   "西班牙",
   "酱汁",
   "番茄",
   "冷食"
  ],
  "origin": "Salmorejo 是西班牙安达卢西亚的夏日冷汤，也可以当作浓稠蘸酱。番茄撕皮后与隔夜面包、大蒜一起打细，再慢慢淋入橄榄油乳化成橙红色浓浆，最后用白醋和盐收口。质地比凉菜汤更稠，配面包丁很过瘾。",
  "related": [
   "gazpacho",
   "romesco-sauce",
   "bruschetta"
  ],
  "overwrite": true
 },
