  ],
  "steps": [
   {
    "t": "虾仁 400g 沿背部划开挑去虾线，用清水冲净后用厨房纸吸干水分。",
    "time": 10,
    "heat": "无火",
    "tip": "虾线去净，腥味才彻底消失。",
    "cue": "虾仁干爽、背缝清晰"
   },
   {
    "t": "吸干的虾仁加 2g 盐抓匀腌 5 分钟，罗勒叶摘下洗净沥干备用。",
    "time": 6,
    "heat": "无火",
    "tip": "腌一下虾肉更紧实弹牙。",
    "cue": "虾仁表面微黏、罗勒叶干爽"
   },
   {
    "t": "炒锅倒 35ml 植物油烧至七成热，下虾仁大火煎 90 秒至边缘转红，盛出。",
    "time": 3,
    "heat": "大火",
    "tip": "虾先煎定型，回锅才不会出水。",
    "cue": "虾身卷曲、两面粉红"
   },
   {
    "t": "原锅留底油，下蒜末、洋葱丝与干辣椒段，中火炒 2 分钟至香味散出。",
    "time": 3,
    "heat": "中火",
    "tip": "蒜末别炒到发黑，微黄就够。",
    "cue": "洋葱透明、锅中香气浓"
   },
   {
    "t": "倒回虾仁，加 20ml 鱼露、10ml 生抽与 6g 白糖，大火快速翻炒 1 分钟。",
    "time": 2,
    "heat": "大火",
    "tip": "调味后动作要快，虾肉才不老。",
    "cue": "酱汁裹匀、虾仁油亮"
   },
   {
    "t": "关火放入罗勒叶，用余温翻拌至叶片微微萎缩即可装盘。",
    "time": 2,
    "heat": "无火",
    "tip": "罗勒关火再放，香气最足。",
    "cue": "罗勒叶翠绿微塌、香气冲鼻"
   }
  ],
  "tips": [
   "虾仁先煎定型再回锅，肉质才紧实不出水。",
   "罗勒必须关火后再放，高温久炒会发黑。",
   "虾仁腌 5 分钟就够，腌久会流失水分变柴"
  ],
  "mistakes": [
   "虾仁带水下锅，锅里瞬间出水变成白煮虾。",
   "干辣椒炒到焦黑，整盘菜带着糊味。",
   "罗勒早早下锅，出锅时叶子全黑了。"
  ],
  "subs": [
   {
    "orig": "虾仁",
    "sub": "鲜虾",
    "ratio": "400g 对 500g",
    "note": "需自行去壳去虾线。"
   },
   {
    "orig": "鱼露",
    "sub": "生抽",
    "ratio": "20ml 对 18ml",
    "note": "鲜味稍弱，糖可加 2g。"
   }
  ],
  "variations": [
   "九层塔版：用九层塔替换罗勒，香气更冲。",
   "椰浆版：起锅前加 50ml 椰浆增润。"
  ],
  "serving": "配白米饭装盘，旁边放一碟辣椒鱼露蘸食。",
  "storage": "现做现吃，冷藏后再热虾肉会变韧。",
  "nutrition": {
   "basis": "每份（约 200g）",
   "kcal": 300,
   "protein": 30,
   "fat": 16,
   "carbs": 9,
   "sodium": 900
  },
  "allergens": [
   "crustacean",
   "fish"
  ],
  "diet_tags": [],
  "safety": [
   "虾属甲壳类过敏原，过敏人群请避开；须炒至虾身完全变红卷曲熟透。",
   "含鱼露，过敏人群可替换为生抽。"
  ],
  "tags": [
   "泰国",
   "海鲜",
   "虾仁",
   "快炒"
  ],
  "origin": "泰式罗勒炒虾是曼谷街边小炒的代表，虾仁先大火煎定型，再用蒜末、洋葱和干辣椒爆香，鱼露与生抽快速翻匀，最后关火拌入一把罗勒。辣、咸、香层层压上来，配白饭能吃两碗。",
  "related": [
   "pu-pad-pong-curry",
   "thai-cashew-chicken",
   "tom-yum-goong"
  ],
  "overwrite": true
