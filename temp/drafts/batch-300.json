    "steps": [
      {
        "t": "五花肉切成细丝，大白菜洗净切成细丝，小葱切成葱花留作炝锅。",
        "time": 8,
        "heat": "无火",
        "tip": "白菜帮子要切得跟肉丝一样细，煮出来才同时软熟。",
        "cue": "肉丝细匀，白菜丝宽窄一致。"
      },
      {
        "t": "炒锅放植物油烧到微冒青烟，下五花肉丝大火煸到变色出油。",
        "time": 4,
        "heat": "大火",
        "tip": "油温够高才能炝出香味，温油下锅只会把肉丝煮老。",
        "cue": "肉丝变色卷边，锅里有明显油香。"
      },
      {
        "t": "下葱花和姜丝快速炝出香味，随即倒入生抽激出酱香。",
        "time": 3,
        "heat": "大火",
        "tip": "葱花入锅三五秒就够，炝糊了整锅汤都会发苦。",
        "cue": "葱香扑鼻，酱汁在锅里翻起小泡。"
      },
      {
        "t": "放入大白菜丝大火翻炒到变软塌，再冲入清水烧开。",
        "time": 6,
        "heat": "大火",
        "tip": "清水一次加足，中途补水汤味会淡，面条也容易糊。",
        "cue": "汤色微白，白菜丝软塌浮起。"
      },
      {
        "t": "下入面条用筷子抖散，中火煮到面条断生浮起，加盐调味。",
        "time": 6,
        "heat": "中火",
        "tip": "面条下锅后立刻抖散，粘成一坨就再也分不开。",
        "cue": "面条浮起有弹性，咬开无白芯。"
      },
      {
        "t": "连汤带面一起盛入大碗，撒上一把香菜碎即可上桌。",
        "time": 1,
        "heat": "无火",
        "tip": "汤要多盛些，炝锅面的魂就在这口汤里。",
        "cue": "碗里汤宽面足，香菜翠绿。"
      }
    ],
    "tips": [
      "炝锅的油温要足够高，葱花下去滋啦一声才算到位。",
      "清水一次加足，中途补水会稀释汤的鲜味。",
      "面条下锅后立刻用筷子抖散，避免粘成一坨。"
    ],
    "mistakes": [
      "葱花下锅炒到发黑发糊，整锅面汤都带着焦苦味。",
      "白菜没炒软就加水，吃起来生硬还带青气。",
      "面条煮过头泡在汤里，端上桌已经软烂无筋。"
    ],
    "subs": [
      {
        "orig": "五花肉",
        "sub": "虾仁",
        "ratio": "100克:120克",
        "note": "换成虾仁炝锅就是海鲜版，汤头更清鲜。"
      },
      {
        "orig": "大白菜",
        "sub": "韭菜",
        "ratio": "200克:150克",
        "note": "最后下韭菜段稍烫，香气更冲，需减盐。"
      }
    ],
    "variations": [
      "济南人家冬天会加一把泡软的粉条同煮，更抗饿。",
      "喜欢辣的在炝锅时放两个干辣椒，汤里带一点辣香。"
    ],
    "serving": "炝锅面连汤带面一大碗，冬天端上桌热气腾腾，配几瓣蒜或一碟咸菜最舒坦。",
    "storage": "面条与汤分开冷藏可存一天，复热时把面条放进滚汤里烫三十秒再吃。",
    "nutrition": {
      "basis": "按三人份估算",
