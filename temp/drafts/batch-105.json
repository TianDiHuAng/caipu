  "steps": [
   {
    "t": "干辣椒温水泡软，洋葱、大蒜、姜与香茅白色根部切小块。",
    "time": 15,
    "heat": "无火",
    "tip": "香茅只用白色根部，绿色部分纤维太粗。",
    "cue": "辣椒软化，配料切块均匀"
   },
   {
    "t": "所有香料料放进料理机，加少量水打成细腻的酱糊。",
    "time": 6,
    "heat": "无火",
    "tip": "酱糊要打到看不见颗粒，煮时才不会糊底。",
    "cue": "酱体橙黄细腻，无明显颗粒"
   },
   {
    "t": "厚底锅下植物油，小火炒香料糊八分钟至出油、颜色加深。",
    "time": 9,
    "heat": "小火",
    "tip": "炒香料糊必须小火慢炒，火大会立刻发苦。",
    "cue": "油分析出，酱色转深橙红"
   },
   {
    "t": "放入牛肉块翻炒到表面变色，每一块都裹满香料糊。",
    "time": 6,
    "heat": "中火",
    "tip": "牛肉先裹香料再下椰奶，味道才进得去。",
    "cue": "肉块表面不再泛红"
   },
   {
    "t": "倒入椰奶与罗望子水，煮开后转最小火慢炖一小时。",
    "time": 62,
    "heat": "小火",
    "tip": "全程保持微沸冒小泡，滚太猛椰奶会分层。",
    "cue": "液面微沸，油花浮起"
   },
   {
    "t": "干锅把椰蓉炒到深褐色出香，倒进锅里继续炖四十分钟。",
    "time": 42,
    "heat": "小火",
    "tip": "椰蓉炒到深褐是仁当颜色和干香的关键。",
    "cue": "椰蓉焦褐，汤汁变稠"
   },
   {
    "t": "不断翻动收汁，直到椰奶完全收干、香料裹在肉上呈黑褐色。",
    "time": 22,
    "heat": "小火",
    "tip": "收汁阶段要勤翻，糖分多极易糊底。",
    "cue": "肉块深褐油亮，锅底干爽"
   },
   {
    "t": "加盐调定味道后关火，静置十分钟再盛盘上桌。",
    "time": 11,
    "heat": "无火",
    "tip": "静置让香料油回落，风味更沉稳。",
    "cue": "表面油亮，香气浓郁辛甜"
   }
  ],
  "tips": [
   "全程小火慢炖，火大椰奶会分离出渣。",
   "椰蓉炒到深褐再下锅，颜色才够地道。",
   "仁当收汁越干越耐放，可当佐饭小菜。"
  ],
  "mistakes": [
   "用大火猛煮，椰奶油水分离，酱汁变成絮状。",
   "香料糊没炒出油就下椰奶，味道生涩发苦。",
   "收汁时走开不管，锅底焦糊整锅都带糊味。"
  ],
  "subs": [
   {
    "orig": "牛肉",
    "sub": "鸡腿肉",
    "ratio": "900 克:900 克",
    "note": "炖制时间缩短至四十分钟，更易入味。"
   },
   {
    "orig": "椰奶",
    "sub": "椰浆",
    "ratio": "600 毫升:400 毫升",
    "note": "需加两百毫升水稀释，否则过浓。"
   }
  ],
  "variations": [
   "加一把土豆块同炖，吸满酱汁后格外香。",
   "收汁更干做成仁当干咖喱，可冷藏当佐餐小菜。"
  ],
  "serving": "配白饭或椰浆饭，再来一碟腌黄瓜解辣。",
  "storage": "冷藏四天、冷冻一个月；复热加两大勺椰奶小火化开，避免干烧。",
  "nutrition": {
   "basis": "每份约 300 克",
   "kcal": 720,
   "protein": 40,
   "fat": 54,
   "carbs": 18,
   "sodium": 860
  },
  "safety": [
   "牛肉须炖至中心完全熟透、能轻松插入叉子，中心温度七十五度以上；炖煮中须保持微沸避免椰奶分层；剩菜两小时内冷藏并彻底复热。"
  ],
  "origin": "苏门答腊的宴席菜，椰奶和十几种香料慢炖到几乎收干，牛肉被黑褐色的酱料紧紧裹住。传说要炖到汁全干才算好，能放上好几天不坏，是最耐存的一道咖喱。",
  "tags": [
   "印尼",
   "牛肉",
   "椰奶",
   "慢炖"
  ]
