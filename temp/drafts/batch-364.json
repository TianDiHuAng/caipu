  "steps": [
   {
    "t": "猪颈肉用厨房纸吸干表面水分，逆着纹理切成半厘米厚的大片。",
    "time": 8,
    "heat": "无火",
    "tip": "逆纹切才不塞牙，切太薄煎完会又干又硬。",
    "cue": "肉片厚薄一致，表面干爽不渗水"
   },
   {
    "t": "梨去皮磨成细腻的泥，洋葱取一半也磨成泥备用。",
    "time": 6,
    "heat": "无火",
    "tip": "梨泥里的果酸能软化肉质，是韩式腌料的关键。",
    "cue": "泥体细腻多汁，用勺子能舀起流动"
   },
   {
    "t": "辣椒酱、辣椒粉、生抽、白糖、蒜泥、姜泥与梨泥拌成腌料。",
    "time": 5,
    "heat": "无火",
    "tip": "先拌成顺滑的酱再下肉，味道分布才均匀。",
    "cue": "腌料呈浓稠的深红色，看不出颗粒"
   },
   {
    "t": "肉片与腌料抓匀，加黑胡椒与盐，冷藏静置至少两小时。",
    "time": 120,
    "heat": "无火",
    "tip": "腌两小时够入味，隔夜更透但也更容易咸。",
    "cue": "每片肉都被红酱裹住，盆底留有酱汁"
   },
   {
    "t": "平底锅烧热植物油，肉片抖掉多余酱料后摊开下锅。",
    "time": 4,
    "heat": "中火",
    "tip": "酱料抖掉一些，不然糖分很快烧黑粘锅。",
    "cue": "肉片平铺入锅，边缘立刻冒出小泡"
   },
   {
    "t": "转一面煎三分钟再翻面，两面都带焦边后盛出装盘。",
    "time": 8,
    "heat": "中火",
    "tip": "别急着翻动，等肉片自己脱锅再翻才不破。",
    "cue": "表面焦红发亮，厚度略微收缩"
   },
   {
    "t": "肉片装盘，淋上芝麻油，撒白芝麻、洋葱丝与葱花，配生菜趁热吃。",
    "time": 3,
    "heat": "无火",
    "tip": "配一片生菜和蒜片，油腻感立刻被压下去。",
    "cue": "酱色油亮，芝麻与葱花均匀点缀"
   }
  ],
  "tips": [
   "用烤盘代替平底锅，焦香会更明显。",
   "腌料里加一勺蜂蜜，烤出来色泽更红亮。",
   "肉片改成五花肉，肥瘦相间更适合包菜吃。",
   "剩下的腌料别浪费，拌洋葱丝当小菜正好。"
  ],
  "mistakes": [
   "肉片切得太薄，煎完缩成硬片，咬起来像肉干。",
   "腌料没抖就直接下锅，糖分烧焦后整锅发苦。",
   "全程大火猛煎，外面焦了里面还是生的。"
  ],
  "subs": [
