    "steps": [
      {
        "t": "花蛤提前用淡盐水养两小时吐净泥沙，外壳逐个刷洗干净后沥干。",
        "time": 5,
        "heat": "无火",
        "tip": "泡蛤的水里滴几滴油，吐沙更快更干净。",
        "cue": "盆底沉下细沙，蛤壳光洁。"
      },
      {
        "t": "五花肉切薄片，加料酒与白胡椒粉抓匀；干香菇用温水泡发后切细丝。",
        "time": 8,
        "heat": "无火",
        "tip": "香菇水留着一起入锅，鲜味全在里面。",
        "cue": "肉片均匀，香菇丝软身。"
      },
      {
        "t": "葱姜蒜分别切成末，芹菜切段，豆芽掐去根须冲净沥干。",
        "time": 5,
        "heat": "无火",
        "tip": "豆芽掐根虽然费事，但口感差别明显。",
        "cue": "配料分装干净，豆芽不带黑头。"
      },
      {
        "t": "花生油烧到五成热，下五花肉片煸到出油微焦，加葱姜蒜末炒香。",
        "time": 6,
        "heat": "中火",
        "tip": "肉要煸透出油，卤面的底味才厚。",
        "cue": "肉片卷边发黄，锅里有油脂。"
      },
      {
        "t": "下香菇丝与虾米炒香，加生抽、老抽、白糖炒匀，倒入清水与香菇水煮开。",
        "time": 5,
        "heat": "中火",
        "tip": "汤汁要比平常宽一些，面会吸汤。",
        "cue": "汤色酱红，香味扑鼻。"
      },
      {
        "t": "挂面抖散下锅，中火煮到八分软，放花蛤与豆芽继续煮两分钟。",
        "time": 8,
        "heat": "中火",
        "tip": "面别煮太早，边煮边吸汤才入味。",
        "cue": "挂面变成半透明，花蛤陆续开口。"
      },
      {
        "t": "红薯淀粉加水调稀勾薄芡，撒芹菜段与盐，汤汁浓稠挂面即可出锅。",
        "time": 5,
        "heat": "小火",
        "tip": "芡要薄薄一层就好，厚了整锅像糨糊。",
        "cue": "汤汁裹住面条，碗里不见清水。"
      }
    ],
    "tips": [
      "卤面的灵魂是汤汁宽、芡要薄，面条吸饱汤后一碗就很顶。",
      "花蛤提前吐沙是硬要求，沙没净整锅都毁了。",
      "莆田人做卤面会加一勺猪油，香气立起来。"
    ],
    "mistakes": [
      "面下太早煮烂，端上桌就断成一截截。",
      "蛤没吐沙直接下锅，吃着满口细沙。"
    ],
    "subs": [
      {
        "orig": "花蛤",
        "sub": "海蛎",
        "ratio": "200g 对 180g",
        "note": "换海蛎要最后下，久煮会缩成小粒。"
      }
    ],
    "variations": [
      "莆田江口的卤面会在汤里加一小勺沙茶与几段炸豆腐，味道更浓，也更有渔村的咸香。"
    ],
    "serving": "盛碗趁热吃，撒一点白胡椒粉，配一小碟酸萝卜解腻。",
    "storage": "现煮现吃，剩面冷藏一天，复热须加高汤稀释，不要干烧。",
    "nutrition": {
      "basis": "每碗约 450g",
      "kcal": 560,
      "protein": 22,
      "fat": 20,
      "carbs": 70,
      "sodium": 980
    },
    "diet": [],
    "tags": [
      "闽菜",
      "莆田",
      "卤面",
      "面食"
    ],
    "safety": [
      "花蛤须吐净泥沙并彻底加热至开壳，未开壳的不要食用。",
      "干香菇须泡发后彻底加热至熟透，不要生食。",
      "贝类过敏者不宜食用，痛风人群控制份量。"
    ],
    "origin": "莆田卤面是当地婚宴与年节的头道主食，汤宽芡薄，靠五花肉、香菇与花蛤吊出海鲜与猪油的双重鲜味，面吸饱汤汁后一碗下去极顶饱。",
    "equipment": [
      "锅",
      "锅铲",
      "刀",
      "砧板",
      "碗",
      "汤勺"
    ]
  },
