    "steps": [
      {
        "t": "猪骨冷水下锅焯去血沫，捞出用温水冲净表面的浮渣。",
        "time": 10,
        "heat": "大火",
        "tip": "冷水下锅血水才逼得出来，汤才清。",
        "cue": "水面浮起灰沫，骨头干净无血丝。"
      },
      {
        "t": "猪骨与姜片放进汤锅，加足量清水大火烧开，转小火熬一小时。",
        "time": 60,
        "heat": "小火",
        "tip": "中途只补开水，汤色才稳不发浑。",
        "cue": "汤面微滚，汤色清亮带淡黄。"
      },
      {
        "t": "花蛤用淡盐水泡到吐净泥沙，米粉用冷水泡软后抖散备用。",
        "time": 5,
        "heat": "无火",
        "tip": "米粉泡到能弯折就够，泡久了煮即烂。",
        "cue": "蛤壳洁净，粉条柔软不断。"
      },
      {
        "t": "猪肝切薄片，用清水漂洗两遍去血水，捞出沥干。",
        "time": 5,
        "heat": "无火",
        "tip": "猪肝要现切现煮，久放会发黑发腥。",
        "cue": "肝片色泽红润，水不再浑浊。"
      },
      {
        "t": "花生油下锅爆香虾米，倒入滤净的汤煮开，下米粉煮两分钟，加盐与生抽调味。",
        "time": 6,
        "heat": "中火",
        "tip": "汤要滤净渣子，喝起来才够顺口不牙碜。",
        "cue": "米粉浮起，汤面清透飘着虾米香。"
      },
      {
        "t": "下花蛤煮到开口，放猪肝片滚十几秒至变色，撒芹菜末、葱末与白胡椒粉，起锅滴香醋。",
        "time": 4,
        "heat": "大火",
        "tip": "猪肝一变色就关火，煮久了发柴又发腥。",
        "cue": "蛤全开口，肝片边缘卷起刚断生。"
      }
    ],
    "tips": [
      "捞化的汤要清，靠猪骨慢熬，不加酱色。",
      "猪肝是捞化的标配，也有人换腰花、海蛎或大肠，按新鲜度挑。",
      "米粉单独泡、单独煮，汤才不会发糊。"
    ],
    "mistakes": [
      "猪肝切太厚又久煮，端上来像橡皮。",
      "汤里下了太多料还大火猛滚，汤变浑发腥。"
