     },
     {
      "n": "黑胡椒",
      "a": 2,
      "u": "g",
      "note": "现磨"
     }
    ]
   }
  ],
  "equipment": [
   "料理机",
   "筛网",
   "玻璃瓶",
   "小碗"
  ],
  "steps": [
   {
    "t": "番茄划十字用开水烫后撕皮切块，黄瓜与青椒去籽切块，洋葱切小块。",
    "time": 12,
    "heat": "无火",
    "tip": "番茄去皮，汤体才细滑。",
    "cue": "蔬菜切块大小基本一致"
   },
   {
    "t": "面包撕成小块，泡进清水里浸软，用手攥干多余水分。",
    "time": 5,
    "heat": "无火",
    "tip": "面包让汤体更稠更有厚度。",
    "cue": "面包吸饱水、一捏就软"
   },
   {
    "t": "蔬菜块、大蒜与泡软的面包一起放进料理机，打成细腻的糊。",
    "time": 6,
    "heat": "无火",
    "tip": "多打两分钟，质地才够顺。",
    "cue": "糊体细腻、看不见颗粒"
   },
   {
    "t": "机器不停转的同时分次淋入橄榄油，再加香醋、盐与黑胡椒调味。",
    "time": 4,
    "heat": "无火",
    "tip": "油分次淋才能乳化出丝滑感。",
    "cue": "汤色橙红、质地顺滑"
   },
   {
    "t": "过筛后装瓶冷藏两小时，盛碗时撒少许黄瓜与青椒细丁。",
    "time": 120,
    "heat": "无火",
    "tip": "冰透再喝，风味才清爽。",
    "cue": "汤体冰凉、表面无分层"
   }
  ],
  "tips": [
   "番茄要选熟透的沙瓤品种，酸度与甜度才平衡。",
   "橄榄油一定分次淋入，乳化到位才顺滑挂勺。",
   "冷藏两小时以上再喝，冰透才有西班牙的灵魂。"
  ],
  "mistakes": [
   "用不熟的反季番茄，做出来又酸又涩。",
   "油一次性倒进去，打出来分层析出。",
   "冷藏时间不够就端上桌，口感温热发闷。"
  ],
  "subs": [
   {
    "orig": "香醋",
    "sub": "红酒醋",
    "ratio": "15ml 对 15ml",
    "note": "酸度接近，果香更淡。"
   },
   {
    "orig": "青椒",
    "sub": "红椒",
    "ratio": "60g 对 60g",
    "note": "甜味更足，颜色偏红。"
   }
  ],
  "variations": [
   "白冷汤版：用 100g 去皮杏仁替换面包，做成 ajo blanco 风格。",
   "加西瓜版：替换 200g 番茄为西瓜，甜香更突出。"
  ],
  "serving": "盛入冰镇过的玻璃碗，配烤面包丁与一小碟橄榄油。",
  "storage": "密封冷藏可存 2 天，饮用前摇匀，不要冷冻。",
  "nutrition": {
   "basis": "每份（约 280g）",
   "kcal": 180,
   "protein": 3,
   "fat": 14,
   "carbs": 12,
   "sodium": 540
  },
  "safety": [
   "冷汤不经高温，蔬菜须用流动水彻底洗净。",
   "冷藏温度须保持在 4℃ 以下，超过 2 天不建议食用。",
   "大蒜用量偏高，肠胃敏感者建议减半。"
  ],
  "origin": "番茄冷汤出自西班牙南部的安达卢西亚，农人在田里就用陶罐把番茄、面包与橄榄油捣成凉汤，冰镇后一口下去，暑气全消。",
  "tags": [
   "西班牙菜",
   "汤品",
   "冷汤",
   "番茄"
  ],
  "related": [
   "meatloaf",
