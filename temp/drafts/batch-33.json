     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "橄榄油",
      "a": 80,
      "u": "ml",
      "note": "浸没蒜片"
     },
     {
      "n": "盐",
      "a": 3,
      "u": "g",
      "note": "调味"
     }
    ]
   }
  ],
  "equipment": [
   "平底锅",
   "厨房纸",
   "木铲",
   "小碗"
  ],
  "steps": [
   {
    "t": "虾去壳留尾，用牙签从背部挑出虾线，再用厨房纸把水分吸干。",
    "time": 8,
    "heat": "无火",
    "tip": "虾身越干，下锅越容易上色。",
    "cue": "虾身干爽、虾线去净"
   },
   {
    "t": "大蒜切成厚片，干辣椒剪成两段抖掉籽，欧芹切成细碎。",
    "time": 5,
    "heat": "无火",
    "tip": "蒜切厚片才不容易焦。",
    "cue": "蒜片厚薄均匀、辣椒段整齐"
   },
   {
    "t": "平底锅倒橄榄油，小火下蒜片与干辣椒慢慢煸到蒜片边缘金黄。",
    "time": 6,
    "heat": "小火",
    "tip": "全程小火，蒜一焦整锅发苦。",
    "cue": "蒜片金黄、油香四溢"
   },
   {
    "t": "转中大火下虾，两面各煎一分钟至卷曲变红，沿锅边淋白葡萄酒。",
    "time": 4,
    "heat": "中大火",
    "tip": "虾变色就够，久煎会老。",
    "cue": "虾身卷曲、颜色橙红"
   },
   {
    "t": "撒盐与欧芹碎，关火用余温拌两下，连油一起盛盘。",
    "time": 3,
    "heat": "小火",
    "tip": "油是精华，一定要连油一起倒出。",
    "cue": "欧芹翠绿、油汁清亮"
   }
  ],
  "tips": [
   "蒜片务必用小火慢煸，火大十秒就焦苦。",
   "虾下锅前一定吸干水分，才煎得出香气。",
   "盛盘时把蒜油一起倒出，蘸着吃最香。"
  ],
  "mistakes": [
   "大蒜切末直接大火爆香，蒜末瞬间焦黑带苦味。",
   "虾在锅里煎到卷成小球，肉质已经发柴。",
   "不淋白葡萄酒，腥气压不住、香气的层次也少了。"
  ],
  "subs": [
   {
    "orig": "白葡萄酒",
    "sub": "干雪利酒",
    "ratio": "30ml 对 30ml",
    "note": "西班牙本地做法，风味更浓。"
   },
   {
    "orig": "欧芹",
    "sub": "小葱",
    "ratio": "10g 对 10g",
    "note": "香气更冲，颜色更绿。"
   }
  ],
  "variations": [
   "加蘑菇版：先煎 100g 白蘑菇片，再按原法做虾。",
   "微辣版：干辣椒加到 6g，剪段后连籽一起煸。"
  ],
  "serving": "用陶盘盛装，配切片法棍或硬面包蘸蒜油。",
  "storage": "现做现吃最佳，冷藏后蒜油会凝固，复热需小火。",
  "nutrition": {
   "basis": "每份（约 200g）",
   "kcal": 420,
   "protein": 28,
   "fat": 33,
   "carbs": 4,
   "sodium": 640
  },
  "safety": [
   "虾属甲壳类过敏原，过敏人群禁食。",
   "虾须煎至完全变色卷曲，避免半生。",
   "蒜油温度高，盛盘时小心溅油烫手。"
  ],
  "origin": "蒜油虾是西班牙酒吧里最常见的下酒小菜，陶盘里滚着橄榄油与蒜片，虾一变色就端上桌，配面包把蒜油蘸干净才算吃完。",
  "tags": [
   "西班牙菜",
   "海鲜",
   "蒜香",
   "下酒菜"
  ],
  "related": [
   "meatloaf",
   "caesar-salad",
   "pomodoro-pasta"
  ]
 },
