  "steps": [
   {
    "n": 1,
    "t": "鸡蛋打进碗里加一小撮盐，用筷子彻底打散到均匀起泡。",
    "time": 5,
    "heat": "无火",
    "tip": "蛋液打到看不见明显蛋黄丝，炒出来才嫩。",
    "cue": "蛋液均匀，表面起细泡"
   },
   {
    "n": 2,
    "t": "番茄切成小丁，洋葱切成碎末，小米辣切圈，姜切末。",
    "time": 7,
    "heat": "无火",
    "tip": "洋葱切得越碎越容易炒化，甜味出得更快。",
    "cue": "配料细碎，番茄出水"
   },
   {
    "n": 3,
    "t": "炒锅倒植物油烧到微热，下洋葱末中火炒到边缘透明。",
    "time": 4,
    "heat": "中火",
    "tip": "洋葱炒到透明再加别的料，生洋葱味会抢味。",
    "cue": "洋葱透明，油面泛香"
   },
   {
    "n": 4,
    "t": "加姜末、小米辣圈和姜黄粉，翻炒半分钟炒出香气。",
    "time": 3,
    "heat": "中火",
    "tip": "姜黄粉遇油易焦，火别大，炒半分钟就够。",
    "cue": "油色橙黄，香气辛辣"
   },
   {
    "n": 5,
    "t": "下番茄丁炒到软烂出汁，加剩余的盐翻匀调底味。",
    "time": 5,
    "heat": "中火",
    "tip": "番茄炒到成糊状，蛋液下锅才不容易出水。",
    "cue": "番茄软塌成糊，汤汁收浓"
   },
   {
    "n": 6,
    "t": "倒入蛋液转小火，用锅铲不断推炒到蛋液刚凝固成块。",
    "time": 5,
    "heat": "小火",
    "tip": "小火慢推，蛋块才嫩滑不焦；炒到全干就老了。",
    "cue": "蛋块嫩黄松散，不成大团"
   },
   {
    "n": 7,
    "t": "关火撒入香菜碎，用余温翻拌两下即可装盘上桌。",
    "time": 2,
    "heat": "无火",
    "tip": "香菜关火后再放，清香才不被热气冲散掉。",
    "cue": "香菜翠绿，蛋块油润"
   }
  ],
  "tips": [
   "蛋液打到起泡，炒出来才够蓬松柔软。",
   "番茄先炒成糊状，蛋液下锅就不会出水。",
   "全程小火慢慢推炒，蛋块才嫩滑不老。",
   "香菜关火以后再撒，清香保留得更好。"
  ],
  "mistakes": [
