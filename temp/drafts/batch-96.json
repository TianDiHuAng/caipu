  "serving": "配茉莉香米饭，另配一份凉拌黄瓜解辣。",
  "storage": "冷藏两天，咖喱隔夜更浓；复热小火加热，勿大火滚沸以免椰浆分层。",
  "nutrition": {
   "basis": "每份约 320 克",
   "kcal": 480,
   "protein": 28,
   "fat": 34,
   "carbs": 14,
   "sodium": 960
