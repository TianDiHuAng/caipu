  "variations": [
   "加入腌柠檬与绿橄榄，可做更接近摩洛哥南部的风味。"
  ],
  "serving": "连锅上桌，配蒸粗麦粉与扁面面包。",
  "storage": "冷藏三天、冷冻两个月；复热加少量水小火加热，避免猛火糊底。",
  "nutrition": {
   "basis": "每份约 380 克",
   "kcal": 620,
   "protein": 38,
   "fat": 36,
   "carbs": 32,
   "sodium": 880
  },
  "safety": [
   "羊肉须炖至完全熟透、中心无血水；鹰嘴豆须彻底煮熟，罐装豆使用前冲洗；剩菜两小时内冷藏，复热须滚沸。"
  ],
  "origin": "塔吉锅是摩洛哥的慢炖代表作，得名于那种锥形陶锅。羊肉与洋葱、番茄、香料在密闭锅里慢慢出汁，咸甜交错带果干香，配面包蘸汤是当地最常见的吃法。",
