  "steps": [
   {
    "t": "羊肉块用盐、黑胡椒与姜黄抓匀，静置十五分钟入底味。",
    "time": 15,
    "heat": "无火",
    "tip": "羊肉擦干再腌，表面干爽才煎得出焦香。",
    "cue": "肉块表面均匀泛黄"
   },
   {
    "t": "厚底锅下橄榄油中火，把羊肉块分批煎到各面焦黄后盛出。",
    "time": 12,
    "heat": "中火",
    "tip": "分批煎、不要挤满锅，否则肉出水变煮。",
    "cue": "肉块表面深褐，锅底留焦痕"
   },
   {
    "t": "原锅下洋葱丝小火炒十分钟至软塌微甜，加蒜末、孜然、芫荽籽、辣椒粉与肉桂炒香。",
    "time": 12,
    "heat": "小火",
    "tip": "香料要在油里炒三十秒出香，别炒焦。",
    "cue": "洋葱琥珀色，香料油香浓郁"
   },
   {
    "t": "下番茄丁炒五分钟至出汁，把羊肉倒回锅中翻匀。",
    "time": 7,
    "heat": "中火",
    "tip": "番茄炒出红色浓汁后再放肉，汤色才漂亮。",
    "cue": "锅底番茄化开成酱状"
   },
   {
    "t": "加四百毫升热水没过羊肉，煮开后转最小火加盖炖五十五分钟。",
    "time": 58,
    "heat": "小火",
    "tip": "塔吉锅盖要盖严或用湿布封边，蒸汽循环才香。",
    "cue": "锅内微沸，香味从盖缝冒出"
   },
   {
    "t": "加胡萝卜块、鹰嘴豆与杏干再炖二十分钟至羊肉能用勺背压散。",
    "time": 22,
    "heat": "小火",
    "tip": "杏干后放才不会煮成糊。",
    "cue": "胡萝卜软透，汤汁浓稠挂勺"
   },
   {
    "t": "关火挤柠檬汁，撒香菜碎，连锅上桌配面包。",
    "time": 3,
    "heat": "无火",
    "tip": "柠檬汁最后加，酸味清亮不闷。",
    "cue": "表面翠绿点缀，汤汁油亮"
   }
  ],
  "tips": [
   "用塔吉锅的锥形盖能让蒸汽回流，肉更嫩。",
   "配蒸粗麦粉或扁面面包蘸汁吃。",
   "剩菜第二天更入味，可加水煮成汤面。"
  ],
  "mistakes": [
