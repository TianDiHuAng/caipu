    "steps": [
      {
        "t": "鳙鱼头从下颌剖开成相连两半，去净鳃和黑膜，冲去血水后用厨房纸吸干水分。",
        "time": 10,
        "heat": "无火",
        "tip": "鳃和腹内黑膜是腥味来源，一定刮干净，汤才清甜不腥。",
        "cue": "鱼头剖开摊平，鳃部血污全部清除。"
      },
      {
        "t": "炒锅放植物油烧到六成热，鱼头皮朝下入锅中火煎到两面金黄定型。",
        "time": 10,
        "heat": "中火",
        "tip": "鱼头下锅后先别动，等一面结皮再翻，鱼皮才不粘锅破相。",
        "cue": "鱼皮金黄微酥，锅边有焦香。"
      },
      {
        "t": "沿锅边烹入料酒，加姜片和大葱段，随即冲入烧开的清水没过鱼头。",
        "time": 4,
        "heat": "大火",
        "tip": "必须冲开水，冷水一激汤色发灰，白汤就吊不出来。",
        "cue": "汤面瞬间翻滚，浮起乳白泡沫。"
      },
      {
        "t": "大火滚煮十分钟至汤色转成乳白，把鱼头连同汤汁一起倒进砂锅。",
        "time": 12,
        "heat": "大火",
        "tip": "大火滚足才出白汤，滚的过程中别盖严盖，让腥气散掉。",
        "cue": "汤色由清转奶白，香气浓。"
      },
      {
        "t": "砂锅加盖转小火煨二十分钟，放入北豆腐块再煨八分钟，让豆腐吸足鱼汤。",
        "time": 28,
        "heat": "小火",
        "tip": "豆腐后放，久煮会蜂窝发老，吸味八分钟刚好嫩。",
        "cue": "豆腐浮在汤面，边缘微微鼓起。"
      },
      {
        "t": "加盐和白胡椒调味，撒香菜段和剩余大葱段，连砂锅端上桌趁热吃。",
        "time": 5,
        "heat": "无火",
        "tip": "盐一定最后放，早放鱼肉发紧、汤也不够鲜。",
        "cue": "汤色乳白浓厚，表面浮一层油亮薄膜。"
      }
    ],
    "tips": [
      "鱼头选三斤以上的鳙鱼，肉厚胶质多，汤才够浓。",
      "想汤更白可全程大火滚，想汤更清则小火慢煨。",
      "剩下的鱼汤别倒掉，下一把细面煮两分钟，鲜味比鸡高汤还足。"
    ],
    "mistakes": [
      "鱼头没吸干就下锅，油花四溅、鱼皮粘锅破碎。",
      "中途加冷水，汤色一下变灰，白汤再也吊不起来。",
      "放盐太早，鱼肉紧缩发柴，汤的鲜味也被压住。"
    ],
    "subs": [
      {
        "orig": "鳙鱼",
        "sub": "鲢鱼头",
        "ratio": "1:1",
        "note": "鲢鱼头胶质略少，需多加一百毫升清水延长煨制。"
      },
      {
        "orig": "北豆腐",
        "sub": "嫩豆腐",
        "ratio": "1:1",
        "note": "嫩豆腐更滑，下锅后只煨三分钟，久了易碎。"
      }
    ],
    "variations": [
      "天目湖当地做法会加一小把笋片同煨，汤里带笋香，鲜味更有层次。",
      "有的店家在砂锅底垫一层咸肉片，汤更咸鲜，盐可减半。"
    ],
    "serving": "连砂锅上桌，先喝一碗原汤再吃鱼脑与豆腐，配米饭或面食都合适。",
    "storage": "冷藏可存两日，冷冻两周；复热用砂锅小火慢温，别大火滚散鱼头。",
