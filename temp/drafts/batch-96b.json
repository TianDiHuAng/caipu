  "steps": [
   {
    "t": "红薯粉丝用温水泡二十分钟至变软，剪成二十厘米长段备用。",
    "time": 20,
    "heat": "无火",
    "tip": "泡软即可，不要泡到发白发涨。",
    "cue": "粉丝柔软有弹性，能弯成圈"
   },
   {
    "t": "牛肉丝用生抽、白糖、黑胡椒与蒜末抓匀腌十分钟。",
    "time": 10,
    "heat": "无火",
    "tip": "牛肉逆纹切丝，腌后才嫩。",
    "cue": "肉丝裹上酱色，表面微黏"
   },
   {
    "t": "菠菜入沸水焯三十秒捞出过凉水，挤干水分切段，用盐与芝麻油拌一下。",
    "time": 6,
    "heat": "大火",
    "tip": "焯完立刻过凉水，颜色才翠绿。",
    "cue": "菠菜深绿不塌，水分挤干"
   },
   {
    "t": "鸡蛋打散摊成薄蛋皮，晾凉后切成细丝，胡萝卜、洋葱、香菇与黑木耳分别切丝。",
    "time": 8,
    "heat": "小火",
    "tip": "蛋皮要摊薄，切出的丝才漂亮。",
    "cue": "蛋皮金黄平整，丝条均匀"
   },
   {
    "t": "炒锅下植物油，先把牛肉丝大火炒到变色盛出，再依次炒胡萝卜、洋葱、香菇与黑木耳丝。",
    "time": 10,
    "heat": "大火",
    "tip": "每样分开炒，蔬菜出水少、颜色分明。",
    "cue": "蔬菜断生仍带脆感，锅底干爽"
   },
   {
    "t": "粉丝入沸水烫两分钟捞出沥干，趁热加生抽、白糖与一半芝麻油拌匀上色。",
    "time": 4,
    "heat": "大火",
    "tip": "粉丝趁热拌酱才吸味，凉了就只是挂着酱。",
    "cue": "粉丝呈浅褐色，根根分开"
   },
   {
    "t": "把所有配料倒进粉丝里，加剩余芝麻油与盐抓拌均匀，撒白芝麻。",
    "time": 4,
    "heat": "无火",
    "tip": "用手抓拌比筷子更均匀，粉丝不易断。",
    "cue": "粉丝与配菜颜色交错，油亮不粘"
   }
  ],
  "tips": [
   "配一碗白饭或单吃都合适，冷藏后当小菜更入味。",
   "粉丝拌好后放凉再吃，甜咸味会更平衡。",
   "想更丰富可加青椒丝、鱼饼丝与少量辣酱同拌。"
  ],
  "mistakes": [
   "粉丝泡过头，一炒就断成一截一截。",
   "所有蔬菜一起下锅炒，出水多、颜色发暗。",
   "酱料一次全倒，粉丝吸不均、局部过咸。"
  ],
