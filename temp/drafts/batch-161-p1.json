  "steps": [
   {
    "n": 1,
    "t": "腌雪里蕻用清水反复冲洗几遍，挤干水分后切成半厘米的小段。",
    "time": 6,
    "heat": "无火",
    "tip": "腌菜咸度很高，多洗两遍并尝一下。",
    "cue": "菜梗切得细碎，手握不出水"
   },
   {
    "n": 2,
    "t": "香干切成筷子粗的细条，猪里脊逆纹切丝备用。",
    "time": 4,
    "heat": "无火",
    "tip": "香干条别切太细，炒久了会断。",
    "cue": "香干条长短一致，肉丝分明"
   },
   {
    "n": 3,
    "t": "炒锅倒植物油烧热，下肉丝中火滑炒到变色散开，盛出。",
    "time": 3,
    "heat": "中火",
    "tip": "肉丝下锅先别翻，等定型再拨散。",
    "cue": "肉丝由红转白，根根分离"
   },
   {
    "n": 4,
    "t": "锅内留底油下姜末、蒜片和干辣椒段，小火炒出香味。",
    "time": 2,
    "heat": "小火",
    "tip": "干辣椒容易糊，小火炸到颜色变深就够。",
    "cue": "油面泛红，闻到蒜香和辣香"
   },
   {
    "n": 5,
    "t": "倒入雪菜碎中火煸炒，把腌菜的水汽炒干、香气炒出来。",
    "time": 4,
    "heat": "中火",
    "tip": "雪菜一定要炒干水汽，不然带一股生涩味。",
    "cue": "雪菜颜色转深，锅底无积水"
   },
   {
    "n": 6,
    "t": "下香干条和肉丝翻炒，加生抽和白糖，淋清水翻匀略煸。",
    "time": 3,
    "heat": "中火",
    "tip": "白糖只为中和咸酸，一点点就够。",
    "cue": "香干条裹上酱色，汤汁被吸干"
   }
  ],
  "tips": [
   "雪菜先冲洗再挤干，咸度可控不齁人。",
   "香干条切粗一点，炒完才有嚼劲。",
   "最后放少许白糖，能中和腌菜的酸咸。"
  ],
  "mistakes": [
   "雪菜不洗直接下锅，整盘咸得下不了口。",
   "火太小吃不住水汽，成品湿塌塌的。",
   "香干炒太久，条状断成碎渣。"
  ],
  "subs": [
   {
    "orig": "雪菜",
    "sub": "梅干菜",
    "ratio": "250 克:150 克",
    "note": "需提前泡软切碎，咸味更重，糖可略增。"
   },
   {
    "orig": "香干",
    "sub": "豆干",
    "ratio": "200 克:200 克",
    "note": "质地更硬，煸炒时间延长一分钟。"
   }
  ],
  "variations": [
   "加一把毛豆同炒，口感更丰富。",
   "换成腊肉丝代替里脊，徽州风味更足。"
  ],
  "serving": "热食配白粥或干饭都合适，作下饭小菜也很扎口。",
  "storage": "冷藏两天，复热时加少许清水小火翻炒回软。",
  "nutrition": {
   "basis": "每份约 180 克",
   "kcal": 240,
   "protein": 18,
   "fat": 15,
   "carbs": 8,
   "sodium": 860
  },
  "allergens": [
   "soy"
  ],
  "safety": [
   "腌雪里蕻属腌制品，食用前充分冲洗；剩菜冷藏不超过两天，复热要炒透。"
  ],
  "origin": "皖南人家一年四季的常备小炒，自家腌的雪里蕻配上香干和一点肉丝，咸鲜带酸，最下饭。腌菜炒干水汽是这道菜的关键，也是徽州灶台上的老规矩。",
  "tags": [
   "安徽",
   "雪菜",
