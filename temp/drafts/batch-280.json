    "steps": [
      {
        "t": "牛腩切成四厘米见方的块，用冷水浸泡二十分钟逼出血水。",
        "time": 12,
        "heat": "无火",
        "tip": "泡出血水，汤才清不腥。",
        "cue": "水色转淡红，牛腩发白。"
      },
      {
        "t": "牛腩冷水下锅，大火煮开后撇净浮沫，捞出用温水冲洗。",
        "time": 12,
        "heat": "大火",
        "tip": "浮沫撇干净，汤底才透亮。",
        "cue": "水面浮起褐色泡沫。"
      },
      {
        "t": "锅里重新加清水，放牛腩、洋葱块、大蒜与香叶，大火煮开转小火。",
        "time": 10,
        "heat": "小火",
        "tip": "小火慢炖，牛腩才软而不散。",
        "cue": "汤面只有细小气泡，微微冒气。"
      },
      {
        "t": "盖锅炖六十分钟，中途撇两次浮油，保持汤面清亮。",
        "time": 60,
        "heat": "小火",
        "tip": "炖的时间按肉的老嫩调整，筷子能扎透就行。",
        "cue": "牛腩块边缘发软。"
      },
      {
        "t": "放胡萝卜、土豆与玉米段，继续炖二十分钟至蔬菜熟透。",
        "time": 22,
        "heat": "小火",
        "tip": "蔬菜后放，久炖会化在汤里。",
        "cue": "土豆边缘微融，胡萝卜变软。"
      },
      {
        "t": "加盐与黑胡椒调味，撒入芹菜段再煮三分钟。",
        "time": 8,
        "heat": "中火",
        "tip": "芹菜最后下，保住清香与脆感。",
        "cue": "芹菜翠绿，汤色清亮。"
      },
      {
        "t": "盛碗时放一大块牛腩与蔬菜，撒香菜，配青柠角挤汁。",
        "time": 5,
        "heat": "无火",
        "tip": "青柠汁上桌前挤，酸香最提味。",
        "cue": "汤面漂着油花，青柠翠绿。"
      }
    ],
    "tips": [
      "牛腩选带筋膜的，炖出来汤浓肉香。",
      "全程小火，汤才清；大火滚会把汤煮浑。",
      "墨西哥人喝这汤会配玉米饼，掰碎泡着吃。"
    ],
    "mistakes": [
      "牛腩不焯水直接炖，汤浑且带腥。",
      "一开始就放盐，牛腩炖两小时还是硬的。"
    ],
    "subs": [
      {
        "orig": "牛腩",
        "sub": "牛腱",
        "ratio": "900g 对 900g",
        "note": "牛腱筋多，炖的时间延长二十分钟。"
      }
    ],
    "variations": [
      "北部地区会加一段甘蔗同炖，汤带清甜，喝起来更润。"
    ],
    "serving": "配上玉米饼、洋葱碎与青柠角，一人一碗连肉带汤。",
    "storage": "冷藏三天，撇去表面油脂后复热，风味更好。",
