  "equipment": [
   "蒸锅",
   "小刀",
   "刷子",
   "炒锅"
  ],
  "steps": [
   {
    "t": "扇贝用刷子把外壳两面刷干净，小刀沿壳缝撬开取出贝肉，去掉黑色内脏与腮，壳洗净留用。",
    "time": 10,
    "heat": "无火",
    "tip": "外壳要刷到没有泥沙，摆盘才干净。",
    "cue": "贝壳干净无泥、贝肉完整"
   },
   {
    "t": "粉丝用温水泡八分钟到变软，捞出剪成两段，盘进贝壳底部垫一层。",
    "time": 10,
    "heat": "无火",
    "tip": "粉丝别泡太久，蒸完会烂。",
    "cue": "粉丝柔软能绕指、不碎"
   },
   {
    "t": "大蒜剁成蓉，一半用植物油小火炸到微黄，与另一半生蒜蓉、生抽、蚝油、白糖、盐和清水拌成蒜蓉酱。",
    "time": 8,
    "heat": "小火",
    "tip": "生熟蒜各半，香气才有层次。",
    "cue": "蒜蓉酱稠稀适中、蒜香浓"
   },
   {
    "t": "贝肉放回贝壳，淋上料酒，再舀一勺蒜蓉酱盖在贝肉上，酱要铺满不外溢。",
    "time": 5,
    "heat": "无火",
    "tip": "贝肉先回壳再淋酱，蒸后才不缩。",
    "cue": "每只扇贝酱量均匀"
   },
   {
    "t": "蒸锅水大开后把扇贝摆入，盖盖大火蒸五分钟，取出撒葱花与小米辣圈。",
    "time": 5,
    "heat": "大火",
    "tip": "水开再上锅，五分钟足矣，久了发硬。",
    "cue": "贝肉转白卷边、汤汁清"
   },
   {
    "t": "另起小锅把剩余的植物油烧到冒烟，逐只浇在葱花上激出香味即可上桌。",
    "time": 2,
    "heat": "无火",
    "tip": "热油要浇在葱花上，香味才冲。",
    "cue": "葱花滋滋作响、油香扑鼻"
   }
  ],
  "tips": [
   "扇贝买回来先用淡盐水养半小时，吐净泥沙再处理。",
   "粉丝垫底会吸汁，喜欢粉丝可加到八十克。",
   "没有蒸鱼豉油时用生抽加白糖替代，味道接近。"
  ],
  "mistakes": [
   "蒸的时间超过八分钟，贝肉缩成小块咬不动。",
   "蒜蓉全部炸熟，缺少生蒜的辛香层次。",
   "贝肉不摘内脏直接蒸，吃起来有沙腥味。"
  ],
  "subs": [
   {
    "orig": "扇贝",
    "sub": "带子",
    "ratio": "400g 对 400g",
    "note": "带子无壳，用粉丝垫小碟蒸。"
   },
   {
    "orig": "粉丝",
    "sub": "金针菇",
    "ratio": "60g 对 150g",
    "note": "金针菇出水多，蒸时少加清水。"
   }
  ],
  "variations": [
   "加一勺豆豉同蒸，做成豉汁蒜蓉双味版。",
   "把小米辣换成剁椒，颜色更红亮、辣味更直接。"
  ],
  "serving": "每人两只连壳上桌，底下的粉丝拌汤汁一起吃。",
  "storage": "现蒸现吃，冷藏后复蒸两分钟口感会变硬。",
  "nutrition": {
   "basis": "每份（约 200g）",
   "kcal": 240,
   "protein": 22,
   "fat": 11,
   "carbs": 14,
   "sodium": 820
  },
  "safety": [
   "贝类必须彻底加热至壳开肉白，不要生食。",
   "蒸前确认扇贝壳紧闭或轻敲会闭合，死的丢弃。",
   "处理生贝后清洗刀具与砧板，避免交叉污染。"
  ],
  "origin": "蒜蓉粉丝蒸扇贝是粤式酒楼里最讨巧的一道海鲜，扇贝的鲜甜配上蒜蓉的辛香，粉丝在壳底吸足汁水。湛江、阳江的渔港把刚上岸的扇贝用这法子蒸，火候只消几分钟，吃的就是海边的那口鲜。",
  "tags": [
   "粤菜",
   "海鲜",
   "蒸菜",
   "宴客"
  ],
  "related": [
   "yanshui-hexia",
   "culiu-baicai"
  ]
 },
 {
