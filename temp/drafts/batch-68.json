     }
    ]
   }
  ],
  "equipment": [
   "汤锅",
   "菜刀",
   "漏勺"
  ],
  "steps": [
   {
    "t": "猪排骨斩成小块，冷水下锅加料酒煮开，撇去浮沫后捞出用温水冲洗干净。",
    "time": 10,
    "heat": "大火",
    "tip": "冷水下锅血水才逼得出来。",
    "cue": "水面浮沫撇净、排骨发白"
   },
   {
    "t": "莲藕刮去外皮切成滚刀块，立刻泡进清水里防止氧化发黑。",
    "time": 8,
    "heat": "无火",
    "tip": "切好就泡水，颜色才白。",
    "cue": "藕块切面洁白、不返黑"
   },
   {
    "t": "汤锅倒入清水，下排骨、莲藕、姜片与熟花生，大火烧开后撇净浮沫。",
    "time": 8,
    "heat": "大火",
    "tip": "花生提前泡两小时更易炖烂。",
    "cue": "汤面清亮、无褐色浮沫"
   },
   {
    "t": "转小火盖盖炖九十分钟，中途尽量不揭盖也不加冷水。",
    "time": 90,
    "heat": "小火",
    "tip": "中途加水会让汤变浑、肉发柴。",
    "cue": "藕块用筷子能轻松插透"
   },
   {
    "t": "起锅前加盐调味，再小火煮三分钟让咸味融进汤里，关火即可。",
    "time": 3,
    "heat": "小火",
    "tip": "盐最后放，肉才不紧。",
    "cue": "汤色奶白微粉、藕香清甜"
   }
  ],
  "tips": [
   "挑藕看孔，孔大且带粉霜的是粉藕，炖汤才起沙。",
   "怕油腻可在炖好后撇去表面浮油。",
   "花生换成赤小豆同炖，汤更清甜解腻。"
  ],
  "mistakes": [
   "一开始就放盐，排骨炖两小时还是发硬。",
   "莲藕切好不泡水，下锅前已经变黑。",
   "全程大火滚煮，汤浑藕碎不成形。"
  ],
  "subs": [
   {
    "orig": "猪排骨",
    "sub": "猪脊骨",
    "ratio": "500g 对 600g",
    "note": "脊骨出汤更甜，炖的时间加半小时。"
   },
   {
    "orig": "熟花生",
    "sub": "赤小豆",
    "ratio": "50g 对 60g",
    "note": "赤小豆需提前泡两小时。"
   }
  ],
  "variations": [
   "加一段玉米同炖，汤带自然的甜味。",
   "放两片陈皮，去油腻、汤更清香。"
  ],
  "serving": "趁热盛碗，连汤带藕一起吃，作饭前汤最合适。",
  "storage": "冷藏三天，复热时小火加热不要滚沸太久。",
  "nutrition": {
   "basis": "每份（约 400g）",
   "kcal": 330,
   "protein": 24,
   "fat": 18,
   "carbs": 18,
   "sodium": 640
  },
  "safety": [
   "排骨必须彻底炖熟，骨边不见血红。",
   "处理生肉后洗净双手与砧板，防止交叉污染。",
   "汤冷却后两小时内冷藏，室温久放易变质。"
  ],
  "origin": "广东人一年四季离不开老火汤，莲藕花生排骨汤是秋冬最常见的一锅。粉藕炖到起沙，花生软糯，排骨的油香被藕的清甜压住，一锅汤煲足一个半钟头，喝的是一份耐心和家常味。",
  "tags": [
   "粤菜",
   "汤",
   "家常",
   "滋补"
  ],
  "related": [
   "cantonese-suanrong-fensi-zheng-shanbei",
   "wuxi-youmianjin-sairou"
  ]
