  ],
  "steps": [
   {
    "t": "带鱼剪去头尾与侧鳍，剖开腹部去掉内脏和黑膜，切成八厘米长的段，洗净后用厨房纸吸干水分。",
    "time": 10,
    "heat": "无火",
    "tip": "表面必须擦干，否则下锅溅油、脱皮。",
    "cue": "鱼段干爽、不滴水"
   },
   {
    "t": "鱼段加盐、料酒、胡椒、姜片与花椒抓匀，腌十五分钟入味去腥。",
    "time": 15,
    "heat": "无火",
    "tip": "腌够时间才不腥，中途翻一次面。",
    "cue": "鱼段略紧实、闻着有姜香"
   },
   {
    "t": "面粉倒在盘里，鱼段两面薄薄拍一层干粉，抖掉多余的粉。",
    "time": 4,
    "heat": "无火",
    "tip": "粉只拍薄薄一层，厚了像面壳。",
    "cue": "鱼段表面干爽、能见鱼皮纹路"
   },
   {
    "t": "平底锅倒植物油烧到五成热，鱼段依次码入锅中，先别翻动，中火煎到边缘金黄结皮。",
    "time": 3,
    "heat": "中火",
    "tip": "下锅后别急着动，结皮自然脱锅。",
    "cue": "鱼段边缘金黄、能推动"
   },
   {
    "t": "一面煎好后翻面继续煎，两面共煎八分钟到外壳酥硬。",
    "time": 8,
    "heat": "中火",
    "tip": "全程中火，火大外面糊里面生。",
    "cue": "两面金黄、筷子敲有脆响"
   },
   {
    "t": "出锅前把葱段放进锅里，连锅颠一颠让葱香沾上鱼身，装盘即成。",
    "time": 2,
    "heat": "中火",
    "tip": "葱最后放，只用余温激香。",
    "cue": "葱段翠绿、鱼身油亮"
   }
  ],
  "tips": [
   "带鱼表面的银膜别刮掉，那是鲜味最浓的部分。",
   "拍粉后用厨房纸轻压，煎出来更酥。",
   "煎好的鱼趁热吃，凉了腥味会回来。"
  ],
  "mistakes": [
   "鱼段没擦干就下锅，油爆四溅且鱼皮全破。",
   "油温不够下锅，鱼段泡在油里出不了脆壳。",
   "不停翻动鱼段，鱼身碎成几块。"
  ],
  "subs": [
   {
    "orig": "带鱼",
    "sub": "鲳鱼",
    "ratio": "500g 对 500g",
    "note": "鲳鱼更厚，煎制时间各加两分钟。"
   },
   {
    "orig": "面粉",
    "sub": "玉米淀粉",
    "ratio": "50g 对 50g",
    "note": "淀粉煎后更脆，但易回软。"
   }
  ],
  "variations": [
   "腌鱼时加一勺辣椒面，做成微麻辣的干煎版。",
   "煎好后加葱姜与醋同烧两分钟，改成红烧带鱼。"
  ],
  "serving": "配一小碟椒盐或香醋蘸食，搭粥饭都合口。",
  "storage": "冷藏两天，复热用平底锅小火回煎三分钟。",
  "nutrition": {
   "basis": "每份（约 150g）",
   "kcal": 360,
   "protein": 26,
   "fat": 24,
   "carbs": 10,
   "sodium": 720
  },
  "safety": [
   "带鱼必须煎至中心完全变白不透明，不要半生。",
   "处理生鱼后清洗刀具案板，避免与熟食混用。",
   "煎鱼时鱼身擦干再下锅，防止热油飞溅烫伤。"
  ],
  "origin": "胶东沿海人家过日子，最常做的鱼就是干煎带鱼。带鱼抹盐腌透、拍一层薄粉下锅煎，外壳焦脆、肉雪白细嫩，配一碗小米粥就是一顿舒坦的早饭。渔汛时节，青岛码头上整筐整筐的带鱼闪着银光，家家户户的锅里都能闻到这股焦香。",
