        "t": "倒入清水烧开，加盐调味，转小火煮五分钟让香料味融进汤汁。",
        "time": 5,
        "heat": "小火",
        "tip": "先用清水把底味煮开，再放豆腐才不吸生味。",
        "cue": "汤汁转浓，表面浮一层橙红油"
      },
      {
        "t": "把煎好的豆腐块放进咖喱汁里，加淡奶油翻匀，小火煨六分钟让豆腐吸足味道。",
        "time": 6,
        "heat": "小火",
        "tip": "淡奶油下锅后火要小，滚太猛容易分层起花。",
        "cue": "咖喱汁转成柔和的奶油橙色"
      },
      {
        "t": "关火撒香菜碎，盛进深盘，让咖喱汁把豆腐半浸着上桌。",
        "time": 2,
        "heat": "无火",
        "tip": "香菜最后撒，香气与颜色都保留得最好。",
        "cue": "深盘里橙红咖喱半浸着金黄豆腐"
      }
