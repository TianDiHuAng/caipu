    "steps": [
      {
        "t": "椰蓉倒进厚底锅，加入牛奶用刮刀拌匀，静置十分钟让椰丝把奶吸透变软。",
        "time": 10,
        "heat": "无火",
        "tip": "吸透奶的椰丝下锅不易糊，成团也更紧实。",
        "cue": "椰丝由干松变得湿润结团"
      },
      {
        "t": "厚底锅放上中小火，倒入白糖不停翻拌，糖化开后椰蓉会渐渐变得黏稠挂勺。",
        "time": 20,
        "heat": "中小火",
        "tip": "全程刮底翻拌，糖沉底最容易糊出焦味。",
        "cue": "混合物冒细密气泡，颜色转浅黄"
      },
      {
        "t": "加入酥油与小豆蔻粉继续翻炒，直到整团料能离开锅底、刮刀划开留下清晰痕迹。",
        "time": 8,
        "heat": "中小火",
        "tip": "能整团翻起不断裂就到位了，炒过头会发干。",
        "cue": "料团离锅成团，刮刀痕迹不回缩"
      },
      {
        "t": "方形模具内壁抹一层酥油，把炒好的椰蓉料倒进去，用刮刀压平压实表面。",
        "time": 5,
        "heat": "无火",
        "tip": "压得越实切块越整齐，别留气泡与空隙。",
        "cue": "表面平整，边角填满无缝隙"
      },
      {
        "t": "趁表面还温热撒上开心果碎并轻压固定，静置冷却到完全定型后再切块。",
        "time": 65,
        "heat": "无火",
        "tip": "一定要完全凉透再下刀切块，切面才平整，边缘也不会掉渣。",
        "cue": "糕体变硬定型，开心果碎嵌在表面"
      }
    ],
    "tips": [
      "椰蓉选细丝无糖款，含糖椰蓉配上白糖容易过甜且更易糊锅。",
      "炒制时火候宁小勿大，糖在高温下很快焦化，一糊整锅都得倒掉。",
      "切块前把刀用温水烫一下擦干，切面干净不留毛边。",
      "想要更浓的奶香，可以把一半牛奶换成甜奶浆，白糖相应减少二十克。"
    ],
    "mistakes": [
      "牛奶与椰蓉冷锅直接开大火，锅底先糊一层，整锅带上焦苦味。",
      "炒得不够干就装模，切块时软塌粘刀，拿起来就散。",
      "没等完全凉透就切，糕体拉扯变形，切面粗糙掉渣。"
    ],
