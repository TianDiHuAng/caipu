      },
      {
        "group": "aux",
        "items": [
          {
            "n": "牛奶",
            "a": 200,
            "u": "ml",
            "note": "全脂更香浓"
          },
          {
            "n": "开心果",
            "a": 20,
            "u": "g",
            "note": "去壳切碎装饰"
          },
          {
            "n": "小豆蔻",
            "a": 2,
            "u": "g",
            "note": "拍开取籽磨粉"
          }
        ]
      },
      {
        "group": "seasoning",
        "items": [
          {
            "n": "白糖",
            "a": 120,
            "u": "g",
            "note": "按甜度可增减"
          },
          {
            "n": "酥油",
            "a": 20,
            "u": "g",
            "note": "抹模具与增香"
          }
        ]
      }
