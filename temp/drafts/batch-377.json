      },
      {
        "t": "放入北豆腐块与青辣椒圈，加辣椒粉轻轻推匀，小火煮到豆腐吸饱汤汁。",
        "time": 8,
        "heat": "小火",
        "tip": "豆腐下锅后别用勺翻，晃锅就行，否则一搅就碎。",
        "cue": "豆腐表面挂上红亮汤色，微微鼓起"
      },
      {
        "t": "尝一口汤，用盐微调咸淡，撒蒜末与葱段，关火盖上盖子焖一分钟。",
        "time": 3,
        "heat": "无火",
        "tip": "蒜末最后放，靠余温激出辛香，久煮只剩闷味。",
        "cue": "汤面浮起红油，葱段翠绿挺立"
      }
    ],
