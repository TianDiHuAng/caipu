    "steps": [
      {
        "t": "牛腱先用冷水泡去血水，再整块放进汤锅，加清水大火烧开后撇净浮沫。",
        "time": 12,
        "heat": "大火",
        "tip": "血水泡干净，汤才清亮不腥，浮沫要撇到汤面干净。",
        "cue": "汤面浮沫撇净，水面清亮见底"
      },
      {
        "t": "转小火盖盖慢炖，让牛腱内部慢慢变软，用筷子能轻松扎透就捞出放凉。",
        "time": 45,
        "heat": "小火",
        "tip": "全程小火微滚，火大肉纤维收紧，切片会散。",
        "cue": "筷子扎入肉块无阻力，肉面略紧缩"
      },
      {
        "t": "煮肉的汤过滤后放凉，加生抽、白醋、白糖、盐与压碎的大蒜调匀，装盒冷藏彻底冰凉。",
        "time": 15,
        "heat": "无火",
        "tip": "汤要尝起来比平时偏酸偏甜，冰镇后味道会被稀释。",
        "cue": "汤色琥珀清透，尝来酸甜明显"
      },
      {
        "t": "牛腱顺纹切薄片，黄瓜丝与梨片用冰水浸着，鸡蛋煮熟后剥壳对半切开。",
        "time": 10,
        "heat": "无火",
        "tip": "牛腱必须完全放凉再切，热切会碎成渣。",
        "cue": "肉片薄而完整，纹理清晰不散"
      },
      {
        "t": "另起一锅水烧开，面条抖散下锅，用筷子轻轻拨动，煮到没有硬芯立即捞出。",
        "time": 5,
        "heat": "中大火",
        "tip": "煮好马上过冰水搓洗，面条才滑溜有嚼劲。",
        "cue": "面条由白转透，挑起有弹性"
      },
      {
        "t": "面条反复过两遍冰水搓去表面淀粉，沥干后团成两团放进大碗，浇入冰汤，撒上小葱圈、芝麻与辣椒粉，再摆配料。",
        "time": 4,
        "heat": "无火",
        "tip": "面条沥得越干越好，水多会把冰汤稀释。",
        "cue": "碗中汤面浮冰，配料整齐铺开"
      }
    ],
    "tips": [
      "冷汤提前一晚调好冷藏，第二天味道融合得更透，酸味也更柔和。",
      "梨片是这道面的关键，甜脆的果肉能压住酸味，别换成苹果。",
      "面条过冰水时用手轻搓，表面淀粉洗掉，汤才不会变浑。",
      "嫌牛肉费时可只用煮肉汤，配一撮芝麻与黄瓜丝也很清爽。"
    ],
    "mistakes": [
      "汤调好没有冰镇直接浇面，温汤会把面条泡软，口感发糊。",
      "牛腱热着切片，肉一碰就散，摆盘变成一堆碎肉。",
      "面条煮好后没过冰水就装碗，表面淀粉让汤变稠发白。"
    ],
    "subs": [
      {
        "orig": "牛腱",
        "sub": "鸡胸肉",
        "ratio": "250克:250克",
        "note": "煮制时间缩到十五分钟，撕成细丝再摆面。"
      },
      {
        "orig": "梨",
        "sub": "苹果",
        "ratio": "100克:100克",
        "note": "切更薄的片，甜味偏酸可多加五克糖。"
      }
    ],
    "variations": [
      "把冰汤换成辣酱拌料，就成韩式拌冷面，酸辣味更重，适合口味重的人。",
      "加两片泡菜与半勺泡菜汁，汤的酸度提升，风味更有层次。"
    ],
    "serving": "用大碗盛，汤要没过面条一半，配料按颜色分区摆放，上桌时配一把剪刀方便剪面。",
    "storage": "冷汤与面条分开冷藏，汤三天内用完，面条当天煮当天吃，隔夜会失弹。",
