    "steps": [
      {
        "t": "面粉倒进和面盆，分数次淋入清水，边淋边用筷子搅成絮状，再上手揉成偏硬的面团。",
        "time": 8,
        "heat": "无火",
        "tip": "面团要比做饺子皮更硬一些，擀出来才筋道不断。",
        "cue": "面团表面粗糙，按压有弹性"
      },
      {
        "t": "面团盖上湿布静置松弛，中间再揉两次，让面筋舒展开，表面变得光滑。",
        "time": 25,
        "heat": "无火",
        "tip": "松弛不够就擀，面片会回缩，切出来粗细不匀。",
        "cue": "面团按下去缓慢回弹，表皮细腻"
      },
      {
        "t": "面团擀成两毫米厚的面片，撒薄面粉防粘，折叠几层后用刀切成筷子宽的条。",
        "time": 10,
        "heat": "无火",
        "tip": "每折一层都撒粉，切完抖散，否则粘成一块。",
        "cue": "面片透光，切条宽度基本一致"
      },
      {
        "t": "汤锅放植物油，下洋葱丝与蒜末炒到香味出来，冲入高汤大火烧开。",
        "time": 6,
        "heat": "中火",
        "tip": "洋葱炒到透明再冲汤，汤底会带自然甜味。",
        "cue": "洋葱边缘透亮，锅里散出蒜香"
      },
      {
        "t": "汤里下土豆片煮到边缘发软，再放入面片与西葫芦，用勺子轻推防止粘连。",
        "time": 12,
        "heat": "中大火",
        "tip": "面片下锅后别猛搅，用勺背贴着锅底轻推就行。",
        "cue": "面片浮起，汤面泛白微浊"
      },
      {
        "t": "面片煮熟后淋入蛋液，等鸡蛋凝成蛋花，加盐与生抽调味，撒葱花关火。",
        "time": 3,
        "heat": "小火",
        "tip": "蛋液要沿锅边绕圈淋，蛋花才细薄，别一次倒进去。",
        "cue": "蛋花浮在汤面，葱花翠绿"
      }
    ],
    "tips": [
      "和面用水量比包子面团少三成，硬面团擀出的面条煮久了也不糊汤。",
      "面片一次擀太多可以分层撒粉冷冻，下次直接下锅不必解冻。",
      "高汤换成小鱼干与海带煮的清汤，汤味更清爽，适合夏天吃。",
      "土豆先下是为了让淀粉溶进汤里，汤会自然变稠，不必勾芡。"
    ],
    "mistakes": [
      "面团和得太软，切条后互相粘连，下锅就烂成一团糊。",
      "面片下锅后大火猛滚又不停搅，面条表面糊化断成小节。",
      "蛋液在汤大滚时倒入，蛋花被冲散成絮末，汤色浑而不清。"
    ],
    "subs": [
      {
        "orig": "高汤",
        "sub": "清水",
        "ratio": "1000毫升:1000毫升",
        "note": "需补十毫升生抽与两克盐，鲜味才够。"
      },
      {
        "orig": "西葫芦",
        "sub": "南瓜",
        "ratio": "100克:100克",
        "note": "切薄片且煮制时间缩短一半，避免化开。"
      }
    ],
    "variations": [
      "喜欢辣的可以在汤里加一勺辣椒粉，汤色发红，辣味顺着面条入口。",
      "把面片换成手揪的面疙瘩，口感更厚实，适合天冷时吃。"
    ],
    "serving": "盛进深碗，先捞面条再浇汤，最后撒葱花，配一小碟泡菜一起吃。",
    "storage": "面条与汤要分开存放，冷藏两天内吃完，复热时汤单独煮开再下面，避免面条发糊。",
    "nutrition": {
      "basis": "按三人份估算",
      "kcal": 420,
      "protein": 18,
      "fat": 9,
      "carbs": 68,
      "sodium": 980
    },
    "diet": [
      "dairy-free"
    ],
    "tags": [
      "韩国",
      "面条",
      "汤面",
      "家常"
    ],
    "safety": [
      "面粉制品务必煮到面条中心没有白芯，鸡蛋要彻底加热至凝固再出锅。"
    ],
    "origin": "韩国街巷面馆里最常见的清汤刀切面，用硬面团现擀现切，配土豆西葫芦在骨汤里同煮，汤清面滑，冬天捧着碗吃得最暖。",
    "prep": 25,
    "cook": 45,
    "overwrite": true
