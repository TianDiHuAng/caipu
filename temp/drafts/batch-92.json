  "steps": [
   {
    "t": "鸡腿肉带皮一面划两刀到骨，用五克盐和黑胡椒抹匀，静置十五分钟。",
    "time": 18,
    "heat": "无火",
    "tip": "划刀是为了让香料进到厚肉处，否则只有表面有味。",
    "cue": "鸡皮上划出两道深口，肉色略变"
   },
   {
    "t": "洋葱、小葱、大蒜、姜、小米椒与青柠汁、酱油、植物油一起打成粗糊。",
    "time": 6,
    "heat": "无火",
    "tip": "打成粗糊而非细泥，留一点颗粒烤出来更香。",
    "cue": "糊状带明显碎粒，颜色深红发亮"
   },
   {
    "t": "糊里拌入肉桂、肉豆蔻、百里香、辣椒粉、白糖和蜂蜜，调成稠厚的腌酱。",
    "time": 3,
    "heat": "无火",
    "tip": "肉桂与肉豆蔻各一点点就够，多了会盖住辣香。",
    "cue": "腌酱浓稠能挂住鸡皮"
   },
   {
    "t": "鸡腿肉与腌酱抓匀装袋，冷藏腌四小时以上，中途翻面一次。",
    "time": 10,
    "heat": "无火",
    "tip": "腌足四小时，香料才走到肉里，急用也别少于两小时。",
    "cue": "鸡皮被酱料染成深红褐色"
   },
   {
    "t": "烤箱两百度预热，鸡腿肉放烤架上，皮朝上烤二十五分钟至边缘焦黑。",
    "time": 28,
    "heat": "大火",
    "tip": "用烤架架空烤，油滴下去才不会把鸡泡软。",
    "cue": "鸡皮焦褐起泡，滴落的油在盘底滋滋响"
   },
   {
    "t": "取出静置五分钟，斩块装盘，挤剩余青柠汁，撒香菜叶。",
    "time": 6,
    "heat": "无火",
    "tip": "静置让肉汁回流，切开才不流一盘水。",
    "cue": "切面汁水清亮，皮色深褐带焦痕"
   }
  ],
  "tips": [
   "腌酱里的辣椒与 cinnamon 比例是这道菜的性格，辣要够、香料要压得住。",
   "没有烤箱可用炭火烤，明火焦香更接近街头风味。",
   "烤到表面略焦是正常的，牙买加本地就追求这点焦黑。"
  ],
  "mistakes": [
   "腌十分钟就烤，香料只浮在皮上。",
   "鸡肉堆在烤盘里烤，底部被油水泡住，皮软塌不脆。",
   "肉桂放多，整盘像甜点，辣香全被盖住。"
  ],
  "subs": [
   {
    "orig": "鸡腿肉",
    "sub": "鸡翅",
    "ratio": "800 克:800 克",
    "note": "翅根肉薄，烤制时间减到十八分钟。"
   },
   {
    "orig": "小米椒",
    "sub": "辣椒酱",
    "ratio": "30 克:40 克",
    "note": "辣度更稳定，可少放白糖。"
   }
  ],
  "variations": [
   "把腌料换成猪排骨，腌一夜后同样烤制，就是牙买加风味的烤排骨。"
  ],
  "serving": "配米饭与青柠角，也可配烤甜椒和洋葱。",
  "storage": "冷藏两天，冷冻一个月；复热用烤箱两百度八分钟恢复脆皮。",
  "nutrition": {
   "basis": "每份约 250 克",
   "kcal": 520,
   "protein": 38,
   "fat": 32,
   "carbs": 14,
   "sodium": 900
  },
  "safety": [
   "鸡肉须烤至中心完全熟透、无粉红血水，带骨处最厚部位应达七十五度；腌过的生鸡与成品须分开存放，冷藏不超过两天。"
  ],
  "origin": "Jerk 是牙买加特有的腌烤技法，源自逃奴在山中用香料裹肉慢烤的传统。多香果木炭与 Scotch bonnet 辣椒是灵魂，如今街头摊多用铁桶炭炉烤制，配硬面团饼一起吃。",
