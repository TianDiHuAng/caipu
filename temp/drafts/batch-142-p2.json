  "steps": [
   {
    "n": 1,
    "t": "香芹洗净彻底晾干，摘下叶子切成细末，茎部切得再碎一些。",
    "time": 8,
    "heat": "无火",
    "tip": "叶子必须晾干，带水会让酱很快变质。",
    "cue": "香芹末细绿且干爽"
   },
   {
    "n": 2,
    "t": "香菜同样晾干切末，和大蒜末一起放进大碗里。",
    "time": 5,
    "heat": "无火",
    "tip": "大蒜要切成细末，太大块会辣口抢味。",
    "cue": "蒜末细匀，香气刺鼻"
   },
   {
    "n": 3,
    "t": "碗里加入辣椒粉、盐、黑胡椒和白醋，轻轻拌匀。",
    "time": 3,
    "heat": "无火",
    "tip": "先把干料拌匀再倒油，味道分布才均匀。",
    "cue": "干料均匀裹在草末上"
   },
   {
    "n": 4,
    "t": "倒入橄榄油没过所有材料，用勺子从底往上翻拌。",
    "time": 2,
    "heat": "无火",
    "tip": "油要完全没过料，接触空气容易氧化。",
    "cue": "油面平滑，草末沉底"
   },
   {
    "n": 5,
    "t": "室温静置三十分钟让风味融合，中途再翻拌一次。",
    "time": 30,
    "heat": "无火",
    "tip": "至少静置半小时，否则只剩生蒜味。",
    "cue": "酱色深绿，香气浓郁"
   },
   {
    "n": 6,
    "t": "装进干净玻璃罐，油面高出材料一厘米盖好冷藏。",
    "time": 3,
    "heat": "无火",
    "tip": "每次用干净勺子取，别把生水带进去。",
    "cue": "罐内草末压实，油封顶"
   }
  ],
  "tips": [
   "香芹和香菜都要彻底晾干，带水会让酱迅速变质。",
   "静置半小时以上，蒜香和草香才会融合。",
   "油必须完全没过材料，风味的保存期才长。"
  ],
  "mistakes": [
