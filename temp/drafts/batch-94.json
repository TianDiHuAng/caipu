  "steps": [
   {
    "t": "鸡腿肉切两厘米见方的块，加生抽、蒜末、姜末、孜然粉和盐抓匀腌三十分钟。",
    "time": 32,
    "heat": "无火",
    "tip": "腌料里加一勺植物油，肉块烤时不易干柴。",
    "cue": "肉块表面泛酱油色，手感黏滑"
   },
   {
    "t": "竹签提前泡水二十分钟，每根穿四五块鸡肉，肉块之间留一点空隙。",
    "time": 8,
    "heat": "无火",
    "tip": "竹签必泡水，否则上烤架就烧焦断掉。",
    "cue": "串好的肉串长度一致，排列整齐"
   },
   {
    "t": "小锅小火炒香蒜末与葱白，倒入花生酱、椰浆、棕榈糖和白糖搅匀。",
    "time": 5,
    "heat": "小火",
    "tip": "花生酱要先化在温热椰浆里，直接下锅易结块。",
    "cue": "酱汁顺滑流动，表面泛油光"
   },
   {
    "t": "酱汁里加生抽与青柠汁，小火煮三分钟至浓稠挂勺，尝味后调盐。",
    "time": 4,
    "heat": "小火",
    "tip": "沙嗲酱要比蘸酱略稀，烤后还会收紧。",
    "cue": "酱汁浓稠能挂住勺背"
   },
   {
    "t": "肉串刷植物油，烤箱两百度烤十二分钟，中途翻面并刷一层沙嗲酱。",
    "time": 14,
    "heat": "大火",
    "tip": "中途刷酱要在最后五分钟进行，太早会烤焦。",
    "cue": "肉块边缘焦褐，酱层油亮"
   },
   {
    "t": "肉串装盘，配黄瓜片与洋葱丝，撒香菜碎，蘸剩余沙嗲酱和辣椒酱食用。",
    "time": 3,
    "heat": "无火",
    "tip": "青柠角现挤在肉串上，酸香能解腻。",
    "cue": "肉串堆叠整齐，配菜分格摆放"
   }
  ],
  "tips": [
   "花生酱选无糖型，甜味靠棕榈糖控制才好调。",
   "炭火烤比烤箱更香，火力要中火避免外焦内生。",
   "沙嗲酱做多一点，拌饭吃也极好。"
  ],
  "mistakes": [
