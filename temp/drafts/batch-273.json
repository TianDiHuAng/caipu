          },
          {
            "n": "五香粉",
            "a": 3,
            "u": "g",
            "note": "增香"
          },
          {
            "n": "料酒",
            "a": 20,
            "u": "ml",
            "note": "去腥"
          },
          {
            "n": "花生油",
            "a": 30,
            "u": "ml",
            "note": "炒料"
          }
        ]
      }
    ],
    "steps": [
      {
        "t": "糯米淘洗三遍，加清水没过泡两小时，捞出沥干后拌入一半生抽、老抽与盐。",
        "time": 20,
        "heat": "无火",
        "tip": "米要泡到手指能捏碎，煮出来才软糯不夹生。",
        "cue": "米粒粒上色，盆底不见积水。"
      },
      {
        "t": "五花肉切一厘米厚的片，加料酒、白糖、五香粉与姜末抓匀，腌半小时。",
        "time": 30,
        "heat": "无火",
        "tip": "腌透的肉煮完才有咸香，别省略这一步。",
        "cue": "肉片表面发亮，姜末裹匀。"
      },
      {
        "t": "干香菇泡发后切块，虾米用温水泡软沥干，板栗剥去外衣备用。",
        "time": 15,
        "heat": "无火",
        "tip": "香菇水别倒，可以留着拌米增香。",
        "cue": "香菇块厚实，虾米回软。"
      },
      {
        "t": "粽叶剪去硬梗，入沸水煮五分钟，捞出过凉水用布擦干。",
        "time": 5,
        "heat": "大火",
        "tip": "煮过的粽叶有韧性，包的时候不容易裂。",
        "cue": "叶片由青转深绿，摸起来柔韧带水光。"
      },
      {
        "t": "花生油下锅，炒香葱段、香菇块与虾米，倒入糯米中火翻炒三分钟，加剩余生抽拌匀。",
        "time": 5,
        "heat": "中火",
        "tip": "米先炒过再包，香味足且不易泡烂。",
        "cue": "米粒油亮松散，锅里有香菇香。"
      },
      {
        "t": "取两片粽叶叠成漏斗，填一勺糯米，放五花肉、咸蛋黄与板栗，再盖一勺糯米压实。",
        "time": 15,
        "heat": "无火",
        "tip": "米别填太满，留一指空隙给米胀。",
        "cue": "漏斗里米面平整，馅料居中。"
      },
      {
        "t": "粽叶折起包成四角形，用棉线绕两圈扎紧，逐个码进深锅。",
        "time": 20,
        "heat": "无火",
        "tip": "线扎紧不扎死，太紧米没处胀会撑破叶。",
        "cue": "四角分明，提起来不漏米。"
      },
      {
        "t": "加水没过粽子两指，大火烧开后转小火煮两个半小时，中途添热水保持水位。",
        "time": 150,
        "heat": "小火",
        "tip": "水要一直没过粽子，干了就补开水。",
        "cue": "粽叶颜色转深，筷子能轻松插透米心。"
      }
    ],
    "tips": [
      "圆糯米比长糯米黏性足，凉了也不发硬。",
      "咸蛋黄挑油润出沙的，掰开见红油的最好。",
      "一次多包几个，冷藏后复热蒸透比微波好吃。"
    ],
    "mistakes": [
      "米没泡透就下锅，煮再久米心还是硬的。",
      "粽叶没煮直接包，叶脉一折就裂，煮时漏米。"
    ],
    "subs": [
      {
        "orig": "五花肉",
        "sub": "梅花肉",
        "ratio": "300g 对 300g",
        "note": "怕肥的可以用梅花肉，需多腌十分钟入味。"
      }
    ],
    "variations": [
      "泉州人包烧肉粽会加一勺卤汁进米里，成品更黑更香，配甜辣酱吃。"
    ],
    "serving": "剥开趁热吃，淋一点甜辣酱或花生酱，配一碗清汤正好。",
    "storage": "冷藏三天，复热用蒸锅蒸二十分钟至中心烫手，不要微波以免米粒发干。",
    "nutrition": {
      "basis": "每个约 260g",
      "kcal": 520,
      "protein": 18,
      "fat": 22,
      "carbs": 62,
      "sodium": 820
    },
    "diet": [],
    "tags": [
      "闽菜",
      "泉州",
      "烧肉粽",
      "端午"
    ],
    "safety": [
      "五花肉须煮至中心完全熟透，不见血水与粉红色。",
      "糯米黏性大，老人小孩与肠胃弱者宜少量慢吃。",
      "咸蛋黄胆固醇较高，血脂异常人群控制份量。"
    ],
    "origin": "闽南烧肉粽是泉州端午的当家味，讲究米要先用猪油与卤汁炒香，再裹五花肉、咸蛋黄与板栗，煮足两个半小时，剥开油亮黏糯，与北方甜粽完全不同路。",
    "equipment": [
      "锅",
      "锅铲",
      "刀",
      "砧板",
      "碗",
      "棉线",
      "深锅"
    ]
  },
  {
    "id": "fujian-wangao",
    "zh": "闽南碗糕",
    "en": "Minnan Steamed Rice Cake",
    "original": "闽南碗糕",
    "cuisine": "fujian",
    "category": [
      "snack"
    ],
    "difficulty": 2,
    "prep": 100,
    "cook": 50,
    "servings": 6,
    "flavor": [
      "sweet",
      "light",
      "fragrant"
    ],
    "related": [
      "fuzhou-guangbing",
      "fujian-caipu-jiandan"
    ],
    "ingredients": [
      {
        "group": "main",
        "items": [
          {
            "n": "粘米粉",
            "a": 250,
            "u": "g",
            "note": "过筛"
          },
          {
            "n": "温水",
            "a": 260,
            "u": "ml",
            "note": "约四十度"
          }
        ]
      },
      {
        "group": "aux",
        "items": [
          {
            "n": "酵母",
            "a": 3,
            "u": "g",
            "note": "耐高糖型"
          },
          {
            "n": "小苏打",
            "a": 2,
            "u": "g",
            "note": "消酸味"
          }
        ]
      },
      {
        "group": "seasoning",
        "items": [
          {
            "n": "白糖",
            "a": 80,
            "u": "g",
            "note": "调味"
          },
          {
            "n": "花生油",
            "a": 10,
            "u": "ml",
            "note": "刷碗防粘"
          }
        ]
      }
    ],
    "steps": [
      {
        "t": "粘米粉与白糖倒进盆里，分三次加温水，边加边搅成没有颗粒的米浆。",
        "time": 10,
        "heat": "无火",
        "tip": "水别一次倒完，分次搅才不起疙瘩。",
        "cue": "米浆顺滑，舀起能连成线。"
      },
      {
        "t": "米浆过一次筛，撇掉表面的浮沫，静置五分钟。",
        "time": 5,
        "heat": "无火",
        "tip": "过筛这步决定糕面细不细，别省。",
        "cue": "筛网上只剩粗粒，浆面平整。"
      },
      {
        "t": "酵母用两勺温水化开，倒进米浆里搅匀，让酵母分布均匀。",
        "time": 3,
        "heat": "无火",
        "tip": "酵母先用温水化开唤醒，发酵才快也才匀。",
        "cue": "浆面出现细小气泡。"
      },
      {
        "t": "盆口盖保鲜膜，放温暖处发酵一个半小时，米浆膨胀到原来一倍半。",
        "time": 90,
        "heat": "无火",
        "tip": "温度低就延长发酵，看状态不看时间。",
        "cue": "浆面布满气泡，闻起来有淡淡酒香。"
      },
      {
        "t": "发酵好的米浆加小苏打搅匀，静置十分钟散掉酸味。",
        "time": 10,
        "heat": "无火",
        "tip": "小苏打别多，多了成品发黄还带涩味。",
        "cue": "酸味变淡，浆面重新平整。"
      },
      {
        "t": "小碗内壁刷一层花生油，把米浆舀到七分满，轻震两下排出气泡。",
        "time": 10,
        "heat": "无火",
        "tip": "只装七分满，蒸的时候还要往上发。",
        "cue": "碗壁挂油，浆面没有大泡。"
      },
      {
        "t": "蒸锅水开后放入小碗，大火蒸十五分钟，关火焖三分钟再开盖。",
        "time": 18,
        "heat": "大火",
        "tip": "中途别开盖，塌下去就发不起来了。",
        "cue": "糕面隆起开裂像花，竹签插入不粘。"
      }
    ],
    "tips": [
      "米浆发酵到有酒香、表面起泡才算到位，发不够蒸出来是死糕。",
      "碗糕讲究裂口，裂得开才是发得好，别怕难看。",
      "用粘米粉比现磨米浆省事，口感差别不大。"
    ],
    "mistakes": [
      "米浆太稀，蒸出来中间塌成凹坑。",
      "发酵过头酸味重，靠小苏打也压不住。"
    ],
    "subs": [
      {
        "orig": "粘米粉",
        "sub": "大米粉",
        "ratio": "250g 对 250g",
        "note": "现磨米浆要用 300g 大米泡一夜再打成浆。"
      }
    ],
    "variations": [
      "闽南人做碗糕会在浆里拌一勺红糖，蒸出来是琥珀色的红糖碗糕，拜拜时更常见。"
    ],
    "serving": "放凉后从碗里倒扣出来，配豆浆或茶当早餐，热吃松软凉吃紧实。",
    "storage": "冷藏两天，复蒸五分钟回软，凉透再密封免得返潮。",
    "nutrition": {
      "basis": "每份约 120g",
      "kcal": 210,
      "protein": 4,
      "fat": 2,
      "carbs": 44,
      "sodium": 60
    },
    "diet": [
      "vegetarian",
      "vegan",
      "dairy-free"
    ],
    "tags": [
      "闽菜",
      "闽南",
      "碗糕",
      "米食"
    ],
    "safety": [
      "蒸制时水要一次加足，中途揭盖易回缩塌陷。",
      "对酵母过敏者不宜食用，发酵米制品须当日食用完毕。"
    ],
    "origin": "碗糕是闽南人过年与拜拜必备的米食，米浆靠酵母发起，蒸到顶部裂成十字花才算合格，老辈人说裂得越开，来年越发。",
    "equipment": [
      "盆",
      "打蛋器",
      "筛网",
      "保鲜膜",
      "小碗",
      "蒸锅"
    ]
  },
  {
    "id": "fujian-chongwu-yujuan",
    "zh": "崇武鱼卷",
    "en": "Chongwu Fish Roll",
    "original": "崇武鱼卷",
    "cuisine": "fujian",
    "category": [
      "snack"
    ],
    "difficulty": 3,
    "prep": 50,
    "cook": 70,
    "servings": 4,
    "flavor": [
      "savory",
      "umami",
      "salty"
    ],
    "related": [
      "fuzhou-yuwan",
      "fuzhou-yuni"
    ],
    "ingredients": [
      {
        "group": "main",
        "items": [
          {
            "n": "草鱼",
            "a": 700,
            "u": "g",
            "note": "取净肉约五百克"
          },
          {
            "n": "五花肉",
            "a": 100,
            "u": "g",
            "note": "剁泥"
          }
        ]
      },
      {
        "group": "aux",
        "items": [
          {
            "n": "红薯淀粉",
            "a": 60,
            "u": "g",
            "note": "过筛"
          },
          {
            "n": "鸡蛋",
            "a": 50,
            "u": "g",
            "note": "取全蛋液"
          },
          {
            "n": "葱",
            "a": 20,
            "u": "g",
            "note": "泡水"
          },
          {
            "n": "姜",
            "a": 15,
            "u": "g",
            "note": "泡水"
          }
        ]
      },
      {
        "group": "seasoning",
        "items": [
          {
            "n": "盐",
            "a": 8,
            "u": "g",
            "note": "定咸与上劲"
          },
          {
            "n": "白糖",
            "a": 5,
            "u": "g",
            "note": "提鲜"
          },
          {
            "n": "白胡椒粉",
            "a": 2,
            "u": "g",
            "note": "去腥"
          },
          {
            "n": "花生油",
            "a": 15,
            "u": "ml",
            "note": "增润"
          }
        ]
      }
    ],
    "steps": [
      {
        "t": "草鱼去鳞去内脏冲洗干净，片下两侧净肉，剔净鱼刺与发红的鱼肉。",
        "time": 20,
        "heat": "无火",
        "tip": "红肌腥味重，宁可少取肉也要剔干净。",
        "cue": "鱼肉片完整，摸不到硬刺。"
      },
      {
        "t": "鱼肉用刀背反复剁成细泥，中途用手掌按压挑出残留小刺。",
        "time": 15,
        "heat": "无火",
        "tip": "刀背剁比刀刃切更细，成品才弹。",
        "cue": "鱼泥发白细腻，按压无硬点。"
      },
      {
        "t": "五花肉剁成肉泥，葱姜切末用温水泡出葱姜水备用。",
        "time": 10,
        "heat": "无火",
        "tip": "葱姜水比直接放末更均匀，也不留渣。",
        "cue": "葱姜水微黄，肉泥松散。"
      },
      {
        "t": "鱼泥加盐顺一个方向搅打，分三次打入葱姜水，打到发黏上劲。",
        "time": 15,
        "heat": "无火",
        "tip": "上劲是关键，筷子插入不倒才算打好。",
        "cue": "鱼泥抱团发亮，盆壁挂得住。"
      },
      {
        "t": "加入五花肉泥、鸡蛋、红薯淀粉、白糖与白胡椒粉拌匀，最后淋花生油锁润。",
        "time": 10,
        "heat": "无火",
        "tip": "淀粉别一次倒完，边拌边看稠度再增减。",
        "cue": "混合浆稠厚，能挤成圆条不塌。"
      },
      {
        "t": "鱼浆铺在保鲜膜上，卷成手腕粗的圆条，两端扎紧收口。",
        "time": 10,
        "heat": "无火",
        "tip": "卷的时候边卷边压，排出空气才紧实。",
        "cue": "圆条粗细一致，表面无气泡。"
      },
      {
        "t": "水开后中火蒸二十分钟，关火焖五分钟再取出放凉。",
        "time": 25,
        "heat": "中火",
        "tip": "水开后再放，冷水上锅会让鱼卷塌散。",
        "cue": "鱼卷触感弹手，按压回弹。"
      },
      {
        "t": "放凉后拆开保鲜膜切厚片，可直接吃，也可下锅煎到两面金黄。",
        "time": 10,
        "heat": "中火",
        "tip": "热切会散，放凉再切才能片片完整。",
        "cue": "切面细密，片上不见孔洞。"
      }
    ],
    "tips": [
      "草鱼要挑三斤以上的，肉厚出浆多，腥味也轻。",
      "打浆时加一勺猪肥膘，成品更润，这是崇武老手艺。",
      "蒸好的鱼卷冷藏过夜再切，片形更漂亮。"
    ],
    "mistakes": [
      "鱼肉没剔净刺，打浆后刺更碎，吃起来扎嘴。",
      "浆没上劲就下锅，蒸好一切就散成渣。"
    ],
    "subs": [
      {
        "orig": "草鱼",
        "sub": "海鳗鱼",
        "ratio": "700g 对 650g",
        "note": "用海鳗要减少葱姜水，鳗鱼肉本身出水多。"
      }
    ],
    "variations": [
      "惠安崇武的鱼卷常加一小块荸荠碎，咬下去有清脆的层次，是当地桌席的冷盘常客。"
