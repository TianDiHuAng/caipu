    "steps": [
      {
        "t": "整鸡剪去爪尖和鸡屁股，取出内脏后冲洗干净，用厨房纸把表面水分擦干。",
        "time": 15,
        "heat": "无火",
        "tip": "鸡皮一定要擦干，带水刷蜂蜜水挂不住，炸出的颜色也斑驳。",
        "cue": "鸡身干爽无血水，表皮完整。"
      },
      {
        "t": "用盐和料酒把鸡身内外涂匀，腌二十分钟，鸡身内侧也抹到。",
        "time": 20,
        "heat": "无火",
        "tip": "盐要抹到内腔，尤其是胸部厚肉处，否则里面寡淡。",
        "cue": "鸡身表面均匀挂一层薄盐。"
      },
      {
        "t": "蜂蜜兑三十毫升温水调开，薄薄刷满鸡身，挂在通风处晾到表皮发紧。",
        "time": 15,
        "heat": "无火",
        "tip": "晾到皮面发干再下锅，皮才脆得住、上色也匀。",
        "cue": "鸡皮干爽紧绷，泛着浅浅的蜜色。"
      },
      {
        "t": "锅中的植物油烧到六成热，把鸡吊起来用勺反复浇淋，浇到鸡皮金黄起皱。",
        "time": 8,
        "heat": "大火",
        "tip": "浇油比整只下锅更省油，也能避免鸡皮被锅底烫破。",
        "cue": "鸡皮金黄微皱，形状收紧。"
      },
      {
        "t": "汤锅放高汤，加入葱段、姜片、八角、桂皮、香叶、花椒，加生抽、老抽、白糖和盐烧开。",
        "time": 8,
        "heat": "大火",
        "tip": "卤汤咸度要略高于平时的汤，淡了肉就进不去味。",
        "cue": "卤汤红亮，香料香气明显。"
      },
      {
        "t": "把浇好油的鸡放进卤汤，保持汤面微沸，盖盖卤一个小时。",
        "time": 60,
        "heat": "小火",
        "tip": "只能微沸不能大滚，滚得太猛鸡皮会破裂散架。",
        "cue": "鸡身完整浮在汤中，汤面细泡不断。"
      },
      {
        "t": "关火后连汤带鸡浸泡半小时，捞起刷一层卤汤油，晾到不烫手即可斩件上桌。",
        "time": 32,
        "heat": "无火",
        "tip": "关火后浸泡是入味的第二道关口，别急着捞出来。",
        "cue": "鸡肉轻压出汁，皮色红亮。"
      }
    ],
    "tips": [
      "鸡皮必须擦干再刷蜜水，否则上色不均匀。",
      "卤汤只能保持微沸，大滚会把鸡皮煮破、鸡肉散架。",
      "关火后浸泡半小时，让咸香慢慢渗进肉里。"
    ],
    "mistakes": [
      "鸡皮带水就刷蜂蜜水，下油锅溅得满灶台，皮也上不了色。",
      "卤汤大滚着煮鸡，半小时鸡皮就破，端出来形散肉柴。",
      "卤好立刻捞出斩件，外咸内淡，白肉部分几乎没味道。"
    ],
