  "steps": [
   {
    "t": "土豆去皮擦成细丝，擦好后立刻泡进冷水里防氧化发黑。",
    "time": 10,
    "heat": "无火",
    "tip": "土豆一离开水就开始变灰，泡着擦完再处理。",
    "cue": "薯丝雪白，水略发浑"
   },
   {
    "t": "薯丝装进干净纱布，用力拧出水分，拧到几乎挤不出水。",
    "time": 8,
    "heat": "无火",
    "tip": "水挤得越干，煎出来越脆，这是成败关键。",
    "cue": "薯丝干爽，纱布挤不出水"
   },
   {
    "t": "拧出的水静置三分钟，倒掉上层清水留下底部白色淀粉。",
    "time": 5,
    "heat": "无火",
    "tip": "这层淀粉是天然粘合剂，比多加面粉更管用。",
    "cue": "碗底沉出白色浆层"
   },
   {
    "t": "薯丝倒进大碗，加洋葱末、鸡蛋、面粉与白色淀粉。",
    "time": 4,
    "heat": "无火",
    "tip": "鸡蛋先打散再倒，饼糊才拌得均匀不起团。",
    "cue": "糊体黏稠，挂着薯丝"
   },
   {
    "t": "加盐、黑胡椒与白糖拌匀，静置五分钟让味道渗进去。",
    "time": 7,
    "heat": "无火",
    "tip": "拌好别马上下锅，静置一会儿糊体更紧实。",
    "cue": "糊体收紧，尝着咸鲜"
   },
   {
    "t": "平底锅倒一半植物油，中火烧到筷子插进去冒小泡。",
