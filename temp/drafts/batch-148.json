    "heat": "无火",
    "tip": "甜酱油汁要调得略稠，刷在肉上才挂得住。",
    "cue": "酱汁棕亮，能挂住勺"
   },
   {
    "n": 3,
    "t": "鸡腿肉放进甜酱油汁里，冷藏腌制两小时以上。",
    "time": 120,
    "heat": "无火",
    "tip": "至少两小时，隔夜风味更浓更好吃。",
    "cue": "肉面着色均匀一致"
   },
   {
    "n": 4,
    "t": "烤架烧热刷上植物油，鸡腿肉带皮一面朝下用中火烤八分钟。",
    "time": 9,
    "heat": "中火",
    "tip": "先烤带皮那面，油脂滴下来更香。",
    "cue": "表皮起焦斑，油光冒泡"
   },
   {
    "n": 5,
    "t": "翻面再烤七分钟，同时用刷子刷上两遍腌料汁。",
    "time": 8,
    "heat": "中火",
    "tip": "刷两遍就足够，刷太多容易烤糊发苦。",
    "cue": "表面酱色油亮，微微焦边"
   },
   {
    "n": 6,
    "t": "烤到肉中心不再渗出血水，撒香菜和小米辣，挤上柠檬汁。",
    "time": 5,
    "heat": "无火",
    "tip": "挤柠檬汁能解腻，也让酱香更清爽。",
    "cue": "肉汁清澈，香气扑鼻"
   }
