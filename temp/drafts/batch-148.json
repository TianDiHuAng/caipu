     }
    ]
   }
  ],
  "steps": [
   {
    "n": 1,
    "t": "厚底锅倒入牛奶和白糖，中火加热并不断搅拌到糖完全化开。",
    "time": 8,
    "heat": "中火",
    "tip": "糖要先化开，不然容易在锅底结块。",
    "cue": "液体顺滑，无糖粒"
   },
   {
    "n": 2,
    "t": "加小苏打和盐搅匀，转小火保持微沸不再搅拌。",
    "time": 4,
    "heat": "小火",
    "tip": "小苏打让颜色变深，只要一点点就够。",
    "cue": "液面微沸，起细泡"
   },
   {
    "n": 3,
    "t": "小火慢熬八十分钟，每十分钟用木勺刮一次锅底。",
    "time": 80,
    "heat": "小火",
    "tip": "一定要刮底，糖奶沉底就会焦糊。",
    "cue": "颜色由白转为浅棕"
   },
   {
    "n": 4,
    "t": "熬到液体变稠、颜色像焦糖，用温度计测到一百零五度。",
    "time": 6,
    "heat": "小火",
    "tip": "温度到一百零五度就够，再熬会发硬。",
    "cue": "酱体浓稠，能挂住勺"
   },
   {
    "n": 5,
    "t": "离火加香草精拌匀，稍微放凉后装进干净玻璃罐。",
    "time": 8,
    "heat": "无火",
    "tip": "趁温热装罐，冷却后会变得更稠。",
    "cue": "酱色深棕，表面光滑"
   }
  ],
  "tips": [
   "一定要用厚底锅，薄锅容易在底部焦糊。",
   "全程小火并定期刮底，糖奶沉底就会发苦。",
   "熬到颜色像焦糖、能挂勺就可以离火。"
  ],
  "mistakes": [
   "火太大不搅拌，锅底结一层焦黑的硬块。",
   "熬的时间太短，酱体稀得挂不住面包。",
   "小苏打放多了，成品带一股碱味。"
  ],
  "subs": [
   {
    "orig": "牛奶",
    "sub": "淡奶油",
    "ratio": "1000 毫升:800 毫升",
    "note": "更浓郁，熬的时间缩短二十分钟。"
   },
   {
    "orig": "香草精",
    "sub": "香草荚",
    "ratio": "5 毫升:半根",
    "note": "香气更自然，需剖开取籽。"
   }
  ],
  "variations": [
   "加一小撮咖啡粉，做成咖啡焦糖风味。",
   "用羊奶代替牛奶，做成更接近南美的土腥香版本。"
  ],
  "serving": "涂在吐司、松饼或夹进阿尔法霍尔饼干里，是阿根廷人早餐和下午茶必备的甜酱。",
  "storage": "玻璃罐冷藏可存三周；取用须用干净无水的勺子，避免发霉。",
  "nutrition": {
   "basis": "每份约 60 克",
   "kcal": 190,
   "protein": 4,
   "fat": 4,
   "carbs": 34,
   "sodium": 70
  },
  "safety": [
   "含奶类，乳糖不耐者须避免；熬煮时糖浆温度高，搅拌须小心防溅烫，成品冷藏保存不超过三周。"
  ],
  "origin": "阿根廷国民甜酱，牛奶加糖慢熬数小时自然褐变。抹面包、夹饼干、配冰淇淋，几乎无处不在。",
  "tags": [
   "阿根廷",
   "焦糖",
   "甜酱",
   "牛奶"
  ],
  "overwrite": true
