  "steps": [
   {
    "t": "面粉加两克盐拌匀，倒温水边倒边搅，揉成偏软的面团。",
    "time": 12,
    "heat": "无火",
    "tip": "面团要比饺子面软，太硬煎出来咬不动。",
    "cue": "面团柔软，盆壁干净"
   },
   {
    "t": "面团表面刷一层植物油，盖湿布醒四十分钟。",
    "time": 42,
    "heat": "无火",
    "tip": "刷油醒面，擀的时候延展性好，包馅不破。",
    "cue": "面团油润，按压慢慢回弹"
   },
   {
    "t": "花椒用温水泡十分钟，滤出花椒水放凉备用。",
    "time": 11,
    "heat": "无火",
    "tip": "花椒水去腥，牛肉馅尤其需要。",
    "cue": "水色微黄，花椒味冲"
   },
   {
    "t": "牛肉分三次加花椒水，顺一个方向搅到黏稠上劲。",
    "time": 8,
    "heat": "无火",
    "tip": "每次都等水吸干再加，肉馅才抱团不出水。",
    "cue": "肉馅发亮，能拉出细丝"
   },
   {
    "t": "洋葱切细丁，用纱布裹住挤掉一部分水分。",
    "time": 9,
    "heat": "无火",
    "tip": "挤到半干就好，全干就没汁了，饼也不香。",
    "cue": "洋葱丁松散，不见积水"
   },
   {
    "t": "肉馅加姜末、生抽、盐和白胡椒拌匀，再拌入洋葱。",
    "time": 5,
    "heat": "无火",
    "tip": "洋葱最后拌，早拌会一直出水，包的时候难收口。",
    "cue": "馅料黏手，颜色均匀"
   },
   {
    "t": "面团分成六个剂子，擀成中间厚四周薄的圆皮。",
    "time": 8,
    "heat": "无火",
    "tip": "皮别擀太薄，包上馅一煎容易破。",
    "cue": "圆皮匀整，中心略厚"
   },
   {
    "t": "放一大勺馅，像包包子一样收口，收口朝下按扁。",
    "time": 10,
    "heat": "无火",
    "tip": "馅要包足，按扁时用手掌轻压，别用擀面杖。",
    "cue": "饼坯鼓圆，收口紧实"
   },
   {
    "t": "平底锅刷油小火烧热，饼坯下锅盖盖煎五分钟。",
    "time": 6,
    "heat": "小火",
    "tip": "盖盖煎能让热气把馅焖熟，皮也不发硬。",
    "cue": "底面金黄，饼身鼓起"
   },
   {
    "t": "翻面再煎四分钟，两面金黄后刷一层薄油出锅。",
    "time": 5,
    "heat": "小火",
    "tip": "最后一层薄油让表皮发脆，凉了也不回软。",
    "cue": "两面焦黄，表皮起脆"
   }
  ],
  "tips": [
   "清真馅饼只用牛羊肉，洋葱配牛肉是最常见的家常馅。",
   "面团偏软、醒足时间，饼皮才薄而不破。",
   "一次可多包几个，生坯冷冻，早上直接煎很方便。"
  ],
  "mistakes": [
   "面团太硬，煎出来的饼边咬不动，像在嚼面片。",
   "洋葱没挤水直接拌馅，饼一煎就漏汤，糊锅底。",
   "大火煎，皮焦了里面的牛肉还是生的。"
  ],
  "subs": [
   {
    "orig": "牛肉",
    "sub": "羊肉",
    "ratio": "350克:350克",
    "note": "羊肉版要多加一点姜末和白胡椒来压膻。"
   },
   {
    "orig": "洋葱",
    "sub": "大葱",
    "ratio": "250克:200克",
    "note": "大葱版葱香更冲，切得越细越好。"
   }
  ],
  "variations": [
   "馅里加一勺孜然粉，立刻变成西北风味的烤肉馅饼。",
   "改成小个头的锅贴状，煎好蘸米醋吃，更适合当早餐。"
  ],
  "serving": "出锅稍晾两分钟再吃，配一碗羊汤或豆浆，早餐最合适。",
  "storage": "生坯冷冻可存一个月，冷冻后直接下锅小火慢煎；熟饼冷藏两天，复煎两分钟回脆。",
