     }
    ]
   }
  ],
  "steps": [
   {
    "n": 1,
    "t": "粘米粉倒进盆里，冲入三百五十毫升滚开水，边冲边用筷子搅成絮状。",
    "time": 8,
    "heat": "无火",
    "tip": "水必须滚开，粉才烫得熟、皮才透亮。",
    "cue": "粉团成絮，没有干粉颗粒"
   },
   {
    "n": 2,
    "t": "稍凉后用手揉成光滑粉团，盖上湿布防干裂，静置十分钟。",
    "time": 12,
    "heat": "无火",
    "tip": "粉团偏软才包得住馅，硬了会开裂。",
    "cue": "粉团按下去有弹性"
   },
   {
    "n": 3,
    "t": "韭菜洗净晾干水分切成碎末，虾米用温水泡软后切碎。",
    "time": 10,
    "heat": "无火",
    "tip": "韭菜一定晾干，带水下馅会出汤破皮。",
    "cue": "韭菜末松散不结团"
   },
   {
    "n": 4,
    "t": "韭菜末、虾米碎加猪油、盐和白胡椒拌匀，静置五分钟入味。",
    "time": 6,
    "heat": "无火",
    "tip": "猪油是灵魂，别换成其他油，香气完全不同。",
    "cue": "馅料油润发亮"
   },
   {
    "n": 5,
    "t": "粉团揪成三十克一个的剂子，压成中间厚边缘薄的圆皮。",
    "time": 6,
    "heat": "无火",
    "tip": "边缘薄才捏得紧，厚了蒸完有硬边。",
    "cue": "皮子圆整，中间略厚"
   },
   {
    "n": 6,
    "t": "包入馅料捏成半月形，收口捏紧，摆进刷了油的蒸笼。",
    "time": 8,
    "heat": "无火",
    "tip": "馅别塞太满，蒸的时候会被顶破。",
    "cue": "收口严密，形状饱满"
   },
   {
    "n": 7,
    "t": "蒸锅水开后上笼，大火蒸十二分钟，出锅刷一层薄猪油。",
    "time": 15,
    "heat": "大火",
    "tip": "水开再上笼，冷水上锅皮会塌。",
    "cue": "粿皮半透明，能看到韭菜绿"
   }
  ],
  "tips": [
   "烫粉的水必须是刚烧开的滚水，粉才熟透。",
   "韭菜提前晾干水分，馅不出汤皮就不破。",
   "蒸好趁热刷一层猪油，皮亮且不粘。"
  ],
  "mistakes": [
   "用温水烫粉，粉团粗糙包不住馅。",
   "韭菜带水下馅，蒸完皮全破。",
   "馅塞太满，收口被顶开露馅。"
  ],
  "subs": [
   {
    "orig": "虾米",
    "sub": "干香菇",
    "ratio": "30 克:30 克",
    "note": "泡软切碎，素食版本香气也足。"
   },
   {
    "orig": "猪油",
    "sub": "植物油",
    "ratio": "25 克:25 克",
    "note": "香气稍淡，皮光泽差一些。"
   }
  ],
  "variations": [
   "馅里加少许炒香的花生碎，口感更脆。",
   "包好后用平底锅煎一下，做成煎粿更香。"
  ],
  "serving": "趁热装盘，配一碟辣椒酱或鱼露蘸着吃，潮汕人常当早点或下午茶。",
  "storage": "冷藏两天，复热用蒸锅蒸五分钟或平底锅煎至两面微焦。",
  "nutrition": {
   "basis": "每份约 200 克",
   "kcal": 330,
   "protein": 8,
   "fat": 11,
   "carbs": 48,
   "sodium": 620
