  "steps": [
   {
    "n": 1,
    "t": "牛腩切成三厘米见方的块，姜切片，洋葱和胡萝卜切大块备用。",
    "time": 10,
    "heat": "无火",
    "tip": "牛腩块别切太小，久炖会缩成一团。",
    "cue": "肉块方正，肥瘦相间"
   },
   {
    "n": 2,
    "t": "牛腩冷水下锅，加花椒和姜片大火煮开，撇净浮沫后捞出冲净。",
    "time": 12,
    "heat": "大火",
    "tip": "冷水下锅血水才逼得出来，热水下锅会锁在肉里。",
    "cue": "水面浮起灰白沫"
   },
   {
    "n": 3,
    "t": "炒锅放植物油，下洋葱块炒到边缘微焦，再放牛腩块翻炒上色。",
    "time": 8,
    "heat": "中火",
    "tip": "牛腩要炒到表面收紧再炖，汤才不腥。",
    "cue": "肉块表面焦褐，锅底有褐色物"
   },
   {
    "n": 4,
    "t": "加生抽翻匀，倒一千五百毫升清水烧开，转小火加盖炖四十分钟。",
    "time": 42,
    "heat": "小火",
    "tip": "小火慢炖肉才酥，大火只会把汤烧干。",
    "cue": "汤面小泡微沸，肉块变软"
   },
   {
    "n": 5,
    "t": "放土豆块和胡萝卜块继续炖二十分钟，炖到筷子能轻松插透。",
    "time": 22,
    "heat": "小火",
    "tip": "土豆后放，早放会炖成泥糊住汤。",
    "cue": "土豆边角圆钝不散"
   },
   {
    "n": 6,
    "t": "加盐调味，转中火收浓汤汁，撒少许姜末提香后关火。",
    "time": 4,
    "heat": "中火",
    "tip": "盐最后放，早放肉会紧实难炖软。",
    "cue": "汤汁挂勺，表面浮一层油"
   }
  ],
  "tips": [
   "牛腩冷水下锅焯水，血沫撇净汤才清。",
   "土豆在肉炖到七分熟时再放，整块不散。",
   "收汁时轻推锅底防粘，别用铲子翻碎土豆。"
  ],
  "mistakes": [
   "牛腩热水下锅，血水锁在肉里汤发腥。",
   "土豆和肉一起下锅，最后糊成一锅泥。",
   "全程大火猛煮，肉柴汤干。"
  ],
  "subs": [
   {
    "orig": "牛腩",
    "sub": "牛肉",
    "ratio": "600 克:600 克",
    "note": "用牛腱更筋道，炖的时间要加二十分钟。"
   },
   {
    "orig": "土豆",
    "sub": "白萝卜",
    "ratio": "400 克:400 克",
    "note": "更清甜，炖十五分钟就够。"
   }
  ],
  "variations": [
   "加一把干辣椒，微辣更下饭。",
   "收汁后撒一把香菜，香气更冲。"
  ],
  "serving": "连汤带肉盛进深碗，浇在米饭上，配一碟酸萝卜解腻。",
  "storage": "冷藏三天，复热时加少量清水小火慢温，避免土豆糊锅。",
  "nutrition": {
   "basis": "每份约 420 克",
   "kcal": 520,
   "protein": 34,
   "fat": 30,
   "carbs": 26,
   "sodium": 960
  },
  "safety": [
   "牛腩必须炖到中心完全熟透、无血色，筷子能轻松插透；剩菜冷藏不超过三天，复热要滚开。"
  ],
  "origin": "青藏高原上的日常硬菜，牧民把牛肉、土豆和洋葱一锅炖透，靠花椒和姜压住腥气。海拔高、气压低，当地习惯炖得比平原更久，肉烂汤浓才算到位。",
