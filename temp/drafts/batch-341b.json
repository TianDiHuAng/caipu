  "steps": [
   {
    "t": "卷心菜剥掉外层老叶，对半切开挖去硬芯，切成两毫米细丝。",
    "time": 18,
    "heat": "无火",
    "tip": "切得越细，出水和发酵越均匀，成品越脆。",
    "cue": "细丝匀整，菜梗不留大块"
   },
   {
    "t": "菜丝放大盆，撒盐用手抓揉十分钟，揉到出水变软。",
    "time": 12,
    "heat": "无火",
    "tip": "抓揉要用力，把细胞壁揉破才会自己出卤水。",
    "cue": "菜丝软塌，盆底见水"
   },
   {
    "t": "加胡萝卜丝、洋葱丝、香菜籽、香叶和黑胡椒拌匀。",
    "time": 6,
    "heat": "无火",
    "tip": "香料不用多，一点点就够撑起发酵的底味。",
    "cue": "菜丝均匀，香料散布"
   },
   {
    "t": "把菜丝分批塞进干净玻璃罐，每层用拳压实，压到卤水没过菜面。",
    "time": 12,
    "heat": "无火",
    "tip": "一定要压实，露出液面的部分容易发霉。",
    "cue": "菜面平整，卤水漫过"
   },
   {
    "t": "罐口盖一层保鲜膜，压上重物，放在十八到二十二度避光处。",
    "time": 5,
    "heat": "无火",
    "tip": "温度过高会发黏，过低则不发酵，十八度最稳。",
    "cue": "菜面被压住，无气泡"
   },
   {
    "t": "每天开盖放气一次，用干净筷子把上浮的菜压回卤水下面。",
