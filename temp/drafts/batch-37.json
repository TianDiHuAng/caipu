    "ratio": "450g 对 450g",
    "note": "香气更浓，孜然可减半。"
   },
   {
    "orig": "面包",
    "sub": "面包糠",
    "ratio": "40g 对 30g",
    "note": "吸水性更强。"
   }
  ],
  "variations": [
   "酸奶版：配 200g 酸奶与烤饼一起上桌。",
   "番茄版：煎好后加 200g 番茄膏酱汁焖五分钟。"
  ],
  "serving": "配皮塔饼、番茄片、洋葱丝与酸奶酱，卷起来吃。",
  "storage": "冷藏可存 2 天，冷冻 1 个月，复热用平底锅小火煎 4 分钟。",
  "nutrition": {
   "basis": "每份（约 190g）",
   "kcal": 420,
   "protein": 30,
   "fat": 28,
   "carbs": 10,
   "sodium": 760
  },
  "safety": [
   "牛肉末须完全煎熟至中心温度 71℃ 以上，避免肉馅内部细菌残留。",
   "鸡蛋为常见过敏原，过敏人群可省略蛋清改用 10g 淀粉。",
   "生肉接触过的砧板与手须彻底清洗。"
  ],
  "origin": "烤肉丸是土耳其烧烤摊的常客，当地人叫它 kofta。洋葱泥给肉馅水分与甜味，孜然与辣椒粉定下那股中东香气，压扁贴在烤签上，炭火一烤就滋滋冒油。",
  "tags": [
