  "steps": [
   {
    "t": "洋葱擦成泥后挤掉汁水，与牛肉末、蛋清、泡软挤干的面包一起放进大碗。",
    "time": 8,
    "heat": "无火",
    "tip": "洋葱汁挤掉，肉丸才不散。",
    "cue": "肉馅黏稠、洋葱成泥"
   },
   {
    "t": "加蒜末、欧芹碎、孜然、辣椒粉、盐与黑胡椒，顺一个方向搅到起胶。",
    "time": 5,
    "heat": "无火",
    "tip": "搅到发黏上劲，口感才弹。",
    "cue": "肉馅发亮、能拉出丝"
   },
   {
    "t": "肉馅冷藏十分钟后分成十二份，搓成椭圆压扁，串在烤签上整形成长条。",
    "time": 6,
    "heat": "无火",
    "tip": "压扁贴签，受热更均匀。",
    "cue": "肉条厚薄一致、贴合烤签"
   },
   {
    "t": "平底锅倒植物油中火烧热，肉丸每面煎三分钟至表面焦褐、内部熟透。",
    "time": 6,
    "heat": "中火",
    "tip": "别频繁翻动，焦壳才成型。",
    "cue": "表面焦褐、按压有弹性"
   }
  ],
  "tips": [
   "洋葱擦泥后挤干汁水，多余水分会让肉丸在锅里散开。",
   "肉馅要顺一个方向搅到起胶，烤出来才有弹性。",
   "整形时压扁贴紧烤签，受热均匀才不会外焦里生。"
  ],
  "mistakes": [
   "肉馅没上劲就下锅，一煎就散成肉末。",
   "火太大又不翻面，外面焦黑里面还是生的。",
   "肉丸做太厚，中心始终熟不透。"
  ],
  "subs": [
