  "equipment": [
   "擦丝器",
   "纱布",
   "大碗",
   "蒜泥器"
  ],
  "steps": [
   {
    "t": "黄瓜去皮擦成细丝，撒一半盐抓匀静置十分钟，让它出掉多余水分。",
    "time": 5,
    "heat": "无火",
    "tip": "去水是浓稠的关键。",
    "cue": "黄瓜丝出水、体积缩小"
   },
   {
    "t": "黄瓜丝包进纱布用力挤干，挤到抓一把不再滴水为止。",
    "time": 5,
    "heat": "无火",
    "tip": "挤得越干，酱越浓稠。",
    "cue": "黄瓜丝干爽成团"
   },
   {
    "t": "酸奶加蒜泥、柠檬汁、剩余盐与黑胡椒拌匀，再拌入黄瓜丝与薄荷碎。",
    "time": 3,
    "heat": "无火",
    "tip": "蒜泥现磨，香气才冲。",
    "cue": "酱体浓稠、颜色乳白带绿"
   },
   {
    "t": "盛进碗里淋一圈橄榄油，撒黑胡椒，冷藏十分钟后食用更佳。",
    "time": 2,
    "heat": "无火",
    "tip": "冷藏后风味更融合。",
    "cue": "表面油亮、质地挂勺"
   }
  ],
  "tips": [
   "黄瓜必须挤到不滴水，否则拌好一小时就出水变稀。",
   "酸奶选浓稠型，稀酸奶先挂纱布滤两小时再用。",
   "蒜泥现磨现用，提前磨好会发苦。"
  ],
  "mistakes": [
   "黄瓜没去水就拌，酱汁稀得像汤。",
   "用甜味酸奶代替原味，整碗味道跑偏。",
   "蒜泥一次放太多，压过酸奶与黄瓜的清香。"
  ],
  "subs": [
   {
    "orig": "酸奶",
    "sub": "希腊酸奶",
    "ratio": "400g 对 400g",
    "note": "蛋白更高、质地更厚。"
   },
   {
    "orig": "薄荷",
    "sub": "莳萝",
    "ratio": "5g 对 5g",
    "note": "香气更清冷。"
   }
  ],
  "variations": [
   "辣味版：加 5g 辣椒粉与橄榄油同淋。",
   "胡萝卜版：掺 100g 胡萝卜丝增甜。"
  ],
  "serving": "配皮塔饼、烤肉串或烤蔬菜，也可当沙拉酱。",
  "storage": "冷藏密封可存 3 天，出水后拌匀再吃。",
  "nutrition": {
   "basis": "每份（约 180g）",
   "kcal": 140,
   "protein": 7,
   "fat": 9,
   "carbs": 9,
   "sodium": 420
  },
  "safety": [
   "含乳制品，乳糖不耐者改用无乳糖酸奶。",
   "黄瓜表面须洗净，生食菜肴不做二次杀菌。",
   "成品冷藏保存，室温放置超过 2 小时不宜再食用。"
  ],
  "origin": "酸奶黄瓜酱是希腊餐桌上的万能蘸酱，也是烤肉与皮塔饼的固定配角。做法看似简单，核心却只有一个：黄瓜必须挤干，否则再浓的酸奶也会被稀释。",
  "tags": [
   "希腊菜",
   "蘸酱",
   "酸奶",
   "冷菜"
  ],
  "related": [
   "greek-salad"
  ]
 },
