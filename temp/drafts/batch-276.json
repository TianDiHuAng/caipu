    ],
    "subs": [
      {
        "orig": "草鱼",
        "sub": "鲅鱼",
        "ratio": "400g 对 400g",
        "note": "鲅鱼肉更紧实，打浆时可多放五毫升水。"
      }
    ],
    "serving": "一人一碗连汤带丸，撒葱花趁热吃，冬日配一碗白饭最暖。"
  },
  {
