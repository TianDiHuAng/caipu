    "steps": [
      {
        "t": "草鱼去鳞去内脏，片下两侧鱼肉，用勺背刮下鱼泥，顺手挑净细刺。",
        "time": 8,
        "heat": "无火",
        "tip": "刮比剁好，刮出的鱼泥不带筋，丸子弹而不柴。",
        "cue": "鱼泥细腻能捏成团。"
      },
      {
        "t": "鱼泥加盐、玉米淀粉与五十毫升清水，顺一个方向搅到起胶、表面发亮。",
        "time": 6,
        "heat": "无火",
        "tip": "一定顺同一方向搅，反着搅胶就散了。",
        "cue": "鱼泥黏手拉丝，甩盆不掉。"
      },
      {
        "t": "五花肉剁成茸，拌入姜末、生抽与部分葱花，调成抱团的肉末。",
        "time": 5,
        "heat": "无火",
        "tip": "肉馅调得稍稠一点，包进鱼丸才不会渗水。",
        "cue": "馅料抱团，筷子挑起成坨。"
      },
      {
        "t": "手心抹水，取一勺鱼泥摊开，包入一小团肉末，收口挤成两头尖的纺锤形鱼丸。",
        "time": 6,
        "heat": "无火",
        "tip": "手心一定要蘸水，不然鱼泥全粘在掌上捏不成形。",
        "cue": "鱼丸表面光滑，大小均匀。"
      },
      {
        "t": "清水烧到锅底冒小泡但未翻滚，逐个下鱼丸，小火慢养到全部浮起。",
        "time": 6,
        "heat": "小火",
        "tip": "水不能大滚，一滚鱼丸就裂开散汤。",
        "cue": "鱼丸鼓起泛白，浮在水面打转。"
      },
      {
        "t": "加盐、白糖与白胡椒调味，撒葱花淋香油，连汤盛进碗里。",
        "time": 3,
        "heat": "小火",
        "tip": "汤要清，别加酱油，否则失了福州汤的澄净。",
        "cue": "汤色清亮，鱼丸饱满。"
      }
    ],
    "tips": [
      "七星鱼丸的关键是鱼泥打上劲，搅到能甩盆不落才算到位。",
      "包了肉馅的鱼丸咬开会有一包油润汤汁，所以汤底只放盐与白胡椒。",
      "福州老店会把鱼丸在掌心反复摔打几十次，弹性能明显更好。"
    ],
    "mistakes": [
      "鱼泥没打上劲就下锅，散成一锅碎渣。",
      "水滚着下鱼丸，丸子表面先定形、内部爆开。"
    ],
    "storage": "鱼丸可冷冻一周，汤当天喝完；复热时小火，不要大火滚。",
    "diet": [
      "pescatarian",
      "dairy-free"
    ],
    "tags": [
      "闽菜",
      "福州",
      "鱼丸",
      "汤品"
    ],
    "safety": [
      "鱼肉须彻底加热至完全熟透，不要生食。",
      "鱼类为常见过敏原，过敏人群不宜食用。",
      "鱼刺须挑净，老人与儿童食用前再检查一次。"
    ],
    "origin": "福州七星鱼丸是闽都小吃的门面，相传因形似星斗、一碗浮七颗而得名。鱼肉刮泥打浆，包一小团猪肉馅，煮出来弹牙带汤，福州人喝汤从早餐到夜宵都合适。",
    "variations": [
      "连江一带的鱼丸会掺少量鳗鱼肉，口感更脆，汤里则加一勺虾油提鲜。"
    ],
    "nutrition": {
      "basis": "每份约 300g",
      "kcal": 230,
      "protein": 26,
      "fat": 10,
      "carbs": 8,
      "sodium": 760
    },
    "equipment": [
