    "steps": [
      {
        "t": "扇贝用硬刷刷净外壳，用刀沿壳缝撬开，取出贝肉去掉黑色内脏后洗净。",
        "time": 10,
        "heat": "无火",
        "tip": "内脏和腮要去净，留着会带泥腥。",
        "cue": "贝壳洁白，贝肉完整。"
      },
      {
        "t": "粉丝用清水泡到能弯折，捞出剪成两段，垫在每只贝壳底部。",
        "time": 6,
        "heat": "无火",
        "tip": "粉丝别泡烂，蒸的时候还要吸汁。",
        "cue": "粉丝柔软有弹性。"
      },
      {
        "t": "蒜剁成末分两份，一半用花生油小火炸到金黄，与生蒜末、生抽、盐、白糖拌成蒜蓉酱。",
        "time": 7,
        "heat": "小火",
        "tip": "半生半熟蒜才香，全炸焦了发苦。",
        "cue": "蒜蓉酱金黄带白，香气冲鼻。"
      },
      {
        "t": "贝肉放回壳里，铺上一勺蒜蓉酱，再淋小半勺泡过粉丝的清水。",
        "time": 5,
        "heat": "无火",
        "tip": "淋一点清水，粉丝蒸出来才不干硬。",
        "cue": "蒜蓉盖住贝肉，壳内有汁。"
      },
      {
        "t": "水开后上锅，大火蒸五分钟，取出撒葱花与小米辣圈。",
        "time": 5,
        "heat": "大火",
        "tip": "五分钟足够，蒸久了贝肉缩成橡皮。",
        "cue": "贝肉鼓起，汤汁在壳里打转。"
      },
      {
        "t": "花生油烧到微微冒烟，趁热泼在葱花上激出香气，立刻上桌。",
        "time": 4,
        "heat": "大火",
        "tip": "泼油要听到响，油不够热激不出葱蒜的香。",
        "cue": "葱花滋滋作响，油香盖过蒜香。"
      }
    ],
    "tips": [
      "扇贝要挑活的，壳闭得紧、敲一下会动的才新鲜。",
      "蒜蓉一半生一半炸，是闽南蒸海鲜的通用做法，香而不苦。",
      "垫底的粉丝吸饱蒜油与贝汁，往往比贝肉更抢手。"
    ],
    "mistakes": [
      "蒜蓉全用生蒜，蒸出来辛辣冲鼻。",
      "蒸的时间超过八分钟，贝肉又老又硬。"
    ],
    "storage": "现蒸现吃，冷藏不超过一天，复蒸会变老。",
    "diet": [
