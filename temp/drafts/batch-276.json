    "steps": [
      {
        "t": "鲜虾剪去虾枪与长须，用牙签从背部挑出虾线，冲洗干净。",
        "time": 8,
        "heat": "无火",
        "tip": "虾线挑干净，糟香才不会被泥腥压住。",
        "cue": "虾身干净，腹部无黑线。"
      },
      {
        "t": "姜切片，小葱打一个结，香糟用料酒调开成稀糊状糟卤。",
        "time": 5,
        "heat": "无火",
        "tip": "糟卤要调开，颗粒状的糟会挂在虾身上。",
        "cue": "糊体顺滑，酒糟香明显。"
      },
      {
        "t": "清水加姜片、葱结与盐烧开，下虾煮到通体通红、虾身卷成弯钩。",
        "time": 5,
        "heat": "大火",
        "tip": "虾一变红就捞，多煮一分钟肉就发柴。",
        "cue": "虾壳通红发亮，虾身紧卷。"
      },
      {
        "t": "虾趁热放进糟卤里拌上白糖，让每只虾身都裹上糟汁。",
        "time": 4,
        "heat": "无火",
        "tip": "趁热拌糟才入味，凉了糟香只在表面。",
        "cue": "虾身挂着浅褐色糟汁。"
      },
      {
        "t": "连汁装进保鲜盒冷藏两小时，取出摆盘，浇一勺糟汁上桌。",
        "time": 3,
        "heat": "无火",
        "tip": "冷藏两小时是底限，隔夜糟味更透。",
        "cue": "虾肉紧弹，糟香冲鼻。"
      }
    ],
    "tips": [
      "香糟要选发酵味干净的，酸味重的糟做出来发闷。",
      "醉虾是熟醉不是生腌，虾必须先煮透再糟。",
      "福州人配这道菜常上一碟蒜泥醋，酸辣能衬出糟香。"
    ],
    "mistakes": [
      "虾煮得太久，糟卤再香也救不回柴掉的肉。",
      "糟卤里不放糖，咸味直冲、糟香显薄。"
    ],
    "storage": "冷藏两天内吃完，糟汁不要重复使用。",
    "diet": [
      "pescatarian",
      "gluten-free",
      "dairy-free"
    ],
    "tags": [
