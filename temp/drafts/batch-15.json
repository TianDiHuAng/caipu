    "sub": "青蒜",
    "ratio": "1:1",
    "note": "青蒜叶更嫩，炒制时间减半。"
   }
  ],
  "variations": [
   "家庭简化版：腊肉直接蒸熟切片，与蒜苗快炒 2 分钟，省去浸泡。",
   "湘西版：加 20g 干豆豉同炒，酱香更重。"
  ],
  "serving": "配白米饭，腊肉油脂拌饭最香；亦可作下酒菜。",
  "storage": "冷藏 2 天，复热加 20ml 清水快炒，避免蒜苗发黄。",
  "nutrition": {
   "basis": "每份（约 1/3 量）",
   "kcal": 420,
   "protein": 18,
