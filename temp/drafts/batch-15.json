    "ratio": "8g 紫菜 ≈ 20g 海带芽",
    "note": "海带芽需煮 3 分钟。"
   },
   {
    "orig": "高汤",
    "sub": "清水加鸡精",
    "ratio": "700ml 高汤 ≈ 700ml 水 + 3g 鸡精",
    "note": "相应减少 1g 盐。"
   }
  ],
  "variations": [
   "家常版：加 50g 嫩豆腐丁与 3g 虾皮，做三鲜蛋花汤。",
   "粤式版：以 3g 瑶柱丝提鲜，汤更清甜。"
  ],
  "serving": "配米饭或作为套餐汤水，饭前一碗最开胃。",
  "storage": "建议现做现喝，冷藏不超过 1 天，复热需煮沸。",
  "nutrition": {
   "basis": "每份（约 1/2 量）",
   "kcal": 110,
   "protein": 9,
   "fat": 7,
   "carbs": 3,
   "sodium": 760
  },
  "safety": [
   "鸡蛋需在汤中完全凝固，避免生蛋液入口，儿童孕妇尤需注意。",
   "紫菜需挑选无沙无异味产品，泡洗后使用。",
   "汤隔夜复热必须沸腾 1 分钟以上。"
  ],
  "origin": "紫菜蛋花汤是粤式家常与茶餐厅最常见的例汤之一，三分钟出锅，靠紫菜的海洋鲜味与蛋花撑起清汤。",
  "tags": [
