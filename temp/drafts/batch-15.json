  "steps": [
   {
    "t": "干紫菜用清水快速冲一遍，泡 1 分钟后沥干，去掉沙粒。",
    "time": 2,
    "heat": "无火",
    "tip": "紫菜不要久泡，泡久会失去脆嫩口感。",
    "cue": "紫菜舒展开、水色微绿"
   },
   {
    "t": "鸡蛋打散，加 5ml 清水搅匀至蛋液细腻无结块。",
    "time": 1,
    "heat": "无火",
    "tip": "加少量水蛋花更嫩、更易拉成片。",
    "cue": "蛋液均匀、表面浮小泡"
   },
   {
    "t": "高汤加姜丝煮沸，下紫菜煮 1 分钟，加盐与白胡椒调味。",
