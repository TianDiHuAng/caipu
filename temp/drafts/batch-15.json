    ]
   }
  ],
  "equipment": [
   "砂锅",
   "漏勺",
   "密封盒"
  ],
  "steps": [
   {
    "t": "白萝卜切块加 3g 盐与白糖抓匀腌 30 分钟，倒掉析出的水，加香醋拌匀冷藏 2 小时成酸萝卜。",
    "time": 150,
    "heat": "无火",
    "tip": "酸萝卜可提前一天做好，冷藏能存一周。",
    "cue": "萝卜发软、酸味明显"
   },
   {
    "t": "鸭块冷水下锅，加姜片与料酒，大火煮沸后撇净血沫，煮 3 分钟捞出冲净。",
    "time": 6,
    "heat": "大火",
    "tip": "冷水下锅才能把血水逼出来，汤才清。",
    "cue": "鸭皮收紧、水面浮起灰白沫"
   },
   {
    "t": "砂锅加 2500ml 清水、鸭块、姜片与葱结，大火烧开转小火炖 90 分钟。",
    "time": 95,
    "heat": "小火",
    "tip": "保持汤面微沸，滚太猛汤会浑。",
    "cue": "汤色转乳白、鸭肉能用筷子戳透"
   },
   {
    "t": "下酸萝卜块再炖 20 分钟，加 3g 盐与白胡椒调味。",
    "time": 22,
    "heat": "小火",
    "tip": "酸萝卜后下，酸味才清爽不闷。",
    "cue": "酸香扑鼻、萝卜呈半透明"
   },
   {
    "t": "挑出葱结与姜片，盛碗撒少许葱花即可。",
    "time": 2,
    "heat": "无火",
    "tip": "汤面浮油多可先撇去一层。",
    "cue": "汤清微浊、浮少量油花"
   }
  ],
  "tips": [
   "老鸭选两年以上的，鸭味足、久炖不柴。",
   "没有时间腌酸萝卜，可用市售泡萝卜 300g 直接替代。",
   "汤里加 3 片火腿，鲜味更厚。"
  ],
  "mistakes": [
   "鸭块不焯水直接炖，汤浑浊带腥味。",
   "一直大火滚煮，鸭肉散烂、汤色发白不清。",
   "酸萝卜一开始就下锅，酸味挥发、汤变寡淡。"
  ],
  "subs": [
   {
    "orig": "鸭",
    "sub": "老母鸡",
    "ratio": "1000g 鸭 ≈ 1000g 鸡",
    "note": "炖制时间延长到 120 分钟。"
   },
   {
    "orig": "白萝卜",
    "sub": "青萝卜",
    "ratio": "1:1",
    "note": "青萝卜更脆，腌 2 小时即可。"
   }
  ],
  "variations": [
   "家庭简化版：用酸萝卜与鸭块一起高压锅压 25 分钟，快速出汤。",
   "川东版：加 20g 泡椒同炖，酸辣更开胃。"
  ],
  "serving": "作为主汤配米饭，汤渣可蘸辣椒碟食用。",
  "storage": "冷藏 3 天，复热需彻底煮沸，酸萝卜另存。",
  "nutrition": {
   "basis": "每份（约 1/4 量）",
   "kcal": 420,
   "protein": 30,
   "fat": 30,
   "carbs": 8,
   "sodium": 880
  },
  "safety": [
   "鸭肉需炖至中心完全变色、无血水，中心温度 74℃ 以上。",
   "酸萝卜腌制需全程冷藏，出现异味或起沫立即丢弃。",
   "汤品隔夜必须彻底加热沸腾后再食用。"
  ],
  "origin": "酸萝卜老鸭汤是川渝一带的家常炖汤，用自腌酸萝卜解鸭肉的肥腻，汤酸香开胃，冬日常被当作滋补汤水。",
  "tags": [
   "川菜",
   "汤品",
   "炖菜",
   "家常"
  ],
  "related": [
   "zhangcha-ya",
