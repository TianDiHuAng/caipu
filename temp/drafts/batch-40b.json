   "刮刀"
  ],
  "steps": [
   {
    "t": "模具内壁刷一层黄油并撒薄薄一层面粉，铺上油纸备用。",
    "time": 5,
    "heat": "无火",
    "tip": "模具处理好，脱模才完整。",
    "cue": "模具内壁均匀挂粉"
   },
   {
    "t": "鸡蛋与 150g 白糖放入盆中，高速打发 6 分钟至颜色发白、体积膨大。",
    "time": 7,
    "heat": "无火",
    "tip": "打到滴落的糊能堆出纹路才好。",
    "cue": "蛋糊浓稠泛白、能挂住打蛋器"
   },
   {
    "t": "筛入 250g 杏仁粉与 2g 肉桂粉，用刮刀从底往上翻拌至无干粉。",
    "time": 4,
    "heat": "无火",
    "tip": "翻拌别画圈，避免消泡。",
    "cue": "面糊细腻无颗粒、体积略降"
   },
   {
    "t": "擦入柠檬皮屑拌匀，倒入模具，轻震两下排出大气泡。",
    "time": 3,
    "heat": "无火",
    "tip": "柠檬皮只取黄色部分，带白会苦。",
    "cue": "面糊表面平整、气泡浮起破裂"
   },
   {
    "t": "烤箱 175 度烤 30 分钟，牙签插入中心取出无湿糊即熟。",
    "time": 33,
    "heat": "中火",
    "tip": "表面盖锡纸防上色过深。",
    "cue": "蛋糕边缘脱离模具、表面金黄"
   },
   {
    "t": "完全放凉后脱模，撒一层糖粉并放上十字镂空纸模筛出图案。",
    "time": 15,
    "heat": "无火",
    "tip": "必须凉透再脱模，热脱会塌。",
    "cue": "蛋糕体紧实、糖粉图案清晰"
   }
  ],
  "tips": [
