  ],
  "equipment": [
   "烤箱",
   "烤盘",
   "料理机",
   "刮刀"
  ],
  "steps": [
   {
    "t": "红椒与番茄切面对上摆在烤盘，大蒜带皮同放，淋 10ml 橄榄油。",
    "time": 5,
    "heat": "无火",
    "tip": "切面朝上更容易烤出焦痕。",
    "cue": "蔬菜表面裹上一层薄油"
   },
   {
    "t": "烤箱 220 度烤 20 分钟，至红椒表皮起泡发黑、番茄软塌。",
    "time": 22,
    "heat": "大火",
    "tip": "烤到起泡才有烟熏香，这是酱的灵魂。",
    "cue": "椒皮焦黑起泡、番茄出汁"
   },
   {
    "t": "取出蔬菜盖碗焖 5 分钟，撕去红椒与番茄的外皮，大蒜挤出去皮。",
    "time": 7,
    "heat": "无火",
    "tip": "焖一下皮就好撕。",
    "cue": "表皮轻松剥离、椒肉柔软"
   },
   {
    "t": "杏仁用干锅小火烘 3 分钟至出香，放凉备用。",
    "time": 4,
    "heat": "小火",
    "tip": "杏仁烤过才够香，别烤糊。",
    "cue": "杏仁微黄、香气明显"
   },
   {
    "t": "把蔬菜、杏仁、大蒜、欧芹、甜椒粉、米醋与 3g 盐放入料理机打碎。",
    "time": 3,
    "heat": "无火",
    "tip": "先粗打再加油，质地更均匀。",
    "cue": "混合物呈粗颗粒糊状"
   },
   {
    "t": "分三次倒入剩余 70ml 橄榄油，每次打 20 秒至酱体乳化发亮。",
    "time": 3,
    "heat": "无火",
    "tip": "慢慢加油，酱才不会油水分离。",
    "cue": "酱体浓稠挂勺、颜色橙红"
   }
  ],
  "tips": [
   "红椒烤到表皮发黑，烟熏味才够正。",
   "橄榄油分次慢加，酱体才乳化顺滑。",
   "杏仁一定要烤香，生杏仁会让酱发涩。"
  ],
  "mistakes": [
   "蔬菜只烤到变软，酱缺少烟熏底味。",
   "橄榄油一次全倒，打出来油水分离。",
   "用带皮生杏仁直接打，口感粗涩发苦。"
  ],
  "subs": [
   {
    "orig": "杏仁",
    "sub": "榛子",
    "ratio": "80g 对 80g",
    "note": "风味更浓，烘烤时间加 1 分钟。"
   },
   {
    "orig": "米醋",
    "sub": "柠檬汁",
    "ratio": "20ml 对 20ml",
    "note": "酸味更清亮。"
   }
  ],
  "variations": [
   "加面包版：加 30g 烤面包块，酱体更稠厚。",
   "微辣版：加 3g 干辣椒同打。"
  ],
  "serving": "配烤蔬菜、烤鱼或煎肉，也可当面包蘸酱。",
  "storage": "冷藏 5 天，表面淋一层橄榄油封存，取用前搅匀。",
  "nutrition": {
   "basis": "每份（约 120g）",
   "kcal": 280,
   "protein": 6,
   "fat": 25,
   "carbs": 10,
   "sodium": 380
  },
  "safety": [
   "含坚果，坚果过敏人群禁止食用。",
   "烤制时椒皮起泡会溅汁，取盘须戴隔热手套。"
  ],
  "origin": "Romesco 来自西班牙加泰罗尼亚的塔拉戈纳，渔民把它配烤鱼与烤葱吃。烤到起泡的红椒、烤香的杏仁与橄榄油打成浓稠的酱，酸香带烟熏，是加泰罗尼亚餐桌上少不了的一味。",
  "tags": [
   "西班牙菜",
