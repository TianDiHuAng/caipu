     }
    ]
   }
  ],
  "equipment": [
   "平底锅",
   "锅铲",
   "小碗"
  ],
  "steps": [
   {
    "t": "虾仁用厨房纸吸干水分，加 1g 盐抓匀静置 5 分钟。",
    "time": 7,
    "heat": "无火",
    "tip": "虾仁干爽下锅才不溅油。",
    "cue": "虾仁表面无水分、手感紧实"
   },
   {
    "t": "平底锅倒入 90ml 橄榄油，小火下蒜片慢煎 3 分钟至微黄。",
    "time": 4,
    "heat": "小火",
    "tip": "蒜片小火慢煎，焦了会发苦。",
    "cue": "蒜片边缘金黄、油面冒小泡"
   },
   {
    "t": "放入干辣椒段炒 30 秒，让辣味溶进橄榄油。",
    "time": 1,
    "heat": "小火",
    "tip": "辣椒只需激发香气，别炒黑。",
    "cue": "辣椒转深红、油色带红"
   },
   {
    "t": "转中大火下虾仁，单面煎 2 分钟后翻面再煎 1 分钟。",
    "time": 4,
    "heat": "中大火",
    "tip": "虾仁一变红就翻面，久煎发柴。",
    "cue": "虾仁卷曲变红、表面微焦"
   },
   {
    "t": "撒 2g 盐与欧芹碎，挤入 30g 柠檬汁，连油一起盛入小碗。",
    "time": 2,
    "heat": "无火",
    "tip": "连油上桌，蘸面包最香。",
    "cue": "油汁清亮泛红、蒜香扑鼻"
   }
  ],
  "tips": [
   "橄榄油要够多，这道菜的汤汁就是油。",
   "蒜片小火煎到微黄就下虾，焦蒜会毁掉整锅。",
   "虾仁务必擦干，带水下锅会剧烈溅油。"
  ],
  "mistakes": [
   "大火煎蒜片，十秒就糊出苦味。",
   "虾仁煎过头，肉质发硬像橡皮。",
   "油放太少，变成干炒虾没有汤汁。"
  ],
  "subs": [
   {
    "orig": "虾仁",
    "sub": "鲜鱿鱼圈",
    "ratio": "400g 对 400g",
    "note": "煎制时间减 1 分钟。"
   },
   {
    "orig": "干辣椒",
    "sub": "辣椒粉",
    "ratio": "5g 对 3g",
    "note": "出锅前撒，香气更冲。"
   }
  ],
  "variations": [
   "白葡萄酒版：起锅前淋 20ml 白葡萄酒收汁。",
   "蘑菇版：加 100g 口蘑片同煎，做成素食版。"
  ],
  "serving": "配切片法棍蘸油汁，作为餐前小菜或下酒菜。",
  "storage": "冷藏 1 天，复热时小火加热 2 分钟，勿微波。",
  "nutrition": {
   "basis": "每份（约 240g）",
   "kcal": 420,
   "protein": 38,
   "fat": 28,
   "carbs": 4,
   "sodium": 640
  },
  "safety": [
   "虾属甲壳类，过敏人群请避开。",
   "煎制时油温较高，虾仁须擦干，避免热油飞溅烫伤。"
  ],
  "origin": "Gambas al ajillo 是西班牙酒吧里最常见的下酒小菜，橄榄油、蒜片与干辣椒在陶锅里滚沸，虾仁下去一变色就端上桌。剩下的油汁用面包蘸着吃，才是西班牙人的正经吃法。",
  "tags": [
   "西班牙菜",
   "前菜",
   "虾",
   "大蒜"
  ],
  "related": [
   "paella-verduras",
   "pollo-arrosto",
   "pico-de-gallo"
  ]
 },
 {
