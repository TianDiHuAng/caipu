    "steps": [
      {
        "t": "鸡腿肉斩成两厘米见方的带骨小块，用清水冲去血水后沥干。",
        "time": 15,
        "heat": "无火",
        "tip": "带骨斩块更香，块要大小一致。",
        "cue": "鸡块表面发白，没有血水渗出。"
      },
      {
        "t": "鸡块加盐、料酒与玉米淀粉抓匀，腌十五分钟。",
        "time": 15,
        "heat": "无火",
        "tip": "淀粉抓匀能锁住肉汁，炸出来更嫩。",
        "cue": "鸡块表面裹上一层薄浆。"
      },
      {
        "t": "干辣椒剪成段，抖去辣椒籽，花椒挑去杂质备用。",
        "time": 8,
        "heat": "无火",
        "tip": "辣椒籽炸糊会发苦，尽量抖干净。",
        "cue": "辣椒段红亮，籽基本清空。"
      },
      {
        "t": "锅里倒花生油烧到六成热，下鸡块炸至表面金黄捞出。",
        "time": 12,
        "heat": "大火",
        "tip": "鸡块下锅别急着翻，定型后再动。",
        "cue": "鸡块表面金黄，边缘微焦。"
      },
      {
        "t": "油温升高，鸡块回锅复炸四十秒，捞出沥油。",
        "time": 5,
        "heat": "大火",
        "tip": "复炸一次外壳才脆，里面还嫩。",
        "cue": "外皮起小泡，敲着发响。"
      },
      {
        "t": "锅留底油，下花椒与干辣椒小火煸出香味，再放蒜姜炒香。",
        "time": 6,
        "heat": "小火",
        "tip": "辣椒花椒要用小火，糊了整锅发苦。",
        "cue": "锅里红油浮起，香味冲鼻。"
      },
      {
        "t": "倒入鸡块与青椒段，转大火快速翻炒，加生抽与小葱段翻匀，淋香油出锅。",
        "time": 5,
        "heat": "大火",
        "tip": "最后大火快炒，让辣香挂上鸡块。",
        "cue": "鸡块红亮油润，辣椒铺满。"
      }
    ],
    "tips": [
      "仔鸡选一斤半左右的小公鸡，肉质嫩、骨头软。",
      "辣椒和花椒的比例按口味调，湖南本地多用朝天椒。",
      "复炸这一步别省，外壳酥、里面还带汁。"
    ],
    "mistakes": [
      "鸡块焯水再炸，肉质发柴，鲜味也流失。",
      "辣椒花椒大火干煸，糊味压过一切。"
    ],
    "subs": [
      {
