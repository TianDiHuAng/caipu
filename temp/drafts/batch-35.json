  ],
  "steps": [
   {
    "t": "鸡腿肉去皮切成入口大小的块，用少许鱼露抓匀腌十分钟去腥。",
    "time": 10,
    "heat": "无火",
    "tip": "去皮后汤不浮油，更清爽。",
    "cue": "鸡块均匀、表面微黏"
   },
   {
    "t": "南姜切薄片，香茅拍扁切段，柠檬叶撕碎，小米椒拍破备用。",
    "time": 5,
    "heat": "无火",
    "tip": "香茅拍扁香气才出得来。",
    "cue": "香料拍裂、香气散出"
   },
   {
    "t": "高汤与椰浆一起下锅，放入南姜、香茅与柠檬叶小火煮五分钟出香。",
    "time": 6,
    "heat": "小火",
    "tip": "椰浆别大火滚，会油水分离。",
    "cue": "汤色奶白、香料浮面"
   },
   {
    "t": "下鸡块与草菇小火煮十分钟，撇去浮沫，煮到鸡肉完全变白。",
    "time": 10,
    "heat": "小火",
    "tip": "保持微沸，鸡肉才嫩。",
    "cue": "鸡肉全白、草菇变软"
   },
   {
    "t": "加鱼露与白糖调味，关火后挤入青柠汁，撒小米椒与香菜。",
    "time": 4,
    "heat": "小火",
    "tip": "青柠汁关火后加，酸味才清。",
    "cue": "汤色乳白、酸辣扑鼻"
   }
  ],
  "tips": [
   "椰浆全程小火，滚沸会让油脂分离、汤面浮起絮状物。",
   "青柠汁一定要关火后再挤，加热过的酸味会发苦。",
   "南姜与香茅只取香气不吃，盛碗时挑出来更清爽。"
  ],
  "mistakes": [
   "椰浆大火滚开，汤变成油水分层的絮状。",
   "青柠汁跟材料一起下锅煮，酸味发闷带苦。",
   "用姜代替南姜，香气完全不同、汤味发冲。"
  ],
  "subs": [
   {
    "orig": "草菇",
    "sub": "口蘑",
    "ratio": "120g 对 120g",
    "note": "鲜味接近，口感更软。"
   },
   {
    "orig": "鸡腿肉",
    "sub": "虾",
    "ratio": "300g 对 300g",
    "note": "做成椰奶虾汤，煮制时间缩短到 5 分钟。"
   }
  ],
  "variations": [
   "海鲜版：加 150g 虾与 100g 鱿鱼，最后三分钟下锅。",
   "素食版：鸡腿换成 200g 老豆腐与 100g 杏鲍菇。"
  ],
  "serving": "盛进深碗，配一碗泰国香米饭，酸辣汤汁拌饭最下饭。",
  "storage": "冷藏可存 1 天，复热须小火并重新挤少许青柠汁。",
  "nutrition": {
   "basis": "每份（约 350g）",
   "kcal": 420,
   "protein": 24,
   "fat": 32,
   "carbs": 10,
   "sodium": 900
  },
  "safety": [
   "鱼露含鱼类成分，鱼类过敏人群请改用少量生抽调味。",
   "鸡肉须煮至中心完全变白、无血水。",
   "南姜与香茅纤维粗，幼儿食用前请挑出香料渣。"
  ],
  "origin": "椰奶鸡汤是泰国中部的经典汤品，南姜、香茅与柠檬叶三样香料撑起骨架，椰浆把酸辣裹得圆润，喝起来辛香却不呛喉，是泰国餐馆里点单率最高的一碗。",
  "tags": [
   "泰国菜",
   "汤品",
   "椰浆",
   "酸辣"
  ],
  "related": [
   "pad-thai",
   "som-tam",
   "thai-green-curry-chicken"
  ]
