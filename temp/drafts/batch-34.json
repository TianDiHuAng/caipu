  "steps": [
   {
    "t": "温牛奶化开酵母与盐，倒进过筛的高筋面粉里，揉成光滑柔软的面团。",
    "time": 15,
    "heat": "无火",
    "tip": "面团要比包子面软，粘手正常。",
    "cue": "面团光滑、按压回弹"
   },
   {
    "t": "盆上盖湿布放在温暖处发酵，等面团涨到两倍大、内部呈蜂窝状。",
    "time": 70,
    "heat": "无火",
    "tip": "冬天可放进关火的烤箱发酵。",
    "cue": "体积两倍、内部蜂窝"
   },
   {
    "t": "芝麻炒香压碎，与白糖、桂皮粉拌成馅料，尝一下甜度再微调。",
    "time": 8,
    "heat": "小火",
    "tip": "桂皮只要一点点，多了发苦。",
    "cue": "馅料均匀、香气扑鼻"
   },
   {
    "t": "手上抹油把面团分成八份，按扁包入一勺馅料，收口捏紧滚圆。",
    "time": 7,
    "heat": "无火",
    "tip": "收口一定捏死，否则糖汁会漏。",
    "cue": "面团滚圆、收口朝下"
   },
   {
    "t": "平底锅倒植物油，收口朝下放入面团，中小火按扁成圆饼煎到底部金黄。",
    "time": 10,
    "heat": "中小火",
    "tip": "下锅后用铲背压扁，越薄越脆。",
    "cue": "饼底金黄、边缘微鼓起"
   },
   {
    "t": "翻面再煎五分钟，听到滋滋糖汁声、饼身鼓起就出锅趁热吃。",
    "time": 10,
    "heat": "中小火",
    "tip": "糖汁极烫，咬开先吹一吹。",
    "cue": "两面金黄、饼身鼓胀"
   }
  ],
  "tips": [
   "面团要揉得比包子面更软，煎出来才有外脆内糯的口感。",
   "收口一定捏紧，糖汁漏出来会把饼煎成黑炭。",
   "趁热吃风味最好，凉了白糖会重新结晶。"
  ],
  "mistakes": [
   "面团偏硬，煎出的饼皮厚又韧，咬着费劲。",
   "馅包太多，一压就破、糖汁流满锅底。",
   "火开太大，外皮焦黑而里面还是生面团。"
  ],
  "subs": [
   {
    "orig": "桂皮",
    "sub": "肉桂粉",
    "ratio": "3g 对 3g",
    "note": "香气更浓，用量可减到 2g。"
   },
   {
    "orig": "牛奶",
    "sub": "清水",
    "ratio": "180ml 对 170ml",
    "note": "奶香变淡，需加 5g 糖补偿。"
   }
  ],
  "variations": [
   "坚果版：馅里加 30g 碎核桃与南瓜子。",
   "芝士版：馅中用 60g 马苏里拉替换一半白糖。"
  ],
  "serving": "出锅稍晾一分钟，配一杯热的大麦茶或牛奶。",
  "storage": "当天吃完最好，冷藏可存 2 天，复热用平底锅小火两面各煎一分钟。",
  "nutrition": {
   "basis": "每份（2 个，约 160g）",
   "kcal": 420,
   "protein": 9,
   "fat": 13,
   "carbs": 68,
   "sodium": 230
  },
  "safety": [
   "糖馅温度极高，咬开前务必吹凉，避免烫伤口腔。",
   "煎制时糖汁遇油易溅，翻面时用锅盖稍挡。",
   "面团含麸质，乳糜泻人群不宜食用。"
  ],
  "origin": "糖饼是韩国冬天的街头小吃，铁板上压得扁扁的面饼里包着红糖与肉桂，煎到鼓起时咬开一口，滚烫的糖汁顺着指缝往下淌，是很多人放学路上的记忆。",
  "tags": [
   "韩国菜",
   "面点",
