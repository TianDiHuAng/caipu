  "steps": [
   {
    "n": 1,
    "t": "卷心菜切成大片，豆角掐去两头切四厘米段，土豆去皮切滚刀块。",
    "time": 8,
    "heat": "无火",
    "tip": "豆角一定要掐掉筋，吃口才不塞牙。",
    "cue": "三种菜大小均匀分开装"
   },
   {
    "n": 2,
    "t": "炒锅放植物油烧热，下姜片和大蒜片小火爆出香味。",
    "time": 3,
    "heat": "小火",
    "tip": "姜蒜只需爆香，炒焦了整锅汤都发苦。",
    "cue": "蒜片金黄，香气升起来"
   },
   {
    "n": 3,
    "t": "倒入五百毫升清水大火烧开，先下土豆块煮五分钟。",
    "time": 7,
    "heat": "大火",
    "tip": "土豆最耐煮，先下它才不会一锅生熟不一。",
    "cue": "土豆边缘变钝，水滚不停"
   },
   {
    "n": 4,
    "t": "下豆角和卷心菜，中小火再煮八分钟到蔬菜变软。",
    "time": 8,
    "heat": "中火",
    "tip": "豆角必须煮到完全熟透，生豆角含毒素不能吃。",
    "cue": "豆角颜色转深发暗"
   },
   {
    "n": 5,
    "t": "倒入椰奶转小火，边倒边轻搅，让汤色变成乳白。",
    "time": 4,
    "heat": "小火",
    "tip": "椰奶一沸就分层，全程小火别让它滚起来。",
    "cue": "汤色乳白，表面浮薄油花"
   },
   {
    "n": 6,
    "t": "加盐和白糖调味，小火再温三分钟关火，静置五分钟上桌。",
    "time": 5,
    "heat": "小火",
    "tip": "静置几分钟味道才融进去，急着喝味寡淡。",
    "cue": "汤面平静，菜料沉底"
   }
  ],
  "tips": [
   "椰奶务必最后小火加入，滚沸会油水分离。",
   "豆角要煮到颜色全暗、彻底熟透才能出锅。",
   "姜蒜先爆香是印尼菜打底的固定动作。"
  ],
  "mistakes": [
   "椰奶大火滚开，汤面立刻浮起一层油。",
   "豆角没煮透，夹生还有生豆味。",
   "土豆和卷心菜同时下，菜烂了土豆还硬。"
  ],
  "subs": [
