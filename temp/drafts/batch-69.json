   {
    "t": "收汁到浓稠发亮，撒葱花关火装盘。",
    "time": 2,
    "heat": "中小火",
    "tip": "汁收到能挂住豆腐即停。",
    "cue": "豆腐油亮、盘底无多余汤汁"
   }
  ],
  "tips": [
