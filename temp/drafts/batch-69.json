     },
     {
      "n": "清水",
      "a": 1500,
      "u": "ml",
      "note": "煮汤用水"
     }
    ]
   }
  ],
  "equipment": [
   "汤锅",
   "菜刀",
   "漏勺"
  ],
  "steps": [
   {
    "t": "五花肉整块冷水下锅，加料酒、姜片与花椒，大火烧开后撇沫转小火煮四十分钟至七分熟。",
    "time": 40,
    "heat": "大火",
    "tip": "整块煮能让肉片切出来不散。",
    "cue": "肉块用筷子能插入但有阻力"
   },
   {
    "t": "捞出肉块晾到不烫手，切成两毫米厚的大薄片，原汤留着不要倒。",
    "time": 10,
    "heat": "无火",
    "tip": "肉要晾凉再切，热切会碎。",
    "cue": "肉片薄透、肥瘦相连不散"
   },
   {
    "t": "白萝卜去皮切成同样厚薄的片，葱切段备用。",
    "time": 8,
    "heat": "无火",
    "tip": "萝卜切薄一点，才好与肉片同熟。",
    "cue": "萝卜片均匀、不见粗块"
   },
   {
    "t": "原汤过筛倒回锅里烧开，下白萝卜片煮八分钟至半透明。",
    "time": 8,
    "heat": "大火",
    "tip": "原汤是这道菜的魂，别换成清水。",
    "cue": "萝卜片透亮、汤面微白"
   },
   {
    "t": "下肉片同煮三分钟，加盐调味，撒葱段关火；生抽单独装碟作蘸水。",
    "time": 3,
    "heat": "中小火",
    "tip": "肉片后下，久煮会老。",
    "cue": "肉片卷边、汤清而不浑浊"
   }
  ],
  "tips": [
   "煮肉的原汤撇净浮油后当汤底，鲜味全靠它。",
   "蘸碟里加一勺辣椒油和蒜末，川味更足。",
   "萝卜换成冬瓜或莴笋同样好吃。"
  ],
  "mistakes": [
   "肉煮全熟再切片，久煮之后又老又柴。",
   "把煮肉的原汤倒掉改用清水，汤寡淡无味。",
   "肉片切成厚方块，煮出来咬不动。"
  ],
  "subs": [
   {
    "orig": "五花肉",
    "sub": "猪后腿肉",
    "ratio": "400g 对 400g",
    "note": "腿肉更瘦，煮的时间缩短十分钟。"
   },
   {
    "orig": "白萝卜",
    "sub": "冬瓜",
    "ratio": "400g 对 400g",
    "note": "冬瓜易熟，下锅煮五分钟即可。"
   }
  ],
  "variations": [
   "加一把粉丝同煮，连汤带菜更顶饱。",
   "蘸碟换成蒜泥加酱油，口味更清爽。"
  ],
  "serving": "连汤带肉盛碗，肉片蘸着生抽吃，汤单喝。",
  "storage": "汤与肉分开放，冷藏两天，复热时加少量清水。",
  "nutrition": {
   "basis": "每份（约 350g）",
   "kcal": 380,
   "protein": 18,
   "fat": 30,
   "carbs": 8,
   "sodium": 780
  },
  "safety": [
   "五花肉必须煮至中心断生并切片后再煮透。",
   "原汤冷藏保存不超过两天，复热要彻底滚沸。",
   "处理生肉与切熟肉的刀板要分开使用。"
  ],
  "origin": "连锅汤是川西坝子上的家常汤菜，一整块五花肉在锅里煮熟切片，再与原汤、萝卜同煮，蘸着红油碟吃。因为肉和汤都出自同一口锅，所以叫连锅。冬天里围炉喝一碗，汤鲜肉嫩，浑身都暖。",
  "tags": [
   "川菜",
   "汤",
   "家常",
   "冬季"
  ],
  "related": [
   "sichuan-shuizhuroupian",
   "xuecai-datang-huangyu"
  ]
 },
 {
