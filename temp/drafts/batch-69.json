     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "生抽",
      "a": 10,
      "u": "ml",
      "note": "调味"
     },
     {
      "n": "盐",
      "a": 3,
      "u": "g",
