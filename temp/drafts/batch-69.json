     },
     {
      "n": "植物油",
      "a": 40,
      "u": "ml",
      "note": "炒蛋用油"
     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "打蛋碗",
   "筷子"
  ],
  "steps": [
   {
    "t": "鸡蛋磕进碗里加一克盐，用筷子充分打散到蛋液均匀起泡。",
    "time": 3,
    "heat": "无火",
    "tip": "蛋液打散要打到起小泡，炒出来才蓬松。",
    "cue": "蛋液均匀、表面有细密气泡"
   },
   {
    "t": "小米辣去蒂切圈，大蒜切片，葱切段备用。",
    "time": 4,
    "heat": "无火",
    "tip": "小米辣籽留一部分，辣味更冲。",
    "cue": "辣椒圈均匀、蒜片薄"
   },
   {
    "t": "炒锅烧热放一半植物油，倒入蛋液，待边缘凝固后用铲子推成大块盛出。",
    "time": 3,
    "heat": "中大火",
    "tip": "蛋液半凝就盛出，回锅才嫩。",
    "cue": "蛋块金黄蓬松、无焦边"
   },
   {
    "t": "锅里补剩下的油，下蒜片与小米辣小火煸出辣香。",
    "time": 2,
    "heat": "小火",
    "tip": "辣椒别炒糊，糊了发苦。",
    "cue": "辣椒转深红、辣香扑鼻"
   },
   {
    "t": "倒回蛋块，加生抽与剩下的盐，大火快速翻炒半分钟，撒葱段出锅。",
    "time": 1,
    "heat": "大火",
    "tip": "回锅只能快炒，久了蛋变硬。",
    "cue": "蛋块裹匀酱色、辣香浓"
   }
  ],
  "tips": [
   "蛋液里加一勺清水，炒出来更嫩滑。",
   "小米辣可换成青尖椒，辣味柔和些。",
   "用铁锅炒蛋前把锅烧透，不粘不糊。"
  ],
  "mistakes": [
   "蛋液不打散直接下锅，炒出来一坨坨不蓬松。",
   "鸡蛋炒到全熟才盛出，回锅后变得又干又硬。",
   "辣椒炒到发黑，整盘都带焦苦味。"
  ],
  "subs": [
   {
    "orig": "小米辣",
    "sub": "青尖椒",
    "ratio": "30g 对 50g",
    "note": "青椒水分多，煸的时间加半分钟。"
   },
   {
    "orig": "鸡蛋",
    "sub": "鸭蛋",
    "ratio": "4 个 对 4 个",
    "note": "鸭蛋腥味重，加两滴料酒去腥。"
   }
  ],
  "variations": [
   "加一勺剁椒同炒，酸辣开胃更像湘菜馆味道。",
   "放一把葱花在最后炒匀，葱香更突出。"
  ],
  "serving": "配白米饭最好，一勺辣椒炒蛋能拌下两碗饭。",
  "storage": "现炒现吃，冷藏后蛋块回硬，口感变差。",
  "nutrition": {
   "basis": "每份（约 160g）",
   "kcal": 300,
   "protein": 16,
   "fat": 25,
   "carbs": 4,
   "sodium": 700
  },
  "safety": [
   "鸡蛋必须炒至完全凝固，不要留流心部分。",
   "打蛋前洗净蛋壳表面，避免蛋壳脏物落入蛋液。",
   "炒制油温高，下辣椒时注意防止热油飞溅。"
  ],
  "origin": "湖南人把辣椒当菜吃，这道辣椒炒蛋是家家户户的应急菜。小米辣下锅一煸，辣气冲上来，再把炒得蓬松的蛋块倒回去兜匀，红黄相间，一口下去满嘴辣香，配白饭最是痛快。",
  "tags": [
   "湘菜",
   "家常",
   "快炒",
   "下饭"
  ],
  "related": [
   "hakka-sanbeiji",
   "hunan-zijiang-chao-ya"
  ]
 },
