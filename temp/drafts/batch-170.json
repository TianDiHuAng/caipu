  "steps": [
   {
    "n": 1,
    "t": "面条放进沸水锅里煮到八分熟，捞出沥干水分备用。",
    "time": 8,
    "heat": "大火",
    "tip": "面条煮到中心略硬就捞，后面还要进烤箱焗。",
    "cue": "面条弹牙，根根分开"
   },
   {
    "n": 2,
    "t": "蘑菇洗净切成薄片，炒锅放黄油中火炒到蘑菇出水变软。",
    "time": 6,
    "heat": "中火",
    "tip": "蘑菇先炒出水再收干，香气才浓郁不腥。",
    "cue": "蘑菇片软塌，锅底收干"
   },
   {
    "n": 3,
    "t": "撒入面粉不断翻炒成稠糊，慢慢倒入牛奶搅成顺滑白汁。",
    "time": 5,
    "heat": "小火",
    "tip": "牛奶分三次倒，边倒边搅才不会结块。",
    "cue": "白汁顺滑，不见颗粒"
   },
   {
    "n": 4,
    "t": "加入奶酪、盐和黑胡椒，小火搅到奶酪完全化开。",
    "time": 3,
    "heat": "小火",
    "tip": "奶酪小火慢慢化，大火会让白汁出油分离。",
    "cue": "酱汁浓稠，能挂住勺背"
   },
   {
    "n": 5,
    "t": "拌入面条、金枪鱼和蘑菇片，倒进烤盘抹平表面。",
    "time": 5,
    "heat": "无火",
    "tip": "金枪鱼先撕散再拌，块太大口感发柴。",
    "cue": "面糊均匀，盘面平整"
   },
   {
    "n": 6,
    "t": "表面撒满面包糠，烤箱一百八十度焗二十分钟到金黄。",
    "time": 20,
    "heat": "中火",
    "tip": "表面金黄冒泡就出炉，烤太久面条会干掉。",
    "cue": "表层金黄酥脆，内里冒泡"
   }
  ],
  "tips": [
   "面条煮八分熟就够，焗的时候还会继续变软。",
   "牛奶分次倒入白汁，酱汁才顺滑不结块。",
   "面包糠最后撒，烤出来才有脆壳。"
  ],
  "mistakes": [
