  "steps": [
   {
    "t": "河粉用手轻轻抖散，成条不结块，豆芽洗净沥干。",
    "time": 10,
    "heat": "无火",
    "tip": "河粉别用刀切，抖散才不会断成一截截。",
    "cue": "河粉根根分明，无粘连"
   },
   {
    "t": "生抽、鱼露、白糖与白胡椒放小碗调匀备用。",
    "time": 3,
    "heat": "无火",
    "tip": "酱汁提前调好，下锅时手不会乱。",
    "cue": "酱汁棕亮，糖已化开"
   },
   {
    "t": "炒锅烧到冒烟，下二十毫升植物油，倒入虾仁爆炒到卷曲变色。",
    "time": 3,
    "heat": "大火",
    "tip": "锅必须够热，这是锅气的全部来源。",
    "cue": "虾仁卷曲，边缘泛红"
   },
   {
    "t": "把虾仁推到一边，下蒜末与小米辣炒二十秒出香。",
    "time": 1,
    "heat": "大火",
    "tip": "蒜末别久炒，焦了整锅带苦。",
    "cue": "蒜末微黄，香气冲鼻"
   },
   {
    "t": "打入鸡蛋略凝后划散，与豆芽一起翻炒三十秒。",
    "time": 2,
    "heat": "大火",
    "tip": "鸡蛋半凝固时下河粉，最容易裹住。",
    "cue": "蛋花松软，豆芽挺立"
   },
   {
    "t": "倒入河粉与调好的酱汁，用锅铲快速翻推四十秒。",
    "time": 2,
    "heat": "大火",
    "tip": "河粉别翻炒过头，推几下就够，否则会断。",
    "cue": "河粉均匀上色，油亮"
   },
   {
    "t": "撒入剩余植物油沿锅边淋一圈，再快速颠锅十秒逼出焦香。",
    "time": 1,
    "heat": "大火",
    "tip": "最后那一勺油是焦香的关键，别省。",
    "cue": "锅边起烟，粉条边缘微焦"
   },
   {
    "t": "关火立刻装盘，趁热上桌，放久了粉条会出水发软。",
    "time": 1,
    "heat": "无火",
    "tip": "炒粿条上桌要冒热气，凉了就失了性格。",
    "cue": "盘中油亮，香气扑鼻"
   }
  ],
  "tips": [
   "河粉前一晚买好放冰箱，稍干爽更好炒不粘。",
   "火力全程最大，分次炒比一次堆满锅更好。",
   "没有血蛤可用虾仁替代，鲜味稍淡但更省事。"
  ],
  "mistakes": [
   "河粉没抖散直接下锅，粘成一大团。",
   "锅里堆太多一次炒，全部出水变成煮河粉。",
   "酱汁下太少，粉条发白没有颜色。"
  ],
  "subs": [
   {
    "orig": "虾仁",
    "sub": "鸡胸肉丝",
    "ratio": "180 克:180 克",
    "note": "不吃海鲜时替换，需先滑炒至变色。"
   },
   {
    "orig": "鱼露",
    "sub": "生抽",
    "ratio": "10 毫升:12 毫升",
    "note": "咸度接近，少了发酵鲜味。"
   }
  ],
  "variations": [
   "加血蛤与腊肠，是新加坡老摊的经典组合。",
   "用米粉代替河粉，做成炒米粉口感更细。"
  ],
  "serving": "装盘后配一碟辣椒酱和青柠角，加一杯冰镇甘蔗汁。",
  "storage": "现炒现吃风味最佳；冷藏一夜后须用大火快炒回热，别微波。",
  "nutrition": {
   "basis": "每份约 350 克",
   "kcal": 620,
   "protein": 28,
   "fat": 26,
   "carbs": 72,
   "sodium": 1360
  },
  "safety": [
   "虾仁须炒至完全不透明、质地变紧，中心温度七十四度以上；贝类过敏者须替换；鸡蛋须炒至完全凝固。"
  ],
  "origin": "新加坡小贩中心的招牌，锅烧到冒烟才下粉，虾仁、鸡蛋、豆芽和河粉在旺火里几十秒就出锅。好的粿条带着一股焦香，油亮不腻，配上辣椒与青柠，站在摊前几分钟就吃完一盘。",
  "tags": [
