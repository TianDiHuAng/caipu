   "面碗",
   "漏勺"
  ],
  "steps": [
   {
    "t": "碎米芽菜用清水漂洗 5 分钟，挤干水分后切成细末备用。",
    "time": 6,
    "heat": "无火",
    "tip": "芽菜偏咸，冲洗能去掉多余盐分。",
    "cue": "芽菜末松散不结团"
   },
   {
    "t": "炒锅不放油，小火把芽菜末慢慢炒干水分，炒到有干香时盛出。",
    "time": 5,
    "heat": "小火",
    "tip": "不放油干炒，芽菜才有脆香不回潮。",
    "cue": "芽菜发干、香气明显"
   },
   {
    "t": "锅中另下花生碎与熟白芝麻，小火焙到微微冒香后盛出放凉。",
    "time": 4,
    "heat": "小火",
    "tip": "花生碎极易糊，闻到香就关火。",
    "cue": "花生碎边缘微黄、芝麻跳动"
   },
   {
    "t": "汤锅水烧开，碱水面抖散下锅煮 2 分钟至刚断生。",
    "time": 4,
    "heat": "大火",
    "tip": "碱水面只煮断生，后面还要拌。",
    "cue": "面条浮起、掐断无白心"
   },
   {
    "t": "面条捞出甩干水分，趁热加植物油、生抽与盐拌匀抖散。",
    "time": 3,
    "heat": "无火",
    "tip": "甩干水分是不粘不坨的关键。",
    "cue": "面条根根松散发亮"
   },
   {
    "t": "面上铺芽菜末、辣椒粉、花生碎与芝麻，浇一勺烧到冒烟的热油，撒葱花拌开。",
    "time": 5,
    "heat": "无火",
    "tip": "热油泼辣椒粉时才出红亮油香。",
    "cue": "红油渗出、香气冲鼻"
   }
  ],
  "tips": [
   "面条煮好必须甩干水分，拌时才不坨。",
   "芽菜干炒去水分，吃起来才够脆香。",
   "热油要烧到微微冒烟，辣椒香气才炸得开。"
  ],
  "common_mistakes": [
   "面条带水下锅拌，成品黏成一坨。",
   "芽菜不洗直接下锅，整碗面咸到发苦。",
   "辣椒粉用温油泼，香味出不来只有生辣。"
  ],
  "subs": [
   {
    "orig": "碱水面",
    "sub": "细水面",
    "ratio": "300g 对 300g",
    "note": "细面易断，煮的时间减 30 秒。"
   },
   {
    "orig": "芽菜",
    "sub": "榨菜碎",
    "ratio": "40g 对 40g",
    "note": "榨菜更咸，需多漂洗一次。"
   }
  ],
  "variations": [
   "加肉臊版：拌面时加 60g 炒香的肉末，风味更足。",
   "全素版：省去生抽，用香菇粉提鲜。"
  ],
  "serving_suggestion": "拌好后立刻吃，面条放久会吸油发干。",
  "storage": "芽菜臊子可冷藏 3 天，面条现煮现拌。",
  "nutrition": {
   "basis": "每份（约 240g）",
   "kcal": 620,
   "protein": 16,
   "fat": 26,
   "carbs": 78,
   "sodium": 890
  },
  "safety": [
   "面条煮制需完全断生，避免半生的碱水面刺激肠胃。",
   "泼热油时油温极高，碗中不可有水，防止爆溅。",
   "花生属常见致敏食物，过敏者可换成瓜子仁。"
  ],
  "origin": "宜宾燃面得名于油重无水、点火即燃，用碎米芽菜、花生碎与红油把一碗干拌面做得香气逼人，是川南早餐摊上的招牌。",
  "tags": [
