     {
      "n": "冰糖",
      "a": 60,
      "u": "g",
      "note": "炒糖色与回甜"
     },
     {
      "n": "生抽",
      "a": 50,
      "u": "ml",
      "note": "主咸味"
     },
     {
      "n": "老抽",
      "a": 20,
      "u": "ml",
      "note": "上色"
     },
     {
      "n": "料酒",
      "a": 50,
      "u": "ml",
      "note": "去腥"
     },
     {
      "n": "盐",
      "a": 3,
      "u": "g",
      "note": "补底味"
     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "砂锅",
   "漏勺"
  ],
  "steps": [
   {
    "t": "排骨剁成 5cm 长段，用冷水浸泡 20 分钟逼出血水，中途换一次水。",
    "time": 20,
    "heat": "无火",
    "tip": "泡到水色变淡，腥味才去得干净。",
    "cue": "排骨发白、水色微粉"
   },
   {
    "t": "排骨冷水下锅，加姜片与料酒大火烧开，焯 8 分钟撇净浮沫后捞出冲净。",
    "time": 10,
    "heat": "大火",
    "tip": "冷水下锅才能把血沫带出来。",
    "cue": "浮沫成灰褐色、排骨紧实"
   },
   {
    "t": "炒锅放冰糖与 50ml 清水，小火慢慢熬到糖液变成枣红色。",
    "time": 8,
    "heat": "小火",
    "tip": "糖色熬到起小泡就该下肉，过火会苦。",
    "cue": "糖液枣红、表面细密小泡"
   },
   {
    "t": "下排骨中火翻炒，让每段都裹上糖色，再放葱段、姜片、八角、桂皮与香叶炒香。",
    "time": 5,
    "heat": "中火",
    "tip": "翻炒要快，糖色久炒会发黑。",
    "cue": "排骨表面红亮、香料出香"
   },
   {
    "t": "加生抽、老抽、料酒、盐与 700ml 清水，大火烧开后撇去浮沫。",
    "time": 5,
    "heat": "大火",
    "tip": "水量以刚没过排骨为准，别一次太多。",
    "cue": "汤汁沸腾、颜色深红"
   },
   {
    "t": "转小火加盖焖 60 分钟，中途翻动两次让咸甜味均匀渗入。",
    "time": 60,
    "heat": "小火",
    "tip": "小火慢焖，肉才酥而不脱骨。",
    "cue": "筷子能轻松插入肉层"
   },
   {
    "t": "开盖转中火收汁 10 分钟，边收边把汤汁淋在排骨上至油亮挂汁。",
    "time": 10,
    "heat": "中火",
    "tip": "收汁勤淋，成品才有镜面光泽。",
    "cue": "汤汁浓稠挂勺、排骨油亮"
   }
  ],
  "tips": [
   "冰糖炒糖色比老抽上色更透亮。",
   "焖制全程小火，排骨才酥而不散。",
   "收汁时勤淋汤汁，表面才有糖亮层。"
  ],
  "common_mistakes": [
   "糖色炒过火，成品带明显焦苦味。",
   "水加得太满，最后收汁时间不够、味道寡淡。",
   "大火焖煮，排骨脱骨散形、肉质发柴。"
  ],
  "subs": [
   {
    "orig": "排骨",
    "sub": "猪小排",
    "ratio": "1000g 对 1000g",
    "note": "小排更嫩，焖制时间减 10 分钟。"
   },
   {
    "orig": "冰糖",
    "sub": "白糖",
    "ratio": "60g 对 50g",
    "note": "白糖易焦，糖色时间缩短。"
   }
  ],
  "variations": [
   "酱香版：加 20g 黄豆酱同焖，咸鲜更浓。",
   "微辣版：加 3 个干辣椒同焖，甜中带辣。"
  ],
  "serving_suggestion": "趁热连汁浇在白米饭上，是无锡人最爱的吃法。",
  "storage": "冷藏 2 天，复热加少量清水小火蒸 10 分钟。",
  "nutrition": {
   "basis": "每份（约 250g）",
   "kcal": 680,
   "protein": 30,
   "fat": 46,
   "carbs": 24,
   "sodium": 980
  },
  "safety": [
   "排骨需焖至完全熟透，骨头周围不见血水。",
   "炒糖色温度极高，加水时用热水防爆溅。",
   "成品含糖较多，血糖异常者注意份量。"
  ],
  "origin": "无锡排骨是江南名菜，讲究甜出头、咸收口，用冰糖炒色再小火慢焖，红亮油润又骨酥肉烂，被称作无锡三凤桥的看家菜。",
  "tags": [
   "苏菜",
   "排骨",
   "甜咸",
   "宴客"
  ],
  "related": [
   "maoshi-hongshaorou",
   "bazi-rou",
   "zui-paigu"
  ]
