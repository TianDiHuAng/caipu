      "u": "g",
      "note": "助褐变"
     },
     {
      "n": "香草精",
      "a": 5,
      "u": "ml",
      "note": "增香"
     },
     {
      "n": "盐",
      "a": 1,
      "u": "g",
      "note": "提味"
     }
    ]
   }
  ],
  "steps": [
   {
    "n": 1,
    "t": "厚底锅倒入牛奶和白糖，中火加热并不断搅拌到糖完全化开。",
    "time": 8,
    "heat": "中火",
    "tip": "糖要先化开，不然容易在锅底结块。",
    "cue": "液体顺滑，无糖粒"
   },
   {
    "n": 2,
    "t": "加小苏打和盐搅匀，转小火保持微沸不再搅拌。",
    "time": 4,
    "heat": "小火",
    "tip": "小苏打让颜色变深，只要一点点就够。",
    "cue": "液面微沸，起细泡"
   },
   {
    "n": 3,
    "t": "小火慢熬八十分钟，每十分钟用木勺刮一次锅底。",
    "time": 80,
    "heat": "小火",
    "tip": "一定要刮底，糖奶沉底就会焦糊。",
    "cue": "颜色由白转浅棕"
   },
