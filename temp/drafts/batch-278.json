    "steps": [
      {
        "t": "腰果用清水泡二十分钟，与少量清水一起打成细腻的腰果糊备用。",
        "time": 8,
        "heat": "无火",
        "tip": "腰果糊打得越细，酱汁越顺滑。",
        "cue": "糊体乳白无颗粒。"
      },
      {
        "t": "鸡腿肉切块，用一半酸奶与姜黄抓匀，静置二十分钟。",
        "time": 7,
        "heat": "无火",
        "tip": "酸奶腌过的鸡肉更嫩，也不容易柴。",
        "cue": "鸡块裹上白色酸奶层。"
      },
      {
        "t": "锅里放酥油，下小豆蔻、桂皮与丁香小火炒出香味。",
