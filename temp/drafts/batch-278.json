        "heat": "小火",
        "tip": "整粒香料遇酥油才出香，别用大火。",
        "cue": "香料在油中轻响，气味浓郁。"
      },
      {
        "t": "加洋葱丝炒到金黄发甜，放姜末蒜末炒香后盛出一半洋葱备用。",
        "time": 8,
        "heat": "中火",
        "tip": "洋葱炒到金黄是 korma 的甜底，急不得。",
        "cue": "洋葱深黄发软，油色金黄。"
      },
      {
        "t": "放鸡块翻炒到表面变白，倒入腰果糊与清水，小火焖十五分钟。",
        "time": 8,
        "heat": "小火",
        "tip": "腰果糊下锅后要常搅，容易沉底糊锅。",
        "cue": "汤汁乳白浓稠，鸡块浮起。"
      },
      {
        "t": "加剩下的酸奶与盐调匀，小火再煮五分钟，注意别煮滚。",
        "time": 7,
        "heat": "小火",
        "tip": "酸奶要在小火下加，滚了会分层起絮。",
        "cue": "酱汁顺滑，无明显颗粒。"
      },
      {
        "t": "淋淡奶油，撒香菜碎，与预留的洋葱一起装盘。",
        "time": 5,
        "heat": "小火",
        "tip": "淡奶油关火前淋，久煮会出油。",
        "cue": "表面一层奶白，香菜点缀。"
      }
    ],
    "tips": [
      "腰果糊是 korma 的灵魂，用生腰果打出来最甜。",
      "酸奶要提前从冰箱取出回温，冷的下锅容易起絮。",
      "全程小火，酱汁只要微微冒泡就够。"
    ],
    "variations": [
      "莫卧儿宫廷版本会加藏红花与少量玫瑰水，颜色金黄、香气更雅，适合宴客。"
    ],
    "storage": "冷藏两天，复热时用小火加少量清水，边加热边搅。",
