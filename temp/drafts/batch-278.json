    "steps": [
      {
        "t": "鸡腿肉切成三厘米块，用盐与姜黄抓匀，静置十五分钟入味。",
        "time": 8,
        "heat": "无火",
        "tip": "腌够时间，鸡肉里面才有底味。",
        "cue": "鸡块表面裹上黄色薄粉。"
      },
      {
        "t": "锅烧热不放油，下黑胡椒与孜然小火炒到香味冒出，盛出碾成粗粉。",
        "time": 8,
        "heat": "小火",
        "tip": "香料干炒才出香，火大立刻焦苦。",
        "cue": "锅里飘起白烟，香料颜色加深。"
      },
      {
        "t": "倒入植物油，放咖喱叶与洋葱丝炒到洋葱边缘焦黄。",
        "time": 8,
        "heat": "中火",
        "tip": "咖喱叶遇油会噼啪响，先散开再下洋葱。",
        "cue": "咖喱叶卷曲变色，洋葱发软。"
      },
      {
        "t": "加姜末与蒜末炒香，放番茄丁炒成糊，撒辣椒粉炒匀。",
        "time": 8,
        "heat": "中火",
        "tip": "番茄炒到不流动，后面鸡肉才挂得住料。",
        "cue": "番茄化开，锅底浓稠。"
      },
      {
        "t": "下鸡块翻炒到表面变白，加入炒好的黑胡椒与孜然粉，翻匀裹料。",
        "time": 7,
        "heat": "中火",
        "tip": "鸡块要一块块铺开翻，堆在一起会出水。",
        "cue": "鸡块表面收紧，裹满香料。"
      },
      {
        "t": "加清水没过鸡块一半，盖锅小火焖十五分钟至鸡肉熟透。",
        "time": 7,
        "heat": "小火",
        "tip": "鸡腿肉带骨处最难熟，焖到能轻松扎透。",
        "cue": "汤汁浓稠，鸡块油亮。"
      },
      {
        "t": "撒椰蓉与香菜碎，大火收汁，尝咸淡后出锅。",
        "time": 5,
        "heat": "大火",
        "tip": "椰蓉最后放，久煮会发苦。",
        "cue": "盘底留一层浓汁，椰蓉点缀其上。"
      }
    ],
    "tips": [
      "黑胡椒现磨现炒，香气比瓶装胡椒粉高出一截。",
      "切蒂纳德风格讲究辣和香并重，黑胡椒不能省也不能减半。",
      "咖喱叶没有可以省略，但香气会少一层。"
    ],
    "variations": [
      "当地家庭会加一小勺茴香籽与黑胡椒同炒，香气更冲，适合配印度薄饼。"
    ],
    "storage": "冷藏两天，复热时加两勺清水小火翻热。",
