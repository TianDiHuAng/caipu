    "variations": [
      "换成苹果块做拔丝苹果，撒粉后炸两分钟即可，果香更足。",
      "喜欢坚果香可加二十克熟核桃碎同拌，口感层次更丰富。"
    ],
    "serving": "趁热上桌，筷子夹起一块往上一提，糖丝能拉出半米长，蘸凉水吃最脆。",
    "storage": "拔丝类必须现做现吃，凉后糖壳变硬；剩余的可加清水小火煮化成糖水，不要直接回锅复炸。",
    "nutrition": {
      "basis": "按三人份估算",
      "kcal": 320,
      "protein": 3,
      "fat": 12,
      "carbs": 50,
      "sodium": 20
