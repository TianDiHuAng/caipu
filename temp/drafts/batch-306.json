    "steps": [
      {
        "t": "山药削皮后切成三厘米长的滚刀块，泡在清水里防止表面氧化发黑。",
        "time": 10,
        "heat": "无火",
        "tip": "削皮时戴上一次性手套，黏液沾手会痒得难受。",
        "cue": "山药块大小接近，切面乳白"
      },
      {
        "t": "山药块捞出沥干，撒玉米淀粉抓匀，让每块都裹上一层薄粉。",
        "time": 5,
        "heat": "无火",
        "tip": "粉要薄，裹厚了炸出来发硬，糖也挂不住。",
        "cue": "山药表面干爽，看不见湿黏液"
      },
      {
        "t": "花生油烧到六成热，下山药块中火炸五分钟，捞出后升高油温复炸四十秒。",
        "time": 7,
        "heat": "中火",
        "tip": "复炸这一步用植物油，表皮才脆得起来，回软也慢。",
        "cue": "山药外皮金黄起脆，敲着有响声"
      },
      {
        "t": "另起干净炒锅，下白糖和三十毫升清水，小火慢慢熬到糖汁起小泡、颜色转浅琥珀。",
        "time": 4,
        "heat": "小火",
        "tip": "熬糖全程别搅，一晃锅就行，搅多了返砂结块。",
        "cue": "糖汁浅琥珀色，筷头挑起能拉细丝"
      },
      {
        "t": "倒入炸好的山药块快速翻匀，让糖汁裹满每块，撒熟白芝麻起锅装抹油的平盘。",
        "time": 2,
        "heat": "小火",
        "tip": "盘底先抹一层油，凉了才不会粘成一块。",
        "cue": "山药油亮挂糖，夹起能拉出长丝"
      }
    ],
    "tips": [
      "山药选铁棍山药，水分少、粉质足，炸完更糯。",
      "熬糖宁嫩不宁老，糖色再深一点就带苦味。",
      "上桌配一小碗凉开水，蘸一下再吃，糖丝遇冷即断，不粘牙。"
    ],
    "mistakes": [
      "糖熬到深褐色才下山药，整盘带焦苦味，孩子一口就吐。",
      "山药裹粉太厚，糖汁只在粉壳外面，夹起来整层脱落。",
      "起锅后在锅里多停了几十秒，糖凝成硬壳，拔不出丝。"
    ],
    "subs": [
      {
        "orig": "山药",
        "sub": "红薯",
        "ratio": "450克:450克",
        "note": "红薯切同样大小，炸的时间缩短一分钟。"
