      "a": 60,
      "u": "ml",
      "note": "煎制"
     },
     {
      "n": "辣椒酱",
      "a": 30,
      "u": "g",
      "note": "蘸食或同煎"
     },
     {
      "n": "生抽",
      "a": 10,
      "u": "ml",
      "note": "提鲜"
     },
     {
      "n": "盐",
      "a": 1,
      "u": "g",
      "note": "少量补味"
     }
    ]
   }
  ],
  "equipment": [
   "平底锅",
   "锅铲",
   "厨房纸"
  ],
  "steps": [
   {
    "t": "毛豆腐用厨房纸轻轻吸干表面水分，切成 4cm 见方的方块。",
    "time": 6,
    "heat": "无火",
    "tip": "别用力压，白毛压塌就不好煎。",
    "cue": "豆腐块完整、表面干爽"
   },
   {
    "t": "平底锅倒 60ml 植物油烧至五成热，摆入毛豆腐中小火慢煎。",
    "time": 8,
    "heat": "中火",
    "tip": "一块块摆开，留缝隙才煎得透。",
    "cue": "底面结壳、边缘微黄"
   },
   {
    "t": "煎至两面金黄起脆壳，沿锅边淋入生抽让味道渗进去。",
    "time": 2,
    "heat": "中火",
    "tip": "沿锅边淋，酱香才被激出来。",
    "cue": "两面金黄、酱色均匀"
   },
   {
    "t": "加辣椒酱、蒜末与盐翻匀，撒小葱后立刻出锅装盘。",
    "time": 5,
    "heat": "大火",
    "tip": "蒜末最后放，香味才冲。",
    "cue": "酱料裹匀、葱花翠绿"
   }
  ],
  "tips": [
   "毛豆腐表面水分吸干，煎时才不粘锅。",
   "中小火慢煎，外脆里嫩才对味。",
   "辣椒酱按口味增减，蘸着吃也很香。"
  ],
  "mistakes": [
   "油温过高下锅，外壳焦了里面还凉。",
   "频繁翻动豆腐块，表面碎成一团。",
   "毛豆腐久放不煎，白毛塌软发酸。"
  ],
  "subs": [
   {
    "orig": "毛豆腐",
    "sub": "臭豆腐",
    "ratio": "400g 对 400g",
    "note": "气味更冲，煎制时间略短。"
   },
   {
    "orig": "辣椒酱",
    "sub": "豆瓣酱",
    "ratio": "30g 对 25g",
    "note": "豆瓣酱更咸，盐可省。"
   }
  ],
  "variations": [
   "红烧版：煎好后加 100ml 清水与生抽小火焖 3 分钟。",
   "铁板版：改用铁板煎，边缘更焦香。"
  ],
  "serving": "趁热上桌，配一小碟辣椒酱蘸食，外脆内嫩。",
  "storage": "冷藏 3 天，复热用平底锅小火煎 3 分钟恢复脆壳。",
  "nutrition": {
   "basis": "每份（约 150g）",
   "kcal": 270,
   "protein": 14,
   "fat": 19,
   "carbs": 9,
   "sodium": 610
  },
  "safety": [
   "毛豆腐属发酵豆制品，须彻底煎熟后再食用。",
   "表面出现黑绿霉斑或异味时应丢弃，不可食用。",
   "豆制品为常见过敏原，过敏人群慎食。",
   "煎制时油温较高，注意避免热油溅伤。"
  ],
  "origin": "徽州毛豆腐是安徽人家门口的吃食，豆腐发酵长出细白绒毛，下锅一煎外皮焦脆、内里绵软，配辣椒酱吃最有徽州味道。",
  "tags": [
   "徽菜",
   "发酵",
   "豆腐",
   "小吃"
  ],
  "related": [
   "chou-guiyu",
   "jiachang-doufu",
   "mapo-doufu"
  ]
 },
 {
  "id": "shacha-jiang",
  "zh": "沙茶酱",
  "en": "Shacha Sauce",
  "cuisine": "fujian",
