     },
     {
      "n": "小葱",
      "a": 10,
      "u": "g",
      "note": "切葱花"
     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "盐",
      "a": 3,
      "u": "g",
      "note": "火腿有咸味，少放"
     }
    ]
   }
  ],
  "equipment": [
   "砂锅",
   "汤勺",
   "漏勺"
  ],
  "steps": [
   {
    "t": "春笋剥去外壳，削掉根部老硬部分，切成大小均匀的滚刀块。",
    "time": 10,
    "heat": "无火",
    "tip": "笋根老硬部分要去净，否则汤发苦。",
    "cue": "笋块大小一致、断面白净"
   },
   {
    "t": "春笋冷水下锅焯 5 分钟，捞出用清水冲净涩味。",
    "time": 6,
    "heat": "大火",
    "tip": "冷水下锅焯，涩味才能跟着水走。",
    "cue": "笋块微透、闻着不冲鼻"
   },
   {
    "t": "火腿切成薄片，姜切片，小葱切成葱花备用。",
    "time": 4,
    "heat": "无火",
    "tip": "火腿片切薄些，味道出得快。",
    "cue": "火腿片薄而均匀"
   },
   {
    "t": "砂锅放鸡汤与清水、姜片烧开，下火腿转小火煮 20 分钟出味。",
    "time": 22,
    "heat": "小火",
    "tip": "火腿先煮出鲜味，汤底才厚。",
    "cue": "汤色微黄、火腿香味散出"
   },
   {
    "t": "下春笋小火炖 10 分钟，加盐调味，撒小葱即可上桌。",
    "time": 12,
    "heat": "小火",
    "tip": "盐最后放，笋的清香才不被盖。",
    "cue": "汤清见底、笋块嫩黄"
   }
  ],
  "tips": [
   "笋块焯水去涩，这一步省不得。",
   "火腿先煮出味再下笋，汤更鲜。",
   "盐要最后放，鲜味才不被咸味压住。"
  ],
  "mistakes": [
   "春笋没焯水直接煮，汤发涩发苦。",
   "全程大火猛煮，汤色浑白不清。",
   "盐放得太早，笋的清甜全被盖住。"
  ],
  "subs": [
   {
    "orig": "春笋",
    "sub": "冬笋",
    "ratio": "400g 对 400g",
    "note": "冬笋更紧实，需多炖 5 分钟。"
   },
   {
    "orig": "鸡汤",
    "sub": "清水",
    "ratio": "500ml 对 500ml",
    "note": "鲜味稍淡，可加 2g 盐补味。"
   }
  ],
  "variations": [
   "火腿换咸肉：咸度更高，盐可省去。",
   "加百叶结：出锅前 5 分钟加 100g 百叶结，口感更丰富。"
  ],
  "serving": "趁热连汤带笋盛入汤碗，饭前喝一碗最开胃。",
  "storage": "冷藏 2 天，复热小火煮开即可，笋久放会变酸。",
  "nutrition": {
   "basis": "每份（约 300g）",
   "kcal": 120,
   "protein": 9,
   "fat": 6,
   "carbs": 8,
   "sodium": 720
  },
  "safety": [
   "春笋含草酸，焯水后再煮更易消化。",
   "火腿本身偏咸，高血压人群需控量。",
   "汤品复热须彻底煮开，避免久置变质。"
  ],
  "origin": "问政山笋汤是徽州名汤，取自歙县问政山的春笋，笋嫩如水梨，配火腿与鸡汤慢炖，汤清味鲜，是徽菜里最见功力的一道清汤。",
  "tags": [
   "徽菜",
   "汤品",
   "春笋",
   "清鲜"
  ],
  "related": [
   "yandu-xian",
   "chou-guiyu",
   "shizitou"
  ]
 },
 {
