     },
     {
      "n": "大蒜",
      "a": 30,
      "u": "g",
      "note": "切末"
     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "植物油",
      "a": 150,
      "u": "ml",
      "note": "炸料与浸油"
     },
     {
      "n": "辣椒粉",
      "a": 15,
      "u": "g",
      "note": "粗辣椒粉"
     },
     {
      "n": "盐",
      "a": 5,
      "u": "g",
      "note": "调味"
     },
     {
      "n": "清水",
      "a": 100,
      "u": "ml",
      "note": "泡虾米"
     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "料理机",
   "玻璃瓶",
   "木铲"
  ],
  "steps": [
   {
    "t": "虾米用清水泡 15 分钟至回软，捞出沥干后剁成细碎。",
    "time": 15,
    "heat": "无火",
    "tip": "泡透的虾米剁起来才不出硬粒。",
    "cue": "虾米回软、剁成细末"
   },
   {
    "t": "花生用小火干锅炒香，搓去红衣后压成粗碎粒。",
    "time": 8,
    "heat": "小火",
    "tip": "小火慢炒，花生才不糊。",
    "cue": "花生微黄、香气散出"
   },
   {
    "t": "洋葱与大蒜分别切末，洋葱末尽量切细。",
    "time": 5,
    "heat": "无火",
    "tip": "洋葱切细，炸时才不夹生。",
    "cue": "洋葱末细匀、蒜末松散"
   },
   {
    "t": "炒锅倒 150ml 植物油，小火把洋葱末炸至金黄酥香。",
    "time": 12,
    "heat": "小火",
    "tip": "油温别高，洋葱才慢慢吐香。",
    "cue": "洋葱浮起、色转金黄"
   },
   {
    "t": "下虾米碎与花生碎继续小火翻炒 8 分钟出香。",
    "time": 8,
    "heat": "小火",
    "tip": "全程小火，糊一点整锅就苦。",
    "cue": "锅中油色变深、香味浓"
   },
   {
    "t": "加辣椒粉与盐炒匀，晾凉后装瓶，表面封一层油。",
    "time": 5,
    "heat": "小火",
    "tip": "封一层油能防氧化变质。",
    "cue": "酱体油润、颜色红褐"
   }
  ],
  "tips": [
   "全程小火，任何一步炒糊都会发苦。",
   "洋葱要炸到金黄，甜味才出得来。",
   "装瓶后封一层油，冷藏能放一个月。"
  ],
  "mistakes": [
   "大火快炒导致花生与虾米焦黑发苦。",
   "洋葱没炸透就下辣椒粉，酱有生味。",
   "装瓶前没晾凉，水汽让酱很快变质。"
  ],
  "subs": [
   {
    "orig": "虾米",
    "sub": "干贝",
    "ratio": "50g 对 50g",
    "note": "干贝需提前泡软撕丝。"
   },
   {
    "orig": "花生",
    "sub": "腰果",
    "ratio": "150g 对 150g",
    "note": "腰果更甜，盐可减 1g。"
   }
  ],
  "variations": [
   "潮汕版：加 10g 五香粉与 5g 陈皮末，风味更厚。",
   "减辣版：辣椒粉减到 5g，适合拌面。"
  ],
  "serving": "可作火锅蘸料，也可拌面、炒芥蓝，鲜辣咸香。",
  "storage": "装瓶冷藏可存 1 个月，每次用干净勺子取用。",
  "nutrition": {
   "basis": "每份（约 40g）",
   "kcal": 230,
   "protein": 6,
   "fat": 20,
   "carbs": 7,
   "sodium": 380
  },
  "safety": [
   "花生为常见过敏原，过敏人群禁用。",
   "油炸过程温度高，注意避免热油溅伤。",
   "自制酱料不含防腐剂，开封后需冷藏并尽快用完。",
   "虾类为常见过敏原，对海鲜过敏者慎食。"
  ],
  "origin": "沙茶酱源自福建的沙茶，由南洋沙嗲演变而来，花生与虾米打底、辣椒提味，闽南人拿它蘸牛肉、拌面条，浓香里带一点海味。",
  "tags": [
   "闽菜",
   "酱料",
   "花生",
   "蘸料"
  ],
  "related": [
   "maoxuewang",
   "chijiao-niurou",
   "siyou-ji"
  ]
 }
