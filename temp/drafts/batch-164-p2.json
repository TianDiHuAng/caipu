  "steps": [
   {
    "n": 1,
    "t": "香干切成两毫米厚的薄片，青椒去籽切片备用。",
    "time": 5,
    "heat": "无火",
    "tip": "香干切薄些，炒完才不老不硬。",
    "cue": "香干片薄而匀，边缘平整"
   },
   {
    "n": 2,
    "t": "五花肉切薄片，姜切丝，蒜切片，剁椒装小碗待用。",
    "time": 5,
    "heat": "无火",
    "tip": "肉片薄一点，煸出油才香。",
    "cue": "肉片薄透，肥瘦分明"
   },
   {
    "n": 3,
    "t": "炒锅烧热下五花肉片，中小火煸到出油卷边。",
    "time": 3,
    "heat": "中火",
    "tip": "煸出猪油再下香干，香气才足。",
    "cue": "肉片微卷，锅底汪着清油"
   },
   {
    "n": 4,
    "t": "下姜蒜和剁椒炒出香味，烹黄酒翻匀。",
    "time": 2,
    "heat": "中火",
    "tip": "剁椒炒出红油，辣味才够正。",
    "cue": "锅里泛红油，辣香扑鼻"
   },
   {
    "n": 5,
    "t": "倒入香干片大火翻炒，加生抽和清水略焖入味。",
    "time": 3,
    "heat": "大火",
    "tip": "香干易吸水，加点水焖才嫩。",
    "cue": "香干片吸汁变深，锅底微干"
   },
   {
    "n": 6,
    "t": "放入青椒片同炒，加盐炒匀，青椒断生立刻出锅。",
    "time": 2,
    "heat": "大火",
    "tip": "青椒最后下，脆度和颜色都好看。",
    "cue": "青椒翠绿，香干油亮"
   }
  ],
  "tips": [
   "香干要切薄，炒出来才不干硬。",
   "先煸五花肉出油，等于多了猪油香。",
   "青椒最后下锅，脆绿不出水。"
  ],
  "mistakes": [
   "香干切太厚，炒完咬着像木片。",
   "全程大火干炒不加水，香干发柴。",
   "青椒早下锅炒久，颜色发黄出水。"
  ],
  "subs": [
