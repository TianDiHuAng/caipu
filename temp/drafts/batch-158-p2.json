      "note": "提味"
     }
    ]
   }
  ],
  "steps": [
   {
    "n": 1,
    "t": "椰糖用刀背敲碎再切成小粒，方便包进糯米团里。",
    "time": 5,
    "heat": "无火",
    "tip": "椰糖块别太大，煮的时候才容易化开。",
    "cue": "糖粒大小均匀，切口平整"
   },
   {
    "n": 2,
    "t": "糯米粉倒进大碗，分次加清水揉成不粘手的面团。",
    "time": 6,
    "heat": "无火",
    "tip": "水要一点点加，面团太湿就补糯米粉。",
    "cue": "面团光滑，按压不留裂口"
   },
   {
    "n": 3,
    "t": "揪一小块面团按成小窝，放一颗椰糖粒再收口搓圆。",
    "time": 8,
    "heat": "无火",
    "tip": "收口一定捏紧，煮的时候糖才不会漏。",
    "cue": "小球表面光滑无裂缝"
   },
   {
    "n": 4,
    "t": "汤锅烧开一锅清水，把糯米球逐个下锅轻推。",
    "time": 3,
    "heat": "大火",
    "tip": "下锅后轻推锅底，防粘也防变形。",
    "cue": "糯米球沉在锅底打转"
   },
   {
    "n": 5,
    "t": "煮到糯米球全部浮起再煮两分钟，用漏勺捞出。",
    "time": 4,
    "heat": "中火",
    "tip": "浮起说明定型，再多煮两分钟内心才熟。",
    "cue": "小球浮起，个头胀大"
   },
   {
    "n": 6,
    "t": "椰蓉加盐拌匀蒸三分钟，趁热把糯米球滚上椰蓉。",
    "time": 5,
    "heat": "中火",
    "tip": "椰蓉蒸过更湿润，裹得均匀也不干喉。",
    "cue": "表面挂满白色椰蓉"
   }
  ],
  "tips": [
   "椰糖敲成小粒，包的时候才不会顶破面皮。",
   "收口要捏紧，否则煮的时候糖全漏进锅里。",
   "椰蓉先蒸三分钟，裹得更服帖也不干喉。"
  ],
  "mistakes": [
   "面团加水太多，搓球时粘手搓不成形。",
   "收口没捏紧，煮出来变成一锅甜汤。",
   "椰蓉不蒸直接干裹，吃起来满口都是粉末。"
  ],
  "subs": [
   {
    "orig": "椰糖",
    "sub": "红糖",
    "ratio": "100 克:100 克",
    "note": "颜色相近，少了椰香。"
   },
   {
    "orig": "椰蓉",
    "sub": "熟黄豆粉",
    "ratio": "100 克:100 克",
    "note": "更干爽，豆香突出。"
   }
  ],
  "variations": [
   "和面时加两滴斑斓汁，颜色和香气更东南亚。",
   "内馅换成黑芝麻糖，香味更浓口感更香。"
  ],
  "serving": "趁温热吃口感最好，配一杯无糖茶解甜。",
  "storage": "冷藏两天，复热时蒸三分钟回软。",
  "nutrition": {
   "basis": "每份约 130 克",
   "kcal": 330,
   "protein": 4,
   "fat": 9,
   "carbs": 58,
   "sodium": 130
  },
  "safety": [
   "含椰制品，过敏者须谨慎；糯米球须煮至完全浮起再煮两分钟确保内心熟透；糯米制品冷藏两天内吃完。"
  ],
  "origin": "爪哇岛的传统甜点，用糯米粉包进椰糖做成小球，煮熟后滚上椰蓉，咬开一口糖浆流出，是市集上最常见的点心。",
  "tags": [
   "印尼",
   "甜点",
   "糯米",
   "椰蓉"
  ],
  "overwrite": true
