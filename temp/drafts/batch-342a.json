    "sub": "羊油",
    "ratio": "80毫升:70毫升",
    "note": "羊油版香味更浓，是传统做法，量要略减。"
   },
   {
    "orig": "花椒",
    "sub": "黑胡椒",
    "ratio": "2克:2克",
    "note": "黑胡椒更清亮，用量相同即可。"
   }
  ],
  "variations": [
   "卷的时候撒一层切碎的洋葱，蒸出来带葱香。",
   "把盐换成糖做成甜油塔，配咸奶茶也很对味。"
  ],
  "serving": "掰开撕成层片，配一碗咸奶茶或者羊肉汤。",
  "storage": "冷藏两天，复蒸五分钟回软；不建议冷冻，层次会压塌。",
  "nutrition": {
   "basis": "按四人份估算",
   "kcal": 520,
   "protein": 13,
   "fat": 18,
   "carbs": 74,
   "sodium": 680
  },
  "diet": [
   "vegan",
