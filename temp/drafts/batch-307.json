    "steps": [
      {
        "t": "嫩豆腐切成两厘米厚的长方块，再对角切成三角块，用厨房纸吸干表面水分。",
        "time": 10,
        "heat": "无火",
        "tip": "豆腐表面吸得越干，煎的时候就越不容易粘锅。",
        "cue": "豆腐块边缘齐整，表面干爽"
      },
      {
        "t": "猪肉末加香菇丁、姜末、料酒、生抽、盐和白胡椒粉顺一个方向搅打到上劲。",
        "time": 6,
        "heat": "无火",
        "tip": "始终顺同一个方向搅，肉馅才抱团不出水。",
        "cue": "肉馅黏稠发亮，能粘住盆壁"
      },
      {
        "t": "每块豆腐的斜边中间挖一个小坑，撒一点玉米淀粉，填入肉馅压实抹平。",
        "time": 8,
        "heat": "无火",
        "tip": "坑里撒淀粉是粘合剂，煎时肉馅才不掉。",
        "cue": "肉馅填得饱满，与豆腐面齐平"
      },
      {
        "t": "花生油烧到六成热，肉馅朝下摆入锅中，中火煎三分钟至肉面金黄定型。",
        "time": 4,
        "heat": "中火",
        "tip": "坑里撒的那层淀粉是粘合剂，煎的时候肉馅才不会掉。",
        "cue": "肉面结壳焦黄，边缘微微收缩"
      },
      {
        "t": "翻面煎另一边两分钟，倒入鸡汤烧开，转小火焖八分钟让豆腐吃进汤汁。",
        "time": 11,
        "heat": "小火",
        "tip": "先煎有肉的一面再煎豆腐面，肉馅才不容易散。",
        "cue": "汤汁微沸，豆腐块微微鼓起"
      },
      {
        "t": "玉米淀粉加水调匀淋入勾薄芡，撒小葱末起锅装盘。",
        "time": 2,
        "heat": "中火",
        "tip": "芡一定要薄，能挂住豆腐表面就够，厚了整盘发糊。",
        "cue": "汤汁透亮微稠，豆腐完整不散"
      }
    ],
    "tips": [
      "豆腐选稍老一点的嫩豆腐，太嫩挖坑时容易塌。",
      "肉馅别填太满，煎的时候会缩，鼓出来就不好看。",
      "剩下的肉馅可以团成小丸子同焖，一点不浪费。"
    ],
    "mistakes": [
      "豆腐没吸干水就下锅，油花四溅还粘掉一层皮。",
      "坑里不撒淀粉，肉馅煎完整块脱落，只剩空豆腐。",
      "焖的时候大火翻滚，豆腐块碎成一锅豆花。"
