    "steps": [
      {
        "t": "绿豆芽掐去根须洗净沥干，菠菜和韭黄切成四厘米长的段备用。",
        "time": 8,
        "heat": "无火",
        "tip": "豆芽根须不掐净，嚼起来满口粗渣，卖相也差。",
        "cue": "豆芽根净身白，菜段长短一致"
      },
      {
        "t": "木耳用温水泡发后切细丝，猪里脊切成同粗细的丝，加料酒抓匀。",
        "time": 5,
        "heat": "无火",
        "tip": "猪里脊丝上浆前先抓料酒，去腥又保水。",
        "cue": "肉丝干爽不粘连，木耳丝乌黑"
      },
      {
        "t": "鸡蛋打散，炒锅刷薄油摊成薄蛋皮，晾凉后切成细丝备用。",
        "time": 3,
        "heat": "小火",
        "tip": "蛋皮摊薄才切得成丝，厚了就成蛋块。",
        "cue": "蛋皮浅黄透亮，切丝不断"
      },
      {
        "t": "花生油烧到六成热，下猪里脊丝快速滑散，变色即盛出。",
        "time": 2,
        "heat": "中火",
        "tip": "肉丝下锅别急着翻，等底部定型再滑开。",
        "cue": "肉丝根根分明，色白发亮"
      },
      {
        "t": "原锅下大蒜片和小葱段爆香，先放木耳丝和绿豆芽大火翻炒一分钟。",
        "time": 2,
        "heat": "大火",
        "tip": "豆芽必须大火快炒，小火只会炒出水。",
        "cue": "豆芽挺立透亮，锅底不见汤水"
      },
      {
        "t": "下菠菜段、韭黄段和蛋皮丝，加生抽、盐和香醋翻匀，倒回肉丝炒匀出锅。",
        "time": 3,
        "heat": "大火",
        "tip": "韭黄最后下锅，多炒十秒就会发黄发软。",
        "cue": "菜色青黄分明，盘底干爽"
      }
    ],
    "tips": [
      "合菜讲究旺火快炒，全程不超过五分钟，菜才有脆劲。",
      "豆芽先干锅煸十秒再放油，出水少、更脆口。",
      "用春饼卷着吃是老济南立春的吃法，菜要炒得干一些。"
    ],
    "mistakes": [
      "豆芽下锅小火慢炒，出一盘水，菜全泡软了。",
      "肉丝和蔬菜一起下锅，肉老菜烂，两头不讨好。",
      "韭黄早下锅，出锅时已经黄软，香气也跑了。"
    ],
    "subs": [
      {
        "orig": "韭黄",
        "sub": "韭菜",
        "ratio": "80克:80克",
        "note": "韭菜味更冲，下锅时间再缩短十秒。"
      },
      {
        "orig": "猪里脊",
        "sub": "鸡胸肉",
        "ratio": "100克:100克",
        "note": "鸡胸肉切丝后加淀粉抓匀，滑油时间减半。"
      }
    ],
    "variations": [
      "加五十克泡软的粉丝同炒，卷饼时更顶饱。",
      "素版本去掉肉丝，加一把金针菇，鲜味也够。"
    ],
    "serving": "趁热装盘，配春饼或单饼卷食，也可以直接配米饭，清爽解腻。",
    "storage": "现炒现吃最好，冷藏不超过一天；复热用大火快翻三十秒，久加热蔬菜会出水发黄。",
    "nutrition": {
      "basis": "按三人份估算",
      "kcal": 210,
      "protein": 15,
      "fat": 13,
      "carbs": 9,
      "sodium": 720
    },
    "diet": [
      "high-protein",
      "dairy-free"
    ],
    "tags": [
      "鲁菜",
      "素菜",
      "豆芽",
      "快炒"
    ],
    "safety": [
      "豆芽属易腐食材，须充分加热至断生透亮，不要生食或半生食用。",
      "炒制用旺火，下锅前把菜沥干水分，避免热油遇水飞溅。"
    ],
    "origin": "炒合菜是山东立春的应节菜，豆芽、菠菜、韭黄凑成早春的鲜，再添肉丝和蛋皮补足荤香。老济南人家立春这天必摊春饼，把合菜卷起来从头吃到尾，取个有头有尾的吉利。菜要炒得干爽，卷饼时才不漏汤。"
  },
