  "steps": [
   {
    "n": 1,
    "t": "四季豆掐掉两头撕去筋，折成五厘米长的段，洗净沥干。",
    "time": 8,
    "heat": "无火",
    "tip": "筋一定要撕干净，不然吃起来满口粗纤维。",
    "cue": "豆段整齐，表面干爽"
   },
   {
    "n": 2,
    "t": "汤锅烧开水，放四季豆焯四分钟，捞出过凉沥干。",
    "time": 5,
    "heat": "大火",
    "tip": "先焯到断生，烤的时候才不会干硬发青。",
    "cue": "豆段深绿发亮，掐得动"
   },
   {
    "n": 3,
    "t": "蘑菇切成薄片，洋葱切成细小的碎丁分别装碗备用。",
    "time": 5,
    "heat": "无火",
    "tip": "蘑菇片切薄些，炒出来才容易出香。",
    "cue": "蘑片均匀，洋葱丁细小"
   },
   {
    "n": 4,
    "t": "炒锅放黄油化开，下洋葱和蘑菇中火炒到变软出香。",
    "time": 6,
    "heat": "中火",
    "tip": "蘑菇先炒出水再炒干，香味才浓郁不水。",
    "cue": "洋葱透明，蘑菇片收缩"
   },
   {
    "n": 5,
    "t": "撒入面粉不停翻炒一分钟，倒牛奶搅成浓稠白汁。",
    "time": 5,
    "heat": "小火",
    "tip": "面粉要炒散再倒奶，一次倒进去容易结疙瘩。",
    "cue": "白汁稠滑，能裹住铲背"
   },
   {
    "n": 6,
    "t": "加盐和黑胡椒调味，倒入四季豆翻拌到每根都裹上白汁。",
    "time": 3,
    "heat": "小火",
    "tip": "豆段下锅轻拌，别用力压免得拌烂。",
    "cue": "豆段裹满白汁，稠而不干"
   },
   {
    "n": 7,
    "t": "装进烤盘撒上奶酪和面包糠，淋植物油后烤十八分钟。",
    "time": 18,
    "heat": "中火",
    "tip": "表面撒料要盖满，烤出来才有一层脆壳。",
    "cue": "表层金黄起泡，香气扑鼻"
   }
  ],
  "tips": [
   "四季豆先焯断生再烤，口感才嫩不夹生。",
   "白汁宁稠不稀，烤过之后还会再收干。",
   "面包糠和奶酪最后撒，厚度均匀才起脆壳。"
  ],
  "mistakes": [
   "四季豆不焯直接烤，豆角发硬还带生青味。",
   "白汁调得太稀，烤完盘底全是汤水。",
   "奶酪撒得太薄，表面烤不出金黄脆壳。"
  ],
  "subs": [
   {
    "orig": "四季豆",
    "sub": "青豆",
    "ratio": "700 克:650 克",
    "note": "无需焯水，直接入白汁同烤。"
   },
   {
    "orig": "牛奶",
    "sub": "淡奶油",
    "ratio": "300 毫升:200 毫升",
    "note": "更浓郁，需另加一百毫升清水稀释。"
   }
  ],
  "variations": [
   "表面撒一把炸洋葱碎，脆感更足更像美式家常版。",
   "加少许甜椒粉同炒白汁，颜色更暖。"
  ],
  "serving": "趁热上桌配烤鸡或牛排，浓稠白汁最配主菜。",
  "storage": "冷藏两天，复烤十分钟回温即可。",
  "nutrition": {
   "basis": "每份约 300 克",
   "kcal": 290,
   "protein": 10,
   "fat": 17,
   "carbs": 24,
   "sodium": 520
  },
  "safety": [
   "四季豆必须彻底加热至熟透软嫩，生豆含皂苷易致不适；成品冷藏不超过两天，复烤须热透。"
  ],
  "origin": "美国节日餐桌上的常客，四季豆裹上蘑菇白汁，撒满奶酪和面包糠烤到金黄。做法源自上世纪罐头食谱，如今已是感恩节家庭聚餐的固定配角，浓郁温暖。",
