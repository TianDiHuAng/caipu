     },
     {
      "n": "白糖",
      "a": 30,
      "u": "g",
      "note": "调味"
     },
     {
      "n": "柚子",
      "a": 100,
      "u": "g",
      "note": "拆成粒"
     },
     {
      "n": "清水",
      "a": 800,
      "u": "ml",
      "note": "煮西米"
     }
    ]
   }
  ],
  "steps": [
   {
    "n": 1,
    "t": "汤锅倒八百毫升清水烧开，倒入西米中火煮十二分钟，中途不停搅拌。",
    "time": 14,
    "heat": "中火",
    "tip": "水要多，西米才不糊底，搅拌别停。",
    "cue": "西米外圈透明，中心留小白点"
   },
   {
    "n": 2,
    "t": "关火加盖焖五分钟，捞到凉开水里冲散，沥干备用。",
    "time": 7,
    "heat": "无火",
    "tip": "焖到白点消失才透，冲凉水才爽滑不粘。",
    "cue": "西米颗颗透明，无粘连"
   },
   {
    "n": 3,
    "t": "芒果去皮去核取果肉，三百克打成细腻果泥，一百克切一厘米小丁。",
    "time": 10,
    "heat": "无火",
    "tip": "果泥打细一点，口感才滑；果丁留颗粒感。",
    "cue": "果泥顺滑无块，果丁方正"
   },
   {
    "n": 4,
    "t": "芒果泥里加椰奶、淡奶油和白糖，用勺子搅到糖完全化开。",
    "time": 4,
    "heat": "无火",
    "tip": "椰奶和淡奶油提前冷藏，成品更凉更好吃。",
    "cue": "混合液呈浓稠奶黄"
   },
   {
    "n": 5,
    "t": "柚子剥出果粒，搓散成一粒一粒，去掉白膜和苦芯。",
    "time": 6,
    "heat": "无火",
    "tip": "白膜一定去干净，一点苦味就毁掉整碗。",
    "cue": "柚子粒饱满散开"
   },
   {
    "n": 6,
    "t": "拌入西米、芒果丁和柚子粒，装碗后冷藏一小时再吃。",
    "time": 4,
    "heat": "无火",
    "tip": "冷藏到冰手才够爽，急着吃口感发腻。",
    "cue": "碗壁挂奶浆，果粒分布均匀"
   }
  ],
  "tips": [
   "西米煮到中心剩小白点就关火焖，别一直煮。",
   "柚子的白膜要撕净，苦味一进去就压不住。",
   "淡奶油和椰奶都冷藏过再拌，成品更冰凉顺口。"
  ],
  "mistakes": [
   "西米一直煮不焖，最后烂成糊。",
   "柚子白膜没去，整碗带苦。",
   "用热牛奶直接拌，糖化开了但口感温吞。"
  ],
  "subs": [
   {
    "orig": "淡奶油",
    "sub": "椰奶",
    "ratio": "100 毫升:100 毫升",
    "note": "更清爽，少了奶香厚度。"
   },
   {
    "orig": "柚子",
    "sub": "西柚",
    "ratio": "100 克:100 克",
    "note": "微苦回甘，风味更接近港式原版。"
   }
  ],
  "variations": [
   "加一勺椰浆冰淇淋，做成冰沙版本更消暑。",
   "底部铺一层芒果冰沙，层次更丰富。"
  ],
  "serving": "装进透明玻璃碗，表面点几粒芒果丁和柚子粒，冷藏到碗壁挂霜再端上桌。",
  "storage": "密封冷藏一天内吃完，西米会吸水变硬，别超过二十四小时。",
  "nutrition": {
   "basis": "每份约 260 克",
   "kcal": 290,
   "protein": 4,
   "fat": 12,
   "carbs": 42,
   "sodium": 40
  },
  "safety": [
   "含椰奶与淡奶油，乳制品过敏者需替换；成品全程冷藏，室温放置超过两小时不要食用。"
  ],
  "origin": "上世纪八十年代香港酒楼的招牌甜品，用芒果、柚子肉和西米混上椰奶，酸甜清爽。名字取自观音手中杨枝与甘露，当初是为宴席收尾解腻而设计的。",
  "tags": [
   "香港",
   "甜品",
   "芒果",
   "西米"
  ],
