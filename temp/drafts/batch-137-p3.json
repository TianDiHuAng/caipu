  "steps": [
   {
    "n": 1,
    "t": "牛肉切成三毫米粗的丝，加五毫升生抽抓匀腌八分钟。",
    "time": 9,
    "heat": "无火",
    "tip": "牛肉丝别太细，下锅一炒就老。",
    "cue": "肉丝粗细均匀，表面挂汁"
   },
   {
    "n": 2,
    "t": "青椒和洋葱洗净切成丝，大蒜切薄片装小碟备用。",
    "time": 6,
    "heat": "无火",
    "tip": "青椒洋葱切同宽，成熟时间才一致。",
    "cue": "三样丝宽窄接近"
   },
   {
    "n": 3,
    "t": "汤锅加水烧开，下面条煮到七分熟捞出过凉，拌几滴植物油防粘。",
    "time": 8,
    "heat": "大火",
    "tip": "七分熟就起锅，炒的时候还会继续熟。",
    "cue": "面条断口有小芯，根根分明"
   },
   {
    "n": 4,
    "t": "炒锅烧到冒烟倒植物油，下牛肉丝大火快炒到变色盛出。",
    "time": 4,
    "heat": "大火",
    "tip": "油要够热，牛肉丝下锅才不粘成块。",
    "cue": "肉丝散开，边缘微卷"
   },
   {
    "n": 5,
    "t": "锅内下蒜片、洋葱丝炒香，放青椒丝翻炒半分钟。",
    "time": 3,
    "heat": "大火",
    "tip": "蒜片炒到微黄就下料，发焦就苦了。",
    "cue": "蒜片金黄，洋葱边缘透明"
   },
   {
    "n": 6,
    "t": "倒回牛肉丝，加生抽、老抽、盐和辣椒粉，翻炒均匀上色。",
    "time": 2,
    "heat": "大火",
    "tip": "老抽只上色，别多放，否则发黑发咸。",
    "cue": "肉丝酱油色均匀发亮"
   },
   {
    "n": 7,
    "t": "下入面条，用筷子挑散翻炒一分钟，让每根面裹上酱汁。",
    "time": 2,
    "heat": "大火",
    "tip": "用筷子挑比铲子好，面条不容易断。",
    "cue": "面条根根挂色，锅底无汤"
   }
  ],
  "tips": [
   "面条煮七分熟过凉拌油，炒时根根分明不粘。",
   "牛肉分两次下锅，先炒香再回锅，肉嫩不柴。",
   "老抽只负责上色，量多会发黑发苦。"
  ],
  "mistakes": [
   "面条煮全熟再炒，一炒就烂成团。",
   "牛肉和配菜一起下锅，肉老菜生。",
   "油温不够就下肉，粘锅还出水。"
  ],
  "subs": [
   {
    "orig": "青椒",
    "sub": "芹菜",
    "ratio": "100 克:100 克",
    "note": "清香更重，脆感更好。"
   },
   {
    "orig": "面条",
    "sub": "拉面",
    "ratio": "300 克:300 克",
    "note": "更筋道，炒的时间要多半分钟。"
   }
  ],
  "variations": [
   "加一把豆芽同炒，口感更脆爽。",
   "最后淋一勺辣椒油，辣香更足。"
  ],
  "serving": "趁热盛盘，配一碗清汤和几瓣生蒜，是清真面馆最常见的搭配。",
  "storage": "冷藏一天，复热用炒锅干炒两分钟，微波会变软塌。",
  "nutrition": {
   "basis": "每份约 400 克",
   "kcal": 610,
   "protein": 30,
   "fat": 22,
   "carbs": 72,
   "sodium": 1080
  },
  "safety": [
   "牛肉丝需炒到完全变色、无血水，面条要煮透不夹生；剩面冷藏不超过一天，复热需彻底加热。"
  ],
  "origin": "西北清真面馆的招牌主食，牛肉丝配洋葱青椒大火爆炒，面条最后下锅挑散裹汁。用的是不含酒精的调味，讲究一个锅气和筋道。",
