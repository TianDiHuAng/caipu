  "steps": [
   {
    "t": "鸡腿用厨房纸吸干表面水分，在厚处划两刀方便入味，大蒜拍碎备用。",
    "time": 6,
    "heat": "无火",
    "tip": "划刀不要切断骨头，只是让厚肉处能吸到酱汁。",
    "cue": "鸡皮干爽，厚肉处有两道浅口"
   },
   {
    "t": "厚底锅放植物油烧热，鸡腿皮朝下中火煎到金黄，翻面再煎三分钟。",
    "time": 9,
    "heat": "中火",
    "tip": "煎出鸡皮的油再炖，成品香气明显更厚。",
    "cue": "鸡皮深金色，锅底留一层清亮的油"
   },
   {
    "t": "倒入白醋、生抽、老抽和清水，加蒜瓣、月桂叶和黑胡椒，煮开后转小火。",
    "time": 5,
    "heat": "中火",
    "tip": "醋要在鸡肉下锅前先煮开，酸味才会变得圆润。",
    "cue": "汤汁深褐色，浮起细密油花"
   },
   {
    "t": "盖盖小火炖三十五分钟，中途翻面一次，让鸡肉两面都浸过酱汁。",
    "time": 37,
    "heat": "小火",
    "tip": "液面保持微沸，滚沸会把鸡肉煮散。",
    "cue": "鸡肉用筷子轻扎即透，酱汁减少约三分之一"
   },
   {
    "t": "开盖加白糖，转中火收汁八分钟，边收边把酱汁往鸡身上淋。",
    "time": 9,
    "heat": "中火",
    "tip": "收汁到最后两分钟要盯紧，含糖的酱汁极易焦底。",
    "cue": "酱汁浓稠油亮，紧紧裹住鸡皮"
   },
   {
    "t": "装盘后把锅里的蒜瓣和酱汁一起浇上，配白饭趁热吃。",
    "time": 2,
    "heat": "无火",
    "tip": "蒜瓣炖软后不辣，压碎拌饭是菲律宾人的吃法。",
    "cue": "鸡皮油亮呈酱红色，蒜瓣软糯"
   }
  ],
  "tips": [
   "醋不要减量，酸味是这道菜的骨架，收汁后会自然变柔。",
   "用砂锅或厚底锅比薄锅更稳，酱汁不易烧焦。",
   "隔夜冷藏后风味更融合，第二天的酱汁拌饭最香。"
  ],
  "mistakes": [
   "醋和酱油一起下锅后大火滚煮，酸味挥发得只剩咸。",
   "收汁时走开，含糖酱汁两分钟就糊底发苦。",
   "用鸡胸代替鸡腿，久炖后肉质干柴，缺少油润感。"
  ],
  "subs": [
   {
    "orig": "鸡腿",
    "sub": "五花肉",
    "ratio": "900 克:800 克",
    "note": "菲律宾也有猪肉版本，炖煮时间延长十分钟。"
   },
   {
    "orig": "白醋",
    "sub": "苹果醋",
    "ratio": "120 毫升:130 毫升",
    "note": "酸味更柔，糖可减两克。"
   }
  ],
  "variations": [
   "收汁前加入椰浆，可做成带奶香的阿斗波椰奶版本。"
  ],
  "serving": "配白饭与番茄洋葱小菜，浇上酱汁。",
  "storage": "冷藏三天，冷冻一个月，复热时加少量水小火翻热。",
  "nutrition": {
   "basis": "每份约 260 克",
   "kcal": 430,
   "protein": 34,
   "fat": 26,
   "carbs": 8,
   "sodium": 1100
  },
  "safety": [
   "鸡肉须炖至中心温度七十五度以上、骨边无血水；酱汁含盐较高，高血压人群应减量食用。"
  ],
  "origin": "阿斗波是菲律宾最家常的做法，名字来自西班牙语的腌渍一词，但技法早于殖民时期就用当地醋与盐保存肉类。用醋、酱油、蒜和月桂叶慢炖，酸咸下饭，被视为菲律宾的国民菜。",
  "tags": [
   "菲律宾",
