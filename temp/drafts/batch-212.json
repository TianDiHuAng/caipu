  "steps": [
   {
    "n": 1,
    "t": "土豆洗净带皮放汤锅，加水煮十五分钟到半熟。，看准状态再往下做。",
    "time": 18,
    "heat": "大火",
    "tip": "煮到刀能插入即可，别煮烂。，看准状态再往下做。",
    "cue": "表皮裂开，刀插有阻力"
   },
   {
    "n": 2,
    "t": "土豆捞出晾凉，去皮切成半厘米的厚片。，看准状态再往下做。",
    "time": 10,
    "heat": "无火",
    "tip": "凉了再切，片才完整不碎。，看准状态再往下做。",
    "cue": "片厚均匀，边缘平整"
   },
   {
    "n": 3,
    "t": "培根切条，洋葱切细丝备用。，看准状态再往下做。",
    "time": 6,
    "heat": "无火",
    "tip": "培根切宽条，口感更有嚼头。，看准状态再往下做。",
    "cue": "条丝分明，肥瘦清楚"
   },
   {
    "n": 4,
    "t": "平底锅不放油，下培根小火煸出油。，看准状态再往下做。",
    "time": 5,
    "heat": "小火",
    "tip": "培根本身有油，不用另加油。，看准状态再往下做。",
    "cue": "培根卷曲，油脂透明"
   },
   {
    "n": 5,
    "t": "加洋葱丝炒到透明发软，倒入白葡萄酒煮干。，看准状态再往下做。",
    "time": 6,
    "heat": "中火",
    "tip": "酒煮干才不留酸味，只剩香。，看准状态再往下做。",
    "cue": "洋葱金黄，锅底无水"
   },
   {
    "n": 6,
    "t": "烤盘用大蒜擦一遍，再抹黄油防粘。，看准状态再往下做。",
    "time": 4,
    "heat": "无火",
    "tip": "蒜擦盘能去腥增香，别省。，看准状态再往下做。",
    "cue": "盘壁油亮，蒜香附盘"
   },
   {
    "n": 7,
    "t": "一层土豆铺底，撒盐和黑胡椒，铺上培根洋葱。，看准状态再往下做。",
    "time": 6,
    "heat": "无火",
    "tip": "分层铺，味道才均匀渗透。，看准状态再往下做。",
    "cue": "层次分明，配料铺平"
   },
   {
    "n": 8,
    "t": "重复铺一层土豆，淋淡奶油撒百里香。，看准状态再往下做。",
    "time": 5,
    "heat": "无火",
    "tip": "奶油淋在表面，烤时才渗下去。，看准状态再往下做。",
    "cue": "表面湿润，香气散出"
   },
   {
    "n": 9,
    "t": "奶酪片铺满表面，盖住整个烤盘。，看准状态再往下做。",
    "time": 4,
    "heat": "无火",
    "tip": "奶酪铺满，烤出的皮才连成一片。，看准状态再往下做。",
    "cue": "表面雪白，边缘对齐"
   },
   {
    "n": 10,
    "t": "烤箱两百度烤二十五分钟，表面金黄鼓起即成。，看准状态再往下做。",
    "time": 25,
    "heat": "无火",
    "tip": "最后五分钟看上色，别烤焦。，看准状态再往下做。",
    "cue": "表皮起泡，颜色深金"
   }
  ],
  "tips": [
   "土豆煮到半熟就够，全熟再烤会散。",
   "白葡萄酒要煮干，否则酸味抢味。，这一点很关键。",
   "奶酪要铺满表面，才烤得出脆皮。，这一点很关键。"
  ],
  "mistakes": [
   "土豆煮烂了，烤完变成泥。，这一点很关键。",
   "培根不煸直接烤，出油太多。，这一点很关键。",
   "奶酪铺太薄，表面烤不出脆壳。，这一点很关键。"
  ],
  "subs": [
   {
    "orig": "奶酪",
    "sub": "帕玛森芝士",
