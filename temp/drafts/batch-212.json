    "note": "更咸更硬，盐要减半。"
   },
   {
    "orig": "培根",
    "sub": "腊肠",
    "ratio": "200 克:180 克",
    "note": "更咸，盐可省略。"
   }
  ],
  "variations": [
   "加一层蘑菇片，风味更浓。，这一点很关键。",
   "用白葡萄酒换成干白苹果酒，果香更足。"
  ],
  "serving": "配一盘生菜和一杯白葡萄酒。，这一点很关键。",
  "storage": "冷藏三天，复热烤箱一百八十度十五分钟。",
  "nutrition": {
   "basis": "每份约 340 克",
   "kcal": 680,
   "protein": 28,
   "fat": 46,
   "carbs": 38,
   "sodium": 1280
