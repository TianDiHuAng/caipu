    "steps": [
      {
        "t": "面粉加酵母、盐和温水揉成光滑面团，盖湿布在温暖处醒发到一倍半大。",
        "time": 15,
        "heat": "无火",
        "tip": "面团要揉到表面光滑，按下去能缓慢回弹才好擀。",
        "cue": "面团光滑圆整，按压回弹缓慢。"
      },
      {
        "t": "醒好的面团留在盆中静置到体积明显膨胀，手指戳洞不回缩即可使用。",
        "time": 60,
        "heat": "无火",
        "tip": "醒发不足饼身发硬，醒过头会带酸味，看状态比看时间准。",
        "cue": "面团膨松，戳洞边缘不塌。"
      },
      {
        "t": "取三十克面粉加盐，浇上烧热的花生油拌成稀油酥，另留少量花生油刷面。",
        "time": 5,
        "heat": "中火",
        "tip": "油要烧到微微冒烟再浇，油酥才香而不生。",
        "cue": "油酥顺滑能流动，闻着有熟油香。"
      },
      {
        "t": "面团擀成大薄片，抹匀油酥撒上葱花，从一边卷成长条再盘成螺旋状。",
        "time": 8,
        "heat": "无火",
        "tip": "卷的时候边卷边轻轻拉伸，层数越多成品越酥。",
        "cue": "面卷层次分明，盘好呈蜗牛状。"
      },
      {
        "t": "把盘好的面卷按扁擀成厚约一厘米的圆饼，表面刷一层花生油。",
        "time": 4,
        "heat": "无火",
        "tip": "擀的时候从中间向四周推，别把层次压死。",
        "cue": "饼坯圆整厚薄均匀，层次隐约可见。"
      },
      {
        "t": "平底锅小火把饼两面烙到微黄定型，移入两百度烤箱烤到表面金黄鼓起。",
        "time": 14,
        "heat": "小火",
        "tip": "先烙后烤能让外层酥脆内里熟透，全程别用大火。",
        "cue": "表面金黄起层，手指按压有脆响。"
      }
    ],
    "tips": [
      "油酥要现浇刚烧热的花生油，用凉油拌出来发死还带生味。",
      "卷面时要边卷边轻轻抻长面皮，层次才会又薄又多。",
      "先在平底锅烙定型再入烤箱，外层酥脆内里柔软才是济南味。"
    ],
    "mistakes": [
      "浇油酥的油温不够热，成品吃着有股生油味，香气也起不来。",
      "擀饼时用力过猛，辛苦卷出的层次被压死，烤完完全不起酥。",
      "全程用大火烙，外皮焦黑发苦，掰开里面还是生面糊。"
    ],
