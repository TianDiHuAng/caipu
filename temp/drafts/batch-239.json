  "steps": [
   {
    "n": 1,
    "t": "面粉加鸡蛋、牛奶和盐揉成偏硬面团。，火候要稳，别忽大忽小。",
    "time": 8,
    "heat": "无火",
    "tip": "面硬一点，皮才擀得薄。，火候要稳，别忽大忽小。",
    "cue": "面团紧实，表面光滑"
   },
   {
    "n": 2,
    "t": "盖布静置二十五分钟松弛。，火候要稳，别忽大忽小。",
    "time": 27,
    "heat": "无火",
    "tip": "松弛到位，擀开才不回缩。，火候要稳，别忽大忽小。",
    "cue": "按压留坑，回弹变慢"
   },
   {
    "n": 3,
    "t": "羊乳酪捏碎，拌入莳萝和黑胡椒。，火候要稳，别忽大忽小。",
    "time": 4,
    "heat": "无火",
    "tip": "奶酪别太碎，留点颗粒。，火候要稳，别忽大忽小。",
    "cue": "馅料松散，香气清亮"
   },
   {
    "n": 4,
    "t": "面团分小块，擀成很薄的圆片。，火候要稳，别忽大忽小。",
    "time": 10,
    "heat": "无火",
    "tip": "薄到透光，卷起来才脆。，火候要稳，别忽大忽小。",
    "cue": "面片薄透，边缘圆整"
   },
   {
    "n": 5,
    "t": "面片刷融化黄油，切三角块。，火候要稳，别忽大忽小。",
    "time": 4,
    "heat": "无火",
    "tip": "刷黄油，炸后才酥。，火候要稳，别忽大忽小。",
    "cue": "表面油亮，切块整齐"
   },
   {
    "n": 6,
    "t": "窄边放一条奶酪馅，卷紧成细条。，火候要稳，别忽大忽小。",
    "time": 8,
    "heat": "无火",
    "tip": "卷紧一点，炸时才不散。，火候要稳，别忽大忽小。",
    "cue": "条身紧实，粗细一致"
   },
   {
    "n": 7,
    "t": "边缘刷蛋液封口，压紧。，火候要稳，别忽大忽小。",
    "time": 3,
    "heat": "无火",
    "tip": "蛋液封口，炸时不裂。，火候要稳，别忽大忽小。",
    "cue": "封口贴合，条身完整"
   },
   {
    "n": 8,
    "t": "平底锅倒植物油，烧到微冒烟。，火候要稳，别忽大忽小。",
    "time": 4,
    "heat": "中火",
    "tip": "油温不够会吸油。，火候要稳，别忽大忽小。",
    "cue": "油面起纹，筷子冒泡"
   },
   {
    "n": 9,
    "t": "下卷条炸两分钟到金黄，翻面再炸。，火候要稳，别忽大忽小。",
    "time": 5,
    "heat": "中火",
    "tip": "一次别放多，油温才不降。，火候要稳，别忽大忽小。",
    "cue": "表皮金黄，体积鼓起"
   },
   {
    "n": 10,
    "t": "捞出沥油，趁热装盘。，火候要稳，别忽大忽小。",
    "time": 3,
    "heat": "无火",
    "tip": "沥干油，吃着才不腻。，火候要稳，别忽大忽小。",
    "cue": "表面干爽，轻捏即碎"
   }
  ],
