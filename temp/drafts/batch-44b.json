  "steps": [
   {
    "t": "鳕鱼 500g 用厨房纸吸干表面水分，两面抹 4g 盐，静置 15 分钟逼出水汽。",
    "time": 16,
    "heat": "无火",
    "tip": "盐腌出水后鱼皮更易定型。",
    "cue": "鱼排表面干爽、无渗水"
   },
   {
    "t": "陶锅倒 250ml 橄榄油，冷油下大蒜片与干辣椒段，小火慢炸 6 分钟至蒜片微黄。",
    "time": 8,
    "heat": "小火",
    "tip": "冷油下蒜，香气才慢慢渗进油里。",
    "cue": "蒜片金黄、油面微微起泡"
   },
   {
    "t": "捞出蒜片和辣椒留着备用，油温降到约 70 度，放入鳕鱼排小火煎 8 分钟。",
    "time": 9,
    "heat": "小火",
    "tip": "油温别高，鱼排要慢慢浸熟。",
    "cue": "鱼排边缘转白、鱼肉微颤"
   },
   {
    "t": "翻面再煎 5 分钟，取出鱼排放在温盘上，锅内留约 150ml 油。",
    "time": 6,
    "heat": "小火",
    "tip": "翻面用夹子托住，鱼肉才不散。",
    "cue": "两面洁白、鱼皮完整"
   },
   {
    "t": "保持小火，用汤勺舀起锅里的油反复浇在锅底，边浇边晃锅 3 分钟至汤汁乳白浓稠。",
    "time": 4,
    "heat": "小火",
    "tip": "反复浇油是乳化的关键动作。",
    "cue": "汤汁乳白、能挂住勺背"
   },
   {
    "t": "把鳕鱼放回锅中裹上酱汁，撒回炸香的蒜片和辣椒，离火上桌。",
    "time": 3,
    "heat": "小火",
    "tip": "离火再拌，避免酱汁分层。",
    "cue": "鱼身裹满乳白酱汁"
   }
  ],
  "tips": [
   "橄榄油必须全程小火，温度过高就乳不起来。",
   "鱼排下锅前吸干水分，油才不飞溅。",
   "装盘后摇匀锅底酱汁再浇一遍，卖相更好。"
  ],
  "mistakes": [
   "大火煎鱼，橄榄油过热导致酱汁永远无法乳化。",
   "蒜片炸到焦黑，整锅油带苦味。",
   "鱼排煎完直接端上桌，没有回锅裹酱汁。"
  ],
  "subs": [
   {
    "orig": "鳕鱼",
    "sub": "比目鱼",
    "ratio": "500g 对 500g",
    "note": "肉质更软，煎制时间减 2 分钟。"
   },
   {
    "orig": "大蒜",
    "sub": "蒜苗",
    "ratio": "30g 对 40g",
    "note": "香气更清，辣味更淡。"
   }
  ],
  "variations": [
   "藏红花版：油中加 0.2g 藏红花增色。",
   "蒜香浓版：大蒜加到 50g 同煎。"
  ],
  "serving": "用浅盘盛装，淋上乳白酱汁，配烤面包蘸食。",
  "storage": "现做现吃，冷藏后酱汁会分层凝结。",
  "nutrition": {
   "basis": "每份（约 250g）",
   "calories_kcal": 520,
   "protein_g": 32,
   "fat_g": 42,
   "carbs_g": 2,
   "sodium_mg": 620
  },
  "allergens": [
   "fish"
  ],
  "diet_tags": [],
  "food_safety_notes": [
   "鳕鱼属鱼类过敏原，过敏人群请避开；须煎至鱼肉完全变白熟透。",
   "橄榄油温较高，操作时避免水滴入锅引起飞溅。"
  ],
  "tags": [
   "西班牙",
   "海鲜",
   "鳕鱼",
   "橄榄油"
  ],
  "origin": "这道菜来自西班牙巴斯克地区，名字里的 pil-pil 是锅里油水相撞时发出的声音。鳕鱼在低温橄榄油里慢慢浸熟，再靠反复浇油让鱼胶与橄榄油乳化成乳白酱汁，全程不加一滴水，蒜香和海味都锁在油里。",
  "related": [
   "gambas-al-ajillo",
   "pulpo-a-la-gallega",
