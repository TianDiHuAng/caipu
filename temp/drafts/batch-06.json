  "steps": [
   {
    "t": "鳙鱼冲净血水，刮净腹腔黑膜，用厨房纸吸干，鱼皮抹盐与 10 毫升料酒，静置 10 分钟。",
    "time": 10,
    "heat": "无火",
    "tip": "鳃与黑膜是腥味主要来源，必须刮净。",
    "cue": "鱼皮表面干爽，不再渗血水"
   },
   {
    "t": "盘底铺姜片，鱼头肉面朝上摆好。炒锅下 40 毫升菜籽油，中火炒香大蒜与豆豉，倒入剁椒翻炒 1 分钟，加生抽、白糖与剩余料酒拌匀。",
    "time": 3,
    "heat": "中火",
    "tip": "剁椒先炒再铺，香气足且不生涩。",
    "cue": "剁椒颜色转深、油色发红，闻到明显酱香"
   },
   {
    "t": "把炒好的剁椒连油均匀铺满鱼头，蒸锅水上汽后放入，大火蒸 11 分钟。",
    "time": 11,
    "heat": "大火",
    "tip": "上汽后再入锅，冷水起蒸鱼肉发柴。",
    "cue": "鱼眼凸出发白，鱼鳍轻拉能脱落，筷子插入最厚处无血水"
   },
   {
    "t": "取出鱼盘撒小葱，另起锅把剩余菜籽油烧至微微冒烟，均匀浇在葱花上。",
    "time": 2,
    "heat": "中火",
    "tip": "油要烧到表面起细纹，温度不够激不出葱香。",
    "cue": "葱花瞬间变翠绿并发出滋滋声"
   },
   {
    "t": "静置 1 分钟让油香渗入，趁热上桌。",
    "time": 1,
    "heat": "无火",
    "tip": "盘底红汤别倒掉，拌面拌饭都好。",
    "cue": "汤汁红亮油润"
   }
  ],
  "tips": [
   "鱼头选 1 至 1.2 公斤最合适，太大不易蒸透，太小肉薄易老。",
   "剁椒含盐，只抹鱼皮即可，重复加盐会盖住鱼鲜。",
   "关火后焖 1 分钟再开盖，肉质更松。"
  ],
  "mistakes": [
   "提前几小时用剁椒腌鱼，鱼身出水导致味淡肉紧。",
   "蒸锅未上汽就放鱼，外层老、内部生。"
  ],
  "subs": [
