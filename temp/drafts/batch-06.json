    "ratio": "1:0.6",
    "note": "鲈鱼易熟，蒸制缩短到 8 分钟。"
   }
  ],
  "variations": [
   "家常版换成整条鲈鱼，蒸 8 分钟即可。",
   "盘底垫嫩豆腐，豆腐吸汤汁，适合多人分食。"
  ],
  "serving": "配白米饭，先吃鱼脸颊肉，再用汤汁拌饭。",
  "storage": "冷藏 1 天，复热需重新蒸 6 分钟至中心滚烫；不建议冷冻，鱼肉会散。",
