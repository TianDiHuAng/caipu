    "steps": [
      {
        "t": "花椒与一半盐下干锅小火炒到香气冒出，趁热抹遍鸭身内外，冷藏腌四小时。",
        "time": 240,
        "heat": "小火",
        "tip": "鸭腿与鸭胸厚处多抹些盐，入味才均匀，别抹到鸭皮破口。",
        "cue": "鸭皮泛出浅浅盐霜，花椒香扑鼻。"
      },
      {
        "t": "腌好的鸭子用清水冲掉表面盐粒，冷水下锅加料酒和姜片焯水去腥。",
        "time": 12,
        "heat": "中火",
        "tip": "盐粒必须冲净，否则卤汁会过咸，颜色也发暗。",
        "cue": "水面浮沫结块，鸭皮收紧变白。"
      },
      {
        "t": "汤锅放生抽、老抽、冰糖、剩余盐、大葱段、八角、桂皮和橘皮，加清水烧开。",
        "time": 10,
        "heat": "大火",
        "tip": "冰糖先化开再放鸭，酱色才透亮不发花。",
        "cue": "卤汁呈酒红色，香料味漫出。"
      },
      {
        "t": "鸭子整只放进卤汁，小火卤六十分钟，中途翻面两次让鸭身浸汁均匀。",
        "time": 62,
        "heat": "小火",
        "tip": "卤汁只冒细泡就够，滚太猛鸭皮会破，肉也散。",
        "cue": "鸭皮深红油亮，筷子能扎穿鸭腿。"
      },
      {
        "t": "鸭子捞出挂起沥干，卤汁滤净香料后开中火收至浓稠，反复刷在鸭身上。",
        "time": 15,
        "heat": "中火",
        "tip": "收汁时不停搅动，糖分沉底极易糊锅，火候宁小勿大。",
        "cue": "鸭身挂一层亮膜，酱汁能挂住勺背。"
      },
      {
        "t": "鸭子彻底放凉后斩成两厘米宽的条块，按原形码盘，淋少许卤汁上桌。",
        "time": 20,
        "heat": "无火",
        "tip": "凉透再斩，鸭肉不散、切面平整好看。",
        "cue": "切面肉色紧实，皮红肉白层次分明。"
      }
    ],
    "tips": [
      "鸭选两斤半左右的嫩鸭，卤后皮薄肉嫩，老鸭只适合煲汤。",
      "卤汁滤净后冷藏可反复用两三次，每次补些生抽与冰糖。",
      "刷汁时鸭身要悬空，汁挂得薄而匀，才不会黏成一团。"
    ],
    "mistakes": [
      "鸭身盐没冲净就下锅，卤汁越卤越咸，成品咸得发苦。",
      "卤制时火太大，鸭皮开裂出油，酱色斑驳难看。",
      "热鸭直接斩件，肉汁流失、骨头缝里全是碎肉。"
    ],
    "subs": [
      {
        "orig": "鸭",
        "sub": "鸭腿",
        "ratio": "1:1.2",
        "note": "鸭腿肉厚易熟，卤的时间缩短二十分钟，斩件更方便。"
      },
      {
        "orig": "冰糖",
        "sub": "白糖",
        "ratio": "1:1",
        "note": "白糖甜味直冲，卤汁亮度略差，收汁时多刷一遍。"
      }
    ],
    "variations": [
      "苏州店家讲究卤后风干半日，皮更紧实，切片时带一层薄冻，冷吃最香。",
      "有的家庭卤汁里加一小杯黄酒代替清水，酒香更厚，回味偏甜。"
    ],
    "serving": "冷藏后切冷盘最宜，配一碟姜丝香醋；也可切块蒸热，浇卤汁配白饭。",
    "storage": "冷藏可存三日，冷冻两周；复热用蒸锅八分钟，别用微波炉干加热。",
    "nutrition": {
      "basis": "按四人份估算",
