  "steps": [
   {
    "t": "羊肉切成筷子粗细的细条，肥的部分单独留出备用。",
    "time": 8,
    "heat": "无火",
    "tip": "肥肉先煸能出羊油，香得不一样。",
    "cue": "肉条长短一致，肥瘦分开"
   },
   {
    "t": "手擀面下沸水煮到八分熟，捞出过凉水后沥干。",
    "time": 6,
    "heat": "大火",
    "tip": "八分熟就捞，回锅炒还会再熟一分。",
    "cue": "面条能咬断，中心有白点"
   },
   {
    "t": "炒锅烧热，先下肥肉条小火煸出清亮的羊油。",
    "time": 4,
    "heat": "小火",
    "tip": "煸到油渣发黄就够，别煸糊。",
    "cue": "锅底积油，肉渣金黄"
   },
   {
    "t": "下羊肉细条用中大火翻炒到完全变色，先盛出备用。",
    "time": 4,
    "heat": "中大火",
    "tip": "先炒后盛，肉才不会越炒越老。",
    "cue": "肉条表面变白，无血色"
   },
   {
    "t": "原锅补植物油，下洋葱丝与胡萝卜条炒到洋葱透明。",
    "time": 3,
    "heat": "中火",
    "tip": "洋葱炒软才有甜味打底。",
    "cue": "洋葱透明，胡萝卜发亮"
   },
   {
    "t": "倒回炒好的羊肉，加生抽、盐与大蒜片翻炒均匀上色。",
    "time": 2,
    "heat": "中火",
    "tip": "生抽沿锅边淋，酱香才激得出来。",
    "cue": "肉条上色，锅气升腾"
   },
   {
    "t": "把面条铺进锅里，用筷子抖散后翻炒三分钟至干香。",
    "time": 3,
    "heat": "中大火",
    "tip": "用筷子比铲子更好抖开，不易断。",
    "cue": "面条根根分明，不粘连"
   },
   {
    "t": "撒黑胡椒翻匀，尝味补盐后装盘，趁热端上桌。",
    "time": 1,
    "heat": "中火",
    "tip": "黑胡椒最后撒，香气才不散。",
    "cue": "面条油亮，配菜均匀"
   }
  ],
  "tips": [
   "面条一定要沥干，带水下锅会糊成一团。",
   "羊肉选带肥的，煸出的羊油是这道菜的底味。",
   "全程中大火快炒，锅气足才好吃。"
  ],
  "mistakes": [
   "面条煮到全熟再回锅，成品软烂粘牙。",
   "洋葱胡萝卜和肉一起下锅，蔬菜出了水肉还没焦。",
   "生抽一开始就倒，锅温不够酱香出不来。"
  ],
  "subs": [
   {
    "orig": "羊肉",
    "sub": "牛肉",
    "ratio": "350 克:350 克",
    "note": "选牛里脊，炒制时间缩短一分钟。"
   },
   {
    "orig": "手擀面",
    "sub": "挂面",
    "ratio": "400 克:350 克",
    "note": "挂面易断，翻炒时轻一点。"
   }
  ],
  "variations": [
   "加一把青椒条，颜色更鲜亮，口感更脆。",
   "用羊油替代植物油，蒙古风味更足。"
  ],
  "serving": "装大盘趁热吃，配一碗酥油茶解腻。",
  "storage": "冷藏两天，复热用炒锅干炒两分钟，比微波口感好。",
  "nutrition": {
   "basis": "每份约 300 克",
   "kcal": 560,
   "protein": 28,
   "fat": 22,
   "carbs": 62,
   "sodium": 880
  },
  "safety": [
   "羊肉须炒至完全变色无血水；面条回锅前须沥干，避免油溅。"
  ],
  "origin": "蒙古包里的家常主食，牧民用大铁锅把羊肉和面条一起炒，一锅就是一顿饭。面条吸了羊油，配菜脆甜，锅里冒着热气，冬天吃得最舒服。",
  "tags": [
   "蒙古",
