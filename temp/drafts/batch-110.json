     }
    ]
   }
  ],
  "steps": [
   {
    "t": "青稞挑去杂质和空壳，用清水淘洗两遍后沥干水分。",
    "time": 6,
    "heat": "无火",
    "tip": "淘洗后一定要沥干，炒时才不粘锅。",
    "cue": "青稞表面无浮尘与杂质"
   },
   {
    "t": "炒锅烧热不放油，青稞下锅小火干炒十分钟。",
    "time": 10,
    "heat": "小火",
    "tip": "不停翻动，炒到粒粒爆开才算好。",
    "cue": "青稞微黄，不断爆响"
   },
   {
    "t": "炒好的青稞摊开在竹匾上晾凉，同时散去多余水汽。",
    "time": 5,
    "heat": "无火",
    "tip": "热着磨会返潮结块。",
    "cue": "颗粒干爽，一捏即碎"
   },
   {
    "t": "青稞倒入石磨或破壁机，磨成带少许颗粒的细粉。",
    "time": 5,
    "heat": "无火",
    "tip": "磨得太细冲出来发黏，留点颗粒更香。",
    "cue": "粉质均匀，有麦香"
   },
   {
    "t": "木碗里放青稞粉、酥油、白糖与少许盐，倒入热酥油茶。",
    "time": 3,
    "heat": "无火",
    "tip": "茶要八十五度以上，酥油才化得开。",
    "cue": "酥油融化浮在表面"
   },
   {
    "t": "用食指沿碗边把粉往中间压，边压边转碗搅成团。",
    "time": 4,
    "heat": "无火",
    "tip": "手指贴着碗壁压，比勺子搅得匀。",
    "cue": "粉团抱紧，碗壁干净"
   },
   {
    "t": "取一小块手捏成紧实的圆团，配一口热酥油茶送下。",
    "time": 3,
    "heat": "无火",
    "tip": "捏得紧才不掉渣，吃着方便。",
    "cue": "团块紧实，不散不粘手"
   }
  ],
  "tips": [
   "青稞必须炒熟再磨，生粉冲出来又腥又黏。",
   "酥油茶要趁热倒，温度不够捏不成团。",
   "白糖可换成红糖，风味更浓一些。"
  ],
  "mistakes": [
   "青稞没炒透就磨，成品带生谷味。",
   "酥油茶倒太少，粉团干散捏不成形。",
   "一次倒的茶太多，糌粑直接变成稀糊。"
  ],
  "subs": [
   {
    "orig": "青稞",
    "sub": "燕麦",
    "ratio": "300 克:300 克",
    "note": "香气略淡，炒制时间缩短两分钟。"
   },
   {
    "orig": "酥油",
    "sub": "黄油",
    "ratio": "60 克:60 克",
    "note": "奶香更甜，但少了牦牛酥油的厚重。"
   }
  ],
  "variations": [
   "加一小把奶酪碎一起捏，咸香更突出。",
   "用红糖替代白糖，颜色偏褐，回味更深。"
  ],
  "serving": "用木碗装着，配一壶热酥油茶，边捏边吃。",
  "storage": "青稞粉密封干燥存放一个月，捏好的糌粑当天吃完。",
  "nutrition": {
   "basis": "每份约 120 克",
   "kcal": 480,
   "protein": 10,
   "fat": 20,
   "carbs": 62,
   "sodium": 180
  },
  "safety": [
   "干炒青稞时锅温高，须不停翻动防焦糊；酥油茶滚烫，倒入时避免溅出。"
  ],
  "origin": "高原上的主食，青稞炒熟磨粉，用酥油茶一冲一捏就能吃。牧民出门带一袋糌粑和一只木碗，路边舀一勺雪水也能对付一顿。",
  "tags": [
