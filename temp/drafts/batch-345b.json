  "steps": [
   {
    "t": "梅干菜用温水泡二十分钟，反复抓洗三遍去掉沙粒，捞出挤干后切成碎末。",
    "time": 25,
    "heat": "无火",
    "tip": "梅干菜沙多，洗到水清为止，否则咬着牙碜。",
    "cue": "菜末松散，无沙粒"
   },
   {
    "t": "猪肉末放进大碗，加生抽、白糖和淀粉，顺一个方向搅到发黏。",
    "time": 5,
    "heat": "无火",
    "tip": "一定顺同一方向搅，肉馅才上劲不散。",
    "cue": "肉馅黏稠，有拉丝感"
   },
   {
    "t": "分三次加入清水，每次都搅到水被完全吸收，肉馅变得蓬松有弹性。",
    "time": 4,
    "heat": "无火",
    "tip": "打水能让肉饼蒸出来嫩，水别一次倒。",
    "cue": "肉馅吸水，体积变大"
   },
   {
    "t": "拌入梅干菜末、姜末和植物油，再搅半分钟，让菜和肉均匀混合。",
    "time": 3,
    "heat": "无火",
    "tip": "油最后放，能把水分封在肉里。",
    "cue": "菜肉均匀，油润发亮"
   },
   {
    "t": "肉馅摊进浅盘压成一厘米厚的圆饼，用勺背抹平表面，中间略凹。",
    "time": 4,
    "heat": "无火",
    "tip": "中间凹一点，蒸的时候受热均匀不鼓包。",
    "cue": "饼面平整，厚薄一致"
   },
   {
    "t": "蒸锅水开后放盘，大火蒸十五分钟，出锅撒葱花，淋一勺盘里的汁。",
    "time": 17,
    "heat": "大火",
    "tip": "蒸够时间肉饼中心才熟，可用筷子插试。",
    "cue": "饼身紧实，葱花翠绿"
   }
  ],
  "tips": [
   "梅干菜本身带咸，生抽只放十五毫升，尝过再决定要不要加盐。",
   "肉末别选全瘦的，三成肥肉蒸出来才润，全瘦会发柴。",
   "打水是肉饼嫩的关键，四十毫升水分三次加，一次加多了肉馅会散。"
  ],
  "mistakes": [
   "梅干菜没泡透就切，蒸出来又硬又咸，肉饼整体发苦。",
   "肉馅乱搅一通，方向反反复复，蒸好后肉饼开裂出水。",
   "冷水上锅蒸，肉饼慢慢受热，表面塌陷，底部积一层水。"
  ],
  "subs": [
   {
    "orig": "梅干菜",
    "sub": "冬菜",
    "ratio": "60克:60克",
    "note": "冬菜咸度更高，需减到四十克。"
   },
   {
    "orig": "猪肉末",
    "sub": "鸡肉末",
    "ratio": "400克:400克",
    "note": "鸡肉瘦，打水量可增到六十毫升。"
   }
  ],
  "variations": [
   "肉饼上铺三片咸蛋黄同蒸，咸香更浓，卖相也更讨喜。",
   "把梅干菜换成香菇末和虾仁，做成鲜香版肉饼，孩子更爱吃。"
  ],
  "serving": "连盘上桌，用勺子挖着吃，配白饭和一碟青菜，是粤式家常的经典搭配。",
  "storage": "冷藏可放两天，回热时蒸八分钟，不要用微波炉，否则肉饼会变硬。",
  "nutrition": {
   "basis": "按三人份估算",
   "kcal": 400,
   "protein": 26,
   "fat": 28,
   "carbs": 9,
   "sodium": 690
