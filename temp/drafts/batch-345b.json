  "steps": [
   {
    "t": "糯米淘洗两遍后加清水浸泡四小时，泡到米粒一捻就碎，捞出沥干。",
    "time": 245,
    "heat": "无火",
    "tip": "天热时放冰箱泡，中途换一次水防发酸。",
    "cue": "米粒饱胀，一捻即碎"
   },
   {
    "t": "干粽叶放开水里煮五分钟，捞出用冷水冲净，剪去硬梗和破损的边。",
    "time": 10,
    "heat": "大火",
    "tip": "煮过的粽叶变软不易裂，包的时候更听话。",
    "cue": "叶片柔软，颜色转深"
   },
   {
    "t": "咸肉切成一厘米见方的小块，加生抽和白糖抓匀，腌十分钟入味。",
    "time": 12,
    "heat": "无火",
    "tip": "肉块带一点肥的，煮出来米才香。",
    "cue": "肉块均匀，表面泛光"
   },
   {
    "t": "沥干的糯米加生抽、老抽和盐拌匀，静置十分钟让米粒上色。",
    "time": 11,
    "heat": "无火",
    "tip": "拌好的米要现包，放久了会出水。",
    "cue": "米粒棕红，粒粒挂色"
   },
   {
    "t": "取两张粽叶交叠折成漏斗，填一层米放两块咸肉再盖一层米，包紧后用棉线扎牢。",
    "time": 25,
    "heat": "无火",
    "tip": "米只装七分满，煮的时候米会膨胀。",
    "cue": "粽身紧实，四角不漏"
   },
   {
    "t": "粽子摆进大锅，加清水没过粽子三厘米，大火烧开转小火煮两小时。",
    "time": 130,
    "heat": "小火",
    "tip": "水要一直盖过粽子，中途加水须加热水。",
    "cue": "粽叶转深，米香四溢"
   }
  ],
  "tips": [
   "圆糯米黏性最好，长糯米偏硬，包咸粽用圆糯米更合口味。",
   "咸肉别切太大，否则一块咬下去咸得齁，米也没有肉香。",
   "煮粽子的水要一次加够，中途开盖加水会让粽子夹生。"
  ],
  "mistakes": [
   "米泡的时间不够就直接包，煮两小时里面还是硬芯，吃着硌牙。",
   "粽叶不煮就用，包的时候一折就裂，下锅漏米，汤变浑浊。",
   "棉线扎得太松，粽子在锅里散开，最后煮成一锅咸粥。"
  ],
  "subs": [
   {
    "orig": "咸肉",
    "sub": "腊肉",
    "ratio": "200克:200克",
    "note": "腊肉先蒸十五分钟再切，咸度更高需减盐。"
   },
   {
    "orig": "糯米",
    "sub": "紫糯米",
    "ratio": "500克:500克",
    "note": "紫糯米需多泡一小时，煮的时间加二十分钟。"
   }
  ],
  "variations": [
   "加一颗咸蛋黄包进去，就是江南人爱吃的双拼咸粽。",
   "米里拌一勺猪油再包，煮出来的粽子油润发亮，香气更足。"
