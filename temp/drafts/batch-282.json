        "t": "放海参与鱿鱼，加料酒，转中小火煮三分钟。",
        "time": 6,
        "heat": "中小火",
        "tip": "海参久煮会缩，三分钟就够。",
        "cue": "鱿鱼卷成花，海参变挺。"
      },
      {
        "t": "放入虾仁与小白菜，煮到虾仁卷曲变红即可关火。",
        "time": 5,
        "heat": "中小火",
        "tip": "虾仁一变色就关火，煮久发硬。",
        "cue": "虾仁通体粉红卷曲"
      },
      {
        "t": "加盐与白胡椒调味，淋香油，撒小葱花开锅上桌。",
        "time": 4,
        "heat": "无火",
        "tip": "白胡椒最后放，辛辣香才在。",
        "cue": "汤色清亮，葱花浮面。"
      }
