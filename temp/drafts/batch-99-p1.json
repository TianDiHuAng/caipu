  "steps": [
   {
    "t": "牛腩块用厨房纸吸干水分，撒盐与黑胡椒，两面薄薄裹一层面粉。",
    "time": 12,
    "heat": "无火",
    "tip": "肉块一定要吸干，湿肉下锅只会出水不会上色。",
    "cue": "肉块表面干爽，粉层薄而均匀"
   },
   {
    "t": "厚底锅下橄榄油烧热，把牛肉分批煎到六面深褐，取出备用。",
    "time": 15,
    "heat": "中大火",
    "tip": "分批煎，锅挤满温度骤降就煎不出焦壳。",
    "cue": "肉块六面焦褐，锅底留褐色焦渣"
   },
   {
    "t": "原锅下培根条小火煸出油，再放洋葱与胡萝卜炒到边缘微焦。",
    "time": 10,
    "heat": "中火",
    "tip": "培根的油是这道菜的底味，别倒掉。",
    "cue": "蔬菜边缘带焦边，锅底油亮"
   },
   {
    "t": "倒回牛肉，撒入蒜末与香叶、百里香翻炒一分钟出香。",
    "time": 3,
    "heat": "中火",
    "tip": "香料在油里翻一下就好，久炒发苦。",
    "cue": "香气扑鼻，锅内有轻微滋滋声"
   },
   {
    "t": "倒入红酒没过肉面，加高汤补足液体，煮开后撇去浮沫。",
    "time": 8,
    "heat": "大火",
    "tip": "红酒要先煮滚挥发酒精，否则成品发酸。",
    "cue": "汤面浮沫撇净，液体深红"
   },
   {
    "t": "转最小火加盖慢炖两小时，中途翻动两次防止粘底。",
    "time": 120,
    "heat": "小火",
    "tip": "保持汤面只有零星小泡，滚太猛肉会散。",
    "cue": "肉块用筷子能轻松插透"
   },
   {
    "t": "另起锅用黄油把口蘑煎到金黄，倒入炖锅再煮十分钟。",
    "time": 12,
    "heat": "中火",
    "tip": "蘑菇单独煎香再入锅，汤才不寡淡。",
    "cue": "蘑菇边缘金黄，吸饱汤汁"
   },
   {
    "t": "开盖收汁到浓稠挂勺，撒欧芹碎，配土豆泥或面包上桌。",
    "time": 10,
    "heat": "中火",
    "tip": "收汁时勤搅，红酒酱含糖容易糊底。",
    "cue": "汤汁能挂在勺背，颜色深亮"
   }
  ],
  "tips": [
   "隔夜冷藏后再加热，风味比当天更融合。",
   "红酒选自己愿意喝的干型，料酒级别的酒会发涩。",
   "收汁阶段离火前尝一次咸淡，红酒本身带酸。"
  ],
  "common_mistakes": [
   "牛肉没吸干就下锅，全程出水，最后变成灰白色的水煮肉。",
   "大火猛炖，肉纤维断裂成渣，汤汁浑浊。",
   "红酒一次倒太多又不收汁，成品酸涩发苦。"
  ],
  "subs": [
   {
    "orig": "牛腩",
    "sub": "牛腱子",
    "ratio": "900 克:900 克",
    "note": "胶质更多，炖制时间延长二十分钟。"
   },
   {
    "orig": "红酒",
    "sub": "红酒加高汤各半",
    "ratio": "750 毫升:400 加 350 毫升",
    "note": "酒味更淡，适合不喜浓酒味的人。"
   }
  ],
  "variations": [
   "加一把小洋葱同炖，甜味更突出。",
   "用铸铁锅连锅端上桌，保温效果更好。"
  ],
  "serving": "盛在宽口深盘里，配黄油土豆泥或切片乡村面包。",
  "storage": "冷藏三天、冷冻两个月；复热小火加少量高汤，避免干锅。",
  "nutrition": {
   "basis": "每份约 400 克",
   "kcal": 720,
   "protein": 48,
   "fat": 42,
   "carbs": 16,
   "sodium": 880
  },
  "safety": [
   "牛肉须炖至中心完全熟透、无血水，中心温度七十度以上；含红酒的汤汁充分煮沸挥发酒精；剩菜两小时内冷藏，复热须滚沸。"
  ],
  "origin": "勃艮第是法国红酒的故乡，农家把难炖的牛腩丢进本地红酒里慢火煨上半天，配上培根、胡萝卜和蘑菇。这道菜在二十世纪初被名厨写入经典菜谱，从此成了法国家常菜里最体面的一道。",
  "tags": [
   "法国",
   "牛肉",
   "红酒",
   "慢炖"
  ],
  "related": [
   "baguette",
   "boeuf-bourguignon"
  ]
