     {
      "n": "香菜",
      "a": 10,
      "u": "g",
      "note": "切碎"
     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "清水",
      "a": 1200,
      "u": "ml",
      "note": "一次加足"
     },
     {
      "n": "植物油",
      "a": 30,
      "u": "ml",
      "note": "煎鱼"
     },
     {
      "n": "盐",
      "a": 4,
      "u": "g",
      "note": "出锅前调"
     },
     {
      "n": "白胡椒",
      "a": 2,
      "u": "g",
      "note": "去腥提鲜"
     },
     {
      "n": "料酒",
      "a": 15,
      "u": "ml",
      "note": "腌鱼用"
     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "汤锅",
   "锅铲",
   "漏勺"
  ],
  "steps": [
   {
    "t": "鲫鱼两面各划两刀，抹上 15ml 料酒与少许盐，塞入一半姜片腌 10 分钟。",
    "time": 12,
    "heat": "无火",
    "tip": "划刀能让腥味散出，也更容易入味。",
    "cue": "鱼身表面微干、姜味明显"
   },
   {
    "t": "炒锅烧热下 30ml 植物油，把鲫鱼擦干后下锅，中火煎 3 分钟再翻面煎 3 分钟。",
    "time": 7,
    "heat": "中火",
    "tip": "鱼身擦干再下锅，皮才不破。",
    "cue": "两面金黄定型、鱼皮完整"
   },
   {
    "t": "冲入 1200ml 清水，放入剩余姜片与小葱段，大火煮开。",
    "time": 5,
    "heat": "大火",
    "tip": "一定要冲开水，汤才乳白。",
    "cue": "汤色迅速转白、浮沫浮起"
   },
   {
    "t": "撇净浮沫后转中小火炖 12 分钟，让鱼味充分溶进汤里。",
    "time": 13,
    "heat": "中小火",
    "tip": "保持微沸，汤才清甜不浑。",
    "cue": "汤色奶白、鱼身略散"
   },
   {
    "t": "放入豆腐厚片，继续小火煮 8 分钟至豆腐浮起。",
    "time": 9,
    "heat": "小火",
    "tip": "豆腐后放，久煮会碎成渣。",
    "cue": "豆腐边缘微孔、轻轻晃动"
   },
   {
    "t": "撒 4g 盐与 2g 白胡椒调味，关火撒香菜即可上桌。",
    "time": 2,
    "heat": "无火",
    "tip": "盐最后放，鱼肉才嫩。",
    "cue": "汤面浮着一层细腻油光"
   }
  ],
  "tips": [
   "煎鱼前把鱼身擦干，热锅冷油下鱼不粘皮。",
   "必须冲入开水，冷水会让汤色变灰。",
   "豆腐选老豆腐，炖久了也不容易碎。"
  ],
  "mistakes": [
   "鱼没擦干就下锅，鱼皮全粘在锅上。",
   "加冷水煮汤，汤色清灰带腥味。",
   "全程大火滚煮，鱼肉散成碎块。"
  ],
  "subs": [
   {
    "orig": "鲫鱼",
    "sub": "鲈鱼",
    "ratio": "500g 对 500g",
    "note": "刺更少，炖煮时间减 3 分钟。"
   },
   {
    "orig": "豆腐",
    "sub": "油豆腐",
    "ratio": "300g 对 200g",
    "note": "吸汤更强，盐减 1g。"
   }
  ],
  "variations": [
   "萝卜版：加 200g 白萝卜片同炖，汤更清甜。",
   "奶白浓汤版：煎好后加一勺猪油同煮。"
  ],
  "serving": "撒香菜趁热喝，配米饭与一碟拌菜。",
  "storage": "冷藏 1 天，复热时加少量清水小火煮开。",
  "nutrition": {
   "basis": "每份（约 400g）",
   "kcal": 260,
   "protein": 26,
   "fat": 14,
   "carbs": 6,
   "sodium": 760
  },
  "safety": [
   "鲫鱼细刺多，老人儿童食用时须仔细剔刺。",
   "汤须彻底煮开并保持沸腾 2 分钟以上再食用。"
  ],
  "origin": "鲫鱼豆腐汤是鲁菜里最家常的一道汤，讲究的是煎透再冲开水，靠鱼皮的胶质把汤煮成奶白，只用盐与白胡椒调味，鲜味全靠鱼本身，冬天喝一碗浑身暖和。",
  "tags": [
   "鲁菜",
