      "n": "清水",
      "a": 340,
      "u": "ml",
      "note": "比平时略少"
     },
     {
      "n": "植物油",
      "a": 20,
      "u": "ml",
      "note": "炒配料"
     },
     {
      "n": "盐",
      "a": 2,
      "u": "g",
      "note": "咸肉本身有咸味"
     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "电饭煲",
   "锅铲"
  ],
  "steps": [
   {
    "t": "大米淘洗两遍后沥干，静置 10 分钟让表面水分收干。",
    "time": 12,
    "heat": "无火",
    "tip": "米粒干爽，焖出的饭才不黏糊。",
    "cue": "米粒松散不粘连"
   },
   {
    "t": "咸肉丁冷水下锅煮 3 分钟，捞出沥干去除表面浮盐。",
    "time": 5,
    "heat": "中火",
    "tip": "先焯一遍，饭不会过咸。",
    "cue": "水面浮起白沫、咸肉转浅色"
   },
   {
    "t": "炒锅烧热下 20ml 植物油，倒入咸肉丁小火煸 4 分钟至边缘微焦。",
    "time": 5,
    "heat": "中火",
    "tip": "把咸肉的油煸出来，饭才香。",
    "cue": "咸肉出油透亮、锅底见油光"
   },
   {
    "t": "下青菜碎大火翻炒 2 分钟至变软出水，加 2g 盐炒匀。",
    "time": 3,
    "heat": "大火",
    "tip": "青菜炒软再焖，才不会发黄发苦。",
    "cue": "菜叶塌软、颜色转深绿"
   },
   {
    "t": "把大米倒入锅中与配料翻匀，一起移入电饭煲，加 340ml 清水。",
    "time": 3,
    "heat": "无火",
    "tip": "米和菜拌匀，味道才均匀。",
    "cue": "米菜混合均匀、水面与米齐平"
   },
   {
    "t": "按下煮饭键焖至跳闸，再焖 10 分钟开盖，用饭勺翻松即可。",
    "time": 20,
    "heat": "中火",
    "tip": "跳闸后别急着开盖，余温能让米心熟透。",
    "cue": "饭面平整油亮、有咸肉香气"
   }
  ],
  "tips": [
   "米水比约一比一点一，青菜出水会补足水分。",
   "咸肉先焯水再煸，饭的咸度更好控制。",
   "青菜要炒软再下锅焖，生青菜容易发黄。"
  ],
  "mistakes": [
   "咸肉直接下锅不焯水，整锅饭咸得发苦。",
   "清水按平时量加，青菜出水后饭变成粥。",
   "跳闸立刻开盖，米心发硬夹生。"
  ],
  "subs": [
   {
    "orig": "咸肉",
    "sub": "腊肉",
    "ratio": "120g 对 120g",
    "note": "腊肉带烟熏味，盐可再减 1g。"
   },
   {
    "orig": "青菜",
    "sub": "小白菜",
    "ratio": "200g 对 200g",
    "note": "出水更多，清水减 20ml。"
   }
  ],
  "variations": [
   "双拼版：咸肉与香肠各 60g，风味更甜。",
   "加笋版：拌入 80g 冬笋丁同焖，口感更脆。"
  ],
  "serving": "配一碗紫菜汤与一碟酱菜，是浙江人家冬天的一顿家常饭。",
  "storage": "冷藏 1 天，复热时撒一勺清水盖盖小火焖 5 分钟。",
  "nutrition": {
   "basis": "每份（约 320g）",
   "kcal": 560,
   "protein": 18,
   "fat": 16,
   "carbs": 84,
   "sodium": 860
  },
  "safety": [
   "咸肉属腌腊制品，须彻底煮透炒熟，高血压人群少食。",
   "焖饭时水量要足，避免锅底结焦产生焦糊物。"
  ],
  "origin": "咸肉菜饭是浙江冬日最朴素的焖饭，霜打过的青菜自带甜味，配上自家腌的咸肉，一锅焖出油润咸香，饭粒吸饱肉汁与菜汁，配一碗清汤就够一顿。",
  "tags": [
   "浙菜",
   "主食",
   "咸肉",
   "焖饭"
  ],
  "related": [
   "baozaifan",
   "larou-chaofan",
   "claypot-rice"
  ]
 },
 {
  "id": "jiyu-doufu-tang",
