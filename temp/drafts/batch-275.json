    "steps": [
      {
        "t": "橘皮用刀片去内侧白色瓤层，切成细丝，泡清水十分钟去苦味。",
        "time": 8,
        "heat": "无火",
        "tip": "白瓤是苦味来源，片得越干净成品越香。",
        "cue": "橘皮丝薄透，泡水后微微发亮。"
      },
      {
        "t": "橘皮丝下沸水焯一分钟，捞出用冷水冲凉后沥干。",
        "time": 3,
        "heat": "大火",
        "tip": "焯一遍能去掉涩口，也让皮丝更软。",
        "cue": "皮丝颜色转深，摸起来柔韧。"
      },
      {
        "t": "生抽、清水与白糖倒进小锅，小火煮到糖完全化开，放橘皮丝煮两分钟。",
        "time": 5,
        "heat": "小火",
        "tip": "火别开大，白糖一焦整锅酱都会带苦味。",
        "cue": "酱汁微稠，橘皮丝浮在表面。"
      },
      {
        "t": "关火后加香醋与蒜末搅匀，淋香油，放凉后装瓶冷藏。",
        "time": 4,
        "heat": "无火",
        "tip": "醋要关火后再加，橘香与酸香才留得住。",
        "cue": "酱色琥珀，闻着橘香带酸。"
      }
    ],
    "tips": [
      "橘皮选薄皮的砂糖橘或本地红橘，厚皮发苦。",
      "橘油酱在闽南多用来蘸白灼海鲜与炸物，解腻又开胃。",
      "做好的酱放一夜更入味，橘皮会变得柔软。"
    ],
    "mistakes": [
      "橘皮白瓤没片净，成品苦得没法入口。",
      "糖熬过头变焦糖色，酱带糊味。"
    ],
    "subs": [
