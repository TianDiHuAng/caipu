  "steps": [
   {
    "t": "章鱼洗净后放进冰箱冷冻半小时，让 fibres 放松再煮。",
    "time": 32,
    "heat": "无火",
    "tip": "冻过再煮，肉质更松，不会嚼起来像橡胶。",
    "cue": "章鱼表面收紧，触手自然卷"
   },
   {
    "t": "深锅烧一大锅清水，放香叶与盐，水开后再下章鱼。",
    "time": 12,
    "heat": "大火",
