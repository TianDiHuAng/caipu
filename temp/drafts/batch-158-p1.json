   "生菜带着水下碗，面包底部渗出一摊水。",
   "鸡蛋煮过了头，蛋黄发青还带着腥味。"
  ],
  "subs": [
   {
    "orig": "三文鱼",
    "sub": "烟熏三文鱼",
    "ratio": "150 克:150 克",
    "note": "咸味更足，盐要减半。"
   },
   {
    "orig": "奶油奶酪",
    "sub": "黄油",
    "ratio": "80 克:60 克",
    "note": "更腻，需配柠檬解腻。"
   }
  ],
  "variations": [
   "换成煮虾仁和蛋黄酱，做成海味版本。",
   "加几片腌黄瓜一起摆，酸味更清爽解腻。"
  ],
  "serving": "配一杯黑咖啡当早餐，或者切成小块当聚会小食。",
  "storage": "组装后当天吃完，面包冷藏会回软。",
  "nutrition": {
   "basis": "每份约 250 克",
   "kcal": 430,
