  "steps": [
   {
    "n": 1,
    "t": "鸡蛋冷水下锅煮八分钟，捞出过冷水后剥壳切片。",
    "time": 8,
    "heat": "中火",
    "tip": "煮八分钟蛋黄刚凝，切片才不会散。",
    "cue": "蛋黄边缘凝固，中心微润"
   },
   {
    "n": 2,
    "t": "奶油奶酪放小碗回温，拌入一半莳萝碎和少许盐。",
    "time": 3,
    "heat": "无火",
    "tip": "奶酪回温后更好抹，不会撕破面包。",
    "cue": "抹酱顺滑，能看到莳萝碎"
   },
   {
    "n": 3,
    "t": "平底锅放黄油化开，把面包片两面各煎一分半钟。",
    "time": 4,
    "heat": "中火",
    "tip": "面包煎到边缘金黄，咬下去才够脆。",
    "cue": "边缘金黄，表面干爽"
   },
   {
    "n": 4,
    "t": "生菜沥干水分，铺在煎好的面包片上当作垫底。",
    "time": 2,
    "heat": "无火",
    "tip": "生菜一定沥干，否则面包很快回软。",
    "cue": "生菜平铺，没有滴水"
   },
   {
    "n": 5,
    "t": "三文鱼片铺在生菜上面，均匀撒上盐和黑胡椒调味。",
    "time": 2,
    "heat": "无火",
    "tip": "鱼片顺着面包长边摆，造型更整齐。",
    "cue": "鱼片层叠整齐，有光泽"
   },
   {
    "n": 6,
    "t": "抹一勺莳萝奶酪，放上鸡蛋片和柠檬角即成。",
    "time": 3,
    "heat": "无火",
    "tip": "奶酪最后挤在空隙处，摆盘更有层次。",
    "cue": "表面点缀绿色莳萝与黄色柠檬"
   }
  ],
  "tips": [
   "面包煎到边缘金黄，口感才够香脆。",
   "生菜必须沥干水分，面包才不会回软。",
   "奶酪回温再抹，涂得开也不撕破面包。"
  ],
  "mistakes": [
