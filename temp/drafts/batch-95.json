  "steps": [
   {
    "t": "五花肉连皮切半厘米小丁，香菇泡软切丁，洋葱切细丁备用。",
    "time": 10,
    "heat": "无火",
    "tip": "肉丁切小一点，卤出来才黏唇、油而不腻。",
    "cue": "肉丁大小均匀，肥瘦相间"
   },
   {
    "t": "冷锅下五花肉丁中小火煸十分钟，逼出猪油至肉丁表面金黄。",
    "time": 12,
    "heat": "中火",
    "tip": "先煸出油再炒料，卤汁才香不腻。",
    "cue": "锅底积起清亮猪油，肉丁收缩变金"
   },
   {
    "t": "下洋葱丁与蒜末炒香，加冰糖继续炒到糖化开、肉丁裹上糖色。",
    "time": 6,
    "heat": "中火",
    "tip": "糖化开即可，炒到发黑就带苦味。",
    "cue": "肉丁油亮呈琥珀色"
   },
   {
    "t": "加香菇丁、生抽、老抽、五香粉、白胡椒粉和米酒翻炒两分钟。",
    "time": 3,
    "heat": "中火",
    "tip": "老抽只为上色，放多了整锅发黑。",
    "cue": "肉丁呈深酱色，香气上涌"
   },
   {
    "t": "倒入香菇泡水与热水共六百毫升，煮开后转小火盖盖卤四十五分钟。",
    "time": 47,
    "heat": "小火",
    "tip": "水面刚没过肉即可，卤太干会咸。",
    "cue": "汤汁微沸，表面浮一层红油"
   },
   {
    "t": "放入剥壳鸡蛋同卤十分钟，青菜用沸水烫三十秒捞出。",
    "time": 11,
    "heat": "小火",
    "tip": "鸡蛋后放才不会卤成铁蛋。",
    "cue": "鸡蛋表面染成浅褐色"
   },
   {
    "t": "米饭盛碗，浇上卤肉与卤汁，配卤蛋、青菜，撒香菜。",
    "time": 4,
    "heat": "无火",
    "tip": "卤汁要浇到饭上渗下去，这是这碗饭的精髓。",
    "cue": "白饭被酱汁浸成深褐色"
   }
  ],
  "tips": [
   "想更接近台式风味，可用红葱酥代替部分洋葱丁。",
   "卤汁可以留用，下次卤豆腐、卤蛋都很香。",
   "五花肉肥瘦比例三七最好，全瘦会柴。"
  ],
  "mistakes": [
   "肉丁切得太大块，卤完口感像红烧肉而不是卤肉。",
   "糖色炒过头，整锅卤汁发苦发黑。",
   "卤的时间不够，猪皮发硬、胶质没出来。"
  ],
  "subs": [
