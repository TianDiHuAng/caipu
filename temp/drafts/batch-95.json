  "variations": [
   "加入油豆腐或笋丁同卤，可做更丰富的综合卤味。"
  ],
  "serving": "配卤蛋、烫青菜与一碗清汤，撒白胡椒。",
  "storage": "卤肉冷藏四天、冷冻一个月，卤汁可反复使用；复热加少量水小火煮开。",
  "nutrition": {
   "basis": "每份约 400 克",
   "kcal": 690,
