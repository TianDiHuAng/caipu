  "steps": [
   {
    "t": "芥蓝削去根部老皮，粗茎处纵向划一刀，洗净后沥干水分。",
    "time": 6,
    "heat": "无火",
    "tip": "划刀能让粗茎与嫩叶同时熟，避免茎生叶烂。",
    "cue": "茎部露出浅色嫩肉"
   },
   {
    "t": "清水加盐与 5ml 植物油烧开，先下芥蓝茎部烫 40 秒，再整棵入水烫 40 秒。",
    "time": 2,
    "heat": "大火",
    "tip": "水中加油能让菜叶保持翠绿发亮。",
    "cue": "芥蓝由深绿转为鲜亮的翠绿"
   },
   {
    "t": "捞出立刻放入冰水或冷开水中过凉 30 秒，沥干后整齐码盘。",
    "time": 1,
    "heat": "无火",
    "tip": "过凉能锁住颜色与脆度，摆盘也更挺。",
    "cue": "菜梗掰开有清脆声"
   },
   {
    "t": "小奶锅放生抽、蚝油、白糖与 20ml 清水小火煮开成豉油，浇在芥蓝上。",
    "time": 2,
    "heat": "小火",
    "tip": "豉油要煮开再用，生酱油有生涩味。",
    "cue": "豉油微稠、表面泛起细泡"
   },
   {
    "t": "锅烧热 20ml 植物油至冒烟，铺上姜丝葱丝，热油浇在葱姜上激香。",
    "time": 1,
    "heat": "中大火",
    "tip": "油温要够高，浇下去能听到明显的滋啦声。",
    "cue": "葱姜瞬间卷曲、香气冲起"
   }
  ],
  "tips": [
   "焯水时间按茎的粗细调整，粗茎可多烫 20 秒。",
   "豉油本身有咸味，焯水时盐只放 4g，避免过咸。",
   "没有芥蓝时可用菜心或西兰花，焯水时间相应缩短。"
  ],
  "mistakes": [
