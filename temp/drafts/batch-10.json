   "焯完不过凉水，余温继续加热，颜色变暗。",
   "豉油直接浇生酱油，缺少煮开的醇厚感。"
  ],
  "subs": [
   {
    "orig": "芥蓝",
    "sub": "菜心",
    "ratio": "1:1",
    "note": "菜心更嫩，焯水时间减到 40 秒。"
   },
   {
    "orig": "蚝油",
    "sub": "蒸鱼豉油",
    "ratio": "10g 蚝油 ≈ 10ml 蒸鱼豉油",
    "note": "咸度更高，生抽减到 15ml。"
   }
  ],
  "variations": [
   "蒜蓉版：焯好后铺蒜末再泼油，辛香更足。",
   "上汤版：用 150ml 高汤加皮蛋碎煮开淋上，做成上汤芥蓝。"
  ],
  "serving": "作为粤式家常餐桌的青菜位，配烧腊或煲仔饭最合适。",
  "storage": "现做现吃，冷藏后颜色会变暗；剩余可切碎做炒饭。",
  "nutrition": {
   "basis": "每份（约 1/2 量）",
   "kcal": 120,
   "protein": 4,
   "fat": 9,
   "carbs": 6,
   "sodium": 640
  },
  "safety": [
   "芥蓝属十字花科，焯水要足量沸水，确保茎部熟透易嚼。",
   "泼油时油温高，操作时脸不要正对锅口。",
