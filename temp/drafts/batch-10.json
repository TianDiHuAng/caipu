  "steps": [
   {
    "t": "五花肉整块冷水下锅，加姜片、花椒、料酒与盐 2g，大火烧开后撇净浮沫。",
    "time": 5,
    "heat": "大火",
    "tip": "冷水下锅能让血水慢慢析出，肉腥味更少。",
    "cue": "水面浮起灰白浮沫，撇净后汤色转清"
   },
   {
    "t": "转小火保持水面微沸煮 25 分钟，用温度计确认肉块中心达到 72℃ 以上。",
    "time": 25,
    "heat": "小火",
    "tip": "全程小火，大滚会让肉质变柴、肥肉散开。",
    "cue": "竹签能轻松插入且无血水渗出"
   },
   {
    "t": "捞出肉块放入冰水浸泡 10 分钟，肉皮收紧后切成 1.5mm 薄片。",
    "time": 10,
    "heat": "无火",
    "tip": "冰镇后肉片更挺括好切，切面也更整齐。",
    "cue": "肉片边缘紧实，肥瘦界线分明不散"
   },
   {
    "t": "蒜泥加生抽、白糖、香醋、辣椒油与余下的盐调成料汁，静置 5 分钟让蒜味渗出。",
    "time": 5,
    "heat": "无火",
    "tip": "蒜泥要现捣，久放会发苦发绿。",
    "cue": "料汁红亮，蒜香扑鼻"
   },
   {
    "t": "黄瓜片铺盘底，肉片呈扇形叠放，淋料汁后撒葱花与熟芝麻。",
    "time": 3,
    "heat": "无火",
    "tip": "肉片之间留缝，料汁才能渗进每一片。",
    "cue": "料汁沿肉片缝隙渗入，盘底聚成红色汁水"
   }
  ],
  "tips": [
   "肉块煮好后压重物冷藏 20 分钟，切出的片更薄更均匀。",
   "蒜泥与辣椒油的比例可按吃辣程度调整，减油时补 5ml 生抽。",
   "剩下煮肉的原汤可加白菜煮汤，不浪费。"
  ],
  "mistakes": [
   "肉煮好后趁热切，肥瘦分离、片形散乱。",
   "蒜泥用刀剁而非捣，蒜香不足且出水多。",
   "料汁一次浇太多，肉片泡在汁里变咸。"
  ],
