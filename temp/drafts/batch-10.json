  "variations": [
   "家庭简化版：用现成蒜泥白肉调料包，蒜泥另加一勺现捣蒜，香气更足。",
   "卷饼版：肉片卷黄瓜条，蘸料汁吃，适合夏天。"
  ],
  "serving": "冷盘上桌，配米饭或面食；宴客时可与口水鸡组成双拼冷盘。",
  "storage": "肉块冷藏 2 天，料汁单独存放；肉片不建议冷冻，解冻后会出水。",
  "nutrition": {
   "basis": "每份（约 1/3 量）",
   "kcal": 520,
   "protein": 24,
   "fat": 44,
   "carbs": 6,
   "sodium": 880
