  {
    "id": "nordic-surstromming",
    "zh": "北欧腌鲭鱼",
    "en": "Nordic Fermented Mackerel",
    "original": "Surstromming",
    "cuisine": "nordic",
    "category": [
      "fermented"
    ],
    "difficulty": 2,
    "servings": 10,
    "flavor": [
      "salty",
      "sour",
      "umami"
    ],
    "equipment": [
