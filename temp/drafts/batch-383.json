    "steps": [
      {
        "t": "雪菜掰成小段，用清水反复淘洗两三遍，去掉根部的泥沙与老叶。",
        "time": 12,
        "heat": "无火",
        "tip": "根缝里藏的泥最难洗，掰开洗比整棵泡更干净。",
        "cue": "叶片清爽无泥，水变清"
      },
      {
        "t": "洗净的菜摊在竹席上放到通风处晾一天，晾到叶面发软、捏起来不再脆断。",
        "time": 14,
        "heat": "无火",
        "tip": "晾蔫是脆爽的前提，水太多腌出来会烂成泥。",
        "cue": "菜叶打蔫，体积缩了一半"
      },
      {
        "t": "把晾好的菜切成两厘米长的段，放进大盆里。",
        "time": 8,
        "heat": "无火",
        "tip": "切段比整棵腌更入味，也方便日后取用。",
        "cue": "菜段大小均匀，堆在盆里"
      },
      {
        "t": "撒盐后用手反复揉搓十分钟，揉到菜段出水、颜色转深。",
        "time": 12,
        "heat": "无火",
        "tip": "揉出汁水是关键，盐水没出来腌菜就不酸。",
        "cue": "菜段湿润发亮，盆底见汁"
      },
      {
        "t": "加姜丝、蒜末与红辣椒段，倒米酒与白糖，抓拌均匀。",
        "time": 5,
        "heat": "无火",
        "tip": "糖不是为甜，是给乳酸菌当口粮，发酵更快更稳。",
        "cue": "配料分布均匀，闻到辛辣香"
      },
      {
        "t": "把拌好的菜装进陶坛，边装边压实，尽量排出里面的空气。",
        "time": 8,
        "heat": "无火",
        "tip": "压得越实越不容易坏，空气留在缝里就会长白膜。",
        "cue": "坛内蔬菜紧实，表面平整"
      },
      {
        "t": "坛口盖一层干净布，压上重石，倒清水封住坛沿，放在阴凉处。",
        "time": 6,
        "heat": "无火",
        "tip": "坛沿的水要常补，干了就漏气，整坛菜会坏。",
        "cue": "重石压稳，坛沿水面平满"
      },
      {
        "t": "静置发酵七到十天，酸味明显、菜段透亮时即可开坛取食。",
        "time": 10,
        "heat": "无火",
        "tip": "天气热三五天就酸了，尝一次再决定要不要再等。",
        "cue": "坛内酸香扑鼻，菜色黄亮"
      }
    ],
    "tips": [
      "雪菜是云南酸腌菜的传统主料，没有可用芥菜替，风味略苦更香。",
      "全程不能沾生水和油，碰过一次油整坛都会起白花。",
      "取菜时用干净无水的筷子，取完把坛沿水补满。",
      "腌好的菜炒肉末或煮汤都好吃，是云南厨房的常备底味。"
    ],
    "mistakes": [
      "菜洗好直接腌，水没晾干，坛里两天就飘起一层白膜。",
      "盐放太少想靠时间长补，结果菜烂成糊，酸味也不正。",
      "坛沿水干了没补，漏气后菜发霉发臭，只能整坛倒掉。"
    ],
    "subs": [
      {
        "orig": "雪菜",
        "sub": "芥菜",
        "ratio": "1000克:1000克",
        "note": "苦味轻一些，盐可少放三克。"
      },
      {
        "orig": "米酒",
        "sub": "高粱酒",
        "ratio": "30毫升:30毫升",
        "note": "度数高，抑菌更强，用量不变。"
      }
    ],
    "variations": [
      "加一把小米辣与花椒，做成更冲的麻辣口味。",
      "把雪菜换成萝卜缨，腌出来更脆，酸味也更冲。"
    ],
    "serving": "八份小碟，配米线、炒饭或白粥，酸脆解腻。",
    "storage": "坛装冷藏能放三个月，取用时器具须干燥无油；表面起白膜可撇去并补一勺白酒。",
    "nutrition": {
