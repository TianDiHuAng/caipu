    "ingredients": [
      {
        "group": "main",
        "items": [
          {
            "n": "鲭鱼",
            "a": 800,
            "u": "g",
            "note": "去头去内脏，留皮"
          }
        ]
      },
      {
        "group": "aux",
        "items": [
          {
            "n": "洋葱",
            "a": 120,
            "u": "g",
            "note": "切片，配食"
          },
          {
            "n": "莳萝",
            "a": 20,
            "u": "g",
            "note": "新鲜，铺罐底"
          }
        ]
      },
      {
        "group": "seasoning",
        "items": [
          {
            "n": "盐",
            "a": 60,
            "u": "g",
            "note": "粗盐"
          },
          {
            "n": "白糖",
            "a": 30,
            "u": "g",
            "note": "助发酵"
          },
          {
            "n": "清水",
            "a": 1000,
            "u": "ml",
            "note": "盐水用"
          }
        ]
      }
    ],
    "steps": [
      {
        "t": "鲭鱼去头去内脏，保留鱼皮，用清水冲净血水，再用厨房纸彻底吸干表面水分。",
        "time": 12,
        "heat": "无火",
        "tip": "血水与水分都要彻底去干净，残留的水会让鱼在罐里腐坏。",
        "cue": "鱼身干爽，腹腔无血丝"
      },
      {
        "t": "按每一升清水配六十克粗盐的比例调成浓盐水，搅到盐粒完全化开。",
        "time": 5,
        "heat": "无火",
        "tip": "盐水要饱和，盐不够就压不住杂菌，鱼会变臭而不是变酸。",
        "cue": "盐水清亮，底部略有未化盐粒"
      },
      {
        "t": "玻璃罐底铺一层莳萝，把鲭鱼逐条码进罐里，鱼皮朝外、腹部朝内。",
        "time": 8,
        "heat": "无火",
        "tip": "码得紧一些，减少罐内空气，发酵才均匀。",
        "cue": "鱼身紧密叠放，罐壁可见鱼皮"
      },
      {
        "t": "撒入剩余盐与白糖，倒入浓盐水淹没全部鱼身，留两指宽的顶部空间。",
        "time": 4,
        "heat": "无火",
        "tip": "顶部要留空间，发酵会产生气体，罐子灌满容易胀裂。",
        "cue": "液面高出鱼身，罐口留空"
      },
      {
        "t": "盖紧罐盖，旁边备一碟切好的洋葱，取用时配着同吃，前三天每天开盖放一次气。",
        "time": 6,
        "heat": "无火",
        "tip": "开盖放气时要慢慢拧，气体冲出来会带汤汁喷溅。",
        "cue": "开盖时听到放气声，液面有气泡"
      },
      {
        "t": "静置发酵六到八周，罐身微微鼓起、汤汁变浑、气味浓烈即成熟。",
        "time": 5,
        "heat": "无火",
        "tip": "发酵温度越低时间越长，冰箱冷藏发酵风味更温和。",
        "cue": "罐身微鼓，汤汁浑浊"
      }
    ],
    "tips": [
      "开罐前先冷藏几小时，低温能减少气体喷出。",
      "传统吃法配薄饼、洋葱丝与煮土豆，气味被面饼裹住更好入口。",
      "罐身若出现黑霉或液体发黏，说明杂菌污染，必须整罐丢弃。",
      "初尝者建议在户外开罐，气味非常强烈。"
    ],
    "mistakes": [
      "盐量不足省成本，鱼在罐里腐坏发臭，只能整罐倒掉。",
      "鱼没吸干水就入罐，汤汁很快发浑长膜。",
      "罐子装得太满不留空隙，发酵产气后胀裂漏液。"
    ],
    "subs": [
