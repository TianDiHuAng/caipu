  "steps": [
   {
    "n": 1,
    "t": "鸡蛋磕进大碗里，加盐和黑胡椒，用打蛋器搅打到完全均匀。",
    "time": 6,
    "heat": "无火",
    "tip": "蛋液要打到看不见蛋黄丝，烘出来颜色才一致。",
    "cue": "蛋液均匀，表面起细泡"
   },
   {
    "n": 2,
    "t": "土豆去皮切成两毫米厚的薄片，泡水洗掉表面黏液后沥干。",
    "time": 8,
    "heat": "无火",
    "tip": "土豆片切薄些，才能在烘蛋里彻底熟透。",
    "cue": "土豆片透光，沥干不滴水"
   },
   {
    "n": 3,
    "t": "平底锅倒橄榄油，下洋葱丝和土豆片中火炒到变软。",
    "time": 7,
    "heat": "中火",
    "tip": "土豆先炒软再倒蛋液，才不会夹生发硬。",
    "cue": "土豆边缘透明，洋葱软塌"
   },
   {
    "n": 4,
    "t": "把蛋液均匀浇在锅里，转小火盖盖烘八分钟定型。",
    "time": 8,
    "heat": "小火",
    "tip": "小火慢烘，底面金黄而中间不会起蜂窝。",
    "cue": "蛋面凝固，边缘微鼓"
   },
   {
    "n": 5,
    "t": "表面均匀撒上奶酪丝，盖盖再烘两分钟到奶酪完全化开。",
    "time": 2,
    "heat": "小火",
    "tip": "奶酪刚化开就好，烘久了会出油分离。",
    "cue": "奶酪融化，蛋面油亮"
   },
   {
    "n": 6,
    "t": "关火静置两分钟，用锅铲沿边松动后滑到盘中切块。",
    "time": 3,
    "heat": "无火",
    "tip": "静置两分钟蛋饼才定型，切块时不会散。",
    "cue": "蛋饼平整，切块利落"
   }
  ],
  "tips": [
   "土豆片切薄并先炒软，烘蛋的中心才不会夹生。",
   "全程保持小火慢烘，蛋面才平整不起蜂窝。",
   "关火后静置两分钟再切，块形完整不会散开。"
  ],
  "mistakes": [
   "大火烘蛋，底面焦黑而中心还是流动的液体。",
   "土豆片切得太厚，成品中心硬得咬不动。",
   "奶酪放得太早又烘久了，表面结出一层油膜。"
  ],
  "subs": [
   {
    "sub": "西葫芦",
    "ratio": "200 克:220 克",
    "note": "切片后无需泡水，炒制时间减两分钟。",
    "orig": "土豆"
   },
   {
    "sub": "淡奶油",
    "ratio": "60 克:40 毫升",
    "note": "拌进蛋液里，奶香更柔和。",
    "orig": "奶酪"
   }
  ],
  "variations": [
   "蛋液里加两勺清水，烘出来更蓬松柔软。",
   "出锅前撒一把奶酪丝，表面拉丝更好看。"
  ],
  "serving": "温热时切块装盘，配一份番茄沙拉就是清爽的一餐。",
  "storage": "冷藏两天，复热用平底锅小火两面各煎一分钟。",
  "nutrition": {
   "basis": "每份约 200 克",
   "kcal": 300,
   "protein": 17,
   "fat": 21,
   "carbs": 14,
   "sodium": 520
  },
  "safety": [
   "鸡蛋须烘至完全凝固、中心熟透，不要生食或半熟；成品冷藏不超过一天，复热须彻底加热。"
  ],
  "origin": "意大利家庭最省事的一道蛋菜，把剩菜和鸡蛋一起在平底锅里烘定型。蛋饼厚实绵密，土豆和洋葱的甜味混在奶香里，冷吃也很好。",
  "tags": [
   "意大利",
   "鸡蛋",
   "家常菜",
   "烤箱菜"
  ],
