    "tip": "洋葱只炒到透明，别炒上色。",
    "cue": "洋葱透明柔软"
   },
   {
    "n": 3,
    "t": "撒入普通面粉翻炒一分钟，把生粉味炒掉。",
    "time": 3,
    "heat": "小火",
    "tip": "面粉一定要炒过，汤才不夹生味。",
    "cue": "面粉微微发黄"
   },
   {
    "n": 4,
    "t": "倒入清水和土豆丁煮开，转小火煮十五分钟至土豆软烂。",
    "time": 17,
    "heat": "小火",
    "tip": "水开后转小火，土豆才不会煮散。",
    "cue": "土豆一压就烂"
   },
   {
    "n": 5,
    "t": "放入鳕鱼块小火煮五分钟，鱼块变白后轻轻拨散。",
    "time": 6,
    "heat": "小火",
    "tip": "鱼块后放，煮久就散成渣。",
    "cue": "鱼块雪白不散"
   },
   {
    "n": 6,
    "t": "倒入牛奶加热到微沸，加盐和黑胡椒调味，撒欧芹末盛出。",
    "time": 5,
    "heat": "小火",
    "tip": "牛奶不要煮滚，否则会起皮结块。",
    "cue": "汤色乳白，表面浮绿末"
   }
  ],
  "tips": [
   "土豆切得越小越容易煮化，汤体自然变浓稠。",
   "面粉要先用黄油炒过，才能去掉生粉味。",
   "牛奶最后加且不要煮滚，避免起皮结块。"
  ],
  "mistakes": [
