  "steps": [
   {
    "n": 1,
    "t": "土豆削皮切成小丁，洋葱去皮切碎后放在一旁备用。",
    "time": 8,
    "heat": "无火",
    "tip": "土豆切小一点，煮起来才容易化开。",
    "cue": "土豆丁大小均匀"
   },
   {
    "n": 2,
    "t": "汤锅里化开黄油，下洋葱碎小火炒到透明出香。",
    "time": 6,
