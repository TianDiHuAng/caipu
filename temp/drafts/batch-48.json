      "a": 5,
      "u": "g",
      "note": "焯水与调味"
     },
     {
      "n": "生抽",
      "a": 20,
      "u": "ml",
      "note": "调味"
     },
     {
      "n": "香醋",
      "a": 15,
      "u": "ml",
      "note": "增酸"
     },
     {
      "n": "白糖",
      "a": 5,
      "u": "g",
      "note": "提鲜"
     },
     {
      "n": "香油",
      "a": 8,
      "u": "ml",
      "note": "增香"
     },
     {
      "n": "花椒",
      "a": 2,
      "u": "g",
      "note": "增麻"
     }
    ]
   }
  ],
  "equipment": [
   "汤锅",
   "漏勺",
   "碗"
  ],
  "steps": [
   {
    "n": 1,
    "text": "毛豆 500g 洗净，用剪刀剪去豆荚两端，方便入味。",
    "time_min": 6,
    "heat": "无火",
    "tip": "剪口是关键，不剪味道进不去。",
    "visual_cue": "豆荚两端开口、颜色翠绿"
   },
   {
    "n": 2,
    "text": "锅中加水烧开，放 3g 盐与毛豆，中火煮 8 分钟至豆粒熟透。",
    "time_min": 10,
    "heat": "中火",
    "tip": "煮到豆粒能用指甲掐开即可。",
    "visual_cue": "豆粒饱满、豆荚转深绿"
   },
   {
    "n": 3,
    "text": "捞出毛豆立刻放入冰水中浸泡 3 分钟，捞出沥干水分。",
    "time_min": 4,
    "heat": "无火",
    "tip": "冰水过凉，口感才脆不发面。",
    "visual_cue": "毛豆翠绿、表面无水珠"
   },
   {
    "n": 4,
    "text": "碗中放蒜末 15g、干辣椒段 6g、花椒 2g，浇上烧至冒烟的热油。",
    "time_min": 3,
    "heat": "中火",
    "tip": "油要烧到微微冒烟才激得出香。",
    "visual_cue": "辣椒变深红、香气冲鼻"
   },
   {
    "n": 5,
    "text": "加 20ml 生抽、15ml 香醋、5g 白糖与 2g 盐拌成调味汁。",
    "time_min": 2,
    "heat": "无火",
    "tip": "糖能压住醋的尖酸，别省。",
    "visual_cue": "调味汁红褐透亮"
   },
   {
    "n": 6,
    "text": "把毛豆倒入调味汁中拌匀，淋 8ml 香油，冷藏 30 分钟后食用。",
    "time_min": 3,
    "heat": "无火",
    "tip": "冷藏半小时，味道才真正渗进去。",
    "visual_cue": "豆荚挂汁、色泽油亮"
   }
  ],
  "tips": [
   "毛豆剪口再煮，调味才吃得进去。",
   "煮好立刻过冰水，脆度差别很大。",
   "拌好冷藏半小时风味最好，现拌现吃偏淡。"
  ],
  "mistakes": [
   "整颗毛豆不剪口，拌完只有表面有味。",
   "煮过头豆粒发面，一拌就烂。",
   "热毛豆直接拌汁，出水后味道全稀释。"
  ],
  "subs": [
   {
    "orig": "毛豆",
    "sub": "带壳花生",
    "ratio": "500g 对 400g",
    "note": "煮制时间延长到 25 分钟。"
   },
   {
    "orig": "香醋",
    "sub": "米醋",
    "ratio": "15ml 对 15ml",
    "note": "酸味更柔和。"
   }
  ],
  "variations": [
   "加 5g 白芝麻，香气更足。",
   "拌入 10g 剁椒，辣味更鲜。"
  ],
  "serving": "装盘冷藏上桌，配啤酒或作为饭前小菜。",
  "storage": "冷藏可存 2 天，汤汁会变深属正常现象。",
  "nutrition": {
   "basis": "每份（约 130g）",
   "kcal": 130,
   "protein": 8,
   "fat": 6,
   "carbs": 10,
   "sodium": 520,
   "disclaimer": "按配料表用量与常见食材成分表推算，实际数值随品牌与烹饪损耗浮动。"
  },
  "safety": [
   "毛豆须煮透，生豆含皂苷与胰蛋白酶抑制剂。",
   "含大豆过敏原，过敏人群请避开。"
  ],
  "origin": "凉拌毛豆是湖南夏夜宵夜摊的常客，毛豆剪口后煮透，浇一勺滚油激香的蒜末辣椒，再拌上生抽香醋。冰镇后豆荚脆嫩、麻辣咸鲜，配一瓶冰啤酒就是整个夏天的味道。",
  "related": [
   "lei-lajiao-pidan",
   "suanla-ouding"
  ]
 },
 {
