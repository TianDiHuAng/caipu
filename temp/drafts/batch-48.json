   "保鲜膜"
  ],
  "steps": [
   {
    "n": 1,
    "text": "猪肉末 400g 加 3g 盐、15ml 生抽与 15ml 料酒，顺一个方向搅打上劲。",
    "time_min": 6,
    "heat": "无火",
    "tip": "搅到黏稠抱团，馅料才不散。",
    "visual_cue": "肉料黏稠、能整团提起"
   },
   {
    "n": 2,
    "text": "取 100g 猪肉末与 150g 土豆淀粉混合，加 40ml 清水揉成偏硬的面团。",
    "time_min": 10,
    "heat": "无火",
    "tip": "淀粉要分次加，太干再加少许水。",
    "visual_cue": "面团光滑、按下去有回弹"
   },
   {
    "n": 3,
    "text": "把面团放保鲜膜内，用擀面杖擀成 1 毫米厚的薄片，切成 8 厘米方块。",
    "time_min": 12,
    "heat": "无火",
    "tip": "越薄越好，透光能看到手指。",
    "visual_cue": "薄片透光、边缘整齐"
   },
   {
    "n": 4,
    "text": "取一片燕皮放在掌心，放 12g 肉料，对折后捏紧边缘成燕尾形。",
    "time_min": 10,
    "heat": "无火",
    "tip": "边缘蘸点水，收口才粘得牢。",
    "visual_cue": "外形像燕尾、封口紧实"
   },
   {
    "n": 5,
    "text": "汤锅倒 800ml 高汤烧开，下肉燕中火煮 6 分钟至浮起。",
    "time_min": 7,
    "heat": "中火",
    "tip": "浮起再煮 2 分钟，皮才熟透。",
    "visual_cue": "肉燕浮面、表皮半透明"
   },
   {
    "n": 6,
    "text": "碗中加 2g 盐、2g 白胡椒粉与葱末，冲入煮肉燕的高汤。",
    "time_min": 3,
    "heat": "无火",
    "tip": "先冲汤再放肉燕，皮不容易泡软。",
    "visual_cue": "汤色清亮、葱末浮起"
   },
   {
    "n": 7,
    "text": "把煮好的肉燕盛入碗中，淋 5ml 香油即可上桌。",
    "time_min": 2,
    "heat": "无火",
    "tip": "香油最后淋，香气最清。",
    "visual_cue": "皮薄透亮、汤面浮油细碎"
   }
  ],
  "tips": [
   "燕皮擀得越薄越好，透光才算到位。",
   "肉料分两次用，一半做馅一半打皮。",
   "肉燕浮起后再煮两分钟，皮才真正熟透。"
  ],
  "mistakes": [
