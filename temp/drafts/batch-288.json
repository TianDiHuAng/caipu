    "steps": [
      {
        "t": "猪前腿肉剔净筋膜，顺纹切成两厘米粗的长条，用竹签在肉条上扎些小孔。",
        "time": 15,
        "heat": "无火",
        "tip": "扎孔让盐和香料渗进去，成品才有卤香不发白。",
        "cue": "肉条表面布满细孔，颜色鲜红。"
      },
      {
        "t": "盐与花椒下锅小火炒到微黄，摊凉后拌进肉条揉匀，冷藏腌制两小时。",
        "time": 125,
        "heat": "无火",
        "tip": "腌足两小时肉才紧实，时间短了切片容易散。",
        "cue": "肉条出水，颜色转为暗红。"
      },
      {
        "t": "猪皮冷水下锅煮五分钟，捞出刮净内侧肥膘和表面浮毛，再切成细条洗净。",
        "time": 15,
        "heat": "中火",
        "tip": "肥膘一点不剩才叫水晶，留了油脂冻就发白不透。",
        "cue": "猪皮半透明，内侧干净无油。"
      },
      {
        "t": "汤锅放清水、猪皮条、八角、桂皮、姜片和大葱段，大火烧开撇净浮沫。",
        "time": 12,
        "heat": "大火",
        "tip": "浮沫要撇两遍，汤清了凝出的冻才透亮。",
        "cue": "汤面浮沫聚成块，汤色转清。"
      },
      {
        "t": "腌好的肉条冲去花椒粒下锅，加料酒转小火煮九十分钟，煮到筷子能轻易穿透。",
        "time": 95,
        "heat": "小火",
        "tip": "全程小火，滚大了猪皮化不开，汤汁也会浑。",
        "cue": "肉条浮起，筷子轻插即透。"
      },
      {
        "t": "把肉条顺纹排进模具压紧，浇入过滤的热汤没过肉面，盖纱布压重物冷藏四小时。",
        "time": 245,
        "heat": "无火",
        "tip": "重物压够时间肉才紧，冻里不留气孔，切片才不散。",
        "cue": "汤面凝固成半透明胶冻。"
      },
      {
        "t": "脱模后切成半厘米厚片，码盘时皮冻朝上，配姜丝和香醋一起上桌。",
        "time": 10,
        "heat": "无火",
        "tip": "刀蘸热水再切，切口平整，皮冻不会拉出毛边。",
        "cue": "肉片红白分明，胶冻晶莹透亮。"
      }
    ],
    "tips": [
      "肉选前腿瘦肉，纹理细、结缔组织少，冻起来才不柴。",
      "猪皮与瘦肉的比例约一比二点五，胶质刚好能裹住肉条。",
      "煮肉的汤要留足没过肉面，汤少了凝不成完整的冻。"
    ],
    "mistakes": [
      "猪皮肥膘没刮净，冻子发白不透，吃起来满口油。",
      "煮的火太大，猪皮碎烂汤发浑，切出来一塌糊涂。",
      "冷藏时间不够就脱模，冻未凝实，一切就散成碎块。"
