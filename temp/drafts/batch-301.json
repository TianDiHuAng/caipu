    "steps": [
      {
        "t": "五花肉切成黄豆大小的肉丁，大葱切葱花、姜切末，黄瓜切细丝装小碟。",
        "time": 12,
        "heat": "无火",
        "tip": "肉丁别用绞碎的肉代替，炸酱要能咬到颗粒才香。",
        "cue": "肉丁大小一致，肥瘦相连。"
      },
      {
        "t": "甜面酱与黄豆酱放碗里，分次加清水澥开成无颗粒的稀酱。",
        "time": 4,
        "heat": "无火",
        "tip": "酱一定要提前澥开，直接下锅容易结块糊底。",
        "cue": "酱汁顺滑，用勺舀起能缓缓流下。"
      },
      {
        "t": "锅中放植物油烧热，下五花肉丁中火煸到出油、边缘微焦。",
        "time": 6,
        "heat": "中火",
        "tip": "肉丁煸到出油，炸酱才不会腻，酱也更容易挂住肉丁。",
        "cue": "肉丁卷缩出油，锅底积一层清亮油。"
      },
      {
        "t": "转小火下葱花和姜末炒香，再倒入澥好的酱，用锅铲不停推炒。",
        "time": 5,
        "heat": "小火",
        "tip": "全程小火，酱一焦就发苦，宁可多炒两分钟也别开大火。",
        "cue": "酱色转深发亮，油与酱开始分离。"
      },
      {
        "t": "加白糖调味，继续小火熬到酱稠厚、表面浮起一层亮油即可关火。",
        "time": 8,
        "heat": "小火",
        "tip": "熬到油酱分离才叫炸透，这时候酱香最浓、也不涩口。",
        "cue": "酱稠得能挂住铲子，边缘浮出清油。"
      },
      {
        "t": "面条煮熟后过一遍热汤，捞进碗里，舀上炸酱，配黄瓜丝和焯好的豆芽拌开。",
        "time": 7,
        "heat": "大火",
        "tip": "面要热、酱要烫，凉的炸酱拌面不香也不化。",
        "cue": "面上酱色油亮，配菜清爽翠绿。"
      }
    ],
    "tips": [
      "甜面酱与黄豆酱按二比一配，咸鲜层次比单用一种更厚。",
      "酱必须提前用清水澥开，下锅才不结块。",
      "小火熬到油酱分离再关火，这是炸酱香而不涩的关键。"
    ],
    "mistakes": [
      "酱没澥开直接下锅，锅里结成一坨坨硬块，还容易糊底。",
      "图快用大火炒酱，酱色发黑带焦苦，整碗面都毁了。",
      "肉丁切得太小或用绞碎的肉，炸酱只有咸味没有咬劲。"
    ],
    "subs": [
      {
        "orig": "甜面酱",
        "sub": "黄豆酱",
        "ratio": "60克:60克",
        "note": "只用黄豆酱则咸味更重，需多加五克白糖平衡。"
      },
      {
        "orig": "五花肉",
        "sub": "牛肉",
        "ratio": "180克:180克",
        "note": "换成牛肉丁做炸酱，风味更清爽不腻。"
      }
    ],
    "variations": [
      "济南人家会加一把剁碎的韭菜末，酱香里带一股辛香。",
      "加几个香菇丁同炒，素炸酱的鲜味也够足。"
    ],
    "serving": "炸酱面拌好后配一碟黄瓜丝、一小把豆芽，再来瓣蒜，就是济南人夏天的一顿正经饭。",
    "storage": "炸酱冷藏可存五天，面条现煮现拌，拌剩的面不建议隔夜。",
    "nutrition": {
      "basis": "按三人份估算",
