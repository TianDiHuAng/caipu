    "steps": [
      {
        "t": "面条煮到八成熟捞出，过凉水后拌入少许植物油抖散摊开。",
        "time": 8,
        "heat": "大火",
        "tip": "煮八成熟就够，炒的时候还会继续受热，全熟下锅必烂。",
        "cue": "面条根根分明，掐断中间有细白芯。"
      },
      {
        "t": "五花肉切成细丝，大白菜、青椒、胡萝卜分别切成与肉丝粗细相近的丝。",
        "time": 8,
        "heat": "无火",
        "tip": "所有丝都切得一样粗，才能在同样时间一起熟。",
        "cue": "四样丝粗细均匀，码放整齐。"
      },
      {
        "t": "炒锅烧热放植物油，下葱丝姜末炒香，放肉丝大火煸到变色。",
        "time": 5,
        "heat": "大火",
        "tip": "锅要先烧到冒烟再下油，热锅凉油炒肉丝才不粘。",
        "cue": "肉丝散开变色，葱香明显。"
      },
      {
        "t": "下胡萝卜丝和白菜丝大火翻炒两分钟，再放青椒丝炒匀。",
        "time": 4,
        "heat": "大火",
        "tip": "白菜丝会大量出水，先炒它再放青椒，青椒才不会炖黄。",
        "cue": "菜丝软而仍有脆感，锅里有汤汁。"
      },
      {
        "t": "倒入面条，沿锅边淋生抽，用筷子抖散翻炒，让每根面都上色。",
        "time": 4,
        "heat": "中火",
        "tip": "炒面用筷子比锅铲好用，能把面条抖开而不是压断。",
        "cue": "面条均匀上色，没有白色面芯。"
      },
      {
        "t": "视干湿情况沿锅边洒少量清水，加盐炒匀后出锅装盘。",
        "time": 3,
        "heat": "中火",
        "tip": "沿锅边洒水而不是直接浇在面上，蒸汽能把面回软又不糊。",
        "cue": "面条干爽有光泽，盘底不出水。"
      }
    ],
    "tips": [
      "面条煮八成熟、过水拌油，是炒面不粘不烂的前提。",
      "炒面用筷子抖散，比锅铲更适合处理长面条。",
      "沿锅边洒少量清水，用蒸汽把面回软，比直接浇在面上更好。"
    ],
    "mistakes": [
      "面条煮到全熟再炒，一炒就断，出锅成了面糊。",
      "锅没烧热就下油，肉丝和面条全粘在锅底。",
      "水一次浇在面条上，面外侧糊化、里面还是干的。"
