  "steps": [
   {
    "t": "红辣椒洗净后摊在竹匾上晾干表面水分，摘去绿色蒂头。",
    "time": 15,
    "heat": "无火",
    "tip": "带生水下坛最容易生白花变质。",
    "cue": "辣椒表面干爽、无水滴"
   },
   {
    "t": "红辣椒放在无油无水的砧板上剁成 0.5cm 粗粒，姜蒜切末。",
    "time": 10,
    "heat": "无火",
    "tip": "戴手套操作，辣手会留很久。",
    "cue": "辣椒粒粗细均匀、不流汁"
   },
   {
    "t": "辣椒粒加盐与姜蒜末拌匀，倒入白酒再翻拌两遍。",
    "time": 8,
    "heat": "无火",
    "tip": "盐要按比例放足，少了容易坏。",
    "cue": "辣椒出汁、盐粒化开"
   },
   {
    "t": "拌好的辣椒装入干净玻璃坛，边装边压实排出空气。",
    "time": 5,
    "heat": "无火",
    "tip": "压实能减少气泡，发酵更均匀。",
    "cue": "坛口留 2cm 空隙、表面平整"
   },
   {
