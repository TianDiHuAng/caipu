     },
     {
      "n": "植物油",
      "a": 30,
      "u": "ml",
      "note": "炒制"
     }
    ]
   }
  ],
  "steps": [
   {
    "n": 1,
    "t": "土豆去皮切成两毫米粗细的丝，放进清水里淘洗两遍。",
    "time": 8,
    "heat": "无火",
    "tip": "洗掉表面淀粉，炒出来才根根分明不粘锅。",
    "cue": "水变清，土豆丝发白挺立"
   },
   {
    "n": 2,
    "t": "土豆丝泡在清水里备用，青椒切成同样粗细的丝。",
    "time": 4,
    "heat": "无火",
    "tip": "泡水能防氧化变黑，也让口感更脆。",
    "cue": "土豆丝浸在水中，青椒丝整齐"
   },
   {
    "n": 3,
    "t": "炒锅放植物油，冷油下花椒小火炸到变色后捞出。",
    "time": 3,
    "heat": "小火",
    "tip": "冷油下花椒，香味才出得来不发苦。",
    "cue": "花椒变深褐色，油有麻香"
   },
   {
    "n": 4,
    "t": "下入干辣椒段和大蒜片，用小火慢慢爆出香味。",
    "time": 2,
    "heat": "小火",
    "tip": "辣椒一变色就下土豆丝，炒久了发苦。",
    "cue": "辣椒变亮红，蒜片微微卷边"
   },
   {
    "n": 5,
    "t": "土豆丝沥干水下锅，转大火快速翻炒两分钟。",
    "time": 2,
    "heat": "大火",
    "tip": "沥干再下锅，带水会溅油也炒不脆。",
    "cue": "土豆丝透亮，锅里有爆响"
   },
   {
    "n": 6,
    "t": "放青椒丝和盐翻匀，沿锅边淋入米醋炒半分钟出锅。",
    "time": 2,
    "heat": "大火",
    "tip": "醋沿锅边淋，酸香更冲也挥发得快。",
    "cue": "醋香扑鼻，土豆丝根根分明"
   }
  ],
  "tips": [
   "土豆丝切好一定要反复洗掉表面淀粉。",
   "花椒冷油下锅小火炸，麻香才干净。",
   "米醋沿锅边淋入，酸香更足也不闷味。"
  ],
  "mistakes": [
   "土豆丝不洗直接炒，粘成一坨发糊。",
   "全程小火慢炒，土豆丝变软失去脆感。",
   "米醋一开始就放，炒完只剩下一股涩味。"
  ],
  "subs": [
   {
    "orig": "米醋",
    "sub": "香醋",
    "ratio": "20 毫升:20 毫升",
    "note": "颜色更深，酸味更柔和。"
   },
   {
    "orig": "干辣椒",
    "sub": "辣椒油",
    "ratio": "5 克:10 毫升",
    "note": "辣度更均匀，注意减油量。"
   }
  ],
  "variations": [
   "加一把泡发的木耳丝同炒，口感更有层次。",
   "撒少许孜然同炒，西北风味更明显。"
  ],
  "serving": "配手抓饭或者拌面吃，也能当凉菜上桌。",
  "storage": "冷藏一天，复热用大火快炒一分钟。",
  "nutrition": {
   "basis": "每份约 180 克",
   "kcal": 190,
   "protein": 3,
   "fat": 11,
   "carbs": 22,
   "sodium": 420
  },
  "safety": [
   "土豆发芽或表皮发青处须彻底削除；土豆丝炒至断生即可，须保证完全加热；炒制时油温高，注意防止溅油。"
  ],
  "origin": "西北人家最常做的一道下饭菜，土豆切细丝洗去淀粉，大火快炒，靠醋和干辣椒提味，脆爽又开胃。",
  "tags": [
   "西北",
   "土豆",
   "酸辣",
   "家常"
  ],
