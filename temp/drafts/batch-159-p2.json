  "steps": [
   {
    "n": 1,
    "t": "面粉加一百毫升清水揉成软硬适中的面团，盖布醒二十分钟。",
    "time": 25,
    "heat": "无火",
    "tip": "醒够时间面团才有延展性，捏成小片不裂。",
    "cue": "面团光滑，按下去有弹性"
   },
   {
    "n": 2,
    "t": "汤锅放植物油烧热，下姜末和大蒜末小火炒香。",
    "time": 3,
    "heat": "小火",
    "tip": "姜蒜炒出香味就下肉，别炒到发焦发苦。",
    "cue": "香味冒出，油面微微起泡"
   },
   {
    "n": 3,
    "t": "倒入牛肉粒中火翻炒，炒到肉粒表面全部变色。",
    "time": 5,
