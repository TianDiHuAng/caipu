  ],
  "ingredients": [
   {
    "group": "main",
    "items": [
     {
      "n": "牛肉",
      "a": 900,
      "u": "g",
      "note": "选裙边肉或肋眼，厚约三厘米"
     },
     {
      "n": "洋葱",
      "a": 150,
      "u": "g",
      "note": "切厚片垫烤"
     }
    ]
   },
   {
    "group": "aux",
    "items": [
     {
      "n": "盐",
