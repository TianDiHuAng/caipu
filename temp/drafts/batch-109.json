  "steps": [
   {
    "t": "奶酪切成两厘米厚的圆片，用厨房纸吸掉表面多余水汽。",
    "time": 3,
    "heat": "无火",
    "tip": "太薄的片一烤就流成一片。",
    "cue": "厚度均匀，边缘平整"
   },
   {
    "t": "铸铁小盘刷一层橄榄油，把奶酪片平铺在盘中央。",
    "time": 2,
    "heat": "无火",
    "tip": "油要刷到盘边，不然奶酪粘底。",
    "cue": "盘底泛油光"
   },
   {
    "t": "奶酪表面撒牛至、盐与黑胡椒，静置五分钟入味。",
    "time": 5,
    "heat": "无火",
    "tip": "牛至先揉碎，香气才出得来。",
    "cue": "调料均匀附着"
   },
