      "note": "粗粒海盐"
     },
     {
      "n": "黑胡椒",
      "a": 4,
      "u": "g",
      "note": "现磨粗粒"
     },
     {
      "n": "大蒜",
      "a": 15,
      "u": "g",
      "note": "拍碎"
     },
     {
      "n": "欧芹",
      "a": 20,
      "u": "g",
      "note": "切碎做酱"
     },
     {
      "n": "橄榄油",
      "a": 40,
      "u": "ml",
      "note": "刷肉与调酱"
     },
     {
      "n": "米醋",
      "a": 20,
      "u": "ml",
      "note": "红酒醋更佳"
     }
    ]
   }
  ],
  "steps": [
   {
    "t": "牛肉从冷藏取出，用厨房纸吸干表面水分，在室温静置三十分钟回温。",
    "time": 30,
    "heat": "无火",
    "tip": "回温到位，中心才不至于夹生。",
    "cue": "肉表面干爽，手压有弹性"
   },
   {
    "t": "牛肉两面均匀撒盐与黑胡椒，轻轻按压让调料贴住表面。",
    "time": 3,
    "heat": "无火",
    "tip": "提前撒盐十五分钟足够，太久会出水。",
    "cue": "表面覆薄层调料"
   },
   {
    "t": "烤架烧到手掌悬空三秒发烫，洋葱厚片铺在铁网上垫底。",
    "time": 5,
    "heat": "大火",
    "tip": "洋葱垫底能接住滴落的油，减少明火。",
    "cue": "铁网泛白，洋葱边缘起泡"
   },
   {
    "t": "牛肉放上洋葱片，大火每面烤四分钟，形成深褐色焦壳。",
    "time": 8,
    "heat": "大火",
    "tip": "一次别翻太多次，焦壳才扎实。",
    "cue": "两面焦褐，油脂外渗"
   },
   {
    "t": "刷一层橄榄油，移到中火区继续烤十分钟，中途翻面一次。",
    "time": 10,
    "heat": "中火",
    "tip": "中火慢烤让热量传到中心。",
    "cue": "肉汁清亮，按压回弹"
   },
   {
    "t": "牛肉离火盖锡纸静置八分钟，让肉汁重新分布。",
    "time": 8,
    "heat": "无火",
    "tip": "静置时间与烤制时间成正比。",
    "cue": "锡纸内无大量血水"
   },
   {
    "t": "大蒜欧芹切碎，与橄榄油、米醋和少许盐拌成酱汁，牛肉逆纹切厚片上桌。",
    "time": 6,
    "heat": "无火",
    "tip": "酱汁现拌现用，香气最冲。",
    "cue": "切面粉红，酱汁翠绿"
   }
  ],
  "tips": [
   "裙边肉筋膜多，吃的时候逆纹切才不塞牙。",
   "没有烤架可用厚底铸铁锅大火煎，效果接近。",
   "盐只用粗粒海盐，细盐会让表面过早出水。"
  ],
  "mistakes": [
   "肉一上架就频繁翻动，焦壳始终结不起来。",
   "烤完立刻切开，肉汁全部流到砧板上。",
   "用叉子扎肉翻面，肉汁从孔里跑光。"
  ],
  "subs": [
   {
    "orig": "牛肉",
    "sub": "牛肋条",
    "ratio": "900 克:900 克",
    "note": "脂肪更多，烤制时间延长五分钟。"
   },
   {
    "orig": "米醋",
    "sub": "红酒醋",
    "ratio": "20 毫升:20 毫升",
    "note": "酸味更圆润，果香明显。"
   }
  ],
  "variations": [
   "配一碟青酱，就是阿根廷餐馆常见的双酱吃法。",
   "用炭火替代燃气，烟熏味更厚重。"
  ],
  "serving": "切片后淋酱汁，配烤洋葱与烤面包一起吃。",
  "storage": "熟肉冷藏两天，复热前切厚片用平底锅两面各煎三十秒。",
  "nutrition": {
   "basis": "每份约 250 克",
   "kcal": 590,
   "protein": 46,
   "fat": 42,
   "carbs": 6,
   "sodium": 1050
  },
  "safety": [
   "牛肉中心温度须达到六十三度以上，绞肉制品才要求七十一度；生熟夹子分开使用。"
  ],
  "origin": "阿根廷潘帕斯草原上的烧烤，是当地人周末的全部仪式。铁架斜插在火堆旁，肉块靠着余温慢慢烤，桌上只放一碟青酱，谁想多吃就自己切。",
  "tags": [
   "阿根廷",
   "烤牛肉",
   "青酱",
   "炭火"
  ]
 },
