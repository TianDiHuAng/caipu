    "time": 10,
    "heat": "无火",
    "tip": "划刀让热气透进去，厚处也易熟。",
    "cue": "鱼身微湿、刀口张开"
   },
   {
    "t": "盘底铺葱段和姜片，把鱼放上去，鱼腹里也塞几片姜。",
    "time": 3,
    "heat": "无火",
    "tip": "垫葱姜能让鱼身离盘，底部不易积水。",
    "cue": "鱼身架空、葱姜垫满"
   },
   {
    "t": "蒸锅水大开后放入鱼盘，大火蒸七分钟，关火虚蒸两分钟。",
    "time": 9,
    "heat": "大火",
    "tip": "水开再上锅，冷水上锅鱼肉会变柴。",
    "cue": "鱼眼凸白、鱼身微微开裂"
   },
   {
    "t": "取出鱼盘，倒掉盘里腥水，拣去铺底的葱姜。",
    "time": 2,
    "heat": "无火",
    "tip": "这盘水最腥，不倒掉会毁掉整道菜。",
    "cue": "盘内无积水、鱼身完整"
   },
   {
    "t": "鱼身铺上新的葱丝和姜丝，摆成一条整齐的绿白线。",
    "time": 2,
    "heat": "无火",
    "tip": "葱丝切细才容易被热油激出香气。",
    "cue": "葱丝细密、分布均匀"
   },
   {
    "t": "小奶锅烧热食用油至冒青烟，均匀浇在葱姜丝上。",
    "time": 2,
    "heat": "中大火",
    "tip": "油要够热，浇下去有响声才对。",
    "cue": "葱丝微微卷起、香气四溢"
   },
   {
    "t": "沿盘边淋入蒸鱼豉油，不要直接浇在鱼身上。",
    "time": 1,
    "heat": "无火",
    "tip": "沿边淋汁能保住鱼肉洁白，卖相更好。",
    "cue": "盘底酱色清亮、鱼肉雪白"
