     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "漏勺",
   "厨房纸"
  ],
  "steps": [
   {
    "t": "大虾去壳留尾，从背部片开挑去沙线，用厨房纸吸干水分。",
    "time": 6,
    "heat": "无火",
    "tip": "开背后炸时会卷成漂亮球状，也更容易熟透。",
    "cue": "虾肉开背舒展、表面干爽"
   },
   {
    "t": "虾肉加盐、料酒、白胡椒粉和姜末抓匀，腌十分钟入味。",
    "time": 10,
    "heat": "无火",
    "tip": "腌时间别超十五分钟，久了虾肉会出水发柴。",
    "cue": "虾肉表面微湿、无积水"
   },
   {
    "t": "淀粉和面粉混合，虾肉逐个滚上干粉，抖掉多余的粉。",
    "time": 4,
    "heat": "无火",
    "tip": "干粉裹薄一层就够，太厚炸后发硬。",
    "cue": "虾肉覆薄粉、不粘连"
   },
   {
    "t": "鸡蛋取蛋液打散，把裹好粉的虾肉在蛋液里快速蘸一遍。",
    "time": 3,
    "heat": "无火",
    "tip": "蘸蛋液后要立刻下锅，久放会脱糊。",
    "cue": "虾肉湿润、粉层贴合"
   },
   {
    "t": "锅中倒植物油烧到六成热，虾肉逐个下锅炸一分钟定型。",
    "time": 3,
    "heat": "中大火",
    "tip": "油温六成最合适，低了脱糊、高了外焦内生。",
    "cue": "外壳鼓起、颜色转浅黄"
   },
   {
    "t": "捞出虾肉，把油温升到八成热，回锅复炸二十秒逼出油分。",
    "time": 2,
    "heat": "大火",
    "tip": "复炸是酥脆的关键，时间短才不干。",
    "cue": "外壳金黄酥脆、形体饱满"
   },
   {
    "t": "捞起沥干油分装盘，撒上葱花趁热食用最香脆。",
    "time": 2,
    "heat": "无火",
    "tip": "趁热吃外壳最酥，凉了会回软。",
    "cue": "外壳干爽不渗油、葱花翠绿"
   }
  ],
  "tips": [
   "虾仁选大只的，开背后炸出的形状更好看。",
   "没有复炸也可以，但外壳会软得快一些。",
   "想更香可撒一撮椒盐，配啤酒最下饭。"
  ],
  "mistakes": [
   "虾肉没吸干水就裹粉，下锅油花四溅还脱糊。",
   "油温偏低下锅，外壳吸满油、发软不脆。",
   "炸好后堆在盘里，底部被蒸汽焖软。"
  ],
  "subs": [
   {
    "orig": "虾",
    "sub": "鱼肉",
    "ratio": "500g 对 400g",
    "note": "鱼肉更嫩，炸的时间缩短二十秒。"
   },
   {
    "orig": "淀粉",
    "sub": "红薯淀粉",
    "ratio": "60g 对 60g",
    "note": "炸后更酥脆，颜色略深。"
   }
  ],
  "variations": [
   "加椒盐和蒜末同炒，做成椒盐香酥虾。",
   "裹一层白芝麻同炸，咬开香气更浓郁。"
  ],
  "serving": "整盘上桌，配啤酒或作为宴席冷盘热吃。",
  "storage": "冷藏一天，复热用空气炸锅一百八十度烤三分钟。",
  "nutrition": {
   "basis": "每份（约 150g）",
   "kcal": 320,
   "protein": 28,
   "fat": 18,
   "carbs": 12,
   "sodium": 600
  },
  "safety": [
   "虾肉必须彻底加热至肉色不透明、卷曲成球，中心熟透。",
   "甲壳类属高致敏食材，过敏体质者慎食。",
   "炸油温度高，下锅前务必擦干虾肉表面水分，避免热油飞溅。"
  ],
  "origin": "香酥虾是鲁菜宴席上常见的炸制菜，讲究挂糊薄、火候准、外壳酥。虾仁开背去线腌味，干粉加蛋液裹匀，六成油温炸定型再复炸一次，成菜金黄挺括，咬开还是嫩弹的虾肉。山东人待客常用它做头道热菜。",
  "tags": [
   "鲁菜",
   "炸",
   "海鲜",
   "宴客"
  ],
  "related": [
   "baochao-yaohua",
   "youmen-daxia"
  ],
  "overwrite": true
 },
 {
  "id": "thai-gaeng-phed-moo",
  "zh": "泰式红咖喱猪肉",
  "en": "Thai Red Pork Curry (Gaeng Phed Moo)",
  "cuisine": "thai",
  "category": [
   "main-meat"
  ],
  "difficulty": 2,
  "prep": 20,
  "cook": 25,
  "servings": 3,
  "flavor": [
   "spicy",
   "savory",
   "fragrant",
   "rich"
  ],
  "ingredients": [
   {
    "group": "main",
    "items": [
     {
      "n": "猪肩肉",
      "a": 450,
      "u": "g",
      "note": "切三毫米薄片"
     }
    ]
   },
   {
    "group": "aux",
    "items": [
     {
      "n": "四季豆",
      "a": 150,
      "u": "g",
      "note": "切五厘米段"
     },
     {
      "n": "椰奶",
      "a": 250,
      "u": "ml",
      "note": "分两次用"
     },
     {
      "n": "泰国罗勒",
      "a": 15,
      "u": "g",
      "note": "取叶"
     },
     {
      "n": "清水",
      "a": 150,
      "u": "ml",
      "note": "炖煮"
     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "红咖喱酱",
      "a": 40,
      "u": "g",
      "note": "主调味"
     },
     {
      "n": "鱼露",
      "a": 20,
      "u": "ml",
      "note": "咸鲜"
     },
     {
      "n": "棕榈糖",
      "a": 10,
      "u": "g",
      "note": "平衡辣味"
     },
     {
      "n": "青柠",
      "a": 1,
      "u": "piece",
      "note": "挤汁提酸"
     },
     {
      "n": "植物油",
      "a": 20,
      "u": "ml",
      "note": "炒酱用"
     },
     {
      "n": "小米辣",
      "a": 2,
      "u": "piece",
      "note": "增辣"
     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "木铲",
   "汤碗"
  ],
  "steps": [
   {
    "t": "猪肩肉逆着纹理切成三毫米薄片，肥瘦相间的部位最嫩。",
    "time": 8,
    "heat": "无火",
    "tip": "逆纹切才不塞牙，薄片也更容易入味。",
    "cue": "肉片薄而均匀、纹理短"
   },
   {
    "t": "四季豆撕掉两侧老筋，斜切成五厘米长的段备用。",
    "time": 4,
    "heat": "无火",
    "tip": "老筋不撕会影响口感，斜切更易熟。",
    "cue": "豆段整齐、无粗纤维"
   },
   {
    "t": "炒锅放植物油，中小火下红咖喱酱炒两分钟至香味散出、油色发红。",
    "time": 3,
    "heat": "中小火",
    "tip": "咖喱酱必须用油炒开，直接下水会结块发苦。",
    "cue": "油面泛红、香气浓烈"
   },
   {
    "t": "倒入一半椰奶，边倒边搅，炒到表面浮出红油。",
    "time": 3,
    "heat": "中小火",
    "tip": "椰奶炒出油，咖喱的香气才算彻底释放。",
    "cue": "表面析出红油、酱体浓稠"
   },
   {
    "t": "下猪肉片翻炒到表面变色，加清水和棕榈糖，中火煮八分钟。",
    "time": 8,
    "heat": "中火",
    "tip": "肉片下锅后快速划散，避免粘成一片。",
    "cue": "肉片转白、汤面微沸"
   },
   {
    "t": "放入四季豆再煮六分钟，直到豆段变软但仍带脆感。",
    "time": 6,
    "heat": "中火",
    "tip": "四季豆一定要煮透，生豆角含皂苷会引起不适。",
    "cue": "豆段转深绿、能折断"
   },
   {
    "t": "倒入剩下的椰奶、鱼露和小米辣，小火煮两分钟后关火。",
    "time": 3,
    "heat": "小火",
    "tip": "椰奶最后放才不会油水分离，汤色更奶白。",
    "cue": "汤汁奶红、辣味扑鼻"
   },
   {
    "t": "关火后挤入青柠汁，撒泰国罗勒叶，搅匀即可离锅。",
    "time": 2,
    "heat": "无火",
    "tip": "青柠离火再加，酸香清亮不发苦。",
    "cue": "罗勒叶微萎、香气上扬"
   }
  ],
  "tips": [
   "红咖喱酱比绿咖喱温和，怕辣可以减到三十克。",
   "猪肩肉可用五花肉代替，油脂更足更香。",
   "四季豆换茄子或竹笋同样好吃，先焯再煮。"
  ],
  "mistakes": [
   "咖喱酱没炒开就加水，结块且没有香气。",
   "四季豆下锅就起锅，豆角生硬、带生青味。",
   "椰奶一次性全倒入久煮，油水分离汤色发灰。"
  ],
  "subs": [
   {
    "orig": "猪肩肉",
    "sub": "鸡腿肉",
    "ratio": "450g 对 450g",
    "note": "鸡肉易熟，炖煮时间减三分钟。"
   },
   {
    "orig": "棕榈糖",
    "sub": "红糖",
    "ratio": "10g 对 8g",
    "note": "焦糖香不同，甜度接近。"
   }
  ],
  "variations": [
   "加两片柠檬叶和少许酸角汁，酸香更立体。",
   "加一把小番茄同煮，果酸解腻颜色也亮。"
  ],
  "serving": "配泰国香米饭，咖喱汁拌饭最下饭。",
  "storage": "冷藏两天，冷冻一个月；复热加少许椰奶小火煮开。",
  "nutrition": {
   "basis": "每份（约 260g）",
   "kcal": 470,
   "protein": 26,
   "fat": 32,
   "carbs": 16,
   "sodium": 820
  },
  "safety": [
   "猪肉必须彻底加热至中心熟透，切开不见粉红色汁水。",
   "四季豆必须煮至完全断生变软，未熟豆角含皂苷与凝集素。",
   "成品冷藏不超过两天，复热需整体煮沸后再食用。"
  ],
  "origin": "Gaeng Phed Moo 是泰国家常红咖喱猪肉，Phed 意为辣。红咖喱酱以干辣椒、南姜、香茅、虾酱捣成，用椰奶炒出红油后下猪肉与四季豆慢炖，最后用鱼露、棕榈糖、青柠调出咸甜酸辣四味，配香米饭是最常见的吃法。",
  "tags": [
   "泰式",
   "咖喱",
   "炖",
   "下饭"
  ],
  "related": [
   "thai-gaeng-kari-gai",
   "larb-gai"
  ],
  "overwrite": true
 },
