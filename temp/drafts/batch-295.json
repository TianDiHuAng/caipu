    "steps": [
      {
        "t": "鸡蛋磕入碗中打散，加盐和清水搅匀，用细筛过滤两遍去掉泡沫与系带。",
        "time": 5,
        "heat": "无火",
        "tip": "过滤这一遍别省，蛋液细腻蒸出来才没有蜂窝孔洞。",
        "cue": "蛋液呈浅黄色，表面没有气泡。"
      },
      {
        "t": "蛋液倒入浅口碗，盖上保鲜膜扎几个小孔，水开后中小火蒸八分钟。",
        "time": 9,
        "heat": "中小火",
        "tip": "全程中小火，火大蛋液翻滚就会蒸出蜂窝和腥味。",
        "cue": "蛋面平整如镜，轻晃有嫩滑颤动。"
      },
      {
        "t": "虾仁挑去背部泥线，加料酒和生粉抓匀腌三分钟，另起锅焯三十秒捞出。",
        "time": 4,
        "heat": "中火",
        "tip": "虾仁焯到卷曲变红就好，久煮会缩成硬球。",
        "cue": "虾仁卷成弯月，颜色转为粉红。"
      },
      {
        "t": "掀开保鲜膜把虾仁摆到蛋面，再盖回蒸三分钟，关火虚蒸两分钟取出。",
        "time": 5,
        "heat": "中小火",
        "tip": "虚蒸两分钟让蛋羹定型，直接开盖容易回缩塌陷。",
        "cue": "虾仁嵌在蛋面，蛋羹边缘不缩边。"
      },
      {
        "t": "淋上生抽和香油，撒小葱花的细末，趁热上桌用小勺挖着吃。",
        "time": 2,
        "heat": "无火",
        "tip": "生抽沿碗边淋，蛋面才不会被冲出一道沟。",
        "cue": "酱汁在蛋面晕开，葱花翠绿点缀。"
      }
    ],
    "tips": [
      "蛋液与清水按一比一点八配，嫩度最稳。",
      "蒸碗选浅口宽底的，受热均匀不易夹生。",
      "盖保鲜膜扎孔，水汽就不会滴进蛋面。"
    ],
    "mistakes": [
      "大火猛蒸，蛋羹表面全是蜂窝孔洞。",
      "蛋液不过筛，蒸好底下沉一层硬块。",
      "盐直接撒在蛋面，咸味分布不均匀。"
    ],
    "subs": [
