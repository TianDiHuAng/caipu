  "steps": [
   {
    "n": 1,
    "t": "奶酪倒进盆里压散成细粒，如果太湿先用纱布挤掉多余水分。",
    "time": 6,
    "heat": "无火",
    "tip": "奶渣要干一点，湿了加多少面粉都粘手。",
    "cue": "奶渣松散不成团"
   },
   {
    "n": 2,
    "t": "加鸡蛋和白糖搅匀，再分次筛入面粉，拌成能成团的软糊。",
    "time": 6,
    "heat": "无火",
    "tip": "面粉分次加，糊能成团就停，多了发硬。",
    "cue": "面糊能捏成形不粘盆"
   },
   {
    "n": 3,
    "t": "手上抹点植物油，把面糊揪成五十克一个的圆饼，两面拍薄层干面粉。",
    "time": 6,
    "heat": "无火",
    "tip": "饼别压太薄，两厘米厚煎完才外脆内软。",
    "cue": "圆饼厚薄一致不塌"
   },
   {
    "n": 4,
    "t": "平底锅放植物油中火烧热，饼坯摆进去，中间留出空隙。",
    "time": 2,
    "heat": "中火",
    "tip": "饼要留间距，挤在一起会粘成一大块。",
    "cue": "饼坯下锅边缘冒小泡"
   },
   {
    "n": 5,
    "t": "中小火煎四分钟到底面金黄，翻面再煎三分钟。",
    "time": 7,
    "heat": "中火",
    "tip": "翻面只翻一次，多翻会散。",
    "cue": "两面金黄，饼身微微鼓起"
   },
   {
    "n": 6,
    "t": "起锅前加一小块黄油晃匀，让饼表面裹一层奶香，趁热装盘。",
    "time": 3,
    "heat": "小火",
    "tip": "黄油最后加，早放高温会烧焦发苦。",
    "cue": "表面油亮，奶香明显"
   }
  ],
  "tips": [
   "奶渣一定要挤干水，否则面糊散不成形。",
   "面粉分次加，糊能成团就停手。",
   "煎的时候中小火，火大外焦内凉。"
  ],
  "mistakes": [
