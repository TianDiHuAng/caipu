  "steps": [
   {
    "n": 1,
    "t": "牛肉切大块，用盐和黑胡椒抓匀。，锅温要匀，别忽高忽低。",
    "time": 8,
    "heat": "无火",
    "tip": "肉块擦干再煎，才出焦香。，这步别省。，翻动放轻，别压碎。",
    "cue": "肉块干爽，调料均匀，慢慢来，别心急。"
   },
   {
    "n": 2,
    "t": "炖锅倒植物油，牛肉分批煎上色。，很多人在这里出错。",
    "time": 10,
    "heat": "大火",
    "tip": "分批煎，温度才不会掉。，试一下咸淡再上桌。",
    "cue": "表面焦褐，锅底留香，注意别让汤汁烧干。"
   },
   {
    "n": 3,
    "t": "盛出牛肉，余油炒洋葱丝到软。，火别太大，稳着来。",
    "time": 6,
    "heat": "中火",
    "tip": "洋葱炒透，汤底才甜。，手法轻些，别弄散。",
    "cue": "洋葱透明，边缘金黄，起锅前尝一口定咸淡。"
   },
   {
    "n": 4,
    "t": "加蒜末、姜泥、咖喱粉和红椒粉炒香。，味道最后调最稳。",
    "time": 4,
    "heat": "中小火",
    "tip": "香料遇油才出味。，全程中小火，食材才不糊。",
    "cue": "油色泛红，香气浓郁"
   },
   {
    "n": 5,
    "t": "下番茄块炒到出汁变稠。",
    "time": 6,
    "heat": "中火",
    "tip": "番茄炒出沙，汤才浓。",
    "cue": "汁水红亮，番茄软塌"
   },
   {
    "n": 6,
    "t": "放回牛肉，加胡萝卜和清水煮开。",
    "time": 8,
    "heat": "大火",
    "tip": "水开撇沫，汤才清。",
    "cue": "汤面翻涌，浮沫上浮"
   },
   {
    "n": 7,
    "t": "转小火盖盖炖五十分钟。",
    "time": 52,
    "heat": "小火",
    "tip": "小火慢炖，肉才软烂。",
    "cue": "肉一戳就散，汤色深红"
   },
   {
    "n": 8,
    "t": "加土豆块，再炖十五分钟。",
    "time": 16,
    "heat": "小火",
    "tip": "土豆后放，才不会煮化。",
    "cue": "土豆透亮，边缘圆润"
   },
   {
    "n": 9,
    "t": "加盐调味，开盖收汁五分钟。",
    "time": 7,
    "heat": "中火",
    "tip": "收汁别太干，拌饭才好吃。",
    "cue": "汤汁浓稠，油光浮动"
   },
   {
    "n": 10,
    "t": "撒香菜碎，趁热盛盘。",
    "time": 3,
    "heat": "无火",
    "tip": "香菜最后放，颜色才绿。",
    "cue": "香气扑鼻，汤色红亮"
   }
  ],
  "tips": [
   "牛肉分批煎，焦香才足。",
   "土豆后放，才不会煮成糊。",
   "收汁留一点，拌饭最香。"
  ],
  "mistakes": [
