    "steps": [
      {
        "t": "鸡腿肉整块冷水下锅，加料酒、姜片和打结的小葱，大火烧开撇净浮沫，转小火浸煮十二分钟。",
        "time": 14,
        "heat": "大火",
        "tip": "水面保持微微冒泡即可，滚沸会把鸡皮煮破、肉变柴。",
        "cue": "鸡皮完整收紧，汤面浮沫转为浅褐色。"
      },
      {
        "t": "关火后原汤焖八分钟，用筷子扎鸡腿最厚处，无血水渗出即熟，捞出立即放进冰水浸泡。",
        "time": 8,
        "heat": "无火",
        "tip": "冰水骤冷能让鸡皮爽脆、肉质紧实，切片才不散。",
        "cue": "鸡腿按压有弹性，切面呈乳白色无血色。"
      },
      {
        "t": "花椒和干辣椒节放干锅小火焙到出香，倒出晾凉后把花椒碾成粉，干辣椒剪成细丝。",
        "time": 5,
        "heat": "小火",
        "tip": "焙料全程小火并不断晃动锅子，一旦发黑整份怪味都会发苦。",
        "cue": "花椒一捏即碎，香气干爽不呛。"
      },
      {
        "t": "小碗放生抽、香醋、白糖、盐和蒜末，搅到糖盐完全化开，再调入辣椒油、香油和花椒粉。",
        "time": 4,
        "heat": "无火",
        "tip": "先化糖盐再下油，味汁才均匀不结块，尝一口应是麻、辣、酸、甜、咸层层递进。",
        "cue": "味汁红亮浓稠，能挂住勺背。"
      },
      {
        "t": "鸡腿肉切成半厘米厚的大片，皮朝上码在盘中，淋上调好的怪味汁，静置五分钟入味。",
        "time": 5,
        "heat": "无火",
        "tip": "逆着纹理切，片薄一点更挂汁；皮朝上摆盘卖相最好。",
        "cue": "每片鸡肉都裹上红亮味汁。"
      },
      {
        "t": "最后撒上干辣椒丝、熟白芝麻和压碎的花生，葱花点在中央即成。",
        "time": 2,
        "heat": "无火",
        "tip": "花生碎临上桌再撒，久泡会回软失去脆感。",
        "cue": "表面红亮油润，花生碎酥脆分明。"
      }
    ],
    "tips": [
      "煮鸡用浸熟而非久煮，肉汁才不会流失。",
      "怪味的关键是糖醋和麻辣比例平衡，边调边尝。",
      "冰水浸泡这一步别省，口感差别很明显。"
    ],
    "mistakes": [
      "鸡腿大火滚煮太久，切片时肉散成碎渣。",
      "花椒焙糊了还照用，整盘汁都是焦苦味。",
      "味汁只放辣椒油不放糖醋，吃着只有死辣。"
    ],
    "subs": [
      {
        "orig": "鸡腿肉",
        "sub": "整鸡",
        "ratio": "600克:半只约700克",
        "note": "整鸡带骨煮的时间要延长到二十分钟，斩件后再淋汁。"
      },
      {
        "orig": "熟花生",
        "sub": "熟白芝麻",
        "ratio": "30克:20克",
        "note": "不吃花生可全部换成芝麻，香气更清但少了酥脆层次。"
      }
    ],
    "variations": [
      "重庆做法会加一小勺芝麻酱，味汁更稠厚挂味。",
      "有的馆子把鸡片换成鸡丝，拌好后堆成小山，更易入味。"
    ],
    "serving": "装白瓷盘冷食，配一碗白粥或凉面都很合适，夏天当开胃头盘最舒服。",
    "storage": "味汁与鸡片分开冷藏可存两日，食用前再淋汁拌匀，久泡鸡肉会出水冲淡味道。",
    "nutrition": {
