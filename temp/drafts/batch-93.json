  ],
  "serving": "盛入深碗配一碗热白饭，汤与料一起舀着吃。",
  "storage": "冷藏两天，酸汤隔夜更入味；复热小火加热勿滚沸太久。",
  "nutrition": {
   "basis": "每份约 380 克",
   "kcal": 420,
   "protein": 22,
   "fat": 28,
   "carbs": 20,
   "sodium": 950
