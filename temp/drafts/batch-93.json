  "steps": [
   {
    "t": "罗望子果肉用两百毫升温水泡十分钟，揉搓后滤出浓酸汁，去籽留汤。",
    "time": 12,
    "heat": "无火",
    "tip": "罗望子要泡软再揉，滤出的汁越浓酸味越正。",
    "cue": "滤汁呈深褐色，尝起来明显发酸"
   },
   {
    "t": "五花肉冷水下锅煮开，撇净浮沫后加姜块和洋葱瓣，小火炖二十分钟。",
    "time": 24,
    "heat": "中火",
    "tip": "先焯水去腥，汤色才清亮不浑。",
    "cue": "汤色清亮，肉块表面收紧"
   },
   {
    "t": "下番茄块与白萝卜块，继续小火煮十分钟至萝卜半透明，用筷子能插入。",
    "time": 12,
    "heat": "小火",
    "tip": "萝卜要炖到半软再放其他菜，否则各种蔬菜熟度参差。",
    "cue": "萝卜边缘透亮，汤带番茄的红"
   },
   {
    "t": "加豆角与青椒段煮五分钟，倒入罗望子汁，尝尝酸度是否够。",
    "time": 6,
    "heat": "中火",
    "tip": "酸汁最后放，久煮酸味会变寡淡，配白饭一起吃最下饭。",
    "cue": "汤色加深，豆角转深绿"
   },
   {
    "t": "下芥蓝段煮三分钟，用鱼露和盐调味，撒黑胡椒关火。",
    "time": 4,
    "heat": "中火",
    "tip": "芥蓝烫软即可，煮久了发黄带苦。",
    "cue": "芥蓝叶翠绿塌软，汤面浮油花"
   }
  ],
  "tips": [
   "罗望子酸度差异大，先放一半尝味再决定是否加足。",
   "用猪排骨代替五花肉更清爽，炖制时间需延长十分钟。",
   "配一碗白饭，汤要浇在饭上吃才是菲律宾家常吃法。"
  ],
  "mistakes": [
