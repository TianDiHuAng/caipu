    "time": 12,
    "heat": "中火",
    "tip": "芥末籽要炒到跳起来，香味才出。",
    "cue": "籽粒在油里跳动，洋葱变透明"
   },
   {
    "t": "加青椒碎、姜黄、咖喱粉炒一分钟，下土豆泥与青豆，加盐和柠檬汁拌匀成馅。",
    "time": 6,
    "heat": "中火",
    "tip": "土豆泥下锅后要压散翻匀，馅料干湿适中才好卷。",
    "cue": "馅料呈明亮黄色，能捏成团"
   },
   {
    "t": "不粘锅小火预热，抹一层薄油，舀一勺面糊摊成薄圆片，淋油沿边煎两分钟。",
    "time": 5,
    "heat": "小火",
    "tip": "锅温要稳，太热饼皮立刻起泡破裂，太凉揭不下来。",
    "cue": "饼皮边缘微翘，底面出现浅金色斑点"
   },
   {
    "t": "饼皮上铺一勺土豆馅，撒香菜，对折成半月形，配柠檬角趁热吃。",
    "time": 3,
    "heat": "微火",
    "tip": "馅只放一侧，对折后饼皮才不裂。",
    "cue": "饼皮卷起不破，表面略脆"
   }
