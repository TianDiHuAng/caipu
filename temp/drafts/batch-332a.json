  "steps": [
   {
    "t": "白萝卜削皮切成两厘米见方的块，撒盐拌匀静置三十分钟杀水。",
    "time": 12,
    "heat": "无火",
    "tip": "萝卜块切匀才好一起入味，大小不一腌完有的咸有的淡。",
    "cue": "萝卜块出水塌软，盆底积盐水"
   },
   {
    "t": "小锅把清水与糯米粉搅开，小火煮成半透明糊，放凉备用。",
    "time": 6,
    "heat": "小火",
    "tip": "糯米糊一定要放凉再加辣椒粉，热的会把辣椒粉烫出苦味。",
    "cue": "面糊半透明发亮，能挂勺"
   },
   {
    "t": "萝卜块攥掉水分，倒进大盆，加辣椒粉、蒜泥、姜泥与鱼露。",
    "time": 6,
    "heat": "无火",
    "tip": "戴一次性手套抓拌，辣椒粉会把手指染红好几天洗不掉。",
    "cue": "萝卜块通体裹红，盆里见汁"
   },
   {
    "t": "倒入凉糯米糊，撒白糖与小葱段，抓拌到每块萝卜都挂上糊。",
    "time": 5,
    "heat": "无火",
    "tip": "糯米糊是发酵的粮食，少了它泡菜酸得单薄，也不容易存。",
    "cue": "糊裹均匀，葱段分散各处"
   },
   {
    "t": "装进干净密封罐压实，室温放一天闻到酸味，再移冰箱冷藏三天。",
    "time": 6,
    "heat": "无火",
    "tip": "室温只放一天就要进冰箱，放两天以上会酸过头没法吃。",
    "cue": "罐内起小气泡，气味发酸"
   }
  ],
  "tips": [
   "깍두기 是韩国冬天配牛骨汤和米饭的方块萝卜泡菜，咬起来脆响。",
   "萝卜选沉手、皮紧的，切开断面有细密水光才甜。",
   "腌好加一勺香油拌一下，香气立刻不一样。"
  ],
  "mistakes": [
   "萝卜杀水时间不够就拌料，腌完一罐水，味道全被冲淡。",
   "糯米糊趁热拌辣椒粉，泡菜带一股闷苦味，怎么放都散不掉。",
   "罐子没洗净带油，三天后表面长白膜，只能整罐扔掉。"
  ],
