  "steps": [
   {
    "n": 1,
    "t": "菠菜切掉根部，一株株掰开在清水里洗净泥沙，沥干备用。",
    "time": 8,
    "heat": "无火",
    "tip": "根部藏沙多，掰开一株株洗才干净。",
    "cue": "菠菜鲜绿，泥沙洗净"
   },
   {
    "n": 2,
    "t": "汤锅烧开水，加一小撮盐，把菠菜放进去焯四十秒。",
    "time": 5,
    "heat": "大火",
    "tip": "焯的时间别超过一分钟，久了颜色发黄。",
    "cue": "叶片深绿，茎部变软"
   },
   {
    "n": 3,
    "t": "立刻捞出放进冷水里过凉，再用手轻轻挤掉多余水分。",
    "time": 5,
    "heat": "无火",
    "tip": "过冷水锁住颜色，挤水别太狠以免挤烂。",
    "cue": "菠菜冰透，成团不滴水"
   },
   {
    "n": 4,
    "t": "把挤干的菠菜切成五厘米长段，装进大碗里备用。",
    "time": 4,
    "heat": "无火",
    "tip": "切长一点，拌的时候才不容易碎成泥。",
    "cue": "切段整齐，蓬松不粘"
   },
   {
    "n": 5,
    "t": "加蒜末、盐和香油，用手轻轻抓拌到每根都裹上油。",
    "time": 4,
    "heat": "无火",
    "tip": "用手抓拌比筷子匀，但力道要轻别压烂。",
    "cue": "叶片油亮，蒜末均匀"
   },
   {
    "n": 6,
    "t": "撒上白芝麻和大葱丝，翻拌两下装盘即可上桌。",
    "time": 2,
    "heat": "无火",
    "tip": "芝麻和葱丝最后放，香气和脆感才留住。",
    "cue": "芝麻点缀，葱丝翠白"
   }
  ],
  "tips": [
   "焯水不超过一分钟，菠菜颜色才保持翠绿。",
   "过冷水后轻轻挤水，别把叶片挤烂。，值得留意。",
   "香油最后调味，香气才不被热气冲散。"
  ],
  "mistakes": [
   "焯水时间过长，菠菜发黄又软烂。，务必避免。",
   "水没挤干就拌，盘底很快积一汪水。，务必避免。",
   "用筷子猛搅，叶片全被搅成碎末。，务必避免。"
  ],
  "subs": [
   {
    "orig": "菠菜",
    "sub": "空心菜",
    "ratio": "500 克:500 克",
    "note": "茎更脆，焯水时间加二十秒。"
   },
   {
    "orig": "香油",
    "sub": "橄榄油",
    "ratio": "20 毫升:20 毫升",
    "note": "香气更清淡，适合不爱芝麻味的人。"
   }
  ],
  "variations": [
   "加一勺辣椒粉，颜色更红也更有辣味。",
   "拌入少许白糖，咸味变得更圆润。，也很受欢迎。"
  ],
  "serving": "当作小菜配白米饭和汤，也可以拌进热饭做简易拌饭。",
  "storage": "冷藏两天，食用前回温并补几滴香油。，效果更稳定。",
  "nutrition": {
   "basis": "每份约 180 克",
   "kcal": 120,
   "protein": 4,
   "fat": 9,
   "carbs": 6,
   "sodium": 420
  },
  "safety": [
   "菠菜须焯至茎部完全变软熟透；成品冷藏不超过两天，食用前须回温或加热。"
  ],
  "origin": "韩国每顿饭都少不了一碟的凉拌菠菜，焯水挤干后用手抓拌调味。蒜香和芝麻油香裹在翠绿的叶片上，清淡却能撑起一桌饭的滋味。",
  "tags": [
   "韩国",
   "菠菜",
   "小菜",
   "凉拌"
  ],
  "overwrite": true
