     },
     {
      "n": "盐",
      "a": 4,
      "u": "g",
      "note": "调味"
     },
     {
      "n": "孜然",
      "a": 3,
      "u": "g",
      "note": "增香"
     },
     {
      "n": "植物油",
      "a": 40,
      "u": "ml",
