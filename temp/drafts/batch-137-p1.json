     }
    ]
   }
  ],
  "steps": [
   {
    "n": 1,
    "t": "洋葱与青椒洗净，洋葱切成细丝，青椒剖开去籽切成长条备用。",
    "time": 6,
    "heat": "无火",
    "tip": "青椒籽要去净，残留会让整盘发苦。",
    "cue": "洋葱丝散开，青椒条粗细一致"
   },
   {
    "n": 2,
    "t": "牛肉逆着纹理切成薄片，加生抽抓匀腌制十分钟让底味吃进去。",
    "time": 10,
    "heat": "无火",
    "tip": "逆纹切才不塞牙，腌足时间肉质更松。",
    "cue": "肉片薄到透光，表面挂满酱汁"
   },
   {
    "n": 3,
    "t": "番茄顶部划十字，用滚开水烫两分钟后撕掉外皮切成小块。",
    "time": 6,
    "heat": "中火",
    "tip": "烫到皮卷起就捞出，久烫番茄肉会发软。",
    "cue": "番茄皮整片卷起剥离"
   },
   {
    "n": 4,
    "t": "汤锅加水烧开，下入面条煮到八分熟捞出，过一遍凉水沥干。",
    "time": 8,
    "heat": "大火",
    "tip": "八分熟就起锅，回锅还有第二次加热。",
    "cue": "面条中心留一点白芯"
   },
   {
    "n": 5,
    "t": "炒锅烧热倒入植物油，下牛肉片用大火滑散，变色后立刻盛出。",
    "time": 4,
    "heat": "大火",
    "tip": "肉片别久炒，一变白就盛出，回锅再熟。",
    "cue": "肉片卷边，锅底留红油"
   },
   {
    "n": 6,
    "t": "锅内留底油，下洋葱丝、大蒜末和番茄块，中火炒到番茄出红汁。",
    "time": 5,
    "heat": "中火",
    "tip": "番茄要炒出汁才叫过油肉，干炒只是配菜。",
    "cue": "番茄塌软，锅内汤汁变稠"
   },
   {
    "n": 7,
    "t": "放回牛肉片，加青椒条、盐和孜然，转大火翻炒一分钟出锅。",
    "time": 3,
    "heat": "大火",
    "tip": "孜然最后放，早放会被炒糊发苦。",
    "cue": "青椒翠绿，孜然香气扑鼻"
   },
   {
    "n": 8,
    "t": "把炒好的浇头连汤汁一起浇在面条上，用筷子挑散拌匀。",
    "time": 2,
    "heat": "无火",
    "tip": "拌的时候从下往上翻，酱汁才裹得均匀。",
    "cue": "每根面条都挂上红汁"
   }
  ],
  "tips": [
   "面条煮到八分熟过凉水，口感才筋道不坨。",
   "番茄要炒出红汁再回肉，浇头才挂得住面。",
   "孜然务必在出锅前放，香气才够冲。"
  ],
  "mistakes": [
   "牛肉顺纹切，嚼起来塞牙还发柴。",
   "面条煮过头再拌，一夹就断。",
   "番茄没炒出汁，浇头干巴巴裹不上面。"
  ],
  "subs": [
   {
    "orig": "牛肉",
    "sub": "羊肉",
    "ratio": "150 克:150 克",
    "note": "更接近新疆本地口味，膻香更足。"
   },
   {
    "orig": "青椒",
    "sub": "芹菜",
    "ratio": "100 克:100 克",
    "note": "脆感相似，清香更明显。"
   }
  ],
  "variations": [
   "加一勺辣椒油，酸辣口更过瘾。",
   "面条换成宽面，挂汁更多。"
  ],
  "serving": "面条盛盘后浇上热浇头，趁热从下往上拌开，配一碟生蒜更地道。",
  "storage": "浇头与面条分开冷藏，两天内吃完，复热时浇头单独回锅。",
  "nutrition": {
   "basis": "每份约 480 克",
   "kcal": 680,
   "protein": 32,
   "fat": 24,
   "carbs": 82,
   "sodium": 1150
  },
  "safety": [
   "牛肉片务必炒到完全变色熟透，中心不见血色；剩余浇头冷藏保存不超过两天。"
  ],
  "origin": "新疆街头的经典拌面，面条单独煮、浇头单独炒，过油肉浇头用番茄和洋葱炒出红汁，酸甜咸香，拌开后每根面都裹汁，是当地打工人的常规午饭。",
  "tags": [
   "新疆",
