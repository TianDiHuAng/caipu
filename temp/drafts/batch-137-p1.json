  "steps": [
   {
    "n": 1,
    "t": "面粉里分次加一百毫升清水，揉成偏硬的光滑面团，盖上湿布醒二十分钟。",
    "time": 18,
    "heat": "无火",
    "tip": "面要硬一点，擀出的面片煮了才不烂。",
    "cue": "面团按下去能回弹"
   },
   {
    "n": 2,
    "t": "羊肉切成两厘米小块，土豆和胡萝卜去皮切丁，洋葱切成细丝。",
    "time": 8,
    "heat": "无火",
    "tip": "土豆丁切均匀，免得有的烂有的夹生。",
    "cue": "三种料大小接近，码放整齐"
   },
   {
    "n": 3,
    "t": "炒锅放植物油烧热，下羊肉块中火煸到表面收紧微微焦黄。",
    "time": 6,
    "heat": "中火",
    "tip": "羊肉先煸出油再煮汤，膻味会轻很多。",
    "cue": "肉块表面焦黄，锅内有羊油"
   },
   {
    "n": 4,
    "t": "放洋葱丝炒到透明，再加土豆丁和胡萝卜丁翻炒两分钟。",
    "time": 4,
    "heat": "中火",
    "tip": "洋葱炒软才出甜味，这是汤底的底子。",
    "cue": "洋葱透明，蔬菜裹上油光"
   },
   {
    "n": 5,
    "t": "倒入一千一百毫升清水大火烧开，撇净浮沫转中火炖十五分钟。",
    "time": 14,
    "heat": "中火",
    "tip": "浮沫一定撇干净，汤才清不发浑。",
    "cue": "汤面几乎无沫，蔬菜开始变软"
   },
   {
    "n": 6,
    "t": "面团擀成薄片切成菱形，抖散下锅煮五分钟，加盐和白胡椒撒小葱。",
    "time": 5,
    "heat": "中火",
    "tip": "面片下锅要抖散，粘成坨就煮不透。",
    "cue": "面片浮起，边缘透亮不夹生"
   }
  ],
  "tips": [
   "面团偏硬是关�键，软面片下锅立刻糊汤。",
   "羊肉先煸后炖，膻味能降一半。",
   "白胡椒出锅前放，辛香才留得住。"
  ],
  "mistakes": [
