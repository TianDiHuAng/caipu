    "time": 8,
    "heat": "中火",
    "tip": "分两次下锅，避免油温骤降。",
    "cue": "肉块浮起、表面浅金黄，土豆边缘微焦"
   },
   {
    "t": "锅留 15 毫升油，下蒜末炒香，加番茄膏、白糖、生抽与 60 毫升清水煮开。",
    "time": 3,
    "heat": "中小火",
    "tip": "番茄膏要炒过才没有生酸味。",
    "cue": "酱汁冒小泡、颜色转深红"
   },
   {
    "t": "倒入炸好的肉块与土豆，大火翻匀，淋米醋与水淀粉，撒葱段出锅。",
    "time": 3,
    "heat": "大火",
    "tip": "醋分两次：烧汁时一半、起锅前一半，酸香更有层次。",
    "cue": "每块肉都裹上亮红酱汁，盘底几乎不见汁水"
   }
