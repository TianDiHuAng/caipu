  "steps": [
   {
    "n": 1,
    "t": "茄子去蒂切成手指粗的条，泡进淡盐水里抓一抓再沥干。",
    "time": 8,
    "heat": "无火",
    "tip": "盐水抓过茄子不易吸油，颜色也白净。",
    "cue": "茄条淡白，用手一攥略出水"
   },
   {
    "n": 2,
    "t": "青椒去籽切斜片，蒜拍碎切末，豆豉剁碎备用。",
    "time": 4,
    "heat": "无火",
    "tip": "豆豉剁碎香味才出得来，整粒不易出味。",
    "cue": "配料备齐，豆豉成细粒"
   },
   {
    "n": 3,
    "t": "炒锅烧热倒植物油，茄条下锅中火煸炒到表面微软。",
    "time": 4,
    "heat": "中火",
    "tip": "油热再下锅，茄子才不吸油成海绵。",
    "cue": "茄条变软出汁，边缘微焦"
   },
   {
    "n": 4,
    "t": "把茄子拨到锅边，下蒜末和豆豉炒出香味。",
    "time": 2,
    "heat": "中火",
    "tip": "配料在油里炒过，酱香才浓。",
    "cue": "蒜末泛黄，豆豉香气冲鼻"
   },
   {
    "n": 5,
    "t": "加青椒片和茄条一起翻炒，沿锅边淋入生抽。",
    "time": 1,
    "heat": "大火",
    "tip": "生抽沿锅边淋，香味比直接倒更足。",
    "cue": "青椒翠绿，茄条油亮"
   },
   {
    "n": 6,
    "t": "加清水略焖到茄子软透，放盐和白糖翻匀收汁出锅。",
    "time": 3,
    "heat": "中火",
    "tip": "少加水焖一下，茄子才软糯入味。",
    "cue": "汤汁收干，茄条软而不烂"
   }
  ],
  "tips": [
   "茄子用盐水抓过，下锅不吸油也不发黑。",
   "油要烧热再下茄条，油温低就成海绵。",
   "豆豉剁碎再炒，酱香味才透得出来。"
  ],
  "mistakes": [
   "茄子不处理直接下锅，一盘能吸半瓶油。",
   "青椒和茄子同下锅，青椒炒黄茄子还硬。",
   "盐放太早，茄子出水后越炒越稀。"
  ],
