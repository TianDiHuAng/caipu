   "刮板",
   "保鲜膜"
  ],
  "steps": [
   {
    "t": "虾仁去虾线，一半用刀背拍成泥，一半切成 1cm 粒，用 3g 盐抓洗后冲净沥干。",
    "time": 12,
    "heat": "无火",
    "tip": "拍泥出胶、留粒有口感，两种状态都要。",
    "cue": "虾泥发黏、虾粒分明"
   },
   {
    "t": "虾料加春笋粒、猪肥膘粒、盐、白糖、白胡椒与香油，顺一个方向搅打 5 分钟上劲。",
    "time": 8,
    "heat": "无火",
    "tip": "搅打上劲，馅才抱团不出水。",
    "cue": "馅料起胶、能拉出细丝"
   },
   {
    "t": "澄面与淀粉混合，冲入 260ml 沸水快速搅成絮状，加盖焖 5 分钟。",
    "time": 7,
    "heat": "无火",
    "tip": "必须用沸水烫面，皮才透明不裂。",
    "cue": "面团半透明、无干粉颗粒"
   },
   {
    "t": "趁热加入猪油揉成光滑面团，盖保鲜膜醒 10 分钟。",
    "time": 12,
    "heat": "无火",
    "tip": "趁热揉，冷了面团就发硬。",
    "cue": "面团细腻、按下去能回弹"
   },
   {
    "t": "面团搓条切 12g 剂子，用刀面压成圆薄皮，包入 15g 虾馅捏出 12 道褶。",
    "time": 20,
    "heat": "无火",
    "tip": "皮压得越薄越透，但别破口。",
    "cue": "饺子挺立、褶纹清晰"
   },
   {
    "t": "蒸笼垫胡萝卜片防粘，水开后大火蒸 6 分钟至皮透明即可。",
    "time": 8,
    "heat": "大火",
    "tip": "蒸过头皮会塌，6 分钟足够。",
    "cue": "饺皮透亮见馅、虾肉泛粉红"
   }
  ],
  "tips": [
   "澄面必须用滚沸的水烫，水温低了皮不透明。",
   "馅料顺一个方向搅打，才能抱团。",
   "蒸的时间宁短勿长，皮一塌就失败。"
  ],
  "mistakes": [
   "用温水和澄面，皮发白且一捏就裂。",
   "馅料胡乱搅，蒸后散成一包汤水。",
   "剂子压得太厚，蒸出来皮硬如橡皮。"
  ],
  "subs": [
   {
    "orig": "虾仁",
    "sub": "鲜贝肉",
    "ratio": "400g 对 350g",
    "note": "口感更甜，盐减 1g。"
   },
   {
    "orig": "春笋",
    "sub": "马蹄",
    "ratio": "80g 对 80g",
    "note": "更脆，但清甜味略差。"
   }
  ],
  "variations": [
   "笋尖版：只用笋尖，鲜味更清雅。",
   "蟹籽版：顶上点蟹籽，卖相更精致。"
  ],
  "serving": "趁热配一碟浙醋吃，皮薄馅弹是标准。",
  "storage": "生坯可冷冻 1 个月，蒸时无需解冻加 2 分钟。",
  "nutrition": {
   "basis": "每份（4 只）",
   "kcal": 320,
   "protein": 18,
   "fat": 10,
   "carbs": 42,
   "sodium": 620
  },
  "safety": [
   "虾为常见致敏食材，过敏人群禁食。",
   "蒸制时蒸汽温度极高，开盖需避开蒸汽方向。",
   "虾馅需蒸至完全变红熟透，中心不得生。"
  ],
  "origin": "虾饺是广式早茶四大天王之首，皮用澄面烫成半透明，包住笋粒与虾仁，讲究「皮薄、馅大、褶匀」，一笼十二只见功力。",
  "tags": [
