     }
    ]
   }
  ],
  "equipment": [
   "炒锅",
   "漏勺",
   "锅铲"
  ],
  "steps": [
   {
    "t": "春笋去壳削去老根，切成 4cm 长的滚刀块，放入开水焯 5 分钟去涩。",
    "time": 12,
    "heat": "大火",
    "tip": "焯水必做，否则涩味压不住。",
    "cue": "笋块水润、涩味明显减轻"
   },
   {
    "t": "炒锅倒 45ml 植物油烧热，下葱段煸 1 分钟出香后捞出。",
    "time": 2,
    "heat": "中火",
    "tip": "葱油打底，笋才更香。",
    "cue": "葱段金黄、油面清亮"
   },
   {
    "t": "倒入笋块中火煎 4 分钟，翻炒至边缘微微上色。",
    "time": 5,
    "heat": "中火",
    "tip": "先煎出水汽，笋才有咬劲。",
    "cue": "笋块边角焦黄、表面收紧"
   },
   {
    "t": "加生抽、老抽、白糖与 150ml 水，烧开后转小火焖 8 分钟。",
    "time": 10,
    "heat": "小火",
    "tip": "加水后小火焖，笋才入味不柴。",
    "cue": "汤汁变深、笋块染上酱色"
   },
   {
    "t": "开大火收汁至浓稠裹笋，加 2g 盐调匀，淋香油出锅。",
    "time": 3,
    "heat": "大火",
    "tip": "收汁到亮油，光泽才好看。",
    "cue": "酱汁稠亮、能挂住笋块"
   }
  ],
  "tips": [
   "春笋必须焯水去涩，这一步不能省。",
   "油量比平常炒菜多，油焖靠油封住鲜味。",
   "白糖量要足，江浙口味偏甜。"
  ],
  "mistakes": [
   "笋不焯水直接烧，涩得刺口。",
   "油放太少，笋块发干像木头。",
   "收汁不够，盘底一汪汤水。"
  ],
  "subs": [
   {
    "orig": "春笋",
    "sub": "冬笋",
    "ratio": "500g 对 450g",
    "note": "更嫩，焖的时间减 2 分钟。"
   },
   {
    "orig": "生抽",
    "sub": "酱油膏",
    "ratio": "25ml 对 20g",
    "note": "色泽更浓，盐减 1g。"
   }
  ],
  "variations": [
   "咸肉版：加 50g 咸肉片同焖，鲜味更足。",
   "冰糖版：白糖换冰糖，汤汁更亮。"
  ],
  "serving": "冷热皆宜，热吃下饭，凉了当小菜也香。",
  "storage": "冷藏 2 天，复热加少量水焖 3 分钟。",
  "nutrition": {
   "basis": "每份（约 150g）",
   "kcal": 210,
   "protein": 4,
   "fat": 15,
   "carbs": 16,
   "sodium": 780
  },
  "safety": [
   "春笋含草酸，焯水可去除大部分，肾功能不佳者不宜多食。",
   "笋纤维粗，肠胃虚弱者适量食用。",
   "焖制时汤汁浓稠易溅，翻炒需轻缓。"
  ],
  "origin": "油焖笋是江南春天最家常的吃法，重油重糖小火焖透，笋块吸饱酱汁却仍带脆劲，是检验春笋新鲜度的一道老菜。",
  "tags": [
   "苏菜",
   "春笋",
   "素菜",
   "时令"
  ],
  "related_ids": [
   "shousi-baocai",
   "suanla-tudousi",
   "jiachang-doufu"
  ]
 },
