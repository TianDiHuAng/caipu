  "steps": [
   {
    "n": 1,
    "t": "糯米粉加白糖混合，分次倒入三百毫升清水，搅成没有颗粒的稀浆。",
    "time": 8,
    "heat": "无火",
    "tip": "浆要搅到顺滑无疙瘩，蒸出来才细腻。",
    "cue": "粉浆能挂住筷子"
   },
   {
    "n": 2,
    "t": "粉浆过一遍筛，倒进抹了植物油的浅盘，表面盖一层保鲜膜。",
    "time": 5,
    "heat": "无火",
    "tip": "过筛去颗粒，盖膜是防止水汽滴进去。",
    "cue": "浆面平整无气泡"
   },
   {
    "n": 3,
    "t": "蒸锅水开后上笼，大火蒸二十分钟，中途不要开盖。",
    "time": 20,
    "heat": "大火",
    "tip": "中途开盖会塌陷，耐心等足二十分钟。",
    "cue": "粉浆凝固成半透明团"
   },
   {
    "n": 4,
    "t": "蒸好取出稍晾五分钟，用抹了油的铲子翻拌，让面团更筋道。",
    "time": 6,
    "heat": "无火",
    "tip": "趁热翻拌才起筋，凉了就拌不动。",
    "cue": "面团拉长不断"
   },
   {
    "n": 5,
    "t": "花生用平底锅小火炒香，去皮碾成粗粒，和芝麻、白糖拌成蘸粉。",
    "time": 6,
    "heat": "小火",
    "tip": "花生别炒过，颜色一变深就发苦。",
    "cue": "花生碎带颗粒，香气冲鼻"
   },
   {
    "n": 6,
    "t": "手上抹油揪成三十克一个的剂子，搓圆后滚一圈蘸粉装盘。",
    "time": 5,
    "heat": "无火",
    "tip": "手和刀都要抹油，否则粘得没法下手。",
    "cue": "麻糬圆整，外层裹满粉"
   }
  ],
  "tips": [
