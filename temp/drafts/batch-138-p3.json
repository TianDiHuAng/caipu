  "steps": [
   {
    "n": 1,
    "t": "面粉加酵母、盐和二百二十毫升清水揉成偏硬面团，盖布发酵三十分钟。",
    "time": 32,
    "heat": "无火",
    "tip": "水别一次倒完，留一点看面团软硬再补。",
    "cue": "面团光滑，按压回弹"
   },
   {
    "n": 2,
    "t": "面团擀成大片，表面抹一层植物油，撒少许干面粉卷起成条。",
    "time": 8,
    "heat": "无火",
    "tip": "抹油撒粉是起层的关键，别省这两步。",
    "cue": "面片卷紧，层次分明"
   },
   {
    "n": 3,
    "t": "面卷切成四段，两边捏紧收口，竖着按扁再擀成两厘米厚的圆饼。",
    "time": 6,
    "heat": "无火",
    "tip": "厚度保持两厘米，太薄烤完发硬像饼干。",
    "cue": "圆饼厚薄均匀，边缘齐整"
   },
   {
    "n": 4,
    "t": "饼面刷薄层清水，撒上芝麻轻按，让芝麻粘牢不掉。",
    "time": 3,
    "heat": "无火",
    "tip": "刷水再撒芝麻才粘得住，干撒一翻面全掉。",
    "cue": "芝麻密布，贴住不掉"
   },
   {
    "n": 5,
    "t": "平底锅小火烧热不放油，饼坯下锅加盖烙十分钟，一面定型再翻。",
    "time": 12,
    "heat": "小火",
    "tip": "全程小火慢烙，火大外面焦里面生。",
    "cue": "底面浅黄，饼身微鼓"
   },
   {
    "n": 6,
    "t": "翻面再烙八分钟，两面都出现焦黄花斑后出锅，稍凉切块。",
    "time": 10,
    "heat": "小火",
    "tip": "两面都烙透才脆，凉两分钟再切不塌。",
    "cue": "两面焦斑均匀，掰开有层次"
   }
  ],
  "tips": [
   "面团偏硬才烙得出脆壳，软面只会烙成软饼。",
   "抹油卷条是起层的核心，省了就是一块死面。",
   "全程小火加盖，火大容易外焦内生。"
  ],
  "mistakes": [
