  "steps": [
   {
    "t": "猪里脊逆着纹理切成薄片，加生抽、少许盐与玉米淀粉抓匀腌十分钟。",
    "time": 12,
    "heat": "无火",
    "tip": "逆纹切才嫩，顺纹切会塞牙。",
    "cue": "肉片薄透、表面裹上薄浆"
   },
   {
    "t": "沙茶酱与花生酱放碗中，分次加温水慢慢调开成顺滑酱汁。",
    "time": 5,
    "heat": "无火",
    "tip": "花生酱结块时要一点点加水化开。",
    "cue": "酱汁顺滑无颗粒、能挂住勺背"
   },
   {
    "t": "炒锅倒植物油烧热，下蒜末、姜末、干辣椒段与干贝丝小火爆香。",
    "time": 4,
    "heat": "小火",
    "tip": "蒜末一变色就下酱，别炒糊。",
    "cue": "锅中飘出蒜香与海味"
   },
   {
    "t": "倒入调好的酱汁小火慢炒出红油，再加清水与白糖、盐煮开成汤底。",
    "time": 8,
    "heat": "小火",
    "tip": "酱要炒透，沙茶的香味才出得来。",
    "cue": "汤面浮起红油、香气浓烈"
   },
   {
    "t": "另起汤锅烧开水，碱水面下锅煮两分钟，捞出过一遍凉水沥干。",
    "time": 4,
    "heat": "大火",
    "tip": "碱水面煮过凉水更弹牙。",
    "cue": "碱水面断生、根根分明不粘连"
   },
   {
    "t": "同一锅水烫熟空心菜与腌好的肉片，肉片变色即捞出。",
    "time": 2,
    "heat": "大火",
    "tip": "肉片一变色就捞，久煮发柴。",
    "cue": "肉片全部转白、菜叶翠绿"
   },
   {
    "t": "碱水面装碗，铺上空心菜与肉片，浇两勺滚烫汤底，撒葱花即可。",
    "time": 3,
    "heat": "无火",
    "tip": "汤一定要滚，浇下去才激香。",
    "cue": "碗中汤色红亮、配菜铺满"
   }
  ],
  "tips": [
   "沙茶酱选厦门口味的，本身带咸味，盐要少放。",
   "汤底可提前熬好，吃前加热更省时间。",
   "喜欢海鲜可加几只虾仁或鱿鱼圈同烫。"
  ],
  "mistakes": [
   "沙茶酱不炒直接用开水冲，汤寡淡像刷锅水。",
   "碱水面煮好不过凉水，装碗后粘成一坨。",
   "肉片切得太厚，烫不熟也嚼不动。"
  ],
  "subs": [
   {
    "orig": "碱水面",
    "sub": "拉面",
    "ratio": "300g 对 300g",
    "note": "拉面更软，煮制时间缩短半分钟。"
   },
   {
    "orig": "猪里脊",
    "sub": "虾仁",
    "ratio": "120g 对 120g",
    "note": "虾仁烫十秒即熟，鲜味更足。"
   }
  ],
  "variations": [
   "在碗底先放一小勺猪油，冲入热汤后香气会更浓一层。",
   "换成沙茶拌面，酱汁收浓直接拌，不加汤。"
  ],
  "serving": "大碗装面，汤多面少，配一碟腌萝卜解辣。",
  "storage": "汤底冷藏可存两天，碱水面现煮现吃。",
  "nutrition": {
   "basis": "每份（约 380g）",
   "kcal": 520,
   "protein": 24,
   "fat": 20,
   "carbs": 62,
   "sodium": 1120
  },
  "safety": [
   "沙茶酱含花生与海鲜成分，过敏人群请留意配料表。",
   "猪肉片务必烫至完全变白无血色，避免半生入口。",
   "汤底放凉后须冷藏，室温放置不要超过两小时。"
  ],
  "origin": "沙茶面是厦门的市井早餐，沙茶酱源自南洋沙嗲，落地闽南后改用花生、虾干与香料熬制，汤色红亮带辣。小贩一大锅汤底滚着，客人点面、肉、鱿鱼，烫熟浇汤，一碗下肚，海风里都能吃出汗来。",
