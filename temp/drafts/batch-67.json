 {
  "id": "minnan-jiangmuya",
  "zh": "闽南姜母鸭",
  "en": "Minnan Ginger Duck",
  "cuisine": "fujian",
  "category": [
   "main-meat"
  ],
  "difficulty": 2,
  "prep": 15,
  "cook": 60,
  "servings": 4,
  "flavor": [
   "fragrant",
   "salty",
   "umami"
  ],
  "ingredients": [
   {
    "group": "main",
    "items": [
     {
      "n": "鸭肉",
      "a": 600,
      "u": "g",
      "note": "带骨剁成小块"
     }
    ]
   },
   {
    "group": "aux",
    "items": [
     {
      "n": "老姜",
      "a": 120,
      "u": "g",
      "note": "切厚片，用量要足"
     },
     {
      "n": "大蒜",
      "a": 20,
      "u": "g",
      "note": "整瓣去皮"
     }
    ]
   },
   {
    "group": "seasoning",
    "items": [
     {
      "n": "芝麻油",
      "a": 60,
      "u": "ml",
      "note": "煸姜主体"
     },
     {
      "n": "黄酒",
      "a": 100,
      "u": "ml",
      "note": "去腥增香"
     },
     {
      "n": "生抽",
      "a": 40,
      "u": "ml",
      "note": "调味"
     },
     {
      "n": "老抽",
      "a": 5,
      "u": "ml",
      "note": "上色"
     },
     {
      "n": "冰糖",
      "a": 10,
      "u": "g",
      "note": "调和咸味"
     },
     {
      "n": "盐",
      "a": 2,
      "u": "g",
      "note": "酱油已咸，少量补味"
     },
     {
      "n": "清水",
      "a": 300,
      "u": "ml",
      "note": "焖煮用水"
     }
    ]
   }
  ],
  "equipment": [
   "砂锅",
   "炒锅",
   "菜刀"
  ],
  "steps": [
   {
    "t": "鸭肉剁成三厘米见方的块，冷水下锅煮开焯去血沫，捞出用温水冲洗干净。",
    "time": 8,
    "heat": "大火",
    "tip": "冷水下锅血沫才逼得干净。",
    "cue": "水面浮起褐色沫、鸭块收紧"
   },
   {
    "t": "老姜刷洗干净带皮切成半厘米厚的片，大蒜整瓣去皮备用。",
    "time": 5,
    "heat": "无火",
    "tip": "姜皮留着不上火，别削掉。",
    "cue": "姜片厚薄均匀、边缘完整"
   },
   {
    "t": "砂锅倒入芝麻油，小火下姜片慢煸到边缘卷起发干、姜香浓烈。",
    "time": 8,
    "heat": "小火",
    "tip": "姜要煸透，整锅的香底全靠它。",
    "cue": "姜片边缘金黄卷曲"
   },
   {
    "t": "下大蒜与鸭块转中火翻炒，把鸭皮下的油逼出来，表面炒到微黄。",
    "time": 8,
    "heat": "中火",
    "tip": "鸭皮朝下先煎，腥味跟着油走。",
    "cue": "鸭块表面金黄、锅底见油"
   },
   {
    "t": "沿锅边淋入黄酒，加生抽、老抽、冰糖与清水，盖盖小火焖四十分钟。",
    "time": 40,
    "heat": "小火",
    "tip": "全程小火，汤面只冒小泡。",
    "cue": "汤汁咕嘟、鸭肉可用筷子插入"
   },
   {
    "t": "开盖转大火收汁，汤汁浓稠挂勺后补盐调味，连砂锅端上桌。",
    "time": 3,
    "heat": "大火",
    "tip": "收汁时勤翻动，防止姜片粘底。",
    "cue": "汤汁油亮、鸭块裹满酱色"
   }
  ],
  "tips": [
   "姜母鸭讲究姜多酒足，老姜至少要一百克。",
   "用砂锅焖比铁锅受热均匀，鸭肉更酥。",
   "吃完鸭肉剩下的汤汁拌面线，是闽南人的吃法。"
  ],
  "mistakes": [
   "芝麻油烧到冒烟才下姜，整锅发苦。",
   "姜片切得太薄，煸两下就焦黑。",
   "中途加冷水，鸭肉骤冷发柴。"
  ],
  "subs": [
   {
    "orig": "鸭肉",
    "sub": "鸡腿",
    "ratio": "600g 对 600g",
    "note": "鸡肉易熟，焖制时间缩短到二十五分钟。"
   },
   {
    "orig": "黄酒",
    "sub": "米酒",
    "ratio": "100ml 对 100ml",
    "note": "米酒更甜，冰糖减到五克。"
   }
  ],
  "variations": [
   "加一把当归与枸杞同焖，药膳风味更浓。",
   "收汁后转干锅小火慢焙，做成干香版。"
  ],
  "serving": "砂锅直接上桌，配一碗面线或白饭，汤汁别浪费。",
  "storage": "冷藏两天，复热时加两勺黄酒小火煨透。",
  "nutrition": {
   "basis": "每份（约 200g）",
   "kcal": 520,
   "protein": 30,
   "fat": 38,
   "carbs": 8,
   "sodium": 980
  },
  "safety": [
   "鸭肉必须焖至中心完全熟透，骨断面不见血水。",
   "处理生禽后立即清洗双手与刀具，避免沙门氏菌污染。",
   "砂锅离火后余温高，端锅时垫厚布防烫。"
  ],
  "origin": "姜母鸭在闽南是冬天的进补菜，老姜切片用麻油煸到卷边，再下鸭块与米酒慢焖，一锅红亮油润。泉州、厦门的街头小店常把整排砂锅摆在门口，火一直煨着，走过路过都能闻见姜与酒混在一起的暖气。",
  "tags": [
   "闽菜",
   "厦门",
   "焖菜",
   "滋补"
  ],
  "related": [
   "sanbei-ji",
   "hakka-sanbeiji"
  ],
  "overwrite": true
 },
