    "steps": [
      {
        "t": "鸡腿肉切四厘米块，用厨房纸吸干，撒三克盐与黑胡椒抓匀腌十分钟。",
        "time": 12,
        "heat": "无火",
        "tip": "带皮鸡肉吸干水再煎，皮才会脆，汤也不会浑浊。",
        "cue": "鸡肉表面干爽，调料均匀"
      },
      {
        "t": "平底锅放植物油烧热，鸡皮朝下中火煎四分钟到金黄，翻面再煎两分钟盛出。",
        "time": 7,
        "heat": "中火",
        "tip": "煎出的鸡油别倒掉，后面煮面全靠它提香。",
        "cue": "鸡皮金黄焦脆，锅底留一层油"
      },
      {
        "t": "同一锅下洋葱丝炒三分钟到软，加蒜末与辣椒粉、牛至炒香三十秒。",
        "time": 4,
        "heat": "中火",
        "tip": "洋葱炒软才有甜底味，香料粉用锅里的鸡油炒最香。",
        "cue": "洋葱透明，香料在油里泛红"
      },
      {
        "t": "加番茄块与胡萝卜块，中火炒五分钟到番茄出汁塌软。",
        "time": 6,
        "heat": "中火",
        "tip": "番茄要炒到塌软出汁，汤的红色与酸甜全靠这一步。",
        "cue": "番茄塌软出汁，锅里有红汤"
      },
      {
        "t": "倒入热鸡汤煮开，把煎好的鸡块放回锅里，小火炖十分钟。",
        "time": 12,
        "heat": "小火",
        "tip": "鸡汤必须热着下锅，冷汤会让鸡肉纤维突然收紧。",
        "cue": "汤面微沸，鸡肉在汤中浮沉"
      },
      {
        "t": "另起汤锅煮面条，煮到八成熟后捞出，直接放进鸡汤里继续煮三分钟。",
        "time": 8,
        "heat": "中火",
        "tip": "面在汤里煮透才吸味，但要看着锅，久煮会糊汤。",
        "cue": "面条吸满红汤，汤色转浓"
      },
      {
        "t": "试味后补盐，撒香菜碎，关火盖盖焖两分钟让味道融合。",
        "time": 3,
        "heat": "无火",
        "tip": "关火焖两分钟比多煮更出味，面条也不会继续软烂。",
        "cue": "汤浓面软，香菜香气浮出"
      },
      {
        "t": "连汤带面盛进深碗，鸡块放在最上面，浇一勺红汤。",
        "time": 2,
        "heat": "无火",
        "tip": "汤要多留一点，吃到后半碗才不会干。",
        "cue": "碗里红汤浸面，鸡块色泽金红"
      }
    ],
    "tips": [
      "用宽一点的面条挂汤更好，太细的容易煮成一锅糊。",
      "加一勺带酸味的果汁，能把辣味和油感都提亮。",
      "汤底可以提前炖好冷藏，第二天煮面更快。",
      "配两片煎过的玉米饼与一勺酸味的酱，是餐厅的常见摆法。"
    ],
    "mistakes": [
      "面条直接在汤里煮到软烂，汤变成一锅稠糊。",
      "番茄不炒透就加汤，汤色发白发淡，酸味尖。",
      "鸡肉煎完不盛出，与面一起久煮，肉柴汤浑。"
    ],
    "subs": [
