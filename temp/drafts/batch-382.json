    "steps": [
      {
        "t": "汤锅烧一锅开水，下面条煮到八成熟，约两分钟，捞出立刻过冷水冲掉表面的白色浆水。",
        "time": 5,
        "heat": "大火",
        "tip": "煮到八成就捞，回锅还要炒，煮透了面一炒就断。",
        "cue": "面条略带硬芯，冲水后根根分明"
      },
      {
        "t": "面条沥干后拌入一勺植物油抖散，摊开晾两分钟把表面水汽吹干。",
        "time": 3,
        "heat": "无火",
        "tip": "拌油抖散是炒面不粘的关键，湿面条下锅一定糊。",
        "cue": "面条油亮松散，不结团"
      },
      {
        "t": "虾仁开背去肠线，洗净吸干，加少许盐与生抽抓匀腌五分钟。",
        "time": 6,
        "heat": "无火",
        "tip": "虾仁吸干水再腌，下锅才弹，也不会出一锅水。",
        "cue": "虾仁表面干爽，调料裹匀"
      },
      {
        "t": "炒锅烧到冒烟倒油滑锅，下虾仁大火快炒一分半，卷曲变红就盛出。",
        "time": 2,
        "heat": "大火",
        "tip": "虾仁一变色就捞，回锅再受热，久炒会变硬。",
        "cue": "虾仁卷成弯月，颜色红亮"
      },
      {
        "t": "锅里留油下姜丝与葱段爆香，再下豆芽大火翻炒三十秒，炒到略软。",
        "time": 2,
        "heat": "大火",
        "tip": "豆芽只需断生，炒久了出水，面就发软。",
        "cue": "豆芽微软，锅底仍干爽"
      },
      {
        "t": "倒入面条，用筷子配合铲子抖散翻炒两分钟，让面身均匀受热。",
        "time": 3,
        "heat": "大火",
        "tip": "筷子挑散比铲子压好，面条不易断也更透气。",
        "cue": "面条松散，开始出现焦边"
      },
      {
        "t": "沿锅边淋生抽与蚝油，加白糖与剩余盐，快速翻炒四十秒上色均匀。",
        "time": 2,
        "heat": "大火",
        "tip": "酱汁沿锅边淋才带焦香，直接浇面上下色不匀。",
        "cue": "面条酱色均匀，锅气明显"
      },
      {
        "t": "回锅虾仁，加韭黄段翻炒二十秒，关火淋香油，装盘趁热吃。",
        "time": 2,
        "heat": "大火",
        "tip": "韭黄最后放，二十秒断生就够，久了发黄出水。",
        "cue": "韭黄翠绿，面身油润不粘"
      }
    ],
    "tips": [
      "碱水面最适合炒，普通挂面容易断，可换成宽面。",
      "面煮好不要盖着，闷在锅里会返潮粘成块。",
      "豆芽与韭黄是粤式炒面的标配，口感层次全靠它们。",
      "锅一定要烧透再下油，粘锅的面怎么炒都会碎。"
    ],
    "mistakes": [
      "面煮全熟再炒，回锅一翻就断，成品碎成面渣。",
      "面不沥干就下锅，锅里冒白汽，炒出来软塌一大片。",
      "酱汁一次全倒进去，面条吸味不均，底下的咸上头的淡。"
    ],
    "subs": [
      {
        "orig": "虾仁",
        "sub": "叉烧片",
        "ratio": "200克:200克",
        "note": "叉烧本身带甜，糖可减半。"
      },
      {
        "orig": "韭黄",
        "sub": "韭菜",
        "ratio": "80克:80克",
        "note": "香气更冲，需多炒十秒。"
      }
    ],
    "variations": [
      "加两只打散的蛋液同炒，做成虾仁蛋炒面。",
      "用XO酱替一半生抽，酱香更浓，是茶餐厅的高配版本。"
    ],
    "serving": "两人份主食，配一碗清汤与一小碟辣椒酱，就是粤式的午餐一套。",
    "storage": "现炒现吃最好，冷藏后复热需用大火快炒，微波加热面会粘连。",
    "nutrition": {
      "basis": "按两人份估算",
      "kcal": 620,
      "protein": 32,
      "fat": 22,
      "carbs": 76,
      "sodium": 980
    },
    "diet": [
      "dairy-free"
    ],
    "tags": [
      "广东",
      "炒面",
      "虾仁",
      "快炒"
    ],
    "safety": [
      "虾仁须炒至完全变红卷曲熟透，面条须煮透无硬芯；虾类属常见过敏原，敏感人群须注意。"
    ],
    "origin": "粤式茶餐厅里的虾仁炒面，碱水面煮到八成熟拌油抖散，与虾仁、豆芽、韭黄一起大火快炒，最后沿锅边淋生抽。全程不到十分钟，锅气与虾鲜是全部的重点。",
    "prep": 20,
    "cook": 16,
    "overwrite": true
