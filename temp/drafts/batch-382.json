    "steps": [
      {
        "t": "北豆腐切两厘米厚片，用厨房纸包住压上重物，静置十五分钟逼出多余水分。",
        "time": 17,
        "heat": "无火",
        "tip": "水压得干，煎的时候才不会溅油，表面也更容易上色。",
        "cue": "豆腐片明显收紧，纸上有水痕"
      },
      {
        "t": "平底锅放一半橄榄油，中火把豆腐片两面各煎三分钟，煎到浅金色盛出。",
        "time": 7,
        "heat": "中火",
        "tip": "煎的时候别急着翻，晃锅能滑动才说明底面结皮了。",
        "cue": "两面金黄结皮，豆腐片挺括"
      },
      {
        "t": "同一个锅补剩下的油，下洋葱碎炒三分钟到透明发甜。",
        "time": 4,
        "heat": "中火",
        "tip": "洋葱炒透是这道菜的甜味来源，别只炒到断生。",
        "cue": "洋葱透明软塌，香味散出"
      },
      {
        "t": "加蒜末与甜椒丁炒两分钟，炒到甜椒略软、边缘带一点焦。",
        "time": 3,
        "heat": "中火",
        "tip": "甜椒炒到边缘微焦才香，生味不散整盘菜会发涩。",
        "cue": "甜椒微软，锅底有焦香"
      },
      {
        "t": "下西葫芦丁与番茄丁，加盐、白糖与牛至，中火煮十分钟到蔬菜软烂出汁。",
        "time": 12,
        "heat": "中火",
        "tip": "煮到番茄完全化成酱才算到位，这道杂蔬要的是浓稠。",
        "cue": "汤汁浓稠，蔬菜软烂成糊状"
      },
      {
        "t": "把煎好的豆腐片放回锅里，让豆腐埋在汤汁里，小火煮五分钟吸味。",
        "time": 6,
