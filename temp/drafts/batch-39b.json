  "steps": [
   {
    "t": "隔夜米饭用勺子压散，拌入 5ml 植物油让米粒颗颗分开。",
    "time": 5,
    "heat": "无火",
    "tip": "冷饭的水分少，炒出来才粒粒分明。",
    "cue": "米粒松散、没有结块"
   },
   {
    "t": "腊肉丁冷水下锅煮 3 分钟捞出，去除表面浮盐与烟熏杂味。",
    "time": 5,
    "heat": "中火",
    "tip": "先焯一遍，炒出的饭不齁咸。",
    "cue": "水面浮起白沫、腊肉略软"
   },
   {
    "t": "炒锅烧热下 15ml 植物油，倒入蛋液大火快速炒成蛋块盛出。",
    "time": 3,
    "heat": "大火",
    "tip": "蛋液半凝就盛，回锅才不老。",
    "cue": "蛋块蓬松微黄"
   },
   {
    "t": "锅中补 10ml 植物油，下腊肉丁小火煸 3 分钟至出油微焦。",
    "time": 4,
    "heat": "中火",
    "tip": "把腊肉的油逼出来，饭才香。",
    "cue": "腊肉边缘微焦、锅底见红油"
   },
   {
    "t": "下青椒丁炒 1 分钟，倒入米饭大火翻炒，边炒边压散结块。",
    "time": 4,
    "heat": "大火",
    "tip": "大火快炒，米粒才不粘锅。",
    "cue": "米粒跳动、表面泛油光"
   },
   {
    "t": "淋 15ml 酱油与 2g 盐炒匀，倒回蛋块撒小葱，翻两下出锅。",
    "time": 2,
    "heat": "大火",
    "tip": "酱油沿锅边淋，焦香更足。",
    "cue": "饭粒均匀上色、葱香冒出"
   }
  ],
  "tips": [
   "饭要冷、锅要热，这是炒饭好不好的分水岭。",
   "腊肉先焯水再煸，咸度与烟味都更柔和。",
   "青椒最后下，保住脆爽口感。"
  ],
  "mistakes": [
   "用刚煮好的热饭下锅，炒出一坨黏团。",
   "腊肉直接下锅，咸味全渗进饭里发苦。",
   "小火慢炒，饭粒被压得又软又油。"
  ],
  "subs": [
   {
