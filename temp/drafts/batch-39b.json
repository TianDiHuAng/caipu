    "sub": "腊肠",
    "ratio": "120g 对 120g",
    "note": "更甜口，盐可再减 1g。"
   },
   {
    "orig": "青椒",
    "sub": "青豆",
    "ratio": "60g 对 60g",
    "note": "需先焯水 1 分钟。"
