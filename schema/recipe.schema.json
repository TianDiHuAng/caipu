{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://recipe-atlas.local/schema/recipe.schema.json",
  "title": "Recipe",
  "description": "菜谱唯一真相结构。字段语义见 docs/SCHEMA.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "content_version", "name", "cuisine", "category",
    "difficulty", "time", "servings", "flavor", "ingredients", "equipment",
    "steps", "tips", "common_mistakes", "substitutions", "variations",
    "serving_suggestion", "storage", "nutrition_estimate", "allergens",
    "diet_tags", "food_safety_notes", "origin_note", "tags", "related_ids",
    "status", "image_url", "image_credit", "created_at", "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3, "maxLength": 60 },
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "content_version": { "type": "integer", "minimum": 1 },

    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 2, "maxLength": 40 },
        "en": { "type": "string", "minLength": 2, "maxLength": 80 },
        "original": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },

    "cuisine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "style"],
      "properties": {
        "region": { "type": "string", "enum": ["cn", "intl"] },
        "style": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
      }
    },

    "category": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string" }
    },

    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },

    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prep_min", "cook_min", "total_min"],
      "properties": {
        "prep_min": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "cook_min": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "total_min": { "type": "integer", "minimum": 1, "maximum": 2880 }
      }
    },

    "servings": { "type": "integer", "minimum": 1, "maximum": 12 },
    "flavor": {
      "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["salty", "spicy", "numbing", "sour", "sweet", "bitter", "umami",
                 "smoky", "fragrant", "light", "rich", "tangy", "savory", "herbal"]
      }
    },

    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "items"],
        "properties": {
          "group": { "type": "string", "enum": ["main", "aux", "seasoning"] },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "name_en", "amount", "unit", "note", "optional"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 30 },
                "name_en": { "type": "string", "minLength": 1, "maxLength": 60 },
                "amount": { "type": ["number", "null"], "minimum": 0, "maximum": 5000 },
                "unit": {
                  "type": "string",
                  "enum": ["g", "ml", "piece", "clove", "slice", "stalk", "to-taste", "pinch"]
                },
                "note": { "type": "string", "minLength": 2, "maxLength": 120 },
                "substitute": { "type": "string", "minLength": 2, "maxLength": 120 },
                "optional": { "type": "boolean" }
              }
            }
          }
        }
      }
    },

    "equipment": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 30 }
    },

    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "text", "time_min", "heat", "tip", "visual_cue"],
        "properties": {
          "n": { "type": "integer", "minimum": 1, "maximum": 30 },
          "text": { "type": "string", "minLength": 20, "maxLength": 400 },
          "time_min": { "type": "integer", "minimum": 0, "maximum": 720 },
          "heat": {
            "type": "string",
            "enum": ["大火", "中大火", "中火", "中小火", "小火", "微火", "无火", "-"]
          },
          "tip": { "type": "string", "minLength": 5, "maxLength": 200 },
          "visual_cue": { "type": "string", "minLength": 8, "maxLength": 160 }
        }
      }
    },

    "tips": {
      "type": "array", "minItems": 2, "maxItems": 10,
      "items": { "type": "string", "minLength": 15, "maxLength": 300 }
    },
    "common_mistakes": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "type": "string", "minLength": 15, "maxLength": 300 }
    },
    "substitutions": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["original", "substitute", "ratio", "note"],
        "properties": {
          "original": { "type": "string", "minLength": 1, "maxLength": 40 },
          "substitute": { "type": "string", "minLength": 1, "maxLength": 60 },
          "ratio": { "type": "string", "minLength": 3, "maxLength": 40 },
          "note": { "type": "string", "minLength": 5, "maxLength": 160 }
        }
      }
    },
    "variations": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "type": "string", "minLength": 15, "maxLength": 300 }
    },

    "serving_suggestion": { "type": "string", "minLength": 15, "maxLength": 300 },
    "storage": { "type": "string", "minLength": 15, "maxLength": 400 },

    "nutrition_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "calories_kcal", "protein_g", "fat_g", "carbs_g", "sodium_mg", "is_estimate", "disclaimer"],
      "properties": {
        "basis": { "type": "string", "minLength": 2, "maxLength": 40 },
        "calories_kcal": { "type": "number", "minimum": 0, "maximum": 5000 },
        "protein_g": { "type": "number", "minimum": 0, "maximum": 300 },
        "fat_g": { "type": "number", "minimum": 0, "maximum": 300 },
        "carbs_g": { "type": "number", "minimum": 0, "maximum": 500 },
        "sodium_mg": { "type": "number", "minimum": 0, "maximum": 12000 },
        "is_estimate": { "type": "boolean", "enum": [true] },
        "disclaimer": { "type": "string", "minLength": 10, "maxLength": 200 }
      }
    },

    "allergens": {
      "type": "array", "maxItems": 14, "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["gluten", "crustacean", "mollusk", "fish", "egg", "peanut",
                 "tree-nut", "soy", "milk", "sesame", "celery", "mustard",
                 "sulfite", "lupin"]
      }
    },
    "diet_tags": {
      "type": "array", "maxItems": 9, "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["vegetarian", "vegan", "gluten-free", "dairy-free", "halal",
                 "kosher", "low-carb", "high-protein", "pescatarian"]
      }
    },
    "food_safety_notes": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "type": "string", "minLength": 15, "maxLength": 300 }
    },

    "origin_note": { "type": "string", "minLength": 40, "maxLength": 800 },
    "tags": {
      "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 20 }
    },
    "related_ids": {
      "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "status": { "type": "string", "enum": ["draft", "reviewed", "published"] },
    "image_url": { "type": ["string", "null"] },
    "image_credit": { "type": ["string", "null"] },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
